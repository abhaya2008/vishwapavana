[
  {
    "id": 20129914,
    "chapter_id": 6997,
    "verse_number": "14.1",
    "content_sanskrit": "अथ चतुर्दशो ऽध्यायः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20129915,
    "chapter_id": 6997,
    "verse_number": "14.2",
    "content_sanskrit": "यो वागभिनयः प्रोक्तो मया पूर्वं द्विजोत्तमाः । लक्षणं तस्य वक्ष्यामि स्वरव्यञ्जनसम्भवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20129916,
    "chapter_id": 6997,
    "verse_number": "14.3",
    "content_sanskrit": "वाचि यत्नस्तु कर्तव्यो नाट्यस्येयं तनुः स्मृता । अङ्गनेपथ्यसत्त्वानि वाक्यार्थं व्यञ्जयन्ति हि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20129917,
    "chapter_id": 6997,
    "verse_number": "14.4",
    "content_sanskrit": "वाङ्मयानीह शास्त्राणि वाङ्निष्ठानि तथैव च । तस्माद्वाचः परं नास्ति वाग् हि सर्वस्य कारणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20129918,
    "chapter_id": 6997,
    "verse_number": "14.5",
    "content_sanskrit": "आगमनामाख्यातनिपातोपसर्गसमासतद्धितैर्युक्तः । सन्धिवचनविभक्त्युपग्रहनियुक्तो वाचिकाभिनयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20129919,
    "chapter_id": 6997,
    "verse_number": "14.6",
    "content_sanskrit": "द्विविधं हि स्मृतं पाठ्यं संस्कृतं प्राकृतं तथा । तयोर्विभागं वक्ष्यामि यथावदनुपूर्वशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20129920,
    "chapter_id": 6997,
    "verse_number": "14.7",
    "content_sanskrit": "व्यञ्जनानि स्वराश्चैव सन्धयो ऽथ विभक्तयः । नामाख्यातोपसर्गाश्च निपातास्तद्धितास्तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20129921,
    "chapter_id": 6997,
    "verse_number": "14.8",
    "content_sanskrit": "एतैरङ्गैः समासैश्च नानाधातुसमाश्रयम् । विज्ञेयं संस्कृतं पाठ्यं प्रयोगञ्च निबोधत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20129922,
    "chapter_id": 6997,
    "verse_number": "14.9",
    "content_sanskrit": "अकाराद्याः स्वरा ज्ञेया औकारान्ताश्चतुर्दश । हकारान्तानि कादीनि व्यञ्जनानि विदुर्बुधाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20129923,
    "chapter_id": 6997,
    "verse_number": "14.10",
    "content_sanskrit": "तत्र स्वराश्चतुर्दश - अ आ इ ई उ ऊ ऋ ॠ ऌ ॡ ए ऐ ओ औ इति स्वरा ज्ञेयाः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20129924,
    "chapter_id": 6997,
    "verse_number": "14.11",
    "content_sanskrit": "कादीनि व्यञ्जनानि यथा - क ख ग घ ङ च छ ज झ ञ ट ठ ड ढ ण त थ द ध न प फ ब भ म य र ल व श ष स ह इति व्यञ्जनवर्गः । वर्गे वर्गे समाख्यातौ द्वौ वर्णौ प्रागवस्थितौ । अघोषा इति ये त्वन्ये सघोषाः संप्रकीर्तिताः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20129925,
    "chapter_id": 6997,
    "verse_number": "14.12",
    "content_sanskrit": "अष्टौ स्थानानि वर्णानामुरः कण्ठः शिरस्तथा । जिह्वामूलश्च दन्ताश्च नासिकोष्ठौ च तालु च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20129926,
    "chapter_id": 6997,
    "verse_number": "14.13",
    "content_sanskrit": "अ कु ह विसर्जनीयाः कण्ठ्याः । इ चु य शास्तालव्याः । ऋ टु र षा मूर्धन्याः । ऌ तु ल सा दन्त्याः । उ पूपध्मानीया ओष्ठ्याः । -प -फ इति पफाभ्यां प्राक् अर्धविसर्गसदृशः उपध्मानीयः । -क -ख इति कखाभ्यां प्राक् अर्धविसर्गसदृशो जिह्वमूलीयः । ए ऐ कण्ठ्यतालव्यौ । ओ औ कण्ठ्योष्ठ्यौ । वकारो दन्त्योष्ठ्यः । ङ ञ ण न मा अनुनासिकाः । विसर्जनीयः औरस्यः इत्येके । सर्ववर्णानां मुखं स्थानमित्यपरे । द्वौ द्वौ वर्णौ तु वर्गाद्यौ शषसाश्च त्रयो ऽपरे । अघोषा घोषवन्तस्तु ततो ऽन्ये परिकीर्तिताः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20129927,
    "chapter_id": 6997,
    "verse_number": "14.14",
    "content_sanskrit": "एते घोषाघोषाः कण्ठ्योष्ठ्या दन्त्यजिह्वानुनासिक्याः । ऊष्माणस्तालव्याः विसर्जनीयाश्च बोद्धव्याः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20129928,
    "chapter_id": 6997,
    "verse_number": "14.15",
    "content_sanskrit": "गघङ जझञ डढण दधन बभम तथैव यरलवा मता घोषाः । कख चछ टठ तथ पफ इति वर्गेष्वघोषाः स्युः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20129929,
    "chapter_id": 6997,
    "verse_number": "14.16",
    "content_sanskrit": "कखगघङाः कण्ठस्थास्तालुस्थानास्तु चछजझञाः । टठडढणा मूर्धन्यास्तथदधनाश्चैव दन्तस्थाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20129930,
    "chapter_id": 6997,
    "verse_number": "14.17",
    "content_sanskrit": "पफबभमास्त्वोष्ठ्याः स्युः दन्त्या ऌलसा अहौ च कण्ठस्थौ । तालव्या इचुयशा स्युरृटुरषा मूर्धस्थिता ज्ञेयाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20129931,
    "chapter_id": 6997,
    "verse_number": "14.18",
    "content_sanskrit": "ऌॡ दन्त्यौ ओऔ कण्ठोष्ठ्यौ एऐकारौ च कण्ठतालव्यौ । कण्ठ्यो विसर्जनीयो जिह्वामूलमुद्भवः कखयोः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20129932,
    "chapter_id": 6997,
    "verse_number": "14.19",
    "content_sanskrit": "पफयोरोष्ठस्थानं भवेदुकारः स्वरो विवृतः । स्पृष्टाः काद्या मान्ताः शषसहकारास्तथा विवृताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20129933,
    "chapter_id": 6997,
    "verse_number": "14.20",
    "content_sanskrit": "अन्तस्थाः संवृतजाः ङञणनमा नासिकोद्भवा ज्ञेयाः । ऊष्माणश्च शषसहाः यरलववर्णास्तथैव चान्तःस्थाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20129934,
    "chapter_id": 6997,
    "verse_number": "14.21",
    "content_sanskrit": "जिह्वामूलीयः -कः -प उपध्मानीयसंज्ञया ज्ञेयः । कचटतपा स्वरिताः स्युः खछठथफा स्युः सदा क्रम्याः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20129935,
    "chapter_id": 6997,
    "verse_number": "14.22",
    "content_sanskrit": "कण्ठ्योरस्यान् विद्यात् घझढधभान् पाठ्यसंप्रयोगे तु । वेद्यो विसर्जनीयो जिह्वास्थाने स्थितो वर्णः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20129936,
    "chapter_id": 6997,
    "verse_number": "14.23",
    "content_sanskrit": "एते व्यञ्जनवर्णाः समासतः संज्ञया मया कथिताः । शब्दविषयप्रयोगे स्वरा।ण्स्तु भूयः प्रवक्ष्यामि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20129937,
    "chapter_id": 6997,
    "verse_number": "14.24",
    "content_sanskrit": "यस्मिन् स्थाने स समो विज्ञेयो यः सवर्णसंज्ञो ऽसौ । य इमे स्वराश्चतुर्दश निर्दिष्टास्तत्र वै दश समानाः । पूर्वो ह्रस्वः तेषां परश्च दीर्घो ऽवगन्तव्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20129938,
    "chapter_id": 6997,
    "verse_number": "14.25",
    "content_sanskrit": "इत्थं व्यञ्जनयोगैः स्वरैश्च साख्यातनामपदविहितैः । काव्यनिबन्धाश्च स्युर्धातुनिपातोपसर्गास्तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20129939,
    "chapter_id": 6997,
    "verse_number": "14.26",
    "content_sanskrit": "एभिर्व्यञ्जनवर्गैर्नामाख्यातोपसर्गनिपातैः । तद्धितसन्धिविभक्तिभिरधिष्ठितः शब्द इत्युक्तः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20129940,
    "chapter_id": 6997,
    "verse_number": "14.27",
    "content_sanskrit": "पूर्वाचार्यैरुक्तं शब्दानां लक्षणं समासयोगेन । विस्तरशः पुनरेव प्रकरणवशात् संप्रवक्ष्यामि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20129941,
    "chapter_id": 6997,
    "verse_number": "14.28",
    "content_sanskrit": "अर्थप्रधानं नाम स्यादाख्यातं तु क्रियाकृतम् । द्योतयन्त्युपसर्गास्तु विशेषं भावसंश्रयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20129942,
    "chapter_id": 6997,
    "verse_number": "14.29",
    "content_sanskrit": "तत्प्राहुः सप्तविधं षट्कारकसंयुतं प्रथितसाध्यम् । निर्देशसंप्रदानापदानप्रभृतिसंज्ञाभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20129943,
    "chapter_id": 6997,
    "verse_number": "14.30",
    "content_sanskrit": "नामाख्यातार्थविषयं विशेषं द्योतयन्ति ते । पृथक्तत्रोपसर्गेभ्यो निपाता नियमे ऽच्युते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20129944,
    "chapter_id": 6997,
    "verse_number": "14.31",
    "content_sanskrit": "संप्रत्यतीतकालक्रियादिसंयोजितं प्रथितसाध्यम् । वचनं नागतयुक्तं सुसदृशसंयोजनविभक्तम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20129945,
    "chapter_id": 6997,
    "verse_number": "14.32",
    "content_sanskrit": "पञ्चशतधातुयुक्तं पञ्चगुणं पञ्चविधमिदं वापि । स्वाद्यधिकारगुणैरर्थविशेषैर्विभूषितन्यासम् । प्रातिपदिकार्थलिङ्गैर्युक्तं पञ्चविधमिदं ज्ञेयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20129946,
    "chapter_id": 6997,
    "verse_number": "14.33",
    "content_sanskrit": "आख्यातं पाठ्यकृतं ज्ञेयं नानार्थाश्रयविशेषम् । वचनं नामसमेतं पुरुषविभक्तं तदाख्यातम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20129947,
    "chapter_id": 6997,
    "verse_number": "14.34",
    "content_sanskrit": "प्रातिपदिकार्थयुक्तान्धात्वर्थानुपसृजन्ति ये स्वार्थैः । उपसर्गा ह्युपदिष्टास्तस्मात् संस्कारशास्त्रे ऽस्मिन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20129948,
    "chapter_id": 6997,
    "verse_number": "14.35",
    "content_sanskrit": "प्रातिपदिकार्थयोगाद्धातुच्छन्दोनिरुक्तयुक्त्या च । यस्मान्निपतन्ति पदे तस्मात्प्रोक्ता निपातास्तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20129949,
    "chapter_id": 6997,
    "verse_number": "14.36",
    "content_sanskrit": "प्रत्ययविभागजनिताः प्रकर्षसंयोगसत्ववचनैश्च । यस्मात्पूरयते ऽर्थान् प्रत्यय उक्तस्ततस्तस्मात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20129950,
    "chapter_id": 6997,
    "verse_number": "14.37",
    "content_sanskrit": "लोके प्रकृतिप्रत्ययविभागसंयोगसत्ववचनैश्च । तांस्तान् पूरयते ऽर्थांस्तेषु यस्तद्धितस्तस्मात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20129951,
    "chapter_id": 6997,
    "verse_number": "14.38",
    "content_sanskrit": "एकस्य बहूनां वा धातोर्लिङ्गस्य वा पदानां वा । विभजन्त्यर्थं यस्मात् विभक्तयस्तेन ताः प्रोक्ताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20129952,
    "chapter_id": 6997,
    "verse_number": "14.39",
    "content_sanskrit": "विशिष्टास्तु स्वरा यत्र व्यञ्जनं वापि योगतः । सन्धीयते पदे यस्मात्तस्मात् सन्धिः प्रकीर्तितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20129953,
    "chapter_id": 6997,
    "verse_number": "14.40",
    "content_sanskrit": "वर्णपदक्रमसिद्धः पदैकयोगाच्च वर्णयोगाच्च । सन्धीयते च यस्मात्तस्मात् सन्धिः समुद्दिष्टः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20129954,
    "chapter_id": 6997,
    "verse_number": "14.41",
    "content_sanskrit": "लुप्तविभक्तिर्नाम्नामेकार्थं संहरत्समासो ऽपि । तत्पुरुषादिकसंज्ञैर्निर्दिष्टः षड्विधो विप्राः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20129955,
    "chapter_id": 6997,
    "verse_number": "14.42",
    "content_sanskrit": "एभिः शब्दविधानैर्विस्तारव्यञ्जनार्थसंयुक्तैः । पदबन्धाः कर्तव्या निबद्धबन्धास्तु चूर्णा वा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20129956,
    "chapter_id": 6997,
    "verse_number": "14.43",
    "content_sanskrit": "विभक्त्यन्तं पदं ज्ञेयं निबद्धं चूर्णमेव च । तत्र चूर्णपदस्येह सन्निबोधत लक्षणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20129957,
    "chapter_id": 6997,
    "verse_number": "14.44",
    "content_sanskrit": "अनिबद्धपदं छन्दोविधानानियताक्षरम् । अर्थापेक्ष्यक्षरस्यूतं ज्ञेयं चूर्णपदं बुधैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20129958,
    "chapter_id": 6997,
    "verse_number": "14.45",
    "content_sanskrit": "निबद्धाक्षरसंयुक्तं यतिच्छेदसमन्वितम् । निबद्धं तु पदं ज्ञेयं प्रमाणनियतात्मकम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20129959,
    "chapter_id": 6997,
    "verse_number": "14.46",
    "content_sanskrit": "एवं नानार्थसंयुक्तैः पादैर्वर्णविभूषितैः । चतुर्भिस्तु भवेद्युक्तं छन्दो वृत्ताभिधानवत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20129960,
    "chapter_id": 6997,
    "verse_number": "14.47",
    "content_sanskrit": "षड्विंशतिः स्मृतान्येभिः पादैश्छन्दसि संख्यया । समञ्चार्धसमञ्चैव तथा विषममेव च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20129961,
    "chapter_id": 6997,
    "verse_number": "14.48",
    "content_sanskrit": "छन्दोयुक्तं समासेन त्रिविधं वृत्तमिष्यते । नानावृत्तिविनिष्पन्ना शब्दस्यैषा तनूस्स्मृता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20129962,
    "chapter_id": 6997,
    "verse_number": "14.49",
    "content_sanskrit": "छन्दोहीनो न शब्दो ऽस्ति न च्छन्दश्शब्दवर्जितम् । तस्मात्तूभ्यसंयोगो नाट्यस्योद्योतकः स्मृतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20129963,
    "chapter_id": 6997,
    "verse_number": "14.50",
    "content_sanskrit": "एकाक्षरं भवेदुक्तमत्युक्तं द्व्यक्षरं भवेत् । मध्यं त्र्यक्षरमित्याहुः प्रतिष्ठा चतुरक्षरा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20129964,
    "chapter_id": 6997,
    "verse_number": "14.51",
    "content_sanskrit": "सुप्रतिष्ठा भवेत् पञ्च गायत्री षड् भवेदिह । सप्ताक्षरा भवेदुष्णिगष्टाक्षरानुष्टुबुच्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20129965,
    "chapter_id": 6997,
    "verse_number": "14.52",
    "content_sanskrit": "नवाक्षरा तु बृहती पङ्क्तिश्चैव दशाक्षरा । एकादशाक्षरा त्रिष्टुब् जगती द्वादशाक्षरा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20129966,
    "chapter_id": 6997,
    "verse_number": "14.53",
    "content_sanskrit": "त्रयोदशाऽतिजगती शक्वरी तु चतुर्दशा । अतिशक्वरी पञ्चदशा षोडशाष्टिः प्रकीर्तिता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20129967,
    "chapter_id": 6997,
    "verse_number": "14.54",
    "content_sanskrit": "अत्यष्टिः स्यात्सप्तदशा धृतिरष्टादशाक्षरा । एकोनविंशतिर्धृतिः कृतिर्विंशतिरेव च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20129968,
    "chapter_id": 6997,
    "verse_number": "14.55",
    "content_sanskrit": "प्रकृतिश्चैकविंशत्या द्वाविंशत्याकृतिस्तथा । विकृतिः स्यात् त्रयोविंशा चतुर्विंशा च संकृतिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20129969,
    "chapter_id": 6997,
    "verse_number": "14.56",
    "content_sanskrit": "पञ्चविंशत्यतिकृतिः षड्विंशत्युत्कृतिर्भवेत् । अतो ऽधिकाक्षरं छन्दो मालावृत्तं तदिष्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20129970,
    "chapter_id": 6997,
    "verse_number": "14.57",
    "content_sanskrit": "छन्दसां तु तथा ह्येते भेदाः प्रस्तारयोगतः । असंख्येयप्रमाणानि वृत्तान्याहुरतो बुधाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20129971,
    "chapter_id": 6997,
    "verse_number": "14.58",
    "content_sanskrit": "गायत्रीप्रभृतित्त्वेषां प्रमाणं संविधीयते । प्रयोगजानि सर्वाणि प्रायशो न भवन्ति हि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20129972,
    "chapter_id": 6997,
    "verse_number": "14.59",
    "content_sanskrit": "वृत्तानि च चतुष्षष्टिर्गायत्र्यां कीर्तितानि तु । शतं विंशतिरष्टौ च वृत्तान्युष्णिह्यथोच्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20129973,
    "chapter_id": 6997,
    "verse_number": "14.60",
    "content_sanskrit": "षट्पञ्चाशच्छते द्वे च वृत्तानामप्यनुष्टुभि । शतानि पञ्च वृतानां बृहत्यां द्वादशैव च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20129974,
    "chapter_id": 6997,
    "verse_number": "14.61",
    "content_sanskrit": "पङ्क्त्यां सहस्रं वृत्तानां चतुर्विंशतिरेव च । त्रैष्टुभे द्वे सहस्रे च चत्वारिंशत्तथाष्ट च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20129975,
    "chapter_id": 6997,
    "verse_number": "14.62",
    "content_sanskrit": "सहस्राण्यपि चत्वारि नवतिश्च षडुत्तरा । जगत्यां समवर्णानां वृत्तानामिह सर्वशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20129976,
    "chapter_id": 6997,
    "verse_number": "14.63",
    "content_sanskrit": "अष्टौ सहस्राणि शतं द्व्यधिका नवतिः पुनः । जगत्यामतिपूर्वायां वृत्तानां परिमाणतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20129977,
    "chapter_id": 6997,
    "verse_number": "14.64",
    "content_sanskrit": "शतानि त्रीण्यशीतिश्च सहस्राण्यपि षोडश । वृत्तानि चैव चत्वारि शक्वर्याः परिसंख्यया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20129978,
    "chapter_id": 6997,
    "verse_number": "14.65",
    "content_sanskrit": "द्वात्रिंशच्च सहस्राणि सप्त चैव शतानि च । अष्टौ षष्टिश्च वृत्तानि ह्याश्रयन्त्यतिशक्वरीम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20129979,
    "chapter_id": 6997,
    "verse_number": "14.66",
    "content_sanskrit": "पञ्चषष्टिसहस्राणि सहस्रार्धञ्च संख्यया । षट्त्रिंशच्चैव वृत्तानि ह्यष्ट्यां निगदितानि च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20129980,
    "chapter_id": 6997,
    "verse_number": "14.67",
    "content_sanskrit": "एकत्रिंशत्सहस्राणि वृत्तानाञ्च द्विसप्ततिः । तथा शतसहस्रञ्च छन्दांस्यत्यष्टिसंज्ञिते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20129981,
    "chapter_id": 6997,
    "verse_number": "14.68",
    "content_sanskrit": "धृत्यामपि हि पिण्डेन वृत्तान्याकल्पितानि तु । तज्ज्ञैः शतसहस्रे द्वे शतमेकं तथैव च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20129982,
    "chapter_id": 6997,
    "verse_number": "14.69",
    "content_sanskrit": "द्विषष्टिश्च सहस्राणि चत्वारिंशच्च योगतः । चत्वारि चैव वृत्तानि समसंख्याश्रयाणि तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20129983,
    "chapter_id": 6997,
    "verse_number": "14.70",
    "content_sanskrit": "अतिधृत्यां सहस्राणि चतुर्विंशतिरेव च । तथा शतसहस्राणि पञ्च वृत्तशतद्वयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20129984,
    "chapter_id": 6997,
    "verse_number": "14.71",
    "content_sanskrit": "अष्टाशीतिश्च वृत्तानि वृत्तज्ञैः कथितानि च । कृतौ शतसहस्राणि दश प्रोक्तानि संख्यया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20129985,
    "chapter_id": 6997,
    "verse_number": "14.72",
    "content_sanskrit": "चत्वारिंशत्तथा चाष्टौ सहस्राणि शतानि च । पञ्चषट्सप्ततिश्चैव वृत्तानां परिमाणतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20129986,
    "chapter_id": 6997,
    "verse_number": "14.73",
    "content_sanskrit": "तथा शतसहस्राणां प्रकृतौ विंशतिर्भवेत् । सप्त वै गदितास्त्वत्र नवतिश्चैव संख्यया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20129987,
    "chapter_id": 6997,
    "verse_number": "14.74",
    "content_sanskrit": "सहस्राणि शतं चैकं द्विपञ्चाशत्तथैव च । वृत्तानि परिमाणेन वृत्तज्ञैर्गदितानि तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20129988,
    "chapter_id": 6997,
    "verse_number": "14.75",
    "content_sanskrit": "चत्वारिंशत्तथैकञ्च लक्षाणामथ संख्यया । तथा चेह सहस्राणि नवतिश्चतुरुत्तरा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20129989,
    "chapter_id": 6997,
    "verse_number": "14.76",
    "content_sanskrit": "शतत्रयं समाख्यातं ह्याकृत्यां चतुरुत्तरम् । ज्ञेया शतसहस्राणामशीतिस्त्र्यधिका बुधैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20129990,
    "chapter_id": 6997,
    "verse_number": "14.77",
    "content_sanskrit": "अष्टाशीति सहस्राणि वृत्तानां षट् शतानि च । अष्टौ चैव तु वृत्तानि विकृत्यां गदितानि तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20129991,
    "chapter_id": 6997,
    "verse_number": "14.78",
    "content_sanskrit": "तथा शतसहस्राणि सप्तषष्टिश्च सप्ततिः । सप्त चैव सहस्राणि षोडशे द्वे शते तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20129992,
    "chapter_id": 6997,
    "verse_number": "14.79",
    "content_sanskrit": "कोटिश्चैवेह वृत्तानि संकृतौ कथितानि वै । कोटित्रयञ्चाभिकृत्यां पञ्चत्रिंशद्भिरन्वितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20129993,
    "chapter_id": 6997,
    "verse_number": "14.80",
    "content_sanskrit": "पञ्चाशद्भिः सहस्रैश्च चतुर्भिरधिकैस्तथा । चतुष्टयं शतानाम् च द्वात्रिंशद्भिः समन्वितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20129994,
    "chapter_id": 6997,
    "verse_number": "14.81",
    "content_sanskrit": "षट् कोटयस्तथोत्कृत्यां लक्षाणामेकसप्ततिः । चतुष्षष्टिशतान्यष्टौ सहस्राण्यष्ट चैव हि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20129995,
    "chapter_id": 6997,
    "verse_number": "14.82",
    "content_sanskrit": "उक्तादुत्कृतिपर्यन्तवृत्तसंख्यां विचक्षणः । एतेन च विकल्पेन वृत्तेष्वेतेषु निर्दिशेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20129996,
    "chapter_id": 6997,
    "verse_number": "14.83",
    "content_sanskrit": "सर्वेषां छन्दसामेवं वृत्तानि कथितानि वै । तिस्रः कोटयो दश तथा सहस्राणां शतानि तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20129997,
    "chapter_id": 6997,
    "verse_number": "14.84",
    "content_sanskrit": "चत्वारिंशत्तथा द्वे च सहस्राणि दशैव तु । सप्तभिः सहितान्येव सप्त चैव शतानि च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20129998,
    "chapter_id": 6997,
    "verse_number": "14.85",
    "content_sanskrit": "षड्विंशतिरिहान्यानि व्याख्यातानि समासतः । समानि गणनायुक्तिमाश्रित्य कथितानि वै ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20129999,
    "chapter_id": 6997,
    "verse_number": "14.86",
    "content_sanskrit": "सर्वेषां छन्दसामेवं त्रिकैर्वृत्तं प्रयोजयेत् । ज्ञेयाश्चाष्टौ त्रिकास्तत्र संज्ञाभिः स्थानमच्छरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20130000,
    "chapter_id": 6997,
    "verse_number": "14.87",
    "content_sanskrit": "त्रीण्यक्षराणि विज्ञेयस्त्रिको ऽंशः परिकल्पितः । गुरुलघ्वक्षरकृतः सर्ववृत्तेषु नित्यशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20130001,
    "chapter_id": 6997,
    "verse_number": "14.88",
    "content_sanskrit": "गुरुपूर्वो भकारः स्यान्मकारे तु गुरुत्रयम् । जकारो गुरुमध्यस्थः सकारो ऽन्त्यगुरुस्तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  },
  {
    "id": 20130002,
    "chapter_id": 6997,
    "verse_number": "14.89",
    "content_sanskrit": "लघुमध्यस्थितो रेफस्तकारो ऽन्त्यलघुः परः । लघुपूर्वो यकारस्तु नकारे तु लघुत्रयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "avatarnika": ""
  },
  {
    "id": 20130003,
    "chapter_id": 6997,
    "verse_number": "14.90",
    "content_sanskrit": "एते ह्यष्टौ त्रिकाः प्राज्ञैर्विज्ञेया ब्रह्मसम्भवाः । लाघवार्थं पुनरमी छन्दोज्ञानमवेक्ष्य च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20130004,
    "chapter_id": 6997,
    "verse_number": "14.91",
    "content_sanskrit": "एभिर्विनिर्गताश्चान्या जातयो ऽथ समादयः । अस्वराः सस्वराश्चैव प्रोच्यन्ते वृत्तलक्षणैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  },
  {
    "id": 20130005,
    "chapter_id": 6997,
    "verse_number": "14.92",
    "content_sanskrit": "गुर्वेकं गिति विज्ञेयं तथा लघु लिति स्मृतम् । नियतः पदविच्छेदो यतिरित्यभिधीयते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 92,
    "avatarnika": ""
  },
  {
    "id": 20130006,
    "chapter_id": 6997,
    "verse_number": "14.93",
    "content_sanskrit": "गुरु दीर्घं प्लुतञ्चैव संयोगपरमेव च । सानुस्वारविसर्गं च तथान्त्यञ्च लघु क्वचित् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "avatarnika": ""
  },
  {
    "id": 20130007,
    "chapter_id": 6997,
    "verse_number": "14.94",
    "content_sanskrit": "गायत्र्यां द्वौ त्रिकौ ज्ञेयौ उष्णिक् चैकाधिकाक्षरा । अनुष्टुप् द्व्यधिका चैव बृहत्यां च त्रिकास्त्रयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 94,
    "avatarnika": ""
  },
  {
    "id": 20130008,
    "chapter_id": 6997,
    "verse_number": "14.95",
    "content_sanskrit": "एकाक्षराधिका पङ्क्तिस्त्रिष्टुप् च द्व्यधिकाक्षरा । चतुस्त्रिका तु जगती सैकातिजगती पुनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 95,
    "avatarnika": ""
  },
  {
    "id": 20130009,
    "chapter_id": 6997,
    "verse_number": "14.96",
    "content_sanskrit": "शक्वरी द्व्यधिका पञ्चत्रिका ज्ञेयातिशक्वरी । एकाधिकाक्षराष्टिश्च द्व्यधिकात्यष्टिरुच्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 96,
    "avatarnika": ""
  },
  {
    "id": 20130010,
    "chapter_id": 6997,
    "verse_number": "14.97",
    "content_sanskrit": "षट्त्रिकास्तु धृतिः प्रोक्ता सैका चातिधृतिस्तथा । कृतिश्च द्व्यधिका प्रोक्ता प्रकृत्यां सप्त वै त्रिकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 97,
    "avatarnika": ""
  },
  {
    "id": 20130011,
    "chapter_id": 6997,
    "verse_number": "14.98",
    "content_sanskrit": "आकृतिस्त्वधिकैकेन द्व्यधिका विकृतिस्तथा । अष्टत्रिकाः संकृतौ स्यात् सैका चाभिकृतिः पुनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 98,
    "avatarnika": ""
  },
  {
    "id": 20130012,
    "chapter_id": 6997,
    "verse_number": "14.99",
    "content_sanskrit": "उत्कृतिर्द्व्यधिका चैव विज्ञेया गणमानतः । गुर्वेकं ग इति प्रोक्तं गुरुणी गाविति स्मृतौ । लघ्वेकं ल इति ज्ञेयं लघुनी लाविति स्मृतौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 99,
    "avatarnika": ""
  },
  {
    "id": 20130013,
    "chapter_id": 6997,
    "verse_number": "14.100",
    "content_sanskrit": "संपद्विरामपादाश्च दैवतस्थानमक्षरम् । वर्णः स्वरो विधिर्वृत्तमिति छन्दोगतो विधिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 100,
    "avatarnika": ""
  },
  {
    "id": 20130014,
    "chapter_id": 6997,
    "verse_number": "14.101",
    "content_sanskrit": "नैवातिरिक्तं हीनं वा यत्र संपद्यते क्रमः । विधाने च्छन्दसामेष संपदित्यभिसंज्ञितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 101,
    "avatarnika": ""
  },
  {
    "id": 20130015,
    "chapter_id": 6997,
    "verse_number": "14.102",
    "content_sanskrit": "यत्रार्थस्य समाप्तिः स्यात् स विराम इति स्मृतः । पादश्च पद्यतेर्धातोश्चतुर्भाग इति स्मृतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 102,
    "avatarnika": ""
  },
  {
    "id": 20130016,
    "chapter_id": 6997,
    "verse_number": "14.103",
    "content_sanskrit": "अग्न्यादिदैवतं प्रोक्तं स्थानं द्विविधमुच्यते । शरीराश्रयसंभूतं दिगाश्रयमथापि च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 103,
    "avatarnika": ""
  },
  {
    "id": 20130017,
    "chapter_id": 6997,
    "verse_number": "14.104",
    "content_sanskrit": "शारीरं मन्त्रसंभूतं छन्दो गायत्रसंज्ञितम् । क्रुष्टे मध्यं दिनं प्रोक्तं त्रैष्टुभं परिकीर्त्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 104,
    "avatarnika": ""
  },
  {
    "id": 20130018,
    "chapter_id": 6997,
    "verse_number": "14.105",
    "content_sanskrit": "तृतीयसवनञ्चापि शीर्षण्यं जागतं हि यत् । ह्रस्वं दीर्घं प्लुतञ्चैव त्रिविधञ्चाक्षरं स्मृतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 105,
    "avatarnika": ""
  },
  {
    "id": 20130019,
    "chapter_id": 6997,
    "verse_number": "14.106",
    "content_sanskrit": "श्वेतादयस्तथा वर्णा विज्ञेयाश्छन्दसामिह । तारश्चैव हि मन्द्रश्च मध्यमस्त्रिविधः स्वरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 106,
    "avatarnika": ""
  },
  {
    "id": 20130020,
    "chapter_id": 6997,
    "verse_number": "14.107",
    "content_sanskrit": "ध्रुवाविधाने चैवास्य संप्रवक्ष्यामि लक्षणम् । विधिर्गणकृतश्चैव तथैवार्थकृतो भवेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 107,
    "avatarnika": ""
  },
  {
    "id": 20130021,
    "chapter_id": 6997,
    "verse_number": "14.108",
    "content_sanskrit": "छन्दतो यस्य पादे स्याद्धीनं वाऽधिकमेव वा । अक्षरं निचृदिति प्रोक्तं भूरिक् चेति द्विजोत्तमाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 108,
    "avatarnika": ""
  },
  {
    "id": 20130022,
    "chapter_id": 6997,
    "verse_number": "14.109",
    "content_sanskrit": "अक्षराभ्यां सदा द्वाभ्यामधिकं हीनमेव वा । तच्छन्दो नामतो ज्ञेयं स्वराडिति विराडपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 109,
    "avatarnika": ""
  },
  {
    "id": 20130023,
    "chapter_id": 6997,
    "verse_number": "14.110",
    "content_sanskrit": "सर्वेषामेव वृत्तानां तज्ज्ञैर्ज्ञेया गणास्त्रयः । दिव्यो दिव्येतरश्चैव दिव्यमानुष एव च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 110,
    "avatarnika": ""
  },
  {
    "id": 20130024,
    "chapter_id": 6997,
    "verse_number": "14.111",
    "content_sanskrit": "गायत्र्युष्णिगनुष्टुप् च बृहती पङ्क्तिरेव च । त्रिष्टुप् च जगती चैव दिव्यो ऽयं प्रथमो गणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 111,
    "avatarnika": ""
  },
  {
    "id": 20130025,
    "chapter_id": 6997,
    "verse_number": "14.112",
    "content_sanskrit": "तथातिजगती चैव शक्वरी चातिशक्वरी । अष्टिरत्यष्टिरपि च धृतिश्चातिधृतिर्गणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 112,
    "avatarnika": ""
  },
  {
    "id": 20130026,
    "chapter_id": 6997,
    "verse_number": "14.113",
    "content_sanskrit": "कृतिश्च प्रकृतिश्चैव ह्याकृतिर्विकृतिस्तथा । संकृत्यभिकृती चैव उत्कृतिर्दिव्यमानुषा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 113,
    "avatarnika": ""
  },
  {
    "id": 20130027,
    "chapter_id": 6997,
    "verse_number": "14.114",
    "content_sanskrit": "एतेषां छन्दसां भूयः प्रस्तारविधिसंश्रयम् । लक्षणं संप्रवक्ष्यामि नष्टमुद्दिष्टमेव च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 114,
    "avatarnika": ""
  },
  {
    "id": 20130028,
    "chapter_id": 6997,
    "verse_number": "14.115",
    "content_sanskrit": "प्रस्तारो ऽक्षरनिर्दिष्टो मात्रोक्तश्च तथैव हि । द्विकौ ग्लाविति वर्णोक्तौ मिश्रौ चेत्यपि मात्रिकौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 115,
    "avatarnika": ""
  },
  {
    "id": 20130029,
    "chapter_id": 6997,
    "verse_number": "14.116",
    "content_sanskrit": "गुरोरधस्तादाद्यस्य प्रस्तारे लघु विन्यसेत् । अग्रतस्तु समादेया गुरवः पृष्ठतस्तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 116,
    "avatarnika": ""
  },
  {
    "id": 20130030,
    "chapter_id": 6997,
    "verse_number": "14.117",
    "content_sanskrit": "प्रथमं गुरुभिर्वर्णैर्लघुभिस्त्ववसानजम् । वृत्तन्तु सर्वछन्दस्सु प्रस्तारविधिरेव तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 117,
    "avatarnika": ""
  },
  {
    "id": 20130031,
    "chapter_id": 6997,
    "verse_number": "14.118",
    "content_sanskrit": "गुर्वधस्ताल्लघुं न्यस्य तथा द्विद्वि यथोदितम् । न्यस्येत् प्रस्तारमार्गो ऽयमक्षरोक्तस्तु नित्यशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 118,
    "avatarnika": ""
  },
  {
    "id": 20130032,
    "chapter_id": 6997,
    "verse_number": "14.119",
    "content_sanskrit": "मात्रासंख्याविनिर्दिष्टो गणो मात्राविकल्पितः । मिश्रौ ग्लाविति विज्ञेयौ पृथक् लक्ष्यविभागतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 119,
    "avatarnika": ""
  },
  {
    "id": 20130033,
    "chapter_id": 6997,
    "verse_number": "14.120",
    "content_sanskrit": "मात्रागणो गुरुश्चैव लघुनी चैव लक्षिते । आर्याणां तु चतुर्मात्राप्रस्तारः परिकल्पितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 120,
    "avatarnika": ""
  },
  {
    "id": 20130034,
    "chapter_id": 6997,
    "verse_number": "14.121",
    "content_sanskrit": "गीतकप्रभृतीनान्तु पञ्चमात्रो गणः स्मृतः । वैतालीयं पुरस्कृत्य षण्मात्राद्यास्तथैव च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 121,
    "avatarnika": ""
  },
  {
    "id": 20130035,
    "chapter_id": 6997,
    "verse_number": "14.122",
    "content_sanskrit": "त्र्यक्षरास्तु त्रिका ज्ञेया लघुगुर्वक्षरान्विताः । मात्रागणविभागस्तु गुरुलघ्वक्षराश्रयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 122,
    "avatarnika": ""
  },
  {
    "id": 20130036,
    "chapter_id": 6997,
    "verse_number": "14.123",
    "content_sanskrit": "अन्त्याद् द्विगुणिताद्रूपाद् द्विद्विरेकं गुरोर्भवेत् । द्विगुणाञ्च लघोः कृत्वा संख्यां पिण्डेन योजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 123,
    "avatarnika": ""
  },
  {
    "id": 20130037,
    "chapter_id": 6997,
    "verse_number": "14.124",
    "content_sanskrit": "आद्यं सर्वगुरु ज्ञेयं वृत्तन्तु समसंज्ञितम् । कोशं तु सर्वलघ्वन्त्यं मिश्ररूपाणि सर्वतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 124,
    "avatarnika": ""
  },
  {
    "id": 20130038,
    "chapter_id": 6997,
    "verse_number": "14.125",
    "content_sanskrit": "वृत्तानां तु समानानां संख्यां संयोज्य तावतीम् । राश्यूनामर्धविषमां समासादभिनिर्दिशेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 125,
    "avatarnika": ""
  },
  {
    "id": 20130039,
    "chapter_id": 6997,
    "verse_number": "14.126",
    "content_sanskrit": "एकादिकां तथा संख्यां छन्दसो विनिवेश्य तु । यावत् पूर्णन्तु पूर्वेण पूरयेदुत्तरं गणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 126,
    "avatarnika": ""
  },
  {
    "id": 20130040,
    "chapter_id": 6997,
    "verse_number": "14.127",
    "content_sanskrit": "समानां विषमाणां च संगुणय्य तथा स्फुटम् । राश्यूनामभिजानीयाद्विषमाणां समासतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 127,
    "avatarnika": ""
  },
  {
    "id": 20130041,
    "chapter_id": 6997,
    "verse_number": "14.128",
    "content_sanskrit": "एवं कृत्वा तु सर्वेषां परेषां पूर्वपूरणम् । क्रमान्नैधनमेकैकं प्रतिलोमं विसर्जयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 128,
    "avatarnika": ""
  },
  {
    "id": 20130042,
    "chapter_id": 6997,
    "verse_number": "14.129",
    "content_sanskrit": "सर्वेषां छन्दसामेवं लघ्वक्षरविनिश्चयम् । जानीत समवृत्तानां संख्यां संक्षेपतस्तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 129,
    "avatarnika": ""
  },
  {
    "id": 20130043,
    "chapter_id": 6997,
    "verse_number": "14.130",
    "content_sanskrit": "वृत्तस्य परिमाणन्तु छित्वार्धेन यथाक्रमम् । न्यसेल्लघु यथा सैकमक्षरं गुरु चाप्यथ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 130,
    "avatarnika": ""
  },
  {
    "id": 20130044,
    "chapter_id": 6997,
    "verse_number": "14.131",
    "content_sanskrit": "एवं विन्यस्य वृत्तानां नष्टोद्दिष्टविभागतः । गुरुलघ्वक्षराणीह सर्वछन्दस्सु दर्शयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 131,
    "avatarnika": ""
  },
  {
    "id": 20130045,
    "chapter_id": 6997,
    "verse_number": "14.132",
    "content_sanskrit": "इति छन्दांसि यानीह मयोक्तानि द्विजोत्तमाः । वृत्तान्येतेषु नाट्ये ऽस्मिन् प्रयोज्यानि निबोधत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 132,
    "avatarnika": ""
  },
  {
    "id": 20130046,
    "chapter_id": 6997,
    "verse_number": "14.133",
    "content_sanskrit": "इति भारतीये नाट्यशास्त्रे वाचिकाभिनये छन्दोविधानं नाम चतुर्दशो ऽध्यायः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 133,
