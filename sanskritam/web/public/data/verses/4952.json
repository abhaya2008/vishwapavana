[{"id": 2186111, "chapter_id": 4952, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2186112, "chapter_id": 4952, "verse_number": "१", "content_sanskrit": "धर्माः पितामहेनोक्ता राजधर्माश्रिताः शुभाः ।\nधर्ममाश्रमिणां श्रेष्ठं वक्तुमर्हसि पार्थिव\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2186113, "chapter_id": 4952, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2186114, "chapter_id": 4952, "verse_number": "२", "content_sanskrit": "सर्वत्र विहितो धर्मः स्वर्ग्यः सत्यफलं तपः ।\nबहुद्वारस्य धर्मस्य नेहास्ति विफला क्रिया\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2186115, "chapter_id": 4952, "verse_number": "३", "content_sanskrit": "यस्मिन् यस्मिंस्तु विषये यो यो याति विनिश्चयम् ।\nस तमेवाभिजानाति नान्यं भरतसत्तम\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2186116, "chapter_id": 4952, "verse_number": "४", "content_sanskrit": "यथा यथा च पर्येति लोकतन्त्रमसारवत् ।\nतथा तथा विरागोऽत्र जायते नात्र संशयः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2186117, "chapter_id": 4952, "verse_number": "५", "content_sanskrit": "एवं व्यवसिते लोके बहुदोषे युधिष्ठिर ।\nआत्ममोक्षनिमित्तं वै यतेत मतिमान्नरः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2186118, "chapter_id": 4952, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2186119, "chapter_id": 4952, "verse_number": "६", "content_sanskrit": "नष्टे धने वा दारे वा पुत्रे पितरि वा मृते ।\nयया बुद्ध्या नुदेच्छोकं तन्मे ब्रूहि पितामह\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2186120, "chapter_id": 4952, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2186121, "chapter_id": 4952, "verse_number": "७", "content_sanskrit": "नष्टे धने वा दारे वा पुत्रे पितरि वा मृते ।\nअहो दुःखमिति ध्यायन् शोकस्यापचितिं चरेत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2186122, "chapter_id": 4952, "verse_number": "८", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nयथा सेनजितं विप्रः कश्चिदित्यब्रवीद् वचः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2186123, "chapter_id": 4952, "verse_number": "९", "content_sanskrit": "पुत्रशोकाभिसन्तप्तं राजानं शोकविह्वलम् ।\nविषण्णवदनं दृष्ट्वा विप्रो वचनमब्रवीत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2186124, "chapter_id": 4952, "verse_number": "१०", "content_sanskrit": "किं नु खल्वसि मूढस्त्वं शोच्यः किमनुशोचसि ।\nयदा त्वामपि शोचन्तः शोच्या यास्यन्ति तां गतिम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2186125, "chapter_id": 4952, "verse_number": "११", "content_sanskrit": "त्वं चैवाहं च ये चान्ये त्वां राजन् पर्युपासते ।\nसर्वे तत्र गमिष्यामो यत एवागता वयम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2186126, "chapter_id": 4952, "verse_number": "", "content_sanskrit": "सेनजित्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2186127, "chapter_id": 4952, "verse_number": "१२", "content_sanskrit": "का बुद्धिः किं तपो विप्र कः समाधिस्तपोधन ।\nकिं ज्ञानं किं श्रुतं वा ते यत् प्राप्य न विषीदसि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2186128, "chapter_id": 4952, "verse_number": "१३", "content_sanskrit": "हृष्यन्तमवसीदन्तं सुखदुःखविपर्यये ।\nआत्मानमनुशोचामि यो ममैष हृदि स्थितः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2186129, "chapter_id": 4952, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2186130, "chapter_id": 4952, "verse_number": "१४", "content_sanskrit": "पश्य भूतानि दुःखेन व्यतिषक्तानि सर्वशः ।\nआत्मापि चायं न मम सर्वा वा पृथिवी मम\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2186131, "chapter_id": 4952, "verse_number": "१५", "content_sanskrit": "यथा मम तथान्येषामिति बुद्ध्या न मे व्यथा ।\nएतां बुद्धिमहं प्राप्य न प्रहृष्ये न च व्यथे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2186132, "chapter_id": 4952, "verse_number": "१६", "content_sanskrit": "यथा काष्ठं च काष्ठं च समेयातां महोदधौ ।\nसमेत्य च व्यपेयातां तद्वद्भूतसमागमः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2186133, "chapter_id": 4952, "verse_number": "१७", "content_sanskrit": "एवं पुत्राश्च पौत्राश्च ज्ञातयो बान्धवास्तथा ।\nतेषु स्नेहो न कर्तव्यो विप्रयोगो हि तैर्ध्रुवम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2186134, "chapter_id": 4952, "verse_number": "१८", "content_sanskrit": "अदर्शनादापतितः पुनश्चादर्शनं गतः ।\nन त्वासौ वेद न त्वं तं कः सन्कमनुशोचसि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2186135, "chapter_id": 4952, "verse_number": "", "content_sanskrit": "तृष्णार्तिप्रभवं दुःखं दुःखार्तिप्रभवं सुखम् ।\nसुखात् सञ्जायते दुःखमेवमेतत् पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2186136, "chapter_id": 4952, "verse_number": "१९", "content_sanskrit": "सुखस्यानन्तरं दुःखं दुःखस्यानन्तरं सुखम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2186137, "chapter_id": 4952, "verse_number": "२०", "content_sanskrit": "सुखात् त्वं दुःखमापन्नः पुनरापत्स्यसे सुखम् ।\nन नित्यं लभते दुःखं न नित्यं लभते सुखम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2186138, "chapter_id": 4952, "verse_number": "२१", "content_sanskrit": "शरीरमेवायतनं सुखस्य ।\nदुःखस्य चाप्यायतनं शरीरम् ।\nयद्यच्छरीरेण करोति कर्म\nतेनैव देही समुपाश्नुते तत् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2186139, "chapter_id": 4952, "verse_number": "२२", "content_sanskrit": "जीवितं च शरीरं च जात्यैव सह जायते ।\nउभे सह विवर्धेते उभे सह विनश्यतः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2186140, "chapter_id": 4952, "verse_number": "२३", "content_sanskrit": "स्नेहपाशैर्बहुविधैराविष्टविषया जनाः ।\nअकृतार्था वसीदन्ते जलैः सैकतसेतवः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2186141, "chapter_id": 4952, "verse_number": "२४", "content_sanskrit": "स्नेहेन तैलवत् सर्वं सर्गचक्रे निपीड्यते ।\nतिलपीडैरिवाक्रम्य क्लेशैरज्ञानसम्भवैः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2186142, "chapter_id": 4952, "verse_number": "२५", "content_sanskrit": "सञ्चिनोत्यशुभं कर्म कलत्रापेक्षया नरः ।\nएकः क्लेशानवाप्नोति परत्रेह च मानवः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2186143, "chapter_id": 4952, "verse_number": "२६", "content_sanskrit": "पुत्रदारकुटुम्बेषु प्रसक्ताः सर्वमानवाः ।\nशोकपङ्कार्णवे मग्ना जीर्णा वनगजा इव \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2186144, "chapter_id": 4952, "verse_number": "२८", "content_sanskrit": "पुत्रनाशे वित्तनाशे ज्ञातिसम्बन्धिनामपि ।\nप्राप्यते सुमहद् दुःखं दावाग्निप्रतिमं विभो \t॥२७॥\nदैवायत्तमिदं सर्वं सुखदुःखे भवाभवौ ।\nअसुहृत् ससुहृच्चापि सशत्रुर्मित्रवानपि ।\nसप्रज्ञः प्रज्ञया हीनो दैवेन लभते सुखम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2186145, "chapter_id": 4952, "verse_number": "२९", "content_sanskrit": "नालं सुखाय सुहृदो नालं दुःखाय शत्रवः ।\nन च प्रज्ञालमर्थानां न सुखानामलं धनम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2186146, "chapter_id": 4952, "verse_number": "३०", "content_sanskrit": "न बुद्धिर्धनलाभाय न जाड्यमसमृद्धये ।\nलोकपर्यायवृत्तान्तं प्राज्ञो जानाति नेतरः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2186147, "chapter_id": 4952, "verse_number": "३१", "content_sanskrit": "बुद्धिमन्तं च मूढं च शूरं भीरुं जडं कविम् ।\nदुर्बलं बलवन्तं च भागिनं भजते सुखम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2186148, "chapter_id": 4952, "verse_number": "३२", "content_sanskrit": "धेनुर्वत्सस्य गोपस्य स्वामिनस्तस्करस्य च ।\nपयः पिबति यस्तस्या धेनुस्तस्येति निश्चयः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2186149, "chapter_id": 4952, "verse_number": "३३", "content_sanskrit": "ये च मूढतमा लोके ये च बुद्धेः परं गताः ।\nते नराः सुखमेधन्ते क्लिश्यत्यन्तरितो जनः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2186150, "chapter_id": 4952, "verse_number": "३४", "content_sanskrit": "अन्तेषु रेमिरे धीरा न ते मध्येषु रेमिरे ।\nअन्तप्राप्तिं सुखं प्राहुर्दुःखमन्तरमन्तयोः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2186151, "chapter_id": 4952, "verse_number": "३५", "content_sanskrit": "ये तु बुद्धिसुखं प्राप्ता द्वन्द्वातीता विमत्सराः ।\nतान्नैवार्था न चानर्था व्यथयन्ति कदाचन\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2186152, "chapter_id": 4952, "verse_number": "३६", "content_sanskrit": "सुखं स्वपिति दुर्मेधाः स्वानि कर्माण्यचिन्तयन् ।\nअविज्ञानेन महता कम्बलेनेव संवृतः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2186153, "chapter_id": 4952, "verse_number": "३७", "content_sanskrit": "अथ ये बुद्धिमप्राप्ता व्यतिक्रान्ताश्च मूढताम् ।\nतेऽतिवेलं प्रहृष्यन्ति सन्तापमुपयान्ति च\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2186154, "chapter_id": 4952, "verse_number": "३८", "content_sanskrit": "नित्यप्रमुदिता मूढा दिवि देवगणा इव ।\nअवलेपेन महता परितृप्ता विचेतसः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2186155, "chapter_id": 4952, "verse_number": "३९", "content_sanskrit": "सुखं दुःखान्तमालस्यं दुःखं दाक्ष्यं सुखोदयम् ।\nभूतिश्चैव श्रिया सार्धं दक्षे वसति नालसे\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2186156, "chapter_id": 4952, "verse_number": "४०", "content_sanskrit": "सुखं वा यदि वा दुःखं द्वेष्यं वा यदि वा प्रियम् ।\nप्राप्तं प्राप्तमुपासीत हृदयेनापराजितः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2186157, "chapter_id": 4952, "verse_number": "४१", "content_sanskrit": "शोकस्थानसहस्राणि हर्षस्थानशतानि च ।\nदिवसे दिवसे मूढमाविशन्ति न पण्डितम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2186158, "chapter_id": 4952, "verse_number": "४२", "content_sanskrit": "बुद्धिमन्तं कृतप्रज्ञं शुश्रूषुमनसूयकम् ।\nदान्तं जितेन्द्रियं चापि शोको न स्पृशते नरम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2186159, "chapter_id": 4952, "verse_number": "४३", "content_sanskrit": "एतां बुद्धिं समास्थाय गुप्तचित्तश्चरेद् बुधः ।\nशुक्लकृष्णगतिज्ञं तं देवासुरविनिर्गमम् ।\nउदयास्तमयज्ञं हि न शोकः स्प्रष्टुमर्हति\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2186160, "chapter_id": 4952, "verse_number": "४४", "content_sanskrit": "यन्निमित्तो भवेच्छोकस्त्रासो वा दुःखमेव वा ।\nआयासो वा यतो मूलस्तदेकाङ्गमपि त्यजेत्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2186161, "chapter_id": 4952, "verse_number": "४५", "content_sanskrit": "यद् यत् त्यजति कामानां तत् सुखस्याभिपूर्यते ।\nकामानुसारी पुरुषः कामाननु विनश्यति\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2186162, "chapter_id": 4952, "verse_number": "४६", "content_sanskrit": "यच्च कामसुखं लोके यच्च दिव्यं महत् सुखम् ।\nतृष्णाक्षयसुखस्यैते नार्हतः षोडशीं कलाम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2186163, "chapter_id": 4952, "verse_number": "४७", "content_sanskrit": "पूर्वदेहकृतं कर्म शुभं वा यदि वाशुभम् ।\nप्राज्ञं मूढं तथा शूरं भजते यादृशं कृतम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2186164, "chapter_id": 4952, "verse_number": "४८", "content_sanskrit": "एवमेव किलैतानि प्रियाण्येवाप्रियाणि च ।\nजीवेषु परिवर्तन्ते दुःखानि च सुखानि च\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2186165, "chapter_id": 4952, "verse_number": "४९", "content_sanskrit": "तदेवं बुद्धिमास्थाय सुखं जीवेद्गुणान्वितः ।\nसर्वान् कामान् जुगुप्सेत सङ्गान् कुर्वीत पृष्ठतः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2186166, "chapter_id": 4952, "verse_number": "५०", "content_sanskrit": "वृत्त एष हृदि प्रौढो मृत्युरेष मनोभयः ।\nक्रोधो नाम शरीरस्थो देहिनां प्रोच्यते बुधैः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2186167, "chapter_id": 4952, "verse_number": "५१", "content_sanskrit": "यदा संहरते कामान् कूर्मोऽङ्गानीव सर्वशः ।\nतदात्मज्योतिरात्मा च आत्मन्येव प्रसीदति\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2186168, "chapter_id": 4952, "verse_number": "५२", "content_sanskrit": "किञ्चिदेव ममत्वेन यदा भवति कल्पितम् ।\nतदेव परितापार्थं सर्वं सम्पद्यते तदा\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2186169, "chapter_id": 4952, "verse_number": "५३", "content_sanskrit": "न बिभेति यदा चायं यदा चास्मान्न बिभ्यति ।\nयदा नेच्छति न द्वेष्टि ब्रह्म सम्पद्यते तदा\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2186170, "chapter_id": 4952, "verse_number": "५४", "content_sanskrit": "उभे सत्यानृते त्यक्त्वा शोकानन्दौ भयाभये ।\nप्रियाप्रिये परित्यज्य प्रशान्तात्मा भविष्यसि\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2186171, "chapter_id": 4952, "verse_number": "५५", "content_sanskrit": "यदा न कुरुते धीरः सर्वभूतेषु पापकम् ।\nकर्मणा मनसा वाचा ब्रह्म सम्पद्यते तदा\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2186172, "chapter_id": 4952, "verse_number": "५६", "content_sanskrit": "या दुस्त्यजा दुर्मतिभिर्या न जीर्यति जीर्यतः ।\nयोऽसौ प्राणान्तिको रोगस्तां तृष्णां त्यजतः सुखम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2186173, "chapter_id": 4952, "verse_number": "५७", "content_sanskrit": "अत्र पिङ्गलया गीता गाथाः श्रूयन्ति पार्थिव ।\nयथा सा कृच्छ्रकालेऽपि लेभे धर्मं सनातनम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2186174, "chapter_id": 4952, "verse_number": "५८", "content_sanskrit": "सङ्केते पिङ्गला वेश्या कान्तेनासीद्विनाकृता ।\nअथ कृच्छ्रगता शान्तां बुद्धिमास्थापयत्तदा\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2186175, "chapter_id": 4952, "verse_number": "", "content_sanskrit": "पिङ्गला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2186176, "chapter_id": 4952, "verse_number": "५९", "content_sanskrit": "उन्मत्ताहमनुन्मत्तं कान्तमन्ववसं चिरम् ।\nअन्तिके रमणं सन्तं नैनमध्यगमं पुरा\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2186177, "chapter_id": 4952, "verse_number": "६०", "content_sanskrit": "एकस्थूणं नवद्वारमपिधास्याम्यगारकम् ।\nका हि कान्तमिहायान्तमयं कान्तेति मंस्यते\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2186178, "chapter_id": 4952, "verse_number": "६१", "content_sanskrit": "अकामाः कामरूपेण धूर्ता नरकरूपिणः ।\nपुनर्न यभयिष्यन्तिप्रतिबुद्धास्मि जागृमि\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2186179, "chapter_id": 4952, "verse_number": "६२", "content_sanskrit": "अनर्थोऽपि भवत्यर्थो दैवात् पूर्वकृतेन वा ।\nसम्बुद्धाहं निराकारा नाहमद्याजितेन्द्रिया\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2186180, "chapter_id": 4952, "verse_number": "६३", "content_sanskrit": "सुखं निराशः स्वपिति नैराश्यं परमं सुखम् ।\nआशामनाशां कृत्वा हि सुखं स्वपिति पिङ्गला\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2186181, "chapter_id": 4952, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2186182, "chapter_id": 4952, "verse_number": "६४", "content_sanskrit": "एतैश्चान्यैश्च विप्रस्य हेतुमद्भिः प्रभाषितैः ।\nपर्यवस्थापितो राजा सेनजिन्मुमुदे सुखम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2186183, "chapter_id": 4952, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे प्रथमोऽध्यायः ॥१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]