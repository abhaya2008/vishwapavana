[{"id": 7000778000, "chapter_id": 20778, "verse_number": "६-१२१-१", "content_sanskrit": "ईश्वर उवाच ।\nधात्रीच्छायां समाश्रित्य कुर्यात्पिंडं तु यो गुह ।\nमुक्तिं प्रयांति पितरः प्रसादान्माधवस्य तु ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000778001, "chapter_id": 20778, "verse_number": "६-१२१-२", "content_sanskrit": "मूर्ध्नि पाणौ मुखे चैव देहे चैव तु यो नरः ।\nधत्ते धात्रीफलं वत्स धात्रीफलविभूषितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000778002, "chapter_id": 20778, "verse_number": "६-१२१-३", "content_sanskrit": "धात्रीफलकृताहारो नरो नारायणो भवेत् ।\nयः कश्चिद्वैष्णवो लोके धत्ते धात्रीफलं गुह ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000778003, "chapter_id": 20778, "verse_number": "६-१२१-४", "content_sanskrit": "प्रियो भवति देवानां मनुष्याणं च का कथा ।\nन जह्यात्तुलसीमालां धात्रीमालां विशेषतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000778004, "chapter_id": 20778, "verse_number": "६-१२१-५", "content_sanskrit": "यावत्तिष्ठति कंठस्था धात्रीमाला नरस्य हि ।\nतावत्तस्य शरीरे तु प्रतिष्ठति च केशवः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000778005, "chapter_id": 20778, "verse_number": "६-१२१-६", "content_sanskrit": "धात्रीं फलं तु तुलसीमृत्तिका द्वारकोद्भवा ।\nसफलं जीवितं तस्य त्रितयं यस्य वेश्मनि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000778006, "chapter_id": 20778, "verse_number": "६-१२१-७", "content_sanskrit": "यावद्दिनानि वहते धात्रीमालां कलौ नरः ।\nतावद्युगसहस्राणि वैकुंठे वसतिर्भवेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000778007, "chapter_id": 20778, "verse_number": "६-१२१-८", "content_sanskrit": "मालायुग्मं वहेद्यस्तु धात्रीतुलसिसंभवम् ।\nवहते कंठदेशे तु कल्पकोटिं दिवं वसेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000778008, "chapter_id": 20778, "verse_number": "६-१२१-९", "content_sanskrit": "संनियम्येंद्रियग्रामं शालग्रामशिलार्चनम् ।\nयः कुर्यान्मानवो भक्त्या पुष्पेपुष्पेऽश्वमेधजम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000778009, "chapter_id": 20778, "verse_number": "६-१२१-१०", "content_sanskrit": "सुराणां च यथा विष्णुः पुष्पाणां तुलसी तथा ।\nतुलस्यानुदिनं देवं योऽर्चयेद्गरुडध्वजम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000778010, "chapter_id": 20778, "verse_number": "६-१२१-११", "content_sanskrit": "जन्मदुःखजरारोगैर्मुक्तोऽसौ मुक्तिमाप्नुयात् ।\nतुलसीमालया विष्णुः पूजितो येन कार्तिके ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000778011, "chapter_id": 20778, "verse_number": "६-१२१-१२", "content_sanskrit": "यमाक्षरकृतां मालां स्फुटं शौरिः प्रमार्जति ।\nश्रीचंदनं सकर्पूरमगुरुं च सकुंकुमम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000778012, "chapter_id": 20778, "verse_number": "६-१२१-१३", "content_sanskrit": "केतकी दीपदानं च सर्वदा केशवप्रियम् ।\nकार्तिके केतकीपुष्पं दत्तं येन कलौ युगे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000778013, "chapter_id": 20778, "verse_number": "६-१२१-१४", "content_sanskrit": "दीपदानं महासेन कुलानां तारयेच्छतम् ।\nसरोरुहाणि तुलसी केतकी मुनिपुष्पकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000778014, "chapter_id": 20778, "verse_number": "६-१२१-१५", "content_sanskrit": "कार्तिके च दिनान्येव दीपदानं तु पंचमम् ।\nकेतकीमालया येन कार्तिके पुष्पमंडपम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000778015, "chapter_id": 20778, "verse_number": "६-१२१-१६", "content_sanskrit": "केशवस्य कृतं वत्स वसतिर्दिवि तस्य च ।\nकेतकीपुष्पकेनैव पूजितो गरुडध्वजः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000778016, "chapter_id": 20778, "verse_number": "६-१२१-१७", "content_sanskrit": "समाः सहस्रं सुप्रीतो जायते मधुसूदनः ।\nअर्चयित्वा हृषीकेशं कुसुमैः केतकीभवैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000778017, "chapter_id": 20778, "verse_number": "६-१२१-१८", "content_sanskrit": "पुण्यं तद्भवनं याति केशवस्य शिवं गुह ।\nदमनकेनापि देवेशं संप्राप्ते मधुमाधवे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000778018, "chapter_id": 20778, "verse_number": "६-१२१-१९", "content_sanskrit": "समभ्यर्च्य मुनिश्रेष्ठ अर्चनाल्लभते फलम् ।\nअगस्तिकुसुमैर्देवं योऽर्चयेत जनार्दनम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000778019, "chapter_id": 20778, "verse_number": "६-१२१-२०", "content_sanskrit": "दर्शनात्तस्य भो विप्र नरकाग्निः प्रणश्यति ।\nन तत्करोति विप्रर्षे तपसा तोषितो हरिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000778020, "chapter_id": 20778, "verse_number": "६-१२१-२१", "content_sanskrit": "यत्करोति महासेन मुनिपुष्पैरलंकृतः ।\nविहाय सर्वपुष्पाणि मुनिपुष्पेण केशवम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000778021, "chapter_id": 20778, "verse_number": "६-१२१-२२", "content_sanskrit": "कार्तिके योऽर्चयेद्भक्त्या वाजिमेधफलं लभेत् ।\nमुनिपुष्पकृतां मालां यो ददाति जनार्दने ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000778022, "chapter_id": 20778, "verse_number": "६-१२१-२३", "content_sanskrit": "देवेंद्रोऽपि मुनिश्रेष्ठ कुरुते तस्य सत्कथाम् ।\nगवामयुतदानेन यत्फलं प्राप्यते गुह ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000778023, "chapter_id": 20778, "verse_number": "६-१२१-२४", "content_sanskrit": "मुनिपुष्पेण चैकेन कार्तिके लभते फलम् ।\nकौस्तुभेन यथा प्रीतो यथा च वनमालया ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000778024, "chapter_id": 20778, "verse_number": "६-१२१-२५", "content_sanskrit": "तुलसीदलेन संप्रीतः कार्तिके च तथा हरिः ।\nसिऊत उवाच ।\nप्रश्रयावनतं दृष्ट्वा कुमारं भक्तितत्परम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000778025, "chapter_id": 20778, "verse_number": "६-१२१-२६", "content_sanskrit": "पुनः प्रोवाच भगवान्महादेवो वृषध्वजः ।\nईश्वर उवाच ।\nशृणु दीपस्य माहात्म्यं कार्तिके शिखिवाहन ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000778026, "chapter_id": 20778, "verse_number": "६-१२१-२७", "content_sanskrit": "पितरश्चैव वांच्छंति सदा पितृगणैर्वृताः ।\nभविष्यति कुलेऽस्माकं पितृभक्तः सुपुत्रकः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000778027, "chapter_id": 20778, "verse_number": "६-१२१-२८", "content_sanskrit": "कार्तिके दीपदानेन यस्तोषयति केशवम् ।\nघृतेन दीपको यस्य तिलतैलेन वा पुनः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000778028, "chapter_id": 20778, "verse_number": "६-१२१-२९", "content_sanskrit": "ज्वलते यस्य सेनानीरश्वमेधेन तस्य किम् ।\nतेनेष्टं क्रतुभिः सर्वैः कृतं तीर्थावगाहनम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000778029, "chapter_id": 20778, "verse_number": "६-१२१-३०", "content_sanskrit": "दीपदानं कृतं येन कार्तिके केशवाग्रतः ।\nकृष्णपक्षे विशेषेण पुत्र पंचदिनानि च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000778030, "chapter_id": 20778, "verse_number": "६-१२१-३१", "content_sanskrit": "पुण्यानि तेषु यो दत्ते दीपं सोऽक्षयमाप्नुयात् ।\nएकादश्यां परैर्दत्तं दीपं प्रज्वाल्य मूषिका ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000778031, "chapter_id": 20778, "verse_number": "६-१२१-३२", "content_sanskrit": "मानुष्यं दुर्ल्लभं प्राप्य परां गतिमवाप सा ।\nलुब्धकोऽपि चतुर्दश्यां पूजयित्वा महेश्वरम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000778032, "chapter_id": 20778, "verse_number": "६-१२१-३३", "content_sanskrit": "निर्भक्षः परमं प्राप्य विष्णुलोकं जगाम सः ।\nश्वपाकस्याश्रयाद्वैश्या दीपं कृत्वा परैः कृतम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000778033, "chapter_id": 20778, "verse_number": "६-१२१-३४", "content_sanskrit": "शुद्धा लीलावती भूत्वा जगाम स्वर्गमक्षयम् ।\nगोपः कश्चिदमावस्यां पूजां दृष्ट्वा तु शार्ङ्गिणः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000778034, "chapter_id": 20778, "verse_number": "६-१२१-३५", "content_sanskrit": "मुहुर्मुहुर्जयेत्युक्त्वा राजराजेश्वरोऽभवत् ।\nतस्माद्दीपाः प्रदातव्या रात्रावस्तमते रवौ ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000778035, "chapter_id": 20778, "verse_number": "६-१२१-३६", "content_sanskrit": "गृहेषु सर्वगोष्ठेषु सर्वेष्वायतनेषु च ।\nदेवालयेषु देवानां श्मशानेषु सरस्सु च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000778036, "chapter_id": 20778, "verse_number": "६-१२१-३७", "content_sanskrit": "घृतादिना शुभार्थाय यावत्पंचदिनानि च ।\nपापिनः पितरो ये च लुप्तपिंडोदकक्रियाः ।\nतेपि यांति परां मुक्तिं दीपदानस्य पुण्यतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]