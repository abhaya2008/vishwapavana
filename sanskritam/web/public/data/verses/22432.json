[{"id": 7002432000, "chapter_id": 22432, "verse_number": "१-९४-१", "content_sanskrit": "ब्रह्मोवाच ।\nअत्राख्यानमुशन्तीह संवादं गणपुङ्गव ।\nपितामहकुमाराभ्यां पुण्यं पापहरं शिवम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002432001, "chapter_id": 22432, "verse_number": "१-९४-२", "content_sanskrit": "स्रष्टारं सर्वलोकानां सुखासीनं पितामहम् ।\nप्रणम्य शिरसा देवं श्रद्धाभक्तिसमन्वितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002432002, "chapter_id": 22432, "verse_number": "१-९४-३", "content_sanskrit": "कुमारो देवशार्दूल इदं वचनमब्रवीत् ।\nगतोऽहमद्य भगवन्द्रष्टुं देवं दिवाकरम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002432003, "chapter_id": 22432, "verse_number": "१-९४-४", "content_sanskrit": "कृत्वा प्रदक्षिणं देवः स मया पूजितो रविः ।\nप्रणम्य शिरसा भक्त्या परया श्रद्धया विभो ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002432004, "chapter_id": 22432, "verse_number": "१-९४-५", "content_sanskrit": "अनुज्ञातस्ततस्तेन सुखासीनो ह्यहं स्थितः ।\nआसीनेन मया तत्र दृष्टमाश्चर्यमद्भुतम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002432005, "chapter_id": 22432, "verse_number": "१-९४-६", "content_sanskrit": "काञ्चनेन विमानेन किङ्किणीजालमालिना ।\nमणिमुक्ताविचित्रेण वैदूर्यवरवेदिना ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002432006, "chapter_id": 22432, "verse_number": "१-९४-७", "content_sanskrit": "आगतं पुरुषं तत्र दृष्ट्वा देवो दिवाकरः ।\nससम्भ्रमं समुत्थाय आसनादेव सत्तम ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002432007, "chapter_id": 22432, "verse_number": "१-९४-८", "content_sanskrit": "गृहीत्वा१ दक्षिणे पाणौ पुरतः प्राप्य तं नरम् ।\nशिरस्याघ्राय देवेश पूजयामास वै रविः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002432008, "chapter_id": 22432, "verse_number": "१-९४-९", "content_sanskrit": "उपविष्टं तु तं भानुरिदं वचनमब्रवीत् ।\nसुस्वागतं भद्र सुखकृता प्रीतास्त्वया वयम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002432009, "chapter_id": 22432, "verse_number": "१-९४-१०", "content_sanskrit": "समीपे मम तिष्ठ त्वं यावदाभूतसंप्लवम् ।\nपुनर्यास्यसि तत्स्थानं यत्र ब्रह्मा स्वयं स्थितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002432010, "chapter_id": 22432, "verse_number": "१-९४-११", "content_sanskrit": "एतस्मिन्नंतरे चान्यो विमानवरमास्थितः ।\nआगतः पुरुषो देवो यत्र तिष्ठति भास्करः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002432011, "chapter_id": 22432, "verse_number": "१-९४-१२", "content_sanskrit": "स चाप्येवं नरो देव पूजितो भानुना तदा ।\nसामपूर्वं तथोक्तस्तु प्रश्रयावनतः स्थितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002432012, "chapter_id": 22432, "verse_number": "१-९४-१३", "content_sanskrit": "तत्र मे कौतुकं जातं दृष्ट्वा पूजां कृतां तयोः ।\nभानुना देवशार्दूल पृष्टो भानुर्मया ततः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002432013, "chapter_id": 22432, "verse_number": "१-९४-१४", "content_sanskrit": "किमनेन कृतं देव योऽयं पूर्वमिहागतः ।\nनरस्तत्र सकाशं वै यस्य तुष्टो भवादृशाम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002432014, "chapter_id": 22432, "verse_number": "१-९४-१५", "content_sanskrit": "यदस्य भवता पूजा कृता हि स्वयमेव तु ।\nअत्र मे कौतुकं जातं विस्मयश्च विशेषतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002432015, "chapter_id": 22432, "verse_number": "१-९४-१६", "content_sanskrit": "तथैवास्य कृता पूजा द्वितीयस्य नरस्य च ।\nसर्वथा पुण्यकर्माणाविमौ नरवरोत्तमौ ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002432016, "chapter_id": 22432, "verse_number": "१-९४-१७", "content_sanskrit": "ब्रह्मविष्णुशिवाद्यैस्तु पूज्यते भगवान्सदा ।\nयस्त्वमाभ्यां परं पूजां कृतवान्देवसत्तम ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002432017, "chapter_id": 22432, "verse_number": "१-९४-१८", "content_sanskrit": "कथ्यतां मम देवेश किमेतौ कर्म चक्रतुः ।\nयस्येदृक्परमं पुण्यं फलं दिव्यमवापतुः ।\nश्रुत्वा तद्वचनं देव इदं वचनमब्रवीत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002432018, "chapter_id": 22432, "verse_number": "१-९४-१९", "content_sanskrit": "सूर्य उवाच ।\nसाधु पृष्टोऽस्मि भवता कर्मणो निर्णयं परम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002432019, "chapter_id": 22432, "verse_number": "१-९४-२०", "content_sanskrit": "यदनेन कृतं कर्म नरेण मुनिसत्तम ।\nयोऽसौ सूर्यमिहायातस्तच्छृणुष्व महामते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002432020, "chapter_id": 22432, "verse_number": "१-९४-२१", "content_sanskrit": "येयं मदंशसम्भूतैः पार्थिवैः पालिता सदा ।\nअयोध्या नाम नगरी प्रख्याता पृथिवीतले ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002432021, "chapter_id": 22432, "verse_number": "१-९४-२२", "content_sanskrit": "तत्रासौ वैश्यजातीयो धनपाल इति स्मृतः ।\nतस्याः पुर्यां द्विजश्रेष्ठ दिव्यमायतनं व्यधात्१ ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002432022, "chapter_id": 22432, "verse_number": "१-९४-२३", "content_sanskrit": "तस्मिन्नायतने दिव्ये ह्याम्नायार्थं तथाश्रितः ।\nब्राह्मणानां विशिष्टानां पूजयित्या कदम्बकम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002432023, "chapter_id": 22432, "verse_number": "१-९४-२४", "content_sanskrit": "इतिहासपुराणाभ्यां वाचकं च विशेषतः ।\nपूजयित्वा द्विजश्रेष्ठं मुनश्रेष्ठं महामुनिम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002432024, "chapter_id": 22432, "verse_number": "१-९४-२५", "content_sanskrit": "पुस्तकं चापि सम्पूज्य गन्धपुष्पोपहारतः ।\nतस्य विप्रकदम्बस्य व्यासस्य च यथाग्रतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002432025, "chapter_id": 22432, "verse_number": "१-९४-२६", "content_sanskrit": "प्रकल्प्योक्तो द्विजोऽनेन पाठको२ वाचकोत्तमः ।\nएष तिष्ठति देवेशः सहस्रकिरणो रविः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002432026, "chapter_id": 22432, "verse_number": "१-९४-२७", "content_sanskrit": "चातुर्वर्ण्यमिदं वापि श्रोतुकामं कदम्बकम् ।\nतिष्ठ चेह द्विजश्रेष्ठ कुरु पुस्तकवाचनम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002432027, "chapter_id": 22432, "verse_number": "१-९४-२८", "content_sanskrit": "येन मे वरदो भानुः३ सप्त जन्मानि वै भवेत् ।\nयावत्संवत्सरं विप्र प्रगृह्य वृत्तिमुत्तमाम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002432028, "chapter_id": 22432, "verse_number": "१-९४-२९", "content_sanskrit": "स्वर्णनिष्कशतं विप्र ततो दास्ये तथापरम् ।\nपूर्णे वर्षे द्विजश्रेष्ठ श्रेयोऽर्थमहमात्मनः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002432029, "chapter_id": 22432, "verse_number": "१-९४-३०", "content_sanskrit": "एवं प्रवर्तिते तस्मिन्पुण्ये पुस्तकवाचने ।\nषण्मासागतमात्रे तु काले सुरवरोत्तम ।\nतथैवान्तरतश्चायं कालधर्ममुपेयिवान् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002432030, "chapter_id": 22432, "verse_number": "१-९४-३१", "content_sanskrit": "मया चास्य विमानं तु प्रेषितं कुर्वतो व्रतम् ।\nइत्येषा कर्मणस्तुष्टिः पुण्याख्यानकजार्चिता ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002432031, "chapter_id": 22432, "verse_number": "१-९४-३२", "content_sanskrit": "गन्धपुष्पोपहारैस्तु न तथा जायते मम ।\nप्रीतिर्देववर श्रेष्ठ पुराणश्रवणे यथा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002432032, "chapter_id": 22432, "verse_number": "१-९४-३३", "content_sanskrit": "गोसुवर्णहिरण्यानां वस्त्राणां चापि कृत्स्नशः ।\nग्रामाणां नगराणां च दानं प्रीतिकरं मम ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002432033, "chapter_id": 22432, "verse_number": "१-९४-३४", "content_sanskrit": "न तथा स्यात्सुरश्रेष्ठ यथा प्रीतिकरं गुह ।\nइतिहासपुराणाभ्यां श्रवणं सुरसैन्यप ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002432034, "chapter_id": 22432, "verse_number": "१-९४-३५", "content_sanskrit": "श्राद्धं कुर्वन्ति ये मह्यं भक्ष्यभोज्यैरनेकशः ।\nन करोति तथा प्रीतिर्यथा पुस्तकवाचनम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002432035, "chapter_id": 22432, "verse_number": "१-९४-३६", "content_sanskrit": "कर्णश्राद्धे यथा प्रीतिर्मम स्यात्सुरसत्तम ।\nन तथा जायते प्रीतिर्भोज्यश्राद्धे तथैव च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002432036, "chapter_id": 22432, "verse_number": "१-९४-३७", "content_sanskrit": "अथ किं बहुनोक्तेन नान्यत्प्रीतिकरं मम ।\nपुण्याख्यानादृते देव गुह्यमेतत्प्रकीतितम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002432037, "chapter_id": 22432, "verse_number": "१-९४-३८", "content_sanskrit": "यश्चायमपरो विप्र इहायतो नरोत्तमः ।\nअयमासीद्दिवजश्रेष्ठस्तस्मिन्नेव पुरोत्तमे ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002432038, "chapter_id": 22432, "verse_number": "१-९४-३९", "content_sanskrit": "एकदा तु गतश्चायं धर्मश्रवणमुत्तमम् ।\nश्रोतुं भक्त्या द्द्विजश्रेष्ठ श्रद्धया परया वृतः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002432039, "chapter_id": 22432, "verse_number": "१-९४-४०", "content_sanskrit": "श्रुत्वा तत्र ततो भक्त्या पुण्याख्यानमनुत्तमम् ।\nकृत्वा प्रदक्षिणं तस्य वाचकस्य महात्मनः ।\nएष विप्रोऽमरश्रेष्ठ दत्तवान्स्वर्णमाषकम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002432040, "chapter_id": 22432, "verse_number": "१-९४-४१", "content_sanskrit": "दत्त्वा तु दक्षिणां तस्मै वाचकायामितौजसे ।\nआनन्दमगमद्विप्रः प्राप्तवान्काञ्चनं यथा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002432041, "chapter_id": 22432, "verse_number": "१-९४-४२", "content_sanskrit": "एतद्धि सफलं चास्य न चान्यत्कृतवानयम् ।\nयदनेन कृता पूजा वाचकस्य महात्मनः ।\nफलं हि कर्मणस्तस्य यन्मया पूजितः स्वयम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002432042, "chapter_id": 22432, "verse_number": "१-९४-४३", "content_sanskrit": "वाचकं पूजयेद्यस्तु श्रद्धाभक्तिसमन्वितः ।\nतेनाहं पूजितः स्यां वै को विष्णुः शङ्करस्तथा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002432043, "chapter_id": 22432, "verse_number": "१-९४-४४", "content_sanskrit": "वाचकं भोजयेद्यस्तु भक्त्या भोज्येरनुत्तमैः ।\nतेनाहं पूजितः स्यां वै दश वर्षाणि पञ्च च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002432044, "chapter_id": 22432, "verse_number": "१-९४-४५", "content_sanskrit": "न यमो न यमी चापि न मन्दो न मनुस्तथा ।\nतपती न तथान्विष्टा यथेष्टो वाचको मम ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002432045, "chapter_id": 22432, "verse_number": "१-९४-४६", "content_sanskrit": "वाचके सत्कृते देव भोजिते सुरसैन्यप ।\nतृप्तिर्भवति मे देव संवत्सरशतद्वयम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002432046, "chapter_id": 22432, "verse_number": "१-९४-४७", "content_sanskrit": "न केवलं मम प्रीतिर्वाचके भोजिते भवेत् ।\nकृत्स्नशो देवतानां च इन्द्रादीनां तथा भवेत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002432047, "chapter_id": 22432, "verse_number": "१-९४-४८", "content_sanskrit": "ब्रह्मविष्णुशिवादीनां स चेष्ठो वाचको मम ।\nप्रीते तस्मिन्देवताः स्युः सर्वाः प्रीता न संशयः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002432048, "chapter_id": 22432, "verse_number": "१-९४-४९", "content_sanskrit": "इत्येतत्कथितं सर्वमाभ्यां कर्म महाबल ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002432049, "chapter_id": 22432, "verse_number": "१-९४-५०", "content_sanskrit": "न चान्यच्चक्रतुः कर्म किमन्यच्छ्रोतुमिच्छसि ।\nएतद्दृष्ट्वाहमाश्चर्यं तवाभ्याशमिहागतः ।\nकिमत्र तथ्यं देवेश कथ्यतां कौतुकं मम ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002432050, "chapter_id": 22432, "verse_number": "१-९४-५१", "content_sanskrit": "श्रुत्वा कुमारवचनं सर्वलोकपितामहः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002432051, "chapter_id": 22432, "verse_number": "१-९४-५२", "content_sanskrit": "ब्रह्मोवाच ।\nहन्त भोः साधु पुण्योऽसि नास्ति तुल्यस्त्वयापरः ।\nयद्दृष्टौ भवता तौ हि सुपुण्यौ पुण्यकारिणौ ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002432052, "chapter_id": 22432, "verse_number": "१-९४-५३", "content_sanskrit": "यदुक्तं भानुना वत्स तत्तथा नान्यथा भवेत् ।\nयदासीन्मे मुखं पुत्र प्रथमं लोकपूजितम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002432053, "chapter_id": 22432, "verse_number": "१-९४-५४", "content_sanskrit": "तस्मादेतानि सर्वाणि निर्गतानि समन्ततः ।\nइतिहासपुराणानि लोकानां हितकाम्यया ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002432054, "chapter_id": 22432, "verse_number": "१-९४-५५", "content_sanskrit": "यथैतानि ममेष्टानि पुराणानि महामते ।\nन तथा वै चतुर्वेदी न चाङ्गिनि महामते ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002432055, "chapter_id": 22432, "verse_number": "१-९४-५६", "content_sanskrit": "शृण्वन्त्येतानि ये भक्त्या नित्यं श्रद्धासमन्विताः ।\nदत्त्वा तु वाचके वृत्तिं ते गच्छन्ति परं पदम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002432056, "chapter_id": 22432, "verse_number": "१-९४-५७", "content_sanskrit": "धर्मार्थकाममोक्षाणां स्पष्टीकरणमुत्तमम् ।\nइतिहासपुराणानि मया सृष्टानि सुव्रत ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002432057, "chapter_id": 22432, "verse_number": "१-९४-५८", "content_sanskrit": "चत्वारो य इमे वेदा गूढार्थाः सततं स्मृताः ।\nअतस्त्वेतानि सृष्टानि बोधायैषां महामते ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002432058, "chapter_id": 22432, "verse_number": "१-९४-५९", "content_sanskrit": "यस्तु कारयते नित्यं धर्मश्रवणमुत्तमम् ।\nआदित्याद्भास्करं प्राप्य याति तत्परमं पदम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002432059, "chapter_id": 22432, "verse_number": "१-९४-६०", "content_sanskrit": "दत्त्वा तु दक्षिणां तत्र आदित्यस्य पुरं व्रजेत् ।\nकिमाश्चर्यं सुरश्रेष्ठ दानपात्रं हि तत्परम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002432060, "chapter_id": 22432, "verse_number": "१-९४-६१", "content_sanskrit": "यथा देववरो लेखो यथा हेतिः परं पविः ।\nब्राह्मणानां तथा श्रेष्ठो वाचको नात्र संशयः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002432061, "chapter_id": 22432, "verse_number": "१-९४-६२", "content_sanskrit": "हेतिर्यथा तेजसां तु सरसां सागरो यथा ।\nतथा सर्वद्विजेभ्यस्तु वाचकः प्रवरः स्मृतः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002432062, "chapter_id": 22432, "verse_number": "१-९४-६३", "content_sanskrit": "वाचकं पूजयेद्यस्तु नरो भक्तिपुरः सरम् ।\nपूजितं सकलं तेन जगत्यान्नात्र संशयः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002432063, "chapter_id": 22432, "verse_number": "१-९४-६४", "content_sanskrit": "सत्यमुक्तं न सन्देहो भानुना मत्कुलोद्वह ।\nवाचकेन समं पात्रं न जात्वन्यद्भवेत्क्वचित् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002432064, "chapter_id": 22432, "verse_number": "१-९४-६५", "content_sanskrit": "तच्छ्रुत्वा ब्रह्मणो वाक्यं कुमारो वाक्यमब्रवीत् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002432065, "chapter_id": 22432, "verse_number": "१-९४-६६", "content_sanskrit": "अहो हि धन्यता तस्य पुण्यश्रवणकारिणः ।\nदानं च ददतोऽत्यर्थं पुण्यता वाचकाय वै ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002432066, "chapter_id": 22432, "verse_number": "१-९४-६७", "content_sanskrit": "ब्रह्मोवाच ।\nइत्थं दिण्डे सदा यस्तु देवदेवस्य मन्दिरे ।\nकुर्यात्तु धर्मश्रवणं स याति परमां गतिम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]