[{"id": 2176842, "chapter_id": 4738, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2176843, "chapter_id": 4738, "verse_number": "१", "content_sanskrit": "ततस्ते सहिताः सर्वे प्रयाता दक्षिणामुखाः ।\nउपास्तमयवेलायां शिबिराभ्याशमागताः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2176844, "chapter_id": 4738, "verse_number": "२", "content_sanskrit": "विमुच्य वाहांस्त्वरिता भीताः समनुबोधनात् ।\nगहनं देशमागम्य प्रच्छन्ना न्यविशन्त ते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2176845, "chapter_id": 4738, "verse_number": "३", "content_sanskrit": "सेनानिवेशमभितो नातिदूरमवस्थिताः ।\nनिकृत्ता निशितैः शस्त्रैः समन्तात् क्षतविक्षताः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2176846, "chapter_id": 4738, "verse_number": "४", "content_sanskrit": "दीर्घमुष्णं च निःश्वस्य पाण्डवानन्वचिन्तयन्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2176847, "chapter_id": 4738, "verse_number": "५", "content_sanskrit": "श्रुत्वा च निनदं घोरं पाण्डवानां जयैषिणाम् ।\nअनुसारभयाद् भीताः प्राङ्मुखाः प्राद्रवन् भयात्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2176848, "chapter_id": 4738, "verse_number": "६", "content_sanskrit": "ते मुहूर्तं ततो गत्वा श्रान्तगात्राः पिपासिताः ।\nनादृश्यन्त महेष्वासाः क्रोधामर्षवशंगताः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2176849, "chapter_id": 4738, "verse_number": "७", "content_sanskrit": "राज्ञो वधेन सन्तप्ता मुहूर्तं समवस्थिताः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2176850, "chapter_id": 4738, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2176851, "chapter_id": 4738, "verse_number": "८", "content_sanskrit": "अश्रद्धेयमिदं कर्म कृतं भीमेन सञ्जय ।\nयत्र नागायुतप्राणः पुत्रो मम निपातितः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2176852, "chapter_id": 4738, "verse_number": "९", "content_sanskrit": "अवध्यः सर्वभूतानां वज्रसंहननो युवा ।\nपाण्डवैः समरे पुत्रो निहतो मम सञ्जय\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2176853, "chapter_id": 4738, "verse_number": "१०", "content_sanskrit": "न दिष्टमप्यतिक्रान्तुं शक्यं गावल्गणे नरैः ।\nयत् समेत्य रणे पार्थैः पुत्रो मम निपातितः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2176854, "chapter_id": 4738, "verse_number": "११", "content_sanskrit": "अद्रिसारमयं नूनं हृदयं मम सञ्जय ।\nहतं पुत्रशतं श्रुत्वा यन्न दीर्णं सहस्रधा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2176855, "chapter_id": 4738, "verse_number": "१२", "content_sanskrit": "कथं नु वृद्धमिथुनं हतपुत्रं भविष्यति ।\nन ह्यहं पाण्डवेयस्य विषये वस्तुमुत्सहे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2176856, "chapter_id": 4738, "verse_number": "१३", "content_sanskrit": "कथं राज्ञः पिता भूत्वा स्वयं राजा च सञ्जय ।\nप्रेष्यभूतः प्रवर्तेयं पाण्डवेयस्य शासनात्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2176857, "chapter_id": 4738, "verse_number": "१४", "content_sanskrit": "प्रभुज्य पृथिवीं सर्वां स्थित्वा मूर्धनि सञ्जय ।\nकथमद्य भविष्यामि प्रेष्यभूतां दुरन्तकृत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2176858, "chapter_id": 4738, "verse_number": "१५", "content_sanskrit": "कथं भीमस्य वाक्यानि श्रोतुं शक्ष्यामि सञ्जय ।\nयेन पुत्रशतं मह्यमेकेन निहतं युधि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2176859, "chapter_id": 4738, "verse_number": "१६", "content_sanskrit": "कृतं सत्यं वचस्तस्य विदुरस्य महात्मनः ।\nअकुर्वता वचस्तस्य मम पुत्रेण सञ्जय\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2176860, "chapter_id": 4738, "verse_number": "१७", "content_sanskrit": "अधर्मेण हते तात पुत्रे दुर्योधने मम ।\nकृतवर्मा कृपो द्रौणिः किमकुर्वत सञ्जय\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2176861, "chapter_id": 4738, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2176862, "chapter_id": 4738, "verse_number": "१८", "content_sanskrit": "गत्वा तु तावका राजन् नातिदूरं मनस्विनः ।\nअपश्यन्त वनं घोरं नानाद्रुमलतायुतम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2176863, "chapter_id": 4738, "verse_number": "१९", "content_sanskrit": "ते मुहूर्तं तु विश्रम्य लब्धतोयैर्हयोत्तमैः ।\nसूर्यास्तमयवेलायां कौरवेयस्य शासनात्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2176864, "chapter_id": 4738, "verse_number": "२०", "content_sanskrit": "नानामृगगणाकीर्णं नानापक्षिसमाकुलम् ।\nनानाद्रुमलताच्छन्नं नानाव्यालनिषेवितम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2176865, "chapter_id": 4738, "verse_number": "२१", "content_sanskrit": "नानातोयसमाकीर्णैस्तटाकैरुपशोभितम् ।\nपद्मिनीशतसञ्छन्नं नीलोत्पलसमाकुलम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2176866, "chapter_id": 4738, "verse_number": "२२", "content_sanskrit": "प्रविश्य तद्वनं घोरं वीक्षमाणाः समन्ततः ।\nशसाखासहस्रसञ्छन्नं न्यग्रोधं ददृशुस्ततः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2176867, "chapter_id": 4738, "verse_number": "२३", "content_sanskrit": "उपेत्य च महाराज न्यग्रोधं ते महारथाः ।\nददृशुर्द्विपदां श्रेष्ठाः श्रेष्ठं तं वै वनस्पतिम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2176868, "chapter_id": 4738, "verse_number": "२४", "content_sanskrit": "तेऽवतीर्य रथोपस्थाद् विप्रमुच्य तु वाजिनः ।\nउपस्पृश्य यथान्यायं सन्ध्यामन्वासत प्रभो\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2176869, "chapter_id": 4738, "verse_number": "२५", "content_sanskrit": "ततोऽस्तं पर्वतश्रेष्ठमनुप्राप्ते दिवाकरे ।\nसर्वस्य जगतो धात्री शर्वरी प्रत्यपद्यत\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2176870, "chapter_id": 4738, "verse_number": "२६", "content_sanskrit": "ग्रहनक्षत्रताराभिः प्रकीर्णाभिरलङ्कृतम् ।\nनभोंशुकमिवाभाति प्रेक्षणीयं समन्ततः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2176871, "chapter_id": 4738, "verse_number": "२७", "content_sanskrit": "इच्छया ते प्रवल्गन्ति सत्वा ये रात्रिचारिणः ।\nदिवाचराश्च ये सत्त्वास्ते निद्रावशमागताः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2176872, "chapter_id": 4738, "verse_number": "२८", "content_sanskrit": "रात्रिञ्चराणां सत्त्वानां निनादोऽभूत् सुदारुणः ।\nक्रव्यादाश्च प्रमुदिता प्राप्ता घोरा च शर्वरी\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2176873, "chapter_id": 4738, "verse_number": "२९", "content_sanskrit": "तस्मिन् रात्रिमुखे घोरे दुःखशोकसमन्विताः ।\nकृतवर्मा कृपो द्रौणिरुपोपविविशुः समम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2176874, "chapter_id": 4738, "verse_number": "३०", "content_sanskrit": "उपोपविष्टाः शोचन्तो न्यग्रोधस्य समीपतः ।\nतमेवार्थमतिक्रान्तं कुरुपाण्डवयोः क्षयम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2176875, "chapter_id": 4738, "verse_number": "३१", "content_sanskrit": "निद्रया च परीताङ्गा निषेदुर्धरणीतळे\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2176876, "chapter_id": 4738, "verse_number": "३२", "content_sanskrit": "श्रमेण सुदृढं युक्ता विक्षता विविधैः शरैः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2176877, "chapter_id": 4738, "verse_number": "३३", "content_sanskrit": "ततो निद्रावशं प्राप्तौ कृपभोजौ महाबलौ ।\nसुखोचितावदुःखार्हौ निषण्णौ धरणीतळे\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2176878, "chapter_id": 4738, "verse_number": "३४", "content_sanskrit": "तौ तु सुप्तौ महाराज तस्मिन् देशे महारथौ ।\nमहार्हशयनोपेतौ भूमावेव ह्यनाथवत्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2176879, "chapter_id": 4738, "verse_number": "३५", "content_sanskrit": "क्रोधामर्षवशं प्राप्तो द्रोणपुत्रस्तु भारत ।\nनैव स्म स जगामाथ निद्रां सर्प इव श्वसन्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2176880, "chapter_id": 4738, "verse_number": "३६", "content_sanskrit": "नालभत् स तु निद्रां वै दह्यमानोऽतिमन्युना ।\nवीक्षाञ्चक्रे महाबाहुस्तद्वनं घोरदर्शनम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2176881, "chapter_id": 4738, "verse_number": "३७", "content_sanskrit": "वीक्षमाणो वनोद्देशं नानासत्वैर्निषेवितम् ।\nअपश्यत महाबाहुर्न्यग्रोधं वायसान्वितम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2176882, "chapter_id": 4738, "verse_number": "३८", "content_sanskrit": "तत्र काकसहस्राणि तां निशां पर्यणामयन् ।\nसुखं स्वपन्तः कौरव्य पृथक्पृथगपाश्रयाः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2176883, "chapter_id": 4738, "verse_number": "३९", "content_sanskrit": "सुप्तेषु तेषु काकेषु विस्रब्धेषु समन्ततः ।\nअपश्यत् सहसा यान्तमुलूकं घोरदर्शनम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2176884, "chapter_id": 4738, "verse_number": "४०", "content_sanskrit": "महास्वनं महाकायं हर्यक्षं बभ्रुपिङ्गलम् ।\nसदीर्घघोणनखरं सुपर्णमिव वेगिनम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2176885, "chapter_id": 4738, "verse_number": "४१", "content_sanskrit": "सोऽथ शब्दं मृदुं कृत्वा लीयमान इवाण्डजः ।\nन्यग्रोधस्य ततः शाखां पातयामास भारत\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2176886, "chapter_id": 4738, "verse_number": "४२", "content_sanskrit": "सन्निपत्य तु शाखायां न्यग्रोधस्य विहङ्गमः ।\nसुप्तान् जघान सुबहून् वायसान् वायसान्तकः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2176887, "chapter_id": 4738, "verse_number": "४३", "content_sanskrit": "केषाञ्चिदच्छिनत् पक्षान् शिरांसि निचकर्त ह ।\nचरणांश्चैव केषाञ्चिद् बभञ्ज चरणायुधः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2176888, "chapter_id": 4738, "verse_number": "४४", "content_sanskrit": "क्षणेनाघ्नत् स बलवान् येऽस्य दृष्टिपथे स्थिताः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2176889, "chapter_id": 4738, "verse_number": "४५", "content_sanskrit": "तेषां शरीरावयवैः शरीरैश्च विशाम्पते ।\nन्यग्रोधमण्डलं सर्वं सञ्छन्नं सर्वतोऽभवत्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2176890, "chapter_id": 4738, "verse_number": "४६", "content_sanskrit": "तांस्तु हत्वा ततः काकान् कौशिको मुदितोऽभवत् ।\nप्रतिकृत्य यथाकामं शत्रूणां शत्रुसूदनः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2176891, "chapter_id": 4738, "verse_number": "४७", "content_sanskrit": "तद् दृष्ट्वा तादृशं कर्म कौशिकेन कृतं निशि ।\nतद्भावकृतसङ्कल्पो द्रौणिरेको व्यचिन्तयत्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2176892, "chapter_id": 4738, "verse_number": "", "content_sanskrit": "द्रौणिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2176893, "chapter_id": 4738, "verse_number": "४८", "content_sanskrit": "उपदेशः कृतोऽनेन पक्षिणा मम संयुगे ।\nशत्रूणां क्षपणे युक्तः प्राप्तकालश्च मे मतः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2176894, "chapter_id": 4738, "verse_number": "४९", "content_sanskrit": "नाद्य शक्या मया हन्तुं पाण्डवा जितकाशिनः ।\nबलवन्तः कृतोत्साहा लब्धलक्षाः प्रहारिणः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2176895, "chapter_id": 4738, "verse_number": "५०", "content_sanskrit": "राज्ञः सकाशे तेषां च प्रतिज्ञातो वधो मया\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2176896, "chapter_id": 4738, "verse_number": "५१", "content_sanskrit": "पतङ्गाग्निसमां वृत्तिमास्थायात्मविनाशिनीम् ।\nन्यायतो युध्यमानस्य प्राणत्यागो न संशयः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2176897, "chapter_id": 4738, "verse_number": "५२", "content_sanskrit": "छद्मना तु भवेत् सिद्धिः शत्रूणां च क्षयो महान्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2176898, "chapter_id": 4738, "verse_number": "५३", "content_sanskrit": "तत्र संशयितादर्थाद् यस्तु निःसंशयो भवेत् ।\nतं जना बहुमन्यन्ते येऽर्थशास्त्रविशारदाः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2176899, "chapter_id": 4738, "verse_number": "५४", "content_sanskrit": "यच्चाप्यति भवेत् वाच्यं गर्हितं लोकनिन्दितम् ।\nकर्तव्यं तन्मनुष्येण क्षत्रधर्मेण वर्तता\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2176900, "chapter_id": 4738, "verse_number": "५५", "content_sanskrit": "निन्दितानि च कर्माणि कुत्सितानि पदे पदे ।\nसोपधानि कृतान्येव पाण्डवैरकृतात्मभिः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2176901, "chapter_id": 4738, "verse_number": "५६", "content_sanskrit": "अस्मिन्नर्थे पुरा गीताः श्रूयन्ते धर्मवित्तमैः ।\nश्लोका न्यायमवेक्षद्भिः तत्त्वार्थास्तत्त्वदर्शिभिः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2176902, "chapter_id": 4738, "verse_number": "५७", "content_sanskrit": "परिश्रान्ते विकीर्णे च भुञ्जाने वाऽपि शत्रुभिः ।\nप्रस्थाने च प्रवेशे च प्रहर्तव्यं रिपोर्बलम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2176903, "chapter_id": 4738, "verse_number": "५८", "content_sanskrit": "निद्रार्थमर्धरात्रे च तथा नष्टप्रणायकम् ।\nभिन्नयोधबलं यच्च द्वैधीभूतं तु यद्भवेत्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2176904, "chapter_id": 4738, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2176905, "chapter_id": 4738, "verse_number": "५९", "content_sanskrit": "इत्येवं निश्चयं कृत्वा सुप्तानां निशि मारणे ।\nपाण्डूनां सह पाञ्चालैर्द्रोणपुत्रः प्रतापवान्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2176906, "chapter_id": 4738, "verse_number": "६०", "content_sanskrit": "स क्रूरां मतिमास्थाय विनिश्चित्य पुनः पुनः ।\nसुप्तौ प्राबोधयत्तौ तु मातुलं भोजमेव च\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2176907, "chapter_id": 4738, "verse_number": "६१", "content_sanskrit": "तौ प्रबुद्धौ महात्मानौ कृपभोजौ महाबलौ ।\nनोत्तरं प्रतिपद्येतां तत्र युक्तं ह्रिया वृतौ\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2176908, "chapter_id": 4738, "verse_number": "६२", "content_sanskrit": "मुहूर्तमिव स ध्यात्वा तावुभौ वाक्यमब्रवीत्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2176909, "chapter_id": 4738, "verse_number": "", "content_sanskrit": "अश्वत्थामा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2176910, "chapter_id": 4738, "verse_number": "६३", "content_sanskrit": "हतो दुर्योधनो राजा एकवीरो महाबलः ।\nयस्यार्थे वैरमासक्तमस्माभिः पाण्डवैः सह\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2176911, "chapter_id": 4738, "verse_number": "६४", "content_sanskrit": "एकाकी बहुभिः क्षुद्रैराहवे शुद्धविक्रमः ।\nपातितो भीमसेनेन एकादशचमूपतिः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2176912, "chapter_id": 4738, "verse_number": "६५", "content_sanskrit": "वृकोदरेण क्षुद्रेण सुनृशंसमिदं कृतम् ।\nमूर्धाभिषिक्तस्य शिरः पादेन परिमर्दितम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2176913, "chapter_id": 4738, "verse_number": "६६", "content_sanskrit": "नर्दन्ति स्म च पाञ्चालाः क्ष्वेलन्ति च हसन्ति च ।\nदध्मुः शङ्खांश्च शतशो हृष्टा घ्नन्ति च दुन्दुभीन्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2176914, "chapter_id": 4738, "verse_number": "६७", "content_sanskrit": "वादित्रघोषस्तुमुलो विमिश्रः शङ्खनिःस्वनैः ।\nअनिलेनेरितो घोरो दिशः पूरयतीव हि\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2176915, "chapter_id": 4738, "verse_number": "६८", "content_sanskrit": "अश्वानां हेषमाणानां गजानां चैव बृंहताम् ।\nसिंहनादश्च शूराणां श्रूयते सुमहानयम्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2176916, "chapter_id": 4738, "verse_number": "६९", "content_sanskrit": "दिशं प्रतीचीमाश्रित्य हृष्टानां गर्जितं बहु\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2176917, "chapter_id": 4738, "verse_number": "७०", "content_sanskrit": "रथनेमिस्वनाश्चैव श्रूयन्ते रोमहर्षणाः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2176918, "chapter_id": 4738, "verse_number": "७१", "content_sanskrit": "पाण्डवैर्धार्तराष्ट्राणां यदिदं दुष्कृतं कृतम् ।\nवयमेव त्रयः शिष्टा यस्मिन् महति वैशसे\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2176919, "chapter_id": 4738, "verse_number": "७२", "content_sanskrit": "केचिन्नागशतप्राणाः केचित् सर्वास्त्रकोविदाः ।\nनिहताः पाण्डवैरस्मान् मन्ये कालस्य पर्ययम्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2176920, "chapter_id": 4738, "verse_number": "७३", "content_sanskrit": "एवमेतेन भाव्यं हि नूनं कार्येण तत्त्वतः ।\nयथा यस्येदृशी निष्ठा कृते यत्नेऽपि दुष्करे\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2176921, "chapter_id": 4738, "verse_number": "७४", "content_sanskrit": "भवतोस्तु यदि प्रज्ञा न मोहादपचीयते ।\nव्यसनेऽस्मिन् महत्यर्थे श्रेयो यन्नस्तदुच्यताम्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2176922, "chapter_id": 4738, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसौप्तिकपर्वणि अश्वत्थाम्नः कौशिकदर्शनचिन्ता नाम प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2176923, "chapter_id": 4738, "verse_number": "", "content_sanskrit": "सौप्तिकपर्वणि प्रथमोऽध्यायः ॥१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]