[{"id": 2014027, "chapter_id": 1289, "verse_number": "२-३०-१", "content_sanskrit": "वैशम्पायन उवाच।\nएतस्मिन्नेव काले तु भीमसेनोऽपि वीर्यवान्।\nधर्मराजमनुज्ञाप्य ययौ प्राचीं दिशं प्रति॥ ५", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2014028, "chapter_id": 1289, "verse_number": "२-३०-२", "content_sanskrit": "महता बलचक्रेण परराष्ट्रावमर्दिना।\nहस्त्यश्वरथपूर्णेन दंशितेन प्रतापवान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2014029, "chapter_id": 1289, "verse_number": "२-३०-३", "content_sanskrit": "वृतो भरतशार्दूलो द्विषच्छोकविवर्धनः।\nस गत्वा नरशार्दूलः पञ्चालानां पुरं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2014030, "chapter_id": 1289, "verse_number": "२-३०-४", "content_sanskrit": "पञ्चालान्विविधोपायैः सान्त्वयामास पाण्डवः।\nकिञ्चित्करं समादाय विदेहानां पुरं ययौ॥\nततः स गण्डकाञ्शूरो विदेहान्भरतर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2014031, "chapter_id": 1289, "verse_number": "२-३०-५", "content_sanskrit": "विजित्याल्पेन कालेन दशार्णानजयत्प्रभुः।\nतत्र दाशार्णको राजा सुधर्मा रोमहर्षणम्।\nकृतवान्भीमसेनेम महद्युद्धं निरायुधम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2014032, "chapter_id": 1289, "verse_number": "२-३०-६", "content_sanskrit": "भीमसेनस्तु तद्दृष्ट्वा तस्य कर्म महात्मनः।\nअधिसेनापतिं चक्रे सुधर्माणं महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2014033, "chapter_id": 1289, "verse_number": "२-३०-७", "content_sanskrit": "ततः प्राचीं दिशं भीमो ययौ भीमपराक्रमः।\nसैन्येन महता राजन्कम्पयन्निव मेदिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2014034, "chapter_id": 1289, "verse_number": "२-३०-८", "content_sanskrit": "सोऽश्वमेधेश्वरं राजन्रोचमानं सहानुगम्।\nजिगाय समरे वीरो बलेन बलिनां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2014035, "chapter_id": 1289, "verse_number": "२-३०-९", "content_sanskrit": "स तं निर्जित्य कौन्तेयो नातितीव्रेण कर्मणा।\nपूर्वदेशं महावीर्यं विजिग्ये कुरनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2014036, "chapter_id": 1289, "verse_number": "२-३०-१०", "content_sanskrit": "ततो दक्षिणमागम्य पुलिन्दनगरं महत्।\nसुकुमारं वशे चक्रे सुमित्रं च नराधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2014037, "chapter_id": 1289, "verse_number": "२-३०-११", "content_sanskrit": "ततस्तु धर्मराजस्य शासनाद्भरतर्षभः।\nशिशुपालं महावीर्यमभ्यगाज्जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2014038, "chapter_id": 1289, "verse_number": "२-३०-१२", "content_sanskrit": "चेदिराजोऽपि तच्छ्रुत्वा पाण्डवस्य चिकीर्षितम्।\nउपनिष्कम्य नगरात्प्रत्यगृह्णात्परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2014039, "chapter_id": 1289, "verse_number": "२-३०-१३", "content_sanskrit": "तौ समेत्य महाराज कुरुचेदिवृषौ तदा।\nउभयोरात्मकुलयोः कौशलं पर्यपृच्छताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2014040, "chapter_id": 1289, "verse_number": "२-३०-१४", "content_sanskrit": "ततो निवेद्य तद्राष्ट्रं चेदिराजो विशाम्पते।\nउवाच भीमं प्रहसन्किमिदं कुरुषेऽनघ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2014041, "chapter_id": 1289, "verse_number": "२-३०-१५", "content_sanskrit": "तस्य भीमस्तदाचख्यौ धर्मराजचिकीर्षितम्।\nस च तं प्रतिगृह्यैव तथा चक्रे नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2014042, "chapter_id": 1289, "verse_number": "२-३०-१६", "content_sanskrit": "ततो भीमस्तत्र राजन्निषित्वा त्रिदशाः क्षपाः।\nसत्कृतः शिशुपालेन ययौ सबलवाहनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2014043, "chapter_id": 1289, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि दिग्विजयपर्वणि त्रिंशोऽध्यायः॥ ३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]