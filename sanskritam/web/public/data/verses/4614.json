[{"id": 2168569, "chapter_id": 4614, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2168570, "chapter_id": 4614, "verse_number": "१", "content_sanskrit": "पितृदेवर्षिसङ्घेभ्यो वरे दत्ते महात्मना ।\nसत्कृत्य शङ्करं प्राह ब्रह्मा लोकपितामहः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2168571, "chapter_id": 4614, "verse_number": "२", "content_sanskrit": "इमान्यसुरदुर्गाणि लोकांस्त्रीनाक्रमन्ति नः ।\nकश्च प्रजापतिर्घोरांस्तान् सर्वान् जहि माचिरम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2168572, "chapter_id": 4614, "verse_number": "३", "content_sanskrit": "वरातिसर्गाद् देवेश प्राजापत्यमिदं पदम् ।\nमयाऽधितिष्ठता दत्तो दानवेभ्यो महान् वरः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2168573, "chapter_id": 4614, "verse_number": "४", "content_sanskrit": "तानतिक्रान्तमर्यादान्नान्यः संहर्तुमर्हति\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2168574, "chapter_id": 4614, "verse_number": "५", "content_sanskrit": "त्वामृते सर्वभूतेश त्वं ह्येषां प्रत्यरिर्वधे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2168575, "chapter_id": 4614, "verse_number": "६", "content_sanskrit": "स त्वं देव प्रपन्नानां याचतां च दिवौकसाम् ।\nकुरु प्रसादं वरद दानवान् जहि संयुगे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2168576, "chapter_id": 4614, "verse_number": "७", "content_sanskrit": "त्वत्प्रसादाज्जगत्सर्वं सुखमैधत मानद ।\nशरण्यस्त्वं हि देवानां वयं त्वां शरणं गताः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2168577, "chapter_id": 4614, "verse_number": "", "content_sanskrit": "ईश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2168578, "chapter_id": 4614, "verse_number": "८", "content_sanskrit": "हन्तव्याः शत्रवः सर्वे युष्माकमिति मे मतिः ।\nन त्वेकश्चोत्सहे हन्तुं बलिनः सुरविद्विषः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2168579, "chapter_id": 4614, "verse_number": "९", "content_sanskrit": "ते यूयं सहिताः सर्वे मदीयेनापि तेजसा ।\nजयध्वं युधि तान् सर्वान् सङ्घातेन महाबलान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2168580, "chapter_id": 4614, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2168581, "chapter_id": 4614, "verse_number": "१०", "content_sanskrit": "अस्मत्तेजोबलं यावत् तावद् द्विगुणमेव वा ।\nतत्तेषामिति मन्यामो दृष्टतेजोबला हि ते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2168582, "chapter_id": 4614, "verse_number": "", "content_sanskrit": "ईश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2168583, "chapter_id": 4614, "verse_number": "११", "content_sanskrit": "वध्यास्ते सर्वथा पापा ये युष्मास्वपराधिनः ।\nमम तेजोबलार्धेन सर्वान् मृद्नथ शात्रवान्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2168584, "chapter_id": 4614, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2168585, "chapter_id": 4614, "verse_number": "१२", "content_sanskrit": "बिभर्तुं तव तेजोर्धं न शक्ष्याम सुरेश्वर ।\nसर्वेषां नो बलार्धेन त्वमेव जहि शात्रवान्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2168586, "chapter_id": 4614, "verse_number": "१३", "content_sanskrit": "वयं च सर्वथा देव रक्षणीयास्तथैव च ।\nस नो रक्ष महादेव त्वमेव जहि शात्रवान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2168587, "chapter_id": 4614, "verse_number": "", "content_sanskrit": "ईश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2168588, "chapter_id": 4614, "verse_number": "१४", "content_sanskrit": "मम तेजो न शक्ता हि सर्वे धारयितुं यदि ।\nअहमेनान्वधिष्यामि युष्मत्तेजोर्धसंयुतः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2168589, "chapter_id": 4614, "verse_number": "१५", "content_sanskrit": "बलार्धं यदि मे देवा न धारयितुमाहवे ।\nशक्ताः सर्वे हि संहत्य यूयं तत्प्रब्रवीमि वः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2168590, "chapter_id": 4614, "verse_number": "१६", "content_sanskrit": "समा भवन्ति मे सर्वे दानवाश्चामराश्च ये ।\nशिवोऽस्मि सर्वभूतानां शिवत्वं तेन मे सुराः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2168591, "chapter_id": 4614, "verse_number": "१७", "content_sanskrit": "किन्त्वधर्मेण वर्तन्ते यस्मात् ते सुरशत्रवः ।\nतस्माद् वध्या मयाप्येते युष्माकं च हितेप्सया\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2168592, "chapter_id": 4614, "verse_number": "१८", "content_sanskrit": "शरणं वः प्रपन्नानां धर्मेण च जिगीषताम् ।\nसाहाय्यं वः करिष्यामि निहनिष्यामि वो रिपून्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2168593, "chapter_id": 4614, "verse_number": "१९", "content_sanskrit": "दीयतां च बलार्धं मे सर्वैरपि पृथक्पृथक् ।\nपशुत्वं चैव मे लोकाः सर्वे कल्पन्तु पीडिताः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2168594, "chapter_id": 4614, "verse_number": "२०", "content_sanskrit": "पशूनां तु पतित्वं मे भवत्वद्य दिवौकसः ।\nएवं न पापं प्राप्स्यामि पशून् हत्वा सुरद्विषः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2168595, "chapter_id": 4614, "verse_number": "२१", "content_sanskrit": "कल्पयध्वं रथं दिव्यं रथाश्वांश्चैव पारगान् ।\nधनुः शरं सारथिं च ततो जेष्यामि वो रिपून्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2168596, "chapter_id": 4614, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रुत्वा वचो देवा देवदेवस्य भूपते ।\nविषादमगमन्सर्वे पशुत्वं प्रति शङ्किताः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2168597, "chapter_id": 4614, "verse_number": "२३", "content_sanskrit": "तेषां भावं भवो ज्ञात्वा देवस्तानब्रवीदिदम् ।\nमा वोस्तु पशुभावेऽस्मिन् भयं विबुधसत्तमाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2168598, "chapter_id": 4614, "verse_number": "२४", "content_sanskrit": "श्रूयतां पशुभावस्य विमोक्षः क्रियतां च सः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2168599, "chapter_id": 4614, "verse_number": "२५", "content_sanskrit": "यो वः पशुपतेश्चर्यां चरिष्यति स मोक्ष्यते ।\nपशुत्वादिति सत्यं वः प्रतिजाने समागमे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2168600, "chapter_id": 4614, "verse_number": "२६", "content_sanskrit": "ये चाप्यन्ये चरिष्यन्ति व्रतं मोक्ष्यन्ति तेऽपि च\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2168601, "chapter_id": 4614, "verse_number": "२७", "content_sanskrit": "नै(त्य)ष्ठिकं द्वादशाब्दं वा अर्धमब्दमृतुत्रयम् ।\nमासं द्वादशरात्रं वा स पशुत्वाद्विमोक्ष्यते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2168602, "chapter_id": 4614, "verse_number": "२८", "content_sanskrit": "तस्मात् परमिदं गुह्यं व्रतं दिव्यं चरिष्यथ\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2168603, "chapter_id": 4614, "verse_number": "२९", "content_sanskrit": "तं तथेत्यब्रुवन् देवा देवदेवनमस्कृतम् ।\nऊचुश्चेदं गृहाणेदं तेजसोऽर्धमिति प्रभुम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2168604, "chapter_id": 4614, "verse_number": "३०", "content_sanskrit": "प्रत्युवाच तथेत्येव शूलधृग् राजसत्तम ।\nततस्ते प्रददुः सर्वे तेजसोऽर्धं महात्मने\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2168605, "chapter_id": 4614, "verse_number": "३१", "content_sanskrit": "सर्वमादाय सर्वेषां तेजसोऽर्धं दिवौकसाम् ।\nतेजसाप्यधिको भूत्वा भूयोऽप्यतिबलोऽभवत्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2168606, "chapter_id": 4614, "verse_number": "३२", "content_sanskrit": "ततःप्रभृति देवानां देवदेवोऽभवत् पतिः ।\nपतिश्च सर्वभूतानां पशूनां चाभवत् तदा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2168607, "chapter_id": 4614, "verse_number": "३३", "content_sanskrit": "तस्मात् पशुपतिश्चोक्तो भवत्वाच्च भवेति वै\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2168608, "chapter_id": 4614, "verse_number": "३४", "content_sanskrit": "अर्धमादाय सर्वेषां तेजसा प्रज्वलन्निव ।\nभासयामास तान् सर्वान् देवदेवो महाद्युतिः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2168609, "chapter_id": 4614, "verse_number": "३५", "content_sanskrit": "ततोऽभिषिषिचुः सर्वे सुरा रुद्रं पुरारिणम् ।\nमहादेव इति ह्यासीद् देवदेवो महेश्वरः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2168610, "chapter_id": 4614, "verse_number": "३४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि चतुस्त्रिंशोऽध्यायः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2168611, "chapter_id": 4614, "verse_number": "", "content_sanskrit": "––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]