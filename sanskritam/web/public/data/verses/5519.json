[{"id": 2212098, "chapter_id": 5519, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212099, "chapter_id": 5519, "verse_number": "१", "content_sanskrit": "केशवेनैवमुक्ते तु चान्द्रायणविधिक्रमे ।\nअपृच्छत् पुनरन्यांश्च धर्मान् धर्मात्मजो नृप ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212100, "chapter_id": 5519, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212101, "chapter_id": 5519, "verse_number": "२", "content_sanskrit": "सर्वभूतपते श्रीमन् सर्वभूतनमस्कृत ।\nसर्वभूतहितं धर्मं सर्वज्ञ कथयस्व मे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212102, "chapter_id": 5519, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212103, "chapter_id": 5519, "verse_number": "३", "content_sanskrit": "यद् दरिद्रजनस्यापि स्वर्ग्यं सुखकरं भवेत् ।\nसर्वपापप्रशमनं तच्छृणुष्व युधिष्ठिर ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2212104, "chapter_id": 5519, "verse_number": "४", "content_sanskrit": "कार्तिकाद्यास्तु ये मासा द्वादशैव प्रकीर्तिताः ।\nतेष्वेकभक्तनियमः सर्वेषामुच्यते मया ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2212105, "chapter_id": 5519, "verse_number": "५", "content_sanskrit": "कार्तिके यस्तु वै मासे नन्दायां संयतेन्द्रियः ।\nएकभुक्तेन मद्भक्तो मासमेकं तु वर्तते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2212106, "chapter_id": 5519, "verse_number": "६", "content_sanskrit": "जलं वा न पिबेन्मासे नान्तरा भोजनात् परम् ।\nआदित्यरूपं मां नित्यमर्चयन् सुसमाहितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2212107, "chapter_id": 5519, "verse_number": "७", "content_sanskrit": "व्रतान्ते भोजयेद् विप्रान् दक्षिणां च ददौ पुनः ।\nक्रोधलोभविनिर्मुक्तस्तस्य पुण्यफलं शृणु ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2212108, "chapter_id": 5519, "verse_number": "८", "content_sanskrit": "विधिवत् कपिलादाने यत्पुण्यं समुदाहृतम् ।\nतत्पुण्यं समनुप्राप्य सूर्यलोके महीयते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2212109, "chapter_id": 5519, "verse_number": "९", "content_sanskrit": "ततश्चापि च्युतः कालात् पुरुषेषूपजायते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2212110, "chapter_id": 5519, "verse_number": "१०", "content_sanskrit": "मार्गशीर्षं तु यो मासमेकभुक्तेन वर्तते ।\nकामं क्रोधं च लोभं च परित्यज्य यथाविधि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2212111, "chapter_id": 5519, "verse_number": "११", "content_sanskrit": "स्नात्वा चादित्यरूपं मामर्चयेन्नियतेन्द्रियः ।\nजपन्नेव तु गायत्रीं मामिकां वाग्यतः शुचिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2212112, "chapter_id": 5519, "verse_number": "१२", "content_sanskrit": "मासे परिसमाप्ते तु भोजयित्वा द्विजान् शुचिः ।\nतानर्चयति मद्भक्त्या तस्य पुण्यफलं शृणु ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2212113, "chapter_id": 5519, "verse_number": "१३", "content_sanskrit": "अग्निहोत्रे कृते पुण्यमाहिताग्नेश्च यद्भवेत् ।\nतत्पुण्यफलमासाद्य यानेनाम्बरशोभिना ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2212114, "chapter_id": 5519, "verse_number": "१४", "content_sanskrit": "सप्तर्षिलोके चरति यथाकालं यथासुखम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2212115, "chapter_id": 5519, "verse_number": "१५", "content_sanskrit": "ततश्चापि च्युतः कालाद् हरिवर्षेषु जायते ।\nतत्र प्रकाशं क्रीडित्वा राजा पश्चाद् भविष्यति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2212116, "chapter_id": 5519, "verse_number": "१६", "content_sanskrit": "पौषमासं क्षिपेदेवमेकभुक्तेन यो नरः ।\nअर्चयन्नेव मां नित्यं मद्गतेनान्तरात्मना ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2212117, "chapter_id": 5519, "verse_number": "१७", "content_sanskrit": "अहिंसा सत्यनिरतः क्रोधहर्षविवर्जितः ।\nएवं युक्तस्य राजेन्द्र शृणु यत्फलमुत्तमम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2212118, "chapter_id": 5519, "verse_number": "१८", "content_sanskrit": "विप्रातिथ्यसहस्रेषु यत्पुण्यं समुदाहृतम् ।\nतत्पुण्यं समनुप्राप्य शक्रलोके महीयते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2212119, "chapter_id": 5519, "verse_number": "१९", "content_sanskrit": "अवतीर्णस्ततः कालाद् इलावर्षे तु जायते ।\nतत्र स्थित्वा चिरं कालमस्मिन् विप्रो भविष्यति ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2212120, "chapter_id": 5519, "verse_number": "२०", "content_sanskrit": "माघमासं तथा यस्तु वर्तते चैकभक्ततः ।\nमदर्चनपरो भूत्वा डम्भक्रोधविवर्जितः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2212121, "chapter_id": 5519, "verse_number": "२१", "content_sanskrit": "मामिकामपि सावित्रीं सन्ध्यायां तु जपेद् बुधः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2212122, "chapter_id": 5519, "verse_number": "२२", "content_sanskrit": "दत्त्वा तु दक्षिणामन्ते भोजयित्वा द्विजानपि ।\nनमस्करोति तान् भक्त्या मद्गतेनान्तरात्मना ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2212123, "chapter_id": 5519, "verse_number": "२३", "content_sanskrit": "त्रिकालं स्नानयुक्तस्य तस्य पुण्यफलं शृणु ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2212124, "chapter_id": 5519, "verse_number": "२४", "content_sanskrit": "नीलकण्ठप्रयुक्तेन यानेनाम्बरशोभिना ।\nपितृलोकं व्रजेच्छ्रीमान् सेव्यमानोऽप्सरोगणैः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2212125, "chapter_id": 5519, "verse_number": "२५", "content_sanskrit": "तत्र प्रकामं क्रीडित्वा भद्राश्वेषूपजायते ।\nततश्च्युतश्चतुर्वेदी विप्रो भवति भूतळे ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2212126, "chapter_id": 5519, "verse_number": "२६", "content_sanskrit": "यः क्षिपेत् फाल्गुनं मासमेकभक्तो जितेन्द्रियः ।\nनमो ब्रह्मण्यदेवायेत्येतन्मन्त्रं जपेत् सदा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2212127, "chapter_id": 5519, "verse_number": "२७", "content_sanskrit": "पायसं भोजयेद् विप्रान् व्रतान्ते संयतेन्द्रियः ।\nमदर्चनपरोऽक्रोधस्तस्य पुण्यफलं शृणु ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2212128, "chapter_id": 5519, "verse_number": "२८", "content_sanskrit": "विमानं सारसैर्युक्तमारूढः कामगामि च ।\nनक्षत्रलोके रमते नक्षत्रसदृशाकृतिः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2212129, "chapter_id": 5519, "verse_number": "२९", "content_sanskrit": "ततश्चापि च्युतः कालात् केतुमालेषु जायते ।\nतत्र प्रकामं क्रीडित्वा मानुषेषु मुनिर्भवेत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2212130, "chapter_id": 5519, "verse_number": "३०", "content_sanskrit": "चैत्रमासं तु यो राजन्नेकभक्तेन वर्तते ।\nब्रह्मचारी तु मद्भक्तस्तस्य पुण्यफलं शृणु ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2212131, "chapter_id": 5519, "verse_number": "३१", "content_sanskrit": "यदग्निहोत्रिणः पुण्यं यथोक्तव्रतचारिणः ।\nतत्पुण्यफलमासाद्य चन्द्रलोके महीयते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2212132, "chapter_id": 5519, "verse_number": "३२", "content_sanskrit": "ततोऽवतीर्णो जायेत वर्षे रमणके पुनः ।\nभुक्त्वा कामांस्ततस्तस्मिन्निह राजा भविष्यति ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2212133, "chapter_id": 5519, "verse_number": "३३", "content_sanskrit": "वैशाखे यस्तु वै मासे एकभक्तेन वर्तते ।\nद्विजमग्रासने कृत्वा भुञ्जन् भूमौ च वाग्यतः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2212134, "chapter_id": 5519, "verse_number": "३४", "content_sanskrit": "नमो ब्रह्मण्यदेवायेत्यर्चयित्वा दिवाकरम् ।\nव्रतान्ते भोजयेद् विप्रान् तस्य पुण्यफलं शृणु ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2212135, "chapter_id": 5519, "verse_number": "३५", "content_sanskrit": "फलं यद्विधिवत् प्रोक्तमग्निष्टोमातिरात्रयोः ।\nतत्पुण्यफलमासाद्य देवलोके महीयते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2212136, "chapter_id": 5519, "verse_number": "३६", "content_sanskrit": "ततो हैमवते वर्षे जायते कालपर्ययात् ।\nतत्र प्रकामं कीडित्वा विप्रः पश्चाद् भविष्यति ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2212137, "chapter_id": 5519, "verse_number": "३७", "content_sanskrit": "ज्येष्ठमासं तु यो राजन्नेकभक्तेन वर्तते ।\nविप्रमग्रासने कृत्वा भूमौ भुञ्जन् यथाविधि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2212138, "chapter_id": 5519, "verse_number": "३८", "content_sanskrit": "नमो ब्रह्मण्यदेवायेत्यर्चयन् मां यथाविधि ।\nडम्भानृतविनिर्मुक्तस्तस्य पुण्यफलं शृणु ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2212139, "chapter_id": 5519, "verse_number": "३९", "content_sanskrit": "चीर्णे चान्द्रायणे सम्यग् यत्पुण्यं समुदाहृतम् ।\nतत्पुण्यफलमासाद्य देवलोके महीयते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2212140, "chapter_id": 5519, "verse_number": "४०", "content_sanskrit": "अथोत्तरकुरुष्वेव जायते निर्गतस्ततः ।\nततश्चापि च्युतः कालादिह लोके द्विजो भवेत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2212141, "chapter_id": 5519, "verse_number": "४१", "content_sanskrit": "आषाढमासं यो राजन्नेकभक्तेन वर्तते ।\nब्रह्मचारी जितक्रोधो मदर्चनपरायणः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2212142, "chapter_id": 5519, "verse_number": "४२", "content_sanskrit": "विप्रमग्रासने कृत्वा भूमौ भुञ्जन् जितेन्द्रियः ।\nकृत्वा त्रिषवणस्नानमष्टाक्षरविधानतः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2212143, "chapter_id": 5519, "verse_number": "४३", "content_sanskrit": "व्रतान्ते भोजयेद् विप्रान् पायसेन युधिष्ठिर ।\nगुडोदनेन राजेन्द्र तस्य पुण्यफलं शृणु ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2212144, "chapter_id": 5519, "verse_number": "४४", "content_sanskrit": "कपिलाशतदानस्य यत्पुण्यं पाण्डुनन्दन ।\nतत्पुण्यफलमासाद्य देवलोके महीयते ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2212145, "chapter_id": 5519, "verse_number": "४५", "content_sanskrit": "ततोऽवतीर्णः कालेन शाकद्वीपे प्रजायते ।\nततश्चापि च्युतः कालादिह विप्रो भविष्यति ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2212146, "chapter_id": 5519, "verse_number": "४६", "content_sanskrit": "श्रावणं यः क्षिपेन्मासमेकभक्तेन संयतः ।\nनमो ब्रह्मण्यदेवायेत्युक्त्वा मामर्चयेत् सदा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2212147, "chapter_id": 5519, "verse_number": "४७", "content_sanskrit": "विप्रमग्रासने कृत्वा भूमौ भुञ्जन् यथाविधि ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2212148, "chapter_id": 5519, "verse_number": "४८", "content_sanskrit": "पायसेनार्चयन् विप्रान् जितक्रोधो जितेन्द्रियः ।\nलोभमोहविनिर्मुक्तस्तस्य पुण्यफलं शृणु ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2212149, "chapter_id": 5519, "verse_number": "४९", "content_sanskrit": "कपिलादस्य यत्पुण्यं विधिवत् तस्य पाण्डव ।\nतत्पुण्यं समनुप्राप्य शक्रलोके महीयते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2212150, "chapter_id": 5519, "verse_number": "५०", "content_sanskrit": "ततश्चापि च्युतः कालात् कुशद्वीपे प्रजायते ।\nतत्र प्रकामं क्रीडित्वा विप्रो भवति मानुषे ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2212151, "chapter_id": 5519, "verse_number": "५१", "content_sanskrit": "यस्तु भाद्रपदं मासमेकभक्तेन वर्तते ।\nब्रह्मचारी जितक्रोधः सत्यसन्धो जितेन्द्रियः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2212152, "chapter_id": 5519, "verse_number": "५२", "content_sanskrit": "विप्रमग्रासने कृत्वा पाकभेदविवर्जितः ।\nनमो ब्रह्मण्यदेवायेत्युक्त्वाऽस्य चरणौ स्पृशेत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2212153, "chapter_id": 5519, "verse_number": "५३", "content_sanskrit": "तिलान् वाऽपि घृतान् वाऽपि व्रतान्ते दक्षिणां ददत् ।\nमद्भक्तस्य नरश्रेष्ठ तस्य पुण्यफलं शृणु ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2212154, "chapter_id": 5519, "verse_number": "५४", "content_sanskrit": "यत्फलं विधिवत्प्रोक्तं राजसूयाश्वमेधयोः ।\nतत्पुण्यफलमासाद्य शक्रलोके महीयते ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2212155, "chapter_id": 5519, "verse_number": "५५", "content_sanskrit": "ततश्चापि च्युतः कालात् जायते धनदालये ।\nतत्र प्रकामं क्रीडित्वा राजा भवति मानुषे ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2212156, "chapter_id": 5519, "verse_number": "५६", "content_sanskrit": "यश्चाप्याश्वयुजे मासमेकभक्तेन वर्तते ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2212157, "chapter_id": 5519, "verse_number": "५७", "content_sanskrit": "मद्गायत्रीं जपेद्भक्त्या मद्गतेनान्तरात्मना ।\nद्विसन्ध्यं वा त्रिसन्ध्यं वा शतमष्टोत्तरं तु वा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2212158, "chapter_id": 5519, "verse_number": "५८", "content_sanskrit": "नमो ब्रह्मण्यदेवायेत्यसकृन्मां प्रणम्य च ।\nविप्रमग्रासने कृत्वा संयतेन्द्रियमानसः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2212159, "chapter_id": 5519, "verse_number": "५९", "content_sanskrit": "व्रतान्ते भोजयेद् विप्रान् तस्य पुण्यफलं शृणु ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2212160, "chapter_id": 5519, "verse_number": "६०", "content_sanskrit": "अश्वमेधस्य यत्पुण्यं विधिवत् पाण्डुनन्दन ।\nतत्पुण्यफलमासाद्य मम लोके महीयते ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2212161, "chapter_id": 5519, "verse_number": "६१", "content_sanskrit": "ततश्चापि च्युतः कालात् श्वेतद्वीपे प्रजायते ।\nतत्र भुक्त्वा महाभोगानत्र विप्रवरो भवेत् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2212162, "chapter_id": 5519, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि वैष्णवधर्मशास्त्रे एकभक्तविधिर्नाम त्रयोदशोत्तरशततमोऽध्यायः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]