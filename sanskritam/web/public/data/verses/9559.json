[{"id": 5000559000, "chapter_id": 9559, "verse_number": "७-२४-१", "content_sanskrit": "निवर्तमानः संहृष्टो रावणस्सुदुरात्मवान् ।\nजह्रे पथि नरेन्द्रर्षिदेवगन्धर्वकन्यकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000559001, "chapter_id": 9559, "verse_number": "७-२४-२", "content_sanskrit": "दर्शनीयां हि रक्षः स कन्यां स्त्रीं वापि पश्यति ।\nहत्वा बन्धुजनं तस्या विमाने तां रुरोध ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000559002, "chapter_id": 9559, "verse_number": "७-२४-३", "content_sanskrit": "एवं पन्नगकन्याश्च राक्षसासुरमानुषीः ।\nयक्षदानवकन्याश्च विमाने सो ऽध्यरोपयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000559003, "chapter_id": 9559, "verse_number": "७-२४-४", "content_sanskrit": "ताश्च सर्वाः समं दुःखान्मुमुचुर्बाष्पजं जलम् ।\nतुल्यमग्न्यर्चिषां तत्र शोकाग्निभयसम्भवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000559004, "chapter_id": 9559, "verse_number": "७-२४-५", "content_sanskrit": "ताभिः सर्वानवद्याभिर्नदीभिरिव सागरः ।\nआपूरितं विमानं तद्भयशोकाशिवाश्रुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000559005, "chapter_id": 9559, "verse_number": "७-२४-६", "content_sanskrit": "नागगन्धर्वकन्याश्च महर्षितनयाश्च याः ।\nदैत्यदानवकन्याश्च विमाने शतशो ऽरुदन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000559006, "chapter_id": 9559, "verse_number": "७-२४-७", "content_sanskrit": "दीर्घकेश्यः सुचार्वङ्ग्यः पूर्णचन्द्रनिभाननाः ।\nपीनस्तन्यस्तथा वज्रवेदिमध्यसमप्रभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000559007, "chapter_id": 9559, "verse_number": "७-२४-८", "content_sanskrit": "रथकूबरसङ्काशैः श्रोणिदेशैर्मनोहराः ।\nस्त्रियः सुराङ्गनाप्रख्या निष्टप्तकनकप्रभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000559008, "chapter_id": 9559, "verse_number": "७-२४-९", "content_sanskrit": "शोकदुःखभयत्रस्ता विह्वलाश्च सुमध्यमाः ।\nतासां निश्वासवातेन सर्वतः सम्प्रदीपितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000559009, "chapter_id": 9559, "verse_number": "७-२४-१०", "content_sanskrit": "अग्निहोत्रमिवाभाति सन्निरुद्धाग्निपुष्पकम् ।\nदशग्रीववशं प्राप्तास्तास्तु शोकाकुलाः स्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000559010, "chapter_id": 9559, "verse_number": "७-२४-११", "content_sanskrit": "दीनवक्रेक्षणाः श्यामा मृग्यः सिंहवशा इव ।\nकाचिच्चिन्तयती तत्र किं नु मां भक्षयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000559011, "chapter_id": 9559, "verse_number": "७-२४-१२", "content_sanskrit": "काचिद्दध्यौ सुदुःखार्ता अपि मां मारयेदयम् ।\nइति मातृपितऽन्स्मृत्वा भर्तऽन्भ्रातऽंस्तथैव च ।\nदुःखशोकसमाविष्टा विलेपुः सहिताः स्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000559012, "chapter_id": 9559, "verse_number": "७-२४-१३", "content_sanskrit": "कथं नु खलु मे पुत्रो भविष्यति मया विना ।\nकथं माता कथं भ्राता निमग्नाः शोकसागरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000559013, "chapter_id": 9559, "verse_number": "७-२४-१४", "content_sanskrit": "।\nहा कथं नु करिष्यामि भर्तुस्तस्मादहं विना ।\nमृत्यो प्रसादयामि त्वां नय मां दुःखभागिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000559014, "chapter_id": 9559, "verse_number": "७-२४-१५", "content_sanskrit": "किन्नु तद्दुष्कृतं कर्म पुरा देहान्तरे कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000559015, "chapter_id": 9559, "verse_number": "७-२४-१६", "content_sanskrit": "एवं स्म दुःखिताः सर्वाः पतिताः शोकसागरे ।\nन खल्विदानीं पश्यामो दुःखस्यास्यान्तमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000559016, "chapter_id": 9559, "verse_number": "७-२४-१७", "content_sanskrit": "अहो धिङ्मानुषं लोकं नास्ति खल्वधमः परः ।\nयद्दुर्बला बलवता भर्तारो रावणेन नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000559017, "chapter_id": 9559, "verse_number": "७-२४-१८", "content_sanskrit": "सूर्येणोदयता काले नक्षत्राणीव नाशिताः ।\nअहो सुबलवद्रक्षो वधोपायेषु युज्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000559018, "chapter_id": 9559, "verse_number": "७-२४-१९", "content_sanskrit": "अहो दुर्वृत्तमास्थाय नात्मानं वैजुगुप्सते ।\nसर्वथा सदृशस्तावद्विक्रमो ऽस्य दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000559019, "chapter_id": 9559, "verse_number": "७-२४-२०", "content_sanskrit": "इदं त्वसदृशं कर्म परदाराभिमर्शनम् ।\nयस्मादेष परक्यासु रमते राक्षसाधमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000559020, "chapter_id": 9559, "verse_number": "७-२४-२१", "content_sanskrit": "तस्माद्वै स्त्रीकृतेनैव प्राप्स्यते दुर्मतिर्वधम् ।\nसतीभिर्वरनारीभिरेवं वाक्ये ऽभ्युदीरिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000559021, "chapter_id": 9559, "verse_number": "७-२४-२२", "content_sanskrit": "नेदुर्दुन्दुभयः खस्थाः पुष्पवृष्टिः पपात च ।\nशप्तः स्त्रीभिः स तु समं हतौजा इव निष्प्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000559022, "chapter_id": 9559, "verse_number": "७-२४-२३", "content_sanskrit": "पतिव्रताभिः साध्वीभिर्बभूव विमना इव ।\nएवं विलपितं तासां शृण्वन्राक्षसपुङ्गवः ।\nप्रविवेश पुरीं लङ्कां पूज्यमानो निशाचरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000559023, "chapter_id": 9559, "verse_number": "७-२४-२४", "content_sanskrit": "एतस्मिन्नन्तरे घोरा राक्षसी कामरूपिणी ।\nसहसा पतिता भूमौ भगिनी रावणस्य सा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000559024, "chapter_id": 9559, "verse_number": "७-२४-२५", "content_sanskrit": "तां स्वसारं समुत्थाप्य रावणः परिसान्त्वयन् ।\nअब्रवीत्किमिदं भद्रे वक्तुकामा ऽसि मे द्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000559025, "chapter_id": 9559, "verse_number": "७-२४-२६", "content_sanskrit": "सा बाष्पपरिरुद्धाक्षी रक्ताक्षी वाक्यमब्रवीत् ।\nकृता ऽस्मि विधवा राजंस्त्वया बलवता बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000559026, "chapter_id": 9559, "verse_number": "७-२४-२७", "content_sanskrit": "एते राजंस्त्वया वीरा दैत्या विनिहता रणे ।\nकालकेया इति ख्याताः सहस्राणि चतुर्दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000559027, "chapter_id": 9559, "verse_number": "७-२४-२८", "content_sanskrit": "प्राणेभ्यो ऽपि गरीयान्मे तत्र भर्ता महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000559028, "chapter_id": 9559, "verse_number": "७-२४-२९", "content_sanskrit": "सो ऽपि त्वया हतस्तात रिपुणा भ्रातृगृध्नुना ।\nत्वया ऽस्मि निहता राजन्स्वयमेव हि बन्धुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000559029, "chapter_id": 9559, "verse_number": "७-२४-३०", "content_sanskrit": "राजन्वैधव्यशब्दं च भोक्ष्यामि त्वत्कृते ह्यहम् ।\nननु नाम त्वया रक्ष्यो जामाता समरेष्वपि ।\nस त्वया निहतो युद्धे स्वयमेव न लज्जसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000559030, "chapter_id": 9559, "verse_number": "७-२४-३१", "content_sanskrit": "एवमुक्तो दशग्रीवो भगिन्या क्रोशमानया ।\nअब्रवीत्सान्त्वयित्वा तां सामपूर्वमिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000559031, "chapter_id": 9559, "verse_number": "७-२४-३२", "content_sanskrit": "अलं वत्से रुदित्वा ते न भेतव्यं च सर्वशः ।\nदानमानप्रसादैस्त्वां तोषयिष्यामि यत्नतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000559032, "chapter_id": 9559, "verse_number": "७-२४-३३", "content_sanskrit": "युद्धप्रमत्तो व्याक्षिप्तो जयाकाङ्क्षी क्षिपञ्छरान् ।\nनावगच्छामि युद्धेषु स्वान्परान्वाप्यहं शुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000559033, "chapter_id": 9559, "verse_number": "७-२४-३४", "content_sanskrit": "जामातरं न जाने स्म प्रहरन्युद्धदुर्मदः ।\nतेनासौ निहतः सङ्ख्ये मया भर्ता तव स्वसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000559034, "chapter_id": 9559, "verse_number": "७-२४-३५", "content_sanskrit": "अस्मिन्काले तु यत्प्राप्तं तत्करिष्यामि ते हितम् ।\nभ्रातुरैश्वर्ययुक्तस्य खरस्य वस पार्श्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000559035, "chapter_id": 9559, "verse_number": "७-२४-३६", "content_sanskrit": "चतुर्दशानां भ्राता ते सहस्राणां भविष्यति ।\nप्रभुः प्रयाणे दाने च राक्षसानां महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000559036, "chapter_id": 9559, "verse_number": "७-२४-३७", "content_sanskrit": "तत्र मातृष्वसेयस्ते भ्राता ऽयं वै खरः प्रभुः ।\nभविष्यति तवादेशं सदा कुर्वन्निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000559037, "chapter_id": 9559, "verse_number": "७-२४-३८", "content_sanskrit": "शीघ्रं गच्छत्वयं वीरो दण्डकान्परिरक्षितुम् ।\nदूषणो ऽस्य बलाध्यक्षो भविष्यति महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000559038, "chapter_id": 9559, "verse_number": "७-२४-३९", "content_sanskrit": "तत्र ते वचनं शूरः करिष्यति सदा खरः ।\nरक्षसां कामरूपाणां प्रभुरेष भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000559039, "chapter_id": 9559, "verse_number": "७-२४-४०", "content_sanskrit": "एवमुक्त्वा दशग्रीवः सैन्यमस्यादिदेश ह ।\nचतुर्दश सहस्राणि रक्षसां वीर्यशालिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000559040, "chapter_id": 9559, "verse_number": "७-२४-४१", "content_sanskrit": "स तैः परिवृतस्सर्वै राक्षसैर्घोरदर्शनैः ।\nआगच्छत खरः शीघ्रं दण्डकानकुतोभयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000559041, "chapter_id": 9559, "verse_number": "७-२४-४२", "content_sanskrit": "स तत्र कारयामास राज्यं निहतकण्टकम् ।\nसा च शूर्पणखा तत्र न्यवसद्दण्डकावने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000559042, "chapter_id": 9559, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे चतुर्विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]