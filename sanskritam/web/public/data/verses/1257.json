[{"id": 2012520, "chapter_id": 1257, "verse_number": "१-२५८-०x", "content_sanskrit": "जरितारिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2012521, "chapter_id": 1257, "verse_number": "१-२५८-१", "content_sanskrit": "पुरतः कृच्छ्रकालस्य धीमाञ्जागर्ति पुरुषः।\nस कृच्छ्रकालं संप्राप्य व्यथां नैवैति कर्हिचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2012522, "chapter_id": 1257, "verse_number": "१-२५८-२", "content_sanskrit": "यस्तु कृच्छ्रमनुप्राप्तं विचेता नावबुध्यते।\nसकृच्छ्रकाले व्यथितो न श्रेयो विन्दते महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2012523, "chapter_id": 1257, "verse_number": "१-२५८-३x", "content_sanskrit": "सारिसृक्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2012524, "chapter_id": 1257, "verse_number": "१-२५८-३", "content_sanskrit": "धीरस्त्वमसि मेधावी प्राणकृच्छ्रमिदं च नः।\nप्राज्ञः शूरो बहूनां हि भवत्येको न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2012525, "chapter_id": 1257, "verse_number": "१-२५८-४x", "content_sanskrit": "स्तम्बमित्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2012526, "chapter_id": 1257, "verse_number": "१-२५८-४", "content_sanskrit": "ज्येष्ठस्तातो भवति वै ज्येष्ठो मुञ्चति कृच्छ्रतः।\nज्येष्ठश्चेन्न प्रजानाति नीयान्किं करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2012527, "chapter_id": 1257, "verse_number": "१-२५८-५x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2012528, "chapter_id": 1257, "verse_number": "१-२५८-५", "content_sanskrit": "हिरण्यरेतास्त्वरितो जलन्नायाति नः क्षयम्।\nसप्तजिह्वाननः क्रूरो लिहानो विसर्पति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2012529, "chapter_id": 1257, "verse_number": "१-२५८-६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2012530, "chapter_id": 1257, "verse_number": "१-२५८-६", "content_sanskrit": "एवं संभाष्य तेऽन्योन्यं मन्दपालस्य पुत्रकाः।\nतुष्टुवुः प्रयता भूत्वा यथाऽग्निं शृणु पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2012531, "chapter_id": 1257, "verse_number": "१-२५८-७x", "content_sanskrit": "जरितारिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2012532, "chapter_id": 1257, "verse_number": "१-२५८-७", "content_sanskrit": "आत्माऽसि वायोर्ज्वलन शरीरमसि वीरुधाम्।\nयोनिरापश्च ते शुक्रं योनिस्त्वमसि चाम्भसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2012533, "chapter_id": 1257, "verse_number": "१-२५८-८", "content_sanskrit": "ऊर्ध्वं चाधश्च सर्पन्ति पृष्ठतः पार्श्वतस्तथा।\nअर्चिषस्ते महावीर्य रश्यमः सवितुर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2012534, "chapter_id": 1257, "verse_number": "१-२५८-९x", "content_sanskrit": "सारिसृक्क उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2012535, "chapter_id": 1257, "verse_number": "१-२५८-९", "content_sanskrit": "माता प्रणष्टा पितरं न विद्मः\nपक्षा जाता नै नो धूमकेतो।\nन नस्त्राता विद्यते वै त्वदन्य-\nस्तस्मादस्मांस्त्राहि बालांस्त्वमग्ने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2012536, "chapter_id": 1257, "verse_number": "१-२५८-१०", "content_sanskrit": "यदग्ने ते शिवं रूपं ये च ते सप्त हेतयः।\nतेन नः परिपाहि त्वमार्तान्नः शरणैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2012537, "chapter_id": 1257, "verse_number": "१-२५८-११", "content_sanskrit": "त्वमेवैकस्तपसे जप्तवेदो\nनान्यस्तप्ता विद्यते गोषु देव।\nऋषीनस्मान्बालकान्पालयस्व\nपरेणास्मान्प्रेहि वै हव्यवाह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2012538, "chapter_id": 1257, "verse_number": "१-२५८-१२x", "content_sanskrit": "स्तम्बमित्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2012539, "chapter_id": 1257, "verse_number": "१-२५८-१२", "content_sanskrit": "सर्वमग्ने त्वमेवैकस्त्वयि सर्वमिदं जगत्।\nत्वं धारयसि भूतानि भुवनं त्वं बिभर्षि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2012540, "chapter_id": 1257, "verse_number": "१-२५८-१३", "content_sanskrit": "त्वमग्निर्हव्यवाहस्त्वं त्वमेव परमं हविः।\nमनीषिणस्त्वां जानन्ति बहुधा चैकधापि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2012541, "chapter_id": 1257, "verse_number": "१-२५८-१४", "content_sanskrit": "सृष्ट्वा लोकांस्त्रीनिमान्हव्यवाह\nकाले प्राप्ते पचसि पुनः समिद्धः।\nत्वं सर्वस्य भुवनस्य प्रसूति-\nस्त्वमेवाग्ने भवसि पुनः प्रतिष्ठा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2012542, "chapter_id": 1257, "verse_number": "१-२५८-१५x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2012543, "chapter_id": 1257, "verse_number": "१-२५८-१५", "content_sanskrit": "त्वमन्नं प्राणिभिर्भुक्तमन्तर्भूतो जगत्पते।\nनित्यप्रवृद्धः पचसि त्वयि सर्वं प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2012544, "chapter_id": 1257, "verse_number": "१-२५८-१६", "content_sanskrit": "सूर्यो भूत्वा रश्मिभिर्जातवेदो\nभूमेरम्भो भूमिजातान्रसांश्च।\nविश्वानादाय पुनरुत्सृज्य काले\nदृष्ट्वा वृष्ट्या भावयसीह शुक्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2012545, "chapter_id": 1257, "verse_number": "१-२५८-१७", "content_sanskrit": "त्वत्त एताः पुनः शुक्र वीरुधो हरितच्छदाः।\nजायन्ते पुष्करिण्यश्च सुभद्रश्च महोदधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2012546, "chapter_id": 1257, "verse_number": "१-२५८-१८", "content_sanskrit": "इदं वै सद्म तिग्मांशो वरुणस्य परायणम्।\nशिवस्त्राता भवास्माकं माऽस्मानद्य विनाशय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2012547, "chapter_id": 1257, "verse_number": "१-२५८-१९", "content_sanskrit": "पिङ्गाक्ष लोहितग्रीव कृष्णवर्त्मन्हुताशन।\nपरेण प्रेहि मुञ्चास्मान्सागरस्य गृहानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2012548, "chapter_id": 1257, "verse_number": "१-२५८-२०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2012549, "chapter_id": 1257, "verse_number": "१-२५८-२०", "content_sanskrit": "एवमुक्तो जातवेदा द्रोणेन ब्रह्मवादिना।\nद्रोणमाह प्रतीतात्मा मन्दपालप्रतिज्ञया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2012550, "chapter_id": 1257, "verse_number": "१-२५८-२१x", "content_sanskrit": "अग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2012551, "chapter_id": 1257, "verse_number": "१-२५८-२१", "content_sanskrit": "ऋषिर्द्रोणस्त्वमसि वै ब्रह्मैतद्व्याहृतं\nईप्सितं ते करिष्यामि न च ते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2012552, "chapter_id": 1257, "verse_number": "१-२५८-२२", "content_sanskrit": "मन्दपालेन वै यूयं मम पूर्वं निवेदिताः।\nवर्जयेः पुत्रकान्मह्यं दहन्दावमिति स्म ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2012553, "chapter_id": 1257, "verse_number": "१-२५८-२३", "content_sanskrit": "तस्य तद्वचनं द्रोण त्वया यच्चेह भाषितम्।\nउभयं मे गरीयस्तु ब्रूहि किं करवाणि ते।\nभृशं प्रीतोऽस्मि भद्रं ते ब्रह्मंस्तोत्रेण सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2012554, "chapter_id": 1257, "verse_number": "१-२५८-२४x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2012555, "chapter_id": 1257, "verse_number": "१-२५८-२४", "content_sanskrit": "इमे मार्जारकाः शुक्र नित्यमुद्वेजयन्ति नः।\nएतान्कुरुष्व दग्धांस्त्वं हुताशन सबान्धवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2012556, "chapter_id": 1257, "verse_number": "१-२५८-२५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2012557, "chapter_id": 1257, "verse_number": "१-२५८-२५", "content_sanskrit": "तथा तत्कृतवानग्निरभ्यनुज्ञाय शार्ङ्गकान्।\nददाह खाण्डवं दावं समिद्धो जनमेजय॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2012558, "chapter_id": 1257, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि मयदर्शनपर्वणि अष्टपञ्चाशदधिकद्विशततमोऽध्यायः॥ २५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]