[{"id": 7002964000, "chapter_id": 22964, "verse_number": "२-११-१", "content_sanskrit": "नारद उवाच ।\nकलेः पञ्चसहस्रे सा समतीते सुरेश्वरी ।\nक्व गता सा महाभागा तन्मे व्याख्यातुमर्हसि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002964001, "chapter_id": 22964, "verse_number": "२-११-२", "content_sanskrit": "नारायण उवाच ।\nभारतं भारतीशापात्समागत्येश्वरेच्छया ।\nजगाम तं च वैकुण्ठं शापान्ते पुनरेव सा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002964002, "chapter_id": 22964, "verse_number": "२-११-३", "content_sanskrit": "भारतं भारती त्यक्त्वा चागमत्तद्धरेः पदम् ।\nपद्मावती च शापान्ते गंगायाश्चैव नारद ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002964003, "chapter_id": 22964, "verse_number": "२-११-४", "content_sanskrit": "गङ्गा सरस्वती लक्ष्मीश्चैतास्तिस्रः प्रिया हरेः ।\nतुलसीसहिता ब्रह्मंश्चतस्रः कीर्त्तिताः श्रुतौ ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002964004, "chapter_id": 22964, "verse_number": "२-११-५", "content_sanskrit": "नारद उवाच ।\nहेतुना केन देवी वै विष्णुपादाब्जसंभवा ।\nधातुः कमण्डलुस्था च शङ्करस्य शिरोगता ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002964005, "chapter_id": 22964, "verse_number": "२-११-६", "content_sanskrit": "बभूव सा मुनिश्रेष्ठ गंगा नारायणप्रिया ।\nअहो केन प्रकारेण तन्मे व्याख्यातुमर्हसि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002964006, "chapter_id": 22964, "verse_number": "२-११-७", "content_sanskrit": "॥ श्रीनारायण उवाच ।\nपुरा बभूव गोलोके सा गंगा द्रवरूपिणी ।\nराधाकृष्णांगसंभूता तदंशा तत्स्वरूपिणी ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002964007, "chapter_id": 22964, "verse_number": "२-११-८", "content_sanskrit": "द्रवाधिष्ठातृरूपा या रूपेणाप्रतिमा भुवि ।\nनवयौवनसम्पन्ना रत्नाभरणभूषिता ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002964008, "chapter_id": 22964, "verse_number": "२-११-९", "content_sanskrit": "शरन्मध्याह्नपद्मास्या सस्मिता सुमनोहरा ।\nतप्तकाञ्चनवर्णाभा शरच्चन्द्रसमप्रभा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002964009, "chapter_id": 22964, "verse_number": "२-११-१०", "content_sanskrit": "स्निग्धप्रभाऽतिसुस्निग्धा शुद्धसत्त्वस्वरूपिणी ।\nसुपीनकठिनश्रोणी सुनितम्बयुगं वरम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002964010, "chapter_id": 22964, "verse_number": "२-११-११", "content_sanskrit": "पीनोन्नतं सुकठिनं स्तनयुग्मं सुवर्तुलम् ।\nसुचारु नेत्रयुगलं सुकटाक्षं सुवक्रिमम्॥ ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002964011, "chapter_id": 22964, "verse_number": "२-११-१२", "content_sanskrit": "वक्रिमं कबरीभारं मालतीमाल्यसंयुतम् ।\nसिन्दूरबिन्दुललितं सार्द्धं चन्दनबिन्दुभिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002964012, "chapter_id": 22964, "verse_number": "२-११-१३", "content_sanskrit": "कस्तूरीपत्रिकायुक्तं गण्डयुग्मं मनोहरम् ।\nबन्धूककुसुमाकारमधरोष्ठं च सुंदरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002964013, "chapter_id": 22964, "verse_number": "२-११-१४", "content_sanskrit": "पक्वदाडिमबीजाभदन्तपंक्तिसमुज्ज्वला ।\nवाससी वह्निशुद्धे च नीवीयुक्ते च बिभ्रती ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002964014, "chapter_id": 22964, "verse_number": "२-११-१५", "content_sanskrit": "सा सकामा कृष्णपार्श्वे समुत्तस्थे सुलज्जिता ।\nपद्मपत्रसमानाभ्यां लोचनाभ्यां विभो मुखम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002964015, "chapter_id": 22964, "verse_number": "२-११-१६", "content_sanskrit": "निमेषरहिताभ्यां च पिबन्ती सततं मुदा ।\nप्रफुल्लवदना हर्षान्नवसङ्गमलालसा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002964016, "chapter_id": 22964, "verse_number": "२-११-१७", "content_sanskrit": "मूर्च्छिता प्रभुरूपेण पुलकाङ्कितविग्रहा ।\nएतस्मिन्नन्तरे तत्र विद्यमाना च राधिका ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002964017, "chapter_id": 22964, "verse_number": "२-११-१८", "content_sanskrit": "गोपीत्रिंशत्कोटियुक्ता कोटिचन्द्रसमप्रभा ।\nकोपेन रक्तपद्मास्या रक्तपङ्कजलोचना ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002964018, "chapter_id": 22964, "verse_number": "२-११-१९", "content_sanskrit": "श्वेतचम्पकवर्णाभा मत्तवारणगामिनी ।\nअमूल्यरत्नखचितनानाभरणभूषिता ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002964019, "chapter_id": 22964, "verse_number": "२-११-२०", "content_sanskrit": "माणिक्यखचितं हारममूल्यं वह्निशौचकम् ।\nपीताभवस्त्रयुगलं नीवीयुक्तं च बिभ्रती ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002964020, "chapter_id": 22964, "verse_number": "२-११-२१", "content_sanskrit": "स्थलपद्मप्रभाजुष्टं कोमलं च सुरञ्जितम् ।\nकृष्णदत्तार्घ्यसंयुक्तं विन्यस्यन्ती पदाम्बुजम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002964021, "chapter_id": 22964, "verse_number": "२-११-२२", "content_sanskrit": "रत्नेन्द्रराजखचितविमानादवरुह्य च ।\nसेव्यमाना च सखिभिः श्वेत चामरवायुना ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002964022, "chapter_id": 22964, "verse_number": "२-११-२३", "content_sanskrit": "कस्तूरीबिन्दुतिलकं चन्दनेन्दुसमन्वितम् ।\nदीप्तदीपप्रभाकारं सिन्दूरारुणसुन्दरम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002964023, "chapter_id": 22964, "verse_number": "२-११-२४", "content_sanskrit": "दधती भालमध्ये च सीमन्ताधस्तदुज्ज्वलम् ।\nपारिजातप्रसूनादिमालायुक्तं सुवक्रिमम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002964024, "chapter_id": 22964, "verse_number": "२-११-२५", "content_sanskrit": "सुचारुकबरीभारं कम्पयन्ती च कम्पिता ।\nसुचारुनासासंयुक्तमोष्ठं कम्पयती रुषा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002964025, "chapter_id": 22964, "verse_number": "२-११-२६", "content_sanskrit": "गत्वा तस्थौ कृष्णपार्श्वे रत्नसिंहासने वरे ।\nसखीनां च समूहैश्च परिपूर्णा विभोः सभा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002964026, "chapter_id": 22964, "verse_number": "२-११-२७", "content_sanskrit": "तां च दृष्ट्वा समुत्तस्थौ कृष्णः सादरमच्युतः ।\nसंभाष्य मधुरालापैः सस्मितश्च ससंभ्रमः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002964027, "chapter_id": 22964, "verse_number": "२-११-२८", "content_sanskrit": "प्रणेमुरभि संत्रस्ता गोपा नम्रात्मकन्धराः ।\nतुष्टुवुस्ते च भक्त्या तं तुष्टाव परमेश्वरम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002964028, "chapter_id": 22964, "verse_number": "२-११-२९", "content_sanskrit": "उत्थाय गंगा सहसा सम्भाषां च चकार सा ।\nकुशलं परिपप्रच्छ भीताऽतिविनयेन च ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002964029, "chapter_id": 22964, "verse_number": "२-११-३०", "content_sanskrit": "नम्रभावस्थिता त्रस्ता शुष्ककण्ठौष्ठतालुका ।\nध्यानेन शरणापन्ना श्री कृष्णचरणम्बुजे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002964030, "chapter_id": 22964, "verse_number": "२-११-३१", "content_sanskrit": "तद्धृत्पद्मे स्थितः कृष्णो भीतायै चाभयं ददौ ।\nबभूव स्थिरचित्ता सा सर्वेश्वरवरेण च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002964031, "chapter_id": 22964, "verse_number": "२-११-३२", "content_sanskrit": "ऊर्ध्वं सिंहासनस्थां च राधां गङ्गा ददर्श सा ।\nसुस्निग्धां सुखदृश्यां च ज्वलन्तीं ब्रह्मतेजसा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002964032, "chapter_id": 22964, "verse_number": "२-११-३३", "content_sanskrit": "असंख्यब्रह्मणामाद्यां चादिसृष्टिं सनातनीम् ।\nयथा द्वादशवर्षीयां कन्यां च नवयौवनाम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002964033, "chapter_id": 22964, "verse_number": "२-११-३४", "content_sanskrit": "विश्ववृन्दे निरुपमां रूपेण च गुणेन च ।\nशान्त कान्तामनन्तां तामाद्यन्तरहितां सतीम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002964034, "chapter_id": 22964, "verse_number": "२-११-३५", "content_sanskrit": "शुभां सुभद्रां सुभगां स्वामिसौभाग्यसंयुताम् ।\nसौन्दर्यसुन्दरीं श्रेष्ठां सुन्दरीष्वखिलासु च ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002964035, "chapter_id": 22964, "verse_number": "२-११-३६", "content_sanskrit": "कृष्णार्द्धाङ्गी कृष्णसमां तेजसा वयसा त्विषा ।\nपूजितां च महालक्ष्मीं महालक्ष्मीश्वरेण च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002964036, "chapter_id": 22964, "verse_number": "२-११-३७", "content_sanskrit": "प्रच्छाद्यमानां प्रभया सभामीशस्य सुप्रभाम् ।\nसखीदत्तं च ताम्बूलं गृह्णतीमन्यदुर्लभम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002964037, "chapter_id": 22964, "verse_number": "२-११-३८", "content_sanskrit": "अजन्यां सर्वजननीं धन्यां मान्यां च मानिनीम् ।\nकृष्णप्राणाधिदेवीं च प्राणप्रियतमां रमाम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002964038, "chapter_id": 22964, "verse_number": "२-११-३९", "content_sanskrit": "दृष्ट्वा रासेश्वरीं तृप्तिं न जगाम सुरेश्वरी ।\nनिमेषरहिताभ्यां च लोच नाभ्यां पपौ च ताम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002964039, "chapter_id": 22964, "verse_number": "२-११-४०", "content_sanskrit": "एतस्मिन्नन्तरे राधा जगदीशमुवाच सा ।\nवाचा मधुरया शान्ता विनीता सस्मिता मुने ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002964040, "chapter_id": 22964, "verse_number": "२-११-४१", "content_sanskrit": "राधिकोवाच ।\nकेयं प्राणेश कल्याणी सस्मिता त्वन्मुखाम्बुजम् ।\nपश्यन्ती सततं पार्श्वे सकामा रक्तलोचना ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002964041, "chapter_id": 22964, "verse_number": "२-११-४२", "content_sanskrit": "मूर्च्छां प्राप्नोति रूपेण पुलकाङ्कितविग्रहा ।\nवस्त्रेण मुखमाच्छाद्य निरीक्षन्ती पुनः पुनः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002964042, "chapter_id": 22964, "verse_number": "२-११-४३", "content_sanskrit": "त्वं चापि मां सन्निरीक्ष्य सकामः सस्मितः सदा ।\nमयि जीवति गोलोके भूता दुर्वृत्तिरीदृशी ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002964043, "chapter_id": 22964, "verse_number": "२-११-४४", "content_sanskrit": "त्वमेव चैवं दुर्वृत्तं वारंवारं करोषि च ।\nक्षमां करोमि ते प्रेम्णा स्त्रीजातिः स्निग्धमानसा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002964044, "chapter_id": 22964, "verse_number": "२-११-४५", "content_sanskrit": "संगृह्येमां प्रियामिष्टां गोलोकाद्गच्छ लम्पट ।\nअन्यथा नहि ते भद्रं भविष्यति सुरेश्वर ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002964045, "chapter_id": 22964, "verse_number": "२-११-४६", "content_sanskrit": "दृष्टस्त्वं विरजायुक्तो मया चन्दनकानने ।\nक्षमा कृता मया पूर्वं सखीनां वचनादहो ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002964046, "chapter_id": 22964, "verse_number": "२-११-४७", "content_sanskrit": "त्वया मच्छब्दमात्रेण तिरोधानं कृतं पुरा ।\nदेहं सन्त्यज्य विरजा नदीरूपा बभूव सा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002964047, "chapter_id": 22964, "verse_number": "२-११-४८", "content_sanskrit": "कोटियोजनविस्तीर्णा ततो दैर्घ्ये चतुर्गुणा ।\nअद्यापि विद्यमाना सा तव सत्की र्तिरूपिणी ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002964048, "chapter_id": 22964, "verse_number": "२-११-४९", "content_sanskrit": "गृहं मयि गतायां च पुनर्गत्वा तदन्तिकम् ।\nउच्चैररौषीर्विरजे विरजे चेति संस्मरन् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002964049, "chapter_id": 22964, "verse_number": "२-११-५०", "content_sanskrit": "तदा तोयात्समुत्थाय सा योगात्सिद्धयोगिनी ।\nसालङ्कारा मूर्तिमती ददौ तुभ्यं च दर्शनम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002964050, "chapter_id": 22964, "verse_number": "२-११-५१", "content_sanskrit": "ततस्तां च समाश्लिष्य वीर्य्याधानं कृतं त्वया ।\nततो बभूवुस्तस्यां च समुद्राः सप्त चैव हि ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002964051, "chapter_id": 22964, "verse_number": "२-११-५२", "content_sanskrit": "दृष्टस्त्वं शोभया गोप्या युक्तश्चम्पककानने ।\nसद्यो मच्छब्दमात्रेण तिरोधानं कृतं त्वया ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002964052, "chapter_id": 22964, "verse_number": "२-११-५३", "content_sanskrit": "शोभा देहं परित्यज्य प्राविशच्चन्द्रमण्डलम् ।\nततस्तस्याः शरीरं च स्निग्धं तेजो बभूव ह ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002964053, "chapter_id": 22964, "verse_number": "२-११-५४", "content_sanskrit": "संविभज्य त्वया दत्तं हृदयेन विदूयता ।\nरत्नाय किञ्चित्स्वर्णाय किञ्चिन्मतिवराय च ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002964054, "chapter_id": 22964, "verse_number": "२-११-५५", "content_sanskrit": "किञ्चित्स्त्रीणां मुखाब्जेभ्यः किञ्चिद्राज्ञे च किञ्चन ।\nकिञ्चित्प्रकृष्टवस्त्रेभ्यो रौप्येभ्यश्चापि किञ्चन ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002964055, "chapter_id": 22964, "verse_number": "२-११-५६", "content_sanskrit": "किञ्चिच्चन्दनपङ्केभ्यस्तोयेभ्यश्चापि किञ्चन ।\nकिञ्चित्किसलयेभ्यश्च पुष्पेभ्यश्चापि किंचन ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002964056, "chapter_id": 22964, "verse_number": "२-११-५७", "content_sanskrit": "किञ्चित्फलेभ्यः सस्येभ्यः सुपक्वेभ्यश्च किञ्चन ।\nनृपदेवगृहेभ्यश्च संस्कृतेभ्यश्च किंचन ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002964057, "chapter_id": 22964, "verse_number": "२-११-५८", "content_sanskrit": "दृष्टस्त्वं प्रभया गोप्या युक्तो वृन्दावने वने ।\nसद्यो मच्छब्दमात्रेण तिरोधानं कृतं त्वया॥ ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002964058, "chapter_id": 22964, "verse_number": "२-११-५९", "content_sanskrit": "प्रभा देहं परित्यज्य प्राविशत्सूर्य्यमण्डलम् ।\nततस्तस्याः शरीरं च तीक्ष्णं तेजो बभूव ह ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002964059, "chapter_id": 22964, "verse_number": "२-११-६०", "content_sanskrit": "संविभज्य त्वया दत्तं प्रेम्णा च रुदता पुरा ।\nविभज्य चक्षुषोर्दत्तं लज्जया तद्भयेन च ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002964060, "chapter_id": 22964, "verse_number": "२-११-६१", "content_sanskrit": "हुताशनाय किंचिच्च नृपेभ्यश्चापि किञ्चन ।\nकिंचित्पुरुषसंघेभ्यो देवेभ्यश्चापि किंचन ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002964061, "chapter_id": 22964, "verse_number": "२-११-६२", "content_sanskrit": "किंचिद्दस्युगणेभ्यश्च नागेभ्यश्चापि किंचन ।\nब्राह्मणेभ्यो मुनिभ्यश्च तपस्विभ्यश्च किंचन ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002964062, "chapter_id": 22964, "verse_number": "२-११-६३", "content_sanskrit": "स्त्रीभ्यः सौभाग्ययुक्ताभ्यो यशस्विभ्यश्च किंचन ।\nतच्च दत्त्वा च सर्वेभ्यः पूर्वं रोदितुमुद्यतः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002964063, "chapter_id": 22964, "verse_number": "२-११-६४", "content_sanskrit": "शान्त्या गोप्या युतस्त्वं च दृष्टो वै रासमण्डले ।\nवसन्ते पुष्पशय्यायां माल्यवांश्चन्दनोक्षितः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002964064, "chapter_id": 22964, "verse_number": "२-११-६५", "content_sanskrit": "रत्नप्रदीपैर्युक्तश्च रत्ननिर्मितमन्दिरे ।\nरत्नभूषणभूषाढ्यो रत्नभूषितया सह ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002964065, "chapter_id": 22964, "verse_number": "२-११-६६", "content_sanskrit": "त्वया दत्तं च ताम्बूलं भुक्तवत्यै सुवासितम् ।\nतया दत्तं च ताम्बूलं भुक्तवांस्त्वं पुरा विभो ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002964066, "chapter_id": 22964, "verse_number": "२-११-६७", "content_sanskrit": "सद्यो मच्छब्दमात्रेण तिरोधानं कृतं त्वया ।\nशान्तिर्देहं परित्यज्य भिया लीना त्वयि प्रभो ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002964067, "chapter_id": 22964, "verse_number": "२-११-६८", "content_sanskrit": "ततस्तस्याः शरीरं च गुणश्रेष्ठं बभूव ह ।\nसंविभज्य त्वया दत्तं प्रेम्णा च रुदता पुरा ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002964068, "chapter_id": 22964, "verse_number": "२-११-६९", "content_sanskrit": "विश्वे विषयिणे किंचित्सत्त्वरूपाय विष्णवे ।\nशुद्धसत्त्वस्वरूपायै किंचिल्लक्ष्म्यै   पुरा विभो ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002964069, "chapter_id": 22964, "verse_number": "२-११-७०", "content_sanskrit": "त्वन्मन्त्रोपासकेभ्यश्च वैष्णवेभ्यश्च किंचन ।\nतपस्विभ्यश्च धर्माय धर्मिष्ठेभ्यश्च किंचन ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002964070, "chapter_id": 22964, "verse_number": "२-११-७१", "content_sanskrit": "मया पूर्वं हि दृष्टस्त्वं गोप्या च क्षमया सह ।\nसुवेषवान्माल्यवांश्च गन्धचन्दनसंयुतः॥ ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002964071, "chapter_id": 22964, "verse_number": "२-११-७२", "content_sanskrit": "रत्नभूषितया चारुचन्दनोक्षितया तया ।\nसुखेन मूर्छितस्तल्पे पुष्पचन्दनसंयुते ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002964072, "chapter_id": 22964, "verse_number": "२-११-७३", "content_sanskrit": "श्लिष्टोऽभून्निद्रया सद्यः सुखेन नवसङ्गमात् ।\nमया प्रबोधितौ सा च भवांश्च स्मरणं कुरु ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002964073, "chapter_id": 22964, "verse_number": "२-११-७४", "content_sanskrit": "गृहीतं पीतवस्त्रं ते मुरली च मनोहरा ।\nवनमाला कौस्तुभश्चाप्यमूल्यं रत्नकुण्डलम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002964074, "chapter_id": 22964, "verse_number": "२-११-७५", "content_sanskrit": "पश्चात्प्रदत्तं प्रेम्णा च सखीनां वचनादहो ।\nलज्जया कृष्णवर्णोऽभूदद्यापि च भवान्प्रभो ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002964075, "chapter_id": 22964, "verse_number": "२-११-७६", "content_sanskrit": "क्षमा देहं परित्यज्य लज्जया पृथिवीं गता ।\nततस्तस्याः शरीरं च गुणश्रेष्ठं बभूव ह ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002964076, "chapter_id": 22964, "verse_number": "२-११-७७", "content_sanskrit": "संविभज्य त्वया दत्तं प्रेम्णा च रुदता पुरा ।\nकिंचिद्दत्तं विष्णवे च वैष्णवेभ्यश्च किंचन ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002964077, "chapter_id": 22964, "verse_number": "२-११-७८", "content_sanskrit": "धर्मिष्ठेभ्यश्च धर्माय दुर्बलेभ्यश्च किंचन ।\nतपस्विभ्योऽपि देवेभ्यः पंडितेभ्यश्च किंचन ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002964078, "chapter_id": 22964, "verse_number": "२-११-७९", "content_sanskrit": "एतत्ते कथितं सर्वं किं भूयः श्रोतुमिच्छसि ।\nत्वद्गुणं बहुविस्तारं जानामि च परं प्रभो ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002964079, "chapter_id": 22964, "verse_number": "२-११-८०", "content_sanskrit": "इत्येवमुक्त्वा सा राधा रक्तपङ्कजलोचना ।\nगङ्गां वक्तुं समारेभे नम्रास्यां लज्जितां सतीम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002964080, "chapter_id": 22964, "verse_number": "२-११-८१", "content_sanskrit": "गङ्गा रहस्यं योगेन ज्ञात्वा वै सिद्धयोगिनी ।\nतिरोभूय सभामध्यात्स्वजलं प्रविवेश सा ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002964081, "chapter_id": 22964, "verse_number": "२-११-८२", "content_sanskrit": "राधा योगेन विज्ञाय सर्वत्रावस्थितां च ताम् ।\nपानं कर्तुं समारेभे गण्डूषात्सिद्धयोगिनी ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002964082, "chapter_id": 22964, "verse_number": "२-११-८३", "content_sanskrit": "गंगा रहस्यं योगेन ज्ञात्वा वै सिद्धयोगिनी ।\nश्रीकृष्णचरणाम्भोजं परमं शरणं ययौ ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002964083, "chapter_id": 22964, "verse_number": "२-११-८४", "content_sanskrit": "गोलोकं चैव वैकुण्ठं ब्रह्मलोकादिकं तथा ।\nददर्श राधा सर्वत्र नैव गङ्गां ददर्श सा ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7002964084, "chapter_id": 22964, "verse_number": "२-११-८५", "content_sanskrit": "सर्वतो जलशून्यं च शुष्कपङ्कजगोलकम् ।\nजलजन्तुसमूहैश्च मृतदेहैः समन्वितम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7002964085, "chapter_id": 22964, "verse_number": "२-११-८६", "content_sanskrit": "ब्रह्मविष्णुशिवानन्तधर्मेन्द्रेन्दुदिवाकराः ।\nमनवो मानवाः सर्वे देवाः सिद्धास्तपस्विनः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7002964086, "chapter_id": 22964, "verse_number": "२-११-८७", "content_sanskrit": "गोलोकं च समाजग्मुः शुष्ककण्ठौष्ठतालुकाः ।\nसर्वे प्रणेमुर्गोविन्दं सर्वेशं प्रकृतेः परम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7002964087, "chapter_id": 22964, "verse_number": "२-११-८८", "content_sanskrit": "वरं वरेण्यं वरदं वरिष्ठं वरकारणम् ।\nवरेशं च वरार्हं च सर्वेषां प्रवरं प्रभुम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7002964088, "chapter_id": 22964, "verse_number": "२-११-८९", "content_sanskrit": "निरीहं च निराकारं निर्लिप्तं च निराश्रयम् ।\nनिर्गुणं च निरुत्साहं निर्व्यूहं च निरञ्जनम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7002964089, "chapter_id": 22964, "verse_number": "२-११-९०", "content_sanskrit": "स्वेच्छामयं च साकारं भक्तानुग्रहविग्रहम् ।\nसत्यस्वरूपं सत्येशं साक्षिरूपं सनातनम्॥ ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7002964090, "chapter_id": 22964, "verse_number": "२-११-९१", "content_sanskrit": "परं परेशं परमं परमात्मानमीश्वरम् ।\nप्रणम्य तुष्टुवुः सर्वे भक्तिनम्रात्मकन्धराः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7002964091, "chapter_id": 22964, "verse_number": "२-११-९२", "content_sanskrit": "सगद्गदा साश्रुनेत्राः पुलकाङ्कितविग्रहाः ।\nसर्वे संस्तूय सर्वेशं भगवन्तं परं हरिम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7002964092, "chapter_id": 22964, "verse_number": "२-११-९३", "content_sanskrit": "ज्योतिर्मयं परं ब्रह्म सर्वकारणकारणम् ।\nअमूल्यरत्नखचितचित्रसिंहासनस्थितम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7002964093, "chapter_id": 22964, "verse_number": "२-११-९४", "content_sanskrit": "सेव्यमानं च गोपालैः श्वेतचामरवायुना ।\nगोपालिकानृत्यगीतं पश्यन्तं सस्मितं मुदा ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7002964094, "chapter_id": 22964, "verse_number": "२-११-९५", "content_sanskrit": "वल्गुवेषैः परिवृतं गोपैश्च शतकोटिभिः ।\nचन्दनोक्षितसर्वांगं रत्नभूषणभूषितम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7002964095, "chapter_id": 22964, "verse_number": "२-११-९६", "content_sanskrit": "नवीननीरदश्यामं किशोरं पीतवाससम् ।\nयथा द्वादशवर्षीयं बालं गोपालरूपिणम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7002964096, "chapter_id": 22964, "verse_number": "२-११-९७", "content_sanskrit": "कोटिचन्द्रप्रभाजुष्टपुष्टश्रीयुक्तविग्रहम् ।\nस्वतेजसा परिवृतं सुसादृश्यं मनोहरम्॥ ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7002964097, "chapter_id": 22964, "verse_number": "२-११-९८", "content_sanskrit": "कोटिकन्दर्पसौन्दर्य्यलीलालावण्यविग्रहम् ।\nदृश्यमानं च गोपीभिः सस्मिताभिश्च सन्ततम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7002964098, "chapter_id": 22964, "verse_number": "२-११-९९", "content_sanskrit": "भूषणैर्भूषिताभिश्च महारत्नविनिर्मितैः ।\nपिबन्तीभिर्लोचनाभ्यां मुखचन्द्रं प्रभोर्मुदा ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7002964099, "chapter_id": 22964, "verse_number": "२-११-१००", "content_sanskrit": "प्राणाधिकप्रियतमाराधावक्षःस्थलस्थितम् ।\nतया प्रदत्तं ताम्बूलं भुक्तवन्तं सुवासितम् ।\nपरिपूर्णतमं रासे ददृशुः सर्वतः सुराः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7002964100, "chapter_id": 22964, "verse_number": "२-११-१०१", "content_sanskrit": "मुनयो मानवाः सिद्धास्तपसा च तपस्विनः ।\nप्रहृष्टमानसाः सर्वे जग्मुः परमविस्मयम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7002964101, "chapter_id": 22964, "verse_number": "२-११-१०२", "content_sanskrit": "परस्परं समालोच्य ते तमूचुश्चतुर्मुखम् ।\nनिवेदितुं जगन्नाथं स्वाभिप्रायमभीप्सितम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7002964102, "chapter_id": 22964, "verse_number": "२-११-१०३", "content_sanskrit": "ब्रह्मा तद्वचनं श्रुत्वा स्थितं विष्णोस्तु दक्षिणे ।\nवामतो वामदेवस्य चागमत्कृष्णमुत्तमम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7002964103, "chapter_id": 22964, "verse_number": "२-११-१०४", "content_sanskrit": "परमानन्दयुक्तं च परमानन्दरूपकम् ।\nसर्वं कृष्णमयं धाता चापश्यद्रासमण्डले ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7002964104, "chapter_id": 22964, "verse_number": "२-११-१०५", "content_sanskrit": "सर्वं समानवेषं च सभानासनसंस्थितम् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7002964105, "chapter_id": 22964, "verse_number": "२-११-१०६", "content_sanskrit": "द्विभुजं मुरलीहस्तं वनमालाविभूषितम् ।\nमयूरपुच्छचूडं च कौस्तुभेन विराजितम् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7002964106, "chapter_id": 22964, "verse_number": "२-११-१०७", "content_sanskrit": "अतीव कमनीयं च सुन्दरं शान्तविग्रहम् ।\nगुणभूषणरूपेण तेजसा वयसा त्विषा ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7002964107, "chapter_id": 22964, "verse_number": "२-११-१०८", "content_sanskrit": "वाससा यशसाऽऽकृत्या मूर्त्या सुन्दरया समम् ।\nपरिपूर्णतमं सर्वं सर्वैश्वर्य्यसमन्वितम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7002964108, "chapter_id": 22964, "verse_number": "२-११-१०९", "content_sanskrit": "कः सेव्यस्सेवको वेति दृष्ट्वा निर्वक्तुमक्षमः ।\nक्षणं तेजः स्वरूपं च रूपराशियुतं क्षणम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7002964109, "chapter_id": 22964, "verse_number": "२-११-११०", "content_sanskrit": "एकमेव क्षणं कृष्णं राधया सहितं परम् ।\nप्रत्येकासनसंस्थं च तया च सहितं क्षणम् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7002964110, "chapter_id": 22964, "verse_number": "२-११-१११", "content_sanskrit": "राधारूपधरं कृष्णं कृष्णरूपकलत्रकम् ।\nकिं स्त्रीरूपं च पुंरूपं विधाता ध्यातुमक्षमः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7002964111, "chapter_id": 22964, "verse_number": "२-११-११२", "content_sanskrit": "हृत्पद्मस्थं च श्रीकृष्णं धाता ध्यानेन चेतसा ।\nचकार स्तवनं भक्त्या प्रणम्याथ त्वनेकधा ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7002964112, "chapter_id": 22964, "verse_number": "२-११-११३", "content_sanskrit": "ततः स चक्षुरुन्मील्य पुनश्च तदनुज्ञया ।\nअपश्यत्कृष्णमेकं च राधावक्षस्थलस्थितम् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7002964113, "chapter_id": 22964, "verse_number": "२-११-११४", "content_sanskrit": "स्वपार्षदैः परिवृतं गोपीमण्डलमण्डितम् ।\nपुनः प्रणेमुस्तं दृष्ट्वा तुष्टुवुश्च पुनश्च ते ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7002964114, "chapter_id": 22964, "verse_number": "२-११-११५", "content_sanskrit": "विज्ञाय तदभिप्रायं तानुवाच सुरेश्वरः ।\nसर्वात्मा सर्वयज्ञेशः सर्वेशः सर्वभावनः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7002964115, "chapter_id": 22964, "verse_number": "२-११-११६", "content_sanskrit": "श्रीभगवानुवाच ।\nआगच्छ कुशलं ब्रह्मन्नागच्छ कमलापते ।\nइहागच्छ महादेव शश्वत्कुशलमस्तु वः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7002964116, "chapter_id": 22964, "verse_number": "२-११-११७", "content_sanskrit": "आगताः स्थ महाभागा गङ्गानयनकारणात् ।\nगंगा मच्चरणत्म्भोजे भयेन शरणं गता ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7002964117, "chapter_id": 22964, "verse_number": "२-११-११८", "content_sanskrit": "राधेमां पातुमिच्छन्ती दृष्ट्वा मत्सन्निधानतः ।\nदास्यामीमां बहिः कृत्वा यूयं कुरुत निर्भयाम् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7002964118, "chapter_id": 22964, "verse_number": "२-११-११९", "content_sanskrit": "श्रीकृष्णस्य वचः श्रुत्वा सस्मितः कमलोद्भवः ।\nतुष्टाव सर्वाराध्यां तां राधां श्रीकृष्णपूजिताम् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7002964119, "chapter_id": 22964, "verse_number": "२-११-१२०", "content_sanskrit": "वक्त्रैश्चतुर्भिः संस्तूय भक्तिनम्रात्मकन्धरः ।\nधाता चतुर्णां वेदानामुवाच चतुराननः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7002964120, "chapter_id": 22964, "verse_number": "२-११-१२१", "content_sanskrit": "गङ्गा त्वदङ्गसम्भूता प्रभोर्वै रासमण्डले ।\nद्रवरूपा च सा जाता मुग्धया शङ्करस्वरात् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7002964121, "chapter_id": 22964, "verse_number": "२-११-१२२", "content_sanskrit": "कृष्णांशा च त्वदंशा च त्वत्कन्यासदृशी प्रिया ।\nतन्मन्त्रग्रहणं कृत्वा करोतु तव पूजनम् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7002964122, "chapter_id": 22964, "verse_number": "२-११-१२३", "content_sanskrit": "भविष्यति पतिस्तस्या वैकुण्ठे च चतुर्भुजः ।\nभूगतायाः कलायाश्च लवणोदश्च वारिधिः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7002964123, "chapter_id": 22964, "verse_number": "२-११-१२४", "content_sanskrit": "गोलोकस्था च या राधा सर्वत्रस्था तथात्मिका ।\nतदात्मिका त्वं देवेशि सर्वदा च तवात्मजा ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7002964124, "chapter_id": 22964, "verse_number": "२-११-१२५", "content_sanskrit": "ब्रह्मणो वचनं श्रुत्वा स्वीचकार च सस्मिता ।\nबहिर्बभूव सा कृष्णपादाङ्गुष्ठनखाग्रतः ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7002964125, "chapter_id": 22964, "verse_number": "२-११-१२६", "content_sanskrit": "तत्रैव संवृता शान्ता तस्थौ तेषां च मध्यतः ।\nउवास तोयादुत्थाय तदधिष्ठातृदेवता ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7002964126, "chapter_id": 22964, "verse_number": "२-११-१२७", "content_sanskrit": "तत्तोयं ब्रह्मणा किञ्चित्स्थापितं च कमण्डलौ ।\nकिंचिद्दधार शिरसि चन्द्रार्द्धे चन्द्रशेखरः ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7002964127, "chapter_id": 22964, "verse_number": "२-११-१२८", "content_sanskrit": "गङ्गायै राधिकामन्त्रं प्रददौ कमलोद्भवः ।\nतत्स्तोत्रं कवचं पूजाविधानं ध्यानमेव च ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7002964128, "chapter_id": 22964, "verse_number": "२-११-१२९", "content_sanskrit": "सर्वं तत्सामवेदोक्तं पुरश्चर्य्याक्रमं तथा ।\nगङ्गा तामेव संपूज्य वैकुण्ठं प्रययौ सती ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7002964129, "chapter_id": 22964, "verse_number": "२-११-१३०", "content_sanskrit": "लक्ष्मीः सरस्वती गंगा तुलसी विश्वपावनी ।\nएता नारायणस्यैव चतस्रो योषितो मुने ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7002964130, "chapter_id": 22964, "verse_number": "२-११-१३१", "content_sanskrit": "अथ तं सस्मितः कृष्णो ब्रह्माणं समुवाच ह ।\nसर्वकालस्य वृत्तान्तं दुर्बोध्यमविपश्चिताम् ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7002964131, "chapter_id": 22964, "verse_number": "२-११-१३२", "content_sanskrit": "श्रीकृष्ण उवाच ।\nगृहाण गंगां हे ब्रह्मन् हे विष्णो हे महेश्वर ।\nशृणु कालस्य वृत्तान्तं यदतीतं निशामय ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7002964132, "chapter_id": 22964, "verse_number": "२-११-१३३", "content_sanskrit": "यूयं च येऽन्यदेवाश्च मुनयो मनवस्तथा ।\nसिद्धास्तपस्विनश्चैव ये येऽत्रैव समागताः ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7002964133, "chapter_id": 22964, "verse_number": "२-११-१३४", "content_sanskrit": "ते ते जीवन्ति गोलोके कालचक्र विवर्जिते ।\nजलाप्लुतं सर्वविश्वमागतं प्राकृते लये ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7002964134, "chapter_id": 22964, "verse_number": "२-११-१३५", "content_sanskrit": "ब्रह्माद्या येऽन्यविश्वस्थास्ते लीना अधुना मयि ।\nवैकुण्ठं च विना सर्वं सजलं पश्य पद्मज ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7002964135, "chapter_id": 22964, "verse_number": "२-११-१३६", "content_sanskrit": "गत्वा सृष्टिं कुरु पुनर्ब्रह्मलोकादिकं परम् ।\nसब्रह्माण्डं विरचय पश्चाद्गङ्गा च यास्यति ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7002964136, "chapter_id": 22964, "verse_number": "२-११-१३७", "content_sanskrit": "एवमन्येषु विश्वेषु सृष्ट्वा ब्रह्मादिकं पुनः ।\nकरोम्यहं पुनः सृष्टिं गच्छ शीघ्रं सुरैः सह ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7002964137, "chapter_id": 22964, "verse_number": "२-११-१३८", "content_sanskrit": "मच्चक्षुषोर्निमेषेण ब्रह्मणः पतनं भवेत् ।\nगताः कतिविधास्ते च भविष्यन्ति च वेधसः ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7002964138, "chapter_id": 22964, "verse_number": "२-११-१३९", "content_sanskrit": "इत्युक्त्वा राधिकानाथो जगामान्तःपुरं मुने ।\nदेवा गत्वा पुनः सृष्टिं चक्रुरेव प्रयत्नतः ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7002964139, "chapter_id": 22964, "verse_number": "२-११-१४०", "content_sanskrit": "गोलोके च स्थिता गंगा वैकुण्ठे शिवलोकके ।\nब्रह्मलोके तथाऽन्यत्र यत्र तत्र पुरा स्थिता ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7002964140, "chapter_id": 22964, "verse_number": "२-११-१४१", "content_sanskrit": "तत्रैव सा गता गंगा चाज्ञया परमात्मनः ।\nनिर्गता विष्णुपादाब्जात्तेन विष्णुपदी स्मृता ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7002964141, "chapter_id": 22964, "verse_number": "२-११-१४२", "content_sanskrit": "इत्येवं कथितं सर्वं गंगोपाख्यानमुत्तमम् ।\nसुखदं मोक्षदं सारं किं भूयः श्रोतुमिच्छसि ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}]