[{"id": 7003708000, "chapter_id": 23708, "verse_number": "१-४-१६-१", "content_sanskrit": "ब्रह्मोवाच ।\nदेवदेव तवैश्वर्यं केन शक्येत वेदितुम् ।\nविना भायैक्यसुलभं भवदीयमनुग्रहम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003708001, "chapter_id": 23708, "verse_number": "१-४-१६-२", "content_sanskrit": "अकर्तृकाणि वाक्यानि ऐश्वर्यं ते निरत्ययम् ।\nन स्तोतुं शक्यते किं तु नमस्कुर्वंति दूरतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003708002, "chapter_id": 23708, "verse_number": "१-४-१६-३", "content_sanskrit": "को विष्णुः कोऽहमेते वा दिक्पाला वासवादयः ।\nत्वमेव देव कर्त्तासि जगत्सृजनरक्षयोः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003708003, "chapter_id": 23708, "verse_number": "१-४-१६-४", "content_sanskrit": "पतिस्त्वं पार्वतीनाथ पशवो वयमप्यमी ।\nबद्धं पाशेन मोक्तुं वा त्वमेवास्मान्प्रगल्भसे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003708004, "chapter_id": 23708, "verse_number": "१-४-१६-५", "content_sanskrit": "षड्विंशत्तत्त्वरूपस्त्वमभितश्चाभिवर्त्तसे ।\nकोविदः को विनिर्णेतुं तव याथात्म्यमीश्वरः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003708005, "chapter_id": 23708, "verse_number": "१-४-१६-६", "content_sanskrit": "किरातः किल देवस्त्वं सारमेयैः किलागमैः ।\nषड्वर्गहिंस्रान्संहर्तुं करोष्याखेटकौतुकम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003708006, "chapter_id": 23708, "verse_number": "१-४-१६-७", "content_sanskrit": "देव दक्षाध्वरे पूर्वं वरिभद्रस्त्वदाज्ञया ।\nकांकां शिक्षामकार्षीन्न इति कापि विडम्बना ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003708007, "chapter_id": 23708, "verse_number": "१-४-१६-८", "content_sanskrit": "तव कालाग्निरूपस्य सर्वब्रह्मांडदाहिनः ।\nपोषणात्पुष्पचापस्य प्रायो जिह्वेति शेमुषी ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003708008, "chapter_id": 23708, "verse_number": "१-४-१६-९", "content_sanskrit": "कृतापराधः शूलेन त्वया दीर्णो जलंधरः ।\nअन्तकोंधकदैत्यश्च प्रतिवीरश्च कोऽस्ति ते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003708009, "chapter_id": 23708, "verse_number": "१-४-१६-१०", "content_sanskrit": "अधारयिष्यत्कण्ठेन कालकूटं न चेद्भवान् ।\nकथं च धारयिष्यामो वयं सर्वेऽपि जीवितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003708010, "chapter_id": 23708, "verse_number": "१-४-१६-११", "content_sanskrit": "देवदारुवने पूर्वं मुनीन्केवलकर्मठान् ।\nप्रक्षोभ्य धूर्तवेषस्त्वं दययान्वग्रहीस्तथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003708011, "chapter_id": 23708, "verse_number": "१-४-१६-१२", "content_sanskrit": "अंघ्रिणाक्रांतवान्नो चेदत्युग्रां त्वमपस्मृतिम् ।\nतयाक्रांतमिदं कृत्स्नमंधकारायते जगत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003708012, "chapter_id": 23708, "verse_number": "१-४-१६-१३", "content_sanskrit": "अर्धनारीश्वरं रूपं त्वया चेन्न प्रकाशितम् ।\nप्रभवामि कथं स्रष्टुं जगदेतच्चराचरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003708013, "chapter_id": 23708, "verse_number": "१-४-१६-१४", "content_sanskrit": "भवता स्तंभितः शम्भो संरंभाज्जंभजिद्भुजः ।\nकियंतं हंत कालं ते जयस्तंभ इव स्थितः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003708014, "chapter_id": 23708, "verse_number": "१-४-१६-१५", "content_sanskrit": "भिक्षोः कपालमापूर्य रुधिरेणात्मनो हरिः ।\nशूलेनोत्क्षिप्य मुमुहे ह्येतत्त्वमवधारय ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003708015, "chapter_id": 23708, "verse_number": "१-४-१६-१६", "content_sanskrit": "न चेदशिक्षयः सर्वशस्त्रास्त्राण्यनुकंपया ।\nनिर्वापयेत्कथं वैरं क्रुद्धोपि जमदग्निभूः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003708016, "chapter_id": 23708, "verse_number": "१-४-१६-१७", "content_sanskrit": "नृहरिं शरभाकारः समहार्षीन्न चेद्भवान् ।\nस एव संहरेद्विश्वं हिरण्यकशिपोरपि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003708017, "chapter_id": 23708, "verse_number": "१-४-१६-१८", "content_sanskrit": "त्वमाचकृक्षः कल्पाब्धौ कैवर्त्तो मत्स्यकच्छपौ ।\nहरिं बद्ध्वाहिराट्सूत्रैर्नृसिंहमथ सूकरम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003708018, "chapter_id": 23708, "verse_number": "१-४-१६-१९", "content_sanskrit": "एकोने पद्मसाहस्रे स्वनेत्रेण कृतार्चनम् ।\nशूलिन्सुदर्शनं दत्त्वा दैत्यद्विषमतूतुपः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003708019, "chapter_id": 23708, "verse_number": "१-४-१६-२०", "content_sanskrit": "नंदिकेश्वर उवाच ।\nस्तुत्यैवमस्य विष्णोश्च प्रार्थनेन प्रसेदिवान् ।\nधूर्जटिः सृष्टिकर्तृत्वं पुनरस्याभ्यमन्यत ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003708020, "chapter_id": 23708, "verse_number": "१-४-१६-२१", "content_sanskrit": "समंज्यासु द्विजानां च पूजनं चानुशिष्टवान् ।\nउभावप्यब्रवीदेतौ वात्सल्याच्चद्रशेखरः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003708021, "chapter_id": 23708, "verse_number": "१-४-१६-२२", "content_sanskrit": "श्रीशिव उवाच ।\nवत्सौ युवां न ज्ञात्वैवं भूयो भवतमुद्धतौ ।\nगुरुं स्मरतो मामेव जाग्रतं सृष्टिरक्षयोः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003708022, "chapter_id": 23708, "verse_number": "१-४-१६-२३", "content_sanskrit": "इह प्रदेशे युवयोर्यन्मयानुग्रहः कृतः ।\nपुण्यक्षेत्रमिदं पुंसां ततो मोक्षाय कल्पताम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003708023, "chapter_id": 23708, "verse_number": "१-४-१६-२४", "content_sanskrit": "योजनत्रयमात्रेऽस्मिन्क्षेत्रे निवसतां नृणाम् ।\nदीक्षादिकं विनाप्यस्तु मत्सायुज्यं ममाज्ञया ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003708024, "chapter_id": 23708, "verse_number": "१-४-१६-२५", "content_sanskrit": "यद्वा तिरश्चामप्यत्र स्थावराणां च देहिनाम् ।\nअबुद्धिपूर्विका बुद्धिरपवर्गस्य जायताम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003708025, "chapter_id": 23708, "verse_number": "१-४-१६-२६", "content_sanskrit": "नृणां च दर्शनाद्दूरे कैवल्यं स्मरणेन वा ।\nअस्तु वेदांतविज्ञानं न साध्यं निष्प्रयासतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003708026, "chapter_id": 23708, "verse_number": "१-४-१६-२७", "content_sanskrit": "शुभाय तैजसी मूर्तिः स्थावरा मम शाश्वती ।\nअरुणाद्रिरिति ख्याता नित्यमेवात्र वर्त्तताम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003708027, "chapter_id": 23708, "verse_number": "१-४-१६-२८", "content_sanskrit": "युगात्ययेपि नैनं तु मज्जयेयुर्महाब्धयः ।\nन चालयेयुर्मरुतो न दहेयुश्च वह्नयः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003708028, "chapter_id": 23708, "verse_number": "१-४-१६-२९", "content_sanskrit": "ज्योतिर्मयमिदं लिंगं ज्योतिःष्वपि न जातुचित् ।\nक्रमंता निर्गमागत्या खेचराणि समंततः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003708029, "chapter_id": 23708, "verse_number": "१-४-१६-३०", "content_sanskrit": "यस्यानुग्रहमिच्छामि जंतो्तस्यात्र संभवः ।\nदेहांते कल्पतां मुक्त्यै विनौपनिषदीर्गिरः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003708030, "chapter_id": 23708, "verse_number": "१-४-१६-३१", "content_sanskrit": "एष दूरात्प्रणामेन निकर्षाच्च प्रदक्षिणात् ।\nअपि पापात्मनां पुंसामस्तु निश्रेयसप्रदः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003708031, "chapter_id": 23708, "verse_number": "१-४-१६-३२", "content_sanskrit": "अत्रैव नियतं वासाः संभवंति महात्मनाम् ।\nतस्मात्स्थलमिदं हित्वा न गंतव्यं कदाचन ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003708032, "chapter_id": 23708, "verse_number": "१-४-१६-३३", "content_sanskrit": "शोणाचलमनादृत्य क्वचित्स्थित्वापि मुक्तये ।\nतस्माद्युवां विधिहरी वसतं चात्र नित्यशः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003708033, "chapter_id": 23708, "verse_number": "१-४-१६-३४", "content_sanskrit": "नंदिकेश्वर उवाच ।\nइत्युक्तवंतं कामारिं प्रणम्य विधिमाधवौ ।\nतौ व्यज्ञापयतां देवं दूरीभवदहंक्रियौ ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003708034, "chapter_id": 23708, "verse_number": "१-४-१६-३५", "content_sanskrit": "विधिमाधवावूचतुः ।\nएवमेतज्जगदाधार जगदाधारतां गतः ।\nआस्तां गिरिरसौ किं तु तेजो ह्यस्य सुदुस्सहम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003708035, "chapter_id": 23708, "verse_number": "१-४-१६-३६", "content_sanskrit": "अतोयमुत्तमो रुद्र तेजः सामान्यशैलवत् ।\nतिष्ठत्वभेद्यमहिमा निश्रेयसमहाखनिः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003708036, "chapter_id": 23708, "verse_number": "१-४-१६-३७", "content_sanskrit": "विवृणोति निजं ज्योतिर्विश्वस्यास्य समृद्धये ।\nप्रत्यब्दं कार्त्तिके मासि कृत्तिकासु दिनात्यये ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003708037, "chapter_id": 23708, "verse_number": "१-४-१६-३८", "content_sanskrit": "शर्मदोपि नृणां देव शोणाद्रिस्तव शासनात् ।\nमहत्त्वादर्चितुं शक्यो न स्याद्भक्तस्य कस्यचित् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003708038, "chapter_id": 23708, "verse_number": "१-४-१६-३९", "content_sanskrit": "एतस्योपत्यकायां तदद्यारभ्यास्मदर्थनात् ।\nदेवेन सन्निधातव्यमवन्यां लिंगरूपिणा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003708039, "chapter_id": 23708, "verse_number": "१-४-१६-४०", "content_sanskrit": "तच्चारुणगिरीशानमावामाराधयावहे ।\nअभिषेकानुलेपाद्यैरुपचारैर्यथाविधि ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003708040, "chapter_id": 23708, "verse_number": "१-४-१६-४१", "content_sanskrit": "संत्यत्र केशराश्चूता नागपुंनागकेसराः ।\nआरग्वधाः कुरबका मालूराः पाटला अपि ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003708041, "chapter_id": 23708, "verse_number": "१-४-१६-४२", "content_sanskrit": "अत्रैव सन्निधातव्यं देवदेव दयानिधे ।\nयतस्त्वद्भक्तिदार्ढ्यं नौ भवतात्त्वदुपासनात् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003708042, "chapter_id": 23708, "verse_number": "१-४-१६-४३", "content_sanskrit": "नान्यथा चित्तशुद्धिर्न्नौ देवेऽप्येवं प्रसेदुषि ।\nअनाद्यविद्यावृतये यो भविष्यति नित्यशः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003708043, "chapter_id": 23708, "verse_number": "१-४-१६-४४", "content_sanskrit": "शोणाद्रेः पूर्वदिग्भागे स एष भृशमुन्नतः ।\nस एवालं निवासाय देवस्य हृदयंगमः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003708044, "chapter_id": 23708, "verse_number": "१-४-१६-४५", "content_sanskrit": "सांगवेदा धर्मशास्त्रं पुराणानि शिवागमाः ।\nकृत्वा च सकलाः प्रोक्ता भवतैव भवावयोः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003708045, "chapter_id": 23708, "verse_number": "१-४-१६-४६", "content_sanskrit": "निश्रेयसाय भक्तानां त्वयैव गुरुरूपिणा ।\nअष्टाविंशतिराख्याता आगमाः शैवसंज्ञिताः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003708046, "chapter_id": 23708, "verse_number": "१-४-१६-४७", "content_sanskrit": "तेषु कस्य प्रकारेण कुर्वाणौ त्वदुपासनाम् ।\nकदाप्यज्ञानजामार्तिं नाधिगच्छाव शंकर ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003708047, "chapter_id": 23708, "verse_number": "१-४-१६-४८", "content_sanskrit": "नंदिकेश्वर उवाच ।\nइति तौ धातृगोविंदौ पादपद्मावलंबिनौ ।\nजगाद करुणामूर्त्तिर्जगतीभृत्सुतापतिः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003708048, "chapter_id": 23708, "verse_number": "१-४-१६-४९", "content_sanskrit": "श्रीमहादेव उवाच ।\nयुक्तमुक्तमिदं भद्रौ मयाप्येवं मनीषितम् ।\nकामिकोक्तेन मार्गेण मामर्चयितुमर्हथः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003708049, "chapter_id": 23708, "verse_number": "१-४-१६-५०", "content_sanskrit": "मोहतो विस्मृता मन्ये भवद्भ्यां शैवसंहिता ।\nअधुना मत्प्रसादेन पुनरुद्भासतां हृदि ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003708050, "chapter_id": 23708, "verse_number": "१-४-१६-५१", "content_sanskrit": "नन्दीश उवाच ।\nइत्युक्त्वा श्रीशवागीशौ गिरिशोऽन्तरधादथ ।\nतदा प्रादुरभूत्तत्र लिंगं किमपि मंगलम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003708051, "chapter_id": 23708, "verse_number": "१-४-१६-५२", "content_sanskrit": "तच्चावलोक्य साश्चर्य्यौ मुकुन्दकमलासनौ ।\nमुहुः प्रणम्य सानंदं प्रार्च्य तुष्टुवतुश्चिरम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003708052, "chapter_id": 23708, "verse_number": "१-४-१६-५३", "content_sanskrit": "तावकारयतां शोणगिरिनाथस्य चालयम् ।\nनानाशिल्पाद्भुतं विश्वकर्मणा प्रचयेन च ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003708053, "chapter_id": 23708, "verse_number": "१-४-१६-५४", "content_sanskrit": "खानयामासतुस्तत्र सरः किमपि पावनम् ।\nअभिषेकाय देवस्य सर्वतीर्थमयं नवम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003708054, "chapter_id": 23708, "verse_number": "१-४-१६-५५", "content_sanskrit": "अरुणाख्यं पुरं चारात्कल्पयामासतुश्चिरम् ।\nसिद्ध्यै नोत्कंठते लब्ध्वा कैलासायापि धूर्जटिः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003708055, "chapter_id": 23708, "verse_number": "१-४-१६-५६", "content_sanskrit": "तस्यां ब्रह्मर्षयो देवा गंधर्वा दिव्ययोषितः ।\nसिद्धविद्याधरा यक्षाः पौरत्वं समुपाययुः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003708056, "chapter_id": 23708, "verse_number": "१-४-१६-५७", "content_sanskrit": "तीर्थानि धार्य कूपत्वं गंगाद्याः सरितस्तथा ।\nनंदनादीनि च वनान्यभवन्निष्कुटत्वतः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003708057, "chapter_id": 23708, "verse_number": "१-४-१६-५८", "content_sanskrit": "गोलोको गोगोष्ठतया नैगमत्वं किलागमाः ।\nशैलाश्च गोपुरादित्वं स्मृतयो विधितां ययुः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003708058, "chapter_id": 23708, "verse_number": "१-४-१६-५९", "content_sanskrit": "भूताः प्रेताः पिशाचाश्च वेतालाः कटपूतनाः ।\nप्रपन्ना मानुषं देहं तस्यां किल पृथग्जनाः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003708059, "chapter_id": 23708, "verse_number": "१-४-१६-६०", "content_sanskrit": "देवोपि धूर्जटिस्तस्यां कौतुकी सिद्धरूपधृक् ।\nयोगित्वं समुपास्थाय मात्राकौपीनमुण्डधृक् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003708060, "chapter_id": 23708, "verse_number": "१-४-१६-६१", "content_sanskrit": "न केनचिदविज्ञातः सदा सर्वत्र दीप्यति ।\nतौ च केशवलोकेशौ जटिलौ भस्मगुण्ठितौ ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003708061, "chapter_id": 23708, "verse_number": "१-४-१६-६२", "content_sanskrit": "दांतौ शोणाद्रिनाथं तमर्चयामासतुश्चिरम् ।\nतत्रत्यानां च सर्वेषां वर्णानामानुगुण्यतः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003708062, "chapter_id": 23708, "verse_number": "१-४-१६-६३", "content_sanskrit": "दीक्षादिकानि चक्राते स्वयमाचार्यतां गतौ ।\nक्रमेण हृतनिर्माल्यौ सर्वागमरहोविदौ ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003708063, "chapter_id": 23708, "verse_number": "१-४-१६-६४", "content_sanskrit": "प्रातः स्नात्वा समाहृत्य पुष्पपत्रादिकं फलम् ।\nमंत्रं चारुणनाथस्य तत एव रहः श्रुतम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003708064, "chapter_id": 23708, "verse_number": "१-४-१६-६५", "content_sanskrit": "जंजल्पाकौ जजपतुः सर्वमंत्राधिकं सदा ।\nधूपप्रदीपनैवेद्यैर्गीतवादित्रनर्तनैः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003708065, "chapter_id": 23708, "verse_number": "१-४-१६-६६", "content_sanskrit": "प्रदक्षिणानमस्कारैर्मुद्राबंधैर्नवैर्नवैः ।\nआसनेन च मूर्त्त्या च मूलेन च यथाविधि ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003708066, "chapter_id": 23708, "verse_number": "१-४-१६-६७", "content_sanskrit": "पंचब्रह्मषडंगाद्यैरर्चयामासतुः शिवम् ।\nएवं वर्षसहस्राणि षोडशारुणशंकरम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003708067, "chapter_id": 23708, "verse_number": "१-४-१६-६८", "content_sanskrit": "वेधोविष्णू समाराध्य शिवज्ञानमवापतुः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003708068, "chapter_id": 23708, "verse_number": "१-४-१६-६९", "content_sanskrit": "इतीदमश्रावि मया रहस्यं पितुः शिलादस्य मुखात्पुरा यत् ।\nनिवेदितं चाद्य तदेव तुभ्यं किमन्यदाकर्णयितुं मनीषा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]