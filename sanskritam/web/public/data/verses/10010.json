[{"id": 6000010000, "chapter_id": 10010, "verse_number": null, "content_sanskrit": "अथ दशमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000010001, "chapter_id": 10010, "verse_number": null, "content_sanskrit": "शौनक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.001.m4a", "display_order": 2}, {"id": 6000010002, "chapter_id": 10010, "verse_number": "१-१०-१", "content_sanskrit": "हत्वा स्वरिक्‍थस्पृध आततायिनो युधिष्‍ठिरो धर्मभृतां गवि स्थितः।\nसहानुजैः प्रत्यवरुद्धभोजनः कथं प्रवृत्तः किमकार्षीत्ततः॥ १/१०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.002.m4a", "display_order": 3, "topics": [{"text": "श्रीकृष्णस्य हस्तिनापुरवासः", "range": "१–८"}]}, {"id": 6000010003, "chapter_id": 10010, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.003.m4a", "display_order": 4}, {"id": 6000010004, "chapter_id": 10010, "verse_number": "१-१०-२", "content_sanskrit": "वंशं कुरोर्वंशदवाग्निनिर्हृतं संरोहयित्वा भवतापनो हरिः।\nनिवेशयित्वा निजराज्य ईश्‍वरो युधिष्‍ठिरं प्रीतमना बभूव ह॥ १/१०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.004.m4a", "display_order": 5}, {"id": 6000010005, "chapter_id": 10010, "verse_number": "१-१०-३", "content_sanskrit": "याजयित्वाऽश्‍वमेधैस्तान् त्रिभिरुत्तमकल्पकैः।\nतद्यशः पावनं दिक्षु शतमन्योरिवातनोत्॥ १/१०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.005.m4a", "display_order": 6}, {"id": 6000010006, "chapter_id": 10010, "verse_number": "१-१०-४", "content_sanskrit": "निशम्य भीष्मोक्‍तमथाच्युतोदितं प्रवृत्तिविज्ञानविधूतविभ्रमः।\nशशास गामिन्द्र इवाजिताश्रयः प्रणिध्युपात्तामनुजानुवर्तितः॥ १/१०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.006.m4a", "display_order": 7}, {"id": 6000010007, "chapter_id": 10010, "verse_number": "१-१०-५", "content_sanskrit": "कामं ववर्ष पर्जन्यः सर्वकामदुघा मही।\nसिषिचुः स्म व्रजं गावः पयसाऽत्यूधसो मुदा॥ १/१०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.007.m4a", "display_order": 8}, {"id": 6000010008, "chapter_id": 10010, "verse_number": "१-१०-६", "content_sanskrit": "नद्यः समुद्रा गिरयः सवनस्पतिवीरुधः।\nफलन्त्योषधयः सर्वाः काममन्वर्तु तस्य वै॥ १/१०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.008.m4a", "display_order": 9}, {"id": 6000010009, "chapter_id": 10010, "verse_number": "१-१०-७", "content_sanskrit": "नाधयो व्याधयः क्लेशाः दैवभूतात्महेतवः।\nअजातशत्रावभवन् जन्तूनां राज्ञि कर्हिचित्॥ १/१०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.009.m4a", "display_order": 10}, {"id": 6000010010, "chapter_id": 10010, "verse_number": "१-१०-८", "content_sanskrit": "उषित्वा हस्तिनपुरे मासान्कतिपयान्हरिः।\nसुहृदां ‍च विशोकाय स्वसुश्‍च प्रियकाम्यया॥ १/१०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.010.m4a", "display_order": 11}, {"id": 6000010011, "chapter_id": 10010, "verse_number": "१-१०-९", "content_sanskrit": "आमन्त्र्य चाभ्यनुज्ञातः परिष्वज्याभिवाद्य तम्।\nआरुरोह रथं कैश्‍चित्परिष्वक्‍तोऽभिवादितः॥ १/१०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.011.m4a", "display_order": 12, "topics": [{"text": "श्रीकृष्णस्य द्वारकां प्रति प्रस्थानम्", "range": "९–२१"}]}, {"id": 6000010012, "chapter_id": 10010, "verse_number": "१-१०-१०", "content_sanskrit": "सुभद्रा द्रौपदी कुन्ती विदुरोऽथ युधिष्‍ठिरः।\nगन्धारी धृतराष्‍ट्रश्‍च युयुत्सुर्गौतमो यमौ॥ १/१०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.012.m4a", "display_order": 13}, {"id": 6000010013, "chapter_id": 10010, "verse_number": "१-१०-११", "content_sanskrit": "वृकोदरश्‍च धौम्यश्‍च स्‍त्रियो मत्स्यसुतादयः।\nन सेहिरे विमुह्यन्तो विरहं शार्ङ्गधन्वनः॥ १/१०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.013.m4a", "display_order": 14}, {"id": 6000010014, "chapter_id": 10010, "verse_number": "१-१०-१२", "content_sanskrit": "तत्सङ्गान्मुक्‍तदुःसङ्गो हातुं नोत्सहते बुधः।\nकीर्त्यमानं यशो यस्य सकृदाकर्ण्य रोचनम्॥ १/१०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.014.m4a", "display_order": 15}, {"id": 6000010015, "chapter_id": 10010, "verse_number": "१-१०-१३", "content_sanskrit": "तस्याभ्यस्तधियः पार्थाः सहेरन्विरहं कथम्।\nदर्शनस्पर्शनालापशयनासनभोजनैः॥ १/१०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.015.m4a", "display_order": 16}, {"id": 6000010016, "chapter_id": 10010, "verse_number": "१-१०-१४", "content_sanskrit": "सर्वे तेऽनिमिषैरक्षैस्तमनुद्रुतचेतसः।\nवीक्षन्तः स्नेहसंबन्धाद्विचेरुस्तत्र तत्र ह॥ १/१०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.016.m4a", "display_order": 17}, {"id": 6000010017, "chapter_id": 10010, "verse_number": "१-१०-१५", "content_sanskrit": "न्यरुन्धन्नुद्गलद्बाष्पमौत्कण्ठ्याद्देवकीसुते।\nनिर्यात्यगारान्नाभद्रमिति स्याद्बान्धवस्‍त्रियः॥ १/१०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.017.m4a", "display_order": 18}, {"id": 6000010018, "chapter_id": 10010, "verse_number": "१-१०-१६", "content_sanskrit": "मृदङ्गशङ्खभेर्यश्‍च वीणापणवगोमुखाः।\nधुन्धुर्यानकघण्टाद्याः नेदुर्दुन्दुभयस्तथा॥ १/१०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.018.m4a", "display_order": 19}, {"id": 6000010019, "chapter_id": 10010, "verse_number": "१-१०-१७", "content_sanskrit": "प्रासादशिखरारूढाः कुरुनार्यो दिदृक्षवः।\nववृषुः कुसुमैः कृष्णे प्रेमव्रीडस्मितेक्षणाः॥ १/१०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.019.m4a", "display_order": 20}, {"id": 6000010020, "chapter_id": 10010, "verse_number": "१-१०-१८", "content_sanskrit": "सितातपत्रं जग्राह मुक्‍तादामविभूषितम्।\nरत्नदण्डं गुडाकेशः प्रियः प्रियतमस्य ह॥ १/१०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.020.m4a", "display_order": 21}, {"id": 6000010021, "chapter_id": 10010, "verse_number": "१-१०-१९", "content_sanskrit": "उद्धवः सात्यकिश्‍चैव व्यजने परमाद्भुते।\nविकीर्यमाणः कुसुमै रेजे मधुपतिः पथि॥ १/१०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.021.m4a", "display_order": 22}, {"id": 6000010022, "chapter_id": 10010, "verse_number": "१-१०-२०", "content_sanskrit": "अश्रूयन्ताशिषः सत्यास्तत्र तत्र द्विजेरिताः।\nनानुरूपानुरूपाश्‍च निर्गुणस्य गुणात्मनः॥ १/१०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.022.m4a", "display_order": 23}, {"id": 6000010023, "chapter_id": 10010, "verse_number": "१-१०-२१", "content_sanskrit": "अन्योन्यमासीत्सञ्जल्प उत्तमश्लोकचेतसाम्।\nकौरवेन्द्रपुरस्‍त्रीणां सर्वश्रुतिमनोहरः॥ १/१०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.023.m4a", "display_order": 24}, {"id": 6000010024, "chapter_id": 10010, "verse_number": null, "content_sanskrit": "स्‍त्रिय ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.024.m4a", "display_order": 25}, {"id": 6000010025, "chapter_id": 10010, "verse_number": "१-१०-२२", "content_sanskrit": "स वै किलायं पुरुषः पुरातनो य एक आसीदविशेष आत्मनि।\nअग्रे गुणेभ्यो जगदात्मनीश्‍वरे निमीलितात्मा निशि सुप्‍तशक्‍तिषु॥ १/१०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.025.m4a", "display_order": 26, "topics": [{"text": "स्‍त्रीभिः कृता श्रीकृष्णस्तुतिः", "range": "२२–३१"}]}, {"id": 6000010026, "chapter_id": 10010, "verse_number": "१-१०-२३", "content_sanskrit": "स एव भूयो निजवीर्यचोदितां स्वजीवमायां प्रकृतिं सिसृक्षतीम्।\nअनामरूपात्मनि रूपनामनी विधित्समानोऽनुससार शास्तिकृत्॥ १/१०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.026.m4a", "display_order": 27}, {"id": 6000010027, "chapter_id": 10010, "verse_number": "१-१०-२४", "content_sanskrit": "स वा अयं यत्पदमत्र सूरयो जितेन्द्रिया निर्जितमातरिश्‍वनः।\nपश्यन्ति भक्‍त्युत्कलितामलात्मना नत्वेष सत्त्वं परिमार्ष्‍टुमर्हति॥ १/१०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.027.m4a", "display_order": 28}, {"id": 6000010028, "chapter_id": 10010, "verse_number": "१-१०-२५", "content_sanskrit": "स वा अयं सख्यनुगीतसत्कथो वेदेषु गुह्येषु च वेदवादिभिः।\nय एक ईशो जगदात्मलीलया सृजत्यवत्यत्ति न तत्र सज्जते॥ १/१०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.028.m4a", "display_order": 29}, {"id": 6000010029, "chapter_id": 10010, "verse_number": "१-१०-२६", "content_sanskrit": "यदा ह्यधर्मेण तमोऽधिका नृपा जीवन्ति तत्रैष हि सात्वतः किल।\nधर्मं भगं सत्यमृतं दयां यशो भवाय रूपाणि दधद्युगे युगे॥ १/१०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.029.m4a", "display_order": 30}, {"id": 6000010030, "chapter_id": 10010, "verse_number": "१-१०-२७", "content_sanskrit": "अहो अलं श्लाघ्यतमं यदोः कुलं त्वहो अलं पुण्यतमं मधोर्वनम्।\nयदेष पुंसामृषभः प्रियश्रवाः स्वजन्मना चङ्क्रमणेन चाञ्चति॥ १/१०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.030.m4a", "display_order": 31}, {"id": 6000010031, "chapter_id": 10010, "verse_number": "१-१०-२८", "content_sanskrit": "अहो बत स्वर्यशसस्तिरस्करी कुशस्थली पुण्ययशस्करी भुवः।\nपश्यन्ति नित्यं यदनुग्रहेक्षितस्मितावलोकं स्वपतिं स्म यत्प्रजाः॥ १/१०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.031.m4a", "display_order": 32}, {"id": 6000010032, "chapter_id": 10010, "verse_number": "१-१०-२९", "content_sanskrit": "नूनं व्रतस्नानहुतादिनेश्‍वरः समर्चितो ह्यस्य गृहीतपाणिभिः।\nपिबन्ति याः सख्यधरामृतं मुहुर्व्रजस्‍त्रियः सम्मुमुहुर्यदाशया॥ १/१०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.032.m4a", "display_order": 33}, {"id": 6000010033, "chapter_id": 10010, "verse_number": "१-१०-३०", "content_sanskrit": "या वीर्यशुल्केन हृताः स्वयंवरे प्रमथ्य चैद्यप्रमुखान्विशुष्मिणः।\nप्रद्युम्नसाम्बप्रमुखात्मजाः परा याश्‍च हृता भौमवधे सहस्रशः॥ १/१०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.033.m4a", "display_order": 34}, {"id": 6000010034, "chapter_id": 10010, "verse_number": "१-१०-३१", "content_sanskrit": "एताः पुरा स्‍त्रीत्वमवाप्‍तये समं निरस्तशोकं बत साधु कुर्वते।\nयासां गृहात्पुष्करलोचनः पतिः न जात्वपैत्याकृतिभिर्हृदि स्पृशन्॥ १/१०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.034.m4a", "display_order": 35}, {"id": 6000010035, "chapter_id": 10010, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.035.m4a", "display_order": 36}, {"id": 6000010036, "chapter_id": 10010, "verse_number": "१-१०-३२", "content_sanskrit": "एवंविधा गदन्तीनां स गिरः पुण्ययोषिताम्।\nनिरीक्षणेनाभिनन्दन्सस्मितेन ययौ हरिः॥ १/१०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.036.m4a", "display_order": 37, "topics": [{"text": "सायाह्ने कृष्णस्य आनर्तदेशागमनम्", "range": "३२–३८"}]}, {"id": 6000010037, "chapter_id": 10010, "verse_number": "१-१०-३३", "content_sanskrit": "अजातशत्रुः पृतनां गोपीथाय मधुद्विषः।\nपरेभ्यः शङ्कितः स्नेहात् प्रायुङ्क्त चतुरङ्गिणीम्॥ १/१०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.037.m4a", "display_order": 38}, {"id": 6000010038, "chapter_id": 10010, "verse_number": "१-१०-३४", "content_sanskrit": "अथ दूरागताञ्शौरिः कौरवान्विदुरान्वितान्।\nसन्निवर्त्य दृढं स्निग्धान्प्रायात्स्वनगरीं प्रियैः॥ १/१०/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.038.m4a", "display_order": 39}, {"id": 6000010039, "chapter_id": 10010, "verse_number": "१-१०-३५", "content_sanskrit": "कुरुजाङ्गलपाञ्चालान् शूरसेनान् सयामुनान्।\nब्रह्मावर्तं कुरुक्षेत्रं मत्स्यान्सारस्वतानथ॥ १/१०/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.039.m4a", "display_order": 40}, {"id": 6000010040, "chapter_id": 10010, "verse_number": "१-१०-३६", "content_sanskrit": "मरुधन्वमतिक्रम्य सौवीराभीरसैन्धवान्।\nआनर्तान्भार्गवोपागाच्छ्रान्तवाहो मनाग्विभुः॥ १/१०/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.040.m4a", "display_order": 41}, {"id": 6000010041, "chapter_id": 10010, "verse_number": "१-१०-३७", "content_sanskrit": "तत्र तत्र च तत्रत्यैर्हरिः प्रत्युद्यतार्हणः।\nसायं भेजे दिशं पश्‍चाद्गविष्‍ठो गां गतस्तदा॥ १/१०/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.041.m4a", "display_order": 42}, {"id": 6000010042, "chapter_id": 10010, "verse_number": "१-१०-३८", "content_sanskrit": "आनर्तान्स उपव्रज्य स्वृद्धाञ्जनपदान्स्वकान्।\nदध्मौ दरवरं तेषां विषादं शमयन्निव॥ १/१०/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.042.m4a", "display_order": 43}, {"id": 6000010043, "chapter_id": 10010, "verse_number": "१-१०-३९", "content_sanskrit": "स उच्चकाशे धवलोदरो दरोऽप्युरुक्रमस्याधरशोणशोणिमा।\nदाध्मायमानः करकञ्जसम्पुटे यथाऽब्जषण्डे कलहंस उत्स्वनः॥ १/१०/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.043.m4a", "display_order": 44, "topics": [{"text": "श्रीकृष्णस्य स्तोत्रपूर्वकं स्वागतम्, द्वारकाप्रवेशः", "range": "३९–६७"}]}, {"id": 6000010044, "chapter_id": 10010, "verse_number": "१-१०-४०", "content_sanskrit": "तमुपश्रुत्य निनदं जगद्भवभयापहम्।\nप्रत्युद्ययुः प्रजाः सर्वा भर्तुर्दर्शनलालसाः॥ १/१०/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.044.m4a", "display_order": 45}, {"id": 6000010045, "chapter_id": 10010, "verse_number": "१-१०-४१", "content_sanskrit": "नत्वोपनीतबलयो रवेर्दीपमिवादृताः।\nआत्मारामं पूर्णकामं निजलाभेन नित्यदा॥ १/१०/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.045.m4a", "display_order": 46}, {"id": 6000010046, "chapter_id": 10010, "verse_number": "१-१०-४२", "content_sanskrit": "प्रीत्युत्फुल्‍लमुखाः प्रोचुर्हर्षगद्गदया गिरा।\nपितरं सर्वसुहृदमवितारमिवार्भकाः॥ १/१०/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.046.m4a", "display_order": 47}, {"id": 6000010047, "chapter_id": 10010, "verse_number": "१-१०-४३", "content_sanskrit": "नताः स्म हे नाथ सदाङ्घ्रिपङ्कजं विरिञ्चवैरिञ्चसुरेन्द्रवन्दितम्।\nपरायणं क्षेममिहेच्छतां परं न यत्र कालः प्रभवेत्परप्रभुः॥ १/१०/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.047.m4a", "display_order": 48}, {"id": 6000010048, "chapter_id": 10010, "verse_number": "१-१०-४४", "content_sanskrit": "भवाय नस्त्वं भव विश्‍वभावन त्वमेव माताऽऽत्मसुहृत्पिता पतिः।\nत्वं सद्गुरुर्नः परमं ‍च दैवतं यस्यानुवृत्त्या कृतिनो बभूविम॥ १/१०/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.048.m4a", "display_order": 49}, {"id": 6000010049, "chapter_id": 10010, "verse_number": "१-१०-४५", "content_sanskrit": "अहो सनाथा भवता स्म यद्वयं त्रैविष्‍टपानामपि दूरदर्शनम्।\nप्रेमस्मितस्निग्धनिरीक्षणाननं पश्येम रूपं तव सर्वसौभगम्॥ १/१०/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.049.m4a", "display_order": 50}, {"id": 6000010050, "chapter_id": 10010, "verse_number": "१-१०-४६", "content_sanskrit": "यर्ह्यम्बुजाक्षाञ्चति माधवो भवान् कुरून् मधून् वाऽथ सुहृद्दिदृक्षया।\nतत्राब्दकोटिप्रतिमः क्षणो भवेद्रविं विनाऽक्ष्णामिव नस्तवाच्युत॥ १/१०/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.050.m4a", "display_order": 51}, {"id": 6000010051, "chapter_id": 10010, "verse_number": "१-१०-४७", "content_sanskrit": "इति चोदीरिता वाचः प्रजानां भक्‍तवत्सलः।\nशृण्वानोऽनुग्रहं दृष्‍ट्या वितन्वन्प्राविशत्पुरीम्॥ १/१०/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.051.m4a", "display_order": 52}, {"id": 6000010052, "chapter_id": 10010, "verse_number": "१-१०-४८", "content_sanskrit": "मधुभोजदशार्हार्हकुकुरान्धकवृष्णिभिः।\nआत्मतुल्यबलैर्गुप्‍तां नागैर्भोगवतीमिव॥ १/१०/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.052.m4a", "display_order": 53}, {"id": 6000010053, "chapter_id": 10010, "verse_number": "१-१०-४९", "content_sanskrit": "सर्वर्तुसर्वविभवैः पुण्यवृक्षलताश्रमैः।\nउद्यानोपवनारामैर्धृतपद्माकरश्रियम्॥ १/१०/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.053.m4a", "display_order": 54}, {"id": 6000010054, "chapter_id": 10010, "verse_number": "१-१०-५०", "content_sanskrit": "गोपुरद्वारमार्गेषु कृतकौतुकतोरणाम्।\nचित्रध्वजपताकाग्रैरन्तःप्रतिहतातपाम्॥ १/१०/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.054.m4a", "display_order": 55}, {"id": 6000010055, "chapter_id": 10010, "verse_number": "१-१०-५१", "content_sanskrit": "सम्मार्जितमहामार्गरथ्यापणकचत्वराम्।\nसिक्‍तां गन्धजलैरुप्‍तां फलपुष्पाक्षताङ्कुरैः॥ १/१०/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.055.m4a", "display_order": 56}, {"id": 6000010056, "chapter_id": 10010, "verse_number": "१-१०-५२", "content_sanskrit": "द्वारि द्वारि गृहाणां ‍च दध्यक्षतफलेक्षुभिः।\nअलङ्कृतां पूर्णकुम्भैर्बलिभिर्धूपदीपकैः॥ १/१०/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.056.m4a", "display_order": 57}, {"id": 6000010057, "chapter_id": 10010, "verse_number": "१-१०-५३", "content_sanskrit": "निशम्य कृष्णमायान्तं वसुदेवो महामनाः।\nअक्रूरश्‍चोग्रसेनश्‍च रामश्‍चाद्भुतविक्रमः॥ १/१०/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.057.m4a", "display_order": 58}, {"id": 6000010058, "chapter_id": 10010, "verse_number": "१-१०-५४", "content_sanskrit": "प्रद्युम्नाश्‍चारुदेष्णश्‍च साम्बो जाम्बवतीसुतः।\nप्रहर्षवेगोच्छ्वसितशयनासनभोजनाः॥ १/१०/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.058.m4a", "display_order": 59}, {"id": 6000010059, "chapter_id": 10010, "verse_number": "१-१०-५५", "content_sanskrit": "वारणेन्द्रं पुरस्कृत्य ब्राह्मणैः ससुमङ्गलैः। शङ्खतूर्यनिनादेन ब्रह्मघोषेण चादृताः।\nप्रत्युज्‍जग्मू रथैर्हृष्‍टाः प्रणयागतसाध्वसाः॥ १/१०/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.059.m4a", "display_order": 60}, {"id": 6000010060, "chapter_id": 10010, "verse_number": "१-१०-५६", "content_sanskrit": "वारमुख्याश्‍च शतशो यानैस्तद्दर्शनोत्सुकाः।\nचलत्कुण्डलनिर्भातकपोलवदनश्रियः॥ १/१०/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.060.m4a", "display_order": 61}, {"id": 6000010061, "chapter_id": 10010, "verse_number": "१-१०-५७", "content_sanskrit": "नटनर्तकगन्धर्वाः सूतमागधबन्दिनः।\nगायन्ति चोत्तमश्लोकचरितान्यद्भुतानि च॥ १/१०/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.061.m4a", "display_order": 62}, {"id": 6000010062, "chapter_id": 10010, "verse_number": "१-१०-५८", "content_sanskrit": "भगवांस्तत्र बन्धूनां पौराणामनुवर्तिनाम्।\nयथाविध्युपसङ्गम्य सर्वेषां मानमादधे॥ १/१०/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.062.m4a", "display_order": 63}, {"id": 6000010063, "chapter_id": 10010, "verse_number": "१-१०-५९", "content_sanskrit": "प्रह्वाभिवन्दनाश्लेषकरस्पर्शस्मितेक्षणैः।\nआश्‍वस्य आ श्‍वपाकेभ्यः वरैश्‍चाभिमतैर्विभुः॥ १/१०/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.063.m4a", "display_order": 64}, {"id": 6000010064, "chapter_id": 10010, "verse_number": "१-१०-६०", "content_sanskrit": "स्वयं ‍च गुरुभिर्विप्रैस्सदारैः स्थविरैरपि।\nआशीर्भिर्युज्यमानोऽन्यैर्बन्धुभिश्‍चाविशत्पुरम्॥ १/१०/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.064.m4a", "display_order": 65}, {"id": 6000010065, "chapter_id": 10010, "verse_number": "१-१०-६१", "content_sanskrit": "राजमार्गं गते कृष्णे द्वारकायाः कुलस्‍त्रियः।\nहर्म्याण्यारुरुहुर्विप्रास्तदीक्षणमहोत्सवाः॥ १/१०/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.065.m4a", "display_order": 66}, {"id": 6000010066, "chapter_id": 10010, "verse_number": "१-१०-६२", "content_sanskrit": "नित्यं निरीक्षमाणानां यद्यपि द्वारकौकसाम्।\nन वितृप्यन्ति हि दृशः श्रियो धामाङ्गमच्युतम्॥ १/१०/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.066.m4a", "display_order": 67}, {"id": 6000010067, "chapter_id": 10010, "verse_number": "१-१०-६३", "content_sanskrit": "श्रियो निवासो यस्योरः पानपात्रं मुखं दृशाम्।\nबाहवो लोकापालानां सारङ्गाणां पदाम्बुजम्॥ १/१०/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.067.m4a", "display_order": 68}, {"id": 6000010068, "chapter_id": 10010, "verse_number": "१-१०-६४", "content_sanskrit": "सितातपत्रव्यजनैरुपस्कृतः प्रसूनवर्षैरभिवर्षितः पथि।\nपिशङ्गवासा वनमालया बभौ घनो यथाऽर्कोडुपचापवैद्युतैः॥ १/१०/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.068.m4a", "display_order": 69}, {"id": 6000010069, "chapter_id": 10010, "verse_number": "१-१०-६५", "content_sanskrit": "प्रविष्‍टस्तु गृहं पित्रोः परिष्वक्‍तः स्वमातृभिः।\nववन्दे शिरसा सप्‍त देवकीप्रमुखा मुदा॥ १/१०/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.069.m4a", "display_order": 70}, {"id": 6000010070, "chapter_id": 10010, "verse_number": "१-१०-६६", "content_sanskrit": "ताः पुत्रमङ्कमारोप्य स्नेहस्रुतपयोधराः।\nहर्षविह्वलितात्मानः सिषिचुर्नेत्रजैर्जलैः॥ १/१०/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.070.m4a", "display_order": 71}, {"id": 6000010071, "chapter_id": 10010, "verse_number": "१-१०-६७", "content_sanskrit": "अथाविशत्स्वभवनं सर्वकाममनुत्तमम्। प्रासादा यत्र पत्नीनां सहस्राणि च षोडश।\nशतमष्‍टोत्तरं चैव वज्रवैडूर्यमण्डिताः॥ १/१०/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.071.m4a", "display_order": 72}, {"id": 6000010072, "chapter_id": 10010, "verse_number": "१-१०-६८", "content_sanskrit": "पत्‍न्‍यः पतिं प्रोष्य गृहानुपागतं विलोक्य सञ्जातमनोमहोत्सवाः।\nउत्तस्थुरारात्सहसाऽऽसनाश्रयाः साकम्पितव्रीडितलोचनाननाः॥ १/१०/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.072.m4a", "display_order": 73, "topics": [{"text": "कृष्णपत्नीकृतस्वागतम्", "range": "६८–७६"}]}, {"id": 6000010073, "chapter_id": 10010, "verse_number": "१-१०-६९", "content_sanskrit": "तमात्मजैर्दृष्‍टिभिरन्तरात्मना दुरन्तभावाः परिरेभिरे पतिम्।\nनिरुद्धमप्यस्रवदम्बु नेत्रयोः विलज्जतीनां भृगुवर्य वैक्लवात्॥ १/१०/६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.073.m4a", "display_order": 74}, {"id": 6000010074, "chapter_id": 10010, "verse_number": "१-१०-७०", "content_sanskrit": "यद्यप्यसौ पार्श्वगतो रहोगतस्तासां तथाऽप्यङ्घ्रियुगं नवं नवम्।\nपदे पदे का विरमेत तत्पदाच्चलाऽपि यं श्रीर्न जहाति कर्हिचित्॥ १/१०/७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.074.m4a", "display_order": 75}, {"id": 6000010075, "chapter_id": 10010, "verse_number": "१-१०-७१", "content_sanskrit": "एवं नृपाणां क्षितिभारजन्मनामक्षौहिणीभिः परिवृत्ततेजसाम्।\nविधाय वैरं श्‍वसनो यथाऽनलं मिथो वधेनोपरतो निरायुधः॥ १/१०/७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.075.m4a", "display_order": 76}, {"id": 6000010076, "chapter_id": 10010, "verse_number": "१-१०-७२", "content_sanskrit": "स एष नरलोकेऽस्मिन्नवतीर्णः स्वमायया।\nरेमे स्‍त्रीरत्नकूटस्थो भगवान्प्राकृतो यथा॥ १/१०/७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.076.m4a", "display_order": 77}, {"id": 6000010077, "chapter_id": 10010, "verse_number": "१-१०-७३", "content_sanskrit": "उद्दामभावपिशुनामलवल्गुहासव्रीडावलोकविहतो मदनोऽपि यासाम्।\nसम्मुह्य चापमजहात् प्रमदोत्तमास्ता यस्येन्द्रियं विमथितुं कुहकैर्न शेकुः॥ १/१०/७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.077.m4a", "display_order": 78}, {"id": 6000010078, "chapter_id": 10010, "verse_number": "१-१०-७४", "content_sanskrit": "मन्यते तन्मयं लोको ह्यसङ्गमपि सङ्गिनम्।\nआत्मौपम्येन मनुजं प्रावृण्वानमतोऽबुधः॥ १/१०/७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.078.m4a", "display_order": 79}, {"id": 6000010079, "chapter_id": 10010, "verse_number": "१-१०-७५", "content_sanskrit": "यत्तदीशनमीशस्य प्रकृतिस्थोऽपि तद्गुणैः।\nन युज्यते सदात्मस्थैर्यथा बुद्धिस्तदाश्रया॥ १/१०/७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.079.m4a", "display_order": 80}, {"id": 6000010080, "chapter_id": 10010, "verse_number": "१-१०-७६", "content_sanskrit": "तं मेनिरे खला मूढास्‍त्रैणं ‍चानुव्रतं हरेः।\nअप्रमाणविदो भर्तुरीश्‍वरं मतयो यथा॥ १/१०/७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_010/BhP_01.010.080.m4a", "display_order": 81}, {"id": 6000010081, "chapter_id": 10010, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां प्रथमस्कन्धे दशमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]