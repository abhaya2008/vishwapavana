[{"id": 2051396, "chapter_id": 2130, "verse_number": "७-५७-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2051397, "chapter_id": 2130, "verse_number": "७-५७-१", "content_sanskrit": "अङ्गं च पौरवं वीरं मृतं सृञ्जय शुश्रुम।\nसहस्रं यः सहस्राणां श्वेतानश्वानवासृजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2051398, "chapter_id": 2130, "verse_number": "७-५७-२", "content_sanskrit": "तस्याश्वमेधे राजर्षेर्देशाद्देशात्समीयुषाम्।\nशिक्षाक्षरविधिज्ञानां नासीत्सङ्ख्या विपश्चिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2051399, "chapter_id": 2130, "verse_number": "७-५७-३", "content_sanskrit": "वेदविद्याव्रतस्नाता वदान्याः प्रियदर्शनाः।\nसुभिक्षाच्छादनगृहाः सुशय्यासनभोजनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2051400, "chapter_id": 2130, "verse_number": "७-५७-४", "content_sanskrit": "नटनर्तकगन्धर्वैः पूर्णकैर्वर्धमानकैः।\nनित्योद्योगैश्च क्रीडद्भिस्तत्र स्म परिहर्षिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2051401, "chapter_id": 2130, "verse_number": "७-५७-५", "content_sanskrit": "यज्ञे यज्ञे यथाकालं दक्षिणाः सोऽत्यकालयत्।\nद्विपान्दशसहस्राख्यानदात्काञ्चनसंवृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2051402, "chapter_id": 2130, "verse_number": "७-५७-६", "content_sanskrit": "यः सहस्रं सहस्राणि कन्या हेमविभूषिताः॥\nधूर्युजाश्वगजारूढाः सगृहक्षेत्रगोशताः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2051403, "chapter_id": 2130, "verse_number": "७-५७-७", "content_sanskrit": "शतं शतसहस्राणि स्वर्णमालानथर्षभान्॥\nगवां सहस्रानुचरान्दक्षिणामत्यकालयत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2051404, "chapter_id": 2130, "verse_number": "७-५७-८", "content_sanskrit": "हेमशृङ्ग्यो रौप्यखुराः सवत्साः कांस्यदोहनाः॥\nदासीदासखरोष्ट्रांश्च प्रादादाजाविकं बहु।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2051405, "chapter_id": 2130, "verse_number": "७-५७-९", "content_sanskrit": "रत्नानां विविधानां च विविधांश्चान्नपर्वतान्॥\nतस्मिन्संवितते यज्ञे दक्षिणामत्यकालयत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2051406, "chapter_id": 2130, "verse_number": "७-५७-१०", "content_sanskrit": "तत्रास्य गाथा गायन्ति ये पुराणविदो जनाः॥\n`अङ्गस्य यजमानस्य अपि विष्णुपदे वयम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2051407, "chapter_id": 2130, "verse_number": "७-५७-११", "content_sanskrit": "अमाद्यदिन्द्रुः सोमेन दक्षिणाभिर्द्विजातयः।\nदेवमानुषगन्धर्वांश्चात्यरोचन्त दक्षिणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2051408, "chapter_id": 2130, "verse_number": "७-५७-१२", "content_sanskrit": "अङ्गस्य यजमानस्य स्वधर्माधिगताः शुभाः।\nगुणोत्तरास्तु क्रतवस्तस्यासन्सार्वकामिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2051409, "chapter_id": 2130, "verse_number": "७-५७-१३", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतस्त्वया।\nपुत्रात्पुण्यतरस्तुभ्यं मा पुत्रमनुतप्यथाः।\nअयज्वानमदक्षिण्यमभि श्वैत्येत्युदाहरत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2051410, "chapter_id": 2130, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि अभिमन्युवधपर्वणि षोडशराजकीये सप्तपञ्चाशत्तमोऽध्यायः॥ ५७ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-५७-२ राजर्षेः सर्वे देवाः समाययुः इति ढ.पाठः॥ ५-५७-४ पूर्णकैः स्वर्णचूडैः। वर्धमानकैः आरार्तिकहस्तैः॥ ५-५७-७ धूर्युजा रथाः॥ ५-५७-५७ सप्तपञ्चाशत्तमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]