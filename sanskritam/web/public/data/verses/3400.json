[{"id": 2110956, "chapter_id": 3400, "verse_number": "", "content_sanskrit": "अष्टकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2110957, "chapter_id": 3400, "verse_number": "१", "content_sanskrit": "तथा वसन् नन्दने कामरूपी\nसंवत्सराणामयुतं शतानाम् ।\nकिं कारणं कार्तयुगप्रधान\nहित्वा त्वं तद् येन धरां प्रपन्नः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2110958, "chapter_id": 3400, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2110959, "chapter_id": 3400, "verse_number": "२", "content_sanskrit": "सम्बन्धिनो ज्ञातिसुहृज्जनाश्च\nक्षीणे वित्ते सन्त्यजन्तीह मर्त्यम् ।\nतथा चैनं क्षीणपुण्यं मनुष्यं\nत्यजन्ति सद्यः सेश्वरा देवसङ्घाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2110960, "chapter_id": 3400, "verse_number": "", "content_sanskrit": "अष्टकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2110961, "chapter_id": 3400, "verse_number": "३", "content_sanskrit": "कथं तत्र क्षीणपुण्या भवन्ति\nसम्मुह्यते मेऽत्र मनोऽतिमात्रम् ।\nके वा शिष्टाः कस्य धामोपयान्ति\nतन्मे ब्रूहि क्षेत्रवित् त्वं मतो मे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2110962, "chapter_id": 3400, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2110963, "chapter_id": 3400, "verse_number": "४", "content_sanskrit": "इमं भौमं नरकं ते पतन्ति\nलालप्यमाना नरदेव सर्वे ।\nते कङ्कगोमायुबलाशनार्थं\nक्षीणे पुण्ये बहुधा प्रव्रजन्ति\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2110964, "chapter_id": 3400, "verse_number": "५", "content_sanskrit": "तस्मादेतद् वर्जनीयं नरेण\nदुष्टं लोके गर्हणीयं च कर्म ।\nआख्यातं ते पार्थिव सर्वमेतद्\nभूयश्चेदानीं वद किं ते वदामि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2110965, "chapter_id": 3400, "verse_number": "", "content_sanskrit": "अष्टकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2110966, "chapter_id": 3400, "verse_number": "६", "content_sanskrit": "यदा समन्तात् पतितान् तुदन्ति\nवयांसि गृध्राः पिशिताशनाश्च ।\nकथं भवन्ति कतमा भवन्ति\nन भौममन्तर्नरकं शृणोमि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2110967, "chapter_id": 3400, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2110968, "chapter_id": 3400, "verse_number": "७", "content_sanskrit": "ऊर्ध्वं देहात् प्राणिनो जृम्भमाणा\nव्यक्तं पृथिव्यामिह सञ्चरन्तः ।\nइमं भौमं नरकं ते पतन्ति\nनावेक्षन्ते वर्षपूगाननेकान् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2110969, "chapter_id": 3400, "verse_number": "८", "content_sanskrit": "षष्टिं सहस्राणि पतन्ति व्योम्नः\nतथाऽशीतिं परिवत्सराणि ।\nतान् वै तुदन्ति पततः प्रपाते\nभीमा भौमा राक्षसास्तीक्ष्णदंष्ट्राः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2110970, "chapter_id": 3400, "verse_number": "", "content_sanskrit": "अष्टकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2110971, "chapter_id": 3400, "verse_number": "९", "content_sanskrit": "यदैनसा ते पततस्तुदन्ति\nभीमा भौमा राक्षसास्तीक्ष्णदंष्ट्राः ।\nकथं भवन्ति कतमा भवन्ति\nकथम्भूता गर्भगता भवन्ति\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2110972, "chapter_id": 3400, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2110973, "chapter_id": 3400, "verse_number": "१०", "content_sanskrit": "असृग् रेतः पुष्पकालानुपृक्त-\nमन्वेति तावत् पुरुषेण सृष्टम् ।\nतच्चैतस्यां रज आपद्यते वै\nस गर्भभूतः समुपैति तत्र\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2110974, "chapter_id": 3400, "verse_number": "११", "content_sanskrit": "वनस्पतींश्चौषधीश्चाविशन्ति\nअपो वायुं पृथिवीं चान्तरिक्षम् ।\nचतुष्पदं द्विपदं चापि सर्व-\nमेवं भूता गर्भभूता भवन्ति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2110975, "chapter_id": 3400, "verse_number": "", "content_sanskrit": "अष्टकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2110976, "chapter_id": 3400, "verse_number": "१२", "content_sanskrit": "अन्यो हि वै निदधातीह गर्भ-\nमुताहोस्वित् स्वेन कामेन याति ।\nआपद्यमानो नरयोनिमेता-\nमाचक्ष्व मे संशयात् प्रब्रवीमि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2110977, "chapter_id": 3400, "verse_number": "१३", "content_sanskrit": "शरीरदेहादिसमुच्छ्रयं च\nचक्षुःश्रोत्रं लभते केन सञ्ज्ञाम् ।\nएतत् सर्वं तत्वमाचक्ष्व पृष्टः\nक्षेत्रज्ञं त्वां तात मन्याम सर्वे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2110978, "chapter_id": 3400, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2110979, "chapter_id": 3400, "verse_number": "१४", "content_sanskrit": "वायुः समुत्कर्षति गर्भयोनिम्\nऋतौ रेतः पुष्पकालानुपृक्तम् ।\nस तत्र तन्मात्रकृताधिकारः\nक्रमेण संवर्धयतीह गर्भम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2110980, "chapter_id": 3400, "verse_number": "१५", "content_sanskrit": "स जायमानो निगृहीतगात्रः\nप्रज्ञाननिष्ठायतनो मनुष्यः ।\nस श्रोत्राभ्यां वेदयतीह शब्दं\nस वै रूपं पश्यति चक्षुषा च\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2110981, "chapter_id": 3400, "verse_number": "१६", "content_sanskrit": "घ्राणेन गन्धं जिह्वया वै रसं च\nत्वचा स्पर्शं मनसा वेद भावम् ।\nइत्यष्टकैतान् विहितांश्च विद्धि\nमहात्मनः प्राणभृतः शरीरे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2110982, "chapter_id": 3400, "verse_number": "", "content_sanskrit": "अष्टकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2110983, "chapter_id": 3400, "verse_number": "१७", "content_sanskrit": "यः संस्थितः पुरुषो दह्यते वा\nनिखन्यते वा विनिकृष्यते वा ।\nअभावभूतः स विनाशमेत्य\nकेनात्मानं चेतयते परस्तात् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2110984, "chapter_id": 3400, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2110985, "chapter_id": 3400, "verse_number": "१८", "content_sanskrit": "हित्वा सोऽसून् सुप्तवन्नष्टसञ्ज्ञः पुरोधाय सुकृतं दुष्कृतं च ।\nअन्यां योनिं पवमानानुसारी हित्वा देहं भजते राजसिंह\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2110986, "chapter_id": 3400, "verse_number": "१९", "content_sanskrit": "पुण्यां योनिं पुण्यकृतो भजन्ति\nपापां योनिं पापकृतो व्रजन्ति ।\nकीटाः पतङ्गाश्च भवन्ति पापा\nन मे विवक्षाऽस्ति महानुभाव\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2110987, "chapter_id": 3400, "verse_number": "२०", "content_sanskrit": "चतुष्पदा द्विपदाः षट्पदाश्च\nतथाभूता गर्भभूता भवन्ति ।\nआख्यातमेतन्निखिलेन सर्वं\nभूयस्तु किं पृच्छसि राजसिंह\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2110988, "chapter_id": 3400, "verse_number": "", "content_sanskrit": "अष्टकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2110989, "chapter_id": 3400, "verse_number": "२१", "content_sanskrit": "किंस्वित् कृत्वा लभते तात लोकान्\nमर्त्यः श्रेष्ठान् तपसा विद्यया च ।\nतन्मे पृष्टः शंस सर्वं यथाव-\nच्छुभाँल्लोकान् येन गच्छेत् क्रमेण \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2110990, "chapter_id": 3400, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2110991, "chapter_id": 3400, "verse_number": "२२", "content_sanskrit": "तपश्च दानं च शमो दमश्च\nह्रीरार्जवं सर्वभूतानुकम्पा ।\nस्वर्गस्य लोकस्य वदन्ति सन्तो\nद्वाराणि सप्तैव महान्ति पुंसाम् ।\nनश्यन्ति मानेन सदाऽभिभूताः\nपुंसः सदैवेति वदन्ति सन्तः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2110992, "chapter_id": 3400, "verse_number": "२३", "content_sanskrit": "अधीयानः पण्डितम्मन्यमानो\nयो विद्यया हन्ति यशः परेषाम् ।\nतस्यान्तवन्तश्च भवन्ति लोका\nन चास्य तद् ब्रह्म फलं ददाति\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2110993, "chapter_id": 3400, "verse_number": "२४", "content_sanskrit": "चत्वारि कर्माण्यभयङ्कराणि\nभयं प्रयच्छन्त्ययथाकृतानि ।\nमानाग्निहोत्रमुत मानमौनं\nमानेनाधीतमुत मानयज्ञः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2110994, "chapter_id": 3400, "verse_number": "२५", "content_sanskrit": "न मान्यमानो मुदमाददीत\nन सन्तापं प्राप्नुयाच्चावमानात् ।\nतं साधवः पूजयन्तीह लोके\nनासाधवः साधुबुद्धिं लभन्ते\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2110995, "chapter_id": 3400, "verse_number": "समाप्तिः", "content_sanskrit": "इति दद्यादिति यजेद् इत्यधीयीत मे व्रतम् ।\nइत्यस्मीति भयान्याहुस्तानि वर्ज्यानि नित्यशः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2110996, "chapter_id": 3400, "verse_number": "२७", "content_sanskrit": "ये चाश्रमान् वेदयन्ते पुराणाः\nमनीषिणो मनसा संविभक्तान् ।\nतन्निःश्रेयस्तैजसं देहमेत्य\nपरां शान्तिं प्राप्नुयुः प्रेत्य चेह\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2110997, "chapter_id": 3400, "verse_number": "२७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकोनाशीतितमोऽध्यायः ॥७९॥ ॥ सम्भवपर्वणि सप्तविंशोऽध्यायः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]