[{"id": 2143022, "chapter_id": 4083, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2143023, "chapter_id": 4083, "verse_number": "१", "content_sanskrit": "एवमुक्तः स भगवान् शच्या तां पुनरब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2143024, "chapter_id": 4083, "verse_number": "२", "content_sanskrit": "विक्रमस्य न कालोऽयं नहुषो बलवत्तरः ।\nविवर्धितश्च ऋषिभिर्हव्यैः कव्यैश्च भामिनि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2143025, "chapter_id": 4083, "verse_number": "३", "content_sanskrit": "नीतिमत्र विधास्यामि देवि तां कर्तुमर्हसि ।\nगुह्यमेतत् त्वया कार्यं नाख्यातव्यं शुचिस्मिते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2143026, "chapter_id": 4083, "verse_number": "४", "content_sanskrit": "गत्वा नहुषमेकान्ते ब्रवीहि च सुमध्यमे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2143027, "chapter_id": 4083, "verse_number": "५", "content_sanskrit": "ऋषियानेन दिव्येन मामुपैहि जगत्पते ।\nएवं तव वशे प्रीता भविष्यामीति तं वद\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2143028, "chapter_id": 4083, "verse_number": "६", "content_sanskrit": "इत्युक्ता देवराजेन पत्या सा कमलेक्षणा ।\nएवमस्त्वित्यथोक्त्वा तु जगाम नहुषं प्रति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2143029, "chapter_id": 4083, "verse_number": "७", "content_sanskrit": "नहुषस्तां ततो दृष्ट्वा सस्मितो वाक्यमब्रवीत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2143030, "chapter_id": 4083, "verse_number": "८", "content_sanskrit": "स्वागतं ते वरारोहे किं करोमि शुचिस्मिते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2143031, "chapter_id": 4083, "verse_number": "९", "content_sanskrit": "भक्तं मां भज कल्याणि किमिच्छसि मनस्विनि ।\nतव कल्याणि यत् कार्यं तत् करिष्ये सुमध्यमे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2143032, "chapter_id": 4083, "verse_number": "१०", "content_sanskrit": "न च व्रीडा त्वया कार्या सुश्रोणि मयि विश्वसेः ।\nसत्येन वै शपे देवि करिष्ये वचनं तव\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2143033, "chapter_id": 4083, "verse_number": "", "content_sanskrit": "इन्द्राणी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2143034, "chapter_id": 4083, "verse_number": "११", "content_sanskrit": "यो मे कृतस्त्वया कालस्तमाकाङ्क्षे जगत्पते ।\nततस्त्वमेव भर्ता मे भविष्यसि सुराधिप\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2143035, "chapter_id": 4083, "verse_number": "१२", "content_sanskrit": "कार्यं च हृदि मे यत्तद् देवराजावधारय ।\nवक्ष्यामि यदि मे राजन् प्रियमेतत् करिष्यसि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2143036, "chapter_id": 4083, "verse_number": "१३", "content_sanskrit": "वाक्यं प्रणयसंयुक्तं ततस्त्वं कर्तुमर्हसि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2143037, "chapter_id": 4083, "verse_number": "१४", "content_sanskrit": "इन्द्रस्य वाजिनो वाहा हस्तिनोऽथ रथास्तथा ।\nइच्छाम्यहमथापूर्वं वाहनं ते सुराधिप\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2143038, "chapter_id": 4083, "verse_number": "१५", "content_sanskrit": "यन्न विष्णोर्न रुद्रस्य नासुराणां न रक्षसाम् ।\nवहन्तु त्वां महाभागा ऋषयः सङ्गता विभो\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2143039, "chapter_id": 4083, "verse_number": "१६", "content_sanskrit": "सर्वे शिबिकया राजन् एतद्धि मम रोचते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2143040, "chapter_id": 4083, "verse_number": "१७", "content_sanskrit": "नासुरेषु न देवेषु तुल्यो भवितुमर्हसि ।\nसर्वेषां तेज आधत्स्व स्वेन वीर्येण दर्शनात्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2143041, "chapter_id": 4083, "verse_number": "१८", "content_sanskrit": "न ते प्रमुखतः स्थातुं कश्चिच्छक्नोति वीर्यवान्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2143042, "chapter_id": 4083, "verse_number": "१९", "content_sanskrit": "एवमुक्तश्च नहुषः प्राहृष्यत तदा किल ।\nउवाच वचनं चापि सुरेन्द्रस्तामनिन्दिताम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2143043, "chapter_id": 4083, "verse_number": "", "content_sanskrit": "नहुषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2143044, "chapter_id": 4083, "verse_number": "२०", "content_sanskrit": "अपूर्वं वाहनमिदं त्वयोक्तं वरवर्णिनि ।\nदृढं मे रुचिरं देवि त्वद्वशोऽस्मि वरानने\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2143045, "chapter_id": 4083, "verse_number": "२१", "content_sanskrit": "न ह्यल्पवीर्यो भवति यो वाहान् कुरुते मुनीन्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2143046, "chapter_id": 4083, "verse_number": "२२", "content_sanskrit": "अहं तपस्वी बलवान् भूतभव्यभवत्प्रभुः ।\nमयि क्रुद्धे जगन्न स्यान्मयि सर्वं प्रतिष्ठितम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2143047, "chapter_id": 4083, "verse_number": "२३", "content_sanskrit": "देवदानवगन्धर्वाः किन्नरोरगराक्षसाः ।\nन मे क्रुद्धस्य पर्याप्ताः सर्वलोकाः शुचिस्मिते\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2143048, "chapter_id": 4083, "verse_number": "२४", "content_sanskrit": "चक्षुषा यं प्रपश्यामि तस्य तेजो हराम्यहम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2143049, "chapter_id": 4083, "verse_number": "२५", "content_sanskrit": "अहमिन्द्रोऽस्मि देवानां लोकानां च महेश्वरः ।\nमयि हव्यं च कव्यं च लोकाश्चैव सनातनाः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2143050, "chapter_id": 4083, "verse_number": "२६", "content_sanskrit": "तस्मात् ते वचनं देवि करिष्यामि न संशयः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2143051, "chapter_id": 4083, "verse_number": "२७", "content_sanskrit": "सप्तर्षयो मां वक्ष्यन्ति सर्वे ब्रह्मर्षयस्तथा ।\nपश्य माहात्म्यमस्माकम् ऋद्धिं च वरवर्णिनि\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2143052, "chapter_id": 4083, "verse_number": "२८", "content_sanskrit": "हतौजसो मया सर्वे देवगन्धर्वदानवाः ।\nयद्यस्य तेजः पश्यामि तस्य तेजो हराम्यहम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2143053, "chapter_id": 4083, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2143054, "chapter_id": 4083, "verse_number": "२९", "content_sanskrit": "एवमुक्त्वा तु तां देवीं विसृज्य च वराननाम् ।\nअथ सञ्चिन्त्य नहुषो बलवीर्येण भारत\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2143055, "chapter_id": 4083, "verse_number": "३०", "content_sanskrit": "विसृज्य सुप्रतीकं च नागमैरावतं तथा ।\nहंसयुक्तं विमानं च हरियुक्तं तथा रथम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2143056, "chapter_id": 4083, "verse_number": "३१", "content_sanskrit": "स तु दर्पेण महता परिभूय महामुनीन् ।\nविमाने योजयित्वा स ऋषीन् नियममास्थितान्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2143057, "chapter_id": 4083, "verse_number": "३२", "content_sanskrit": "अब्रह्मण्यो बलोपेतो मत्तो वरमदेन च ।\nकामवृत्तः स दुष्टात्मा वाहयामास तान् ऋषीन्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2143058, "chapter_id": 4083, "verse_number": "३३", "content_sanskrit": "नहुषेण विसृष्टा सा बृहस्पतिमथाब्रवीत्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2143059, "chapter_id": 4083, "verse_number": "३४", "content_sanskrit": "समयोऽल्पावशेषो मे नहुषेण हि यः कृतः ।\nशक्रं मृगय शीघ्रं तं भक्तायाः कुरु मे दयाम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2143060, "chapter_id": 4083, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2143061, "chapter_id": 4083, "verse_number": "३५", "content_sanskrit": "बाढमित्येव भगवान् बृहस्पतिरुवाच ताम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2143062, "chapter_id": 4083, "verse_number": "३६", "content_sanskrit": "न भेतव्यं त्वया देवि नहुषाद् दुष्टचेतसः ।\nन ह्येष स्थास्यति चिरं गत एष नराधमः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2143063, "chapter_id": 4083, "verse_number": "३७", "content_sanskrit": "अधर्मज्ञो महर्षीणां वाहनाच्च हतः शुभे ।\nइष्टिं चाहं करिष्यामि विनाशायास्य दुर्मतेः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2143064, "chapter_id": 4083, "verse_number": "३८", "content_sanskrit": "शक्रं चाधिगमिष्यामि मा भैस्त्वं भद्रमस्तु ते\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2143065, "chapter_id": 4083, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2143066, "chapter_id": 4083, "verse_number": "३९", "content_sanskrit": "ततः प्रज्वाल्य विधिवत् जुहाव सघृतं हविः ।\nबृहस्पतिर्महातेजा देवराजोपलब्धये\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2143067, "chapter_id": 4083, "verse_number": "४०", "content_sanskrit": "तस्मात् स भगवान् देवः स्वयमेव हुताशनः ।\nस्त्रीवेषमद्भुतं कृत्वा सहसाऽन्तरधीयत\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2143068, "chapter_id": 4083, "verse_number": "४१", "content_sanskrit": "स दिशः प्रदिशश्चैव पर्वतांश्च वनानि च ।\nपृथिवीं चान्तरिक्षं च विचित्याथ मनोगतिः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2143069, "chapter_id": 4083, "verse_number": "४२", "content_sanskrit": "निमेषान्तरमात्रेण बृहस्पतिमुपागमत्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2143070, "chapter_id": 4083, "verse_number": "", "content_sanskrit": "अग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2143071, "chapter_id": 4083, "verse_number": "४३", "content_sanskrit": "बृहस्पते न पश्यामि देवराजमहं क्वचित् ।\nआपः शेषाः सदा चापः प्रवेष्टुं नोत्सहाम्यहम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2143072, "chapter_id": 4083, "verse_number": "४४", "content_sanskrit": "न मे तत्र गतिर्ब्रह्मन् किमन्यत् करवाणि ते\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2143073, "chapter_id": 4083, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2143074, "chapter_id": 4083, "verse_number": "४५", "content_sanskrit": "तमब्रवीद् देवगुरुरपो विश महाद्युते\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2143075, "chapter_id": 4083, "verse_number": "", "content_sanskrit": "अग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2143076, "chapter_id": 4083, "verse_number": "४६", "content_sanskrit": "नापः प्रवेष्टुं शक्ष्यामि क्षयो मेऽत्र भविष्यति ।\nशरणं त्वां प्रपन्नोऽस्मि स्वस्ति तेऽस्तु महाद्युते\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2143077, "chapter_id": 4083, "verse_number": "४७", "content_sanskrit": "अद्भ्योऽग्निर्ब्रह्मणः क्षत्रमश्मनो लोहमुत्थितम् ।\nतेषां सर्वत्रगं तेजः स्वासु योनिषु शाम्यति\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2143078, "chapter_id": 4083, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि पञ्चदशोऽध्यायः ॥१५॥ सेनोद्योगपर्वणि पञ्चदशोऽध्यायः ॥१५॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]