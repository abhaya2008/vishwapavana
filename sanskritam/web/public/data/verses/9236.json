[{"id": 40015893, "chapter_id": 9236, "verse_number": "1", "content_sanskrit": "भर्तारंनिहतंदृष्टवालक्ष्मणंचमहाबलम् । विललापभृशंसीताकरुणंशोककर्शिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40015894, "chapter_id": 9236, "verse_number": "2", "content_sanskrit": "ऊचुर्लक्षणिकायेमांपुत्रिण्यविधवेतिच । तेऽद्यसर्वेहतेरामेज्ञानिनोऽनृतवादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40015895, "chapter_id": 9236, "verse_number": "3", "content_sanskrit": "यज्वनोमहिषींयेमामूचुःपत्नींचसत्त्रिणः । तेऽद्यसर्वेहतेरामेज्ञानिनोऽनृतवादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40015896, "chapter_id": 9236, "verse_number": "4", "content_sanskrit": "ऊचुस्संश्रवणेयेमांद्विजाःकार्तान्तिकाश्शुभाम् । तेऽद्यसर्वेहतेरामेज्ञानिनोऽनृतवादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40015897, "chapter_id": 9236, "verse_number": "5", "content_sanskrit": "वीरपार्थिवपत्नीत्वांयेविदुर्भर्तृपूजिताम् । तेऽद्यसर्वेहतेरामेज्ञानिनोऽनृतवादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40015898, "chapter_id": 9236, "verse_number": "6", "content_sanskrit": "इमानिखलुपद्मानिपादयोर्यैःकुलस्त्रियः । अधिराज्येऽभिषिच्यन्तेनरेन्द्रैःपतिभिःसह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40015899, "chapter_id": 9236, "verse_number": "7", "content_sanskrit": "वैधव्यंयान्तियैर्नार्योऽलक्षणैर्भाग्यदुर्लभाः । नात्मनन्तानिपश्यामिपश्यन्तीहतलक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40015900, "chapter_id": 9236, "verse_number": "8", "content_sanskrit": "सत्यनामानिपद्मानिस्त्रीणामुक्तानिलक्षणैः । तान्यद्यनिहतेरामेवितथानिभवन्तिमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40015901, "chapter_id": 9236, "verse_number": "9", "content_sanskrit": "केशास्सूक्ष्मास्समानीलाभ्रुवौचासंहतेमम । वृत्तेचारोमकेजङ्घेदन्ताश्चाविरळामम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40015902, "chapter_id": 9236, "verse_number": "10", "content_sanskrit": "शङ्खेनेत्रेकरौपादौगुल्फावूरूचमेचितौ । अनुवृत्तनखास्स्निग्धास्समाश्चाङ्गुलयोमम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40015903, "chapter_id": 9236, "verse_number": "11", "content_sanskrit": "स्तनौचाविरळौमामकौमग्नचूचुकौ । मग्नाचोत्सङ्गिनीनाभःपार्श्वोरस्कंचमेचितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40015904, "chapter_id": 9236, "verse_number": "12", "content_sanskrit": "ममवर्णोमणिनिभोमृदून्यङ्गरुहाणिच । प्रतिष्ठितांद्वादशभिर्मामूचुश्शुभलक्षणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40015905, "chapter_id": 9236, "verse_number": "13", "content_sanskrit": "समग्रयवमच्छ्रिद्रपाणिपादंचवर्णवत् । मन्दस्मितेत्येवचमांकन्यालाक्षणिनोद्विजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40015906, "chapter_id": 9236, "verse_number": "14", "content_sanskrit": "आधिराज्येऽभिषेकोमेब्राह्मणैःपतिनासह । कृतान्तकुशलैरुक्तंतत्सर्वंवितथीकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40015907, "chapter_id": 9236, "verse_number": "15", "content_sanskrit": "शो