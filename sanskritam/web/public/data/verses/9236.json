॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40015915, "chapter_id": 9236, "verse_number": "23", "content_sanskrit": "कारणानिचवक्ष्यामिमहान्तिसदृशानिच । यथेमौजीवतोदेवीभ्रातरौरामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40015916, "chapter_id": 9236, "verse_number": "24", "content_sanskrit": "नहिकोपपरीतानिहर्षपर्युत्सुकानिच । भवन्तियुधियोधानांमुखानिनिहतेपतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40015917, "chapter_id": 9236, "verse_number": "25", "content_sanskrit": "इदंविमानंवैदेही पुष्पकंनामनामतः । दिव्यंत्वांदारयन्नैवंयद्येतौगतजीवितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40015918, "chapter_id": 9236, "verse_number": "26", "content_sanskrit": "हतवीरप्रधानाहिगतोत्साहानिरुद्यमा । सेनाभ्रमतिसङ् ख्येषुहतकर्णेवनौर्जले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40015919, "chapter_id": 9236, "verse_number": "27", "content_sanskrit": "इयंपुनरसम्भ्रान्तानिरुद्विग्नातरस्विनी । सेनारक्षतिकाकुत्स्थौमयाप्रीत्यानिवेदितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40015920, "chapter_id": 9236, "verse_number": "28", "content_sanskrit": "सात्वंभवसुविस्रब्धाअनुमानैस्सुखोदयैः । अहतौपश्यकाकुत्स्थौस्नेहादेतद्ब्र्रवीमिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40015921, "chapter_id": 9236, "verse_number": "29", "content_sanskrit": "अनृतंनोक्तपूर्वंमेनचवक्ष्येकदाचन । चारित्रसुखशीलत्वात् प्रविष्टाअसिमनःमम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40015922, "chapter_id": 9236, "verse_number": "30", "content_sanskrit": "नेमौशक्यारणेजेतुंसेन्द्रैरपिसुरासुरैः । तादृशंदर्शनंदृष्टवामयाचावेदितंतव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40015923, "chapter_id": 9236, "verse_number": "31", "content_sanskrit": "इदंचसुमहचचित्रंशरैःपश्यस्वमैथिलि । निस्संज्ञावप्युभावेतौनैवलक्ष्मीर्विमुञ्चति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40015924, "chapter_id": 9236, "verse_number": "32", "content_sanskrit": "प्रायेणगतसत्त्वानांपुरुषाणांगतायुषाम् । दृश्यमानेषुवक्त्रेषुपरंभवतिवैकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40015925, "chapter_id": 9236, "verse_number": "33", "content_sanskrit": "त्यजशोकंचमोहंचदुःखंचजनकात्मजे । रामलक्ष्मणयोरर्थेनाद्यशक्यमजीवितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40015926, "chapter_id": 9236, "verse_number": "34", "content_sanskrit": "शुत्वातुवचनंतस्याःसीतासुरसुतोपमा । कृताञ्जलिरुवाचेमामेवमस्त्वितिमैथिलि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40015927, "chapter_id": 9236, "verse_number": "35", "content_sanskrit": "विमानंपुष्पकंतत्तुसन्निवर्त्यमनोजवम् । दीनात्रिजटयासीतालङ्कामेवप्रवेशिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40015928, "chapter_id": 9236, "verse_number": "36", "content_sanskrit": "ततस्त्रिजटयासार्थंपुष्पकादवरुह्यसा । अशोकवनिकामेवराक्षसीभिःप्रवेशिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"i