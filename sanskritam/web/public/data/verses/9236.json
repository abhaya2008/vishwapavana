[{"id": 5000236000, "chapter_id": 9236, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000236001, "chapter_id": 9236, "verse_number": "३-४०-१", "content_sanskrit": "मारीचस्य तु तद् वाक्यं क्षमं युक्तं च रावणः।\nउक्तो न प्रतिजग्राह मर्तुकाम इवौषधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000236002, "chapter_id": 9236, "verse_number": "३-४०-२", "content_sanskrit": "तं पथ्यहितवक्तारं मारीचं राक्षसाधिपः।\nअब्रवीत् परुषं वाक्यमयुक्तं कालचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000236003, "chapter_id": 9236, "verse_number": "३-४०-३", "content_sanskrit": "दुष्कुलैतदयुक्तार्थं मारीच मयि कथ्यते।\nवाक्यं निष्फलमत्यर्थं बीजमुप्तमिवोषरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000236004, "chapter_id": 9236, "verse_number": "३-४०-४", "content_sanskrit": "त्वद्वाक्यैर्न तु मां शक्यं भेत्तुं रामस्य संयुगे।\nमूर्खस्य पापशीलस्य मानुषस्य विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000236005, "chapter_id": 9236, "verse_number": "३-४०-५", "content_sanskrit": "यस्त्यक्त्वा सुहृदो राज्यं मातरं पितरं तथा।\nस्त्रीवाक्यं प्राकृतं श्रुत्वा वनमेकपदे गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000236006, "chapter_id": 9236, "verse_number": "३-४०-६", "content_sanskrit": "अवश्यं तु मया तस्य संयुगे खरघातिनः।\nप्राणैः प्रियतरा सीता हर्तव्या तव संनिधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000236007, "chapter_id": 9236, "verse_number": "३-४०-७", "content_sanskrit": "एवं मे निश्चिता बुद्धिर्हृदि मारीच विद्यते।\nन व्यावर्तयितुं शक्या सेन्द्रैरपि सुरासुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000236008, "chapter_id": 9236, "verse_number": "३-४०-८", "content_sanskrit": "दोषं गुणं वा सम्पृष्टस्त्वमेवं वक्तुमर्हसि।\nअपायं वा उपायं वा कार्यस्यास्य विनिश्चये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000236009, "chapter_id": 9236, "verse_number": "३-४०-९", "content_sanskrit": "सम्पृष्टेन तु वक्तव्यं सचिवेन विपश्चिता।\nउद्यताञ्जलिना राज्ञो य इच्छेद् भूतिमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000236010, "chapter_id": 9236, "verse_number": "३-४०-१०", "content_sanskrit": "वाक्यमप्रतिकूलं तु मृदुपूर्वं शुभं हितम्।\nउपचारेण वक्तव्यो युक्तं च वसुधाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000236011, "chapter_id": 9236, "verse_number": "३-४०-११", "content_sanskrit": "सावमर्दं तु यद्वाक्यमथवा हितमुच्यते।\nनाभिनन्देत तद् राजा मानार्थी मानवर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000236012, "chapter_id": 9236, "verse_number": "३-४०-१२", "content_sanskrit": "पञ्च रूपाणि राजानो धारयन्त्यमितौजसः।\nअग्नेरिन्द्रस्य सोमस्य यमस्य वरुणस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000236013, "chapter_id": 9236, "verse_number": "३-४०-१३", "content_sanskrit": "औष्ण्यं तथा विक्रमं च सौम्यं दण्डं प्रसन्नताम्।\nधारयन्ति महात्मानो राजानः क्षणदाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000236014, "chapter_id": 9236, "verse_number": "३-४०-१४", "content_sanskrit": "तस्मात् सर्वास्ववस्थासु मान्याः पूज्याश्च नित्यदा।\nत्वं तु धर्ममविज्ञाय केवलं मोहमाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000236015, "chapter_id": 9236, "verse_number": "३-४०-१५", "content_sanskrit": "अभ्यागतं तु दौरात्म्यात् परुषं वदसीदृशम्।\nगुणदोषौ न पृच्छामि क्षेमं चात्मनि राक्षस ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000236016, "chapter_id": 9236, "verse_number": "३-४०-१६", "content_sanskrit": "मयोक्तमपि चैतावत् त्वां प्रत्यमितविक्रम।\nअस्मिंस्तु स भवान् कृत्ये साहाय्यं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000236017, "chapter_id": 9236, "verse_number": "३-४०-१७", "content_sanskrit": "शृणु तत्कर्म साहाय्ये यत्कार्यं वचनान्मम।\nसौवर्णस्त्वं मृगो भूत्वा चित्रो रजतबिन्दुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000236018, "chapter_id": 9236, "verse_number": "३-४०-१८", "content_sanskrit": "आश्रमे तस्य रामस्य सीतायाः प्रमुखे चर।\nप्रलोभयित्वा वैदेहीं यथेष्टं गन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000236019, "chapter_id": 9236, "verse_number": "३-४०-१९", "content_sanskrit": "त्वां हि मायामयं दृष्ट्वा काञ्चनं जातविस्मया।\nआनयैनमिति क्षिप्रं रामं वक्ष्यति मैथिली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000236020, "chapter_id": 9236, "verse_number": "३-४०-२०", "content_sanskrit": "अपक्रान्ते च काकुत्स्थे दूरं गत्वाप्युदाहर।\nहा सीते लक्ष्मणेत्येवं रामवाक्यानुरूपकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000236021, "chapter_id": 9236, "verse_number": "३-४०-२१", "content_sanskrit": "तच्छ्रुत्वा रामपदवीं सीतया च प्रचोदितः।\nअनुगच्छति सम्भ्रान्तः सौमित्रिरपि सौहृदात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000236022, "chapter_id": 9236, "verse_number": "३-४०-२२", "content_sanskrit": "अपक्रान्ते च काकुत्स्थे लक्ष्मणे च यथासुखम्।\nआहरिष्यामि वैदेहीं सहस्राक्षः शचीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000236023, "chapter_id": 9236, "verse_number": "३-४०-२३", "content_sanskrit": "एवं कृत्वा त्विदं कार्यं यथेष्टं गच्छ राक्षस।\nराज्यस्यार्धं प्रदास्यामि मारीच तव सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000236024, "chapter_id": 9236, "verse_number": "३-४०-२४", "content_sanskrit": "गच्छ सौम्य शिवं मार्गं कार्यस्यास्य विवृद्धये।\nअहं त्वानुगमिष्यामि सरथो दण्डकावनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000236025, "chapter_id": 9236, "verse_number": "३-४०-२५", "content_sanskrit": "प्राप्य सीतामयुद्धेन वञ्चयित्वा तु राघवम्।\nलङ्कां प्रति गमिष्यामि कृतकार्यः सह त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000236026, "chapter_id": 9236, "verse_number": "३-४०-२६", "content_sanskrit": "नो चेत् करोषि मारीच हन्मि त्वामहमद्य वै।\nएतत् कार्यमवश्यं मे बलादपि करिष्यसि।\nराज्ञो विप्रतिकूलस्थो न जातु सुखमेधते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000236027, "chapter_id": 9236, "verse_number": "३-४०-२७", "content_sanskrit": "आसाद्य तं जीवितसंशयस्ते\nमृत्युर्ध्रुवो ह्यद्य मया विरुध्यतः।\nएतद् यथावत् परिगण्य बुद‍्ध्या\nयदत्र पथ्यं कुरु तत्तथा त्वम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000236028, "chapter_id": 9236, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]