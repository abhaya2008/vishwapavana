[{"id": 7003637000, "chapter_id": 23637, "verse_number": "१-२-२४-१", "content_sanskrit": "नारद उवाच ।\nएवं श्रुत्वा सभार्यः स प्रमोदप्लुतमानसः ।\nप्रणम्य मामिति प्राह यद्येवं पुण्यवानहम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003637001, "chapter_id": 23637, "verse_number": "१-२-२४-२", "content_sanskrit": "पुनः किंचित्प्रवक्ष्यामि पुत्र्या मे दक्षिणः करः ।\nउत्तानः कारणं किं तच्छ्रोतुमिच्छामि नारद ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003637002, "chapter_id": 23637, "verse_number": "१-२-२४-३", "content_sanskrit": "इति पृष्टोऽस्मि शैलेन प्रावोचं कारणं तदा ।\nसर्वदैव करो ह्यस्याः सर्वेषां प्राणिनां प्रति ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003637003, "chapter_id": 23637, "verse_number": "१-२-२४-४", "content_sanskrit": "अभयस्य प्रदाताऽसावुत्तानस्तु करस्ततः ।\nएषा भार्या जगद्भर्तुर्वृषांकस्य महीधर ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003637004, "chapter_id": 23637, "verse_number": "१-२-२४-५", "content_sanskrit": "जननी सर्वलोकस्य भाविनी भूतभाविनी ।\nतद्यथा शीघ्रमेवैषा योगं यातु पिनाकिना ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003637005, "chapter_id": 23637, "verse_number": "१-२-२४-६", "content_sanskrit": "त्वया विधेयं विधिवत्तथा शैलेन्द्रसत्तम ।\nअस्त्यत्र सुमहतकार्यं देवानां हिमभूधर ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003637006, "chapter_id": 23637, "verse_number": "१-२-२४-७", "content_sanskrit": "इति प्रोच्य तमापृच्छ्य प्रावोचं वासवाय तत् ।\nमम भूयस्तु कर्तव्यं तन्मया कृतमेव हि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003637007, "chapter_id": 23637, "verse_number": "१-२-२४-८", "content_sanskrit": "किं तु पंचशरः प्रेर्यः कार्यशेषेऽत्र वासव ।\nइत्यादिश्य गतश्चाहं तारकं प्रति फाल्गुन ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003637008, "chapter_id": 23637, "verse_number": "१-२-२४-९", "content_sanskrit": "कलिप्रियत्वात्तस्यैनमर्थं कथयितुं स्फुटम् ।\nहिमाद्रिरपि मे वाक्यप्रेरितः पार्वतीं प्रति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003637009, "chapter_id": 23637, "verse_number": "१-२-२४-१०", "content_sanskrit": "भवस्याराधनां कर्तुं ससखीमादिशत्तदा ।\nसा तं परिचचारेशं तस्या दृष्ट्वा सुशीलताम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003637010, "chapter_id": 23637, "verse_number": "१-२-२४-११", "content_sanskrit": "पुष्पतोयफलाद्यानि नियुक्ता पार्वती व्यधात् ।\nमहेन्द्रोपि च मद्वाक्यात्स्मरं सस्मार भारत ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003637011, "chapter_id": 23637, "verse_number": "१-२-२४-१२", "content_sanskrit": "स च तत्स्मरणं ज्ञात्वा वसंतरतिसंयुतः ।\nचूतांकुरास्त्रःऋ सहसा प्रादुरासीन्मनोभवः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003637012, "chapter_id": 23637, "verse_number": "१-२-२४-१३", "content_sanskrit": "तमाह च वचो धीमान्स्मरन्निव च तं स्पृशन् ।\nउपदेशेन बहुना किं त्वां प्रति रतिप्रिय ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003637013, "chapter_id": 23637, "verse_number": "१-२-२४-१४", "content_sanskrit": "चित्ते वससि तेन त्वं वेत्सि भूतमनोगतम् ।\nतथापि त्वां वदिष्यामि स्वकार्यपरतां स्मरन् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003637014, "chapter_id": 23637, "verse_number": "१-२-२४-१५", "content_sanskrit": "ममैकं सुमहत्कार्यं कर्तुमर्हसि मन्मथ ।\nमहेश्वरं कृपानाथं सतीभार्यावियोजितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003637015, "chapter_id": 23637, "verse_number": "१-२-२४-१६", "content_sanskrit": "संयोजय पुनर्देव्या हिमाद्रिगृहजातया ।\nदेवी देवश्च तुष्टौ ते करिष्यत इहेप्सितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003637016, "chapter_id": 23637, "verse_number": "१-२-२४-१७", "content_sanskrit": "मदन उवाच ।\nअलीकमेतद्देवेन्द्र स हि देवस्य पोरतिः ।\nनान्यासादयितव्यानि तेजांसि मुनरब्रवीत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003637017, "chapter_id": 23637, "verse_number": "१-२-२४-१८", "content_sanskrit": "वेदान्तेषु च मां विप्रा गर्हसंयति पुनःपुनः ।\nमहाशनो महापाप्मा कामोऽयम नलो गहान् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003637018, "chapter_id": 23637, "verse_number": "१-२-२४-१९", "content_sanskrit": "आवृतं ज्ञानमेतेन ज्ञानिनां नित्यवैरिणा ।\nतस्मादयं सदा त्याज्यः कामऽहिरिव सत्तमैः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003637019, "chapter_id": 23637, "verse_number": "१-२-२४-२०", "content_sanskrit": "एवं शीलस्य मे कस्मात्प्रतुष्यति महेश्वरः ।\nमद्यपस्येव पापस्य वासुदेवो जगद्गुरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003637020, "chapter_id": 23637, "verse_number": "१-२-२४-२१", "content_sanskrit": "इंद्र उवाच ।\nमैवं ब्रूहि महाभाग त्वां विनाकः पुमान्भुवि ।\nधर्ममर्थं तथा कामं मोक्षं वा प्राप्तुमीश्वरः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003637021, "chapter_id": 23637, "verse_number": "१-२-२४-२२", "content_sanskrit": "यत्किंचित्साध्यते लोके मूलं तस्य च कामना ।\nकथं कामं विनिंदति तस्मात्ते मोक्षसाधकाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003637022, "chapter_id": 23637, "verse_number": "१-२-२४-२३", "content_sanskrit": "सत्यं चापि श्रुतेर्वाक्यं तव रूपं त्रिधागतम् ।\nतामसं राजसं चैव सात्त्विकं चापि मन्मथ ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003637023, "chapter_id": 23637, "verse_number": "१-२-२४-२४", "content_sanskrit": "अमुक्तितः कामनया रूपं तत्तामसं तव ।\nसुखबुद्ध्या स्पृहा या च रूपं तद्राजसं तव ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003637024, "chapter_id": 23637, "verse_number": "१-२-२४-२५", "content_sanskrit": "केवलं यावदर्थार्थं तद्रूपं सात्त्विकं तव ।\nतत्ते रूपत्रयमिदं ब्रूहि नोपासते हि के ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003637025, "chapter_id": 23637, "verse_number": "१-२-२४-२६", "content_sanskrit": "त्वं साक्षात्परमः पूज्यः कुरु कार्यमिदं हि नः ।\nअथ वा पीडितान्दृष्ट्वा सामान्यानपि पंडिताः ।\nस्वप्राणैरपि त्रायांति परमेतन्महाफलम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003637026, "chapter_id": 23637, "verse_number": "१-२-२४-२७", "content_sanskrit": "इति संचिंत्य कार्यं त्वं सर्वथा कुरु तत्स्फुटम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003637027, "chapter_id": 23637, "verse_number": "१-२-२४-२८", "content_sanskrit": "इत्या कर्ण्य तथेत्युक्त्वा वसंतरतिसंयुतः ।\nपिकादिसैन्यसंपन्नो हिमाद्रिं प्रययौ स्मरः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003637028, "chapter_id": 23637, "verse_number": "१-२-२४-२९", "content_sanskrit": "तत्रापश्यत शंभोः स पुण्यमाश्रममंडलम् ।\nनानावृक्षसमाकीर्णं शांतसत्त्वसमाकुलम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003637029, "chapter_id": 23637, "verse_number": "१-२-२४-३०", "content_sanskrit": "तत्रापश्यत्त्रिनेत्रस्य वीरकंनाम द्वारपम् ।\nयथा साक्षान्महेशानं गणआंश्चायुतशोऽस्य च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003637030, "chapter_id": 23637, "verse_number": "१-२-२४-३१", "content_sanskrit": "ददर्श च महेशानं नासाग्रकृतलोचनम् ।\nदेवदारुद्रुमच्छायावेदिका मध्यमाश्रितम् ।\nसमाकायं सुखासीनं समाधिस्थं महेश्वरम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003637031, "chapter_id": 23637, "verse_number": "१-२-२४-३२", "content_sanskrit": "निस्तरंगं विनिर्गृह्य स्थितमिंद्रियगोचरान् ।\nआत्मानमात्मना देवं प्रविष्टं तपसो निधिम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003637032, "chapter_id": 23637, "verse_number": "१-२-२४-३३", "content_sanskrit": "तं तथाविधमालोक्य सोंतर्भेदाय यत्नवान् ।\nभ्रमरध्वनिव्याजेन विवेश मदनो मनः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003637033, "chapter_id": 23637, "verse_number": "१-२-२४-३४", "content_sanskrit": "एतस्मिन्नंतरे देवो विकासितविलोचनः ।\nसस्मार नगराजस्य तनयां रक्तमानसः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003637034, "chapter_id": 23637, "verse_number": "१-२-२४-३५", "content_sanskrit": "निवेदिता वीरकेण विवेश च गिरेः सुता ।\nतस्मिन्काले महाभागा सदा यद्वदुपैति सा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003637035, "chapter_id": 23637, "verse_number": "१-२-२४-३६", "content_sanskrit": "ततस्तस्यां मनः स्वीयमनुरक्तमवेक्ष्य च ।\nनिगृह्य लीलया देवः स्वकं पृष्ठमवैक्षत ।\nतावदापूर्णधनुषमपश्यत रतिप्रियम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003637036, "chapter_id": 23637, "verse_number": "१-२-२४-३७", "content_sanskrit": "तन्नाशकृपया देवो नानास्थानेषु सोऽगमत् ।\nतावत्पस्यति पृष्ठस्तमाकृष्य धनुषः शरम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003637037, "chapter_id": 23637, "verse_number": "१-२-२४-३८", "content_sanskrit": "स नदीः पर्वताश्चैव आश्रमान्सरसीस्तथा ।\nपरिभ्रमन्महादेवः पृष्ठस्थं तमवैक्षत ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003637038, "chapter_id": 23637, "verse_number": "१-२-२४-३९", "content_sanskrit": "जगत्त्रयं परिभ्रम्य पुनरागात्स्वमाश्रमम् ।\nपृष्ठस्थमेव तं वीक्ष्य निःश्वासं मुमुचे हरः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003637039, "chapter_id": 23637, "verse_number": "१-२-२४-४०", "content_sanskrit": "ततस्तृतीयनेत्रोत्थवह्निना नाकवासिनाम् ।\nक्रोशतां गमितः कामो भस्मत्वं पांडुनंदन ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003637040, "chapter_id": 23637, "verse_number": "१-२-२४-४१", "content_sanskrit": "सस तु तं भस्मसात्कृत्वा हरनेत्रोद्भवोऽनलः ।\nव्यजृंभत जगद्दग्धुं ज्वालापूरितदिङ्मुखः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003637041, "chapter_id": 23637, "verse_number": "१-२-२४-४२", "content_sanskrit": "ततो भवो जगद्धेतोर्व्यभजज्जातवेदसम् ।\nसाहंकारे जने चंद्रे सुमनस्सु च गीतके ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003637042, "chapter_id": 23637, "verse_number": "१-२-२४-४३", "content_sanskrit": "भृंगेषु कोकिलास्येषु विहारेषु स्मरानलम् ।\nतत्प्राप्तौ स्नेहसंयुक्तं कामिनां हृदयं किल ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003637043, "chapter_id": 23637, "verse_number": "१-२-२४-४४", "content_sanskrit": "ज्वालयत्यनिशं सोऽग्निर्दुश्चिकित्स्योऽसुखावहः ।\nविलोक्य हरनिःश्वासज्वालाभस्मीकृतं स्मरम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003637044, "chapter_id": 23637, "verse_number": "१-२-२४-४५", "content_sanskrit": "विललाप रतिर्द्दीना मधुना बंधुना सह ।\nविलपंती सुबहुशो मधुना परिसांत्विता ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003637045, "chapter_id": 23637, "verse_number": "१-२-२४-४६", "content_sanskrit": "रत्याः प्रलापमाकर्ण्य देवदेवो वृषध्वजः ।\nकृपया परया प्राह कामपत्नीं निरीक्ष्य च ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003637046, "chapter_id": 23637, "verse_number": "१-२-२४-४७", "content_sanskrit": "अमूर्तोऽपि ह्ययं भद्रे कार्यं सर्वं पतिस्तव ।\nरतिकाले ध्रुवं बाले करिष्यति न संशयः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003637047, "chapter_id": 23637, "verse_number": "१-२-२४-४८", "content_sanskrit": "यदा विष्णुश्च भविता वसुदेवात्मजो विभुः ।\nतदै तस्य सुतो यः स्यात्सपतिस्ते भविष्यति ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003637048, "chapter_id": 23637, "verse_number": "१-२-२४-४९", "content_sanskrit": "सा प्रणम्य ततो रुद्रमिति प्रोक्ता रतिस्ततः ।\nजगाम स्वेच्छया गत्या वसंतादिभिरन्विता ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]