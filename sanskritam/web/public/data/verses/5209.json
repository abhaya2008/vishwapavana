[{"id": 2198059, "chapter_id": 5209, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2198060, "chapter_id": 5209, "verse_number": "१", "content_sanskrit": "एवमुक्तो मतङ्गस्तु संशितात्मा यतव्रतः ।\nसहस्रमेकपादेन ततोऽब्दानामतिष्ठत \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2198061, "chapter_id": 5209, "verse_number": "२", "content_sanskrit": "तं सहस्रावरे काले शक्रो द्रष्टुमुपागमत् ।\nतदेव च पुनर्वाक्यमुवाच बलवृत्रहा \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2198062, "chapter_id": 5209, "verse_number": "", "content_sanskrit": "मतङ्गः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2198063, "chapter_id": 5209, "verse_number": "३", "content_sanskrit": "इदं वर्षसहस्रं वै ब्रह्मचारी समाहितः ।\nअतिष्ठमेकपादेन ब्राह्मण्यं नाप्नुयां कथम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2198064, "chapter_id": 5209, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2198065, "chapter_id": 5209, "verse_number": "४", "content_sanskrit": "चण्डालयोनौ जातेन नावाप्यं वै कथञ्चन ।\nअन्यं कामं वृणीष्व त्वं मा वृथा तेऽस्त्वयं श्रमः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2198066, "chapter_id": 5209, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2198067, "chapter_id": 5209, "verse_number": "५", "content_sanskrit": "एवमुक्तो मतङ्गस्तु भृशं शोकपरायणः ।\nअतिष्ठत गयां गत्वा सोऽङ्गुष्ठेन शतं समाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2198068, "chapter_id": 5209, "verse_number": "६", "content_sanskrit": "सुदुष्करं वहन् योगं कृशो धमनिसन्ततः ।\nत्वगस्थिभूतो धर्मात्मा स पपातेति नः श्रुतम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2198069, "chapter_id": 5209, "verse_number": "७", "content_sanskrit": "तं पतन्तमभिद्रुत्य परिजग्राह वासवः ।\nवराणामीश्वरो दाता सर्वभूतहिते रतः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2198070, "chapter_id": 5209, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2198071, "chapter_id": 5209, "verse_number": "८", "content_sanskrit": "मतङ्ग ब्राह्मणत्वं ते संवृतं परिपन्थिभिः ।\nपूजयन् सुखमाप्नोति दुःखमाप्नोत्यपूजयन्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2198072, "chapter_id": 5209, "verse_number": "९", "content_sanskrit": "ब्राह्मणे सर्वभूतानां योगक्षेमः समाहितः ।\nब्राह्मणेभ्योऽनुतृप्यन्ति पितरो देवतास्तथा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2198073, "chapter_id": 5209, "verse_number": "१०", "content_sanskrit": "ब्राह्मणः सर्वभूतानां मतङ्ग पर उच्यते ।\nब्राह्मणः कुरुते तद्धि यथा यद्यच्च वाञ्छति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2198074, "chapter_id": 5209, "verse_number": "११", "content_sanskrit": "बह्वीस्तु संसरन् योनीर्जायमानः पुनः पुनः ।\nपर्याये तात कस्मिंश्चिद् ब्राह्मण्यमिह विन्दति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2198075, "chapter_id": 5209, "verse_number": "", "content_sanskrit": "मतङ्गः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2198076, "chapter_id": 5209, "verse_number": "१२", "content_sanskrit": "किं मां तुदसि दुःखार्तं मृतं मारयसे च माम् ।\nकिन्तु शोचामि यल्लभ्यं ब्राह्मण्यं न बुभूषसे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2198077, "chapter_id": 5209, "verse_number": "१३", "content_sanskrit": "ब्राह्मण्यं यदि दुष्प्रापं त्रिभिर्वर्णैः शतक्रतो ।\nसुदुर्लभं तदावाप्य नानुतिष्ठन्ति मानवाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2198078, "chapter_id": 5209, "verse_number": "१४", "content_sanskrit": "यः पापेभ्यः पापतमस्तेषामधम एव सः ।\nब्राह्मण्यं योऽवजानीते धनं लब्ध्वेव दुर्लभम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2198079, "chapter_id": 5209, "verse_number": "१५", "content_sanskrit": "दुष्प्रापं खलु विप्रत्वं प्राप्तं दुरनुपालनम् ।\nदुरवापमवाप्यैतन्नानुतिष्ठन्ति मानवाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2198080, "chapter_id": 5209, "verse_number": "१६", "content_sanskrit": "एकारामो ह्यहं शक्र निर्द्वन्द्वो निष्परिग्रहः ।\nअहिंसादमदानस्थः कथं नार्हामि विप्रताम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2198081, "chapter_id": 5209, "verse_number": "१७", "content_sanskrit": "यथाकामविहारी स्यां कामरूपी विहङ्गमः ।\nब्रह्मक्षत्राविरोधेन पूजां च प्राप्नुयामहम् ।\nयथा ममाक्षया कीर्तिर्भवेच्चापि पुरन्दर\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2198082, "chapter_id": 5209, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2198083, "chapter_id": 5209, "verse_number": "", "content_sanskrit": "छन्दोदेव इति ख्यातः स्त्रीणां पूज्यो भविष्यसि ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2198084, "chapter_id": 5209, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2198085, "chapter_id": 5209, "verse_number": "१८", "content_sanskrit": "एवं तस्मै वरं दत्त्वा वासवोऽन्तरधीयत ।\nप्राणांस्त्यक्त्वा मतङ्गोऽपि प्राप तत्स्थानमुत्तमम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2198086, "chapter_id": 5209, "verse_number": "१९", "content_sanskrit": "एवमेतत् परं स्थानं ब्राह्मण्यं नाम भारत ।\nतच्च दुष्प्रापमिह वै महेन्द्रवचनं यथा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2198087, "chapter_id": 5209, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे शक्रमतङ्गसंवादो नाम षष्टितमोऽध्यायः ॥६०॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]