[{"id": 2019351, "chapter_id": 1403, "verse_number": "३-४१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2019352, "chapter_id": 1403, "verse_number": "३-४१-१", "content_sanskrit": "तस्य संपश्यतस्त्वेव पिनाकी गोवृषध्वजः।\nजगामादर्शनं भानुर्लोकस्येवास्तमीयिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2019353, "chapter_id": 1403, "verse_number": "३-४१-२", "content_sanskrit": "ततोऽर्जुनः परं चक्रे विस्मयं परवीरहा।\nमया साक्षान्महादेवो दृष्ट इत्येव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2019354, "chapter_id": 1403, "verse_number": "३-४१-३", "content_sanskrit": "धन्योस्म्यनुगृहीतोस्मि यन्मया त्र्यम्बको हरः।\nपिनाकी वरदो रूपी दृष्टः स्पृष्टश्ट पाणिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2019355, "chapter_id": 1403, "verse_number": "३-४१-४", "content_sanskrit": "कृतार्थं चावगच्छामि परमात्मानमात्मना।\nशत्रूंश्च विजितान्सर्वान्निर्वृत्तं च प्रयोजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2019356, "chapter_id": 1403, "verse_number": "३-४१-५", "content_sanskrit": "इत्येवं चिन्तयानस्य पार्थस्यामिततेजसः।\nततो वैडूर्यवर्णाभो भासयन्सर्वतो दिशः।\nयादोगणवृतः श्रीमानाजगाम जलेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2019357, "chapter_id": 1403, "verse_number": "३-४१-६", "content_sanskrit": "नागैर्नदैर्नदीभिश्च दैत्यैः साध्यैर्मरुद्गणैः।\nवरुणो यादसांभर्ता वशी तं देशमागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2019358, "chapter_id": 1403, "verse_number": "३-४१-७", "content_sanskrit": "अथ जाम्बूनदवपुर्विमानेन महार्चिषा।\nकुबेरः समनुप्राप्तो यक्षैरनुगतः प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2019359, "chapter_id": 1403, "verse_number": "३-४१-८", "content_sanskrit": "विद्योतयन्निवाकाशमद्भुतोपमदर्शनः।\nधनानामधिपः श्रीमानर्जुनं द्रष्टुमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2019360, "chapter_id": 1403, "verse_number": "३-४१-९", "content_sanskrit": "तथा लोकान्तकः श्रीमान्यमः साक्षात्प्रतापवान्।\nमर्त्यमूर्तिधरैः सार्धं पितृभिर्लोकभावनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2019361, "chapter_id": 1403, "verse_number": "३-४१-१०", "content_sanskrit": "दण्डपाणिरचिन्त्यात्मा सर्वभूतविनाशकृत्।\nवैवस्वतो धर्मराजो विमानेनावभासयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2019362, "chapter_id": 1403, "verse_number": "३-४१-११", "content_sanskrit": "त्रील्लोकान्गुह्यकांश्चैव गन्धर्वाश्चैव पन्नगान्।\nद्वितीय इव मार्ताण्डो युगान्ते समुपस्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2019363, "chapter_id": 1403, "verse_number": "३-४१-१२", "content_sanskrit": "भानुमन्ति विचित्राणि शिखराणि महागिरेः।\nसमास्थायार्जुनं तत्रददृशुस्तपसान्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2019364, "chapter_id": 1403, "verse_number": "३-४१-१३", "content_sanskrit": "ततो मुहूर्ताद्भगवानैरावतशिरोगतः।\nआजगाम सहेन्द्राण्या शक्रः सुरगणैर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2019365, "chapter_id": 1403, "verse_number": "३-४१-१४", "content_sanskrit": "पाण्डुरेणातपत्रेण ध्रियमाणेन मूर्धनि।\nशुशुभे नागराजस्थः सितमभ्रमिव स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2019366, "chapter_id": 1403, "verse_number": "३-४१-१५", "content_sanskrit": "संस्तूयमानो गन्धर्वैर्ऋषिभिश्च तपोधनैः।\nशृङ्गं गिरेः समासाद्य तस्थौ सूर्य इवोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2019367, "chapter_id": 1403, "verse_number": "३-४१-१६", "content_sanskrit": "अथ मेघस्वनो धीमान्व्याजहार शुभां गिरम्।\nयमऋ परमधर्मज्ञो दक्षिणां दिशमास्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2019368, "chapter_id": 1403, "verse_number": "३-४१-१७", "content_sanskrit": "अर्जुनार्जुन पश्यास्माँल्लोकपालान्समागतान्।\nदृष्टिं ते वितरामोऽद्य भवानर्हति दर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2019369, "chapter_id": 1403, "verse_number": "३-४१-१८", "content_sanskrit": "पूर्वर्षिरमितात्मा त्वं नरो नाम महाबलः।\nनियोगाद्ब्रह्मणस्तात मर्त्यतां समुपागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2019370, "chapter_id": 1403, "verse_number": "३-४१-१९", "content_sanskrit": "त्वया च वसुसंभूतो महावीर्यः पितामहः।\nभीष्मः परमधर्मात्मा जेतव्यश्च रणेऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2019371, "chapter_id": 1403, "verse_number": "३-४१-२०", "content_sanskrit": "क्षत्रं चाग्निसमस्पर्शं भारद्वाजेन रक्षितम्।\nनिवातकवचाश्चैव संसाध्याः कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2019372, "chapter_id": 1403, "verse_number": "३-४१-२१", "content_sanskrit": "पितुर्ममांशो देवस्य सर्वलोकप्रतापिनः।\nकर्णश्व सुमहावीर्यस्त्वया वध्यो धनंजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2019373, "chapter_id": 1403, "verse_number": "३-४१-२२", "content_sanskrit": "अंशाश्च क्षितिसंप्राप्ता देवगन्धर्वरक्षसाम्।\nत्वया निपातिता युद्धेस्वकर्मफलनिर्जिताम्।\nगतिं प्राप्स्यन्ति कौन्तेय यथास्वमरिकर्शन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2019374, "chapter_id": 1403, "verse_number": "३-४१-२३", "content_sanskrit": "अक्षया तव कीर्तिश्च लोके स्थासय्ति फल्गुन।\nत्वया साक्षान्महादेवस्तोषितो हि महामृधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2019375, "chapter_id": 1403, "verse_number": "३-४१-२४", "content_sanskrit": "लघ्वी वसुमती चापि कर्तव्या विष्णुना सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2019376, "chapter_id": 1403, "verse_number": "३-४१-२५", "content_sanskrit": "गृहाणास्त्रं महाबाहो दण्डमप्रतिवारणम्।\nअनेनास्त्रेण सुमहत्त्वं हि कर्म करिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2019377, "chapter_id": 1403, "verse_number": "३-४१-२६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2019378, "chapter_id": 1403, "verse_number": "३-४१-२६", "content_sanskrit": "प्रतिजग्राह पार्थोपि विधिवत्कुरुनन्दनः।\nसमन्त्रं सोपरोधं च समोक्षविनिवर्तनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2019379, "chapter_id": 1403, "verse_number": "३-४१-२७", "content_sanskrit": "ततो जलधरश्यामो वरुणो यादसांपतिः।\nपश्चिमां दिशमास्थाय गिरमुच्चारयन्प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2019380, "chapter_id": 1403, "verse_number": "३-४१-२८", "content_sanskrit": "पार्थ क्षत्रियमुख्यस्त्वं क्षत्रधर्मे व्यवस्थितः।\nपश्य मां पृथुताम्राक्ष वरुणोस्मि जलेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2019381, "chapter_id": 1403, "verse_number": "३-४१-२९", "content_sanskrit": "मया समुद्यतान्पाशान्वारुणाननिवारितान्।\nप्रतिगृह्णीष्व कौन्तेय सहरहस्यनिवर्तनान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2019382, "chapter_id": 1403, "verse_number": "३-४१-३०", "content_sanskrit": "एभिस्तदा मया वीर संग्रामे तारकामये।\nदैतेयानां सहस्राणि संयतानि महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2019383, "chapter_id": 1403, "verse_number": "३-४१-३१", "content_sanskrit": "तस्मादिमान्महासत्व मत्प्रसादसमुत्थितान्।\nगृहाण न हि ते मुच्येदन्तकोप्याततायिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2019384, "chapter_id": 1403, "verse_number": "३-४१-३२", "content_sanskrit": "अनेन त्वं यदाऽस्त्रेण संग्रामे विचरिष्यसि।\nतदा निःक्षत्रिया भूमिर्भविष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2019385, "chapter_id": 1403, "verse_number": "३-४१-३३", "content_sanskrit": "`ततस्तान्वारुणानस्त्रान्दिव्यानस्त्रविदांवरः।\nप्रतिजग्राह विधिवद्वरुणाद्वासविस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2019386, "chapter_id": 1403, "verse_number": "३-४१-३४", "content_sanskrit": "ततः कैलासनिलयो धनाध्यक्षोऽभ्यभापत।\nदत्तेष्वस्त्रेषु दिव्येषु वरुणेन यमेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2019387, "chapter_id": 1403, "verse_number": "३-४१-३५", "content_sanskrit": "प्रीतोऽहमपि ते प्राज्ञ पाण्डवेय महाहल।\nत्वया सह समागम्य अजितेन तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2019388, "chapter_id": 1403, "verse_number": "३-४१-३६", "content_sanskrit": "सव्यसाचिन्महाबाहो पूर्वदेव सनातन।\nसहास्माभिर्भवाञ्श्रान्तः पुराकल्पेषु नित्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2019389, "chapter_id": 1403, "verse_number": "३-४१-३७", "content_sanskrit": "दर्शनं ते त्विदं दिव्यं प्रदिशामि नरर्षभ।\nअमानुषान्महाबाहो दुर्जयानपि जेष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2019390, "chapter_id": 1403, "verse_number": "३-४१-३८", "content_sanskrit": "मत्तश्चैव भवानाशु गृह्णात्वस्त्रमनुत्तमम्।\nअनेन त्वमनीकानि धार्तराष्ट्रस्य धक्ष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2019391, "chapter_id": 1403, "verse_number": "३-४१-३९", "content_sanskrit": "मत्तोऽपि त्वं गृहाणास्त्रमन्तर्धानं प्रियं भम।\nओजस्तेजोद्युतिकरं प्रस्वापनमरातिनुत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2019392, "chapter_id": 1403, "verse_number": "३-४१-४०", "content_sanskrit": "महात्मना शंकरेण त्रिपुरं निहतं यादा।\nतदैतदस्त्रं निर्मुक्तं येन दग्धा महासुराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2019393, "chapter_id": 1403, "verse_number": "३-४१-४१", "content_sanskrit": "त्वदर्थमुद्यतं चेदं मया सत्यपराक्रम।\nत्वमर्हो धारणे चास्य मेरुप्रतिमगौरव।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2019394, "chapter_id": 1403, "verse_number": "३-४१-४२", "content_sanskrit": "ततोऽर्जुनो महाबाहुर्विधिवत्कुरुनन्दनः।\nकौबेरमधिजग्राह दिव्यमस्त्रं महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2019395, "chapter_id": 1403, "verse_number": "३-४१-४३", "content_sanskrit": "ततोऽब्रवीद्देवराजः पार्थमक्लिष्टकारिणम्।\nसान्त्वयञ्श्लक्ष्णयावाचादिव्यदुन्दुभिनिःस्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2019396, "chapter_id": 1403, "verse_number": "३-४१-४४", "content_sanskrit": "कुन्तीमातर्महाबाहो त्वमीशानः पुरातनः।\nपरां सिद्धिमनुप्राप्तः साक्षाद्देवगतिं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2019397, "chapter_id": 1403, "verse_number": "३-४१-४५", "content_sanskrit": "देवकार्यं तु सुमहत्त्वया कार्यमरिंदम।\nआरोढव्यस्त्वया स्वर्गः सज्जीभव महाद्युते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2019398, "chapter_id": 1403, "verse_number": "३-४१-४६", "content_sanskrit": "रथो मातलिसंयुक्त आगतस्त्वत्कृते मम।\nतत्र तेऽहंप्रदास्यामि सर्वाण्यस्त्राणि कौरव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2019399, "chapter_id": 1403, "verse_number": "३-४१-४७", "content_sanskrit": "तान्दृष्ट्वा लोकपालांस्तु समेतान्गिरिमूर्धनि।\nजगाम विस्मयं धीमान्कुन्तीपुत्रो धनंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2019400, "chapter_id": 1403, "verse_number": "३-४१-४८", "content_sanskrit": "ततोऽर्जुनो महातेजा लोकपालान्समागतान्।\nपूजयामास विधिवद्वाग्भिरद्भिः फलैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2019401, "chapter_id": 1403, "verse_number": "३-४१-४९", "content_sanskrit": "ततः प्रतिययुर्देवाः प्रतिपूज्य धनंजयम्।\nयथागतेन विबुधाः सर्वे कामं मनोजवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2019402, "chapter_id": 1403, "verse_number": "", "content_sanskrit": "ततो ऽर्जुनो मुदं लेभे लब्धास्त्रः पुरुषर्पभः।\nकृतार्थमथ चात्मानं स मेने पूर्णमानसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]