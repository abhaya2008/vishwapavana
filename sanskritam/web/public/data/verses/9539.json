[{"id": 5000539000, "chapter_id": 9539, "verse_number": "७-४-१", "content_sanskrit": "श्रुत्वागस्त्येरितं वाक्यं रामो विस्मयमागतः ।\nकथमासीत्तु लङ्कायां सम्भवो रक्षसां पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000539001, "chapter_id": 9539, "verse_number": "७-४-२", "content_sanskrit": "ततः शिरः कम्पयित्वा त्रेताग्निसमविग्रहम् ।\nतमगस्त्यं मुहुर्दृष्ट्वा स्मयमानो ऽभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000539002, "chapter_id": 9539, "verse_number": "७-४-३", "content_sanskrit": "भगवन्पूर्वमप्येषा लङ्कासीत्पिशिताशिनाम् ।\nश्रुत्वेदं भगवद्वाक्यं जातो मे विस्मयः परः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000539003, "chapter_id": 9539, "verse_number": "७-४-४", "content_sanskrit": "पुलस्त्यवंशादुद्भूता राक्षसा इति नः श्रुतम् ।\nइदानीमन्यतश्चापि सम्भवः कीर्तितस्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000539004, "chapter_id": 9539, "verse_number": "७-४-५", "content_sanskrit": "रावणात्कुम्भकर्णाच्च प्रहस्ताद्विकटादपि ।\nरावणस्य च पुत्रेभ्यः किं नु ते बलवत्तराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000539005, "chapter_id": 9539, "verse_number": "७-४-६", "content_sanskrit": "क एषां पूर्वको ब्रह्मन्किन्नामा च बलोत्कटः ।\nअपराधं च कं प्राप्य विष्णुना द्राविताः कथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000539006, "chapter_id": 9539, "verse_number": "७-४-७", "content_sanskrit": "एतद्विस्तरतः सर्वं कथयस्व ममानघ ।\nकुतूहलमिदं मह्यं नुद भानुर्यथा तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000539007, "chapter_id": 9539, "verse_number": "७-४-८", "content_sanskrit": "राघवस्य वचः श्रुत्वा संस्कारालङ्कृतं शुभम् ।\nईषद्विस्मयमानस्तमगस्त्यः प्राह राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000539008, "chapter_id": 9539, "verse_number": "७-४-९", "content_sanskrit": "प्रजापतिः पुरा सृष्ट्वा ह्यपः सलिलसम्भवः ।\nतासां गोपायने सत्त्वानसृजत्पद्मसम्भवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000539009, "chapter_id": 9539, "verse_number": "७-४-१०", "content_sanskrit": "ते सत्त्वाः सत्त्वकर्तारं विनीतवदुपस्थिताः ।\nकिं कुर्म इति भाषन्तः क्षुत्पिपासाभयार्दिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000539010, "chapter_id": 9539, "verse_number": "७-४-११", "content_sanskrit": "प्रजापतिस्तु तान्याह सत्वानि प्रहसन्निव ।\nआभाष्य वाचा यत्नेन रक्षध्वमिति मानदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000539011, "chapter_id": 9539, "verse_number": "७-४-१२", "content_sanskrit": "रक्षामेति च तत्रान्ये जक्षाम इति चापरे ।\nभुक्षिताभुक्षितैरुक्तस्ततस्तानाह भूतकृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000539012, "chapter_id": 9539, "verse_number": "७-४-१३", "content_sanskrit": "रक्षामेति च यैरुक्तं राक्षसास्ते भवन्तु वः ।\nजक्षाम इति यैरुक्तं यक्षा एव भवन्तु वः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000539013, "chapter_id": 9539, "verse_number": "७-४-१४", "content_sanskrit": "तत्र हेतिः प्रहेतिश्च भ्रातरौ राक्षसाधिपौ ।\nमधुकैटभसङ्काशौ बभूवतुररिन्दमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000539014, "chapter_id": 9539, "verse_number": "७-४-१५", "content_sanskrit": "प्रहेतिर्धार्मिकस्तत्र तपोवनगतस्तदा ।\nहेतिर्दारक्रियार्थे तु परं यत्नमथाकरोत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000539015, "chapter_id": 9539, "verse_number": "७-४-१६", "content_sanskrit": "स कालभगिनीं कन्यां भयां नाम भयावहाम् ।\nउदावहदमेयात्मा स्वयमेव महामतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000539016, "chapter_id": 9539, "verse_number": "७-४-१७", "content_sanskrit": "स तस्यां जनयामास हेती राक्षसपुङ्गवः ।\nपुत्रं पुत्रवतां श्रेष्ठो विद्युत्केश इति श्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000539017, "chapter_id": 9539, "verse_number": "७-४-१८", "content_sanskrit": "विद्युत्केशो हेतिपुत्रः स दीप्तार्कसमप्रभः ।\nव्यवर्धत महातेजास्तोयमध्य इवाम्बुदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000539018, "chapter_id": 9539, "verse_number": "७-४-१९", "content_sanskrit": "स यदा यौवनं भद्रमनुप्राप्तो निशाचरः ।\nततो दारक्रियां तस्य कर्तुं व्यवसितः पिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000539019, "chapter_id": 9539, "verse_number": "७-४-२०", "content_sanskrit": "सन्ध्यायास्तनयां सो ऽथ सन्ध्यातुल्यां प्रभावतः ।\nवरयामास पुत्रार्थं हेती राक्षसपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000539020, "chapter_id": 9539, "verse_number": "७-४-२१", "content_sanskrit": "अवश्यमेव दातव्या परस्मै सेति सन्ध्यया ।\nचिन्तयित्वा सुता दत्ता विद्युत्केशाय राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000539021, "chapter_id": 9539, "verse_number": "७-४-२२", "content_sanskrit": "सन्ध्यायास्तनयां लब्ध्वा विद्युत्केशो निशाचरः ।\nरमते स्म तया सार्धं पौलोम्या मघवानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000539022, "chapter_id": 9539, "verse_number": "७-४-२३", "content_sanskrit": "केनचित्त्वथ कालेन राम सालकटङ्कटा ।\nविद्युत्केशाद्गर्भमाप घनराजिरिवार्णवात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000539023, "chapter_id": 9539, "verse_number": "७-४-२४", "content_sanskrit": "ततः सा राक्षसी गर्भं घनगर्भसमप्रभम् ।\nप्रसूता मन्दरं गत्वा गङ्गा गर्भमिवाग्निजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000539024, "chapter_id": 9539, "verse_number": "७-४-२५", "content_sanskrit": "समुत्सृज्य तु सा गर्भं विद्युत्केशरतार्थिनी ।\nरेमे तु सार्धं पतिना विस्मृत्य सुतमात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000539025, "chapter_id": 9539, "verse_number": "७-४-२६", "content_sanskrit": "उत्सृष्टस्तु तदा गर्भो घनशब्दसमस्वनः ।\nतयोत्सृष्टः स तु शिशुः शरदर्कसमद्युतिः ।\nनिधायास्ये स्वयं मुष्टिं रुरोद शनकैस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000539026, "chapter_id": 9539, "verse_number": "७-४-२७", "content_sanskrit": "ततो वृषभमास्थाय पार्वत्या सहितः शिवः ।\nवायुमार्गेण गच्छन्वै शुश्राव रुदितस्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000539027, "chapter_id": 9539, "verse_number": "७-४-२८", "content_sanskrit": "अपश्यदुमया सार्धं रुदन्तं राक्षसात्मजम् ।\nकारुण्यभावात्पार्वत्या भवस्त्रिपुरसूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000539028, "chapter_id": 9539, "verse_number": "७-४-२९", "content_sanskrit": "तं राक्षसात्मजं चक्रे मातुरेव वयःसमम् ।\nअमरं चैव तं कृत्वा महादेवो ऽक्षरो ऽव्ययः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000539029, "chapter_id": 9539, "verse_number": "७-४-३०", "content_sanskrit": "पुरमाकाशगं प्रादात्पार्वत्याः प्रियकाम्यया ।\nउमयापि वरो दत्तो राक्षसानां नृपात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000539030, "chapter_id": 9539, "verse_number": "७-४-३१", "content_sanskrit": "सद्योपलब्धिर्गर्भस्य प्रसूतिः सद्य एव च ।\nसद्य एव वयःप्राप्तिर्मातुरेव वयस्समम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000539031, "chapter_id": 9539, "verse_number": "७-४-३२", "content_sanskrit": "ततः सुकेशो वरदानगर्वितः श्रियं प्रभोः प्राप्य हरस्य पार्श्वतः ।\nचचार सर्वत्र महान्महामतिः खगं पुरं प्राप्य पुरन्दरो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000539032, "chapter_id": 9539, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे चतुर्थः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]