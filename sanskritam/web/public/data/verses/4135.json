[{"id": 2145572, "chapter_id": 4135, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2145573, "chapter_id": 4135, "verse_number": "१", "content_sanskrit": "दुर्योधने धार्तराष्ट्रे तद्वचो नाभिनन्दति ।\nतूष्णीम्भूतेषु सर्वेषु समुत्तस्थुर्नरर्षभाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2145574, "chapter_id": 4135, "verse_number": "२", "content_sanskrit": "उत्थितेषु महाराज पृथिव्यां सर्वराजसु ।\nरहिते सञ्जयं राजा परिप्रष्टुं प्रचक्रमे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2145575, "chapter_id": 4135, "verse_number": "३", "content_sanskrit": "आशंसमानो विजयं तेषां पुत्रवशानुगः ।\nआत्मनश्च परेषां च पाण्डवानां च निश्चयम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2145576, "chapter_id": 4135, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2145577, "chapter_id": 4135, "verse_number": "४", "content_sanskrit": "गावल्गणे ब्रूहि नः सारफल्गु\nस्वसेनायां यावदिहास्ति किञ्चित् ।\nत्वं पाण्डवानां निपुणं वेत्थ सर्वं\nकिमेषां ज्यायः किमु तेषां कनीयः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2145578, "chapter_id": 4135, "verse_number": "५", "content_sanskrit": "त्वमेतयोः सारवित् सर्वदर्शी\nधर्मार्थयोर्निपुणो निश्चयज्ञः ।\nस मे पृष्टः सञ्जय ब्रूहि सर्वं\nनियुध्यमानाः कतरेऽस्मिन् न सन्ति\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2145579, "chapter_id": 4135, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2145580, "chapter_id": 4135, "verse_number": "६", "content_sanskrit": "न त्वां ब्रूयां रहिते जातु किञ्चिद्\nअसूया हि त्वां प्रसहेत राजन् ।\nआनयस्व पितरं महाव्रतं\nगान्धारीं च महिषीमाजमीढ\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2145581, "chapter_id": 4135, "verse_number": "७", "content_sanskrit": "तौ तेऽसूयां विनयेतां नरेन्द्र\nधर्मज्ञौ तौ निपुणौ निश्चयज्ञौ ।\nतयोस्तु त्वां सन्निधौ तद् वदेयं\nकृत्स्नं मतं केशवपार्थयोर्यत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2145582, "chapter_id": 4135, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2145583, "chapter_id": 4135, "verse_number": "८", "content_sanskrit": "इत्युक्तेन च गान्धारी व्यासश्चात्राजगाम ह ।\nआनीतौ विदुरेणेह सभां शीघ्रं प्रवेशितौ\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2145584, "chapter_id": 4135, "verse_number": "९", "content_sanskrit": "ततस्तन्मतमाज्ञाय सञ्जयस्यात्मजस्य च ।\nअभ्युपेत्य महाप्राज्ञः कृष्णद्वैपायनोऽब्रवीत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2145585, "chapter_id": 4135, "verse_number": "१०", "content_sanskrit": "सम्पृच्छते धृतराष्ट्राय सञ्जय\nआचक्ष्व सर्वं यावदेषोऽनुयुङ्क्ते ।\nसर्वं यावद् वेत्थ तस्मिन् यथावद्\nयाथातथ्यं वासुदेवेऽर्जुने च\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2145586, "chapter_id": 4135, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2145587, "chapter_id": 4135, "verse_number": "११", "content_sanskrit": "अर्जुनो वासुदेवश्च धन्विनौ परमार्चितौ ।\nकामादन्यत्र सम्भूतौ पूर्वभावाय सम्मितौ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2145588, "chapter_id": 4135, "verse_number": "१२", "content_sanskrit": "जन्मान्तरं समास्थाय यथायुक्तं मनस्विनः ।\nचक्रं तद् वासुदेवस्य मायया वर्तते विभो\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2145589, "chapter_id": 4135, "verse_number": "१३", "content_sanskrit": "नरकं शम्बरं चैव कंसं चैद्यं च माधवः ।\nजितवान् घोरसङ्काशान् क्रीडन्निव जनार्दनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2145590, "chapter_id": 4135, "verse_number": "१४", "content_sanskrit": "पृथिवीं चान्तरिक्षं च द्यां चैव पुरुषोत्तमः ।\nमनसैव विसृष्टात्मा नयत्यात्मवशं वशी\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2145591, "chapter_id": 4135, "verse_number": "१५", "content_sanskrit": "भूयो भूयो हि यद् राजन् पृच्छसे पाण्डवान् प्रति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2145592, "chapter_id": 4135, "verse_number": "१६", "content_sanskrit": "स यद् ध्रुवं पाण्डवेषु विद्धि राजसु सत्तम ।\nसारासारबलं ज्ञातुं तत् समासेन मे शृणु\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2145593, "chapter_id": 4135, "verse_number": "१७", "content_sanskrit": "एकतो वा जगत् कृत्स्नमेकतो वा जनार्दनः ।\nसारतो जगतः कृत्स्नादतिरिक्तो जनार्दनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2145594, "chapter_id": 4135, "verse_number": "१८", "content_sanskrit": "भस्म कुर्याद् जगदिदं मनसैव जनार्दनः ।\nन तु कृत्स्नं जगच्छक्तं किञ्चित् कर्तुं जनार्दने\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2145595, "chapter_id": 4135, "verse_number": "१९", "content_sanskrit": "यतः सत्यं यतो धर्मो यतो ह्रीरार्जवं यतः ।\nततो भवति गोविन्दो यतः कृष्णस्ततो जयः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2145596, "chapter_id": 4135, "verse_number": "२०", "content_sanskrit": "पृथिवीं चान्तरिक्षं च दिवं च पुरुषोत्तमः ।\nमनसैव विसृष्टात्मा क्रीडन्निव जनार्दनः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2145597, "chapter_id": 4135, "verse_number": "२१", "content_sanskrit": "स कृत्वा पाण्डवान् सत्रं लोकं सम्मोहयन्निव ।\nअधर्मनिरतान् मूढान् दग्धुमिच्छति ते सुतान्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2145598, "chapter_id": 4135, "verse_number": "२२", "content_sanskrit": "कालचक्रं जगच्चक्रं युगचक्रं च केशवः ।\nआत्मयोगेन भगवान् परिवर्तयतेऽनिशम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2145599, "chapter_id": 4135, "verse_number": "२३", "content_sanskrit": "कालस्य च हि मृत्योश्च जङ्गमस्थावरस्य च ।\nईष्टे हि भगवानेकः सत्यमेतद् ब्रवीमि ते\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2145600, "chapter_id": 4135, "verse_number": "२४", "content_sanskrit": "ईशन्नपि महायोगी सर्वस्य जगतो हरिः ।\nकर्माण्यारभते कर्तुं कीनाश इव दुर्बलः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2145601, "chapter_id": 4135, "verse_number": "२५", "content_sanskrit": "तेन वञ्चयते लोकान् मायायोगेन केशवः ।\nये तमेव प्रपद्यन्ते न ते मुह्यन्ति मानवाः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2145602, "chapter_id": 4135, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि षट्षष्टितमोऽध्यायः ॥६६॥\nव्यासाभिगमनपर्वणि एकोनविंशोऽध्यायः ॥१९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]