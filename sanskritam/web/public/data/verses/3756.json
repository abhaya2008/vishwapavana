[{"id": 2128485, "chapter_id": 3756, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2128486, "chapter_id": 3756, "verse_number": "१", "content_sanskrit": "इतः प्रसादाद् वर्तन्ते प्रजाः सर्वाश्चतुर्विधाः ।\nता भाविता भावयन्ति हव्यकव्यैर्दिवौकसः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2128487, "chapter_id": 3756, "verse_number": "२", "content_sanskrit": "लोका ह्येवं वर्तयन्ति अन्योन्यं समुपाश्रिताः ।\nत्वत्प्रसादान्निरुद्विग्राः त्वयैव परिरक्षिताः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2128488, "chapter_id": 3756, "verse_number": "३", "content_sanskrit": "इदं च समनुप्राप्तं लोकानां भयमच्युत ।\nरात्रौ वध्यन्ति सततं केनैते द्विजपुङ्गवाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2128489, "chapter_id": 3756, "verse_number": "४", "content_sanskrit": "क्षीणेषु च ब्राह्मणेषु पृथिवी क्षयमेष्यति ।\nततः पृथिव्यां क्षीणायां त्रिदिवं क्षयमेष्यति \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2128490, "chapter_id": 3756, "verse_number": "५", "content_sanskrit": "त्वत्प्रसादान्महाबाहो सर्वे लोका जगत्पते ।\nविनाशं नाघिगच्छेयुः त्वयैव परिरक्षिताः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2128491, "chapter_id": 3756, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2128492, "chapter_id": 3756, "verse_number": "६", "content_sanskrit": "विदितं मे सुराः सर्वं प्रजानां क्षयकारणम् ।\nभवतां चापि वक्ष्यामि शृणुध्वं विगतज्वराः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2128493, "chapter_id": 3756, "verse_number": "७", "content_sanskrit": "कालेया इति विख्याता गणाः परमदारुणाः ।\nतैश्च वृत्रं समाश्रित्य जगत् सर्वं प्रबाधितम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2128494, "chapter_id": 3756, "verse_number": "८", "content_sanskrit": "वृत्रं तु निहतं दृष्ट्वा सहस्राक्षेण धीमता ।\nजीवितं परिरक्षन्तः प्रविष्टा वरुणालयम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2128495, "chapter_id": 3756, "verse_number": "९", "content_sanskrit": "ते प्रविश्योदधिं घोरं नानाग्राहसमाकुलम् ।\nउत्सादनार्थं लोकानां रात्रौ घ्नन्ति मुनीनिह \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2128496, "chapter_id": 3756, "verse_number": "१०", "content_sanskrit": "न हि शक्याः क्षयं नेतुं समुद्राश्रयिणो हि ते ।\nसमुद्रस्य क्षये बुद्धिर्भवद्धिः संविधीयताम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2128497, "chapter_id": 3756, "verse_number": "११", "content_sanskrit": "अगस्त्येन विना को हि शक्तोऽन्योऽर्णवशोषणे ।\nअन्यथा नहि शक्यास्ते विना सागरशोषणम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2128498, "chapter_id": 3756, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2128499, "chapter_id": 3756, "verse_number": "१२", "content_sanskrit": "एतच्छ्रुत्वा वचो देवा विष्णुना समुदाहृतम् ।\nविष्णुमेव पुरस्कृत्य ब्रह्माणं समुपस्थिताः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2128500, "chapter_id": 3756, "verse_number": "१३", "content_sanskrit": "ते नीचैः प्रणता भूत्वा तमेवार्थं न्यवेदयन् ।\nसर्वलोकविनाशार्थं कालेयाः कृतनिश्चयाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2128501, "chapter_id": 3756, "verse_number": "१४", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा धर्मयोनिः पुरातनः ।\nउवाच परमप्रीतः त्रिदशानर्थवद्वचः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2128502, "chapter_id": 3756, "verse_number": "", "content_sanskrit": "परमेष्ठी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2128503, "chapter_id": 3756, "verse_number": "१५", "content_sanskrit": "विदितं मे सुराः सर्वं दानवानां विचेष्टितम् ।\nमनुष्यादेश्च निधनं कालेयैः कालचोदितैः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2128504, "chapter_id": 3756, "verse_number": "१६", "content_sanskrit": "क्षयस्तेषामनुप्राप्तः कालेनोपहताश्च ते ।\nउपायं सम्प्रवक्ष्यामि समुद्रस्य विशोषणे \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2128505, "chapter_id": 3756, "verse_number": "१७", "content_sanskrit": "अगस्त्य इति विख्यातो वारुणिः सुमहामुनिः ।\nतमुपागम्य सहिता इममर्थं प्रयाचत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2128506, "chapter_id": 3756, "verse_number": "१८", "content_sanskrit": "स हि शक्तो महाभागः क्षणात् पातुं महोदधिम् ।\nसमुद्रे च क्षयं नीते कालेयान् निहनिष्यथ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2128507, "chapter_id": 3756, "verse_number": "१९", "content_sanskrit": "एवं श्रुत्वा वचो देवा ब्रह्मणः परमेष्ठिनः ।\nपरमेष्ठ्यभ्यनुज्ञाता अगस्त्यस्याश्रमं ययुः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2128508, "chapter_id": 3756, "verse_number": "२०", "content_sanskrit": "तत्रापश्यन् महात्मानं वारुणिं दीप्ततेजसम् ।\nउपास्यमानमृषिभिर्देवैरिव पितामहम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2128509, "chapter_id": 3756, "verse_number": "२१", "content_sanskrit": "तेऽभिगम्य महात्मानं मैत्रावरुणिमच्युतम् ।\nआश्रमस्थं तपोराशिं कर्मभिः स्वैस्तु तुष्टुवुः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2128510, "chapter_id": 3756, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2128511, "chapter_id": 3756, "verse_number": "२२", "content_sanskrit": "नहुषेणाभितप्तानां त्वं लोकानां गतिः पुरा ।\nभ्रंशितश्च सुरैश्वर्याल्लोकार्थं लोककण्टकः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2128512, "chapter_id": 3756, "verse_number": "२३", "content_sanskrit": "क्रोधात् प्रवृद्धस्तरसा भास्करस्य नगोत्तमः ।\nवचस्तवानतिक्रामन् विन्ध्यः शैलो न वर्धते\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2128513, "chapter_id": 3756, "verse_number": "२४", "content_sanskrit": "तमसा चावृते लोके मृत्युनाऽभ्यर्दिताः प्रजाः ।\nत्वामेव नाथमासाद्य निर्वृतिं परमां गताः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2128514, "chapter_id": 3756, "verse_number": "२५", "content_sanskrit": "अस्माकं भयभीतानां नित्यशो हि भवान् गतिः ।\nततस्त्वार्ताः प्रयाचामः त्वां वरं वरदो ह्यसि\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2128515, "chapter_id": 3756, "verse_number": "", "content_sanskrit": "॥। इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि अष्टनवतितमोऽध्यायः ॥९८॥\n॥ तीर्थयात्रापर्वणि चतुःपञ्चाशोऽध्यायः ॥५४॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]