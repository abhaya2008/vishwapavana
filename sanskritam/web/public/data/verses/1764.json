[{"id": 2035319, "chapter_id": 1764, "verse_number": "५-९-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2035320, "chapter_id": 1764, "verse_number": "५-९-१", "content_sanskrit": "कथमिन्द्रेण राजेन्द्र सभार्येण महात्मना ।\nदुःखं प्राप्तं परं घोरमेतदिच्छामि वेदितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2035321, "chapter_id": 1764, "verse_number": "५-९-२x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2035322, "chapter_id": 1764, "verse_number": "५-९-२", "content_sanskrit": "शृणु राजन्पुरावृत्तमितिहासं पुरातनम्।\nसभार्येण यथा प्राप्तं दुःखमिन्द्रेण भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2035323, "chapter_id": 1764, "verse_number": "५-९-३", "content_sanskrit": "त्वष्टा प्रजापतिर्ह्यासीद्देवश्रेष्ठो महातपाः ।\nस पुत्रं वै त्रिशिरसमिन्द्रद्रोहात्किलासृजत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2035324, "chapter_id": 1764, "verse_number": "५-९-४", "content_sanskrit": "ऐन्द्रं स प्रार्थयत्स्थानं विश्वरूपो महाद्युतिः ।\nतैस्त्रिभिर्वदनैर्घोरैः सूर्येन्दुज्वलनोपमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2035325, "chapter_id": 1764, "verse_number": "५-९-५", "content_sanskrit": "वेदानेकेन सोऽधीते सुरामेकेन चापिबत्।\nएकेन च दिशः सर्वाः पिबन्निव निरीक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2035326, "chapter_id": 1764, "verse_number": "५-९-६", "content_sanskrit": "स तपस्वी मुदुर्दान्तो धर्मे तपसि चोद्यतः ।\nतपस्तस्य महत्तीव्रं सुदुश्चरमरिन्दम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2035327, "chapter_id": 1764, "verse_number": "५-९-७", "content_sanskrit": "तस्य दृष्ट्वा तपोवीर्यं सत्यं चामिततेजसः ।\nविषादमगमच्छक्र इन्द्रोऽयं मा भवेदिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2035328, "chapter_id": 1764, "verse_number": "५-९-८", "content_sanskrit": "कथं सज्जेच्च भोगेषु न च तप्येन्महत्तपः ।\nविवर्धमानस्त्रिशिराः सर्वं हि भुवनं ग्रसेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2035329, "chapter_id": 1764, "verse_number": "५-९-९", "content_sanskrit": "इति संचिन्त्य बहुधा बुद्धिमान्भरतर्षभ ।\nआज्ञापयत्सोऽप्सरसस्त्वष्टृपुत्रप्रलोभने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2035330, "chapter_id": 1764, "verse_number": "५-९-१०", "content_sanskrit": "यथा स सज्जेत्रिशिराः कामभोगेषु वै भृशम् ।\nक्षिप्रं कुरुत गच्छध्वं प्रलोभयत माचिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2035331, "chapter_id": 1764, "verse_number": "५-९-११", "content_sanskrit": "शृङ्गारवेषाः सुश्रोण्यो हारैर्युक्ता मनोहरैः ।\nहावभावसमायुक्ताः सर्वाः सौन्दर्यशोभिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2035332, "chapter_id": 1764, "verse_number": "५-९-१२", "content_sanskrit": "प्रलोभयत भद्रं वः शमयध्वं भयं मम।\nअस्वस्थं ह्यात्मनात्मानं लक्षयामि वराङ्गनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2035333, "chapter_id": 1764, "verse_number": "५-९-१३", "content_sanskrit": "भयं तन्मे महाघोरं क्षिप्रं नाशयताबलाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2035334, "chapter_id": 1764, "verse_number": "५-९-१३x", "content_sanskrit": "अप्सरस ऊचुः।\nतथा यत्नं करिष्यामः शक्र तस्य प्रलोभने।\nयथा नावाप्स्यसि भयं तस्माद्बलनिषूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2035335, "chapter_id": 1764, "verse_number": "५-९-१४", "content_sanskrit": "निर्दहन्निव चक्षुर्भ्यां योऽसावास्ते तपोनिधिः।\nतं प्रलोयितुं देव गच्छामः सहिता वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2035336, "chapter_id": 1764, "verse_number": "५-९-१५", "content_sanskrit": "यतिष्यामो वशे कर्तुं व्यपनेतुं च ते भयम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2035337, "chapter_id": 1764, "verse_number": "५-९-१५x", "content_sanskrit": "शल्य उवाच।\nइन्द्रेण तास्त्वनुज्ञाता जग्मुस्त्रिशिरसोऽन्तिकम्।\nतत्र ता विविधैर्भावैर्लोभयन्त्यो वराङ्गनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2035338, "chapter_id": 1764, "verse_number": "५-९-१६", "content_sanskrit": "नृत्तं संदर्शयामासुस्तथैवाङ्गेषु सौष्ठवम्।\nनाभ्यगच्छत्प्रहर्षं ताः स पश्यन्सुमहातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2035339, "chapter_id": 1764, "verse_number": "५-९-१७", "content_sanskrit": "इन्द्रियाणि वशे कृत्वा पूर्णसागरसन्निभः।\nतास्तु यत्नं परं कृत्वा पुनः शक्रमुपस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2035340, "chapter_id": 1764, "verse_number": "५-९-१८", "content_sanskrit": "कृताञ्जलिपुटाः सर्वा देवराजमथाब्रुवन्।\nन स शक्यः सुदुर्धर्षो धैर्याच्चालयितुं प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2035341, "chapter_id": 1764, "verse_number": "५-९-१९", "content_sanskrit": "यत्ते कार्यं महाभाग क्रियतां तदनन्तरम् ।\nसंपूज्याप्सरसः शक्रो विसृज्य च महामतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2035342, "chapter_id": 1764, "verse_number": "५-९-२०", "content_sanskrit": "चिन्तयामास तस्यैव वधोपायं युधिष्ठिर।\nस तूष्णीं चिन्तयन्वीरो देवराजः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2035343, "chapter_id": 1764, "verse_number": "५-९-२१", "content_sanskrit": "विनिश्चितमतिर्धीमान्वधे त्रिशिरसोऽभवत्।\nवज्रमस्य क्षिपाम्यद्य स क्षिप्रं नभविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2035344, "chapter_id": 1764, "verse_number": "५-९-२२", "content_sanskrit": "शत्रुः प्रवृद्धो नोपेक्ष्यो दुर्बलोऽपि बलीयसा।\nशास्त्रबुद्ध्या विनिश्चित्य कृत्वा बुद्धिं वधे दृढाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2035345, "chapter_id": 1764, "verse_number": "५-९-२३", "content_sanskrit": "अथ वैश्वानरनिभं घोररूपं भयावहम्।\nमुमोच वज्रं संक्रुद्धः शक्रस्त्रिशिरसं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2035346, "chapter_id": 1764, "verse_number": "५-९-२४", "content_sanskrit": "स पपात हतस्तेन वज्रेण दृढमाहतः।\nपर्वतस्येव शिखरं प्रणुन्नं मेदिनीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2035347, "chapter_id": 1764, "verse_number": "५-९-२५", "content_sanskrit": "तं तु वज्रहतं दृष्ट्वा शयानमचलोपमम्।\nन शर्म लेभे देवेन्द्रो दीपिततस्तस्य तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2035348, "chapter_id": 1764, "verse_number": "५-९-२६", "content_sanskrit": "हतोऽपि दीप्ततेजाः स जीवन्निव हि दृश्यते।\nघातितस्य शिरांस्याजौ जीवन्तीवाद्भुतानि वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2035349, "chapter_id": 1764, "verse_number": "५-९-२७", "content_sanskrit": "` शिरांसि तस्याजायन्त त्रीण्येव शकुनास्त्रयः।\nतित्तिरिः कलविङ्कश्च तथैव च कपिञ्जलः ।\nविश्वरूपशिरांस्येव जायन्ते तानि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2035350, "chapter_id": 1764, "verse_number": "५-९-२८", "content_sanskrit": "ततोऽतिभीतगात्रस्तु शक्र आस्ते विचारयन्।\nअथाजगाम परशुं स्कन्धेनादाय वर्धकिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2035351, "chapter_id": 1764, "verse_number": "५-९-२९", "content_sanskrit": "तदरण्यं महाराज यत्रास्तेऽसौ निपातितः ।\nस भीतस्तत्र तक्षाणं घटमानं शचीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2035352, "chapter_id": 1764, "verse_number": "५-९-३०", "content_sanskrit": "अपश्यदब्रवीच्चैनं सत्वरं पाकशासनः ।\nक्षिप्रं छिन्धि शिरांस्यस्य कुरुष्व वचनं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2035353, "chapter_id": 1764, "verse_number": "५-९-३१x", "content_sanskrit": "तक्षोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2035354, "chapter_id": 1764, "verse_number": "५-९-३१", "content_sanskrit": "महास्कन्धो भृशं ह्येष परशुर्नभविष्यति।\nकर्तुं चाहं न शक्ष्यामि कर्म राद्भिर्विगर्हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2035355, "chapter_id": 1764, "verse_number": "५-९-३२x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2035356, "chapter_id": 1764, "verse_number": "५-९-३२", "content_sanskrit": "मा भैस्त्वं शीघ्रमेतद्वै कुरुष्व वचनं मम।\nमत्प्रसादाद्धि ते शस्त्रं वज्रकल्पं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2035357, "chapter_id": 1764, "verse_number": "५-९-३३x", "content_sanskrit": "तक्षोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2035358, "chapter_id": 1764, "verse_number": "५-९-३३", "content_sanskrit": "कं भवन्तमहं विद्यां घोरकर्माणमद्य वै।\nएतदिच्छाम्यहं श्रोतुं तत्त्वेन कथयस्व मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2035359, "chapter_id": 1764, "verse_number": "५-९-३४x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2035360, "chapter_id": 1764, "verse_number": "५-९-३४", "content_sanskrit": "अहमिन्द्रो देवराजस्तक्षन्विदितमस्तु ते।\nकुरुष्वैतद्यथोक्तं मे तक्षन्माऽत्र विचारय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2035361, "chapter_id": 1764, "verse_number": "५-९-३५", "content_sanskrit": "` मया हि निहतः शेते त्रिशिरास्त्वं च विद्वि वै।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2035362, "chapter_id": 1764, "verse_number": "५-९-३५x", "content_sanskrit": "वैशम्पायन उवाच।\nस प्रह्वः प्राञ्जलिर्भूत्वा इदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2035363, "chapter_id": 1764, "verse_number": "५-९-३६", "content_sanskrit": "क्रूरेण नापत्रपसे कथं शक्रेह कर्मणा।\nऋषिपुत्रमिमं हत्वा ब्रह्महत्याभयं न ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2035364, "chapter_id": 1764, "verse_number": "५-९-३७x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2035365, "chapter_id": 1764, "verse_number": "५-९-३७", "content_sanskrit": "पश्चाद्धर्मं चरिष्यामि पावनार्थ सुदुश्चरम्।\nशत्रुरेष महावीर्यो वज्रेण निहतो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2035366, "chapter_id": 1764, "verse_number": "५-९-३८", "content_sanskrit": "अद्यापि चाहमुद्विग्नस्तक्षन्नस्माद्बिभेमि वै।\nक्षिप्रं छिन्धि शिरांसि त्वं करिष्येऽनुग्रहं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2035367, "chapter_id": 1764, "verse_number": "५-९-३९", "content_sanskrit": "शिरः पशोस्ते दास्यन्ति भागं यज्ञेषु मानवाः ।\nएष तेऽनुग्रहस्तक्षन्क्षिप्रं कुरु मम प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2035368, "chapter_id": 1764, "verse_number": "५-९-४०x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2035369, "chapter_id": 1764, "verse_number": "५-९-४०", "content_sanskrit": "एतच्छ्रुत्वा तु तक्षा स महेन्द्रवचनात्तदा।\nशिरांस्यथ त्रिशिरसः कुठारेणाच्छिनत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2035370, "chapter_id": 1764, "verse_number": "५-९-४१", "content_sanskrit": "निकृत्तेषु ततस्तेषु निष्क्रामन्नण्डजास्त्वथ।\nकपिञ्जलास्तित्तिराश्च कलविङ्काश्च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2035371, "chapter_id": 1764, "verse_number": "५-९-४२", "content_sanskrit": "येन वेदानधीते स्म पिबते सोममेव च।\nतस्माद्वक्रार्द्विनिश्चेरुः क्षिप्रं तस्य कपिञ्जलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2035372, "chapter_id": 1764, "verse_number": "५-९-४३", "content_sanskrit": "येन सर्वा दिशो राजन्पिबन्निव नीरीक्षते।\nतस्माद्वक्राद्विनिश्चेरुस्तित्तिरास्तस्य पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2035373, "chapter_id": 1764, "verse_number": "५-९-४४", "content_sanskrit": "यत्सुरापं तु तस्यासीद्वक्रं त्रिशिरसस्तदा।\nकलविङ्काः समुत्पेतुः श्येनाश्च भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2035374, "chapter_id": 1764, "verse_number": "५-९-४५", "content_sanskrit": "ततस्तेषु निकृत्तेषु विज्वरो मघवानथ।\n`तक्ष्णे तथा वरं दत्त्वा प्रहृष्टस्त्रिदशेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2035375, "chapter_id": 1764, "verse_number": "५-९-४६", "content_sanskrit": "जगाम त्रिदिवं देवस्तक्षाऽपि स्वगृहान्ययौ।\nमेने कृतार्थमात्मानं हत्वा शत्रुं सुरारिहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2035376, "chapter_id": 1764, "verse_number": "५-९-४७", "content_sanskrit": "` तक्षापि स्वगृहं गत्वा नैव शंसति कस्यचित्।\nअथैनं नाभिजानन्ति वर्षमेकं तथागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2035377, "chapter_id": 1764, "verse_number": "५-९-४८", "content_sanskrit": "अथ संवत्सरे पूर्णे भूताः पशुपतेः प्रभो।\nतमाक्रोशन्त मघवान्नः प्रभुर्ब्रह्महा इति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2035378, "chapter_id": 1764, "verse_number": "५-९-४९", "content_sanskrit": "तत इन्द्रो व्रतं घोरमाचरत्पाकशासनः।\nतपसा च सुसंयुक्तः सह देवैर्मरुद्गणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2035379, "chapter_id": 1764, "verse_number": "५-९-५०", "content_sanskrit": "समुद्रेषु पृथिव्यां च वनस्पतिषु स्त्रीषु च।\nविभज्य ब्रह्महत्यां च तान्वरैरप्ययोजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2035380, "chapter_id": 1764, "verse_number": "५-९-५१", "content_sanskrit": "वरदस्तु वरं दत्त्वा पृथिव्यै सागराय च।\nवनस्पतिभ्यः स्त्रीभ्यश्च ब्रह्महत्यां नुनोद ताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2035381, "chapter_id": 1764, "verse_number": "५-९-५२", "content_sanskrit": "ततस्तु शुद्धो भगवान्देवैर्लोकैश्च पूजितः ।\nइन्द्रस्थानमुपातिष्ठत्पूज्यमानो महर्षिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2035382, "chapter_id": 1764, "verse_number": "५-९-५३", "content_sanskrit": "त्वष्टा प्रजापतिः श्रुत्वा शक्रेणाथ हतं सुतम्।\nक्रोधसंरक्तनयन इदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2035383, "chapter_id": 1764, "verse_number": "५-९-५४x", "content_sanskrit": "त्वष्टोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2035384, "chapter_id": 1764, "verse_number": "५-९-५४", "content_sanskrit": "तप्यमानं तपो नित्यं क्षान्तं दान्तं जितेन्द्रियम्।\nविनाऽपराधेन यतः पुत्रं हिंसितवान्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2035385, "chapter_id": 1764, "verse_number": "५-९-५५", "content_sanskrit": "तस्माच्छक्रविनाशाय वृत्रमुत्पादयाम्यहम्।\nलोकाः पश्यन्तु मे वीर्यं तपसश्च बलं महम् ।\nस च पश्यतु देवेन्द्रो दुरात्मा पापचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2035386, "chapter_id": 1764, "verse_number": "५-९-५६", "content_sanskrit": "उपस्पृश्य ततः क्रुद्धस्तपस्वी सुमहायशाः ।\nअग्नौ हुत्वा समुत्पाद्य घोरं वृत्रमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2035387, "chapter_id": 1764, "verse_number": "५-९-५७", "content_sanskrit": "इन्द्रशत्रो विवर्धस्व प्रभावात्तपसो मम।\nसोऽवर्घत दिवं स्तब्ध्वा सूर्यवैश्वानरोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2035388, "chapter_id": 1764, "verse_number": "५-९-५८", "content_sanskrit": "किं करोमीति चोवाच कालसूर्य इवोदितः।\nशक्रं जहीति चाप्युक्तो जगाम त्रिदिवं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2035389, "chapter_id": 1764, "verse_number": "५-९-५९", "content_sanskrit": "ततो युद्धं समभवद्वृत्रवासवयोर्महत्।\nसंक्रुद्धयोर्महाघोरं प्रसक्तं कुरुसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2035390, "chapter_id": 1764, "verse_number": "५-९-६०", "content_sanskrit": "ततो जग्राह देवेन्द्रं वृत्रो वीरः शतक्रतुम् ।\nअपावृत्याक्षिपद्वक्रे शक्रं कोपसमन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2035391, "chapter_id": 1764, "verse_number": "५-९-६१", "content_sanskrit": "ग्रस्ते वृत्रेण शक्रे तु संभ्रान्तास्त्रिदिवेश्वराः।\nअसृजंस्ते महासत्वा जृम्भिकां वृत्रनाशिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2035392, "chapter_id": 1764, "verse_number": "५-९-६२", "content_sanskrit": "विजृम्भमाणस्य ततो वृत्रस्यास्यादपावृतात्।\nस्वान्यङ्गान्यभिसंक्षिप्य निष्क्रान्तो बलनाशनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2035393, "chapter_id": 1764, "verse_number": "५-९-६३", "content_sanskrit": "ततः प्रभृति लोकस्य जृम्भिका प्राणिसंश्रिता।\nजहृषुश्च सुराः सर्वे शक्रं दृष्ट्वा विनिःसृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2035394, "chapter_id": 1764, "verse_number": "५-९-६४", "content_sanskrit": "ततः प्रववृते युद्धं वृत्रवासवयोः पुनः ।\nसंरब्धयोस्तदा घोरं सुचिरं भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2035395, "chapter_id": 1764, "verse_number": "५-९-६५", "content_sanskrit": "यदा व्यवर्धत रणे वृत्रो बलसमन्वितः।\nत्वष्टुस्तेजोबलाविद्धस्तदा शक्रो न्यवर्तत।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2035396, "chapter_id": 1764, "verse_number": "५-९-६६", "content_sanskrit": "निवृत्ते च तदा देवा विषादमगमन्परम् ।\nसमेत्य सह शक्रेण त्वष्टुस्तेजोविमोहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2035397, "chapter_id": 1764, "verse_number": "५-९-६७", "content_sanskrit": "अमन्त्रयन्त ते सर्वे मुनिभिः सह भारत।\nकिं कार्यमिति वै राजन्विचिन्त्य भयमोहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2035398, "chapter_id": 1764, "verse_number": "५-९-६८", "content_sanskrit": "जग्मुः सर्वे महात्मानं मनोभिर्विष्णुमव्ययम्।\nउपविष्टा मन्दराग्रे सर्वे वृत्रवधेप्सवः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2035399, "chapter_id": 1764, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सेनोद्योगपर्वणि नवमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]