[{"id": 5000456000, "chapter_id": 9456, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे एकोनपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000456001, "chapter_id": 9456, "verse_number": "६-४९-१", "content_sanskrit": "घोरेण शरबन्धेन बद्धौ दशरथात्मजौ।\nनिःश्वसन्तौ यथा नागौ शयानौ रुधिरोक्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000456002, "chapter_id": 9456, "verse_number": "६-४९-२", "content_sanskrit": "सर्वे ते वानरश्रेष्ठाः ससुग्रीवमहाबलाः।\nपरिवार्य महात्मानौ तस्थुः शोकपरिप्लुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000456003, "chapter_id": 9456, "verse_number": "६-४९-३", "content_sanskrit": "एतस्मिन्नन्तरे रामः प्रत्यबुध्यत वीर्यवान्।\nस्थिरत्वात् सत्त्वयोगाच्च शरैः संदानितोऽपि सन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000456004, "chapter_id": 9456, "verse_number": "६-४९-४", "content_sanskrit": "ततो दृष्ट्वा सरुधिरं निषण्णं गाढमर्पितम्।\nभ्रातरं दीनवदनं पर्यदेवयदातुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000456005, "chapter_id": 9456, "verse_number": "६-४९-५", "content_sanskrit": "किं नु मे सीतया कार्यं लब्धया जीवितेन वा।\nशयानं योऽद्य पश्यामि भ्रातरं युधि निर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000456006, "chapter_id": 9456, "verse_number": "६-४९-६", "content_sanskrit": "शक्या सीतासमा नारी मर्त्यलोके विचिन्वता।\nन लक्ष्मणसमो भ्राता सचिवः साम्परायिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000456007, "chapter_id": 9456, "verse_number": "६-४९-७", "content_sanskrit": "परित्यक्ष्याम्यहं प्राणान् वानराणां तु पश्यताम्।\nयदि पञ्चत्वमापन्नः सुमित्रानन्दवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000456008, "chapter_id": 9456, "verse_number": "६-४९-८", "content_sanskrit": "किं नु वक्ष्यामि कौसल्यां मातरं किं नु कैकयीम्।\nकथमम्बां सुमित्रां च पुत्रदर्शनलालसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000456009, "chapter_id": 9456, "verse_number": "६-४९-९", "content_sanskrit": "विवत्सां वेपमानां च वेपन्तीं कुररीमिव।\nकथमाश्वासयिष्यामि यदि यास्यामि तं विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000456010, "chapter_id": 9456, "verse_number": "६-४९-१०", "content_sanskrit": "कथं वक्ष्यामि शत्रुघ्नं भरतं च यशस्विनम्।\nमया सह वनं यातो विना तेनाहमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000456011, "chapter_id": 9456, "verse_number": "६-४९-११", "content_sanskrit": "उपालम्भं न शक्ष्यामि सोढुमम्बासुमित्रया।\nइहैव देहं त्यक्ष्यामि नहि जीवितुमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000456012, "chapter_id": 9456, "verse_number": "६-४९-१२", "content_sanskrit": "धिङ्मां दुष्कृतकर्माणमनार्यं यत्कृते ह्यसौ।\nलक्ष्मणः पतितः शेते शरतल्पे गतासुवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000456013, "chapter_id": 9456, "verse_number": "६-४९-१३", "content_sanskrit": "त्वं नित्यं सुविषण्णं मामाश्वासयसि लक्ष्मण।\nगतासुर्नाद्य शक्तोऽसि मामार्तमभिभाषितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000456014, "chapter_id": 9456, "verse_number": "६-४९-१४", "content_sanskrit": "येनाद्य बहवो युद्धे निहता राक्षसाः क्षितौ।\nतस्यामेवाद्य शूरस्त्वं शेषे विनिहतः शनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000456015, "chapter_id": 9456, "verse_number": "६-४९-१५", "content_sanskrit": "शयानः शरतल्पेऽस्मिन् सशोणितपरिस्रुतः।\nशरभूतस्ततो भासि भास्करोऽस्तमिव व्रजन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000456016, "chapter_id": 9456, "verse_number": "६-४९-१६", "content_sanskrit": "बाणाभिहतमर्मत्वान्न शक्नोषीह भाषितुम्।\nरुजा चाब्रुवतो यस्य दृष्टिरागेण सूच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000456017, "chapter_id": 9456, "verse_number": "६-४९-१७", "content_sanskrit": "यथैव मां वनं यान्तमनुयातो महाद्युतिः।\nअहमप्यनुयास्यामि तथैवैनं यमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000456018, "chapter_id": 9456, "verse_number": "६-४९-१८", "content_sanskrit": "इष्टबन्धुजनो नित्यं मां च नित्यमनुव्रतः।\nइमामद्य गतोऽवस्थां ममानार्यस्य दुर्नयैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000456019, "chapter_id": 9456, "verse_number": "६-४९-१९", "content_sanskrit": "सुरुष्टेनापि वीरेण लक्ष्मणेन न संस्मरे।\nपरुषं विप्रियं चापि श्रावितं तु कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000456020, "chapter_id": 9456, "verse_number": "६-४९-२०", "content_sanskrit": "विससर्जैकवेगेन पञ्चबाणशतानि यः।\nइष्वस्त्रेष्वधिकस्तस्मात् कार्तवीर्याच्च लक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000456021, "chapter_id": 9456, "verse_number": "६-४९-२१", "content_sanskrit": "अस्त्रैरस्त्राणि यो हन्याच्छक्रस्यापि महात्मनः।\nसोऽयमुर्व्यां हतः शेते महार्हशयनोचितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000456022, "chapter_id": 9456, "verse_number": "६-४९-२२", "content_sanskrit": "तत्तु मिथ्या प्रलप्तं मां प्रधक्ष्यति न संशयः।\nयन्मया न कृतो राजा राक्षसानां विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000456023, "chapter_id": 9456, "verse_number": "६-४९-२३", "content_sanskrit": "अस्मिन् मुहूर्ते सुग्रीव प्रतियातुमितोऽर्हसि।\nमत्वा हीनं मया राजन् रावणोऽभिभविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000456024, "chapter_id": 9456, "verse_number": "६-४९-२४", "content_sanskrit": "अङ्गदं तु पुरस्कृत्य ससैन्यं सपरिच्छदम्।\nसागरं तर सुग्रीव नीलेन च नलेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000456025, "chapter_id": 9456, "verse_number": "६-४९-२५", "content_sanskrit": "कृतं हि सुमहत्कर्म यदन्यैर्दुष्करं रणे।\nऋक्षराजेन तुष्यामि गोलाङ्गूलाधिपेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000456026, "chapter_id": 9456, "verse_number": "६-४९-२६", "content_sanskrit": "अङ्गदेन कृतं कर्म मैन्देन द्विविदेन च।\nयुद्धं केसरिणा संख्ये घोरं सम्पातिना कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000456027, "chapter_id": 9456, "verse_number": "६-४९-२७", "content_sanskrit": "गवयेन गवाक्षेण शरभेण गजेन च।\nअन्यैश्च हरिभिर्युद्धं मदर्थे त्यक्तजीवितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000456028, "chapter_id": 9456, "verse_number": "६-४९-२८", "content_sanskrit": "न चातिक्रमितुं शक्यं दैवं सुग्रीव मानुषैः।\nयत्तु शक्यं वयस्येन सुहृदा वा परं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000456029, "chapter_id": 9456, "verse_number": "६-४९-२९", "content_sanskrit": "कृतं सुग्रीव तत् सर्वं भवता धर्मभीरुणा।\nमित्रकार्यं कृतमिदं भवद्भिर्वानरर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000456030, "chapter_id": 9456, "verse_number": "६-४९-३०", "content_sanskrit": "अनुज्ञाता मया सर्वे यथेष्टं गन्तुमर्हथ।\nशुश्रुवुस्तस्य ये सर्वे वानराः परिदेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000456031, "chapter_id": 9456, "verse_number": "६-४९-३१", "content_sanskrit": "वर्तयांचक्रिरेऽश्रूणि नेत्रैः कृष्णेतरेक्षणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000456032, "chapter_id": 9456, "verse_number": "६-४९-३२", "content_sanskrit": "ततः सर्वाण्यनीकानि स्थापयित्वा विभीषणः।\nआजगाम गदापाणिस्त्वरितं यत्र राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000456033, "chapter_id": 9456, "verse_number": "६-४९-३३", "content_sanskrit": "तं दृष्ट्वा त्वरितं यान्तं नीलाञ्जनचयोपमम्।\nवानरा दुद्रुवुः सर्वे मन्यमानास्तु रावणिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000456034, "chapter_id": 9456, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे एकोनपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]