[{"id": 2095479, "chapter_id": 3037, "verse_number": "१३-१६७-१", "content_sanskrit": "`सनत्कुमार उवाच।\nप्रभवश्चाप्ययस्तात वर्णितस्तेऽनुपूर्वशः।\nतथाऽध्यात्माधेभूतं च तथैवात्राधिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2095480, "chapter_id": 3037, "verse_number": "१३-१६७-२", "content_sanskrit": "निखिलेन तु वक्ष्यामि दैवतानि ह देहिनाम्।\nयान्याश्रितेषु देहेषु यानि पृच्छसि शङ्कर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2095481, "chapter_id": 3037, "verse_number": "१३-१६७-३", "content_sanskrit": "वाच्यग्निस्त्वथ जिह्वायां सोमः प्राणे तु मारुतः।\nरूपे चाप्यथ नक्षत्रं जिह्वायां चाप एव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2095482, "chapter_id": 3037, "verse_number": "१३-१६७-४", "content_sanskrit": "नाभ्यां समुद्रश्च विभुर्नखरोम तथैव च।\nवनस्पतिवनौषध्यस्त्वङ्गेषु मरुतस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2095483, "chapter_id": 3037, "verse_number": "१३-१६७-५", "content_sanskrit": "संवत्सराः पर्वसु च आकाशे दैवमानुषे।\nउदाने विद्युदभवद्व्याने पर्जन्य एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2095484, "chapter_id": 3037, "verse_number": "१३-१६७-६", "content_sanskrit": "स्तनयोरेव चाकाशं बले चेन्द्रस्तथैव च।\nमनसोऽप्यथ चेशानस्त्वपाने रुद्र एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2095485, "chapter_id": 3037, "verse_number": "१३-१६७-७", "content_sanskrit": "गन्धर्वाप्सरसो व्याने सत्ये मित्रश्च शङ्कर।\nप्रज्ञायां वरुणश्चैव चक्षुष्यादित्य एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2095486, "chapter_id": 3037, "verse_number": "१३-१६७-८", "content_sanskrit": "शरीरे पृथिवी चैव पादयोर्विष्णुरेव च।\nपायौ मित्रस्तथोपस्थे प्रजापतिररिंदम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2095487, "chapter_id": 3037, "verse_number": "१३-१६७-९", "content_sanskrit": "मूर्ध्नि चैव दिशः प्राहुर्बुद्धौ ब्रह्मा प्रतिष्ठितः।\nबुध्यमानोऽऽत्मनिष्ठः स्यादधिष्ठाता तु शङ्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2095488, "chapter_id": 3037, "verse_number": "१३-१६७-१०", "content_sanskrit": "अबुद्धश्चाभवत्तस्माद्बुध्यमानान्न संशयः।\nआभ्यामन्यः परो बुद्धो वेदवादेषु शङ्कर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2095489, "chapter_id": 3037, "verse_number": "१३-१६७-११", "content_sanskrit": "यदाश्रितानि देहेषु दैवतानि पृथक्पृथक्।\nयोऽग्नये जायते नित्यमात्मयाजी समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2095490, "chapter_id": 3037, "verse_number": "१३-१६७-१२", "content_sanskrit": "य एवमनुपश्येत दैवतानि समाहितः।\nसोत्र योगी भवत्येव य एवमनुपश्यति।\nस सर्वज्ञयाजिभ्यो ह्यात्मयाजी विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2095491, "chapter_id": 3037, "verse_number": "१३-१६७-१३", "content_sanskrit": "मुखे जुहोति यो नित्यं कृत्स्नं विश्वमिदं जगत्।\nसोत्मवित्प्रोच्यते तज्ज्ञैर्महादेव महात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2095492, "chapter_id": 3037, "verse_number": "१३-१६७-१४", "content_sanskrit": "सर्वेभ्यः परमेभ्यो वै दैवतेभ्यो ह्यात्मयाजिना।\nगन्तव्यं परमाकाङ्क्षन्परमेव च चिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2095493, "chapter_id": 3037, "verse_number": "१३-१६७-१५", "content_sanskrit": "यथा संक्रमते देहाद्देही त्रिपुरसूदन।\nतथास्य स्थानमाख्यास्ये पृथक्त्वेनेह शङ्कर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2095494, "chapter_id": 3037, "verse_number": "१३-१६७-१६", "content_sanskrit": "पादाभ्यां वैष्णवं स्थानमाप्नोति विनियोजनात्।\nपायुना मित्रमाप्नोति उपस्थेन प्रजापतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2095495, "chapter_id": 3037, "verse_number": "१३-१६७-१७", "content_sanskrit": "नाभ्या च वारुणं स्थानं स्तनाभ्यां तु भवो लभेत्\nबाहुभ्यां वासवं स्थानं श्रोत्राभ्यामाप्नुयाद्दिशः।\nआदित्यं चक्षुषा स्थानं मूर्ध्ना ब्रह्मण एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2095496, "chapter_id": 3037, "verse_number": "१३-१६७-१८", "content_sanskrit": "अथ मूर्धसु यः प्राणान्धारयेत समाहितः।\nबुद्ध्या मानमवाप्नोति द्रव्यावस्थं च संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2095497, "chapter_id": 3037, "verse_number": "१३-१६७-१९", "content_sanskrit": "अव्यक्तात्परमं शुद्धमप्रमेयमनामयम्।\nतमाहुः परमं नित्यं यद्यदाप्नोति बुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2095498, "chapter_id": 3037, "verse_number": "१३-१६७-२०", "content_sanskrit": "बुध्यमानाप्रबुद्धाभ्यां स बुद्ध इति पठ्यते।\nबुध्यमानमबुद्धश्च नित्यमेवानुपश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2095499, "chapter_id": 3037, "verse_number": "१३-१६७-२१", "content_sanskrit": "विकारपुरुषस्त्वेष बुध्यमान इति स्मृतः।\nपञ्चविंशतितत्वं तत्प्रोच्यते तत्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2095500, "chapter_id": 3037, "verse_number": "१३-१६७-२२", "content_sanskrit": "स एष प्रकृतिस्थत्वात्तस्थुरित्युपदिश्यते।\nमहानात्मा महादेव महानत्राधितिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2095501, "chapter_id": 3037, "verse_number": "१३-१६७-२३", "content_sanskrit": "अधिष्ठानादधिष्ठाता प्रोच्यते शास्त्रदर्शनात्।\nएष चेतयते देव मोहजालमबुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2095502, "chapter_id": 3037, "verse_number": "१३-१६७-२४", "content_sanskrit": "अव्यक्तस्यैव साधर्म्यमेतदाहुर्मनीषिणः।\nसोहं सोहमतो नित्यादज्ञानादिति मन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2095503, "chapter_id": 3037, "verse_number": "१३-१६७-२५", "content_sanskrit": "यदि बुध्यति चैवायं मन्येयमिति भास्वरः।\nन प्रबुद्धो न वर्तेत पानीयं मत्स्यको यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2095504, "chapter_id": 3037, "verse_number": "१३-१६७-२६", "content_sanskrit": "देवता निखिलेनैताः प्रोक्तास्त्रिभुवनेश्वर।\nयोगकृत्यं तु तावन्मे त्वं निबोधानुपूर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2095505, "chapter_id": 3037, "verse_number": "१३-१६७-२७", "content_sanskrit": "शून्यागारेष्वरण्येषु सागरे वा गुहासु वा।\nविष्टम्भयित्वा त्रीन्दण्डानवाप्तो ह्यद्वयो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2095506, "chapter_id": 3037, "verse_number": "१३-१६७-२८", "content_sanskrit": "प्राङ्मुखोदङ्मुखो वापि तथा पश्चान्मुखोपि वा।\nदक्षिणावदनो वापि बद्ध्वा विधिवदासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2095507, "chapter_id": 3037, "verse_number": "१३-१६७-२९", "content_sanskrit": "स्वस्तिकेनोपसंविष्टः कायमुन्नाम्य भास्वरम्।\nयथोपदिष्टं गुरुणा तथा तद्ब्रह्म धारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2095508, "chapter_id": 3037, "verse_number": "१३-१६७-३०", "content_sanskrit": "लघ्वाहारो यतो दान्तस्त्रिकालपरिवर्जकः।\nमूत्रोत्सर्गपुरीषाभ्यामाहारे च समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2095509, "chapter_id": 3037, "verse_number": "१३-१६७-३१", "content_sanskrit": "शेषकालं तु युञ्जीत मनसा सुसमाहितः।\nइन्द्रियाणीन्द्रियार्थेभ्यो मनसा विनिवर्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2095510, "chapter_id": 3037, "verse_number": "१३-१६७-३२", "content_sanskrit": "मनस्तथैव सङ्गृह्य बुद्ध्या बुद्धिमतां वर।\nविधावमानं धैर्येण विस्फुरन्तमितस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2095511, "chapter_id": 3037, "verse_number": "१३-१६७-३३", "content_sanskrit": "निरुध्य सर्वसङ्कल्पांस्ततो वै स्थिरतां व्रजेत्।\nएकाग्रस्तद्विजानीयात्सर्वं गुह्यतमं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2095512, "chapter_id": 3037, "verse_number": "१३-१६७-३४", "content_sanskrit": "निवातस्थ इवालोलो यथा दीपोऽतिदीप्यते।\nऊर्ध्वमेव न तिर्यक्च तथैवाभ्रान्ति ते मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2095513, "chapter_id": 3037, "verse_number": "१३-१६७-३५", "content_sanskrit": "हृदिस्थस्तिष्ठते योसौ तस्यैवाभिमुखो यदा।\nमनो भवति देवेश पाषाणमिव निश्चलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2095514, "chapter_id": 3037, "verse_number": "१३-१६७-३६", "content_sanskrit": "स निर्जने विनिर्घोषे सघोषे चाऽऽवसञ्जने।\nयुक्तो यो न विकम्पेत योगी योगविधिः श्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2095515, "chapter_id": 3037, "verse_number": "१३-१६७-३७", "content_sanskrit": "ततः पश्यति तद्ब्रह्म ज्वलदात्मनि संस्थितम्।\nविद्युदम्बुधरे यद्वत्तद्वदेकमनाश्रयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2095516, "chapter_id": 3037, "verse_number": "१३-१६७-३८", "content_sanskrit": "तमस्यगाधे तिष्ठन्तं निस्तमस्कमचेतनम्।\nचेतयानमचेतं च दीप्यमानं स्वतेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2095517, "chapter_id": 3037, "verse_number": "१३-१६७-३९", "content_sanskrit": "अङ्गष्ठपर्वमात्रं तन्नैश्रेयसमनिन्दितम्।\nमहद्भूतमनन्तं च स्वतन्त्रं विगतज्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2095518, "chapter_id": 3037, "verse_number": "१३-१६७-४०", "content_sanskrit": "ज्योतिषां ज्योतिषं देवं विष्णुमत्यन्तनिर्मलम्।\nनारायणमणीयांसमीश्वराणामधीश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2095519, "chapter_id": 3037, "verse_number": "१३-१६७-४१", "content_sanskrit": "विश्वतः परमं नित्यं विश्वं नारायणं प्रभुम्।\nअविज्ञाय निमज्जन्ति लोकाः संसारसागरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2095520, "chapter_id": 3037, "verse_number": "१३-१६७-४२", "content_sanskrit": "यं दृष्ट्वा यतयस्तात न शोचन्ति गतज्वराः।\nजन्ममृत्युभयान्मुक्तास्तीर्णाः संसारसागरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2095521, "chapter_id": 3037, "verse_number": "१३-१६७-४३", "content_sanskrit": "अणिमा लघिमा भूमा प्राप्तिः प्राकम्यमेव च।\nईशित्वं च वशित्वं च यत्र कामावसायिता।\nएतदष्टुगुणं योगं योगानाममितं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2095522, "chapter_id": 3037, "verse_number": "१३-१६७-४४", "content_sanskrit": "दृष्ट्वात्मानं निरात्मानमप्रमेयं सनातनम्।\nते विशन्ति शरीराणि योगेनानेन भास्वरम्।\nदैत्यदेवमनुष्याणां बलेन बलवत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2095523, "chapter_id": 3037, "verse_number": "१३-१६७-४५", "content_sanskrit": "एतत्तत्वमनाद्यन्तं यद्भवाननुपृच्छति।\nनित्यं वयमुपास्यामो योगधर्मं सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2095524, "chapter_id": 3037, "verse_number": "१३-१६७-४६", "content_sanskrit": "योगधर्मान्न धर्मोस्ति गरीयान्सुरसत्तम।\nएतद्धर्म हि धर्माणामपुनर्भवसंस्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2095525, "chapter_id": 3037, "verse_number": "१३-१६७-४७", "content_sanskrit": "तत्वतः परमस्तीस्ति केचिदाहुर्मनीषिणः।\nकेचिदाहुः परं नास्ति ये ज्ञानफलमाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2095526, "chapter_id": 3037, "verse_number": "१३-१६७-४८", "content_sanskrit": "ज्ञानस्थः पुरुषस्त्वेष विकृतः स्वेन वर्णितः।\nये ध्यानेनानुपश्यन्ति नित्यं योगपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2095527, "chapter_id": 3037, "verse_number": "१३-१६७-४९", "content_sanskrit": "तमेव पुरुषं देवं केचिदेव महेश्वर।\nनित्यमन्यतमाः प्राहुर्ज्ञानं परमकं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2095528, "chapter_id": 3037, "verse_number": "१३-१६७-५०", "content_sanskrit": "ज्ञानमेव विनिर्मुक्ताः सांख्या गच्छन्ति केवलम्।\nचिन्ताध्यात्मनि चान्यत्र योगाः परमबुद्धयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2095529, "chapter_id": 3037, "verse_number": "१३-१६७-५१", "content_sanskrit": "उक्तमेतावदेतत्ते योगदर्शनमुत्तमम्।\nसाङ्ख्यज्ञानं प्रवक्ष्यामि परिसंख्याविदर्शनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2095530, "chapter_id": 3037, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्तषष्ट्यधिकशततमोऽध्यायः॥ १६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]