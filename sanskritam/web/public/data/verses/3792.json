[{"id": 2129700, "chapter_id": 3792, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2129701, "chapter_id": 3792, "verse_number": "१", "content_sanskrit": "भरद्वाजस्तु कौन्तेय कृत्वा स्वाध्यायमाह्निकम्।\nसमित्कलापमादाय प्रविवेश स्वमाश्रमम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2129702, "chapter_id": 3792, "verse_number": "२", "content_sanskrit": "तं स्म दृष्ट्वा पुरा सर्वे प्रत्युत्तिष्ठन्ति पावकाः ।\nन त्वेनमुपतिष्ठन्ति हतपुत्रं तदाऽग्नयः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2129703, "chapter_id": 3792, "verse_number": "३", "content_sanskrit": "पुत्रमृत्युजमाशौचं भरद्वाजो न जज्ञिवान् ।\nवैकृतं त्वग्निहोत्रे स लक्षयित्वा महातपाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2129704, "chapter_id": 3792, "verse_number": "४", "content_sanskrit": "तमन्धं शूद्रमासीनं गृहपालमथाब्रवीत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2129705, "chapter_id": 3792, "verse_number": "५", "content_sanskrit": "किं नु मे नाग्नयः शूद्र प्रतिनन्दन्ति दर्शनम् ।\nत्वं चापि न यथापूर्वं कच्चित्क्षेममिहाश्रमे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2129706, "chapter_id": 3792, "verse_number": "६", "content_sanskrit": "कच्चिन्न रैभ्यं पुत्रो मे गतवानल्पचेतनः ।\nएतदाचक्ष्व मे शीघ्रं न हि शुद्ध्यति मे मनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2129707, "chapter_id": 3792, "verse_number": "", "content_sanskrit": "शूद्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2129708, "chapter_id": 3792, "verse_number": "७", "content_sanskrit": "रैभ्यं यातो नूनमयं पुत्रस्ते मन्दचेतनः ।\nतथा हि निहतः शेते राक्षसेन बलीयसा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2129709, "chapter_id": 3792, "verse_number": "८", "content_sanskrit": "प्रकाल्यमानस्तेनायं शूलहस्तेन रक्षसा ।\nअग्न्यागारं प्रति द्वारि मया दोर्भ्यां निवारितः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2129710, "chapter_id": 3792, "verse_number": "९", "content_sanskrit": "ततः स विहताशोऽत्र जलकामोऽशुचिर्ध्रुवम् ।\nनिहतः सोऽतिवेगेन शूलहस्तेन रक्षसा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2129711, "chapter_id": 3792, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2129712, "chapter_id": 3792, "verse_number": "१०", "content_sanskrit": "भरद्वाजस्तु तच्छ्रुत्वा शूद्रस्य विप्रियं महत् ।\nगतासुं पुत्रमादाय विललाप सुदुःखितः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2129713, "chapter_id": 3792, "verse_number": "", "content_sanskrit": "भरद्वाजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2129714, "chapter_id": 3792, "verse_number": "११", "content_sanskrit": "ब्राह्मणानां किलार्थाय ननु त्वं तप्तवांस्तपः ।\nद्विजानामनधीता वै वेदाः सम्प्रति भान्त्विति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2129715, "chapter_id": 3792, "verse_number": "१२", "content_sanskrit": "तथा कल्याणशीलस्त्वं ब्राह्मणेषु महात्मसु ।\nअनागाः सर्वभूतेषु कर्कशत्वमुपेयिवान्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2129716, "chapter_id": 3792, "verse_number": "१३", "content_sanskrit": "प्रतिषिद्धो मया तात रैभ्यावसथदर्शनात् ।\nगतवानेव तं द्रष्टुं कालान्तकयमोपमम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2129717, "chapter_id": 3792, "verse_number": "१४", "content_sanskrit": "यः स जानन् महातेजा वृद्धस्यैकं ममात्मजम् ।\nगतवानेव कोपस्य वशं परमदुर्मतिः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2129718, "chapter_id": 3792, "verse_number": "१५", "content_sanskrit": "पुत्रशोकमनुप्राप्त एष रैभ्यस्य कर्मणा ।\nत्यक्ष्यामि त्वामृते पुत्र प्राणानिष्टतमान् भुवि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2129719, "chapter_id": 3792, "verse_number": "१६", "content_sanskrit": "यथाहं पुत्रशोकेन देहं त्यक्ष्यामि किल्बिषी ।\nतथा ज्येष्ठः सुतो रैभ्यं हिंस्याच्छीघ्रमनागसम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2129720, "chapter_id": 3792, "verse_number": "१७", "content_sanskrit": "सुखिनो वै नरा येषां जात्या पुत्रो न विद्यते ।\nते पुत्रशोकमप्राप्य विचरन्ति यथासुखम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2129721, "chapter_id": 3792, "verse_number": "१८", "content_sanskrit": "ये तु पुत्रकृताच्छोकाद् भृशं व्याकुलचेतसः ।\nशपन्तीष्टान् सखीनार्तास्तेभ्यः पापतरो नु कः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2129722, "chapter_id": 3792, "verse_number": "१९", "content_sanskrit": "परासुश्च सुतो दृष्टः शप्तश्चेष्टः सखा मया ।\nईदृशीमापदं कोऽत्र द्वितीयोऽनुभविष्यति\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2129723, "chapter_id": 3792, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2129724, "chapter_id": 3792, "verse_number": "२०", "content_sanskrit": "विलप्यैवं बहुविधं भरद्वाजोऽदहत्सुतम् ।\nसुसमिद्धं ततः पश्चात् प्रविवेश हुताशनम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2129725, "chapter_id": 3792, "verse_number": "१३४", "content_sanskrit": "॥ इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि चतुस्त्रिंशदधिकशततमोऽध्यायः ॥ १३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2129726, "chapter_id": 3792, "verse_number": "", "content_sanskrit": "॥ इति तीर्थयात्रापर्वणि नवतितमोऽध्यायः ॥९०॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]