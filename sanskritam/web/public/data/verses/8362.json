[{"id": 900004796, "chapter_id": 8362, "verse_number": "8.1", "content_sanskrit": "‘ब्रह्मा शिवः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900004797, "chapter_id": 8362, "verse_number": "8.2", "content_sanskrit": "‘यं कामये तं तमुग्रं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900004798, "chapter_id": 8362, "verse_number": "8.3", "content_sanskrit": "यस्मात्परं नापरमस्ति किञ्चित्’ ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900004799, "chapter_id": 8362, "verse_number": "8.4", "content_sanskrit": "नामानि सर्वाणि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900004800, "chapter_id": 8362, "verse_number": "8.5", "content_sanskrit": "‘उत्पत्तिर्वासुदेवस्य प्रादुर्भावो ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]