[{"id": 2044601, "chapter_id": 1998, "verse_number": "६-४७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2044602, "chapter_id": 1998, "verse_number": "६-४७-१", "content_sanskrit": "गतपूर्वाह्णभूयिष्ठि तस्मिन्नहनि दारुणे।\nवर्तमाने तथा रौद्रे महावीरवरक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2044603, "chapter_id": 1998, "verse_number": "६-४७-२", "content_sanskrit": "दुर्मुखः कृतवर्मा च कृपः शल्यो विविंशतिः।\nभीष्मं जुगुपुरासाद्य तव पुत्रेण चोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2044604, "chapter_id": 1998, "verse_number": "६-४७-३", "content_sanskrit": "एतैरतिरथैर्गुप्तः पञ्चभिर्भरतर्षभः ।\nपाण्डवानामनीकानि विजगाहे महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2044605, "chapter_id": 1998, "verse_number": "६-४७-४", "content_sanskrit": "चेदिकाशिकरूषेषु पञ्चालेषु च भारत ।\nभीष्मस्य बहुधा तालश्चलत्केतुरदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2044606, "chapter_id": 1998, "verse_number": "६-४७-५", "content_sanskrit": "स शिरांसि रणेऽरीणां रथांश्च सयुगध्वजान् ।\nनिचकर्त महावेगैर्भल्लैः सन्नतपर्वभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2044607, "chapter_id": 1998, "verse_number": "६-४७-६", "content_sanskrit": "नृत्यतो रथमार्गेषु भीष्मस्य भरतर्षभ ।\nभृशमार्तस्वरं चक्रुर्नागा मर्मणि ताडिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2044608, "chapter_id": 1998, "verse_number": "६-४७-७", "content_sanskrit": "अभिमन्युः सुसंक्रुद्धः पिशह्गैस्तुरगोत्तमैः ।\nसंयुक्तं रथमास्थाय प्रायाद्भीष्मरथं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2044609, "chapter_id": 1998, "verse_number": "६-४७-८", "content_sanskrit": "जाम्बूनदविचित्रेण कर्णिकारेण केतुना ।\nअभ्यवर्तत भीष्मं च तांश्चैव रथसत्तमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2044610, "chapter_id": 1998, "verse_number": "६-४७-९", "content_sanskrit": "स तालकेतोस्तीक्ष्णेन केतुमाहत्य पत्रिणा ।\nभीष्मेण युयुधे वीरस्तस्य चानुरथैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2044611, "chapter_id": 1998, "verse_number": "६-४७-१०", "content_sanskrit": "कृतवर्माणमेकेन शल्यं पञ्चभिराशुगैः ।\nविद्ध्वा नवभिरानर्च्छच्छिताग्रैः प्रतिपामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2044612, "chapter_id": 1998, "verse_number": "६-४७-११", "content_sanskrit": "पूर्णायतविसृष्टेन सम्यक्प्रणिहितेन च।\nध्वजमेकेन विव्याध जाम्बूनदपरिष्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2044613, "chapter_id": 1998, "verse_number": "६-४७-१२", "content_sanskrit": "दुर्मुखस्य तु भल्लेन सर्वावरणभेदिना ।\nजहार सारथेः कायाच्छिरः सन्नतपर्वणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2044614, "chapter_id": 1998, "verse_number": "६-४७-१३", "content_sanskrit": "धनुश्चिच्छेद भल्लेन कार्तस्वरविभूषितम्।\nकृपस्य निशिताग्रेण तांश्च तीक्ष्णमुखैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2044615, "chapter_id": 1998, "verse_number": "६-४७-१४", "content_sanskrit": "जघान परमक्रुद्धो नृत्यन्निव महारथः ।\nतस्य लाघवमुद्वीक्ष्य तुतुषुर्देवता अपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2044616, "chapter_id": 1998, "verse_number": "६-४७-१५", "content_sanskrit": "लब्धलक्षतया कार्ष्णेः सर्वे भीष्ममुखा रथाः ।\nसत्ववन्तममन्यन्त साक्षादिव धनंजयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2044617, "chapter_id": 1998, "verse_number": "६-४७-१६", "content_sanskrit": "तस्य लाघवमार्गस्थमलातसदृशप्रभम्।\nदिशः पर्यपतच्चापं गाण्डीवमिव घोषवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2044618, "chapter_id": 1998, "verse_number": "६-४७-१७", "content_sanskrit": "तमासाद्य महावेगैर्भीष्मो नव्रभिराशुगैः ।\nविव्याध समरे तूर्णमार्जुनिं परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2044619, "chapter_id": 1998, "verse_number": "६-४७-१८", "content_sanskrit": "ध्वजं चास्य त्रिभिर्भल्लैश्चिच्छेद परमौजसः ।\nसारथिं च त्रिभिर्बाणैराजघान यतव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2044620, "chapter_id": 1998, "verse_number": "६-४७-१९", "content_sanskrit": "तथैव कृतवर्मा च कृपः शल्यश्च मारिष ।\nविद्ध्वा नाकम्पयत्कार्ष्णिं मैनाकमिव पर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2044621, "chapter_id": 1998, "verse_number": "६-४७-२०", "content_sanskrit": "स तैः परिवृतः शूरो धार्तराष्ट्रैर्महारथैः ।\nववर्ष शरवर्षाणि कार्ष्णिः पञ्चरथान्प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2044622, "chapter_id": 1998, "verse_number": "६-४७-२१", "content_sanskrit": "ततस्तेषां सहस्राणि संवार्य शरवृष्टिभिः ।\nननाद बलवान्कार्ष्णिर्भीष्माय विसृज्यञ्शरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2044623, "chapter_id": 1998, "verse_number": "६-४७-२२", "content_sanskrit": "तत्रास्य सुमहद्राजन्बाह्वोर्बलमदृश्यत ।\nयतमानस्य समरे भीष्ममर्दयतः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2044624, "chapter_id": 1998, "verse_number": "६-४७-२३", "content_sanskrit": "पराक्रान्तस्य तस्यैव भीष्मोऽपि प्राहिणोच्छरान् ।\nस तांश्चिच्छेद समरे भीष्मचापच्युताञ्शरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2044625, "chapter_id": 1998, "verse_number": "६-४७-२४", "content_sanskrit": "ततो ध्वजमामोघेंषुर्भीष्मस्य नवभिः शरैः ।\nचिच्छेद समरे वीरस्तत उच्चुक्रुशुर्जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2044626, "chapter_id": 1998, "verse_number": "६-४७-२५", "content_sanskrit": "स राजतो महास्कन्धस्तालो हेमविभूषितः ।\nसौभद्रविशिखैश्छिन्नः पपात भुवि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2044627, "chapter_id": 1998, "verse_number": "६-४७-२६", "content_sanskrit": "तं तु सौभद्रविशिखैः पातितं भरतर्षभ ।\nदृष्ट्वा भीमो ननादोच्चैः सौभद्रमभिहर्षयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2044628, "chapter_id": 1998, "verse_number": "६-४७-२७", "content_sanskrit": "अथ भीष्मो महास्राणि दिव्यानि सुबहूनि च ।\nप्रादुश्चक्रे महारौद्रे रणे तस्मिन्महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2044629, "chapter_id": 1998, "verse_number": "६-४७-२८", "content_sanskrit": "ततः शरसहस्रेण सौभद्रं प्रतितामहः ।\nअवाकिरदमेयात्मा तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2044630, "chapter_id": 1998, "verse_number": "६-४७-२९", "content_sanskrit": "ततो दश महेष्वासाः पाण्डवानां महारथाः ।\nरक्षार्थमभ्यधावन्त सौभद्रं त्वरिता रथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2044631, "chapter_id": 1998, "verse_number": "६-४७-३०", "content_sanskrit": "विराटः सह पुत्रेण धृष्टद्युम्नश्च पार्षतः ।\nभीमश्च केकयाश्चैव सात्यकिश्च विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2044632, "chapter_id": 1998, "verse_number": "६-४७-३१", "content_sanskrit": "तेषां जवेनापततां भीष्मः शान्तनवो रणे ।\nपाञ्चाल्यं त्रिभिरानर्च्छत्सात्यकिं नवभिः शरैः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2044633, "chapter_id": 1998, "verse_number": "६-४७-३२", "content_sanskrit": "पूर्णायतविसृष्टेन क्षुरेण निशितेन च।\nध्वजमेकेन चिच्छेद भीमसेनस्य पत्रिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2044634, "chapter_id": 1998, "verse_number": "६-४७-३३", "content_sanskrit": "जाम्बूनदमयः श्रीमान्केसरी स नरोत्तम ।\nपपात भीमसेनस्य भीष्मेण मथितो रथात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2044635, "chapter_id": 1998, "verse_number": "६-४७-३४", "content_sanskrit": "ततो भीमस्त्रिभिर्विद्ध्वा भीष्मं शान्तनवं रणे।\nकृपमेकेन विव्याध कृतवर्माणमष्टभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2044636, "chapter_id": 1998, "verse_number": "६-४७-३५", "content_sanskrit": "प्रगृहीताग्रहस्तेकन वैराटिरपि दन्तिना ।\nअभ्यद्रवत राजानं मद्राधिपतिमुत्तरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2044637, "chapter_id": 1998, "verse_number": "६-४७-३६", "content_sanskrit": "तस्य वारणराजस्य जवेनापततो रथे ।\nशल्यो निवारयामास वेगमप्रतिमं शरैः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2044638, "chapter_id": 1998, "verse_number": "६-४७-३७", "content_sanskrit": "तस्य क्रुद्धः स नागेन्द्रो बृहतः साधुवाहिनः ।\nपदा युगमधिष्ठाय जघान चतुरो हयान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2044639, "chapter_id": 1998, "verse_number": "६-४७-३८", "content_sanskrit": "स हताश्वे रथे तिष्ठन्मद्राधिपतिरायसीम् ।\nउत्तरान्तकरीं शक्तिं चिक्षेप भुजगोपमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2044640, "chapter_id": 1998, "verse_number": "६-४७-३९", "content_sanskrit": "तया भिन्नतनुत्राणः प्रविश्य विपुलं तमः।\nस पपात गजस्कन्धात्परमुक्ताङ्कुशतोमरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2044641, "chapter_id": 1998, "verse_number": "६-४७-४०", "content_sanskrit": "असिमादाय शल्योऽपि अवप्लुत्य रथोत्तमात्।\nतस्य वारणराजस्य चिच्छेदाथ महाकरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2044642, "chapter_id": 1998, "verse_number": "६-४७-४१", "content_sanskrit": "भिन्नमर्मा शरशतैश्छिन्नहस्तः सवारणः।\nभीममार्तस्वरं कृत्वा पपात च ममार च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2044643, "chapter_id": 1998, "verse_number": "६-४७-४२", "content_sanskrit": "एतदीदृशकं कृत्वा मद्रराजो नराधिप ।\nआरुरोह रथं तूर्णं भास्वरं कृतवर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2044644, "chapter_id": 1998, "verse_number": "६-४७-४३", "content_sanskrit": "उत्तरं वै हतं दृष्ट्वा वैराटिर्भ्रातरं तदा ।\nकृतवर्मणा च सहितं दृष्ट्वा शल्यमवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2044645, "chapter_id": 1998, "verse_number": "६-४७-४४", "content_sanskrit": "श्वेतः क्रोधात्प्रजज्वाल हविषा हव्यवाडिव ।\nस विस्फार्य महच्चापं शक्रचापोपमं बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2044646, "chapter_id": 1998, "verse_number": "६-४७-४५", "content_sanskrit": "अभ्यधाव़ञ्जिघांसन्वै शल्यं मद्राधिपं बली।\nमहता रथवंशेन समन्तात्परिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2044647, "chapter_id": 1998, "verse_number": "६-४७-४६", "content_sanskrit": "मुञ्चन्बाणमयं वर्षं प्रायाच्छल्यरथं प्रति।\nतमापतन्तं संप्रेक्ष्य मत्तवारणविक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2044648, "chapter_id": 1998, "verse_number": "६-४७-४७", "content_sanskrit": "तावकानां रथाः सप्त समन्तात्पर्यवारयन् ।\nमद्रराजमभीप्सन्तो मृत्योर्दंष्ट्रान्तरं गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2044649, "chapter_id": 1998, "verse_number": "६-४७-४८", "content_sanskrit": "बृहद्बलश्च कौसल्यो जयत्सेनश्च मागधः ।\nतथा रुक्मरथो राजञ्शल्यपुत्रः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2044650, "chapter_id": 1998, "verse_number": "६-४७-४९", "content_sanskrit": "विन्दानुविन्दावावान्त्यौ काम्भोजश्च सुदक्षिणः ।\nबृहत्क्षत्रस्य दायादः सैन्धवश्च जयद्रथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2044651, "chapter_id": 1998, "verse_number": "६-४७-५०", "content_sanskrit": "नानावर्णविचित्राणि धनूंषि च महात्मनाम् ।\nविस्फारितानि दृश्यन्ते तोयदेष्विव विद्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2044652, "chapter_id": 1998, "verse_number": "६-४७-५१", "content_sanskrit": "ते तु बाणमयं वर्षं श्वेतमूर्धन्यपातयन्।\nनिदाघान्तेऽनिलोद्धूता मेघा इव नगे जलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2044653, "chapter_id": 1998, "verse_number": "६-४७-५२", "content_sanskrit": "ततः क्रुद्धो महेष्वासः सप्तभल्लैः सुतेजनैः ।\nधनूंषि तेषामाच्छिद्य ममर्द पृतनापतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2044654, "chapter_id": 1998, "verse_number": "६-४७-५३", "content_sanskrit": "निकृत्तान्येव तानि स्म समदृश्यन्त भारत ।\nततस्ते तु निमेषार्धात्प्रत्यपद्यन्धनूंषि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2044655, "chapter_id": 1998, "verse_number": "६-४७-५४", "content_sanskrit": "सप्त चैव पृषत्कांश्च श्वेतस्योपर्यपातयन्।\nततः पुनरमेयात्मा भल्लैः सप्तभिराशुगैः ।\nनिचकर्त महाबाहुस्तेषां चापानि धन्विनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2044656, "chapter_id": 1998, "verse_number": "६-४७-५५", "content_sanskrit": "ते निकृत्तमहाचापास्त्वरमाणा महारथाः ।\nरथशक्तीः परामृश्य विनेदुर्भैरवान्रवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2044657, "chapter_id": 1998, "verse_number": "६-४७-५६", "content_sanskrit": "अन्वयुर्भरतश्रेष्ठ सप्त श्वेतरथं प्रति।\nततस्ता ज्वलिताः सप्त महेन्द्राशनिनिःस्वनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2044658, "chapter_id": 1998, "verse_number": "६-४७-५७", "content_sanskrit": "अप्राप्ताः सप्तभिर्भल्लैश्चिच्छेद परमास्त्रवित्। ६-४७-५७bततः समादाय शरं सर्वकायविदारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2044659, "chapter_id": 1998, "verse_number": "६-४७-५८", "content_sanskrit": "प्राहिणोद्भरतश्रेष्ठ श्वेतो रुक्मरथं प्रति।\nतस्य देहे निपतितो बाणो वज्रातिगो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2044660, "chapter_id": 1998, "verse_number": "६-४७-५९", "content_sanskrit": "ततो रुक्मरथो राजन्सायकेन दृढाहतः ।\nनिषसाद रथोपस्थे कश्मलं चाविशन्महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2044661, "chapter_id": 1998, "verse_number": "६-४७-६०", "content_sanskrit": "तं विसंज्ञं विमनसं त्वरमाणस्तु सारथिः ।\nअपोवाह नसंभ्रान्तः सर्वलोकस्य पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2044662, "chapter_id": 1998, "verse_number": "६-४७-६१", "content_sanskrit": "ततोऽन्यान्षट् समादाय श्वेतो हेमविभूषितान् ।\nतेषां षण्मां महाबाहुर्ध्वजशीर्षण्यपातयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2044663, "chapter_id": 1998, "verse_number": "६-४७-६२", "content_sanskrit": "हयांश्च तेषां निर्भिद्य सारथींश्च परंतप ।\nशरैश्चैतान्समाकीर्य प्रायाच्छल्यरथं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2044664, "chapter_id": 1998, "verse_number": "६-४७-६३", "content_sanskrit": "ततो हलहलाशब्दस्तव सैन्येषु भारत।\nदृष्ट्वा सेनापतिं तूर्णं यान्तं शल्यरथं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2044665, "chapter_id": 1998, "verse_number": "६-४७-६४", "content_sanskrit": "ततो भीष्मं पुरस्कृत्य तव पुत्रो महाबलः ।\nवृतस्तु सर्वसैन्येन प्रायाच्छ्वेतरथं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2044666, "chapter_id": 1998, "verse_number": "६-४७-६५", "content_sanskrit": "मृत्योरास्यमनुप्राप्तं मद्रराजममोचयत् ।\nततो युद्धं समभवत्तुमुलं रोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2044667, "chapter_id": 1998, "verse_number": "६-४७-६६", "content_sanskrit": "तावकानां परेषां च व्यतिषक्तरथद्विपम् ।\nसौभद्रे भीमसेन च सात्यकौ च महारथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2044668, "chapter_id": 1998, "verse_number": "६-४७-६७", "content_sanskrit": "कैकेये च विराटे च धृष्टद्युम्ने च पार्षते ।\nएतेषु नरसिंहेषु चेदिमत्स्येषु चैव ह ।\nववर्ष शरवर्षाणि कुरुवृद्धः पितामहः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2044669, "chapter_id": 1998, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि प्रथमदिवसयुद्धे सप्तचत्वारिंशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]