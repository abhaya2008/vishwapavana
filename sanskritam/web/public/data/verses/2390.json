[{"id": 2065725, "chapter_id": 2390, "verse_number": "९-८-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2065726, "chapter_id": 2390, "verse_number": "९-८-१", "content_sanskrit": "ततः प्रववृते युद्धं कुरूणां भयवर्धनम्।\nसृञ्जयैः सह राजेन्द्र घोरं देवासुरोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2065727, "chapter_id": 2390, "verse_number": "९-८-२", "content_sanskrit": "नरा रथा गजौघाश्च वाजिनश्च सहस्रशः।\nवाजिनश्च पराक्रान्ताः समाजग्मुः परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2065728, "chapter_id": 2390, "verse_number": "९-८-३", "content_sanskrit": "गजानां भीमरूपाणां द्रवतां निःस्वनो महान्।\nअश्रूयत यथा काले जलदानां नभस्तले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2065729, "chapter_id": 2390, "verse_number": "९-८-४", "content_sanskrit": "नागैरभ्याहताः केचित्सरथा रथिनोऽपतन्।\nव्यद्रवन्त रणे भीता द्राव्यमाणा मदोत्कटैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2065730, "chapter_id": 2390, "verse_number": "९-८-५", "content_sanskrit": "हयौघान्पादरक्षांश्च रथिनस्तत्र शिक्षिताः।\nशरैः सम्प्रेषयामासुः परलोकाय भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2065731, "chapter_id": 2390, "verse_number": "९-८-६", "content_sanskrit": "सादिनः शिक्षिता राजन्परिवार्य महारथान्।\nविचरन्तो रणेऽभ्यघ्नन्प्रासशक्त्यृष्टिभिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2065732, "chapter_id": 2390, "verse_number": "९-८-७", "content_sanskrit": "धन्विनः पुरुषाः केचित्परिवार्य महारथान्।\nएकं बहव आसाद्य प्रैषयन्यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2065733, "chapter_id": 2390, "verse_number": "९-८-८", "content_sanskrit": "नागान्रथवरांश्चान्ये परिवार्य महारथाः।\nसोत्तरा युधि निर्जघ्नुर्द्रवमाणं महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2065734, "chapter_id": 2390, "verse_number": "९-८-९", "content_sanskrit": "तथा च रथिनं क्रुद्धं विकिरन्तं शरान्बहून्।\nनागा जघ्नुर्महाराज परिवार्य समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2065735, "chapter_id": 2390, "verse_number": "९-८-१०", "content_sanskrit": "नागा नागमभिद्रुत्य रथी च रथिनं रणे।\nशक्तितोमरनाराचैर्निजघ्नुस्तत्र भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2065736, "chapter_id": 2390, "verse_number": "९-८-११", "content_sanskrit": "पादातानवमृद्गन्तो रथवारणवाजिनः।\nरणमध्ये व्यदृश्यन्त कुर्वन्तो महदाकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2065737, "chapter_id": 2390, "verse_number": "९-८-१२", "content_sanskrit": "हयाश्च पर्यधावन्त चामरैरुपशोभिताः।\nहंसा हिमवतः प्रस्थे पिबन्त इव मेदिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2065738, "chapter_id": 2390, "verse_number": "९-८-१३", "content_sanskrit": "तेषां तु वाजिनां भूमिः खुरैश्चित्रा विशाम्पते।\nअशोभत यथा नारी करजैः क्षतविक्षता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2065739, "chapter_id": 2390, "verse_number": "९-८-१४", "content_sanskrit": "वाजिनां खुरशब्देन रथनेमिस्वनेन च।\nपत्तीनां चापि शब्देन नागानां बृंहितेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2065740, "chapter_id": 2390, "verse_number": "९-८-१५", "content_sanskrit": "वादित्राणां च घोषेण शङ्खानां निनदेन च।\nअभवन्नादिता भूमिर्निर्घातैरिव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2065741, "chapter_id": 2390, "verse_number": "९-८-१६", "content_sanskrit": "धनुषां कूजमानानां शस्त्रौघानां च पात्यताम्।\nकवचानां प्रभाभिश्च न प्राज्ञायत किञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2065742, "chapter_id": 2390, "verse_number": "९-८-१७", "content_sanskrit": "बहवो बाहवश्छिन्ना नागराजकरोपमाः।\nउद्वेष्टन्ते विचेष्टन्ते वेगं कुर्वन्ति दारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2065743, "chapter_id": 2390, "verse_number": "९-८-१८", "content_sanskrit": "शिरसां च महाराज पततां धरणीतले।\nच्युतानामिव तालेभ्यः फलानां श्रूयते स्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2065744, "chapter_id": 2390, "verse_number": "९-८-१९", "content_sanskrit": "शिरोभिः पतितैर्भाति रुधिरार्द्रैर्वसुन्धरा।\nतपनीयनिभैः काले नलिनैरिव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2065745, "chapter_id": 2390, "verse_number": "९-८-२०", "content_sanskrit": "उद्वृत्तनयनैस्तैस्तु गतसत्वैः सुविक्षतैः।\nव्यभ्राजत मही राजन्पुण्डरीकैरिवावृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2065746, "chapter_id": 2390, "verse_number": "९-८-२१", "content_sanskrit": "बाहुभिश्चन्दनादिग्धैः सकेयूरैर्महारधनैः।\nपतितैर्भाति राजेन्द्र महाशक्रध्वजैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2065747, "chapter_id": 2390, "verse_number": "९-८-२२", "content_sanskrit": "ऊरुभिश्च नरेन्द्राणां विनिकृत्तैर्महाहवे।\nहस्तिहस्तोपमैर्जज्ञे संवृतं तद्रणाङ्कणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2065748, "chapter_id": 2390, "verse_number": "९-८-२३", "content_sanskrit": "कबन्धंशतसङ्कीर्णं छत्रचामरसङ्कुलम्।\nसेनावनं तच्छुशुभे वनं पुष्पाचितं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2065749, "chapter_id": 2390, "verse_number": "९-८-२४", "content_sanskrit": "तत्र योधा महाराज विचरन्तो ह्यभीतवत्।\nदृश्यन्ते रुधिराक्ताङ्गाः पुष्पिता इव किंशुकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2065750, "chapter_id": 2390, "verse_number": "९-८-२५", "content_sanskrit": "मातङ्गाश्चाप्यदृश्यन्त शरतोमरपीडिताः।\nपतन्तस्तत्र तवैव छिन्नाभ्रासदृशा रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2065751, "chapter_id": 2390, "verse_number": "९-८-२६", "content_sanskrit": "गजानीकं महाराज वध्यमानं महात्मभिः।\nव्यदीर्यत दिशः सर्वा वातनुन्ना धना इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2065752, "chapter_id": 2390, "verse_number": "९-८-२७", "content_sanskrit": "ते गजा धनसङ्काशाः पेतुरुर्व्यां समन्ततः।\nवज्रनुन्ना इव बभुः पर्वता युगसङ्क्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2065753, "chapter_id": 2390, "verse_number": "९-८-२८", "content_sanskrit": "हयानां सादिभिः सार्धं पतितानां महीतले।\nराशयः स्म प्रदृश्यन्ते गिरिमात्रांस्ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2065754, "chapter_id": 2390, "verse_number": "९-८-२९", "content_sanskrit": "सञ्जज्ञे रणभूमौ तु परलोकवहा नदी।\nशोणितोदा रथावर्ता ध्वजवृक्षास्थिशर्करा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2065755, "chapter_id": 2390, "verse_number": "९-८-३०", "content_sanskrit": "भुजनक्रा धनुःस्रोता हस्तिशैला हयोपला।\nमेदोमज्जाकर्दमिनी छत्रहंसा गदोडुपा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2065756, "chapter_id": 2390, "verse_number": "९-८-३१", "content_sanskrit": "कवचोष्णीषसञ्छन्ना पताकारुचिरद्रुमा।\nचक्रचक्रावलीजुष्टा त्रिवेणूरगसंवृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2065757, "chapter_id": 2390, "verse_number": "९-८-३२", "content_sanskrit": "शूराणां हर्षजननी भीरूणां भयवर्धनी।\nप्रावर्तत नदी रौद्रा कुरुसृञ्जयसङ्गमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2065758, "chapter_id": 2390, "verse_number": "९-८-३३", "content_sanskrit": "तां नदीं परलोकाय वहन्तीमतिभैरवाम्।\nतेरुर्वाहननौभिस्ते शूराः परिघबाहवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2065759, "chapter_id": 2390, "verse_number": "९-८-३४", "content_sanskrit": "वर्तमाने तदा युद्धे निर्मर्यादे विशाम्पते।\nचतुरङ्गक्षये घोरे युद्धे देवासुरोपमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2065760, "chapter_id": 2390, "verse_number": "९-८-३५", "content_sanskrit": "व्याक्रोशन्बान्धवानन्ये तत्र तत्र परन्तप।\nक्रोशद्भिर्दयितैरन्ये भयार्ता न निवर्तिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2065761, "chapter_id": 2390, "verse_number": "९-८-३६", "content_sanskrit": "निर्मर्यादे तथा युद्धे वर्तमाने भयानके।\nअर्जुनो भीमसेनश्च मोहयाञ्चक्रतुः परान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2065762, "chapter_id": 2390, "verse_number": "९-८-३७", "content_sanskrit": "सा वध्यमाना महती सेना तव नराधिप।\nअमुह्यत्तत्र तत्रैव योषिन्मदवशादिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2065763, "chapter_id": 2390, "verse_number": "९-८-३८", "content_sanskrit": "मोहयित्वा च तां सेनां भीमसेनधनञ्जयौ।\nदध्मतुर्वारिजौ तत्र सिंहनादांश्च चक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2065764, "chapter_id": 2390, "verse_number": "९-८-३९", "content_sanskrit": "श्रुत्वैव तु महाशब्दं धृष्टद्युम्नशिखण्डिनौ।\nधर्मराजं पुरस्कृत्य मद्रराजमभिद्रुतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2065765, "chapter_id": 2390, "verse_number": "९-८-४०", "content_sanskrit": "तत्राश्चर्यमपश्याम घोररूपं महद्भयम्।\nशल्येन सङ्गताः शूरा यदयुध्यन्त भागशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2065766, "chapter_id": 2390, "verse_number": "९-८-४१", "content_sanskrit": "माद्रीपुत्रौ तु रभसौ कृतास्त्रौ युद्धदुर्मदौ।\nअभ्ययातां त्वरायुक्तौ जिगीषन्तौ बलं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2065767, "chapter_id": 2390, "verse_number": "९-८-४२", "content_sanskrit": "ततोऽभ्यावर्तत बलं तावकं भरतर्षभ।\nशरैः प्रणुन्नं बहुधा पाण्डवैर्जितकाशिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2065768, "chapter_id": 2390, "verse_number": "९-८-४३", "content_sanskrit": "वध्यमाना चमूः सा तु पुत्राणां प्रेक्षतां तव।\nभेजे दश दिशो राजन्प्रणुन्ना शरवृष्टिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2065769, "chapter_id": 2390, "verse_number": "९-८-४४", "content_sanskrit": "हाहाकारो महाञ्जज्ञे योधानां तत्र भारत।\nतिष्ठतिष्ठेति चाप्यासीद्द्रावितानां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2065770, "chapter_id": 2390, "verse_number": "९-८-४५", "content_sanskrit": "क्षत्रियाणां तथाऽन्योन्यं संयुगे जयमिच्छताम्।\nप्राद्रवन्नेव सम्भग्नाः पाण्डवैस्तव सैनिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2065771, "chapter_id": 2390, "verse_number": "९-८-४६", "content_sanskrit": "त्यक्त्वा युद्धे प्रियान्पुत्रान्भ्रातॄनथ पितामहान्।\nमातुलान्भागिनेयांश्च वयस्यानपि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2065772, "chapter_id": 2390, "verse_number": "९-८-४७", "content_sanskrit": "हयान्द्विपांस्त्वरयन्तो योधा जग्मुः समन्ततः।\nआत्मत्राणकृतोत्साहास्तावका भरतर्षभ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2065773, "chapter_id": 2390, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि शल्यवधपर्वणि अष्टादशदिवसयुद्धे अष्टमोऽध्यायः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]