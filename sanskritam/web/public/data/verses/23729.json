[{"id": 7003729000, "chapter_id": 23729, "verse_number": "२-१-१३-१", "content_sanskrit": "अथ धर्मगुप्तचरित्रवर्णनम् ।\nश्रीसूत उवाच ।\nभूयोपि संप्रवक्ष्यामि स्वामितीर्थस्य वैभवम् ।\nयुष्माकमादरेणाऽहं नैमिषारण्यवासिनः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003729001, "chapter_id": 23729, "verse_number": "२-१-१३-२", "content_sanskrit": "नन्दोनाम महाराजः सोमवंशसमुद्भवः ।\nधर्मेण पालयामास सागरान्तां धरामिमाम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003729002, "chapter_id": 23729, "verse_number": "२-१-१३-३", "content_sanskrit": "तस्य पुत्रः समभवद्धर्मगुप्त इति स्मृतः ।\nराज्यरक्षाधुरं नन्दो निजपुत्रे निधाय सः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003729003, "chapter_id": 23729, "verse_number": "२-१-१३-४", "content_sanskrit": "जितेंद्रियो जिताहारः प्रविवेश तपोवनम् ।\nताते तपोवनं याते धर्मगुप्ताभिधो नृपः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003729004, "chapter_id": 23729, "verse_number": "२-१-१३-५", "content_sanskrit": "मेदिनीं पालयामास धर्मज्ञो नीतितत्परः ।\nईजे वहुविधैर्यज्ञैर्देवानिन्द्र पुरोगमान् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003729005, "chapter_id": 23729, "verse_number": "२-१-१३-६", "content_sanskrit": "ब्राह्मणानां ददौ वित्तं क्षेत्राणि च बहूनि सः ।\nसर्वे स्वधर्मनिरतास्तस्मिन्राजनि शासति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003729006, "chapter_id": 23729, "verse_number": "२-१-१३-७", "content_sanskrit": "कदाचिन्नाभवन्पीडास्तस्मिंश्चोरादिसंभवाः ।\nकदाचिद्धर्मगुप्तोऽयमारुह्य तुरगोत्तमम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003729007, "chapter_id": 23729, "verse_number": "२-१-१३-८", "content_sanskrit": "वनं विवेश विप्रेंद्रा मृगयारसकौतुकी ।\nतमालतालहिन्तालकुरवाकुलदिङ्मुखे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003729008, "chapter_id": 23729, "verse_number": "२-१-१३-९", "content_sanskrit": "विचचार वने तस्मिन्सिंसहव्याघ्रभयानके ।\nमत्तालिकुलसन्नादसंमूर्च्छितदिगन्तरे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003729009, "chapter_id": 23729, "verse_number": "२-१-१३-१०", "content_sanskrit": "पद्मकल्हारकुमुदनीलोत्पलवनाकुले ।\nतटाके रससंपूर्णे तपस्विजनमण्डिते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003729010, "chapter_id": 23729, "verse_number": "२-१-१३-११", "content_sanskrit": "तस्मिन्वने सञ्चरतो धर्मगुप्तस्य भूपतेः ।\nअभूद्विभावरी विप्रास्तमसावृतदिङ्मुखा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003729011, "chapter_id": 23729, "verse_number": "२-१-१३-१२", "content_sanskrit": "राजाऽपि पश्चिमां सन्ध्यामुपास्य विनयान्वितः ।\nजजाप च वने तत्र गायत्रीं वेदमातरम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003729012, "chapter_id": 23729, "verse_number": "२-१-१३-१३", "content_sanskrit": "सिंहव्याघ्रादिभीत्यास्मिन्वृक्षमेकं समाश्रिते ।\nराजपुत्रे तदभ्याशमृक्षः सिंहभयार्दितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003729013, "chapter_id": 23729, "verse_number": "२-१-१३-१४", "content_sanskrit": "अन्वधावत वृक्षं तमेकः सिंहो वनेचरः ।\nअनुद्रुतः स सिंहेन ऋक्षो वृक्षमुपारुहत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003729014, "chapter_id": 23729, "verse_number": "२-१-१३-१५", "content_sanskrit": "आरुह्य ऋक्षो वृक्षं तं ददर्श जगतीपतिम् ।\nवृक्षस्थितं महात्मानं महाबलपराक्रमम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003729015, "chapter_id": 23729, "verse_number": "२-१-१३-१६", "content_sanskrit": "उवाच भूपतिं दृष्ट्वा ऋक्षोयं वनगोचरः ।\nमा भीतिं कुरु राजेंद्र वत्स्यावो रजनीमिह ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003729016, "chapter_id": 23729, "verse_number": "२-१-१३-१७", "content_sanskrit": "महासत्त्वो महाकायो महादंष्ट्रसमाकुलः ।\nवृक्षमूलं समायातः सिंहोऽयमतिभीषणः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003729017, "chapter_id": 23729, "verse_number": "२-१-१३-१८", "content_sanskrit": "रात्र्यर्धं भज निद्रां त्वं रक्ष्यमाणो मयोद्यतः ।\nततः प्रसुप्तं मां रक्ष शर्वर्यर्धं महामते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003729018, "chapter_id": 23729, "verse_number": "२-१-१३-१९", "content_sanskrit": "इति तद्वाक्यमाकर्ण्य सुप्ते नन्दसुते हरिः ।\nप्रोवाच ऋक्षं सुप्तोऽयं नृपो मे त्यज्यतामिति ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003729019, "chapter_id": 23729, "verse_number": "२-१-१३-२०", "content_sanskrit": "तं सिंहमब्रवीदृक्षो धर्मज्ञो द्विजसत्तमाः ।\nभवान्धर्मं न जानीते मृगराज वनेचर ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003729020, "chapter_id": 23729, "verse_number": "२-१-१३-२१", "content_sanskrit": "विश्वासघातिनां लोके महाकष्टं भवत्यहो ।\nन हि मित्रद्रुहां पापं नश्येद्यज्ञायुतैरपि ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003729021, "chapter_id": 23729, "verse_number": "२-१-१३-२२", "content_sanskrit": "ब्रह्महत्यादिपापानां कथञ्चिन्निष्कृतिर्भवेत् ।\nविश्वासघातिनां पापं न नश्येज्जन्मकोटिभिः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003729022, "chapter_id": 23729, "verse_number": "२-१-१३-२३", "content_sanskrit": "नाहं मेरुं महाभारं मन्ये पञ्चास्य भूतले ।\nमहाभारमिमं मन्ये लोकविश्वासघातकम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003729023, "chapter_id": 23729, "verse_number": "२-१-१३-२४", "content_sanskrit": "एवमुक्तोऽथ ऋक्षेण सिंहस्तूष्णीं बभूव ह ।\nधर्मगुप्ते प्रबुद्धे तु ऋक्षः सुष्वाप भूरुहे ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003729024, "chapter_id": 23729, "verse_number": "२-१-१३-२५", "content_sanskrit": "ततः सिंहोऽब्रवीद्भूपमेनमृक्षं त्यजस्व मे ।\nएवमुक्तोऽथ सिंहेन राजा सुप्तमशंकितः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003729025, "chapter_id": 23729, "verse_number": "२-१-१३-२६", "content_sanskrit": "स्वांकन्यस्तशिरस्कं तमृक्षं तत्याज भूतले ।\nपात्यमानस्ततो राज्ञा समालम्बितपादपः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003729026, "chapter_id": 23729, "verse_number": "२-१-१३-२७", "content_sanskrit": "ऋक्षः पुण्यवशाद्वृक्षान्न पपात महीतले ।\nस ऋक्षो नृपमभ्येत्य कोपाद्वाक्यमभाषत ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003729027, "chapter_id": 23729, "verse_number": "२-१-१३-२८", "content_sanskrit": "कामरूपधरो राजन्नहं भृगुकुलोद्भवः ।\nध्यानकाष्ठाभिधो नाम्ना ऋक्षरूपमधारयम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003729028, "chapter_id": 23729, "verse_number": "२-१-१३-२९", "content_sanskrit": "कस्मादनागसं सुप्तमत्याक्षीन्मां भवान्नृप ।\nमच्छापादतिशीघ्रं त्वमुन्मत्तश्चर भूतले ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003729029, "chapter_id": 23729, "verse_number": "२-१-१३-३०", "content_sanskrit": "इति शप्त्वा मुनिर्भूपं ततः सिंहमभाषत ।\nन सिंहस्त्वं महायक्षः कुबेरसचिवः पुरा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003729030, "chapter_id": 23729, "verse_number": "२-१-१३-३१", "content_sanskrit": "हिमवद्गिरिमासाद्य कदाचित्तं वधूसखः ।\nअज्ञानाद्गौतमाभ्याशे विहारमतनोर्मुदा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003729031, "chapter_id": 23729, "verse_number": "२-१-१३-३२", "content_sanskrit": "गौतमोऽप्युटजाद्दैवात्समिदाहरणाय वै ।\nनिर्गतस्त्वां विवसनं दृष्ट्वा शापमुदाहरत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003729032, "chapter_id": 23729, "verse_number": "२-१-१३-३३", "content_sanskrit": "यस्मान्ममाश्रमेऽद्य त्वं विवस्त्रः स्थितवानसि ।\nअतः सिंहत्वमद्यैव भविता ते न संशयः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003729033, "chapter_id": 23729, "verse_number": "२-१-१३-३४", "content_sanskrit": "इति गौतमशापेन सिंहत्वमगमत्पुरा ।\nकुबेरसचिवो यक्षो भद्रनामा भवान्पुरा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003729034, "chapter_id": 23729, "verse_number": "२-१-१३-३५", "content_sanskrit": "कुबेरो धर्मशीलो हि तद्भृत्याश्च तथैव हि ।\nअतः किमर्थं त्वं हंसि मामृषिं वनगोचरम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003729035, "chapter_id": 23729, "verse_number": "२-१-१३-३६", "content_sanskrit": "एतत्सर्वमहं ध्यानाज्जानामि हि मृगाधिप ।\nइत्युक्तो ध्यानकाष्ठेन त्यक्त्वा सिंहत्वमाशु सः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003729036, "chapter_id": 23729, "verse_number": "२-१-१३-३७", "content_sanskrit": "यक्षरूपं गतो दिव्यं कुबेरसचिवात्मकम् ।\nध्यानकाष्ठमसावाह प्रांजलिः प्रणतो मुनिम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003729037, "chapter_id": 23729, "verse_number": "२-१-१३-३८", "content_sanskrit": "अद्य ज्ञातं मया सर्वं पूर्ववृत्तं महामुने ।\nगौतमः शापकाले मे शापान्तमपि चोक्तवान् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003729038, "chapter_id": 23729, "verse_number": "२-१-१३-३९", "content_sanskrit": "ध्यानकाष्ठेन संवाद ऋक्षरूपेण ते यदा ।\nतदा निर्धूय सिंहत्वं यक्षरूपमवाप्स्यसि ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003729039, "chapter_id": 23729, "verse_number": "२-१-१३-४०", "content_sanskrit": "इति मामब्रवीद्ब्रह्मन्गौतमो मुनिपुङ्गवः ।\nअद्य सिंहत्वनाशान्मे जानामि त्वां महामुने ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003729040, "chapter_id": 23729, "verse_number": "२-१-१३-४१", "content_sanskrit": "ध्यानकाष्ठाभिधं शुद्धं कामरूपधरं सदा ।\nइत्युक्त्वा तं प्रणम्याथ ध्यानकाष्ठं स यक्षराट् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003729041, "chapter_id": 23729, "verse_number": "२-१-१३-४२", "content_sanskrit": "विमानवरमारुह्य प्रययावलकापुरीम् ।\nउन्मत्तरूपं तं दृष्ट्वा मन्त्रिणस्तु नृपोत्तमम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003729042, "chapter_id": 23729, "verse_number": "२-१-१३-४३", "content_sanskrit": "पितुः सकाशमानिन्यू रेवातीरे नृपोत्तमम् ।\nतस्मै निवेदयामासुर्मतिभ्रंशं सुतस्य च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003729043, "chapter_id": 23729, "verse_number": "२-१-१३-४४", "content_sanskrit": "ज्ञात्वा तु पुत्रवृत्तान्तं पिता वै नंदनस्तदा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003729044, "chapter_id": 23729, "verse_number": "२-१-१३-४५", "content_sanskrit": "अथ जैमिनिवाक्यात्स्वामितीर्थस्नातस्य धर्मगुप्तस्योन्मादनिवृत्तिः ।\nपुत्रमादाय सहसा जैमिनेरन्तिकं ययौ ।\nतस्मै निवेदयामास पुत्रवृत्तान्तमादितः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003729045, "chapter_id": 23729, "verse_number": "२-१-१३-४६", "content_sanskrit": "भगवञ्जैमिने पुत्रो ममाद्योन्मत्ततां गतः ।\nअस्योन्मादविनाशाय ब्रूह्युपायं महामुने ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003729046, "chapter_id": 23729, "verse_number": "२-१-१३-४७", "content_sanskrit": "इति पृष्टश्चिरं दध्यौ जैमिनिर्मुनिपुंगवः ।\nध्यात्वा तु सुचिरं कालं नृपनन्दनमब्रवीत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003729047, "chapter_id": 23729, "verse_number": "२-१-१३-४८", "content_sanskrit": "ध्यानकाष्ठस्य शापेन ह्युन्मत्तस्ते सुतोऽभवत् ।\nतस्य शापस्य मोक्षार्थमुपायं प्रब्रवीमि ते ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003729048, "chapter_id": 23729, "verse_number": "२-१-१३-४९", "content_sanskrit": "सुवर्णमुखरीतीरे वेंकटेनाम पर्वते ।\nसर्वपापहरे पुण्ये नानाधातुविनिर्मिते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003729049, "chapter_id": 23729, "verse_number": "२-१-१३-५०", "content_sanskrit": "स्वामिपुष्करिणी चेति तीर्थमस्ति महत्तरम् ।\nपवित्राणां पवित्रं हि मंगलानां च मंगलम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003729050, "chapter_id": 23729, "verse_number": "२-१-१३-५१", "content_sanskrit": "श्रुतिसिद्धं महापुण्यं ब्रह्महत्यादिशोधकम् ।\nनीत्वा तत्र सुतं तेऽद्य स्नापयस्व महामते ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003729051, "chapter_id": 23729, "verse_number": "२-१-१३-५२", "content_sanskrit": "उन्मादस्तत्क्षणादेव तस्य नश्येन्न संशयः ।\nइत्युक्तस्तं प्रणम्यासौ जैमिनिं मुनिपुंगवम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003729052, "chapter_id": 23729, "verse_number": "२-१-१३-५३", "content_sanskrit": "नन्दः पुत्रं समादाय स्वामिपुष्करिणीं ययौ ।\nतत्र च स्नापयामास पुत्रं नियमपूर्वकम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003729053, "chapter_id": 23729, "verse_number": "२-१-१३-५४", "content_sanskrit": "स्नानमात्रात्ततः सद्यो नष्टोन्मादोऽभवत्सुतः ।\nस्वयं सस्नौ स नन्दोऽपि स्वामिपुष्करिणीजले ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003729054, "chapter_id": 23729, "verse_number": "२-१-१३-५५", "content_sanskrit": "उषित्वा दिनमेकं तु सहपुत्रः पिता तदा ।\nसेवित्वा वेंकटेशं च श्रीनिवासं कृपानिधिम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003729055, "chapter_id": 23729, "verse_number": "२-१-१३-५६", "content_sanskrit": "पुत्रमापृच्छ्य नन्दस्तं प्रययौ तपसे वनम् ।\nगते पितरि पुत्रोऽपि धर्मगुप्तो नृपो द्विजाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003729056, "chapter_id": 23729, "verse_number": "२-१-१३-५७", "content_sanskrit": "प्रददौ वेंकटेशस्य बहुवित्तानि भक्तितः ।\nब्राह्मणेभ्यो धनं धान्यं क्षेत्राणि च ददौ तदा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003729057, "chapter_id": 23729, "verse_number": "२-१-१३-५८", "content_sanskrit": "प्रययौ मन्त्रिभिः सार्धं स्वां पुरीं तदनन्तरम् ।\nधर्मेण पालयामास राज्यं निहतकण्टकम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003729058, "chapter_id": 23729, "verse_number": "२-१-१३-५९", "content_sanskrit": "पितृपैतामहं विप्रा धर्मगुप्तोतिधार्मिकः ।\nउन्मादैरप्यपस्मारैर्ग्रहैर्दुष्टैश्च ये नराः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003729059, "chapter_id": 23729, "verse_number": "२-१-१३-६०", "content_sanskrit": "ग्रस्ता भवन्ति विप्रेन्द्रास्तेऽपि चात्र निमज्जनात् ।\nपुष्करिण्यां विमुक्ताः स्युः सत्यं सत्यं वदाम्यहम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003729060, "chapter_id": 23729, "verse_number": "२-१-१३-६१", "content_sanskrit": "स्वामिपुष्करिणीं त्यक्त्वा तीर्थमन्यद्व्रजेत्तु यः ।\nस्निग्धं स गोपयस्त्यक्त्वा स्नुहीक्षीरं प्रयाचते ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003729061, "chapter_id": 23729, "verse_number": "२-१-१३-६२", "content_sanskrit": "स्वामितीर्थं स्वामितीर्थं स्वामितीर्थमिति द्विजाः ।\nत्रिःपठन्तो नरा एवं यत्र क्वापि जलाशये ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003729062, "chapter_id": 23729, "verse_number": "२-१-१३-६३", "content_sanskrit": "स्नांति सर्वे नरास्ते वै यास्यन्ति ब्रह्मणः पदम् ।\nएवं वः कथिता विप्रा धर्मगुप्तकथा शुभा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003729063, "chapter_id": 23729, "verse_number": "२-१-१३-६४", "content_sanskrit": "यस्याः श्रवणमात्रेण ब्रह्महत्या विनश्यति ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]