[{"id": 7002631000, "chapter_id": 22631, "verse_number": "६-९-१", "content_sanskrit": "सूत उवाच ।\nभो शौनक महाबुद्धे वैतालेन महीपतिः ।\nमहाप्रवीणश्च मतस्तमाह स च भूपतिम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002631001, "chapter_id": 22631, "verse_number": "६-९-२", "content_sanskrit": "राजन्कामपुरे रम्ये वीरसिंहो महीपतिः ।\nन्यायतो धर्मतश्चैव तत्र राज्यमचीकरत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002631002, "chapter_id": 22631, "verse_number": "६-९-३", "content_sanskrit": "हिरण्यदत्तस्तत्रैव वैश्यो धनमदान्वितः ।\nकामालसा तस्य सुता रूपयौवनशालिनी ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002631003, "chapter_id": 22631, "verse_number": "६-९-४", "content_sanskrit": "अवसत्सुखतो नित्यं वसंते कुसुमप्रिया ।\nकदाचित्कुसुमार्थं वै वनं भ्रमरनादितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002631004, "chapter_id": 22631, "verse_number": "६-९-५", "content_sanskrit": "गच्छन्तीं तां समालोक्य धर्मदत्तात्मजो बली ।\nसोमदत्त इति ख्यातः पस्पर्श मदनालसाम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002631005, "chapter_id": 22631, "verse_number": "६-९-६", "content_sanskrit": "सा तु तं निर्जने स्थाने प्रोवाच विनयान्विता ।\nकन्यकाहं महावीर त्यज मां धर्मतोद्य भोः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002631006, "chapter_id": 22631, "verse_number": "६-९-७", "content_sanskrit": "विवाहे सति पूर्वं त्वां भजामि दशमेऽहनि ।\nअतो दशदिनस्यैवादेशं देहि दयानिधे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002631007, "chapter_id": 22631, "verse_number": "६-९-८", "content_sanskrit": "तथेति मत्वा तां त्यक्त्वा निजगेहं समागतः ।\nकामालसा तु तद्ग्रामे पित्रा दत्ता वराय च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002631008, "chapter_id": 22631, "verse_number": "६-९-९", "content_sanskrit": "मदपालाय वैश्याय मणिग्रीवसुताय च ।\nश्वशुरस्य गृहं गत्वा स्वमित्रं प्रत्यचिन्तयत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002631009, "chapter_id": 22631, "verse_number": "६-९-१०", "content_sanskrit": "नवमेऽहनि तत्स्वामी गृहीत्वा कामिनीं बलात् ।\nकामातुरः स पत्नीं तामालिलिंग मदान्वितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002631010, "chapter_id": 22631, "verse_number": "६-९-११", "content_sanskrit": "अरुदत्सा तु तत्पत्नी मित्रवाक्येन कर्षिता ।\nतामुवाच तदा वैश्यः शांतिपूर्वमिदं वचः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002631011, "chapter_id": 22631, "verse_number": "६-९-१२", "content_sanskrit": "किं रोदिषि मदापूर्णे सत्यं कथय शोभने ।\nसा तु सत्यवती प्राह यथाजातं हि कानने ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002631012, "chapter_id": 22631, "verse_number": "६-९-१३", "content_sanskrit": "यदि नायामि पार्श्वे त्वां सोमदत्त धनोत्तम ।\nतदा वैधव्यतां प्राप्य भजामि वृजिनं हि तत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002631013, "chapter_id": 22631, "verse_number": "६-९-१४", "content_sanskrit": "इति वाक्येन बद्धाहं यास्याम्यद्य तदंतिके ।\nइति श्रुत्वा च तत्स्वामी तामाज्ञाप्य मुदान्वितः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002631014, "chapter_id": 22631, "verse_number": "६-९-१५", "content_sanskrit": "सुष्वाप सा तु तत्पार्श्वे ह्यगमत्कामविह्वला ।\nतदा चौरस्तु तां दृष्ट्वा सर्वाभरणभूषिताम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002631015, "chapter_id": 22631, "verse_number": "६-९-१६", "content_sanskrit": "वचश्चोवाच लोभात्मा कुत्र यासि च सुन्दरि ।\nकेनैवापेक्षिता रात्रौ सत्यं कथय भामिनि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002631016, "chapter_id": 22631, "verse_number": "६-९-१७", "content_sanskrit": "कामालसा तु तं चौरमुवाच मदविह्वला ।\nरक्षिता कामबाणेन स्वमित्रं प्रति यामि भोः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002631017, "chapter_id": 22631, "verse_number": "६-९-१८", "content_sanskrit": "चौरस्तामाह भोः सुभ्रूर्भूषण देहि मेऽबले ।\nचौरोऽहं ते धनग्राही सा श्रुत्वा वाक्यमब्रवीत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002631018, "chapter_id": 22631, "verse_number": "६-९-१९", "content_sanskrit": "आलिंग्योपपतिं मित्रं तुभ्यं दास्यामि भूषणम् ।\nतथेत्युक्त्वा तु तेनैव सोमदत्तं समागता ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002631019, "chapter_id": 22631, "verse_number": "६-९-२०", "content_sanskrit": "दृष्ट्वा तामब्रवीद्वैश्यः कथं याता स्मरालसे ।\nसत्यं कथय मे शीघ्रं तत्पश्चात्त्वां भजाम्यहम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002631020, "chapter_id": 22631, "verse_number": "६-९-२१", "content_sanskrit": "कामालसा तु तच्छ्रुत्वा यथा जातं तथाऽब्रवीत् ।\nश्रुत्वा स ज्ञानहृदयो विष्णुदेवेन बोधितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002631021, "chapter_id": 22631, "verse_number": "६-९-२२", "content_sanskrit": "मत्वा पतिव्रतां नारीं परिक्रम्य व्यसर्जयत् ।\nचौरस्तु कारणं श्रुत्वा विष्णुदेवेन बोधितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002631022, "chapter_id": 22631, "verse_number": "६-९-२३", "content_sanskrit": "गेहे प्रवेशयामास तत्पतिर्यत्र तिष्ठति ।\nसा तु कामालसा देवी स्वपातिव्रत्य धर्मिणी ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002631023, "chapter_id": 22631, "verse_number": "६-९-२४", "content_sanskrit": "बुभुजे विषयान्दिव्यान्देवदेवेन चोदितान् ।\nइत्युक्त्वा स तु वैतालो नृपतिं प्राह कोविदम् ।\nकस्य सत्यं स्मृतं श्रेष्ठं तेषां मध्ये वदस्व मे ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002631024, "chapter_id": 22631, "verse_number": "६-९-२५", "content_sanskrit": "सूत उवाच ।\nइत्युक्तः स तु भूपालो वैतालमिदमब्रवीत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002631025, "chapter_id": 22631, "verse_number": "६-९-२६", "content_sanskrit": "चौरस्य सत्यता श्रेष्ठा यथा जाता तथा शृणु ।\nनृपभीत्या स वैश्यस्तु तां नारीं न तु भुक्तवान् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002631026, "chapter_id": 22631, "verse_number": "६-९-२७", "content_sanskrit": "वैधव्यभीत्या सा देवी स्वमित्रं प्रति चागता ।\nधर्मभीत्या च तत्स्वामी स्वपत्नीं न तु भुक्तवान् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002631027, "chapter_id": 22631, "verse_number": "६-९-२८", "content_sanskrit": "चौरस्तु सत्यभीत्या वै त्यक्त्वा तां मुदमागतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]