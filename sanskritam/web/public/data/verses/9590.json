[{"id": 5000590000, "chapter_id": 9590, "verse_number": "७-५५-१", "content_sanskrit": "एष ते नृगशापस्य विस्तरो ऽभिहितो मया ।\nयद्यस्ति श्रवणे श्रद्धा शृणुष्वेहापरां कथाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000590001, "chapter_id": 9590, "verse_number": "७-५५-२", "content_sanskrit": "एवमुक्तस्तु रामेण सौमित्रिः पुनरब्रवीत् ।\nतृप्तिराश्चर्यभूतानां कथानां नास्ति मे नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000590002, "chapter_id": 9590, "verse_number": "७-५५-३", "content_sanskrit": "लक्ष्मणेनैवमुक्तस्तु राम इक्ष्वाकुनन्दनः ।\nकथां परमधर्मिष्ठां व्याहर्तुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000590003, "chapter_id": 9590, "verse_number": "७-५५-४", "content_sanskrit": "आसीद्राजा निमिर्नाम इक्ष्वाकूणां महात्मनाम् ।\nपुत्रो द्वादशमो वीर्ये धर्मे च परिनिष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000590004, "chapter_id": 9590, "verse_number": "७-५५-५", "content_sanskrit": "स राजा वीर्यसम्पन्नः पुरं देवपुरोपमम् ।\nनिवेशयामास तदा अभ्याशे गौतमस्य तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000590005, "chapter_id": 9590, "verse_number": "७-५५-६", "content_sanskrit": "पुरस्य सुकृतं नाम वैजयन्तमिति श्रुतम् ।\nनिवेशं यत्र राजर्षिर्निमिश्चक्रे महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000590006, "chapter_id": 9590, "verse_number": "७-५५-७", "content_sanskrit": "तस्य बुद्धिः समुत्पन्ना निवेश्य सुमहापुरम् ।\nयजेयं दीर्घसत्रेण पितुः प्रह्लादयन्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000590007, "chapter_id": 9590, "verse_number": "७-५५-८", "content_sanskrit": "ततः पितरमामन्त्र्य इक्ष्वाकुं हि मनोः सुतम् ।\nवसिष्ठं वरयामास पूर्वं ब्रह्मर्षिसत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000590008, "chapter_id": 9590, "verse_number": "७-५५-९", "content_sanskrit": "अनन्तरं स राजर्षिर्निमिरिक्ष्वाकुनन्दनः ।\nअत्रिमङ्गिरसं चैव भृगुं चैव तपोधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000590009, "chapter_id": 9590, "verse_number": "७-५५-१०", "content_sanskrit": "तमुवाच वसिष्ठस्तु निमिं राजर्षिसत्तमम् ।\nवृतो ऽहं पूर्वमिन्द्रेण अन्तरं प्रतिपालय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000590010, "chapter_id": 9590, "verse_number": "७-५५-११", "content_sanskrit": "अनन्तरं महाविप्रो गौतमः प्रत्यपूरयत् ।\nवसिष्ठो ऽपि महातेजा इन्द्रयज्ञमथाकरोत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000590011, "chapter_id": 9590, "verse_number": "७-५५-१२", "content_sanskrit": "निमिस्तु राजा विप्रांस्तान्समानीय नराधिपः ।\nअयजद्धिमवत्पार्श्वे स्वपुरस्य समीपतः ।\nपञ्चवर्षसहस्राणि राजा दीक्षामुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000590012, "chapter_id": 9590, "verse_number": "७-५५-१३", "content_sanskrit": "इन्द्रयज्ञावसाने तु वसिष्ठो भगवनृषिः ।\nसकाशमागतो राज्ञो हौत्रं कर्तुमनिन्दितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000590013, "chapter_id": 9590, "verse_number": "७-५५-१४", "content_sanskrit": "तदन्तरमथापश्यद्गौतमेनाभिपूरितम् ।\nकोपेन महताविष्टो वसिष्ठो ब्रह्मणः सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000590014, "chapter_id": 9590, "verse_number": "७-५५-१५", "content_sanskrit": "स राज्ञो दर्शनाकाङ्क्षी मुहूर्तं समुपाविशत् ।\nतस्मिन्नहनि राजर्षिर्निद्रया ऽपहृतो भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000590015, "chapter_id": 9590, "verse_number": "७-५५-१६", "content_sanskrit": "ततो मन्युर्वसिष्ठस्य प्रादुरासीन्महात्मनः ।\nअदर्शनेन राजर्षेर्व्याहर्तुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000590016, "chapter_id": 9590, "verse_number": "७-५५-१७", "content_sanskrit": "यस्मात्त्वमन्यं वृतवान्मामवज्ञाय पार्थिव ।\nचेतनेन विनाभूतो देहस्तव भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000590017, "chapter_id": 9590, "verse_number": "७-५५-१८", "content_sanskrit": "ततः प्रबुद्धो राजर्षिः श्रुत्वा शापमुदाहृतम् ।\nब्रह्मयोनिमथोवाच संरम्भात् क्रोधमूर्च्छितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000590018, "chapter_id": 9590, "verse_number": "७-५५-१९", "content_sanskrit": "अजानतः शयानस्य क्रोधेन कलुषीकृतः ।\nमुक्तवान्मयि शापाग्निं यमदण्डमिवापरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000590019, "chapter_id": 9590, "verse_number": "७-५५-२०", "content_sanskrit": "तस्मात्तवापि ब्रह्मर्षे चेतनेन विना कृतः ।\nदेहः सुरुचिरप्रख्यो भविष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000590020, "chapter_id": 9590, "verse_number": "७-५५-२१", "content_sanskrit": "इति रोषवशादुभौ तदानीमन्योन्यं शपितौ नृपद्विजेन्द्रौ ।\nसहसैव बभूवतुर्विदेहौ तत्तुल्याधिगतप्रभाववन्तौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000590021, "chapter_id": 9590, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे पञ्चपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]