[{"id": 2008709, "chapter_id": 1168, "verse_number": "१-१६९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2008710, "chapter_id": 1168, "verse_number": "१-१६९-१", "content_sanskrit": "गते भगवति व्यासे पाण्डवा विगतज्वराः।\nऊषुस्तत्र च षण्मासान्वटवृक्षे यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2008711, "chapter_id": 1168, "verse_number": "१-१६९-२", "content_sanskrit": "शाकमूलफलाहारास्तपः कुर्वन्ति पाण्डवाः।\nअनुज्ञाता महाराज ततः कमलपालिका॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2008712, "chapter_id": 1168, "verse_number": "१-१६९-३", "content_sanskrit": "रमयन्ती सदा भीमं तत्रतत्र मनोजवा।\nदिव्याभरणवस्त्रा हि दिव्यस्रगनुलेपना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2008713, "chapter_id": 1168, "verse_number": "१-१६९-४", "content_sanskrit": "एवं भ्रातॄन्सप्त मासान्हिडिम्बाऽवासयद्वने।\nपाण्डवान्भीमसेनार्थे राक्षसी कामरूपिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2008714, "chapter_id": 1168, "verse_number": "१-१६९-५", "content_sanskrit": "सुखं स विहरन्भीमस्तत्कालं पर्यणामयत्।\nततोऽलभत सा गर्भं राक्षसी कामरूपिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2008715, "chapter_id": 1168, "verse_number": "१-१६९-६", "content_sanskrit": "अतृप्ता भीमसेनेन सप्तमासोपसंगता।\nप्रजज्ञे राक्षसी पुत्रं भीमसेनान्महाबलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2008716, "chapter_id": 1168, "verse_number": "१-१६९-७", "content_sanskrit": "विरूपाक्षं महावक्त्रं शङ्कुकर्णं विभीषणम्।\nभीमरूपं सुताम्राक्षं तीक्ष्णदंष्ट्रं महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2008717, "chapter_id": 1168, "verse_number": "१-१६९-८", "content_sanskrit": "महेष्वासं महावीर्यं महासत्वं महाजवम्।\nमहाकायं महाकालं महाग्रीवं महाभुजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2008718, "chapter_id": 1168, "verse_number": "१-१६९-९", "content_sanskrit": "अमानुषं मानुषजं भीमवेगमरिन्दमम्।\nपिशाचकानतीत्यान्यान्बभूवाति स मानुषान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2008719, "chapter_id": 1168, "verse_number": "१-१६९-१०", "content_sanskrit": "बालोऽपि विक्रमं प्राप्तो मानुषेषु विशांपते।\nसर्वास्त्रेषु वरो वीरः प्रकाममभवद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2008720, "chapter_id": 1168, "verse_number": "१-१६९-११", "content_sanskrit": "सद्यो हि गर्भं राक्षस्यो लभन्ते प्रसवन्ति च।\nकामरूपधराश्चैव भवन्ति बहुरूपिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2008721, "chapter_id": 1168, "verse_number": "१-१६९-१२", "content_sanskrit": "प्रणम्य विकचः पादावगृह्णात्स पितुस्तदा।\nमातुश्च परमेष्वासस्तौ च नामास्य चक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2008722, "chapter_id": 1168, "verse_number": "१-१६९-१३", "content_sanskrit": "घटोहास्योत्कच इति माता तं प्रत्यभाषत।\nअभवत्तेन नामास्य घटोत्कच इति स्म ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2008723, "chapter_id": 1168, "verse_number": "१-१६९-१४", "content_sanskrit": "अनुरक्तश्च तानासीत्पाण्डवान्स घटोत्कचः।\nतेषां च दयितो नित्यमात्मनित्यो बभूव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2008724, "chapter_id": 1168, "verse_number": "१-१६९-१५", "content_sanskrit": "घटोत्कचो महाकायः पाण्डवान्पृथया सह।\nअभिवाद्य यथान्यायमब्रवीच्च प्रभाष्य तान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2008725, "chapter_id": 1168, "verse_number": "१-१६९-१६", "content_sanskrit": "किं करोम्यहमार्याणां निःशङ्कं वदतानघाः।\nतं ब्रुवन्तं भैमसेनिं कुन्ती वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2008726, "chapter_id": 1168, "verse_number": "१-१६९-१७", "content_sanskrit": "त्वं कुरूणां कुले जातः साक्षाद्भीमसमो ह्यसि।\nज्येष्ठः पुत्रोसि पञ्चानां साहाय्यं कुरु पुत्रक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2008727, "chapter_id": 1168, "verse_number": "१-१६९-१८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2008728, "chapter_id": 1168, "verse_number": "१-१६९-१८", "content_sanskrit": "पृथयाप्येवमुक्तस्तु प्रणम्यैव वचोऽब्रवीत्।\nयथा हि रावणो लोके इन्द्रजिच्च महाबलः।\nवर्ष्मवीर्यसमो लोके विशिष्टश्चाभवं नृषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2008729, "chapter_id": 1168, "verse_number": "१-१६९-१९", "content_sanskrit": "कृत्यकाल उपस्थास्ये पितॄनिति घटोत्कचः।\nआमन्त्र्य रक्षसां श्रेष्ठः प्रतस्थे चोत्तरां दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2008730, "chapter_id": 1168, "verse_number": "१-१६९-२०", "content_sanskrit": "स हि सृष्टो भगवता शक्तिहेतोर्महात्मना।\nवर्णस्याप्रतिवीर्यस्य प्रतियोद्धा महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2008731, "chapter_id": 1168, "verse_number": "१-१६९-२१x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2008732, "chapter_id": 1168, "verse_number": "१-१६९-२१", "content_sanskrit": "सह वासो मया जीर्णस्त्वया कमलपालिके।\nपुनर्द्रक्ष्यसि राज्यस्थानित्यभाषत तां तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2008733, "chapter_id": 1168, "verse_number": "१-१६९-२२x", "content_sanskrit": "हिडिम्बोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2008734, "chapter_id": 1168, "verse_number": "१-१६९-२२", "content_sanskrit": "पदा मां संस्मरेः कान्त रिरंसू रहसि प्रभो।\nतदा तव वशं भूय आगन्तास्म्याशु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2008735, "chapter_id": 1168, "verse_number": "१-१६९-२३", "content_sanskrit": "इत्युक्त्वा सा जगामाशु भावमासज्य पाण्डवे।\nहिडिम्बा समयं स्मृत्वा स्वां गतिं प्रत्यपद्यत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2008736, "chapter_id": 1168, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि हिडिम्बवधपर्वणि ऊनसप्तत्युत्तरशततमोऽध्यायः॥ १६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]