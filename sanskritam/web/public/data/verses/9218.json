[{"id": 40015198, "chapter_id": 9218, "verse_number": "1", "content_sanskrit": "ततस्तमक्षोभ्यबलंलङ्काधिपतयेचराः । सुवेलेराघवंशैलेनिविष्टंप्रत्यवेदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40015199, "chapter_id": 9218, "verse_number": "2", "content_sanskrit": "चाराणांरावणश्श्रुत्वाप्राप्तंरामंमहाबलम् । जातोद्वेगोऽभवत्किञ्चिच्छार्दूलंवाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40015200, "chapter_id": 9218, "verse_number": "3", "content_sanskrit": "अयथावच्चतेवर्णोदीनश्चासिनिशाचर । नासिकच्चिदमित्राणांक्रुद्धानांवशमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40015201, "chapter_id": 9218, "verse_number": "4", "content_sanskrit": "इतितेनानुशिष्टस्तुवाचंमन्दमुदीरयत् । तदाराक्षसशार्दूलंशार्दूलोभयविह्वलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40015202, "chapter_id": 9218, "verse_number": "5", "content_sanskrit": "नतेचारयितुंशक्याराजन्वानरपुङ्गवाः । विक्रान्ताबलवन्तश्चराघवेणचरक्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40015203, "chapter_id": 9218, "verse_number": "6", "content_sanskrit": "नापिसम्भाषितुंशक्यास्सम्प्रश्नोऽत्रनलभ्यते । सर्वतोरक्ष्यतेपन्थावानरैःपर्वतोपमै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40015204, "chapter_id": 9218, "verse_number": "7", "content_sanskrit": "प्रविष्टमात्रेज्ञातोऽहंबलेतस्मिन्नचारिते । बलाद्गृहीतोरक्षोभिर्बहुधाऽस्मिविचालितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40015205, "chapter_id": 9218, "verse_number": "8", "content_sanskrit": "जानुभिर्मुष्टिभिर्दन्तेस्तलैश्चाभिहतोभृशम् । परिणीतोऽस्मिहरिभिर्बलवद्भिरमर्षणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40015206, "chapter_id": 9218, "verse_number": "9", "content_sanskrit": "परिणीयचसर्वत्रनीतोऽहंरामसंसदम् । रुधिरादिग्धसर्वाङ्गोविह्वलश्चलितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40015207, "chapter_id": 9218, "verse_number": "10", "content_sanskrit": "हरिभिर्वध्यमानश्चयाचमानःकृताञ्जलिः । राघवेणपरित्रातोजीवामीतियदृच्छया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40015208, "chapter_id": 9218, "verse_number": "11", "content_sanskrit": "एषशैलैश्शिलाभिश्चपूरयित्वामहार्णवम् । द्वारमाश्रित्यलङ्कायारामस्तिष्ठतिसायुधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40015209, "chapter_id": 9218, "verse_number": "12", "content_sanskrit": "गरुडव्यूहमास्थायसर्वतोहरिभिर्वृतः । मांविसृज्यमहातेजालङ्कामेवाभिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40015210, "chapter_id": 9218, "verse_number": "13", "content_sanskrit": "पुराप्राकारमायातिक्षिप्रमेकतरंकुरु । सीतांवास्मैप्रयच्छाशुयुद्धंवाप्रदीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40015211, "chapter_id": 9218, "verse_number": "14", "content_sanskrit": "मनसातंतदाप्रेक्ष्यतच्छ्रुत्वाराक्षसाधिपः । शार्दूलंसुमहद्वाक्यमथोवाचसरावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40015212, "chapter_id": 9218, "verse_number": "15", "content_sanskrit": "यदिमांप्रतियुध्येरन्देवगन्धर्वदानवाः । नैवसीतांप्रदास्यामिसर्वलोकभयादपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40015213, "chapter_id": 9218, "verse_number": "16", "content_sanskrit": "एवमुक्त्वामहातेजारावणःपुनरब्रवीत् । चरिताभवतासेनाकेऽत्रशूराःप्लवङ्गमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40015214, "chapter_id": 9218, "verse_number": "17", "content_sanskrit": "कीदृशा: किंप्रभा: सौम्यवानरायेदुरासदाः । कस्यपुत्राश्चपौत्राश्चतत्त्वमाख्याहिराक्षस: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40015215, "chapter_id": 9218, "verse_number": "18", "content_sanskrit": "तथात्रप्रतिपत्स्यामिज्ञात्वातेषांबलाबलम् । अवश्यंबलसङ् ख्यानंकर्तव्यंयुद्धमिच्छताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40015216, "chapter_id": 9218, "verse_number": "19", "content_sanskrit": "अथैवमुक्तश्शार्दूलोरावणेनोत्तमश्चरः । इदंवचनमारेभेवक्तुंरावणसन्निधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40015217, "chapter_id": 9218, "verse_number": "20", "content_sanskrit": "अथर्क्षरजसःपुत्रोयुधिराजासुदुर्जयः । गद्गदस्याथपुत्त्रोऽत्रजाम्बवानितिविश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40015218, "chapter_id": 9218, "verse_number": "21", "content_sanskrit": "गद्गदस्यैवपुत्त्रोऽन्योगुरुपुत्र: शतक्रतोः । कदनंयस्यपुत्रेणकृतमेकेनरक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40015219, "chapter_id": 9218, "verse_number": "22", "content_sanskrit": "सुषेणश्चापिधर्मात्मापुत्रोधर्मस्यवीर्यवान् । सौम्यस्सोमात्