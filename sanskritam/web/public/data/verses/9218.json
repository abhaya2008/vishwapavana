[{"id": 5000218000, "chapter_id": 9218, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे द्वाविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000218001, "chapter_id": 9218, "verse_number": "३-२२-१", "content_sanskrit": "एवमाधर्षितः शूरः शूर्पणख्या खरस्ततः।\nउवाच रक्षसां मध्ये खरः खरतरं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000218002, "chapter_id": 9218, "verse_number": "३-२२-२", "content_sanskrit": "तवापमानप्रभवः क्रोधोऽयमतुलो मम।\nन शक्यते धारयितुं लवणाम्भ इवोल्बणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000218003, "chapter_id": 9218, "verse_number": "३-२२-३", "content_sanskrit": "न रामं गणये वीर्यान्मानुषं क्षीणजीवितम्।\nआत्मदुश्चरितैः प्राणान् हतो योऽद्य विमोक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000218004, "chapter_id": 9218, "verse_number": "३-२२-४", "content_sanskrit": "बाष्पः संधार्यतामेष सम्भ्रमश्च विमुच्यताम्।\nअहं रामं सह भ्रात्रा नयामि यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000218005, "chapter_id": 9218, "verse_number": "३-२२-५", "content_sanskrit": "परश्वधहतस्याद्य मन्दप्राणस्य भूतले।\nरामस्य रुधिरं रक्तमुष्णं पास्यसि राक्षसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000218006, "chapter_id": 9218, "verse_number": "३-२२-६", "content_sanskrit": "सम्प्रहृष्टा वचः श्रुत्वा खरस्य वदनाच्च्युतम्।\nप्रशशंस पुनर्मौर्ख्याद् भ्रातरं रक्षसां वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000218007, "chapter_id": 9218, "verse_number": "३-२२-७", "content_sanskrit": "तया परुषितः पूर्वं पुनरेव प्रशंसितः।\nअब्रवीद् दूषणं नाम खरः सेनापतिं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000218008, "chapter_id": 9218, "verse_number": "३-२२-८", "content_sanskrit": "चतुर्दश सहस्राणि मम चित्तानुवर्तिनाम्।\nरक्षसां भीमवेगानां समरेष्वनिवर्तिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000218009, "chapter_id": 9218, "verse_number": "३-२२-९", "content_sanskrit": "नीलजीमूतवर्णानां लोकहिंसाविहारिणाम्।\nसर्वोद्योगमुदीर्णानां रक्षसां सौम्य कारय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000218010, "chapter_id": 9218, "verse_number": "३-२२-१०", "content_sanskrit": "उपस्थापय मे क्षिप्रं रथं सौम्य धनूंषि च।\nशरांश्च चित्रान् खड्गांश्च शक्तीश्च विविधाः शिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000218011, "chapter_id": 9218, "verse_number": "३-२२-११", "content_sanskrit": "अग्रे निर्यातुमिच्छामि पौलस्त्यानां महात्मनाम्।\nवधार्थं दुर्विनीतस्य रामस्य रणकोविद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000218012, "chapter_id": 9218, "verse_number": "३-२२-१२", "content_sanskrit": "इति तस्य ब्रुवाणस्य सूर्यवर्णं महारथम्।\nसदश्वैः शबलैर्युक्तमाचचक्षेऽथ दूषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000218013, "chapter_id": 9218, "verse_number": "३-२२-१३", "content_sanskrit": "तं मेरुशिखराकारं तप्तकाञ्चनभूषणम्।\nहेमचक्रमसम्बाधं वैदूर्यमयकूबरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000218014, "chapter_id": 9218, "verse_number": "३-२२-१४", "content_sanskrit": "मत्स्यैः पुष्पैर्द्रुमैः शैलैश्चन्द्रसूर्यैश्च काञ्चनैः।\nमाङ्गल्यैः पक्षिसङ्घैश्च ताराभिश्च समावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000218015, "chapter_id": 9218, "verse_number": "३-२२-१५", "content_sanskrit": "ध्वजनिस्त्रिंशसम्पन्नं किंकिणीवरभूषितम्।\nसदश्वयुक्तं सोऽमर्षादारुरोह खरस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000218016, "chapter_id": 9218, "verse_number": "३-२२-१६", "content_sanskrit": "खरस्तु तन्महत्सैन्यं रथचर्मायुधध्वजम्।\nनिर्यातेत्यब्रवीत् प्रेक्ष्य दूषणः सर्वराक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000218017, "chapter_id": 9218, "verse_number": "३-२२-१७", "content_sanskrit": "ततस्तद् राक्षसं सैन्यं घोरचर्मायुधध्वजम्।\nनिर्जगाम जनस्थानान्महानादं महाजवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000218018, "chapter_id": 9218, "verse_number": "३-२२-१८", "content_sanskrit": "मुद‍्गरैः पट्टिशैः शूलैः सुतीक्ष्णैश्च परश्वधैः।\nखड्गैश्चक्रैश्च हस्तस्थैर्भ्राजमानैः सतोमरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000218019, "chapter_id": 9218, "verse_number": "३-२२-१९", "content_sanskrit": "शक्तिभिः परिघैर्घोरैरतिमात्रैश्च कार्मुकैः।\nगदासिमुसलैर्वज्रैर्गृहीतैर्भीमदर्शनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000218020, "chapter_id": 9218, "verse_number": "३-२२-२०", "content_sanskrit": "राक्षसानां सुघोराणां सहस्राणि चतुर्दश।\nनिर्यातानि जनस्थानात् खरचित्तानुवर्तिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000218021, "chapter_id": 9218, "verse_number": "३-२२-२१", "content_sanskrit": "तांस्तु निर्धावतो दृष्ट्वा राक्षसान् भीमदर्शनान्।\nखरस्याथ रथः किंचिज्जगाम तदनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000218022, "chapter_id": 9218, "verse_number": "३-२२-२२", "content_sanskrit": "ततस्ताञ्छबलानश्वांस्तप्तकाञ्चनभूषितान्।\nखरस्य मतमाज्ञाय सारथिः पर्यचोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000218023, "chapter_id": 9218, "verse_number": "३-२२-२३", "content_sanskrit": "संचोदितो रथः शीघ्रं खरस्य रिपुघातिनः।\nशब्देनापूरयामास दिशः सप्रदिशस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000218024, "chapter_id": 9218, "verse_number": "३-२२-२४", "content_sanskrit": "प्रवृद्धमन्युस्तु खरः खरस्वरो\nरिपोर्वधार्थं त्वरितो यथान्तकः।\nअचूचुदत् सारथिमुन्नदन् पुन-\nर्महाबलो मेघ इवाश्मवर्षवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000218025, "chapter_id": 9218, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे द्वाविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]