null, "display_order": 27}, {"id": 40015225, "chapter_id": 9218, "verse_number": "28", "content_sanskrit": "पुत्त्रोदशरथस्यैषसिंहसंहनोयुवा । दूषणोनिहतोयेनखरश्चत्रिशिरास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40015226, "chapter_id": 9218, "verse_number": "29", "content_sanskrit": "नास्तिरामस्यसदृशोविक्रमेभुविकश्चन । विराधोनिहतोयेनकबन्धश्चान्तकोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40015227, "chapter_id": 9218, "verse_number": "30", "content_sanskrit": "वक्तुंनशक्तोरामस्यनरःकश्चिद्गुणान् क्षितौ । जनस्थानगतायेनयावन्तोराक्षसाहताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40015228, "chapter_id": 9218, "verse_number": "31", "content_sanskrit": "लक्ष्मणश्चात्रधर्मात्मामातङ्गानामिवर्षभः । यस्यबाणपथंप्राप्यनजीवेदपिवासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40015229, "chapter_id": 9218, "verse_number": "32", "content_sanskrit": "श्वेतोज्योतिर्मुखश्चात्रभास्करस्यात्मसम्भवौ । वरुणस्यचपुत्त्रोऽन्योःहेमकूटःप्लवङ्गमः ॥ विश्वकर्मसुतोवीरोनलःप्लवगसत्तमः । विक्रान्तोबलवानत्रवसुपुत्रस्सदुर्धरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40015230, "chapter_id": 9218, "verse_number": "33", "content_sanskrit": "श्वेतोज्योतिर्मुखश्चात्रभास्करस्यात्मसम्भवौ । वरुणस्यचपुत्त्रोऽन्योःहेमकूटःप्लवङ्गमः ॥ विश्वकर्मसुतोवीरोनलःप्लवगसत्तमः । विक्रान्तोबलवानत्रवसुपुत्रस्सदुर्धरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40015231, "chapter_id": 9218, "verse_number": "34", "content_sanskrit": "राक्षसानांवरिष्ठश्चतवभ्रातावीभीषणः । प्रतिगृह्यपुरींलङ्कांराघवस्यहिते