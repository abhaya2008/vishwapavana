[{"id": 2022412, "chapter_id": 1470, "verse_number": "३-१०८-०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2022413, "chapter_id": 1470, "verse_number": "३-१०८-१", "content_sanskrit": "स तु राजा महेष्वासश्चक्रवर्ती महारथः।\nबभूव सर्वलोकस् मनोनयननन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2022414, "chapter_id": 1470, "verse_number": "३-१०८-२", "content_sanskrit": "स शुश्राव महाबाहुः कपिलेन महात्मना।\nपितॄणआं निधनं घोरमप्राप्तिं त्रिदिवस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2022415, "chapter_id": 1470, "verse_number": "३-१०८-३", "content_sanskrit": "स राज्यं सचिवे न्यस्य हृदयेन विदूयता।\nजगाम हिमवत्पार्श्वं तपस्तप्तुं नरेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2022416, "chapter_id": 1470, "verse_number": "३-१०८-४", "content_sanskrit": "आरिराधयिषुर्गङ्गां तपसा दग्धकिल्विषः।\nसोऽपश्यत नर्रेष्ठ हिमवन्तं नगोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2022417, "chapter_id": 1470, "verse_number": "३-१०८-५", "content_sanskrit": "शृङ्गैर्बहुविधाकारैर्धातुमद्भिरलंकृतम्।\nपवनालम्बिभिर्मेघैः परिपिक्तं समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2022418, "chapter_id": 1470, "verse_number": "३-१०८-६", "content_sanskrit": "नदीकुञ्जनितम्बैश्च सोदकैरुपशोभितम्।\nगुहाकन्दरसंलीनसिंहव्याघ्रनिषेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2022419, "chapter_id": 1470, "verse_number": "३-१०८-७", "content_sanskrit": "शकुनैश्च विचित्राङ्गैः कूजद्भिर्विविधा गिरः।\nभृङ्गराजैस्तथा हंसैर्दात्यूहैर्जलकुक्कुटैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2022420, "chapter_id": 1470, "verse_number": "३-१०८-८", "content_sanskrit": "मयूरैः शतपत्रैश्च जीवंजीवककोकिलैः।\nचकोरैरसितापाङ्गैस्तथा पुत्रप्रियैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2022421, "chapter_id": 1470, "verse_number": "३-१०८-९", "content_sanskrit": "जलस्थानेषु रम्येषु पद्मिनीभिश्च संकुलम्।\nसारसानां च मधुरैर्व्याहृतैः समलंकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2022422, "chapter_id": 1470, "verse_number": "३-१०८-१०", "content_sanskrit": "किन्नरैरप्सरोभिश्च निषेवितशिलातलम्।\nदिग्वारणविषाणाग्रैः समन्ताद्धृष्टपादपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2022423, "chapter_id": 1470, "verse_number": "३-१०८-११", "content_sanskrit": "विद्याधरानुचरितं नानारत्नसमाकुलम्।\nविषोल्वणैर्भुजङ्गैश्च दीप्ताजिह्वैर्निषेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2022424, "chapter_id": 1470, "verse_number": "३-१०८-१२", "content_sanskrit": "क्वचित्कनकसंकाशं क्वचिद्रजतसंनिभम्।\nक्वचिदञ्जनपुञ्जाभं हिमवनतमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2022425, "chapter_id": 1470, "verse_number": "३-१०८-१३", "content_sanskrit": "स तु तत्रनरश्रेष्ठस्तपो घोरं समाश्रितः।\nफलमूलाम्बुसंभक्षः सहस्रपरिवत्सरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2022426, "chapter_id": 1470, "verse_number": "३-१०८-१४", "content_sanskrit": "संवत्सरसहस्रे तु गते दिव्ये महानदी।\nदर्शयामास तं गङ्गा तदा मूर्तिमती स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2022427, "chapter_id": 1470, "verse_number": "३-१०८-१५x", "content_sanskrit": "गङ्गोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2022428, "chapter_id": 1470, "verse_number": "३-१०८-१५", "content_sanskrit": "किमिच्छसि महाराज म्तः किंच ददानि ते।\nतद्ब्रवीहि नरश्रेष्ठ करिष्यामि वचस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2022429, "chapter_id": 1470, "verse_number": "३-१०८-१६", "content_sanskrit": "एवमुक्तः प्रत्युवाच राजा हैमवतीं नदीम्।\n`तदा भगीरथो राजन्प्रणिपत्य कृताञ्जलिः।\nपितामहा मे वरदे कपिलेन महानदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2022430, "chapter_id": 1470, "verse_number": "३-१०८-१७", "content_sanskrit": "अन्वेषमाणास्तुरगं नीता वैवस्वतक्षयम्।\nषष्टिस्तानि सहस्राणि सागराणां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2022431, "chapter_id": 1470, "verse_number": "३-१०८-१८", "content_sanskrit": "कपिलं देवमासाद्य क्षणेन निधनं गताः।\nतेषामेवं विनष्टानां स्वर्गे वासो न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2022432, "chapter_id": 1470, "verse_number": "३-१०८-१९", "content_sanskrit": "यावत्तानि शरीराणि त्वं जलैर्नाभिषिञ्चसि।\nतावत्तेषां गतिर्नास्ति सागराणां महानदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2022433, "chapter_id": 1470, "verse_number": "३-१०८-२०", "content_sanskrit": "स्वर्गं नय महाभागे मत्पितॄन्सगरात्मजान्।\nतेषामर्थेऽभियाचामि त्वामहं वै महानदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2022434, "chapter_id": 1470, "verse_number": "३-१०८-२१x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2022435, "chapter_id": 1470, "verse_number": "३-१०८-२१", "content_sanskrit": "एतच्छ्रुत्वा वचो राज्ञो गङ्गा लोकनमस्कृता।\nभगीरथमिदं वाक्यं सुप्रीता समभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2022436, "chapter_id": 1470, "verse_number": "३-१०८-२२", "content_sanskrit": "करिष्यामि माहाराज वचस्ते नात्र संशयः।\nवेगं तु मम दुर्धार्यं पतन्त्या गगनाच्च्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2022437, "chapter_id": 1470, "verse_number": "३-१०८-२३", "content_sanskrit": "न शक्तस्त्रिषु लोकेषु कश्चिद्धारयितुं नृप।\nअन्यत्र विबुधश्रेष्ठान्नीलकण्ठान्महेश्वरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2022438, "chapter_id": 1470, "verse_number": "३-१०८-२४", "content_sanskrit": "तं तोषय रमहाबाहो तपसा वरदं हरम्।\nस तु मां प्रच्युतां देवः शिरसा धारयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2022439, "chapter_id": 1470, "verse_number": "३-१०८-२५", "content_sanskrit": "स करिष्यति ते रकामं पितॄणां हितकाम्यया।\n`तपसाऽऽराधितः शंभुर्भगर्वाँल्लोकभावनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2022440, "chapter_id": 1470, "verse_number": "३-१०८-२६", "content_sanskrit": "एतच्छ्रुत्वा ततो राजन्महाराजो भगीरथः।\nकैलासं पर्वतं गत्वा तोषयामास शंकरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2022441, "chapter_id": 1470, "verse_number": "३-१०८-२७", "content_sanskrit": "ततस्तेन समागम्य कालयोगेन केनचित्।\n`गह्गावतरणं राजन्नयाचत महीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2022442, "chapter_id": 1470, "verse_number": "३-१०८-२८", "content_sanskrit": "अगृह्णाच्च वरं तस्माद्गङ्गाया धारणे नृप।\nस्वर्गे वासं समुद्दिश् पितॄणां स नरोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2022443, "chapter_id": 1470, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि अष्टाधिकशततमोऽध्यायः ॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]