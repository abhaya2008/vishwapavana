[{"id": 7001769000, "chapter_id": 21769, "verse_number": "२-३०-१", "content_sanskrit": "काष्ठीलोवाच ।\nभार्यायास्तद्वचः श्रुत्वा राक्षस्या धर्मसंमितम् ।\nपृष्ठात्करोणुरूपिण्याः सकन्योऽवातरद्द्विजः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001769001, "chapter_id": 21769, "verse_number": "२-३०-२", "content_sanskrit": "अवतीर्णे द्विजे साभूत्सुरूपा प्रमदा पुनः ।\nक्षपाचरी क्षपानाथवक्त्रा पीनोन्नतस्तनी ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001769002, "chapter_id": 21769, "verse_number": "२-३०-३", "content_sanskrit": "सा कुमारी ततः प्राप्य नगरं स्वपितुः शुभम् ।\nबाह्यरक्षास्थित प्राप्तं पुरपालमुवाच ह ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001769003, "chapter_id": 21769, "verse_number": "२-३०-४", "content_sanskrit": "गच्छ त्वं नृपतेः पार्श्वं पितुर्मम पुराधिप ।\nब्रूहि मां समनुप्राप्तां रत्नशालां पुरा हृताम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001769004, "chapter_id": 21769, "verse_number": "२-३०-५", "content_sanskrit": "रत्नावलिं रत्नभूतां सुद्युम्नस्य महीक्षितुः ।\nतल्पथा रक्षसा रात्रौ स्वपुरस्था हृता द्विज ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001769005, "chapter_id": 21769, "verse_number": "२-३०-६", "content_sanskrit": "पुनः सा समनुप्राप्ता जीवमानाऽक्षता पितः ।\nसमाश्वसिहि शोकं त्वं मा कृथा मत्कृते क्वचित् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001769006, "chapter_id": 21769, "verse_number": "२-३०-७", "content_sanskrit": "अविप्लुतास्मि राजेंद्र गांगा आप इवामलाः ।\nतव कीर्तिकरी तद्वन्मातुः सौशील्यसूचिका ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001769007, "chapter_id": 21769, "verse_number": "२-३०-८", "content_sanskrit": "तत्कुमारीवचः श्रुत्वा पुरापालस्त्वरान्वितः ।\nअबाहुरिति विख्यातः प्राप्तः सुद्युम्रसन्निधौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001769008, "chapter_id": 21769, "verse_number": "२-३०-९", "content_sanskrit": "कृतप्रणामः संपृष्टः प्राह राजानमादरात् ।\nराजन्नुपागता नष्टा दिहिता तव मानद ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001769009, "chapter_id": 21769, "verse_number": "२-३०-१०", "content_sanskrit": "रत्नावलीति विख्याता सस्त्रीकद्विदजसंयुता ।\nपुरबाह्ये स्थिता दृष्टा मया ज्ञाता न चाभवत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001769010, "chapter_id": 21769, "verse_number": "२-३०-११", "content_sanskrit": "तयाहं प्रेरितः प्रागां त्वां विज्ञापयितुं प्रभो ।\nअविप्लुताहं वदति मां जानातु समागताम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001769011, "chapter_id": 21769, "verse_number": "२-३०-१२", "content_sanskrit": "पितरं मम सत्कृत्यै नात्र कार्या विचारणा ।\nतदद्भुतं वचः श्रुत्वा पुरपालस्य तत्क्षणात् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001769012, "chapter_id": 21769, "verse_number": "२-३०-१३", "content_sanskrit": "सामात्यः सकलत्रस्तु सद्विजो निर्ययौ नृपः ।\nस तु गत्वा पुराद्ब्राह्ये गंगातीरे व्यवस्थिताम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001769013, "chapter_id": 21769, "verse_number": "२-३०-१४", "content_sanskrit": "अपश्यद्भास्कराकारां सस्त्रीकद्विजसंयुताम् ।\nसहजे नैव वेषेण भूषितां भूषणप्रियाम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001769014, "chapter_id": 21769, "verse_number": "२-३०-१५", "content_sanskrit": "अम्लानकुसुमप्रख्यां तत्पकांचनसुप्रभाम् ।\nदूराद्दृष्ट्वांतिकं गत्वा पर्यष्वजत भूपतिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001769015, "chapter_id": 21769, "verse_number": "२-३०-१६", "content_sanskrit": "पितरं सापि संहृष्टा समाश्लिष्य ननाम ह ।\nततश्च मात्रा संगम्य हृष्टया हर्षितांतरा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001769016, "chapter_id": 21769, "verse_number": "२-३०-१७", "content_sanskrit": "प्राह वाक्यं विशालाक्षी संबोध्य पितरं नृपम् ।\nसुप्ताहं रत्नशालायां सखीभिः परिवारिता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001769017, "chapter_id": 21769, "verse_number": "२-३०-१८", "content_sanskrit": "उदकूकृत्वा शिरस्ताताधौतांघ्रिर्मंचकोपरि ।\nचिंतयत्नी भर्तृयोगं निशीथे रक्षसा हृता ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001769018, "chapter_id": 21769, "verse_number": "२-३०-१९", "content_sanskrit": "स मां गृहीत्वा स्वपुरं प्रागादर्णवगे गिरौ ।\nनानारत्नमये तत्र गुहायां स्थापिता ह्यहम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001769019, "chapter_id": 21769, "verse_number": "२-३०-२०", "content_sanskrit": "स तत्रोद्वहनोपायचिंतयांतर्व्यवस्थितः ।\nतस्य भार्या त्वियं सुभ्रूर्या तिष्ठति सुमध्यमा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001769020, "chapter_id": 21769, "verse_number": "२-३०-२१", "content_sanskrit": "बिभ्रती मानुषं रूपं राक्षसी राक्षसप्रिया ।\nअनया बुद्धियोगेन शक्त्या शक्रस्य भूपते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001769021, "chapter_id": 21769, "verse_number": "२-३०-२२", "content_sanskrit": "घातितो विप्रहस्तेन क्रूरकर्मा पतिः स्वकः ।\nपुरैव मम तं शैलं प्राप्तो देवेन भूसुरः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001769022, "chapter_id": 21769, "verse_number": "२-३०-२३", "content_sanskrit": "इयं तु राक्षसी दृष्ट्वा पतिं स्वं धर्मदूषकम् ।\nविप्रेण संविदं कृत्वा दांपत्ये निजकर्मणा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001769023, "chapter_id": 21769, "verse_number": "२-३०-२४", "content_sanskrit": "रूपेणाप्यस्य संमुग्धा घातयामास राक्षसम् ।\nएवं कृत्वा पतिं विप्रं हस्तिनीरूपधारिणी ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001769024, "chapter_id": 21769, "verse_number": "२-३०-२५", "content_sanskrit": "गृहीत्वा वास्तुकं वित्तं पृष्ठमारोप्य मामपि ।\nसमायातात्र भूपाल मामत्तुं तव मंदिरम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001769025, "chapter_id": 21769, "verse_number": "२-३०-२६", "content_sanskrit": "अनया रक्षिता राजन् राक्षस्याराक्षसात्ततः ।\nतस्मादिमां पूजयस्व सत्कृत्याग्रजसंयुताम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001769026, "chapter_id": 21769, "verse_number": "२-३०-२७", "content_sanskrit": "अस्या एवामुमत्या मां देह्यस्मै ब्राह्मणाय हि ।\nअनेनैकासनगता जाता भर्ता स मे भवत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001769027, "chapter_id": 21769, "verse_number": "२-३०-२८", "content_sanskrit": "येनैकासनगा नारी भवेद्भर्ता स एव हि ।\nनान्य इत्थँ पुराणेषु श्रूयते ह्यागमेष्वपि ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001769028, "chapter_id": 21769, "verse_number": "२-३०-२९", "content_sanskrit": "अस्याः पृष्ठे निविष्टाहं प्रीत्या सह द्विजन्मना ।\nधर्मत स्तेन मद्भर्ता भवेदेषा मतिर्मम ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001769029, "chapter_id": 21769, "verse_number": "२-३०-३०", "content_sanskrit": "तस्मादिमां सांत्वयित्वा शास्त्रागमविधानतः ।\nदेहि विप्राय मां तात पितमन्यं वृणे न च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001769030, "chapter_id": 21769, "verse_number": "२-३०-३१", "content_sanskrit": "तच्छ्रुत्वा दुहितुर्वाक्यं सुद्युम्नो भूपतिस्तदा ।\nसांत्वयामास तन्वंगीं राक्षसीं प्रश्रयानतः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001769031, "chapter_id": 21769, "verse_number": "२-३०-३२", "content_sanskrit": "सुतैषा धर्मभीता मे त्वामेव शरणं गता ।\nयदर्थं निहतः कांतस्त्वया पूर्वतरः सति ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001769032, "chapter_id": 21769, "verse_number": "२-३०-३३", "content_sanskrit": "त्वदधीना ततो भद्रे जातेयं मत्सुता किल ।\nइममिच्छति भर्तारं योऽयं भर्ता कृतस्त्वया ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001769033, "chapter_id": 21769, "verse_number": "२-३०-३४", "content_sanskrit": "मया प्रणामदानाभ्यां याचिता त्वं निशाचरि ।\nअनुमोदय साहाय्ये सुतां मम सुलोचने ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001769034, "chapter_id": 21769, "verse_number": "२-३०-३५", "content_sanskrit": "त्वद्वाक्याद्भवतु प्रेष्या मत्सुता ब्राह्मणस्य तु ।\nसापत्नभावं त्यक्त्वा तु सुतां मे परिपालय ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001769035, "chapter_id": 21769, "verse_number": "२-३०-३६", "content_sanskrit": "सुताया मम भार्याया मद्बलस्य जनस्य च ।\nपुरस्य विषयस्यापि स्वामिनी त्वं न संशयः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001769036, "chapter_id": 21769, "verse_number": "२-३०-३७", "content_sanskrit": "तव वाक्ये स्थिता ह्येषा सदैवापि भविष्यति ।\nएतच्छ्रुत्त्वा तु वचनं सुद्युम्नस्य निशाचरी ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001769037, "chapter_id": 21769, "verse_number": "२-३०-३८", "content_sanskrit": "अन्वमोदत शुद्धेन चेतसा सहचारिणी ।\nउवाच च धरापालं प्रदानाय कृतोद्यमम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001769038, "chapter_id": 21769, "verse_number": "२-३०-३९", "content_sanskrit": "यदर्थं प्रणतस्त्वं मां सद्भावेन नृपोत्तम ।\nतस्माद्द्वितीया भार्येयं भवत्वस्य द्विजन्मनः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001769039, "chapter_id": 21769, "verse_number": "२-३०-४०", "content_sanskrit": "अहं च भवता पूज्या कृत्वार्चां देवमंदिरे ।\nसर्वैश्च नागरैः सार्द्धं फाल्गुने धवले दले ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001769040, "chapter_id": 21769, "verse_number": "२-३०-४१", "content_sanskrit": "सप्ताहमुत्सवः कार्यो ह्यष्टम्या आचतुर्दशीम् ।\nनटनर्तकयुक्तेन गीतवाद्येन भूरिणा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001769041, "chapter_id": 21769, "verse_number": "२-३०-४२", "content_sanskrit": "मैरेयमांसरक्तादिबलिभिश्चापि पूजया ।\nएवं प्रकुर्वते तुभ्यं सदा क्षेमकरी ह्यहम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001769042, "chapter_id": 21769, "verse_number": "२-३०-४३", "content_sanskrit": "भवेयं नृपशार्दूल स्वं वचः प्रतिपालय ।\nतच्छ्रुत्वा वचनं तस्याः सुद्युम्नो नृपतिस्तदा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001769043, "chapter_id": 21769, "verse_number": "२-३०-४४", "content_sanskrit": "अंगीचकार तत्सर्वं यदुक्तं प्रीतया तया ।\nप्रतिपन्ने तु वचसि राज्ञा तुष्टा तु राक्षसी ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001769044, "chapter_id": 21769, "verse_number": "२-३०-४५", "content_sanskrit": "उवाच ब्राह्मणं प्रेम्णा कुरु भार्यामिमामपि ।\nराजकन्यां द्विजश्रेष्ठ गृह्योक्तविधिना शुभाम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001769045, "chapter_id": 21769, "verse_number": "२-३०-४६", "content_sanskrit": "ईर्ष्यां त्यक्त्वा विशालाक्ष्या भवाम्येषा सहोदरी ।\nराक्षस्या वचनेनेह परिणीय नृपात्मजाम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001769046, "chapter_id": 21769, "verse_number": "२-३०-४७", "content_sanskrit": "बहुवित्तयुतां विप्रो महोदयपुरं ययौ ।\nआरुह्य करिणीरूपां राक्षसीं क्षणमात्रतः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001769047, "chapter_id": 21769, "verse_number": "२-३०-४८", "content_sanskrit": "ततो मया श्रुतं देवि भर्ता ते समुपागतः ।\nधनरत्नसमायुक्तो भार्याद्वयसमन्वितः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001769048, "chapter_id": 21769, "verse_number": "२-३०-४९", "content_sanskrit": "ततोऽहं बंधुवर्गेण पितृभ्यां च सखीगणैः ।\nबहुशो भर्त्सिता रूक्षैर्वचनैर्मर्मभेदिभिः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001769049, "chapter_id": 21769, "verse_number": "२-३०-५०", "content_sanskrit": "कथं यास्यसि भर्तारं धनलुब्धे श्रिया वृतम् ।\nयस्त्वया निर्द्धनः पूर्वं परित्यक्तः सुदीनवत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001769050, "chapter_id": 21769, "verse_number": "२-३०-५१", "content_sanskrit": "चंचलानीह वित्तानि पित्र्याणि किल योषिताम् ।\nकांतार्जितानि सुभगे स्थिराणीति निगद्यते ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001769051, "chapter_id": 21769, "verse_number": "२-३०-५२", "content_sanskrit": "परुषैर्वचनैर्यस्तु क्षिप्तस्तद्भाषणं कथम् ।\nभविष्यति प्रवेशोऽपि दुष्करस्तस्य वेश्मनि ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001769052, "chapter_id": 21769, "verse_number": "२-३०-५३", "content_sanskrit": "गताया अपि ते तत्र शयनं पतिना सह ।\nभविष्यति दुराचारे सुखदं न कदाचन ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001769053, "chapter_id": 21769, "verse_number": "२-३०-५४", "content_sanskrit": "लोकापवादाद्यदि चेद्ग्रहीष्यति पतिस्तव ।\nत्वां स्नेहहीनचित्तस्तु न कदाचिन्मिलिष्यति ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001769054, "chapter_id": 21769, "verse_number": "२-३०-५५", "content_sanskrit": "नेदृशं दुःखदं किंचिद्यादृशं दूरचित्तयोः ।\nदंपकत्योर्मिलनं लोके वैकल्यकरणं महत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001769055, "chapter_id": 21769, "verse_number": "२-३०-५६", "content_sanskrit": "एवं बहुविधा वाचः श्रृण्वाना बंधुभाषिताः ।\nअधोमुख्यस्रुपूर्णाक्षी बभूवाहं सुदुःखिता ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001769056, "chapter_id": 21769, "verse_number": "२-३०-५७", "content_sanskrit": "चेतसार्चितयं चाहं पूर्वलोभेन मुह्यती ।\nन दत्तं कंकणं पाणेर्न दत्तं कटिसूत्रकम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001769057, "chapter_id": 21769, "verse_number": "२-३०-५८", "content_sanskrit": "न चापि नूपुरे दत्ते येन तुष्टिं व्रजेत्पतिः ।\nधनजीवितयोः स्वामी भर्ता लोकेषु गीयते ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001769058, "chapter_id": 21769, "verse_number": "२-३०-५९", "content_sanskrit": "तन्मयापहृतं वित्तं भवित्री का गतिर्मम ।\nकथं यास्यामि तद्वेश्म कथं संभाषये पुनः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001769059, "chapter_id": 21769, "verse_number": "२-३०-६०", "content_sanskrit": "यो मया दुष्टया त्यक्तः स प्रत्येति कथं हि माम् ।\nएवं विचिंये यादद्धृदयेन विदूयता ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001769060, "chapter_id": 21769, "verse_number": "२-३०-६१", "content_sanskrit": "वेष्टिता बंधुवर्गेण तावद्दोला समागता ।\nछत्रेण शशिवर्णेन शोभमाना सुकोमला ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001769061, "chapter_id": 21769, "verse_number": "२-३०-६२", "content_sanskrit": "आस्तृता रांकवैः पीनैः पुरुषोर्विधृतांसकैः ।\nते समागत्य पुरुषाः प्रोचुर्मामसकृच्छभे ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001769062, "chapter_id": 21769, "verse_number": "२-३०-६३", "content_sanskrit": "आकारितासि पत्या ते व्रज शीघ्रं मुदान्विता ।\nधनरत्नयुतो भर्ता सद्धिभार्यः समागतः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001769063, "chapter_id": 21769, "verse_number": "२-३०-६४", "content_sanskrit": "प्रविष्टमात्रेण गृहे त्वामानेतुं वरानने ।\nप्रेषिताः सत्वरं पत्या संस्थितां पितृवेश्मनि ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001769064, "chapter_id": 21769, "verse_number": "२-३०-६५", "content_sanskrit": "ततोऽहं व्रीडिता देवि भर्तुस्तद्वीक्ष्य चेष्टितम् ।\nनैवोत्तरमदां तेभ्यः किंचिन्मौनं समास्थिता ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001769065, "chapter_id": 21769, "verse_number": "२-३०-६६", "content_sanskrit": "ततोऽहं बंधुवर्गेण भूयोभूयः प्रबोधिता ।\nआहूता स्वामिना गच्छ सम्मानेन तदंतिकम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001769066, "chapter_id": 21769, "verse_number": "२-३०-६७", "content_sanskrit": "स्वामिनाकारिता पत्नी या न याति तदंतिकम् ।\nसा तु ध्वांक्षी भवेत्पुत्रि जन्मानि दश पंच च ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001769067, "chapter_id": 21769, "verse_number": "२-३०-६८", "content_sanskrit": "एवमुक्त्वा समाश्वास्य मां गृहीत्वा त्वरान्विताः ।\nदोलामारोप्य गच्छेति प्रोचुः स्निग्धा मुहुर्मुर्हुः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001769068, "chapter_id": 21769, "verse_number": "२-३०-६९", "content_sanskrit": "ततस्ते पुरुषा दोलां निधायांसेषु सत्वरम् ।\nजग्मुर्महोदयपुरं यत्र तिष्ठति मे पतिः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001769069, "chapter_id": 21769, "verse_number": "२-३०-७०", "content_sanskrit": "दृष्टं मया गृहं तस्य सर्वतः कांचनावृतम् ।\nआसनीयैश्च भोज्यैश्च धनैर्वस्त्रैर्युतं ततः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001769070, "chapter_id": 21769, "verse_number": "२-३०-७१", "content_sanskrit": "अथ सा राक्षसी देवी सा चापि नृपनंदिनी ।\nप्रीत्या च भक्त्या कुरुतां प्रणतिं मम सुन्दरि ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001769071, "chapter_id": 21769, "verse_number": "२-३०-७२", "content_sanskrit": "ततस्ताभ्यामहं प्रेम्णा यथार्हमभिपूजिता ।\nभर्तृवाक्येन संप्रीता स्नात्वाभुजं तथाहृता ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001769072, "chapter_id": 21769, "verse_number": "२-३०-७३", "content_sanskrit": "ततोऽस्तसमयात्पश्चाद्भर्ता चाहूय सत्वरम् ।\nपरिष्वज्य चिरं दोर्भ्यां पर्यंके संन्यवेशयत् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001769073, "chapter_id": 21769, "verse_number": "२-३०-७४", "content_sanskrit": "ततो निशाचरीं राजपुत्रीं चाहूय सोऽब्रवीत् ।\nभक्त्या युवाभ्यां कर्तव्यमस्याश्चरणसेवनम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001769074, "chapter_id": 21769, "verse_number": "२-३०-७५", "content_sanskrit": "इयं प्राक्कालिकी भार्या ज्येष्ठा च युवयोर्द्भुवम् ।\nपत्युर्वाक्यात्ततस्ताभ्यां गृहीतौ चरणौ मम ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001769075, "chapter_id": 21769, "verse_number": "२-३०-७६", "content_sanskrit": "सापत्नभावजामीर्ष्यां परित्यज्य सुलोचने ।\nततः प्रेष्यान्समाहूय भर्ता मे वाक्यमब्रवीत् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001769076, "chapter_id": 21769, "verse_number": "२-३०-७७", "content_sanskrit": "यत्किंचिद्रक्षसः पार्श्वान्मया प्राप्तं पुरा वसु ।\nसुतामुद्वहतो राज्ञो यच्च लब्धं मयाखिलम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001769077, "chapter_id": 21769, "verse_number": "२-३०-७८", "content_sanskrit": "तत्सर्वं भक्तिभावेन समानयत मा चिरम् ।\nइयं हि स्वामिनी प्राप्ता तस्य वित्तस्य किंकराः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001769078, "chapter_id": 21769, "verse_number": "२-३०-७९", "content_sanskrit": "तद्वाक्यात्सहसा प्रेष्यैः समानीतं धनं शुभे ।\nभर्ता समर्पयामास प्रीत्या युक्तोऽखिलं तदा ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001769079, "chapter_id": 21769, "verse_number": "२-३०-८०", "content_sanskrit": "सत्कृत्य भूषणैर्वस्त्रैख्यलीकेन चेतसा ।\nउभयोस्तत्र पश्यंत्यो राक्षसीराजकन्ययोः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001769080, "chapter_id": 21769, "verse_number": "२-३०-८१", "content_sanskrit": "पर्यंकस्थां परिष्वज्य मां चुंचुबाधरे शुभे ।\nतद्दृष्ट्वा चाद्भुतं भर्तुर्देहवित्तसमर्पणम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001769081, "chapter_id": 21769, "verse_number": "२-३०-८२", "content_sanskrit": "उल्लासकरण वाक्यं करेण कुचपीडनम् ।\nछिन्ना गौरिव खङ्गेन गताः प्राणा ममाभवन् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001769082, "chapter_id": 21769, "verse_number": "२-३०-८३", "content_sanskrit": "ततोऽहं यमनिर्द्दिष्टां प्राप्ता नरकयातनाम् ।\nतामतीत्य सुदुःखार्ता काष्ठीला चाभवं शुभे ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001769083, "chapter_id": 21769, "verse_number": "२-३०-८४", "content_sanskrit": "यास्यामि पुनरेवाहं तिर्यग्योनिं सहस्रशः ।\nया भर्तुर्नापयेद्वित्तं जीवितं च शुभानने ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001769084, "chapter_id": 21769, "verse_number": "२-३०-८५", "content_sanskrit": "सापीदृशीमवस्था वै यास्यत्येव न संशयः ।\nएवं ज्ञात्वानिशं रक्षेत्पत्युर्वित्तं च जीवितम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001769085, "chapter_id": 21769, "verse_number": "२-३०-८६", "content_sanskrit": "पतिर्माता पिता वित्तं जीवितं च गुरुर्गतिः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001769086, "chapter_id": 21769, "verse_number": "२-३०-८७", "content_sanskrit": "प्रयाति नारी बहुभिः सुपुण्यैः सहैव भर्त्रा स्वशरीरदाहात् ।\nविष्णोः पदं वित्तशरीरलुब्धा प्रयाति यामीं च कुयोनिपीडाम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}]