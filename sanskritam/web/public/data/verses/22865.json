[{"id": 7002865000, "chapter_id": 22865, "verse_number": "९-१५०-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nयुष्मद्वाक्यामृतमिदं ह्यहं शृण्वञ्जनार्दन ।\nन तृप्तिमधिगच्छामि जातं कौतूहलं हि मे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002865001, "chapter_id": 22865, "verse_number": "९-१५०-२", "content_sanskrit": "गोपतिः किल गोविन्दस्त्रिषु लोकेषु विश्रुतः ।\nगोवृषस्य प्रदानेन त्रैलोक्यमभिनंदति ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002865002, "chapter_id": 22865, "verse_number": "९-१५०-३", "content_sanskrit": "तस्माद्गोवृषकल्पस्य विधानं कथयाच्युत ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002865003, "chapter_id": 22865, "verse_number": "९-१५०-४", "content_sanskrit": "श्रीकृष्ण उवाच ।\nवृषदानफलं पुण्यं शृणुष्व कथयामि ते ।\nपवित्रं पावनं चैव सर्वदानोत्तमं तथा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002865004, "chapter_id": 22865, "verse_number": "९-१५०-५", "content_sanskrit": "दशधेनुसमोऽनड्वानेकश्चैव धुरंधरः ।\nदशधेनुप्रदानाद्धि स एवैको विशिष्यते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002865005, "chapter_id": 22865, "verse_number": "९-१५०-६", "content_sanskrit": "वोढा च चारुपृष्ठांगो ह्यरोगः पांडुनंदन ।\nयुवा भद्रः सुशी लश्च सर्वदोषविवर्जितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002865006, "chapter_id": 22865, "verse_number": "९-१५०-७", "content_sanskrit": "धुरंधरः स्थापयते एक एव कुलं महत् ।\nत्राता भवति संसारान्नात्र कार्या विचारणा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002865007, "chapter_id": 22865, "verse_number": "९-१५०-८", "content_sanskrit": "अलंकृत्य वृषं शांतं पुण्येह्नि समुपस्थिते ।\nरौप्यलाड्गूलसंयुक्तं ब्राह्मणाय निवेदयेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002865008, "chapter_id": 22865, "verse_number": "९-१५०-९", "content_sanskrit": "मंत्रेणानेन राजेन्द्र तं शृणुष्व वदामि ते ।\nधर्मस्त्वं वृषरूपेण जग दानंदकारक ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002865009, "chapter_id": 22865, "verse_number": "९-१५०-१०", "content_sanskrit": "अष्टमूर्तेरधिष्ठानमतः पाहि सनातन ।\nदत्वैवं दक्षिणायुक्तं प्रणिपत्य विसर्जयेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002865010, "chapter_id": 22865, "verse_number": "९-१५०-११", "content_sanskrit": "सप्तजन्मकृतं पापं वाङ्मनः कायकर्मजम् ।\nतत्सर्वं विलयं याति गोदानसुकृतेन च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002865011, "chapter_id": 22865, "verse_number": "९-१५०-१२", "content_sanskrit": "यानं वृषभसंयुक्तं दीप्यमानं सुशोभितम् ।\nआरुह्य कामगं दिव्यं स्वर्लोकमधिरोहति ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002865012, "chapter_id": 22865, "verse_number": "९-१५०-१३", "content_sanskrit": "यावंति तस्य रोमाणि गोवृषस्य महीपते ।\nतावद्वर्षसहस्राणि गवां लोके महीयते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002865013, "chapter_id": 22865, "verse_number": "९-१५०-१४", "content_sanskrit": "गोलोकादवतीर्णस्तु इहलोके द्विजोत्तमः ।\nयज्ञयाजी महातेजाः सर्वब्राह्मणपूजितः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002865014, "chapter_id": 22865, "verse_number": "९-१५०-१५", "content_sanskrit": "तवोक्तं वै महाराज कस्य देयो वृषोत्तमः ।\nतदप्यहं ते वक्ष्यामि पात्रं त्राणप्रदं नृणाम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002865015, "chapter_id": 22865, "verse_number": "९-१५०-१६", "content_sanskrit": "येषां सदा वै श्रुतिपूर्णकर्णा जितेन्द्रियाः प्राणिवधे निवृत्ताः ।\nप्रतिग्रहे संकुचिता गृहस्थास्ते ब्राह्मणास्तारयितुं समर्थाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002865016, "chapter_id": 22865, "verse_number": "९-१५०-१७", "content_sanskrit": "गात्रे दृढं भारसहं सुपुष्टं सुशृङ्गिणं सर्वगुणोपपन्नम् ।\nदत्त्वर्षभं गोदशकेन तुल्यं सत्यं भवंति भुवि तत्फलभागिनस्ते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]