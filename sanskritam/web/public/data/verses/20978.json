[{"id": 7000978000, "chapter_id": 20978, "verse_number": "३-२-१", "content_sanskrit": "मैत्रेय उवाच ।\nप्रोक्तान्येतानि भवता सप्त मन्वन्तराणि वै ।\nभविष्याण्यपि विप्रर्ष ममाख्यातुं त्वमर्हसि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000978001, "chapter_id": 20978, "verse_number": "३-२-२", "content_sanskrit": "श्रीपराशर उवाच ।\nसूर्यस्य पत्नी संज्ञाभूत्तनया विश्वकर्मणः ।\nमनुर्यमो यमी चैव तदपत्यानि वै मुने ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000978002, "chapter_id": 20978, "verse_number": "३-२-३", "content_sanskrit": "असहन्ती तु सा भर्तुस्तेजश्छायां युयोज वै ।\nभर्तृशुश्रूषणेऽरण्यंस्वयं च तपसे ययौ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000978003, "chapter_id": 20978, "verse_number": "३-२-४", "content_sanskrit": "संज्ञेयमित्यथार्कश्च छायायामात्मजत्रयम् ।\nशनैश्चरं मनुं चान्यं तपतीं चाप्यजाजनत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000978004, "chapter_id": 20978, "verse_number": "३-२-५", "content_sanskrit": "छायासंज्ञा ददौ शापं यमाय कुपिता यदा ।\nतदान्येयमसौ बुद्धिरित्यासीद्यमसूर्ययोः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000978005, "chapter_id": 20978, "verse_number": "३-२-६", "content_sanskrit": "ततो विवस्वानाख्यातां तयैवारण्यसंस्थिताम् ।\nसमाधिदृष्ट्याददृशे तामश्वां तपसि स्थिताम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000978006, "chapter_id": 20978, "verse_number": "३-२-७", "content_sanskrit": "वाजिरूपधरः सोथ तस्यां देवावथाश्विनौ ।\nजनयामास रेवन्तं रेतसोंते च भास्करः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000978007, "chapter_id": 20978, "verse_number": "३-२-८", "content_sanskrit": "आनिन्ये च पुनः संज्ञां स्वस्थानं भगवान् रविः ।\nतेजसः शमनं चास्य विश्वकर्मा चकार ह ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000978008, "chapter_id": 20978, "verse_number": "३-२-९", "content_sanskrit": "भ्रममारोप्य सूर्यं तु तस्य तेजोनिशातनम् ।\nकृतवानष्टमं भागं स व्यशातयदव्ययम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000978009, "chapter_id": 20978, "verse_number": "३-२-१०", "content_sanskrit": "यत्तस्माद्वैष्णवं तेजस्शातितं विश्वकर्मणा ।\nजाज्वल्यमानमपतत्तद्भूमौ मुनिसत्तम ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000978010, "chapter_id": 20978, "verse_number": "३-२-११", "content_sanskrit": "त्वष्टैव तेजसा तेन विष्णोश्चक्रमकल्पयत् ।\nत्रिशूलं चैव शर्वस्य शिबिकां धनदस्य च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000978011, "chapter_id": 20978, "verse_number": "३-२-१२", "content_sanskrit": "शक्तिं गुहस्य देवानामन्येषां च यदायुधम् ।\nतत्सर्वं तेजसा तेन विश्वकर्मा व्यवर्धयत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000978012, "chapter_id": 20978, "verse_number": "३-२-१३", "content_sanskrit": "छायासंज्ञासुतो योसौ द्वितीयः कथितो मनुः ।\nपूर्वजस्यासवर्णोसौ सावर्णिस्तेन कथ्यते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000978013, "chapter_id": 20978, "verse_number": "३-२-१४", "content_sanskrit": "तस्य मन्वन्तरं ह्योतत्सावर्णिकमथाष्टमम् ।\nतच्छृणुष्व महाभाग भविष्यत्कथयामि ते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000978014, "chapter_id": 20978, "verse_number": "३-२-१५", "content_sanskrit": "सावर्णिस्तु मनुर्योसौ मैत्रेय भविता ततः ।\nसुतपाश्चामिताभाश्च मुख्याश्चापि तथा सुराः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000978015, "chapter_id": 20978, "verse_number": "३-२-१६", "content_sanskrit": "तेषां गणाश्च देवानामेकैको विंशकः स्मृतः ।\nसप्तर्षिनपि वक्ष्यामि भविष्यान्मुनिसत्तम ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000978016, "chapter_id": 20978, "verse_number": "३-२-१७", "content_sanskrit": "दीप्तिमान् गालवो रामः कृपो द्रोणिस्तथा परः ।\nमत्पुत्रश्च तथा व्यास ऋष्यशृङ्गश्च सप्तमः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000978017, "chapter_id": 20978, "verse_number": "३-२-१८", "content_sanskrit": "विष्णु प्रसादादनघः पातालान्तरगोचरः ।\nविरोचनसुतस्तेषां बलिरिन्द्रो भविष्यति ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000978018, "chapter_id": 20978, "verse_number": "३-२-१९", "content_sanskrit": "विरजाश्चोर्वरीवांश्च निर्मोकाद्यास्तथापरे ।\nसावर्णेस्तु मनोः पुत्रा भविष्यन्ति नरेश्वराः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000978019, "chapter_id": 20978, "verse_number": "३-२-२०", "content_sanskrit": "नवमो दक्षसावर्णिर्भविष्यति मुने मनुः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000978020, "chapter_id": 20978, "verse_number": "३-२-२१", "content_sanskrit": "पारा मरीचिगर्भाश्च सुधर्माणस्तथा त्रिधा ।\nभविष्यन्ति तथा देवा ह्योकैको द्वादशो गणः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000978021, "chapter_id": 20978, "verse_number": "३-२-२२", "content_sanskrit": "तेषामिद्रो महावीर्यो भविष्यत्यद्भुतो द्विज ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000978022, "chapter_id": 20978, "verse_number": "३-२-२३", "content_sanskrit": "सवनो द्युतिमान् भव्यो वसुर्मेधातिथिस्तथा ।\nज्योतिष्मान् सप्तमः सत्यस्तत्रैते च महर्षयः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000978023, "chapter_id": 20978, "verse_number": "३-२-२४", "content_sanskrit": "धृतकेतुर्दीप्तिकेतुः पञ्चहस्तनिरामयौ ।\nपृथुश्रवाद्याश्च तथा दक्षमावर्णिकात्मजाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000978024, "chapter_id": 20978, "verse_number": "३-२-२५", "content_sanskrit": "दसमो ब्रह्मसावर्मिर्भविष्यति मुने मनुः ।\nसूधामानो विशुद्धाश्च शतसंख्यास्तथा सुराः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000978025, "chapter_id": 20978, "verse_number": "३-२-२६", "content_sanskrit": "तेषामिन्द्रश्च भविता शान्तिर्नाम महाबलः ।\nसप्तर्षयो भविष्यन्ति ये तथा ताञ्छृणुष्व ह ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000978026, "chapter_id": 20978, "verse_number": "३-२-२७", "content_sanskrit": "हविष्मान्सुकृतःसत्यस्तपोमूर्तिस्तथापरः ।\nनाभागोऽप्रतिमौजाश्चसत्यकेतुस्तथैव च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000978027, "chapter_id": 20978, "verse_number": "३-२-२८", "content_sanskrit": "सुक्षेत्रश्चोत्तमौजाश्चभूरिषेणादयो दश ।\nब्रह्मसावर्णिपुत्रास्तु रक्षिष्यन्ति वसुंधराम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000978028, "chapter_id": 20978, "verse_number": "३-२-२९", "content_sanskrit": "एकादशश्च भविता धर्मसावर्णिको मनुः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000978029, "chapter_id": 20978, "verse_number": "३-२-३०", "content_sanskrit": "विहङ्गमाः कामागमा निर्वाणा ऋषयस्तथा ।\nगणास्त्वेते तदा मुख्या देवानां च भविष्यताम् ।\nऐकैकस्त्रिंशकस्तेषां गणश्चेन्द्रश्च वै पृषा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000978030, "chapter_id": 20978, "verse_number": "३-२-३१", "content_sanskrit": "निः स्वरश्चाग्नितेजाश्च वपुष्मान्घणिरारुणिः ।\nहविष्माननघश्चैव भाव्याः सप्तर्षयस्तथा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000978031, "chapter_id": 20978, "verse_number": "३-२-३२", "content_sanskrit": "सर्वत्रगस्शुधर्मा च देवानीकादयस्तथा ।\nभविष्यन्ति मनोस्तस्य तनयाः पृतिविश्वराः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000978032, "chapter_id": 20978, "verse_number": "३-२-३३", "content_sanskrit": "रुद्रपुत्रस्तु सावर्णिर्भविता द्वादशो मनुः ।\nऋतुधामा च तत्रेन्द्रो भविता शृणु मे सुरान् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000978033, "chapter_id": 20978, "verse_number": "३-२-३४", "content_sanskrit": "हरिता रोहिता देवास्तथा सुमनसो द्विज ।\nसुकर्माणः सुरापाश्च दशकाः पञ्च वै गणाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000978034, "chapter_id": 20978, "verse_number": "३-२-३५", "content_sanskrit": "तपस्वी सुतपाश्चैव तपोमूर्तिस्तपोरतिः ।\nतपोधृतिर्द्युतिश्चान्यः सप्तमस्तु तपोधनः ।\nसप्तर्षयस्त्विमे तस्य पुत्रानपि निबोध मे ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000978035, "chapter_id": 20978, "verse_number": "३-२-३६", "content_sanskrit": "देववानुपदेवश्च देवश्रेष्ठादयस्तथा ।\nमनोस्तस्य महावीर्या भविष्यन्ति महानृपाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000978036, "chapter_id": 20978, "verse_number": "३-२-३७", "content_sanskrit": "त्रयोदशो रुचिर्नामा भविष्यति मुने मनुः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000978037, "chapter_id": 20978, "verse_number": "३-२-३८", "content_sanskrit": "सुत्रामाणः सुकर्माणः सुधर्माणस्तथामराः ।\nत्रयस्त्रिंशद्विभेदास्त देवानां यत्र वै गणाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000978038, "chapter_id": 20978, "verse_number": "३-२-३९", "content_sanskrit": "दिवस्पतिर्महावीर्यस्तेषामिन्द्रोभिविष्यति ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000978039, "chapter_id": 20978, "verse_number": "३-२-४०", "content_sanskrit": "निर्मोहस्तत्त्वदर्शि च निष्प्रकंप्यो निरुत्सुकः ।\nधृतिमानव्ययश्चान्यःसप्तमःसुतपा मुनिः ।\nसप्तर्षयस्त्वमी तस्य पुत्रानपि निबोधे मे ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000978040, "chapter_id": 20978, "verse_number": "३-२-४१", "content_sanskrit": "चित्रसेनविचित्राद्या भविष्यन्ति महीक्षिकः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000978041, "chapter_id": 20978, "verse_number": "३-२-४२", "content_sanskrit": "भौमश्चतुर्दशश्चात्र मैत्रेय भविता मनः ।\nशुचिरिन्द्रः सुरगणस्तत्र पञ्च शृणुष्व तान् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000978042, "chapter_id": 20978, "verse_number": "३-२-४३", "content_sanskrit": "चाक्षुषाश्च पवित्राश्च कनिष्ठा भ्राजिकास्तथा ।\nवाचवृद्धश्च वै देवाःसप्तर्षीनपि मे शृणु ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000978043, "chapter_id": 20978, "verse_number": "३-२-४४", "content_sanskrit": "अग्निबाहुः शुचिः शुक्रो मागधोग्नीध्र एव च ।\nयुक्तस्तथा जितश्चान्यो मनुपुत्रानतः शृणु ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000978044, "chapter_id": 20978, "verse_number": "३-२-४५", "content_sanskrit": "ऊरुगंभीरबुद्ध्याद्या मनोस्तस्य सुता नृपाः ।\nकथिता मुनिशार्दुल पालयिष्यन्ति ये महीम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000978045, "chapter_id": 20978, "verse_number": "३-२-४६", "content_sanskrit": "चतुर्युगान्ते वेदानां जायते किल विप्लवः ।\nप्रवर्तयन्ति तानेत्य भुवं सप्तर्षयो दिवः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000978046, "chapter_id": 20978, "verse_number": "३-२-४७", "content_sanskrit": "कृतेकृते स्मृतेर्विप्र प्रणेता जायते मनुः ।\nदेवा यज्ञभुजस्ते तु यावन्मन्वन्तरं तु तत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000978047, "chapter_id": 20978, "verse_number": "३-२-४८", "content_sanskrit": "भवन्ति ये मनोः पुत्रा यावन्मन्वंरतं तु तैः ।\nतदन्वयोद्भवैश्चैव तावद्भूः परीपाल्यते ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000978048, "chapter_id": 20978, "verse_number": "३-२-४९", "content_sanskrit": "मनुःसप्तर्षयो देवा भूपालाश्च मनोः सुताः ।\nमन्वन्तरे भवन्त्येते शक्रश्चैवाधिकारिमः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000978049, "chapter_id": 20978, "verse_number": "३-२-५०", "content_sanskrit": "चतुर्दशभिरेतैस्तु गतैर्मन्वन्तरैर्द्विज ।\nसहस्रयुगपर्यतः कल्पो निःशेष उच्यते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000978050, "chapter_id": 20978, "verse_number": "३-२-५१", "content_sanskrit": "तावत्प्रमाणा च निशा ततो भवति सत्तम ।\nब्रह्मरूपधरः शेते शेषाहावंबुसंप्लवे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000978051, "chapter_id": 20978, "verse_number": "३-२-५२", "content_sanskrit": "त्रैलोक्यमखिलं ग्रस्त्वा भगवानादिकृद्विभुः ।\nस्वमायासंस्तितो विप्र सर्वभूतो जनार्दनः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000978052, "chapter_id": 20978, "verse_number": "३-२-५३", "content_sanskrit": "ततः प्रबुद्धो भगवान् यथा पूर्वं तथा पुनः ।\nसृष्टिं करोत्यव्ययात्मा कल्पेकल्पे रजोगुमः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000978053, "chapter_id": 20978, "verse_number": "३-२-५४", "content_sanskrit": "मनवो भूभुजःसेंद्रा देवाःसप्तर्षयस्तथा ।\nसात्त्विकोंशः स्थितिकरो जगतो द्विजसत्तम ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000978054, "chapter_id": 20978, "verse_number": "३-२-५५", "content_sanskrit": "चदुर्युगोप्यसौ विष्णुः स्थितिव्यापारलक्षमः ।\nयुगव्यवस्थां कुरुते तथा मैत्रेय तच्छृणु ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000978055, "chapter_id": 20978, "verse_number": "३-२-५६", "content_sanskrit": "कृते युगे परं ज्ञानं कपिलादिस्वरूपधृक् ।\nददाति सर्वभूतात्मा सर्वभूतहिते रतः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000978056, "chapter_id": 20978, "verse_number": "३-२-५७", "content_sanskrit": "चक्रवर्तिस्वरूपेण त्रेतायामपि स प्रभूः ।\nदुष्टानां निग्रह कुर्वन्परिपाति जगत्त्रयम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000978057, "chapter_id": 20978, "verse_number": "३-२-५८", "content_sanskrit": "वेदमेकं चतुर्भेदं कृत्वा शाखाशतैर्विभुः ।\nकरोति बहुलं भूयो वेदव्यासस्वरूपधृक् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000978058, "chapter_id": 20978, "verse_number": "३-२-५९", "content_sanskrit": "वेदांस्तु द्वापरे व्यस्य कलेरन्ते पुनर्हरिः ।\nकल्किस्वरूपी दुर्वृत्तन्मार्गे स्थापयति प्रभुः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000978059, "chapter_id": 20978, "verse_number": "३-२-६०", "content_sanskrit": "एवमेतज्जगत्सर्वं शश्वत्पाति करोति च ।\nहन्ति चान्तेष्वनन्तात्मा नास्त्यस्मव्द्यतिरेकि यत् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000978060, "chapter_id": 20978, "verse_number": "३-२-६१", "content_sanskrit": "भूतं भव्यं भविष्यं च सर्वभूतान्महात्मनः ।\nतदत्रान्यत्र वा विप्र सद्भावः कथितस्तव ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000978061, "chapter_id": 20978, "verse_number": "३-२-६२", "content_sanskrit": "मन्वन्तराण्यशेषाणि कथितानि मया तवा ।\nमन्वन्तराधिपांश्चैव किमन्यत्कथयामि ते ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]