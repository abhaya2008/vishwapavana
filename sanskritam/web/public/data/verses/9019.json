[{"id": 40007751, "chapter_id": 9019, "verse_number": "1", "content_sanskrit": "आज्ञप्तो राजवद्वाक्यं प्रतिकूलं निशाचरः। अब्रवीत्परुषं वाक्यं मारीचो राक्षसाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40007752, "chapter_id": 9019, "verse_number": "2", "content_sanskrit": "केनायमुपदिष्टस्ते विनाशः पापकर्मणा। सपुत्रस्य सराष्ट्रस्य सामात्यस्य निशाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40007753, "chapter_id": 9019, "verse_number": "3", "content_sanskrit": "कस्त्वया सुखिना राजन्नाभिनन्दति पापकृत्। केनेदमुपदिष्टं ते मृत्युद्वारमुपायतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40007754, "chapter_id": 9019, "verse_number": "4", "content_sanskrit": "शत्रवस्तव सुव्यक्तं हीनवीर्या निशाचराः। इच्छन्ति त्वां विनश्यन्तमुपरुद्धं बलीयसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40007755, "chapter_id": 9019, "verse_number": "5", "content_sanskrit": "केनेदमुपदिष्टं ते क्षुद्रेणाहितवादिना। यस्त्वामिच्छति नश्यन्तं स्वकृतेन निशाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40007756, "chapter_id": 9019, "verse_number": "6", "content_sanskrit": "वध्याः खलु न हन्यन्ते सचिवास्तव रावण। ये त्वामुत्पथमारूढं न निगृह्णन्ति सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40007757, "chapter_id": 9019, "verse_number": "7", "content_sanskrit": "अमात्यैः कामवृत्तो हि राजा कापथमाश्रितः। निग्राह्यस्सर्वथा सदभिर्न निग्राह्यो निगृह्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40007758, "chapter_id": 9019, "verse_number": "8", "content_sanskrit": "धर्ममर्थं च कामं च यशश्च जयतां वर। स्वामिप्रसादात्सचिवाः प्राप्नुवन्ति निशाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40007759, "chapter_id": 9019, "verse_number": "9", "content_sanskrit": "विपर्यये तु तत्सर्वं व्यर्थं भवति रावण। व्यसनं स्वामिवैगुण्यात्प्राप्नुवन्तीतरे जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40007760, "chapter_id": 9019, "verse_number": "10", "content_sanskrit": "राजमूलो हि धर्मश्च जयश्च जयतां वर। तस्मात्सर्वास्ववस्थासु रक्षितव्या नराधिपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40007761, "chapter_id": 9019, "verse_number": "11", "content_sanskrit": "राज्यं पालयितुं शक्यं न तीक्ष्णेन निशाचर। न चापि प्रतिकूलेन नाविनीतेन राक्षस ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40007762, "chapter_id": 9019, "verse_number": "12", "content_sanskrit": "ये तीक्ष्णमन्त्रास्सचिवा भज्यन्ते सह तेन वै। विषमे तुरगा श्शीघ्रा मन्दसारथयो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40007763, "chapter_id": 9019, "verse_number": "13", "content_sanskrit": "बहवस्साधवो लोके युक्ता धर्ममनुष्ठिताः। परेषामपराधेन विनष्टास्सपरिच्छदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40007764, "chapter_id": 9019, "verse_number": "14", "content_sanskrit": "स्वामिना प्रतिकूलेन प्रजास्तीक्ष्णेन रावण। रक्ष्यमाणा न वर्धन्ते मेषा गोमायुना यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40007765, "chapter_id": 9019, "verse_number": "15", "content_sanskrit": "अवश्यं विनशिष्यन्ति सर्वे रावण राक्षसाः। येषां त्वं कर्कशो राजा दुर्बुद्धिरजितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40007766, "chapter_id": 9019, "verse_number": "16", "content_sanskrit": "तदिदं काकतालीयं घोरमासादितं मया। अत्र किं शोचनीयस्त्वं ससैन्यो विनशिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40007767, "chapter_id": 9019, "verse_number": "17", "content_sanskrit": "मां निहत्य तु रामश्च न चिरात्त्वां वधिष्यति। अनेन कृतकृत्योऽस्मि म्रियेयमरिणा हतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40007768, "chapter_id": 9019, "verse_number": "18", "content_sanskrit": "दर्शनादेव रामस्य हतं मामवधारय। आत्मानं च हतं विद्धि हृत्वा सीतां सबान्धवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40007769, "chapter_id": 9019, "verse_number": "19", "content_sanskrit": "आनयिष्यसि चेत्सीतामाश्रमात्सहितो मया। नैवत्वमसि नाहं च नैव लङ्का न राक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40007770, "chapter_id": 9019, "verse_number": "20", "content_sanskrit": "निवार्यमाणस्तु मया हितैषिणा न मृष्यसे वाक्यमिदं निशाचर। परेतकल्पा हि गतायुषो नरा हितं न गृह्णन्ति सुहृद्भिरीरितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]