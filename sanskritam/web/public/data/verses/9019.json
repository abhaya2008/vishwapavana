[{"id": 5000019000, "chapter_id": 9019, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे एकोनविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000019001, "chapter_id": 9019, "verse_number": "१-१९-१", "content_sanskrit": "तच्छ्रुत्वा राजसिंहस्य वाक्यमद्भुतविस्तरम् ।\nहृष्टरोमा महातेजा विश्वामित्रोऽभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000019002, "chapter_id": 9019, "verse_number": "१-१९-२", "content_sanskrit": "सदृशं राजशार्दूल तवैवं भुवि नान्यतः ।\nमहावंशप्रसूतस्य वसिष्ठव्यपदेशिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000019003, "chapter_id": 9019, "verse_number": "१-१९-३", "content_sanskrit": "यत्तु मे हृद्गतं वाक्यं तस्य कार्यस्य निश्चयम् ।\nकुरुष्व राजशार्दूल भव सत्यप्रतिश्रवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000019004, "chapter_id": 9019, "verse_number": "१-१९-४", "content_sanskrit": "अहं नियममातिष्ठे सिद्ध्यर्थं पुरुषर्षभ ।\nतस्य विघ्नकरौ द्वौ तु राक्षसौ कामरूपिणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000019005, "chapter_id": 9019, "verse_number": "१-१९-५", "content_sanskrit": "व्रते तु बहुशश्चीर्णे समाप्त्यां राक्षसाविमौ ।\nमारीचश्च सुबाहुश्च वीर्यवन्तौ सुशिक्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000019006, "chapter_id": 9019, "verse_number": "१-१९-६", "content_sanskrit": "तौ मांसरुधिरौघेण वेदिं तामभ्यवर्षताम् ।\nअवधूते तथाभूते तस्मिन् नियमनिश्चये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000019007, "chapter_id": 9019, "verse_number": "१-१९-७", "content_sanskrit": "कृतश्रमो निरुत्साहस्तस्माद् देशादपाक्रमे ।\nन च मे क्रोधमुत्स्रष्टुं बुद्धिर्भवति पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000019008, "chapter_id": 9019, "verse_number": "१-१९-८", "content_sanskrit": "तथाभूता हि सा चर्या न शापस्तत्र मुच्यते ।\nस्वपुत्रं राजशार्दूल रामं सत्यपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000019009, "chapter_id": 9019, "verse_number": "१-१९-९", "content_sanskrit": "काकपक्षधरं शूरं ज्येष्ठं मे दातुमर्हसि ।\nशक्तो ह्येष मया गुप्तो दिव्येन स्वेन तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000019010, "chapter_id": 9019, "verse_number": "१-१९-१०", "content_sanskrit": "राक्षसा ये विकर्तारस्तेषामपि विनाशने ।\nश्रेयश्चास्मै प्रदास्यामि बहुरूपं न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000019011, "chapter_id": 9019, "verse_number": "१-१९-११", "content_sanskrit": "त्रयाणामपि लोकानां येन ख्यातिं गमिष्यति ।\nन च तौ राममासाद्य शक्तौ स्थातुं कथञ्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000019012, "chapter_id": 9019, "verse_number": "१-१९-१२", "content_sanskrit": "न च तौ राघवादन्यो हन्तुमुत्सहते पुमान् ।\nवीर्योत्सिक्तौ हि तौ पापौ कालपाशवशं गतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000019013, "chapter_id": 9019, "verse_number": "१-१९-१३", "content_sanskrit": "रामस्य राजशार्दूल न पर्याप्तौ महात्मनः ।\nन च पुत्रगतं स्नेहं कर्तुमर्हसि पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000019014, "chapter_id": 9019, "verse_number": "१-१९-१४", "content_sanskrit": "अहं ते प्रतिजानामि हतौ तौ विद्धि राक्षसौ ।\nअहं वेद्मि महात्मानं रामं सत्यपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000019015, "chapter_id": 9019, "verse_number": "१-१९-१५", "content_sanskrit": "वसिष्ठोऽपि महातेजा ये चेमे तपसि स्थिताः ।\nयदि ते धर्मलाभं च यशश्च परमं भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000019016, "chapter_id": 9019, "verse_number": "१-१९-१६", "content_sanskrit": "स्थिरमिच्छसि राजेन्द्र रामं मे दातुमर्हसि ।\nयद्यभ्यनुज्ञां काकुत्स्थ ददते तव मन्त्रिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000019017, "chapter_id": 9019, "verse_number": "१-१९-१७", "content_sanskrit": "वसिष्ठप्रमुखाः सर्वे ततो रामं विसर्जय ।\nअभिप्रेतमसंसक्तमात्मजं दातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000019018, "chapter_id": 9019, "verse_number": "१-१९-१८", "content_sanskrit": "दशरात्रं हि यज्ञस्य रामं राजीवलोचनम् ।\nनात्येति कालो यज्ञस्य यथायं मम राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000019019, "chapter_id": 9019, "verse_number": "१-१९-१९", "content_sanskrit": "तथा कुरुष्व भद्रं ते मा च शोके मनः कृथाः ।\nइत्येवमुक्त्वा धर्मात्मा धर्मार्थसहितं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000019020, "chapter_id": 9019, "verse_number": "१-१९-२०", "content_sanskrit": "विरराम महातेजा विश्वामित्रो महामतिः ।\nस तन्निशम्य राजेन्द्रो विश्वामित्रवचः शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000019021, "chapter_id": 9019, "verse_number": "१-१९-२१", "content_sanskrit": "शोकेन महताविष्टश्चचाल च मुमोह च ।\nलब्धसंज्ञस्तदोत्थाय व्यषीदत भयान्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000019022, "chapter_id": 9019, "verse_number": "१-१९-२२", "content_sanskrit": "इति हृदयमनोविदारणं\n:::मुनिवचनं तदतीव शुश्रुवान् ।\nनरपतिरभवन्महान् महात्मा\n:::व्यथितमनाः प्रचचाल चासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000019023, "chapter_id": 9019, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे एकोनविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]