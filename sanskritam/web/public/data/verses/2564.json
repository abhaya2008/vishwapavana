[{"id": 2074113, "chapter_id": 2564, "verse_number": "१२-६९-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2074114, "chapter_id": 2564, "verse_number": "१२-६९-१", "content_sanskrit": "दण़्डनीतिश्च राजा च समस्तौ तावुभावपि।\nतत्र किं कुर्वतः सिद्धिस्तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2074115, "chapter_id": 2564, "verse_number": "१२-६९-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2074116, "chapter_id": 2564, "verse_number": "१२-६९-२", "content_sanskrit": "माहात्म्यं दण्डनीत्यास्तु साध्यं शब्दैः सहेतुकैः।\nशृणु मे शंसतो राजन्यथावदिह भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2074117, "chapter_id": 2564, "verse_number": "१२-६९-३", "content_sanskrit": "दण्डनीतिः स्वधर्मेषु चातुर्वर्ण्यं नियच्छति।\nप्रयुक्ता स्वामिना सम्यगधर्मेभ्यो नियच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2074118, "chapter_id": 2564, "verse_number": "१२-६९-४", "content_sanskrit": "चातुर्वर्ण्ये स्वधर्मस्थे मर्यादानामसंकरे।\nदण़्डनीतिकृते क्षेमे प्रजानामकुतोभये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2074119, "chapter_id": 2564, "verse_number": "१२-६९-५", "content_sanskrit": "सोमे प्रयत्नं कुर्वन्ति वयो वर्णा यथाविधि।\nतस्मादेव मनुष्याणां सुखं विद्धि समाहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2074120, "chapter_id": 2564, "verse_number": "१२-६९-६", "content_sanskrit": "कालो वा कारणं राज्ञो राजा वा कालकारणम्।\nइति ते संशयो माभूद्राजा कालस्य कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2074121, "chapter_id": 2564, "verse_number": "१२-६९-७", "content_sanskrit": "दण्डनीत्यां यदा राजा सम्यक्कार्त्स्न्येन वर्तते।\nतदा कृतयुगं नाम कालः श्रेष्ठः प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2074122, "chapter_id": 2564, "verse_number": "१२-६९-८", "content_sanskrit": "भवेत्कृतयुगे धर्मो नाधर्मो विद्यते क्वचित्।\nसर्वेषामेव वर्णानां नाधर्मे रमते मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2074123, "chapter_id": 2564, "verse_number": "१२-६९-९", "content_sanskrit": "योगक्षेमाः प्रवर्तन्ते प्रजानां नात्र संशयः।\nवैदिकानि च कर्माणि भवन्त्यपि गुणान्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2074124, "chapter_id": 2564, "verse_number": "१२-६९-१०", "content_sanskrit": "ऋतवश्च सुखाः सर्वे भवन्त्युत निरामयाः।\nप्रसीदन्ति नराणां च स्वरवर्णमनांसि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2074125, "chapter_id": 2564, "verse_number": "१२-६९-११", "content_sanskrit": "व्याधयो न भवन्त्यत्र नाल्पायुर्दृश्यते नरः।\nविधवा न भवन्त्यत्र नृशंसो नात्र जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2074126, "chapter_id": 2564, "verse_number": "१२-६९-१२", "content_sanskrit": "अकृष्टपच्या पृथिवी भवन्त्योषधयस्तथा।\nत्वक्पत्रफलमूलानि वीर्यवन्ति भवन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2074127, "chapter_id": 2564, "verse_number": "१२-६९-१३", "content_sanskrit": "नाधर्मो विद्यते तत्र धर्म एव तु केवलम्।\nइति कार्तयुगानेतान्गुणान्विद्धि युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2074128, "chapter_id": 2564, "verse_number": "१२-६९-१४", "content_sanskrit": "दण्डनीत्या यदा राजा त्रीनंशाननुवर्तते।\nचतुर्थमंशमुत्सृज्य तदा त्रेता प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2074129, "chapter_id": 2564, "verse_number": "१२-६९-१५", "content_sanskrit": "अधर्मस्य चतुर्थांशस्त्रीनंशाननुवर्तते।\nकृष्टपच्यैव पृथिवी भवन्त्योषधयस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2074130, "chapter_id": 2564, "verse_number": "१२-६९-१६", "content_sanskrit": "अर्धं त्यक्त्वा यदा राजा नीत्यर्धमनुवर्तते।\nततस्तु द्वापरं नाम स कालः संप्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2074131, "chapter_id": 2564, "verse_number": "१२-६९-१७", "content_sanskrit": "अशुभस्य यदा त्वर्धं द्वावंशावनुवर्तते।\nकुष्टपच्यैव पृथिवी भवत्यर्धफला तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2074132, "chapter_id": 2564, "verse_number": "१२-६९-१८", "content_sanskrit": "दण्डनीतिं परित्यज्य यदा कार्त्स्न्येन भूमिपः।\nप्रजाः क्लिश्नात्ययोगेन प्रवर्तेत तदा कलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2074133, "chapter_id": 2564, "verse_number": "१२-६९-१९", "content_sanskrit": "कलावधर्मो भूयिष्ठो धर्मो भवति न क्वचित्।\nसर्वेषामेव वर्णानां स्वधर्माच्च्यवते मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2074134, "chapter_id": 2564, "verse_number": "१२-६९-२०", "content_sanskrit": "शूद्रा भैक्षेण जीवन्ति ब्राह्मणाः परिचर्यया।\nयोगक्षेमस्य नाशश्च वर्तते वर्णसंकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2074135, "chapter_id": 2564, "verse_number": "१२-६९-२१", "content_sanskrit": "वैदिकानि च कर्माणि भवन्ति विगुणान्युत।\nऋतवो न सुखाः सर्वे भवन्त्यामयिनस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2074136, "chapter_id": 2564, "verse_number": "१२-६९-२२", "content_sanskrit": "ह्रसन्त च मनुष्याणां स्वरवर्णमनांस्युत।\nव्याधयश्च भवन्त्यत्र म्रियन्ते चाशतायुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2074137, "chapter_id": 2564, "verse_number": "१२-६९-२३", "content_sanskrit": "विधवाश्च भवन्त्यत्र नृशंसा जायते प्रजा।\nक्वचिद्वर्षति पर्जन्यः क्वचित्सस्यं प्ररोहति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2074138, "chapter_id": 2564, "verse_number": "१२-६९-२४", "content_sanskrit": "रसाः सर्वे क्षयं यान्ति यदा नेच्छति भूमिपः।\nप्रजाः संरक्षितुं सम्यग्दण़्डनीतिसमाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2074139, "chapter_id": 2564, "verse_number": "१२-६९-२५", "content_sanskrit": "राजा कृतयुगस्रष्टा त्रेताया द्वापरस्य च।\nयुगस्य च चतुर्थस्य राजा भवति कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2074140, "chapter_id": 2564, "verse_number": "१२-६९-२६", "content_sanskrit": "कृतस्य करणाद्राजा स्वर्गमत्यन्तमश्नुते।\nत्रेतायाः करणाद्राजा स्वर्गं नात्यन्तमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2074141, "chapter_id": 2564, "verse_number": "१२-६९-२७", "content_sanskrit": "प्रवर्तनाद्द्वापरस्य यथाभागमुपाश्नुते।\nकलेः प्रवर्तनाद्राजा पापमत्यन्तमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2074142, "chapter_id": 2564, "verse_number": "१२-६९-२८", "content_sanskrit": "ततो वसति दुष्कर्मा नरके शाश्वतीः समाः।\nप्रजानां कल्मषे मग्नोऽकीर्ति पापं च विन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2074143, "chapter_id": 2564, "verse_number": "१२-६९-२९", "content_sanskrit": "दण्डनीतिं पुरस्कृत्य क्षत्रियेण विजानता।\nलिप्सितव्यमलभ्यं च लब्धं रक्ष्यं च भारत।\n`योगक्षेमाः प्रवर्तन्ते प्रजानां नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2074144, "chapter_id": 2564, "verse_number": "१२-६९-३०", "content_sanskrit": "लोकस्य सीमन्तकरी मर्यादा लोकपावनी।\nसम्यङ्गीता दण्डनीतिर्यथा माता यथा पिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2074145, "chapter_id": 2564, "verse_number": "१२-६९-३१", "content_sanskrit": "यस्यां भवन्ति भूतानि तद्विद्धि भरतर्षभ।\nएष एव परो धर्मो यद्राजा दण्डनीतिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2074146, "chapter_id": 2564, "verse_number": "१२-६९-३२", "content_sanskrit": "तस्मात्कौरव्य धर्मेण प्रजाः पालय नीतिमान्।\nएवं वृत्तः प्रजा रक्षन्स्वर्गं जेतासि दुर्जयम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2074147, "chapter_id": 2564, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि एकोनसप्ततितमोऽध्यायः॥ ६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]