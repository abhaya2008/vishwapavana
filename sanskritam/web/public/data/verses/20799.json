[{"id": 7000799000, "chapter_id": 20799, "verse_number": "६-१४२-१", "content_sanskrit": "श्रीमहादेव उवाच ।\nकंबुतीर्थे नरः स्नात्वा कृत्वा वा पितृतर्पणम् ।\nअर्चयेद्देवदेवेशं नारायणमनामयम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000799001, "chapter_id": 20799, "verse_number": "६-१४२-२", "content_sanskrit": "दत्त्वा दानानि विधिवद् ब्रह्मणेभ्यो विधानतः ।\nविष्णुलोकमवाप्नोति तीर्थस्यास्य प्रभावतः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000799002, "chapter_id": 20799, "verse_number": "६-१४२-३", "content_sanskrit": "अत्र राजर्षिणा पूर्वं विश्वामित्रेण धीमता ।\nतपस्तप्तं विशेषेण प्रजाकामेन सुंदरि॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000799003, "chapter_id": 20799, "verse_number": "६-१४२-४", "content_sanskrit": "वायुभक्षो निराहारो यत्रासीदनिलाशनः ।\nविष्णुपूजापरो नित्यं विष्णुध्यानपरायणः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000799004, "chapter_id": 20799, "verse_number": "६-१४२-५", "content_sanskrit": "तपसानेन संजातः प्रजाकाममवाप्तवान् ।\nप्रजाकामो नरो यश्च कंबुतीर्थं हि गच्छति॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000799005, "chapter_id": 20799, "verse_number": "६-१४२-६", "content_sanskrit": "स प्रजां लभते नित्यं सत्यं सत्यं वरानने॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000799006, "chapter_id": 20799, "verse_number": "६-१४२-७", "content_sanskrit": "इति कंबुतीर्थमाहात्म्यम् ।\nततो गच्छेत्सुरश्रेष्ठे तीर्थं नाम कपीश्वरम् ।\nसंनिधौ रक्तसिंहस्य महापातकनाशनम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000799007, "chapter_id": 20799, "verse_number": "६-१४२-८", "content_sanskrit": "बध्यमाने पुरा सेतौ रामरावणविग्रहे ।\nगृहीत्वा पर्वतश्रेष्ठं विशेषात्कपिभिः कृतम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000799008, "chapter_id": 20799, "verse_number": "६-१४२-९", "content_sanskrit": "नाम्ना कपीश्वरादित्यं चक्रुस्तीर्थमनुत्तमम् ।\nयत्र तीर्थे नरः स्नात्वा कृत्वा वा पितृतर्पणम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000799009, "chapter_id": 20799, "verse_number": "६-१४२-१०", "content_sanskrit": "दृष्ट्वा कपीश्वरादित्यं मुच्यते ब्रह्महत्यया ।\nतत्र स्नानं प्रकर्तव्यं चैत्राष्टम्यां विशेषतः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000799010, "chapter_id": 20799, "verse_number": "६-१४२-११", "content_sanskrit": "हनुमत्प्रमुखैस्तत्र स्नातं यत्र दिनत्रयम् ।\nकपितीर्थप्रभावोऽयं भवत्यै समुदीरितः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000799011, "chapter_id": 20799, "verse_number": "६-१४२-१२", "content_sanskrit": "अस्मिंस्तीर्थे नरः स्नात्वा पूजयित्वा कपीश्वरम् ।\nरूपवान्बहुभोगश्च जायते नात्र संशयः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000799012, "chapter_id": 20799, "verse_number": "६-१४२-१३", "content_sanskrit": "बलं वांछति यो लोको धर्मं वा पुत्रमेव च ।\nसर्वं स तु लभेन्नित्यं कपितीर्थप्रभावतः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]