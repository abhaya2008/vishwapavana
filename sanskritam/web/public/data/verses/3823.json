[{"id": 2130916, "chapter_id": 3823, "verse_number": "३१५", "content_sanskrit": "ततो वैश्रवणो राजा महापद्मत्रये हते ॥३१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2130917, "chapter_id": 3823, "verse_number": "३१६", "content_sanskrit": "राक्षसानामवध्यानां सखाये मणिमत्यपि ।\nआरुरोह रथं दिव्यं योद्धुकामो वृकोदरम् ॥३१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2130918, "chapter_id": 3823, "verse_number": "३१७", "content_sanskrit": "असुरावेशतस्तस्य भीमे क्रोधो महानभूत् ।\nस आजगाम भीमेन योद्धुं वित्तपतिः स्वयम् ॥३१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2130919, "chapter_id": 3823, "verse_number": "३१८", "content_sanskrit": "तस्मिन् काले भीमसेनस्य घोषं श्रुत्वा राजाऽपृच्छदाशु स्म कृष्णाम् ।\nक्व भीम इत्येव तयोदितं च श्रुत्वा जगामाऽशु रक्षोंससंस्थः ॥३१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2130920, "chapter_id": 3823, "verse_number": "३१९", "content_sanskrit": "सभ्रातृके मुनिभिः कृष्णया च गते राजान्यत्र भीमं कुबेरः ।\nदृष्ट्वाऽसुरावेशतो धर्मजं च किञ्चिन्मुक्तः स्नेहयुक्तस्तथाऽस ॥३१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]