[{"id": 5000055000, "chapter_id": 9055, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे पञ्चपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000055001, "chapter_id": 9055, "verse_number": "१-५५-१", "content_sanskrit": "ततस्तानाकुलान् दृष्ट्वा विश्वामित्रास्त्रमोहितान्।\nवसिष्ठश्चोदयामास कामधुक् सृज योगतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000055002, "chapter_id": 9055, "verse_number": "१-५५-२", "content_sanskrit": "तस्या हुंकारतो जाताः काम्बोजा रविसंनिभाः।\nऊधसश्चाथ सम्भूता बर्बराः शस्त्रपाणयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000055003, "chapter_id": 9055, "verse_number": "१-५५-३", "content_sanskrit": "योनिदेशाच्च यवनाः शकृद्देशाच्छकाः स्मृताः।\nरोमकूपेषु म्लेच्छाश्च हारीताः सकिरातकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000055004, "chapter_id": 9055, "verse_number": "१-५५-४", "content_sanskrit": "तैस्तन्निषूदितं सर्वं विश्वामित्रस्य तत्क्षणात्।\nसपदातिगजं साश्वं सरथं रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000055005, "chapter_id": 9055, "verse_number": "१-५५-५", "content_sanskrit": "दृष्ट्वा निषूदितं सैन्यं वसिष्ठेन महात्मना।\nविश्वामित्रसुतानां तु शतं नानाविधायुधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000055006, "chapter_id": 9055, "verse_number": "१-५५-६", "content_sanskrit": "अभ्यधावत् सुसंक्रुद्धं वसिष्ठं जपतां वरम्।\nहुंकारेणैव तान् सर्वान् निर्ददाह महानृषिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000055007, "chapter_id": 9055, "verse_number": "१-५५-७", "content_sanskrit": "ते साश्वरथपादाता वसिष्ठेन महात्मना।\nभस्मीकृता मुहूर्तेन विश्वामित्रसुतास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000055008, "chapter_id": 9055, "verse_number": "१-५५-८", "content_sanskrit": "दृष्ट्वा विनाशितान् सर्वान् बलं च सुमहायशाः।\nसव्रीडं चिन्तयाविष्टो विश्वामित्रोऽभवत् तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000055009, "chapter_id": 9055, "verse_number": "१-५५-९", "content_sanskrit": "समुद्र इव निर्वेगो भग्नद्रंष्ट्र इवोरगः।\nउपरक्त इवादित्यः सद्यो निष्प्रभतां गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000055010, "chapter_id": 9055, "verse_number": "१-५५-१०", "content_sanskrit": "हतपुत्रबलो दीनो लूनपक्ष इव द्विजः।\nहतसर्वबलोत्साहो निर्वेदं समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000055011, "chapter_id": 9055, "verse_number": "१-५५-११", "content_sanskrit": "स पुत्रमेकं राज्याय पालयेति नियुज्य च।\nपृथिवीं क्षत्रधर्मेण वनमेवाभ्यपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000055012, "chapter_id": 9055, "verse_number": "१-५५-१२", "content_sanskrit": "स गत्वा हिमवत्पार्श्वे किंनरोरगसेवितम्।\nमहादेवप्रसादार्थं तपस्तेपे महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000055013, "chapter_id": 9055, "verse_number": "१-५५-१३", "content_sanskrit": "केनचित् त्वथ कालेन देवेशो वृषभध्वजः।\nदर्शयामास वरदो विश्वामित्रं महामुनिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000055014, "chapter_id": 9055, "verse_number": "१-५५-१४", "content_sanskrit": "किमर्थं तप्यसे राजन् ब्रूहि यत् ते विवक्षितम्।\nवरदोऽस्मि वरो यस्ते कांक्षितः सोऽभिधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000055015, "chapter_id": 9055, "verse_number": "१-५५-१५", "content_sanskrit": "एवमुक्तस्तु देवेन विश्वामित्रो महातपाः।\nप्रणिपत्य महादेवं विश्वामित्रोऽब्रवीदिदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000055016, "chapter_id": 9055, "verse_number": "१-५५-१६", "content_sanskrit": "यदि तुष्टो महादेव धनुर्वेदो ममानघ।\nसांगोपांगोपनिषदः सरहस्यः प्रदीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000055017, "chapter_id": 9055, "verse_number": "१-५५-१७", "content_sanskrit": "यानि देवेषु चास्त्राणि दानवेषु महर्षिषु।\nगन्धर्वयक्षरक्षःसु प्रतिभान्तु ममानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000055018, "chapter_id": 9055, "verse_number": "१-५५-१८", "content_sanskrit": "तव प्रसादाद् भवतु देवदेव ममेप्सितम्।\nएवमस्त्विति देवेशो वाक्यमुक्त्वा गतस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000055019, "chapter_id": 9055, "verse_number": "१-५५-१९", "content_sanskrit": "प्राप्य चास्त्राणि देवेशाद् विश्वामित्रो महाबलः।\nदर्पेण महता युक्तो दर्पपूर्णोऽभवत् तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000055020, "chapter_id": 9055, "verse_number": "१-५५-२०", "content_sanskrit": "विवर्धमानो वीर्येण समुद्र इव पर्वणि।\nहतं मेने तदा राम वसिष्ठमृषिसत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000055021, "chapter_id": 9055, "verse_number": "१-५५-२१", "content_sanskrit": "ततो गत्वाऽऽश्रमपदं मुमोचास्त्राणि पार्थिवः।\nयैस्तत् तपोवनं नाम निर्दग्धं चास्त्रतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000055022, "chapter_id": 9055, "verse_number": "१-५५-२२", "content_sanskrit": "उदीर्यमाणमस्त्रं तद् विश्वामित्रस्य धीमतः।\nदृष्ट्वा विप्रद्रुता भीता मुनयः शतशो दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000055023, "chapter_id": 9055, "verse_number": "१-५५-२३", "content_sanskrit": "वसिष्ठस्य च ये शिष्या ये च वै मृगपक्षिणः।\nविद्रवन्ति भयाद् भीता नानादिग्भ्यः सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000055024, "chapter_id": 9055, "verse_number": "१-५५-२४", "content_sanskrit": "वसिष्ठस्याश्रमपदं शून्यमासीन्महात्मनः।\nमुहूर्तमिव निःशब्दमासीदीरिणसंनिभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000055025, "chapter_id": 9055, "verse_number": "१-५५-२५", "content_sanskrit": "वदतो वै वसिष्ठस्य मा भैरिति मुहुर्मुहुः।\nनाशयाम्यद्य गाधेयं नीहारमिव भास्करः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000055026, "chapter_id": 9055, "verse_number": "१-५५-२६", "content_sanskrit": "एवमुक्त्वा महातेजा वसिष्ठो जपतां वरः।\nविश्वामित्रं तदा वाक्यं सरोषमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000055027, "chapter_id": 9055, "verse_number": "१-५५-२७", "content_sanskrit": "आश्रमं चिरसंवृद्धं यद् विनाशितवानसि।\nदुराचारो हि यन्मूढस्तस्मात् त्वं न भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000055028, "chapter_id": 9055, "verse_number": "१-५५-२८", "content_sanskrit": "इत्युक्त्वा परमक्रुद्धो दण्डमुद्यम्य सत्वरः।\nविधूम इव कालाग्निर्यमदण्डमिवापरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000055029, "chapter_id": 9055, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे पञ्चपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]