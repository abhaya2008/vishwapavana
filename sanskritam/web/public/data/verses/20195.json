[{"id": 7000195000, "chapter_id": 20195, "verse_number": "१९५-१", "content_sanskrit": "जरासंधेन सह रामजनार्दनयुद्धवर्णनम् व्यास उवाच जरासन्धसुते कंस उपयेमे महाबलः ।\nअस्तिः प्राप्तिश्च भो विप्रास्तयोर्भर्तृहणं हरिम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000195001, "chapter_id": 20195, "verse_number": "१९५-२", "content_sanskrit": "महाबलपरीवारो मागधाधिपतिर्बली ।\nहन्तुमभ्याययौ कोपाज्जरासंधः सयादवम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000195002, "chapter_id": 20195, "verse_number": "१९५-३", "content_sanskrit": "उपेत्य मथुरां सोऽथ रुरोध मगधेश्वरः ।\nअक्षौहिणीभिः सैन्यस्य त्रयोविंशतिभिर्वृतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000195003, "chapter_id": 20195, "verse_number": "१९५-४", "content_sanskrit": "निष्क्रम्याल्पपरीवारावभौ रामजनार्दनौ ।\nयुयुधाते समं तस्य बलिनौ बलिसैनिकैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000195004, "chapter_id": 20195, "verse_number": "१९५-५", "content_sanskrit": "ततो बलश्च कृष्णश्च मतिं चक्रे महाबलः ।\nआयुधानां पुराणानामादाने मुनिसत्तमाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000195005, "chapter_id": 20195, "verse_number": "१९५-६", "content_sanskrit": "अनन्तरं चक्रशार्ङ्गे तूणौ चाप्यक्षयो शरैः ।\nआकाशादागतौ वीरौ तदा कौमोदकी गदा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000195006, "chapter_id": 20195, "verse_number": "१९५-७", "content_sanskrit": "हलं च बलभद्रस्य गगनादागमत्करम् ।\nबलस्याभिमतं विप्राः सुनन्दं मुशलं तथा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000195007, "chapter_id": 20195, "verse_number": "१९५-८", "content_sanskrit": "ततो युद्धे पराजित्य स्वसैन्यं मगधाधिपम् ।\nपुरीं विवशतुर्वीरावुभौ रामजनार्दनौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000195008, "chapter_id": 20195, "verse_number": "१९५-९", "content_sanskrit": "जिते तस्मिन्सुदुर्वृत्ते जरासंधे द्विजोत्तमाः ।\nजीवमाने गते तत्र कृष्णो मेने न तं जितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000195009, "chapter_id": 20195, "verse_number": "१९५-१०", "content_sanskrit": "पुनरप्याजगामात जरासंधो बलान्वितः ।\nजितश्च रामकृष्णाभ्यमापकृत्य द्विजोत्तमा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000195010, "chapter_id": 20195, "verse_number": "१९५-११", "content_sanskrit": "दश चाष्टौ च संग्रामानेवमत्यन्तदुर्मदः ।\nयदुभिर्मागधो राजा चक्रे कृष्णपुरोगमैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000195011, "chapter_id": 20195, "verse_number": "१९५-१२", "content_sanskrit": "सर्वेष्वेव च युद्धेषु यदुभिः स पराजितः ।\nअपक्रान्तो जरासंधः स्वल्पसैन्यैर्बलाधिकः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000195012, "chapter_id": 20195, "verse_number": "१९५-१३", "content_sanskrit": "तद्‌बलं यादवानां वै रक्षितं यदनेकशः ।\nतत्तु संनिधिमाहात्म्यं विष्णोरंशस्य चक्रिणः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000195013, "chapter_id": 20195, "verse_number": "१९५-१४", "content_sanskrit": "मनुष्यधर्मशीलस्य लीला सा जगतः पते ।\nअस्त्राण्यनेकरूपाणि यदरातिषु मुञ्चति ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000195014, "chapter_id": 20195, "verse_number": "१९५-१५", "content_sanskrit": "मनसैव जगत्सृष्टिसंहारं तु करोति यः ।\nतस्यारिपक्षक्षपणे कियानुद्यमविस्तरः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000195015, "chapter_id": 20195, "verse_number": "१९५-१६", "content_sanskrit": "तथाऽपि च मनुष्याणां धर्मस्तदनुवर्तनम् ।\nकुर्वन्बलवता संधिं हीनैर्युद्धं करोत्यसौ ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000195016, "chapter_id": 20195, "verse_number": "१९५-१७", "content_sanskrit": "साम चोपप्रादानं च तथा भेदं च दर्शयन् ।\nकरोति दण्डपातं च क्वचिदेव पलायनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000195017, "chapter_id": 20195, "verse_number": "१९५-१८", "content_sanskrit": "मनुष्यदेहिनां चेष्टामित्येवमनुवर्तते ।\nलीला जगत्पतेस्तस्य च्छन्दतः संप्रवर्तते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]