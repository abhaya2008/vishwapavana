[{"id": 2094754, "chapter_id": 3027, "verse_number": "१३-१५७-१", "content_sanskrit": "युधिष्ठिर उवाच।\nकथं वै स विपन्नश्च कथं वै पातितो भुवि।\nकथं देवेन्द्रतां प्राप्तस्तद्भवान्वक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2094755, "chapter_id": 3027, "verse_number": "१३-१५७-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2094756, "chapter_id": 3027, "verse_number": "१३-१५७-२", "content_sanskrit": "एवं तयोः संवदतोः क्रियास्तस्य महात्मनः।\nसर्वा एव प्रवर्तन्ते या दिव्या याश्च मानुषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2094757, "chapter_id": 3027, "verse_number": "१३-१५७-३", "content_sanskrit": "तथैव दीपदानानि सर्वोपकरणानि वै।\nबलिकर्म च यच्चान्यद्वत्सकाश्च पृथग्विधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2094758, "chapter_id": 3027, "verse_number": "१३-१५७-४", "content_sanskrit": "सर्वास्तस्य समुत्पन्ना देवेन्द्रस्य महात्मनः।\nदेवलोके नृलोके च सदाचारपुरस्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2094759, "chapter_id": 3027, "verse_number": "१३-१५७-५", "content_sanskrit": "ताश्चोद्भवन्ति राजेन्द्र समृद्ध्यै गृहमेधिनः।\nधूपप्रदानैर्दीपैश्च नमस्कारैस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2094760, "chapter_id": 3027, "verse_number": "१३-१५७-६", "content_sanskrit": "यथा सिद्धस्य चान्नस्य गृह्य चाग्रं प्रदीयते।\nबलयश्च गृहोद्देशे ततः प्रीयन्ति देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2094761, "chapter_id": 3027, "verse_number": "१३-१५७-७", "content_sanskrit": "यथा च गृहिणस्तोषो भवेद्वै बलिकर्मणि।\nतथा शतगुणा प्रीतिर्देवतानां प्रजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2094762, "chapter_id": 3027, "verse_number": "१३-१५७-८", "content_sanskrit": "एवं धूपप्रदानं च दीपदानं च साधवः।\nप्रयच्छति नमस्कारैर्युक्तमात्मगुणावहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2094763, "chapter_id": 3027, "verse_number": "१३-१५७-९", "content_sanskrit": "स्नानेनाद्भिश्च यत्कर्म क्रियते वै विपश्चिता।\nनमस्कारप्रयुक्तेन तेन प्रीणन्ति देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2094764, "chapter_id": 3027, "verse_number": "१३-१५७-१०", "content_sanskrit": "पितरश्च महाभागा ऋषयश्च तपोधनाः।\nगृह्याश्च देवताः सर्वाः प्रीयन्ते विधिनाऽर्चिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2094765, "chapter_id": 3027, "verse_number": "१३-१५७-११", "content_sanskrit": "इत्येतां बुद्धिमास्थाय नहुषः स नरेश्वरः।\nसुरेन्द्रत्वं महत्प्राप्य कृतवानेतदद्भुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2094766, "chapter_id": 3027, "verse_number": "१३-१५७-१२", "content_sanskrit": "कस्य चित्त्वथ कालस्य भाग्यक्षय उपस्थिते।\nसर्वमेतदवज्ञाय न चकार यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2094767, "chapter_id": 3027, "verse_number": "१३-१५७-१३", "content_sanskrit": "ततः स परिहीणोऽभूत्सुरेन्द्रो बलदर्पतः।\nधूपदीपादिकविधिं न यथावच्चकार ह।\nततोऽस्य यज्ञविषयो रक्षोभिः परिबाध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2094768, "chapter_id": 3027, "verse_number": "१३-१५७-१४", "content_sanskrit": "अथागस्त्यमृषिश्रेष्ठं वाहनायाजुहाव ह।\nद्रुतं सरस्वतीकूलात्स्मयन्निव महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2094769, "chapter_id": 3027, "verse_number": "१३-१५७-१५", "content_sanskrit": "ततो भृगुर्महातेजा मैत्रावरुणिमब्रवीत्।\nनिमीलयस्व नयने जटां यावद्विशामि ते।\n`सुरेन्द्रपतनायेति स च नेत्र न्यमीलयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2094770, "chapter_id": 3027, "verse_number": "१३-१५७-१६", "content_sanskrit": "ततोऽगस्त्यस्याथ जटां दृष्ट्वा प्राविशदच्युतः।\nभृगुः स सुमहातेजाः पातनाय नृपस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2094771, "chapter_id": 3027, "verse_number": "१३-१५७-१७", "content_sanskrit": "ततः स देवराट् प्राप्तस्तमृषिं वाहनाय वै।\nततोऽगस्त्यः सुरपतिं वाक्यमाह विशाम्पते।\nयोजयस्वेति मां क्षिप्रं कं च देशं वहामि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2094772, "chapter_id": 3027, "verse_number": "१३-१५७-१८", "content_sanskrit": "यत्र वक्ष्यसि तत्र त्वां नयिष्यामि सुराधिप।\nइत्युक्तो नरहुषस्तेन योजयामास तं मुनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2094773, "chapter_id": 3027, "verse_number": "१३-१५७-१९", "content_sanskrit": "भृगुस्तस्य जटान्तस्थो बभूव हृषितो भृशम्।\nन चापि दर्शनं तस्य चकार स भृगुस्तदा।\nवरदानप्रभावज्ञो नहुषस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2094774, "chapter_id": 3027, "verse_number": "१३-१५७-२०", "content_sanskrit": "न चुकोप तदाऽगस्त्यो युक्तोऽपि नहुषेण वै।\nतं तु राजा पदैकेन चोदयामास भारत।\n`श्रुतिः स्मृतिः प्रमाणं वा नेतिवादेन देवराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2094775, "chapter_id": 3027, "verse_number": "१३-१५७-२१", "content_sanskrit": "न चुकोप स धर्मात्मा ततः पादेन देवराट्।\nअगस्त्यस्य तदा क्रुद्धो वामेनाभ्यहनच्छिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2094776, "chapter_id": 3027, "verse_number": "१३-१५७-२२", "content_sanskrit": "तस्मिञ्शिरस्यभिहते स जटान्तर्गतो भृगुः।\nशशाप बलवत्क्रुद्धो नहुषं पापचेतसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2094777, "chapter_id": 3027, "verse_number": "१३-१५७-२३", "content_sanskrit": "यस्मात्पदाऽवधीः क्रोधाच्छिरसीमं महामुनिम्।\nतस्मादाशु महीं गच्छ सर्पो भूत्वा सुदुर्मते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2094778, "chapter_id": 3027, "verse_number": "१३-१५७-२४", "content_sanskrit": "शप्तोऽथ स तदा तेन सर्पो भूत्वा पपात ह।\nअदृष्टेनाथ भृगुणा भूतले भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2094779, "chapter_id": 3027, "verse_number": "१३-१५७-२५", "content_sanskrit": "भृगुं हि यदि सोऽद्राक्षीन्नहुषः पृथिवीपते।\nस शक्तोनाऽभविष्यद्वै पातने तस्य तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2094780, "chapter_id": 3027, "verse_number": "१३-१५७-२६", "content_sanskrit": "स तु तैस्तैः प्रदानैश्च तपोभिर्नियमैस्तथा।\nपतितोऽपि महाराज भूतले स्मृतिमानभूत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2094781, "chapter_id": 3027, "verse_number": "१३-१५७-२७", "content_sanskrit": "प्रसादयामास भृगुं शापान्तो मे भवेदिति।\nततोऽगस्त्यः कृपाविष्टः प्रासादयत तं भृगुम्।\nशापान्तार्थं महाराज स च प्रादात्कृपान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2094782, "chapter_id": 3027, "verse_number": "१३-१५७-२८x", "content_sanskrit": "भृगुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2094783, "chapter_id": 3027, "verse_number": "१३-१५७-२८", "content_sanskrit": "राजा युधिष्ठिरो नाम भविष्यति कुरूद्वहः।\nस त्वां मोक्षयिता शापादित्युक्त्वाऽन्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2094784, "chapter_id": 3027, "verse_number": "१३-१५७-२९", "content_sanskrit": "अगस्त्योऽपि महातेजाः कृत्वा कार्यं शतक्रतोः।\nस्वमाश्रमपदं प्रायात्पूज्यमानो द्विजातिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2094785, "chapter_id": 3027, "verse_number": "१३-१५७-३०", "content_sanskrit": "नहुषोऽपि त्वया राजंस्तस्माच्छापात्समुद्धृतः।\nजगाम ब्रह्मभवनं पश्यतस्ते जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2094786, "chapter_id": 3027, "verse_number": "१३-१५७-३१", "content_sanskrit": "तदा स पातयित्वा तं नहुषं भूतले भृगुः।\nजगाम ब्रह्मभवनं ब्रह्मणे च न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2094787, "chapter_id": 3027, "verse_number": "१३-१५७-३२", "content_sanskrit": "ततः शक्रं समानाय्य देवानाह पितामहः।\nवरदानान्मम सुरा नहुषो राज्यमाप्तवान्।\nस चागस्त्येन क्रुद्धेन भ्रंशितो भूतलं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2094788, "chapter_id": 3027, "verse_number": "१३-१५७-३३", "content_sanskrit": "न च शक्यं विना राज्ञा सुखं वर्तयितुं क्वचित्।\nतस्मादयं पुनः शक्रो देवराज्येऽभिषिच्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2094789, "chapter_id": 3027, "verse_number": "१३-१५७-३४", "content_sanskrit": "एवं सम्भाषमाणं तु देवाः पार्थ पितामहम्।\nएवमस्त्विति संहृष्टाः प्रत्यूचुस्तं नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2094790, "chapter_id": 3027, "verse_number": "१३-१५७-३५", "content_sanskrit": "सोऽभिषिक्तो भगवता देवराज्ये च वासवः।\nब्रह्मणा राजशार्दूल यथापूर्वं व्यरोचत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2094791, "chapter_id": 3027, "verse_number": "१३-१५७-३६", "content_sanskrit": "एवमेतत्पुरावृत्तं नहुषस्य व्यतिक्रमात्।\nस च तैरेव संसिद्धो नहुषः कर्मभिः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2094792, "chapter_id": 3027, "verse_number": "१३-१५७-३७", "content_sanskrit": "तस्माद्दीपाः प्रदातव्याः सायं वै गृहमेधिभिः।\nदिव्यं चक्षुरवाप्नोति प्रेत्य दीपस्य दायकः।\nपूर्णचन्द्रप्रतीकाशा दीपदाश्च भवन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2094793, "chapter_id": 3027, "verse_number": "१३-१५७-३८", "content_sanskrit": "यावदक्षिनिमेषाणि ज्वलन्ते तावतीः समाः।\nरूपवान्बलवांश्चापि नरो भवति दीपदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2094794, "chapter_id": 3027, "verse_number": "१३-१५७-३९", "content_sanskrit": "य इदं शृणुयाद्वापि पठते यो द्विजोत्तमः।\nब्रह्मलोकमवाप्नोति स च वै नात्र संशयः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2094795, "chapter_id": 3027, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्तपञ्चाशदधिकशततमोऽध्यायः॥ १५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]