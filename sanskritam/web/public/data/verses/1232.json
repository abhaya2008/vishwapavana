[{"id": 2011367, "chapter_id": 1232, "verse_number": "१-२३३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2011368, "chapter_id": 1232, "verse_number": "१-२३३-१", "content_sanskrit": "एवं ते समयं कृत्वा न्यवसंस्तत्र पाण्डवाः।\nवशे शस्त्रप्रतापेन कुर्वन्तोऽन्यान्महीक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2011369, "chapter_id": 1232, "verse_number": "१-२३३-२", "content_sanskrit": "तेषां मनुजसिंहानां पञ्चानाममितौजसाम्।\nबभूव कृष्णा सर्वेषां पार्थानां वशवर्तिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2011370, "chapter_id": 1232, "verse_number": "१-२३३-३", "content_sanskrit": "ते तया तैश्च सा वीरैः पतिभिः सह पञ्चभिः।\nबभूव परमप्रीता नागैरिव सरस्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2011371, "chapter_id": 1232, "verse_number": "१-२३३-४", "content_sanskrit": "वर्तमानेषु धर्मेण पाण्डवेषु महात्मसु।\nव्यवर्धन्कुरवः सर्वे हीनदोषाः सुखान्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2011372, "chapter_id": 1232, "verse_number": "१-२३३-५", "content_sanskrit": "अथ दीर्घेण कालेन ब्राह्मणस्य विशांपते।\nकस्यचित्तस्करा जह्रुः केचिद्गा नृपसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2011373, "chapter_id": 1232, "verse_number": "१-२३३-६", "content_sanskrit": "ह्रियमाणे धने तस्मिन्ब्राह्मणः क्रोधमूर्च्छितः।\nआगम्य खाण्डवप्रस्थमुदक्रोशत्स पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2011374, "chapter_id": 1232, "verse_number": "१-२३३-७", "content_sanskrit": "ह्रियते गोधनं क्षुद्रैर्नृशंसैरकृतात्मभिः।\nप्रसह्य चास्मद्विषयादभ्यधावत पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2011375, "chapter_id": 1232, "verse_number": "१-२३३-८", "content_sanskrit": "ब्राह्मणस्य प्रशान्तस्य हविर्ध्वाङ्क्षैः प्रलुप्यते।\nशार्दूलस्य गुहां शून्यां नीचः क्रोष्टाभिमर्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2011376, "chapter_id": 1232, "verse_number": "१-२३३-९", "content_sanskrit": "अरक्षितारं राजानं बलिषद्भागहारिणम्।\nतमाहुः सर्वलोकस्य समग्रं पापचारिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2011377, "chapter_id": 1232, "verse_number": "१-२३३-१०", "content_sanskrit": "ब्राह्मणस्वे हृते चोरैर्धर्मार्थे च विलोपिते।\nरोरूयमाणे च मयि क्रियतां हस्तधारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2011378, "chapter_id": 1232, "verse_number": "१-२३३-११x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2011379, "chapter_id": 1232, "verse_number": "१-२३३-११", "content_sanskrit": "रोरूयमाणस्याभ्याशे भृशं विप्रस्य पाण्डवः।\nतानि वाक्यानि शुश्राव कुन्तीपुत्रो धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2011380, "chapter_id": 1232, "verse_number": "१-२३३-१२", "content_sanskrit": "श्रुत्वैव च महाबाहुर्मा भैरित्याह तं द्विजम्।\nआयुधानि च यत्रासन्पाण्डवानां महात्मनां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2011381, "chapter_id": 1232, "verse_number": "१-२३३-१३", "content_sanskrit": "कृष्णया सह तत्रास्ते धर्मराजो युधिष्ठिरः।\nसंप्रवेशाय चाशक्तो गमनाय च पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2011382, "chapter_id": 1232, "verse_number": "१-२३३-१४", "content_sanskrit": "तस्य चार्तस्य तैर्वाक्यैश्चोद्यमानः पुनःपुनः।\nआक्रन्दे तत्र कौन्तेयश्चिन्तयामास दुःखितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2011383, "chapter_id": 1232, "verse_number": "१-२३३-१५", "content_sanskrit": "ह्रियमाणे धने तस्मिन्ब्राह्मणस्य तपस्विनः।\nअश्रुप्रमार्जनं तस्य कर्तव्यमिति निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2011384, "chapter_id": 1232, "verse_number": "१-२३३-१६", "content_sanskrit": "उपर्रेक्षणजोऽधर्मः सुमहान्स्यान्महीपतेः।\nयद्यस्य रुदतो द्वारि न करोम्यद्य रक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2011385, "chapter_id": 1232, "verse_number": "१-२३३-१७", "content_sanskrit": "अनास्तिक्यं च सर्वेषामस्माकमपि रक्षणे।\nप्रतितिष्ठेत लोकेऽस्मिन्नधर्मश्चैव नो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2011386, "chapter_id": 1232, "verse_number": "१-२३३-१८", "content_sanskrit": "अनापृच्छय तु राजानं गते मयि न संशयः।\nअजातशत्रोर्नृपतेर्मयि चैवानृतं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2011387, "chapter_id": 1232, "verse_number": "१-२३३-१९", "content_sanskrit": "अनुप्रवेशे राज्ञस्तु वनवासो भवेन्मम।\nसर्वमन्यत्परिहृतं धर्षणात्तु महीपतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2011388, "chapter_id": 1232, "verse_number": "१-२३३-२०", "content_sanskrit": "अधर्मो वै महानस्तु वने वा मरणं मम।\nशरीरस्य विनाशेन धर्म एव विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2011389, "chapter_id": 1232, "verse_number": "१-२३३-२१", "content_sanskrit": "एवं विनिश्चित्य ततः कुन्तीपुत्रो धनञ्जयः।\nअनुप्रविश्य राजानमापृच्छय च विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2011390, "chapter_id": 1232, "verse_number": "१-२३३-२२", "content_sanskrit": "मुखमाच्छाद्य निबिडमुत्तरीयेण वाससा।\nअग्रजं चार्जुनो गेहादभिवाद्याशु निःसृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2011391, "chapter_id": 1232, "verse_number": "१-२३३-२३", "content_sanskrit": "धनुरादाय संहृष्टो ब्राह्मणं प्रत्यभाषत।\nब्राह्मणा गम्यतां शीघ्रं यावत्परधनैर्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2011392, "chapter_id": 1232, "verse_number": "१-२३३-२४", "content_sanskrit": "न दूरे ते गताः क्षुद्रास्तावद्गच्छावहे सह।\nयावन्निवर्तयाम्यद्य चोरहस्ताद्धनं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2011393, "chapter_id": 1232, "verse_number": "१-२३३-२५", "content_sanskrit": "सोऽनुसृत्य महाबाहुर्धन्वी वर्मी रथी ध्वजी।\nशरैर्विध्वस्य तांश्चोरानवजित्य च तद्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2011394, "chapter_id": 1232, "verse_number": "१-२३३-२६", "content_sanskrit": "ब्राह्मणं समुपाकृत्य यशः प्राप्य च पाण्डवः।\nततस्तद्गेधनं पार्थो दत्त्वा तस्मै द्विजातये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2011395, "chapter_id": 1232, "verse_number": "१-२३३-२७", "content_sanskrit": "आजगाम पुरं वीरः सव्यसाची धनञ्जयः।\nसोऽभिवाद्य गुरून्सर्वान्सर्वैश्चाप्यभिनन्दितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2011396, "chapter_id": 1232, "verse_number": "१-२३३-२८", "content_sanskrit": "धर्मराजमुवाचेदं व्रतमादिश मे प्रभो।\nसमयः समतिक्रान्तो भवत्संदर्शने मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2011397, "chapter_id": 1232, "verse_number": "१-२३३-२९", "content_sanskrit": "वनवासं गमिष्यामि समयो ह्येष नः कृतः।\nइत्युक्तो धर्मरास्तु सहसा वाक्यमप्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2011398, "chapter_id": 1232, "verse_number": "१-२३३-३०", "content_sanskrit": "कथमित्यब्रवीद्वाचा शोकार्तः सज्जमानया।\nयुधिष्ठिरो गुडाकेशं भ्राता भ्रातरमच्युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2011399, "chapter_id": 1232, "verse_number": "१-२३३-३१", "content_sanskrit": "उवाच दीनो राजा च धनञ्जयमिदं वचः।\nप्रमाणमस्मि यदि ते मत्तः शृणु वचोऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2011400, "chapter_id": 1232, "verse_number": "१-२३३-३२", "content_sanskrit": "अनुप्रवेशे यद्वीर कृतवांस्त्वं ममाप्रियम्।\nसर्वं तदनुजानामि व्यलीकं न च मे हृदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2011401, "chapter_id": 1232, "verse_number": "१-२३३-३३", "content_sanskrit": "गुरोरनुप्रवेशो हि नोपघातो यवीयसः।\nयवीयसोऽनुप्रवेशो ज्येष्ठस्य विधिलोपकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2011402, "chapter_id": 1232, "verse_number": "१-२३३-३४", "content_sanskrit": "निवर्तस्व महाबाहो कुरुष्व वचनं मम।\nन हि ते धर्मलोपोऽस्ति न च ते धर्पणा कृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2011403, "chapter_id": 1232, "verse_number": "१-२३३-३५x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2011404, "chapter_id": 1232, "verse_number": "१-२३३-३५", "content_sanskrit": "न व्याजेन चरेद्धर्ममिति मे भवतः श्रुतम्।\nन सत्याद्विचलिष्यामि सत्येनायुधमालभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2011405, "chapter_id": 1232, "verse_number": "१-२३३-३६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2011406, "chapter_id": 1232, "verse_number": "१-२३३-३६", "content_sanskrit": "सोऽभ्यनुज्ञाय राजानं वनचर्याय दीक्षितः।\nवने द्वादश मासांस्तु वासायानुजगाम ह॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2011407, "chapter_id": 1232, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि अर्जुनवनवासपर्वणि त्रयस्त्रिंशदधिकद्विशततमोऽध्यायः॥ २३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]