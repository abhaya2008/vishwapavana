[{"id": 2194982, "chapter_id": 5149, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2194983, "chapter_id": 5149, "verse_number": "१", "content_sanskrit": "स चामन्त्र्योरगश्रेष्ठं ब्राह्मणः कृतनिश्चयः ।\nदीक्षाकाङ्क्षी तदा राजन् च्यवनं भार्गवं श्रितः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2194984, "chapter_id": 5149, "verse_number": "२", "content_sanskrit": "स तेन कृतसंस्कारो धर्ममेवोपतस्थिवान् ।\nतथैव च कथामेतां राजन्कथितवांस्तदा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2194985, "chapter_id": 5149, "verse_number": "३", "content_sanskrit": "भार्गवेणापि राजेन्द्र जनकस्य निवेशने ।\nकथैषा कथिता पुण्या नारदाय महात्मने\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2194986, "chapter_id": 5149, "verse_number": "४", "content_sanskrit": "नारदेनापि राजेन्द्र देवेन्द्रस्य निवेशने ।\nकथिता भरतश्रेष्ठ पृष्टेनाक्लिष्टकर्मणा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2194987, "chapter_id": 5149, "verse_number": "५", "content_sanskrit": "देवराजेन च पुरा कथैषा कथिता शुभा ।\nसमस्तेभ्यः प्रशस्तेभ्यो वसुभ्यो वसुधाधिप\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2194988, "chapter_id": 5149, "verse_number": "६", "content_sanskrit": "यदा च मम रामेण युद्धमासीत् सुदारुणम् ।\nवसुभिश्च तदा राजन् कथेयं कथिता मम\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2194989, "chapter_id": 5149, "verse_number": "७", "content_sanskrit": "पृच्छमानाय तत्त्वेन मया तुभ्यं विशां पते ।\nकथेयं कथिता पुण्या धर्म्या धर्मभृतां वर\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2194990, "chapter_id": 5149, "verse_number": "८", "content_sanskrit": "तदेष परमो धर्मो यन्मां पृच्छसि भारत ।\nअसन्नधीरनाकाङ्क्षी धर्मार्थकरणे नृप\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2194991, "chapter_id": 5149, "verse_number": "९", "content_sanskrit": "स च किल कृतनिश्चयो द्विजाग्र्यो\nभुजगपतिप्रतिदेशितार्थकृत्यः ।\nयमनियमसमाहितो वनान्तं\nपरिगणितोञ्छशिलाशनः प्रविष्टः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2194992, "chapter_id": 5149, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे अष्टनवत्युत्तरशततमोऽध्यायः ॥१९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2194993, "chapter_id": 5149, "verse_number": "", "content_sanskrit": "॥ समाप्तं मोक्षधर्मपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]