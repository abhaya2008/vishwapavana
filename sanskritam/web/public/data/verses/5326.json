[{"id": 2203038, "chapter_id": 5326, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2203039, "chapter_id": 5326, "verse_number": "१", "content_sanskrit": "जन्म मानुष्यकं प्राप्य कर्मक्षेत्रं सुदुर्लभम् ।\nश्रेयोर्थिना दरिद्रेण किं कर्तव्यं पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2203040, "chapter_id": 5326, "verse_number": "२", "content_sanskrit": "दानानामुत्तमं यच्च देयं यच्च यथायथा ।\nमान्यान् पूज्यांश्च गाङ्गेय रहस्यं वक्तुमर्हसि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2203041, "chapter_id": 5326, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2203042, "chapter_id": 5326, "verse_number": "३", "content_sanskrit": "एवं पृष्टो नरेन्द्रेण पाण्डवेन यशस्विना ।\nधर्माणां परमं गुह्यं भीष्मः प्रोवाच पार्थिवम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2203043, "chapter_id": 5326, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2203044, "chapter_id": 5326, "verse_number": "४", "content_sanskrit": "शृणुष्वावहितो राजन् धर्मगुह्यानि भारत ।\nयथाहि भगवान् व्यासः पुरा कथितवान् मयि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2203045, "chapter_id": 5326, "verse_number": "५", "content_sanskrit": "देवगुह्यमिदं राजन् यमेनाक्लिष्टकर्मणा ।\nनियमस्थेन युक्तेन तपसो महतः फलम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2203046, "chapter_id": 5326, "verse_number": "६", "content_sanskrit": "येन यः प्रीयते देवः प्रीयन्ते पितरस्तथा ।\nऋषयः प्रमथाः श्रीश्च चित्रगुप्तो दिशांगजाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2203047, "chapter_id": 5326, "verse_number": "७", "content_sanskrit": "ऋषिधर्मः स्मृतो यत्र सरहस्यो महाफलः ।\nमहादानफलं चैव सर्वयज्ञफलं तथा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2203048, "chapter_id": 5326, "verse_number": "८", "content_sanskrit": "यश्चैतदेवं जानीयाज्ज्ञात्वा वा कुरुतेऽनघ ।\nसदोषोऽदोषवांश्चेह तैर्गुणैः सह युज्यते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2203049, "chapter_id": 5326, "verse_number": "९", "content_sanskrit": "दशसूनासमं चक्रं दशचक्रसमो ध्वजः ।\nदशध्वजसमा वेश्या दशवेश्यासमो नृपः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2203050, "chapter_id": 5326, "verse_number": "१०", "content_sanskrit": "अर्धेनैतानि सर्वाणि नृपतिः कथ्यतेऽधिकः ।\nत्रिवर्गसहितं शास्त्रं पवित्रं पुण्यलक्षणम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2203051, "chapter_id": 5326, "verse_number": "११", "content_sanskrit": "धर्मव्याकरणं पुण्यं रहस्यश्रवणं महत् ।\nश्रोतव्यं धर्मसंयुक्तं विहितं त्रिदशैः स्वयम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2203052, "chapter_id": 5326, "verse_number": "१२", "content_sanskrit": "पितॄणां यत्र गुह्यानि प्रोच्यन्ते श्राद्धकर्मणि ।\nदेवतानां च सर्वेषां रहस्यं कथ्यतेऽखिलम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2203053, "chapter_id": 5326, "verse_number": "१३", "content_sanskrit": "ऋषिधर्मः स्मृतो यत्र सरहस्यो महाफलः ।\nमहायज्ञफलं चैव सर्वदानफलं तथा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2203054, "chapter_id": 5326, "verse_number": "१४", "content_sanskrit": "ये पठन्ति सदा मर्त्या येषां चैवोपतिष्ठति ।\nश्रुत्वा च फलमाचष्टे स्वयं नारायणः प्रभुः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2203055, "chapter_id": 5326, "verse_number": "१५", "content_sanskrit": "गवां फलं तीर्थफलं यज्ञानां चैव यत्फलम् ।\nएतत्फलमवाप्नोति यो नरोऽतिथिपूजकः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2203056, "chapter_id": 5326, "verse_number": "१६", "content_sanskrit": "श्रोतारः श्रद्धधानाश्च येषां शुद्धं च मानसम् ।\nतेषां व्यक्तं जिता लोकाः श्रद्दधानेन साधुना\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2203057, "chapter_id": 5326, "verse_number": "१७", "content_sanskrit": "मुच्यते किल्बिषाच्चैव न स पापेन लिप्यते ।\nधर्मं च लभते नित्यं प्रेत्य लोकगतो नरः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2203058, "chapter_id": 5326, "verse_number": "१८", "content_sanskrit": "कस्यचित्त्वथ कालस्य देवदूतो यदृच्छया ।\nस्थितो ह्यन्तर्हितो भूत्वा पर्यभाषत वासवम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2203059, "chapter_id": 5326, "verse_number": "१९", "content_sanskrit": "यो तौ कामगुणोपेतावश्विनौ भिषजांवरौ ।\nआज्ञयाऽहं तयोः प्राप्तः सनरान् पितृदैवतान्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2203060, "chapter_id": 5326, "verse_number": "२०", "content_sanskrit": "कस्माद्धि मैथुनं श्राद्धे दातुर्भोक्तुश्च वर्जितम् ।\nकिमर्थं च त्रयः पिण्डाः प्रविभक्ताः पृथक्पृथक्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2203061, "chapter_id": 5326, "verse_number": "२१", "content_sanskrit": "प्रथमः कस्य दातव्यो मध्यमः क्व च गच्छति ।\nउत्तरश्च स्मृतः कस्य एतदिच्छामि वेदितुम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2203062, "chapter_id": 5326, "verse_number": "२२", "content_sanskrit": "श्रद्दधानेन दूतेन भाषितं धर्मसंहितम् ।\nपूर्वस्थास्त्रिदशाः सर्वे पितरः पूज्य खेचरम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2203063, "chapter_id": 5326, "verse_number": "", "content_sanskrit": "पितरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2203064, "chapter_id": 5326, "verse_number": "२३", "content_sanskrit": "स्वागतं तेऽस्तु भद्रं ते श्रूयतां खेचरोत्तम ।\nगूढार्थः परमः प्रश्नो भवता समुदीरितः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2203065, "chapter_id": 5326, "verse_number": "२४", "content_sanskrit": "श्राद्धं दत्त्वा च भुक्त्वा च पुरुषो यः स्त्रियं व्रजेत् ।\nपितरस्तस्य तं मासं तस्मिन् रेतसि शेरते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2203066, "chapter_id": 5326, "verse_number": "२५", "content_sanskrit": "प्रविभागं तु पिण्डानां प्रवक्ष्याम्यनुपूर्वशः ।\nपिण्डो ह्यधस्ताद् गच्छंस्तु अप आविश्य भावयेत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2203067, "chapter_id": 5326, "verse_number": "२६", "content_sanskrit": "पिण्डं तु मध्यमं तत्र पत्नी त्वेका समश्नुते ।\nपिण्डस्तृतीयो यस्तेषां तं दद्याज्जातवेदसि ।\nएष श्राद्धविधिः प्रोक्तो यथा धर्मो न लुप्यते\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2203068, "chapter_id": 5326, "verse_number": "२७", "content_sanskrit": "पितरस्तस्य तुष्यन्ति प्रहृष्टमनसः सदा ।\nप्रजा विवर्धते चास्य अक्षयं चोपतिष्ठति\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2203069, "chapter_id": 5326, "verse_number": "", "content_sanskrit": "देवदूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2203070, "chapter_id": 5326, "verse_number": "२८", "content_sanskrit": "आनुपूर्व्येण पिण्डानां प्रविभागः पृथक्पृथक् ।\nपितॄणां त्रिषु सर्वेषां निरुक्तं कथितं त्वया\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2203071, "chapter_id": 5326, "verse_number": "२९", "content_sanskrit": "एकः समुद्धृतः पिण्डो ह्यधस्तात् कस्य गच्छति ।\nकं वा प्रीणयते देवं कथं तारयते पितॄन्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2203072, "chapter_id": 5326, "verse_number": "३०", "content_sanskrit": "मध्यमं तु तदा पत्नी भुङ्क्तेऽनुज्ञातमेव हि ।\nकिमर्थं पितरस्तस्य कव्यमेव च भुञ्जते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2203073, "chapter_id": 5326, "verse_number": "३१", "content_sanskrit": "अत्र यस्त्वन्तिमः पिण्डो गच्छते जातवेदसम् ।\nभवते का गतिस्तस्य कं वा समनुगच्छति\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2203074, "chapter_id": 5326, "verse_number": "३२", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं पिण्डेषु त्रिषु या गतिः ।\nफलं वृत्तिं च मार्गं च यश्चैनं प्रतिपद्यते\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2203075, "chapter_id": 5326, "verse_number": "", "content_sanskrit": "पितरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2203076, "chapter_id": 5326, "verse_number": "३३", "content_sanskrit": "सुमहानेष प्रश्नो वै यस्त्वया समुदीरितः ।\nरहस्यमद्भुतं चापि पृष्टाः स्म गगनेचर \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2203077, "chapter_id": 5326, "verse_number": "३४", "content_sanskrit": "एतदेव प्रशंसन्ति देवाश्च मुनयस्तथा ।\nतेऽप्येवं नाभिजानन्ति पितृकार्यविनिश्चयम् ।\nवर्जयित्वा महात्मानं चिरजीविनमुत्तमम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2203078, "chapter_id": 5326, "verse_number": "३५", "content_sanskrit": "पितृभक्तस्तु यो विप्रो वरलब्धो महायशाः ।\nत्रयाणामपि पिण्डानां श्रुत्वा भगवतो गतिम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2203079, "chapter_id": 5326, "verse_number": "३६", "content_sanskrit": "देवदूतेन यः पृष्टः श्राद्धस्य विधिनिश्चयः ।\nगतिस्त्रयाणां पिण्डानां शृणुष्वावहितो मम\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2203080, "chapter_id": 5326, "verse_number": "३७", "content_sanskrit": "अपो गच्छति यो ह्यत्र शशिनं ह्येष प्रीणयेत् ।\nशशी प्रीणयते देवान् पितॄंश्चैव महामते\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2203081, "chapter_id": 5326, "verse_number": "३८", "content_sanskrit": "भुङ्क्ते तु पत्नी यं चैषामनुज्ञाता तु मध्यमम् ।\nपुत्रकामाय पुत्रं तु प्रयच्छन्ति पितामहाः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2203082, "chapter_id": 5326, "verse_number": "३९", "content_sanskrit": "हव्यवाहे तु यः पिण्डो दीयते तन्निबोध मे ।\nपितरस्तेन तृप्यन्ति प्रीताः कामान् दिशन्ति च ।\nएतत्ते कथितं सर्वं त्रिषु पिण्डेषु या गतिः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2203083, "chapter_id": 5326, "verse_number": "४०", "content_sanskrit": "ऋत्विग् यो यजमानस्य पितृत्वमनुगच्छति ।\nतस्मिन्नहनि मन्यन्ते परिहार्यं हि मैथुनम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2203084, "chapter_id": 5326, "verse_number": "४१", "content_sanskrit": "शुचिना तु सदा श्राद्धं भोक्तव्यं खेचरोत्तम ।\nये मया कथिता दोषास्ते तथा स्युर्न चान्यथा\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2203085, "chapter_id": 5326, "verse_number": "४२", "content_sanskrit": "तस्मात् स्नातः शुचिः क्षान्तः श्राद्धं भुञ्जीत वै द्विजः ।\nप्रजा विवर्धते चास्य चश्चैवं सम्प्रयच्छति\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2203086, "chapter_id": 5326, "verse_number": "४३", "content_sanskrit": "ततो विद्युत्प्रभो नाम ऋषिराह महातपाः ।\nआदित्यतेजसा तस्य तुल्यं रूपं प्रकाशते\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2203087, "chapter_id": 5326, "verse_number": "४४", "content_sanskrit": "स च धर्मरहस्यानि श्रुत्वा शक्रमथाब्रवीत्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2203088, "chapter_id": 5326, "verse_number": "४५", "content_sanskrit": "तिर्यग्योनिगतान् सत्त्वान् मर्त्या हिंसन्ति मोहिताः ।\nकीटान् पिपीलिकान् सर्पान् मेषान् समृगपक्षिणः ।\nकिल्बिषं सुबहु प्राप्ताः किंस्विदेषां प्रतिक्रिया\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2203089, "chapter_id": 5326, "verse_number": "४६", "content_sanskrit": "ततो देवगणाः सर्वे ऋषयश्च तपोधनाः ।\nपितरश्च महाभागाः पूजयन्ति स्म तं मुनिम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2203090, "chapter_id": 5326, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2203091, "chapter_id": 5326, "verse_number": "४७", "content_sanskrit": "कुरुक्षेत्रं गयां गङ्गां प्रभासं पुष्कराणि च ।\nएतानि मनसा ध्यात्वा अवगाहेत् ततो जलम् ।\nतथा मुच्यति पापेन राहुणा चन्द्रमा यथा\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2203092, "chapter_id": 5326, "verse_number": "४८", "content_sanskrit": "त्र्यहं स्नातः स भवति निराहारश्च वर्तते ।\nस्पृशते यो गवां पृष्ठं वालधिं च नमस्यति\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2203093, "chapter_id": 5326, "verse_number": "४९", "content_sanskrit": "ततो विद्युत्प्रभो वाक्यमभ्यभाषत वासवम् ।\nअयं सूक्ष्मतरो धर्मस्तं निबोध शतक्रतो\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2203094, "chapter_id": 5326, "verse_number": "५०", "content_sanskrit": "घृष्टो वटकषायेण अनुलिप्तः प्रियङ्गुणा ।\nक्षीरेण षष्टिकान् भुक्त्वा सर्वपापैः प्रमुच्यते\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2203095, "chapter_id": 5326, "verse_number": "५१", "content_sanskrit": "श्रूयतां चापरं गुह्यं रहस्यमृषिचिन्तितम् ।\nश्रुतं मे भाषमाणस्य स्थाणोः स्थाने बृहस्पतेः ।\nरुद्रेण सह देवेश तन्निबोध शचीपते\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2203096, "chapter_id": 5326, "verse_number": "५२", "content_sanskrit": "पर्वतारोहणं कृत्वा एकपादो विभावसुम् ।\nनिरीक्षेत निराहार ऊर्ध्वबाहुः कृताञ्जलिः ।\nतपसा महता युक्त उपवासफलं लभेत्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2203097, "chapter_id": 5326, "verse_number": "५३", "content_sanskrit": "रश्मिभिस्तापितोऽर्कस्य सर्वपापमपोहति ।\nग्रीष्मकालेऽथवा शीते एवं पापमपोहति\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2203098, "chapter_id": 5326, "verse_number": "५४", "content_sanskrit": "ततः पापात् प्रमुक्तस्य द्युतिर्भवति शाश्वती ।\nतेजसा सूर्यवद् दीप्तो भ्राजते सोमवत् पुनः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2203099, "chapter_id": 5326, "verse_number": "५५", "content_sanskrit": "मध्ये त्रिदशवर्गस्य देवराजः शतक्रतुः ।\nउवाच मधुरं वाक्यं बृहस्पतिमनुत्तमम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2203100, "chapter_id": 5326, "verse_number": "५६", "content_sanskrit": "धर्मगुह्यं तु भगवन् मानुषाणां सुखावहम् ।\nसरहस्याश्च ये दोषास्तान् यथावदुदीरय\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2203101, "chapter_id": 5326, "verse_number": "", "content_sanskrit": "बृहस्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2203102, "chapter_id": 5326, "verse_number": "५७", "content_sanskrit": "प्रतिमेहन्ति ये सूर्यमनिलं द्विषते च ये ।\nहव्यवाहे प्रदीप्ते च समिधं ये न जुह्वति\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2203103, "chapter_id": 5326, "verse_number": "५८", "content_sanskrit": "बालवत्सां च ये धेनुं दुहन्ति क्षीरकारणात् ।\nतेषां दोषान् प्रवक्ष्यामि तान्निबोध शचीपते\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2203104, "chapter_id": 5326, "verse_number": "५९", "content_sanskrit": "भानुमाननिलश्चैव हव्यवाहश्च वासव ।\nलोकानां मातरश्चैव गावः सृष्टाः स्वयम्भुवा\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2203105, "chapter_id": 5326, "verse_number": "६०", "content_sanskrit": "लोकांस्तारयितुं शक्ता मर्त्येष्वेतेषु देवताः ।\nसर्वे भवन्तः शृण्वन्तु एकैकं धर्मनिश्चयम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2203106, "chapter_id": 5326, "verse_number": "६१", "content_sanskrit": "वर्षाणि षडशीतिं तु दुर्वृत्ताः कुलपांसनाः ।\nस्त्रियः सर्वाश्च दुर्वृत्ताः प्रतिमेहन्ति या रविम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2203107, "chapter_id": 5326, "verse_number": "६२", "content_sanskrit": "अनिलद्वेषिणः शक्र गर्भस्था च्यवते प्रजा ।\nहव्यवाहस्य दीप्तस्य समिधं ये न जुह्वति ।\nअग्निकार्येषु वै तेषां हव्यं नाश्नाति पावकः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2203108, "chapter_id": 5326, "verse_number": "६३", "content_sanskrit": "क्षीरं तु बालवत्सानां ये पिबन्तीह मानवाः ।\nन तेषां क्षीरपाः केचिज्जायन्ते कुलवर्धनाः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2203109, "chapter_id": 5326, "verse_number": "६४", "content_sanskrit": "प्रजाक्षयेण युज्यन्ते कुलवंशक्षयेण च ।\nएवमेतत् पुरा दृष्टं कुलवृद्धैर्द्विजातिभिः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2203110, "chapter_id": 5326, "verse_number": "६५", "content_sanskrit": "तस्माद् वर्ज्यानि वर्ज्यानि कार्यं कार्यं च नित्यशः ।\nभूतिकामेन मर्त्येन सत्यमेतद् ब्रवीमि ते\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2203111, "chapter_id": 5326, "verse_number": "६६", "content_sanskrit": "ततः सर्वे महाभाग देवताः समरुद्गणाः ।\nऋषयश्च महाभागाः पृच्छन्ति स्म पितॄंस्ततः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2203112, "chapter_id": 5326, "verse_number": "६७", "content_sanskrit": "पितरः केन तुष्यन्ति मर्त्यानामल्पचेतसाम् ।\nअक्षयं च कथं दानं भवेच्चैवौर्ध्वदेहिकम्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2203113, "chapter_id": 5326, "verse_number": "६८", "content_sanskrit": "आनृण्यं वा कथं मर्त्या गच्छेयुः केन कर्मणा ।\nएतदिच्छामहे श्रोतुं परं कौतूहलं हि नः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2203114, "chapter_id": 5326, "verse_number": "", "content_sanskrit": "पितरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2203115, "chapter_id": 5326, "verse_number": "६९", "content_sanskrit": "न्यायतो वै महाभागाः संशयः समुदाहृतः ।\nश्रूयतां येन तुष्यामो मर्त्यानां साधुकर्मणाम्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2203116, "chapter_id": 5326, "verse_number": "७०", "content_sanskrit": "नीलषण्डप्रमोक्षेण अमावास्यां तिलोदकैः ।\nवर्षासु दीपकैश्चैव पितॄणामनृणो भवेत्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2203117, "chapter_id": 5326, "verse_number": "७१", "content_sanskrit": "अक्षयं निर्व्यलीकं च दानमेतन्महाफलम् ।\nअस्माकं परितोषश्च अक्षयः परिकीर्त्यते\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2203118, "chapter_id": 5326, "verse_number": "७२", "content_sanskrit": "श्रद्धधानाश्च ये मर्त्या आहरिष्यन्ति सन्ततिम् ।\nदुर्गात् ते तारयिष्यन्ति नरकात् प्रपितामहान्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2203119, "chapter_id": 5326, "verse_number": "७३", "content_sanskrit": "पितॄणां भाषितं श्रुत्वा हृष्टरोमा तपोधनः ।\nवृद्धगार्ग्यो महातेजास्तानेवं वाक्यमब्रवीत्\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2203120, "chapter_id": 5326, "verse_number": "७४", "content_sanskrit": "के गुणा नीलषण्डस्य प्रमुक्तस्य तपोधनाः ।\nवर्षासु दीपदानेन तथैव च तिलोदकैः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2203121, "chapter_id": 5326, "verse_number": "", "content_sanskrit": "पितरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2203122, "chapter_id": 5326, "verse_number": "७५", "content_sanskrit": "नीलषण्डस्य लाङ्गूलं तोयमभ्युद्धरेद् यदि ।\nषष्टि वर्षसहस्राणि पितरस्तेन तर्पिताः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2203123, "chapter_id": 5326, "verse_number": "७६", "content_sanskrit": "यस्तु शृङ्गगतं पङ्क्तं कूलादुद्धृत्य तिष्ठति ।\nपितरस्तेन गच्छन्ति सोमलोकमसंशयम्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2203124, "chapter_id": 5326, "verse_number": "७७", "content_sanskrit": "वर्षासु दीपदानेन शशिवच्छोभते नरः ।\nतमोरूपं न तस्यास्ति दीपकं यः प्रयच्छति\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2203125, "chapter_id": 5326, "verse_number": "७८", "content_sanskrit": "अमावास्यां तु ये मर्त्याः प्रयच्छन्ति तिलोदकम् ।\nपात्रमौदुम्बरं गृह्य मधुमिश्रं तपोधन ।\nकृतं भवति तैः श्राद्धं सरहस्यं यथार्थवत्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2203126, "chapter_id": 5326, "verse_number": "७९", "content_sanskrit": "हृष्टपुष्टमनास्तेषां प्रजा भवति नित्यदा ।\nकुलवंशस्य वृद्धिस्तु पिण्डदस्य फलं भवेत् ।\nश्रद्दधानस्तु यः कुर्यात् पितॄणामनृणो भवेत्\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2203127, "chapter_id": 5326, "verse_number": "८०", "content_sanskrit": "एवमेव समुद्दिष्टः श्राद्धकालक्रमस्तथा ।\nविधिः पात्रं फलं चैव यथावदनुकीर्तितम् \t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2203128, "chapter_id": 5326, "verse_number": "", "content_sanskrit": "॥इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे श्राद्धरहस्यकथनं नाम सप्तसप्तत्युत्तरशततमोऽध्यायः ॥१७७॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]