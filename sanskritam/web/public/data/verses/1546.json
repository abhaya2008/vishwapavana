[{"id": 2025411, "chapter_id": 1546, "verse_number": "३-१८४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2025412, "chapter_id": 1546, "verse_number": "३-१८४-१", "content_sanskrit": "निदाघान्तकरः कालः सर्वभूतसुखावहः।\nतत्रैव वसतां तेषां प्रावृट् समभिपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2025413, "chapter_id": 1546, "verse_number": "३-१८४-२", "content_sanskrit": "छादयन्तो महाघोषाः स्वं दिशश्च बलाहकाः।\nप्रववर्षुर्दिवारात्रमसिताः सततं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2025414, "chapter_id": 1546, "verse_number": "३-१८४-३", "content_sanskrit": "तपात्ययनिकेताश्च शतशोऽथ सहस्रशः।\nअपेतार्कप्रभाजालाः सविद्युन्मण्डप्रभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2025415, "chapter_id": 1546, "verse_number": "३-१८४-४", "content_sanskrit": "विरूढशष्पा धरणी मत्तदंशसरीसृपा।\nबभूव पयसा सिक्ता शान्तधूमरजोगणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2025416, "chapter_id": 1546, "verse_number": "३-१८४-५", "content_sanskrit": "न स्म प्रज्ञायते किंचिदम्भसा समवस्तृते।\nसमं वा विषमं वाऽपि नद्यो वा स्तावराणि वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2025417, "chapter_id": 1546, "verse_number": "३-१८४-६", "content_sanskrit": "क्षुब्धतोया महावेगाः श्वसमाना इवाशुगाः।\nसिन्धवः शोभयांचक्रुः काननानि तपात्यये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2025418, "chapter_id": 1546, "verse_number": "३-१८४-७", "content_sanskrit": "नदतां काननान्तेषु श्रूयन्ते विविधाः स्वनाः।\nवृष्टिभिस्ताड्यमानानां वराहमृगपक्षिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2025419, "chapter_id": 1546, "verse_number": "३-१८४-८", "content_sanskrit": "स्तोककाः शिखिनश्चैव पुंस्कोकिलगणैः सह।\nमत्ताः परिपतन्ति स्म दर्दुरश्चैव दर्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2025420, "chapter_id": 1546, "verse_number": "३-१८४-९", "content_sanskrit": "तदा बहुविधाकारा प्रावृण्मेघानुनादिता।\nअभ्यतीता शिवा तेषां चरतां मरुधन्वसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2025421, "chapter_id": 1546, "verse_number": "३-१८४-१०", "content_sanskrit": "क्रौञ्चहंससमाकीर्णा शरत्प्रमुदीताऽभवत्।\nरूढकक्षवनप्रस्था प्रसन्नजलनिम्नगा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2025422, "chapter_id": 1546, "verse_number": "३-१८४-११", "content_sanskrit": "विमलाकाशनक्षत्रा शरत्तेषां शिवाऽभषत्।\nमृगद्विजसमाकीर्णा पाण्डवानां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2025423, "chapter_id": 1546, "verse_number": "३-१८४-१२", "content_sanskrit": "दृश्यन्ते शान्तरजसः क्षपाजलदशीतलाः।\nग्रहनक्षत्रसङ्घैश्च सोमेन च विराजिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2025424, "chapter_id": 1546, "verse_number": "३-१८४-१३", "content_sanskrit": "कुमुदैः पुण्डरीकैश्च शीतवारिधराः शिवाः।\nनदीः पुष्करिणीश्चैव ददृशुः समलंकृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2025425, "chapter_id": 1546, "verse_number": "३-१८४-१५", "content_sanskrit": "ते वै मुमुदिरे वीराः प्रसन्नसलिलां शिवाम्।\nपश्यन्तो दृढधन्वानः परिपूर्णां सरस्वतीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2025426, "chapter_id": 1546, "verse_number": "३-१८४-१६", "content_sanskrit": "तेषां पुण्यतमा रात्रिः पर्वसन्धौ स्म शारदी।\nतत्रैव वसतामासीत्कार्तिकी जनमेजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2025427, "chapter_id": 1546, "verse_number": "३-१८४-१७", "content_sanskrit": "पुण्यकृद्भिर्महासत्वैस्तापसैः सह पाण्डवाः।\nतत्सर्वं भरतश्रेष्ठ समूहुर्योगमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2025428, "chapter_id": 1546, "verse_number": "३-१८४-१८", "content_sanskrit": "तमिस्राभ्युदये तस्मिन्धौम्येन सह पाण्डवाः।\nसूतैः पौरोगवैः साकं काम्यकं प्रययुर्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2025429, "chapter_id": 1546, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि चतुरशीत्यधिकशततमोऽध्यायः ॥ १८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]