[{"id": 40014635, "chapter_id": 9205, "verse_number": "1", "content_sanskrit": "इत्युक्त्वापरुषंवाक्यंरावणंरावणानुजः । आजगाममुहूर्तेनयत्ररामस्सलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40014636, "chapter_id": 9205, "verse_number": "2", "content_sanskrit": "तंमेरुशिखराकारंदीप्तामिवशतह्रदाम् । गगनस्थंमहीस्थास्तेददृशुसर्ववानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40014637, "chapter_id": 9205, "verse_number": "3", "content_sanskrit": "येचाप्यनुचरास्तस्य चत्वारो भीमविक्रमा: । तेsपि सर्वायुधोपेता भूषणैश्चापि भूषिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40014638, "chapter_id": 9205, "verse_number": "4", "content_sanskrit": "स च मेघाचलप्रख्यो वज्रायुधसमप्रभः । वरायुधधरो वीरो दिव्याभरणभूषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40014639, "chapter_id": 9205, "verse_number": "5", "content_sanskrit": "तमात्मपञ्चमंदृष्टवासुग्रीवोवाहिनीपति: । वानरैस्सहदुर्धर्षचिन्तयामासबुद्धिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40014640, "chapter_id": 9205, "verse_number": "6", "content_sanskrit": "चिन्तयित्वामुहूर्तंतुवानरांस्तानुवाचह । हनुमत्प्रमुखान्सर्वानिदंवचनमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40014641, "chapter_id": 9205, "verse_number": "7", "content_sanskrit": "एषसर्वायुधोपेतश्चतुर्भिस्सहराक्षसैः । राक्षसोऽभ्येतिपश्यध्वमस्मान्हन्तुंनसंशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40014642, "chapter_id": 9205, "verse_number": "8", "content_sanskrit": "सुग्रीवस्यवचश्रुत्वासर्वेतेवानरोत्तमाः । सालानुद्यम्यशैलांश्चइदंवचनमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40014643, "chapter_id": 9205, "verse_number": "9", "content_sanskrit": "शीघ्रंव्यादिशनोराजन्वधायैषांदुरात्मनाम् । निपतन्तुहताश्चैतेधरण्यामल्पतेजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40014644, "chapter_id": 9205, "verse_number": "10", "content_sanskrit": "तेषासम्भाषमाणानामन्योन्यंसविभीषणः । उत्तरंतीरमासाद्यखस्थएवव्यतिष्ठत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40014645, "chapter_id": 9205, "verse_number": "11", "content_sanskrit": "उवाचमहाप्राज्ञस्स्वरेणमहतामहान् । सुग्रीवंतांश्चसम्प्रेक्ष्यसर्वान्वानरयूथपान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40014646, "chapter_id": 9205, "verse_number": "12", "content_sanskrit": "रावणोनामदुर्वृत्तोराक्षसोराक्षसेश्वरः । तस्याहमनुजोभ्राताविभीषणइतिश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40014647, "chapter_id": 9205, "verse_number": "13", "content_sanskrit": "तेनसीताजनस्थानाद्धृताहत्वाजटायुषम् । रुद्दाचविवशादीनाराक्षसीभिस्सुरक्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40014648, "chapter_id": 9205, "verse_number": "14", "content_sanskrit": "तमहंहेतुभिर्वाक्यैर्विविधैश्चन्यदर्शयम् । साधुनिर्यात्यतांसीतारामायेतिपुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40014649, "chapter_id": 9205, "verse_number": "15", "content_sanskrit": "सचनप्रतिजग्राहरावणःकालचोदितः । उच्यमानंहितंवाक्यंविपरीतइवौषधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40014650, "chapter_id": 9205, "verse_number": "16", "content_sanskrit": "सोऽहंपरुषितस्तेनदासवच्चावमानितः । त्यक्त्वापुत्रांश्चदारांश्चराघवंशरणंगतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40014651, "chapter_id": 9205, "verse_number": "17", "content_sanskrit": "सर्वलोकशरण्यायराघवायमहात्मने । निवेदयतमांक्षिप्रंविभीषणमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40014652, "chapter_id": 9205, "verse_number": "18", "content_sanskrit": "एतत्तुवचनंश्रुत्वासुग्रीवोलघुविक्रमः । लक्ष्मणस्याग्रतोरामंसम्रब्धमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40014653, "chapter_id": 9205, "verse_number": "19", "content_sanskrit": "रावणस्यानुजोभ्राताविभीषणइतिश्रुतः । चतुर्भिस्सहरक्षोभिर्भवन्तंशरणंगतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40014654, "chapter_id": 9205, "verse_number": "20", "content_sanskrit": "मन्त्रेव्यूहेनयेचारेयुक्तोभवितुमर्हसि । वानराणांचभद्रंतेपरेषांचपरन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40014655, "chapter_id": 9205, "verse_number": "21", "content_sanskrit": "अन्तर्धानगताह्येतेराक्षसाःकामरूपिणः । शूराश्चनिकृतिज्ञाश्चतेषांजातुनविश्वसेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40014656, "chapter_id": 9205, "verse_number": "22", "content_sanskrit": "प्रणिधीराक्षसेन्द्रस्यरावणस्यभवेदयम् । अनुप्रविश्यसोऽस्मासुभेदंकुर्यान्नसंशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40014657, "chapter_id": 9205, "verse_number": "23", "content_sanskrit": "अथवास्वयमेवैषछिद्रमासाद्यबुद्धिमान् । अनुप्रविश्यविश्वस्तेकदाचित्प्रहरेदपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40014658, "chapter_id": 9205, "verse_number": "24", "content_sanskrit": "मित्राटवीबलंचैवमौलभृत्यबलंतथा । सर्वमेतद्बलंग्राह्यंवर्जयित्वाद्विषद्बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40014659, "chapter_id": 9205, "verse_number": "25", "content_sanskrit": "प्रकृत्याराक्षसेन्द्रस्यभ्राताऽमित्रस्यतेप्रभो: । आगतश्चरिपोस्साक्षात्कथमस्मिन्हिविश्वसेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40014660, "chapter_id": 9205, "verse_number": "26", "content_sanskrit": "रावणेनप्रणिहितंतमवेहिविभीषणम् । तस्याहंनिग्रहंमन्येक्षमंक्षमवतांवर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40014661, "chapter_id": 9205, "verse_number": "27", "content_sanskrit": "राक्षसोजिह्मयाबुद्ध्यासंदिष्टोऽयमुपागतः । प्रहर्तुंमाययाच्छन्नोविश्वस्तेत्वयिराघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40014662, "chapter_id": 9205, "verse_number": "28", "content_sanskrit": "प्रविष्टश्शत्रुसैन्यंहिप्राप्तश्शत्रुरतर्कितः । निहन्यादन्तरंलब्ध्वाउलूकवायसानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40014663, "chapter_id": 9205, "verse_number": "29", "content_sanskrit": "वध्यतामेषतीव्रेणदण्डेनसचिवैस्सह । रावणस्यनृशंसस्यभ्राताह्येषविभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40014664, "chapter_id": 9205, "verse_number": "30", "content_sanskrit": "एवमुक्त्वातुतंरामंसम्रब्धोवाहिनीपतिः । वाक्यज्ञोवाक्यकुशलंततोमौनमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40014665, "chapter_id": 9205, "verse_number": "31", "content_sanskrit": "सुग्रीवस्यतुतद्वाक्यंश्रुत्वारामोमहायशाः । समीपस्थानुवाचेदंहनुमत्प्रमुखान्हरीन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40014666, "chapter_id": 9205, "verse_number": "32", "content_sanskrit": "यदुक्तंकपिराजेनरावणावरजंप्रति । वाक्यंहेतुमदत्यर्थंचभवद्भिरपितच्छ्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40014667, "chapter_id": 9205, "verse_number": "33", "content_sanskrit": "सुहृदामर्थकृच्छेषुयुक्तंबुद्धिमतासदा । समर्थेनोपनिर्देष्टुंशाश्वतींभूतिमिच्छता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40014668, "chapter_id": 9205, "verse_number": "34", "content_sanskrit": "इत्येवंपरिपृष्टास्तेस्वंस्वंमतमतन्द्रिताः । सोपचारंतदाराममूचुर्हितचिकीर्षवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40014669, "chapter_id": 9205, "verse_number": "35", "content_sanskrit": "अज्ञातंनास्तितेकिंचित्त्रिषुलोकेषुराघव: । आत्मानंसूचयन्राम: पृच्छस्यस्मान् सुहृत्तया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40014670, "chapter_id": 9205, "verse_number": "36", "content_sanskrit": "त्वंहिसत्यव्रतश्शूरोधार्मिकोदृढविक्रमः । परीक्ष्यकारीस्मृतिमान्निसृष्टात्मासुहृत्सुच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40014671, "chapter_id": 9205, "verse_number": "37", "content_sanskrit": "तस्मादेकैकशस्तावद्ब्रुवन्तुसचिवास्तव । हेतुतोमतिसम्पन्नास्समर्थाश्चपुन: पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40014672, "chapter_id": 9205, "verse_number": "38", "content_sanskrit": "इत्युक्तेराघवायाऽथमतिमानङ्गदोऽग्रतः । विभीषणपरीक्षार्थमुवाचवचनंहरिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40014673, "chapter_id": 9205, "verse_number": "39", "content_sanskrit": "शत्रोस्सकाशात्सम्प्राप्तस्सर्वथाशङ् क्यएवहि । विश्वासयोग्यस्सहसानकर्तव्योविभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40014674, "chapter_id": 9205, "verse_number": "40", "content_sanskrit": "छादयित्वाऽत्मभावंहिचरन्तिशठबुद्धयः । प्रहरन्तिचरन्ध्रेषुसोऽनर्थस्सुमहान्भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40014675, "chapter_id": 9205, "verse_number": "41", "content_sanskrit": "अर्थानर्थौविनिश्चित्यव्यवसायंभजेतह । गुणतस्सङ्ग्रहंकुर्याद्दोषतस्तुविसर्जयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40014676, "chapter_id": 9205, "verse_number": "42", "content_sanskrit": "यदिदोषोमहांस्तस्मिंस्त्यज्वतामविशङ्कितम् । गुणान्वापिबहून् ज्ञात्वासङ्ग्रहःक्रियतांनृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40014677, "chapter_id": 9205, "verse_number": "43", "content_sanskrit": "शरभस्त्वथनिश्चित्यसार्थंवचनमब्रवीत् । क्षिप्रमस्मिन्नरव्याघ्र चारःप्रतिविधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40014678, "chapter_id": 9205, "verse_number": "44", "content_sanskrit": "प्रणिधायहिचारेणयथावत्सूक्ष्मबुद्धिना । परीक्ष्यचततःकार्योयथान्यायंपरिग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40014679, "chapter_id": 9205, "verse_number": "45", "content_sanskrit": "जाम्बवांस्त्वथसम्प्रेक्ष्यशास्त्रबुध्याविचक्षणः । वाक्यंविज्ञापयामासगुणवद्दोषवर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40014680, "chapter_id": 9205, "verse_number": "46", "content_sanskrit": "बद्धवैराच्चपापाच्चराक्षेसेन्द्राद्विभीषणः । अदेशकालेसम्प्राप्तस्सर्वथाशङ् क्यतामयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40014681, "chapter_id": 9205, "verse_number": "47", "content_sanskrit": "ततोमैन्दस्तुसम्प्रेक्ष्यनयापनयकोविदः । वाक्यंवचनसम्पन्नोबभाषेहेतुमत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40014682, "chapter_id": 9205, "verse_number": "48", "content_sanskrit": "वजनंनामतस्यैषरावणस्यविभीषणः । पृच्छयतांमधुरेणायंशनैर्नरपतीश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40014683, "chapter_id": 9205, "verse_number": "49", "content_sanskrit": "भावमस्यतुविज्ञायतत्त्वतस्त्वंकरिष्यसि । यदिदुष्टोनदुष्टोवाबुद्धिपूर्वंनरर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40014684, "chapter_id": 9205, "verse_number": "50", "content_sanskrit": "अथसंस्कारसम्पन्नोहनुमान् सचिवोत्तमः । उवाचवचनंश्लक्ष्णमर्थवन्मधुरंलघु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 40014685, "chapter_id": 9205, "verse_number": "51", "content_sanskrit": "नभवन्तंमतिश्रेष्ठंसमर्थंवदतांवरम् । अतिशाययितुंशक्तोबृहस्पतिरपिब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 40014686, "chapter_id": 9205, "verse_number": "52", "content_sanskrit": "नवादान्नपिसङ्घर्षान्नाधिक्यान्नचकामतः । वक्ष्यामिवचनंराजन्यथार्थंरामगौरवात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 40014687, "chapter_id": 9205, "verse_number": "53", "content_sanskrit": "अर्थानर्थनिमित्तंहियदुक्तंसचिवैस्तव । तत्रदोषंप्रपश्यामिक्रियानह्युपपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 40014688, "chapter_id": 9205, "verse_number": "54", "content_sanskrit": "ऋतेनियोगात्सामर्थ्यमवबोद्धुंनशक्यते । सहसाविनियोगोहिदोषवान्प्रतिभातिमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 40014689, "chapter_id": 9205, "verse_number": "55", "content_sanskrit": "चारप्रणिहितंयुक्तंयदुक्तंसचिवैस्तव । अर्थस्यासम्भवात्तत्रकारणंनोपयुज्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 40014690, "chapter_id": 9205, "verse_number": "56", "content_sanskrit": "अदेशकालेसम्प्राप्तइत्ययंयद्विभीषणः । विवक्षातत्रमेऽस्तीयंतांनिबोधयथामति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 40014691, "chapter_id": 9205, "verse_number": "57", "content_sanskrit": "सएषदेश: कालश्चभवतीतियथातथा । पुरुषात्पुरुषंप्राप्यतथादोषगुणावपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 40014692, "chapter_id": 9205, "verse_number": "58", "content_sanskrit": "त्म्यंरावणेदृष्टवाविक्रमंचतथात्वयि । युक्तमागमनंह्यत्रसदृशंतस्यबुद्धितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 40014693, "chapter_id": 9205, "verse_number": "59", "content_sanskrit": "अज्ञातरूपैःपुरुषैस्सराजन्पृच्छ् यतामिति । यदुक्तमत्रमेप्रेक्षाकाचिदस्तिसमीक्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 40014694, "chapter_id": 9205, "verse_number": "60", "content_sanskrit": "पृच्छयमानोविशङ्केतसहसाबुद्धिमान्वचः । तत्रमित्रंप्रदुष्येतमिथ्यापृष्टंसुखागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 40014695, "chapter_id": 9205, "verse_number": "61", "content_sanskrit": "अशक्यस्सहसाराजन्भावोबोद्धुंपरस्यवै । अन्तस्स्वभावैर्गीतैस्तैर्नैपुण्यंपश्यतांभृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 40014696, "chapter_id": 9205, "verse_number": "62", "content_sanskrit": "नत्वस्यब्रुवतोजातुलक्ष्यतेदुष्टभावता । प्रसन्नंवदनंचापितस्मान्मेनास्तिसंशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 40014697, "chapter_id": 9205, "verse_number": "63", "content_sanskrit": "अशङ्कितमतिस्स्वस्थोनशठःपरिसर्पति । नचास्यदुष्टावाक्चापितस्मान्नास्तीहसंशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 40014698, "chapter_id": 9205, "verse_number": "64", "content_sanskrit": "आकारश्चाद्यमानोऽपिनशक्योविनिगूहितम् । बलाद्धिविवृणोत्येवभावमन्तर्गतंनृणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]