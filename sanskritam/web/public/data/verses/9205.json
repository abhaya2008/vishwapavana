[{"id": 5000205000, "chapter_id": 9205, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे नवमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000205001, "chapter_id": 9205, "verse_number": "३-९-१", "content_sanskrit": "सुतीक्ष्णेनाभ्यनुज्ञातं प्रस्थितं रघुनन्दनम्।\nहृद्यया स्निग्धया वाचा भर्तारमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000205002, "chapter_id": 9205, "verse_number": "३-९-२", "content_sanskrit": "अधर्मं तु सुसूक्ष्मेण विधिना प्राप्यते महान्।\nनिवृत्तेन च शक्योऽयं व्यसनात् कामजादिह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000205003, "chapter_id": 9205, "verse_number": "३-९-३", "content_sanskrit": "त्रीण्येव व्यसनान्यत्र कामजानि भवन्त्युत।\nमिथ्यावाक्यं तु परमं तस्माद् गुरुतरावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000205004, "chapter_id": 9205, "verse_number": "३-९-४", "content_sanskrit": "परदाराभिगमनं विना वैरं च रौद्रता।\nमिथ्यावाक्यं न ते भूतं न भविष्यति राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000205005, "chapter_id": 9205, "verse_number": "३-९-५", "content_sanskrit": "कुतोऽभिलषणं स्त्रीणां परेषां धर्मनाशनम्।\nतव नास्ति मनुष्येन्द्र न चाभूत् ते कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000205006, "chapter_id": 9205, "verse_number": "३-९-६", "content_sanskrit": "मनस्यपि तथा राम न चैतद् विद्यते क्वचित्।\nस्वदारनिरतश्चैव नित्यमेव नृपात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000205007, "chapter_id": 9205, "verse_number": "३-९-७", "content_sanskrit": "धर्मिष्ठः सत्यसंधश्च पितुर्निर्देशकारकः।\nत्वयि धर्मश्च सत्यं च त्वयि सर्वं प्रतिष्ठितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000205008, "chapter_id": 9205, "verse_number": "३-९-८", "content_sanskrit": "तच्च सर्वं महाबाहो शक्यं वोढुं जितेन्द्रियैः।\nतव वश्येन्द्रियत्वं च जानामि शुभदर्शन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000205009, "chapter_id": 9205, "verse_number": "३-९-९", "content_sanskrit": "तृतीयं यदिदं रौद्रं परप्राणाभिहिंसनम्।\nनिर्वैरं क्रियते मोहात् तच्च ते समुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000205010, "chapter_id": 9205, "verse_number": "३-९-१०", "content_sanskrit": "प्रतिज्ञातस्त्वया वीर दण्डकारण्यवासिनाम्।\nऋषीणां रक्षणार्थाय वधः संयति रक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000205011, "chapter_id": 9205, "verse_number": "३-९-११", "content_sanskrit": "एतन्निमित्तं च वनं दण्डका इति विश्रुतम्।\nप्रस्थितस्त्वं सह भ्रात्रा धृतबाणशरासनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000205012, "chapter_id": 9205, "verse_number": "३-९-१२", "content_sanskrit": "ततस्त्वां प्रस्थितं दृष्ट्वा मम चिन्ताकुलं मनः।\nत्वद‍्धृत्तं चिन्तयन्त्या वै भवेन्निःश्रेयसं हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000205013, "chapter_id": 9205, "verse_number": "३-९-१३", "content_sanskrit": "नहि मे रोचते वीर गमनं दण्डकान् प्रति।\nकारणं तत्र वक्ष्यामि वदन्त्याः श्रूयतां मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000205014, "chapter_id": 9205, "verse_number": "३-९-१४", "content_sanskrit": "त्वं हि बाणधनुष्पाणिर्भ्रात्रा सह वनं गतः।\nदृष्ट्वा वनचरान् सर्वान् कच्चित् कुर्याः शरव्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000205015, "chapter_id": 9205, "verse_number": "३-९-१५", "content_sanskrit": "क्षत्रियाणामिह धनुर्हुताशस्येन्धनानि च।\nसमीपतः स्थितं तेजोबलमुच्छ्रयते भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000205016, "chapter_id": 9205, "verse_number": "३-९-१६", "content_sanskrit": "पुरा किल महाबाहो तपस्वी सत्यवान् शुचिः।\nकस्मिंश्चिदभवत् पुण्ये वने रतमृगद्विजे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000205017, "chapter_id": 9205, "verse_number": "३-९-१७", "content_sanskrit": "तस्यैव तपसो विघ्नं कर्तुमिन्द्रः शचीपतिः।\nखड्गपाणिरथागच्छदाश्रमं भटरूपधृक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000205018, "chapter_id": 9205, "verse_number": "३-९-१८", "content_sanskrit": "तस्मिंस्तदाश्रमपदे निहितः खड्ग उत्तमः।\nस न्यासविधिना दत्तः पुण्ये तपसि तिष्ठतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000205019, "chapter_id": 9205, "verse_number": "३-९-१९", "content_sanskrit": "स तच्छस्त्रमनुप्राप्य न्यासरक्षणतत्परः।\nवने तु विचरत्येव रक्षन् प्रत्ययमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000205020, "chapter_id": 9205, "verse_number": "३-९-२०", "content_sanskrit": "यत्र गच्छत्युपादातुं मूलानि च फलानि च।\nन विना याति तं खड्गं न्यासरक्षणतत्परः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000205021, "chapter_id": 9205, "verse_number": "३-९-२१", "content_sanskrit": "नित्यं शस्त्रं परिवहन् क्रमेण स तपोधनः।\nचकार रौद्रीं स्वां बुद्धिं त्यक्त्वा तपसि निश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000205022, "chapter_id": 9205, "verse_number": "३-९-२२", "content_sanskrit": "ततः स रौद्राभिरतः प्रमत्तोऽधर्मकर्षितः।\nतस्य शस्त्रस्य संवासाज्जगाम नरकं मुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000205023, "chapter_id": 9205, "verse_number": "३-९-२३", "content_sanskrit": "एवमेतत् पुरावृत्तं शस्त्रसंयोगकारणम्।\nअग्निसंयोगवद्धेतुः शस्त्रसंयोग उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000205024, "chapter_id": 9205, "verse_number": "३-९-२४", "content_sanskrit": "स्नेहाच्च बहुमानाच्च स्मारये त्वां तु शिक्षये।\nन कथंचन सा कार्या गृहीतधनुषा त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000205025, "chapter_id": 9205, "verse_number": "३-९-२५", "content_sanskrit": "बुद्धिर्वैरं विना हन्तुं राक्षसान् दण्डकाश्रितान्।\nअपराधं विना हन्तुं लोको वीर न मंस्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000205026, "chapter_id": 9205, "verse_number": "३-९-२६", "content_sanskrit": "क्षत्रियाणां तु वीराणां वनेषु नियतात्मनाम्।\nधनुषा कार्यमेतावदार्तानामभिरक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000205027, "chapter_id": 9205, "verse_number": "३-९-२७", "content_sanskrit": "क्व च शस्त्रं क्व च वनं क्व च क्षात्रं तपः क्व च।\nव्याविद्धमिदमस्माभिर्देशधर्मस्तु पूज्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000205028, "chapter_id": 9205, "verse_number": "३-९-२८", "content_sanskrit": "कदर्यकलुषा बुद्धिर्जायते शस्त्रसेवनात्।\nपुनर्गत्वा त्वयोध्यायां क्षत्रधर्मं चरिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000205029, "chapter_id": 9205, "verse_number": "३-९-२९", "content_sanskrit": "अक्षया तु भवेत् प्रीतिः श्वश्रूश्वशुरयोर्मम।\nयदि राज्यं हि संन्यस्य भवेस्त्वं निरतो मुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000205030, "chapter_id": 9205, "verse_number": "३-९-३०", "content_sanskrit": "धर्मादर्थः प्रभवति धर्मात् प्रभवते सुखम्।\nधर्मेण लभते सर्वं धर्मसारमिदं जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000205031, "chapter_id": 9205, "verse_number": "३-९-३१", "content_sanskrit": "आत्मानं नियमैस्तैस्तैः कर्षयित्वा प्रयत्नतः।\nप्राप्तये निपुणैर्धर्मो न सुखाल्लभते सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000205032, "chapter_id": 9205, "verse_number": "३-९-३२", "content_sanskrit": "नित्यं शुचिमतिः सौम्य चर धर्मं तपोवने।\nसर्वं तु विदितं तुभ्यं त्रैलोक्यामपि तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000205033, "chapter_id": 9205, "verse_number": "३-९-३३", "content_sanskrit": "स्त्रीचापलादेतदुपाहृतं मे\nधर्मं च वक्तुं तव कः समर्थः।\nविचार्य बुद्ध्या तु सहानुजेन\nयद् रोचते तत् कुरु माचिरेण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000205034, "chapter_id": 9205, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे नवमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]