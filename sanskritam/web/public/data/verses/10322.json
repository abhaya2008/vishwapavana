[{"id": 6000322000, "chapter_id": 10322, "verse_number": null, "content_sanskrit": "अथ एकविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000322001, "chapter_id": 10322, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.001.m4a", "display_order": 2}, {"id": 6000322002, "chapter_id": 10322, "verse_number": "११-२१-१", "content_sanskrit": "य एतां मत्पथो हित्वा भक्तिज्ञानक्रियात्मकान्।\nक्षुद्रान् कामान् खलैः प्राणैर्जुषन्तः संसरन्ति ते॥ ११/२१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.002.m4a", "display_order": 3, "topics": [{"text": "कामिनां द्रव्यदेशादिगुणदोषवर्णनम्", "range": "१–४४"}]}, {"id": 6000322003, "chapter_id": 10322, "verse_number": "११-२१-२", "content_sanskrit": "स्वे स्वेऽधिकारे या निष्ठा स गुणः परिकीर्तितः।\nविपर्ययस्तु दोषः स्यादुभयोरेष निश्चयः॥ ११/२१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.003.m4a", "display_order": 4}, {"id": 6000322004, "chapter_id": 10322, "verse_number": "११-२१-३", "content_sanskrit": "शुद्ध्यशुद्धी विधीयेते समानेष्वपि वस्तुषु।\nद्रव्यस्य विचिकित्सार्थं गुणदोषौ शुभाशुभौ॥ ११/२१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.004.m4a", "display_order": 5}, {"id": 6000322005, "chapter_id": 10322, "verse_number": "११-२१-४", "content_sanskrit": "धर्मार्थं व्यवहारार्थं यात्रार्थमिति वाऽनघ।\nदर्शितोऽयं मयाऽऽचारो धर्म्यमुद्वहता धुरम्॥ ११/२१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.005.m4a", "display_order": 6}, {"id": 6000322006, "chapter_id": 10322, "verse_number": "११-२१-५", "content_sanskrit": "भूम्यम्ब्वग्न्यनिलाकाशा भूतानां पञ्च धातवः।\nआब्रह्मस्थावरादीनां शरीरा आत्मसंयुताः॥ ११/२१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.006.m4a", "display_order": 7}, {"id": 6000322007, "chapter_id": 10322, "verse_number": "११-२१-६", "content_sanskrit": "भेदेन नामरूपाणि विषमाणि समेष्वपि।\nधातुशुद्ध्यै विकल्प्यन्त एतेषां स्वार्थसिद्धये॥ ११/२१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.007.m4a", "display_order": 8}, {"id": 6000322008, "chapter_id": 10322, "verse_number": "११-२१-७", "content_sanskrit": "देशकालादिभावानां वचनान्मम सत्तम।\nगुणदोषौ विधीयेते नियमार्थं हि कर्मणाम्॥ ११/२१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.008.m4a", "display_order": 9}, {"id": 6000322009, "chapter_id": 10322, "verse_number": "११-२१-८", "content_sanskrit": "कृष्णसारोऽथ देशानां ब्राह्मणानां शुचिर्भवेत्।\nकृष्णसारोऽप्यसौवीरकीकटासंस्कृतेरिणः॥ ११/२१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.009.m4a", "display_order": 10}, {"id": 6000322010, "chapter_id": 10322, "verse_number": "११-२१-९", "content_sanskrit": "कर्मण्यो गुणवान् कालो द्रव्यतः स्वत एव वा।\nयतो निवर्तते कर्म सदोषोऽकर्मकः स्मृतः॥ ११/२१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.010.m4a", "display_order": 11}, {"id": 6000322011, "chapter_id": 10322, "verse_number": "११-२१-१०", "content_sanskrit": "द्रव्यस्य शद्ध्यशुद्धी च द्रव्येण वचनेन वा।\nसंस्कारेणाथ कालेन महत्त्वाल्पतयाऽथ वा॥ ११/२१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.011.m4a", "display_order": 12}, {"id": 6000322012, "chapter_id": 10322, "verse_number": "११-२१-११", "content_sanskrit": "शक्त्याऽशक्त्या च वाग्बुद्ध्या समृद्ध्या च तथाऽऽत्मनः।\nअन्ये शुद्ध्यन्ति हि तथा देशावस्थानुसारतः॥ ११/२१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.012.m4a", "display_order": 13}, {"id": 6000322013, "chapter_id": 10322, "verse_number": "११-२१-१२", "content_sanskrit": "धान्यदार्वस्थितन्तूनां रसतैजसचर्मणाम्।\nकालवाय्वग्निमृत्तोयैः पार्थिवानां युतायुतैः॥ ११/२१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.013.m4a", "display_order": 14}, {"id": 6000322014, "chapter_id": 10322, "verse_number": "११-२१-१३", "content_sanskrit": "अमेध्यलिप्तं यद् येन गन्धलेपं व्यपोहति।\nभजते प्रकृतिं तस्य तच्छौचमुपदिश्यते॥ ११/२१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.014.m4a", "display_order": 15}, {"id": 6000322015, "chapter_id": 10322, "verse_number": "११-२१-१४", "content_sanskrit": "स्नानदानतपोवस्थावीर्यसंस्कारकर्मभिः।\nमदभ्यासान्मनःशौचं कृत्वा कर्माचरेद् बुधः॥ ११/२१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.015.m4a", "display_order": 16}, {"id": 6000322016, "chapter_id": 10322, "verse_number": "११-२१-१५", "content_sanskrit": "मन्त्रस्य च परिज्ञानं कर्मशुद्धिर्मदर्पणम्।\nधर्मः सम्पाद्यते सद्भिरधर्मस्तु विपर्ययैः॥ ११/२१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.016.m4a", "display_order": 17}, {"id": 6000322017, "chapter_id": 10322, "verse_number": "११-२१-१६", "content_sanskrit": "क्‍वचिद् गुणोऽपि दोषः स्याद् दोषोऽपि विधिना गुणः।\nगुणदोषार्थनियमस्तद्विदामेव बाधते॥ ११/२१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.017.m4a", "display_order": 18}, {"id": 6000322018, "chapter_id": 10322, "verse_number": "११-२१-१७", "content_sanskrit": "समानकर्माचरणेऽपतितानां न पातकम्।\nऔत्पत्तिको गुणैः सङ्गो न शयानः पतत्यधः॥ ११/२१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.018.m4a", "display_order": 19}, {"id": 6000322019, "chapter_id": 10322, "verse_number": "११-२१-१८", "content_sanskrit": "यतो यतो निवर्तेत विमुच्येत ततस्ततः।\nएष धर्मो नृणां क्षेमः शोकमोहभयापहः॥ ११/२१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.019.m4a", "display_order": 20}, {"id": 6000322020, "chapter_id": 10322, "verse_number": "११-२१-१९", "content_sanskrit": "विषयेषु गुणध्यानात् पुंसः सङ्गस्ततो भवेत्।\nसङ्गादेव भवेत् कामः कामादेव कलिर्नृणाम्॥ ११/२१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.020.m4a", "display_order": 21}, {"id": 6000322021, "chapter_id": 10322, "verse_number": "११-२१-२०", "content_sanskrit": "कलेर्दुविषहः क्रोधस्तमस्तदनुवर्तते।\nतमसा ग्रस्यते पुंसश्चेतना व्यापिनी ततः॥ ११/२१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.021.m4a", "display_order": 22}, {"id": 6000322022, "chapter_id": 10322, "verse_number": "११-२१-२१", "content_sanskrit": "तया च रहितः साधो जन्तुः शून्याय कल्पते।\nततोऽस्य स्वार्थविभ्रंशो मूर्च्छितस्य मृतस्य च॥ ११/२१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.022.m4a", "display_order": 23}, {"id": 6000322023, "chapter_id": 10322, "verse_number": "११-२१-२२", "content_sanskrit": "विषयाभिनिवेशेन नात्मानं वेद नापरम्।\nवृक्षजीविकया जीवन् व्यर्थं ग्रस्तवयाः श्वसन्॥ ११/२१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.023.m4a", "display_order": 24}, {"id": 6000322024, "chapter_id": 10322, "verse_number": "११-२१-२३", "content_sanskrit": "फलश्रुतिरियं नॄणां नः श्रेयोरोचनं परम्।\nश्रोतुर्विवक्षया प्रोक्तं यथा भैषज्यरोचनम्॥ ११/२१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.024.m4a", "display_order": 25}, {"id": 6000322025, "chapter_id": 10322, "verse_number": "११-२१-२४", "content_sanskrit": "उत्पत्त्यैव हि कामेषु प्राणेषु स्वजनेषु च।\nआसक्तमनसो मर्त्या आत्मनोऽनर्थहेतुषु॥ ११/२१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.025.m4a", "display_order": 26}, {"id": 6000322026, "chapter_id": 10322, "verse_number": "११-२१-२५", "content_sanskrit": "न तानविदुषः स्वार्थं भ्राम्यतो वृजिनाध्वनि।\nकथं युञ्ज्यात् पुनस्तेषु तांस्तमो विशतो बुधः॥ ११/२१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.026.m4a", "display_order": 27}, {"id": 6000322027, "chapter_id": 10322, "verse_number": "११-२१-२६", "content_sanskrit": "एवं व्यवसितं केचिदविज्ञाय कुबुद्धयः।\nफलश्रुतिं कुसुमितामवेदज्ञा वदन्ति हि॥ ११/२१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.027.m4a", "display_order": 28}, {"id": 6000322028, "chapter_id": 10322, "verse_number": "११-२१-२७", "content_sanskrit": "कामिनः कृपणा लुब्धाः पुष्पेषु पलबुद्धयः।\nअग्निमुग्धा धूमतान्ताः स्वलोकं न विदन्ति ते॥ ११/२१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.028.m4a", "display_order": 29}, {"id": 6000322029, "chapter_id": 10322, "verse_number": "११-२१-२८", "content_sanskrit": "न ते मामङ्ग जानन्ति हृदिस्थं य इदं यतः।\nउक्थशासो ह्यसुतृपो यथा नीहारचक्षुषः॥ ११/२१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.029.m4a", "display_order": 30}, {"id": 6000322030, "chapter_id": 10322, "verse_number": "११-२१-२९", "content_sanskrit": "ते मे मतमविज्ञाय परोक्षविषयात्मकाः।\nहिंसायां यदि कामः स्याद् यज्ञ एव न चोदना॥ ११/२१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.030.m4a", "display_order": 31}, {"id": 6000322031, "chapter_id": 10322, "verse_number": "११-२१-३०", "content_sanskrit": "हिंसाविहारा ह्यालब्धैः पशुभिः स्वसुखेच्छया।\nयजन्ते देवता यज्ञैः पितॄन् भूतपतीन् खलाः॥ ११/२१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.031.m4a", "display_order": 32}, {"id": 6000322032, "chapter_id": 10322, "verse_number": "११-२१-३१", "content_sanskrit": "स्वप्नोपमममुं लोकमसन्तं श्रवणप्रियम्।\nआशिषो हृदि संकल्प्य त्यजन्त्यर्थान् यथा वणिक्॥ ११/२१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.032.m4a", "display_order": 33}, {"id": 6000322033, "chapter_id": 10322, "verse_number": "११-२१-३२", "content_sanskrit": "रजःसत्वतमोनिष्ठा रजःसत्वतमोजुषः।\nउपासते इन्द्रमुख्यान् देवादीन् न यथैव माम्॥ ११/२१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.033.m4a", "display_order": 34}, {"id": 6000322034, "chapter_id": 10322, "verse_number": "११-२१-३३", "content_sanskrit": "इष्ट्वेह देवता यज्ञैर्गत्वा रंस्यामहे दिवि।\nतस्यान्त इह भूयास्म महाशाला महाकुलाः॥ ११/२१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.034.m4a", "display_order": 35}, {"id": 6000322035, "chapter_id": 10322, "verse_number": "११-२१-३४", "content_sanskrit": "एवं पुष्पितया वाचा व्याक्षिप्तमनसां नृणाम्।\nमानिनां चातिस्तब्धानां मद्वार्ताऽपि न रोचते॥ ११/२१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.035.m4a", "display_order": 36}, {"id": 6000322036, "chapter_id": 10322, "verse_number": "११-२१-३५", "content_sanskrit": "वेदा ब्रह्मात्मविषयास्त्रिकाण्डविषया अपि।\nपरोक्षवादो वेदोऽयं परोक्षं मम च प्रियम्॥ ११/२१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.036.m4a", "display_order": 37}, {"id": 6000322037, "chapter_id": 10322, "verse_number": "११-२१-३६", "content_sanskrit": "शब्दब्रह्म सुदुर्बोधं प्राणेन्द्रियमनोमयम्।\nअनन्तपारं गम्भीरं दुर्विगाह्यं समुद्रवत्॥ ११/२१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.037.m4a", "display_order": 38}, {"id": 6000322038, "chapter_id": 10322, "verse_number": "११-२१-३७", "content_sanskrit": "मयोपबृंहितं भूम्ना ब्रह्मणाऽनन्तशक्तिना।\nभूतेषु घोषरूपेण बिसेषूर्णेव लक्ष्यते॥ ११/२१/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.038.m4a", "display_order": 39}, {"id": 6000322039, "chapter_id": 10322, "verse_number": "११-२१-३८", "content_sanskrit": "यथोर्णनाभिर्हृदयादूर्णामुद्वहते मुखात्।\nआकाशाद् घोषवान् प्राणो मनसाऽऽस्पर्शरूपिणा॥ ११/२१/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.039.m4a", "display_order": 40}, {"id": 6000322040, "chapter_id": 10322, "verse_number": "११-२१-३९", "content_sanskrit": "छन्दोमयोऽमृतमयः सहस्रपदवीं प्रभुः।\nओङ्कारेष्वञ्चितां स्पर्शस्वरोष्मान्तःस्थभूषिताम्॥ ११/२१/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.040.m4a", "display_order": 41}, {"id": 6000322041, "chapter_id": 10322, "verse_number": "११-२१-४०", "content_sanskrit": "विचित्रभाषाविततां छन्दोभिश्चतुरुत्तरैः।\nअनन्तपारां बृहतीं सृजत्याक्षिपते स्वयम्॥ ११/२१/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.041.m4a", "display_order": 42}, {"id": 6000322042, "chapter_id": 10322, "verse_number": "११-२१-४१", "content_sanskrit": "गायत्र्युष्णिगनुष्टुप् च बृहती पङ्क्तिरेव च।\nत्रिष्टुप् जगत्यतिच्छन्दो ह्यष्ट्यत्यष्टी जगद् विराट्॥ ११/२१/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.042.m4a", "display_order": 43}, {"id": 6000322043, "chapter_id": 10322, "verse_number": "११-२१-४२", "content_sanskrit": "किं विधत्ते किमाचष्टे किमनूद्य विकल्पयेत्।\nमां विधत्तेऽभिधत्ते मां विकल्प्योऽपोह्य इत्यहम्॥ ११/२१/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.043.m4a", "display_order": 44}, {"id": 6000322044, "chapter_id": 10322, "verse_number": "११-२१-४३", "content_sanskrit": "इत्यस्या हृदयं साक्षात् नान्यो मद् वेद कश्चन॥ ११/२१/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.044.m4a", "display_order": 45}, {"id": 6000322045, "chapter_id": 10322, "verse_number": "११-२१-४४", "content_sanskrit": "एतावान् सर्ववेदार्थः शब्द आस्थाय माऽभिदाम्।\nमायामात्रमनूद्यान्ते प्रतिषिध्य प्रशाम्यति॥ ११/२१/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_021/BhP_11.021.045.m4a", "display_order": 46}, {"id": 6000322046, "chapter_id": 10322, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे एकविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]