[{"id": 2200447, "chapter_id": 5271, "verse_number": "", "content_sanskrit": "शुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2200448, "chapter_id": 5271, "verse_number": "१", "content_sanskrit": "केन वर्णविभागेन विज्ञेया कपिला भवेत् ।\nकति वा लक्षणान्यस्य दृष्टानि मुनिभिः पुरा\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2200449, "chapter_id": 5271, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2200450, "chapter_id": 5271, "verse_number": "२", "content_sanskrit": "शृणु तात यथा गोषु विज्ञेया कपिला भवेत्\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2200451, "chapter_id": 5271, "verse_number": "३", "content_sanskrit": "नेत्रयोः शृङ्गयोश्चैव खुरेषु वृषणेषु च ।\nकर्णतो घ्राणतश्चापि षड्विधाः कपिलाः स्मृताः\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2200452, "chapter_id": 5271, "verse_number": "४", "content_sanskrit": "एतेषां लक्षणानां तु यद्येकमपि दृश्यते ।\nकपिलां तां विजानीयाद् एवमाहुर्मनीषिणः\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2200453, "chapter_id": 5271, "verse_number": "५", "content_sanskrit": "आग्नेयी नेत्रकपिला खुरैर्माहेश्वरी भवेत् ।\nग्रीवायां वैष्णवी ज्ञेया पूष्णो घ्राणादजायत\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2200454, "chapter_id": 5271, "verse_number": "६", "content_sanskrit": "कर्णतस्तु वसन्तेन स्वयोनिमभिजायते ।\nगायत्र्याश्च वृषणयोरुत्पत्तिः षड्गुणा स्मृता\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2200455, "chapter_id": 5271, "verse_number": "७", "content_sanskrit": "एवं गावश्च विप्राश्च गायत्री सत्यमेव च ।\nवसन्तश्च सुवर्णं च एकतः समजायत\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2200456, "chapter_id": 5271, "verse_number": "८", "content_sanskrit": "नेत्रयोः कपिलायास्तु वाहयेत दुहेत वा ।\nस पापकर्मा नरकं प्रतिष्ठां प्रतिपद्यते\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2200457, "chapter_id": 5271, "verse_number": "९", "content_sanskrit": "नरकाद् विप्रमुक्तस्तु तिर्यग्योनिं निषेवते ।\nयदा लभेत मानुष्ये जात्यन्धो जायते नरः\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2200458, "chapter_id": 5271, "verse_number": "१०", "content_sanskrit": "शृङ्गयोः कपिलां यस्तु वाहयेत दुहेत वा ।\nतिर्यग्योनिं स लभते जायमानः पुनः पुनः\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2200459, "chapter_id": 5271, "verse_number": "११", "content_sanskrit": "खुरेषु कपिलां यस्तु वाहयेत दुहेत वा ।\nतमस्यपारे मज्जेत धनहीनो नराधमः\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2200460, "chapter_id": 5271, "verse_number": "१२", "content_sanskrit": "कपिलां वालधानेषु वाहयेत दुहेत वा ।\nनिराश्रयः सदा चैव जायते यदि चेत् क्रिमिः\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2200461, "chapter_id": 5271, "verse_number": "१३", "content_sanskrit": "कर्णेन कपिलां यस्तु जानन्नप्युपजीवति ।\nसहस्रशः क्रिमिर्भूत्वा मानुष्यं प्राप्नुयादथ ।\nचण्डालः पापकर्मा वा जायते स नराधमः\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2200462, "chapter_id": 5271, "verse_number": "१४", "content_sanskrit": "घ्राणेन कपिलां यस्तु प्रमादादुपजीवति ।\nसोऽपि वर्षसहस्राणि तिर्यग्योनौ प्रजायते\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2200463, "chapter_id": 5271, "verse_number": "१५", "content_sanskrit": "व्याधिग्रस्तो जडो रोगी भवेन्मानुष्यमागतः\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2200464, "chapter_id": 5271, "verse_number": "१६", "content_sanskrit": "मधुसर्पिःसुगन्धास्तु कपिलाः शास्त्रतः स्मृताः ।\nएताः समुपजीवेत सोऽपि तिर्यक्षु जायते\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2200465, "chapter_id": 5271, "verse_number": "१७", "content_sanskrit": "स्थावरत्वमनुप्राप्तो यदि मानुष्यतां लभेत् ।\nअल्पायुः स भवेज्जातो हीनवर्णकुलोद्भवः\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2200466, "chapter_id": 5271, "verse_number": "१८", "content_sanskrit": "ये तु पापा ह्यसूयन्ते कपिलां वाहयन्ति च ।\nनिरयेषु प्रतिष्ठन्ते यावदाभूतसम्प्लवम्\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2200467, "chapter_id": 5271, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे कपिलाप्रभेदवर्णनं नाम द्वाविंशत्यधिकशततमोऽध्यायः ॥१२२॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]