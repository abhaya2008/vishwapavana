[{"id": 2123930, "chapter_id": 3657, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2123931, "chapter_id": 3657, "verse_number": "१", "content_sanskrit": "कथं गच्छति कौन्तेयो धर्मपुत्रो युधिष्ठिरः ।\nभीमसेनः सव्यसाची माद्रीपुत्रौ च तावुभौ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2123932, "chapter_id": 3657, "verse_number": "२", "content_sanskrit": "धौम्यश्चापि कथं क्षत्तर्द्रौपदी च यशस्विनी ।\nश्रोतुमिच्छाम्यहं सर्वं तेषामिङ्गितचेष्टितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2123933, "chapter_id": 3657, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2123934, "chapter_id": 3657, "verse_number": "३", "content_sanskrit": "वस्त्रेण मुखमावृत्य कुन्तीपुत्रो युधिष्ठिरः ।\nबाहू विशालौ कृत्वा तु भीमो गच्छति पाण्डवः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2123935, "chapter_id": 3657, "verse_number": "४", "content_sanskrit": "सिकतान् वपन् सव्यसाची राजानमनुगच्छति ।\nमाद्रीपुत्रः सहदेवो मुखमालिप्य गच्छति ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2123936, "chapter_id": 3657, "verse_number": "५", "content_sanskrit": "पांसूपलिप्तसर्वाङ्गो नकुलश्चित्तविह्वलः ।\nदर्शनीयतमो वीरो राजानमनुगच्छति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2123937, "chapter_id": 3657, "verse_number": "६", "content_sanskrit": "कृष्णा केशैः प्रतिच्छाद्य मुखमायतलोचना ।\nदर्शनीया प्ररुदती राजानमनुगच्छति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2123938, "chapter_id": 3657, "verse_number": "७", "content_sanskrit": "धौम्यो याम्यानि सामानि रौद्राणि च विशाम्पते ।\nगायन् गच्छति मार्गेषु कुशानादाय पाणिना ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2123939, "chapter_id": 3657, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2123940, "chapter_id": 3657, "verse_number": "८", "content_sanskrit": "विविधानीह रूपाणि कृत्वा गच्छन्ति पाण्डवाः ।\nतन्ममाचक्ष्व विदुर एवं कस्माद् ब्रवीमि ते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2123941, "chapter_id": 3657, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2123942, "chapter_id": 3657, "verse_number": "९", "content_sanskrit": "निकृत्तस्यापि ते पुत्रैर्हृते राज्ये धनेषु च ।\nन धर्माच्च्यवते बुद्धिर्धर्मराजस्य धीमतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2123943, "chapter_id": 3657, "verse_number": "१०", "content_sanskrit": "योऽसौ राजा घृणी नित्यं धार्तराष्ट्रेषु भारत ।\nनिकृत्या क्रोधसन्तप्तो नोन्मीलयति लोचने ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2123944, "chapter_id": 3657, "verse_number": "११", "content_sanskrit": "नाहं जनं निर्दहेयं दृष्ट्वा घोरेण चक्षुषा ।\nअपिधाय मुखं राजा तस्माद् गच्छति पाण्डवः ।\nयथा च भीमो व्रजति तन्मे निगदतः शृणु ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2123945, "chapter_id": 3657, "verse_number": "१२", "content_sanskrit": "बाह्वोर्बले नास्ति समो ममेति भरतर्षभ ।\nबाहू विशालौ कृत्वा तु भीमसेनोऽनुगच्छति ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2123946, "chapter_id": 3657, "verse_number": "१३", "content_sanskrit": "प्रदिशन् शरसङ्घातान् कुन्तीपुत्रोऽर्जुनस्तदा ।\nसिकता वपन् सव्यसाची राजानमनुगच्छति ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2123947, "chapter_id": 3657, "verse_number": "१४", "content_sanskrit": "असक्ताः सिकतास्तस्य यथा सम्प्रति भारत ।\nअसक्ताः शरवर्षाणि तथा मोक्ष्यति शत्रुषु ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2123948, "chapter_id": 3657, "verse_number": "१५", "content_sanskrit": "न मे कश्चिद् विजानीयान्मुखमद्येति भारत ।\nमुखमालिप्य तेनासौ सहदेवोऽनुगच्छति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2123949, "chapter_id": 3657, "verse_number": "१६", "content_sanskrit": "नासां मनांस्याददेयं मार्गे स्त्रीणामिति प्रभुः ।\nपांसूपलिप्तसर्वाङ्गो नकुलस्तेन गच्छति ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2123950, "chapter_id": 3657, "verse_number": "१७", "content_sanskrit": "एकवस्त्रा प्ररुदती मुक्तकेशी रजस्वला ।\nशोणिताक्तार्द्रवसना द्रौपदी वाक्यमब्रवीत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2123951, "chapter_id": 3657, "verse_number": "१८", "content_sanskrit": "यत्कृतेऽहमिदं प्राप्ता तेषां वर्षे चतुर्दशे ।\nहताः पत्या हतसुता हतबन्धुजनप्रियाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2123952, "chapter_id": 3657, "verse_number": "१९", "content_sanskrit": "बह्व्यः शोणितदिग्धाङ्ग्यो मुक्तकेश्यो रजस्वलाः ।\nएवं कृतोदका नार्य्यः प्रवेक्ष्यन्ति गजाह्वयम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2123953, "chapter_id": 3657, "verse_number": "२०", "content_sanskrit": "कृत्वा तु नैर्ऋतान् दर्भान् धीरो धौम्यः पुरोहितः ।\nसामानि गायन् याम्यानि पुरतो याति भारत ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2123954, "chapter_id": 3657, "verse_number": "२१", "content_sanskrit": "हतेषु भरतेष्वाजौ कुरूणां कुरवस्तदा ।\nएवं सामानि गायन्त्वित्युक्त्वा धौम्योऽपि गच्छति ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2123955, "chapter_id": 3657, "verse_number": "२२", "content_sanskrit": "प्रस्थाप्य पाण्डवानेतान् निश्शेषस्ते भविष्यति ।\nइति धौम्यो व्यवसितो रौद्रान् याम्यानि गायति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2123956, "chapter_id": 3657, "verse_number": "२३", "content_sanskrit": "एवमाकारलिङ्गैस्ते व्यवसायं मनोगतम् ।\nकथयन्तश्च कौन्तेया वनं जग्मुर्मनस्विनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2123957, "chapter_id": 3657, "verse_number": "२४", "content_sanskrit": "एवं तेषु नराग्य्रेषु निर्यत्सु गजसाह्वयात् ।\nअनभ्रे विद्युतश्चासन् भूमिश्च समकम्पत ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2123958, "chapter_id": 3657, "verse_number": "२५", "content_sanskrit": "राहुरग्रसदादित्यमपर्वणि विशाम्पते ।\nउल्का चाप्यपसव्यं तु पुरस्कृत्वा व्यशीर्यत ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2123959, "chapter_id": 3657, "verse_number": "२६", "content_sanskrit": "प्रव्याहरन्तः क्रव्यादा गृध्रगोमायुवायसाः ।\nदेवायतनचैत्येषु प्राकाराट्टालकेषु च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2123960, "chapter_id": 3657, "verse_number": "२७", "content_sanskrit": "एवमेते महाराज वनं गच्छन्ति पाण्डवाः ।\nभरतानां विनाशाय राजन् दुर्मन्त्रिते तव ।\nएवमुक्त्वा तु विदुरः तूष्णीमासीद् विशाम्पते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2123961, "chapter_id": 3657, "verse_number": "२८", "content_sanskrit": "नारदश्च सभामध्ये कुरूणामग्रतः स्थितः ।\nमहर्षिभिः परिवृतो रौद्रं वाक्यमुवाच ह ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2123962, "chapter_id": 3657, "verse_number": "२९", "content_sanskrit": "इतश्चतुर्दशे वर्षे विनशिष्यन्ति कौरवाः ।\nदुर्योधनापराधेन भीमार्जुनबलेन च ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2123963, "chapter_id": 3657, "verse_number": "३०", "content_sanskrit": "इत्युक्त्वा दिवमाक्रम्य क्षिप्रमन्तरधीयत ।\nब्राह्मीं श्रियं च विपुलां बिभ्रद् देवर्षिसत्तमः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2123964, "chapter_id": 3657, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2123965, "chapter_id": 3657, "verse_number": "३१", "content_sanskrit": "किमब्रुवन् नागरिकाः किं वै जानपदा जनाः ।\nमह्यं तत्त्वेन चाचक्ष्व क्षत्तः सर्वमशेषतः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2123966, "chapter_id": 3657, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2123967, "chapter_id": 3657, "verse_number": "३२", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः शूद्रा येऽन्ये वदन्त्यथ ।\nतच्छृणुष्व महाराज वक्ष्यते च मया तव ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2123968, "chapter_id": 3657, "verse_number": "३३", "content_sanskrit": "हा हा गच्छन्ति नो नाथाः समवेक्षध्वमीदृशम् ।\nइति पौराः सुदुःखार्ताः शोचन्ति स्म समन्ततः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2123969, "chapter_id": 3657, "verse_number": "३४", "content_sanskrit": "ततः पौराश्च दीनास्ते गते पार्थे वनं तथा ।\nगावो हीना यथा वत्सैः पुरं प्रविविशुः पुनः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2123970, "chapter_id": 3657, "verse_number": "३५", "content_sanskrit": "तदहृष्टमिवाकूजं गतोत्सवमिवाभवत् ।\nनगरं हस्तिनपुरं सस्त्रीवृद्धकुमारकम् ।\nसर्वे चासन् निरुत्साहा व्याधिना बाधिता यथा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2123971, "chapter_id": 3657, "verse_number": "३६", "content_sanskrit": "पार्थान् प्रति नरा नित्यं चिन्ताशोकपरायणाः ।\nतत्र तत्र कथां चक्रुः समासाद्य परस्परम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2123972, "chapter_id": 3657, "verse_number": "३७", "content_sanskrit": "कुन्ती च भृशदुःखार्ता पुत्रैः सर्वैर्विवर्जिता ।\nहीनवत्सा यथा धेनुर्विललाप सुदुःखिता ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2123973, "chapter_id": 3657, "verse_number": "३८", "content_sanskrit": "वनं गते धर्मराजे दुःखशोकपरायणाः ।\nबभूवुः कौरवा वृद्धा भृशं शोकेन पीडिताः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2123974, "chapter_id": 3657, "verse_number": "३९", "content_sanskrit": "ततः पौरजनः सर्वः शोचन्नास्ते जनाधिपम् ।\nकुर्वाणाश्च कथास्तत्र ब्राह्मणाः पार्थिवं प्रति ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2123975, "chapter_id": 3657, "verse_number": "४०", "content_sanskrit": "कथं नु राजा धर्मात्मा वने वसति निर्जने ।\nतस्यानुजाश्च ते नित्यं कृष्णा च द्रुपदात्मजा ।\nसुखार्हाऽपि च दुःखार्ता कथं वसति सा वने ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2123976, "chapter_id": 3657, "verse_number": "४१", "content_sanskrit": "एवं पौराश्च विप्राश्च सदाराः सहपुत्रकाः ।\nस्मरन्तः पाण्डवान् सर्वे बभूवुर्भृशदुःखिताः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2123977, "chapter_id": 3657, "verse_number": "४२", "content_sanskrit": "आविद्धा इव शस्त्रेण नाभ्यनन्दन् कथञ्चन ।\nसम्भाष्यमाणा अपि ते न कञ्चित् प्रत्यपूजयन् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2123978, "chapter_id": 3657, "verse_number": "४३", "content_sanskrit": "नभुक्त्वा नशयित्वा ते दिवा वा यदि वा निशि ।\nशोकोपहतविज्ञाना नष्टसंज्ञा इवाभवन् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2123979, "chapter_id": 3657, "verse_number": "४४", "content_sanskrit": "यदवस्था बभूवार्ता ह्ययोध्या नगरी पुरा ।\nरामे वनं गते दुःखाद्धृतराज्ये सलक्ष्मणे ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2123980, "chapter_id": 3657, "verse_number": "४५", "content_sanskrit": "तदवस्थं बभूवार्तमद्येदं गजसाह्वयम् ।\nगते पार्थे वनं दुःखाद्धृतराज्ये सहानुजैः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2123981, "chapter_id": 3657, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2123982, "chapter_id": 3657, "verse_number": "४६", "content_sanskrit": "विदुरस्य वचः श्रुत्वा नागरस्य गिरं च वै ।\nभूयो मुमोह शोकाच्च धृतराष्ट्रः सबान्धवः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2123983, "chapter_id": 3657, "verse_number": "४७", "content_sanskrit": "ततो दुर्योधनः कर्णः शकुनिश्चापि भारत ।\nद्रोणं दीपममन्यन्त राज्यं चास्मै न्यवेदयन् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2123984, "chapter_id": 3657, "verse_number": "४८", "content_sanskrit": "अथाब्रवीत् तदा द्रोणो दुर्योधनममर्षणम् ।\nदुश्शासनं च कर्णं च सर्वानेव च भारतान् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2123985, "chapter_id": 3657, "verse_number": "४९", "content_sanskrit": "अवध्यान् पाण्डवानाहुर्देवपुत्रान् द्विजातयः ।\nअहं तु चरणं प्राप्तान् वर्तमानान् यथाबलम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2123986, "chapter_id": 3657, "verse_number": "५०", "content_sanskrit": "आगतान् पालयिष्यामि धार्तराष्ट्रान् सराजकान् ।\nनोत्सहे समभित्यक्तुं दैवं मूलमतः परम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2123987, "chapter_id": 3657, "verse_number": "५१", "content_sanskrit": "धर्मतः पाण्डुपुत्रा वै वनं गच्छन्ति कौरवाः ।\nते च द्वादश वर्षाणि वने वत्स्यन्ति निर्जिताः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2123988, "chapter_id": 3657, "verse_number": "५२", "content_sanskrit": "चरितब्रह्मचर्याश्च क्रोधामर्षवशानुगाः ।\nवैरं प्रत्यानयिष्यन्ति मम दुःखाय पाण्डवाः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2123989, "chapter_id": 3657, "verse_number": "५३", "content_sanskrit": "मया तु भ्रंशितो राज्याद् द्रुपदः सखिविग्रहे ।\nपुत्रार्थमयजत् कोपाद् वधाय मम भारत ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2123990, "chapter_id": 3657, "verse_number": "५४", "content_sanskrit": "याजोपयाजतपसा पुत्रं लेभे स पावकात् ।\nधृष्टद्युम्नं द्रौपदीं च वेदीमध्यात् सुमध्यमाम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2123991, "chapter_id": 3657, "verse_number": "५५", "content_sanskrit": "ज्वालावर्णो देवदत्तो धनुष्मान् कवची शरी ।\nमर्त्यधर्मतयाऽस्माकं तस्मान्मां भयमाविशत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2123992, "chapter_id": 3657, "verse_number": "५६", "content_sanskrit": "गतो हि पक्षतां तेषां पार्षतः पुरुषर्षभः ।\nमद्वधायोत्थितो धीमान् लोके चाप्यभिविश्रुतः ।\nसृष्टप्राणो भृशतरं तस्माद् योत्स्ये तवारिभिः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2123993, "chapter_id": 3657, "verse_number": "५७", "content_sanskrit": "नूनं सोऽयमभिप्राप्तः त्वत्कृते कालपर्ययः ।\nत्वरिताः कुरुत श्रेयो नैतदेतावता कृतम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2123994, "chapter_id": 3657, "verse_number": "५८", "content_sanskrit": "मुहूर्तं सुखमेवैतत् कूलच्छायेव हेमनि ।\nयजध्वं च महायज्ञैर्भोगानश्नीत पार्थिवाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2123995, "chapter_id": 3657, "verse_number": "५९", "content_sanskrit": "इतश्चतुर्दशे वर्षे महत् प्राप्स्यथ वैशसम् ।\nदुर्योधन निशम्यैतत् प्रतिपद्य यथेच्छसि ।\nशमं वा पाण्डवेयेषु प्रयुङ्क्ष्व यदि मन्यसे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2123996, "chapter_id": 3657, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2123997, "chapter_id": 3657, "verse_number": "६०", "content_sanskrit": "द्रोणस्य वचनं श्रुत्वा धृतराष्ट्रोऽब्रवीदिदम् ।\nसम्यगाह गुरुः क्षत्तरुपावर्तय पाण्डवान् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2123998, "chapter_id": 3657, "verse_number": "६१", "content_sanskrit": "यदि वा न निवर्तन्ते सत्कृता यान्तु पाण्डवाः ।\nसशस्त्ररथपादाता भोगवन्तश्च पुत्रकाः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2123999, "chapter_id": 3657, "verse_number": "७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां सभापर्वणि\nएकोनशततमोऽध्यायः ॥९९॥\n॥ अनुद्यूतपर्वणि सप्तमोऽध्यायः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2124000, "chapter_id": 3657, "verse_number": "", "content_sanskrit": "–– ० ––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]