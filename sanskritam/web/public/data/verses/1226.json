[{"id": 2011049, "chapter_id": 1226, "verse_number": "१-२२७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2011050, "chapter_id": 1226, "verse_number": "१-२२७-१", "content_sanskrit": "दुर्योधनस्य महिषी काशिराजसुता तदा।\nधृतराष्ट्रस्य पुत्राणां वधूभिः सहिता तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2011051, "chapter_id": 1226, "verse_number": "१-२२७-२", "content_sanskrit": "पाञ्चालीं प्रतिजग्राह साध्वीं श्रियमिवापराम्।\nपूजयामास पूजार्हां शचीदेवीमिवागताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2011052, "chapter_id": 1226, "verse_number": "१-२२७-३", "content_sanskrit": "ववन्दे तत्र गान्धारीं कृष्णया सह माधवी।\nआशिषश्च प्रयुक्त्वा तु पाञ्चालीं परिषस्वजे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2011053, "chapter_id": 1226, "verse_number": "१-२२७-४", "content_sanskrit": "परिष्वज्यैव गान्धारी कृष्णां कमललोचनाम्।\nपुत्राणां मम पाञ्चाली मृत्युरेवेत्यमन्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2011054, "chapter_id": 1226, "verse_number": "१-२२७-५", "content_sanskrit": "संचिन्त्य विदुरं प्राह युक्तितः सुबलात्मजा।\nकुन्तीं राजसुतां क्षत्तः सवधूं सपरिच्छदाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2011055, "chapter_id": 1226, "verse_number": "१-२२७-६", "content_sanskrit": "पाण्डोर्निवेशनं शीघ्रं नीयतां यदि रोचते।\nकरणेन मुहूर्तेन नक्षत्रेण शुभे तिथौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2011056, "chapter_id": 1226, "verse_number": "१-२२७-७", "content_sanskrit": "यथा सुखं तथा कुन्ती रंस्यते स्वगृहे सुतैः।\nतथेत्येव तदा क्षत्ता कारयामास तत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2011057, "chapter_id": 1226, "verse_number": "१-२२७-८", "content_sanskrit": "पूजयामासुरत्यर्थं बान्धवाः पाण्डवांस्तदा।\nनागराः श्रेणिमुख्याश्च पूजयन्ति स्म पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2011058, "chapter_id": 1226, "verse_number": "१-२२७-९", "content_sanskrit": "भीष्मो द्रोणः कृपः कर्णो बाह्लीकः ससुतस्तदा।\nशासनाद्धृतराष्ट्रस्य अकुर्वन्नतिथिक्रियाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2011059, "chapter_id": 1226, "verse_number": "१-२२७-१०", "content_sanskrit": "एवं विहरतां तेषां पाण्डवानां महात्मनाम्।\nनेता सर्वस्य कार्यस्य विदुरो राजशासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2011060, "chapter_id": 1226, "verse_number": "१-२२७-११", "content_sanskrit": "विश्रान्तास्ते महात्मानः कंचित्कालं सकेशवाः।\nआहूता धृतराष्ट्रेण राज्ञा शान्तनवेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2011061, "chapter_id": 1226, "verse_number": "१-२२७-१२x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2011062, "chapter_id": 1226, "verse_number": "१-२२७-१२", "content_sanskrit": "भ्रातृभिः सह कौन्तेय निबोधेदं वचो मम।\nपाण्डुना वर्धितं राज्यं पाण्डुना पालितं जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2011063, "chapter_id": 1226, "verse_number": "१-२२७-१३", "content_sanskrit": "शासनान्मम कौन्तेय मम भ्राता महाबलः।\nकृतवान्दुष्करं कर्म नित्यमेव विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2011064, "chapter_id": 1226, "verse_number": "१-२२७-१४", "content_sanskrit": "तस्मात्त्वमपि कौन्तेय शासनं कुरु मा चिरम्।\nमम पुत्रा दुरात्मानः सर्वेऽहंकारसंयुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2011065, "chapter_id": 1226, "verse_number": "१-२२७-१५", "content_sanskrit": "शासनं न करिष्यन्ति मम नित्यं युधिष्ठिर।\nस्वकार्यनिरतैर्नित्यमवलिप्तैर्दुरात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2011066, "chapter_id": 1226, "verse_number": "१-२२७-१६", "content_sanskrit": "पुनर्वै विग्रहो मा भूत्खाण्डवप्रस्थमाविश।\nन हि वो वसतस्तत्र कश्चिच्छक्तः प्रबाधितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2011067, "chapter_id": 1226, "verse_number": "१-२२७-१७", "content_sanskrit": "संरक्ष्यमाणान्पार्थेन त्रिदशानिव वज्रिणा।\nअर्धराज्यं तु संप्राप्य खाण्डवप्रस्थणाविश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2011068, "chapter_id": 1226, "verse_number": "१-२२७-१८", "content_sanskrit": "केशवो यदि मन्यते तत्कर्तव्यमसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2011069, "chapter_id": 1226, "verse_number": "१-२२७-१९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2011070, "chapter_id": 1226, "verse_number": "१-२२७-१९", "content_sanskrit": "प्रतिगृह्य तु तद्वाक्यं नृपं सर्वे प्रणम्य च।\nवासुदेवेन संमन्त्र्य पाण्डवाः समुपाविशन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2011071, "chapter_id": 1226, "verse_number": "१-२२७-२०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2011072, "chapter_id": 1226, "verse_number": "१-२२७-२०", "content_sanskrit": "अभिषेकस्य संभारान्क्षत्तरानय मा चिरम्।\nअभिषिक्तं करिष्यामि ह्यद्य वै कुरुनन्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2011073, "chapter_id": 1226, "verse_number": "१-२२७-२१", "content_sanskrit": "ब्राह्मणा नैगमश्रेष्ठाः श्रेणीमुख्याश्च सर्वतः।\nआहूयन्तां प्रकृतयो बान्धवाश्च विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2011074, "chapter_id": 1226, "verse_number": "१-२२७-२२", "content_sanskrit": "पुण्याहं वाच्यतां तात गोसहस्रं प्रदीयताम्।\nग्राममुख्याश्च विप्रेभ्यो दीयन्तां बहुदक्षिणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2011075, "chapter_id": 1226, "verse_number": "१-२२७-२३", "content_sanskrit": "अङ्गदे मकुटं क्षत्तर्हस्ताभरणमानय।\nमुक्तावलीश्च हारं च निष्काणि कटकानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2011076, "chapter_id": 1226, "verse_number": "१-२२७-२४", "content_sanskrit": "कटिबन्धश्च सूत्रं च तथोदरनिबन्धनम्।\nअष्टोत्तरसहस्रं तु ब्राह्मणाधिष्ठिता गजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2011077, "chapter_id": 1226, "verse_number": "१-२२७-२५", "content_sanskrit": "जाह्नवीसलिलं शीघ्रमानीयन्तां पुरोहितैः।\nअभिषेकोदकक्लिन्नं सर्वाभरणभूषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2011078, "chapter_id": 1226, "verse_number": "१-२२७-२६", "content_sanskrit": "औपवाह्योपरिगतं दिव्यचारमरवीजितम्।\nसुवर्णमणिचित्रेण श्वेतच्छत्रेण शोभितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2011079, "chapter_id": 1226, "verse_number": "१-२२७-२७", "content_sanskrit": "जयेति द्विजवाक्येनु स्तूयमानं नृपैस्तथा।\nदृष्ट्वा कुन्तीसुतं ज्येष्ठमाजमीढं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2011080, "chapter_id": 1226, "verse_number": "१-२२७-२८", "content_sanskrit": "प्रीताः प्रीतेन मनसा प्रशंसन्तु परे जनाः।\nपाण्डोः कृतोपकारस्य राज्यं दत्वा ममैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2011081, "chapter_id": 1226, "verse_number": "१-२२७-२९", "content_sanskrit": "प्रतिक्रिया कृतमिदं भविष्यति न संशयः।\nभीष्मो द्रोणः कृपः क्षत्ता साधुसाध्वित्यथाब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2011082, "chapter_id": 1226, "verse_number": "१-२२७-३०x", "content_sanskrit": "श्रीवासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2011083, "chapter_id": 1226, "verse_number": "१-२२७-३०", "content_sanskrit": "युक्तमेतन्महाभाग कौरवाणां यशस्करम्।\nशीघ्रमद्यैव राजेन्द्र त्वयोक्तं कर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2011084, "chapter_id": 1226, "verse_number": "१-२२७-३१", "content_sanskrit": "इत्येवमुक्तो वार्ष्णेयस्त्वरयामास तत्तदा।\nतथोक्तं धृतराष्ट्रेण कारयामास केशवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2011085, "chapter_id": 1226, "verse_number": "१-२२७-३२", "content_sanskrit": "तस्मिन्क्षणे महाराज कृष्णद्वैपायनस्तदा।\nआगत्य कुरुभिः सर्वैः पूजितः ससुहृद्गणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2011086, "chapter_id": 1226, "verse_number": "१-२२७-३३", "content_sanskrit": "मूर्धाभिषिक्तैः सहितो ब्राह्मणैर्वेदपारगैः।\nकारयामास विधिवत्केशवानुमते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2011087, "chapter_id": 1226, "verse_number": "१-२२७-३४", "content_sanskrit": "कृपो द्रोणश्च भीष्मश्च धौम्यश्च व्यासकेशवौ।\nबाह्लीकः सोमदत्तश्च चातुर्वेद्यपुरस्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2011088, "chapter_id": 1226, "verse_number": "१-२२७-३५", "content_sanskrit": "अभिषेकं तदा चक्रुर्भद्रपीठे सुसंस्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2011089, "chapter_id": 1226, "verse_number": "१-२२७-३६x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2011090, "chapter_id": 1226, "verse_number": "१-२२७-३६", "content_sanskrit": "जित्वा तु पृथिवीं कृत्स्नां वशे कृत्वा नृपान्भवान्।\nराजसूयादिभिर्यज्ञैः क्रतुभिर्वरदक्षिणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2011091, "chapter_id": 1226, "verse_number": "१-२२७-३७", "content_sanskrit": "स्नात्वा ह्यवभृथस्नानं मोदतां बान्धवैः सह।\nएवमुक्त्वा तु ते सर्वे आशीर्भिरभिपूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2011092, "chapter_id": 1226, "verse_number": "१-२२७-३८", "content_sanskrit": "मूर्धाभिषिक्तः कौरव्यः सर्वाभरणभूषितः।\nजयेति संस्तुतो राजा प्रददौ धनमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2011093, "chapter_id": 1226, "verse_number": "१-२२७-३९", "content_sanskrit": "सर्वमूर्धाभिषिक्तैश्च पूजितः कुरनन्दनः।\nऔपवाह्यमथारुह्य श्वेतच्छत्रेण शोभितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2011094, "chapter_id": 1226, "verse_number": "१-२२७-४०", "content_sanskrit": "रराज राजाभिमतो महेन्द्र इव दैवतैः।\nततः प्रदक्षिणीकृत्य नगरं नागसाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2011095, "chapter_id": 1226, "verse_number": "१-२२७-४१", "content_sanskrit": "प्रविवेश तदा राजा नागरैः पूजितो गृहम्।\nमूर्धाभिषिक्तं कौन्तेयमभ्यगच्छन्त कौरवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2011096, "chapter_id": 1226, "verse_number": "१-२२७-४२", "content_sanskrit": "गान्धारिपुत्राः शोचन्तः सर्वे ते सह बान्धवैः।\nज्ञात्वा शोकं च पुत्राणां धृतराष्ट्रोऽब्रवीदिदं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2011097, "chapter_id": 1226, "verse_number": "१-२२७-४३", "content_sanskrit": "समक्षं वासुदेवस्य कुरूणां च समक्षतः।\nअभिषेकस्त्वया प्राप्तो दुष्प्रापो ह्यकृतात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2011098, "chapter_id": 1226, "verse_number": "१-२२७-४४", "content_sanskrit": "गच्छ त्वमद्यैव नृप कृतकृत्योऽसि कौरव।\nआयुः पुरूरवा राजन्नहुषेण ययातिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2011099, "chapter_id": 1226, "verse_number": "१-२२७-४५", "content_sanskrit": "तत्रैव निवसन्ति स्म खाण्डवे तु नृपोत्तम।\nराजधानी तु सर्वेषां पौरवाणां महाभुज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2011100, "chapter_id": 1226, "verse_number": "१-२२७-४६", "content_sanskrit": "विनाशितं मुनिगणैर्लोभाद्बुधसुतस्य वै।\nतस्मात्त्वं खाण्डवप्रस्थं पुरं राष्ट्रं च वर्धय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2011101, "chapter_id": 1226, "verse_number": "१-२२७-४७", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः शूद्राश्च कृतलक्षणाः।\nत्वद्भक्त्या जन्तवश्चान्ये भजन्त्येव पुरं शुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2011102, "chapter_id": 1226, "verse_number": "१-२२७-४८", "content_sanskrit": "पुरं राष्ट्रं समृद्धं वै धनधान्यसमाकुलम्।\nतस्माद्गच्छस्व कौन्तेय भ्रातृभिः सहितोऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2011103, "chapter_id": 1226, "verse_number": "१-२२७-४९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2011104, "chapter_id": 1226, "verse_number": "१-२२७-४९", "content_sanskrit": "प्रतिगृह्य तु तद्वाक्यं तस्मै सर्वे प्रणम्य च।\nरथैर्नागैर्हयैश्चापि सहितास्तु पदातिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2011105, "chapter_id": 1226, "verse_number": "१-२२७-५०", "content_sanskrit": "प्रतस्थिरे ततो घोषसंयुक्तैः स्यन्दनैर्वरैः।\nतान्दृष्ट्वा नागराः सर्वे भक्त्या चैव प्रतस्थिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2011106, "chapter_id": 1226, "verse_number": "१-२२७-५१", "content_sanskrit": "गच्छतः पाण्डवैः सार्धं दृष्ट्वा नागपुरालयात्।\nपाण्डवैः सहिता गन्तुं नार्हतेति च नागरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2011107, "chapter_id": 1226, "verse_number": "१-२२७-५२", "content_sanskrit": "घोषयामास नगरे धार्तराष्ट्रः ससौबलः।\nततस्ते पाण्डवास्तत्र गत्वा कृष्णपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2011108, "chapter_id": 1226, "verse_number": "१-२२७-५३", "content_sanskrit": "मण्डयाञ्चक्रिरे तद्वै पुरं स्वर्गादिव च्युतम्।\nवासुदेवो जगन्नाथश्चिन्तयामास वासवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2011109, "chapter_id": 1226, "verse_number": "१-२२७-५४", "content_sanskrit": "महेन्द्रश्चिन्तितो राजन्विश्वकर्माणमादिशत्।\nविश्वकर्मन्महाप्राज्ञ अद्यप्रभृति तत्पुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2011110, "chapter_id": 1226, "verse_number": "१-२२७-५५", "content_sanskrit": "इन्द्रप्रस्थमिति ख्यातं दिव्यं भूम्यां भविष्यति।\nमहेन्द्रशासनाद्गत्वा विश्वकर्मा तु केशवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2011111, "chapter_id": 1226, "verse_number": "१-२२७-५६", "content_sanskrit": "प्रणम्य प्रणिपातार्हं किं करोमीत्यभाषत।\nवासुदेवस्तु तच्छ्रुत्वा विश्वकर्माणमूचिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2011112, "chapter_id": 1226, "verse_number": "१-२२७-५७", "content_sanskrit": "कुरुष्व कुरुराजस्य महेन्द्रपुरसन्निभम्।\nइन्द्रेण कृतनामानमिन्द्रप्रस्थं महापुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2011113, "chapter_id": 1226, "verse_number": "१-२२७-५८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2011114, "chapter_id": 1226, "verse_number": "१-२२७-५८", "content_sanskrit": "ततः पुण्ये शिवे देशे शान्तिं कृत्वा महारथाः।\nस्वस्तिवाच्य यथान्यायमिन्द्रप्रस्थं भवत्विति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2011115, "chapter_id": 1226, "verse_number": "१-२२७-५९", "content_sanskrit": "तत्पुरं मापयामासुर्द्वैपायनपुरोगमाः।\nततः स विश्वकर्मा तु चकार पुरमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2011116, "chapter_id": 1226, "verse_number": "१-२२७-६०", "content_sanskrit": "सागरप्रतिरूपाभिः परिखाभिरलङ्कृतम्।\nप्राकारेण च संपन्नं दिवमावृत्य तिष्ठता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2011117, "chapter_id": 1226, "verse_number": "१-२२७-६१", "content_sanskrit": "पाण्डुराभ्रप्रकाशेन हिमरश्मिनिभेन च।\nशुशुभे तत्पुरश्रेष्ठं नागैर्भोगवती यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2011118, "chapter_id": 1226, "verse_number": "१-२२७-६२", "content_sanskrit": "द्विपक्षगरुडप्रख्यैर्द्वारैः सौधैश्च शोभितम्।\nगुप्तमभ्रचयप्रख्यैर्गोपुरैर्मन्दरोपमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2011119, "chapter_id": 1226, "verse_number": "१-२२७-६३", "content_sanskrit": "विविधैरपि निर्विद्धैः शस्त्रोपेतैः सुसंवृतैः।\nशक्तिभिश्चावृतं तद्धि द्विजिह्वैरिव पन्नगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2011120, "chapter_id": 1226, "verse_number": "१-२२७-६४", "content_sanskrit": "तल्पैश्चाभ्यासिकैर्युक्तं शुशुभे योधरक्षितम्।\nथीक्ष्णाङ्कुशशतघ्नीभिर्यन्त्रजालैश्च शोभितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2011121, "chapter_id": 1226, "verse_number": "१-२२७-६५", "content_sanskrit": "आयसैश्च महाचक्रैः शुशुभे तत्पुरोत्तमम्।\nसुविभक्तमहारथ्यं देवताबाधवर्जितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2011122, "chapter_id": 1226, "verse_number": "१-२२७-६६", "content_sanskrit": "विरोचमानं विविधैः पाण्डुरैर्भवनोत्तमैः।\nतत्त्रिविष्टपसंकाशमिन्द्रप्रस्थं व्यरोचत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2011123, "chapter_id": 1226, "verse_number": "१-२२७-६७", "content_sanskrit": "मेघवृन्दमिवाकाशे विद्धं विद्युत्समावृतम्।\nतत्र रम्ये शिवे देशे कौरव्यस्य निवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2011124, "chapter_id": 1226, "verse_number": "१-२२७-६८", "content_sanskrit": "शुशुभे धनसंपूर्णं धनाध्यक्षक्षयोपमम्।\nतत्रागच्छन्द्विजा राजन्सर्ववेदविदां वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2011125, "chapter_id": 1226, "verse_number": "१-२२७-६९", "content_sanskrit": "निवासं रोचयन्ति स्म सर्वभाषाविदस्तथा।\nवणिजश्चाययुस्तत्र नानादिग्भ्यो धनार्थिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2011126, "chapter_id": 1226, "verse_number": "१-२२७-७०", "content_sanskrit": "सर्वशिल्पविदस्तत्र वासायाभ्यागमंस्तदा।\nउद्यानानि च रम्याणि नगरस्य समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2011127, "chapter_id": 1226, "verse_number": "१-२२७-७१", "content_sanskrit": "आम्रैराम्रातकैर्नीपैरशोकैश्चम्पकैस्तथा।\nपुन्नागैर्नागपुष्पैश्च लकुचैः पनसैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2011128, "chapter_id": 1226, "verse_number": "१-२२७-७२", "content_sanskrit": "शालतालतमालैश्च बकुलैश्च सकेतकैः।\nमनोहरैः सुपुष्पैश्च फलभारावनामितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2011129, "chapter_id": 1226, "verse_number": "१-२२७-७३", "content_sanskrit": "प्राचीनामलकैर्लोध्रैरङ्कोलैश्च सुपिष्पितैः।\nजम्बूभिः पाटलाभिश्च कुब्जकैरतिमुक्तकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2011130, "chapter_id": 1226, "verse_number": "१-२२७-७४", "content_sanskrit": "करवीरैः पारिजातैरन्यैश्च विविधैर्द्रुमैः।\nनित्यपुष्पफलोपेतैर्नानाद्विजगणायुतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2011131, "chapter_id": 1226, "verse_number": "१-२२७-७५", "content_sanskrit": "मत्तबर्हिणसंघुष्टकोकिलैश्च सदामदैः।\nगृहैरादर्शविमलैर्विविधैश्च लतागृहैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2011132, "chapter_id": 1226, "verse_number": "१-२२७-७६", "content_sanskrit": "मनोहरैश्चित्रगृहैस्तथाऽजगतिप्रवतैः।\nवापीभिर्विविधाभिश्च पूर्णाभिः परमाम्भसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2011133, "chapter_id": 1226, "verse_number": "१-२२७-७७", "content_sanskrit": "सरोभिरतिरम्यैश्च पद्मोत्पलसुगन्धिभिः।\nहंसकारण्डवयुतैश्चक्रवाकोपशोभितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2011134, "chapter_id": 1226, "verse_number": "१-२२७-७८", "content_sanskrit": "रम्याश्च विविधास्तत्र पुष्करिण्यो वनावृताः।\nतडागानि च रम्याणि बृहन्ति सुबहूनि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2011135, "chapter_id": 1226, "verse_number": "१-२२७-७९", "content_sanskrit": "नदी च नन्दिनी नाम सा पुरीमुपगूहति।\nचातुर्वर्ण्यसमाकीर्णमन्यैः शिल्पिभिरावृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2011136, "chapter_id": 1226, "verse_number": "१-२२७-८०", "content_sanskrit": "सर्वदाभिसृतं सद्भिः कारितं विश्वकर्मणा।\nउपभोगसमृद्धैश्च सर्वद्रव्यसमावृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2011137, "chapter_id": 1226, "verse_number": "१-२२७-८१", "content_sanskrit": "नित्यमार्यजनोपेतं नरनारीगणैर्युतम्।\nवाजिवारणसंपूर्णं गोभिरुष्ट्रैः खरैरजैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2011138, "chapter_id": 1226, "verse_number": "१-२२७-८२", "content_sanskrit": "तत्त्रिविष्टपसङ्काशमिन्द्रप्रस्थं व्यरोचत।\nपुरीं सर्वगुणोपेतां निर्मितां विश्वकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2011139, "chapter_id": 1226, "verse_number": "१-२२७-८३", "content_sanskrit": "पौरवाणामधिपतिः कुन्तीपुत्रो युधिष्ठिरः।\nकृतमङ्गलसत्कारैर्ब्राह्मणैर्वेदपारगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2011140, "chapter_id": 1226, "verse_number": "१-२२७-८४", "content_sanskrit": "द्वैपायनं पुरस्कृत्य धौम्यस्याभिमते स्थितः।\nभ्रातृभिः सहितो राजा राजमार्गमतीत्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2011141, "chapter_id": 1226, "verse_number": "१-२२७-८५", "content_sanskrit": "औपवाह्यगतो राजा केशवेन सहाभिभूः।\nतोरणद्वारसुमुखं द्वात्रिंशद्द्वारसंयुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2011142, "chapter_id": 1226, "verse_number": "१-२२७-८६", "content_sanskrit": "वर्धमानपुरद्वारात्प्रविवेश महाद्युतिः।\nशङ्खदुन्दुभिनिर्घोषाः श्रूयन्ते बहवो भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2011143, "chapter_id": 1226, "verse_number": "१-२२७-८७", "content_sanskrit": "जयेति ब्राह्मणगिरः श्रूयन्ते च सहस्रशः।\nसंस्तूयमानो मुनिभिः सूतमागधबन्दिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2011144, "chapter_id": 1226, "verse_number": "१-२२७-८८", "content_sanskrit": "औपवाह्यगतो राजा राजमार्गमतीत्य च।\nकृतमङ्गलसत्कारं प्रविवेश गृहोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2011145, "chapter_id": 1226, "verse_number": "१-२२७-८९", "content_sanskrit": "प्रविश्य भवनं राजा नागरैरभिसंवृतः।\nप्रहृष्टमुदितैरासीत्सत्कारैरभिपूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2011146, "chapter_id": 1226, "verse_number": "१-२२७-९०", "content_sanskrit": "पूजयामास विप्रेन्द्रान्केशेन महात्मना।\nततस्तु राष्ट्रं नगरं नरनारीगणायुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2011147, "chapter_id": 1226, "verse_number": "१-२२७-९१", "content_sanskrit": "गोधनैश्च समाकीर्णं सस्यैर्वृद्धिं तदागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2011148, "chapter_id": 1226, "verse_number": "१-२२७-९२", "content_sanskrit": "तेषां पुण्यजनोपेतं राष्ट्रमाविशतां महत्।\nपाण्डवानां महाराज शश्वत्प्रीतिरवर्धत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2011149, "chapter_id": 1226, "verse_number": "१-२२७-९३", "content_sanskrit": "सौबलेन च कर्णेन धार्तराष्ट्रैः कृपेण च।\nतथा भीष्मेण राज्ञा च धर्मप्रणयिना सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2011150, "chapter_id": 1226, "verse_number": "१-२२७-९४", "content_sanskrit": "पाण्डवाः समपद्यन्त खाण्डवप्रस्थवासिनः।\nपञ्चभिस्तैर्महेष्वासैरिन्द्रकल्पैः समावृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2011151, "chapter_id": 1226, "verse_number": "१-२२७-९५", "content_sanskrit": "शुशुभे तत्पुरश्रेष्ठं नागैर्भोगवती यथा।\nततस्तु विश्वकर्माणं पूजयित्वा विसृज्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2011152, "chapter_id": 1226, "verse_number": "१-२२७-९६", "content_sanskrit": "द्वैपायनं च संपूज्य विसृज्य च नराधिपः।\nवार्ष्णेयमब्रवीद्राजा गन्तुकामं कृतक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2011153, "chapter_id": 1226, "verse_number": "१-२२७-९७", "content_sanskrit": "तव प्रसादाद्वार्ष्णेय राज्यं प्राप्तं मयाऽनघ।\nप्रसादादेव ते वीर शून्यं राष्ट्रं सुदुर्गमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2011154, "chapter_id": 1226, "verse_number": "१-२२७-९८", "content_sanskrit": "तवैव तु प्रसादेन राज्यस्थाश्च भवामहे।\nगतिस्त्वमापत्कालेऽपि पाण्डवानां च माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2011155, "chapter_id": 1226, "verse_number": "१-२२७-९९", "content_sanskrit": "ज्ञात्वा तु कृत्यं कर्तव्यं कारयस्व भवान्हि नः।\nयदिष्टमनुमन्तव्यं पाण्डवानां त्वयाऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2011156, "chapter_id": 1226, "verse_number": "१-२२७-१००x", "content_sanskrit": "श्रीवासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2011157, "chapter_id": 1226, "verse_number": "१-२२७-१००", "content_sanskrit": "त्वत्प्रभावान्महाराज्यं संप्राप्तं हि स्वधर्मतः।\nपितृपैतामहं राज्यं कथं न स्यात्तव प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2011158, "chapter_id": 1226, "verse_number": "१-२२७-१०१", "content_sanskrit": "धार्तराष्ट्रा दुराचाराः किं करिष्यन्ति पाण्डवान्।\nयथेष्टं पालय जगच्छश्वद्धर्मधुरं वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2011159, "chapter_id": 1226, "verse_number": "१-२२७-१०२", "content_sanskrit": "पुनः पुनश्च संहर्षाद्ब्राह्मणान्भर पौरव।\nअद्यैव नारदः श्रीमानागमिष्यति सत्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2011160, "chapter_id": 1226, "verse_number": "१-२२७-१०३", "content_sanskrit": "आदत्स्व तस्य वाक्यानि शासनं कुरु तस्य वै।\nएवमुक्त्वा ततः कुन्तीमभिवाद्य जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2011161, "chapter_id": 1226, "verse_number": "१-२२७-१०४", "content_sanskrit": "उवाच श्लक्ष्णया वाचा गमिष्यामि नमोस्तु ते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2011162, "chapter_id": 1226, "verse_number": "१-२२७-१०४x", "content_sanskrit": "कुन्त्युवाच।\nजातुषं गृहमासाद्य मया प्राप्तं यदानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2011163, "chapter_id": 1226, "verse_number": "१-२२७-१०५", "content_sanskrit": "आर्येण समभिज्ञातं त्वया वै यदुपुङ्गव।\nत्वया नाथेन गोविन्द दुःखं तीर्णं महत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2011164, "chapter_id": 1226, "verse_number": "१-२२७-१०६", "content_sanskrit": "त्वं हि नाथस्त्वनाथानां दरिद्राणां विशेषतः।\nसर्वदुःखानि शाम्यन्ति तव संदर्शनान्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2011165, "chapter_id": 1226, "verse_number": "१-२२७-१०७", "content_sanskrit": "स्मरस्वैनान्महाप्राज्ञ तेन जीवन्ति पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2011166, "chapter_id": 1226, "verse_number": "१-२२७-१०८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2011167, "chapter_id": 1226, "verse_number": "१-२२७-१०८", "content_sanskrit": "करिष्यामीति चामन्त्र्य अभिवाद्य पितृष्वसाम्।\nगमनाय मतिं चक्रे वासुदेवः सहानुगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2011168, "chapter_id": 1226, "verse_number": "१-२२७-१०९", "content_sanskrit": "तान्निवेश्य ततो वीरः सह रामेण कौरवान्।\nययौ द्वारवतीं राजन्पाण्डवानुमते तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2011169, "chapter_id": 1226, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि विदुरागमनराज्यलाभपर्वणि सप्तविंशत्यधिकद्विशततमोऽध्यायः॥ २२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}]