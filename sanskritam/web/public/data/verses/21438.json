[{"id": 7001438000, "chapter_id": 21438, "verse_number": "७-१-११-१", "content_sanskrit": "मुनय ऊचुः ।\nमन्वंतराणि सर्वाणि कल्पभेदांश्च सर्वशः ।\nतेष्वेवांतरसर्गं च प्रतिसर्गं च नो वद॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001438001, "chapter_id": 21438, "verse_number": "७-१-११-२", "content_sanskrit": "वायुरुवाच ।\nकालसंख्याविवृत्तस्य परार्धो ब्रह्मणस्स्मृतः ।\nतावांश्चैवास्य कालोन्यस्तस्यांते प्रतिसृज्यते॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001438002, "chapter_id": 21438, "verse_number": "७-१-११-३", "content_sanskrit": "दिवसे दिवसे तस्य ब्रह्मणः पूर्वजन्मनः ।\nचतुर्दशमहाभागा मनूनां परिवृत्तयः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001438003, "chapter_id": 21438, "verse_number": "७-१-११-४", "content_sanskrit": "अनादित्वादनंतत्वादज्ञेयत्वाच्च कृत्स्नशः ।\nमन्वंतराणि कल्पाश्च न शक्या वचनात्पृथक्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001438004, "chapter_id": 21438, "verse_number": "७-१-११-५", "content_sanskrit": "उक्तेष्वपि च सर्वेषु शृण्वतां वो वचो मम ।\nकिमिहास्ति फलं तस्मान्न पृथक्वक्तुमुत्सहे॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001438005, "chapter_id": 21438, "verse_number": "७-१-११-६", "content_sanskrit": "य एव खलु कल्पेषु कल्पः संप्रति वर्तते ।\nतत्र संक्षिप्य वर्तंते सृष्टयः प्रतिसृष्टयः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001438006, "chapter_id": 21438, "verse_number": "७-१-११-७", "content_sanskrit": "यस्त्वयं वर्तते कल्पो वाराहो नाम नामतः ।\nअस्मिन्नपि द्विजश्रेष्ठा मनवस्तु चतुर्दश॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001438007, "chapter_id": 21438, "verse_number": "७-१-११-८", "content_sanskrit": "स्वायंभुवादयस्सप्त सप्त सावर्णिकादयः ।\nतेषु वैवस्वतो नाम सप्तमो वर्तते मनुः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001438008, "chapter_id": 21438, "verse_number": "७-१-११-९", "content_sanskrit": "मन्वंतरेषु सर्वेषु सर्गसंहारवृत्तयः ।\nप्रायः समाभवंतीति तर्कः कार्यो विजानता॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001438009, "chapter_id": 21438, "verse_number": "७-१-११-१०", "content_sanskrit": "पूर्वकल्पे परावृत्ते प्रवृत्ते कालमारुते ।\nसमुन्मूलितमूलेषु वृक्षेषु च वनेषु च॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001438010, "chapter_id": 21438, "verse_number": "७-१-११-११", "content_sanskrit": "जगंति तृणवक्त्रीणि देवे दहति पावके ।\nवृष्ट्या भुवि निषिक्तायां विवेलेष्वर्णवेषु च॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001438011, "chapter_id": 21438, "verse_number": "७-१-११-१२", "content_sanskrit": "दिक्षु सर्वासु मग्नासु वारिपूरे महीयसि ।\nतदद्भिश्चटुलाक्षेपैस्तरंगभुजमण्डलैः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001438012, "chapter_id": 21438, "verse_number": "७-१-११-१३", "content_sanskrit": "प्रारब्धचण्डनृत्येषु ततः प्रलयवारिषु ।\nब्रह्मा नारायणो भूत्वा सुष्वाप सलिले सुखम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001438013, "chapter_id": 21438, "verse_number": "७-१-११-१४", "content_sanskrit": "इमं चोदाहरन्मंत्रं श्लोकं नारायणं प्रति ।\nतं शृणुध्वं मुनिश्रेष्ठास्तदर्थं चाक्षराश्रयम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001438014, "chapter_id": 21438, "verse_number": "७-१-११-१५", "content_sanskrit": "आपो नारा इति प्रोक्ता आपो वै नरसूनवः ।\nअयनं तस्य ता यस्मात्तेन नारायणः स्मृतः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001438015, "chapter_id": 21438, "verse_number": "७-१-११-१६", "content_sanskrit": "शिवयोगमयीं निद्रां कुर्वन्तं त्रिदशेश्वरम् ।\nबद्धांजलि पुटास्सिद्धा जनलोकनिवासिनः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001438016, "chapter_id": 21438, "verse_number": "७-१-११-१७", "content_sanskrit": "स्तोत्रैः प्रबोधयामासुः प्रभातसमये सुराः ।\nयथा सृष्ट्यादिसमये ईश्वरं श्रुतयः पुरा॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001438017, "chapter_id": 21438, "verse_number": "७-१-११-१८", "content_sanskrit": "ततः प्रबुद्ध उत्थाय शयनात्तोयमध्यगात् ।\nउदैक्षत दिशः सर्वा योगनिद्रालसेक्षणः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001438018, "chapter_id": 21438, "verse_number": "७-१-११-१९", "content_sanskrit": "नापश्यत्स तदा किंचित्स्वात्मनो व्यतिरेकि यत् ।\nसविस्मय इवासीनः परां चिंतामुपागमत्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001438019, "chapter_id": 21438, "verse_number": "७-१-११-२०", "content_sanskrit": "क्व सा भगवती या तु मनोज्ञा महती मही ।\nनानाविधमहाशैलनदीनगरकानना॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001438020, "chapter_id": 21438, "verse_number": "७-१-११-२१", "content_sanskrit": "एवं संचिंतयन्ब्रह्मा बुबुधे नैव भूस्थितिम् ।\nतदा सस्मार पितरं भगवंतं त्रिलोचनम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001438021, "chapter_id": 21438, "verse_number": "७-१-११-२२", "content_sanskrit": "स्मरणाद्देवदेवस्य भवस्यामिततेजसः ।\nज्ञातवान्सलिले मग्नां धरणीं धरणीपतिः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001438022, "chapter_id": 21438, "verse_number": "७-१-११-२३", "content_sanskrit": "ततो भूमेस्समुद्धारं कर्तुकामः प्रजापतिः ।\nजलक्रीडोचितं दिव्यं वाराहं रूपमस्मरत्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001438023, "chapter_id": 21438, "verse_number": "७-१-११-२४", "content_sanskrit": "महापर्वतवर्ष्माणं महाजलदनिःस्वनम् ।\nनीलमेघप्रतीकाशं दीप्तशब्दं भयानकम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001438024, "chapter_id": 21438, "verse_number": "७-१-११-२५", "content_sanskrit": "पीनवृत्तघनस्कंधपीनोन्नतकटीतटम् ।\nह्रस्ववृत्तोरुजंघाग्रं सुतीक्ष्णपुरमण्डलम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001438025, "chapter_id": 21438, "verse_number": "७-१-११-२६", "content_sanskrit": "पद्मरागमणिप्रख्यं वृत्तभीषणलोचनम् ।\nवृत्तदीर्घमहागात्रं स्तब्धकर्णस्थलोज्ज्वलम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001438026, "chapter_id": 21438, "verse_number": "७-१-११-२७", "content_sanskrit": "उदीर्णोच्छ्वासनिश्वासघूर्णितप्रलयार्णवम् ।\nविस्फुरत्सुसटाच्छन्नकपोलस्कंधबंधुरम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001438027, "chapter_id": 21438, "verse_number": "७-१-११-२८", "content_sanskrit": "मणिभिर्भूषणैश्चित्रैर्महारत्नैःपरिष्कृतम् ।\nविराजमानं विद्युद्भिर्मेघसंघमिवोन्नतम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001438028, "chapter_id": 21438, "verse_number": "७-१-११-२९", "content_sanskrit": "आस्थाय विपुलं रूपं वाराहममितं विधिः ।\nपृथिव्युद्धरणार्थाय प्रविवेश रसातलम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001438029, "chapter_id": 21438, "verse_number": "७-१-११-३०", "content_sanskrit": "स तदा शुशुभे ऽतीव सूकरो गिरिसंनिभः ।\nलिंगाकृतेर्महेशस्य पादमूलं गतो यथा॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001438030, "chapter_id": 21438, "verse_number": "७-१-११-३१", "content_sanskrit": "ततस्स सलिले मग्नां पृथिवीं पृथिवींधरः ।\nउद्धृत्यालिंग्य दंष्ट्राभ्यामुन्ममज्ज रसातलात्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001438031, "chapter_id": 21438, "verse_number": "७-१-११-३२", "content_sanskrit": "तं दृष्ट्वा मुनयस्सिद्धा जनलोकनिवासिनः ।\nमुमुदुर्ननृतुर्मूर्ध्नि तस्य पुष्पैरवाकिरन्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001438032, "chapter_id": 21438, "verse_number": "७-१-११-३३", "content_sanskrit": "वपुर्महावराहस्य शुशुभे पुष्पसंवृतम् ।\nपतद्भिरिव खद्योतैः प्राशुरंजनपर्वतः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001438033, "chapter_id": 21438, "verse_number": "७-१-११-३४", "content_sanskrit": "ततः संस्थानमानीय वराहो महतीं महीम् ।\nस्वमेव रूपमास्थाय स्थापयामास वै विभुः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001438034, "chapter_id": 21438, "verse_number": "७-१-११-३५", "content_sanskrit": "पृथिवीं च समीकृत्य पृथिव्यां स्थापयन्गिरीन् ।\nभूराद्यांश्चतुरो लोकान् कल्पयामास पूर्ववत्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]