[{"id": 2001236, "chapter_id": 1016, "verse_number": "१-१७-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001237, "chapter_id": 1016, "verse_number": "१-१७-१", "content_sanskrit": "एतस्मिन्नेव काले तु भगिन्यौ ते तपोधन।\nअपश्यतां समायान्तमुच्चैः श्रवसमन्तिकात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001238, "chapter_id": 1016, "verse_number": "१-१७-२", "content_sanskrit": "यं तु देवगणाः सर्वे हृष्टरूपमपूजयन्।\nमथ्यमानेऽमृते जातमश्वरत्नमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001239, "chapter_id": 1016, "verse_number": "१-१७-३", "content_sanskrit": "अमोघबलमश्वानामुत्तमं जविनां वरम्।\nश्रीमन्तमजरं दिव्यं सर्वलक्षणपूजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001240, "chapter_id": 1016, "verse_number": "१-१७-४x", "content_sanskrit": "शौनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001241, "chapter_id": 1016, "verse_number": "१-१७-४", "content_sanskrit": "कथं तदमृतं देवैर्मथितं क्व च शंस मे।\nकारणं चात्र मथने संजातममृतात्परम्॥\nयत्र जज्ञे महावीर्यः सोऽश्वराजो महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001242, "chapter_id": 1016, "verse_number": "१-१७-५x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001243, "chapter_id": 1016, "verse_number": "१-१७-५", "content_sanskrit": "ज्वलन्तमचलं मेरुं तेजोराशिमनुत्तमम्।\nआक्षिपन्तं प्रभां भानोः स्वशृङ्गैः काञ्चनोज्ज्वलैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001244, "chapter_id": 1016, "verse_number": "१-१७-६", "content_sanskrit": "कनकाभरणं चित्रं देवगन्धर्वसेवितम्।\nअप्रमेयमनाधृष्यमधर्मबहुलैर्जनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001245, "chapter_id": 1016, "verse_number": "१-१७-७", "content_sanskrit": "व्यालैरावारितं घोरैर्दिव्यौषधिविदीपितम्।\nनाकमावृत्य तिष्ठन्तमुच्छ्रयेण महागिरिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001246, "chapter_id": 1016, "verse_number": "१-१७-८", "content_sanskrit": "अगम्यं मनसाप्यन्यैर्नदीवृक्षसमन्वितम्।\nनानापतगसङ्घैश्च नादितं सुमनोहरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001247, "chapter_id": 1016, "verse_number": "१-१७-९", "content_sanskrit": "तस्य शृङ्गमुपारुह्य बहुरत्नाचितं शुभम्।\nअनन्तकल्पमद्वन्द्वं सुराः सर्वे महौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001248, "chapter_id": 1016, "verse_number": "१-१७-१०", "content_sanskrit": "ते मन्त्रयितुमारब्धास्तत्रासीना दिवौकसः।\nअमृताय समागम्य तपोनियमसंयुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001249, "chapter_id": 1016, "verse_number": "१-१७-११", "content_sanskrit": "तत्र नारायणो देवो ब्रह्माणमिदमब्रवीत्।\nचिन्तयत्सु सुरेष्वेवं मन्त्रयत्सु च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001250, "chapter_id": 1016, "verse_number": "१-१७-१२", "content_sanskrit": "देवैरसुरसङ्घैश्च मथ्यतां कलशोदधिः।\nभविष्यत्यमृतं तत्र मथ्यमाने महोदधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001251, "chapter_id": 1016, "verse_number": "१-१७-१३", "content_sanskrit": "सर्वौषधीः समावाप्य सर्वरत्नानि चैव ह।\nमन्थध्वयुदधिं देवा वेत्स्यध्वममृतं ततः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001252, "chapter_id": 1016, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि सप्तदशोऽध्यायः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]