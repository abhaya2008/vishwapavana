[{"id": 5000192000, "chapter_id": 9192, "verse_number": "२-११५-१", "content_sanskrit": "ततो निक्षिप्य मातऽ: स अयोध्यायां दृढव्रत: ।\nभरत: शोकसन्तप्तो गुरूनिदमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000192001, "chapter_id": 9192, "verse_number": "२-११५-२", "content_sanskrit": "नन्दिग्रामं गमिष्यामि सर्वानामन्त्रये ऽद्य व: ।\nतत्र दु:खमिदं सर्वं सहिष्ये राघवं विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000192002, "chapter_id": 9192, "verse_number": "२-११५-३", "content_sanskrit": "गतश्च हि दिवं राजा वनस्थश्च गुरुर्मम ।\nरामं प्रतीक्षे राज्याय स हि राजा महायशा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000192003, "chapter_id": 9192, "verse_number": "२-११५-४", "content_sanskrit": "एतच्छ्रुत्वा शुभं वाक्यं भरतस्य महात्मन: ।\nअब्रुवन् मन्त्रिण: सर्वे वसिष्ठश्च पुरोहित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000192004, "chapter_id": 9192, "verse_number": "२-११५-५", "content_sanskrit": "सुभृशं श्लाघनीयं च यदुक्तं भरत त्वया ।\nवचनं भ्रातृवात्सल्यादनुरूपं तवैव तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000192005, "chapter_id": 9192, "verse_number": "२-११५-६", "content_sanskrit": "नित्यं ते बन्धुलुब्धस्य तिष्ठतो भ्रातृसौहृदे ।\nआर्यमार्गं प्रपन्नस्य नानुमन्येत क: पुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000192006, "chapter_id": 9192, "verse_number": "२-११५-७", "content_sanskrit": "मन्त्रिणां वचनं श्रुत्वा यथाभिलषितं प्रियम् ।\nअब्रवीत्सारथिं वाक्यं रथो मे युज्यतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000192007, "chapter_id": 9192, "verse_number": "२-११५-८", "content_sanskrit": "प्रहृष्टवदन: सर्वा मातऽ: समभिवाद्य स: ।\nआरुरोह रथं श्रीमान् शत्रुघ्नेन समन्वित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000192008, "chapter_id": 9192, "verse_number": "२-११५-९", "content_sanskrit": "आरुह्य च रथं शीघ्रं शत्रुघ्नभरतावुभौ।\nययतु: परमप्रीतौ वृतौ मन्त्रिपुरोहितै: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000192009, "chapter_id": 9192, "verse_number": "२-११५-१०", "content_sanskrit": "अग्रतो गुरवस्तत्र वसिष्ठप्रमुखा द्विजा: ।\nप्रययु: प्राङ्मुखा: सर्वे नन्दिग्रामो यतो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000192010, "chapter_id": 9192, "verse_number": "२-११५-११", "content_sanskrit": "बलं च तदनाहूतं गजाश्वरथसङ्कुलम् ।\nप्रययौ भरते याते सर्वे च पुरवासिन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000192011, "chapter_id": 9192, "verse_number": "२-११५-१२", "content_sanskrit": "रथस्थ: स हि धर्मात्मा भरतो भ्रातृवत्सल: ।\nनन्दिग्रामं ययौ तूर्णं शिरस्याधाय पादुके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000192012, "chapter_id": 9192, "verse_number": "२-११५-१३", "content_sanskrit": "ततस्तु भरत: क्षिप्रं नन्दिग्रामं प्रविश्य स: ।\nअवतीर्य्य रथात्तूर्णं गुरूनिदमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000192013, "chapter_id": 9192, "verse_number": "२-११५-१४", "content_sanskrit": "एतद्राज्यं मम भ्रात्रा दत्तं संन्यासवत् स्वयम् ।\nयोगक्षेमवहे चेमे पादुके हेमभूषिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000192014, "chapter_id": 9192, "verse_number": "२-११५-१५", "content_sanskrit": "भरत: शिरसा कृत्वा संन्यासं पादुके तत: ।\nअब्रवीद्दु:खसन्तप्त: सर्वं प्रकृतिमण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000192015, "chapter_id": 9192, "verse_number": "२-११५-१६", "content_sanskrit": "छत्रं धारयत क्षिप्रमार्यपादाविमौ मतौ ।\nआभ्यां राज्ये स्थितो धर्म: पादुकाभ्यां गुरोर्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000192016, "chapter_id": 9192, "verse_number": "२-११५-१७", "content_sanskrit": "भ्रात्रा हि मयि संन्यासो निक्षिप्त: सौहृदादयम् ।\nतमिमं पालयिष्यामि राघवागमनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000192017, "chapter_id": 9192, "verse_number": "२-११५-१८", "content_sanskrit": "क्षिप्रं संयोजयित्वा तु राघवस्य पुन: स्वयम् ।\nचरणौ तौ तु रामस्य द्रक्ष्यामि सहपादुकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000192018, "chapter_id": 9192, "verse_number": "२-११५-१९", "content_sanskrit": "ततो निक्षिप्तभारो ऽहं राघवेण समागत: ।\nनिवेद्य गुरवे राज्यं भजिष्ये गुरुवृत्तिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000192019, "chapter_id": 9192, "verse_number": "२-११५-२०", "content_sanskrit": "राघवाय च संन्यासं दत्त्वे मे वरपादुके ।\nराज्यं चेदमयोध्यां च धूतपापो भवामि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000192020, "chapter_id": 9192, "verse_number": "२-११५-२१", "content_sanskrit": "अभिषिक्ते तु काकुत्स्थे प्रहृष्टमुदिते जने ।\nप्रीतिर्मम यशश्चैव भवेद्राज्याच्चतुर्गुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000192021, "chapter_id": 9192, "verse_number": "२-११५-२२", "content_sanskrit": "एवं तु विलपन् दीनो भरत: स महायशा: ।\nनन्दिग्रामे ऽकरोद्राज्यं दु:खितो मन्त्रिभि: सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000192022, "chapter_id": 9192, "verse_number": "२-११५-२३", "content_sanskrit": "स वल्कलजटाधारी मुनिवेषधर: प्रभु: ।\nनन्दिग्रामे ऽवसद्वीर: ससैन्यो भरतस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000192023, "chapter_id": 9192, "verse_number": "२-११५-२४", "content_sanskrit": "रामागमनमाकाङ्क्षन् भरतो भ्रातृवत्सल: ।\nभ्रातुर्वचनकारी च प्रतिज्ञापारगस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000192024, "chapter_id": 9192, "verse_number": "२-११५-२५", "content_sanskrit": "पादुके त्वभिषिच्याथ नन्द्रिग्रामे ऽवसत्तदा ।\nभरत: शासनं सर्वं पादुकाभ्यां न्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000192025, "chapter_id": 9192, "verse_number": "२-११५-२६", "content_sanskrit": "ततस्तु भरत: श्रीमानभिषिच्यार्य्यपादुके ।\nतदधीनस्तदा राज्यं कारयामास सर्वदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000192026, "chapter_id": 9192, "verse_number": "२-११५-२७", "content_sanskrit": "तदा हि यत्कार्य्यमुपैति किञ्चिदुपायनं चोपहृतं महार्हम् ।\nस पादुकाभ्यां प्रथमं निवेद्य चकार पश्चाद्भरतो यथावत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000192027, "chapter_id": 9192, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदयोध्याकाण्डे पञ्चदशोत्तरशततम: सर्ग: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]