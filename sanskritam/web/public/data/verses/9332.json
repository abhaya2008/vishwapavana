[{"id": 5000332000, "chapter_id": 9332, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे षष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000332001, "chapter_id": 9332, "verse_number": "४-६०-१", "content_sanskrit": "ततः कृतोदकं स्नातं तं गृध्रं हरियूथपाः।\nउपविष्टा गिरौ रम्ये परिवार्य समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000332002, "chapter_id": 9332, "verse_number": "४-६०-२", "content_sanskrit": "तमङ्गदमुपासीनं तैः सर्वैर्हरिभिर्वृतम्।\nजनितप्रत्ययो हर्षात् सम्पातिः पुनरब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000332003, "chapter_id": 9332, "verse_number": "४-६०-३", "content_sanskrit": "कृत्वा निःशब्दमेकाग्राः शृण्वन्तु हरयो मम।\nतथ्यं संकीर्तयिष्यामि यथा जानामि मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000332004, "chapter_id": 9332, "verse_number": "४-६०-४", "content_sanskrit": "अस्य विन्ध्यस्य शिखरे पतितोऽस्मि पुरानघ।\nसूर्यतापपरीताङ्गो निर्दग्धः सूर्यरश्मिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000332005, "chapter_id": 9332, "verse_number": "४-६०-५", "content_sanskrit": "लब्धसंज्ञस्तु षड्रात्राद् विवशो विह्वलन्निव।\nवीक्षमाणो दिशः सर्वा नाभिजानामि किंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000332006, "chapter_id": 9332, "verse_number": "४-६०-६", "content_sanskrit": "ततस्तु सागरान् शैलान् नदीः सर्वाः सरांसि च।\nवनानि च प्रदेशांश्च निरीक्ष्य मतिरागता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000332007, "chapter_id": 9332, "verse_number": "४-६०-७", "content_sanskrit": "हृष्टपक्षिगणाकीर्णः कन्दरोदरकूटवान्।\nदक्षिणस्योदधेस्तीरे विन्ध्योऽयमिति निश्चितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000332008, "chapter_id": 9332, "verse_number": "४-६०-८", "content_sanskrit": "आसीच्चात्राश्रमं पुण्यं सुरैरपि सुपूजितम्।\nऋषिर्निशाकरो नाम यस्मिन्नुग्रतपाऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000332009, "chapter_id": 9332, "verse_number": "४-६०-९", "content_sanskrit": "अष्टौ वर्षसहस्राणि तेनास्मिन्नृषिणा गिरौ।\nवसतो मम धर्मज्ञे स्वर्गते तु निशाकरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000332010, "chapter_id": 9332, "verse_number": "४-६०-१०", "content_sanskrit": "अवतीर्य च विन्ध्याग्रात् कृच्छ्रेण विषमाच्छनैः।\nतीक्ष्णदर्भां वसुमतीं दुःखेन पुनरागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000332011, "chapter_id": 9332, "verse_number": "४-६०-११", "content_sanskrit": "तमृषिं द्रष्टुकामोऽस्मि दुःखेनाभ्यागतो भृशम्।\nजटायुषा मया चैव बहुशोऽधिगतो हि सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000332012, "chapter_id": 9332, "verse_number": "४-६०-१२", "content_sanskrit": "तस्याश्रमपदाभ्याशे ववुर्वाताः सुगन्धिनः।\nवृक्षो नापुष्पितः कश्चिदफलो वा न दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000332013, "chapter_id": 9332, "verse_number": "४-६०-१३", "content_sanskrit": "उपेत्य चाश्रमं पुण्यं वृक्षमूलमुपाश्रितः।\nद्रष्टुकामः प्रतीक्षे च भगवन्तं निशाकरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000332014, "chapter_id": 9332, "verse_number": "४-६०-१४", "content_sanskrit": "अथ पश्यामि दूरस्थमृषिं ज्वलिततेजसम्।\nकृताभिषेकं दुर्धर्षमुपावृत्तमुदङ्मुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000332015, "chapter_id": 9332, "verse_number": "४-६०-१५", "content_sanskrit": "तमृक्षाः सृमरा व्याघ्राः सिंहा नानासरीसृपाः।\nपरिवार्योपगच्छन्ति दातारं प्राणिनो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000332016, "chapter_id": 9332, "verse_number": "४-६०-१६", "content_sanskrit": "ततः प्राप्तमृषिं ज्ञात्वा तानि सत्त्वानि वै ययुः।\nप्रविष्टे राजनि यथा सर्वं सामात्यकं बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000332017, "chapter_id": 9332, "verse_number": "४-६०-१७", "content_sanskrit": "ऋषिस्तु दृष्ट्वा मां तुष्टः प्रविष्टश्चाश्रमं पुनः।\nमुहूर्तमात्रान्निर्गम्य ततः कार्यमपृच्छत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000332018, "chapter_id": 9332, "verse_number": "४-६०-१८", "content_sanskrit": "सौम्य वैकल्यतां दृष्ट्वा रोम्णां ते नावगम्यते।\nअग्निदग्धाविमौ पक्षौ प्राणाश्चापि शरीरके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000332019, "chapter_id": 9332, "verse_number": "४-६०-१९", "content_sanskrit": "गृध्रौ द्वौ दृष्टपूर्वौ मे मातरिश्वसमौ जवे।\nगृध्राणां चैव राजानौ भ्रातरौ कामरूपिणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000332020, "chapter_id": 9332, "verse_number": "४-६०-२०", "content_sanskrit": "ज्येष्ठोऽवितस्त्वं सम्पाते जटायुरनुजस्तव।\nमानुषं रूपमास्थाय गृह्णीतां चरणौ मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000332021, "chapter_id": 9332, "verse_number": "४-६०-२१", "content_sanskrit": "किं ते व्याधिसमुत्थानं पक्षयोः पतनं कथम्।\nदण्डो वायं धृतः केन सर्वमाख्याहि पृच्छतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000332022, "chapter_id": 9332, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे षष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]