[{"id": 40020354, "chapter_id": 9332, "verse_number": "1", "content_sanskrit": "अथ लोकेश्वरोत्सृष्टा तत्र कालेन केनचित् । निद्रा समभवत्तीव्रा कुम्भकर्णस्य रूपिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40020355, "chapter_id": 9332, "verse_number": "2", "content_sanskrit": "ततो भ्रातरमासीनं कुम्भकर्णो ऽब्रवीद्वचः । निद्रा मां बाधते राजन्कारयस्व ममालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40020356, "chapter_id": 9332, "verse_number": "3", "content_sanskrit": "विनियुक्तास्ततो राज्ञा शिल्पिनो विश्वकर्मवत् । विस्तीर्णं योजनं शुभ्रं ततो द्विगुणमायतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40020357, "chapter_id": 9332, "verse_number": "4", "content_sanskrit": "दर्शनीयं निराबाधं कुम्भकर्णस्य चक्रिरे । स्फाटिकैः काञ्चनैश्चित्रैः स्तम्भैः सर्वत्र शोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40020358, "chapter_id": 9332, "verse_number": "5", "content_sanskrit": "वैडूर्यकृतसोपानं किङ्किणीजालकं तथा । दान्ततोरणविन्यस्तं वज्रस्फटिकवेदिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40020359, "chapter_id": 9332, "verse_number": "6", "content_sanskrit": "मनोहरं सर्वसुखं कारयामास राक्षसः । सर्वत्र सुखदं नित्यं मेरोः पुण्यां गुहामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40020360, "chapter_id": 9332, "verse_number": "7", "content_sanskrit": "तत्र निद्रां समाविष्टः कुम्भकर्णो महाबलः । बहून्यब्दसहस्राणि शयानो न प्रबुद्ध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40020361, "chapter_id": 9332, "verse_number": "8", "content_sanskrit": "निद्राभिभूते तु तदा कुम्भकर्णे दशाननः । देवर्षियक्षगन्धर्वान्सञ्जघ्ने हि निरङ्कुशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40020362, "chapter_id": 9332, "verse_number": "9", "content_sanskrit": "उद्यानानि च चित्राणि नन्दनादीनि यानि च । तानि गत्वा सुसङक्रुद्धो भिनत्ति स्म दशाननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40020363, "chapter_id": 9332, "verse_number": "10", "content_sanskrit": "नदीं गज इव क्रीडन्वृक्षान्वायुरिव क्षिपन् । नगान्व्रज्र इवोत्सृष्टो विध्वंसयति राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40020364, "chapter_id": 9332, "verse_number": "11", "content_sanskrit": "तथावृत्तं तु विज्ञाय दशग्रीवं धनेश्वरः । कुलानुरूपं धर्मज्ञो वृत्तं संस्मृत्य चात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40020365, "chapter_id": 9332, "verse_number": "12", "content_sanskrit": "सौभ्रात्रदर्शनार्थं तु दूतं वैश्रवणस्तदा । लङ्कां सम्प्रेषयामास दशग्रीवस्य वै हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40020366, "chapter_id": 9332, "verse_number": "13", "content_sanskrit": "स गत्वा नगरीं लङ्कामाससाद विभीषणम् । मानितस्तेन धर्मेण पृष्टश्चागमनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40020367, "chapter_id": 9332, "verse_number": "14", "content_sanskrit": "पृष्ट्वा च कुशलं राज्ञो ज्ञातीनां च बिभीषणः । सभायां दर्शयामास तमासीनं दशाननम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40020368, "chapter_id": 9332, "verse_number": "15", "content_sanskrit": "स दृष्ट्वा तत्र राजानं दीप्यमानं स्वतेजसा । जयेति वाचा सम्पूज्य तूष्णीं समभिवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40020369, "chapter_id": 9332, "verse_number": "16", "content_sanskrit": "तं तत्रोत्तमपर्यङ्के वरास्तरणशोभिते । उपविष्टं दशग्रीवं दूतो वाक्यमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40020370, "chapter_id": 9332, "verse_number": "17", "content_sanskrit": "राजन्वदामि ते सर्वं भ्राता तव यदब्रवीत् । उभयोः सदृशं वीर वृत्तस्य च कुलस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40020371, "chapter_id": 9332, "verse_number": "18", "content_sanskrit": "साधु पर्याप्तमेतावत्कृतश्चारित्रसङ्ग्रहः । साधु धर्मे व्यवस्थानं क्रियतां यदि शक्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40020372, "chapter_id": 9332, "verse_number": "19", "content_sanskrit": "दृष्टं मे नन्दनं भग्नमृषयो निहताः श्रुताः । देवतानां समुद्योगस्त्वत्तो राजन्मम श्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40020373, "chapter_id": 9332, "verse_number": "20", "content_sanskrit": "निराकृतश्च बहुशस्त्वया ऽहं राक्षसाधिप । अपराद्धा हि बाल्याच्च रमणीयाः स्वबान्धवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40020374, "chapter_id": 9332, "verse_number": "21", "content_sanskrit": "अहं तु हिमवत्पृष्ठं गतो धर्ममुपासितुम् । रौद्रं व्रत्तं समास्थाय नियतो नियतेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40020375, "chapter_id": 9332, "verse_number": "22", "content_sanskrit": "तत्र देवो मया दृष्टः सह देव्या मया प्रभुः । सव्यं चक्षुर्मया दैवात्तत्र देव्यां निपातितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40020376, "chapter_id": 9332, "verse_number": "23", "content_sanskrit": "का न्वियं स्यादिति शुभा न खल्वन्येन हेतुना । रूपं ह्यनुपमं कृत्वा रुद्राणी तत्र तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40020377, "chapter_id": 9332, "verse_number": "24", "content_sanskrit": "देव्या दिव्यप्रभावेण दग्धं सव्यं ममेक्षणम् । रेणुध्वस्तमिव ज्योतिः पिङ्गुलत्वमुपागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40020378, "chapter_id": 9332, "verse_number": "25", "content_sanskrit": "ततो ऽहमन्यद्विस्तीर्णं गत्वा तस्य गिरेस्तटम् । तूष्णीं वर्षशतान्यष्टौ समाधारं महाव्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40020379, "chapter_id": 9332, "verse_number": "26", "content_sanskrit": "समाप्ते नियमे तस्मिंस्तत्र देवो महेश्वरः । प्रीतः प्रीतेन मनसा प्राह वाक्यमिदं प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40020380, "chapter_id": 9332, "verse_number": "27", "content_sanskrit": "पैङ्गल्यं यदवाप्तं हि देव्या रूपनिरीक्षणात् । प्रीतो ऽस्मि तव धर्मज्ञ तपसा नेन सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40020381, "chapter_id": 9332, "verse_number": "28", "content_sanskrit": "मया चैतद्व्रतं चीर्णं त्वया चैव धनाधिप । तृतीयः पुरुषो नास्ति यश्चरेव्रतमीदृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40020382, "chapter_id": 9332, "verse_number": "29", "content_sanskrit": "व्रतं सुनिश्चयं ह्येतन्मया ह्युत्पादितं पुरा । तत्सखित्वं मया सौम्य रोचयस्व धनेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40020383, "chapter_id": 9332, "verse_number": "30", "content_sanskrit": "तपसा निर्जितश्चैव सखा भव ममानघ । देव्या दग्धं प्रभावेण यच्च सव्यं तवेक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40020384, "chapter_id": 9332, "verse_number": "31", "content_sanskrit": "एकाक्षिपिङ्गलेत्येव नाम स्थास्यति शाश्वतम् । एवं तेन सखित्वं च प्राप्यानुज्ञां च शङ्करात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40020385, "chapter_id": 9332, "verse_number": "32", "content_sanskrit": "आगत्य च श्रुतो ऽयं मे तव पापविनिश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40020386, "chapter_id": 9332, "verse_number": "33", "content_sanskrit": "तदधर्मिष्ठसंयोगान्निवर्त कुलदूषणात् । चिन्त्यते हि वधोपायः सर्षिसङ्घैः सुरैस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40020387, "chapter_id": 9332, "verse_number": "34", "content_sanskrit": "एवमुक्तो दशग्रीवः क्रुद्धसंरक्तलोचनः । हस्तौ दन्तांश्च सम्पीड्य वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40020388, "chapter_id": 9332, "verse_number": "35", "content_sanskrit": "विज्ञातं ते मया दूत वाक्यं यस्य प्रभाषसे । नैतत्त्वमसि नैवासौ भ्रात्रा येनासि चोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40020389, "chapter_id": 9332, "verse_number": "36", "content_sanskrit": "हितं नैष ममैतद्धि ब्रवीति धनरक्षकः । महेश्वरसखित्वं तु मूढ श्रावयते किल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40020390, "chapter_id": 9332, "verse_number": "37", "content_sanskrit": "न चेदं क्षमणीयं मे यदेतद्भाषितं त्वया । यदेतावन्मया कालं दूत तस्य तु मर्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40020391, "chapter_id": 9332, "verse_number": "38", "content_sanskrit": "न हन्तव्यो गुरुर्ज्येष्ठो मया ऽयमिति मन्यते । तस्य त्विदानीं श्रुत्वा मे वाक्यमेषा कृता मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40020392, "chapter_id": 9332, "verse_number": "39", "content_sanskrit": "त्रीँल्लोकानपि जेष्यामि बाहुवीर्यमुपाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40020393, "chapter_id": 9332, "verse_number": "40", "content_sanskrit": "एतन्मुहूर्तमेवाहं तस्यैकस्य तु वै कृते । चतुरो लोकपालांस्तान्नयिष्यामि यमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40020394, "chapter_id": 9332, "verse_number": "41", "content_sanskrit": "एवमुक्त्वा तु लङ्केशो दूतं खड्गेन जघ्निवान् । ददौ भक्षयितुं ह्येनं राक्षसानां दुरात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40020395, "chapter_id": 9332, "verse_number": "42", "content_sanskrit": "एवं कृतस्वस्त्ययनो रथमारुह्य रावणः । त्रैलोक्यविजयाकाङ्क्षी ययौ यत्र धनेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]