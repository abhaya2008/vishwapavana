[{"id": 7000366000, "chapter_id": 20366, "verse_number": "२-३८-१", "content_sanskrit": "सूत उवाच ।\nएवं संबोधितो वेनः पापभावं गतः किल ।\nपुरुषेण तेन जैनेन महापापेन मोहितः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000366001, "chapter_id": 20366, "verse_number": "२-३८-२", "content_sanskrit": "नमस्कृत्य ततः पादौ तस्यैव च दुरात्मनः ।\nवेदधर्मं परित्यज्य सत्यधर्मादिकां क्रियाम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000366002, "chapter_id": 20366, "verse_number": "२-३८-३", "content_sanskrit": "सुयज्ञानां निवृत्तिः स्याद्वेदानां हितथैव च ।\nपुण्यशास्त्रमयो धर्मस्तदा नैव प्रवर्तितः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000366003, "chapter_id": 20366, "verse_number": "२-३८-४", "content_sanskrit": "सर्वपापमयो लोकः संजातस्तस्य शासनात् ।\nनैव यागाश्च वेदाश्च धर्मशास्त्रार्थमुत्तमम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000366004, "chapter_id": 20366, "verse_number": "२-३८-५", "content_sanskrit": "न दानाध्ययनं विप्रास्तस्मिञ्छासति पार्थिवे ।\nएवं धर्मप्रलोपोभून्महत्पापं प्रवर्तितम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000366005, "chapter_id": 20366, "verse_number": "२-३८-६", "content_sanskrit": "अंगेन वार्यमाणस्तु अन्यथा कुरुते भृशम् ।\nन ननाम पितुः पादौ मातुश्चैव दुरात्मवान्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000366006, "chapter_id": 20366, "verse_number": "२-३८-७", "content_sanskrit": "सनकस्यापि विप्रस्य अहमेकः प्रतापवान् ।\nपित्रा निवार्यमाणश्च मात्रा चैव दुरात्मवान्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000366007, "chapter_id": 20366, "verse_number": "२-३८-८", "content_sanskrit": "न करोति शुभं पुण्यं तीर्थदानादिकं कदा ।\nआत्मभावानुरूपं च बहुकालं महायशाः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000366008, "chapter_id": 20366, "verse_number": "२-३८-९", "content_sanskrit": "पुनः सर्वैर्विचार्यैवं कस्मात्पापी व्यजायत ।\nअंगप्रजापतेः पुत्रो वंशलाञ्छनमागतः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000366009, "chapter_id": 20366, "verse_number": "२-३८-१०", "content_sanskrit": "पुनः पप्रच्छ धर्मात्मा सुतां मृत्योर्महात्मनः ।\nकस्य दोषात्समुत्पन्नो वद सत्यं मम प्रिये॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000366010, "chapter_id": 20366, "verse_number": "२-३८-११", "content_sanskrit": "सुनीथोवाच ।\nपूर्वमेव स्ववृत्तांतमात्मपुण्यं च नंदिनी ।\nसमाचष्ट च अंगाय मम दोषान्महामते॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000366011, "chapter_id": 20366, "verse_number": "२-३८-१२", "content_sanskrit": "बाल्ये कृतं मया पापं सुशंखस्य महात्मनः ।\nतपसि संस्थितस्यापि नान्यत्किंचित्कृतं मया॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000366012, "chapter_id": 20366, "verse_number": "२-३८-१३", "content_sanskrit": "शप्ताहं कुप्यता तेन दुष्टा ते संततिर्भवेत् ।\nइति जाने महाभाग तेनायं दुष्टतां गतः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000366013, "chapter_id": 20366, "verse_number": "२-३८-१४", "content_sanskrit": "समाकर्ण्य महातेजास्तया सह वनं ययौ ।\nगते तस्मिन्महाभागे सभार्ये च वने तदा॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000366014, "chapter_id": 20366, "verse_number": "२-३८-१५", "content_sanskrit": "सप्तैते ऋषयस्तत्र वेनपार्श्वं गतास्तथा ।\nसमाहूय ततः प्रोचुरंगस्य तनयं प्रति॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000366015, "chapter_id": 20366, "verse_number": "२-३८-१६", "content_sanskrit": "ऋषय ऊचुः ।\nमा वेन साहसं कार्षीःप्रजापालो भवानिह ।\nत्वया सर्वमिदं लोकं त्रैलोक्यं सचराचरम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000366016, "chapter_id": 20366, "verse_number": "२-३८-१७", "content_sanskrit": "धर्मे चैव महाभाग सकलं हि प्रतिष्ठितम् ।\nपापकर्मपरित्यज्य पुण्यं कर्म समाचर॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000366017, "chapter_id": 20366, "verse_number": "२-३८-१८", "content_sanskrit": "एवमुक्तेषु तेष्वेव प्रहसन्वाक्यमब्रवीत् ।\nवेन उवाच ।\nअहमेव परो धर्मोऽहमेवार्हः सनातनः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000366018, "chapter_id": 20366, "verse_number": "२-३८-१९", "content_sanskrit": "अहं धाता अहं गोप्ता अहं वेदार्थ एव च ।\nअहं धर्मो महापुण्यो जैनधर्मः सनातनः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000366019, "chapter_id": 20366, "verse_number": "२-३८-२०", "content_sanskrit": "मामेव कर्मणा विप्रा भजध्वं धर्मरूपिणम् ।\nऋषय उचुः ।\nब्राह्मणाः क्षत्त्रिया वैश्यास्त्रयोवर्णा द्विजातयः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000366020, "chapter_id": 20366, "verse_number": "२-३८-२१", "content_sanskrit": "सर्वेषामेव वर्णानां श्रुतिरेषा सनातनी ।\nवेदाचारेण वर्तंते तेन जीवंति जंतवः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000366021, "chapter_id": 20366, "verse_number": "२-३८-२२", "content_sanskrit": "ब्रह्मवंशात्समुद्भूतो भवान्ब्राह्मण एव च ।\nपश्चाद्राजा पृथिव्याश्च संजातः कृतविक्रमः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000366022, "chapter_id": 20366, "verse_number": "२-३८-२३", "content_sanskrit": "राजपुण्येन राजेंद्र सुखं जीवंति वै द्विजाः ।\nराज्ञः पापेन नश्यंति तस्मात्पुण्यं समाचर॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000366023, "chapter_id": 20366, "verse_number": "२-३८-२४", "content_sanskrit": "समादृतस्त्वया धर्मः कृतश्चापि नराधिप ।\nत्रेतायुगस्य कर्मापि द्वापरस्य तथा नहि॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000366024, "chapter_id": 20366, "verse_number": "२-३८-२५", "content_sanskrit": "कलेश्चैव प्रवेशं तु वर्त्तयिष्यंति मानवाः ।\nजैनधर्मं समाश्रित्य सर्वे पापप्रमोहिताः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000366025, "chapter_id": 20366, "verse_number": "२-३८-२६", "content_sanskrit": "वेदाचारं परित्यज्य पापं यास्यंति मानवाः ।\nपापस्य मूलमेवं वै जैनधर्मं न संशयः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000366026, "chapter_id": 20366, "verse_number": "२-३८-२७", "content_sanskrit": "अनेन मुग्धा राजेंद्र महामोहेन पातिताः ।\nमानवाः पापसंघातास्तेषां नाशाय नान्यथा॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000366027, "chapter_id": 20366, "verse_number": "२-३८-२८", "content_sanskrit": "भविष्यत्येव गोविंदः सर्वपापापहारकः ।\nस्वेच्छारूपं समासाद्य संहरिष्यति पातकात्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000366028, "chapter_id": 20366, "verse_number": "२-३८-२९", "content_sanskrit": "पापेषु संगतेष्वेवं म्लेच्छनाशाय वै पुनः ।\nकल्किरेव स्वयं देवो भविष्यति न संशयः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000366029, "chapter_id": 20366, "verse_number": "२-३८-३०", "content_sanskrit": "व्यवहारं कलेश्चैव त्यज पुण्यं समाश्रय ।\nवर्तयस्व हि सत्येन प्रजापालो भवस्व हि॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000366030, "chapter_id": 20366, "verse_number": "२-३८-३१", "content_sanskrit": "वेन उवाच ।\nअहं ज्ञानवतां श्रेष्ठः सर्वं ज्ञातं मया इह ।\nयोऽन्यथा वर्तते चैव स दंड्यो भवति ध्रुवम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000366031, "chapter_id": 20366, "verse_number": "२-३८-३२", "content_sanskrit": "अत्यर्थं भाषमाणं तं राजानं पापचेतनम् ।\nकुपितास्ते महात्मानः सर्वे वै ब्रह्मणः सुताः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000366032, "chapter_id": 20366, "verse_number": "२-३८-३३", "content_sanskrit": "कुपितेष्वेव विप्रेषु वेनो राजा महात्मसु ।\nब्रह्मशापभयात्तेषां वल्मीकं प्रविवेश ह॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000366033, "chapter_id": 20366, "verse_number": "२-३८-३४", "content_sanskrit": "अथ ते मुनयः क्रुद्धा वेनं पश्यंति सर्वतः ।\nज्ञात्वा प्रनष्टं भूपं तं वल्मीकस्थं सुसांप्रतम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000366034, "chapter_id": 20366, "verse_number": "२-३८-३५", "content_sanskrit": "बलादानिन्युस्तं विप्राः क्रूरं तं पापचेतनम् ।\nदृष्ट्वा च पापकर्माणं मुनयः सुसमाहिताः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000366035, "chapter_id": 20366, "verse_number": "२-३८-३६", "content_sanskrit": "सव्यं पाणिं ममंथुस्ते भूपस्य जातमन्यवः ।\nतस्माज्जातो महाह्रस्वो नीलवर्णो भयंकरः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000366036, "chapter_id": 20366, "verse_number": "२-३८-३७", "content_sanskrit": "बर्बरो रक्तनेत्रस्तु बाणपाणिर्धनुर्द्धरः ।\nसर्वेषामेव पापानां निषादानां बभूव ह॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000366037, "chapter_id": 20366, "verse_number": "२-३८-३८", "content_sanskrit": "धाता पालयिता राजा म्लेच्छानां तु विशेषतः ।\nतं दृष्ट्वा पापकर्माणमृषयस्तु महामते॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000366038, "chapter_id": 20366, "verse_number": "२-३८-३९", "content_sanskrit": "ममंथुर्दक्षिणं पाणिं वेनस्यापि महात्मनः ।\nतस्माज्जातो महात्मा स येन दुग्धा वसुंधरा॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000366039, "chapter_id": 20366, "verse_number": "२-३८-४०", "content_sanskrit": "पृथुर्नाम महाप्राज्ञो राजराजो महाबलः ।\nतस्य पुण्यप्रसादाच्च वेनो धर्मार्थकोविदः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000366040, "chapter_id": 20366, "verse_number": "२-३८-४१", "content_sanskrit": "चक्रवर्तिपदं भुक्त्वा प्रसादात्तस्य चक्रिणः ।\nजगाम वैष्णवं लोकं तद्विष्णोः परमं पदम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]