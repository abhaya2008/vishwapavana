[{"id": 2202903, "chapter_id": 5321, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2202904, "chapter_id": 5321, "verse_number": "१", "content_sanskrit": "एवमुक्तः प्रत्युवाच मैत्रेयः कर्मपूजकः ।\nअत्यन्तं श्रीमति कुले जातः प्राज्ञो बहुश्रुतः\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2202905, "chapter_id": 5321, "verse_number": "२", "content_sanskrit": "असंशयं महाप्राज्ञ यथैवात्थ तथैव तत् ।\nअनुज्ञातस्तु भवता किञ्चिद् ब्रूयामहं विभो\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2202906, "chapter_id": 5321, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2202907, "chapter_id": 5321, "verse_number": "३", "content_sanskrit": "यद्यदिच्छसि मैत्रेय यावद्यावद् यथा तथा ।\nब्रूहि तत्तन्महाभाग शुश्रूषे वचनं तव\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2202908, "chapter_id": 5321, "verse_number": "", "content_sanskrit": "मैत्रेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2202909, "chapter_id": 5321, "verse_number": "४", "content_sanskrit": "निर्दोषं निर्मलं चैव वचनं दानसंहितम् ।\nविद्यातपोभ्यां हि भवान् भावितात्मा न संशयः\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2202910, "chapter_id": 5321, "verse_number": "५", "content_sanskrit": "भवतो भावितात्मत्वाद् दायोऽयं सुमहान् मम ।\nभूयो बुद्ध्याऽनुपश्यामि सुसमृद्धतपा इव\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2202911, "chapter_id": 5321, "verse_number": "६", "content_sanskrit": "अपि मे दर्शनादेव भवतो ह्युदयो भवेत् ।\nमन्ये भवत्प्रसादोऽयं तद्धि कर्मस्वभावतः\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2202912, "chapter_id": 5321, "verse_number": "७", "content_sanskrit": "तपः श्रुतं च योनिश्चाप्येतद् ब्राह्मण्यकारणम् ।\nत्रिभिर्गुणैः समुदितस्ततो भवति वै द्विजः\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2202913, "chapter_id": 5321, "verse_number": "८", "content_sanskrit": "तस्मिंस्तृप्ते च तृप्यन्ते पितरो दैवतानि च ।\nन हि श्रुतवतां किञ्चिदधिकं ब्राह्मणादृते\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2202914, "chapter_id": 5321, "verse_number": "९", "content_sanskrit": "यथा हि सुकृते क्षेत्रे फलं विन्दन्ति मानवाः ।\nएवं दत्त्वा श्रुतवति फलं दाता समश्नुते\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2202915, "chapter_id": 5321, "verse_number": "१०", "content_sanskrit": "ब्राह्मणश्चेन्न विद्येत श्रुतवृत्तोपसंहितः ।\nप्रतिग्रहीता दानस्य मोघं स्याद् धनिनां धनम्\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2202916, "chapter_id": 5321, "verse_number": "११", "content_sanskrit": "अदन् ह्यविद्वान् हन्त्यन्नमद्यमानं च हन्ति तम् ।\nतं च हन्यति यस्यान्नं स हत्वा हन्यतेऽबुधः\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2202917, "chapter_id": 5321, "verse_number": "१२", "content_sanskrit": "प्रभुर्ह्यन्नमदन् विद्वान् पुनर्जनयतीश्वरः ।\nस चान्नाज्जायते तस्मात् सूक्ष्म एव व्यतिक्रमः\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2202918, "chapter_id": 5321, "verse_number": "१३", "content_sanskrit": "यदेव ददतः पुण्यं तदेव प्रतिगृह्णतः ।\nन ह्येकचक्रं वर्तेत इत्येवमृषयो विदुः\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2202919, "chapter_id": 5321, "verse_number": "१४", "content_sanskrit": "यत्र वै ब्राह्मणाः सन्ति श्रुतवृत्तोपसंहिताः ।\nतत्र दानफलं पुण्यमिह चामुत्र चाश्नुते\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2202920, "chapter_id": 5321, "verse_number": "१५", "content_sanskrit": "ये योनिशुद्धाः सततं तपस्यभिरता भृशम् ।\nदानाध्ययनसम्पन्नास्ते वै पूज्यतमाः सदा\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2202921, "chapter_id": 5321, "verse_number": "१६", "content_sanskrit": "तैर्हि सद्भिः कृतः पन्थाश्चेतयानो न मुह्यते ।\nते हि स्वर्गस्य नेतारो यज्ञवाहाः सनातनाः\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2202922, "chapter_id": 5321, "verse_number": "", "content_sanskrit": "॥इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे दानप्रशंसा नाम द्वासप्तत्युत्तरशततमोऽध्यायः ॥१७२॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]