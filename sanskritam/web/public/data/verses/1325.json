[{"id": 2015435, "chapter_id": 1325, "verse_number": "२-६६-१", "content_sanskrit": "भीष्म उवाच॥\nचेदिराजकुले जातख्यक्ष एष चतुर्भुजः।\nरासभारावसदृशं ररास च ननाद च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2015436, "chapter_id": 1325, "verse_number": "२-६६-२", "content_sanskrit": "तेनास्य मातापितरौ त्रेसतुस्तौ सबान्धवौ।\nवैकृतं तस्यत तौ दृष्ट्वा त्यागायाकुरुतां मतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2015437, "chapter_id": 1325, "verse_number": "२-६६-३", "content_sanskrit": "ततः सभार्यं नृपतिं सामात्यं सपुरोहितम्।\nचिन्तासंमूढहृदयं वागुवाचाशरीरेणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2015438, "chapter_id": 1325, "verse_number": "२-६६-४", "content_sanskrit": "एष ते नृपते पुत्रः श्रीमाञ्जातो बलाधिकः।\nतस्मादस्मान्न भेतव्यमव्यग्रः पाहि वै शिशुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2015439, "chapter_id": 1325, "verse_number": "२-६६-५", "content_sanskrit": "न च वै तस्य मृत्युस्त्वं न कालः प्रत्युपस्थितः।\nयश्च शस्त्रेण हन्ताऽस्य स चोत्पन्नो नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2015440, "chapter_id": 1325, "verse_number": "२-६६-६", "content_sanskrit": "संश्रुत्योदाहृतं वाक्यं भूतमन्तर्हितं ततः।\nपुत्रस्नेहाभिसन्तप्ता जननी वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2015441, "chapter_id": 1325, "verse_number": "२-६६-७", "content_sanskrit": "येनेदमीरितं वाक्यं ममैतं तनयं प्रति।\nप्राञ्जलिस्तं नमस्यामि ब्रवीतु स पुनर्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2015442, "chapter_id": 1325, "verse_number": "२-६६-८", "content_sanskrit": "याथातथ्येन भगवान्देवो वा यदि वेतरः।\nश्रोतुमिच्छामि पुत्रस्य कोऽस्य मृत्युर्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2015443, "chapter_id": 1325, "verse_number": "२-६६-९", "content_sanskrit": "अन्तर्भूतं ततो भूतमुवाचेदं पुनर्वचः।\nयस्योत्सङ्गे गृहीतस्य भुजावभ्यधिकावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2015444, "chapter_id": 1325, "verse_number": "२-६६-१०", "content_sanskrit": "पतिष्यतः क्षितितले पञ्चशीर्षाविवोरगौ।\nतृतीयमेतद्बालस्य ललाटस्थं तु लोचनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2015445, "chapter_id": 1325, "verse_number": "२-६६-११", "content_sanskrit": "निमज्जिष्यति यं दृष्ट्वा सोऽस्य मृत्युर्भविष्यति।\nत्र्यक्षं चतुर्भुजं श्रुत्वा तथा च समुदाहृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2015446, "chapter_id": 1325, "verse_number": "२-६६-१२", "content_sanskrit": "पृथिव्यां पार्थिवाः सर्वे अभ्यागच्छन्दिदृक्षवः।\nतान्पूजयित्वा सम्प्राप्तान्यथार्हं स महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2015447, "chapter_id": 1325, "verse_number": "२-६६-१३", "content_sanskrit": "एकैकस्य नृपस्याङ्के पुत्रमारोपयत्तदा।\nएवं राजसहस्राणा पृथक्त्वेन यथाक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2015448, "chapter_id": 1325, "verse_number": "२-६६-१४", "content_sanskrit": "शिशुरङ्के समारूढो न तत्प्राय निदर्शनम्।\nएतदेव तु संश्रुत्य द्वारवत्यां महाबलौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2015449, "chapter_id": 1325, "verse_number": "२-६६-१५", "content_sanskrit": "ततश्चेदिपुरं प्राप्तौ सङ्कर्षणजनार्दनौ।\nयादवौ यादवीं द्रुष्टुं स्वसारं तौ पितुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2015450, "chapter_id": 1325, "verse_number": "२-६६-१६", "content_sanskrit": "अभिवाद्य यथान्यायं यथाश्रेष्ठं नृपं च ताम्।\nकुशलानामयं पृष्ट्वा निषण्णौ रामकेशवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2015451, "chapter_id": 1325, "verse_number": "२-६६-१७", "content_sanskrit": "साऽभ्यर्च्य तौ तदा वीरौ प्रीत्या चाभ्यधिकं ततः।\nपुत्रं दामोदरोत्सङ्गे देवी संन्यदधात्स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2015452, "chapter_id": 1325, "verse_number": "२-६६-१८", "content_sanskrit": "न्यस्तमात्रस्य तस्याङ्के भुजावभ्यधिकावुभौ।\nपेततुस्तच्च नयनं न्यमज्जत ललाटजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2015453, "chapter_id": 1325, "verse_number": "२-६६-१९", "content_sanskrit": "तद्दृष्ट्वा व्यथिता त्रस्ता वरं कृष्णमयाचत।\nददस्व मे वरं कृष्ण भयार्ताया महाभुज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2015454, "chapter_id": 1325, "verse_number": "२-६६-२०", "content_sanskrit": "त्वं ह्यार्तानां समाश्वासो भीतानामभयप्रदः।\nएवमुक्तस्ततः कृष्णः सोऽब्रवीद्यदुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2015455, "chapter_id": 1325, "verse_number": "२-६६-२१", "content_sanskrit": "मा भैस्त्वं देवि धर्मज्ञे न मत्तोऽस्ति भयं तव।\nददामि कं वरं किं च करवाणि पितृष्वसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2015456, "chapter_id": 1325, "verse_number": "२-६६-२२", "content_sanskrit": "शक्यं वा यदि वाऽशक्यं करिष्याणि वचस्तव।\nएवमुक्ता ततः कृष्णमब्रवीद्यदुनन्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2015457, "chapter_id": 1325, "verse_number": "२-६६-२३", "content_sanskrit": "शिशुपालस्यापराधान्क्षमेथास्त्वं महाबल।\nमत्कृते यदुशार्दूल विद्ध्येनं मे वरं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2015458, "chapter_id": 1325, "verse_number": "२-६६-२४x", "content_sanskrit": "कृष्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2015459, "chapter_id": 1325, "verse_number": "२-६६-२४", "content_sanskrit": "अपराधशतं क्षाम्यं मया ह्यस्य पितृष्वसः।\nपुत्रस्य ते वधार्हस्य मा त्वं शोके मनः कृथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2015460, "chapter_id": 1325, "verse_number": "२-६६-२५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2015461, "chapter_id": 1325, "verse_number": "२-६६-२५", "content_sanskrit": "स जानन्नात्मनो मृत्युं कृष्णं यदुसुखावहम्।\nएवमेष नृपः पापः शिशुपाः सुमन्दधीः।\nत्वां समाह्वयते वीर गोविन्दवरदर्पितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2015462, "chapter_id": 1325, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि शिशुपालवधपर्वणि षट्षष्टितमोऽध्यायः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]