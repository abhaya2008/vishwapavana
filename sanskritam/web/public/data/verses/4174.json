[{"id": 2147026, "chapter_id": 4174, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2147027, "chapter_id": 4174, "verse_number": "१", "content_sanskrit": "अनर्थे जातनिर्बन्धं परार्थे लोभमोहितम् ।\nअनार्यकेष्वभिरतं मरणे कृतनिश्चयम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2147028, "chapter_id": 4174, "verse_number": "२", "content_sanskrit": "ज्ञातीनां दुःखकर्तारं बन्धूनां शोकवर्धनम् ।\nसुहृदां क्लेशदातारं द्विषतां हर्षवर्धनम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2147029, "chapter_id": 4174, "verse_number": "३", "content_sanskrit": "कथं नैनं विमार्गस्थं वारयन्तीह बान्धवाः ।\nसौहृदाद्वा सुहृत् स्निग्धो भगवान् वा पितामहः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2147030, "chapter_id": 4174, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2147031, "chapter_id": 4174, "verse_number": "४", "content_sanskrit": "उक्तं भगवता वाक्यमुक्तं भीष्मेण यत् क्षमम् ।\nउक्तं बहुविधं चैव नारदेनापि तच्छृणु\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2147032, "chapter_id": 4174, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2147033, "chapter_id": 4174, "verse_number": "५", "content_sanskrit": "दुर्लभो वै सुहृच्छ्रोता दुर्लभश्च हितः सुहृत् ।\nतिष्ठते हि सुहृद् यत्र न बन्धुस्तत्र तिष्ठते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2147034, "chapter_id": 4174, "verse_number": "६", "content_sanskrit": "श्रोतव्यमपि पश्यामि सुहृदां कुरुनन्दन ।\nन कर्तव्यश्च निर्बन्धो निर्बन्धो हि सुदारुणः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2147035, "chapter_id": 4174, "verse_number": "७", "content_sanskrit": "दुर्योधन निबोधेदं वचनं मम भारत ।\nनिर्बन्धश्चापि मानश्च त्वया त्याज्यो महामते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2147036, "chapter_id": 4174, "verse_number": "८", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nयथा निर्बन्धतः प्राप्तो गालवेन पराजयः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2147037, "chapter_id": 4174, "verse_number": "९", "content_sanskrit": "विश्वामित्रं तपस्यन्तं धर्मो जिज्ञासया पुरा ।\nअभ्यागच्छत् स्वयं भूत्वा वशिष्ठो भगवानृषिः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2147038, "chapter_id": 4174, "verse_number": "१०", "content_sanskrit": "सप्तर्षीणामन्यतमं वेषमास्थाय भारत ।\nबुभुक्षुः क्षुधितो राजन्नाश्रमं कौशिकस्य तु\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2147039, "chapter_id": 4174, "verse_number": "११", "content_sanskrit": "विश्वामित्रोऽथ सम्भ्रान्तः श्रपयामास वै चरुम् ।\nपरमान्नं स यत्नेन न च तं प्रत्यपालयत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2147040, "chapter_id": 4174, "verse_number": "१२", "content_sanskrit": "अन्नं तेन तदा भुक्तमन्यैर्दत्तं तपस्विभिः ।\nअथ गृह्यान्नमत्युष्णं विश्वामित्रोऽप्युपागमत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2147041, "chapter_id": 4174, "verse_number": "१३", "content_sanskrit": "भुक्तं मे तिष्ठ तावत् त्वम् इत्युक्त्वा भगवान् ययौ ।\nविश्वामित्रस्ततो राजन् स्थित एव महाद्युतिः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2147042, "chapter_id": 4174, "verse_number": "१४", "content_sanskrit": "भक्तं प्रगृह्य मूर्ध्ना वै बाहुभ्यां पार्श्वतो वहन् ।\nस्थितः स्थाणुरिवाभ्याशे निश्चेष्टो मारुताशनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2147043, "chapter_id": 4174, "verse_number": "१५", "content_sanskrit": "तस्य शुश्रूषणे यत्नमकरोद् गालवो मुनिः ।\nगौरवाद् बहुमानाच्च हार्देन प्रियकाम्यया\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2147044, "chapter_id": 4174, "verse_number": "१६", "content_sanskrit": "अथ वर्षशते पूर्णे धर्मः पुनरुपागमत् ।\nवाशिष्ठं वेषमास्थाय कौशिकं भोजनेप्सया\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2147045, "chapter_id": 4174, "verse_number": "१७", "content_sanskrit": "स दृष्ट्वा शिरसा भक्तं ध्रियमाणं महर्षिणा ।\nतिष्ठता वायुभक्षेण विश्वामित्रेण धीमता\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2147046, "chapter_id": 4174, "verse_number": "१८", "content_sanskrit": "प्रतिगृह्य ततो धर्मः तथैवोष्णं तथा नवम् ।\nभुक्त्वा प्रीतोऽस्मि विप्रेति तमुक्त्वा स मुनिर्गतः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2147047, "chapter_id": 4174, "verse_number": "१९", "content_sanskrit": "क्षत्रभावादपगतो ब्राह्मणत्वमुपागतः ।\nधर्मस्य वचनात् प्रीतो विश्वामित्रस्तदाऽभवत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2147048, "chapter_id": 4174, "verse_number": "२०", "content_sanskrit": "विश्वामित्रस्तु शिष्यस्य गालवस्य तपस्विनः ।\nशिश्रूषया च भक्त्या च प्रीतिमानित्युवाच ह\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2147049, "chapter_id": 4174, "verse_number": "२१", "content_sanskrit": "अनुज्ञातो मया वत्स यथेच्छं गच्छ गालव\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2147050, "chapter_id": 4174, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2147051, "chapter_id": 4174, "verse_number": "२२", "content_sanskrit": "इत्युक्तः प्रत्युवाचेदं गालवो मुनिसत्तमम् ।\nप्रीतो मधुरया वाचा विश्वामित्रं महाद्युतिम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2147052, "chapter_id": 4174, "verse_number": "२३", "content_sanskrit": "दक्षिणाः काः प्रयच्छामि भवते गुरुकर्मणि ।\nदक्षिणाभिरुपेतं हि कर्म सिद्ध्यति मानवम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2147053, "chapter_id": 4174, "verse_number": "२४", "content_sanskrit": "दक्षिणानां विसृष्टानाम् अपवर्गेण भुज्यते ।\nस्वर्गे क्रतुफलं सद्भिर्दक्षिणा शान्तिरुच्यते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2147054, "chapter_id": 4174, "verse_number": "२५", "content_sanskrit": "किमाहरामि गुर्वर्थं ब्रवीतु भगवानिति\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2147055, "chapter_id": 4174, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2147056, "chapter_id": 4174, "verse_number": "२६", "content_sanskrit": "जानमानश्च भगवान् खिन्नं शिश्रूषणेन च ।\nविश्वामित्रस्तमसकृद् गच्छ गच्छेत्यचोदयत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2147057, "chapter_id": 4174, "verse_number": "२७", "content_sanskrit": "असकृद् गच्छ गच्छेति विश्वामित्रेण भाषितः ।\nकिं ददानीति बहुशो गालवः प्रत्यभाषत\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2147058, "chapter_id": 4174, "verse_number": "२८", "content_sanskrit": "निर्बन्धतस्तु बहुशो गालवस्य तपस्विनः ।\nकिञ्चिदागतसंरम्भो विश्वामित्रोऽब्रवीदिदम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2147059, "chapter_id": 4174, "verse_number": "२९", "content_sanskrit": "एकतः श्यामकर्णानां हयानां चन्द्रवर्चसाम् ।\nअष्टौ शतानि मे देहि गच्छ गालव माचिरम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2147060, "chapter_id": 4174, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि पञ्चाधिकशततमोऽध्यायः ॥१०५॥\nभगवद्यानपर्वणि षट्त्रिंशोऽध्यायः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]