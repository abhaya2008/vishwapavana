[{"id": 2098987, "chapter_id": 3118, "verse_number": "१३-२४८-१", "content_sanskrit": "नारद उवाच।\nएवमुक्त्वा महादेवः श्रोतुकामः स्वयं प्रभुः।\nअनुकूलां प्रियां भार्यां पार्श्वस्तामभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2098988, "chapter_id": 3118, "verse_number": "१३-२४८-२x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2098989, "chapter_id": 3118, "verse_number": "१३-२४८-२", "content_sanskrit": "परावरज्ञे धर्माणां तपोवननिवासिनाम्।\nदीक्षाविधिदमोपेते सततं व्रतचारिणि।\nपृच्छामि त्वां वरारोहे पृष्टा वद ममेप्सितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2098990, "chapter_id": 3118, "verse_number": "१३-२४८-३", "content_sanskrit": "सावित्री ब्रह्मणः पत्नी कौशिकस्य शची शुभा।\nलक्ष्मीर्विष्णोः प्रिया भार्या धृतिर्भार्या यमस्य तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2098991, "chapter_id": 3118, "verse_number": "१३-२४८-४", "content_sanskrit": "मार्कण्डेयस्य धूमोर्णा ऋद्धिर्वैश्रवणस्य तु।\nवरुणस्य प्रिया गौरी सवितुश्च सुवर्चला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2098992, "chapter_id": 3118, "verse_number": "१३-२४८-५", "content_sanskrit": "रोहिणी शशिनो भार्या स्वाहा चाग्नेरनिन्दिता।\nकाश्यपस्यादितिश्चैव वसिष्ठस्याप्यरुन्धती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2098993, "chapter_id": 3118, "verse_number": "१३-२४८-६", "content_sanskrit": "एताश्चान्याश्च देव्यस्तु सर्वास्ताः पतिदेवताः।\nश्रूयन्ते लोकविख्यातास्त्वया चैव सहोषिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2098994, "chapter_id": 3118, "verse_number": "१३-२४८-७", "content_sanskrit": "ताभिश्च पूजिताऽपि त्वमनुवृत्त्यनुभाषणैः।\nतस्मात्तु परिपृच्छामि धर्मज्ञे लोकसम्मते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2098995, "chapter_id": 3118, "verse_number": "१३-२४८-८", "content_sanskrit": "स्त्रीधर्मं श्रोतुमिच्छामि त्वयैव समुदाहृतम्।\nसध्रमचारिणी मे त्वं लोकसन्धारिणी तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2098996, "chapter_id": 3118, "verse_number": "१३-२४८-९", "content_sanskrit": "अयं हि स्त्रीगणस्त्वां तु अनुयाति न मुञ्चति।\nत्वत्प्रसादाद्धितं श्रोतुं स्त्रीवृत्तं शुभलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2098997, "chapter_id": 3118, "verse_number": "१३-२४८-१०", "content_sanskrit": "त्वया चोक्तं विशेषेण गुणभूतं हि तिष्ठति।\nस्त्रिय एव सदा लोके स्त्रीगणस्य गतिः प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2098998, "chapter_id": 3118, "verse_number": "१३-२४८-११", "content_sanskrit": "शश्वद्गौर्गोषु गच्छेत नान्यत्र रमते नरः।\nएवं लोकगतिर्देवि आदिप्रभृति वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2098999, "chapter_id": 3118, "verse_number": "१३-२४८-१२", "content_sanskrit": "प्रमदोक्तं तु यत्किञ्चित्तत्स्त्रीषु बहुमन्यते।\nन तथा मन्यते स्त्रीषु पुरुषोक्तमनिन्दिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2099000, "chapter_id": 3118, "verse_number": "१३-२४८-१३", "content_sanskrit": "त्वयैष विदितो ह्यर्थः स्त्रीणां धर्मः सनातनः।\nतस्मात्त्वां प्रति पृच्छामि पृष्टा वद ममेप्सितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2099001, "chapter_id": 3118, "verse_number": "१३-२४८-१४x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2099002, "chapter_id": 3118, "verse_number": "१३-२४८-१४", "content_sanskrit": "एवमुक्ता तदा देवी महादेवेन शोभना।\nसोद्वेगा च सलज्जा च नावदत्तत्र किञ्चन।\nपुनः पुनस्तदा देवी देवः किमिति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2099003, "chapter_id": 3118, "verse_number": "१३-२४८-१५x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2099004, "chapter_id": 3118, "verse_number": "१३-२४८-१५", "content_sanskrit": "भगवन्देवदेवेश सुरासुरनमस्कृत।\nत्वदन्तिके मया वक्तुं स्त्रीणां धर्मः कथं भवेत्॥ महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2099005, "chapter_id": 3118, "verse_number": "१३-२४८-१६", "content_sanskrit": "मन्नियोगादवश्यं तु वक्तव्यं तु मम प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2099006, "chapter_id": 3118, "verse_number": "१३-२४८-१७x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2099007, "chapter_id": 3118, "verse_number": "१३-२४८-१७", "content_sanskrit": "इमा नद्यो महादेव सर्वतीर्थोदकान्विताः।\nउपस्पर्शनहेतोस्त्वां न त्यजन्ति समीपतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2099008, "chapter_id": 3118, "verse_number": "१३-२४८-१८", "content_sanskrit": "एताभिः सह सम्मन्त्र्य प्रवक्ष्यामि तवेप्सितम्।\nअयुक्तं सत्सु तन्त्रेषु तानतिक्रम्य भाषितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2099009, "chapter_id": 3118, "verse_number": "१३-२४८-१९", "content_sanskrit": "मया सम्मानिताश्चैव भविष्यन्ति सरिद्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2099010, "chapter_id": 3118, "verse_number": "१३-२४८-२०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2099011, "chapter_id": 3118, "verse_number": "१३-२४८-२०", "content_sanskrit": "इति मत्वा महादेवी नदीर्देवीः समाह्वयत्।\nविपाशां च वितस्त्यां च चन्द्रभागां सरस्वतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2099012, "chapter_id": 3118, "verse_number": "१३-२४८-२१", "content_sanskrit": "शतद्रुं देविक्तां सिन्धुं गौतमीं कौशिकीं तथा।\nयमुनां नर्मदां चैव कावेरीमथ निम्नगाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2099013, "chapter_id": 3118, "verse_number": "१३-२४८-२२", "content_sanskrit": "तथा देवनदीं गङ्गां श्रेष्ठां त्रिपथगां शुभाम्।\nसर्वतीर्थोदकवहां सर्वपापविनाशिनीम्।\nएता नदीः समाहूय समुद्वीक्ष्येदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2099014, "chapter_id": 3118, "verse_number": "१३-२४८-२३x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2099015, "chapter_id": 3118, "verse_number": "१३-२४८-२३", "content_sanskrit": "हे पुण्याः सरितः श्रेष्ठाः सर्वपापविनाशिकाः।\nज्ञानविज्ञानसम्पन्नाः शृणुध्वं वचनं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2099016, "chapter_id": 3118, "verse_number": "१३-२४८-२४", "content_sanskrit": "अयं भगवता प्रश्न उक्तः स्त्रीधर्ममाश्रितः।\nन चैकया मया साद्यं तस्माद्वस्त्वानयाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2099017, "chapter_id": 3118, "verse_number": "१३-२४८-२५", "content_sanskrit": "युष्माभिस्तद्विचार्यैवं वक्तुमिच्छामि शोभनाः।\nतत्कथं देवदेवाय वाच्यः स्त्रीधर्म उत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2099018, "chapter_id": 3118, "verse_number": "१३-२४८-२६x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2099019, "chapter_id": 3118, "verse_number": "१३-२४८-२६", "content_sanskrit": "इति पृष्टास्तथा देव्या महानद्यश्चकम्पिरे।\nतासां श्रेष्ठतमा गङ्गा वचनं त्ववेमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2099020, "chapter_id": 3118, "verse_number": "१३-२४८-२७", "content_sanskrit": "धन्याश्चानुगृहीताः स्म अनेन वचनेन ते।\nया त्वं सुरासुरैर्मान्या नदीराद्रियसेऽनघे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2099021, "chapter_id": 3118, "verse_number": "१३-२४८-२८", "content_sanskrit": "तवैवार्हति कल्याणि एवं सान्त्वप्रसादनम्।\nअशक्यमपि ये मूर्खाः स्वात्मसम्भावनायुताः।\nवाक्यं वदन्ति संसत्सु स्वयमेव यथेष्टतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2099022, "chapter_id": 3118, "verse_number": "१३-२४८-२९", "content_sanskrit": "शक्तो यश्चानहंवादी सुदुर्लभतमो मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2099023, "chapter_id": 3118, "verse_number": "१३-२४८-३०", "content_sanskrit": "त्वं हि शक्ता सती देवी वक्तुं प्रश्नमशेषतः।\nव्याहर्तुं नेच्छसि स्त्रीत्वात्संपूजयति नस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2099024, "chapter_id": 3118, "verse_number": "१३-२४८-३१", "content_sanskrit": "त्वं हि देवि महादेवी ऊहापोहविशारदा।\nदिव्यज्ञानयुता देवि दिव्यज्ञानेन्धनैधिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2099025, "chapter_id": 3118, "verse_number": "१३-२४८-३२", "content_sanskrit": "त्वमेवार्हसि तद्वक्तुं स्त्रीणां वृत्तं शुभाशुभम्।\nयाचामहे वयं श्रोतुममृतं त्वन्मुखोद्गतम्।\nकुरु देवप्रियं देवि वद स्त्रीधर्ममुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2099026, "chapter_id": 3118, "verse_number": "१३-२४८-३३x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2099027, "chapter_id": 3118, "verse_number": "१३-२४८-३३", "content_sanskrit": "एवं प्रसादिता देवी गङ्गया लोकपूज्यया।\nप्राह धर्ममशेषेण स्त्रीधर्मं सुरसुन्दरी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2099028, "chapter_id": 3118, "verse_number": "१३-२४८-३४x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2099029, "chapter_id": 3118, "verse_number": "१३-२४८-३४", "content_sanskrit": "भगवन्देवदेवेश सुरेश्वर महेश्वर।\nत्वत्प्रसादात्सुरश्रेष्ठ तवैव प्रियकाम्यया।\nतमहं कीर्तयिष्यामि यथावच्छ्रोतुमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2099030, "chapter_id": 3118, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अष्टचत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]