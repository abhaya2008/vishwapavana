[{"id": 7002294000, "chapter_id": 22294, "verse_number": "३३९-१", "content_sanskrit": "अग्निरुवाच ।\nअक्षरं परमं ब्र्ह्म सनातनमजं विभुं ।\nवेदान्तेषु वदन्त्येकं चैतन्यं ज्योतिरीश्वरम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002294001, "chapter_id": 22294, "verse_number": "३३९-२", "content_sanskrit": "आनन्दः सहजस्तस्य व्यज्यते स कदाचन ।\nव्यक्तिः सा तस्य चैतन्यचमत्काररसाह्वया ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002294002, "chapter_id": 22294, "verse_number": "३३९-३", "content_sanskrit": "आद्यस्तस्य विकारो यः सोऽहङ्कार इति स्मृतः ।\nततोऽभिमानस्तत्रेदं समाप्तं भुवनत्रयं ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002294003, "chapter_id": 22294, "verse_number": "३३९-४", "content_sanskrit": "अभिमानाद्रतिः सा च परिपोषमुपेयुषी ।\nव्यभिचार्य्यादिसामान्यात् श्रृङ्गार इति गीयते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002294004, "chapter_id": 22294, "verse_number": "३३९-५", "content_sanskrit": "तद्भेदाः काममितरे हास्याद्या अप्यनेकशः ।\nस्वस्वस्थादिविशेषोत्थपरिघोषस्वलक्षणाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002294005, "chapter_id": 22294, "verse_number": "३३९-६", "content_sanskrit": "सत्त्वादिगुणसन्तानाज्जायन्ते परमात्मनः ।\nरागाद्बवति श्रृङ्गारो रौद्रस्तैक्षणात् प्रजायते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002294006, "chapter_id": 22294, "verse_number": "३३९-७", "content_sanskrit": "वीरोऽवष्टम्भजः सङ्कोचभूर्व्वीभत्स इष्यते ।\nश्रृङ्गारहास्यकरुणा रौद्रवीरभयानकाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002294007, "chapter_id": 22294, "verse_number": "३३९-८", "content_sanskrit": "वीराच्चाद्भुतनिष्पत्तिः स्याद्वीभत्साद्भयानकः ।\nश्रृङ्गारहास्यकरुणा रौद्रवीरभयानकाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002294008, "chapter_id": 22294, "verse_number": "३३९-९", "content_sanskrit": "वीभत्साद्भुतशान्ताख्याः स्वभावाच्चतुरो रसाः ।\nलक्ष्मीरिव विना त्यागान्न वाणी भाति नीरसा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002294009, "chapter_id": 22294, "verse_number": "३३९-१०", "content_sanskrit": "अपारे काव्यसंसारे कविरेव प्रजापतिः ।\nयथा वै रोचते विश्वं तथेवं परिवर्त्तते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002294010, "chapter_id": 22294, "verse_number": "३३९-११", "content_sanskrit": "अपारे काव्यसंसारे कविरेव प्रजापतिः ।\nयथा वै रोचते विश्वं तथेदं परिवर्त्तते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002294011, "chapter_id": 22294, "verse_number": "३३९-१२", "content_sanskrit": "न भावहीनोऽस्ति रसो न भावो रसवर्ज्जितः ।\nभावयन्ति रसानेभिर्भाव्यन्ते च रसा इति ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002294012, "chapter_id": 22294, "verse_number": "३३९-१३", "content_sanskrit": "स्थायितनोऽष्टौ रतिमुखाः स्तम्भाद्या व्यभिचारिणः ।\nमनोऽनुकूलेऽनुभवः सुखस्य रतिरिष्य्ते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002294013, "chapter_id": 22294, "verse_number": "३३९-१४", "content_sanskrit": "हर्वादिभिश्च मनसो विकाशो हास उच्यते ।\nचित्रादिदर्शनाच्चेतोवैक्लव्यं ब्रुवते भयम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002294014, "chapter_id": 22294, "verse_number": "३३९-१५", "content_sanskrit": "जुगुप्सा च पदार्थानां निन्दा दौर्भाग्यवाहिनां ।\nविस्मयोऽतिशयेनार्थदर्शनाच्चित्तविस्तृतिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002294015, "chapter_id": 22294, "verse_number": "३३९-१६", "content_sanskrit": "अष्टौ स्तम्भादयः सत्त्वाद्रजसस्तमसः परम् ।\nस्तम्भश्चेष्टाप्रतीघातो भयरागाद्युपाहितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002294016, "chapter_id": 22294, "verse_number": "३३९-१७", "content_sanskrit": "श्रमरागाद्युपेतान्तःक्षोभजन्म वपुर्ज्जलं ।\nस्वेदो हर्षादिभिर्द्देहोच्छासाऽन्तःपुलकोद्गमः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002294017, "chapter_id": 22294, "verse_number": "३३९-१८", "content_sanskrit": "हर्षादिजन्मवाक्सङ्गः स्वरभेदो भयादिभिः ।\nमनोवैक्लव्यमिच्छन्ति शोकमिष्टक्षयादिभिः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002294018, "chapter_id": 22294, "verse_number": "३३९-१९", "content_sanskrit": "क्रोधस्तैक्ष्णप्रबोधश्च प्रतिकू लानुकारिणि ।\nपुरुषार्थसमाप्त्यार्थो यः स उत्साह उच्यते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002294019, "chapter_id": 22294, "verse_number": "३३९-२०", "content_sanskrit": "चित्तक्षोभभवोत्तम्भो वेपथुः परिकीर्त्तितः ।\nवैवर्ण्यञ्च विचषादादिजन्मा कान्तिविपर्य्ययः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002294020, "chapter_id": 22294, "verse_number": "३३९-२१", "content_sanskrit": "दुःखानन्दादिजन्नेत्रजलमश्रु च विश्रुतम् ।\nइन्द्रियाणामस्तमयः प्रलयो लङ्घनादिभिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002294021, "chapter_id": 22294, "verse_number": "३३९-२२", "content_sanskrit": "वैराग्यादिर्म्मनः खेदो निर्वेद इति कथ्यते ।\nमनः पीड़दिजन्मा च सादो ग्लानिः शरीरगा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002294022, "chapter_id": 22294, "verse_number": "३३९-२३", "content_sanskrit": "शङ्कानिष्टागमोत्प्रेक्षा स्यादसूया च मत्सरः ।\nमदिराद्युपयोगोत्थं मनः संमोहनं मदः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002294023, "chapter_id": 22294, "verse_number": "३३९-२४", "content_sanskrit": "क्रियातिशयजन्मान्तःशरीरोत्थक्लमः श्रमः ।\nश्रृङ्गारादिक्रियाद्वेषश्चित्तस्यालस्यमुच्यते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002294024, "chapter_id": 22294, "verse_number": "३३९-२५", "content_sanskrit": "दैन्यं सत्त्वादपभ्रंशश्चिन्तार्थपरिभावनं ।\nइतिकर्त्तव्यतोपायादर्शनं मोह उच्यते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002294025, "chapter_id": 22294, "verse_number": "३३९-२६", "content_sanskrit": "स्मृतिः स्यादनुभूतस्य वस्तुनः प्रतिविम्बनं ।\nमतिरर्थपरिच्छेदस्तत्त्वज्ञानोपनायितः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002294026, "chapter_id": 22294, "verse_number": "३३९-२७", "content_sanskrit": "व्रीडानुरागादिभवः सङ्कोचः कोपि चेतसः ।\nभवेच्चपलताऽस्थैर्यं हर्षश्चित्तप्रसन्नता ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002294027, "chapter_id": 22294, "verse_number": "३३९-२८", "content_sanskrit": "आवेशश्च प्रतीकारः शयो वैधुर्य्यमात्मनः ।\nकर्त्तव्ये प्रतिभाभ्रंशो जड़तेत्यभिधीयते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002294028, "chapter_id": 22294, "verse_number": "३३९-२९", "content_sanskrit": "इष्टप्राप्तेरुपचितः सम्पदाभ्युदयो धृतिः ।\nगर्व्वः परेष्ववज्ञानमात्मन्युत्कर्षभावाना ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002294029, "chapter_id": 22294, "verse_number": "३३९-३०", "content_sanskrit": "भवेद्विषादो दैवादेर्विघातोऽभीष्टवस्तुनि ।\nऔस्सुक्यमीष्सिताप्राप्तेर्वाञ्छया तरला स्थितिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002294030, "chapter_id": 22294, "verse_number": "३३९-३१", "content_sanskrit": "चित्तेन्द्रियाणां स्तैमित्यमपस्मारोऽचला स्थितिः ।\nयुद्धे बाधादिभीस्त्रासो वीप्सा चित्तचमत्कृतिः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002294031, "chapter_id": 22294, "verse_number": "३३९-३२", "content_sanskrit": "क्रोधस्याप्रशमोऽमर्षः प्रबोधश्तेचनोदयः ।\nअवहित्थं भवेद्गुप्तिरिङ्गिताकारगोचरा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002294032, "chapter_id": 22294, "verse_number": "३३९-३३", "content_sanskrit": "रोषतो गुरुवाग्दण्डपारुष्यं विदुरुग्रतां ।\nऊहो वितर्कः स्याद्व्याधिर्मनोवपुरवग्रहः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002294033, "chapter_id": 22294, "verse_number": "३३९-३४", "content_sanskrit": "अनिबद्धप्रलापादिरुन्मादो मदनादिभिः ।\nतत्वज्ञानादिना चेतःकषायोपरमः शमः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002294034, "chapter_id": 22294, "verse_number": "३३९-३५", "content_sanskrit": "कविभिर्योजनीया वै भावाः काव्यादिके रसाः ।\nविभाव्यते हि रत्यादिर्यत्र येन विभाव्यते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002294035, "chapter_id": 22294, "verse_number": "३३९-३६", "content_sanskrit": "विभावो नाम स द्वेधालम्बनोद्दीपनात्मकः ।\nरत्यादिभाववर्गोऽयं यमाजीव्योपजायते ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002294036, "chapter_id": 22294, "verse_number": "३३९-३७", "content_sanskrit": "आलम्बनविभावोऽसौ नायकादिभवस्तथा ।\nधीरोदात्तो धीरोद्धतः स्याद्धीरललितस्तथा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002294037, "chapter_id": 22294, "verse_number": "३३९-३८", "content_sanskrit": "धीरप्रशान्त इत्येवं चतुर्द्धा नायकः स्मृतः ।\nअनुकूलो दक्षैणश्च शठो धृष्टः प्रवर्त्तितः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002294038, "chapter_id": 22294, "verse_number": "३३९-३९", "content_sanskrit": "पीठमर्द्दो विटश्चैव विदूषक इति त्रयः ।\nश्रृड्गारे नर्म्मसचिवा नायकस्यानुनायका ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002294039, "chapter_id": 22294, "verse_number": "३३९-४०", "content_sanskrit": "पीठमर्द्दः सम्बलकः श्रीमांस्तद्वेशजो विटः ।\nविदूषको वैहसिकस्त्वष्टनायकनायिकाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002294040, "chapter_id": 22294, "verse_number": "३३९-४१", "content_sanskrit": "स्वकीया परकीया च पुनर्भूरिति कौशिकाः ।\nसामान्या न पुनर्भूरिरित्याद्या बहुभेदतः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002294041, "chapter_id": 22294, "verse_number": "३३९-४२", "content_sanskrit": "उद्दीपनविभावास्ते संस्कारैर्विविधैः स्थितैः ।\nआलम्बनविभावेषु भावानुद्दीपयन्ति ये ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002294042, "chapter_id": 22294, "verse_number": "३३९-४३", "content_sanskrit": "चतुःषष्टिकला द्वेधा कर्म्माद्यैर्गीतिकादिभिः ।\nकुहकं स्मृतिरप्येषां प्रायो हासोपहारकः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002294043, "chapter_id": 22294, "verse_number": "३३९-४४", "content_sanskrit": "आलम्बनविभावस्य भावैरुद्वुद्धसंस्कृतैः ।\nमनोवाग्बुद्धिवपुषां स्मृतीच्छाद्वेषयत्नत ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002294044, "chapter_id": 22294, "verse_number": "३३९-४५", "content_sanskrit": "आरम्भ एव विदुषामनुभाव इति स्मृतः ।\nस चानुभूयते चात्र भवत्युत निरुच्यते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002294045, "chapter_id": 22294, "verse_number": "३३९-४६", "content_sanskrit": "मनोव्यापारभूयिष्ठो मन आरम्भ उच्यते ।\nद्विविधः पौरुषस्त्रैण ईट्टशोऽपि प्रसिध्यति ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002294046, "chapter_id": 22294, "verse_number": "३३९-४७", "content_sanskrit": "शोभा विलासो माधुर्य्यं स्थैर्य्यं गाम्भीर्य्यमेव च ।\nललितञ्च तथौदार्य्यन्तेजोऽष्टाविति पौरुषाः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002294047, "chapter_id": 22294, "verse_number": "३३९-४८", "content_sanskrit": "नीचनिन्दोत्तमस्पर्द्धा शौर्य्यं दाक्षादिकारणं ।\nमनोधर्म्मे भवेच्छोभा शोभते भवनं यथा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002294048, "chapter_id": 22294, "verse_number": "३३९-४९", "content_sanskrit": "भावो हावश्च हेला च शोभा कान्तिस्तथैव च ।\nदीप्तिर्म्माधुर्य्यशौर्य्ये च प्रागलूभ्यं स्यादुदारता ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002294049, "chapter_id": 22294, "verse_number": "३३९-५०", "content_sanskrit": "स्थैर्य्यं गम्भीरता स्त्रीणां विभावा द्वादशेरिताः ।\nभावो विलासो हावः स्याद्भावः किञ्चिच्च हर्षजः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002294050, "chapter_id": 22294, "verse_number": "३३९-५१", "content_sanskrit": "वाचो युक्तिर्भवेद्वागारम्भो द्वादश एव सः ।\nतत्राभाषणमालापः प्रलापो वचनं वहु१ ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002294051, "chapter_id": 22294, "verse_number": "३३९-५२", "content_sanskrit": "विलापो दुःखवचनमनुलापोऽसकृद्वचः ।\nसंलाप उक्तप्रत्युक्तमपलापोऽन्यथावचः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002294052, "chapter_id": 22294, "verse_number": "३३९-५३", "content_sanskrit": "वार्त्ताप्रयाणं सन्देशो निर्देशः प्रतिपादनम् ।\nतत्त्वदेशोऽतिदेशोऽयमपदेशोऽन्यवर्णनम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002294053, "chapter_id": 22294, "verse_number": "३३९-५४", "content_sanskrit": "उपदेशश्च शिक्षावाक् व्याजोक्तिर्व्यपदेशकः ।\nवोधाय एष व्यापारः सुबुद्ध्यारम्भ इष्यते ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002294054, "chapter_id": 22294, "verse_number": "३३९-५५", "content_sanskrit": "तस्य भेदास्त्रयस्ते च रीतिवृत्तिप्रवृत्तयः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]