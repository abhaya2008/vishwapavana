[{"id": 2158268, "chapter_id": 4427, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2158269, "chapter_id": 4427, "verse_number": "१", "content_sanskrit": "पूर्वमस्मासु भग्नेषु फल्गुनेनामितौजसा ।\nद्रोणे च मोघसङ्कल्पे रक्षिते च युधिष्ठिरे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2158270, "chapter_id": 4427, "verse_number": "२", "content_sanskrit": "सर्वे विशस्त्रकवचास्तावका युधि निर्जिताः ।\nरजस्वला भृशोद्विग्ना वीक्षमाणा दिशो दश\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2158271, "chapter_id": 4427, "verse_number": "३", "content_sanskrit": "अपहारं शनैः कृत्वा भारद्वाजस्य सम्मते ।\nलब्धलक्षैः परैर्भिन्ना भृशावहसिता रणे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2158272, "chapter_id": 4427, "verse_number": "४", "content_sanskrit": "श्लाघमानेषु भूतेषु फल्गुनस्यामितान् गुणान् ।\nकेशवस्य तु सौहार्दे कीर्त्यमानेऽर्जुनं प्रति\nअभिशस्ता इवाभान्ति ध्यानमूकत्वमागताः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2158273, "chapter_id": 4427, "verse_number": "५", "content_sanskrit": "ततो प्रभातसमये द्रोणं दुर्योधनोऽब्रवीत् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2158274, "chapter_id": 4427, "verse_number": "६", "content_sanskrit": "प्रणयादभिमानाच्च द्विषद्वृद्ध्या च दुर्मनाः ।\nशृण्वतां सर्वसैन्यानां संरब्धो द्रोणमब्रवीत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2158275, "chapter_id": 4427, "verse_number": "७", "content_sanskrit": "नूनं वयं वध्यपक्षे भवतो ब्रह्मवित्तम ।\nतथा हि नाग्रहीः प्राप्तं समीपेऽद्य युधिष्ठिरम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2158276, "chapter_id": 4427, "verse_number": "८", "content_sanskrit": "इच्छतो नहि मुच्येत चक्षुर्विषयगो रिपुः ।\nजिघृक्षतो रक्ष्यमाणः ससुरैरपि पाण्डवैः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2158277, "chapter_id": 4427, "verse_number": "", "content_sanskrit": "वरं दत्वा मम प्रीतः पश्चाद् विकृतवानसि ।\nआशाभङ्गं न कुर्वन्ति भक्तस्यार्याः कथञ्चन", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2158278, "chapter_id": 4427, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2158279, "chapter_id": 4427, "verse_number": "९", "content_sanskrit": "ततोऽप्रीतस्तथोक्तस्तु भारद्वाजोऽब्रवीद् नृपम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2158280, "chapter_id": 4427, "verse_number": "१०", "content_sanskrit": "नार्हसे माऽन्यथा ज्ञातुं घटमानं तव प्रिये \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2158281, "chapter_id": 4427, "verse_number": "११", "content_sanskrit": "ससुरासुरगन्धर्वाः सयक्षोरगराक्षसाः ।\nनालं लोका रणे जेतुं पाल्यमानं किरीटिना\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2158282, "chapter_id": 4427, "verse_number": "१२", "content_sanskrit": "विश्वसृग् यत्र गोविन्दः पृतनायां तथाऽर्जुनः ।\nतत्र कस्तद्बलं क्रामेद् अन्यत्र त्र्यम्बकात् प्रभोः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2158283, "chapter_id": 4427, "verse_number": "१३", "content_sanskrit": "सत्यं तु ते ब्रवीम्यद्य न ते जात्वन्यथा भवेत् ।\nअद्यैषां प्रवरं वीरं पातयिष्ये महारथम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2158284, "chapter_id": 4427, "verse_number": "१४", "content_sanskrit": "तं च व्यूहं विधास्यामि अभेद्यं त्रिदशैरपि ।\nयोगेन केनचित् राजन् सोऽर्जुनस्त्वपनीयताम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2158285, "chapter_id": 4427, "verse_number": "१५", "content_sanskrit": "अजितं न च नासह्यं तस्य युद्धेऽस्ति किञ्चन ।\nतेन ह्यवाप्तं सकलमस्त्रग्रामं समन्ततः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2158286, "chapter_id": 4427, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2158287, "chapter_id": 4427, "verse_number": "१६", "content_sanskrit": "द्रोणेन व्याहृते त्वेवं संशप्तकगणाः पुनः ।\nआह्वयन्नर्जुनं सङ्खे दक्षिणामभितो दिशम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2158288, "chapter_id": 4427, "verse_number": "१७", "content_sanskrit": "तत्रार्जुनस्याथ परैः सार्धं समभवद् रणः ।\nतादृशो यादृशो नान्यः श्रुतो दृष्टोऽपि वा पुनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2158289, "chapter_id": 4427, "verse_number": "१८", "content_sanskrit": "तत्र द्रोणेन विहितो व्यूहो राजन् व्यरोचत ।\nचरन् मध्यन्दिने सूर्यो निर्दहन्निव दृग्दृशः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2158290, "chapter_id": 4427, "verse_number": "१९", "content_sanskrit": "तं चाभिमन्युर्वचनात् पितुर्ज्येष्ठस्य धर्मवित् ।\nबिभेद दुर्भिदं सङ्खे चक्रव्यूहमभीतवत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2158291, "chapter_id": 4427, "verse_number": "२०", "content_sanskrit": "स कृत्वा दुष्करं कर्म हत्वा वीरान् सहस्रशः ।\nराजपुत्रशतं हत्वा कौसल्यं च बृहद्बलम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2158292, "chapter_id": 4427, "verse_number": "२२", "content_sanskrit": "महारथं शल्यपुत्रं लक्षणं च तव प्रियम् ।\nषड्भिर्वीरैः सुसंयुक्तो दौःशासनिवशं गतः\t॥२१॥\nनिहतः पुरुषव्याघ्रः सुतो गाण्डीवधन्वनः\nसौभद्रः पृथिवीपाल जहौ प्राणान् परन्तप\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2158293, "chapter_id": 4427, "verse_number": "२३", "content_sanskrit": "वयं परमसंहृष्टाः पाण्डवाः शोककर्शिताः ।\nसौभद्रे निहते राजन्नपहारमकुर्वत\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2158294, "chapter_id": 4427, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2158295, "chapter_id": 4427, "verse_number": "२४", "content_sanskrit": "पुत्रं पुरुषसिंहस्य सञ्जयाप्राप्तयौवनम् ।\nरणे विनिहतं श्रुत्वा भृशं वै दीर्यते मनः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2158296, "chapter_id": 4427, "verse_number": "२५", "content_sanskrit": "दारुणः क्षत्रधर्मोऽयं विहितो धर्मकर्तृभिः ।\nयत्र राज्येप्सवः शूरा बाले शस्त्रमपातयन्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2158297, "chapter_id": 4427, "verse_number": "२६", "content_sanskrit": "बालमत्यन्तसुखिनं विचरन्तमभीतवत् ।\nकृतास्त्रा बहवो जघ्नुः ब्रूहि गावल्गणे कथम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2158298, "chapter_id": 4427, "verse_number": "२७", "content_sanskrit": "बिभित्सता रथानीकं सौभद्रेणामितौजसा ।\nविक्रीडितं यथा सङ्खे तन्ममाचक्ष्व सञ्जय\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2158299, "chapter_id": 4427, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2158300, "chapter_id": 4427, "verse_number": "२८", "content_sanskrit": "यन्मां पृच्छसि राजेन्द्र सौभद्रस्य निपातनम् ।\nतत्ते कार्त्स्न्येन वक्ष्यामि शृणु राजन् समाहितः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2158301, "chapter_id": 4427, "verse_number": "२९", "content_sanskrit": "विक्रीडितं कुमारेण यथानीकं बिभित्सता ।\nआरुग्णाश्च भयाद् वीराः दुःखावासान् सहिष्णवः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2158302, "chapter_id": 4427, "verse_number": "३०", "content_sanskrit": "दावाग्न्यभिपरीतानां भूरि गुल्मतृणद्रुमे ।\nवनौकसामिवारण्ये त्वदीयानामभूत् क्षयः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2158303, "chapter_id": 4427, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि द्वात्रिंशोऽध्यायः ॥ ३२ ॥\nअभिमन्युवधपर्वणि प्रथमोऽध्यायः ॥ १ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]