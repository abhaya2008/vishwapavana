[{"id": 2149370, "chapter_id": 4232, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2149371, "chapter_id": 4232, "verse_number": "१", "content_sanskrit": "प्रतिज्ञाते फल्गुनेन वधे भीष्मस्य सञ्जय ।\nकिमकुर्वत मे पुत्रा मन्दा दुर्योधनादयः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2149372, "chapter_id": 4232, "verse_number": "२", "content_sanskrit": "हतमेव हि पश्यामि गाङ्गेयं पितरं रणे ।\nवासुदेवसहायेन पार्थेन दृढधन्विना\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2149373, "chapter_id": 4232, "verse_number": "३", "content_sanskrit": "स चापरिमितप्रज्ञः तच्छ्रुत्वा पार्थभाषितम् ।\nकिमुक्तवान् महेष्वासो भीष्मः प्रहरतां वरः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2149374, "chapter_id": 4232, "verse_number": "४", "content_sanskrit": "सैनापत्यं च सम्प्राप्य कौरवाणां धुरन्धरः ।\nकिमचेष्टत गाङ्गेयो महाबुद्धिपराक्रमः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2149375, "chapter_id": 4232, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2149376, "chapter_id": 4232, "verse_number": "५", "content_sanskrit": "ततस्तत् सञ्जयस्तस्मै सर्वमेव न्यवेदयत् ।\nयथोक्तं कुरुवृद्धेन भीष्मेणामिततेजसा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2149377, "chapter_id": 4232, "verse_number": "६", "content_sanskrit": "सैनापत्यमनुप्राप्य भीष्मः शान्तनवो नृप ।\nदुर्योधनमुवाचेदं वचनं हर्षयन्निव\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2149378, "chapter_id": 4232, "verse_number": "७", "content_sanskrit": "नमस्कृत्य कुमाराय सेनान्ये शक्तिपाणये\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2149379, "chapter_id": 4232, "verse_number": "८", "content_sanskrit": "अहं सेनापतिस्तेऽद्य भविष्यामि न संशयः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2149380, "chapter_id": 4232, "verse_number": "९", "content_sanskrit": "सेनाकर्मण्यभिज्ञोऽस्मि व्यूहेषु विविधेषु च ।\nकर्म कारयितुं चैव भृतानप्यभृतांस्तथा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2149381, "chapter_id": 4232, "verse_number": "१०", "content_sanskrit": "यात्रायाने च युद्धे च लब्धप्रशमनेषु च ।\nशृङ्गं वेद महाराज यथा वेद बृहस्पतिः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2149382, "chapter_id": 4232, "verse_number": "११", "content_sanskrit": "व्यूहानां च समारम्भान् देवगान्धर्वमानुषान् ।\nतैरहं मोहयिष्यामि पाण्डवान् व्येतु ते ज्वरः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2149383, "chapter_id": 4232, "verse_number": "१२", "content_sanskrit": "सोऽहं योत्स्यामि तत्त्वेन पालयंस्तव वाहिनीम् ।\nयथावच्छास्त्रतो राजन् व्येतु ते मानसो ज्वरः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2149384, "chapter_id": 4232, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2149385, "chapter_id": 4232, "verse_number": "१३", "content_sanskrit": "विद्यते मे न गाङ्गेय भयं देवासुरेष्वपि ।\nसमस्तेषु महाबाहो सत्यमेतद् ब्रवीमि ते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2149386, "chapter_id": 4232, "verse_number": "१४", "content_sanskrit": "किं पुनस्त्वयि दुर्धर्षे सैनापत्ये व्यवस्थिते ।\nद्रोणे च पुरुषव्याघ्रे स्थिते युद्धाभिनन्दिनि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2149387, "chapter_id": 4232, "verse_number": "१५", "content_sanskrit": "भवद्भ्यां पुरुषाग्र्याभ्यां स्थिताभ्यां विजयो मम ।\nन दुर्लभं कुरुश्रेष्ठ देवराज्यमपि ध्रुवम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2149388, "chapter_id": 4232, "verse_number": "१६", "content_sanskrit": "रथसङ्ख्यां तु कार्त्स्न्येन परेषामात्मनस्तथा ।\nतथैवातिरथानां च वेत्तुमिच्छामि कौरव\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2149389, "chapter_id": 4232, "verse_number": "१७", "content_sanskrit": "पितामहो हि कुशलः परेषामात्मनस्तथा ।\nश्रोतुमिच्छाम्यहं सर्वैः सहैभिर्वसुधाधिपैः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2149390, "chapter_id": 4232, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2149391, "chapter_id": 4232, "verse_number": "१८", "content_sanskrit": "गान्धारे शृणु राजेन्द्र रथसङ्ख्यां स्वके बले ।\nये रथाः पृथिवीपाल तथैवातिरथाश्च ये\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2149392, "chapter_id": 4232, "verse_number": "१९", "content_sanskrit": "पत्तीनां तव सेनायां प्रयुतान्यर्बुदानि च ।\nरथानां तव सेनायां यथामुख्यं तु मे शृणु\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2149393, "chapter_id": 4232, "verse_number": "२०", "content_sanskrit": "भवानग्रे रथोदारः सह सर्वैः सहोदरैः ।\nदुःशासनप्रभृतिभिः भ्रातृभिः शतसम्मितैः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2149394, "chapter_id": 4232, "verse_number": "२१", "content_sanskrit": "सर्वे कृतप्रहरणाः छेद्यभेद्यविशारदाः ।\nरथोपस्थे गजस्कन्धे गदायुद्धेऽसिचर्मणि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2149395, "chapter_id": 4232, "verse_number": "२२", "content_sanskrit": "संयातारः प्रहर्तारः कृतास्त्रा भारसाधनाः ।\nइष्वस्त्रे द्रोणशिष्याश्च कृपस्य च शरद्वतः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2149396, "chapter_id": 4232, "verse_number": "२३", "content_sanskrit": "एते हनिष्यन्ति रणे पाञ्चालान् युद्धदुर्मदान् ।\nकृतकिल्बिषाः पाण्डवेयैर्धार्तराष्ट्रा मनस्विनः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2149397, "chapter_id": 4232, "verse_number": "२४", "content_sanskrit": "तथाऽहं भरतश्रेष्ठ सर्वसेनापतिस्तव ।\nशत्रून् विध्वंसयिष्यामि कदर्थीकृत्य पाण्डवान्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2149398, "chapter_id": 4232, "verse_number": "२५", "content_sanskrit": "न त्वात्मनो गुणान् वक्तुमर्हामि विदितोऽस्मि ते\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2149399, "chapter_id": 4232, "verse_number": "२६", "content_sanskrit": "कृतवर्मा त्वतिरथो भोजः शस्त्रभृतां वरः ।\nअर्थसिद्धिं तव रणे करिष्यति न संशयः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2149400, "chapter_id": 4232, "verse_number": "२७", "content_sanskrit": "शस्त्रविद्भिरनाधृष्यो दूरपाती दृढायुधः ।\nहनिष्यति चमूं तेषां महेन्द्रो दानवानिव\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2149401, "chapter_id": 4232, "verse_number": "२८", "content_sanskrit": "मद्रराजो महेष्वासः शल्यो मेऽतिरथो मतः ।\nस्पर्धते वासुदेवेन नित्यं यो वै रणे रणे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2149402, "chapter_id": 4232, "verse_number": "२९", "content_sanskrit": "भागिनेयान् निजांस्त्यक्त्वा शल्यस्तेऽतिरथो मतः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2149403, "chapter_id": 4232, "verse_number": "३०", "content_sanskrit": "एष योत्स्यति सङ्ग्रामे कृष्णं चक्रगदाधरम् ।\nसागरोर्मिसमैर्बाणैः प्लावयन्निव शात्रवान्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2149404, "chapter_id": 4232, "verse_number": "३१", "content_sanskrit": "भूरिश्रवाः कृतास्त्रश्च तव चापि हितः सुहृत् ।\nसौमदत्तिर्महेष्वासो रथयूथपयूथपः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2149405, "chapter_id": 4232, "verse_number": "३२", "content_sanskrit": "बलक्षयममित्राणां सुमहान्तं करिष्यति\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2149406, "chapter_id": 4232, "verse_number": "३३", "content_sanskrit": "सिन्धुराजो महाराज मतो मे द्विगुणो रथः ।\nयोत्स्यते समरे राजन् विक्रान्तो रथसत्तमः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2149407, "chapter_id": 4232, "verse_number": "३४", "content_sanskrit": "द्रौपदीहरणे पूर्वं परिक्लिष्टश्च पाण्डवैः ।\nसंस्मरंस्तं परिक्लेशं योत्स्यते परवीरहा\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2149408, "chapter_id": 4232, "verse_number": "३५", "content_sanskrit": "एतेन हि तदा राजन् तप आस्थाय दारुणम् ।\nसुदुर्लभो वरो लब्धः पाण्डवान् योद्धुमाहवे\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2149409, "chapter_id": 4232, "verse_number": "३६", "content_sanskrit": "स एष रथशार्दूलः तद्वैरं संस्मरन् रणे ।\nयोत्स्यते पाण्डवैस्तात प्राणांस्त्यक्त्वा सुदुस्त्यजान्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2149410, "chapter_id": 4232, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि त्रिषष्ट्युत्तरशततमोऽध्यायः ॥१६३॥ रथातिरथसङ्ख्यानपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]