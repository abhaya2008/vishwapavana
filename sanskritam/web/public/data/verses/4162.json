[{"id": 2146552, "chapter_id": 4162, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2146553, "chapter_id": 4162, "verse_number": "१", "content_sanskrit": "तथा कथयतोरेव तयोर्बुद्धिमतोस्तदा ।\nशिवा नक्षत्रसम्पन्ना सा व्यतीयाय शर्वरी\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2146554, "chapter_id": 4162, "verse_number": "२", "content_sanskrit": "धर्म्या रम्याश्चार्थवतीः विचित्रार्थपदाक्षराः ।\nशृण्वतो विविधा वाचो विदुरस्य महात्मनः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2146555, "chapter_id": 4162, "verse_number": "३", "content_sanskrit": "कथाभिरनुकूलाभी रक्तस्यामिततेजसः ।\nअकामस्यैव कृष्णस्य सा व्यतीयाय शर्वरी\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2146556, "chapter_id": 4162, "verse_number": "४", "content_sanskrit": "ततस्तु स्वरसम्पन्ना बहवः सूतमागधाः ।\nशङ्खदुन्दुभिनिर्घोषैः केशवं प्रत्यबोधयन्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2146557, "chapter_id": 4162, "verse_number": "५", "content_sanskrit": "ब्रह्मादिवासुदेवान्तं वंशं समनुकीर्तयन् ।\nतुष्टुवुः पुण्डरीकाक्षं बहवः सूतमागधाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2146558, "chapter_id": 4162, "verse_number": "६", "content_sanskrit": "तत उत्थाय दाशार्ह ऋषभः सर्वसात्वताम् ।\nसर्वमावश्यकं चक्रे प्रातःकार्यं जनार्दनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2146559, "chapter_id": 4162, "verse_number": "७", "content_sanskrit": "कृतोदकः कृतजपो हुताग्निः समलङ्कृतः ।\nतत आदित्यमुद्यन्तमुपातिष्ठत माधवः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2146560, "chapter_id": 4162, "verse_number": "८", "content_sanskrit": "अथ दुर्योधनः कर्णः शकुनिश्चापि सौबलः ।\nसन्ध्यां तिष्ठन्तमभ्यायन् दाशार्हमपराजितम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2146561, "chapter_id": 4162, "verse_number": "९", "content_sanskrit": "आचख्युस्ते तु कृष्णस्य धृतराष्ट्रं सभागतम् ।\nकुरूंश्च भीष्मप्रमुखान् राज्ञः सर्वांश्च पार्थिवान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2146562, "chapter_id": 4162, "verse_number": "१०", "content_sanskrit": "त्वामर्थयन्ते गोविन्द दिवि शक्रमिवामराः ।\nतानभ्यनन्दद् गोविन्दः साम्ना परमवल्गुना\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2146563, "chapter_id": 4162, "verse_number": "११", "content_sanskrit": "ततो विमल आदित्ये ब्राह्मणेभ्यो जनार्दनः ।\nददौ हिरण्यं वासांसि गवाश्वांश्च परन्तपः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2146564, "chapter_id": 4162, "verse_number": "१२", "content_sanskrit": "विसृष्टवन्तं रत्नानि दाशार्हमपराजितम् ।\nतिष्ठन्तमुपसङ्गम्य ववन्दे सारथिस्तदा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2146565, "chapter_id": 4162, "verse_number": "१३", "content_sanskrit": "ततो रथेन शुभ्रेण महता किङ्किणीकिना ।\nहयोत्तमयुजा शीघ्रमुपातिष्ठत दारुकः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2146566, "chapter_id": 4162, "verse_number": "१४", "content_sanskrit": "तस्मै रथवरो युक्तः शुशुभे लोकविश्रुतः ।\nवाजिभिः सैन्यसुग्रीवमेघपुष्पबलाहकैः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2146567, "chapter_id": 4162, "verse_number": "१५", "content_sanskrit": "सैन्यस्तु शुकपत्राभः सुग्रीवः किंशुकप्रभः ।\nमेघपुष्पो मेघवर्णः पाण्डरस्तु बलाहकः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2146568, "chapter_id": 4162, "verse_number": "१६", "content_sanskrit": "दक्षिणं चावहत् सैन्यः सुग्रीवः सव्यतोऽवहत् ।\nपृष्ठबाहौ तयोरास्तां मेघपुष्पबलाहकौ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2146569, "chapter_id": 4162, "verse_number": "१७", "content_sanskrit": "विश्वकर्मकृतापीडा रत्नजालविभूषिता ।\nआश्रिता वै रथे तस्मिन् ध्वजयष्टिरशोभत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2146570, "chapter_id": 4162, "verse_number": "१८", "content_sanskrit": "वैनतेयः स्थितस्तस्यां प्रभाकरमिव स्पृशन् ।\nतस्य सत्ववतः केतौ भुजगारिरशोभत\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2146571, "chapter_id": 4162, "verse_number": "१९", "content_sanskrit": "तस्य कीर्तिमतस्तेन भास्वरेण विराजता ।\nशुशुभे स्यन्दनश्रेष्ठः पतगेन्द्रेण केतुना\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2146572, "chapter_id": 4162, "verse_number": "२०", "content_sanskrit": "रुग्मजालैः पताकाभिः सौवर्णेन च केतुना ।\nबभूव स रथश्रेष्ठः कालसूर्य इवोदितः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2146573, "chapter_id": 4162, "verse_number": "२१", "content_sanskrit": "पक्षिपक्षवितानैश्च रुग्मजालकृतान्तरैः ।\nदण्डमार्गविभागैश्च सुकृतैर्विश्वकर्मणा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2146574, "chapter_id": 4162, "verse_number": "२२", "content_sanskrit": "प्रवालमणिहेमैश्च मुक्तावैडूर्यभूषणैः ।\nकिङ्किणीशतसङ्घैश्च वालजालकृतान्तरैः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2146575, "chapter_id": 4162, "verse_number": "२३", "content_sanskrit": "कार्तस्वरमयीभिश्च पद्मिनीभिरलङ्कृतः ।\nशुशुभे स्यन्दनश्रेष्ठः तपनीयैश्च पादपैः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2146576, "chapter_id": 4162, "verse_number": "२४", "content_sanskrit": "व्याघ्रसिंहवराहैश्च गोवृषैर्मृगपक्षिभिः ।\nताराभिर्भास्करैश्चापि वारणैश्च हिरण्मयैः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2146577, "chapter_id": 4162, "verse_number": "२५", "content_sanskrit": "वज्राङ्कुशविमानैश्च कूबरावर्तसन्धिषु ।\nसमुच्छ्रितमहानाभिः स्तनयित्नुमहास्वनः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2146578, "chapter_id": 4162, "verse_number": "२६", "content_sanskrit": "तमुपस्थितमाज्ञाय रथं दिव्यं महामनाः ।\nमहाभ्रघनसङ्काशं सर्वरत्नविभूषितम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2146579, "chapter_id": 4162, "verse_number": "२७", "content_sanskrit": "अग्निं प्रदक्षिणं कृत्वा ब्राह्मणांश्च जनार्दनः ।\nकौस्तुभं मणिमाबध्य श्रिया परमया ज्वलन्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2146580, "chapter_id": 4162, "verse_number": "२८", "content_sanskrit": "कुरुभिः संवृतः कृष्णो वृष्णिभिश्चाभिरक्षितः ।\nआतिष्ठत रथं शौरिः सर्वयादवनन्दनः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2146581, "chapter_id": 4162, "verse_number": "२९", "content_sanskrit": "अन्वारुरोह दाशार्हं विदुरः सर्वधर्मवित् ।\nसर्वप्राणभृतां श्रेष्ठं सर्वबुद्धिमतां वरम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2146582, "chapter_id": 4162, "verse_number": "३०", "content_sanskrit": "ततो दुर्योधनः कर्णः शकुनिश्चापि सौबलः ।\nद्वितीयेन रथेनैनमन्वयुस्ते परन्तपम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2146583, "chapter_id": 4162, "verse_number": "३१", "content_sanskrit": "सात्यकिः कृतवर्मा च वृष्णीनां च महारथाः ।\nपृष्ठतोऽनुययुः कृष्णं गजैरश्वै रथैरपि\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2146584, "chapter_id": 4162, "verse_number": "३२", "content_sanskrit": "तेषां हेमपरिष्कारैर्युक्ताः परमवाजिभिः ।\nयास्यतां घोषिणश्चित्राः चारु बभ्राजिरे रथाः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2146585, "chapter_id": 4162, "verse_number": "३३", "content_sanskrit": "सम्मृष्टसंसिक्तरजः प्रतिपेदे महापथम् ।\nराजर्षिचरितं काले कृष्णो धीमान् श्रिया ज्वलन्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2146586, "chapter_id": 4162, "verse_number": "३४", "content_sanskrit": "ततः प्रयाते दाशार्हे प्रवाद्यन्ते स्म पुष्कराः ।\nशङ्खाश्च दध्मिरे तत्र वाद्यान्यन्यानि यानि च\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2146587, "chapter_id": 4162, "verse_number": "३५", "content_sanskrit": "प्रवीराः सर्वलोकस्य युवानः सिंहविक्रमाः ।\nपरिवार्य रथं शौरेरगच्छन्त परन्तपाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2146588, "chapter_id": 4162, "verse_number": "३६", "content_sanskrit": "ततोऽन्ये बहुसाहस्रा विचित्राद्भुतवाससः ।\nअसिप्रासायुधधराः कृष्णस्यासन् पुरस्सराः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2146589, "chapter_id": 4162, "verse_number": "३७", "content_sanskrit": "गजाः पञ्चशतास्तत्र रथाश्चासन् सहस्रशः ।\nप्रयान्तमन्वयुर्वीरं दाशार्हमपराजितम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2146590, "chapter_id": 4162, "verse_number": "३८", "content_sanskrit": "पुरं कुरूणां संवृत्तं द्रष्टुकामं जनार्दनम् ।\nआबालवृद्धं सस्त्रीकं रथ्यागतमरिन्दमम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2146591, "chapter_id": 4162, "verse_number": "३९", "content_sanskrit": "वेदिकामाश्रिताभिश्च समाक्रान्तान्यनेकशः ।\nप्रचलन्तीव भारेण योषिद्भिर्भवनान्युत\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2146592, "chapter_id": 4162, "verse_number": "४०", "content_sanskrit": "सम्पूज्यमानः कुरुभिः संशृण्वन् विविधाः कथाः ।\nयथार्हं प्रतिसत्कुर्वन् प्रेक्षमाणः शनैर्ययौ\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2146593, "chapter_id": 4162, "verse_number": "४१", "content_sanskrit": "ततः सभां समासाद्य केशवस्यानुयायिनः ।\nसशङ्खैर्वेणुनिर्घोषैः दिशः सर्वा व्यनादयन्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2146594, "chapter_id": 4162, "verse_number": "४२", "content_sanskrit": "ततः सा समितिः सर्वा राज्ञाममिततेजसाम् ।\nसम्प्राकम्पत हर्षेण कृष्णागमनकाङ्क्षया\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2146595, "chapter_id": 4162, "verse_number": "४३", "content_sanskrit": "ततोऽभ्याशं गते कृष्णे समहृष्यन् नराधिपाः ।\nश्रुत्वा तं रथनिर्घोषं पर्जन्यनिनदोपमम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2146596, "chapter_id": 4162, "verse_number": "४४", "content_sanskrit": "आसाद्य तु सभाद्वारम् ऋषभः सर्वसात्वताम् ।\nअवतीर्य रथाच्छौरिः कैलासशिखरोपमात्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2146597, "chapter_id": 4162, "verse_number": "४५", "content_sanskrit": "नगमेघप्रतीकाशां ज्वलन्तीमिव तेजसा ।\nमहेन्द्रसदनप्रख्यां प्रविवेश सभां ततः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2146598, "chapter_id": 4162, "verse_number": "४६", "content_sanskrit": "पाणौ गृहीत्वा विदुरं सात्यकिं च महायशाः ।\nज्योतींष्यादित्यवद् राजन् कुरून् प्राच्छादयच्छ्रिया\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2146599, "chapter_id": 4162, "verse_number": "४७", "content_sanskrit": "अग्रतो वासुदेवस्य कर्णदुर्योधनावुभौ ।\nवृष्णयः कृतवर्मा चाप्यासन् कृष्णस्य पृष्ठतः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2146600, "chapter_id": 4162, "verse_number": "४८", "content_sanskrit": "धृतराष्ट्रं पुरस्कृत्य भीष्मद्रोणादयश्च ते ।\nआसनेभ्योऽचलन् सर्वे पूजयन्तो जनार्दनम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2146601, "chapter_id": 4162, "verse_number": "४९", "content_sanskrit": "अभ्यागच्छति दाशार्हे प्रज्ञाचक्षुर्महामनाः ।\nसहैव द्रोणभीष्माभ्याम् उदतिष्ठन्महायशाः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2146602, "chapter_id": 4162, "verse_number": "५०", "content_sanskrit": "उत्तिष्ठति महाराजे धृतराष्ट्रे जनेश्वरे ।\nतानि राजसहस्राणि समुत्तस्थुः समन्ततः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2146603, "chapter_id": 4162, "verse_number": "५१", "content_sanskrit": "आसनं सर्वतोभद्रं जाम्बूनदपरिष्कृतम् ।\nकृष्णार्थे कल्पितं तत्र धृतराष्ट्रस्य शासनात्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2146604, "chapter_id": 4162, "verse_number": "५२", "content_sanskrit": "स्मयमानस्तु राजानं भीष्मद्रौणौ च माधवः ।\nअभ्यभाषत धर्मात्मा राज्ञश्चान्यान् यथावयः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2146605, "chapter_id": 4162, "verse_number": "५३", "content_sanskrit": "तत्र केशवमानर्चुः सम्यगभ्यागतं सभाम् ।\nराजानः पार्थिवाः सर्वे कुरवश्च जनार्दनम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2146606, "chapter_id": 4162, "verse_number": "५४", "content_sanskrit": "तत्र तिष्ठन् स दाशार्हो राजमध्ये परन्तपः ।\nअपश्यदन्तरिक्षस्थान् ऋषीन् परपुरञ्जयः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2146607, "chapter_id": 4162, "verse_number": "५५", "content_sanskrit": "ततस्तानभिसम्प्रेक्ष्य नारदप्रमुखानृषीन् ।\nअभ्यभाषत दाशार्हो भीष्मं शान्तनवं शनैः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2146608, "chapter_id": 4162, "verse_number": "५६", "content_sanskrit": "पार्थिवीं समितिं द्रष्टुम् ऋषयोऽभ्यागता नृप ।\nनिमन्त्र्यन्तामासनैश्च सत्कारेण च भूयसा\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2146609, "chapter_id": 4162, "verse_number": "५७", "content_sanskrit": "नैतेष्वनुपविष्टेषु शक्यं केनचिदासितुम् ।\nपूजा प्रयुज्यतामाशु मुनीनां भावितात्मनाम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2146610, "chapter_id": 4162, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2146611, "chapter_id": 4162, "verse_number": "५८", "content_sanskrit": "ऋषीन् शान्तनवो दृष्ट्वा सभाद्वारमुपस्थितान् ।\nत्वरमाणस्ततो भृत्यान् आसनानीत्यचोदयत्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2146612, "chapter_id": 4162, "verse_number": "५९", "content_sanskrit": "आसनान्यथ मृष्टानि महान्ति विपुलानि च ।\nमणिकाञ्चनचित्राणि समाजह्रुस्ततस्ततः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2146613, "chapter_id": 4162, "verse_number": "६०", "content_sanskrit": "तेषु तत्रोपविष्टेषु गृहीतार्घ्येषु भारत ।\nनिषसादासने कृष्णो राजानश्च यथासनम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2146614, "chapter_id": 4162, "verse_number": "६१", "content_sanskrit": "दुःशासनः सात्यकये ददावासनमुत्तमम् ।\nविविंशतिर्ददौ पीठं काञ्चनं कृतवर्मणे\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2146615, "chapter_id": 4162, "verse_number": "६२", "content_sanskrit": "अविदूरे तु कृष्णस्य कर्णदुर्योधनावुभौ ।\nएकासने महात्मानौ निषीदतुररिन्दमौ\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2146616, "chapter_id": 4162, "verse_number": "६३", "content_sanskrit": "गान्धारराजः शकुनिः गान्धारैरभिरक्षितः ।\nनिषसादासने राजा सहपुत्रैर्विशाम्पते\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2146617, "chapter_id": 4162, "verse_number": "६४", "content_sanskrit": "विदुरो मणिपीठे तु शुक्लस्पर्ध्याजिनोत्तरे ।\nसंस्पृशन्नासनं शौरेः महामतिरुपाविशत्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2146618, "chapter_id": 4162, "verse_number": "६४", "content_sanskrit": "चिरस्य दृष्ट्वा दाशार्हं राजानः सर्वपार्थिवाः ।\nअमृतस्येव नातृप्यन् प्रेक्षमाणा जनार्दनम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2146619, "chapter_id": 4162, "verse_number": "६६", "content_sanskrit": "असतीपुष्पसङ्काशः पीतवासा जनार्दनः ।\nव्यभ्राजत सभामध्ये हेम्नीवोपहितो मणिः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2146620, "chapter_id": 4162, "verse_number": "६७", "content_sanskrit": "ततस्तूष्णीं सर्वमासीद् गोविन्दगतमानसम् ।\nन तत्र कश्चित् किञ्चिद्वा व्याजहार पुमान् क्वचित्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2146621, "chapter_id": 4162, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि त्रिनवतितमोऽध्यायः ॥९३॥\nभगवद्यानपर्वणि चतुर्विंशोऽध्यायः ॥२४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]