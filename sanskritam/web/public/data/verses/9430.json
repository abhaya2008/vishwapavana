[{"id": 5000430000, "chapter_id": 9430, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे त्रयोविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000430001, "chapter_id": 9430, "verse_number": "६-२३-१", "content_sanskrit": "निमित्तानि निमित्तज्ञो दृष्ट्वा लक्ष्मणपूर्वजः।\nसौमित्रिं सम्परिष्वज्य इदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000430002, "chapter_id": 9430, "verse_number": "६-२३-२", "content_sanskrit": "परिगृह्योदकं शीतं वनानि फलवन्ति च।\nबलौघं संविभज्येमं व्यूह्य तिष्ठेम लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000430003, "chapter_id": 9430, "verse_number": "६-२३-३", "content_sanskrit": "लोकक्षयकरं भीमं भयं पश्याम्युपस्थितम्।\nप्रबर्हणं प्रवीराणामृक्षवानररक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000430004, "chapter_id": 9430, "verse_number": "६-२३-४", "content_sanskrit": "वाताश्च कलुषा वान्ति कम्पते च वसुंधरा।\nपर्वताग्राणि वेपन्ते पतन्ति च महीरुहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000430005, "chapter_id": 9430, "verse_number": "६-२३-५", "content_sanskrit": "मेघाः क्रव्यादसंकाशाः परुषाः परुषस्वनाः।\nक्रूराः क्रूरं प्रवर्षन्ति मिश्रं शोणितबिन्दुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000430006, "chapter_id": 9430, "verse_number": "६-२३-६", "content_sanskrit": "रक्तचन्दनसंकाशा संध्या परमदारुणा।\nज्वलतः प्रपतत्येतदादित्यादग्निमण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000430007, "chapter_id": 9430, "verse_number": "६-२३-७", "content_sanskrit": "दीना दीनस्वराः क्रूराः सर्वतो मृगपक्षिणः।\nप्रत्यादित्यं विनर्दन्ति जनयन्तो महद्भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000430008, "chapter_id": 9430, "verse_number": "६-२३-८", "content_sanskrit": "रजन्यामप्रकाशस्तु संतापयति चन्द्रमाः।\nकृष्णरक्तांशुपर्यन्तो लोकक्षय इवोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000430009, "chapter_id": 9430, "verse_number": "६-२३-९", "content_sanskrit": "ह्रस्वो रूक्षोऽप्रशस्तश्च परिवेषस्तु लोहितः।\nआदित्ये विमले नीलं लक्ष्म लक्ष्मण दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000430010, "chapter_id": 9430, "verse_number": "६-२३-१०", "content_sanskrit": "रजसा महता चापि नक्षत्राणि हतानि च।\nयुगान्तमिव लोकानां पश्य शंसन्ति लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000430011, "chapter_id": 9430, "verse_number": "६-२३-११", "content_sanskrit": "काकाः श्येनास्तथा नीचा गृध्राः परिपतन्ति च।\nशिवाश्चाप्यशुभान् नादान् नदन्ति सुमहाभयान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000430012, "chapter_id": 9430, "verse_number": "६-२३-१२", "content_sanskrit": "शैलैः शूलैश्च खड्गैश्च विमुक्तैः कपिराक्षसैः।\nभविष्यत्यावृता भूमिर्मांसशोणितकर्दमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000430013, "chapter_id": 9430, "verse_number": "६-२३-१३", "content_sanskrit": "क्षिप्रमद्यैव दुर्धर्षां पुरीं रावणपालिताम्।\nअभियाम जवेनैव सर्वैर्हरिभिरावृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000430014, "chapter_id": 9430, "verse_number": "६-२३-१४", "content_sanskrit": "इत्येवमुक्त्वा धन्वी स रामः संग्रामधर्षणः।\nप्रतस्थे पुरतो रामो लङ्कामभिमुखो विभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000430015, "chapter_id": 9430, "verse_number": "६-२३-१५", "content_sanskrit": "सविभीषणसुग्रीवाः सर्वे ते वानरर्षभाः।\nप्रतस्थिरे विनर्दन्तो धृतानां द्विषतां वधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000430016, "chapter_id": 9430, "verse_number": "६-२३-१६", "content_sanskrit": "राघवस्य प्रियार्थं तु सुतरां वीर्यशालिनाम्।\nहरीणां कर्मचेष्टाभिस्तुतोष रघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000430017, "chapter_id": 9430, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे त्रयोविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]