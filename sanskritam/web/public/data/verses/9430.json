[{"id": 40023266, "chapter_id": 9430, "verse_number": "1", "content_sanskrit": "एतावदेतदाख्यानं सोत्तरं ब्रह्मपूजितम् । रामायणमिति ख्यातं मुख्यं वाल्मीकीना कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40023267, "chapter_id": 9430, "verse_number": "2", "content_sanskrit": "ततः प्रतिष्ठितो विष्णुः स्वर्गलोके यथा पुरम् । येन व्याप्तमिदं सर्वं त्रैलोक्यं सचराचरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40023268, "chapter_id": 9430, "verse_number": "3", "content_sanskrit": "ततो देवाः सगन्धर्वाः सिद्धाश्च परमर्षयः । नित्यं शृण्वन्ति सन्तुष्टाः दिव्यं रामायणं दिवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40023269, "chapter_id": 9430, "verse_number": "4", "content_sanskrit": "इदमाख्यानमायुष्यं सौभाग्यं पापनाशनम् । रामायणं वेदसमं श्राद्धेषु श्रावयेद्बुधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40023270, "chapter_id": 9430, "verse_number": "5", "content_sanskrit": "अपुत्रो लभते पुत्रमधनो लभते धनम् । सर्वपापैः प्रमुच्येत पदमप्यस्य यः पठेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40023271, "chapter_id": 9430, "verse_number": "6", "content_sanskrit": "पापान्यपि च यः कुर्यादहन्यहनि मानवः । पठत्येकमपि श्लोकं पापात्स परिमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40023272, "chapter_id": 9430, "verse_number": "7", "content_sanskrit": "वाचकाय च दातव्यं वस्त्रं धेनुं हिरण्यकम् । वाचके परितुष्टे तु तुष्टाः स्युः सर्वदेवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40023273, "chapter_id": 9430, "verse_number": "8", "content_sanskrit": "एतदाख्यानमायुष्यं पठन्रामायणं नरः । सपुत्रपौत्रो लोके ऽस्मिन्प्रेत्य चेह महीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40023274, "chapter_id": 9430, "verse_number": "9", "content_sanskrit": "अयोध्या ऽपि पुरी रम्या शून्या वर्षगणान्बहून् । ऋषभं प्राप्य राजानं निवासमुपयास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40023275, "chapter_id": 9430, "verse_number": "10", "content_sanskrit": "एतदाख्यानमायुष्यं सभविष्यं सहोत्तरम् । कृतवान्प्रचेतसः पुत्रस्तद्ब्रह्माप्यन्वमन्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40023276, "chapter_id": 9430, "verse_number": "11", "content_sanskrit": "अश्वमेधसहस्रस्य वाजपेयायुतस्य च । लभते श्रावणादेव सर्गस्यैकस्य मानवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40023277, "chapter_id": 9430, "verse_number": "12", "content_sanskrit": "प्रयागादीनि तीर्थानि गङ्गाद्याः सरितस्तथा । नैमिशादीन्यरण्यानि कुरुक्षेत्रादिकान्यपि । गतानि तेन लोके ऽस्मिन्येन रामायणं श्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40023278, "chapter_id": 9430, "verse_number": "13", "content_sanskrit": "हेमभारं कुरुक्षेत्रे ग्रस्ते भानौ प्रयच्छति । यश्च रामायणं लोके शृणोति सदृशावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40023279, "chapter_id": 9430, "verse_number": "14", "content_sanskrit": "सम्यक्छ्रद्धासमायुक्तः शृणुते राघवीं कथाम् । सर्वपापात्प्रमुच्येत विष्णुलोकं स गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40023280, "chapter_id": 9430, "verse_number": "15", "content_sanskrit": "आदिकाव्यमिदं त्वार्षं पुरा वाल्मीकिना कृतम् । यः शृणोति सदा भक्त्या स गच्छेद्वैष्णवीं तनुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40023281, "chapter_id": 9430, "verse_number": "16", "content_sanskrit": "पुत्रदाराश्च वर्धन्ते सम्पदः सन्ततिस्तथा । सत्यमेतद्विदित्वा तु श्रोतव्यं नियतात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40023282, "chapter_id": 9430, "verse_number": "17", "content_sanskrit": "गायत्र्याश्च स्वरूपं तद्रामायणमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40023283, "chapter_id": 9430, "verse_number": "18", "content_sanskrit": "अपुत्रो लभते पुत्रमधनो लभते धनम् । सर्वपापैः प्रमुच्येत पदमप्यस्य यः पठेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40023284, "chapter_id": 9430, "verse_number": "19", "content_sanskrit": "यः पठेच्छृणुयान्नित्यं चरितं राघवस्य ह । भक्त्या निष्कल्मषो भूत्वा दीर्घमायुरवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40023285, "chapter_id": 9430, "verse_number": "20", "content_sanskrit": "चिन्तयेद्राघवं नित्यं श्रेयः प्राप्तुं य इच्छति । श्रावयेदिदमाख्यानं ब्राह्मणेभ्यो दिने दिने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40023286, "chapter_id": 9430, "verse_number": "21", "content_sanskrit": "यस्त्विदं रघुनाथस्य चरितं सकलं पठेत् । सो ऽसुक्षये विष्णुलोकं गच्छत्येव न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40023287, "chapter_id": 9430, "verse_number": "22", "content_sanskrit": "पिता पितामहस्तस्य तथैव प्रपितामहः । तत्पिता तत्पिता चैव विष्णुं यान्ति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40023288, "chapter_id": 9430, "verse_number": "23", "content_sanskrit": "चतुर्वर्गप्रदं नित्यं चरितं राघवस्य तु । तस्माद्यत्नवता नित्यं श्रोतव्यं परमं सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40023289, "chapter_id": 9430, "verse_number": "24", "content_sanskrit": "शृण्वन्रामायणं भक्त्या यः पादं पदमेव वा । स याति ब्रह्मणः स्थानं ब्रह्मणा पूज्यते सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40023290, "chapter_id": 9430, "verse_number": "25", "content_sanskrit": "एवमेतत्पुरावृत्तमाख्यानं भद्रमस्तु वः । प्रव्याहरत विस्रब्धं बलं विष्णोः प्रवर्धताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]