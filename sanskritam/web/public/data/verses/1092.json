[{"id": 2004602, "chapter_id": 1092, "verse_number": "१-९३-०x", "content_sanskrit": "कण्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2004603, "chapter_id": 1092, "verse_number": "१-९३-१", "content_sanskrit": "एवमुक्तस्तया शक्रः संदिदेश सदागतिम्।\nप्रातिष्ठत तदा काले मेनका वायुना सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2004604, "chapter_id": 1092, "verse_number": "१-९३-२", "content_sanskrit": "अथापश्यद्वरारोहा तपसा दग्धकिल्बिषम्।\nमिश्वामित्रं तप्यमानं मेनका भीरुराश्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2004605, "chapter_id": 1092, "verse_number": "१-९३-३", "content_sanskrit": "अभिवाद्य ततः सा तं प्राक्रीडदृषिसन्निधौ।\nअपोवाह च वासोऽस्या मारुतः शशिसंनिभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2004606, "chapter_id": 1092, "verse_number": "१-९३-४", "content_sanskrit": "सागच्छत्त्वरिता भूमिं वासस्तदभिलिप्सती।\nकुत्सयन्तीव सव्रीडं मारुतं वरवर्णिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2004607, "chapter_id": 1092, "verse_number": "१-९३-५", "content_sanskrit": "पश्यतस्तस्य राजर्षेरप्यग्निसमतेजसः।\nविश्वामित्रस्ततस्तां तु विषमस्थामनिन्दिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2004608, "chapter_id": 1092, "verse_number": "१-९३-६", "content_sanskrit": "गृद्धां वाससि संभ्रान्तां मेनकां मुनिसत्तमः।\nअनिर्देश्यवयोरूपामपश्यद्विवृतां तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2004609, "chapter_id": 1092, "verse_number": "१-९३-७", "content_sanskrit": "तस्या रूपगुणान्दृष्ट्वा स तु विप्रर्षभस्तदा।\nचकार भावं संसर्गे तया कामवशं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2004610, "chapter_id": 1092, "verse_number": "१-९३-८", "content_sanskrit": "न्यमन्त्रयत चाप्येनां सा चाप्यैच्छदनिन्दिता।\nतौ तत्र सुचिरं कालमुभौ व्यवहरतां तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2004611, "chapter_id": 1092, "verse_number": "१-९३-९", "content_sanskrit": "रममाणौ यथाकामं यतैकदिवसं तथा।\nएवं वर्षसहस्राणामतीतं नान्वचिन्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2004612, "chapter_id": 1092, "verse_number": "१-९३-१०", "content_sanskrit": "कामक्रोधावजितवान्मुनिर्नित्यं समाहितः।\nचिरार्जितस्य तपसः क्षयं स कृतवान्मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2004613, "chapter_id": 1092, "verse_number": "१-९३-११", "content_sanskrit": "तपसः संक्षयादेव मुनिर्मोहं समाविशत्।\nमोहाभिभूतः क्रोधात्मा ग्रसन्मूलफलान्मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2004614, "chapter_id": 1092, "verse_number": "१-९३-१२", "content_sanskrit": "पादैर्जलरवं कृत्वा अन्तर्द्वीपे कुटीं गतः।\nमेनका गन्तुकामा तु शुश्राव जलनिस्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2004615, "chapter_id": 1092, "verse_number": "१-९३-१३", "content_sanskrit": "तपसा दीप्तवीर्योऽसावाकाशादेति याति च।\nअद्य संज्ञां विजानामि ययाऽद्य तपसः क्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2004616, "chapter_id": 1092, "verse_number": "१-९३-१४", "content_sanskrit": "गन्तुं न युक्तमित्युक्त्वा ऋतुस्नाताथ मेनका।\nकामरागाभिभूतस्य मुनेः पार्स्वं जगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2004617, "chapter_id": 1092, "verse_number": "१-९३-१५", "content_sanskrit": "जनयामास स मुनिर्मेनकायां शकुन्तलाम्।\nप्रस्थे हिमवतो रम्ये मालिनीमभितो नदीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2004618, "chapter_id": 1092, "verse_number": "१-९३-१६", "content_sanskrit": "देवगर्भोपमां बालां सर्वाभरणभूषिताम्।\nशयानां शयने रम्ये मेनका वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2004619, "chapter_id": 1092, "verse_number": "१-९३-१७", "content_sanskrit": "महर्षेरुग्रतपसस्तेजस्त्वमसि भामिनि।\nतस्मात्स्वर्गं गमिष्यामि देवकार्यार्थमागता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2004620, "chapter_id": 1092, "verse_number": "१-९३-१८", "content_sanskrit": "जातमुत्सृज्य तं गर्भं मेनका मालिनीमनु।\nकृतकार्या ततस्तूर्णमगच्छच्छक्रसंसदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2004621, "chapter_id": 1092, "verse_number": "१-९३-१९", "content_sanskrit": "तं वने विजने गर्भं सिंहव्याघ्रसमाकुले।\nदृष्ट्वा शयानं शकुनाः समन्तात्पर्यवारयन्।\nनेमां हिंस्युर्वने बालां क्रव्यादा मांसगृद्धिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2004622, "chapter_id": 1092, "verse_number": "१-९३-२०", "content_sanskrit": "पर्यरक्षन्त तां तत्र शकुन्ता मेनकात्मजाम्।\nउपस्प्रष्टुं गतश्चाहमपश्यं शयितामिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2004623, "chapter_id": 1092, "verse_number": "१-९३-२१", "content_sanskrit": "निर्जने विपिने रम्ये शकुन्तैः परिवारिताम्।\nमां दृष्ट्वैवाभ्यपद्यन्त पादयोः पतिता द्विजाः।\nअब्रुञ्शकुनाः सर्वे कलं मधुरभाषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2004624, "chapter_id": 1092, "verse_number": "१-९३-२२", "content_sanskrit": "विश्वामित्रसुतां ब्रह्मन्न्यासभूतां भरस्व वै।\nकामक्रोधावजितवान्सखा ते कौशिकीं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2004625, "chapter_id": 1092, "verse_number": "१-९३-२३", "content_sanskrit": "तस्मात्पोषय तत्पुत्रीं दयावानिति तेऽब्रुवन्।\nसर्वभूतरुतज्ञोऽहं दयावान्सर्वजन्तुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2004626, "chapter_id": 1092, "verse_number": "१-९३-२४", "content_sanskrit": "आनयित्वा ततश्चैनां दुहितृत्वे न्यवेशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2004627, "chapter_id": 1092, "verse_number": "१-९३-२५", "content_sanskrit": "शरीरकृत्प्राणदाता यस्य चान्नानि भुञ्जते।\nक्रमेणैते त्रयोऽप्युक्ताः पितरो धर्मशासने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2004628, "chapter_id": 1092, "verse_number": "१-९३-२६", "content_sanskrit": "निर्जने तु वने यस्माच्छकुन्तैः परिवारिता।\nशकुन्तलेति नामास्याः कृतं चापि ततो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2004629, "chapter_id": 1092, "verse_number": "१-९३-२७", "content_sanskrit": "एवं दुहितरं विद्धि मम विप्र शकुन्तलाम्।\nशकुन्तला च पितरं मन्यते मामनिन्दिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2004630, "chapter_id": 1092, "verse_number": "१-९३-२८x", "content_sanskrit": "शकुन्तलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2004631, "chapter_id": 1092, "verse_number": "१-९३-२८", "content_sanskrit": "एतदाचष्ट पृष्टः सन्मम जन्म महर्षये।\nसुतां कण्वस्य मामेवं विद्धि त्वं मनुजाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2004632, "chapter_id": 1092, "verse_number": "१-९३-२९", "content_sanskrit": "कण्वं हि पितरं मन्ये पितरं स्वमजानती।\nइति ते कथितं राजन्यथावृत्तं श्रुतं मया॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2004633, "chapter_id": 1092, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि त्रिनवतितमोऽध्यायः॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]