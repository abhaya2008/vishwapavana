[{"id": 2178201, "chapter_id": 4767, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2178202, "chapter_id": 4767, "verse_number": "१", "content_sanskrit": "क्रोशमात्रं ततो गत्वा ददृशुस्तान् महारथान् ।\nशारद्वतं कृपं द्रौणिं कृतवर्माणमेव च\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2178203, "chapter_id": 4767, "verse_number": "२", "content_sanskrit": "ते तु दृष्ट्वैव राजानं प्रज्ञाचक्षुषमीश्वरम् ।\nअश्रुकण्ठा विनिःश्वस्य रुदन्त इदमब्रुवन्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2178204, "chapter_id": 4767, "verse_number": "", "content_sanskrit": "कृपादयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2178205, "chapter_id": 4767, "verse_number": "३", "content_sanskrit": "पुत्रस्तव महाराज कृत्वा कर्म सुदुष्करम् ।\nगतः सानुचरो राजा शक्रलोकं महारथः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2178206, "chapter_id": 4767, "verse_number": "४", "content_sanskrit": "दुर्योधनबलान्मुक्ता वयमेव त्रयो रथाः ।\nसर्वमन्यत् परिक्षीणं सैन्यं ते भरतर्षभ\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2178207, "chapter_id": 4767, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2178208, "chapter_id": 4767, "verse_number": "५", "content_sanskrit": "इत्येवमुक्त्वा राजानं कृपः शारद्वतस्तदा ।\nगान्धारीं पुत्रशोकार्तामिदं वचनमब्रवीत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2178209, "chapter_id": 4767, "verse_number": "", "content_sanskrit": "कृपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2178210, "chapter_id": 4767, "verse_number": "६", "content_sanskrit": "अभीता युद्ध्यमानास्ते घ्नन्तः शत्रुगणान् बहून् ।\nवीरकर्माणि कुर्वाणाः पुत्रास्ते निधनं गताः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2178211, "chapter_id": 4767, "verse_number": "७", "content_sanskrit": "ध्रुवं सम्प्राप्य लोकांस्ते निर्मलान् शस्त्रनिर्जितान् ।\nभास्वरं देहमास्थाय विहरन्त्यमरा इव\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2178212, "chapter_id": 4767, "verse_number": "८", "content_sanskrit": "सर्वे ह्यभिमुखा राज्ञि युध्यमाना हता युधि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2178213, "chapter_id": 4767, "verse_number": "९", "content_sanskrit": "न हि कश्चिद्धि शूराणां युध्यमानः पराङ्मुखः ।\nशस्त्रेण निधनं प्राप्तो न हि कश्चित् कृताञ्जलिः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2178214, "chapter_id": 4767, "verse_number": "१०", "content_sanskrit": "एतां तां क्षत्रियस्याहुः पुराणाः परमां गतिम् ।\nशस्त्रेण निधनं सङ्खे तान् न शोचितुमर्हसि\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2178215, "chapter_id": 4767, "verse_number": "११", "content_sanskrit": "न चापि शत्रवस्तेषामृद्ध्यन्ते राज्ञि पाण्डवाः ।\nशृणु यत् कृतमस्माभिरश्वत्थामपुरोगमैः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2178216, "chapter_id": 4767, "verse_number": "१२", "content_sanskrit": "अधर्मेण हतं श्रुत्वा भीमसेनेन ते सुतम् ।\nसुप्तं शिबिरमाविश्य पाण्डूनां कदनं महत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2178217, "chapter_id": 4767, "verse_number": "१३", "content_sanskrit": "पाञ्चाला निहताः सर्वे धृष्टद्युम्नपुरोगमाः ।\nद्रुपदस्यात्मजाश्चैव द्रौपदेयाश्च पातिताः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2178218, "chapter_id": 4767, "verse_number": "१४", "content_sanskrit": "तथा विशसनं कृत्वा पुत्रशत्रुगणस्य ते ।\nप्राद्रवाम न हि स्थातुं रणे शक्ष्यामहे त्रयः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2178219, "chapter_id": 4767, "verse_number": "१५", "content_sanskrit": "ते हि शूरा महेष्वासाः क्षिप्रमेष्यन्ति पाण्डवाः ।\nअमर्षवशमापन्ना वैरं प्रतिचिकीर्षवः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2178220, "chapter_id": 4767, "verse_number": "१६", "content_sanskrit": "ते हतानात्मजान् श्रुत्वा प्रमत्ताः पुरुषर्षभाः ।\nअन्विष्यन्तः पदं शूराः क्षिप्रमेष्यन्ति पाण्डवाः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2178221, "chapter_id": 4767, "verse_number": "१७", "content_sanskrit": "पाण्डूनां किल्बिषं कृत्वा संस्थातुं नोत्सहामहे ।\nअनुजानीहि मां राज्ञि मा च शोके मनः कृथाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2178222, "chapter_id": 4767, "verse_number": "१८", "content_sanskrit": "राजंस्त्वमनुजानीहि धैर्यमातिष्ठ चोत्तमम् ।\nदिष्टान्तं पश्य चापि त्वं क्षत्रधर्मं च केवलम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2178223, "chapter_id": 4767, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2178224, "chapter_id": 4767, "verse_number": "१९", "content_sanskrit": "इत्येवमुक्त्वा राजानं कृत्वा चापि प्रदक्षिणम् ।\nकृपश्च कृतवर्मा च द्रोणपुत्रश्च भारत\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2178225, "chapter_id": 4767, "verse_number": "२०", "content_sanskrit": "अन्वीक्षमाणं राजानं धृतराष्ट्रं मनीषिणम् ।\nगङ्गामनु महात्मानः तूर्णमश्वानचोदयन्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2178226, "chapter_id": 4767, "verse_number": "२१", "content_sanskrit": "अपक्रम्य च ते सर्वे त्रयो राजन् महारथाः ।\nआमन्त्र्यान्योन्यमुद्विग्नाः त्रिधा ते प्रययुस्ततः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2178227, "chapter_id": 4767, "verse_number": "२२", "content_sanskrit": "जगाम हस्तिनपुरं कृपः शारद्वतस्ततः ।\nस्वमेव राष्ट्रं हार्दिक्यो द्रौणिर्व्यासाश्रमं ययौ\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2178228, "chapter_id": 4767, "verse_number": "२३", "content_sanskrit": "एवं ते प्रययुर्वीराः वीक्षमाणाः परस्परम् ।\nभयार्ताः पाण्डुपुत्राणामागस्कृत्वा महात्मनाम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2178229, "chapter_id": 4767, "verse_number": "२४", "content_sanskrit": "समेत्य वीरं राजानं तदा त्वनुदिते रवौ ।\nविप्रजग्मुर्महाराज यथेष्टकमरिन्दमाः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2178230, "chapter_id": 4767, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nएकादशोऽध्यायः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2178231, "chapter_id": 4767, "verse_number": "", "content_sanskrit": "जलप्रदानपर्वणि एकादशोऽध्यायः ॥११॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]