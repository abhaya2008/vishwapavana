[{"id": 5000434000, "chapter_id": 9434, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे सप्तविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000434001, "chapter_id": 9434, "verse_number": "६-२७-१", "content_sanskrit": "तांस्तु ते सम्प्रवक्ष्यामि प्रेक्षमाणस्य यूथपान्।\nराघवार्थे पराक्रान्ता ये न रक्षन्ति जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000434002, "chapter_id": 9434, "verse_number": "६-२७-२", "content_sanskrit": "स्निग्धा यस्य बहुव्यामा दीर्घलाङ्गूलमाश्रिताः।\nताम्राः पीताः सिताः श्वेताः प्रकीर्णा घोरकर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000434003, "chapter_id": 9434, "verse_number": "६-२७-३", "content_sanskrit": "प्रगृहीताः प्रकाशन्ते सूर्यस्येव मरीचयः।\nपृथिव्यां चानुकृष्यन्ते हरो नामैष वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000434004, "chapter_id": 9434, "verse_number": "६-२७-४", "content_sanskrit": "यं पृष्ठतोऽनुगच्छन्ति शतशोऽथ सहस्रशः।\nवृक्षानुद्यम्य सहसा लङ्कारोहणतत्पराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000434005, "chapter_id": 9434, "verse_number": "६-२७-५", "content_sanskrit": "यूथपा हरिराजस्य किंकराः समुपस्थिताः।\nनीलानिव महामेघांस्तिष्ठतो यांस्तु पश्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000434006, "chapter_id": 9434, "verse_number": "६-२७-६", "content_sanskrit": "असिताञ्जनसंकाशान् युद्धे सत्यपराक्रमान्।\nअसंख्येयाननिर्देशान् परं पारमिवोदधेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000434007, "chapter_id": 9434, "verse_number": "६-२७-७", "content_sanskrit": "पर्वतेषु च ये केचिद् विषयेषु नदीषु च।\nएते त्वामभिवर्तन्ते राजन्नृक्षाः सुदारुणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000434008, "chapter_id": 9434, "verse_number": "६-२७-८", "content_sanskrit": "एषां मध्ये स्थितो राजन् भीमाक्षो भीमदर्शनः।\nपर्जन्य इव जीमूतैः समन्तात् परिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000434009, "chapter_id": 9434, "verse_number": "६-२७-९", "content_sanskrit": "ऋक्षवन्तं गिरिश्रेष्ठमध्यास्ते नर्मदां पिबन्।\nसर्वर्क्षाणामधिपतिर्धूम्रो नामैष यूथपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000434010, "chapter_id": 9434, "verse_number": "६-२७-१०", "content_sanskrit": "यवीयानस्य तु भ्राता पश्यैनं पर्वतोपमम्।\nभ्रात्रा समानो रूपेण विशिष्टस्तु पराक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000434011, "chapter_id": 9434, "verse_number": "६-२७-११", "content_sanskrit": "स एष जाम्बवान् नाम महायूथपयूथपः।\nप्रशान्तो गुरुवर्ती च सम्प्रहारेष्वमर्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000434012, "chapter_id": 9434, "verse_number": "६-२७-१२", "content_sanskrit": "एतेन साह्यं तु महत् कृतं शक्रस्य धीमता।\nदैवासुरे जाम्बवता लब्धाश्च बहवो वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000434013, "chapter_id": 9434, "verse_number": "६-२७-१३", "content_sanskrit": "आरुह्य पर्वताग्रेभ्यो महाभ्रविपुलाः शिलाः।\nमुञ्चन्ति विपुलाकारा न मृत्योरुद्विजन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000434014, "chapter_id": 9434, "verse_number": "६-२७-१४", "content_sanskrit": "राक्षसानां च सदृशाः पिशाचानां च रोमशाः।\nएतस्य सैन्या बहवो विचरन्त्यमितौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000434015, "chapter_id": 9434, "verse_number": "६-२७-१५", "content_sanskrit": "य एनमभिसंरब्धं प्लवमानमवस्थितम्।\nप्रेक्षन्ते वानराः सर्वे स्थिता यूथपयूथपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000434016, "chapter_id": 9434, "verse_number": "६-२७-१६", "content_sanskrit": "एष राजन् सहस्राक्षं पर्युपास्ते हरीश्वरः।\nबलेन बलसंयुक्तो दम्भो नामैष यूथपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000434017, "chapter_id": 9434, "verse_number": "६-२७-१७", "content_sanskrit": "यः स्थितं योजने शैलं गच्छन् पार्श्वेन सेवते।\nऊर्ध्वं तथैव कायेन गतः प्राप्नोति योजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000434018, "chapter_id": 9434, "verse_number": "६-२७-१८", "content_sanskrit": "यस्मात् तु परमं रूपं चतुष्पात्सु न विद्यते।\nश्रुतः संनादनो नाम वानराणां पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000434019, "chapter_id": 9434, "verse_number": "६-२७-१९", "content_sanskrit": "येन युद्धं तदा दत्तं रणे शक्रस्य धीमता।\nपराजयश्च न प्राप्तः सोऽयं यूथपयूथपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000434020, "chapter_id": 9434, "verse_number": "६-२७-२०", "content_sanskrit": "यस्य विक्रममाणस्य शक्रस्येव पराक्रमः।\nएष गन्धर्वकन्यायामुत्पन्नः कृष्णवर्त्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000434021, "chapter_id": 9434, "verse_number": "६-२७-२१", "content_sanskrit": "तदा देवासुरे युद्धे साह्यार्थं त्रिदिवौकसाम्।\nयत्र वैश्रवणो राजा जम्बूमुपनिषेवते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000434022, "chapter_id": 9434, "verse_number": "६-२७-२२", "content_sanskrit": "यो राजा पर्वतेन्द्राणां बहुकिंनरसेविनाम्।\nविहारसुखदो नित्यं भ्रातुस्ते राक्षसाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000434023, "chapter_id": 9434, "verse_number": "६-२७-२३", "content_sanskrit": "तत्रैष रमते श्रीमान् बलवान् वानरोत्तमः।\nयुद्धेष्वकत्थनो नित्यं क्रथनो नाम यूथपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000434024, "chapter_id": 9434, "verse_number": "६-२७-२४", "content_sanskrit": "वृतः कोटिसहस्रेण हरीणां समवस्थितः।\nएषैवाशंसते लङ्कां स्वेनानीकेन मर्दितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000434025, "chapter_id": 9434, "verse_number": "६-२७-२५", "content_sanskrit": "यो गङ्गामनुपर्येति त्रासयन् गजयूथपान्।\nहस्तिनां वानराणां च पूर्ववैरमनुस्मरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000434026, "chapter_id": 9434, "verse_number": "६-२७-२६", "content_sanskrit": "एष यूथपतिर्नेता गर्जन् गिरिगुहाशयः।\nगजान् रोधयते वन्यानारुजंश्च महीरुहान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000434027, "chapter_id": 9434, "verse_number": "६-२७-२७", "content_sanskrit": "हरीणां वाहिनीमुख्यो नदीं हैमवतीमनु।\nउशीरबीजमाश्रित्य मन्दरं पर्वतोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000434028, "chapter_id": 9434, "verse_number": "६-२७-२८", "content_sanskrit": "रमते वानरश्रेष्ठो दिवि शक्र इव स्वयम्।\nएनं शतसहस्राणां सहस्रमभिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000434029, "chapter_id": 9434, "verse_number": "६-२७-२९", "content_sanskrit": "वीर्यविक्रमदृप्तानां नर्दतां बाहुशालिनाम्।\nस एष नेता चैतेषां वानराणां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000434030, "chapter_id": 9434, "verse_number": "६-२७-३०", "content_sanskrit": "स एष दुर्धरो राजन् प्रमाथी नाम यूथपः।\nवातेनेवोद्धतं मेघं यमेनमनुपश्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000434031, "chapter_id": 9434, "verse_number": "६-२७-३१", "content_sanskrit": "अनीकमपि संरब्धं वानराणां तरस्विनाम्।\nउद्‍धूतमरुणाभासं पवनेन समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000434032, "chapter_id": 9434, "verse_number": "६-२७-३२", "content_sanskrit": "विवर्तमानं बहुशो यत्रैतद‍्बहुलं रजः।\nएतेऽसितमुखा घोरा गोलाङ्गूला महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000434033, "chapter_id": 9434, "verse_number": "६-२७-३३", "content_sanskrit": "शतं शतसहस्राणि दृष्ट्वा वै सेतुबन्धनम्।\nगोलाङ्गूलं महाराज गवाक्षं नाम यूथपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000434034, "chapter_id": 9434, "verse_number": "६-२७-३४", "content_sanskrit": "परिवार्याभिनर्दन्ते लङ्कां मर्दितुमोजसा।\nभ्रमराचरिता यत्र सर्वकालफलद्रुमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000434035, "chapter_id": 9434, "verse_number": "६-२७-३५", "content_sanskrit": "यं सूर्यस्तुल्यवर्णाभमनुपर्येति पर्वतम्।\nयस्य भासा सदा भान्ति तद्वर्णा मृगपक्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000434036, "chapter_id": 9434, "verse_number": "६-२७-३६", "content_sanskrit": "यस्य प्रस्थं महात्मानो न त्यजन्ति महर्षयः।\nसर्वकामफला वृक्षाः सदा फलसमन्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000434037, "chapter_id": 9434, "verse_number": "६-२७-३७", "content_sanskrit": "मधूनि च महार्हाणि यस्मिन् पर्वतसत्तमे।\nतत्रैष रमते राजन् रम्ये काञ्चनपर्वते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000434038, "chapter_id": 9434, "verse_number": "६-२७-३८", "content_sanskrit": "मुख्यो वानरमुख्यानां केसरी नाम यूथपः।\nषष्टिर्गिरिसहस्राणि रम्याः काञ्चनपर्वताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000434039, "chapter_id": 9434, "verse_number": "६-२७-३९", "content_sanskrit": "तेषां मध्ये गिरिवरस्त्वमिवानघ रक्षसाम्।\nतत्रैके कपिलाः श्वेतास्ताम्रास्या मधुपिङ्गलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000434040, "chapter_id": 9434, "verse_number": "६-२७-४०", "content_sanskrit": "निवसन्त्यन्तिमगिरौ तीक्ष्णदंष्ट्रा नखायुधाः।\nसिंहा इव चतुर्दंष्ट्रा व्याघ्रा इव दुरासदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000434041, "chapter_id": 9434, "verse_number": "६-२७-४१", "content_sanskrit": "सर्वे वैश्वानरसमा ज्वलदाशीविषोपमाः।\nसुदीर्घाञ्चितलाङ्गूला मत्तमातङ्गसंनिभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000434042, "chapter_id": 9434, "verse_number": "६-२७-४२", "content_sanskrit": "महापर्वतसंकाशा महाजीमूतनिःस्वनाः।\nवृत्तपिङ्गलनेत्रा हि महाभीमगतिस्वनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000434043, "chapter_id": 9434, "verse_number": "६-२७-४३", "content_sanskrit": "मर्दयन्तीव ते सर्वे तस्थुर्लङ्कां समीक्ष्य ते।\nएष चैषामधिपतिर्मध्ये तिष्ठति वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000434044, "chapter_id": 9434, "verse_number": "६-२७-४४", "content_sanskrit": "जयार्थी नित्यमादित्यमुपतिष्ठति वीर्यवान्।\nनाम्ना पृथिव्यां विख्यातो राजन् शतबलीति यः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000434045, "chapter_id": 9434, "verse_number": "६-२७-४५", "content_sanskrit": "एषैवाशंसते लङ्कां स्वेनानीकेन मर्दितुम्।\nविक्रान्तो बलवान् शूरः पौरुषे स्वे व्यवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000434046, "chapter_id": 9434, "verse_number": "६-२७-४६", "content_sanskrit": "रामप्रियार्थं प्राणानां दयां न कुरुते हरिः।\nगजो गवाक्षो गवयो नलो नीलश्च वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000434047, "chapter_id": 9434, "verse_number": "६-२७-४७", "content_sanskrit": "एकैकमेव योधानां कोटिभिर्दशभिर्वृतः।\nतथान्ये वानरश्रेष्ठा विन्ध्यपर्वतवासिनः।\nन शक्यन्ते बहुत्वात् तु संख्यातुं लघुविक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000434048, "chapter_id": 9434, "verse_number": "६-२७-४८", "content_sanskrit": "सर्वे महाराज महाप्रभावाः\nसर्वे महाशैलनिकाशकायाः।\nसर्वे समर्थाः पृथिवीं क्षणेन\nकर्तुं प्रविध्वस्तविकीर्णशैलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]