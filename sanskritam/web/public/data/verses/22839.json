[{"id": 7002839000, "chapter_id": 22839, "verse_number": "९-१२४-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nरुद्रस्नानविधानं मे कथयस्व जनार्दन ।\nसर्वदुष्टोपशमनं सर्वशांतिप्रदं नृणाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002839001, "chapter_id": 22839, "verse_number": "९-१२४-२", "content_sanskrit": "श्रीकृष्ण उवाच ।\nदेवसेनापतिं स्कन्दं रुद्रपुत्रं दुरासदम् ।\nअगस्त्यो मुनिशार्दूलः सुखासीनमुवाच ह ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002839002, "chapter_id": 22839, "verse_number": "९-१२४-३", "content_sanskrit": "सर्वज्ञोऽसि कुमार त्वं प्रसादाच्छङ्करस्य वै ।\nस्नानं रुद्रविधानेन ब्रूहि कस्य कथं भवेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002839003, "chapter_id": 22839, "verse_number": "९-१२४-४", "content_sanskrit": "रुद्र उवाच ।\nमृतप्रजा तु या नारी दुर्भगा सुतवर्जिता ।\nया सुते दुहितां वंध्या स्नानमासां विधीयते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002839004, "chapter_id": 22839, "verse_number": "९-१२४-५", "content_sanskrit": "अष्टम्यां वा चतुर्दश्यामुपवासपरायणा ।\nऋतौ शुद्धे चतुर्थेह्नि प्राप्ते सूर्यदिनेऽथ वा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002839005, "chapter_id": 22839, "verse_number": "९-१२४-६", "content_sanskrit": "नद्योस्तु सङ्गमे कुर्यान्महानद्योर्विशेषतः ।\nशिवालयेऽथ वा गोष्ठे विविक्ते वा गृहाङ्गणे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002839006, "chapter_id": 22839, "verse_number": "९-१२४-७", "content_sanskrit": "आहिताग्निं द्विजं शांतं धर्मज्ञं सत्यशीलिनम् ।\nस्नानार्थं प्रार्थयेद्देवं निपुणं रौद्रकर्मणि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002839007, "chapter_id": 22839, "verse_number": "९-१२४-८", "content_sanskrit": "ततस्तु मंडपं कुर्याच्चतुरस्रमुदग्गतम् ।\nबद्धचन्दनमालं तु गोमये नोपलेपितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002839008, "chapter_id": 22839, "verse_number": "९-१२४-९", "content_sanskrit": "तन्मध्ये श्वेतरजसा संपूर्णं पद्ममालिखेत् ।\nमध्ये तस्य महादेवं स्थापयेत्कर्णिकोपरि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002839009, "chapter_id": 22839, "verse_number": "९-१२४-१०", "content_sanskrit": "दद्याद्दलेषु शक्त्यादींश्चतुर्थविधिपूर्वकम् ।\nइन्द्रादिलोकपालांश्च दलेष्वन्येषु विन्यसेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002839010, "chapter_id": 22839, "verse_number": "९-१२४-११", "content_sanskrit": "देवीं विनायकं चैव स्थापयेत्तस्य पार्श्वतः ।\nदत्त्वार्घं गन्धपुष्पं च धूपदीपं गुडौदनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002839011, "chapter_id": 22839, "verse_number": "९-१२४-१२", "content_sanskrit": "भक्ष्यान्नानाविधान्दद्यात्फलानि विविधानि च ।\nचतुष्कोणेषु भृंगारमश्वत्थदलभूषितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002839012, "chapter_id": 22839, "verse_number": "९-१२४-१३", "content_sanskrit": "एकैकं विन्यसेद्ब्रह्मन्सर्वौषधिसमन्वितम् ।\nचतुर्दिशं मंडपस्य दद्याद्भूतबलिं ततः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002839013, "chapter_id": 22839, "verse_number": "९-१२४-१४", "content_sanskrit": "आग्नेय्यां दिशि कर्तव्यं मंडपस्य समीपतः ।\nअग्निकार्यं शुभे कुण्डे पुष्पपत्रैरलंकृते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002839014, "chapter_id": 22839, "verse_number": "९-१२४-१५", "content_sanskrit": "लवणं सर्षपैर्युक्तं घृतेन मधुना सह ।\nमानस्तोकेन जुहुयात्कृतहोमे नवग्रहे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002839015, "chapter_id": 22839, "verse_number": "९-१२४-१६", "content_sanskrit": "द्वितीयमग्निकार्यस्य कर्तारं ब्राह्मणं कुरु ।\nरुद्रजापकमाचार्यं सितचन्दनचर्चितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002839016, "chapter_id": 22839, "verse_number": "९-१२४-१७", "content_sanskrit": "सितवस्त्रपरीधानं सितमालाधरं शुभम् ।\nशोभितं कंकणैः कंठ्यैः कर्णवेष्टांगुलीयकैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002839017, "chapter_id": 22839, "verse_number": "९-१२४-१८", "content_sanskrit": "मंडल स्य समीपस्थो जपेद्रुद्रान्विमत्सरः ।\nयावदेकादश गताः पुनरेव जपेत्तु तान् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002839018, "chapter_id": 22839, "verse_number": "९-१२४-१९", "content_sanskrit": "देवमंडलवत्कार्यं द्वितीयं मंडलं शुभम् ।\nतस्य मध्ये तु सा नारी श्वेतपुष्पैरलंकृता ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002839019, "chapter_id": 22839, "verse_number": "९-१२४-२०", "content_sanskrit": "श्वेतवस्त्रैश्च संछन्ना श्वेतगंधानुलेपिता ।\nसुखासनोपविष्टायामाचार्यो रुद्रचिंतकः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002839020, "chapter_id": 22839, "verse_number": "९-१२४-२१", "content_sanskrit": "अभिषिंचेत्ततश्चैव नामर्कपत्रपुटांबुना ।\nचतुःषष्टिविधेनैव रुद्रेणैकादशेन तु ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002839021, "chapter_id": 22839, "verse_number": "९-१२४-२२", "content_sanskrit": "शतानि सप्तपर्णानां चतुर्भिरधिकानि तु ।\nअच्छिद्राणां मनूनां च स्नानार्थं विनियोजयेत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002839022, "chapter_id": 22839, "verse_number": "९-१२४-२३", "content_sanskrit": "अश्वस्थानाद्गजस्थानाद्वल्मीकात्संगमाध्रदात् ।\nवेश्यागणाद्राजगृहाद्गोष्ठादानीय वै मृदः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002839023, "chapter_id": 22839, "verse_number": "९-१२४-२४", "content_sanskrit": "सर्वौषधिं रोचनां च नदीतीर्थोदकानि च ।\nएतान्संक्षिप्य कलशे शिवसंज्ञे सुपूजिते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002839024, "chapter_id": 22839, "verse_number": "९-१२४-२५", "content_sanskrit": "आपादतलकेशं च कुक्षी चैव विशेषतः ।\nसर्वांगं लेपयेन्नार्याः सुशीला काचिदङ्गना ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002839025, "chapter_id": 22839, "verse_number": "९-१२४-२६", "content_sanskrit": "रुद्राभिजप्तेन ततः स्नापयेत्कलशेन ताम् ।\nतोयपूर्णाष्टकलशैरश्वत्थदलपूरितैः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002839026, "chapter_id": 22839, "verse_number": "९-१२४-२७", "content_sanskrit": "सर्वतोदिक्स्थितैः पश्चात्स्नापयेत्सफलाक्षतैः ।\nएवं स्नाता स्नापकाय दद्याद्गां कांचनं तथा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002839027, "chapter_id": 22839, "verse_number": "९-१२४-२८", "content_sanskrit": "हेतुरप्यत्र निर्दिष्टा दक्षिणा गौः पयस्विनी ।\nब्राह्मणानामथान्येषां स्वशक्त्या पांडुनंदन ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002839028, "chapter_id": 22839, "verse_number": "९-१२४-२९", "content_sanskrit": "गोवत्सकाञ्चनादीनि दत्त्वा सर्वं क्षमापयेत् ।\nकृतेनानेन राजेन्द्र रुद्रस्नानेन भामिनी ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002839029, "chapter_id": 22839, "verse_number": "९-१२४-३०", "content_sanskrit": "सुभगा सुखसंयुक्ता बहुपुत्रा च जायते ।\nसर्वेष्वपि हि मासेषु ब्राह्मणाभिमते शुभम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002839030, "chapter_id": 22839, "verse_number": "९-१२४-३१", "content_sanskrit": "तस्मादवश्यं कर्तव्यं पुत्रश्रीसुखमिच्छता ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002839031, "chapter_id": 22839, "verse_number": "९-१२४-३२", "content_sanskrit": "या स्नानमाचरति रुद्रमिति प्रसिद्धं श्रद्धान्विता द्विजवरानुमताऽनताङ्गी ।\nदोषान्निहत्य सकलान्स्वशरीरभागाद्भर्तुः प्रिया भवति भारत जीववत्सा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]