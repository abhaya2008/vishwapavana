[{"id": 2081060, "chapter_id": 2723, "verse_number": "१२-२२८-०x", "content_sanskrit": "` युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2081061, "chapter_id": 2723, "verse_number": "१२-२२८-१", "content_sanskrit": "यदिदं तप इत्याहुः किं तपः संप्रकीर्तितम्।\nउपवासमथान्यत्तु वेदाचारमथो नु किम्।\nशास्त्रं तपो महाप्राज्ञ तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2081062, "chapter_id": 2723, "verse_number": "१२-२२८-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2081063, "chapter_id": 2723, "verse_number": "१२-२२८-२", "content_sanskrit": "पक्षमासोपवासादीन्मन्यन्ते वै तपोधनाः।\nवेदव्रतादीनि तप अपरे वेदपारगाः।\nवेदपारायणं चान्ये चाहुस्तत्वमथापरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2081064, "chapter_id": 2723, "verse_number": "१२-२२८-३", "content_sanskrit": "यथाविहितमाचारस्तपः सर्वं व्रतं गताः।\nआत्मविद्याविधानं यत्तत्तपः परिकीर्तितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2081065, "chapter_id": 2723, "verse_number": "१२-२२८-४", "content_sanskrit": "त्यागस्तपस्तथा शान्तिस्तप इन्द्रियनिग्रहः।\nब्रह्मचर्यं तपः प्रोक्तमाहुरेवं द्विजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2081066, "chapter_id": 2723, "verse_number": "१२-२२८-५", "content_sanskrit": "सदोपवासो यो विद्वान्ब्रह्मचारी सदा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2081067, "chapter_id": 2723, "verse_number": "१२-२२८-६", "content_sanskrit": "यो मुनिश्च सदा धीमान्विघसाशी विमत्सरः।\nततस्त्वनन्तमप्याहुर्यो नित्यमतिथिप्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2081068, "chapter_id": 2723, "verse_number": "१२-२२८-७", "content_sanskrit": "नान्तराशीस्ततो नित्यमुपवासी महाव्रतः।\nऋतुगामी तथा प्रोक्तो विघसाशी स्मृतो बुधैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2081069, "chapter_id": 2723, "verse_number": "१२-२२८-८", "content_sanskrit": "भृत्यशेषं तु यो भुङ्क्ते यज्ञशेषं तथाऽमृतम्।\nएवं नानार्थसंयोगं तपः शश्वदुदाहृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2081070, "chapter_id": 2723, "verse_number": "१२-२२८-९", "content_sanskrit": "केषां लोका ह्यपर्यन्ताः सर्वे सत्यव्रते स्थिताः।\nयेऽपि कर्ममयं प्राहुस्ते द्विजा ब्राह्मणाः स्मृताः।\nरमन्ते दिव्यभोगैश्च पूजिता ह्यप्सरोगणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2081071, "chapter_id": 2723, "verse_number": "१२-२२८-१०", "content_sanskrit": "ज्ञानात्मकं तपश्शब्दं ये वदन्ति विनिश्चिताः।\nते ह्यन्तराऽऽत्मसद्भावं प्रपन्ना नृपसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2081072, "chapter_id": 2723, "verse_number": "१२-२२८-११", "content_sanskrit": "एतत्ते नृपशार्दूल प्रोक्तं यत्पृष्ट्वानसि।\nयथा वस्तुनि संज्ञानि विविधानि भवन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2081073, "chapter_id": 2723, "verse_number": "१२-२२८-१२x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2081074, "chapter_id": 2723, "verse_number": "१२-२२८-१२", "content_sanskrit": "पितामह महाप्राज्ञ राजाधीना नृपाः पुनः।\nअन्यानि च सहस्राणि नामानि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2081075, "chapter_id": 2723, "verse_number": "१२-२२८-१३", "content_sanskrit": "प्रतियोगीनि वै तेषां छन्नान्यस्तमितानि च।\nदृढं सर्वं प्राकृतकभिदं सर्वत्र पश्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2081076, "chapter_id": 2723, "verse_number": "१२-२२८-१४", "content_sanskrit": "तस्माद्यथागतं राजन्यथारुचि नृणां भवेत्।\nअस्मिन्नर्थे पुरावृत्तं शृणु राजन्युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2081077, "chapter_id": 2723, "verse_number": "१२-२२८-१५", "content_sanskrit": "ब्राह्मणानां समूहे तु यदुवाच सुवर्चला।\nदेवलस्य सुता विद्वन्सर्वलक्षणशोभिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2081078, "chapter_id": 2723, "verse_number": "१२-२२८-१६", "content_sanskrit": "कन्या सुवर्चला नाम योगभावितचेतना।\nहेतुना केन जाता सा निर्द्वन्द्वा नष्टसंशया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2081079, "chapter_id": 2723, "verse_number": "१२-२२८-१७", "content_sanskrit": "साऽब्रवीत्पितरं विप्रं वरान्वेषणतत्परा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2081080, "chapter_id": 2723, "verse_number": "१२-२२८-१८", "content_sanskrit": "अन्धाय मां महाप्राज्ञ देहि वीक्ष्य सुलोचनम्।\nएवं स्म च पितः शश्वन्मयेदं---मुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2081081, "chapter_id": 2723, "verse_number": "१२-२२८-१९x", "content_sanskrit": "पितोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2081082, "chapter_id": 2723, "verse_number": "१२-२२८-१९", "content_sanskrit": "न शक्यं प्रार्थितुं वत्से त्वयाऽद्य प्रतिभाति मे।\nअन्धताऽनन्धता चेति विचारो मम जायते।\nउन्मत्तेव सुते वाक्यं भाषसे पृथुलोचने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2081083, "chapter_id": 2723, "verse_number": "१२-२२८-२०x", "content_sanskrit": "कन्योवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2081084, "chapter_id": 2723, "verse_number": "१२-२२८-२०", "content_sanskrit": "नाहमुन्मत्तभूताऽऽद्य बुद्धिपूर्वं ब्रवीमि ते।\nविद्धि वैतादृशं लोके स मां भजति वेदवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2081085, "chapter_id": 2723, "verse_number": "१२-२२८-२१", "content_sanskrit": "यान्यांस्त्वं मन्यसे दातुं मां द्विजोत्तम तानिह।\nआनयान्यान्महाभाग ह्यहं द्रक्ष्यामि तेषु तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2081086, "chapter_id": 2723, "verse_number": "१२-२२८-२२", "content_sanskrit": "तथेति चोक्त्वा तां विप्रः प्रेषयामास शिष्यकान्।\nऋषेः प्रभावं दृष्ट्वा ते कन्यायाश्च द्विजोत्तमाः।\nअनेकमुनयो राजन्संप्राप्ता देवलाश्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2081087, "chapter_id": 2723, "verse_number": "१२-२२८-२३", "content_sanskrit": "तानागतानथाभ्यर्च्यं कन्यामाह पिता महान्।\nयदीच्छसि वरं भद्रे तं विप्रं वरय स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2081088, "chapter_id": 2723, "verse_number": "१२-२२८-२४", "content_sanskrit": "तथेचि चोक्त्वा कल्याणी तप्तहेमनिभानना।\nकरसंमितमध्याङ्गी वाक्यमाह तपोधनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2081089, "chapter_id": 2723, "verse_number": "१२-२२८-२५", "content_sanskrit": "यद्यस्ति संमतो विप्रो ह्यन्धोऽनन्धः स मे वरः।\nनोचुर्विप्रा महाभागां प्रतिवाक्यं ययुश्च ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2081090, "chapter_id": 2723, "verse_number": "१२-२२८-२६", "content_sanskrit": "कन्या च तिष्ठतामत्र पितुर्वेश्मनि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2081091, "chapter_id": 2723, "verse_number": "१२-२२८-२७", "content_sanskrit": "श्वेतकेतुः कहालस्य श्यालः परमधर्मवित्।\nश्रुत्वा ब्रह्मा तदागम्य कन्यामाह महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2081092, "chapter_id": 2723, "verse_number": "१२-२२८-२८", "content_sanskrit": "सोहं भद्रे समावृत्तस्त्वयोक्तो यः पुरा द्विजः।\nविशालनयनं विद्धि मामन्धोऽहं वृणीष्व माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2081093, "chapter_id": 2723, "verse_number": "१२-२२८-२९x", "content_sanskrit": "सुवर्चलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2081094, "chapter_id": 2723, "verse_number": "१२-२२८-२९", "content_sanskrit": "कथं विशालनेत्रोऽसि कथं वा त्वमलोचनः।\nब्रूहि पश्चादहं विद्वन्परीक्षे त्वां द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2081095, "chapter_id": 2723, "verse_number": "१२-२२८-३०x", "content_sanskrit": "द्विज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2081096, "chapter_id": 2723, "verse_number": "१२-२२८-३०", "content_sanskrit": "शब्दे स्पर्शे तथा रूपे रसे गन्धे सहेतुकम्।\nन मे प्रवर्तते चेतो न प्रत्यक्षं हि तेषु मे।\nअलोचनोऽहं तस्माद्धि न गतिर्विद्यते यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2081097, "chapter_id": 2723, "verse_number": "१२-२२८-३१", "content_sanskrit": "येन पश्यति सुश्रोणि भाषते स्पृशते पुनः।\nभुज्यते घ्रायते नित्यं शृणोति मनुते तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2081098, "chapter_id": 2723, "verse_number": "१२-२२८-३२", "content_sanskrit": "तच्चक्षुर्विद्यते मह्यं येन पश्यति वै स्फुटम्।\nसुलोचनोऽहं भद्रे वै पृच्छ वा किं वदामि ते।\nसर्वमस्मिन्न मे विद्या विद्वान्हि परमार्थतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2081099, "chapter_id": 2723, "verse_number": "१२-२२८-३३", "content_sanskrit": "सा विशुद्धा ततो भूत्वा श्वेतकेतुं महामुनिम्।\nप्रणम्य पूजयामास तां भार्यां स च लब्धवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2081100, "chapter_id": 2723, "verse_number": "१२-२२८-३४", "content_sanskrit": "वैराग्यसंयुता कन्या तादृशं परिमुत्तमम्।\nप्राप्ता राजन्महाप्राज्ञ तस्मादर्थः पृथक्पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2081101, "chapter_id": 2723, "verse_number": "१२-२२८-३५", "content_sanskrit": "एतत्ते कथितं राजन्किं भूयः श्रोतुमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2081102, "chapter_id": 2723, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि अष्टाविंशत्यधिकद्विशततमोऽध्यायः॥ २२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]