[{"id": 2096850, "chapter_id": 3077, "verse_number": "१३-२०७-१", "content_sanskrit": "उमोवाच।\nभगवन्सर्वभूतेश शूलपाणे वृषध्वज।\nआवासेषु विचित्रेषु रम्येषु च शुभेशु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096851, "chapter_id": 3077, "verse_number": "१३-२०७-२", "content_sanskrit": "सत्सु चान्येषु भूतेषु श्मशाने रमसे कथम्।\nकेशास्थिकलिले भीमे कपालशतसङ्कुले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096852, "chapter_id": 3077, "verse_number": "१३-२०७-३", "content_sanskrit": "सृगालगृध्रम्पूर्णे शवधूमसमाकुले।\nचिताग्निविषमे घोरे गहने च भयानके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096853, "chapter_id": 3077, "verse_number": "१३-२०७-४", "content_sanskrit": "एवं कलेवरक्षेत्रे दुर्दर्शे रमसे कथम्।\nएष मे संशयो देव तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096854, "chapter_id": 3077, "verse_number": "१३-२०७-५x", "content_sanskrit": "महादेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096855, "chapter_id": 3077, "verse_number": "१३-२०७-५", "content_sanskrit": "हन्त ते कथयिष्यामि शृणु देवि समाहिता।\nआवासार्थं पुरा देवि शुद्धान्वेषी शुचिस्मिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096856, "chapter_id": 3077, "verse_number": "१३-२०७-६", "content_sanskrit": "नाध्यगच्छं चिरं कालं देशं शुचितमं शुभे।\nएष मेऽभिनिवेशोऽभूत्तस्मिन्काले प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096857, "chapter_id": 3077, "verse_number": "१३-२०७-७", "content_sanskrit": "आकुलः सुमहाघोरः प्रादुरासीत्समन्ततः।\nसम्भूता भूतसृष्टिश्च घोरा लोकभयावहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096858, "chapter_id": 3077, "verse_number": "१३-२०७-८", "content_sanskrit": "नानावर्णा विरूपाश्च तीक्ष्णदंष्ट्राः प्रहारिणः।\nपिशाचरक्षोवदनाः प्राणिनां प्राणहारिणः।\nइतश्चरन्ति निघ्नन्तः प्राणिनो भृशमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096859, "chapter_id": 3077, "verse_number": "१३-२०७-९", "content_sanskrit": "एवं लोके प्राणिहीने क्षयं याते पितामहः।\nचिन्तयंस्तत्प्रतीकारं मां च शक्तं हि निग्रहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096860, "chapter_id": 3077, "verse_number": "१३-२०७-१०", "content_sanskrit": "एवं ज्ञात्वा ततो ब्रह्मा तस्मिन्कर्मण्योजयत्।\nतच्च प्राणिहितार्थं तु मयाऽप्यनुमतं प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096861, "chapter_id": 3077, "verse_number": "१३-२०७-११", "content_sanskrit": "तस्मात्संरक्षिता देवि भूतेभ्यः प्राणिनो भयात्।\nअस्माच्छ्मशानान्मेध्यं तु नास्ति किञ्चिदनिन्दिते।\nनिःसम्पातान्मनुष्याणां तस्माच्छुचितमं स्मृतं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096862, "chapter_id": 3077, "verse_number": "१३-२०७-१२", "content_sanskrit": "भूतसृष्टिं च तां चाहं श्मशाने संन्यवेशयम्।\nतत्रस्थः सर्वभूतानां विनिहन्मि प्रिये भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096863, "chapter_id": 3077, "verse_number": "१३-२०७-१३", "content_sanskrit": "न च भूतगणेनाहं विना वसितुमुत्सहे।\nतस्मान्मे सन्निवासाय श्मशाने रोचते मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096864, "chapter_id": 3077, "verse_number": "१३-२०७-१४", "content_sanskrit": "मेध्यकामैर्द्विजैनित्यं मेध्यमित्यभिधीयते।\nआचरद्भिर्व्रतं नित्यं मोक्षकामैश्च सेव्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096865, "chapter_id": 3077, "verse_number": "१३-२०७-१५", "content_sanskrit": "स्थानं मे तत्र विहितं वीरस्थानमिति प्रिये।\nकपालशतसम्पूर्णमभिरूपं भयानकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096866, "chapter_id": 3077, "verse_number": "१३-२०७-१६", "content_sanskrit": "मध्याह्ने सन्ध्ययोस्तत्र नक्षत्रे रुद्रदेवते।\nआयुष्कामैरशुद्धैर्वा न गन्तव्यमिति स्थितिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096867, "chapter_id": 3077, "verse_number": "१३-२०७-१७", "content_sanskrit": "मदन्येन न शक्यं हि निहन्तुं भूतजं भयम्।\nतत्रस्थोऽहं प्रजाः सर्वाः पालयामि दिनेदिने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096868, "chapter_id": 3077, "verse_number": "१३-२०७-१८", "content_sanskrit": "मन्नियोगाद्भूतसङ्घा न च घ्नन्तीह कञ्चन।\nतांस्तु लोकहितार्ताय श्मशाने रमयान्महम्।\nएतत्ते सर्वमाख्यातं किं भूयः श्रोतुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2096869, "chapter_id": 3077, "verse_number": "१३-२०७-१९x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2096870, "chapter_id": 3077, "verse_number": "१३-२०७-१९", "content_sanskrit": "भगवन्देवदेवेश त्रिनेत्र वृषभध्वज।\nपिङ्गलं विकृतं भाति रूपं ते तु भयानकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2096871, "chapter_id": 3077, "verse_number": "१३-२०७-२०", "content_sanskrit": "भस्मदिग्धं विरूपाक्षं तीक्ष्णदंष्ट्रं जटाकुलम्।\nव्याघ्रोदरत्वक्संवीतं कपिलश्मश्रुसंततम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2096872, "chapter_id": 3077, "verse_number": "१३-२०७-२१", "content_sanskrit": "रौद्रं भयानकं घोरं शूलपट्टससंयुतम्।\nकिमर्थं त्वीदृशं रूपं तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2096873, "chapter_id": 3077, "verse_number": "१३-२०७-२२x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2096874, "chapter_id": 3077, "verse_number": "१३-२०७-२२", "content_sanskrit": "तदहं कथयिष्यामि शृणु तत्त्वं समाहिता।\nद्विविधो लौकिको भावः शीतमुष्णमिति प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2096875, "chapter_id": 3077, "verse_number": "१३-२०७-२३", "content_sanskrit": "तयोर्हि ग्रसितं सर्वं सौम्याग्नेयमिदं जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2096876, "chapter_id": 3077, "verse_number": "१३-२०७-२४", "content_sanskrit": "सौम्यत्वं सततं विष्णौ मय्याग्नेयं प्रतिष्ठितम्।\nअनेन वपुषा नित्यं सर्वलोकान्बिभर्म्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2096877, "chapter_id": 3077, "verse_number": "१३-२०७-२५", "content_sanskrit": "रौद्राकृतिं विरूपाक्षं शूलपट्टससंयुतम्।\nआग्नेयमिति मे रूपं देवि लोकहिते रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2096878, "chapter_id": 3077, "verse_number": "१३-२०७-२६", "content_sanskrit": "यद्यहं विपरीतः स्यामेतत्त्यक्त्वा शुभानने।\nतदैव सर्वलोकानां विपरीतं प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2096879, "chapter_id": 3077, "verse_number": "१३-२०७-२७", "content_sanskrit": "तस्मान्मयेदं ध्रियते रूपं लोकहितैषिणा।\nइति ते कथितं देवि किं भूयः श्रोतुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2096880, "chapter_id": 3077, "verse_number": "१३-२०७-२८x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2096881, "chapter_id": 3077, "verse_number": "१३-२०७-२८", "content_sanskrit": "भगवन्देवदेवेश शूलपाणे वृषध्वज।\nकिमर्थं चन्द्ररेखा ते शिरोभागे विरोचते।\nश्रोतुमिच्छाम्यहं देव तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2096882, "chapter_id": 3077, "verse_number": "१३-२०७-२९x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2096883, "chapter_id": 3077, "verse_number": "१३-२०७-२९", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु कल्याणि कारणम्।\nपुराऽहं कारणाद्देवि कोपयुक्तः शुचिस्मिते।\nदक्षयज्ञवधार्याय भूतसङ्घैः समावृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2096884, "chapter_id": 3077, "verse_number": "१३-२०७-३०", "content_sanskrit": "तस्मिन्क्रतुवरे घोरे यज्ञभागनिमित्ततः।\nदेवा विभ्रंशितास्ते वै येषां भागः क्रतौ कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2096885, "chapter_id": 3077, "verse_number": "१३-२०७-३१", "content_sanskrit": "सोमस्तत्र मया देवि कुपितेन भृशार्दितः।\nपश्यंश्चानपराधी सन्पादङ्गुष्ठेन ताडितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2096886, "chapter_id": 3077, "verse_number": "१३-२०७-३२", "content_sanskrit": "तथापि विकृतेनाहं सामपूर्वं प्रसादितः।\nतन्मे चिन्तयतश्चासीत्पश्चात्तापः पुरा प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2096887, "chapter_id": 3077, "verse_number": "१३-२०७-३३", "content_sanskrit": "तदाप्रभृति सोमं वै शिरसा धारयाम्यम्।\nएवं मे पापहानिस्तु भवेदिति मतिर्मम।\nतदाप्रभृति वै सोमो मूर्ध्नि संदृश्यते सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2096888, "chapter_id": 3077, "verse_number": "१३-२०७-३४x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2096889, "chapter_id": 3077, "verse_number": "१३-२०७-३४", "content_sanskrit": "एवं ब्रुवति देवेशे विस्मिताः परमर्षयः।\nवाग्भिः साञ्जलिमालाभिरभितुष्टुवुरीश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2096890, "chapter_id": 3077, "verse_number": "१३-२०७-३५x", "content_sanskrit": "ऋषय ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2096891, "chapter_id": 3077, "verse_number": "१३-२०७-३५", "content_sanskrit": "नमः शङ्कर सर्वेश नमः सर्वजगद्भुरो।\nनमो देवादिदेवाय नमः शशिकलाधर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2096892, "chapter_id": 3077, "verse_number": "१३-२०७-३६", "content_sanskrit": "नमो घोरतराद्धोर नमो रुद्राय शङ्कर।\nनमः शान्ततराच्छान्त नमश्चन्द्रस्य पालक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2096893, "chapter_id": 3077, "verse_number": "१३-२०७-३७", "content_sanskrit": "नमः सोमाय देवाय नमस्तुभ्यं चतुर्मुख।\nनमो भूतपते शंभो जह्नुकन्याम्बुशेखर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2096894, "chapter_id": 3077, "verse_number": "१३-२०७-३८", "content_sanskrit": "नमस्त्रिशूलहस्ताय पन्नगाभरणाय च।\nनमोस्तु विषमाक्षाय दक्षयज्ञप्रदाहक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2096895, "chapter_id": 3077, "verse_number": "१३-२०७-३९", "content_sanskrit": "नमोस्तु बहुनेत्राय लोकरक्षणतत्पर।\nअहो देवस्य महात्म्यमहो देवस्य वै कृपा।\nएवं धर्मपरत्वं च देवदेवस्य चार्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2096896, "chapter_id": 3077, "verse_number": "१३-२०७-४०", "content_sanskrit": "एवं ब्रुवत्सु मुनिषु वचो देव्यब्रवीद्धरम्।\nसम्प्रीत्यर्थं मुनीनां सा क्षणज्ञा परमं हितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2096897, "chapter_id": 3077, "verse_number": "१३-२०७-४१x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2096898, "chapter_id": 3077, "verse_number": "१३-२०७-४१", "content_sanskrit": "भगवन्देवदेवेश सर्वलोकनमस्कृत।\nअस्यैव ऋषिसङ्घस्य मम च प्रियकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2096899, "chapter_id": 3077, "verse_number": "१३-२०७-४२", "content_sanskrit": "वर्णाश्रमकृतं धर्मं वक्तुमर्हस्यशेषतः।\nन तृप्तिरस्ति देवेश श्रवणीयं हि ते वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2096900, "chapter_id": 3077, "verse_number": "१३-२०७-४३", "content_sanskrit": "सधर्मचारिणी चेयं भक्ता चेयमिति प्रभो।\nवक्तुमर्हसि देवेश लोकानां हितकाम्यया।\nयाथातथ्येन तत्सर्वं वक्तुमर्हसि शंकर॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2096901, "chapter_id": 3077, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्ताधिकद्विशततमोऽध्यायः॥ २०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]