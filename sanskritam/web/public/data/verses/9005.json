[{"id": 40007327, "chapter_id": 9005, "verse_number": "1", "content_sanskrit": "खरं तु रामाभिमुखं प्रयान्तं वाहिनीपतिः। राक्षसस्त्रिशिरा नाम सन्निपत्येदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40007328, "chapter_id": 9005, "verse_number": "2", "content_sanskrit": "मां नियोजय विक्रान्त सन्निवर्तस्व साहसात्। पश्य रामं महाबाहुं संयुगे विनिपातितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40007329, "chapter_id": 9005, "verse_number": "3", "content_sanskrit": "प्रतिजानामि ते सत्यमायुधं चाहमालभे। यथा रामं वधिष्यामि वधार्हं सर्वरक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40007330, "chapter_id": 9005, "verse_number": "4", "content_sanskrit": "अहं वास्य रणे मृत्युरेष वा समरे मम। विनिवृत्य रणोत्साहान्मुहूर्तं प्राश्निको भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40007331, "chapter_id": 9005, "verse_number": "5", "content_sanskrit": "प्रहृष्टो वा हते रामे जनस्थानं प्रयास्यसि। मयि वा निहते रामं संयुगायोपयास्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40007332, "chapter_id": 9005, "verse_number": "6", "content_sanskrit": "खरस्त्रिशिरसा तेन मृत्युलोभात्प्रसादितः। गच्छ युध्येत्यनुज्ञातो राघवाभिमुखो ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40007333, "chapter_id": 9005, "verse_number": "7", "content_sanskrit": "त्रिशिराश्च रथेनैव वाजियुक्तेन भास्वता। अभ्यद्रवद्रणे रामं त्रिशृङ्ग इव पर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40007334, "chapter_id": 9005, "verse_number": "8", "content_sanskrit": "शरधारासमूहान्स महामेघ इवोत्सृजन्। व्यसृजत्सदृशं नादं जलार्द्रस्य तु दुन्दुभेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40007335, "chapter_id": 9005, "verse_number": "9", "content_sanskrit": "आगच्छन्तं त्रिशिरसं राक्षसं प्रेक्ष्य राघवः। धनुषा प्रतिजग्राह विधुन्वन्सायकान् शितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40007336, "chapter_id": 9005, "verse_number": "10", "content_sanskrit": "स सम्प्रहारस्तुमुलो रामत्रिशिरसोर्महान्। बभूवातीव बलिनोस्सिंहकुञ्जरयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40007337, "chapter_id": 9005, "verse_number": "11", "content_sanskrit": "ततस्त्रिशिरसा बाणैर्ललाटे ताडितस्त्रिभिः। अमर्षी कुपितोरामस्संरब्धमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40007338, "chapter_id": 9005, "verse_number": "12", "content_sanskrit": "अहो विक्रमशूरस्य राक्षसस्येदृशं बलम्। पुष्पैरिव शरैर्यस्य ललाटेऽस्मिन्परिक्षतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40007339, "chapter_id": 9005, "verse_number": "13", "content_sanskrit": "ममापि प्रतिगृह्णीष्व शरांश्चापगुणाच्च्युतान्। एवमुक्त्वा तु संरब्धश्शरानाशीविषोपमान् ॥ त्रिशिरोवक्षसि क्रुद्धो निजघान चतुर्दश।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40007340, "chapter_id": 9005, "verse_number": "14", "content_sanskrit": "चतुर्भिस्तुरगानस्य शरैः सन्नतपर्वभिः ॥ न्यपातयत तेजस्वी चतुरस्तस्य वाजिनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40007341, "chapter_id": 9005, "verse_number": "15", "content_sanskrit": "अष्टभिस्सायकैस्सूतं रथोपस्थान्न्यपातयत् ॥ रामश्चिच्छेद बाणेन ध्वजं चास्य समुच्छ्रितम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40007342, "chapter_id": 9005, "verse_number": "16", "content_sanskrit": "ततो हतरथात्तस्मादुत्पतन्तं निशाचरम् ॥ बिभेद रामस्तं बाणैर्हृदये सोऽभवज्जडः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40007343, "chapter_id": 9005, "verse_number": "17", "content_sanskrit": "सायकैश्चाप्रमेयात्मा सामर्षस्तस्य रक्षसः ॥ शिरांस्यपातयद्रामो वेगवद्भिस्त्रिभिश्शितैः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40007344, "chapter_id": 9005, "verse_number": "18", "content_sanskrit": "स भूमौ रुधिरोद्गारी रामबाणाभिपीडितः ॥ न्यपतत्पतितैः पूर्वं स्वशिरोभिर्निशाचरः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40007345, "chapter_id": 9005, "verse_number": "19", "content_sanskrit": "हतशेषास्ततो भग्ना राक्षसाः खरसंश्रया ॥ द्रवन्ति स्म न तिष्ठन्ति व्याघ्रत्रस्ता मृगा इव।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40007346, "chapter_id": 9005, "verse_number": "20", "content_sanskrit": "तान्खरो द्रवतो दृष्ट्वा निवर्त्य रुषितस्स्वयम् ॥ राममेवाभिदुद्राव राहुश्चन्द्रमसं यथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]