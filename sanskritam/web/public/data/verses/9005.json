[{"id": 5000005000, "chapter_id": 9005, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे पञ्चमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000005001, "chapter_id": 9005, "verse_number": "१-५-१", "content_sanskrit": "सर्वा पूर्वमियं येषामासीत् कृत्स्ना वसुंधरा ।\nप्रजापतिमुपादाय नृपाणां जयशालिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000005002, "chapter_id": 9005, "verse_number": "१-५-२", "content_sanskrit": "येषां स सगरो नाम सागरो येन खानितः ।\nषष्टिपुत्रसहस्राणि यं यान्तं पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000005003, "chapter_id": 9005, "verse_number": "१-५-३", "content_sanskrit": "इक्ष्वाकूणामिदं तेषां राज्ञां वंशे महात्मनाम् ।\nमहदुत्पन्नमाख्यानं रामायणमिति श्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000005004, "chapter_id": 9005, "verse_number": "१-५-४", "content_sanskrit": "तदिदं वर्तयिष्यावः सर्वं निखिलमादितः ।\nधर्मकामार्थसहितं श्रोतव्यमनसूयता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000005005, "chapter_id": 9005, "verse_number": "१-५-५", "content_sanskrit": "कोसलो नाम मुदितः स्फीतो जनपदो महान् ।\nनिविष्टः सरयूतीरे प्रभूतधनधान्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000005006, "chapter_id": 9005, "verse_number": "१-५-६", "content_sanskrit": "अयोध्या नाम नगरी तत्रासील्लोकविश्रुता ।\nमनुना मानवेन्द्रेण या पुरी निर्मिता स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000005007, "chapter_id": 9005, "verse_number": "१-५-७", "content_sanskrit": "आयता दश च द्वे च योजनानि महापुरी ।\nश्रीमती त्रीणि विस्तीर्णा सुविभक्तमहापथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000005008, "chapter_id": 9005, "verse_number": "१-५-८", "content_sanskrit": "राजमार्गेण महता सुविभक्तेन शोभिता ।\nमुक्तपुष्पावकीर्णेन जलसिक्तेन नित्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000005009, "chapter_id": 9005, "verse_number": "१-५-९", "content_sanskrit": "तां तु राजा दशरथो महाराष्ट्रविवर्धनः ।\nपुरीमावासयामास दिवि देवपतिर्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000005010, "chapter_id": 9005, "verse_number": "१-५-१०", "content_sanskrit": "कपाटतोरणवतीं सुविभक्तान्तरापणाम् ।\nसर्वयन्त्रायुधवतीमुषितां सर्वशिल्पिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000005011, "chapter_id": 9005, "verse_number": "१-५-११", "content_sanskrit": "सूतमागधसम्बाधां श्रीमतीमतुलप्रभाम् ।\nउच्चाट्टालध्वजवतीं शतघ्नीशतसंकुलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000005012, "chapter_id": 9005, "verse_number": "१-५-१२", "content_sanskrit": "वधूनाटकसङ्घैश्च संयुक्तां सर्वतः पुरीम् ।\nउद्यानाम्रवणोपेतां महतीं सालमेखलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000005013, "chapter_id": 9005, "verse_number": "१-५-१३", "content_sanskrit": "दुर्गगम्भीरपरिखां दुर्गामन्यैर्दुरासदाम् ।\nवाजिवारणसम्पूर्णां गोभिरुष्ट्रैः खरैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000005014, "chapter_id": 9005, "verse_number": "१-५-१४", "content_sanskrit": "सामन्तराजसङ्घैश्च बलिकर्मभिरावृताम् ।\nनानादेशनिवासैश्च वणिग्भिरुपशोभिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000005015, "chapter_id": 9005, "verse_number": "१-५-१५", "content_sanskrit": "प्रासादै रत्नविकृतैः पर्वतैरिव शोभिताम् ।\nकूटागारैश्च सम्पूर्णामिन्द्रस्येवामरावतीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000005016, "chapter_id": 9005, "verse_number": "१-५-१६", "content_sanskrit": "चित्रामष्टापदाकारां वरनारीगणायुताम् ।\nसर्वरत्नसमाकीर्णां विमानगृहशोभिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000005017, "chapter_id": 9005, "verse_number": "१-५-१७", "content_sanskrit": "गृहगाढामविच्छिद्रां समभूमौ निवेशिताम् ।\nशालितण्डुलसम्पूर्णामिक्षुकाण्डरसोदकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000005018, "chapter_id": 9005, "verse_number": "१-५-१८", "content_sanskrit": "दुन्दुभीभिर्मृदङ्गैश्च वीणाभिः पणवैस्तथा ।\nनादितां भृशमत्यर्थं पृथिव्यां तामनुत्तमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000005019, "chapter_id": 9005, "verse_number": "१-५-१९", "content_sanskrit": "विमानमिव सिद्धानां तपसाधिगतं दिवि ।\nसुनिवेशितवेश्मान्तां नरोत्तमसमावृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000005020, "chapter_id": 9005, "verse_number": "१-५-२०", "content_sanskrit": "ये च बाणैर्न विध्यन्ति विविक्तमपरापरम् ।\nशब्दवेध्यं च विततं लघुहस्ता विशारदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000005021, "chapter_id": 9005, "verse_number": "१-५-२१", "content_sanskrit": "सिंहव्याघ्रवराहाणां मत्तानां नदतां वने ।\nहन्तारो निशितैः शस्त्रैर्बलाद् बाहुबलैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000005022, "chapter_id": 9005, "verse_number": "१-५-२२", "content_sanskrit": "तादृशानां सहस्रैस्तामभिपूर्णां महारथैः ।\nपुरीमावासयामास राजा दशरथस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000005023, "chapter_id": 9005, "verse_number": "१-५-२३", "content_sanskrit": "तामग्निमद्भिर्गुणवद्भिरावृतां\n::द्विजोत्तमैर्वेदषडङ्गपारगैः ।\nसहस्रदैः सत्यरतैर्महात्मभि-\n::र्महर्षिकल्पैर्ऋषिभिश्च केवलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000005024, "chapter_id": 9005, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे पञ्चमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]