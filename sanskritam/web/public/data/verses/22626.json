[{"id": 7002626000, "chapter_id": 22626, "verse_number": "६-४-१", "content_sanskrit": "सूत उवाच ।\nइति श्रुत्वा स वैतालो राजानमिदमब्रवीत् ।\nकाचिद्भोगावती नाम्ना नगरी परमाद्भुता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002626001, "chapter_id": 22626, "verse_number": "६-४-२", "content_sanskrit": "रूपवर्मा च नृपतिस्तत्र राज्यं करोति वै ।\nचूडामणिरिति ख्यातः शुको बुद्धिविशारदः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002626002, "chapter_id": 22626, "verse_number": "६-४-३", "content_sanskrit": "तस्य भूपस्य गेहे च निवसनञ्च्छुभपंजरे ।\nकदाचिद्रूपवर्मा च त्रिंशदब्द उरूर्जितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002626003, "chapter_id": 22626, "verse_number": "६-४-४", "content_sanskrit": "पप्रच्छ मम योग्या वै शुक काचिद्वरांगना ।\nचेदस्ति तर्हि मे ब्रूहि श्रुत्वा तं चाब्रवीच्छुकः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002626004, "chapter_id": 22626, "verse_number": "६-४-५", "content_sanskrit": "मगधेश्वरभूपस्य कन्या चन्द्रवती शुभा ।\nतव योग्या हि भो राजन्सांप्रतं तां गृहाण वै ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002626005, "chapter_id": 22626, "verse_number": "६-४-६", "content_sanskrit": "इति श्रुत्वा स नृपतिर्गणेशं द्विजसत्तमम् ।\nप्रेषयित्वा ददौ द्रव्यं यथोद्वाह्या तथा कुरु ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002626006, "chapter_id": 22626, "verse_number": "६-४-७", "content_sanskrit": "गणेशोपि गतस्तूर्णं देशे मागधके शुभे ।\nमहादेवं च संपूज्य चकार स्तवनं मुदा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002626007, "chapter_id": 22626, "verse_number": "६-४-८", "content_sanskrit": "नमः शिवाय शांताय सर्वाभीष्टप्रदायिने ।\nभवाय शंकरायैव रुद्राय सततं नमः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002626008, "chapter_id": 22626, "verse_number": "६-४-९", "content_sanskrit": "मृडायानंदरूपाय सर्वदुःखहराय च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002626009, "chapter_id": 22626, "verse_number": "६-४-१०", "content_sanskrit": "इत्युक्तवति विप्रे च तदा चन्द्रवती शुभा ।\nकामातुराब्रवीच्चैनां नाम्ना मदनमञ्जरीम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002626010, "chapter_id": 22626, "verse_number": "६-४-११", "content_sanskrit": "मम योग्यश्च पुरुषः कश्चिदस्ति महीतले ।\nसाह भो रूपवर्मा च योग्यो भोगापुरीपतिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002626011, "chapter_id": 22626, "verse_number": "६-४-१२", "content_sanskrit": "इति श्रुत्वा तु सा देवी दुर्गां वाञ्छितदायिनीम् ।\nतुष्टाव मनसा सुभ्रूर्यया जातमिदं जगत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002626012, "chapter_id": 22626, "verse_number": "६-४-१३", "content_sanskrit": "नमोनमो जगन्मातर्मम कार्यप्रदायिनि ।\nत्रिलिंगजननी त्वं वै वर्णमूर्तिः सनातनी ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002626013, "chapter_id": 22626, "verse_number": "६-४-१४", "content_sanskrit": "त्वं स्वाहा त्वं स्वधा संध्या नमस्तस्यै नमोनमः ।\nनृपतिं रूपवर्माणं मत्पतिं कुरु भोः शिवे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002626014, "chapter_id": 22626, "verse_number": "६-४-१५", "content_sanskrit": "इति स्तुत्या प्रसन्नाभूज्जगदंबा जगन्मयी ।\nपितरं मगधेशं च मोहयित्वा च मातरम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002626015, "chapter_id": 22626, "verse_number": "६-४-१६", "content_sanskrit": "विवाहं कारयामास मासान्ते सिद्धरूपिणी ।\nरूपवर्मा चंद्रवती बुभुजाते परं सुखम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002626016, "chapter_id": 22626, "verse_number": "६-४-१७", "content_sanskrit": "एकस्मिन्दिवसे राजन्मेनां मदनमंजरीम् ।\nनृपः प्राह विवाहं त्वं सुशुकेन कुरुष्व भोः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002626017, "chapter_id": 22626, "verse_number": "६-४-१८", "content_sanskrit": "मेनका प्राह भो राजन्विवाहाश्चेदृशो मताः ।\nउत्तमाधममध्याश्च पुरुषास्त्रिविधाः स्मृताः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002626018, "chapter_id": 22626, "verse_number": "६-४-१९", "content_sanskrit": "तथैव त्रिविधा नारी यथा योग्यो वरो भवेत् ।\nउत्तमा यो भवेन्नारी योग्याया चाधमाय वै ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002626019, "chapter_id": 22626, "verse_number": "६-४-२०", "content_sanskrit": "शृणु तत्कारणं राजन्मया दृष्टं यथाऽभवत् ।\nइलापुरे वसत्येको वैश्यो लक्षपतिर्धनी ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002626020, "chapter_id": 22626, "verse_number": "६-४-२१", "content_sanskrit": "अनपत्यो देवयाजी तस्य पत्नी पतिव्रता ।\nबहुयत्नेन तनयस्तस्य जातो महाधमः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002626021, "chapter_id": 22626, "verse_number": "६-४-२२", "content_sanskrit": "द्यूतक्रीडापरो नित्यं सुरापाने रतस्सदा ।\nवेश्यागामी महाधूर्तो नित्यं मांसाशनः खलः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002626022, "chapter_id": 22626, "verse_number": "६-४-२३", "content_sanskrit": "तस्य धर्मं च पितरौ समालोक्य वनं गतौ ।\nनरं नारायणं ध्यात्वा परमं पदमापतुः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002626023, "chapter_id": 22626, "verse_number": "६-४-२४", "content_sanskrit": "मदपालस्तु तनयः कृत्वा सर्वधनव्ययम् ।\nअन्यदेशे च वृत्त्यर्थं जगाम धनवर्जितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002626024, "chapter_id": 22626, "verse_number": "६-४-२५", "content_sanskrit": "प्राप्तश्चंद्रपुरे रम्ये यत्र हेमपतिः स्थितः ।\nवृत्तांतं कथयामास वैश्यं हेमपतिं हि सः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002626025, "chapter_id": 22626, "verse_number": "६-४-२६", "content_sanskrit": "देवयाजी सुतोऽहं वै स्वल्पं वै धनमाहृतम् ।\nदेशान्तरे विक्रयार्थे सिन्धुमार्गेण प्राप्तवान् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002626026, "chapter_id": 22626, "verse_number": "६-४-२७", "content_sanskrit": "महावायु प्रभावेन द्रव्यं तन्मग्नमंभसि ।\nतल्लज्जया न यास्येऽहं पितरं प्रति मारिष ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002626027, "chapter_id": 22626, "verse_number": "६-४-२८", "content_sanskrit": "इति श्रुत्वा हेमपतिः स्वपत्नीं काममंजरीम् ।\nवचः प्राह प्रसन्नात्मा संयोगो विधिना कृतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002626028, "chapter_id": 22626, "verse_number": "६-४-२९", "content_sanskrit": "चंद्रकांतिं सुतां दास्ये तद्वराय त्वदाज्ञया ।\nसंमंत्र्य दंपती राजन्ददौ कन्यां विधानतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002626029, "chapter_id": 22626, "verse_number": "६-४-३०", "content_sanskrit": "स्वगृहे वासयामास मदपालं सुतापतिम् ।\nमासमेकमुषित्वा तं श्वशुरं प्राह नम्रधीः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002626030, "chapter_id": 22626, "verse_number": "६-४-३१", "content_sanskrit": "आज्ञां देहि धनाध्यक्ष स्वगेहं यामि मा चिरम् ।\nइति श्रुत्वा हेमपतिः स्वसुतां स्वर्णभूषिताम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002626031, "chapter_id": 22626, "verse_number": "६-४-३२", "content_sanskrit": "चंद्रकांतिं सदासीं च तस्मै दत्त्वा गृहं ययौ ।\nनरान्विसृज्य दुष्टात्मा शिबिकावाहकान्नृप ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002626032, "chapter_id": 22626, "verse_number": "६-४-३३", "content_sanskrit": "दासीं हत्वा तदा पत्नीं विसृज्य धनवर्जिताम् ।\nएकाकी प्राप्तवान्गेहं मदपालो महाधमः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002626033, "chapter_id": 22626, "verse_number": "६-४-३४", "content_sanskrit": "वर्षांतरे च तत्स्वर्णं व्ययं कृत्वा कुमार्गके ।\nबुभुक्षितः पुनः शोकं चकार बहुधा नृप ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002626034, "chapter_id": 22626, "verse_number": "६-४-३५", "content_sanskrit": "पुनश्च श्वशुरस्यैव गृहे संप्राप्तवान्खलः ।\nचंद्रकांतिस्तु तं दृष्ट्वा स्वपतिं प्राह नम्रधीः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002626035, "chapter_id": 22626, "verse_number": "६-४-३६", "content_sanskrit": "मया निवेदितं पित्रे धनं चौरैश्च लुंठितम् ।\nअतस्त्वं त्यज संतापं चिरं वस गृहे मम ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002626036, "chapter_id": 22626, "verse_number": "६-४-३७", "content_sanskrit": "तथेत्युक्त्वा महाधूर्त उवास कतिचिद्दिनम् ।\nज्ञात्वा विमोहिता पत्नीमर्द्धरात्रे तमोवृते ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002626037, "chapter_id": 22626, "verse_number": "६-४-३८", "content_sanskrit": "हत्वा तां स ययौ गेहं गृहीत्वा बहुभूषणम् ।\nअयोग्योयमतो राजन्विवाहः शुकमेनयोः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002626038, "chapter_id": 22626, "verse_number": "६-४-३९", "content_sanskrit": "इति श्रुत्वा शुकः प्राह भूपतिं करुणानिधिम् ।\nविवाहं न करिष्यामि नार्य्या चाधमया सह ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002626039, "chapter_id": 22626, "verse_number": "६-४-४०", "content_sanskrit": "अधमा मेनका नारी श्यामांगा च कुरूपिणी ।\nउत्तमोऽहं शुको राजन्पुरुषश्च हरेत्तनुम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002626040, "chapter_id": 22626, "verse_number": "६-४-४१", "content_sanskrit": "शृणु तत्कारणं भूप मया दृष्टं महोत्तमम् ।\nनगरे कांचनपुरे वणिक्छंखपतिः श्रुतः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002626041, "chapter_id": 22626, "verse_number": "६-४-४२", "content_sanskrit": "तस्य पुत्रस्तु मेधावी सिन्धुगुप्तो गुणी धनी ।\nप्रभावती प्रिया तस्य श्रीदत्तस्तत्सुतः स्मृतः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002626042, "chapter_id": 22626, "verse_number": "६-४-४३", "content_sanskrit": "विवाहमकरोत्तस्य जयश्रीपत्तने शुभे ।\nसोमदत्तस्य सुतया जयलक्ष्म्या समन्वितम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002626043, "chapter_id": 22626, "verse_number": "६-४-४४", "content_sanskrit": "श्रीदत्तस्तु गतो देशं वाणिज्यार्थं कुरुस्थलम् ।\nआयाति द्वादशाब्दे तु सधनो गेहमागतः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002626044, "chapter_id": 22626, "verse_number": "६-४-४५", "content_sanskrit": "जयलक्ष्मीस्तु कामेन पीडिता पितृमंदिरे ।\nअमात्यतनयेनैव होमदत्तेन मोहिता ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002626045, "chapter_id": 22626, "verse_number": "६-४-४६", "content_sanskrit": "दूती मार्गेण तं प्राप्य व्ययं कृत्वा धनं बहु ।\nरमयामास सा नारी तेन सार्द्धं महाधमा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002626046, "chapter_id": 22626, "verse_number": "६-४-४७", "content_sanskrit": "त्रिमासान्ते च तत्स्वामी श्रीदत्तः श्वशुरालये ।\nसंप्राप्तः सा तु तं दृष्ट्वा महद्दुःखमुपाययौ ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002626047, "chapter_id": 22626, "verse_number": "६-४-४८", "content_sanskrit": "अर्धरात्रे तु तन्मात्रा प्रेषिता स्वपतिं प्रति ।\nजयलक्ष्मीश्च संप्राप्ता क्रोधेन स्फुरिताधरा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002626048, "chapter_id": 22626, "verse_number": "६-४-४९", "content_sanskrit": "बहुमानेन स्वपतिस्नेहं कृत्वालयं ययौ ।\nतदा तु कुलटा सा च गता दूतीगृहं प्रति ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002626049, "chapter_id": 22626, "verse_number": "६-४-५०", "content_sanskrit": "शून्यालये होमदत्तो दंशितो भुजगेन वै ।\nसुष्वाप मरणं प्राप्य तदा बाला समागता ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002626050, "chapter_id": 22626, "verse_number": "६-४-५१", "content_sanskrit": "वेगेन रमयामास तं जारं विषमोहितम् ।\nपिप्पलस्थः पिशाचश्च दृष्ट्वा तां जारिणीं शुभाम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002626051, "chapter_id": 22626, "verse_number": "६-४-५२", "content_sanskrit": "शवदेहं च संप्राप्य रमणीं तामरीरमत् ।\nखनित्वा दशनैर्नासां पिप्पलोपरि सोऽगमत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002626052, "chapter_id": 22626, "verse_number": "६-४-५३", "content_sanskrit": "कफल्लो नाम चौरस्तु दृष्ट्वा तत्कारणं तदा ।\nकामिन्या अनुगो भूत्वा मंदिरं तत्प्रविष्टवान् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002626053, "chapter_id": 22626, "verse_number": "६-४-५४", "content_sanskrit": "तदा तु जयलक्ष्मीश्च स्वपतिं प्राप्य दुर्भगा ।\nचक्रे सा रोदनं गाढं सर्वे लोकाः प्रत स्थिरे ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002626054, "chapter_id": 22626, "verse_number": "६-४-५५", "content_sanskrit": "नासाहीनां सुतां दृष्ट्वा सोमदत्तो महाधनः ।\nबद्ध्वा जामातरं शीघ्रं राजांतिकमुपाययौ ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002626055, "chapter_id": 22626, "verse_number": "६-४-५६", "content_sanskrit": "नृपाज्ञया राजदूतास्तमुद्बंधनमादधुः ।\nतदा कफल्लः संप्राप्य सर्वं राज्ञे न्यवेदयत् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002626056, "chapter_id": 22626, "verse_number": "६-४-५७", "content_sanskrit": "मत्वा तस्य वचः सत्यं जयलक्ष्मीं महाधमाम् ।\nरासभोपरि संस्थाप्य कृत्वा दुर्गतिरूपिणीम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002626057, "chapter_id": 22626, "verse_number": "६-४-५८", "content_sanskrit": "नगरात्प्रेषयामास वनं शार्दूलसेवितम् ।\nअतस्त्वं शृणु भूपाल मेना मद्योग्यिका न हि ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002626058, "chapter_id": 22626, "verse_number": "६-४-५९", "content_sanskrit": "इत्युक्त्वा स तु वैतालो विक्रमं प्राह नम्रधीः ।\nनारी पापाधिका वाथ पुरुषस्तद्वद्वस्व मे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002626059, "chapter_id": 22626, "verse_number": "६-४-६०", "content_sanskrit": "विक्रम उवाच ।\nब्रह्मणोऽगुणरूपस्य मायावर्णस्व रूपिणी ।\nतमो न पुंसकं ज्ञेयं त्रिलिंगैकं तदव्ययम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002626060, "chapter_id": 22626, "verse_number": "६-४-६१", "content_sanskrit": "अव्ययं ब्रह्मणो धाम माया लिंगस्वरूपिणी ।\nतया जातमिदं विश्वं तदंबायै नमोनमः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002626061, "chapter_id": 22626, "verse_number": "६-४-६२", "content_sanskrit": "क्लीबा स्त्री सर्वदा श्रेष्ठा स्त्रियास्तु पुरुषस्तथा ।\nअव्याधिकश्च पुरुषो नारी कर्माधिका मता ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002626062, "chapter_id": 22626, "verse_number": "६-४-६३", "content_sanskrit": "क्लीबमज्ञानमधिकं कथितं पूर्वकोविदैः ।\nकर्मैव बन्धनं पुंसां ज्ञानं निर्बंधन स्मृतम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002626063, "chapter_id": 22626, "verse_number": "६-४-६४", "content_sanskrit": "अतः पापाधिका नारी पुरुषो हीनकिल्बिषः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]