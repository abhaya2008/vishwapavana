[{"id": 5000173000, "chapter_id": 9173, "verse_number": "२-९६-१", "content_sanskrit": "तां तथा दर्शयित्वा तु मैथिलीं गिरिनिम्नगाम् ।\nनिषसाद गिरिप्रस्थे सीतां मांसेन छन्दयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000173001, "chapter_id": 9173, "verse_number": "२-९६-२", "content_sanskrit": "इदं मेध्यमिदं स्वादु निष्टप्तमिदमग्निना ।\nएवमास्ते स धर्मात्मा सीतया सह राघव: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000173002, "chapter_id": 9173, "verse_number": "२-९६-३", "content_sanskrit": "तथा तत्रासतस्तस्य भरतस्योपयायिन: ।\nसैन्यरेणुश्च शब्दश्च प्रादुरास्तां नभस्स्पृशौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000173003, "chapter_id": 9173, "verse_number": "२-९६-४", "content_sanskrit": "एतस्मिन्नन्तरे त्रस्ता: शब्देन महता तत: ।\nअर्दिता यूथपा मत्ता: सयूथा दुद्रुवुर्दिश: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000173004, "chapter_id": 9173, "verse_number": "२-९६-५", "content_sanskrit": "स तं सैन्यसमुद्धूतं शब्दं शुश्राव राघव: ।\nतांश्च विप्रद्रुतान् सर्वान् यूथपानन्ववैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000173005, "chapter_id": 9173, "verse_number": "२-९६-६", "content_sanskrit": "तांश्च विद्रवतो दृष्ट्वा तं च श्रुत्वा च निस्वनम् ।\nउवाच राम: सौमित्रिं लक्ष्मणं दीप्ततेजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000173006, "chapter_id": 9173, "verse_number": "२-९६-७", "content_sanskrit": "हन्त लक्ष्मण पश्येह सुमित्रा सुप्रजास्त्वया ।\nभीमस्तनितगम्भीरस्तुमुल: श्रूयते स्वन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000173007, "chapter_id": 9173, "verse_number": "२-९६-८", "content_sanskrit": "गजयूथानि वा ऽरण्ये महिषा वा महावने ।\nवित्रासिता मृगा: सिंहै: सहसा प्रद्रुता दिश: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000173008, "chapter_id": 9173, "verse_number": "२-९६-९", "content_sanskrit": "राजा वा राजमात्रो वा मृगयामटते वने ।\nअन्यद्वा श्वापदं किञ्चित् सौमित्रे ज्ञातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000173009, "chapter_id": 9173, "verse_number": "२-९६-१०", "content_sanskrit": "सुदुश्चरो गिरिश्चायं पक्षिणामपि लक्ष्मण ।\nसर्वमेतद्यथातत्त्वमचिराज्ज्ञातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000173010, "chapter_id": 9173, "verse_number": "२-९६-११", "content_sanskrit": "स लक्ष्मण: संत्वरित: सालमारुह्य पुष्पितम् ।\nप्रेक्षमाणो दिश: सर्वा: पूर्वां दिशमुदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000173011, "chapter_id": 9173, "verse_number": "२-९६-१२", "content_sanskrit": "उदङ्मुख: प्रेक्षमाणो ददर्श महतीं चमूम् ।\nरथाश्वगजसम्बाधां यत्तैर्युक्तां पदातिभि: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000173012, "chapter_id": 9173, "verse_number": "२-९६-१३", "content_sanskrit": "तामश्वगजसम्पूर्णां रथध्वजविभूषिताम् ।\nशशंस सेनां रामाय वचनं चेदमब्रीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000173013, "chapter_id": 9173, "verse_number": "२-९६-१४", "content_sanskrit": "अग्निं संशमयत्वार्य: सीता च भजतां गुहाम् ।\nसज्यं कुरुष्व चापं च शरांश्च कवचं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000173014, "chapter_id": 9173, "verse_number": "२-९६-१५", "content_sanskrit": "तं राम: पुरुषव्याघ्रो लक्ष्मणं प्रत्युवाच ह ।\nअङ्गावेक्षस्व सौमित्रे कस्येमां मन्यसे चमूम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000173015, "chapter_id": 9173, "verse_number": "२-९६-१६", "content_sanskrit": "एवमुक्तस्तु रामेण लक्ष्मणो वाक्यमब्रवीत् ।\nदिधक्षन्निव तां सेनां रुषित: पावको यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000173016, "chapter_id": 9173, "verse_number": "२-९६-१७", "content_sanskrit": "सम्पन्नं राज्यमिच्छंस्तु व्यक्तं प्राप्याभिषेचनम् ।\nआवां हन्तुं समभ्येति कैकेय्या भरत: सुत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000173017, "chapter_id": 9173, "verse_number": "२-९६-१८", "content_sanskrit": "एष वै सुमहान् श्रीमान् विटपी सम्प्रकाशते ।\nविराजत्युद्गतस्कन्ध: कोविदारध्वजो रथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000173018, "chapter_id": 9173, "verse_number": "२-९६-१९", "content_sanskrit": "भजन्त्येते यथा काममश्वानारुह्य शीघ्रगान् ।\nएते भ्राजन्ति संहृष्टा गजानारुह्य सादिन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000173019, "chapter_id": 9173, "verse_number": "२-९६-२०", "content_sanskrit": "गृहीतधनुषौ चावां गिरिं वीरश्रयावहै ।\nअथवेहैव तिष्ठाव: सन्नद्धावुद्यतायुधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000173020, "chapter_id": 9173, "verse_number": "२-९६-२१", "content_sanskrit": "अपि नौ वशमागच्छेत् कोविदारध्वजो दणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000173021, "chapter_id": 9173, "verse_number": "२-९६-२२", "content_sanskrit": "अपि द्रक्ष्यामि भरतं यत्कृते व्यसनं महत् ।\nत्वया राघव सम्प्राप्तं सीतया च मया तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000173022, "chapter_id": 9173, "verse_number": "२-९६-२३", "content_sanskrit": "यन्निमित्तं भवान् राज्याच्च्युतो राघव शाश्वतात् ।\nसम्प्राप्तो ऽयमरिर्वीर भरतो वध्य एव मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000173023, "chapter_id": 9173, "verse_number": "२-९६-२४", "content_sanskrit": "भरतस्य वधे दोषं नाहं पश्यामि राघव ।\nपूर्वापकारिणां त्यागे न ह्यधर्मो विधीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000173024, "chapter_id": 9173, "verse_number": "२-९६-२५", "content_sanskrit": "पूर्वापकारी भरतस्त्यक्तधर्मश्च राघव ।\nएतस्मिन्निहते कृत्स्नामनुशाधि वसुन्धराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000173025, "chapter_id": 9173, "verse_number": "२-९६-२६", "content_sanskrit": "अद्य पुत्रं हतं सङ्ख्ये कैकेयी राज्यकामुका ।\nमया पश्येत् सुदु:खार्त्ता हस्तिभग्नमिव द्रुमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000173026, "chapter_id": 9173, "verse_number": "२-९६-२७", "content_sanskrit": "कैकेयीं च वधिष्यामि सानुबन्धां सबान्धवाम् ।\nकलुषेणाद्य महता मेदिनी परिमुच्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000173027, "chapter_id": 9173, "verse_number": "२-९६-२८", "content_sanskrit": "अद्येमं संयतं क्रोधमसत्कारं च मानद ।\nमोक्ष्यामि शत्रुसैन्येषु कक्षेष्विव हुताशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000173028, "chapter_id": 9173, "verse_number": "२-९६-२९", "content_sanskrit": "अद्यैतच्चित्रकूटस्य काननं निशितै: शरै: ।\nभिन्दन् शत्रुशरीराणि करिष्ये शोणितोक्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000173029, "chapter_id": 9173, "verse_number": "२-९६-३०", "content_sanskrit": "शरैर्निर्भिन्नहृदयान् कुञ्जरांस्तुरगांस्तथा ।\nश्वापदा: परिकर्षन्तु नरांश्च निहतान् मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000173030, "chapter_id": 9173, "verse_number": "२-९६-३१", "content_sanskrit": "शराणां धनुषश्चाहमनृणो ऽस्मि महामृधे ।\nससैन्यं भरतं हत्वा भविष्यामि न संशय: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000173031, "chapter_id": 9173, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदयोध्याकाण्डे षण्णवतितम: सर्ग: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]