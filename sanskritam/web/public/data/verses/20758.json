[{"id": 7000758000, "chapter_id": 20758, "verse_number": "६-१०१-१", "content_sanskrit": "नारद उवाच ।\nते गणाधिपतीन्दृष्ट्वा नंदीभमुखषण्मुखान् ।\nअमर्षादभ्यधावंत द्वंद्वयुद्धाय दानवाः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000758001, "chapter_id": 20758, "verse_number": "६-१०१-२", "content_sanskrit": "नंदिनं कालनेमिश्च शुंभो लंबोदरं तथा ।\nनिशुंभः षण्मुखं वेगादभ्यधावत दंशितः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000758002, "chapter_id": 20758, "verse_number": "६-१०१-३", "content_sanskrit": "निशुंभः कार्तिकेयस्य मयूरं पंचभिः शरैः ।\nहृदि विव्याध वेगेन मूर्छितः स पपात च॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000758003, "chapter_id": 20758, "verse_number": "६-१०१-४", "content_sanskrit": "ततः शक्तिधरः शक्तिं यावज्जग्राह रोषितः ।\nतावन्निशुंभो वेगेन स्वशक्त्या तमपातयत्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000758004, "chapter_id": 20758, "verse_number": "६-१०१-५", "content_sanskrit": "ततो नंदीश्वरो बाणैः कालनेमिमविध्यत ।\nसप्तभिश्च हयान्केतूंस्त्रिभिः सारथिमच्छिनत्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000758005, "chapter_id": 20758, "verse_number": "६-१०१-६", "content_sanskrit": "कालनेमिस्तु संक्रुद्धो धनुश्चिच्छेद नंदिनः ।\nतदपास्य सशूलेन तं वक्षस्य हनद्दृढम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000758006, "chapter_id": 20758, "verse_number": "६-१०१-७", "content_sanskrit": "सशूलभिन्नहृदयो हताश्वो हतसारथिः ।\nअद्रेः शिखरमामुच्य शैलाद्रिं सोऽप्यपातयत्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000758007, "chapter_id": 20758, "verse_number": "६-१०१-८", "content_sanskrit": "अथ शुंभो गणेशश्च रथमूषकवाहनौ ।\nयुध्यमानौ शरव्रातैः परस्परमविध्यताम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000758008, "chapter_id": 20758, "verse_number": "६-१०१-९", "content_sanskrit": "अथ शुंभं गणाध्यक्षो हृदि विव्याध पत्रिणा ।\nसारथिं पंचभिर्बाणैः पातयामास भूतले॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000758009, "chapter_id": 20758, "verse_number": "६-१०१-१०", "content_sanskrit": "ततः शुंभोऽतिक्रुद्धोऽपि बाणषष्ट्या गणाधिपम् ।\nमूषकं च त्रिभिर्विद्ध्वा ननाद जलदस्वनः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000758010, "chapter_id": 20758, "verse_number": "६-१०१-११", "content_sanskrit": "मूषकः शरभिन्नांगश्चचाल कृतवेदनः ।\nलंबोदरः समुत्तीर्य पदातिरभवन्नृप॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000758011, "chapter_id": 20758, "verse_number": "६-१०१-१२", "content_sanskrit": "ततो लंबोदरः शुंभं हत्वा परशुना हृदि ।\nअपातयत्तदा भूमौ मूषकं चारुहत्पुनः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000758012, "chapter_id": 20758, "verse_number": "६-१०१-१३", "content_sanskrit": "कालनेमिर्निशुंभश्च उभौ लंबोदरं शरैः ।\nयुगपज्जघ्नतुः कोपात्तोत्रेणेव महाद्विपम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000758013, "chapter_id": 20758, "verse_number": "६-१०१-१४", "content_sanskrit": "तं पीड्यमानमालोक्य वीरभद्रो महाबलः ।\nअभ्यधावत वेगेन भूतकोटियुतस्तदा॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000758014, "chapter_id": 20758, "verse_number": "६-१०१-१५", "content_sanskrit": "कूष्मांडा भैरवाश्चापि वेताला योगिनीगणाः ।\nपिशाचा योगिनीसंघा गणाश्चापि तमन्वयुः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000758015, "chapter_id": 20758, "verse_number": "६-१०१-१६", "content_sanskrit": "ततः किलकिलाशब्दैः सिंहनादैः सघुर्घुरैः ।\nविनादिता डमरुकैः पृथिवी समकंपत॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000758016, "chapter_id": 20758, "verse_number": "६-१०१-१७", "content_sanskrit": "ततो भूतानि धावंति भक्षयंति स्म दानवान् ।\nउत्पतंति पतंति स्म ननृतुश्चरणांगणे॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000758017, "chapter_id": 20758, "verse_number": "६-१०१-१८", "content_sanskrit": "नंदी च कार्तिकेयश्च समायातौ त्वरान्वितौ ।\nनिजघ्नतू रणे दैत्यान्निरंतर शरव्रजैः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000758018, "chapter_id": 20758, "verse_number": "६-१०१-१९", "content_sanskrit": "छिन्नभिन्नाह तैर्दैत्यैः पातितैर्भर्त्सितैस्तथा ।\nव्याकुला सा भवत्सेना विषण्णवदना तदा॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000758019, "chapter_id": 20758, "verse_number": "६-१०१-२०", "content_sanskrit": "प्रविध्वस्तां ततः सेनां दृष्ट्वा सागरनंदनः ।\nरथेनातिपताकेन गणानभिययौ बली॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000758020, "chapter_id": 20758, "verse_number": "६-१०१-२१", "content_sanskrit": "हस्त्यश्वरथसंह्रादः शंखभेरीरवस्तदा ।\nअभवत्सिंहनादश्च सेनयोरुभयोस्तदा॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000758021, "chapter_id": 20758, "verse_number": "६-१०१-२२", "content_sanskrit": "जालंधरशरव्रातैर्नीहारपटलैरिव ।\nद्यावापृथिव्योराच्छन्नमंतरं समपद्यत॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000758022, "chapter_id": 20758, "verse_number": "६-१०१-२३", "content_sanskrit": "गणेशं पंचभिर्विध्वा शैलाद्रिमपि पंचभिः ।\nवीरभद्रं च विंशत्या ननाद जलदस्वनः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000758023, "chapter_id": 20758, "verse_number": "६-१०१-२४", "content_sanskrit": "कार्तिकेयस्ततो दैत्यं शक्त्या विव्याध सत्वरः ।\nव्याघूर्णः शक्तिनिर्भिन्नः किंचिद्व्याकुलमानसः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000758024, "chapter_id": 20758, "verse_number": "६-१०१-२५", "content_sanskrit": "ततः क्रोधपरीताक्षः कार्तिकेयं जलंधरः ।\nगदया ताडयामास स च भूमितलेऽपतत्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000758025, "chapter_id": 20758, "verse_number": "६-१०१-२६", "content_sanskrit": "तथैव नंदिनं वेगादपातयत भूतले ।\nततो गणेश्वरः क्रुद्धो गदां परशुनाच्छिनत्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000758026, "chapter_id": 20758, "verse_number": "६-१०१-२७", "content_sanskrit": "वीरभद्रस्त्रिभिर्बाणैर्हृदि विव्याध दानवम् ।\nसप्तभिश्च हयान्केतून्धनुश्छन्नं च चिच्छिदे॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000758027, "chapter_id": 20758, "verse_number": "६-१०१-२८", "content_sanskrit": "ततोऽतिक्रुद्धो दैत्येंद्रः शक्तिमुद्यम्य दारुणाम् ।\nगणेशं पातयामास रथमन्यं समारुहत्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000758028, "chapter_id": 20758, "verse_number": "६-१०१-२९", "content_sanskrit": "अभ्ययादथ वेगेन वीरभद्रं रुषान्वितः ।\nततस्तौ सूर्यसंकाशौ युयुधाते परस्परम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000758029, "chapter_id": 20758, "verse_number": "६-१०१-३०", "content_sanskrit": "वीरभद्रस्तस्य हयांस्तथा बाणैरपातयत् ।\nधनुश्चिच्छेद दैत्येंद्रो युयुधे परिघायुधः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000758030, "chapter_id": 20758, "verse_number": "६-१०१-३१", "content_sanskrit": "स वीरभद्रं त्वरयाभिगम्य जघान दैत्यः परिघेन मूर्ध्नि ।\nस चापि दैत्यः प्रविभिन्नमूर्द्धा पपात भूमौ रुधिरं समुद्गिरन्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]