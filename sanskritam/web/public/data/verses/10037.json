[{"id": 6000037000, "chapter_id": 10037, "verse_number": null, "content_sanskrit": "अथ सप्तमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000037001, "chapter_id": 10037, "verse_number": null, "content_sanskrit": "ऋषिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.001.m4a", "display_order": 2}, {"id": 6000037002, "chapter_id": 10037, "verse_number": "३-७-१", "content_sanskrit": "इति तासां स्वशक्तीनामसतीनां समेत्य सः।\nप्रसुप्तलोकतन्त्राणां निशम्य गिरमीश्वरः॥ ३/७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.002.m4a", "display_order": 3, "topics": [{"text": "भगवता स्वतत्त्वांशैरण्डसर्जनपूर्वकं तत्र विराट्पुरुषसर्जनम्", "range": "१–७"}]}, {"id": 6000037003, "chapter_id": 10037, "verse_number": "३-७-२", "content_sanskrit": "कालसंज्ञां ततो मायां बिभ्रच्छक्तिमुरुक्रमः।\nत्रयोविंशतितत्त्वानां गणं युगपदाविशत्॥ ३/७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.003.m4a", "display_order": 4}, {"id": 6000037004, "chapter_id": 10037, "verse_number": "३-७-३", "content_sanskrit": "सोऽनुप्रविष्टो भगवान् चेष्टारूपेण तं गणम्।\nभिन्नं संयोजयामास सुप्तं कर्म प्रबोधयन्॥ ३/७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.004.m4a", "display_order": 5}, {"id": 6000037005, "chapter_id": 10037, "verse_number": "३-७-४", "content_sanskrit": "प्रबुद्धकर्मा दैवेन त्रयोविंशतिको गणः।\nप्रेरितोऽजनयत् स्वाभिर्मात्राभिरभिपूरुषम्॥ ३/७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.005.m4a", "display_order": 6}, {"id": 6000037006, "chapter_id": 10037, "verse_number": "३-७-५", "content_sanskrit": "परेणाविशता स्वस्मिन् मात्रया विश्वसृग् गणः।\nचुक्षोभान्योन्यमासाद्य यस्मिन् लोकश्चराचरः॥ ३/७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.006.m4a", "display_order": 7}, {"id": 6000037007, "chapter_id": 10037, "verse_number": "३-७-६", "content_sanskrit": "हिरण्मयः स पुरुषः सहस्रपरिवत्सरान्।\nआण्डकोश उवासाप्सु सर्वसत्त्वोपबृंहितः॥ ३/७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.007.m4a", "display_order": 8}, {"id": 6000037008, "chapter_id": 10037, "verse_number": "३-७-७", "content_sanskrit": "स वै विश्वसृजां गर्भो दैवकर्मात्मशक्तिमान्।\nविबभाजाऽत्मनाऽऽत्मानमेकधा दशधा त्रिधा॥ ३/७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.008.m4a", "display_order": 9}, {"id": 6000037009, "chapter_id": 10037, "verse_number": "३-७-८", "content_sanskrit": "एष ह्यशेषसत्त्वानामात्मांशः परमात्मनः।\nआद्योऽवतारो यत्रासौ भूतग्रामो विभाव्यते॥ ३/७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.009.m4a", "display_order": 10, "topics": [{"text": "इन्द्रियतदभिमानिदेवतानां तद्विषयाणां च सर्जनम्", "range": "७–२६"}]}, {"id": 6000037010, "chapter_id": 10037, "verse_number": "३-७-९", "content_sanskrit": "साध्यात्मं साधिदैवं च साधिभूतमिति त्रिधा।\nविराट्प्राणो दशविध एकधा हृदयेन च॥ ३/७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.010.m4a", "display_order": 11}, {"id": 6000037011, "chapter_id": 10037, "verse_number": "३-७-१०", "content_sanskrit": "स्मरन् विश्वसृजामीशो विज्ञापितमधोक्षजः।\nविराजमतपत् स्वेन तेजसैषां विवृद्धये॥ ३/७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.011.m4a", "display_order": 12}, {"id": 6000037012, "chapter_id": 10037, "verse_number": "३-७-११", "content_sanskrit": "अथ तस्याभितप्तस्य कति चायतनानि ह।\nनिरभिद्यन्त देवानां तानि मे गदतः शृृणु॥ ३/७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.012.m4a", "display_order": 13}, {"id": 6000037013, "chapter_id": 10037, "verse_number": "३-७-१२", "content_sanskrit": "तस्याग्निरास्यं निर्भिण्णं लोकपालोऽविशत् पदम्।\nवाचा स्वांशेन वक्तव्यं ययाऽसौ प्रतिपद्यते॥ ३/७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.013.m4a", "display_order": 14}, {"id": 6000037014, "chapter_id": 10037, "verse_number": "३-७-१३", "content_sanskrit": "निर्भिण्णं तालु वरुणो लोकपालोऽविशद्धरेः।\nजिह्वयाऽंशेन च रसान् ययाऽसौ प्रतिपद्यते॥ ३/७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.014.m4a", "display_order": 15}, {"id": 6000037015, "chapter_id": 10037, "verse_number": "३-७-१४", "content_sanskrit": "निर्भिण्णे अश्विनौ नासे विष्णोराविशतां पदम्।\nघ्राणेनांशेन गन्धस्य प्रतिपत्तिर्यतो भवेत्॥ ३/७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.015.m4a", "display_order": 16}, {"id": 6000037016, "chapter_id": 10037, "verse_number": "३-७-१५", "content_sanskrit": "निर्भिण्णे अक्षिणी त्वष्टा लोकपालोऽविशत्प्रभोः।\nचक्षुषांऽशेन रूपाणां प्रतिपत्तिर्यतो भवेत्॥ ३/७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.016.m4a", "display_order": 17}, {"id": 6000037017, "chapter_id": 10037, "verse_number": "३-७-१६", "content_sanskrit": "निर्भिण्णान्यथ चर्माणि लोकपालोऽनिलोऽविशत्।\nप्राणेनांशेन संस्पर्शं येनासौ प्रतिपद्यते॥ ३/७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.017.m4a", "display_order": 18}, {"id": 6000037018, "chapter_id": 10037, "verse_number": "३-७-१७", "content_sanskrit": "कर्णावस्य विनिर्भिण्णौ धिष्ण्यं स्वं विविशुर्दिशः।\nश्रोत्रेणांशेन शब्दस्य सिद्धिं येन प्रपद्यते॥ ३/७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.018.m4a", "display_order": 19}, {"id": 6000037019, "chapter_id": 10037, "verse_number": "३-७-१८", "content_sanskrit": "त्वचमस्य विनिर्भिण्णां विविशुर्धिष्ण्यमोषधीः।\nअंशेन रोमभिः कण्डुं यैरसौ प्रतिपद्यते॥ ३/७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.019.m4a", "display_order": 20}, {"id": 6000037020, "chapter_id": 10037, "verse_number": "३-७-१९", "content_sanskrit": "मेढ्रं तस्य विनिर्भिण्णं स्वधिष्ण्यं क उपाविशत्।\nरेतसांऽशेन येनासावानन्दं प्रतिपद्यते॥ ३/७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.020.m4a", "display_order": 21}, {"id": 6000037021, "chapter_id": 10037, "verse_number": "३-७-२०", "content_sanskrit": "गुदं पुंसो विनिर्भिण्णं मित्रो लोकेश आविशत्।\nपायुनांऽशेन येनासौ विसर्गं प्रतिपद्यते॥ ३/७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.021.m4a", "display_order": 22}, {"id": 6000037022, "chapter_id": 10037, "verse_number": "३-७-२१", "content_sanskrit": "हस्तावस्य विनिर्भिण्णाविन्द्रः स्वर्पतिराविशत्।\nवार्तयांऽशेन पुरुषो यया वृत्तिं प्रपद्यते॥ ३/७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.022.m4a", "display_order": 23}, {"id": 6000037023, "chapter_id": 10037, "verse_number": "३-७-२२", "content_sanskrit": "पादावस्य विनिर्भिण्णौ लोकेशो विष्णुराविशत्।\nगत्या स्वांशेन पुरुषो यया प्राप्यं प्रपद्यते॥ ३/७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.023.m4a", "display_order": 24}, {"id": 6000037024, "chapter_id": 10037, "verse_number": "३-७-२३", "content_sanskrit": "हृदयं चास्य निर्भिण्णं चन्द्रमा धिष्ण्यमाविशत्।\nमनसांशेन येनासौ विक्रियां प्रतिपद्यते॥ ३/७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.024.m4a", "display_order": 25}, {"id": 6000037025, "chapter_id": 10037, "verse_number": "३-७-२४", "content_sanskrit": "आत्मानं चास्य निर्भिण्णं वाचस्पतिरुपाविशत्।\nबुद्ध्या स्वांशेन येनासौ निश्चयं प्रतिपद्यते॥ ३/७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.025.m4a", "display_order": 26}, {"id": 6000037026, "chapter_id": 10037, "verse_number": "३-७-२५", "content_sanskrit": "अहं चास्य विनिर्भिण्णमभिमानोऽविशत् पदम्।\nकर्त्रा स्वांशेन येनासौ कर्तव्यं प्रतिपद्यते॥ ३/७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.026.m4a", "display_order": 27}, {"id": 6000037027, "chapter_id": 10037, "verse_number": "३-७-२६", "content_sanskrit": "सत्त्वं चास्य विनिर्भिण्णं महान् धिष्ण्यमुपाविशत्।\nचित्तेनांशेन येनासौ विज्ञानं प्रतिपद्यते॥ ३/७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.027.m4a", "display_order": 28}, {"id": 6000037028, "chapter_id": 10037, "verse_number": "३-७-२७", "content_sanskrit": "शीर्ष्णोऽस्य द्यौर्धरा पद्भ्यां खं नाभेरुदपद्यत।\nगुणानां वृत्तयो येषु प्रतीयन्ते सुरादयः॥ ३/७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.028.m4a", "display_order": 29, "topics": [{"text": "लोकानां वर्णानां च सृष्टिः", "range": "२७–३३"}]}, {"id": 6000037029, "chapter_id": 10037, "verse_number": "३-७-२८", "content_sanskrit": "औत्पत्तिकेन सत्त्वेन दिवं देवाः प्रपेदिरे।\nधरां रजःस्वभावेन पणयो ये च ताननु॥ ३/७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.029.m4a", "display_order": 30}, {"id": 6000037030, "chapter_id": 10037, "verse_number": "३-७-२९", "content_sanskrit": "तार्तीयेन स्वभावेन भगवन्नाभिमाश्रिताः।\nउभयोरन्तरं व्योम ये रुद्रपार्षदा गणाः॥ ३/७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.030.m4a", "display_order": 31}, {"id": 6000037031, "chapter_id": 10037, "verse_number": "३-७-३०", "content_sanskrit": "मुखतोऽवर्तत ब्रह्म पुरुषस्य कुरूद्वह।\nयत्रोन्मुखत्वाद् वर्णानां मुख्योऽभूद् ब्राह्मणो गुरुः॥ ३/७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.031.m4a", "display_order": 32}, {"id": 6000037032, "chapter_id": 10037, "verse_number": "३-७-३१", "content_sanskrit": "बाहुभ्योऽवर्तत क्षत्रं क्षत्रियस्तदनुव्रतः।\nयो जातस्‍त्रायते वर्णान् पुरुषान् कण्टकक्षतात्॥ ३/७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.032.m4a", "display_order": 33}, {"id": 6000037033, "chapter_id": 10037, "verse_number": "३-७-३२", "content_sanskrit": "विशोऽवर्तन्त तस्योर्वोर्लोकवृत्तिकरीर्विभोः।\nवैश्यस्तदुद्भवो वार्तां नृणां यः समवर्तयत्॥ ३/७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.033.m4a", "display_order": 34}, {"id": 6000037034, "chapter_id": 10037, "verse_number": "३-७-३३", "content_sanskrit": "पद्भ्यां भगवतो जज्ञे शुश्रूषाकर्मसिद्धये।\nतस्यां जातः पुरा शूद्रो यद्वृत्त्या तुष्यते हरिः॥ ३/७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.034.m4a", "display_order": 35}, {"id": 6000037035, "chapter_id": 10037, "verse_number": "३-७-३४", "content_sanskrit": "एते वर्णाः स्वधर्मेण यजन्ते स्वगुरुं हरिम्।\nश्रद्धयाऽऽत्मविशुद्ध्यर्थं यज्जाताः सह वृत्तिभिः॥ ३/७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.035.m4a", "display_order": 36, "topics": [{"text": "हरिस्तवनम्, उपसंहारश्च", "range": "३४–४०"}]}, {"id": 6000037036, "chapter_id": 10037, "verse_number": "३-७-३५", "content_sanskrit": "एतत् क्षत्तर्भगवतो दैवकर्मात्मरूपिणः।\nकः श्रद्दध्यादुदाहर्तुं योगमायाबलोदयम्॥ ३/७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.036.m4a", "display_order": 37}, {"id": 6000037037, "chapter_id": 10037, "verse_number": "३-७-३६", "content_sanskrit": "अथापि कीर्तयाम्यङ्ग यथामति यथाश्रुतम्।\nकीर्तिं हरेः स्वां संस्कर्तुं गिरमन्याभिधां सतीम्॥ ३/७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.037.m4a", "display_order": 38}, {"id": 6000037038, "chapter_id": 10037, "verse_number": "३-७-३७", "content_sanskrit": "एकान्तलाभं वचसो नु पुंसः सुश्लोकमौलेर्गुणवादमाहुः।\nश्रुतेश्च विद्वद्भिरुपाकृतायाः कथासुधाया उत संप्रयोगः॥ ३/७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.038.m4a", "display_order": 39}, {"id": 6000037039, "chapter_id": 10037, "verse_number": "३-७-३८", "content_sanskrit": "आत्मनोऽवसितो वत्स महिमा कविनाऽऽदिना।\nसंवत्सरसहस्रान्ते धिया योगविपक्‍वया॥ ३/७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.039.m4a", "display_order": 40}, {"id": 6000037040, "chapter_id": 10037, "verse_number": "३-७-३९", "content_sanskrit": "अतो भगवतो माया मायिनामपि मोहिनी।\nयत्स्वयं चाऽऽत्मवर्त्माऽऽत्मा न वेद किमुतापरे॥ ३/७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.040.m4a", "display_order": 41}, {"id": 6000037041, "chapter_id": 10037, "verse_number": "३-७-४०", "content_sanskrit": "यतोऽप्राप्य निवर्तन्ते वाचश्च मनसा सह।\nअहं चान्य इमे देवास्तस्मै भगवते नमः॥ ३/७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_007/BhP_03.007.041.m4a", "display_order": 42}, {"id": 6000037042, "chapter_id": 10037, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे सप्तमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]