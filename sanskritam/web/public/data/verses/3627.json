[{"id": 2122382, "chapter_id": 3627, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2122383, "chapter_id": 3627, "verse_number": "१", "content_sanskrit": "अनुसंसाद्य नृपतीन् पाण्डवाः पाण्डवाग्रजम् ।\nअनुजग्मुर्महेष्वासा धर्मराजं युधिष्ठिरम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2122384, "chapter_id": 3627, "verse_number": "२", "content_sanskrit": "सोऽनुमेने महाबाहुर्भ्रातॄंश्च सुहृदस्तथा ।\nशिष्यैः परिवृतो व्यासः पुरस्तात् समपद्यत ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2122385, "chapter_id": 3627, "verse_number": "३", "content_sanskrit": "सोऽभ्युत्थायासनात् तूर्णं भ्रातृभिः परिवारितः ।\nपाद्येनासनदानेन पितामहमपूजयत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2122386, "chapter_id": 3627, "verse_number": "४", "content_sanskrit": "अथोपविश्य भगवान् काञ्चने परमासने ।\nआस्यतामिति चोवाच धर्मराजं युधिष्ठिरम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2122387, "chapter_id": 3627, "verse_number": "५", "content_sanskrit": "अथोपविष्टं राजानं भ्रातृभिः परिवारितम् ।\nउवाच भगवान् व्यासस्तत्तद्वाक्यविशारदः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2122388, "chapter_id": 3627, "verse_number": "६", "content_sanskrit": "कौन्तेय वर्धसे दिष्ठ्या साम्राज्यं प्राप्य दुर्लभम् ।\nपालिताः कुरवः सर्वे त्वया कुरुकुलोद्वह ।\nआपृच्छे त्वां गमिष्यामि पूजितोऽस्मि विशाम्पते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2122389, "chapter_id": 3627, "verse_number": "७", "content_sanskrit": "एवमुक्तस्तु कृष्णेन धर्मराजो युधिष्ठिरः ।\nअभिवाद्योपसङ्गृह्य पितामहमथाब्रवीत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2122390, "chapter_id": 3627, "verse_number": "८", "content_sanskrit": "संशयो द्विपदां श्रेष्ठ ममोत्पन्नः सुदुर्वचः ।\nतस्येह नान्यो वक्ताऽस्ति त्वामृते द्विजपुङ्गव ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2122391, "chapter_id": 3627, "verse_number": "९", "content_sanskrit": "उत्पातांस्त्रिविधानाह नारदो भगवानृषिः ।\nदिव्यांश्चैवान्तरिक्षांश्च पार्थिवांश्च पितामह ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2122392, "chapter_id": 3627, "verse_number": "१०", "content_sanskrit": "सुमहच्च फलं तेषां भवितेति न संशयः ।\nअपि चैद्यस्य पतनाच्छान्तमौत्पातिकं भवेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2122393, "chapter_id": 3627, "verse_number": "११", "content_sanskrit": "राज्ञस्तद्वचनं श्रुत्वा पराशरसुतः प्रभुः ।\nकृष्णद्वैपायनो व्यास इदं वचनमब्रवीत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2122394, "chapter_id": 3627, "verse_number": "१२", "content_sanskrit": "चतुर्दश समा राजन्नुत्पातानां महत् फलम् ।\nसर्वक्षत्रविनाशाय भविष्यति विशाम्पते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2122395, "chapter_id": 3627, "verse_number": "१३", "content_sanskrit": "त्वामेव कारणं कृत्वा कालेन भरतर्षभ ।\nसमेतं पार्थिवं क्षत्रं क्षयं यास्यति पाण्डव ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2122396, "chapter_id": 3627, "verse_number": "१४", "content_sanskrit": "दुर्योधनापराधेन भीमार्जुनबलेन च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2122397, "chapter_id": 3627, "verse_number": "१५", "content_sanskrit": "स्वप्नं द्रक्ष्यसि राजेन्द्र तस्मिन् काल उपस्थिते ।\nतत् तेऽहं सम्प्रवक्ष्यामि तन्निबोध युधिष्ठिर ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2122398, "chapter_id": 3627, "verse_number": "१६", "content_sanskrit": "यदा द्रक्ष्यसि राजेन्द्र क्षपान्ते गोवृषध्वजम् ।\nनीलकण्ठं भवं स्थाणु त्रिपुरान्तकरं हरम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2122399, "chapter_id": 3627, "verse_number": "१७", "content_sanskrit": "उग्रं रुद्रं पशुपतिं महादेवमुमापतिम् ।\nशिवं शर्वंर् भवं शूलिं पिनाकिं कृत्तिवाससम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2122400, "chapter_id": 3627, "verse_number": "१८", "content_sanskrit": "कैलासकूटप्रतिमे वृषभे निष्ठितं शिवम् ।\nनिरीक्षमाणं सततं पितृराजाश्रितां दिशम् । ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2122401, "chapter_id": 3627, "verse_number": "१९", "content_sanskrit": "यदैवमीदृशं स्वप्नं द्रष्टा ह्यसि विशाम्पते ।\nमा च तेऽभूद् व्यथा राजन् कालो हि दुरतिक्रमः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2122402, "chapter_id": 3627, "verse_number": "२०", "content_sanskrit": "स्वस्ति तेऽस्तु गमिष्यामि कैलासं पर्वतं प्रति ।\nअप्रमत्तः स्थितो दान्तः पृथिवीं परिपालय ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2122403, "chapter_id": 3627, "verse_number": "२१", "content_sanskrit": "एवमुक्त्वा तु भगवान् कैलासं पर्वतं ययौ ।\nकृष्णद्वैपायनो व्यासः सह शिष्यैः सहानुगः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2122404, "chapter_id": 3627, "verse_number": "२२", "content_sanskrit": "गते पितामहे राजा चिन्ताशोकसमन्वितः ।\nनिःश्वसन्नुष्णमसकृत् तमेवार्थं व्यचिन्तयत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2122405, "chapter_id": 3627, "verse_number": "२३", "content_sanskrit": "कथं नु दैवं शक्येत पौरुषेण प्रबाधितुम् ।\nअवश्यमेव भविता यदुक्तं परमर्षिणा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2122406, "chapter_id": 3627, "verse_number": "२४", "content_sanskrit": "ततोऽब्रवीन्महातेजाः सर्वान् भ्रातॄन् युधिष्ठिरः ।\nश्रुतं वै पुरुषव्याघ्रा यथा द्वैपायनोऽब्रवीत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2122407, "chapter_id": 3627, "verse_number": "२५", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा मरणे निश्चिता मतिः ।\nसर्वक्षत्रस्य निधने यद्यहं हेतुरीप्सितः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2122408, "chapter_id": 3627, "verse_number": "२६", "content_sanskrit": "कालेन निर्मितस्ताताः को ममार्थोऽस्ति जीवतः ।\nएवं ब्रुवन्तं राजानं फल्गुनः प्रत्यभाषत ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2122409, "chapter_id": 3627, "verse_number": "२७", "content_sanskrit": "मा राजन् कश्मलं घोरं प्रविशेद् बुद्धिनाशनम् ।\nसम्प्रधार्य महाराज यत् क्षमं तत् समाचर ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2122410, "chapter_id": 3627, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2122411, "chapter_id": 3627, "verse_number": "२८", "content_sanskrit": "ततोऽब्रवीत् सत्यधृतिर्भ्रातॄन् सर्वान् युधिष्ठिरः ।\nद्वैपायनस्य वचनं तत्रैव समचिन्तयन् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2122412, "chapter_id": 3627, "verse_number": "२९", "content_sanskrit": "अद्यप्रभृति भद्रं वः प्रतिज्ञां मे निबोधत ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2122413, "chapter_id": 3627, "verse_number": "३०", "content_sanskrit": "न प्रवक्ष्यामि परुषान् भातॄनन्यांश्च पार्थिवान् ।\nस्थितो निदेशे ज्ञातीनां योक्ष्ये तत्समुदाहरन् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2122414, "chapter_id": 3627, "verse_number": "३१", "content_sanskrit": "एवं मे वर्तमानस्य स्वकीयेष्वितरेषु च ।\nभेदो न भविता लोके भेदमूलो हि विग्रहः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2122415, "chapter_id": 3627, "verse_number": "३२", "content_sanskrit": "विग्रहं दूरतो रक्षन् प्रियाण्येव समाचरन् ।\nवाच्यतां न गमिष्यामि लोकेषु मनुजर्षभाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2122416, "chapter_id": 3627, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2122417, "chapter_id": 3627, "verse_number": "३३", "content_sanskrit": "भ्रातुर्ज्येष्ठस्य वचनं पाण्डवाः सन्निशम्य तत् ।\nतमेव समवर्तन्त धर्मराजहिते रताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2122418, "chapter_id": 3627, "verse_number": "३४", "content_sanskrit": "संसत्सु समयं कृत्वा धर्मराड् भ्रातृभिः सह ।\nपितॄंस्तर्प्य यथान्यायं देवताश्च विशाम्पते ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2122419, "chapter_id": 3627, "verse_number": "३५", "content_sanskrit": "कृतमङ्गलकल्याणो भ्रातृभिः परिवारितः ।\nगतेषु क्षत्रियेन्द्रेषु सर्वेषु भरतर्षभ ।\nयुधिष्ठिरः सहामात्यः प्रविवेश पुरोत्तमम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2122420, "chapter_id": 3627, "verse_number": "३६", "content_sanskrit": "दुर्योधनो महाराज शकुनिश्चापि सौबलः ।\nसभायां रमणीयायां तत्रैवास्तां नराधिप ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2122421, "chapter_id": 3627, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि एकोनसप्ततितमोऽध्यायः ॥६९॥\n॥ द्यूतपर्वणि प्रथमोऽध्यायः ॥१॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]