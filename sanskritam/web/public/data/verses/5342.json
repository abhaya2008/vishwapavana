[{"id": 2203591, "chapter_id": 5342, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2203592, "chapter_id": 5342, "verse_number": "१", "content_sanskrit": "क्षणज्ञा देवदेवस्य श्रोतुकामा प्रियं हितम् ।\nउमादेवी महादेवमपृच्छत् पुनरेव तु\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2203593, "chapter_id": 5342, "verse_number": "२", "content_sanskrit": "भगवन् देवदेवेश सर्वदेवनमस्कृत ।\nचतुर्मुखो वै भगवानभवत् केन हेतुना\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2203594, "chapter_id": 5342, "verse_number": "३", "content_sanskrit": "भगवन् केन वै वक्त्रमैन्द्रमद्भुतदर्शनम् ।\nउत्तरं चापि भगवन् पश्चिमं शुभदर्शनम् ।\nदक्षिणं च मुखं रौद्रं केनोर्ध्वं जटिलावृतम्\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2203595, "chapter_id": 5342, "verse_number": "४", "content_sanskrit": "यथादिशं महाभाग श्रोतुमिच्छामि कारणम् ।\nएष मे संशयो देव तन्मे शंसितुमर्हसि\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2203596, "chapter_id": 5342, "verse_number": "", "content_sanskrit": "महादेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2203597, "chapter_id": 5342, "verse_number": "५", "content_sanskrit": "तदहं ते प्रवक्ष्यामि यत्त्वं पृच्छसि भामिनि ।\nपुराऽसुरौ महाघोरौ लोकोद्वेगकरौ भृशम्\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2203598, "chapter_id": 5342, "verse_number": "६", "content_sanskrit": "सुन्दोपसुन्दनामानावासतुर्बहुगर्वितौ ।\nअशस्त्रवध्यौ बलिनौ परस्परहितैषिणौ\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2203599, "chapter_id": 5342, "verse_number": "७", "content_sanskrit": "तयोरेव विनाशाय निर्मिता विश्वकर्मणा ।\nमृगपक्षिगणानां च स्थावराणां तथैव च\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2203600, "chapter_id": 5342, "verse_number": "८", "content_sanskrit": "सर्वतः सारमुद्धृत्य तिलशो लोकपूजिता ।\nतिलोत्तमेति विख्याता अप्सराः सा बभूव ह\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2203601, "chapter_id": 5342, "verse_number": "९", "content_sanskrit": "देवकार्यं करिष्यन्ती हावभावसमन्विता ।\nसा तु पर्यन्तमागम्य रूपेणाप्रतिमा भुवि\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2203602, "chapter_id": 5342, "verse_number": "१०", "content_sanskrit": "मया बहुमता चेयं देवकार्यं करिष्यति ।\nइति मत्वा तदा चाहं कुर्वन्तीं मां प्रदक्षिणम् ।\nतथैव तां दिदृक्षुश्च चतुर्वक्त्रोऽभवं प्रिये\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2203603, "chapter_id": 5342, "verse_number": "११", "content_sanskrit": "ऐन्द्रं मुखमिदं पूर्वं तपश्चर्यापरं सदा ।\nदक्षिणं मे मुखं दिव्यं रौद्रं संहरति प्रजाः\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2203604, "chapter_id": 5342, "verse_number": "१२", "content_sanskrit": "लोककार्यपरं नित्यं पश्चिमं मे मुखं प्रिये ।\nवेदानधीते सततमद्भुतं चोत्तरं मुखम् ।\nएतत्ते सर्वमाख्यातं किं भूयः श्रोतुमिच्छसि\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2203605, "chapter_id": 5342, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2203606, "chapter_id": 5342, "verse_number": "१३", "content_sanskrit": "भगवन् श्रोतुमिच्छामि शूलपाणे वरप्रद ।\nकिमर्थं नीलता कण्ठे भाति बर्हनिभा तव\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2203607, "chapter_id": 5342, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2203608, "chapter_id": 5342, "verse_number": "१४", "content_sanskrit": "हन्त ते कथयिष्यामि शृणु देवि समाहिता\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2203609, "chapter_id": 5342, "verse_number": "१५", "content_sanskrit": "पुरा युगान्तरे यत्नादमृतार्थं सुरासुरैः ।\nबलवद्भिर्विमथितश्चिरकालं महोदधिः\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2203610, "chapter_id": 5342, "verse_number": "१६", "content_sanskrit": "रज्जुना नागराजेन मथ्यमाने महोदधौ ।\nविषं तत्र समुद्भूतं सर्वलोकविनाशनम्\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2203611, "chapter_id": 5342, "verse_number": "१७", "content_sanskrit": "तद् दृष्ट्वा विबुधाः सर्वे तदा विमनसोऽभवन् ।\nग्रस्तं हि तन्मया देवि लोकानां हितकारणात्\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2203612, "chapter_id": 5342, "verse_number": "१८", "content_sanskrit": "तत्कृता नीलता चासीत् कण्ठे बर्हिनिभा शुभे ।\nतदाप्रभृति चैवाहं नीलकण्ठ इति स्मृतः ।\nएतत्ते सर्वमाख्यातं किं भूयः श्रोतुमिच्छसि\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2203613, "chapter_id": 5342, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2203614, "chapter_id": 5342, "verse_number": "१९", "content_sanskrit": "नीलकण्ठ नमस्तेऽस्तु सर्वलोकसुखावह ।\nबहूनामायुधानां त्वं पिनाकं धर्तुमिच्छसि ।\nकिमर्थं देवदेवेश तन्मे शंसितुमर्हसि\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2203615, "chapter_id": 5342, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2203616, "chapter_id": 5342, "verse_number": "२०", "content_sanskrit": "शस्त्रागमं ते वक्ष्यामि शृणु धर्म्यं शुचिस्मिते ।\nयुगान्तरे महादेवि कण्वो नाम महामुनिः\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2203617, "chapter_id": 5342, "verse_number": "२१", "content_sanskrit": "स हि दिव्यां तपश्चर्यां कर्तुमेवोपचक्रमे ।\nतथा तस्य तपो घोरं चरतः कालपर्ययात् ।\nवल्मीकं पुनरुद्भूतं तस्यैव शिरसि प्रिये\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2203618, "chapter_id": 5342, "verse_number": "२२", "content_sanskrit": "वेणुर्वल्मीकसंयोगान्मूर्ध्नि तस्य बभूव ह ।\nधरमाणश्च तत्सर्वं तपश्चर्यां तथाऽकरोत्\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2203619, "chapter_id": 5342, "verse_number": "२३", "content_sanskrit": "तस्मै ब्रह्मा वरं दातुं जगाम तपसाऽर्चितः ।\nदत्त्वा तस्मै वरं देवो वेणुं दृष्ट्वा त्वचिन्तयत्\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2203620, "chapter_id": 5342, "verse_number": "२४", "content_sanskrit": "लोककार्यं समुद्दिश्य वेणुनाऽनेन भामिनि ।\nचिन्तयित्वा तमादाय कार्मुकार्थे न्ययोजयत्\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2203621, "chapter_id": 5342, "verse_number": "२५", "content_sanskrit": "विष्णोर्मम च सामर्थ्यं ज्ञात्वा लोकपितामहः ।\nधनुषी द्वे तदा प्रादाद् विष्णवे च ममैव च\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2203622, "chapter_id": 5342, "verse_number": "२६", "content_sanskrit": "पिनाकं नाम मे चापं शार्ङ्गं नाम हरेर्धनुः ।\nतृतीयमवशेषेण गाण्डीवमभवद् धनुः\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2203623, "chapter_id": 5342, "verse_number": "२७", "content_sanskrit": "तच्च सोमाय निर्दिश्य ब्रह्मा लोकं गतः पुनः ।\nएतत्ते सर्वमाख्यातं शस्त्रागममनिन्दिते\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2203624, "chapter_id": 5342, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2203625, "chapter_id": 5342, "verse_number": "२८", "content_sanskrit": "भगवन् देवदेवेश पिनाकपरशुप्रिय ।\nवाहनेषु तथाऽन्येषु सत्सु भूतपते तव\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2203626, "chapter_id": 5342, "verse_number": "२९", "content_sanskrit": "अयं तु वृषभः कस्माद् वाहनं स यथाऽभवत् ।\nएष मे संशयो देव तन्मे शंसितुमर्हसि\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2203627, "chapter_id": 5342, "verse_number": "", "content_sanskrit": "महादेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2203628, "chapter_id": 5342, "verse_number": "३०", "content_sanskrit": "तदहं ते प्रवक्ष्यामि वाहनं स यथाऽभवत्\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2203629, "chapter_id": 5342, "verse_number": "३१", "content_sanskrit": "आदिसर्गे पुरा गावः श्वेतवर्णाः शुचिस्मिते ।\nबलसंहननोपेता दर्पयुक्ताश्चरन्ति ताः\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2203630, "chapter_id": 5342, "verse_number": "३२", "content_sanskrit": "अहं तु तप आतिष्ठं तस्मिन् काले शुभानने ।\nएकपादश्चोर्ध्वबाहुर्लोकार्थं हिमवद्गिरौ\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2203631, "chapter_id": 5342, "verse_number": "३३", "content_sanskrit": "गावो मे पार्श्वमाविश्य दर्पोत्सिक्ताः समन्ततः ।\nस्थानभ्रंशं तु मे देवि चक्रिरे बहुशस्तथा\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2203632, "chapter_id": 5342, "verse_number": "३४", "content_sanskrit": "अपचारेण चैतासां मनःक्षोभोऽभवन्मम ।\nतस्माद् दग्धा यदा गावो रोषाविष्टेन चेतसा\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2203633, "chapter_id": 5342, "verse_number": "३५", "content_sanskrit": "तस्मिंस्तु व्यसने घोरे वर्तमाने पशून् प्रति ।\nअनेन वृषभेणाहं शमितः सम्प्रसादनैः\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2203634, "chapter_id": 5342, "verse_number": "३६", "content_sanskrit": "तदाप्रभृति शान्ताश्च वर्णभेदत्वमागताः ।\nश्वेतोऽयं वृषभो देवि पूर्वसंस्कारसंयुतः ।\nवाहनत्वे ध्वजत्वे मे तदाप्रभृति योजितः\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2203635, "chapter_id": 5342, "verse_number": "३७", "content_sanskrit": "तस्मान्मे गोपतित्वं च देवैर्गोभिश्च कल्पितम् ।\nप्रसन्नश्चाभवं देवि तदा गोपतितां गतः॥\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2203636, "chapter_id": 5342, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे उमामहेश्वरसंवादोपक्रमो नाम त्रिनवत्युत्तरशततमोऽध्यायः ॥१९३॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]