[{"id": 7000849000, "chapter_id": 20849, "verse_number": "६-१९२-१", "content_sanskrit": "पावर्त्युवाच ।\nउक्तं सप्तदशाध्यायगौरवं भवता शिव ।\nस त्वमष्टादशाध्यायमहिमानमुदीरय ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000849001, "chapter_id": 20849, "verse_number": "६-१९२-२", "content_sanskrit": "ईश्वर उवाच ।\nआकर्णय चिदानंद निष्पादि निगमोत्तरम् ।\nपुण्यमष्टादशाध्यायमाहात्म्यं गिरिनंदिनि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000849002, "chapter_id": 20849, "verse_number": "६-१९२-३", "content_sanskrit": "समस्तशास्त्रसर्वस्वं श्रोत्रप्राप्तं रसायनम् ।\nसंसारयातनाजालविदारणपरायणम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000849003, "chapter_id": 20849, "verse_number": "६-१९२-४", "content_sanskrit": "परं रहस्यं सिद्धानामविद्योन्मूलनक्षमम् ।\nचैतन्यं कैटभारातेरग्रगण्यं परं पदम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000849004, "chapter_id": 20849, "verse_number": "६-१९२-५", "content_sanskrit": "विवेकवल्लरीमूलं कामक्रोधमलापहम् ।\nपुरंदरादिगीर्वाणचित्तविश्रामकारकम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000849005, "chapter_id": 20849, "verse_number": "६-१९२-६", "content_sanskrit": "सनकादिमहायोगिमनोरंजनकारणम् ।\nपाठमात्रपराभूतकालकिंकरगर्जितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000849006, "chapter_id": 20849, "verse_number": "६-१९२-७", "content_sanskrit": "अष्टोत्तरशतव्याधिमूलोन्मूलनकारकम् ।\nनातः परतरं किंचिद्रहस्यं हंसगामिनि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000849007, "chapter_id": 20849, "verse_number": "६-१९२-८", "content_sanskrit": "उपतापत्रयहरं महापातकनाशनम् ।\nयथाकालेष्वहं नित्यो यथा पशुषु कामधुक् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000849008, "chapter_id": 20849, "verse_number": "६-१९२-९", "content_sanskrit": "यथा व्यासो मुनींद्रेषु व्यासेषु ब्रह्मवित्तमः ।\nयथा दिवौकसां शक्रो गुरुः शक्राद्यथा वरः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000849009, "chapter_id": 20849, "verse_number": "६-१९२-१०", "content_sanskrit": "यथा रसानां पीयूषमुत्तमं विश्वविश्रुतम् ।\nतथा गिरीणां कैलासो यथा चेंद्रो दिवौकसाम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000849010, "chapter_id": 20849, "verse_number": "६-१९२-११", "content_sanskrit": "तीर्थानां पुष्करं तीर्थं यथा पुष्पेषु पंकजम् ।\nपतिव्रतासु नारीषु यथा लोकेष्वरुंधती ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000849011, "chapter_id": 20849, "verse_number": "६-१९२-१२", "content_sanskrit": "यथा मखेष्वश्वमेधो यथोद्यानेषु नंदनम् ।\nयथारुद्रेषु सर्वेषु वीरभद्रो ममानुगः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000849012, "chapter_id": 20849, "verse_number": "६-१९२-१३", "content_sanskrit": "यथा दानेषु भूदानं यथा सिंधुषु गौतमी ।\nयथा लोके हरिक्षेत्रं प्रशस्तं धर्मकर्मसु ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000849013, "chapter_id": 20849, "verse_number": "६-१९२-१४", "content_sanskrit": "तथैवाष्टादशाध्यायमाहात्म्यं भुवनोत्तरम् ।\nतत्राख्यानमिदं पुण्यं भक्त्याकर्णय पार्वति ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000849014, "chapter_id": 20849, "verse_number": "६-१९२-१५", "content_sanskrit": "यथाकर्णनमात्रेण जंतुः पापैः प्रमुच्यते ।\nअस्ति मेरुगिरेः शृंगे पुरी रम्यामरावती ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000849015, "chapter_id": 20849, "verse_number": "६-१९२-१६", "content_sanskrit": "पुरा मम विनोदाय निर्मिता विश्वकर्मणा ।\nनिरंतरं गुणयुता कोटिगीर्वाणसेविता ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000849016, "chapter_id": 20849, "verse_number": "६-१९२-१७", "content_sanskrit": "तेजःपुंजवती साक्षाद्ब्रह्मविद्येव विश्रुता ।\nचिंतामणिशिलाबद्धाः प्रासादा यत्र कामदाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000849017, "chapter_id": 20849, "verse_number": "६-१९२-१८", "content_sanskrit": "जयंति मेरुशिखरे चतुर्मुखपुरावधि ।\nयत्र कल्पद्रुमच्छाया सुखासीना पुलोमजा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000849018, "chapter_id": 20849, "verse_number": "६-१९२-१९", "content_sanskrit": "शृणोति श्यामला गीर्भिर्गीतं गंधर्वयोषिताम् ।\nयत्रास्ते सबलारातिर्देवैश्च दलितायुषाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000849019, "chapter_id": 20849, "verse_number": "६-१९२-२०", "content_sanskrit": "दैत्यानां रक्तकल्लोलैः स्वर्धुनी शोणतां गता ।\nपुरातनसुधास्वादु स्मारं स्मारं दिवौकसः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000849020, "chapter_id": 20849, "verse_number": "६-१९२-२१", "content_sanskrit": "धयंति यत्र क्षुत्क्षामा कलां प्रत्यहमैंदवीम् ।\nतस्यां कैवल्यकल्पायामासीत्पूर्वं शतक्रतुः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000849021, "chapter_id": 20849, "verse_number": "६-१९२-२२", "content_sanskrit": "शची समन्वितः श्रीमान्सर्वगीर्वाणसेवितः ।\nस कदाचित्सुखासीनो विष्णुदूतैरधिश्रितम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000849022, "chapter_id": 20849, "verse_number": "६-१९२-२३", "content_sanskrit": "सहस्रनेत्रमायांतमपश्यत्पुरुषं परम् ।\nततस्तदीय तेजोभिरभिभूतः पुरंदरः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000849023, "chapter_id": 20849, "verse_number": "६-१९२-२४", "content_sanskrit": "मणिसिंहासनात्तूर्णं पतितः स्थानमंडपे ।\nसिंहासनात्प्रयातस्य ततस्तस्य हरेर्भटाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000849024, "chapter_id": 20849, "verse_number": "६-१९२-२५", "content_sanskrit": "गीर्वाणगणसाम्राज्य पट्टबंधं वितेनिरे ।\nअथ तस्याभिषिक्तस्य महेंद्रस्य पुलोमजा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000849025, "chapter_id": 20849, "verse_number": "६-१९२-२६", "content_sanskrit": "वामांकमारुरोहाशु दिव्यदुंदुंभिनिःस्वनैः ।\nअथ त्रिदिवसंगीत गीर्वाणाः प्रमदान्विताः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000849026, "chapter_id": 20849, "verse_number": "६-१९२-२७", "content_sanskrit": "सुरा नीराजयामासुर्दिव्यरत्नैः सुरस्त्रियः ।\nततो वै ऋषयो वेदैराशीर्वादास्तदा ददुः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000849027, "chapter_id": 20849, "verse_number": "६-१९२-२८", "content_sanskrit": "रंभाद्या ननृतुस्तस्य पुरस्तादप्सरोगणाः ।\nगंधर्वा ललितालापाञ्जगुर्मंगलकौतुकम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000849028, "chapter_id": 20849, "verse_number": "६-१९२-२९", "content_sanskrit": "एवं नूतनमिंद्रं तु जुष्टं बहुभिरुत्सवैः ।\nविना शतक्रतुं दृष्ट्वा शक्रो विस्मयमाययौ ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000849029, "chapter_id": 20849, "verse_number": "६-१९२-३०", "content_sanskrit": "न मया विहिता मार्गे तडागा न विनिर्मिताः ।\nन रोपिता महावृक्षाः पांथविश्रांतिकारकः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000849030, "chapter_id": 20849, "verse_number": "६-१९२-३१", "content_sanskrit": "न कदाचिदहो दृष्टो देवस्त्रिपुरभैरवः ।\nनिधिवासे स्थिता देवी पूजिता न मदालसा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000849031, "chapter_id": 20849, "verse_number": "६-१९२-३२", "content_sanskrit": "मेघंकरस्थितः शार्ङ्गधरो नैव निरीक्षितः ।\nन कृतं विरजे स्नानं नैवं काशीं पुरीं गतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000849032, "chapter_id": 20849, "verse_number": "६-१९२-३३", "content_sanskrit": "न देववाटिकावासी दृष्टो नरहरिः स्वयम् ।\nएरंडविष्णुर्हेरंबो न जातु परिशीलितः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000849033, "chapter_id": 20849, "verse_number": "६-१९२-३४", "content_sanskrit": "रेणुकानेक्षिता जातु माता पुरनिवासिनी ।\nन भक्त्या पूजिता देवी दाना पुरनिवासिनी ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000849034, "chapter_id": 20849, "verse_number": "६-१९२-३५", "content_sanskrit": "न भक्त्या त्रिपुरे दृष्टस्त्रिलिंगस्त्र्यंबकः स्वयम् ।\nन शार्दूलतडागस्थो वीक्षितः सोमनाथकः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000849035, "chapter_id": 20849, "verse_number": "६-१९२-३६", "content_sanskrit": "रेवापुरस्थितो देवो घुसृणेशो न वीक्षितः ।\nनागदंतपुरे ख्यातो नागनाथो न वेक्षितः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000849036, "chapter_id": 20849, "verse_number": "६-१९२-३७", "content_sanskrit": "पर्णग्रामस्थितो दृष्टो न महानमृतेश्वरः ।\nन तुंगभद्रा तीरस्थो दृष्टो हरिहरः स्वयम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000849037, "chapter_id": 20849, "verse_number": "६-१९२-३८", "content_sanskrit": "न वेंकटाद्रिनिलयः श्रीनिवासः सुलक्षितः ।\nकावेरी कर्णिकातीरे श्रीरंगो नैव वीक्षितः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000849038, "chapter_id": 20849, "verse_number": "६-१९२-३९", "content_sanskrit": "दीनास्त्वनाथाः क्रोशंतः कारागारान्न मोचिताः ।\nअन्नदानेन दौर्भिक्षे प्राणिनो नैव पूजिताः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000849039, "chapter_id": 20849, "verse_number": "६-१९२-४०", "content_sanskrit": "रात्रौ रात्रौ कृता क्वापिनिर्जले नोदकप्रभा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000849040, "chapter_id": 20849, "verse_number": "६-१९२-४१", "content_sanskrit": "न गौतम्यां कृतं स्नानं न दृष्टो हरिणेश्वरः ।\nकृष्णवेण्यां च न कृतं स्नानं कन्यागते गुरौ ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000849041, "chapter_id": 20849, "verse_number": "६-१९२-४२", "content_sanskrit": "दत्तं नो भूखंडमपि कवयो नैव पूजिताः ।\nन तीर्थेषु कृतं सत्रं न ग्रामेषु कृता मखाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000849042, "chapter_id": 20849, "verse_number": "६-१९२-४३", "content_sanskrit": "पुष्करिण्यो न विहिता मध्ये मार्गं बहूदकाः ।\nन प्रासादाः कृताः क्वापि ब्रह्मविष्णुपिनाकिनाम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000849043, "chapter_id": 20849, "verse_number": "६-१९२-४४", "content_sanskrit": "न जातुचिद्भयाक्रांता रक्षिताः शरणागताः ।\nकथमेकेन पुण्येन देवदत्तमिहार्जितम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000849044, "chapter_id": 20849, "verse_number": "६-१९२-४५", "content_sanskrit": "इति चिंताकुलो भूत्वा हरिं प्रष्टुं पुरंदरः ।\nययौ सरभसंखिन्नः क्षीरकूपारगह्वरम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000849045, "chapter_id": 20849, "verse_number": "६-१९२-४६", "content_sanskrit": "तत्र प्रविश्य गोविंदं कृतनिद्रं नवैस्तवैः ।\nअकस्मान्निजसाम्राज्यभ्रंशदुःखमुवाच ह ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000849046, "chapter_id": 20849, "verse_number": "६-१९२-४७", "content_sanskrit": "इंद्र उवाच ।\nरमाकांत भवत्प्रीत्यै कृतं क्रतुशतं पुरा ।\nतेन पुण्येन संप्राप्तं मया पौरंदरं पदम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000849047, "chapter_id": 20849, "verse_number": "६-१९२-४८", "content_sanskrit": "इदानीं नूतनः कोऽपि जातो दिवि पुरंदरः ।\nन तेन धर्मो विहितो न तेन क्रतवः कृताः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000849048, "chapter_id": 20849, "verse_number": "६-१९२-४९", "content_sanskrit": "मम सिंहासनं दिव्यं कथमाक्रांतमच्युत ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000849049, "chapter_id": 20849, "verse_number": "६-१९२-५०", "content_sanskrit": "महादेव उवाच ।\nइत्येवं वदतस्तस्य श्रुत्वा वाचं रमापतिः ।\nउन्मीलितस्मिताक्षो सावुवाच मधुरं वचः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000849050, "chapter_id": 20849, "verse_number": "६-१९२-५१", "content_sanskrit": "श्रीभगवानुवाच ।\nकिं दानैरल्पफलदैः किं तपोभिः किमध्वरैः ।\nवर्त्तमानः क्षितितले सत्वं प्रीणितवान्पुरा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000849051, "chapter_id": 20849, "verse_number": "६-१९२-५२", "content_sanskrit": "इन्द्र उवाच ।\nभगवन्कर्मणा केन स त्वां प्रीणितवान्द्विजः ।\nयत्प्रीत्या भगवान्प्रादात्तस्मै पौरंदरं पदम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000849052, "chapter_id": 20849, "verse_number": "६-१९२-५३", "content_sanskrit": "श्रीभगवानुवाच ।\nजपत्यष्टादशाध्याये गीतानां श्लोकपंचकम् ।\nयत्पुण्येन च संप्राप्तं तव साम्राज्यमुत्तमम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000849053, "chapter_id": 20849, "verse_number": "६-१९२-५४", "content_sanskrit": "सर्वपुण्यशिरोरत्न भूतेन त्वं स्थिरो भव ।\nइति विष्णोर्वचः श्रुत्वा ज्ञातोपायं पुरंदरः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000849054, "chapter_id": 20849, "verse_number": "६-१९२-५५", "content_sanskrit": "विप्रवेषधरो भूत्वा गतो गोदावरीतटम् ।\nतत्रापश्यत्पुरं पुण्यं कालिकाग्राममुत्तमम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000849055, "chapter_id": 20849, "verse_number": "६-१९२-५६", "content_sanskrit": "यत्र कालेश्वरो देवो वर्त्तते कालमर्दनः ।\nतत्र गोदावरी तीरे स्थितं परमधार्मिकम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000849056, "chapter_id": 20849, "verse_number": "६-१९२-५७", "content_sanskrit": "अपश्यत्करुणावंतं ब्राह्मणं वेदपारगम् ।\nनित्यमष्टादशाध्यायं जपंतं दांतचेतसम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000849057, "chapter_id": 20849, "verse_number": "६-१९२-५८", "content_sanskrit": "ततस्तच्चरणद्वंद्वे लुठित्वा परया मुदा ।\nसत्वमष्टादशाध्यायमपठत्तेन शिक्षितम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000849058, "chapter_id": 20849, "verse_number": "६-१९२-५९", "content_sanskrit": "अथ पुण्येन तेनाऽसौ विष्णोः सायुज्यमाययौ ।\nहित्वा पुरंदरादीनां देवानां पदमल्पकम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000849059, "chapter_id": 20849, "verse_number": "६-१९२-६०", "content_sanskrit": "ज्ञात्वातीव मुदायुक्तो वैकुंठमगमत्पुरम् ।\nअतएव परं तत्वं मुनीनामिदमुत्तमम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000849060, "chapter_id": 20849, "verse_number": "६-१९२-६१", "content_sanskrit": "दिव्यमष्टादशाध्यायमाहात्म्यं कथितं मया ।\nयस्य श्रवणमात्रेण सर्वपापैः प्रमुच्यते ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000849061, "chapter_id": 20849, "verse_number": "६-१९२-६२", "content_sanskrit": "इत्येवं गीतामाहात्म्यं कथितं पापनाशनम् ।\nपुण्यं पवित्रमायुष्यं स्वर्ग्यं स्वस्त्ययनं महत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000849062, "chapter_id": 20849, "verse_number": "६-१९२-६३", "content_sanskrit": "यः शृणोति महाभागे श्रद्धया संयुतः पुमान् ।\nसर्वयज्ञफलं प्राप्य विष्णोः सायुज्यमाप्नुयात् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]