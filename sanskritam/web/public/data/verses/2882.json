[{"id": 2088453, "chapter_id": 2882, "verse_number": "१३-१२-१", "content_sanskrit": "युधिष्ठिर उवाच।\nयथैव ते नमस्कार्याः प्रोक्ताः शक्रेण मानद।\nएतन्मे सर्वमाचक्ष्व येभ्यः स्पृहयसे नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088454, "chapter_id": 2882, "verse_number": "१३-१२-२", "content_sanskrit": "उत्तमापद्गतस्यापि यत्र ते वर्तते मनः।\nमनुष्यलोके सर्वस्मिन्यदमुत्रेह चाप्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088455, "chapter_id": 2882, "verse_number": "१३-१२-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088456, "chapter_id": 2882, "verse_number": "१३-१२-३", "content_sanskrit": "स्पृहयामि द्विजातिभ्यो येषां ब्रह्म परं धनम्।\nयेषां संप्रत्ययः स्वर्गस्तपःस्वाध्यायसाधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088457, "chapter_id": 2882, "verse_number": "१३-१२-४", "content_sanskrit": "येषां बालाश्च वृद्धाश्च पितृपैतामहीं धुरम्।\nउद्वहन्ति न सीदन्ति तेभ्यो वै स्पृहयाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088458, "chapter_id": 2882, "verse_number": "१३-१२-५", "content_sanskrit": "विद्यास्वभिविनीतानां दान्तानां मृदुभाषिणाम्।\nश्रुतवृत्तोपपन्नानां सदाऽक्षरविदां सताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088459, "chapter_id": 2882, "verse_number": "१३-१२-६", "content_sanskrit": "संसत्सु वदतां तात हंसानामिव सङ्घशः।\nमङ्गल्यरूपा रुचिरा दिव्यजीमूतनिःस्वनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088460, "chapter_id": 2882, "verse_number": "१३-१२-७", "content_sanskrit": "सम्यगुच्चरिता वाचः श्रूयन्ते हि युधिष्ठिर।\nशुश्रूषमाणे नृपतौ प्रेत्य चेह सुखावहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088461, "chapter_id": 2882, "verse_number": "१३-१२-८", "content_sanskrit": "ये चापि तेषां श्रोतारः सदा सदसि सम्मताः।\nविज्ञानगुणसम्पन्नास्तेभ्यश्च स्पृहयाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088462, "chapter_id": 2882, "verse_number": "१३-१२-९", "content_sanskrit": "सुसंस्कृतानि प्रयताः शुचीनि गुणवन्ति च।\nददत्यन्नानि तृप्त्यर्थं ब्राह्मणेभ्यो युधिष्ठर।\nये चापि सततं राजंस्तेभ्यश्च स्पृहयाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088463, "chapter_id": 2882, "verse_number": "१३-१२-१०", "content_sanskrit": "शक्यं ह्येवाहवे योद्धुं न दातुमनसूयितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088464, "chapter_id": 2882, "verse_number": "१३-१२-११", "content_sanskrit": "शूरा वीराश्च शतशः सन्ति लोके युधिष्ठिर।\nतेषां संख्यायमानानां दानशूरो विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088465, "chapter_id": 2882, "verse_number": "१३-१२-१२", "content_sanskrit": "`भद्रं तु जन्म सम्प्राप्य भूयो ब्राह्मणको भवेत्।\nबन्धुमध्ये कुले जातः सुदुरापमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088466, "chapter_id": 2882, "verse_number": "१३-१२-१३", "content_sanskrit": "धन्यः स्यां यद्यहं भूयः सौम्यब्राह्मणकोपि वा।\nकुले जातो धर्मगतिस्तपोविद्यापरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088467, "chapter_id": 2882, "verse_number": "१३-१२-१४", "content_sanskrit": "न मे त्वत्तः प्रियतरो लोकेऽस्मिन्पाण्डुनन्दन।\nत्वत्तश्चापि प्रियतरा ब्राह्मणा एव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2088468, "chapter_id": 2882, "verse_number": "१३-१२-१५", "content_sanskrit": "यथा मम प्रियतमास्त्वत्तो विप्राः कुरूत्तम।\nतेन सत्येन गच्छेयं लोकान्यत्र स शन्तनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2088469, "chapter_id": 2882, "verse_number": "१३-१२-१६", "content_sanskrit": "न मे पिता प्रियतरो ब्रह्मणेभ्यस्तथाऽभवत्।\nन मे पितुः पिता वाऽपि ये चान्येऽपि सुहृञ्जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2088470, "chapter_id": 2882, "verse_number": "१३-१२-१७", "content_sanskrit": "न हि मे वृजिनं किञ्चिद्विद्यते ब्राह्मणेष्विह।\nअणु वा यदि वा स्थूलं विद्यते साधुकर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2088471, "chapter_id": 2882, "verse_number": "१३-१२-१८", "content_sanskrit": "कर्मणा मनसा वाऽपि वाचा वाऽपि परंतप।\nयन्मे कृतं ब्राह्मणेभ्यस्तेनाद्य न तपाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2088472, "chapter_id": 2882, "verse_number": "१३-१२-१९", "content_sanskrit": "ब्रह्मण्य इति मामाहुस्तया वाचाऽस्मि तोषितः।\nएतदेव पवित्रेभ्यः सर्वेभ्यः परमं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2088473, "chapter_id": 2882, "verse_number": "१३-१२-२०", "content_sanskrit": "पश्यामि लोकानमलाञ्शुचीन्ब्राह्मणतोषणात्।\nतेषु मे तात गन्तव्यमह्नाय च चिराय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2088474, "chapter_id": 2882, "verse_number": "१३-१२-२१", "content_sanskrit": "यथा भर्त्राश्रयो धर्मः स्त्रीणां लोके युदिष्ठिर।\nस देवः सा गतिर्नान्या क्षत्रियस्य तथा द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2088475, "chapter_id": 2882, "verse_number": "१३-१२-२२", "content_sanskrit": "क्षत्रियः शतवर्षी च दशवर्षी द्विजोत्तमः।\nपितापुत्रौ च विज्ञेयौ तयोर्हि ब्राह्मणो गुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2088476, "chapter_id": 2882, "verse_number": "१३-१२-२३", "content_sanskrit": "नारी तु पत्यभावे वै देवरं कुरुते पतिम्।\nपृथिवी ब्राह्मणालाभे क्षत्रियं कुरुते पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2088477, "chapter_id": 2882, "verse_number": "१३-१२-२४", "content_sanskrit": "`ब्राह्मणानुज्ञया ग्राह्यं राज्यं च सपुरोहितैः।\nतद्रक्षणेन स्वर्गोऽस्य तत्कोपान्नरकोऽक्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2088478, "chapter_id": 2882, "verse_number": "१३-१२-२५", "content_sanskrit": "पुत्रवच्चैव ते रक्ष्या उपास्या गुरुवच्च ते।\nअग्निवच्चोपचार्या वै ब्राह्मणाः कुरुसत्तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2088479, "chapter_id": 2882, "verse_number": "१३-१२-२६", "content_sanskrit": "ऋजुन्सतः सत्यशीलान्सर्वभूतहिते रतान्।\nआशीविषानिव क्रुद्धान्द्विजान्परिचरेत्सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2088480, "chapter_id": 2882, "verse_number": "१३-१२-२७", "content_sanskrit": "तेजसस्तपसश्चैव नित्यं बिभ्येद्युधिष्ठिर।\nउभे चैते परित्याज्ये तेजश्चैव तपस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2088481, "chapter_id": 2882, "verse_number": "१३-१२-२८", "content_sanskrit": "व्यवसायस्तयोः शीघ्रमुभयोरेव विद्यते।\nहन्युः क्रुद्धा महाराज ब्राह्मणा ये तपस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2088482, "chapter_id": 2882, "verse_number": "१३-१२-२९", "content_sanskrit": "`दूरतो मातृवत्पूज्या विप्रदाराः सुरक्षया।\nअकोपनापराधेन भूयो नरकमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2088483, "chapter_id": 2882, "verse_number": "१३-१२-३०", "content_sanskrit": "भूयः स्यादुभयं दत्तं ब्राह्मणाद्यदकोपनात्।\nकुर्यादुभयतः शेषं दत्तशेषं न शेषयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2088484, "chapter_id": 2882, "verse_number": "१३-१२-३१", "content_sanskrit": "दण्डपाणिर्यथा गोष्ठं पालो नित्यं हि रक्षयेत्।\nब्राह्मणेषु स्थितं ब्रह्म क्षत्रियः परिपालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2088485, "chapter_id": 2882, "verse_number": "१३-१२-३२", "content_sanskrit": "पितेव पुत्रान्रक्षेथा ब्राह्मणान्ब्रह्मतेजसः।\nगृहे चैषामवेक्षेथाः किंस्विदस्तीति जीवनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2088486, "chapter_id": 2882, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि द्वादशोऽध्यायः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]