[{"id": 2092777, "chapter_id": 2975, "verse_number": "१३-१०५-१", "content_sanskrit": "भीष्म उवाच।\nअत्रैव कीर्त्यते सद्भिर्ब्राह्मणस्वाभिमर्शने।\nनृगेण सुमहत्कृच्छ्रुं यदवाप्तं कुरूद्वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2092778, "chapter_id": 2975, "verse_number": "१३-१०५-२", "content_sanskrit": "निविशन्त्यां पुरा पार्थ द्वारवत्यामिति श्रुतिः।\nअदृश्यत महाकूपस्तृणवीरुत्समावृतः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2092779, "chapter_id": 2975, "verse_number": "१३-१०५-३", "content_sanskrit": "प्रयत्नं तत्र कुर्वाणास्तस्मात्कूपाज्जलार्थिनः।\nश्रमेण महता युक्तास्तस्मिंस्तोये सुसंवृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2092780, "chapter_id": 2975, "verse_number": "१३-१०५-४", "content_sanskrit": "ददृशुस्ते महाकायं कृकलासमवस्थितम्।\nतस्य चोद्धरणे यत्नमकुर्वंस्ते सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2092781, "chapter_id": 2975, "verse_number": "१३-१०५-५", "content_sanskrit": "प्रग्रहैश्चर्मपट्टैश्च तं बद्ध्वा पर्वतोपमम्।\nनाशक्नुवन्समुद्धर्तुं ततो जग्मुर्जनार्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2092782, "chapter_id": 2975, "verse_number": "१३-१०५-६", "content_sanskrit": "खमावृत्योदपानस्य कृकलासः स्थितो महान्।\nतस्य नास्ति समुद्धर्तेत्येतत्कृष्णे न्यवेदयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2092783, "chapter_id": 2975, "verse_number": "१३-१०५-७", "content_sanskrit": "स वासुदेवेन समुद्धृतश्च\nपृष्टश्च कामान्निजगाद राजा।\nनृगस्तदाऽऽत्मानमथो न्यवेदय-\nत्पुरातनं यज्ञसहस्रयाजिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2092784, "chapter_id": 2975, "verse_number": "१३-१०५-८", "content_sanskrit": "तथा ब्रुवाणं तु तमाह माधवः\nशुभं त्वया कर्म कृतं न पापकम्।\nकथं भवान्दुर्गतिमीदृशीं गतो\nनरेन्द्र तद्ब्रूहि किमेतदीदृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2092785, "chapter_id": 2975, "verse_number": "१३-१०५-९", "content_sanskrit": "शतं सहस्राणि गवां शतं पुनः\nपुनः शतान्यष्टशतायुतानि।\nनृप द्विजेभ्यः क्व नु तद्गतं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2092786, "chapter_id": 2975, "verse_number": "१३-१०५-१०", "content_sanskrit": "नृगस्ततोऽब्रवीत्कृष्णं ब्राह्मणस्याग्निहोत्रिणः।\nप्रोषितस्य परिभ्रष्टा गौरेका मम गोधने*****॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2092787, "chapter_id": 2975, "verse_number": "१३-१०५-११", "content_sanskrit": "गवां सहस्रे संख्याता तदा सा पशुपैर्मम।\nसा ब्राह्मणाय मे दत्ता प्रेत्यार्थमभिकाङ्क्षता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2092788, "chapter_id": 2975, "verse_number": "१३-१०५-१२", "content_sanskrit": "अपश्यत्परिमार्गंश्च तां गां परगृहे द्विजः।\nममेयमिति चोवाच ब्राह्मणो यस्य साऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2092789, "chapter_id": 2975, "verse_number": "१३-१०५-१३", "content_sanskrit": "तावुभौ समनुप्राप्तौ विवदन्तौ भृशज्वरौ।\nभवान्दाता भवान्हर्तेत्यथ तौ मामवोचताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2092790, "chapter_id": 2975, "verse_number": "१३-१०५-१४", "content_sanskrit": "शतेन शतसङ्ख्येन गवां विनिमयेन वै।\nयाचे प्रतिग्रहीतारं स तु मामब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2092791, "chapter_id": 2975, "verse_number": "१३-१०५-१५", "content_sanskrit": "देशकालोपसम्पन्ना दोग्ध्री शान्ताऽतिवत्सला।\nस्वादुक्षीरप्रदा धन्या मम नित्यं निवेशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2092792, "chapter_id": 2975, "verse_number": "१३-१०५-१६", "content_sanskrit": "कृशं च भरते सा गौर्मम पुत्रमपस्तनम्।\nन सा शक्या मया दातुमित्युक्त्वा स जगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2092793, "chapter_id": 2975, "verse_number": "१३-१०५-१७", "content_sanskrit": "ततस्तमपरं विप्रं याचे विनिमयेन वै।\nगवां शतसहस्रं हि तत्कृते गृह्यतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2092794, "chapter_id": 2975, "verse_number": "१३-१०५-१८x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2092795, "chapter_id": 2975, "verse_number": "१३-१०५-१८", "content_sanskrit": "न राज्ञां प्रतिगृह्णामि शक्तोऽहं स्वस्य मार्गणे।\nसैव गौर्दीयतां शीघ्रं ममेति मधुसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2092796, "chapter_id": 2975, "verse_number": "१३-१०५-१९", "content_sanskrit": "रुक्ममश्वांश्च ददतो रजतस्यन्दनांस्तथा।\nन जग्राह ययौ चापि तदा स ब्राह्मणर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2092797, "chapter_id": 2975, "verse_number": "१३-१०५-२०", "content_sanskrit": "एतस्मिन्नेव काले तु चोदितः कालधर्मणा।\nपितृलोकमहं प्राप्य धर्मराजमुपागमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2092798, "chapter_id": 2975, "verse_number": "१३-१०५-२१", "content_sanskrit": "यमस्तु पूजयित्वा मां ततो वचनमब्रवीत्।\nनान्तः सङ्ख्यायते राजंस्तव पुण्यस्य कर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2092799, "chapter_id": 2975, "verse_number": "१३-१०५-२२", "content_sanskrit": "अस्ति चैव कृतं पापमज्ञानात्तदपि त्वया।\nचरस्व पापं पश्चाद्वा पूर्वं वा त्वं यथेच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2092800, "chapter_id": 2975, "verse_number": "१३-१०५-२३", "content_sanskrit": "रक्षितास्मीति चोक्तं ते प्रतिज्ञा चानृता तव।\nब्राह्मणस्वस्य चादानं द्विविधस्ते व्यतिक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2092801, "chapter_id": 2975, "verse_number": "१३-१०५-२४", "content_sanskrit": "पूर्वं कृच्छं चरिष्येऽहं पश्चाच्छुभमिति प्रभो।\nधर्मराजं ब्रुवन्नेवं पतितोस्मि महीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2092802, "chapter_id": 2975, "verse_number": "१३-१०५-२५", "content_sanskrit": "अश्रौषं पतितश्चाहं यमस्योच्चैः प्रभाषतः।\nवासुदेवः समुद्धर्ता भविता ते जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2092803, "chapter_id": 2975, "verse_number": "१३-१०५-२६", "content_sanskrit": "पूर्णे वर्षसहस्रान्ते क्षीणे कर्मणि दुष्कृते।\nप्राप्लस्यसे शाश्वताँल्लोकाञ्जितान्स्वेनैव कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2092804, "chapter_id": 2975, "verse_number": "१३-१०५-२७", "content_sanskrit": "कूपेऽऽत्मानमधःशीर्षमपश्यं पतितं च ह।\nतिर्यग्योनिमनुप्राप्तं न च मामजहात्स्मृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2092805, "chapter_id": 2975, "verse_number": "१३-१०५-२८", "content_sanskrit": "त्वया तु तारितोऽस्म्यद्य किमन्यत्र तपोबलात्।\nअनुजानीहि मां कृष्ण गच्छेयं दिवमद्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2092806, "chapter_id": 2975, "verse_number": "१३-१०५-२९", "content_sanskrit": "अनुज्ञातः स कृष्णेन नमस्कृत्य जनार्दनम्।\nविमानं दिव्यमास्थाय ययौ दिवमरिन्दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2092807, "chapter_id": 2975, "verse_number": "१३-१०५-३०", "content_sanskrit": "ततस्तस्मिन्दिवं याते नृगे भरतसत्तम।\nवासुदेव इमाञ्श्लोकाञ्जगाद कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2092808, "chapter_id": 2975, "verse_number": "१३-१०५-३१", "content_sanskrit": "ब्राह्मणस्वं न हर्तव्यं पुरुषेण विजानता।\nब्राह्मणस्वं हृतं हन्ति नृगं ब्राह्मणगौरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2092809, "chapter_id": 2975, "verse_number": "१३-१०५-३२", "content_sanskrit": "सतां समागमः सद्भिर्नाफलः पार्थ विद्यते।\nविमुक्तं नरकात्पश्य नृगं साधुसमागमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2092810, "chapter_id": 2975, "verse_number": "१३-१०५-३३", "content_sanskrit": "प्रदानं फलवत्तत्र द्रोहस्तत्र तथाऽफलः।\nअपहारं गवां तस्माद्वर्जयेत युधिष्ठिर॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2092811, "chapter_id": 2975, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पञ्चाधिकशततमोऽध्यायः॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]