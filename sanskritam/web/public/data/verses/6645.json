    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20007047,
    "chapter_id": 6645,
    "verse_number": "15.78",
    "content_sanskrit": "परितश्च धौतमुखरुक्मविलसदहिमांशुमण्डलाः । तेनुरतनुवपुषः पृथिवीं स्फुटलक्ष्यतेजस इवात्मजाः श्रियः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
