    "avatarnika": ""
  },
  {
    "id": 20007053,
    "chapter_id": 6645,
    "verse_number": "15.84",
    "content_sanskrit": "विपुलाचलस्थलघनेन जिगमिषुभिरङ्गनाः प्रियैः । पीनकुचतटनिपीडदलद्वरवारबाणमुरसालिलिङ्गिरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
