    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20007051,
    "chapter_id": 6645,
    "verse_number": "15.82",
    "content_sanskrit": "भृशमङ्गसादकरुणत्वमविशददृशः कपोलयोः । वाक्यमसकलमपास्य मदं विदधुस्तदीयगुणमात्मना शुचः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
