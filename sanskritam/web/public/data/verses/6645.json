  {
    "id": 20007055,
    "chapter_id": 6645,
    "verse_number": "15.86",
    "content_sanskrit": "प्रविवत्सतः प्रियतमस्य निगडमिव चक्षुरक्षिपत् । नीलनलिनदलदामरुचि प्रतिपादयुग्ममचिरोढसुन्दरी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20007056,
    "chapter_id": 6645,
    "verse_number": "15.87",
    "content_sanskrit": "व्रजतः क्व तात व्रजसीति परिचयगतार्थमस्फुटम् । धैर्यमभिनदुदितं शिशुना जननीनिर्भत्सनविवृद्धमन्युना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
