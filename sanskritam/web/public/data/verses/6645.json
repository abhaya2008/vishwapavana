    "avatarnika": ""
  },
  {
    "id": 20007059,
    "chapter_id": 6645,
    "verse_number": "15.90",
    "content_sanskrit": "सह कज्जलेन विरराज नयनकमलाम्बुसन्ततिः । गण्डफलकमभितः सुतनोः पदवीव शोकमयकृष्णवर्त्मनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20007060,
    "chapter_id": 6645,
    "verse_number": "15.91",
    "content_sanskrit": "क्षणमात्ररोधि चलितेन कतिपयपदं नतभ्रुवः । स्रस्तभुजयुगगलद्वलयस्वनितं प्रतिक्षुतमिवोपशुश्रुवे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  },
  {
    "id": 20007061,
    "chapter_id": 6645,
    "verse_number": "15.92",
    "content_sanskrit": "अभिवर्त्म वल्लभतमस्य विगलदमलायतांशुका । भूमिनभसि रभसेन यती विरराज काचन समं महोल्कया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 92,
    "avatarnika": ""
  },
  {
    "id": 20007062,
    "chapter_id": 6645,
    "verse_number": "15.93",
    "content_sanskrit": "समरोन्मुखे नृपगणेऽपि तदनुमरणोद्यतैकधीः । दीनपरिजनकृताश्रुजलो न भटीजनः स्थिरमनाः विचक्लमे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "avatarnika": ""
  },
  {
    "id": 20007063,
    "chapter_id": 6645,
    "verse_number": "15.94",
    "content_sanskrit": "विदुषीव दर्शनममुष्य युवतिरतिदुर्लभं पुनः । यान्तमनिमिषमतृप्तमनाः पतिमीक्षते स्म भृशया दृशः पथः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 94,
    "avatarnika": ""
  },
  {
    "id": 20007064,
    "chapter_id": 6645,
    "verse_number": "15.95",
    "content_sanskrit": "सम्प्रत्युपेयाः कुशली पुनर्युधः सस्नेहमाशीरिति भर्तुरीरिता । सद्यः प्रसह्य द्वितयेन नेत्रयोः प्रत्याचचक्षे गलता भटस्त्रियाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 95,
    "avatarnika": ""
  },
  {
    "id": 20007065,
    "chapter_id": 6645,
    "verse_number": "15.96",
    "content_sanskrit": "काचित्कीर्णा रजोभिर्दिवमनुविदधे भिन्नवक्त्रेन्दुलक्ष्मीरश्रीकाः काश्चिदन्तर्दिश इव दधिरे दाहमुद्भ्रान्तसत्वाः । भ्रेमुर्वात्या इवान्याः प्रतिपदमपरा भूमिवत्कम्पमापुः प्रस्थाने पार्थिवानामशिवमिति पुरो भावि नार्यः शशंसुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
