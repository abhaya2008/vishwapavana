    "avatarnika": ""
  },
  {
    "id": 20007048,
    "chapter_id": 6645,
    "verse_number": "15.79",
    "content_sanskrit": "प्रधिमण्डलोद्धतपरागघनवलयमध्यवर्तिनः । पेतुरशनाय इवाशनकैर्गुरुनिःस्वनव्यथितजन्तवो रथाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20007049,
    "chapter_id": 6645,
    "verse_number": "15.80",
    "content_sanskrit": "दधतः शशाङ्कितशशाङ्करुचि लसदुरश्छदं वपुः । चक्रुरथ सह पुरन्धिजनैरयथार्थसिद्धिं सरकं महीभृतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20007050,
    "chapter_id": 6645,
    "verse_number": "15.81",
    "content_sanskrit": "दयिताय सासवमुदस्तमपतदवसादिनः करात् । कांस्यमुपहितसरोजपतद्भ्रमरौघभारगुरु राजयोषितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
