    "avatarnika": ""
  },
  {
    "id": 20007054,
    "chapter_id": 6645,
    "verse_number": "15.85",
    "content_sanskrit": "न मुमोच लोचनजलानि दयितजयमङ्गलैषिणि । यातमवनिभवसन्नभुजान्न गलद्विवेद वलयं विलासिनी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
