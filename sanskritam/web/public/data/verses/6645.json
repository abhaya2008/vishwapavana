    "avatarnika": ""
  },
  {
    "id": 20007058,
    "chapter_id": 6645,
    "verse_number": "15.89",
    "content_sanskrit": "ध्रियमाणमप्यगलदश्रु चलति दयिते नतभ्रुवः । स्नेहमकृतकरसं दधतामिदमेव युक्तमतिमुग्धचेतसाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
