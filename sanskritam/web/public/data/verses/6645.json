    "avatarnika": ""
  },
  {
    "id": 20007043,
    "chapter_id": 6645,
    "verse_number": "15.74",
    "content_sanskrit": "सहसा ससभ्रमविलोलसकलजनतासमाकुलम् । स्थानमगमदथ तत्परितश्चलितोडुमण्डलनभःस्थलोपमाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20007044,
    "chapter_id": 6645,
    "verse_number": "15.75",
    "content_sanskrit": "दधतो भयानकतरत्वमुपगतवतः समानताम् । धूमपटलपिहितस्य गिरेः समवर्मयन्सपदि मेदिनीभृतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20007045,
    "chapter_id": 6645,
    "verse_number": "15.76",
    "content_sanskrit": "परिमोहिणा परिजनेन कथमपि चिरादुपाहृतम् । वर्म करतलयुगेन महत्तनुचूर्णपेषमपिषद्रुषा परः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20007046,
    "chapter_id": 6645,
    "verse_number": "15.77",
    "content_sanskrit": "रणसंमदोदयविकासिबलकलकलाकुलीकृते । शारिमशकधिरोपयितुं द्विरदे मदच्युति जनः कथञ्चन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
