    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20007057,
    "chapter_id": 6645,
    "verse_number": "15.88",
    "content_sanskrit": "शठ नाकलोकललनाभिरविरतरतं रिरंससे । तेन वहसि मुदमित्यवदद्रणरागिणं रमणमीर्ष्ययापरा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
