    "avatarnika": ""
  },
  {
    "id": 20007052,
    "chapter_id": 6645,
    "verse_number": "15.83",
    "content_sanskrit": "सुदृशः समीकगमनाय युवभिरथ संबभाषिरे । शोकपिहितगलरुद्धगिरस्तरसागताश्रुजलकेवलोत्तराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
