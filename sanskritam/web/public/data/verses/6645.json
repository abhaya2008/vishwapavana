[
  {
    "id": 20006970,
    "chapter_id": 6645,
    "verse_number": "15.1",
    "content_sanskrit": "अथतत्र पाण्डुतनयेन सदसि विहितं मुरद्विषः । मानमसहत न चेदिपतिः परवृद्धिमत्सरि मनो हि मानिनाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20006971,
    "chapter_id": 6645,
    "verse_number": "15.2",
    "content_sanskrit": "पुर एव शार्ङ्गिणि सवैरमथ पुनरमुं तदर्चया । मन्युरभजदवगाढतरः समदोषकाल इव देहिनं ज्वरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20006972,
    "chapter_id": 6645,
    "verse_number": "15.3",
    "content_sanskrit": "अभितर्जयन्निव समस्तनृपगणमसावकम्पयत् । लोलमुकुटमणिरश्मि शनैरशनैः प्रकम्पितजगत्त्रयं शिरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20006973,
    "chapter_id": 6645,
    "verse_number": "15.4",
    "content_sanskrit": "स वमन्रुषाश्रु घनघर्मविगलदुरुगण्डमण्डलः । स्वेदजलकणकरालकरो व्यरुचत्प्रभिन्न इव कुञ्जरस्त्रिधा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20006974,
    "chapter_id": 6645,
    "verse_number": "15.5",
    "content_sanskrit": "स निकामघर्मितमभीक्ष्णमधुवदवधूतराजकः । क्षिप्तबहुलजलबिन्दु वपुः प्रलयार्णवोत्थित इवादिशूकरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20006975,
    "chapter_id": 6645,
    "verse_number": "15.6",
    "content_sanskrit": "क्षणमाश्लिषद्द्घटितशैलशिखरकठिनांसमण्डनः । स्तम्भमुपहितविधूतिमसावधिकावधूनितसमस्तसंसदम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20006976,
    "chapter_id": 6645,
    "verse_number": "15.7",
    "content_sanskrit": "कनकाङ्गदद्युतिभिरस्य गमितमरुचत्पिशङ्गताम् । क्रोधमयशिखिशिखापटलैः परितः परीतमिव बाहुमण्डलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20006977,
    "chapter_id": 6645,
    "verse_number": "15.8",
    "content_sanskrit": "कृतसन्निधानमिव तस्य पुनरपि तृतीयचक्षुषा । क्रूरमजनि कुटिलभ्रु गुरुभ्रुकुटीकठोरितललाटमाननम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20006978,
    "chapter_id": 6645,
    "verse_number": "15.9",
    "content_sanskrit": "अतिरक्तभावमुपगम्य कृतमतिरमुष्य साहसे । दृष्टिरगणितभयासिलतामलम्बते स्म सभया सखीमिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20006979,
    "chapter_id": 6645,
    "verse_number": "15.10",
    "content_sanskrit": "करकुड्मलेन निजमूरुमुरुतरनगाश्मकर्कशम् । त्रस्तचपलचलमानजनश्रुतभीमनादमयमाहतोच्चकैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20006980,
    "chapter_id": 6645,
    "verse_number": "15.11",
    "content_sanskrit": "इति चक्रुधे भृशमनेन ननु महदवाप्य विप्रियम् । याति विकृतिमपि संवृतिमत्किमु यन्निसर्गनिरवग्रहं मनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20006981,
    "chapter_id": 6645,
    "verse_number": "15.12",
    "content_sanskrit": "प्रथमं शरीरजविकारकृतमुकुलबन्धमव्यथी । भाविकलहफलयोगमसौ वचनेन कोपकुसुमं व्यचीकसत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20006982,
    "chapter_id": 6645,
    "verse_number": "15.13",
    "content_sanskrit": "ध्वनयन्सभामथ सनीरघनरवगभीरवागभीः । वाचमवददतिरोषवशादतिनिष्ठुरस्फुटतराक्षरमसौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20006983,
    "chapter_id": 6645,
    "verse_number": "15.14",
    "content_sanskrit": "यदपूपुजस्त्वमिह पार्थ मुरजितमपूजितं सताम् । प्रेम विलसति महत्तदहो दयितं जनः खलु गुणीति मन्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20006984,
    "chapter_id": 6645,
    "verse_number": "15.15",
    "content_sanskrit": "यदराज्ञि राजवदिहार्घ्यमुपहितमिदं मुरद्विषि । ग्राम्यमृग इव हविस्तदयं भजते ज्वलत्सु न महीशवह्निषु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20006985,
    "chapter_id": 6645,
    "verse_number": "15.16",
    "content_sanskrit": "अनृतां गिरं न गदसीति जगति पटहैर्विघुष्यसे । निन्द्यमथ च हरिमर्चयतस्तव कर्मणैव विकसत्यसत्यता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20006986,
    "chapter_id": 6645,
    "verse_number": "15.17",
    "content_sanskrit": "तव धर्मराज इति नाम कथमिदमपष्ठु पठ्यते । भौमदिनमभिदधत्यथवा भृशमप्रशस्तमपि मङ्गलं जनाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20006987,
    "chapter_id": 6645,
    "verse_number": "15.18",
    "content_sanskrit": "यदि वार्चनीयतम एष किमपि भवतां पृथासुताः । शौरिरवनिपतिभिर्निखिलैरवमाननार्थमिह किं निमन्त्रितैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20006988,
    "chapter_id": 6645,
    "verse_number": "15.19",
    "content_sanskrit": "अथवा न धर्ममसुबोधसमयमवयात बालिशाः । खाममयमिह वृथापालितो हतबुद्धिरप्रणिहितः सरित्सुतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20006989,
    "chapter_id": 6645,
    "verse_number": "15.20",
    "content_sanskrit": "स्वयमेव शन्तनुतनूज यमपि गणमर्घ्यमभ्यधाः । तत्र मुररिपुरयं कतमो यमनिन्द्यबन्दिवदभिष्टुषे वृथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20006990,
    "chapter_id": 6645,
    "verse_number": "15.21",
    "content_sanskrit": "अवनीभृतां त्वमपहाय गणमतिजडः समुन्नतम् । नीचि नियतमिह यच्चपलो निरतः स्फुटं भवसि निम्नगासुतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20006991,
    "chapter_id": 6645,
    "verse_number": "15.22",
    "content_sanskrit": "प्रतिपत्तुमङ्ग घटते च न तव नृपयोग्यमर्हणम् । कृष्ण कलय ननु कोऽहमिति स्फुटमापदां पदमनात्मवेदिता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20006992,
    "chapter_id": 6645,
    "verse_number": "15.23",
    "content_sanskrit": "असुरस्त्वया न्यवधि कोऽपि मधुरिति कथं प्रतीयते । दण्डदलितसरघः प्रथसे मधुसूदनस्त्वमिति सूदयन्मधु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20006993,
    "chapter_id": 6645,
    "verse_number": "15.24",
    "content_sanskrit": "मुचुकुन्दतल्पशरणस्य मगधपतिशातितौजसः । सिद्धमबल सबलत्वमहो तव रोहिणीततनयसाहचर्यतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20006994,
    "chapter_id": 6645,
    "verse_number": "15.25",
    "content_sanskrit": "छलयन्प्रजास्त्वमनृतेन कपटपटुरैन्द्रजालिकः । प्रीतिमनुभवसि नग्नजितः सुतयेष्टसत्य इति सम्प्रतीयसे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20006995,
    "chapter_id": 6645,
    "verse_number": "15.26",
    "content_sanskrit": "धृतवान्न चक्रमरिचक्रभयचकितमाहवे निजम् । चक्रधर इति रथाङ्गमदः सततं बिभर्षि भुवनेषु रूढये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20006996,
    "chapter_id": 6645,
    "verse_number": "15.27",
    "content_sanskrit": "जगति श्रिया विरहितोऽपि यदुदधिसुतामुपायथाः । ज्ञातिजनजनितनामपदां त्वमतः श्रियः पतिरिति प्रथामगाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20006997,
    "chapter_id": 6645,
    "verse_number": "15.28",
    "content_sanskrit": "अभिशत्रु संयति कदाचिदविहितपराक्रमोऽपि यत् । व्योम्नि कथमपि चकर्थ पदं व्यपदिश्यते जगति विक्रमीत्यतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20006998,
    "chapter_id": 6645,
    "verse_number": "15.29",
    "content_sanskrit": "पृथिवीं बिभर्थ यदि पूर्वमिदमपि गुणाय वर्तते । भूमिभृदिति परहारितभूस्त्वमुदाह्रियस्व कथमन्यथा जनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20006999,
    "chapter_id": 6645,
    "verse_number": "15.30",
    "content_sanskrit": "तव धन्यतेयमपि सर्वनृपतितुलितोऽपि यत्क्षणम् । क्लान्तकरतलधृताचलकः पृथिवीतले तुलितभूभृदुच्यसे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20007000,
    "chapter_id": 6645,
    "verse_number": "15.31",
    "content_sanskrit": "त्वमशक्नुवन्न शुभकर्मनिरतः परिपाकदारुणम् । जेतुमकुशलमतिर्नरकं यशसेऽधिलोकमजयः सुतं भुवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20007001,
    "chapter_id": 6645,
    "verse_number": "15.32",
    "content_sanskrit": "सकलैर्वपुः सकलदोषसमुदितमिदं गुणैस्तव । त्यक्तमपगुण गुणस्त्रितयत्यजनप्रयासमुपयासि किं मुधा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20007002,
    "chapter_id": 6645,
    "verse_number": "15.33",
    "content_sanskrit": "त्वयि पूजनं जगति जाल्म कृतमिदमपाकृते गुणैः । हासकरमघटते नितरां शिरसीव कङ्कतमपेतमूर्धजे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20007003,
    "chapter_id": 6645,
    "verse_number": "15.34",
    "content_sanskrit": "मृगविद्विषामिव यदित्थमजनि मिषतां पृथासुतैः । अस्य वनशुन इवापचितिः परिभाव एव भवतां भुवोऽधिपाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20007004,
    "chapter_id": 6645,
    "verse_number": "15.35",
    "content_sanskrit": "अवधीज्जनङ्गम इवैष यदि हतवृषो वृषं ननु । स्पर्शमशुचिवपुरर्हति न प्रतिमाननां तु नितरां नृपोचिताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20007005,
    "chapter_id": 6645,
    "verse_number": "15.36",
    "content_sanskrit": "यदि नाङ्गनेति मतिरस्य मृदुरजनि पूतनां प्रति । स्तन्यमघृणमनसः पिबतः किल धर्मतो भवति सा जनन्यपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20007006,
    "chapter_id": 6645,
    "verse_number": "15.37",
    "content_sanskrit": "शकटव्युदासतरुभङ्गधरणिधरधारणादिकम् । कर्म यदयमकरोत्तरलः स्थिरचेतसां क इव तेन विस्मयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20007007,
    "chapter_id": 6645,
    "verse_number": "15.38",
    "content_sanskrit": "अयमुग्रसेनतनयस्य नृपशुरपरः पशूनवन् । स्वमिवधमसुकरं पुरुषैः कुरुते स्म यत्परममेतदद्भुतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20007008,
    "chapter_id": 6645,
    "verse_number": "15.39",
    "content_sanskrit": "इतिवाचमुद्धतमुदीर्य सपदि सह वेणुदारिणा । सोढरिपुबलभरोऽसहनः स जहास दत्तकरतालमुच्चकैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20007009,
    "chapter_id": 6645,
    "verse_number": "15.40",
    "content_sanskrit": "कटुनापि चैद्यवचनेन विकृतिमगमन्न माधवः । सत्यनियतवचसं वचसा सुजनं जनाश्चलयितुं क ईशते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20007010,
    "chapter_id": 6645,
    "verse_number": "15.41",
    "content_sanskrit": "न चतं तदेति शपमानमपि यदुनृपाः प्रचुक्रुधुः । शौरिसमयनिगृहीतधियः प्रभुचित्तमेव हि जनोऽनुवर्तते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20007011,
    "chapter_id": 6645,
    "verse_number": "15.42",
    "content_sanskrit": "विहितागसो मुहुरसङ्घ्यनिजवचनदामसंयतः । तस्य कतिथ इति तत्प्रथमं मनसा समाख्यदपराधमच्युतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20007012,
    "chapter_id": 6645,
    "verse_number": "15.43",
    "content_sanskrit": "स्मृतिवर्त्म तस्य न समस्तमपकृतमियाय विद्विषः । स्मर्तुमधिगतगुणस्मरणाः पटवो न दोषमखिलं खलूत्तमाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20007013,
    "chapter_id": 6645,
    "verse_number": "15.44",
    "content_sanskrit": "नृपतावधिक्षिपति शौरिमथ सुरसरित्सुतो वचः । स्माह चलयति भुवं मरुति क्षुभितस्य नादमनुकुर्वदम्बुधेः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20007014,
    "chapter_id": 6645,
    "verse_number": "15.45",
    "content_sanskrit": "अथ गौरवेण परिवादमपरिगणयंस्तमात्मनः । प्राह मुररिपुतिरस्करणक्षुभितः स्म वाचमिति जाह्नवीसुतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20007015,
    "chapter_id": 6645,
    "verse_number": "15.46",
    "content_sanskrit": "विहितं मयाद्य सदसीदमपमृषितमच्युतार्चनम् । यस्य नमयतु स चापमयं चरणः कृतः शिरसि सर्वभूभृताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20007016,
    "chapter_id": 6645,
    "verse_number": "15.47",
    "content_sanskrit": "इतिभीष्मभाषितवचोर्ऽथमधिगतवतामिव क्षणात् । क्षोभमगमदतिमात्रमथो शिशुपालपक्षपृथिवीभृतां गणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20007017,
    "chapter_id": 6645,
    "verse_number": "15.48",
    "content_sanskrit": "शितितारकानुमितताम्रनयनमरुणीकृतं क्रुधा । बाणवदनमुददीपि भिये जगतः सकीलमिव सूर्यमण्डलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20007018,
    "chapter_id": 6645,
    "verse_number": "15.49",
    "content_sanskrit": "प्रविदारितारुणतरोग्रनयनकुसुमोज्ज्वलः स्फुरन् । प्रातरहिमकरताम्रतनुर्विषजद्रुमोऽपर इवाभवद्द्रुमः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20007019,
    "chapter_id": 6645,
    "verse_number": "15.50",
    "content_sanskrit": "अनिशान्तवैरदहनेन विरहितवतान्तरार्द्रताम् । कोपमरुदभिहितेन भृशं नरकात्मजेन तरुणेव जज्वले ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20007020,
    "chapter_id": 6645,
    "verse_number": "15.51",
    "content_sanskrit": "अभिधित्सतः किमपि राहुवदनविकृतं व्यभाव्यत । ग्रस्तशशधरमिवोपलसत्सितदन्तपङ्क्ति मुखमुत्तमौजसः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20007021,
    "chapter_id": 6645,
    "verse_number": "15.52",
    "content_sanskrit": "कुपिताकृतिं प्रथममेव हसितमशनैरसूचयत् । क्रुद्धमशनिदलिताद्रितटध्वनि दन्तवक्रमरिचक्रभीषणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20007022,
    "chapter_id": 6645,
    "verse_number": "15.53",
    "content_sanskrit": "प्रतिघः कुतोऽपि समुपेत्य नरपतिगणं समाश्रयत् । जामिहरणजनितानुशयः समुदाचचार निज एव रुक्मिणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20007023,
    "chapter_id": 6645,
    "verse_number": "15.54",
    "content_sanskrit": "चरणेन हन्ति सुबलः स्म शिथिलितमहीध्रबन्धनाम् । तीरतरलजलराशिजलामवभुग्नभोगिफणमण्डलां भुवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20007024,
    "chapter_id": 6645,
    "verse_number": "15.55",
    "content_sanskrit": "कुपितेषु राजषु तथापि रथचरणपाणिपूजया । चित्तकलितकलहागमनो मुदमाहुकिः सुहृदिवाधिकां दधौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20007025,
    "chapter_id": 6645,
    "verse_number": "15.56",
    "content_sanskrit": "गुरुकोपरुद्धपदमापदसितयवनस्य रोद्रताम् । व्यात्तमशितुमिव सर्वजगद्विकरालमास्यकुहरं विवक्षतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20007026,
    "chapter_id": 6645,
    "verse_number": "15.57",
    "content_sanskrit": "विवृतोरुबाहुपरिघेण सरभसपदं निधित्सता । हन्तुमखिलनृपतीन्वसुना वसने विलम्बिनि निजे विचस्खले ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20007027,
    "chapter_id": 6645,
    "verse_number": "15.58",
    "content_sanskrit": "इति तत्तदा विकृतरूपमभजत्तदविभिन्नचेतसम् । मारबलमिव भयङ्करतां हरिबोधिसत्वमभि राजमण्डलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20007028,
    "chapter_id": 6645,
    "verse_number": "15.59",
    "content_sanskrit": "रमसादुदस्थुरथ युद्धमनुचितभियोऽभिलाषुकाः । सान्द्रमुकुटकिरणोच्छलितस्फटिकांशवः सदसि मेदिनीभृतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20007029,
    "chapter_id": 6645,
    "verse_number": "15.60",
    "content_sanskrit": "स्फुरमाणनेत्रकुसुमोष्ठदलमभृतभूभृदङ्घ्रिपैः । धूतपृथुभुजलतं चलितैर्द्रुतवातपातवनविभ्रमं सदः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20007030,
    "chapter_id": 6645,
    "verse_number": "15.61",
    "content_sanskrit": "हरिमप्यमंसत तृणाय कुरुपतिमजीगणन्न वा । मानतुलितभुवनत्रितयाः सरितः सुतादबिभयुर्नभूभृतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20007031,
    "chapter_id": 6645,
    "verse_number": "15.62",
    "content_sanskrit": "गुरुनिःश्वसन्नथ विलोलसदवथुवपुर्वचोविषम् । कीर्णदशनकिरणाग्निकणः फणवानिवैष विससर्ज चेदिपः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20007032,
    "chapter_id": 6645,
    "verse_number": "15.63",
    "content_sanskrit": "किमहो नृपाः समममीभिरुपपतिसुतैर्न पञ्चभिः । वध्यमभिहत भुजिष्यममुं सह चानया स्थविरराजकन्यया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20007033,
    "chapter_id": 6645,
    "verse_number": "15.64",
    "content_sanskrit": "अथवाध्वमेव खलु यूयमगणितमरुद्गणौजसः । वस्तु कियदिदमयं न मृधे मम केवलमस्य मुखमीक्षितुं क्षमः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20007034,
    "chapter_id": 6645,
    "verse_number": "15.65",
    "content_sanskrit": "विदतुर्यमुत्तमशेषपरिषदि नदीजधर्मजौ । यातु निकषमधियुद्धमसौ वचनेन किं भवतु साध्वसाधु वा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20007035,
    "chapter_id": 6645,
    "verse_number": "15.66",
    "content_sanskrit": "अचिरान्मया सह गतस्य समरमुरगारिलक्ष्मणः । तीक्ष्णविशिखमुखपीतमसृक्पततां गणैः पिबतु सार्धमुर्वरा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20007036,
    "chapter_id": 6645,
    "verse_number": "15.67",
    "content_sanskrit": "अभिधाय रूक्षमिति मा स्म गम इति पृथासुतेरिताम् । वाचमनुनयपरां स ततः सहसावकर्ण्य निरियाय संसदः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20007037,
    "chapter_id": 6645,
    "verse_number": "15.68",
    "content_sanskrit": "गृहमागताय कृपया च कथमपि निसर्गदक्षिणाः । क्षान्तिमहितमनसो जननीस्वसुरात्मजाय चुकुपुर्न पाण्डवाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20007038,
    "chapter_id": 6645,
    "verse_number": "15.69",
    "content_sanskrit": "चलितं ततोऽनभिहतेच्छमवनिपतियज्ञभूमितः । तूर्णमथ ययुमिवानुययुर्दमघोषसूनुमवनीशसूनवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20007039,
    "chapter_id": 6645,
    "verse_number": "15.70",
    "content_sanskrit": "विशिखान्तराण्यतिपपात सपदि जवनैः स वाजिभिः । द्रष्टुमलघुरभसापातिता वनिताश्चकार न सकामचेतसः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20007040,
    "chapter_id": 6645,
    "verse_number": "15.71",
    "content_sanskrit": "क्षणमीक्षतः पथि जनेन किमिदमिति जल्पता मिथः । प्राप्य शिबिरमविशङ्किमनाः समनीनहद्द्रुतमनीकिनीमसौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20007041,
    "chapter_id": 6645,
    "verse_number": "15.72",
    "content_sanskrit": "त्वरमाणशाङ्खिकसवेगवदनपवनाभिपूरितः । शैलकटकतटभिन्नरवः प्रणनाद सांनहनिकोऽस्य वारिजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20007042,
    "chapter_id": 6645,
    "verse_number": "15.73",
    "content_sanskrit": "जगदन्तकालसमवेतविषदविषमेरितारवम् । धीरनिजरवविलीनगुरुप्रतिशब्दमस्य रणतूर्यमावधि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
