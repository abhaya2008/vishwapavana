[{"id": 6000052000, "chapter_id": 10052, "verse_number": null, "content_sanskrit": "अथ द्वाविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000052001, "chapter_id": 10052, "verse_number": null, "content_sanskrit": "विदुर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.001.m4a", "display_order": 2}, {"id": 6000052002, "chapter_id": 10052, "verse_number": "३-२२-१", "content_sanskrit": "स्वायम्भुवस्य च मनोर्वंशः परमसम्मतः।\nकथ्यतां भगवन् यत्र मैथुनेनैधिरे प्रजाः॥ ३/२२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.002.m4a", "display_order": 3, "topics": [{"text": "मध्ये त्रुटितां स्वायम्भुवमनुकथां वक्तुं विदुरप्रार्थितेन मैत्रेयेण तत्कथनारम्भः", "range": "१–५"}]}, {"id": 6000052003, "chapter_id": 10052, "verse_number": "३-२२-२", "content_sanskrit": "प्रियव्रतोत्तानपादौ सुतौ स्वायम्भुवस्य वै।\nयथाधर्मं जुगुपतुः सप्तद्वीपवतीं महीम्॥ ३/२२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.003.m4a", "display_order": 4}, {"id": 6000052004, "chapter_id": 10052, "verse_number": "३-२२-३", "content_sanskrit": "तस्य वै दुहिता ब्रह्मन् देवहूतीति विश्रुता।\nपत्नी प्रजापतेरुक्ता कर्दमस्य त्वयाऽनघ॥ ३/२२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.004.m4a", "display_order": 5}, {"id": 6000052005, "chapter_id": 10052, "verse_number": "३-२२-४", "content_sanskrit": "तस्यां स वै महायोगी युक्तायां योगलक्षणैः।\nससर्ज कतिधा वीर्यं तन्मे शुश्रूषवे वद॥ ३/२२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.005.m4a", "display_order": 6}, {"id": 6000052006, "chapter_id": 10052, "verse_number": "३-२२-५", "content_sanskrit": "रुचिर्यो भगवान् ब्रह्मन् दक्षो वा ब्रह्मणः सुतः।\nयथा ससर्ज भूतानि लब्ध्वा भार्यां च मानवीम्॥ ३/२२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.006.m4a", "display_order": 7}, {"id": 6000052007, "chapter_id": 10052, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.007.m4a", "display_order": 8}, {"id": 6000052008, "chapter_id": 10052, "verse_number": "३-२२-६", "content_sanskrit": "प्रजाः सृजेति भगवान् कर्दमो ब्रह्मणोदितः।\nसरस्वत्यां तपस्तेपे सहस्राणां समा दश॥ ३/२२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.008.m4a", "display_order": 9, "topics": [{"text": "ब्रह्मणा प्रजासर्जनं चोदितेन कर्दमेन सरस्वतीतीरे भगवदुद्देशेन तपश्चरणम्", "range": "६–२२"}]}, {"id": 6000052009, "chapter_id": 10052, "verse_number": "३-२२-७", "content_sanskrit": "ततः समाधियुक्तेन क्रियायोगेन कर्दमः।\nसम्प्रपेदे हरिं भक्त्या प्रपन्नवरदाशुषम्॥ ३/२२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.009.m4a", "display_order": 10}, {"id": 6000052010, "chapter_id": 10052, "verse_number": "३-२२-८", "content_sanskrit": "तावत् प्रसन्नो भगवान् पुष्कराक्षः कृते युगे।\nदर्शयामास तं क्षत्तः शाब्दं ब्रह्म दधद् वपुः॥ ३/२२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.010.m4a", "display_order": 11}, {"id": 6000052011, "chapter_id": 10052, "verse_number": "३-२२-९", "content_sanskrit": "स तं विरजमर्काभं सितपद्मोत्पलस्रजम्।\nस्निग्धनीलालकव्रातवक्त्राब्जविरजाम्बरम्॥ ३/२२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.011.m4a", "display_order": 12}, {"id": 6000052012, "chapter_id": 10052, "verse_number": "३-२२-१०", "content_sanskrit": "किरीटिनं कुण्डलिनं शङ्खचक्रगदाधरम्।\nश्वेतोत्पलक्रीडनकं मनःस्पर्शस्मितेक्षणम्॥ ३/२२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.012.m4a", "display_order": 13}, {"id": 6000052013, "chapter_id": 10052, "verse_number": "३-२२-११", "content_sanskrit": "विन्यस्तचरणाम्भोजमंसदेशे गरुत्मतः।\nदृष्ट्वा खेऽवस्थितं वक्षःश्रियं कौस्तुभकन्धरम्॥ ३/२२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.013.m4a", "display_order": 14}, {"id": 6000052014, "chapter_id": 10052, "verse_number": "३-२२-१२", "content_sanskrit": "जातहर्षोऽपतन्मूर्ध्ना क्षितौ लब्धमनोरथः।\nगीर्भिस्त्वभ्यगृणात् प्रीतः स्वभावात्मा कृताञ्जलिः १२॥ ३/२२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.014.m4a", "display_order": 15}, {"id": 6000052015, "chapter_id": 10052, "verse_number": null, "content_sanskrit": "कर्दम उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.015.m4a", "display_order": 16}, {"id": 6000052016, "chapter_id": 10052, "verse_number": "३-२२-१३", "content_sanskrit": "जुष्टं बताद्याखिलसत्त्वराशेः संसिद्धमक्ष्णोस्तव दर्शनान्नः।\nयद् दर्शनं जन्मभिरीड्य सद्भिराशासते योगिनो रूढयोगाः॥ ३/२२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.016.m4a", "display_order": 17}, {"id": 6000052017, "chapter_id": 10052, "verse_number": "३-२२-१४", "content_sanskrit": "ये मायया ते हतचेतसस्त्वत्पादारविन्दं भवसिन्धुपोतम्।\nउपासते कामलवाय तेषां रासीश कामान् निरयेऽपि ये स्युः॥ ३/२२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.017.m4a", "display_order": 18}, {"id": 6000052018, "chapter_id": 10052, "verse_number": "३-२२-१५", "content_sanskrit": "तथा स चाहं परिवोढुकामः समानशीलां गृहमेधिधेनुम्।\nउपेयिवान् मूलमशेषमूलं दुराशयः कामदुघाङ्घ्रिपस्य॥ ३/२२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.018.m4a", "display_order": 19}, {"id": 6000052019, "chapter_id": 10052, "verse_number": "३-२२-१६", "content_sanskrit": "प्रजापतेस्ते वचसाऽधीश तन्त्या लोकः किलायं कामहेतोर्निबद्धः।\nअहं च लोकानुगतो वहामि बलिं च शुक्लानिमिषाय तुभ्यम्॥ ३/२२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.019.m4a", "display_order": 20}, {"id": 6000052020, "chapter_id": 10052, "verse_number": "३-२२-१७", "content_sanskrit": "लोकांश्च लोकानुगतानसूंश्च हित्वा श्रितास्ते चरणातपत्रम्।\nपरस्परं त्वद्गुणवादसीधुपीयूषनिर्यापितदेहधर्माः॥ ३/२२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.020.m4a", "display_order": 21}, {"id": 6000052021, "chapter_id": 10052, "verse_number": "३-२२-१८", "content_sanskrit": "न तेऽजराक्षभ्रमिरायुरेषां त्रयोदशारं त्रिशतं षष्टिपर्व।\nषण्णेम्यनन्तच्छिदि यत् त्रिनाभि करालस्रोतो जगदाच्छिद्य धावत्॥ ३/२२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.021.m4a", "display_order": 22}, {"id": 6000052022, "chapter_id": 10052, "verse_number": "३-२२-१९", "content_sanskrit": "एकः स्वयं सन् जगतः सिसृक्षया द्वितीययाऽऽत्मन्नधियोगमायया।\nसृजस्यदः पासि पुनर्ग्रहीष्यसे यथोर्णनाभिर्भगवन् स्वशक्तिभिः॥ ३/२२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.022.m4a", "display_order": 23}, {"id": 6000052023, "chapter_id": 10052, "verse_number": "३-२२-२०", "content_sanskrit": "नैतद् बताधीश पदं तवेप्सितं यन्मायया त्वं जगृहे भूतसूक्ष्मम्।\nअनुग्रहाय त्वयि यर्हि मालया लसत्तुलस्या भगवान् विलक्षितः॥ ३/२२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.023.m4a", "display_order": 24}, {"id": 6000052024, "chapter_id": 10052, "verse_number": "३-२२-२१", "content_sanskrit": "तं त्वाऽनुभूत्योपरतक्रियार्थं स्वमायया वर्तितलोकतन्त्रम्।\nनमाम्यभीक्ष्णं नमनीयपादसरोजमल्पीयसि कामवर्षम्॥ ३/२२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.024.m4a", "display_order": 25}, {"id": 6000052025, "chapter_id": 10052, "verse_number": null, "content_sanskrit": "शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.025.m4a", "display_order": 26}, {"id": 6000052026, "chapter_id": 10052, "verse_number": "३-२२-२२", "content_sanskrit": "इत्यव्यलीकं प्रणतोऽब्जनाभस्तमाबभाषे वचसाऽमृतेन।\nसुपर्णपक्षोपरि रोचमानः प्रेमस्मितोद्वीक्षणविभ्रमद्‌भ्रूः॥ ३/२२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.026.m4a", "display_order": 27}, {"id": 6000052027, "chapter_id": 10052, "verse_number": null, "content_sanskrit": "भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.027.m4a", "display_order": 28}, {"id": 6000052028, "chapter_id": 10052, "verse_number": "३-२२-२३", "content_sanskrit": "विदित्वा तव चैत्यं मे पुरैव सुनियोजितम्।\nयदर्थमात्मनियमैस्त्वयैवाहं समर्चितः॥ ३/२२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.028.m4a", "display_order": 29, "topics": [{"text": "अपरोक्षीभूतेन श्रीनारायणेन स्वायंभुवमनुपुत्र्या देवहूत्याः परिणये आज्ञादानम्, बिन्दुसरसः वर्णनम्", "range": "२३–३२"}]}, {"id": 6000052029, "chapter_id": 10052, "verse_number": "३-२२-२४", "content_sanskrit": "न वै जातु मृषेदं स्यात् प्रजाध्यक्ष मदर्हणम्।\nभवद्विधेष्वतितरां सङ्गृहीतात्मनां मयि॥ ३/२२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.029.m4a", "display_order": 30}, {"id": 6000052030, "chapter_id": 10052, "verse_number": "३-२२-२५", "content_sanskrit": "प्रजापतिपतिः सम्राट् मनुर्विख्यातमङ्गलः।\nब्रह्मावर्तं योऽधिवसन् शास्ति सप्तार्णवां महीम्॥ ३/२२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.030.m4a", "display_order": 31}, {"id": 6000052031, "chapter_id": 10052, "verse_number": "३-२२-२६", "content_sanskrit": "स चेह विप्र राजर्षिर्महिष्या शतरूपया।\nआयास्यति दिदृक्षुस्त्वां परश्वो धर्मकोविदः॥ ३/२२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.031.m4a", "display_order": 32}, {"id": 6000052032, "chapter_id": 10052, "verse_number": "३-२२-२७", "content_sanskrit": "आत्मजामसितापाङ्गीं वयःशीलगुणान्विताम्।\nमृगयन्तीं पतिं दास्यत्यनुरूपाय ते प्रभुः॥ ३/२२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.032.m4a", "display_order": 33}, {"id": 6000052033, "chapter_id": 10052, "verse_number": "३-२२-२८", "content_sanskrit": "समाहितं ते हृदयं यत्रेमान् परिवत्सरान्।\nसा त्वां ब्रह्मन् नृपवधूः काममाशु भजिष्यति॥ ३/२२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.033.m4a", "display_order": 34}, {"id": 6000052034, "chapter_id": 10052, "verse_number": "३-२२-२९", "content_sanskrit": "या त आत्मधृतं वीर्यं नवधा प्रसविष्यति।\nवीर्ये त्वदीय ऋषय आधास्यंस्तेज आत्मनः॥ ३/२२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.034.m4a", "display_order": 35}, {"id": 6000052035, "chapter_id": 10052, "verse_number": "३-२२-३०", "content_sanskrit": "त्वं च सर्वमनुष्ठीय निर्देशं मुनिसत्तम।\nमयि तीर्थीकृताशेषक्रियार्थो मां प्रपत्स्यसे॥ ३/२२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.035.m4a", "display_order": 36}, {"id": 6000052036, "chapter_id": 10052, "verse_number": "३-२२-३१", "content_sanskrit": "कृत्वा दयां च जीवेषु दत्त्वा चाभयमात्मवान्।\nमय्यात्मानं सह जगद् द्रक्षस्यात्मनि चापि माम्॥ ३/२२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.036.m4a", "display_order": 37}, {"id": 6000052037, "chapter_id": 10052, "verse_number": "३-२२-३२", "content_sanskrit": "सम्भूय स्वांशकलया त्वद्वीर्येण महामुने।\nतव क्षेत्रे देवहूत्यां प्रणेष्ये तत्त्वसंहिताम्॥ ३/२२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.037.m4a", "display_order": 38}, {"id": 6000052038, "chapter_id": 10052, "verse_number": "३-२२-३३", "content_sanskrit": "एवं तमनुभाष्याथ भगवान् प्रत्यगक्षगः।\nजगाम बिन्दुसरसः सरस्वत्या परिश्रितात्॥ ३/२२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.038.m4a", "display_order": 39}, {"id": 6000052039, "chapter_id": 10052, "verse_number": "३-२२-३४", "content_sanskrit": "निरीक्षतस्तस्य यथावशेषसिद्धेश्वराभिष्टुतसिद्धमार्गः।\nआकर्णयन् पत्ररथेन्द्रपत्रैरुच्चारितं स्तोममुदीर्णसाम॥ ३/२२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.039.m4a", "display_order": 40}, {"id": 6000052040, "chapter_id": 10052, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.040.m4a", "display_order": 41}, {"id": 6000052041, "chapter_id": 10052, "verse_number": "३-२२-३५", "content_sanskrit": "एवं सम्प्रस्थिते शुक्ले कर्दमो भगवान् ऋषिः।\nआस्ते स्म बिन्दुसरसि तं कालं प्रतिपालयन्॥ ३/२२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.041.m4a", "display_order": 42}, {"id": 6000052042, "chapter_id": 10052, "verse_number": "३-२२-३६", "content_sanskrit": "मनुः स्यन्दनमास्थाय शातकौम्भपरिच्छदम्।\nआरोप्य स्वां दुहितरं सभार्यः पर्यटन् महीम्॥ ३/२२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.042.m4a", "display_order": 43}, {"id": 6000052043, "chapter_id": 10052, "verse_number": "३-२२-३७", "content_sanskrit": "तस्मिन् सुधन्वन्नहनि भगवान् यत् समादिशत्।\nउपायादाश्रमपदं मनुः शान्तव्रतस्य तत्॥ ३/२२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.043.m4a", "display_order": 44}, {"id": 6000052044, "chapter_id": 10052, "verse_number": "३-२२-३८", "content_sanskrit": "यस्मिन् भगवतो नेत्रान्न्यपतन् हर्षबिन्दवः।\nकृपया सम्परीतस्य प्रपन्नेऽर्पितया भृशम्॥ ३/२२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.044.m4a", "display_order": 45}, {"id": 6000052045, "chapter_id": 10052, "verse_number": "३-२२-३९", "content_sanskrit": "तद् वै बिन्दुसरो नाम सरस्वत्या परिप्लुतम्।\nपुण्यं शिवामृतजलं महर्षिगणसेवितम्॥ ३/२२/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.045.m4a", "display_order": 46}, {"id": 6000052046, "chapter_id": 10052, "verse_number": "३-२२-४०", "content_sanskrit": "पुण्यद्रुमलताजालैः कूजत्पुण्यमृगद्विजैः।\nसर्वर्तुफलपुष्पाढ्यं वनराजिश्रियाऽन्वितम्॥ ३/२२/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.046.m4a", "display_order": 47}, {"id": 6000052047, "chapter_id": 10052, "verse_number": "३-२२-४१", "content_sanskrit": "मत्तद्विजगणोद्धुष्टं मत्तभ्रमरविभ्रमम्।\nमत्तबर्हिनटाटोपमाह्वयन्मत्तकोकिलम्॥ ३/२२/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.047.m4a", "display_order": 48}, {"id": 6000052048, "chapter_id": 10052, "verse_number": "३-२२-४२", "content_sanskrit": "कदम्बचम्पकाशोककरञ्जबकुलासनैः।\nकुन्दमन्दारकुटजैश्चूतपोतैरलंकृतम्॥ ३/२२/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.048.m4a", "display_order": 49}, {"id": 6000052049, "chapter_id": 10052, "verse_number": "३-२२-४३", "content_sanskrit": "कारण्डवैर्बकैर्हंसैः कुररैर्जलकुक्कुटैः।\nसारसैश्चक्रवाकैश्च चकोरैर्वल्गुकूजितम्॥ ३/२२/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.049.m4a", "display_order": 50}, {"id": 6000052050, "chapter_id": 10052, "verse_number": "३-२२-४४", "content_sanskrit": "शशकैर्हरिणैः क्रोडैः श्वविड्गवयकुञ्जरैः।\nगोपुच्छैर्हरिभिर्मर्कैर्नकुलैर्नाभिभिर्वृतम्॥ ३/२२/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.050.m4a", "display_order": 51}, {"id": 6000052051, "chapter_id": 10052, "verse_number": "३-२२-४५", "content_sanskrit": "प्रविश्य तत् तीर्थवरमादिराजः सहानुगः।\nददर्श मुनिमासीनं तस्मिन् हुतहुताशनम्॥ ३/२२/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.051.m4a", "display_order": 52, "topics": [{"text": "परेद्यवि भार्यया शतरूपया पुत्र्या देवहूत्या च सह स्वायंभुवमनोः कर्दमाश्रमगमनम्, संवादश्च", "range": "४५–५६"}]}, {"id": 6000052052, "chapter_id": 10052, "verse_number": "३-२२-४६", "content_sanskrit": "विद्योतमानं वपुषा तपस्युग्रयुजा चिरम्।\nनातिक्षामं भगवतः स्निग्धापाङ्गविलोकनात्॥ ३/२२/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.052.m4a", "display_order": 53}, {"id": 6000052053, "chapter_id": 10052, "verse_number": "३-२२-४७", "content_sanskrit": "तद्व्याहृतामृतकलापीयूषश्रवणेन च।\nप्रांशुं पद्मपलाशाक्षं जटिलं चीरवाससम्॥ ३/२२/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.053.m4a", "display_order": 54}, {"id": 6000052054, "chapter_id": 10052, "verse_number": "३-२२-४८", "content_sanskrit": "उपसंसृत्य मलिनं यथार्हणमसंस्कृतम्। अथोटजमुपायान्तं नृदेवं प्रणतं पुरः।\nसपर्यया प्रत्यगृह्णात् प्रतिनन्द्यानुरूपया॥ ३/२२/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.054.m4a", "display_order": 55}, {"id": 6000052055, "chapter_id": 10052, "verse_number": "३-२२-४९", "content_sanskrit": "गृहीतार्हणमासीनं संयतं प्रीणयन् मुनिः।\nस्मरन् भगवदादेशमित्याह श्लक्ष्णया गिरा॥ ३/२२/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.055.m4a", "display_order": 56}, {"id": 6000052056, "chapter_id": 10052, "verse_number": "३-२२-५०", "content_sanskrit": "नूनं चङ्क्रमणं देव सतां संरक्षणाय ते।\nवधाय चासतां यस्त्वं हरेः शक्तिर्हि पालिनी॥ ३/२२/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.056.m4a", "display_order": 57}, {"id": 6000052057, "chapter_id": 10052, "verse_number": "३-२२-५१", "content_sanskrit": "योऽर्केन्द्वग्नीन्द्रवायूनां यमधर्मप्रचेतसाम्।\nरूपाणि स्थान आधत्से तस्मै शुक्लात्मने नमः॥ ३/२२/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.057.m4a", "display_order": 58}, {"id": 6000052058, "chapter_id": 10052, "verse_number": "३-२२-५२", "content_sanskrit": "न यदा रथमास्थाय जैत्रं मणिगणार्पितम्।\nविस्फुरच्चण्डकोदण्डो रथेन त्रासयन्नघान्॥ ३/२२/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.058.m4a", "display_order": 59}, {"id": 6000052059, "chapter_id": 10052, "verse_number": "३-२२-५३", "content_sanskrit": "स्वसैन्यचरणक्षुण्णं वेपयन् मण्डलं भुवः।\nविकर्षन् बृहतीं सेनां पर्यटस्यंशुमानिव॥ ३/२२/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.059.m4a", "display_order": 60}, {"id": 6000052060, "chapter_id": 10052, "verse_number": "३-२२-५४", "content_sanskrit": "तदैव सेतवः सर्वे वर्णाश्रमनिबन्धनाः।\nभगवद्रचिता राजन् भिद्येरन् बत दस्युभिः॥ ३/२२/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.060.m4a", "display_order": 61}, {"id": 6000052061, "chapter_id": 10052, "verse_number": "३-२२-५५", "content_sanskrit": "अधर्मश्च समेधेत लोलुपैर्व्यङ्कुशैर्नृभिः।\nशयाने त्वयि लोकोऽयं दस्युग्रस्तो विनङ्क्षति॥ ३/२२/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.061.m4a", "display_order": 62}, {"id": 6000052062, "chapter_id": 10052, "verse_number": "३-२२-५६", "content_sanskrit": "अथापि पृच्छे त्वां वीर यदर्थं त्वमिहागतः।\nतद् वयं निर्व्यलीकेन प्रतिपद्यामहे हृदा॥ ३/२२/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_022/BhP_03.022.062.m4a", "display_order": 63}, {"id": 6000052063, "chapter_id": 10052, "verse_number": null, "content_sanskrit": "इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे द्वाविंशध्यायः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]