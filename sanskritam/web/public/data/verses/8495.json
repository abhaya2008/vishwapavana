[{"id": 900006497, "chapter_id": 8495, "verse_number": "76.1", "content_sanskrit": "ॐ अन्यथानुमितौ च ज्ञशक्तिवियोगात् ॐ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900006498, "chapter_id": 8495, "verse_number": "76.2", "content_sanskrit": "अङ्गित्वं यदि तस्यैव स्वातन्त्र्यं चेन्न चाखिलम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900006499, "chapter_id": 8495, "verse_number": "76.3", "content_sanskrit": "न च स्वातन्त्र्यमस्यैव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900006500, "chapter_id": 8495, "verse_number": "76.4", "content_sanskrit": "तस्माच्च्छतिप्रमाणेन युक्तिभिश्च परो हरिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]