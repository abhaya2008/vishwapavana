[{"id": 2054529, "chapter_id": 2196, "verse_number": "७-१२३-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2054530, "chapter_id": 2196, "verse_number": "७-१२३-१", "content_sanskrit": "ततो दुःशासनो राजञ्शैनेयं समुपाद्रवत्।\nकिरञ्शरसहस्राणि पर्जन्य इव वृष्टिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2054531, "chapter_id": 2196, "verse_number": "७-१२३-२", "content_sanskrit": "स विद्व्वा सात्यकिं षष्ट्या तथा षोडशभिः शरैः।\nनाकम्पयत्स्थितं युद्धे मैनाकमिव पर्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2054532, "chapter_id": 2196, "verse_number": "७-१२३-३", "content_sanskrit": "तं तु दुःशासनः शूरः सायकैरावृणोद्भृशम्।\nरथव्रातेन महता नानादेशोद्भवेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2054533, "chapter_id": 2196, "verse_number": "७-१२३-४", "content_sanskrit": "सर्वतो भरतश्रेष्ठ विसृजन्सायकान्बहून्।\nपर्जन्य इव घोषेण नादयन्वै दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2054534, "chapter_id": 2196, "verse_number": "७-१२३-५", "content_sanskrit": "तमापतन्तमालोक्य सात्यकिः कौरवं रणे।\nअभिद्रुत्य महाबाहुश्छादयामास सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2054535, "chapter_id": 2196, "verse_number": "७-१२३-६", "content_sanskrit": "ते छाद्यमाना बाणौघैर्दुःशासनपुरोगमाः।\nप्राद्रवन्समरे भीतास्तव सैन्यस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2054536, "chapter_id": 2196, "verse_number": "७-१२३-७", "content_sanskrit": "तेषु द्रवत्सु राजेन्द्र पुत्रो दुःशानस्तव।\nतस्थौ व्यपेतभी राजन्सात्यकिं चार्दयच्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2054537, "chapter_id": 2196, "verse_number": "७-१२३-८", "content_sanskrit": "चतुर्भिर्वाजिनस्तस्य सारथिं च त्रिभिः शरैः।\nसात्यकिं च शतेनाजौ विद्ध्वा नादं मुमोच सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2054538, "chapter_id": 2196, "verse_number": "७-१२३-९", "content_sanskrit": "ततः क्रुद्धो महाराज माधवस्तस्य संयुगे।\nरथं सूतं ध्वजं तं च चक्रेऽदृश्यमजिह्मगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2054539, "chapter_id": 2196, "verse_number": "७-१२३-१०", "content_sanskrit": "स तु दुःशासनं शूरं सायकैरावृणोद्भृशम्।\nमशकं समनुप्राप्तमूर्णनाभिरिवोर्णया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2054540, "chapter_id": 2196, "verse_number": "७-१२३-११", "content_sanskrit": "त्वरन्समावृणोद्बाणैर्दुःशासनममित्रजित्॥\nदृष्ट्वा दुःशासनं राजा तथा शरशताचितम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2054541, "chapter_id": 2196, "verse_number": "७-१२३-१२", "content_sanskrit": "त्रिगर्तांश्चोदयामास युयुधानरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2054542, "chapter_id": 2196, "verse_number": "७-१२३-१३", "content_sanskrit": "तेऽगच्छन्युयुधानस्य समीपं क्रुरकर्मणः।\nत्रिगर्तानां त्रिसाहस्रा रथा युद्धविशारदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2054543, "chapter_id": 2196, "verse_number": "७-१२३-१४", "content_sanskrit": "ते तु तं रथवंशेन महता पर्यवारयन्।\nस्थिरां कृत्वा मतिं युद्धे भूत्वा संशप्तका मिथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2054544, "chapter_id": 2196, "verse_number": "७-१२३-१५", "content_sanskrit": "तेषां प्रयतमानानां शरवर्षाणि मुञ्चताम्।\nयोधान्पञ्चशतान्मुख्यानग्र्यानीके व्यपोथयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2054545, "chapter_id": 2196, "verse_number": "७-१२३-१६", "content_sanskrit": "तेऽपतन्निहतास्तूर्णं शिनिप्रवरसायकैः।\nमहामारुतवेगेन भग्ना इव नगाद्द्रुमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2054546, "chapter_id": 2196, "verse_number": "७-१२३-१७", "content_sanskrit": "नागैश्च बहुधा च्छिन्नैर्ध्वजैश्चैव विशाम्पते।\nहयैश्च कनकापीडैः पतितैस्तत्र मेदिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2054547, "chapter_id": 2196, "verse_number": "७-१२३-१८", "content_sanskrit": "शैनेयशरसङ्कृत्तैः शोणितौघपरिप्लुतैः।\nअशोभत महाराज किंशुकैरिव पुष्पितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2054548, "chapter_id": 2196, "verse_number": "७-१२३-१९", "content_sanskrit": "ते वध्यमानाः समरे युयुधानेन तावकाः।\nत्रातारं नाध्यगच्छन्त पङ्कमग्ना इव द्विपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2054549, "chapter_id": 2196, "verse_number": "७-१२३-२०", "content_sanskrit": "ततस्ते पर्यवर्तन्त सर्वे द्रोणरथं प्रति।\nभयात्पतगराजस्य गर्तानीव महोरगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2054550, "chapter_id": 2196, "verse_number": "७-१२३-२१", "content_sanskrit": "हत्वा पञ्चशतान्योधाञ्छरैराशीविषोपमैः।\nप्रायात्स शनकैर्वीरो धनञ्जयरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2054551, "chapter_id": 2196, "verse_number": "७-१२३-२२", "content_sanskrit": "तं प्रयान्तं नरश्रेष्ठं पुत्रो दुःशासनस्तव।\nविव्याध नवभिस्तूर्णं शरैः सन्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2054552, "chapter_id": 2196, "verse_number": "७-१२३-२३", "content_sanskrit": "स तु तं प्रतिविव्याध पञ्चभिर्निशितैः शरैः।\nरुक्मपुङ्खैर्महेष्वासो गार्ध्रपत्रैरजिह्मगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2054553, "chapter_id": 2196, "verse_number": "७-१२३-२४", "content_sanskrit": "सात्यकिं तु महाराज प्रहसन्निव भारत।\nदुःशासनस्त्रिभिर्विद्ध्वा पुनर्विव्याध पञ्चभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2054554, "chapter_id": 2196, "verse_number": "७-१२३-२५", "content_sanskrit": "शैनेयस्तव पुत्रं तु हत्वा पञ्चभिराशुगैः।\nधनुश्चास्य रणे छित्त्वा विस्मयन्नर्जुनं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2054555, "chapter_id": 2196, "verse_number": "७-१२३-२६", "content_sanskrit": "ततो दुःशासनः क्रुद्धो वृष्णिवीराय गच्छते।\nसर्वपारशवीं शक्तिं विससर्ज जिघांसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2054556, "chapter_id": 2196, "verse_number": "७-१२३-२७", "content_sanskrit": "तां तु शक्तिं तदा घोरां तव पुत्रस्य सात्यकिः।\nचिच्छेद शतधा राजन्निशितैः कङ्कपत्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2054557, "chapter_id": 2196, "verse_number": "७-१२३-२८", "content_sanskrit": "अथान्यद्धनुरादाय पुत्रस्तव जनेश्वर।\nसात्यकिं च शरैर्विद्ध्वा सिंहनादं ननाद च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2054558, "chapter_id": 2196, "verse_number": "७-१२३-२९", "content_sanskrit": "सात्यकिस्तु रणे क्रुद्धो मोहयित्वा सुतं तव।\nशरैरग्निशिखाकारैराजघान स्तनान्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2054559, "chapter_id": 2196, "verse_number": "७-१२३-३०", "content_sanskrit": "त्रिभिरेव महाभागः शरैः सन्नतपर्वभिः।\nसर्वायसैस्तीक्ष्णवक्त्रैः पुनर्विव्याध चाष्टभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2054560, "chapter_id": 2196, "verse_number": "७-१२३-३१", "content_sanskrit": "दुःशासनस्तु विंशत्या सात्यकिं प्रत्यविध्यत।\nसात्वतोऽपि महाराज तं विव्याध स्तनान्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2054561, "chapter_id": 2196, "verse_number": "७-१२३-३२", "content_sanskrit": "त्रिभिरेव महाभागः शरैः सन्नतपर्वभिः।\nततोऽस्य वाहान्निशितैः शरैर्जघ्ने महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2054562, "chapter_id": 2196, "verse_number": "७-१२३-३३", "content_sanskrit": "सारथिं च सुराङ्क्रुद्धः शरैः सन्नतपर्वभिः।\nधनुरेकेन भल्लेन हस्तावापं च पञ्चभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2054563, "chapter_id": 2196, "verse_number": "७-१२३-३४", "content_sanskrit": "ध्वजं च रथशक्तिं च भल्लाभ्यां परमस्त्रिवित्।\nचिच्छेद विशिखैस्तीक्ष्णैस्तथोभौ पार्ष्णिसारथी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2054564, "chapter_id": 2196, "verse_number": "७-१२३-३५", "content_sanskrit": "स च्छिन्नधन्वा विरथो हताश्वो हतसारथिः।\nत्रिगर्तसेनापतिना स्वरथेनापवाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2054565, "chapter_id": 2196, "verse_number": "७-१२३-३६", "content_sanskrit": "तमभिद्रुत्य शैनेयो मुहूर्तमिव भारत।\nन जघान महाबाहुर्भीमसेनवचः स्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2054566, "chapter_id": 2196, "verse_number": "७-१२३-३७", "content_sanskrit": "भीमसेनेन तु वधः सुतानां तव भारत।\nप्रतिज्ञातः सभामध्ये सर्वेषामेव संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2054567, "chapter_id": 2196, "verse_number": "७-१२३-३८", "content_sanskrit": "ततो दुःशासनं जित्वा सात्यकिः संयुगे प्रभो।\nजगाम त्वरितो राजन्येन यातो धनञ्जयः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2054568, "chapter_id": 2196, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे त्रयोविंशत्यधिकशततमोऽध्यायः॥ १२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]