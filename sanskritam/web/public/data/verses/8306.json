[{"id": 900003799, "chapter_id": 8306, "verse_number": "2.1", "content_sanskrit": "वरीयानेष ते प्रश्नः कृतो लोकहितं नृप", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900003800, "chapter_id": 8306, "verse_number": "2.2", "content_sanskrit": "एवं पुरा धारणयाऽऽत्मयोनिर्नष्टां स्मृतिं प्रत्यवरुह्य तुष्यन्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900003801, "chapter_id": 8306, "verse_number": "2.3", "content_sanskrit": "एवमेतन्निगदितं पृष्टवान्यद्भवान्मम", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900003802, "chapter_id": 8306, "verse_number": "2.4", "content_sanskrit": "वैयासकेरिति वचस्तत्वनिश्चयमात्मनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900003803, "chapter_id": 8306, "verse_number": "2.5", "content_sanskrit": "देवदेव नमस्तेस्तु भूतभावनपूर्वज", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900003804, "chapter_id": 8306, "verse_number": "2.6", "content_sanskrit": "वाचो वह्नेर्मुखं क्षेत्रं छन्दसां सप्तधातवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900003805, "chapter_id": 8306, "verse_number": "2.7", "content_sanskrit": "यत्रोद्गतः क्षितितलोद्धरणाय बिभ्रत् क्रौडीं तनुं सकलयज्ञमयीमनन्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900003806, "chapter_id": 8306, "verse_number": "2.8", "content_sanskrit": "ब्रह्मणा चोदितो ब्रह्मन्गुणाख्यानेऽगुणस्य च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900003807, "chapter_id": 8306, "verse_number": "2.9", "content_sanskrit": "आत्ममायामृते राजन्परस्यानुभवात्मनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900003808, "chapter_id": 8306, "verse_number": "2.10", "content_sanskrit": "अत्र सर्गो विसर्गश्च स्थानं पोषणमूतयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]