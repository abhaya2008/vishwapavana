[{"id": 5000047000, "chapter_id": 9047, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे सप्तचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000047001, "chapter_id": 9047, "verse_number": "१-४७-१", "content_sanskrit": "सप्तधा तु कृते गर्भे दितिः परमदुःखिता।\nसहस्राक्षं दुराधर्षं वाक्यं सानुनयाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000047002, "chapter_id": 9047, "verse_number": "१-४७-२", "content_sanskrit": "ममापराधाद् गर्भोऽयं सप्तधा शकलीकृतः।\nनापराधो हि देवेश तवात्र बलसूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000047003, "chapter_id": 9047, "verse_number": "१-४७-३", "content_sanskrit": "प्रियं त्वत्कृतमिच्छामि मम गर्भविपर्यये।\nमरुतां सप्त सप्तानां स्थानपाला भवन्तु ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000047004, "chapter_id": 9047, "verse_number": "१-४७-४", "content_sanskrit": "वातस्कन्धा इमे सप्त चरन्तु दिवि पुत्रक।\nमारुता इति विख्याता दिव्यरूपा ममात्मजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000047005, "chapter_id": 9047, "verse_number": "१-४७-५", "content_sanskrit": "ब्रह्मलोकं चरत्वेक इन्द्रलोकं तथापरः।\nदिव्यवायुरिति ख्यातस्तृतीयोऽपि महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000047006, "chapter_id": 9047, "verse_number": "१-४७-६", "content_sanskrit": "चत्वारस्तु सुरश्रेष्ठ दिशो वै तव शासनात्।\nसंचरिष्यन्ति भद्रं ते कालेन हि ममात्मजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000047007, "chapter_id": 9047, "verse_number": "१-४७-७", "content_sanskrit": "त्वत्कृतेनैव नाम्ना वै मारुता इति विश्रुताः।\nतस्यास्तद् वचनं श्रुत्वा सहस्राक्षः पुरन्दरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000047008, "chapter_id": 9047, "verse_number": "१-४७-८", "content_sanskrit": "उवाच प्राञ्जलिर्वाक्यमतीदं बलसूदनः।\nसर्वमेतद् यथोक्तं ते भविष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000047009, "chapter_id": 9047, "verse_number": "१-४७-९", "content_sanskrit": "विचरिष्यन्ति भद्रं ते देवरूपास्तवात्मजाः।\nएवं तौ निश्चयं कृत्वा मातापुत्रौ तपोवने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000047010, "chapter_id": 9047, "verse_number": "१-४७-१०", "content_sanskrit": "जग्मतुस्त्रिदिवं राम कृतार्थाविति नः श्रुतम्।\nएष देशः स काकुत्स्थ महेन्द्राध्युषितः पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000047011, "chapter_id": 9047, "verse_number": "१-४७-११", "content_sanskrit": "दितिं यत्र तपःसिद्धामेवं परिचचार सः।\nइक्ष्वाकोस्तु नरव्याघ्र पुत्रः परमधार्मिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000047012, "chapter_id": 9047, "verse_number": "१-४७-१२", "content_sanskrit": "अलम्बुषायामुत्पन्नो विशाल इति विश्रुतः।\nतेन चासीदिह स्थाने विशालेति पुरी कृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000047013, "chapter_id": 9047, "verse_number": "१-४७-१३", "content_sanskrit": "विशालस्य सुतो राम हेमचन्द्रो महाबलः।\nसुचन्द्र इति विख्यातो हेमचन्द्रादनन्तरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000047014, "chapter_id": 9047, "verse_number": "१-४७-१४", "content_sanskrit": "सुचन्द्रतनयो राम धूम्राश्व इति विश्रुतः।\nधूम्राश्वतनयश्चापि सृञ्जयः समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000047015, "chapter_id": 9047, "verse_number": "१-४७-१५", "content_sanskrit": "सृञ्जयस्य सुतः श्रीमान् सहदेवः प्रतापवान्।\nकुशाश्वः सहदेवस्य पुत्रः परमधार्मिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000047016, "chapter_id": 9047, "verse_number": "१-४७-१६", "content_sanskrit": "कुशाश्वस्य महातेजाः सोमदत्तः प्रतापवान्।\nसोमदत्तस्य पुत्रस्तु काकुत्स्थ इति विश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000047017, "chapter_id": 9047, "verse_number": "१-४७-१७", "content_sanskrit": "तस्य पुत्रो महातेजाः सम्प्रत्येष पुरीमिमाम्।\nआवसत् परमप्रख्यः सुमतिर्नाम दुर्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000047018, "chapter_id": 9047, "verse_number": "१-४७-१८", "content_sanskrit": "इक्ष्वाकोस्तु प्रसादेन सर्वे वैशालिका नृपाः।\nदीर्घायुषो महात्मानो वीर्यवन्तः सुधार्मिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000047019, "chapter_id": 9047, "verse_number": "१-४७-१९", "content_sanskrit": "इहाद्य रजनीमेकां सुखं स्वप्स्यामहे वयम्।\nश्वः प्रभाते नरश्रेष्ठ जनकं द्रष्टुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000047020, "chapter_id": 9047, "verse_number": "१-४७-२०", "content_sanskrit": "सुमतिस्तु महातेजा विश्वामित्रमुपागतम्।\nश्रुत्वा नरवरश्रेष्ठः प्रत्यागच्छन्महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000047021, "chapter_id": 9047, "verse_number": "१-४७-२१", "content_sanskrit": "पूजां च परमां कृत्वा सोपाध्यायः सबान्धवः।\nप्राञ्जलिः कुशलं पृष्ट्वा विश्वामित्रमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000047022, "chapter_id": 9047, "verse_number": "१-४७-२२", "content_sanskrit": "धन्योऽस्म्यनुगृहीतोऽस्मि यस्य मे विषयं मुने।\nसम्प्राप्तो दर्शनं चैव नास्ति धन्यतरो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000047023, "chapter_id": 9047, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे सप्तचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]