[{"id": 5000395000, "chapter_id": 9395, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे षट्पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000395001, "chapter_id": 9395, "verse_number": "५-५६-१", "content_sanskrit": "ततस्तु शिंशपामूले जानकीं पर्यवस्थिताम्।\nअभिवाद्याब्रवीद् दिष्ट्या पश्यामि त्वामिहाक्षताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000395002, "chapter_id": 9395, "verse_number": "५-५६-२", "content_sanskrit": "ततस्तं प्रस्थितं सीता वीक्षमाणा पुनः पुनः।\nभर्तुः स्नेहान्विता वाक्यं हनूमन्तमभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000395003, "chapter_id": 9395, "verse_number": "५-५६-३", "content_sanskrit": "यदि त्वं मन्यसे तात वसैकाहमिहानघ।\nक्वचित् सुसंवृते देशे विश्रान्तः श्वो गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000395004, "chapter_id": 9395, "verse_number": "५-५६-४", "content_sanskrit": "मम चैवाल्पभाग्यायाः सांनिध्यात् तव वानर।\nशोकस्यास्याप्रमेयस्य मुहूर्तं स्यादपि क्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000395005, "chapter_id": 9395, "verse_number": "५-५६-५", "content_sanskrit": "गते हि हरिशार्दूल पुनः सम्प्राप्तये त्वयि।\nप्राणेष्वपि न विश्वासो मम वानरपुङ्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000395006, "chapter_id": 9395, "verse_number": "५-५६-६", "content_sanskrit": "अदर्शनं च ते वीर भूयो मां दारयिष्यति।\nदुःखाद् दुःखतरं प्राप्तां दुर्मनःशोककर्शिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000395007, "chapter_id": 9395, "verse_number": "५-५६-७", "content_sanskrit": "अयं च वीर संदेहस्तिष्ठतीव ममाग्रतः।\nसुमहत्सु सहायेषु हर्यृक्षेषु महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000395008, "chapter_id": 9395, "verse_number": "५-५६-८", "content_sanskrit": "कथं नु खलु दुष्पारं संतरिष्यति सागरम्।\nतानि हर्यृक्षसैन्यानि तौ वा नरवरात्मजौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000395009, "chapter_id": 9395, "verse_number": "५-५६-९", "content_sanskrit": "त्रयाणामेव भूतानां सागरस्यापि लङ्घने।\nशक्तिः स्याद् वैनतेयस्य तव वा मारुतस्य वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000395010, "chapter_id": 9395, "verse_number": "५-५६-१०", "content_sanskrit": "तदत्र कार्यनिर्बन्धे समुत्पन्ने दुरासदे।\nकिं पश्यसि समाधानं त्वं हि कार्यविशारदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000395011, "chapter_id": 9395, "verse_number": "५-५६-११", "content_sanskrit": "काममस्य त्वमेवैकः कार्यस्य परिसाधने।\nपर्याप्तः परवीरघ्न यशस्यस्ते फलोदयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000395012, "chapter_id": 9395, "verse_number": "५-५६-१२", "content_sanskrit": "बलैस्तु संकुलां कृत्वा लङ्कां परबलार्दनः।\nमां नयेद् यदि काकुत्स्थस्तत् तस्य सदृशं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000395013, "chapter_id": 9395, "verse_number": "५-५६-१३", "content_sanskrit": "तद् यथा तस्य विक्रान्तमनुरूपं महात्मनः।\nभवत्याहवशूरस्य तथा त्वमुपपादय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000395014, "chapter_id": 9395, "verse_number": "५-५६-१४", "content_sanskrit": "तदर्थोपहितं वाक्यं प्रश्रितं हेतुसंहितम्।\nनिशम्य हनुमान् वीरो वाक्यमुत्तरमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000395015, "chapter_id": 9395, "verse_number": "५-५६-१५", "content_sanskrit": "देवि हर्यृक्षसैन्यानामीश्वरः प्लवतां वरः।\nसुग्रीवः सत्त्वसम्पन्नस्तवार्थे कृतनिश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000395016, "chapter_id": 9395, "verse_number": "५-५६-१६", "content_sanskrit": "स वानरसहस्राणां कोटीभिरभिसंवृतः।\nक्षिप्रमेष्यति वैदेहि सुग्रीवः प्लवगाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000395017, "chapter_id": 9395, "verse_number": "५-५६-१७", "content_sanskrit": "तौ च वीरौ नरवरौ सहितौ रामलक्ष्मणौ।\nआगम्य नगरीं लङ्कां सायकैर्विधमिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000395018, "chapter_id": 9395, "verse_number": "५-५६-१८", "content_sanskrit": "सगणं राक्षसं हत्वा नचिराद् रघुनन्दनः।\nत्वामादाय वरारोहे स्वां पुरीं प्रति यास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000395019, "chapter_id": 9395, "verse_number": "५-५६-१९", "content_sanskrit": "समाश्वसिहि भद्रं ते भव त्वं कालकाङ्क्षिणी।\nक्षिप्रं द्रक्ष्यसि रामेण निहतं रावणं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000395020, "chapter_id": 9395, "verse_number": "५-५६-२०", "content_sanskrit": "निहते राक्षसेन्द्रे च सपुत्रामात्यबान्धवे।\nत्वं समेष्यसि रामेण शशाङ्केनेव रोहिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000395021, "chapter_id": 9395, "verse_number": "५-५६-२१", "content_sanskrit": "क्षिप्रमेष्यति काकुत्स्थो हर्यृक्षप्रवरैर्युतः।\nयस्ते युधि विजित्यारीञ्छोकं व्यपनयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000395022, "chapter_id": 9395, "verse_number": "५-५६-२२", "content_sanskrit": "एवमाश्वास्य वैदेहीं हनूमान् मारुतात्मजः।\nगमनाय मतिं कृत्वा वैदेहीमभ्यवादयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000395023, "chapter_id": 9395, "verse_number": "५-५६-२३", "content_sanskrit": "राक्षसान् प्रवरान् हत्वा नाम विश्राव्य चात्मनः।\nसमाश्वास्य च वैदेहीं दर्शयित्वा परं बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000395024, "chapter_id": 9395, "verse_number": "५-५६-२४", "content_sanskrit": "नगरीमाकुलां कृत्वा वञ्चयित्वा च रावणम्।\nदर्शयित्वा बलं घोरं वैदेहीमभिवाद्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000395025, "chapter_id": 9395, "verse_number": "५-५६-२५", "content_sanskrit": "प्रतिगन्तुं मनश्चक्रे पुनर्मध्येन सागरम्।\nततः स कपिशार्दूलः स्वामिसंदर्शनोत्सुकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000395026, "chapter_id": 9395, "verse_number": "५-५६-२६", "content_sanskrit": "आरुरोह गिरिश्रेष्ठमरिष्टमरिमर्दनः।\nतुङ्गपद्मकजुष्टाभिर्नीलाभिर्वनराजिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000395027, "chapter_id": 9395, "verse_number": "५-५६-२७", "content_sanskrit": "सोत्तरीयमिवाम्भोदैः शृङ्गान्तरविलम्बिभिः।\nबोध्यमानमिव प्रीत्या दिवाकरकरैः शुभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000395028, "chapter_id": 9395, "verse_number": "५-५६-२८", "content_sanskrit": "उन्मिषन्तमिवोद्‍धूतैर्लोचनैरिव धातुभिः।\nतोयौघनिःस्वनैर्मन्द्रैः प्राधीतमिव पर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000395029, "chapter_id": 9395, "verse_number": "५-५६-२९", "content_sanskrit": "प्रगीतमिव विस्पष्टं नानाप्रस्रवणस्वनैः।\nदेवदारुभिरुद्‍धूतैरूर्ध्वबाहुमिव स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000395030, "chapter_id": 9395, "verse_number": "५-५६-३०", "content_sanskrit": "प्रपातजलनिर्घोषैः प्राक्रुष्टमिव सर्वतः।\nवेपमानमिव श्यामैः कम्पमानैः शरद्वनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000395031, "chapter_id": 9395, "verse_number": "५-५६-३१", "content_sanskrit": "वेणुभिर्मारुतोद्‍धूतैः कूजन्तमिव कीचकैः।\nनिःश्वसन्तमिवामर्षाद् घोरैराशीविषोत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000395032, "chapter_id": 9395, "verse_number": "५-५६-३२", "content_sanskrit": "नीहारकृतगम्भीरैर्ध्यायन्तमिव गह्वरैः।\nमेघपादनिभैः पादैः प्रक्रान्तमिव सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000395033, "chapter_id": 9395, "verse_number": "५-५६-३३", "content_sanskrit": "जृम्भमाणमिवाकाशे शिखरैरभ्रमालिभिः।\nकूटैश्च बहुधा कीर्णं शोभितं बहुकन्दरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000395034, "chapter_id": 9395, "verse_number": "५-५६-३४", "content_sanskrit": "सालतालैश्च कर्णैश्च वंशैश्च बहुभिर्वृतम्।\nलतावितानैर्विततैः पुष्पवद्भिरलंकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000395035, "chapter_id": 9395, "verse_number": "५-५६-३५", "content_sanskrit": "नानामृगगणैः कीर्णं धातुनिष्यन्दभूषितम्।\nबहुप्रस्रवणोपेतं शिलासंचयसंकटम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000395036, "chapter_id": 9395, "verse_number": "५-५६-३६", "content_sanskrit": "महर्षियक्षगन्धर्वकिंनरोरगसेवितम्।\nलतापादपसम्बाधं सिंहाधिष्ठितकन्दरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000395037, "chapter_id": 9395, "verse_number": "५-५६-३७", "content_sanskrit": "व्याघ्रादिभिः समाकीर्णं स्वादुमूलफलद्रुमम्।\nआरुरोहानिलसुतः पर्वतं प्लवगोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000395038, "chapter_id": 9395, "verse_number": "५-५६-३८", "content_sanskrit": "रामदर्शनशीघ्रेण प्रहर्षेणाभिचोदितः।\nतेन पादतलक्रान्ता रम्येषु गिरिसानुषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000395039, "chapter_id": 9395, "verse_number": "५-५६-३९", "content_sanskrit": "सघोषाः समशीर्यन्त शिलाश्चूर्णीकृतास्ततः।\nस तमारुह्य शैलेन्द्रं व्यवर्धत महाकपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000395040, "chapter_id": 9395, "verse_number": "५-५६-४०", "content_sanskrit": "दक्षिणादुत्तरं पारं प्रार्थयँल्लवणाम्भसः।\nअधिरुह्य ततो वीरः पर्वतं पवनात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000395041, "chapter_id": 9395, "verse_number": "५-५६-४१", "content_sanskrit": "ददर्श सागरं भीमं भीमोरगनिषेवितम्।\nस मारुत इवाकाशं मारुतस्यात्मसम्भवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000395042, "chapter_id": 9395, "verse_number": "५-५६-४२", "content_sanskrit": "प्रपेदे हरिशार्दूलो दक्षिणादुत्तरां दिशम्।\nस तदा पीडितस्तेन कपिना पर्वतोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000395043, "chapter_id": 9395, "verse_number": "५-५६-४३", "content_sanskrit": "ररास विविधैर्भूतैः प्राविशद् वसुधातलम्।\nकम्पमानैश्च शिखरैः पतद्भिरपि च द्रुमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000395044, "chapter_id": 9395, "verse_number": "५-५६-४४", "content_sanskrit": "तस्योरुवेगोन्मथिताः पादपाः पुष्पशालिनः।\nनिपेतुर्भूतले भग्नाः शक्रायुधहता इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000395045, "chapter_id": 9395, "verse_number": "५-५६-४५", "content_sanskrit": "कन्दरोदरसंस्थानां पीडितानां महौजसाम्।\nसिंहानां निनदो भीमो नभो भिन्दन् हि शुश्रुवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000395046, "chapter_id": 9395, "verse_number": "५-५६-४६", "content_sanskrit": "त्रस्तव्याविद्धवसना व्याकुलीकृतभूषणाः।\nविद्याधर्यः समुत्पेतुः सहसा धरणीधरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000395047, "chapter_id": 9395, "verse_number": "५-५६-४७", "content_sanskrit": "अतिप्रमाणा बलिनो दीप्तजिह्वा महाविषाः।\nनिपीडितशिरोग्रीवा व्यवेष्टन्त महाहयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000395048, "chapter_id": 9395, "verse_number": "५-५६-४८", "content_sanskrit": "किंनरोरगगन्धर्वयक्षविद्याधरास्तथा।\nपीडितं तं नगवरं त्यक्त्वा गगनमास्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000395049, "chapter_id": 9395, "verse_number": "५-५६-४९", "content_sanskrit": "स च भूमिधरः श्रीमान् बलिना तेन पीडितः।\nसवृक्षशिखरोदग्रः प्रविवेश रसातलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000395050, "chapter_id": 9395, "verse_number": "५-५६-५०", "content_sanskrit": "दशयोजनविस्तारस्त्रिंशद्योजनमुच्छ्रितः।\nधरण्यां समतां यातः स बभूव धराधरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000395051, "chapter_id": 9395, "verse_number": "५-५६-५१", "content_sanskrit": "स लिलङ्घयिषुर्भीमं सलीलं लवणार्णवम्।\nकल्लोलास्फालवेलान्तमुत्पपात नभो हरिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000395052, "chapter_id": 9395, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे षट्पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]