[{"id": 2010900, "chapter_id": 1222, "verse_number": "१-२२३-०x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2010901, "chapter_id": 1222, "verse_number": "१-२२३-१", "content_sanskrit": "मन्त्राय समुपानीतैर्धृतराष्ट्र हितैर्नृप।\nधर्म्यमर्थ्यं यशस्यं च वाच्यमित्यनुशुश्रुम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2010902, "chapter_id": 1222, "verse_number": "१-२२३-२", "content_sanskrit": "ममाप्येषा मतिस्तात या भीष्मस्य महात्मनः।\nसंविभज्यास्तु कौन्तेया धर्म एष सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2010903, "chapter_id": 1222, "verse_number": "१-२२३-३", "content_sanskrit": "प्रेष्यतां द्रुपदायाशु नऱः कश्चित्प्रियंवदः।\nबहुलं रत्नमादाय तेषामर्थाय भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2010904, "chapter_id": 1222, "verse_number": "१-२२३-४", "content_sanskrit": "मिथः कृत्यं च तस्मै स आदाय वसु गच्छतु।\nवृद्धिं च परमां ब्रूयात्तत्संयोगोद्भवां तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2010905, "chapter_id": 1222, "verse_number": "१-२२३-५", "content_sanskrit": "संप्रीयमाणं त्वां ब्रूयाद्राजन्दुर्योधनं तथा।\nअसकृद्द्रुपदे चैव धृष्टद्युम्ने च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2010906, "chapter_id": 1222, "verse_number": "१-२२३-६", "content_sanskrit": "उचितत्वं प्रियत्वं च योगस्यापि च वर्णयेत्।\nपुनःपुनश्च कौन्येयान्माद्रीपुत्रौ च सान्त्वयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2010907, "chapter_id": 1222, "verse_number": "१-२२३-७", "content_sanskrit": "हिरण्मयानि शुभ्राणि बहून्याभरणानि च।\nवचनात्तव राजेन्द्र द्रौपद्याः संप्रयच्छतु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2010908, "chapter_id": 1222, "verse_number": "१-२२३-८", "content_sanskrit": "तथा द्रुपदपुत्राणां सर्वेषां भरतर्षभ।\nपाण्डवानां च सर्वेषां कुन्त्या युक्तानि यानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2010909, "chapter_id": 1222, "verse_number": "१-२२३-९", "content_sanskrit": "दत्त्वा तानि महार्हाणि पाण्डवान्संप्रहर्षय।\nएवं सान्त्वसमायुक्तं द्रुपदं पाण्डवैः सह।\nउक्त्वा सोऽनन्तरं ब्रूयात्तेषामागमनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2010910, "chapter_id": 1222, "verse_number": "१-२२३-१०", "content_sanskrit": "अनुज्ञातेषु वीरेषु बलं गच्छतु शोभनम्।\nदुःशासनो विकर्णश्चाप्यानेतुं पाण्डवानिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2010911, "chapter_id": 1222, "verse_number": "१-२२३-११", "content_sanskrit": "ततस्ते पाण्डवाः श्रेष्ठाः पूज्यमानाः सदा त्वया।\nप्रकृतीनामनुमते पदे स्थास्यन्ति पैतृके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2010912, "chapter_id": 1222, "verse_number": "१-२२३-१२", "content_sanskrit": "एतत्तव महाराज तेषु पुत्रेषु चैव हि।\nवृत्तमौपयिकं मन्ये भीष्मेण सह भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2010913, "chapter_id": 1222, "verse_number": "१-२२३-१३x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2010914, "chapter_id": 1222, "verse_number": "१-२२३-१३", "content_sanskrit": "योजितावर्थमानाभ्यां सर्वकार्येष्वनन्तरौ।\nन मन्त्रयेतां त्वच्छ्रेयः किमद्भुततरं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2010915, "chapter_id": 1222, "verse_number": "१-२२३-१४", "content_sanskrit": "दुष्टेन मनसा यो वै प्रच्छन्नेनान्तरात्मना।\nब्रूयान्नि)श्रेयसं नाम कथं कुर्यात्सतां मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2010916, "chapter_id": 1222, "verse_number": "१-२२३-१५", "content_sanskrit": "न मित्राण्यर्थकृच्छ्रेषु श्रेयसे चेतराय वा।\nविधिपूर्वं हि सर्वस्य दुःखं वा यदि वा सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2010917, "chapter_id": 1222, "verse_number": "१-२२३-१६", "content_sanskrit": "कृतप्रज्ञोऽकृतप्रज्ञो बालो वृद्धश्च मानवः।\nससहायोऽसहायश्च सर्वं सर्वत्र विन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2010918, "chapter_id": 1222, "verse_number": "१-२२३-१७", "content_sanskrit": "श्रूयते हि पुरा कश्चिदम्बुवीच इतीश्वरः।\nआसीद्राजगृहे राजा मागधानां महीक्षिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2010919, "chapter_id": 1222, "verse_number": "१-२२३-१८", "content_sanskrit": "स हीनः करणैः सर्वैरुच्छ्वासपरमो नृपः।\nअमात्यसंस्थः सर्वेषु कार्येष्वेवाभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2010920, "chapter_id": 1222, "verse_number": "१-२२३-१९", "content_sanskrit": "तस्यामात्यो महाकर्णिर्बभूवैकेश्वरस्तदा।\nस लब्धबलमात्मानं मन्यमानोऽवमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2010921, "chapter_id": 1222, "verse_number": "१-२२३-२०", "content_sanskrit": "स राज्ञ उपभोग्यानि स्त्रियो रत्नधनानि च।\nआददे सर्वशो मूढ ऐश्वर्यं च स्वयं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2010922, "chapter_id": 1222, "verse_number": "१-२२३-२१", "content_sanskrit": "तदादाय च लुब्धस्य लोभाल्लोभोऽभ्यवर्धत।\nतथाहि सर्वमादाय राज्यमस्य जिहीर्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2010923, "chapter_id": 1222, "verse_number": "१-२२३-२२", "content_sanskrit": "हीनस्य करणैः सर्वैरच्छ्वासपरमस्य च।\nयतमानोऽपि तद्राज्यं न शशाकेति नः श्रुतं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2010924, "chapter_id": 1222, "verse_number": "१-२२३-२३", "content_sanskrit": "किमन्यद्विहिता नूनं तस्य सा पुरुषेन्द्रता।\nयदि ते विहितं राज्यं भविष्यति विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2010925, "chapter_id": 1222, "verse_number": "१-२२३-२४", "content_sanskrit": "मिषतः सर्वलोकस्य स्थास्यते त्वयि तद्धुवम्।\nअतोऽन्यथा चेद्विहितं यतमानो न लप्स्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2010926, "chapter_id": 1222, "verse_number": "१-२२३-२५", "content_sanskrit": "एवं विद्वन्नुपादत्स्व मन्त्रिणां साध्वसाधुताम्।\nदुष्टानां चैव बोद्धव्यमदुष्टानां च भाषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2010927, "chapter_id": 1222, "verse_number": "१-२२३-२६x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2010928, "chapter_id": 1222, "verse_number": "१-२२३-२६", "content_sanskrit": "विद्म ते भावदोषेण यदर्थमिदमुच्यते।\nदुष्ट पाण्डवहेतोस्त्वं दोषमाख्यापयस्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2010929, "chapter_id": 1222, "verse_number": "१-२२३-२७", "content_sanskrit": "हितं तु परमं कर्ण ब्रवीमि कुलवर्धनम्।\nअथ त्वं मन्यसे दुष्टं ब्हूहि यत्परमं हितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2010930, "chapter_id": 1222, "verse_number": "१-२२३-२८", "content_sanskrit": "अतोऽन्यथा चेत्क्रियते यद्ब्रवीमि परं हितम्।\nकुरवो वै विनङ्क्ष्यन्ति नचिरेणैव मे मतिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2010931, "chapter_id": 1222, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि विदुरागमनराज्यलाभपर्वणि त्रयोविंशत्यधिकद्विशततमोऽध्यायः॥ २२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]