[{"id": 7003676000, "chapter_id": 23676, "verse_number": "१-२-६३-१", "content_sanskrit": "सूत उवाच ।\nअश्वत्थलाक्षावह्नौ च सर्षपान्केसरप्लुतान् ।\nजुह्वतो मंत्रमुख्यैश्च बलातिबलसंज्ञकैः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003676001, "chapter_id": 23676, "verse_number": "१-२-६३-२", "content_sanskrit": "यामे तु प्रथमे याते काचिन्नारी समाययौ ।\nशोणिताक्तैकवसना महोच्चोर्ध्वशिरोरुहा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003676002, "chapter_id": 23676, "verse_number": "१-२-६३-३", "content_sanskrit": "दारुणाक्षी शुक्लदन्ती भयस्यापि भयंकरी ।\nसा रुरोद महारावं प्राप्य तां होमभूमिकाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003676003, "chapter_id": 23676, "verse_number": "१-२-६३-४", "content_sanskrit": "तां दृष्ट्वा चुक्षुभे सद्यो विजयो भीतिमानिव ।\nबर्बरीकश्च निर्भीतिस्तस्याः संमुखमाययौ ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003676004, "chapter_id": 23676, "verse_number": "१-२-६३-५", "content_sanskrit": "ततः कण्ठं समाश्लिष्य तस्या मतिमतां वरः ।\nरुरोद द्विगुणं वीरो मेघवन्नादयन्बहु ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003676005, "chapter_id": 23676, "verse_number": "१-२-६३-६", "content_sanskrit": "तं दृष्ट्वा विस्मिता सा च यावन्मुंचति कर्तिकाम् ।\nतावन्निष्पीडिते कंठे मोक्तुं तस्मिन्न चाशकत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003676006, "chapter_id": 23676, "verse_number": "१-२-६३-७", "content_sanskrit": "पीड्यमाने च बलिना कंठे तस्या मुहुर्मुहुः ।\nमुमुोच विविधाञ्छब्दान्वज्राहत इवाचलः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003676007, "chapter_id": 23676, "verse_number": "१-२-६३-८", "content_sanskrit": "क्षणं रावांस्ततो मुक्त्वा त्राहि मुञ्चेति वक्त्यणु ।\nततः कृपालुना मुक्ता पादयोः पतिताऽब्रवीत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003676008, "chapter_id": 23676, "verse_number": "१-२-६३-९", "content_sanskrit": "शरणं ते प्रपन्नास्मि दासी कर्मकरी तव ।\nमहाजिह्वेति मां विद्धि राक्षसीं कामरूपिणीम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003676009, "chapter_id": 23676, "verse_number": "१-२-६३-१०", "content_sanskrit": "काशीश्मशाननिलयां देवदानवदर्पहाम् ।\nददासि यदि मे वीर दुर्लभां प्राणदक्षिणाम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003676010, "chapter_id": 23676, "verse_number": "१-२-६३-११", "content_sanskrit": "ततस्तपश्चरिष्यामि सर्वभूताभयप्रदा ।\nअस्मिन्नर्थे स्वदेवस्य शपथा मे तथात्मनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003676011, "chapter_id": 23676, "verse_number": "१-२-६३-१२", "content_sanskrit": "यद्येतद्व्यत्ययं कुर्यां भस्मीभूयां ततः क्षणम् ।\nएवं ब्रुवाणां तां वीरो निगृह्य शपथैर्दृढम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003676012, "chapter_id": 23676, "verse_number": "१-२-६३-१३", "content_sanskrit": "मुमोच सापि संहृष्टा कृच्छ्रान्मुक्ता ययौ वनम् ।\nसोऽपि वीरः खङ्गधारी तत्रैवावस्थितोऽभवत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003676013, "chapter_id": 23676, "verse_number": "१-२-६३-१४", "content_sanskrit": "ततो मध्यमरात्रौ च गर्जितं श्रूयते महत् ।\nअन्धकारं च संजज्ञे तमोंऽधनरकप्रभम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003676014, "chapter_id": 23676, "verse_number": "१-२-६३-१५", "content_sanskrit": "ददृशे च ततः शैलः शतशृंगोऽतिविस्तरः ।\nनानाशिलाः प्रमुमुचे नानावृक्षांश्च सोच्छ्रयान् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003676015, "chapter_id": 23676, "verse_number": "१-२-६३-१६", "content_sanskrit": "नानानिर्झर संघोषं ववृषे शोणितं वहु ।\nतं तथा नगमालोक्य निर्भीतो भैमिनंदनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003676016, "chapter_id": 23676, "verse_number": "१-२-६३-१७", "content_sanskrit": "पर्वतो द्विगुणो भूत्वा पर्वतं सहसाप्लुतः ।\nतदाभिजघ्ने संहृत्य पर्वतं स्वेन भूभृता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003676017, "chapter_id": 23676, "verse_number": "१-२-६३-१८", "content_sanskrit": "तदा विशीर्णः सोऽभूच्च पर्वतो भूमिमंडले ।\nततो योजनदेहात्मा शतशीर्षः शतोदरः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003676018, "chapter_id": 23676, "verse_number": "१-२-६३-१९", "content_sanskrit": "वक्त्रैर्मुंचन्महाज्वालां रेपलेन्द्रोऽभ्यधावत ।\nतं धावमानं दृष्ट्वैव बर्बरीको महाबलः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003676019, "chapter_id": 23676, "verse_number": "१-२-६३-२०", "content_sanskrit": "विधाय तादृशं रूपं नर्दन्तं चाप्यधावत ।\nततो मध्यमरात्रौ ती लघु चित्रं च सुष्ठु च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003676020, "chapter_id": 23676, "verse_number": "१-२-६३-२१", "content_sanskrit": "युयुधाते बाणजालैर्यथा प्रावृषि तोयदौ ।\nछिन्नचापौ च खङ्गाभ्यां छिन्नखड्गौ च मुष्टिभिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003676021, "chapter_id": 23676, "verse_number": "१-२-६३-२२", "content_sanskrit": "पर्वताविव सत्पक्षौ चिरं युयुधतुः स्थिरम् ।\nततः कक्षे समुत्पाट्य भ्रामयित्वा मुहूर्तकम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003676022, "chapter_id": 23676, "verse_number": "१-२-६३-२३", "content_sanskrit": "भूमौ प्रधर्षयामास प्रसृतं च मुमोच ह ।\nचिक्षेप चाग्निकोणे तं महीसागररोधसि ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003676023, "chapter_id": 23676, "verse_number": "१-२-६३-२४", "content_sanskrit": "तद्दूरे रेपलेन्द्राख्यं ग्राममद्यापि वर्तते ।\nएवं स रेपलोनाम वृत्रतुल्यपराक्रमः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003676024, "chapter_id": 23676, "verse_number": "१-२-६३-२५", "content_sanskrit": "नाथः श्मशानस्यावन्त्या विघ्नकृन्निहतोऽभवत् ।\nतं निहत्य पुनर्वीरो बर्बरीकः स्थितोऽभवत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003676025, "chapter_id": 23676, "verse_number": "१-२-६३-२६", "content_sanskrit": "ततस्तृतीययामे च प्रतीच्या दिश आययौ ।\nपर्वताभा महानादा पादैः कम्पयतीव भूः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003676026, "chapter_id": 23676, "verse_number": "१-२-६३-२७", "content_sanskrit": "दुहद्रुहाख्याश्वतरी मेघभ्रष्टा तडिद्यथा ।\nतामायांतीं तथा दृष्ट्वा सूर्यवैश्वानरप्रभाम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003676027, "chapter_id": 23676, "verse_number": "१-२-६३-२८", "content_sanskrit": "उपसृत्य जवाद्भैमी रुरोह प्रहसन्निव ।\nवेगात्ततः प्रद्रवतीं तुण्डे प्राहत्य मुष्टिभिः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003676028, "chapter_id": 23676, "verse_number": "१-२-६३-२९", "content_sanskrit": "स्थापयामास तत्रैव तस्थौ सा चातिपीडिता ।\nततः क्रुद्धा महारावं कृत्वाप्लुत्य दुहद्रुहा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003676029, "chapter_id": 23676, "verse_number": "१-२-६३-३०", "content_sanskrit": "जगत्यामाशु चिक्षेप बर्बरीकं तथेच्छकम् ।\nततो नदित्वा चातीव पादघातममुंचत ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003676030, "chapter_id": 23676, "verse_number": "१-२-६३-३१", "content_sanskrit": "पादौ च वीरः संगृह्य चिक्षेप भुवि लीलया ।\nततः पुनः समुत्थाय धावंतीं तां निगृह्य सः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003676031, "chapter_id": 23676, "verse_number": "१-२-६३-३२", "content_sanskrit": "मुष्टिना पातयित्वैव दंतान्कंठमपीडयत् ।\nक्लिन्नं वास इवापीड्य प्राणानत्याजयद्द्रुतम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003676032, "chapter_id": 23676, "verse_number": "१-२-६३-३३", "content_sanskrit": "एवं सीकोत्तरस्थाने स्मशानैकपदो द्भवा ।\nशाकिनीनामधीशा सा बर्बरीकेण सूदिता ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003676033, "chapter_id": 23676, "verse_number": "१-२-६३-३४", "content_sanskrit": "हत्वा तां चापि चिक्षेप प्रतीच्यामेव लीलया ।\nदुहद्रुहाख्यमद्यापि तत्र ग्रामं स्म वर्तते ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003676034, "chapter_id": 23676, "verse_number": "१-२-६३-३५", "content_sanskrit": "ततस्तथैव संतस्थौ बर्बरीकोऽभिरक्षणे ।\nततश्चतुर्थे यामे च प्राप्तः क्षपणकोऽद्भुतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003676035, "chapter_id": 23676, "verse_number": "१-२-६३-३६", "content_sanskrit": "मुंडी नग्नो मयूराणां पिच्छधारी महाव्रतः ।\nप्रोवाच चेदं वचनं हाहा कष्टमतीव भोः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003676036, "chapter_id": 23676, "verse_number": "१-२-६३-३७", "content_sanskrit": "अहिंसा परमो धर्मस्तदग्निर्ज्वाल्यते कुतः ।\nहूयमाने यतो वह्नौ सूक्ष्मजीववधो महान् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003676037, "chapter_id": 23676, "verse_number": "१-२-६३-३८", "content_sanskrit": "श्रुत्वेदं वचनं तस्य बर्बरीकोऽब्रवीत्स्मयन् ।\nवदने सर्वदेवानां हूयमाने स्म पावके ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003676038, "chapter_id": 23676, "verse_number": "१-२-६३-३९", "content_sanskrit": "अनृतं भाषसे पाप शिक्षायोग्योऽसि दुर्मते ।\nइत्युक्त्वा सहसोत्पत्य कक्षामध्ये स्थिरोऽस्य च ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003676039, "chapter_id": 23676, "verse_number": "१-२-६३-४०", "content_sanskrit": "दन्तान्मुष्टिप्रहारैश्च समाहत्याभ्यपातयत् ।\nरुधिराविलवक्त्रं तं मुमोच पतितं भुवि ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003676040, "chapter_id": 23676, "verse_number": "१-२-६३-४१", "content_sanskrit": "स क्षणाच्चेतनां प्राप्य घोरदैत्यवपुर्धरः ।\nभयाद्भैमेः प्रदुद्राव गुहाविवरमाविशत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003676041, "chapter_id": 23676, "verse_number": "१-२-६३-४२", "content_sanskrit": "बहुप्रभेति नगरी षष्टियोजनमायता ।\nतस्यां विवेश सहसा तं चानु बर्बरीककः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003676042, "chapter_id": 23676, "verse_number": "१-२-६३-४३", "content_sanskrit": "बर्बरीकं ततो दृष्ट्वा नादोऽभूच्च पलाशिनाम् ।\nधावध्वं हन्यतामेष छिद्यतां भिद्यतामिति ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003676043, "chapter_id": 23676, "verse_number": "१-२-६३-४४", "content_sanskrit": "तच्छ्रुत्वा दैत्यवीराणां कोटयो नव भीषणाः ।\nनानायुधधरा वीरं बर्बरीकमुपाद्रवन् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003676044, "chapter_id": 23676, "verse_number": "१-२-६३-४५", "content_sanskrit": "दृष्ट्वा तान्कोटिशो दैत्यान्क्रुद्धो भीमात्मजात्मजः ।\nनिमील्य सहसा नेत्रे तेषां मध्यमधावत ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003676045, "chapter_id": 23676, "verse_number": "१-२-६३-४६", "content_sanskrit": "पादघातैस्ततः कांश्चिद्भुजाघातैस्तथापरान् ।\nहृदयस्याभिघातैश्च क्षणान्निन्ये यमक्षयम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003676046, "chapter_id": 23676, "verse_number": "१-२-६३-४७", "content_sanskrit": "यथा नलवनं क्र्रुद्धः कुर्याद्भूमिसमं करी ।\nनवकोटीस्तथा जघ्ने सह तेन पलाशिना ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003676047, "chapter_id": 23676, "verse_number": "१-२-६३-४८", "content_sanskrit": "ततो नागाः समागम्य वासुकिप्रमुखास्तदा ।\nतुष्टुबुर्विविधैर्वाक्यैरूचुः सुहृदयं च ते ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003676048, "chapter_id": 23676, "verse_number": "१-२-६३-४९", "content_sanskrit": "नागानां परमं कृत्यं कृतं ते भैमिनंदन ।\nपलाशीनाम दैत्योयं नीतो यत्सानुगो यमम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003676049, "chapter_id": 23676, "verse_number": "१-२-६३-५०", "content_sanskrit": "अनेन हि वयं वीर सानुगेन दुरात्मना ।\nपीडिता विविधोपायैः पातालादप्यधः कृताः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003676050, "chapter_id": 23676, "verse_number": "१-२-६३-५१", "content_sanskrit": "वरं वृणीष्व त्वं तस्मान्नागेभ्योऽभिमतं परम् ।\nवरदाः सर्व एव स्म वयं तुभ्यं सुतोषिताः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003676051, "chapter_id": 23676, "verse_number": "१-२-६३-५२", "content_sanskrit": "सुहृदय उवाच ।\nयदि देयो वरो मह्यं तदेनं प्रवृणोम्यहम् ।\nसर्वविघ्नविनिर्मुक्तो विजयः सिद्धिमाप्नुयात् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003676052, "chapter_id": 23676, "verse_number": "१-२-६३-५३", "content_sanskrit": "ततस्तथेति तं प्रोचुः प्रहृष्टा वायुभोजनाः ।\nस च तेभ्यः पुरीं दत्त्वा निवृत्तो नागपूजितः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003676053, "chapter_id": 23676, "verse_number": "१-२-६३-५४", "content_sanskrit": "विवरस्य च मध्येन समागच्छन्महाप्रभम् ।\nसर्वरत्नमयं लिंगं स्थितं कल्पतरोरधः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003676054, "chapter_id": 23676, "verse_number": "१-२-६३-५५", "content_sanskrit": "अर्च्यमानं सुवह्नीभिर्नागकन्याभिरैक्षत ।\nततोऽसौ विस्मयाविष्टो नागकन्या ह्यपृच्छत ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003676055, "chapter_id": 23676, "verse_number": "१-२-६३-५६", "content_sanskrit": "केनेदं स्थापितं लिंगं सूर्यवैश्वानरप्रभम् ।\nलिंगादपि चतुर्दिक्षु मार्गाश्चेमे तु कीदृशाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003676056, "chapter_id": 23676, "verse_number": "१-२-६३-५७", "content_sanskrit": "इति वीरवचः श्रुत्वा बृहत्कटिपयोधरा ।\nसव्रीडं सस्मितापांगनिर्मोक्षमिदमब्रवीत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003676057, "chapter_id": 23676, "verse_number": "१-२-६३-५८", "content_sanskrit": "सर्वपन्नगराजेन शेषेण सुमहात्मना ।\nतप स्तप्त्वा महालिंगमिदमत्र प्रतिष्ठितम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003676058, "chapter_id": 23676, "verse_number": "१-२-६३-५९", "content_sanskrit": "दर्शनात्स्पर्शनाद्ध्यानादर्चनात्सर्वसिद्धिदम् ।\nलिंगात्पूर्वेण मार्गोयं याति श्रीपर्वतं भुवि ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003676059, "chapter_id": 23676, "verse_number": "१-२-६३-६०", "content_sanskrit": "एलापत्रेण विहितो नागानां तत्र प्राप्तये ।\nदक्षिणेन च मार्गोऽयं याति शूर्पारकं भुवि ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003676060, "chapter_id": 23676, "verse_number": "१-२-६३-६१", "content_sanskrit": "कर्कोटकेन नागेन कृतोऽयं तत्र प्राप्तये ।\nपश्चिमेन च मार्गोऽयं प्रभासं याति सुप्रभम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003676061, "chapter_id": 23676, "verse_number": "१-२-६३-६२", "content_sanskrit": "ऐरावतेन विहितो नागानां गमनाय च ।\nउत्तरेण च मार्गोयं येन यातुं भवान्स्थितः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003676062, "chapter_id": 23676, "verse_number": "१-२-६३-६३", "content_sanskrit": "गुप्तक्षेत्रे सिद्धलिंगं याति शक्तिगुहाऽकृतः ।\nविहितस्तक्षकेणासौ यातुं तत्र महात्मना ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003676063, "chapter_id": 23676, "verse_number": "१-२-६३-६४", "content_sanskrit": "इतीदं वर्णितं वीर विज्ञप्तिः श्रूयतां मम ।\nको भवानधुनैवेतो दैत्यपृष्ठ गतोऽभवत् ।\nअधुनैव तथैकाकी समायातोऽत्र नो वद ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003676064, "chapter_id": 23676, "verse_number": "१-२-६३-६५", "content_sanskrit": "वयं च सर्वास्ते दास्यस्त्वां पतिं प्रवृणीमहे ।\nअस्माभिः सहितः क्रीड विविधास्वत्र भूमिषु ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003676065, "chapter_id": 23676, "verse_number": "१-२-६३-६६", "content_sanskrit": "बर्बरीक उवाच ।\nअहं कुरुकुलोत्पन्नः पांडुपुत्रस्य पौत्रकः ।\nबर्बरीक इति ख्यातस्तं दैत्यं हंतुमागतः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003676066, "chapter_id": 23676, "verse_number": "१-२-६३-६७", "content_sanskrit": "स च दैत्यो हतः पापः पुनर्यास्ये महीतलम् ।\nभवतीभिश्च मे नास्ति कृत्यं भोभोः कथंचन ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003676067, "chapter_id": 23676, "verse_number": "१-२-६३-६८", "content_sanskrit": "ब्रह्मचारिव्रतं यस्मादहं सततमास्थितः ।\nइत्युक्त्वाभ्यर्च्य तल्लिंगं प्रणिपत्य च दण्डवत् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003676068, "chapter_id": 23676, "verse_number": "१-२-६३-६९", "content_sanskrit": "ऊर्ध्वमाचक्रमे वीरः कातरं ताभिरीक्षितः ।\nततो बहिः समागत्य सप्रकाशं मुखं तदा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003676069, "chapter_id": 23676, "verse_number": "१-२-६३-७०", "content_sanskrit": "प्रहर्षेणैव पूर्वस्या विजयं ददृशे दिशः ।\nतस्मिन्काले च विजयः कर्म सर्वं समाप्तवान् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003676070, "chapter_id": 23676, "verse_number": "१-२-६३-७१", "content_sanskrit": "कांत्या सूर्यसमाभास ऊर्ध्वमाचक्रमे क्षणात् ।\nततो वियद्गतं देवैः पुष्पवर्षमभून्महत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003676071, "chapter_id": 23676, "verse_number": "१-२-६३-७२", "content_sanskrit": "जगुर्गंधर्वमुख्याश्च ननृतुश्चाप्सरोगणाः ।\nविजयो बर्बरीकं च ततो वचनमब्रवीत् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003676072, "chapter_id": 23676, "verse_number": "१-२-६३-७३", "content_sanskrit": "तव प्रसादाद्वीरेश सिद्धिः प्राप्ता मयातुला ।\nचिरं जीव चिरं नंद चिरं वस चिरं जय ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003676073, "chapter_id": 23676, "verse_number": "१-२-६३-७४", "content_sanskrit": "अत एव हि साधृनां संगमिच्छंति साधवः ।\nऔषधं सर्वदोषाणां भवेत्सत्यं गमो यतः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003676074, "chapter_id": 23676, "verse_number": "१-२-६३-७५", "content_sanskrit": "त्वं च होमस्थितं भस्म सिंदूरसदृशप्रभम् ।\nनिःशल्यं सविवरकं पूर्यमाणं गृहाण च ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003676075, "chapter_id": 23676, "verse_number": "१-२-६३-७६", "content_sanskrit": "अक्षय्यमेतत्संग्रामे प्रथमं ते प्रमुंचतः ।\nशत्रूणां स्थानकं मृत्योर्देहं ध्वस्तं करिष्यति ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003676076, "chapter_id": 23676, "verse_number": "१-२-६३-७७", "content_sanskrit": "एवं सुखेन विजयः शत्रूणां ते भविष्यति ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003676077, "chapter_id": 23676, "verse_number": "१-२-६३-७८", "content_sanskrit": "बर्बरीक उवाच ।\nउपकुर्यान्निराकांक्षो यः स साधुरितीर्यते ।\nसाकांक्षमुपकुर्याद्यः साधुत्वे तस्य को गुणः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003676078, "chapter_id": 23676, "verse_number": "१-२-६३-७९", "content_sanskrit": "तद्देहि भस्म चान्यस्मै केनाप्यर्थो न मेऽण्वपि ।\nप्रसादसुमुखां दृष्टिं विना नान्यद्वृणोमि ते ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003676079, "chapter_id": 23676, "verse_number": "१-२-६३-८०", "content_sanskrit": "देवा ऊचुः ।\nकुरूणां पांडवानां च भविष्यति महान्रणः ।\nततो भूमिस्थितं भस्म प्राप्स्यंति यदि कौरवाः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003676080, "chapter_id": 23676, "verse_number": "१-२-६३-८१", "content_sanskrit": "महाननर्थो भविता पांडवानां ततः स्फुटम् ।\nतस्माद्गृहाण त्वं भस्म सोपि चक्रे तथो वचः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003676081, "chapter_id": 23676, "verse_number": "१-२-६३-८२", "content_sanskrit": "देवीभिः सहिता देवाः संमान्य विजयं च ते ।\nसिद्धैश्वर्यं ददुस्तस्मै सिद्धसेनेति नाम च ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003676082, "chapter_id": 23676, "verse_number": "१-२-६३-८३", "content_sanskrit": "एवं स विजयो विप्रः सिद्धिं लेभे सुदुर्लभाम् ।\nबर्बरीकश्च कृत्वैतद्देवीभक्तिरतोऽवसत् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003676083, "chapter_id": 23676, "verse_number": "१-२-६३-८४", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्डे कौमारिकाखंडे कार्यसिद्धिवर्णनंनाम त्रिषष्टितमोऽध्यायः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}]