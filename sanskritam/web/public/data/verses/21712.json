[{"id": 7001712000, "chapter_id": 21712, "verse_number": "१-९८-१", "content_sanskrit": "श्रीब्रह्मोवाच ।\nअथ ते संप्रवक्ष्यामि मार्कंडेयाभिधं मुने ।\nपुराणं सुमहत्पुण्यं पठतां श्रृण्वतां सदा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001712001, "chapter_id": 21712, "verse_number": "१-९८-२", "content_sanskrit": "यत्राधिकृत्य शकुनीन्सर्वधर्मनिरूपणम् ।\nमार्कंडेयपुराणं तन्नवसाहस्रमीरितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001712002, "chapter_id": 21712, "verse_number": "१-९८-३", "content_sanskrit": "मार्कंडेयमुनेः प्रश्नो जैमिनेः प्राक्समीरितः ।\nपक्षिणां धर्मसंज्ञानं ततो जन्मनिरूपणम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001712003, "chapter_id": 21712, "verse_number": "१-९८-४", "content_sanskrit": "पूर्वजन्मकथा चैषां विक्रिया चा दिवस्पतेः ।\nतीर्थयात्रा बलस्याथ द्रौपदेयकथानकम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001712004, "chapter_id": 21712, "verse_number": "१-९८-५", "content_sanskrit": "हरिश्चंद्रकथा पुण्या युद्धमाडीबकाभिधम् ।\nपितापुत्रसमाख्यानं दत्तात्रेयकथा ततः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001712005, "chapter_id": 21712, "verse_number": "१-९८-६", "content_sanskrit": "हैहयस्याथ चरितं महाख्यानसमन्वितम् ।\nमदालकसाकथा प्रोक्ता ह्यलर्कचरितान्विता ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001712006, "chapter_id": 21712, "verse_number": "१-९८-७", "content_sanskrit": "सृष्टिसंकीर्तनं पुण्यं नवधापारिकीर्तितम् ।\nकल्पांतकालनिर्देशो यक्षसृष्टिनिरूपणम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001712007, "chapter_id": 21712, "verse_number": "१-९८-८", "content_sanskrit": "रुद्रादिसृष्टिरप्युक्ता द्वीपचर्यानुकीर्तनम् ।\nमनूनां च कथा नानाकीर्तिताः पापहारिकाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001712008, "chapter_id": 21712, "verse_number": "१-९८-९", "content_sanskrit": "तासु दुर्गाकथात्यंतं पुण्यदा चाष्टमेंऽतरे ।\nतत्पश्चात्प्रणवोत्पत्तिस्त्रयीतेजः समुद्भवा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001712009, "chapter_id": 21712, "verse_number": "१-९८-१०", "content_sanskrit": "मार्तंडस्य च जन्माख्यातन्माहात्म्यसमन्विता ।\nवैवस्वतान्वयश्चापि वत्सप्रीश्चरितं ततः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001712010, "chapter_id": 21712, "verse_number": "१-९८-११", "content_sanskrit": "खनित्रस्य ततः प्रोक्ता कथा पुण्या महात्मनः ।\nअविक्षिच्चरितं चैव किमिच्छव्रतकीर्त्तनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001712011, "chapter_id": 21712, "verse_number": "१-९८-१२", "content_sanskrit": "नरिष्यंतस्य चरितं इक्ष्वाकुचरितं ततः ।\nनलस्य चरितं पश्चाद्रामचन्द्रस्य सत्कथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001712012, "chapter_id": 21712, "verse_number": "१-९८-१३", "content_sanskrit": "कुशवंशसमाख्यानं सोमवंशानुकीर्त्तनम् ।\nपुरुरवः कथा पुण्या नहुषस्य कथाद्भुता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001712013, "chapter_id": 21712, "verse_number": "१-९८-१४", "content_sanskrit": "ययातिचरितं पुण्यं यदुवंशानुकीर्त्तनम् ।\nश्रीकृष्णबालचरितं माथुरं चरितं ततः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001712014, "chapter_id": 21712, "verse_number": "१-९८-१५", "content_sanskrit": "द्वारकाचरितं चाथ कथा सर्वावतारजा ।\nततः सांख्यसमुद्देशः प्रपञ्चासत्त्वकीर्तनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001712015, "chapter_id": 21712, "verse_number": "१-९८-१६", "content_sanskrit": "मार्कंडेयस्य चरितं पुराणश्रवणे फलम् ।\nयः श्रृणोति नरो भक्त्या पुराणमिदमादरात् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001712016, "chapter_id": 21712, "verse_number": "१-९८-१७", "content_sanskrit": "मार्कंडेयाभिधं वत्स स लभेत्परमां गतिम् ।\nयस्तु व्याकुरुते चैतच्छैवं स लभते पदम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001712017, "chapter_id": 21712, "verse_number": "१-९८-१८", "content_sanskrit": "तत्प्रयच्छेल्लिखित्वा यः सौवर्णकरिसंयुतम् ।\nकार्तिक्यां द्विजवर्याय स लभेंद्ब्रह्मणः पदम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001712018, "chapter_id": 21712, "verse_number": "१-९८-१९", "content_sanskrit": "श्रृणोति श्रावयेद्वापि यश्चानुक्रमणीमिमाम् ।\nमार्कंडेयपुराणस्य स लभेद्वांछितं फलम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]