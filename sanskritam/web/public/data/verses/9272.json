[{"id": 40017873, "chapter_id": 9272, "verse_number": "1", "content_sanskrit": "राममाश्वासयानेतुलक्ष्मणेभ्रातृवत्सले । निक्षिप्यगुल्मान् स्वस्थानेतत्रागच्छद्विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40017874, "chapter_id": 9272, "verse_number": "2", "content_sanskrit": "नानाप्रहरणैर्वीरैश्चतुर्भिस्सचिवैर्वृत: । नीलाञ्जनचयाकारैर्मातङ्गैरिवयूथप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40017875, "chapter_id": 9272, "verse_number": "3", "content_sanskrit": "राघवं च महात्मानमिक्ष्वाकुकुलनन्दनम् । ददर्शमोहमापन्नंलक्ष्मणस्याङ्गमाश्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40017876, "chapter_id": 9272, "verse_number": "4", "content_sanskrit": "राघवं च महात्मानमिक्ष्वाकुकुलनन्दनम् । ददर्शमोहमापन्नंलक्ष्मणस्याङ्गमाश्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40017877, "chapter_id": 9272, "verse_number": "5", "content_sanskrit": "व्रीडितंशोकसन्तप्तंदृष्टवारामंविभीषणः । अन्तर्धुःखएनदीनात्माकिमेतदितिसोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40017878, "chapter_id": 9272, "verse_number": "6", "content_sanskrit": "विभीषणमुखंदृष्टवासुग्रीवंतांश्चवानरान् । लक्ष्मणोवाचमन्दार्थमिदंबाष्पपरिप्लुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40017879, "chapter_id": 9272, "verse_number": "7", "content_sanskrit": "हताइन्द्रजितासीताइतिश्रुत्वैवराघवः । हनूमद्वचनात्सौम्यततोमोहमुपागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40017880, "chapter_id": 9272, "verse_number": "8", "content_sanskrit": "कथयन्तंतुसौमित्रिंसन्निवार्यविभीषणः । पुष्कलार्थमिदंवाक्यंविसंज्ञंराममब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40017881, "chapter_id": 9272, "verse_number": "9", "content_sanskrit": "मनुजेन्द्रार्थरूपेणयदुक्ततुहनूमता । तदयुक्तमहंमन्येसागरस्येवशोषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40017882, "chapter_id": 9272, "verse_number": "10", "content_sanskrit": "अभिप्रायंतुजानामिरावणस्यदुरात्मनः । सीतांप्रतिमहाबाहो न च घातंकरिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]