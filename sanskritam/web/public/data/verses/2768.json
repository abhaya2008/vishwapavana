[{"id": 2082925, "chapter_id": 2768, "verse_number": "१२-२७३-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082926, "chapter_id": 2768, "verse_number": "१२-२७३-१", "content_sanskrit": "कथं राजा प्रजा रक्षेन्न च किंचित्प्रतापयेत्।\nपृच्छामि त्वां सतां श्रेष्ठ तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082927, "chapter_id": 2768, "verse_number": "१२-२७३-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082928, "chapter_id": 2768, "verse_number": "१२-२७३-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nद्युमत्सेनस्य संवादं राज्ञा सत्यवता सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082929, "chapter_id": 2768, "verse_number": "१२-२७३-३", "content_sanskrit": "अव्याहृतं व्याजहार सत्यवानिति नः श्रुतम्।\nवधाय नीयमानेषु पितुरेवानुशासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082930, "chapter_id": 2768, "verse_number": "१२-२७३-४", "content_sanskrit": "अधर्मतां याति धर्मो यात्यधर्मश्च धर्मताम्।\nवधो नाम भवेद्धर्मो नैतद्भवितुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082931, "chapter_id": 2768, "verse_number": "१२-२७३-५x", "content_sanskrit": "द्युमत्सेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082932, "chapter_id": 2768, "verse_number": "१२-२७३-५", "content_sanskrit": "अथ चेदवधो धर्मोऽधर्मः को जातुचिद्भवेत्।\nदस्यवश्चेन्न हन्येरन्सत्यवन्संकरो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082933, "chapter_id": 2768, "verse_number": "१२-२७३-६", "content_sanskrit": "ममेदमिति नास्यैतत्प्रवर्तेत कलौ युगे।\nलोकयात्रा न चैव स्यादश्च चेद्वेत्थ शंस नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082934, "chapter_id": 2768, "verse_number": "१२-२७३-७x", "content_sanskrit": "सत्यवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082935, "chapter_id": 2768, "verse_number": "१२-२७३-७", "content_sanskrit": "सर्व एव त्रयो वर्णाः कार्या ब्राह्मणबन्धनाः।\nधर्मपाशनिबद्धानां नाल्पोऽप्यपचरिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082936, "chapter_id": 2768, "verse_number": "१२-२७३-८", "content_sanskrit": "यो यस्तेषामपचरेत्तमाचक्षीत वै द्विजः।\nअयं मे न शृणोतीति तस्मिन्राजा प्रधारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082937, "chapter_id": 2768, "verse_number": "१२-२७३-९", "content_sanskrit": "तत्त्वाभावेन यच्छास्त्रं तत्कुर्यान्नान्यथा वधः।\nअसमीक्ष्यैव कर्माणि नीतिशास्त्रं यथाविधि।\nदस्यून्निहन्ति वै राजा भूयसो वाऽप्यनागसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082938, "chapter_id": 2768, "verse_number": "१२-२७३-१०", "content_sanskrit": "भार्या माता पिता पुत्रो हन्यन्ते पुरुषेण ते।\nपरेणापकृतो राजा तस्मात्सम्यक्प्रधारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082939, "chapter_id": 2768, "verse_number": "१२-२७३-११", "content_sanskrit": "असाधुश्चैव पुरुषो लभते शीतमेकदा।\nसाधोश्चापि ह्यसाधुभ्यः शोभना जायते प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082940, "chapter_id": 2768, "verse_number": "१२-२७३-१२", "content_sanskrit": "न मूलघातः कर्तव्यो नैष धर्मः सनातनः।\nअपि खल्ववधेनैव प्रायश्चित्तं विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082941, "chapter_id": 2768, "verse_number": "१२-२७३-१३", "content_sanskrit": "उद्वे तेन बन्धेन विरूपकरणेन च।\nवधदण्डेन क्लिश्या न पुरोहितससदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2082942, "chapter_id": 2768, "verse_number": "१२-२७३-१४", "content_sanskrit": "यदा पुरोहितं वा ते पर्येयुः शरणैपिणः।\nकरिष्यामः पुनर्ब्रह्मन्न पापमिति वादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2082943, "chapter_id": 2768, "verse_number": "१२-२७३-१५", "content_sanskrit": "तदा विसर्गमर्हाः स्युरितीदं धातृशासनम्।\nविभ्रद्दण्डाजिनं मुण्डो ब्राह्मणोऽर्हति शासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2082944, "chapter_id": 2768, "verse_number": "१२-२७३-१६", "content_sanskrit": "गरीयांसो गरीयांसमपराधे पुनः पुनः।\nतदा विसर्गमर्हन्ति न यथा प्रथमे तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2082945, "chapter_id": 2768, "verse_number": "१२-२७३-१७x", "content_sanskrit": "द्युमत्सेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2082946, "chapter_id": 2768, "verse_number": "१२-२७३-१७", "content_sanskrit": "यत्रयत्रैव शक्येरन्संयन्तुं समये प्रजाः।\nस तावान्प्रोच्यते धर्मो यावन्न प्रतिलङ्घ्यते।\nअहन्यमानेषु पुनः सर्वमेव पराभवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2082947, "chapter_id": 2768, "verse_number": "१२-२७३-१८", "content_sanskrit": "पूर्वे पूर्वतरे चैव सुशास्या ह्यभवञ्जनाः।\nमृदवः सत्यभूयिष्ठा अल्पद्रोहाल्पमन्यवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2082948, "chapter_id": 2768, "verse_number": "१२-२७३-१९", "content_sanskrit": "पुरा धिग्दण्ड एवासीद्वाग्दण्डस्तदनन्तरम्।\nआसीदादानदण्डोऽपि वधदण्डोऽद्य वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2082949, "chapter_id": 2768, "verse_number": "१२-२७३-२०", "content_sanskrit": "वधेनापि न शक्यन्ते नियन्तुमपरे जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2082950, "chapter_id": 2768, "verse_number": "१२-२७३-२१", "content_sanskrit": "नैव दस्युर्मनुष्याणां न देवानामिति श्रुतिः।\nन गन्धर्वपितृणां च कः कस्येह न कश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2082951, "chapter_id": 2768, "verse_number": "१२-२७३-२२", "content_sanskrit": "पक्वं श्मशानादादत्ते पिशाचांश्चापि दैवतम्।\nतेषु यः समयं कश्चित्कुर्वीत हतबुद्धिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2082952, "chapter_id": 2768, "verse_number": "१२-२७३-२३x", "content_sanskrit": "सत्यवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2082953, "chapter_id": 2768, "verse_number": "१२-२७३-२३", "content_sanskrit": "तान्न शक्नोषि चेत्साधून्परित्रातुमहिंसया।\nकस्यचिद्भूतभव्यस्य लोभेनान्तं तथा कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2082954, "chapter_id": 2768, "verse_number": "१२-२७३-२४", "content_sanskrit": "राजानो लोकयात्रार्थं तप्यन्ते परमं तपः।\nतेऽपत्रपन्ति तादृग्भ्यस्तथावृत्ता भवन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2082955, "chapter_id": 2768, "verse_number": "१२-२७३-२५", "content_sanskrit": "वित्रास्यमानाः सुकृतो न कामाद्धन्ति दुष्कृतीन्।\nसुकृतेनैव राजानो भूयिष्ठं शासते प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2082956, "chapter_id": 2768, "verse_number": "१२-२७३-२६", "content_sanskrit": "श्रेयसः श्रेयसोऽप्येवं वृत्तं लोकोऽनुवर्तते।\nसदैव हि गुरोर्वृत्तमनुवर्तन्ति मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2082957, "chapter_id": 2768, "verse_number": "१२-२७३-२७x", "content_sanskrit": "द्युमत्सेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2082958, "chapter_id": 2768, "verse_number": "१२-२७३-२७", "content_sanskrit": "आत्मानमसमाधाय समाधित्सति यः परान्।\nविषयेष्विन्द्रियवशं मानवाः प्रहसन्ति तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2082959, "chapter_id": 2768, "verse_number": "१२-२७३-२८", "content_sanskrit": "यो राज्ञो दम्भमोहेन किंचित्कुर्यादसांप्रतम्।\nसर्वोपायैर्नियम्यः स तथा पापान्निवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2082960, "chapter_id": 2768, "verse_number": "१२-२७३-२९", "content_sanskrit": "आत्मैवादौ नियन्तव्यो दुष्कृंतं संनियच्छता।\nदण्डयेच्च महादण्डैरपि बन्धूननन्तरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2082961, "chapter_id": 2768, "verse_number": "१२-२७३-३०", "content_sanskrit": "`यो राजा लोभमोहेन किंचित्कुर्यादसांप्रतम्।\nसर्वोपायैर्नियम्यः स तथा पापान्निवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2082962, "chapter_id": 2768, "verse_number": "१२-२७३-३१", "content_sanskrit": "यत्र वै पापकृन्नीचो न महद्दुःखमर्च्छति।\nवर्धन्ते तत्र पापानि धर्मो ह्रसति च ध्नुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2082963, "chapter_id": 2768, "verse_number": "१२-२७३-३२", "content_sanskrit": "इति कारुण्यशीलस्तु विद्वान्वै ब्राह्मणोऽन्वशात्।\nइति चैवानुशिष्टोऽस्मि पूर्वैस्तातपितामहैः।\nआश्वासयद्भिः सुभृशमनुक्रोशात्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2082964, "chapter_id": 2768, "verse_number": "१२-२७३-३३", "content_sanskrit": "एतत्प्रथमकल्पेन राजा कृतयुगे जयेत्।\nपादोनेनापि धर्मेण गच्छेत्रेतायुगे तथा।\nद्वापरे तु द्विपादेन पादेन त्ववरे युगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2082965, "chapter_id": 2768, "verse_number": "१२-२७३-३४", "content_sanskrit": "तथा कलियुगे प्राप्ते राज्ञो दुश्चरितेन ह।\nभवेत्कालविशेषेण कला धर्मस्य पोडशी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2082966, "chapter_id": 2768, "verse_number": "१२-२७३-३५", "content_sanskrit": "अथ प्रथमकल्पेन सत्यवन्संकरो भवेत्।\nआयुः शक्तिं च कालं च निर्दिश्य तप आदिशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2082967, "chapter_id": 2768, "verse_number": "१२-२७३-३६", "content_sanskrit": "सत्याय हि यथा नेह जह्याद्धर्मफलं महत्।\nभूतानामनुकम्पार्थं मनुः स्वायंभुवोऽब्रवीत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2082968, "chapter_id": 2768, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि त्रिसप्तत्यधिकद्विशततमोऽध्यायः॥ २७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]