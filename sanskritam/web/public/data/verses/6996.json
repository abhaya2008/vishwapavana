[
  {
    "id": 20129826,
    "chapter_id": 6996,
    "verse_number": "13.1",
    "content_sanskrit": "अथ त्रयोदशो ऽध्यायः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20129827,
    "chapter_id": 6996,
    "verse_number": "13.2",
    "content_sanskrit": "ये तु पूर्वं मया प्रोक्तास्त्रयो वै नाट्यमण्डपाः । तेषां विभागं विज्ञाय ततः कक्ष्यां प्रयोजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20129828,
    "chapter_id": 6996,
    "verse_number": "13.3",
    "content_sanskrit": "ये नेपथ्यगृहद्वारे मया पूर्वं प्रकीर्तिते । तयोर्भाण्डस्य विन्यासो मध्ये कार्यः प्रयोक्तृभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20129829,
    "chapter_id": 6996,
    "verse_number": "13.4",
    "content_sanskrit": "कक्ष्याविभागो निर्देश्यो रङ्गपीठपरिक्रमात् । परिक्रमेण रङ्गस्य कक्ष्या ह्यन्या विधीयते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20129830,
    "chapter_id": 6996,
    "verse_number": "13.5",
    "content_sanskrit": "कक्ष्याविभागे ज्ञेयानि गृहाणि नगराणि च । उद्यानारामसरितस्त्वाश्रमा अटवी तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20129831,
    "chapter_id": 6996,
    "verse_number": "13.6",
    "content_sanskrit": "पृथिवी सागराश्चैव त्रैलोक्यं सचराचरम् । वर्षाणि सप्तद्वीपाश्च पर्वता विविधास्तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20129832,
    "chapter_id": 6996,
    "verse_number": "13.7",
    "content_sanskrit": "अलोकश्चैव लोकश्च रसातलमथापि च । दैत्यनागालयाश्चैव गृहाणि भवनानि च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20129833,
    "chapter_id": 6996,
    "verse_number": "13.8",
    "content_sanskrit": "नगरे वा वने वापि वर्षे वा पर्वते ऽपि वा । यत्र वार्ता प्रवर्तेत तत्र कक्ष्यां प्रवर्तयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20129834,
    "chapter_id": 6996,
    "verse_number": "13.9",
    "content_sanskrit": "बाह्यं वा मध्यमं वापि तथैवाभ्यन्तरं पुनः । दूरं वा सन्निकृष्टं वा देशं तु परिकल्पयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20129835,
    "chapter_id": 6996,
    "verse_number": "13.10",
    "content_sanskrit": "पूर्वप्रविष्टा ये रङ्गं ज्ञेयास्ते ऽभ्यन्तरा बुधैः । पश्चात्प्रविष्टा विज्ञेयाः कक्ष्याभागे तु बाह्यतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20129836,
    "chapter_id": 6996,
    "verse_number": "13.11",
    "content_sanskrit": "तेषां तु दर्शनेच्छुर्यः प्रविशेद्रङ्गमण्डपम् । दक्षिणाभिमुखः सो ऽथ कुर्यादात्मनिवेदनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20129837,
    "chapter_id": 6996,
    "verse_number": "13.12",
    "content_sanskrit": "यतो मुखं भवेद्भाण्डं द्वारं नेपथ्यकस्य च । सा मन्तव्या तु दिक् पूर्वा नाट्ययोगे न नित्यशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20129838,
    "chapter_id": 6996,
    "verse_number": "13.13",
    "content_sanskrit": "निष्क्रामेद्यश्च तस्माद्वै स तेनैव तथा व्रजेत् । यतस्तस्य कृतं तेन पुरुषेण निवेदनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20129839,
    "chapter_id": 6996,
    "verse_number": "13.14",
    "content_sanskrit": "निष्क्रान्तो ऽर्थवशाच्चापि प्रविशेद्यदि तद्गृहम् । यतः प्राप्तः स पुरुषस्तेन मार्गेण निष्क्रमेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20129840,
    "chapter_id": 6996,
    "verse_number": "13.15",
    "content_sanskrit": "अथवार्थवशाच्चापि तेनैव सह गच्छति । तथैव प्रविशेत् गेहमेकाकी सहितो ऽपि वा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20129841,
    "chapter_id": 6996,
    "verse_number": "13.16",
    "content_sanskrit": "तयोश्चापि प्रविशतोः कक्ष्यामन्यां विनिर्दिशेत् । परिक्रमेण रङ्गस्य त्वन्या कक्ष्या विधीयते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20129842,
    "chapter_id": 6996,
    "verse_number": "13.17",
    "content_sanskrit": "समैश्च सहितो गच्छेन्नीचैश्च परिवाहितः । अथ प्रेक्षणिकाश्चापि विज्ञेया ह्यग्रतो गतौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20129843,
    "chapter_id": 6996,
    "verse_number": "13.18",
    "content_sanskrit": "सैव भूमिस्तु बहुभिर्विकृष्टा स्यात्परिक्रमैः । मध्या वा सन्निकृष्टा वा तेषामेवं विकल्पयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20129844,
    "chapter_id": 6996,
    "verse_number": "13.19",
    "content_sanskrit": "नगरे वा वने वापि सागरे पर्वते ऽपि वा । दिव्यानां गमनं कार्यं द्वीपे वर्षेषु वा पुनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20129845,
    "chapter_id": 6996,
    "verse_number": "13.20",
    "content_sanskrit": "आकाशेन विमानेन माययाप्यथ वा पुनः । विविधाभिः क्रियाभिर्वा नानार्थाभिः प्रयोगतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20129846,
    "chapter_id": 6996,
    "verse_number": "13.21",
    "content_sanskrit": "नाटके च्छन्नवेषाणां दिव्यानां भूमिसञ्चरः । मानुषे कारणादेषां यथा भवति दर्शनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20129847,
    "chapter_id": 6996,
    "verse_number": "13.22",
    "content_sanskrit": "भारते त्वथ हैमे वा हरिवर्ष इलावृते । रम्ये किंपुरुषे वापि कुरुषूत्तरकेषु वा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20129848,
    "chapter_id": 6996,
    "verse_number": "13.23",
    "content_sanskrit": "दिव्यानां छन्दगमनं सर्ववर्षेषु कीर्तितम् । भारते मानुषाणाञ्च गमनं संविधीयते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20129849,
    "chapter_id": 6996,
    "verse_number": "13.24",
    "content_sanskrit": "गच्छेद्यदि विकृष्टस्तु देशकालवशान्नरः । अङ्कच्छेदे तमन्यस्मिन् निर्दिशेद्धि प्रवेशके ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20129850,
    "chapter_id": 6996,
    "verse_number": "13.25",
    "content_sanskrit": "अह्नः प्रमाणं गत्वा तु कार्यलाभं विनिर्दिशेद् । तथालाभे तु कार्यस्य अङ्कच्छेदो विधीयते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20129851,
    "chapter_id": 6996,
    "verse_number": "13.26",
    "content_sanskrit": "क्षणो मुहूर्तो यानो वा दिवसो वापि नाटके । एकाङ्के स विधातव्यो बीजस्यार्थवशानुगः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20129852,
    "chapter_id": 6996,
    "verse_number": "13.27",
    "content_sanskrit": "अङ्कच्छेदे तु निर्वृत्तं मासं वा वर्षमेव वा । नोर्ध्वं वर्षात्प्रकर्तव्यं कार्यमङ्कसमाश्रयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20129853,
    "chapter_id": 6996,
    "verse_number": "13.28",
    "content_sanskrit": "एवं तु भारते वर्षे कक्ष्या कार्या प्रयोगतः । मानुषाणां गतिर्या तु दिव्यानान्तु निबोधत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20129854,
    "chapter_id": 6996,
    "verse_number": "13.29",
    "content_sanskrit": "हिमवत्पृष्ठसंस्थे तु कैलासे पर्वतोत्तमे । यक्षाश्च गुह्यकाश्चैव धनदानुचराश्च ये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20129855,
    "chapter_id": 6996,
    "verse_number": "13.30",
    "content_sanskrit": "रक्षःपिशाचभूताश्च सर्वे हैमवताः स्मृताः । हेमकूटे च गन्धर्वा विज्ञेयाः साप्सरोगणाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20129856,
    "chapter_id": 6996,
    "verse_number": "13.31",
    "content_sanskrit": "सर्वे नागाश्च निषधे शेषवासुकितक्षकाः । महामेरौ त्रयस्त्रिंशद् ज्ञेया देवगणा बुधैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20129857,
    "chapter_id": 6996,
    "verse_number": "13.32",
    "content_sanskrit": "नीले तु वैडूर्यमये सिद्धा ब्रह्मर्षयस्तथा । दैत्यानां दानवानाञ्च श्वेतपर्वत इष्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20129858,
    "chapter_id": 6996,
    "verse_number": "13.33",
    "content_sanskrit": "पितरश्चापि विज्ञेया शृङ्गवन्तं समाश्रिताः । इत्येते पर्वताः श्रेष्ठा दिव्यावासाः प्रकीर्तिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20129859,
    "chapter_id": 6996,
    "verse_number": "13.34",
    "content_sanskrit": "तेषां कक्ष्याविभागश्च जम्बूद्वीपे भवेदयम् । तेषां न चेष्टितं कार्यं स्वैः स्वैः कर्मपराक्रमैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20129860,
    "chapter_id": 6996,
    "verse_number": "13.35",
    "content_sanskrit": "परिच्छ\\(च्छे\\)दविशेषस्तु तेषां मानुषलोकवत् । सर्वे भावाश्च दिव्यानां कार्या मानुषसंश्रयाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20129861,
    "chapter_id": 6996,
    "verse_number": "13.36",
    "content_sanskrit": "तेषान्त्वनिमिषत्वं यत्तन्न कार्यं प्रयोक्तृभिः । इह भावा रसाश्चैव दृष्टावेव प्रतिष्ठिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20129862,
    "chapter_id": 6996,
    "verse_number": "13.37",
    "content_sanskrit": "दृष्ट्या हि सूचितो भावः पुनरङ्गैर्विभाव्यते । एवं कक्ष्याविभागस्तु मया प्रोक्तो द्विजोत्तमाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20129863,
    "chapter_id": 6996,
    "verse_number": "13.38",
    "content_sanskrit": "पुनश्चैव प्रवक्ष्यामि प्रवृत्तीनान्तु लक्षणम् । चतुर्विधा प्रवृत्तिश्च प्रोक्ता नाट्यप्रयोगतः । आवन्ती दाक्षिणात्या च पाञ्चाली चोढ्रमागधी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20129864,
    "chapter_id": 6996,
    "verse_number": "13.39",
    "content_sanskrit": "अत्राह प्रवृत्तिरिति कस्मात् उच्यते पृथिव्यां नानादेशवेषभाषाचारवार्ताः प्रख्यापयतीति वृत्तिः । प्रवृत्तिश्च निवेदने । अत्राह - यथा पृथिव्यां बहवो देशाः सन्ति , कथमासां चतुर्विधत्वम् उपपन्नं, समानलक्षणश्चासां प्रयोग उच्यते सत्यमेतत् । समानलक्षण आसां प्रयोगः । किन्तु नानादेशवेषभाषाचारो लोक इति कृत्वा लोकानुमतेन वृत्तिसंश्रितस्य नाट्यस्य वृत्तीनां मया चतुर्विधत्वमभिहितं भारती सात्त्वती कैशिक्यारभटी चेति । वृत्तिसंश्रितैश्च प्रयोगैरभिहिता देशाः । यतः प्रवृत्तिचतुष्टयमभिनिर्वृत्तं प्रयोगश्चोत्पादितः । तत्र दाक्षिणात्यास्तावत् बहुनृत्तगीतवाद्या कैशिकीप्रायाः चतुरमधुरललिताङ्गाभिनयाश्च । तद्यथा - महेन्द्रो मलयः सह्यो मेकलः पालमञ्जरः । एतेषु ये श्रिता देशाः स ज्ञेयो दक्षिणापथः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20129865,
    "chapter_id": 6996,
    "verse_number": "13.40",
    "content_sanskrit": "कोसलाग्ग्स्तोशलाश्चैव कलिङ्गा यवना खसाः । द्रविडान्ध्रमहाराष्ट्रा वैष्णा वै वानवासजाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20129866,
    "chapter_id": 6996,
    "verse_number": "13.41",
    "content_sanskrit": "दक्षिणस्य समुद्रस्य तथा विन्ध्यस्य चान्तरे । ये देशास्तेषु युञ्जीत दाक्षिणात्यां तु नित्यशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20129867,
    "chapter_id": 6996,
    "verse_number": "13.42",
    "content_sanskrit": "आवन्तिका वैदिशिकाः सौराष्ट्रा मालवास्तथा । सैन्धवास्त्वथ सौवीरा आवर्ताः सार्बुदेयकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20129868,
    "chapter_id": 6996,
    "verse_number": "13.43",
    "content_sanskrit": "दाशार्णास्त्रैपुराश्चैव तथा वै मार्तिकावताः । कुर्वन्त्यावन्तिकीमेते प्रवृत्तिं नित्यमेव तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20129869,
    "chapter_id": 6996,
    "verse_number": "13.44",
    "content_sanskrit": "सात्त्वतीं कैशिकीं चैव वृत्तिमेषां समाश्रिता । भवेत् प्र्योगो नाट्ये ऽत्र स तु कार्यः प्रयोक्तृभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20129870,
    "chapter_id": 6996,
    "verse_number": "13.45",
    "content_sanskrit": "अङ्गा वङ्गाः कलिङ्गाश्च वत्साश्चैवोढ्रमागधाः । पौण्ड्रा नेपालकाश्चैव अन्तर्गिरिबहिर्गिराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20129871,
    "chapter_id": 6996,
    "verse_number": "13.46",
    "content_sanskrit": "तथा प्लवङ्गमा ज्ञेया मलदा मल्लवर्तकाः । ब्रह्मोत्तरप्रभृतयो भार्गवा मार्गवास्तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20129872,
    "chapter_id": 6996,
    "verse_number": "13.47",
    "content_sanskrit": "प्राज्योतिषाः पुलिन्दाश्च वैदेहास्ताम्रलिप्तकाः । प्राङ्गाः प्रावृतयश्चैव युञ्जन्तीहोढ्रमागधीम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20129873,
    "chapter_id": 6996,
    "verse_number": "13.48",
    "content_sanskrit": "अन्ये ऽपि देशाः प्राच्यां ये पुराणे सम्प्रकीर्तिताः । तेषु प्रयुज्यते ह्येषा प्रवृत्तिश्चोढ्रमागधी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20129874,
    "chapter_id": 6996,
    "verse_number": "13.49",
    "content_sanskrit": "पाञ्चाला सौरसेनाश्च काश्मीरा हस्तिनापुराः । बाह्लीका शल्यकाश्चैव मद्रकौशीनरास्तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20129875,
    "chapter_id": 6996,
    "verse_number": "13.50",
    "content_sanskrit": "हिमवत्संश्रिता ये तु गङ्गायाश्चोत्तरां दिशम् । ये श्रिता वै जनपदास्तेषु पाञ्चालमध्यमाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20129876,
    "chapter_id": 6996,
    "verse_number": "13.51",
    "content_sanskrit": "पाञ्चालमध्यमायां तु सात्त्वत्यारभटी स्मृता । प्रयोगस्त्वल्पगीतार्थ आविद्धगतिविक्रमः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20129877,
    "chapter_id": 6996,
    "verse_number": "13.52",
    "content_sanskrit": "द्विधा क्रिया भवत्यासां रङ्गपीठपरिक्रमे । प्रदक्षिणप्रदेशा च तथा चाप्यप्रदक्षिणा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20129878,
    "chapter_id": 6996,
    "verse_number": "13.53",
    "content_sanskrit": "आवन्ती दाक्षिणात्या च प्रदक्षिणपरिक्रमे । अपसव्यप्रदेशास्तु पाञ्चाली चोढ्रमागधी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20129879,
    "chapter_id": 6996,
    "verse_number": "13.54",
    "content_sanskrit": "आवन्त्यां दाक्षिणात्यायां पार्श्वद्वारमथोत्तरम् । पाञ्चाल्यामोढ्रमागध्यां योज्यं द्वारं तु दक्षिणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20129880,
    "chapter_id": 6996,
    "verse_number": "13.55",
    "content_sanskrit": "एकीभूताः पुनश्चैताः प्रयोक्तव्याः प्रयोक्तृभिः । पार्षदं देशकालौ वाप्यर्थयुक्तिमवेक्ष्य च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20129881,
    "chapter_id": 6996,
    "verse_number": "13.56",
    "content_sanskrit": "येषु देशेषु या कार्या प्रवृत्तिः परिकीर्तिता । तद्वृत्तिकानि रूपाणि तेषु तज्ज्ञः प्रयोजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20129882,
    "chapter_id": 6996,
    "verse_number": "13.57",
    "content_sanskrit": "एकीभूताः पुनस्त्वेता नाटकादौ भवन्ति हि । अवेक्ष्य वृत्तिबाहुल्यं तत्तत्कर्म समाचरेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20129883,
    "chapter_id": 6996,
    "verse_number": "13.58",
    "content_sanskrit": "सार्थे बाहुल्यमेकस्य शेषाणामथ बुद्धिमान् । येषामन्यस्य बाहुल्यं प्रवृत्तिं पूरयेत्तदा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20129884,
    "chapter_id": 6996,
    "verse_number": "13.59",
    "content_sanskrit": "प्रयोगो द्विविधश्चैव विज्ञेयो नाटकाश्रयः । सुकुमारस्तथाविद्धो नाट्ययुक्तिसमाश्रयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20129885,
    "chapter_id": 6996,
    "verse_number": "13.60",
    "content_sanskrit": "यत्त्वाविद्धाङ्गहारन्तु च्छेद्यभेद्याहवात्मकम् । मायेन्द्रजालबहुलं पुस्तनेपथ्यसंयुतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20129886,
    "chapter_id": 6996,
    "verse_number": "13.61",
    "content_sanskrit": "पुरुषैर्बहुभिर्युक्तमल्पस्त्रीकं तथैव च । सात्त्वत्यारभटीयुक्तं नाट्यमाविद्धसंज्ञितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20129887,
    "chapter_id": 6996,
    "verse_number": "13.62",
    "content_sanskrit": "डिमः समवकारश्च व्यायोगेहामृगौ तथा । एतान्याविद्धसंज्ञानि विज्ञेयानि प्रयोक्तृभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20129888,
    "chapter_id": 6996,
    "verse_number": "13.63",
    "content_sanskrit": "एषां प्रयोगः कर्तव्यो दैत्यदानवराक्षसैः । उद्धता ये च पुरुषाः शौर्यवीर्यबलान्विताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20129889,
    "chapter_id": 6996,
    "verse_number": "13.64",
    "content_sanskrit": "नाटकं सप्रकरणं भाणो वीथ्यङ्कनाटिके । सुकुमारप्रयोगाणि मानुषेष्वाश्रितास्तु ये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20129890,
    "chapter_id": 6996,
    "verse_number": "13.65",
    "content_sanskrit": "अथ बाह्यप्रयोगेषु प्रेक्षागृहविवर्जिते । विदिक्ष्वपि भवेद्रङ्गः कदाचिद् भर्तुराज्ञया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20129891,
    "chapter_id": 6996,
    "verse_number": "13.66",
    "content_sanskrit": "पृष्ठ कुतपं नाट्ये युक्ता यतो मुखं भरताः । सा पूर्वा मन्तव्या प्रयोगकाले तु नाट्यज्ञैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20129892,
    "chapter_id": 6996,
    "verse_number": "13.67",
    "content_sanskrit": "द्वाराणि षट् चैव भवन्ति चास्य रङ्गस्य दिग्भागविनिश्चितानि । नाट्यप्रयोगेण खलु प्रवेशे प्राच्यां प्रतीच्यां च दिशि प्रवेशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20129893,
    "chapter_id": 6996,
    "verse_number": "13.68",
    "content_sanskrit": "विधानमुत्क्रम्य यथा च रङ्गे विना प्रमाणाद्विदिशः प्रयोगे । द्वारन्तु यस्मात्समृदङ्गभाण्डं प्राचीं दिशं तां मनसाऽध्यवस्येत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20129894,
    "chapter_id": 6996,
    "verse_number": "13.69",
    "content_sanskrit": "वयो ऽनुरूपः प्रथमन्तु वेशो वेशो ऽनुरूपश्च गतिप्रचारः । गतिप्रचारानुगतश्च पाठ्यं । पाठ्यानुरूपाभिनयश्च कार्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20129895,
    "chapter_id": 6996,
    "verse_number": "13.70",
    "content_sanskrit": "धर्मी या द्विविधा प्रोक्ता मया पूर्वं द्विजोत्तमाः । लौकिकी नाट्यधर्मी च तयोर्वक्ष्यामि लक्षणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20129896,
    "chapter_id": 6996,
    "verse_number": "13.71",
    "content_sanskrit": "स्वभावभावोपगतं शुद्धं त्वविकृतं तथा । लोकवार्ताक्रियोपेतमङ्गलीलाविवर्जितम् ॥",
