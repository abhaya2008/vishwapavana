[{"id": 40017331, "chapter_id": 9261, "verse_number": "1", "content_sanskrit": "ततोहतान्राक्षसपुङ्गवांस्तान् देवान्तकादित्रिशिरोतिकायान् । रक्षोगणास्तत्रहतावशिष्टास्तेरावणायत्वरिताश्शशंसुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40017332, "chapter_id": 9261, "verse_number": "2", "content_sanskrit": "ततोहतांस्तान् सहसानिशम्यराजामुमोहपरिप्लुताक्षः । पुत्रक्षयंभ्रातृवधं च घोरंविचिन्त्यराजाविपुलंप्रदध्यौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40017333, "chapter_id": 9261, "verse_number": "3", "content_sanskrit": "ततस्तुराजानमुदीक्ष्यदीनंशोकार्णवेसम्परिपुप्लुवानम् । रथर्षभोराक्षसराजसूनुस्तमिन्द्रजिद्वाक्यमिदंबभाषे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40017334, "chapter_id": 9261, "verse_number": "4", "content_sanskrit": "न तात मोहंपरिगन्तुमर्हसियत्रेन्द्रजिजजीवतिराक्षसेन्द्र । नेन्द्रारिबाणाभिहतोहिकश्चित्प्राणान् समर्थस्समरेऽभिपातुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40017335, "chapter_id": 9261, "verse_number": "5", "content_sanskrit": "पश्याद्यरामंसहलक्ष्मणेनमद्बाणनिर्भिन्नविकीर्णदेहम् । गतायुषंभूमितलेशयानंशितैश्शरैराचितसर्वगात्रम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40017336, "chapter_id": 9261, "verse_number": "6", "content_sanskrit": "इमांप्रतिज्ञांशृणुशक्रशत्रोःसुनिश्चितांपौरुषदैवयुक्ताम् । अद्यैवरामंसहलक्ष्मणेनसन्तर्पयिष्यामिशरैरमोघैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40017337, "chapter_id": 9261, "verse_number": "7", "content_sanskrit": "अद्येन्द्रवैवस्वतविष्णुमित्रसाध्याश्चवैश्वानरचन्द्रसूर्याः । द्रक्ष्यन्तुमेविक्रममप्रमेयंविष्णोरिवोग्रंबलियज्ञवाटे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40017338, "chapter_id": 9261, "verse_number": "8", "content_sanskrit": "स एवमुक्त्वात्रिदशेन्द्रशत्रुरापृच्छयराजानमदीनसत्त्वः । समारुरोहानितुल्यवेगंरथंखरश्रेष्ठसमाधियुक्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40017339, "chapter_id": 9261, "verse_number": "9", "content_sanskrit": "तमास्थायमहातेजारथंहरिरथोपमम् । जगामसहसातत्रयत्रयुद्धमरिन्दमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40017340, "chapter_id": 9261, "verse_number": "10", "content_sanskrit": "तंप्रस्थितंमहात्मानमनुजग्मुर्महाबलाः । सम्हर्षमाणाबहनोधनुष्प्रवरपाणयः ॥ गजस्कन्धगताःकेचित्केचित्प्रवरवाजिभिः । व्याघ्रवृश्चिकमार्जारखरोरोष्ट्रैश्चभुजङ्गमैः ॥ वराहैश्श्वापदैस्सिंहैर्जम्बुकैःपर्वतोपमैः । काकहंसमयूरैश्चराक्षसाभीमविक्रमाः ॥ प्रासमुद्गरनिस्त्रिंशपरश्वथगदाधराः । भुशुण्डिमुद्गरायष्टिशतघ्नीपरिघायुधा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40017341, "chapter_id": 9261, "verse_number": "11", "content_sanskrit": "तंप्रस्थितंमहात्मानमनुजग्मुर्महाबलाः । सम्हर्षमाणाबहनोधनुष्प्रवरपाणयः ॥ गजस्कन्धगताःकेचित्केचित्प्रवरवाजिभिः । व्याघ्रवृश्चिकमार्जारखरोरोष्ट्रैश्चभुजङ्गमैः ॥ वराहैश्श्वापदैस्सिंहैर्जम्बुकैःपर्वतोपमैः । काकहंसमयूरैश्चराक्षसाभीमविक्रमाः ॥ प्रासमुद्गरनिस्त्रिंशपरश्वथगदाधराः । भुशुण्डिमुद्गरायष्टिशतघ्नीपरिघायुधा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40017342, "chapter_id": 9261, "verse_number": "12", "content_sanskrit": "तंप्रस्थितंमहात्मानमनुजग्मुर्महाबलाः । सम्हर्षमाणाबहनोधनुष्प्रवरपाणयः ॥ गजस्कन्धगताःकेचित्केचित्प्रवरवाजिभिः । व्याघ्रवृश्चिकमार्जारखरोरोष्ट्रैश्चभुजङ्गमैः ॥ वराहैश्श्वापदैस्सिंहैर्जम्बुकैःपर्वतोपमैः । काकहंसमयूरैश्चराक्षसाभीमविक्रमाः ॥ प्रासमुद्गरनिस्त्रिंशपरश्वथगदाधराः । भुशुण्डिमुद्गरायष्टिशतघ्नीपरिघायुधा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40017343, "chapter_id": 9261, "verse_number": "13", "content_sanskrit": "तंप्रस्थितंमहात्मानमनुजग्मुर्महाबलाः । सम्हर्षमाणाबहनोधनुष्प्रवरपाणयः ॥ गजस्कन्धगताःकेचित्केचित्प्रवरवाजिभिः । व्याघ्रवृश्चिकमार्जारखरोरोष्ट्रैश्चभुजङ्गमैः ॥ वराहैश्श्वापदैस्सिंहैर्जम्बुकैःपर्वतोपमैः । काकहंसमयूरैश्चराक्षसाभीमविक्रमाः ॥ प्रासमुद्गरनिस्त्रिंशपरश्वथगदाधराः । भुशुण्डिमुद्गरायष्टिशतघ्नीपरिघायुधा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40017344, "chapter_id": 9261, "verse_number": "14", "content_sanskrit": "स शङ्खनिनदैःपूर्णैर्भेरीणांचापिनिस्स्वनैः । जगामत्रिदशेन्द्रास्तूयमानोनिशाचरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40017345, "chapter_id": 9261, "verse_number": "15", "content_sanskrit": "स शङ्खशशिवर्णेनछत्रेणरिपुसूदनः । रराजप्रतिपूर्णेननभश्चन्द्रमसायथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40017346, "chapter_id": 9261, "verse_number": "16", "content_sanskrit": "अवीज्यतततोवीरोहैमैर्हेमविभूषितैः । चारुचामरमुख्यैश्चमुख्यस्सर्वधनुष्मताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40017347, "chapter_id": 9261, "verse_number": "17", "content_sanskrit": "स तुदृष्टवाविनिर्यान्तंबलेनमहातावृतम् । राक्षसाधिपतिश्रशीमान् रावणःपुत्रमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40017348, "chapter_id": 9261, "verse_number": "18", "content_sanskrit": "त्वमप्रतिरथःपुत्रत्वयावैवासवोजितः । किम्पुनर्मानुषंधृष्यंनिहनिष्यसिराघवम् ॥ तथोक्तोराक्षसेन्द्रेणप्रत्यगृह्णान्महाशिषः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40017349, "chapter_id": 9261, "verse_number": "19", "content_sanskrit": "तस्त्विन्द्रजितालङ्कासूर्यप्रतिमतेजसा ॥ रराजाप्रतिवीर्येणद्यौरिवार्केणभास्वता ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40017350, "chapter_id": 9261, "verse_number": "20", "content_sanskrit": "सम्प्राप्यमहातेजायुद्धभूमिमरिन्दमः ॥ स्थापयामासरक्षांसिरथंप्रतिसमन्ततः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40017351, "chapter_id": 9261, "verse_number": "21", "content_sanskrit": "ततस्तुहुतभोक्तारंहुतभुक्सदृशप्रभः ॥ जुहावराक्षसश्रेष्ठोमन्त्रवद्विधिवत्तदा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40017352, "chapter_id": 9261, "verse_number": "22", "content_sanskrit": "सहविर्लाजसंस्कारैर्माल्यगन्धपुरस्कृतैः ॥ जुहुवेपावकंतत्रराक्षनेन्द्रःप्रतापवान् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40017353, "chapter_id": 9261, "verse_number": "23", "content_sanskrit": "शस्त्राणिशरपत्राणिसमिधोऽथविभीतकाः ॥ लोहितानि च वासांसिस्रुवंकार्ष्णायसंतथा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40017354, "chapter_id": 9261, "verse_number": "24", "content_sanskrit": "सतत्राग्निंसमास्तीर्यशरपत्रैस्सतोमरैः ॥ छागस्यकृष्णवर्णस्यगळंजग्राहजीवतः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40017355, "chapter_id": 9261, "verse_number": "25", "content_sanskrit": "सकृदेवसमिद्धस्यविधूमस्यमहार्चिषः ॥ बभूवुस्तानिलिङ्गानिविजयंयान्यदर्शयन् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40017356, "chapter_id": 9261, "verse_number": "26", "content_sanskrit": "प्रदक्षिणावर्तशिखस्तप्तकाञ्चनभूषणः ॥ हविस्तत्प्रतिजग्राहपावकस्स्वयमास्थितः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40017357, "chapter_id": 9261, "verse_number": "27", "content_sanskrit": "सोऽस्त्रमाहारयामासब्राह्ममिन्द्ररिपुस्तदा ॥ धनुश्चात्मरथंचैवसर्वंतत्राभ्यमन्त्रयत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40017358, "chapter_id": 9261, "verse_number": "28", "content_sanskrit": "तस्मिन्नाहूयमानेस्त्रेहूयमाने च पावके ॥ सार्धंग्रहेन्दुनक्षत्रैर्वितत्रासनभस्थ्सलम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40017359, "chapter_id": 9261, "verse_number": "29", "content_sanskrit": "स पावकंपावकदीप्ततेजाहुत्वामहेन्द्रप्रतिमप्रभावः । स चापबाणासिरथाश्वसूतःखेऽन्तर्दधेऽत्मानमचिन्त्यरूपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40017360, "chapter_id": 9261, "verse_number": "30", "content_sanskrit": "ततोहयरथाकीर्णंपताकाध्वजशोभितम् । निर्ययौराक्षसबलंनर्दमानंययुत्सया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40017361, "chapter_id": 9261, "verse_number": "31", "content_sanskrit": "तेशरैर्बहुभिश्चित्रैस्तीक्ष्णवेगैरलङ्कृतैः । तोमरैरङ्कुशैश्चापिवानरान् जघ्नुराहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40017362, "chapter_id": 9261, "verse_number": "32", "content_sanskrit": "रावणिस्तुततस्सङ्कृद्धस्तान्निरीक्ष्यनिशाचरान् । हृष्टाभवन्तोयुध्यन्तुवानराणांजिघांसया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40017363, "chapter_id": 9261, "verse_number": "33", "content_sanskrit": "ततस्तेराक्षसास्सर्वेनर्धन्तोजयकाङ्क्षिणः । अभ्यवर्षंस्ततोघोरान्वानरान् शरवृष्टिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40017364, "chapter_id": 9261, "verse_number": "34", "content_sanskrit": "स तुनालीकनाराचैर्गदाभिर्मुसलैरपि । रक्षोभिस्सम्वृतस्सङ्ख्येवानरान् विचकर्त ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40017365, "chapter_id": 9261, "verse_number": "35", "content_sanskrit": "तेवध्यमानास्समरेवानराःपादपायुधाः । अभ्यवर्षन्तसहसारावणिंशैलपादपैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40017366, "chapter_id": 9261, "verse_number": "36", "content_sanskrit": "इन्द्रजित्तुतदाक्रुद्धोमहातेजामहाबलः । वानराणांशरीराणिव्यधमद्रावणात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40017367, "chapter_id": 9261, "verse_number": "37", "content_sanskrit": "शरेणैकेन च हरीन्नवपञ्च च सप्त च । बिभेदसमरेक्रुद्धोराक्षसान् संप्रहर्षयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40017368, "chapter_id": 9261, "verse_number": "38", "content_sanskrit": "स शरैस्सूर्यसङ्काशैश्शातकुम्भविभूषितैः । वानरान् समरेवीरःप्रममाथसुदुर्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40017369, "chapter_id": 9261, "verse_number": "39", "content_sanskrit": "तेभिन्नगात्रास्समरेवानराश्शरपीडिताः । पेतुर्मथितसङ्कल्पास्सुरैरिवमहासुराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40017370, "chapter_id": 9261, "verse_number": "40", "content_sanskrit": "तंतपन्तमिवादित्यंघोरैर्बाणगभस्तिभिः । अभ्यधावन्तसङ्कृद्धास्सम्युगेवानरर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40017371, "chapter_id": 9261, "verse_number": "41", "content_sanskrit": "ततस्तुवानरास्सर्वेभिन्नदेहाविचेतसः । व्यथिताविद्रवन्तिस्मरुधिरेणसमुक्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40017372, "chapter_id": 9261, "verse_number": "42", "content_sanskrit": "रामस्यार्थेपराक्रम्यवानरास्त्यक्तजीविताः । नर्दन्तस्तेऽभिवृत्तास्तुसमरेसशिलायुधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40017373, "chapter_id": 9261, "verse_number": "43", "content_sanskrit": "तेद्रुमैःपर्वताग्रैश्चशिलाभिश्चप्लवङ्गमाः । अभ्यवर्षन्तसमरेरावणिंपर्यवस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40017374, "chapter_id": 9261, "verse_number": "44", "content_sanskrit": "तद्रुमाणांशिलानां च वर्षंप्राणहरंमहत् । व्यपोहतमहातेजारावणिस्समितिंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40017375, "chapter_id": 9261, "verse_number": "45", "content_sanskrit": "ततःपावकसङ्काशैश्शरैराशीविषोपमैः । वानराणामनीकानिबिभेदसमरेप्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40017376, "chapter_id": 9261, "verse_number": "46", "content_sanskrit": "अष्टादशशरैस्तीक्ष्णैस्सविदद्वागन्धमादनम् । विव्याथनवभिश्चैवनलंदूरादवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40017377, "chapter_id": 9261, "verse_number": "47", "content_sanskrit": "सप्तभिस्तुमहावीर्योमैन्दंमर्मविदारणैः । पञ्चभिर्विशिखैश्चैवगजंविव्याथसंयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40017378, "chapter_id": 9261, "verse_number": "48", "content_sanskrit": "जाम्बवन्तंतुदशभिर्नीलंत्रिंशद्भिरेव च । सुग्रीवमृषभंचैवसोऽङ्गदंद्विविधंतथा ॥ घोरैर्दत्तवरैस्तीक्ष्णैर्निष्प्राणानकरोत्तदा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40017379, "chapter_id": 9261, "verse_number": "49", "content_sanskrit": "अन्यानपितदामुख्यान्वानरान् बहुभिश्शरैः ॥ अर्दयामाससङ्कृद्धःकालानगिरिवमूर्छितः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40017380, "chapter_id": 9261, "verse_number": "50", "content_sanskrit": "सशरैस्सूर्यसङ्काशैस्सुमुक्सैशशीघ्रगामिभिः ॥ वानराणामनीकानिनिर्ममन्थमहारणे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 40017381, "chapter_id": 9261, "verse_number": "51", "content_sanskrit": "आकुलांवानरींसेनांशरजालेनमोहिताम् ॥ हृष्टस्सपरयाप्रीत्याददर्शक्षतजोक्षिताम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 40017382, "chapter_id": 9261, "verse_number": "52", "content_sanskrit": "वानरेवमहातेजाराक्षसेन्द्रात्मजोबली ॥ संसृज्यबाणवर्षं च शस्त्रवर्षं च दारुणम् । ममर्दवानरानीकमिन्द्रजित्त्वरितोबली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 40017383, "chapter_id": 9261, "verse_number": "53", "content_sanskrit": "वानरेवमहातेजाराक्षसेन्द्रात्मजोबली ॥ संसृज्यबाणवर्षं च शस्त्रवर्षं च दारुणम् । ममर्दवानरानीकमिन्द्रजित्त्वरितोबली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 40017384, "chapter_id": 9261, "verse_number": "54", "content_sanskrit": "स्वसैन्यमुत्सृज्यसमेत्यतूर्णंमहारणेवानरवाहिनीषु । अदृश्यमानश्शरजालमुग्रंववर्षनीलाम्बुधरोयथाम्बु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 40017385, "chapter_id": 9261, "verse_number": "55", "content_sanskrit": "तेशक्रजिद्बाणविशीर्णदेहामायाहताविस्वरमुन्नदन्तः । रणेनिपेतुर्हरयोऽद्रिकल्पायथेन्द्रवज्राभिहतानगेन्द्राः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 40017386, "chapter_id": 9261, "verse_number": "56", "content_sanskrit": "तेकेवलंसन्ददृशुशशिताग्रान्बाणान्रणेवानरवाहिनीषु । मायानिगूढंतुसुरेन्द्रशत्रुं न चावृतंराक्षसमभ्यपश्यन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 40017387, "chapter_id": 9261, "verse_number": "57", "content_sanskrit": "ततस्सरक्षोधिपतिर्महात्मासर्वादिशोबाणगणैशशिताग्रैः । प्रच्छादयामासरविप्रकाशैर्विपादयामास च वानरेन्द्रान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 40017388, "chapter_id": 9261, "verse_number": "58", "content_sanskrit": "स शूलनिस्त्रिंशपरश्वधानिव्याविध्यदीप्तानलसन्निभानि । सविस्फुलिङ्गोज्ज्वलपावकानिववर्षतीव्रंप्लवगेन्द्रसैन्ये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 40017389, "chapter_id": 9261, "verse_number": "59", "content_sanskrit": "ततोज्वलनसङ्काशैश्शरैर्वानरयूथपाः । ताडिताश्शक्रजिद्बाणैःप्रफुल्लाइवकिंशुकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 40017390, "chapter_id": 9261, "verse_number": "60", "content_sanskrit": "तेन्योन्यमभिसर्पन्तोनिनदन्तश्चविस्वरम् । राक्षसेन्द्रास्त्रनिर्भिन्नानिपेतुर्वानरर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 40017391, "chapter_id": 9261, "verse_number": "61", "content_sanskrit": "उदीक्षमाणागगनंकेचिन्नेत्रेषुताडिताः । शरैर्विविशुरन्योन्यंपेतुश्चजगतीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 40017392, "chapter_id": 9261, "verse_number": "62", "content_sanskrit": "हनूमन्तं च सुग्रीवमङ्गदंगन्धमादनम् । जाम्बवन्तंसुषेणं च वेगदर्शिनमेव च ॥ मैन्दं च द्विविदंनीलंगवाक्षंगजगोमुभौ । केसरिंहरिलोमानंविद्युद्धंष्ट्रं च वानरम् ॥ सूर्याननंज्योतिमुखंतथादधिमुखंहरिम् । पावकाक्षनळंचैवकुमुदंचैववानरम् ॥ प्रसैश्शूलैश्शितैर्बाणैरिन्द्रजिन्मन्त्रसम्हितैः । विव्याधहरिशार्दूलान् सर्वांस्तान्राक्षसोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 40017393, "chapter_id": 9261, "verse_number": "63", "content_sanskrit": "हनूमन्तं च सुग्रीवमङ्गदंगन्धमादनम् । जाम्बवन्तंसुषेणं च वेगदर्शिनमेव च ॥ मैन्दं च द्विविदंनीलंगवाक्षंगजगोमुभौ । केसरिंहरिलोमानंविद्युद्धंष्ट्रं च वानरम् ॥ सूर्याननंज्योतिमुखंतथादधिमुखंहरिम् । पावकाक्षनळंचैवकुमुदंचैववानरम् ॥ प्रसैश्शूलैश्शितैर्बाणैरिन्द्रजिन्मन्त्रसम्हितैः । विव्याधहरिशार्दूलान् सर्वांस्तान्राक्षसोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 40017394, "chapter_id": 9261, "verse_number": "64", "content_sanskrit": "हनूमन्तं च सुग्रीवमङ्गदंगन्धमादनम् । जाम्बवन्तंसुषेणं च वेगदर्शिनमेव च ॥ मैन्दं च द्विविदंनीलंगवाक्षंगजगोमुभौ । केसरिंहरिलोमानंविद्युद्धंष्ट्रं च वानरम् ॥ सूर्याननंज्योतिमुखंतथादधिमुखंहरिम् । पावकाक्षनळंचैवकुमुदंचैववानरम् ॥ प्रसैश्शूलैश्शितैर्बाणैरिन्द्रजिन्मन्त्रसम्हितैः । विव्याधहरिशार्दूलान् सर्वांस्तान्राक्षसोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 40017395, "chapter_id": 9261, "verse_number": "65", "content_sanskrit": "हनूमन्तं च सुग्रीवमङ्गदंगन्धमादनम् । जाम्बवन्तंसुषेणं च वेगदर्शिनमेव च ॥ मैन्दं च द्विविदंनीलंगवाक्षंगजगोमुभौ । केसरिंहरिलोमानंविद्युद्धंष्ट्रं च वानरम् ॥ सूर्याननंज्योतिमुखंतथादधिमुखंहरिम् । पावकाक्षनळंचैवकुमुदंचैववानरम् ॥ प्रसैश्शूलैश्शितैर्बाणैरिन्द्रजिन्मन्त्रसम्हितैः । विव्याधहरिशार्दूलान् सर्वांस्तान्राक्षसोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 40017396, "chapter_id": 9261, "verse_number": "66", "content_sanskrit": "स वैगदाभिर्हरियूथमुख्यान्निर्भिद्यबाणैस्तपनीयवङ्खैः । ववर्षरामंशरवृष्टिजालैस्सलक्ष्मणंभास्कररमशिकल्पैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 40017397, "chapter_id": 9261, "verse_number": "67", "content_sanskrit": "स बाणवर्षैरभिवृष्यमाणोधारानिपातानिवतानच्नित्य । समीक्षमाणःपरमाद्भुतश्रीरामतदालक्ष्मणमित्युवाच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 40017398, "chapter_id": 9261, "verse_number": "68", "content_sanskrit": "असौपुनर्लक्ष्मणराक्षसेन्द्रोब्रह्मास्त्रमाश्रित्यसुरेन्द्रशत्रुः । निपातयित्वाहरिसैन्यमुग्रमस्मान्शरैरर्दयतिप्रसक्तः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 40017399, "chapter_id": 9261, "verse_number": "69", "content_sanskrit": "स्वयम्भुवादत्तवरोमहात्मा । समाहितोन्तर्हितभीमकायः । कथंनुशक्योयुधिनष्टदेहोनिहन्तुमद्येन्द्रजिदुद्यतास्त्रः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 40017400, "chapter_id": 9261, "verse_number": "70", "content_sanskrit": "मन्येस्वयम्भुर्भगवानच्नित्योयस्यैतदस्त्रंप्रभवश्चयोऽस्य । बाणावपातास्त्वमिहाद्यधीमन्मयासहाव्यग्रमनास्सहस्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 40017401, "chapter_id": 9261, "verse_number": "71", "content_sanskrit": "प्रच्छादयत्येषहिराक्षसेन्द्रस्सर्वाधिशस्सायकवृष्टिजालैः । एतच्चसर्वंपतिताग्य्रशूरं न भ्राजतेवानरराजसैन्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 40017402, "chapter_id": 9261, "verse_number": "72", "content_sanskrit": "आवांतुदृष्टवापतितौविसंज्ञौनिवृत्तयुद्दौगतरोषहर्षे । ध्रुवंप्रवेक्ष्यत्यमरारिवासमसौसमादायरणाग्रलक्ष्मीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 40017403, "chapter_id": 9261, "verse_number": "73", "content_sanskrit": "ततस्तुताविन्द्रजिदस्त्रजालैर्भभूवतुस्तत्रतथाविशस्तौ । स चापितौतत्रविदर्शयित्वाननादहर्षाद्युधिराक्षसेन्द्रः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 40017404, "chapter_id": 9261, "verse_number": "74", "content_sanskrit": "सतत्तदावानरसैन्यमेवंरामं च सङ्ख्येसहलक्ष्मणेन । विषादयित्वासहसाविवेशपुरींदशग्रीवभुजाभिगुप्ताम् ॥ सन्स्तूयमानस्सतुयातुधानैः । पत्रे च सर्वंहृषितोऽभ्युवाच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]