[{"id": 5000261000, "chapter_id": 9261, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे चतुःषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000261001, "chapter_id": 9261, "verse_number": "३-६४-१", "content_sanskrit": "स दीनो दीनया वाचा लक्ष्मणं वाक्यमब्रवीत्।\nशीघ्रं लक्ष्मण जानीहि गत्वा गोदावरीं नदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000261002, "chapter_id": 9261, "verse_number": "३-६४-२", "content_sanskrit": "अपि गोदावरीं सीता पद्मान्यानयितुं गता।\nएवमुक्तस्तु रामेण लक्ष्मणः पुनरेव हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000261003, "chapter_id": 9261, "verse_number": "३-६४-३", "content_sanskrit": "नदीं गोदावरीं रम्यां जगाम लघुविक्रमः।\nतां लक्ष्मणस्तीर्थवतीं विचित्वा राममब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000261004, "chapter_id": 9261, "verse_number": "३-६४-४", "content_sanskrit": "नैनां पश्यामि तीर्थेषु क्रोशतो न शृणोति मे।\nकं नु सा देशमापन्ना वैदेही क्लेशनाशिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000261005, "chapter_id": 9261, "verse_number": "३-६४-५", "content_sanskrit": "नहि तं वेद्मि वै राम यत्र सा तनुमध्यमा।\nलक्ष्मणस्य वचः श्रुत्वा दीनः संतापमोहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000261006, "chapter_id": 9261, "verse_number": "३-६४-६", "content_sanskrit": "रामः समभिचक्राम स्वयं गोदावरीं नदीम्।\nस तामुपस्थितो रामः क्व सीतेत्येवमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000261007, "chapter_id": 9261, "verse_number": "३-६४-७", "content_sanskrit": "भूतानि राक्षसेन्द्रेण वधार्हेण हृतामपि।\nन तां शशंसू रामाय तथा गोदावरी नदी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000261008, "chapter_id": 9261, "verse_number": "३-६४-८", "content_sanskrit": "ततः प्रचोदिता भूतैः शंस चास्मै प्रियामिति।\nन च सा ह्यवदत् सीतां पृष्टा रामेण शोचता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000261009, "chapter_id": 9261, "verse_number": "३-६४-९", "content_sanskrit": "रावणस्य च तद्‍रूपं कर्मापि च दुरात्मनः।\nध्यात्वा भयात् तु वैदेहीं सा नदी न शशंस ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000261010, "chapter_id": 9261, "verse_number": "३-६४-१०", "content_sanskrit": "निराशस्तु तया नद्या सीताया दर्शने कृतः।\nउवाच रामः सौमित्रिं सीतादर्शनकर्शितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000261011, "chapter_id": 9261, "verse_number": "३-६४-११", "content_sanskrit": "एषा गोदावरी सौम्य किंचिन्न प्रतिभाषते।\nकिं नु लक्ष्मण वक्ष्यामि समेत्य जनकं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000261012, "chapter_id": 9261, "verse_number": "३-६४-१२", "content_sanskrit": "मातरं चैव वैदेह्या विना तामहमप्रियम्।\nया मे राज्यविहीनस्य वने वन्येन जीवतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000261013, "chapter_id": 9261, "verse_number": "३-६४-१३", "content_sanskrit": "सर्वं व्यपानयच्छोकं वैदेही क्व नु सा गता।\nज्ञातिवर्गविहीनस्य वैदेहीमप्यपश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000261014, "chapter_id": 9261, "verse_number": "३-६४-१४", "content_sanskrit": "मन्ये दीर्घा भविष्यन्ति रात्रयो मम जाग्रतः।\nमन्दाकिनीं जनस्थानमिमं प्रस्रवणं गिरिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000261015, "chapter_id": 9261, "verse_number": "३-६४-१५", "content_sanskrit": "सर्वाण्यनुचरिष्यामि यदि सीता हि लभ्यते।\nएते महामृगा वीर मामीक्षन्ते पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000261016, "chapter_id": 9261, "verse_number": "३-६४-१६", "content_sanskrit": "वक्तुकामा इह हि मे इङ्गितान्युपलक्षये।\nतांस्तु दृष्ट्वा नरव्याघ्रो राघवः प्रत्युवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000261017, "chapter_id": 9261, "verse_number": "३-६४-१७", "content_sanskrit": "क्व सीतेति निरीक्षन् वै बाष्पसंरुद्धया गिरा।\nएवमुक्ता नरेन्द्रेण ते मृगाः सहसोत्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000261018, "chapter_id": 9261, "verse_number": "३-६४-१८", "content_sanskrit": "दक्षिणाभिमुखाः सर्वे दर्शयन्तो नभःस्थलम्।\nमैथिली ह्रियमाणा सा दिशं यामभ्यपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000261019, "chapter_id": 9261, "verse_number": "३-६४-१९", "content_sanskrit": "तेन मार्गेण गच्छन्तो निरीक्षन्ते नराधिपम्।\nयेन मार्गं च भूमिं च निरीक्षन्ते स्म ते मृगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000261020, "chapter_id": 9261, "verse_number": "३-६४-२०", "content_sanskrit": "पुनर्नदन्तो गच्छन्ति लक्ष्मणेनोपलक्षिताः।\nतेषां वचनसर्वस्वं लक्षयामास चेङ्गितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000261021, "chapter_id": 9261, "verse_number": "३-६४-२१", "content_sanskrit": "उवाच लक्ष्मणो धीमान् ज्येष्ठं भ्रातरमार्तवत्।\nक्व सीतेति त्वया पृष्टा यथेमे सहसोत्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000261022, "chapter_id": 9261, "verse_number": "३-६४-२२", "content_sanskrit": "दर्शयन्ति क्षितिं चैव दक्षिणां च दिशं मृगाः।\nसाधु गच्छावहे देव दिशमेतां च नैर्ऋतीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000261023, "chapter_id": 9261, "verse_number": "३-६४-२३", "content_sanskrit": "यदि तस्यागमः कश्चिदार्या वा साथ लक्ष्यते।\nबाढमित्येव काकुत्स्थः प्रस्थितो दक्षिणां दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000261024, "chapter_id": 9261, "verse_number": "३-६४-२४", "content_sanskrit": "लक्ष्मणानुगतः श्रीमान् वीक्षमाणो वसुंधराम्।\nएवं सम्भाषमाणौ तावन्योन्यं भ्रातरावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000261025, "chapter_id": 9261, "verse_number": "३-६४-२५", "content_sanskrit": "वसुंधरायां पतितपुष्पमार्गमपश्यताम्।\nपुष्पवृष्टिं निपतितां दृष्ट्वा रामो महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000261026, "chapter_id": 9261, "verse_number": "३-६४-२६", "content_sanskrit": "उवाच लक्ष्मणं वीरो दुःखितो दुःखितं वचः।\nअभिजानामि पुष्पाणि तानीमानीह लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000261027, "chapter_id": 9261, "verse_number": "३-६४-२७", "content_sanskrit": "अपिनद्धानि वैदेह्या मया दत्तानि कानने।\nमन्ये सूर्यश्च वायुश्च मेदिनी च यशस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000261028, "chapter_id": 9261, "verse_number": "३-६४-२८", "content_sanskrit": "अभिरक्षन्ति पुष्पाणि प्रकुर्वन्तो मम प्रियम्।\nएवमुक्त्वा महाबाहुर्लक्ष्मणं पुरुषर्षभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000261029, "chapter_id": 9261, "verse_number": "३-६४-२९", "content_sanskrit": "उवाच रामो धर्मात्मा गिरिं प्रस्रवणाकुलम्।\nकच्चित् क्षितिभृतां नाथ दृष्टा सर्वाङ्गसुन्दरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000261030, "chapter_id": 9261, "verse_number": "३-६४-३०", "content_sanskrit": "रामा रम्ये वनोद्देशे मया विरहिता त्वया।\nक्रुद्धोऽब्रवीद् गिरिं तत्र सिंहः क्षुद्रमृगं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000261031, "chapter_id": 9261, "verse_number": "३-६४-३१", "content_sanskrit": "तां हेमवर्णां हेमाङ्गीं सीतां दर्शय पर्वत।\nयावत् सानूनि सर्वाणि न ते विध्वंसयाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000261032, "chapter_id": 9261, "verse_number": "३-६४-३२", "content_sanskrit": "एवमुक्तस्तु रामेण पर्वतो मैथिलीं प्रति।\nदर्शयन्निव तां सीतां नादर्शयत राघवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000261033, "chapter_id": 9261, "verse_number": "३-६४-३३", "content_sanskrit": "ततो दाशरथी राम उवाच च शिलोच्चयम्।\nमम बाणाग्निनिर्दग्धो भस्मीभूतो भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000261034, "chapter_id": 9261, "verse_number": "३-६४-३४", "content_sanskrit": "असेव्यः सर्वतश्चैव निस्तृणद्रुमपल्लवः।\nइमां वा सरितं चाद्य शोषयिष्यामि लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000261035, "chapter_id": 9261, "verse_number": "३-६४-३५", "content_sanskrit": "यदि नाख्याति मे सीतामद्य चन्द्रनिभाननाम्।\nएवं प्ररुषितो रामो दिधक्षन्निव चक्षुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000261036, "chapter_id": 9261, "verse_number": "३-६४-३६", "content_sanskrit": "ददर्श भूमौ निष्क्रान्तं राक्षसस्य पदं महत्।\nत्रस्ताया रामकांक्षिण्याः प्रधावन्त्या इतस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000261037, "chapter_id": 9261, "verse_number": "३-६४-३७", "content_sanskrit": "राक्षसेनानुसृप्ताया वैदेह्याश्च पदानि तु।\nस समीक्ष्य परिक्रान्तं सीताया राक्षसस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000261038, "chapter_id": 9261, "verse_number": "३-६४-३८", "content_sanskrit": "भग्नं धनुश्च तूणी च विकीर्णं बहुधा रथम्।\nसम्भ्रान्तहृदयो रामः शशंस भ्रातरं प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000261039, "chapter_id": 9261, "verse_number": "३-६४-३९", "content_sanskrit": "पश्य लक्ष्मण वैदेह्या कीर्णाः कनकबिन्दवः।\nभूषणानां हि सौमित्रे माल्यानि विविधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000261040, "chapter_id": 9261, "verse_number": "३-६४-४०", "content_sanskrit": "तप्तबिन्दुनिकाशैश्च चित्रैः क्षतजबिन्दुभिः।\nआवृतं पश्य सौमित्रे सर्वतो धरणीतलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000261041, "chapter_id": 9261, "verse_number": "३-६४-४१", "content_sanskrit": "मन्ये लक्ष्मण वैदेही राक्षसैः कामरूपिभिः।\nभित्त्वा भित्त्वा विभक्ता वा भक्षिता वा भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000261042, "chapter_id": 9261, "verse_number": "३-६४-४२", "content_sanskrit": "तस्या निमित्तं सीताया द्वयोर्विवदमानयोः।\nबभूव युद्धं सौमित्रे घोरं राक्षसयोरिह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000261043, "chapter_id": 9261, "verse_number": "३-६४-४३", "content_sanskrit": "मुक्तामणिचितं चेदं रमणीयं विभूषितम्।\nधरण्यां पतितं सौम्य कस्य भग्नं महद् धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000261044, "chapter_id": 9261, "verse_number": "३-६४-४४", "content_sanskrit": "राक्षसानामिदं वत्स सुराणामथवापि वा।\nतरुणादित्यसंकाशं वैदूर्यगुलिकाचितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000261045, "chapter_id": 9261, "verse_number": "३-६४-४५", "content_sanskrit": "विशीर्णं पतितं भूमौ कवचं कस्य काञ्चनम्।\nछत्रं शतशलाकं च दिव्यमाल्योपशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000261046, "chapter_id": 9261, "verse_number": "३-६४-४६", "content_sanskrit": "भग्नदण्डमिदं सौम्य भूमौ कस्य निपातितम्।\nकाञ्चनोरश्छदाश्चेमे पिशाचवदनाः खराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000261047, "chapter_id": 9261, "verse_number": "३-६४-४७", "content_sanskrit": "भीमरूपा महाकायाः कस्य वा निहता रणे।\nदीप्तपावकसंकाशो द्युतिमान् समरध्वजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000261048, "chapter_id": 9261, "verse_number": "३-६४-४८", "content_sanskrit": "अपविद्धश्च भग्नश्च कस्य साङ्ग्रामिको रथः।\nरथाक्षमात्रा विशिखास्तपनीयविभूषणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000261049, "chapter_id": 9261, "verse_number": "३-६४-४९", "content_sanskrit": "कस्येमे निहता बाणाः प्रकीर्णा घोरदर्शनाः।\nशरावरौ शरैः पूर्णौ विध्वस्तौ पश्य लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000261050, "chapter_id": 9261, "verse_number": "३-६४-५०", "content_sanskrit": "प्रतोदाभीषुहस्तोऽयं कस्य वा सारथिर्हतः।\nपदवी पुरुषस्यैषा व्यक्तं कस्यापि रक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000261051, "chapter_id": 9261, "verse_number": "३-६४-५१", "content_sanskrit": "वैरं शतगुणं पश्य मम तैर्जीवितान्तकम्।\nसुघोरहृदयैः सौम्य राक्षसैः कामरूपिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000261052, "chapter_id": 9261, "verse_number": "३-६४-५२", "content_sanskrit": "हृता मृता वा वैदेही भक्षिता वा तपस्विनी।\nन धर्मस्त्रायते सीतां ह्रियमाणां महावने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000261053, "chapter_id": 9261, "verse_number": "३-६४-५३", "content_sanskrit": "भक्षितायां हि वैदेह्यां हृतायामपि लक्ष्मण।\nके हि लोके प्रियं कर्तुं शक्ताः सौम्य ममेश्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000261054, "chapter_id": 9261, "verse_number": "३-६४-५४", "content_sanskrit": "कर्तारमपि लोकानां शूरं करुणवेदिनम्।\nअज्ञानादवमन्येरन् सर्वभूतानि लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000261055, "chapter_id": 9261, "verse_number": "३-६४-५५", "content_sanskrit": "मृदुं लोकहिते युक्तं दान्तं करुणवेदिनम्।\nनिर्वीर्य इति मन्यन्ते नूनं मां त्रिदशेश्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000261056, "chapter_id": 9261, "verse_number": "३-६४-५६", "content_sanskrit": "मां प्राप्य हि गुणो दोषः संवृत्तः पश्य लक्ष्मण।\nअद्यैव सर्वभूतानां रक्षसामभवाय च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000261057, "chapter_id": 9261, "verse_number": "३-६४-५७", "content_sanskrit": "संहृत्यैव शशिज्योत्स्नां महान् सूर्य इवोदितः।\nसंहृत्यैव गुणान् सर्वान् मम तेजः प्रकाशते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000261058, "chapter_id": 9261, "verse_number": "३-६४-५८", "content_sanskrit": "नैव यक्षा न गन्धर्वा न पिशाचा न राक्षसाः।\nकिंनरा वा मनुष्या वा सुखं प्राप्स्यन्ति लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000261059, "chapter_id": 9261, "verse_number": "३-६४-५९", "content_sanskrit": "ममास्त्रबाणसम्पूर्णमाकाशं पश्य लक्ष्मण।\nअसम्पातं करिष्यामि ह्यद्य त्रैलोक्यचारिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000261060, "chapter_id": 9261, "verse_number": "३-६४-६०", "content_sanskrit": "संनिरुद्धग्रहगणमावारितनिशाकरम्।\nविप्रणष्टानलमरुद्भास्करद्युतिसंवृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000261061, "chapter_id": 9261, "verse_number": "३-६४-६१", "content_sanskrit": "विनिर्मथितशैलाग्रं शुष्यमाणजलाशयम्।\nध्वस्तद्रुमलतागुल्मं विप्रणाशितसागरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000261062, "chapter_id": 9261, "verse_number": "३-६४-६२", "content_sanskrit": "त्रैलोक्यं तु करिष्यामि संयुक्तं कालकर्मणा।\nन ते कुशलिनीं सीतां प्रदास्यन्ति ममेश्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000261063, "chapter_id": 9261, "verse_number": "३-६४-६३", "content_sanskrit": "अस्मिन् मुहूर्ते सौमित्रे मम द्रक्ष्यन्ति विक्रमम्।\nनाकाशमुत्पतिष्यन्ति सर्वभूतानि लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000261064, "chapter_id": 9261, "verse_number": "३-६४-६४", "content_sanskrit": "मम चापगुणोन्मुक्तैर्बाणजालैर्निरन्तरम्।\nमर्दितं मम नाराचैर्ध्वस्तभ्रान्तमृगद्विजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000261065, "chapter_id": 9261, "verse_number": "३-६४-६५", "content_sanskrit": "समाकुलममर्यादं जगत् पश्याद्य लक्ष्मण।\nआकर्णपूर्णैरिषुभिर्जीवलोकदुरावरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000261066, "chapter_id": 9261, "verse_number": "३-६४-६६", "content_sanskrit": "करिष्ये मैथिलीहेतोरपिशाचमराक्षसम्।\nमम रोषप्रयुक्तानां विशिखानां बलं सुराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000261067, "chapter_id": 9261, "verse_number": "३-६४-६७", "content_sanskrit": "द्रक्ष्यन्त्यद्य विमुक्तानाममर्षाद् दूरगामिनाम्।\nनैव देवा न दैतेया न पिशाचा न राक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000261068, "chapter_id": 9261, "verse_number": "३-६४-६८", "content_sanskrit": "भविष्यन्ति मम क्रोधात् त्रैलोक्ये विप्रणाशिते।\nदेवदानवयक्षाणां लोका ये रक्षसामपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000261069, "chapter_id": 9261, "verse_number": "३-६४-६९", "content_sanskrit": "बहुधा निपतिष्यन्ति बाणौघैः शकलीकृताः।\nनिर्मर्यादानिमाँल्लोकान् करिष्याम्यद्य सायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000261070, "chapter_id": 9261, "verse_number": "३-६४-७०", "content_sanskrit": "हृतां मृतां वा सौमित्रे न दास्यन्ति ममेश्वराः।\nतथारूपां हि वैदेहीं न दास्यन्ति यदि प्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000261071, "chapter_id": 9261, "verse_number": "३-६४-७१", "content_sanskrit": "नाशयामि जगत् सर्वं त्रैलोक्यं सचराचरम्।\nयावद् दर्शनमस्या वै तापयामि च सायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 5000261072, "chapter_id": 9261, "verse_number": "३-६४-७२", "content_sanskrit": "इत्युक्त्वा क्रोधताम्राक्षः स्फुरमाणोष्ठसम्पुटः।\nवल्कलाजिनमाबद्ध्य जटाभारमबन्धयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 5000261073, "chapter_id": 9261, "verse_number": "३-६४-७३", "content_sanskrit": "तस्य क्रुद्धस्य रामस्य तथाभूतस्य धीमतः।\nत्रिपुरं जघ्नुषः पूर्वं रुद्रस्येव बभौ तनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 5000261074, "chapter_id": 9261, "verse_number": "३-६४-७४", "content_sanskrit": "लक्ष्मणादथ चादाय रामो निष्पीड्य कार्मुकम्।\nशरमादाय संदीप्तं घोरमाशीविषोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 5000261075, "chapter_id": 9261, "verse_number": "३-६४-७५", "content_sanskrit": "संदधे धनुषि श्रीमान् रामः परपुरञ्जयः।\nयुगान्ताग्निरिव क्रुद्ध इदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 5000261076, "chapter_id": 9261, "verse_number": "३-६४-७६", "content_sanskrit": "यथा जरा यथा मृत्युर्यथा कालो यथा विधिः।\nनित्यं न प्रतिहन्यन्ते सर्वभूतेषु लक्ष्मण।\nतथाहं क्रोधसंयुक्तो न निवार्योऽस्म्यसंशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 5000261077, "chapter_id": 9261, "verse_number": "३-६४-७७", "content_sanskrit": "पुरेव मे चारुदतीमनिन्दितां\nदिशन्ति सीतां यदि नाद्य मैथिलीम्।\nसदेवगन्धर्वमनुष्यपन्नगं\nजगत् सशैलं परिवर्तयाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 5000261078, "chapter_id": 9261, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे चतुःषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}]