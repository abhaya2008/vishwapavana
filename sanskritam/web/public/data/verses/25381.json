[{"id": 7005381000, "chapter_id": 25381, "verse_number": "४७-१", "content_sanskrit": "मार्कण्डेय उवाच ।\nस्थाणुतीर्थप्रभावं तु श्रोतुमिच्छाम्यहं मुने ।\nकेन सिद्धिरथ प्राप्ता सर्वपापभयापहा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005381001, "chapter_id": 25381, "verse_number": "४७-२", "content_sanskrit": "सनत्कुमार उवाच ।\nशृणु सर्वमशेषेण स्थाणुमाहात्म्यमुत्तमम् ।\nयच्छ्रुत्वा सर्वपापेभ्यो मुक्तो भवति मानवः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005381002, "chapter_id": 25381, "verse_number": "४७-३", "content_sanskrit": "एकार्णवे जगत्यस्मिन् नष्टे स्थावरजङ्गमे ।\nविष्णोर्नाभिसमुद्भूतं पद्ममव्यक्तजन्मनः ।\nतस्मिन् ब्रह्म समुद्भूतं सर्वलोकपितामहः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005381003, "chapter_id": 25381, "verse_number": "४७-४", "content_sanskrit": "तस्मान्मरीचिरभवन्मरीचेः कश्यपः सुतः ।\nकश्यपादभवद् भास्वांस्तमान्मनुरजायत ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005381004, "chapter_id": 25381, "verse_number": "४७-५", "content_sanskrit": "मनोस्तु क्षुवतः पुत्र उत्पन्नो मुखसम्भवः ।\nपृथिव्यां चतुरन्तायां राजासीद् धर्मरक्षिता ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005381005, "chapter_id": 25381, "verse_number": "४७-६", "content_sanskrit": "तस्य पत्नी बभूवाथ भया नाम भयावहा ।\nमृत्योः सकाशादुत्पन्ना कालस्य दुहिता तदा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005381006, "chapter_id": 25381, "verse_number": "४७-७", "content_sanskrit": "तस्यां समभवद् वेनो दुरात्मा वेदनिन्दकः ।\nस दृष्ट्वा पुत्रवदनं क्रुद्धो राजा वनं ययौ ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005381007, "chapter_id": 25381, "verse_number": "४७-८", "content_sanskrit": "तत्र कृत्वा तपो घोरं धर्मेणावृत्य रोदसी ।\nप्राप्तवान् ब्रह्मसदनं पुरनावृत्तिदुर्वभम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005381008, "chapter_id": 25381, "verse_number": "४७-९", "content_sanskrit": "वेनो राजा समभवत् समस्ते क्षितिमण्डले ।\nस मातामहदोषेण तेन कालात्मजात्मजः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005381009, "chapter_id": 25381, "verse_number": "४७-१०", "content_sanskrit": "घोषयामस नगरे दुरात्मा वेदनिन्दकः ।\nन दातव्यं न यष्टव्यं न होतव्यं कदाचन ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005381010, "chapter_id": 25381, "verse_number": "४७-११", "content_sanskrit": "अहमेको ऽत्र वै वन्द्यः पूज्यो ऽहं भवतां सदा ।\nमया हि पालिता यूयं निवसध्वं यथासुखम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005381011, "chapter_id": 25381, "verse_number": "४७-१२", "content_sanskrit": "तन्मत्तो ऽन्यो न देवो ऽस्ति युष्माकं यः परायणम् ।\nएतच्छ्रत्वा तु वचनमृषयः सर्व एव ते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005381012, "chapter_id": 25381, "verse_number": "४७-१३", "content_sanskrit": "परस्परं समागम्य राजानं वाक्यमब्रवन् ।\nश्रुतिः प्रमाणं धर्मस्य ततो यज्ञः प्रतिष्ठितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005381013, "chapter_id": 25381, "verse_number": "४७-१४", "content_sanskrit": "यज्ञैर्विना नो प्रीयन्ते देवाः स्वर्गनिवासिनः ।\nअप्रीता न प्रयच्छन्ति वृष्टिं सस्यस्य वृद्धये ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005381014, "chapter_id": 25381, "verse_number": "४७-१५", "content_sanskrit": "तस्माद् यज्ञैश्च देवैश्च धार्यते सचराचरम् ।\nएतच्छ्रुत्वा क्रोधदृष्टिर्वेनः प्राह पुनः पुनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005381015, "chapter_id": 25381, "verse_number": "४७-१६", "content_sanskrit": "न यष्टव्यं न दातव्यमित्याह क्रोधमूर्च्छितः ।\nततः क्रोधसमाविष्टा ऋषयः सर्व एव ते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005381016, "chapter_id": 25381, "verse_number": "४७-१७", "content_sanskrit": "निजघ्नुर्मन्त्रपूतैस्ते कुशैर्वज्रसमन्वितैः ।\nततस्त्वराजके लोके तमसा संवृते तदा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005381017, "chapter_id": 25381, "verse_number": "४७-१८", "content_sanskrit": "दस्युभिः पीड्यमानास्तान् ऋषींस्ते शरणं ययुः ।\nततस्ते ऋषयः सर्वे ममन्थुस्तस्य वै करम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005381018, "chapter_id": 25381, "verse_number": "४७-१९", "content_sanskrit": "सव्यं तस्मात् समुत्तस्थौ पुरुषो ह्रस्वदर्शनः ।\nतमूचुरृषयः सर्वे निषीदतु भवानिति ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005381019, "chapter_id": 25381, "verse_number": "४७-२०", "content_sanskrit": "तस्मान्निषादा उत्पन्ना वेनकल्मषसम्भवाः ।\nततस्ते ऋषयः सर्वे मन्मथुर्दक्षिणं करम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005381020, "chapter_id": 25381, "verse_number": "४७-२१", "content_sanskrit": "मथ्यमाने करे तस्मिन् उत्पन्नः पुरुषो ऽपरः ।\nबृहत्सालप्रतीकाशो दिव्यलक्षणलक्षितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005381021, "chapter_id": 25381, "verse_number": "४७-२२", "content_sanskrit": "धनुर्बाणाङ्कितकरश्चश्चक्रध्वसमन्वितः ।\nतमुत्पन्नं तदा दृष्ट्वा सर्वे देवाः सवासवाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005381022, "chapter_id": 25381, "verse_number": "४७-२३", "content_sanskrit": "अभ्यषिञ्चन् पृथिव्यां तं राजानं भूमिपालकम् ।\nततः स रञ्जयामास धर्मेण पृथिवीं तदा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005381023, "chapter_id": 25381, "verse_number": "४७-२४", "content_sanskrit": "पित्राःऽपरञ्जिता तस्य तेन सा परिपालिता ।\nतत्र राजेतिशब्दो ऽस्य पृथिव्या रञ्जनादभूत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005381024, "chapter_id": 25381, "verse_number": "४७-२५", "content_sanskrit": "स राज्यं पाप्य तेभ्यस्तु चिन्तयामास पार्थिवः ।\nपिता मम अधर्मिष्ठो यज्ञव्युच्छित्तिकारकः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005381025, "chapter_id": 25381, "verse_number": "४७-२६", "content_sanskrit": "कथं तस्य क्रिया कार्या परलोकसुखावहा ।\nइत्येवं चिन्तयानस्य नारदो ऽभ्याजगाम ह ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005381026, "chapter_id": 25381, "verse_number": "४७-२७", "content_sanskrit": "तस्मै स चासनं दत्त्वा प्रणिपत्य च पृष्टवान् ।\nभगवन् सर्वलोकस्य जानासि त्वं शुभाशुभम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005381027, "chapter_id": 25381, "verse_number": "४७-२८", "content_sanskrit": "पिता मम दुराचारो देवब्राह्मणनिन्दकः ।\nस्वकर्मरहितो विप्र परलोकमवाप्तवान् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005381028, "chapter_id": 25381, "verse_number": "४७-२९", "content_sanskrit": "ततो ऽब्रवीन्नारदस्तं ज्ञात्वा दिव्येन चक्षुषा ।\nम्लेच्छमघ्ये समुत्पन्नं क्षयकुष्ठसमन्वितम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005381029, "chapter_id": 25381, "verse_number": "४७-३०", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्य नारदस्य महात्मनः ।\nचिन्तयामास दुखार्तः कथं कार्यं मया भवेत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005381030, "chapter_id": 25381, "verse_number": "४७-३१", "content_sanskrit": "इत्येवं चिन्तयानस्य मतिर्जाता महात्मनः ।\nपुत्रः स कथ्यते लोके यः पितॄंस्त्रायते भयात् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005381031, "chapter_id": 25381, "verse_number": "४७-३२", "content_sanskrit": "एवं सञ्चिन्त्य स तदा नारदं पृष्टवान् मुनिम् ।\nतारणं मत्पितुस्तस्य मया कार्यं कथं मुने ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005381032, "chapter_id": 25381, "verse_number": "४७-३३", "content_sanskrit": "नारद उवाच ।\nगच्छ त्वं तस्य तं देहं तीर्थेषु कुरु निर्मलम् ।\nयत्र स्थाणोर्महत्तीर्थं सरः सन्निहितं प्रति ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005381033, "chapter_id": 25381, "verse_number": "४७-३४", "content_sanskrit": "एतच्छ्रत्वा तु वचनं नारदस्य महात्मनः ।\nसचिवे राज्यमाधाय राजा स तु जगाम ह ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005381034, "chapter_id": 25381, "verse_number": "४७-३५", "content_sanskrit": "स गत्वा चोत्तरां भूमिं म्लेच्छमध्ये ददर्श ह ।\nकुष्ठरोगेण महाता क्षयेण च समन्वितम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005381035, "chapter_id": 25381, "verse_number": "४७-३६", "content_sanskrit": "ततः शोकेन महता सन्तप्तो वाक्यमब्रवीत् ।\nह म्लेच्छा नौमि पुरुषं स्वगृहं च नयाम्यहम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005381036, "chapter_id": 25381, "verse_number": "४७-३७", "content_sanskrit": "तत्राहमेनं निरुजं करिष्ये यदि मन्यथ ।\nतथेति सर्वे ते म्लेच्छाः पुरुषं तं दयापरम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005381037, "chapter_id": 25381, "verse_number": "४७-३८", "content_sanskrit": "ऊचुः प्रणतसर्वाङ्गा यथा जानासि तत्कुरु ।\nतत आनीय पुरुषान् शिविकावाहनोचितान् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005381038, "chapter_id": 25381, "verse_number": "४७-३९", "content_sanskrit": "दत्त्वा शुल्कं च द्विगुणं सुखेन नयत द्विजम् ।\nततः श्रुत्वा तु वचनं तस्य राज्ञो दयावतः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005381039, "chapter_id": 25381, "verse_number": "४७-४०", "content_sanskrit": "गृहीत्वा शिविकां क्षिप्रं कुरुक्षेत्रेण यान्ति ते ।\nतत्र नीत्वा स्थाणुतीर्थे अवतार्य च ते गताः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005381040, "chapter_id": 25381, "verse_number": "४७-४१", "content_sanskrit": "ततः स राजा मध्याह्ने तं स्नापयति वै तदा ।\nततो वायुरन्तरिक्षे इदं वचनमब्रवीत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005381041, "chapter_id": 25381, "verse_number": "४७-४२", "content_sanskrit": "मा तात साहसं कार्षिस्तीर्थ रक्ष प्रयत्नतः ।\nअयं पापेन घोरेम अतीव परिवेष्टितः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005381042, "chapter_id": 25381, "verse_number": "४७-४३", "content_sanskrit": "वेदनिन्दा महत्पापं यस्यान्तो नैव लभ्यते ।\nसो ऽयं स्नानान्महत्तीर्थं नाशयिष्यति तत्क्षणात् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005381043, "chapter_id": 25381, "verse_number": "४७-४४", "content_sanskrit": "एतद् वोयर्बचः श्रुत्वादुःखेन महतान्वितः ।\nउवाच शोकसन्तप्तस्तस्य दुःखेन दुःखितः ।\nएष घोरेण पापेन अतीव परिवेष्टितः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005381044, "chapter_id": 25381, "verse_number": "४७-४५", "content_sanskrit": "प्रायश्चित्तं करिष्ये ऽहं यद्वदिष्यन्ति देवताः ।\nततस्ता देवताः सर्वा इदं वचनमब्रुवन् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005381045, "chapter_id": 25381, "verse_number": "४७-४६", "content_sanskrit": "स्नात्वा स्नात्वा च तीर्थेषु अभिषिञ्चस्व वारिणा ।\nओजसा चुलुकं यावत् प्रतिकूले सरस्वतीम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005381046, "chapter_id": 25381, "verse_number": "४७-४७", "content_sanskrit": "स्नात्वा मुक्तिमवाप्नोति पुरुषः श्रद्धयान्वितः ।\nएष स्वपोषणपरो देवदूषणतत्परः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005381047, "chapter_id": 25381, "verse_number": "४७-४८", "content_sanskrit": "ब्राह्मणैश्च परित्यक्तो नैष शुद्ध्यति कर्हिचित् ।\nतस्मादेनं समुद्दिश्य स्नात्वा तीर्थेषु भक्तितः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005381048, "chapter_id": 25381, "verse_number": "४७-४९", "content_sanskrit": "अभिषिञ्चस्व तोयेन ततः पूतो भविष्यति ।\nइत्येतद्वचनं श्रुत्वा कृत्वा तस्याश्रमं ततः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005381049, "chapter_id": 25381, "verse_number": "४७-५०", "content_sanskrit": "तीर्थयात्रां ययौ राजा उद्दिश्य जनकं स्वकम् ।\nस तेषु प्लावनं कुर्वस्तीर्थेषु च दिने दिने ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005381050, "chapter_id": 25381, "verse_number": "४७-५१", "content_sanskrit": "अभ्यषिढ्चत् स्वपितरं तीर्थतोयेन नित्यशः ।\nएतस्मिन्नेव काले तु सारमेयो जगाम ह ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005381051, "chapter_id": 25381, "verse_number": "४७-५२", "content_sanskrit": "स्थाणोर्मठे कौलपतिर्देवद्रव्यस्य रक्षिता ।\nपरिग्रहस्य द्रव्यस्य परिपालयिता सदा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005381052, "chapter_id": 25381, "verse_number": "४७-५३", "content_sanskrit": "प्रियश्च सर्वसोकेषु देवकार्यपरायणः ।\nतस्यैवं वर्तमानस्य धर्ममार्गे स्थितस्य च ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005381053, "chapter_id": 25381, "verse_number": "४७-५४", "content_sanskrit": "कालेन चलिता बुद्धिर्देवद्रव्यस्य नाशेने ।\nतेनाधर्मेण युक्तस्य परलोकगतस्य च ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005381054, "chapter_id": 25381, "verse_number": "४७-५५", "content_sanskrit": "दृष्ट्वा यमो ऽब्रवीद् वाक्यं श्वयोनिं व३ज मा चिरम् ।\nतद्वाक्यानन्तरं जातः श्व वै सौगन्धिके वने ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005381055, "chapter_id": 25381, "verse_number": "४७-५६", "content_sanskrit": "ततः कालेन महता श्वयूथपरिवारितः ।\nपरिभूतः सरमया दुःखेन महता वृतः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005381056, "chapter_id": 25381, "verse_number": "४७-५७", "content_sanskrit": "त्यक्त्वा द्वैतवनं पुण्यं सान्निहत्यं ययौ सरः ।\nतस्मिन् प्रविष्टमात्रस्तु स्थाणोरेव प्रसादतः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005381057, "chapter_id": 25381, "verse_number": "४७-५८", "content_sanskrit": "अतीव तृषया युक्तः सरस्वत्यां ममञ्ज ह ।\nतत्र सम्प्लुतदेहस्तु विमुक्तः सर्वाकिल्बिषैः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005381058, "chapter_id": 25381, "verse_number": "४७-५९", "content_sanskrit": "आहारलोभेन तदा प्रविवेश कुटीरकम् ।\nप्रविशन्तं तदा दृष्ट्वा श्वानं भयसमन्वितः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005381059, "chapter_id": 25381, "verse_number": "४७-६०", "content_sanskrit": "स तं पस्पर्श शनकैः स्थाणुतीर्थे ममञ्ज ह ।\nपततः पूर्वतीर्थेषु विप्रुषैः परिषिञ्चतः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005381060, "chapter_id": 25381, "verse_number": "४७-६१", "content_sanskrit": "शुनो ऽस्य गात्रसम्भूतैरब्बिन्दुभिः स सिञ्चितः ।\nविरक्तदृष्टिश्च शुनः क्षेपेण च ततः परम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005381061, "chapter_id": 25381, "verse_number": "४७-६२", "content_sanskrit": "स्थाणुतीर्थस्य माहात्म्यात् स पुत्रेण च तारितः ।\nनियतस्तत्क्षणाञ्जातो स्तुतिं कर्तुं प्रचक्रमे ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005381062, "chapter_id": 25381, "verse_number": "४७-६३", "content_sanskrit": "वेन उवाच ।\nप्रपद्ये देवमीशानं त्वामजं चन्द्रभूषणम् ।\nमहादेवं महात्मानं विश्वस्य जगतः पतिम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005381063, "chapter_id": 25381, "verse_number": "४७-६४", "content_sanskrit": "नमस्ते देवदेवेश सर्वशत्रुनिषूदन ।\nदेवेश बलिविष्टम्भदेवदैत्यैश्च पूजित ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005381064, "chapter_id": 25381, "verse_number": "४७-६५", "content_sanskrit": "विरूपाक्ष सहस्राक्ष त्र्यक्ष यक्षेश्वरप्रिय ।\nसर्वतः पाणिपादान्त सर्वतो ऽक्षिशिरोमुख ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7005381065, "chapter_id": 25381, "verse_number": "४७-६६", "content_sanskrit": "सर्वतः श्रुतिमल्लोके सर्वमावृत्य तिष्ठसि ।\nशङ्कुकर्ण महाकर्म कुम्भकर्णार्णवालय ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7005381066, "chapter_id": 25381, "verse_number": "४७-६७", "content_sanskrit": "गजेन्द्रकर्ण गोकर्ण पाणिकर्ण नमो ऽस्तु ते ।\nशतजिह्व शतावर्त शतोदर शतानन ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7005381067, "chapter_id": 25381, "verse_number": "४७-६८", "content_sanskrit": "गायन्ति त्वां गायत्रिणो ह्यर्चयन्त्यर्क्कमर्चिणः ।\nब्रह्माणं त्वा शतक्रतो उद्वंशमिव मेनिरे ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7005381068, "chapter_id": 25381, "verse_number": "४७-६९", "content_sanskrit": "मूर्तौ हि ते महामूर्ते समुद्राम्बुधरास्तथा ।\nदेवताः सर्व एवात्र गोष्ठे गाव इवासते ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7005381069, "chapter_id": 25381, "verse_number": "४७-७०", "content_sanskrit": "शरीरे तव पश्यामि सोममग्निं जलेश्वरम् ।\nनारायणं तथा सूर्यं ब्रह्माणं च बृहस्पतिम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7005381070, "chapter_id": 25381, "verse_number": "४७-७१", "content_sanskrit": "भगवान् कारणं कार्यं क्रियाकारणमेव तत् ।\nप्रभवः प्रलयश्चैव सदसच्चापि दैवतम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7005381071, "chapter_id": 25381, "verse_number": "४७-७२", "content_sanskrit": "नमो भवाय शर्वाय वरदायोग्ररूपिणे ।\nअन्धकासुरहन्त्रे च पशूनां पतये नमः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7005381072, "chapter_id": 25381, "verse_number": "४७-७३", "content_sanskrit": "त्रिजटाय त्रिशीर्षाय त्रिशुलासक्कपाणये ।\nत्र्यम्बकाय त्रिनेत्राय त्रिपुरघ्र नमो ऽस्तु ते ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7005381073, "chapter_id": 25381, "verse_number": "४७-७४", "content_sanskrit": "नमो मुण्डाय चण्डाय अण्डायोत्पत्तिहेतवे ।\nडिण्डिमासक्तहस्ताय डिण्डिमुण्डाय ते नमः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7005381074, "chapter_id": 25381, "verse_number": "४७-७५", "content_sanskrit": "नमोर्ध्वकेशदंष्ट्राय शुष्काय विकृताय च ।\nधूम्रलोहितकृष्णाय नीलग्रीवाय ते नमः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7005381075, "chapter_id": 25381, "verse_number": "४७-७६", "content_sanskrit": "नमो ऽस्त्वप्रतिरूपाय विरुपाय शिवाय च ।\nसूर्यमालाय सूर्याय स्वरूपध्वजमालिने ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7005381076, "chapter_id": 25381, "verse_number": "४७-७७", "content_sanskrit": "नमो मानातिमानाय नमः पटुतराय ते ।\nनमो गणेन्द्रनाथाय वृषस्कन्धाय धन्विने ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7005381077, "chapter_id": 25381, "verse_number": "४७-७८", "content_sanskrit": "सङ्क्रन्दनाय चण्डाय पर्णधारपुटाय च ।\nनमो हिरण्यवर्णाय नमः कनकवर्चसे ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7005381078, "chapter_id": 25381, "verse_number": "४७-७९", "content_sanskrit": "नमः स्तुताय स्तुत्याय स्तुतिस्थाय नमो ऽस्तु ते ।\nसर्वाय सर्वभक्षाय सर्वभूतशरीरिणे ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7005381079, "chapter_id": 25381, "verse_number": "४७-८०", "content_sanskrit": "नमो होत्रे च हन्त्रे च सितोदग्रपताकिने ।\nनमो नम्याय नम्राय नमः कटकटाय च ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7005381080, "chapter_id": 25381, "verse_number": "४७-८१", "content_sanskrit": "नमो ऽस्तु कृशनाशाय शयितायोत्थिताय च ।\nस्थिताय धावमानाय मुण्डाय कुटिलाय च ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7005381081, "chapter_id": 25381, "verse_number": "४७-८२", "content_sanskrit": "नमो नर्तनशीलाय लयवादित्रशालिने ।\nनाट्योपहारलुब्धाय मुखवादित्रशालिने ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7005381082, "chapter_id": 25381, "verse_number": "४७-८३", "content_sanskrit": "नमो ज्योष्ठाय श्रेष्ठाय बलतिबलघातिने ।\nकालनाशाय कालाय संसारक्षयरूपिणे ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7005381083, "chapter_id": 25381, "verse_number": "४७-८४", "content_sanskrit": "हिमवद्दुहितुः कान्त भैरवाय नमो ऽस्तु ते ।\nउग्राय च नमो नित्यं नमो ऽस्तु दशबाहवे ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7005381084, "chapter_id": 25381, "verse_number": "४७-८५", "content_sanskrit": "चितिभस्मप्रियायैव कपालासक्तपाणये ।\nविभीषणाय भीष्माय भीमव्रतधराय च ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7005381085, "chapter_id": 25381, "verse_number": "४७-८६", "content_sanskrit": "नमो विकृतवक्त्राय नमः पूतोग्रदृष्टये ।\nपक्वाममांसलुब्धाय तम्बिवीणाप्रियाय च ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7005381086, "chapter_id": 25381, "verse_number": "४७-८७", "content_sanskrit": "नमो वृषाङ्कवृक्षाय गोवृषाभिरुते नमः ।\nकटङ्कटाय भीमाय नमः परपराय च ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7005381087, "chapter_id": 25381, "verse_number": "४७-८८", "content_sanskrit": "नमः सर्ववरिष्ठाय वराय वरदायिने ।\nनमो विरक्तरक्ताय भावनायाक्षमालिने ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7005381088, "chapter_id": 25381, "verse_number": "४७-८९", "content_sanskrit": "विभेदभेदभिन्नाय छायायै तपनाय च ।\nअघोरघोररूपाय घोरघोरतराय च ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7005381089, "chapter_id": 25381, "verse_number": "४७-९०", "content_sanskrit": "नमः शिवाय शान्ताय नमः शान्ततमाय च ।\nबहुनेत्रकपालाय एकमूर्ते नमो ऽस्तु ते ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7005381090, "chapter_id": 25381, "verse_number": "४७-९१", "content_sanskrit": "नमः क्षुद्राय लुब्धाय यज्ञभागप्रियाय च ।\nपञ्चालाय सिताङ्गाय नमो यमनियामिने ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7005381091, "chapter_id": 25381, "verse_number": "४७-९२", "content_sanskrit": "नमश्चित्रोरुघण्टाय घण्टाघण्टनिघण्टिने ।\nसहस्रशतघण्टाय घण्टामालविभूषिणे ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7005381092, "chapter_id": 25381, "verse_number": "४७-९३", "content_sanskrit": "प्रणसङ्घट्टगर्वाय नमः किलिकिलिप्रिये ।\nहुंहुङ्काराय पाराय हुंहुङ्कारप्रियाय च ॥२६।९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7005381093, "chapter_id": 25381, "verse_number": "४७-९४", "content_sanskrit": "नमः समसमे नित्यं गृहवृक्षनिकेतिने ।\nगर्भमांसशृगालाय तारकाय तराय च ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7005381094, "chapter_id": 25381, "verse_number": "४७-९५", "content_sanskrit": "नमो यज्ञाय यजिने हुताय प्रहुताय च ।\nयज्ञवाहाय हव्याय तप्याय तपनाय च ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7005381095, "chapter_id": 25381, "verse_number": "४७-९६", "content_sanskrit": "नमस्तु पयसे तुभ्यं तुण्डानां पतये नमः ।\nअन्नदायान्नपतये नमो नानान्नभोजिने ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7005381096, "chapter_id": 25381, "verse_number": "४७-९७", "content_sanskrit": "नमः सहस्रशीर्षाय सहस्रचरणाय च ।\nसहस्रोद्यतशूलाय सहस्राभरणाय च ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7005381097, "chapter_id": 25381, "verse_number": "४७-९८", "content_sanskrit": "बालनुचरगोप्त्रे च बाललीलाविलासिने ।\nनमो बालाय वृद्धाय क्षुब्धाय क्षोभणाय च ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7005381098, "chapter_id": 25381, "verse_number": "४७-९९", "content_sanskrit": "गङ्गालुलितकेशाय मुञ्जकेशाय वै नमः ।\nनमः षट्कर्मतुष्टाय त्रिकर्मनिरताय च ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7005381099, "chapter_id": 25381, "verse_number": "४७-१००", "content_sanskrit": "नग्नप्राणाय चण्डाय कृशाय स्फोटनाय च ।\nधर्मार्थकाममोक्षाणां कथ्याय कथनाय च ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7005381100, "chapter_id": 25381, "verse_number": "४७-१०१", "content_sanskrit": "साङ्ख्याय साङ्ख्यमुख्याय साङ्ख्ययोगमुखाय च ।\nनमो विरथरथ्याय चतुष्पथरथाय च ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7005381101, "chapter_id": 25381, "verse_number": "४७-१०२", "content_sanskrit": "कुष्णाजिनोत्तरीयाय व्यालयज्ञोपवीतिने ।\nवक्त्रसन्धानकेशाय हरिकेश नमो ऽस्तु ते ।\nत्र्यम्बिकाम्बिकनाथायव्यक्तव्यक्ताय वेधसे ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7005381102, "chapter_id": 25381, "verse_number": "४७-१०३", "content_sanskrit": "कामकामदकामघ्न तृप्तातृप्तविचारिणे ।\nनमः सर्वद पापघ्न कल्पसङ्ख्याविचारिणे ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7005381103, "chapter_id": 25381, "verse_number": "४७-१०४", "content_sanskrit": "महासत्त्व महाबाहो महाबल नमो ऽस्तु ते ।\nमहामेघ महाप्रख्य महाकाल महाध्युते ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7005381104, "chapter_id": 25381, "verse_number": "४७-१०५", "content_sanskrit": "मेघावर्त युगावर्त चन्द्रार्कपतये नमः ।\nत्वमन्नमन्नभोक्ता च पक्वभुक् पावनोत्तम ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7005381105, "chapter_id": 25381, "verse_number": "४७-१०६", "content_sanskrit": "जरायुजाण्डजाश्चैव स्वेदजोद्भिदजाश्च ये ।\nत्वमेव देवदेवेश भूतग्रामश्चतुर्विधः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7005381106, "chapter_id": 25381, "verse_number": "४७-१०७", "content_sanskrit": "स्रष्टा चराचरस्यास्य पाता हन्ता तथैव च ।\nत्वामाहुर्ब्रह्य विद्वांसो ब्रह्म ब्रह्मविदां गतिम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7005381107, "chapter_id": 25381, "verse_number": "४७-१०८", "content_sanskrit": "मनसः परमज्योतिस्त्वं वायुर्ज्योतिषामपि ।\nहंहवृक्षे मधुकरमाहुस्त्वं ब्रह्मवादिनः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7005381108, "chapter_id": 25381, "verse_number": "४७-१०९", "content_sanskrit": "यजुर्मयो ऋङ्मयस्त्वामाहुः साममयस्तथा ।\nपठ्यसे स्तुतिभिर्नित्यं वेदोपनिषदां गणैः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7005381109, "chapter_id": 25381, "verse_number": "४७-११०", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः शूद्रा वर्णावराश्च ये ।\nत्वमेव मेघसङ्घाश्च विद्युतो ऽसनिगर्जितम् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7005381110, "chapter_id": 25381, "verse_number": "४७-१११", "content_sanskrit": "संवत्सरस्त्वमृतवो मासो मासार्धमेव च ।\nयुगा निमेषाः काष्ठाश्च नक्षत्राणि ग्रहाः कलाः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7005381111, "chapter_id": 25381, "verse_number": "४७-११२", "content_sanskrit": "वृक्षाणां ककुभो ऽसि त्वं गिरीणां हिमवान् गिरिः ।\nव्याघ्रो मृगाणां पततां तार्क्ष्यो ऽनन्तश्च भोगिनाम् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7005381112, "chapter_id": 25381, "verse_number": "४७-११३", "content_sanskrit": "क्षिरोदो ऽस्युदधीनां च यन्त्राणां धनुरेव च ।\nवज्रं प्रहरणानां च व्रतानां सत्यमेव च ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7005381113, "chapter_id": 25381, "verse_number": "४७-११४", "content_sanskrit": "त्वमेव द्वेष इच्छा च रागो मोहः क्षमाक्षमे ।\nव्यवसायो धृतिर्लोभः कामक्रोधौ जयाजयौ ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7005381114, "chapter_id": 25381, "verse_number": "४७-११५", "content_sanskrit": "त्वं शरी त्वं गदी चापि खट्वाङ्गी च शरासनी ।\nछेत्ता मेत्ता प्रहर्तासि मन्ता नेता सनातनः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7005381115, "chapter_id": 25381, "verse_number": "४७-११६", "content_sanskrit": "दशलक्षणसंयुक्तो धर्मोर्ऽथः काम एव च ।\nसमुद्राः सरितो गङ्गा पर्वताश्च सरांसि च ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7005381116, "chapter_id": 25381, "verse_number": "४७-११७", "content_sanskrit": "लतावल्ल्यस्तृणौषध्यः पशवो मृगपक्षिणः ।\nद्रव्यकर्मगुणारम्भः कालपुष्पफलप्रदः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7005381117, "chapter_id": 25381, "verse_number": "४७-११८", "content_sanskrit": "आदिश्चन्तश्च वेदानां गायत्री प्रणवस्तथा ।\nलोहितो हरितो नीलः कुष्णः पीतः सितस्तथा ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7005381118, "chapter_id": 25381, "verse_number": "४७-११९", "content_sanskrit": "कद्रुश्च कपिलश्चैव कपोतो मेचकस्तथा ।\nसवर्णश्चाप्यवर्णाश्च कर्ता हर्ता त्वमेव हि ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7005381119, "chapter_id": 25381, "verse_number": "४७-१२०", "content_sanskrit": "त्वमिन्द्रश्च यमश्चैव वरुणो धनदो ऽनिलः ।\nउपप्लवश्चित्रभानुः स्वर्भानुरेव च ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7005381120, "chapter_id": 25381, "verse_number": "४७-१२१", "content_sanskrit": "शिक्षाहैत्रं त्रिसौपर्णं यजुषां शतरुद्रियम् ।\nपवित्रं च पवित्राणां मङ्गलानां च मङ्गलम् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7005381121, "chapter_id": 25381, "verse_number": "४७-१२२", "content_sanskrit": "तिन्दुको गिरिजो वृक्षे मुद्गं चाखिलजीवनम् ।\nप्राणाः सत्त्वं रजश्चैव तमश्च प्रतिपत्पितिः ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7005381122, "chapter_id": 25381, "verse_number": "४७-१२३", "content_sanskrit": "प्राणो ऽपानः मसानश्च उदानो व्यान एव च ।\nउन्मेषश्च निमेषश्च क्षुतं जृम्भितमेव च ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7005381123, "chapter_id": 25381, "verse_number": "४७-१२४", "content_sanskrit": "लोहितान्तर्गतो दृष्टिर्महावक्त्रो महोदरः ।\nशुचिरोमा हरिश्मश्रुरूर्ध्वकेशश्चलाचलः ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7005381124, "chapter_id": 25381, "verse_number": "४७-१२५", "content_sanskrit": "गीतवादित्रनृत्यज्ञो गीतवादित्रकप्रियः ।\nमत्स्यो जालो जलौकाश्च कालः केलिकला कलिः ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7005381125, "chapter_id": 25381, "verse_number": "४७-१२६", "content_sanskrit": "अकालश्च विकालश्च दुष्कालः काल एव च ।\nमृत्युश्च मृत्युकर्ता च यक्षो यक्षभयङ्करः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7005381126, "chapter_id": 25381, "verse_number": "४७-१२७", "content_sanskrit": "संवर्तको ऽन्तकश्चैव संवर्तकबलाहकः ।\nघण्टो घण्टी माहघण्टी चिरी माली च मातलिः ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7005381127, "chapter_id": 25381, "verse_number": "४७-१२८", "content_sanskrit": "ब्रह्मकालयमाग्नीनां दण्डी मुण्डी त्रिमुण्डधृक् ।\nचतुर्युगश्चतुर्वेदश्चातुर्हेत्रप्रवर्तकः ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7005381128, "chapter_id": 25381, "verse_number": "४७-१२९", "content_sanskrit": "चातुराश्रम्यनेता च चातुर्वर्ण्यकरस्तथा ।\nनित्यमक्षप्रियो धूर्तो गणाध्यक्षो गणाधिपः ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7005381129, "chapter_id": 25381, "verse_number": "४७-१३०", "content_sanskrit": "रक्तमाल्याम्बरधरो गिरिको गिरिकप्रियः ।\nशिल्पं च शिल्पिनां श्रेष्ठः सर्वशिल्पप्रवर्तकः ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7005381130, "chapter_id": 25381, "verse_number": "४७-१३१", "content_sanskrit": "भगनेत्राङ्कुशश्चण्डः पूष्णो दन्तविनाशनः ।\nस्वाहा स्वधा वषट्कारो नमस्कारो नमो नमः ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7005381131, "chapter_id": 25381, "verse_number": "४७-१३२", "content_sanskrit": "गूढव्रतो गुह्यतपास्तारकास्तारकामयः ।\nधाता विधाता सन्धाता पृथिव्या धरणो ऽपरः ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7005381132, "chapter_id": 25381, "verse_number": "४७-१३३", "content_sanskrit": "ब्रह्म तपश्च सत्यं च व्रतचर्य मथार्जवम् ।\nभूतात्मा भूतकृद् भूतिर्भूतभव्यभवोद्भवः ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7005381133, "chapter_id": 25381, "verse_number": "४७-१३४", "content_sanskrit": "भूर्भुवः स्वरृतं चैव ध्रुवो दान्तो महेश्वरः ।\nदीक्षितो ऽदीक्षितः कान्तो दुर्दान्तो दान्तसम्भवः ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7005381134, "chapter_id": 25381, "verse_number": "४७-१३५", "content_sanskrit": "चन्द्रावर्तो युगावर्तः संवर्तकप्रवर्तकः ।\nबिन्दुः कामो ह्यणुः स्थूलः कर्णिकारस्रजप्रियः ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7005381135, "chapter_id": 25381, "verse_number": "४७-१३६", "content_sanskrit": "नन्दीमुखो भीममुकः सुमुको दुर्मुखस्तथा ।\nहिरण्यगर्भः शकुनिर्महोरगपतिर्विराट् ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7005381136, "chapter_id": 25381, "verse_number": "४७-१३७", "content_sanskrit": "अधर्महा महादेवो दण्डधारो गणोत्कटः ।\nगोनर्दे गोप्रतारश्च गोवृषेश्वरवाहनः ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7005381137, "chapter_id": 25381, "verse_number": "४७-१३८", "content_sanskrit": "त्रैलोक्यगोप्ता गोविन्दो गोमार्गो मार्ग एव च ।\nस्थिरः श्रेष्ठश्च स्थाणुश्च विक्रोशः क्रोश एव च ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7005381138, "chapter_id": 25381, "verse_number": "४७-१३९", "content_sanskrit": "दुर्वारणो दुर्विषहो दुःसहो दुरतिक्रमः ।\nदुर्द्धर्षो दुष्प्रकाशश्च दुर्दुर्शो दुर्जयो जयः ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7005381139, "chapter_id": 25381, "verse_number": "४७-१४०", "content_sanskrit": "शशाङ्कानलशीतोष्णः क्षुत्तृष्णा च निरामयः ।\nआधयो व्याधयश्चैव व्याधिहा व्याधिनाशनः ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7005381140, "chapter_id": 25381, "verse_number": "४७-१४१", "content_sanskrit": "समूहश्च समूहस्य हन्ता देवः सनातनः ।\nशिखण्डी पुण्डरीकाक्षः पुण्डरीकवनालयः ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7005381141, "chapter_id": 25381, "verse_number": "४७-१४२", "content_sanskrit": "त्र्यम्बको दण्डधारश्च उग्रदंष्ट्रः कुलान्तकः ।\nविषापहः सुरश्रेष्ठः सोमपास्त्वं मरुत्पते ।\nअमृताशी जगन्नातो देवदेव गणेश्वरः ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7005381142, "chapter_id": 25381, "verse_number": "४७-१४३", "content_sanskrit": "मधुश्च्युतानां मधुपो ब्रह्मवाक् त्वं घृतच्युतः ।\nसर्वलोकस्य भोक्ता त्वं सर्वलोकपितामहः ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7005381143, "chapter_id": 25381, "verse_number": "४७-१४४", "content_sanskrit": "हिरण्यरेताः पुरुषस्त्वमेकः त्वं स्त्री पुमांस्त्वं हि नपुंसकं च ।\nबालो युवा स्थविरो देवदंष्ट्रा त्वन्नो गिरिर्विश्वकृद् विश्वहर्ता ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7005381144, "chapter_id": 25381, "verse_number": "४७-१४५", "content_sanskrit": "त्वं वै धाता विश्वकृतां वरेण्यस् त्वां पूजयन्ति प्रणताः सदैव ।\nचन्द्रादित्यौ चक्षुषी ते भवान् हि त्वमेव चाग्निः प्रपितामहश्च ।\nआराध्य त्वां सरखतीं वाग्लभन्ते अहोरात्रे निमिषोन्मेषकर्ता ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7005381145, "chapter_id": 25381, "verse_number": "४७-१४६", "content_sanskrit": "न ब्रह्मा न च गोविन्दः पौराणा ऋषयो न ते ।\nमाहात्म्यं वेदितुं शक्ता यातातथ्येन शङ्कर ॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7005381146, "chapter_id": 25381, "verse_number": "४७-१४७", "content_sanskrit": "पुंसां शतसहस्राणि यत्समावृत्य तिष्ठति ।\nमहतस्तमसः पारे गोप्ता मन्ता भवान् सदा ॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7005381147, "chapter_id": 25381, "verse_number": "४७-१४८", "content_sanskrit": "यं विनिद्रा जितश्वासाः सत्त्वस्थाः संयतेन्द्रियाः ।\nज्योतिः पश्यन्ति युञ्जानास्तस्मै योगात्मने नमः ॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7005381148, "chapter_id": 25381, "verse_number": "४७-१४९", "content_sanskrit": "या मूर्तयश्च सूक्ष्मास्ते न शक्या या निदर्शितुम् ।\nताभिर्मां सततं रक्ष पिता पुत्रमिवौरसम् ॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7005381149, "chapter_id": 25381, "verse_number": "४७-१५०", "content_sanskrit": "रक्ष मां रक्षणीयो ऽहं तवानघ नमो ऽस्तु ते ।\nभक्तानुकम्पी भगवान् भक्तश्चाहं सदा त्वयि ॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 7005381150, "chapter_id": 25381, "verse_number": "४७-१५१", "content_sanskrit": "जटिने दण्डिने नित्यं लम्बोदरशारीरिणे ।\nकमण्डलुनिषङ्गाय तस्मै रुद्रात्मने नमः ॥१५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 7005381151, "chapter_id": 25381, "verse_number": "४७-१५२", "content_sanskrit": "यस्य केशेषु जीमूता नद्याः सर्वाङ्गसन्धिषु ।\nकुक्षौ समुद्रश्चत्वारस्तस्मै तोयात्मने नमः ॥१५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 7005381152, "chapter_id": 25381, "verse_number": "४७-१५३", "content_sanskrit": "सम्भक्ष्य सर्वभूतानि युगान्ते पर्युपस्थिते ।\nयः शेते जलमध्यस्थस्तं प्रपद्ये ऽम्बुशायिनम् ॥१५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 7005381153, "chapter_id": 25381, "verse_number": "४७-१५४", "content_sanskrit": "प्रविश्य वदनं राहोर्यः सोमं पिबते निशि ।\nग्रसत्यर्कं च खर्भानू रक्षितस्तव तेजसा ॥१५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}, {"id": 7005381154, "chapter_id": 25381, "verse_number": "४७-१५५", "content_sanskrit": "ये चात्र पतिता गर्भा रुद्रगन्धस्य रक्षेण ।\nनमस्ते ऽस्तु खधा खाहा प्राप्नुवन्ति तदद्भुते ॥१५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 155}, {"id": 7005381155, "chapter_id": 25381, "verse_number": "४७-१५६", "content_sanskrit": "ये ऽङ्गुष्ठमात्राः पुरुषा देहस्थाः सर्वदेहिनाम् ।\nरक्षन्तु ते हि मां नित्यं ते मामाप्याययन्तु वै ॥१५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 156}, {"id": 7005381156, "chapter_id": 25381, "verse_number": "४७-१५७", "content_sanskrit": "ये नदीषु समुद्रेषु पर्वतेषु गुहासु च ।\nवृभमूलेषु गोष्ठेषु कान्तारगहनेषु च ॥१५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 157}, {"id": 7005381157, "chapter_id": 25381, "verse_number": "४७-१५८", "content_sanskrit": "चतुष्पथेषु रथ्यासु चत्वरेषु सभासु च ।\nहस्त्यश्वरथशालासु जीर्णोद्यानालयेषु च ॥१५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 158}, {"id": 7005381158, "chapter_id": 25381, "verse_number": "४७-१५९", "content_sanskrit": "ये च पञ्चसु भूतेषु दिशासु विदिशासु च ।\nचन्द्रार्कयोर्मध्यागता ये च चन्द्रार्करश्मिषु ॥१५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 159}, {"id": 7005381159, "chapter_id": 25381, "verse_number": "४७-१६०", "content_sanskrit": "रसातलगता ये च ये च तस्मात् परं गताः ।\nनमस्तेभ्यो नमस्तेभ्यो नमस्तेभ्यश्च नित्यशः ॥१६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 160}, {"id": 7005381160, "chapter_id": 25381, "verse_number": "४७-१६१", "content_sanskrit": "येषां न विद्यते सङ्ख्या प्रमाणं रूपमेव च ।\nअसङ्ख्येयगणा रुद्रा नमस्तेभ्यो ऽस्तु नित्यशः ॥१६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 161}, {"id": 7005381161, "chapter_id": 25381, "verse_number": "४७-१६२", "content_sanskrit": "प्रसीद मम भद्रं ते तव भावगतस्य च ।\nत्वयि मे हृदयं देव त्वयि बुद्धिर्मतिस्त्वयि ॥१६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 162}, {"id": 7005381162, "chapter_id": 25381, "verse_number": "४७-१६३", "content_sanskrit": "स्तुत्वैवं स महादेवं विरराम द्विजोत्त्मः ॥१६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 163}]