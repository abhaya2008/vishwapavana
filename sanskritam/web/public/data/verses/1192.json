[{"id": 2009755, "chapter_id": 1192, "verse_number": "१-१९३-०x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2009756, "chapter_id": 1192, "verse_number": "१-१९३-१", "content_sanskrit": "ततो दृष्ट्वाश्रमपदं रहितं तैः सुतैर्मुनिः।\nनिर्जगाम सुदुःखार्तः पुनरप्याश्रमात्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2009757, "chapter_id": 1192, "verse_number": "१-१९३-२", "content_sanskrit": "सोऽपश्यत्सरितं पूर्णां प्रावृट्काले नवाम्भसा।\nवृक्षान्बहुविधान्पार्थ हरन्तीं तीरजान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2009758, "chapter_id": 1192, "verse_number": "१-१९३-३", "content_sanskrit": "अथ चिन्तां समापेदे पुनः कौरवनन्दन।\nअम्भस्यस्या निमज्जेयमिति दुःखसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2009759, "chapter_id": 1192, "verse_number": "१-१९३-४", "content_sanskrit": "ततः पाशैस्तदात्मानं गाढं बद्ध्वा महामुनिः।\nतस्या जले महानद्या निममज्ज सुदुःखितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2009760, "chapter_id": 1192, "verse_number": "१-१९३-५", "content_sanskrit": "अथ च्छित्त्वा नदी पाशांस्तस्यारिबलसूदन।\nस्थलस्थं तमृषिं कृत्वा विपाशं समवासृजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2009761, "chapter_id": 1192, "verse_number": "१-१९३-६", "content_sanskrit": "उत्ततार ततः पाशैर्विमुक्तः स महानृषिः।\nविपाशेति च नामास्या नद्याश्चक्रे महानृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2009762, "chapter_id": 1192, "verse_number": "१-१९३-७", "content_sanskrit": "सा विपाशेति विख्याता नदी लोकेषु भारत।\nऋषेस्तस्य नरव्याघ्र वचनात्सत्यवादिनः।\nउत्तीर्य च तदा राजन्दुःखितो भगवानृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2009763, "chapter_id": 1192, "verse_number": "१-१९३-८", "content_sanskrit": "शोके बुद्धिं तदा चक्रे न चैकत्र व्यतिष्ठत।\nसोऽगच्छत्पर्वतांश्चैव सरितश्च सरांसि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2009764, "chapter_id": 1192, "verse_number": "१-१९३-९", "content_sanskrit": "दृष्ट्वा स पुनरेवर्षिर्नदीं हैमवतीं तदा।\nचण्डग्राहवतीं भीमां तस्याः स्रोतस्यपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2009765, "chapter_id": 1192, "verse_number": "१-१९३-१०", "content_sanskrit": "सा तमग्निसं विप्रमनुचिन्त्य सरिद्वरा।\nशतधा विद्रुता तस्माच्छतद्रुरिति विश्रुता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2009766, "chapter_id": 1192, "verse_number": "१-१९३-११", "content_sanskrit": "ततः स्थलगतं दृष्ट्वा तत्राप्यात्मानमात्मना।\nमर्तुं न शक्यमित्युक्त्वा पुवरेवाश्रमं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2009767, "chapter_id": 1192, "verse_number": "१-१९३-१२", "content_sanskrit": "स गत्वा विविधाञ्शैलान्देशान्बहुविधांस्तथा।\nअदृशन्त्याख्यया वध्वाथाश्रमेनुसृतोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2009768, "chapter_id": 1192, "verse_number": "१-१९३-१३", "content_sanskrit": "अथ शुश्राव संगत्या वेदाध्ययननिःस्वनम्।\nपृष्ठतः परिपूर्णार्थं षड्मिरङ्गैरलङ्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2009769, "chapter_id": 1192, "verse_number": "१-१९३-१४", "content_sanskrit": "अनुव्रजति कोन्वेष मामित्येवाथ सोऽब्रवीत्।\nअदृश्यन्त्येवमुक्ता वै तं स्नुषा प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2009770, "chapter_id": 1192, "verse_number": "१-१९३-१५", "content_sanskrit": "शक्तोभार्या महाभाग तपोयुक्ता तपस्विनम्।\nअहमेकाकिनी चापि त्वया गच्छामि नापरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2009771, "chapter_id": 1192, "verse_number": "१-१९३-१६x", "content_sanskrit": "वसिष्ठ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2009772, "chapter_id": 1192, "verse_number": "१-१९३-१६", "content_sanskrit": "पुत्रि कस्यैष साङ्गस्य वेदस्याध्ययनस्वनः।\nपुरा साङ्गस्य वेदस्य शक्तेरिव मया श्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2009773, "chapter_id": 1192, "verse_number": "१-१९३-१७x", "content_sanskrit": "अदृश्यन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2009774, "chapter_id": 1192, "verse_number": "१-१९३-१७", "content_sanskrit": "अयं कुक्षौ समुत्पन्नः शक्तेर्गर्भः सुतस्य ते।\nसमा द्वादश तस्येह वेदानभ्यस्यतो मुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2009775, "chapter_id": 1192, "verse_number": "१-१९३-१८x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2009776, "chapter_id": 1192, "verse_number": "१-१९३-१८", "content_sanskrit": "एवमुक्तस्तया हृष्टो वसिष्ठः श्रेष्ठभागृषिः।\nअस्ति सन्तानमित्युक्त्वा मृत्योः पार्थ न्यवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2009777, "chapter_id": 1192, "verse_number": "१-१९३-१९", "content_sanskrit": "ततः प्रतिनिवृत्तः स तया वध्वा सहानघ।\nकल्माषपादमासीनं ददर्श विजने वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2009778, "chapter_id": 1192, "verse_number": "१-१९३-२०", "content_sanskrit": "स तु दृष्ट्वैव तं राजा क्रुद्ध उत्थाय भारत।\nआविष्टो रक्षसोग्रेण इयेषात्तुं तदा मुनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2009779, "chapter_id": 1192, "verse_number": "१-१९३-२१", "content_sanskrit": "अदृश्यन्ती तु तं दृष्ट्वा क्रूरकर्माणमग्रतः।\nभयसंविग्नया वाचा वसिष्ठमिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2009780, "chapter_id": 1192, "verse_number": "१-१९३-२२", "content_sanskrit": "असौ मृत्युरिवोग्रेण दण्डेन भगवन्नितः।\nप्रगृहीतेन काष्ठेन राक्षसोऽभ्येति दारुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2009781, "chapter_id": 1192, "verse_number": "१-१९३-२३", "content_sanskrit": "तं निवारयितुं शक्तो नान्योऽस्ति भुवि कश्चन।\nस्वदृतेऽद्य महाभाग सर्ववेदविदां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2009782, "chapter_id": 1192, "verse_number": "१-१९३-२४", "content_sanskrit": "पाहि मां भगवन्पापादस्माद्दारुणदर्शनात्।\nराक्षसोऽयमिहात्तुं वै नूनमावां समीहते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2009783, "chapter_id": 1192, "verse_number": "१-१९३-२५x", "content_sanskrit": "वसिष्ठ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2009784, "chapter_id": 1192, "verse_number": "१-१९३-२५", "content_sanskrit": "माभैः पुत्रि न भेतव्यं राक्षसात्तु कथंचन।\nनैतद्रक्षो भयं यस्मात्पश्यसि त्वमुपस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2009785, "chapter_id": 1192, "verse_number": "१-१९३-२६", "content_sanskrit": "राजा कल्माषपादोऽयं वीर्यवान्प्रथितो भुवि।\nस एषोऽस्मिन्वनोद्देशे निवसत्यतिभीषणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2009786, "chapter_id": 1192, "verse_number": "१-१९३-२७x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2009787, "chapter_id": 1192, "verse_number": "१-१९३-२७", "content_sanskrit": "तमापतन्तं संप्रेक्ष्य वसिष्ठो भगवानृषिः।\nवारयामास तेजस्वी हुङ्कारेणैव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2009788, "chapter_id": 1192, "verse_number": "१-१९३-२८", "content_sanskrit": "मन्त्रपूतेन च पुनः स तमभ्युक्ष्य वारिणा।\nमोक्षयामास वै शापात्तस्माद्योगान्नराधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2009789, "chapter_id": 1192, "verse_number": "१-१९३-२९", "content_sanskrit": "स हि द्वादश वर्षाणि वासिष्ठस्यैव तेजसा।\nग्रस्त आसीद्ग्रहेणेव पर्वकाले दिवाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2009790, "chapter_id": 1192, "verse_number": "१-१९३-३०", "content_sanskrit": "रक्षसा विप्रमुक्तोऽथ स नृपस्तद्वनं महत्।\nतेजसा रञ्जयामास न्ध्याभ्रमिव भास्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2009791, "chapter_id": 1192, "verse_number": "१-१९३-३१", "content_sanskrit": "प्रतिलभ्य ततः संज्ञामभिवाद्य कृताञ्जलिः।\nउवाच नृपतिः काले वसिष्ठमृषिसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2009792, "chapter_id": 1192, "verse_number": "१-१९३-३२", "content_sanskrit": "सौदासोऽहं महाभाग याज्यस्ते मुनिसत्तम।\nअस्मिन्काले यदिष्टं ते ब्रूहि किं करवाणि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2009793, "chapter_id": 1192, "verse_number": "१-९३-३३x", "content_sanskrit": "वसिष्ठ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2009794, "chapter_id": 1192, "verse_number": "१-१९३-३३", "content_sanskrit": "वृत्तमेतद्यथाकालं गच्छ राज्यं प्रशाधि वै।\nब्राह्मणं तु मनुष्येन्द्र माऽवमंस्थाः कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2009795, "chapter_id": 1192, "verse_number": "१-१९३-३४x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2009796, "chapter_id": 1192, "verse_number": "१-१९३-३४", "content_sanskrit": "नावमंस्ये महाभाग कदाचिद्ब्राह्मणर्षभान्।\nत्वन्निदेशे स्थितः सम्यक् पूजयिष्याम्यहं द्विजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2009797, "chapter_id": 1192, "verse_number": "१-१९३-३५", "content_sanskrit": "इक्ष्वाकूणां च येनाहमनृणः स्यां द्विजोत्तम।\nतत्त्वत्तः प्राप्तुमिच्छामि सर्ववेदविदां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2009798, "chapter_id": 1192, "verse_number": "१-१९३-३६", "content_sanskrit": "अपत्यायेप्सिताय त्वं महिषीं गन्तुमर्हसि।\nशीलरूपगुणोपेतामिक्ष्वाकुकुलवृद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2009799, "chapter_id": 1192, "verse_number": "१-१९३-३७x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2009800, "chapter_id": 1192, "verse_number": "१-१९३-३७", "content_sanskrit": "ददानीत्येव तं तत्र राजानं प्रत्युवाच ह।\nवसिष्ठः परमेष्वासं सत्यसन्धो द्विजोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2009801, "chapter_id": 1192, "verse_number": "१-१९३-३८", "content_sanskrit": "ततः प्रतिययौ काले वसिष्ठः सह तेन वै।\nख्यातां पुरीमिमां लोकेष्वयोध्यां मनुजेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2009802, "chapter_id": 1192, "verse_number": "१-१९३-३९", "content_sanskrit": "तं प्रजाः प्रतिमोदन्त्यः सर्वाः प्रत्युद्गतास्तदा।\nविपाप्मानं महात्मानं दिवौकस इवेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2009803, "chapter_id": 1192, "verse_number": "१-१९३-४०", "content_sanskrit": "सुचिराय मनुष्येन्द्रो नगरीं पुण्यलक्षणाम्।\nविवेश सहितस्तेन वसिष्ठेन महर्षिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2009804, "chapter_id": 1192, "verse_number": "१-१९३-४१", "content_sanskrit": "ददृशुस्तं महीपालमयोध्यावासिनो जनाः।\nपुरोहितेन सहितं दिवाकरमिवोदितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2009805, "chapter_id": 1192, "verse_number": "१-१९३-४२", "content_sanskrit": "स च तां पूरयामास लक्ष्म्या लक्ष्मीवतां वरः।\nअयोध्यां व्योम शीतांशुः शरत्काल इवोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2009806, "chapter_id": 1192, "verse_number": "१-१९३-४३", "content_sanskrit": "संसक्तिमृष्टपन्थानं पताकाध्वजशोभितम्।\nमनः प्रह्लादयामास तस्य तत्पुरमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2009807, "chapter_id": 1192, "verse_number": "१-१९३-४४", "content_sanskrit": "तुष्टपुष्टजनाकीर्णा सा पुरी कुरुनन्दन।\nअशोभत तदा तेन शक्रेणेवामरावती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2009808, "chapter_id": 1192, "verse_number": "१-१९३-४५", "content_sanskrit": "ततः प्रविष्टे राजर्षौ तस्मिंस्तत्पुरमुत्तमम्।\nराज्ञस्तस्याज्ञया देवी वसिष्ठमुपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2009809, "chapter_id": 1192, "verse_number": "१-१९३-४६", "content_sanskrit": "ऋतावथ महर्षिस्तु संबभूव तया सह।\nदेव्या दिव्येन विधिना वसिष्ठः श्रेष्ठभागृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2009810, "chapter_id": 1192, "verse_number": "१-१९३-४७", "content_sanskrit": "ततस्तस्यां समुत्पन्ने गर्भे स मुनिसत्तमः।\nराज्ञाभिवादितस्तेन जगाम मुनिराश्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2009811, "chapter_id": 1192, "verse_number": "१-१९३-४८", "content_sanskrit": "दीर्घकालेन सा गर्भं सुषुवे न तु तं यदा।\nतदा देव्यश्मना कुक्षिं निर्बिभेद यशस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2009812, "chapter_id": 1192, "verse_number": "१-१९३-४९", "content_sanskrit": "ततो द्वादशमे वर्षे स जज्ञे पुरषर्षभः।\nअश्मको नाम राजर्षिः पौदन्यं यो न्यवेशयत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2009813, "chapter_id": 1192, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि चैत्ररथपर्वणि त्रिनवत्यधिकशततमोऽध्यायः॥ १९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]