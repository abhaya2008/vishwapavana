[{"id": 5000010000, "chapter_id": 9010, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे दशमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000010001, "chapter_id": 9010, "verse_number": "१-१०-१", "content_sanskrit": "सुमन्त्रश्चोदितो राज्ञा प्रोवाचेदं वचस्तदा\nयथर्ष्यशृङ्गस्त्वानीतो येनोपायेन मन्त्रिभिः\nतन्मे निगदितं सर्वं शृणु मे मन्त्रिभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000010002, "chapter_id": 9010, "verse_number": "१-१०-२", "content_sanskrit": "रोमपादमुवाचेदं सहामात्यः पुरोहितः\nउपायो निरपायोऽयमस्माभिरभिचिन्तितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000010003, "chapter_id": 9010, "verse_number": "१-१०-३", "content_sanskrit": "ऋष्यशृङ्गो वनचरस्तपःस्वाध्यायसंयुतः\nअनभिज्ञस्तु नारीणां विषयाणां सुखस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000010004, "chapter_id": 9010, "verse_number": "१-१०-४", "content_sanskrit": "इन्द्रियार्थैरभिमतैर्नरचित्तप्रमाथिभिः\nपुरमानाययिष्यामः क्षिप्रं चाध्यवसीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000010005, "chapter_id": 9010, "verse_number": "१-१०-५", "content_sanskrit": "गणिकास्तत्र गच्छन्तु रूपवत्यः स्वलङ्कृताः\nप्रलोभ्य विविधोपायैरानेष्यन्तीह सत्कृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000010006, "chapter_id": 9010, "verse_number": "१-१०-६", "content_sanskrit": "श्रुत्वा तथेति राजा च प्रत्युवाच पुरोहितम्\nपुरोहितो मन्त्रिणश्च तथा चक्रुश्च ते तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000010007, "chapter_id": 9010, "verse_number": "१-१०-७", "content_sanskrit": "वारमुख्यास्तु तच्छ्रुत्वा वनं प्रविविशुर्महत्\nआश्रमस्याविदूरेऽस्मिन् यत्नं कुर्वन्ति दर्शने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000010008, "chapter_id": 9010, "verse_number": "१-१०-८", "content_sanskrit": "ऋषेः पुत्रस्य धीरस्य नित्यमाश्रमवासिनः\nपितुः स नित्यसन्तुष्टो नातिचक्राम चाश्रमात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000010009, "chapter_id": 9010, "verse_number": "१-१०-९", "content_sanskrit": "न तेन जन्मप्रभृति दृष्टपूर्वं तपस्विना\nस्त्री वा पुमान्वा यच्चान्यत् सत्त्वं नगरराष्ट्रजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000010010, "chapter_id": 9010, "verse_number": "१-१०-१०", "content_sanskrit": "ततः कदाचित् तं देशमाजगाम यदृच्छया\nविभाण्डकसुतस्तत्र ताश्चापश्यद् वराङ्गनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000010011, "chapter_id": 9010, "verse_number": "१-१०-११", "content_sanskrit": "ताश्चित्रवेषाः प्रमदा गायन्त्यो मधुरस्वरम्\nऋषिपुत्रमुपागम्य सर्वा वचनमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000010012, "chapter_id": 9010, "verse_number": "१-१०-१२", "content_sanskrit": "कस्त्वं किं वर्तसे ब्रह्मञ्ज्ञातुमिच्छामहे वयम्\nएकस्त्वं विजने घोरे वने चरसि शंस नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000010013, "chapter_id": 9010, "verse_number": "१-१०-१३", "content_sanskrit": "अदृष्टरूपास्तास्तेन काम्यरूपा वने स्त्रियः\nहार्दात्तस्य मतिर्जाता आख्यातुं पितरं स्वकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000010014, "chapter_id": 9010, "verse_number": "१-१०-१४", "content_sanskrit": "पिता विभाण्डकोऽस्माकं तस्याहं सुत औरसः\nऋष्यशृङ्ग इति ख्यातं नाम कर्म च मे भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000010015, "chapter_id": 9010, "verse_number": "१-१०-१५", "content_sanskrit": "इहाश्रमपदोऽस्माकं समीपे शुभदर्शनाः\nकरिष्ये वोऽत्र पूजां वै सर्वेषां विधिपूर्वकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000010016, "chapter_id": 9010, "verse_number": "१-१०-१६", "content_sanskrit": "ऋषिपुत्रवचः श्रुत्वा सर्वासां मतिरास वै\nतदाश्रमपदं द्रष्टुं जग्मुः सर्वास्ततोऽङ्गनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000010017, "chapter_id": 9010, "verse_number": "१-१०-१७", "content_sanskrit": "गतानां तु ततः पूजामृषिपुत्रश्चकार ह\nइदमर्घ्यमिदं पाद्यमिदं मूलं फलं च नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000010018, "chapter_id": 9010, "verse_number": "१-१०-१८", "content_sanskrit": "प्रतिगृह्य तु तां पूजां सर्वा एव समुत्सुकाः\nऋषेर्भीताश्च शीघ्रं तु गमनाय मतिं दधुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000010019, "chapter_id": 9010, "verse_number": "१-१०-१९", "content_sanskrit": "अस्माकमपि मुख्यानि फलानीमानि हे द्विज\nगृहाण विप्र भद्रं ते भक्षयस्व च मा चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000010020, "chapter_id": 9010, "verse_number": "१-१०-२०", "content_sanskrit": "ततस्तास्तं समालिङ्ग्य सर्वा हर्षसमन्विताः\nमोदकान् प्रददुस्तस्मै भक्ष्यांश्च विविधाञ्छुभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000010021, "chapter_id": 9010, "verse_number": "१-१०-२१", "content_sanskrit": "तानि चास्वाद्य तेजस्वी फलानीति स्म मन्यते\nअनास्वादितपूर्वाणि वने नित्यनिवासिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000010022, "chapter_id": 9010, "verse_number": "१-१०-२२", "content_sanskrit": "आपृच्छ्य च तदा विप्रं व्रतचर्यां निवेद्य च\nगच्छन्ति स्मापदेशात्ता भीतास्तस्य पितुः स्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000010023, "chapter_id": 9010, "verse_number": "१-१०-२३", "content_sanskrit": "गतासु तासु सर्वासु काश्यपस्यात्मजो द्विजः\nअस्वस्थहृदयश्चासीद् दुःखाच्च परिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000010024, "chapter_id": 9010, "verse_number": "१-१०-२४", "content_sanskrit": "ततोऽपरेद्युस्तं देशमाजगाम स वीर्यवान्\nविभाण्डकसुतः श्रीमान् मनसाचिन्तयन्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000010025, "chapter_id": 9010, "verse_number": "१-१०-२५", "content_sanskrit": "मनोज्ञा यत्र ता दृष्टा वारमुख्याः स्वलङ्कृताः\nदृष्ट्वैव च ततो विप्रमायान्तं हृष्टमानसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000010026, "chapter_id": 9010, "verse_number": "१-१०-२६", "content_sanskrit": "उपसृत्य ततः सर्वास्तास्तमूचुरिदं वचः\nएह्याश्रमपदं सौम्य अस्माकमिति चाब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000010027, "chapter_id": 9010, "verse_number": "१-१०-२७", "content_sanskrit": "चित्राण्यत्र बहूनि स्युर्मूलानि च फलानि च\nतत्राप्येष विशेषेण विधिर्हि भविता ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000010028, "chapter_id": 9010, "verse_number": "१-१०-२८", "content_sanskrit": "श्रुत्वा तु वचनं तासां सर्वासां हृदयङ्गमम्\nगमनाय मतिं चक्रे तं च निन्युस्तदा स्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000010029, "chapter_id": 9010, "verse_number": "१-१०-२९", "content_sanskrit": "तत्र चानीयमाने तु विप्रे तस्मिन् महात्मनि\nववर्ष सहसा देवो जगत् प्रह्लादयंस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000010030, "chapter_id": 9010, "verse_number": "१-१०-३०", "content_sanskrit": "वर्षेणैवागतं विप्रं तापसं स नराधिपः\nप्रत्युद्गम्य मुनिं प्रह्वः शिरसा च महीं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000010031, "chapter_id": 9010, "verse_number": "१-१०-३१", "content_sanskrit": "अर्घ्यं च प्रददौ तस्मै न्यायतः सुसमाहितः\nवव्रे प्रसादं विप्रेन्द्रान्मा विप्रं मन्युराविशेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000010032, "chapter_id": 9010, "verse_number": "१-१०-३२", "content_sanskrit": "अन्तःपुरं प्रवेश्यास्मै कन्यां दत्त्वा यथाविधि\nशान्तां शान्तेन मनसा राजा हर्षमवाप सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000010033, "chapter_id": 9010, "verse_number": "१-१०-३३", "content_sanskrit": "एवं स न्यवसत् तत्र सर्वकामैः सुपूजितः\nऋष्यशृङ्गो महातेजाः शान्तया सह भार्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000010034, "chapter_id": 9010, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे दशमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]