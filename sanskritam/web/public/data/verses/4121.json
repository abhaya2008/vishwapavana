[{"id": 2144950, "chapter_id": 4121, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2144951, "chapter_id": 4121, "verse_number": "१", "content_sanskrit": "किमसौ पाण्डवो राजा धर्मपुत्रोऽभ्यभाषत ।\nश्रुत्वैतद् बहुलाः सेनाः प्रीत्यर्थे नः समागताः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2144952, "chapter_id": 4121, "verse_number": "२", "content_sanskrit": "किमसौ चेष्टते सूत योत्स्यमानो युधिष्ठिरः ।\nके वाऽस्मद्भ्रातृपुत्राणां पश्यन्त्याज्ञेप्सवो मुखम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2144953, "chapter_id": 4121, "verse_number": "३", "content_sanskrit": "के स्विदेनं वारयन्ति युद्धाच्छाम्येति वा पुनः ।\nनिकृत्या कोपितं मन्दैर्धर्मज्ञं धर्मचारिणम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2144954, "chapter_id": 4121, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2144955, "chapter_id": 4121, "verse_number": "४", "content_sanskrit": "राज्ञो मुखमुदीक्षन्ते पाञ्चालाः पाण्डवैः सह ।\nयुधिष्ठिरस्य भद्रं ते स सर्वाननुशास्ति च\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2144956, "chapter_id": 4121, "verse_number": "५", "content_sanskrit": "पृथग्भूताः पाण्डवानां पाञ्चालानां रथव्रजाः ।\nआयान्तमभिनन्दन्ति कुन्तीपुत्रं युधिष्ठिरम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2144957, "chapter_id": 4121, "verse_number": "६", "content_sanskrit": "नभः सूर्यमिवोद्यन्तं यज्ञमाश्विनशंसिनम् ।\nपाञ्चालाः प्रतिनन्दन्ति तेजोराशिमिवोदितम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2144958, "chapter_id": 4121, "verse_number": "७", "content_sanskrit": "आगोपालाविपालाश्च नन्दमाना युधिष्ठिरम् ।\nपाञ्चालाः केकया मत्स्याः प्रतिनन्दन्ति पाण्डवम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2144959, "chapter_id": 4121, "verse_number": "८", "content_sanskrit": "ब्राह्मण्यो राजपुत्र्यश्च विशां दुहितरश्च याः ।\nक्रीडन्त्योऽभिसमायान्ति पार्थं सन्नद्धमीक्षितुम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2144960, "chapter_id": 4121, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2144961, "chapter_id": 4121, "verse_number": "९", "content_sanskrit": "सञ्जयाचक्ष्व केनास्मान् पाण्डवा अभ्ययुञ्जत ।\nधृष्टद्युम्नस्य सैन्येन सोमकानां बलेन च\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2144962, "chapter_id": 4121, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2144963, "chapter_id": 4121, "verse_number": "१०", "content_sanskrit": "गावल्गणिस्तु तत्पृष्टः सभायां कुरुसंसदि ।\nनिःश्वस्य सुभृशं दीर्घं मुहुः सञ्चिन्तयन्निव\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2144964, "chapter_id": 4121, "verse_number": "११", "content_sanskrit": "तत्रानिमित्ततो दैवात् सूतं कश्मलमाविशत् ।\nतदाऽऽचचक्षे विदुरः सभायां राजसंसदि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2144965, "chapter_id": 4121, "verse_number": "१२", "content_sanskrit": "सञ्जयोऽयं महाराज मूर्च्छितः पतितो भुवि ।\nवाचं न सृजते काञ्चिद्धीनप्रज्ञो विचेतनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2144966, "chapter_id": 4121, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2144967, "chapter_id": 4121, "verse_number": "१३", "content_sanskrit": "अपश्यत् सञ्जयो नूनं कुन्तीपुत्रान् महारथान् ।\nतैरस्य पुरुषव्याघ्रैर्भृशमुद्वेजितं मनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2144968, "chapter_id": 4121, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2144969, "chapter_id": 4121, "verse_number": "१४", "content_sanskrit": "सञ्जयश्चेतनां लब्ध्वा प्रत्याश्वस्येदमब्रवीत् ।\nधृतराष्ट्रं महाराज सभायां कुरुसंसदि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2144970, "chapter_id": 4121, "verse_number": "१५", "content_sanskrit": "दृष्टवानस्मि राजेन्द्र कुन्तीपुत्रान् महारथान् ।\nमत्स्यराजगृहावासनिरोधेनावकर्शितान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2144971, "chapter_id": 4121, "verse_number": "१६", "content_sanskrit": "शृणु यैर्हि महाराज पाण्डवा अभ्ययुञ्जत ।\nयश्च तान् पाण्डवान् सर्वान् सङ्गतान् वारणावते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2144972, "chapter_id": 4121, "verse_number": "१७", "content_sanskrit": "दाहतो मोचयामास कुन्तीपुत्रो वृकोदरः ।\nतेन वो भीमसेनेन पाण्डवा अभ्ययुञ्जत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2144973, "chapter_id": 4121, "verse_number": "१८", "content_sanskrit": "धृष्टद्युम्नेन वीरेण युद्धे वस्तेऽभ्ययुञ्जत\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2144974, "chapter_id": 4121, "verse_number": "१९", "content_sanskrit": "यो वै(न) रोषान्न भयान्न लोभान्नार्थकारणात् ।\nन हेतुवादाद् धर्मात्मा सत्यं जह्यात् कदाचन\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2144975, "chapter_id": 4121, "verse_number": "२०", "content_sanskrit": "यः प्रमाणं महाराज धर्मे धर्मभृतां वरः ।\nअजातशत्रुणा तेन पाण्डवा अभ्ययुञ्जत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2144976, "chapter_id": 4121, "verse_number": "२१", "content_sanskrit": "यस्य बाहुबले वीरः पृथिव्यां नास्ति कश्चन ।\nयो वै सर्वान् महीपालान् वशे चक्रे धनुर्धरः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2144977, "chapter_id": 4121, "verse_number": "२२", "content_sanskrit": "यः काशीनङ्गमगधान् कळिङ्गांश्च युधाऽजयत् ।\nतेन वै भीमसेनेन पाण्डवा अभ्ययुञ्जत\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2144978, "chapter_id": 4121, "verse_number": "२३", "content_sanskrit": "यस्य वीर्येण सहसा चत्वारो युधि मानवाः ।\nनिःसृता जतुगेहाद्वै हिडिम्बात् पुरुषादकात्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2144979, "chapter_id": 4121, "verse_number": "२४", "content_sanskrit": "यश्चैषामभवद् द्वीपः कुन्तीपुत्रो वृकोदरः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2144980, "chapter_id": 4121, "verse_number": "२५", "content_sanskrit": "याज्ञसेनीमथो यत्र सिन्धुराजोऽपकृष्टवान् ।\nतत्रैषामभवद् द्वीपः कुन्तीपुत्रो वृकोदरः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2144981, "chapter_id": 4121, "verse_number": "२६", "content_sanskrit": "यश्च तान् सङ्गतान् सर्वान् पाण्डवान् वारणावते ।\nदह्यतो मोचयामास कुन्तीपुत्रो वृकोदरः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2144982, "chapter_id": 4121, "verse_number": "२७", "content_sanskrit": "तेन वो भीमसेनेन पाण्डवा अभ्ययुञ्जत\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2144983, "chapter_id": 4121, "verse_number": "२८", "content_sanskrit": "कृष्णायाश्चरता प्रीतिं येन क्रोधवशा हताः ।\nप्रविश्य विषमं घोरं पर्वतं गन्धमादनम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2144984, "chapter_id": 4121, "verse_number": "२९", "content_sanskrit": "यस्य नागायुतैर्वीर्यं भुजयोः सारमर्पितम् ।\nतेन वो भीमसेनेन पाण्डवा अभ्ययुञ्जत\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2144985, "chapter_id": 4121, "verse_number": "३०", "content_sanskrit": "कृष्णद्वितीयो विक्रम्य तुष्ट्यर्थं जातवेदसः ।\nअजयद् यः पुरा वीरो युध्यमानं पुरन्दरम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2144986, "chapter_id": 4121, "verse_number": "३१", "content_sanskrit": "यः स साक्षान्महादेवं गिरिशं शूलपाणिनम् ।\nतोषयामास युद्धेन देवदेवमुमापतिम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2144987, "chapter_id": 4121, "verse_number": "३२", "content_sanskrit": "यश्च सर्वान् वशे चक्रे लोकपालान् धनुर्धरः ।\nतेन वो विजयेनाजौ पाण्डवा अभ्ययुञ्जत\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2144988, "chapter_id": 4121, "verse_number": "३३", "content_sanskrit": "यः प्रतीचीं दिशं चक्रे वशे म्लेच्छगणायुताम् ।\nस तत्र नकुलो योद्धा चित्रयोधी व्यवस्थितः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2144989, "chapter_id": 4121, "verse_number": "३४", "content_sanskrit": "तेन वो दर्शनीयेन वीरेणातिधनुर्भृता ।\nमाद्रीपुत्रेण कौरव्य पाण्डवा अभ्ययुञ्जत\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2144990, "chapter_id": 4121, "verse_number": "३५", "content_sanskrit": "यः काशीनङ्गमगधान् कळिङ्गांश्च युधाऽजयत् ।\nतेन वः सहदेवेन पाण्डवा अभ्ययुञ्जत\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2144991, "chapter_id": 4121, "verse_number": "३६", "content_sanskrit": "यस्य वीर्येण सदृशाः चत्वारो युधि मानवाः ।\nअश्वत्थामा धृष्टकेतू रुग्मी प्रद्युम्न एव च\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2144992, "chapter_id": 4121, "verse_number": "३७", "content_sanskrit": "तेन वः सहदेवेन पाण्डवा अभ्ययुञ्जत\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2144993, "chapter_id": 4121, "verse_number": "३८", "content_sanskrit": "यवीयसा नृवीरेण माद्रीनन्दकरेण च\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2144994, "chapter_id": 4121, "verse_number": "३९", "content_sanskrit": "तपश्चचार या घोरं काशिकन्या पुरा सती ।\nभीष्मस्य वधमिच्छन्ती प्रेत्यापि भरतर्षभ\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2144995, "chapter_id": 4121, "verse_number": "४०", "content_sanskrit": "पाञ्चालस्य सुता जज्ञे दैवाच्च स पुनः पुमान् ।\nस्त्रीपुंसोः पुरुषव्याघ्र यः स वेद गुणागुणान्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2144996, "chapter_id": 4121, "verse_number": "४१", "content_sanskrit": "यः कळिङ्गान् समापेदे पाञ्चाल्यो युद्धदुर्मदः ।\nशिखण्डिना वः कुरवः कृतास्त्रेणाभ्ययुञ्जत\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2144997, "chapter_id": 4121, "verse_number": "४२", "content_sanskrit": "यं यक्षः पुरुषं चक्रे भीष्मस्य निधनेच्छया ।\nमहेष्वासेन रौद्रेण पाण्डवा अभ्ययुञ्जत\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2144998, "chapter_id": 4121, "verse_number": "४३", "content_sanskrit": "महेष्वासा राजपुत्रा भ्रातरः पञ्च केकयाः ।\nआमुक्तकवचाः शूराः तैश्च वस्तेऽभ्ययुञ्जत\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2144999, "chapter_id": 4121, "verse_number": "४४", "content_sanskrit": "यो दीर्घबाहुः क्षिप्रास्त्रो धृतिमान् सत्यविक्रमः ।\nतेन वो वृष्णिवीरेण युयुधानेन सङ्गरः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2145000, "chapter_id": 4121, "verse_number": "४५", "content_sanskrit": "य आसीच्छरणं काले पाण्डवानां महात्मनाम् ।\nरणे तेन विराटेन पाण्डवा अभ्ययुञ्जत\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2145001, "chapter_id": 4121, "verse_number": "४६", "content_sanskrit": "यस्तु काशिपती राजा वाराणस्यां महाबलः ।\nस तेषामभवद् योद्धा तेन वस्तेऽभ्ययुञ्जत\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2145002, "chapter_id": 4121, "verse_number": "४७", "content_sanskrit": "शिशुभिर्दुर्जयैः सङ्खे द्रौपदेयैर्महात्मभिः ।\nआशीविषसमस्पर्शैः पाण्डवा अभ्ययुञ्जत\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2145003, "chapter_id": 4121, "verse_number": "४८", "content_sanskrit": "यः कृष्णसदृशो वीर्ये युधिष्ठिरसमो दमे ।\nतेनाभिमन्युना सङ्खे पाण्डवा अभ्ययुञ्जत\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2145004, "chapter_id": 4121, "verse_number": "४९", "content_sanskrit": "यश्चैवाप्रतिमो वीर्ये धृष्टकेतुर्महायशाः ।\nदुःसहः समरे क्रुद्धः शैशुपालिर्महारथः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2145005, "chapter_id": 4121, "verse_number": "५०", "content_sanskrit": "तेन वश्चेदिराजेन पाण्डवा अभ्ययुञ्जत\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2145006, "chapter_id": 4121, "verse_number": "५१", "content_sanskrit": "अक्षोहिण्या परिवृतः पाण्डवान् योऽभिसंवृतः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2145007, "chapter_id": 4121, "verse_number": "५२", "content_sanskrit": "यः संश्रयः पाण्डवानां देवानामिव वासवः ।\nतेन वो वासुदेवेन पाण्डवा अभ्ययुञ्जत\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2145008, "chapter_id": 4121, "verse_number": "५३", "content_sanskrit": "तथा चेदिपतेर्भ्राता शरभो भरतर्षभ ।\nशरवर्षेण सहितः ताभ्यां वस्तेऽभ्ययुञ्जत\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2145009, "chapter_id": 4121, "verse_number": "५४", "content_sanskrit": "जारासन्धिः सहदेवो जयत्सेनश्च तावुभौ ।\nयुद्धेऽप्रतिरथौ वीरौ पाण्डवार्थे व्यवस्थितौ\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2145010, "chapter_id": 4121, "verse_number": "५५", "content_sanskrit": "द्रुपदश्च महातेजा बलेन महता वृतः ।\nत्यक्तात्मा पाण्डवार्थाय योत्स्यमानो व्यवस्थितः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2145011, "chapter_id": 4121, "verse_number": "५६", "content_sanskrit": "एते चान्ये च बहवः प्राच्योदीच्या महीक्षितः ।\nशतशो यानुपाश्रित्य धर्मराजो व्यवस्थितः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2145012, "chapter_id": 4121, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि द्विपञ्चाशोऽध्यायः ॥५२॥\nव्यासाभिगमनपर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]