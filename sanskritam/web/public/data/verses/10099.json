[{"id": 6000099000, "chapter_id": 10099, "verse_number": null, "content_sanskrit": "अथ चतुर्थाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000099001, "chapter_id": 10099, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_004/BhP_05.004.001.m4a", "display_order": 2}, {"id": 6000099002, "chapter_id": 10099, "verse_number": "५-४-१", "content_sanskrit": "अथ तमुत्पत्त्यैवाभिव्यज्यमानभगवल्लक्षणं साम्योपशमवैराग्यैश्वर्यमहाविभूतिभिरनुदिनमेध-मानानुभावं प्रकृतयः प्रजा ब्राह्मणा देवताश्चावनितलसमवनायातितरां जगृधुः॥ ५/४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_004/BhP_05.004.002.m4a", "display_order": 3, "topics": [{"text": "ऋषभचरित्रम्", "range": "१–३"}]}, {"id": 6000099003, "chapter_id": 10099, "verse_number": "५-४-२", "content_sanskrit": "तस्य ह वा इत्थं वर्ष्मणा वरीयसा बृहच्छ्लोकेन ओजसा बलेन श्रिया यशसा वीर्यशौर्याभ्यां च पिता ऋषभ इतीदृकङ् नाम चकार॥ ५/४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_004/BhP_05.004.003.m4a", "display_order": 4}, {"id": 6000099004, "chapter_id": 10099, "verse_number": "५-४-३", "content_sanskrit": "यस्य हीन्द्रः स्पर्धमानो भगवान् वर्षे न ववर्ष, तदवधार्य भगवान् ऋषभदेवो योगेश्वरः प्रहस्यात्मयोगमायया स्ववर्षमाञ्जनाभं नामाभ्यवर्षीत्॥ ५/४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_004/BhP_05.004.004.m4a", "display_order": 5}, {"id": 6000099005, "chapter_id": 10099, "verse_number": "५-४-४", "content_sanskrit": "नाभिस्तु यथाऽभिलषितं सुप्रजास्त्वमवरुद्ध्य प्रमोदभरविह्वलो गद्गदाक्षरया गिरा स्वैरं गृहीतनरलोकधर्मं भगवन्तं पुराणपुरुषं मायाविलसितमतिर्वत्स तातेति सानुरागमुपलालयन्परां निर्वृतिमुपगतो विदितानुरागः पौरप्रकृतिजनपदानां राजा नाभिरात्मजं समयसेतुरक्षायामभिषिच्य ब्राह्मणेषूपनिधाय सह मेरुदेव्या विशालायां प्रसन्ननिपुणेन तपसा समाधियोगेन नरनारायणाख्यं भगवन्तं वासुदेवमुपासीनः कालेन तन्महिमानमवाप॥ ५/४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_004/BhP_05.004.005.m4a", "display_order": 6}, {"id": 6000099006, "chapter_id": 10099, "verse_number": null, "content_sanskrit": "यत्र ह पाण्डवेय श्लोकावुदाहरन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_004/BhP_05.004.006.m4a", "display_order": 7}, {"id": 6000099007, "chapter_id": 10099, "verse_number": "५-४-५", "content_sanskrit": "कोऽनु तत्कर्म राजर्षेर्नाभेरन्वाचरेत्पुमान्।\nअपत्यतामगाद्यस्य हरिः शुद्धेन कर्मणा॥ ५/४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_004/BhP_05.004.007.m4a", "display_order": 8}, {"id": 6000099008, "chapter_id": 10099, "verse_number": "५-४-६", "content_sanskrit": "ब्रह्मण्योऽन्यः कुतो नाभेर्विप्रा मङ्गलपूजिताः।\nयस्य बर्हिषि यज्ञेशं दर्शयामासुरोजसा॥ ५/४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_004/BhP_05.004.008.m4a", "display_order": 9}, {"id": 6000099009, "chapter_id": 10099, "verse_number": "५-४-७", "content_sanskrit": "अथ स भगवान् ऋषभः स्ववर्षं कर्मक्षेत्रमनुमन्यमानः प्रदर्शितगुरुकुलवास उपलब्धवरैर्गुरुभिरनुज्ञातो गृहमेधिनां धर्माननुशिक्षमाणो जयन्त्यामिन्द्रदत्तायामुभयलक्षणं धर्मं समाम्नायाम्नातमभियुञ्जन्नात्मजानामात्मसमानानां शतं जनयामास॥ ५/४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_004/BhP_05.004.009.m4a", "display_order": 10}, {"id": 6000099010, "chapter_id": 10099, "verse_number": "५-४-८", "content_sanskrit": "येषां खलु स महायोगी भरतो ज्येष्ठः श्रेष्ठगुण आसीद् येनेदं वर्षं भारतमिति व्यपदिशन्ति॥ ५/४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_004/BhP_05.004.010.m4a", "display_order": 11, "topics": [{"text": "तस्य जयन्तीनाम्न्यां भार्यायां भरतादिपुत्रशतोत्पत्तिः", "range": "८–१८"}]}, {"id": 6000099011, "chapter_id": 10099, "verse_number": "५-४-९", "content_sanskrit": "तमनु कुशावर्त इलावर्तो ब्रह्मावर्त आर्यावर्तो मलयकेतुर्भद्रसेन इन्द्रस्पृक् विदर्भः कीकट इति नव नवतिप्रधानाः॥ ५/४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_004/BhP_05.004.011.m4a", "display_order": 12}, {"id": 6000099012, "chapter_id": 10099, "verse_number": null, "content_sanskrit": "‘कविर्हरिरन्तरिक्षः प्रबुद्धः पिप्पलायनः।\nआविर्होत्रोऽथ द्रुमिलश्चमसः करभाजनः॥ ५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_004/BhP_05.004.012.m4a", "display_order": 13}, {"id": 6000099013, "chapter_id": 10099, "verse_number": "५-४-१०", "content_sanskrit": "’ इति भागवतधर्मदर्शना नव महाभागवतास्तेषां सुचरितं भगवन्महिमोपबृंहितं वसुदेवनारदसंवादरूपं उपशमायमानमुपरिष्टाद् वर्णयिष्यामः॥ ५/४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_004/BhP_05.004.013.m4a", "display_order": 14}, {"id": 6000099014, "chapter_id": 10099, "verse_number": "५-४-११", "content_sanskrit": "यवीयांस एकाशीतिर्जायन्तेयाः पितुरादेशकरा महाशालीना महाश्रोत्रिया यज्ञशीलाः कर्मश्रद्धा ब्राह्मणा बभूवुः॥ ५/४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_004/BhP_05.004.014.m4a", "display_order": 15}, {"id": 6000099015, "chapter_id": 10099, "verse_number": "५-४-१२", "content_sanskrit": "भगवानृषभसंज्ञ आत्मतन्त्रः स्वयं नित्यनिवृत्तानर्थपरम्परः केवलानन्दानुभव ईश्वर एवं विपरीतवत्कर्माण्यारभमाणः कालेनानुगतं धर्ममाचारेणोपशिक्षयन् अतद्विद्वांसमुपशान्तो मैत्रः कारुणिको धर्मार्थयशःप्रजानन्दामृताविरोधेन गृहेषु लोकान्नियमयत्॥ ५/४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_004/BhP_05.004.015.m4a", "display_order": 16}, {"id": 6000099016, "chapter_id": 10099, "verse_number": "५-४-१३", "content_sanskrit": "यच्छीर्षण्याचरितं तदनुवर्तते लोकः॥ ५/४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_004/BhP_05.004.016.m4a", "display_order": 17}, {"id": 6000099017, "chapter_id": 10099, "verse_number": "५-४-१४", "content_sanskrit": "यदपि स्वविदितं सकलं धर्मं ब्राह्मं गुह्यं ब्राह्मणैर्दर्शितमार्गेण सामादिभिरुपायैर्जनतामह अनुशशास॥ ५/४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_004/BhP_05.004.017.m4a", "display_order": 18}, {"id": 6000099018, "chapter_id": 10099, "verse_number": "५-४-१५", "content_sanskrit": "द्रव्यदेशकालवयःश्रद्धर्त्विग्विविधोद्देशोपचितैः सर्वैरपि क्रतुभिर्यथोपदेशं शतकृत्व इयाज॥ ५/४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_004/BhP_05.004.018.m4a", "display_order": 19}, {"id": 6000099019, "chapter_id": 10099, "verse_number": "५-४-१६", "content_sanskrit": "भगवता ऋषभेण परिरक्षमाण एतस्मिन्वर्षे न कश्चन पुरुषो वाञ्छत्यविद्यमानमिवात्मनोऽन्यस्मात् कथञ्चन किमपि कर्हिचिदपेक्षते भर्तर्यनुसवनविजृम्भितस्नेहातिशयमन्तरेण॥ ५/४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_004/BhP_05.004.019.m4a", "display_order": 20}, {"id": 6000099020, "chapter_id": 10099, "verse_number": "५-४-१७", "content_sanskrit": "स कदाचिदटमानो भगवानृषभो ब्रह्मावर्तं गतो ब्रह्मर्षिप्रवरसभायां प्रजानां निशामयन्तीनाम् आत्मजान् अवहितात्मनः प्रश्रयप्रणयभरं सुयन्त्रितानप्युपशिक्षयन्निति होवाच॥ ५/४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_004/BhP_05.004.020.m4a", "display_order": 21}, {"id": 6000099021, "chapter_id": 10099, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां पञ्चमस्कन्धे चतुर्थाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]