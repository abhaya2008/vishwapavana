[{"id": 7001714000, "chapter_id": 21714, "verse_number": "१-१००-१", "content_sanskrit": "श्रीब्रह्मोवाच ।\nअथ ते संप्रवक्ष्यामि पुराणं सर्वसिद्धिदम् ।\nभविष्यं भवतः सर्वलोकाभीष्टप्रदायकम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001714001, "chapter_id": 21714, "verse_number": "१-१००-२", "content_sanskrit": "यत्राहं सर्वदेवानामादिकर्ता समुद्गतः ।\nसृष्ट्यर्थं तत्र संजातो मनुः स्वार्थभुवः पुरा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001714002, "chapter_id": 21714, "verse_number": "१-१००-३", "content_sanskrit": "स मां प्रणम्य पप्रच्छ धर्मं सर्वाथसाधकम् ।\nअहं तस्मै तदा प्रीतः प्रावोचं धर्मसंहिताम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001714003, "chapter_id": 21714, "verse_number": "१-१००-४", "content_sanskrit": "पुराणानां यदा व्यासो व्यासं चक्रे महामतिः ।\nतदा तां संहितां सर्वां पंचधा व्यभजन्मुनिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001714004, "chapter_id": 21714, "verse_number": "१-१००-५", "content_sanskrit": "अधोरकल्पवृत्तांतं नानाश्चर्यकथान्वितम् ।\nतत्रादिमं स्मृतं पर्वं ब्राह्मं यत्रास्त्युपक्रमः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001714005, "chapter_id": 21714, "verse_number": "१-१००-६", "content_sanskrit": "सूतशौनकसंवादे पुराणप्रश्नसंक्रमः ।\nआदित्यचरितप्रायः सर्वाख्यानसमन्वितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001714006, "chapter_id": 21714, "verse_number": "१-१००-७", "content_sanskrit": "सृष्ट्यादिलक्षणोपेतः शास्त्रसर्वस्वरूपकः ।\nपुस्तलेखकलेखानां लक्षणं च ततः परम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001714007, "chapter_id": 21714, "verse_number": "१-१००-८", "content_sanskrit": "संस्काराणां च सर्वेषां लक्षणं चात्र कीर्तितम् ।\nपक्षस्यादितिथीनां च कल्पाः सप्त च कीर्तिताः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001714008, "chapter_id": 21714, "verse_number": "१-१००-९", "content_sanskrit": "अष्टम्याद्याः शेषकल्पा वैष्णवे पर्वणि स्मृताः ।\nशैवे च कायतो भिन्नाः सौरे चांत्यकथान्वयः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001714009, "chapter_id": 21714, "verse_number": "१-१००-१०", "content_sanskrit": "प्रतिसर्गाह्वयं पश्चान्नानाख्यानसमन्वितम् ।\nपुराणस्योपसंहारसहितं पर्व पंचमम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001714010, "chapter_id": 21714, "verse_number": "१-१००-११", "content_sanskrit": "एषु पंचसु पूर्वस्मिन् ब्रह्मणो महिमाधिकाः ।\nधर्मे कामे च मोक्षे तु विष्णोश्चापि शिवस्य च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001714011, "chapter_id": 21714, "verse_number": "१-१००-१२", "content_sanskrit": "द्वितीयं च तृतीये च सौरे वर्गचतुष्टये ।\nप्रतिसर्गाह्वयं त्वंत्यं प्रोक्तं सर्वकथान्वितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001714012, "chapter_id": 21714, "verse_number": "१-१००-१३", "content_sanskrit": "सभविष्यं विनिर्द्दिष्टं पर्व व्यासेन धीमता ।\nचतुर्द्दशसहस्रं तु पुराणं परिकीर्तितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001714013, "chapter_id": 21714, "verse_number": "१-१००-१४", "content_sanskrit": "भविष्यं सर्वदेवानां साम्यं यत्र प्रकीर्तितम् ।\nगुणानां तारतम्येन समं ब्रह्मेति हि श्रुतिः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001714014, "chapter_id": 21714, "verse_number": "१-१००-१५", "content_sanskrit": "तं लिखित्वा तु यो दद्यात्पौष्यां विद्वान्विमत्सरः ।\nगुडधेनुयुतं हेमवस्त्रमाल्यविभूषणैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001714015, "chapter_id": 21714, "verse_number": "१-१००-१६", "content_sanskrit": "वाचकं पुस्तकं चापि पूजयित्वा विधानतः ।\nगंधाद्यैर्भोज्यभक्ष्यैश्च कृत्वा नीराजनादिकम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001714016, "chapter_id": 21714, "verse_number": "१-१००-१७", "content_sanskrit": "यो वै जितेंद्रियो भूत्वा सोपवासः समाहितः ।\nअथ वैकहविष्याशी कीर्तयेच्छृणुयादपि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001714017, "chapter_id": 21714, "verse_number": "१-१००-१८", "content_sanskrit": "स मुक्तः पातकैर्घोरैः प्रयाति ब्रह्मणः पदम् ।\nयोऽप्यनुक्रमणीमेतां भविष्यस्य निरूपिताम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001714018, "chapter_id": 21714, "verse_number": "१-१००-१९", "content_sanskrit": "पठेद्वा श्रृणुयाच्चैतां भुक्तिं मुक्तिं च विंदति ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]