[{"id": 5000239000, "chapter_id": 9239, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे त्रिचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000239001, "chapter_id": 9239, "verse_number": "३-४३-१", "content_sanskrit": "सा तं सम्प्रेक्ष्य सुश्रोणी कुसुमानि विचिन्वती।\nहेमराजतवर्णाभ्यां पार्श्वाभ्यामुपशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000239002, "chapter_id": 9239, "verse_number": "३-४३-२", "content_sanskrit": "प्रहृष्टा चानवद्याङ्गी मृष्टहाटकवर्णिनी।\nभर्तारमपि चक्रन्द लक्ष्मणं चैव सायुधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000239003, "chapter_id": 9239, "verse_number": "३-४३-३", "content_sanskrit": "आहूयाहूय च पुनस्तं मृगं साधु वीक्षते।\nआगच्छागच्छ शीघ्रं वै आर्यपुत्र सहानुज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000239004, "chapter_id": 9239, "verse_number": "३-४३-४", "content_sanskrit": "तावाहूतौ नरव्याघ्रौ वैदेह्या रामलक्ष्मणौ।\nवीक्षमाणौ तु तं देशं तदा ददृशतुर्मृगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000239005, "chapter_id": 9239, "verse_number": "३-४३-५", "content_sanskrit": "शङ्कमानस्तु तं दृष्ट्वा लक्ष्मणो वाक्यमब्रवीत्।\nतमेवैनमहं मन्ये मारीचं राक्षसं मृगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000239006, "chapter_id": 9239, "verse_number": "३-४३-६", "content_sanskrit": "चरन्तो मृगयां हृष्टाः पापेनोपाधिना वने।\nअनेन निहता राम राजानः कामरूपिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000239007, "chapter_id": 9239, "verse_number": "३-४३-७", "content_sanskrit": "अस्य मायाविदो माया मृगरूपमिदं कृतम्।\nभानुमत् पुरुषव्याघ्र गन्धर्वपुरसंनिभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000239008, "chapter_id": 9239, "verse_number": "३-४३-८", "content_sanskrit": "मृगो ह्येवंविधो रत्नविचित्रो नास्ति राघव।\nजगत्यां जगतीनाथ मायैषा हि न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000239009, "chapter_id": 9239, "verse_number": "३-४३-९", "content_sanskrit": "एवं ब्रुवाणं काकुत्स्थं प्रतिवार्य शुचिस्मिता।\nउवाच सीता संहृष्टा छद्मना हृतचेतना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000239010, "chapter_id": 9239, "verse_number": "३-४३-१०", "content_sanskrit": "आर्यपुत्राभिरामोऽसौ मृगो हरति मे मनः।\nआनयैनं महाबाहो क्रीडार्थं नो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000239011, "chapter_id": 9239, "verse_number": "३-४३-११", "content_sanskrit": "इहाश्रमपदेऽस्माकं बहवः पुण्यदर्शनाः।\nमृगाश्चरन्ति सहिताश्चमराः सृमरास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000239012, "chapter_id": 9239, "verse_number": "३-४३-१२", "content_sanskrit": "ऋक्षाः पृषतसङ्घाश्च वानराः किन्नरास्तथा।\nविहरन्ति महाबाहो रूपश्रेष्ठा महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000239013, "chapter_id": 9239, "verse_number": "३-४३-१३", "content_sanskrit": "न चान्यः सदृशो राजन् दृष्टः पूर्वं मृगो मया।\nतेजसा क्षमया दीप्त्या यथायं मृगसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000239014, "chapter_id": 9239, "verse_number": "३-४३-१४", "content_sanskrit": "नानावर्णविचित्राङ्गो रत्नभूतो ममाग्रतः।\nद्योतयन् वनमव्यग्रं शोभते शशिसंनिभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000239015, "chapter_id": 9239, "verse_number": "३-४३-१५", "content_sanskrit": "अहो रूपमहो लक्ष्मीः स्वरसम्पच्च शोभना।\nमृगोऽद्भुतो विचित्राङ्गो हृदयं हरतीव मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000239016, "chapter_id": 9239, "verse_number": "३-४३-१६", "content_sanskrit": "यदि ग्रहणमभ्येति जीवन् नेव मृगस्तव।\nआश्चर्यभूतं भवति विस्मयं जनयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000239017, "chapter_id": 9239, "verse_number": "३-४३-१७", "content_sanskrit": "समाप्तवनवासानां राज्यस्थानां च नः पुनः।\nअन्तःपुरे विभूषार्थो मृग एष भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000239018, "chapter_id": 9239, "verse_number": "३-४३-१८", "content_sanskrit": "भरतस्यार्यपुत्रस्य श्वश्रूणां मम च प्रभो।\nमृगरूपमिदं दिव्यं विस्मयं जनयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000239019, "chapter_id": 9239, "verse_number": "३-४३-१९", "content_sanskrit": "जीवन्न यदि तेऽभ्येति ग्रहणं मृगसत्तमः।\nअजिनं नरशार्दूल रुचिरं तु भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000239020, "chapter_id": 9239, "verse_number": "३-४३-२०", "content_sanskrit": "निहतस्यास्य सत्त्वस्य जाम्बूनदमयत्वचि।\nशष्पबृस्यां विनीतायामिच्छाम्यहमुपासितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000239021, "chapter_id": 9239, "verse_number": "३-४३-२१", "content_sanskrit": "कामवृत्तमिदं रौद्रं स्त्रीणामसदृशं मतम्।\nवपुषा त्वस्य सत्त्वस्य विस्मयो जनितो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000239022, "chapter_id": 9239, "verse_number": "३-४३-२२", "content_sanskrit": "तेन काञ्चनरोम्णा तु मणिप्रवरशृङ्गिणा।\nतरुणादित्यवर्णेन नक्षत्रपथवर्चसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000239023, "chapter_id": 9239, "verse_number": "३-४३-२३", "content_sanskrit": "बभूव राघवस्यापि मनो विस्मयमागतम्।\nइति सीतावचः श्रुत्वा दृष्ट्वा च मृगमद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000239024, "chapter_id": 9239, "verse_number": "३-४३-२४", "content_sanskrit": "लोभितस्तेन रूपेण सीतया च प्रचोदितः।\nउवाच राघवो हृष्टो भ्रातरं लक्ष्मणं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000239025, "chapter_id": 9239, "verse_number": "३-४३-२५", "content_sanskrit": "पश्य लक्ष्मण वैदेह्याः स्पृहामुल्लसितामिमाम्।\nरूपश्रेष्ठतया ह्येष मृगोऽद्य न भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000239026, "chapter_id": 9239, "verse_number": "३-४३-२६", "content_sanskrit": "न वने नन्दनोद्देशे न चैत्ररथसंश्रये।\nकुतः पृथिव्यां सौमित्रे योऽस्य कश्चित् समो मृगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000239027, "chapter_id": 9239, "verse_number": "३-४३-२७", "content_sanskrit": "प्रतिलोमानुलोमाश्च रुचिरा रोमराजयः।\nशोभन्ते मृगमाश्रित्य चित्राः कनकबिन्दुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000239028, "chapter_id": 9239, "verse_number": "३-४३-२८", "content_sanskrit": "पश्यास्य जृम्भमाणस्य दीप्तामग्निशिखोपमाम्।\nजिह्वां मुखान्निःसरन्तीं मेघादिव शतह्रदाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000239029, "chapter_id": 9239, "verse_number": "३-४३-२९", "content_sanskrit": "मसारगल्वर्कमुखः शङ्खमुक्तानिभोदरः।\nकस्य नामानिरूप्योऽसौ न मनो लोभयेन्मृगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000239030, "chapter_id": 9239, "verse_number": "३-४३-३०", "content_sanskrit": "कस्य रूपमिदं दृष्ट्वा जाम्बूनदमयप्रभम्।\nनानारत्नमयं दिव्यं न मनो विस्मयं व्रजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000239031, "chapter_id": 9239, "verse_number": "३-४३-३१", "content_sanskrit": "मांसहेतोरपि मृगान् विहारार्थं च धन्विनः।\nघ्नन्ति लक्ष्मण राजानो मृगयायां महावने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000239032, "chapter_id": 9239, "verse_number": "३-४३-३२", "content_sanskrit": "धनानि व्यवसायेन विचीयन्ते महावने।\nधातवो विविधाश्चापि मणिरत्नसुवर्णिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000239033, "chapter_id": 9239, "verse_number": "३-४३-३३", "content_sanskrit": "तत् सारमखिलं नॄणां धनं निचयवर्धनम्।\nमनसा चिन्तितं सर्वं यथा शुक्रस्य लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000239034, "chapter_id": 9239, "verse_number": "३-४३-३४", "content_sanskrit": "अर्थी येनार्थकृत्येन संव्रजत्यविचारयन्।\nतमर्थमर्थशास्त्रज्ञाः प्राहुरर्थ्याः सुलक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000239035, "chapter_id": 9239, "verse_number": "३-४३-३५", "content_sanskrit": "एतस्य मृगरत्नस्य परार्घ्ये काञ्चनत्वचि।\nउपवेक्ष्यति वैदेही मया सह सुमध्यमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000239036, "chapter_id": 9239, "verse_number": "३-४३-३६", "content_sanskrit": "न कादली न प्रियकी न प्रवेणी न चाविकी।\nभवेदेतस्य सदृशी स्पर्शेऽनेनेति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000239037, "chapter_id": 9239, "verse_number": "३-४३-३७", "content_sanskrit": "एष चैव मृगः श्रीमान् यश्च दिव्यो नभश्चरः।\nउभावेतौ मृगौ दिव्यौ तारामृगमहीमृगौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000239038, "chapter_id": 9239, "verse_number": "३-४३-३८", "content_sanskrit": "यदि वायं तथा यन्मां भवेद् वदसि लक्ष्मण।\nमायैषा राक्षसस्येति कर्तव्योऽस्य वधो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000239039, "chapter_id": 9239, "verse_number": "३-४३-३९", "content_sanskrit": "एतेन हि नृशंसेन मारीचेनाकृतात्मना।\nवने विचरता पूर्वं हिंसिता मुनिपुंगवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000239040, "chapter_id": 9239, "verse_number": "३-४३-४०", "content_sanskrit": "उत्थाय बहवोऽनेन मृगयायां जनाधिपाः।\nनिहताः परमेष्वासास्तस्माद् वध्यस्त्वयं मृगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000239041, "chapter_id": 9239, "verse_number": "३-४३-४१", "content_sanskrit": "पुरस्तादिह वातापिः परिभूय तपस्विनः।\nउदरस्थो द्विजान् हन्ति स्वगर्भोऽश्वतरीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000239042, "chapter_id": 9239, "verse_number": "३-४३-४२", "content_sanskrit": "स कदाचिच्चिराल्लोभादाससाद महामुनिम्।\nअगस्त्यं तेजसा युक्तं भक्ष्यस्तस्य बभूव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000239043, "chapter_id": 9239, "verse_number": "३-४३-४३", "content_sanskrit": "समुत्थाने च तद्‍रूपं कर्तुकामं समीक्ष्य तम्।\nउत्स्मयित्वा तु भगवान् वातापिमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000239044, "chapter_id": 9239, "verse_number": "३-४३-४४", "content_sanskrit": "त्वयाविगण्य वातापे परिभूताश्च तेजसा।\nजीवलोके द्विजश्रेष्ठास्तस्मादसि जरां गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000239045, "chapter_id": 9239, "verse_number": "३-४३-४५", "content_sanskrit": "तद् रक्षो न भवेदेव वातापिरिव लक्ष्मण।\nमद्विधं योऽतिमन्येत धर्मनित्यं जितेन्द्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000239046, "chapter_id": 9239, "verse_number": "३-४३-४६", "content_sanskrit": "भवेद्धतोऽयं वातापिरगस्त्येनेव मा गतः।\nइह त्वं भव संनद्धो यन्त्रितो रक्ष मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000239047, "chapter_id": 9239, "verse_number": "३-४३-४७", "content_sanskrit": "अस्यामायत्तमस्माकं यत् कृत्यं रघुनन्दन।\nअहमेनं वधिष्यामि ग्रहीष्याम्यथवा मृगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000239048, "chapter_id": 9239, "verse_number": "३-४३-४८", "content_sanskrit": "यावद् गच्छामि सौमित्रे मृगमानयितुं द्रुतम्।\nपश्य लक्ष्मण वैदेह्या मृगत्वचि गतां स्पृहाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000239049, "chapter_id": 9239, "verse_number": "३-४३-४९", "content_sanskrit": "त्वचा प्रधानया ह्येष मृगोऽद्य न भविष्यति।\nअप्रमत्तेन ते भाव्यमाश्रमस्थेन सीतया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000239050, "chapter_id": 9239, "verse_number": "३-४३-५०", "content_sanskrit": "यावत् पृषतमेकेन सायकेन निहन्म्यहम्।\nहत्वैतच्चर्म चादाय शीघ्रमेष्यामि लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000239051, "chapter_id": 9239, "verse_number": "३-४३-५१", "content_sanskrit": "प्रदक्षिणेनातिबलेन पक्षिणा\nजटायुषा बुद्धिमता च लक्ष्मण।\nभवाप्रमत्तः प्रतिगृह्य मैथिलीं\nप्रतिक्षणं सर्वत एव शङ्कितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000239052, "chapter_id": 9239, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे त्रिचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]