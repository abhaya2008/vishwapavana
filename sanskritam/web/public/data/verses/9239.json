[{"id": 40016027, "chapter_id": 9239, "verse_number": "1", "content_sanskrit": "तेषांसुतुमुलंशब्दंवानराणांतरस्विनाम् । नर्दतांराक्षसैस्सार्धंतदाशुश्रावरावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40016028, "chapter_id": 9239, "verse_number": "2", "content_sanskrit": "स्निग्धगम्भीरनिर्घोषंश्रुत्वासनिनदंभृशम् । सचिवानांततस्तेषांमध्येवचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40016029, "chapter_id": 9239, "verse_number": "3", "content_sanskrit": "यथाऽसौसम्प्रहृष्टानांवानराणांसमुत्थितः । बहूनांसुमहान्नादोमेघनामिवगर्जिताम् ॥ व्यक्तंसुमहतीप्रीतिरेतेषांनात्रसंशयः । तथाहिविपुलैर्नादैश्चुक्षुभेवरुणालयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40016030, "chapter_id": 9239, "verse_number": "4", "content_sanskrit": "यथाऽसौसम्प्रहृष्टानांवानराणांसमुत्थितः । बहूनांसुमहान्नादोमेघनामिवगर्जिताम् ॥ व्यक्तंसुमहतीप्रीतिरेतेषांनात्रसंशयः । तथाहिविपुलैर्नादैश्चुक्षुभेवरुणालयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40016031, "chapter_id": 9239, "verse_number": "5", "content_sanskrit": "तौतुबद्धौशरैस्तीक्ष्णैर्भ्रातरौरामलक्ष्मणौ । अयंचसुमहान्नादशङ्कांजनयतीवमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40016032, "chapter_id": 9239, "verse_number": "6", "content_sanskrit": "एतत्तुवचनंचोक्त्वामन्त्रिणोराक्षसेश्वरः । उवाचनैरृतांस्तत्रसमीपपरिवर्तिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40016033, "chapter_id": 9239, "verse_number": "7", "content_sanskrit": "ज्ञायतांतूर्णमेतेषांसर्वेषांचवनचारिणाम् । शोककालेसमुत्पन्नहर्षकारणमुत्थितम् ॥", "padaccheda": "", "a