[{"id": 2011264, "chapter_id": 1229, "verse_number": "१-२३०-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2011265, "chapter_id": 1229, "verse_number": "१-२३०-१", "content_sanskrit": "उत्सवे वृत्तमात्रे तु त्रैलोक्याकाङ्क्षिणावुभौ।\nमन्त्रयित्वा ततः सेनां तावज्ञापयतां तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2011266, "chapter_id": 1229, "verse_number": "१-२३०-२", "content_sanskrit": "सुहृद्भिरप्यनुज्ञातौ दैत्यैर्वृद्धैश्च मन्त्रिभिः।\nकृत्वा प्रास्थानिकं रात्रौ मघासु ययतुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2011267, "chapter_id": 1229, "verse_number": "१-२३०-३", "content_sanskrit": "गदापिट्टशधारिण्या शूलमुद्गरहस्तया।\nप्रस्थितौ सह वर्मिण्या महत्या दैत्यसेनया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2011268, "chapter_id": 1229, "verse_number": "१-२३०-४", "content_sanskrit": "मङ्गलैः स्तुतिभिश्चापि विजयप्रतिसंहितैः।\nचारणैः स्तूयमानौ तौ जग्मतुः परया मुदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2011269, "chapter_id": 1229, "verse_number": "१-२३०-५", "content_sanskrit": "तावन्तरिक्षमुत्प्लुत्य दैत्यौ कामगमावुभौ।\nदेवानामेव भवनं जग्मतुर्युद्दुर्मदौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2011270, "chapter_id": 1229, "verse_number": "१-२३०-६", "content_sanskrit": "तयोरागमनं ज्ञात्वा वरदानं च तत्प्रभोः।\nहित्वा त्रिविष्टपं जग्मुर्ब्रह्मलोकं ततः सुराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2011271, "chapter_id": 1229, "verse_number": "१-२३०-७", "content_sanskrit": "ताविन्द्रलोकं निर्जित्य यक्षरक्षोगणांस्तदा।\nखेचराण्यपि भूतानि जघ्नतुस्तीव्रविक्रमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2011272, "chapter_id": 1229, "verse_number": "१-२३०-८", "content_sanskrit": "अन्तर्भूमिगतान्नागाञ्जित्वा तौ च महारथौ।\nसमुद्रवासिनीः सर्वा म्लेच्छजातीर्विजिग्यतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2011273, "chapter_id": 1229, "verse_number": "१-२३०-९", "content_sanskrit": "ततः सर्वां महीं जेतुमारब्धावुग्रशासनौ।\nसैनिकांश्च समाहूय सुतीक्ष्णं वाक्यमूचतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2011274, "chapter_id": 1229, "verse_number": "१-२३०-१०", "content_sanskrit": "राजर्षयो महायज्ञैर्हव्यकव्यैर्द्विजातयः।\nतेजो बलं च देवानां वर्धन्ति श्रियं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2011275, "chapter_id": 1229, "verse_number": "१-२३०-११", "content_sanskrit": "तेषामेवं प्रवृत्तानां सर्वेषामसुरद्विषाम्।\nसंभूय सर्वैरस्माभिः कार्यः सर्वात्मना वधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2011276, "chapter_id": 1229, "verse_number": "१-२३०-१२", "content_sanskrit": "एवं सर्वान्समादिश्य पूर्वतीरे महोदधेः।\nक्रूरां मतिं समास्थाय जग्मतुः सर्वतोमुखौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2011277, "chapter_id": 1229, "verse_number": "१-२३०-१३", "content_sanskrit": "यज्ञैर्यजन्ति ये केचिद्याजयन्ति च ये द्विजाः।\nतान्सर्वान्प्रसभं हत्वा बलिनौ जग्मतुस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2011278, "chapter_id": 1229, "verse_number": "१-२३०-१४", "content_sanskrit": "आश्रमेष्वग्निहोत्राणि मुनीनां भावितात्मनाम्।\nगृहीत्वा प्रक्षिपन्त्यप्सु विश्रब्धं सैनिकास्तयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2011279, "chapter_id": 1229, "verse_number": "१-२३०-१५", "content_sanskrit": "तपोधनैश्च ये क्रुद्धैः शापा उक्ता महात्मभिः।\nनाक्रामन्त तयोस्तेऽपि वरदाननिराकृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2011280, "chapter_id": 1229, "verse_number": "१-२३०-१६", "content_sanskrit": "नाक्रामन्त यदा शापा बाणा मुक्ताः शिलास्विव।\nनियमान्संपरित्यज्य व्यद्रवन्त द्विजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2011281, "chapter_id": 1229, "verse_number": "१-२३०-१७", "content_sanskrit": "पृथिव्यां ये तपःसिद्धा दान्ताः शमपरायणाः।\nतयोर्भयाद्दुद्रुवुस्ते वैनतेयादिवोरगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2011282, "chapter_id": 1229, "verse_number": "१-२३०-१८", "content_sanskrit": "मथितैराश्रमैर्भग्नैर्विकीर्णकलशस्रुवैः।\nशून्यमासीज्जगत्सर्वं कालेनेव हतं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2011283, "chapter_id": 1229, "verse_number": "१-२३०-१९", "content_sanskrit": "ततो राजन्नदृश्यद्भिर्ऋषिभिश्च महासुरौ।\nउभौ विनिश्चयं कृत्वा विकुर्वाते वधैषिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2011284, "chapter_id": 1229, "verse_number": "१-२३०-२०", "content_sanskrit": "प्रभिन्नकरटौ मत्तौ भूत्वा कुञ्जररूपिणौ।\nसंलीनमपि दुर्गेषु निन्यतुर्यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2011285, "chapter_id": 1229, "verse_number": "१-२३०-२१", "content_sanskrit": "सिंहौ भूत्वा पुनर्व्याघ्रौ पुनश्चान्तर्हितावुभौ।\nतैस्तैरुपायैस्तौ क्रूरावृषीन्दृष्ट्वा निजघ्नतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2011286, "chapter_id": 1229, "verse_number": "१-२३०-२२", "content_sanskrit": "निवृत्तयज्ञस्वाध्याया प्रनष्टनृपतिद्विजा।\nउत्सन्नोत्सवयज्ञा च बभूव वसुधा तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2011287, "chapter_id": 1229, "verse_number": "१-२३०-२३", "content_sanskrit": "हाहाभूता भयार्ता च निवृत्तविपणापणा।\nनिवृत्तदेवकार्या च पुण्योद्वाहविवर्जिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2011288, "chapter_id": 1229, "verse_number": "१-२३०-२४", "content_sanskrit": "निवृत्तकृषिगोरक्षा विध्वस्तनगराश्रमा।\nअस्थिकङ्कालसंकीर्णा भूर्बभूवोग्रदर्शना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2011289, "chapter_id": 1229, "verse_number": "१-२३०-२५", "content_sanskrit": "निवृत्तपितृकार्यं च निर्वषट्कारमङ्गलम्।\nजगत्प्रतिभयाकारं दुष्प्रेक्ष्यमभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2011290, "chapter_id": 1229, "verse_number": "१-२३०-२६", "content_sanskrit": "चन्द्रादित्यौ ग्रहास्तारा नक्षत्राणि दिवौकसः।\nजग्मुर्विषादं तत्कर्म दृष्ट्वा सुन्दोपसुन्दयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2011291, "chapter_id": 1229, "verse_number": "१-२३०-२७", "content_sanskrit": "एवं सर्वा दिशो दैत्यौ जित्वा क्रूरेण कर्मणा।\nनिःसपत्नौ कुरुक्षेत्रे निवेशमभिचक्रतुः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2011292, "chapter_id": 1229, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि विदुरागमनराज्यलाभपर्वणि त्रिंशदधिकद्विशततमोऽध्यायः॥ २३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]