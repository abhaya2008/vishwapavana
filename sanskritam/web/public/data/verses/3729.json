[{"id": 2127231, "chapter_id": 3729, "verse_number": "", "content_sanskrit": "दमयन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2127232, "chapter_id": 3729, "verse_number": "१", "content_sanskrit": "न मामर्हसि कल्याण पापेन परिशङ्कितुम् ।\nमया हि देवानुत्सृज्य वृतस्त्वं निषधाधिप\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2127233, "chapter_id": 3729, "verse_number": "२", "content_sanskrit": "तवाभिगमनार्थाय सर्वतो ब्राह्मणा गताः ।\nवाक्यानि मम गाथाभिर्गायमाना दिशो दश\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2127234, "chapter_id": 3729, "verse_number": "३", "content_sanskrit": "ततस्त्वां ब्राह्मणो विद्वान् पर्णादो नाम पार्थिव ।\nअभ्यगच्छत् कोसलायामृतुपर्णनिवेशने\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2127235, "chapter_id": 3729, "verse_number": "४", "content_sanskrit": "तेन वाक्ये हृते सम्यक् प्रतिवाक्ये तु व्याहृते ।\nउपायोऽयं मया दृष्टो नैषधानयने तव \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2127236, "chapter_id": 3729, "verse_number": "५", "content_sanskrit": "त्वदृते न हि लोकेऽन्य एकाह्ना पृथिवीपते ।\nसमर्थो योजनशतं गन्तुमश्वैर्नराधिप\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2127237, "chapter_id": 3729, "verse_number": "६", "content_sanskrit": "स्पृशेयं तेन सत्येन पादावेतौ महीपते ।\nयथा नासत्कृतं किञ्चिन् मनसाऽपि चराम्यहम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2127238, "chapter_id": 3729, "verse_number": "७", "content_sanskrit": "अयं चरति लोकेऽस्मिन् भूतसाक्षी सदागतिः ।\nस विमुञ्चतु मे प्राणान् यदि पापं चराम्यहम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2127239, "chapter_id": 3729, "verse_number": "८", "content_sanskrit": "तथा चरति तिग्मांशुः करेण भुवनं सदा ।\nस विमुञ्चतु मे प्राणान् यदि पापं चराम्यहम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2127240, "chapter_id": 3729, "verse_number": "९", "content_sanskrit": "चन्द्रमाः सर्वभूतानामन्तश्चरति साक्षिवत् ।\nस विमुञ्चतु मे प्राणान् यदि पापं चराम्यहम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2127241, "chapter_id": 3729, "verse_number": "१०", "content_sanskrit": "एते देवास्त्रयः कृत्स्नं त्रैलोक्यं धारयन्ति वै ।\nविब्रुवन्तु यथा सत्यमेतद् देवास्त्यजन्तु\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2127242, "chapter_id": 3729, "verse_number": "", "content_sanskrit": "बृहदश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2127243, "chapter_id": 3729, "verse_number": "११", "content_sanskrit": "एवमुक्ते ततो वायुरन्तरिक्षादभाषत \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2127244, "chapter_id": 3729, "verse_number": "१२", "content_sanskrit": "नैषा कृतवती पापं नळ सत्यं ब्रवीमि ते ।\nराजन् शीलनिधिः स्फीतो दमयन्त्या सुरक्षितः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2127245, "chapter_id": 3729, "verse_number": "१३", "content_sanskrit": "साक्षिणो रक्षिणश्चास्या वयं त्रीन् परिवत्सरान् ।\nउपायो विहितश्चायं त्वदर्थमतुलोऽनया\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2127246, "chapter_id": 3729, "verse_number": "१४", "content_sanskrit": "न ह्येकाह्ना शतं गन्ता त्वदृतेऽन्यः पुमानिति ।\nउपपन्ना त्वया भैमी त्वं च भैम्या महीपते ।\nनात्र शङ्का त्वया कार्या सङ्गच्छ सह भार्यया\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2127247, "chapter_id": 3729, "verse_number": "१५", "content_sanskrit": "तथा ब्रुवति वायौ तु पुष्पवृष्टिः पपात ह ।\nदेवदुन्दुभयो नेदुर्ववौ च पवनः शुभः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2127248, "chapter_id": 3729, "verse_number": "१६", "content_sanskrit": "तदद्भुततमं दृष्ट्वा नळो राजाऽथ भारत ।\nदमयन्त्यां विशङ्कस्तां व्यपाकर्षदरिन्दमः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2127249, "chapter_id": 3729, "verse_number": "१७", "content_sanskrit": "ततस्तद्वस्त्रमरजः प्रावृणोद्वसुधाधिपः ।\nसंस्मृत्य नागराजानं ततो लेभे वपुःस्वकम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2127250, "chapter_id": 3729, "verse_number": "१८", "content_sanskrit": "स्वरूपेण तु भर्तारं दृष्ट्वा भीमसुता ततः ।\nप्राक्रोशदुच्चैरालिङ्ग्य पुण्यश्लोकमनिन्दिता\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2127251, "chapter_id": 3729, "verse_number": "१९", "content_sanskrit": "भैमीमपि नळो राजा भ्राजमानो यथा रविः ।\nसस्वजे स्वसुतौ चापि यथावत् प्रत्यनन्दत\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2127252, "chapter_id": 3729, "verse_number": "२०", "content_sanskrit": "ततः स्वोरसि विन्यस्य वक्त्रं तस्य शुभानना ।\nपरिश्रान्तेव दुःखेन निशश्वासायतेक्षणा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2127253, "chapter_id": 3729, "verse_number": "२१", "content_sanskrit": "तथैव मलदिग्धाङ्गी परिष्वज्य शुचिस्मिता ।\nसुचिरं पुरुषव्याघ्रं तस्थौ शोकपरिप्लुता \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2127254, "chapter_id": 3729, "verse_number": "२२", "content_sanskrit": "ततस्सर्वं यथावृत्तं दमयन्त्या नळस्य च ।\nभीमायाकथयत् प्रीत्या वैदर्भ्या जननी नृप \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2127255, "chapter_id": 3729, "verse_number": "२३", "content_sanskrit": "ततोऽब्रवीन्महाराजः कृतशौचमहं नळम् ।\nदमयन्त्या सहोपेतं काल्यं द्रष्टा सुखोषितम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2127256, "chapter_id": 3729, "verse_number": "२४", "content_sanskrit": "ततस्तौ सहितौ रात्रिं कथयन्तौ पुरातनम् ।\nवने विचरितं सर्वमूषतुर्मुदितौ नृप\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2127257, "chapter_id": 3729, "verse_number": "२५", "content_sanskrit": "स चतुर्थे ततो वर्षे सङ्गम्य सह भार्यया ।\nसर्वकामसमृद्धार्थो लब्धवान् परमां मुदम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2127258, "chapter_id": 3729, "verse_number": "२६", "content_sanskrit": "दमयन्त्यपि भर्तारमवाप्याप्यायिता भृशम् ।\nअर्धसञ्जातसस्येव तोयं प्राप्य वसुन्धरा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2127259, "chapter_id": 3729, "verse_number": "२७", "content_sanskrit": "सा तं समेत्य व्यपनीतनिद्रा\nशान्तज्वरा हर्षविवृद्धसत्त्वा ।\nरराज भैमी सुसमाप्तकामा\nशीतांशुना रात्रिरिवोदितेन\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2127260, "chapter_id": 3729, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि एकसप्ततितमोऽध्यायः ॥७१॥\n॥ तीर्थयात्रापर्वणि सप्तविंशोऽध्यायः ॥२७॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]