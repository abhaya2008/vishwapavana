[{"id": 6000327000, "chapter_id": 10327, "verse_number": null, "content_sanskrit": "अथ षड्विंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000327001, "chapter_id": 10327, "verse_number": "११-२६-१", "content_sanskrit": "मल्लक्षणमिमं कायं लब्ध्वा मद्धर्ममास्थितः।\nआनन्दं परमात्मानमात्मस्थं समुपैति माम्॥ ११/२६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.001.m4a", "display_order": 2, "topics": [{"text": "दुष्टसङ्गेन योगविघातः सत्सङ्गेन योगप्राप्तिरित्यत्र ऐलगीताकथनम्", "range": "१–३"}]}, {"id": 6000327002, "chapter_id": 10327, "verse_number": "११-२६-२", "content_sanskrit": "गुणमय्या जीवयोन्या विमुक्तो ज्ञाननिष्ठया। गुणेषु मायामात्रेषु दृश्यमानेष्ववस्तुतः।\nवर्तमानोऽपि न पुमान् युज्यतेऽवस्तुभिर्गुणैः॥ ११/२६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.002.m4a", "display_order": 3}, {"id": 6000327003, "chapter_id": 10327, "verse_number": "११-२६-३", "content_sanskrit": "सङ्गं न कुर्यादसतां शिश्नोदरतृपां क्‍वचित्।\nतस्यानुगस्तमस्यन्धे पतत्यन्धानुगोऽन्धवत्॥ ११/२६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.003.m4a", "display_order": 4}, {"id": 6000327004, "chapter_id": 10327, "verse_number": "११-२६-४", "content_sanskrit": "ऐलः सम्राडिमां गाथामगायत बृहच्छ्रवाः।\nउर्वशीविरहान्मुह्यन् निर्विण्णः शोकसंयुतः॥ ११/२६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.004.m4a", "display_order": 5, "topics": [{"text": "बहुकालमुर्वश्या रममाणस्य मध्ये तया रहितस्य पुरूरवसः स्वयमात्मनाऽऽत्मानं विनिन्द्य स्त्रीसङ्गः सर्वथा न कर्तव्य इति गाथागानम्", "range": "४–३५"}]}, {"id": 6000327005, "chapter_id": 10327, "verse_number": "११-२६-५", "content_sanskrit": "त्यक्त्वाऽऽत्मानं व्रजन्तीं तां नग्न उन्मत्तवन्नृपः।\nविलपन्नन्वगाज्जाये घोरे तिष्ठेति विक्लवः॥ ११/२६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.005.m4a", "display_order": 6}, {"id": 6000327006, "chapter_id": 10327, "verse_number": "११-२६-६", "content_sanskrit": "कामानतृप्तोऽनुजुषन् क्षुल्लकान् वर्षयामिनीः।\nन वेद गणनां यान्तीमुर्वश्याऽऽकृष्टचेतनः॥ ११/२६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.006.m4a", "display_order": 7}, {"id": 6000327007, "chapter_id": 10327, "verse_number": null, "content_sanskrit": "ऐल उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.007.m4a", "display_order": 8}, {"id": 6000327008, "chapter_id": 10327, "verse_number": "११-२६-७", "content_sanskrit": "अहो मे मोहविस्तारः कामकश्मलचेतसः।\nदेव्या गृहीतकण्ठस्य नायुःखण्डा अनुस्मृताः॥ ११/२६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.008.m4a", "display_order": 9}, {"id": 6000327009, "chapter_id": 10327, "verse_number": "११-२६-८", "content_sanskrit": "नाहं वेदाभिनिर्मुक्तः सूर्येणाभ्युदितो मृषा।\nमुषितो वर्षपूगानां बताहानि गतान्युत॥ ११/२६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.009.m4a", "display_order": 10}, {"id": 6000327010, "chapter_id": 10327, "verse_number": "११-२६-९", "content_sanskrit": "अहो मे आत्मसम्मोह येनात्मा योषिता हृतः।\nक्रीडामृगश्चक्रवर्ती नरदेवशिखामणिः॥ ११/२६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.010.m4a", "display_order": 11}, {"id": 6000327011, "chapter_id": 10327, "verse_number": "११-२६-१०", "content_sanskrit": "सपरिच्छदमात्मानं हित्वा तृणमिवेश्वरम्।\nयान्तीं स्त्रियं चान्वगमं नग्न उन्मत्तवद् रुदन्॥ ११/२६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.011.m4a", "display_order": 12}, {"id": 6000327012, "chapter_id": 10327, "verse_number": "११-२६-११", "content_sanskrit": "कुतस्तस्यानुभावः स्यात् तेज ईशित्वमेव वा।\nयोऽन्वगच्छं स्त्रियं यान्तीं स्मरबाणविताडितः॥ ११/२६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.012.m4a", "display_order": 13}, {"id": 6000327013, "chapter_id": 10327, "verse_number": "११-२६-१२", "content_sanskrit": "किं विद्यया किं तपसा किं त्यागेन श्रुतेन वा।\nकिं विविक्तेन मौनेन स्त्रीभिर्यस्य मनो हृतम्॥ ११/२६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.013.m4a", "display_order": 14}, {"id": 6000327014, "chapter_id": 10327, "verse_number": "११-२६-१३", "content_sanskrit": "स्वार्थस्याकोविदं धिङ् मां मूर्खं पण्डितमानिनम्।\nयोऽहमीश्वरतां प्राप्य स्त्रीभिर्गोखरवज्जितः॥ ११/२६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.014.m4a", "display_order": 15}, {"id": 6000327015, "chapter_id": 10327, "verse_number": "११-२६-१४", "content_sanskrit": "सेवतो वर्षपूगान्मे उर्वश्या अधरासवम्।\nन तृप्त आत्मभूः कामो वह्निराहुतिभिर्यथा॥ ११/२६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.015.m4a", "display_order": 16}, {"id": 6000327016, "chapter_id": 10327, "verse_number": "११-२६-१५", "content_sanskrit": "पुंश्चल्याऽपहृतं चित्तं को न्वन्यो मोचितुं प्रभुः।\nआत्मारामेश्वरमृते भगवन्तमधोक्षजम्॥ ११/२६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.016.m4a", "display_order": 17}, {"id": 6000327017, "chapter_id": 10327, "verse_number": "११-२६-१६", "content_sanskrit": "बोधितस्यापि देव्या मे सूक्तवाक्येन दुर्मतेः।\nमनोगतो महामोहो नापयात्यजितात्मनः॥ ११/२६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.017.m4a", "display_order": 18}, {"id": 6000327018, "chapter_id": 10327, "verse_number": "११-२६-१७", "content_sanskrit": "किं न्वेतया म एकान्ते रज्ज्वां वै सर्पचेतसः।\nद्रष्टुः स्वरूपाविदुषो योऽहं यदजितेन्द्रियः॥ ११/२६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.018.m4a", "display_order": 19}, {"id": 6000327019, "chapter_id": 10327, "verse_number": "११-२६-१८", "content_sanskrit": "क्‍वायं मलीमसः कायो दौर्गन्ध्याद्यात्मकोऽशुचिः।\nक्‍व गुणाः सौमनस्याद्या ह्यध्यासोऽविद्यया कृतः॥ ११/२६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.019.m4a", "display_order": 20}, {"id": 6000327020, "chapter_id": 10327, "verse_number": "११-२६-१९", "content_sanskrit": "पित्रोः किं स्विन्नु भार्यायाः स्वामिनोऽग्नेः श्वगृध्रयोः।\nकिमात्मनः किं सुहृदामिति यो नावसीयते॥ ११/२६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.020.m4a", "display_order": 21}, {"id": 6000327021, "chapter_id": 10327, "verse_number": "११-२६-२०", "content_sanskrit": "तस्मिन् कलेवरेऽमेध्ये तुच्छनिष्ठे विषज्जते।\nअहो सुभद्रं सुनसं सुस्मितं च मुखं स्त्रियः॥ ११/२६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.021.m4a", "display_order": 22}, {"id": 6000327022, "chapter_id": 10327, "verse_number": "११-२६-२१", "content_sanskrit": "त्वङ्मांसरुधिरस्नायुमेदोमज्जास्थिसंहतौ।\nविण्मूत्रपूये रमतां कृमीणां कियदन्तरम्॥ ११/२६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.022.m4a", "display_order": 23}, {"id": 6000327023, "chapter_id": 10327, "verse_number": "११-२६-२२", "content_sanskrit": "अथापि नो विषज्जेत स्त्रीषु स्त्रैणेषु चार्थवित्।\nविषयेन्द्रियसंयोगान्मनः क्षुभ्यति नान्यदा॥ ११/२६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.023.m4a", "display_order": 24}, {"id": 6000327024, "chapter_id": 10327, "verse_number": "११-२६-२३", "content_sanskrit": "अदृष्टादश्रुताद् भावान्न भाव उपजायते।\nअसंप्रयुञ्जतः प्राणान् शाम्यति स्तिमितं मनः॥ ११/२६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.024.m4a", "display_order": 25}, {"id": 6000327025, "chapter_id": 10327, "verse_number": "११-२६-२४", "content_sanskrit": "तस्माद् सङ्गो न कर्तव्यः स्त्रीषु स्त्रैणेषु चेन्द्रियैः।\nविदुषां चाप्यविश्रभ्यः षड्वर्गः किमु मादृशाम्॥ ११/२६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.025.m4a", "display_order": 26}, {"id": 6000327026, "chapter_id": 10327, "verse_number": null, "content_sanskrit": "श्री भगवानुवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.026.m4a", "display_order": 27}, {"id": 6000327027, "chapter_id": 10327, "verse_number": "११-२६-२५", "content_sanskrit": "एवं प्रगायन् नृपदेवदेवः स उर्वशीलोकमथो विहाय।\nआत्मानमात्मन्यवगम्य मां वै उपारमज्ज्ञानविधूतमोहः॥ ११/२६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.027.m4a", "display_order": 28}, {"id": 6000327028, "chapter_id": 10327, "verse_number": "११-२६-२६", "content_sanskrit": "ततो दुःसङ्गमुत्सृज्य सत्सु सज्जेत बुद्धिमान्।\nसन्त एवास्य छिन्दन्ति मनोव्यासङ्गमुक्तिभिः॥ ११/२६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.028.m4a", "display_order": 29}, {"id": 6000327029, "chapter_id": 10327, "verse_number": "११-२६-२७", "content_sanskrit": "सन्तोऽनपेक्षा मच्चित्ताः प्रशान्ताः समदर्शनाः।\nनिर्ममा निरहङ्कारा निर्द्वन्द्वा निष्परिग्रहाः॥ ११/२६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.029.m4a", "display_order": 30}, {"id": 6000327030, "chapter_id": 10327, "verse_number": "११-२६-२८", "content_sanskrit": "तेषु नित्यं महाभाग महाभागेषु मत्कथाः।\nसम्भवन्ति हिता नॄणां जुषतां प्रपुनन्त्यघम्॥ ११/२६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.030.m4a", "display_order": 31}, {"id": 6000327031, "chapter_id": 10327, "verse_number": "११-२६-२९", "content_sanskrit": "ता ये शृण्वन्ति गायन्ति ह्यनुमोदन्ति चादृताः।\nमत्पराः श्रद्धधानाश्च भक्तिं विन्दन्ति ते मयि॥ ११/२६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.031.m4a", "display_order": 32}, {"id": 6000327032, "chapter_id": 10327, "verse_number": "११-२६-३०", "content_sanskrit": "भक्तिं लब्धवतः साधो किमन्यदवशिष्यते।\nमय्यनन्तगुणे ब्रह्मण्यानन्दानुभवात्मनि॥ ११/२६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.032.m4a", "display_order": 33}, {"id": 6000327033, "chapter_id": 10327, "verse_number": "११-२६-३१", "content_sanskrit": "यथोपाश्रयमाणस्य भगवन्तं विभावसुम्।\nशीतं भयं तमो व्येति साधुं संसेवतस्तथा॥ ११/२६/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.033.m4a", "display_order": 34}, {"id": 6000327034, "chapter_id": 10327, "verse_number": "११-२६-३२", "content_sanskrit": "निमज्योन्मज्जतां घोरे भवाब्धौ ते परायणम्।\nसन्तो ब्रह्मविदः शान्ता नौर्दृढेवाप्सु मज्जताम्॥ ११/२६/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.034.m4a", "display_order": 35}, {"id": 6000327035, "chapter_id": 10327, "verse_number": "११-२६-३३", "content_sanskrit": "अन्नं हि प्राणिनां प्राण आर्तानां शरणं त्वहम्।\nधर्मो वित्तं नृणां प्रेत्य सन्तोऽतो बिभ्यतोऽरणम्॥ ११/२६/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.035.m4a", "display_order": 36}, {"id": 6000327036, "chapter_id": 10327, "verse_number": "११-२६-३४", "content_sanskrit": "सन्तो दिशन्ति चक्षूंषि बहिरर्कः समुत्थितः।\nदेवता बान्धवाः सन्तः पिता माताऽहमेव च॥ ११/२६/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.036.m4a", "display_order": 37}, {"id": 6000327037, "chapter_id": 10327, "verse_number": "११-२६-३५", "content_sanskrit": "चेतसेलासुतोऽप्येवमुर्वश्या लोकनिःस्पृहः।\nमुक्तसङ्गो महीमेतामात्मारामश्चचार ह॥ ११/२६/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_026/BhP_11.026.037.m4a", "display_order": 38}, {"id": 6000327038, "chapter_id": 10327, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे षड्विंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]