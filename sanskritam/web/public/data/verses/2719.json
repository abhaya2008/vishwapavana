[{"id": 2080832, "chapter_id": 2719, "verse_number": "१२-२२४-०x", "content_sanskrit": "`युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2080833, "chapter_id": 2719, "verse_number": "१२-२२४-१", "content_sanskrit": "अस्ति कश्चिद्यदि विभो सदारो नियतो गृहे।\nअतीतसर्वसंसारः सर्वद्वन्द्वविवर्जितः।\nतं मे ब्रूहि महाप्राज्ञ दुर्लभः पुरुषो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2080834, "chapter_id": 2719, "verse_number": "१२-२२४-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2080835, "chapter_id": 2719, "verse_number": "१२-२२४-२", "content_sanskrit": "शृणु राजन्यथावृत्तं यन्मां त्वं पृष्टवानसि।\nइतिहासमिमं शुद्धं संसारभयभेषजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2080836, "chapter_id": 2719, "verse_number": "१२-२२४-३", "content_sanskrit": "देवलो नाम विप्रर्षिः सर्वशास्त्रार्थकोविदः।\nक्रियावान्धार्मिको नित्यं देवब्राह्मणपूजकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2080837, "chapter_id": 2719, "verse_number": "१२-२२४-४", "content_sanskrit": "सुता सुवर्चला नाम तस्य कल्याणलक्षणा।\nनातिह्रस्वा नातिकृशा नातिदीर्घा यशस्विनी।\nप्रदानसमयं प्राप्ता पिता तस्य ह्यचिन्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2080838, "chapter_id": 2719, "verse_number": "१२-२२४-५", "content_sanskrit": "अस्याः पतिः कुतो वेति ब्राह्मणः श्रोत्रियः परः।\nविद्वान्विप्रो ह्यकुटुम्बः प्रियवादी महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2080839, "chapter_id": 2719, "verse_number": "१२-२२४-६", "content_sanskrit": "इत्येवं चिन्तयानं तं रहस्याह सुवर्चला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2080840, "chapter_id": 2719, "verse_number": "१२-२२४-७", "content_sanskrit": "अन्धाय मां महाप्राज्ञ देह्यनन्धाय वै पितः।\nएवं स्मर सदा विद्वन्ममेदं प्रार्थितं मुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2080841, "chapter_id": 2719, "verse_number": "१२-२२४-८x", "content_sanskrit": "पितोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2080842, "chapter_id": 2719, "verse_number": "१२-२२४-८", "content_sanskrit": "न शक्यं प्रार्थितं वत्से त्वयाऽद्य प्रतिभाति मे।\nअन्धतानन्धता चेति विकारो मम जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2080843, "chapter_id": 2719, "verse_number": "१२-२२४-९", "content_sanskrit": "उन्मत्तेवाशुभं वाक्यं भाषसे शुभलोचने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2080844, "chapter_id": 2719, "verse_number": "१२-२२४-१०x", "content_sanskrit": "सुवर्चलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2080845, "chapter_id": 2719, "verse_number": "१२-२२४-१०", "content_sanskrit": "नाहमुन्मत्तभूताऽद्य बुद्धिपूर्वं ब्रवीमि ते।\nविद्यते चेत्पतिस्तादृक्स मां भरति वेदवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2080846, "chapter_id": 2719, "verse_number": "१२-२२४-११", "content_sanskrit": "येभ्यस्त्वं मन्यसे दातुं मामिहानय तान्द्विजान्।\nतादृशं तं पतिं तेषु वरयिष्ये यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2080847, "chapter_id": 2719, "verse_number": "१२-२२४-१२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2080848, "chapter_id": 2719, "verse_number": "१२-२२४-१२", "content_sanskrit": "तथेति चोक्त्वा तां कन्यामृषिः शिष्यानुवाच ह।\nब्राह्मणान्वेदसंपन्नान्योनिगोत्रविशोधितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2080849, "chapter_id": 2719, "verse_number": "१२-२२४-१३", "content_sanskrit": "मातृतः पितृतः शुद्धाञ्शुद्धानाचारतः शुभान्।\nअरोगान्बुद्धिसंपन्नाञ्शीलसत्वगुणान्वितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2080850, "chapter_id": 2719, "verse_number": "१२-२२४-१४", "content_sanskrit": "असंकीर्णांश्च गोत्रेषु वेदव्रतसमन्वितान्।\nब्राह्मणान्स्नातकाञ्शीघ्रं मातापितृसमन्वितान्।\nनिवेष्टुकामान्कन्यां मे दृष्ट्वाऽऽनयत शिष्यकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2080851, "chapter_id": 2719, "verse_number": "१२-२२४-१५", "content_sanskrit": "तच्छ्रुत्वा त्वरिताः शिष्या ह्याश्रमेषु ततस्ततः।\nग्रामेषु च ततो गत्वा ब्राह्मणेभ्यो न्यवेदयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2080852, "chapter_id": 2719, "verse_number": "१२-२२४-१६", "content_sanskrit": "ऋषेः प्रभावं मत्वा ते कन्यायाश्च द्विजोत्तमाः।\nअनेकमुनयो राजन्संप्राप्ता देवलाश्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2080853, "chapter_id": 2719, "verse_number": "१२-२२४-१७", "content_sanskrit": "अनुमान्य यथान्यायं मुनीन्मुनिकुमारकान्।\nअभ्यर्च्य विधिवत्तत्र कन्यामाह पिता महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2080854, "chapter_id": 2719, "verse_number": "१२-२२४-१८", "content_sanskrit": "एतेऽपि मुनयो वत्से स्वपुत्रैकमता इह।\nवेदवेदाङ्गसंपन्नाः कुलीनाः शीलसंमताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2080855, "chapter_id": 2719, "verse_number": "१२-२२४-१९", "content_sanskrit": "येऽमी तेषु वरं भद्रे त्वमिच्छसि महाव्रतम्।\nतं कुमारं वृणीष्वाद्य तस्मै दास्याम्यहं शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2080856, "chapter_id": 2719, "verse_number": "१२-२२४-२०", "content_sanskrit": "तथेति चोक्त्वा कल्याणी तप्तहेमनिभा तदा।\nसर्वलक्षणसंपन्ना वाक्यमाह यशस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2080857, "chapter_id": 2719, "verse_number": "१२-२२४-२१", "content_sanskrit": "विप्राणां समितीर्दृष्ट्वा प्रणिपत्य तपोधनान्।\nयद्यस्ति समितौ विप्रो ह्यन्धोऽनन्धः स मे वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2080858, "chapter_id": 2719, "verse_number": "१२-२२४-२२", "content_sanskrit": "तच्छ्रुत्वा मुनयस्तत्र वीक्षमाणाः परस्परम्।\nनोचुर्विप्रा महाभागाः कन्यां मत्वा ह्यवेदिकां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2080859, "chapter_id": 2719, "verse_number": "१२-२२४-२३", "content_sanskrit": "कुत्सयित्वा मुनिं तत्र मनसा मुनिसत्तमाः।\nयथागतं ययुः क्रुद्धा नानादेशनिवासिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2080860, "chapter_id": 2719, "verse_number": "१२-२२४-२४", "content_sanskrit": "कन्या च संस्थिता तत्र पितृवेश्मनि भामिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2080861, "chapter_id": 2719, "verse_number": "१२-२२४-२५", "content_sanskrit": "ततः कदाचिद्ब्रह्मण्यो विद्वान्न्यायविशारदः।\nऊहापोहविधानज्ञो ब्रह्मचर्यसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2080862, "chapter_id": 2719, "verse_number": "१२-२२४-२६", "content_sanskrit": "वेदविद्वेदतत्वज्ञः क्रियाकल्पविशारदः।\nआत्मतत्वविभागज्ञः पितृमान्गुणसागरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2080863, "chapter_id": 2719, "verse_number": "१२-२२४-२७", "content_sanskrit": "श्वेतकेतुरिति ख्यातः श्रुत्वा वृत्तान्तमादरात्।\nकन्यार्थं देवलं चापि शीघ्रं तत्रागतोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2080864, "chapter_id": 2719, "verse_number": "१२-२२४-२८", "content_sanskrit": "उद्दालकसुतं दृष्ट्वा श्वेतकेतुं महाव्रतम्।\nयथान्यायं च संपूज्य देवलः प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2080865, "chapter_id": 2719, "verse_number": "१२-२२४-२९", "content_sanskrit": "कन्ये एष महाभागे प्राप्तो ऋषिकुमारकः।\nवरयैनं महाप्राज्ञं वेदवेदाङ्गपारगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2080866, "chapter_id": 2719, "verse_number": "१२-२२४-३०", "content_sanskrit": "तच्छ्रुत्वा कुपिता कन्या ऋषिपुत्रमुदैक्षत।\nतां कन्यामाह विप्रर्षिः सोऽहं भद्रे समागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2080867, "chapter_id": 2719, "verse_number": "१२-२२४-३१", "content_sanskrit": "अन्धोऽहमत्र तत्वं हि तथा मन्ये च सर्वदा।\nविशालनयनं विद्धि तथा मां हीनसंशयम्।\nवृणीष्व मां वरारोहे भजे च त्वामनिन्दिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2080868, "chapter_id": 2719, "verse_number": "१२-२२४-३२", "content_sanskrit": "येनेदं वीक्षते नित्यं वृणोति स्पृशतेऽथवा।\nघ्रायते वक्ति सततं येनेदं सार्यते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2080869, "chapter_id": 2719, "verse_number": "१२-२२४-३३", "content_sanskrit": "येनेदं मन्यते तत्वं येन बुध्यति वा पुनः।\nन चक्षुर्विद्यते ह्येतत्स वै भूतान्ध उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2080870, "chapter_id": 2719, "verse_number": "१२-२२४-३४", "content_sanskrit": "यस्मिन्प्रवर्तते चेदं पश्यञ्छृण्वन्स्पृशन्नपि।\nजिघ्रंश्च रसयंस्तद्वद्वर्तते येन चक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2080871, "chapter_id": 2719, "verse_number": "१२-२२४-३५", "content_sanskrit": "तन्मे नास्ति ततो ह्यन्धो वृणु भद्रेऽद्य मामतः।\nलोकदृष्ट्या करोमीह नित्यनैमित्तिकादिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2080872, "chapter_id": 2719, "verse_number": "१२-२२४-३६", "content_sanskrit": "आत्मदृष्ट्या च तत्सर्वं विलिप्यासि च नित्यशः।\nस्थितोऽहं निर्भरः शान्तः कार्यकारणभावनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2080873, "chapter_id": 2719, "verse_number": "१२-२२४-३७", "content_sanskrit": "अविद्यया तरन्मृत्युं विद्यया तं तथाऽमृतम्।\nयथाप्राप्तं तु संदृश्य वसामीह विमत्सरः।\nक्रीते व्यवसितं भद्रे भर्ताऽहं ते वृणीष्व माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2080874, "chapter_id": 2719, "verse_number": "१२-२२४-३८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2080875, "chapter_id": 2719, "verse_number": "१२-२२४-३८", "content_sanskrit": "ततः सुवर्चला दृष्ट्वा प्राह तं द्विजसत्तमम्।\nमनसाऽसि वृतो विद्वञ्शेषकर्ता पिता मम।\nवृणीष्व पितरं मह्यमेष वेदविधिक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2080876, "chapter_id": 2719, "verse_number": "१२-२२४-३९", "content_sanskrit": "तद्विज्ञाय पिता तस्या देवलो मुनिसत्तमः।\nश्वेतकेतुं च संपूज्य तथैवोद्दालकेन तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2080877, "chapter_id": 2719, "verse_number": "१२-२२४-४०", "content_sanskrit": "मुनीनामग्रतः कन्यां प्रददौ जलपूर्वकम्।\nउदाहरन्ति वै तत्र श्वेतकेतुं निरीक्ष्य तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2080878, "chapter_id": 2719, "verse_number": "१२-२२४-४१", "content_sanskrit": "हृत्पुण्डरीकनिलयः सर्वभूतात्मको हरिः।\nश्वेतकेतुस्वरूपेण स्थितोऽसौ मधुसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2080879, "chapter_id": 2719, "verse_number": "१२-२२४-४२", "content_sanskrit": "प्रीयतां माधवो देवः पत्नी चेयं सुता मम।\nप्रतिपादयामि ते कन्यां सहधर्मचरीं शुभाम्।\nइत्युक्त्वा प्रददौ तस्मै देवलो मुनिपुङ्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2080880, "chapter_id": 2719, "verse_number": "१२-२२४-४३", "content_sanskrit": "प्रतिगृह्य च तां कन्यां श्वेतकेतुर्महायशाः।\nउपयम्य यथान्यायमत्र कृत्वा यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2080881, "chapter_id": 2719, "verse_number": "१२-२२४-४४", "content_sanskrit": "समाप्य तन्त्रं मुनिभिर्वैवाहिकमनुत्तमम्।\nस गार्हस्थ्ये वसन्धीमान्भार्यां तामिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2080882, "chapter_id": 2719, "verse_number": "१२-२२४-४५", "content_sanskrit": "यानि चोक्तानि वेदेषु तत्सर्वं कुरु शोभने।\nमया सह यथान्यायं सहधर्मचरी मम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2080883, "chapter_id": 2719, "verse_number": "१२-२२४-४६", "content_sanskrit": "अहमित्येव भावेन स्थितोऽहं त्वं तथैव च।\nतस्मात्कर्माणि कुर्वीथाः कुर्यां ते च ततः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2080884, "chapter_id": 2719, "verse_number": "१२-२२४-४७", "content_sanskrit": "न ममेति च भावेन ज्ञानाग्निनिलयेन च।\nअनन्तरं तथा कुर्यास्तानि कर्माणि भस्मसात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2080885, "chapter_id": 2719, "verse_number": "१२-२२४-४८", "content_sanskrit": "एवं त्वया च कर्तव्यं सर्वदा दुर्भगा मया।\nयद्यदाचरति श्रेष्ठस्तत्तदेवेतरो जनः।\nतस्माल्लोकस्य सिद्ध्यर्थं कर्तव्यं चात्मसिद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2080886, "chapter_id": 2719, "verse_number": "१२-२२४-४९", "content_sanskrit": "उक्त्वैवं स महाप्राज्ञः सर्वज्ञानैकभाजनः।\nपुत्रानुत्पाद्य तस्यां च यज्ञैः संतर्प्य देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2080887, "chapter_id": 2719, "verse_number": "१२-२२४-५०", "content_sanskrit": "आत्मयोगपरो नित्यं निर्द्वन्द्वो निष्परिग्रहः।\nभार्यां तां सदृशीं प्राप्य बुद्धिं क्षेत्रज्ञयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2080888, "chapter_id": 2719, "verse_number": "१२-२२४-५१", "content_sanskrit": "लोकमन्यमनुप्राप्तौ भार्या भर्ता तथैव च।\nसाक्षिभूतौ जगत्यस्मिंश्चरमाणौ मुदाऽन्वितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2080889, "chapter_id": 2719, "verse_number": "१२-२२४-५२", "content_sanskrit": "ततः कदाचिद्भर्तारं श्वेतकेतुं सुवर्चला।\nपप्रच्छ को भवानत्र ब्रूहि मे तद्द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2080890, "chapter_id": 2719, "verse_number": "१२-२२४-५३", "content_sanskrit": "तामाह भगवान्वाग्मी तया ज्ञातो न संशयः।\nद्विजोत्तमेति मामुक्त्वा पुनः कमनुपृच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2080891, "chapter_id": 2719, "verse_number": "१२-२२४-५४", "content_sanskrit": "सा तमाह महात्मानं पृच्छामि हृदि शायिनम्।\nतच्छ्रुत्वा प्रत्युवाचैनां स न वक्ष्यति भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2080892, "chapter_id": 2719, "verse_number": "१२-२२४-५५", "content_sanskrit": "नामगोत्रसमायुक्तमात्मानं मन्यसे यदि।\nतन्मिथ्यागोत्रसद्भावे वर्तते देहबन्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2080893, "chapter_id": 2719, "verse_number": "१२-२२४-५६", "content_sanskrit": "अहमित्येष भावोऽत्र त्वयि चापि समाहितः।\nत्वमप्यहमहं सर्वमहमित्येव वर्तते।\nनात्र तत्परमार्थं वै किमर्थमनुपृच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2080894, "chapter_id": 2719, "verse_number": "१२-२२४-५७", "content_sanskrit": "ततः प्रहस्य सा हृष्टा भर्तारं धर्मचारिणी।\nउवाच वचनं काले स्मयमाना तदा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2080895, "chapter_id": 2719, "verse_number": "१२-२२४-५८", "content_sanskrit": "किमनेकप्रकारेण विरोधेन प्रयोजनम्।\nक्रियाकलापैर्ब्रह्मर्षे ज्ञाननष्टोऽसि सर्वदा।\nतन्मे ब्रूहि महाप्राज्ञ यथाऽहं त्वामनुव्रता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2080896, "chapter_id": 2719, "verse_number": "१२-२२४-५९x", "content_sanskrit": "श्वेतकेतुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2080897, "chapter_id": 2719, "verse_number": "१२-२२४-५९", "content_sanskrit": "यद्यदाचरति श्रेष्ठस्तत्तदेवेतरो जनः।\nवर्तते तेन लोकोऽयं संकीर्णश्च भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2080898, "chapter_id": 2719, "verse_number": "१२-२२४-६०", "content_sanskrit": "संकीर्णे च तथा धर्मे वर्णः संकरमेति च।\nसंकरे च प्रवृत्ते तु मात्स्यो न्यायः प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2080899, "chapter_id": 2719, "verse_number": "१२-२२४-६१", "content_sanskrit": "तदनिष्टं हरेर्भद्रे धातुरस्य महात्मनः।\nपरमेश्वरसंक्रीडा लोकसृष्टिरियं शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2080900, "chapter_id": 2719, "verse_number": "१२-२२४-६२", "content_sanskrit": "यावत्पासव उद्दिष्टास्तावत्योऽस्य विभूतयः।\nतावत्यश्चैव मायास्तु तावत्योऽस्याश्च शक्तयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2080901, "chapter_id": 2719, "verse_number": "१२-२२४-६३", "content_sanskrit": "एवं सुगह्वरे युक्तो यत्र मे तद्भवाभवम्।\nछित्त्वा ज्ञानासिना गच्छेत्स विद्वान्स च मे प्रियः।\nसोऽहमेव न सन्देहः प्रतिज्ञा इति तस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2080902, "chapter_id": 2719, "verse_number": "१२-२२४-६४", "content_sanskrit": "ये मूढास्ते दुरात्मानो धर्मसंकरकारकाः।\nमर्यादाभेदका नीचा नरके यान्ति जन्तवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2080903, "chapter_id": 2719, "verse_number": "१२-२२४-६५", "content_sanskrit": "आसुरीं योनिमापन्ना इति देवानुशासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2080904, "chapter_id": 2719, "verse_number": "१२-२२४-६६", "content_sanskrit": "भगवत्या तथा लोके रक्षितव्यं न संशयः।\nमर्यादालोकरक्षार्थमेवमस्ति तथा स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2080905, "chapter_id": 2719, "verse_number": "१२-२२४-६७x", "content_sanskrit": "सुवर्चलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2080906, "chapter_id": 2719, "verse_number": "१२-२२४-६७", "content_sanskrit": "शब्दः कोत्र इति ख्यातस्तथाऽर्थं च महामुने।\nआकृत्या पतयो ब्रूहि लक्षणेन पृथक्पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2080907, "chapter_id": 2719, "verse_number": "१२-२२४-६८x", "content_sanskrit": "श्वेतकेतुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2080908, "chapter_id": 2719, "verse_number": "१२-२२४-६८", "content_sanskrit": "व्यत्ययेन च वर्णानां परिवादकृतो हि यः।\nस शब्द इति विज्ञेयस्तन्निपातोऽर्थ उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2080909, "chapter_id": 2719, "verse_number": "१२-२२४-६९x", "content_sanskrit": "सुवर्चलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2080910, "chapter_id": 2719, "verse_number": "१२-२२४-६९", "content_sanskrit": "शब्दार्थयोर्हि संबन्धस्त्वनयोरस्ति वा न वा।\nतन्मे ब्रूहि यथातत्वं शब्दस्यानेऽर्थ एव चेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2080911, "chapter_id": 2719, "verse_number": "१२-२२४-७०x", "content_sanskrit": "श्वेतकेतुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2080912, "chapter_id": 2719, "verse_number": "१२-२२४-७०", "content_sanskrit": "शब्दार्थयोर्न चैवास्ति संबन्धोऽत्यन्त एव हि।\nपुष्करे च यथा तोयं तथाऽस्मीति च वेत्थ तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2080913, "chapter_id": 2719, "verse_number": "१२-२२४-७१x", "content_sanskrit": "सुवर्चलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2080914, "chapter_id": 2719, "verse_number": "१२-२२४-७१", "content_sanskrit": "अर्थे स्थितिर्हि शब्दस्य नान्यथा च स्थितिर्भवेत्।\nविद्यते चेन्महाप्राज्ञ विनाऽर्थं ब्रूहि सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2080915, "chapter_id": 2719, "verse_number": "१२-२२४-७२x", "content_sanskrit": "श्वेतकेतुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2080916, "chapter_id": 2719, "verse_number": "१२-२२४-७२", "content_sanskrit": "ससंसर्गोऽतिमात्रस्तु वाचकत्वेन वर्तते।\nअस्ति चेद्वर्तते नित्यं विकारोच्चारणेन वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2080917, "chapter_id": 2719, "verse_number": "१२-२२४-७३x", "content_sanskrit": "सुवर्चलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2080918, "chapter_id": 2719, "verse_number": "१२-२२४-७३", "content_sanskrit": "शब्दस्थानोत्र इत्युक्तस्तथाऽर्थ इति मे कृतः।\nअर्थः स्थितो न तिष्ठेच्च विरूढमिह भाषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2080919, "chapter_id": 2719, "verse_number": "१२-२२४-७४x", "content_sanskrit": "श्वेतकेतुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2080920, "chapter_id": 2719, "verse_number": "१२-२२४-७४", "content_sanskrit": "न विकूलोऽत्र कथितो नाकाशं हि विना जगत्।\nसंबन्धस्तत्र नास्त्येव तद्वदित्येष मन्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2080921, "chapter_id": 2719, "verse_number": "१२-२२४-७५x", "content_sanskrit": "सुवर्चलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2080922, "chapter_id": 2719, "verse_number": "१२-२२४-७५", "content_sanskrit": "सदाऽहंकारशब्दोऽयं व्यक्तमात्मनि संश्रितः।\nन वाचस्तत्र वर्तन्ते इति मिथ्या भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2080923, "chapter_id": 2719, "verse_number": "१२-२२४-७६x", "content_sanskrit": "श्वेतकेतुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2080924, "chapter_id": 2719, "verse_number": "१२-२२४-७६", "content_sanskrit": "अहंशब्दो ह्यहंभावो नात्मभावे शुभव्रते।\nन वर्तन्ते परेऽचिन्त्ये वाचः सगुणलक्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2080925, "chapter_id": 2719, "verse_number": "१२-२२४-७७x", "content_sanskrit": "सुवर्चलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2080926, "chapter_id": 2719, "verse_number": "१२-२२४-७७", "content_sanskrit": "अहं गात्रैकतः श्यामा भावनपि तथैव च।\nतन्मे ब्रूहि यथान्यायमेवं चेन्मुनिसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2080927, "chapter_id": 2719, "verse_number": "१२-२२४-७८x", "content_sanskrit": "श्वेतकेतुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2080928, "chapter_id": 2719, "verse_number": "१२-२२४-७८", "content_sanskrit": "मृण्मये हि घटे भावस्तादृग्भाव इहेष्यते।\nअयं भावः परेऽचिन्त्ये ह्यात्मभावो यथाच तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2080929, "chapter_id": 2719, "verse_number": "१२-२२४-७९", "content_sanskrit": "अहं त्वमेतदित्येव परे संकल्पना मया।\nतस्माद्वाचो न वर्तन्त इति नैव विरुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2080930, "chapter_id": 2719, "verse_number": "१२-२२४-८०", "content_sanskrit": "तस्माद्वामेन वर्तन्ते मनसा भीरु सर्वशः।\nयथाऽऽकाशगतं विश्वं संसक्तमिव लक्ष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2080931, "chapter_id": 2719, "verse_number": "१२-२२४-८१", "content_sanskrit": "संसर्गे सति संबन्धात्तद्विकारं भविष्यति।\nअनाकाशगतं सर्वं विकारे च सदा गतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2080932, "chapter_id": 2719, "verse_number": "१२-२२४-८२", "content_sanskrit": "तद्ब्रह्म परमं शुद्धमनौषम्यं न शक्यते।\nन दृश्यते तथा तच्च दृश्यते च मतिर्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2080933, "chapter_id": 2719, "verse_number": "१२-२२४-८३x", "content_sanskrit": "सुवर्चलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2080934, "chapter_id": 2719, "verse_number": "१२-२२४-८३", "content_sanskrit": "निर्विकारं ह्यमूर्ति च निरयं सर्वगं तथा।\nदृश्यते च वियन्नित्यं दृगात्मा तेन दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2080935, "chapter_id": 2719, "verse_number": "१२-२२४-८४x", "content_sanskrit": "श्वेतकेतुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2080936, "chapter_id": 2719, "verse_number": "१२-२२४-८४", "content_sanskrit": "त्वचा स्पृशति वै वायुमाकाशस्थं पुनः पुनः।\nतत्स्थं गन्धं तथाघ्राति ज्योतिः पश्यति चक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2080937, "chapter_id": 2719, "verse_number": "१२-२२४-८५", "content_sanskrit": "तमोरश्मिगणश्चैव मेघजालं तथैव च।\nवर्षं तारागणं चैव नाकाशं दृश्यते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2080938, "chapter_id": 2719, "verse_number": "१२-२२४-८६", "content_sanskrit": "आकाशस्याप्यथाकाशं सद्रूपमिति निश्चितम्।\nतदर्थे कल्पिता ह्येते तत्सत्यो विष्णुरेव च।\nयानि नामानि गौणानि ह्युपचारात्परात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2080939, "chapter_id": 2719, "verse_number": "१२-२२४-८७", "content_sanskrit": "न चक्षुषा न मनसा न चान्येन परो विभुः।\nचिन्त्यते सूक्ष्मया बुद्ध्या वाचा वक्तुं न शक्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2080940, "chapter_id": 2719, "verse_number": "१२-२२४-८८", "content_sanskrit": "एतत्प्रपञ्चमखिलं तस्मिन्सर्वं प्रतिष्ठितम्।\nमहाघटोऽल्पकश्चैव यथा मह्यां प्रतिष्ठितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2080941, "chapter_id": 2719, "verse_number": "१२-२२४-८९", "content_sanskrit": "न च स्त्री न पुमांश्चैव यथैव न नपुंसकः।\nकेवलज्ञानमात्रं तत्तस्मिन्सर्वं प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2080942, "chapter_id": 2719, "verse_number": "१२-२२४-९०", "content_sanskrit": "भूमिसंस्थानयोगेन वस्तुसंस्थानयोगतः।\nरसभेदा यथा तोये प्रकृत्यामात्मनस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2080943, "chapter_id": 2719, "verse_number": "१२-२२४-९१", "content_sanskrit": "तद्वाक्यस्मरणान्नित्यं तृप्तिं वारि पिबन्निव।\nप्राप्नोति ज्ञानमखिलं तेन तत्सुखमेधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2080944, "chapter_id": 2719, "verse_number": "१२-२२४-९२x", "content_sanskrit": "सुवर्चलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2080945, "chapter_id": 2719, "verse_number": "१२-२२४-९२", "content_sanskrit": "अनेन साध्यं किं स्याद्वै शब्देनेति मतिर्मम।\nवेदगम्यः परोऽचिन्त्य इति पौराणिका विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2080946, "chapter_id": 2719, "verse_number": "१२-२२४-९३", "content_sanskrit": "निरर्थको यथा लोके तद्वत्स्यादिति मे मतिः।\nनिरीक्ष्यैवं यथान्यायं वक्तुमर्हसि मेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2080947, "chapter_id": 2719, "verse_number": "१२-२२४-९४x", "content_sanskrit": "श्वेतकेतुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2080948, "chapter_id": 2719, "verse_number": "१२-२२४-९४", "content_sanskrit": "वेदगम्यं परं शुद्धमिति सत्या परा श्रुतिः।\nव्याहत्या नैतदित्याह व्युपलिङ्गे च वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2080949, "chapter_id": 2719, "verse_number": "१२-२२४-९५", "content_sanskrit": "निरर्थको न चैवास्ति शब्दो लौकिक उत्तमे।\nअनन्वयास्तथा शब्दा निरर्था इति लौकिकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2080950, "chapter_id": 2719, "verse_number": "१२-२२४-९६", "content_sanskrit": "गृह्यन्ते तद्वदित्येव न वर्तन्ते परात्मनि।\nअगोचरत्वं वचसां युक्तमेवं तथा शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2080951, "chapter_id": 2719, "verse_number": "१२-२२४-९७", "content_sanskrit": "साधनस्योपदेशाच्च ह्युपायस्य च सूचनात्।\nउपलक्षणयोगेन व्यावृत्त्या च प्रदर्शनात्।\nवेदगम्यः परः शुद्ध इति मे धीयते मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2080952, "chapter_id": 2719, "verse_number": "१२-२२४-९८", "content_sanskrit": "अध्यात्मध्यानसंभूतमभूतं----- वत्स्फुटम्।\nज्ञानं विद्धि शुभाचारे तेन यान्ति परां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2080953, "chapter_id": 2719, "verse_number": "१२-२२४-९९", "content_sanskrit": "यदि मे व्याहृतं गुह्यं श्रुतं न तु त्वया शुभे।\nतथ्यमित्येव वा शुद्धे ज्ञानं ज्ञानविलोचने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2080954, "chapter_id": 2719, "verse_number": "१२-२२४-१००", "content_sanskrit": "नानारूपवदस्यैवमैश्वर्यं दृश्यते शुभे।\nन वायुस्तं न सूर्यस्तं नाग्निस्तत्तत्परं पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2080955, "chapter_id": 2719, "verse_number": "१२-२२४-१०१", "content_sanskrit": "अनेन पूर्णमेतद्धि हृदि भूतमिहेष्यते।\nएतावदात्मविज्ञानमेतावद्यदहं स्मृतम्।\nआवयोर्न च सत्वे वै तस्मादज्ञानबन्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2080956, "chapter_id": 2719, "verse_number": "१२-२२४-१०२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2080957, "chapter_id": 2719, "verse_number": "१२-२२४-१०२", "content_sanskrit": "एवं सुवर्चला हृष्टा प्रोक्ता भर्त्रा यथार्थवत्।\nपरिचर्यमाणा ह्यनिशं तत्वबुद्धिसमन्विता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2080958, "chapter_id": 2719, "verse_number": "१२-२२४-१०३", "content_sanskrit": "भर्ता च तामनुप्रेक्ष्य नित्यनैमित्तिकान्वितः।\nपरमात्मनि गोविन्दे वासुदेवे महात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2080959, "chapter_id": 2719, "verse_number": "१२-२२४-१०४", "content_sanskrit": "समाधाय च कर्माणि तन्मयत्वेन भावितः।\nकालेन महता राजन्प्राप्नोति परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2080960, "chapter_id": 2719, "verse_number": "१२-२२४-१०५", "content_sanskrit": "एतत्ते कथितं राजन्यस्मात्त्वं परिपृच्छसि।\nगार्हस्थ्यं च समास्थाय गतौ जायापती परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2080961, "chapter_id": 2719, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि चतुर्विंशत्यधिकद्विशततमोऽध्यायः॥ २२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}]