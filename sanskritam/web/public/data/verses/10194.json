[{"id": 6000194000, "chapter_id": 10194, "verse_number": null, "content_sanskrit": "अथ एकोनविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000194001, "chapter_id": 10194, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.001.m4a", "display_order": 2}, {"id": 6000194002, "chapter_id": 10194, "verse_number": "९-१९-१", "content_sanskrit": "मित्रायुश्च दिवोदासाच्च्यवनस्तत्सुतो नृप।\nसुदासः सहदेवोऽथ सोमको जन्तुजन्मकृत्॥ ९/१९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.002.m4a", "display_order": 3, "topics": [{"text": "द्रुपदजरासन्धयोर्वंशवर्णनम्", "range": "१–११"}]}, {"id": 6000194003, "chapter_id": 10194, "verse_number": "९-१९-२", "content_sanskrit": "तस्य पुत्रशतं तेषां यवीयान् पृषतस्ततः।\nद्रुपदो द्रौपदी तस्य धृष्टद्युम्नादयः सुताः॥ ९/१९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.003.m4a", "display_order": 4}, {"id": 6000194004, "chapter_id": 10194, "verse_number": "९-१९-३", "content_sanskrit": "धृष्टद्युम्नाद् धृष्टकेतुर्हर्म्याः पाञ्चालका इमे।\nयोऽजमीढसुतो ह्यन्य ऋक्षात् संवरणस्ततः॥ ९/१९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.004.m4a", "display_order": 5}, {"id": 6000194005, "chapter_id": 10194, "verse_number": "९-१९-४", "content_sanskrit": "तत्पत्न्यां सूर्यकन्यायां कुरुक्षेत्रपतिः कुरुः।\nपरीक्षित् सुधनुर्जह्नुर्निषधाश्वः कुरोः सुताः॥ ९/१९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.005.m4a", "display_order": 6}, {"id": 6000194006, "chapter_id": 10194, "verse_number": "९-१९-५", "content_sanskrit": "सुहोत्रोऽभूत् सुधनुषश्च्यवनस्तत्सुतः कृती।\nवसुस्तस्योपरिचरो बृहद्रथमुखास्ततः॥ ९/१९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.006.m4a", "display_order": 7}, {"id": 6000194007, "chapter_id": 10194, "verse_number": "९-१९-६", "content_sanskrit": "कुशाम्बुमत्स्यप्रत्यग्रवेदिषाद्याश्च चेदिपाः।\nबृहद्रथात् कुशाग्रोऽभूद् ऋषभस्तस्य तत्सुतः॥ ९/१९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.007.m4a", "display_order": 8}, {"id": 6000194008, "chapter_id": 10194, "verse_number": "९-१९-७", "content_sanskrit": "जज्ञे सत्यहितोऽपत्यं पुष्पवांस्तत्सुतो जहुः।\nअन्यस्यामपि भार्यायां शकले द्वे बृहद्रथात्॥ ९/१९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.008.m4a", "display_order": 9}, {"id": 6000194009, "chapter_id": 10194, "verse_number": "९-१९-८", "content_sanskrit": "ते मात्रा बहिरुत्सृष्टे जरया चाभिसन्धिते।\nजीव जीवेति क्रीडन्त्या जरासन्धोऽभवत् सुतः॥ ९/१९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.009.m4a", "display_order": 10}, {"id": 6000194010, "chapter_id": 10194, "verse_number": "९-१९-९", "content_sanskrit": "ततश्च सहदेवोऽभूत् सोमापिर्यच्छ्रुतश्रवाः।\nपरीक्षिदनपत्योऽभूत् सुरथो नाम जाहवः॥ ९/१९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.010.m4a", "display_order": 11}, {"id": 6000194011, "chapter_id": 10194, "verse_number": "९-१९-१०", "content_sanskrit": "ततो विदूरथस्तस्मात् सार्वभौमस्ततोऽभवत्।\nजयत्सेनस्तत्तनयो राचीकोऽतो द्युमानभूत्॥ ९/१९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.011.m4a", "display_order": 12}, {"id": 6000194012, "chapter_id": 10194, "verse_number": "९-१९-११", "content_sanskrit": "ततश्च क्रोधनस्तस्माद् देवातिथिरमुष्य च।\nऋक्षस्तस्य दिलीपोऽभूत् प्रतीपस्तस्य चात्मजः॥ ९/१९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.012.m4a", "display_order": 13}, {"id": 6000194013, "chapter_id": 10194, "verse_number": "९-१९-१२", "content_sanskrit": "देवापिः शन्तनुस्तस्य बाह्लीक इति चात्मजाः।\nपितृराज्यं समुत्सृज्य देवापिस्तु वनं गतः॥ ९/१९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.013.m4a", "display_order": 14, "topics": [{"text": "शन्तनूत्पत्तिः शन्तनुवंशवर्णनम्", "range": "१२–२४"}]}, {"id": 6000194014, "chapter_id": 10194, "verse_number": "९-१९-१३", "content_sanskrit": "अभवच्छन्तनू राजा प्राङ्महाभिषजसञ्ज्ञितः।\nयं यं कराभ्यां स्पृशति जीर्णं यौवनमेति सः॥ ९/१९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.014.m4a", "display_order": 15}, {"id": 6000194015, "chapter_id": 10194, "verse_number": "९-१९-१४", "content_sanskrit": "शान्तिमाप्नोति चैवाग्र्यां कर्मणा तेन शन्तनुः।\nसमा द्वादश तद्राष्ट्रे न ववर्ष यदा विभुः॥ ९/१९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.015.m4a", "display_order": 16}, {"id": 6000194016, "chapter_id": 10194, "verse_number": "९-१९-१५", "content_sanskrit": "शन्तनुर्ब्राह्मणैरुक्तः परिवेत्ताऽयमग्रभुक्।\nराज्यं देह्यग्रजायाशु पुरराष्ट्रविवृद्धये॥ ९/१९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.016.m4a", "display_order": 17}, {"id": 6000194017, "chapter_id": 10194, "verse_number": "९-१९-१६", "content_sanskrit": "एवमुक्तो द्विजैर्ज्येष्ठं छन्दयामास सोऽब्रवीत्। तन्मन्त्रिप्रहितैर्विप्रैर्वेदाद् विभ्रंशितो गिरा।\nवेदवादातिवादान् वै ततो देवो ववर्ष ह॥ ९/१९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.017.m4a", "display_order": 18}, {"id": 6000194018, "chapter_id": 10194, "verse_number": "९-१९-१७", "content_sanskrit": "देवापिर्योगमास्थाय कलापग्राममास्थितः।\nसोमवंशे कलौ नष्टे कृतादौ स्थापयिष्यति॥ ९/१९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.018.m4a", "display_order": 19}, {"id": 6000194019, "chapter_id": 10194, "verse_number": "९-१९-१८", "content_sanskrit": "बाह्लीकात् सोमदत्तोऽभूद् भूरिर्भूरिश्रवास्ततः।\nशलश्च शन्तनोरासीद् गङ्गायां भीष्म आत्मवान्॥ ९/१९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.019.m4a", "display_order": 20}, {"id": 6000194020, "chapter_id": 10194, "verse_number": "९-१९-१९", "content_sanskrit": "सर्वधर्मविदां श्रेष्ठो महाभागवतः कविः।\nवीरयूथाग्रणीर्येन रामोऽपि युधि तोषितः॥ ९/१९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.020.m4a", "display_order": 21}, {"id": 6000194021, "chapter_id": 10194, "verse_number": "९-१९-२०", "content_sanskrit": "शन्तनोर्दाशकन्यायां जज्ञे चित्राङ्गदः सुतः।\nविचित्रवीर्योऽवरजो नाम्ना चित्राङ्गदो हतः॥ ९/१९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.021.m4a", "display_order": 22}, {"id": 6000194022, "chapter_id": 10194, "verse_number": "९-१९-२१", "content_sanskrit": "यस्यां पराशरात् साक्षादवतीर्णो हरेः कला।\nवेदगुप्त्यै मुनिः कृष्णो यतोऽहमिदमध्यगाम्॥ ९/१९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.022.m4a", "display_order": 23}, {"id": 6000194023, "chapter_id": 10194, "verse_number": "९-१९-२२", "content_sanskrit": "हित्वा स्वशिष्यान् पैलादीन् भगवान् बादरायणः।\nमह्यं पुत्राय शान्ताय परं गुह्यमिदं जगौ॥ ९/१९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.023.m4a", "display_order": 24}, {"id": 6000194024, "chapter_id": 10194, "verse_number": "९-१९-२३", "content_sanskrit": "विचित्रवीर्योऽथोवाह काशिराजसुते बलात्।\nस्वयंवरादुपानीते अम्बिकाम्बालिके उभे॥ ९/१९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.024.m4a", "display_order": 25}, {"id": 6000194025, "chapter_id": 10194, "verse_number": "९-१९-२४", "content_sanskrit": "तयोरासक्तहृदयो गृहीतो यक्ष्मणा मृतः॥ ९/१९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.025.m4a", "display_order": 26}, {"id": 6000194026, "chapter_id": 10194, "verse_number": "९-१९-२५", "content_sanskrit": "क्षेत्रेऽप्रजस्य वै भ्रातुर्मात्रोक्तो बादरायणः।\nधृतराष्ट्रं च पाण्डुं च विदुरं चाप्यजीजनत्॥ ९/१९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.026.m4a", "display_order": 27, "topics": [{"text": "धार्तराष्ट्राणां पाण्डवानां चोत्पत्तिः", "range": "२५–२८"}]}, {"id": 6000194027, "chapter_id": 10194, "verse_number": "९-१९-२६", "content_sanskrit": "गान्धार्यां धृतराष्ट्रस्य जज्ञे सुतशतं नृप।\nतेषां दुर्योधनो ज्येष्ठो दुःशला चापि कन्यका॥ ९/१९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.027.m4a", "display_order": 28}, {"id": 6000194028, "chapter_id": 10194, "verse_number": "९-१९-२७", "content_sanskrit": "शापान्मैथुनरुद्धस्य पाण्डोः कुन्त्यां महारथाः।\nजाता धर्मानिलेन्द्रेभ्यो युधिष्ठिरमुखास्‍त्रयः॥ ९/१९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.028.m4a", "display_order": 29}, {"id": 6000194029, "chapter_id": 10194, "verse_number": "९-१९-२८", "content_sanskrit": "नकुलः सहदेवश्च माद्र्यां नासत्यदस्रयोः।\nद्रौपद्यां पञ्च पञ्चभ्यः पुत्रास्ते पितरोऽभवन्॥ ९/१९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.029.m4a", "display_order": 30}, {"id": 6000194030, "chapter_id": 10194, "verse_number": "९-१९-२९", "content_sanskrit": "युधिष्ठिरात् प्रतिविन्ध्यः श्रुतसेनो वृकोदरात्।\nअर्जुनाच्छ्रुतकीर्तिस्तु शतानीकस्तु नाकुलिः॥ ९/१९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.030.m4a", "display_order": 31, "topics": [{"text": "पाण्डववंशे अतीतानामनागतानां च राज्ञां वंशकथनम्", "range": "२९–४५"}]}, {"id": 6000194031, "chapter_id": 10194, "verse_number": "९-१९-३०", "content_sanskrit": "सहदेवसुतो राजन् श्रुतकीर्तिस्तथाऽपरे।\nयुधिष्ठिरात्तु पौरव्यां देवकोऽथ घटोत्कचः॥ ९/१९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.031.m4a", "display_order": 32}, {"id": 6000194032, "chapter_id": 10194, "verse_number": "९-१९-३१", "content_sanskrit": "भीमसेनाद् हिडिम्बायां काल्यां शर्वगतस्ततः।\nसहदेवात् सुहोत्रं तु विजयाऽसूत पार्वती॥ ९/१९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.032.m4a", "display_order": 33}, {"id": 6000194033, "chapter_id": 10194, "verse_number": "९-१९-३२", "content_sanskrit": "करेणुमत्यां नकुलो निरमित्रं तथाऽर्जुनः।\nइरावन्तमुलूप्यां वै सुतायां बभ्रुवाहनम्॥ ९/१९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.033.m4a", "display_order": 34}, {"id": 6000194034, "chapter_id": 10194, "verse_number": "९-१९-३३", "content_sanskrit": "मणिपूरपतेः सोऽपि तत्पुत्रः पुत्रिकासुतः।\nतव तातः सुभद्रायामभिमन्युरजायत॥ ९/१९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.034.m4a", "display_order": 35}, {"id": 6000194035, "chapter_id": 10194, "verse_number": "९-१९-३४", "content_sanskrit": "सर्वातिरथजिद् वीर उत्तरायां ततो भवान्।\nपरिक्षीणेषु कुरुषु द्रौणेर्ब्रह्मास्‍त्रतेजसा॥ ९/१९/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.035.m4a", "display_order": 36}, {"id": 6000194036, "chapter_id": 10194, "verse_number": "९-१९-३५", "content_sanskrit": "त्वं तु कृष्णानुभावेन सजीवो मोचितोऽन्तकात्।\nतवेमे तनयास्तात जनमेजयपूर्वकाः॥ ९/१९/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.036.m4a", "display_order": 37}, {"id": 6000194037, "chapter_id": 10194, "verse_number": "९-१९-३६", "content_sanskrit": "श्रुतसेनो भीमसेन उग्रसेनश्च वीर्यवान्।\nजनमेजयस्त्वां विदित्वा तक्षकान्निधनं गतम्॥ ९/१९/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.037.m4a", "display_order": 38}, {"id": 6000194038, "chapter_id": 10194, "verse_number": "९-१९-३७", "content_sanskrit": "सर्पान् वै सर्पयागाग्नौ स होष्यति रुषाऽन्वितः।\nकावषेयं पुरोधाय तुरं तुरगमेधया॥ ९/१९/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.038.m4a", "display_order": 39}, {"id": 6000194039, "chapter_id": 10194, "verse_number": "९-१९-३८", "content_sanskrit": "समन्तात् पृथिवीं सर्वां जित्वा यक्ष्यति चाध्वरैः।\nतस्य पुत्रः शतानीको याज्ञवल्क्यात् त्रयीं पठन्॥ ९/१९/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.039.m4a", "display_order": 40}, {"id": 6000194040, "chapter_id": 10194, "verse_number": "९-१९-३९", "content_sanskrit": "अस्‍त्रज्ञानं क्रियाज्ञानं शौनकात् परमेष्यति।\nसहस्रानीकस्तत्पुत्रस्ततश्चैवाश्वमेधजः॥ ९/१९/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.040.m4a", "display_order": 41}, {"id": 6000194041, "chapter_id": 10194, "verse_number": "९-१९-४०", "content_sanskrit": "विश्रम्भकृष्णस्तस्यापि नेमिचक्रस्तु तत्सुतः।\nगजाह्वये हृते नद्या कौशाम्ब्यां साधु वत्स्यति॥ ९/१९/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.041.m4a", "display_order": 42}, {"id": 6000194042, "chapter_id": 10194, "verse_number": "९-१९-४१", "content_sanskrit": "उक्तस्ततश्चित्ररथस्तस्माच्छुचिरथः सुतः।\nतस्माच्च धृष्टिमांस्तस्य सुषेणोऽथ महीपतिः॥ ९/१९/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.042.m4a", "display_order": 43}, {"id": 6000194043, "chapter_id": 10194, "verse_number": "९-१९-४२", "content_sanskrit": "सुनीथस्तस्य भविता नृचक्षुर्यत् सुखीनलः।\nपारिप्लवः सुतस्तस्मान्मेधावी सुनयात्मजः॥ ९/१९/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.043.m4a", "display_order": 44}, {"id": 6000194044, "chapter_id": 10194, "verse_number": "९-१९-४३", "content_sanskrit": "नृपञ्जयस्ततो दुर्वस्तिमिस्तस्माज्जनिष्यते।\nततो बृहद्रथस्तस्माच्छतानीकः सुदासजः॥ ९/१९/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.044.m4a", "display_order": 45}, {"id": 6000194045, "chapter_id": 10194, "verse_number": "९-१९-४४", "content_sanskrit": "शतानीकाद् दुर्दमनस्तस्यापत्यं बहीनरः।\nदण्डपाणिर्निमिस्तस्य क्षेमको भविता नृप॥ ९/१९/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.045.m4a", "display_order": 46}, {"id": 6000194046, "chapter_id": 10194, "verse_number": "९-१९-४५", "content_sanskrit": "ब्रह्मक्षत्रस्य वै योनिर्वंशे देवर्षिसत्कृतः।\nक्षेमकं प्राप्य राजानं संस्थां प्राप्स्यति वै कलौ॥ ९/१९/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.046.m4a", "display_order": 47}, {"id": 6000194047, "chapter_id": 10194, "verse_number": "९-१९-४६", "content_sanskrit": "पापानि कीर्तनादेषां विलयं यान्ति कृत्स्नशः।\nअथ मागधराजानो भाविनो ये वदामि ते॥ ९/१९/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.047.m4a", "display_order": 48, "topics": [{"text": "मागधवंशवर्णनम्", "range": "४६–५०"}]}, {"id": 6000194048, "chapter_id": 10194, "verse_number": "९-१९-४७", "content_sanskrit": "भविता सहदेवस्य सोमापिर्यत्सुतःश्रवाः।\nततोऽयुतायुस्तस्यापि निरमित्रोऽथ तत्सुतः॥ ९/१९/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.048.m4a", "display_order": 49}, {"id": 6000194049, "chapter_id": 10194, "verse_number": "९-१९-४८", "content_sanskrit": "सुनक्षत्रः सुनक्षत्राद् बृहत्सेनोऽथ कर्मजित्।\nततः श्रुतञ्जयो विप्रः शुचिस्तस्य भविष्यति॥ ९/१९/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.049.m4a", "display_order": 50}, {"id": 6000194050, "chapter_id": 10194, "verse_number": "९-१९-४९", "content_sanskrit": "क्षेमोऽथ सुव्रतस्तस्माद् धर्मसत्रः शमस्ततः।\nदृढसेनोऽथ सुमतिः सुबलो जनिता ततः॥ ९/१९/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.050.m4a", "display_order": 51}, {"id": 6000194051, "chapter_id": 10194, "verse_number": "९-१९-५०", "content_sanskrit": "सुनीथः सत्यजिदथ विश्वजिद् यद् रिपुञ्जयः।\nबार्हद्रथाश्च भूपाला भाव्याः साहस्रवत्सरम्॥ ९/१९/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_019/BhP_09.019.051.m4a", "display_order": 52}, {"id": 6000194052, "chapter_id": 10194, "verse_number": null, "content_sanskrit": "इति श्रीमद्भागवते वैयासिक्यां संहितायां नवमस्कन्धे एकोनविंशाध्यायः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]