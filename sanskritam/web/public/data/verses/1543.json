[{"id": 2025238, "chapter_id": 1543, "verse_number": "३-१८१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2025239, "chapter_id": 1543, "verse_number": "३-१८१-१", "content_sanskrit": "स भीमसेनस्तेजस्वी तदा सर्पवशं गतः।\nचिन्तयामास सर्पस्य वीर्यमत्यद्भुतं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2025240, "chapter_id": 1543, "verse_number": "३-१८१-२", "content_sanskrit": "उवाच च महासर्पं कामयाब्रूहि पन्नग।\nकस्त्वं भो भुजगश्रेष्ठ किं मया च करिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2025241, "chapter_id": 1543, "verse_number": "३-१८१-३", "content_sanskrit": "पाण्डवो भीमसेनोऽहं धर्मराजादनन्तरः।\nनागायुतसमप्राणस्त्वया नीतः कथं वशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2025242, "chapter_id": 1543, "verse_number": "३-१८१-४", "content_sanskrit": "सिंहाः केसरिणो व्याघ्रा महिषा वारणास्तथा।\nसमागताश्च बहुशो निहताश्च मया युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2025243, "chapter_id": 1543, "verse_number": "३-१८१-५", "content_sanskrit": "राक्षसाश्च पिशाचाश्च पन्नगाश्च महाबलाः।\nभुजवेगमशक्ता मे सोढुं पन्नगसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2025244, "chapter_id": 1543, "verse_number": "३-१८१-६", "content_sanskrit": "किंनु विद्याबलं किंनु वरदानमथो तव।\nउद्योगमपि कुर्वाणो वशगोस्मि कृतस्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2025245, "chapter_id": 1543, "verse_number": "३-१८१-७", "content_sanskrit": "अनुत्यो विक्रमो नॄणामिति मे धीयते मतिः।\nयथेदं मे त्वया नाग बलं प्रतिहतं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2025246, "chapter_id": 1543, "verse_number": "३-१८१-८", "content_sanskrit": "इत्येवंवादिनं वीरं भीममक्लिष्टकारिणम्।\nभोगेन महता गृह्य समन्तात्पर्यवेष्टयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2025247, "chapter_id": 1543, "verse_number": "३-१८१-९", "content_sanskrit": "निगृह्यैनं महाबाहुं ततः स भुजगस्तदा।\nविमुच्यास्य भुजौ पीनाविदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2025248, "chapter_id": 1543, "verse_number": "३-१८१-१०", "content_sanskrit": "दिष्टस्त्वं क्षुधितस्याद्य देवैर्भक्षो महाभुज।\nदिष्ट्या कालस्य महतः प्रियाः प्राणा हि देहिनां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2025249, "chapter_id": 1543, "verse_number": "३-१८१-११", "content_sanskrit": "यथा त्विदं मया प्राप्तं भुजङ्गत्वमरिंदम।\nतदवश्यं त्वया मत्तः श्रोतव्यं शृणु यन्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2025250, "chapter_id": 1543, "verse_number": "३-१८१-१२", "content_sanskrit": "इमामवस्थां संप्राप्तो ह्यहं कोपान्महर्षिणा।\nशापस्यान्तं परिप्रेप्सुः सर्वस् कथयामि तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2025251, "chapter_id": 1543, "verse_number": "३-१८१-१३", "content_sanskrit": "नहुषो नाम राजर्षिर्व्यक्तं ते श्रोत्रमागतः।\nतवैव पूर्वः पूर्वेषामायोर्वंशधरः सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2025252, "chapter_id": 1543, "verse_number": "३-१८१-१४", "content_sanskrit": "सोहं शापादगस्त्यस्य ब्राह्मणानवमत्य च।\nइमामवस्थामापन्नः पश्य दैवमिदं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2025253, "chapter_id": 1543, "verse_number": "३-१८१-१५", "content_sanskrit": "त्वां चेदवध्यमायान्तमतीव प्रियदर्शनम्।\nअहमद्योपयोक्ष्यामि विधानं पश्य यादृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2025254, "chapter_id": 1543, "verse_number": "३-१८१-१६", "content_sanskrit": "न हि मे मुच्यते कश्चित्कथंचित्प्रग्रहं गतः।\nगचजोवा महिषो वाऽपि षष्ठे काले नरोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2025255, "chapter_id": 1543, "verse_number": "३-१८१-१७", "content_sanskrit": "नासि केवलसर्पेण तिर्यग्योनिषु वर्तता।\nगृहीतः कौरवश्रेष्ठ वरदानमिदं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2025256, "chapter_id": 1543, "verse_number": "३-१८१-१८", "content_sanskrit": "पतता हि विमानाग्रान्मया शक्रासनाद्द्रुतम्।\nकुरु शापान्तमित्युक्तो भगवान्मुनिसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2025257, "chapter_id": 1543, "verse_number": "३-१८१-१९", "content_sanskrit": "`यस्त्वया वेष्टितो राजन्मोहमेति महाबलः।\nमोक्षस्ते भविता राजन्कस्माच्चित्कालपर्ययात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2025258, "chapter_id": 1543, "verse_number": "३-१८१-२०", "content_sanskrit": "ततोस्मि पतितो भूमौ न च मामजहात्स्मृतिः।\nस्मार्तमस्ति पुराणं मे यथैवाधिगतं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2025259, "chapter_id": 1543, "verse_number": "३-१८१-२१", "content_sanskrit": "यस्तु ते व्याहृतान्प्रश्नान्प्रतिब्रूयाद्विभागवित्।\nस त्वां मोक्षयिता शापादिति मामब्रवीदृषिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2025260, "chapter_id": 1543, "verse_number": "३-१८१-२२", "content_sanskrit": "गृहीतस्य त्वया राजन्प्राणिनोपि बलीयसः।\nसत्वभ्रंशोऽधिकस्यापि सर्वस्याशु भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2025261, "chapter_id": 1543, "verse_number": "३-१८१-२३", "content_sanskrit": "इतिचाप्यहमश्रौषं वचस्तेषां दयावताम्।\nमयि संजातहार्दानामथ तेऽन्तर्हिता द्विजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2025262, "chapter_id": 1543, "verse_number": "३-१८१-२४", "content_sanskrit": "सोहं परमदुष्कर्मा वसामि निरयेऽशुचौ।\nसर्पयोनिमिमां प्राप्यकालाकाङ्क्षी महाद्युते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2025263, "chapter_id": 1543, "verse_number": "३-१८१-२५", "content_sanskrit": "तमुवाच महाबाहुर्भीमसेनो भुजङ्गमम्।\nन ते कुप्ये महासर्प नात्मने द्विजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2025264, "chapter_id": 1543, "verse_number": "३-१८१-२६", "content_sanskrit": "यस्मादभावी भावी वा मनुष्यः सुखदुःखयोः।\nआगमे यदि वाऽपाये न तत्र ग्लपयेन्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2025265, "chapter_id": 1543, "verse_number": "३-१८१-२७", "content_sanskrit": "दैवं पुरुषकारेण को वञ्चयितुमर्हति।\nदैवमेव परं मन्ये पौरुषं तु निरर्थकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2025266, "chapter_id": 1543, "verse_number": "३-१८१-२८", "content_sanskrit": "पश्य दैवोपघाताद्धि भुजवीर्यव्यपाश्रयम्।\nइमामवस्थां संप्राप्तमनिमित्तमिहाद्य माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2025267, "chapter_id": 1543, "verse_number": "३-१८१-२९", "content_sanskrit": "किंतु नाद्यानुशोचामि तथाऽऽत्मानं विनाशितम्।\nतथा तु विपिने न्यस्तान्भ्रातॄन्राज्यपरिच्युतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2025268, "chapter_id": 1543, "verse_number": "३-१८१-३०", "content_sanskrit": "हिमवांश्च सुदुर्गोऽयं यक्षराक्षससंकुलः।\nमां समुद्वीक्षमाणास्ते प्रयतिष्यन्ति विह्वलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2025269, "chapter_id": 1543, "verse_number": "३-१८१-३१", "content_sanskrit": "विनष्टमथ मां श्रुत्वा भविष्यन्ति निरुद्यमाः।\nधर्मशीला मया ते हि बाध्यन्ते राज्यगृद्धिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2025270, "chapter_id": 1543, "verse_number": "३-१८१-३२", "content_sanskrit": "अथवा नार्जुनो धीमान्विषादमुपयास्यति।\nसर्वास्त्रविदनाधृष्यो देवगन्धर्वराक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2025271, "chapter_id": 1543, "verse_number": "३-१८१-३३", "content_sanskrit": "समर्थः स महाबाहुरेकाङ्ना सुमहाबलः।\nदेवराजमपि स्थानात्प्रच्यावयितुमञ्जसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2025272, "chapter_id": 1543, "verse_number": "३-१८१-३४", "content_sanskrit": "किं पुनर्धृतराष्ट्रस् पुत्रं दुर्द्यूतदेविनम्।\nविद्विष्टं सर्वलोकस्य दम्भमोहपरायणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2025273, "chapter_id": 1543, "verse_number": "३-१८१-३५", "content_sanskrit": "मातरं चैव शोचामि कृपणां पुत्रगृद्धिनीम्।\nयाऽस्माकं नित्यमाशास्ते महत्त्वमधिकं परैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2025274, "chapter_id": 1543, "verse_number": "३-१८१-३६", "content_sanskrit": "तस्याः कथं त्वनाथाया मद्विनाशाद्भुजङ्गम्।\nसफलास्ते भविष्यन्ति मयि सर्वे मनोरथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2025275, "chapter_id": 1543, "verse_number": "३-१८१-३७", "content_sanskrit": "नकुलः सहदेवश्च यमौ च गुरुवर्तिनौ।\nमद्वाहुबलसंगुप्तौ नित्यं पुरुषमानिनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2025276, "chapter_id": 1543, "verse_number": "३-१८१-३८", "content_sanskrit": "भविष्यतो निरुत्साहौ भ्रष्टवीर्यपराक्रमौ।\nमद्विनाशात्परिद्यूनाविति मे वर्तते मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2025277, "chapter_id": 1543, "verse_number": "३-१८१-३९", "content_sanskrit": "एवंविधं बहु तदा विललाप वृकोदरः।\nभुजङ्गभोगसंरुद्धो नाशकच्च विचेष्टितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2025278, "chapter_id": 1543, "verse_number": "३-१८१-४०", "content_sanskrit": "युधिष्ठिरस्तु कौन्तेयो बभूवास्वस्तचेतनः।\nअनिष्टदर्शनान्घोरानुत्पातान्परिचिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2025279, "chapter_id": 1543, "verse_number": "३-१८१-४१", "content_sanskrit": "दारुणं ह्यशिवं नादं शिवा दक्षिणतः स्थिता।\nदीप्तायां दिशि वित्रस्ता रौति तस्याश्रमस्य ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2025280, "chapter_id": 1543, "verse_number": "३-१८१-४२", "content_sanskrit": "एकपक्षाक्षिचरणा वर्तिका घोरदर्शना।\nरक्तं वमन्ती ददृशे प्रत्यादित्यमभासुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2025281, "chapter_id": 1543, "verse_number": "३-१८१-४३", "content_sanskrit": "प्रववौ चानिलो रूक्षश्चण्डः सर्करकर्षणः।\nअपसव्यानि सर्वाणि मृगपक्षिरुतानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2025282, "chapter_id": 1543, "verse_number": "३-१८१-४४", "content_sanskrit": "पृष्ठतो वायसः कृष्णो याहियाहीति वाशति।\nमुहुर्मुहुः स्फुरति च दक्षिणोऽस्य भुजस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2025283, "chapter_id": 1543, "verse_number": "३-१८१-४५", "content_sanskrit": "हृदयं चरणश्चापि वामोऽस्य परितप्यति।\nसव्यस्याक्ष्णओ विकारश्चाप्यनिष्टः समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2025284, "chapter_id": 1543, "verse_number": "३-१८१-४६", "content_sanskrit": "धर्मराजोपि मेधावी शङ्कमानो महद्भयम्।\nद्रौपदीं परिपप्रच्छ क्व भीम इति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2025285, "chapter_id": 1543, "verse_number": "३-१८१-४७", "content_sanskrit": "शंस तस्मै पाञ्चाली चिरयातं वृकोदरम्।\nस प्रतस्थे महाबाहुर्धौम्येन सहितो नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2025286, "chapter_id": 1543, "verse_number": "३-१८१-४८", "content_sanskrit": "द्रौपद्या रक्षणं कार्यमित्युवाच धनंजयम्।\nनकुलं सहदेवं च व्यादिदेश द्विजान्प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2025287, "chapter_id": 1543, "verse_number": "३-१८१-४९", "content_sanskrit": "स तस्य पदमुन्नीय तस्मादेवाश्रमात्प्रभुः।\nमृगयामास कौन्तेयो भीमसेनं महावने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2025288, "chapter_id": 1543, "verse_number": "३-१८१-५०", "content_sanskrit": "स प्राचीं दिशमास्थाय महतो गजयूथपान्।\nददर्श पृथिवीं चिह्नैर्भीमस्य परिचिह्निताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2025289, "chapter_id": 1543, "verse_number": "३-१८१-५१", "content_sanskrit": "ततो मृगसहस्राणि मृगेनद्राणां शतानि च।\nपतितानि वने दृष्ट्वा मार्गं तस्याविशन्नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2025290, "chapter_id": 1543, "verse_number": "३-१८१-५२", "content_sanskrit": "धावतस्तस्य वीरस् मृगार्थं वातरंहसः।\nऊरुवातविनिर्भग्नान्द्रुमान्व्यावर्जितान्पथिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2025291, "chapter_id": 1543, "verse_number": "३-१८१-५३", "content_sanskrit": "स गत्वा तैस्तदा चिह्नैर्ददर्श गिरिगह्वरे।\n[रूक्षमारुतभूयिष्ठे निष्पत्रद्रुमसंकुले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2025292, "chapter_id": 1543, "verse_number": "३-१८१-५४", "content_sanskrit": "ईरिणे निर्जले देशे कण्टकिद्रुमसंकुले।\nअश्मस्थाणुक्षुपाकीर्णे सुदुर्गे विषमोत्कटे।]\nगृहीतं भुजगेन्द्रेण निश्चेष्टमनुजं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2025293, "chapter_id": 1543, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि आजागरपर्वणि एकाशीत्यधिकशततमोऽध्यायः ॥ १८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]