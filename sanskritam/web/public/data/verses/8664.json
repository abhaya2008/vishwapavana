[{"id": 900008642, "chapter_id": 8664, "verse_number": "45.1", "content_sanskrit": "अत्र सुधायां पूर्वं श्रुतिसंवादितया..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008643, "chapter_id": 8664, "verse_number": "45.2", "content_sanskrit": "अत्र विष्णोर्जगत्कर्तृत्वादिकं युक्तिविरुद्धमुत नेति चिन्ता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008644, "chapter_id": 8664, "verse_number": "45.3", "content_sanskrit": "सिद्धान्तमाह", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008645, "chapter_id": 8664, "verse_number": "45.4", "content_sanskrit": "यदुक्तं परैः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]