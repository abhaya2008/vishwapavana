[{"id": 2076480, "chapter_id": 2620, "verse_number": "१२-१२५-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2076481, "chapter_id": 2620, "verse_number": "१२-१२५-१", "content_sanskrit": "शीलं प्रधानं पुरुषे कथितं ते पितामह।\nकथमाशा समुत्पन्ना का च सा तद्वदस्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2076482, "chapter_id": 2620, "verse_number": "१२-१२५-२", "content_sanskrit": "संशयो मे महानेष समुत्पन्नः पितामह।\nछेत्ता च तस्य नान्योऽस्ति त्वत्तः परपुरंजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2076483, "chapter_id": 2620, "verse_number": "१२-१२५-३", "content_sanskrit": "पितामहाशा महती ममासीद्धि सुयोधने।\nप्राप्ते युद्धे तु तद्युक्तं तत्कर्ताऽयमिति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2076484, "chapter_id": 2620, "verse_number": "१२-१२५-४", "content_sanskrit": "सर्वस्याशा सुमहती पुरुषस्योपजायते।\nस्यां विहन्यमानायां दुःखो मृत्युर्न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2076485, "chapter_id": 2620, "verse_number": "१२-१२५-५", "content_sanskrit": "ऽहं हताशो दुर्बुद्धिः कृतस्तेन दुरात्मना।\nर्तराष्ट्रेण राजेन्द्र पश्य मन्दात्मतां मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2076486, "chapter_id": 2620, "verse_number": "१२-१२५-६", "content_sanskrit": "आशां बृहत्तरीं मन्ये पर्वतादपि सद्रुमात्।\nआकाशादपि वा राजन्नप्रमेयाऽथवा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2076487, "chapter_id": 2620, "verse_number": "१२-१२५-७", "content_sanskrit": "एषा चैव कुरुश्रेष्ठ दुर्विचिन्त्या सुदुर्लभा।\nदुर्लभत्वाच्च पश्यामि किमन्यद्दुर्लभं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2076488, "chapter_id": 2620, "verse_number": "१२-१२५-८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2076489, "chapter_id": 2620, "verse_number": "१२-१२५-८", "content_sanskrit": "अत्र ते वर्तयिष्यामि युधिष्ठिर निबोध मे।\nइतिहासं सुमित्रस्य निर्वृत्तमृषभस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2076490, "chapter_id": 2620, "verse_number": "१२-१२५-९", "content_sanskrit": "सुमित्रो नाम राजर्षिर्हैहयो मृगयां गतः।\nससार च मृगं विद्ध्वा बाणेनानतपर्वणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2076491, "chapter_id": 2620, "verse_number": "१२-१२५-१०", "content_sanskrit": "स मृगो बाणमादाय ययावतिपराक्रमः।\nस च राजा बली तूर्णं ससार मृगमन्तिकात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2076492, "chapter_id": 2620, "verse_number": "१२-१२५-११", "content_sanskrit": "ततो निम्नं स्थलं चैव समृगोऽद्रवदाशुगः।\nमुहूर्तमिव राजेन्द्र समेन स पथाऽगमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2076493, "chapter_id": 2620, "verse_number": "१२-१२५-१२", "content_sanskrit": "ततः स राजा तारुण्यादौरसन बलेन च।\nचचार बाणासनभृत्सखङ्गो हंसवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2076494, "chapter_id": 2620, "verse_number": "१२-१२५-१३", "content_sanskrit": "ततो नदान्नदीश्चैव पल्वलानि वनानि च।\nअतिक्रम्याभ्यतिक्रम्य ससारैको वनेचरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2076495, "chapter_id": 2620, "verse_number": "१२-१२५-१४", "content_sanskrit": "स तु तावन्मृगो राजन्नासाद्यासाद्य पार्थिवम्।\nपुनरभ्येति जवनो जवेन महता ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2076496, "chapter_id": 2620, "verse_number": "१२-१२५-१५", "content_sanskrit": "स तस्य बाणैर्बहुभिः समभ्यस्तो वनेचरः।\nप्रक्रीडन्निव राजेन्द्र पुनरभ्येति चान्तिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2076497, "chapter_id": 2620, "verse_number": "१२-१२५-१६", "content_sanskrit": "पुनश्च जवमास्थाय जवनो मृगयूथपः।\n[अतीत्यातीत्य राजेन्द्र पुनरभ्येति चान्तिकम्॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2076498, "chapter_id": 2620, "verse_number": "१२-१२५-१७", "content_sanskrit": "तस्य मर्मच्छिदं घोरं सुमित्रोऽमित्रकर्शनः।\nसमादाय शरं श्रेष्ठं कार्मुकान्निरवासयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2076499, "chapter_id": 2620, "verse_number": "१२-१२५-१८", "content_sanskrit": "[ततो गव्यूतिमात्रेण मृगयूथपयूथपः।]\nतस्य बाणपथं मुक्त्वा तस्थिवान्प्रहसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2076500, "chapter_id": 2620, "verse_number": "१२-१२५-१९", "content_sanskrit": "तस्मिन्निपतिते बाणे भूमौ ज्वलिततेजसि।\nप्रविवेश मृगोऽरण्यं मृगं राजाऽप्यभिद्रवत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2076501, "chapter_id": 2620, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि पञ्चविंशत्यधिकशततमोऽध्यायः॥ १२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]