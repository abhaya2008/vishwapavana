[{"id": 6000293000, "chapter_id": 10293, "verse_number": null, "content_sanskrit": "अथ सप्तनवतितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000293001, "chapter_id": 10293, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.001.m4a", "display_order": 2}, {"id": 6000293002, "chapter_id": 10293, "verse_number": "१०-९७-१", "content_sanskrit": "सभाजयित्वा बहुधा श्रुतदेवं श्रियःपतिः।\nआगतो द्वारकां भूयः किं चकार महामुने॥ १०/९७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.002.m4a", "display_order": 3, "topics": [{"text": "पाण्डवान् समाप्तवनवासान् श्रुत्वा कृष्णस्य शक्रप्रस्थगमनम्", "range": "१–४"}]}, {"id": 6000293003, "chapter_id": 10293, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.003.m4a", "display_order": 4}, {"id": 6000293004, "chapter_id": 10293, "verse_number": "१०-९७-२", "content_sanskrit": "उपप्लाव्यं गतान् पार्थान् गोग्रहे जितकौरवान्।\nशुश्राव तीर्णसमयान् बलेन महता वृतान्॥ १०/९७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.004.m4a", "display_order": 5}, {"id": 6000293005, "chapter_id": 10293, "verse_number": "१०-९७-३", "content_sanskrit": "सम्प्रहृष्टमनाः कृष्णो महत्या सेनया वृतः।\nसात्यकिं कृतवर्माणमुद्धवं शठसारणौ॥ १०/९७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.005.m4a", "display_order": 6}, {"id": 6000293006, "chapter_id": 10293, "verse_number": "१०-९७-४", "content_sanskrit": "अभिमन्युं च सौभद्रं पुरस्कृत्य महामतिः। अक्षौहिण्या पृतनया सहितः सत्यसङ्गरः।\nशङ्खदुन्दुभिनिर्घोषैर्द्रष्टुं प्रायाद् युधिष्ठिरम्॥ १०/९७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.006.m4a", "display_order": 7}, {"id": 6000293007, "chapter_id": 10293, "verse_number": "१०-९७-५", "content_sanskrit": "सन्धिमिच्छन् कौरवाणां कुर्वाणं दौत्यमच्युतम्।\nमूढो ग्रहीतुमारेभे विनशिष्णुः सुयोधनः॥ १०/९७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.007.m4a", "display_order": 8, "topics": [{"text": "ततो दौत्यकरणम्,दुर्योधनस्य दुर्बुद्धिः", "range": "५"}]}, {"id": 6000293008, "chapter_id": 10293, "verse_number": "१०-९७-६", "content_sanskrit": "स तत्रानन्तरूपत्वं दर्शयित्वा महाभुजः।\nकृत्वा विभीषिकां घोरां पाण्डवान् पुनराययौ॥ १०/९७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.008.m4a", "display_order": 9, "topics": [{"text": "भारतयुद्धं दुर्योधनविनाशश्च", "range": "६–३९"}]}, {"id": 6000293009, "chapter_id": 10293, "verse_number": "१०-९७-७", "content_sanskrit": "विवृद्धमत्सराः सर्वे राजानो जातमन्यवः।\nयुद्धायैवानुयुज्यन्ते न सन्धिमनुकाङ्क्षिणः॥ १०/९७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.009.m4a", "display_order": 10}, {"id": 6000293010, "chapter_id": 10293, "verse_number": "१०-९७-८", "content_sanskrit": "युधिष्ठिरस्तु धर्मात्मा पुरस्कृत्य जनार्दनम्।\nकुरुक्षेत्रं ययौ राजन् युद्धाय भ्रातृभिः सह॥ १०/९७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.010.m4a", "display_order": 11}, {"id": 6000293011, "chapter_id": 10293, "verse_number": "१०-९७-९", "content_sanskrit": "अक्षौहिण्या विराटोऽपि मत्स्यराजो महामनाः।\nयुधिष्ठिरमनु प्रायात् सपुत्रः कुरुसत्तम॥ १०/९७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.011.m4a", "display_order": 12}, {"id": 6000293012, "chapter_id": 10293, "verse_number": "१०-९७-१०", "content_sanskrit": "द्रुपदश्च शिखण्डी च धृष्टद्युम्नश्च दुर्जयः।\nअक्षौहिणीभिस्तिसृभिरनुजग्मुर्युधिष्ठिरम्॥ १०/९७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.012.m4a", "display_order": 13}, {"id": 6000293013, "chapter_id": 10293, "verse_number": "१०-९७-११", "content_sanskrit": "अक्षौहिण्या परिवृतः सात्यकिर्युद्धलालसः।\nनियोगाद् वासुदेवस्य प्रायादनु युधिष्ठिरम्॥ १०/९७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.013.m4a", "display_order": 14}, {"id": 6000293014, "chapter_id": 10293, "verse_number": "१०-९७-१२", "content_sanskrit": "अक्षौहिण्या परिवृताः कैकेयाः पञ्च भूभृतः।\nअनुजग्मुर्धर्मपुत्रं राजानं मातृसोदराः॥ १०/९७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.014.m4a", "display_order": 15}, {"id": 6000293015, "chapter_id": 10293, "verse_number": "१०-९७-१३", "content_sanskrit": "धृष्टकेतुस्तदा राजा शैब्यश्च नरपुङ्गवः॥ १०/९७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.015.m4a", "display_order": 16}, {"id": 6000293016, "chapter_id": 10293, "verse_number": "१०-९७-१४", "content_sanskrit": "अन्वयातां नृपश्रेष्ठावक्षौहिण्या युधिष्ठिरम्।\nते गत्वा पाण्डवाः सर्वे नारायणपुरोगमाः॥ १०/९७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.016.m4a", "display_order": 17}, {"id": 6000293017, "chapter_id": 10293, "verse_number": "१०-९७-१५", "content_sanskrit": "स्वैैरमूषुः कुरुक्षेत्रे प्रतीक्षन्तः सुयोधनम्। सुयोधनोऽपि कौरव्य मानी भ्रातृशतैर्वृतः।\nद्रोणभीष्मकृपद्रौणिकर्णबाह्लीकसौबलैः॥ १०/९७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.017.m4a", "display_order": 18}, {"id": 6000293018, "chapter_id": 10293, "verse_number": "१०-९७-१६", "content_sanskrit": "हार्दिक्यसाल्वमद्रेशभगदत्तजयद्रथैः।\nअन्यैश्च राजशार्दूलैर्नानादेशसमुद्भवैः॥ १०/९७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.018.m4a", "display_order": 19}, {"id": 6000293019, "chapter_id": 10293, "verse_number": "१०-९७-१७", "content_sanskrit": "शङ्खदुन्दुभिनिर्घोषैर्भेरीपणवनिःस्वनैः।\nपूरयन् ककुभो वीरः प्रययौ कम्पयन् महीम्॥ १०/९७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.019.m4a", "display_order": 20}, {"id": 6000293020, "chapter_id": 10293, "verse_number": "१०-९७-१८", "content_sanskrit": "ते समेत्य कुरुक्षेत्रे राजानो कुरुपाण्डवाः।\nस्यमन्तपञ्चके चक्रुर्व्यूहमुद्यति भास्करे॥ १०/९७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.020.m4a", "display_order": 21}, {"id": 6000293021, "chapter_id": 10293, "verse_number": "१०-९७-१९", "content_sanskrit": "अक्षौहिण्यः कौरवाणामेकादश दुरात्मनाम्।\nसप्त पाण्डुसुतानां च कर्शितानां वने भृशम्॥ १०/९७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.021.m4a", "display_order": 22}, {"id": 6000293022, "chapter_id": 10293, "verse_number": "१०-९७-२०", "content_sanskrit": "तथा व्यूहेष्वनीकेषु तावकेष्वितरेषु च। गाण्डीवधन्वा कवची बद्धतूणतलत्रवान्।\nआरूढस्यन्दनः पार्थो ददर्श रिपुवाहिनीम्॥ १०/९७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.022.m4a", "display_order": 23}, {"id": 6000293023, "chapter_id": 10293, "verse_number": "१०-९७-२१", "content_sanskrit": "उपाध्यायान् पितॄन् भ्रातॄन् मातुलान् स्वस्रियान् सुतान्।\nशिष्यान् सपौत्रान् दौहित्रान् शालान् सम्बन्धिबान्धवान्।\nदृष्ट्वा निर्वेदमापन्नो हन्तुं नैवाकरोन्मनः॥ १०/९७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.023.m4a", "display_order": 24}, {"id": 6000293024, "chapter_id": 10293, "verse_number": "१०-९७-२२", "content_sanskrit": "तं विषण्णमनश्चित्तं कृपालुमविघातिनम्।\nप्रबोध्य प्रेरयामास केशवो योगमायया॥ १०/९७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.024.m4a", "display_order": 25}, {"id": 6000293025, "chapter_id": 10293, "verse_number": "१०-९७-२३", "content_sanskrit": "त्यक्तशस्‍त्राय शान्ताय बन्धून् प्रति कृपालवे।\nदर्शयामास पार्थाय विश्वरूपं जनार्दनः॥ १०/९७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.025.m4a", "display_order": 26}, {"id": 6000293026, "chapter_id": 10293, "verse_number": "१०-९७-२४", "content_sanskrit": "सम्बोधितः कंसभिदा तथा वासवनन्दनः।\nभूयो जग्राह कोदण्डं युद्धायाच्युतसारथिः॥ १०/९७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.026.m4a", "display_order": 27}, {"id": 6000293027, "chapter_id": 10293, "verse_number": "१०-९७-२५", "content_sanskrit": "प्रारब्धं भारतं युद्धं श्रुत्वा सङ्कर्षणो बली।\nअशक्नुवन् वारयितुं किं करोमीत्यचिन्तयत्॥ १०/९७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.027.m4a", "display_order": 28}, {"id": 6000293028, "chapter_id": 10293, "verse_number": "१०-९७-२६", "content_sanskrit": "प्रवृत्तं भारतं युद्धमवेक्ष्योद्योगविह्वलः।\nतीर्थव्याजेन तत्याज रामः परिचितां भुवम्॥ १०/९७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.028.m4a", "display_order": 29}, {"id": 6000293029, "chapter_id": 10293, "verse_number": "१०-९७-२७", "content_sanskrit": "सेनापतिः पाण्डवानां धृष्टद्युम्नो महारथः। गाङ्गेयो धार्तराष्ट्राणां वृद्धः कुरुपितामहः।\nस कुर्वन्नाहवं घोरं निहतो दशमेऽहनि॥ १०/९७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.029.m4a", "display_order": 30}, {"id": 6000293030, "chapter_id": 10293, "verse_number": "१०-९७-२८", "content_sanskrit": "भारद्वाजं ततो द्रोणं सैनापत्ये सुयोधनः।\nन्ययोजयत् स युयुजे दिवसान् पञ्च भूपते॥ १०/९७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.030.m4a", "display_order": 31}, {"id": 6000293031, "chapter_id": 10293, "verse_number": "१०-९७-२९", "content_sanskrit": "तस्मिन् युध्यति दुर्धर्षे सैन्धवेन दुरात्मना।\nअभिमन्युस्तव पिता निहतो रणमूर्द्धनि॥ १०/९७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.031.m4a", "display_order": 32}, {"id": 6000293032, "chapter_id": 10293, "verse_number": "१०-९७-३०", "content_sanskrit": "पुत्रशोकाभिसन्तप्तः प्रतिजज्ञे धनञ्जयः।\nजयद्रथं हनिष्यामि श्वोभूत इति भारत॥ १०/९७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.032.m4a", "display_order": 33}, {"id": 6000293033, "chapter_id": 10293, "verse_number": "१०-९७-३१", "content_sanskrit": "तस्यां निशायां गोविन्दस्त्वारुह्य गरुडं हरिः।\nसुप्तमर्जुनमादाय कैलासमभिजग्मिवान्॥ १०/९७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.033.m4a", "display_order": 34}, {"id": 6000293034, "chapter_id": 10293, "verse_number": "१०-९७-३२", "content_sanskrit": "तत्र गत्वा विरूपाक्षं दृष्ट्वा सम्भाष्य वाञ्छितम्।\nसाधयित्वाऽर्जुनस्याशु स्वायोधनमुपाययौ॥ १०/९७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.034.m4a", "display_order": 35}, {"id": 6000293035, "chapter_id": 10293, "verse_number": "१०-९७-३३", "content_sanskrit": "ततोऽपरदिने युद्धमासीद् घोरं जनक्षयः ।\nमम्रुर्महीभुजस्तत्र बहवो बाहुशालिनः॥ १०/९७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.035.m4a", "display_order": 36}, {"id": 6000293036, "chapter_id": 10293, "verse_number": "१०-९७-३४", "content_sanskrit": "हतेषु रणदक्षेषु राजपुत्रेष्वनेकशः।\nजयद्रथोऽपि पार्थेन निहतो दिवसात्यये॥ १०/९७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.036.m4a", "display_order": 37}, {"id": 6000293037, "chapter_id": 10293, "verse_number": "१०-९७-३५", "content_sanskrit": "दिनानि पञ्च द्रोणोऽपि कृत्वा युद्धमतन्द्रितः।\nपञ्चमेऽहनि सन्ध्यायां धृष्टद्युम्नेन पातितः॥ १०/९७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.037.m4a", "display_order": 38}, {"id": 6000293038, "chapter_id": 10293, "verse_number": "१०-९७-३६", "content_sanskrit": "ततः सेनापतिः कर्णो भूत्वा चक्रे महारणम्।\nदिनद्वयान्ते पार्थेन स च सङ्ख्ये निपातितः॥ १०/९७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.038.m4a", "display_order": 39}, {"id": 6000293039, "chapter_id": 10293, "verse_number": "१०-९७-३७", "content_sanskrit": "शल्योऽप्यर्धदिनं कृत्वा सैनापत्यमरिन्दम।\nमध्यन्दिनगते सूर्ये धर्मराजेन पातितः॥ १०/९७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.039.m4a", "display_order": 40}, {"id": 6000293040, "chapter_id": 10293, "verse_number": "१०-९७-३८", "content_sanskrit": "युयुधाते ततो वीरौ गदया दीर्घवैरिणौ।\nभीमदुर्योधनौ कोपात् परस्परवधैषिणौ॥ १०/९७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.040.m4a", "display_order": 41}, {"id": 6000293041, "chapter_id": 10293, "verse_number": "१०-९७-३९", "content_sanskrit": "अष्टादशाक्षौहिणीनां तत्पतीनां च भूभृताम्।\nअष्टादशैर्दिनैरासीदर्धोनैः सङ्क्षयो महान्॥ १०/९७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_097/BhP_10.097.041.m4a", "display_order": 42}, {"id": 6000293042, "chapter_id": 10293, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे सप्तनवतितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]