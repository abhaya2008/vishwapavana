[{"id": 2100357, "chapter_id": 3152, "verse_number": "१४-८-१", "content_sanskrit": "संवर्त उवाच।\nगिरेर्हिमवतः पृष्ठे मुञ्जवान्नाम पर्वतः।\nतप्यते यत्र भगवांस्तपो नित्यमुपापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2100358, "chapter_id": 3152, "verse_number": "१४-८-२", "content_sanskrit": "वनस्पतीनां मूलेषु शृङ्गेषु विषमेषु च।\nगुहासु शैलराजस्य यथाकामं यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2100359, "chapter_id": 3152, "verse_number": "१४-८-३", "content_sanskrit": "उमासहायो भगवान्यत्र नित्यं महेश्वरः।\nआस्ते शूली महातेजा नानाभूतगणावृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2100360, "chapter_id": 3152, "verse_number": "१४-८-४", "content_sanskrit": "तत्र रुद्राश्च साध्याश्च विश्वेऽथ वसवस्तथा।\nयमश्च वरुणश्चैव कुबेरश्च सहानुगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2100361, "chapter_id": 3152, "verse_number": "१४-८-५", "content_sanskrit": "भूतानि च पिशाचाश्च नासत्यावपि चाश्विनौ।\nगन्धऱ्वाप्सरसश्चैव यक्षा देवर्षयस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2100362, "chapter_id": 3152, "verse_number": "१४-८-६", "content_sanskrit": "आदित्या मरुतश्चैव यातुधानाश्च सर्वशः।\nउपासन्ते महात्मानं बहुरूपमुपापतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2100363, "chapter_id": 3152, "verse_number": "१४-८-७", "content_sanskrit": "रमते भगवांस्तत्र कुबेरानुचरैः सह।\nविकृतैर्विकृताकारैः क्रीडद्भिः पृथिवीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2100364, "chapter_id": 3152, "verse_number": "१४-८-८", "content_sanskrit": "श्रिया ज्वलन्दृश्यते वै बालादित्यसमद्युतिः।\nन रूपं शक्यते तस्य संस्थानं वा कदाचन।\nनिर्देष्टुं प्राणिभिः कैश्चित्प्राकृतैर्मांसलोचनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2100365, "chapter_id": 3152, "verse_number": "१४-८-९", "content_sanskrit": "नोष्णं न शिशिरं तत्र न वायुर्न च भास्करः।\nन जारा क्षुत्पिपासे वा न मृत्युर्न भयं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2100366, "chapter_id": 3152, "verse_number": "१४-८-१०", "content_sanskrit": "तस्य शैलस्य पार्श्वेषु सर्वेषु जयतांवर।\nधातवो जातरूपस्य रश्मयः सवितुर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2100367, "chapter_id": 3152, "verse_number": "१४-८-११", "content_sanskrit": "रक्ष्यन्ते ते कुबेरस्य सहायैरुद्यतायुधैः।\nचिकीर्षद्भिः प्रियं राजन्कुबेरस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2100368, "chapter_id": 3152, "verse_number": "१४-८-१२", "content_sanskrit": "`तत्र गत्वा समन्वास्य महायोगेश्वरं शिवम्।\nकुरु प्रणामं राजर्षे भक्त्या परमया यतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2100369, "chapter_id": 3152, "verse_number": "१४-८-१३", "content_sanskrit": "तस्मै भगवते कृत्वा नमः शर्वाय वेधसे।\n`एभिस्तं नामभिर्देवं सर्वविद्याधरं स्तुहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2100370, "chapter_id": 3152, "verse_number": "१४-८-१४", "content_sanskrit": "रुद्राय शितिकण्ठाय सुरूपाय सुवर्चसे।\nकपर्दिने करालाय हर्यक्ष्णे वरदाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2100371, "chapter_id": 3152, "verse_number": "१४-८-१५", "content_sanskrit": "त्र्यक्ष्णे पूष्णो दन्तभिदे वामनाय शिवाय च।\nयाम्यायाव्यक्तरूपाय सद्वृत्ते शङ्कराय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2100372, "chapter_id": 3152, "verse_number": "१४-८-१६", "content_sanskrit": "क्षेम्याय हरिकेशाय स्थाणवे पुरुषाय च।\nहरिनेत्राय मुण्डाय क्रुद्धायोत्तरणाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2100373, "chapter_id": 3152, "verse_number": "१४-८-१७", "content_sanskrit": "भास्वराय सुतीर्थाय देवदेवाय रंहसे।\nउष्णीषिणे सुवक्त्राय सहस्राक्षाय मीढुषे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2100374, "chapter_id": 3152, "verse_number": "१४-८-१८", "content_sanskrit": "गिरिशाय प्राशान्ताय यतये चीरवाससे।\nबिल्वदण्डाय सिद्धाय सर्वदण्डधराय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2100375, "chapter_id": 3152, "verse_number": "१४-८-१९", "content_sanskrit": "मृगव्याधाय महते धन्विनेऽथ भवाय च।\nवराय सोमवक्त्राय सिद्धमन्त्राय चक्षुषे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2100376, "chapter_id": 3152, "verse_number": "१४-८-२०", "content_sanskrit": "हिरण्यबाहवे राजन्नुग्राय पतये दिशाम्।\nलेलिहानाय गोष्ठाय सिद्धमन्त्राय वृष्णये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2100377, "chapter_id": 3152, "verse_number": "१४-८-२१", "content_sanskrit": "पशूनां पतये चैव भूतानां पतये नमः।\nवृषाय मातृभक्ताय सेनान्ये मध्यमाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2100378, "chapter_id": 3152, "verse_number": "१४-८-२२", "content_sanskrit": "`अभिवक्त्राय पतये सर्वदेवमयाय च।\nस्रुवहस्ताय पतये धन्विने भार्गवाय च।\nअजाय कृष्णनेत्राय विरूपाक्षाय चैव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2100379, "chapter_id": 3152, "verse_number": "१४-८-२३", "content_sanskrit": "तीक्ष्णदंष्ट्राय तीक्ष्णाय वैश्वानरमुखाय च।\nमहात्मने चानङ्गाय सर्वाय पतये विशाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2100380, "chapter_id": 3152, "verse_number": "१४-८-२४", "content_sanskrit": "`तथा रुद्राय पतये पृथवे कृत्तिवाससे।\nविलोहिताय दीप्ताय दीप्ताक्षाय महौजसे।\nवसुरेतःसुवपुषे पृथवे कृत्तिवाससे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2100381, "chapter_id": 3152, "verse_number": "१४-८-२५", "content_sanskrit": "कपालमालिने चैव सुवर्णमुकुटाय च।\nमहादेवाय कृष्णाय त्र्यम्बकायानघाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2100382, "chapter_id": 3152, "verse_number": "१४-८-२६", "content_sanskrit": "क्रोधनायानृशंसाय मृदवे बाहुशालिने।\nदण्डिने तप्ततपसे तथैवाक्रूरकर्मणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2100383, "chapter_id": 3152, "verse_number": "१४-८-२७", "content_sanskrit": "सहस्रशिरसे चैव सहस्रचरणाय च।\nनमः स्वधास्वरूपाय बहुरूपाय दंष्ट्रिणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2100384, "chapter_id": 3152, "verse_number": "१४-८-२८", "content_sanskrit": "पिनाकिनं महादेवं महाभोगिनमव्ययम्।\nत्रिशूलहस्तं वरदं त्र्यम्बकं भुवनेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2100385, "chapter_id": 3152, "verse_number": "१४-८-२९", "content_sanskrit": "त्रिपुरघ्नं त्रिनयनं त्रिलोकेशं महौजसम्।\nप्रभवं सर्वभूतानां दातारं धरणीधरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2100386, "chapter_id": 3152, "verse_number": "१४-८-३०", "content_sanskrit": "ईशानं शङ्करं सर्वं शिवं विश्वेश्वरं भवम्।\nउमापतिं पशुपतिं विश्वरूपं महेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2100387, "chapter_id": 3152, "verse_number": "१४-८-३१", "content_sanskrit": "विरूपाक्षं दशभुजं विष्यन्दं गोवृषध्वजम्।\nउग्रं स्थाणुं शिवं रौद्रं शर्वं गौरीशमीश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2100388, "chapter_id": 3152, "verse_number": "१४-८-३२", "content_sanskrit": "शितिकण्ठमजं शुक्रं पृथुं पृथुहरं वरम्।\nविश्वरूपं विरूपाक्षं बहुरूपमुपापतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2100389, "chapter_id": 3152, "verse_number": "१४-८-३३", "content_sanskrit": "प्रणम्य शिरसा देवमनङ्गाङ्गहरं हरम्।\nशरण्यं शरणं याहि महादेवं चतुर्मुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2100390, "chapter_id": 3152, "verse_number": "१४-८-३४", "content_sanskrit": "`विरोचमानं वपुषा दिव्याभरणभूषितम्।\nअनाद्यन्तमजं शंभुं सर्वव्यापिनमीश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2100391, "chapter_id": 3152, "verse_number": "१४-८-३५", "content_sanskrit": "निस्त्रैगुण्यं निरुद्वेगं निर्मलं निधिमोजसाम्।\nप्रणम्य प्राञ्जलिः शर्वं प्रयामि शरणं हरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2100392, "chapter_id": 3152, "verse_number": "१४-८-३६", "content_sanskrit": "सम्मान्यं निश्चलं नित्यमकारुण्यमलेपनम्।\nअध्यात्मवेदमासाद्य प्रयामि शरणं मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2100393, "chapter_id": 3152, "verse_number": "१४-८-३७", "content_sanskrit": "यस्य नित्यं विदुः स्थानं मोक्षमध्यात्मचिन्तकाः।\nयोगीशं तत्वमार्गस्थाः कैवल्यं पदमक्षरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2100394, "chapter_id": 3152, "verse_number": "१४-८-३८", "content_sanskrit": "यं विदुः सङ्गिनं मुक्ताः सामान्यं समदर्शिनः।\nतं प्रपद्ये जगद्योनिमयोनिं निर्गुणात्मकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2100395, "chapter_id": 3152, "verse_number": "१४-८-३९", "content_sanskrit": "असृजद्यस्तु भूतादीन्सप्त लोकान्सनातनान्।\nस्थितः सत्योपरि स्थाणुस्तं प्रपद्ये सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2100396, "chapter_id": 3152, "verse_number": "१४-८-४०", "content_sanskrit": "भक्तानां सुलभं तं हि दुर्लभं दूरपातिनाम्।\nअदूरस्थममुं देवं प्रकृतेः परतः स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2100397, "chapter_id": 3152, "verse_number": "१४-८-४१", "content_sanskrit": "नमामि सर्वलोकस्थं व्रजामि शरणं शिवम्।\nएवं कृत्वा नमस्तस्मै महादेवाय रंहसे।\nमहात्मने क्षितिपते तत्सुवर्णमवाप्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2100398, "chapter_id": 3152, "verse_number": "१४-८-४२", "content_sanskrit": "`लभन्ते गाणपत्यं च तदेकाग्रा हि मानवाः।\nकिं पुनः स्वर्णिभाण्डानि तस्मात्त्वं गच्छ मा चिरं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2100399, "chapter_id": 3152, "verse_number": "१४-८-४३", "content_sanskrit": "महत्तरं हि ते लाभं हस्त्यश्वोष्ट्रादिभिः सह।\nसुवर्णमाहरिष्यन्तस्तत्र गच्छन्तु ते नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2100400, "chapter_id": 3152, "verse_number": "१४-८-४४x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2100401, "chapter_id": 3152, "verse_number": "१४-८-४४", "content_sanskrit": "इत्युक्तः स वचस्तस्य चक्रे कारन्धमात्मजः।\n`गङ्गाधरं नमस्कृत्य लब्धवान्धनमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2100402, "chapter_id": 3152, "verse_number": "१४-८-४५", "content_sanskrit": "कुबेर इव तत्प्राप्य महादेवप्रसादतः।\nततोऽतिमानुषं सर्वं चक्रे यज्ञस्य संविधिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2100403, "chapter_id": 3152, "verse_number": "१४-८-४६", "content_sanskrit": "सौवर्णानि च भाण्डानि संचक्रुस्तत्र शिल्पिनः।\n`शालाश्च सर्वसम्भारांस्तत्र संवर्तशासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2100404, "chapter_id": 3152, "verse_number": "१४-८-४७", "content_sanskrit": "बृहस्पतिस्तु तां श्रुत्वा मरुत्तस्य महीपतेः।\nसमृद्धिमति देवेभ्यः सन्तापमकरोद्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2100405, "chapter_id": 3152, "verse_number": "१४-८-४८", "content_sanskrit": "सन्तप्यमानो वैवर्ण्यं कृशत्वं चागमत्परम्।\nभविष्यति हि मे शत्रुः संवर्तो वसुमानिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2100406, "chapter_id": 3152, "verse_number": "१४-८-४९", "content_sanskrit": "तं श्रुत्वा भृशसंतप्तं देवराजो बृहस्पतिम्।\nअभिगम्यामरवृतः प्रोवाचेदं वचस्तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2100407, "chapter_id": 3152, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अश्वमेधपर्वणि अष्टमोऽध्यायः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]