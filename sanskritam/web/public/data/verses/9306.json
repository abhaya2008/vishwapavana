[{"id": 40019239, "chapter_id": 9306, "verse_number": "1", "content_sanskrit": "तांतुपाश्वस्थितांप्रह्वांरामस्सम्प्रेक्ष्यमैथिलीम् । हृदयान्तर्गतंक्रोधव्याहर्तुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40019240, "chapter_id": 9306, "verse_number": "2", "content_sanskrit": "एषासिनिर्जिताभद्रेशत्रुंजित्वारणाजिरे । पौरुषाद्यदनुष्ठेयंमयैतदुपपादितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40019241, "chapter_id": 9306, "verse_number": "3", "content_sanskrit": "गतोऽस्म्यन्तममर्षस्यधर्षणासम्प्रमार्जिता । अवमानश्चशत्रुश्चयुगपन्निहतौमया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40019242, "chapter_id": 9306, "verse_number": "4", "content_sanskrit": "अद्यमेपौरुषंदृष्टमद्यमेसफल्श्रमः । अद्यतीर्णप्रतिज्ञोऽत्वाप्रभवाम्यद्यचात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40019243, "chapter_id": 9306, "verse_number": "5", "content_sanskrit": "यात्वंविरहितानीताचलचित्तेनरक्षसा । दैवसम्पादितोदोषोमानुषेणमयाजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40019244, "chapter_id": 9306, "verse_number": "6", "content_sanskrit": "सम्प्राप्तमवमानंयस्तेजसा न प्रमार्जति । कस्तस्यपुरुषार्थोमहताप्यल्पचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40019245, "chapter_id": 9306, "verse_number": "7", "content_sanskrit": "लङ्घनं च समुद्रस्यलङ्कायाश्चापिमर्धनम् । सफलंतस्य च श्लाघ्यमद्यकर्महनूमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40019246, "chapter_id": 9306, "verse_number": "8", "content_sanskrit": "युद्धेविक्रमतश्चैवहितंमन्त्रयतस्तथा । सुग्रीवस्यससैन्यस्यसफलोऽद्यपरिश्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40019247, "chapter_id": 9306, "verse_number": "9", "content_sanskrit": "विभीषणस्य च तथासफलोऽद्यपरिश्रमः । विगुणंभ्रातरंत्यक्त्वायोमांस्वयमुपस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40019248, "chapter_id": 9306, "verse_number": "10", "content_sanskrit": "इत्येवंवदत्श्रुत्वासीतारामस्यतद्वचः । मृगीवोत्फुल्लनयनाबभूवाश्रुपरिप्लुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40019249, "chapter_id": 9306, "verse_number": "11", "content_sanskrit": "पश्यतस्तांतुरामस्यसमीपेहृदयप्रियाम् । जनवादभयाद्राज्ञोबभूवहृदयंद्विधा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40019250, "chapter_id": 9306, "verse_number": "12", "content_sanskrit": "सीतामुत्पलपत्राक्षींनीलकुञ्चितमूर्थजाम् । अवदद्वैवरारोहंमध्येवानररक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40019251, "chapter_id": 9306, "verse_number": "13", "content_sanskrit": "यत्कर्तव्यंमनुष्येणधर्षणांप्रतिमार्जता । तत्कृतंरावणंहत्वामयेदंमानकाङ्क्षिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40019252, "chapter_id": 9306, "verse_number": "14", "content_sanskrit": "निर्जिताजीवलोकस्यतपसाभावितात्मना । अगस्त्येनदुराधर्षामुनिनादक्षिणेवधिक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40019253, "chapter_id": 9306, "verse_number": "15", "content_sanskrit": "विदितश्चास्तुभत्रंतेयोऽयंरणपरिश्रमः । सुतीर्णःसुहृदांवीर्यान्नत्वदर्थंमयाकृतः ॥ रक्षतातुमयावृत्तपमवादं च सर्वतः । प्रख्यातस्यात्मवंशस्यव्यङ्ग्यं च परिमार्जता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40019254, "chapter_id": 9306, "verse_number": "16", "content_sanskrit": "विदितश्चास्तुभत्रंतेयोऽयंरणपरिश्रमः । सुतीर्णःसुहृदांवीर्यान्नत्वदर्थंमयाकृतः ॥ रक्षतातुमयावृत्तपमवादं च सर्वतः । प्रख्यातस्यात्मवंशस्यव्यङ्ग्यं च परिमार्जता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40019255, "chapter_id": 9306, "verse_number": "17", "content_sanskrit": "प्राप्तचारित्रसन्देहाममप्रतिमुखेस्थिता । दीपोनेत्रातुरस्येवप्रतिकूलासिमेदृढम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40019256, "chapter_id": 9306, "verse_number": "18", "content_sanskrit": "तद्गच्छत्वानुजानेऽद्ययथेष्टंजनकात्मजे । एतादशदिशोभद्रेकार्यमस्ति न मेत्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40019257, "chapter_id": 9306, "verse_number": "19", "content_sanskrit": "कःपुमांस्तुकुलेजातस्स्त्रयंपरगृहाषिताम् । तेजस्वीपुनरादद्यात्सुहृल्लेख्येनचेतसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40019258, "chapter_id": 9306, "verse_number": "20", "content_sanskrit": "रावणाङ्कपरिक्लिष्टांदृष्टांदुष्टेनचक्षुषा । कथंत्वापुनरादद्यांकुलंव्यपदिशन् महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40019259, "chapter_id": 9306, "verse_number": "21", "content_sanskrit": "तदर्थंनिर्जितामेत्वंयशःप्रत्याहृतंमया । नास्तिमेत्यय्यभिष्वङ्गोयथेष्टंगम्यतामितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40019260, "chapter_id": 9306, "verse_number": "22", "content_sanskrit": "तदद्यव्याहृतंभद्रेमयैतत् कृतबुधदिना । लक्ष्मणेनाथभरतेकुरुबुधदिंयथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40019261, "chapter_id": 9306, "verse_number": "23", "content_sanskrit": "शत्रुघ्नेवाथसुग्रीवेराक्षसेवाविभीषणे । निवेशयमनस्सीतेयथावासुखमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40019262, "chapter_id": 9306, "verse_number": "24", "content_sanskrit": "न हित्वांरावणोदृष्टवादिव्यरूपांमनोरमाम् । मर्षयेतचिरंसीतेस्वगृहेपर्यवस्थिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]