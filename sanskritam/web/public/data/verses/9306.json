[{"id": 5000306000, "chapter_id": 9306, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे चतुस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000306001, "chapter_id": 9306, "verse_number": "४-३४-१", "content_sanskrit": "तमप्रतिहतं क्रुद्धं प्रविष्टं पुरुषर्षभम्।\nसुग्रीवो लक्ष्मणं दृष्ट्वा बभूव व्यथितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000306002, "chapter_id": 9306, "verse_number": "४-३४-२", "content_sanskrit": "क्रुद्धं निःश्वसमानं तं प्रदीप्तमिव तेजसा।\nभ्रातुर्व्यसनसंतप्तं दृष्ट्वा दशरथात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000306003, "chapter_id": 9306, "verse_number": "४-३४-३", "content_sanskrit": "उत्पपात हरिश्रेष्ठो हित्वा सौवर्णमासनम्।\nमहान् महेन्द्रस्य यथा स्वलंकृत इव ध्वजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000306004, "chapter_id": 9306, "verse_number": "४-३४-४", "content_sanskrit": "उत्पतन्तमनूत्पेतू रुमाप्रभृतयः स्त्रियः।\nसुग्रीवं गगने पूर्णं चन्द्रं तारागणा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000306005, "chapter_id": 9306, "verse_number": "४-३४-५", "content_sanskrit": "संरक्तनयनः श्रीमान् संचचार कृताञ्जलिः।\nबभूवावस्थितस्तत्र कल्पवृक्षो महानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000306006, "chapter_id": 9306, "verse_number": "४-३४-६", "content_sanskrit": "रुमाद्वितीयं सुग्रीवं नारीमध्यगतं स्थितम्।\nअब्रवील्लक्ष्मणः क्रुद्धः सतारं शशिनं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000306007, "chapter_id": 9306, "verse_number": "४-३४-७", "content_sanskrit": "सत्त्वाभिजनसम्पन्नः सानुक्रोशो जितेन्द्रियः।\nकृतज्ञः सत्यवादी च राजा लोके महीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000306008, "chapter_id": 9306, "verse_number": "४-३४-८", "content_sanskrit": "यस्तु राजा स्थितोऽधर्मे मित्राणामुपकारिणाम्।\nमिथ्या प्रतिज्ञां कुरुते को नृशंसतरस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000306009, "chapter_id": 9306, "verse_number": "४-३४-९", "content_sanskrit": "शतमश्वानृते हन्ति सहस्रं तु गवानृते।\nआत्मानं स्वजनं हन्ति पुरुषः पुरुषानृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000306010, "chapter_id": 9306, "verse_number": "४-३४-१०", "content_sanskrit": "पूर्वं कृतार्थो मित्राणां न तत्प्रतिकरोति यः।\nकृतघ्नः सर्वभूतानां स वध्यः प्लवगेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000306011, "chapter_id": 9306, "verse_number": "४-३४-११", "content_sanskrit": "गीतोऽयं ब्रह्मणा श्लोकः सर्वलोकनमस्कृतः।\nदृष्ट्वा कृतघ्नं क्रुद्धेन तन्निबोध प्लवंगम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000306012, "chapter_id": 9306, "verse_number": "४-३४-१२", "content_sanskrit": "गोघ्ने चैव सुरापे च चौरे भग्नव्रते तथा।\nनिष्कृतिर्विहिता सद्भिः कृतघ्ने नास्ति निष्कृतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000306013, "chapter_id": 9306, "verse_number": "४-३४-१३", "content_sanskrit": "अनार्यस्त्वं कृतघ्नश्च मिथ्यावादी च वानर।\nपूर्वं कृतार्थो रामस्य न तत्प्रतिकरोषि यत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000306014, "chapter_id": 9306, "verse_number": "४-३४-१४", "content_sanskrit": "ननु नाम कृतार्थेन त्वया रामस्य वानर।\nसीताया मार्गणे यत्नः कर्तव्यः कृतमिच्छता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000306015, "chapter_id": 9306, "verse_number": "४-३४-१५", "content_sanskrit": "स त्वं ग्राम्येषु भोगेषु सक्तो मिथ्याप्रतिश्रवः।\nन त्वां रामो विजानीते सर्पं मण्डूकराविणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000306016, "chapter_id": 9306, "verse_number": "४-३४-१६", "content_sanskrit": "महाभागेन रामेण पापः करुणवेदिना।\nहरीणां प्रापितो राज्यं त्वं दुरात्मा महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000306017, "chapter_id": 9306, "verse_number": "४-३४-१७", "content_sanskrit": "कृतं चेन्नातिजानीषे राघवस्य महात्मनः।\nसद्यस्त्वं निशितैर्बाणैर्हतो द्रक्ष्यसि वालिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000306018, "chapter_id": 9306, "verse_number": "४-३४-१८", "content_sanskrit": "न स संकुचितः पन्था येन वाली हतो गतः।\nसमये तिष्ठ सुग्रीव मा वालिपथमन्वगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000306019, "chapter_id": 9306, "verse_number": "४-३४-१९", "content_sanskrit": "न नूनमिक्ष्वाकुवरस्य कार्मुका-\nच्छरांश्च तान् पश्यसि वज्रसंनिभान्।\nततः सुखं नाम विषेवसे सुखी\nन रामकार्यं मनसाप्यवेक्षसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000306020, "chapter_id": 9306, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे चतुस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]