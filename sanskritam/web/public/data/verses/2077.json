[{"id": 2049071, "chapter_id": 2077, "verse_number": "७-१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2049072, "chapter_id": 2077, "verse_number": "७-१-१", "content_sanskrit": "तस्य लालप्यमानस्य कुरुवृद्धः पितामहः।\nदेशकालोचितं वाक्यमब्रवीत्प्रीतमानसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2049073, "chapter_id": 2077, "verse_number": "७-१-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2049074, "chapter_id": 2077, "verse_number": "७-१-२", "content_sanskrit": "समुद्र इव सिन्धूनां ज्योतिषामिव भास्करः।\nसत्यस्य च यथा सन्तो बीजानामिव चोर्वरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2049075, "chapter_id": 2077, "verse_number": "७-१-३", "content_sanskrit": "पर्जन्य इव भूतानां प्रतिष्ठा सुहृदां भवान्।\nबान्धवास्त्वाऽनुजीवन्तु स्वादुवृक्षमिवाण़्डजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2049076, "chapter_id": 2077, "verse_number": "७-१-४", "content_sanskrit": "मानहा भव शत्रूणां मित्राणां नन्दिवर्धनः।\nकौरवाणां भव गतिर्यथा विष्णुर्दिवौकसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2049077, "chapter_id": 2077, "verse_number": "७-१-५", "content_sanskrit": "स्वबाहुबलवीर्येण धार्तराष्ट्रप्रियैषिणा।\nकर्ण राजपुरं गत्वा काम्भोजा निर्जितास्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2049078, "chapter_id": 2077, "verse_number": "७-१-६", "content_sanskrit": "गिरिव्रजगताश्चापि नग्नजित्प्रमुखा नृपाः।\nअम्बष्ठाश्च विदेहाश्च गान्धाराश्च जितास्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2049079, "chapter_id": 2077, "verse_number": "७-१-७", "content_sanskrit": "हिमवद्दुर्गनिलयाः किराता रणकर्कशाः।\nदुर्योधनस्य वशगास्त्वया कर्ण पुरा कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2049080, "chapter_id": 2077, "verse_number": "७-१-८", "content_sanskrit": "उत्कला मेकलाः पौण्ड्राः कलिङ्गान्ध्राश्च संयुगे।\nनिषादाश्च त्रिगर्ताश्च बाह्लीकाश्च जितास्त्वया", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2049081, "chapter_id": 2077, "verse_number": "७-१-९", "content_sanskrit": "तत्रतत्र च संग्रामे दुर्योधनहितैषिणा।\nबहवश्च जिताः कर्ण त्वया वीरा महौजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2049082, "chapter_id": 2077, "verse_number": "७-१-१०", "content_sanskrit": "यथा दुर्योधनस्यातः सज्ञातिकुलबान्धवः।\nतथा त्वमपि सर्वेषां कौरवाणां गतिर्भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2049083, "chapter_id": 2077, "verse_number": "७-१-११", "content_sanskrit": "शिवेशनाभिवदामि त्वां गच्छ युध्यस्व शत्रुभिः।\nअनुशास्य कुरून्सर्वान्धत्स्व दुर्योधने जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2049084, "chapter_id": 2077, "verse_number": "७-१-१२", "content_sanskrit": "भवान्पौत्रसमोऽस्माकं यथा दुर्योधनस्तथा।\nतवापि धर्मतः सर्वे यथा तस्य वयं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2049085, "chapter_id": 2077, "verse_number": "७-१-१३", "content_sanskrit": "यौनात्सम्बन्धकाल्लोके विशिष्टं सङ्गतं सताम्।\nसद्भिः सङ्गममिच्छन्ति तस्मात्प्राज्ञाः परैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2049086, "chapter_id": 2077, "verse_number": "७-१-१४", "content_sanskrit": "स सत्यसङ्गरो भूत्वा ममेदमिति निश्चितः।\nकुरूणां पालय बलं यथा दुर्योधनस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2049087, "chapter_id": 2077, "verse_number": "७-१-१५", "content_sanskrit": "`यथा च कुरवो युद्धे योधयन्ति स्म पाण्डवान्।\nतथा कर्ण त्वया कार्यं दुर्योधनहितैषिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2049088, "chapter_id": 2077, "verse_number": "७-१-१६", "content_sanskrit": "निशम्य वचनं तस्य चरणावभिवाद्य च।\nययौ वैकर्तनः कर्णस्तूर्णमायोधनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2049089, "chapter_id": 2077, "verse_number": "७-१-१७", "content_sanskrit": "सोऽभिवीक्ष्य नरौघाणां स्थानमप्रतिमं महत्।\nव्यूढप्रहरणोरस्कं सैन्यं तत्समबृंहयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2049090, "chapter_id": 2077, "verse_number": "७-१-१८", "content_sanskrit": "हृषिताः कुरवः सर्वे दुर्योधनपुरोगमाः।\nउपागतं महाबाहुं सर्वानीकपुरःसरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2049091, "chapter_id": 2077, "verse_number": "", "content_sanskrit": "कर्णं दृष्ट्वा महात्मानं युद्धाय समुपस्थितम्।\nक्ष्वेडितास्फोटितरवैः सिंहनादरवैरपि।\nधनुःशब्दैश्च विविधैः कुरवः समपूजयन्॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१-३ अर्थपतिः प्रधानस्वामी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]