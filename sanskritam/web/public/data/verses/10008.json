[{"id": 6000008000, "chapter_id": 10008, "verse_number": null, "content_sanskrit": "अथ अष्‍टमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000008001, "chapter_id": 10008, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.001.m4a", "display_order": 2}, {"id": 6000008002, "chapter_id": 10008, "verse_number": "१-८-१", "content_sanskrit": "पुत्रशोकातुराः सर्वे पाण्डवाः सह कृष्णया।\nस्वानां मृतानां यत्कृत्यं चक्रुर्निर्हरणादिकम्॥ १/८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.002.m4a", "display_order": 3, "topics": [{"text": "युधिष्‍ठिरं राज्ये प्रतिष्‍ठाप्य द्वारकां जिगमिषति श्रीकृष्णे अश्‍वत्थामोपसृष्‍टापाण्डवेयास्‍त्रपीडितया उत्तरादेव्या श्रीकृष्णं प्रति मध्येमार्गं शरणगमनम्", "range": "१–११"}]}, {"id": 6000008003, "chapter_id": 10008, "verse_number": "१-८-२", "content_sanskrit": "अथो निशामयामास कृष्णायै भगवान्पुरा।\nपतितायाः पादमूले रुदन्त्या यत्प्रतिश्रुतम्॥ १/८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.003.m4a", "display_order": 4}, {"id": 6000008004, "chapter_id": 10008, "verse_number": "१-८-३", "content_sanskrit": "पश्य राज्ञ्यरिदारांस्ते रुदतो मुक्‍तमूर्धजान्।\nआलिङ्ग्य स्वपतीन्भीमगदाभग्नोरुवक्षसः॥ १/८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.004.m4a", "display_order": 5}, {"id": 6000008005, "chapter_id": 10008, "verse_number": "१-८-४", "content_sanskrit": "अथ ते सम्परेतानां स्वानामुदकमिच्छताम्।\nदातुं सकृष्णा गङ्गायां पुरस्कृत्य ययुः स्‍त्रियः॥ १/८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.005.m4a", "display_order": 6}, {"id": 6000008006, "chapter_id": 10008, "verse_number": "१-८-५", "content_sanskrit": "ते निनीयोदकं सर्वे विलप्य च भृशं पुनः।\nआप्लुता हरिपादाब्जरजःपूतसरिज्जले॥ १/८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.006.m4a", "display_order": 7}, {"id": 6000008007, "chapter_id": 10008, "verse_number": "१-८-६", "content_sanskrit": "तत्राऽसीनं कुरुपतिं धृतराष्‍ट्रं सहानुजम्।\nगान्धारीं पुत्रशोकार्तां पृथां कृष्णां च माधवः॥ १/८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.007.m4a", "display_order": 8}, {"id": 6000008008, "chapter_id": 10008, "verse_number": "१-८-७", "content_sanskrit": "सान्त्वयामास मुनिभिर्हतपुत्राञ्छुचाऽर्पितान्।\nभूतेषु कालस्य गतिं दर्शयन्नप्रतिक्रियाम्॥ १/८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.008.m4a", "display_order": 9}, {"id": 6000008009, "chapter_id": 10008, "verse_number": "१-८-८", "content_sanskrit": "घातयित्वाऽसतो राज्ञ्याः कचस्पर्शहतायुषः।\nसाधयित्वाऽजातशत्रोः स्वाराज्यं कितवैर्हृतम्॥ १/८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.009.m4a", "display_order": 10}, {"id": 6000008010, "chapter_id": 10008, "verse_number": "१-८-९", "content_sanskrit": "याजयित्वाऽश्‍वमेधैस्तं त्रिभिरुत्तमकल्पकैः।\nतद्यशः पावनं दिक्षु शतमन्योरिवातनोत्॥ १/८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.010.m4a", "display_order": 11}, {"id": 6000008011, "chapter_id": 10008, "verse_number": "१-८-१०", "content_sanskrit": "आमन्त्र्य पाण्डुपुत्रांश्‍च शैनेयोद्धवसंयुतः।\nद्वैपायनादिभिर्विप्रैः पूजितैः प्रतिपूजितः॥ १/८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.011.m4a", "display_order": 12}, {"id": 6000008012, "chapter_id": 10008, "verse_number": "१-८-११", "content_sanskrit": "गन्तुं कृतमतिर्ब्रह्मन्द्वारकां रथमास्थितः।\nउपलेभेऽभिधावन्तीमुत्तरां भयविह्वलाम्॥ १/८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.012.m4a", "display_order": 13}, {"id": 6000008013, "chapter_id": 10008, "verse_number": null, "content_sanskrit": "उत्तरा उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.013.m4a", "display_order": 14}, {"id": 6000008014, "chapter_id": 10008, "verse_number": "१-८-१२", "content_sanskrit": "पाहि पाहि महायोगिन्देवदेव जगत्पते।\nनान्यं त्वदभयं पश्ये यत्र मृत्युः परस्परम्॥ १/८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.014.m4a", "display_order": 15, "topics": [{"text": "श्रीकृष्णेन सुदर्शनायुधेनाश्‍वत्थामास्‍त्रप्रतिघातपूर्वकम् उत्तराया गर्भरक्षणम्", "range": "१२–१८"}]}, {"id": 6000008015, "chapter_id": 10008, "verse_number": "१-८-१३", "content_sanskrit": "अभिद्रवति मामीश शरस्तप्‍तायसो विभो।\nकामं दहतु मां नाथ मा मे गर्भो निपात्यताम्॥ १/८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.015.m4a", "display_order": 16}, {"id": 6000008016, "chapter_id": 10008, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.016.m4a", "display_order": 17}, {"id": 6000008017, "chapter_id": 10008, "verse_number": "१-८-१४", "content_sanskrit": "उपधार्य वचस्तस्या भगवान्भक्‍तवत्सलः।\nअपाण्डवमिदं कर्तुं द्रौणेरस्‍त्रमबुध्यत॥ १/८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.017.m4a", "display_order": 18}, {"id": 6000008018, "chapter_id": 10008, "verse_number": "१-८-१५", "content_sanskrit": "तर्ह्येवाथ भृगुश्रेष्‍ठ पाण्डवाः पञ्चसायकान्।\nआत्मनोऽभिमुखान्दीप्‍तानालक्ष्यास्‍त्राण्युपाददुः॥ १/८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.018.m4a", "display_order": 19}, {"id": 6000008019, "chapter_id": 10008, "verse_number": "१-८-१६", "content_sanskrit": "व्यसनं वीक्ष्य तत्तेषाम् अनन्यविषयात्मनाम्।\nसुदर्शनेन स्वास्‍त्रेण स्वानां रक्षां व्यधाद्विभुः॥ १/८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.019.m4a", "display_order": 20}, {"id": 6000008020, "chapter_id": 10008, "verse_number": "१-८-१७", "content_sanskrit": "अन्तःस्थः सर्वभूतानामात्मा योगेश्‍वरो हरिः।\nस्वमाययाऽवृणोद्गर्भं वैराट्याः कुरुतन्तवे॥ १/८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.020.m4a", "display_order": 21}, {"id": 6000008021, "chapter_id": 10008, "verse_number": "१-८-१८", "content_sanskrit": "यद्यप्यस्‍त्रं ब्रह्मशिरस्त्वमोघं ‍चाप्रतिक्रियम्।\nवैष्णवं तेज आसाद्य समशाम्यद् भृगूद्वह॥ १/८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.021.m4a", "display_order": 22}, {"id": 6000008022, "chapter_id": 10008, "verse_number": "१-८-१९", "content_sanskrit": "मा मंस्था ह्येतदाश्‍चर्यं सर्वाश्‍चर्यमयेऽच्युते।\nय इदं मायया देव्या सृजत्यवति हन्त्यजः॥ १/८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.022.m4a", "display_order": 23}, {"id": 6000008023, "chapter_id": 10008, "verse_number": "१-८-२०", "content_sanskrit": "ब्रह्मतेजोविनिर्मुक्‍तैरात्मजैः सह कृष्णया।\nप्रयाणाभिमुखं कृष्णमिदमाह पृथा सती॥ १/८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.023.m4a", "display_order": 24}, {"id": 6000008024, "chapter_id": 10008, "verse_number": null, "content_sanskrit": "पृथा उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.024.m4a", "display_order": 25}, {"id": 6000008025, "chapter_id": 10008, "verse_number": "१-८-२१", "content_sanskrit": "नमस्ते पुरुषं त्वाद्यमीश्‍वरं प्रकृतेः परम्।\nअलक्ष्यं सर्वभावानामन्तर्बहिरपि ध्रुवम्॥ १/८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.025.m4a", "display_order": 26, "topics": [{"text": "कुन्त्या श्रीकृष्णस्तुतिः", "range": "२१–४६"}]}, {"id": 6000008026, "chapter_id": 10008, "verse_number": "१-८-२२", "content_sanskrit": "मायायवनिकाच्छन्नो मयाऽधोक्षज मर्त्यया।\nन लक्ष्यसे मूढदृशा नटो नाट्यचरो यथा॥ १/८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.026.m4a", "display_order": 27}, {"id": 6000008027, "chapter_id": 10008, "verse_number": "१-८-२३", "content_sanskrit": "तथा परमहंसानां मुनीनाममलात्मनाम्।\nभक्‍तियोगविधानार्थं कथं पश्येमहि स्‍त्रियः॥ १/८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.027.m4a", "display_order": 28}, {"id": 6000008028, "chapter_id": 10008, "verse_number": "१-८-२४", "content_sanskrit": "कृष्णाय वासुदेवाय देवकीनन्दनाय च।\nनन्दगोपकुमाराय गोविन्दाय नमो नमः॥ १/८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.028.m4a", "display_order": 29}, {"id": 6000008029, "chapter_id": 10008, "verse_number": "१-८-२५", "content_sanskrit": "नमः पङ्कजनाभाय नमः पङ्कजमालिने।\nनमः पङ्कजनेत्राय नमस्ते पङ्कजाङ्घ्रये॥ १/८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.029.m4a", "display_order": 30}, {"id": 6000008030, "chapter_id": 10008, "verse_number": "१-८-२६", "content_sanskrit": "यथा हृषीकेश खलेन देवकी कंसेन रुद्धातिचिरं शुचाऽर्पिता।\nविमोहिताऽहं ‍च सहात्मजा विभो त्वयैव नाथेन मुहुर्विपद्गणात्॥ १/८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.030.m4a", "display_order": 31}, {"id": 6000008031, "chapter_id": 10008, "verse_number": "१-८-२७", "content_sanskrit": "विषान्महाग्नेः पुरुषाददंशनादसत्सभायाः वनवासकृच्छ्रतः।\nमृधे मृधेऽनेकमहारथास्‍त्रतो द्रौण्यस्‍त्रतश्‍चास्म हरेऽभिरक्षिताः॥ १/८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.031.m4a", "display_order": 32}, {"id": 6000008032, "chapter_id": 10008, "verse_number": "१-८-२८", "content_sanskrit": "विपदः सन्तु नः शश्‍वत्तत्र तत्र जगत्पते।\nभवतो दर्शनं यत्स्यादपुनर्भवदर्शनम्॥ १/८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.032.m4a", "display_order": 33}, {"id": 6000008033, "chapter_id": 10008, "verse_number": "१-८-२९", "content_sanskrit": "जन्मैश्‍वर्यश्रुतश्रीभिरेधमानमदः पुमान्।\nनार्ह इत्यभिधातुं वै त्वामकिञ्चनगोचरम्॥ १/८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.033.m4a", "display_order": 34}, {"id": 6000008034, "chapter_id": 10008, "verse_number": "१-८-३०", "content_sanskrit": "नमोऽकिञ्चनवित्ताय निवृत्तगुणवृत्तये।\nआत्मारामाय शान्ताय कैवल्यपतये नमः॥ १/८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.034.m4a", "display_order": 35}, {"id": 6000008035, "chapter_id": 10008, "verse_number": "१-८-३१", "content_sanskrit": "मन्ये त्वां कालमीशानमनादिनिधनं परम्।\nसमं चरन्तं सर्वत्र भूतानां यन्मिथः कलिः॥ १/८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.035.m4a", "display_order": 36}, {"id": 6000008036, "chapter_id": 10008, "verse_number": "१-८-३२", "content_sanskrit": "न वेद कश्‍चिद्भगवंश्‍चिकीर्षितं तवेहमानस्य नृणां विडम्बनम्।\nन यस्य कश्‍चिद्दयितोऽस्ति कर्हिचित् द्वेष्यश्‍च यस्मिन् विषमा मतिर्नृणाम्॥ १/८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.036.m4a", "display_order": 37}, {"id": 6000008037, "chapter_id": 10008, "verse_number": "१-८-३३", "content_sanskrit": "जन्म कर्म च विश्‍वात्मन्नजस्याकर्तुरात्मनः।\nतिर्यङ्‌नृपशुयादस्सु तदत्यन्तविडम्बनम्॥ १/८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.037.m4a", "display_order": 38}, {"id": 6000008038, "chapter_id": 10008, "verse_number": "१-८-३४", "content_sanskrit": "गोप्याददे त्वयि कृतागसि दाम तावद् या ते दशाश्रुकलिलाञ्जनसम्भ्रमाक्षम्।\nवक्‍त्रं विनम्य भयभावनया स्थितस्य सा मां विमोहयति भीरपि यं बिभेति॥ १/८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.038.m4a", "display_order": 39}, {"id": 6000008039, "chapter_id": 10008, "verse_number": "१-८-३५", "content_sanskrit": "केचिदाहुरजं जातं पुण्यश्लोकस्य कीर्तये।\nयदोः प्रियस्यान्ववाये मलयस्येव चन्दनम्॥ १/८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.039.m4a", "display_order": 40}, {"id": 6000008040, "chapter_id": 10008, "verse_number": "१-८-३६", "content_sanskrit": "अपरे वसुदेवस्य देवक्यां याचितोऽभ्यगात्।\nअजस्त्वमस्य क्षेमाय वधाय च सुरद्विषाम्॥ १/८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.040.m4a", "display_order": 41}, {"id": 6000008041, "chapter_id": 10008, "verse_number": "१-८-३७", "content_sanskrit": "भारावतारणायान्ये भुवो नाव इवोदधौ।\nसीदन्त्या भूरिभारेण जातो ह्यात्मभुवाऽर्थितः॥ १/८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.041.m4a", "display_order": 42}, {"id": 6000008042, "chapter_id": 10008, "verse_number": "१-८-३८", "content_sanskrit": "भवेऽस्मिन् क्लिश्यमानानामविद्याकामकर्मभिः।\nश्रवणस्मरणार्हाणि करिष्यन्निति केचन॥ १/८/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.042.m4a", "display_order": 43}, {"id": 6000008043, "chapter_id": 10008, "verse_number": "१-८-३९", "content_sanskrit": "शृण्वन्ति गायन्ति गृणन्त्यभीक्ष्णशः स्मरन्ति नन्दन्ति तवेहितं जनाः।\nत एव पश्यन्त्यचिरेण तावकं भवप्रवाहोपरमं पदाम्बुजम्॥ १/८/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.043.m4a", "display_order": 44}, {"id": 6000008044, "chapter_id": 10008, "verse_number": "१-८-४०", "content_sanskrit": "अप्यद्य नस्त्वं स्वकृतेहितः प्रभो जिहाससि स्वित्सुहृदोऽनुजीविनः।\nयेषां न चान्यद्भवतः पदाम्बुजात्परायणं राजसु योजितांहसाम्॥ १/८/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.044.m4a", "display_order": 45}, {"id": 6000008045, "chapter_id": 10008, "verse_number": "१-८-४१", "content_sanskrit": "ते वयं नामरूपाभ्यां यदुभिः सह पाण्डवाः।\nभवतो दर्शनं यर्हि हृषीकाणामिवेशितुः॥ १/८/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.045.m4a", "display_order": 46}, {"id": 6000008046, "chapter_id": 10008, "verse_number": "१-८-४२", "content_sanskrit": "नेयं शोभिष्यते तत्र यथेदानीं गदाधर।\nत्वत्पदैरङ्किता भाति स्वलक्षणविलक्षितैः॥ १/८/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.046.m4a", "display_order": 47}, {"id": 6000008047, "chapter_id": 10008, "verse_number": "१-८-४३", "content_sanskrit": "इमे जनपदाः स्वृद्धाः सुपक्‍वौषधिवीरुधः।\nवनाद्रिनद्युदन्वन्तो ह्येधन्ते तव वीक्षिताः॥ १/८/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.047.m4a", "display_order": 48}, {"id": 6000008048, "chapter_id": 10008, "verse_number": "१-८-४४", "content_sanskrit": "अथ विश्‍वेश विश्‍वात्मन् विश्‍वमूर्ते स्वकेषु मे।\nस्नेहपाशमिमं छिन्दि ध्रुवं पाण्डुषु वृष्णिषु॥ १/८/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.048.m4a", "display_order": 49}, {"id": 6000008049, "chapter_id": 10008, "verse_number": "१-८-४५", "content_sanskrit": "त्वयि मेऽनन्यविषया मतिर्मधुपतेऽसकृत्।\nरतिमुद्वहतादद्धा गङ्गेवौघमुदन्वति॥ १/८/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.049.m4a", "display_order": 50}, {"id": 6000008050, "chapter_id": 10008, "verse_number": "१-८-४६", "content_sanskrit": "श्रीकृष्ण कृष्णसख वृष्णिवृषावनिध्रुग्राजन्यवंशदहनामरवन्द्यवीर्य।\nगोविन्द गोद्विजसुरार्तिहरावतार योगेश्‍वराखिलगुरो भगवन्नमस्ते॥ १/८/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.050.m4a", "display_order": 51}, {"id": 6000008051, "chapter_id": 10008, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.051.m4a", "display_order": 52}, {"id": 6000008052, "chapter_id": 10008, "verse_number": "१-८-४७", "content_sanskrit": "पृथयेत्थं कलपदैः परिगीताखिलोदयः।\nमन्दं जहास वैकुण्ठो मोहयन्योगमायया॥ १/८/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.052.m4a", "display_order": 53, "topics": [{"text": "युधिष्‍ठिरप्रार्थनया श्रीकृष्णस्य पुनर्हास्तिनपुरप्रवेशः", "range": "४७–४८"}]}, {"id": 6000008053, "chapter_id": 10008, "verse_number": "१-८-४८", "content_sanskrit": "तां बाढमित्युपामन्त्र्य प्रविश्य गजसाह्वयम्।\nस्‍त्रियश्‍च स्वपुरं यास्यन्प्रेम्णा राज्ञा निवारितः॥ १/८/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_008/BhP_01.008.053.m4a", "display_order": 54}, {"id": 6000008054, "chapter_id": 10008, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां प्रथमस्कन्धे अष्‍टमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]