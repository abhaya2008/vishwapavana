[{"id": 5000132000, "chapter_id": 9132, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे पञ्चपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000132001, "chapter_id": 9132, "verse_number": "२-५५-१", "content_sanskrit": "उषित्वा रजनीम् तत्र राजपुत्रावरिम्दमौ ।\nमहर्षिमभिवाद्याथ जग्मतुस्तम् गिरिम् प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000132002, "chapter_id": 9132, "verse_number": "२-५५-२", "content_sanskrit": "तेषाम् चैव स्वस्त्ययनम् महर्षिः स चकार ह ।\nप्रस्थिताम्श्चैव तान् प्रेक्ष्यपिता पुत्रानिवान्वगात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000132003, "chapter_id": 9132, "verse_number": "२-५५-३", "content_sanskrit": "ततः प्रचक्रमे वक्तुम् वचनम् स महामुनिः ।\nभर्द्वाजो महातेजा रामम् सत्यपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000132004, "chapter_id": 9132, "verse_number": "२-५५-४", "content_sanskrit": "गङ्गायमुनयोः सन्धिमासाद्य मनुजर्षभौ ।\nकालिन्दीमनुगच्छेताम् नदीम् पश्चान्मुखाश्रिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000132005, "chapter_id": 9132, "verse_number": "२-५५-५", "content_sanskrit": "अथासाद्य तु कालिन्दीं शीघ्रस्रोतसमापगाम् (प्रतिस्रोतःसमागताम् - पा.भे.) ।\nतस्यास्तीर्थम् प्रचरितम् पुराणम् प्रेक्ष्य राघवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000132006, "chapter_id": 9132, "verse_number": "२-५५-६", "content_sanskrit": "तत्र यूयम् प्लवम् कृत्वा तरतांशुमतीं नदीम् ।\nततो न्यग्रोधमासाद्य महान्तम् हरितच्छदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000132007, "chapter_id": 9132, "verse_number": "२-५५-७", "content_sanskrit": "विवृद्धम् बहुभिर्वऋक्षैह् श्यामम् सिद्धोपसेवितम् ।\nतस्मै सीताञ्जलिम् कृत्वा प्रयुञ्जीताशिषः शिवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000132008, "chapter_id": 9132, "verse_number": "२-५५-८", "content_sanskrit": "समासाद्य तु तम् वृक्षम् वसेद्वातिक्रमेत वा ।\nक्रोशमात्रम् ततो गत्वा नीलम् द्रक्ष्यथ काननम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000132009, "chapter_id": 9132, "verse_number": "२-५५-९", "content_sanskrit": "पलाशबदरीमिश्रम् रम्यम् वम्शैश्च यामुनैः ।\nस पन्थाश्चित्रकूटस्य गतः सुबहुशो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000132010, "chapter_id": 9132, "verse_number": "२-५५-१०", "content_sanskrit": "रम्ये मार्दवयुक्तश्च वनदावैर्विपर्जितः ।\nइति पन्थानमावेद्य महर्षः स न्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000132011, "chapter_id": 9132, "verse_number": "२-५५-११", "content_sanskrit": "अभिवाद्य तथेत्युक्त्वा रामेण विनिवर्तितः ।\nउपावृत्ते मुनौ तस्मिन् रामो लक्ष्मणमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000132012, "chapter_id": 9132, "verse_number": "२-५५-१२", "content_sanskrit": "कृतपुण्याः स्म सौमित्रे मुनिर्यन्नोऽनुकम्पते ।\nइति तौ पुरुषव्याघ्रौ मन्त्रयित्वा मनस्विनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000132013, "chapter_id": 9132, "verse_number": "२-५५-१३", "content_sanskrit": "सीतामेवाग्रतः कृत्वा काLइन्दीम् जग्मतुर्नदीम् ।\nअथा साद्य तु काLइन्दीम् शीघ्रस्रोतोवहाम् नदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000132014, "chapter_id": 9132, "verse_number": "२-५५-१४", "content_sanskrit": "तौ काष्ठसम्घातमथो चक्रतुस्तु महाप्लवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000132015, "chapter_id": 9132, "verse_number": "२-५५-१५", "content_sanskrit": "शुष्कैर्वम्शैः समास्तीर्णमुLईरैश्च समावृतम् ।\nततो वेतसशाखाश्च जम्बूशाखाश्च वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000132016, "chapter_id": 9132, "verse_number": "२-५५-१६", "content_sanskrit": "चकार लक्ष्मणश्छित्वा सीतायाः सुखमासनम् ।\nतत्र श्रियमिवाचिन्त्याम् रामो दाशरथिः प्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000132017, "chapter_id": 9132, "verse_number": "२-५५-१७", "content_sanskrit": "ईष्त्सन्कह्हनाबान् तानग्तारिओअतत् प्लवम् ।\nपार्श्वे च तत्र वैदेह्या वसने चूष्णानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000132018, "chapter_id": 9132, "verse_number": "२-५५-१८", "content_sanskrit": "प्लवे कठिनकाजम् च रामश्चक्रे सहायुधैः ।\nआरोप्य प्रथमम् सीताम् सम्घाटम् प्रतिगृह्य तौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000132019, "chapter_id": 9132, "verse_number": "२-५५-१९", "content_sanskrit": "ततः प्रतेरतुर्य त्तौ वीरौ दशरथात्मजौ ।\nकाLइन्दीमध्यमायाता सीता त्वेनामवन्दत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000132020, "chapter_id": 9132, "verse_number": "२-५५-२०", "content_sanskrit": "स्वस्ति देवि तरामि त्वाम् पार्येन्मे पतिर्वतम् ।\nयक्ष्ये त्वाम् गोनहस्रेण सुराघटशतेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000132021, "chapter_id": 9132, "verse_number": "२-५५-२१", "content_sanskrit": "स्वस्ति प्रत्यागते रामे पुरीमिक्ष्वाकुपालिताम् ।\nकाLइन्दीमथ सीता तु याचमाना कृताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000132022, "chapter_id": 9132, "verse_number": "२-५५-२२", "content_sanskrit": "तीरमेवाभिसम्प्राप्ता दक्षिणम् वरवर्णिनी ।\nततः प्लवेनाम्शुमतीम् शीघ्रगामूर्मिमालिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000132023, "chapter_id": 9132, "verse_number": "२-५५-२३", "content_sanskrit": "तीरजैर्बहुभिर्वृक्षैः सम्तेरुर्यमुनाम् नदीम् ।\nते तीर्णाः प्लवमुत्सृज्य प्रस्थाय यमुनावनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000132024, "chapter_id": 9132, "verse_number": "२-५५-२४", "content_sanskrit": "श्यामम् न्यग्रोधमासेदुः शीतलम् हरितच्छदम् ।\nन्य्ग्रोधम् तमुपागम्य वैदेहि वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000132025, "chapter_id": 9132, "verse_number": "२-५५-२५", "content_sanskrit": "नमस्तेऽन्तु महावृक्ष पारयेन्मे पतिर्वतम् ।\nकौसल्याम् चैव पश्येयम् सुमित्राम् च यशस्विनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000132026, "chapter_id": 9132, "verse_number": "२-५५-२६", "content_sanskrit": "इति सीताञ्जलिम् कृत्वा पर्यगच्छद्वनस्पतिम् ।\nअवलोक्य ततः सीतामायाचन्तीमनिन्दिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000132027, "chapter_id": 9132, "verse_number": "२-५५-२७", "content_sanskrit": "दयिताम् च विधेयम् च रामो लक्ष्मणमब्रवीत् ।\nसीतामादाय गच्छ त्वमग्रतो भरतानुज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000132028, "chapter_id": 9132, "verse_number": "२-५५-२८", "content_sanskrit": "पृष्ठतोऽहम् गमिष्यामि सायुधो द्विपदाम् वर ।\nयद्यत्फलम् प्रार्थयते पुष्पम् वा जनकात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000132029, "chapter_id": 9132, "verse_number": "२-५५-२९", "content_sanskrit": "तत्तत्प्रदद्या वैदेह्या यत्रास्य रमते मनः ।\nगच्चतोस्तु तयोर्मध्ये बभूव जनकात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000132030, "chapter_id": 9132, "verse_number": "२-५५-३०", "content_sanskrit": "मातङ्गयोर्मद्यगता शुभा नागवधूरिव ।\nएकैकम् पादपम् गुल्मम् लताम् वा पुष्पशालिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000132031, "chapter_id": 9132, "verse_number": "२-५५-३१", "content_sanskrit": "अदृष्टपूर्वाम् पश्यन्ती रामम् पप्रच्छ साऽबला ।\nरमणीयान् बहुविधान् पादपान् कुसुमोत्कटान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000132032, "chapter_id": 9132, "verse_number": "२-५५-३२", "content_sanskrit": "सीतावचनसम्रब्द अनयामास लक्स्मणः ।\nविचित्रवालुकजलाम् हससारसनादिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000132033, "chapter_id": 9132, "verse_number": "२-५५-३३", "content_sanskrit": "रेमे जनकराजस्य तदा प्रेक्ष्य सुता नदीम् ।\nक्रोशमात्रम् ततो गत्वा भ्रातरौ रामलक्ष्मनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000132034, "chapter_id": 9132, "verse_number": "२-५५-३४", "content_sanskrit": "बहून्मेध्यान् मृगान् हत्वा चेरतुर्यमुनावने ।\nविहृत्य ते बर्हिणपूगनादिते ।\nशुभे वने वानरवारणायुते ।\nसमम् नदीवप्रमुपेत्य सम्मतम् ।\nनिवासमाजग्मु रदीनदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000132035, "chapter_id": 9132, "verse_number": null, "content_sanskrit": "इति वाल्मीकि रामायणे आदि काव्ये अयोध्याकाण्डे पञ्चपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]