[{"id": 2009898, "chapter_id": 1196, "verse_number": "१-१९७-०x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2009899, "chapter_id": 1196, "verse_number": "१-१९७-१", "content_sanskrit": "एवमुक्तः स विप्रर्षिर्वसिष्ठेन महात्मना।\nन्ययच्छदात्मनः क्रोधं सर्वलोकपराभवात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2009900, "chapter_id": 1196, "verse_number": "१-१९७-२", "content_sanskrit": "ईजे च स महातेजाः सर्ववेदविदां वरः।\nऋषी राक्षससत्रेण शाक्तेयोऽथ पराशरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2009901, "chapter_id": 1196, "verse_number": "१-१९७-३", "content_sanskrit": "ततो वृद्धांश्च बालांश्च राक्षसान्स महामुनिः।\nददाह वितते यज्ञे शक्तेर्वधमनुस्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2009902, "chapter_id": 1196, "verse_number": "१-१९७-४", "content_sanskrit": "न हि तं वारयामास वसिष्ठो रक्षसां वधात्।\nद्वितीयामस्य मां भाङ्क्षं प्रतिज्ञामिति निश्चयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2009903, "chapter_id": 1196, "verse_number": "१-१९७-५", "content_sanskrit": "त्रयाणां पावकानां च सत्रे तस्मिन्महामुनिः।\nआसीत्पुरस्ताद्दीप्तानां चतुर्थ इव पावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2009904, "chapter_id": 1196, "verse_number": "१-१९७-६", "content_sanskrit": "तेन यज्ञेन शुभ्रेण हूयमानेन शक्तितः।\nतद्विदीपितमाकाशं सूर्येणेव घनात्यये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2009905, "chapter_id": 1196, "verse_number": "१-१९७-७", "content_sanskrit": "तं वसिष्ठादयः सर्वे मुनयस्तत्र मेनिरे।\nतेजसा दीप्यमानं वै द्वितीयमिव भास्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2009906, "chapter_id": 1196, "verse_number": "१-१९७-८", "content_sanskrit": "ततः परमदुष्प्रापमन्यैर्ऋषिरुधारधीः।\nसमापिपयिषुः सत्रं तमत्रिः समुपागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2009907, "chapter_id": 1196, "verse_number": "१-१९७-९", "content_sanskrit": "तथा पुलस्त्यः पुलहः क्रतुश्चैव महाक्रतुः।\nतत्राजग्मुरमित्रघ्न रक्षसां जीवितेप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2009908, "chapter_id": 1196, "verse_number": "१-१९७-१०", "content_sanskrit": "पुलस्त्यस्तु वधात्तेषां रक्षसां भरतर्षभ।\nउवाचेदं वचः पार्थ पराशरमरिन्दमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2009909, "chapter_id": 1196, "verse_number": "१-१९७-११", "content_sanskrit": "कच्चित्तातापविघ्नं ते कच्चिन्नन्दसि पुत्रक।\nअजानतामदोषाणां सर्वेषां रक्षसां वधात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2009910, "chapter_id": 1196, "verse_number": "१-१९७-१२", "content_sanskrit": "प्रजोच्छेदमिमं मह्यं न हि कर्तु त्वमर्हसि।\nनैष तात द्विजातीनां धर्मो दृष्टस्तपस्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2009911, "chapter_id": 1196, "verse_number": "१-१९७-१३", "content_sanskrit": "शम एव परो धर्मस्तमाचर पराशर।\nअधर्मिष्ठं वरिष्ठः सन्कुरुषे त्वं पराशर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2009912, "chapter_id": 1196, "verse_number": "१-१९७-१४", "content_sanskrit": "शक्तिं चापि हि धर्मज्ञं नातिक्रान्तुमिहार्हसि।\nप्रजायाश्च ममोच्छेदं न चैवं कर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2009913, "chapter_id": 1196, "verse_number": "१-१९७-१५", "content_sanskrit": "शापाद्धि शक्तेर्वासिष्ठ तदा तदुपपादितम्।\nआत्मजेन स दोषेण शक्तिर्नीत इतो दिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2009914, "chapter_id": 1196, "verse_number": "१-१९७-१६", "content_sanskrit": "न हि तं राक्षसः कश्चिच्छक्तो भक्षयितुं मुने।\nवासिष्ठो भक्षितश्चासीत्कौशिकोत्सृष्टरक्षसा।\nशापं न कुर्वन्ति तदा न च त्राणपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2009915, "chapter_id": 1196, "verse_number": "१-१९७-१७", "content_sanskrit": "क्षमावन्तोऽदहन्देहं देहमन्यद्भवत्विति।\nआत्मनैवात्मनस्तेन दृष्टो मृत्युस्तदाऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2009916, "chapter_id": 1196, "verse_number": "१-१९७-१८", "content_sanskrit": "निमित्तभूतस्तत्रासीद्विश्वामित्रः पराशर।\nराजा कल्माषपादश्च दिवमारुह्य मोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2009917, "chapter_id": 1196, "verse_number": "१-१९७-१९", "content_sanskrit": "ये च शक्त्यवराः पुत्रा वसिष्ठस्य महामुने।\nते च सर्वे मुदा युक्ता मोदन्ते सहिताः सुरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2009918, "chapter_id": 1196, "verse_number": "१-१९७-२०", "content_sanskrit": "सर्वमेतद्वसिष्ठस्य विदितं वै महामुने।\nरक्षसां च समुच्छेद एष तात तपस्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2009919, "chapter_id": 1196, "verse_number": "१-१९७-२१", "content_sanskrit": "निमित्तभूतस्त्वं चात्र क्रतौ वासिष्ठनन्दन।\nतत्सत्रं मुञ्च भद्रं ते समाप्तमिदमस्तु ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2009920, "chapter_id": 1196, "verse_number": "१-१९७-२२x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2009921, "chapter_id": 1196, "verse_number": "१-१९७-२२", "content_sanskrit": "एवमुक्तः पुलस्त्येन वसिष्ठेन च धीमता।\nतदा समापयामास सत्रं शाक्तो महामुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2009922, "chapter_id": 1196, "verse_number": "१-१९७-२३", "content_sanskrit": "सर्वराक्षससत्राय संभृतं पावकं तदा।\nउत्तरे हिमवत्पार्श्वे उत्ससर्ज महावने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2009923, "chapter_id": 1196, "verse_number": "१-१९७-२४", "content_sanskrit": "स तत्राद्यापि रक्षांसि वृक्षानश्मन एव च।\nभक्षयन्दृश्यते वह्निः सदा पर्वणि पर्वणि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2009924, "chapter_id": 1196, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि चैत्ररथपर्वणि सप्तनवत्यधिकशततमोऽध्यायः॥ १९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]