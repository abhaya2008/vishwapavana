[{"id": 2085161, "chapter_id": 2811, "verse_number": "१२-३१६-०x", "content_sanskrit": "याज्ञवल्क्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2085162, "chapter_id": 2811, "verse_number": "१२-३१६-१", "content_sanskrit": "अव्यक्तस्य नरश्रेष्ठ कालसङ्ख्यां निबोध मे।\nपञ्चकल्पसहस्राणि द्विगुणान्यहरुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2085163, "chapter_id": 2811, "verse_number": "१२-३१६-२", "content_sanskrit": "रात्रिरेतावती चास्य प्रतिबुद्धो नराधिप।\nसृजत्योषधिमेवाग्रे जीवनं सर्वदेहिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2085164, "chapter_id": 2811, "verse_number": "१२-३१६-३", "content_sanskrit": "ततो ब्रह्माणमसृजद्धैरण्याण्डसमुद्भवम्।\nसा मूर्तिः सर्वभूतानामित्येवमनुशुश्रुम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2085165, "chapter_id": 2811, "verse_number": "१२-३१६-४", "content_sanskrit": "संवत्सरमुषित्वाण्डे निष्क्रम्य च महामुनिः।\nसंदधेऽर्धं महीं कृत्स्नां दिवमर्धं प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2085166, "chapter_id": 2811, "verse_number": "१२-३१६-५", "content_sanskrit": "द्यावापृथिव्योरिज्येष राजन्वेदेषु पठ्यते।\nतयोः शकलयोर्मध्यमाकाशमकरोत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2085167, "chapter_id": 2811, "verse_number": "१२-३१६-६", "content_sanskrit": "एतस्यापि च सङ्ख्यानं वेदवेदाङ्गपारगैः।\nदशकल्पसहस्राणि पादोनान्यहरुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2085168, "chapter_id": 2811, "verse_number": "१२-३१६-७", "content_sanskrit": "रात्रिमेतावतीं चास्व प्राहुरध्यात्मचिन्तकाः।\nसृजत्यहंकारमृषिर्भूतं दिव्यात्मकं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2085169, "chapter_id": 2811, "verse_number": "१२-३१६-८", "content_sanskrit": "चतुरश्चापरान्पुत्रान्देहात्पूर्वं महानृषिः।\nते वै पितृभ्यः पितरः श्रूयन्तें राजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2085170, "chapter_id": 2811, "verse_number": "१२-३१६-९", "content_sanskrit": "देवाः पितॄणां च सुता देवैर्लोकाः समावृताः।\nचराचरा नरश्रेष्ठ इत्येवमनुशुश्रुम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2085171, "chapter_id": 2811, "verse_number": "१२-३१६-१०", "content_sanskrit": "परमेष्ठी त्वहंकारोऽसृजद्भूतानि पञ्चधा।\nपृथिवी वायुराकाशमापो ज्योतिश्च पञ्चमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2085172, "chapter_id": 2811, "verse_number": "१२-३१६-११", "content_sanskrit": "एतस्यापि निशामाहुस्तृतीयमथ कुर्वतः।\nपञ्च कल्पसहस्राणि तावदेवाहरुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2085173, "chapter_id": 2811, "verse_number": "१२-३१६-१२", "content_sanskrit": "शब्दः स्पर्शश्च रूपं च रसो गन्धश्च पञ्चमः।\nएते विशेषा राजेन्द्र महाभूतेषु पञ्चसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2085174, "chapter_id": 2811, "verse_number": "१२-३१६-१३", "content_sanskrit": "यैराविष्टानि भूतानि अहन्यहनि पार्थिव।\nअन्योन्यं स्पृहयन्त्येते अन्योन्यस्याहिते रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2085175, "chapter_id": 2811, "verse_number": "१२-३१६-१४", "content_sanskrit": "अन्योन्यमतिवर्तन्ते अन्योन्यस्पर्धिनस्तथा।\nते वध्यमाना ह्यन्योन्यं गुणैर्हारिभिरव्ययाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2085176, "chapter_id": 2811, "verse_number": "१२-३१६-१५", "content_sanskrit": "इहैव परिवर्तन्ते तिर्यग्योनिप्रवेशिनः।\nत्रीणि कल्पसहस्राणि एतेषामहरुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2085177, "chapter_id": 2811, "verse_number": "१२-३१६-१६", "content_sanskrit": "रात्रिरेतावती चैव मनसश्च नराधिप।\nमनश्चरति राजेन्द्र चरितं सर्वमिन्द्रियैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2085178, "chapter_id": 2811, "verse_number": "१२-३१६-१७", "content_sanskrit": "न चेन्द्रियाणि पश्यन्ति मन एवात्र पश्यति।\nचक्षुः पश्यति रूपाणि मनसा तु न चक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2085179, "chapter_id": 2811, "verse_number": "१२-३१६-१८", "content_sanskrit": "मनसि व्याकुले चक्षुः पश्यन्नपि न पश्यति।\nअथेन्द्रियाणि सर्वाणि पश्यन्तीत्यभिचक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2085180, "chapter_id": 2811, "verse_number": "१२-३१६-१९", "content_sanskrit": "मनस्युपरते राजन्निन्द्रियोपरमो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2085181, "chapter_id": 2811, "verse_number": "१२-३१६-२०", "content_sanskrit": "न चेन्द्रियव्युपरमे मनस्युपरमो भवेत्।\nएवं मनः प्रधानानि इन्द्रियाणि प्रभावयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2085182, "chapter_id": 2811, "verse_number": "१२-३१६-२१", "content_sanskrit": "इन्द्रियाणां तु सर्वेषामीश्वरं मन उच्यते।\nएतद्विशन्ति भूतानि सर्वाणीह महायशः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2085183, "chapter_id": 2811, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि षोडशाधिकत्रिशततमोऽध्यायः॥ ३१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]