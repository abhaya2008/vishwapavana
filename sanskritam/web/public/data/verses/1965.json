[{"id": 2043160, "chapter_id": 1965, "verse_number": "६-१४-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2043161, "chapter_id": 1965, "verse_number": "६-१४-१", "content_sanskrit": "कथं कुरूणामृषभो हतो भीष्मः शिखण्डिना।\nकथं रथार्त्स न्यपतित्पिता मे वासवोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2043162, "chapter_id": 1965, "verse_number": "६-१४-२", "content_sanskrit": "कथमाचक्ष्व मे योधा हीना भीष्मेण संजय ।\nबलिना देवकल्पेन गुर्वर्थे ब्रह्मचारिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2043163, "chapter_id": 1965, "verse_number": "६-१४-३", "content_sanskrit": "तस्मिन्हते महाप्राज्ञे महेष्वासे महाबले ।\nमहासत्वे नरव्याघ्रे किमु आसीन्मनस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2043164, "chapter_id": 1965, "verse_number": "६-१४-४", "content_sanskrit": "आर्तिं परामाविशति मनः शंससि मे हतम् ।\nकुरूणामृषभं वीरमकम्पं पुरुषर्षभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2043165, "chapter_id": 1965, "verse_number": "६-१४-५", "content_sanskrit": "के तं यान्तमनुप्राप्ताः के वास्यसन्पुरोगमाः।\nकेऽतिष्ठन्के न्यवर्तन्त केऽन्ववर्तन्त सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2043166, "chapter_id": 1965, "verse_number": "६-१४-६", "content_sanskrit": "के शूरा रथशार्दूलमद्भुतं क्षत्रियर्षभम् ।\nतथाऽनीकं गाहमानं सहसा पृष्ठतोऽन्वयुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2043167, "chapter_id": 1965, "verse_number": "६-१४-७", "content_sanskrit": "यस्तमोर्क इवापोहन्परसैन्यममित्रहा ।\nसहस्ररश्मिप्रतिमः परेषां भयमादधत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2043168, "chapter_id": 1965, "verse_number": "६-१४-८", "content_sanskrit": "अकरोद्दुष्करं कर्म रणे पाण्डुसुतेषु यः ।\nग्रसमानमनीकानि य एनं पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2043169, "chapter_id": 1965, "verse_number": "६-१४-९", "content_sanskrit": "कृतिनं तं दुराधर्षं सञ्जयास्य त्वमन्तिके ।\nकथं शान्तनवं युद्धे पाण्डवाः प्रत्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2043170, "chapter_id": 1965, "verse_number": "६-१४-१०", "content_sanskrit": "निकृन्तन्तमनीकानि शरदंष्ट्रं मनस्विनम् ।\nचापव्यात्ताननं घोरमसिजिह्वं दुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2043171, "chapter_id": 1965, "verse_number": "६-१४-११", "content_sanskrit": "अनर्हं पुरुषव्याघ्रं ह्रीमन्तमपराजितम् ।\nपातयामास कौन्तेयः कथं तमजितं युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2043172, "chapter_id": 1965, "verse_number": "६-१४-१२", "content_sanskrit": "उग्रधन्वानमुग्रेषुं वर्तमानं रथोत्तमे ।\nपरेषामुत्तमाङ्गानि प्रचिन्वन्तमथेषुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2043173, "chapter_id": 1965, "verse_number": "६-१४-१३", "content_sanskrit": "पाण्डवानां महत्सैन्यं यं दृष्ट्वोद्यतमाहवे ।\nकालाग्निमिव दुर्धर्षं समचेष्टत नित्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2043174, "chapter_id": 1965, "verse_number": "६-१४-१४", "content_sanskrit": "परिकृष्य स सेनां तु दशरात्रमनीकहा ।\nदगामास्तमिवादित्यः कृत्वा कर्म सुदुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2043175, "chapter_id": 1965, "verse_number": "६-१४-१५", "content_sanskrit": "यः स शक्र इवाक्षय्यं वर्षं शरमयं क्षिपन् ।\nजघान युधि योधानामर्बुदं दशभिर्दिनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2043176, "chapter_id": 1965, "verse_number": "६-१४-१६", "content_sanskrit": "स शेते निहतो भूमौ वातभुग्न इव द्रुमः ।\nमम दुर्मन्त्रितेनाजौ यथा नार्हति भारतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2043177, "chapter_id": 1965, "verse_number": "६-१४-१७", "content_sanskrit": "कथं शान्तनवं दृष्ट्वा पाण्डवानामनीकिनी ।\nप्रहर्तुमशकत्तत्र भीष्मं भीमपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2043178, "chapter_id": 1965, "verse_number": "६-१४-१८", "content_sanskrit": "कथं भीष्मेण संग्रामं प्राकुर्वन्पाण्डुनन्दनाः।\nकथं च नाजयद्भीष्मो द्रोणे जीवति सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2043179, "chapter_id": 1965, "verse_number": "६-१४-१९", "content_sanskrit": "कृपे सन्निहिते तत्र भरद्वाजात्मजे तथा।\nभीष्मः प्रहरतां श्रेष्ठः कथं स निधनं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2043180, "chapter_id": 1965, "verse_number": "६-१४-२०", "content_sanskrit": "कथं चातिरथस्तेन पाञ्चाल्येन शिखण्डिना।\nभीष्मो विनिहतो युद्धे देवैरपि दुरासदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2043181, "chapter_id": 1965, "verse_number": "६-१४-२१", "content_sanskrit": "यः स्पर्धते रणे नित्यं जामदग्न्यं महाबलम् ।\nअजितं जामदग्न्येन शक्रतुल्यपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2043182, "chapter_id": 1965, "verse_number": "६-१४-२२", "content_sanskrit": "तं हतं समरे भीष्मं महारथकुलोदितम् ।\nसञ्जयाचक्ष्व मे वीरं येन शर्म न विद्महे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2043183, "chapter_id": 1965, "verse_number": "६-१४-२३", "content_sanskrit": "मामकाः के महेष्वासा नाजहुः सञ्जयाच्युतम् ।\nदुर्योधनसमादिष्टाः के वीराः पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2043184, "chapter_id": 1965, "verse_number": "६-१४-२४", "content_sanskrit": "यच्छिखण्डिमुखाः सर्वे पाण्डवा भीष्ममभ्ययुः ।\nकच्चित्ते कुरवः सर्वे नाजहुः सञ्जयाच्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2043185, "chapter_id": 1965, "verse_number": "६-१४-२५", "content_sanskrit": "अश्मसारमयं नूनं हृदयं मुदृढं मम।\nयच्छ्रुत्वा पुरुषव्याघ्रं हतं भीष्मं न दीर्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2043186, "chapter_id": 1965, "verse_number": "६-१४-२६", "content_sanskrit": "यस्मिन्सत्यं च मेधा च नीतिश्च भरतर्षभे ।\nअप्रमेयाणि दुर्धर्षे कथं स निहतो युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2043187, "chapter_id": 1965, "verse_number": "६-१४-२७", "content_sanskrit": "मौर्वीघोषस्तनयुत्नुः पृषत्कपृषतो महान् ।\nधनुर्ह्रादमहाशब्दो महामेघ इवोन्नतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2043188, "chapter_id": 1965, "verse_number": "६-१४-२८", "content_sanskrit": "योऽभ्यवर्षत कौन्तेयान्सपाञ्चालान्ससृञ्जयान्।\nनिघ्नन्परथान्वीरो दानवानिव वज्रभृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2043189, "chapter_id": 1965, "verse_number": "६-१४-२९", "content_sanskrit": "इष्वस्त्रसागरं घोरं बाणग्रहं दुरासदम् ।\nकार्मुकोर्मिणमक्षय्यमद्वीपं चलमप्लवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2043190, "chapter_id": 1965, "verse_number": "६-१४-३०", "content_sanskrit": "गदासिमकरावासं हयावर्त्तं गजाकुलम् ।\nपदातिमत्स्यकलिलं शङ्खदुन्दुभिनिःस्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2043191, "chapter_id": 1965, "verse_number": "६-१४-३१", "content_sanskrit": "हयान्गजपदातींश्च रथांश्च तरसा बहून् ।\nनिमञ्जयन्तं समरे परवीरापहारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2043192, "chapter_id": 1965, "verse_number": "६-१४-३२", "content_sanskrit": "विदह्यमानं कोपेन तेजसा च परंतपम् ।\nवेलेव मकरावासं के वीराः पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2043193, "chapter_id": 1965, "verse_number": "६-१४-३३", "content_sanskrit": "भीष्मो यदकरोत्कर्म समरे सञ्जयारिहा ।\nदुर्योधनहितार्थाय के तस्यास्य पुरोऽभवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2043194, "chapter_id": 1965, "verse_number": "६-१४-३४", "content_sanskrit": "के रक्षन्दक्षिणं चक्रं भीष्मस्यामिततेजसः ।\nपृष्ठतः के परान्वीरानपासेधन्यतव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2043195, "chapter_id": 1965, "verse_number": "६-१४-३५", "content_sanskrit": "के पुरस्तादवर्तन्त रक्षन्तो भीष्ममन्तिके।\nके रक्षन्नुत्तरं चक्रं वीरा वीरकस्य युध्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2043196, "chapter_id": 1965, "verse_number": "६-१४-३६", "content_sanskrit": "वामे चक्रे वर्तमानाः केऽघ्नन्सञ्जय सृञ्जयान्।\nअग्नतोऽग्न्यमनीकेषु केऽभ्यरक्षन्दुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2043197, "chapter_id": 1965, "verse_number": "६-१४-३७", "content_sanskrit": "पार्श्वतः केऽभ्यरक्षन्त गच्छन्तो दुर्गमां गतिम्।\nसमूहे के परान्वीरान्प्रत्ययुध्यन्त सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2043198, "chapter_id": 1965, "verse_number": "६-१४-३८", "content_sanskrit": "रक्ष्यमाणः कथं वीरैर्गोप्यमानाश्च तेन ते।\nदुर्जयानामनीकानि नाजयंस्तरसा युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2043199, "chapter_id": 1965, "verse_number": "६-१४-३९", "content_sanskrit": "सर्वलोकेश्वरस्येव परमस्य प्रजापतेः।\nकथं प्रहर्तुमपि ते शेकुः सञ्जय पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2043200, "chapter_id": 1965, "verse_number": "६-१४-४०", "content_sanskrit": "यस्मिन्द्वीपे समाश्वस्य युध्यन्ते कुरवः परैः ।\nतं निमग्नं नरव्याघ्रं भीष्मं शंससि सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2043201, "chapter_id": 1965, "verse_number": "६-१४-४१", "content_sanskrit": "यस्य वीर्यं समाश्रित्य मम पुत्रो बृहद्बलः ।\nन पाण्डवानगणयत्कथं स निहतः परैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2043202, "chapter_id": 1965, "verse_number": "६-१४-४२", "content_sanskrit": "यः पुरा विबुधैः सर्वैः सहाये युद्धदुर्मदः ।\nकाङ्क्षितो दानवान्ध्नद्भिः पिता मम महाव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2043203, "chapter_id": 1965, "verse_number": "६-१४-४३", "content_sanskrit": "यस्मिज्जाते महावीर्ये शान्तनुर्लोकविश्रुतः ।\nशोकं दैन्यं च दुःस्वं च प्राजहात्स च तत्क्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2043204, "chapter_id": 1965, "verse_number": "६-१४-४४", "content_sanskrit": "प्रोक्तं परायणं प्राज्ञं स्वधर्मनिरतं शुचिम्।\nवेदवेदाङ्गतत्वज्ञं कथं शंससि मे हतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2043205, "chapter_id": 1965, "verse_number": "६-१४-४५", "content_sanskrit": "सर्वास्त्रविनयोपेतं शान्तं दान्तं मनस्विनम्।\nहतं शान्तनवं श्रुत्वा मन्ये शेषं हतं बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2043206, "chapter_id": 1965, "verse_number": "६-१४-४६", "content_sanskrit": "धर्मादधर्मो बलवान्संप्राप्त इति मे मतिः ।\nयत्र वृद्धं गुरुं हत्वा राज्यमिच्छन्ति पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2043207, "chapter_id": 1965, "verse_number": "६-१४-४७", "content_sanskrit": "जामदग्न्यः पुरा रामः सर्वास्त्रविदनुत्तमः ।\nअम्बार्थमुद्यतः सङ्ख्ये भीष्मेण युधि निर्जितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2043208, "chapter_id": 1965, "verse_number": "६-१४-४८", "content_sanskrit": "तमिन्द्रसमकर्माणं ककुदं सर्वधन्विनाम्।\nहतं शंससि मे भीष्मं किं नु दुःखमतः परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2043209, "chapter_id": 1965, "verse_number": "६-१४-४९", "content_sanskrit": "असकृत्क्षत्रियव्राताः सङ्ख्ये येन विनिर्जिताः ।\nजामदग्न्येन वीरेण परवीरनिघातिना।\nन हतो यो महाबुद्धिः स हतोऽद्य शिखण्डिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2043210, "chapter_id": 1965, "verse_number": "६-१४-५०", "content_sanskrit": "तस्मान्नूनं महावीर्याद्भार्गवाद्युद्धदुर्मदात्।\nतेजोवीर्यबलैर्यूयाञ्शिखण्डी द्रुपदात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2043211, "chapter_id": 1965, "verse_number": "६-१४-५१", "content_sanskrit": "यः शूरं कृतिनं युद्धे सर्वशस्त्रविशारदम्।\nपरमास्त्रविदं वीरं जघान भग्तर्षभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2043212, "chapter_id": 1965, "verse_number": "६-१४-५२", "content_sanskrit": "के वीरास्तममित्रघ्नमन्वयुः शस्त्रसंसदि ।\nशंस मे तद्यथा चासीद्युद्भं भीष्मस्य पाण्डवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2043213, "chapter_id": 1965, "verse_number": "६-१४-५३", "content_sanskrit": "योषेव हतवीरा मे सेन्म पुत्रस्य सञ्जय ।\nअगोपमिव चोद्भ्रान्तं गोकुलं तद्बलं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2043214, "chapter_id": 1965, "verse_number": "६-१४-५४", "content_sanskrit": "पौरुषं सर्वलोकस्य परं यस्मिन्महाहवे।\nपरासक्ते च वस्तस्मिन्कथमासीन्मनस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2043215, "chapter_id": 1965, "verse_number": "६-१४-५५", "content_sanskrit": "जीवितेऽप्यद्य सामर्थ्यं किमिवास्मासु सञ्जय।\nघातयित्वा महावीर्यं पितरं लोकधार्मिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2043216, "chapter_id": 1965, "verse_number": "६-१४-५६", "content_sanskrit": "अगाधे सलिले मग्नां नावं दृष्ट्वेव पारगाः ।\nभीष्मे हते भृशं दुःखान्मन्ये शोचन्ति पुत्रकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2043217, "chapter_id": 1965, "verse_number": "६-१४-५७", "content_sanskrit": "अद्रिसारमयं नूनं हृदयं मम सञ्जय।\nयच्छ्रुत्वा पुरुषव्याघ्रं हतं भीष्मं न दीर्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2043218, "chapter_id": 1965, "verse_number": "६-१४-५८", "content_sanskrit": "यस्मिन्नस्त्राणि मेधा च नीतिश्च पुरुषर्षभे।\nअप्रमेयाणि दुर्धर्षे कथं स निहतो युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2043219, "chapter_id": 1965, "verse_number": "६-१४-५९", "content_sanskrit": "न चास्त्रेण न शौर्येण तपसा मेधया न च।\nन धृत्या न पुनस्त्यागान्मृत्योः कश्चिद्विमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2043220, "chapter_id": 1965, "verse_number": "६-१४-६०", "content_sanskrit": "कालो नूनं महावीर्यः सर्वलोकदुरत्ययः ।\nयत्र शान्तनवं भीष्मं हतं शंससि सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2043221, "chapter_id": 1965, "verse_number": "६-१४-६१", "content_sanskrit": "पुत्रशोकाभिसंतप्तो महद्दुःखमचिन्तयन् ।\nआशंसेऽहं परं त्राणं भीष्माच्छान्तनुनन्दनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2043222, "chapter_id": 1965, "verse_number": "६-१४-६२", "content_sanskrit": "यदादित्यमिवापश्यत्पतितं भ्रुवि सञ्जय ।\nदुर्योधनः शान्तनवं किं तदा प्रत्यपद्मत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2043223, "chapter_id": 1965, "verse_number": "६-१४-६३", "content_sanskrit": "नाहं स्वेषां परेषां वा बुद्ध्या सञ्जय चिन्तयन् ।\nशेषं किंचित्प्रपश्यामि प्रत्यनीके महीक्षिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2043224, "chapter_id": 1965, "verse_number": "६-१४-६४", "content_sanskrit": "दारुणः क्षत्रधर्मोऽयमृषिभिः संप्रदर्शितः ।\nयत्र शान्तनवं हत्वा राज्यमिच्छन्ति पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2043225, "chapter_id": 1965, "verse_number": "६-१४-६५", "content_sanskrit": "वयं वा राज्यमिच्छामो घातयित्वा महाव्रतम्।\nक्षत्रधर्मे स्थिताः पार्था नापराध्यन्ति पुत्रकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2043226, "chapter_id": 1965, "verse_number": "६-१४-६६", "content_sanskrit": "एतदार्येण कर्तव्यं कृच्छ्रास्वापत्सु सञ्जय ।\nपराक्रमः पराशक्तिस्तत्तु तस्मिन्प्रतिष्ठितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2043227, "chapter_id": 1965, "verse_number": "६-१४-६७", "content_sanskrit": "अनीकानि विनिघ्नन्तं ह्रीमन्तमपराजितम् ।\nकथं शान्तनवं तातं पाण्डुपुत्रा न्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2043228, "chapter_id": 1965, "verse_number": "६-१४-६८", "content_sanskrit": "यथायुक्तान्यनीकानि कथं युद्धं महात्मभिः।\nकथं वा निहतो भीष्मः पिता सञ्जय मे परैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2043229, "chapter_id": 1965, "verse_number": "६-१४-६९", "content_sanskrit": "दुर्योधनश्च कर्णश्च शकुनिश्चापि सौबलः ।\nदुःशासनश्च कितवो हते भीष्मे किमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2043230, "chapter_id": 1965, "verse_number": "६-१४-७०", "content_sanskrit": "यच्छरीरैरुपास्तीर्णां नरवारणवाजिनाम् ।\nशरशक्तिमहाखङ्गतोमराक्षां महाभयाम्।\nप्राविशन्कितवा मन्दाः सभां युद्धदुरासदाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2043231, "chapter_id": 1965, "verse_number": "६-१४-७१", "content_sanskrit": "प्राणद्यूते प्रतिभये केऽदीव्यन्त नरर्षभाः ।\nके जीयन्ते जितास्तत्र कृतलक्ष्या निपातिताः ।\nअन्ये भीष्माच्चान्तनवात्तन्ममाचक्ष्व सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2043232, "chapter_id": 1965, "verse_number": "६-१४-७२", "content_sanskrit": "न हि मे शान्तिरस्तीह श्रुत्वा देवव्रतं हतम्।\nपितरं भीमकर्माणं भीष्ममाहवशोभिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2043233, "chapter_id": 1965, "verse_number": "६-१४-७३", "content_sanskrit": "आर्तिं मे हृदये रूढां महतीं पुत्रहानिजाम्।\nत्वं हि मे सर्पिषेवाग्निमुद्दीपयसि सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2043234, "chapter_id": 1965, "verse_number": "६-१४-७४", "content_sanskrit": "महान्तं भारमुद्यम्य विश्रुतं सार्वलौकिकम्।\nदृष्ट्वा विनिहतं भीष्मं मन्ये शोचन्ति पुत्रकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2043235, "chapter_id": 1965, "verse_number": "६-१४-७५", "content_sanskrit": "श्रोष्यामि तानि दुःखानि दुर्योधनकृतान्यहम् ।\nतस्मान्मे सर्वमाचक्ष्व यद्वृत्तं तत्र सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2043236, "chapter_id": 1965, "verse_number": "६-१४-७६", "content_sanskrit": "यद्वृत्तं तत्र संग्रामे मन्दस्याबुद्धिसंभवम् ।\nअपनीतं सुनीतं यत्तन्ममाचक्ष्व सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2043237, "chapter_id": 1965, "verse_number": "६-१४-७७", "content_sanskrit": "यत्कृतं तत्र संग्रामे भीष्मेण जयमिच्छता ।\nतेजोयुक्तं कृतास्त्रेण शंस तच्चाप्यशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2043238, "chapter_id": 1965, "verse_number": "६-१४-७८", "content_sanskrit": "यथा तदभवद्युद्धं कुरुपाण्डवसेनयोः ।\nक्रमेण येन यस्मिंश्च काले यच्च यथाऽभवत् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2043239, "chapter_id": 1965, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भगवद्गीतापर्वणि चतुर्दशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]