[{"id": 2073150, "chapter_id": 2544, "verse_number": "१२-४९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2073151, "chapter_id": 2544, "verse_number": "१२-४९-१", "content_sanskrit": "ततो रामस्य तत्कर्म श्रुत्वा राजा युधिष्ठिरः।\nविस्मयं परमं गत्वा प्रत्युवाच जनार्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2073152, "chapter_id": 2544, "verse_number": "१२-४९-२", "content_sanskrit": "अहो रामस्य वार्ष्णेय शक्रस्येव महात्मनः।\nविक्रमो वसुधा येन क्रोधान्निःक्षत्रिया कृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2073153, "chapter_id": 2544, "verse_number": "१२-४९-३", "content_sanskrit": "गोभिः समुद्रेण तथा गोलाङ्गूलर्क्षवानरैः।\nगुप्ता रामभयोद्विग्नाः क्षत्रियाणां कुलोद्वहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2073154, "chapter_id": 2544, "verse_number": "१२-४९-४", "content_sanskrit": "अहो धन्यो नृलोकोऽयं समाग्याश्च नरा भुवि।\nयत्र कर्मेदृशं धर्म्यं द्विजाग्र्यैः कृतमच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2073155, "chapter_id": 2544, "verse_number": "१२-४९-५", "content_sanskrit": "कथयन्तौ कथां तात तावच्युतयुधिष्ठिरौ।\nजग्मतुर्यत्र गाङ्गेयः शरतल्पगतः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2073156, "chapter_id": 2544, "verse_number": "१२-४९-६", "content_sanskrit": "ततस्ते ददृशुर्भीष्मं शरप्रस्तरशायिनम्।\nस्वरश्मिमालासंवीतं सायंसूर्यसमप्रभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2073157, "chapter_id": 2544, "verse_number": "१२-४९-७", "content_sanskrit": "उपास्यमानं मुनिभिर्देवैरिव शतक्रतुम्।\nदेशे परमधर्मिष्ठे नदीमोघवतीमनु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2073158, "chapter_id": 2544, "verse_number": "१२-४९-८", "content_sanskrit": "दूरादेव तमालोक्य कृष्णो राजा च धर्मजः।\nचत्वारः पाण्डवाश्चैव ते च शारद्वतादयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2073159, "chapter_id": 2544, "verse_number": "१२-४९-९", "content_sanskrit": "अवम्कन्द्याथ वाहेभ्यः संयम्य प्रचलं मनः।\nएकीकृत्येन्द्रियग्राममुपतम्थुर्महामुनीन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2073160, "chapter_id": 2544, "verse_number": "१२-४९-१०", "content_sanskrit": "अभिवाद्य तु गोविन्दः सात्यकिस्ते च पार्थिवाः।\nव्यासादीस्तानृपीन्पश्चाद्गाङ्गेयमुपतस्थिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2073161, "chapter_id": 2544, "verse_number": "१२-४९-११", "content_sanskrit": "तपोवृद्धि ततः पृष्ट्वा गाङ्गेयं यदुपुङ्गवः।\nपरिवार्य ततः सर्वे निपेदुः पुरुषर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2073162, "chapter_id": 2544, "verse_number": "१२-४९-१२", "content_sanskrit": "ततो निशाम्य गाङ्गेयं शाम्यमानमिवानलम्।\nकिंचिद्दीनमना भीष्ममितिहोवाच केशवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2073163, "chapter_id": 2544, "verse_number": "१२-४९-१३", "content_sanskrit": "कच्चिज्ज्ञानानि सर्वाणि प्रसन्नानि यथापुरम्।\nकच्चिन्न व्याकुला चैव बुद्धिस्ते वदतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2073164, "chapter_id": 2544, "verse_number": "१२-४९-१४", "content_sanskrit": "शराभिघातदुःखार्तं कच्चिद्गात्रं न दूयते।\nमानसादपि दुःखाद्धि शारीरं बलवत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2073165, "chapter_id": 2544, "verse_number": "१२-४९-१५", "content_sanskrit": "वरदानात्पितुः कामं छन्दमृत्युरसि प्रभो।\nशन्तनोर्धर्मनित्यस्य न त्वेतदिह कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2073166, "chapter_id": 2544, "verse_number": "१२-४९-१६", "content_sanskrit": "सुमूक्ष्मोऽपि तु देहे वै शल्यो जनयते रुजम्।\nकिंपुनः शरसंघातैश्चितस्य तव पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2073167, "chapter_id": 2544, "verse_number": "१२-४९-१७", "content_sanskrit": "कामं नैतत्तवाख्येयं प्राणिनां प्रभवाप्ययौ।\nभवानुपदिशेच्छ्रेयो देवानामपि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2073168, "chapter_id": 2544, "verse_number": "१२-४९-१८", "content_sanskrit": "यच्च भूतं भविष्यं च भवच्च पुरुषर्षभ।\nसर्वं तज्ज्ञानवृद्धस्य तव पाणाविवाहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2073169, "chapter_id": 2544, "verse_number": "१२-४९-१९", "content_sanskrit": "संसारस्येह भूतानां धर्मस्य च फलोदयः।\nविदितस्ते महाप्राज्ञ त्वं हि धर्ममयो निधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2073170, "chapter_id": 2544, "verse_number": "१२-४९-२०", "content_sanskrit": "त्व, हि राज्ये स्थितं स्फीते समग्राङ्गमरोगिणम्।\nस्त्रीसहस्रैः परिवृतं पश्यामीवोर्ध्वरेतसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2073171, "chapter_id": 2544, "verse_number": "१२-४९-२१", "content_sanskrit": "ऋते शान्तनवाद्भीष्मात्रिषु लोकेषु पार्थिवम्।\nसत्यधर्मान्महावीर्याच्छूराद्धर्मैकतत्परात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2073172, "chapter_id": 2544, "verse_number": "१२-४९-२२", "content_sanskrit": "मृत्युमावार्य तपसा शरसंस्तरशायिनः।\nत्रिवर्गप्रभवं कंचिन्न च तातानुशुश्रुम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2073173, "chapter_id": 2544, "verse_number": "१२-४९-२३", "content_sanskrit": "सत्ये तपसि दाने च यज्ञाधिकरणे तथा।\nधनुर्वेदे च वेदे च नित्यं चैवान्ववेक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2073174, "chapter_id": 2544, "verse_number": "१२-४९-२४", "content_sanskrit": "अनृशंसं शुचिं दान्तं सर्वभूतहिते रतम्।\nमहारथं त्वत्सदृशं न कंचिदनुशुश्रुम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2073175, "chapter_id": 2544, "verse_number": "१२-४९-२५", "content_sanskrit": "त्वं हि देवान्सगन्धर्वानसुरान्यक्षराक्षसान्।\nशक्तस्त्वेकरथेनैव विजेतुं नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2073176, "chapter_id": 2544, "verse_number": "१२-४९-२६", "content_sanskrit": "स त्वं भीष्म महाबाहो वसूनां वासवोपमः।\nनित्यं विप्रैः समाख्यातो नवमोऽनवमो गुणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2073177, "chapter_id": 2544, "verse_number": "१२-४९-२७", "content_sanskrit": "अहं च त्वाऽभिजानामि स्वयं पुरुषसत्तम।\nत्रिदशेष्वपि विख्यातस्त्वं शक्त्या पुरुषोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2073178, "chapter_id": 2544, "verse_number": "१२-४९-२८", "content_sanskrit": "मनुष्येषु मनुष्येन्द्र न दृष्टो न च मे श्रुतः।\nभवतो हि गुणैस्तुल्यः पृथिव्यां पुरुषः क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2073179, "chapter_id": 2544, "verse_number": "१२-४९-२९", "content_sanskrit": "त्वं हि सर्वगुणै राजन्देवानप्यतिरिच्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2073180, "chapter_id": 2544, "verse_number": "१२-४९-३०", "content_sanskrit": "तपसा हि भवाञ्शक्तः स्रष्टुं लोकांश्चराचरान्।\nकिंपुनश्चात्मनो लोकानुत्तमानुत्तमैर्गुणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2073181, "chapter_id": 2544, "verse_number": "१२-४९-३१", "content_sanskrit": "तदस्य तप्यमानस्य ज्ञातीनां संक्षयेन वै।\nज्येष्ठस्य पाण्डुपुत्रस्य शोकं भीष्म व्यपानुद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2073182, "chapter_id": 2544, "verse_number": "१२-४९-३२", "content_sanskrit": "ये हि धर्माः समाख्याताश्चातुर्वर्ण्यस्य भारत।\nचातुराश्रम्यसंयुक्ताः सर्वे ते विदितास्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2073183, "chapter_id": 2544, "verse_number": "१२-४९-३३", "content_sanskrit": "चातुर्विद्ये च ये प्रोक्ताश्चातुर्होत्रे च भारत।\nयोगे साङ्ख्ये च नियता ये च धर्माः सनातनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2073184, "chapter_id": 2544, "verse_number": "१२-४९-३४", "content_sanskrit": "चातुर्वर्ण्यस्य यश्चोक्तो धर्मो न स्म विरुध्यते।\nसेव्यमानः सवैयाख्यो गाङ्गेय विदितस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2073185, "chapter_id": 2544, "verse_number": "१२-४९-३५", "content_sanskrit": "प्रतिलोमप्रसूतानां म्लेच्छानां चैव यः स्मृतः।\nदेशजातिकुलानां च जानीषे धर्मलक्षणम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2073186, "chapter_id": 2544, "verse_number": "१२-४९-३६", "content_sanskrit": "वेदोक्तो यश्च शिष्टोक्तः सदैव विदितस्तव।\n`प्रवृत्तश्च निवृत्तश्च स चापि विदितस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2073187, "chapter_id": 2544, "verse_number": "१२-४९-३७", "content_sanskrit": "इतिहासपुराणार्थाः कार्त्स्न्येन विदितास्तव।\nधर्मशास्त्रं च सकलं नित्यं मनसि ते स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2073188, "chapter_id": 2544, "verse_number": "१२-४९-३८", "content_sanskrit": "ये च केचन लोकेऽस्मिन्नर्थाः संशयकारकाः।\nतेषां छेत्ता नास्ति लोके त्वदन्यः पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2073189, "chapter_id": 2544, "verse_number": "१२-४९-३९", "content_sanskrit": "स पाण्डवेयस्य मनःसमुत्थितं\nनरेन्द्र शोकं व्यपकर्ष मेधया।\nभवद्विधा ह्युत्तमबुद्धिर्विस्तरा\nविमुह्यमानस्य जनस्य शान्तये॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2073190, "chapter_id": 2544, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि एकोनपञ्चाशोऽध्यायः॥ ४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]