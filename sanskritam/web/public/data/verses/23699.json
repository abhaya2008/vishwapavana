[{"id": 7003699000, "chapter_id": 23699, "verse_number": "१-४-७-१", "content_sanskrit": "नंदिकेश्वर उवाच ।\nरक्तोत्पलैरर्कवारे यः शोणाद्रीशमर्चयेत् ।\nअवश्यं तस्य सिध्यंति सार्वभौममहर्द्धयः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003699001, "chapter_id": 23699, "verse_number": "१-४-७-२", "content_sanskrit": "सौम्यवारेऽरुणाद्रीशं कस्तूरीकरवीरकैः ।\nयः पूजयति तस्य स्यात्सत्यलोके सुखासिका ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003699002, "chapter_id": 23699, "verse_number": "१-४-७-३", "content_sanskrit": "गुरुवारे सितांभोजैः शोणेशं वरिवस्यतः ।\nजनलोके चिरं वासः सिद्धैः सह भविष्यति ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003699003, "chapter_id": 23699, "verse_number": "१-४-७-४", "content_sanskrit": "चंपकैर्मल्लिकाभिश्च शुक्रवारे समर्चयेत् ।\nतपोलोकं प्रपद्येत ब्रह्मर्षिभिरभिष्टुतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003699004, "chapter_id": 23699, "verse_number": "१-४-७-५", "content_sanskrit": "सौरिवारे च जातीभिस्समाराध्यारुणेश्वरम् ।\nन जातु यमलोकानां पापीयानपि कल्पते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003699005, "chapter_id": 23699, "verse_number": "१-४-७-६", "content_sanskrit": "प्रथमायां तिथौ देवस्योपहारं समर्पयेत् ।\nयः पायसेन स भवेद्धनधान्यसमृद्धिमान् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003699006, "chapter_id": 23699, "verse_number": "१-४-७-७", "content_sanskrit": "द्वितीयस्यां तिथौ भक्त्या यो दध्यन्नं निवेदयेत् ।\nस भवेद्भाग्यवाञ्छ्रेष्ठः सोमपाश्च भवेद्ध्रुवम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003699007, "chapter_id": 23699, "verse_number": "१-४-७-८", "content_sanskrit": "तृतीयायां च योऽपूपैः शोणेशं परितर्पयेत् ।\nतस्या व्याहतमारोग्यमाशरीरं भविष्यति ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003699008, "chapter_id": 23699, "verse_number": "१-४-७-९", "content_sanskrit": "चतुर्थ्यामरुणेशाय पूर्णकुम्भोत्करादिकम् ।\nनिवेदयति यस्तस्य भवेत्पूर्णमनोरथः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003699009, "chapter_id": 23699, "verse_number": "१-४-७-१०", "content_sanskrit": "मुद्गौदनं च पंचम्यामुपहारं प्रकल्पयेत ।\nशोणेश्वराय भक्त्या यः स स्यादक्षय्यवैभवः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003699010, "chapter_id": 23699, "verse_number": "१-४-७-११", "content_sanskrit": "षष्ठ्यां गुडौदनं दद्यादरुणाचलशम्भवे ।\nभक्त्या यस्तस्य सन्तानो न कदाचित्प्रहीयते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003699011, "chapter_id": 23699, "verse_number": "१-४-७-१२", "content_sanskrit": "तिलौदनं यस्सप्तम्यां शोणेशाय समर्पयेत् ।\nस दीनोऽप्यधमर्णत्वमयत्नेन व्यपोहति ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003699012, "chapter_id": 23699, "verse_number": "१-४-७-१३", "content_sanskrit": "अष्टम्यां राजशाल्यन्नं यो दद्याच्छोणशम्भवे ।\nतस्य सेवां विनापि स्याद्राजलोको वशीकृतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003699013, "chapter_id": 23699, "verse_number": "१-४-७-१४", "content_sanskrit": "गोधूमान्नं नवम्यां च शोणाद्रीशाय योऽर्पयेत् ।\nराजयक्ष्मादयस्तस्य न भविष्यंति जातु च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003699014, "chapter_id": 23699, "verse_number": "१-४-७-१५", "content_sanskrit": "दशम्यां शोणनाथाय यः करंभं निवेदयेत् ।\nस भवेत्सर्वलोकानां सदैव प्रीतिभाजनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003699015, "chapter_id": 23699, "verse_number": "१-४-७-१६", "content_sanskrit": "पृथुकैरुपहारान्य एकादश्यां प्रकल्पयेत् ।\nअरुणाचलनाथस्य स भवेदकुतोभयः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003699016, "chapter_id": 23699, "verse_number": "१-४-७-१७", "content_sanskrit": "द्वादश्यां शोणनाथाय सूपौदननिवेदनम् ।\nयः करोति भवेत्तस्य निर्विघातो मनोरथः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003699017, "chapter_id": 23699, "verse_number": "१-४-७-१८", "content_sanskrit": "यः सक्तूनरुणेशाय त्रयोदश्यां समर्पयेत् ।\nतस्या व्याकुलचित्त्वमश्रांतमपि जायते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003699018, "chapter_id": 23699, "verse_number": "१-४-७-१९", "content_sanskrit": "अर्पयेच्छोणनाथाय फलानि विविधानि यः ।\nचतुर्दश्यां स मूढोऽपि सिद्धसारस्वतो भवेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003699019, "chapter_id": 23699, "verse_number": "१-४-७-२०", "content_sanskrit": "यः पौर्णमास्यां शोणाद्रिनाथाय विनिवेदयेत् ।\nपनसस्य फलं तस्य चक्षूरोगो न जायते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003699020, "chapter_id": 23699, "verse_number": "१-४-७-२१", "content_sanskrit": "कुह्वां च संगमे भक्त्या कंदमूलादि योऽर्पयेत् ।\nशोणाचलेश्वरायास्य तुष्यंति पितरः किल ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003699021, "chapter_id": 23699, "verse_number": "१-४-७-२२", "content_sanskrit": "अश्विन्यामरुणेशाय दद्याद्वासांसि भक्तिमान् ।\nभरण्यामरुणेशाय दद्यादाभरणान्यपि ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003699022, "chapter_id": 23699, "verse_number": "१-४-७-२३", "content_sanskrit": "कृत्तिकासु प्रदीपांश्च रोहिण्यां रौप्यमर्पयेत् ।\nमृगशीर्षे मलयजमार्द्रायां हरिचंदनम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003699023, "chapter_id": 23699, "verse_number": "१-४-७-२४", "content_sanskrit": "पुनर्वसौ मृगमदं पुष्ये कर्पूरमर्पयेत् ।\nकाश्मीरोद्भवमाश्लेषे मघायां तुहिनोदकम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003699024, "chapter_id": 23699, "verse_number": "१-४-७-२५", "content_sanskrit": "तांबूलं पूर्वफाल्गुन्यां धूपमुत्तरफाल्गुने ।\nकालागुरूंश्च हस्तर्क्षे चित्रायां यक्षकर्दमम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003699025, "chapter_id": 23699, "verse_number": "१-४-७-२६", "content_sanskrit": "स्वात्यां सुवासिनीवृंदं विशाखायां प्रकीर्णकम् ।\nमैत्रे मुक्तातपत्रं च ज्येष्ठायां धैनुकान्यपि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003699026, "chapter_id": 23699, "verse_number": "१-४-७-२७", "content_sanskrit": "मूले मुक्तासरान्पूर्वाषाढे मुकुटमर्पयेत् ।\nरत्नानि चोत्तराषाढे श्रवणे भद्रपीठिकाम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003699027, "chapter_id": 23699, "verse_number": "१-४-७-२८", "content_sanskrit": "अष्टापदं धनिष्ठायां वासः शतभिषज्यपि ।\nपूर्वाभाद्रपदे भोगानुत्तरायां तुरंगमान् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003699028, "chapter_id": 23699, "verse_number": "१-४-७-२९", "content_sanskrit": "रेवत्यां च रथं हैमं प्रदद्याच्छोणशंभवे ।\nदद्यात्कृत्वा महापूजां तत एवार्पयेन्नरः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003699029, "chapter_id": 23699, "verse_number": "१-४-७-३०", "content_sanskrit": "पूज्यो राशिषु मेषादिष्वरुणेथो विशेषतः ।\nसिंदुवारैः कुरबकैः ककुभैः पाटलैः क्रमात् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003699030, "chapter_id": 23699, "verse_number": "१-४-७-३१", "content_sanskrit": "कुटजैर्नीपकुसुमैर्जीवंतीमल्लिकादिभिः ।\nसरोरुहैर्दमनकैर्नद्यावर्तसरोरुहैः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003699031, "chapter_id": 23699, "verse_number": "१-४-७-३२", "content_sanskrit": "पंचामृतेन स्नपयन्नुभयोरुपरागयोः ।\nपंचाक्षरेण कुर्वीत शोणनाथस्य भक्तितः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003699032, "chapter_id": 23699, "verse_number": "१-४-७-३३", "content_sanskrit": "स्नपनं पञ्चगव्येन द्वयोरयनयोरपि ।\nषडक्षरेण कुर्वीत गव्येन स्नपनक्रियाम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003699033, "chapter_id": 23699, "verse_number": "१-४-७-३४", "content_sanskrit": "प्रणवेनैव कुर्वीत क्षीरेण स्नपनक्रियाम् ।\nअरुणाचलनाथस्य भक्त्या विषुवयोर्द्वयोः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003699034, "chapter_id": 23699, "verse_number": "१-४-७-३५", "content_sanskrit": "प्राह्णे स्याद्रुद्रतुलसी मध्याह्ने कृतमालकम् ।\nअपराह्णे मल्लिका च शोणाद्रीशस्य शस्यते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003699035, "chapter_id": 23699, "verse_number": "१-४-७-३६", "content_sanskrit": "अद्धोदये च स्नपयेत्सहस्रकलशोदकैः ।\nशतरुद्रीयमुच्चार्य श्रीशोणाचलशंभवे ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003699036, "chapter_id": 23699, "verse_number": "१-४-७-३७", "content_sanskrit": "शिवरात्रौ विशेषेण त्रिशिखैर्बिल्वपत्रकैः ।\nकमलैः कर्णिकारैश्च जागरूको यतेंद्रियः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003699037, "chapter_id": 23699, "verse_number": "१-४-७-३८", "content_sanskrit": "गीतवादित्रनृत्यैश्च दिव्यागमविधानतः ।\nपूजयेदपवर्गार्थं शोणशैले महेश्वरम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003699038, "chapter_id": 23699, "verse_number": "१-४-७-३९", "content_sanskrit": "मासि पौषे च देवस्य कुर्यादाग्नेयमुत्सवम् ।\nनवान्नैरुपदंशाद्यैर्व्याहृतीरुच्चरन्बुधः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003699039, "chapter_id": 23699, "verse_number": "१-४-७-४०", "content_sanskrit": "वैशाखे च विशाखायां शिवतंत्रानुसारतः ।\nशोणाचलेश्वरस्यास्य कुर्याद्दमनकोत्सवम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003699040, "chapter_id": 23699, "verse_number": "१-४-७-४१", "content_sanskrit": "प्राबोधिक मार्गशीर्षे प्रातर्निर्माय सामभिः ।\nमहापूजां प्रकुर्वीत शोणशैलस्य भक्तिमान् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003699041, "chapter_id": 23699, "verse_number": "१-४-७-४२", "content_sanskrit": "शनिप्रदोषेष्वार्द्रासु व्यतीपातेषु पर्वसु ।\nसोमार्कवारयोश्चार्चेच्छोणाद्रीशं यथागमम ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003699042, "chapter_id": 23699, "verse_number": "१-४-७-४३", "content_sanskrit": "दीक्षोपनयनोद्वाहपुत्रजन्मादिकेष्वपि ।\nविशेषपूजां कुर्वीत शोणनाथस्य भक्तिमान् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003699043, "chapter_id": 23699, "verse_number": "१-४-७-४४", "content_sanskrit": "अपि स्वजन्मनक्षत्रे संपत्स्वापत्सु भीतिषु ।\nप्रवेशनिर्गमनयोश्चार्चनीयोऽरुणेश्वरः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003699044, "chapter_id": 23699, "verse_number": "१-४-७-४५", "content_sanskrit": "व्रतिचक्रागमे पादबंधने नववैभवे ।\nअरुणेशार्चनं कुर्यादभियानेषु च द्विषाम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003699045, "chapter_id": 23699, "verse_number": "१-४-७-४६", "content_sanskrit": "स्मरेदतिदवीयांश्चेत्पश्येत्पर्यंतगो यदि ।\nस्थितश्चेदरुणक्षेत्रे त्रिकालं पूजयेच्छिवम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003699046, "chapter_id": 23699, "verse_number": "१-४-७-४७", "content_sanskrit": "किमन्यद्वद वत्सेति उद्धृत्य भुजमुच्यते ।\nअरुणक्षेत्रतो नान्यदलं स्वर्गापवर्गयोः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003699047, "chapter_id": 23699, "verse_number": "१-४-७-४८", "content_sanskrit": "स्मरणेन मनःश्रोत्रे श्रवणाद्दर्शनादृशौः ।\nजिह्वां च कीर्त्तनाच्छोणक्षेत्रं सद्यः पुनात्यलम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003699048, "chapter_id": 23699, "verse_number": "१-४-७-४९", "content_sanskrit": "अरुणेस्मिन्महाक्षेत्रे देहिभिर्लब्धजन्मभिः ।\nजीवद्भिर्लभ्यते भोगो मोक्षश्चोन्मुक्तजीवितैः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003699049, "chapter_id": 23699, "verse_number": "१-४-७-५०", "content_sanskrit": "अन्यत्र मुक्तदेहानामप्यत्र श्राद्धकर्मणा ।\nअपि पापात्मनां पुंसामपवर्गो भविष्यति ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003699050, "chapter_id": 23699, "verse_number": "१-४-७-५१", "content_sanskrit": "अयोध्यां मथुरां मायां काशीं कांचीमवंतिकाम् ।\nद्वारकां चारुणक्षेत्रमतिशेते न संशयः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003699051, "chapter_id": 23699, "verse_number": "१-४-७-५२", "content_sanskrit": "इत्युक्तवंतं च शिलादपुत्रं मृकण्डुसूनुः पुनरप्युवाच ।\nमाहात्म्यमेतन्महनीयकीर्ते भूयोपि पृच्छामि वदस्व मह्यम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003699052, "chapter_id": 23699, "verse_number": "१-४-७-५३", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्डेऽरुणाचलमाहात्म्य उत्तरार्धे काम्यकर्मवर्णनं नाम सप्तमोऽध्यायः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]