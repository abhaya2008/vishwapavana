[{"id": 6000297000, "chapter_id": 10297, "verse_number": null, "content_sanskrit": "अथ एकाधिकशततमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000297001, "chapter_id": 10297, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.001.m4a", "display_order": 2}, {"id": 6000297002, "chapter_id": 10297, "verse_number": "१०-१०१-१", "content_sanskrit": "स इत्थं द्विजमुख्येन सह सङ्कथयन् हरिः।\nसर्वभूतमनोऽभिज्ञः स्मयमान उवाच तम्॥ १०/१०१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.002.m4a", "display_order": 3, "topics": [{"text": "कृष्णस्य पृथुकादानम्", "range": "१–९"}]}, {"id": 6000297003, "chapter_id": 10297, "verse_number": "१०-१०१-२", "content_sanskrit": "ब्रह्मण्यो ब्राह्मणं कृष्णो भगवान् प्रहसन्निव।\nप्रेम्णा निरीक्षणेनैव प्रेक्षन् खलु सतां पतिः॥ १०/१०१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.003.m4a", "display_order": 4}, {"id": 6000297004, "chapter_id": 10297, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.004.m4a", "display_order": 5}, {"id": 6000297005, "chapter_id": 10297, "verse_number": "१०-१०१-३", "content_sanskrit": "किमुपायनमानीतं ब्रह्मन् मे भवता गृहात्।\nअल्पमप्याहृतं भक्तैः प्रेम्णा भूर्येव मे भवेत्॥ १०/१०१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.005.m4a", "display_order": 6}, {"id": 6000297006, "chapter_id": 10297, "verse_number": "१०-१०१-४", "content_sanskrit": "भूर्यप्यभक्तोपहृतं न मे तोषाय कल्पते। पत्रं पुष्पं फलं तोयं यो मे भक्त्या प्रयच्छति।\nतदहं भक्त्युपहृतमश्नामि प्रयतात्मनः॥ १०/१०१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.006.m4a", "display_order": 7}, {"id": 6000297007, "chapter_id": 10297, "verse_number": "१०-१०१-५", "content_sanskrit": "इत्युक्तोऽपि द्विजस्तस्मै व्रीडितः पतये श्रियः।\nपृथुकप्रसृतिं राजन्न प्रायच्छदवाङ्मुखः॥ १०/१०१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.007.m4a", "display_order": 8}, {"id": 6000297008, "chapter_id": 10297, "verse_number": "१०-१०१-६", "content_sanskrit": "सर्वभूतात्मदृक् साक्षात् तस्यागमनकारणम्।\nविज्ञाय चिन्तयन् नायं श्रीकामो माऽभजत् पुरा॥ १०/१०१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.008.m4a", "display_order": 9}, {"id": 6000297009, "chapter_id": 10297, "verse_number": "१०-१०१-७", "content_sanskrit": "पत्न्याः पतिव्रतायास्तु सखा प्रियचिकीर्षया।\nप्राप्तो मामस्य दास्यामि सम्पदो मर्त्यदुर्लभाः॥ १०/१०१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.009.m4a", "display_order": 10}, {"id": 6000297010, "chapter_id": 10297, "verse_number": "१०-१०१-८", "content_sanskrit": "इत्थं विचिन्त्य वसनाच्चीरबद्धान् द्विजन्मनः।\nस्वयं जहार किमिदमिति पृथुकतण्डुलान्॥ १०/१०१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.010.m4a", "display_order": 11}, {"id": 6000297011, "chapter_id": 10297, "verse_number": "१०-१०१-९", "content_sanskrit": "एकमुष्टिं सकृज्जग्ध्वा द्वितीयं जग्धुमाददे।\nतावच्छ्रीर्जगृहे हस्तं सत्वरा परमेष्ठिनः॥ १०/१०१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.011.m4a", "display_order": 12}, {"id": 6000297012, "chapter_id": 10297, "verse_number": "१०-१०१-१०", "content_sanskrit": "एतावताऽलं सर्वात्मन् सर्वसम्पत्समृद्धये।\nअस्मिन् लोके तथाऽमुष्मिन् पुंसस्त्वत्तोषकारणम्॥ १०/१०१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.012.m4a", "display_order": 13, "topics": [{"text": "कुचेलस्य प्रतिनिवृत्तिः", "range": "१०–१८"}]}, {"id": 6000297013, "chapter_id": 10297, "verse_number": "१०-१०१-११", "content_sanskrit": "ब्राह्मणस्तां तु रजनीमुषित्वाऽच्युतमन्दिरे।\nभुक्त्वा पीत्वा सुखं सुप्त्वा मेन आत्मानमिन्द्रवत्॥ १०/१०१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.013.m4a", "display_order": 14}, {"id": 6000297014, "chapter_id": 10297, "verse_number": "१०-१०१-१२", "content_sanskrit": "श्वोभूते विश्वभावेन स्वसखेनाभिवन्दितः।\nजगाम स्वालयं तात पथ्यनुव्रज्य नन्दितः॥ १०/१०१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.014.m4a", "display_order": 15}, {"id": 6000297015, "chapter_id": 10297, "verse_number": "१०-१०१-१३", "content_sanskrit": "स चालब्ध्वा धनं सख्युर्न च याचितवान् स्वयम्।\nस्वगृहान् व्रीडितोऽगच्छन्महद्दर्शननिर्वृतः॥ १०/१०१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.015.m4a", "display_order": 16}, {"id": 6000297016, "chapter_id": 10297, "verse_number": "१०-१०१-१४", "content_sanskrit": "अहो ब्रह्मण्यदेवस्य दृष्टा ब्रह्मण्यता मया।\nयद् दरिद्रतमो लक्ष्मीमाश्लिष्टो बिभ्रतोरसि॥ १०/१०१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.016.m4a", "display_order": 17}, {"id": 6000297017, "chapter_id": 10297, "verse_number": "१०-१०१-१५", "content_sanskrit": "क्‍वाहं दरिद्रः पापीयान् क्‍व कृष्णः श्रीनिकेतनः।\nब्रह्मबन्धुरिति स्माहं बाहुभ्यां परिरम्भितः॥ १०/१०१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.017.m4a", "display_order": 18}, {"id": 6000297018, "chapter_id": 10297, "verse_number": "१०-१०१-१६", "content_sanskrit": "निवासितः प्रियाजुष्टे पर्यङ्के भ्रातरो यथा।\nमहिष्या वीजितः श्रान्तो बालव्यजनहस्तया॥ १०/१०१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.018.m4a", "display_order": 19}, {"id": 6000297019, "chapter_id": 10297, "verse_number": "१०-१०१-१७", "content_sanskrit": "शुश्रूषया परमया पादसंवहनादिभिः।\nपूजितो देवदेवेन विप्रदेवेन देववत्॥ १०/१०१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.019.m4a", "display_order": 20}, {"id": 6000297020, "chapter_id": 10297, "verse_number": "१०-१०१-१८", "content_sanskrit": "स्वर्गापवर्गयोः पुंसां रसायां दिवि सम्पदाम्।\nसर्वासामपि सिद्धीनां मूलं तच्चरणार्चनम्॥ १०/१०१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.020.m4a", "display_order": 21}, {"id": 6000297021, "chapter_id": 10297, "verse_number": "१०-१०१-१९", "content_sanskrit": "अधनोऽयं धनं प्राप्य माद्यन्नुच्चैर्न मां स्मरेत्।\nइति कारुणिको नूनं धनं मे भूरि नाददात्॥ १०/१०१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.021.m4a", "display_order": 22, "topics": [{"text": "तद्गृहवैभववर्णनम्", "range": "१९–४०"}]}, {"id": 6000297022, "chapter_id": 10297, "verse_number": "१०-१०१-२०", "content_sanskrit": "इति तच्चित्तगत्याऽन्तः प्राप्तो निजगृहान्तिकम्।\nसूर्यानलेन्दुसङ्काशैर्विमानैः सर्वतो वृतम्॥ १०/१०१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.022.m4a", "display_order": 23}, {"id": 6000297023, "chapter_id": 10297, "verse_number": "१०-१०१-२१", "content_sanskrit": "विचित्रोपवनोद्यानैः कूजद्द्विजकुलाकुलैः।\nप्रोत्फुल्लकुमुदाम्भोजकल्हारोत्पलवारिभिः॥ १०/१०१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.023.m4a", "display_order": 24}, {"id": 6000297024, "chapter_id": 10297, "verse_number": "१०-१०१-२२", "content_sanskrit": "जुष्टं स्वलङ्कृतैः पुम्भिः स्‍त्रीभिश्च हरिणाक्षिभिः।\nकिमिदं कस्य वा स्थानं कथं तदिदमित्यभूत्॥ १०/१०१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.024.m4a", "display_order": 25}, {"id": 6000297025, "chapter_id": 10297, "verse_number": "१०-१०१-२३", "content_sanskrit": "एवं मीमांसमानं तं नरनार्योऽमरप्रभाः।\nप्रत्यगृह्णन् महाभागं गीतवाद्येन भूयसा॥ १०/१०१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.025.m4a", "display_order": 26}, {"id": 6000297026, "chapter_id": 10297, "verse_number": "१०-१०१-२४", "content_sanskrit": "पतिमागतमाकर्ण्य पत्न्युद्धर्षाच्च सम्भ्रमात्।\nनिश्चक्राम गृहात् तूर्णं रूपिणी श्रीरिवालयात्॥ १०/१०१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.026.m4a", "display_order": 27}, {"id": 6000297027, "chapter_id": 10297, "verse_number": "१०-१०१-२५", "content_sanskrit": "पतिव्रता पतिं दृष्ट्वा प्रेमोत्कण्ठाऽश्रुलोचना।\nमीलिताक्ष्यनमद्बुद्ध्या मनसा परिषस्वजे॥ १०/१०१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.027.m4a", "display_order": 28}, {"id": 6000297028, "chapter_id": 10297, "verse_number": "१०-१०१-२६", "content_sanskrit": "पत्नीं वीक्ष्य प्रस्फुरन्तीं देवीं वैमानिकीमिव।\nदासीनां निष्ककण्ठीनां मध्ये भान्तीं सुविस्मितः॥ १०/१०१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.028.m4a", "display_order": 29}, {"id": 6000297029, "chapter_id": 10297, "verse_number": "१०-१०१-२७", "content_sanskrit": "प्रीतः स्वयं तया युक्तः प्रविष्टो निजमन्दिरम्।\nमणिस्तम्भशतोपेतं महेन्द्रभवनं यथा॥ १०/१०१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.029.m4a", "display_order": 30}, {"id": 6000297030, "chapter_id": 10297, "verse_number": "१०-१०१-२८", "content_sanskrit": "पयःफेननिभाः शय्या दान्ता रुग्मपरिच्छदाः।\nपर्यङ्का हेमदण्डानि चामरव्यजनानि च॥ १०/१०१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.030.m4a", "display_order": 31}, {"id": 6000297031, "chapter_id": 10297, "verse_number": "१०-१०१-२९", "content_sanskrit": "आसनानि च हैमानि स्रग्वस्‍त्राभरणानि च।\nमुक्तादामविलम्बीनि वितानानि द्युमन्ति च॥ १०/१०१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.031.m4a", "display_order": 32}, {"id": 6000297032, "chapter_id": 10297, "verse_number": "१०-१०१-३०", "content_sanskrit": "स्वच्छस्फटिककुड्येषु महामरकतेषु च।\nरत्नदीपान् भ्राजमानान् ललनारत्नसंयुतान्॥ १०/१०१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.032.m4a", "display_order": 33}, {"id": 6000297033, "chapter_id": 10297, "verse_number": "१०-१०१-३१", "content_sanskrit": "विलोक्य ब्राह्मणस्तत्र समृद्धिं सर्वसम्पदाम्।\nतर्कयामास निर्व्यग्रः स्वसमृद्धिमहैतुकीम्॥ १०/१०१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.033.m4a", "display_order": 34}, {"id": 6000297034, "chapter_id": 10297, "verse_number": "१०-१०१-३२", "content_sanskrit": "नूनं बतैतन्मम दुर्भगस्य शश्वद् दरिद्रस्य समृद्धिहेतुः।\nमहाविभूतेरवलोकतोऽन्यन्नैवोपपद्येत यदूत्तमस्य॥ १०/१०१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.034.m4a", "display_order": 35}, {"id": 6000297035, "chapter_id": 10297, "verse_number": "१०-१०१-३३", "content_sanskrit": "नन्वब्रुवाणो दिशते शमक्षयं याचिष्णवे भूर्यपि भूरितेजाः।\nपर्जन्यवन्नः स्वयमीक्षमाणो दाशार्हकाणामृषभः सखा मे॥ १०/१०१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.035.m4a", "display_order": 36}, {"id": 6000297036, "chapter_id": 10297, "verse_number": "१०-१०१-३६", "content_sanskrit": "भक्ताय चित्रा भगवान् हि सम्पदो राज्यं विभूतीर्न समर्पयत्यजः।\nअदीर्घबोधाय विचक्षणः स्वयं पश्यन् निपातं धनिनां मदोद्भवम्॥ १०/१०१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.036.m4a", "display_order": 37}, {"id": 6000297037, "chapter_id": 10297, "verse_number": "१०-१०१-३७", "content_sanskrit": "इत्थं व्यवसितो बुद्ध्या भक्त्याऽतीव जनार्दने।\nविषयान् जायया त्यक्त्वा बुभुजे नातिलम्पटः॥ १०/१०१/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.037.m4a", "display_order": 38}, {"id": 6000297038, "chapter_id": 10297, "verse_number": "१०-१०१-३८", "content_sanskrit": "तस्य वै देवदेवस्य हरेर्यज्ञपतेः प्रभोः।\nब्राह्मणाः प्रभवो दैवं न तेभ्यो विद्यते परम्॥ १०/१०१/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.038.m4a", "display_order": 39}, {"id": 6000297039, "chapter_id": 10297, "verse_number": "१०-१०१-३९", "content_sanskrit": "एवं स विप्रो भगवत्सुहृत् तदा दृष्ट्वा स्वभक्तैरजितं पराजितम्।\nतद्ध्यानवेगोद्ग्रथितात्मबन्धनस्तद्धाम लेभेऽचिरतः सतां पतेः॥ १०/१०१/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.039.m4a", "display_order": 40}, {"id": 6000297040, "chapter_id": 10297, "verse_number": "१०-१०१-४०", "content_sanskrit": "एवं ब्रह्मण्यदेवस्य श्रुत्वा ब्रह्मण्यतां नरः।\nलब्धभावो भगवति कर्मबन्धात् प्रमुच्यते॥ १०/१०१/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_101/BhP_10.101.040.m4a", "display_order": 41}, {"id": 6000297041, "chapter_id": 10297, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्ध एकाधिकशततमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]