[{"id": 2033550, "chapter_id": 1722, "verse_number": "४-४५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2033551, "chapter_id": 1722, "verse_number": "४-४५-१", "content_sanskrit": "उत्तरं सांरथिं कृत्वा शमीं कृत्वा प्रदक्षिणम्।\nआयुधं सर्वमादाय ततः प्रायाद्धनञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2033552, "chapter_id": 1722, "verse_number": "४-४५-२", "content_sanskrit": "ध्वजं च सिंहं मात्स्यस्य भ्रातॄणामायुधानि च।\nप्रणिधाय शमीमध्ये प्रयातुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2033553, "chapter_id": 1722, "verse_number": "४-४५-३", "content_sanskrit": "ततः काञ्चनलाङ्गूलं ध्वजं वानरलक्षणम् ।\nदिव्यं मायामयं युक्तं विहितं विश्वकर्मणा ।\nमनसा चिन्तयामास प्रसादं पावकस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2033554, "chapter_id": 1722, "verse_number": "४-४५-४", "content_sanskrit": "स च तच्चिन्तितं ज्ञात्वा ध्वजे भूतान्ययोजयत्।\nरथे वानरमुच्छ्रित्य गाण्डीवं व्याक्षिपद्धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2033555, "chapter_id": 1722, "verse_number": "४-४५-५", "content_sanskrit": "सपताकं विचित्राङ्गं सोपासङ्गं महाबलम्।\nखात्पपात रथे तूर्णं दिव्यरूपं मनोरमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2033556, "chapter_id": 1722, "verse_number": "४-४५-६", "content_sanskrit": "रथमास्थाय बीभत्सुः कौन्तेयः श्वेतवाहनः।\nबद्धासिः सतलत्राणः प्रगृहीतशरासनः ।\nततः प्रायादुदीचीं स कपिप्रवरकेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2033557, "chapter_id": 1722, "verse_number": "४-४५-७", "content_sanskrit": "सैन्याभ्याशं स संप्राप्य गृहीत्वा शङ्खमुत्तमम् ।\nस्वनवन्तं महाशब्दं देवदत्तं धनञ्जयः ।\nशशाङ्करूपं बीभत्सुः प्राध्मापयदरिंदमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2033558, "chapter_id": 1722, "verse_number": "४-४५-८", "content_sanskrit": "[ शशाङ्ककुन्दधवलं मुखे निक्षिप्य वासविः ।\nउच्छ्वसद्गण्डयुगलं सिराल्याचितफालकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2033559, "chapter_id": 1722, "verse_number": "४-४५-९", "content_sanskrit": "आरक्तनिम्ननयनं ह्रस्वस्थूलशिरोधरम्।\nअतिश्लिष्टोदरोरस्कं तिर्यगाननशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2033560, "chapter_id": 1722, "verse_number": "४-४५-१०", "content_sanskrit": "यावत्स्वशक्तिसामग्र्यं त्रैलोक्यं क्षोभयन्निव ।\nमरुद्भिर्दशभिश्चैव प्राध्मापयदरिंदमः ]॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2033561, "chapter_id": 1722, "verse_number": "४-४५-११", "content_sanskrit": "शङ्खशब्दोस्य सोत्यर्थं श्रूयते कालमेघवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2033562, "chapter_id": 1722, "verse_number": "४-४५-१२", "content_sanskrit": "तस्य शङ्खस्य शब्देन धनुपो निस्वनेन च।\nवानरस्य निनादेन रथनेमिस्वनेन च।\nजङ्गमस्य भयं घोरमकरोत्पाकशासनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2033563, "chapter_id": 1722, "verse_number": "४-४५-१३", "content_sanskrit": "शङ्खशब्देन पार्थस्य मुखेनाश्वाः पतन्क्षितौ ।\nउत्तरश्चापि संत्रस्थो रथोपस्थ उपाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2033564, "chapter_id": 1722, "verse_number": "४-४५-१४", "content_sanskrit": "अथाश्वान्रश्मिभिः पार्थः समुद्यम्य परंतपः ।\nअभ्राजत रथोपस्थे भानुर्मेराविवोत्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2033565, "chapter_id": 1722, "verse_number": "४-४५-१५", "content_sanskrit": "शङ्खघोषेण वित्रस्तं ज्याघातेन च मूर्छितम् ।\nउत्तरं संपरिष्वज्य समाश्वासयदर्जुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2033566, "chapter_id": 1722, "verse_number": "४-४५-१६", "content_sanskrit": "मा भैस्त्वं राजपुत्राग्र्य क्षत्रियोसि परन्तप ।\nकथं पुरुषशार्दूल शत्रुमध्ये विषीदसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2033567, "chapter_id": 1722, "verse_number": "४-४५-१७", "content_sanskrit": "श्रुतास्ते शङ्खशब्दाश्च भेरीशब्दाश्च सर्वशः ।\nकुञ्जराणां च निनदा व्यूढानीकेषु नित्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2033568, "chapter_id": 1722, "verse_number": "४-४५-१८", "content_sanskrit": "स त्वं कथमिवानेन शङ्खशब्देन भीषितः ।\nविपण्णरूपो वित्रस्तः पुरुषः प्राकृतो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2033569, "chapter_id": 1722, "verse_number": "४-४५-१९x", "content_sanskrit": "उत्तर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2033570, "chapter_id": 1722, "verse_number": "४-४५-१९", "content_sanskrit": "श्रुता मे शङ्खशब्दाश्च भेरीशब्दाश्च नित्यशः।\nकुञ्जराणां च निनदा व्यूढानीकेषु तिष्ठतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2033571, "chapter_id": 1722, "verse_number": "४-४५-२०", "content_sanskrit": "नैवंविधाः शङ्खशब्दाः पुरा जातु मया श्रुताः।\nध्वजस्य चापि रूपं मे दृष्टपूर्वं नहीदृशम् ।\nधनुषश्चापि घोषश्च श्रुतपूर्वो न मे क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2033572, "chapter_id": 1722, "verse_number": "४-४५-२१", "content_sanskrit": "अस्य शङ्खस्य शब्देन धनुषो निस्वनेन च।\nअमानुषाणां शब्देन भूतानां निस्वसेन च।\nरथनेमिप्रणादेन मनो कमे मुह्यते भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2033573, "chapter_id": 1722, "verse_number": "४-४५-२२", "content_sanskrit": "व्याकुलाश्च दिशः सर्वा हृदयं व्यथतीव च।\nध्वजेन पिहिताः सर्वा दिशो न प्रतिभान्ति मे।\nगाण्डीवस्य च शब्देन कर्णौ मे बधिरीकृतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2033574, "chapter_id": 1722, "verse_number": "४-४५-२३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2033575, "chapter_id": 1722, "verse_number": "४-४५-२३", "content_sanskrit": "पुनर्ध्वजं पुनः शङ्खं धनुश्चैव पुनः पुनः ।\nस मूढचेता वैराटिरर्जुनं समुदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2033576, "chapter_id": 1722, "verse_number": "४-४५-२४", "content_sanskrit": "स मुहूर्तं प्रयातं तु पार्थो वैराटिमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2033577, "chapter_id": 1722, "verse_number": "४-४५-२५", "content_sanskrit": "स्थिरो भव महाबाहो संज्ञां चात्मानमानय।\nएकान्ते रथमास्थाय पद्भ्यां त्वमवपीड्य च।\nदृढं च रश्मीन्संयच्छ शङ्खं ध्मास्याम्यहं पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2033578, "chapter_id": 1722, "verse_number": "४-४५-२६", "content_sanskrit": "एवमुक्त्वा महाबाहुः सव्यसाची परन्तपः।\nततः शङ्खमुपाध्मासीद्दारयन्निव पर्वतान्।\nगुहा गिरीणां च तदा दिशः शैलांस्तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2033579, "chapter_id": 1722, "verse_number": "४-४५-२७", "content_sanskrit": "ज्याघोषं तलघोषं च कृत्वा भूतान्यमोहयत्।\nउत्तरश्चापि संलीनो रथोपस्थ उपाविशत्।\nतं समाश्वासयामास पुनरेव धनञ्जयः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2033580, "chapter_id": 1722, "verse_number": "४-४५-२८", "content_sanskrit": "तस्य शङ्खस्य शब्देन रथनेमिस्वनेन च।\nगाण्डीवस्य च शब्देन पृथिवी समकम्पत ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2033581, "chapter_id": 1722, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि पञ्चचत्वारिंशोऽध्यायः ॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]