[{"id": 7001194000, "chapter_id": 21194, "verse_number": "२-३-४२-१", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nअथाकर्ण्य गिरीशश्च निजपुर्य्युपकण्ठतः ।\nप्राप्तमीशं सर्वगं वै मुमुदेति हिमालयः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001194001, "chapter_id": 21194, "verse_number": "२-३-४२-२", "content_sanskrit": "अथ सम्भृतसम्भार स्सम्भाषां कर्तुमीश्वरम् ।\nशैलान्प्रस्थापयामास ब्राह्मणानपि सर्वशः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001194002, "chapter_id": 21194, "verse_number": "२-३-४२-३", "content_sanskrit": "स्वयं जगाम सद्भक्त्या प्राणेप्सुन्द्रष्टुऽमीश्वरम् ।\nभक्त्युद्रुतमनाश्शैलः प्रशंसन् स्वविधिम्मुदा॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001194003, "chapter_id": 21194, "verse_number": "२-३-४२-४", "content_sanskrit": "देवसेनां तदा दृष्ट्वा हिमवान्वि स्मयं गतः ।\nजगाम सम्मुखस्तत्र धन्योऽहमिति चिन्तयन्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001194004, "chapter_id": 21194, "verse_number": "२-३-४२-५", "content_sanskrit": "देवा हि तद्बलं दृष्ट्वा विस्मयम्परमं गताः ।\nआनन्दम्परमम्प्रापुर्देवाश्च गिरयस्तथा॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001194005, "chapter_id": 21194, "verse_number": "२-३-४२-६", "content_sanskrit": "पर्वतानां महासेना देवानां च तथा मुने ।\nमिलित्वा विरराजेव पूर्वपश्चिमसागरौ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001194006, "chapter_id": 21194, "verse_number": "२-३-४२-७", "content_sanskrit": "परस्परं मिलित्वा ते देवाश्च पर्वतास्तथा ।\nकृतकृत्यन्तथात्मानम्मेनिरे परया मुदा॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001194007, "chapter_id": 21194, "verse_number": "२-३-४२-८", "content_sanskrit": "अथेश्वरम्पुरो दृष्ट्वा प्रणनाम हिमालयः ।\nसर्वे प्रणेमुर्गिरयो ब्राह्मणाश्च सदाशिवम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001194008, "chapter_id": 21194, "verse_number": "२-३-४२-९", "content_sanskrit": "वृषभस्थम्प्रसन्नास्यन्नानाभरणभूषितम् ।\nदिव्यावयवलावण्यप्रकाशितदिगन्तरम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001194009, "chapter_id": 21194, "verse_number": "२-३-४२-१०", "content_sanskrit": "सुसूक्ष्माहतसत्पट्टवस्त्रशोभितविग्रहम् ।\nसद्रत्नविलसन्मौलिं विहसन्तं शुचिप्रभम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001194010, "chapter_id": 21194, "verse_number": "२-३-४२-११", "content_sanskrit": "भूषाभूताहियुक्तांगमद्भुतावयवप्रभम् ।\nदिव्यद्युतिं सुरेशैश्च सेवितं करचामरैः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001194011, "chapter_id": 21194, "verse_number": "२-३-४२-१२", "content_sanskrit": "वामस्थिताच्युतन्दक्षभागस्थितविभुम्प्रभुम् ।\nपृष्ठस्थितहरिं पृष्ठपार्श्वस्थितसुरादिकम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001194012, "chapter_id": 21194, "verse_number": "२-३-४२-१३", "content_sanskrit": "नानाविधिसुराद्यैश्च संस्तुतं लोकशंकरम् ।\nस्वहेत्वात्ततनुम्ब्रह्मसर्वेशं वरदायकम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001194013, "chapter_id": 21194, "verse_number": "२-३-४२-१४", "content_sanskrit": "सगुणं निर्गुणं चापि भक्ताधीनं कृपाकरम् ।\nप्रकृतेः पुरुषस्यापि परं सच्चित्सुखात्मकम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001194014, "chapter_id": 21194, "verse_number": "२-३-४२-१५", "content_sanskrit": "प्रभोर्दक्षिणभागे तु ददर्श हरिमच्युतम् ।\nविनतातनयारूढं नानाभूषणभूषितम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001194015, "chapter_id": 21194, "verse_number": "२-३-४२-१६", "content_sanskrit": "प्रभोश्च वामभागे तु मुने मां सन्ददर्श ह ।\nचतुर्मुखं महाशोभं स्वपरीवारसंयुतम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001194016, "chapter_id": 21194, "verse_number": "२-३-४२-१७", "content_sanskrit": "एतौ सुरेश्वरौ दृष्ट्वा शिवस्याति प्रियौ सदा ।\nप्रणनाम गिरीशश्च सपरीवार आदरात्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001194017, "chapter_id": 21194, "verse_number": "२-३-४२-१८", "content_sanskrit": "तथा शिवस्य पृष्ठे च पार्श्वयोस्तु विराजितान् ।\nदेवादीन्प्रणनामासौ दृष्ट्वा गिरिवरेश्वरः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001194018, "chapter_id": 21194, "verse_number": "२-३-४२-१९", "content_sanskrit": "शिवाज्ञया पुरो भूत्वा जगाम स्वपुरं गिरिः ।\nशेषहर्यात्मभूश्शीघ्रं मुनिभिः निर्जरादिभिः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001194019, "chapter_id": 21194, "verse_number": "२-३-४२-२०", "content_sanskrit": "सर्वे मुनिसुराद्याश्च गच्छन्तः प्रभुणा सह ।\nगिरेः पुरं समुदिताः शशंसुर्बहु नारद॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001194020, "chapter_id": 21194, "verse_number": "२-३-४२-२१", "content_sanskrit": "रचिते शिखरे रम्ये संस्थाप्य देवतादिकम् ।\nजगाम हिमवांस्तत्र यत्रास्ति विधिवेदिका॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001194021, "chapter_id": 21194, "verse_number": "२-३-४२-२२", "content_sanskrit": "कारयित्वा विशेषेण चतुष्कन्तो रणैर्युतम् ।\nस्नानदानादिकं कृत्वा परीक्षामकरोत्तदा॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001194022, "chapter_id": 21194, "verse_number": "२-३-४२-२३", "content_sanskrit": "स्वपुत्रान्प्रेषयामास शिवस्य निकटे तथा ।\nहिमो विष्ण्वादिसम्पूर्णवर्गयुक्तस्य शैलराट्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001194023, "chapter_id": 21194, "verse_number": "२-३-४२-२४", "content_sanskrit": "कर्तुमेच्छद्वराचारं महोत्सवपुरस्सरम् ।\nमहाहर्षयुतस्सर्वबन्धुयुग्घिमशैलराट्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001194024, "chapter_id": 21194, "verse_number": "२-३-४२-२५", "content_sanskrit": "अथ ते गिरिपु त्राश्च तत्र गत्वा प्रणम्य तम् ।\nसस्ववर्गं प्रार्थनान्तामूचुश्शैलेश्वरस्य वै॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001194025, "chapter_id": 21194, "verse_number": "२-३-४२-२६", "content_sanskrit": "ततस्ते स्वालयं जग्मुश्शैलपुत्रास्तदाज्ञया ।\nशैलराजाय संचख्युस्ते चायान्तीति हर्षिताः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001194026, "chapter_id": 21194, "verse_number": "२-३-४२-२७", "content_sanskrit": "अथ देवाः प्रार्थनान्तां गिरेः श्रुत्वातिहर्षिताः ।\nमुने विष्ण्वादयस्सर्वे सेश्वरा मुमुदुर्भृशम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001194027, "chapter_id": 21194, "verse_number": "२-३-४२-२८", "content_sanskrit": "कृत्वा सुवेषं सर्वेपि निर्जरा मुनयो गणाः ।\nगमनं चक्रुरन्येपि प्रभुणा गिरिराड्गृहम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001194028, "chapter_id": 21194, "verse_number": "२-३-४२-२९", "content_sanskrit": "तस्मिन्नवसरे मेना द्रष्टुकामाभवच्छिवम् ।\nप्रभोराह्वाययामास मुने त्वां मुनिसत्तमम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001194029, "chapter_id": 21194, "verse_number": "२-३-४२-३०", "content_sanskrit": "अगमस्त्वं मुने तत्र प्रभुणा प्रेरितस्तदा ।\nमनसा शिवहृद्धेतुं पूर्णं कर्तुं तमिच्छता॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001194030, "chapter_id": 21194, "verse_number": "२-३-४२-३१", "content_sanskrit": "त्वाम्प्रणम्य मुने मेना प्राह विस्मितमानसा ।\nद्रष्टुकामा प्रभो रूपं शंकरस्य मदापहम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]