[{"id": 7006369000, "chapter_id": 26369, "verse_number": "२-२५-१", "content_sanskrit": "वैशम्पायन उवाच\nअथास्तं गच्छति तदा मन्दरश्मौ दिवाकरे ।\nसंध्यारक्ततले व्योम्नि शशाङ्के पाण्डुमण्डले ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006369001, "chapter_id": 26369, "verse_number": "२-२५-२", "content_sanskrit": "नीडस्थेषु विहङ्गेषु सत्सु प्रादुष्कृताग्निषु ।\nईषत्तमः संवृतासु दिक्षु सर्वासु सर्वशः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006369002, "chapter_id": 26369, "verse_number": "२-२५-३", "content_sanskrit": "घोषवासिषु सुप्तेषु वाशन्तीषु शिवासु च ।\nनक्तंचरेषु हृष्टेषु पिशिताशनकाङ्क्षिषु ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006369003, "chapter_id": 26369, "verse_number": "२-२५-४", "content_sanskrit": "शक्रगोपाह्वयामोदे प्रदोषेऽभ्यासतस्क ।\nसंध्यामयीमिव गुहां सम्प्रतिष्ठे दिवाकरे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006369004, "chapter_id": 26369, "verse_number": "२-२५-५", "content_sanskrit": "अधिश्रयणवेलायां प्राप्तायां गृहमेधिनाम् ।\nवन्यैर्वैखानसैर्मन्त्रैर्हूयमाने हुताशने ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006369005, "chapter_id": 26369, "verse_number": "२-२५-६", "content_sanskrit": "उपावृत्तासु वै गोषु दुह्यमानासु च व्रजे ।\nअसकृद्व्याहरन्तीषु बद्धवत्सासु धेनुषु ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006369006, "chapter_id": 26369, "verse_number": "२-२५-७", "content_sanskrit": "प्रकीर्णदामनीकेषु गास्तथैवाह्वयत्सु च ।\nसनिनादेषु गोपेषु काल्यमाने च गोधने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006369007, "chapter_id": 26369, "verse_number": "२-२५-८", "content_sanskrit": "करीषेषु प्रक्लृप्तेषु दीप्यमानेषु सर्वशः। ।\nकाष्ठभारानतस्कन्धैर्गोपैरभ्यागतैस्तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006369008, "chapter_id": 26369, "verse_number": "२-२५-९", "content_sanskrit": "किंचिदभ्युद्यते सोमे मन्दरश्मौ विराजति ।\nईषद्विगाहमानायां रजन्यां दिवसे गते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006369009, "chapter_id": 26369, "verse_number": "२-२५-१०", "content_sanskrit": "प्राप्ते दिनव्युपरमे प्रवृत्ते क्षणदामुखे ।\nभास्करे तेजसि गते सौम्ये तेजस्युपस्थिते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006369010, "chapter_id": 26369, "verse_number": "२-२५-११", "content_sanskrit": "अग्निहोत्राकुले काले सौम्येन्दौ समुपस्थिते ।\nअग्नीषोमात्मके संधौ वर्तमाने जगन्मये ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006369011, "chapter_id": 26369, "verse_number": "२-२५-१२", "content_sanskrit": "पश्चिमेनाग्निदीप्तेन पूर्वेणोत्पलवर्चसा ।\nदग्धाद्रिसदृशे व्योम्नि किंचित्तारागणाकुले ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006369012, "chapter_id": 26369, "verse_number": "२-२५-१३", "content_sanskrit": "वयोभिर्वासमुशतां बन्धुभिश्च समागमम् ।\nशंसद्भिः स्यन्दनेनाशु प्राप्तो दानपतिर्व्रजम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006369013, "chapter_id": 26369, "verse_number": "२-२५-१४", "content_sanskrit": "प्रविशन्नेव पप्रच्छ सांनिध्यं केशवस्य सः ।\nरौहिणेयस्य चाक्रूरो नन्दगोपस्य चासकृत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006369014, "chapter_id": 26369, "verse_number": "२-२५-१५", "content_sanskrit": "स नन्दगोपस्य गृहं वासाय विबुधोपमः ।\nअवतीर्य ततो यानात् प्रविवेश महाबलः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006369015, "chapter_id": 26369, "verse_number": "२-२५-१६", "content_sanskrit": "हर्षपूर्णेन वक्त्रेण साश्रुनेत्रेण चैव हि ।\nप्रविशन्नेव च द्वारि ददर्शादोहने गवाम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006369016, "chapter_id": 26369, "verse_number": "२-२५-१७", "content_sanskrit": "वत्समध्ये स्थितं कृष्णं सवत्समिव गोवृषम् ।\nस तं हर्षपरीतेन वचसा गद्गदेन वै ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006369017, "chapter_id": 26369, "verse_number": "२-२५-१८", "content_sanskrit": "एहि केशव तातेति प्रव्याहरत धर्मवित् ।\nउत्तानशायिनं दृष्ट्वा पुनर्दृष्ट्वा श्रिया वृतम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006369018, "chapter_id": 26369, "verse_number": "२-२५-१९", "content_sanskrit": "अव्यक्तयौवनं कृष्णमक्रूरः प्रशशंस ह ।\nअयं स पुण्डरीकाक्षः सिंहशार्दूलविक्रमः।\nसम्पूर्णजलमेघाभः पर्वतप्रवराकृतिः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006369019, "chapter_id": 26369, "verse_number": "२-२५-२०", "content_sanskrit": "मृधेष्वधर्षणीयेन सश्रीवत्सेन वक्षसा ।\nद्विषन्निधनदक्षाभ्यां भुजाभ्यां साधु भूषितः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006369020, "chapter_id": 26369, "verse_number": "२-२५-२१", "content_sanskrit": "मूर्तिमान् स रहस्यात्मा जगतोऽग्र्यस्य भाजनम् ।\nगोपवेषधरो विष्णुरुदग्राग्र्यतनूरुहः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006369021, "chapter_id": 26369, "verse_number": "२-२५-२२", "content_sanskrit": "किरीटलाञ्छनेनापि शिरसा छत्रवर्चसा ।\nकुण्डलोत्तमयोग्याभ्यां श्रवणाभ्यां विभूषितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006369022, "chapter_id": 26369, "verse_number": "२-२५-२३", "content_sanskrit": "हारार्हेण च पीनेन सुविस्तीर्णन वक्षसा ।\nद्वाभ्यां भुजाभ्यां वृत्ताभ्यां दीर्घाभ्यामुपशोभितः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006369023, "chapter_id": 26369, "verse_number": "२-२५-२४", "content_sanskrit": "स्त्रीसहस्रोपचर्येण वपुषा मन्मथाधिना ।\nपीते वसानो वसने सोऽयं विष्णुः सनातनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006369024, "chapter_id": 26369, "verse_number": "२-२५-२५", "content_sanskrit": "धरण्याश्रयभूताभ्यां चरणाभ्यामरिंदमः ।\nत्रैलोक्याकान्तिभूताभ्यां भुवि पद्भ्यां व्यवस्थितः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006369025, "chapter_id": 26369, "verse_number": "२-२५-२६", "content_sanskrit": "रुचिराग्रकरश्चास्य चक्राङ्कित इवेक्षते ।\nद्वितीय उद्यतश्चापि गदासंयोगमिच्छति ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006369026, "chapter_id": 26369, "verse_number": "२-२५-२७", "content_sanskrit": "अवतीणों भवायेह प्रथमं पदमात्मनः ।\nशोभतेऽद्य भुवि श्रेष्ठस्त्रिदशानां धुरंधरः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006369027, "chapter_id": 26369, "verse_number": "२-२५-२८", "content_sanskrit": "अयं भविष्ये कथितो भविष्यकुशलैर्नरैः ।\nगोपालो यादवं वंशं क्षीणं विस्तारयिष्यति ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006369028, "chapter_id": 26369, "verse_number": "२-२५-२९", "content_sanskrit": "तेजसा यादवाश्चास्य शतशोऽथ सहस्रशः ।\nवंशमापूरयिष्यन्ति ह्योघा इव महार्णवम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006369029, "chapter_id": 26369, "verse_number": "२-२५-३०", "content_sanskrit": "अस्येदं शासने सर्वं जगत् स्थास्यति शाश्वतम् ।\nनिहतामित्रसामन्तं स्फीतं कृतयुगे तथा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006369030, "chapter_id": 26369, "verse_number": "२-२५-३१", "content_sanskrit": "अयमास्थाय वसुधां स्थापयित्वा जगद् वशे ।\nराज्ञां भविष्यत्युपरि न च राजा भविष्यति ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006369031, "chapter_id": 26369, "verse_number": "२-२५-३२", "content_sanskrit": "नूनं त्रिभिः क्रमैर्जित्वा यथानेन प्रभुः कृतः ।\nपुरा पुरंदरो राजा देवतानां त्रिविष्टपे ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006369032, "chapter_id": 26369, "verse_number": "२-२५-३३", "content_sanskrit": "तथैव वसुधां जित्वा जितपूर्वां त्रिभिः क्रमैः ।\nस्थापयिष्यति राजानमुग्रसेनं न संशयः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006369033, "chapter_id": 26369, "verse_number": "२-२५-३४", "content_sanskrit": "प्रसृष्टवैरगाधोऽयं प्रश्नैश्च बहुभिः श्रुतः ।\nब्राह्मणैर्ब्रह्मवादैश्च पुराणोऽयं हि गीयते ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006369034, "chapter_id": 26369, "verse_number": "२-२५-३५", "content_sanskrit": "स्पृहणीयो हि लोकस्य भविष्यति च केशवः ।\nतथा हास्योत्थिता बुद्धिर्मानुष्यमुपजीवितुम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006369035, "chapter_id": 26369, "verse_number": "२-२५-३६", "content_sanskrit": "अहं त्वस्याद्य वसतिं पूजयिष्ये यथाविधि ।\nविष्णुत्वं मनसा चैव पूजयिष्यामि मन्त्रवत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006369036, "chapter_id": 26369, "verse_number": "२-२५-३७", "content_sanskrit": "यच्च ज्ञातिपरिज्ञानं प्रादुर्भावश्च वै नृषु ।\nअमानुषं वेद्मि चैनं ये चान्ये दिव्यचक्षुषः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006369037, "chapter_id": 26369, "verse_number": "२-२५-३८", "content_sanskrit": "सोऽहं कृष्णेन वै रात्रौ सम्मन्त्र्य विदितात्मना ।\nसहानेन गमिष्यामि सव्रजो यदि मंस्यते ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006369038, "chapter_id": 26369, "verse_number": "२-२५-३९", "content_sanskrit": "एवं बहुविधं कृष्णं दृष्ट्वा हेत्वर्थकारणैः ।\nविवेश नन्दगोपस्य कृष्णेन सह संसदम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]