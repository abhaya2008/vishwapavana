[{"id": 7004505000, "chapter_id": 24505, "verse_number": "५-३-१९९-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nतस्यैवानन्तरं राजन्नाश्विनं तीर्थमुत्तमम् ।\nकामिकं सर्वतीर्थानां प्राणिनां सिद्धिदायकम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004505001, "chapter_id": 24505, "verse_number": "५-३-१९९-२", "content_sanskrit": "तत्र तीर्थेऽश्विनौ देवौ सुरूपौ भिषजां वरौ ।\nतपः कृत्वा सुविपुलं संजातौ यज्ञभागिनौ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004505002, "chapter_id": 24505, "verse_number": "५-३-१९९-३", "content_sanskrit": "संमतौ सर्वदेवानामादित्यतनयावुभौ ।\nनासत्यौ सत्त्वसंपन्नौ सर्वदुःखघ्नसत्तमौ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004505003, "chapter_id": 24505, "verse_number": "५-३-१९९-४", "content_sanskrit": "युधिष्ठिर उवाच ।\nआदित्यस्य सुतौ तात नासत्यौ येन हेतुना ।\nसंजातौ श्रोतुमिच्छामि निर्णयं परमं द्विज॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004505004, "chapter_id": 24505, "verse_number": "५-३-१९९-५", "content_sanskrit": "मार्कण्डेय उवाच ।\nपुराणे भास्करे तात एतद्विस्तरतो मया ।\nसंश्रुतं देवदेवस्य मार्तण्डस्य महात्मनः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004505005, "chapter_id": 24505, "verse_number": "५-३-१९९-६", "content_sanskrit": "तत्ते संक्षेपतः सर्वं भक्तियुक्तस्य भारत ।\nकथयामि न सन्देहो वृद्धभावेन कर्शितः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004505006, "chapter_id": 24505, "verse_number": "५-३-१९९-७", "content_sanskrit": "अतितेजोरवेर्दृष्ट्वा राज्ञी देवी नरोत्तम ।\nचचार मेरुकान्तारे वडवा तप उल्बणम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004505007, "chapter_id": 24505, "verse_number": "५-३-१९९-८", "content_sanskrit": "ततः कतिपयाहस्य कालस्य भगवान्रविः ।\nदृष्ट्वा तु रूपमुत्सृज्य परमं तेज उज्ज्वलम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004505008, "chapter_id": 24505, "verse_number": "५-३-१९९-९", "content_sanskrit": "मनोभववशीभूतो हयो भूत्वा लघुक्रमः ।\nविस्फुरन्ती यथाप्राणं धावमाना इतस्ततः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004505009, "chapter_id": 24505, "verse_number": "५-३-१९९-१०", "content_sanskrit": "हेषमाणः स्वरेणासौ मैथुनायोपचक्रमे ।\nसम्मुखी तु ततो देवी निवृत्ता लघुविक्रमा॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004505010, "chapter_id": 24505, "verse_number": "५-३-१९९-११", "content_sanskrit": "यथा तथा नासिकायां प्रविष्टं बीजमुत्तमम् ।\nततो नासागते बीजे संजातो गर्भ उत्तमः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004505011, "chapter_id": 24505, "verse_number": "५-३-१९९-१२", "content_sanskrit": "जातौ यतः सुतौ पार्थ नासत्यौ विश्रुतौ ततः ।\nसुसमौ सुविभक्ताङ्गौ बिम्बाद्बिम्बमिवोद्यतौ॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004505012, "chapter_id": 24505, "verse_number": "५-३-१९९-१३", "content_sanskrit": "अधिकौ सर्वदेवानां रूपैश्चर्यसमन्वितौ ।\nनर्मदातटमाश्रित्य भृगुकच्छे गतावुभौ ।\nपरां सिद्धिमनुप्राप्तौ तपः कृत्वा सुदुश्चरम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004505013, "chapter_id": 24505, "verse_number": "५-३-१९९-१४", "content_sanskrit": "तत्र तीर्थे तु यः स्नात्वा तर्पयेत्पितृदेवताः ।\nसुरूपः सुभगः पार्थ जायते यत्र तत्र च॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]