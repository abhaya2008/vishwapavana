[{"id": 7001460000, "chapter_id": 21460, "verse_number": "७-१-३३-१", "content_sanskrit": "ऋषय ऊचुः ।\nभगवञ्छ्रोतुमिच्छामो व्रतं पाशुपतं परम् ।\nब्रह्मादयो ऽपि यत्कृत्वा सर्वे पाशुपताः स्मृताः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001460001, "chapter_id": 21460, "verse_number": "७-१-३३-२", "content_sanskrit": "वायुरुवाच ।\nरहस्यं वः प्रवक्ष्यामि सर्वपापनिकृन्तनम् ।\nव्रतं पाशुपतं श्रौतमथर्वशिरसि श्रुतम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001460002, "chapter_id": 21460, "verse_number": "७-१-३३-३", "content_sanskrit": "कालश्चैत्री पौर्णमासी देशः शिवपरिग्रहः ।\nक्षेत्रारामाद्यरण्यं वा प्रशस्तश्शुभलक्षणः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001460003, "chapter_id": 21460, "verse_number": "७-१-३३-४", "content_sanskrit": "तत्र पूर्वं त्रयोदश्यां सुस्नातः सुकृताह्निकः ।\nअनुज्ञाप्य स्वमाचार्यं संपूज्य प्रणिपत्य च॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001460004, "chapter_id": 21460, "verse_number": "७-१-३३-५", "content_sanskrit": "पूजां वैशेषिकीं कृत्वा शुक्लांबरधरः स्वयम् ।\nशुक्लयज्ञोपवीती च शुक्लमाल्यानुलेपनः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001460005, "chapter_id": 21460, "verse_number": "७-१-३३-६", "content_sanskrit": "दर्भासने समासीनो दर्भमुष्टिं प्रगृह्य च ।\nप्राणायामत्रयं कृत्वा प्राङ्मुखो वाप्युदङ्मुखः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001460006, "chapter_id": 21460, "verse_number": "७-१-३३-७", "content_sanskrit": "ध्यात्वा देवं च देवीं च तद्विज्ञापनवर्त्मना ।\nव्रतमेतत्करोमीति भवेत्संकल्प्य दीक्षितः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001460007, "chapter_id": 21460, "verse_number": "७-१-३३-८", "content_sanskrit": "यावच्छरीरपातं वा द्वादशाब्दमथापि वा ।\nतदर्धं वा तदर्धं वा मासद्वादशकं तु वा॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001460008, "chapter_id": 21460, "verse_number": "७-१-३३-९", "content_sanskrit": "तदर्धं वा तदर्धं वा मासमेकमथापि वा ।\nदिनद्वादशकं वा ऽथ दिनषट्कमथापि वा॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001460009, "chapter_id": 21460, "verse_number": "७-१-३३-१०", "content_sanskrit": "तदर्धं दिनमेकं वा व्रतसंकल्पनावधि ।\nअग्निमाधाय विधिवद्विरजाहोमकारणात्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001460010, "chapter_id": 21460, "verse_number": "७-१-३३-११", "content_sanskrit": "हुत्वाज्येन समिद्भिश्च चरुणा च यथाक्रमम् ।\nपूर्णामापूर्य तां भूयस्तत्त्वानां शुद्धिमुद्दिशन्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001460011, "chapter_id": 21460, "verse_number": "७-१-३३-१२", "content_sanskrit": "जुहुयान्मूलमन्त्रेण तैरेव समिदादिभिः ।\nतत्त्वान्येतानि मद्देहे शुद्ध्यंताम् १ त्यनुस्मरन्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001460012, "chapter_id": 21460, "verse_number": "७-१-३३-१३", "content_sanskrit": "पञ्चभूतानि तन्मात्राः पञ्चकर्मेन्द्रियाणि च ।\nज्ञानकर्मविभेदेन पञ्चकर्मविभागशः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001460013, "chapter_id": 21460, "verse_number": "७-१-३३-१४", "content_sanskrit": "त्वगादिधातवस्सप्त पञ्च प्राणादिवायवः ।\nमनोबुद्धिरहं ख्यातिर्गुणाः प्रकृतिपूरुषौ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001460014, "chapter_id": 21460, "verse_number": "७-१-३३-१५", "content_sanskrit": "रागो विद्याकले चैव नियतिः काल एव च ।\nमाया च शुद्धिविद्या च महेश्वरसदाशिवौ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001460015, "chapter_id": 21460, "verse_number": "७-१-३३-१६", "content_sanskrit": "शक्तिश्च शिवतत्त्वं च तत्त्वानि क्रमशो विदुः ।\nमन्त्रैस्तु विरजैर्हुत्वा होतासौ विरजा भवेत्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001460016, "chapter_id": 21460, "verse_number": "७-१-३३-१७", "content_sanskrit": "शिवानुग्रहमासाद्य ज्ञानवान्स हि जायते ।\nअथ गोमयमादाय पिण्डीकृत्याभिमंत्र्य च॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001460017, "chapter_id": 21460, "verse_number": "७-१-३३-१८", "content_sanskrit": "विन्यस्याग्नौ च सम्प्रोक्ष्य दिने तस्मिन्हविष्यभुक् ।\nप्रभाते तु चतुर्दश्यां कृत्वा सर्वं पुरोदितम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001460018, "chapter_id": 21460, "verse_number": "७-१-३३-१९", "content_sanskrit": "दिने तस्मिन्निराहारः कालं शेषं समापयेत् ।\nप्रातः पर्वणि चाप्येवं कृत्वा होमा वसानतः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001460019, "chapter_id": 21460, "verse_number": "७-१-३३-२०", "content_sanskrit": "उपसंहृत्य रुद्राग्निं गृह्णीयाद्भस्म यत्नतः ।\nततश्च जटिलो मुण्डी शिखैकजट एव वा॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001460020, "chapter_id": 21460, "verse_number": "७-१-३३-२१", "content_sanskrit": "भूत्वा स्नात्वा ततो वीतलज्जश्चेत्स्याद्दिगम्बरः ।\nअपि काषायवसनश्चर्मचीराम्बरो ऽथ वा॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001460021, "chapter_id": 21460, "verse_number": "७-१-३३-२२", "content_sanskrit": "एकाम्बरो वल्कली वा भवेद्दण्डी च मेखली ।\nप्रक्षाल्य चरणौ पश्चाद्द्विराचम्यात्मनस्तनुम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001460022, "chapter_id": 21460, "verse_number": "७-१-३३-२३", "content_sanskrit": "संकुलीकृत्य तद्भस्म विरजानलसंभवम् ।\nअग्निरित्यादिभिर्मंत्रैः षड्भिराथर्वणैः क्रमात्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001460023, "chapter_id": 21460, "verse_number": "७-१-३३-२४", "content_sanskrit": "विभृज्यांगानि मूर्धादिचरणांतानि तैस्स्पृशेत् ।\nततस्तेन क्रमेणैव समुद्धृत्य च भस्मना॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001460024, "chapter_id": 21460, "verse_number": "७-१-३३-२५", "content_sanskrit": "सर्वांगोद्धूलनं कुर्यात्प्रणवेन शिवेन वा ।\nततस्त्रिपुण्ड्रं रचयेत्त्रियायुषसमाह्वयम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001460025, "chapter_id": 21460, "verse_number": "७-१-३३-२६", "content_sanskrit": "शिवभावं समागम्य शिवयोगमथाचरेत् ।\nकुर्यात्स्त्रिसन्ध्यमप्येवमेतत्पाशुपतं व्रतम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001460026, "chapter_id": 21460, "verse_number": "७-१-३३-२७", "content_sanskrit": "भुक्तिमुक्तिप्रदं चैतत्पशुत्वं विनिवर्तयेत् ।\nतत्पशुत्वं परित्यज्य कृत्वा पाशुपतं व्रतम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001460027, "chapter_id": 21460, "verse_number": "७-१-३३-२८", "content_sanskrit": "पूजनीयो महादेवो लिंगमूर्तिस्सनातनः ।\nपद्ममष्टदलं हैमं नवरत्नैरलंकृतम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001460028, "chapter_id": 21460, "verse_number": "७-१-३३-२९", "content_sanskrit": "कर्णिकाकेशरोपेतमासनं परिकल्पयेत् ।\nविभवे तदभावे तु रक्तं सितमथापि वा॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001460029, "chapter_id": 21460, "verse_number": "७-१-३३-३०", "content_sanskrit": "पद्मं तस्याप्यभावे तु केवलं भावनामयम् ।\nतत्पद्मकर्णिकामध्ये कृत्वा लिंगं कनीयसम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001460030, "chapter_id": 21460, "verse_number": "७-१-३३-३१", "content_sanskrit": "स्फीटिकं पीठिकोपेतं पूजयेद्विधिवत्क्रमात् ।\nप्रतिष्ठाप्य विधानेन तल्लिंगं कृतशोधनम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001460031, "chapter_id": 21460, "verse_number": "७-१-३३-३२", "content_sanskrit": "परिकल्प्यासनं मूर्तिं पञ्चवक्त्रप्रकारतः ।\nपञ्चगव्यादिभिः पूर्णैर्यथाविभवसंभृतैः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001460032, "chapter_id": 21460, "verse_number": "७-१-३३-३३", "content_sanskrit": "स्नापयेत्कलशैः पूर्णैरष्टापदसमुद्भवैः ।\nगंधद्रव्यैस्सकर्पूरैश्चन्दनाद्यैस्सकुंकुमैः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001460033, "chapter_id": 21460, "verse_number": "७-१-३३-३४", "content_sanskrit": "सवेदिकं समालिप्य लिंगं भूषणभूषितम् ।\nबिल्वपत्रैश्च पद्मैश्च रक्तैः श्वेतैस्तथोत्पलैः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001460034, "chapter_id": 21460, "verse_number": "७-१-३३-३५", "content_sanskrit": "नीलोत्पलैस्तथान्यैश्च पुष्पैस्तैस्तैस्सुगंधिभिः ।\nपुण्यैः प्रशस्तैः पत्रैश्च चित्रैर्दूर्वाक्षतादिभिः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001460035, "chapter_id": 21460, "verse_number": "७-१-३३-३६", "content_sanskrit": "समभ्यर्च्य यथालाभं महापूजाविधानतः ।\nधूपं दीपं तथा चापि नैवेद्यं च समादिशेत्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001460036, "chapter_id": 21460, "verse_number": "७-१-३३-३७", "content_sanskrit": "निवेदयित्वा विभवे कल्याणं च समाचरेत् ।\nइष्टानि च विशिष्टानि न्यायेनोपार्जितानि च॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001460037, "chapter_id": 21460, "verse_number": "७-१-३३-३८", "content_sanskrit": "सर्वद्रव्याणि देयानि व्रते तस्मिन्विशेषतः ।\nश्रीपत्रोत्पलपद्मानां संख्या साहस्रिकी मता॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001460038, "chapter_id": 21460, "verse_number": "७-१-३३-३९", "content_sanskrit": "प्रत्येकमपरा संख्या शतमष्टोत्तरं द्विजाः ।\nतत्रापि च विशेषेण न त्यजेद्बिल्वपत्रकम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001460039, "chapter_id": 21460, "verse_number": "७-१-३३-४०", "content_sanskrit": "हैममेकं परं प्राहुः पद्मं पद्मसहस्रकात् ।\nनीलोत्पलादिष्वप्येतत्समानं बिल्बपत्रकैः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001460040, "chapter_id": 21460, "verse_number": "७-१-३३-४१", "content_sanskrit": "पुष्पान्तरे न नियमो यथालाभं निवेदयेत् ।\nअष्टाङ्गमर्घ्यमुत्कृष्टं धूपालेपौ विशेषतः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001460041, "chapter_id": 21460, "verse_number": "७-१-३३-४२", "content_sanskrit": "चन्दनं वामदेवाख्ये हरितालं च पौरुषे ।\nईशाने भसितं केचिदालेपनमितीदृशाम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001460042, "chapter_id": 21460, "verse_number": "७-१-३३-४३", "content_sanskrit": "न धूपमिति मन्यन्ते धूपान्तरविधानतः ।\nसितागुरुमघोराख्ये मुखे कृष्णागुरुं पुनः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001460043, "chapter_id": 21460, "verse_number": "७-१-३३-४४", "content_sanskrit": "पौरुषे गुग्गुलं सव्ये सौम्ये सौगंधिकं मुखे ।\nईशाने ऽपि ह्युशीरादि देयाद्धूपं विशेषतः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001460044, "chapter_id": 21460, "verse_number": "७-१-३३-४५", "content_sanskrit": "शर्करामधुकर्पूरकपिलाघृतसंयुतम् ।\nचंदनागुरुकाष्ठाद्यं सामान्यं संप्रचक्षते॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001460045, "chapter_id": 21460, "verse_number": "७-१-३३-४६", "content_sanskrit": "कर्पूरवर्तिराज्याढ्या देया दीपावलिस्ततः ।\nअर्घ्यमाचमनं देयं प्रतिवक्त्रमतः परम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001460046, "chapter_id": 21460, "verse_number": "७-१-३३-४७", "content_sanskrit": "प्रथमावरणे पूज्यो क्रमाद्धेरम्बषण्मुखौ ।\nब्रह्मांगानि ततश्चैव प्रथमावरणेर्चिते॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001460047, "chapter_id": 21460, "verse_number": "७-१-३३-४८", "content_sanskrit": "द्वितीयावरणे पूज्या विघ्नेशाश्चक्रवर्तिनः ।\nतृतीयावरणे पूज्या भवाद्या अष्टमूर्तयः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001460048, "chapter_id": 21460, "verse_number": "७-१-३३-४९", "content_sanskrit": "महादेवादयस्तत्र तथैकादशमूर्तयः ।\nचतुर्थावरणे पूज्याः सर्व एव गणेश्वराः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001460049, "chapter_id": 21460, "verse_number": "७-१-३३-५०", "content_sanskrit": "बहिरेव तु पद्मस्य पञ्चमावरणे क्रमात् ।\nदशदिक्पतयः पूज्याः सास्त्राः सानुचरास्तथा॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001460050, "chapter_id": 21460, "verse_number": "७-१-३३-५१", "content_sanskrit": "ब्रह्मणो मानसाः पुत्राः सर्वे ऽपि ज्योतिषां गणाः ।\nसर्वा देव्यश्च देवाश्च सर्वे सर्वे च खेचराः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001460051, "chapter_id": 21460, "verse_number": "७-१-३३-५२", "content_sanskrit": "पातालवासिनश्चान्ये सर्वे मुनिगणा अपि ।\nयोगिनो हि सखास्सर्वे पतंगा मातरस्तथा॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001460052, "chapter_id": 21460, "verse_number": "७-१-३३-५३", "content_sanskrit": "क्षेत्रपालाश्च सगणाः सर्वं चैतच्चराचरम् ।\nपूजनीयं शिवप्रीत्या मत्त्वा शंभुविभूतिमत्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001460053, "chapter_id": 21460, "verse_number": "७-१-३३-५४", "content_sanskrit": "अथावरणपूजांते संपूज्य परमेश्वरम् ।\nसाज्यं सव्यं जनं हृद्यं हविर्भक्त्या निवेदयेत्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001460054, "chapter_id": 21460, "verse_number": "७-१-३३-५५", "content_sanskrit": "मुखवासादिकं दत्त्वा ताम्बूलं सोपदंशकम् ।\nअलंकृत्य च भूयो ऽपि नानापुष्पविभूषणैः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001460055, "chapter_id": 21460, "verse_number": "७-१-३३-५६", "content_sanskrit": "नीराजनांते विस्तीर्य पूजाशेषं समापयेत् ।\nचषकं सोपकारं च शयनं च समर्पयेत्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001460056, "chapter_id": 21460, "verse_number": "७-१-३३-५७", "content_sanskrit": "चन्द्रसंकाशहारं च शयनीयं समर्पयेत् ।\nआद्यं नृपोचितं हृद्यं तत्सर्वमनुरूपतः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001460057, "chapter_id": 21460, "verse_number": "७-१-३३-५८", "content_sanskrit": "कृत्वा च कारयित्वा च हित्वा च प्रतिपूजनम् ।\nस्तोत्रं व्यपोहनं जप्त्वा विद्यां पञ्चाक्षरीं जपेत्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001460058, "chapter_id": 21460, "verse_number": "७-१-३३-५९", "content_sanskrit": "प्रदक्षिणां प्रणामं च कृत्वात्मानं समर्पयेत् ।\nततः पुरस्ताद्देवस्य गुरुविप्रौ च पूजयेत्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001460059, "chapter_id": 21460, "verse_number": "७-१-३३-६०", "content_sanskrit": "दत्त्वार्घ्यमष्टौ पुष्पाणि देवमुद्वास्य लिंगतः ।\nअग्नेश्चाग्निं सुसंयम्य ह्युद्वास्य च तमप्युत॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001460060, "chapter_id": 21460, "verse_number": "७-१-३३-६१", "content_sanskrit": "प्रत्यहं च जनस्त्वेवं कुर्यात्सेवां पुरोदिताम् ।\nततस्तत्साम्बुजं लिंगं सर्वोपकरणान्वितम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001460061, "chapter_id": 21460, "verse_number": "७-१-३३-६२", "content_sanskrit": "समर्पयेत्स्वगुरवे स्थापयेद्वा शिवालये ।\nसंपूज्य च गुरून्विप्रान्व्रतिनश्च विशेषतः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001460062, "chapter_id": 21460, "verse_number": "७-१-३३-६३", "content_sanskrit": "भक्तान्द्विजांश्च शक्तश्चेद्दीनानाथांश्च तोषयेत् ।\nस्वयं चानशने शक्तः फलमूलाशने ऽथ वा॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001460063, "chapter_id": 21460, "verse_number": "७-१-३३-६४", "content_sanskrit": "पयोव्रतो वा भिक्षाशी भवेदेकाशनस्तथा ।\nनक्तं युक्ताशनो नित्यं भूशय्यानिरतः शुचिः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001460064, "chapter_id": 21460, "verse_number": "७-१-३३-६५", "content_sanskrit": "भस्मशायी तृणेशायी चीराजिनधृतो ऽथवा ।\nब्रह्मचर्यव्रतो नित्यं व्रतमेतत्समाचरेत्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001460065, "chapter_id": 21460, "verse_number": "७-१-३३-६६", "content_sanskrit": "अर्कवारे तथार्द्रायां पञ्चदश्यां च पक्षयोः ।\nअष्टम्यां च चतुर्दश्यां शक्तस्तूपवसेदपि॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001460066, "chapter_id": 21460, "verse_number": "७-१-३३-६७", "content_sanskrit": "पाखण्डिपतितोदक्यास्सूतकान्त्यजपूर्वकान् ।\nवर्जयेत्सर्वयत्नेन मनसा कर्मणा गिरा॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001460067, "chapter_id": 21460, "verse_number": "७-१-३३-६८", "content_sanskrit": "क्षमदानदयासत्याहिंसाशीलः सदा भवेत् ।\nसंतुष्टश्च प्रशान्तश्च जपध्यानरतस्तथा॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001460068, "chapter_id": 21460, "verse_number": "७-१-३३-६९", "content_sanskrit": "कुर्यात्त्रिषवणस्नानं भस्मस्नानमथापि वा ।\nपूजां वैशेषिकीं चैव मनसा वचसा गिरा॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001460069, "chapter_id": 21460, "verse_number": "७-१-३३-७०", "content_sanskrit": "बहुनात्र किमुक्तेन नाचरेदशिवं व्रती ।\nप्रमादात्तु तथाचारे निरूप्य गुरुलाघवे॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001460070, "chapter_id": 21460, "verse_number": "७-१-३३-७१", "content_sanskrit": "उचितां निष्कृतिं कुर्यात्पूजाहोमजपादिभिः ।\nआसमाप्तेर्व्रतस्यैवमाचरेन्न प्रमादतः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001460071, "chapter_id": 21460, "verse_number": "७-१-३३-७२", "content_sanskrit": "गोदानं च वृषोत्सर्गं कुर्यात्पूजां च संपदा ।\nभक्तश्च शिवप्रीत्यर्थं सर्वकामविवर्जितः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001460072, "chapter_id": 21460, "verse_number": "७-१-३३-७३", "content_sanskrit": "सामान्यमेतत्कथितं व्रतस्यास्य समासतः ।\nप्रतिमासं विशेषं च प्रवदामि यथाश्रुतम्॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001460073, "chapter_id": 21460, "verse_number": "७-१-३३-७४", "content_sanskrit": "वैशाखे वज्रलिंगं तु ज्येष्ठे मारकतं शुभम् ।\nआषाढे मौक्तिकं विद्याच्छ्रावणे नीलनिर्मितम्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001460074, "chapter_id": 21460, "verse_number": "७-१-३३-७५", "content_sanskrit": "मासे भाद्रपदे चैव पद्मरागमयं परम् ।\nआश्विने मासि विद्याद्वै लिंगं गोमेदकं वरम्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001460075, "chapter_id": 21460, "verse_number": "७-१-३३-७६", "content_sanskrit": "कार्तिक्यां वैद्रुमं लिंगं वैदूर्यं मार्गशीर्षके ।\nपुष्परागमयं पौषे माघे द्युमणिजन्तथा॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001460076, "chapter_id": 21460, "verse_number": "७-१-३३-७७", "content_sanskrit": "फाल्गुणे चन्द्रकान्तोत्थं चैत्रे तद्व्यत्ययो ऽथवा ।\nसर्वमासेषु रत्नानामलाभे हैममेव वा॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001460077, "chapter_id": 21460, "verse_number": "७-१-३३-७८", "content_sanskrit": "हैमाभावे राजतं वा ताम्रजं शैलजन्तथा ।\nमृन्मयं वा यथालाभं जातुषं चान्यदेव वा॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001460078, "chapter_id": 21460, "verse_number": "७-१-३३-७९", "content_sanskrit": "सर्वगंधमयं वाथ लिंगं कुर्याद्यथारुचि ।\nव्रतावसानसमये समाचरितनित्यकः॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001460079, "chapter_id": 21460, "verse_number": "७-१-३३-८०", "content_sanskrit": "कृत्वा वैशेषिकीं पूजां हुत्वा चैव यथा पुरा ।\nसंपूज्य च तथाचार्यं व्रतिनश्च विशेषतः॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001460080, "chapter_id": 21460, "verse_number": "७-१-३३-८१", "content_sanskrit": "देशिकेनाप्यनुज्ञातः प्राङ्मुखो वाप्युदङ्मुखः ।\nदर्भासनो दर्भपाणिः प्राणापानौ नियम्य च॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001460081, "chapter_id": 21460, "verse_number": "७-१-३३-८२", "content_sanskrit": "जपित्वा शक्तितो मूलं ध्यात्वा साम्बं त्रियम्बकम् ।\nअनुज्ञाप्य यथापूर्वं नमस्कृत्य कृताञ्जलिः॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001460082, "chapter_id": 21460, "verse_number": "७-१-३३-८३", "content_sanskrit": "समुत्सृजामि भगवन्व्रतमेतत्त्वदाज्ञया ।\nइत्युक्त्वा लिंगमूलस्थान्दर्भानुत्तरतस्त्यजेत्॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001460083, "chapter_id": 21460, "verse_number": "७-१-३३-८४", "content_sanskrit": "ततो दण्डजटाचीरमेखला अपि चोत्सृजेत् ।\nपुनराचम्य विधिवत्पञ्चाक्षरमुदीरयेत्॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001460084, "chapter_id": 21460, "verse_number": "७-१-३३-८५", "content_sanskrit": "यः कृत्वात्यंतिकीं दीक्षामादेहान्तमनाकुलः ।\nव्रतमेतत्प्रकुर्वीत स तु वै नैष्ठिकः स्मृतः॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001460085, "chapter_id": 21460, "verse_number": "७-१-३३-८६", "content_sanskrit": "सो ऽत्याश्रमी च विज्ञेयो महापाशुपतस्तथा ।\nस एव तपतां श्रेष्ठ स एव च महाव्रती॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001460086, "chapter_id": 21460, "verse_number": "७-१-३३-८७", "content_sanskrit": "न तेन सदृशः कश्चित्कृतकृत्यो मुमुक्षुषु ।\nयो यतिर्नैष्ठिको जातस्तमाहुर्नैष्ठिकोत्तमम्॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001460087, "chapter_id": 21460, "verse_number": "७-१-३३-८८", "content_sanskrit": "यो ऽन्वहं द्वादशाहं वा व्रतमेतत्समाचरेत् ।\nसो ऽपि नैष्ठिकतुल्यः स्यात्तीव्रव्रतसमन्वयात्॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001460088, "chapter_id": 21460, "verse_number": "७-१-३३-८९", "content_sanskrit": "घृताक्तो यश्चरेदेतद्व्रतं व्रतपरायणः ।\nद्वित्रैकदिवसं वापि स च कश्चन नैष्ठिकः॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001460089, "chapter_id": 21460, "verse_number": "७-१-३३-९०", "content_sanskrit": "कृत्यमित्येव निष्कामो यश्चरेद्व्रतमुत्तमम् ।\nशिवार्पितात्मा सततं न तेन सदृशः क्वचित्॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001460090, "chapter_id": 21460, "verse_number": "७-१-३३-९१", "content_sanskrit": "भस्मच्छन्नो द्विजो विद्वान्महापातकसंभवैः ।\nपापैस्सुदारुणैस्सद्यो मुच्यते नात्र संशयः॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001460091, "chapter_id": 21460, "verse_number": "७-१-३३-९२", "content_sanskrit": "रुद्राग्निर्यत्परं वीर्यन्तद्भस्म परिकीर्तितम् ।\nतस्मात्सर्वेषु कालेषु वीर्यवान्भस्मसंयुतः॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001460092, "chapter_id": 21460, "verse_number": "७-१-३३-९३", "content_sanskrit": "भस्मनिष्ठस्य नश्यन्ति देषा भस्माग्निसंगमात् ।\nभस्मस्नानविशुद्धात्मा भस्मनिष्ठ इति स्मृतः॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001460093, "chapter_id": 21460, "verse_number": "७-१-३३-९४", "content_sanskrit": "भस्मना दिग्धसर्वांगो भस्मदीप्तत्रिपुंड्रकः ।\nभस्मस्नायी च पुरुषो भस्मनिष्ठ इति स्मृतः॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7001460094, "chapter_id": 21460, "verse_number": "७-१-३३-९५", "content_sanskrit": "भूतप्रेतपिशासाश्च रोगाश्चातीव दुस्सहाः ।\nभस्मनिष्ठस्य सान्निध्याद्विद्रवंति न संशयः॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7001460095, "chapter_id": 21460, "verse_number": "७-१-३३-९६", "content_sanskrit": "भासनाद्भासितं प्रोक्तं भस्म कल्मषभक्षणात् ।\nभूतिभूतिकरी चैव रक्षा रक्षाकरी परम्॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7001460096, "chapter_id": 21460, "verse_number": "७-१-३३-९७", "content_sanskrit": "किमन्यदिह वक्तव्यं भस्ममाहात्म्यकारणम् ।\nव्रती च भस्मना स्नातस्स्वयं देवो महेश्वरः॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7001460097, "chapter_id": 21460, "verse_number": "७-१-३३-९८", "content_sanskrit": "परमास्त्रं च शैवानां भस्मैतत्पारमेश्वरम् ।\nधौम्याग्रजस्य तपसि व्यापदो यन्निवारिताः॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7001460098, "chapter_id": 21460, "verse_number": "७-१-३३-९९", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन कृत्वा पाशुपतव्रतम् ।\nधनवद्भस्म संगृह्य भस्मस्नानरतो भवेत्॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}]