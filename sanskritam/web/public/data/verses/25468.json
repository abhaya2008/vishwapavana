[{"id": 7005468000, "chapter_id": 25468, "verse_number": "१-३८-१", "content_sanskrit": "मार्कण्डेय उवाच ।\nषष्टिस्तीर्थसहस्राणि षष्टिस्तीर्थशतानि च ।\nमाघमासे गमिष्यन्ति गङ्‌गायमुनसंगमम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005468001, "chapter_id": 25468, "verse_number": "१-३८-२", "content_sanskrit": "गवां शतसहस्रस्य सम्यग् दत्तस्य यत् फलम् ।\nप्रयागे माघमासे तु त्र्यहं स्नातस्य तत् फलम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005468002, "chapter_id": 25468, "verse_number": "१-३८-३", "content_sanskrit": "गङ्‌गायमुनयोर्मध्ये काष्टाग्निं यस्तु साधयेत् ।\nअहीनाङ्‌गोऽप्यरोगश्च पञ्चेन्द्रियसमन्वितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005468003, "chapter_id": 25468, "verse_number": "१-३८-४", "content_sanskrit": "यावन्ति रोमकूपाणि तस्य गात्रेषु मानवः ।\nतावद् वर्षसहस्राणि स्वर्गलोके महीयते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005468004, "chapter_id": 25468, "verse_number": "१-३८-५", "content_sanskrit": "ततः स्वर्गात् परिभ्रष्टो जम्बूद्वीपपतिर्भवेत् ।\nभुक्त्वा स विपुलान् भोगांस्तत् तीर्थं भजते पुनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005468005, "chapter_id": 25468, "verse_number": "१-३८-६", "content_sanskrit": "जलप्रवेशं यः कुर्यात् संगमे लोकविश्रुते ।\nराहुग्रस्तो यथा सोमो विमुक्तः सर्वपातकैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005468006, "chapter_id": 25468, "verse_number": "१-३८-७", "content_sanskrit": "सोमलोकमवाप्नोति सोमेन सह मोदते ।\nषष्टिं वर्षसहस्राणि षष्टिं वर्षशतानि च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005468007, "chapter_id": 25468, "verse_number": "१-३८-८", "content_sanskrit": "स्वर्गतः शक्रलोकेऽसौ मुनिगन्धर्वसेवितः ।\nततो भ्रष्टस्तु राजेन्द्र समृद्धे जायते कुले ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005468008, "chapter_id": 25468, "verse_number": "१-३८-९", "content_sanskrit": "अधः शिरास्त्वयोधारामुर्ध्वपादः पिबेन्नरः ।\nशतं वर्षसहस्राणि स्वर्गलोके महीयते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005468009, "chapter_id": 25468, "verse_number": "१-३८-१०", "content_sanskrit": "तस्माद् भ्रष्टस्तु राजेन्द्र अग्निहोत्री भवेन्नरः ।\nभुक्त्वा तु विपुलान् भोगांस्तत् तीर्थं भजते पुनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005468010, "chapter_id": 25468, "verse_number": "१-३८-११", "content_sanskrit": "यः स्वदेहं विकर्त्तेद् वा शकुनिभ्यः प्रयच्छति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005468011, "chapter_id": 25468, "verse_number": "१-३८-१२", "content_sanskrit": "विहगैरुपभुक्तस्य श्रृणु तस्यापि यत्फलम् । ।\nशतं वर्षसहस्त्राणि सोमलोके महीयते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005468012, "chapter_id": 25468, "verse_number": "१-३८-१३", "content_sanskrit": "ततस्तस्मात् परिभ्रष्टो राजा भवति धार्मिकः ।\nगुणवान् रूपसंपन्नो विद्वान् सुप्रियवाक्यवान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005468013, "chapter_id": 25468, "verse_number": "१-३८-१४", "content_sanskrit": "भुक्त्वा तु विपुलान् भोगांस्तततीर्थं भजते पुनः ।\nउत्तरे यमुनातीरे प्रयागस्य तु दक्षिणे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005468014, "chapter_id": 25468, "verse_number": "१-३८-१५", "content_sanskrit": "ऋणप्रमोचनं नाम तीर्थं तु परमं स्मृतम् ।\nएकरात्रोषितः स्नात्वा ऋणैस्तत्र प्रमुच्यते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005468015, "chapter_id": 25468, "verse_number": "१-३८-१६", "content_sanskrit": "सूर्यलोकमवाप्नोति अनृणश्च सदा भवेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]