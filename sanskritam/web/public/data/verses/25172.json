[{"id": 7005172000, "chapter_id": 25172, "verse_number": "७-१-३५५-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि देवगुप्तेश्वरं प्रिये ।\nतत्र पश्चिमवायव्ये यत्र सोमोऽकरोत्तपः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005172001, "chapter_id": 25172, "verse_number": "७-१-३५५-२", "content_sanskrit": "गुप्तो भूत्वा कुष्ठरोगाल्लज्जयाधोमुखः स्थितः ।\nदिव्यं वर्षसहस्रं तु प्रभासक्षेत्र उत्तमे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005172002, "chapter_id": 25172, "verse_number": "७-१-३५५-३", "content_sanskrit": "ततः प्रत्यक्षतां यातः सर्वदेवपतिः शिवः ।\nतुष्टो बभूव चंद्रस्य क्षयनाशं तथाऽकरोत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005172003, "chapter_id": 25172, "verse_number": "७-१-३५५-४", "content_sanskrit": "क्षयरोगविनिर्मुक्तस्ततोऽभून्मृगलांछनः ।\nप्रतिष्ठाप्य महालिंगं सुरासुरनमस्कृतम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005172004, "chapter_id": 25172, "verse_number": "७-१-३५५-५", "content_sanskrit": "गुप्तस्तेपे तपो यस्मात्तस्माद्गुप्तेश्वरः स्मृतः ।\nसर्वकुष्ठहरो देवो दर्शनात्स्पर्शनादपि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005172005, "chapter_id": 25172, "verse_number": "७-१-३५५-६", "content_sanskrit": "सोमवारे विशेषेण यस्तल्लिंगं प्रपूजयेत् ।\nतस्यान्वयेऽपि देवेशि कुष्ठी कश्चिन्न जायते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005172006, "chapter_id": 25172, "verse_number": "७-१-३५५-७", "content_sanskrit": "इति श्रीस्कान्दे महा पुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये गुप्तेश्वरमाहात्म्यवर्णनंनाम चतुष्पञ्चाशदुत्तरत्रिशततमो ऽध्यायः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]