[{"id": 7001051000, "chapter_id": 21051, "verse_number": "५-३३-१", "content_sanskrit": "श्रीपराशर उवाच\nबाणोपि प्रणिपत्याग्रे मैत्रेयाह त्रिलोचनम् ।\nदेव बाहुसहस्रेण निर्विण्णोस्म्याहवं विना ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001051001, "chapter_id": 21051, "verse_number": "५-३३-२", "content_sanskrit": "कच्चिन्ममैषां बाहूनां साफल्यजनको रणः ।\nभविष्यति विना युद्धं भाराय मम किं भुजैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001051002, "chapter_id": 21051, "verse_number": "५-३३-३", "content_sanskrit": "श्रीशंकर उवाच\nमयूरध्वजभंगस्ते यदा बाण भविष्यति ।\nपिशिताशिजनानंदं प्राप्स्यसे त्वं तदा रणम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001051003, "chapter_id": 21051, "verse_number": "५-३३-४", "content_sanskrit": "श्रीपराशर उवाच\nततः प्रणम्य वरदं शंभुमभ्यागतो गृहम् ।\nसभग्नं ध्वजमालोक्य हृष्टो हर्षं पुनर्ययौ ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001051004, "chapter_id": 21051, "verse_number": "५-३३-५", "content_sanskrit": "एतस्मिन्नेव काले तु योगविद्याबलेन तम् ।\nअनिरुद्धमथानिन्ये चित्रलेखा वराप्सराः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001051005, "chapter_id": 21051, "verse_number": "५-३३-६", "content_sanskrit": "कन्यांतःपुरमभ्येत्य रममाणं सहोषया ।\nविज्ञाय रक्षिणो गत्वा शशंसुर्दैत्यभूपतेः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001051006, "chapter_id": 21051, "verse_number": "५-३३-७", "content_sanskrit": "व्यादिष्टं किंकराणां तु सैन्यं तेन महात्मना ।\nजघान परिघं घोरमादाय परवीरहा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001051007, "chapter_id": 21051, "verse_number": "५-३३-८", "content_sanskrit": "हतेषु तेषु बाणोपि रथस्थस्तद्वधोद्यतः ।\nयुध्यमानो यथाशक्ति यदुवीरेण निर्जितः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001051008, "chapter_id": 21051, "verse_number": "५-३३-९", "content_sanskrit": "मायया युयुधे तेन स तदा मंत्रिचोदितः ।\nततस्तं पन्नगास्त्रेण बबंध यदुनंदनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001051009, "chapter_id": 21051, "verse_number": "५-३३-१०", "content_sanskrit": "द्वारवत्यां क्व यातोऽसावनिरुद्धेति जल्पताम् ।\nयदूनामाचचक्षे तं बद्धं बाणेन नारदः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001051010, "chapter_id": 21051, "verse_number": "५-३३-११", "content_sanskrit": "तं शोणितपुरं नीतं श्रुत्वा विद्याविदग्धया ।\nयोषिता प्रत्ययं जग्मुर्यादवा नामरैरिति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001051011, "chapter_id": 21051, "verse_number": "५-३३-१२", "content_sanskrit": "ततो गरुडमारुह्य स्मृतमात्रागतं हरिः ।\nबलप्रद्युम्नसहितो बाणस्य प्रययौ पुरम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001051012, "chapter_id": 21051, "verse_number": "५-३३-१३", "content_sanskrit": "पुरप्रवेशो! प्रमथैर्युद्धमासीन्महात्मनः ।\nययौ बाणपुराभ्याशं नीत्वा तान्संक्षयं हरिः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001051013, "chapter_id": 21051, "verse_number": "५-३३-१४", "content_sanskrit": "ततस्त्रिपादस्त्रिशिरा ज्वरो माहेश्वरो महान् ।\nबाणरक्षार्थमभ्येत्य युयुधे शार्ङ्गधन्वना ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001051014, "chapter_id": 21051, "verse_number": "५-३३-१५", "content_sanskrit": "तद्भस्मस्पर्शसंभूततापः कृष्णांगसंगमात् ।\nअवाप बलदेवोपि श्रममामीलितेक्षणः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001051015, "chapter_id": 21051, "verse_number": "५-३३-१६", "content_sanskrit": "ततस्स युद्ध्यमानस्तु सह देवेन शार्ङ्गिणा ।\nवैष्णवेन ज्वरेणाशु कृष्णदेहान्निराकृतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001051016, "chapter_id": 21051, "verse_number": "५-३३-१७", "content_sanskrit": "नारायणभुजाघातपरिपीडनविह्वलम् ।\nतं वीक्ष्य क्षम्यतामस्येत्याह देवः पितामहः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001051017, "chapter_id": 21051, "verse_number": "५-३३-१८", "content_sanskrit": "ततश्च क्षांतमेवेति प्रोक्त्वा तं वैष्णवं ज्वरम् ।\nआत्मन्येव लयं निन्ये भगवान्मधुसूदनः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001051018, "chapter_id": 21051, "verse_number": "५-३३-१९", "content_sanskrit": "ज्वर उवाच\nमम त्वाय समं युद्धं ये स्मरीष्यंति मानवाः ।\nविज्वरास्ते भविष्यंती त्युक्त्वा चैनं ययौ ज्वरः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001051019, "chapter_id": 21051, "verse_number": "५-३३-२०", "content_sanskrit": "ततोग्नीन्भगवान्पंच जित्वा नीत्वा तथा क्षयम् ।\nदानवानां बलं कृष्णश्चूर्णयामास लीलया ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001051020, "chapter_id": 21051, "verse_number": "५-३३-२१", "content_sanskrit": "ततस्समस्तसैन्येन दैतेयानां बलेस्सुतः\nयुयुधे शंकरश्चैव कार्त्तिकेयश्च शौरिणा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001051021, "chapter_id": 21051, "verse_number": "५-३३-२२", "content_sanskrit": "हरिशंकरयोर्युद्धमतीवासीत्सुदारुणम् ।\nचुक्षुभुस्सकला लोकाश्शस्त्रास्त्रांशुप्रतापिताः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001051022, "chapter_id": 21051, "verse_number": "५-३३-२३", "content_sanskrit": "प्रलयोयमशेषस्य जगतो नूनमागतः ।\nमेनिरे त्रिदशास्तत्र वर्त्तमाने महारणे ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001051023, "chapter_id": 21051, "verse_number": "५-३३-२४", "content_sanskrit": "जृंभ कास्त्रेण गोविंदो जृंभयामास शंकरम् ।\nततः प्रणेमुर्दैतेयाः प्रमथाश्च समंततः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001051024, "chapter_id": 21051, "verse_number": "५-३३-२५", "content_sanskrit": "जृंभाभिभूतस्यु हरो रथोपस्थ उपाविशत्\nन शशाक ततो योद्धुं कृष्णेनाक्लिष्टकर्मणा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001051025, "chapter_id": 21051, "verse_number": "५-३३-२६", "content_sanskrit": "गरुजक्षतवाहश्च प्रद्युम्नास्त्रेम पीडितः ।\nकृष्णहुंकारनिर्धूतशक्तिश्चापययौ गुहः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001051026, "chapter_id": 21051, "verse_number": "५-३३-२७", "content_sanskrit": "जृंभिते शंकरे नष्टे दैत्यसैन्ये गुहे जिते ।\nनीते प्रमथसैन्ये च संक्षयं शार्ङ्गधन्वना ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001051027, "chapter_id": 21051, "verse_number": "५-३३-२८", "content_sanskrit": "नंदिना संगृहीताश्वमधिरूढो महारथम् ।\nबाणस्तत्राययौ योद्धुं कृष्णकार्ष्णिबलैस्सह ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001051028, "chapter_id": 21051, "verse_number": "५-३३-२९", "content_sanskrit": "बलभद्रो  महावीर्यो बाणसैन्यमनेकधा ।\nविव्याध बाणैः प्रभ्रश्य धर्मतश्चापलायत ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001051029, "chapter_id": 21051, "verse_number": "५-३३-३०", "content_sanskrit": "आकृष्य लांगलाग्रेण मुसलेनाशु ताडितम् ।\nबलं बलेन ददृशो! बाणो बाणैश्च चक्रिणा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001051030, "chapter_id": 21051, "verse_number": "५-३३-३१", "content_sanskrit": "ततः कृष्णेन बाणस्य युद्धमासीत्सुदारुणम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001051031, "chapter_id": 21051, "verse_number": "५-३३-३२", "content_sanskrit": "समस्यतोरिषून्दीप्तान्कायत्राणविभेदिनः ।\nकृष्णश्चिच्छेद बाणैस्तान्बाणेन प्रहिताञ्छितान् ।\nविव्याध केशवं बाणो बाणं विव्याध चक्रधृक् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001051032, "chapter_id": 21051, "verse_number": "५-३३-३३", "content_sanskrit": "मुमुचाते तथास्त्राणि बाणकृष्णौ जिगीषया ।\nपरस्परक्षतिकरौ लाघवादनिशं द्विज ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001051033, "chapter_id": 21051, "verse_number": "५-३३-३४", "content_sanskrit": "भिद्यमानेष्वश्षोए!षु शरेष्वस्त्रे च सीदति ।\nप्राचुर्येण ततो बाणं हंतुं चक्रे हरिर्मनः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001051034, "chapter_id": 21051, "verse_number": "५-३३-३५", "content_sanskrit": "ततोर्कशतसंघाततेजसा सदृशद्युति ।\nजग्राह दैत्यचक्रारिर्हरिश्चक्रं सुदर्शनम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001051035, "chapter_id": 21051, "verse_number": "५-३३-३६", "content_sanskrit": "मुञ्चतो बाणनाशाय ततश्चक्रं मधुद्विषः ।\nनग्ना दैतेयविद्याऽभूत्कोटरी पुरतो हरेः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001051036, "chapter_id": 21051, "verse_number": "५-३३-३७", "content_sanskrit": "तामग्रतो हरिर्दृष्ट्वा मीलिताक्षस्सुदर्शनम् ।\nमुमोच बाणमुद्दिश्य च्छेत्तुं बाहुवनं रिपोः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001051037, "chapter_id": 21051, "verse_number": "५-३३-३८", "content_sanskrit": "क्रमेण तत्तु बाहूनां बाणस्याच्युतचोदितम् ।\nछेदं चक्रेऽसुरापास्तशस्त्रौघक्षपणादृतम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001051038, "chapter_id": 21051, "verse_number": "५-३३-३९", "content_sanskrit": "छिन्ने बाहुवने तत्तु करस्थं मधुसूतनः ।\nमुमुक्षुर्बाणनाशाय विज्ञातस्त्रिपुरद्विषा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001051039, "chapter_id": 21051, "verse_number": "५-३३-४०", "content_sanskrit": "समुपेत्याह गोविंदं सामपूर्वमुमापतिः ।\nविलोक्य बाणं दादडच्छेदासृक्स्राववर्षिणम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001051040, "chapter_id": 21051, "verse_number": "५-३३-४१", "content_sanskrit": "शंकर उवाच\nकृष्णकृष्ण जगन्नाथ जाने त्वां पुरुषोत्तमम् ।\nपरेशं परमात्मानमनादिनिधनं हरिम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001051041, "chapter_id": 21051, "verse_number": "५-३३-४२", "content_sanskrit": "देवतिर्यङ्मनुष्येषु शरीरग्रहणात्मिका ।\nलीलेयं सर्वभूतस्य तव चेष्टोपलक्षणा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001051042, "chapter_id": 21051, "verse_number": "५-३३-४३", "content_sanskrit": "तत्प्रसीदाभयं दत्तं बाणस्यास्य मया प्रभो ।\nतत्त्वाय नानृतं कार्यं यन्मया व्याहृतं वचः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001051043, "chapter_id": 21051, "verse_number": "५-३३-४४", "content_sanskrit": "अस्मत्संश्रयदृप्तोयं नापराधी तवाव्यय ।\nमया दत्तवरो दैत्यस्ततस्त्वां क्षमयाम्यहम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001051044, "chapter_id": 21051, "verse_number": "५-३३-४५", "content_sanskrit": "श्रीपराशर उवाच\nइत्युक्तः प्राह गोविंदश्शूलपाणिमुमापतिम् ।\nप्रसन्नवदनो भूत्वा गतामर्षोऽसुरं प्रति ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001051045, "chapter_id": 21051, "verse_number": "५-३३-४६", "content_sanskrit": "श्रीभगवानुवाच\nयुष्मद्दत्तवरो बाणो जीवतामेष शंकर ।\nत्वद्वाक्यगौरवादेतन्मया चक्रं निवर्त्तितम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001051046, "chapter_id": 21051, "verse_number": "५-३३-४७", "content_sanskrit": "त्वया यदभयं दत्तं तद्दत्तमखिलं मया ।\nमत्तोऽविभिन्नमात्मानं द्र ष्टुमर्हसि शंकर ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001051047, "chapter_id": 21051, "verse_number": "५-३३-४८", "content_sanskrit": "योहं स त्वं जगच्चेदं सदेवासुरमानुषम् ।\nमत्तो नान्यदश्षॐ यत्तत्त्वं ज्ञातुमिहार्हसि ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001051048, "chapter_id": 21051, "verse_number": "५-३३-४९", "content_sanskrit": "अविद्यामोहितात्मानः पुरुषा भिन्नदर्शिनः ।\nवदंति भेदं पश्यंति चावयोरंतरं हर ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001051049, "chapter_id": 21051, "verse_number": "५-३३-५०", "content_sanskrit": "प्रसन्नोऽहं गमिष्यामि त्वं गच्छ वृषभध्वज ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001051050, "chapter_id": 21051, "verse_number": "५-३३-५१", "content_sanskrit": "श्रीपराशर उवाच\nइत्युक्त्वा प्रययौ कृष्णः प्राद्युम्निर्यत्र तिष्ठति ।\nतद्बंधफणिनो नेशुर्गरुडानिलपोथिताः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001051051, "chapter_id": 21051, "verse_number": "५-३३-५२", "content_sanskrit": "ततोऽनिरुद्धमारोप्य सपत्नीकं गरुत्मति ।\nआजग्मुर्द्वारकां रामकार्ष्णिदामोदराः पुरीम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001051052, "chapter_id": 21051, "verse_number": "५-३३-५३", "content_sanskrit": "पुत्रपौत्रैः परिवृतस्तत्र रेमे जनार्दनः ।\nदेवीभिस्सततं विप्र भूभारतरणेच्छया ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]