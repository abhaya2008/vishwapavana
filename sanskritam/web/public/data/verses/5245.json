[{"id": 2199560, "chapter_id": 5245, "verse_number": "", "content_sanskrit": "तिलादिदानफलम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2199561, "chapter_id": 5245, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2199562, "chapter_id": 5245, "verse_number": "१", "content_sanskrit": "दह्यमानाय विप्राय यः प्रयच्छत्युपानहौ ।\nयत्फलं तस्य भवति तन्मे ब्रूहि पितामह\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2199563, "chapter_id": 5245, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2199564, "chapter_id": 5245, "verse_number": "२", "content_sanskrit": "उपानहौ प्रयच्छेद् यो ब्राह्मणेभ्यः समाहितः ।\nमर्दते कण्टकान् सर्वान् विषमान् निस्तरत्यपि ।\nस शत्रूणामुपरि च सन्तिष्ठति युधिष्ठिर\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2199565, "chapter_id": 5245, "verse_number": "३", "content_sanskrit": "यानं चाश्वतरीयुक्तं तस्य शुभ्रं विशाम्पते ।\nउपतिष्ठति कौन्तेय रूप्यकाञ्चनभूषणम् ।\nशकटं दम्यसंयुक्तं दत्तं भवति चैव हि\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2199566, "chapter_id": 5245, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2199567, "chapter_id": 5245, "verse_number": "४", "content_sanskrit": "यत्फलं तिलदाने च भूमिदाने च कीर्तितम् ।\nगोप्रदानेऽन्नदाने च भूयस्तद् ब्रूहि कौरव\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2199568, "chapter_id": 5245, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2199569, "chapter_id": 5245, "verse_number": "५", "content_sanskrit": "शृणुष्व मम कौन्तेय तिलदानस्य यत्फलम् ।\nनिशम्य च यथान्यायं प्रयच्छ कुरुसत्तम\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2199570, "chapter_id": 5245, "verse_number": "६", "content_sanskrit": "पितॄणां प्रथमं भोज्यं तिलाः सृष्टाः स्वयम्भुवा ।\nतिलदानेन वै तस्मात् पितृपक्षः प्रमोदते\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2199571, "chapter_id": 5245, "verse_number": "७", "content_sanskrit": "माघमासे तिलान् यस्तु ब्राह्मणेभ्यः प्रयच्छति ।\nसर्वसत्त्वसमाकीर्णं नरकं स न पश्यति\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2199572, "chapter_id": 5245, "verse_number": "८", "content_sanskrit": "सर्वकामैः स यजते यस्तिलैर्यजते पितॄन् ।\nन चाकामेन दातव्यं तिलश्राद्धं कथञ्चन\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2199573, "chapter_id": 5245, "verse_number": "९", "content_sanskrit": "महर्षेः काश्यपस्यैते गात्रेभ्यः प्रसृतास्तिलाः ।\nततो दिव्यं गता भावं प्रदानेषु तिलाः प्रभो\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2199574, "chapter_id": 5245, "verse_number": "१०", "content_sanskrit": "पौष्टिका रूपदाश्चैव तथा पापविनाशनाः ।\nतस्मात् सर्वप्रदानेभ्यस्तिलदानं विशिष्यते\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2199575, "chapter_id": 5245, "verse_number": "११", "content_sanskrit": "आपस्तम्बश्च मेधावी शङ्खश्च लिखितस्तथा ।\nमहर्षिर्गौतमश्चापि तिलदानैर्दिवं गताः\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2199576, "chapter_id": 5245, "verse_number": "१२", "content_sanskrit": "तिलहोमपरा विप्राः सर्वे संयतमैथुनाः ।\nसमा गव्येन हविषा प्रवृत्तिषु च संस्थिताः\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2199577, "chapter_id": 5245, "verse_number": "१३", "content_sanskrit": "सर्वेषामेव दानानां तिलदानं परं स्मृतम् ।\nअक्षयं सर्वदानानां तिलदानमिहोच्यते\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2199578, "chapter_id": 5245, "verse_number": "१४", "content_sanskrit": "उत्पन्ने च पुरा हव्ये कुशिकर्षिः परन्तप ।\nतिलैरग्नित्रयं हुत्वा प्राप्तवान् गतिमुत्तमाम्\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2199579, "chapter_id": 5245, "verse_number": "समाप्तिः", "content_sanskrit": "इति प्रोक्तं कुरुश्रेष्ठ तिलदानमनुत्तमम् ।\nविधानं येन विधिना तिलानामिह शस्यते\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2199580, "chapter_id": 5245, "verse_number": "१६", "content_sanskrit": "अत ऊर्ध्वं निबोधेदं देवानां यष्टुमिच्छताम् ।\nसमागमं महाराज ब्रह्मणा वै स्वयम्भुवा\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2199581, "chapter_id": 5245, "verse_number": "१७", "content_sanskrit": "देवाः समेत्य ब्रह्माणं भूमिभागे यियक्षवः ।\nशुभं देशमयाचन्त यजेम इति पार्थिव\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2199582, "chapter_id": 5245, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2199583, "chapter_id": 5245, "verse_number": "१८", "content_sanskrit": "भगवंस्त्वं प्रभुर्भूमेः सर्वस्य त्रिदिवस्य च ।\nयजेमहि महाभाग यज्ञं भवदनुज्ञया ।\nनाननुज्ञातभूमिर्हि यज्ञस्य फलमश्नुते\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2199584, "chapter_id": 5245, "verse_number": "१९", "content_sanskrit": "त्वं हि सर्वस्य जगतः स्थावरस्य चरस्य च ।\nप्रभुर्भवसि तस्मात्त्वं समनुज्ञातुमर्हसि\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2199585, "chapter_id": 5245, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2199586, "chapter_id": 5245, "verse_number": "२०", "content_sanskrit": "ददामि मेदिनीभागं भवद्भ्योऽहं सुरर्षभाः ।\nयस्मिन् देशे करिष्यध्वं यज्ञं काश्यपनन्दनाः\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2199587, "chapter_id": 5245, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2199588, "chapter_id": 5245, "verse_number": "२१", "content_sanskrit": "भगवन् कृतकामाः स्मो यक्ष्यामस्त्वाप्तदक्षिणैः ।\nइमं तु देशं मुनयः पर्युपासन्त नित्यदा\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2199589, "chapter_id": 5245, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2199590, "chapter_id": 5245, "verse_number": "२२", "content_sanskrit": "ततोऽगस्त्यश्च कण्वश्च भृगुरत्रिर्वृषाकपिः ।\nअसितो देवलश्चैव देवयज्ञमुपागमन्\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2199591, "chapter_id": 5245, "verse_number": "२३", "content_sanskrit": "ततो देवा महात्मान ईजिरे यज्ञमच्युत ।\nतथा समापयामासुर्यथाकालं सुरर्षभाः\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2199592, "chapter_id": 5245, "verse_number": "२४", "content_sanskrit": "त इष्टयज्ञास्त्रिदशा हिमवत्यचलोत्तमे ।\nषष्ठमंशं क्रतोस्तस्य भूमिदानं प्रचक्रिरे\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2199593, "chapter_id": 5245, "verse_number": "२५", "content_sanskrit": "प्रादेशमात्रं भूमेस्तु यो दद्यादनुपस्कृतम् ।\nन सीदति स कृच्छ्रेषु न च दुर्गाण्यवाप्नुते\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2199594, "chapter_id": 5245, "verse_number": "२६", "content_sanskrit": "शीतवातातपसहां गृहभूमिं सुसंस्कृताम् ।\nप्रदाय सुरलोकस्थः पुण्यान्तेऽपि न चाल्यते\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2199595, "chapter_id": 5245, "verse_number": "२७", "content_sanskrit": "मुदितो वसते प्राज्ञः शक्रेण सह पार्थिव ।\nप्रतिश्रयप्रदाता च सोऽपि स्वर्गे महीयते\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2199596, "chapter_id": 5245, "verse_number": "२८", "content_sanskrit": "अध्यापककुले जातः श्रोत्रियो नियतेन्द्रियः ।\nगृहे यस्य वसेत् तुष्टः प्रधानं लोकमश्नुते\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2199597, "chapter_id": 5245, "verse_number": "२९", "content_sanskrit": "तथा गवार्थे शरणं शीतवर्षसहं महत् ।\nआसप्तमं तारयति कुलं भरतसत्तम\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2199598, "chapter_id": 5245, "verse_number": "३०", "content_sanskrit": "क्षेत्रभूमिं ददल्लोके पुत्र श्रियमवाप्नुयात् ।\nरत्नभूमिं प्रदत्त्वा तु कुलवंशं विवर्धयेत्\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2199599, "chapter_id": 5245, "verse_number": "३१", "content_sanskrit": "न चोषरां न निर्दग्धां महीं दद्यात् कथञ्चन ।\nन श्मशानपरीतां च न च पापनिषेविताम्\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2199600, "chapter_id": 5245, "verse_number": "३२", "content_sanskrit": "पारक्ये भूमिदेशे तु पितॄणां निर्वपेत् तु यः ।\nतद्भूमिस्वामिपितृभिः श्राद्धकर्म विहन्यते\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2199601, "chapter_id": 5245, "verse_number": "३३", "content_sanskrit": "तस्मात् क्रीत्वा महीं दद्यात् स्वल्पामपि विचक्षणः ।\nपिण्डः पितृभ्यो दत्तो वै तस्यां भवति शाश्वतः\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2199602, "chapter_id": 5245, "verse_number": "३४", "content_sanskrit": "अटवीपर्वताश्चैव नदीतीर्थानि यानि च ।\nसर्वाण्यस्वामिकान्याहुर्न हि तत्र परिग्रहः\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2199603, "chapter_id": 5245, "verse_number": "३५", "content_sanskrit": "इत्येतद् भूमिदानस्य फलमुक्तं विशाम्पते ।\nअतः परं तु गोदानं कीर्तयिष्यामि तेऽनघ\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2199604, "chapter_id": 5245, "verse_number": "३६", "content_sanskrit": "गावोऽधिकास्तपस्विभ्यो यस्मात् सर्वेभ्य एव च ।\nतस्मान्महेश्वरो देवस्तपस्ताभिः समास्थितः\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2199605, "chapter_id": 5245, "verse_number": "३७", "content_sanskrit": "ब्रह्मलोके वसन्त्येताः सोमेन सह भारत ।\nआसां ब्रह्मर्षयः सिद्धाः प्रार्थयन्ति परां गतिम्\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2199606, "chapter_id": 5245, "verse_number": "३८", "content_sanskrit": "पयसा हविषा दध्ना शकृताप्यथ चर्मणा ।\nअस्थिभिश्चोपकुर्वन्ति शृङ्गैर्वालैश्च भारत\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2199607, "chapter_id": 5245, "verse_number": "३९", "content_sanskrit": "नासां शीतातपौ स्यातां सदैताः कर्म कुर्वते ।\nन वर्षं विषमं वापि दुःखमासां भवत्युत\t ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2199608, "chapter_id": 5245, "verse_number": "४०", "content_sanskrit": "ब्राह्मणैः सहिता यान्ति तस्मात् परतरं पदम् ।\nएकं गोब्राह्मणं तस्मात् प्रवदन्ति मनीषिणः\t ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2199609, "chapter_id": 5245, "verse_number": "४१", "content_sanskrit": "रन्तिदेवस्य यज्ञे ताः पशुत्वेनोपकल्पिताः ।\nततश्चर्मण्वती राजन् गोचर्मभ्यः प्रवर्तिता\t ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2199610, "chapter_id": 5245, "verse_number": "४२", "content_sanskrit": "पशुत्वाच्च विनिर्मुक्ताः प्रदानायोपकल्पिताः ।\nता इमा विप्रमुख्येभ्यो यो ददाति महीपते ।\nनिस्तरेदापदं कृच्छ्रां विषमस्थोऽपि पार्थिव\t ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2199611, "chapter_id": 5245, "verse_number": "४३", "content_sanskrit": "गवां सहस्रदः प्रेत्य नरकं न प्रपश्यति ।\nसर्वत्र विजयं चापि लभते मनुजाधिप\t ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2199612, "chapter_id": 5245, "verse_number": "४४", "content_sanskrit": "अमृतं वै गवां क्षीरमित्याह त्रिदशाधिपः ।\nतस्माद् ददाति यो धेनुममृतं स प्रयच्छति\t ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2199613, "chapter_id": 5245, "verse_number": "४५", "content_sanskrit": "अग्नीनामव्ययं ह्येतद् हौम्यं वेदविदो विदुः ।\nतस्माद् ददाति यो धेनुं स हौम्यं सम्प्रयच्छति\t ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2199614, "chapter_id": 5245, "verse_number": "४६", "content_sanskrit": "स्वर्गो वै मूर्तिमानेष वृषभं यो गवां पतिम् ।\nविप्रे गुणयुते दद्यात् स वै स्वर्गे महीयते\t ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2199615, "chapter_id": 5245, "verse_number": "४७", "content_sanskrit": "प्राणा वै प्राणिनामेते प्रोच्यन्ते भरतर्षभ ।\nतस्माद् ददाति यो धेनुं प्राणान् वै स प्रयच्छति\t ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2199616, "chapter_id": 5245, "verse_number": "४८", "content_sanskrit": "गावः शरण्या भूतानामिति वेदविदो विदुः ।\nतस्माद् ददाति यो धेनुं शरणं सम्प्रयच्छति\t ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2199617, "chapter_id": 5245, "verse_number": "४९", "content_sanskrit": "न वधार्थं प्रदातव्या न कीनाशे न नास्तिके ।\nगोजीविने न दातव्या तथा गौः पुरुषर्षभ\t ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2199618, "chapter_id": 5245, "verse_number": "५०", "content_sanskrit": "ददाति तादृशानां वै नरो गाः पापकर्मणाम् ।\nअक्षयं नरकं यातीत्येवमाहुर्मनीषिणः\t ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2199619, "chapter_id": 5245, "verse_number": "५१", "content_sanskrit": "न कृशां नापवत्सां वा वन्ध्यां रोगान्वितां तथा ।\nन व्यङ्गां न परिश्रान्तां दद्याद् गां ब्राह्मणाय वै\t ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2199620, "chapter_id": 5245, "verse_number": "५२", "content_sanskrit": "दशगोसहस्रदः सम्यक् शक्रेण सह मोदते ।\nअक्षयाँल्लभते लोकान् नरः शतसहस्रदः\t ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2199621, "chapter_id": 5245, "verse_number": "५३", "content_sanskrit": "इत्येतद् गोप्रदानं च तिलदानं च कीर्तितम् ।\nतथा भूमिप्रदानं च शृणुष्वान्ने च भारत\t ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2199622, "chapter_id": 5245, "verse_number": "५४", "content_sanskrit": "अन्नदानं प्रधानं हि कौन्तेय परिचक्षते ।\nअन्नस्य हि प्रदानेन रन्तिदेवो दिवं गतः\t ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2199623, "chapter_id": 5245, "verse_number": "५५", "content_sanskrit": "श्रान्ताय क्षुधितायान्नं यः प्रयच्छति भूमिप ।\nस्वायम्भुवं महाभागं स पश्यति नराधिप\t ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2199624, "chapter_id": 5245, "verse_number": "५६", "content_sanskrit": "न हिरण्यैर्न वासोभिर्नाश्वदानेन भारत ।\nप्राप्नुवन्ति नराः श्रेयो यथेहान्नप्रदाः प्रभो\t ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2199625, "chapter_id": 5245, "verse_number": "५७", "content_sanskrit": "अन्नं वै परमं द्रव्यमन्नं श्रीश्च परा मता ।\nअन्नात् प्राणः प्रभवति तेजो वीर्यं बलं तथा\t ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2199626, "chapter_id": 5245, "verse_number": "५८", "content_sanskrit": "सद्भ्यो ददाति यश्चान्नं सदैकाग्रमना नरः ।\nन स दुर्गाण्यवाप्नोतीत्येवमाह पराशरः\t ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2199627, "chapter_id": 5245, "verse_number": "५९", "content_sanskrit": "अर्चयित्वा यथान्यायं देवेभ्योऽन्नं निवेदयेत् ।\nयदन्नो हि नरो राजंस्तदन्नास्तस्य देवताः\t ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2199628, "chapter_id": 5245, "verse_number": "६०", "content_sanskrit": "कौमुद्यां शुक्लपक्षे तु योऽन्नदानं करोत्युत ।\nस सन्तरति दुर्गाणि प्रेत्य चानन्त्यमश्नुते\t ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2199629, "chapter_id": 5245, "verse_number": "६१", "content_sanskrit": "अभुक्त्वाऽतिथये चान्नं प्रयच्छेद् यः समाहितः ।\nस वै ब्रह्मविदां लोकान् प्राप्नुयाद् भरतर्षभ\t ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2199630, "chapter_id": 5245, "verse_number": "६२", "content_sanskrit": "सुकृच्छ्रामापदं प्राप्तश्चान्नदः पुरुषस्तरेत् ।\nपापं तरति चैवेह दुष्कृतं चापकर्षति\t ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2199631, "chapter_id": 5245, "verse_number": "६३", "content_sanskrit": "इत्येतदन्नदानस्य तिलदानस्य चैव ह ।\nभूमिदानस्य च फलं गोदानस्य च कीर्तितम्\t ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2199632, "chapter_id": 5245, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे गोभूतिलान्नदानप्रशंसानाम षण्णवतितमोऽध्यायः ॥९६ ॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]