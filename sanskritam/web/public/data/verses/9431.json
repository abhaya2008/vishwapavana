[{"id": 5000431000, "chapter_id": 9431, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे चतुर्विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000431001, "chapter_id": 9431, "verse_number": "६-२४-१", "content_sanskrit": "सा वीरसमिती राज्ञा विरराज व्यवस्थिता।\nशशिना शुभनक्षत्रा पौर्णमासीव शारदी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000431002, "chapter_id": 9431, "verse_number": "६-२४-२", "content_sanskrit": "प्रचचाल च वेगेन त्रस्ता चैव वसुंधरा।\nपीड्यमाना बलौघेन तेन सागरवर्चसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000431003, "chapter_id": 9431, "verse_number": "६-२४-३", "content_sanskrit": "ततः शुश्रुवुराक्रुष्टं लङ्कायां काननौकसः।\nभेरीमृदङ्गसंघुष्टं तुमुलं लोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000431004, "chapter_id": 9431, "verse_number": "६-२४-४", "content_sanskrit": "बभूवुस्तेन घोषेण संहृष्टा हरियूथपाः।\nअमृष्यमाणास्तद् घोषं विनेदुर्घोषवत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000431005, "chapter_id": 9431, "verse_number": "६-२४-५", "content_sanskrit": "राक्षसास्तत् प्लवंगानां शुश्रुवुस्तेऽपि गर्जितम्।\nनर्दतामिव दृप्तानां मेघानामम्बरे स्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000431006, "chapter_id": 9431, "verse_number": "६-२४-६", "content_sanskrit": "दृष्ट्वा दाशरथिर्लङ्कां चित्रध्वजपताकिनीम्।\nजगाम मनसा सीतां दूूयमानेन चेतसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000431007, "chapter_id": 9431, "verse_number": "६-२४-७", "content_sanskrit": "अत्र सा मृगशावाक्षी रावणेनोपरुध्यते।\nअभिभूता ग्रहेणेव लोहिताङ्गेन रोहिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000431008, "chapter_id": 9431, "verse_number": "६-२४-८", "content_sanskrit": "दीर्घमुष्णं च निःश्वस्य समुद्वीक्ष्य च लक्ष्मणम्।\nउवाच वचनं वीरस्तत्कालहितमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000431009, "chapter_id": 9431, "verse_number": "६-२४-९", "content_sanskrit": "आलिखन्तीमिवाकाशमुत्थितां पश्य लक्ष्मण।\nमनसेव कृतां लङ्कां नगाग्रे विश्वकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000431010, "chapter_id": 9431, "verse_number": "६-२४-१०", "content_sanskrit": "विमानैर्बहुभिर्लङ्का संकीर्णा रचिता पुरा।\nविष्णोः पदमिवाकाशं छादितं पाण्डुभिर्घनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000431011, "chapter_id": 9431, "verse_number": "६-२४-११", "content_sanskrit": "पुष्पितैः शोभिता लङ्का वनैश्चित्ररथोपमैः।\nनानापतगसंघुष्टफलपुष्पोपगैः शुभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000431012, "chapter_id": 9431, "verse_number": "६-२४-१२", "content_sanskrit": "पश्य मत्तविहंगानि प्रलीनभ्रमराणि च।\nकोकिलाकुलखण्डानि दोधवीति शिवोऽनिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000431013, "chapter_id": 9431, "verse_number": "६-२४-१३", "content_sanskrit": "इति दाशरथी रामो लक्ष्मणं समभाषत।\nबलं च तत्र विभजच्छास्त्रदृष्टेन कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000431014, "chapter_id": 9431, "verse_number": "६-२४-१४", "content_sanskrit": "शशास कपिसेनां तां बलादादाय वीर्यवान्।\nअङ्गदः सह नीलेन तिष्ठेदुरसि दुर्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000431015, "chapter_id": 9431, "verse_number": "६-२४-१५", "content_sanskrit": "तिष्ठेद् वानरवाहिन्या वानरौघसमावृतः।\nआश्रितो दक्षिणं पार्श्वमृषभो नाम वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000431016, "chapter_id": 9431, "verse_number": "६-२४-१६", "content_sanskrit": "गन्धहस्तीव दुर्धर्षस्तरस्वी गन्धमादनः।\nतिष्ठेद् वानरवाहिन्याः सव्यं पार्श्वमधिष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000431017, "chapter_id": 9431, "verse_number": "६-२४-१७", "content_sanskrit": "मूर्ध्नि स्थास्याम्यहं यत्तो लक्ष्मणेन समन्वितः।\nजाम्बवांश्च सुषेणश्च वेगदर्शी च वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000431018, "chapter_id": 9431, "verse_number": "६-२४-१८", "content_sanskrit": "ऋक्षमुख्या महात्मानः कुक्षिं रक्षन्तु ते त्रयः।\nजघनं कपिसेनायाः कपिराजोऽभिरक्षतु।\nपश्चार्धमिव लोकस्य प्रचेतास्तेजसा वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000431019, "chapter_id": 9431, "verse_number": "६-२४-१९", "content_sanskrit": "सुविभक्तमहाव्यूहा महावानररक्षिता।\nअनीकिनी सा विबभौ यथा द्यौः साभ्रसम्प्लवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000431020, "chapter_id": 9431, "verse_number": "६-२४-२०", "content_sanskrit": "प्रगृह्य गिरिशृङ्गाणि महतश्च महीरुहान्।\nआसेदुर्वानरा लङ्कां मिमर्दयिषवो रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000431021, "chapter_id": 9431, "verse_number": "६-२४-२१", "content_sanskrit": "शिखरैर्विकिरामैनां लङ्कां मुष्टिभिरेव वा।\nइति स्म दधिरे सर्वे मनांसि हरिपुङ्गवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000431022, "chapter_id": 9431, "verse_number": "६-२४-२२", "content_sanskrit": "ततो रामो महातेजाः सुग्रीवमिदमब्रवीत्।\nसुविभक्तानि सैन्यानि शुक एष विमुच्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000431023, "chapter_id": 9431, "verse_number": "६-२४-२३", "content_sanskrit": "रामस्य तु वचः श्रुत्वा वानरेन्द्रो महाबलः।\nमोचयामास तं दूतं शुकं रामस्य शासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000431024, "chapter_id": 9431, "verse_number": "६-२४-२४", "content_sanskrit": "मोचितो रामवाक्येन वानरैश्च निपीडितः।\nशुकः परमसंत्रस्तो रक्षोधिपमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000431025, "chapter_id": 9431, "verse_number": "६-२४-२५", "content_sanskrit": "रावणः प्रहसन्नेव शुकं वाक्यमुवाच ह।\nकिमिमौ ते सितौ पक्षौ लूनपक्षश्च दृश्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000431026, "chapter_id": 9431, "verse_number": "६-२४-२६", "content_sanskrit": "कच्चिन्नानेकचित्तानां तेषां त्वं वशमागतः।\nततः स भयसंविग्नस्तेन राज्ञाभिचोदितः।\nवचनं प्रत्युवाचेदं राक्षसाधिपमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000431027, "chapter_id": 9431, "verse_number": "६-२४-२७", "content_sanskrit": "सागरस्योत्तरे तीरेऽब्रुवं ते वचनं तथा।\nयथा संदेशमक्लिष्टं सान्त्वयन् श्लक्ष्णया गिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000431028, "chapter_id": 9431, "verse_number": "६-२४-२८", "content_sanskrit": "क्रुद्धैस्तैरहमुत्प्लुत्य दृष्टमात्रः प्लवंगमैः।\nगृहीतोऽस्म्यपि चारब्धो हन्तुं लोप्तुं च मुष्टिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000431029, "chapter_id": 9431, "verse_number": "६-२४-२९", "content_sanskrit": "न ते संभाषितुं शक्याः सम्प्रश्नोऽत्र न विद्यते।\nप्रकृत्या कोपनास्तीक्ष्णा वानरा राक्षसाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000431030, "chapter_id": 9431, "verse_number": "६-२४-३०", "content_sanskrit": "स च हन्ता विराधस्य कबन्धस्य खरस्य च।\nसुग्रीवसहितो रामः सीतायाः पदमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000431031, "chapter_id": 9431, "verse_number": "६-२४-३१", "content_sanskrit": "स कृत्वा सागरे सेतुं तीर्त्वा च लवणोदधिम्।\nएष रक्षांसि निर्धूय धन्वी तिष्ठति राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000431032, "chapter_id": 9431, "verse_number": "६-२४-३२", "content_sanskrit": "ऋक्षवानरसङ्घानामनीकानि सहस्रशः।\nगिरिमेघनिकाशानां छादयन्ति वसुंधराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000431033, "chapter_id": 9431, "verse_number": "६-२४-३३", "content_sanskrit": "राक्षसानां बलौघस्य वानरेन्द्रबलस्य च।\nनैतयोर्विद्यते संधिर्देवदानवयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000431034, "chapter_id": 9431, "verse_number": "६-२४-३४", "content_sanskrit": "पुरा प्राकारमायान्ति क्षिप्रमेकतरं कुरु।\nसीतां चास्मै प्रयच्छाशु युद्धं वापि प्रदीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000431035, "chapter_id": 9431, "verse_number": "६-२४-३५", "content_sanskrit": "शुकस्य वचनं श्रुत्वा रावणो वाक्यमब्रवीत्।\nरोषसंरक्तनयनो निर्दहन्निव चक्षुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000431036, "chapter_id": 9431, "verse_number": "६-२४-३६", "content_sanskrit": "यदि मां प्रति युद्धेरन् देवगन्धर्वदानवाः।\nनैव सीतां प्रदास्यामि सर्वलोकभयादपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000431037, "chapter_id": 9431, "verse_number": "६-२४-३७", "content_sanskrit": "कदा समभिधावन्त मामका राघवं शराः।\nवसन्ते पुष्पितं मत्ता भ्रमरा इव पादपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000431038, "chapter_id": 9431, "verse_number": "६-२४-३८", "content_sanskrit": "कदा शोणितदिग्धाङ्गं दीप्तैः कार्मुकविच्युतैः।\nशरैरादीपयिष्यामि उल्काभिरिव कुञ्जरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000431039, "chapter_id": 9431, "verse_number": "६-२४-३९", "content_sanskrit": "तच्चास्य बलमादास्ये बलेन महता वृतः।\nज्योतिषामिव सर्वेषां प्रभामुद्यन् दिवाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000431040, "chapter_id": 9431, "verse_number": "६-२४-४०", "content_sanskrit": "सागरस्येव मे वेगो मारुतस्येव मे बलम्।\nन च दाशरथिर्वेद तेन मां योद्धुमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000431041, "chapter_id": 9431, "verse_number": "६-२४-४१", "content_sanskrit": "न मे तूणीशयान् बाणान् सविषानिव पन्नगान्।\nरामः पश्यति संग्रामे तेन मां योद्धुमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000431042, "chapter_id": 9431, "verse_number": "६-२४-४२", "content_sanskrit": "न जानाति पुरा वीर्यं मम युद्धे स राघवः।\nमम चापमयीं वीणां शरकोणैः प्रवादिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000431043, "chapter_id": 9431, "verse_number": "६-२४-४३", "content_sanskrit": "ज्याशब्दतुमुलां घोरामार्तगीतमहास्वनाम्।\nनाराचतलसंनादां नदीमहितवाहिनीम्।\nअवगाह्य महारङ्गं वादयिष्याम्यहं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000431044, "chapter_id": 9431, "verse_number": "६-२४-४४", "content_sanskrit": "न वासवेनापि सहस्रचक्षुषा\nयुद्धेऽस्मि शक्यो वरुणेन वा स्वयम्।\nयमेन वा धर्षयितुं शराग्निना\nमहाहवे वैश्रवणेन वा पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000431045, "chapter_id": 9431, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे चतुर्विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]