[{"id": 2037600, "chapter_id": 1812, "verse_number": "५-५७-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2037601, "chapter_id": 1812, "verse_number": "५-५७-१", "content_sanskrit": "कांस्तत्र सञ्जयापश्यः प्रीत्यर्थेन समागतान्।\nये योत्स्यन्ते पाण्डवार्थे पुत्रस्य मम वाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2037602, "chapter_id": 1812, "verse_number": "५-५७-२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2037603, "chapter_id": 1812, "verse_number": "५-५७-२", "content_sanskrit": "मुख्यमन्धकवृष्णीनामपश्यं कृष्णमागतम्।\nचेकितानं च तत्रैव युयुधानं च सात्यकिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2037604, "chapter_id": 1812, "verse_number": "५-५७-३", "content_sanskrit": "पृथगक्षौहिणीभ्यां तु पाण्डवानभिसंश्रितौ ।\nमहारथौ समाख्यातावुभौ पुरुषमानिनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2037605, "chapter_id": 1812, "verse_number": "५-५७-४", "content_sanskrit": "अक्षौहिण्याऽथ पाञ्चाल्यो दशभिस्तनयैर्वृतः।\nसत्यजित्प्रमुखैर्वीरैर्धृष्टद्युम्नपुरोगमैः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2037606, "chapter_id": 1812, "verse_number": "५-५७-५", "content_sanskrit": "द्रुपदो वर्धयन्मानं शिखण्डिपरिपालितः।\nउपायात्सर्वसैन्यानां प्रतिच्छाद्य तदा वपुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2037607, "chapter_id": 1812, "verse_number": "५-५७-६", "content_sanskrit": "विराटः सह पुत्राभ्यां शङ्खेनैवोत्तरेण च।\nसूर्यदत्तादिभिर्वीरैर्मदिराक्षपुरोगमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2037608, "chapter_id": 1812, "verse_number": "५-५७-७", "content_sanskrit": "सहितः पृथिवीपालो भ्रातृभिस्तनयैस्तथा ।\nअक्षौहिण्यैव सैन्यानां वृतः पार्थं समाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2037609, "chapter_id": 1812, "verse_number": "५-५७-८", "content_sanskrit": "जारासन्धिर्मागधश्च धृष्टकेतुश्च चेदिराट्।\nपृथक्पृथगनुप्राप्तौ पृथगक्षौहिणीवृतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2037610, "chapter_id": 1812, "verse_number": "५-५७-९", "content_sanskrit": "केकया भ्रातरः पञ्च सर्वे लोहितकध्वजाः ।\nअक्षौहिणीपरिवृताः पाण्डवानभिसंश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2037611, "chapter_id": 1812, "verse_number": "५-५७-१०", "content_sanskrit": "एतानेतावतस्तत्र तानपश्यं समागतान्।\nये पाण्डवार्थे योत्स्यन्ति धार्तराष्ट्रस्य वाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2037612, "chapter_id": 1812, "verse_number": "५-५७-११", "content_sanskrit": "यो वेद `मानुषं व्यूहं दैवं गान्धर्वमासुरम्।\nस तत्र सेनाप्रमुखे धृषटद्युम्नो महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2037613, "chapter_id": 1812, "verse_number": "५-५७-१२", "content_sanskrit": "भीष्मः शान्तनवो राजन्भागः क्लृप्तः शिखण्डिनः\nतं विराटोऽनुसंयाता सार्धं मत्स्यैः प्रहारिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2037614, "chapter_id": 1812, "verse_number": "५-५७-१३", "content_sanskrit": "ज्येष्ठस्य पाण्डुपुत्रस्य भागो मद्राधिपो बली।\nतौ तु तत्राब्रुवन्केचिद्विषमौ नो मताविति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2037615, "chapter_id": 1812, "verse_number": "५-५७-१४", "content_sanskrit": "दुर्योधनः सहसुतः सार्धं भ्रातृशतेन च।\nप्राच्याश्च दाक्षिणात्याश्च भीमसेनस्य भागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2037616, "chapter_id": 1812, "verse_number": "५-५७-१५", "content_sanskrit": "अर्जुनस्य तु भागेन कर्णे वैकर्तनो मतः।\nअश्वत्थामा विकर्णश्च सैन्धवश्च जयद्रथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2037617, "chapter_id": 1812, "verse_number": "५-५७-१६", "content_sanskrit": "अशक्याश्चैव ये केचित्पृथिव्यां शूरमानिनः ।\nसर्वांस्तानर्जुनः पार्थः कल्पयामास भागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2037618, "chapter_id": 1812, "verse_number": "५-५७-१७", "content_sanskrit": "महेष्वांसा राजपुत्रा भ्रातरः पञ्च केकयाः ।\nकेकयानेव भागेन कृत्वा योत्स्यन्ति संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2037619, "chapter_id": 1812, "verse_number": "५-५७-१८", "content_sanskrit": "तेषामेव कृतो भागो मालवाः साल्वकास्तथा।\nत्रिगर्तानां च वै मुख्यौ यौ तौ संशप्तकाविति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2037620, "chapter_id": 1812, "verse_number": "५-५७-१९", "content_sanskrit": "दुर्योधनसुताः सर्वे तथा दुःशासनस्य च।\nसौभद्रेण कृतो भागो राजा चैव बृहद्बलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2037621, "chapter_id": 1812, "verse_number": "५-५७-२०", "content_sanskrit": "द्रौपदेया महेष्वासाः सुवर्णविकृतध्वजाः ।\nधृष्टद्युम्नमुखा द्रोणमभियास्यन्ति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2037622, "chapter_id": 1812, "verse_number": "५-५७-२१", "content_sanskrit": "चेकितानः सोमदत्तं द्वैरथे योद्धुमिच्छति।\nभोजं तु कृतवर्माणं युयुधानो युयुत्सति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2037623, "chapter_id": 1812, "verse_number": "५-५७-२२", "content_sanskrit": "सहदेवस्तु माद्रेयः शूरः संक्रन्दनो युधि।\nस्वमंशं कल्पयामास श्यालं ते सुबलात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2037624, "chapter_id": 1812, "verse_number": "५-५७-२३", "content_sanskrit": "उलूकं चैव कैतव्यं ये च सारस्वता गणाः।\nनकुलः कल्पयामास भागं माद्रवतीसुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2037625, "chapter_id": 1812, "verse_number": "५-५७-२४", "content_sanskrit": "ये चान्ये पार्थिवा राजन्प्रत्युद्यास्यन्ति सङ्गरे।\nसमाह्वानेन तांश्चापि पाण्डुपुत्रा अकल्पयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2037626, "chapter_id": 1812, "verse_number": "५-५७-२५", "content_sanskrit": "एवमेषामनीकानि प्रविभक्तानि भागशः।\nयत्ते कार्यं सपुत्रस्य क्रियतां तदकालिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2037627, "chapter_id": 1812, "verse_number": "५-५७-२६x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2037628, "chapter_id": 1812, "verse_number": "५-५७-२६", "content_sanskrit": "न सन्ति सर्वे पुत्रा मे मूढा दुर्द्यूतदेविनः।\nयेषां युद्धं बलवता भीमेन रणमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2037629, "chapter_id": 1812, "verse_number": "५-५७-२७", "content_sanskrit": "राजानः पार्थिवाः सर्वे प्रोक्षिताः कालधर्मणा ।\nगाण्डीवाग्निं प्रवेक्ष्यन्ति पतङ्गा इव पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2037630, "chapter_id": 1812, "verse_number": "५-५७-२८", "content_sanskrit": "विद्रुतां वाहिनीं मन्ये कृतवैरैर्महात्मभिः ।\nतां रणे केऽनुयास्यन्ति प्रभग्नां पाण्डवैर्युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2037631, "chapter_id": 1812, "verse_number": "५-५७-२९", "content_sanskrit": "सर्वे ह्यतिरथाः शूराः कीर्तिमन्तः प्रतापिनः ।\nसूर्यपावकयोस्तुल्यास्तेजसा समितिंजयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2037632, "chapter_id": 1812, "verse_number": "५-५७-३०", "content_sanskrit": "येषां युधिष्ठिरो नेता गोप्ता च मधुसूदनः ।\nयोधौ च पाण्डवौ वीरौ सव्यसाचिवृकोदरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2037633, "chapter_id": 1812, "verse_number": "५-५७-३१", "content_sanskrit": "नकुलः सहदेवश्च धृष्टद्युम्नश्च पार्षतः।\nसात्यकिर्द्रुपदश्चैव धृष्टकेतुश्च सानुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2037634, "chapter_id": 1812, "verse_number": "५-५७-३२", "content_sanskrit": "उत्तमौजाश्च पाञ्चाल्यो युधामन्युश्च दुर्जयः।\nशिखण्डी क्षत्रदेवश्च तथा वैराटिरुत्तरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2037635, "chapter_id": 1812, "verse_number": "५-५७-३३", "content_sanskrit": "काशयश्चेदयश्चैव मत्स्याः सर्वे च सृञ्जयाः ।\nविराटपुत्रो बभ्रुश्च पाञ्चालाश्च प्रभद्रकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2037636, "chapter_id": 1812, "verse_number": "५-५७-३४", "content_sanskrit": "येषांमिन्द्रोऽप्यकामानां न हरेत्पृथिवीमिमाम्।\nवीराणां रणधीराणां ये भिन्द्युः पर्वतानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2037637, "chapter_id": 1812, "verse_number": "५-५७-३५", "content_sanskrit": "तान्सर्वगुणसंपन्नानमनुष्यप्रतापिनः ।\nक्रोशतो मम दुष्पुत्रो योद्धुमिच्छति सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2037638, "chapter_id": 1812, "verse_number": "५-५७-३६x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2037639, "chapter_id": 1812, "verse_number": "५-५७-३६", "content_sanskrit": "उभौ स्व एकजातीयौ तथोभौ भूमिगोचरौ ।\nअथ कस्मात्पाण्डवानामेकतो मन्यसे जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2037640, "chapter_id": 1812, "verse_number": "५-५७-३७", "content_sanskrit": "पितामहं च द्रोणं च कृपं कर्णं च दुर्जयम्।\nजयद्रथं सोमदत्तमश्वत्थामानमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2037641, "chapter_id": 1812, "verse_number": "५-५७-३८", "content_sanskrit": "सुतेजसो महेष्वासानिन्द्रोऽपि सहितोऽमरैः ।\nअशक्तः समरे जेतुं किं पुनस्तात पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2037642, "chapter_id": 1812, "verse_number": "५-५७-३९", "content_sanskrit": "सर्वे च पृथिवीपाला मदर्थे तात पाण्डवान्।\nआर्याः शस्त्रभृतः शूराः समर्थाः प्रतिबाधितुं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2037643, "chapter_id": 1812, "verse_number": "५-५७-४०", "content_sanskrit": "न मामकान्पाण्डवास्ते समर्थाः प्रतिवीक्षितुम् ।\nपराक्रान्तो ह्यहं पाण्डून्सपुत्रान्योद्धुमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2037644, "chapter_id": 1812, "verse_number": "५-५७-४१", "content_sanskrit": "मत्प्रियं पार्थिवाः सर्वे ये चिकीर्षन्ति भारत ।\nते तानावारयिष्यन्ति ऐणेयानिव तन्तुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2037645, "chapter_id": 1812, "verse_number": "५-५७-४२", "content_sanskrit": "महता रथवंशेन शरजालैश्च मामकैः ।\nअभिद्रुता भविष्यन्ति पाञ्चालाः पाण्डवैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2037646, "chapter_id": 1812, "verse_number": "५-५७-४३x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2037647, "chapter_id": 1812, "verse_number": "५-५७-४३", "content_sanskrit": "उन्मत्त इव मे पुत्रो विलपत्येष सञ्जय।\nन हि शक्तो रमे जेतुं धर्मराजं युधिष्ठिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2037648, "chapter_id": 1812, "verse_number": "५-५७-४४", "content_sanskrit": "जानाति हि यथा भीष्मः पाण्डवानां यशस्विनाम्।\nबलवत्तां सपुत्राणां धर्मज्ञानां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2037649, "chapter_id": 1812, "verse_number": "५-५७-४५", "content_sanskrit": "यतो नारोचयदयं विग्रहं तैर्महात्मभिः।\nकिं तु सञ्जय मे ब्रूहि पुनस्तेषां विचेष्टितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2037650, "chapter_id": 1812, "verse_number": "५-५७-४६", "content_sanskrit": "कस्तांस्तरस्विनो भूयः सन्दीपयति पाण्डवान्।\nअर्चिष्मतो महेष्वासान्हविषा पावकानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2037651, "chapter_id": 1812, "verse_number": "५-५७-४७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2037652, "chapter_id": 1812, "verse_number": "५-५७-४७", "content_sanskrit": "धृष्टद्युम्नः सदैवैतान्सन्दीपयति भारत।\nयुद्ध्यध्वमिति माभैष्ट युद्धाद्भरतसत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2037653, "chapter_id": 1812, "verse_number": "५-५७-४८", "content_sanskrit": "ये केचित्पार्थिवास्तत्र धार्तराष्ट्रेण संवृताः।\nयुद्धे समागमिष्यन्ति तुमुले शस्त्रसङ्कुले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2037654, "chapter_id": 1812, "verse_number": "५-५७-४९", "content_sanskrit": "तान्सर्वानाहवे क्रुद्धान्सानुबन्धान्समागतान्।\nअहमेकः समादास्ये तिमिर्यत्स्यानिवोदकात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2037655, "chapter_id": 1812, "verse_number": "५-५७-५०", "content_sanskrit": "भीष्मं द्रोणं कृपं कर्णं द्रौणिं शल्यं सुयोधनम् ।\nएतांश्चापि निरोत्स्यामि वेलेव मकरालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2037656, "chapter_id": 1812, "verse_number": "५-५७-५१", "content_sanskrit": "तथा ब्रुवन्तं धर्मात्मा प्राह राजा युधिष्ठिरः।\nतव धैर्यं च वीर्यं च पाञ्चालः पाण्डवैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2037657, "chapter_id": 1812, "verse_number": "५-५७-५२", "content_sanskrit": "सर्वे समधिरूढाः स्म सङ्ग्रामान्नः समुद्धर ।\nजानामि त्वां महाबाहो क्षत्रधर्मे व्यवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2037658, "chapter_id": 1812, "verse_number": "५-५७-५३", "content_sanskrit": "समर्थमेकं पर्याप्तं कौरवाणां विनिग्रहे ।\nपुरस्तादुपयातानां कौरवाणां युयुत्सताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2037659, "chapter_id": 1812, "verse_number": "५-५७-५४", "content_sanskrit": "भवत्ता यद्विधातव्यं तन्नः श्रेयः परंतप।\nसङ्ग्रामादपयातानां भग्नानां शरणैषिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2037660, "chapter_id": 1812, "verse_number": "५-५७-५५", "content_sanskrit": "पौरुषं दर्शयञ्शूरो यस्तिष्ठेदग्रतः पुमान्।\nक्रीणीयात्तं सहस्रेण इति नीतिमतां मतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2037661, "chapter_id": 1812, "verse_number": "५-५७-५६", "content_sanskrit": "स त्वं शूरश्च वीरश्च विक्रान्तश्च नरर्षभ ।\nभयार्तानां परित्राता संयुगेषु न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2037662, "chapter_id": 1812, "verse_number": "५-५७-५७", "content_sanskrit": "एवं ब्रुवति कौन्तेये धर्मात्मनि युधिष्ठिरे।\nधृष्टद्युम्न उवाचेदं मां वचो गतसाध्वसम् ।\nसर्वाञ्जनपदान्सूत योधा दुर्योधनस्य ये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2037663, "chapter_id": 1812, "verse_number": "५-५७-५८", "content_sanskrit": "सबाह्लिकान्कुरून्ब्रूयाः प्रातिपेयाञ्शरद्वतः ।\nसूतपुत्रं तथा द्रोणं सहपुत्रं जयद्रथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2037664, "chapter_id": 1812, "verse_number": "५-५७-५९", "content_sanskrit": "दुःशासनं विकर्णं च तथा दुर्योधनं नृपम्\nभीष्मं च ब्रूहि गत्वा त्वमाशु गच्छ च माचिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2037665, "chapter_id": 1812, "verse_number": "५-५७-६०", "content_sanskrit": "युधिष्ठिरः साधुनैवाभ्युपेयो\nमा वोऽवधीदर्जुनो देवगुप्तः।\nराज्यं दद्ध्वं धर्मराजस्य तूर्णं\nयाचध्वं वै पाण्डवं लोकवीरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2037666, "chapter_id": 1812, "verse_number": "५-५७-६१", "content_sanskrit": "नैतादृशो हि योधोऽस्ति पृथिव्यामिह कश्चन।\nयथाविधः सव्यसाची पाण्डवः सत्यविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2037667, "chapter_id": 1812, "verse_number": "५-५७-६२", "content_sanskrit": "देवैर्हि संभृतो दिव्यो रथो गाण्डीवधन्वनः ।\nन सजेयोमनुष्येण मा स्म कृद्ध्वं मनो युधि ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2037668, "chapter_id": 1812, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि यानसन्धिपर्वणि सप्तपञ्चाशत्तमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]