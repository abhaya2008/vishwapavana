[{"id": 900003367, "chapter_id": 8284, "verse_number": "18.1", "content_sanskrit": "सन्न्यासस्य महाबाहो तत्त्वमिच्छामि वेदितुम् । त्यागस्य च हृषीकेश पृथक् केशिनिषूदन ।। १ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900003368, "chapter_id": 8284, "verse_number": "18.2", "content_sanskrit": "काम्यानां कर्मणां न्यासं सन्न्यासं कवयो विदुः । सर्वकर्मफलत्यागं प्राहुस्त्यागं विचक्षणाः ।। २ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900003369, "chapter_id": 8284, "verse_number": "18.3", "content_sanskrit": "त्याज्यं दोषवदित्येके कर्म प्राहुर्मनीषिणः । यज्ञदानतपः कर्म न त्याज्यमिति चापरे ।। ३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900003370, "chapter_id": 8284, "verse_number": "18.4", "content_sanskrit": "निश्चयं शृणु मे तत्र त्यागे भरतसत्तम । त्यागो हि पुरुषव्याघ्र त्रिविधः सम्प्रकार्तितः ।। ४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900003371, "chapter_id": 8284, "verse_number": "18.5", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900003372, "chapter_id": 8284, "verse_number": "18.6", "content_sanskrit": "यज्ञदानतपःकर्म न त्याज्यं कार्यमेव तत् । यज्ञो दानं तपश्चैैव पावनानि मनीषिणाम् ।। ५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900003373, "chapter_id": 8284, "verse_number": "18.7", "content_sanskrit": "एतान्यपि तु कर्माणि सङ्गं त्यक्त्वा फलानि च । कर्तव्यानीति मे पार्थ निश्चितं मतमुत्तमम् ।। ६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900003374, "chapter_id": 8284, "verse_number": "18.8", "content_sanskrit": "नियतस्य तु सन्न्यासः कर्मणो नोपपद्यते । मोहात् तस्य परित्यागस्तामसः परिकीर्तितः ।। ७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900003375, "chapter_id": 8284, "verse_number": "18.9", "content_sanskrit": "दुःखमित्येव यत् कर्म कायक्लेशभयात् त्यजेत् । स कृत्वा राजसं त्यागं नैव त्यागफलं लभेत् ।। ८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900003376, "chapter_id": 8284, "verse_number": "18.10", "content_sanskrit": "कार्यमित्येव यत् कर्म नियतं क्रियतेऽर्जुन । सङ्गं त्यक्त्वा फलं चैव स त्यागः सात्त्विको मतः ।। ९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900003377, "chapter_id": 8284, "verse_number": "18.11", "content_sanskrit": "न द्वेष्ट्यकुशलं कर्म कुशले नानुषज्जते । त्यागी सत्त्वसमाविष्टो मेधावी छिन्नसंशयः ।। १० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900003378, "chapter_id": 8284, "verse_number": "18.12", "content_sanskrit": "न हि देहभृता शक्यं त्यक्तुं कर्माण्यशेषतः । यस्तु कर्मफलत्यागी स त्यागीत्यभिधीयते ।। ११ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900003379, "chapter_id": 8284, "verse_number": "18.13", "content_sanskrit": "अनिष्टमिष्टं मिश्रं च त्रिविधं कर्मणः फलम् । भवत्यत्यागिनां प्रेत्य न तु सन्न्यासिनां क्वचित् ।। १२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900003380, "chapter_id": 8284, "verse_number": "18.14", "content_sanskrit": "पञ्चैतानि महाबाहो कारणानि निबोध मे । साङ्ख्ये कृतान्ते प्रोक्तानि सिद्धये सर्वकर्मणाम् ।। १३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900003381, "chapter_id": 8284, "verse_number": "18.15", "content_sanskrit": "अधिष्ठानं तथा कर्ता करणं च पृथग्विधम् । विविधाश्च पृथक् चेष्टा दैवं चैवात्र पञ्चमम् ।। १४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900003382, "chapter_id": 8284, "verse_number": "18.16", "content_sanskrit": "शरीरवाङ्मनोभिर्यत् कर्म प्रारभते नरः । न्याय्यं वा विपरीतं वा पञ्चैते तस्य हेतवः ।। १५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900003383, "chapter_id": 8284, "verse_number": "18.17", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900003384, "chapter_id": 8284, "verse_number": "18.18", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900003385, "chapter_id": 8284, "verse_number": "18.19", "content_sanskrit": "तत्रैवं सति कर्तारमात्मानं केवलं तु यः । पश्यत्यकृतबुद्धित्वान्न स पश्यति दुर्मतिः ।। १६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900003386, "chapter_id": 8284, "verse_number": "18.20", "content_sanskrit": "यस्य नाहङ्कृतो भावो बुद्धिर्यस्य न लिप्यते । हत्वाऽपि स इमांल्लोकान्न हन्ति न निबद्ध्यते ।। १७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900003387, "chapter_id": 8284, "verse_number": "18.21", "content_sanskrit": "ज्ञानं ज्ञेयं परिज्ञाता त्रिविधा कर्मचोदना । करणं कर्म कर्तेति त्रिविधः कर्मसङ्ग्रहः ।। १८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900003388, "chapter_id": 8284, "verse_number": "18.22", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900003389, "chapter_id": 8284, "verse_number": "18.23", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900003390, "chapter_id": 8284, "verse_number": "18.24", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900003391, "chapter_id": 8284, "verse_number": "18.25", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900003392, "chapter_id": 8284, "verse_number": "18.26", "content_sanskrit": "ज्ञानं कर्म च कर्ता च त्रिधैव गुणभेदतः । प्रोच्यते गुणसङ्ख्याने यथावच्छ्रुणु तान्यपि ।। १९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900003393, "chapter_id": 8284, "verse_number": "18.27", "content_sanskrit": "सर्वभूतेषु येनैकं भावमव्ययमीक्षते । अविभक्तं विभक्तेषु तज्ज्ञानं विद्धि सात्त्विकम् ।। २० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900003394, "chapter_id": 8284, "verse_number": "18.28", "content_sanskrit": "पृथक्त्वेन तु यज्ज्ञानं नानाभावान् पृथग्विधान् । वेत्ति सर्वेषु भूतेषु तज्ज्ञानं विद्धि राजसम् ।। २१ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900003395, "chapter_id": 8284, "verse_number": "18.29", "content_sanskrit": "यत् तु कृत्स्नवदेकस्मिन् कार्ये सक्तमहैतुकम् । अतत्त्वार्थवदल्पं च तत् तामसमुदाहृतम् ।। २२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900003396, "chapter_id": 8284, "verse_number": "18.30", "content_sanskrit": "नियतं सङ्गरहितमरागद्वेषतः कृतम् । अफलप्रेप्सुना कर्म यत् तत् सात्त्विकमुच्यते ।। २३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900003397, "chapter_id": 8284, "verse_number": "18.31", "content_sanskrit": "यत् तु कामेप्सुना कर्म साहङ्कारेण वा पुनः । क्रियते बहुलायासं तद्राजसमुदाहृतम् ।। २४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900003398, "chapter_id": 8284, "verse_number": "18.32", "content_sanskrit": "अनुबन्धं क्षयं हिंसामनपेक्ष्य च पौरुषम् । मोहादारभ्यते कर्म यत् तत् तामसमुच्यते ।। २५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900003399, "chapter_id": 8284, "verse_number": "18.33", "content_sanskrit": "मुक्तसङ्गोऽनहंवादी धृत्युत्साहसमन्वितः । सिद्ध्यसिद्ध्योर्निर्विकारः कर्ता सात्त्विक उच्यते ।। २६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900003400, "chapter_id": 8284, "verse_number": "18.34", "content_sanskrit": "रागी कर्मफलप्रेप्सुर्लुब्धो हिंसात्मकोऽशुचिः । हर्षशोकान्वितः कर्ता राजसः परिकार्तितः ।। २७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900003401, "chapter_id": 8284, "verse_number": "18.35", "content_sanskrit": "अयुक्तः प्राकृतः स्तब्धः शठो नैष्कृतिकोऽलसः । विषादी दीर्घसूत्री च कर्ता तामस उच्यते ।। २८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 900003402, "chapter_id": 8284, "verse_number": "18.36", "content_sanskrit": "बुद्धेर्भेदं धृतेश्चैव गुणतस्त्रिविधं शृणु । प्रोच्यमानमशेषेण पृथक्त्वेेन धनञ्जय ।। २९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 900003403, "chapter_id": 8284, "verse_number": "18.37", "content_sanskrit": "प्रवृत्तिं च निवृत्तिं च कार्याकार्ये भयाभये । बन्धं मोक्षं च या वेत्ति बुद्धिः सा पार्थ सात्त्विकी ।। ३० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 900003404, "chapter_id": 8284, "verse_number": "18.38", "content_sanskrit": "यया धर्ममधर्मं च कार्यं चाकार्यमेव च । अयथावत्प्रजानाति बुद्धिः सा पार्थ राजसी ।। ३१ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 900003405, "chapter_id": 8284, "verse_number": "18.39", "content_sanskrit": "अधर्मं धर्ममिति या मन्यते तमसाऽऽवृता । सर्वार्थान् विपरीतांश्च बुद्धिः सा पार्थ तामसी ।। ३२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 900003406, "chapter_id": 8284, "verse_number": "18.40", "content_sanskrit": "धृत्या यया धारयते मनःप्राणेन्द्रियक्रियाः । योगेनाव्यभिचारिण्या धृतिः सा पार्थ सात्त्विकी ।। ३३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 900003407, "chapter_id": 8284, "verse_number": "18.41", "content_sanskrit": "यया तु धर्मकामार्थान् धृत्या धारयतेऽर्जुन । प्रसङ्गेन फलाकाङ्क्षी धृतिः सा पार्थ राजसी ।। ३४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 900003408, "chapter_id": 8284, "verse_number": "18.42", "content_sanskrit": "यया स्वप्नं भयं शोकं विषादं मदमेव च । न विमुञ्चति दुर्मेधा धृतिः सा पार्थ तामसी ।। ३५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 900003409, "chapter_id": 8284, "verse_number": "18.43", "content_sanskrit": "सुखं त्विदानीं त्रिविधं शृणु मे भरतर्षभ । अभ्यासाद्रमते यत्र दुःखान्तं च निगच्छति ।। ३६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 900003410, "chapter_id": 8284, "verse_number": "18.44", "content_sanskrit": "यत्तदग्रे विषमिव परिणामेऽमृतोपमम् । तत् सुखं सात्त्विकं प्रोक्तमात्मबुद्धिप्रसादजम् ।। ३७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 900003411, "chapter_id": 8284, "verse_number": "18.45", "content_sanskrit": "विषयेन्द्रियसंयोगाद्यत् तदग्रेऽमृतोपमम् । परिणामे विषमिव तत्सुखं राजसं स्मृतम् ।। ३८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 900003412, "chapter_id": 8284, "verse_number": "18.46", "content_sanskrit": "यदग्रे चानुबन्धे च सुखं मोहनमात्मनः । निद्रालस्यप्रमादोत्थं तत्तामसमुदाहृतम् ।। ३९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 900003413, "chapter_id": 8284, "verse_number": "18.47", "content_sanskrit": "न तदस्ति पृथिव्यां वा दिवि देवेषु वा पुनः । सत्त्वं प्रकृतिजैर्मुक्तं यदेभिः स्यात् त्रिभिर्गुणैः ।। ४० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 900003414, "chapter_id": 8284, "verse_number": "18.48", "content_sanskrit": "ब्राह्मणक्षत्रियविशां शूद्राणां च परन्तप । कर्माणि प्रविभक्तानि स्वभावप्रभवैर्गुणैः ।। ४१ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 900003415, "chapter_id": 8284, "verse_number": "18.49", "content_sanskrit": "शमो दमस्तपः शौचं क्षान्तिरार्जवमेव च । ज्ञानं विज्ञानमास्तिक्यं ब्राह्मं कर्म स्वभावजम् ।। ४२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 900003416, "chapter_id": 8284, "verse_number": "18.50", "content_sanskrit": "शौर्यं तेजो धृतिर्दाक्ष्यं युद्धे चाप्यपलायनम् । दानमीश्वरभावश्च क्षात्रं कर्म स्वभावजम् ।। ४३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 900003417, "chapter_id": 8284, "verse_number": "18.51", "content_sanskrit": "कृषिगौरक्ष्यवाणिज्यं वैश्यं कर्म स्वभावजम् । परिचर्यात्मकं कर्म शूद्रस्यापि स्वभावजम् ।। ४४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 900003418, "chapter_id": 8284, "verse_number": "18.52", "content_sanskrit": "स्वे स्वे कर्मण्यभिरतः संसिद्धिं लभते नरः । स्वकर्मनिरतः सिद्धिं यथा विन्दति तच्छ्रृणु ।। ४५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 900003419, "chapter_id": 8284, "verse_number": "18.53", "content_sanskrit": "यतः प्रवृत्तिर्भूतानां येन सर्वमिदं ततम् । स्वकर्मणा तमभ्यर्च्य सिद्धिं विन्दति मानवः ।। ४६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 900003420, "chapter_id": 8284, "verse_number": "18.54", "content_sanskrit": "श्रेयान् स्वधर्मो विगुणः परधर्मात् स्वनुष्ठितात् । स्वभावनियतं कर्म कुर्वन्नाप्नोति किल्बिषम् ।। ४७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 900003421, "chapter_id": 8284, "verse_number": "18.55", "content_sanskrit": "सहजं कर्म कौन्तेय सदोषमपि न त्यजेत् । सर्वारम्भा हि दोषेण धूमेनाग्निरिवावृताः ।। ४८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 900003422, "chapter_id": 8284, "verse_number": "18.56", "content_sanskrit": "असक्तबुद्धिः सर्वत्र जितात्मा विगतस्पृहः । नैष्कर्म्यसिद्धिं परमां सन्न्यासेनाधिगच्छति ।। ४९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 900003423, "chapter_id": 8284, "verse_number": "18.57", "content_sanskrit": "सिद्धिं प्राप्तो यथा ब्रह्म तथाऽऽप्नोति निबोध मे । समासेनैव कौन्तेय निष्ठा ज्ञानस्य या परा ।। ५० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 900003424, "chapter_id": 8284, "verse_number": "18.58", "content_sanskrit": "बुध्या विशुद्धया युक्तो धृत्याऽऽत्मानं नियम्य च । शब्दादीन् विषयांस्त्यक्त्वा रागद्वेषौ व्युदस्य च ।। ५१ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 900003425, "chapter_id": 8284, "verse_number": "18.59", "content_sanskrit": "विविक्तसेवी लघ्वाशी यतवाक्कायमानसः । ध्यानयोगपरो नित्यं वैराग्यं समुपाश्रितः ।। ५२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 900003426, "chapter_id": 8284, "verse_number": "18.60", "content_sanskrit": "अहङ्कारं बलं दर्पं कामं क्रोधं परिग्रहम् । विमुच्य निर्ममः शान्तो ब्रह्मभूयाय कल्पते ।। ५३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 900003427, "chapter_id": 8284, "verse_number": "18.61", "content_sanskrit": "ब्रह्मभूतः प्रसन्नात्मा न शोचति न काङ्क्षति । समः सर्वेषु भूतेषु मद्भक्तिं लभते पराम् ।। ५४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 900003428, "chapter_id": 8284, "verse_number": "18.62", "content_sanskrit": "भक्त्या मामभिजानाति यावान् यश्चास्मि तत्त्वतः । ततो मां तत्त्वतो ज्ञात्वा विशते तदनन्तरम् ।। ५५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 900003429, "chapter_id": 8284, "verse_number": "18.63", "content_sanskrit": "सर्वकर्माण्यपि सदा कुर्वाणो मद्व्यपाश्रयः । मत्प्रसादादवाप्नोति शाश्वतं पदमव्ययम् ।। ५६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 900003430, "chapter_id": 8284, "verse_number": "18.64", "content_sanskrit": "चेतसा सर्वकर्माणि मयि सन्न्यस्य मत्परः । बुद्धियोगमुपाश्रित्य मच्चित्तः सततं भव ।। ५७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 900003431, "chapter_id": 8284, "verse_number": "18.65", "content_sanskrit": "मच्चित्तः सर्वदुर्गाणि मत्प्रसादात्तरिष्यसि । अथ चेत् त्वमहङ्कारान्न श्रोष्यसि विनङ्क्षयसि ।। ५८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 900003432, "chapter_id": 8284, "verse_number": "18.66", "content_sanskrit": "यदहङ्कारमाश्रित्य न योत्स्य इति मन्यसे । मिथ्यैष व्यवसायस्ते प्रकृतिस्त्वां नियोक्ष्यति ।। ५९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 900003433, "chapter_id": 8284, "verse_number": "18.67", "content_sanskrit": "स्वभावजेन कौन्तेय निबद्धः स्वेन कर्मणा । कर्तुं नेच्छसि यन्मोहात् करिष्यस्यवशोऽपि तत् ।। ६० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 900003434, "chapter_id": 8284, "verse_number": "18.68", "content_sanskrit": "ईश्वरः सर्वभूतानां हृद्देशेऽर्जुन तिष्ठति । भ्रामयन् सर्वभूतानि यन्त्रारूढानि मायया ।। ६१ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 900003435, "chapter_id": 8284, "verse_number": "18.69", "content_sanskrit": "तमेव शरणं गच्छ सर्वभावेन भारत । तत्प्रसादात् परां शान्तिं स्थानं प्राप्स्यसि शाश्वतम् ।। ६२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 900003436, "chapter_id": 8284, "verse_number": "18.70", "content_sanskrit": "इति ते ज्ञानमाख्यातं गुह्याद् गुह्यतरं मया । विमृश्यैतदशेषेण यथेच्छसि तथा कुरु ।। ६३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 900003437, "chapter_id": 8284, "verse_number": "18.71", "content_sanskrit": "सर्वगुह्यतमं भूयः शृणु मे परमं वचः । इष्टोऽसि मे दृढमिति ततो वक्ष्यामि ते हितम् ।। ६४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 900003438, "chapter_id": 8284, "verse_number": "18.72", "content_sanskrit": "मन्मना भव मद्भक्तो मद्याजी मां नमस्कुरु । मामेवैष्यसि सत्यं ते प्रतिजाने प्रियोऽसि मे ।। ६५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 900003439, "chapter_id": 8284, "verse_number": "18.73", "content_sanskrit": "सर्वधर्मान् परित्यज्य मामेकं शरणं व्रज । अहं त्वा सर्वपापेभ्यो मोक्षयिष्यामि मा शुचः ।। ६६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 900003440, "chapter_id": 8284, "verse_number": "18.74", "content_sanskrit": "इदं ते नातपस्काय नाभक्ताय कदाचन । न चाशुश्रूषवे वाच्यं न च मां योऽभ्यसूयति ।। ६७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 900003441, "chapter_id": 8284, "verse_number": "18.75", "content_sanskrit": "य इमं परमं गुह्यं मद्भक्तेष्वभिधास्यति । भक्तिं मयि परां कृत्वा मामेवैष्यत्यसंशयः ।। ६८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 900003442, "chapter_id": 8284, "verse_number": "18.76", "content_sanskrit": "न च तस्मान्मनुष्येषु कश्चिन्मे प्रियकृत्तमः । भविता नच मे तस्मादन्यः प्रियतरो भुवि ।। ६९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 900003443, "chapter_id": 8284, "verse_number": "18.77", "content_sanskrit": "अध्येष्यते च य इमं धर्म्यं संवादमावयोः । ज्ञानयज्ञेन तेनाहमिष्टः स्यामिति मे मतिः ।। ७० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 900003444, "chapter_id": 8284, "verse_number": "18.78", "content_sanskrit": "श्रद्धवाननसूयश्च शृणुयादपि यो नरः । सोऽपि मुक्तः शुभांल्लोकान् प्राप्नुयात् पुण्यकर्मणाम् ।।७१।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 900003445, "chapter_id": 8284, "verse_number": "18.79", "content_sanskrit": "कच्चिदेतच्छ्रुतं पार्थ त्वयैकाग्रेण चेतसा । कच्चिदज्ञानसम्मोहः प्रनष्टस्ते धनञ्जय ।। ७२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 900003446, "chapter_id": 8284, "verse_number": "18.80", "content_sanskrit": "नष्टो मोहः स्मृतिर्लब्धा त्वत्प्रसादान्मयाऽच्युत । स्थितोऽस्मि गतसन्देहः करिष्ये वचनं तव ।। ७३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 900003447, "chapter_id": 8284, "verse_number": "18.81", "content_sanskrit": "इत्यहं वासुदेवस्य पार्थस्य च महात्मनः । संवादमिममश्रौषमद्भुतं रोमहर्षणम् ।। ७४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 900003448, "chapter_id": 8284, "verse_number": "18.82", "content_sanskrit": "व्यासप्रसादाच्छ्रुतवान् एतद्गुह्यमहं परम् । योगं योगेश्वरात् कृष्णात् साक्षात् कथयतः स्वयम् ।।७५।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 900003449, "chapter_id": 8284, "verse_number": "18.83", "content_sanskrit": "राजन् संस्मृत्य संस्मृत्य संवादमिममद्भुतम् । केशवार्जुनयोः पुण्यं हृष्यामि च मुहुर्मुहुः ।। ७६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 900003450, "chapter_id": 8284, "verse_number": "18.84", "content_sanskrit": "तच्च संस्मृत्य संस्मृत्य रूपमत्यद्भुतं हरेः । विस्मयो मे महान् राजन् हृष्यामि च पुनः पुनः ।। ७७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 900003451, "chapter_id": 8284, "verse_number": "18.85", "content_sanskrit": "यत्र योगेश्वरः कृष्णो यत्र पार्थो धनुर्धरः । तत्र श्रीर्विजयो भूतिर्ध्रुवा नीतिर्मति मम ।। ७८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]