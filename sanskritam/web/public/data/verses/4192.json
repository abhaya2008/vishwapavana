[{"id": 2147535, "chapter_id": 4192, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2147536, "chapter_id": 4192, "verse_number": "१", "content_sanskrit": "भगवन्नेवमेवैतद् यथा वदसि नारद ।\nइच्छामि चाहमप्येवं न त्वीशो भगवन्नहम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2147537, "chapter_id": 4192, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2147538, "chapter_id": 4192, "verse_number": "२", "content_sanskrit": "एवमुक्त्वा ततः कृष्णमभ्यभाषत भारत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2147539, "chapter_id": 4192, "verse_number": "३", "content_sanskrit": "स्वर्ग्यं लोक्यं च मामात्थ धर्म्यं न्याय्यं च माधव ।\nन त्वहं स्ववशस्तात क्रियमाणं न मे प्रियम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2147540, "chapter_id": 4192, "verse_number": "४", "content_sanskrit": "न मंस्यते दुरात्मानः पुत्रा मम जनार्दन\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2147541, "chapter_id": 4192, "verse_number": "५", "content_sanskrit": "अङ्ग दुर्योधनं कृष्ण मन्दं शास्त्रातिगं मम ।\nअनुनेतुं महाबाहो यतस्व पुरुषोत्तम\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2147542, "chapter_id": 4192, "verse_number": "६", "content_sanskrit": "न शृणोति महाबाहो वचनं साधुभाषितम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2147543, "chapter_id": 4192, "verse_number": "७", "content_sanskrit": "गान्धार्याश्च हृषीकेश विदुरस्य च धीमतः ।\nअन्येषां चैव सुहृदां भीष्मादीनां हितैषिणाम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2147544, "chapter_id": 4192, "verse_number": "८", "content_sanskrit": "स त्वं पापमतिं क्रूरं पापचित्तमचेतनम् ।\nअनुशाधि दुरात्मानं स्वयं दुर्योधनं नृपम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2147545, "chapter_id": 4192, "verse_number": "९", "content_sanskrit": "सुहृत्कार्यं तु सुमहत् कृतं ते स्याज्जनार्दन\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2147546, "chapter_id": 4192, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2147547, "chapter_id": 4192, "verse_number": "१०", "content_sanskrit": "ततो व्यावृत्य वार्ष्णेयो दुर्योधनममर्षणम् ।\nअब्रवीन्मधुरां वाचं सूक्ष्मधर्मार्थतत्त्ववित्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2147548, "chapter_id": 4192, "verse_number": "११", "content_sanskrit": "दुर्योधन निबोधेदं मद्वाक्यं कुरुसत्तम ।\nसमर्थं ते विशेषेण सानुबन्धस्य भारत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2147549, "chapter_id": 4192, "verse_number": "१२", "content_sanskrit": "महाप्राज्ञकुले जातः साध्वेतत् कर्तुमर्हसि ।\nश्रुतवृत्तोपसम्पन्नः सर्वैः समुदितो गुणैः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2147550, "chapter_id": 4192, "verse_number": "१३", "content_sanskrit": "दौष्कुलेया दुरात्मानो नृशंसा निरपत्रपाः ।\nत एतदीदृशं कुर्युर्यथा त्वं तात वर्तसे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2147551, "chapter_id": 4192, "verse_number": "१४", "content_sanskrit": "धर्मार्थयुक्ता लोकेऽस्मिन् प्रवृत्तिर्लक्ष्यते सताम् ।\nअसतां विपरीता तु लक्ष्यते भरतर्षभ\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2147552, "chapter_id": 4192, "verse_number": "१५", "content_sanskrit": "विपरीता त्वियं वृत्तिरसकृल्लक्ष्यते त्वयि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2147553, "chapter_id": 4192, "verse_number": "१६", "content_sanskrit": "अनर्थश्चानुबन्धोऽत्र घोरः प्राणहरो महान् ।\nअनेकशस्त्वन्निमित्तमयशस्यं च भारत\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2147554, "chapter_id": 4192, "verse_number": "१७", "content_sanskrit": "तमनर्थं परिहरन्नात्मश्रेयः करिष्यसि ।\nभ्रातॄणामथ भृत्यानां मित्राणां च परन्तप\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2147555, "chapter_id": 4192, "verse_number": "१८", "content_sanskrit": "अधर्म्यादयशस्याच्च कर्मणस्त्वं प्रमोक्ष्यसे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2147556, "chapter_id": 4192, "verse_number": "१९", "content_sanskrit": "प्राज्ञैः शूरैर्महोत्साहैरात्मविद्भिर्बहुश्रुतैः ।\nसन्धत्स्व पुरुषव्याघ्र पाण्डवैर्भरतर्षभ\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2147557, "chapter_id": 4192, "verse_number": "२०", "content_sanskrit": "तद्धितं च प्रियं चैव धृतराष्ट्रस्य धीमतः ।\nपितामहस्य द्रोणस्य विदुरस्य महामतेः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2147558, "chapter_id": 4192, "verse_number": "२१", "content_sanskrit": "कृपस्य सोमदत्तस्य बाह्लीकस्य च धीमतः ।\nअश्वत्थाम्नो विकर्णस्य सञ्जयस्य विविंशतेः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2147559, "chapter_id": 4192, "verse_number": "२२", "content_sanskrit": "ज्ञातीनां चैव भूयिष्ठं मित्राणां च परन्तप ।\nशमे शर्म भवेत् तात सर्वस्य जगतस्तथा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2147560, "chapter_id": 4192, "verse_number": "२३", "content_sanskrit": "ह्रीमानसि कुले जातः श्रुतवानानृशंस्यवान् ।\nतिष्ठ तात पितुः शास्त्रे मातुश्च भरतर्षभ\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2147561, "chapter_id": 4192, "verse_number": "२४", "content_sanskrit": "एतच्छ्रेयो हि तन्मन्ये पिता यच्छास्ति भारत ।\nउक्तमापद्गतः पूर्वं पितुः स्मरसि शासनम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2147562, "chapter_id": 4192, "verse_number": "२५", "content_sanskrit": "रोचते ते पितुस्तात पाण्डवैः सह सङ्गमः ।\nसामात्यस्य कुरुश्रेष्ठ तत् तुभ्यं तात रोचताम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2147563, "chapter_id": 4192, "verse_number": "२६", "content_sanskrit": "श्रुत्वा यः सुहृदां शास्त्रं मर्त्यो न प्रतिपद्यते ।\nविपाकान्ते दहत्येनं किम्पाकमिव भक्षितम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2147564, "chapter_id": 4192, "verse_number": "२७", "content_sanskrit": "यस्तु निश्रेयसं वाक्यं मोहान्न प्रतिपद्यते ।\nस दीर्घसूत्रो हीनार्थः पश्चात् तापेन युज्यते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2147565, "chapter_id": 4192, "verse_number": "२८", "content_sanskrit": "यस्तु निश्रेयसं श्रुत्वाऽपापमेवाभिपद्यते ।\nआत्मनो मतमुत्सृज्य स लोके सुखमेधते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2147566, "chapter_id": 4192, "verse_number": "२९", "content_sanskrit": "योऽर्थकामस्य वचनं प्रातिकूल्यान्न मृष्यते ।\nशृणोति प्रतिकूलानि द्विषतां वशमेति सः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2147567, "chapter_id": 4192, "verse_number": "३०", "content_sanskrit": "सतां मतमतिक्रम्य योऽसतां वर्तते मते ।\nशोचन्ते व्यसने तस्य सुहृदो नचिरादिव\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2147568, "chapter_id": 4192, "verse_number": "३१", "content_sanskrit": "मुख्यानमात्यानुत्सृज्य यो निहीनान् निषेवते ।\nस घोरामापदं प्राप्य नोत्तारमधिगच्छति\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2147569, "chapter_id": 4192, "verse_number": "३२", "content_sanskrit": "योऽसत्सेवी वृथाचारो नश्रोता सुहृदां सताम् ।\nपरान् वृणीते स्वान् द्वेष्टि तं गौस्त्यजति भारत\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2147570, "chapter_id": 4192, "verse_number": "३३", "content_sanskrit": "स त्वं विरुद्ध्य तैर्वीरैरन्येभ्यस्त्राणमिच्छसि ।\nअशिष्टेभ्योऽसमर्थेभ्यो मूढेभ्यो भरतर्षभ\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2147571, "chapter_id": 4192, "verse_number": "३४", "content_sanskrit": "को हि शक्रसमान् ज्ञातीनतिक्रम्य महारथान् ।\nअन्येभ्यस्त्राणमाशंसेत् त्वदन्यो भुवि मानवः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2147572, "chapter_id": 4192, "verse_number": "३५", "content_sanskrit": "जन्मप्रभृति कौन्तेया नित्यं विनिकृतास्त्वया ।\nन च ते जातु कुप्यन्ति धर्मात्मानो हि पाण्डवाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2147573, "chapter_id": 4192, "verse_number": "३६", "content_sanskrit": "मिथ्योपचरितास्तात जन्मप्रभृति पाण्डवाः ।\nत्वयि सम्यङ् महाबाहो प्रतिपन्ना यशस्विनः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2147574, "chapter_id": 4192, "verse_number": "३७", "content_sanskrit": "त्वयाऽपि प्रतिपत्तव्यं तथैव भरतर्षभ ।\nस्वेषु बन्धुषु मुख्येषु मा मन्युवशमन्वगाः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2147575, "chapter_id": 4192, "verse_number": "३८", "content_sanskrit": "त्रिवर्गयुक्तः प्राज्ञानामारम्भो भरतर्षभ ।\nधर्मार्थावनुरुद्ध्यन्ते त्रिवर्गासम्भवे नराः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2147576, "chapter_id": 4192, "verse_number": "३९", "content_sanskrit": "पृथक् च विनिविष्टानां धर्मं धीरोऽनुरुद्ध्यते ।\nमध्यमोऽर्थं कलिं बालः काममेवानुरुद्ध्यते\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2147577, "chapter_id": 4192, "verse_number": "४०", "content_sanskrit": "इन्द्रियैः प्रसृतो बालः धर्मं विप्रजहाति यः ।\nकामार्थावनुपायेन लिप्समानो विनश्यति\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2147578, "chapter_id": 4192, "verse_number": "४१", "content_sanskrit": "कामार्थौ लिप्समानस्तु धर्ममेवादितश्चरेत् ।\nन हि धर्मादपैत्यर्थः कामो वाऽपि कदाचन\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2147579, "chapter_id": 4192, "verse_number": "४२", "content_sanskrit": "उपायं धर्ममेवाहुः त्रिवर्गस्य विशाम्पते ।\nलिप्समानो हि तेनाशु कक्षेऽग्निरिव वर्धते\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2147580, "chapter_id": 4192, "verse_number": "४३", "content_sanskrit": "स त्वं तातानुपायेन लिप्ससे भरतर्षभ ।\nआधिराज्यं महद् दीप्तं प्रथितं सर्वराजसु\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2147581, "chapter_id": 4192, "verse_number": "४४", "content_sanskrit": "आत्मानं तक्षति ह्येष वनं परशुना यथा ।\nयः सम्यग् वर्तमानेषु मिथ्या राजन् प्रवर्तते\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2147582, "chapter_id": 4192, "verse_number": "४५", "content_sanskrit": "अमित्रो नातिकर्तव्यः नातिदेयः कदाचन ।\nजीवितं ह्यपि दुःखार्ताः सन्त्यजन्ति कदाचन\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2147583, "chapter_id": 4192, "verse_number": "४६", "content_sanskrit": "स सम्पन्नमभिच्छिन्द्यात् यस्य नेच्छेत् पराभवम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2147584, "chapter_id": 4192, "verse_number": "४७", "content_sanskrit": "अभिच्छिन्नस्य धीरस्य कल्याणे धीयते मतिः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2147585, "chapter_id": 4192, "verse_number": "४८", "content_sanskrit": "त्यक्तात्मानं न बाधेत त्रिषु लोकेषु भारत ।\nअप्यन्यं प्राकृतं कञ्चित् किमु तान् पाण्डवर्षभान्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2147586, "chapter_id": 4192, "verse_number": "४९", "content_sanskrit": "अमर्षवशमापन्नो न किञ्चिद् बुद्ध्यते नरः ।\nभिद्यते ह्याततं सर्वं प्रमाणं पश्य भारत\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2147587, "chapter_id": 4192, "verse_number": "५०", "content_sanskrit": "श्रेयस्ते दुर्जनात् तात पाण्डवैः सह सङ्गतम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2147588, "chapter_id": 4192, "verse_number": "५१", "content_sanskrit": "तैर्हि सम्प्रीयमाणस्त्वं परान् कामानवाप्स्यसि ।\nपाण्डवैर्निर्जितां भूमिं भुञ्जानो राजसत्तम\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2147589, "chapter_id": 4192, "verse_number": "५२", "content_sanskrit": "पाण्डवान् पृष्ठतः कृत्वा त्राणमाशंससेऽन्यतः ।\nदुःशासने दुर्विषहे कर्णेऽथापि च सौबले\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2147590, "chapter_id": 4192, "verse_number": "५३", "content_sanskrit": "एतेष्वैश्वर्यमाधाय भूतिमिच्छसि भारत ।\nन चैते तव पर्याप्ता ज्ञाने धर्मार्थयोस्तथा\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2147591, "chapter_id": 4192, "verse_number": "५४", "content_sanskrit": "विक्रमे चाप्यपर्याप्ताः पाण्डवान् प्रति भारत ।\nन हीमे सर्वराजानः पर्याप्ताः सहितास्त्वया\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2147592, "chapter_id": 4192, "verse_number": "५५", "content_sanskrit": "क्रुद्धस्य भीमसेनस्य प्रेक्षितुं मुखमाहवे ।\nइदं सन्निहितं तात समग्रं पार्थिवं बलम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2147593, "chapter_id": 4192, "verse_number": "५६", "content_sanskrit": "अयं भीष्मस्तथा द्रोणः कर्णश्चापि तथा कृपः ।\nभूरिश्रवाः सौमदत्तिरश्वत्थामा जयद्रथः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2147594, "chapter_id": 4192, "verse_number": "५७", "content_sanskrit": "अशक्ताः सर्व एवैते प्रतियोद्धुं धनञ्जयम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2147595, "chapter_id": 4192, "verse_number": "५८", "content_sanskrit": "अजेयो ह्यर्जुनः क्रुद्धः सर्वैरपि सुरासुरैः ।\nमानुषैरपि गन्धर्वैर्मा युद्धे चेत आदधाः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2147596, "chapter_id": 4192, "verse_number": "५९", "content_sanskrit": "दृश्यतां वा पुमान् कश्चित् समग्रे पार्थिवे बले ।\nयोऽर्जुनं समरे प्राप्य स्वस्तिमानाव्रजेद् गृहान्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2147597, "chapter_id": 4192, "verse_number": "६०", "content_sanskrit": "किं ते जनक्षयेणेह कृतेन भरतर्षभ ।\nयस्मिन् जिते जितं ते स्यात् पुमानेकः स दृश्यताम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2147598, "chapter_id": 4192, "verse_number": "६१", "content_sanskrit": "यः स देवान् सगन्धर्वान् सयक्षासुरपन्नगान् ।\nअजयत् खाण्डवप्रस्थे कस्तं युद्ध्येत मानवः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2147599, "chapter_id": 4192, "verse_number": "६२", "content_sanskrit": "तथा विराटनगरे श्रूयते महदद्भुतम् ।\nएकस्य च बहूनां च पर्याप्तं तन्निदर्शनम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2147600, "chapter_id": 4192, "verse_number": "६३", "content_sanskrit": "तमजेयमनाधृष्यं विजेतुं जिष्णुमच्युतम् ।\nआशंससीह समरे वीरमर्जुनमूर्जितम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2147601, "chapter_id": 4192, "verse_number": "६४", "content_sanskrit": "मद्द्वितीयं पुनः पार्थं कः प्रापयितुमर्हति ।\nयुद्धे प्रतीयमानं तमपि साक्षात् पुरन्दरः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2147602, "chapter_id": 4192, "verse_number": "६५", "content_sanskrit": "बाहुभ्यामुद्धरेद् भूमिं दहेत् क्रुद्ध इमाः प्रजाः ।\nपातयेत् त्रिविधान् देवान् योऽर्जुनं समरे जयेत्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2147603, "chapter_id": 4192, "verse_number": "६६", "content_sanskrit": "पश्य पुत्रांस्तथा भ्रातॄन् ज्ञातीन् सम्बन्धिबान्धवान् ।\nत्वत्कृते न विनश्येयुरिमे भरतसत्तमाः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2147604, "chapter_id": 4192, "verse_number": "६७", "content_sanskrit": "अस्तु शेषं कौरवाणां मा पराभूदिदं कुलम् ।\nकुलघ्न इति नोच्येथा नष्टकीर्तिर्नराधिप\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2147605, "chapter_id": 4192, "verse_number": "६८", "content_sanskrit": "त्वामेव स्थापयिष्यन्ति यौवराज्ये महारथाः ।\nमहाराज्येऽपि पितरं धृतराष्ट्रं जनेश्वरम्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2147606, "chapter_id": 4192, "verse_number": "६९", "content_sanskrit": "मा तात श्रियमायान्तीमवमंस्थाः समुद्यताम् ।\nअर्धं प्रदाय पार्थेभ्यो महतीं श्रियमाप्स्यसि\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2147607, "chapter_id": 4192, "verse_number": "७०", "content_sanskrit": "पाण्डवैः संशमं कृत्वा कृत्वा च सुहृदां वचः ।\nसम्प्रीयमाणो मित्रैश्च चिरं भद्राण्यवाप्स्यसि\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2147608, "chapter_id": 4192, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि त्रयोविंशोत्तरशततमोऽध्यायः ॥१२३॥\nभगवद्यानपर्वणि चतुःपञ्चाशोऽध्यायः ॥५४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]