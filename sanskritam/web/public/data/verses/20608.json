[{"id": 7000608000, "chapter_id": 20608, "verse_number": "५-६७-१", "content_sanskrit": "शेष उवाच ।\nअथ सौमित्रिरागत्य जानकीं नतवान्मुहुः ।\nप्रेमगद्गदया शंसन्वाचं रामप्रणोदिताम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000608001, "chapter_id": 20608, "verse_number": "५-६७-२", "content_sanskrit": "सीता समागतं दृष्ट्वा लक्ष्मणं विनयान्वितम् ।\nतन्मुखाद्रामसंदेशं श्रुत्वोवाच विलज्जिता॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000608002, "chapter_id": 20608, "verse_number": "५-६७-३", "content_sanskrit": "सौमित्रे कथमागच्छे रामत्यक्ता महावने ।\nतिष्ठामि रामं स्मरन्ती वाल्मीकेराश्रमे त्वहम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000608003, "chapter_id": 20608, "verse_number": "५-६७-४", "content_sanskrit": "तस्या मुखोदितं वाक्यं श्रुत्वा सौमित्रिरब्रवीत् ।\nमातः पतिव्रते रामस्त्वामाकारयते मुहुः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000608004, "chapter_id": 20608, "verse_number": "५-६७-५", "content_sanskrit": "पतिव्रता पतिकृतं दोषं नानयते हृदि ।\nतस्मादागच्छ हि मया स्थित्वा स्यंदन उत्तमे॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000608005, "chapter_id": 20608, "verse_number": "५-६७-६", "content_sanskrit": "इत्यादि वचनं श्रुत्वा जानकी पतिदेवता ।\nमनोरोषं परित्यज्य तस्थौ सौमित्रिणा रथे॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000608006, "chapter_id": 20608, "verse_number": "५-६७-७", "content_sanskrit": "तापसीः सकला नत्वा मुनींश्च निगमोज्ज्वलान् ।\nरामं स्मरंती मनसा रथे स्थित्वागमत्पुरीम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000608007, "chapter_id": 20608, "verse_number": "५-६७-८", "content_sanskrit": "क्रमेण नगरीं प्राप्ता महार्हाभरणान्विता ।\nसरयूं सरितं प्राप यत्र रामः स्वयं स्थितः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000608008, "chapter_id": 20608, "verse_number": "५-६७-९", "content_sanskrit": "रथादुत्तीर्य ललिता लक्ष्मणेन समन्विता ।\nरामस्य पादयोर्लग्ना पतिव्रतपरायणा॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000608009, "chapter_id": 20608, "verse_number": "५-६७-१०", "content_sanskrit": "रामस्तामागतां दृष्ट्वा जानकीं प्रेमविह्वलाम् ।\nसाध्वि त्वया सहेदानीं कुर्वे यज्ञसमापनम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000608010, "chapter_id": 20608, "verse_number": "५-६७-११", "content_sanskrit": "वाल्मीकिं सा नमस्कृत्य तथान्यान्विप्रसत्तमान् ।\nजगाम मातृपदयोः सन्नतिं कर्तुमुत्सुका॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000608011, "chapter_id": 20608, "verse_number": "५-६७-१२", "content_sanskrit": "कौशल्या तामथायांतीं वीरसूं जानकीं प्रियाम् ।\nआशीर्भिरभिसंयुज्य ययौ हर्षमनेकधा॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000608012, "chapter_id": 20608, "verse_number": "५-६७-१३", "content_sanskrit": "कैकेयीपदयोर्नम्रां वीक्ष्य वैदेहपुत्रिकाम् ।\nभर्त्रा सह चिरं जीव सपुत्रेत्याशिषं व्यधात्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000608013, "chapter_id": 20608, "verse_number": "५-६७-१४", "content_sanskrit": "सुमित्रा स्वपदेनम्रां वीक्ष्य वैदेहपुत्रिकाम् ।\nआशिषं व्यदधात्तस्याः पुत्रपौत्रप्रदायिनीम्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000608014, "chapter_id": 20608, "verse_number": "५-६७-१५", "content_sanskrit": "सीता ताः सर्वतो नत्वा रामचंद्र प्रिया सती ।\nपरमं हर्षमापन्ना बभूव किल वाडव॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000608015, "chapter_id": 20608, "verse_number": "५-६७-१६", "content_sanskrit": "समागतां वीक्ष्य पत्नीं रामचंद्रस्य कुंभजः ।\nसुवर्णपत्नीं धिक्कृत्य तामधाद्धर्मचारिणीम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000608016, "chapter_id": 20608, "verse_number": "५-६७-१७", "content_sanskrit": "रामस्तदा यज्ञमध्ये शुशुभे सीतया सह ।\nतारयानुगतो यद्वच्छशीव शरदुत्प्रभः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000608017, "chapter_id": 20608, "verse_number": "५-६७-१८", "content_sanskrit": "प्रयोगमकरोत्तत्र काले प्राप्ते मनोरमे ।\nवैदेह्या धर्मचारिण्या सर्वपापापनोदनम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000608018, "chapter_id": 20608, "verse_number": "५-६७-१९", "content_sanskrit": "सीतया सहितं रामं प्रसक्तं यज्ञकर्मणि ।\nनिरीक्ष्य जहृषुस्तत्र कौतुकेन समन्विताः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000608019, "chapter_id": 20608, "verse_number": "५-६७-२०", "content_sanskrit": "वसिष्ठं प्राह सुमतिं रामस्तत्र क्रतौ वरे ।\nकिं कर्तव्यं मया स्वामिन्नतः परमवश्यकम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000608020, "chapter_id": 20608, "verse_number": "५-६७-२१", "content_sanskrit": "रामस्य वचनं श्रुत्वा गुरुः प्राह महामतिः ।\nब्राह्मणानां प्रकर्तव्या पूजा संतोषकारिका॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000608021, "chapter_id": 20608, "verse_number": "५-६७-२२", "content_sanskrit": "मरुत्तेन क्रतुः सृष्टः पूर्वं संभारसंभृतः ।\nब्राह्मणास्तत्र वित्ताद्यैस्तोषिता अभवंस्तदा॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000608022, "chapter_id": 20608, "verse_number": "५-६७-२३", "content_sanskrit": "अत्यंतं वित्तसंभारं नेतुं विप्राशकन्नहि ।\nप्राक्षिपन्हिमवद्देशे वित्तभारासहा द्विजाः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000608023, "chapter_id": 20608, "verse_number": "५-६७-२४", "content_sanskrit": "तस्मात्त्वमपि राजाग्र्य लक्ष्मीवान्नृपसत्तम ।\nदेहि दानादि विप्रेभ्यो यथा स्यात्प्रीतिरुत्तमा॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000608024, "chapter_id": 20608, "verse_number": "५-६७-२५", "content_sanskrit": "एतच्छ्रुत्वा स राजाग्र्यः पूज्यं मत्वा घटोद्भवम् ।\nप्रथमं पूजयामास ब्रह्मपुत्रं तपोधनम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000608025, "chapter_id": 20608, "verse_number": "५-६७-२६", "content_sanskrit": "अनेकरत्नसंभारैः स्वर्णभारैरनेकधा ।\nदेशैर्जनैः परिवृतैरत्यंतप्रीतिदायकैः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000608026, "chapter_id": 20608, "verse_number": "५-६७-२७", "content_sanskrit": "अगस्त्यं पूजयामास सपत्नीकं मनोरमम् ।\nतथैव रत्नैः स्वर्णैश्च देशैश्च विविधैरपि॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000608027, "chapter_id": 20608, "verse_number": "५-६७-२८", "content_sanskrit": "व्यासं सत्यवतीपुत्रं तथैव समपूजयत् ।\nच्यवनं भार्यया साकं सुरत्नैः समपूजयत्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000608028, "chapter_id": 20608, "verse_number": "५-६७-२९", "content_sanskrit": "अन्यानपि मुनीन्सर्वानृत्विजस्तपसां निधीन् ।\nपूजयामास रत्नौघैः स्वर्णभारैरनेकधा॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000608029, "chapter_id": 20608, "verse_number": "५-६७-३०", "content_sanskrit": "अदात्तदा क्रतौ रामो विप्रेभ्यो भूरिदक्षिणाम् ।\nलक्षंलक्षं सुवर्णस्य प्रत्येकं त्वग्रजन्मने॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000608030, "chapter_id": 20608, "verse_number": "५-६७-३१", "content_sanskrit": "दीनांधकृपणेभ्यश्च ददौ दानमनेकधा ।\nयथासंतोषविहितैर्वित्तै रत्नैर्मनोहरैः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000608031, "chapter_id": 20608, "verse_number": "५-६७-३२", "content_sanskrit": "वासांसि च विचित्राणि भोजनानि मृदूनि च ।\nतत्र प्रादाद्यथाशास्त्रं सर्वेषां प्रीतिदायकम्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000608032, "chapter_id": 20608, "verse_number": "५-६७-३३", "content_sanskrit": "हृष्टपुष्टजनाकीर्णं सर्वसत्त्वोपबृंहितम् ।\nअत्यंतमभवद्धृष्टं पुरं पुंस्त्रीसमावृतम्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000608033, "chapter_id": 20608, "verse_number": "५-६७-३४", "content_sanskrit": "दानं ददंतं सर्वेषां वीक्ष्य कुंभोद्भवो मुनिः ।\nअत्यंतपरमप्रीतिं ययौ क्रतुवरे द्विजः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000608034, "chapter_id": 20608, "verse_number": "५-६७-३५", "content_sanskrit": "तदाभिषेकस्नानार्थं पानीयममृतोपमम् ।\nआनेतुं च चतुःषष्टि नृपान्सस्त्रीन्समाह्वयत्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000608035, "chapter_id": 20608, "verse_number": "५-६७-३६", "content_sanskrit": "रामस्तु सीतया सार्द्धमानेतुमुदकं ययौ ।\nघटेन स्वर्णवर्णेन सर्वालंकारशोभया॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000608036, "chapter_id": 20608, "verse_number": "५-६७-३७", "content_sanskrit": "सौमित्रिरप्यूर्मिलया मांडव्या भरतो नृपः ।\nशत्रुघ्नः श्रुतकीर्त्या च कांतिमत्या च पुष्कलः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000608037, "chapter_id": 20608, "verse_number": "५-६७-३८", "content_sanskrit": "सुबाहुः सत्यवत्या च सत्यवान्वीरभूषया ।\nसुमदस्तत्र सत्कीर्त्या राज्ञ्या च विमलो नृपः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000608038, "chapter_id": 20608, "verse_number": "५-६७-३९", "content_sanskrit": "राजावीरमणिस्तत्र श्रुतवत्या मनोज्ञया ।\nलक्ष्मीनिधिः कोमलया रिपुतापोंगसेनया॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000608039, "chapter_id": 20608, "verse_number": "५-६७-४०", "content_sanskrit": "विभीषणो महामूर्त्या प्रतापाग्र्यः प्रतीतया ।\nउग्राश्वः कामगमया नीलरत्नोधिरम्यया॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000608040, "chapter_id": 20608, "verse_number": "५-६७-४१", "content_sanskrit": "सुरथः सुमनोहार्या तथा मोहनया कपिः ।\nइत्यादीन्नृपतीन्विप्रो वसिष्ठः प्राहिणोन्मुनिः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000608041, "chapter_id": 20608, "verse_number": "५-६७-४२", "content_sanskrit": "वसिष्ठः सरयूं गत्वा शिवपुण्यजलाप्लुताम् ।\nउदकं मंत्रयामास वेदमंत्रेण मंत्रवित्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000608042, "chapter_id": 20608, "verse_number": "५-६७-४३", "content_sanskrit": "पयः पुनीह्यमुं वाहमुदकेन मनोहृता ।\nयज्ञार्थं रामचंद्रस्य सर्वलोकैकरक्षितुः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000608043, "chapter_id": 20608, "verse_number": "५-६७-४४", "content_sanskrit": "उदकं तन्मुनिस्पृष्टं सर्वे रामादयो नृपाः ।\nआजह्रुर्मंडपतले विप्रवर्यैरुपस्तुते॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000608044, "chapter_id": 20608, "verse_number": "५-६७-४५", "content_sanskrit": "पयोभिर्निर्मलैः स्नाप्य वाजिनं क्षीरसन्निभम् ।\nमंत्रेण मंत्रयामास राम हस्तेन कुंभजः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000608045, "chapter_id": 20608, "verse_number": "५-६७-४६", "content_sanskrit": "पुनीहि मां महावाह अस्मिन्ब्रह्मसमाकुले ।\nत्वन्मेधेनाखिला देवाः प्रीणंतु परितोषिताः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000608046, "chapter_id": 20608, "verse_number": "५-६७-४७", "content_sanskrit": "इत्युक्त्वा स नृपो रामः सीतया सममस्पृशत् ।\nतदा सर्वे द्विजाश्चित्रममन्यंत कुतूहलात्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000608047, "chapter_id": 20608, "verse_number": "५-६७-४८", "content_sanskrit": "परस्परमवोचंस्ते यन्नामस्मरणान्नराः ।\nमहापापात्प्रमुच्यंते स रामः किं वदत्यहो॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000608048, "chapter_id": 20608, "verse_number": "५-६७-४९", "content_sanskrit": "इत्युक्तवति भूमीशे रामे कुंभोद्भवो मुनिः ।\nकरवालं चाभिमंत्र्य ददौ रामकरे मुनिः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000608049, "chapter_id": 20608, "verse_number": "५-६७-५०", "content_sanskrit": "करवाले धृते स्पृष्टे रामेण स हयः क्रतौ ।\nपशुत्वं तु विहायाशु दिव्यरूपमपद्यत॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000608050, "chapter_id": 20608, "verse_number": "५-६७-५१", "content_sanskrit": "विमानवरमारूढश्चाप्सरोभिः समंततः ।\nचामरैर्वीज्यमानश्च वैजयंत्या विभूषितः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000608051, "chapter_id": 20608, "verse_number": "५-६७-५२", "content_sanskrit": "तदा तं वाजितां त्यक्त्वा दिव्यरूपधरं वरम् ।\nवीक्ष्य लोकाः क्रतौ सर्वे विस्मयं प्राप्नुवंस्तदा॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000608052, "chapter_id": 20608, "verse_number": "५-६७-५३", "content_sanskrit": "तदा रामः स्वयं जानञ्ज्ञापयन्सर्वतो नरान् ।\nपप्रच्छ दिव्यरूपं तं सुरं परमधार्मिकः॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000608053, "chapter_id": 20608, "verse_number": "५-६७-५४", "content_sanskrit": "कस्त्वं दिव्यवपुः प्राप्तः कस्मात्त्वं वाजितां गतः ।\nकथं सुरस्त्रीसहितः किं चिकीर्षसि तद्वद॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000608054, "chapter_id": 20608, "verse_number": "५-६७-५५", "content_sanskrit": "रामस्य वचनं श्रुत्वा देवः प्रोवाच भूमिपम् ।\nहसन्मेघरवां वाणीमवदत्सुमनोहराम्॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000608055, "chapter_id": 20608, "verse_number": "५-६७-५६", "content_sanskrit": "तवाज्ञातं न सर्वत्र बाह्याभ्यंतरचारिणः ।\nतथापि पृच्छते तुभ्यं कथयामि यथातथम्॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000608056, "chapter_id": 20608, "verse_number": "५-६७-५७", "content_sanskrit": "अहं पुराभवे राम द्विजः परमधार्मिकः ।\nअचरं प्रतिकूलं वै वेदस्य रिपुतापन॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000608057, "chapter_id": 20608, "verse_number": "५-६७-५८", "content_sanskrit": "कदाचिद्धुतपापायास्तीरेऽहं गतवान्पुरा ।\nअनेकवृक्षललिते सर्वत्रसुमनोरमे॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000608058, "chapter_id": 20608, "verse_number": "५-६७-५९", "content_sanskrit": "तत्र स्नात्वा पितॄंस्तृप्त्वा दानं दत्त्वा यथाविधि ।\nध्यानं तव महाबाहो कृतवान्वेदसंमितम्॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000608059, "chapter_id": 20608, "verse_number": "५-६७-६०", "content_sanskrit": "तदा जनाः समायाता बहवस्तत्र भूपते ।\nतेषां प्रवंचनार्थाय दंभमेनमकारिषम्॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000608060, "chapter_id": 20608, "verse_number": "५-६७-६१", "content_sanskrit": "अनेकक्रतुसंभारैः पूर्णमजिरमुत्तमम् ।\nवासोभिश्छादितं रम्यं चषालादियुतं महत्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000608061, "chapter_id": 20608, "verse_number": "५-६७-६२", "content_sanskrit": "अग्निहोत्रोद्भवोधूमः सर्वतो नभसोंगणम् ।\nचकार रम्यमतुलं चित्रकारिवपुर्धरः॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000608062, "chapter_id": 20608, "verse_number": "५-६७-६३", "content_sanskrit": "अनेकतिलकश्रीभिः शोभितांगो महत्तपाः ।\nदर्भशोभः समित्पाणिर्दंभो मूर्तिधरः किमु॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000608063, "chapter_id": 20608, "verse_number": "५-६७-६४", "content_sanskrit": "दुर्वासास्तत्र स्वच्छंदं पर्यटञ्जगतीतलम् ।\nप्राप तत्र महातेजा धूतपापसरित्तटे॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000608064, "chapter_id": 20608, "verse_number": "५-६७-६५", "content_sanskrit": "ददर्श मां दंभकरं मौनधारिणमग्रतः ।\nअनर्घ्यकरमुन्मत्तमस्वागतवचः करम्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000608065, "chapter_id": 20608, "verse_number": "५-६७-६६", "content_sanskrit": "दृष्ट्वातीव क्रुधाक्रांतः समुद्र इव पर्वणि ।\nशशापासौ मुनिस्तीव्रो दंभिनं मां महामतिः॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000608066, "chapter_id": 20608, "verse_number": "५-६७-६७", "content_sanskrit": "दंभं करोषि चेत्तीरे सरितस्त्वं सुदुर्मते ।\nतस्मात्प्राप्नुहि निर्वाच्यं पशुत्वं तापसाधम॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000608067, "chapter_id": 20608, "verse_number": "५-६७-६८", "content_sanskrit": "शापं प्रदत्तं संश्रुत्य दुःखितोऽहं तदाभवम् ।\nअग्राहिषं पदे तस्य मुनेर्दुर्वाससः किल॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000608068, "chapter_id": 20608, "verse_number": "५-६७-६९", "content_sanskrit": "तदा मे कृतवान्राम द्विजोऽनुग्रहमुत्तमम् ।\nवाजितां प्राप्नुहि मखे राजराजस्य तापस॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000608069, "chapter_id": 20608, "verse_number": "५-६७-७०", "content_sanskrit": "पश्चात्तद्धस्तसंपर्काद्याहि तत्परमं पदम् ।\nदिव्यं वपुर्मनोहारि धृत्वा दंभविवर्जितम्॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000608070, "chapter_id": 20608, "verse_number": "५-६७-७१", "content_sanskrit": "तेन शापोपिसंदिष्टो ममानुग्रहतां गतः ।\nयदहं तव हस्तस्य स्पर्शं प्राप्तो मनोरमम्॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000608071, "chapter_id": 20608, "verse_number": "५-६७-७२", "content_sanskrit": "यदेव राम देवादिदुर्लभं बहुजन्मभिः ।\nतत्तेऽहं करजस्पर्शं प्राप्तवानिह दुर्लभम्॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000608072, "chapter_id": 20608, "verse_number": "५-६७-७३", "content_sanskrit": "आज्ञापय महाराज त्वत्प्रसादादहं महत् ।\nगच्छामि शाश्वतं स्थानं तव दुःखादिवर्जितम्॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000608073, "chapter_id": 20608, "verse_number": "५-६७-७४", "content_sanskrit": "न यत्र शोको न जरा न मृत्युः कालविभ्रमः ।\nतत्स्थानं देव गच्छामि त्वत्प्रसादान्नराधिप॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000608074, "chapter_id": 20608, "verse_number": "५-६७-७५", "content_sanskrit": "इत्युक्त्वा तं परिक्रम्य विमानवरमारुहत् ।\nअनेकरत्नखचितं सर्वदेवाधिवंदितम्॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000608075, "chapter_id": 20608, "verse_number": "५-६७-७६", "content_sanskrit": "गतोऽसौ शाश्वतस्थानं रामपादप्रसादतः ।\nपुनरावृत्तिरहितं शोकमोहविवर्जितम्॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000608076, "chapter_id": 20608, "verse_number": "५-६७-७७", "content_sanskrit": "तेन तत्कथितं श्रुत्वा रामं ज्ञात्वेतरे जनाः ।\nविस्मयं प्रापिरे सर्वे परस्परमुदुन्मदाः॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000608077, "chapter_id": 20608, "verse_number": "५-६७-७८", "content_sanskrit": "शृणु द्विजमहाबुद्धे दंभेनापि स्मृतो हरिः ।\nददाति मोक्षं सुतरां किं पुनर्दंभवर्जनात्॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000608078, "chapter_id": 20608, "verse_number": "५-६७-७९", "content_sanskrit": "यथाकथंचिद्रामस्य कर्तव्यं स्मरणं परम् ।\nयेन प्राप्नोति परमं पदं देवादिदुर्लभम्॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000608079, "chapter_id": 20608, "verse_number": "५-६७-८०", "content_sanskrit": "तच्चित्रं वीक्ष्य मुनयः कृतार्थं मेनिरे निजम् ।\nयद्रामचरणप्रेक्षा करस्पर्शपवित्रितम्॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000608080, "chapter_id": 20608, "verse_number": "५-६७-८१", "content_sanskrit": "गते तस्मिन्सुरे स्वर्गं हयरूपधरे पुरा ।\nउवाच रामस्तपसां निधीन्वेदविदुत्तमान्॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000608081, "chapter_id": 20608, "verse_number": "५-६७-८२", "content_sanskrit": "किं कर्तव्यं मयाब्रह्मन्हयो नष्टो गतः सुखम् ।\nहोमः कथं पुरोभावी सर्वदैवततर्पकः॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000608082, "chapter_id": 20608, "verse_number": "५-६७-८३", "content_sanskrit": "यथा स्यात्सुरसंतृप्तिर्यथा मे मख उत्तमः ।\nतथा कुर्वंतु मुनयो यथा मे स्याद्विधिश्रुतम्॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000608083, "chapter_id": 20608, "verse_number": "५-६७-८४", "content_sanskrit": "इति वाक्यं समाश्रुत्य जगाद मुनिसत्तमः ।\nवसिष्ठः सर्वदेवानां चित्ताभिज्ञानकोविदः॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000608084, "chapter_id": 20608, "verse_number": "५-६७-८५", "content_sanskrit": "कर्पूरमाहर क्षिप्रं येन देवाः स्वयं पुरा ।\nप्राप्य हव्यं ग्रहीष्यंति मद्वाक्यप्रेरिताधुना॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000608085, "chapter_id": 20608, "verse_number": "५-६७-८६", "content_sanskrit": "इति वाक्यं समाकर्ण्य रामः क्षिप्रमुपाहरत् ।\nकर्पूरं बहुदेवानां प्रीत्यर्थं बहुशोभनम्॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000608086, "chapter_id": 20608, "verse_number": "५-६७-८७", "content_sanskrit": "तदा मुनिः प्रहृष्टात्मा देवानाह्वयदद्भुतान् ।\nते सर्वे तत्क्षणात्प्राप्ताः स्वपरीवारसंवृताः॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}]