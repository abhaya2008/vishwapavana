[{"id": 50000034, "chapter_id": 10360, "verse_number": "1", "content_sanskrit": "तस्य य आत्मानमाविस्तरां वेदाश्नुते हाविर्भूय इति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50000035, "chapter_id": 10360, "verse_number": "2", "content_sanskrit": "ओषधिवनस्पतयो यच्च किंच प्राणभृत्स आत्मानमाविस्तरां वेदौषधिवनस्पतिषु हि रसो दृश्यते चित्तं प्राणभृत्सु।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50000036, "chapter_id": 10360, "verse_number": "3", "content_sanskrit": "प्राणभृत्सु त्वेवाऽऽविस्तरामात्मा तेषु हि रसोऽपि दृश्यते न चित्तमितरेषु।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50000037, "chapter_id": 10360, "verse_number": "4", "content_sanskrit": "पुरुषे त्वेवाऽऽविस्तरामात्मा स हि प्रज्ञानेन संपन्नतमो विज्ञातं वदति विज्ञातं पश्यति वेद श्वस्तनं वेद लोकालोकौ मर्त्येनामृतमीप्सत्येवं संपन्नः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50000038, "chapter_id": 10360, "verse_number": "5", "content_sanskrit": "अथेतरेषां पशूनामशनापिपासे एवाभिविज्ञानं न विज्ञातं वदन्ति न विज्ञातं पश्यन्ति न विदुः श्वस्तनं न लोकालोकौ त एतावन्तो भवन्ति यथाप्रज्ञं हि संभवाः॥ २/३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50000039, "chapter_id": 10360, "verse_number": "6", "content_sanskrit": "॥ इत्यैतरेयब्राह्मणारण्यककाण्डे द्वितीयारण्यके तृतीयेऽध्याये द्वितीयः खण्डः॥ (१४)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]