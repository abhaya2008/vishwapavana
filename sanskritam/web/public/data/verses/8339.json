[{"id": 900004407, "chapter_id": 8339, "verse_number": "2.1", "content_sanskrit": "नृसिंहमखिलाज्ञानतिमिराशिशिरयुतिम् । सम्प्रणम्य प्रवक्ष्यामि कथालक्षणमञ्जसा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900004408, "chapter_id": 8339, "verse_number": "2.2", "content_sanskrit": "वादोजल्पोवितण्डेतित्रिविधाविदुषांकथा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900004409, "chapter_id": 8339, "verse_number": "2.3", "content_sanskrit": "तत्वनिर्णयमुद्दिश्य केवलं गुरुशिष्ययोः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900004410, "chapter_id": 8339, "verse_number": "2.4", "content_sanskrit": "ख्यात्याद्यर्थ स्पर्धया वा सतां जल्प इतीर्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900004411, "chapter_id": 8339, "verse_number": "2.5", "content_sanskrit": "वितण्डा तु सतामन्यैः..........", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900004412, "chapter_id": 8339, "verse_number": "2.6", "content_sanskrit": "स्वयंवा प्राश्निकैर्वादे चिन्तयेत्........", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900004413, "chapter_id": 8339, "verse_number": "2.7", "content_sanskrit": "पृष्टेनाऽगम एवादौ वक्तव्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900004414, "chapter_id": 8339, "verse_number": "2.8", "content_sanskrit": "जल्पे यावत् परो जितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900004415, "chapter_id": 8339, "verse_number": "2.9", "content_sanskrit": "तत्वनिर्णयवैलोम्यं वादे साक्षात् पराजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900004416, "chapter_id": 8339, "verse_number": "2.10", "content_sanskrit": "विरोधाऽसङ्गतिन्यूनतुष्णीम्भावाऽदिकैजितः भवेज्जल्पे, वितण्डायां न्यायो जल्पवदीरितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900004417, "chapter_id": 8339, "verse_number": "2.11", "content_sanskrit": "तदभावात् नैव षट्कात् अन्यो निग्रह इष्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900004418, "chapter_id": 8339, "verse_number": "2.12", "content_sanskrit": "वादजल्पवितण्डानां इति शुद्धं स्वलक्षणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]