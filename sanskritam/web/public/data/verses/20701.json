[{"id": 7000701000, "chapter_id": 20701, "verse_number": "६-४४-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nफाल्गुनस्यासिते पक्षे किंनामैकादशीभवेत् ।\nकथयस्व प्रसादेन वासुदेव ममाग्रतः ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000701001, "chapter_id": 20701, "verse_number": "६-४४-२", "content_sanskrit": "श्रीकृष्ण उवाच ।\nनारदः परिपप्रच्छ ब्रह्माणं कमलासनम् ।\nफाल्गुनस्यासिते पक्षे विजयानाम नामतः ।\nतस्याः पुण्यं द्विजश्रेष्ठ कथयस्व प्रसादतः ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000701002, "chapter_id": 20701, "verse_number": "६-४४-३", "content_sanskrit": "ब्रह्मोवाच ।\nशृणु नारद वक्ष्यामि कथां पापहराम्पराम् ।\nयन्न कस्यचिदाख्यातं मयैतद्विजयाव्रतम् ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000701003, "chapter_id": 20701, "verse_number": "६-४४-४", "content_sanskrit": "पुरातनं व्रतं ह्येतत्पवित्रं पापनाशनम् ।\nजयं ददाति विजया नृपाणां वै न संशयः ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000701004, "chapter_id": 20701, "verse_number": "६-४४-५", "content_sanskrit": "पुरा रामो वनं यातो वर्षाण्येव चतुर्दश ।\nन्यवसत्पंचवट्यां तु सहसीतः सलक्ष्मणः ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000701005, "chapter_id": 20701, "verse_number": "६-४४-६", "content_sanskrit": "तत्रैव वसतस्तस्य रामस्य विजयात्मनः ।\nरावणेन हृता लौल्याद्भार्या सीता यशस्विनी ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000701006, "chapter_id": 20701, "verse_number": "६-४४-७", "content_sanskrit": "तेन दुःखेन रामोऽपि मोहमभ्यागतस्तदा ।\nभ्रमन्जटायुषमथो ददर्श विगतायुषम् ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000701007, "chapter_id": 20701, "verse_number": "६-४४-८", "content_sanskrit": "कबंधो निहतः पश्चाद्भ्रमतारण्यमध्यतः ।\nसुग्रीवेण समं तस्य सखित्वं समपद्यत ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000701008, "chapter_id": 20701, "verse_number": "६-४४-९", "content_sanskrit": "वानराणामनीकानि रामार्थंसंगतानि च ।\nततो हनुमता दृष्टा लंकोद्याने तु जानकी ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000701009, "chapter_id": 20701, "verse_number": "६-४४-१०", "content_sanskrit": "रामसंज्ञापनं तस्यै दत्तं कर्म महत्कृतम् ।\nपुनः समेत्य रामेण सर्वं तत्र निवेदितम् ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000701010, "chapter_id": 20701, "verse_number": "६-४४-११", "content_sanskrit": "अथ श्रुत्वा रामचंद्रो वाक्यं चैव हनूमतः ।\nसुग्रीवानुमतेनैव प्रस्थानं समरोचयत् ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000701011, "chapter_id": 20701, "verse_number": "६-४४-१२", "content_sanskrit": "सौमित्रेकेन पुण्येन तीर्यते वरुणालयः ।\nअगाधो नितरामेष यादोभिश्च समाकुलः ।\nउपायं नैव पश्यामि येनासौ सुतरो भवेत् ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000701012, "chapter_id": 20701, "verse_number": "६-४४-१३", "content_sanskrit": "लक्ष्मण उवाच ।\nआदिदेवस्त्वमेवासि पुराणपुरुषोत्तमः ।\nबकदाल्भ्यो मुनिश्चात्र वर्तते द्वीपमध्यतः ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000701013, "chapter_id": 20701, "verse_number": "६-४४-१४", "content_sanskrit": "अस्मात्स्थानाद्योजनार्द्धमाश्रमस्तस्य राघव ।\nअन्ये च ब्राह्मणास्तत्र बहवो रघुनंदन ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000701014, "chapter_id": 20701, "verse_number": "६-४४-१५", "content_sanskrit": "तं पृच्छ गत्वा राजेंद्र पुराणमृषिपुंगवम् ।\nइति वाक्यं ततः श्रुत्वा लक्ष्मणस्यातिशोभनम् ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000701015, "chapter_id": 20701, "verse_number": "६-४४-१६", "content_sanskrit": "जगाम राघवो द्रष्टुं बकदाल्भ्यं महामुनिम् ।\nप्रणनाम मुनिं मूर्ध्ना रामो विष्णुमिवामरः ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000701016, "chapter_id": 20701, "verse_number": "६-४४-१७", "content_sanskrit": "ज्ञात्वा मुनिस्ततो रामं पुराणं पुरुषोत्तमम् ।\nकेनापि कारणेनैव प्रविष्टो मानुषीं तनुम् ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000701017, "chapter_id": 20701, "verse_number": "६-४४-१८", "content_sanskrit": "उवाच स ऋषिस्तुष्टः कुतो राम तवागमः ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000701018, "chapter_id": 20701, "verse_number": "६-४४-१९", "content_sanskrit": "राम उवाच ।\nत्वत्प्रसादादहं विप्र तीरं नदनदीपतेः ।\nआगतोऽस्मि ससैन्योऽत्र लंकां जेतुं सराक्षसाम् ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000701019, "chapter_id": 20701, "verse_number": "६-४४-२०", "content_sanskrit": "भवतश्चानुकूलत्वात्तीर्यतेऽब्धिर्यथा मया ।\nतमुपायं वद मुने प्रसादं कुरु सांप्रतम् ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000701020, "chapter_id": 20701, "verse_number": "६-४४-२१", "content_sanskrit": "एतस्मात्कारणादेव द्रष्टुं त्वाहमिहागतः ।\nरामस्य वचनं श्रुत्वा बकदाल्भ्यो महामुनिः ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000701021, "chapter_id": 20701, "verse_number": "६-४४-२२", "content_sanskrit": "उवाच सुप्रसन्नात्मा रामं राजीवलोचनम् ।\nकर्तव्यमद्य ते राम व्रतानां व्रतमुत्तमम् ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000701022, "chapter_id": 20701, "verse_number": "६-४४-२३", "content_sanskrit": "कृतेन येन सहसा विजयस्ते भविष्यति ।\nलंकां जित्वा राक्षसांश्च स्वच्छां कीर्तिमवाप्स्यसि ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000701023, "chapter_id": 20701, "verse_number": "६-४४-२४", "content_sanskrit": "एकाग्रमानसो भूत्वा व्रतमेतत्समाचर ।\nफाल्गुनस्यासिते पक्षे विजयैकादशी भवेत् ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000701024, "chapter_id": 20701, "verse_number": "६-४४-२५", "content_sanskrit": "तस्या व्रतेन हे राम विजयस्ते भविष्यति ।\nनिःसंशयं समुद्रं त्वं तरिष्यसि सवानरः ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000701025, "chapter_id": 20701, "verse_number": "६-४४-२६", "content_sanskrit": "विधिस्तु श्रूयतां राजन्व्रतस्यास्य फलप्रदः ।\nदशम्यां दिवसे प्राप्ते कुंभमेकं तु कारयेत् ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000701026, "chapter_id": 20701, "verse_number": "६-४४-२७", "content_sanskrit": "हैमं वा राजतं वापि ताम्रं वाप्यथ मृन्मयम् ।\nस्थापयेच्छोभितं चैव जलपूर्णं सपल्लवम् ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000701027, "chapter_id": 20701, "verse_number": "६-४४-२८", "content_sanskrit": "सप्तधान्यान्यधस्तस्य यवानुपरि विन्यसेत् ।\nतस्योपरि न्यसेद्देवं हैमं नारायणं प्रभुम् ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000701028, "chapter_id": 20701, "verse_number": "६-४४-२९", "content_sanskrit": "एकादशीदिने प्राप्ते प्रातः स्नानं समाचरेत् ।\nनिश्चलं स्थापयेत्कुंभं कंठमाल्यानुलेपनैः ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000701029, "chapter_id": 20701, "verse_number": "६-४४-३०", "content_sanskrit": "पूगीफलैर्नालिकेरैः पूजयेच्च विशेषतः ।\nगंधैर्धूपैश्चदीपैश्च नैवेद्यैर्विविधैरपि ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000701030, "chapter_id": 20701, "verse_number": "६-४४-३१", "content_sanskrit": "कुंभाग्रे तद्दिनं राम नीयते सत्कथादिभिः ।\nरात्रौ जागरणं चैव तस्याग्रे कारयेद्बुधः ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000701031, "chapter_id": 20701, "verse_number": "६-४४-३२", "content_sanskrit": "प्रकाशयेद्घृतदीपमखंडव्रतहेतवे ।\nद्वादशीदिवसे प्राप्ते मार्तंडस्योदये सति ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000701032, "chapter_id": 20701, "verse_number": "६-४४-३३", "content_sanskrit": "नीत्वा कुंभं जलोद्देशे नद्याः प्रस्रवणे तथा ।\nतडागे स्थापयित्वा तं पूजयित्वा यथाविधि ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000701033, "chapter_id": 20701, "verse_number": "६-४४-३४", "content_sanskrit": "दद्यात्सदेवं तं कुंभं ब्राह्मणे वेदपारगे ।\nकुंभेन सह राजेंद्र महादानानि दापयेत् ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000701034, "chapter_id": 20701, "verse_number": "६-४४-३५", "content_sanskrit": "अनेनविधिना राम यूथपैः सह संगतः ।\nकुरु व्रतं प्रयत्नेन विजयस्ते भविष्यति ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000701035, "chapter_id": 20701, "verse_number": "६-४४-३६", "content_sanskrit": "इति श्रुत्वा ततो रामो यथोक्तमकरोत्तदा ।\nकृते व्रते स विजयी बभूव रघुनंदनः ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000701036, "chapter_id": 20701, "verse_number": "६-४४-३७", "content_sanskrit": "प्राप्ता सीता जिता लंका पौलस्त्यो निहतो रणे ।\nअनेनविधिना पुत्र ये कुर्वंति नरा व्रतम् ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000701037, "chapter_id": 20701, "verse_number": "६-४४-३८", "content_sanskrit": "इहलोकजयप्राप्तिः परलोकस्तथाक्षयः ।\nएतस्मात्कारणात्पुत्र कर्तव्यं विजयाव्रतम् ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000701038, "chapter_id": 20701, "verse_number": "६-४४-३९", "content_sanskrit": "विजयायाश्च माहात्म्यं सर्वकिल्बिषनाशनम् ।\nपठनाच्छ्रवणाच्चैव वाजपेयफलं लभेत् ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]