[{"id": 7003970000, "chapter_id": 23970, "verse_number": "३-१-३३-१", "content_sanskrit": "श्रीसूत उवाच ।\nभूयोऽप्यहं प्रवक्ष्यामि धनुष्कोटेस्तु वैभवम् ।\nअत्यद्भुततरं गुह्यं सर्वलोकैकपावनम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003970001, "chapter_id": 23970, "verse_number": "३-१-३३-२", "content_sanskrit": "पुरा परावसुर्नाम ब्राह्मणो वेदवित्तमः ।\nअज्ञानात्पितरं हत्वा ब्रह्महत्यामवाप्तवान् ।\nसोऽपि स्नात्वा धनुष्कोटौ तद्दोषा न्मुमुचे क्षणात्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003970002, "chapter_id": 23970, "verse_number": "३-१-३३-३", "content_sanskrit": "ऋषय ऊचुः ।\nपितरं हतवान्पूर्वं कथं सूत परावसुः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003970003, "chapter_id": 23970, "verse_number": "३-१-३३-४", "content_sanskrit": "कथं वा धनुषः कोटौ मुक्तिस्तस्याप्यभून्मुने ।\nएतन्नः श्रद्दधानानां विस्तराद्वक्तुमर्हसि॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003970004, "chapter_id": 23970, "verse_number": "३-१-३३-५", "content_sanskrit": "श्रीसूत उवाच ।\nआसीद्राजा बृहद्द्युम्नश्चक्रवर्ती महाबलः ।\nधर्मेण पालयामास सागरांतां वसुन्धराम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003970005, "chapter_id": 23970, "verse_number": "३-१-३३-६", "content_sanskrit": "अयजत्सत्रयागेन देवानिंद्रपुरोगमान् ।\nयाजकस्तस्य रैभ्योऽभूद्विद्वान्परमधार्मिकः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003970006, "chapter_id": 23970, "verse_number": "३-१-३३-७", "content_sanskrit": "आस्तां पुत्रावुभौ तस्याप्यर्वावसु परावसू ।\nषडंगवेदविदुषौ श्रौतस्मार्तेषु कोविदौ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003970007, "chapter_id": 23970, "verse_number": "३-१-३३-८", "content_sanskrit": "काणादे जैमिनीये च सांख्ये वैयासिके तथा ।\nगौतमे योगशास्त्रे च पाणिनीये च कोवि दौ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003970008, "chapter_id": 23970, "verse_number": "३-१-३३-९", "content_sanskrit": "मन्वादिस्मृतिनिष्णातौ सर्वशास्त्रविशारदौ ।\nसत्रयागे सहायार्थं बृहद्द्युम्नेन याचितौ॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003970009, "chapter_id": 23970, "verse_number": "३-१-३३-१०", "content_sanskrit": "भ्रातरौ समनुज्ञातौ पित्रा रैभ्येण जग्मतुः ।\nबृहद्द्युम्नस्य सत्रं तावश्विनाविव रूपिणौ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003970010, "chapter_id": 23970, "verse_number": "३-१-३३-११", "content_sanskrit": "अतिष्ठदाश्रमे रैभ्यः स्नुषया ज्येष्ठया सह ।\nतौ गत्वा भ्रातरौ तत्र राज्ञः सत्रमनुत्तमम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003970011, "chapter_id": 23970, "verse_number": "३-१-३३-१२", "content_sanskrit": "याज यामासतुः सत्रे बृहद्द्युम्नं महीपतिम् ।\nनाभवत्स्खलनं भ्रात्रोः सत्रे सांगेषु कर्मसु॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003970012, "chapter_id": 23970, "verse_number": "३-१-३३-१३", "content_sanskrit": "सत्रे संतन्यमानेऽस्मिन्बृहद्द्युम्नस्य भूपतेः ।\nमुनयो भ्यागमन्सर्वे राज्ञाहूता निरीक्षितुम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003970013, "chapter_id": 23970, "verse_number": "३-१-३३-१४", "content_sanskrit": "वसिष्ठो गौतमश्चात्रिर्जाबालिरथ कश्यपः ।\nक्रतुर्दक्षः पुलस्त्यश्च पुलहो नारदो मुनिः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003970014, "chapter_id": 23970, "verse_number": "३-१-३३-१५", "content_sanskrit": "मार्कंडेयः शतानंदो विश्वामित्रः पराशरः ।\nभृगुः कुत्सोऽथ वाल्मीकिर्व्यासधौम्यादयोऽपरे॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003970015, "chapter_id": 23970, "verse_number": "३-१-३३-१६", "content_sanskrit": "शिष्यैः प्रशिष्यैर्बहुभिरसंख्यातैः समावृताः ।\nतानागतान्समालोक्य बृहद्द्युम्नो महीपतिः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003970016, "chapter_id": 23970, "verse_number": "३-१-३३-१७", "content_sanskrit": "अर्घ्यादिना मुनीन्सर्वान्पूजयामास सादरम् ।\nनाना दिग्भ्यः समायाताश्चतुरंगबलैर्युताः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003970017, "chapter_id": 23970, "verse_number": "३-१-३३-१८", "content_sanskrit": "उपदासहिता भूपास्सत्रं वीक्षितुमादरात् ।\nवैश्याः शूद्रास्तथा वर्णाश्चत्वरोऽपि समागताः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003970018, "chapter_id": 23970, "verse_number": "३-१-३३-१९", "content_sanskrit": "वर्णिनोऽथ गृहस्थाश्च वानप्रस्थाश्च भिक्षवः ।\nसत्रं निरीक्षितुं तस्य बृहद्द्युम्नस्य चाययुः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003970019, "chapter_id": 23970, "verse_number": "३-१-३३-२०", "content_sanskrit": "तान्सर्वान्पूजयामास यथार्हं राजसत्तमः ।\nददौ चान्नानि सर्वेभ्यो घृतसूपादिकांस्तथा॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003970020, "chapter_id": 23970, "verse_number": "३-१-३३-२१", "content_sanskrit": "वस्त्राणि च सुवर्णानि हाररत्नान्यनेकशः ।\nएवं सत्कारयामास राजा सत्रे समागतान्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003970021, "chapter_id": 23970, "verse_number": "३-१-३३-२२", "content_sanskrit": "रैभ्यपुत्रो तदा विप्रा अर्वावसुपरावसू ।\nअध्वरादीनि कर्माणि चक्रतुः स्खलितं विना॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003970022, "chapter_id": 23970, "verse_number": "३-१-३३-२३", "content_sanskrit": "तद्दृष्ट्वा मुनयस्सर्वे कौशलं रैभ्यपुत्रयौः ।\nश्लाघंते सशिरःकम्पं वसिष्ठप्रमुखास्तदा॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003970023, "chapter_id": 23970, "verse_number": "३-१-३३-२४", "content_sanskrit": "कर्माणि कानि चित्तत्र कारयित्वा परावसुः ।\nतृतीयसवनस्यांते गृहकृत्यं निरीक्षितुम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003970024, "chapter_id": 23970, "verse_number": "३-१-३३-२५", "content_sanskrit": "प्रययौ स्वाश्रमं सायं विनैवार्वावसुं द्विजाः ।\nतस्मिन्नवसरे रैभ्यं कृष्णाजिनसमावृतम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003970025, "chapter_id": 23970, "verse_number": "३-१-३३-२६", "content_sanskrit": "वने चरंतं पितरं दृष्ट्वा स मृगशंकया ।\nनिद्राकलुषितो रात्रावंधे तमसि संकुले॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003970026, "chapter_id": 23970, "verse_number": "३-१-३३-२७", "content_sanskrit": "आत्मानं हंतुमायाति मृगोऽयमिति चिंतयन् ।\nजघान पितरं सोऽयं महारण्ये परावसुः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003970027, "chapter_id": 23970, "verse_number": "३-१-३३-२८", "content_sanskrit": "रिरक्षुणा शरीरं स्वं तेनाकामनया पिता ।\nरजन्यां हिंसितो विप्रा महापातककारिणा॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003970028, "chapter_id": 23970, "verse_number": "३-१-३३-२९", "content_sanskrit": "अंतिकं स समागत्य व्यलोकयत तं हतम् ।\nज्ञात्वा स्वपितरं रात्रौ शुशोच व्यथितेंद्रियः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003970029, "chapter_id": 23970, "verse_number": "३-१-३३-३०", "content_sanskrit": "प्रेतकार्यं ततः कृत्वा पितुः सर्वं परावसुः ।\nभूयोपि नृपतेः सत्रं परावसुरुपाययौ॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003970030, "chapter_id": 23970, "verse_number": "३-१-३३-३१", "content_sanskrit": "स्वचेष्टितं तु तत्सर्वमनुजाय ततोऽब्रवीत् ।\nमृतं स्वपितरं श्रुत्वा सोऽपि शोकाकुलोऽभवत्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003970031, "chapter_id": 23970, "verse_number": "३-१-३३-३२", "content_sanskrit": "ज्येष्ठोऽनुजं ततः प्राह वचनं द्विजसत्तमाः ।\nमहत्सत्रं समारब्धं बृहद्द्युम्नस्य भूपतेः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003970032, "chapter_id": 23970, "verse_number": "३-१-३३-३३", "content_sanskrit": "वोढुत्वशक्तिर्नास्त्यस्य कर्मणो बालकस्य ते ।\nजनकश्च हतो रात्रौ मयापि मृगशंकया॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003970033, "chapter_id": 23970, "verse_number": "३-१-३३-३४", "content_sanskrit": "प्रायश्चित्तं च कर्त्तव्यं ब्रह्महत्या विशुद्धये ।\nमदर्थं व्रतचर्यां त्वं चर तात कनिष्ठक॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003970034, "chapter_id": 23970, "verse_number": "३-१-३३-३५", "content_sanskrit": "एकाकी धुरमुद्वोढुं शक्तोऽहं सत्रकर्मणः ।\nअर्वावसुरिति प्रोक्तो ज्येष्ठेन स तमभ्य धात्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003970035, "chapter_id": 23970, "verse_number": "३-१-३३-३६", "content_sanskrit": "तथा भवत्वहं ज्येष्ठ चरिष्ये व्रतमुत्तमम् ।\nब्रह्महत्याविशुद्ध्यर्थं त्वं सत्रधुरमावह॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003970036, "chapter_id": 23970, "verse_number": "३-१-३३-३७", "content_sanskrit": "इत्युक्त्वा सोनुऽजो ज्येष्ठं तस्मात्सत्राद्वि निर्ययौ ।\nकारयामास कर्माणि ज्येष्ठस्तस्मिन्गते कतौ॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003970037, "chapter_id": 23970, "verse_number": "३-१-३३-३८", "content_sanskrit": "द्वादशाब्दं कनिष्ठोपि ब्रह्महत्याव्रतं द्विजाः ।\nचरित्वा सत्रयागेऽस्मिन्नाजगाम पुनर्मुदा॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003970038, "chapter_id": 23970, "verse_number": "३-१-३३-३९", "content_sanskrit": "तं दृष्ट्वा भ्रातरं ज्येष्ठो बृहद्द्युम्नमुवाच ह ।\nअयं ते ब्रह्महा सत्रमर्वावसुरुपागतः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003970039, "chapter_id": 23970, "verse_number": "३-१-३३-४०", "content_sanskrit": "एनमुत्सारयाशु त्वमस्मात्सत्रान्नृपो त्तम ।\nअन्यथा सत्रयागस्य फलहानिर्भविष्यति॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003970040, "chapter_id": 23970, "verse_number": "३-१-३३-४१", "content_sanskrit": "इतीरितः स स्वप्रेष्यैर्यागात्तमुदवासयत् ।\nउद्वास्यमानो राजानमर्वावसुरथाब्रवीत्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003970041, "chapter_id": 23970, "verse_number": "३-१-३३-४२", "content_sanskrit": "न मया ब्रह्महत्येयं बृहद्द्युम्न कृतानघ ।\nकिन्तु ज्येष्ठेन मे सा हि ब्रह्महत्या कृता विभो॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003970042, "chapter_id": 23970, "verse_number": "३-१-३३-४३", "content_sanskrit": "ब्रह्महत्याव्रतं चीर्णं तदर्थं च मया धुना ।\nएवमुक्तोपि राजासौ वचसा स परावसोः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003970043, "chapter_id": 23970, "verse_number": "३-१-३३-४४", "content_sanskrit": "अर्वावसुं निजात्सत्रादुदवासयदाशु वै ।\nधिक्कृतो ब्राह्मणैश्चायं ययौ तूष्णीं वनं तदा॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003970044, "chapter_id": 23970, "verse_number": "३-१-३३-४५", "content_sanskrit": "मुनिवृन्दसमाकीर्णं तपोवनमुपेत्य सः ।\nअर्वावसुस्तपश्चक्रे देवैरपि सुदुष्करम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003970045, "chapter_id": 23970, "verse_number": "३-१-३३-४६", "content_sanskrit": "तपः कुर्वंस्तथादित्यमुपतस्थे समा हितः ।\nमूर्तिमांस्तपसा तस्य महताऽदुष्टधीः स्वयम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003970046, "chapter_id": 23970, "verse_number": "३-१-३३-४७", "content_sanskrit": "आविरासीत्स्वया दीप्त्या भासयञ्जगतीतलम् ।\nकर्मसाक्षी जगच्चक्षुर्भास्करो देवताग्रणीः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003970047, "chapter_id": 23970, "verse_number": "३-१-३३-४८", "content_sanskrit": "आविर्बभूवुर्देवाश्च पुरस्कृत्य शचीपतिम् ।\nइन्द्रादयस्ततो देवाः प्रोचुरर्वावसुं द्विजाः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003970048, "chapter_id": 23970, "verse_number": "३-१-३३-४९", "content_sanskrit": "अर्वावसो त्वं प्रवरस्तपसा ब्रह्म चर्यतः ।\nआचारेण श्रुतेनापि वेदशास्त्रादिशिक्षया॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003970049, "chapter_id": 23970, "verse_number": "३-१-३३-५०", "content_sanskrit": "निराकृतोवमानेन त्वं परावसुना बहु ।\nतथापि क्षमया युक्तो न कुप्यति भवान्यतः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003970050, "chapter_id": 23970, "verse_number": "३-१-३३-५१", "content_sanskrit": "यस्माज्ज्येष्ठोऽवधीत्तातं न हिंसीस्त्वं महामते ।\nब्रह्महत्याव्रतं यस्मात्तदर्थं चरितं त्वया॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003970051, "chapter_id": 23970, "verse_number": "३-१-३३-५२", "content_sanskrit": "अतः स्वीकुर्म हे त्वां तु पराकुर्मः परावसुम् ।\nउक्त्वैवं बलभिन्मुख्याः सर्वे च त्रिदिवालयाः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003970052, "chapter_id": 23970, "verse_number": "३-१-३३-५३", "content_sanskrit": "तं ते प्रवरयामासुर्निरासुश्च परावसुम् ।\nपुनरिंद्रादयो देवाः पुरोधाय दिवाकरम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003970053, "chapter_id": 23970, "verse_number": "३-१-३३-५४", "content_sanskrit": "अर्वावसुं प्रोचुरिदं वरं त्वं वरयेति वै ।\nस चापि प्रार्थयामास जनकस्योत्थितिं पुन॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003970054, "chapter_id": 23970, "verse_number": "३-१-३३-५५", "content_sanskrit": "वधे चास्मरणं देवानात्मनो जनकस्य वै ।\nतथास्त्विति सुराः प्रोचुः पुनरूचुरिदं वचः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003970055, "chapter_id": 23970, "verse_number": "३-१-३३-५६", "content_sanskrit": "वरं चान्यं प्रदास्यामो वरय त्वं महामते ।\nएवमुक्तः सुरैः सोयमर्वावसुरभाषत॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003970056, "chapter_id": 23970, "verse_number": "३-१-३३-५७", "content_sanskrit": "मम भ्रातुरदुष्टत्वं भवतु त्रिदशालयाः ।\nअर्वावसोर्वचः श्रुत्वा त्रिदशाः पुनरब्रुवन्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003970057, "chapter_id": 23970, "verse_number": "३-१-३३-५८", "content_sanskrit": "ब्राह्मणस्य पितुर्घातान्महान्दोषः परावसोः ।\nन ह्यन्यकृतपापस्य परेणानुष्ठितेन वै॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003970058, "chapter_id": 23970, "verse_number": "३-१-३३-५९", "content_sanskrit": "प्रायश्चित्तेन शांतिः स्यान्महापातकपंचके ।\nपितुर्ब्राह्मणहंतुस्तु सुतरां नास्ति निष्कृतिः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003970059, "chapter_id": 23970, "verse_number": "३-१-३३-६०", "content_sanskrit": "आत्मनानुष्ठितेनापि व्रतेन न हि दुष्कृतिः ।\nपरावसोस्तव भ्रातुरतो नैवास्ति निष्कृतिः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003970060, "chapter_id": 23970, "verse_number": "३-१-३३-६१", "content_sanskrit": "अतोऽस्माभिरदुष्टत्वमस्मै दातुं न शक्यते ।\nअर्वावसुः पुनःप्राह देवानिंद्रपुरोगमान्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003970061, "chapter_id": 23970, "verse_number": "३-१-३३-६२", "content_sanskrit": "तथापि युष्मन्माहात्म्यात्प्रसादाद्भवतां तथा ।\nपितुर्ब्राह्मणहंतुर्मे भ्रातुस्त्रिदशसत्तमाः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003970062, "chapter_id": 23970, "verse_number": "३-१-३३-६३", "content_sanskrit": "यथा स्यान्निष्कृतिर्ब्रूत तथैव कृपया युताः ।\nएवमर्वावसोः श्रुत्वा वचस्ते त्रिदशालयाः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003970063, "chapter_id": 23970, "verse_number": "३-१-३३-६४", "content_sanskrit": "ध्यात्वा तु सुचिरं कालं विनिश्चित्येदमबुवन् ।\nउपायं ते प्रवक्ष्यामस्तत्पातकनिवारणम्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003970064, "chapter_id": 23970, "verse_number": "३-१-३३-६५", "content_sanskrit": "दक्षिणांबुनिधौ पुण्ये रामसेतौ विमुक्तिदे ।\nधनुष्कोटिरिति ख्यातं तीर्थमस्ति विमुक्तिदम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003970065, "chapter_id": 23970, "verse_number": "३-१-३३-६६", "content_sanskrit": "ब्रह्महत्यासुरापानस्वर्णस्तेयविनाशनम् ।\nगुरुतल्पगसंसर्गदोषाणामपि नाशनम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003970066, "chapter_id": 23970, "verse_number": "३-१-३३-६७", "content_sanskrit": "अकामेनापि यः स्नायादपवर्गफलप्रदम् ।\nदुःस्वप्ननाशनं धन्यं नरकक्लेशनाशनम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003970067, "chapter_id": 23970, "verse_number": "३-१-३३-६८", "content_sanskrit": "कैलासादिपदप्राप्तिकारणं परमार्थदम् ।\nसर्वकाममिदं पुंसामृणदारिद्र्यनाशनम्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003970068, "chapter_id": 23970, "verse_number": "३-१-३३-६९", "content_sanskrit": "धनुष्कोटिर्धनु ष्कोटिर्धनुष्कोटिरितीरणात् ।\nस्वर्गापवर्गदं पुंसां महापुण्यफलप्रदम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003970069, "chapter_id": 23970, "verse_number": "३-१-३३-७०", "content_sanskrit": "तत्र गत्वा तव भ्राता स्नायाद्यदि परावसुः ।\nतत्क्षणादेव ते ज्येष्ठो मुच्यते ब्रह्महत्यया॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003970070, "chapter_id": 23970, "verse_number": "३-१-३३-७१", "content_sanskrit": "इदं रहस्यं सुमहत्प्रायश्चित्तमुदीरितम् ।\nउक्त्वेत्यर्वावसुं देवाः प्रययुः स्वपुरीं प्रति॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003970071, "chapter_id": 23970, "verse_number": "३-१-३३-७२", "content_sanskrit": "तत अर्वावसुर्ज्येष्ठं समादाय परावसुम् ।\nरामचन्द्रधनुष्कोटिं प्रययौ मुक्तिदायिनीम्॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003970072, "chapter_id": 23970, "verse_number": "३-१-३३-७३", "content_sanskrit": "सेतौ संकल्पमुक्त्वा तु नियमेन परावसुः ।\nसह भ्रात्रा धनुष्कोटौ सस्नौ पातकशुद्धये॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003970073, "chapter_id": 23970, "verse_number": "३-१-३३-७४", "content_sanskrit": "स्नात्वोत्थितं धनुष्कोटौ तं प्रोवाचाशरीरिणी ।\nपरावसो विनष्टा ते पितुर्ब्राह्मणघातजा॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003970074, "chapter_id": 23970, "verse_number": "३-१-३३-७५", "content_sanskrit": "ब्रह्महत्या महा घोरा नरकक्लेशकारिणी ।\nइत्युक्त्वा विररामाथ सापि वागशरीरिणी॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003970075, "chapter_id": 23970, "verse_number": "३-१-३३-७६", "content_sanskrit": "परावसुस्तदा विप्राः कनिष्ठेन समन्वितः ।\nरामचन्द्रधनुष्कोटिं प्रणम्य च सभक्तिकम्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003970076, "chapter_id": 23970, "verse_number": "३-१-३३-७७", "content_sanskrit": "रामनाथं महादेवं नत्वा भक्तिपुरःसरम् ।\nविमुक्तपातको विप्राः प्रययौ पितुराश्रमम्॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003970077, "chapter_id": 23970, "verse_number": "३-१-३३-७८", "content_sanskrit": "मृत्वोत्थितस्तदा रैभ्यो दृष्ट्वा पुत्रौ समागतौ ।\nसंतुष्टहृदयो ह्यास्ते पुत्राभ्यां स्वाश्रमे तदा॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003970078, "chapter_id": 23970, "verse_number": "३-१-३३-७९", "content_sanskrit": "रामचन्द्रधनुष्कोटौ स्नानेन हतपातकम् ।\nएनं परावसुं सर्वे स्वीचक्रुर्मुनयस्तदा॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003970079, "chapter_id": 23970, "verse_number": "३-१-३३-८०", "content_sanskrit": "एवं परावसोरुक्तं ब्रह्महत्याविमोक्षणम् ।\nस्नानमात्राद्धनुष्कोटौ युष्माकं मुनिपुंगवाः॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003970080, "chapter_id": 23970, "verse_number": "३-१-३३-८१", "content_sanskrit": "सुरा पानादयो विप्रा नश्यंत्येवात्र मज्जनात् ।\nसत्यंसत्यं पुनः सत्यमुद्धृत्य भुजमुच्यते॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003970081, "chapter_id": 23970, "verse_number": "३-१-३३-८२", "content_sanskrit": "महापातकसंघाश्च नश्येयुर्मज्जनादिह ।\nय इमं पठतेऽध्यायं ब्रह्महत्याविमोक्षणम्॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003970082, "chapter_id": 23970, "verse_number": "३-१-३३-८३", "content_sanskrit": "ब्रह्महत्या विनश्येत तत्क्षणान्नास्ति संशयः ।\nसुरापानादयोऽप्यस्य शांतिं गच्छेयुरंजसा॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}]