[{"id": 900002172, "chapter_id": 8256, "verse_number": "1.1", "content_sanskrit": "ओमित्येतदक्षरमुद्गीथमुपासीत", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900002173, "chapter_id": 8256, "verse_number": "1.2", "content_sanskrit": "ॐ समस्तस्य खलु साम्ना उपासनं साधु ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900002174, "chapter_id": 8256, "verse_number": "1.3", "content_sanskrit": "ॐ असौ वा आदित्यो देवमधु तस्य द्यौरेव तिरश्चीनवंशोऽन्तरिक्षमपूपो मरीचयः पुत्राः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900002175, "chapter_id": 8256, "verse_number": "1.4", "content_sanskrit": "ॐजानश्रुतिर्ह पौत्रायणः श्रद्धादेयो बहुदायी बहुवाक्य आस", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900002176, "chapter_id": 8256, "verse_number": "1.5", "content_sanskrit": "यो ह वै ज्येष्ठं च श्रेष्ठं च वेद ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900002177, "chapter_id": 8256, "verse_number": "1.6", "content_sanskrit": "ॐ श्वेतकेतुर्हारुणेय आस तं ह पितोवाच ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900002178, "chapter_id": 8256, "verse_number": "1.7", "content_sanskrit": "अधीहि भगव इति होपससाद सनत्कुमारं नारदस्तं होवाच..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900002179, "chapter_id": 8256, "verse_number": "1.8", "content_sanskrit": "ॐ अथ यदिदमस्मिन् ब्रह्मपुरे दहरं पुण्डरीकं वेश्म..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}]