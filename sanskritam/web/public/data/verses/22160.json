[{"id": 7002160000, "chapter_id": 22160, "verse_number": "२०५-१", "content_sanskrit": "अग्निरुवाच ।\nभीष्मपञ्चकमाख्यास्ये व्रतराजन्तु सर्वदं ।\nकार्त्तिकस्यामले पक्षे एकादश्यां समचरेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002160001, "chapter_id": 22160, "verse_number": "२०५-२", "content_sanskrit": "दिनानि पञ्चत्रिःस्नाती पञ्चव्रीहितिलैस्तथा ।\nतर्पयेद्देवपित्रादीन्मौनी सम्पूजयेद्धरिं ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002160002, "chapter_id": 22160, "verse_number": "२०५-३", "content_sanskrit": "पञ्चगव्येन संस्नाप्य देवं पञ्चामृतेन च ।\nचन्दनाद्यैः समालिप्य गुग्गुलुं सघृतन्दहेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002160003, "chapter_id": 22160, "verse_number": "२०५-४", "content_sanskrit": "दीपं दद्याद्दिवारात्रौ नैवेद्यं परमान्नकं ।\nॐ नमो वासुदेवाय जपेदष्टोत्तरं शतं ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002160004, "chapter_id": 22160, "verse_number": "२०५-५", "content_sanskrit": "जुहुयाच्च घृताभ्यक्तांस्तिलव्रीहींस्ततो व्रती ।\nषडक्षरेण मन्त्रेण स्वाहाकारान्वितेन च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002160005, "chapter_id": 22160, "verse_number": "२०५-६", "content_sanskrit": "कमलैः पूजयेत्पादौ द्वितीये बिल्वपत्रकैः ।\nजानु सक्थि तृतीयेऽथ नाभिं भृङ्गरजेन तु ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002160006, "chapter_id": 22160, "verse_number": "२०५-७", "content_sanskrit": "वाणबिल्वजवाभिस्तु चतुर्थे पञ्चमेऽहनि ।\nमालत्या भूमिशायी स्यादेकादश्यान्तु गोमयं ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002160007, "chapter_id": 22160, "verse_number": "२०५-८", "content_sanskrit": "गोमूत्रं दधि दुग्धं च पञ्चमे पञ्चगव्यकं ।\nपौर्णमास्याञ्चरेन्नक्तं भुक्तिं मुक्तिं लभेद्व्रती ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002160008, "chapter_id": 22160, "verse_number": "२०५-९", "content_sanskrit": "भीष्मः कृत्वा हरिं प्राप्तस्तेनैव भीष्मपञ्चकं ।\nब्राह्मणः पूजनाद्यैश्च उपवासादिकं व्रतं ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]