[{"id": 7001265000, "chapter_id": 21265, "verse_number": "२-५-३८-१", "content_sanskrit": "उपमन्युरुवाच ।\nआलस्यं व्याधयस्तीव्राः प्रमादः स्थानसंशयः ।\nअनवस्थितचित्तत्वमश्रद्धा भ्रांतिदर्शनम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001265001, "chapter_id": 21265, "verse_number": "२-५-३८-२", "content_sanskrit": "दुःखानि दौर्मनस्यं च विषयेषु च लोलता ।\nदशैते युञ्जतां पुंसामन्तरायाः प्रकीर्तिताः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001265002, "chapter_id": 21265, "verse_number": "२-५-३८-३", "content_sanskrit": "आलस्यमलसत्त्वं तु योगिनां देहचेतनोः ।\nधातुवैषम्यजा दोषा व्याधयः कर्मदोषजाः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001265003, "chapter_id": 21265, "verse_number": "२-५-३८-४", "content_sanskrit": "प्रमादो नाम योगस्य साधना नाम भावना ।\nइदं वेत्युभयाक्रान्तं विज्ञानं स्थानसंशयः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001265004, "chapter_id": 21265, "verse_number": "२-५-३८-५", "content_sanskrit": "अप्रतिष्ठा हि मनसस्त्वनवस्थितिरुच्यते ।\nअश्रद्धा भावरहिता वृत्तिर्वै योगवर्त्मनि॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001265005, "chapter_id": 21265, "verse_number": "२-५-३८-६", "content_sanskrit": "विपर्यस्ता मतिर्या सा भ्रांतिरित्यभिधीयते ।\nदुःखमज्ञानजं पुंसां चित्तस्याध्यात्मिकं विदुः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001265006, "chapter_id": 21265, "verse_number": "२-५-३८-७", "content_sanskrit": "आधिभौतिकमंगोत्थं यच्च दुःखं पुरा कृतैः ।\nआधिदैविकमाख्यातमशन्यस्त्रविषादिकम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001265007, "chapter_id": 21265, "verse_number": "२-५-३८-८", "content_sanskrit": "इच्छाविघातजं मोक्षं दौर्मनस्यं प्रचक्षते ।\nविषयेषु विचित्रेषु विभ्रमस्तत्र लोलता॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001265008, "chapter_id": 21265, "verse_number": "२-५-३८-९", "content_sanskrit": "शान्तेष्वेतेषु विघ्नेषु योगासक्तस्य योगिनः ।\nउपसर्गाः प्रवर्तंते दिव्यास्ते सिद्धिसूचकाः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001265009, "chapter_id": 21265, "verse_number": "२-५-३८-१०", "content_sanskrit": "प्रतिभा श्रवणं वार्ता दर्शनास्वादवेदनाः ।\nउपसर्गाः षडित्येते व्यये योगस्य सिद्धयः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001265010, "chapter_id": 21265, "verse_number": "२-५-३८-११", "content_sanskrit": "सूक्ष्मे व्यवहिते ऽतीते विप्रकृष्टे त्वनागते ।\nप्रतिभा कथ्यते यो ऽर्थे प्रतिभासो यथातथम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001265011, "chapter_id": 21265, "verse_number": "२-५-३८-१२", "content_sanskrit": "श्रवणं सर्वशब्दानां श्रवणे चाप्रयत्नतः ।\nवार्त्ता वार्त्तासु विज्ञानं सर्वेषामेव देहिनाम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001265012, "chapter_id": 21265, "verse_number": "२-५-३८-१३", "content_sanskrit": "दर्शनं नाम दिव्यानां दर्शनं चाप्रयत्नतः ।\nतथास्वादश्च दिव्येषु रसेष्वास्वाद उच्यते॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001265013, "chapter_id": 21265, "verse_number": "२-५-३८-१४", "content_sanskrit": "स्पर्शनाधिगमस्तद्वद्वेदना नाम विश्रुता ।\nगन्धादीनां च दिव्यानामाब्रह्मभुवनाधिपाः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001265014, "chapter_id": 21265, "verse_number": "२-५-३८-१५", "content_sanskrit": "संतिष्ठन्ते च रत्नानि प्रयच्छंति बहूनि च ।\nस्वच्छन्दमधुरा वाणी विविधास्यात्प्रवर्तते॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001265015, "chapter_id": 21265, "verse_number": "२-५-३८-१६", "content_sanskrit": "रसायनानि सर्वाणि दिव्याश्चौषधयस्तथा ।\nसिध्यंति प्रणिपत्यैनं दिशंति सुरयोषितः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001265016, "chapter_id": 21265, "verse_number": "२-५-३८-१७", "content_sanskrit": "योगसिद्ध्यैकदेशे ऽपि दृष्टे मोक्षे भवेन्मतिः ।\nदृष्टमेतन्मया यद्वत्तद्वन्मोक्षो भवेदिति॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001265017, "chapter_id": 21265, "verse_number": "२-५-३८-१८", "content_sanskrit": "कृशता स्थूलता बाल्यं वार्धक्यं चैव यौवनम् ।\nनानाचातिस्वरूपं च चतुर्णां देहधारणम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001265018, "chapter_id": 21265, "verse_number": "२-५-३८-१९", "content_sanskrit": "पार्थिवांशं विना नित्यं सुरभिर्गन्धसंग्रहः ।\nएवमष्टगुणं प्राहुः पैशाचं पार्थिवं पदम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001265019, "chapter_id": 21265, "verse_number": "२-५-३८-२०", "content_sanskrit": "जले निवसनं चैव भूम्यामेवं विनिर्गमः ।\nइच्छेच्छक्तः स्वयं पातुं समुद्रमपि नातुरः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001265020, "chapter_id": 21265, "verse_number": "२-५-३८-२१", "content_sanskrit": "यत्रेच्छति जगत्यस्मिंस्तत्रैव जलदर्शनम् ।\nविना कुम्भादिकं पाणौ जलसञ्चयधारणम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001265021, "chapter_id": 21265, "verse_number": "२-५-३८-२२", "content_sanskrit": "यद्वस्तु विरसञ्चापि भोक्तुमिच्छति तत्क्षणात् ।\nरसादिकं भवेच्चान्यत्त्रयाणां देहधारणम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001265022, "chapter_id": 21265, "verse_number": "२-५-३८-२३", "content_sanskrit": "निर्व्रणत्वं शरीरस्य पार्थिवैश्च समन्वितम् ।\nतदिदं षोडशगुणमाप्यमैश्वर्यमद्भुतम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001265023, "chapter_id": 21265, "verse_number": "२-५-३८-२४", "content_sanskrit": "शरीरादग्निनिर्माणं तत्तापभयवर्जनम् ।\nशक्तिर्जगदिदं दग्धुं यदीच्छेदप्रयत्नतः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001265024, "chapter_id": 21265, "verse_number": "२-५-३८-२५", "content_sanskrit": "स्थापनं वानलस्या ऽप्सु पाणौ पावकधारणम् ।\nदग्धे सर्गे यथापूर्वं मुखे चान्नादिपाचनम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001265025, "chapter_id": 21265, "verse_number": "२-५-३८-२६", "content_sanskrit": "द्वाभ्यां देहविनिर्माणमाप्यैश्वर्यसमन्वितम् ।\nएतच्चतुर्विंशतिधा तैजसं परिचक्षते॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001265026, "chapter_id": 21265, "verse_number": "२-५-३८-२७", "content_sanskrit": "मनोजवत्वं भूतानां क्षणादन्तःप्रवेशनम् ।\nपर्वतादिमहाभारधारणञ्चाप्रयत्नतः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001265027, "chapter_id": 21265, "verse_number": "२-५-३८-२८", "content_sanskrit": "गुरुत्वञ्च लघुत्वञ्च पाणावनिलधारणम् ।\nअंगुल्यग्रनिपाताद्यैर्भूमेरपि च कम्पनम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001265028, "chapter_id": 21265, "verse_number": "२-५-३८-२९", "content_sanskrit": "एकेन देहनिष्पत्तिर्युक्तं भोगैश्च तैजसैः ।\nद्वात्रिंशद्गुणमैश्वर्यं मारुतं कवयो विदुः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001265029, "chapter_id": 21265, "verse_number": "२-५-३८-३०", "content_sanskrit": "छायाहीनविनिष्पत्तिरिन्द्रियाणामदर्शनम् ।\nखेचरत्वं यथाकाममिन्द्रियार्थसमन्वयः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001265030, "chapter_id": 21265, "verse_number": "२-५-३८-३१", "content_sanskrit": "आकाशलंघनं चैव स्वदेहे तन्निवेशनम् ।\nआकाशपिण्डीकरणमशरीरत्वमेव च॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001265031, "chapter_id": 21265, "verse_number": "२-५-३८-३२", "content_sanskrit": "अनिलैश्वर्यसंयुक्तं चत्वारिंशद्गुणं महत् ।\nऐन्द्रमैश्वर्यमाख्यातमाम्बरं तत्प्रचक्षते॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001265032, "chapter_id": 21265, "verse_number": "२-५-३८-३३", "content_sanskrit": "यथाकामोपलब्धिश्च यथाकामविनिर्गमः ।\nसर्वस्याभिभवश्चैव सर्वगुह्यार्थदर्शनम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001265033, "chapter_id": 21265, "verse_number": "२-५-३८-३४", "content_sanskrit": "कर्मानुरूपनिर्माणं वशित्वं प्रियदर्शनम् ।\nसंसारदर्शनं चैव भोगैरैन्द्रैस्समन्वितम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001265034, "chapter_id": 21265, "verse_number": "२-५-३८-३५", "content_sanskrit": "एतच्चांद्रमसैश्वर्यं मानसं गुणतो ऽधिकम् ।\nछेदनं ताडनं चैव बंधनं मोचनं तथा॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001265035, "chapter_id": 21265, "verse_number": "२-५-३८-३६", "content_sanskrit": "ग्रहणं सर्वभूतानां संसारवशवर्तिनाम् ।\nप्रसादश्चापि सर्वेषां मृत्युकालजयस्तथा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001265036, "chapter_id": 21265, "verse_number": "२-५-३८-३७", "content_sanskrit": "आभिमानिकमैश्वर्यं प्राजापत्यं प्रचक्षते ।\nएतच्चान्द्रमसैर्भोगैः षट्पञ्चाशद्गुणं महत्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001265037, "chapter_id": 21265, "verse_number": "२-५-३८-३८", "content_sanskrit": "सर्गः संकल्पमात्रेण त्राणं संहरणं तथा ।\nस्वाधिकारश्च सर्वेषां भूतचित्तप्रवर्तनम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001265038, "chapter_id": 21265, "verse_number": "२-५-३८-३९", "content_sanskrit": "असादृश्यं च सर्वस्य निर्माणं जगतः पृथक् ।\nशुभाशुभस्य करणं प्राजापत्यैश्च संयुतम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001265039, "chapter_id": 21265, "verse_number": "२-५-३८-४०", "content_sanskrit": "चतुष्षष्ठिगुणं ब्राह्ममैश्वर्यं च प्रचक्षते ।\nबौद्धादस्मात्परं गौणमैश्वर्यं प्राकृतं विदुः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001265040, "chapter_id": 21265, "verse_number": "२-५-३८-४१", "content_sanskrit": "वैष्णवं तत्समाख्यातं तस्यैव भुवनस्थितिः ।\nब्रह्मणा तत्पदं सर्वं वक्तुमन्यैर्न शक्यते॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001265041, "chapter_id": 21265, "verse_number": "२-५-३८-४२", "content_sanskrit": "तत्पौरुषं च गौणं च गणेशं पदमैश्वरम् ।\nविष्णुना तत्पदं किंचिज्ज्ञातुमन्यैर्न शक्यते॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001265042, "chapter_id": 21265, "verse_number": "२-५-३८-४३", "content_sanskrit": "विज्ञानसिद्धयश्चैव सर्वा एवौपसर्गिकाः ।\nनिरोद्धव्या प्रयत्नेन वर्राग्येण परेण तु॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001265043, "chapter_id": 21265, "verse_number": "२-५-३८-४४", "content_sanskrit": "प्रतिभासेष्वशुद्धेषु गुणेष्वासक्तचेतसः ।\nन सिध्येत्परमैश्वर्यमभयं सार्वकामिकम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001265044, "chapter_id": 21265, "verse_number": "२-५-३८-४५", "content_sanskrit": "तस्माद्गुणांश्च भोगांश्च देवासुरमहीभृताम् ।\nतृणवद्यस्त्यजेत्तस्य योगसिद्धिः परा भवेत्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001265045, "chapter_id": 21265, "verse_number": "२-५-३८-४६", "content_sanskrit": "अथवानुग्रहेच्छायां जगतो विचरेन्मुनिः ।\nयथाकामंगुणान्भोगान्भुक्त्वा मुक्तिं प्रयास्यति॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001265046, "chapter_id": 21265, "verse_number": "२-५-३८-४७", "content_sanskrit": "अथ प्रयोगं योगस्य वक्ष्ये शृणु समाहितः ।\nशुभे काले शुभे देशे शिवक्षेत्रादिके पुनः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001265047, "chapter_id": 21265, "verse_number": "२-५-३८-४८", "content_sanskrit": "विजने जंतुरहिते निःशब्दे बाधवर्जिते ।\nसुप्रलिप्ते स्थले सौम्ये गन्धधूपादिवासिते॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001265048, "chapter_id": 21265, "verse_number": "२-५-३८-४९", "content_sanskrit": "मुक्तपुष्पसमाकीर्णे वितानादि विचित्रिते ।\nकुशपुष्पसमित्तोयफलमूलसमन्विते॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001265049, "chapter_id": 21265, "verse_number": "२-५-३८-५०", "content_sanskrit": "नाग्न्यभ्याशे जलाभ्याशे शुष्कपर्णचये ऽपि वा ।\nन दंशमशकाकीर्णे सर्पश्वापदसंकुले॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001265050, "chapter_id": 21265, "verse_number": "२-५-३८-५१", "content_sanskrit": "न च दुष्टमृगाकीर्णे न भये दुर्जनावृते ।\nश्मशाने चैत्यवल्मीके जीर्णागारे चतुष्पथे॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001265051, "chapter_id": 21265, "verse_number": "२-५-३८-५२", "content_sanskrit": "नदीनदसमुद्राणां तीरे रथ्यांतरे ऽपि वा ।\nन जीर्णोद्यानगोष्ठादौ नानिष्टे न च निंदिते॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001265052, "chapter_id": 21265, "verse_number": "२-५-३८-५३", "content_sanskrit": "नाजीर्णाम्लरसोद्गारे न च विण्मूत्रदूषिते ।\nनच्छर्द्यामातिसारे वा नातिभुक्तौ श्रमान्विते॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001265053, "chapter_id": 21265, "verse_number": "२-५-३८-५४", "content_sanskrit": "न चातिचिंताकुलितो न चातिक्षुत्पिपासितः ।\nनापि स्वगुरुकर्मादौ प्रसक्तो योगमाचरेत्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001265054, "chapter_id": 21265, "verse_number": "२-५-३८-५५", "content_sanskrit": "युक्ताहारविहारश्च युक्तचेष्टश्च कर्मसु ।\nयुक्तनिद्राप्रबोधश्च सर्वायासविवर्जितः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001265055, "chapter_id": 21265, "verse_number": "२-५-३८-५६", "content_sanskrit": "आसनं मृदुलं रम्यं विपुलं सुसमं शुचि ।\nपद्मकस्वस्तिकादीनामभ्यसेदासनेषु च॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001265056, "chapter_id": 21265, "verse_number": "२-५-३८-५७", "content_sanskrit": "अभिवंद्य स्वगुर्वंतानभिवाद्याननुक्रमात् ।\nऋजुग्रीवशिरोवक्षा नातिष्ठेच्छिष्टलोचनः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001265057, "chapter_id": 21265, "verse_number": "२-५-३८-५८", "content_sanskrit": "किंचिदुन्नामितशिरा दंतैर्दंतान्न संस्पृशेत् ।\nदंताग्रसंस्थिता जिह्वामचलां सन्निवेश्य च॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001265058, "chapter_id": 21265, "verse_number": "२-५-३८-५९", "content_sanskrit": "पार्ष्णिभ्यां वृषणौ रक्षंस्तथा प्रजननं पुनः ।\nऊर्वोरुपरि संस्थाप्य बाहू तिर्यगयत्नतः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001265059, "chapter_id": 21265, "verse_number": "२-५-३८-६०", "content_sanskrit": "दक्षिणं करपृष्ठं तु न्यस्य वामतलोपरि ।\nउन्नाम्य शनकैः पृष्ठमुरो विष्टभ्य चाग्रतः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001265060, "chapter_id": 21265, "verse_number": "२-५-३८-६१", "content_sanskrit": "संप्रेक्ष्य नासिकाग्रं स्वं दिशश्चानवलोकयन् ।\nसंभृतप्राणसंचारः पाषाण इव निश्चलः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001265061, "chapter_id": 21265, "verse_number": "२-५-३८-६२", "content_sanskrit": "स्वदेहायतनस्यांतर्विचिंत्य शिवमंबया ।\nहृत्पद्मपीठिकामध्ये ध्यानयज्ञेन पूजयेत्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001265062, "chapter_id": 21265, "verse_number": "२-५-३८-६३", "content_sanskrit": "मूले नासाग्रतो नाभौ कंठे वा तालुरंध्रयोः ।\nभ्रूमध्ये द्वारदेशे वा ललाटे मूर्ध्नि वा स्मरेत्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001265063, "chapter_id": 21265, "verse_number": "२-५-३८-६४", "content_sanskrit": "परिकल्प्य यथान्यायं शिवयोः परमासनम् ।\nतत्र सावरणं वापि निरावरणमेव वा॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001265064, "chapter_id": 21265, "verse_number": "२-५-३८-६५", "content_sanskrit": "द्विदलेषोडशारे वा द्वादशारे यथाविधि ।\nदशारे वा षडस्रे वा चतुरस्रे शिवं स्मरेत्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001265065, "chapter_id": 21265, "verse_number": "२-५-३८-६६", "content_sanskrit": "भ्रुवोरंतरतः पद्मं द्विदलं तडिदुज्ज्वलम् ।\nभ्रूमध्यस्थारविन्दस्य क्रमाद्वै दक्षिणोत्तरे॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001265066, "chapter_id": 21265, "verse_number": "२-५-३८-६७", "content_sanskrit": "विद्युत्समानवर्णे च पर्णे वर्णावसानके ।\nषोडशारस्य पत्राणि स्वराः षोडश तानि वै॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001265067, "chapter_id": 21265, "verse_number": "२-५-३८-६८", "content_sanskrit": "पूर्वादीनि क्रमादेतत्पद्मं कन्दस्य मूलतः ।\nककारादिटकारांता वर्णाः पर्णान्यनुक्रमात्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001265068, "chapter_id": 21265, "verse_number": "२-५-३८-६९", "content_sanskrit": "भानुवर्णस्य पद्मस्य ध्येयं तद्१ हृदयान्तरे ।\nगोक्षीरधवलस्योक्ता डादिफान्ता यथाक्रमम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001265069, "chapter_id": 21265, "verse_number": "२-५-३८-७०", "content_sanskrit": "अधो दलस्याम्बुजस्य एतस्य २ च दलानि षट् ।\nविधूमांगारवर्णस्य वर्णा वाद्याश्च लान्तिमाः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001265070, "chapter_id": 21265, "verse_number": "२-५-३८-७१", "content_sanskrit": "मूलाधारारविंदस्य हेमाभस्य यथाक्रमम् ।\nवकारादिसकारान्ता वर्णाः पर्णमयाः स्थिताः॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001265071, "chapter_id": 21265, "verse_number": "२-५-३८-७२", "content_sanskrit": "एतेष्वथारविंदेषु यत्रैवाभिरतं मनः ।\nतत्रैव देवं देवीं च चिंतयेद्धीरया धिया॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001265072, "chapter_id": 21265, "verse_number": "२-५-३८-७३", "content_sanskrit": "अंगुष्ठमात्रममलं दीप्यमानं समंततः ।\nशुद्धदीपशिखाकारं स्वशक्त्या पूर्णमण्डितम्॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001265073, "chapter_id": 21265, "verse_number": "२-५-३८-७४", "content_sanskrit": "इन्दुरेखासमाकारं तारारूपमथापि वा ।\nनीवारशूकस्सदृशं बिससुत्राभमेव वा॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001265074, "chapter_id": 21265, "verse_number": "२-५-३८-७५", "content_sanskrit": "कदम्बगोलकाकारं तुषारकणिकोपमम् ।\nक्षित्यादितत्त्वविजयं ध्याता यद्यपि वाञ्छति॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001265075, "chapter_id": 21265, "verse_number": "२-५-३८-७६", "content_sanskrit": "तत्तत्तत्त्वाधिपामेव मूर्तिं स्थूलां विचिंतयेत् ।\nसदाशिवांता ब्रह्माद्यभवाद्याश्चाष्टमूर्तयः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001265076, "chapter_id": 21265, "verse_number": "२-५-३८-७७", "content_sanskrit": "शिवस्य मूर्तयः स्थूलाः शिवशास्त्रे विनिश्चिताः ।\nघोरा मिश्रा प्रशान्ताश्च मूर्तयस्ता मुनीश्वरैः॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001265077, "chapter_id": 21265, "verse_number": "२-५-३८-७८", "content_sanskrit": "फलाभिलाषरहितैश्चिन्त्याश्चिन्ताविशारदैः ।\nघोराश्चेच्चिंतिताः कुर्युः पापरोगपरिक्षयम्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001265078, "chapter_id": 21265, "verse_number": "२-५-३८-७९", "content_sanskrit": "चिरेण मिश्रे सौम्ये तु न सद्यो न चिरादपि ।\nसौम्ये मुक्तिर्विशेषेण शांतिः प्रज्ञा प्रसिध्यति॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001265079, "chapter_id": 21265, "verse_number": "२-५-३८-८०", "content_sanskrit": "सिध्यंति सिद्धयश्चात्र क्रमशो नात्र संशयः॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]