[{"id": 7001793000, "chapter_id": 21793, "verse_number": "२-५४-१", "content_sanskrit": "वसुरुवाच ।\nइत्थं स्तुतस्तदा तेन प्रसन्नो गरुडध्वजः ।\nददौ तस्मै तु सुभगे सकलं मनसेप्सितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001793001, "chapter_id": 21793, "verse_number": "२-५४-२", "content_sanskrit": "यः संपूज्य जगन्नाथं प्रत्यहं स्तौति मानवः ।\nस्तोत्रेणानेन मतिमान्समोक्षं लभते ध्रुवम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001793002, "chapter_id": 21793, "verse_number": "२-५४-३", "content_sanskrit": "त्रिसंध्यं यो जपेद्विद्वानिमं स्तोत्रवरं शुचिः ।\nधर्मं चार्थं च कामं च मोक्षं च लभते नरः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001793003, "chapter_id": 21793, "verse_number": "२-५४-४", "content_sanskrit": "यः पठेच्छृणुयाद्वापि श्रावयेद्वा समाहितः ।\nस लोकं शाश्वतं विष्णोर्याति निर्द्ध्रूतकल्मषः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001793004, "chapter_id": 21793, "verse_number": "२-५४-५", "content_sanskrit": "धन्यं पापहरं चेदं भुक्तिमुक्तिप्रदं शिवम् ।\nगुह्यं सुदुर्लभं पुण्यं न देयं यस्य कस्य चित् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001793005, "chapter_id": 21793, "verse_number": "२-५४-६", "content_sanskrit": "न नास्तिकाय मूर्खाय न कृतघ्नाय मानिने ।\nन दुष्टमतये दद्यान्नाभक्ताय कदाचन ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001793006, "chapter_id": 21793, "verse_number": "२-५४-७", "content_sanskrit": "दातव्यं भक्तियुक्ताय गुणशीलान्विताय च ।\nविष्णुभक्ताय शांताय श्रद्धानुष्ठानशीलिने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001793007, "chapter_id": 21793, "verse_number": "२-५४-८", "content_sanskrit": "इदं समस्ताघविनाशहेतु कारुण्यसंज्ञं सुखमोक्षदं च ।\nअशेषवांछाफलदं वरिष्ठ स्तोत्रं मयोक्तं पुरुषोत्तमस्य ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001793008, "chapter_id": 21793, "verse_number": "२-५४-९", "content_sanskrit": "ये तं सुसूक्ष्मं विमलांम्बराभं ध्यायंति नित्यं पुरुषं पुराणम् ।\nते मुक्तिभाजः प्रविशंति विष्णुं मन्त्रैर्यथाज्यं हुतमध्वराग्नौ ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001793009, "chapter_id": 21793, "verse_number": "२-५४-१०", "content_sanskrit": "एकः स देवो भवदुःखहंता परः परेषां न ततोऽस्ति चान्यः ।\nस्रष्टा स पाता सकलांतकर्ता विष्णुः समश्चाखिलसारभूतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001793010, "chapter_id": 21793, "verse_number": "२-५४-११", "content_sanskrit": "किं विद्यया किं सुगुणैश्च तेषां यज्ञैश्च दानैश्च तपोभिरुग्रैः ।\nयेषां न भक्तिर्भवतीह कृष्णे जगद्गुरौ मोक्षसुखप्रदे च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001793011, "chapter_id": 21793, "verse_number": "२-५४-१२", "content_sanskrit": "लोके स धन्यः स शुचिः स विद्वान्स एव वक्ता स च धर्मशीलः ।\nज्ञाता स दाता स च सत्यवक्ता यस्यास्ति भक्तिः पुरुषोत्तमाख्ये ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001793012, "chapter_id": 21793, "verse_number": "२-५४-१३", "content_sanskrit": "स्तुत्वैवं ब्रह्मतनयः प्रणम्य च सनातनम् ।\nवासुदेवं जगन्नाथं सर्वकामफलप्रदम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001793013, "chapter_id": 21793, "verse_number": "२-५४-१४", "content_sanskrit": "चिंताविष्टो महीपालः कुशानास्तीर्य भूतले ।\nवस्त्रं च तन्मना भूत्वा सुष्वाप धरणीतले ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001793014, "chapter_id": 21793, "verse_number": "२-५४-१५", "content_sanskrit": "कथं प्रत्यक्षमभ्येति देवदेवो जनार्दनः ।\nमम चिंताहरो देवः कदासाविति चिंतयन् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001793015, "chapter_id": 21793, "verse_number": "२-५४-१६", "content_sanskrit": "सुप्तस्य तस्य नृपतेर्वासुदेवो जगद्गुरुः ।\nआत्मानं दर्शयामास स्वप्ने तस्मै च चक्रधृक् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001793016, "chapter_id": 21793, "verse_number": "२-५४-१७", "content_sanskrit": "स ददर्श च तं स्वप्नेदेवदेवं जगत्पतिम् ।\nशंखचक्रधरं शांतं गदापद्माग्रपाणिनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001793017, "chapter_id": 21793, "verse_number": "२-५४-१८", "content_sanskrit": "शार्ङ्गवाणासियुक्तं च ज्वलत्तेजोग्रमंडलम्  ।\nयुगांतादित्यवर्णाभं नीलवैडूर्यसन्निभम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001793018, "chapter_id": 21793, "verse_number": "२-५४-१९", "content_sanskrit": "सुपर्णपृष्ठमासीनं षोडशार्द्धभुजं विभुम् ।\nस चासौ प्राब्रवीद्वीक्ष्य साधु राजन्महामते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001793019, "chapter_id": 21793, "verse_number": "२-५४-२०", "content_sanskrit": "क्रतुनानेन दिव्येन तथा भक्त्या च श्रद्धया ।\nतुष्टोऽस्मि ते महीपाल वृथा किमनुशोचसि ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001793020, "chapter_id": 21793, "verse_number": "२-५४-२१", "content_sanskrit": "यदत्र प्रतिमा राजन्राजपूज्या सनातनी ।\nयथा तां प्राप्नुया भूप तदुपायं ब्रवीमि ते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001793021, "chapter_id": 21793, "verse_number": "२-५४-२२", "content_sanskrit": "गतायामद्य शर्वर्यां निर्मले भास्करोदये ।\nसागरस्य जलस्यांते नानाद्रुमविभूषिते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001793022, "chapter_id": 21793, "verse_number": "२-५४-२३", "content_sanskrit": "जलं तथैव वेलायां दृश्यते यत्र वै महत् ।\nलव?णस्योदधे राजंस्तरंगैः समभिप्लुतम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001793023, "chapter_id": 21793, "verse_number": "२-५४-२४", "content_sanskrit": "कूलालंबी महावृक्षः स्थितः स्थलजलेषु च ।\nवेलाभिर्हन्यमानश्च न चासौ कंपते ध्रुवः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001793024, "chapter_id": 21793, "verse_number": "२-५४-२५", "content_sanskrit": "हस्तेन पुर्शुमादाय ऊर्मेरंतस्ततो व्रज ।\nएकाकी विहरन्राजन्यं त्वं पश्यसि पादपम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001793025, "chapter_id": 21793, "verse_number": "२-५४-२६", "content_sanskrit": "इदं चिह्नं समालोक्य च्छेदयत्वमशंकितः ।\nशात्यमानं तु तं वृक्षं प्रांशुमद्भुतदर्शनम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001793026, "chapter_id": 21793, "verse_number": "२-५४-२७", "content_sanskrit": "दृष्ट्वा तेनैव संचिंत्य तदा भूपाल दर्शनम् ।\nकुरु तत्प्रतिमां दिव्यां जहिचिंतां विमोहिनीम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001793027, "chapter_id": 21793, "verse_number": "२-५४-२८", "content_sanskrit": "एवमुक्त्वा महाभागो जगामादर्शनं हरिः ।\nस चापि स्वप्नमालक्ष्य परं विस्मयमागतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001793028, "chapter_id": 21793, "verse_number": "२-५४-२९", "content_sanskrit": "तां निशां समुदीक्षन्स ततस्तद्गतमानसः ।\nव्याहरन्वैष्णवान्मन्त्रान्सूक्तं चैव तदात्मकम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001793029, "chapter_id": 21793, "verse_number": "२-५४-३०", "content_sanskrit": "प्रभातायां रजन्यां तु तद्गतोऽनन्यमानसः ।\nस स्नात्वा सागरे सम्यग्यथावद्विधिना ततः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001793030, "chapter_id": 21793, "verse_number": "२-५४-३१", "content_sanskrit": "दत्वा दानं तु विप्रेभ्यो ग्रामांश्च नगराणि च ।\nकृत्वा पौर्वाह्णिकं कर्म जगाम स नृपोत्तमः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001793031, "chapter_id": 21793, "verse_number": "२-५४-३२", "content_sanskrit": "न रथो न पदातिश्च न गजो न च सारथिः ।\nएकाकी स महावेलां प्रविवेश महीपतिः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001793032, "chapter_id": 21793, "verse_number": "२-५४-३३", "content_sanskrit": "तं ददर्श महावृक्षं तेजस्वंतं महाद्रुमम् ।\nमहांतकं महारोहं पुण्यं विफलमेव च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001793033, "chapter_id": 21793, "verse_number": "२-५४-३४", "content_sanskrit": "महोत्सवं महाकायं प्रसुप्तं च जलांतिके ।\nसांद्रमांजिष्ठवर्णाभं नाम जातिविवर्जितम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001793034, "chapter_id": 21793, "verse_number": "२-५४-३५", "content_sanskrit": "नरनाथस्तथा विष्णोर्द्रुमं दृष्ट्वा मुदान्वितः ।\nपर्शुना शातयामास शितेन च दृढेन च ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001793035, "chapter_id": 21793, "verse_number": "२-५४-३६", "content_sanskrit": "द्वैधीभूता मतिस्तत्र बभूवेंद्रसखस्य च ।\nनिरीक्षमाणे काष्ठे तु बभूवाद्भुतदर्शनम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001793036, "chapter_id": 21793, "verse_number": "२-५४-३७", "content_sanskrit": "विश्वकर्मा च विष्णुश्च विप्ररूपधरावुभौ ।\nआजग्मतुर्महात्मानौ तथा तुल्याग्रजन्मनौ ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001793037, "chapter_id": 21793, "verse_number": "२-५४-३८", "content_sanskrit": "ज्वलमानौ सुतेजोभिर्दिव्यस्रग्गंधलेपनौ ।\nअथ तौ तं समासाद्य नृपमिंद्रिसखं तदा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001793038, "chapter_id": 21793, "verse_number": "२-५४-३९", "content_sanskrit": "तावब्रूतां महाराज त्वं किमत्र करिष्यसि ।\nकिमयं ते महाबाहो शातितश्च वनस्पतिः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001793039, "chapter_id": 21793, "verse_number": "२-५४-४०", "content_sanskrit": "असहायो महादुर्गे निर्जने गहने वने ।\nमहासिंधुतटे चैव शातितो वै महाद्रुमः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001793040, "chapter_id": 21793, "verse_number": "२-५४-४१", "content_sanskrit": "तयोः श्रुत्वा वचः सुभ्रु स तु राजा मुदान्वितः ।\nबभाषे वचनान्याभ्यां मृदूनि मधुराणि च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001793041, "chapter_id": 21793, "verse_number": "२-५४-४२", "content_sanskrit": "दृष्ट्वा तौ ब्राह्मणौ तत्र चंद्रसूर्याविवागतौ ।\nनमस्कृत्य जगन्नाथाववाङ्मुखमवस्थितः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001793042, "chapter_id": 21793, "verse_number": "२-५४-४३", "content_sanskrit": "देव देवमनाद्यंतममेयं जगतः पतिम् ।\nआराधितुं वै प्रतिमां करोमीति मतिर्मम ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001793043, "chapter_id": 21793, "verse_number": "२-५४-४४", "content_sanskrit": "अहं स देवदेवेन परमेण महात्मना ।\nस्वप्नाते च समुद्दिष्टो भवद्भ्यां श्रावितो मया ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001793044, "chapter_id": 21793, "verse_number": "२-५४-४५", "content_sanskrit": "यज्ञस्तद्वचनं श्रुत्वा देवेन्द्रप्रतिमस्य च ।\nप्रहस्य तस्मै विश्वेशस्तुष्टो वचनमब्रवीत् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001793045, "chapter_id": 21793, "verse_number": "२-५४-४६", "content_sanskrit": "साधु साधु महीपाल यदेतन्मन उत्तमम् ।\nसंसारसागरे घोरे कंदलीदलसन्निभे ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001793046, "chapter_id": 21793, "verse_number": "२-५४-४७", "content_sanskrit": "निःसारे दुःखबहुले कामक्रोधसमाकुले ।\nइंद्रियावर्तकलिले दुस्तरे लोमहर्षणे ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001793047, "chapter_id": 21793, "verse_number": "२-५४-४८", "content_sanskrit": "नानाव्याधिशतावर्ते चलबुद्‌बुदसन्निभे ।\nयतस्ते मतिरुत्पन्ना विष्णोराराधनाय वै ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001793048, "chapter_id": 21793, "verse_number": "२-५४-४९", "content_sanskrit": "धन्यस्त्वं नृपशार्दूल गुणैः सर्वैरलंकृतः ।\nसप्रजा धरणी धन्या सशैलवनपत्तना ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001793049, "chapter_id": 21793, "verse_number": "२-५४-५०", "content_sanskrit": "सपुरग्रामनगरा चतुर्वणैरलंकृता ।\nयत्र त्वं नृपशार्दूल प्रजापालयिता प्रभुः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001793050, "chapter_id": 21793, "verse_number": "२-५४-५१", "content_sanskrit": "एह्येहि त्वं महाभाग द्रुमेऽस्मिन्सुखशीतले ।\nआवाभ्यां सह तिष्ठ त्वं कथाभिर्द्धर्मसंश्रितः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001793051, "chapter_id": 21793, "verse_number": "२-५४-५२", "content_sanskrit": "अयं तव सहायार्थमागतः शिल्पिनां वरः ।\nविश्वकर्मसमः साक्षान्निपुणः सर्वकर्मसु ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001793052, "chapter_id": 21793, "verse_number": "२-५४-५३", "content_sanskrit": "मयोद्दिष्टां तु प्रतिमां करोत्येष तटं त्यज  ।\nश्रुत्वैवं वचनं तस्य तदा राजा द्विजन्मनः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001793053, "chapter_id": 21793, "verse_number": "२-५४-५४", "content_sanskrit": "सागरस्य तटं त्यक्त्वा गत्वा तस्य समीपतः ।\nतस्थौ स नृपतिश्रेष्ठो वृक्षच्छायां सुशीतलाम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001793054, "chapter_id": 21793, "verse_number": "२-५४-५५", "content_sanskrit": "ततस्तस्मै स विश्वात्मा तदाकारां तदाकृतिम् ।\nशिल्पिमुख्याय विधिजे कुरुष्वेत्यभ्यभाषत ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001793055, "chapter_id": 21793, "verse_number": "२-५४-५६", "content_sanskrit": "कृष्णरूपं परं शांतं पद्मपत्रायतेक्षणम् ।\nश्रीवत्सकौस्तुभधरं शंखचक्रगदाधरम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001793056, "chapter_id": 21793, "verse_number": "२-५४-५७", "content_sanskrit": "गौरं गोक्षीरवर्णाभे द्वितीयं स्वस्तिकांकितम् ।\nलांगलास्त्रधरं देवमनंताख्यं महाबलम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001793057, "chapter_id": 21793, "verse_number": "२-५४-५८", "content_sanskrit": "देवदानवगंधर्वयक्षविद्याधरोरगैः ।\nन विज्ञातो हि तस्यांतस्तेनानंत इति स्मृतः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001793058, "chapter_id": 21793, "verse_number": "२-५४-५९", "content_sanskrit": "भगिनीं वासुदेवस्य रुक्मवर्णां सुशोभनाम् ।\nतृतीयां वै सुभद्रां च सर्वलक्षणलक्षिताम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001793059, "chapter_id": 21793, "verse_number": "२-५४-६०", "content_sanskrit": "श्रुत्वैतद्वचनं तस्य विश्वकर्मा सुकर्मकृत् ।\nतत्क्षणात्कारयामास प्रतिमाः शुभलक्षणाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001793060, "chapter_id": 21793, "verse_number": "२-५४-६१", "content_sanskrit": "कुण्डलाभ्यां विचित्राभ्यां कर्णाभ्यां सुविराजिताः ।\nचक्रलांगलविन्यासहताभ्यां भानुसंमताः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001793061, "chapter_id": 21793, "verse_number": "२-५४-६२", "content_sanskrit": "प्रथमं शुक्लवर्णानां शारदेंदुसमप्रभम् ।\nसुरक्ताक्षं महाकायं फटाविकटमस्तकम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001793062, "chapter_id": 21793, "verse_number": "२-५४-६३", "content_sanskrit": "नीलांबरधरं चोग्रं बलमद्भुतकुंडलम् ।\nमहाहलधरं दिव्यं महामुसलधारिणम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001793063, "chapter_id": 21793, "verse_number": "२-५४-६४", "content_sanskrit": "द्वितीयं पुंडरीकाक्षं नीलजीमृतसन्निभम् ।\nअतसीपुष्पसंकाशं पद्मपत्रायतेक्षणम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001793064, "chapter_id": 21793, "verse_number": "२-५४-६५", "content_sanskrit": "श्रीवत्सवक्षसं भ्राजत्पीतवाससमच्युतम् ।\nचक्रकम्बुकरं दिव्यं सर्वपापहरं हरिम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001793065, "chapter_id": 21793, "verse_number": "२-५४-६६", "content_sanskrit": "तृतीयां स्वर्णवर्णाभां पद्मपत्रायतेक्षणाम् ।\nविचित्रवस्त्रसंछन्नां हारकेयूरभूषिताम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001793066, "chapter_id": 21793, "verse_number": "२-५४-६७", "content_sanskrit": "विचित्राभरणोपेतां रत्नमालावलंबिताम् ।\nपीनोन्नतकुचां रम्यां विश्वकर्मा विनिर्ममे ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001793067, "chapter_id": 21793, "verse_number": "२-५४-६८", "content_sanskrit": "स तु राजाद्भुतं दृष्ट्वा क्षणेनैकेन निर्मिताः ।\nदिव्यवस्त्रयुगाच्छन्ना नानारत्नैरलंकृताः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001793068, "chapter_id": 21793, "verse_number": "२-५४-६९", "content_sanskrit": "सर्वलक्षणसंपन्नाः प्रतिमाः सुमनोहराः ।\nविस्मयं परमं गत्वा इदं वचनमब्रवीत् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001793069, "chapter_id": 21793, "verse_number": "२-५४-७०", "content_sanskrit": "किं देवौ समनुप्राप्तौ द्विजरूपधरावुभौ ।\nद्वावप्यद्भुतकर्माणौ देववृत्तौ त्वमानुषौ ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001793070, "chapter_id": 21793, "verse_number": "२-५४-७१", "content_sanskrit": "देवौ वा मानुषौ वापि यक्षविद्याधरौ वरौ ।\nकिंवा ब्रह्महृषीकेशौ वसुरुद्रावुताश्विनौ ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001793071, "chapter_id": 21793, "verse_number": "२-५४-७२", "content_sanskrit": "न वेद्मि सत्यवद्भावौ मायरूपेण संस्थितौ ।\nयुवां गतोऽस्मि शरणमात्मानं वदतं मम ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001793072, "chapter_id": 21793, "verse_number": "२-५४-७३", "content_sanskrit": "द्विज उवाच ।\nनाहं देवो न यक्षो वा न दैत्यो न च देवराट् ।\nन ब्रह्मा न च रुद्रोऽहं विद्धि मां पुरुषोत्तमम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001793073, "chapter_id": 21793, "verse_number": "२-५४-७४", "content_sanskrit": "आर्तिघ्नं सर्वलोकानामनंतबलपौरुषम् ।\nअर्चनीयो हि भूतानामंतो यस्य न विद्यते ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001793074, "chapter_id": 21793, "verse_number": "२-५४-७५", "content_sanskrit": "पठ्यते सर्वशास्त्रेषु वेदांतेषु निगद्यते ।\nयदुक्त ध्यानगम्यं च वासुदेवेति योगिभिः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001793075, "chapter_id": 21793, "verse_number": "२-५४-७६", "content_sanskrit": "अहमेव स्वयं ब्रह्मा अहं विष्णुः शिवो ह्यहम् ।\nइद्रोऽहं देवराजश्च जगत्संयमनो यमः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001793076, "chapter_id": 21793, "verse_number": "२-५४-७७", "content_sanskrit": "पृथिव्यादीनि भूतानि त्रेताग्निर्हुतभुग्यथा ।\nवरुणोऽपांपतिश्चाह धरित्री च महीधराः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001793077, "chapter_id": 21793, "verse_number": "२-५४-७८", "content_sanskrit": "यत्किंचिद्वाङ्मयं लोके जगत्स्थावरजंगमम् ।\nविश्वरूपं च मां विद्धि मत्तोऽन्यन्नास्ति किचन ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001793078, "chapter_id": 21793, "verse_number": "२-५४-७९", "content_sanskrit": "प्रीतोऽहं ते नृपश्रेष्ठ वरं वरय सुव्रत ।\nयदिष्टं तत्प्रयच्छामि हृदि यत्ते व्यवस्थितम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001793079, "chapter_id": 21793, "verse_number": "२-५४-८०", "content_sanskrit": "मद्दर्शनमपुण्यानां स्वप्नांतेऽपि न जायते ।\nत्वं पुनर्द्दढभक्तित्वात्प्रत्यक्षं दृष्टवानसि ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001793080, "chapter_id": 21793, "verse_number": "२-५४-८१", "content_sanskrit": "श्रुत्वैवं वासुदेवस्य वचनं तस्य मोहिनि ।\nरोमांचिततनुर्भूत्वा इदं स्तोत्रं जगौ नृपः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001793081, "chapter_id": 21793, "verse_number": "२-५४-८२", "content_sanskrit": "राजोवाच ।\nश्रियःकांत नमस्तेऽस्तु श्रीपते पीतवाससे ।\nश्रीदश्रीश श्रीनिवास नमस्ते श्रीनिकेतन ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001793082, "chapter_id": 21793, "verse_number": "२-५४-८३", "content_sanskrit": "आद्यं पुरुषमीशानं सर्वेशं सर्वशं सर्वतोमुखम् ।\nनिष्कलं परमं देवं प्रणतोऽस्मि सनादनम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001793083, "chapter_id": 21793, "verse_number": "२-५४-८४", "content_sanskrit": "शब्दातीतं गुणातीतं भावाभावविवर्जितम् ।\nनिर्लेपं निर्गुणं सूक्ष्मं सर्वज्ञं सर्वभावनम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001793084, "chapter_id": 21793, "verse_number": "२-५४-८५", "content_sanskrit": "शंशचक्रधरं देवं गदामुसलधारिणम् ।\nनमस्ये वरदं देवं नीलोत्पलदलच्छविम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001793085, "chapter_id": 21793, "verse_number": "२-५४-८६", "content_sanskrit": "नागपर्यंकशयनं क्षीरोदार्णववासिनम् ।\nनमस्येऽहं हृषीकेशं सर्वपापहरं हरिम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001793086, "chapter_id": 21793, "verse_number": "२-५४-८७", "content_sanskrit": "पुनस्त्वां देवदेवेश नमस्ये वरदं विभुम् ।\nसर्वलोकेश्वरं विष्णुं मोक्षकारणमव्ययम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001793087, "chapter_id": 21793, "verse_number": "२-५४-८८", "content_sanskrit": "एवं स्तुत्वा तु तं देवं प्रणिपत्य कृतांजलिः ।\nउवाच प्रणतो भूत्वा निपत्य वसुधातले ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001793088, "chapter_id": 21793, "verse_number": "२-५४-८९", "content_sanskrit": "प्रीतोऽसि यदि मे नाथ वृणोमि वरमुत्तमम् ।\nदेवाः सुराः सगंधर्वा यक्षरक्षोमहोरगाः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001793089, "chapter_id": 21793, "verse_number": "२-५४-९०", "content_sanskrit": "सिद्धविद्याधराः साध्याः किन्नरा गुह्यकास्तथा ।\nऋषयो ये महाभागा नानाशास्त्रविशारदाः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001793090, "chapter_id": 21793, "verse_number": "२-५४-९१", "content_sanskrit": "प्रव्रज्यायोगयुक्ताश्च वेदतत्‌त्वानुचिंतकाः ।\nमोक्षमार्गविदो येऽन्ये ध्यांयति परमं पदम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001793091, "chapter_id": 21793, "verse_number": "२-५४-९२", "content_sanskrit": "निर्मलं निर्गुणं शांतं यत्पश्यंति मनीषिणः ।\nतत्पदं गंतुमिच्छामि प्रसादात्ते सुदुर्लभम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001793092, "chapter_id": 21793, "verse_number": "२-५४-९३", "content_sanskrit": "श्रीभगवानुवाच ।\nसर्वं भवतु भद्रं ते यथेष्टं सर्वमाप्नुहि ।\nभविष्यति यथाकामं मत्प्रसादान्न संशयः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001793093, "chapter_id": 21793, "verse_number": "२-५४-९४", "content_sanskrit": "दश वर्षसहस्राणि तथा नव शतानि च ।\nअविच्छिन्नं महाराज्यं कुरु त्वं नृपसत्तम ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7001793094, "chapter_id": 21793, "verse_number": "२-५४-९५", "content_sanskrit": "प्रपद्य परमं दिव्यं दुर्लभं यत्सुरासुरैः ।\nपूर्णं मनोरथं शांतं गुह्यमव्यक्तमव्ययम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7001793095, "chapter_id": 21793, "verse_number": "२-५४-९६", "content_sanskrit": "परात्परतरं सूक्ष्मं निर्लेपं निर्गुण ध्रुवम् ।\nचिंताशोकविनिर्मुक्तं क्रियाकारणवर्जितम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7001793096, "chapter_id": 21793, "verse_number": "२-५४-९७", "content_sanskrit": "तदहं दर्शयिष्यामि विज्ञेयाख्यं परं पदम् ।\nसंप्राप्य परमानंदं प्राप्स्यसे परमां गतिम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7001793097, "chapter_id": 21793, "verse_number": "२-५४-९८", "content_sanskrit": "कीर्तिश्च तव राजेंद्र भवत्वत्र महीतले ।\nयावद्धरा नभो यावद्यावच्चंद्रार्कतारकाः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7001793098, "chapter_id": 21793, "verse_number": "२-५४-९९", "content_sanskrit": "यावत्समुद्राः सप्तैव यावन्मेर्व्वादिपर्वताः ।\nतिष्ठंति दिवि देवाश्च यावत्सर्वत्र चाव्ययाः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7001793099, "chapter_id": 21793, "verse_number": "२-५४-१००", "content_sanskrit": "इंद्रद्युस्मसरो नाम तीर्थँ यज्ञाज्यसंभवम् ।\nयत्र स्नात्वा सकृल्लोकः शक्रलोकमवाप्स्यति ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7001793100, "chapter_id": 21793, "verse_number": "२-५४-१०१", "content_sanskrit": "दापयिष्यति यः पिंडं तटेऽस्मिन्नंबुधेः शुभे ।\nकुसैकविंशमुद्धृत्य शक्रलोकं गमिष्यति ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7001793101, "chapter_id": 21793, "verse_number": "२-५४-१०२", "content_sanskrit": "पूज्यमानोऽप्सरोभिश्च गधवैर्गीतनिः स्वनैः ।\nविमानेन चरेत्तत्र यावदिंद्राश्चतुर्दशा ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7001793102, "chapter_id": 21793, "verse_number": "२-५४-१०३", "content_sanskrit": "सरसो दक्षिणे भागे नैर्ऋत्यां तु समाश्रिते ।\nन्यग्रोधोऽस्ति द्रुमस्तत्र तत्समीपे तु मंडपः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7001793103, "chapter_id": 21793, "verse_number": "२-५४-१०४", "content_sanskrit": "केतकीवनसंछन्नो नानापादपसंकुलः ।\nआषाढस्य सिते पक्षे पंचम्यां पितृदैवते ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7001793104, "chapter_id": 21793, "verse_number": "२-५४-१०५", "content_sanskrit": "ऋक्षे नेष्यंति नस्तत्र नीत्वा सप्त दिनानि वै ।\nमंडपे स्थापयिष्यंति सुवेश्याभिः सुशोभनैः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7001793105, "chapter_id": 21793, "verse_number": "२-५४-१०६", "content_sanskrit": "क्रीडाविशेषबहुलैर्नृत्यगीतमनोहरैः ।\nचामरैः स्वर्णदंडैश्च व्यजनै रत्नभूषणैः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7001793106, "chapter_id": 21793, "verse_number": "२-५४-१०७", "content_sanskrit": "व्यंजयंत्यस्तदास्मभ्यं स्थास्यंति परमांगनाः ।\nब्रह्मचारी यतिश्चैव स्नातकाश्च द्विजोत्तमाः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7001793107, "chapter_id": 21793, "verse_number": "२-५४-१०८", "content_sanskrit": "वानप्रस्था गृहस्थाश्च सिद्धाश्चान्ये च वै द्विजाः ।\nनानावर्णपदैः स्तोत्रैर्ऋग्यजुः सामनिःस्वनैः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7001793108, "chapter_id": 21793, "verse_number": "२-५४-१०९", "content_sanskrit": "करिष्यंति स्तुतिं राजन्रामकेशवयोः पुनः ।\nततः स्तुत्वा च दृष्ट्व च संप्रणम्य च भक्तितः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7001793109, "chapter_id": 21793, "verse_number": "२-५४-११०", "content_sanskrit": "नरो वर्षायुतं दिव्यं श्रीमद्धरिपुरे वसेत् ।\nपूज्यमानोऽप्सरोभिश्च गंधर्वैर्गीतनिःस्वनैः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7001793110, "chapter_id": 21793, "verse_number": "२-५४-१११", "content_sanskrit": "हरेरनुचरस्तत्र क्रीडते केशवेन वै ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7001793111, "chapter_id": 21793, "verse_number": "२-५४-११२", "content_sanskrit": "विमानेनार्कवर्णेन रत्नहारेण राजते ।\nसर्वे कामा महाभागे तिष्ठंति भवनोत्तमे ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7001793112, "chapter_id": 21793, "verse_number": "२-५४-११३", "content_sanskrit": "तपःक्षयादिहागत्य मनुष्यो ब्राह्मणो भवेत् ।\nकोटीधनपतिः श्रीमांश्चतुर्वेदो भवेद्ध्रुवम् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7001793113, "chapter_id": 21793, "verse_number": "२-५४-११४", "content_sanskrit": "एवं तस्मै वरं दत्त्वा कृत्वा च समयं हरिः ।\nजगामादर्शनं भद्रे सहितो विश्वकर्मणा ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7001793114, "chapter_id": 21793, "verse_number": "२-५४-११५", "content_sanskrit": "स तु राजा तदा हृष्टो रोमांचिततनूरुहः ।\nकृतकृत्यमिवात्मानं मेने संदर्शनाद्धरेः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7001793115, "chapter_id": 21793, "verse_number": "२-५४-११६", "content_sanskrit": "ततः कृष्णं च रामं च सुभद्रां च वरप्रदाम् ।\nरथैर्विमानसंकाशैर्मणिकांचनचित्रितैः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7001793116, "chapter_id": 21793, "verse_number": "२-५४-११७", "content_sanskrit": "संवाह्य तास्ततो राजा जयमंगलनिःस्वनैः ।\nआनया मास मतिमान्सामात्यः सपुरोहितः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7001793117, "chapter_id": 21793, "verse_number": "२-५४-११८", "content_sanskrit": "नानावादित्रनिर्घोषैर्नानावेदस्वनैः शुभैः ।\nसंस्थाप्य च शुभे देशे पवित्रे सुमनोहरे ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7001793118, "chapter_id": 21793, "verse_number": "२-५४-११९", "content_sanskrit": "ततः शुभे तिथौ स्वर्क्षे काले च शुभलक्षणे ।\nप्रतिष्ठां कारयामास सुमुहूर्ते द्विजैः सह ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7001793119, "chapter_id": 21793, "verse_number": "२-५४-१२०", "content_sanskrit": "यथोक्तेन विधानेन विधिदृष्टेन कर्मणा ।\nआचार्यानुमतेनैव सर्वं कृत्वा महीपतिः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7001793120, "chapter_id": 21793, "verse_number": "२-५४-१२१", "content_sanskrit": "आचार्याय तदा दत्त्वा दक्षिणां विधिवत्प्रभुः ।\nऋत्विग्भ्यः सविधानेन तथान्येभ्यो धनं ददौ ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7001793121, "chapter_id": 21793, "verse_number": "२-५४-१२२", "content_sanskrit": "कृत्वा प्रतिष्ठां विधिवत्प्रासादे भवनोत्तमे ।\nस्थापयामास तान्सर्वान्विश्वकर्मविनिर्मितान् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7001793122, "chapter_id": 21793, "verse_number": "२-५४-१२३", "content_sanskrit": "ततः संपूज्य विधिना नानापुष्पैः सुगंधिभिः ।\nसुवर्णमणिमुक्ताद्यैर्नानावस्त्रैः सुशोभनैः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7001793123, "chapter_id": 21793, "verse_number": "२-५४-१२४", "content_sanskrit": "ददौ द्विजेभ्यो विषयान्पुराणि नगराणि च ।\nएवं बहुविधान्दत्त्वा राज्यं कृत्वा यथोचितम् ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7001793124, "chapter_id": 21793, "verse_number": "२-५४-१२५", "content_sanskrit": "इष्ट्वा च विविधैर्यज्ञैर्दत्त्वा दानान्यनेकशः ।\nकृतकृत्यस्ततो राजा त्यक्तसर्वपरिग्रहः ।\nजगाम परमं स्थानं तद्विष्णोः परमं पदम् ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7001793125, "chapter_id": 21793, "verse_number": "२-५४-१२६", "content_sanskrit": "इति श्रीबृहन्नारदीयपुराणोत्तरभागे मोहिनीवसुसंवादे श्रीपुरुषोत्तममाहात्म्ये चतुष्पंचाशत्तमोऽध्यायाः ॥५४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}]