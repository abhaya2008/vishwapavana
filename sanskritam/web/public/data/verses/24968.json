[{"id": 7004968000, "chapter_id": 24968, "verse_number": "७-१-१५१-१", "content_sanskrit": "ईश्वर उवाच ।\nतस्यैव दक्षिणे भागे तृतीयो भैरवः स्थित ।\nब्रह्मकुण्डसमीपे तु सावित्र्या संप्रतिष्ठितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004968001, "chapter_id": 24968, "verse_number": "७-१-१५१-२", "content_sanskrit": "आराध्य तत्र देवेशं देवानां प्रपितामहम् ।\nवायुभक्षा निराहारा तोषयामास शंकरम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004968002, "chapter_id": 24968, "verse_number": "७-१-१५१-३", "content_sanskrit": "तुष्टः प्राहेश्वरो देवि शंकरस्तां वराननाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004968003, "chapter_id": 24968, "verse_number": "७-१-१५१-४", "content_sanskrit": "योऽस्मिन्कुंडे नरः स्नात्वा मल्लिंगं पूजयिष्यति ।\nपौर्णमास्यां विधानेन गन्धपुष्पादिभिः क्रमात् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004968004, "chapter_id": 24968, "verse_number": "७-१-१५१-५", "content_sanskrit": "दास्यं तस्य वरा निष्टान्मनसाऽभीसिताञ्छुभान् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004968005, "chapter_id": 24968, "verse_number": "७-१-१५१-६", "content_sanskrit": "महापातकयुक्तोऽपि मुक्तो भवति पातकैः ।\nसर्वकामसमृद्धात्मा स भूयाद्वृषभध्वजः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004968006, "chapter_id": 24968, "verse_number": "७-१-१५१-७", "content_sanskrit": "इत्येवमुक्त्वा देवेशि ततोऽन्तर्धानमागतः ।\nसावित्री ब्रह्मलोके तु गता संस्थाप्य शंकरम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004968007, "chapter_id": 24968, "verse_number": "७-१-१५१-८", "content_sanskrit": "इति संक्षेपतः प्रोक्तं सावित्रीशमहोदयम् ।\nशृणुयाद्यस्तु मतिमान्स मुक्तः पातकैर्भवेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004968008, "chapter_id": 24968, "verse_number": "७-१-१५१-९", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये ब्रह्मकुण्डमाहात्म्ये सावित्रीश्वरभैरवमाहात्म्यवर्णनंनामैकपंचाशदुत्तरशततमोऽध्यायः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]