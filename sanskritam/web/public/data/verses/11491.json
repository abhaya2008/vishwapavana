[{"id": 50012381, "chapter_id": 11491, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50012382, "chapter_id": 11491, "verse_number": "2", "content_sanskrit": "वृत्रे हते त्रयो लोका विना शक्रेण भूरिद। सपाला ह्यभवन् सद्यो विज्वरा निर्वृतेन्द्रियाः॥ ६/१३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50012383, "chapter_id": 11491, "verse_number": "3", "content_sanskrit": "देवर्षिपितृभूतानि दैत्या देवानुगाश्च ये। प्रतिजग्मुः स्वधिष्ण्यानि ब्रह्मेशेन्द्रादयस्ततः॥ ६/१३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50012384, "chapter_id": 11491, "verse_number": "4", "content_sanskrit": "राजोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50012385, "chapter_id": 11491, "verse_number": "5", "content_sanskrit": "इन्द्रस्यानिर्वृतेर्हेतुं श्रोतुमिच्छाम्यहं मुने। येनासन् सुखिनो देवा हरेर्दुःखं कुतोऽभवत्॥ ६/१३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50012386, "chapter_id": 11491, "verse_number": "6", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50012387, "chapter_id": 11491, "verse_number": "7", "content_sanskrit": "वृत्रविक्रमसंविग्नाः सर्वे देवाः सहर्षिभिः। तद्वधायार्थयन्निन्द्रं नैच्छद् भीतो बृहद्वधात्॥ ६/१३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50012388, "chapter_id": 11491, "verse_number": "8", "content_sanskrit": "इन्द्र उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50012389, "chapter_id": 11491, "verse_number": "9", "content_sanskrit": "स्त्रीभूजलद्रुमैरेनो विश्वरूपवधोद्भवम्। विभक्तमनुगृह्णद्भिर्वृत्रहत्यां क्व माज्र्म्यहम्॥ ६/१३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50012390, "chapter_id": 11491, "verse_number": "10", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50012391, "chapter_id": 11491, "verse_number": "11", "content_sanskrit": "ऋषयस्तदुपाकर्ण्य महेन्द्रमिदमब्रुवन्। याजयिष्याम भद्रं ते हयमेधेन मा स्म भैः॥ ६/१३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50012392, "chapter_id": 11491, "verse_number": "12", "content_sanskrit": "हयमेधेन पुरुषं परमात्मानमीश्वरम्। इष्ट्वा नारायणं देवं मोक्ष्यसेऽपि जगद्वधात्॥ ६/१३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50012393, "chapter_id": 11491, "verse_number": "13", "content_sanskrit": "ब्रह्महा गुरुहा गोध्नो मातृहाऽऽचार्यहाऽघवान्। श्वादः पुल्कसको वाऽपि शुध्द्येरन् यस्य कार्तनात्॥ ६/१३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50012394, "chapter_id": 11491, "verse_number": "14", "content_sanskrit": "तमश्वमेधेन महामखेन श्रद्धान्वितोऽस्माभिरनुष्ठितेन। हत्वाऽपि सब्रह्म चराचरं त्वं न लिप्यसे किं खलनिग्रहेण॥। ९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50012395, "chapter_id": 11491, "verse_number": "15", "content_sanskrit": "एवं सञ्चोदितो विप्रैर्मरुत्वान् न्यहनद् रिपुम्। ब्रह्महत्या हते तस्मिन्नाससाद वृषाकपिम्॥ ६/१३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50012396, "chapter_id": 11491, "verse_number": "16", "content_sanskrit": "तयेन्द्रं स्म ह सन्तप्तं निर्वृतिर्नामुमाविशत्। ह्वीमन्तं हत्यया तप्तं सुखयन्त्यपि नो गुणाः॥ ६/१३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50012397, "chapter_id": 11491, "verse_number": "17", "content_sanskrit": "तां ददर्शानुधावन्तीं चण्डालीमिव रूपिणीम्। जरया वेपमानाङ्गीं यक्ष्मग्रस्तामसृक्पटाम्॥ ६/१३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50012398, "chapter_id": 11491, "verse_number": "18", "content_sanskrit": "विकार्य पलितान् केशांस्तिष्ठतिष्ठेति भाषिणीम्। मीनगन्ध्यसुगन्धेन कुर्वतीं मार्गदूषणम्॥ ६/१३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50012399, "chapter_id": 11491, "verse_number": "19", "content_sanskrit": "नभोगतो दिशः सर्वाः सहस्राक्षो विशाम्पते। प्रागुदीचीं दिशं दृष्ट्वा प्रविष्टः प्राप मानसम्॥ ६/१३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50012400, "chapter_id": 11491, "verse_number": "20", "content_sanskrit": "स आवसत् पुष्करनाळतन्तूनलब्धभोगो यदिहाग्निदूतः। वर्षाणि साहस्रमलक्षितोऽद्भिः सञ्चिन्तयन् ब्रह्मवधाद् विमोक्षम्॥ १५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50012401, "chapter_id": 11491, "verse_number": "21", "content_sanskrit": "तावत् त्रिणाकं नहुषः शशास विद्यातपोयोगबलानुभावः। स सम्पदैश्वर्यमदान्धबुद्धिर्नीतस्तिरश्चां गतिमिन्द्रपत्नया॥ ६/१३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50012402, "chapter_id": 11491, "verse_number": "22", "content_sanskrit": "ततो गतो ब्रह्मगिरोपहूत ऋतम्भरध्याननिवारितांहः। पापश्च दिग्देवतया हतौजास्तं नाभ्यभूदवितं विष्णुपद्या॥ ६/१३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50012403, "chapter_id": 11491, "verse_number": "23", "content_sanskrit": "तं च ब्रह्मर्षयोऽभ्येत्य हयमेधेन भारत। यथावद् दीक्षयाञ्चक्रुः पुरुषाराधनेन ह॥ ६/१३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50012404, "chapter_id": 11491, "verse_number": "24", "content_sanskrit": "अथेज्यमाने पुरुषे सर्वभूतमयात्मनि। अश्वमेधे महेन्द्रेण वितते ब्रह्मवादिभिः॥ ६/१३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50012405, "chapter_id": 11491, "verse_number": "25", "content_sanskrit": "स वै त्वाष्ट्रवधो भूयानपि पापः परन्तप। नीतस्तेनैव शून्याय नीहार इव भानुना॥ ६/१३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50012406, "chapter_id": 11491, "verse_number": "26", "content_sanskrit": "स वाजिमेधेन यथोदितेन वितायमानेन मरीचिमिश्रैः। इष्ट्वाऽपि यज्ञं पुरुषं पुराणमिन्द्रो महानास विधूतपापः॥ ६/१३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50012407, "chapter_id": 11491, "verse_number": "27", "content_sanskrit": "इदं महाख्यानमशेषपाप्मनां प्रक्षाळनं तीर्थपदानुकार्तनम्। भक्त्युच्छ्रयं भक्तजनानुवर्णनं महेन्द्रमोक्षं विजयं मरुत्वतः॥ ६/१३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50012408, "chapter_id": 11491, "verse_number": "28", "content_sanskrit": "पठेयुराख्यानमिदं सदा बुधाः शृण्वन्त्यथो पर्वणिपर्वणीन्द्रियम्। धन्यं यशस्यं निखिलाघमोचनं रिपुञ्जयं स्वस्त्ययनं तथाऽऽयुषम्॥ ६/१३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50012409, "chapter_id": 11491, "verse_number": "29", "content_sanskrit": "इति श्रीमद्भागवते षष्ठस्कन्धे त्रयोदशोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]