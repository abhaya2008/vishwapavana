[{"id": 7000414000, "chapter_id": 20414, "verse_number": "२-८६-१", "content_sanskrit": "कुंजल उवाच ।\nतस्यास्तु चेष्टितं वत्स दिव्या देव्या वदाम्यहम् ।\nपूर्वजन्मकृतं सर्वं तन्मे निगदतः शृणु॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000414001, "chapter_id": 20414, "verse_number": "२-८६-२", "content_sanskrit": "अस्ति वाराणसी पुण्या नगरी पापनाशिनी ।\nतस्यामास्ते महाप्राज्ञः सुवीरो नाम नामतः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000414002, "chapter_id": 20414, "verse_number": "२-८६-३", "content_sanskrit": "वैश्यजात्यां समुत्पन्नो धनधान्यसमाकुलः ।\nतस्य भार्या महाप्राज्ञ चित्रा नाम सुविश्रुता॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000414003, "chapter_id": 20414, "verse_number": "२-८६-४", "content_sanskrit": "कुलाचारं परित्यज्य अनाचारेण वर्तते ।\nन मन्यते हि भर्तारं स्वैरवृत्त्या प्रवर्तते॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000414004, "chapter_id": 20414, "verse_number": "२-८६-५", "content_sanskrit": "धर्मपुण्यविहीना तु पापमेव समाचरेत् ।\nभर्तारं कुत्सते नित्यं नित्यं च कलहप्रिया॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000414005, "chapter_id": 20414, "verse_number": "२-८६-६", "content_sanskrit": "नित्यं परगृहे वासो भ्रमते सा गृहे गृहे ।\nपरच्छिद्रं समापश्येत्सदा दुष्टा च प्राणिषु॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000414006, "chapter_id": 20414, "verse_number": "२-८६-७", "content_sanskrit": "साधुनिंदापरा दुष्टा सदा हास्यकरा च सा ।\nअनाचारां महापापां ज्ञात्वा वीरेण निंदिता॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000414007, "chapter_id": 20414, "verse_number": "२-८६-८", "content_sanskrit": "स तां त्यक्त्वा महाप्राज्ञ उपयेमे महामतिः ।\nअन्य वैश्यस्य वै कन्यां तया सह प्रवर्तते॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000414008, "chapter_id": 20414, "verse_number": "२-८६-९", "content_sanskrit": "धर्माचारेण पुण्यात्मा सत्यधर्ममतिः सदा ।\nनिरस्ता तेन सा चित्रा प्रचंडा भ्रमते महीम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000414009, "chapter_id": 20414, "verse_number": "२-८६-१०", "content_sanskrit": "दुष्टानां संगतिं प्राप्ता नराणां पापिनां सदा ।\nदूतीकर्म चकाराथ सा तेषां पापनिश्चया॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000414010, "chapter_id": 20414, "verse_number": "२-८६-११", "content_sanskrit": "गृहभंगं चकाराथ साधूनां पापकारिणी ।\nसाध्वीं नारीं समाहूय पापवाक्यैः सुलोभयेत्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000414011, "chapter_id": 20414, "verse_number": "२-८६-१२", "content_sanskrit": "धर्मभंगं चकाराथ वाक्यैः प्रत्ययकारकैः ।\nसाधूनां सा स्त्रियं चित्रा अन्यस्मै प्रतिपादयेत्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000414012, "chapter_id": 20414, "verse_number": "२-८६-१३", "content_sanskrit": "एवं गृहशतं भग्नं चित्रया पापनिश्चयात् ।\nसंग्रामं सा महादुष्टाऽकारयत्पतिपुत्रकैः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000414013, "chapter_id": 20414, "verse_number": "२-८६-१४", "content_sanskrit": "मनांसि चालयेत्पापा पुरुषाणां स्त्रियः प्रति ।\nअकारयच्च संग्रामं यमग्रामविवर्धनम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000414014, "chapter_id": 20414, "verse_number": "२-८६-१५", "content_sanskrit": "एवं गृहशतं भंक्त्वा पश्चात्सा निधनं गता ।\nशासिता यमराजेन बहुदंडैः सुनंदन॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000414015, "chapter_id": 20414, "verse_number": "२-८६-१६", "content_sanskrit": "अभोजयत्सुनरकान्रौरवांस्तरणेः सुतः ।\nपाचिता रौरवे चित्रा चित्राः पीडाः प्रदर्शिताः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000414016, "chapter_id": 20414, "verse_number": "२-८६-१७", "content_sanskrit": "यादृशं क्रियते कर्म तादृशं परिभुज्यते ।\nतया गृहशतं भग्नं चित्रया पापनिश्चयात्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000414017, "chapter_id": 20414, "verse_number": "२-८६-१८", "content_sanskrit": "तत्तत्कर्मविपाकोऽयं तया भुक्तो द्विजोत्तम ।\nयस्माद्गृहशतं भग्नं तस्माद्दुःखं प्रभुंजति॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000414018, "chapter_id": 20414, "verse_number": "२-८६-१९", "content_sanskrit": "विवाहसमये प्राप्ते दैवं च पाकतां गतम् ।\nप्राप्ते विवाहसमये भर्ता मृत्युं प्रयाति च॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000414019, "chapter_id": 20414, "verse_number": "२-८६-२०", "content_sanskrit": "यथा गृहशतं भग्नं तथा वरशतं मृतम् ।\nस्वयंवरे तदा वत्स विवाहे चैकविंशतिः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000414020, "chapter_id": 20414, "verse_number": "२-८६-२१", "content_sanskrit": "दिव्या देव्या मया ख्यातं यथा मे पृच्छितं त्वया ।\nएतत्ते सर्वमाख्यातं तस्याः पूर्वविचेष्टितम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000414021, "chapter_id": 20414, "verse_number": "२-८६-२२", "content_sanskrit": "उज्ज्वल उवाच ।\nदिव्या देव्यास्त्वया ख्यातं यत्पूर्वं पूर्वचेष्टितम् ।\nतथा पापं कृतं घोरं गृहभंगाख्यमेव च॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000414022, "chapter_id": 20414, "verse_number": "२-८६-२३", "content_sanskrit": "प्लक्षद्वीपस्य भूपस्य दिवोदासस्य वै सुता ।\nकेन पुण्यप्रभावेण तया प्राप्तं महाकुलम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000414023, "chapter_id": 20414, "verse_number": "२-८६-२४", "content_sanskrit": "एतन्मे संशयं तात तदेतत्प्रब्रवीतु मे ।\nएवं पापसमाचारा कथं जाता नृपात्मजा॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000414024, "chapter_id": 20414, "verse_number": "२-८६-२५", "content_sanskrit": "कुंजल उवाच ।\nचित्रायाश्चेष्टितं पुण्यं तत्सर्वं प्रवदाम्यहम् ।\nश्रूयतामुज्ज्वल सुत चित्रया यत्कृतं पुरा॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000414025, "chapter_id": 20414, "verse_number": "२-८६-२६", "content_sanskrit": "भ्रममाणो महाप्राज्ञः कश्चित्सिद्धः समागतः ।\nकुचैलो वस्त्रहीनश्च संन्यासी स च दंडधृक्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000414026, "chapter_id": 20414, "verse_number": "२-८६-२७", "content_sanskrit": "कौपीनेन समायुक्तः पाणिपात्रो दिगंबरः ।\nगृहद्वारं समाश्रित्य चित्रायाः परिसंश्रितः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000414027, "chapter_id": 20414, "verse_number": "२-८६-२८", "content_sanskrit": "स मौनी सर्वमुंडस्तु विजितात्मा जितेंद्रियः ।\nनिराहारो जिताहारः सर्वतत्त्वार्थदर्शकः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000414028, "chapter_id": 20414, "verse_number": "२-८६-२९", "content_sanskrit": "दूराध्वानपरिश्रांत आतपाकुलमानसः ।\nश्रमेण खिद्यमानश्च तृषाक्रांतः सुपुत्रक॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000414029, "chapter_id": 20414, "verse_number": "२-८६-३०", "content_sanskrit": "चित्रा द्वारं समाश्रित्य च्छायामाश्रित्य संस्थितः ।\nतया दृष्टो महात्मा स चित्रया श्रमपीडितः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000414030, "chapter_id": 20414, "verse_number": "२-८६-३१", "content_sanskrit": "सेवां चक्रे च चित्रा सा तस्यैव सुमहात्मनः ।\nपादप्रक्षालनं कृत्वा दत्वा आसनमुत्तमम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000414031, "chapter_id": 20414, "verse_number": "२-८६-३२", "content_sanskrit": "आस्यतामासने तात सुखेनापि सुकोमले ।\nक्षुधापनोदनार्थं हि भुज्यतामन्नमुत्तमम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000414032, "chapter_id": 20414, "verse_number": "२-८६-३३", "content_sanskrit": "स्वेच्छया परितुष्टश्च शीतलं सलिलं पिब ।\nएवमुक्त्वा तथा कृत्वा देववत्पूज्य तं सुत॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000414033, "chapter_id": 20414, "verse_number": "२-८६-३४", "content_sanskrit": "अंगसंवाहनं कृत्वा नाशितश्रम एव च ।\nतयोक्तो हि महात्मा स भुक्त्वा पीत्वा द्विजोत्तम॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000414034, "chapter_id": 20414, "verse_number": "२-८६-३५", "content_sanskrit": "एवं संतोषितः सिद्धस्तया तत्त्वार्थदर्शकः ।\nसंतुष्टः सर्वधर्मात्मा किंचित्कालं स्थिरोभवत्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000414035, "chapter_id": 20414, "verse_number": "२-८६-३६", "content_sanskrit": "स्वेच्छया स गतो विप्रो महायोगी यथागतम् ।\nगते तस्मिन्महाभागे सिद्धे चैव महात्मनि॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000414036, "chapter_id": 20414, "verse_number": "२-८६-३७", "content_sanskrit": "सा चित्रा मरणं प्राप्ता स्वकर्मवशमागता ।\nशासिता धर्मराजेन महादंडैः सुदुःखदैः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000414037, "chapter_id": 20414, "verse_number": "२-८६-३८", "content_sanskrit": "सा चित्रा नरकं प्राप्ता वेदना व्रातदायकम् ।\nभुंक्ते दुःखं महाराज सा वै युगसहस्रकम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000414038, "chapter_id": 20414, "verse_number": "२-८६-३९", "content_sanskrit": "भोगांते तु पुनर्जन्म संप्राप्तं मानुषस्य च ।\nपूर्वं संपूजितः सिद्धस्तया पुण्यवतां वरः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000414039, "chapter_id": 20414, "verse_number": "२-८६-४०", "content_sanskrit": "तस्य कर्मविपाकोयं प्राप्ता पुण्यवतां कुले ।\nक्षत्रियाणां महाराज्ञो दिवोदासस्य वै गृहे॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000414040, "chapter_id": 20414, "verse_number": "२-८६-४१", "content_sanskrit": "दिव्यादेवी च तन्नाम जातं तस्या नरोत्तम ।\nसा हि दत्तवती चान्नं पानं पुण्यं महात्मने॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000414041, "chapter_id": 20414, "verse_number": "२-८६-४२", "content_sanskrit": "तस्य दानस्य सा भुंक्ते महत्पुण्यफलोदयम् ।\nपिबते शीतलं तोयं मिष्टान्नं च भुनक्ति वै॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000414042, "chapter_id": 20414, "verse_number": "२-८६-४३", "content_sanskrit": "दिव्यान्भोगान्प्रभुंजाना वर्तते पितृमंदिरे ।\nसिद्धस्यास्य प्रभावाच्च राजकन्या व्यजायत॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000414043, "chapter_id": 20414, "verse_number": "२-८६-४४", "content_sanskrit": "पापकर्मप्रभावाच्च गृहभंगान्महीपते ।\nविधवात्वं भुंजते सा दिव्यादेवी सुपुत्रक॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000414044, "chapter_id": 20414, "verse_number": "२-८६-४५", "content_sanskrit": "एतत्ते सर्वमाख्यातं दिव्यादेव्या विचेष्टितम् ।\nअन्यत्किन्ते प्रवक्ष्यामि यत्त्वं पृच्छसि मामिह॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000414045, "chapter_id": 20414, "verse_number": "२-८६-४६", "content_sanskrit": "उज्ज्वल उवाच ।\nकथं सा मुच्यते शोकान्महादुःखाद्वदस्व मे ।\nसास्याच्च कीदृशी बाला महादुःखेन पीडिता॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000414046, "chapter_id": 20414, "verse_number": "२-८६-४७", "content_sanskrit": "तत्सुखं कीदृशं तस्माद्विपाकश्च भविष्यति ।\nएतन्मे संशयं तात सांप्रतं छेत्तुमर्हसि॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000414047, "chapter_id": 20414, "verse_number": "२-८६-४८", "content_sanskrit": "कथं सा लभते मोक्षं तंचोपायं वदस्व मे ।\nएकाकिनी महाभागा महारण्ये प्ररोदिति॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000414048, "chapter_id": 20414, "verse_number": "२-८६-४९", "content_sanskrit": "विष्णुरुवाच ।\nपुत्रवाक्यं महच्छ्रुत्वा क्षणमेकं विचिंत्य सः ।\nप्रत्युवाच महाप्राज्ञः कुंजलः पुत्रकं प्रति॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000414049, "chapter_id": 20414, "verse_number": "२-८६-५०", "content_sanskrit": "शृणु वत्स महाभाग सत्यमेतद्वदाम्यहम् ।\nपापयोनिं तु संप्राप्य पूर्वकर्मसमुद्भवाम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000414050, "chapter_id": 20414, "verse_number": "२-८६-५१", "content_sanskrit": "तिर्यक्त्वेन च मे ज्ञानं नष्टं संप्रति पुत्रक ।\nअस्य वृक्षस्य संगाच्च प्रयतस्य महात्मनः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000414051, "chapter_id": 20414, "verse_number": "२-८६-५२", "content_sanskrit": "रेवायाश्च प्रसादेन विष्णोश्चैव प्रसादतः ।\nयेन सा लभते ज्ञानं मोक्षस्थानं निवर्तते॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000414052, "chapter_id": 20414, "verse_number": "२-८६-५३", "content_sanskrit": "उपदेशं प्रवक्ष्यामि मोक्षमार्गमनुत्तमम् ।\nयास्यते कल्मषान्मुक्ता यथा हेम हुताशनात्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000414053, "chapter_id": 20414, "verse_number": "२-८६-५४", "content_sanskrit": "शुद्धं च जायते वत्स संगाद्वह्नेः स्वरूपवत् ।\nहरेर्ध्यानान्महाप्राज्ञ शीघ्रं तस्य महात्मनः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000414054, "chapter_id": 20414, "verse_number": "२-८६-५५", "content_sanskrit": "जपहोमव्रतात्पापं नाशं याति हि पापिनाम् ।\nमदं त्यजेद्यथा नागो भयात्सिंहस्य सर्वदा॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000414055, "chapter_id": 20414, "verse_number": "२-८६-५६", "content_sanskrit": "नामोच्चारेण कृष्णस्य तत्प्रयाति हि किल्बिषम् ।\nतेजसा वैनतेयस्य विषहीना इवोरगाः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000414056, "chapter_id": 20414, "verse_number": "२-८६-५७", "content_sanskrit": "ब्रह्महत्यादिकाः पापाः प्रलयं यांति नान्यथा ।\nनामोच्चारेण तस्यापि चक्रपाणेः प्रयांति ते॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000414057, "chapter_id": 20414, "verse_number": "२-८६-५८", "content_sanskrit": "यदा नामशतं पुण्यमघराशिविनाशनम् ।\nसा जपेत स्थिरा भूत्वा कामक्रोधविवर्जिता॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000414058, "chapter_id": 20414, "verse_number": "२-८६-५९", "content_sanskrit": "सर्वेंद्रियाणि संयम्य आत्मज्ञानेन गोपयेत् ।\nतस्य ध्यानप्रविष्टा सा एकभूता समाहिता॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000414059, "chapter_id": 20414, "verse_number": "२-८६-६०", "content_sanskrit": "सा जपेत्परमं ज्ञानं तदा मोक्षं प्रयाति च ।\nतन्मनास्तत्पदे लीना योगयुक्ता यदा भवेत्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000414060, "chapter_id": 20414, "verse_number": "२-८६-६१", "content_sanskrit": "उज्ज्वल उवाच ।\nवद तात परं ज्ञानं परमं मम सांप्रतम् ।\nपश्चाद्ध्यान व्रतं पुण्यं नाम्नां शतमिहैव च॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000414061, "chapter_id": 20414, "verse_number": "२-८६-६२", "content_sanskrit": "कुंजल उवाच ।\nपरं ज्ञानं प्रवक्ष्यामि यन्न दृष्टं तु केनचित् ।\nश्रूयतां पुत्र कैवल्यं केवलं मलवर्जितम्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000414062, "chapter_id": 20414, "verse_number": "२-८६-६३", "content_sanskrit": "सूत उवाच ।\nयथा दीपो निवातस्थो निश्चलो वायुवर्जितः ।\nप्रज्वलन्नाशयेत्सर्वमंधकारं महामते॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000414063, "chapter_id": 20414, "verse_number": "२-८६-६४", "content_sanskrit": "तद्वद्दोषविहीनात्मा भवत्येव निराश्रयः ।\nनिराशो निर्मलो वत्स न मित्रं न रिपुः कदा॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000414064, "chapter_id": 20414, "verse_number": "२-८६-६५", "content_sanskrit": "न शोको न च हर्षश्च न लोभो न च मत्सरः ।\nएको विषादहर्षैश्च सुखदुःखैर्विमुच्यते॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000414065, "chapter_id": 20414, "verse_number": "२-८६-६६", "content_sanskrit": "विषयैश्चापि सर्वैश्च इंद्रियाणि स संहरेत् ।\nतदा स केवलो जातः केवलत्वं प्रजायते॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000414066, "chapter_id": 20414, "verse_number": "२-८६-६७", "content_sanskrit": "अग्निकर्मप्रसंगेन दीपस्तैलं प्रशोषयेत् ।\nवर्त्याधारेण राजेंद्र निःसंगो वायुवर्जितः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000414067, "chapter_id": 20414, "verse_number": "२-८६-६८", "content_sanskrit": "कज्जलं वमते पश्चात्तैलस्यापि महामते ।\nकृष्णासौ दृश्यते रेखा दीपस्याग्रे महामते॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000414068, "chapter_id": 20414, "verse_number": "२-८६-६९", "content_sanskrit": "स्वयमाकृष्यते तैलं तेजसा निर्मलो भवेत् ।\nकायवर्तिस्थितस्तद्वत्कर्मतैलं प्रशोषयेत्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000414069, "chapter_id": 20414, "verse_number": "२-८६-७०", "content_sanskrit": "विषयान्कज्जलीकृत्य प्रत्यक्षं संप्रदर्शयेत् ।\nजनयेन्निर्मलोभूत्वा स्वयमेव प्रकाशयेत्॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000414070, "chapter_id": 20414, "verse_number": "२-८६-७१", "content_sanskrit": "क्रोधादिभिः क्लेशसंज्ञैर्वायुभिः परिवर्जितः ।\nनिःस्पृहो निश्चलो भूत्वा तेजसा स्वयमुज्ज्वलेत्॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000414071, "chapter_id": 20414, "verse_number": "२-८६-७२", "content_sanskrit": "त्रैलोक्यं पश्यते सर्वं स्वस्थानस्थः स्वतेजसा ।\nकेवलज्ञानरूपोऽयं मया ते परिकीर्तितः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000414072, "chapter_id": 20414, "verse_number": "२-८६-७३", "content_sanskrit": "ध्यानं तस्य प्रवक्ष्यामि द्विविधं तस्य चक्रिणः ।\nकेवलज्ञानरूपेण दृश्यते ज्ञानचक्षुषा॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000414073, "chapter_id": 20414, "verse_number": "२-८६-७४", "content_sanskrit": "योगयुक्ता महात्मानः परमार्थपरायणाः ।\nयं पश्यंति विनिद्रास्तु यत्तपः सर्वदर्शकम्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000414074, "chapter_id": 20414, "verse_number": "२-८६-७५", "content_sanskrit": "हस्तपादविहीनं च सर्वत्र परिगच्छति ।\nसर्वं गृह्णाति त्रैलोक्यं स्थावरं जंगमं सुत॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000414075, "chapter_id": 20414, "verse_number": "२-८६-७६", "content_sanskrit": "नासामुखविहीनस्तु घ्राति जक्षिति पुत्रक ।\nअकर्णः शृणुते सर्वं सर्वसाक्षी जगत्पतिः॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000414076, "chapter_id": 20414, "verse_number": "२-८६-७७", "content_sanskrit": "अरूपो रूपसंबद्धः पंचवर्गवशंगतः ।\nसर्वलोकस्य यः प्राणः पूजितः स चराचरैः॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000414077, "chapter_id": 20414, "verse_number": "२-८६-७८", "content_sanskrit": "अजिह्वो वदते सर्वं वेदशास्त्रानुगं सुत ।\nअत्वचः स्पर्शनं चापि सर्वेषामेव जायते॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000414078, "chapter_id": 20414, "verse_number": "२-८६-७९", "content_sanskrit": "सदानंदो विरक्तात्मा एकरूपो निराश्रयः ।\nनिर्जरो निर्ममो न्यायी सगुणो निर्ममोमलः॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000414079, "chapter_id": 20414, "verse_number": "२-८६-८०", "content_sanskrit": "अवश्यः सर्ववश्यात्मा सर्वदः सर्ववित्तमः ।\nतस्य धाता न चैवास्ति स वै सर्वमयो विभुः॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000414080, "chapter_id": 20414, "verse_number": "२-८६-८१", "content_sanskrit": "एवं सर्वमयं ध्यानं पश्यते यो महात्मनः ।\nस याति परमं स्थानममूर्तममृतोपमम्॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000414081, "chapter_id": 20414, "verse_number": "२-८६-८२", "content_sanskrit": "द्वितीयं तु प्रवक्ष्यामि अस्य ध्यानं महात्मनः ।\nमूर्ताकारं तु साकारं निराकारं निरामयम्॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000414082, "chapter_id": 20414, "verse_number": "२-८६-८३", "content_sanskrit": "ब्रह्माण्डं सर्वमतुलं वासितं यस्य वासना ।\nस तस्माद्वासुदेवेति उच्यते मम नंदन॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000414083, "chapter_id": 20414, "verse_number": "२-८६-८४", "content_sanskrit": "वर्षमाणस्य मेघस्य यद्वर्णं तस्य तद्भवेत् ।\nसूर्यतेजःप्रतीकाशं चतुर्बाहुं सुरेश्वरम्॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000414084, "chapter_id": 20414, "verse_number": "२-८६-८५", "content_sanskrit": "दक्षिणे शोभते शंखो हेमरत्नविभूषितः ।\nसूर्यबिंबसमाकारं चक्रं पद्मप्रतिष्ठितम्॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000414085, "chapter_id": 20414, "verse_number": "२-८६-८६", "content_sanskrit": "कौमोदकी गदा तस्य महासुरविनाशिनी ।\nवामे च शोभते वत्स हस्ते तस्य महात्मनः॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000414086, "chapter_id": 20414, "verse_number": "२-८६-८७", "content_sanskrit": "महापद्मं सुगंधाढ्यं तस्य दक्षिणहस्तगम् ।\nशोभमानः सदैवास्ते सायुधः कमलाप्रियः॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000414087, "chapter_id": 20414, "verse_number": "२-८६-८८", "content_sanskrit": "कंबुग्रीवं वृत्तमास्यं पद्मपत्रनिभेक्षणम् ।\nराजमानं हृषीकेशं दशनै रत्नसन्निभैः॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000414088, "chapter_id": 20414, "verse_number": "२-८६-८९", "content_sanskrit": "गुडाकेशाः सन्ति यस्य अधरो विद्रुमाकृतिः ।\nशोभते पुंडरीकाक्षः किरीटेनापि पुत्रक॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000414089, "chapter_id": 20414, "verse_number": "२-८६-९०", "content_sanskrit": "विशालेनापि रूपेण केशवस्तु सुवर्चसा ।\nकौस्तुभेनांकितेनैव राजमानो जनार्दनः॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000414090, "chapter_id": 20414, "verse_number": "२-८६-९१", "content_sanskrit": "सूर्यतेजः प्रतीकाश कुंडलाभ्यां प्रभाति च ।\nश्रीवत्सांकेन पुण्येन सर्वदा राजते हरिः॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000414091, "chapter_id": 20414, "verse_number": "२-८६-९२", "content_sanskrit": "केयूरकंकणैर्हारैर्मौक्तिकैरृक्षसन्निभैः ।\nवपुषा भ्राजमानस्तु विजयो जयतां वरः॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000414092, "chapter_id": 20414, "verse_number": "२-८६-९३", "content_sanskrit": "भ्राजते सोपि गोविंदो हेमवर्णेन वाससा ।\nमुद्रिकारत्नयुक्ताभिरंगुलीभिर्विराजते॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000414093, "chapter_id": 20414, "verse_number": "२-८६-९४", "content_sanskrit": "सर्वायुधैः सुसंपूर्णैर्दिव्यैराभरणैर्हरिः ।\nवैनतेयसमारूढो लोककर्ता जगत्पतिः॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000414094, "chapter_id": 20414, "verse_number": "२-८६-९५", "content_sanskrit": "एवंतं ध्यायते नित्यमनन्यमनसा नरः ।\nमुच्यते सर्वपापेभ्यो विष्णुलोकं स गच्छति॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000414095, "chapter_id": 20414, "verse_number": "२-८६-९६", "content_sanskrit": "एतत्ते सर्वमाख्यातं ध्यानमेव जगत्पतेः ।\nव्रतं चैव प्रवक्ष्यामि सर्वपापनिवारणम्॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}]