[{"id": 7000572000, "chapter_id": 20572, "verse_number": "५-३१-१", "content_sanskrit": "जाबालिरुवाच ।\nअथ तेषु प्रयातेषु नरकस्थेषु वै नृषु ।\nराजा पप्रच्छ कीनाशं सर्वधर्मविदांवरम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000572001, "chapter_id": 20572, "verse_number": "५-३१-२", "content_sanskrit": "राजोवाच ।\nधर्मराज त्वया प्रोक्तं यत्पातककरा नराः ।\nआयांति तव संस्थानं न च धर्मकथारताः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000572002, "chapter_id": 20572, "verse_number": "५-३१-३", "content_sanskrit": "मदागमनमत्राभूत्केनपापेन धार्मिक ।\nतद्वै कथय सर्वं मे पापकारणमादितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000572003, "chapter_id": 20572, "verse_number": "५-३१-४", "content_sanskrit": "इति श्रुत्वा तु तद्वाक्यं धर्मराजः परंतप ।\nकथयामास तस्यैवं यमपुर्यागमं तदा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000572004, "chapter_id": 20572, "verse_number": "५-३१-५", "content_sanskrit": "धर्मराज उवाच ।\nराजंस्तव महत्पुण्यं नैतादृक्कस्य भूतले ।\nरघुनाथपदद्वंद्वमकरंद मधुव्रत ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000572005, "chapter_id": 20572, "verse_number": "५-३१-६", "content_sanskrit": "त्वत्कीर्ति स्वर्धुनी सर्वान्पापिनो मलसंयुतान् ।\nपुनाति परमाह्लादकारिणी दुष्टतारिणी ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000572006, "chapter_id": 20572, "verse_number": "५-३१-७", "content_sanskrit": "तथापि पापलेशस्ते वर्तते नृपसत्तम ।\nयेन संयमिनीपार्श्वमागतः पुण्यपूरितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000572007, "chapter_id": 20572, "verse_number": "५-३१-८", "content_sanskrit": "एकदा तु चरंतीं गां वारयामास वै भवान् ।\nतेन पापविपाकेन निरयद्वारदर्शनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000572008, "chapter_id": 20572, "verse_number": "५-३१-९", "content_sanskrit": "इदानीं पापनिर्मुक्तो बहुपुण्यसमन्वितः ।\nभुंक्ष्व भोगान्सुविपुलान्निजपुण्यार्जितान्बहून् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000572009, "chapter_id": 20572, "verse_number": "५-३१-१०", "content_sanskrit": "एतेषां करुणावार्धी रघुनाथो सुखं हरन् ।\nसंयमिन्या महामार्गे प्रेरयामास वैष्णवम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000572010, "chapter_id": 20572, "verse_number": "५-३१-११", "content_sanskrit": "नागमिष्यो यदि त्वं वै मार्गेणानेन सुव्रत ।\nअभविष्यत्कथं तेषां निरयात्परिमोचनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000572011, "chapter_id": 20572, "verse_number": "५-३१-१२", "content_sanskrit": "त्वादृशाः परदुःखेन दुःखिताः करुणालयाः ।\nप्राणिनां दुःखविच्छेदं कुर्वंत्येव महामते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000572012, "chapter_id": 20572, "verse_number": "५-३१-१३", "content_sanskrit": "जाबालिरुवाच ।\nएवं वदंतं शमनं प्रणम्य स दिवंगतः ।\nदिव्येन सुविमानेन अप्सरोगणशोभिना ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000572013, "chapter_id": 20572, "verse_number": "५-३१-१४", "content_sanskrit": "तस्माद्गावोऽनिशं पूज्या मनसापि न गर्हयेत् ।\nगर्हयन्निरयं याति यावदिंद्राश्चतुर्दश ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000572014, "chapter_id": 20572, "verse_number": "५-३१-१५", "content_sanskrit": "तस्मात्त्वं नृपतिश्रेष्ठ गोपूजां वै समाचर ।\nसा तुष्टा दास्यति क्षिप्रं पुत्रं धर्मपरायणम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000572015, "chapter_id": 20572, "verse_number": "५-३१-१६", "content_sanskrit": "सुमतिरुवाच ।\nतच्छ्रुत्वा धेनुपूजां स पप्रच्छ कथमादरात् ।\nपूजनीया प्रयत्नेन कीदृशं कुरुते नरम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000572016, "chapter_id": 20572, "verse_number": "५-३१-१७", "content_sanskrit": "जाबालि कथयामास धेनुपूजां यथाविधि ।\nप्रत्यहं विपिनं गच्छेच्चारणार्थं व्रती तु गोः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000572017, "chapter_id": 20572, "verse_number": "५-३१-१८", "content_sanskrit": "गवे यवांस्तु संभोज्य गोमयस्थान्समाहरेत् ।\nभक्षणीया यवास्ते तु पुत्रकामेन भूपते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000572018, "chapter_id": 20572, "verse_number": "५-३१-१९", "content_sanskrit": "सा यदा पिबते तोयं तदा पेयं जलं शुचि ।\nसोच्चैः स्थाने यदा तिष्ठेत्तदानीं चासनस्थितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000572019, "chapter_id": 20572, "verse_number": "५-३१-२०", "content_sanskrit": "दंशान्निवारयेन्नित्यं यवसं स्वयमाहरेत् ।\nएवं प्रकुर्वतः पुत्रं दास्यते धर्मतत्परम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000572020, "chapter_id": 20572, "verse_number": "५-३१-२१", "content_sanskrit": "सुमतिरुवाच ।\nइति वाक्यं समाकर्ण्य पुत्रकाम ऋतंभरः ।\nव्रतं चकार धर्मात्मा धेनुपूजां समाचरन् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000572021, "chapter_id": 20572, "verse_number": "५-३१-२२", "content_sanskrit": "प्रत्यहं कुरुते गां वै यवसाद्येन तोषिताम् ।\nदंशान्न्यवारयद्धीमान्यवभक्षकृतादरः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000572022, "chapter_id": 20572, "verse_number": "५-३१-२३", "content_sanskrit": "एवं धेनुं पूजयतो गतास्तु दिवसा घनाः ।\nवनमध्ये तृणादींश्च चरंतीमकुतोभयाम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000572023, "chapter_id": 20572, "verse_number": "५-३१-२४", "content_sanskrit": "एकदा नृपतिस्तस्य वनस्य श्रीनिरीक्षणे ।\nन्यस्तदृष्टिः सपरितो बभ्राम स कुतूहली ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000572024, "chapter_id": 20572, "verse_number": "५-३१-२५", "content_sanskrit": "तदागत्याहनद्गां वै पंचास्यः काननांतरात् ।\nक्रोशंतीं बहुधा दीनां सिंहभारेणदुःखिताम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000572025, "chapter_id": 20572, "verse_number": "५-३१-२६", "content_sanskrit": "तदा नृपः समागत्य विलोक्य निजमातरम् ।\nसिंहेन निहतां पश्यन्रुरोदातीव विह्वलः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000572026, "chapter_id": 20572, "verse_number": "५-३१-२७", "content_sanskrit": "स दुःखितः समागत्य जाबालिमुनिसत्तमम् ।\nनिष्कृतिं तस्य पप्रच्छ गोवधस्य प्रमादतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000572027, "chapter_id": 20572, "verse_number": "५-३१-२८", "content_sanskrit": "ऋतंभर उवाच ।\nस्वामिंस्त्वदाज्ञया धेनुं पालयन्वनमास्थितः ।\nकुतोप्यागत्य तां सिंहो जघानादृष्टिगोचरः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000572028, "chapter_id": 20572, "verse_number": "५-३१-२९", "content_sanskrit": "तस्य पापस्य निष्कृत्यै किं करोमि त्वदाज्ञया ।\nकथं वा व्रतसंपूर्तिर्मम पुत्रप्रदायिनी ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000572029, "chapter_id": 20572, "verse_number": "५-३१-३०", "content_sanskrit": "इत्युक्तवंतं तं भूपं जगाद मुनिसत्तमः ।\nसंत्युपाया महीपाल पापस्यास्यापनुत्तये ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000572030, "chapter_id": 20572, "verse_number": "५-३१-३१", "content_sanskrit": "ब्रह्मघ्नस्य कृतघ्नस्य सुरापस्य महामते ।\nप्रायश्चित्तानि वर्तंते सर्वपापहराणि च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000572031, "chapter_id": 20572, "verse_number": "५-३१-३२", "content_sanskrit": "कृच्छ्रैश्चांद्रायणैर्दानैर्व्रतैः सनियमैर्यमैः ।\nपापानि प्रलयं यांति नियमादनुतिष्ठतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000572032, "chapter_id": 20572, "verse_number": "५-३१-३३", "content_sanskrit": "द्वयोश्च निष्कृतिर्नास्ति पापपुंजकृतोस्तयोः ।\nमत्या गोवधकर्तुश्च नारायणविनिंदितुः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000572033, "chapter_id": 20572, "verse_number": "५-३१-३४", "content_sanskrit": "गवां यो मनसा दुःखं वांच्छत्यधमसत्तमः ।\nस याति निरयस्थानं यावदिंद्राश्चतुर्दश ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000572034, "chapter_id": 20572, "verse_number": "५-३१-३५", "content_sanskrit": "योऽपि देवं हरिं निंदेत्सकृद्दुर्भाग्यवान्नरः ।\nस चापि नरकं पश्येत्पुत्रपौत्रपरीवृतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000572035, "chapter_id": 20572, "verse_number": "५-३१-३६", "content_sanskrit": "तस्माज्ज्ञात्वा हरिं निंदन्गोषु दुःखं समाचरन् ।\nकदापि नरकान्मुक्तिं न प्राप्नोति नरेश्वर ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000572036, "chapter_id": 20572, "verse_number": "५-३१-३७", "content_sanskrit": "अज्ञानप्राप्तगोहत्या प्रायश्चित्तं तु विद्यते ।\nरामभक्तं तु धीमंतं याहि त्वमृतुपर्णकम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000572037, "chapter_id": 20572, "verse_number": "५-३१-३८", "content_sanskrit": "स वै समदृशः सर्वाञ्छत्रून्मित्राणि पश्यति ।\nतुभ्यं कथिष्यति क्षिप्रं गोवधस्यास्य निष्कृतिम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000572038, "chapter_id": 20572, "verse_number": "५-३१-३९", "content_sanskrit": "तस्य देशांस्त्वमाक्रामंस्तेन निर्वासितः पुरा ।\nवैरिभावं परित्यज्य गच्छ त्वमृतुपर्णकम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000572039, "chapter_id": 20572, "verse_number": "५-३१-४०", "content_sanskrit": "स यद्वदिष्यति क्षिप्रं तत्कुरुष्व समाहितः ।\nयथा त्वत्कृतपापस्य निष्कृतिर्हि भविष्यति ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000572040, "chapter_id": 20572, "verse_number": "५-३१-४१", "content_sanskrit": "स तु तद्वचनं श्रुत्वा जगाम ऋतुपर्णकम् ।\nरामभक्तं रिपौ मित्रे समदृष्ट्या समंजसम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000572041, "chapter_id": 20572, "verse_number": "५-३१-४२", "content_sanskrit": "स तस्मै कथयामास यज्जातं गोवधादिकम् ।\nतस्य पापस्य निष्कृत्यै ह्युपायं सोऽप्यचिंतयत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000572042, "chapter_id": 20572, "verse_number": "५-३१-४३", "content_sanskrit": "क्षणं ध्यात्वाथ तं राजा ऋतुपर्ण ऋतंभरम् ।\nउवाच प्रहसन्वाक्यं बुद्धिमान्धर्मकोविदः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000572043, "chapter_id": 20572, "verse_number": "५-३१-४४", "content_sanskrit": "कोऽहं राजन्मुनीनां वै पुरतः शास्त्रवेदिनाम् ।\nतान्हित्वा किं तु मां प्राप्तो मूर्खंपंडितमानिनम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000572044, "chapter_id": 20572, "verse_number": "५-३१-४५", "content_sanskrit": "तव मय्यस्ति चेच्छ्रद्धा तदा किंचिद्ब्रवीम्यहम् ।\nशृणुष्व नरशार्दूल गदितं मम सादरः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000572045, "chapter_id": 20572, "verse_number": "५-३१-४६", "content_sanskrit": "भज श्रीरघुनाथं त्वं कर्मणा मनसा गिरा ।\nनैष्कापट्येन लोकेशं तोषयस्व महामते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000572046, "chapter_id": 20572, "verse_number": "५-३१-४७", "content_sanskrit": "स तुष्टो दास्यते सर्वं त्वद्धृदिस्थं मनोरथम् ।\nअज्ञानकृत गोहत्यापापनाशं करिष्यति ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000572047, "chapter_id": 20572, "verse_number": "५-३१-४८", "content_sanskrit": "रामं स्मरंस्त्वं धर्मात्मन्धेनुं पालय सत्तम ।\nदत्त्वा द्विजाय कनकं पापनिष्कृतिमाप्स्यसि ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000572048, "chapter_id": 20572, "verse_number": "५-३१-४९", "content_sanskrit": "सुमतिरुवाच ।\nएतच्छ्रुत्वा तु तद्वाक्यमृतंभरनृपस्तदा ।\nविधाय रामस्मरणं पूतात्मा व्रतमाचरत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000572049, "chapter_id": 20572, "verse_number": "५-३१-५०", "content_sanskrit": "पूर्ववत्पालयन्धेनुं जगाम विपिनं महत् ।\nरामनामस्मरन्नित्यं सर्वभूतहिते रतः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000572050, "chapter_id": 20572, "verse_number": "५-३१-५१", "content_sanskrit": "तस्मै तुष्टा तु सुरभिः प्रोवाच परितोषिता ।\nराजन्वरय मत्तो वै वरं हृत्स्थं मनोरथम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000572051, "chapter_id": 20572, "verse_number": "५-३१-५२", "content_sanskrit": "तदा प्रोवाच वै राजा पुत्रं देहि मनोरमम् ।\nरामभक्तं पितृरतं स्वधर्मप्रतिपालकम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000572052, "chapter_id": 20572, "verse_number": "५-३१-५३", "content_sanskrit": "तुष्टा दत्त्वा वरं सापि तस्मै राज्ञे सुतार्थिने ।\nजगामादर्शनं देवी कामधेनुः कृपावती ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000572053, "chapter_id": 20572, "verse_number": "५-३१-५४", "content_sanskrit": "स काले प्राप्तवान्पुत्रं वैष्णवं रामसेवकम् ।\nसत्यवत्संज्ञयायुक्तमकरोत्तत्र तत्पिता ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000572054, "chapter_id": 20572, "verse_number": "५-३१-५५", "content_sanskrit": "सत्यवंतं सुतं लब्ध्वा पितृभक्तिपरं महान् ।\nपरमं हर्षमापेदे शक्रतुल्यपराक्रमम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000572055, "chapter_id": 20572, "verse_number": "५-३१-५६", "content_sanskrit": "स राजा धार्मिकं पुत्रं प्राप्य हर्षेणनिर्भरः ।\nराज्यं तस्मिन्महन्न्यस्य जगाम तपसे वनम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000572056, "chapter_id": 20572, "verse_number": "५-३१-५७", "content_sanskrit": "तत्राराध्य हृषीकेशं भक्तियुक्तेन चेतसा ।\nनिर्धूतपापः सतनुरगाद्धरिपदं नृपः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]