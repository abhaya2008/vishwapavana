[{"id": 2011668, "chapter_id": 1240, "verse_number": "१-२४१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2011669, "chapter_id": 1240, "verse_number": "१-२४१-१", "content_sanskrit": "स तथेति प्रतिज्ञाय सहितो यतिना हरिः।\nकृत्वा तु संविदं तेन प्रहृष्टः केशवोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2011670, "chapter_id": 1240, "verse_number": "१-२४१-२", "content_sanskrit": "पर्वते तौ विहृत्यैव यथेष्टं कृष्णपाण्डवौ।\nतां पुरीं प्रविवेशाथ गृह्य हस्तेन पाण्डवम्।\nप्रविश्य च गृहं रम्यं सर्वभोगसमन्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2011671, "chapter_id": 1240, "verse_number": "१-२४१-३", "content_sanskrit": "पार्थमावेदयामास रुक्मिणीसत्यभामयोः।\nहृषीकेशवचः श्रुत्वा ते उभे चोचतुर्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2011672, "chapter_id": 1240, "verse_number": "१-२४१-४", "content_sanskrit": "मनोरथो महानेष हृदि नौ परिवर्तते।\nकदा द्रक्षाव बीभत्सुं पाण्डवं पुरमागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2011673, "chapter_id": 1240, "verse_number": "१-२४१-५", "content_sanskrit": "इत्येवं हर्षमाणे ते वदन्त्यौ सुभृशं प्रियम्।\nरुग्मिणीसत्यभामे वै दृष्ट्वा प्रीतोऽभवद्यतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2011674, "chapter_id": 1240, "verse_number": "१-२४१-६", "content_sanskrit": "सर्वेषां हर्षमाणानां पार्थो हर्षमुपागमत्।\nप्राप्तमज्ञातरूपेण चागतं चार्जुनं हरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2011675, "chapter_id": 1240, "verse_number": "१-२४१-७", "content_sanskrit": "सत्कृत्य पूज्यमानं तु प्रीत्या चैव ह्यपूजयत्।\nस तं प्रियातिथिं श्रेष्ठं समीक्ष्य यतिमागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2011676, "chapter_id": 1240, "verse_number": "१-२४१-८", "content_sanskrit": "सोदर्यां भगिनीं कृष्णः सुभद्रामिदमब्रवीत्।\nअयं देशातिथिर्भद्रे संशितव्रतवानृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2011677, "chapter_id": 1240, "verse_number": "१-२४१-९", "content_sanskrit": "प्राप्नोतु सततं पूजां तव कन्यापुरे वसन्।\nआर्येण च परिज्ञातः पूजनीयो यतिस्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2011678, "chapter_id": 1240, "verse_number": "१-२४१-१०", "content_sanskrit": "रागाद्भरस्व वार्ष्णेयि भक्ष्यैर्भोज्यैर्यतिं सदा।\nएष यद्यदृषिर्ब्रूयात्कार्यमेव न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2011679, "chapter_id": 1240, "verse_number": "१-२४१-११", "content_sanskrit": "सखीभिः सहिता भद्रे भवास्य वशवर्तिनी।\nपुरा हि यतयो भद्रे ये भैक्षार्थमनुव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2011680, "chapter_id": 1240, "verse_number": "१-२४१-१२", "content_sanskrit": "ते बभूवुर्दशार्हाणां कन्यापुरनिवासिनः।\nतेभ्यो भोज्यानि भक्ष्याणि यथाकालमतन्द्रिताः।\nकन्यापुरगताः कन्याः प्रयच्छन्ति यशस्विनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2011681, "chapter_id": 1240, "verse_number": "१-२४१-१३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2011682, "chapter_id": 1240, "verse_number": "१-२४१-१३", "content_sanskrit": "सा तथेत्यब्रवीत्कृष्णं करिष्यामि यथाऽऽथ माम्।\nतोषयिष्यामि वृत्तेन कर्मणा च द्विजर्षभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2011683, "chapter_id": 1240, "verse_number": "१-२४१-१४", "content_sanskrit": "एवमेतेन रूपेण कंचित्कालं धनञ्जयः।\nउवास भक्ष्यैर्भोज्यैश्च भद्रया परमार्चितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2011684, "chapter_id": 1240, "verse_number": "१-२४१-१५", "content_sanskrit": "तस्य सर्वगुणोपेतां वासुदेवसहोदरीम्।\nपश्यतः सततं भद्रां प्रादुरासीन्मनोभवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2011685, "chapter_id": 1240, "verse_number": "१-२४१-१६", "content_sanskrit": "गूहयन्निव चाकारमालोक्य वरवर्णिनीम्।\nदीर्घमुष्णं विनिश्वस्य पार्थः कामवशं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2011686, "chapter_id": 1240, "verse_number": "१-२४१-१७", "content_sanskrit": "स कृष्णां द्रौपदीं मेने न रूपे भद्रया समाम्।\nप्राप्तां भूमान्विन्द्रसेनां साक्षाद्वा वरुणात्मजाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2011687, "chapter_id": 1240, "verse_number": "१-२४१-१८", "content_sanskrit": "अतीतकाले संप्राप्ते सर्वास्तापि सुरस्त्रियः।\nन समा भद्रया लोके इत्येवं मन्यतेऽर्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2011688, "chapter_id": 1240, "verse_number": "१-२४१-१९", "content_sanskrit": "अतीतसमये काले सोदर्याणां धनञ्जयः।\nन सस्मार सुभद्रायां कामाङ्कुशनिवारितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2011689, "chapter_id": 1240, "verse_number": "१-२४१-२०", "content_sanskrit": "क्रीडारतिपरां भद्रां सखीगणसमावृताम्।\nप्रीयते स्मार्जुनः पश्यन्स्वाहामिव विभावसुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2011690, "chapter_id": 1240, "verse_number": "१-२४१-२१", "content_sanskrit": "पाण्डवस्य सुभद्रायाः सकाशे तु यशस्विनः।\nसमुत्पत्तिः प्रभावश्च गदेन कथितः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2011691, "chapter_id": 1240, "verse_number": "१-२४१-२२", "content_sanskrit": "श्रुत्वा चाशनिनिर्घोषं केशवेनापि धीमता।\nउपमामर्जुनं कृत्वा विस्तरः कथितः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2011692, "chapter_id": 1240, "verse_number": "१-२४१-२३", "content_sanskrit": "क्रुद्धमानप्रलापश्च वृष्णीनामर्जुनं प्रति।\nपौरुषं चोपमां कृत्वा प्रावर्तत धनुष्मताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2011693, "chapter_id": 1240, "verse_number": "१-२४१-२४", "content_sanskrit": "अन्योन्यकलहे चापि विवादे चापि वृष्णयः।\nअर्जुनोपि न मे तुल्यः कुतस्त्वमिति चाब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2011694, "chapter_id": 1240, "verse_number": "१-२४१-२५", "content_sanskrit": "जातांश्च पुत्रान्गृह्णन्त आशिषो वृष्णयोऽब्रवन्।\nअर्जुनस्य समो वीर्ये भव तात धनुर्धरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2011695, "chapter_id": 1240, "verse_number": "१-२४१-२६", "content_sanskrit": "तस्मात्सुभद्रा चकमे पौरुषाद्भरतर्षभम्।\nसत्यसन्धस्य रूपेण चातुर्येण च मोहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2011696, "chapter_id": 1240, "verse_number": "१-२४१-२७", "content_sanskrit": "चारणातिथिसंघानां गदस्य च निशम्य सा।\nअदृष्टे कृतभावाभूत्सुभद्रा भरतर्षभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2011697, "chapter_id": 1240, "verse_number": "१-२४१-२८", "content_sanskrit": "कीर्तयन्ददृशे यो यः कथंचित्कुरुजाङ्गलम्।\nतं तमेव तदा भद्रा बीभत्सुं स्म हि पृच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2011698, "chapter_id": 1240, "verse_number": "१-२४१-२९", "content_sanskrit": "अभीक्ष्णश्रवणादेवमभीक्ष्णपरिपृच्छनात्।\nप्रत्यक्ष इव भद्रायाः पाण्डवः प्रत्यपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2011699, "chapter_id": 1240, "verse_number": "१-२४१-३०", "content_sanskrit": "भुजौ भुजगसङ्काशौ ज्याघातेन किणीकृतौ।\nपार्थोऽयमिति पश्यन्त्या निःशंसयमजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2011700, "chapter_id": 1240, "verse_number": "१-२४१-३१", "content_sanskrit": "यथारूपं हि शुश्राव सुभद्रा भरतर्षभम्।\nतथारूपमवेक्ष्यैनं परां प्रीतिमवाप सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2011701, "chapter_id": 1240, "verse_number": "१-२४१-३२", "content_sanskrit": "सा कदाचिदुपासीनं पप्रच्छ कुरुनन्दनम्।\nकथं देशाश्च चरिता नानाजनपदाः कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2011702, "chapter_id": 1240, "verse_number": "१-२४१-३३", "content_sanskrit": "सरांसि सरितश्चैव वनानि च कथं यते।\nदिशः काश्च कथं प्राप्ताश्चरता भवता सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2011703, "chapter_id": 1240, "verse_number": "१-२४१-३४", "content_sanskrit": "स तथोक्तस्तदा भद्रां बहुनर्मामृतं ब्रुवन्।\nउवाच परमप्रीतस्तथा बहुविधाः कथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2011704, "chapter_id": 1240, "verse_number": "१-२४१-३५", "content_sanskrit": "निशण्य विविधं तस्य लोके चरितमात्मनः।\nतथा परिगतो भावः कन्यायाः समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2011705, "chapter_id": 1240, "verse_number": "१-२४१-३६", "content_sanskrit": "पर्वसन्धौ तु कस्मिंश्चित्सुभद्रा भरतर्षभम्।\nरहस्येकान्तमासाद्य हर्षमाणाऽभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2011706, "chapter_id": 1240, "verse_number": "१-२४१-३७", "content_sanskrit": "यतिना रचता देशान्खाण्डवप्रस्थवासिनी।\nकश्चिद्भगवता दृष्टा पृथाऽस्माकं पितृष्वसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2011707, "chapter_id": 1240, "verse_number": "१-२४१-३८", "content_sanskrit": "भ्रातृभिः प्रीयते सर्वैर्दृष्टः कच्चिद्युधिष्ठिरः।\nकच्चिद्धर्मपरो भीमो धर्मराजस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2011708, "chapter_id": 1240, "verse_number": "१-२४१-३९", "content_sanskrit": "निवृत्तसमयः कच्चिदपराधाद्धनञ्जयः।\nनियमे कामभोगानां वर्तमानः प्रिये रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2011709, "chapter_id": 1240, "verse_number": "१-२४१-४०", "content_sanskrit": "क्व नु पार्थश्चरत्यद्य बहिः स वसतीर्वसन्।\nसुखोचितो ह्यदुःखार्हो दीर्घबाहुररिन्दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2011710, "chapter_id": 1240, "verse_number": "१-२४१-४१", "content_sanskrit": "कच्चिच्छ्रुतो वा दृष्टो वा पार्थो भगवताऽर्जुनः।\nनिशम्य वचनं तस्यास्तामुवाच हसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2011711, "chapter_id": 1240, "verse_number": "१-२४१-४२", "content_sanskrit": "आर्या कुशलिनी कुन्ती सहपुत्रा सहस्नुषा।\nप्रीयते पश्यती पुत्रान्खाण्डवप्रस्थ आसते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2011712, "chapter_id": 1240, "verse_number": "१-२४१-४३", "content_sanskrit": "अनुज्ञातश्च मात्रा च सोदरैश्च धनञ्जयः।\nद्वारकामावसत्येको यतिलिङ्गेन पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2011713, "chapter_id": 1240, "verse_number": "१-२४१-४४", "content_sanskrit": "पश्यन्ती सततं कस्मान्नाभिजानासि माधवि।\nनिशण्य वचनं तस्य वासुदेवसहोदरी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2011714, "chapter_id": 1240, "verse_number": "१-२४१-४५", "content_sanskrit": "निश्वासबहुला तस्थौ क्षितिं विलिखती तदा।\nततः परमसंहृष्टः सर्वशस्त्रभृतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2011715, "chapter_id": 1240, "verse_number": "१-२४१-४६", "content_sanskrit": "अर्जुनोऽहमिति प्रीतस्तामुवाच धनञ्जयः।\nयथा तव गतो भावः श्रवणान्मयि भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2011716, "chapter_id": 1240, "verse_number": "१-२४१-४७", "content_sanskrit": "त्वद्गतः सततं भावस्तथा तव गुणैर्मम।\nप्रशस्तेऽहनि धर्मेण भद्रे स्वयमहं वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2011717, "chapter_id": 1240, "verse_number": "१-२४१-४८", "content_sanskrit": "सत्यवानिव सावित्र्या भविष्यामि पतिस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2011718, "chapter_id": 1240, "verse_number": "१-२४१-४९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2011719, "chapter_id": 1240, "verse_number": "१-२४१-४९", "content_sanskrit": "एवमुक्त्वा ततः पार्थः प्रविवेश लतागृहम्।\nततः सुभद्रा ललिता लज्जाभावसमन्विता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2011720, "chapter_id": 1240, "verse_number": "१-२४१-५०", "content_sanskrit": "मुमोह शयने दिव्ये शयाना न तथोचिता।\nनाकरोद्यतिपूजां सा लज्जाभावमुपेयुषी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2011721, "chapter_id": 1240, "verse_number": "१-२४१-५१", "content_sanskrit": "कन्यापुरे तु यद्वृत्तं ज्ञात्वा दिव्येन चक्षुषा।\nशशास रुक्मिणीं कृष्णो भोजनादि तदार्जुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2011722, "chapter_id": 1240, "verse_number": "१-२४१-५२", "content_sanskrit": "तदाप्रभृति तां भद्रां चिन्तयन्वै धनञ्जयः।\nआस्ते स्म स तदाऽऽरामे कामेन भृशपीडितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2011723, "chapter_id": 1240, "verse_number": "१-२४१-५३", "content_sanskrit": "सुभद्रा चापि न स्वस्था पार्थं प्रति बभूव सा।\nकृशा विवर्णवदना चिन्ताशोकपरायणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2011724, "chapter_id": 1240, "verse_number": "१-२४१-५४", "content_sanskrit": "निश्वासपरमा भद्रा मानसेन मनस्विनी।\nन शय्यासनभोगेषु रतिं विन्दति केनचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2011725, "chapter_id": 1240, "verse_number": "१-२४१-५५", "content_sanskrit": "न नक्तं न दिवा शेते बभूवोन्मत्तदर्शना।\nएवं शोकपरां भद्रां देवी वाक्यमथाब्रवीत्।\nमा शोकं कुरु वार्ष्णेयि धृतिमालम्ब्य शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2011726, "chapter_id": 1240, "verse_number": "१-२४१-५६", "content_sanskrit": "रुक्मिण्येवं सुभद्रां तां कृष्णस्यानुमते तदा।\nरहोगत्य तदा श्वश्रूं देवकीं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2011727, "chapter_id": 1240, "verse_number": "१-२४१-५७", "content_sanskrit": "अर्जुनो यतिरूपेण ह्यागतः सुसमाहितः।\nकन्यापुरमथाविश्य पूजितो भद्रया मुदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2011728, "chapter_id": 1240, "verse_number": "१-२४१-५८", "content_sanskrit": "तं विदित्वा सुभद्रापि लज्जया परिमोहिता।\nदिवानिशं शयाना सा नाकरोद्भोजनादिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2011729, "chapter_id": 1240, "verse_number": "१-२४१-५९", "content_sanskrit": "एवमुक्ता तया देवी भद्रां शोकपरायणाम्।\nतत्समीपं समागत्य श्लक्ष्णं वाक्यमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2011730, "chapter_id": 1240, "verse_number": "१-२४१-६०", "content_sanskrit": "मा शोकं कुरु वार्ष्णेयि धृतिमालम्ब्य शोभने।\nराज्ञे निवेदयित्वापि वसुदेवाय धीमते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2011731, "chapter_id": 1240, "verse_number": "१-२४१-६१", "content_sanskrit": "कृष्णायापि तथा भद्रे प्रहर्षं कारयामि ते।\nपश्चाज्जानामि ते वार्तां मा शोकं कुरु भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2011732, "chapter_id": 1240, "verse_number": "१-२४१-६२", "content_sanskrit": "एवमुक्त्वा तु सा माता भद्रायाः प्रियकारिणी।\nनिवेदयामास तदा भद्रामानकदुन्दुभेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2011733, "chapter_id": 1240, "verse_number": "१-२४१-६३", "content_sanskrit": "रहस्येकासना तत्र भद्राऽस्वस्थेति चाब्रवीत्।\nआरामे तु यतिः श्रीमानर्जुनश्चेति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2011734, "chapter_id": 1240, "verse_number": "१-२४१-६४", "content_sanskrit": "अक्रूराय च कृष्माय आहुकाय च सात्येकः।\nनिवेद्यतां महाप्राज्ञ श्रोतव्यं यदि बान्धवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2011735, "chapter_id": 1240, "verse_number": "१-२४१-६५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2011736, "chapter_id": 1240, "verse_number": "१-२४१-६५", "content_sanskrit": "वसुदेवस्तु तच्छ्रुत्वा अक्रूराहुकयोस्तथा।\nनिवेदयित्वा कृष्णेन मन्त्रयामास तैस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2011737, "chapter_id": 1240, "verse_number": "१-२४१-६६", "content_sanskrit": "इदं कार्यमिदं कृत्यमिदमेवेति निश्चितः।\nअक्रूरश्चोग्रसेनश्च सात्यकिश्च गदस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2011738, "chapter_id": 1240, "verse_number": "१-२४१-६७", "content_sanskrit": "पृथुश्रवाश्च कृष्णश्च सहिताः शिनिना मुहुः।\nरुक्मिणी सत्यभामा च देवकी रोहिणी तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2011739, "chapter_id": 1240, "verse_number": "१-२४१-६८", "content_sanskrit": "वसुदेवेन सहिताः पुरोहितमते स्थिताः।\nविवाहं मन्त्रयामासुर्द्वादशेऽहनि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2011740, "chapter_id": 1240, "verse_number": "१-२४१-६९", "content_sanskrit": "अज्ञातं रौहिणेयस्य उद्धवस्य च भारत।\nविवाहं तु सुभद्रायाः कर्तुकामो गदाग्रजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2011741, "chapter_id": 1240, "verse_number": "१-२४१-७०", "content_sanskrit": "महादेवस्य पूजार्थं महोत्सव इति ब्रुवन्।\nचतुस्त्रिंशदहोरात्रं सुभद्रार्तिप्रशान्तये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2011742, "chapter_id": 1240, "verse_number": "१-२४१-७१", "content_sanskrit": "नगरे घोषयास हितार्थं सव्यसाचिनः।\nइतश्चतुर्थे त्वहनि अन्तर्द्वीपं तु गम्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2011743, "chapter_id": 1240, "verse_number": "१-२४१-७२", "content_sanskrit": "सदारैः सानुयात्रैश्च सपुत्रैः सहबाधवैः।\nगन्तव्यं सर्ववर्मैश्च गन्तव्यं सर्वयादवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2011744, "chapter_id": 1240, "verse_number": "१-२४१-७३", "content_sanskrit": "एवमुक्तास्तु ते सर्वे तथा चक्रुश्च सर्वशः।\nततः सर्वदशार्हाणामन्तर्द्वीपे च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2011745, "chapter_id": 1240, "verse_number": "१-२४१-७४", "content_sanskrit": "चतुस्त्रिंशदहोरात्रं बभूव परमोत्सवः।\nकृष्णरामाहुकाक्रूरप्रद्युम्नशिनिसत्यकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2011746, "chapter_id": 1240, "verse_number": "१-२४१-७५", "content_sanskrit": "समुद्रं प्रययुर्हृष्टाः कुकुरान्धकवृष्णयः।\nयुक्तयन्त्रपताकाभिर्वृष्णयो ब्राह्मणैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2011747, "chapter_id": 1240, "verse_number": "१-२४१-७६", "content_sanskrit": "समुद्रं प्रययुर्नौभिः सर्वे पुरनिवासिनः।\nततस्त्वरितमागत्य दाशार्हगणपूजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2011748, "chapter_id": 1240, "verse_number": "१-२४१-७७", "content_sanskrit": "सुभद्रा पुण्डरीकाक्षमब्रवीद्यतिशासनात्।\nकृत्यवान्द्वादशाहानि स्थाता स भगवानिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2011749, "chapter_id": 1240, "verse_number": "१-२४१-७८", "content_sanskrit": "तिष्ठतस्तस्य कः कुर्यादुपस्थानविधिं सदा।\nतमुवाच हृषीकेशः कस्त्वदन्यो विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2011750, "chapter_id": 1240, "verse_number": "१-२४१-७९", "content_sanskrit": "तमृषिं प्रत्युपस्थातुमितो नार्हति माधवि।\nत्वमेवास्मन्मतेनाद्य महर्षेर्वशवर्तिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2011751, "chapter_id": 1240, "verse_number": "१-२४१-८०", "content_sanskrit": "कुरु सर्वाणि कार्याणि कीर्तिं धर्ममवेक्ष्य च।\nतस्य चातिथिमुख्यस्य सर्वेषां च तपस्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2011752, "chapter_id": 1240, "verse_number": "१-२४१-८१", "content_sanskrit": "संविधानपरा भद्रे भव त्वं वशवर्तिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2011753, "chapter_id": 1240, "verse_number": "१-२४१-८२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2011754, "chapter_id": 1240, "verse_number": "१-२४१-८२", "content_sanskrit": "एवमादिश्य भिक्षां च भद्रां च मधुसूदनः।\nययौ शङ्खप्रणादेन भेरीणां निस्वनेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2011755, "chapter_id": 1240, "verse_number": "१-२४१-८३", "content_sanskrit": "ततस्तु द्वीपमासाद्य दानधर्मपरायणाः।\nउग्रसेनमुखाश्चान्ये विजहुः कुकुरान्धकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2011756, "chapter_id": 1240, "verse_number": "१-२४१-८४", "content_sanskrit": "पटहानां प्रणादैश्च भेरीणां निस्वनेन च।\nसप्तयोजनविस्तार आयतो दशयोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2011757, "chapter_id": 1240, "verse_number": "१-२४१-८५", "content_sanskrit": "बभूव स महाद्वीपः सपर्वतमहावनः।\nसेतुपुष्करिणीजालैराक्रीडः सर्वसात्वताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2011758, "chapter_id": 1240, "verse_number": "१-२४१-८६", "content_sanskrit": "वापीपल्वलसङ्घैश्च काननैश्च मनोरमैः।\nवासुदेवस्य क्रीडार्थं योग्यः सर्वप्रहर्षतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2011759, "chapter_id": 1240, "verse_number": "१-२४१-८७", "content_sanskrit": "कुकुरान्धकवृष्णीनां तथा प्रियकरस्तदा।\nबभूव परमोपेतस्त्रिविष्टप इवापरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2011760, "chapter_id": 1240, "verse_number": "१-२४१-८८", "content_sanskrit": "चतुस्त्रिंशदहोरात्रं दानधर्मपरायणाः।\nउग्रसेनमुखाः सर्वे विजहुः कुकुरान्धकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2011761, "chapter_id": 1240, "verse_number": "१-२४१-८९", "content_sanskrit": "विचित्रमाल्याभरणाश्चित्रगन्धानुलेपनाः।\nविहाराभिगताः सर्वे यादवा हर्षसंयुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2011762, "chapter_id": 1240, "verse_number": "१-२४१-९०", "content_sanskrit": "सुनृत्तगीतवादित्रै रममाणास्तदाऽभवन्।\nप्रतियाते दशार्हाणामृषभे शार्ङ्गधन्वनि।\nसुभध्रोद्वाहनं पार्थः प्राप्तकालममन्यत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2011763, "chapter_id": 1240, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि सुभद्राहरणपर्वणि एकचत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}]