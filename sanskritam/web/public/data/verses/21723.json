[{"id": 7001723000, "chapter_id": 21723, "verse_number": "१-१०९-१", "content_sanskrit": "ब्रह्मोवाच ।\nश्रृणु वत्स प्रवक्ष्यामि ब्रह्मांडाख्यं पुरातनम् ।\nयच्च द्वादशसाहस्रमादिकल्पकथायुतम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001723001, "chapter_id": 21723, "verse_number": "१-१०९-२", "content_sanskrit": "प्रक्रियाख्योऽनुषंगाख्य उपोद्घातस्तृतीयकः ।\nचतुर्थ उपसंहारः पादाश्चत्वार एव हि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001723002, "chapter_id": 21723, "verse_number": "१-१०९-३", "content_sanskrit": "पूर्वपादद्वयं पूर्वो भागोऽत्र समुदाहृतः ।\nतृतीयो मध्यमो भागश्चतुर्थस्तूत्तरो मतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001723003, "chapter_id": 21723, "verse_number": "१-१०९-४", "content_sanskrit": "आदौ कृत्यसमुद्देशो नैमिषाख्यानकं ततः ।\nहिरण्यगर्भोत्पत्तिश्च लोककल्पनमेव च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001723004, "chapter_id": 21723, "verse_number": "१-१०९-५", "content_sanskrit": "एष वै प्रथमः पादो द्वितीयं श्रृणु मानद ।\nकल्पमन्वन्तराख्यानं लोकज्ञानं ततः परम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001723005, "chapter_id": 21723, "verse_number": "१-१०९-६", "content_sanskrit": "मानसीसृष्टिकथनं रुद्रप्रसववर्णनम् ।\nमहादेवविभूतिश्च ऋषिसर्गस्ततः परम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001723006, "chapter_id": 21723, "verse_number": "१-१०९-७", "content_sanskrit": "अग्नीनां विजयश्चाथ कालसद्भाववर्णनम् ।\nप्रियव्रतान्वयोद्देशः पृथिव्यायामविस्तरः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001723007, "chapter_id": 21723, "verse_number": "१-१०९-८", "content_sanskrit": "वर्णनं भारतस्यास्य ततोऽन्येषां निरूपणम् ।\nजम्ब्वादिसप्तद्वीपाख्या ततोऽधोलोकवर्णनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001723008, "chapter_id": 21723, "verse_number": "१-१०९-९", "content_sanskrit": "उर्द्ध्वलोकानुकथनं ग्रहचारस्ततः परम् ।\nआदित्यव्यूहकथनं देवग्रहानुकीर्तनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001723009, "chapter_id": 21723, "verse_number": "१-१०९-१०", "content_sanskrit": "नीलकंठाह्वयाख्यानं महादेवस्य वैभवम् ।\nअमावास्यानुकथनं युगतत्त्वनिरूपणम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001723010, "chapter_id": 21723, "verse_number": "१-१०९-११", "content_sanskrit": "यज्ञप्रवर्तनं चाथ युगयोरंत्ययोः कृतिः ।\nयुगप्रजालक्षणं च ऋषिप्रवरवर्णनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001723011, "chapter_id": 21723, "verse_number": "१-१०९-१२", "content_sanskrit": "वेदानां व्यसनाख्यानं स्वायम्भुवनिरूपणम् ।\nशेषमन्वंतराख्यानं पृथिवीदोहनं ततः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001723012, "chapter_id": 21723, "verse_number": "१-१०९-१३", "content_sanskrit": "चाक्षुषेऽद्यतने सर्गे द्वितीयोऽङ्घ्रिः पुरोदले ।\nअथोपोद्घातपादे तु सप्तर्षिपरिकीर्तनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001723013, "chapter_id": 21723, "verse_number": "१-१०९-१४", "content_sanskrit": "प्रजापत्यन्वयस्तस्माद्देवादीनां समुद्भवः ।\nततो जयाभिलाषश्च मरुदुत्पत्तिकीर्तनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001723014, "chapter_id": 21723, "verse_number": "१-१०९-१५", "content_sanskrit": "काश्यपेयानुकथनं ऋषिवंशनिरूपणम् ।\nपितृकल्पानुकथनं श्राद्धकल्पस्ततः परम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001723015, "chapter_id": 21723, "verse_number": "१-१०९-१६", "content_sanskrit": "वैवस्वतसमुत्पत्तिः सृष्टिस्तस्य ततः परम् ।\nमनुपुत्रान्वयश्चांतो गान्धर्वस्य निरूपणम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001723016, "chapter_id": 21723, "verse_number": "१-१०९-१७", "content_sanskrit": "इक्ष्वाकुवंशकथनं वंशोऽत्रेः सुमहात्मनः ।\nअमावसोरन्वयश्च रजेश्चरितमद्भुतम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001723017, "chapter_id": 21723, "verse_number": "१-१०९-१८", "content_sanskrit": "ययातिचरितं चाथ यदुवंशनिरूपणम् ।\nकार्तवीर्यस्य चरितं जामदग्न्यं ततः परम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001723018, "chapter_id": 21723, "verse_number": "१-१०९-१९", "content_sanskrit": "वृष्णिवंशानुकथनं सगरस्याथ संभवः ।\nभार्गवस्यानुचरितं पितृकार्यवधाश्रयम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001723019, "chapter_id": 21723, "verse_number": "१-१०९-२०", "content_sanskrit": "सगरस्याथ चरितं भार्गवस्य कथा पुनः ।\nदेवासुराहवकथा कृष्णाविर्भाववर्णनम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001723020, "chapter_id": 21723, "verse_number": "१-१०९-२१", "content_sanskrit": "इंद्रस्य तु स्तवः पुण्यः शुक्रेण परिकीर्तितः ।\nविष्णुमाहात्म्यकथनं बलिवंशनिरूपणम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001723021, "chapter_id": 21723, "verse_number": "१-१०९-२२", "content_sanskrit": "भविष्यराजचरितं संप्राप्तेऽथ कलौ युगे ।\nसमुपोद्धातपादोऽयं तृतीयो मध्यमे दले ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001723022, "chapter_id": 21723, "verse_number": "१-१०९-२३", "content_sanskrit": "चतुर्थमुपसंहारं वक्ष्ये खण्डे तथोत्तरे ।\nवैवस्वतांतराख्यानं विस्तरेण यथातथाम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001723023, "chapter_id": 21723, "verse_number": "१-१०९-२४", "content_sanskrit": "पूर्वमेव समुद्दिष्टं संक्षेपादिह कथ्यते ।\nभविष्याणां मनूनां च चरितं हि ततः परम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001723024, "chapter_id": 21723, "verse_number": "१-१०९-२५", "content_sanskrit": "कल्पप्रलयनिर्देशः कालमानं ततः परम् ।\nलोकाश्चतुर्द्दश ततः कथिताः प्राप्तलक्षणैः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001723025, "chapter_id": 21723, "verse_number": "१-१०९-२६", "content_sanskrit": "वर्णनं नरकाणां च विकर्माचरणैस्ततः ।\nमनोमयपुराख्यानं लयः प्राकृतिकस्ततः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001723026, "chapter_id": 21723, "verse_number": "१-१०९-२७", "content_sanskrit": "शैवस्याथ पुरस्यापि वर्णनं च ततः परम् ।\nत्रिविधा गुणसंबंधाज्जंतूनां कीर्तिता गतिः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001723027, "chapter_id": 21723, "verse_number": "१-१०९-२८", "content_sanskrit": "अनिर्देश्याप्रतर्क्यस्य ब्रह्मणः परमात्मनः ।\nअन्वयव्यतिरेकाभ्यां वर्णनं हि ततः परम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001723028, "chapter_id": 21723, "verse_number": "१-१०९-२९", "content_sanskrit": "इत्येष उपसंहारपादो वृत्तः सहोत्तरः ।\nचतुष्पादं पुराणं ते ब्रह्माण्डं समुदाहृतकम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001723029, "chapter_id": 21723, "verse_number": "१-१०९-३०", "content_sanskrit": "अष्टादशमनौपम्यं सारात्सारतरं द्विज ।\nब्रह्मांडं यच्चतुर्लक्षं पुराणं येन पठ्यते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001723030, "chapter_id": 21723, "verse_number": "१-१०९-३१", "content_sanskrit": "तदेतदस्य गदितमत्राष्टादशधा पृथक् ।\nपाराशर्येण मुनिना सर्वेषामपि मानद ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001723031, "chapter_id": 21723, "verse_number": "१-१०९-३२", "content_sanskrit": "वस्तुतस्तूपदेष्ट्राथ मुनीनां भावितात्मनाम् ।\nमत्तः श्रुत्वा पुराणानि लोकेभ्यः प्रचकाशिरे ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001723032, "chapter_id": 21723, "verse_number": "१-१०९-३३", "content_sanskrit": "मुनयो धर्मशीलास्ते दीनानुग्रहकारिणः ।\nमयाचेदं पुराणं तु वसिष्टाय पुरोदितम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001723033, "chapter_id": 21723, "verse_number": "१-१०९-३४", "content_sanskrit": "तेन शक्तिसुतायोक्तं जातूकर्ण्याय तेन च ।\nव्यासो लब्ध्वा ततश्चैतत्प्रभंजनमुखोद्गतम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001723034, "chapter_id": 21723, "verse_number": "१-१०९-३५", "content_sanskrit": "प्रमाणीकृत्य लोकेऽस्मिन्प्रावर्तयदनुत्तमम् ।\nय इदं कीर्तयेद्वत्स श्रृणोति च समाहितः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001723035, "chapter_id": 21723, "verse_number": "१-१०९-३६", "content_sanskrit": "स विधूयेह पापानि याति लोकमनामयम् ।\nलिखित्वैतत्पुराणं तु स्वर्णसिंहासनस्थितम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001723036, "chapter_id": 21723, "verse_number": "१-१०९-३७", "content_sanskrit": "वस्त्रेणाच्छादितं यस्तु ब्राह्मणाय प्रयच्छति ।\nस यादि ब्रह्मणो लोकं नात्र कार्या विचारणा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001723037, "chapter_id": 21723, "verse_number": "१-१०९-३८", "content_sanskrit": "मरीचेऽष्टादशैतानि मया प्रोक्तानि यानि ते ।\nपुराणानि तु संक्षेपाच्छ्रोतव्यानि च विस्तरात् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001723038, "chapter_id": 21723, "verse_number": "१-१०९-३९", "content_sanskrit": "अष्टादश पुराणानि यः श्रृणोति नरोत्तमः ।\nकथयेद्वा विधानेन नेह भूयः स जायते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001723039, "chapter_id": 21723, "verse_number": "१-१०९-४०", "content_sanskrit": "सूत्रमेतत्पुराणानां यन्मयोक्तं तवाधुना ।\nतन्नित्यं शीलनीयं हि पुराणफलमिच्छता ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001723040, "chapter_id": 21723, "verse_number": "१-१०९-४१", "content_sanskrit": "न दांभिकाय पापाय देवगुर्वनुसूयवे ।\nदेयं कदापि साधूनां द्वेषिणे न शठाय च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001723041, "chapter_id": 21723, "verse_number": "१-१०९-४२", "content_sanskrit": "शांताय शमचित्ताय शुश्रूषाभिरताय च ।\nनिर्मत्सराय शुचये देयं सद्वैष्णवाय च ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]