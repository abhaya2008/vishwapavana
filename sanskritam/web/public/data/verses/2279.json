[{"id": 2059749, "chapter_id": 2279, "verse_number": "८-१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2059750, "chapter_id": 2279, "verse_number": "८-१-१", "content_sanskrit": "हते कर्णे महाराज निशि गावल्गणिस्तदा।\nदीनो ययौ नागपुरमश्वैर्वातसमैर्जवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2059751, "chapter_id": 2279, "verse_number": "८-१-२", "content_sanskrit": "स हास्तिनपुरं गत्वा भृशमुद्विग्नचेतनः।\nजगाम धृतराष्ट्रस्य क्षयं प्रक्षीणबान्धवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2059752, "chapter_id": 2279, "verse_number": "८-१-३", "content_sanskrit": "स तमुद्वीक्ष्य राजानं कश्मलाभिहतौजसम्।\nववन्दे प्राञ्जलिर्भूत्वा मूर्ध्ना पादौ नृपस्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2059753, "chapter_id": 2279, "verse_number": "८-१-४", "content_sanskrit": "सम्पूज्य च यथान्यायं धृतराष्ट्रं महीपतिम्।\nहा कष्टमिति चोक्त्वा स ततो वचनमाददे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2059754, "chapter_id": 2279, "verse_number": "८-१-५", "content_sanskrit": "सञ्जयोऽहं क्षितिपते कच्चिदास्ते सुखं भवान्।\nस्वदोषैरापदं प्राप्य कच्चिन्नाद्य विमुह्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2059755, "chapter_id": 2279, "verse_number": "८-१-६", "content_sanskrit": "हितान्युक्तानि विदुरद्रोणगाङ्गेयकेशवैः।\nअगृहीतान्यनुस्मृत्य कच्चिन्न कुरुषे व्यथाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2059756, "chapter_id": 2279, "verse_number": "८-१-७", "content_sanskrit": "रामनारदकण्वाद्यैर्हितमुक्तं सभातले।\nन गृहीतमनुस्मृत्य कच्चिन्न कुरुषे व्यथाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2059757, "chapter_id": 2279, "verse_number": "८-१-८", "content_sanskrit": "सुहृदस्त्वद्विते युक्तान्भीष्मद्रोणमुखान्परैः।\nनिहतान्युधि संस्मृत्य कच्चिन्न कुरुषे व्यथाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2059758, "chapter_id": 2279, "verse_number": "८-१-९", "content_sanskrit": "तमेवंवादिनं राजा सूतपुत्रं कृताजलिम्।\nसुदीर्घमथ निःश्वस्य दुःखार्त इदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2059759, "chapter_id": 2279, "verse_number": "८-१-१०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2059760, "chapter_id": 2279, "verse_number": "८-१-१०", "content_sanskrit": "आपगेये हते शूरे दिव्यास्त्रवति सञ्जय।\nद्रोणे च परमेष्वासे भृशं मे व्यथितं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2059761, "chapter_id": 2279, "verse_number": "८-१-११", "content_sanskrit": "यो रथानां सहस्राणि दंशितानां दशैव तु।\nअहन्यहनि तेजस्वी निजघ्ने वसुसम्भवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2059762, "chapter_id": 2279, "verse_number": "८-१-१२", "content_sanskrit": "तं हतं यज्ञसेनस्य पुत्रेणेह शिखण्डिना।\nपाण्डवेयाभिगुप्तेन श्रुत्वा मे व्यथितं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2059763, "chapter_id": 2279, "verse_number": "८-१-१३", "content_sanskrit": "भार्गवः प्रददौ यस्मै परमास्त्रं महाहवे।\nसाक्षाद्रामणे यो बाल्ये धनुर्वेद उपाकृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2059764, "chapter_id": 2279, "verse_number": "८-१-१४", "content_sanskrit": "यस्य प्रसादात्कौन्तेया राजपुत्रा महारथाः।\nमहारथत्वं सम्प्राप्तास्तथाऽन्ये वसुधाधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2059765, "chapter_id": 2279, "verse_number": "८-१-१५", "content_sanskrit": "तं द्रोणं निहतं श्रुत्वा धृष्टद्युम्नेन संयुगे।\nसत्यसन्धं महेष्वासं भृशं मे व्यथितं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2059766, "chapter_id": 2279, "verse_number": "८-१-१६", "content_sanskrit": "ययोर्लोके पुमानस्त्रे न समोऽस्ति चतुर्विधे।\nतौ द्रोणभीष्मौ श्रुत्वा तु हतौ मे व्यथितं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2059767, "chapter_id": 2279, "verse_number": "८-१-१७", "content_sanskrit": "त्रैलोक्ये यस्य चास्त्रेषु न पुमान्विद्यते समः।\nतं द्रोणं निहतं श्रुत्वा किमकुर्वत मामकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2059768, "chapter_id": 2279, "verse_number": "८-१-१८", "content_sanskrit": "संशप्तकानां च बले पाण्डवेन महात्मना।\nधनञ्जयेन विक्रम्य गमिते यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2059769, "chapter_id": 2279, "verse_number": "८-१-१९", "content_sanskrit": "नारायणास्त्रे च हते द्रोणपुत्रस्य धीमतः।\nविप्रद्रुतानहं मन्येनिमग्नाञ्शोकसागरे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2059770, "chapter_id": 2279, "verse_number": "८-१-२०", "content_sanskrit": "प्लवमानान्हते द्रोणे सन्ननौकानिवार्णवे॥\nदुर्योधनस्य कर्णस्य भोजस्य कृतवर्मणः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2059771, "chapter_id": 2279, "verse_number": "८-१-२१", "content_sanskrit": "मद्रराजस्य शल्यस्य द्रौणेश्चैव कृपस्य च॥\nमत्पुत्रस्य च शेषस्य तथाऽन्येषां च सञ्जय।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2059772, "chapter_id": 2279, "verse_number": "८-१-२२", "content_sanskrit": "विप्रद्रुतेष्वनीकेषु मुखवर्णोऽभवत्कथम्॥\nएतत्सर्वं यथावृत्तं तथा गावल्गणे मम।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2059773, "chapter_id": 2279, "verse_number": "८-१-२३", "content_sanskrit": "आचक्ष्व पाण्डवेयानां मामकानां च विक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2059774, "chapter_id": 2279, "verse_number": "८-१-२३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2059775, "chapter_id": 2279, "verse_number": "८-१-२४", "content_sanskrit": "तवापराधाद्यद्वृत्तं कौरवेयेषु मारिष।\nतच्छ्रुत्वा मा व्यथां कार्षीर्दिष्टे न व्यथते बुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2059776, "chapter_id": 2279, "verse_number": "८-१-२५", "content_sanskrit": "यस्मादभावी भावी वा भवेदर्थो नरं प्रति।\nअप्राप्तौ तस्य वा प्राप्तौ न कश्चिद्यथते बुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2059777, "chapter_id": 2279, "verse_number": "८-१-२६x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2059778, "chapter_id": 2279, "verse_number": "८-१-२६", "content_sanskrit": "न व्यथाऽभ्यधिका काचिद्विद्यते मम सञ्जय।\nदिष्टमेतत्पुरा मन्ये कथयस्य यथेच्छकम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2059779, "chapter_id": 2279, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि द्वितीयोऽध्यायः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]