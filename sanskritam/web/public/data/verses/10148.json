[{"id": 6000148000, "chapter_id": 10148, "verse_number": null, "content_sanskrit": "अथ दशमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000148001, "chapter_id": 10148, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.001.m4a", "display_order": 2}, {"id": 6000148002, "chapter_id": 10148, "verse_number": "७-१०-१", "content_sanskrit": "भक्तियोगस्य तत् सर्वमन्तरायतयाऽर्भकः।\nमन्यमानो हृषीकेशं स्मयमान उवाच ह॥ ७/१०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.002.m4a", "display_order": 3, "topics": [{"text": "श्रीनृसिहेन प्रह्लादाय वरदानम्", "range": "१–३१"}]}, {"id": 6000148003, "chapter_id": 10148, "verse_number": null, "content_sanskrit": "प्रह्लाद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.003.m4a", "display_order": 4}, {"id": 6000148004, "chapter_id": 10148, "verse_number": "७-१०-२", "content_sanskrit": "मा मा प्रलोभयोत्पत्त्याऽऽसक्तं कामेषु तैर्वरैः।\nतत्सङ्गभीतो निर्विण्णो मुमुक्षुस्त्वामुपाश्रितः॥ ७/१०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.004.m4a", "display_order": 5}, {"id": 6000148005, "chapter_id": 10148, "verse_number": "७-१०-३", "content_sanskrit": "भृत्यलक्षणजिज्ञासुर्भक्तं कामेषु चोदयात्।\nभवान् संसारबीजेषु हृदयग्रन्थिषु प्रभो॥ ७/१०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.005.m4a", "display_order": 6}, {"id": 6000148006, "chapter_id": 10148, "verse_number": "७-१०-४", "content_sanskrit": "नान्यथा तेऽखिलगुरोर्घटते करुणात्मनः।\nनष्टदृष्टेस्तमस्यन्धे त्वं पारः पारदर्शिनः॥ ७/१०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.006.m4a", "display_order": 7}, {"id": 6000148007, "chapter_id": 10148, "verse_number": "७-१०-५", "content_sanskrit": "यस्त आशिष आशास्ते न स भृत्यः स वै वणिक्।\nस वै स्वामी स वै भृत्यो गुणलुब्धौ न कामुकौ॥ ७/१०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.007.m4a", "display_order": 8}, {"id": 6000148008, "chapter_id": 10148, "verse_number": "७-१०-६", "content_sanskrit": "आशासानो न वै भृत्यः स्वामिन्याशिष आत्मनः।\nन स्वामी भृत्यतः स्वाम्यमिच्छन् यो राति चाशिषः॥ ७/१०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.008.m4a", "display_order": 9}, {"id": 6000148009, "chapter_id": 10148, "verse_number": "७-१०-७", "content_sanskrit": "अहं त्वकामस्त्वद्भक्तस्त्वं च स्वाम्यनपाश्रयः।\nनान्यथेहावयोरर्थो राजसेवकयोरिव॥ ७/१०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.009.m4a", "display_order": 10}, {"id": 6000148010, "chapter_id": 10148, "verse_number": "७-१०-८", "content_sanskrit": "यदि रासीश मे कामान् वरान् त्वं वरदर्षभ।\nकामानां हृद्यसंरोहं भवतस्तु वृणे वरम्॥ ७/१०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.010.m4a", "display_order": 11}, {"id": 6000148011, "chapter_id": 10148, "verse_number": "७-१०-९", "content_sanskrit": "इन्द्रियाणि मनः प्राणा आत्मा धर्मो धृतिर्मतिः।\nह्रीः श्रीस्तेजः स्मृतिः सत्यं येषां नश्यन्ति जन्मना॥ ७/१०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.011.m4a", "display_order": 12}, {"id": 6000148012, "chapter_id": 10148, "verse_number": "७-१०-१०", "content_sanskrit": "विमुञ्चति यदा कामान् मानवो मनसि श्रितान्। तर्ह्येव पुण्डरीकाक्ष न भवायावकल्पते।\nनारदेनोपदिष्टं मे तव मन्त्रमिमं स्मरे॥ ७/१०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.012.m4a", "display_order": 13}, {"id": 6000148013, "chapter_id": 10148, "verse_number": "७-१०-११", "content_sanskrit": "ओं नमो भगवते तुभ्यं पुरुषाय महात्मने।\nहरयेऽद्भुतसिंहाय ब्रह्मणे परमात्मने॥ ७/१०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.013.m4a", "display_order": 14}, {"id": 6000148014, "chapter_id": 10148, "verse_number": null, "content_sanskrit": "श्रीनृसिंह उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.014.m4a", "display_order": 15}, {"id": 6000148015, "chapter_id": 10148, "verse_number": "७-१०-१२", "content_sanskrit": "नैकान्तिनो मे मयि जात्विहाशिष आशासतेऽमुत्र तथा भवादृशाः।\nतथाऽपि मन्वन्तरमेतदत्र दैत्येश्वराणामनुभुङ्क्ष्व भोगान्॥ ७/१०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.015.m4a", "display_order": 16}, {"id": 6000148016, "chapter_id": 10148, "verse_number": "७-१०-१३", "content_sanskrit": "कथा मदीया जुषमाणः प्रियास्त्वमावेश्य मामात्मनि सन्तमेकम्।\nसर्वेषु भूतेष्वधियज्ञमीशं यजस्व योगेन च कर्म हिन्वन्॥ ७/१०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.016.m4a", "display_order": 17}, {"id": 6000148017, "chapter_id": 10148, "verse_number": "७-१०-१४", "content_sanskrit": "भोगेन पुण्यं, कुशलेन पापं, कलेवरं कालजवेन हित्वा।\nकीर्तिं विशुद्धां सुरलोकगीतां विताय मामेष्यसि मुक्तबन्धः॥ ७/१०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.017.m4a", "display_order": 18}, {"id": 6000148018, "chapter_id": 10148, "verse_number": "७-१०-१५", "content_sanskrit": "य एतत् कीर्तयेन्मह्यं त्वया गीतमिदं नरः।\nत्वां च मां च स्मरन् काले कर्मबन्धाद् विमुच्यते॥ ७/१०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.018.m4a", "display_order": 19}, {"id": 6000148019, "chapter_id": 10148, "verse_number": null, "content_sanskrit": "प्रह्लाद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.019.m4a", "display_order": 20}, {"id": 6000148020, "chapter_id": 10148, "verse_number": "७-१०-१६", "content_sanskrit": "वरं वरय एतत् ते वरदेशान्महेश्वर।\nयदनिन्दत् पिता मे त्वामविद्वांस्तेज ऐश्वरम्॥ ७/१०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.020.m4a", "display_order": 21}, {"id": 6000148021, "chapter_id": 10148, "verse_number": "७-१०-१७", "content_sanskrit": "बद्धामर्षाशयः साक्षात् सर्वलोकगुरुं प्रभुम्।\nभ्रातृहेति मृषादृष्टिस्त्वद्भक्ते मयि चाघवान्॥ ७/१०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.021.m4a", "display_order": 22}, {"id": 6000148022, "chapter_id": 10148, "verse_number": "७-१०-१८", "content_sanskrit": "तस्मात् पिता मे पूयेत दुरन्ताद् दुस्तरादघात्।\nपूतस्तेऽपाङ्गसन्दृष्टस्तदा कृपणवत्सल॥ ७/१०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.022.m4a", "display_order": 23}, {"id": 6000148023, "chapter_id": 10148, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.023.m4a", "display_order": 24}, {"id": 6000148024, "chapter_id": 10148, "verse_number": "७-१०-१९", "content_sanskrit": "त्रिसप्तभिः पिता पूतः पितृभिः सह तेऽनघ।\nयत् साधोऽस्य कुले जातो भवान् वै कुलपावनः॥ ७/१०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.024.m4a", "display_order": 25}, {"id": 6000148025, "chapter_id": 10148, "verse_number": "७-१०-२०", "content_sanskrit": "यत्र यत्र च मद्भक्ताः प्रशान्ताः समदर्शिनः।\nसाधवः समुदाचारास्ते पूयन्तेऽपि कीकटान्॥ ७/१०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.025.m4a", "display_order": 26}, {"id": 6000148026, "chapter_id": 10148, "verse_number": "७-१०-२१", "content_sanskrit": "सर्वात्मना न हिंसन्ति भूतग्रामेषु किञ्चन।\nउच्चावचेषु दैत्येन्द्र मद्भावेन गतस्पृहाः॥ ७/१०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.026.m4a", "display_order": 27}, {"id": 6000148027, "chapter_id": 10148, "verse_number": "७-१०-२२", "content_sanskrit": "भवन्ति पुरुषा लोके मद्भक्तास्त्वामनुव्रताः।\nभवान् मे खलु भक्तानां सर्वेषां प्रतिरूपधृक्॥ ७/१०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.027.m4a", "display_order": 28}, {"id": 6000148028, "chapter_id": 10148, "verse_number": "७-१०-२३", "content_sanskrit": "कुरु त्वं प्रेतकार्याणि पितुः पूतस्य सर्वशः।\nमदङ्गस्पर्शनेनाङ्ग लोकान् यास्यति सुप्रजाः॥ ७/१०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.028.m4a", "display_order": 29}, {"id": 6000148029, "chapter_id": 10148, "verse_number": "७-१०-२४", "content_sanskrit": "पित्र्यं च स्थानमातिष्ठ यथोक्तं ब्रह्मवादिभिः।\nमय्यावेश्य मनस्तात कुरु कर्माणि मत्परः॥ ७/१०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.029.m4a", "display_order": 30}, {"id": 6000148030, "chapter_id": 10148, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.030.m4a", "display_order": 31}, {"id": 6000148031, "chapter_id": 10148, "verse_number": "७-१०-२५", "content_sanskrit": "प्रह्लादोऽपि तथा चक्रे पितुर्यत् साम्परायिकम्। यथाऽऽह भगवान् राजन्नभिषिक्तो द्विजोत्तमैः।\nप्रह्लादस्तु तथाऽकार्षीद् राज्यं निहतकण्टकम्॥ ७/१०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.031.m4a", "display_order": 32}, {"id": 6000148032, "chapter_id": 10148, "verse_number": "७-१०-२६", "content_sanskrit": "प्रसादसुमुखंदृष्ट्वा ब्रह्मा नरहरिं हरिम्।\nस्तुत्वा वाग्भिः पवित्राभिः प्राह देवादिभिर्वृतः॥ ७/१०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.032.m4a", "display_order": 33}, {"id": 6000148033, "chapter_id": 10148, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.033.m4a", "display_order": 34}, {"id": 6000148034, "chapter_id": 10148, "verse_number": "७-१०-२७", "content_sanskrit": "देवदेवाखिलाध्यक्ष भूतभावन पूर्वज।\nदिष्ट्या ते निहतः पापो लोकसन्तापनोऽसुरः॥ ७/१०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.034.m4a", "display_order": 35}, {"id": 6000148035, "chapter_id": 10148, "verse_number": "७-१०-२८", "content_sanskrit": "योऽसौ लब्धवरो मत्तो न वध्यो मम सृष्टिभिः।\nतपोयोगबलोन्नद्धः समस्तनिगमानहन्॥ ७/१०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.035.m4a", "display_order": 36}, {"id": 6000148036, "chapter_id": 10148, "verse_number": "७-१०-२९", "content_sanskrit": "दिष्ट्याऽस्य तनयः साधुर्महाभागवतोऽर्भकः।\nत्वया विमोचितो मृत्योर्दिष्ट्या त्रातस्त्वयाऽधुना॥ ७/१०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.036.m4a", "display_order": 37}, {"id": 6000148037, "chapter_id": 10148, "verse_number": "७-१०-३०", "content_sanskrit": "एतद् वपुस्ते भगवन् ध्यायतः प्रयतात्मनः।\nसर्वतो गोप्तृ सन्त्रासान्मृत्योरपि जिघांसतः॥ ७/१०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.037.m4a", "display_order": 38}, {"id": 6000148038, "chapter_id": 10148, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.038.m4a", "display_order": 39}, {"id": 6000148039, "chapter_id": 10148, "verse_number": "७-१०-३१", "content_sanskrit": "मैवंविधोऽसुराणां ते प्रदेयः पद्मसम्भव।\nवरः क्रूरनिसर्गाणामहीनाममृतं यथा॥ ७/१०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.039.m4a", "display_order": 40}, {"id": 6000148040, "chapter_id": 10148, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.040.m4a", "display_order": 41}, {"id": 6000148041, "chapter_id": 10148, "verse_number": "७-१०-३२", "content_sanskrit": "इत्युक्त्वा भगवान् राजन् ततश्चान्तर्दधे हरिः।\nअदृश्यः सर्वभूतानां पूजितः परमेष्ठिना॥ ७/१०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.041.m4a", "display_order": 42, "topics": [{"text": "तस्मात्प्रदेशाद्भगवतोऽन्तर्धानम्", "range": "३२–३३"}]}, {"id": 6000148042, "chapter_id": 10148, "verse_number": "७-१०-३३", "content_sanskrit": "ततः सम्पूज्य विधिवद् ववन्दे परमेष्ठिनम्।\nभवं प्रजापतीन् देवान् प्रह्लादो भगवत्कलाः॥ ७/१०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.042.m4a", "display_order": 43}, {"id": 6000148043, "chapter_id": 10148, "verse_number": "७-१०-३४", "content_sanskrit": "ततः काव्यादिभिः सार्धं मुनिभिः कमलासनः।\nदैत्यानां दानवानां च प्रह्लादमकरोत् पतिम्॥ ७/१०/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.043.m4a", "display_order": 44, "topics": [{"text": "न केवलं प्रह्लादमेवानुजग्राह विष्णुः; अपि तु श्रीरुद्रमपीति कथयितुं त्रिपुरासुरवधकथा", "range": "३४–५१"}]}, {"id": 6000148044, "chapter_id": 10148, "verse_number": "७-१०-३५", "content_sanskrit": "प्रतिनन्द्य ततो देवाः प्रयुज्य परमाशिषः।\nस्वधामानि ययू राजन् ब्रह्माद्याः प्रतिपूजिताः॥ ७/१०/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.044.m4a", "display_order": 45}, {"id": 6000148045, "chapter_id": 10148, "verse_number": "७-१०-३६", "content_sanskrit": "एवं तौ पार्षदौ विष्णोः पुत्रत्वं प्रापितौ दितेः।\nहृदि स्थितेन हरिणा वैरभावेन तौ हतौ॥ ७/१०/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.045.m4a", "display_order": 46}, {"id": 6000148046, "chapter_id": 10148, "verse_number": "७-१०-३७", "content_sanskrit": "पुनस्तौ पूर्वशापेन राक्षसौ तौ बभूवतुः।\nकुम्भकर्णदशग्रीवौ हतौ तौ रामविक्रमैः॥ ७/१०/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.046.m4a", "display_order": 47}, {"id": 6000148047, "chapter_id": 10148, "verse_number": "७-१०-३८", "content_sanskrit": "शयानौ युधि निर्भिन्नहृदयौ रामसायकैः।\nतच्चित्तौ जहतुर्देहं यथा प्राक्तनजन्मनि॥ ७/१०/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.047.m4a", "display_order": 48}, {"id": 6000148048, "chapter_id": 10148, "verse_number": "७-१०-३९", "content_sanskrit": "तावेवाद्य पुनर्जातौ शिशुपालकरूशजौ।\nहरौ वैरानुबन्धेन पश्यतस्ते समीयतुः॥ ७/१०/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.048.m4a", "display_order": 49}, {"id": 6000148049, "chapter_id": 10148, "verse_number": "७-१०-४०", "content_sanskrit": "एनः पूर्वकृतं यत् तद् राजानः कृष्णवैरिणः।\nजहुस्तेऽन्ते तदात्मानः कीटाः पेशस्कृतो यथा॥ ७/१०/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.049.m4a", "display_order": 50}, {"id": 6000148050, "chapter_id": 10148, "verse_number": "७-१०-४१", "content_sanskrit": "यथा यथा भगवतो भक्त्या परमया भिदाम्।\nनृपाश्चैद्यादयः साम्यं हरेस्तच्चिन्तया ययुः॥ ७/१०/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.050.m4a", "display_order": 51}, {"id": 6000148051, "chapter_id": 10148, "verse_number": "७-१०-४२", "content_sanskrit": "आख्यातं सर्वमेतत् ते यन्मां त्वं परिपृष्टवान्।\nदमघोषसुतादीनां हरेः साम्यमपि द्विषाम्॥ ७/१०/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.051.m4a", "display_order": 52}, {"id": 6000148052, "chapter_id": 10148, "verse_number": "७-१०-४३", "content_sanskrit": "एषा ब्रह्मण्यदेवस्य कृष्णस्य च महात्मनः।\nअवतारकथा पुण्या वधो यत्रादिदैत्ययोः॥ ७/१०/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.052.m4a", "display_order": 53}, {"id": 6000148053, "chapter_id": 10148, "verse_number": "७-१०-४४", "content_sanskrit": "प्रह्लादस्यानुचरितं महाभागवतस्य च।\nभक्तिर्ज्ञानं विरक्तिश्च याथात्म्यं चास्य वै हरेः॥ ७/१०/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.053.m4a", "display_order": 54}, {"id": 6000148054, "chapter_id": 10148, "verse_number": "७-१०-४५", "content_sanskrit": "सर्गस्थित्यप्ययेशस्य गुणकर्मानुवर्णनम्।\nपरावरेषां स्थानानां कालेनाव्यत्ययो महान्॥ ७/१०/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.054.m4a", "display_order": 55}, {"id": 6000148055, "chapter_id": 10148, "verse_number": "७-१०-४६", "content_sanskrit": "धर्मो भागवतानां च भगवान् येन गम्यते।\nआख्यानेऽस्मिन् समाख्यातमाध्यात्मिकमशेषतः॥ ७/१०/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.055.m4a", "display_order": 56}, {"id": 6000148056, "chapter_id": 10148, "verse_number": "७-१०-४७", "content_sanskrit": "य एतत् पुण्यमाख्यानं विष्णोर्वीर्योपबृंहितम्।\nकीर्तयेच्छ्रद्धया श्रुत्वा कर्मपाशैर्विमुच्यते॥ ७/१०/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.056.m4a", "display_order": 57}, {"id": 6000148057, "chapter_id": 10148, "verse_number": "७-१०-४८", "content_sanskrit": "एतद् य आद्यपुरुषस्य मृगेन्द्रलीलां दैत्येन्द्रयूथपवधं प्रयतः पठेत।\nदैत्यात्मजस्य च सतां प्रवरस्य पुण्यं श्रुत्वानुभावमकुतोभयमेति लोकम्॥ ७/१०/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.057.m4a", "display_order": 58}, {"id": 6000148058, "chapter_id": 10148, "verse_number": "७-१०-४९", "content_sanskrit": "यूयं नृलोके बत भूरिभागा लोकं पुनाना मुनयोऽतियान्ति।\nयेषां गृहानावसतीति साक्षाद् गूढं परं ब्रह्म मनुष्यलिङ्गम्॥ ७/१०/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.058.m4a", "display_order": 59}, {"id": 6000148059, "chapter_id": 10148, "verse_number": "७-१०-५०", "content_sanskrit": "स वा अयं ब्रह्म महद् विमृग्यं कैवल्यनिर्वाणसुखानुभूतिः।\nप्रियः सुहृद् वः खलु मातुलेय आत्माऽर्हणीयो विधिकृद् गुरुश्च॥ ७/१०/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.059.m4a", "display_order": 60}, {"id": 6000148060, "chapter_id": 10148, "verse_number": "७-१०-५१", "content_sanskrit": "न यस्य साक्षाद् भवपद्मजादिभी रूपं धिया वस्तुतयोपवर्णितम्।\nमौनेन भक्त्योपशमेन पूजितः प्रसीदतामेष स सात्त्वतां पतिः॥ ७/१०/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.060.m4a", "display_order": 61}, {"id": 6000148061, "chapter_id": 10148, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.061.m4a", "display_order": 62}, {"id": 6000148062, "chapter_id": 10148, "verse_number": "७-१०-५२", "content_sanskrit": "स एष भगवान् राजन् अकरोद् विततं यशः।\nपुरा रुद्रस्य देवस्य मयेनानन्तमायिना॥ ७/१०/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.062.m4a", "display_order": 63}, {"id": 6000148063, "chapter_id": 10148, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.063.m4a", "display_order": 64}, {"id": 6000148064, "chapter_id": 10148, "verse_number": "७-१०-५३", "content_sanskrit": "कस्मिन् कर्मणि देवस्य यशोऽभूज्जगदीशितुः।\nयथा चोपचिता कीर्तिः कृष्णेनानेन कथ्यताम्॥ ७/१०/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.064.m4a", "display_order": 65}, {"id": 6000148065, "chapter_id": 10148, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.065.m4a", "display_order": 66}, {"id": 6000148066, "chapter_id": 10148, "verse_number": "७-१०-५४", "content_sanskrit": "निर्जिता असुरा देवैर्युध्यनेनोपबृंहितैः।\nमायिनां परमाचार्यं मयं शरणमाययुः॥ ७/१०/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.066.m4a", "display_order": 67}, {"id": 6000148067, "chapter_id": 10148, "verse_number": "७-१०-५५", "content_sanskrit": "स निर्ममे पुरस्तिस्रो हैमरोप्यायसीर्विभुः।\nदुर्लक्ष्यापायसंयोगा दुर्वितर्क्यपरिच्छदाः॥ ७/१०/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.067.m4a", "display_order": 68}, {"id": 6000148068, "chapter_id": 10148, "verse_number": "७-१०-५६", "content_sanskrit": "ताभिस्तेऽसुरसेनान्यो लोकान् त्रीन् सेश्वरान् नृप।\nस्मरन्तो नाशयांचक्रुः पूर्ववैरमलक्षिताः॥ ७/१०/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.068.m4a", "display_order": 69}, {"id": 6000148069, "chapter_id": 10148, "verse_number": "७-१०-५७", "content_sanskrit": "ततस्ते सेश्वरा लोका उपासाद्येश्वरं विभो।\nत्राहि नस्तावकान् देव विनष्टान् त्रिपुरालयैः॥ ७/१०/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.069.m4a", "display_order": 70}, {"id": 6000148070, "chapter_id": 10148, "verse_number": "७-१०-५८", "content_sanskrit": "अथानुगृह्य भगवान् मा भैष्टेति सुरान् विभुः।\nशरं धनुषि सन्धाय पुर्यामस्‍त्रं व्यमुञ्चत॥ ७/१०/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.070.m4a", "display_order": 71}, {"id": 6000148071, "chapter_id": 10148, "verse_number": "७-१०-५९", "content_sanskrit": "ततोऽग्निवर्णा इषव उत्पेतुः सूर्यमण्डलात्।\nयथा मयूखसन्दोहा नादृश्यन्त पुरो यतः॥ ७/१०/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.071.m4a", "display_order": 72}, {"id": 6000148072, "chapter_id": 10148, "verse_number": "७-१०-६०", "content_sanskrit": "तैः सृष्टा व्यसवः सर्वे निपेतुस्‍त्रिपुरौकसः।\nतानानीय महायोगैर्मयः कूपरसेऽक्षिपत्॥ ७/१०/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.072.m4a", "display_order": 73}, {"id": 6000148073, "chapter_id": 10148, "verse_number": "७-१०-६१", "content_sanskrit": "सिद्धामृतरसस्पृष्टा वज्रसारा महौजसः।\nउत्तस्थुर्मेघदलनाद् वैद्युता इव वह्नयः॥ ७/१०/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.073.m4a", "display_order": 74}, {"id": 6000148074, "chapter_id": 10148, "verse_number": "७-१०-६२", "content_sanskrit": "विलोक्य भग्नसङ्कल्पं विमनस्कं वृषध्वजम्।\nतदाऽयं भगवान् विष्णुस्तत्रोपायमकल्पयत्॥ ७/१०/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.074.m4a", "display_order": 75}, {"id": 6000148075, "chapter_id": 10148, "verse_number": "७-१०-६३", "content_sanskrit": "वत्स आसीत् तदा ब्रह्मा स्वयं विष्णुरयं हि गौः।\nप्रविश्य त्रिपुरं काले रसकूपामृतं पपौ॥ ७/१०/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.075.m4a", "display_order": 76}, {"id": 6000148076, "chapter_id": 10148, "verse_number": "७-१०-६४", "content_sanskrit": "तेऽसुरा ह्यपि पश्यन्तो न न्यषेधन् विमोहिताः। तद् विज्ञाय महायोगी रसपालानिदं जगौ।\nस्मयन् विशोकः शोकार्तान् स्मरन् दैवगतिं च ताम्॥ ७/१०/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.076.m4a", "display_order": 77}, {"id": 6000148077, "chapter_id": 10148, "verse_number": "७-१०-६५", "content_sanskrit": "देवोऽसुरो नरोऽन्यो वा नेश्वरोऽस्तीह कश्चन।\nआत्मनोऽन्यस्य वा दिष्टं दैवेनापोहितुं द्वयोः॥ ७/१०/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.077.m4a", "display_order": 78}, {"id": 6000148078, "chapter_id": 10148, "verse_number": "७-१०-६६", "content_sanskrit": "अथासौ शक्तिभिः स्वाभिः शम्भोः प्राधनिकं व्यधात्।\nधर्मज्ञानविरक्त्यादितपोविद्याक्रियादिभिः॥ ७/१०/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.078.m4a", "display_order": 79}, {"id": 6000148079, "chapter_id": 10148, "verse_number": "७-१०-६७", "content_sanskrit": "रथं सूतं ध्वजं वाहं धनुर्वर्म शरादि यत्।\nसन्नद्धो रथमास्थाय सशरं धनुराददे॥ ७/१०/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.079.m4a", "display_order": 80}, {"id": 6000148080, "chapter_id": 10148, "verse_number": "७-१०-६८", "content_sanskrit": "शरं धनुषि सन्धाय मुहूर्तेऽभिजितीश्वरः।\nभगवत्तेजसा गुप्तो ददाह त्रिपुरं नृप॥ ७/१०/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.080.m4a", "display_order": 81}, {"id": 6000148081, "chapter_id": 10148, "verse_number": "७-१०-६९", "content_sanskrit": "दिवि दुन्दुभयो नेदुर्विमानशतसङ्कुले। देवर्षिपितृसिद्धेशा जयेति कुसुमोत्करैः।\nअवाकिरन् जगुर्हृष्टा ननृतुश्चाप्सरो गणाः॥ ७/१०/६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.081.m4a", "display_order": 82}, {"id": 6000148082, "chapter_id": 10148, "verse_number": "७-१०-७०", "content_sanskrit": "एवं दग्ध्वा पुरस्तिस्रो भगवान् पुरहा नृप।\nब्रह्मादिभिः स्तूयमानः स्वधाम प्रत्यपद्यत॥ ७/१०/७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.082.m4a", "display_order": 83}, {"id": 6000148083, "chapter_id": 10148, "verse_number": "७-१०-७१", "content_sanskrit": "एवंविधान्यस्य हरेः स्वमायया विडम्बमानस्य नृलोकमात्मनः।\nवीर्याणि गीतान्यृषिभिर्जगद्गुरोर्लोकान् पुनानान्यपरं वदामि किम्॥ ७/१०/७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_010/BhP_07.010.083.m4a", "display_order": 84}, {"id": 6000148084, "chapter_id": 10148, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां सप्तमस्कन्धे दशमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]