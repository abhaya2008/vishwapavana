[{"id": 2048312, "chapter_id": 2065, "verse_number": "६-११४-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2048313, "chapter_id": 2065, "verse_number": "६-११४-१", "content_sanskrit": "अर्जुनस्तु रणे शल्यं यतमानं महारथम्।\nछादयामास समरे शरैः सन्नतपर्वभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2048314, "chapter_id": 2065, "verse_number": "६-११४-२", "content_sanskrit": "सुशर्माणं कृपं चव त्रिभीस्त्रिभिरविध्यत।\nप्राग्ज्योतिषं च समरे सैन्धवं च जयद्रथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2048315, "chapter_id": 2065, "verse_number": "६-११४-३", "content_sanskrit": "चित्रसेनं विकर्णं च कृतवर्माणमेव च ।\nदुर्मर्षणं च राजेन्द्र ह्यावन्त्यौ च महारथौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2048316, "chapter_id": 2065, "verse_number": "६-११४-४", "content_sanskrit": "एकैकं त्रिभिरानर्च्छत्कङ्कबर्हिणवाजितैः ।\nशरैरतिरथो युद्धे पीडयन्वाहिनीं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2048317, "chapter_id": 2065, "verse_number": "६-११४-५", "content_sanskrit": "जयद्रथो रणे पार्थं विद्ध्वा भारत सायकैः ।\nभीमं विव्याध तरसा चित्रसेनरथे स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2048318, "chapter_id": 2065, "verse_number": "६-११४-६", "content_sanskrit": "शल्यश्च समरे जिष्णुं कृपश्च रथिनां वरः ॥\nविव्याधाते महाराज बहुधा मर्ममेदिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2048319, "chapter_id": 2065, "verse_number": "६-११४-७", "content_sanskrit": "चित्रसेनादयश्चैव पुत्रास्तव विशांपते ।\nपञ्चाभिः पञ्चभिस्तूर्णं सुंयुगे निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2048320, "chapter_id": 2065, "verse_number": "६-११४-८", "content_sanskrit": "आजघ्नुरर्जुनं सङ्ख्ये भीमसेनं च मारिष ।\nतौ तत्र रथिनां श्रेष्ठौ कौन्तेयौ भरतर्षभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2048321, "chapter_id": 2065, "verse_number": "६-११४-९", "content_sanskrit": "अपीडयेतां समरे त्रिगर्तानां महद्बलम् ।\nसुशर्माणि रणे पार्थं शरैर्नवभिराशुगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2048322, "chapter_id": 2065, "verse_number": "६-११४-१०", "content_sanskrit": "ननाद बलवन्नादं त्रासयानो महद्बलम् ।\nअन्ये च रथिनः शूरा भीमसेनधनञ्जयौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2048323, "chapter_id": 2065, "verse_number": "६-११४-११", "content_sanskrit": "विव्यधुर्निशितैर्बाणै रुक्मपुङ्खैरजिह्मगैः ।\nतेषां च रथिनां मध्ये कौन्तेयौ भरतर्षभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2048324, "chapter_id": 2065, "verse_number": "६-११४-१२", "content_sanskrit": "क्रीडमानौ रथोदारौ चित्ररूपौ व्यदृश्यताम् ।\nआमिषेप्सू गवां मध्ये सिंहाविव मदोत्कटौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2048325, "chapter_id": 2065, "verse_number": "६-११४-१३", "content_sanskrit": "छित्त्वा धनूंषि शूराणां शरांश्च बहुधा रणे ।\nपातयामासतुर्वीरौ शिरांसि शतशो नृणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2048326, "chapter_id": 2065, "verse_number": "६-११४-१४", "content_sanskrit": "रथाश्च बहवो भग्ना हयाश्च शतशो हताः।\nगजाश्च सगजारोहाः पेतुरुर्व्यां महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2048327, "chapter_id": 2065, "verse_number": "६-११४-१५", "content_sanskrit": "रथिनः सादिनश्चापि तत्रतत्र निषूदिताः।\nदृश्यन्ते बहवो राजन्वेषमानाः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2048328, "chapter_id": 2065, "verse_number": "६-११४-१६", "content_sanskrit": "हतैर्गजपदात्योघैर्वाजिभिश्च निषूदितैः।\nरथैश्च बहुधा भग्नैः समास्तीर्यत मेदिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2048329, "chapter_id": 2065, "verse_number": "६-११४-१७", "content_sanskrit": "छत्रैश्च बहुधा च्छिन्नैर्ध्वजैश्च विनिपातितैः ।\nअङ्कुशैरपविद्धैश्च परिस्तोमैश्च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2048330, "chapter_id": 2065, "verse_number": "६-११४-१८", "content_sanskrit": "केयूरैरङ्गदैर्हारै राङ्कवैर्मृदितैस्तथा ।\nउष्णीषैर्ऋष्टिभिश्चैव चामरव्यजनैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2048331, "chapter_id": 2065, "verse_number": "६-११४-१९", "content_sanskrit": "तत्रतत्रापविद्धैश्च बाहुभिश्चन्दनोक्षितैः ।\nऊरुभिश्च नरेन्द्राणां समास्तीर्यत मेदिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2048332, "chapter_id": 2065, "verse_number": "६-११४-२०", "content_sanskrit": "तत्राद्भुतमपश्याम रणे पार्थस्य विक्रमम् ।\nशरैः संवार्य तान्वीरान्यज्जघान महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2048333, "chapter_id": 2065, "verse_number": "६-११४-२१", "content_sanskrit": "पुत्रस्तु तव तं दृष्ट्वा भीमार्जुनपराक्रमम् ।\nगाङ्गेयस्य रथाभ्याशमुपजग्मे महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2048334, "chapter_id": 2065, "verse_number": "६-११४-२२", "content_sanskrit": "कृपश्च कृतवर्मा च सैन्धवश्च जयद्रथः ।\nविन्दानुविन्दावावन्त्यौ नाजहुः संयुगं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2048335, "chapter_id": 2065, "verse_number": "६-११४-२३", "content_sanskrit": "ततो भीमो महेष्वासः फल्गुनश्च महारथः ।\nकौरवाणां चमूं घोरां भृशं दुद्रुवतू रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2048336, "chapter_id": 2065, "verse_number": "६-११४-२४", "content_sanskrit": "ततो बर्हिणवाजानामयुतान्यर्बुदानि च।\nधनञ्जयरथे तूर्णं पातयन्ति स्म भूमिपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2048337, "chapter_id": 2065, "verse_number": "६-११४-२५", "content_sanskrit": "ततस्तञ्शरजालेन सन्निवार्य महारथान् ।\nपार्थः समन्तात्समरे प्रेषयामास मृत्यवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2048338, "chapter_id": 2065, "verse_number": "६-११४-२६", "content_sanskrit": "शल्यस्तु समरे जिष्णुं क्रीडन्निव महारथः ।\nआजघानोरसि क्रुद्धो भल्लैः सन्नतपर्वभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2048339, "chapter_id": 2065, "verse_number": "६-११४-२७", "content_sanskrit": "तस्य पार्थो धनुश्छित्त्वा हस्तावापं च पञ्चभिः ।\nअथैनं सायकैस्तीक्ष्णैर्भृशं विव्याध मर्मणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2048340, "chapter_id": 2065, "verse_number": "६-११४-२८", "content_sanskrit": "अथान्यद्धनुरादाय समरे भारसाधनम् ।\nमद्रेश्वरो रणे जिष्णुं ताडयामास रोषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2048341, "chapter_id": 2065, "verse_number": "६-११४-२९", "content_sanskrit": "त्रिभिः शरैर्महाराज वासुदेवं कच पञ्चभिः ।\nभीमसेनं च नवभिर्बाह्वोरुरसि चार्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2048342, "chapter_id": 2065, "verse_number": "६-११४-३०", "content_sanskrit": "ततो द्रोणो महाराज मागधश्च महारथः ।\nदुर्योधनसमादिष्टौ तं देशमुपजग्मतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2048343, "chapter_id": 2065, "verse_number": "६-११४-३१", "content_sanskrit": "यत्र पार्थो महाराज भीमसेनश्च पाण्डवः ।\nकौरव्यस्य महासेनां जघ्नुतुः सुमहारथौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2048344, "chapter_id": 2065, "verse_number": "६-११४-३२", "content_sanskrit": "जयत्सेनस्तु समरे भीमं भीमायुधं युधि।\nविव्याध निशितैर्बाणैरष्टभिर्भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2048345, "chapter_id": 2065, "verse_number": "६-११४-३३", "content_sanskrit": "तं भीमो दशभिर्विद्धा पुनर्वीव्याध पञ्चभिः ।\nसारथिं चास्य भल्लेन रथनीडादपातयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2048346, "chapter_id": 2065, "verse_number": "६-११४-३४", "content_sanskrit": "उद्भ्रांतैस्तुरगैः सोऽथ द्रवमाणैः समन्ततः ।\nमागधोऽपसृतो राजा सर्वसैन्यस्य पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2048347, "chapter_id": 2065, "verse_number": "६-११४-३५", "content_sanskrit": "द्रोणश्च विवरं दृष्ट्वा भीमसेनं शिलीमुखैः ।\nविव्याध बाणैर्निशितैः पञ्चषष्टिभिरायसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2048348, "chapter_id": 2065, "verse_number": "६-११४-३६", "content_sanskrit": "तं भीमः समरश्लाघी गुरुं पितृसमं रणे।\nविव्याध पञ्चभिर्भल्लैस्तथा षष्ट्या च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2048349, "chapter_id": 2065, "verse_number": "६-११४-३७", "content_sanskrit": "अर्जुनस्तु सुशर्माणं विद्ध्वा बहुभिरायसैः।\nव्यधमत्तस्य तत्सैन्यं महाभ्राणि यथाऽनिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2048350, "chapter_id": 2065, "verse_number": "६-११४-३८", "content_sanskrit": "ततो भीष्मश्च राज च कौसल्यश्च बृहद्बलः ।\nसमवर्तन्त संक्रुद्धा भीमसेनधनञ्जयौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2048351, "chapter_id": 2065, "verse_number": "६-११४-३९", "content_sanskrit": "तथैव पाण्डवाः शूरा धृष्टद्युम्नश्च पार्षतः ।\nअभ्यद्रवन्रणे भीष्मं व्यादितास्यमिवान्तकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2048352, "chapter_id": 2065, "verse_number": "६-११४-४०", "content_sanskrit": "शिखण्डी तु समासाद्य भरतानां पितामहम् ।\nअभ्यद्रवत संहृष्टो भयं त्यक्त्वा महारथात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2048353, "chapter_id": 2065, "verse_number": "६-११४-४१", "content_sanskrit": "युधिष्ठिरमुखाः पार्थाः पुरस्कृत्य शिखण्डिनम् ।\nअयोधयन्रणे भीष्मं सहिताः सर्वसृञ्जयैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2048354, "chapter_id": 2065, "verse_number": "६-११४-४२", "content_sanskrit": "तथैव तावकाः सर्वे पुरस्कृत्य यतव्रतम् ।\nशिखण्डिप्रमुखान्पार्थान्योधयन्ति स्म संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2048355, "chapter_id": 2065, "verse_number": "६-११४-४३", "content_sanskrit": "ततः प्रववृते युद्धं कौरवाणां भयावहम्।\nतत्र पाण्डुसुतैः सार्धं भीष्मस्य विजयं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2048356, "chapter_id": 2065, "verse_number": "६-११४-४४", "content_sanskrit": "तावकानां जये भीष्मो ग्लह आसीद्विशांपते ।\nतत्र हि द्यूतमासक्तं विजयायेतराय वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2048357, "chapter_id": 2065, "verse_number": "६-११४-४५", "content_sanskrit": "धृष्टद्युम्नस्तु राजेन्द्र सर्वसैन्यान्यचोदयत्।\nअभ्यद्रवत गाङ्गेयं मा भैष्ट रथसत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2048358, "chapter_id": 2065, "verse_number": "६-११४-४६", "content_sanskrit": "सेनापतिवचः श्रुत्वा पाण्डवानां वरूथिनी ।\nभीष्मं समभ्ययात्तूर्णं प्राणांस्त्यक्त्वा महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2048359, "chapter_id": 2065, "verse_number": "६-११४-४७", "content_sanskrit": "भीष्मोऽपि रथिनां श्रेष्ठः प्रतिजग्राह तां चमूम् ।\nआपतन्तीं महाराज वेलामिव महोदधिः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2048360, "chapter_id": 2065, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि दशमदिवसयुद्धे चतुर्दशाधिकशततमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-११४-२४ बर्हिणवाजानां मयूरपक्षवतां बाणानाम् ॥ ६-११४-३० मागधो जयत्सेनः ॥ ६-११४-३४ अपसृतः पलायितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]