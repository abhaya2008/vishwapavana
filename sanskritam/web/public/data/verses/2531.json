[{"id": 2072593, "chapter_id": 2531, "verse_number": "१२-३६-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2072594, "chapter_id": 2531, "verse_number": "१२-३६-१", "content_sanskrit": "श्रोतुमिच्छामि भगवन्विस्तरेण महामुने।\nराजधर्मान्द्विजश्रेष्ठ चातुर्वर्ण्यस्य चाखिलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2072595, "chapter_id": 2531, "verse_number": "१२-३६-२", "content_sanskrit": "आपत्सु च यथा नीतिः प्रणेतव्या द्विजोत्तम।\nधर्म्यमालम्ब्य पन्थानं विजयेयं कथं महीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2072596, "chapter_id": 2531, "verse_number": "१२-३६-३", "content_sanskrit": "प्रायश्चित्तकथा ह्येषा भक्ष्याभक्ष्यसमन्विता।\nकौतूहलानुप्रवणा हर्षं जनयतीव मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2072597, "chapter_id": 2531, "verse_number": "१२-३६-४", "content_sanskrit": "धर्मचर्या च राज्यं च नित्यमेव विरुध्यते।\nएवं मुह्यति मे चेतश्चिन्तयानस्य नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2072598, "chapter_id": 2531, "verse_number": "१२-३६-५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2072599, "chapter_id": 2531, "verse_number": "१२-३६-५", "content_sanskrit": "तमुवाच महाराज व्यासो वेदविदां वरः।\nनारदं समभिप्रेक्ष्य सर्वं जानन्पुरातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2072600, "chapter_id": 2531, "verse_number": "१२-३६-६", "content_sanskrit": "श्रोतुमिच्छसि चेद्धर्मं निखिलेन नराधिप।\nप्रेहि भीष्मं महाबाहो वृद्धं कुरुपितामहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2072601, "chapter_id": 2531, "verse_number": "१२-३६-७", "content_sanskrit": "स ते धर्मरहस्येषु संशयान्मनसि स्थितान्।\nछेत्ता भागीरथीपुत्रः सर्वज्ञः सर्वधर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2072602, "chapter_id": 2531, "verse_number": "१२-३६-८", "content_sanskrit": "जनयामास यं देवी दिव्या त्रिपथगा नदी।\nसाक्षाद्ददर्श यो देवान्सर्वानिन्द्रपुरोगमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2072603, "chapter_id": 2531, "verse_number": "१२-३६-९", "content_sanskrit": "बृहस्पतिपुरोगांस्तु देवर्षीनसकृत्प्रभुः।\nतोषयित्वोपचारेण राजनीतिमधीतवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2072604, "chapter_id": 2531, "verse_number": "१२-३६-१०", "content_sanskrit": "उशना वेद यच्छास्त्रं देवासुरगुरुर्द्विजः।\nस च धर्मं सवैयाख्यं प्राप्तवान्कुरुसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2072605, "chapter_id": 2531, "verse_number": "१२-३६-११", "content_sanskrit": "भार्गवाच्च्यवनाच्चापि वेदानङ्गोपबृंहितान्।\nप्रतिपेदे महाबुद्धिर्वसिष्ठाच्चरितव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2072606, "chapter_id": 2531, "verse_number": "१२-३६-१२", "content_sanskrit": "पितामहसुतं ज्येष्ठं कुमारं दीप्ततेजसम्।\nअध्यात्मगतितत्त्वज्ञमुपाशिक्षत यः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2072607, "chapter_id": 2531, "verse_number": "१२-३६-१३", "content_sanskrit": "मार्कण्डेयमुखात्कृत्स्नं यतिधर्ममवाप्तवान्।\nरामादस्त्राणि शक्राच्च प्राप्तवान्पुरुपर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2072608, "chapter_id": 2531, "verse_number": "१२-३६-१४", "content_sanskrit": "मृत्युरात्मेच्छया यस्य जातस्य मनुजेष्वपि।\nतथाऽनपत्यस्य सतः पुण्यलोकादिविश्रुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2072609, "chapter_id": 2531, "verse_number": "१२-३६-१५", "content_sanskrit": "यस्य ब्रह्मर्षयः पुण्या नित्यमासन्स भसादः।\nयस्य नाविदितं किंचिज्ज्ञानं ज्ञेयेषु दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2072610, "chapter_id": 2531, "verse_number": "१२-३६-१६", "content_sanskrit": "स ते वक्ष्यति धर्मज्ञः सूक्ष्मधर्मार्थतत्त्ववित्।\nतमभ्येहि पुरा प्राणान्स विमुञ्चति धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2072611, "chapter_id": 2531, "verse_number": "१२-३६-१७", "content_sanskrit": "एवमुक्तस्तु कौन्तेयो दीर्घप्रज्ञो महामतिः।\nउवाच वदतां श्रेष्ठं व्यासं सत्यवतीसुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2072612, "chapter_id": 2531, "verse_number": "१२-३६-१८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2072613, "chapter_id": 2531, "verse_number": "१२-३६-१८", "content_sanskrit": "वैशसं सुमहत्कृत्वा ज्ञातीनां रोमहर्षणम्।\nआगस्कृत्सर्वलोकस्य पृथिवीनाशकारकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2072614, "chapter_id": 2531, "verse_number": "१२-३६-१९", "content_sanskrit": "घातयित्वा तमेवाजौ छलेनाजिह्नयोधिनम्।\nउपसंप्रष्टुमर्हामि तमहं केन हेतुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2072615, "chapter_id": 2531, "verse_number": "१२-३६-२०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2072616, "chapter_id": 2531, "verse_number": "१२-३६-२०", "content_sanskrit": "ततस्तं नृपतिश्रेष्ठं चातुर्वर्ण्यहितेप्सया।\nपुनरेव महाबाहुर्यदुश्रेष्ठोऽब्रवीद्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2072617, "chapter_id": 2531, "verse_number": "१२-३६-२१x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2072618, "chapter_id": 2531, "verse_number": "१२-३६-२१", "content_sanskrit": "नेदानीमतिनिर्बन्धं शोके त्वं कर्तुमर्हसि।\nयदाह भगवान्व्यासस्तत्कुरुष्व नृपोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2072619, "chapter_id": 2531, "verse_number": "१२-३६-२२", "content_sanskrit": "ब्राह्मणास्त्वां महाबाहो भ्रातरश्च महौजसः।\nपर्जन्यमिव घर्मान्ते नाथमाना उपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2072620, "chapter_id": 2531, "verse_number": "१२-३६-२३", "content_sanskrit": "हतशिष्टाश्च राजानः कृत्स्नं चैव समागतम्।\nचातुर्वर्ण्यं महाराज राष्ट्रं ते कुरुजाङ्गलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2072621, "chapter_id": 2531, "verse_number": "१२-३६-२४", "content_sanskrit": "प्रियार्थमपि चैतेषां ब्राह्मणानां महात्मनाम्।\nनियोगादस्य च गुरोर्व्यासस्यामिततेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2072622, "chapter_id": 2531, "verse_number": "१२-३६-२५", "content_sanskrit": "सुहृदामस्मदादीनां द्रौपद्यांश्च परंतप।\nकुरु प्रियममित्रघ्न लोकस्य च हितं कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2072623, "chapter_id": 2531, "verse_number": "१२-३६-२६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2072624, "chapter_id": 2531, "verse_number": "१२-३६-२६", "content_sanskrit": "एवमुक्तः स कृष्णेन राजा राजीवलोचनः।\nहितार्थं सर्वलोकस्य समुत्तस्थौ महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2072625, "chapter_id": 2531, "verse_number": "१२-३६-२७", "content_sanskrit": "सोऽनुनीतो नरव्याघ्र विष्टरश्रवसा स्वयम्।\nद्वैपायनेन च तथा देवस्थानेन जिष्णुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2072626, "chapter_id": 2531, "verse_number": "१२-३६-२८", "content_sanskrit": "एतैश्चान्यैश्च बहुभिरनुनीतो युधिष्ठिरः।\nव्यजहान्मानसं दुःखं संतापं च महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2072627, "chapter_id": 2531, "verse_number": "१२-३६-२९", "content_sanskrit": "श्रुतवाक्यः श्रुतनिधिः श्रुतश्राव्यविशारदः।\nव्यवस्य मनसा शान्तिमगच्छत्पाण्डुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2072628, "chapter_id": 2531, "verse_number": "१२-३६-३०", "content_sanskrit": "स तैः परिवृतो राजा नक्षत्रैरिव चन्द्रमाः।\nधृतराष्ट्रं पुरस्कृत्य स्वपुरं प्रविवेश ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2072629, "chapter_id": 2531, "verse_number": "१२-३६-३१", "content_sanskrit": "प्रविविक्षुः स धर्मज्ञः कुन्तीपुत्रो युधिष्ठिरः।\nअर्चयामास देवांश्च ब्राह्मणांश्च सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2072630, "chapter_id": 2531, "verse_number": "१२-३६-३२", "content_sanskrit": "ततो नवं रथं शुभ्रं कम्बलाजिनसंवृतम्।\nयुक्तं षोडशभिस्त्वश्चैः पाण़्डुरैः शुभलक्षणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2072631, "chapter_id": 2531, "verse_number": "१२-३६-३३", "content_sanskrit": "मन्त्रैरभ्यर्चितं पण्यैः स्तूयमानश्च बन्दिभिः।\nआरुरोह यथा देवः सोमोऽम्रतमयं यथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2072632, "chapter_id": 2531, "verse_number": "१२-३६-३४", "content_sanskrit": "जग्राह रश्मीन्कौन्तेयो भीमो भीमपराक्रमः।\nअर्जुनः पाण्डुरं छत्रं धारयामास भानुमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2072633, "chapter_id": 2531, "verse_number": "१२-३६-३५", "content_sanskrit": "ध्रियमाणं च तच्छत्रं पाण्डुरं राजमूर्धनि।\nशुशुभे तारकाराजः सिताभ्र इव चाम्बरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2072634, "chapter_id": 2531, "verse_number": "१२-३६-३६", "content_sanskrit": "चामरव्यजने त्वस्य वीरौ जगृहतुस्तदा।\nचन्द्ररश्मिप्रये शुभ्रे माद्रीपुत्रावलंकृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2072635, "chapter_id": 2531, "verse_number": "१२-३६-३७", "content_sanskrit": "ते पञ्च रथमास्थाय भ्रातरः समलंकृताः।\nभूतानीव समस्तानि राजन्ददृशिरे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2072636, "chapter_id": 2531, "verse_number": "१२-३६-३८", "content_sanskrit": "आस्थाय तु रथं शुभ्रं युक्तमश्वैर्मनोजवैः।\nअन्वयात्पृष्ठतो राजन्युयुत्सुः पाण्डवाग्रजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2072637, "chapter_id": 2531, "verse_number": "१२-३६-३९", "content_sanskrit": "रथं हेममयं शुभ्रं शैव्यसुग्रीवयाजितम्।\nसह सात्यकिना कृष्णः समास्थायान्वयात्कुरून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2072638, "chapter_id": 2531, "verse_number": "१२-३६-४०", "content_sanskrit": "नरयानेन तु ज्येष्ठः पिता पार्थस्य भारत।\nअग्रतो धर्मराजस्य गान्धारीसहितो ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2072639, "chapter_id": 2531, "verse_number": "१२-३६-४१", "content_sanskrit": "कुरुस्त्रियश्च ताः सर्वाः कुन्ती कृष्णा च माधवी।\nयानैरुच्चावचैर्जग्मुर्विदुरेण पुरस्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2072640, "chapter_id": 2531, "verse_number": "१२-३६-४२", "content_sanskrit": "ततो रथाश्च बहुला नागाश्वसमलंकृताः।\nपादाताश्च हयाश्चैव पृष्ठतः समनुव्रजन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2072641, "chapter_id": 2531, "verse_number": "१२-३६-४३", "content_sanskrit": "ततो वैतालिकैः सूतैर्मागधैश्च सुभाषितैः।\nस्तूयमानो ययौ राजा नगरं नागसाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2072642, "chapter_id": 2531, "verse_number": "१२-३६-४४", "content_sanskrit": "तत्प्रयाणं माहबाहोर्बभूवाप्रतिमं भुवि।\nआकुलाकुलमुत्क्रुष्टं हृष्टपुष्टजनाकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2072643, "chapter_id": 2531, "verse_number": "१२-३६-४५", "content_sanskrit": "अभियाने तु पार्थस्य नरैर्नगरवासिभिः।\nनगरं राजमार्गाश्च यथावत्समलंकृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2072644, "chapter_id": 2531, "verse_number": "१२-३६-४६", "content_sanskrit": "पाण्डुरेण च माल्येन पताकाभिश्च मेदिनी।\nसंस्कृतो राजमार्गोऽभूद्धूपनैश्च प्रधूपितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2072645, "chapter_id": 2531, "verse_number": "१२-३६-४७", "content_sanskrit": "अथ चूर्णैश्च गन्धानां नानापुष्पप्रियङ्गुभिः।\nमाल्यदामभिरासक्तै राजवेश्माभिसंवृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2072646, "chapter_id": 2531, "verse_number": "१२-३६-४८", "content_sanskrit": "कुम्भाश्च नगरद्वारि वारिपूर्णा नवा दृढाः।\nसिताः सुमनसो गौराः स्थापितास्तत्र तत्र ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2072647, "chapter_id": 2531, "verse_number": "१२-३६-४९", "content_sanskrit": "तथा स्वलंकृतं द्वारं नगरं पाण्डुनन्दनः।\nस्तूयमानः शुभैर्वाक्यैः प्रविवेश सुहृद्वृतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2072648, "chapter_id": 2531, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि षट्त्रिंशोऽध्यायः॥ ३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]