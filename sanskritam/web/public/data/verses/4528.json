[{"id": 2163596, "chapter_id": 4528, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2163597, "chapter_id": 4528, "verse_number": "१", "content_sanskrit": "तस्मिन् विनिहते वीरे सैन्धवे सव्यसाचिना ।\nमामका यदकुर्वन्त तन्ममाचक्ष्व सञ्जय\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2163598, "chapter_id": 4528, "verse_number": "२", "content_sanskrit": "पश्यतां सर्वयोधानां मामकानां महारणे ।\nअहन्यत कथं युद्धे सैन्धवः सव्यसाचिना \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2163599, "chapter_id": 4528, "verse_number": "३", "content_sanskrit": "कथं द्रौणिकृपैर्गुप्तः कर्णेन च महारणे ।\nफल्गुनाग्निमुखं घोरं प्रविष्टः साधु सैन्धवः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2163600, "chapter_id": 4528, "verse_number": "४", "content_sanskrit": "तस्मिन् हते महेष्वासे मन्दात्मा च सुयोधनः ।\nभ्रातृभिः सहितः सूत किमकार्षीदनन्तरम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2163601, "chapter_id": 4528, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2163602, "chapter_id": 4528, "verse_number": "५", "content_sanskrit": "सैन्धवं निहतं दृष्ट्वा रणे पार्थेन मारिष ।\nअमर्षवशमापन्नः कृपः शारद्वतस्तदा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2163603, "chapter_id": 4528, "verse_number": "६", "content_sanskrit": "महता शरवर्षेण पाण्डवं समवाकिरत् ।\nद्रौणिश्चाभ्यद्रवत्पार्थं रथमास्थाय फल्गुनम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2163604, "chapter_id": 4528, "verse_number": "७", "content_sanskrit": "तावेनं रथिनां श्रेष्ठौ रथाभ्यां रथसत्तमम् ।\nउभावुभयतस्तीक्ष्णैर्विशिखैरभ्यवर्षताम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2163605, "chapter_id": 4528, "verse_number": "८", "content_sanskrit": "स तथा शरवर्षाभ्यां सुमहद्भ्यां महाभुजः ।\nपीड्यमानः परामार्तिमगमद् रथिनां वरः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2163606, "chapter_id": 4528, "verse_number": "९", "content_sanskrit": "सोऽजिघांसुर्गुरुं सङ्खे गुरोस्तनयमेव च ।\nचकाराचार्यकं तत्र कुन्तीपुत्रो धनञ्जयः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2163607, "chapter_id": 4528, "verse_number": "१०", "content_sanskrit": "अस्त्रैरस्त्राणि संवार्य द्रौणेः शारद्वतस्य च ।\nमन्दवेगानिषूंस्ताभ्यामजिघांसुरवासृजत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2163608, "chapter_id": 4528, "verse_number": "११", "content_sanskrit": "ते चापि भृशमभ्यघ्नन् विशिखा जयचोदिताः ।\nबहुत्वात्तु परामार्तिं शराणां तावगच्छताम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2163609, "chapter_id": 4528, "verse_number": "१२", "content_sanskrit": "अथ शारद्वतो राजन् कौन्तेयशरपीडितः ।\nअवासीदद् रथोपस्थे मूर्च्छामभिजगाम ह\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2163610, "chapter_id": 4528, "verse_number": "१३", "content_sanskrit": "विह्वलं तमभिज्ञाय भर्तारं शरपीडितम् ।\nहतोऽयमिति च ज्ञात्वा सारथिस्तमपावहत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2163611, "chapter_id": 4528, "verse_number": "१४", "content_sanskrit": "तस्मिन् सन्ने महाराज कृपे शारद्वते युधि ।\nअश्वत्थामाप्यपायासीत् पाण्डवेयाद् रथान्तरम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2163612, "chapter_id": 4528, "verse_number": "१५", "content_sanskrit": "दृष्ट्वा शारद्वतं पार्थो मूर्च्छितं शरपीडितम् ।\nरथ एव महेष्वासः कृपणं पर्यदेवयत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2163613, "chapter_id": 4528, "verse_number": "१६", "content_sanskrit": "अश्रुपूर्णमुखो दीनो वचनं चेदमब्रवीत् ।\nपश्यन्निदं महाप्राज्ञः क्षत्ता राजानमुक्तवान् ।\nकुलान्तकरणे पापे जातमात्रे सुयोधने\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2163614, "chapter_id": 4528, "verse_number": "१७", "content_sanskrit": "नीयतां परलोकाय साध्वयं कुलपांसनः ।\nअस्माद्धि कुरुमुख्यानां महदुत्पत्स्यते भयम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2163615, "chapter_id": 4528, "verse_number": "१८", "content_sanskrit": "तदिदं समनुप्राप्तं वचनं सत्यवादिनः ।\nतत्कृते ह्यद्य पश्यामि शरतल्पगतं कृपम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2163616, "chapter_id": 4528, "verse_number": "१९", "content_sanskrit": "धिगस्तु क्षात्रमाचारं धिगस्तु बलपौरुषम् ।\nको हि ब्राह्मणमाचार्यमभिद्रुह्येत मादृशः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2163617, "chapter_id": 4528, "verse_number": "२०", "content_sanskrit": "ऋषिपुत्रो ममाचार्यो द्रोणस्य दयितः सखा ।\nएष शेते रथोपस्थे मद्बाणैरभिपीडितः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2163618, "chapter_id": 4528, "verse_number": "२१", "content_sanskrit": "अकामयानेन मया विशिखैरर्दितो भृशम् ।\nअवासीदद् रथोपस्थे प्राणान् पीडयतीव मे\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2163619, "chapter_id": 4528, "verse_number": "२२", "content_sanskrit": "शरार्दितेन हि मया प्रेक्षणीयो महाद्युतिः ।\nपुत्रशोकाभिभूतेन शरैरभ्यर्दितेन च ।\nअभ्यस्तो बहुभिर्बाणैर्दशधर्मगतेन वै\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2163620, "chapter_id": 4528, "verse_number": "२३", "content_sanskrit": "शोचयत्येष निपतन् भूयः पुत्रवधाद्धि माम् ।\nकृपणं स्वरथे सन्नं पश्य कृष्ण यथागतम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2163621, "chapter_id": 4528, "verse_number": "२४", "content_sanskrit": "उपाकृत्य स्म विद्यां वा आचार्येभ्यो नरर्षभाः ।\nप्रयच्छन्तीह ये कामान् देवत्वमुपयान्ति ते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2163622, "chapter_id": 4528, "verse_number": "२५", "content_sanskrit": "ये तु विद्यामुपादाय गुरुभ्यः पुरुषाधमाः ।\nघ्नन्ति तानेव दुर्वृत्तास्ते वै निरयगामिनः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2163623, "chapter_id": 4528, "verse_number": "२६", "content_sanskrit": "तदिदं नरकायाद्य कृतं कर्म मया ध्रुवम् ।\nआचार्यं शरवर्षेण रथे सादयता कृपम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2163624, "chapter_id": 4528, "verse_number": "२७", "content_sanskrit": "यत्तत् पूर्वमुपाकुर्वन्नस्त्रं मामब्रवीत् कृपः ।\nन कथञ्चन कौरव्य प्रहर्तव्यं गुराविति\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2163625, "chapter_id": 4528, "verse_number": "२८", "content_sanskrit": "तदिदं वचनं साधोराचार्यस्य महात्मनः ।\nनानुष्ठितं तमेवाजौ विशिखैरभिवर्षता\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2163626, "chapter_id": 4528, "verse_number": "२९", "content_sanskrit": "नमस्तस्मै सुपूज्याय गौतमायापलायिने ।\nधिगस्तु मम वार्ष्णेय यो ह्यस्मै प्रहराम्यहम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2163627, "chapter_id": 4528, "verse_number": "३०", "content_sanskrit": "तथा विलपमाने तु सव्यसाचिनि तं प्रति ।\nसैन्धवं निहतं दृष्ट्वा राधेयः समुपाद्रवत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2163628, "chapter_id": 4528, "verse_number": "३१", "content_sanskrit": "तमापतन्तं राधेयमर्जुनस्य रथं प्रति ।\nपाञ्चाल्यौ सात्यकिश्चैव सहसा समुपाद्रवन् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2163629, "chapter_id": 4528, "verse_number": "३२", "content_sanskrit": "उपायान्तं तु राधेयं दृष्ट्वा पार्थो महारथः ।\nप्रहसन् देवकीपुत्रमिदं वचनमब्रवीत्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2163630, "chapter_id": 4528, "verse_number": "३३", "content_sanskrit": "एष प्रयात्याधिरथिः सात्यकेः स्यन्दनं प्रति ।\nन मृष्यति हतं नूनं भूरिश्रवसमाहवे\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2163631, "chapter_id": 4528, "verse_number": "३४", "content_sanskrit": "यत्र यात्येष तत्र त्वं चोदयाश्वान् जनार्दन ।\nमा सौमदत्तेः पदवीं गमयेत् सात्यकिं वृषः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2163632, "chapter_id": 4528, "verse_number": "३५", "content_sanskrit": "एवमुक्तो महाबाहुः केशवः सव्यसाचिना ।\nप्रत्युवाच महातेजाः कालयुक्तमिदं वचः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2163633, "chapter_id": 4528, "verse_number": "३६", "content_sanskrit": "अलमेष महाबाहुः कर्णायैको हि पाण्डव ।\nकिं पुनर्द्रौपदेयाभ्यां सहितः सात्वतर्षभः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2163634, "chapter_id": 4528, "verse_number": "३७", "content_sanskrit": "न च तावत् क्षमः पार्थ कर्णेन तव सङ्गरः ।\nप्रज्वलन्ती महोल्केव तिष्ठत्यस्य हि वासवी ।\nत्वदर्थं पूज्यमानैषा रक्ष्यते परवीरहन्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2163635, "chapter_id": 4528, "verse_number": "३८", "content_sanskrit": "अतः कर्णः प्रयात्वत्र सात्वतस्य यथा तथा ।\nअहं ज्ञास्यामि कौरव्य कालमस्य दुरात्मनः ।\nयत्रैनं विशिखैस्तीक्ष्णैः पातयिष्यसि भूतळे\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2163636, "chapter_id": 4528, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2163637, "chapter_id": 4528, "verse_number": "३९", "content_sanskrit": "योऽसौ कर्णेन वीरेण वार्ष्णेयस्य समागमः ।\nहते तु भूरिश्रवसि सैन्धवे च निपातिते\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2163638, "chapter_id": 4528, "verse_number": "४०", "content_sanskrit": "सात्यकिश्चापि विरथः कं समारूढवान् रथम् ।\nचक्ररक्षौ च पाञ्चाल्यौ तन्ममाचक्ष्व सञ्जय\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2163639, "chapter_id": 4528, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2163640, "chapter_id": 4528, "verse_number": "४१", "content_sanskrit": "हन्त ते वर्णयिष्यामि यथावृत्तं महारणे ।\nशुश्रूषस्व स्थिरो भूत्वा दुराचरितमात्मनः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2163641, "chapter_id": 4528, "verse_number": "४२", "content_sanskrit": "पूर्वमेव हि कृष्णस्य मनोगतमिदं प्रभो ।\nविजेतव्यो यथा वीरः सात्यकिर्यूपकेतुना\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2163642, "chapter_id": 4528, "verse_number": "४३", "content_sanskrit": "अतीतानागतं राजन् स हि वेत्ति जनार्दनः ।\nअतः सूतं समाहूय दारुकं सन्दिदेश ह ।\nरथो मे युज्यतां काल्यमिति राजन् महाबलः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2163643, "chapter_id": 4528, "verse_number": "४४", "content_sanskrit": "न हि देवा न गन्धर्वा न यक्षोरगराक्षसाः ।\nमानवा वा विजेतारः कृष्णयोः स्यन्दनस्थयोः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2163644, "chapter_id": 4528, "verse_number": "४५", "content_sanskrit": "पितामहपुरोगाश्च देवाः सिद्धाश्च तं विदुः ।\nतयोः प्रभावमतुलं शृणु युद्धं च तद्यथा\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2163645, "chapter_id": 4528, "verse_number": "४५", "content_sanskrit": "सात्यकिं विरथं दृष्ट्वा कर्णं चाभ्युद्यतायुधम् ।\nदध्मौ शङ्खं महानादमार्षभेणैव पूरितम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2163646, "chapter_id": 4528, "verse_number": "४६", "content_sanskrit": "दारुकोऽवेत्य सन्देशं श्रुत्वा शङ्खस्य च स्वनम् ।\nरथमन्वानयत् तस्मै सुपर्णोच्छ्रितकेतनम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2163647, "chapter_id": 4528, "verse_number": "४७", "content_sanskrit": "स केशवस्यानुमते रथं दारुकसंयुतम् ।\nआरुरोह शिनेः पौत्रो ज्वलनादित्यसन्निभम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2163648, "chapter_id": 4528, "verse_number": "४८", "content_sanskrit": "कामगैः सैन्यसुग्रीवमेघपुष्पबलाहकैः ।\nहयोदग्रैर्महावेगैर्हेमभाण्डविभूषितैः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2163649, "chapter_id": 4528, "verse_number": "४९", "content_sanskrit": "युक्तं समारुह्य च तं विमानप्रतिमं रथम् ।\nअभ्यद्रवत राधेयं प्रवपन् सायकान् बहून्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2163650, "chapter_id": 4528, "verse_number": "५०", "content_sanskrit": "चक्ररक्षावपि तदा युधामन्यूत्तमौजसौ ।\nधनञ्जयरथं हित्वा राधेयं प्रत्युदीययुः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2163651, "chapter_id": 4528, "verse_number": "५१", "content_sanskrit": "राधेयोऽपि महाराज शरवर्षं समुत्सृजन् ।\nअभ्यद्रवत् सुसङ्क्रुद्धो रणे शैनेयमच्युतम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2163652, "chapter_id": 4528, "verse_number": "५२", "content_sanskrit": "नैव दैवं न गान्धर्वं नासुरोरगराक्षसम् ।\nतादृशं भुवि वा युद्धं दिवि वा श्रुतमित्युत\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2163653, "chapter_id": 4528, "verse_number": "५३", "content_sanskrit": "उपारमत तत् सैन्यं सरथाश्वनरद्विपम् ।\nतयोर्दृष्ट्वा महाराज कर्म सम्मूढचेतनम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2163654, "chapter_id": 4528, "verse_number": "५४", "content_sanskrit": "सर्वे च समपश्यन्त तद्युद्धमतिमानुषम् ।\nतयोर्नृवरयो राजन् सारथ्यं दारुकस्य च\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2163655, "chapter_id": 4528, "verse_number": "५५", "content_sanskrit": "गतप्रत्यागतावृत्तैर्मण्डलैः सन्निवर्तनैः ।\nसारथेस्तु रथस्थस्य काश्यपेयस्य विस्मिताः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2163656, "chapter_id": 4528, "verse_number": "५६", "content_sanskrit": "नभस्तळगताश्चैव देवगन्धर्वदानवाः ।\nअतीवावहिता द्रष्टुं कर्णशैनेययो रणम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2163657, "chapter_id": 4528, "verse_number": "५७", "content_sanskrit": "मित्रार्थे तौ पराक्रान्तौ स्पर्धिनौ शुष्मिणौ रणे ।\nकर्णश्चामरसङ्काशो युयुधानश्च सात्यकिः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2163658, "chapter_id": 4528, "verse_number": "५८", "content_sanskrit": "अन्योन्यं तौ महाराज शरवर्षैरवर्षताम् ।\nप्रममाथ शिनेः पौत्रं कर्णः सायकवृष्टिभिः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2163659, "chapter_id": 4528, "verse_number": "५९", "content_sanskrit": "अमृष्यमाणो निधनं कौरव्यजलसन्धयोः ।\nकर्णः शोकसमाविष्टो महोरग इव श्वसन्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2163660, "chapter_id": 4528, "verse_number": "६०", "content_sanskrit": "स शैनेयं रणे क्रुद्धः प्रदहन्निव चक्षुषा ।\nअभ्यद्रवत वेगेन पुनः पुनररिन्दमः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2163661, "chapter_id": 4528, "verse_number": "६१", "content_sanskrit": "तं तु सम्प्रेक्ष्य सङ्क्रुद्धं सात्यकिः प्रत्यविद्ध्यत ।\nमहता शरवर्षेण गजः प्रतिगजं यथा\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2163662, "chapter_id": 4528, "verse_number": "६२", "content_sanskrit": "तौ समेत्य नरव्याघ्रौ व्याघ्राविव तरस्विनौ ।\nअन्योन्यं सन्ततक्षाते रणेऽनुपमविक्रमौ\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2163663, "chapter_id": 4528, "verse_number": "६३", "content_sanskrit": "ततः कर्णं शिनेः पौत्रः सर्वपारशवैः शरैः ।\nबिभेद सर्वगात्रेषु पुनः पुनररिन्दमः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2163664, "chapter_id": 4528, "verse_number": "६४", "content_sanskrit": "सारथिं चास्य भल्लेन रथनीडादपाहरत् ।\nअश्वांश्च चतुरः श्वेतान् निजघ्ने निशितैः शरैः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2163665, "chapter_id": 4528, "verse_number": "६५", "content_sanskrit": "छित्त्वा ध्वजं शतेनैव शतधा पुरुषर्षभः ।\nचकार विरथं कर्णं तव पुत्रस्य पश्यतः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2163666, "chapter_id": 4528, "verse_number": "६६", "content_sanskrit": "ततो विमनसो राजंस्तावकाः पुरुषर्षभाः ।\nवृषसेनः कर्णसुतः शल्यो मद्राधिपस्तथा\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2163667, "chapter_id": 4528, "verse_number": "६७", "content_sanskrit": "द्रोणपुत्रश्च शैनेयं सर्वतः पर्यवारयन् ।\nततः पर्याकुलं सर्वं न प्राज्ञायत किञ्चन\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2163668, "chapter_id": 4528, "verse_number": "६८", "content_sanskrit": "तथा सात्यकिना वीरे विरथे सूतजे कृते ।\nहाहाकारस्ततो राजन् सर्वसैन्येषु चाभवत्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2163669, "chapter_id": 4528, "verse_number": "६९", "content_sanskrit": "कर्णोऽपि विह्वलो राजन् सात्वतेनार्दितः शरैः ।\nदुर्योधनरथं राजन्नारुरोह विनिःश्वसन्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2163670, "chapter_id": 4528, "verse_number": "७०", "content_sanskrit": "मानयंस्तव पुत्रस्य बाल्यात् प्रभृति सौहृदम् ।\nकृतां राज्यप्रदानेन प्रतिज्ञां परिपालयन्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2163671, "chapter_id": 4528, "verse_number": "७१", "content_sanskrit": "तथा तु विरथे कर्णे पुत्रान् वै तव पार्थिव ।\nदुःशासनमुखान् शूरान् नावधीत् सात्यकिर्वशी\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2163672, "chapter_id": 4528, "verse_number": "७२", "content_sanskrit": "रक्षन् प्रतिज्ञां च पुनर्भीमसेनकृतां पुरा ।\nविरथान् विह्वलांश्चक्रे न तु प्राणैर्व्ययोजयत्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2163673, "chapter_id": 4528, "verse_number": "७३", "content_sanskrit": "भीमसेनेन तु वधः पुत्राणां ते प्रतिश्रुतः ।\nपुनर्द्यूते च पार्थेन वधः कर्णस्य संश्रुतः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2163674, "chapter_id": 4528, "verse_number": "७४", "content_sanskrit": "वधे त्वकुर्वन् यत्नं ते तस्य कर्णमुखास्तदा ।\nनाशक्नुवंश्च तं हन्तुं सात्यकिं प्रवरा रथाः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2163675, "chapter_id": 4528, "verse_number": "७५", "content_sanskrit": "द्रौणिश्च कृतवर्मा च तथैवान्ये महारथाः ।\nनिर्जिता धनुषैकेन शतशः क्षत्रियर्षभाः ।\nकाङ्क्षता परलोकं च धर्मराजस्य च प्रियम्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2163676, "chapter_id": 4528, "verse_number": "७६", "content_sanskrit": "कृष्णयोः सदृशो वीर्ये सात्यकिः शत्रुकर्शनः ।\nकृष्णो वापि भवेल्लोके पार्थो वापि धनुर्धरः ।\nशैनेयो वा नरव्याघ्रश्चतुर्थो नोपलभ्यते\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2163677, "chapter_id": 4528, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2163678, "chapter_id": 4528, "verse_number": "७७", "content_sanskrit": "अजय्यं रथमास्थाय वासुदेवस्य सात्यकिः ।\nविरथं कृतवान् कर्णं वासुदेवसमो युवा\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2163679, "chapter_id": 4528, "verse_number": "७८", "content_sanskrit": "दारुकेण समायुक्तं स्वबाहुबलदर्पितः ।\nकच्चिदन्यं समारूढः स रथं सात्यकिः पुनः\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2163680, "chapter_id": 4528, "verse_number": "७९", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं कुशलो ह्यसि भाषितुम् ।\nअसँह्यं तमहं मन्ये तन्ममाचक्ष्व सञ्जय\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2163681, "chapter_id": 4528, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2163682, "chapter_id": 4528, "verse_number": "८०", "content_sanskrit": "शृणु राजन् यथा तस्य रथमन्यं महामतिः ।\nदारुकस्यानुजस्तूर्णं कल्पनाविधिकल्पितम्\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2163683, "chapter_id": 4528, "verse_number": "८१", "content_sanskrit": "आयसैः काञ्चनैश्चापि पट्टैर्नद्धं सकूबरम् ।\nतारासहस्रखचितं सिंहध्वजपताकिनम्\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2163684, "chapter_id": 4528, "verse_number": "८२", "content_sanskrit": "अश्वैर्वातजवैर्युक्तं हेमभाण्डपरिच्छदैः ।\nपाण्डरैरिन्दुसङ्काशैः सर्वशब्दातिगैर्दृढैः\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2163685, "chapter_id": 4528, "verse_number": "८३", "content_sanskrit": "चित्रकाञ्चनसन्नाहैर्वाजिमुख्यैर्विशांपते ।\nघण्टाजालाकुलरवं शक्तितोमरविद्युतम्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2163686, "chapter_id": 4528, "verse_number": "८४", "content_sanskrit": "वृतं साङ्ग्रामिकैर्द्रव्यैर्बहुशस्त्रपरिच्छदम् ।\nरथं सम्पादयामास मेघगम्भीरनिस्वनम्\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2163687, "chapter_id": 4528, "verse_number": "८५", "content_sanskrit": "तं समारुह्य शैनेयस्तव सैन्यमुपाद्रवत् ।\nदारुकोऽपि यथाकामं प्रययुः केशवान्तिकम्\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2163688, "chapter_id": 4528, "verse_number": "८६", "content_sanskrit": "कर्णस्यापि महाराज शङ्खगोक्षीरपाण्डरैः ।\nचित्रकाञ्चनसन्नाहैः सदश्वैर्वेगवत्तरैः\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2163689, "chapter_id": 4528, "verse_number": "८७", "content_sanskrit": "हेमकक्ष्याध्वजोपेतं क्लृप्तयन्त्रपताकिनम् ।\nअग्र्यं रथं सुयन्तारं बहुशस्त्रपरिच्छदम्\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2163690, "chapter_id": 4528, "verse_number": "८८", "content_sanskrit": "उपाजह्रुस्तमास्थाय कर्णोऽप्यभ्यद्रवद् रिपून् ।\nएतत्ते सर्वमाख्यातं यन्मां त्वं परिपृच्छसि\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2163691, "chapter_id": 4528, "verse_number": "८९", "content_sanskrit": "भूयश्चापि निबोध त्वं तवापनयजं क्षयम् ।\nएकत्रिंशत्तव सुता भीमसेनेन पातिताः\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2163692, "chapter_id": 4528, "verse_number": "९०", "content_sanskrit": "दुर्मुखं प्रमुखे कृत्वा सततं चित्रयोधिनम् ।\nशतशो निहताः शूराः सात्वतेनार्जुनेन च\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2163693, "chapter_id": 4528, "verse_number": "९१", "content_sanskrit": "भीष्मं प्रमुखतः कृत्वा भगदत्तं च मारिष ।\nएवमेष क्षयो वृत्तो राजन् दुर्मन्त्रिते तव\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2163694, "chapter_id": 4528, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि त्रयस्त्रिंशशदधिकशततमोऽध्यायः ॥ १३३ ॥\nघटोत्कचवधपर्वणि प्रथमोऽध्यायः ॥ १ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}]