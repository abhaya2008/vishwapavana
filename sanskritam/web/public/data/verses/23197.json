[{"id": 7003197000, "chapter_id": 23197, "verse_number": "४-१३३-१", "content_sanskrit": "अथ त्रयस्त्रिंशदधिकशततमोऽध्यायः ।\nशौनक उवाच ।\nअध्य मे सफलं जन्म चीवितं च सुजीवितम् ।\nयत्फलं ब्रह्मवैवर्ते निर्विघ्नं मोक्षकारणम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003197001, "chapter_id": 23197, "verse_number": "४-१३३-२", "content_sanskrit": "अभयं देहि हे वत्स हे तात मह्यमेव च ।\nतदा निवेदनं किंचिदस्तीति च करोम्यहम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003197002, "chapter_id": 23197, "verse_number": "४-१३३-३", "content_sanskrit": "सूत उवाच ।\nत्यज भीतिं महाभाग प्रश्नं कुरु यदिच्छसि ।\nसर्वं ते कथयिष्यामि यद्यद्गोप्यं मनोहरम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003197003, "chapter_id": 23197, "verse_number": "४-१३३-४", "content_sanskrit": "शौनक उवाच ।\nअधुना श्रोतुमिच्छामि पुराणानां च लक्षणम् ।\nसंख्यानमपि तेषां च फलमस्यैव पुत्रक ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003197004, "chapter_id": 23197, "verse_number": "४-१३३-५", "content_sanskrit": "सूत उवाच ।\nविस्तराणि पुराणानि चेतिहासश्च शौनक ।\nसंहितां पञ्चरात्राणि कथयामि यथागतम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003197005, "chapter_id": 23197, "verse_number": "४-१३३-६", "content_sanskrit": "सर्गश्च प्रतिसर्गश्च वंशो मन्वन्तराणि च ।\nवंशानुचरितं विप्र पुराणं पञ्चलक्षणम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003197006, "chapter_id": 23197, "verse_number": "४-१३३-७", "content_sanskrit": "एतदुपपुराणानां लक्षणं च विदुर्बुधाः ।\nमहतां च पुराणानां लक्षणं कथयामि ते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003197007, "chapter_id": 23197, "verse_number": "४-१३३-८", "content_sanskrit": "सृष्टिश्चापि विसृष्टिश्च स्थितिस्तेषां च पालनम् ।\nकर्मणां वासना वार्तामनूनां चाक्रमेण च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003197008, "chapter_id": 23197, "verse_number": "४-१३३-९", "content_sanskrit": "वर्णनं प्रलयानां च मौक्षस्य च निरूपणम् ।\nउत्कीर्तनं हरेरेव वेदानां च पृथक्पृथक् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003197009, "chapter_id": 23197, "verse_number": "४-१३३-१०", "content_sanskrit": "दशाधिकं लक्षणं च महतां परिकीर्तितम् ।\nसंख्यानं च पुराणानां निबोध कथयामि ते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003197010, "chapter_id": 23197, "verse_number": "४-१३३-११", "content_sanskrit": "परं ब्रह्मपुराणं च सहस्राणां दशैव तु ।\nपञ्चोनषष्टिसाहस्रं पाद्ममेव प्रकीर्तितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003197011, "chapter_id": 23197, "verse_number": "४-१३३-१२", "content_sanskrit": "त्रयोविंशतिसाहस्रं वैष्णवं च विदुर्बुधाः ।\nचतुर्विंशतिसाहस्रं शैवं चैव निरूपितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003197012, "chapter_id": 23197, "verse_number": "४-१३३-१३", "content_sanskrit": "ग्रन्थोऽष्टादशसाहस्रं श्रीमद्भागवतं विदुः ।\nपञ्चविंशतिसाहस्रं नारदीयं प्रकीर्तितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003197013, "chapter_id": 23197, "verse_number": "४-१३३-१४", "content_sanskrit": "मार्कण्डं नवसाहस्रं पुराणं पण्डिता विदुः ।\nचतुःशताधिकं पञ्चदशसाहस्रमेव च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003197014, "chapter_id": 23197, "verse_number": "४-१३३-१५", "content_sanskrit": "परमग्निपुराणं च रुचिरं परिसीर्तितम् ।\nचतुर्दशसहस्राणि परं पञ्चशताधिकम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003197015, "chapter_id": 23197, "verse_number": "४-१३३-१६", "content_sanskrit": "पुराणप्रवरं चैव भविष्यं परिकीर्तितम् ।\nअष्टादशसहस्रं च ब्रह्मवैवर्तमीप्सितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003197016, "chapter_id": 23197, "verse_number": "४-१३३-१७", "content_sanskrit": "सर्वेषां च पुराणानां सारमेव विदुर्बुधाः ।\nएकादशसहस्रं तु परं लिङ्गपुराणकम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003197017, "chapter_id": 23197, "verse_number": "४-१३३-१८", "content_sanskrit": "चतुर्विंशतिसाहस्रं वाराहं परिकीर्तितम् ।\nएकाशीतिसहस्रं च परमेव शताधिकम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003197018, "chapter_id": 23197, "verse_number": "४-१३३-१९", "content_sanskrit": "वरं स्कन्दपुराणं च सद्भिरेवं निरूपितम् ।\nवामनं दशसाहस्रं कौर्म सप्तदशैव तु ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003197019, "chapter_id": 23197, "verse_number": "४-१३३-२०", "content_sanskrit": "मात्स्यं चतुर्दश प्रोक्तं पुराणं पण्डितैस्तथा ।\nऊनविशतिसाहस्रं गारुडं परिकीर्तितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003197020, "chapter_id": 23197, "verse_number": "४-१३३-२१", "content_sanskrit": "परं द्वादशसाहस्रं ब्रह्माढं परिकीर्तितम् ।\nएवं पुराणसंख्यानं चतुर्लक्षमुदाहृतम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003197021, "chapter_id": 23197, "verse_number": "४-१३३-२२", "content_sanskrit": "अष्टादशपुराणानामेवमेव विदुर्बुधाः ।\nएवं चोपपुराणानामष्टादश प्रकीर्तिता ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003197022, "chapter_id": 23197, "verse_number": "४-१३३-२३", "content_sanskrit": "इतिहासो भारतं च वान्मीकं काव्यमेव च ।\nपञ्चकं पञ्चरात्राणां कृष्णमाहात्म्यपूर्वकम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003197023, "chapter_id": 23197, "verse_number": "४-१३३-२४", "content_sanskrit": "वसिष्ठं नारदीयं च कापिलं गौतमीयकम् ।\nपरं सनत्कुमारीयं पञ्चरात्रं च पञ्चकम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003197024, "chapter_id": 23197, "verse_number": "४-१३३-२५", "content_sanskrit": "पञ्चकं सहितानां च कृष्णभक्तिसमन्वितम् ।\nब्रह्मणाश्च शिवस्यापि प्रह्लादस्य तथैव च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003197025, "chapter_id": 23197, "verse_number": "४-१३३-२६", "content_sanskrit": "गौतमस्य कुमारस्य संहिताः परिकीर्तिताः ।\nइति ते कथितं सर्व क्रमेण च पृथक्पृथक् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003197026, "chapter_id": 23197, "verse_number": "४-१३३-२७", "content_sanskrit": "अस्त्येवं विपुलं शास्त्रं ममापि च यथागमम् ।\nउवाचेदं पुराणं च गोलोके रासमण्डले ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003197027, "chapter_id": 23197, "verse_number": "४-१३३-२८", "content_sanskrit": "श्रीकृष्णो भगवान्साक्षाद्ब्रह्माणं च स्वभक्तकम् ।\nब्रह्मा धर्म च धर्मिष्ठं धर्मो नारायणं मुनिम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003197028, "chapter_id": 23197, "verse_number": "४-१३३-२९", "content_sanskrit": "नारायणो नारदं च नारदो मां च भक्तकम् ।\nअहं त्वां च मुनिश्रेष्ठ वरिष्ठं कथयामि तत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003197029, "chapter_id": 23197, "verse_number": "४-१३३-३०", "content_sanskrit": "सुदर्लभं पुराणं च ब्रह्मवैवर्तमीप्सितम् ।\nयद्वृणोत्येव विश्वौघं जीविनां परमात्मकम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003197030, "chapter_id": 23197, "verse_number": "४-१३३-३१", "content_sanskrit": "तद्ब्रह्म साक्षिरूपं च कर्मणामेव कर्मिणाम् ।\nतद्ब्रह्म विवृतं यत्र तद्विभूतिमनुत्तमाम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003197031, "chapter_id": 23197, "verse_number": "४-१३३-३२", "content_sanskrit": "तेनेदं ब्रह्मवैवर्तमित्येवं च बिदुर्बुधाः ।\nपुण्यप्रदं पुराणं च मङ्गलं मङ्गलप्रदम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003197032, "chapter_id": 23197, "verse_number": "४-१३३-३३", "content_sanskrit": "सुगोप्यं च रहस्यं च यत्र रम्यं नवं नवम् ।\nहरिभक्तिप्रदं चैव दुर्लभं हरिदास्यदम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003197033, "chapter_id": 23197, "verse_number": "४-१३३-३४", "content_sanskrit": "सुखदं ब्रह्मदं सारं शोकसंतापनाशनम् ।\nसरितां च यथा गङ्गा सद्यो मुक्तिप्रदा शुभा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003197034, "chapter_id": 23197, "verse_number": "४-१३३-३५", "content_sanskrit": "तिर्थातां पुष्करं शुद्धं यथा काशी पुरीषु च ।\nसर्वेषु भारतं वर्षं सद्यो मुक्तिप्रदं शुभम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003197035, "chapter_id": 23197, "verse_number": "४-१३३-३६", "content_sanskrit": "यथा सुमेरुः शैलेषु पारिजातं च पुष्पतः ।\nपत्रेषु तुलसीपत्रं व्रतेष्वेकादशीव्रतम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003197036, "chapter_id": 23197, "verse_number": "४-१३३-३७", "content_sanskrit": "वृक्षेषु कल्पवृक्षश्च श्रीकृष्णश्च सुरेषु च ।\nज्ञानीन्द्रेषु महादेवो योगीन्द्रेषु गणेश्वरः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003197037, "chapter_id": 23197, "verse_number": "४-१३३-३८", "content_sanskrit": "सिद्धेन्द्रेष्वेव कपिलः सूर्यस्तेजस्विनां यथा ।\nसनत्कुमारो भगवान्वैष्णवेषु यथाऽग्रणीः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003197038, "chapter_id": 23197, "verse_number": "४-१३३-३९", "content_sanskrit": "भूपेषु च यथा रामो लक्ष्मणश्च धनुष्मताम् ।\nदेवीषु च यथा दुर्गा महापुण्यवती सती ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003197039, "chapter_id": 23197, "verse_number": "४-१३३-४०", "content_sanskrit": "प्राणाधिका यथा राधा कृष्णस्य प्रेयसीषु च ।\nईश्वरीषु यथा लक्ष्मीः पण्डितेषु सरस्वती ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003197040, "chapter_id": 23197, "verse_number": "४-१३३-४१", "content_sanskrit": "तथा सर्वपुराणेषु ब्रह्मवैवर्तमेव च ।\nनातो दिशिष्टं सुखदं मधुरं च सुपुण्यदम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003197041, "chapter_id": 23197, "verse_number": "४-१३३-४२", "content_sanskrit": "संदेहभञ्जनं चैव पुराणं परिकीर्तितम् ।\nइह लोके च सुखदं सुप्रदं सर्वसंपदाम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003197042, "chapter_id": 23197, "verse_number": "४-१३३-४३", "content_sanskrit": "शुभदं पुण्यदं चैव विघ्ननिघ्नकरं परम् ।\nहरिदास्यप्रदं चैव परलोके प्रहर्षदम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003197043, "chapter_id": 23197, "verse_number": "४-१३३-४४", "content_sanskrit": "यज्ञानामपि तीर्थानां व्रतानां तपसां तथा ।\nभुवः प्रदक्षिणस्यापि फलं नास्य समानकम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003197044, "chapter_id": 23197, "verse_number": "४-१३३-४५", "content_sanskrit": "चतुर्णामपि वेदानां पाठादपि वरं फलम् ।\nश्रृणोतीदं पुराणं च संयतश्चेह पुत्रक ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003197045, "chapter_id": 23197, "verse_number": "४-१३३-४६", "content_sanskrit": "गुणवन्तं च विद्वांसं वैष्णवं पुत्रमालभेत् ।\nश्रृणोति दुर्भगा चेत्तु सौभाग्यं स्वामिनो लभेत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003197046, "chapter_id": 23197, "verse_number": "४-१३३-४७", "content_sanskrit": "मृतवत्सा काकवन्ध्या महावन्ध्या च पापिनी ।\nपुराणश्रवणाल्लेभे पुत्रं च चिरचीविनम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003197047, "chapter_id": 23197, "verse_number": "४-१३३-४८", "content_sanskrit": "अपुत्रो लभते पुत्रमभार्यो लभते प्रियाम् ।\nअस्पष्टकीर्तिः सुयशा मूर्खो भवति पण्डितः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003197048, "chapter_id": 23197, "verse_number": "४-१३३-४९", "content_sanskrit": "रोगार्तो मुच्यते रोगाद्बद्धो मुच्येत बन्धनात् ।\nभयान्मुच्येत भीतस्तु मुच्येतापन्न आपदः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003197049, "chapter_id": 23197, "verse_number": "४-१३३-५०", "content_sanskrit": "अरण्ये ब्रान्तरे भीतो दावाग्नो मुच्यते ध्रुवम् ।\nअघं कुष्ठं च दारिद्र्यं रोगं शोकं च दारुणम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003197050, "chapter_id": 23197, "verse_number": "४-१३३-५१", "content_sanskrit": "पुण्यवान्श्रवणादेव नैव जानात्यपुण्यवान् ।\nश्लोकार्ध श्लोकपादं वा यः शृणोति सुसंयतः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003197051, "chapter_id": 23197, "verse_number": "४-१३३-५२", "content_sanskrit": "गोलक्षदानपुण्यं च लभते नात्र संशयः ।\nयुतुःखडं पुराणं च शुद्धकाले जितेन्द्रियः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003197052, "chapter_id": 23197, "verse_number": "४-१३३-५३", "content_sanskrit": "संकल्पतो यः शृणोति भक्त्या दत्त्वा च दक्षिणाम् ।\nयद्बाल्ये यच्चकौमारे वार्धके यच्च यौवने ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003197053, "chapter_id": 23197, "verse_number": "४-१३३-५४", "content_sanskrit": "कोटिजन्मार्जितात्पापान्मुच्यते नात्र संशयः ।\nरत्ननिर्माणयानेन धृत्वा श्रीकृष्णरूपकम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003197054, "chapter_id": 23197, "verse_number": "४-१३३-५५", "content_sanskrit": "नित्यं गत्वा च गोलोकं कृष्णदास्यं लभेद्भूवम् ।\nअसंख्यब्रह्मणां पाते न भवेत्तस्य पातनम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003197055, "chapter_id": 23197, "verse_number": "४-१३३-५६", "content_sanskrit": "समीपे पार्षदो भूत्वा सेवां च कुरुते चिरम् ।\nश्रुत्वा च ब्रह्मखण्डं च सुस्नातः संयतः शुचिः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003197056, "chapter_id": 23197, "verse_number": "४-१३३-५७", "content_sanskrit": "पायसं पिष्टकं चैव फलं ताम्बूलमेव च ।\nभोजयित्वा वाचकं च तस्मै दद्यात्सुवर्णकम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003197057, "chapter_id": 23197, "verse_number": "४-१३३-५८", "content_sanskrit": "चन्दनं शुक्लमाल्यं च सूक्ष्मवस्त्रं मनोहरम् ।\nनिवेद्य वासुदेवं च वाचकाय प्रदीयते ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003197058, "chapter_id": 23197, "verse_number": "४-१३३-५९", "content_sanskrit": "श्रुत्वा च प्रकृतेः खण्डं सुश्राव्यं च सुधोपमम् ।\nभोजयित्वा च दध्यन्नं तस्मै दद्याच्च ।\nकाञ्चनम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003197059, "chapter_id": 23197, "verse_number": "४-१३३-६०", "content_sanskrit": "सवत्सां सुरभिं रम्यां दद्याद्वै भक्तिपूर्वकम् ।\nश्रुत्वा गणपतेः खण्डं विघ्ननाशाय संयतः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003197060, "chapter_id": 23197, "verse_number": "४-१३३-६१", "content_sanskrit": "स्वर्णयज्ञोपवीतं च श्वेताश्वच्छत्रमाल्यकम् ।\nप्रदीयते वायकाय स्वस्तिकं तिललड्डुकम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003197061, "chapter_id": 23197, "verse_number": "४-१३३-६२", "content_sanskrit": "परिपक्वफलान्येव कालदेशोद्भवानि च ।\nश्रीकृष्णजन्मखण्डं च श्रुत्वा भक्तश्च भक्तितः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003197062, "chapter_id": 23197, "verse_number": "४-१३३-६३", "content_sanskrit": "वाचकाय प्रदद्याच्च परं रत्नाङ्गुलीयकम् ।\nसूक्ष्मवस्त्रं च माल्यं च स्वर्णकुण्डलमुत्तमम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003197063, "chapter_id": 23197, "verse_number": "४-१३३-६४", "content_sanskrit": "माल्यं च वरदोलां च सुपक्वं क्षीरमेव च ।\nसर्वस्वं दक्षिणां दद्यात्स्तवनं कुरुते ध्रुवम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003197064, "chapter_id": 23197, "verse_number": "४-१३३-६५", "content_sanskrit": "शतकं ब्राह्मणानां च भोजयेत्परमादरात् ।\nब्रह्मणं वैष्णवं शास्त्रनिष्णातं पण्डितं वरम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003197065, "chapter_id": 23197, "verse_number": "४-१३३-६६", "content_sanskrit": "कुरुते वाचकं शुद्धमन्यथा निष्फलं भवेत् ।\nश्रीकृष्ण विमुखाद्दुष्टान्नोपदिष्टाच्च ब्राह्मणात् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003197066, "chapter_id": 23197, "verse_number": "४-१३३-६७", "content_sanskrit": "श्रीकृष्णभक्तियुक्तं च पुराणं यः शृणोति च ।\nभक्तिं पुण्यं न लभते हन्ति पुण्यं पुराकृतम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003197067, "chapter_id": 23197, "verse_number": "४-१३३-६८", "content_sanskrit": "श्रीकृष्णभक्तियुक्ताच्च पुराणं यः शृणोति च ।\nभक्तिं पुण्यं च लभते यात्यन्ते श्रोहरेः पदम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003197068, "chapter_id": 23197, "verse_number": "४-१३३-६९", "content_sanskrit": "एतत्ते कथितं सर्व यच्छ्रु तं गुरुवक्त्रतः ।\nबिदायं देहि विप्रेन्द्र यामि नारायणाश्रमम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003197069, "chapter_id": 23197, "verse_number": "४-१३३-७०", "content_sanskrit": "दृष्ट्वा विप्रसमूहं च नमस्कर्तुं समागतः ।\nकथितं ब्रह्मवैवर्तं भवतामाज्ञया परम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003197070, "chapter_id": 23197, "verse_number": "४-१३३-७१", "content_sanskrit": "नमोऽस्तु ब्राह्मणेभ्यश्च कृष्णाय परमात्मने ।\nशिवाय ब्रह्मणे नित्यं गणेशाय नमो नमः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003197071, "chapter_id": 23197, "verse_number": "४-१३३-७२", "content_sanskrit": "कायेन मनसा वाचा परं भक्त्या दिवानिशम् ।\nभज सत्यं परं ब्रह्म राधेशं त्रिगुणात्परम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003197072, "chapter_id": 23197, "verse_number": "४-१३३-७३", "content_sanskrit": "नमो देव्यै सरस्वत्यै पुराणगुरवे नमः ।\nसर्वविघ्नविनाशिन्यै दुर्गादेव्यै नमो नमः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003197073, "chapter_id": 23197, "verse_number": "४-१३३-७४", "content_sanskrit": "युष्माकं पादद्मानि दृष्ट्वा पुण्यानि शौनक ।\nअद्य सिद्धाश्रमं यामि यत्र देवो गणेश्वरः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]