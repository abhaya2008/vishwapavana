[{"id": 2061610, "chapter_id": 2316, "verse_number": "८-३७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2061611, "chapter_id": 2316, "verse_number": "८-३७-१", "content_sanskrit": "ततः पुनर्महाराज मद्रराजमरिन्दमः।\nअभ्यभाषत राधेयः सन्निवार्योत्तरं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2061612, "chapter_id": 2316, "verse_number": "८-३७-२", "content_sanskrit": "निर्भर्त्सनार्थं शल्य त्वं यत्तु जल्पितवानसि।\nनाहं शक्यस्त्वया वाचा विभीषयितुमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2061613, "chapter_id": 2316, "verse_number": "८-३७-३", "content_sanskrit": "यदि मां देवताः सर्वा योधयेयुः सवासवाः।\nतथापि मे भयं न स्यात्किमु पार्थात्सकेशवात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2061614, "chapter_id": 2316, "verse_number": "८-३७-४", "content_sanskrit": "नाहं भीषयितुं शक्यः शुद्धकर्णा महाहवे।\nअभिजानीहि शक्तस्त्वमन्यं भीषयितुं रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2061615, "chapter_id": 2316, "verse_number": "८-३७-५", "content_sanskrit": "नीचस्य बलमेतावत्पारुष्यं यतत्त्वमात्थ माम्।\nअशक्तो हि गुणान्वक्तुं वल्गसे बहु दुर्मते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2061616, "chapter_id": 2316, "verse_number": "८-३७-६", "content_sanskrit": "न हि कर्णः समुद्भूतो भयार्थमिह मद्रक।\nविक्रमार्थमहं जातो यशोर्थं च तथाऽऽत्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2061617, "chapter_id": 2316, "verse_number": "८-३७-७", "content_sanskrit": "सखिभावेन सौहार्दान्मितत्रभावेन चैव हि।\nकारणैस्त्रिभिरेतैस्त्वं शल्य जीवसि साम्प्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2061618, "chapter_id": 2316, "verse_number": "८-३७-८", "content_sanskrit": "राज्ञश्च धार्तराष्ट्रस्य कार्यं सुमहदुद्यतम्।\nमयि तच्चाहितं शल्य तेन जीवसि मे क्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2061619, "chapter_id": 2316, "verse_number": "८-३७-९", "content_sanskrit": "कृतश्च समयः पूर्वं क्षन्तव्यं विप्रियं तव।\n`समयः परिपाल्यो मे तेन जीवसि साम्प्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2061620, "chapter_id": 2316, "verse_number": "८-३७-१०", "content_sanskrit": "ऋते शल्यसहस्रेण विजयेयमहं परान्।\nमित्रद्रोहस्तु पापीयानिति जीवसि साम्प्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2061621, "chapter_id": 2316, "verse_number": "८-३७-११x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2061622, "chapter_id": 2316, "verse_number": "८-३७-११", "content_sanskrit": "आर्तप्रलापांस्त्वं कर्ण यान्ब्रवीषि परान्प्रति।\nन ते कर्णसहस्रेण शक्या जेतुं परे युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2061623, "chapter_id": 2316, "verse_number": "८-३७-१२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2061624, "chapter_id": 2316, "verse_number": "८-३७-१२", "content_sanskrit": "तथा ब्रुवन्तं परुषं कर्णो मद्राधिपं तदा।\nपरुषं द्विगुणं भूयः प्रोवाचाप्रियदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2061625, "chapter_id": 2316, "verse_number": "८-३७-१३", "content_sanskrit": "इदं त्वमेकाग्रमनाः शृणु मद्रजनाधिप।\nसन्निधौ धृतराष्ट्रस्य प्रोच्यमानं मया श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2061626, "chapter_id": 2316, "verse_number": "८-३७-१४", "content_sanskrit": "देशांश्च विविधांश्चित्रान्पूर्ववृत्तांश्च पार्थिवान्।\nब्राह्मणाः कथयन्ति स्म धृतराष्ट्रनिवेशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2061627, "chapter_id": 2316, "verse_number": "८-३७-१५", "content_sanskrit": "तत्र वृद्धः पुरावृत्ताः कथाः कश्चिद्द्विजोत्तमः।\nबाह्लीकदेशं मद्रांश्च कुत्सयन्वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2061628, "chapter_id": 2316, "verse_number": "८-३७-१६", "content_sanskrit": "बहिष्कृता हिमवतता गङ्गया च तिरस्कृताः।\nसरस्वत्या यमुनया कुरुक्षेत्रेण चापि ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2061629, "chapter_id": 2316, "verse_number": "८-३७-१७", "content_sanskrit": "पञ्चानां सिन्धुषष्ठानां नदीनां येऽन्तराश्रिताः।\nतान्धर्मबाह्यानशुचीन्बाह्लीकानपि वर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2061630, "chapter_id": 2316, "verse_number": "८-३७-१८", "content_sanskrit": "गोवर्धनो नाम वटः सुभाण्डं नाम पत्तनम्।\nएतद्राजन्कलिद्वारमाकुमारात्स्मराम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2061631, "chapter_id": 2316, "verse_number": "८-३७-१९", "content_sanskrit": "कार्येणात्यर्थगूढेन बाह्लीकेषूषितं मया।\nतत एषां समाचारः संवासाद्विदितो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2061632, "chapter_id": 2316, "verse_number": "८-३७-२०", "content_sanskrit": "शाकलं नाम नगरमापगानामनिम्नगा।\nचण्डाला नाम बाह्लीकास्तेषां वृत्तं सुनिन्दितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2061633, "chapter_id": 2316, "verse_number": "८-३७-२१", "content_sanskrit": "पानं गुडासवं पीत्वा गोमांसं लशुनैः सह।\nअपूपसक्तुमद्यानामाशिताः शीलवर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2061634, "chapter_id": 2316, "verse_number": "८-३७-२२", "content_sanskrit": "गायन्त्यथ च नृत्यन्ति स्त्रियो मत्ता विवाससः।\nनगरापणवेशेषु बहिर्माल्यानुलेपनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2061635, "chapter_id": 2316, "verse_number": "८-३७-२३", "content_sanskrit": "मत्ताः प्रगीतविरुतैः खरोष्ट्रनिनदोपमैः।\nअनावृता मैथुने ताः कामचाराश्च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2061636, "chapter_id": 2316, "verse_number": "८-३७-२४", "content_sanskrit": "आहुरन्योन्यसूक्तानि प्रब्रुवाणा मदोत्कxxxः।\nहेहतेहेहतेत्येवं स्वामिभर्तृहतेति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2061637, "chapter_id": 2316, "verse_number": "८-३७-२५", "content_sanskrit": "आक्रोशन्त्यः प्रनृत्यन्ति व्रात्याः पर्वस्वसंयताः।\nतासां किलावलिप्तानां निवसन्कुरुजाङ्गले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2061638, "chapter_id": 2316, "verse_number": "८-३७-२६", "content_sanskrit": "कश्चिद्बाह्लीकदुष्टानां नातिहृष्टमना जगौ।\nसा नूनं बृहती गौरी सूक्ष्मकम्बलवासिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2061639, "chapter_id": 2316, "verse_number": "८-३७-२७", "content_sanskrit": "मामनुस्मरती शेते बाह्लीकं कुरुवासिनम्।\nशतद्रुं नु कदा तीर्त्वा तां च रम्यामिरावतीम्।\nगत्वा स्वदेशं द्रक्ष्यामि स्थूलजङ्घाः शुभाः स्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2061640, "chapter_id": 2316, "verse_number": "८-३७-२८", "content_sanskrit": "मनःशिलोज्ज्वलापाङ्ग्यो गौर्यस्ताः काकुकूजिताः।\nकम्बलाजिनसंवीता रुदन्त्यः प्रियदर्शनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2061641, "chapter_id": 2316, "verse_number": "८-३७-२९", "content_sanskrit": "मृदङ्गानकशङ्खानां मर्दलानां च निःस्वनैः।\nखरोष्ट्राश्वतरैश्चैव मत्ता यास्यामहे सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2061642, "chapter_id": 2316, "verse_number": "८-३७-३०", "content_sanskrit": "शमीपीलुकरीराणां वनेषु सुखवर्त्मसु।\nअपूपान्सक्तुपिण्डांश्च प्राश्नन्तो मथितान्वितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2061643, "chapter_id": 2316, "verse_number": "८-३७-३१", "content_sanskrit": "पथिषु प्रबलो भूत्वा तथा सम्पततोऽध्वगान्।\nचेलापहारं कुर्वाणास्ताडयिष्याम भूयसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2061644, "chapter_id": 2316, "verse_number": "८-३७-३२", "content_sanskrit": "एवंशीलेषु व्रात्येषु बाह्लीकेषु दुरात्मसु।\nकश्चेतयानो निवसेन्मुहूर्तमपि मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2061645, "chapter_id": 2316, "verse_number": "८-३७-३३x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2061646, "chapter_id": 2316, "verse_number": "८-३७-३३", "content_sanskrit": "ईदृशा ब्राह्मणेनोक्ता बाह्लीका मोघचारिणः।\nयेषां षड्भागहर्ता त्वमुभयोः पुण्यपापयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2061647, "chapter_id": 2316, "verse_number": "८-३७-३४", "content_sanskrit": "इत्युक्त्वा ब्राह्मणः साधुरुत्तरं पुनरुक्तवान्।\nबाह्लीकेष्वविनीतेषु प्रोच्यमानं निबोध तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2061648, "chapter_id": 2316, "verse_number": "८-३७-३५", "content_sanskrit": "ततत्र स्म राक्षसी गाति कृष्णचतुर्दशीम्।\nनगरे शाकले स्फीते आहत्य निशि दुन्दुभिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2061649, "chapter_id": 2316, "verse_number": "८-३७-३६", "content_sanskrit": "कथं वस्तादृशो गाथाः पुनर्गास्यामि शाकले।\nगव्यस्य तृप्ता मांसस्य पीत्वा गौडं सुरासवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2061650, "chapter_id": 2316, "verse_number": "८-३७-३७", "content_sanskrit": "गौरीभिः सह नारीभिर्बृहतीभिः स्वलङ्कृता।\nपलाण्डुगण्डूषयुताः खादन्तश्चेशिकान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2061651, "chapter_id": 2316, "verse_number": "८-३७-३८", "content_sanskrit": "वाराहं कौक्कुटं मांसं गव्यं गार्दभमौष्ट्रकम्।\nधानाश्च ये न खादन्ति तेषां जन्म निरर्थकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2061652, "chapter_id": 2316, "verse_number": "८-३७-३९", "content_sanskrit": "एवं गायन्ति ये मत्ताः शीधुना पीलुकावने।\nसबालवृद्धाः क्रन्दन्ति तेषां धर्मः कथं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2061653, "chapter_id": 2316, "verse_number": "८-३७-४०", "content_sanskrit": "यत्र लोकेश्वरः कृष्णो देवदेवो जनार्दनः।\nविस्मृतः पुरुषैरुग्रैस्तेषां धर्मः कथं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2061654, "chapter_id": 2316, "verse_number": "८-३७-४१", "content_sanskrit": "इति शल्य विजानीहि हन्त भूयो ब्रवीमि ते।\nयदन्योप्युक्तवानस्मान्ब्राह्मणः कुरुसंसदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2061655, "chapter_id": 2316, "verse_number": "८-३७-४२", "content_sanskrit": "पञ्चनद्यो वहन्त्येता यत्र पीलुवनान्युत।\nशतद्रुश्च विपाशा च तृतीयैरावती तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2061656, "chapter_id": 2316, "verse_number": "८-३७-४३", "content_sanskrit": "चन्द्रभागा वितस्ता च सिन्धुषष्ठा महानदी।\nआरट्टा नाम बह्लीका एतेष्वार्यो हि नो वसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2061657, "chapter_id": 2316, "verse_number": "८-३७-४४", "content_sanskrit": "व्रात्यानां दासमीयानां विदेहानामयज्वनाम्।\nन देवाः प्रतिगृह्णन्ति पितरो ब्राह्मणास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2061658, "chapter_id": 2316, "verse_number": "८-३७-४५", "content_sanskrit": "तेषां प्रनष्टधर्माणां बाह्लीकानामिति श्रुतिः।\nब्राह्मणेन यथा प्रोक्तं विदुषा साधुसंसदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2061659, "chapter_id": 2316, "verse_number": "८-३७-४६", "content_sanskrit": "काष्ठकुण्डेषु बाह्लीका मृण्मयेषु च भुञ्जते।\nसक्तुमद्यावलिप्तेषु श्वावलीढेषु निर्घृणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2061660, "chapter_id": 2316, "verse_number": "८-३७-४७", "content_sanskrit": "आविकं चौष्ट्रिकं चैव क्षीरं गार्दभमेव च।\nतद्विकारांश्च बाह्लीकाः खादन्ति च पिबन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2061661, "chapter_id": 2316, "verse_number": "८-३७-४८", "content_sanskrit": "पात्रसङ्करिणो जाल्माः सर्वान्नक्षीरभोजनाः।\nआरट्टा नाम बाह्लीका वर्जनीया विपश्चिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2061662, "chapter_id": 2316, "verse_number": "८-३७-४९", "content_sanskrit": "इति शल्य विजानीहि हन्त भूयो ब्रवीमि ते।\nयदन्योऽप्युक्तवान्मह्यं ब्राह्मणः कुरुसंसदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2061663, "chapter_id": 2316, "verse_number": "८-३७-५०", "content_sanskrit": "युगन्धरे पयः पीत्वा प्रोष्य चाप्यच्युतस्थले।\nतद्वद्भूतिलये स्नात्वा कथं स्वर्गं गमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2061664, "chapter_id": 2316, "verse_number": "८-३७-५१", "content_sanskrit": "पञ्चनद्यो वहन्त्येता यत्र निःसृत्य पर्वतात्।\nआरट्टा नाम बाह्लीका न तेष्वार्यो द्व्यहं वसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2061665, "chapter_id": 2316, "verse_number": "८-३७-५२", "content_sanskrit": "बाह्लीका नाम हीकश्च विपाशायां पिशाचकौ।\nतयोरपत्यं बाह्लीका नैषा सृष्टिः प्रजापतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2061666, "chapter_id": 2316, "verse_number": "८-३७-५३", "content_sanskrit": "ते कथं विविधान्धर्माञ्ज्ञास्यन्ते हीनयोनयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2061667, "chapter_id": 2316, "verse_number": "८-३७-५४", "content_sanskrit": "कारस्करान्माहिषकान्करम्भान्कटकालिकान्।\nकर्करान्वीरकान्वीरा उन्मत्तांश्च विवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2061668, "chapter_id": 2316, "verse_number": "८-३७-५५", "content_sanskrit": "इति तीर्थानुसञ्चारी राक्षसी काचिदब्रवीत्।\nएकरात्रमुषित्वेह महोलूखलमेखला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2061669, "chapter_id": 2316, "verse_number": "८-३७-५६", "content_sanskrit": "आरट्टा नाम ते देशा बाह्लीकं नाम तद्वनम्।\nवसातिसिन्धुसौवीरा इति प्रायोऽतिकुत्सिताः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2061670, "chapter_id": 2316, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तत्रिंशोऽध्यायः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]