[{"id": 2199497, "chapter_id": 5243, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2199498, "chapter_id": 5243, "verse_number": "१", "content_sanskrit": "श्रुतं मे भवतो वाक्यमन्नदानस्य यो विधिः ।\nनक्षत्रयोगस्येदानीं दानकल्पं ब्रवीहि मे\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2199499, "chapter_id": 5243, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2199500, "chapter_id": 5243, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nदेवक्याश्चैव संवादं देवर्षेर्नारदस्य च\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2199501, "chapter_id": 5243, "verse_number": "३", "content_sanskrit": "द्वारकामनुसम्प्राप्तं नारदं देवदर्शनम् ।\nपप्रच्छैनं ततः प्रश्नं देवकी धर्मदर्शिनी\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2199502, "chapter_id": 5243, "verse_number": "४", "content_sanskrit": "तस्याः सम्पृच्छमानाया देवर्षिर्नारदस्तदा ।\nआचष्ट विधिवत्सर्वं यत्तच्छृणु विशाम्पते\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2199503, "chapter_id": 5243, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2199504, "chapter_id": 5243, "verse_number": "५", "content_sanskrit": "कृत्तिकासु महाभागे पायसेन ससर्पिषा ।\nसन्तर्प्य ब्राह्मणान् साधूँल्लोकानाप्नोत्यनुत्तमान्\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2199505, "chapter_id": 5243, "verse_number": "६", "content_sanskrit": "रोहिण्यां प्रथितैर्मांसैर्माषैरन्नेन सर्पिषा ।\nपयोऽनुपानं दातव्यमानृण्यार्थं द्विजातये\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2199506, "chapter_id": 5243, "verse_number": "७", "content_sanskrit": "दोग्ध्रीं दत्त्वा सवत्सां तु नक्षत्रे सोमदैवते ।\nगच्छन्ति मानुषाल्लोकात् स्वर्गलोकमनुत्तमम्\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2199507, "chapter_id": 5243, "verse_number": "८", "content_sanskrit": "आर्द्रायां कृसरं दत्त्वा तैलमिश्रमुपोषितः ।\nनरस्तरति दुर्गाणि क्षुरधारांश्च पर्वतान्\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2199508, "chapter_id": 5243, "verse_number": "९", "content_sanskrit": "पूपान् पुनर्वसौ दत्त्वा तथैवान्नानि शोभने ।\nयशस्वी रूपसम्पन्नो बह्वन्ने जायते कुले\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2199509, "chapter_id": 5243, "verse_number": "१०", "content_sanskrit": "पुष्ये तु कनकं दत्त्वा कृतं चाकृतमेव च ।\nअनालोकेषु लोकेषु सोमवत् स विराजते\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2199510, "chapter_id": 5243, "verse_number": "११", "content_sanskrit": "आश्लेषायां तु यो रूप्यमृषभं वा प्रयच्छति ।\nस सर्वभयनिर्मुक्तः शात्रवानधितिष्ठति\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2199511, "chapter_id": 5243, "verse_number": "१२", "content_sanskrit": "मघासु तिलपूर्णानि वर्धमानानि मानवः ।\nप्रदाय पुत्रपशुमानिह प्रेत्य च मोदते\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2199512, "chapter_id": 5243, "verse_number": "१३", "content_sanskrit": "फल्गुनीपूर्वसमये ब्राह्मणानामुपोषितः ।\nभक्षान् फाणितसंयुक्तान् दत्त्वा सौभाग्यमृच्छति\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2199513, "chapter_id": 5243, "verse_number": "१४", "content_sanskrit": "घृतक्षीरसमायुक्तं विधिवत् षष्टिकौदनम् ।\nउत्तराविषये दत्त्वा स्वर्गलोके महीयते\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2199514, "chapter_id": 5243, "verse_number": "१५", "content_sanskrit": "यद्यत् प्रदीयते दानमुत्तराविषये नरैः ।\nमहाफलमनन्तं च भवतीति विनिश्चयः\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2199515, "chapter_id": 5243, "verse_number": "१६", "content_sanskrit": "हस्ते हस्तिरथं दत्त्वा चतुर्युक्तमुपोषितः ।\nप्राप्नोति परमाँल्लोकान् पुण्यकामसमन्वितान्\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2199516, "chapter_id": 5243, "verse_number": "१७", "content_sanskrit": "चित्रायामृषभं दत्त्वा पुण्यान् गन्धांश्च भारत ।\nचरत्यप्सरसां लोके रमते नन्दने तथा\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2199517, "chapter_id": 5243, "verse_number": "१८", "content_sanskrit": "स्वातावथ धनं दत्त्वा यदिष्टतममात्मनः ।\nप्राप्नोति लोकान् स शुभानिह चैव महद्यशः\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2199518, "chapter_id": 5243, "verse_number": "१९", "content_sanskrit": "विशाखायामनड्वाहं धेनुं दत्त्वा च दुग्धदाम् ।\nसप्रासङ्गं च शकटं सधान्यं वस्त्रसंयुतम्\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2199519, "chapter_id": 5243, "verse_number": "२०", "content_sanskrit": "पितॄन् देवांश्च प्रीणाति प्रेत्य चानन्त्यमश्नुते ।\nन च दुर्गाण्यवाप्नोति स्वर्गलोकं च गच्छति\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2199520, "chapter_id": 5243, "verse_number": "२१", "content_sanskrit": "दत्त्वा यथोक्तं विप्रेभ्यो वृत्तिमिष्टां स विन्दति ।\nनरकादींश्च सङ्क्लेशान् नाप्नोतीति विनिश्चयः\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2199521, "chapter_id": 5243, "verse_number": "२२", "content_sanskrit": "अनुराधासु प्रावारं वस्त्रान्तरमुपोषितः ।\nदत्त्वा युगशतं चापि नरः स्वर्गे महीयते\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2199522, "chapter_id": 5243, "verse_number": "२३", "content_sanskrit": "कालशाकं तु विप्रेभ्यो दत्त्वा मर्त्यः समूलकम् ।\nज्येष्ठायामृद्धिमिष्टां वै गतिमिष्टां च विन्दति\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2199523, "chapter_id": 5243, "verse_number": "२४", "content_sanskrit": "मूले मूलफलं दत्त्वा ब्राह्मणेभ्यः समाहितः ।\nपितॄन् प्रीणयते चापि गतिमिष्टां च गच्छति\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2199524, "chapter_id": 5243, "verse_number": "२५", "content_sanskrit": "अथ पूर्वास्वषाढासु दधिपात्राण्युपोषितः ।\nकुलवृत्तोपसम्पन्ने ब्राह्मणे वेदपारगे ।\nप्रदाय जायते प्रेत्य कुले सुबहुगोकुले\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2199525, "chapter_id": 5243, "verse_number": "२६", "content_sanskrit": "उदमन्थं ससर्पिष्कं प्रभूतमधुफाणितम् ।\nदत्त्वोत्तरास्वषाढासु सर्वकामानवाप्नुयात्\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2199526, "chapter_id": 5243, "verse_number": "२७", "content_sanskrit": "दुग्धं त्वभिजिते योगे दत्त्वा मधुघृताप्लुतम् ।\nधर्मनित्यो मनीषिभ्यः स्वर्गलोके महीयते\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2199527, "chapter_id": 5243, "verse_number": "२८", "content_sanskrit": "श्रवणे कम्बलं दत्त्वा वस्त्रान्तरितमेव च ।\nश्वेतेन याति यानेन सर्वलोकानसंवृतान्\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2199528, "chapter_id": 5243, "verse_number": "२९", "content_sanskrit": "गोप्रयुक्तं धनिष्ठासु यानं दत्त्वा समाहितः ।\nवस्त्ररश्मिधरं सद्यः प्रेत्य राज्यं प्रपद्यते\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2199529, "chapter_id": 5243, "verse_number": "३०", "content_sanskrit": "गन्धाञ्शतभिषग्योगे दत्त्वा सागुरुचन्दनान् ।\nप्राप्नोत्यप्सरसां लोकान् प्रेत्य गन्धांश्च शाश्वतान्\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2199530, "chapter_id": 5243, "verse_number": "३१", "content_sanskrit": "पूर्वभाद्रपदायोगे राजमाषान् प्रदाय तु ।\nसर्वभक्षफलोपेतः स वै प्रेत्य सुखी भवेत्\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2199531, "chapter_id": 5243, "verse_number": "३२", "content_sanskrit": "औरभ्रमुत्तरायोगे यस्तु मांसं प्रयच्छति ।\nस पितॄन् प्रीणयति वै प्रेत्य चानन्त्यमश्नुते\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2199532, "chapter_id": 5243, "verse_number": "३३", "content_sanskrit": "कांस्योपदोहनां धेनुं रेवत्यां यः प्रयच्छति ।\nसा प्रेत्य कामानादाय दातारमुपतिष्ठति\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2199533, "chapter_id": 5243, "verse_number": "३४", "content_sanskrit": "रथमश्वसमायुक्तं दत्त्वाऽश्विन्यां नरोत्तमः ।\nहस्त्यश्वरथसम्पन्ने वर्चस्वी जायते कुले\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2199534, "chapter_id": 5243, "verse_number": "३५", "content_sanskrit": "भरणीषु द्विजातिभ्यस्तिलधेनुं प्रदाय वै ।\nगाः सुप्रभूताः प्राप्नोति नरः प्रेत्य यशस्तथा\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2199535, "chapter_id": 5243, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2199536, "chapter_id": 5243, "verse_number": "३६", "content_sanskrit": "इत्येष लक्षणोद्देशः प्रोक्तो नक्षत्रयोगतः ।\nदेवक्या नारदेनेह सा स्नुषाभ्योऽब्रवीदिदम्\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2199537, "chapter_id": 5243, "verse_number": "९४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे नक्षत्रयोगे दानफलकथनं नाम चतुर्नवतितमोऽध्यायः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]