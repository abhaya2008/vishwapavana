[{"id": 2093150, "chapter_id": 2986, "verse_number": "१३-११६-१", "content_sanskrit": "युधिष्ठिर उवाच।\nपवित्राणां पवित्रं यच्छ्रेष्ठं लोके च यद्भवेत्।\nपावनं परमं चैव तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093151, "chapter_id": 2986, "verse_number": "१३-११६-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093152, "chapter_id": 2986, "verse_number": "१३-११६-२", "content_sanskrit": "गावो महार्थाः पुण्याश्च तारयन्ति च मानवान्।\nधारयन्ति प्रजाश्चेमा हविषा पयसा तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093153, "chapter_id": 2986, "verse_number": "१३-११६-३", "content_sanskrit": "न हि पुण्यतमं किञ्चिद्गोभ्यो भरतसत्तम।\nएताः पुण्याः पवित्राश्च त्रिषु लोकेषु सत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093154, "chapter_id": 2986, "verse_number": "१३-११६-४", "content_sanskrit": "देवानामुपरिष्टाच्च गावः प्रतिवसन्ति वै।\nदत्त्वा चैतास्तारयते यान्ति स्वर्गं मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093155, "chapter_id": 2986, "verse_number": "१३-११६-५", "content_sanskrit": "मान्धाता यौवनाश्वश्च ययातिर्नहुषस्तथा।\nगा वै ददन्तः सततं सहस्रशतसम्मिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093156, "chapter_id": 2986, "verse_number": "१३-११६-६", "content_sanskrit": "गताः परमकं स्थानं देवैरपि सुदुर्लभम्।\nअपि चात्र पुरावृत्तं कथयिष्यामि तेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093157, "chapter_id": 2986, "verse_number": "१३-११६-७", "content_sanskrit": "ऋषीणामुत्तमं धीमान्कृष्णद्वैपायनं शुकः।\nअभिवाद्याह्निकं कृत्वा शुचिः प्रयतमानसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093158, "chapter_id": 2986, "verse_number": "१३-११६-८", "content_sanskrit": "पितरं परिपप्रच्छ दृष्टलोकपरावरम्।\nको यज्ञः सर्वयज्ञानां वरिष्ठोऽभ्युपलक्ष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093159, "chapter_id": 2986, "verse_number": "१३-११६-९", "content_sanskrit": "किञ्च कृत्वा परं स्थानं प्राप्नुवन्ति मनीषिणः।\nकेन देवाः पवित्रेण स्वर्गमश्नन्ति वा विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093160, "chapter_id": 2986, "verse_number": "१३-११६-१०", "content_sanskrit": "किञ्च यज्ञस्य यज्ञत्वं क्व च यज्ञः प्रतिष्ठितः।\nदानानामुत्तमं किञ्च किञ्च सत्रमितः परम्।\nपवित्राणां पवित्रं च यत्तद्ब्रूहि महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093161, "chapter_id": 2986, "verse_number": "१३-११६-११", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं व्यासः परमधर्मवित्।\nपुत्रायाकथयत्सर्वं तत्त्वेन भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093162, "chapter_id": 2986, "verse_number": "१३-११६-१२", "content_sanskrit": "गावः प्रतिष्ठा भूतानां तथा गावः परायणम्।\nगावः पुण्याः पवित्राश्च गोधनं पावनं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093163, "chapter_id": 2986, "verse_number": "१३-११६-१३", "content_sanskrit": "पूर्वमासन्नंशृङ्गा वै गाव इत्यनुशश्रुम।\nशृङ्गार्थे समुपासन्त ताः किल प्रभुमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093164, "chapter_id": 2986, "verse_number": "१३-११६-१४", "content_sanskrit": "ततो ब्रह्मा तु गाः सत्रमुपविष्टाः समीक्ष्य ह।\nईप्सितं प्रददौ ताभ्यो गोभ्यः प्रत्येकशः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093165, "chapter_id": 2986, "verse_number": "१३-११६-१५", "content_sanskrit": "तासां शृङ्गाण्यजायन्त तस्या यादृङ्भनोगतम्।\nनानावर्णाः शृङ्गवन्त्यस्ता व्यरोचन्त पुत्रक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2093166, "chapter_id": 2986, "verse_number": "१३-११६-१६", "content_sanskrit": "ब्रह्मणा वरदत्तास्ता हव्यकव्यप्रदाः शुभाः।\nपुण्याः पवित्राः सुभगा दिव्यसंस्थानलक्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2093167, "chapter_id": 2986, "verse_number": "१३-११६-१७", "content_sanskrit": "गावस्तेजो महद्दिव्यं गवां दानं प्रशस्यते।\nये चैताः सम्प्रयच्छन्ति साधवो वीतमत्सराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2093168, "chapter_id": 2986, "verse_number": "१३-११६-१८", "content_sanskrit": "ते वै सुकृतिनः प्रोक्ताः सर्वदानप्रदाश्च ते।\nगवां लोकं तथा पुण्यमाप्नुवन्ति च तेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2093169, "chapter_id": 2986, "verse_number": "१३-११६-१९", "content_sanskrit": "यत्र वृक्षा मधुफला दिव्यपुष्पफलोपगाः।\nपुष्पाणि च सुगन्धीनि दिव्यानि द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2093170, "chapter_id": 2986, "verse_number": "१३-११६-२०", "content_sanskrit": "सर्वा मणिभयी भूमिः सर्वकाञ्चनवालुकाः।\nसर्वर्तुसुखसंस्पर्शा निष्पङ्का निरजाः शुभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2093171, "chapter_id": 2986, "verse_number": "१३-११६-२१", "content_sanskrit": "रक्तोत्पलवनैश्चैव मणिखण्डैर्हिरण्मयैः।\nतरुणादित्यसङ्काशैर्भान्ति तत्र जलाशयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2093172, "chapter_id": 2986, "verse_number": "१३-११६-२२", "content_sanskrit": "महार्हमणिपत्रैश्च काञ्चनप्रभकेसरैः।\nनीलोत्पलविमिश्रैश्च सरोभिर्बहुपङ्कजैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2093173, "chapter_id": 2986, "verse_number": "१३-११६-२३", "content_sanskrit": "करवीरवनैः फुल्लैः सहस्रावर्तसंवृतैः।\nसन्तानकवनैः फुल्लैर्वृक्षेश्च समलङ्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2093174, "chapter_id": 2986, "verse_number": "१३-११६-२४", "content_sanskrit": "निर्मिलाभिश्च मुक्ताभिर्मणिभिश्च महाप्रभैः।\nउद्भूतपुलिनास्तत्र जातरूपैश्चि निम्नगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2093175, "chapter_id": 2986, "verse_number": "१३-११६-२५", "content_sanskrit": "सर्वरत्नमयैश्चित्रैरवगाढा द्रुमोत्तमैः।\nजातरूपमयैश्चान्यैर्हुताशनसमप्रभैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2093176, "chapter_id": 2986, "verse_number": "१३-११६-२६", "content_sanskrit": "सौवर्णि गिरयस्तत्र मणिरत्नशिलोच्चयाः।\nसर्वरत्नमयैर्भान्ति शृङ्गैश्चारुभिरुच्छ्रितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2093177, "chapter_id": 2986, "verse_number": "१३-११६-२७", "content_sanskrit": "नित्यपुष्पफलास्तत्र नगाः पत्ररथाकुलाः।\nदिव्यगन्धरसैः पुष्पैः फलैश्च भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2093178, "chapter_id": 2986, "verse_number": "१३-११६-२८", "content_sanskrit": "रमन्ते पुण्यकर्माणस्तत्र नित्यं युधिष्ठिर।\nसर्वकामसमृद्धार्था निःशोका गतमन्यवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2093179, "chapter_id": 2986, "verse_number": "१३-११६-२९", "content_sanskrit": "विमानेषु विचित्रेषु रमणीयेषु भारत।\nमोदन्ते पुण्यकर्माणो विरहन्तो यशस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2093180, "chapter_id": 2986, "verse_number": "१३-११६-३०", "content_sanskrit": "उपक्रीडन्ति तान्राजञ्शुभाश्चाप्सरसां गणाः।\nएतान्लोकानवाप्नोति गां दत्त्वा वै युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2093181, "chapter_id": 2986, "verse_number": "१३-११६-३१", "content_sanskrit": "यासामधिपतिः पूषा मारुतो बलवान्बले।\nऐश्वर्ये वरुणो राजा ता मां पान्तु युगन्धराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2093182, "chapter_id": 2986, "verse_number": "१३-११६-३२", "content_sanskrit": "सुरूपा बहुरूपाश्च विश्वरूपाश्च मातरः।\nप्राजापत्या इति ब्रह्मञ्जपेन्नित्यं यतव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2093183, "chapter_id": 2986, "verse_number": "१३-११६-३३", "content_sanskrit": "गाश्च शुश्रूषते यश्च समन्वेति च सर्वशः।\nतस्मै तुष्टाः प्रयच्छन्ति वरानपि सुदुर्लभान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2093184, "chapter_id": 2986, "verse_number": "१३-११६-३४", "content_sanskrit": "द्रुह्येन मनसा वाऽपि गोषु ता हि सुखप्रदाः।\nअर्चयेत सदा चैव नमस्कारैश्च पूजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2093185, "chapter_id": 2986, "verse_number": "१३-११६-३५", "content_sanskrit": "दान्तः प्रीतमना नित्यं गवां व्युष्टिं तथाऽश्नुते।\nत्र्यहमुष्णं पिबेन्मूत्रं त्र्यहमुष्णं पिबेत्पयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2093186, "chapter_id": 2986, "verse_number": "१३-११६-३६", "content_sanskrit": "गवामुष्णं पयः पीत्वा त्र्यहमुष्णं घृतं विबेत्।\nत्र्यहमुष्णं घृतं पीत्वा वायुभक्षो भवेत्र्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2093187, "chapter_id": 2986, "verse_number": "१३-११६-३७", "content_sanskrit": "योन देवाः पवित्रेणि भुञ्जते लोकमुत्तमम्।\nयत्पवित्रं पवित्राणां तद्धृतं शिरसा वहेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2093188, "chapter_id": 2986, "verse_number": "१३-११६-३८", "content_sanskrit": "घृतेन जुहुयादग्निं घृतेन स्वस्ति वाचयेत्।\nघृतं प्राशेद्धृतं दद्याद्गवां पुष्टिं तथाऽश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2093189, "chapter_id": 2986, "verse_number": "१३-११६-३९", "content_sanskrit": "निर्हृतैश्च यवैर्गोभिर्मासं प्रश्रितयावकः।\nब्रह्महत्यासमं पापं सर्वमेतेन शुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2093190, "chapter_id": 2986, "verse_number": "१३-११६-४०", "content_sanskrit": "पराभवार्थं दैत्यानां देवैः शौचमिदं कृतम्॥\nते देवत्वमपि प्राप्ताः संसिद्धाश्च महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2093191, "chapter_id": 2986, "verse_number": "१३-११६-४१", "content_sanskrit": "गावः पवित्राः पुण्याश्च पावनं परमं महत्।\nताश्च दत्त्वा द्विजातिभ्यो नरः स्वर्गमुपाश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2093192, "chapter_id": 2986, "verse_number": "१३-११६-४२", "content_sanskrit": "गवां मध्ये शुचिर्भूत्वा गोमतीं मनसा जपेत्।\nपूताभिरद्भिराचम्यि शुचिर्भवति निर्मलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2093193, "chapter_id": 2986, "verse_number": "१३-११६-४३", "content_sanskrit": "अग्निमध्ये गवां मध्ये ब्राह्मणानां च संसदि।\nविद्यावेदप्रतस्नाता ब्राह्मणाः पुण्यकर्मिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2093194, "chapter_id": 2986, "verse_number": "१३-११६-४४", "content_sanskrit": "अध्यापयेरञ्शिष्यान्वै गोमतीं यज्ञसम्मिताम्।\nत्रिरात्रोपोषितो भूत्वा गोमतीं लभते वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2093195, "chapter_id": 2986, "verse_number": "१३-११६-४५", "content_sanskrit": "पुत्रिकामश्च लभते पुत्रं धनमथापि वा॥\nपतिकामा च भर्तारं सर्वकामांश्च मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2093196, "chapter_id": 2986, "verse_number": "१३-११६-४६", "content_sanskrit": "गावस्तुष्टाः प्रयच्छन्ति सेविता वै न संशयः।\nएवमेतां महाभागा यज्ञियाः सर्वकामदाः।\nरोहिण्य इति जानीहि नैताभ्यो विद्यते परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2093197, "chapter_id": 2986, "verse_number": "१३-११६-४७", "content_sanskrit": "इत्युक्तः स महातेजाः शुकः पित्रा महात्मना।\nपूजयामास तां नित्यं तस्मात्त्वमपि पूजय॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2093198, "chapter_id": 2986, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि षोडशाधिकशततमोऽध्यायः॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]