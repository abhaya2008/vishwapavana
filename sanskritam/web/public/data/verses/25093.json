[{"id": 7005093000, "chapter_id": 25093, "verse_number": "७-१-२७६-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि ऋषितीर्थस्य सन्निधौ ।\nकामिकं हि परं क्षेत्रं देविकानाम नामतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005093001, "chapter_id": 25093, "verse_number": "७-१-२७६-२", "content_sanskrit": "महासिद्धिवनं तत्र ऋषिसिद्धसमावृतम् ।\nनानाद्रुमलताकीर्णं पर्वतैरुपशोभितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005093002, "chapter_id": 25093, "verse_number": "७-१-२७६-३", "content_sanskrit": "चंपकैर्बकुलैर्दिव्यैरशोकैः स्तबकैः परैः ।\nपुन्नागैः किंकिरातैश्च सुगन्धैर्नागकेसरैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005093003, "chapter_id": 25093, "verse_number": "७-१-२७६-४", "content_sanskrit": "मल्लिकोत्पलपुष्पैश्च पाटलापारिजातकैः ।\nचूतचंपकपित्थैश्च श्रीफलैः पनसैस्तथा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005093004, "chapter_id": 25093, "verse_number": "७-१-२७६-५", "content_sanskrit": "खर्जूरैर्बदरैश्चान्यैर्मातुलिंगैः सदाडिमैः ।\nजंबीरैश्चैव दिव्यैश्च नारंगैरुप शोभितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005093005, "chapter_id": 25093, "verse_number": "७-१-२७६-६", "content_sanskrit": "शिखिभिः कोकिलाभिश्च गीयमानं तु षट्पदैः ।\nमृगैरृक्षैर्वराहैश्च सिंहैर्व्याघ्रैस्तथा परैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005093006, "chapter_id": 25093, "verse_number": "७-१-२७६-७", "content_sanskrit": "श्वापदैर्विविधाकारैः कन्दरै र्गह्वरैस्तथा ।\nसुरासुरगणैः सिद्धैर्यक्षगन्धर्वपन्नगैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005093007, "chapter_id": 25093, "verse_number": "७-१-२७६-८", "content_sanskrit": "अप्सरोरगनागैश्च बहुभिस्तु समाकुलम् ।\nकेचित्स्तुवंति ईशं तु केचिन्नृत्यंति चाग्रतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005093008, "chapter_id": 25093, "verse_number": "७-१-२७६-९", "content_sanskrit": "पुष्पैर्वृष्टिं तु मुञ्चंति मुखवाद्यानि चापरे ।\nहसंति चापरे हृष्टा गर्जंति च तथापरे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005093009, "chapter_id": 25093, "verse_number": "७-१-२७६-१०", "content_sanskrit": "ऊर्द्ध्वबाहवस्तथा चान्ये अन्ये ध्यायंति तद्गताः ।\nतस्मिन्स्थानं महादेवि देविकायास्तटे शुभे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005093010, "chapter_id": 25093, "verse_number": "७-१-२७६-११", "content_sanskrit": "उमापतीश्वरो नाम तत्राहं संस्थितः सदा ।\nयुगेयुगे सदा पूर्णे कल्पे मन्वन्तरे तथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005093011, "chapter_id": 25093, "verse_number": "७-१-२७६-१२", "content_sanskrit": "न त्यजामि सदा देवि देविकायास्तटं शुभम् ।\nदुर्ल्लभं सर्वलोकेऽस्मिन्पवित्रं सुप्रियं हि मे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005093012, "chapter_id": 25093, "verse_number": "७-१-२७६-१३", "content_sanskrit": "त्वया सह स्थितश्चाहं तस्मि न्स्थाने वरानने ।\nउमया युक्तदेहत्वात्तेन ख्यातं उमापतिः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005093013, "chapter_id": 25093, "verse_number": "७-१-२७६-१४", "content_sanskrit": "पुष्यमासे त्वमावस्यां दद्याच्छ्राद्धं समाहितः ।\nन पश्यामि क्षयं तस्य तस्मिन्दत्तस्य पार्वति ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005093014, "chapter_id": 25093, "verse_number": "७-१-२७६-१५", "content_sanskrit": "ब्रह्महत्यासहस्रं तु तस्य दर्शनतो व्रजेत् ।\nगोभूहिरण्यवासांसि तत्र दद्याद्विचक्षणः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005093015, "chapter_id": 25093, "verse_number": "७-१-२७६-१६", "content_sanskrit": "स एकः परमः पुत्रो यो गत्वा तत्र सुन्दरि ।\nददेच्छ्राद्धं पितॄणां च तस्यांतो नैव विद्यते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005093016, "chapter_id": 25093, "verse_number": "७-१-२७६-१७", "content_sanskrit": "देवैः सर्वैः समाहूता स्नानार्थं सा सरिद्वरा ।\nदेविकेति समाख्याता तेन सा पापनाशिनी ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005093017, "chapter_id": 25093, "verse_number": "७-१-२७६-१८", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये देविकायामुमापतिमाहात्म्यवर्णनंनाम षट्सप्तत्युत्तरद्विशततमोऽध्यायः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]