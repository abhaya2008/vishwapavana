[{"id": 7002925000, "chapter_id": 22925, "verse_number": "१-२-१", "content_sanskrit": "शौनक उवाच ।\nकिमपूर्वं श्रुतं सौते परमाद्भुतमीप्सितम् ।\nसर्वं कथय संव्यस्य ब्रह्मखण्डमनुत्तमम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002925001, "chapter_id": 22925, "verse_number": "१-२-२", "content_sanskrit": "सौतिरुवाच ।\nवन्दे गुरोः पादपद्मं व्यासस्यामिततेजसः ।\nहरिं देवान्द्विजान्नत्वा धर्मान्वक्ष्ये सनातनान् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002925002, "chapter_id": 22925, "verse_number": "१-२-३", "content_sanskrit": "यच्छ्रुतं व्यासवक्त्रेण ब्रह्मखण्डमनुत्तमम् ।\nअज्ञानान्धतमोध्वंसि ज्ञानवर्त्मप्रदीपकम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002925003, "chapter_id": 22925, "verse_number": "१-२-४", "content_sanskrit": "ज्योतिःसमूहं प्रलये पुराऽऽसीत्केवलं द्विज ।\nसूर्य्यकोटिप्रभं नित्यमसंख्यं विश्वकारणम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002925004, "chapter_id": 22925, "verse_number": "१-२-५", "content_sanskrit": "स्वेच्छामयस्य च विभोस्तज्ज्योतिरुज्ज्वलं महत् ।\nज्योतिरभ्यन्तरे लोकत्रयमेव मनोहरम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002925005, "chapter_id": 22925, "verse_number": "१-२-६", "content_sanskrit": "तेषामुपरि गोलोकं नित्यमीश्वरवद् द्विज ।\nत्रिकोटियोजनायामविस्तीर्णं मण्डलाकृति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002925006, "chapter_id": 22925, "verse_number": "१-२-७", "content_sanskrit": "तेजःस्वरूपं सुमहद्रत्नभूमिमयं परम् ।\nअदृश्यं योगिभिः स्वप्ने दृश्यं गम्यं च वैष्णवैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002925007, "chapter_id": 22925, "verse_number": "१-२-८", "content_sanskrit": "योगेन धृतमीशेन चान्तरिक्षस्थितं वरम् ।\nआधिव्याधिजरामृत्युशोकभीतिविवर्जितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002925008, "chapter_id": 22925, "verse_number": "१-२-९", "content_sanskrit": "सद्रत्नरचितासंख्यमन्दिरैः परिशोभितम् ।\nलये कृष्णयुतं सृष्टौ गोपगोपीभिरावृतम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002925009, "chapter_id": 22925, "verse_number": "१-२-१०", "content_sanskrit": "तदधो दक्षिणे सव्ये पञ्चाशत्कोटियोजनान् ।\nवैकुण्ठं शिवलोकं तु तत्समं सुमनोहरम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002925010, "chapter_id": 22925, "verse_number": "१-२-११", "content_sanskrit": "कोटियोजनविस्तीर्णं वैकुण्ठं मण्डलाकृति ।\nलये शून्यं च सृष्टौ च लक्ष्मीनारायणान्वितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002925011, "chapter_id": 22925, "verse_number": "१-२-१२", "content_sanskrit": "चतुर्भुजैः पार्षदैश्च जरामृत्य्वादिवर्जितम् ।\nसव्ये च शिवलोकं च कोटियोजनविस्तृतम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002925012, "chapter_id": 22925, "verse_number": "१-२-१३", "content_sanskrit": "लये शून्यं च सृष्टौ च सपार्षदशिवान्वितम् ।\nगोलोकाभ्यन्तरे ज्योतिरतीव सुमनोहरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002925013, "chapter_id": 22925, "verse_number": "१-२-१४", "content_sanskrit": "परमाह्लादकं शश्वत्परमानन्दकारकम् ।\nध्यायन्ते योगिनः शश्वद्योगेन ज्ञानचक्षुषा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002925014, "chapter_id": 22925, "verse_number": "१-२-१५", "content_sanskrit": "तदेवानन्दजनकं निराकारं परात्परम् ।\nतज्ज्योतिरन्तरे रूपमतीव सुमनोहरम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002925015, "chapter_id": 22925, "verse_number": "१-२-१६", "content_sanskrit": "नवीननीरदश्यामं रक्तपङ्कजलोचनम् ।\nशारदीयपार्वणेन्दुशोभितं चामलाननम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002925016, "chapter_id": 22925, "verse_number": "१-२-१७", "content_sanskrit": "कोटिकन्दर्पलावण्यं लीलाधाम मनोरमम् ।\nद्विभुजं मुरलीहस्तं सस्मितं पीतवाससम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002925017, "chapter_id": 22925, "verse_number": "१-२-१८", "content_sanskrit": "सद्रत्नभूषणौघेन भूषितं भक्तवत्सलम् ।\nचन्दनोक्षितसर्वाङ्गं कस्तूरीकुङ्कुमान्वितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002925018, "chapter_id": 22925, "verse_number": "१-२-१९", "content_sanskrit": "श्रीवत्सवक्षःसंभ्राजत्कौस्तुभेन विराजितम् ।\nसद्रत्नसाररचितकिरीटमुकुटोज्ज्वलम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002925019, "chapter_id": 22925, "verse_number": "१-२-२०", "content_sanskrit": "रत्नसिंहासनस्थं च वनमालाविभूषितम् ।\nतदेव परमं ब्रह्म भगवन्तं सनातनम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002925020, "chapter_id": 22925, "verse_number": "१-२-२१", "content_sanskrit": "स्वेच्छामयं सर्वबीजं सर्वाधारं परात्परम् ।\nकिशोरवयसं शश्वद्गोपवेषविधायकम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002925021, "chapter_id": 22925, "verse_number": "१-२-२२", "content_sanskrit": "कोटिपूर्णेन्दुशोभाढ्यं भक्तानुग्रहकारकम् ।\nनिरीहं निर्विकारं च परिपूर्णतमं विभुम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002925022, "chapter_id": 22925, "verse_number": "१-२-२३", "content_sanskrit": "रासमण्डलमध्यस्थं शान्तं रासेश्वरं वरम् ।\nमाङ्गल्यं मङ्गलार्हं च माङ्गल्यं मङ्गलप्रदम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002925023, "chapter_id": 22925, "verse_number": "१-२-२४", "content_sanskrit": "परमानन्दबीजं च सत्यमक्षरमव्ययम्॥।\nसर्वसिद्धेश्वरं सर्वसिद्धिरूपं च सिद्धिदम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002925024, "chapter_id": 22925, "verse_number": "१-२-२५", "content_sanskrit": "प्रकृतेः परमीशानं निर्गुणं नित्यविग्रहम् ।\nआद्यं पुरुषमव्यक्तं पुरुहूतं पुरुष्टुतम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002925025, "chapter_id": 22925, "verse_number": "१-२-२६", "content_sanskrit": "सत्यं स्वतन्त्रमेकं च परमात्मस्वरूपकम् ।\nध्यायन्ते वैष्णवाः शान्ताः शान्तं तन्परमायणम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002925026, "chapter_id": 22925, "verse_number": "१-२-२७", "content_sanskrit": "एवंरूपं परं बिभ्रद्भगवानेक एव सः ।\nदिग्भिश्च नभसा सार्द्धं शून्यं विश्वं ददर्श ह ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]