[{"id": 2102824, "chapter_id": 3228, "verse_number": "१४-८४-१", "content_sanskrit": "वैशम्पायन उवाच।\nमागधेनार्चितो राजन्पाण्डवः श्वेतवाहनः।\nदक्षिणां दिशमास्थाय चारयामास तं हयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102825, "chapter_id": 3228, "verse_number": "१४-८४-२", "content_sanskrit": "ततः स पुनरावर्त्य हयः कामचरो बली।\nआससाद पुरीं रम्यां चेदीनां शुक्तिसाह्वयाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102826, "chapter_id": 3228, "verse_number": "१४-८४-३", "content_sanskrit": "शरभेणार्चितस्तत्र शिशुपालसुतेन सः।\nयुद्धपूर्वं तदा तेन पूजया च महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102827, "chapter_id": 3228, "verse_number": "१४-८४-४", "content_sanskrit": "ततोऽर्चितो ययौ राजंस्तदा स तुरगोत्तमः।\nकाशीनङ्गान्कोसलांश्च किरातानाथ तङ्गणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102828, "chapter_id": 3228, "verse_number": "१४-८४-५", "content_sanskrit": "पूजां तत्र यथान्यायं प्रतिगृह्य धनंजयः।\nपुनरावृत्त्य कौन्तेयो दशार्णानगमत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102829, "chapter_id": 3228, "verse_number": "१४-८४-६", "content_sanskrit": "तत्र चित्राङ्गदो नाम बलवानरिमर्दनः।\nतेन युद्धमभूत्तस्य विजयस्यातिभैरवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102830, "chapter_id": 3228, "verse_number": "१४-८४-७", "content_sanskrit": "तं चापि वशमानीय किरीटी पुरुषर्षभः।\nनिषादराज्ञो विषयमेकलव्यस्य जग्मिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102831, "chapter_id": 3228, "verse_number": "१४-८४-८", "content_sanskrit": "एकलव्यसुतश्चैनं युद्धेनि जगृहे तदा।\nतत्र चक्रे निषादैः स सग्रामं रोमहर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102832, "chapter_id": 3228, "verse_number": "१४-८४-९", "content_sanskrit": "ततस्तमपि कौन्तेयः समरेष्वपराजितः॥\nजिगाय युधि दुर्धर्षो यज्ञविघ्नार्थमागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102833, "chapter_id": 3228, "verse_number": "१४-८४-१०", "content_sanskrit": "स तं जित्वा महाराज नैषादिं पाकशासनिः।\nअर्चितः प्रययौ भूयो दक्षिणं सलिलार्णवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102834, "chapter_id": 3228, "verse_number": "१४-८४-११", "content_sanskrit": "तत्रापि द्रवीडैरान्ध्रै रौद्रैर्माहिषकैरपि।\nतथा कोल्लगिरेयैश्च युद्धमासीन्किरीटिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102835, "chapter_id": 3228, "verse_number": "१४-८४-१२", "content_sanskrit": "तांश्चापि विजयो जित्वा नातितीव्रेण कर्मणा।\nतुरङ्गमवशेनाथ सुराष्ट्रानभितो ययौ।\nगोकर्णमथ चासाद्य प्रभासमपि जग्मिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102836, "chapter_id": 3228, "verse_number": "१४-८४-१३", "content_sanskrit": "ततो द्वारवतीं रम्यां वृष्णिवीराभिपालिताम्।\nआससाद हयः श्रीमान्कुरुराजस्य यज्ञियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102837, "chapter_id": 3228, "verse_number": "१४-८४-१४", "content_sanskrit": "तमुन्मथ्य हयश्रेष्ठं यादवानां कुमारकाः।\nप्रययुस्तांस्तदा राजन्नुग्रसेनो न्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102838, "chapter_id": 3228, "verse_number": "१४-८४-१५", "content_sanskrit": "ततः पुराद्विनिष्क्रम्य वृष्ण्यन्धकपतिस्तदा।\nसहितो वासुदेवेन मातुलेन किरीटिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102839, "chapter_id": 3228, "verse_number": "१४-८४-१६", "content_sanskrit": "तौ समेत्य कुरुश्रेष्ठं विधिवत्प्रीतिपूर्वकम्।\nपरया भारतश्रेष्ठं पूजया समवस्थितौ।\nततस्ताभ्यामनुज्ञातो यतयौ येन हयो गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102840, "chapter_id": 3228, "verse_number": "१४-८४-१७", "content_sanskrit": "ततः स पश्चिमं देशं समुद्रस्य तदा हयः।\nक्रमेणि व्यचरत्स्फीतं ततः पञ्चनदं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102841, "chapter_id": 3228, "verse_number": "१४-८४-१८", "content_sanskrit": "तस्मादपि स कौरव्य गन्धारविषयं हयः।\nविचचार यथाकामं कौन्तेयानुगतस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102842, "chapter_id": 3228, "verse_number": "१४-८४-१९", "content_sanskrit": "ततो गान्धारराजेन युद्धमासीत्किरीटिनः।\nघोरं शकुनिपुत्रेण पूर्ववैरानुसारिणा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102843, "chapter_id": 3228, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि चतुरशीतितमोऽध्यायः॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]