[
  {
    "id": 16757001,
    "chapter_id": 6157,
    "verse_number": "9.1",
    "content_sanskrit": "श्रीभगवानुवाच —",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "BG_C09_V01"
  },
  {
    "id": 16757002,
    "chapter_id": 6157,
    "verse_number": "9.2",
    "content_sanskrit": "राजविद्या राजगुह्यं पवित्रमिदमुत्तमम् ।\nप्रत्यक्षावगमं धर्म्यं सुसुखं कर्तुमव्ययम् ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "BG_C09_V02"
  },
  {
    "id": 16757003,
    "chapter_id": 6157,
    "verse_number": "9.3",
    "content_sanskrit": "अश्रद्दधानाः पुरुषा धर्मस्यास्य परन्तप ।\nअप्राप्य मां निवर्तन्ते मृत्युसंसारवर्त्मनि ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "BG_C09_V03"
  },
  {
    "id": 16757004,
    "chapter_id": 6157,
    "verse_number": "9.4",
    "content_sanskrit": "मया ततमिदं सर्वं जगतदव्यक्तमूर्तिना ।\nमत्स्थानि सर्वभूतानि न चाहं तेष्ववस्थितः ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "BG_C09_V04"
  },
  {
    "id": 16757005,
    "chapter_id": 6157,
    "verse_number": "9.5",
    "content_sanskrit": "न च मत्स्थानि भूतानि पश्य मे योगमैश्वरम् ।\nभूतभृन्न च भूतस्थो ममात्मा भूतभावनः ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "BG_C09_V05"
  },
  {
    "id": 16757006,
    "chapter_id": 6157,
    "verse_number": "9.6",
    "content_sanskrit": "यथाकाशस्थितो नित्यं वायुः सर्वत्रगो महान् ।\nतथा सर्वाणि भूतानि मत्स्थानीत्युपधारय ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "BG_C09_V06"
  },
  {
    "id": 16757007,
    "chapter_id": 6157,
    "verse_number": "9.7",
    "content_sanskrit": "सर्वभूतानि कौन्तेय प्रकृतिं यान्ति मामिकाम् ।\nकल्पक्षये पुनस्तानि कल्पादौ विसृजाम्यहम् ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "BG_C09_V07"
  },
  {
    "id": 16757008,
    "chapter_id": 6157,
    "verse_number": "9.8",
    "content_sanskrit": "प्रकृतिं स्वामवष्टभ्य विसृजामि पुनः पुनः ।\nभूतग्राममिमं कृत्स्नमवशं प्रकृतेर्वशात् ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "BG_C09_V08"
  },
  {
    "id": 16757009,
    "chapter_id": 6157,
    "verse_number": "9.9",
    "content_sanskrit": "न च मां तानि कर्माणि निबध्नन्ति धनञ्जय ।\nउदासीनवदासीनमसक्तं तेषु कर्मसु ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "base_unit_id": "BG_C09_V09"
  },
  {
    "id": 16757010,
    "chapter_id": 6157,
    "verse_number": "9.10",
    "content_sanskrit": "मयाध्यक्षेण प्रकृतिः सूयते सचराचरम् ।\nहेतुनानेन कौन्तेय जगद्विपरिवर्तते ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "base_unit_id": "BG_C09_V10"
  },
  {
    "id": 16757011,
    "chapter_id": 6157,
    "verse_number": "9.11",
    "content_sanskrit": "अवजानन्ति मां मूढा मानुषीं तनुमाश्रितम् ।\nपरं भावमजानन्तो मम भूतमहेश्वरम् ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "BG_C09_V11"
  },
  {
    "id": 16757012,
    "chapter_id": 6157,
    "verse_number": "9.12",
    "content_sanskrit": "मोघाशा मोघकर्माणो मोघज्ञाना विचेतसः ।\nराक्षसीमासुरीं चैव प्रकृतिं मोहिनीं श्रिताः ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "BG_C09_V12"
  },
  {
    "id": 16757013,
    "chapter_id": 6157,
    "verse_number": "9.13",
    "content_sanskrit": "महात्मानस्तु मां पार्थ दैवीं प्रकृतिमाश्रिताः ।\nभजन्त्यनन्यमनसो ज्ञात्वा भूतादिमव्ययम् ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "base_unit_id": "BG_C09_V13"
  },
  {
    "id": 16757014,
    "chapter_id": 6157,
    "verse_number": "9.14",
    "content_sanskrit": "सततं कीर्तयन्तो मां यतन्तश्च दृढव्रताः ।\nनमस्यन्तश्च मां भक्त्या नित्ययुक्ता उपासते ॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "base_unit_id": "BG_C09_V14"
  },
  {
    "id": 16757015,
    "chapter_id": 6157,
    "verse_number": "9.15",
    "content_sanskrit": "ज्ञानयज्ञेन चाप्यन्ये यजन्तो मामुपासते ।\nएकत्वेन पृथक्त्वेन बहुधा विश्वतोमुखम् ॥ १५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "base_unit_id": "BG_C09_V15"
  },
  {
    "id": 16757016,
    "chapter_id": 6157,
    "verse_number": "9.16",
    "content_sanskrit": "अहं क्रतुरहं यज्ञः स्वधाहमहमौषधम् ।\nमन्त्रोऽहमहमेवाज्यमहमग्निरहं हुतम् ॥ १६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "base_unit_id": "BG_C09_V16"
  },
  {
    "id": 16757017,
    "chapter_id": 6157,
    "verse_number": "9.17",
    "content_sanskrit": "पिताहमस्य जगतो माता धाता पितामहः ।\nवेद्यं पवित्रमोङ्कार ऋक्साम यजुरेव च ॥ १७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "base_unit_id": "BG_C09_V17"
  },
  {
    "id": 16757018,
    "chapter_id": 6157,
    "verse_number": "9.18",
    "content_sanskrit": "गतिर्भर्ता प्रभुः साक्षी निवासः शरणं सुहृत् ।\nप्रभवः प्रलयः स्थानं निधानं बीजमव्ययम् ॥ १८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "base_unit_id": "BG_C09_V18"
  },
  {
    "id": 16757019,
    "chapter_id": 6157,
    "verse_number": "9.19",
    "content_sanskrit": "तपाम्यहमहं वर्षं निगृह्णाम्युत्सृजामि च ।\nअमृतं चैव मृत्युश्च सदसच्चाहमर्जुन ॥ १९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "base_unit_id": "BG_C09_V19"
  },
  {
    "id": 16757020,
    "chapter_id": 6157,
    "verse_number": "9.20",
    "content_sanskrit": "त्रैविद्या मां सोमपाः पूतपापा यज्ञैरिष्ट्वा स्वर्गतिं प्रार्थयन्ते ।\nते पुण्यमासाद्य सुरेन्द्रलोकमश्नन्ति दिव्यान्दिवि देवभोगान् ॥ २० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "base_unit_id": "BG_C09_V20"
  },
  {
    "id": 16757021,
    "chapter_id": 6157,
    "verse_number": "9.21",
    "content_sanskrit": "ते तं भुक्त्वा स्वर्गलोकं विशालं\nक्षीणे पुण्ये मर्त्यलोकं विशन्ति ।\nएवं त्रयीधर्ममनुप्रपन्ना\nगतागतं कामकामा लभन्ते ॥ २१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "base_unit_id": "BG_C09_V21"
  },
  {
    "id": 16757022,
    "chapter_id": 6157,
    "verse_number": "9.22",
    "content_sanskrit": "अनन्याश्चिन्तयन्तो मां\nये जनाः पर्युपासते ।\nतेषां नित्याभियुक्तानां\nयोगक्षेमं वहाम्यहम् ॥ २२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "base_unit_id": "BG_C09_V22"
  },
  {
    "id": 16757023,
    "chapter_id": 6157,
    "verse_number": "9.23",
    "content_sanskrit": "येऽप्यन्यदेवताभक्ता\nयजन्ते श्रद्धयान्विताः ।\nतेऽपि मामेव कौन्तेय\nयजन्त्यविधिपूर्वकम् ॥ २३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "base_unit_id": "BG_C09_V23"
  },
  {
    "id": 16757024,
    "chapter_id": 6157,
    "verse_number": "9.24",
    "content_sanskrit": "अहं हि सर्वयज्ञानां\nभोक्ता च प्रभुरेव च ।\nन तु मामभिजानन्ति\nतत्त्वेनातश्च्यवन्ति ते ॥ २४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "base_unit_id": "BG_C09_V24"
  },
  {
    "id": 16757025,
    "chapter_id": 6157,
    "verse_number": "9.25",
    "content_sanskrit": "यान्ति देवव्रता देवान्पितॄन्यान्ति पितृव्रताः ।\nभूतानि यान्ति भूतेज्या यान्ति मद्याजिनोऽपि माम् ॥ २५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "base_unit_id": "BG_C09_V25"
  },
  {
    "id": 16757026,
    "chapter_id": 6157,
    "verse_number": "9.26",
    "content_sanskrit": "पत्रं पुष्पं फलं तोयं यो मे भक्त्या प्रयच्छति ।\nतदहं भक्त्युपहृतमश्नामि प्रयतात्मनः ॥ २६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "base_unit_id": "BG_C09_V26"
  },
  {
    "id": 16757027,
    "chapter_id": 6157,
    "verse_number": "9.27",
    "content_sanskrit": "यत्करोषि यदश्नासि\nयज्जुहोषि ददासि यत् ।\nयत्तपस्यसि कौन्तेय\nतत्कुरुष्व मदर्पणम् ॥ २७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "base_unit_id": "BG_C09_V27"
  },
  {
    "id": 16757028,
    "chapter_id": 6157,
    "verse_number": "9.28",
    "content_sanskrit": "शुभाशुभफलैरेवं\nमोक्ष्यसे कर्मबन्धनैः ।\nसंन्यासयोगयुक्तात्मा\nविमुक्तो मामुपैष्यसि ॥ २८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "base_unit_id": "BG_C09_V28"
  },
  {
    "id": 16757029,
    "chapter_id": 6157,
    "verse_number": "9.29",
    "content_sanskrit": "समोऽहं सर्वभूतेषु\nन मे द्वेष्योऽस्ति न प्रियः ।\nये भजन्ति तु मां भक्त्या\nमयि ते तेषु चाप्यहम् ॥ २९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "base_unit_id": "BG_C09_V29"
  },
  {
    "id": 16757030,
    "chapter_id": 6157,
    "verse_number": "9.30",
    "content_sanskrit": "अपि चेत्सुदुराचारो\nभजते मामनन्यभाक् ।\nसाधुरेव स मन्तव्यः\nसम्यग्व्यवसितो हि सः ॥ ३० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "base_unit_id": "BG_C09_V30"
  },
  {
    "id": 16757031,
    "chapter_id": 6157,
    "verse_number": "9.31",
    "content_sanskrit": "क्षिप्रं भवति धर्मात्मा\nशश्वच्छान्तिं निगच्छति ।\nकौन्तेय प्रतिजानीहि\nन मे भक्तः प्रणश्यति ॥ ३१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "base_unit_id": "BG_C09_V31"
  },
  {
    "id": 16757032,
    "chapter_id": 6157,
    "verse_number": "9.32",
    "content_sanskrit": "मां हि पार्थ व्यपाश्रित्य येऽपि स्युः पापयोनयः ।\nस्त्रियो वैश्यास्तथा शूद्रास्तेऽपि यान्ति परां गतिम् ॥ ३२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "base_unit_id": "BG_C09_V32"
  },
  {
    "id": 16757033,
    "chapter_id": 6157,
    "verse_number": "9.33",
    "content_sanskrit": "किं पुनर्ब्राह्मणाः पुण्या भक्ता राजर्षयस्तथा ।\nअनित्यमसुखं लोकमिमं प्राप्य भजस्व माम् ॥ ३३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "base_unit_id": "BG_C09_V33"
  },
  {
    "id": 16757034,
    "chapter_id": 6157,
    "verse_number": "9.34",
    "content_sanskrit": "मन्मना भव मद्भक्तो मद्याजी मां नमस्कुरु ।\nमामेवैष्यसि युक्त्वैवमात्मानं मत्परायणः ॥ ३४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "base_unit_id": "BG_C09_V34"
  }
]