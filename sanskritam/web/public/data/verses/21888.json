[{"id": 7001888000, "chapter_id": 21888, "verse_number": "६७-१", "content_sanskrit": "स्वारोचिषमन्वन्तरवर्णनम् ।\nमार्कण्डेय उवाच ।\nततः स्वारोचिषं नाम्ना द्युतिमन्तं प्रजापतिम् ।\nमनुं चकार भगवांस्तस्य मन्वन्तरं शृणु ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001888001, "chapter_id": 21888, "verse_number": "६७-२", "content_sanskrit": "तत्रान्तरे तु ये देवा मुनयस्तत्सुताश्च ये ।\nभूपालाः क्रौष्टुके ये तान्गदतस्त्वं निशामय ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001888002, "chapter_id": 21888, "verse_number": "६७-३", "content_sanskrit": "देवाः पारावतास्तत्र तथैव तुषिता द्विज ।\nस्वारोचिषेऽन्तरे चेन्द्रो विपश्चिदिति विश्रुतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001888003, "chapter_id": 21888, "verse_number": "६७-४", "content_sanskrit": "ऊर्जस्तम्बस्तथा प्राणो दत्तोऽलिर्ऋषभस्तथा ।\nनिश्चरश्चार्ववीरश्च तत्र सप्तर्षयोऽभवम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001888004, "chapter_id": 21888, "verse_number": "६७-५", "content_sanskrit": "चैत्रकिंपुरुषाद्याश्च सुतास्तस्य महात्मनः ।\nसप्तासन्सुमहावीर्याः पृथिवीपरिपालकाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001888005, "chapter_id": 21888, "verse_number": "६७-६", "content_sanskrit": "तस्य मन्वन्तरं यावत्तावत्तद्वंशविस्तरे ।\nभुक्तेयमवनिः सर्वा द्वितीयं वै तदन्तरम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001888006, "chapter_id": 21888, "verse_number": "६७-७", "content_sanskrit": "स्वरोचिषस्तु चरितं जन्म स्वारोचिषस्य च ।\nनिशम्य मुच्यते पापैः श्रद्धधानो हि मानवः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]