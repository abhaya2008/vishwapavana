[{"id": 6000105000, "chapter_id": 10105, "verse_number": null, "content_sanskrit": "अथ दशमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000105001, "chapter_id": 10105, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.001.m4a", "display_order": 2}, {"id": 6000105002, "chapter_id": 10105, "verse_number": "५-१०-१", "content_sanskrit": "अथ सिन्धुसौवीरपते रहूगणस्य व्रजत इक्षुमत्यास्तटे नद्या भगवन्तं कपिलऋषिं द्रष्टुं कस्मिंश्चिदाश्रमे स्थितं तत्कुलपतिना शिबिकावाहकपुरुषान्वेषणसमये दैवेनोपसादितः स द्विजवर उपलब्ध एष पीवा युवा संहननाङ्गः खरवत् धुरं वोढुमलमिति पूर्वविष्टिगृहीतैः सह गृहीतः प्रसभमतदर्ह उवाह शिबिकां स हि महानुभावः॥ ५/१०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.002.m4a", "display_order": 3, "topics": [{"text": "कस्यचिद् रहूगणनाम्नो राज्ञः शिबिकावहने जडभरतस्य नियोजनम्", "range": "१"}]}, {"id": 6000105003, "chapter_id": 10105, "verse_number": "५-१०-२", "content_sanskrit": "यदा हि द्विजवरस्य युगमात्रावलोकानुगतेर्न समा पुरुषगतिस्तदा विषमगतायां स्वशिबिकायां रहूगण उपधार्य पुरुषानधिवहत आह ‘‘हे वोढारः साध्वतिक्रमत किमिति विषममूह्यते यानम्’’ इति॥ ५/१०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.003.m4a", "display_order": 4, "topics": [{"text": "विबिकायां विषमगतायां रहूगणेन भर्त्सना", "range": "२–८"}]}, {"id": 6000105004, "chapter_id": 10105, "verse_number": "५-१०-३", "content_sanskrit": "अथ त ईश्वरवचः सोपालम्भमुपाकर्ण्य तुर्याच्छङ्कितमनसस्तं विज्ञापयाम्बभूवुः॥ ५/१०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.004.m4a", "display_order": 5}, {"id": 6000105005, "chapter_id": 10105, "verse_number": "५-१०-४", "content_sanskrit": "‘‘न वयं नरदेव प्रमत्ताः भवन्नियमानुपथाः साध्वेव वहामः अयमधुनैव नियुक्तोऽपि न द्रुतं व्रजति।\nनानेन सह वोढुमिह वयं पारयामः’’ इति॥ ५/१०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.005.m4a", "display_order": 6}, {"id": 6000105006, "chapter_id": 10105, "verse_number": "५-१०-५", "content_sanskrit": "सांसर्गिको दोष एव नूनमेकस्यापि सर्वेषां संसर्गिणां भवितुमर्हतीति निशम्य कृपणं वचो राजा रहूगण उपासितवृद्धोऽपि निसर्गेण बलात्कृत ईषदुत्थितमन्युरविस्पष्टब्रह्मतेजसंजातवेदसमिव रजसा तमसाऽऽवृतमतिराह॥ ५/१०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.006.m4a", "display_order": 7}, {"id": 6000105007, "chapter_id": 10105, "verse_number": "५-१०-६", "content_sanskrit": "‘‘अहो कष्टं भ्रातर्व्यक्तमुरुपरिश्रान्तो दीर्घमध्वानमेक एव ऊहितवान् सुचिरं नातिपीवा नातिसंहननाङ्गो जरसोपद्रुतो भवान्सखे नो एवापर एते सङ्घट्टिनः’’॥ ५/१०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.007.m4a", "display_order": 8}, {"id": 6000105008, "chapter_id": 10105, "verse_number": "५-१०-७", "content_sanskrit": "इति बहुविप्रलब्धोऽप्यविद्यया विहितद्रव्यगुणकर्माशयस्वचरमकलेवर अवस्तुनि संस्थानविशेषे अहंममेत्यनध्यारोपितमिथ्याप्रत्ययो ब्रह्मभूतस्तूष्णीं शिबिकामुवाह॥ ५/१०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.008.m4a", "display_order": 9}, {"id": 6000105009, "chapter_id": 10105, "verse_number": "५-१०-८", "content_sanskrit": "अथ पुनः स्वशिबिकायां विषमगतायां प्रकुपित उवाच रहूगणः ‘‘किमरे त्वं जीवन्मृतोऽसि मां कदर्थीकृत्य भर्तृशासनमतिचरसि।\nप्रमत्तस्य ते करोमि चिकित्सां दण्डपाणिरिव जनताया यथा प्रकृतिं स्वां भजिष्यसि’’ इति॥ ५/१०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.009.m4a", "display_order": 10}, {"id": 6000105010, "chapter_id": 10105, "verse_number": "५-१०-९", "content_sanskrit": "एवं बह्वबद्धमभिभाषमाणं नरदेवाभिमानिनं रजसा तमसाऽनुवृद्धेन मदेन तिरस्कृताशेष-भगवत्प्रियनिकेतं पण्डितमानिनं स भगवान् ब्राह्मणो ब्रह्मभूतः सर्वभूतसुहृदात्मा योगेश्वरचर्यायां नातिव्युत्पन्नमतिं स्मयमान इव विगतस्मय इदमाह॥ ५/१०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.010.m4a", "display_order": 11}, {"id": 6000105011, "chapter_id": 10105, "verse_number": null, "content_sanskrit": "ब्राह्मण उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.011.m4a", "display_order": 12}, {"id": 6000105012, "chapter_id": 10105, "verse_number": "५-१०-१०", "content_sanskrit": "त्वयोदितं व्यक्तमविप्रलब्धं भर्तुः स मे स्याद्यदि वीर भारः।\nगन्तुर्यदि स्यादधिगम्यमध्वा पीवेति चासौ न विदां प्रवादः॥ ५/१०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.012.m4a", "display_order": 13, "topics": [{"text": "जडभरतेन तस्मै ज्ञानोपदेशः", "range": "१०–१६"}]}, {"id": 6000105013, "chapter_id": 10105, "verse_number": "५-१०-११", "content_sanskrit": "स्थौल्यं कार्श्यं व्याधय आधयश्च क्षुत्तृड्भयं कलिरिच्छा जरा च।\nनिद्राऽरतिर्मन्युरहंमदश्च देहेन जातस्य हि मे न सन्ति॥ ५/१०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.013.m4a", "display_order": 14}, {"id": 6000105014, "chapter_id": 10105, "verse_number": "५-१०-१२", "content_sanskrit": "जीवन्मृतत्वं नियमेन राजन्नाद्यन्तवद्यद्विकृतस्य दृष्टम्।\nस्वस्वामिभावो ध्रुव एष यत्र तर्ह्यच्युतेऽसाविति कृत्ययोगः॥ ५/१०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.014.m4a", "display_order": 15}, {"id": 6000105015, "chapter_id": 10105, "verse_number": "५-१०-१३", "content_sanskrit": "विशेषबुद्धेर्विवरं मनाक्क्‍व पश्यामि यन्न व्यवहारतोऽन्यत्।\nक ईश्वरस्तत्र किमीशितव्यम् अथापि राजन्करवाम किं ते॥ ५/१०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.015.m4a", "display_order": 16}, {"id": 6000105016, "chapter_id": 10105, "verse_number": "५-१०-१४", "content_sanskrit": "उन्मत्तमत्तजडवत्स्वसंस्थां गतस्य मे वीर चिकित्सितेन।\nअर्थः कियान् भवता शिक्षितेन स्तब्धप्रमत्तस्य च पिष्टपेषः॥ ५/१०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.016.m4a", "display_order": 17}, {"id": 6000105017, "chapter_id": 10105, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.017.m4a", "display_order": 18}, {"id": 6000105018, "chapter_id": 10105, "verse_number": "५-१०-१५", "content_sanskrit": "एतावदनुवादपरिभाषया प्रत्युदीर्य मुनिवर उपशमशील उपरतानात्म्यनिमित्तमुपभोगेन कर्मारब्धं व्यपनयन् राजयानमपि तथोवाह॥ ५/१०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.018.m4a", "display_order": 19}, {"id": 6000105019, "chapter_id": 10105, "verse_number": "५-१०-१६", "content_sanskrit": "स चापि पाण्डवेय सिन्धुसौवीरपतिस्तत्त्वजिज्ञासायां सम्यक्श्रद्धयाऽधिकृताधिकारः तद्घृदयग्रन्थिविमोचनं द्विजवच आश्रुत्य बहुयोगग्रन्थमतं त्वरयाऽवरुह्य शिरसा पादमूलमुपगतः क्षमापयन्विगतनरदेवस्मय उवाच॥ ५/१०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.019.m4a", "display_order": 20}, {"id": 6000105020, "chapter_id": 10105, "verse_number": null, "content_sanskrit": "रहूगण उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.020.m4a", "display_order": 21}, {"id": 6000105021, "chapter_id": 10105, "verse_number": "५-१०-१७", "content_sanskrit": "कस्त्वं निगूढश्चरसि द्विजानां बिभर्षि सूत्रं कतमोऽवधूतः।\nकस्यासि कुत्रत्य इहापि कस्मात् क्षेमाय नश्चेदसि नोत शुक्लः॥ ५/१०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.021.m4a", "display_order": 22}, {"id": 6000105022, "chapter_id": 10105, "verse_number": "५-१०-१८", "content_sanskrit": "नाहं विशङ्के सुरराजवज्रान्न त्र्यक्षशूलान्न यमस्य दण्डात्।\nनाग्न्यर्कसोमानिलवित्तपास्‍त्राच्छङ्के भृशं ब्रह्मकुलावमानात्॥ ५/१०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.022.m4a", "display_order": 23}, {"id": 6000105023, "chapter_id": 10105, "verse_number": "५-१०-१९", "content_sanskrit": "तद्ब्रूह्यसङ्गो जडवन्निगूढविज्ञानवीर्यो विचरस्यपारः।\nवचांसि योगग्रथितानि साधो न नः क्षमं ते मनसा विभेत्तुम्॥ ५/१०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.023.m4a", "display_order": 24}, {"id": 6000105024, "chapter_id": 10105, "verse_number": "५-१०-२०", "content_sanskrit": "अहं च योगेश्वरमात्मतत्त्वविदां मुनीनां कपिलं गुरुं वै।\nप्रष्टुं प्रवृत्तः किमिहारणं यत्साक्षाद्धरिं ज्ञानकलावतीर्णम्॥ ५/१०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.024.m4a", "display_order": 25}, {"id": 6000105025, "chapter_id": 10105, "verse_number": "५-१०-२१", "content_sanskrit": "स वै भवाल्‍ँलोकनिरीक्षणार्थमव्यक्तलिङ्गो विचरत्यपिस्वित्।\nयोगेश्वराणां गतिमल्पबुद्धिः कथं विचक्षीत गृहानुबद्धः॥ ५/१०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.025.m4a", "display_order": 26}, {"id": 6000105026, "chapter_id": 10105, "verse_number": "५-१०-२२", "content_sanskrit": "दृष्टः श्रमः कर्मत आत्मनो वै भर्तुर्गन्तुर्भवतश्चाद्य मन्ये।\nयथा श्रुतोदानयनादिभावाः समूलदृष्टो व्यवहारमार्गः॥ ५/१०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.026.m4a", "display_order": 27}, {"id": 6000105027, "chapter_id": 10105, "verse_number": "५-१०-२३", "content_sanskrit": "स्थाल्यग्नितापात्पयसो हि तापस्तत्तापतस्तण्डुलगर्भरन्धिः।\nदेहेन्द्रियास्वाशयसन्निकर्षात्तत्संसृतिः पुरुषस्यानुरोधात्॥ ५/१०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.027.m4a", "display_order": 28}, {"id": 6000105028, "chapter_id": 10105, "verse_number": "५-१०-२४", "content_sanskrit": "शास्ताऽधिगोप्ता नृपतिः प्रजानां यः किङ्करो वै, न पिनष्टि पिष्टम्।\nस्वधर्ममाराधनमच्युतस्य यदीहमानो विजहात्यघौघम्॥ ५/१०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.028.m4a", "display_order": 29}, {"id": 6000105029, "chapter_id": 10105, "verse_number": "५-१०-२५", "content_sanskrit": "तन्मे भवान्नरदेवाभिमानमदेन तुच्छीकृतसत्तमस्य।\nकृषीष्ट मैत्रीं दृशमार्तबन्धो यया तरेयं सदवध्यानमंहः॥ ५/१०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.029.m4a", "display_order": 30}, {"id": 6000105030, "chapter_id": 10105, "verse_number": "५-१०-२६", "content_sanskrit": "न विक्रिया विश्वसुहृत्सखस्य साम्येन वीताभिमतेस्तवापि।\nमहद्विमानात्स्वकृताद्धि मादृग्धक्षत्यदूरादपि शूलपाणिः॥ ५/१०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_010/BhP_05.010.030.m4a", "display_order": 31}, {"id": 6000105031, "chapter_id": 10105, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां पञ्चमस्कन्धे दशमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]