[{"id": 2052334, "chapter_id": 2157, "verse_number": "७-८४-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2052335, "chapter_id": 2157, "verse_number": "७-८४-१", "content_sanskrit": "तथा तु वदतां तेषां प्रादुरासीद्धनञ्जयः।\nदिदृक्षुर्भरतश्रेष्ठं राजानं ससुहृद्गणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2052336, "chapter_id": 2157, "verse_number": "७-८४-२", "content_sanskrit": "तं प्रविष्टं शुभां कक्ष्यामभिवन्द्याग्रतः स्यितम्।\nतमुत्थायार्जुनं प्रेम्णा सस्वजे पाण्डवर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2052337, "chapter_id": 2157, "verse_number": "७-८४-३", "content_sanskrit": "मूर्ध्नि चैनमुपाघ्राय परिष्वज्य च बाहुना।\nआशिषः परमाः प्रोच्य स्मयमानोऽभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2052338, "chapter_id": 2157, "verse_number": "७-८४-४", "content_sanskrit": "व्यक्तमर्जुन सङ्ग्रामे ध्रुवस्ते विजयो महान्।\nतादृग्रूपा च ते च्छाया प्रसन्नश्च जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2052339, "chapter_id": 2157, "verse_number": "७-८४-५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2052340, "chapter_id": 2157, "verse_number": "७-८४-५", "content_sanskrit": "तमब्रवीत्ततो जिष्णुर्महदाश्चर्यमुत्तमम्।\nदृष्टवानस्मि भद्रं ते केशवस्य प्रसादजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2052341, "chapter_id": 2157, "verse_number": "७-८४-६", "content_sanskrit": "ततस्तत्कथयामास यथादृष्टं धनञ्जयः।\nआश्वासनार्थं सुहृदां त्र्यम्बकेण समागमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2052342, "chapter_id": 2157, "verse_number": "७-८४-७", "content_sanskrit": "ततः शिरोभिरवनिं स्पृष्ट्वा सर्वे च विस्मिताः।\nनमस्कृत्य वृषाङ्काय साधुसाध्वित्यथाब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2052343, "chapter_id": 2157, "verse_number": "७-८४-८", "content_sanskrit": "अनुज्ञातास्ततः सर्वे सुहृदो धर्मसूनुना।\nत्वरमाणाः सुसन्नद्धा हृष्टा युद्धाय निर्ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2052344, "chapter_id": 2157, "verse_number": "७-८४-९", "content_sanskrit": "अभिवाद्य तु राजानं युयुधानाच्युतार्जुनाः।\nहृष्टा विनिर्ययुस्ते वै युधिष्ठिरनिवेशनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2052345, "chapter_id": 2157, "verse_number": "७-८४-१०", "content_sanskrit": "रथेनैकेन दुर्धर्षौ युयुधानजनार्दनौ।\nजग्मतुः सहितौ वीरावर्जुनस्य निवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2052346, "chapter_id": 2157, "verse_number": "७-८४-११", "content_sanskrit": "तत्र गत्वा हृषीकेशः कल्पयामास शास्त्रवित्।\nरथं रथवरस्याजौ वानरर्षभलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2052347, "chapter_id": 2157, "verse_number": "७-८४-१२", "content_sanskrit": "स मेघसमनिर्घोषस्तप्तकाञ्चनसप्रभः।\nबभौ रथवरः क्लृप्तः शिशुर्दिवसकृद्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2052348, "chapter_id": 2157, "verse_number": "७-८४-१३", "content_sanskrit": "ततः पुरुषशार्दूलः सज्जं सर्वं न्यवेदयत्।\nरथं पुरुषसिंहस्य सध्वजं सुपताकिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2052349, "chapter_id": 2157, "verse_number": "७-८४-१४", "content_sanskrit": "स तु लोकवरः पुंसां किरीटी हेमवर्मभृत्।\nचापबाणधरो वाहं प्रदक्षिणमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2052350, "chapter_id": 2157, "verse_number": "७-८४-१५", "content_sanskrit": "तपोविद्यावयोवृद्धैः क्रियावद्भिर्जितेन्द्रियैः।\nस्तूयमानो जयाशीर्भिरारुरोह महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2052351, "chapter_id": 2157, "verse_number": "७-८४-१६", "content_sanskrit": "जैत्रैः साङ्ग्रामिकैर्मन्त्रैः पूर्वमेव रथोत्तमम्।\nअभिमन्त्रितमर्चिष्मानुदयं भास्करो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2052352, "chapter_id": 2157, "verse_number": "७-८४-१७", "content_sanskrit": "स रथे रथिनां श्रेष्ठः काञ्चने काञ्चनावृतः।\nविबभौ विमलोऽर्चिष्मान्मेराविव दिवाकरः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2052353, "chapter_id": 2157, "verse_number": "७-८४-१८", "content_sanskrit": "अन्वारुरुहतुः पार्थं युयुधानजनार्दनौ।\nशर्यातेर्यज्ञमायान्तं यथेन्द्रं देवमश्विनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2052354, "chapter_id": 2157, "verse_number": "७-८४-१९", "content_sanskrit": "अथ जग्राह गोविन्दो रश्मीन्रश्मिविदांवरः।\nमातलिर्वासवस्येव वृत्रं हन्तुं प्रयास्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2052355, "chapter_id": 2157, "verse_number": "७-८४-२०", "content_sanskrit": "स ताभ्यां सहितः पार्थो रथप्रवरमास्थितः।\nसहितो बुधशुक्राभ्यां तमो निघ्नन्यथा शशी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2052356, "chapter_id": 2157, "verse_number": "७-८४-२१", "content_sanskrit": "सैन्धवस्य वधप्रेप्सुः प्रयातः शत्रुपूगहा।\nसहाम्बुपतिमित्राभ्यां यथेन्द्रस्तारकामये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2052357, "chapter_id": 2157, "verse_number": "७-८४-२२", "content_sanskrit": "ततो वादित्रनिर्घोषैर्माङ्गल्यैश्च स्तवैः शुभैः।\nप्रयान्तमर्जुनं वीरं मागधाश्चैव तुष्टुवुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2052358, "chapter_id": 2157, "verse_number": "७-८४-२३", "content_sanskrit": "सजयाशीः सपुण्याहः सूतमागधनिःस्वनः।\nयुक्तो वादित्रघोषेण तेषां रतिकरोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2052359, "chapter_id": 2157, "verse_number": "७-८४-२४", "content_sanskrit": "तमनुप्रवणो वायुः पुण्यगन्धवहः शुभः।\nववौ संहर्षयन्पार्थं द्विषतश्चापि शोषयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2052360, "chapter_id": 2157, "verse_number": "७-८४-२५", "content_sanskrit": "ततस्तस्मिन्क्षणे राजन्विविधानि शुभानि च।\nप्रादुरासन्निमित्तानि विजयाय बहूनि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2052361, "chapter_id": 2157, "verse_number": "७-८४-२६", "content_sanskrit": "पाण्डवानां त्वदीयानां विपरीतानि मारिष।\nदृष्ट्वाऽर्जुनो निमित्तानि विजयाय प्रदक्षिणम्।\nयुयुधानं महेष्वासमिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2052362, "chapter_id": 2157, "verse_number": "७-८४-२७", "content_sanskrit": "युयुधानाद्य युद्धे मे दृश्यते विजयो ध्रुवः।\nयथाहीमानि लिङ्गानि दृश्यन्ते शिनिपुङ्गव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2052363, "chapter_id": 2157, "verse_number": "७-८४-२८", "content_sanskrit": "सोऽहं तत्र गमिष्यामि यत्र सैन्धवको नृपः।\nयियासुर्यमलोकाय मम वीर्यं प्रतीक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2052364, "chapter_id": 2157, "verse_number": "७-८४-२९", "content_sanskrit": "यथा परमकं कृत्यं सैन्धवस्य वधो मम।\nतथैव सुमहत्कृत्यं धर्मराजस्य रक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2052365, "chapter_id": 2157, "verse_number": "७-८४-३०", "content_sanskrit": "स त्वमद्य महाबाहो राजानं परिपालय।\nयथैव हि मया गुप्तस्त्वया गुप्तो भवेत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2052366, "chapter_id": 2157, "verse_number": "७-८४-३१", "content_sanskrit": "न पश्यामि च तं लोके यस्त्वां युद्धे पराजयेत्।\nवासुदेवसमं युद्धे स्वयमप्यमरेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2052367, "chapter_id": 2157, "verse_number": "७-८४-३२", "content_sanskrit": "त्वयि चाहं पराश्वस्तः प्रद्युम्ने वा महारथे।\nशक्नुयां सैन्धवं हन्तुमनपेक्षो नरर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2052368, "chapter_id": 2157, "verse_number": "७-८४-३३", "content_sanskrit": "मय्यपेक्षा न कर्तव्या गोप्ताऽयं मम केशवः।\nराज्ञ एव परा गुप्तिः कार्या सर्वात्मना त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2052369, "chapter_id": 2157, "verse_number": "७-८४-३४", "content_sanskrit": "न हि यत्र महाबाहुर्वासुदेवो व्यवस्थितः।\nकिञ्चिद्व्यापद्यते तत्र यत्राहमपि च ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2052370, "chapter_id": 2157, "verse_number": "७-८४-३५", "content_sanskrit": "एवमुक्तस्तु पार्थेन सात्यकिः परवीरहा।\nतथेत्युक्त्वाऽगमत्तत्र यत्र राजा युधिष्ठिरः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2052371, "chapter_id": 2157, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि प्रतिज्ञापर्वणि चतुरशीतितमोऽध्यायः॥ ८४ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-८४-१२ शिशुर्दिवसकृत् बालः सूर्यः॥ ५-८४-१८ यथा च्यवनमश्विनौ इति क.ट.ड.पाठः॥ ५-८४-२६ प्रदक्षिणं छन्दोनुवर्तिनम्॥ ५-८४-३३ अपेक्षा अनुरोधः॥ ५-८४-८४ चतुरशीतितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]