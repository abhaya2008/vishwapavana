[{"id": 5000073000, "chapter_id": 9073, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे त्रिसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000073001, "chapter_id": 9073, "verse_number": "१-७३-१", "content_sanskrit": "यस्मिंस्तु दिवसे राजा चक्रे गोदानमुत्तमम्।\nतस्मिंस्तु दिवसे वीरो युधाजित् समुपेयिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000073002, "chapter_id": 9073, "verse_number": "१-७३-२", "content_sanskrit": "पुत्रः केकयराजस्य साक्षाद्भरतमातुलः।\nदृष्ट्वा पृष्ट्वा च कुशलं राजानमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000073003, "chapter_id": 9073, "verse_number": "१-७३-३", "content_sanskrit": "केकयाधिपती राजा स्नेहात् कुशलमब्रवीत्।\nयेषां कुशलकामोऽसि तेषां सम्प्रत्यनामयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000073004, "chapter_id": 9073, "verse_number": "१-७३-४", "content_sanskrit": "स्वस्रीयं मम राजेन्द्र द्रष्टुकामो महीपतिः।\nतदर्थमुपयातोऽहमयोध्यां रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000073005, "chapter_id": 9073, "verse_number": "१-७३-५", "content_sanskrit": "श्रुत्वा त्वहमयोध्यायां विवाहार्थं तवात्मजान्।\nमिथिलामुपयातांस्तु त्वया सह महीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000073006, "chapter_id": 9073, "verse_number": "१-७३-६", "content_sanskrit": "त्वरयाभ्युपयातोऽहं द्रष्टुकामः स्वसुः सुतम्।\nअथ राजा दशरथः प्रियातिथिमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000073007, "chapter_id": 9073, "verse_number": "१-७३-७", "content_sanskrit": "दृष्ट्वा परमसत्कारैः पूजनार्हमपूजयत्।\nततस्तामुषितो रात्रिं सह पुत्रैर्महात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000073008, "chapter_id": 9073, "verse_number": "१-७३-८", "content_sanskrit": "प्रभाते पुनरुत्थाय कृत्वा कर्माणि तत्त्ववित् ।\nऋषींस्तदा पुरस्कृत्य यज्ञवाटमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000073009, "chapter_id": 9073, "verse_number": "१-७३-९", "content_sanskrit": "युक्ते मुहूर्ते विजये सर्वाभरणभूषितैः।\nभ्रातृभिः सहितो रामः कृतकौतुकमंगलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000073010, "chapter_id": 9073, "verse_number": "१-७३-१०", "content_sanskrit": "वसिष्ठं पुरतः कृत्वा महर्षीनपरानपि।\nवसिष्ठो भगवानेत्य वैदेहमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000073011, "chapter_id": 9073, "verse_number": "१-७३-११", "content_sanskrit": "राजा दशरथो राजन् कृतकौतुकमंगलैः।\nपुत्रैर्नरवरश्रेष्ठो दातारमभिकाङ्क्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000073012, "chapter_id": 9073, "verse_number": "१-७३-१२", "content_sanskrit": "दातृप्रतिग्रहीतृभ्यां सर्वार्थाः सम्भवन्ति हि।\nस्वधर्मं प्रतिपद्यस्व कृत्वा वैवाह्यमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000073013, "chapter_id": 9073, "verse_number": "१-७३-१३", "content_sanskrit": "इत्युक्तः परमोदारो वसिष्ठेन महात्मना।\nप्रत्युवाच महातेजा वाक्यं परमधर्मवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000073014, "chapter_id": 9073, "verse_number": "१-७३-१४", "content_sanskrit": "कः स्थितः प्रतिहारो मे कस्याज्ञां सम्प्रतीक्षते।\nस्वगृहे को विचारोऽस्ति यथा राज्यमिदं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000073015, "chapter_id": 9073, "verse_number": "१-७३-१५", "content_sanskrit": "कृतकौतुकसर्वस्वा वेदिमूलमुपागताः।\nमम कन्या मुनिश्रेष्ठ दीप्ता बह्नेरिवार्चिषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000073016, "chapter_id": 9073, "verse_number": "१-७३-१६", "content_sanskrit": "सद्योऽहं त्वत्प्रतीक्षोऽस्मि वेद्यामस्यां प्रतिष्ठितः।\nअविघ्नं क्रियतां सर्वं किमर्थं हि विलम्ब्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000073017, "chapter_id": 9073, "verse_number": "१-७३-१७", "content_sanskrit": "तद् वाक्यं जनकेनोक्तं श्रुत्वा दशरथस्तदा।\nप्रवेशयामास सुतान् सर्वानृषिगणानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000073018, "chapter_id": 9073, "verse_number": "१-७३-१८", "content_sanskrit": "ततो राजा विदेहानां वसिष्ठमिदमब्रवीत्।\nकारयस्व ऋषे सर्वामृषिभिः सह धार्मिक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000073019, "chapter_id": 9073, "verse_number": "१-७३-१९", "content_sanskrit": "रामस्य लोकरामस्य क्रियां वैवाहिकीं प्रभो।\nतथेत्युक्त्वा तु जनकं वसिष्ठो भगवानृषिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000073020, "chapter_id": 9073, "verse_number": "१-७३-२०", "content_sanskrit": "विश्वामित्रं पुरस्कृत्य शतानन्दं च धार्मिकम्।\nप्रपामध्ये तु विधिवद् वेदिं कृत्वा महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000073021, "chapter_id": 9073, "verse_number": "१-७३-२१", "content_sanskrit": "अलंचकार तां वेदिं गन्धपुष्पैः समन्ततः।\nसुवर्णपालिकाभिश्च चित्रकुम्भैश्च साङ्कुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000073022, "chapter_id": 9073, "verse_number": "१-७३-२२", "content_sanskrit": "अङ्कुराढ्यैः शरावैश्च धूपपात्रैः सधूपकैः।\nशङ्खपात्रैः स्रुवैः स्रग्भिः पात्रैरर्घ्यादिपूजितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000073023, "chapter_id": 9073, "verse_number": "१-७३-२३", "content_sanskrit": "लाजपूर्णैश्च पात्रीभिरक्षतैरपि संस्कृतैः।\nदर्भैः समैः समास्तीर्य विधिवन्मन्त्रपूर्वकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000073024, "chapter_id": 9073, "verse_number": "१-७३-२४", "content_sanskrit": "अग्निमाधाय तं वेद्यां विधिमन्त्रपुरस्कृतम्।\nजुहावाग्नौ महातेजा वसिष्ठो मुनिपुंगवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000073025, "chapter_id": 9073, "verse_number": "१-७३-२५", "content_sanskrit": "ततः सीतां समानीय सर्वाभरणभूषिताम्।\nसमक्षमग्नेः संस्थाप्य राघवाभिमुखे तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000073026, "chapter_id": 9073, "verse_number": "१-७३-२६", "content_sanskrit": "अब्रवीज्जनको राजा कौसल्यानन्दवर्धनम्।\nइयं सीता मम सुता सहधर्मचरी तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000073027, "chapter_id": 9073, "verse_number": "१-७३-२७", "content_sanskrit": "प्रतीच्छ चैनां भद्रं ते पाणिं गृह्णीष्व पाणिना।\nपतिव्रता महाभागा छायेवानुगता सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000073028, "chapter_id": 9073, "verse_number": "१-७३-२८", "content_sanskrit": "इत्युक्त्वा प्राक्षिपद् राजा मन्त्रपूतं जलं तदा।\nसाधुसाध्विति देवानामृषीणां वदतां तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000073029, "chapter_id": 9073, "verse_number": "१-७३-२९", "content_sanskrit": "देवदुन्दुभिनिर्घोषः पुष्पवर्षो महानभूत्।\nएवं दत्त्वा सुतां सीतां मन्त्रोदकपुरस्कृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000073030, "chapter_id": 9073, "verse_number": "१-७३-३०", "content_sanskrit": "अब्रवीज्जनको राजा हर्षेणाभिपरिप्लुतः।\nलक्ष्मणागच्छ भद्रं ते ऊर्मिलामुद्यतां मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000073031, "chapter_id": 9073, "verse_number": "१-७३-३१", "content_sanskrit": "प्रतीच्छ पाणिं गृह्णीष्व मा भूत् कालस्य पर्ययः।\nतमेवमुक्त्वा जनको भरतं चाभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000073032, "chapter_id": 9073, "verse_number": "१-७३-३२", "content_sanskrit": "गृहाण पाणिं माण्डव्याः पाणिना रघुनन्दन।\nशत्रुघ्नं चापि धर्मात्मा अब्रवीन्मिथिलेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000073033, "chapter_id": 9073, "verse_number": "१-७३-३३", "content_sanskrit": "श्रुतकीर्तेर्महाबाहो पाणिं गृह्णीष्व पाणिना।\nसर्वे भवन्तः सौम्याश्च सर्वे सुचरितव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000073034, "chapter_id": 9073, "verse_number": "१-७३-३४", "content_sanskrit": "पत्नीभिः सन्तु काकुत्स्था मा भूत् कालस्य पर्ययः।\nजनकस्य वचः श्रुत्वा पाणीन् पाणिभिरस्पृशन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000073035, "chapter_id": 9073, "verse_number": "१-७३-३५", "content_sanskrit": "चत्वारस्ते चतसॄणां वसिष्ठस्य मते स्थिताः।\nअग्निं प्रदक्षिणं कृत्वा वेदिं राजानमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000073036, "chapter_id": 9073, "verse_number": "१-७३-३६", "content_sanskrit": "ऋषींश्चापि महात्मानः सहभार्या रघूद्वहाः।\nयथोक्तेन ततश्चक्रुर्विवाहं विधिपूर्वकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000073037, "chapter_id": 9073, "verse_number": "१-७३-३७", "content_sanskrit": "पुष्पवृष्टिर्महत्यासीदन्तरिक्षात् सुभास्वरा।\nदिव्यदुन्दुभिनिर्घोषैर्गीतवादित्रनिःस्वनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000073038, "chapter_id": 9073, "verse_number": "१-७३-३८", "content_sanskrit": "ननृतुश्चाप्सरःसङ्घा गन्धर्वाश्च जगुः कलम्।\nविवाहे रघुमुख्यानां तदद्भुतमदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000073039, "chapter_id": 9073, "verse_number": "१-७३-३९", "content_sanskrit": "ईदृशे वर्तमाने तु तूर्योद‍्घुष्टनिनादिते।\nत्रिरग्निं ते परिक्रम्य ऊहुर्भार्या महौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000073040, "chapter_id": 9073, "verse_number": "१-७३-४०", "content_sanskrit": "अथोपकार्यं जग्मुस्ते सभार्या रघुनन्दनाः।\nराजाप्यनुययौ पश्यन् सर्षिसङ्घः सबान्धवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000073041, "chapter_id": 9073, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे त्रिसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]