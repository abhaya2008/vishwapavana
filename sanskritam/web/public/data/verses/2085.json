[{"id": 2049421, "chapter_id": 2085, "verse_number": "७-१२-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2049422, "chapter_id": 2085, "verse_number": "७-१२-१", "content_sanskrit": "`शुश्रूषस्व स्थिरो भूत्वां शंसतो मम भारत।\nहन्त ते कथयिष्यामि सर्वं प्रत्यक्षदर्शिवान्।\nयथा सत्यपरो द्रोणः सादिताः पाण्डुसृञ्जयैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2049423, "chapter_id": 2085, "verse_number": "७-१२-२", "content_sanskrit": "सेनापतित्वं सम्प्राप्य भारद्वाजो महारथः।\nमध्ये सर्वस्य सैन्यस्य पुत्रं ते वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2049424, "chapter_id": 2085, "verse_number": "७-१२-३", "content_sanskrit": "यत्कौरवाणामृषभादापगेयादनन्तरम्।\nसैनापत्ये त्वया राजन्नद्य सत्कृतवानहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2049425, "chapter_id": 2085, "verse_number": "७-१२-४", "content_sanskrit": "सदृशं कर्मणस्तस्य फलं प्राप्नुहि भारत।\nकरोमि कामं कं तेऽद्य प्रवृणीष्व यमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2049426, "chapter_id": 2085, "verse_number": "७-१२-५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2049427, "chapter_id": 2085, "verse_number": "७-१२-५", "content_sanskrit": "ततो दुर्योधनो राजा कर्णदुःशासनादिभिः।\nसम्मन्त्र्योवाच दुर्धर्षमाचार्यं जयतां वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2049428, "chapter_id": 2085, "verse_number": "७-१२-६", "content_sanskrit": "ददासि चेद्वरं मह्यं जीवग्राहं युधिष्ठिरम्।\nगृहीत्वा रयिनां श्रेष्ठं मत्समीपमिहानय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2049429, "chapter_id": 2085, "verse_number": "७-१२-७", "content_sanskrit": "`इच्छेयं वै महात्मानं धर्मात्मानं युधिष्ठिरम्।\nभ्रातृणां पश्यतामेव जीवग्राहेण मे द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2049430, "chapter_id": 2085, "verse_number": "७-१२-८", "content_sanskrit": "गृहीत्वा रथिनां श्रेष्ठं मत्सकाशमिहानय।\nप्रीणाम्यनेन कार्येण ससुहृज्जनबान्धवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2049431, "chapter_id": 2085, "verse_number": "७-१२-९x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2049432, "chapter_id": 2085, "verse_number": "७-१२-९", "content_sanskrit": "ततः कुरूणामाचार्यः श्रुत्वा पुत्रस्य ते वचः।\nसेनां प्रहर्षयन्सर्वामिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2049433, "chapter_id": 2085, "verse_number": "७-१२-१०", "content_sanskrit": "धन्यः कुन्तीसुतो राजन्यस्य ग्रहणमिच्छसि।\nन वधं तस्य दुर्धर्ष वरमद्य प्रयाचसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2049434, "chapter_id": 2085, "verse_number": "७-१२-११", "content_sanskrit": "किमर्थं च नरव्याघ्र न वधं तस्य काङ्क्षसे।\nनाशंससि क्रियामेतां मत्तो दुर्योधन ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2049435, "chapter_id": 2085, "verse_number": "७-१२-१२", "content_sanskrit": "आहोस्विद्धर्मराजस्य द्वेष्टा कश्चिन्न विद्यते।\nयदीच्छसि त्वं जीवन्तं कुलं रक्षसि चात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2049436, "chapter_id": 2085, "verse_number": "७-१२-१३", "content_sanskrit": "अथवा भरतश्रेष्ठ निर्जित्य युधि पाण्डवान्।\nराज्यांशं प्रति दत्त्वा च सौभ्रात्रं कर्तुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2049437, "chapter_id": 2085, "verse_number": "७-१२-१४", "content_sanskrit": "धन्यः कुन्तीसुतो राजा सुजातं चास्य धीमतः।\nअजातशत्रुता सत्या तस्य यत्स्निह्यते भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2049438, "chapter_id": 2085, "verse_number": "७-१२-१५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2049439, "chapter_id": 2085, "verse_number": "७-१२-१५", "content_sanskrit": "द्रोणेन चैवमुक्तस्य तव पुत्रस्य भारत।\nसहसा निःसृतो भावो योस्य नित्यं हृदि स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2049440, "chapter_id": 2085, "verse_number": "७-१२-१६", "content_sanskrit": "नाकारो गूहितुं शक्यो बृहस्पतिसमैरपि।\nतस्मात्तव सुतो राजन्प्रहृष्टो वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2049441, "chapter_id": 2085, "verse_number": "७-१२-१७", "content_sanskrit": "वधे कुन्तीसुतस्याजौ नाचार्य विजयो मम।\nहते युधिष्ठिरे पार्था हन्युःसर्वान्हि नो ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2049442, "chapter_id": 2085, "verse_number": "७-१२-१८", "content_sanskrit": "नैव शक्या रणे सर्वे निहन्तुममरैरपि।\n`यदि सर्वे हनिष्यन्ते पाण्डवाः ससुता मृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2049443, "chapter_id": 2085, "verse_number": "७-१२-१९", "content_sanskrit": "ततः कृत्स्नं वशे कृत्वा निःशेषं नृपमण्डलम्।\nससागरवनां स्फीतां विजित्य वसुधामिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2049444, "chapter_id": 2085, "verse_number": "७-१२-२०", "content_sanskrit": "विष्णुर्दास्यति कृष्णायै कुन्त्यै वा पुरुषोत्तमः।\nयद्येष चैषां शेषःस्यात्स एवास्मान्न शेषयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2049445, "chapter_id": 2085, "verse_number": "७-१२-२१", "content_sanskrit": "सत्यप्रतिज्ञे त्वानीते पुनर्द्यूतेन निर्जिते।\n`तस्मिञ्जीवति चायाते ह्युपायैर्बहुभिः कृतैः।\nपुनर्यास्यन्त्यरण्याय पाण्डवास्तमनुव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2049446, "chapter_id": 2085, "verse_number": "७-१२-२२", "content_sanskrit": "सोऽयं मम जयो व्यक्तं दीर्घकालं भविष्यति।\nअतो न वधमिच्छामि धर्मराजस्य कर्हिचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2049447, "chapter_id": 2085, "verse_number": "७-१२-२३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2049448, "chapter_id": 2085, "verse_number": "७-१२-२३", "content_sanskrit": "तस्य जिह्ममभिप्रायं ज्ञात्वा द्रोणोऽर्थतत्त्ववित्।\nतं वरं सान्तरं तस्मै ददौ संचिन्त्य बुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2049449, "chapter_id": 2085, "verse_number": "७-१२-२४x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2049450, "chapter_id": 2085, "verse_number": "७-१२-२४", "content_sanskrit": "न चेद्युधिष्ठिरं वीरः पालयेदर्जुनो युधि।\nमन्यस्व पाण्डवश्रेष्ठमानीतं वशमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2049451, "chapter_id": 2085, "verse_number": "७-१२-२५", "content_sanskrit": "न हि शक्यो रणे पार्थः सेन्द्रैर्देवासुरैरपि।\nप्रत्युद्यातुमतस्तात न तस्माद्धर्षयाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2049452, "chapter_id": 2085, "verse_number": "७-१२-२६", "content_sanskrit": "असंशयं स मे शिष्यो मत्पूर्वश्चास्त्रकर्मणि।\nतरुणः सुकृती युक्त एकायनगतश्च सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2049453, "chapter_id": 2085, "verse_number": "७-१२-२७", "content_sanskrit": "अस्त्राणीन्द्राच्च रुद्राच्च भूयांसि समवाप्तवान्।\nअमर्षितश्च ते राजंस्ततो नामर्षयाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2049454, "chapter_id": 2085, "verse_number": "७-१२-२८", "content_sanskrit": "स चापक्रम्यतां युद्धाद्येनोपायेन शक्यते।\nअपनीते ततः पार्थे धर्मराजो जितस्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2049455, "chapter_id": 2085, "verse_number": "७-१२-२९", "content_sanskrit": "ग्रहणे हि जयस्तस्य न वधे पुरुषर्षभ।\n`ग्रहणं हि वधात्तस्य धर्मराजस्य मन्यसे।\nअनेनैवाभ्युपायेन ग्रहणं समुपैष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2049456, "chapter_id": 2085, "verse_number": "७-१२-३०", "content_sanskrit": "अहं गृहीत्वा राजानं सत्यधर्मपरायणम्।\nआनयिष्यामि ते राजन्वशमद्य न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2049457, "chapter_id": 2085, "verse_number": "७-१२-३१", "content_sanskrit": "यदि स्यास्यति सङ्ग्रामे मुहूर्तमपि मेऽग्रतः।\nअपनीते नरव्याघ्रे कुन्तीपुत्रे धनञ्जये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2049458, "chapter_id": 2085, "verse_number": "७-१२-३२", "content_sanskrit": "फल्गुनस्य समीपे तु न हि शक्यो युधिष्ठिरः।\nग्रहीतुं समरे राजन्सेन्द्रैरपि सुरासुरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2049459, "chapter_id": 2085, "verse_number": "७-१२-३३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2049460, "chapter_id": 2085, "verse_number": "७-१२-३३", "content_sanskrit": "`एवमुक्ते तदा तस्मिन्युद्धे देवासुरोपमे।\nसान्तरं तु प्रतिज्ञाते राज्ञो द्रोणेन निग्रहे।\nगृहीतं तममन्यन्त तव पुत्राः सुबालिशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2049461, "chapter_id": 2085, "verse_number": "७-१२-३४", "content_sanskrit": "ततो दुर्योधनेनापि ग्रहणं पाण्डवस्य तत्।\n`स्कन्धावारेषु सर्वेषु यथास्थानेषु मारिष।\nसैन्यस्थानेषु सर्वेषु सुघोषितमरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2049462, "chapter_id": 2085, "verse_number": "७-१२-३५", "content_sanskrit": "पाण्डवेयेषु सापेक्षं द्रोणं जानाति ते सुतः।\nततः प्रतिज्ञास्थैर्यार्थं स मन्त्रो बहुलीकृतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2049463, "chapter_id": 2085, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि द्रोणाभिषेकपर्वणि द्वादशोऽध्यायः॥ १२ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१२-११ एतां वधरूपां क्रियां मत्तो नाशंससि न सम्भावयसि॥ ५-१२-१२ तदिच्छसि त्वं इति क.ख.पाठः॥ ५-१२-१४ सुजातं शोभनं जन्म ५-१२-२२ व्यक्तं नियतम्॥ ५-१२-२६ मत्पूर्वः अहं पूर्वो गुरुर्यस्य एकायनगतः जयमरणान्यतरनिश्चयवान्॥ ५-१२-३५ बहुलीकृतः प्रतिज्ञां न त्यजेदिति बहुषु प्रकाशितः॥ ५-१२-१२ द्वादशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]