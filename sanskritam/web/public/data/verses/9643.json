[{"id": 5000643000, "chapter_id": 9643, "verse_number": "७-१०८-१", "content_sanskrit": "ते दूता रामवाक्येन चोदिता लघुविक्रमाः ।\nप्रजग्मुर्मधुरां शीघ्रं चक्रुर्वासं न चाध्वनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000643001, "chapter_id": 9643, "verse_number": "७-१०८-२", "content_sanskrit": "ते तु त्रिभिरहोरात्रैः सम्प्राप्य मधुरामथ ।\nशत्रुघ्नाय यथातत्त्वमाचख्युः सर्वमेव तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000643002, "chapter_id": 9643, "verse_number": "७-१०८-३", "content_sanskrit": "लक्ष्मणस्य परित्यागं प्रतिज्ञां राघवस्य च ।\nपुत्रयोरभिषेकं च पौरानुगमनं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000643003, "chapter_id": 9643, "verse_number": "७-१०८-४", "content_sanskrit": "कुशस्य नगरी रम्या विन्ध्यपर्वतरोधसि ।\nकुशावतीति नाम्ना सा कृता रामेण धीमता ।\nश्रावस्तीति पुरी रम्या श्राविता च लवस्य ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000643004, "chapter_id": 9643, "verse_number": "७-१०८-५", "content_sanskrit": "अयोध्यां विजनां कृत्वा राघवो भरतस्तथा ।\nस्वर्गस्य गमनोद्योगं कृतवन्तौ महारथौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000643005, "chapter_id": 9643, "verse_number": "७-१०८-६", "content_sanskrit": "एवं सर्वं निवेद्याशु शत्रुघ्नाय महात्मने ।\nविरेमुस्ते ततो दूतास्त्वर राजेति चाब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000643006, "chapter_id": 9643, "verse_number": "७-१०८-७", "content_sanskrit": "तच्छ्रुत्वा घोरसङ्काशं कुलक्षयमुपस्थितम् ।\nप्रकृतीस्तु समानीय काञ्चनं च पुरोधसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000643007, "chapter_id": 9643, "verse_number": "७-१०८-८", "content_sanskrit": "तेषां सर्वं यथावृत्तमब्रवीद्रघनन्दनः ।\nआत्मनश्च विपर्यासं भविष्यं भ्रातृभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000643008, "chapter_id": 9643, "verse_number": "७-१०८-९", "content_sanskrit": "ततः पुत्रद्वयं वीरः सो ऽभ्यषिञ्चन्नराधिपः ।\nसुबाहुर्मधुरां लेभे शत्रुघाती च वैदिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000643009, "chapter_id": 9643, "verse_number": "७-१०८-१०", "content_sanskrit": "द्विधा कृत्वा तु तां सेनां माधुरीं पुत्रयोर्द्वयोः ।\nधनं च युक्तं कृत्वा वै स्थापयामास पार्थिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000643010, "chapter_id": 9643, "verse_number": "७-१०८-११", "content_sanskrit": "सुबाहुं मधुरायां च वैदेशे शत्रुघातिनम् ।\nययौ स्थाप्य तदा ऽयोध्यां रथेनैकेन राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000643011, "chapter_id": 9643, "verse_number": "७-१०८-१२", "content_sanskrit": "स ददर्श महात्मानं ज्वलन्तमिव पावकम् ।\nसूक्ष्मक्षौमाम्बरधरं मुनिभिः सार्धमक्षयैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000643012, "chapter_id": 9643, "verse_number": "७-१०८-१३", "content_sanskrit": "सो ऽभिवाद्य ततो रामं प्राञ्जलिः प्रयतेन्द्रियः ।\nउवाच वाक्यं धर्मज्ञं धर्ममेवानुचिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000643013, "chapter_id": 9643, "verse_number": "७-१०८-१४", "content_sanskrit": "कृत्वाभिषेकं सुतयोर्द्वयो राघवनन्दन ।\nतवानुगमने राजन्विद्धि मां कृतनिश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000643014, "chapter_id": 9643, "verse_number": "७-१०८-१५", "content_sanskrit": "न चान्यदपि वक्तव्यमतो वीर न शासनम् ।\nविलोक्यमानमिच्छामि मद्विधेन विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000643015, "chapter_id": 9643, "verse_number": "७-१०८-१६", "content_sanskrit": "तस्य तां बुद्धिमक्लीबां विज्ञाय रघुनन्दनः ।\nबाढमित्येव शत्रुघ्नं रामो वाक्यमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000643016, "chapter_id": 9643, "verse_number": "७-१०८-१७", "content_sanskrit": "तस्य वाक्यस्य वाक्यान्ते वानराः कामरूपिणः ।\nऋक्षराक्षससङ्घाश्च समापेतुरनेकशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000643017, "chapter_id": 9643, "verse_number": "७-१०८-१८", "content_sanskrit": "सुग्रीवं ते पुरस्कृत्य सर्व एव समागताः ।\nतं रामं द्रष्टुमनसः स्वर्गायाभिमुखं स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000643018, "chapter_id": 9643, "verse_number": "७-१०८-१९", "content_sanskrit": "देवपुत्रा ऋषिसुता गन्धर्वाणां सुतास्तथा ।\nरामक्षयं विदित्वा ते सर्व एव समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000643019, "chapter_id": 9643, "verse_number": "७-१०८-२०", "content_sanskrit": "ते राममभिवाद्योचुः सर्वे वानरराक्षसाः ।\nतवानुगमने राजन्सम्प्राप्ताः कृतनिश्चयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000643020, "chapter_id": 9643, "verse_number": "७-१०८-२१", "content_sanskrit": "यदि राम विनास्माभिर्गच्छेस्त्वं पुरुषोत्तम ।\nयमदण्डमिवोद्यम्य त्वया स्म विनिपातिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000643021, "chapter_id": 9643, "verse_number": "७-१०८-२२", "content_sanskrit": "तैरेवमुक्तः काकुत्स्थो बाढमित्यब्रवीत् स्मयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000643022, "chapter_id": 9643, "verse_number": "७-१०८-२३", "content_sanskrit": "एतस्मिन्नन्तरे रामं सुग्रीवो ऽपि महाबलः ।\nप्रणम्य विधिवद्वीरं विज्ञापयितुमुद्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000643023, "chapter_id": 9643, "verse_number": "७-१०८-२४", "content_sanskrit": "अभिषिच्याङ्गदं वीरमागतो ऽस्मि नरेश्वर ।\nतवानुगमने राजन्विद्धि मां कृतनिश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000643024, "chapter_id": 9643, "verse_number": "७-१०८-२५", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा रामो रमयतां वरः ।\nवानरेन्द्रमथोवाचं मैत्रं तस्यानुचिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000643025, "chapter_id": 9643, "verse_number": "७-१०८-२६", "content_sanskrit": "सखे शृणुष्व सुग्रीव न त्वया ऽहं विनाकृतः ।\nगच्छेयं देवलोकं वा परमं वा पदं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000643026, "chapter_id": 9643, "verse_number": "७-१०८-२७", "content_sanskrit": "बिभीषणमथोवाच राक्षसेन्द्रं महायशाः ।\nयावत्प्रजा धरिष्यन्ति तावत्त्वं वै बिभीषण ।\nराक्षसेन्द्र महावीर्य लङ्कास्थस्त्वं धरिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000643027, "chapter_id": 9643, "verse_number": "७-१०८-२८", "content_sanskrit": "यावच्चन्द्रश्च सूर्यश्च यावत्तिष्ठति मेदिनी ।\nयावच्च मत्कथा लोके तावद्राज्यं तवास्त्विह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000643028, "chapter_id": 9643, "verse_number": "७-१०८-२९", "content_sanskrit": "शासितस्त्वं सखित्वेन कार्यं ते मम शासनम् ।\nप्रजाः संरक्ष धर्मेण नोत्तरं वक्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000643029, "chapter_id": 9643, "verse_number": "७-१०८-३०", "content_sanskrit": "किञ्चान्यद्वक्तुमिच्छामि राक्षसेन्द्र महामते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000643030, "chapter_id": 9643, "verse_number": "७-१०८-३१", "content_sanskrit": "आराधय जगन्नाथमिक्ष्वाकुकुलदैवतम् ।\nआराधनीयमनिशं सर्वैर्दैवैः सवासवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000643031, "chapter_id": 9643, "verse_number": "७-१०८-३२", "content_sanskrit": "तथेति प्रतिजग्राह रामवाक्यं विभीषणः ।\nराजा राक्षसमुख्यानां राघवाज्ञामनुस्मरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000643032, "chapter_id": 9643, "verse_number": "७-१०८-३३", "content_sanskrit": "तमेवमुक्त्वा काकुत्स्थो हनूमन्तमथाब्रवीत् ।\nजीविते कृतबुद्धिस्त्वं मा प्रतिज्ञां विलोपय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000643033, "chapter_id": 9643, "verse_number": "७-१०८-३४", "content_sanskrit": "मत्कथाः प्रचरिष्यन्ति यावल्लोके हरीश्वर ।\nतावद्रमस्व सुप्रीतो मद्वाक्यमनुपालयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000643034, "chapter_id": 9643, "verse_number": "७-१०८-३५", "content_sanskrit": "एवमुक्तस्तु हनुमान्राघवेण महात्मना ।\nवाक्यं विज्ञापयामास परं हर्षमवाप्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000643035, "chapter_id": 9643, "verse_number": "७-१०८-३६", "content_sanskrit": "यावत्तव कथा लोके विचरिष्यति पावनी ।\nतावत्स्थास्यामि मेदिन्यां तवाज्ञामनुपालयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000643036, "chapter_id": 9643, "verse_number": "७-१०८-३७", "content_sanskrit": "जाम्बवन्तं तथोक्त्वा तु वृद्धं ब्रह्मसुतं तथा ।\nमैन्दं च द्विविदं चैव पञ्च जाम्बवता सह ।\nयावत्कलिश्च सम्प्राप्तस्तावज्जीवत सर्वदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000643037, "chapter_id": 9643, "verse_number": "७-१०८-३८", "content_sanskrit": "तानेवमुक्त्वा काकुत्स्थः सर्वांस्तानृक्षवानरान् ।\nउवाच बाढं गच्छध्वं मया सार्धं यथेप्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000643038, "chapter_id": 9643, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे ऽष्टोतरशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]