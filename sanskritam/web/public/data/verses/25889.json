[{"id": 7005889000, "chapter_id": 25889, "verse_number": "१-७२-१", "content_sanskrit": "सूत उवाच ।\nतत्रैव सिंहलवधूकरपल्लवाग्रव्यालूनबाललवलीकुसुमप्रवाले ।\nदेशे पपात दितिजस्य नितान्तकान्तं प्रोत्फुल्लनीरजसमद्युति नेत्रयुग्मम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005889001, "chapter_id": 25889, "verse_number": "१-७२-२", "content_sanskrit": "तत्प्रत्ययादुभयशोभनवीचिभासा विस्तारिणी जलनिधेरुपकच्छभूमिः ।\nप्रोद्भिन्नकेतकवनप्रतिबद्धलेखासान्द्रेन्द्रनीलमणिरत्नवती विभाति ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005889002, "chapter_id": 25889, "verse_number": "१-७२-३", "content_sanskrit": "तत्रासिताब्जहलभृद्वसनासिभृंगशार्ङ्गायुधांगहरकण्ठकषायपुष्पैः ।\nशुष्केतरैश्च कुसुमैर्गिरिकर्णिकायास्तस्माद्भवन्ति मणयः सदृशावभासः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005889003, "chapter_id": 25889, "verse_number": "१-७२-४", "content_sanskrit": "अन्ये प्रसन्नपयसः पयसां निधातुरम्बुत्विषः शिखिगणप्रतिमास्तथन्ये।\nनीलीरसप्रभवबुद्वुदभाश्च केचित्केचित्तथा समदकोकिलकण्ठभासः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005889004, "chapter_id": 25889, "verse_number": "१-७२-५", "content_sanskrit": "एकप्रकारा विस्पष्टवर्णशोभावभासिनः ।\nजायन्ते मणयस्तस्मिन्निन्द्रनीला महागुणाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005889005, "chapter_id": 25889, "verse_number": "१-७२-६", "content_sanskrit": "मृत्पाषाणशिलारन्ध्रकर्करात्राससंयुताः ।\nअभ्रिकापटलच्छायावर्णदोषैश्च दूषिताः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005889006, "chapter_id": 25889, "verse_number": "१-७२-७", "content_sanskrit": "तत एव हि जायन्ते मणयस्तत्र सूरयः ।\nशास्त्रसम्बोधितधियस्तान्प्रशंसन्ति सूरयः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005889007, "chapter_id": 25889, "verse_number": "१-७२-८", "content_sanskrit": "धार्य्यमाणस्य ये दृष्टा पद्मरागमणेर्गणाः।\nधारणादिन्द्रनीलस्य तानेवाप्नोति मानवः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005889008, "chapter_id": 25889, "verse_number": "१-७२-९", "content_sanskrit": "यथा च पद्मरागाणां जातकत्रितयं भवेत् ।\nइन्द्र नीलेष्वपि तथा द्रष्टव्यमविशेषतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005889009, "chapter_id": 25889, "verse_number": "१-७२-१०", "content_sanskrit": "परीक्षाप्रत्ययैर्यैश्च पद्मरागः परीक्ष्यते ।\nत एव प्रत्यया दृष्टा इन्द्रनीलमणेरपि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005889010, "chapter_id": 25889, "verse_number": "१-७२-११", "content_sanskrit": "यावन्तं च क्रमेदग्निं पद्मरागोपयोगतः ।\nइन्द्रनीलमणिस्तस्मात्क्रमेत सुमहत्तरम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005889011, "chapter_id": 25889, "verse_number": "१-७२-१२", "content_sanskrit": "तथापि न परीक्षार्थं गुणानामभि (ति) वदधये।\nमणिरग्नौ समाधेयः कथञ्चिदपि कश्चन ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005889012, "chapter_id": 25889, "verse_number": "१-७२-१३", "content_sanskrit": "अग्निमात्रापरिज्ञाने दाहदोषैश्च दूषितः ।\nसोऽनर्थाय भवेद्भर्त्तुः कर्त्तुः कारयितुस्तथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005889013, "chapter_id": 25889, "verse_number": "१-७२-१४", "content_sanskrit": "काचोत्पलकरवीरस्फटिकाद्या इह बुधैः सवैदूर्यया।\nकथिता विजातय इमे सदृशा मणिनेन्द्रनीलेन ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005889014, "chapter_id": 25889, "verse_number": "१-७२-१५", "content_sanskrit": "गुरुभावकठिनभावावेतेषां नित्यमेव विज्ञेयौ ।\nकाचाद्यथावदुत्तरविवर्द्धमानौ विशेषेण ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005889015, "chapter_id": 25889, "verse_number": "१-७२-१६", "content_sanskrit": "इन्द्रनीलो यथा कश्चिद्विभर्त्त्याताम्ररणताम्।\nरक्षणयौ तथा ताम्रौ करवीरोत्पलावुभौ ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005889016, "chapter_id": 25889, "verse_number": "१-७२-१७", "content_sanskrit": "यस्य मध्यगता भाति नीलस्येन्द्रायुधप्रभा ।\nतमिन्द्रनीलमित्याहुर्महार्हं भुवि दुर्लभम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005889017, "chapter_id": 25889, "verse_number": "१-७२-१८", "content_sanskrit": "यस्य वर्णस्य भूयस्त्वात्क्षीरे शतगुणे सथतः।\nनीलतां तन्नयेत्सर्वं महानीलः स उच्यते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005889018, "chapter_id": 25889, "verse_number": "१-७२-१९", "content_sanskrit": "यत्पद्मरागस्य महागुणस्य मूल्यं भवेन्माषसमुन्मितस्य ।\nतदिन्द्रनीलस्य महागुणस्य सुवर्ण संख्याकुलितस्य मूल्यम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]