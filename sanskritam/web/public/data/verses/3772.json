[{"id": 2128982, "chapter_id": 3772, "verse_number": "", "content_sanskrit": "परशुरामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2128983, "chapter_id": 3772, "verse_number": "१", "content_sanskrit": "ममापराधात् तैः क्षुद्रैर्हतस्त्वं तात बालिशैः ।\nकार्तवीर्यस्य दायादैर्वने मृग इवेषुभिः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2128984, "chapter_id": 3772, "verse_number": "२", "content_sanskrit": "धर्मज्ञस्य कथं तात वर्तमानस्य सत्पथे ।\nमृत्युरेवंविधो युक्तः सर्वभूतेष्वनागसः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2128985, "chapter_id": 3772, "verse_number": "३", "content_sanskrit": "किं नु तैर्न कृतं पापं यैर्भवांस्तपसि स्थितः ।\nअयुध्यमानो वृद्धः सन् हतः शरशतैः शितैः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2128986, "chapter_id": 3772, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2128987, "chapter_id": 3772, "verse_number": "४", "content_sanskrit": "लालप्यैवं सकरुणं बहु नानाविधं नृप ।\nप्रेतकार्याणि सर्वाणि पितुश्चक्रे महातपाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2128988, "chapter_id": 3772, "verse_number": "५", "content_sanskrit": "ददाह पितरं चाग्नौ रामः परपुरञ्जयः ।\nप्रतिजज्ञे वधं चापि सर्वक्षत्रस्य भारत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2128989, "chapter_id": 3772, "verse_number": "६", "content_sanskrit": "सङ्क्रुद्धोऽतिबलः शूरः शस्त्रमादाय वीर्यवान् ।\nजघ्निवान् कार्तवीर्यस्य सुतानेको महाबलः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2128990, "chapter_id": 3772, "verse_number": "७", "content_sanskrit": "तेषां ये चानुगाः केचित् क्षत्रियाः क्षत्रियर्षभ ।\nतांश्च सर्वानवामृद्नाद् रामः शस्त्रभृतां वरः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2128991, "chapter_id": 3772, "verse_number": "८", "content_sanskrit": "त्रिःसप्तकृत्वः पृथिवीं कृत्वा निःक्षत्रियां प्रभुः ।\nसमन्तपञ्चके पञ्च चकार रुधिरह्रदान्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2128992, "chapter_id": 3772, "verse_number": "९", "content_sanskrit": "स तेषु तर्पयामास पितॄन् भृगुकुलोद्वहः ।\nसाक्षाद् ददर्श चर्चीकं स च रामं न्यवारयत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2128993, "chapter_id": 3772, "verse_number": "१०", "content_sanskrit": "ततो यज्ञेन महता जामदग्न्यः प्रतापवान् ।\nतर्पयामास देवेन्द्रम् ऋत्विग्भ्यश्च महीं ददौ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2128994, "chapter_id": 3772, "verse_number": "११", "content_sanskrit": "वेदीं च प्रददाद् हैमीं काश्यपाय महात्मने ।\nदशव्यामायतां कृत्वा नवोत्सेधां विशांपते \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2128995, "chapter_id": 3772, "verse_number": "१२", "content_sanskrit": "तां काश्यपस्यानुमते ब्राह्मणाः खण्डशस्तदा ।\nव्यभजंस्तेन ते राजन् प्रख्याताः खण्डवाहनाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2128996, "chapter_id": 3772, "verse_number": "१३", "content_sanskrit": "स प्रदाय महीं तस्मै काश्यपाय महातपाः ।\nतपस्सु मन आस्थाय महाबलपराक्रमः ।\nअस्मिन् वसति शैलेन्द्रे महेन्द्रेऽमितविक्रमः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2128997, "chapter_id": 3772, "verse_number": "१४", "content_sanskrit": "एवं वैरमभूत् तस्य क्षत्रियैर्लोकवासिभिः ।\nपृथिवी चापि विजिता रामेणामिततेजसा \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2128998, "chapter_id": 3772, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2128999, "chapter_id": 3772, "verse_number": "१५", "content_sanskrit": "ततश्चतुर्दशीं रामः समयेन महातपाः ।\nदर्शयामास तान् विप्रान् धर्मराजं च सानुजम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2129000, "chapter_id": 3772, "verse_number": "१६", "content_sanskrit": "स तमानर्च राजेन्द्र भ्रातृभिः सहितः प्रभुः ।\nस तस्मै परमां पूजां चक्रे नृपतिसत्तमः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2129001, "chapter_id": 3772, "verse_number": "१७", "content_sanskrit": "अर्चयित्वा जामदग्न्यं पूजितस्तेन चाभिभूः ।\nमहेन्द्र उष्य तां रात्रिं प्रययौ दक्षिणामुखः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2129002, "chapter_id": 3772, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि चतुर्दशोत्तरशततमोऽध्यायः ॥११४॥\n॥ तीर्थयात्रापर्वणि सप्ततितमोऽध्यायः ॥७०॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]