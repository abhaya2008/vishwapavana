[{"id": 2031177, "chapter_id": 1679, "verse_number": "४-२-०x", "content_sanskrit": "वैशम्पायन उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2031178, "chapter_id": 1679, "verse_number": "४-२-१", "content_sanskrit": "निवृत्तवनवासास्ते सत्यसन्धा मनस्विनः।\nअकुर्वत पुनर्मन्त्रं सह धौम्येन पाण्डवाः ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2031179, "chapter_id": 1679, "verse_number": "४-२-२", "content_sanskrit": "अथाब्रवीद्धर्मराजः कुन्तीपुत्रो युधिष्ठिरः।\nभ्रातॄन्कृष्णां च संग्रेक्ष्य धौम्यं च कुरुनन्दनः ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2031180, "chapter_id": 1679, "verse_number": "४-२-३", "content_sanskrit": "द्वादशेमानि वर्षाणि राज्याद्विप्रोषिता वयम्।\nत्रयोदशोऽयं संप्राप्तः कृच्छ्रात्परमदुर्वसः।\nस साधु कौन्तेय इतो वासमर्जुन रोचय ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2031181, "chapter_id": 1679, "verse_number": "४-२-४", "content_sanskrit": "त्रयोदशमिदं प्राप्तं क्वनु वत्स्यामहेऽर्जुन।\nअबुद्धा धार्तराष्ट्रैश्च समग्राः सह कृष्णया ॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2031182, "chapter_id": 1679, "verse_number": "४-२-५x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2031183, "chapter_id": 1679, "verse_number": "४-२-५", "content_sanskrit": "तस्यैव वरदानेन धर्मस्य मनुजाधिप।\nअज्ञाता विचरिष्यामो नराणां भरतर्षभ ॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2031184, "chapter_id": 1679, "verse_number": "४-२-६", "content_sanskrit": "यानि राष्ट्राणि वासाय कीर्तयिष्यामि कानिचित् ।\nरमणीयानि गुप्तानि तेषां किंचित्तु रोचय ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2031185, "chapter_id": 1679, "verse_number": "४-२-७", "content_sanskrit": "रम्या जनपदाः सन्ति बहवस्त्वभितः कुरून् ।\nपाञ्चालाश्चैव मत्स्याश्च साल्ववैदेहबाह्लिकाः ।\nदशार्णाः शूरसेनाश्च कलिङ्गा मागधा अपि ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2031186, "chapter_id": 1679, "verse_number": "४-२-८", "content_sanskrit": "विराटनगरं चापि श्रूयते शत्रुसूदन ।\nरमणीयं जनाकीर्णं सुभिक्षं स्फीतमेव च ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2031187, "chapter_id": 1679, "verse_number": "४-२-९", "content_sanskrit": "नानाराष्ट्राणि चान्यानि श्रूयन्ते सुबहूनि च ।\nयत्र ते रोचते राजंस्तत्र गच्छामहे वयम् ॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2031188, "chapter_id": 1679, "verse_number": "४-२-१०", "content_sanskrit": "कतमस्मिञ्जनपदे महाराज निवत्स्यसि ।\nमा विषादे मनः कार्यं राज्यभ्रंश इति क्वचित् ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2031189, "chapter_id": 1679, "verse_number": "४-२-११x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2031190, "chapter_id": 1679, "verse_number": "४-२-११", "content_sanskrit": "एवमेतन्महाबाहो यथा स भगवान्प्रभुः।\nअब्रवीत्सर्वभूतेशस्तथैतन्न तदन्यथा ॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2031191, "chapter_id": 1679, "verse_number": "४-२-१२", "content_sanskrit": "अवश्यं त्वेव वासार्थं रमणीयं शिवं सुखम्।\nसंमन्त्र्य सहितैः सर्वैर्द्रव्यमकुतोऽभयम् ॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2031192, "chapter_id": 1679, "verse_number": "४-२-१३", "content_sanskrit": "मात्स्यो विराटो बलवानभिरक्तोथ पाण्डवान्।\nधर्मशीलो वदान्यश्च वृद्धः सत्स्वपि संमतः ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2031193, "chapter_id": 1679, "verse_number": "४-२-१४", "content_sanskrit": "गुणवाँल्लोकविख्यातो दृढभक्तिर्जितेन्द्रियः ।\nतत्र मे रोचते पार्थ मत्स्यराजान्तिकेऽनघ ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2031194, "chapter_id": 1679, "verse_number": "४-२-१५", "content_sanskrit": "विराटनगरे तात मासान्द्वादशसंमितान्।\nकुर्वन्तस्तस्य कर्माणि वसामो यदि रोचते ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2031195, "chapter_id": 1679, "verse_number": "४-२-१६", "content_sanskrit": "यानियानि च कर्माणि तस्य शक्ष्यामहे वयम्।\nकर्तुं यो यत्स तत्कर्म ब्रवीतु कुरुनन्दन ॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2031196, "chapter_id": 1679, "verse_number": "४-२-१६x", "content_sanskrit": "अर्जुन उवाच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2031197, "chapter_id": 1679, "verse_number": "४-२-१७", "content_sanskrit": "नरदेव कथं कर्म तस्य राष्ट्रे करिष्यसि ।\nमनुजेन्द्र विराटस्य रंस्यसे केन कर्मणा ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2031198, "chapter_id": 1679, "verse_number": "४-२-१८", "content_sanskrit": "अक्लिष्टवेषधारी च धार्मिको ह्यनसूयकः ।\nन तवाभ्युचितं कर्म नृशंसं नापि कैतवम् ॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2031199, "chapter_id": 1679, "verse_number": "४-२-१९", "content_sanskrit": "सत्यवागसि याज्ञीको लोभक्रोधविवर्जितः ।\nमृदुर्वदान्यो ह्रीमांश्च धार्मिकः सत्यविक्रमः ॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2031200, "chapter_id": 1679, "verse_number": "४-२-२०", "content_sanskrit": "स राजंस्तपसा क्लिष्टः कथं तस्य करिष्यसि।\nन दुःखमुचितं किंचिद्राजन्पापमतेर्यथा।\nस इमामापदं प्राप्य कथं घोरां तरिष्यसि ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2031201, "chapter_id": 1679, "verse_number": "४-२-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2031202, "chapter_id": 1679, "verse_number": "४-२-२१", "content_sanskrit": "अर्जुनेनैवमुक्तस्तु प्रत्युवाच युधिष्ठिरः ।\nशृणु त्वं यत्करिष्यामि कर्म वै कुरुनन्दन ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2031203, "chapter_id": 1679, "verse_number": "४-२-२२", "content_sanskrit": "विराटं समनुप्राप्य राजानं मात्स्यनन्दनम् ।\nसभास्तारो भविष्यामि विराटस्येति मे मतिः ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2031204, "chapter_id": 1679, "verse_number": "४-२-२३", "content_sanskrit": "कङ्को नाम ब्रुवाणोऽहं मताक्षः साधुदेविता।\nवैडूर्यान्काञ्चनान्दानान्स्फाटिकान्राजतानपि ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2031205, "chapter_id": 1679, "verse_number": "४-२-२४", "content_sanskrit": "कृष्णाक्षाँल्लोहिताक्षांश्च निवप्स्यामि मनोरमान्।\nअरिष्टान्राजगोलिङ्गान्दर्शनीयान्सुवर्चसः ॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2031206, "chapter_id": 1679, "verse_number": "४-२-२५", "content_sanskrit": "लोहिताश्चाश्मगर्भाश्च सन्ति तात धनानि मे।\nदर्शनीयाः सभानन्दाः कुशलैः साधुनिष्ठिताः ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2031207, "chapter_id": 1679, "verse_number": "४-२-२६", "content_sanskrit": "अप्येतान्पाणिना स्पृष्ट्वा संप्रहृष्यन्ति मानवाः ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2031208, "chapter_id": 1679, "verse_number": "४-२-२७", "content_sanskrit": "तान्विकीर्य समे देशे रमणीये विपांसुले।\nदेविष्यामि यथाकामं स विहारो भविष्यति ॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2031209, "chapter_id": 1679, "verse_number": "४-२-२८", "content_sanskrit": "कङ्को नाम्ना परिव्राट् च विराटस्य सभासदः।\nज्योतिषे शकुनज्ञाने निमित्ते चाक्षकौशले ।\nब्राह्मे वेदे मयाऽधीते वेदाङ्गेषु च सर्वशः ॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2031210, "chapter_id": 1679, "verse_number": "४-२-२९", "content_sanskrit": "धर्मकामार्थमोक्षेषु नीतिशास्त्रेषु पारगः।\nपृष्टोऽहं कथयिष्यामि राज्ञः प्रियतमं वचः ॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2031211, "chapter_id": 1679, "verse_number": "४-२-३०", "content_sanskrit": "आसं युधिष्ठिरस्याहं पुरा प्राणसमः सखा।\nइति वक्ष्यामि राजानं यदि मामनुयोक्ष्यते ॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2031212, "chapter_id": 1679, "verse_number": "४-२-३१", "content_sanskrit": "विराटनगरे छन्न एवं युक्तः सदा वसे।\nइत्येवं मे प्रतिज्ञातं विचरिष्याम्यहं यथा ॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2031213, "chapter_id": 1679, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि पाण्डवप्रवेशपर्वणि द्वितीयोऽध्यायः ॥ २ ॥\n------------", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]