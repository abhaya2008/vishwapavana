[{"id": 2016156, "chapter_id": 1338, "verse_number": "२-७९-१", "content_sanskrit": "दुर्योधन उवाच॥\nआर्यास्तु ये वै राजानः सत्यसन्धा महाव्रताः।\nपर्याप्तविद्या वक्तारो वेदान्तावभृथप्लुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2016157, "chapter_id": 1338, "verse_number": "२-७९-२", "content_sanskrit": "धृतिमन्तो ह्रीनिषेवा धर्मात्मानो नाशस्विनः।\nमूर्धाभिषिक्तास्ते चैनं राजानः पर्युपांसते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2016158, "chapter_id": 1338, "verse_number": "२-७९-३", "content_sanskrit": "दक्षिणार्थं समानीत राजभिः कांस्यदोहनाः।\nआरण्या बहुसाहस्रा अपश्यंस्तत्रतत्र गाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2016159, "chapter_id": 1338, "verse_number": "२-७९-४", "content_sanskrit": "आजह्रस्तत्र सत्कृत्य स्वयमुद्यम्य भारत।\nअभिषेकार्थमव्यग्रा भाण्डमुच्चावचं नृपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2016160, "chapter_id": 1338, "verse_number": "२-७९-५", "content_sanskrit": "बाह्लीको रथमाहार्षीज्जाम्बूनदविभूषितम्।\nसुदक्षिणस्तु युयुजे श्वेतैः काम्भोजजैर्हयैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2016161, "chapter_id": 1338, "verse_number": "२-७९-६", "content_sanskrit": "सुनीथः प्रीतिमांश्चैव ह्यनुकर्षं महाबलः।\nध्वजं चेदिपतिश्चैवमहार्षीत्स्वयमुद्यतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2016162, "chapter_id": 1338, "verse_number": "२-७९-७", "content_sanskrit": "दाक्षिणात्यः सन्नहनं स्रगुष्णीषे च मागधः।\nवसुदानो महेष्वासो गजेन्द्रं षष्टिहायनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2016163, "chapter_id": 1338, "verse_number": "२-७९-८", "content_sanskrit": "मत्स्यस्त्वक्षान्हेमनद्धानेकलव्य उपानहौ।\nआवन्त्यस्त्वभिषेकार्थमपो बहुविधास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2016164, "chapter_id": 1338, "verse_number": "२-७९-९", "content_sanskrit": "चेकितान उपासङ्गं धनुः काश्य उपाहरत्।\nअसिं च सुत्सरुं शल्यः शैक्यं काञ्चनभूषणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2016165, "chapter_id": 1338, "verse_number": "२-७९-१०", "content_sanskrit": "अभ्यपिञ्चत्ततो धौम्यो व्यासश्च समुहातपाः।\nनारदं च पुरस्कृत्य देवलं चासितं मुनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2016166, "chapter_id": 1338, "verse_number": "२-७९-११", "content_sanskrit": "प्रीतिमन्त उपातिष्ठन्नभिषेकं महर्षयः।\nजामदग्न्येन सहितास्तथान्ये वेदपारगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2016167, "chapter_id": 1338, "verse_number": "२-७९-१२", "content_sanskrit": "अभिजग्मर्महात्मानो मन्त्रवद्भूरिदक्षिणम्।\nमहेन्द्रमिव देवेन्द्रं दिवि सप्तर्षयो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2016168, "chapter_id": 1338, "verse_number": "२-७९-१३", "content_sanskrit": "अधारयच्छत्रमस्य सात्यकिः सत्यविक्रमः।\nधनञ्जयश्च व्यजने भीमसेनश्च पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2016169, "chapter_id": 1338, "verse_number": "२-७९-१४", "content_sanskrit": "चामरे चापि शुद्धे द्वे यमौ जगृहतुस्तथा।\nउपागृह्णाद्यमिन्द्राय पुराकल्पे प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2016170, "chapter_id": 1338, "verse_number": "२-७९-१५", "content_sanskrit": "तमस्मै शङ्खमाहार्षीद्वारुणं कलशोदधिः।\nशैक्यं निष्कसहस्रेण सुकृतं विश्वकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2016171, "chapter_id": 1338, "verse_number": "२-७९-१६", "content_sanskrit": "तेनाभिषिक्तः कृष्णेन तत्र मे कश्मलोऽभवत्।\nगच्छन्ति पूर्वादपरं समुद्रं चापि दक्षिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2016172, "chapter_id": 1338, "verse_number": "२-७९-१७", "content_sanskrit": "उत्तरं तु गच्छन्ति विना तात पतत्र्रिभिः।\nतत्र स्म दध्मुः शतशः शङ्खान्मङ्गलकारकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2016173, "chapter_id": 1338, "verse_number": "२-७९-१८", "content_sanskrit": "प्राणदन्त समाध्मातास्ततो रोमाणि मेऽहृषन्।\nप्रापतन्भूमिपालाश्च ये तु हीनाः स्वतेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2016174, "chapter_id": 1338, "verse_number": "२-७९-१९", "content_sanskrit": "धृष्टद्युम्नः पाण्डवाश्च सात्यकिः केशवोऽष्टमः।\nसत्वस्था वीर्यसम्पन्ना ह्यन्योन्यप्रियदर्शनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2016175, "chapter_id": 1338, "verse_number": "२-७९-२०", "content_sanskrit": "विसञ्ज्ञान्भूमिपान्दृष्ट्वा मां च ते प्राहसंस्तदा।\nततः प्रहृष्टो बीभत्सुः प्रादाद्धेमविषाणिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2016176, "chapter_id": 1338, "verse_number": "२-७९-२१", "content_sanskrit": "शतान्यनडुहां पञ्च द्विजमुख्येषु भारत।\nन रन्तिदेवो नाभागो यौवनाश्वो मनुर्न च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2016177, "chapter_id": 1338, "verse_number": "२-७९-२२", "content_sanskrit": "न च राजा पृथुर्वैन्यो न चाप्यासीद्भगीरथः।\nययातिर्नहुषो वापि यथा राजा युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2016178, "chapter_id": 1338, "verse_number": "२-७९-२३", "content_sanskrit": "यथाऽतिमात्रं कौन्तेयः श्रिया परमया युतः।\nराजसूयमवाप्यैवं हरिश्चन्द्र इव प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2016179, "chapter_id": 1338, "verse_number": "२-७९-२४", "content_sanskrit": "एतां दृष्टा श्रियं पार्थे हरिश्चन्द्रे यथा विभो।\nकथं तु जीवितं श्रेयो मम पश्यसि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2016180, "chapter_id": 1338, "verse_number": "२-७९-२५", "content_sanskrit": "अन्धेनेव युगं नद्धं विपर्यस्तं नराधिप।\nकनीयांसो विवर्धन्ते ज्येष्ठा हीयन्त एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2016181, "chapter_id": 1338, "verse_number": "२-७९-२६", "content_sanskrit": "एवं दृष्ट्वा नाभिविन्दामि शर्म\nसमीक्षमाणोऽपि कुरुप्रवीर।\nतेनाहमेवं कृशतां गतश्च\nविवर्णतां चैव सशोकतां च॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2016182, "chapter_id": 1338, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि द्यूतपर्वणि ऊनाशीतितमोऽध्यायः॥७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]