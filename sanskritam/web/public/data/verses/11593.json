[{"id": 50017051, "chapter_id": 11593, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50017052, "chapter_id": 11593, "verse_number": "2", "content_sanskrit": "एकदा देवयात्रायां गोपाला जातकौतुकाः। अनोभिरनडुद्युक्तैः प्रययुस्तेऽम्बिकावनम्॥ १०/३२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50017053, "chapter_id": 11593, "verse_number": "3", "content_sanskrit": "तत्र स्नात्वा सरस्वत्यां देवं पशुपतिं प्रभुम्। आनर्चुरर्हणैर्भक्त्या देवीं च नृपतेऽम्बिकाम्॥ १०/३२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50017054, "chapter_id": 11593, "verse_number": "4", "content_sanskrit": "गावो हिरण्यं वासांसि मधु मध्वन्नमादृताः। ब्राह्मणेभ्यो ददुः सर्वे देवो नः प्रीयतामिति॥ १०/३२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50017055, "chapter_id": 11593, "verse_number": "5", "content_sanskrit": "ऊषुः सरस्वतीतीरे जलं प्राश्य यतव्रताः। रजनीं तां महाभाग नन्दसन्नन्दकादयः॥ १०/३२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50017056, "chapter_id": 11593, "verse_number": "6", "content_sanskrit": "कश्चिन्महानहिस्तस्मिन् विपिनेऽतिबुभुक्षितः। यदृच्छयाऽऽगतो नन्दं शयानमुरगोऽग्रसीत्॥ १०/३२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50017057, "chapter_id": 11593, "verse_number": "7", "content_sanskrit": "स चुक्रोशाहिना ग्रस्तः कृष्णकृष्ण महानयम्। सर्पो मां ग्रसते तात प्रपन्नं परिमोचय॥ १०/३२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50017058, "chapter_id": 11593, "verse_number": "8", "content_sanskrit": "तस्य चाक्रन्दितं श्रुत्वा गोपालाः सहसोत्थिताः। ग्रस्तं च दृष्ट्वा सम्भ्रान्ताः सर्पं विव्यधुरुल्मुकैः॥१०/३२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50017059, "chapter_id": 11593, "verse_number": "9", "content_sanskrit": "अलातैर्हन्यमानोऽपि नामुञ्चत् तमुरङ्गमः। तमस्पृशत् पदाऽभ्येत्य भगवान् सात्वताम्पतिः॥ १०/३२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50017060, "chapter_id": 11593, "verse_number": "10", "content_sanskrit": "स वै भगवतः श्रीमत्पादस्पर्शहताशुभः। भेजे सर्पवपुर्हित्वा रूपं विद्याधरार्चितम्॥ १०/३२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50017061, "chapter_id": 11593, "verse_number": "11", "content_sanskrit": "तमपृच्छद् हृषीकेशः प्रणतं समुपस्थितम्। दीप्यमानेन वपुषा पुरुषं हेममालिनम्॥ १०/३२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50017062, "chapter_id": 11593, "verse_number": "12", "content_sanskrit": "को भवान् परया लक्ष्म्या रोचतेऽद्भुतदर्शनः। कथं जुगुप्सितामेतां गतिं वा प्रापितोऽवशः॥ १०/३२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50017063, "chapter_id": 11593, "verse_number": "13", "content_sanskrit": "सर्प उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50017064, "chapter_id": 11593, "verse_number": "14", "content_sanskrit": "अहं विद्याधरः कश्चित् सुदर्शन इति श्रुतः। श्रिया स्वरूपसम्पत्त्या विमानेनाचरं दिशः॥ १०/३२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50017065, "chapter_id": 11593, "verse_number": "15", "content_sanskrit": "ऋषीन् विरूपानङ्गिरसः प्राहसं रूपदर्पितः। तैरिमां प्रपितो योनिं प्रलब्धः स्वेन पाप्मना॥ १०/३२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50017066, "chapter_id": 11593, "verse_number": "16", "content_sanskrit": "शापो मेऽनुग्रहायैव कृतस्तैः करुणात्मभिः। यदहं लोकगुरुणा पादस्पृष्टो हताशुभः॥ १०/३२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50017067, "chapter_id": 11593, "verse_number": "17", "content_sanskrit": "तं त्वाऽहं भवभीतानां प्रपन्नानां भयापहम्। आपृच्छे शापनिर्मुक्तः पादस्पर्शादमीवहन्॥ १०/३२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50017068, "chapter_id": 11593, "verse_number": "18", "content_sanskrit": "प्रपन्नोऽस्मि महायोगिन् महापुरुष सत्पते। अनुजानीहि मां कृष्ण सर्वलोकेश्वरेश्वर॥ १०/३२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50017069, "chapter_id": 11593, "verse_number": "19", "content_sanskrit": "ब्रह्मदण्डाद् विमुक्तोऽहं सद्यस्तेऽद्भुतदर्शनात्॥ १०/३२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50017070, "chapter_id": 11593, "verse_number": "20", "content_sanskrit": "यन्नाम गृह्णन्नखिलान् श्रोतृÈनात्मानमेव च। सद्यः पुनाति किं भूयस्तस्य स्पृष्टः पदा हि ते॥ १०/३२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50017071, "chapter_id": 11593, "verse_number": "21", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50017072, "chapter_id": 11593, "verse_number": "22", "content_sanskrit": "इत्यनुज्ञाप्य दाशार्हं परिक्रम्याभिवाद्य च। सुदर्शनो दिवं यातः कृच्छ्रान्नन्दश्च मोक्षितः॥ १०/३२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50017073, "chapter_id": 11593, "verse_number": "23", "content_sanskrit": "निशाम्य कृष्णस्य तदात्मवैभवं व्रजौकसो विस्मितचेतसस्ततः। समाप्य तस्मिन् नियमं पुनर्व्रजं नृपाययुस्तत् कथयन्त आदृताः॥ १०/३२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50017074, "chapter_id": 11593, "verse_number": "24", "content_sanskrit": "कदाचिदथ गोविन्दो रामश्चाद्भुतविक्रमः। विजह्नतुर्वने रात्र्यां मध्यगौ व्रजयोषिताम्॥ १०/३२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50017075, "chapter_id": 11593, "verse_number": "25", "content_sanskrit": "उपगीयमानौ लिळतं स्त्रीजनैर्बद्धसौहृदैः। स्वलङ्कृतानुलिप्ताङ्गौ स्रग्विणौ विरजाम्बरौ॥ १०/३२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50017076, "chapter_id": 11593, "verse_number": "26", "content_sanskrit": "निशामुखं मानयन्तावुदितोडुपतारकम्। मल्लिकागन्धमत्ताळि जुष्टं कुमुदवायुना॥ १०/३२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50017077, "chapter_id": 11593, "verse_number": "27", "content_sanskrit": "जगतुः सर्वभूतानां मनःश्रवणमङ्गळम्। तौ कल्पयन्तौ युगपत् स्वरमण्डलमूर्च्छनाम्॥ १०/३२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50017078, "chapter_id": 11593, "verse_number": "28", "content_sanskrit": "गोप्यस्तद्गीतमाकर्ण्य मूर्च्छिता नाविदन् नृप। श्लथद्दुकूलमात्मानं स्रस्तकेशस्रजं ततः॥ १०/३२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50017079, "chapter_id": 11593, "verse_number": "29", "content_sanskrit": "एवं विक्राडतोः स्वैरं गायतोः सम्प्रमत्तवत्। शङ्खचूड इति ख्यातो धनदानुचरोऽभ्यगात्॥ १०/३२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50017080, "chapter_id": 11593, "verse_number": "30", "content_sanskrit": "तयोर्निरीक्षतोरेव तन्नाथं प्रमदाजनम्। क्रोशन्तं कालयामास दिश्युदीच्यामशङ्कितः॥ १०/३२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50017081, "chapter_id": 11593, "verse_number": "31", "content_sanskrit": "क्रोशन्तं कृष्ण रामेति विलोक्य स्वपरिग्रहम्। यथा गा दस्युना ग्रस्ता भ्रातरावन्वधावताम्॥ १०/३२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50017082, "chapter_id": 11593, "verse_number": "32", "content_sanskrit": "मा भैष्टेत्यभयारावौ ताळहस्तौ मनस्विनौ। आसेदतुस्तं तरसा त्वरितं गुह्यकाधमम्॥ १०/३२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50017083, "chapter_id": 11593, "verse_number": "33", "content_sanskrit": "स वीक्ष्य तावनुप्राप्तौ कालमृत्यू इवोद्विजन्। विसृज्य स्त्रीजनं मूढः प्राद्रवज्जीवनेच्छया॥ १०/३२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50017084, "chapter_id": 11593, "verse_number": "34", "content_sanskrit": "तमन्वधावद् गोविन्दो यत्रयत्र स धावति। जिहीर्षुस्तच्छिरोरत्नां तस्थौ रक्षन् स्त्रियो बलः॥ १०/३२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50017085, "chapter_id": 11593, "verse_number": "35", "content_sanskrit": "अविदूर इवाभ्येत्य शिरस्तस्य दुरात्मनः। जहार मुष्टिनैवाङ्ग सहचूडामणिं विभुः॥ १०/३२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50017086, "chapter_id": 11593, "verse_number": "36", "content_sanskrit": "शङ्खचूडं निहत्यैवं मणिमादाय भासुरम्। अग्रजायाददात् प्रीत्या पश्यन्तीनां च योषिताम्॥ १०/३२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50017087, "chapter_id": 11593, "verse_number": "37", "content_sanskrit": "इति श्रीमद्भागवते दशमस्कन्धे द्वात्रिंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]