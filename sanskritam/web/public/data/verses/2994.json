[{"id": 2093400, "chapter_id": 2994, "verse_number": "१३-१२४-१", "content_sanskrit": "`युधिष्ठिर उवाच।\nपवित्राणां पवित्रं यच्छ्रेष्ठं लोकेषु पूजितम्।\nमहाव्रतं महाभाग तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093401, "chapter_id": 2994, "verse_number": "१३-१२४-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093402, "chapter_id": 2994, "verse_number": "१३-१२४-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nपितुः पुत्रस्य संवादं व्यासस्य च शुकस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093403, "chapter_id": 2994, "verse_number": "१३-१२४-३", "content_sanskrit": "ऋषीणामुत्तमं कृष्णं भावितात्मानमच्युतम्।\nपारम्पर्यविशेषज्ञं सर्वशास्त्रार्थकोविदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093404, "chapter_id": 2994, "verse_number": "१३-१२४-४", "content_sanskrit": "कृतशौचः शुकस्तत्र कृतजप्यः कृताह्निकः।\nपरं नियममास्थाय परं धर्ममुपाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093405, "chapter_id": 2994, "verse_number": "१३-१२४-५", "content_sanskrit": "प्रणम्य शिरसा व्यासं सूक्ष्मतत्वार्थदर्शिनम्।\nशुकः पप्रच्छ वै प्रश्नं दानधर्मकुतूहलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093406, "chapter_id": 2994, "verse_number": "१३-१२४-६", "content_sanskrit": "बहुचित्राणि दानानि बहुशः शंससे मुने।\nमहार्थं पावनं पुण्यं किंस्विद्दानं महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093407, "chapter_id": 2994, "verse_number": "१३-१२४-७", "content_sanskrit": "केन दुर्गाणि तरति केन लोकानवाप्नुते।\nकेन वा महदाप्नोति इह लोके परत्र च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093408, "chapter_id": 2994, "verse_number": "१३-१२४-८", "content_sanskrit": "के वा यज्ञस्य वोढारः केषु यज्ञः प्रतिष्ठितः।\nकिञ्च यज्ञस्य यज्ञत्वं किञ्च यज्ञस्य भेषजम्।\nयज्ञानामुत्तमं किञ्च तद्भवान्प्रब्रवीतु मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093409, "chapter_id": 2994, "verse_number": "१३-१२४-९", "content_sanskrit": "स तस्मै भजमानाय जातकौतूहलाय च।\nव्यासो व्रतनिधिः प्राह गवामिदमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093410, "chapter_id": 2994, "verse_number": "१३-१२४-१०", "content_sanskrit": "धन्यं यशस्यमायुष्यं लोके श्रुतिसुखावहम्।\nयत्पवित्रं पवित्राणां मङ्गलानां च मङ्गलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093411, "chapter_id": 2994, "verse_number": "१३-१२४-११", "content_sanskrit": "सर्वपापप्रशमनं तत्समासेन मे शृणु।\nयदिदं तिष्ठते लोके जगत्स्थावरजङ्गमम्।\nगावस्तत्प्राप्य तिष्ठन्ति गोलोके पुण्यदर्शनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093412, "chapter_id": 2994, "verse_number": "१३-१२४-१२", "content_sanskrit": "मातरः सर्वभूतानां विश्वस्य जगतश्च ह।\nरुद्राणामिह साध्यानां गाव एव तु मातरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093413, "chapter_id": 2994, "verse_number": "१३-१२४-१३", "content_sanskrit": "रुद्राणां मातरो ह्येता ह्यादित्यानां स्वसा स्मृताः।\nवसूनां च दुहित्रस्ता ब्रह्मसन्तानमूलजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093414, "chapter_id": 2994, "verse_number": "१३-१२४-१४", "content_sanskrit": "यासामधिपतिः पूषा मरुतो वालबन्धनाः।\nऐश्वर्यं वरुणो राजा विश्वेदेवाः समाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093415, "chapter_id": 2994, "verse_number": "१३-१२४-१५", "content_sanskrit": "य एवं वेद ता गावो मातरो देवपूजिताः।\nस विप्रो ब्रह्मलोकाय गवां लोकाय वा ध्रुवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2093416, "chapter_id": 2994, "verse_number": "१३-१२४-१६", "content_sanskrit": "गावस्तु नावमन्येत कर्मणा मनसा गिरा।\nगवां स्थानं परं लोके प्रार्थयेद्यः परां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2093417, "chapter_id": 2994, "verse_number": "१३-१२४-१७", "content_sanskrit": "न पद्भ्यां ताडयेद्गा वै न दण्डेन न मुष्टिना।\nइमां विद्यामुपाश्रित्य पावनीं ब्रह्मनिर्मिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2093418, "chapter_id": 2994, "verse_number": "१३-१२४-१८", "content_sanskrit": "मातॄणामन्ववाये च न गोमध्ये न गोव्रजे।\nनरो मूत्रपुरीषस्य दृष्ट्वा कुर्याद्विसर्जनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2093419, "chapter_id": 2994, "verse_number": "१३-१२४-१९", "content_sanskrit": "शुद्धाश्चन्दनशीताङ्ग्यश्चन्द्ररश्मिसमप्रभाः।\nसौम्याः सुरभ्यः सुभगा गावो गुग्गुलुगन्धयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2093420, "chapter_id": 2994, "verse_number": "१३-१२४-२०", "content_sanskrit": "सर्वे देवाऽविशन्गा वै समुद्रमिव सिन्धवः।\nदिवं चैवान्तरिक्षं च गवां व्युष्टिं समश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2093421, "chapter_id": 2994, "verse_number": "१३-१२४-२१", "content_sanskrit": "दधिना जुहुयादग्निं दधिना स्वस्ति वाचयेत्।\nदधि दद्याच्च प्राशेत गवां व्युष्टिं समश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2093422, "chapter_id": 2994, "verse_number": "१३-१२४-२२", "content_sanskrit": "घृतेन जुहुयादग्निं घृतेन स्वस्ति वाचयेत्।\nघृतमालभ्य प्राश्नीयाद्गवां व्युष्टिं समश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2093423, "chapter_id": 2994, "verse_number": "१३-१२४-२३", "content_sanskrit": "गावः संजीवना यास्तु गावो दानमनुत्तमम्।\nताः पुण्यगोपाः सुफला भजमानं भजन्तु माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2093424, "chapter_id": 2994, "verse_number": "१३-१२४-२४", "content_sanskrit": "येन देवाः पवित्रेण स्वर्गलोकमितो गताः।\nतत्पवित्रं पवित्राणां मम मूर्ध्नि प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2093425, "chapter_id": 2994, "verse_number": "१३-१२४-२५", "content_sanskrit": "वीणामृदङ्गपणवा गवां गात्रं प्रतिष्ठिताः।\nक्रीडारतिविहारार्थे त्रिषु लोकेषु वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2093426, "chapter_id": 2994, "verse_number": "१३-१२४-२६", "content_sanskrit": "न तत्र देवा वर्तन्ते नाग्निहोत्राणि जुह्वति।\nन यज्ञैरिज्यते चात्र यत्र गौर्वै न दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2093427, "chapter_id": 2994, "verse_number": "१३-१२४-२७", "content_sanskrit": "क्षीरं दधि घृथं यासां रसानामुत्तमो रसः।\nअमृतप्रभवा गावस्त्रैलोक्यं येन जीवति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2093428, "chapter_id": 2994, "verse_number": "१३-१२४-२८", "content_sanskrit": "इमामाहूय धेनुं च सवत्सां यज्ञमातरम्।\nउपाह्वयन्ति यां विप्रा गावो यज्ञहविष्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2093429, "chapter_id": 2994, "verse_number": "१३-१२४-२९", "content_sanskrit": "या मेध्या प्रथमं कर्म इयं धेनुः सरस्वती।\nपौर्णमासेन वत्सेन कामं कामगुणान्विता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2093430, "chapter_id": 2994, "verse_number": "१३-१२४-३०", "content_sanskrit": "यत्र सर्वमिदं प्रोतं यत्किंचिज्जङ्गमं जगत्।\nस गौर्वै प्रथमा पुण्या सर्वभूतहिते रता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2093431, "chapter_id": 2994, "verse_number": "१३-१२४-३१", "content_sanskrit": "धारणाः पावनाः पुण्या भावना भूतभावनाः।\nगावो मामभिरक्षन्तु इह लोके परत्र च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2093432, "chapter_id": 2994, "verse_number": "१३-१२४-३२", "content_sanskrit": "एष यज्ञः सहोपाङ्ग एष यज्ञः सनातनः।\nवेदाः सहोपनिषदो गवां रूपाः प्रतिष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2093433, "chapter_id": 2994, "verse_number": "१३-१२४-३३", "content_sanskrit": "एतत्तात मया प्रोक्तं गवामिह परं मतम्।\nसर्वतः श्रावयेन्नित्यं प्रयतो ब्रह्मसंसदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2093434, "chapter_id": 2994, "verse_number": "१३-१२४-३४", "content_sanskrit": "श्रुत्वा लभेत ताँल्लोकान्ये मया परिकीर्तिताः।\nश्रावयित्वापि प्रीतात्मा लोकांस्तान्प्रतिपद्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2093435, "chapter_id": 2994, "verse_number": "१३-१२४-३५", "content_sanskrit": "धेनुमेकां समादद्यादहन्यहनि पावनीम्।\nतत्तथा प्राप्नुयाद्विप्रः पठन्वै गोमतीं सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2093436, "chapter_id": 2994, "verse_number": "१३-१२४-३६", "content_sanskrit": "अथ धेनुर्न विद्यते तिलधेनुमनुत्तमाम्।\nदद्याद्गोमतिकल्पेन तां धेनुं सर्वपावनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2093437, "chapter_id": 2994, "verse_number": "१३-१२४-३७", "content_sanskrit": "आह्निकं गोमतीं नित्यं यः पठेत सदा नरः।\nसर्वपापात्प्रमुच्येत प्रयतात्मा य आचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2093438, "chapter_id": 2994, "verse_number": "१३-१२४-३८", "content_sanskrit": "घृतं वा नित्यमालभ्य प्राश्य वा गोमतीं जपेत्।\nस्नात्वा वा गोकरीषेण पठन्पापात्प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2093439, "chapter_id": 2994, "verse_number": "१३-१२४-३९", "content_sanskrit": "मनसा गोमतीं जप्येद्गोमत्या नित्यमाह्निकम्।\nन त्वेन दिवसं कुर्याद्व्यर्थं गोमत्यपाठकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2093440, "chapter_id": 2994, "verse_number": "१३-१२४-४०", "content_sanskrit": "गोमतीं जपमाना हि देवा देवत्वमाप्नुवन्।\nऋषित्वमृषयश्चापि गोमत्या सर्वमाप्नुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2093441, "chapter_id": 2994, "verse_number": "१३-१२४-४१", "content_sanskrit": "बद्धो बन्धात्प्रमुच्येत कृच्छ्रान्मुच्येत सङ्कटात्।\nगोमतीं सेवते यस्तु लभते प्रियसङ्गमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2093442, "chapter_id": 2994, "verse_number": "१३-१२४-४२", "content_sanskrit": "एतत्पवित्रं कार्त्स्न्येन एतद्व्रतमनुत्तमम्।\nएतत्तु पृथिवीपाल पावनं शृण्वतां सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2093443, "chapter_id": 2994, "verse_number": "१३-१२४-४३", "content_sanskrit": "पुत्रकामाश्च ये केचिद्धनकामाश्च मानवाः।\nअद्धाने चोरवैरिभ्यो मुच्यते गोमतीं पठन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2093444, "chapter_id": 2994, "verse_number": "१३-१२४-४४", "content_sanskrit": "पूर्ववैरानुबन्धेषु रणए चाप्याततायिनः।\nलभेत जयमेवाशु सदा गोमतिपाठकः॥॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2093445, "chapter_id": 2994, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चतुर्विंशत्यधिकशततमोऽध्यायः॥ १२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]