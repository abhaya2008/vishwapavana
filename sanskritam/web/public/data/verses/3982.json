[{"id": 2137515, "chapter_id": 3982, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2137516, "chapter_id": 3982, "verse_number": "१", "content_sanskrit": "ततो गर्भः समभवत् पृथायाः पृथिवीपते ।\nशुक्ले दशोत्तरे पक्षे तारापतिरिवाम्बरे \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2137517, "chapter_id": 3982, "verse_number": "२", "content_sanskrit": "सा बान्धवभयाद् बाला गर्भं तं विनिगूहती ।\nधारयामास सुश्रोणी न चैनां बुबुधे जनः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2137518, "chapter_id": 3982, "verse_number": "३", "content_sanskrit": "न हि तां वेद नार्यन्या काचिद् धात्रेयिकामृते ।\nकन्यापुरगतां बालां निपुणां परिरक्षणे \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2137519, "chapter_id": 3982, "verse_number": "४", "content_sanskrit": "ततः कालेन सा गर्भं सुषुवे वरवर्णिनी ।\nकन्यैव तस्य देवस्य प्रसादादमरप्रभम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2137520, "chapter_id": 3982, "verse_number": "५", "content_sanskrit": "तथैवाबद्धकवचं कनकोज्ज्वलकुण्डलम् ।\nहर्यक्षं वृषभस्कन्धं यथास्य पितरं तथा \t ॥ ५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2137521, "chapter_id": 3982, "verse_number": "६", "content_sanskrit": "जातमात्रं च तं गर्भं धात्र्या सम्मन्त्र्य भाविनी ।\nउत्स्रष्टुकामा तं गर्भं कारयामास भारत \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2137522, "chapter_id": 3982, "verse_number": "७", "content_sanskrit": "मञ्जूषां शिल्पिभिस्तूर्णं सुनद्धां सुप्रतिष्ठिताम् ।\nप्लवैर्बहुविधैर्बद्धां प्लवनार्थं जले नृप \t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2137523, "chapter_id": 3982, "verse_number": "८", "content_sanskrit": "अजिनैर्मृदुभिश्चैवं संस्तीर्णशयनां तथा ।\nमञ्जूषायां समाधाय स्वास्तीर्णायां समन्ततः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2137524, "chapter_id": 3982, "verse_number": "९", "content_sanskrit": "मधूच्छिष्टस्थितायां सा सुखायां रुदती तथा ।\nश्लक्ष्णायां सुपिधानायामश्वनद्यामवासृजत् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2137525, "chapter_id": 3982, "verse_number": "१०", "content_sanskrit": "जानती चाप्यकर्तव्यं कन्याया गर्भधारणम् ।\nपुत्रस्नेहेन सा राजन् करुणं पर्यदेवयत् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2137526, "chapter_id": 3982, "verse_number": "११", "content_sanskrit": "समुत्सृजन्ती मञ्जूषामश्वनद्यां तदा जले ।\nउवाच रुदती कुन्ती यानि वाक्यानि तच्छृणु \t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2137527, "chapter_id": 3982, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2137528, "chapter_id": 3982, "verse_number": "१२", "content_sanskrit": "स्वस्ति ते चान्तरिक्षेभ्यः पार्थिवेभ्यश्च पुत्रक ।\nदिव्येभ्यश्चैव भूतेभ्यस्तथा तोयचराश्च ये \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2137529, "chapter_id": 3982, "verse_number": "१३", "content_sanskrit": "शिवास्ते सन्तु पन्थानो मा च ते परिपन्थिनः ।\nआगताश्च तथा पुत्र भवन्त्वद्रोहचेतसः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2137530, "chapter_id": 3982, "verse_number": "१४", "content_sanskrit": "पातु त्वां वरुणो राजा सलिले सलिलेश्वरः ।\nअन्तरिक्षेऽन्तरिक्षस्थः पवनः सर्वगस्तथा \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2137531, "chapter_id": 3982, "verse_number": "१५", "content_sanskrit": "पिता त्वां पातु सर्वत्र तपनस्तपतां वरः ।\nयेन दत्तोऽसि मे पुत्र दिव्येन विधिना किल \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2137532, "chapter_id": 3982, "verse_number": "१६", "content_sanskrit": "आदित्या वसवो रुद्राः साध्या विश्वे च देवताः ।\nमरुतश्च सहेन्द्रेण दिशश्च सदिगीश्वराः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2137533, "chapter_id": 3982, "verse_number": "१७", "content_sanskrit": "रक्षन्तु त्वां सुराः सर्वे समेषु विषमेषु च ।\nवेत्स्यामि त्वां विदेशेऽपि कवचेनाभिसूचितम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2137534, "chapter_id": 3982, "verse_number": "१८", "content_sanskrit": "धन्यस्ते पुत्र जनको देवो भानुर्विभावसुः ।\nयस्त्वां द्रक्ष्यति दिव्येन चक्षुषा वाहिनीगतम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2137535, "chapter_id": 3982, "verse_number": "१९", "content_sanskrit": "धन्या सा प्रमदा या त्वां पुत्रत्वं(त्वे) कल्पयिष्यति ।\nयस्यास्त्वं तृषितः पुत्र स्तनं पास्यसि देवज \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2137536, "chapter_id": 3982, "verse_number": "२०", "content_sanskrit": "को नु स्वप्नस्तया दृष्टो या त्वामादित्यवर्चसम् ।\nदिव्यवर्मसमायुक्तं दिव्यकुण्डलभूषितम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2137537, "chapter_id": 3982, "verse_number": "२१", "content_sanskrit": "पद्मायतविशालाक्षं पद्मताम्रदलोज्ज्वलम् ।\nसुललाटं सुकेशान्तं पुत्रत्वे कल्पयिष्यति \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2137538, "chapter_id": 3982, "verse_number": "२२", "content_sanskrit": "धन्या द्रक्ष्यन्ति पुत्र त्वां भूमौ संसर्पमाणकम् ।\nअव्यक्तकलवाक्यानि वदन्तं रेणुगुण्ठितम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2137539, "chapter_id": 3982, "verse_number": "२३", "content_sanskrit": "धन्या द्रक्ष्यन्ति पुत्र त्वां पुनर्यौवनगोचरम् ।\nहिमवद्वनसम्भूतं सिंहं केसरिणं यथा \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2137540, "chapter_id": 3982, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2137541, "chapter_id": 3982, "verse_number": "२४", "content_sanskrit": "एवं बहुविधं राजन् विलप्य करुणं पृथा ।\nअवासृजत मञ्जूषामश्वनद्यास्तदा जले \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2137542, "chapter_id": 3982, "verse_number": "२५", "content_sanskrit": "रुदती पुत्रशोकार्ता निशीथे कमलेक्षणा ।\nधात्र्या सह पृथा राजन् पुत्रदर्शनलालसा \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2137543, "chapter_id": 3982, "verse_number": "२६", "content_sanskrit": "विसर्जयित्वा मञ्जूषां सम्बोधनभयात् पितुः ।\nविवेश राजभवनं पुनः शोकातुरा ततः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2137544, "chapter_id": 3982, "verse_number": "२७", "content_sanskrit": "मञ्जूषा त्वश्वनद्याः सा ययौ चर्मण्वतीं नदीम् ।\nचर्मण्वत्याश्च यमुनां ततो गङ्गां जगाम ह \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2137545, "chapter_id": 3982, "verse_number": "२८", "content_sanskrit": "गङ्गायां सूतविषयं चम्पामनुययौ पुरीम् ।\nस मञ्जूषागतो गर्भस्तरङ्गैरुह्यमानकः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2137546, "chapter_id": 3982, "verse_number": "२९", "content_sanskrit": "अमृतादुत्थितं दिव्यं तनुवर्म सकुण्डलम् ।\nधारयामास तं गर्भं दैवं च विधिनिर्मितम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2137547, "chapter_id": 3982, "verse_number": "३०", "content_sanskrit": "एतद् गुह्यं महाराज सूर्यस्यासीन्महात्मनः ।\nस सूर्यसम्भवो गर्भः कुन्त्या गर्भेण धारितः \t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2137548, "chapter_id": 3982, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि सप्तनवत्यधिकद्विशततमोऽध्यायः ॥२९७॥\nकुण्डलाहरणपर्वणि अष्टमोऽध्यायः ॥८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]