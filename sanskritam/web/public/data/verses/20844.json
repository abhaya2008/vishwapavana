[{"id": 7000844000, "chapter_id": 20844, "verse_number": "६-१८७-१", "content_sanskrit": "देव्युवाच ।\nद्वादशाध्यायमाहात्म्यं भवता कथितं मम ।\nब्रूहि त्रयोदशाध्यायमाहात्म्यमतिसुंदरम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000844001, "chapter_id": 20844, "verse_number": "६-१८७-२", "content_sanskrit": "ईश्वर उवाच ।\nशृणु त्रयोदशाध्यायमहिमांभोनिधिं शिवे ।\nयदाकर्णनमात्रेण परां मुदमवाप्स्यसि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000844002, "chapter_id": 20844, "verse_number": "६-१८७-३", "content_sanskrit": "अस्ति दक्षिणदिङ्मार्गे तुंगभद्रा महानदी ।\nतत्तटे नगरं रम्यं नाम्ना हरिहरं पुरम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000844003, "chapter_id": 20844, "verse_number": "६-१८७-४", "content_sanskrit": "यत्राऽस्ते भगवान्देवि देवो हरिहरः स्वयम् ।\nयस्य दर्शनमात्रेण परं कल्याणमाप्यते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000844004, "chapter_id": 20844, "verse_number": "६-१८७-५", "content_sanskrit": "तस्मिन्पुरे द्विजन्मासीद्धरिदीक्षितसंज्ञिकः ।\nतपः स्वाध्यायनिरतो श्रोत्रियो वेदपारगः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000844005, "chapter_id": 20844, "verse_number": "६-१८७-६", "content_sanskrit": "दुराचारेति तस्यासीद्भार्या नाम्ना च कर्मणा ।\nन सुष्वाप समं पत्या दुरालापा कदाचन ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000844006, "chapter_id": 20844, "verse_number": "६-१८७-७", "content_sanskrit": "क्षणमप्यात्मसदने न चास्ते स्वैरचारिणी ।\nकंठदघ्नं द्विजद्वारे धयंती वारुणीरसम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000844007, "chapter_id": 20844, "verse_number": "६-१८७-८", "content_sanskrit": "पतिसंबधिनः सर्वान्तर्जयंती पुनः पुनः ।\nविटैः सह सदोन्मत्ता रममाणा निरंतरम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000844008, "chapter_id": 20844, "verse_number": "६-१८७-९", "content_sanskrit": "कदचिद्व्याकुलं दृष्ट्वा पुरं पौरैरितस्ततः ।\nसंकेतगेहमकरोत्कांतारे निर्जने स्वयम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000844009, "chapter_id": 20844, "verse_number": "६-१८७-१०", "content_sanskrit": "अथ तत्रैव सा धूर्ता रममाणा विटैः सह ।\nनिनाय सा बहून्कालान्निजयौवनगर्विता ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000844010, "chapter_id": 20844, "verse_number": "६-१८७-११", "content_sanskrit": "अथ तस्मिन्पुरे रम्ये निवसंत्या निरंकुशम् ।\nवसंतकालं समभूत्परं चित्ते भुवः सखा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000844011, "chapter_id": 20844, "verse_number": "६-१८७-१२", "content_sanskrit": "आमूलपल्लवाकीर्णं सहकारविकारिणा ।\nपिकानां पंचमालापैः पुनः स जीवितः स्मरः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000844012, "chapter_id": 20844, "verse_number": "६-१८७-१३", "content_sanskrit": "स्फुरच्चंपकसौरभ्यहारकैर्मलयानिलैः ।\nमंदं मंदं प्रसर्पद्भिरांदोलितवनद्रुमः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000844013, "chapter_id": 20844, "verse_number": "६-१८७-१४", "content_sanskrit": "उत्फुल्लमल्लिकामोद मदिरापारणावताम् ।\nअलीनां कलटंकारैः समंताद्रावशोभितः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000844014, "chapter_id": 20844, "verse_number": "६-१८७-१५", "content_sanskrit": "प्रसन्नचारुभिः स्मेरः सरोवरसुगंधिभिः ।\nमीलन्मरालनिवहैः सरोभिः प्रकटीकृतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000844015, "chapter_id": 20844, "verse_number": "६-१८७-१६", "content_sanskrit": "घनच्छायासुखासीन हरिणार्भकधारिभिः ।\nनीरंध्रपल्लवैर्नानाशाखिभिः शोभितावनिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000844016, "chapter_id": 20844, "verse_number": "६-१८७-१७", "content_sanskrit": "तस्मिन्वसंतसमये मुदिता साभिसारिका ।\nअपश्यज्जगदानंददायिनीं चंद्रिकां निशि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000844017, "chapter_id": 20844, "verse_number": "६-१८७-१८", "content_sanskrit": "चंचच्चकोरचंच्वग्रगलत्पीयूषसीकराम् ।\nद्रवदिंदुशिलानिर्यत्सुधानिर्झरनिर्भराम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000844018, "chapter_id": 20844, "verse_number": "६-१८७-१९", "content_sanskrit": "विकाशिकुसुमक्रोडसांद्रीभूतकरोत्कराम् ।\nउल्लासितपयोराशिकल्लोलालिंगितांबराम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000844019, "chapter_id": 20844, "verse_number": "६-१८७-२०", "content_sanskrit": "मनोभवमहासिंहकुलटाकंठकर्तरीम् ।\nघनांधकारसंदोहविदारणपटीयसीम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000844020, "chapter_id": 20844, "verse_number": "६-१८७-२१", "content_sanskrit": "श्वेतीकृतसतीकारपरार्थहिमगर्भिणीम् ।\nम्लानपंकजसंकोचा द्यूनामानंददायिनीम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000844021, "chapter_id": 20844, "verse_number": "६-१८७-२२", "content_sanskrit": "चक्रवाकवधूवक्त्र करुणाक्रोशसाक्षिणीम् ।\nमुक्ताश्रेणीविशुद्धांशु प्रभासितदिगंतराम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000844022, "chapter_id": 20844, "verse_number": "६-१८७-२३", "content_sanskrit": "अथ तस्यां प्रभूतायां पूरयंत्या दिशो दश ।\nकामांधा कामिनीजाता पथिसौधविहारिणी ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000844023, "chapter_id": 20844, "verse_number": "६-१८७-२४", "content_sanskrit": "अपश्यंती विटान्रात्रौ निर्भिद्य भवनार्गलम् ।\nययौ संकेतभवनं निर्गत्य नगराद्बहिः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000844024, "chapter_id": 20844, "verse_number": "६-१८७-२५", "content_sanskrit": "तत्र प्रियतमं कंचित्काममोहितमानसा ।\nअन्वेषयंती नाद्राक्षीत्कुंजे कुंजे तरौ तरौ ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000844025, "chapter_id": 20844, "verse_number": "६-१८७-२६", "content_sanskrit": "आकर्णयंती कांतस्य मंदालापान्पदे पदे ।\nअभियाति ततः क्रीडन्यत्र संहारिनिस्वनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000844026, "chapter_id": 20844, "verse_number": "६-१८७-२७", "content_sanskrit": "चक्रवाकरवान्श्रुत्वा कांतालापभ्रमादसौ ।\nसरोवराणि सर्वाणि पर्यटंती मुहुर्मुहुः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000844027, "chapter_id": 20844, "verse_number": "६-१८७-२८", "content_sanskrit": "कांतभ्रांत्या तरुतले प्रसुप्तान्हरिणोत्करान् ।\nप्रबोधयंती सोच्छ्वासमागतास्मीति भाषिणी ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000844028, "chapter_id": 20844, "verse_number": "६-१८७-२९", "content_sanskrit": "आलिंगंती वनस्थाणुं जीवनेश्वरशंकया ।\nतदाननभ्रमाद्भूयं चुंबंती विकचांबुजम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000844029, "chapter_id": 20844, "verse_number": "६-१८७-३०", "content_sanskrit": "तत्रतत्र कृतव्यर्थश्रमादृष्टप्रियास्वयम् ।\nविललाप वने तस्मिन्मूर्च्छती विविधोक्तिभिः ।\nहा कांत हा गुणाक्रांत मच्चैतन्यस्य नायक ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000844030, "chapter_id": 20844, "verse_number": "६-१८७-३१", "content_sanskrit": "हे मनोहरसौभाग्य भाग्यलावण्यशेवधे ।\nहा पूर्णचंद्रवदन हा सरोजायतेक्षण ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000844031, "chapter_id": 20844, "verse_number": "६-१८७-३२", "content_sanskrit": "हा कांततत्वसौहित्य विश्रमाय सुरद्रुम ।\nयदि कोपेन कुत्रापि गुह्यवेषोऽत्र तिष्ठसि ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000844032, "chapter_id": 20844, "verse_number": "६-१८७-३३", "content_sanskrit": "प्रसादयामि त्वां कांत दत्त्वा प्राणान्प्रियानपि ।\nइत्युच्चैः सर्वतो दिक्षु विलपंत्या वियोगतः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000844033, "chapter_id": 20844, "verse_number": "६-१८७-३४", "content_sanskrit": "तस्याः श्रुत्वा वचः कोऽपि सुप्तो व्याघ्रः प्रबुद्धवान् ।\nकुर्वन्घुरघुरध्वानं पश्यन्प्रतिदिशं रुषा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000844034, "chapter_id": 20844, "verse_number": "६-१८७-३५", "content_sanskrit": "आस्फालयन्नखैर्भूमिं गर्जन्नाकाशगह्वरम् ।\nपृष्ठनिर्भग्नलांगूल द्रुतमुत्थाय वेगवान् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000844035, "chapter_id": 20844, "verse_number": "६-१८७-३६", "content_sanskrit": "गतो व्याघ्रः समुत्पत्य यत्रास्ते साभिसारिका ।\nअथ सापि तमायांतमालोक्य पतिशंकया ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000844036, "chapter_id": 20844, "verse_number": "६-१८७-३७", "content_sanskrit": "निर्जगाम पुरः स्थातुं प्रेममनिर्भरमानसा ।\nततस्तस्यनखक्रीडाक्रूरतांधीकृता सती ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000844037, "chapter_id": 20844, "verse_number": "६-१८७-३८", "content_sanskrit": "जहौ प्रियवपुः शंकां श्रुत्वा गर्जितमूर्ज्जितम् ।\nतथाविधापि सा नारी भ्रांतिमुत्सृज्यसत्वरम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000844038, "chapter_id": 20844, "verse_number": "६-१८७-३९", "content_sanskrit": "व्याघ्रत्वं तु कुतो हेतोर्मां निहंतुमिहागतः ।\nइदं सर्वं समाख्याहि यतस्त्वं हंतुमिच्छसि ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000844039, "chapter_id": 20844, "verse_number": "६-१८७-४०", "content_sanskrit": "इति तस्या वचः श्रुत्वा शार्दूलश्चंडविक्रमः ।\nक्षणं विहाय तद्ग्रासमुवाच प्रहसन्निव ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000844040, "chapter_id": 20844, "verse_number": "६-१८७-४१", "content_sanskrit": "मलापहा नदी नाम्ना देशे तिष्ठति दक्षिणे ।\nनगरी मुनिपर्णेति तस्या रोधसि वर्तते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000844041, "chapter_id": 20844, "verse_number": "६-१८७-४२", "content_sanskrit": "तत्रास्ते भगवान्साक्षात्पंचलिंगो महेश्वरः ।\nतस्यां पुर्यामहं विप्र पुत्रो भूत्वा स्थितस्ततः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000844042, "chapter_id": 20844, "verse_number": "६-१८७-४३", "content_sanskrit": "अयाज्यान्याजयन्नश्नन्नेकोद्दिष्टे नदी तटे ।\nवेदपाठफलं शश्वद्विक्रीणन्धनकांक्षया ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000844043, "chapter_id": 20844, "verse_number": "६-१८७-४४", "content_sanskrit": "भिक्षुकानपरान्लोभात्तिरस्कुर्वन्दुरुक्तिभिः ।\nअदेयद्रविणं गृह्णन्नदत्तमनिशं दिनम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000844044, "chapter_id": 20844, "verse_number": "६-१८७-४५", "content_sanskrit": "छलयन्सकलांल्लोकान्क्षणग्रहणकौतुकात् ।\nततः कतिपये काले जरठत्वमुपागतः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000844045, "chapter_id": 20844, "verse_number": "६-१८७-४६", "content_sanskrit": "वलीपलितवानंधः प्रपतन्प्रस्खलद्गतिः ।\nपतद्दंतोभवं भूयः प्रतिग्रहपरायणः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000844046, "chapter_id": 20844, "verse_number": "६-१८७-४७", "content_sanskrit": "हस्ते गृहीत दर्भोऽहमगमं तीर्थसन्निधिम् ।\nधनग्रहणलोभेन भ्रमन्पर्वसु पर्वसु ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000844047, "chapter_id": 20844, "verse_number": "६-१८७-४८", "content_sanskrit": "ततोऽहं शिथिलांगः सन्कंचिद्भूनिर्जरालयम् ।\nगतवान्याचितं भोक्तुं दष्टो मध्ये पदे शुना ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000844048, "chapter_id": 20844, "verse_number": "६-१८७-४९", "content_sanskrit": "अपतं मूर्छितो भूत्वा ततः क्षितितले क्षणात् ।\nततोऽहं गलितप्राणो व्याघ्रयोनिमुपागतः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000844049, "chapter_id": 20844, "verse_number": "६-१८७-५०", "content_sanskrit": "अत्र तिष्ठामि कांतारे पूर्वपापमनुस्मरन् ।\nन भक्षयामि धर्मिष्ठान्मुनीन्साधुजनान्सतीः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000844050, "chapter_id": 20844, "verse_number": "६-१८७-५१", "content_sanskrit": "किंतु पापान्दुराचारनसतीर्भक्षयाम्यहम् ।\nअतोऽसतित्वं तत्वेन ममैव कवलायसे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000844051, "chapter_id": 20844, "verse_number": "६-१८७-५२", "content_sanskrit": "इत्युक्त्वा स्वैर्नखैः कूरैस्तां विभज्यांगखंडशः ।\nअथतां भक्षितां तेन पापदेहमुपाश्रिताम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000844052, "chapter_id": 20844, "verse_number": "६-१८७-५३", "content_sanskrit": "यमस्य किंकरा निन्युः सद्यः संयमनीं पुरीम् ।\nयमादेशेन तत्रापि पातयामासुराशु ताम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000844053, "chapter_id": 20844, "verse_number": "६-१८७-५४", "content_sanskrit": "विण्मूत्ररक्तपूर्णेषु घोरकुंडेष्वनेकधा ।\nकल्पकोटिषु पीतासु तस्मादानीय तां मुहुः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000844054, "chapter_id": 20844, "verse_number": "६-१८७-५५", "content_sanskrit": "रौरवे स्थापयामासुर्मन्वंतरशतावधि ।\nततोप्याकृष्य तां दीनां रुदतीं सर्वतोमुखीम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000844055, "chapter_id": 20844, "verse_number": "६-१८७-५६", "content_sanskrit": "मुक्तकेशां भग्नगात्रां चिक्षिपुर्दहनानने ।\nएवं पापपरां घोरां भुक्त्वा नरकयातनाम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000844056, "chapter_id": 20844, "verse_number": "६-१८७-५७", "content_sanskrit": "इह जाता महापापात्पुनः श्वपचयोनिषु ।\nततः श्वपचगेहेऽपि वर्द्धमाना दिनेदिने ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000844057, "chapter_id": 20844, "verse_number": "६-१८७-५८", "content_sanskrit": "पूर्वजन्मवशेनैव तथैवासीद्यथा पुरा ।\nततः कतिपये काले पुनः स्वंभवनंययौ ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000844058, "chapter_id": 20844, "verse_number": "६-१८७-५९", "content_sanskrit": "यत्रास्ते जृंभकादेवी शिवस्यांतः पुरेश्वरी ।\nतत्रापश्यद्द्विजन्मानं वासुदेवाभिधं शुचिम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000844059, "chapter_id": 20844, "verse_number": "६-१८७-६०", "content_sanskrit": "गीतात्रयोदशाध्यायमुद्गिरंतमनारतम् ।\nततस्तच्छ्रवणादेव मुक्ता श्वपचविग्रहात् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000844060, "chapter_id": 20844, "verse_number": "६-१८७-६१", "content_sanskrit": "दिव्यं देहं समासाद्य जगाम त्रिदशालयम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]