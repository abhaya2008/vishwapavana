[{"id": 2128082, "chapter_id": 3743, "verse_number": "", "content_sanskrit": "धौम्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2128083, "chapter_id": 3743, "verse_number": "१", "content_sanskrit": "उदीच्यां राजशार्दूल दिशि तीर्थानि यानि वै ।\nतानि ते कीर्तयिष्यामि पुण्यान्यायतनानि च\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2128084, "chapter_id": 3743, "verse_number": "२", "content_sanskrit": "सरस्वती पुण्यतमा ह्रादिनी वनमालिनी\nसमुद्रगा महावेगा यमुना यत्र पाण्डव\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2128085, "chapter_id": 3743, "verse_number": "३", "content_sanskrit": "यत्र पुण्यतमं तीर्थं प्लक्षावतरणं शुभम् ।\nयत्र सारस्वतैरिष्ट्वा गच्छन्त्यवभृथं द्विजाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2128086, "chapter_id": 3743, "verse_number": "४", "content_sanskrit": "पुण्यं चाख्यायते दिव्यं शिवमग्निशिरो नृप ।\nसहदेवोऽयजद् यत्र शम्याक्षेपेण भारत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2128087, "chapter_id": 3743, "verse_number": "५", "content_sanskrit": "एतस्मिन्नेव चार्थेऽसौ इन्द्रगीता युधिष्ठिर ।\nगाथा चरति लोकेऽस्मिन् गीयमाना द्विजातिभिः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2128088, "chapter_id": 3743, "verse_number": "६", "content_sanskrit": "अग्नयः सहदेवेन ये चिता यमुनामनु ।\nशतं शतसहस्राणि सहस्रशतदक्षिणाः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2128089, "chapter_id": 3743, "verse_number": "७", "content_sanskrit": "तत्रैव भरतो राजा चक्रवर्ती महायशाः ।\nविंशतिं सप्त चाष्टौ च हयमेधानुपाहरत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2128090, "chapter_id": 3743, "verse_number": "८", "content_sanskrit": "कामकृद् यो द्विजातीनां श्रुतस्तात मया पुरा ।\nअत्यन्तमाश्रमः पुण्यः शङ्करस्तत्र विश्रुतः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2128091, "chapter_id": 3743, "verse_number": "९", "content_sanskrit": "सरस्वती नदी सद्भिः सततं पार्थ पूजिता ।\nवालखिल्यैर्महाराज यत्रेष्टमृषिभिः पुरा \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2128092, "chapter_id": 3743, "verse_number": "१०", "content_sanskrit": "दृषद्वती पुण्यतमा यत्र ख्याता युधिष्टिर ।\nतत्र वैवर्ण्यवर्णौ च पुण्यौ भरतसत्तम \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2128093, "chapter_id": 3743, "verse_number": "११", "content_sanskrit": "वेदज्ञौ वेदविदितौ विद्यावेदविदावुभौ ।\nयजन्तौ क्रतुभिर्नित्यं पुण्यैर्भरतसत्तम\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2128094, "chapter_id": 3743, "verse_number": "१२", "content_sanskrit": "समेत्य बहुशो देवाः सेन्द्राः सवरुणाः पुरा ।\nविशाखयूपेऽतप्यन्त तस्मात् पुण्यतमः स च \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2128095, "chapter_id": 3743, "verse_number": "१३", "content_sanskrit": "ऋषिर्महान् महाभागो जमदग्निर्महायशाः ।\nपलाशकेषु पुण्येषु रम्येष्वयजताभिभूः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2128096, "chapter_id": 3743, "verse_number": "१४", "content_sanskrit": "यत्र सर्वाः सरिच्छ्रेष्ठाः साक्षात् तमृषिसत्तमम् ।\nस्वंस्वं तोयमुपादाय परिवार्योपतस्थिरे \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2128097, "chapter_id": 3743, "verse_number": "१५", "content_sanskrit": "अपि चात्र महाराज स्वयं विश्वावसुर्जगौ ।\nइमं श्लोकं तदा वीर यज्ञं वीक्ष्य महात्मनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2128098, "chapter_id": 3743, "verse_number": "१६", "content_sanskrit": "यजमानस्य वै देवान् जमदग्नेर्महात्मनः ।\nआगम्य सरितः सर्वान् मधुना समतर्पयन्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2128099, "chapter_id": 3743, "verse_number": "१७", "content_sanskrit": "गन्धर्वयक्षरक्षोभिरप्सरोभिश्च शोभितम् ।\nकिरातकिन्नरावासं शैलं शिखरिणां वरम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2128100, "chapter_id": 3743, "verse_number": "१८", "content_sanskrit": "बिभेद तरसा गङ्गा गङ्गाद्वारे युधिष्ठिर ।\nपुण्यं तत् ख्यायते राजन् ब्रह्मर्षिगणसेवितम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2128101, "chapter_id": 3743, "verse_number": "१९", "content_sanskrit": "भृगुर्यत्र तपस्तेपे महर्षिगणसेवितः ।\nस राजन्नाश्रमः ख्यातो भृगुतुन्दो महागिरिः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2128102, "chapter_id": 3743, "verse_number": "२०", "content_sanskrit": "यच्च भूतं भविष्यच्च भवच्च भरतर्षभ ।\nनारायणः प्रभुर्विष्णुः शाश्वतः पुरुषोत्तमः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2128103, "chapter_id": 3743, "verse_number": "२१", "content_sanskrit": "तस्यातियशसः पुण्यां विशालां बदरीमनु ।\nआश्रमः ख्यायते पुण्यः त्रिषु लोकेषु भारत\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2128104, "chapter_id": 3743, "verse_number": "२२", "content_sanskrit": "उष्णतोयवहा गङ्गा शीततोयवहाऽपरा ।\nसुवर्णसिकता राजन् विशालां बदरीमनु\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2128105, "chapter_id": 3743, "verse_number": "२३", "content_sanskrit": "ऋषयो यत्र देवाश्च महाभागा महौजसः ।\nप्राप्य नित्यं नमस्यन्ते देवं नारायणं प्रभुम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2128106, "chapter_id": 3743, "verse_number": "२४", "content_sanskrit": "यत्र नारायणो देवः परमात्मा सनातनः ।\nतत्र कृत्स्नं जगत् पार्थ तीर्थान्यायतनानि च \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2128107, "chapter_id": 3743, "verse_number": "२५", "content_sanskrit": "तत् पुण्यं तत् परं ब्रह्म तत् तीर्थं तत् तपोवनम् ।\nतत्र देवर्षयः सिद्धाः सर्वे चैव तपोधनाः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2128108, "chapter_id": 3743, "verse_number": "२६", "content_sanskrit": "आदिदेवो महायोगी यत्रास्ते मधुसूदनः ।\nपुण्यानामपि तत् पुण्यं मा भूत् ते संशयोऽत्र वै\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2128109, "chapter_id": 3743, "verse_number": "२७", "content_sanskrit": "एतानि राजन् पुण्यानि पृथिव्यां पृथिवीपते ।\nकीर्तितानि नरश्रेष्ठ तीर्थान्यायतनानि च\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2128110, "chapter_id": 3743, "verse_number": "२८", "content_sanskrit": "एतानि वसुभिः साध्यैरादित्यैर्मरुदश्विभिः ।\nऋषिभिर्ब्रह्मकल्पैश्च सेवितानि महात्मभिः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2128111, "chapter_id": 3743, "verse_number": "२९", "content_sanskrit": "चरन्नेतानि कौन्तेय सहितो ब्राह्मणर्षभैः ।\nभ्रातृभिश्च महाभागैरुत्कण्ठां विजहिष्यसि\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2128112, "chapter_id": 3743, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि पञ्चाशीतितमोऽध्यायः ॥८५॥\n॥ तीर्थयात्रापर्वणि एकचत्वारिंशोऽध्यायः ॥४१॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]