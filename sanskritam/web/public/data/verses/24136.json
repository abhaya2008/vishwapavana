[{"id": 7004136000, "chapter_id": 24136, "verse_number": "४-८५-१", "content_sanskrit": "स्कंद उवाच ।\nजगज्जनन्याः पार्वत्याः पुरोगस्ते पुरारिणा ।\nयथाख्यायि कथा पुण्या तथा ते कथयाम्यहम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004136001, "chapter_id": 24136, "verse_number": "४-८५-२", "content_sanskrit": "पुरा महीमिमां सर्वां ससमुद्राद्रिकाननाम् ।\nससरित्कां सार्णवां च सग्रामपुरपत्तनाम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004136002, "chapter_id": 24136, "verse_number": "४-८५-३", "content_sanskrit": "परिभ्रम्य महातेजा महामर्षो महातपाः ।\nदुर्वासाः संपरिप्राप्तः शंभोरानंदकाननम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004136003, "chapter_id": 24136, "verse_number": "४-८५-४", "content_sanskrit": "विलोक्याक्रीडमखिलं बहुप्रासादमंडितम् ।\nबहुकुंडतडागं च शंभोस्तोषमुपागमत्॥  ।\nपदेपदे मुनीनां च जितकाल महाभियाम् ।\nदृष्टोटजानि रम्याणि दुर्वासा विस्मितोभवत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004136004, "chapter_id": 24136, "verse_number": "४-८५-५", "content_sanskrit": "सर्वर्तुकुसुमान्वृक्षान्सुच्छायस्निग्धपल्लवान् ।\nसफलान्सुलताश्लिष्टान्दृष्ट्वा प्रीतिमगान्मुनिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004136005, "chapter_id": 24136, "verse_number": "४-८५-६", "content_sanskrit": "दुर्वासाश्चातिहृष्टोभू्द्दृष्ट्वा पाशुपतोत्तमान् ।\nभूतिभूषितसर्वांगाञ्जटाजटितमौलिकान् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004136006, "chapter_id": 24136, "verse_number": "४-८५-७", "content_sanskrit": "कौपीनमात्र वसनान्स्मरारि ध्यान तत्परान् ।\nकक्षीकृतमहालाबून्हुडुत्कारजितांबुदान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004136007, "chapter_id": 24136, "verse_number": "४-८५-८", "content_sanskrit": "करंडदंडपानीय पात्रमात्रपरिग्रहान् ।\nक्वचित्त्रिदंडिनो दृष्ट्वा निःसंगा निष्परिग्रहान् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004136008, "chapter_id": 24136, "verse_number": "४-८५-९", "content_sanskrit": "कालादपि निरातंकान्विश्वेशशरणं गतान् ।\nक्वचिद्वेदरहस्यज्ञानाबाल्यब्रह्मचारिणः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004136009, "chapter_id": 24136, "verse_number": "४-८५-१०", "content_sanskrit": "नित्यं भागीरथीस्नानपरिपिंगलमूर्धजान् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004136010, "chapter_id": 24136, "verse_number": "४-८५-११", "content_sanskrit": "विलोक्य काश्यां दुर्वासा ब्राह्मणान्मुमुदेतराम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004136011, "chapter_id": 24136, "verse_number": "४-८५-१२", "content_sanskrit": "पशुष्वपि च या तुष्टिर्मृगेष्वपि च या द्युतिः ।\nतिर्यक्ष्वपि च या हृष्टिः काश्यां नान्यत्र सा स्फुटम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004136012, "chapter_id": 24136, "verse_number": "४-८५-१३", "content_sanskrit": "इदं सुश्रेयसो व्युष्टिः क्वामरेषु त्रिविष्टपे ।\nयत्रत्येष्वपि तिर्यक्षु परमानंदवर्धिनी ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004136013, "chapter_id": 24136, "verse_number": "४-८५-१४", "content_sanskrit": "वरमेतेपि पशव आनंदवनचारिणः ।\nसदानंदाः पुनर्देवाननंदनवनाश्रिताः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004136014, "chapter_id": 24136, "verse_number": "४-८५-१५", "content_sanskrit": "वरं काशीपुरीवासी म्लेच्छोपि हि शुभायतिः ।\nनान्यत्रत्यो दीक्षितोपि स हि मुक्तेरभाजनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004136015, "chapter_id": 24136, "verse_number": "४-८५-१६", "content_sanskrit": "वैश्वेश्वरी पुरी चैषा यथा मे चित्तहारिणी ।\nसर्वापि न तथा क्षोणी न स्वर्गो नैव नागभूः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004136016, "chapter_id": 24136, "verse_number": "४-८५-१७", "content_sanskrit": "स्थैर्यं बबंध न क्वापि भ्रमतो मे मनोगतिः ।\nसर्वस्मिन्नपि भूभागे यथा स्थैर्यमगादिह ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004136017, "chapter_id": 24136, "verse_number": "४-८५-१८", "content_sanskrit": "रम्या पुरी भवेदेषा ब्रह्मांडादखिलादपि ।\nपरिष्टुत्येति दुर्वासाश्चेतोवृत्तिमवाप ह ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004136018, "chapter_id": 24136, "verse_number": "४-८५-१९", "content_sanskrit": "तप्यमानोपि हि तपः सुचिरं स महातपाः ।\nयदा नाप फलं किंचिच्चुकोप च तदा भृशम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004136019, "chapter_id": 24136, "verse_number": "४-८५-२०", "content_sanskrit": "धिक्च मां तापसं दुष्टं धिक्च मे दुश्चरं तपः ।\nधिक्च क्षेत्रमिदं शंभोः सर्वेषां च प्रतारकम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004136020, "chapter_id": 24136, "verse_number": "४-८५-२१", "content_sanskrit": "यथा न मुक्तिरत्र स्यात्कस्यापि करवै तथा ।\nइति शप्तुं यदोद्युक्तः संजहास तदा शिवः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004136021, "chapter_id": 24136, "verse_number": "४-८५-२२", "content_sanskrit": "तत्र लिंगमभूदेकं ख्यातं प्रहसितेश्वरम् ।\nतल्लिंगदर्शनात्पुंसामानंदः स्यात्पदेपदे ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004136022, "chapter_id": 24136, "verse_number": "४-८५-२३", "content_sanskrit": "उवाच विस्मयाविष्टो मनस्येव महेशिता ।\nईदृशेभ्यस्तपस्विभ्यो नमोस्त्विति पुनःपुनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004136023, "chapter_id": 24136, "verse_number": "४-८५-२४", "content_sanskrit": "यत्रैव हि तपस्यंति यत्रैव विहिताश्रमाः ।\nलब्धप्रतिष्ठा यत्रैव तत्रैवामर्षिणो द्विजाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004136024, "chapter_id": 24136, "verse_number": "४-८५-२५", "content_sanskrit": "मनाक्चिंतितमात्रं तु चेल्लभंते न तापसाः ।\nक्रुधा तदैव जीयंते हारिण्या तपसां श्रियः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004136025, "chapter_id": 24136, "verse_number": "४-८५-२६", "content_sanskrit": "तथापि तापसा मान्याः स्वश्रेयोवृद्धिकांक्षिभिः ।\nअक्रोधनाः क्रोधना वा का चिंता हि तपस्विनाम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004136026, "chapter_id": 24136, "verse_number": "४-८५-२७", "content_sanskrit": "इति यावन्महेशानो मनस्येव विचिंतयेत् ।\nतावत्तत्क्रोधजो वह्निर्व्यानशे व्योममंडलम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004136027, "chapter_id": 24136, "verse_number": "४-८५-२८", "content_sanskrit": "तत्कोधानलधूमोघैर्व्यापितं यन्नभोंगणम् ।\nतद्दधाति नभोद्यापि नीलिमानं महत्तरम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004136028, "chapter_id": 24136, "verse_number": "४-८५-२९", "content_sanskrit": "ततो गणाः परिक्षुब्धाः प्रलयार्णव नीरवत् ।\nआः किमेतत्किमेतद्वै भाषमाणाः परस्परम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004136029, "chapter_id": 24136, "verse_number": "४-८५-३०", "content_sanskrit": "गर्जंतस्तर्जयंतश्च प्रोद्यता युधपाणयः ।\nप्रमथाः परितस्थुस्ते परितो धाम शांभवम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004136030, "chapter_id": 24136, "verse_number": "४-८५-३१", "content_sanskrit": "को यमः कोथवा कालः को मृत्युः कस्तथांतकः ।\nको वा विधाता के लेखाः कुद्धेष्वस्मासु कः परः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004136031, "chapter_id": 24136, "verse_number": "४-८५-३२", "content_sanskrit": "अग्निं पिबामो जलवच्चूर्णीकुर्मोखिलान्गिरीन् ।\nसप्तापि चार्णवांस्तूर्णं करवाम मरुस्थलीम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004136032, "chapter_id": 24136, "verse_number": "४-८५-३३", "content_sanskrit": "पातालं चानयामोर्ध्वमधो दध्मोथवा दिवम् ।\nएकमेव हि वा ग्रासं गगनं करवामहे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004136033, "chapter_id": 24136, "verse_number": "४-८५-३४", "content_sanskrit": "ब्रह्मांडभांडमथवा स्फोटयामः क्षणेन हि ।\nआस्फालयामो वान्योन्यं कालं मृत्युं च तालवत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004136034, "chapter_id": 24136, "verse_number": "४-८५-३५", "content_sanskrit": "ग्रसामो वाथ भुवनं मुक्त्वा वाराणसीं पुरीम् ।\nयत्र मुक्ता भवंत्येव मृतमात्रेण जंतवः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004136035, "chapter_id": 24136, "verse_number": "४-८५-३६", "content_sanskrit": "कुतोऽयं धूमसंभारो ज्वालावल्यः कुतस्त्वमूः ।\nको वा मृत्युंजयं रुद्रं नो विद्यान्मदमोहितः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004136036, "chapter_id": 24136, "verse_number": "४-८५-३७", "content_sanskrit": "इति पारिषदाः शंभोर्महाभय भयप्रदाः॥ जल्पंतः कल्पयामासुः प्राकारं गगनस्पृशम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004136037, "chapter_id": 24136, "verse_number": "४-८५-३८", "content_sanskrit": "शकलीकृत्य बहुशः शिलावत्प्रलयानलम् ।\nनंदी च नंदिषेणश्च सोमनंदी महोदरः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004136038, "chapter_id": 24136, "verse_number": "४-८५-३९", "content_sanskrit": "महाहनुर्महाग्रीवो महाकालो जितांतकः ।\nमृत्युप्रकंपनो भीमो घंटाकर्णो महाबलः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004136039, "chapter_id": 24136, "verse_number": "४-८५-४०", "content_sanskrit": "क्षोभणो द्रावणो जृंभी पचास्यः पंचलोचनः ।\nद्विशिरास्त्रिशिराः सोमः पंचहस्तो दशाननः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004136040, "chapter_id": 24136, "verse_number": "४-८५-४१", "content_sanskrit": "चंडो भृंगिरिटिस्तुंडी प्रचंडस्तांडवप्रियः ।\nपिचिंडिलः स्थूलशिराः स्थूलकेशो गभस्तिमान् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004136041, "chapter_id": 24136, "verse_number": "४-८५-४२", "content_sanskrit": "क्षेमकः क्षेमधन्वा च वीरभद्रो रणप्रियः ।\nचंडपाणिः शूलपाणिः पाशपाणिः करोदरः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004136042, "chapter_id": 24136, "verse_number": "४-८५-४३", "content_sanskrit": "दीर्घग्रीवोथ पिंगाक्षः पिंगलः पिंगमूर्धजः ।\nबहुनेत्रो लंबकर्णः खर्वः पर्वतविग्रहः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004136043, "chapter_id": 24136, "verse_number": "४-८५-४४", "content_sanskrit": "गोकर्णो गजकर्णश्च कोकिलाख्यो गजाननः ।\nअहं वै नैगमेयश्च विकटास्योट्टहासकः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004136044, "chapter_id": 24136, "verse_number": "४-८५-४५", "content_sanskrit": "सीरपाणिः शिवारावो वैणिको वेणुवादनः ।\nदुराधर्षो दुःसहश्च गर्जनो रिपुतर्जनः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004136045, "chapter_id": 24136, "verse_number": "४-८५-४६", "content_sanskrit": "इत्यादयो गणेशानाः शतकोटि दुरासदाः ।\nकाश्यां निवारयामासुरपि प्राभंजनीं गतिम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004136046, "chapter_id": 24136, "verse_number": "४-८५-४७", "content_sanskrit": "क्षुब्धेषु तेषु वीरेषु चकंपे भुवनत्रयम् ।\nदुर्वाससश्च कोपाग्नि ज्वालाभिर्व्याकुलीकृतम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004136047, "chapter_id": 24136, "verse_number": "४-८५-४८", "content_sanskrit": "तदा विविशतुः काश्यां सूर्याचंद्रमसावपि ।\nन गणैरकृतानुज्ञौ तत्तेजः शमितप्रभौ ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004136048, "chapter_id": 24136, "verse_number": "४-८५-४९", "content_sanskrit": "निवार्य प्रमथानीकमतिक्षुब्धमुमाधवः ।\nमदंश एव हि मुनीरानसूये य एष वै ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004136049, "chapter_id": 24136, "verse_number": "४-८५-५०", "content_sanskrit": "अथो दुर्वाससे लिंगादाविरासीत्कृपानिधिः ।\nमहातेजोमयः शंभुर्मुनिशापात्पुरीमवन् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004136050, "chapter_id": 24136, "verse_number": "४-८५-५१", "content_sanskrit": "माभूच्छापो मुनेः काश्यां निर्वाणप्रतिबंधकः ।\nइत्यनुक्रोशतो देवस्तस्य प्रत्यक्षतां गतः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004136051, "chapter_id": 24136, "verse_number": "४-८५-५२", "content_sanskrit": "उवाच च प्रसन्नोस्मि महाक्रोधन तापस ।\nवरयस्व वरः कस्ते मया देयो विशंकितः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004136052, "chapter_id": 24136, "verse_number": "४-८५-५३", "content_sanskrit": "ततो विलज्जितोगस्त्य शापोद्यतकरो मुनिः ।\nअपराद्धं बहु मया क्रोधांधेनेति दुर्धिया ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004136053, "chapter_id": 24136, "verse_number": "४-८५-५४", "content_sanskrit": "उवाच चेति बहुशो धिङ्मां क्रोधवशंगतम् ।\nत्रैलोक्याभयदां काशीं शप्तुमुद्यतचेतसम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004136054, "chapter_id": 24136, "verse_number": "४-८५-५५", "content_sanskrit": "दुःखार्णव निमग्नानां यातायातेति खेदिनाम् ।\nकर्मपाशितकंठानां काश्येका मुक्तिसाधनम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004136055, "chapter_id": 24136, "verse_number": "४-८५-५६", "content_sanskrit": "सर्वेषां जंतुजातानां जनन्येकैक्काशिका ।\nमहामृतस्तन्यदात्री नेत्री च परमं पदम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004136056, "chapter_id": 24136, "verse_number": "४-८५-५७", "content_sanskrit": "जनन्या सह नो काशी लभेदुपमितिं क्वचित् ।\nधारयेज्जननी गर्भे काशी गर्भाद्विमोचयेत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004136057, "chapter_id": 24136, "verse_number": "४-८५-५८", "content_sanskrit": "एवंभूतां तु यः काशीमन्योपि हि शपिष्यति ।\nतस्यैव शापो भविता न तु काश्याः कथंचन ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004136058, "chapter_id": 24136, "verse_number": "४-८५-५९", "content_sanskrit": "इति दुर्वाससो वाक्यं श्रुत्वा देवस्त्रिलोचनः ।\nअतीव तुषितो जातः काशीस्तवन लब्धमुत् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004136059, "chapter_id": 24136, "verse_number": "४-८५-६०", "content_sanskrit": "यः काशीं स्तौति मेधावी यः काशीं हृदि धारयेत् ।\nतेन तप्तं तपस्तीव्रं तेनेष्टं क्रतुकोटिभिः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004136060, "chapter_id": 24136, "verse_number": "४-८५-६१", "content_sanskrit": "जिह्वाग्रे वर्तते यस्य काशीत्यक्षरयुग्मकम् ।\nन तस्य गर्भवासः स्यात्क्वचिदेव सुमेधसः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004136061, "chapter_id": 24136, "verse_number": "४-८५-६२", "content_sanskrit": "यो मंत्रं जपति प्रातः काशी वर्णद्वयात्मकम् ।\nस तु लोकद्वयं जित्वा लोकातीतं व्रजेत्पदम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004136062, "chapter_id": 24136, "verse_number": "४-८५-६३", "content_sanskrit": "आनुसूयेय ते ज्ञानं काशीस्तवन पुण्यतः ।\nयथेदानीं समुत्पन्नं तथा न तपसः पुरा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004136063, "chapter_id": 24136, "verse_number": "४-८५-६४", "content_sanskrit": "मुने न मे प्रियस्तद्वद्दीक्षितो मम पूजकः ।\nयादृक्प्रियतरः सत्यं काशीस्तवन लालसः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004136064, "chapter_id": 24136, "verse_number": "४-८५-६५", "content_sanskrit": "तादृक्तुष्टिर्न मे दानैस्तादृक्तुष्टिर्न मे मखैः ।\nन तुष्टिस्तपसा तादृग्यादृशी काशिसंस्तवैः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004136065, "chapter_id": 24136, "verse_number": "४-८५-६६", "content_sanskrit": "आनंदकाननं येन स्तुतमेतत्सुचेतसा ।\nतेनाहं संस्तुतः सम्यक्सर्वैः सूक्तैः श्रुतीरितैः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004136066, "chapter_id": 24136, "verse_number": "४-८५-६७", "content_sanskrit": "तव कामाः समृद्धाः स्युरानुसूयेय तापस ।\nज्ञानं ते परमं भावि महामोहविनाशनम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004136067, "chapter_id": 24136, "verse_number": "४-८५-६८", "content_sanskrit": "अपरं च वरं ब्रूहि किं दातव्यं तवानघ ।\nत्वादृशा एव मुनयः श्लाघनीया यतः सताम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004136068, "chapter_id": 24136, "verse_number": "४-८५-६९", "content_sanskrit": "यस्यास्त्वेव हि सामर्थ्यं तपसः क्रुद्ध्यतीहसः ।\nकुपितोप्यसमर्थस्तु किं कर्ता क्षीणवृत्तिवत् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004136069, "chapter_id": 24136, "verse_number": "४-८५-७०", "content_sanskrit": "इति श्रुत्वा परिष्टुत्य दुर्वासाः कृत्तिवाससम् ।\nवरं च प्रार्थयामास परिहृष्ट तनूरुहः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004136070, "chapter_id": 24136, "verse_number": "४-८५-७१", "content_sanskrit": "दुर्वासा उवाच ।\nदेवदेव जगन्नाथ करुणाकर शंकर ।\nमहापराधविध्वंसिन्नंधकारे स्मरांतक ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004136071, "chapter_id": 24136, "verse_number": "४-८५-७२", "content_sanskrit": "मृत्युंजयोग्रभूतेश मृडानीश त्रिलोचन ।\nयदि प्रसन्नो मे नाथ यदि देयो वरो मम ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004136072, "chapter_id": 24136, "verse_number": "४-८५-७३", "content_sanskrit": "तदिदं कामदं नाम लिगमस्त्विह धूर्जटे ।\nइदं च पल्वलं मेत्र कामकुंडाख्यमस्तु वै ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004136073, "chapter_id": 24136, "verse_number": "४-८५-७४", "content_sanskrit": "देवदेव उवाच ।\nएवमस्तु महातेजो मुने परमकोपन ।\nयत्त्वया स्थापितं लिंगं दुर्वासेश्वरसंज्ञितम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004136074, "chapter_id": 24136, "verse_number": "४-८५-७५", "content_sanskrit": "तदेव कामकृन्नृणां कामेश्वरमिहास्त्विति ।\nयः प्रदोषे त्रयोदश्यां शनिवासरसंयुजि ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004136075, "chapter_id": 24136, "verse_number": "४-८५-७६", "content_sanskrit": "संस्नास्यति नरो धीमान्कामकुंडे त्वदास्पदे ।\nत्वत्स्थापितं च कामेशं लिंगं द्रक्ष्यति मानवः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004136076, "chapter_id": 24136, "verse_number": "४-८५-७७", "content_sanskrit": "स वै कामकृताद्दोषाद्यामीं नाप्स्यति यातनाम् ।\nबहवोपि हि पाप्मानो बहुभिर्जन्मभिः कृताः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004136077, "chapter_id": 24136, "verse_number": "४-८५-७८", "content_sanskrit": "कामतीर्थांबु संस्नानाद्यास्यंति विलयं क्षणात् ।\nकामाः समृद्धिमाप्स्यंति कामेश्वर निषेवणात् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004136078, "chapter_id": 24136, "verse_number": "४-८५-७९", "content_sanskrit": "इति दत्त्वा वराञ्शंभुस्तल्लिंगे लयमाययौ ।\nस्कंद उवाच ।\nतल्लिंगाराधनात्कामाः प्राप्ता दुर्वाससा भृशम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004136079, "chapter_id": 24136, "verse_number": "४-८५-८०", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन काश्यां कामेश्वरः सदा ।\nपूजनीयः प्रयत्नेन महाकामाभिलाषुकैः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004136080, "chapter_id": 24136, "verse_number": "४-८५-८१", "content_sanskrit": "कामकुंडकृतस्नानैर्महापातकशांतये ।\nइदं कामेश्वराख्यानं यः पठिष्यति पुण्यवान् ।\nयः श्रोष्यति च मेधावी तौ निष्पापौ भविष्यतः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004136081, "chapter_id": 24136, "verse_number": "४-८५-८२", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां सहितायां चतुर्थे काशीखंड उत्तरार्धे दुर्वाससो वरप्रदानं नाम पंचाशीतितमोऽध्यायः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]