[{"id": 5000626000, "chapter_id": 9626, "verse_number": "७-९१-१", "content_sanskrit": "एतदाख्याय काकुत्स्थो भ्रातृभ्याममितप्रभः ।\nलक्ष्मणं पुनरेवाह धर्मयुक्तमिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000626001, "chapter_id": 9626, "verse_number": "७-९१-२", "content_sanskrit": "वसिष्ठं वामदेवं च जाबालिमथ कश्यपम् ।\nद्विजांश्च सर्वप्रवरानश्वमेधपुरस्कृतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000626002, "chapter_id": 9626, "verse_number": "७-९१-३", "content_sanskrit": "एतान्सर्वान्समानीय मन्त्रयित्वा च लक्ष्मण ।\nहयं लक्षणसम्पन्नं विमोक्ष्यामि समाधिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000626003, "chapter_id": 9626, "verse_number": "७-९१-४", "content_sanskrit": "तद्वाक्यं राघवेणोक्तं श्रुत्वा त्वरितविक्रमः ।\nद्विजान्सर्वान्समाहूय दर्शयामास राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000626004, "chapter_id": 9626, "verse_number": "७-९१-५", "content_sanskrit": "ते दृष्ट्वा देवसङ्काशं कृतपादाभिवन्दनम् ।\nराघवं सुदुराधर्षमाशीर्भिः समपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000626005, "chapter_id": 9626, "verse_number": "७-९१-६", "content_sanskrit": "प्राञ्जलिः स तदा भूत्वा राघवो द्विजसत्तमान् ।\nआचचक्षे ऽश्वमेधस्य ह्यभिप्रायं महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000626006, "chapter_id": 9626, "verse_number": "७-९१-७", "content_sanskrit": "ते तु रामस्य तच्छ्रुत्वा नमस्कृत्वा वृषध्वजम् ।\nअश्वमेधं द्विजाः सर्वे पूजयन्ति स्म सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000626007, "chapter_id": 9626, "verse_number": "७-९१-८", "content_sanskrit": "स तेषां द्विजमुख्यानां वाक्यमद्भुतदर्शनम् ।\nअश्वमेधाश्रितं श्रुत्वा भृशं प्रीतो ऽभवत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000626008, "chapter_id": 9626, "verse_number": "७-९१-९", "content_sanskrit": "विज्ञाय कर्म तत्तेषां रामो लक्ष्मणमब्रवीत् ।\nप्रेषयस्व द्रुतं दूतान् सुग्रीवाय महात्मने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000626009, "chapter_id": 9626, "verse_number": "७-९१-१०", "content_sanskrit": "यथा महद्भिर्हरिभिर्बहुभिश्च वनौकसाम् ।\nसार्धमागच्छ भद्रं ते ह्यनुभोक्तुं महोत्सवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000626010, "chapter_id": 9626, "verse_number": "७-९१-११", "content_sanskrit": "बिभीषणश्च रक्षोभिः कामगैर्बहुभिर्वृतः ।\nअश्वमेधं महायज्ञमायात्वतुलविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000626011, "chapter_id": 9626, "verse_number": "७-९१-१२", "content_sanskrit": "राजानश्च महाभागा ये मे प्रियचिकीर्षवः ।\nसानुगाः क्षिप्रमायान्तु यज्ञं द्रष्टुमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000626012, "chapter_id": 9626, "verse_number": "७-९१-१३", "content_sanskrit": "देशान्तरगता ये च द्विजा धर्मसमाहिताः ।\nआमन्त्रयस्व तान्सर्वानश्वमेधाय लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000626013, "chapter_id": 9626, "verse_number": "७-९१-१४", "content_sanskrit": "ऋषयश्च महाबाहो आहूयन्तां तपोधनाः ।\nदेशान्तरगताः सर्वे सदाराश्च द्विजातयः ।\nतथैव तालावचरास्तथैव नटनर्तकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000626014, "chapter_id": 9626, "verse_number": "७-९१-१५", "content_sanskrit": "यज्ञवाटश्च सुमहान्गोमत्या नैमिशे वने ।\nआज्ञाप्यतां महाबाहो तद्धि पुण्यमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000626015, "chapter_id": 9626, "verse_number": "७-९१-१६", "content_sanskrit": "शान्तयश्च महाबाहो प्रवर्त्यन्तां समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000626016, "chapter_id": 9626, "verse_number": "७-९१-१७", "content_sanskrit": "शतशश्चापि धर्मज्ञाः क्रतुमुख्यमनुत्तमम् ।\nअनुभूय महायज्ञं नैमिशे रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000626017, "chapter_id": 9626, "verse_number": "७-९१-१८", "content_sanskrit": "तुष्टः पुष्टश्च सर्वो ऽसौ मानितश्च यथाविधि ।\nप्रीतिं यास्यति धर्मज्ञ शीघ्रमामन्त्र्यतां जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000626018, "chapter_id": 9626, "verse_number": "७-९१-१९", "content_sanskrit": "शतं वाहसहस्राणां तण्डुलानां वपुष्मताम् ।\nअयुतं तिलमुद्गानां प्रयात्वग्रे महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000626019, "chapter_id": 9626, "verse_number": "७-९१-२०", "content_sanskrit": "चणकानां कुलित्थानां माषाणां लवणस्य च ।\nअतो ऽनुरूपं स्नेहं च गन्धं सङ्क्षिप्तमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000626020, "chapter_id": 9626, "verse_number": "७-९१-२१", "content_sanskrit": "सुवर्णकोट्यो बहुला हिरण्यस्य शतोत्तराः ।\nअग्रतो भरतः कृत्वा गच्छत्वग्रे समाधिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000626021, "chapter_id": 9626, "verse_number": "७-९१-२२", "content_sanskrit": "अन्तरा पण्यवीथ्यश्च सर्वे च नटनर्तकाः ।\nसूदा नार्यश्च बहवो नित्यं यौवनशालिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000626022, "chapter_id": 9626, "verse_number": "७-९१-२३", "content_sanskrit": "भरतेन तु सार्धं ते यान्तु सैन्यानि चाग्रतः ।\nनैगमा बलवृद्धाश्च द्विजाश्च सुसमाहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000626023, "chapter_id": 9626, "verse_number": "७-९१-२४", "content_sanskrit": "कर्मान्तिकान्वर्धकिनः कोशाध्यक्षांश्च नैगमान् ।\nमम मातऽस्तथा सर्वाः कुमारान्तःपुराणि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000626024, "chapter_id": 9626, "verse_number": "७-९१-२५", "content_sanskrit": "काञ्चनीं मम पत्नीं च दीक्षायां ज्ञांश्च कर्मणि ।\nअग्रतो भरतः कृत्वा गच्छत्वग्रे महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000626025, "chapter_id": 9626, "verse_number": "७-९१-२६", "content_sanskrit": "उपकार्या महार्हाश्च पार्थिवानां महौजसाम् ।\nसानुगानां नरश्रेष्ठो व्यादिदेश महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000626026, "chapter_id": 9626, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे एकनवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]