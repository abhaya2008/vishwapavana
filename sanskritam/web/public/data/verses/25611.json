[{"id": 7005611000, "chapter_id": 25611, "verse_number": "८४-१", "content_sanskrit": "लवणाचलदानवर्णनम् ।\nईश्वर उवाच ।\nअथातः सम्प्रवक्ष्यामि लवणाचलमुत्तमम् ।\nयत्प्रदानान्नरोलोकानाप्नोति शिवसंयुतान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005611001, "chapter_id": 25611, "verse_number": "८४-२", "content_sanskrit": "उत्तमः षोडशद्रोणैः कर्त्तव्यो लवणाचलः ।\nमध्यमः स्यात्तदर्द्धेन चतुर्भिरधमः स्मृतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005611002, "chapter_id": 25611, "verse_number": "८४-३", "content_sanskrit": "वित्तहीनो यथाशक्त्या द्रोणादूद्‌र्ध्वन्तु कारयेत् ।\nचतुर्थांशेन विष्कम्भ पर्वतान्‌ कारयेत् पृथक् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005611003, "chapter_id": 25611, "verse_number": "८४-४", "content_sanskrit": "विधानं पूर्ववत्कुर्य्याद् ब्रह्मादीनाञ्च सर्वदा ।\nतद्वद् हेममयान् सर्व्वान् लोकपालान्निवेशयेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005611004, "chapter_id": 25611, "verse_number": "८४-५", "content_sanskrit": "सरांसि कामदेवादींस्तद्वदत्रापि कारयेत् ।\nकुर्य्याज्जागरणञ्चापि दानमन्त्रान्निबोधत ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005611005, "chapter_id": 25611, "verse_number": "८४-६", "content_sanskrit": "सौभाग्यसरसम्भूतो यतोऽयं लवणो रसः ।\nतद्दानकर्तृकत्वेन त्वं मां पाहि नगोत्तम ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005611006, "chapter_id": 25611, "verse_number": "८४-७", "content_sanskrit": "यस्मादन्नरसाः सर्वे नोत्कटालवणं विना ।\nप्रियञ्चशिवयोर्नित्यं तस्माच्छान्तिं प्रयच्छ मे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005611007, "chapter_id": 25611, "verse_number": "८४-८", "content_sanskrit": "विष्णुदेहसमुद्‌भूतं यस्मादारोग्यवर्द्धनम् ।\nतस्मात्पर्वतरूपेण पाहि संसारसागरात् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005611008, "chapter_id": 25611, "verse_number": "८४-९", "content_sanskrit": "अनेन विधिना यस्तु दद्याल्लवणपर्वतम् ।\nउमालोके वसेत्कल्पं ततो याति परां गतिम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]