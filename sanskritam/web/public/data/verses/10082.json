[{"id": 6000082000, "chapter_id": 10082, "verse_number": null, "content_sanskrit": "अथ अष्टादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000082001, "chapter_id": 10082, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.001.m4a", "display_order": 2}, {"id": 6000082002, "chapter_id": 10082, "verse_number": "४-१८-१", "content_sanskrit": "इत्थं पृथुमभिष्टूय रुषा प्रस्फुरिताधरम्।\nपुनराहावनिर्भीता संस्तभ्यात्मानमात्मना॥ ४/१८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.002.m4a", "display_order": 3, "topics": [{"text": "भूदेव्युक्तोपायेन पृथुराजप्रभृतिभिः वत्सपात्रादिभेदेन क्रमशः स्वस्वाभीष्टपदार्थानां धरित्र्या दोहनम्", "range": "१–१४"}]}, {"id": 6000082003, "chapter_id": 10082, "verse_number": "४-१८-२", "content_sanskrit": "सन्नियच्छ विभो मन्युं विबोध श्रावितं च मे।\nसर्वतः सारमादत्ते यथा मधुकरो बुधः॥ ४/१८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.003.m4a", "display_order": 4}, {"id": 6000082004, "chapter_id": 10082, "verse_number": "४-१८-३", "content_sanskrit": "अस्मिल्‍ँलोकेऽथवाऽमुष्मिन् मुनिभिस्तत्त्वदर्शिभिः।\nदृष्टा योगाः प्रयुक्ताश्च पुंसां श्रेयःप्रसिद्धये॥ ४/१८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.004.m4a", "display_order": 5}, {"id": 6000082005, "chapter_id": 10082, "verse_number": "४-१८-४", "content_sanskrit": "तानातिष्ठति यः सम्यगुपायान् पूर्वदर्शितान्।\nअपरः श्रद्धयोपेत उपायान् विन्दतेऽञ्जसा॥ ४/१८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.005.m4a", "display_order": 6}, {"id": 6000082006, "chapter_id": 10082, "verse_number": "४-१८-५", "content_sanskrit": "ताननादृत्य योऽविद्वान् अर्थानारभते स्वयम्।\nतस्य व्यभिचरन्त्यर्थाः प्रारब्धाश्च पुनः पुनः॥ ४/१८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.006.m4a", "display_order": 7}, {"id": 6000082007, "chapter_id": 10082, "verse_number": "४-१८-६", "content_sanskrit": "पुरा सृष्टाश्चौषधयो ब्राह्मणाय विशांपते।\nभुज्यमाना मया दृष्टा असद्भिरधृतव्रतैः॥ ४/१८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.007.m4a", "display_order": 8}, {"id": 6000082008, "chapter_id": 10082, "verse_number": "४-१८-७", "content_sanskrit": "अपालिता नादृतास्ता भवद्भिर्लोकपालकैः।\nचोरीभूतेऽथ लोकेऽहं यज्ञार्थेऽग्रसमौषधीः॥ ४/१८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.008.m4a", "display_order": 9}, {"id": 6000082009, "chapter_id": 10082, "verse_number": "४-१८-८", "content_sanskrit": "नूनं ता वीरुधः क्षीणा मयि कालेन भूयसा।\nशास्‍त्रदृष्टेन योगेन भवानादातुमर्हति॥ ४/१८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.009.m4a", "display_order": 10}, {"id": 6000082010, "chapter_id": 10082, "verse_number": "४-१८-९", "content_sanskrit": "वत्सं कल्पय मे वीर येनाहं वत्सला तव।\nधोक्ष्ये क्षीरमयान् कामाननुरूपं च दोहनम्॥ ४/१८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.010.m4a", "display_order": 11}, {"id": 6000082011, "chapter_id": 10082, "verse_number": "४-१८-१०", "content_sanskrit": "दोग्धारं च महाबाहो भूतानां भूतभावन।\nअन्नमीप्सितमोजस्वद् भगवान् वाञ्छते यदि॥ ४/१८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.011.m4a", "display_order": 12}, {"id": 6000082012, "chapter_id": 10082, "verse_number": "४-१८-११", "content_sanskrit": "समां च कुरु मां राजन् देववृष्टं यथा पयः।\nअपर्तावपि भद्रं ते उपावर्तेत मां विभो॥ ४/१८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.012.m4a", "display_order": 13}, {"id": 6000082013, "chapter_id": 10082, "verse_number": "४-१८-१२", "content_sanskrit": "इति प्रियहितं वाक्यं भुव आदाय भूपतिः।\nतथा चकार सर्वत्र सारमाददते बुधाः॥ ४/१८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.013.m4a", "display_order": 14}, {"id": 6000082014, "chapter_id": 10082, "verse_number": "४-१८-१३", "content_sanskrit": "वत्सं कृत्वा मनुं पाणावदुहत् सकलौषधीः।\nततोऽपरे यथाकामं दुदुहुः पृथुभाविताम्॥ ४/१८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.014.m4a", "display_order": 15}, {"id": 6000082015, "chapter_id": 10082, "verse_number": "४-१८-१४", "content_sanskrit": "ऋषयो दुदुहुर्देवीमिन्द्रियेष्वथ सत्तमाः।\nवत्सं बृहस्पतिं कृत्वा पयश्छन्दोमयं शुचि॥ ४/१८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.015.m4a", "display_order": 16}, {"id": 6000082016, "chapter_id": 10082, "verse_number": "४-१८-१५", "content_sanskrit": "कृत्वा वत्सं सुरगणा इन्द्रं सोममदूदुहन्।\nहिरण्मयेन पात्रेण वीर्यमोजो बलं पयः॥ ४/१८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.016.m4a", "display_order": 17, "topics": [{"text": "देवदानवगन्धर्वसिद्धादिभिः गोदोहनम्", "range": "१५–२७"}]}, {"id": 6000082017, "chapter_id": 10082, "verse_number": "४-१८-१६", "content_sanskrit": "दैतेया दानवा वत्सं प्रह्लादमसुरर्षभम्।\nविधाय दुदुहुः क्षीरमयःपात्रे सुरासवम्॥ ४/१८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.017.m4a", "display_order": 18}, {"id": 6000082018, "chapter_id": 10082, "verse_number": "४-१८-१७", "content_sanskrit": "गन्धर्वाप्सरसोऽधुक्षन् पात्रे पद्ममये पयः।\nवत्सं विश्वावसुं कृत्वा गान्धर्वं मधु सौभगम्॥ ४/१८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.018.m4a", "display_order": 19}, {"id": 6000082019, "chapter_id": 10082, "verse_number": "४-१८-१८", "content_sanskrit": "वत्सेन पितरोऽर्यम्णा कव्यं क्षीरमधुक्षत।\nआमपात्रे महाभाग श्रद्धया श्राद्धदेवताः॥ ४/१८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.019.m4a", "display_order": 20}, {"id": 6000082020, "chapter_id": 10082, "verse_number": "४-१८-१९", "content_sanskrit": "प्रकल्प्य वत्सं कपिलं सिद्धाः सङ्कल्पनामयीम्।\nसिद्धिं नभसि विद्यां च ये च विद्याधरादयः॥ ४/१८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.020.m4a", "display_order": 21}, {"id": 6000082021, "chapter_id": 10082, "verse_number": "४-१८-२०", "content_sanskrit": "अन्ये च मायिनो मायामन्तर्धानगतात्मना।\nमयं प्रकल्प्य वत्सत्वे दुदुहुर्धारणामयीम्॥ ४/१८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.021.m4a", "display_order": 22}, {"id": 6000082022, "chapter_id": 10082, "verse_number": "४-१८-२१", "content_sanskrit": "यक्षरक्षांसि भूतानि पिशाचाः पिशिताशनाः।\nभूतेशवत्सा दुदुहुः कपाले क्षतजासवम्॥ ४/१८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.022.m4a", "display_order": 23}, {"id": 6000082023, "chapter_id": 10082, "verse_number": "४-१८-२२", "content_sanskrit": "तथाऽहयो दन्दशूकाः सर्पा नागाश्च तक्षकम्।\nवत्सं विधाय दुदुहुर्बिलपात्रे विषं पयः॥ ४/१८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.023.m4a", "display_order": 24}, {"id": 6000082024, "chapter_id": 10082, "verse_number": "४-१८-२३", "content_sanskrit": "पशवो यवसं क्षीरं वत्सं कृत्वा च गोवृषम्।\nअरण्यपात्रे चाधुक्षन्, मृगेन्द्रेण च दंष्ट्रिणः॥ ४/१८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.024.m4a", "display_order": 25}, {"id": 6000082025, "chapter_id": 10082, "verse_number": "४-१८-२४", "content_sanskrit": "क्रव्यादाः प्राणिनः क्रव्यं दुदुहुः स्वकलेवरे।\nसुपर्णवत्सा विहगाश्चरं चाचरमेव च॥ ४/१८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.025.m4a", "display_order": 26}, {"id": 6000082026, "chapter_id": 10082, "verse_number": "४-१८-२५", "content_sanskrit": "वटवत्सा वनस्पतयः पृथग्रसमयं पयः।\nगिरयो हिमवद्वत्सा नानाधातून् स्वसानुषु॥ ४/१८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.026.m4a", "display_order": 27}, {"id": 6000082027, "chapter_id": 10082, "verse_number": "४-१८-२६", "content_sanskrit": "सर्वे स्वमुख्यवत्सेन स्वे स्वे पात्रे पृथक् पृथक्।\nसर्वकामदुघां पृथ्वीं दुदुहुः पृथुभाविताम्॥ ४/१८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.027.m4a", "display_order": 28}, {"id": 6000082028, "chapter_id": 10082, "verse_number": "४-१८-२७", "content_sanskrit": "एवं पृथ्वादयः पृथ्वीमदुहन् स्वन्नमात्मनः।\nदोहवत्सादिभेदेन क्षीरभेदं कुरूद्वह॥ ४/१८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.028.m4a", "display_order": 29}, {"id": 6000082029, "chapter_id": 10082, "verse_number": "४-१८-२८", "content_sanskrit": "ततो महीपतिः प्रीतः सर्वकामदुघां पुथुः।\nदुहितृत्वे चकारेमां प्रेम्णा दुहितृवत्सलः॥ ४/१८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.029.m4a", "display_order": 30, "topics": [{"text": "पृथुना पृथिवीनिर्माणकथनम्", "range": "२८–३२"}]}, {"id": 6000082030, "chapter_id": 10082, "verse_number": "४-१८-२९", "content_sanskrit": "चूर्णयन् स्वधनुःकोट्या गिरिकूटानि राजराट्।\nभूमण्डलमिदं वैन्यः प्रायश्चक्रे समं विभुः॥ ४/१८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.030.m4a", "display_order": 31}, {"id": 6000082031, "chapter_id": 10082, "verse_number": "४-१८-३०", "content_sanskrit": "अथास्मिन् भगवान् वैन्यः प्रजानां वृत्तिदः पिता।\nनिवासान् कल्पयाञ्चक्रे तत्र तत्र यथार्हतः॥ ४/१८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.031.m4a", "display_order": 32}, {"id": 6000082032, "chapter_id": 10082, "verse_number": "४-१८-३२", "content_sanskrit": "ग्रामान् पुरः पत्तनानि दुर्गाणि विविधानि च। घोषान् व्रजांश्च शिबिरान् नगरान् खेटखर्वटान् ३१\nप्राक् पृथोरिह नैवैषा पुरग्रामादिकल्पना। यथासुखं वसन्ति स्म तत्र तत्राकुतोभयाः॥ ४/१८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_018/BhP_04.018.032.m4a", "display_order": 33}, {"id": 6000082033, "chapter_id": 10082, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे अष्टादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]