[{"id": 2056685, "chapter_id": 2231, "verse_number": "७-१५८-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2056686, "chapter_id": 2231, "verse_number": "७-१५८-१", "content_sanskrit": "द्रुपदस्यात्मजान्दृष्ट्वा कुन्तिभोजसुतांस्तथा।\nद्रोणपुत्रेण निहतान्राक्षसांश्च सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2056687, "chapter_id": 2231, "verse_number": "७-१५८-२", "content_sanskrit": "युधिष्ठिरो भीमसेनो धृष्टद्युम्नश्च पार्षतः।\nयुयुधानश्च संयत्ता युद्धायैव मनो दधुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2056688, "chapter_id": 2231, "verse_number": "७-१५८-३", "content_sanskrit": "सोमदत्तः पुनः क्रुद्धो दृष्ट्वा सात्यकिमाहवे।\nमहता शरवर्षेण च्छादयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2056689, "chapter_id": 2231, "verse_number": "७-१५८-४", "content_sanskrit": "ततः समभवद्युद्धमतीव भयवर्धनम्।\nत्वदीयानां परेषां च घोरं विजयकाङ्क्षिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2056690, "chapter_id": 2231, "verse_number": "७-१५८-५", "content_sanskrit": "तं दृष्ट्वा समुपायान्तं रुक्मपुङ्खैः शिलाशितैः।\nदशभिः सात्वतस्यार्थे भीमो विव्याध सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2056691, "chapter_id": 2231, "verse_number": "७-१५८-६", "content_sanskrit": "सोमदत्तोऽपि तं वीरं शतेन प्रत्यविध्यत।\nसात्वतस्त्वभिसंक्रुद्धः पुत्राधिभिरभिप्लुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2056692, "chapter_id": 2231, "verse_number": "७-१५८-७", "content_sanskrit": "वृद्धं वृद्धगुणैर्युक्तं ययातिमिव नाहुषम्।\nविव्याध दशभिस्तीक्ष्णैः शरैर्वज्रनिपातनैः।\nशक्त्या चैनं विनिर्भिद्य पुनर्विव्याध सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2056693, "chapter_id": 2231, "verse_number": "७-१५८-८", "content_sanskrit": "ततस्तु सात्यकेरर्थे भीमसेनो नवं दृढम्।\nमुमोच परिघं घोरं सोमदत्तस्य मूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2056694, "chapter_id": 2231, "verse_number": "७-१५८-९", "content_sanskrit": "सात्वतोऽप्यग्निसङ्काशं मुमोच शरमुत्तमम्।\nसोमदत्तोरसि क्रुद्धः सुपत्रं निशितं युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2056695, "chapter_id": 2231, "verse_number": "७-१५८-१०", "content_sanskrit": "युगपत्पेततुर्वीर घोरौ परिघमार्गणौ।\nशरीरे सोमदत्तस्य स पपात महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2056696, "chapter_id": 2231, "verse_number": "७-१५८-११", "content_sanskrit": "व्यामोहिते तुनये बाह्लीकस्तमुपाद्रवत्।\nविसृजञ्छरवर्षाणि कालवर्षीव तोयदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2056697, "chapter_id": 2231, "verse_number": "७-१५८-१२", "content_sanskrit": "भीमोऽथ सात्वतस्यार्थे बाह्लीकं नवभिः शरैः।\nप्रातिपेयं महात्मानं विव्याध रणमूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2056698, "chapter_id": 2231, "verse_number": "७-१५८-१३", "content_sanskrit": "प्रातिपेयस्तु सङ्क्रुद्धः शक्तिं भीमस्य वक्षसि।\nनिचखान महाबाहुः पुरन्दर इवाशनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2056699, "chapter_id": 2231, "verse_number": "७-१५८-१४", "content_sanskrit": "स तथाऽभिहतो भीमश्चकम्पे च मुमोह च।\nप्राप्य चेतश्च बलवान्गदामस्मै ससर्ज ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2056700, "chapter_id": 2231, "verse_number": "७-१५८-१५", "content_sanskrit": "सा पाण्डवेन प्रहिता बाह्लीकस्य शिरोऽहरत्।\nस पपात हतः पृथ्व्यां वज्राहत इवाद्रिराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2056701, "chapter_id": 2231, "verse_number": "७-१५८-१६", "content_sanskrit": "तस्मिन्विनिहते वीरे बाह्लीके पुरुषर्षभ।\nपुत्रास्तेऽभ्यर्दयन्भीमं दश दाशरथेः समाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2056702, "chapter_id": 2231, "verse_number": "७-१५८-१७", "content_sanskrit": "नागदत्तो दृढरथो महाबाहुरयोभुजः।\nदृढः सुहस्तो विरजाः प्रमाथ्युग्रोऽनुयाय्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2056703, "chapter_id": 2231, "verse_number": "७-१५८-१८", "content_sanskrit": "तान्दृष्ट्वा चुक्रुधे भीमो जगृहे भारसाधनान्।\nएकमेकं समुद्दिश्य पातयामास मर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2056704, "chapter_id": 2231, "verse_number": "७-१५८-१९", "content_sanskrit": "ते विद्धा व्यसवः पेतुः स्यन्दनेभ्यो हतौजसः।\nचण्डवातप्रभग्नास्तु पर्वताग्रान्महीरुहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2056705, "chapter_id": 2231, "verse_number": "७-१५८-२०", "content_sanskrit": "नाराचैर्दशभिर्भीमस्तान्निहत्य तवात्मजान्।\nकर्णस्य दयितं पुत्रं वृषसेनमवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2056706, "chapter_id": 2231, "verse_number": "७-१५८-२१", "content_sanskrit": "ततो वृकरथो नाम भ्राता कर्णस्य विश्रुतः।\nजघान भीमं नाराचैस्तमप्यभ्यद्रवद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2056707, "chapter_id": 2231, "verse_number": "७-१५८-२२", "content_sanskrit": "ततः सप्तरथान्वीरः श्यालानां तव भारत।\nनिहत्य भीमो नाराचैः शतचन्द्रमपोथयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2056708, "chapter_id": 2231, "verse_number": "७-१५८-२३", "content_sanskrit": "अमर्षयन्तो निहतं शतचन्द्रं महारथम्।\nशकुनेर्भ्रातरो वीरा गवाक्षः शरभो विभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2056709, "chapter_id": 2231, "verse_number": "७-१५८-२४", "content_sanskrit": "सुभगो भानुदत्तश्च शूराः पञ्च महारथाः।\nअभिद्रुत्य शरैस्तीक्ष्णैर्भीमसेनमताडयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2056710, "chapter_id": 2231, "verse_number": "७-१५८-२५", "content_sanskrit": "स ताड्यमानो नाराचैर्वृष्टिवेगैरिवाचलः।\nजघान पञ्चभिर्बाणैः पञ्चैवातिरथान्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2056711, "chapter_id": 2231, "verse_number": "७-१५८-२६", "content_sanskrit": "तान्दृष्ट्वा निहतान्वीरान्विचेलुर्नृपसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2056712, "chapter_id": 2231, "verse_number": "७-१५८-२७", "content_sanskrit": "ततो युधिष्ठिरः क्रुद्धस्तवानीकमशातयत्॥\nमिषतः कुम्भयोनेस्तु पुत्राणां तव चानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2056713, "chapter_id": 2231, "verse_number": "७-१५८-२८", "content_sanskrit": "अम्बष्ठान्मालवाञ्छूरांस्त्रिगर्तान्सशिबीनपि।\nप्राहिणोन्मृत्युलोकाय क्रुद्धो युद्धे युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2056714, "chapter_id": 2231, "verse_number": "७-१५८-२९", "content_sanskrit": "अभीषाहाञ्छूरसेनान्बाह्लीकान्सवसातिकान्।\nनिहत्य पृथिवीं राजा चक्रे शोणितकर्दमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2056715, "chapter_id": 2231, "verse_number": "७-१५८-३०", "content_sanskrit": "यौधेयान्मालवान्राजन्मद्रकाणां गणान्युधि।\nप्राहिणोन्मृत्युलोकाय शूरान्बाणैर्युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2056716, "chapter_id": 2231, "verse_number": "७-१५८-३१", "content_sanskrit": "हताहरत गृह्णीत विध्यत व्यवकृन्तत।\nइत्यासीत्तुमुलः शब्दो युधिष्ठिररथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2056717, "chapter_id": 2231, "verse_number": "७-१५८-३२", "content_sanskrit": "सैन्यानि द्रावयन्तं तं द्रोणो दृष्ट्वा युधिष्ठिरम्।\nचोदितस्तव पुत्रेण सायकैरभ्यवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2056718, "chapter_id": 2231, "verse_number": "७-१५८-३३", "content_sanskrit": "द्रोणस्तु परमक्रुद्धो वायव्यास्त्रेण पार्थिवम्।\nविव्याध सोऽपि तद्दिव्यमस्त्रमस्त्रेण जघ्निवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2056719, "chapter_id": 2231, "verse_number": "७-१५८-३४", "content_sanskrit": "तस्मिन्विनिहते चास्त्रे भारद्वाजो युधिष्ठिरे।\nवारुणं याम्यमाग्नेयं त्वाष्ट्रं सावित्रमेव च।\nचिक्षेप परमक्रुद्धो जिघांसुः पाण्डुनन्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2056720, "chapter_id": 2231, "verse_number": "७-१५८-३५", "content_sanskrit": "क्षिप्तानि क्षिप्यमाणानि तानि चास्त्राणि धर्मजः।\nजघानास्त्रैर्महाबाहुः कुम्भयोनेरवित्रसन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2056721, "chapter_id": 2231, "verse_number": "७-१५८-३६", "content_sanskrit": "सत्यां चिकीर्षमाणस्तु प्रतिज्ञां कुम्भसम्भवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2056722, "chapter_id": 2231, "verse_number": "७-१५८-३७", "content_sanskrit": "प्रादुश्चक्रेऽस्त्रमैन्द्रं वै प्राजापत्यं च भारत।\nजिघांसुर्धर्मतनयं तव पुत्रहिते रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2056723, "chapter_id": 2231, "verse_number": "७-१५८-३८", "content_sanskrit": "पतिः कुरूणां गजसिंहगामी\nविशालवक्षाः पृथुलोहिताक्षः।\nप्रादुश्चकारास्त्रमहीनतेजा\nमाहेन्द्रमस्त्रं स जघान तेन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2056724, "chapter_id": 2231, "verse_number": "७-१५८-३९", "content_sanskrit": "विहन्यमानेष्वस्त्रेषु द्रोणः क्रोधसमन्वितः।\nयुधिष्ठिरवधं प्रेप्सुर्ब्राह्ममस्त्रमुदैरयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2056725, "chapter_id": 2231, "verse_number": "७-१५८-४०", "content_sanskrit": "ततो नाज्ञासिषं किञ्चिद्धोरेण तमसाऽऽवृते।\nसर्वभूतानि च परं त्रासं जग्मुर्महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2056726, "chapter_id": 2231, "verse_number": "७-१५८-४१", "content_sanskrit": "ब्रह्मास्त्रमुद्यतं दृष्ट्वा कुन्तीपुत्रो युधिष्ठिरः।\nब्रह्मास्त्रेणैव राजेन्द्र तदस्त्रं प्रत्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2056727, "chapter_id": 2231, "verse_number": "७-१५८-४२", "content_sanskrit": "ततः सैनिकमुख्यास्ते प्रशशंसुर्नरर्षभौ।\nद्रोणपार्थौ महेष्वासौ सर्वयुद्धविशारदौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2056728, "chapter_id": 2231, "verse_number": "७-१५८-४३", "content_sanskrit": "ततः प्रमुच्य कौन्तेयं द्रोणो द्रुपदवाहिनीम्।\nव्यधमत्क्रोधताम्राक्षो वायव्यास्त्रेण भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2056729, "chapter_id": 2231, "verse_number": "७-१५८-४४", "content_sanskrit": "ते हन्यमाना द्रोणेन पाञ्चालाः प्राद्रवन्भयात्।\nपश्यतो भीमसेनस्य पार्थस्य च महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2056730, "chapter_id": 2231, "verse_number": "७-१५८-४५", "content_sanskrit": "ततः किरीटी भीमश्च सहसा सन्न्यवर्तताम्।\nमहद्ध्यां रथवंशाभ्यां परिगृह्य बलं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2056731, "chapter_id": 2231, "verse_number": "७-१५८-४६", "content_sanskrit": "बीभत्सुर्दक्षिणं पार्श्वमुत्तरं च वृकोदरः।\nभारद्वाजं शरौघाभ्यां महद्भ्यामभ्यवर्षताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2056732, "chapter_id": 2231, "verse_number": "७-१५८-४७", "content_sanskrit": "केकयाः सृञ्जयाश्चैव पाञ्चालाश्च महौजसः।\nअन्वगच्छन्महाराज मात्स्याश्च सह सात्वतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2056733, "chapter_id": 2231, "verse_number": "७-१५८-४८", "content_sanskrit": "ततः सा भारती सेना वध्यमाना किरीटिना।\nतमसा निद्रया चैव पुनरेव व्यदीर्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2056734, "chapter_id": 2231, "verse_number": "७-१५८-४९", "content_sanskrit": "द्रोणेन वार्यमाणास्ते स्वयं तव सुतेन च।\nनाशक्यन्त महाराज योधा वारयितुं तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2056735, "chapter_id": 2231, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि घटोत्कचवधपर्वणि चतुर्दशरात्रियुद्धे अष्टपञ्चाशदधिकशततमोऽध्यायः॥ १५८ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१५८-१२ प्रातिपेयं प्रतीपपुत्रम्॥ ५-१५८-३८ पतिः कुरूणां युधिष्ठिरः। माहेन्द्रमन्यत्स जघानेति झ.पाठः॥ ५-१५८-१५८ अष्टपञ्चाशदधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]