[{"id": 900009562, "chapter_id": 8750, "verse_number": "2.1", "content_sanskrit": "महत्सु गुणसारेषु दोषान्वेषणधीर्मुधा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009563, "chapter_id": 8750, "verse_number": "2.2", "content_sanskrit": "इदं रूप्यं रूप्यताऽत्रेत्येवं वा भ्रमविग्रहः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009564, "chapter_id": 8750, "verse_number": "2.3", "content_sanskrit": "नाज्ञानमन्यधर्मोऽयं ब्रह्माज्ञानैकवादिनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009565, "chapter_id": 8750, "verse_number": "2.4", "content_sanskrit": "दोषाभावाच्च नाज्ञानभ्रान्तिर्युक्ता मते तव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009566, "chapter_id": 8750, "verse_number": "2.5", "content_sanskrit": "सत्याज्ञानभवं विश्वमसत्यं केन हेतुना", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900009567, "chapter_id": 8750, "verse_number": "2.6", "content_sanskrit": "किं चाज्ञानस्य विज्ञानमहमित्येव देहिनाम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900009568, "chapter_id": 8750, "verse_number": "2.7", "content_sanskrit": "जीवो ह्यज्ञानकल्प्यस्ते सोऽज्ञानस्य कथं मही", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900009569, "chapter_id": 8750, "verse_number": "2.8", "content_sanskrit": "एकाज्ञानेऽपि सर्वोऽज्ञस्स्यादैक्यबलतो न चेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900009570, "chapter_id": 8750, "verse_number": "2.9", "content_sanskrit": "सम्पूर्णस्वसुखज्ञाने संसारो मुक्तिरेव ते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900009571, "chapter_id": 8750, "verse_number": "2.10", "content_sanskrit": "परासिनाऽतिक्रूरेण या ह्यविद्या क्षतापि न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900009572, "chapter_id": 8750, "verse_number": "2.11", "content_sanskrit": "सिद्धं पश्यति चेद्ब्रह्म जगन्न भ्रमजं तव ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900009573, "chapter_id": 8750, "verse_number": "2.12", "content_sanskrit": "मायां तु प्रकृतिं विन्द्यान्मायिनं तु महेश्वरम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900009574, "chapter_id": 8750, "verse_number": "2.13", "content_sanskrit": "किञ्च सार्वज्ञमज्ञानसापेक्षमिति यद्वचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900009575, "chapter_id": 8750, "verse_number": "2.14", "content_sanskrit": "अतो ब्रह्माश्रिताज्ञानपक्षो निर्मूल एव ते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900009576, "chapter_id": 8750, "verse_number": "2.15", "content_sanskrit": "विषयाश्रितमज्ञानं यद्यावरणमिष्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900009577, "chapter_id": 8750, "verse_number": "2.16", "content_sanskrit": "चक्षुषा सन्निकृष्टार्थज्ञानं स्यादन्तरेव हि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900009578, "chapter_id": 8750, "verse_number": "2.17", "content_sanskrit": "मृदादिकमुपादानं कार्ये कार्ये च विद्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900009579, "chapter_id": 8750, "verse_number": "2.18", "content_sanskrit": "मामहं न विजानामि मां जानाम्यहमित्यपि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900009580, "chapter_id": 8750, "verse_number": "2.19", "content_sanskrit": "नित्यशुद्धं तु यद्ब्रह्म परब्रह्म तदेव हि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900009581, "chapter_id": 8750, "verse_number": "2.20", "content_sanskrit": "सत्वं रजस्तम इति गुणा जीवस्य नैव मे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900009582, "chapter_id": 8750, "verse_number": "2.21", "content_sanskrit": "किं चेदं शबलत्वं ते किं मायाशबलत्वतः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900009583, "chapter_id": 8750, "verse_number": "2.22", "content_sanskrit": "पक्षोऽन्यस्तु सभामध्ये हास्याय स्यात्परं नृणां", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900009584, "chapter_id": 8750, "verse_number": "2.23", "content_sanskrit": "यदा हि रूपनिष्पत्तिर्मुक्तौ जीवस्य जायते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900009585, "chapter_id": 8750, "verse_number": "2.24", "content_sanskrit": "अस्त्यस्तितोक्तौ नास्तीति प्रतिवागतिवादिनि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]