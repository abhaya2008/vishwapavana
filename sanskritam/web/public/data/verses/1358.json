[{"id": 2017199, "chapter_id": 1358, "verse_number": "२-९९-१", "content_sanskrit": "वैशम्पायन उवाच॥\nततः पराजिताः पार्था वनावासाय दीक्षिताः।\nअजिनान्युत्तरीयाणि जगृहुश्च यथाक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2017200, "chapter_id": 1358, "verse_number": "२-९९-२", "content_sanskrit": "अजिनैः संवृतान्दृष्ट्वा हृतराज्यानरिन्दमान्।\nप्रस्थितान्वनवासाय ततो दुःशासनोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2017201, "chapter_id": 1358, "verse_number": "२-९९-३", "content_sanskrit": "प्रवृत्तं धार्तराष्ट्रस्य चक्रं राज्ञो महात्मनः।\nपराजिताः पाण्डवेया विपत्तिं परमां गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2017202, "chapter_id": 1358, "verse_number": "२-९९-४", "content_sanskrit": "अद्य देवाः सम्प्रयाताः समैर्वर्त्मभिरस्थलैः।\nगुणज्येष्ठास्तथा श्रेष्ठाः श्रेयांसो यद्वयं परैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2017203, "chapter_id": 1358, "verse_number": "२-९९-५", "content_sanskrit": "नरकं पातिताः पार्था दीर्घकालमनन्तकम्।\nमुखाच्च हीना राज्याच्च विनष्टाः शाश्वतीः समाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2017204, "chapter_id": 1358, "verse_number": "२-९९-६", "content_sanskrit": "धनेन मत्ता ये ते स्म धार्तराष्ट्रान्प्रहासिषुः।\nते निर्जिता हृतधना वनमेष्यन्ति पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2017205, "chapter_id": 1358, "verse_number": "२-९९-७", "content_sanskrit": "चित्रान्सन्नाहानवमुञ्चन्तु चैषां\nवासांसि दिव्यानि च भानुमन्ति॥\nविवास्यन्तां रुरुचर्माणि सर्वे\nयथा ग्लहं सौबलस्याभ्युपेताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2017206, "chapter_id": 1358, "verse_number": "२-९९-८", "content_sanskrit": "न सन्ति लोकेषु पुमांस ईदृशा\nइत्येव ये भावितबुद्धयः सदा।\nज्ञास्यन्ति तेत्मानमिमेऽद्य पाण्डवा\nविपर्यये पाण्ढतिला इवाफलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2017207, "chapter_id": 1358, "verse_number": "२-९९-९", "content_sanskrit": "इदं हि वासो यदि वेदृशानां\nमनस्विनां रौरवमाहवेषु॥\nआदीक्षितानामजिनानि यद्व-\nद्वलीयसां पश्यत पाण्डवानाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2017208, "chapter_id": 1358, "verse_number": "२-९९-१०", "content_sanskrit": "महाप्राज्ञः सौमकिर्यज्ञसेनः\nकन्यां पाञ्चालीं पाण्डवेभ्यः प्रदाय।\nअकार्षिद्वै सुकृतं नेह किञ्चित्\nक्लीबाः पार्थाः पतयो याज्ञसेन्याः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2017209, "chapter_id": 1358, "verse_number": "२-९९-११", "content_sanskrit": "सूक्ष्मप्रावारानजिनोत्तरीयान्\nदृष्ट्वाऽरण्ये निर्धनानप्रतिष्ठान्।\nकां त्वं प्रीतिं लप्स्यसे याज्ञसेनि\nपतिं वृणीष्वेह यमन्यमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2017210, "chapter_id": 1358, "verse_number": "२-९९-१२", "content_sanskrit": "एते हि सर्वे कुरवः समेताः\nक्षान्ता दान्ताः सुद्रविणोपपन्नाः।\nएषां वृणीष्वैकतमं पतित्वे\nन त्वां नयेत्कालविपर्ययोऽयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2017211, "chapter_id": 1358, "verse_number": "२-९९-१३", "content_sanskrit": "यथाऽफलाः षण्ढतिला यथा चर्ममया मृगाः।\nतथैव पाण्डवाः सर्वे यथा काकयवा अपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2017212, "chapter_id": 1358, "verse_number": "२-९९-१४", "content_sanskrit": "किं पाण्डवांस्ते पतितानुपास्य\nमोघः श्रमः षण्ढतिलानुपास्य।\nएवं नृशंसः परुषाणि पार्था-\nनश्रावयद्धृतराष्ट्रस्य पुत्रः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2017213, "chapter_id": 1358, "verse_number": "२-९९-१५", "content_sanskrit": "तद्वै श्रुत्वा भीमसेनोऽत्यमर्षी\nनिर्भर्त्स्योच्चैः सन्निगृह्यैव रोषात्।\nउवाच चैनं सहसैवोपगम्य\nसिंहो यथा हैमवतः शृगालम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2017214, "chapter_id": 1358, "verse_number": "२-९९-१६x", "content_sanskrit": "भीमसेन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2017215, "chapter_id": 1358, "verse_number": "२-९९-१६", "content_sanskrit": "क्रूर पापजनैर्जुष्टमकृतार्थं प्रभाषसे।\nगान्धारविद्यया हि त्वं राजमध्ये विकत्थसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2017216, "chapter_id": 1358, "verse_number": "२-९९-१७", "content_sanskrit": "यथा तुदसि मर्माणि वाक्छरैरिह नो भृशम्।\nतथा स्मारयिता तेऽहं कृन्तन्मर्माणि संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2017217, "chapter_id": 1358, "verse_number": "२-९९-१८", "content_sanskrit": "ये च त्वामनुवर्तन्ते क्रोधलोभवशानुगाः।\nगोप्तारः सानुबन्धांस्तान्नेताऽस्मि यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2017218, "chapter_id": 1358, "verse_number": "२-९९-१९x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2017219, "chapter_id": 1358, "verse_number": "२-९९-१९", "content_sanskrit": "एवं ब्रुवाणमजिनैर्विवासितं\nदुःशासनस्तं परिनृत्यति स्म।\nमध्ये कुरूणां धर्मनिबद्धमार्गं\nगौर्गौरिति स्माह्वयन्मुक्तलज्जः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2017220, "chapter_id": 1358, "verse_number": "२-९९-२०x", "content_sanskrit": "भीमसेन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2017221, "chapter_id": 1358, "verse_number": "२-९९-२०", "content_sanskrit": "नृशंस परुषं वक्तुं दुःशासन त्वया।\nनिकृत्या हि धनं लब्ध्वा को विकत्थितुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2017222, "chapter_id": 1358, "verse_number": "२-९९-२१", "content_sanskrit": "मैव स्म सुकृतां लोकान्गच्छेत्पार्थो वृकोदरः।\nयदि वक्षो हि ते भित्त्वा न पिबेच्छोणितं रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2017223, "chapter_id": 1358, "verse_number": "२-९९-२२", "content_sanskrit": "धार्तराष्ट्रान्रणे हत्त्वा मिषतां सर्वधन्विनाम्।\nशमं गन्ताऽस्मि नचिरात्सत्यमेतद्ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2017224, "chapter_id": 1358, "verse_number": "२-९९-२३x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2017225, "chapter_id": 1358, "verse_number": "२-९९-२३", "content_sanskrit": "तस्य राजा सिंहगतेः सखेलं\nदुर्योधनो भीमसेनस्य हर्षात्।\nगतिं स्वगत्याऽनुचकार मन्दो\nनिर्गच्छतां पाण्डवानां सभायाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2017226, "chapter_id": 1358, "verse_number": "२-९९-२४", "content_sanskrit": "नैतावता कृतमित्यब्रवीत्तं\nवृकोदरः सन्निवृत्तार्धकायः।\nशीघ्रं हि त्वां निहतं सानुबन्धं\nसंस्मार्याहं प्रतिवक्ष्यामि मूढ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2017227, "chapter_id": 1358, "verse_number": "२-९९-२५", "content_sanskrit": "एवं समीक्ष्यात्मनि चावमानं\nनियम्य मन्युं बलवान्स मानी।\nराजानुगः संसदि कौरवाणां\nविनिष्कामन्वाक्यमुवाच भीमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2017228, "chapter_id": 1358, "verse_number": "२-९९-२६", "content_sanskrit": "अहं दुर्योधनं हन्ता कर्णं हन्ता धनञ्जयः।\nशकुनिं चाक्षकितवं सहदेवो हनिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2017229, "chapter_id": 1358, "verse_number": "२-९९-२७", "content_sanskrit": "इदं च भूयो वक्ष्यामि सभामध्ये बृहद्वचः।\nसत्यं देवाः करिष्यन्ति यन्नो युद्धं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2017230, "chapter_id": 1358, "verse_number": "२-९९-२८", "content_sanskrit": "सुयोधनमिमं पापं हन्ताऽस्मि गदया युधि।\nशिरः पादेन चास्याहमधिष्ठास्यामि भूतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2017231, "chapter_id": 1358, "verse_number": "२-९९-२९", "content_sanskrit": "वाक्यशूरस्य चैवास्य परुषस्य दुरात्मनः।\nदुःशासनस्य रुधिरं पाताऽस्मि मृगराडिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2017232, "chapter_id": 1358, "verse_number": "२-९९-३०x", "content_sanskrit": "अर्जुन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2017233, "chapter_id": 1358, "verse_number": "२-९९-३०", "content_sanskrit": "भीमसेन न ते सन्ति येषां वैरं त्वया त्विह।\nमत्ता मृगेषु सुखिनो न बुद्ध्यन्ते महद्भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2017234, "chapter_id": 1358, "verse_number": "२-९९-३१", "content_sanskrit": "नैवं वाचा व्यवसितं भीम विज्ञायते सताम्।\nइतश्चतुर्दशे वर्षे द्रष्टारो यद्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2017235, "chapter_id": 1358, "verse_number": "२-९९-३२x", "content_sanskrit": "भीमसेन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2017236, "chapter_id": 1358, "verse_number": "२-९९-३२", "content_sanskrit": "दुर्योधनस्य कर्णस्य शकुनेश्च दुरात्मनः।\nदुःशासनचतुर्थानां भूमिः पास्यति शोणितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2017237, "chapter_id": 1358, "verse_number": "२-९९-३३x", "content_sanskrit": "अर्जुन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2017238, "chapter_id": 1358, "verse_number": "२-९९-३३", "content_sanskrit": "असूयितारं द्रष्टारं प्रवक्तारं विकत्थनम्।\nभीमसेन नियोगात्ते हन्ताहं कर्णमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2017239, "chapter_id": 1358, "verse_number": "२-९९-३४", "content_sanskrit": "अर्जुनः प्रतिजानीते भीमस्य प्रियकाम्यया।\nकर्णं कर्णानुगांश्चैव रणे हन्ताऽस्मि पत्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2017240, "chapter_id": 1358, "verse_number": "२-९९-३५", "content_sanskrit": "ये चान्ये प्रतियोत्स्यन्ति बुद्धिमोहेन मां नृपाः।\nतांश्च सर्वानहं बाणैर्नेताऽस्मि यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2017241, "chapter_id": 1358, "verse_number": "२-९९-३६", "content_sanskrit": "चलेद्वि हिमवान्स्थानान्निष्प्रभः स्याद्दिवाकरः।\nशैत्यं सोमात्प्रणश्येत मत्सत्यं विचलेद्यदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2017242, "chapter_id": 1358, "verse_number": "२-९९-३७", "content_sanskrit": "न प्रदास्यति चेद्राज्यमितो वर्षे चतुर्दशे।\nदुर्योधनोऽभिसत्कृत्य सत्यमेतद्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2017243, "chapter_id": 1358, "verse_number": "२-९९-३८x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2017244, "chapter_id": 1358, "verse_number": "२-९९-३८", "content_sanskrit": "इत्युक्तवति पार्थे तु श्रीमान्माद्रवतीसुतः।\nप्रगृह्य विपुलं बाहुं सहदेवः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2017245, "chapter_id": 1358, "verse_number": "२-९९-३९", "content_sanskrit": "सौबलस्य वधं प्रेप्सुरिदं वचनमब्रवीत्।\nक्रोधसंरक्तनयनो निः श्वसन्निव पन्नगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2017246, "chapter_id": 1358, "verse_number": "२-९९-४०x", "content_sanskrit": "सहदेव उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2017247, "chapter_id": 1358, "verse_number": "२-९९-४०", "content_sanskrit": "अक्षान्यान्मन्यसे मूढ गान्धाराणां यशोहर।\nनैतेऽक्षा निशिता बाणास्त्वयैते समरे वृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2017248, "chapter_id": 1358, "verse_number": "२-९९-४१", "content_sanskrit": "यथा चैवोक्तवान्भीमस्त्वामुद्दिश्य सबान्धवम्।\nकर्ताहं कर्मणस्तस्य कुरु कार्याणि सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2017249, "chapter_id": 1358, "verse_number": "२-९९-४२", "content_sanskrit": "हन्ताऽस्मि तरसा युद्धे त्वामेवहे सबान्धवम्।\nयदि स्थास्यसि सङ्ग्रामे क्षत्रधर्मेण सौबल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2017250, "chapter_id": 1358, "verse_number": "२-९९-४३", "content_sanskrit": "सहदेववचः श्रुत्वा नकुलोऽपि विशाम्पते।\nदर्शनीयतमो नॄणामिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2017251, "chapter_id": 1358, "verse_number": "२-९९-४४", "content_sanskrit": "सुतेयं यज्ञसेनस्य द्यूतेऽस्मिन्धृतराष्ट्रजैः।\nयैर्वाचः श्राविता रूक्षाः स्थितैर्दुर्योधनप्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2017252, "chapter_id": 1358, "verse_number": "२-९९-४५", "content_sanskrit": "तान्धार्तराष्ट्रान्दुर्वृत्तान्मुमूर्षून्कालनोदितान्।\nगमयिष्यामि भूयिष्ठानहं वैवस्वतक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2017253, "chapter_id": 1358, "verse_number": "२-९९-४६", "content_sanskrit": "उलूकं च दुरात्मानं सौबलस्य सुतं प्रियम्।\nक्रूरं हन्ताऽस्मि समरे तं वै क्रूरं नराधमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2017254, "chapter_id": 1358, "verse_number": "२-९९-४७", "content_sanskrit": "निदेशाद्धर्मराजस्य द्रौपद्याः पदवीं चरन्।\nनिर्धार्तराष्ट्रां पृथिवीं कर्ताऽस्मि नचिरादिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2017255, "chapter_id": 1358, "verse_number": "२-९९-४८x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2017256, "chapter_id": 1358, "verse_number": "२-९९-४८", "content_sanskrit": "एवं ते पुरुषव्याघ्राः सर्वे व्यायतबाहवः।\nप्रतिज्ञा बहुलाः कृत्वा धृतराष्ट्रमुपागमन्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2017257, "chapter_id": 1358, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अनुद्यूतपर्वणि एकोनशततमोऽध्यायः॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]