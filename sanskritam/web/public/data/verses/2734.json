[{"id": 2081876, "chapter_id": 2734, "verse_number": "१२-२३९-०x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2081877, "chapter_id": 2734, "verse_number": "१२-२३९-१", "content_sanskrit": "प्रत्याहारं तु वक्ष्यामि शर्वर्यादौ गतेऽहनि।\nयथेदं कुरुतेऽध्यात्मं सुसूक्ष्मं विश्वमीश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2081878, "chapter_id": 2734, "verse_number": "१२-२३९-२", "content_sanskrit": "दिवि सूर्यस्तथा सप्त दहन्ति शिखिनोऽर्चिषः।\nसर्वमेतत्तदाऽर्चिर्भिः पूर्णं जाज्वल्यते जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2081879, "chapter_id": 2734, "verse_number": "१२-२३९-३", "content_sanskrit": "पृथिव्यां यानि भूतानि जङ्गमानि ध्रुवाणि च।\nतान्येवाग्रे प्रलीयन्ते भूमित्वमुपयान्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2081880, "chapter_id": 2734, "verse_number": "१२-२३९-४", "content_sanskrit": "ततः प्रलीने सर्वास्मिन्स्थावरे जङ्गमे तथा।\nअकाष्ठा निस्तृणा भूमिर्दृश्यते कूर्मपृष्ठवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2081881, "chapter_id": 2734, "verse_number": "१२-२३९-५", "content_sanskrit": "भूमेरपि गुणं गन्धमाप आददते यदा।\nआत्तगन्धा तदा भूमिः प्रलयत्वाय कल्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2081882, "chapter_id": 2734, "verse_number": "१२-२३९-६", "content_sanskrit": "आपस्तत्र प्रतिष्ठन्ते ऊर्मिमत्यो महास्वनाः।\nसर्वमेवेदमापूर्य तिष्ठन्ति च चरन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2081883, "chapter_id": 2734, "verse_number": "१२-२३९-७", "content_sanskrit": "अपामपि गुणांस्तात ज्योतिराददते यदा।\nआपस्तदा त्वात्तगुणा ज्योतिः षूपरमन्ति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2081884, "chapter_id": 2734, "verse_number": "१२-२३९-८", "content_sanskrit": "यदाऽऽदित्यं स्थितं मध्ये गूहन्ति शिखिनोऽर्चिषः।\nसर्वमेवेदमर्चिर्भिः पूर्णं जाज्वल्यते नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2081885, "chapter_id": 2734, "verse_number": "१२-२३९-९", "content_sanskrit": "ज्योतिषोऽपि गुणं रूपं वायुराददते यदा।\nप्रशाम्यति ततो ज्योतिर्वायुर्दोधूयते महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2081886, "chapter_id": 2734, "verse_number": "१२-२३९-१०", "content_sanskrit": "ततस्तु मूलमासाद्य वायुः संभवमात्मनः।\nअधश्चोर्ध्वं च तिर्यक्च दोधवीति दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2081887, "chapter_id": 2734, "verse_number": "१२-२३९-११", "content_sanskrit": "वायोरपि गुणं स्पर्शमाकाशं ग्रसते यदा।\nप्रशाम्यति तदा वायुः खं तु तिष्ठति नानदन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2081888, "chapter_id": 2734, "verse_number": "१२-२३९-१२", "content_sanskrit": "अरूपमरसस्पर्शमगन्धं न च मूर्तिमत्।\nसर्वलोकप्रणुदितं स्वं तु तिष्ठति नानदत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2081889, "chapter_id": 2734, "verse_number": "१२-२३९-१३", "content_sanskrit": "आकाशस्य गुणं शब्दमभिव्यक्तात्मकं मनः।\n`ग्रसते च यदा सोऽपि शाम्यति प्रतिसंचरे।\nमनसो व्यक्तमव्यक्तं ब्राह्मः संप्रतिसंचरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2081890, "chapter_id": 2734, "verse_number": "१२-२३९-१४", "content_sanskrit": "तदाऽऽत्मगुणमाविश्य मनो ग्रसति चन्द्रमाः।\nमनस्युपरते चात्मा चन्द्रमस्युपतिष्ठते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2081891, "chapter_id": 2734, "verse_number": "१२-२३९-१५", "content_sanskrit": "तं तु कालेन महता संकल्पं कुरुते वशे।\nचित्तं ग्रसति संकल्पस्तच्च ज्ञानमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2081892, "chapter_id": 2734, "verse_number": "१२-२३९-१६", "content_sanskrit": "कालो गिरति विज्ञानं कालं बलमिति श्रुतिः।\nबलं कालो ग्रसति तु तं विद्वान्कुरुते वशे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2081893, "chapter_id": 2734, "verse_number": "१२-२३९-१७", "content_sanskrit": "[आकाशस्य तदा घोषं तं विद्वान्कुरुतेऽऽत्मनि।]\nतदव्यक्तं परं ब्रह्म तच्छाश्वतमनुत्तमम्।\nएवं सर्वाणि भूतानि ब्रह्मैव प्रतिसंहरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2081894, "chapter_id": 2734, "verse_number": "१२-२३९-१८", "content_sanskrit": "यथावत्कीर्तितं सत्यमेवमेतदसंशयम्।\nबोध्यं विद्यामयं दृष्ट्वा योगिभिः परमात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2081895, "chapter_id": 2734, "verse_number": "१२-२३९-१९", "content_sanskrit": "एवं विस्तारसंक्षेपौ ब्रह्माव्यक्ते पुनःपुनः।\nयुगसाहस्रयोरादावहोरात्र्यास्तथैव च॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2081896, "chapter_id": 2734, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकोनविंशत्यधिकद्विशततमोऽध्यायः॥ २३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]