[{"id": 50026262, "chapter_id": 12093, "verse_number": "1", "content_sanskrit": "शङ्खचक्रगदापद्मशार्ङ्गखड्गधरं सदा। नमामि पितरं नित्यं वासुदेवं जगत्पतिम्॥ १॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50026263, "chapter_id": 12093, "verse_number": "2", "content_sanskrit": "सच्चिदानन्दरूपं तमनामयमनन्तरम्। एकमेकान्तमभयं विष्णुं विश्वहृदि स्थितम्॥ २॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50026264, "chapter_id": 12093, "verse_number": "3", "content_sanskrit": "नानास्वभावमत्यन्तस्वभावेन विचारितम्। अविशेषमनाद्यन्तं प्रणमामि सनातनम्॥ ३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50026265, "chapter_id": 12093, "verse_number": "4", "content_sanskrit": "कुन्देन्दुसन्निभं वन्दे सुधारसनिभं विभुम्‌। ज्ञानमुद्रापुस्तकादिशङ्खाक्षायुधधारिणम्॥ ४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50026266, "chapter_id": 12093, "verse_number": "5", "content_sanskrit": "आनन्दमजरं नित्यमात्मेशममितद्युतिम्‌। वन्दे विश्वस्य पितरं विष्णुं विश्वेश्वरं सदा॥ ५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50026267, "chapter_id": 12093, "verse_number": "6", "content_sanskrit": "अमन्दानन्दसन्दोहसन्तोषितजगत्त्रयम्‌। नारायणमणीयांसं वन्दे देवं सनातनम्‌॥ ६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50026268, "chapter_id": 12093, "verse_number": "7", "content_sanskrit": "सूर्यमण्डलमध्यस्थं वराभयकरोद्यतम्‌। सूर्यामितद्युतिं वन्दे नारायणमनामयम्॥ ७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50026269, "chapter_id": 12093, "verse_number": "8", "content_sanskrit": "विश्वं विश्वाकरं वन्दे विश्वस्य प्रपितामहम्। नानारूपमजं नित्यं विश्वात्मानं प्रजापतिम्‌॥ ८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50026270, "chapter_id": 12093, "verse_number": "9", "content_sanskrit": "कालाकालविचारादिप्रकालितसदातनम्। पुरुषं प्रकृतिस्थं च वन्दे विष्णुमजोत्तमम्॥ ९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50026271, "chapter_id": 12093, "verse_number": "10", "content_sanskrit": "ब्रह्मणः पितरं वन्दे शङ्करस्य पितामहम्‌। श्रियः पतिमजं नित्यमिन्द्रादिप्रपितामहम्‌॥ १०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50026272, "chapter_id": 12093, "verse_number": "11", "content_sanskrit": "प्रतिप्रति स्थितं विष्णुं नित्यामृतमनामयम्। शङ्खचक्रधरं वन्दे वराभयकरोद्यतम्‌॥ ११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50026273, "chapter_id": 12093, "verse_number": "12", "content_sanskrit": "प्रतापप्रविशेषेण दूरीकृतविदूषणम्। विदारितारिमत्यन्तप्रसन्नं प्रणमाम्यहम्‌॥ १२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50026274, "chapter_id": 12093, "verse_number": "13", "content_sanskrit": "अप्रमेयमजं नित्यं विशालममृतं परम्‌। कृतनित्यालयालोके नमस्यामि जगत्पतिम्॥ १३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50026275, "chapter_id": 12093, "verse_number": "14", "content_sanskrit": "सुनित्यसुखमक्षय्यं शुद्धं शान्तं निरञ्जनम्। लोकालोकविचाराढ्यं नमस्यामि श्रियः पतिम्॥ १४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50026276, "chapter_id": 12093, "verse_number": "15", "content_sanskrit": "अमन्दानन्दसन्दोहसान्द्रमिन्द्रानुजं परम्। नित्यावदातमेकान्तं प्रमाणातीतमक्षयम्‌। लोकालोकपतिं दिव्यं नमस्यामि रमापतिम्॥ १५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]