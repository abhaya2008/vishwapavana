[{"id": 40014337, "chapter_id": 9193, "verse_number": "1", "content_sanskrit": "सातुनीलेनविधिवत्स्वारक्षासुसमाहिता । सागरस्योत्तरेतीरेसाधुसेनानिवेशिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40014338, "chapter_id": 9193, "verse_number": "2", "content_sanskrit": "मैन्दश्चद्विविदश्चोभौतत्रवानरपुङ्गवौ । विचेरतुश्चतांसेनांरक्षार्थंसर्वतोदिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40014339, "chapter_id": 9193, "verse_number": "3", "content_sanskrit": "निविष्टायांतुसेनायांतीरेनदनदीपतेः । पार्श्वस्थंलक्ष्मणंदृष्टवारामोवचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40014340, "chapter_id": 9193, "verse_number": "4", "content_sanskrit": "शोकश्चकिलकालेनगच्छताह्यपगच्छति । ममचापश्यतःकान्तामहन्यहनिवर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40014341, "chapter_id": 9193, "verse_number": "5", "content_sanskrit": "﻿नमेदुःखंप्रियादूरेनमेदुःखंहृतेतिवा । एतदेवानुशोचामिवयोस्याह्यतिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40014342, "chapter_id": 9193, "verse_number": "6", "content_sanskrit": "वाहिवातयतःकान्तातांस्पृष्टवामामपिस्पृश । त्वयिमेगात्रसंस्पर्शश्चन्द्रेदृष्टिसमागमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40014343, "chapter_id": 9193, "verse_number": "7", "content_sanskrit": "तन्मेदहतिगात्राणिविषंपीतमिवाशये । हानाथेतिप्रियासामांह्रियमाणायदब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40014344, "chapter_id": 9193, "verse_number": "8", "content_sanskrit": "तद्वियोगेन्धनवतातच्चिन्ताविपुलार्चिषा । रात्रिंदिवंशरीरंमेदह्यतेमदनाग्निना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40014345, "chapter_id": 9193, "verse_number": "9", "content_sanskrit": "अवगाह्यर्णवंस्वप्स्येसौमित्रेभवताविना । कथञ्चित्प्रज्वलन्कामस्समांसुप्तंजलेदहेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40014346, "chapter_id": 9193, "verse_number": "10", "content_sanskrit": "बह्वेतत्कामयानस्यशक्यमेतेनजीवितुम् । यदहंसाचवामोरूरेकांधरणिमाश्रितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40014347, "chapter_id": 9193, "verse_number": "11", "content_sanskrit": "केदारस्येवकेदारस्सोदकस्यनिरूदकः । उपस्नेहेनजीवामिजीवन्तींयच्छृणोमिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40014348, "chapter_id": 9193, "verse_number": "12", "content_sanskrit": "कदानुखलुसुश्रोणींशतपत्त्रायतेक्षणाम् । विजित्यशत्रून्द्रक्ष्यामिसीतास्फीतामिवश्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40014349, "chapter_id": 9193, "verse_number": "13", "content_sanskrit": "कदानुचारुबिम्बोष्ठंतस्याःपद्ममिवाननम् । ईषदुन्नम्यपास्यामिरसायनमिवातुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40014350, "chapter_id": 9193, "verse_number": "14", "content_sanskrit": "﻿तस्यात्तुसंहितौपीनौस्तनौतालफलोपमौ । कदानुखलुसोत्कम्पौश्लिष्यन्त्यामांभजिष्यत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40014351, "chapter_id": 9193, "verse_number": "15", "content_sanskrit": "सानूनमसितापाङ्गीरक्षोमध्यगतासती । मन्नाथानाथहीनेवत्रातारंनाधिगच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40014352, "chapter_id": 9193, "verse_number": "16", "content_sanskrit": "कथंजनकरजस्यदुहिताममचप्रिया । राक्षसीमध्यगाशेतेस्नुषादशरथस्यच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40014353, "chapter_id": 9193, "verse_number": "17", "content_sanskrit": "कदाऽविक्षोभ्यरक्षांसिसाविधूयोत्पतिष्यति । विधूयजलदान्नीलान् शशिरेखाशरत्स्विव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40014354, "chapter_id": 9193, "verse_number": "18", "content_sanskrit": "स्वभावतनुकानूनंशोकेनानशनेनच । भूयस्तनुतरासीतादेशकालविपर्ययात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40014355, "chapter_id": 9193, "verse_number": "19", "content_sanskrit": "कदानुराक्षसेन्द्रस्यनिधायोरसिसायकान् । सीतांप्रत्याहरिष्यामिशोकमुत्सृज्यमानसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40014356, "chapter_id": 9193, "verse_number": "20", "content_sanskrit": "कदानुखलुमांसाध्वीसीतासुरसुतोपमा । सोत्कण्ठाकण्ठमालम्ब्यमोक्ष्यत्यानन्दजंजलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40014357, "chapter_id": 9193, "verse_number": "21", "content_sanskrit": "कदाशोकमिमंघोरंमैथिलीविप्रयोगजम् । सहसाविप्रमोक्ष्यामिवासश्शुक्लेतरंयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40014358, "chapter_id": 9193, "verse_number": "22", "content_sanskrit": "एवंविलपतस्तस्यतत्ररामस्यधीमतः । दिनक्षयान्मन्दवपुर्भास्करोऽस्तमुपागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40014359, "chapter_id": 9193, "verse_number": "23", "content_sanskrit": "आश्वासितोलक्ष्मणेनरामस्सन्ध्यामुपासत । स्मरन्कमलपत्राक्षींसीतांशोकाकुलीकृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]