[{"id": 5000193000, "chapter_id": 9193, "verse_number": "२-११६-१", "content_sanskrit": "प्रतिप्रयाते भरते वसन् रामस्तपोवने ।\nलक्षयामास सोद्वेगमथौत्सुक्यं तपस्विनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000193001, "chapter_id": 9193, "verse_number": "२-११६-२", "content_sanskrit": "ये तत्र चित्रकूटस्य पुरस्तात्तापसाश्रमे ।\nराममाश्रित्य निरतास्तानलक्षयदुत्सुकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000193002, "chapter_id": 9193, "verse_number": "२-११६-३", "content_sanskrit": "नयनैर्भुकुटीभिश्च रामं निर्दिश्य शङ्किता: ।\nअन्योन्यमुपजल्पन्त: शनैश्चक्रुर्मिथ: कथा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000193003, "chapter_id": 9193, "verse_number": "२-११६-४", "content_sanskrit": "तेषामौत्सुक्यमालक्ष्य रामस्त्वात्मनि शङ्कित: ।\nकृताञ्जलिरुवाचेदमृषिं कुलपतिं तत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000193004, "chapter_id": 9193, "verse_number": "२-११६-५", "content_sanskrit": "न कच्चिद्भगवन् किञ्चित्पूर्ववृत्तमिदं मयि ।\nदृश्यते विकृतं येन विक्रियन्ते तपस्विन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000193005, "chapter_id": 9193, "verse_number": "२-११६-६", "content_sanskrit": "प्रमादाच्चरितं कच्चित्किञ्चिन्नावरजस्य मे ।\nलक्ष्मणस्यर्षिभिर्दृष्टं नानुरूपमिवात्मन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000193006, "chapter_id": 9193, "verse_number": "२-११६-७", "content_sanskrit": "कच्चिच्छुश्रूषमाणा व: शुश्रूषणपरा मयि ।\nप्र(म)मादाभ्युचितां वृत्तिं सीता युक्तं न वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000193007, "chapter_id": 9193, "verse_number": "२-११६-८", "content_sanskrit": "अथर्षिर्जरया वृद्धस्तपसा च जरां गत: ।\nवेपमान इवोवाच रामं भूतदयापरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000193008, "chapter_id": 9193, "verse_number": "२-११६-९", "content_sanskrit": "कुत: कल्याणसत्त्वाया: कल्याणाभिरतेस्तथा ।\nचलनं तात वैदेह्यास्तपस्विषु विशेषत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000193009, "chapter_id": 9193, "verse_number": "२-११६-१०", "content_sanskrit": "त्वन्निमित्तमिदं तावत्तापसान् प्रति वर्तते ।\nरक्षोभ्यस्तेन संविग्ना: कथयन्ति मिथ: कथा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000193010, "chapter_id": 9193, "verse_number": "२-११६-११", "content_sanskrit": "रावणावरज: कश्चित् खरो नामेह राक्षस: ।\nउत्पाट्य तापसान् सर्वान् जनस्थाननिकेतनान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000193011, "chapter_id": 9193, "verse_number": "२-११६-१२", "content_sanskrit": "धृष्टश्च जितकाशीं च नृशंस: पुरुषादक: ।\nअवलिप्तश्च पापश्च त्वां च तात न मृष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000193012, "chapter_id": 9193, "verse_number": "२-११६-१३", "content_sanskrit": "त्वं यदाप्रभृति ह्यस्मिन्नाश्रमे तात वर्तसे ।\nतदाप्रभृति रक्षांसि विप्रकुर्वन्ति तापसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000193013, "chapter_id": 9193, "verse_number": "२-११६-१४", "content_sanskrit": "दर्शयन्ति हि बीभत्सै: क्रूरैर्भीषणकैरपि ।\nनानारूपैर्विरूपैश्च रूपैर्विकृतदर्शनै: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000193014, "chapter_id": 9193, "verse_number": "२-११६-१५", "content_sanskrit": "अप्रशस्तैरशुचिभि: सम्प्रयोज्य च तापसान् ।\nप्रतिघ्नन्त्यपरान् क्षिप्रमनार्य्या: पुरत: स्थिता: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000193015, "chapter_id": 9193, "verse_number": "२-११६-१६", "content_sanskrit": "तेषु तेष्वाश्रमस्थानेष्वबुद्धमवलीय च ।\nरमन्ते तापसांस्तत्र नाशयन्तो ऽल्पयेतस: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000193016, "chapter_id": 9193, "verse_number": "२-११६-१७", "content_sanskrit": "अपक्षिपन्ति स्रुग्भाण्डानग्नीन् सिञ्चन्ति वारिणा ।\nकलशांश्च प्रमृद्नन्ति हवने समुपस्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000193017, "chapter_id": 9193, "verse_number": "२-११६-१८", "content_sanskrit": "तैर्दुरात्मभिरामृष्टानाश्रमान् प्रजिहासव: ।\nगमनायान्यदेशस्य चोदयन्त्यृषयो ऽद्य माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000193018, "chapter_id": 9193, "verse_number": "२-११६-१९", "content_sanskrit": "तत्पुरा राम शारीरीमुपहिंसां तपस्विषु ।\nदर्शयन्ति हि दुष्टास्ते त्यक्ष्याम इममाश्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000193019, "chapter_id": 9193, "verse_number": "२-११६-२०", "content_sanskrit": "बहुमूलफलं चित्रमविदूरादितो वनम् ।\nपुराणाश्रममेवाहं श्रयिष्ये सगण: पुन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000193020, "chapter_id": 9193, "verse_number": "२-११६-२१", "content_sanskrit": "खरस्त्वय्यपि चायुक्तं पुरा तात प्रवर्त्तते ।\nसहास्माभिरितो गच्छ यदि बुद्धि: प्रवर्त्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000193021, "chapter_id": 9193, "verse_number": "२-११६-२२", "content_sanskrit": "सकलत्रस्य सन्देहो नित्यं यत्तस्य राघव ।\nसमर्थस्यापि वसतो वासो दु:खमिहाद्य ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000193022, "chapter_id": 9193, "verse_number": "२-११६-२३", "content_sanskrit": "इत्युक्तवन्तं रामस्तं राजपुत्रस्तपस्विनम् ।\nन शशाकोत्तरैर्वाक्यैरवरोद्धुं समुत्सुक: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000193023, "chapter_id": 9193, "verse_number": "२-११६-२४", "content_sanskrit": "अभिनन्द्य समापृच्छ्य समाधाय च राघवम् ।\nस जगामाश्रमं त्यक्त्वा कुलै: कुलपति: सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000193024, "chapter_id": 9193, "verse_number": "२-११६-२५", "content_sanskrit": "राम: संसाध्य त्वृषिगणमनुगमनाद्देशात्तस्मात् कुलपतिमभिवाद्य ऋषिम् ।\nसम्यक्प्रीतैस्तैरनुमत उपदिष्टार्थ: पुण्यं वासाय स्वनिलयमुपसम्पेदे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000193025, "chapter_id": 9193, "verse_number": "२-११६-२६", "content_sanskrit": "आश्रमं त्वृषिविरहितं प्रभु: क्षणमपि न विजहौ स राघव: ।\nराघवं हि सततमनुगतास्तापसाश्चार्षचरितधृतगुणा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000193026, "chapter_id": 9193, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदयोध्याकाण्डे षोडशोत्तरशततम: सर्ग: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]