[{"id": 7003577000, "chapter_id": 23577, "verse_number": "२१७-१", "content_sanskrit": "सनत्कुमार उवाच ।\nउक्तं भगवता सर्वं यथावत्परमेष्ठिना ।\nपृष्टेन संशयं सम्यक्परं कृत्वार्थनिश्चयम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003577001, "chapter_id": 23577, "verse_number": "२१७-२", "content_sanskrit": "भगवद्विश्वरूपस्य स्थाणोरप्रतिमौजसः ।\nक्रीडतो लोकनाथस्य कानने मृगरूपिणः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003577002, "chapter_id": 23577, "verse_number": "२१७-३", "content_sanskrit": "यथा शरीरं शृङ्गं च पुण्यक्षेत्रे प्रतिष्ठितम् ।\nहिताय जगतस्तत्र तीर्थानि च यथाभवन् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003577003, "chapter_id": 23577, "verse_number": "२१७-४", "content_sanskrit": "तन्मे ब्रूहि महाभाग यथातत्त्वं जगत्पते ।\nब्रह्मोवाच ।\nपुलस्त्यो वक्ष्यते शेषं यदतोऽन्यन्महामुने ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003577004, "chapter_id": 23577, "verse_number": "२१७-५", "content_sanskrit": "सर्वेषामेव तीर्थानामेषां फलविनिश्चयम् ।\nकुरु राज्यं पुरस्कृत्य मुनीनां पुरतो वने ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003577005, "chapter_id": 23577, "verse_number": "२१७-६", "content_sanskrit": "पुत्रो मे मत्समः सम्यग्वेदवेदांगतत्त्ववित् ।\nयच्छ्रुत्वा पुरुषस्तात विमुक्तः सर्वकिल्बिषैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003577006, "chapter_id": 23577, "verse_number": "२१७-७", "content_sanskrit": "यशस्वी कीर्त्तिमान्भूत्वा वन्द्यते प्रेत्य चेह च ।\nश्रोतव्यमेतत्सततं चातुर्वर्ण्यैः सुसंयुतैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003577007, "chapter_id": 23577, "verse_number": "२१७-८", "content_sanskrit": "मंगल्यं च शिवं चैव धर्मकामार्थसाधकम् ।\nश्रीभूतिजननं पुण्यमायुष्यं विजयावहम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003577008, "chapter_id": 23577, "verse_number": "२१७-९", "content_sanskrit": "धन्यं यशस्यं पापघ्नं स्वस्तिकृच्छान्तिकारकम् ।\nश्रुत्वैवं पुरुषः सम्यङ्न दुर्गतिमवाप्नुयात् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003577009, "chapter_id": 23577, "verse_number": "२१७-१०", "content_sanskrit": "कीर्तयित्वा व्रजेत्स्वर्गं कल्यमुत्थाय मानवः ।\nसूत उवाच ।\nइत्युक्त्वा भगवान्देवः परमेष्ठी प्रजापतिः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003577010, "chapter_id": 23577, "verse_number": "२१७-११", "content_sanskrit": "सनत्कुमारं सन्दिश्य विरराम महायशाः ।\nएतद्वः कथितं सर्वं मया तत्त्वेन सत्तमाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003577011, "chapter_id": 23577, "verse_number": "२१७-१२", "content_sanskrit": "वराहभूमिसंवादं सारमुद्धृत्य सत्तमाः ।\nयश्चैव कीर्त्तयेन्नित्यं शृणुयाद्वापि भक्तितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003577012, "chapter_id": 23577, "verse_number": "२१७-१३", "content_sanskrit": "सर्वपापविनिर्मुक्तः स याति परमां गतिम् ।\nप्रभासे नैमिषारण्ये गंगाद्वारेऽथ पुष्करे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003577013, "chapter_id": 23577, "verse_number": "२१७-१४", "content_sanskrit": "प्रयागे ब्रह्मतीर्थे च तीर्थे चामरकण्टके ।\nयत्पुण्यफलमाप्नोति तत्कोटिगुणितं भवेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003577014, "chapter_id": 23577, "verse_number": "२१७-१५", "content_sanskrit": "कपिलां द्विजमुख्याय सम्यग्दत्त्वा तु यत्फलम् ।\nप्राप्नोति सकलं श्रुत्वा चाध्यायं तु न संशयः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003577015, "chapter_id": 23577, "verse_number": "२१७-१६", "content_sanskrit": "श्रुत्वाऽस्यैव दशाध्यायं शुचिर्भूत्वा समाहितः ।\nअग्निष्टोमातिरात्राभ्यां फलं प्राप्नोति मानवः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003577016, "chapter_id": 23577, "verse_number": "२१७-१७", "content_sanskrit": "यः पुनः सततं शृण्वन्नैरन्तर्येण बुद्धिमान् ।\nपारयेत्परया भक्त्या तस्यापि शृणु यत्फलम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003577017, "chapter_id": 23577, "verse_number": "२१७-१८", "content_sanskrit": "सर्वयज्ञेषु यत्पुण्यं सर्वदानेषु यत्फलम् ।\nसर्वतीर्थाभिषेकेन यत्फलं मुनिभिः स्मृतम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003577018, "chapter_id": 23577, "verse_number": "२१७-१९", "content_sanskrit": "तत्प्राप्नोति न सन्देहो वराहवचनं यथा ।\nयदेतत्पारयेद्भक्त्या मम माहात्म्यमुत्तमम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003577019, "chapter_id": 23577, "verse_number": "२१७-२०", "content_sanskrit": "अपुत्रस्य भवेत्पुत्रः सपौत्रस्य सुपौत्रकः ।\nयस्येदं लिखितं गेहे तिष्ठेत्संपूज्यते सदा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003577020, "chapter_id": 23577, "verse_number": "२१७-२१", "content_sanskrit": "तस्य नारायणो देवः सन्तुष्टः स्याद्धि  सर्वदा ।\nयश्चैतच्छृणुयाद्भक्त्या नैरन्तर्येण मानवः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003577021, "chapter_id": 23577, "verse_number": "२१७-२२", "content_sanskrit": "श्रुत्वा तु पूजयेच्छास्त्रं यथा विष्णुं सनातनम् ।\nगन्धपुष्पैस्तथा वस्त्रैर्ब्राह्मणानां च तर्पणैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003577022, "chapter_id": 23577, "verse_number": "२१७-२३", "content_sanskrit": "यथाशक्ति नृपो ग्रामैः पूजयेच्च वसुन्धरे।\nश्रुत्वा तु पूजयेद्यः पौराणिकं नियतः शुचिः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003577023, "chapter_id": 23577, "verse_number": "२१७-२४", "content_sanskrit": "सर्वपापविनिर्मुक्तो विष्णुसायुज्यमाप्नुयात् २४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003577024, "chapter_id": 23577, "verse_number": "२१७-२५", "content_sanskrit": "समाप्तमिदं वराहमहापुराणम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]