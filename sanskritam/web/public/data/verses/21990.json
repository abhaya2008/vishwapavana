[{"id": 7001990000, "chapter_id": 21990, "verse_number": "३५-१", "content_sanskrit": "अग्निरुवाच ।\nसम्पाताहुतिनासिच्य पवित्राण्याधिवासयेत् ।\nतृसिंहमन्त्रजप्तानि गुप्तान्यस्त्रेण तानि तु ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001990001, "chapter_id": 21990, "verse_number": "३५-२", "content_sanskrit": "वस्त्रसंवेष्टितान्येव पात्रस्थान्यभिमन्त्रयेत् ।\nविल्वाद्यद्भिः प्रोक्षितानि मन्त्रेण चैकधा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001990002, "chapter_id": 21990, "verse_number": "३५-३", "content_sanskrit": "कुम्भपार्श्वे तु संस्थाप्य रक्षां विज्ञाप्य देशिकः ।\nदन्तकाष्ठञ्चामलकं पूर्वे कङ्कर्षणेन तु ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001990003, "chapter_id": 21990, "verse_number": "३५-४", "content_sanskrit": "प्रद्युम्नेन भस्मतिलान् दक्षे गोमयमृत्तिकाम् ।\nवारुणे चानिरुद्धेन सौम्ये नारायणेन च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001990004, "chapter_id": 21990, "verse_number": "३५-५", "content_sanskrit": "दर्भोदकञ्चाथ हृदा अग्नौ कुङ्कुमरोचनम् ।\nऐशान्यां शिरसा धूपं शिखया नैरृतेप्यथ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001990005, "chapter_id": 21990, "verse_number": "३५-६", "content_sanskrit": "मूलपुष्पाणि दिव्यानि कवचेनाथ वायवे ।\nचन्दनाम्ब्वक्षतदधिदूर्वाश्च पुटिकास्थिताः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001990006, "chapter_id": 21990, "verse_number": "३५-७", "content_sanskrit": "गृहं त्रिसूत्रेणावेष्ट्य पुनः सिद्धार्थकान् क्षिपेत् ।\nदद्यात्पूजाक्रमेणाथ स्वैः स्वैर्गन्धपवित्रकम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001990007, "chapter_id": 21990, "verse_number": "३५-८", "content_sanskrit": "मन्त्रैर्वै द्वारपादिभ्यो विष्णुकुम्भे त्वनेन च ।\nविष्णुतेजोभवं रम्यं सर्वपातकनाशनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001990008, "chapter_id": 21990, "verse_number": "३५-९", "content_sanskrit": "सर्वकामप्रदं देवं तवाङ्गे धारयाम्यहम् ।\nसम्पूज्य धूपदीपद्यैर्व्रजेद् द्वारसमीपतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001990009, "chapter_id": 21990, "verse_number": "३५-१०", "content_sanskrit": "गन्धपुष्पाक्षतोपेतं पवित्रञ्चाशिलेर्प्पयेत् ।\nपवित्रं वैष्णवं तेजो महापातकनाशनम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001990010, "chapter_id": 21990, "verse_number": "३५-११", "content_sanskrit": "धर्म्मकामार्थसिद्ध्यर्थं स्वकेङ्गे धारयाम्यहम् ।\nआसने परिवारादौ गुरौ दद्यात् पवित्रकम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001990011, "chapter_id": 21990, "verse_number": "३५-१२", "content_sanskrit": "गन्धादिभिः समभ्यर्च्य गन्धपुष्पाक्षतादिमत् ।\nविष्णुतेजोभवेत्यादिमूलेन हरयेर्पयेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001990012, "chapter_id": 21990, "verse_number": "३५-१३", "content_sanskrit": "वह्निस्थाय ततो दत्वा देवं सम्प्रार्थयेत्ततः ।\nक्षीरोदधिमहानागशय्यावस्थितविग्रह ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001990013, "chapter_id": 21990, "verse_number": "३५-१४", "content_sanskrit": "प्रातस्त्वां पूजयिष्यामि सन्निधौभव केशव ।\nइन्द्रादिभ्यस्ततो दत्वा विष्णुपार्षदके बलिम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001990014, "chapter_id": 21990, "verse_number": "३५-१५", "content_sanskrit": "ततो देवाग्रतः कुम्भं वासोयुगसमन्वितम् ।\nरोचनाचन्द्रकाश्मीरगन्धाद्युदकसंयुतम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001990015, "chapter_id": 21990, "verse_number": "३५-१६", "content_sanskrit": "गन्धपुष्पादिनाभूष्य मूलमन्त्रेण पूजयेत् ।\nमण्डपाद्वहिरागत्य विलिप्ते मण्डलत्रये ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001990016, "chapter_id": 21990, "verse_number": "३५-१७", "content_sanskrit": "पञ्चगव्यञ्चरुन्दन्तकाष्ठञ्चैव क्रमाद्भवेत् ।\nपुराणश्रवणं स्तोत्रं पठन् जागरणं निशि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001990017, "chapter_id": 21990, "verse_number": "३५-१८", "content_sanskrit": "परप्रेषकबालानां स्त्रीणं भोगभुजां तथा ।\nसद्योधिवासनं कुर्य्याद्विना गन्धपवित्रकम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]