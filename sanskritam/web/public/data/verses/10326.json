[{"id": 6000326000, "chapter_id": 10326, "verse_number": null, "content_sanskrit": "अथ पञ्चविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000326001, "chapter_id": 10326, "verse_number": "११-२५-१", "content_sanskrit": "गुणानामप्यमिश्राणां पुमान् येन यथा भवेत्।\nतन्मे पुरुषवर्येदमुपधारय शंसतः॥ ११/२५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.001.m4a", "display_order": 2, "topics": [{"text": "कृष्णेनोद्धवाय सत्त्वादिगुणवृत्तिवर्णनम्", "range": "१–३४"}]}, {"id": 6000326002, "chapter_id": 10326, "verse_number": "११-२५-२", "content_sanskrit": "शमो दमस्तितिक्षेक्षा तपः सत्यं दया स्मृतिः।\nतुष्टिस्त्यागोऽस्पृहा श्रद्धा ह्रीः क्षमा निस्तुतिर्धृतिः॥ ११/२५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.002.m4a", "display_order": 3}, {"id": 6000326003, "chapter_id": 10326, "verse_number": "११-२५-३", "content_sanskrit": "काम ईहा मदस्तृष्णा स्तम्भ आशीर्भिदाऽसुखम्।\nमनोत्साहो यशः प्रीतिर्धार्ष्ट्यवीर्यबलोद्यमाः॥ ११/२५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.003.m4a", "display_order": 4}, {"id": 6000326004, "chapter_id": 10326, "verse_number": "११-२५-४", "content_sanskrit": "क्रोधो लोभोऽनृतं हिंसा माया दम्भोऽक्षमा कलिः।\nशोकमोहौ विषादार्ती निद्राऽऽशा भीरनुद्यमः॥ ११/२५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.004.m4a", "display_order": 5}, {"id": 6000326005, "chapter_id": 10326, "verse_number": "११-२५-५", "content_sanskrit": "सत्वस्य रजसश्चैव तमसश्चानुपूर्वशः।\nवृत्तयो वर्णितप्रायाः सन्निपातमथो शृणु॥ ११/२५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.005.m4a", "display_order": 6}, {"id": 6000326006, "chapter_id": 10326, "verse_number": "११-२५-६", "content_sanskrit": "सन्निपातस्त्वहमिति ममेत्युद्धव या मतिः।\nव्यवहारः सन्निपाते मनोमात्रेन्द्रियासुभिः॥ ११/२५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.006.m4a", "display_order": 7}, {"id": 6000326007, "chapter_id": 10326, "verse_number": "११-२५-७", "content_sanskrit": "धर्मे चार्थे च कामे च यदाऽसौ परिनिष्ठितः।\nगुणानां सन्निकर्षोऽयं श्रद्धारतिधनावहः॥ ११/२५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.007.m4a", "display_order": 8}, {"id": 6000326008, "chapter_id": 10326, "verse_number": "११-२५-८", "content_sanskrit": "प्रवृत्तिलक्षणां निष्ठां पुरुषो यर्हि गृहाश्रमे।\nस्वधर्मे चानुतिष्ठेत गुणानां समितिर्हि सा॥ ११/२५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.008.m4a", "display_order": 9}, {"id": 6000326009, "chapter_id": 10326, "verse_number": "११-२५-९", "content_sanskrit": "पुरुषं सत्त्वसंयुक्तमनुमायाच्छमादिभिः।\nकामादिभी रजोयुक्तं क्रोधाद्यैस्तमसाऽऽवृतम्॥ ११/२५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.009.m4a", "display_order": 10}, {"id": 6000326010, "chapter_id": 10326, "verse_number": "११-२५-१०", "content_sanskrit": "यदा भजति मां भक्त्या निरपेक्षः स्वकर्मभिः।\nतं सत्त्वप्रकृतिं विद्यात् पुरुषं स्त्रियमेव च॥ ११/२५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.010.m4a", "display_order": 11}, {"id": 6000326011, "chapter_id": 10326, "verse_number": "११-२५-११", "content_sanskrit": "यदा आशिष आशास्य मां यजेत स्वकर्मभिः।\nतं रजःप्रकृतिं विद्यात् हिंसामाशास्य तामसम्॥ ११/२५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.011.m4a", "display_order": 12}, {"id": 6000326012, "chapter_id": 10326, "verse_number": "११-२५-१२", "content_sanskrit": "सत्वं रजस्तम इति गुणा जीवस्य नैव मे।\nचित्तजा यैस्तु भूतानां सज्जमानो निबध्यते॥ ११/२५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.012.m4a", "display_order": 13}, {"id": 6000326013, "chapter_id": 10326, "verse_number": "११-२५-१३", "content_sanskrit": "यदेतरौ जयेत् सत्वं भास्वरं विशदं शिवम्।\nतदा सुखेन युज्येत धर्मज्ञानादिभिः पुमान्॥ ११/२५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.013.m4a", "display_order": 14}, {"id": 6000326014, "chapter_id": 10326, "verse_number": "११-२५-१४", "content_sanskrit": "यदा जयेत् तमस्सत्वे रजः सङ्गभिदाचलम्।\nतदा दुःखेन युज्येत कर्मणा यशसा श्रिया॥ ११/२५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.014.m4a", "display_order": 15}, {"id": 6000326015, "chapter_id": 10326, "verse_number": "११-२५-१५", "content_sanskrit": "यदा जयेद् रजस्सत्वे तमोमूढो ह्ययं जनः।\nयुज्यते शोकमोहाभ्यां निद्रया हिंसयाऽऽशया॥ ११/२५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.015.m4a", "display_order": 16}, {"id": 6000326016, "chapter_id": 10326, "verse_number": "११-२५-१६", "content_sanskrit": "यदा चित्तं प्रसीदेत इन्द्रियाणां च निर्वृतिः।\nदेहेऽभयं मनोऽसङ्गं तत् सत्त्वं विद्धि मत्पदम्॥ ११/२५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.016.m4a", "display_order": 17}, {"id": 6000326017, "chapter_id": 10326, "verse_number": "११-२५-१७", "content_sanskrit": "विकुर्वन् क्रियया चाधीरनिवृत्तिश्च चेतसः।\nगात्रास्वास्थ्यं मनो भ्रान्तं रज एतैर्निशामय॥ ११/२५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.017.m4a", "display_order": 18}, {"id": 6000326018, "chapter_id": 10326, "verse_number": "११-२५-१८", "content_sanskrit": "सीदच्चितं विलीयेत चेतसो ग्रहणेऽक्षमम्।\nमनो नष्टं तमो ग्लानिस्तमस्तदुपधारय॥ ११/२५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.018.m4a", "display_order": 19}, {"id": 6000326019, "chapter_id": 10326, "verse_number": "११-२५-१९", "content_sanskrit": "एधमाने गुणे सत्त्वे देवानां बलमेधते।\nअसुराणां च रजसि तमस्युद्धव रक्षसाम्॥ ११/२५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.019.m4a", "display_order": 20}, {"id": 6000326020, "chapter_id": 10326, "verse_number": "११-२५-२०", "content_sanskrit": "सत्वाज्जागरणं विद्याद् रजसा स्वप्नमादिशेत्।\nप्रस्वापं तमसा जन्तोस्तुरीयं त्रिष्वसङ्गतम्॥ ११/२५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.020.m4a", "display_order": 21}, {"id": 6000326021, "chapter_id": 10326, "verse_number": "११-२५-२१", "content_sanskrit": "उपर्युपरि गच्छन्ति सत्वेनाब्रह्मणो जनाः ।\nतमसा अधोऽध आमुख्याद् रजसाऽन्तरचारिणः॥ ११/२५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.021.m4a", "display_order": 22}, {"id": 6000326022, "chapter_id": 10326, "verse_number": "११-२५-२२", "content_sanskrit": "सत्त्वे प्रलीनाः स्वर्यान्ति नरलोकं रजोलयाः ।\nतमोलयास्तु निरयं यान्ति मामेव निर्गुणाः॥ ११/२५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.022.m4a", "display_order": 23}, {"id": 6000326023, "chapter_id": 10326, "verse_number": "११-२५-२३", "content_sanskrit": "मदर्पणं निष्फलं वा सात्त्विकं निजकर्म तत्।\nराजसं फलसङ्कल्पं हिंसाप्रायादि तामसम्॥ ११/२५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.023.m4a", "display_order": 24}, {"id": 6000326024, "chapter_id": 10326, "verse_number": "११-२५-२४", "content_sanskrit": "कैवल्यं सात्त्विकं ज्ञानं कर्मनिष्ठं तु राजसम्।\nप्राकृतं तामसं ज्ञानं मन्निष्ठं निर्गुणं स्मृतम्॥ ११/२५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.024.m4a", "display_order": 25}, {"id": 6000326025, "chapter_id": 10326, "verse_number": "११-२५-२५", "content_sanskrit": "वनं तु सात्त्विको वासो ग्रामो राजस उच्यते।\nतामसं द्यूतसदनं मन्निकेतं तु निर्गुणम्॥ ११/२५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.025.m4a", "display_order": 26}, {"id": 6000326026, "chapter_id": 10326, "verse_number": "११-२५-२६", "content_sanskrit": "सात्त्विकः कारकोऽसङ्गी रागान्धो राजसः स्मृतः।\nतामसः स्मृतिविभ्रष्टो निर्गुणो मदपाश्रयः॥ ११/२५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.026.m4a", "display_order": 27}, {"id": 6000326027, "chapter_id": 10326, "verse_number": "११-२५-२७", "content_sanskrit": "सात्त्विक्याध्यात्मिकी श्रद्धा कर्मश्रद्धा तु राजसी।\nतामस्यधर्मे या श्रद्धा मत्सेवायां तु निर्गुणा॥ ११/२५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.027.m4a", "display_order": 28}, {"id": 6000326028, "chapter_id": 10326, "verse_number": "११-२५-२८", "content_sanskrit": "पथ्यं युक्तमनायस्तमाहार्यं सात्त्विकं स्मृतम्।\nराजसं चेन्द्रियप्रेष्ठं तामसं चार्तिदाशुचि॥ ११/२५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.028.m4a", "display_order": 29}, {"id": 6000326029, "chapter_id": 10326, "verse_number": "११-२५-२९", "content_sanskrit": "सात्त्विकं सुखमात्मोत्थं विषयोत्थं तु राजसम्।\nतामसं मोहदैन्योत्थं निर्गुणं मदपाश्रयम्॥ ११/२५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.029.m4a", "display_order": 30}, {"id": 6000326030, "chapter_id": 10326, "verse_number": "११-२५-३०", "content_sanskrit": "द्रव्यं देशः फलं कालो ज्ञानं कर्म च कारकः।\nश्रद्धाऽवस्था कृतिर्निष्ठा त्रैगुण्याः सर्व एव हि॥ ११/२५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.030.m4a", "display_order": 31}, {"id": 6000326031, "chapter_id": 10326, "verse_number": "११-२५-३१", "content_sanskrit": "सर्वे गुणमया भावा पुरुषाव्यक्तनिष्ठिताः।\nदृष्टं श्रुतमनुध्यायेद् बुद्ध्या वा पुरुषर्षभ॥ ११/२५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.031.m4a", "display_order": 32}, {"id": 6000326032, "chapter_id": 10326, "verse_number": "११-२५-३२", "content_sanskrit": "एताः संसृतयः पुंसां गुणकर्मनिबन्धनाः। येनेमे निर्जिताः सौम्य गुणा जीवेन चित्तजाः।\nभक्तियोगेन मन्निष्ठो मद्भावाय प्रपद्यते॥ ११/२५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.032.m4a", "display_order": 33}, {"id": 6000326033, "chapter_id": 10326, "verse_number": "११-२५-३३", "content_sanskrit": "सत्वं चाभिजयेत् युक्तो नैरपेक्ष्येण शान्तधीः।\nसम्पद्यते गुणैर्मुक्तो जीवं जीवो विहाय माम्॥ ११/२५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.033.m4a", "display_order": 34}, {"id": 6000326034, "chapter_id": 10326, "verse_number": "११-२५-३४", "content_sanskrit": "तस्माद् देहमिमं लब्ध्वा ज्ञानविज्ञानसम्भवम् ।\nमयैव ब्रह्मणा पूर्णो न बहिर्नाऽन्तरश्चरेत्॥ ११/२५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_025/BhP_11.025.034.m4a", "display_order": 35}, {"id": 6000326035, "chapter_id": 10326, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे पञ्चविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]