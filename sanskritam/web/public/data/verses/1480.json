[{"id": 2022697, "chapter_id": 1480, "verse_number": "३-११८-०x", "content_sanskrit": "राम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2022698, "chapter_id": 1480, "verse_number": "३-११८-१", "content_sanskrit": "ममापराधात्तैः क्षुद्रैर्हतस्त्वं तात बालिशैः।\nकार्तवीर्यस्य दायादैर्वने मृग इवेषुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2022699, "chapter_id": 1480, "verse_number": "३-११८-२", "content_sanskrit": "धर्मज्ञस्य कथं तात वर्तमानस्य सत्पथे।\nमृत्युरेवंविधो युक्तः सर्वभूतेष्वनागसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2022700, "chapter_id": 1480, "verse_number": "३-११८-३", "content_sanskrit": "किंनु तैर्न कृतंपापं यैर्बवांस्तपसि स्तितः।\nअयुध्यमानो वृद्धः सन्हतः शरशतैः शितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2022701, "chapter_id": 1480, "verse_number": "३-११८-४", "content_sanskrit": "किंनु ते तत्र वक्ष्यन्ति सचिवेषु सुहृत्सु च।\nअयुध्यमानं धर्मज्ञमेकं हत्वाऽनपत्रपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2022702, "chapter_id": 1480, "verse_number": "३-११८-५x", "content_sanskrit": "अकृतव्रण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2022703, "chapter_id": 1480, "verse_number": "३-११८-५", "content_sanskrit": "लालप्यैवं सकुस्न्णं बहु नानाविधं नृप।\nप्रेतकार्याणि सर्वाणि पितुश्चक्रे महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2022704, "chapter_id": 1480, "verse_number": "३-११८-६", "content_sanskrit": "ददाह पितरं चाग्नौ रामः परपुरंजयः।\nप्रतिजज्ञे वधं चापि सर्वक्षत्रस्य भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2022705, "chapter_id": 1480, "verse_number": "३-११८-७", "content_sanskrit": "संक्रुद्धोऽतिबलः सङ्ख्ये शस्त्रमादाय वीर्यवान्।\nजघ्निवान्कार्तवीर्यस्य सुतानेकोऽन्तकोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2022706, "chapter_id": 1480, "verse_number": "३-११८-८", "content_sanskrit": "तेषां चानुगता ये च क्षत्रियाः क्षत्रियर्षभ।\nतांश्च सर्वानवामृद्गाद्रामः प्रहरतांवरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2022707, "chapter_id": 1480, "verse_number": "३-११८-९", "content_sanskrit": "त्रिःसप्तकृत्वः पृथिवीं कृत्वा निःक्षित्रियां प्रभुः।\nसमन्तपञ्चके पञ्च चकार रुधिरह्रदान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2022708, "chapter_id": 1480, "verse_number": "३-११८-१०", "content_sanskrit": "स तेषु तर्पयामास पितॄन्भृगुकुलोद्वहः।\nसाक्षाद्ददर्श चर्चीकं स च रामं न्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2022709, "chapter_id": 1480, "verse_number": "३-११८-११", "content_sanskrit": "ततो यज्ञेन महता जामदग्न्यः प्रतापवान्।\nतर्पयामास देवेन्द्रमृत्विग्भ्यः प्रददौ महीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2022710, "chapter_id": 1480, "verse_number": "३-११८-१२", "content_sanskrit": "वेदीं चाप्यददद्धैमीं कश्यपाय महात्मने।\nदशव्यामायतां कृत्वा नवोत्सेधां विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2022711, "chapter_id": 1480, "verse_number": "३-११८-१३", "content_sanskrit": "तां कश्यपस्यानुमते ब्राह्मणाः खण्डशस्तदा।\nव्यभजंस्ते तदा राजन्प्रख्याताः खाण्डवायनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2022712, "chapter_id": 1480, "verse_number": "३-११८-१४", "content_sanskrit": "स प्रदाय महीं तस्मै कश्यपाय महात्मने।\n`तपः सुमहदास्थाय महाबलपराक्रमः।\nअस्मिन्महेन्द्रे शैलेन्द्रे वसत्यमितविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2022713, "chapter_id": 1480, "verse_number": "३-११८-१५", "content_sanskrit": "एवं वैरमभूत्तस्य क्षत्रियैर्लोकवासिभिः।\nपृथिवी चापि विजिता रामेणामिततेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2022714, "chapter_id": 1480, "verse_number": "३-११८-१६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2022715, "chapter_id": 1480, "verse_number": "३-११८-१६", "content_sanskrit": "ततश्चतुर्दशीं रामः समयेन महामनाः।\nदर्शयामास तान्विप्रान्धर्मराजं ज सानुजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2022716, "chapter_id": 1480, "verse_number": "३-११८-१७", "content_sanskrit": "स तमानर्च राजेन्द्र भ्रातृभिः सहितः प्रभुः।\nद्विजानां च परां पूजां चक्रे नृपतिसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2022717, "chapter_id": 1480, "verse_number": "३-११८-१८", "content_sanskrit": "अर्जित्वा जामदग्न्यं स पूजितस्तेन चोदितः।\nमहेन्द्र उष्य तां रात्रिं प्रययौ दक्षिणामुखः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2022718, "chapter_id": 1480, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि अष्टादशाधिकशततमोऽध्यायः ॥ ११८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]