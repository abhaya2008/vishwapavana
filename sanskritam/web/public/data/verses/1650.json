[{"id": 2029779, "chapter_id": 1650, "verse_number": "३-२८८-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2029780, "chapter_id": 1650, "verse_number": "३-२८८-१", "content_sanskrit": "ततो निर्याय स्वपुरात्कुम्भकर्णः सहानुगः।\nअपश्यत्कपिसैन्यं रतज्जितकाश्यग्रतः स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2029781, "chapter_id": 1650, "verse_number": "३-२८८-२", "content_sanskrit": "स वीक्षमाणस्तत्सैन्यं रामदर्शनकाङ्क्षया।\nअपश्यच्चापि सौमित्रिं धनुष्पाणिं व्यवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2029782, "chapter_id": 1650, "verse_number": "३-२८८-३", "content_sanskrit": "तमभ्येत्याशु हरयः परिवब्रुः समन्ततः।\n`शैलवृक्षायुधा नादानमुञ्चन्भीषणास्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2029783, "chapter_id": 1650, "verse_number": "३-२८८-४", "content_sanskrit": "अभ्यघ्नंश्च महाकायैर्बहुभिर्जगतीरुहैः।\nकरजैरतुदंश्चान्ये विहाय भयमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2029784, "chapter_id": 1650, "verse_number": "३-२८८-५", "content_sanskrit": "बहुधा युध्यमानास्ते युद्धमार्गैः प्लवंगमाः।\nनानाप्रहरणैर्भीमै राक्षसेन्द्रमताडयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2029785, "chapter_id": 1650, "verse_number": "३-२८८-६", "content_sanskrit": "स ताड्यमानः प्रहसन्भक्षयामास वानरान्।\nबलं चण्डबलाख्यं च वज्रबाहुं च वानरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2029786, "chapter_id": 1650, "verse_number": "३-२८८-७", "content_sanskrit": "तद्दृष्ट्वा व्यथनं कर्म कुम्भकर्णस्य रक्षसः।\nउदक्रोशन्परित्रस्तास्तारप्रभृतयस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2029787, "chapter_id": 1650, "verse_number": "३-२८८-८", "content_sanskrit": "तानुच्चैः क्रोशतः सैन्याञ्श्रुत्वा स हरियूथपान्।\nअभिदुद्राव सुग्रीवः कुम्भकर्णमपेतभीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2029788, "chapter_id": 1650, "verse_number": "३-२८८-९", "content_sanskrit": "ततो निपत्य वेगेन कुम्भकर्णं महामना।\nसालेन जघ्निवान्मूर्ध्निं बलेन कपिकुञ्जरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2029789, "chapter_id": 1650, "verse_number": "३-२८८-१०", "content_sanskrit": "स महात्मा महावेगः कुम्भकर्णस् मूर्धनि।\nबिभेद सालं सुग्रीवो न चैवाव्यथयत्कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2029790, "chapter_id": 1650, "verse_number": "३-२८८-११", "content_sanskrit": "ततो विनद्यसहसा सालस्पर्शविबोधितः।\nदोर्भ्यामादाय सुग्रीवं कुम्भकर्णोऽहरद्बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2029791, "chapter_id": 1650, "verse_number": "३-२८८-१२", "content_sanskrit": "ह्रियमाणं तु सुग्रीवं कुम्भकर्णेन रक्षसा।\nअवेक्ष्याभ्यद्रवद्वीरः सौमित्रिर्मित्रनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2029792, "chapter_id": 1650, "verse_number": "३-२८८-१३", "content_sanskrit": "सोऽभिपत्य महर्वेगं रुक्मपुङ्खं महाशरम्।\nप्राहिणोत्कुम्भकर्णाय लक्ष्मणः परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2029793, "chapter_id": 1650, "verse_number": "३-२८८-१४", "content_sanskrit": "स तस्य देहावरणं भित्त्वा देहं च सायकः।\nजगाम दारयन्भूमिं रुधिरेण समुक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2029794, "chapter_id": 1650, "verse_number": "३-२८८-१५", "content_sanskrit": "तथा स भिन्नहृदयः समुत्सृज्य कपीश्वरम्।\n`वेगेन महताऽऽविष्टस्तिष्ठतिष्ठेति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2029795, "chapter_id": 1650, "verse_number": "३-२८८-१६", "content_sanskrit": "कुम्भकर्णो महेष्वासः प्रगृहीतशिलायुधः।\nअभिदुद्राव सौमित्रिमुद्यम्य महतीं शिलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2029796, "chapter_id": 1650, "verse_number": "३-२८८-१७", "content_sanskrit": "तस्याभिपततस्तूर्णं क्षुराभ्यामुच्छितौ करौ।\nचिच्छेद निशिताग्राभ्यां स बभूव चतुर्भुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2029797, "chapter_id": 1650, "verse_number": "३-२८८-१८", "content_sanskrit": "तानप्यस् भुजान्सर्वान्प्रगृहीतशिलायुधान्।\nक्षुरैश्चिच्छेदलघ्वस्त्रं सौमित्रिः प्रतिदर्शयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2029798, "chapter_id": 1650, "verse_number": "३-२८८-१९", "content_sanskrit": "स बभूवातिकायश्च बहुपादशिरोभुजः।\nतं ब्रह्मास्त्रेण सौमित्रिर्ददाराद्रिचयोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2029799, "chapter_id": 1650, "verse_number": "३-२८८-२०", "content_sanskrit": "स पपात महावीर्यो दिव्यास्त्राभिहतो रणे।\nमहाशनिविनिर्दग्धः पादपोऽङ्कुरवानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2029800, "chapter_id": 1650, "verse_number": "३-२८८-२१", "content_sanskrit": "तं दृष्ट्वा वृत्रसंकाशं कुम्भकर्णं तरस्विनम्।\nगतासुं पतितं भूमौ राक्षसाः प्राद्रवन्भयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2029801, "chapter_id": 1650, "verse_number": "३-२८८-२२", "content_sanskrit": "तथातान्द्रवतो योधान्दृष्ट्वा तौ दूषणानुजौ।\nअवस्थाप्याथ सौमित्रिं संक्रुद्धावभ्यधावताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2029802, "chapter_id": 1650, "verse_number": "३-२८८-२३", "content_sanskrit": "तावाद्रवन्तौ संक्रुद्धौ वज्रवेगप्रमाथिनौ।\nअभिजग्राह सौमित्रिर्विनद्योभौ पतत्रिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2029803, "chapter_id": 1650, "verse_number": "३-२८८-२४", "content_sanskrit": "ततः सुतुमुलं युद्धमभवद्रोमहर्षणम्।\nदूषणानुजयोः पार्थ लक्ष्मणस् च धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2029804, "chapter_id": 1650, "verse_number": "३-२८८-२५", "content_sanskrit": "महता शरवर्षेण राक्षसौ सोऽभ्यवर्पत।\nतं चापिवीरौ संक्रुद्धावुभौ तौ समवर्षताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2029805, "chapter_id": 1650, "verse_number": "३-२८८-२६", "content_sanskrit": "मुहूर्तमेवमभवद्वज्रवेगप्रमाथिनोः।\nसौमित्रेश्च महाबाहोः संप्रहारः सुदारुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2029806, "chapter_id": 1650, "verse_number": "३-२८८-२७", "content_sanskrit": "अथाद्रिशृङ्गमादाय हनुमान्मारुतात्मजः।\nअभिद्रुत्याददे प्राणान्वज्रवेगस्य रक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2029807, "chapter_id": 1650, "verse_number": "३-२८८-२८", "content_sanskrit": "नीलश्च महता ग्राव्णा दूपणावरजं हरिः।\nप्रमाथिनमभिद्रुत्य प्रममाथ महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2029808, "chapter_id": 1650, "verse_number": "३-२८८-२९", "content_sanskrit": "ततः प्रावर्तत पुनः संग्रामः कटुकोदयः।\nरामरावणसैन्यानामन्योन्यमभिधावताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2029809, "chapter_id": 1650, "verse_number": "३-२८८-३०", "content_sanskrit": "शतसो नैर्ऋतान्वन्या जघ्नुर्वन्यांश्च नैर्ऋताः।\nनैर्ऋतास्तत्रवध्यन्ते प्रायेण न तु वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2029810, "chapter_id": 1650, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि रामोपाख्यानपर्वणि अष्टाशीत्यधिकद्विशततमोऽध्यायः ॥ २८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]