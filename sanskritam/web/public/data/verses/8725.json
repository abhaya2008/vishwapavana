[{"id": 900009113, "chapter_id": 8725, "verse_number": "15.1", "content_sanskrit": "भाट्टास्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009114, "chapter_id": 8725, "verse_number": "15.2", "content_sanskrit": "किं च गङ्गात्वादिरूपात्स्वार्थादन्येन तीरत्वादिना..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009115, "chapter_id": 8725, "verse_number": "15.3", "content_sanskrit": "किं चानित्यत्वनित्यत्वानुमानयोर्घटे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009116, "chapter_id": 8725, "verse_number": "15.4", "content_sanskrit": "आक्षेपपक्षेऽपि व्यवहारादिना गृहीतशक्तेर्व्यक्तेः शब्दात्..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009117, "chapter_id": 8725, "verse_number": "15.5", "content_sanskrit": "किं च जातिर्व्यक्त्याश्रितेत्याक्षेपे ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900009118, "chapter_id": 8725, "verse_number": "15.6", "content_sanskrit": "किं च गोत्वमपि न स्वरूपमात्रेण बुद्धमाक्षेपकम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]