[{"id": 2058005, "chapter_id": 2254, "verse_number": "७-१८१-०x", "content_sanskrit": "`धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2058006, "chapter_id": 2254, "verse_number": "७-१८१-१", "content_sanskrit": "तस्मिन्हते महामाये महातेजसि राक्षसे।\nअमर्षिताः पाण्डवेयाः किमकुर्वन्महारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2058007, "chapter_id": 2254, "verse_number": "७-१८१-२", "content_sanskrit": "मर्दिताश्च भृशं युद्धे किमकुर्वन्त सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2058008, "chapter_id": 2254, "verse_number": "७-१८१-३", "content_sanskrit": "ये च तेऽभ्यद्रवन्द्रोणं व्यूढानीकं प्रहारिणः।\nसृञ्जयाः सह पाञ्चालैस्तेऽरुर्वन्किं महारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2058009, "chapter_id": 2254, "verse_number": "७-१८१-४", "content_sanskrit": "सौमदत्तिवधाद्द्रोणमायत्तं सैन्धवस्य च।\nअमर्षाज्जीवितं त्यक्त्वा गाहमानं वरूथिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2058010, "chapter_id": 2254, "verse_number": "७-१८१-५", "content_sanskrit": "जृम्भमाणमिव व्याघ्रं व्यात्ताननमिवान्तकम्।\nकथं प्रत्युद्ययुर्द्रोणमजय्यं कुरुसृञ्जयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2058011, "chapter_id": 2254, "verse_number": "७-१८१-६", "content_sanskrit": "आचार्यं ये च रक्षन्ति दुर्योधनपुरोगमाः।\nद्रौणिकर्णकृपास्तात ते ह्यकुर्वन्किमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2058012, "chapter_id": 2254, "verse_number": "७-१८१-७", "content_sanskrit": "भारद्वाजं जिघांसन्तौ सव्यसाचिवृकोदरौ।\nआर्च्छतां मामकान्युद्धे कथं सञ्जय शंस मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2058013, "chapter_id": 2254, "verse_number": "७-१८१-८", "content_sanskrit": "सिन्धुराजवधेनेमे घटोत्कचवधेन ते।\nअमर्षिताश्च सङ्क्रुद्धा रणं चक्रुः कथं युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2058014, "chapter_id": 2254, "verse_number": "७-१८१-९x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2058015, "chapter_id": 2254, "verse_number": "७-१८१-९", "content_sanskrit": "हैडिम्बिं निहतं दृष्ट्वा विशीर्णमिव पर्वतम्।\nबभूवुः पाण्डवाः सर्वे शोकबाष्पाकुलेक्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2058016, "chapter_id": 2254, "verse_number": "७-१८१-१०", "content_sanskrit": "वासुदेवस्तु हर्षेण महताऽभिपरिप्लुतः।\nननाद सिंहवन्नादं व्यथयन्निव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2058017, "chapter_id": 2254, "verse_number": "७-१८१-११", "content_sanskrit": "हतं घटोत्कचं ज्ञात्वा वासुदेवः प्रतापवान्।\nविनद्य च महानादं पर्यष्वजत फल्गुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2058018, "chapter_id": 2254, "verse_number": "७-१८१-१२", "content_sanskrit": "स विनद्य महानादमभीशून्सन्नियम्य च।\nननर्त हर्षसंवीतो वातोद्धूत इव द्रुमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2058019, "chapter_id": 2254, "verse_number": "७-१८१-१३", "content_sanskrit": "ततः परिष्वज्य पुनः पार्थमास्फोट्य चासकृत्।\nरथोपस्थगतो धीमान्प्राणदत्पुनरच्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2058020, "chapter_id": 2254, "verse_number": "७-१८१-१४", "content_sanskrit": "प्रहृष्टमनसं ज्ञात्वा वासुदेवं महाबलः।\nअर्जुनोऽथाब्रवीद्राजन्नातिहृष्टमना इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2058021, "chapter_id": 2254, "verse_number": "७-१८१-१५", "content_sanskrit": "अतिहर्षोऽयमस्थाने तवाद्य मधुसूदन।\nशोकस्थाने तु सम्प्राप्ते हैडिम्बस्य वधेन तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2058022, "chapter_id": 2254, "verse_number": "७-१८१-१६", "content_sanskrit": "विमुखानीह सैन्यानि हतं दृष्ट्वा घटोत्कचम्।\nवयं च भृशमुद्विग्ना हेडिम्बेस्तु निपातनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2058023, "chapter_id": 2254, "verse_number": "७-१८१-१७", "content_sanskrit": "नैतत्कारणमल्पं हि भविष्यति जनार्दन।\nतदद्य शंस मे पृष्टः सत्यं सत्यवतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2058024, "chapter_id": 2254, "verse_number": "७-१८१-१८", "content_sanskrit": "यद्येतन्न रहस्यं ते वक्तुमर्हस्यरिन्दम।\nधैर्यस्य विकृतिं ब्रूहि त्वमद्य मधुसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2058025, "chapter_id": 2254, "verse_number": "७-१८१-१९", "content_sanskrit": "समुद्रस्येव संशोषं मेरोरिव विसर्पणम्।\nतथैतदद्य मन्येऽहं तव कर्म जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2058026, "chapter_id": 2254, "verse_number": "७-१८१-२०x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2058027, "chapter_id": 2254, "verse_number": "७-१८१-२०", "content_sanskrit": "अतिहर्षमिमं प्राप्तं शृणु मे त्वं धनञ्जय।\nअतीव मनसः सद्यः प्रसादकरमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2058028, "chapter_id": 2254, "verse_number": "७-१८१-२१", "content_sanskrit": "शक्तिं घटोत्कचेनेमां व्यंसयित्वा महाद्युते।\nकर्णं निहतमेवाजौ विद्धि सद्यो धनञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2058029, "chapter_id": 2254, "verse_number": "७-१८१-२२", "content_sanskrit": "शक्तिहस्तं पुनः कर्णं को लोकेऽस्ति पुमानिह।\nय एनमभितस्तिष्ठेत्कार्तिकेयमिवाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2058030, "chapter_id": 2254, "verse_number": "७-१८१-२३", "content_sanskrit": "दिष्ट्याऽपनीतकवचो दिष्ट्याऽपहृतकुण्डलः।\nदिष्ट्या सा व्यंसिता शक्तिरमोघाऽस्य घटोत्कचे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2058031, "chapter_id": 2254, "verse_number": "७-१८१-२४", "content_sanskrit": "यदि हि स्यात्सकवचस्तथैव स्यात्सकुण्डलः।\nसामरानपि लोकांस्त्रीनेकः कर्णो जयेद्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2058032, "chapter_id": 2254, "verse_number": "७-१८१-२५", "content_sanskrit": "वासवो वा कुबेरो वा वरुणो वा जलेश्वरः।\nयमो वा नोत्सहेत्कर्णं रणे प्रतिसमासितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2058033, "chapter_id": 2254, "verse_number": "७-१८१-२६", "content_sanskrit": "गाण्डीवमुद्यम्य भवांश्चक्रं चाहं सुदर्शनम्।\nन शक्तौ स्वो रणे जेतुं तथायुक्तं नरर्षभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2058034, "chapter_id": 2254, "verse_number": "७-१८१-२७", "content_sanskrit": "त्वद्धितार्थं तु शक्रेण मायापहृतकुण्डलः।\nविहीनकवचश्चायं कृतः परपुरञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2058035, "chapter_id": 2254, "verse_number": "७-१८१-२८", "content_sanskrit": "उत्कृत्य कवचं यस्मात्कुण्डले विमले च ते।\nप्रादाच्छक्राय वै कर्णस्तस्माद्वैकर्तनः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2058036, "chapter_id": 2254, "verse_number": "७-१८१-२९", "content_sanskrit": "आशिविष इव क्रुद्वः स्तम्भितो मन्त्रतेजसा।\nतथाऽद्य भाति कर्णो मे शान्तज्वाल इवानलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2058037, "chapter_id": 2254, "verse_number": "७-१८१-३०", "content_sanskrit": "यदाप्रभृति कर्णाय शक्तिर्दत्ता महात्मना।\nवासवेन महाबाहो क्षिप्ता याऽसौ घटत्कचे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2058038, "chapter_id": 2254, "verse_number": "७-१८१-३१", "content_sanskrit": "कुण्डलाभ्यां निमायाथ दिव्येन कवचेन च।\nतां प्राप्यामन्यत वृषा सततं त्वां हतं रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2058039, "chapter_id": 2254, "verse_number": "७-१८१-३२", "content_sanskrit": "एवं गतोऽपि शक्योऽयं हतुं नान्येन केनचित्।\nऋते त्वां पुरुषव्याघ्र शपे सत्येन चानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2058040, "chapter_id": 2254, "verse_number": "७-१८१-३३", "content_sanskrit": "ब्रह्मण्यः सत्यवादी च सपस्वी नियतव्रतः।\nरिपुष्वपि दयावांश्च तस्मात्कर्णो वृषा स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2058041, "chapter_id": 2254, "verse_number": "७-१८१-३४", "content_sanskrit": "युद्धशौण्डो महाबाहुर्नित्योद्यतशरासनः।\nकेसरीव वने नर्दन्मत्तमातङ्गयूथपान्।\nविमर्दन्रथशार्दूलान्राजते रणमूर्धनिxxx॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2058042, "chapter_id": 2254, "verse_number": "७-१८१-३५", "content_sanskrit": "मध्यंगत इवादित्यो यो न शक्यो निरीक्षितुम्।\nत्वदीयैः पुरुषव्याघ्र योधमुख्यैर्महात्सभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2058043, "chapter_id": 2254, "verse_number": "७-१८१-३६", "content_sanskrit": "शरजालसहस्रांशुः शरदीव दिxxxx॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2058044, "chapter_id": 2254, "verse_number": "७-१८१-३७", "content_sanskrit": "तपान्ते जलदो यद्वच्छरधाराः क्षरन्मुहुः।\nदिव्यास्त्रजलदः कर्णः पर्जन्य इव वृष्टिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2058045, "chapter_id": 2254, "verse_number": "७-१८१-३८", "content_sanskrit": "त्रिदशैरपि चास्यद्भिः शरवर्षं समन्ततः।\nअशक्यस्तदयं जेतुं स्रवद्भिर्मांसशोणितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2058046, "chapter_id": 2254, "verse_number": "७-१८१-३९", "content_sanskrit": "कवचेन विहीनश्च कुण्डलाभ्यां च पाण्डव।\nसोऽद्य मानुषतां प्राप्तो विमुक्तः शक्रदत्तया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2058047, "chapter_id": 2254, "verse_number": "७-१८१-४०", "content_sanskrit": "एको हि योगोऽस्य भवेद्वधाय\nच्छिद्रे ह्येनं स्वप्रमत्तः प्रमत्तम्।\nकृच्छ्रं प्राप्तं रथचक्रे विमग्ने\nहन्याः पूर्वं त्वं तु संज्ञां विचार्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2058048, "chapter_id": 2254, "verse_number": "७-१८१-४१", "content_sanskrit": "न ह्युद्यतास्त्रं युधि हन्यादजय्य--\nमप्येकवीरो बलभित्सवज्रः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2058049, "chapter_id": 2254, "verse_number": "७-१८१-४२", "content_sanskrit": "जरासन्धश्चेदिराजो महात्मा\nमहाबाहुश्चैकलव्यो निषादः।\nएकैकशो निहताः सर्व एते\nयोगैस्तैस्तैस्त्वद्धितार्थं मयैव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2058050, "chapter_id": 2254, "verse_number": "७-१८१-४३", "content_sanskrit": "अथापरे निहता राक्षसेन्द्रा\nहिडिम्बकिर्मीरबकप्रधानाः।\nअलायुधः परचक्रावमर्दी\nघटोत्कचश्चोग्रकर्मा तरस्वी॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2058051, "chapter_id": 2254, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि घटोत्कचवधपर्वणि चतुर्दशरात्रियुद्धे एकाशीत्यधिकशततमोऽध्यायः॥ १८१ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१८१-१८ धैर्यस्य वैकृतं इति झ. पाठे अस्मत्पक्षक्षयेण तव हर्षोऽस्मद्धैर्यविनाशक इत्यर्थखः॥ ५-१८१-३१ कुण्डलाभ्यां निमाय विनिमयं कृत्वा॥ ५-१८१-३३ वृषा धर्मप्रधानः॥ ५-१८१-३७ पर्जन्यइव वृष्टिमान्। नेता नेतृभिरस्यद्भिः शरवर्षाणि वर्षताम्। सोऽद्य मानुषतामित्यादि क.ट.ड.पाठः॥ ५-१८१-१८१ एकाशीत्यधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]