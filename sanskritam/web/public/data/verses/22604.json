[{"id": 7002604000, "chapter_id": 22604, "verse_number": "४-९-१", "content_sanskrit": "सूत उवाच ।\nवटस्थानमथो वक्ष्ये तस्य मूले तु दक्षिणे ।\nत्रिहस्तवेदिमुपरि स्थापयेत्कलशत्रयम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002604001, "chapter_id": 22604, "verse_number": "४-९-२", "content_sanskrit": "गणेशं च शिवं विष्णुं पूजयित्वा हुनेच्चरुम् ।\nरक्तसूत्रैस्त्रिगुणितैः स्वर्णमेव पुरःसरम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002604002, "chapter_id": 22604, "verse_number": "४-९-३", "content_sanskrit": "यवक्षीरबलिं दद्यादुत्सृजेद्वाक्यमुच्चरन् ।\nयूपमारोपयेत्पश्चाद्वटमूलैः समर्पयेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002604003, "chapter_id": 22604, "verse_number": "४-९-४", "content_sanskrit": "यक्षान्नागांश्च गंधर्वान्सिद्धांश्चैव मरुद्गणान् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]