[{"id": 6000198000, "chapter_id": 10198, "verse_number": null, "content_sanskrit": "अथ द्वितीयाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000198001, "chapter_id": 10198, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_002/BhP_10.002.001.m4a", "display_order": 2}, {"id": 6000198002, "chapter_id": 10198, "verse_number": "१०-२-१", "content_sanskrit": "सुहृद्वधान्निववृते कंसस्तद्वाक्यसारवित्।\nवसुदेवोऽपि तं प्रीतः प्रशस्य प्राविशद् गृहम्॥ १०/२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_002/BhP_10.002.002.m4a", "display_order": 3, "topics": [{"text": "प्रथमजातस्य अर्भकस्य हननार्थमर्पणम्", "range": "१–८"}]}, {"id": 6000198003, "chapter_id": 10198, "verse_number": "१०-२-२", "content_sanskrit": "अथ काल उपावृत्ते देवकी सर्वदेवता।\nपुत्रान् प्रसुषुवे चाष्टौ कन्यां चैवानुवत्सरम्॥ १०/२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_002/BhP_10.002.003.m4a", "display_order": 4}, {"id": 6000198004, "chapter_id": 10198, "verse_number": "१०-२-३", "content_sanskrit": "कीर्तिमन्तं प्रथमजं कंसायानकदुन्दुभिः।\nअर्पयामास कृच्छ्रेण सोऽनृतादतिविह्वलः॥ १०/२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_002/BhP_10.002.004.m4a", "display_order": 5}, {"id": 6000198005, "chapter_id": 10198, "verse_number": "१०-२-४", "content_sanskrit": "किं दुस्सहं नु साधूनां विदुषां किमपेक्षितम्।\nकिमकार्यं कदर्याणां दुस्त्यजं किम् ऋतात्मनाम्॥ १०/२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_002/BhP_10.002.005.m4a", "display_order": 6}, {"id": 6000198006, "chapter_id": 10198, "verse_number": "१०-२-५", "content_sanskrit": "दृष्ट्वा समत्वं तच्छौरेः सत्ये चैव व्यवस्थितिम्।\nकंसस्तुष्टमना राजन् प्रहसन्निदमब्रवीत्॥ १०/२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_002/BhP_10.002.006.m4a", "display_order": 7}, {"id": 6000198007, "chapter_id": 10198, "verse_number": "१०-२-६", "content_sanskrit": "प्रतियातु कुमारोऽयं न ह्यस्मादस्ति मे भयम्।\nअष्टमाद् युवयोः पुत्रान्मृत्युर्मे विहितः किल॥ १०/२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_002/BhP_10.002.007.m4a", "display_order": 8}, {"id": 6000198008, "chapter_id": 10198, "verse_number": "१०-२-७", "content_sanskrit": "तथेति सुतमादाय ययावानकदुन्दुभिः।\nनाभ्यनन्दत तद्वाक्यमसतोऽविजितात्मनः॥ १०/२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_002/BhP_10.002.008.m4a", "display_order": 9}, {"id": 6000198009, "chapter_id": 10198, "verse_number": "१०-२-८", "content_sanskrit": "नन्दाद्या ये व्रजे गोपा याश्चामीषां च योषितः। वृष्णयो वसुदेवाद्या देवक्याद्या यदुस्‍त्रियः।\nसर्वे वै देवताप्राया उभयोरपि भारत॥ १०/२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_002/BhP_10.002.009.m4a", "display_order": 10}, {"id": 6000198010, "chapter_id": 10198, "verse_number": "१०-२-९", "content_sanskrit": "ज्ञातयो बन्धुसुहृदो ये च कंसमनुव्रताः।\nअसुराः सर्व एवैते लोकोपद्रवकारिणः॥ १०/२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_002/BhP_10.002.010.m4a", "display_order": 11, "topics": [{"text": "नारदोपदेशेन कंसेन देवकीवसुदेवयोर्निगडबन्धनम्", "range": "९–१६"}]}, {"id": 6000198011, "chapter_id": 10198, "verse_number": "१०-२-१०", "content_sanskrit": "गतेऽथ वसुदेवे तु देवकार्यार्थमुद्यतः।\nएतत् कंसाय भगवान्शंसयामास नारदः॥ १०/२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_002/BhP_10.002.011.m4a", "display_order": 12}, {"id": 6000198012, "chapter_id": 10198, "verse_number": "१०-२-११", "content_sanskrit": "भूमेर्भारावतीर्णानां दैत्यानां च वधोद्यमम्॥ १०/२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_002/BhP_10.002.012.m4a", "display_order": 13}, {"id": 6000198013, "chapter_id": 10198, "verse_number": "१०-२-१२", "content_sanskrit": "ऋषेर्विनिर्गमे कंसो यदून् मत्वा सुरानिति।\nदेवक्या गर्भसम्भूतं विष्णुं च स्ववधं प्रति॥ १०/२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_002/BhP_10.002.013.m4a", "display_order": 14}, {"id": 6000198014, "chapter_id": 10198, "verse_number": "१०-२-१३", "content_sanskrit": "देवकीं वसुदेवं च निगृह्य निगडैर्गृहे।\nजातं जातमहन् पुत्रं तयोरजनशङ्कया॥ १०/२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_002/BhP_10.002.014.m4a", "display_order": 15}, {"id": 6000198015, "chapter_id": 10198, "verse_number": "१०-२-१४", "content_sanskrit": "मातरं पितरं भ्रातॄन् सर्वांश्च सुहृदः सखीन्।\nनिघ्नन्त्यसुतृपो लुब्धा राजानः प्रायशो भुवि॥ १०/२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_002/BhP_10.002.015.m4a", "display_order": 16}, {"id": 6000198016, "chapter_id": 10198, "verse_number": "१०-२-१५", "content_sanskrit": "आत्मानमिह सञ्जातं जानन् प्राग् विष्णुना हतम्।\nमहासुरं कालनेमिं यदुभिः स व्यरुध्यत॥ १०/२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_002/BhP_10.002.016.m4a", "display_order": 17}, {"id": 6000198017, "chapter_id": 10198, "verse_number": "१०-२-१६", "content_sanskrit": "उग्रसेनं च पितरं यदुभोजान्धकाधिपम्।\nस्वयं निगृह्य बुभुजे शूरसेनान् महाबलः॥ १०/२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_002/BhP_10.002.017.m4a", "display_order": 18}, {"id": 6000198018, "chapter_id": 10198, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे द्वितीयाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]