[{"id": 2066911, "chapter_id": 2410, "verse_number": "९-२८-०x", "content_sanskrit": "स़ञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2066912, "chapter_id": 2410, "verse_number": "९-२८-१", "content_sanskrit": "ततः क्रुद्धा महाराज सौबलस्य पदानुगाः।\nत्यक्त्वा जीवितमाक्रन्दे पाण्डवान्पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2066913, "chapter_id": 2410, "verse_number": "९-२८-२", "content_sanskrit": "तानर्जुनः प्रत्यगृह्णात्सहदेवजये धृतः।\nभीमसेनश्च तेजस्वी क्रुद्धाशीविषदर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2066914, "chapter_id": 2410, "verse_number": "९-२८-३", "content_sanskrit": "शक्त्यृ-ष्टिप्रासहस्तानां सहदेवं जिघांसताम्।\nसङ्कल्पमकरोन्मोघं गाण्डीवेन धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2066915, "chapter_id": 2410, "verse_number": "९-२८-४", "content_sanskrit": "सङ्गृहीतायुधान्बाहून्योधानामभिधावताम्।\nभल्लैश्चिच्छेद बीभत्सुः शिरांस्यपि हयानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2066916, "chapter_id": 2410, "verse_number": "९-२८-५", "content_sanskrit": "ते हयाः प्रत्यपद्यन्त वसुधां विगतासवः।\nचरता लोकवीरेण प्रहताः सव्यसाचिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2066917, "chapter_id": 2410, "verse_number": "९-२८-६", "content_sanskrit": "ततो दुर्योधनो राजा दृष्ट्वा स्वबलसङ्क्षयम्।\nहतशेषान्समानीय क्रुद्धो रथगणान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2066918, "chapter_id": 2410, "verse_number": "९-२८-७", "content_sanskrit": "कुञ्जरांश्च हयांश्चैव पादातांश्च समन्ततः।\nउवाच दुःखितान्सर्वान्धार्तराष्ट्र इदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2066919, "chapter_id": 2410, "verse_number": "९-२८-८", "content_sanskrit": "समासाद्य रणे सर्वान्पाण्डवान्ससुहृद्गणान्।\nपाञ्चाल्यं चापि सबलं हत्वा शीघ्रं न्यवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2066920, "chapter_id": 2410, "verse_number": "९-२८-९", "content_sanskrit": "तस्य ते शिरसा गृह्य वचनं युद्धदुर्मदाः।\nअभ्युद्ययू रणे पार्थांस्तव पुत्रस्य शासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2066921, "chapter_id": 2410, "verse_number": "९-२८-१०", "content_sanskrit": "तानभ्यापततः शीघ्रं हतशेषान्महारणे।\nशरैराशीविषाकारैः पाण्डवाः समवाकिरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2066922, "chapter_id": 2410, "verse_number": "९-२८-११", "content_sanskrit": "तत्सैन्यं भरतश्रेष्ठ मुहूर्तेन महात्मभिः।\nअवध्यत रणं प्राप्य त्रातारं नाभ्यविन्दत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2066923, "chapter_id": 2410, "verse_number": "९-२८-१२", "content_sanskrit": "पलायमानं तु भयान्नावतिष्ठति दंशितम्।\nअश्वैर्विपरिधावद्भिः सैन्येन रजसा वृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2066924, "chapter_id": 2410, "verse_number": "९-२८-१३", "content_sanskrit": "न प्राज्ञायन्त समरे दिशः सप्रदिशस्तथा।\nततस्तु पाण्डवानीकान्निःसृत्य बहवो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2066925, "chapter_id": 2410, "verse_number": "९-२८-१४", "content_sanskrit": "अभ्यघ्नंस्तावकान्युद्धे मुहूर्तादिव भारत।\nततो निःशेषमभवत्तत्सन्यं तव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2066926, "chapter_id": 2410, "verse_number": "९-२८-१५", "content_sanskrit": "अक्षौहिण्यः समेतास्तु तव पुत्रस्य भारत।\nएकादश हता युद्धे ताः प्रभो पाण्डुसृञ्जयैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2066927, "chapter_id": 2410, "verse_number": "९-२८-१६", "content_sanskrit": "तेषु राजसहस्रेषु तावकेषु महात्मसु।\nएको दुर्योधनो राजन्नदृश्यत भृशं क्षतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2066928, "chapter_id": 2410, "verse_number": "९-२८-१७", "content_sanskrit": "ततो वीक्ष्य दिशः सर्वा दृष्ट्वा शून्यां च मेदिनीम्।\nविहीनः सर्वयोधैश्च पाण्डवान्वीक्ष्यं संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2066929, "chapter_id": 2410, "verse_number": "९-२८-१८", "content_sanskrit": "मुदितान्सर्वतः सिद्धान्नर्दमानान्समन्ततः।\nबाणशब्दरवांश्चैव श्रुत्वा तेषां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2066930, "chapter_id": 2410, "verse_number": "९-२८-१९", "content_sanskrit": "दुर्योधनो महाराज कश्मलेनाभिसंवृतः।\nअपयो मनश्चक्रे विहीनबलवाहनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2066931, "chapter_id": 2410, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि अष्टादशदिवसयुद्धे अष्टाविंशोऽध्यायः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]