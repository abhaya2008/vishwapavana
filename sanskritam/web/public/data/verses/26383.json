[{"id": 7006383000, "chapter_id": 26383, "verse_number": "२-४०-१", "content_sanskrit": "वैशम्पायन उवाच\nतत्तु धेन्वाः पयः पीत्वा बलर्द्पसमन्वितौ ।\nततस्तौ रामसहितौ प्रस्थितौ यदुपुङ्गवौ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006383001, "chapter_id": 26383, "verse_number": "२-४०-२", "content_sanskrit": "गोमन्तं पर्वतं द्रष्टुं मत्तनागेन्द्रगामिनौ ।\nजामदग्न्यप्रदिष्टेन मार्गेण वदतां वरौ ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006383002, "chapter_id": 26383, "verse_number": "२-४०-३", "content_sanskrit": "जामदग्न्यतृतीयास्ते त्रयस्त्रय इवाग्नयः ।\nशोभयन्ति स्म पन्थानं त्रिदिवं त्रिदशा इव ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006383003, "chapter_id": 26383, "verse_number": "२-४०-४", "content_sanskrit": "ते चाध्वविधिना सर्वे ततो वै दिवसक्रमात् ।\nगोमन्तमचलं प्राप्ता मन्दरं त्रिदशा इव ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006383004, "chapter_id": 26383, "verse_number": "२-४०-५", "content_sanskrit": "लताचारुविचित्रं च नानाद्रुमविभूषितम् ।\nनानागुरुपिनद्धाङ्गं चित्रं चित्रैर्मनोहरैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006383005, "chapter_id": 26383, "verse_number": "२-४०-६", "content_sanskrit": "द्विरेफगणसंकीर्णं शिलासंकटपादपम् ।\nमत्तबर्हिणनिर्घोषैर्नादितं मेघनादिभिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006383006, "chapter_id": 26383, "verse_number": "२-४०-७", "content_sanskrit": "गगनालग्नशिखरं जलदासक्तपादपम् ।\nमत्तद्विपविषाणाग्रैः परिघृष्टोपलाङ्कितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006383007, "chapter_id": 26383, "verse_number": "२-४०-८", "content_sanskrit": "कूजद्भिश्चाण्डजगणैः समन्तात् प्रतिनादितम् ।\nदरीप्रपाताम्बुरवैश्छन्नं शार्दूलतल्लजैः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006383008, "chapter_id": 26383, "verse_number": "२-४०-९", "content_sanskrit": "नीलाश्मचयसंघातैर्बहुवर्णं यथा घनम् ।\nधातुविस्रावदिग्धाङ्गं सानुप्रस्रवभूषितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006383009, "chapter_id": 26383, "verse_number": "२-४०-१०", "content_sanskrit": "कीर्णं सुरगणैः कान्तैर्मैनाकमिव कामगम् ।\nउच्छ्रितं सुविशालाग्रं समूलाम्बुपरिस्रवम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006383010, "chapter_id": 26383, "verse_number": "२-४०-११", "content_sanskrit": "सकाननदरीप्रस्थं श्वेताभ्रगणभूषितम् ।\nपनसाम्रातकाम्रौघैर्वेत्रस्यन्दनचन्दनैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006383011, "chapter_id": 26383, "verse_number": "२-४०-१२", "content_sanskrit": "तमालैलावनयुतं मरीचक्षुपसंकुलम् ।\nपिप्पलीवल्लिकलिलं चित्रमिङ्गुदिपादपैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006383012, "chapter_id": 26383, "verse_number": "२-४०-१३", "content_sanskrit": "द्रुमैः सर्जरसानां च सर्वतः परिशोभितम् ।\nप्रांशुशालवनैर्युक्तं बहुचित्रवनैर्युतम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006383013, "chapter_id": 26383, "verse_number": "२-४०-१४", "content_sanskrit": "सर्जनिम्बार्जुनवनं पाटलीकुलसंकुलम् ।\nहिन्तालैश्च तमालैश्च पुन्नागैश्चोपशोभितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006383014, "chapter_id": 26383, "verse_number": "२-४०-१५", "content_sanskrit": "जलेषु जलजैश्छन्नं स्थलेषु स्थलजैरपि ।\nपङ्कजैर्द्रुमखण्डैश्च सर्वतः प्रतिभूषितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006383015, "chapter_id": 26383, "verse_number": "२-४०-१६", "content_sanskrit": "जम्बूजम्बूलवृक्षाढ्यं कद्रुकन्दलभूषितम् ।\nचम्पकाशोकबकुलं बिल्वतिन्दुकशोभितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006383016, "chapter_id": 26383, "verse_number": "२-४०-१७", "content_sanskrit": "कुञ्जैश्च नागपुष्पैश्च समन्तादुपशोभितम् ।\nनागयूथसमाकीर्णं मृगसंघातशोभितम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006383017, "chapter_id": 26383, "verse_number": "२-४०-१८", "content_sanskrit": "सिद्धचारणरक्षोभिः सेवितप्रस्तरान्तरम् ।\nगन्धर्वैश्च समायुक्तं गुह्यकैः पक्षिभिस्तथा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006383018, "chapter_id": 26383, "verse_number": "२-४०-१९", "content_sanskrit": "विद्याधरगणैर्नित्यमनुकीर्णशिलातलम् ।\nसिंहशार्दूलसंनादैः सततं प्रतिनादितम् ।\nसेवितं वारिधाराभिश्चन्द्रपादैश्च शोभितम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006383019, "chapter_id": 26383, "verse_number": "२-४०-२०", "content_sanskrit": "स्तुतं त्रिदशगन्धर्वैरप्सरोभिरलंकृतम् ।\nवनस्पतीनां दिव्यानां पुष्पैरुच्चावचैः श्रितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006383020, "chapter_id": 26383, "verse_number": "२-४०-२१", "content_sanskrit": "शक्रवज्रप्रहाराणामनभिज्ञं कदाचन ।\nदावाग्निभयनिर्मुक्तं महावातभयोज्झितम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006383021, "chapter_id": 26383, "verse_number": "२-४०-२२", "content_sanskrit": "प्रपातप्रभवाभिश्च सरिद्भिरुपशोभितम् ।\nकाननैराननाकारैर्विशेषद्भिरिव श्रियम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006383022, "chapter_id": 26383, "verse_number": "२-४०-२३", "content_sanskrit": "जलशैवलशृङ्गाग्रैरुन्मिषन्तमिव श्रिया ।\nस्थलीभिर्मृगजुष्टाभिः कान्ताभिरुपशोभितम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006383023, "chapter_id": 26383, "verse_number": "२-४०-२४", "content_sanskrit": "पार्श्वैरुपलकल्माषैर्मेघैरिव विभूषितम् ।\nपादपच्छन्नभूमीभिः सपुष्पाभिः समन्ततः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006383024, "chapter_id": 26383, "verse_number": "२-४०-२५", "content_sanskrit": "मण्डितं वनराजीभिः प्रमदाभिः पतिर्यथा ।\nसुन्दरीभिर्दरीभिश्च कन्दराभिस्तथैव च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006383025, "chapter_id": 26383, "verse_number": "२-४०-२६", "content_sanskrit": "तेषु तेष्ववकाशेषु सदारामिव शोभितम् ।\nऔषधीदीप्तशिखरं वानप्रस्थनिषेवितम् ।\nजातरूपैर्वनोद्देशैः कृत्रिमैरिव भूषितम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006383026, "chapter_id": 26383, "verse_number": "२-४०-२७", "content_sanskrit": "मूलेन सुविशालेन शिरसाप्युच्छ्रितेन च ।\nपृथिवीमन्तरिक्षं च ग्राहयन्तमिव स्थितम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006383027, "chapter_id": 26383, "verse_number": "२-४०-२८", "content_sanskrit": "ते समासाद्य गोमन्तं रम्यं भूमिधरोत्तमम् ।\nरुचिरं रुरुचुः सर्वे वासायामरसंनिभाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006383028, "chapter_id": 26383, "verse_number": "२-४०-२९", "content_sanskrit": "रुरुहुस्ते गिरिवरं खमूर्ध्वमिव पक्षिणः ।\nअसज्जमाना वेगेन वैनतेयपराक्रमाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006383029, "chapter_id": 26383, "verse_number": "२-४०-३०", "content_sanskrit": "ते तु तस्योत्तरं शृङ्गमारूढास्त्रिदशा इव ।\nअगारं सहसा चक्रुर्मनसा निर्मितोपमम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006383030, "chapter_id": 26383, "verse_number": "२-४०-३१", "content_sanskrit": "निविष्टौ यादवौ दृष्टा जामदग्न्यो महामतिः ।\nरामोऽभिमतमक्लिष्टमाप्रष्टुमुपचक्रमे ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006383031, "chapter_id": 26383, "verse_number": "२-४०-३२", "content_sanskrit": "कृष्ण यास्याम्यहं तात पुरं शूर्पारकं विभो ।\nयुवयोर्नास्ति वैमुख्यं संग्रामे दैवतैरपि ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006383032, "chapter_id": 26383, "verse_number": "२-४०-३३", "content_sanskrit": "प्राप्तवानस्मि यां प्रीतिं मार्गानुगमनादपि ।\nसा मे कृष्णानुगृह्णाति शरीरमिदमव्ययम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006383033, "chapter_id": 26383, "verse_number": "२-४०-३४", "content_sanskrit": "इदं तत् स्थानमुद्दिष्टं यत्रायुधसमागमः ।\nयुवयोर्विहितो देवैः समयः साम्परायिकः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006383034, "chapter_id": 26383, "verse_number": "२-४०-३५", "content_sanskrit": "दैवानां मुख्य वैकुण्ठ विष्णो देवैरभिष्टुत ।\nकृष्ण सर्वस्य लोकस्य शृणु मे नैष्ठिकं वचः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006383035, "chapter_id": 26383, "verse_number": "२-४०-३६", "content_sanskrit": "यदिदं प्रस्तुतं कर्म त्वया गोविन्द लौकिकम् ।\nमानुषाणां हितार्थाय लोके मानुषदेहिना ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006383036, "chapter_id": 26383, "verse_number": "२-४०-३७", "content_sanskrit": "तस्यायं प्रथमः कल्पः कालेन तु नियोजितः ।\nजरासंधेन वै सार्धं संग्रामे समुपस्थिते ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006383037, "chapter_id": 26383, "verse_number": "२-४०-३८", "content_sanskrit": "तत्रायुधबलं चैव रूपं च रणकर्कशम् ।\nस्वयमेवात्मना कृष्ण त्वमात्मानं विधत्स्व ह ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006383038, "chapter_id": 26383, "verse_number": "२-४०-३९", "content_sanskrit": "चक्रोद्यतकरं दृष्ट्वा त्वां गदापाणिमाहवे ।\nचतुर्द्विगुणपीनांसं बिभ्येदपि शतक्रतुः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006383039, "chapter_id": 26383, "verse_number": "२-४०-४०", "content_sanskrit": "अद्यप्रभृति ते यात्रा स्वर्गोक्ता समुपस्थिता ।\nपृथिव्यां पार्थिवेन्द्राणां कृतास्त्रे त्वयि मानद ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006383040, "chapter_id": 26383, "verse_number": "२-४०-४१", "content_sanskrit": "वैनतेयस्य चाह्वानं वाहनं ध्वजकर्मणि ।\nकुरु शीघ्रं महाबाहो गोविन्द वदतां वर ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006383041, "chapter_id": 26383, "verse_number": "२-४०-४२", "content_sanskrit": "युद्धकामा नृपतयस्त्रिदिवाभिमुखोद्यताः ।\nधार्तराष्ट्रस्य वशगास्तिष्ठन्ति रणवृत्तयः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006383042, "chapter_id": 26383, "verse_number": "२-४०-४३", "content_sanskrit": "राज्ञां निधनदृष्टार्था वैधव्येनाधिवासिता ।\nएकवेणीधरा चेयं वसुधा त्वां प्रतीक्षते ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006383043, "chapter_id": 26383, "verse_number": "२-४०-४४", "content_sanskrit": "सग्रहं कृष्ण नक्षत्रं संक्षिप्यारिविमर्दन ।\nत्वयि मानुष्यमापन्ने युद्धे च समुपस्थिते ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006383044, "chapter_id": 26383, "verse_number": "२-४०-४५", "content_sanskrit": "त्वरस्व कृष्ण युद्धाय दानवानां वधाय च ।\nस्वर्गाय च नरेन्द्राणां देवतानां सुखाय च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006383045, "chapter_id": 26383, "verse_number": "२-४०-४६", "content_sanskrit": "सत्कृतोऽहं त्वया कृष्ण लोकैश्च सचराचरैः ।\nत्वया सत्कृतरूपेण येन सत्कृतवानहम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006383046, "chapter_id": 26383, "verse_number": "२-४०-४७", "content_sanskrit": "साधयामि महाबाहो भवतः कार्यसिद्धये ।\nस्मर्तव्यश्चास्मि युद्धेषु कान्तारेषु महीक्षिताम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006383047, "chapter_id": 26383, "verse_number": "२-४०-४८", "content_sanskrit": "इत्युक्त्वा जामदग्न्यस्तु कृष्णमक्लिष्टकारिणम् ।\nजयाशिषा वर्द्धयित्वा जगामाभीप्सितां दिशम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]