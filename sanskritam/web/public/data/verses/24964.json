[{"id": 7004964000, "chapter_id": 24964, "verse_number": "७-१-१४७-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि ब्रह्मकुण्डमनुत्तमम् ।\nतस्यैव नैरृते भागे ब्रह्मणा निर्मितं पुरा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004964001, "chapter_id": 24964, "verse_number": "७-१-१४७-२", "content_sanskrit": "यदा तु ऋक्षराजेन सोमनाथः प्रति ष्ठितः ।\nतदा ब्रह्मादयो देवाः सर्वे तत्र समागताः ।\nप्रतिष्ठार्थं हि देवस्य शशांकेन निमन्त्रिताः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004964002, "chapter_id": 24964, "verse_number": "७-१-१४७-३", "content_sanskrit": "अथाऽब्रवीन्निशानाथो ब्रह्माणं विनयान्वितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004964003, "chapter_id": 24964, "verse_number": "७-१-१४७-४", "content_sanskrit": "कृतं भवद्भिर्जानाति स्थापनं वै यथा जनः ।\nतथा कुरु सुरश्रेष्ठ चिह्नमात्मसमुद्भवम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004964004, "chapter_id": 24964, "verse_number": "७-१-१४७-५", "content_sanskrit": "एवं श्रुत्वा तदा ब्रह्मा ध्यानं कृत्वा तु निश्चलम् ।\nआह्वयत्सर्वतीर्थानि पुष्करादीनि सर्वशः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004964005, "chapter_id": 24964, "verse_number": "७-१-१४७-६", "content_sanskrit": "स्वर्गे वै यानि तीर्थानि तथैव च रसातले ।\nतपःसामर्थ्ययोगेन ब्रह्मणाऽकर्षितानि च ।\nअतस्तस्यैव नाम्ना तु ब्रह्मकुण्डं तु गीयते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004964006, "chapter_id": 24964, "verse_number": "७-१-१४७-७", "content_sanskrit": "गणानां च सहस्रैस्तु चतुर्दशभिरीक्ष्यते ।\nअतश्चाभक्तियुक्तानां दुष्प्राप्यं तीर्थमुत्तमम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004964007, "chapter_id": 24964, "verse_number": "७-१-१४७-८", "content_sanskrit": "अथाब्रवीत्सर्वदेवान्ब्रह्मा लोकपितामहः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004964008, "chapter_id": 24964, "verse_number": "७-१-१४७-९", "content_sanskrit": "अत्र कुण्डे नरः स्नात्वा यः पितॄंस्तर्पयिष्यति ।\nअग्निष्टोमफलं सव लप्स्यते स च मानवः ।\nतत्प्रसादात्स्वर्गलोके विमानेन चरिष्यति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004964009, "chapter_id": 24964, "verse_number": "७-१-१४७-१०", "content_sanskrit": "गोदानं चाश्वदानं च तथा स्वर्णकमण्डलुम् ।\nदद्याद्विप्राय विदुषे सर्वपापापनुत्तये ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004964010, "chapter_id": 24964, "verse_number": "७-१-१४७-११", "content_sanskrit": "पौर्णमास्यां महादेवि तथा च प्रतिपद्दिने ।\nसर्वपापविनाशार्थं तत्र स्नाति सरस्वती ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004964011, "chapter_id": 24964, "verse_number": "७-१-१४७-१२", "content_sanskrit": "सिद्धं रसायनं देवि तत्र वै ह्युदकं प्रिये ।\nनानावर्णसमायुक्तमुपदेशेन सिद्ध्यति ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004964012, "chapter_id": 24964, "verse_number": "७-१-१४७-१३", "content_sanskrit": "दारिद्र्यदुःखरुक्छोकान्मानवः सेवते कथम् ।\nब्रह्मकुण्डमनुप्राप्य कल्पवृक्षमिवापरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004964013, "chapter_id": 24964, "verse_number": "७-१-१४७-१४", "content_sanskrit": "देव्युवाच ।\nभगवन्विस्तराद्ब्रूहि ब्रह्मकुण्डमहोदयम् ।\nसर्वप्राणिहितार्थाय विस्तराद्वद मे प्रभो ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004964014, "chapter_id": 24964, "verse_number": "७-१-१४७-१५", "content_sanskrit": "ब्रह्मकुंडस्य माहात्म्यं श्रोतुं मे कौतुकं महत् ।\nलोकानां दुःखनाशाय दारिद्यक्षयहेतवे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004964015, "chapter_id": 24964, "verse_number": "७-१-१४७-१६", "content_sanskrit": "भगवन्मानुषाः सर्वे दुःखशोकनिपीडिताः ।\nभ्रमंति सकलं जन्म रसायनविमोहिताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004964016, "chapter_id": 24964, "verse_number": "७-१-१४७-१७", "content_sanskrit": "तेषां हिताय मे ब्रूहि निर्वाणं रसमुत्तमम् ।\nआदाविह शरीरं तु अक्षय्यं तु यथा भवेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004964017, "chapter_id": 24964, "verse_number": "७-१-१४७-१८", "content_sanskrit": "अष्टसिद्धिसमा युक्तं सर्वविद्यासमन्वितम् ।\nकामरूपं क्रियायुक्तं सर्वव्याधिविवर्जितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004964018, "chapter_id": 24964, "verse_number": "७-१-१४७-१९", "content_sanskrit": "ततस्तु परमं देव निर्वाणं येन वै लभेत् ।\nमानवः कृतकृत्यश्च जायते च यथा प्रभो ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004964019, "chapter_id": 24964, "verse_number": "७-१-१४७-२०", "content_sanskrit": "तथा कथय मे देव दयां कृत्वा जगत्प्रभो ।\nनिर्वाणपरमं कल्पं सर्वभ्रांतिविवर्जितम् ।\nप्रसिद्धं सुखदं दिव्यं समा चक्ष्व महेश्वर ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004964020, "chapter_id": 24964, "verse_number": "७-१-१४७-२१", "content_sanskrit": "ईश्वर उवाच ।\nसाधुसाधु महादेवि लोकानां हितकारिणि ।\nमर्त्यलोके महादेवि तीर्थं तीर्थवरं शुभम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004964021, "chapter_id": 24964, "verse_number": "७-१-१४७-२२", "content_sanskrit": "प्रभासं परमं ख्यातं तच्च द्वादशयोजनम् ।\nतत्र सोमेश्वरो देवस्त्रिषु लोकेषु विश्रुतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004964022, "chapter_id": 24964, "verse_number": "७-१-१४७-२३", "content_sanskrit": "तस्य पूर्वे समाख्यातः श्रीकृष्णो दैत्यसूदनः ।\nचण्डिका योगिनी तत्र सखीभिः परिवारिता ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004964023, "chapter_id": 24964, "verse_number": "७-१-१४७-२४", "content_sanskrit": "ततः पूर्वे दिशां भागे चतुर्वक्त्रेण निर्मितम् ।\nतीर्थात्तीर्थं वरं दिव्यं सर्वाश्चर्यमयं शुभम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004964024, "chapter_id": 24964, "verse_number": "७-१-१४७-२५", "content_sanskrit": "सेवितं सर्वदेवैस्तु सिद्धैः साध्यैर्ग्रहैस्तथा ।\nअप्सरोमुनिभिर्दिव्यैर्यक्षैश्च पन्नगैः सदा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004964025, "chapter_id": 24964, "verse_number": "७-१-१४७-२६", "content_sanskrit": "सिद्ध्यर्थं सर्वकामार्थं दिव्यभोगावहं शुभम् ।\nब्रह्मकुण्डमिति ख्यातं ब्रह्मणा निर्मितं यतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004964026, "chapter_id": 24964, "verse_number": "७-१-१४७-२७", "content_sanskrit": "तस्य वायव्यकोणे तु हिर ण्येशः स्वयं स्थितः ।\nतमाराध्य महादेवं हिरण्येश्वरमुत्तमम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004964027, "chapter_id": 24964, "verse_number": "७-१-१४७-२८", "content_sanskrit": "महामन्त्रं जपेत्क्षिप्रं दशांशं होमयेत्सुधीः ।\nहोमेन सिद्ध्यते मन्त्रः सत्यं सत्यं वरानने ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004964028, "chapter_id": 24964, "verse_number": "७-१-१४७-२९", "content_sanskrit": "तस्योत्तरे तु दिग्भागे किञ्चिदीशानमाश्रितः ।\nचतुर्वक्त्रो महादेवि क्षेत्रपो लिंगरूपधृक् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004964029, "chapter_id": 24964, "verse_number": "७-१-१४७-३०", "content_sanskrit": "तत्स्थानं रक्षते देवि लिंगरूपेण शंकरः ।\nतमाराध्य प्रयत्नेन ततः कुण्डं समाश्रयेत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004964030, "chapter_id": 24964, "verse_number": "७-१-१४७-३१", "content_sanskrit": "सर्वैश्वर्यमयं देवि नानावर्णविचित्रितम् ।\nकुण्डस्यास्येशदिग्भागे भैरवेश्वरमुत्तमम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004964031, "chapter_id": 24964, "verse_number": "७-१-१४७-३२", "content_sanskrit": "दुर्गन्धा भासुरा देवि वहते रसरूपिणी ।\nतस्या रसेन संयुक्तं पृथग्वर्णं हि कर्बुरम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004964032, "chapter_id": 24964, "verse_number": "७-१-१४७-३३", "content_sanskrit": "मेघवर्णं महादिव्यं राजतं च पुनः शुभम् ।\nकपिलं दुग्धवर्णं च कर्पूराभं सुशोभनम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004964033, "chapter_id": 24964, "verse_number": "७-१-१४७-३४", "content_sanskrit": "कदा कस्तूरिकाभासं कुंकुमच्छविकावहम् ।\nसौगन्धं चंदनोपेतं कदाचिद्रौधि रोदकम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004964034, "chapter_id": 24964, "verse_number": "७-१-१४७-३५", "content_sanskrit": "एते रसाश्च विविधा दृश्यंते तत्र सर्वदा ।\nयस्य तुष्टो महादेवः सिद्ध्यते तस्य तत्क्षणात् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004964035, "chapter_id": 24964, "verse_number": "७-१-१४७-३६", "content_sanskrit": "रजतं क्षिप्यते तत्र सुवर्ण मिव जायते ।\nप्रत्यक्षमेव तत्रैव रसायनमनुत्तमम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004964036, "chapter_id": 24964, "verse_number": "७-१-१४७-३७", "content_sanskrit": "पश्यंति मानवा देवि कौतुकं तत्क्षणाद्भृशम् ।\nरसं हि परमं दिव्यं तत्रस्थं च कलौ युगे ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004964037, "chapter_id": 24964, "verse_number": "७-१-१४७-३८", "content_sanskrit": "सिद्धं सिद्धरसं पुंसां व्याधीनां क्षयकारकम् ।\nहेमबीजमयं दिव्यं ब्रह्मकुण्डोद्भवं महत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004964038, "chapter_id": 24964, "verse_number": "७-१-१४७-३९", "content_sanskrit": "इदानीं ते प्रवक्ष्यामि मनुष्याणां हिताय वै ।\nदारिद्र्यं क्षयमाप्नोति तत्क्षणाच्च यशस्विनि ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004964039, "chapter_id": 24964, "verse_number": "७-१-१४७-४०", "content_sanskrit": "आदावेव प्रकुर्वन्ति ताम्रकुम्भं दृढं शुभम् ।\nतीर्थोदकं क्षिपेत्तत्र पत्रैस्ताम्रस्तथा युतम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004964040, "chapter_id": 24964, "verse_number": "७-१-१४७-४१", "content_sanskrit": "निक्षिप्य भूमौ तत्कुम्भं ज्वालयेदनलं ततः ।\nचुह्लीरूपेण षण्मासं पाचयेत्तं शनैःशनैः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004964041, "chapter_id": 24964, "verse_number": "७-१-१४७-४२", "content_sanskrit": "पश्चादुद्धृत्य तं कुम्भं पुनरेव जलं क्षिपेत् ।\nमासमेकं पुनः कुर्यान्मासमेकं पुनर्भृशम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004964042, "chapter_id": 24964, "verse_number": "७-१-१४७-४३", "content_sanskrit": "ततः सर्वाणि खण्डानि एकीकृत्य प्रयत्नतः ।\nपुनरेवोदकेनैव प्लाव्य चावर्तयेत्पुनः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004964043, "chapter_id": 24964, "verse_number": "७-१-१४७-४४", "content_sanskrit": "कांचनं जायते तत्र यदि तुष्टो महेश्वरः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004964044, "chapter_id": 24964, "verse_number": "७-१-१४७-४५", "content_sanskrit": "सिद्धिं शरीरजां देवि यदीच्छेन्मानवोत्तमः ।\nस स्नानमादितः कृत्वा संवत्सरत्रयं पुनः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004964045, "chapter_id": 24964, "verse_number": "७-१-१४७-४६", "content_sanskrit": "मौनेन नियमेनैव महामंत्रजपान्वितः ।\nपूजयेच्च हिरण्येशं क्षेत्रपालं प्रयत्नतः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004964046, "chapter_id": 24964, "verse_number": "७-१-१४७-४७", "content_sanskrit": "पंचोपचारसंयुक्तं ध्यानधारणसंयुतम् ।\nतीर्थोदकेन पाकं वै पेयं तद्वदुदुम्बरे ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004964047, "chapter_id": 24964, "verse_number": "७-१-१४७-४८", "content_sanskrit": "एवं वर्षत्रयेणैव दिव्यदेहः प्रजायते ।\nतेजस्वी वलवान्प्राज्ञः सर्वव्याधिविवर्जितः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004964048, "chapter_id": 24964, "verse_number": "७-१-१४७-४९", "content_sanskrit": "जीवेद्वर्षेशतान्येव त्रीणि दुःखविवर्जितः ।\nवर्षत्रयमविच्छिन्नं यस्तत्र स्नानमाचरेत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004964049, "chapter_id": 24964, "verse_number": "७-१-१४७-५०", "content_sanskrit": "वागीश्वरीं जपेन्नित्यं पूजाहोमसमन्वितः ।\nतस्य प्रवर्तते वाणी सिद्धिः सारस्वती भवेत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004964050, "chapter_id": 24964, "verse_number": "७-१-१४७-५१", "content_sanskrit": "संस्कृतं प्राकृतं चैवापभ्रंशं भूतभाषितम् ।\nगांगस्रोतःप्रवाहेण उद्गिरेद्गिरमात्मवान् ।\nअश्रान्तां च वरारोहे ह्यविच्छिन्नां च संततम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004964051, "chapter_id": 24964, "verse_number": "७-१-१४७-५२", "content_sanskrit": "वदेद्वादिसहस्रैस्तु न श्रमस्तस्य जायते ।\nतीर्थस्यास्य प्रभावेण सर्वशास्त्रविशारदाः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004964052, "chapter_id": 24964, "verse_number": "७-१-१४७-५३", "content_sanskrit": "पंडिता गर्विताः सर्वे तर्कशास्त्रविशारदाः ।\nआगच्छन्ति समं तात विद्ययोद्धतकन्धराः ।\nन शक्नुवंति ते वक्तुं द्रष्टुं वक्त्रमपि प्रिये ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004964053, "chapter_id": 24964, "verse_number": "७-१-१४७-५४", "content_sanskrit": "वादिनां च सहस्राणि भनक्त्येवं निरीक्षणात् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004964054, "chapter_id": 24964, "verse_number": "७-१-१४७-५५", "content_sanskrit": "उद्वाहयति शास्त्राणि विबुद्धार्थानि सत्वरम् ।\nविमलं पाञ्चरात्रं च वैष्णवं शैवमेव च ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004964055, "chapter_id": 24964, "verse_number": "७-१-१४७-५६", "content_sanskrit": "इतिहासपुराणं च भूततंत्रं च गारुडम् ।\nभैरवं च महातंत्रं कुलमार्गं द्विधा प्रिये ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004964056, "chapter_id": 24964, "verse_number": "७-१-१४७-५७", "content_sanskrit": "रथप्रवरवेगेन वाणी चास्खलिता भवेत् ।\nनश्यंति वादिनः सर्वे गरुडस्येव पन्नगाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004964057, "chapter_id": 24964, "verse_number": "७-१-१४७-५८", "content_sanskrit": "न दारिद्र्यं न रोगश्च न दुःखं मानसं पुनः ।\nराजमान्यो महामानी भवेद्ब्रह्मप्रसादतः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004964058, "chapter_id": 24964, "verse_number": "७-१-१४७-५९", "content_sanskrit": "उत्साहबलसंयुक्तो देववज्जीवते सुधीः ।\nदाता भोक्ता च वाग्ग्मी च तीर्थस्यास्य प्रसादतः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004964059, "chapter_id": 24964, "verse_number": "७-१-१४७-६०", "content_sanskrit": "तैलाभ्यक्तस्य यत्तेजो जायते मनुजेषु च ।\nस्नातमात्रे तथा तेजस्तीर्थस्यैव प्रसादतः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004964060, "chapter_id": 24964, "verse_number": "७-१-१४७-६१", "content_sanskrit": "यत्पापं कुरुते जंतुः पैशुन्यं च कृतघ्नताम् ।\nमित्रद्रोहे च यत्पापं यत्पापं पारदारिकम् ।\nतत्सर्वं विलयं याति कुंडस्नानरतस्य च ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004964061, "chapter_id": 24964, "verse_number": "७-१-१४७-६२", "content_sanskrit": "मुशलं लङ्घयेद् यस्तु यो गास्त्यजति वै द्विजः ।\nतत्पापं क्षयमाप्नोति ब्रह्मकुण्डस्य दर्शनात् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004964062, "chapter_id": 24964, "verse_number": "७-१-१४७-६३", "content_sanskrit": "पृथिव्यां यानि तीर्थानि दैवतानि तथा पुनः ।\nपूजितानि च सर्वाणि कुण्डस्नानप्रभावतः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004964063, "chapter_id": 24964, "verse_number": "७-१-१४७-६४", "content_sanskrit": "सप्तजन्मार्जितं पापं दर्शनात्क्षयमाव्रजेत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004964064, "chapter_id": 24964, "verse_number": "७-१-१४७-६५", "content_sanskrit": "यत्पापं गुरुगोघ्ने च परस्वहरणेषु च ।\nतत्पापं क्षयमाप्नोति ब्रह्मकुण्डनिषेवणात् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004964065, "chapter_id": 24964, "verse_number": "७-१-१४७-६६", "content_sanskrit": "प्रदक्षिणं च यः कुर्यात्स्नात्वा कुण्डस्य नामतः ।\nसंख्यया पंचदश वै शृणु तस्यापि यत्फलम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004964066, "chapter_id": 24964, "verse_number": "७-१-१४७-६७", "content_sanskrit": "प्रदक्षिणीकृता तेन सप्तद्वीपा वसुन्धरा ।\nसप्तपातालसहिता तीर्थकोटिभिरावृता ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004964067, "chapter_id": 24964, "verse_number": "७-१-१४७-६८", "content_sanskrit": "आहारमात्रं यो दद्यात्तत्र वेदविदां वरे ।\nलक्षभोज्यं कृतं तेन तीर्थस्यास्य प्रभावतः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004964068, "chapter_id": 24964, "verse_number": "७-१-१४७-६९", "content_sanskrit": "ब्रह्मेश्वरं च संपूज्य हिरण्येश्वरमुत्तमम् ।\nक्षेत्रपालं चतुर्वक्त्रं पूजयेच्चिन्तितं लभेत् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004964069, "chapter_id": 24964, "verse_number": "७-१-१४७-७०", "content_sanskrit": "एकविंशत्कुलै र्युक्तः सर्वपापविवर्जितः ।\nब्रह्मलोकं स वै याति नात्र कार्या विचारणा ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004964070, "chapter_id": 24964, "verse_number": "७-१-१४७-७१", "content_sanskrit": "विरंचिकुण्डे स्नात्वा वा यो जपेद्वेदमातरम् ।\nलक्षजाप्यविधानेन स मुक्तः पातकैर्भवेत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004964071, "chapter_id": 24964, "verse_number": "७-१-१४७-७२", "content_sanskrit": "स एव पुण्यकर्त्ता च स एव पुरुषोत्तमः ।\nयात्रा तत्र कृता येन ब्रह्मकुण्डे वरानने ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004964072, "chapter_id": 24964, "verse_number": "७-१-१४७-७३", "content_sanskrit": "अष्टाशीतिसहस्राणि ऋषीणामूर्ध्वरेतसाम् ।\nब्रह्मकुण्डं समाश्रित्य ब्रह्मदेवमुपासते ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004964073, "chapter_id": 24964, "verse_number": "७-१-१४७-७४", "content_sanskrit": "तावद्गर्जंति तीर्थानि त्रैलोक्ये सचराचरे ।\nयावद्ब्रह्मेश्वरं तीर्थं न पश्यन्ति नराः प्रिये ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004964074, "chapter_id": 24964, "verse_number": "७-१-१४७-७५", "content_sanskrit": "ब्रह्मकुण्डे च पानीयं ये पिबन्ति नराः सकृत् ।\nन तेषां संक्रमेत्पापं वाचिकं मानसं तनौ ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004964075, "chapter_id": 24964, "verse_number": "७-१-१४७-७६", "content_sanskrit": "ब्रह्मांडोत्तरमध्ये तु यानि तीर्थानि संति वै ।\nतेषां पुण्यमवाप्नोति ब्रह्मकुण्डे प्रदक्षिणात् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004964076, "chapter_id": 24964, "verse_number": "७-१-१४७-७७", "content_sanskrit": "याज्ञवल्क्यो महात्मा च परब्रह्मस्वरूपवान् ।\nसोऽपि कुंडं न मुंचेत निकुं भस्तु गणस्तथा ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004964077, "chapter_id": 24964, "verse_number": "७-१-१४७-७८", "content_sanskrit": "इति संक्षेपतः प्रोक्तं माहात्म्यं ब्रह्मकुण्डजम् ।\nतव स्नेहेन देवेशि किमन्यत्परिपृच्छसि ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004964078, "chapter_id": 24964, "verse_number": "७-१-१४७-७९", "content_sanskrit": "य इदं शृणुयान्मर्त्यः सम्यक्छ्रद्धासमन्वितः ।\nस मुक्तः पातकैः सर्वैर्ब्रह्मलोकं च गच्छति ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}]