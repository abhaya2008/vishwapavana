[{"id": 2099772, "chapter_id": 3135, "verse_number": "१३-२६५-१", "content_sanskrit": "युधिष्ठिर उवाच।\nदुर्वाससः प्रसादात्ते शंकरांशस्य माघव।\nअवाप्तमिह विज्ञानं तन्मे व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2099773, "chapter_id": 3135, "verse_number": "१३-२६५-२", "content_sanskrit": "महाभाग्यं च यत्तस्य नामानि च महात्मनः।\nतत्त्वमो ज्ञातुमिच्छामि सर्वं मतिमतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2099774, "chapter_id": 3135, "verse_number": "१३-२६५-३x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2099775, "chapter_id": 3135, "verse_number": "१३-२६५-३", "content_sanskrit": "हन्ति ते कीर्तयिष्यामि नमस्कृत्य कपर्दिने।\nयदवाप्तं मया राजञ्श्रेयो यच्चार्जितं यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2099776, "chapter_id": 3135, "verse_number": "१३-२६५-४", "content_sanskrit": "प्रयतः प्रातरुत्थाय यस्त्वधीयेद्विशाम्पते।\nप्राञ्जलिः शतरुद्रीयं नास्य किञ्चनि दुर्लभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2099777, "chapter_id": 3135, "verse_number": "१३-२६५-५", "content_sanskrit": "`शिवः सर्वकतो रुद्रः स्रष्टा यस्त्वं शृणुष्व मे।\nप्रजापतिस्तमसृजत्तमसोऽन्ते महातपाः।\nशङ्करस्त्वसृजत्तात प्रजाः स्थावरजङ्गमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2099778, "chapter_id": 3135, "verse_number": "१३-२६५-६", "content_sanskrit": "नास्ति किञ्चित्परं भूतं महादेवाद्विशाम्पते।\nइह त्रिष्वपि लोकेषु भूतानां प्रभवो हि सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2099779, "chapter_id": 3135, "verse_number": "१३-२६५-७", "content_sanskrit": "न चैवोत्सहते स्थातुं कश्चिदग्रे महात्मनः।\nन हि भूतं समं तेन त्रिषु लोकेषु विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2099780, "chapter_id": 3135, "verse_number": "१३-२६५-८", "content_sanskrit": "गन्धेनापि हि सङ्ग्रामे तस्य क्रुद्धस्य शत्रवः।\nविसंज्ञा हतभूयिष्ठा वेपनेते च पतन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2099781, "chapter_id": 3135, "verse_number": "१३-२६५-९", "content_sanskrit": "घोरं च निनदं तस्य पर्जन्यनिनदोपम्।\nश्रुत्वा विशीर्येद्धृदयं देवानामपि संयुगे।\nयं चाक्ष्णा घोररूपेण पश्येद्दग्धः पतेदधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2099782, "chapter_id": 3135, "verse_number": "१३-२६५-१०", "content_sanskrit": "न सुरा नासुरा लोके न गन्धर्वा न पन्नगाः।\nकुपिते सुखमेधन्ते तस्मिन्नपि गुहागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2099783, "chapter_id": 3135, "verse_number": "१३-२६५-११", "content_sanskrit": "प्रजापतेश्च दक्षस्य यजतो वितते क्रतौ।\nविव्याध कुपितो यज्ञं निर्भयस्तु भवस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2099784, "chapter_id": 3135, "verse_number": "१३-२६५-१२", "content_sanskrit": "धनुषा वाणमुत्सृज्य सुघोरं विननाद च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2099785, "chapter_id": 3135, "verse_number": "१३-२६५-१३", "content_sanskrit": "ते न शर्म कुतः शान्ति विषादं लेभिरे सुराः।\nविद्धे च सहसा यज्ञे कुपिते च महेश्वरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2099786, "chapter_id": 3135, "verse_number": "१३-२६५-१४", "content_sanskrit": "तेन ज्यातलघोषेण सर्वे लोकाः समाकुलाः।\nबभूवुरवशाः पार्थ विषेदुश्च सुरासुराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2099787, "chapter_id": 3135, "verse_number": "१३-२६५-१५", "content_sanskrit": "आपश्चुक्षुभिरे चैव चकम्पे च वसुन्धरः।\nव्यद्रवग्निरयश्चापि द्यौः पफाल च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2099788, "chapter_id": 3135, "verse_number": "१३-२६५-१६", "content_sanskrit": "अन्धेन तमसा लोकाः प्रावृता न चकाशिरे।\nप्रनष्टा ज्योतिषां भाश्च सह सूर्येण भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2099789, "chapter_id": 3135, "verse_number": "१३-२६५-१७", "content_sanskrit": "भृशं भीतास्ततः शान्तिं चत्रुः स्वस्त्ययनानि च।\nऋषयः सर्वभूतानामात्मनश्च हितैषिमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2099790, "chapter_id": 3135, "verse_number": "१३-२६५-१८", "content_sanskrit": "ततः सोऽभ्यद्रवद्देवान्रुद्रो रौद्रपराक्रमः।\nभगस्य नयने क्रुद्धः प्रहारेण व्यशातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2099791, "chapter_id": 3135, "verse_number": "१३-२६५-१९", "content_sanskrit": "पूषणं चाभिदुद्राव घोरेण वपुषाऽन्वितः।\nपुरोडाशं भक्षयतो दशनान्वै व्यशातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2099792, "chapter_id": 3135, "verse_number": "१३-२६५-२०", "content_sanskrit": "ततः प्रणेमुर्देवास्ते वेपमानाः स्म शङ्करम्।\nपुनश्च सन्दधे रुद्रो दीप्तं सुनिशितं शरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2099793, "chapter_id": 3135, "verse_number": "१३-२६५-२१", "content_sanskrit": "रुद्रस्य विक्रमं दृष्ट्वा भीता देवाः सहर्षिभिः।\nततः प्रसादयामासुः शर्वं ते विबुधोत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2099794, "chapter_id": 3135, "verse_number": "१३-२६५-२२", "content_sanskrit": "जेषुश्च शतरुद्रीयं देवाः कृत्वाञ्जलिं तदा।\nसंस्तूयमानस्त्रिदशैः प्रससाद महेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2099795, "chapter_id": 3135, "verse_number": "१३-२६५-२३", "content_sanskrit": "रुद्रस्य भागं यज्ञे च विशिष्टं ते त्वकल्पयन्।\nभयेन त्रिदशा राजञ्शरणं च प्रपेदिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2099796, "chapter_id": 3135, "verse_number": "१३-२६५-२४", "content_sanskrit": "तेन चैव हि तुष्टेन स यज्ञः सन्धितोऽभवत्।\nयद्यच्चापहृतं तत्र तत्तथैवान्वजीवयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2099797, "chapter_id": 3135, "verse_number": "१३-२६५-२५", "content_sanskrit": "असुराणां पुराण्यासंस्त्रीणि वीर्यवतां दिवि।\nआयसं राजतं चैव सौवर्णमपि चापरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2099798, "chapter_id": 3135, "verse_number": "१३-२६५-२६", "content_sanskrit": "नाशकत्तानि मघवा भेत्तुं सर्वायुधैरपि।\nअथ सर्वेऽमरा रुद्रं जग्मुः शरणमर्दिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2099799, "chapter_id": 3135, "verse_number": "१३-२६५-२७", "content_sanskrit": "तत ऊचुर्महात्मानो देवाः सर्वे समागताः।\nरुद्र रौद्रा भविष्यन्ति पशवः सर्वकर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2099800, "chapter_id": 3135, "verse_number": "१३-२६५-२८", "content_sanskrit": "जहि दैत्यान्सह पुरैर्लोकांस्त्रायस्व मानद।\nस तथोक्तस्तथेत्युक्त्वा कृत्वा विष्णुं शरोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2099801, "chapter_id": 3135, "verse_number": "१३-२६५-२९", "content_sanskrit": "शल्यमग्निं तथा कृत्वा पुङ्खं वैवस्वतं यमम्।\nओङ्कारं च धनुः सर्वाञ्ज्यां च सावित्रिमुत्तमां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2099802, "chapter_id": 3135, "verse_number": "१३-२६५-३०", "content_sanskrit": "ब्रह्माणं सारथिं कृत्वा विनियुज्य च सर्वशः।\nत्रिपर्वणा त्रिशल्येन तेन तानि बिभेद सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2099803, "chapter_id": 3135, "verse_number": "१३-२६५-३१", "content_sanskrit": "शरेणादित्यवर्णेन कालाग्निसमतेजसा।\nतेऽसुराः सपुरास्तत्र दग्धा रुद्रेण भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2099804, "chapter_id": 3135, "verse_number": "१३-२६५-३२", "content_sanskrit": "तं चैवाङ्कगतं दृष्ट्वा बालं पञ्चशिखं पुनः।\nउमा जिज्ञासमाना वै कोऽयमित्यब्रवीत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2099805, "chapter_id": 3135, "verse_number": "१३-२६५-३३", "content_sanskrit": "असूयतश्च शक्रस्य वज्रेणि प्रहरिष्यतः।\nसवज्रं स्तम्भयामास तं बाहुं परिघोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2099806, "chapter_id": 3135, "verse_number": "१३-२६५-३४", "content_sanskrit": "न संयुयुधिरे चैव देवास्तं भुवनेश्वरम्।\nसप्रजापतयः सर्वे तस्मिन्मुमुहुरीश्वरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2099807, "chapter_id": 3135, "verse_number": "१३-२६५-३५", "content_sanskrit": "ततो ध्यात्वा च भगवान्ब्रह्मा तममितौजसम्।\nअयं श्रेष्ठ इति ज्ञात्वा ववन्दे तमुमापतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2099808, "chapter_id": 3135, "verse_number": "१३-२६५-३६", "content_sanskrit": "ततः प्रसादयामासुरुमां रुद्रं च ते सुराः।\nबभूव स तदा बालः प्रययौ तु यथापुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2099809, "chapter_id": 3135, "verse_number": "१३-२६५-३७", "content_sanskrit": "स चापि ब्राह्मणो भूत्वा दुर्वासा नाम वीर्यवान्।\nद्वारवत्यां मम गृहे चिरं कालमुपावसन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2099810, "chapter_id": 3135, "verse_number": "१३-२६५-३८", "content_sanskrit": "विप्रकारान्प्रयुङ्क्ते स्म सुबहून्मम वेश्मनि।\nतानुदारतया चाहं चक्षमे चातिदुःसहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2099811, "chapter_id": 3135, "verse_number": "१३-२६५-३९", "content_sanskrit": "स वै रुद्रः स च शिवः सोग्निः सर्वः स सर्वजित्।\nस चैवेन्द्रश्च वायुश्च सोऽस्विनौ स च विद्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2099812, "chapter_id": 3135, "verse_number": "१३-२६५-४०", "content_sanskrit": "स चन्द्रमाः स चेशानः स सूर्यो वरुणश्च सः।\nस कालः सोन्तको मृत्युः स यमो रात्र्यहानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2099813, "chapter_id": 3135, "verse_number": "१३-२६५-४१", "content_sanskrit": "मासार्धमासा ऋतवः सन्ध्ये संवत्सरश्च सः।\nसधाता स विधाता च विश्वकर्मा स सर्ववित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2099814, "chapter_id": 3135, "verse_number": "१३-२६५-४२", "content_sanskrit": "नक्षत्राणि ग्रहाश्चैव दिशोऽथ प्रदिशस्तथा।\nविश्वमूर्तिरमेयात्मा भगवान्परमद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2099815, "chapter_id": 3135, "verse_number": "१३-२६५-४३", "content_sanskrit": "एकधा च द्विधा चैव बहुधा च स एव हि।\nशतधा सहस्रधा चैव तथा शतसहस्रधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2099816, "chapter_id": 3135, "verse_number": "१३-२६५-४४", "content_sanskrit": "ईदृशः स महादेवो भूयश्च भगवानतः।\nन हि शक्या गुणा वक्तुमपि वर्षशतैरपि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2099817, "chapter_id": 3135, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पञ्चषष्ट्यदिकद्विशततमोऽध्यायः॥ २६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]