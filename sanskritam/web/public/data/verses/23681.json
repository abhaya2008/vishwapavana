[{"id": 7003681000, "chapter_id": 23681, "verse_number": "१-३-२-१", "content_sanskrit": "ब्रह्मोवाच ।\nअथाहमुच्चरन्वेदानशेषैर्वदनैः शिवम् ।\nअस्तौषं भक्तिसंपूर्णं कृत्वा मानसमर्चनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003681001, "chapter_id": 23681, "verse_number": "१-३-२-२", "content_sanskrit": "नमः शिवाय महते सर्वलोकैकहेतवे ।\nयेन प्रकाश्यते सर्वं ध्रियते सततं नमः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003681002, "chapter_id": 23681, "verse_number": "१-३-२-३", "content_sanskrit": "विश्वव्याप्तमिदं तेजः प्रकाशयति संततम् ।\nनेक्षंते त्वद्दयाहीना जात्यंधा भास्करं यथा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003681003, "chapter_id": 23681, "verse_number": "१-३-२-४", "content_sanskrit": "भूलिंगममलं ह्येतद्दृश्यमध्यात्मचक्षुषा ।\nअंतस्स्थं वा बहिस्स्थं वा त्वद्भक्तैरनुभूयते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003681004, "chapter_id": 23681, "verse_number": "१-३-२-५", "content_sanskrit": "अपरिच्छेद्यमाकारमंतरात्मनि योगिनः ।\nतदेतत्तव देवेश ज्वलितं दर्पणो यथा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003681005, "chapter_id": 23681, "verse_number": "१-३-२-६", "content_sanskrit": "अथवा शांकरी शक्तिः सत्याऽणोरप्यणीयसी ।\nमत्तो नान्यतरः कश्चिद्यन्मय्यपि विलीयते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003681006, "chapter_id": 23681, "verse_number": "१-३-२-७", "content_sanskrit": "अणुस्ते करुणापात्रं महत्त्वं ध्रुवमश्नुते ।\nनाधिकोऽस्ति परस्त्वत्तो न मत्तोऽपि तदाश्रयात् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003681007, "chapter_id": 23681, "verse_number": "१-३-२-८", "content_sanskrit": "त्वय्यर्पितं मनस्त्वतो न वियोगमपेक्षते ।\nवाचः कथं प्रवृत्तिः स्यात्तव वैभवकीर्त्तने ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003681008, "chapter_id": 23681, "verse_number": "१-३-२-९", "content_sanskrit": "स्वयमीश महादेव प्रसीद भुवनाधिक ।\nआदिश प्रयतं भक्तमपेक्षितनियुक्तिषु ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003681009, "chapter_id": 23681, "verse_number": "१-३-२-१०", "content_sanskrit": "इदं विज्ञाप्य विनयान्नमस्कृत्वा पुनःपुनः ।\nप्रांजलिर्देवदेवेशं न्यषीदं सविधे विभो ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003681010, "chapter_id": 23681, "verse_number": "१-३-२-११", "content_sanskrit": "अथ विष्णुर्नवांभोदगंभीरध्वनिरभ्यधात् ।\nवाचः कृतार्थन्भूयः शुक्लाः शंकरकीर्त्तनैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003681011, "chapter_id": 23681, "verse_number": "१-३-२-१२", "content_sanskrit": "जय त्रिभुवनाधीश जय गंगाधर प्रभो ।\nजय नाथ विरूपाक्ष जय चंद्रार्द्धशेखर ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003681012, "chapter_id": 23681, "verse_number": "१-३-२-१३", "content_sanskrit": "अव्याजममितं शंभो कारुण्यं तव वर्द्धते ।\nयेन निर्धूतमखिलं भक्तेषु ज्ञानमाहितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003681013, "chapter_id": 23681, "verse_number": "१-३-२-१४", "content_sanskrit": "पालनं सर्वविद्यानां प्रापणं भूतिसंचयैः ।\nपुराणं च सपुत्राणां पितुरेव प्रवर्धनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003681014, "chapter_id": 23681, "verse_number": "१-३-२-१५", "content_sanskrit": "शतानामपि मूर्तीनामेकामपि नवैः स्तवैः ।\nस्तोतुं न शक्नुमेशान समवायस्तु कि पुनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003681015, "chapter_id": 23681, "verse_number": "१-३-२-१६", "content_sanskrit": "त्वमेव त्वामलं वेत्तुं यदि वा त्वत्प्रसादतः ।\nभ्रमरः कीटमाकृष्य स्वात्मानं किं न चानयेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003681016, "chapter_id": 23681, "verse_number": "१-३-२-१७", "content_sanskrit": "देवास्त्वदंशसंभूतिप्रभवो न भवन्ति किम् ।\nअप्यायस्याग्निकीलस्य दाहे शक्तिर्न किं भवेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003681017, "chapter_id": 23681, "verse_number": "१-३-२-१८", "content_sanskrit": "देशकालक्रियायोगाद्यथाग्नेर्भेदसम्भवः ।\nतथा विषयभेदेन त्वमेकोऽपि विभिद्यसे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003681018, "chapter_id": 23681, "verse_number": "१-३-२-१९", "content_sanskrit": "अनुग्रहपरो देव मूर्तिं दर्शय शंकर ।\nआवयोरखिलाधार नयनानंददायिनीम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003681019, "chapter_id": 23681, "verse_number": "१-३-२-२०", "content_sanskrit": "एवं प्रणमतोर्देवः श्रद्धाभक्तिसमन्वितम् ।\nप्रससाद परं शंभुः स्तुवतोरावयोर्द्वयोः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003681020, "chapter_id": 23681, "verse_number": "१-३-२-२१", "content_sanskrit": "तेजःस्तंभात्पुनस्तस्माद्देवश्चन्द्रार्द्धशेखरः ।\nआविर्बभूव पुरुषः कपिलः कालकन्धरः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003681021, "chapter_id": 23681, "verse_number": "१-३-२-२२", "content_sanskrit": "परशुं बालहरिणं करैरभयविश्रमौ ।\nदधानः पुरुषोऽवादीत्पुत्रावावामिति प्रभुः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003681022, "chapter_id": 23681, "verse_number": "१-३-२-२३", "content_sanskrit": "परितुष्टोऽस्मि युवयोर्भक्त्या युक्तात्मनोर्मयि ।\nभवतं सर्वलोकानां सृष्टिरक्षाधिपौ युवाम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003681023, "chapter_id": 23681, "verse_number": "१-३-२-२४", "content_sanskrit": "युवयोरिष्टसिद्ध्यर्थमाविर्भूतोऽस्म्यहं यतः ।\nवरं वृणुतमन्यं च वरदोऽहमुपागतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003681024, "chapter_id": 23681, "verse_number": "१-३-२-२५", "content_sanskrit": "इति देवस्य वचनात्सप्रीतौ च कृतांजली ।\nविज्ञापयामासिवतौ स्वं स्वमर्थं पृथक्पृथक् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003681025, "chapter_id": 23681, "verse_number": "१-३-२-२६", "content_sanskrit": "अहं मन्त्रैः शिशुप्रायजगत्त्रयविधायकः ।\nसंस्तुवन्वैदिकैर्मंत्रैरीशानमपराजितम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003681026, "chapter_id": 23681, "verse_number": "१-३-२-२७", "content_sanskrit": "नमस्येहमिदं रूपं शश्वद्वरदमीश्वरम् ।\nतेजोमयं महादेवं योगिध्येयं निरंजनम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003681027, "chapter_id": 23681, "verse_number": "१-३-२-२८", "content_sanskrit": "आपूर्यमाणं भवता तेजसा गगनांतरम् ।\nपरिपृच्छ्यः सुरावासः क्षणाद्देव भविष्यति ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003681028, "chapter_id": 23681, "verse_number": "१-३-२-२९", "content_sanskrit": "सिद्धचारणगन्धर्वा देवाश्च परमर्षयः ।\nनावसन्दिवि संचारं लभेरंस्तेजसा तव ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003681029, "chapter_id": 23681, "verse_number": "१-३-२-३०", "content_sanskrit": "पृथ्वी च सकला चैव तप्यमाना तवौजसा ।\nचराचरसमुत्पत्तिक्षमा नैव भविप्यति ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003681030, "chapter_id": 23681, "verse_number": "१-३-२-३१", "content_sanskrit": "उपसंहृत्य तेजः स्वमरुणाचलसंज्ञया ।\nभव स्थावरलिंगं त्वं लोकानुग्रहकारणात् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003681031, "chapter_id": 23681, "verse_number": "१-३-२-३२", "content_sanskrit": "ज्योतिर्मयमिदं रूपमरुणाचलसंज्ञितम् ।\nये नमन्ति नरा भक्त्या ते भवन्त्यमराधिकाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003681032, "chapter_id": 23681, "verse_number": "१-३-२-३३", "content_sanskrit": "सेवंतां सकला लोकाः सिद्धाश्च परमर्षयः ।\nगणाश्च विविधा भूमौ मानुषं भावमास्थिताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003681033, "chapter_id": 23681, "verse_number": "१-३-२-३४", "content_sanskrit": "दिव्याराम समुद्भूतकल्पकाद्याः सुरद्रुमाः ।\nसेविनस्त्वां प्ररोहंतु भरिता विविधैः फलैः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003681034, "chapter_id": 23681, "verse_number": "१-३-२-३५", "content_sanskrit": "दिव्यौषधिगणास्सर्वे सिंहाद्या मृगजातयः ।\nप्रशांताः परिवर्त्तंता पापकल्मषनाशनम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003681035, "chapter_id": 23681, "verse_number": "१-३-२-३६", "content_sanskrit": "अयनद्वयभिन्नेन गमनेनापि संयुतः ।\nन लंघयिष्यति रविः शृंगं लिंगतनोस्तव ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003681036, "chapter_id": 23681, "verse_number": "१-३-२-३७", "content_sanskrit": "दिव्य दुंदुभिशंखानां घोषैः पुष्पौघवृष्टिभिः ।\nसेवितो भव देव त्वमप्सरोनृत्यगीतिभिः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003681037, "chapter_id": 23681, "verse_number": "१-३-२-३८", "content_sanskrit": "अमरत्वं च सिद्धत्वं रससिद्धीश्च निर्वृतिम् ।\nलभंतां मानुषा नित्यं त्वत्संनिधिमुपागताः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003681038, "chapter_id": 23681, "verse_number": "१-३-२-३९", "content_sanskrit": "ईशत्वं च वशित्वं च सौभाग्यं कालवंचनम् ।\nत्वामाश्रित्य नरास्सर्वे लभंतामरुणाचल ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003681039, "chapter_id": 23681, "verse_number": "१-३-२-४०", "content_sanskrit": "सर्वावयवदानेन सर्वव्याधिविनाशनात् ।\nसर्वाभीष्टप्रदानेन दृश्यो भव महीतले ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003681040, "chapter_id": 23681, "verse_number": "१-३-२-४१", "content_sanskrit": "तथेति वरदं देवमरुणाद्रिपतिं शिवम् ।\nप्रणम्य कमलानाथः प्रार्थयन्निदमब्रवीत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003681041, "chapter_id": 23681, "verse_number": "१-३-२-४२", "content_sanskrit": "प्रसीद करुणापूर्ण शोणशैलेश्वर प्रभो ।\nमहेश सर्वलोकानां हिताय प्रकटोदय ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003681042, "chapter_id": 23681, "verse_number": "१-३-२-४३", "content_sanskrit": "यदाहं त्वामुपाश्रित्य जगद्रक्षणदक्षिणः ।\nश्रीपतित्वमनुप्राप्तस्तदा भक्ता भवंतु ते ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003681043, "chapter_id": 23681, "verse_number": "१-३-२-४४", "content_sanskrit": "नाल्पपुण्यैरुपास्येत त्वद्रूपं महदद्भुतम् ।\nमया च ब्रह्मणा चैवमदृष्टपदशेखरः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003681044, "chapter_id": 23681, "verse_number": "१-३-२-४५", "content_sanskrit": "प्रदक्षिणानमस्कारैर्नृत्यगीतैश्च पूजनैः ।\nत्वामर्चयंति ये मर्त्याः कृतार्थास्ते गतांहसः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003681045, "chapter_id": 23681, "verse_number": "१-३-२-४६", "content_sanskrit": "उपवासैर्व्रतैः सत्रैरुपहारैस्तथार्चनैः ।\nत्वामर्चयंति मनुजाः सार्वभौमा भवंतु ते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003681046, "chapter_id": 23681, "verse_number": "१-३-२-४७", "content_sanskrit": "आरामं मंडपं चापि कूपं विधिविशोधनम् ।\nकुर्वतामरुणाद्रीश संनिधाने पुनर्भव ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003681047, "chapter_id": 23681, "verse_number": "१-३-२-४८", "content_sanskrit": "अंगप्रदक्षिणं कुर्वन्नष्टैश्वर्यसमन्वितः ।\nअशेषपातकैः सद्यो विमुक्तो निर्मलाशयः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003681048, "chapter_id": 23681, "verse_number": "१-३-२-४९", "content_sanskrit": "आवामप्यविमुंचंतौ सदा त्वत्पादपंकजम् ।\nध्यातव्यं मनुजैः सर्वैस्तव संनिधिमागतैः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003681049, "chapter_id": 23681, "verse_number": "१-३-२-५०", "content_sanskrit": "तथास्त्विति वरं दत्त्वा विष्णवे चंद्रशेखरः ।\nभरुणाचलरूपेण प्राप्तः स्थावरलिंगताम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003681050, "chapter_id": 23681, "verse_number": "१-३-२-५१", "content_sanskrit": "तैजसं लिंगमेतद्धि सर्वलोकैककारणम् ।\nअरुणाद्रिरिति ख्यातं दृश्यते वसुधातले ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003681051, "chapter_id": 23681, "verse_number": "१-३-२-५२", "content_sanskrit": "युगांतसमये क्षुब्धैश्चतुर्भिरपि सागरैः ।\nअपि निर्मग्नलोकांतैरस्पृष्टांतिकभूतलम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003681052, "chapter_id": 23681, "verse_number": "१-३-२-५३", "content_sanskrit": "गजप्रमाणैः पृषतैः पूरयंतो जगत्त्रयम् ।\nपुष्कराद्या महामेघा विश्रांता यस्य सानुनि ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003681053, "chapter_id": 23681, "verse_number": "१-३-२-५४", "content_sanskrit": "प्रवृत्ते भूतसंहारे प्रकृतौ प्रतिसंचरे ।\nभविष्यत्सर्वबीजानि निषेदुर्यत्र निश्चयम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003681054, "chapter_id": 23681, "verse_number": "१-३-२-५५", "content_sanskrit": "मया चाहूयमानेभ्यः प्रलयानंतरं पुनः ।\nयत्पादसेविविप्रेभ्यो वेदाध्ययनसंग्रहः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003681055, "chapter_id": 23681, "verse_number": "१-३-२-५६", "content_sanskrit": "सर्वासामपि विद्यानां कलानां शास्त्रसंपदाम् ।\nआगमानां च वेदानां यत्र सत्यव्यवस्थितिः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003681056, "chapter_id": 23681, "verse_number": "१-३-२-५७", "content_sanskrit": "यद्गुहागह्वरांतस्स्था मुनयः शंसितव्रताः ।\nजटिनः संप्रकाशंते कोटिसूर्याग्नितेजसः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003681057, "chapter_id": 23681, "verse_number": "१-३-२-५८", "content_sanskrit": "पंचब्रह्ममयैर्मंत्रैः पंचाक्षरवपुर्धरैः ।\nअकारपीठिकारूढो नादात्मा यः सदाशिवः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003681058, "chapter_id": 23681, "verse_number": "१-३-२-५९", "content_sanskrit": "अष्टभिश्च सदा लिंगैरष्टदिक्पालपूजितः ।\nअष्टमूर्त्तितया योऽयमष्टसिद्धिप्रदायकः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003681059, "chapter_id": 23681, "verse_number": "१-३-२-६०", "content_sanskrit": "यत्र सिद्धास्तथा लोकान्स्वान्स्वान्मुक्त्वा सुरेश्वराः ।\nअपेक्षंते स्थिता मुक्तिं विहाय कनकाचलम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003681060, "chapter_id": 23681, "verse_number": "१-३-२-६१", "content_sanskrit": "एवं वसुंधरापुण्यपरिपाकसमुच्चयः ।\nअरुणाद्रिरिति ख्यातो भक्तभक्तिवरप्रदः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003681061, "chapter_id": 23681, "verse_number": "१-३-२-६२", "content_sanskrit": "कैलासान्मेरुशिखरादागतैर्देवसंचयैः ।\nपूज्यते शोणशैलात्मा शंभुः सर्ववरप्रदः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003681062, "chapter_id": 23681, "verse_number": "१-३-२-६३", "content_sanskrit": "इति कमलजवक्त्रपद्मजां तं मुदितमनाः सनको निशम्य भक्त्या ।\nविरचितविनयः प्रणम्य पुत्रः पितरमपृच्छदशेषवेदसारम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003681063, "chapter_id": 23681, "verse_number": "१-३-२-६४", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्डेऽरुणाचलमाहात्म्ये पूर्वार्धे ब्रह्मविष्णुस्तुतिपूर्वकं शंकरस्य स्थावरलिंगमाहात्म्यवर्णनंनाम द्वितीयोऽध्यायः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]