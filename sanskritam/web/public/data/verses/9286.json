[{"id": 5000286000, "chapter_id": 9286, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे चतुर्दशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000286001, "chapter_id": 9286, "verse_number": "४-१४-१", "content_sanskrit": "सर्वे ते त्वरितं गत्वा किष्किन्धां वालिनः पुरीम्।\nवृक्षैरात्मानमावृत्य व्यतिष्ठन् गहने वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000286002, "chapter_id": 9286, "verse_number": "४-१४-२", "content_sanskrit": "विसार्य सर्वतो दृष्टिं कानने काननप्रियः।\nसुग्रीवो विपुलग्रीवः क्रोधमाहारयद् भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000286003, "chapter_id": 9286, "verse_number": "४-१४-३", "content_sanskrit": "ततस्तु निनदं घोरं कृत्वा युद्धाय चाह्वयत्।\nपरिवारैः परिवृतो नादैर्भिन्दन्निवाम्बरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000286004, "chapter_id": 9286, "verse_number": "४-१४-४", "content_sanskrit": "गर्जन्निव महामेघो वायुवेगपुरःसरः।\nअथ बालार्कसदृशो दृप्तसिंहगतिस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000286005, "chapter_id": 9286, "verse_number": "४-१४-५", "content_sanskrit": "दृष्ट्वा रामं क्रियादक्षं सुग्रीवो वाक्यमब्रवीत्।\nहरिवागुरया व्याप्तां तप्तकाञ्चनतोरणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000286006, "chapter_id": 9286, "verse_number": "४-१४-६", "content_sanskrit": "प्राप्ताः स्म ध्वजयन्त्राढ्यां किष्किन्धां वालिनः पुरीम्।\nप्रतिज्ञा या कृता वीर त्वया वालिवधे पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000286007, "chapter_id": 9286, "verse_number": "४-१४-७", "content_sanskrit": "सफलां कुरु तां क्षिप्रं लतां काल इवागतः।\nएवमुक्तस्तु धर्मात्मा सुग्रीवेण स राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000286008, "chapter_id": 9286, "verse_number": "४-१४-८", "content_sanskrit": "तमेवोवाच वचनं सुग्रीवं शत्रुसूदनः।\nकृताभिज्ञानचिह्नस्त्वमनया गजसाह्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000286009, "chapter_id": 9286, "verse_number": "४-१४-९", "content_sanskrit": "लक्ष्मणेन समुत्पाट्य एषा कण्ठे कृता तव।\nशोभसेऽप्यधिकं वीर लतया कण्ठसक्तया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000286010, "chapter_id": 9286, "verse_number": "४-१४-१०", "content_sanskrit": "विपरीत इवाकाशे सूर्यो नक्षत्रमालया।\nअद्य वालिसमुत्थं ते भयं वैरं च वानर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000286011, "chapter_id": 9286, "verse_number": "४-१४-११", "content_sanskrit": "एकेनाहं प्रमोक्ष्यामि बाणमोक्षेण संयुगे।\nमम दर्शय सुग्रीव वैरिणं भ्रातृरूपिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000286012, "chapter_id": 9286, "verse_number": "४-१४-१२", "content_sanskrit": "वाली विनिहतो यावद्वने पांसुषु चेष्टते।\nयदि दृष्टिपथं प्राप्तो जीवन् स विनिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000286013, "chapter_id": 9286, "verse_number": "४-१४-१३", "content_sanskrit": "ततो दोषेण मागच्छेत् सद्यो गर्हेच्च मां भवान्।\nप्रत्यक्षं सप्त ते साला मया बाणेन दारिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000286014, "chapter_id": 9286, "verse_number": "४-१४-१४", "content_sanskrit": "तेनावेहि बलेनाद्य वालिनं निहतं रणे।\nअनृतं नोक्तपूर्वं मे चिरं कृच्छ्रेऽपि तिष्ठता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000286015, "chapter_id": 9286, "verse_number": "४-१४-१५", "content_sanskrit": "धर्मलोभपरीतेन न च वक्ष्ये कथंचन।\nसफलां च करिष्यामि प्रतिज्ञां जहि संभ्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000286016, "chapter_id": 9286, "verse_number": "४-१४-१६", "content_sanskrit": "प्रसूतं कलमक्षेत्रं वर्षेणेव शतक्रतुः।\nतदाह्वाननिमित्तं च वालिनो हेममालिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000286017, "chapter_id": 9286, "verse_number": "४-१४-१७", "content_sanskrit": "सुग्रीव कुरु तं शब्दं निष्पतेद् येन वानरः।\nजितकाशी जयश्लाघी त्वया चाधर्षितः पुरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000286018, "chapter_id": 9286, "verse_number": "४-१४-१८", "content_sanskrit": "निष्पतिष्यत्यसङ्गेन वाली स प्रियसंयुगः।\nरिपूणां धर्षितं श्रुत्वा मर्षयन्ति न संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000286019, "chapter_id": 9286, "verse_number": "४-१४-१९", "content_sanskrit": "जानन्तस्तु स्वकं वीर्यं स्त्रीसमक्षं विशेषतः।\nस तु रामवचः श्रुत्वा सुग्रीवो हेमपिङ्गलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000286020, "chapter_id": 9286, "verse_number": "४-१४-२०", "content_sanskrit": "ननर्द क्रूरनादेन विनिर्भिन्दन्निवाम्बरम्।\nतत्र शब्देन वित्रस्ता गावो यान्ति हतप्रभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000286021, "chapter_id": 9286, "verse_number": "४-१४-२१", "content_sanskrit": "राजदोषपरामृष्टाः कुलस्त्रिय इवाकुलाः।\nद्रवन्ति च मृगाः शीघ्रं भग्ना इव रणे हयाः।\nपतन्ति च खगा भूमौ क्षीणपुण्या इव ग्रहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000286022, "chapter_id": 9286, "verse_number": "४-१४-२२", "content_sanskrit": "ततः स जीमूतकृतप्रणादो\nनादं ह्यमुञ्चत् त्वरया प्रतीतः।\nसूर्यात्मजः शौर्यविवृद्धतेजाः\nसरित्पतिर्वाऽनिलचञ्चलोर्मिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000286023, "chapter_id": 9286, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे चतुर्दशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]