[{"id": 40018457, "chapter_id": 9286, "verse_number": "1", "content_sanskrit": "हन्यमानेबलेतूर्णमन्योन्यंतेमहामृथे । सरसीवमहाघर्मेसोपक्षीणेबभूवतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40018458, "chapter_id": 9286, "verse_number": "2", "content_sanskrit": "स्वबलस्यविघातेनविरूपाक्ष्वधेन च । बभूवद्विगुणंक्रुद्धोरावणोराक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40018459, "chapter_id": 9286, "verse_number": "3", "content_sanskrit": "प्रक्षीणंतुबलंदृष्टवावध्यमानंवलीमुखैः । बभूवास्यव्यथायुद्धेप्रेक्ष्यदैवविपर्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40018460, "chapter_id": 9286, "verse_number": "4", "content_sanskrit": "उवाच च समीपस्थंमहोदरमरिन्दमम् । अस्मिन्कालेमहाबाहोजयाशात्वयिमेस्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40018461, "chapter_id": 9286, "verse_number": "5", "content_sanskrit": "जहिशत्रुचमूंवीरदर्शयाद्यपराक्रमम् । भर्तृपिण्डस्यकालोऽऽयंनिर्देष्टुंसाधुयुध्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40018462, "chapter_id": 9286, "verse_number": "6", "content_sanskrit": "एवमुक्तस्तथेत्युक्त्वाराक्षसेन्द्रोमहोदरः । प्रविवेशारिसेनांतांपतङ्गइवपावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40018463, "chapter_id": 9286, "verse_number": "7", "content_sanskrit": "ततस्सकदनंचक्रेवानराणांमहाबलः । भर्तृवाक्येनतेजस्वीस्वेनवीर्येणचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40018464, "chapter_id": 9286, "verse_number": "8", "content_sanskrit": "वानराश्चमहासत्त्वाःप्रगृह्वःविपुलाशशिलाः । प्रविश्यारिबलंभीमंजघ्नुस्तेरजनीचरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40018465, "chapter_id": 9286, "verse_number": "9", "content_sanskrit": "महोदरस्तुसङ्कृद्धश्शरैःकाञ्चनभूषणैः । चिच्छेदपाणिपादोरुन्वानराणांमहाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40018466, "chapter_id": 9286, "verse_number": "10", "content_sanskrit": "ततस्तेवानरास्सर्वेराक्षसैरर्दिताभृशम् । दिशोदशद्रुताःकेचित्केचित्सुग्रीवमाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40018467, "chapter_id": 9286, "verse_number": "11", "content_sanskrit": "प्रभग्नांसमरेदृष्टवावानराणांमहाचमूम् । अभिदुद्रावसुग्रीवोमहोदरमनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40018468, "chapter_id": 9286, "verse_number": "12", "content_sanskrit": "प्रगृह्यविपुलांघोरांमहीधरसमांशिलाम् । चिक्षेप स महातेजास्तद्वधायहरीश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40018469, "chapter_id": 9286, "verse_number": "13", "content_sanskrit": "तामापततनींसहसाशिलांदृष्टवामहोदरः । असम्भ्रान्तस्ततोबाणैर्निर्बिभेददुरासदाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40018470, "chapter_id": 9286, "verse_number": "14", "content_sanskrit": "रक्षसातेनबाणौघैर्निकृत्तासासहस्रधा । निपपातशिलाभूमौगृध्रचक्रमिवाकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40018471, "chapter_id": 9286, "verse_number": "15", "content_sanskrit": "तांतुभिन्नांशिलांदृष्टवासुग्रीवःक्रोधमूर्छितः । सालमुत्पाट्यचिक्षेपराक्षसेरणमूर्थनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40018472, "chapter_id": 9286, "verse_number": "16", "content_sanskrit": "शरैश्चविददारैनंशूरःपरपुरञ्जयः । स ददर्शततःक्रुद्धःपरिघंपतितंभुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40018473, "chapter_id": 9286, "verse_number": "17", "content_sanskrit": "आविध्यतु स तंदीप्तंपरिघंतस्यदर्शयन् । परिघाग्रेणवेगेनजघानास्यहयोत्तमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40018474, "chapter_id": 9286, "verse_number": "18", "content_sanskrit": "तस्माद्धतहयावदीरःसोऽऽवप्लुत्यमहारथात् । गदांजग्राहसंक्रुद्धोराक्षसोऽऽथमहोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40018475, "chapter_id": 9286, "verse_number": "19", "content_sanskrit": "गदापरिघहस्तौतौयुधिवीरौसमीयतुः । नर्दन्तौगोवृषप्रख्यौघनाविवसविद्युतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40018476, "chapter_id": 9286, "verse_number": "20", "content_sanskrit": "ततःक्रुद्धोगदांतस्यैचिक्षेपरजनीचरः । ज्वलतनींभास्कराभासांसुग्रीवायमहोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40018477, "chapter_id": 9286, "verse_number": "21", "content_sanskrit": "गदांतांसुमहाघोरामापततनींमहाबलः । सुग्रीवोरोषताम्राक्षस्समुद्यम्यमहाहवे ॥ आजघानगदांतस्यपरिघेणहरीश्वर । पपात स गदोद्भिन्नःपरिघस्तस्यभूतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40018478, "chapter_id": 9286, "verse_number": "22", "content_sanskrit": "गदांतांसुमहाघोरामापततनींमहाबलः । सुग्रीवोरोषताम्राक्षस्समुद्यम्यमहाहवे ॥ आजघानगदांतस्यपरिघेणहरीश्वर । पपात स गदोद्भिन्नःपरिघस्तस्यभूतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40018479, "chapter_id": 9286, "verse_number": "23", "content_sanskrit": "ततोजग्राहतेजस्वीसुग्रीवोवसुधातलात् । आयसंमुसलंघोरंसर्वतोहेमभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40018480, "chapter_id": 9286, "verse_number": "24", "content_sanskrit": "स तमुद्यम्यचिक्षेपसोऽऽप्यन्यांव्याक्षिपद्गदाम् । भिन्नावन्योन्यमासाद्यपेततुद्दरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40018481, "chapter_id": 9286, "verse_number": "25", "content_sanskrit": "ततोग्नप्रहरणौमुष्टिभ्यांतौसमीयतुः । तेजोबलसमाविष्टौदीप्ताविवहुताशनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40018482, "chapter_id": 9286, "verse_number": "26", "content_sanskrit": "जघ्नतुस्तौतदान्योन्यंवेदतुश्चपुनःपुनः । तलैश्चान्योन्यमहत्यपेततुश्चमहीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40018483, "chapter_id": 9286, "verse_number": "27", "content_sanskrit": "उत्पेततुस्ततस्तूर्णंजघ्नतुश्चपरस्परम् । भुजैश्चिक्षिपतुर्वीरावन्योन्यमपराजितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40018484, "chapter_id": 9286, "verse_number": "28", "content_sanskrit": "जग्मतुस्तौश्रमंवीरौबाहुयुधेपरंतपौ । अजहारतदाखडगमदूरपरिवर्तिनम् ॥ राक्षसश्चर्मणासार्धंमहावेगोमहोदरः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40018485, "chapter_id": 9286, "verse_number": "29", "content_sanskrit": "थैव च महाखडगंचर्मणापतितंसह ॥ जग्राहवानरश्रेष्ठस्सुग्रीवोवेगवत्तरः।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40018486, "chapter_id": 9286, "verse_number": "30", "content_sanskrit": "तौतुरोषपरीताङ्गौनर्दन्तावभ्यधावताम् ॥ उद्यतासीरणेहृष्टावुभौशस्त्रविशारदौ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40018487, "chapter_id": 9286, "verse_number": "31", "content_sanskrit": "दक्षिणंमण्डलंचोभौसुतूर्णंसम्परीयतुः ॥ अन्योन्यमभिसङ्कृद्धौ जये प्रणिहितावुभौ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40018488, "chapter_id": 9286, "verse_number": "32", "content_sanskrit": "तुशूरोमहावेगोवीर्यश्लाघीमहोदरः ॥ महाचर्मणितंखडगंपातयामासदुर्मतिः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40018489, "chapter_id": 9286, "verse_number": "33", "content_sanskrit": "लग्नमुत्कर्षतःखडगंखडगेनकपिकुञ्जरः ॥ जहारसशिरस्त्राणंकुण्डलोपहितंशिरः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40018490, "chapter_id": 9286, "verse_number": "34", "content_sanskrit": "निकृत्तशिरसस्तस्यपतितस्यमहीतले ॥ तद्बलंराक्षसेन्द्रस्यदृष्टवातत्र न तिष्टते ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40018491, "chapter_id": 9286, "verse_number": "35", "content_sanskrit": "हत्वांतंवानरैस्सार्धंननादमुदितोहरिः ॥ चुक्रोध च दशग्रीवोबभौहृष्टश्चराघवः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40018492, "chapter_id": 9286, "verse_number": "36", "content_sanskrit": "विषण्णवदनास्सर्वेराक्षसादीनचेतसः ॥ विद्रवन्तिततस्सर्वेभयवित्रस्तचेतसः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40018493, "chapter_id": 9286, "verse_number": "37", "content_sanskrit": "महोदरंतंन्वििपात्यभूमौमहागिरेःकीर्णमिवैकदेशम् । सूर्यात्मजस्तत्ररराजलक्ष्म्यसूर्यस्स्वतेजोभिरिवाप्रधृष्यः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]