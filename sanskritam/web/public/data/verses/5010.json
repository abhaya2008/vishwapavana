[{"id": 2188721, "chapter_id": 5010, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2188722, "chapter_id": 5010, "verse_number": "१", "content_sanskrit": "यया बुद्ध्या महीपालो भ्रष्टश्रीर्विचरेन्महीम् ।\nकालदण्डविनिष्पिष्टस्तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2188723, "chapter_id": 5010, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2188724, "chapter_id": 5010, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nवासवस्य च संवादं बलेर्वैरोचनस्य च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2188725, "chapter_id": 5010, "verse_number": "३", "content_sanskrit": "पितामहमुपागम्य प्रणिपत्य कृताञ्जलिः ।\nसर्वानेवासुरान् जित्वा बलिं पप्रच्छ वासवः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2188726, "chapter_id": 5010, "verse_number": "४", "content_sanskrit": "यस्य स्म ददतो वित्तं न कदाचन हीयते ।\nतं बलिं नाधिगच्छामि ब्रह्मन्नाचक्ष्व मे बलिम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2188727, "chapter_id": 5010, "verse_number": "५", "content_sanskrit": "स एव ह्यस्तमयते स स्म विद्योतते दिशः ।\nस वर्षति स्म वर्षाणि यथाकालमतन्द्रितः ।\nतं बलिं नाधिगच्छामि ब्रह्मन्नाचक्ष्व मे बलिम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2188728, "chapter_id": 5010, "verse_number": "६", "content_sanskrit": "स वायुर्वरुणश्चैव स रविः स च चन्द्रमाः ।\nसोऽग्निस्तपति भूतानि पृथिवी च भवत्युत ।\nतं बलिं नाधिगच्छामि ब्रह्मन्नाचक्ष्व मे बलिम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2188729, "chapter_id": 5010, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2188730, "chapter_id": 5010, "verse_number": "७", "content_sanskrit": "नैतत् ते साधु मघवन् यदेतदनुपृच्छसि ।\nपृष्टस्तु नानृतं ब्रूयात्तस्माद् वक्ष्यामि ते बलिम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2188731, "chapter_id": 5010, "verse_number": "८", "content_sanskrit": "उष्ट्रेषु यदि वा गोषु खरेष्वश्वेषु वा पुनः ।\nवरिष्ठो भविता जन्तुः शून्यागारे शचीपते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2188732, "chapter_id": 5010, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2188733, "chapter_id": 5010, "verse_number": "९", "content_sanskrit": "यदि स्म बलिना ब्रह्मन् शून्यागारे समेयिवान् ।\nहन्यामेनं न वा हन्यां तद् ब्रह्मन्ननुशाधि माम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2188734, "chapter_id": 5010, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2188735, "chapter_id": 5010, "verse_number": "१०", "content_sanskrit": "मा स्म शक्र बलिं हिंसीर्न बलिर्वधमर्हति ।\nन्यायांस्तु शक्र प्रष्टव्यस्त्वया वासव काम्यया\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2188736, "chapter_id": 5010, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2188737, "chapter_id": 5010, "verse_number": "११", "content_sanskrit": "एवमुक्तो भगवता महेन्द्रः पृथिवीं तदा ।\nचचारैरावतस्कन्धमधिरुह्य श्रिया वृतः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2188738, "chapter_id": 5010, "verse_number": "१२", "content_sanskrit": "ततो ददर्श स बलिं खरवेषेण संवृतम् ।\nयथाख्यातं भगवता शून्यागारकृतालयम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2188739, "chapter_id": 5010, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2188740, "chapter_id": 5010, "verse_number": "१३", "content_sanskrit": "खरयोनिमनुप्राप्तस्तुषभक्षोऽसि दानव ।\nइयं ते योनिरधमा शोचस्याहो न शोचसि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2188741, "chapter_id": 5010, "verse_number": "१४", "content_sanskrit": "अदृष्टं बत पश्यामि द्विषतां वशमागतम् ।\nश्रिया विहीनं मित्रैश्च भ्रष्टवीर्यपराक्रमम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2188742, "chapter_id": 5010, "verse_number": "१५", "content_sanskrit": "यत्तद् यानसहस्रेण ज्ञातिभिः परिवारितः ।\nलोकान् प्रतापयन् सर्वान् यास्यस्मानवितर्कयन्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2188743, "chapter_id": 5010, "verse_number": "१६", "content_sanskrit": "त्वन्मुखाश्चैव दैतेया व्यतिष्ठंस्तव शासने ।\nअकृष्टपच्या पृथिवी तवैश्वर्ये बभूव ह॥\nइदं च तेऽद्य व्यसनं शोचस्याहो न शोचसि\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2188744, "chapter_id": 5010, "verse_number": "१७", "content_sanskrit": "यदातिष्ठः समुद्रस्य पूर्वकूले विलेलिहन् ।\nज्ञातिभ्यो विभजन् वित्तं तदासीत्ते मनः कथम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2188745, "chapter_id": 5010, "verse_number": "१८", "content_sanskrit": "यत्ते सहस्रसमिता ननृतुर्देवयोषितः ।\nबहूनि वर्षपूगानि विहारे दीप्यतः श्रिया\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2188746, "chapter_id": 5010, "verse_number": "१९", "content_sanskrit": "सर्वाः पुष्करमालिन्यः सर्वाः काञ्चनसप्रभाः ।\nकथमद्य तदा चैव मनस्ते दानवेश्वर\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2188747, "chapter_id": 5010, "verse_number": "२०", "content_sanskrit": "छत्रं तवासीत् सुमहत् सौवर्णं मणिभूषितम् ।\nननृतुर्यत्र गन्धर्वाः षट्सहस्राणि सप्तधा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2188748, "chapter_id": 5010, "verse_number": "२१", "content_sanskrit": "यूपस्तवासीत् सुमहान्यजतः सर्वकाञ्चनः ।\nयत्राददः सहस्राणामयुतानि गवां दश\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2188749, "chapter_id": 5010, "verse_number": "२२", "content_sanskrit": "यदा तु पृथिवीं सर्वां यजमानोऽनुपर्ययाः ।\nशम्याक्षेपेण विधिना तदासीत् किं नु ते हृदि\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2188750, "chapter_id": 5010, "verse_number": "२३", "content_sanskrit": "न ते पश्यामि भृङ्गारं न छत्रं व्यजनं न च ।\nब्रह्मदत्तां च ते मालां न पश्याम्यसुराधिप\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2188751, "chapter_id": 5010, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2188752, "chapter_id": 5010, "verse_number": "२४", "content_sanskrit": "ततः प्रसह्य च बलिर्वासवेन समीरितम् ।\nनिशाम्य मानं गम्भीरं सुरराजमथाब्रवीत् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2188753, "chapter_id": 5010, "verse_number": "२५", "content_sanskrit": "अहो हि तव बालिश्यमिह देवगणाधिप ।\nअयुक्तं देवराजस्य तव कष्टमिदं वचः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2188754, "chapter_id": 5010, "verse_number": "", "content_sanskrit": "बलिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2188755, "chapter_id": 5010, "verse_number": "२६", "content_sanskrit": "न त्वं पश्यसि भृङ्गारं न छत्रं व्यजनं न च ।\nब्रह्मदत्तां च मे मालां न त्वं द्रक्ष्यसि वासव\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2188756, "chapter_id": 5010, "verse_number": "२७", "content_sanskrit": "गुहायां निहितानि त्वं मम रत्नानि पृच्छसि ।\nयदा मे भविता कालस्तदा त्वं तानि द्रक्ष्यसि\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2188757, "chapter_id": 5010, "verse_number": "२८", "content_sanskrit": "न त्वेतदनुरूपं ते यशसो वा कुलस्य वा ।\nसमृद्धार्थोऽसमृद्धार्थं यन्मां कत्थितुमिच्छसि\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2188758, "chapter_id": 5010, "verse_number": "२९", "content_sanskrit": "न हि दुःखेषु शोचन्ति न प्रहृष्यन्ति चर्द्धिषु ।\nकृतप्रज्ञा ज्ञानतृप्ताः क्षान्ताः सन्तो मनीषिणः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2188759, "chapter_id": 5010, "verse_number": "३०", "content_sanskrit": "त्वं तु प्राकृतया बुद्ध्या पुरंदर विकत्थसे ।\nयदाहमिव भावी त्वं तदा नैवं वदिष्यसि\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2188760, "chapter_id": 5010, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे एकोनषष्टितमोऽध्यायः ॥५९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]