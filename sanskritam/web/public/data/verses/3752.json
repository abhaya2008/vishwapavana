[{"id": 2128355, "chapter_id": 3752, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2128356, "chapter_id": 3752, "verse_number": "१", "content_sanskrit": "इल्वलस्तान् विदित्वा तु महर्षिसहितान् नृपान् ।\nउपस्थितान् सहामात्यो विषयान्ते ह्यपूजयत् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2128357, "chapter_id": 3752, "verse_number": "२", "content_sanskrit": "तेषां ततोऽसुरश्रेष्ठः त्वातिथ्यमकरोत् तदा ।\nसुसंस्कृतेन कौरव्य भ्रात्रा वातापिना नृप\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2128358, "chapter_id": 3752, "verse_number": "३", "content_sanskrit": "ततो राजर्षयः सर्वे विषण्णा गतचेतसः ।\nवातापिं संस्कृतं दृष्ट्वा मेषभूतं महासुरम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2128359, "chapter_id": 3752, "verse_number": "४", "content_sanskrit": "अथाब्रवीदगस्त्यस्तान् राजर्षीन् ऋषिसत्तमः ।\nविषादो वो न कर्तव्यो ह्यहं भोक्ष्ये महासुरम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2128360, "chapter_id": 3752, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2128361, "chapter_id": 3752, "verse_number": "५", "content_sanskrit": "धुर्यासनमथाक्रम्य निषसाद महामुनिः ।\nतं पर्यवेषद् दैत्येन्द्र इल्वलः प्रहसन्निव \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2128362, "chapter_id": 3752, "verse_number": "६", "content_sanskrit": "अगस्त्य एव कृत्स्नं तु वातापिं बुभुजे ततः ।\nभुक्तवत्यसुरोऽऽह्वानमकरोत् तस्य चेल्वलः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2128363, "chapter_id": 3752, "verse_number": "७", "content_sanskrit": "वातापे प्रतिबुध्यस्व दर्शयन् बलतेजसी ।\nतपसा दुर्जयं यावद् एष त्वां नातिवर्तते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2128364, "chapter_id": 3752, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2128365, "chapter_id": 3752, "verse_number": "८", "content_sanskrit": "ततस्तस्योदरं भेत्तुं वातापिर्वेगमाहरत् ।\nतमबुध्यत तेजस्वी कुम्भयोनिर्महातपाः ।\nस वीर्यात् तपसोग्रस्तु ननर्द भगवान् ऋषिः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2128366, "chapter_id": 3752, "verse_number": "", "content_sanskrit": "अगस्त्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2128367, "chapter_id": 3752, "verse_number": "९", "content_sanskrit": "एष जीर्णोऽसि वातापे मया लोकस्य शान्तये\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2128368, "chapter_id": 3752, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2128369, "chapter_id": 3752, "verse_number": "१०", "content_sanskrit": "इत्युक्त्वा स्वकराग्रेण उदरं समताडयत् ।\nत्रिरेवं प्रतिसंरब्धस्तेजसा प्रज्वलन्निव \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2128370, "chapter_id": 3752, "verse_number": "११", "content_sanskrit": "ततो वायुः प्रादुरभूद् अगस्त्यस्य महात्मनः ।\nइल्वलश्च विषण्णोऽभूद् दृष्ट्वा जीर्णं महासुरम् ।\nप्राञ्जलिश्च सहामात्यैरिदं वचनमब्रवीत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2128371, "chapter_id": 3752, "verse_number": "१२", "content_sanskrit": "किमर्थमुपयाताः स्थ ब्रूत किं करवाणि वः ।\nतमगस्त्यो हसन् वाक्यमिल्वलं प्रत्यभाषत\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2128372, "chapter_id": 3752, "verse_number": "१३", "content_sanskrit": "ईशोस्यसुर विद्मस्त्वां वयं सर्वे धनेश्वरम् ।\nइमे च ताताधनिनो धनार्थश्च महान् मम ।\nयथाशक्त्यविहिंस्यान्यान् संविभागं प्रयच्छ नः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2128373, "chapter_id": 3752, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2128374, "chapter_id": 3752, "verse_number": "१४", "content_sanskrit": "ततोऽवमत्य तमृषिमिल्वलो वाक्यमब्रवीत् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2128375, "chapter_id": 3752, "verse_number": "१५", "content_sanskrit": "ईप्सितं यदिह ब्रूहि तद्धि दास्यामि वो वसु \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2128376, "chapter_id": 3752, "verse_number": "", "content_sanskrit": "अगस्त्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2128377, "chapter_id": 3752, "verse_number": "१६", "content_sanskrit": "गवां शतसहस्राणि राज्ञामेकैकशोऽसुर ।\nतावदेव सुवर्णस्य दित्सितं ते महासुर\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2128378, "chapter_id": 3752, "verse_number": "१७", "content_sanskrit": "मह्यं ततो वै द्विगुणं रथं चैव हिरण्मयम् ।\nमनोजवौ वाजिनौ द्वौ दित्सितं ते महासुर\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2128379, "chapter_id": 3752, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2128380, "chapter_id": 3752, "verse_number": "१८", "content_sanskrit": "इल्वलस्तु मुनिं प्राह सर्वमस्ति यथाऽऽत्थ माम् ।\nरथं तु यदवोचो मां नैनं विद्म हिरण्मयम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2128381, "chapter_id": 3752, "verse_number": "", "content_sanskrit": "अगस्त्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2128382, "chapter_id": 3752, "verse_number": "१९", "content_sanskrit": "न मे वागनृता काचिद् उक्तपूर्वा महासुर ।\nविज्ञायतां रथः साधु व्यक्तमस्ति हिरण्मयः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2128383, "chapter_id": 3752, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2128384, "chapter_id": 3752, "verse_number": "२०", "content_sanskrit": "विज्ञायमानः स रथः कौन्तेयासीद्धिरण्मयः ।\nततः स व्यथितो दैत्यो ददावभ्यधिकं वसु \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2128385, "chapter_id": 3752, "verse_number": "२१", "content_sanskrit": "विवाजी च सुवाजी च तस्मिन् युक्तौ रथे हयौ ।\nऊहतुस्तौ वसून्याशु तान्यगस्त्याश्रमं प्रति ।\nसर्वान् राज्ञः सहागस्त्यान् निमेषादिह भारत\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2128386, "chapter_id": 3752, "verse_number": "२२", "content_sanskrit": "अगस्त्येनाभ्यनुज्ञाता जग्मू राजर्षयस्तदा ।\nकृतवांश्च मुनिः सर्वं लोपामुद्राचिकीर्षितम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2128387, "chapter_id": 3752, "verse_number": "", "content_sanskrit": "लोपामुद्रा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2128388, "chapter_id": 3752, "verse_number": "२३", "content_sanskrit": "कृतवानसि तत् सर्वं भगवन् मम काङ्क्षितम् ।\nउत्पादय सकृन्मह्यमपत्यं वीर्यवत्तरम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2128389, "chapter_id": 3752, "verse_number": "", "content_sanskrit": "अगस्त्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2128390, "chapter_id": 3752, "verse_number": "२४", "content_sanskrit": "तुष्टोऽहमस्मि कल्याणि तव वृत्तेन शोभने ।\nविचारणामपत्ये तु वक्ष्यामि शृणु तां मम \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2128391, "chapter_id": 3752, "verse_number": "२५", "content_sanskrit": "सहस्रं तेऽस्तु पुत्राणां शतं वा दशसम्मितम् ।\nदश वा शततुल्याः स्युरेको वाऽपि सहस्रवत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2128392, "chapter_id": 3752, "verse_number": "", "content_sanskrit": "लोपामुद्रा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2128393, "chapter_id": 3752, "verse_number": "२६", "content_sanskrit": "सहस्रसम्मितः पुत्र एको मेऽस्तु तपोधन ।\nएको हि बहुभिः श्रेयान् विद्वान् साधुरसाधुभिः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2128394, "chapter_id": 3752, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2128395, "chapter_id": 3752, "verse_number": "२७", "content_sanskrit": "स तथेति प्रतिज्ञाय तया समभवन्मुनिः ।\nसमये समशीलिन्या श्रद्धावान् श्रद्दधानया\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2128396, "chapter_id": 3752, "verse_number": "२८", "content_sanskrit": "तत आधाय गर्भं तमगच्छद् वनमेव सः ।\nतस्मिन् वनं गते गर्भो ववृधे सप्त शारदान्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2128397, "chapter_id": 3752, "verse_number": "२९", "content_sanskrit": "सप्तमेऽब्दे गते चापि प्राच्यवत् स महाकविः ।\nज्वलन्निव प्रभावेण दृढस्युर्नाम भारत\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2128398, "chapter_id": 3752, "verse_number": "३०", "content_sanskrit": "साङ्गोपनिषदान् वेदान् जपन्नेव महातपाः ।\nतस्य पुत्रोऽभवदृषेः स तेजस्वी महान् ऋषिः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2128399, "chapter_id": 3752, "verse_number": "३१", "content_sanskrit": "स बाल एव तेजस्वी पितुस्तस्य निवेशने ।\nइध्मानां भारमाजह्रे इध्मवाहस्ततोऽभवत्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2128400, "chapter_id": 3752, "verse_number": "३२", "content_sanskrit": "तथायुक्तं तु तं दृष्ट्वा मुमुदे स मुनिस्तदा ।\nएवं स जनयामास भारतापत्यमुत्तमम् ।\nलेभिरे पितरश्चास्य लोकान् राजन् यथेप्सितान् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2128401, "chapter_id": 3752, "verse_number": "३३", "content_sanskrit": "अगस्त्यस्याश्रमश्चायमत ऊर्ध्वं विशाम्पते ।\nख्यातो भुवि महाराज तेजसा तस्य धीमतः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2128402, "chapter_id": 3752, "verse_number": "३४", "content_sanskrit": "प्राह्लादिश्चापि वातापिर्ब्रह्मघ्नो दुष्टचेतनः ।\nएवं विनाशितो राजन्नगस्त्येन महात्मना \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2128403, "chapter_id": 3752, "verse_number": "३५", "content_sanskrit": "तस्यायमाश्रमो राजन् रमणीयैर्गुणैर्युतः ।\nएषा भागीरथी पुण्या यथेष्टमवगाह्यताम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2128404, "chapter_id": 3752, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि चतुर्नवतितमोऽध्यायः ॥९४॥\n॥ तीर्थयात्रापर्वणि पञ्चाशोऽध्यायः ॥५०॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]