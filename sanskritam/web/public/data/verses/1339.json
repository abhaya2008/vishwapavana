[{"id": 2016183, "chapter_id": 1339, "verse_number": "२-८०-१", "content_sanskrit": "धृतराष्ट्र उवाच।\nत्वं वै ज्येष्ठो ज्यैष्ठिनेयः पुत्र मा पाण्डवान्द्विषः।\nद्वेषा ह्यसुखमादत्ते यथैव निघनं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2016184, "chapter_id": 1339, "verse_number": "२-८०-२", "content_sanskrit": "अव्युत्पन्नं समानार्थं तुल्यमित्रं युधिष्ठिरम्।\nअद्विषन्तं कथं द्विष्यात्त्वादृशो भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2016185, "chapter_id": 1339, "verse_number": "२-८०-३", "content_sanskrit": "तुल्याभिजनवीर्यश्च कथं भ्रातुः श्रियं नृप।\nपुत्र कामयसे मोहान्मैवं भूः शाम्य मा शुचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2016186, "chapter_id": 1339, "verse_number": "२-८०-४", "content_sanskrit": "अथ यज्ञविभूतिं तां काङ्क्षसे भरतर्षभ।\nऋत्विजस्तव तन्वन्तु सप्ततन्तुं महाध्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2016187, "chapter_id": 1339, "verse_number": "२-८०-५", "content_sanskrit": "आहरिष्यन्ति राजानस्तवापि विपुलं धनम्।\nप्रीत्या च बहुमानाच्च रत्नान्याभरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2016188, "chapter_id": 1339, "verse_number": "२-८०-६", "content_sanskrit": "अनार्याचरितं तात परस्वस्पृहणं भृशम्।\nस्वसन्तुष्टः स्वधर्मस्थो यः स वै सुखमेधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2016189, "chapter_id": 1339, "verse_number": "२-८०-७", "content_sanskrit": "मही कामदुघा सा हि वीरपत्नीति चोच्यते।\nतथा वीरस्य भार्या श्रीस्ते इमे हि कलत्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2016190, "chapter_id": 1339, "verse_number": "२-८०-८", "content_sanskrit": "तवाप्यस्ति हे चेद्वीर्यं भोक्ष्यसे हि महीमिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2016191, "chapter_id": 1339, "verse_number": "२-८०-९", "content_sanskrit": "अयुक्तमिदमेतत्तु परस्वहरणं भृशम्।\nउभयोर्लोकयोर्दुःखं सुहृदां काङ्क्षतोऽनयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2016192, "chapter_id": 1339, "verse_number": "२-८०-१०", "content_sanskrit": "अव्यापारः परार्तेषु नित्योद्योगः स्वकर्मसु।\nरक्षणं समुपात्तानामेतद्वैभवलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2016193, "chapter_id": 1339, "verse_number": "२-८०-११", "content_sanskrit": "विपत्तिष्वव्यथो दक्षो नित्यमुत्थानवान्नरः।\nअप्रमत्तो विनीतात्मा नित्यं भद्राणि पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2016194, "chapter_id": 1339, "verse_number": "२-८०-१२", "content_sanskrit": "बाहूनिवैतान्मा च्छेत्सीः पाण्डुपुत्रास्तथैव ते।\nभ्रातृणां तद्धनार्थं वै मित्रद्रोहं च मा कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2016195, "chapter_id": 1339, "verse_number": "२-८०-१३", "content_sanskrit": "पाण्डोः पुत्रान्मा द्विषस्वेह राजं-\nस्तथैव ते भ्रातृधनं समग्रम्।\nमित्रद्रोहे तात महानघर्मः\nपितामहा ये तव तेऽपि तेषाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2016196, "chapter_id": 1339, "verse_number": "२-८०-१४", "content_sanskrit": "अन्तर्वेद्यां ददद्वित्तं कामाननुभवन्प्रियान्।\nक्रीडन्स्त्रीभिर्निरातङ्कः प्रशाम्य भरतर्षभ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2016197, "chapter_id": 1339, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि द्यूतपर्वणि अशीतितमोऽध्यायः॥८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]