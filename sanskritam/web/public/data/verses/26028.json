[{"id": 7006028000, "chapter_id": 26028, "verse_number": "१-२१२-१", "content_sanskrit": "सूत उवाच ।\nप्रस्तार आद्यगोऽथो लः परतुल्योऽथ पूर्वगः। ।\nनष्टमध्ये समेंऽके लः समेऽर्धे विषमे गुरुः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006028001, "chapter_id": 26028, "verse_number": "१-२१२-२", "content_sanskrit": "प्रतिलोमगुणं लाद्यं द्विरुद्दिष्टक एकनुत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006028002, "chapter_id": 26028, "verse_number": "१-२१२-३", "content_sanskrit": "संख्या द्विरर्धे रूपे तु शून्यं शून्ये द्विरीरितम ।\nतावदर्धे तद्गुणितं द्विर्द्व्यूनन्तु तदन्ततः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006028003, "chapter_id": 26028, "verse_number": "१-२१२-४", "content_sanskrit": "परे पूर्णं परे पूर्णं मेरुः प्रस्तारतो भवेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006028004, "chapter_id": 26028, "verse_number": "१-२१२-५", "content_sanskrit": "लगसंख्या वृत्तसंख्या चाद्याङ्गुलमथोर्ध्वत ।\nसंख्यैव द्विगुणैकोनाच्छन्दः सारोऽयमीरितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]