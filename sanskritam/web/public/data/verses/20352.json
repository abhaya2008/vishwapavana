[{"id": 7000352000, "chapter_id": 20352, "verse_number": "२-२४-१", "content_sanskrit": "सूत उवाच ।\nहतं श्रुत्वा दितिः पुत्रं सुबलं बलमेव च ।\nरुदितं करुणं कृत्वा हा हा कष्टं भृशं मम॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000352001, "chapter_id": 20352, "verse_number": "२-२४-२", "content_sanskrit": "एवं सुकरुणं कृत्वा बहुकालं तपस्विनी ।\nसा गता कश्यपं कांतं तमुवाच यशस्विनी॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000352002, "chapter_id": 20352, "verse_number": "२-२४-३", "content_sanskrit": "तव पुत्रो महापाप इंद्रः सुरगणेश्वरः ।\nसागरोपगतं दृष्ट्वा बलं मे ब्रह्मलक्षणम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000352003, "chapter_id": 20352, "verse_number": "२-२४-४", "content_sanskrit": "वज्रेण घातयामास संध्यामास्यंतमेव हि ।\nएवं श्रुत्वा ततः क्रुद्धो मरीचितनयस्तदा॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000352004, "chapter_id": 20352, "verse_number": "२-२४-५", "content_sanskrit": "क्रोधेन महताविष्टः प्रजज्वालेव वह्निना ।\nअवलुंच्य जटामेकां शुच्यग्नौ स द्विजोत्तमः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000352005, "chapter_id": 20352, "verse_number": "२-२४-६", "content_sanskrit": "इंद्रस्यैव वधार्थाय पुत्रमुत्पादयाम्यहम् ।\nतस्मात्कुंडात्समुत्पन्नो हुताशनमुखादपि॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000352006, "chapter_id": 20352, "verse_number": "२-२४-७", "content_sanskrit": "कृष्णांजनचयोपेतः पिंगाक्षो भीषणाकृतिः ।\nदंष्ट्राकरालवक्त्रांतो जगतां भयदायकः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000352007, "chapter_id": 20352, "verse_number": "२-२४-८", "content_sanskrit": "महाचर्वरिको घोरः खड्गचर्मधरस्तथा ।\nसर्वांगतेजसा दीप्तो महामेघोपमो बली॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000352008, "chapter_id": 20352, "verse_number": "२-२४-९", "content_sanskrit": "उवाच कश्यपं विप्रमादेशो मम दीयताम् ।\nकस्मादुत्पादितो विप्र भवता कारणं वद॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000352009, "chapter_id": 20352, "verse_number": "२-२४-१०", "content_sanskrit": "तमहं साधयिष्यामि प्रसादात्तव सुव्रत ।\nकश्यप उवाच ।\nअस्या मनोरथं पुत्र पूरयस्व ममैव हि॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000352010, "chapter_id": 20352, "verse_number": "२-२४-११", "content_sanskrit": "अदित्यास्त्वं महाप्राज्ञ जहि इंद्रं दुरात्मकम् ।\nनिहते देवराजे हि ऐंद्रं पदं प्रभुंक्ष्व च॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000352011, "chapter_id": 20352, "verse_number": "२-२४-१२", "content_sanskrit": "एवं तेन समादिष्टः कश्यपेन महात्मना ।\nवृत्रस्तु उद्यमं चक्रे तस्येंद्रस्य वधाय च॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000352012, "chapter_id": 20352, "verse_number": "२-२४-१३", "content_sanskrit": "धनुर्वेदस्य चाभ्यासं स चक्रे पौरुषान्वितः ।\nबलं वीर्यं तथा क्षात्रं तेजो धैर्यसमन्वितम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000352013, "chapter_id": 20352, "verse_number": "२-२४-१४", "content_sanskrit": "दृष्ट्वा हि तस्य दैत्यस्य सहस्राक्षो भयातुरः ।\nउपायं चिंतितं तस्य वृत्रस्यापि दुरात्मनः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000352014, "chapter_id": 20352, "verse_number": "२-२४-१५", "content_sanskrit": "वधार्थं देवदेवेन समाहूय महामुनीन् ।\nसप्तर्षीन्प्रेषयामास वृत्रं दैत्येश्वरं प्रति॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000352015, "chapter_id": 20352, "verse_number": "२-२४-१६", "content_sanskrit": "भवंतस्तत्र गच्छंतु यत्र वृत्रः स तिष्ठति ।\nसंधिं कुर्वंतु वै तेन सार्द्धं मम मुनीश्वराः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000352016, "chapter_id": 20352, "verse_number": "२-२४-१७", "content_sanskrit": "एवं तेन समादिष्टा मुनयः सप्त ते तदा ।\nवृत्रासुरं ततः प्रोचुः सहस्राक्ष प्रचालिताः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000352017, "chapter_id": 20352, "verse_number": "२-२४-१८", "content_sanskrit": "सख्यं कर्तुं प्रयच्छेत्स क्रियतां दैत्यसत्तम ।\nऋषयः सप्ततत्त्वज्ञा ऊचुर्वृत्रं महाबलम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000352018, "chapter_id": 20352, "verse_number": "२-२४-१९", "content_sanskrit": "सहस्राक्षो महाप्राज्ञो भवता सह सत्तम ।\nमैत्रमिच्छति वै कर्तुं तत्कथं न करोषि किम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000352019, "chapter_id": 20352, "verse_number": "२-२४-२०", "content_sanskrit": "अर्धमैंद्रं पदं वीर सत्वं भुंक्ष्व सुखेन वै ।\nवर्तंत्वर्द्धेन इंद्रस्तु असुरा देवतास्तथा॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000352020, "chapter_id": 20352, "verse_number": "२-२४-२१", "content_sanskrit": "सुखं वर्तंतु ते सर्वे वैरं चैव विसृज्य वै ।\nवृत्र उवाच ।\nयदि सत्येन देवेंद्रो मैत्रमिच्छति सत्तमः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000352021, "chapter_id": 20352, "verse_number": "२-२४-२२", "content_sanskrit": "सत्यमाश्रित्य चैवाहं करिष्ये नात्र संशयः ।\nछद्म चैवं पुरस्कृत्य इंद्रो द्रोहं समाचरेत्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000352022, "chapter_id": 20352, "verse_number": "२-२४-२३", "content_sanskrit": "तदा किं क्रियते विप्रा इत्यर्थे प्रत्ययं हि किम् ।\nऋषयस्त्विंद्रमाचख्युरित्यर्थं प्रत्ययं वद॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000352023, "chapter_id": 20352, "verse_number": "२-२४-२४", "content_sanskrit": "तन्नस्त्वं सत्यतां ब्रूहि यदि सख्यमिहेच्छसि ।\nइंद्र उवाच ।\nयद्यऽसत्येन वर्तामि भवद्भिः सह छद्मना॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000352024, "chapter_id": 20352, "verse_number": "२-२४-२५", "content_sanskrit": "ब्रह्महत्यादिकैः पापैर्लिप्येहं नात्र संशयः ।\nछद्म चैवं पुरस्कृत्य इंद्रो द्रोहं समाचरेत्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000352025, "chapter_id": 20352, "verse_number": "२-२४-२६", "content_sanskrit": "ब्रह्महत्यादिकैः पापैर्लिप्येहं नात्र संशयः ।\nइत्युवाच महाप्राज्ञ त्वामेवं स पुरंदरः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000352026, "chapter_id": 20352, "verse_number": "२-२४-२७", "content_sanskrit": "एतेन प्रत्ययेनापि सख्यं कुरु महामते ।\nवृत्र उवाच ।\nभवतां शिष्टमार्गेण सत्येनानेन तस्य च॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000352027, "chapter_id": 20352, "verse_number": "२-२४-२८", "content_sanskrit": "मैत्रमेवं करिष्यामि तेन सार्द्धं द्विजोत्तमाः ।\nवृत्रमिंद्रस्यसंस्थानं नीतं ब्राह्मणपुङ्गवैः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000352028, "chapter_id": 20352, "verse_number": "२-२४-२९", "content_sanskrit": "इन्द्रस्तमागतं दृष्ट्वा वृत्रं मित्रार्थमुद्यतः ।\nसिंहासनात्समुत्थाय अर्घमादाय सत्वरः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000352029, "chapter_id": 20352, "verse_number": "२-२४-३०", "content_sanskrit": "ददौ तस्मै स धर्मात्मा वृत्राय द्विजसत्तम ।\nअर्धं भुंक्ष्व महाप्राज्ञ ऐंद्रमेतन्महत्पदम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000352030, "chapter_id": 20352, "verse_number": "२-२४-३१", "content_sanskrit": "वर्तितव्यं सुखेनापि आवाभ्यां दैत्यसत्तम ।\nएवं विश्वासयन्दैत्यं वृत्र मैत्रेण वै तदा॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000352031, "chapter_id": 20352, "verse_number": "२-२४-३२", "content_sanskrit": "गतेषु तेषु विप्रेषु स्वस्थानं द्विजसत्तम ।\nछिद्रं पश्यति दुष्टात्मा वृत्रस्यापि सदैव हि॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000352032, "chapter_id": 20352, "verse_number": "२-२४-३३", "content_sanskrit": "सावधानत्वमिंद्रोपि दिवारात्रौ प्रचिंतयेत् ।\nतस्यच्छिद्रं न पश्येत वृत्रस्यापि महात्मनः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000352033, "chapter_id": 20352, "verse_number": "२-२४-३४", "content_sanskrit": "उपायं चिंतयामास तस्यैव वधहेतवे ।\nरंभा संप्रेषिता तेन मोहयस्व महासुरम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000352034, "chapter_id": 20352, "verse_number": "२-२४-३५", "content_sanskrit": "येनकेनाप्युपायेन यथा हत्वा लभे सुखम् ।\nतथा कुरुष्व कल्याणि संमोहाय सुरद्विषः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000352035, "chapter_id": 20352, "verse_number": "२-२४-३६", "content_sanskrit": "वनं पुण्यं महादिव्यं पुण्यपादपसेवितम् ।\nबहुवृक्षफलोपेतं मृगपक्षिसमाकुलम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000352036, "chapter_id": 20352, "verse_number": "२-२४-३७", "content_sanskrit": "विमानमंदिरैर्दिव्यैः सर्वत्र परिशोभितम् ।\nदिव्यगंधर्वसंगीतं भ्रमराकुलितं सदा॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000352037, "chapter_id": 20352, "verse_number": "२-२४-३८", "content_sanskrit": "कोकिलानां रुतैः पुण्यैः सर्वत्र मधुरायतैः ।\nशिखिसारंगनादैश्च सर्वत्र सुसमाकुलम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000352038, "chapter_id": 20352, "verse_number": "२-२४-३९", "content_sanskrit": "दिव्यैस्तु चंदनैर्वृक्षैः सर्वत्र समलंकृतम् ।\nवापीकुंडतडागैश्च जलपूर्णैर्मनोहरैः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000352039, "chapter_id": 20352, "verse_number": "२-२४-४०", "content_sanskrit": "कमलैः शतपत्रैश्च पुष्पितैः समलंकृतम् ।\nदेवगंधर्वसंसिद्धैश्चारणैश्चैव किन्नरैः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000352040, "chapter_id": 20352, "verse_number": "२-२४-४१", "content_sanskrit": "मुनिभिः शुशुभे दिव्यैर्दिव्योद्यानवरेण च ।\nअप्सरोगणसंकीर्णं नानाकौतुकमंगलैः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000352041, "chapter_id": 20352, "verse_number": "२-२४-४२", "content_sanskrit": "हेमप्रासादसंबाधं दंडच्छत्रैश्च चामरैः ।\nकलशैश्च पताकाभिः सर्वत्रसमलंकृतम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000352042, "chapter_id": 20352, "verse_number": "२-२४-४३", "content_sanskrit": "वेदध्वनिसमाकीर्णं गीतध्वनिसमाकुलम् ।\nएवं नंदनमासाद्य सा रंभा चारुहासिनी॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000352043, "chapter_id": 20352, "verse_number": "२-२४-४४", "content_sanskrit": "अप्सरोभिः समं तत्र क्रीडत्येवं विलासिनी ।\nसूत उवाच ।\nएकदा तु स वृत्रो वै कालाकृष्टो गतो वनम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000352044, "chapter_id": 20352, "verse_number": "२-२४-४५", "content_sanskrit": "कतिभिर्दानवैः सार्द्धं मुदया परया युतः ।\nअलक्ष्ये भ्रमते पार्श्वं तस्यैव च महात्मनः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000352045, "chapter_id": 20352, "verse_number": "२-२४-४६", "content_sanskrit": "देवराजोपि विप्रेंद्रश्छिद्रान्वेषी द्विषां किल ।\nस हि वृत्रो महाप्राज्ञो विश्वस्तः सर्वकर्मसु॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000352046, "chapter_id": 20352, "verse_number": "२-२४-४७", "content_sanskrit": "इंद्रं मित्रं परं जानन्भयं चक्रे न तस्य सः ।\nभ्रममाणो वनं पश्येत्सर्वत्र परमं शुभम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000352047, "chapter_id": 20352, "verse_number": "२-२४-४८", "content_sanskrit": "सुरम्यं कौतुकवनं वनितागणसंकुलम् ।\nचंदनस्यापि वृक्षस्य छायां शीतां सुपुण्यदाम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000352048, "chapter_id": 20352, "verse_number": "२-२४-४९", "content_sanskrit": "समाश्रित्य विशालाक्षी रंभा तत्र प्रदीव्यति ।\nसखीभिस्तु महाभागा दोलारूढा यशस्विनी॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000352049, "chapter_id": 20352, "verse_number": "२-२४-५०", "content_sanskrit": "गायते सुस्वरं गीतं सर्वविश्वप्रमोहनम् ।\nतत्र वृत्रः समायातः कामाकुलितमानसः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000352050, "chapter_id": 20352, "verse_number": "२-२४-५१", "content_sanskrit": "दोलारूढां समालोक्य रंभां चारुसुलोचनाम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]