[{"id": 7002665000, "chapter_id": 22665, "verse_number": "७-८-१", "content_sanskrit": "सूत उवाच ।\nजम्बुको नाम भूपालो महीराजो भयातुरः ।\nकालियेन युतः प्राप्तो नर्मदायास्तटे शुभे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002665001, "chapter_id": 22665, "verse_number": "७-८-२", "content_sanskrit": "पार्थिवैः पूजयामास देवदेवं पिनाकिनम् ।\nषण्मासान्ते महादेवो जम्बुकं प्राह भूपतिम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002665002, "chapter_id": 22665, "verse_number": "७-८-३", "content_sanskrit": "वरं वरय तेऽभीष्टं भूप आह कृतांजलिः ।\nअजितत्वं नृपैः सर्वैर्देहि मे करुणानिधे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002665003, "chapter_id": 22665, "verse_number": "७-८-४", "content_sanskrit": "तथेत्युक्त्वा महादेवस्तत्रैवान्तर्हितोभवत् ।\nकालियस्त त्सुतो लब्ध्वा वीरो माहेश्वरं वरम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002665004, "chapter_id": 22665, "verse_number": "७-८-५", "content_sanskrit": "मोहनं सर्वसैन्यानां पितुरंतिकमाययौ ।\nपितरं प्राह नम्रात्मा देह्याज्ञां तात मत्प्रियाम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002665005, "chapter_id": 22665, "verse_number": "७-८-६", "content_sanskrit": "गमिष्यामि बलैः सार्द्धं गंगां शुद्धजलां शुभाम् ।\nतथेत्युक्त्वा पिता तस्मै ययौ तु स्वं निवेशनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002665006, "chapter_id": 22665, "verse_number": "७-८-७", "content_sanskrit": "भगिनीं प्राह बलवान्विजयैषिणि शोभने ।\nकिमिच्छसि शुभं वस्तु तदाज्ञां देहि मा चिरम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002665007, "chapter_id": 22665, "verse_number": "७-८-८", "content_sanskrit": "साह ग्रैवेयकं हारं मणिमुक्ताविभूषितम् ।\nमत्प्रियं देहि मे वीर तथेत्युक्त्वा ययौ गृहात् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002665008, "chapter_id": 22665, "verse_number": "७-८-९", "content_sanskrit": "कालियो लक्षतुरगैः संयुतस्त्वरितोऽगमत् ।\nप्राप्य गंगां सागरगां कृत्वा स्नानं विधानतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002665009, "chapter_id": 22665, "verse_number": "७-८-१०", "content_sanskrit": "दत्त्वा दानानि विप्रेभ्यो जयचन्द्रपुरीं ययौ ।\nनिर्धनः समभूद्राजा बाहुशाली महाबलः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002665010, "chapter_id": 22665, "verse_number": "७-८-११", "content_sanskrit": "कान्यकुब्जे महाहारौ न प्राप्तो बहुमूल्यकः ।\nतदोर्वीयाधिपेनैव महीशेन प्रबोधितः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002665011, "chapter_id": 22665, "verse_number": "७-८-१२", "content_sanskrit": "ययौ महावतीं रम्यां शिवदत्तवरो बली ।\nरुरोध नगरीं सर्वां श्रुत्वा राजा भयातुरः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002665012, "chapter_id": 22665, "verse_number": "७-८-१३", "content_sanskrit": "रुद्रं कपर्दिनं शंभुं शरण्यं शरणं ययौ ।\nशिवाज्ञया नृपो धीमान्बलैः षष्टिसहस्रकैः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002665013, "chapter_id": 22665, "verse_number": "७-८-१४", "content_sanskrit": "सार्द्धं पुराद्बहिर्यातस्त्रिभिः शूरैः सुरक्षितः ।\nतस्य नागाः सहस्रं च देशराजश्च तत्पतिः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002665014, "chapter_id": 22665, "verse_number": "७-८-१५", "content_sanskrit": "हयाः षोडशसाहस्रा वत्सराजस्तु तत्पतिः ।\nशेषाः पदातयस्तस्य तालनेनैव रक्षिताः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002665015, "chapter_id": 22665, "verse_number": "७-८-१६", "content_sanskrit": "प्रनष्टो मुलं युद्धं तेषां वीरवरक्षयम् ।\nअहोरात्रप्रमाणेन महद्घोरमवर्तत ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002665016, "chapter_id": 22665, "verse_number": "७-८-१७", "content_sanskrit": "ते हत्वा शात्रवीं सेनां चक्रुर्जयरवान्मुहुः ।\nभयार्ता नार्मदेयाश्च माहिष्मतिनिवासिनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002665017, "chapter_id": 22665, "verse_number": "७-८-१८", "content_sanskrit": "दुद्रुवुः सर्वतो विप्र दृष्ट्वा तान्कालियो नृपः ।\nआश्वास्य प्रययौ युद्धमर्द्धसैन्यसमन्वितः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002665018, "chapter_id": 22665, "verse_number": "७-८-१९", "content_sanskrit": "हृदि कृत्वा महादेवं मोहनं बाणमादधत् ।\nसिद्धमन्त्रप्रभावेण मोहितास्ते बभूविरे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002665019, "chapter_id": 22665, "verse_number": "७-८-२०", "content_sanskrit": "शेषास्ते शत्रवः सर्वे रिपुघाताय संययुः ।\nअलसांस्तान्कपालेषु जघ्नुस्ते भयवर्जिताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002665020, "chapter_id": 22665, "verse_number": "७-८-२१", "content_sanskrit": "भीष्मसिंहस्तथा दृष्ट्वा बोधयामास सैनिकान् ।\nसूर्यदत्तेन बाणेन संज्ञाख्यानेन तत्र वै ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002665021, "chapter_id": 22665, "verse_number": "७-८-२२", "content_sanskrit": "भैरवाख्येन भल्लेन शत्रुदेहमताडयत् ।\nमूर्च्छितः सोऽपतद्वीरो गजपृष्ठे शरार्दितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002665022, "chapter_id": 22665, "verse_number": "७-८-२३", "content_sanskrit": "तदा माहिष्मती सेना निर्ययौ सा दिशौ दश ।\nमुहूर्तं कश्मलं प्राप्य पुनरुत्थाय कालियः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002665023, "chapter_id": 22665, "verse_number": "७-८-२४", "content_sanskrit": "भल्लेन तच्छिरः कायादपाहरत भूमिपः ।\nहते तस्मिन्महावीर्ये तालनाद्या महा बलाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002665024, "chapter_id": 22665, "verse_number": "७-८-२५", "content_sanskrit": "कालियं ते पराजित्य तं शत्रुं प्रत्यषेधयन् ।\nमहाकष्टान्वितो भूपो ध्यात्वा मनसि शंकरम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002665025, "chapter_id": 22665, "verse_number": "७-८-२६", "content_sanskrit": "मोहयित्वा रिपून्सर्वान् ययौ स्वं निवेशनम् ।\nअर्द्धसैन्येन सहिता हतशेषास्त्रयस्तथा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002665026, "chapter_id": 22665, "verse_number": "७-८-२७", "content_sanskrit": "तदा परिमलो राजा दृष्ट्वा शत्रुपराजयम् ।\nपरिष्वज्य महावीरान्स्व गेहं पुनराययौ ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002665027, "chapter_id": 22665, "verse_number": "७-८-२८", "content_sanskrit": "जयचन्द्रस्तु तच्छुत्वा परं विस्मयमागतः ।\nतालनं च समाहूय सेनाधीशमकरायत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002665028, "chapter_id": 22665, "verse_number": "७-८-२९", "content_sanskrit": "भीष्मसिंहे गते लोके पंचमासान्तरे नृपे ।\nतत्पत्नी जनयामास पुत्ररत्नं शुभाननम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002665029, "chapter_id": 22665, "verse_number": "७-८-३०", "content_sanskrit": "सा तु गुर्जरभूपस्य तनयाख्या मदालसा ।\nदिव्यं पुत्रं समालोक्य मुमुदे सगणा भृशम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002665030, "chapter_id": 22665, "verse_number": "७-८-३१", "content_sanskrit": "श्रुत्वा तज्जन्म नृपतिर्विततार धनं बहु ।\nआहूय गणकान्प्राज्ञाञ्जातकर्म ह्यकारयत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002665031, "chapter_id": 22665, "verse_number": "७-८-३२", "content_sanskrit": "सहदेवांश एवासौ भुवि जातः शिवाज्ञया ।\nदेवसिंहः कृतो नाम गणकैः शास्त्रचिंतकैः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]