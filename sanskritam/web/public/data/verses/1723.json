[{"id": 2033582, "chapter_id": 1723, "verse_number": "४-४६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2033583, "chapter_id": 1723, "verse_number": "४-४६-१", "content_sanskrit": "भारद्वाजस्ततो द्रोणः सर्वशस्त्रभृतांवरः।\nराजानं चाह संप्रेक्ष्य दुर्योधनमरिंदमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2033584, "chapter_id": 1723, "verse_number": "४-४६-२", "content_sanskrit": "यथा रथस्य निर्घोषो यथा शङ्ख उदीर्यते।\nकम्पते च यथा भूमिर्नैषोन्यः सव्यसाचिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2033585, "chapter_id": 1723, "verse_number": "४-४६-३", "content_sanskrit": "औत्पातिकमिदं राजन्निमित्तं भवतीह नः।\nन हि पश्यामि विजयं सैन्येऽस्माकं परन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2033586, "chapter_id": 1723, "verse_number": "४-४६-४", "content_sanskrit": "शस्त्राणि न प्रकाशन्ते न प्रहृष्यन्ति वाहनाः ।\nअग्नयश्च न भासन्ते सुसमिद्धा न शोभनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2033587, "chapter_id": 1723, "verse_number": "४-४६-५", "content_sanskrit": "प्रत्यादित्यं च नः सर्वे मृगा घोरा नदन्ति च।\nशकुनाश्चापसव्याश्च वेदयन्ति महाभयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2033588, "chapter_id": 1723, "verse_number": "४-४६-६", "content_sanskrit": "गोमायुरेष सैन्यानां रुदन्मध्येन धावति।\nचाषा नदन्ति चाकाशे वेदयन्तो महद्भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2033589, "chapter_id": 1723, "verse_number": "४-४६-७", "content_sanskrit": "भवतां चैव रोमाणि प्रहृष्टानीव लक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2033590, "chapter_id": 1723, "verse_number": "४-४६-८", "content_sanskrit": "अनुष्णाङ्गाश्च संस्विन्ना जृम्भन्ते चाप्यभीक्ष्णशः ।\nविष्कम्भन्ति च मातङ्गा मुञ्चन्त्यश्रूणि वाजिनः ।\nसदा मूत्रं पुरीषं च उत्सृजन्ति पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2033591, "chapter_id": 1723, "verse_number": "४-४६-९", "content_sanskrit": "लोहितार्द्रा च पृथिवी दिशः सर्वाः प्रधूमिताः ।\nन च सूर्यः प्रतपति महद्वेदयते भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2033592, "chapter_id": 1723, "verse_number": "४-४६-१०", "content_sanskrit": "हस्तिनश्चापि वित्रस्ता योधाश्चापि वितत्रसुः ।\nपराभूता च वः सेना न कश्चिद्योद्भुमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2033593, "chapter_id": 1723, "verse_number": "४-४६-११", "content_sanskrit": "विषण्णमुखभूयिष्ठाः सर्वे योधा विचेतसः ।\nदिशं ते दक्षिणां सर्वे विप्रेक्षन्ते पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2033594, "chapter_id": 1723, "verse_number": "४-४६-१२", "content_sanskrit": "मृगाश्च पक्षिणश्चैव सव्यमेव पतन्ति नः।\nवादित्रोद्धृष्टघोषाश्च न च गाढं स्वनन्ति च।\nध्वजाग्रेषु निलीयन्ते वायसास्तन्न शोभनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2033595, "chapter_id": 1723, "verse_number": "४-४६-१३", "content_sanskrit": "यथा मेघस्य निनदो गम्भीरस्तूर्णमायतः।\nश्रूयते रथनिर्घोषो नायमन्यो धनञ्जयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2033596, "chapter_id": 1723, "verse_number": "४-४६-१४", "content_sanskrit": "अश्वानां स्वनतां शब्दो वहतां पाकशासनिम् ।\nवानरस्य रथे दिव्यो निस्वनः श्रूयते महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2033597, "chapter_id": 1723, "verse_number": "४-४६-१५", "content_sanskrit": "शङ्खशब्देन पार्थस्य कर्णौ मे बधिरीकृतौ ।\nसर्वसैन्यं च वित्रस्तं नायमन्यो धनञ्जयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2033598, "chapter_id": 1723, "verse_number": "४-४६-१६", "content_sanskrit": "राजानमग्रतः कृत्वा दुर्योधनमरिन्दमम्।\nगाः प्रस्थाप्य च तिष्ठामो व्यूढानीकाः प्रहारिणः ।\nप्रविभज्य त्रिधा सेनां समुच्छ्रित्य ध्वजानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2033599, "chapter_id": 1723, "verse_number": "४-४६-१७", "content_sanskrit": "शितैर्बाणैः प्रताप्येमां चमूमेष धनञ्जयः।\nमूर्ध्नि सर्वनरेन्द्राणां वामपादं करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2033600, "chapter_id": 1723, "verse_number": "४-४६-१८", "content_sanskrit": "न ह्येष शक्यो बीभत्सुर्जेतुं देवासुरैरपि ।\nदिक्षु गुल्मा निवेश्यन्तां यत्ता योत्स्यामहेऽर्जुन ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2033601, "chapter_id": 1723, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि षट्चत्वारिंशोऽध्यायः ॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]