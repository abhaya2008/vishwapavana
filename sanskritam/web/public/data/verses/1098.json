[{"id": 2004995, "chapter_id": 1098, "verse_number": "१-९९-०x", "content_sanskrit": "शकुन्तलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2004996, "chapter_id": 1098, "verse_number": "१-९९-१", "content_sanskrit": "राजन्सर्षपमात्राणि परच्छिद्राणि पश्यसि।\nआत्मनो बिल्वमात्राणि पश्यन्नपि न पश्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2004997, "chapter_id": 1098, "verse_number": "१-९९-२", "content_sanskrit": "मेनका त्रिदशेष्वेव त्रिदशाश्चानु मेनकाम्।\nममैवोद्रिच्यते जन्म दुष्यन्त तव जन्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2004998, "chapter_id": 1098, "verse_number": "१-९९-३", "content_sanskrit": "क्षितौ चरसि राजंस्त्वमन्तरिक्षे चराम्यहम्।\nआवयोरन्तरं पश्य मेरुसर्षपयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2004999, "chapter_id": 1098, "verse_number": "१-९९-४", "content_sanskrit": "महेन्द्रस्य कुबेरस्य यमस्य वरुणस्य च।\nभवनान्यनुसंयामि प्रभावं पश्य मे नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2005000, "chapter_id": 1098, "verse_number": "१-९९-५", "content_sanskrit": "पुरा नरवरः पुत्र उर्वश्यां जनितस्तदा।\nआयुर्नाम महाराज तव पूर्वपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2005001, "chapter_id": 1098, "verse_number": "१-९९-६", "content_sanskrit": "महर्षयश्च बहवः क्षत्रियाश्च परन्तपाः।\nअप्सरःसु ऋषीणां च मातृदोषो न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2005002, "chapter_id": 1098, "verse_number": "१-९९-७", "content_sanskrit": "सत्यश्चापि प्रवादोऽयं प्रवक्ष्यामि च ते नृप।\nनिदर्शनार्थं न द्वेषाच्छ्रुत्वा तत्क्षन्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2005003, "chapter_id": 1098, "verse_number": "१-९९-८", "content_sanskrit": "विरूपो यावदादर्शे नात्मनो वीक्षते मुखम्।\nमन्यते तावदात्मानमन्येभ्यो रूपवत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2005004, "chapter_id": 1098, "verse_number": "१-९९-९", "content_sanskrit": "यदा तु रूपमादर्शे विरूपं सोऽभिवीक्षते।\nतदा ह्रीमांस्तु जानीयादन्तरं नेतरं जनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2005005, "chapter_id": 1098, "verse_number": "१-९९-१०", "content_sanskrit": "अतीव रूपसंपन्नो न कंचिदवमन्यते।\nअतीव जल्पन्दुर्वाचो भवतीह विहेतुकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2005006, "chapter_id": 1098, "verse_number": "१-९९-११", "content_sanskrit": "पांसुपातेन हृष्यन्ति कुञ्जरा मदशालिनः।\nतथा परिवदन्नन्यान्हृष्टो भवति दुर्मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2005007, "chapter_id": 1098, "verse_number": "१-९९-१२", "content_sanskrit": "सत्यधर्मच्युतात्पुंसः क्रुद्धादाशीविषादिव।\nसुनास्तिकोप्युद्विजते जनः किं पुनरास्तिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2005008, "chapter_id": 1098, "verse_number": "१-९९-१३", "content_sanskrit": "स्वयमुत्पाद्य पुत्रं वै सदृशं योऽवमन्यते।\nतस्य देवाः श्रियं घ्नन्ति तत्रैनं कलिराविशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2005009, "chapter_id": 1098, "verse_number": "१-९९-१४", "content_sanskrit": "अभव्येऽप्यनृतेऽशुद्धे नास्तिके पापकर्मणि।\nदुराचारे कलिर्ह्याशु न कलिर्धर्मचारिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2005010, "chapter_id": 1098, "verse_number": "१-९९-१५", "content_sanskrit": "मूर्खो हि जल्पतां पुंसां श्रुत्वा वाचः शुभाशुभाः।\nअशुभं वाक्यमादत्ते पुरीषमिव सूकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2005011, "chapter_id": 1098, "verse_number": "१-९९-१६", "content_sanskrit": "प्राज्ञस्तु जल्पतां पुंसां श्रुत्वा वाचः शुभाशुभाः।\nगुणवद्वाक्यमादत्ते हंसः क्षीरमिवाम्भसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2005012, "chapter_id": 1098, "verse_number": "१-९९-१७", "content_sanskrit": "आत्मनो दुष्टभावत्वं जानन्नीचोऽप्रसन्नधीः।\nपरेषामपि जानाति स्वधर्मसदृशान्गुणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2005013, "chapter_id": 1098, "verse_number": "१-९९-१८", "content_sanskrit": "दह्यमानास्तु तीव्रेण नीचाः परयशोग्निना।\nअशक्तास्तद्गतिं गन्तुं ततो निन्दां प्रकुर्वते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2005014, "chapter_id": 1098, "verse_number": "१-९९-१९", "content_sanskrit": "अन्यान्परिवदन्साधुर्यथा हि परितप्यते।\nतथा परिवदन्नन्यान्हृष्टो भवति दुर्जनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2005015, "chapter_id": 1098, "verse_number": "१-९९-२०", "content_sanskrit": "अपवादरता मूर्खा भवन्ति हि विशेषतः।\nनापवादरताः सन्तो भवन्ति स्म विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2005016, "chapter_id": 1098, "verse_number": "१-९९-२१", "content_sanskrit": "अभिवाद्य यथा वृद्धान्साधुर्गच्छति निर्वृतिम्।\nएवं सज्जनमाक्रुश्य मूर्खो भवति निर्वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2005017, "chapter_id": 1098, "verse_number": "१-९९-२२", "content_sanskrit": "सुखं जीवन्त्यदोषज्ञा मूर्खा दोषानुदर्शिनः।\nयथा वाच्याः परैः सन्तः परानाहुस्तथाविधान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2005018, "chapter_id": 1098, "verse_number": "१-९९-२३", "content_sanskrit": "अतो हास्यतरं लोके किंचिदन्यन्न विद्यते।\nयदि दुर्जन इत्याहुः सज्जनं दुर्जनाः स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2005019, "chapter_id": 1098, "verse_number": "१-९९-२४", "content_sanskrit": "दारुणाल्लोकसंक्लेशाद्दुःखमाप्नोत्यसंशयम्॥\nकुलवंशप्रतिष्ठां हि पितरः पुत्रमब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2005020, "chapter_id": 1098, "verse_number": "१-९९-२५", "content_sanskrit": "उत्तमं सर्वधर्माणां तस्मात्पुत्रं तु न त्यजेत्।\nस्वपत्नीप्रभवाँल्लब्धान्कृतान्समयवर्धितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2005021, "chapter_id": 1098, "verse_number": "१-९९-२६", "content_sanskrit": "क्रीतान्कन्यासु चोत्पन्नान्पुत्रान्वै मनुरब्रवीत्।\nते च षड्वन्धुदायादाः षडदायादबान्धवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2005022, "chapter_id": 1098, "verse_number": "१-९९-२७", "content_sanskrit": "धर्मकृत्यवहा नॄणां मनसः प्रीतिवर्धनाः।\nत्रायन्ते नरकाज्जाताः पुत्रा धर्मप्लवाः पितॄन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2005023, "chapter_id": 1098, "verse_number": "१-९९-२८", "content_sanskrit": "स त्वं नृपतिशार्दूल न पुत्रं त्यक्तुमर्हसि।\nतस्मात्पुत्रं च सत्यं च पालयस्व महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2005024, "chapter_id": 1098, "verse_number": "१-९९-२९", "content_sanskrit": "उभयं पालयस्वैतन्नानृतं वक्तुमर्हसि।\nआत्मानं सत्यधर्मौ च पालयेथा महीपते।\nनरेन्द्रसिंह कपटं न हि वोढुं त्वमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2005025, "chapter_id": 1098, "verse_number": "१-९९-३०", "content_sanskrit": "वरं कूपशताद्वापी वरं वापीशतात्क्रतुः।\nवरं क्रतुशतात्पुत्रः सत्यं पुत्रशताद्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2005026, "chapter_id": 1098, "verse_number": "१-९९-३१", "content_sanskrit": "अश्वमेधसहस्रं च सत्यं च तुलया धृतम्।\nअश्वमेधसहस्राद्धि सत्यमेव विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2005027, "chapter_id": 1098, "verse_number": "१-९९-३२", "content_sanskrit": "सर्ववेदाधिगमनं सर्वतीर्थावगाहनम्।\nसत्यस्यैव च राजेन्द्र कलां नार्हति षोडशीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2005028, "chapter_id": 1098, "verse_number": "१-९९-३३", "content_sanskrit": "नास्ति सत्यसमो धर्मो न सत्याद्विद्यते परम्।\nन हि तीव्रतरं पापमनृतादिह विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2005029, "chapter_id": 1098, "verse_number": "१-९९-३४", "content_sanskrit": "राजन्सत्यं परो धर्मः सत्याच्च समयः परः।\nमात्याक्षीः समयं राजन्सत्यं सङ्गतमस्तु ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2005030, "chapter_id": 1098, "verse_number": "१-९९-३५", "content_sanskrit": "यः पापो न विजानीयात्कर्म कृत्वा नराधिप।\nन हि तादृक्परं पापमनृतादिह विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2005031, "chapter_id": 1098, "verse_number": "१-९९-३६", "content_sanskrit": "यस्य ते हृदयं वेद सत्यस्यैवानृतस्य च।\nकल्याणावेक्षणं तस्मात्कर्तुमर्हसि धर्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2005032, "chapter_id": 1098, "verse_number": "१-९९-३७", "content_sanskrit": "यो न कामान्न च क्रोधान्न द्रोहादतिवर्तते।\nअमित्रं वापि मित्रं वा स एवोत्तमपूरुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2005033, "chapter_id": 1098, "verse_number": "१-९९-३८", "content_sanskrit": "अनृतश्चेत्प्रसङ्गस्ते श्रद्दधासि न चेत्स्वयम्।\nआश्रमं गन्तुमिच्छामि त्वादृशो नास्ति सङ्गतं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2005034, "chapter_id": 1098, "verse_number": "१-९९-३९", "content_sanskrit": "पुत्रत्वे शङ्कमानस्य त्वं बुद्ध्या निश्चयं कुरु।\nगतिः स्वरः स्मृतिः सत्वं शीलं विद्या च विक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2005035, "chapter_id": 1098, "verse_number": "१-९९-४०", "content_sanskrit": "धृष्णुप्रकृतिभावौ च आवर्ता रोमराजयः।\nसमा यस्य यदा स्युस्ते तस्य पुत्रो न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2005036, "chapter_id": 1098, "verse_number": "१-९९-४१", "content_sanskrit": "सादृश्येनोद्धऋतं बिम्बं तव देहाद्विशांपते।\nतातेति भाषमाणं वै मा स्म राजन्वृथा कृथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2005037, "chapter_id": 1098, "verse_number": "१-९९-४२", "content_sanskrit": "ऋते च गर्दभीक्षीरात्पयः पास्यति मे सुतः।\nऋतेपि त्वां च दुष्यन्त शैलराजावतंसिकाम्।\nचतुरन्तामिमामुर्वीं पुत्रो मे पालयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2005038, "chapter_id": 1098, "verse_number": "१-९९-४३", "content_sanskrit": "शकुन्तले तव सुतश्चक्रवर्ती भविष्यति।\nएवमुक्तं महेन्द्रेण भविष्यति न चान्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2005039, "chapter_id": 1098, "verse_number": "१-९९-४४", "content_sanskrit": "साक्षित्वे बहवो ह्युक्ता देवदूतादयो मया।\nन ब्रुवन्ति तथा सत्यमुताहो नानृतं किल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2005040, "chapter_id": 1098, "verse_number": "१-९९-४५", "content_sanskrit": "असाक्षिणी मन्दबाग्या गमिष्यामि यथागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2005041, "chapter_id": 1098, "verse_number": "१-९९-४६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2005042, "chapter_id": 1098, "verse_number": "१-९९-४६", "content_sanskrit": "एतावदुक्त्वा वचनं प्रातिष्ठत शकुन्तला।\nतस्याः क्रोधसमुत्थोग्निः सधूमो मूर्ध्न्यदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2005043, "chapter_id": 1098, "verse_number": "१-९९-४७", "content_sanskrit": "संनियम्यात्मनोऽङ्गेषु ततः क्रोधाग्निमात्मजम्।\nप्रस्थितैवानवद्याङ्गी सह पुत्रेण वै वनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2005044, "chapter_id": 1098, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि एकोनशततमोऽध्यायः॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]