[{"id": 2106157, "chapter_id": 3302, "verse_number": "१६-३१-१", "content_sanskrit": "जनमेजय उवाच।\nवनवासं गते विप्र धृतराष्ट्रे महीपतौ।\nसभार्ये नृपशार्दूले वध्वा कुन्त्या समन्विते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2106158, "chapter_id": 3302, "verse_number": "१६-३१-२", "content_sanskrit": "विदुरे चापि धर्मज्ञे धर्मराजं व्यपश्रिते।\nवसत्सु पाण्डुपुत्रेषु सर्वेष्वाश्रममण्डले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2106159, "chapter_id": 3302, "verse_number": "१६-३१-३", "content_sanskrit": "यत्तदाश्चर्यमिति वै करिष्यामीत्युवाच ह।\nव्यासः परमतेजस्वी महर्षिस्तद्वदस्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2106160, "chapter_id": 3302, "verse_number": "१६-३१-४", "content_sanskrit": "वनवासे च कौरव्याः कियन्तं कालमच्युतः।\nयुधिष्ठिरो नरपतिर्न्यवसत्सजनस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2106161, "chapter_id": 3302, "verse_number": "१६-३१-५", "content_sanskrit": "किमाहाराश्च ते तत्र ससैन्या न्यवसन्प्रभो।\nसान्तःपुरा महात्मान एतदिच्छामि वेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2106162, "chapter_id": 3302, "verse_number": "१६-३१-६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2106163, "chapter_id": 3302, "verse_number": "१६-३१-६", "content_sanskrit": "`वनवासगतं राजन्धृतराष्ट्रं महीपतिम्।\nयुधिष्ठिरोऽभ्ययाद्द्रष्टुं ससैन्यो भ्रातृभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2106164, "chapter_id": 3302, "verse_number": "१६-३१-७", "content_sanskrit": "प्रथमे दिवसे चैषामापो मूलं फलं तथा।\nभोजनं भूमिशय्या च तत्रासीद्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2106165, "chapter_id": 3302, "verse_number": "१६-३१-८", "content_sanskrit": "तेऽनुज्ञातास्तदा राजन्कुरुराजेन पाण्डवाः।\nविविधान्यन्नपानानि शय्याश्चैवाभजन्वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2106166, "chapter_id": 3302, "verse_number": "१६-३१-९", "content_sanskrit": "मासमेकं विजह्रुस्ते ससैन्यान्तःपुरो वने।\nअथ तत्रागमद्व्यासो यथोक्तं ते मयाऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2106167, "chapter_id": 3302, "verse_number": "१६-३१-१०", "content_sanskrit": "तथा च तेषां सर्वेषां कथाभिर्नृपसन्निधौ।\nव्यासन्वास्य तं राजन्नाजग्मुर्मुनयोऽपरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2106168, "chapter_id": 3302, "verse_number": "१६-३१-११", "content_sanskrit": "नारदः पर्वतश्चैव देवलश्च महातपाः।\nविश्वावसुस्तुंबुरुश्च चित्रसेनश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2106169, "chapter_id": 3302, "verse_number": "१६-३१-१२", "content_sanskrit": "तेषामपि यथान्यायं पूजां चक्रे महातपाः।\nधृतराष्ट्राभ्यनुज्ञातः कुरराजो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2106170, "chapter_id": 3302, "verse_number": "१६-३१-१३", "content_sanskrit": "निषेदुस्ते ततः सर्वे पूजां प्राप्य युधिष्ठिरात्।\nआसनेषु च पुण्येषु बर्हिणेषु वरेषउ च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2106171, "chapter_id": 3302, "verse_number": "१६-३१-१४", "content_sanskrit": "तेषु तत्रोपविष्टेषु स तु राजा महामतिः।\nपाण्डुपुत्रैः परिवृतो निषसाद कुरूद्वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2106172, "chapter_id": 3302, "verse_number": "१६-३१-१५", "content_sanskrit": "गान्धारी चैव कुन्ती च द्रौपदी सात्वती तथा।\nस्त्रियश्चान्यास्तथाऽन्याभिः सहोपविविशुस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2106173, "chapter_id": 3302, "verse_number": "१६-३१-१६", "content_sanskrit": "तेषां तत्र कथा दिव्या धर्मिष्ठाश्चाभवन्नृप।\nराजर्षीणां पुराणानां देवासुरविभिश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2106174, "chapter_id": 3302, "verse_number": "१६-३१-१७", "content_sanskrit": "ततः कथान्ते व्यासस्तं प्रज्ञाचक्षुषमीश्वरम्।\nप्रोवाच वदतांश्रेष्ठः पुनरेव स तद्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2106175, "chapter_id": 3302, "verse_number": "१६-३१-१८", "content_sanskrit": "प्रीयमाणो महातेजाः सर्ववेदविदांवरः।\nविदितं मम राजेन्द्र यत्ते हृदि विवक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2106176, "chapter_id": 3302, "verse_number": "१६-३१-१९", "content_sanskrit": "दह्यमानस्य शोकेन तव पुत्रकृतेन वै।\nगान्धार्याश्चैव यद्दुःखं हृदि तिष्टति नित्यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2106177, "chapter_id": 3302, "verse_number": "१६-३१-२०", "content_sanskrit": "कुन्त्याश्च यन्महाराज द्रौपद्याश्च हृदि स्थितम्।\nयच्च धारयते तीव्रं दुःखं पुत्रविनाशजम्।\nसुभद्रा कृष्णभगिनी तच्चापि विदितं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2106178, "chapter_id": 3302, "verse_number": "१६-३१-२१", "content_sanskrit": "श्रुत्वा समागममिमं सर्वेषां वस्ततो नृप।\nसंशयच्छेदनार्थाय प्राप्तः कौरवनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2106179, "chapter_id": 3302, "verse_number": "१६-३१-२२", "content_sanskrit": "इमे च देवगन्धर्वाः सर्वे चेमे महर्षयः।\nपश्यन्तु तपसो वीर्यमद्य मे चिरसम्भृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2106180, "chapter_id": 3302, "verse_number": "१६-३१-२३", "content_sanskrit": "तदुच्यतां महाप्राज्ञ कं कामं प्रददामि ते।\nप्रवणोस्मि वरं दातुं पश्य मे तपसो बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2106181, "chapter_id": 3302, "verse_number": "१६-३१-२४", "content_sanskrit": "एवमुक्तः स राजेन्द्रो व्यासेनामितबुद्धिना।\nमुहूर्तमिव संचिन्त्य वचनायोपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2106182, "chapter_id": 3302, "verse_number": "१६-३१-२५", "content_sanskrit": "धन्योस्म्यनुगृहीतश्च सफलं जीवितं च मे।\nयन्मे समागमोऽद्येह भवद्भिः सह साधुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2106183, "chapter_id": 3302, "verse_number": "१६-३१-२६", "content_sanskrit": "अद्य चाप्यवगच्छामि गतिमिष्टामिहात्मनः।\nब्रह्मकल्पैर्भवद्भिर्यत्समेतोऽहं तपोधनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2106184, "chapter_id": 3302, "verse_number": "१६-३१-२७", "content_sanskrit": "दर्शनादेव भवतां पूतोऽहं नात्र संशयः।\nविद्यते न भयं चापि परलोके ममानघाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2106185, "chapter_id": 3302, "verse_number": "१६-३१-२८", "content_sanskrit": "किंतु तस्य सुदुर्बुद्धेर्मन्दस्यापनयैर्भृशम्।\nदूयते मे मनो नित्यं स्मरतः पुत्रगृद्धिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2106186, "chapter_id": 3302, "verse_number": "१६-३१-२९", "content_sanskrit": "अपापाः पाण्डवा येन निकृताः पापबुद्धिना।\nघातिता पृथिवी येन सहया सनरद्विपा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2106187, "chapter_id": 3302, "verse_number": "१६-३१-३०", "content_sanskrit": "राजानश्च महात्मानो नानाजनपदेश्वराः।\nआगम्य मम पुत्रार्थे सर्वे मृत्युवशं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2106188, "chapter_id": 3302, "verse_number": "१६-३१-३१", "content_sanskrit": "ये ते पितॄश्चं दारांश्च प्राणांश्च मनसः प्रियान्।\nपरित्यज्य गताः शूराः प्रेतराजनिवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2106189, "chapter_id": 3302, "verse_number": "१६-३१-३२", "content_sanskrit": "का नु तेषां गतिर्ब्रह्मन्मित्रार्थे ये हता मृधे।\nतथैव पुत्रपौत्राणां मम ये निहता युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2106190, "chapter_id": 3302, "verse_number": "१६-३१-३३", "content_sanskrit": "दूयते मे मनोऽभीक्ष्णं घातयित्वा महाबलम्।\nभीष्मं शान्तनवं वृद्धं द्रोणं च द्विजसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2106191, "chapter_id": 3302, "verse_number": "१६-३१-३४", "content_sanskrit": "मम पुत्रेण मूढेन पापेनाकृतबुद्धिना।\nक्षयं नीतं कुलं दीप्तं पृथिवीराज्यमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2106192, "chapter_id": 3302, "verse_number": "१६-३१-३५", "content_sanskrit": "`एते मदर्थे पुत्रांश्च दारांश्च मनसः प्रियान्।\nभोगांश्च विविधांस्तात इष्टापुर्तांस्तथैव च।\nपरित्यज्य गताः शूराः प्रेतराजनिवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2106193, "chapter_id": 3302, "verse_number": "१६-३१-३६", "content_sanskrit": "एतत्सर्वमनुस्मृत्य दह्यमानो दिवानिशम्।\nन शान्तिमधिगच्छामि दुःखशोकसमाहतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2106194, "chapter_id": 3302, "verse_number": "१६-३१-३७", "content_sanskrit": "इति मे चिन्तयानस्य पितः शान्तिर्न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2106195, "chapter_id": 3302, "verse_number": "१६-३१-३८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2106196, "chapter_id": 3302, "verse_number": "१६-३१-३८", "content_sanskrit": "तच्छ्रुत्वा विविधं तस्य राजर्षेः परिदेवितम्।\nपुनर्नवीकृतः शोको गान्धार्या जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2106197, "chapter_id": 3302, "verse_number": "१६-३१-३९", "content_sanskrit": "कुन्त्या द्रुपदपुत्र्याश्च सुभद्रायास्तथैव च।\nतासां च वरनारीणां वधूनां कौरवस्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2106198, "chapter_id": 3302, "verse_number": "१६-३१-४०", "content_sanskrit": "पुत्रशोकसमाविष्टा गान्धारी त्विदमब्रवीत्।\nश्वशुरं बद्धनयना देवी प्राञ्जलिरुत्थिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2106199, "chapter_id": 3302, "verse_number": "१६-३१-४१", "content_sanskrit": "`लोकान्तरगतान्पुत्रानयं काङ्क्षति मानद।\nतच्चास्य मासं ज्ञातं भगवंस्तपसा त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2106200, "chapter_id": 3302, "verse_number": "१६-३१-४२", "content_sanskrit": "षोडशेमानि वर्षाणि गतानि मुनिपुङ्गव।\nअस्य राज्ञोहतान्पुत्राञ्शोचतो न शमो विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2106201, "chapter_id": 3302, "verse_number": "१६-३१-४३", "content_sanskrit": "पुत्रशोकसमाविष्टो निःश्वसन्ह्येष भूमिपः।\nन शेते वसतीः सर्वा धृतराष्ट्रो महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2106202, "chapter_id": 3302, "verse_number": "१६-३१-४४", "content_sanskrit": "लोकानन्यान्समर्थोसि स्रष्टुं सर्वांस्तपोबलात्।\nकिमु लोकान्तरगतान्राज्ञो दर्शयितुं सुतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2106203, "chapter_id": 3302, "verse_number": "१६-३१-४५", "content_sanskrit": "इयं च द्रौपदी कृष्णा हतज्ञातिसुता भृशम्।\nशोचत्यतीव सर्वासां स्नुषाणां दयिता स्नुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2106204, "chapter_id": 3302, "verse_number": "१६-३१-४६", "content_sanskrit": "तथा कृष्णस्य भगिनी सुभद्रा भद्रभाषिणी।\nसौभद्रकवधसंतप्ता भृशं शोचति भामिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2106205, "chapter_id": 3302, "verse_number": "१६-३१-४७", "content_sanskrit": "इयं च भूरिश्रवसो भार्या परमसम्मता।\nभर्तृव्यसनशोकार्ता भृशं शोचति भामिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2106206, "chapter_id": 3302, "verse_number": "१६-३१-४८", "content_sanskrit": "यस्यास्तु श्वशुरो धीमान्बाह्लिकः स कुरूद्वहः।\nनिहतः सोमदत्तश्च पित्रा सह महारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2106207, "chapter_id": 3302, "verse_number": "१६-३१-४९", "content_sanskrit": "श्रीमतोस्य महाबुद्धेः सङ्ग्रामेष्वपलायिनः।\nपुत्रस्य ते पुत्रशतं निहतं यद्रणाजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2106208, "chapter_id": 3302, "verse_number": "१६-३१-५०", "content_sanskrit": "तस्य भार्याशतमिदं दुःखशोकसमाहतम्।\nपुनःपुनर्वर्धयानं शोकं रोज्ञो ममैव च।\nहताहारेण महता मामुपास्ते महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2106209, "chapter_id": 3302, "verse_number": "१६-३१-५१", "content_sanskrit": "ये च शूरा महात्मानः श्वशुरा मे महारथाः।\nसोमदत्तप्रभृतयः का नु तेषां गतिः प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2106210, "chapter_id": 3302, "verse_number": "१६-३१-५२", "content_sanskrit": "तव प्रसादाद्भगवन्विशोकोऽयं महीपतिः।\nकुर्यात्कालमहं चेयं वधूस्तव महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2106211, "chapter_id": 3302, "verse_number": "१६-३१-५३", "content_sanskrit": "इत्युक्तवत्यां गान्धार्यां कुन्ती व्रतकृशानना।\nप्रच्चन्नजातं पुत्रं तु सस्मारादित्यसन्निभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2106212, "chapter_id": 3302, "verse_number": "१६-३१-५४", "content_sanskrit": "तामृषिर्वरदो व्यासो दूरश्रवणदर्शनः।\nअपश्यद्दुःखितां देवीं मातरं सव्यसाचिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2106213, "chapter_id": 3302, "verse_number": "१६-३१-५५", "content_sanskrit": "तामुवाच ततो व्यासो यत्ते कार्यं विवक्षितम्।\nतद्बूहि त्वं महाभागे यत्ते मनसि वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2106214, "chapter_id": 3302, "verse_number": "१६-३१-५६", "content_sanskrit": "श्वशुराय तत कुन्ती प्रणम्य शिरसा तदा।\nउवाच वाक्यं सव्रीडा विवृण्वाना पुरातनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2106215, "chapter_id": 3302, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि पुत्रदर्शनपर्वणि एकत्रिंशोऽध्यायः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]