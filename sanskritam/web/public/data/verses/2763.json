[{"id": 2082682, "chapter_id": 2763, "verse_number": "१२-२६८-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082683, "chapter_id": 2763, "verse_number": "१२-२६८-१", "content_sanskrit": "इत्युक्तः स तदा तेन तुलाधारेण धीमता।\nप्रोवाच वचनं धीमाञ्जाजलिर्जपतांवरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082684, "chapter_id": 2763, "verse_number": "१२-२६८-२x", "content_sanskrit": "जाजलिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082685, "chapter_id": 2763, "verse_number": "१२-२६८-२", "content_sanskrit": "विक्रीणतः सर्वरसान्सर्वगन्धांश्च वाणिज।\nवनस्पतीनोषधीश्च तेषां मूलफलानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082686, "chapter_id": 2763, "verse_number": "१२-२६८-३", "content_sanskrit": "अग्र्या सा नैष्ठिकी बुद्धिः कुतस्त्वामियमागता।\nएतदाचक्ष्व मे सर्वं निखिलेन महामते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082687, "chapter_id": 2763, "verse_number": "१२-२६८-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082688, "chapter_id": 2763, "verse_number": "१२-२६८-४", "content_sanskrit": "एवमुक्तस्तुलाधारो ब्राह्मणेन यशस्विना।\nउवाच धर्मसूक्ष्माणि वैश्यो धर्मार्थतत्त्ववित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082689, "chapter_id": 2763, "verse_number": "१२-२६८-५", "content_sanskrit": "वेदाहं जाजले धर्मं सरहस्यं सनातनम्।\nसर्वभूतहितं मैत्रं पुराणं यं जना विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082690, "chapter_id": 2763, "verse_number": "१२-२६८-६", "content_sanskrit": "अद्रोहेणैव भूतानामल्पद्रोहेण वा पुनः।\nया वृत्तिः स परो धर्मस्तेन जीवामि जाजले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082691, "chapter_id": 2763, "verse_number": "१२-२६८-७", "content_sanskrit": "परिच्छिन्नैः काष्ठतृणैर्मयेदं शरणं कृतम्।\nअलक्तं पद्मकं तुङ्गं गन्धांश्चोच्चावचांस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082692, "chapter_id": 2763, "verse_number": "१२-२६८-८", "content_sanskrit": "रसांश्च तांस्तान्विप्रर्षे मद्यवर्ज्यान्बहूनहम्।\nक्रीत्वा वै प्रतिविक्रीणे परहस्तादमायया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082693, "chapter_id": 2763, "verse_number": "१२-२६८-९", "content_sanskrit": "सर्वेषां यः सुहृन्नित्यं सर्वेषां च हिते रतः।\nकर्मणा मनसा वाचा स धर्मं वेद जाजले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082694, "chapter_id": 2763, "verse_number": "१२-२६८-१०", "content_sanskrit": "नानुरुध्ये विरुध्ये वा न द्वेष्मि न च कामये।\nसमोऽहं सर्वभूतेषु पश्य मे जाजले व्रतम्।\nतुला मे सर्वभूतेषु समा तिष्ठति जाजले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082695, "chapter_id": 2763, "verse_number": "१२-२६८-११", "content_sanskrit": "नाहं परेषां कृत्यानि प्रशंसामि न गर्हये।\nआकाशस्येव विप्रेन्द्र पश्यँल्लोकस्य चित्रताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082696, "chapter_id": 2763, "verse_number": "१२-२६८-१२", "content_sanskrit": "`कृपा मे सर्वभूतेषु समा तिष्ठति जाजले।\nइष्टानिष्टनियुक्तस्य प्रियद्वेषौ बहिष्कृतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082697, "chapter_id": 2763, "verse_number": "१२-२६८-१३", "content_sanskrit": "इति मां त्वं विजानीहि सर्वलोकस्य जाजले।\nसमं मतिमतां श्रेष्ठ समलोष्टाश्मकाञ्चनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082698, "chapter_id": 2763, "verse_number": "१२-२६८-१४", "content_sanskrit": "यथाऽन्धबधिरोत्मत्ता उच्छ्वासपरमाः सदा।\nदेवैरपिहितद्वाराः सोपमा पश्यतो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2082699, "chapter_id": 2763, "verse_number": "१२-२६८-१५", "content_sanskrit": "यथा वृद्धातुरकृशा निस्पृहा विषयान्प्रति।\nतथाऽर्थकामभोगेषु ममापि विगता स्पृहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2082700, "chapter_id": 2763, "verse_number": "१२-२६८-१६", "content_sanskrit": "यदा चायं न बिभेति यदा चास्मान्न बिभ्यति।\nयदा नेच्छति न द्वेष्टि तदा सिद्ध्यति वै द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2082701, "chapter_id": 2763, "verse_number": "१२-२६८-१७", "content_sanskrit": "यदा न कुरुते भावं सर्वभूतेषु पापकम्।\nकर्मणा मनसा वाचा ब्रह्म संपद्यते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2082702, "chapter_id": 2763, "verse_number": "१२-२६८-१८", "content_sanskrit": "न भूतो न भविष्योऽस्ति न च धर्मोस्ति कश्चन।\nयोऽभयः सर्वभूतानां स प्राप्नोत्यभयं पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2082703, "chapter_id": 2763, "verse_number": "१२-२६८-१९", "content_sanskrit": "यस्मादुद्विजते लोकः सर्वो मृत्युमुखादिव।\nवाक्क्रूराद्दण्डपरुषात्स प्राप्नोति महद्भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2082704, "chapter_id": 2763, "verse_number": "१२-२६८-२०", "content_sanskrit": "यथावद्वर्तमानानां वृद्धानां पुत्रपौत्रिणाम्।\nअनुवर्तामहे वृत्तमहिंस्त्राणां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2082705, "chapter_id": 2763, "verse_number": "१२-२६८-२१", "content_sanskrit": "प्रनष्टः शाश्वतो धर्मः सदाचारेण मोहितः।\nतेन वैद्यस्तपस्वी वा बलवान्वा विमुह्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2082706, "chapter_id": 2763, "verse_number": "१२-२६८-२२", "content_sanskrit": "आचाराज्जाजले प्राज्ञः क्षिप्रं धर्ममवाप्नुयात्।\nएवं यः साधुभिर्दान्तश्चरेदद्रोहचेतसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2082707, "chapter_id": 2763, "verse_number": "१२-२६८-२३", "content_sanskrit": "नद्यां चेह यथा काष्ठमुह्यमानं यदृच्छया।\nयदृच्छयैव काष्ठेन सन्धि गच्छेत केनचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2082708, "chapter_id": 2763, "verse_number": "१२-२६८-२४", "content_sanskrit": "तत्रापराणि दारूणि संसृज्यन्ते ततस्ततः।\nतृणकाष्ठकरीपाणि कदाचिन्न समीक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2082709, "chapter_id": 2763, "verse_number": "१२-२६८-२५", "content_sanskrit": "यस्मान्नोद्विजते भूतं जातु किंचित्कथंचन।\nअभयं सर्वभूतेभ्यः स प्राप्नोति सदा मुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2082710, "chapter_id": 2763, "verse_number": "१२-२६८-२६", "content_sanskrit": "यस्मादुद्विजते विद्वन्सर्वलोको वृकादिव।\nक्रोशतस्तीरमासाद्य यथा सर्वे जलेचराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2082711, "chapter_id": 2763, "verse_number": "१२-२६८-२७", "content_sanskrit": "एवमेवायमाचारः प्रादुर्भूतो यतस्ततः।\nसहायवान्द्रव्यवान्यः सुभगोऽथ परस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2082712, "chapter_id": 2763, "verse_number": "१२-२६८-२८", "content_sanskrit": "ततस्तानेव कवयः शास्त्रेषु प्रवदन्त्युत।\nकीर्त्यर्थमल्पहृल्लेखाः पटवः कृत्स्ननिर्णयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2082713, "chapter_id": 2763, "verse_number": "१२-२६८-२९", "content_sanskrit": "तपोभिर्यज्ञदानैश्च वाक्यैः प्रज्ञाश्रितैस्तथा।\nप्राप्नोत्यभयदानस्य यद्यत्फलमिहाश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2082714, "chapter_id": 2763, "verse_number": "१२-२६८-३०", "content_sanskrit": "लोके यः सर्वभूतेभ्यो ददात्यभयदक्षिणाम्।\nस सत्ययज्ञैरीजानः प्राप्नोत्यभयदक्षिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2082715, "chapter_id": 2763, "verse_number": "१२-२६८-३१", "content_sanskrit": "न भूतानामहिंसाया ज्यायान्धर्मोऽस्ति कश्चन।\nयस्मान्नोद्विजते भूतं जातु किंचित्कथंचन।\nसोऽभयं सर्वभूतेभ्यः संप्राप्नोति महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2082716, "chapter_id": 2763, "verse_number": "१२-२६८-३२", "content_sanskrit": "यस्मादुद्विजते लोकः सर्पाद्वेश्मगतादिव।\nन स धर्ममवाप्नोति इह लोके परत्र च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2082717, "chapter_id": 2763, "verse_number": "१२-२६८-३३", "content_sanskrit": "सर्वभूतात्मभूतस्य सर्वभूतानि पश्यतः।\nदेवाऽपि मार्गे मुह्यन्ति ह्यपदस्य पदैपिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2082718, "chapter_id": 2763, "verse_number": "१२-२६८-३४", "content_sanskrit": "दानं भूताभयस्याहुः सर्वदानेभ्य उत्तमम्।\nब्रवीमि ते सत्यमिदं श्रद्धत्स्व मम जाजले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2082719, "chapter_id": 2763, "verse_number": "१२-२६८-३५", "content_sanskrit": "स एव सुभगो भूत्वा पुनर्भवति दुर्भगः।\nव्यापत्तिं कर्मणां दृष्ट्वा जुगुप्सन्ति जनाः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2082720, "chapter_id": 2763, "verse_number": "१२-२६८-३६", "content_sanskrit": "अकारणो हि नैवास्ति धर्मः सूक्ष्मो हि जाजले।\nभूतभव्यार्थमेवेह धर्मप्रवचनं कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2082721, "chapter_id": 2763, "verse_number": "१२-२६८-३७", "content_sanskrit": "सूक्ष्मत्वान्न स विज्ञातुं शक्यते बहुनिह्नवः।\nउपलभ्यान्तरा चान्यानाचारानवबुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2082722, "chapter_id": 2763, "verse_number": "१२-२६८-३८", "content_sanskrit": "ये च च्छिन्दन्ति वृषणान्ये च भिन्दन्ति नस्तकान्।\nवहन्ति महतो भारान्बध्नन्ति दमयन्ति च।\nहत्वा सत्वानि खादन्ति तान्कथं न विगर्हसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2082723, "chapter_id": 2763, "verse_number": "१२-२६८-३९", "content_sanskrit": "मानुषा मानुपानेव दासभोगेन भुञ्जते।\nवधबन्धनिरोधेन कारयन्ति दिवानिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2082724, "chapter_id": 2763, "verse_number": "१२-२६८-४०", "content_sanskrit": "आत्मनश्चापि जानाति यद्दुःखं वधबन्धने।\nपञ्चेन्द्रियेषु भूतेषु सर्वं वसति दैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2082725, "chapter_id": 2763, "verse_number": "१२-२६८-४१", "content_sanskrit": "आदित्यश्चन्द्रमा वायुर्ब्रह्मा प्राणः क्रतुर्यमः।\nतानि जीवानि विक्रीय का मृतेषु विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2082726, "chapter_id": 2763, "verse_number": "१२-२६८-४२", "content_sanskrit": "अजोऽग्निर्वरुणो मेपः सूर्योऽश्वः पृथिवी विराट्।\nधेनुर्वत्सश्च सोमो वै विक्रीयैतन्न सिध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2082727, "chapter_id": 2763, "verse_number": "१२-२६८-४३", "content_sanskrit": "का तैले का धृते ब्रह्मन्मधुन्यप्स्वोषधीषु वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2082728, "chapter_id": 2763, "verse_number": "१२-२६८-४४", "content_sanskrit": "अदंशमशके देशे सुखसंवर्धितान्पशून्।\nतांश्च मातुः प्रियाञ्जानन्नाक्रम्य बहुधा नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2082729, "chapter_id": 2763, "verse_number": "१२-२६८-४५", "content_sanskrit": "बहुदंशाकुलान्देशान्नयन्ति बहुकर्दमान्।\nवाहसंपीडिता धुर्याः सीदन्त्यविधिना परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2082730, "chapter_id": 2763, "verse_number": "१२-२६८-४६", "content_sanskrit": "न मन्ये भ्रूणहत्याऽपि विशिष्टा तेन कर्मणा।\nकृपिं साध्विति मन्यन्ते सा च वृत्तिः सुदारुणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2082731, "chapter_id": 2763, "verse_number": "१२-२६८-४७", "content_sanskrit": "भूमिं भूमिशयांश्चैव हन्ति काष्ठैरयोमुखैः।\nतथैवानडुहो युक्तान्क्षुत्तृष्णाश्रमकर्शितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2082732, "chapter_id": 2763, "verse_number": "१२-२६८-४८", "content_sanskrit": "अध्न्या इति गवां नाम क एता हन्तुमर्हति।\nमहच्चकाराकुशलं वृथा यो गां निहन्ति ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2082733, "chapter_id": 2763, "verse_number": "१२-२६८-४९", "content_sanskrit": "ऋपयो यतयो ह्येतन्नहुपे प्रत्यवेदयन्।\nगां मातरं चाप्यवधीर्वृपभं च प्रजापतिम्।\nअकार्यं नहुपाकापींर्लप्स्यामस्त्वत्कृते व्यथाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2082734, "chapter_id": 2763, "verse_number": "१२-२६८-५०", "content_sanskrit": "शतं चैकं च रोगाणां सर्वभूतेष्वपातयन्।\nऋपयस्ते महाभागाः प्रशस्तास्ते च जाजले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2082735, "chapter_id": 2763, "verse_number": "१२-२६८-५१", "content_sanskrit": "भ्रृणहं नहुषं त्वाहुर्न तं भोक्ष्यामहे वयम्।\nइत्युक्त्वा ते महात्मानः सर्वे तत्त्वार्थदर्शिनः।\nऋषयो यतयः शान्तास्तपसा प्रत्येषधयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2082736, "chapter_id": 2763, "verse_number": "१२-२६८-५२", "content_sanskrit": "ईदृशानशिवान्घोरानाचारानिह जाजले।\nकेवलाचरितत्वात्तु निपुणो नावबुध्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2082737, "chapter_id": 2763, "verse_number": "१२-२६८-५३", "content_sanskrit": "कारणाद्धर्ममन्विच्छन्न लोकं विरसं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2082738, "chapter_id": 2763, "verse_number": "१२-२६८-५४", "content_sanskrit": "यो हन्याद्यश्च मां स्तौति तत्रापि शृणु जाजले।\nसमौ तावपि मे स्थातां न हि मे स्तः प्रियाप्रिये।\nएतदीदृशकं धर्मं प्रशंसन्ति मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2082739, "chapter_id": 2763, "verse_number": "१२-२६८-५५", "content_sanskrit": "उपपत्त्या हि संपन्नो यतिभिश्चैव सेव्यते।\nसततं धर्मशीलैश्च निपुणेनोपलक्षितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2082740, "chapter_id": 2763, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि अष्टषष्ट्यधिकद्विशततमोऽध्यायः॥ २६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]