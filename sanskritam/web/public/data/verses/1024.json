[{"id": 2001471, "chapter_id": 1024, "verse_number": "१-२५-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001472, "chapter_id": 1024, "verse_number": "१-२५-१", "content_sanskrit": "ततः कामगमः पक्षी महावीर्यो महाबलः।\nमातुरन्तिकमागच्छत्परं पारं महोदधेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001473, "chapter_id": 1024, "verse_number": "१-२५-२", "content_sanskrit": "यत्र सा विनता तस्मिन्पणितेन पराजिता।\nअतीव दुःखसंतप्ता दासीभावमुपागता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001474, "chapter_id": 1024, "verse_number": "१-२५-३", "content_sanskrit": "ततः कदाचिद्विनतां प्रणतां पुत्रसन्निधौ।\nकाले चाहूय वचनं कद्रूरिदमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001475, "chapter_id": 1024, "verse_number": "१-२५-४", "content_sanskrit": "नागानामालयं भद्रे सुरम्यं चारुदर्शनम्।\nसमुद्रकुक्षावेकान्ते तत्र मां विनते नय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001476, "chapter_id": 1024, "verse_number": "१-२५-५x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001477, "chapter_id": 1024, "verse_number": "१-२५-५", "content_sanskrit": "ततः सुपर्णमाता तामवहत्सर्पमातरम्।\nपन्नगान्गरुडश्चापि मातुर्वचनचोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001478, "chapter_id": 1024, "verse_number": "१-२५-६", "content_sanskrit": "स सूर्यमभितो याति वैनतेयो विहंगमः।\nसूर्यरश्मिप्रतप्ताश्च मूर्च्छिताः पन्नगाऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001479, "chapter_id": 1024, "verse_number": "१-२५-७", "content_sanskrit": "तदवस्थान्सुतान्दृष्ट्वा कद्रूः शक्रमथास्तुवत्।\nनमस्ते सर्वदेवेश नमस्ते बलसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001480, "chapter_id": 1024, "verse_number": "१-२५-८", "content_sanskrit": "नमुचिघ्न नमस्तेऽस्तु सहस्राक्ष शचीपते।\nसर्पाणां सूर्यतप्तानां वारिणा त्वं प्लवो भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001481, "chapter_id": 1024, "verse_number": "१-२५-९", "content_sanskrit": "त्वमेव परमं त्राणमस्माकममरोत्तम।\nईशो असि पवः स्रष्टुं त्वमनल्पं पुरंदर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001482, "chapter_id": 1024, "verse_number": "१-२५-१०", "content_sanskrit": "त्वमेव मेघस्त्वं वायुस्त्वमग्निर्विद्युतोऽम्बरे।\nत्वमभ्रगणविक्षेप्ता त्वामेवाहुर्महाघनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001483, "chapter_id": 1024, "verse_number": "१-२५-११", "content_sanskrit": "त्वं वज्रमतुलं घोरं घोषवांस्त्वं बलाहकः।\nस्रष्टा त्वमेव लोकानां संहर्ता चापराजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001484, "chapter_id": 1024, "verse_number": "१-२५-१२", "content_sanskrit": "त्वं ज्योतिः सर्वभूतानां त्वमादित्यो विभावसुः।\nत्वं महद्भूतमाश्चर्यं त्वं राजा त्वं सुरोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001485, "chapter_id": 1024, "verse_number": "१-२५-१३", "content_sanskrit": "त्वं विष्णुस्त्वं सहस्राक्षस्त्वं देवस्त्वं परायणम्।\nत्वं सर्वममृतं देव त्वं सोमः परमार्चितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001486, "chapter_id": 1024, "verse_number": "१-२५-१४", "content_sanskrit": "त्वं मुहूर्तस्तिथिस्त्वं च त्वं लवस्त्वं पुनः क्षणः।\nशुक्लस्त्वं बहुलस्त्वं च कला काष्ठा त्रुटिस्तथा।\nसंवत्सरर्तवो मासा रजन्यश्च दिनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001487, "chapter_id": 1024, "verse_number": "१-२५-१५", "content_sanskrit": "त्वमुत्तमा सगिरिवना वसुंधरा\nसभास्करं वितिमिरमम्बरं तथा।\nमदोदधिः सतिमितिमिङ्गिलस्तथा\nमहोर्मिमान्बहुमकरो झषाकुलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001488, "chapter_id": 1024, "verse_number": "१-२५-१६", "content_sanskrit": "महायशास्त्वमिति सदाऽभिपूज्यसे\nमनीषिभिर्मुदितमना महर्षिभिः।\nअभिष्टुतः पिबसि च सोममध्वरे\nकषट्कृतान्यपि च हवींषि भूतये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001489, "chapter_id": 1024, "verse_number": "१-२५-१७", "content_sanskrit": "त्वं विप्रैः सततमिहेज्यसे फलार्थं\nवेदाङ्गेष्वतुलबलौघ गीयसे च।\nत्वद्धेतोर्यजनपरायणा द्विजेन्द्रा\nवेदाङ्गान्यभिगमयन्ति सर्वयत्नैः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001490, "chapter_id": 1024, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि पञ्चविंशोऽध्यायः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]