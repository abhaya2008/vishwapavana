[{"id": 2012628, "chapter_id": 1260, "verse_number": "२-१-०x", "content_sanskrit": "॥ श्रीवेदव्यासाय नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2012629, "chapter_id": 1260, "verse_number": "२-१-१", "content_sanskrit": "नारायणं नमस्कृत्य नरं चैव नरोत्तमम्।\nदेवीं सरस्वतीं चैव (व्यासं)ततो जयमुदीरयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2012630, "chapter_id": 1260, "verse_number": "२-१-२x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2012631, "chapter_id": 1260, "verse_number": "२-१-२", "content_sanskrit": "अर्जुनो जयतां श्रेष्ठो मोचयित्वा मयं तदा।\nकिं चकार महातेजास्तन्मे ब्रूहि द्विजोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2012632, "chapter_id": 1260, "verse_number": "२-१-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2012633, "chapter_id": 1260, "verse_number": "२-१-३", "content_sanskrit": "शृणु राजन्नवहितश्चरितं पूर्वकस्य ते।\nमोक्षयित्वा मयं तत्र पार्थः शस्त्रभृतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2012634, "chapter_id": 1260, "verse_number": "२-१-४", "content_sanskrit": "गाण्डिवं कार्मुकश्रेष्ठं तूणी चाक्षयसायकौ।\nदिव्यान्यस्त्राणि राजेन्द्र दुर्लभानि नृपैर्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2012635, "chapter_id": 1260, "verse_number": "२-१-५", "content_sanskrit": "रथध्वजपताकाश्च श्वेताश्वांश्च स वीर्यवान्।\nएतानि पावकात्प्राप्य मुदा परमया युतः।\nतस्थौ पार्थो महावीर्यस्तदा सह मयेन सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2012636, "chapter_id": 1260, "verse_number": "२-१-६", "content_sanskrit": "ततोऽब्रवीन्मयः पार्थं वासुदेवस्य सन्निधौ।\nपाण्डवेन परित्रातस्तत्कृतं प्रत्यनुस्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2012637, "chapter_id": 1260, "verse_number": "२-१-७", "content_sanskrit": "प्राञ्जलिः श्लक्ष्णया वाचा पूजयित्वा पुनः पुनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2012638, "chapter_id": 1260, "verse_number": "२-१-७x", "content_sanskrit": "मय उवाच।\nअस्माच्च कृष्णात्सङ्क्रुद्धात्पावकाच्च दिधक्षतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2012639, "chapter_id": 1260, "verse_number": "२-१-८", "content_sanskrit": "त्वया त्रातोऽस्मि कौन्तेय ब्रूहि किं करवाणि ते।\nअहं हि विश्वकर्मा वै असुराणां परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2012640, "chapter_id": 1260, "verse_number": "२-१-९", "content_sanskrit": "तस्मात्ते विस्मयं किञ्चित्कुर्यामन्यैः सुदुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2012641, "chapter_id": 1260, "verse_number": "२-१-१०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2012642, "chapter_id": 1260, "verse_number": "२-१-१०", "content_sanskrit": "एवमुक्तो महावीर्यः पार्थो मायाविदं मयम्।\nध्यात्वा मुहूर्तं कौन्तेयः प्रहसन्वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2012643, "chapter_id": 1260, "verse_number": "२-१-११", "content_sanskrit": "कृतमेव त्वया सर्वं स्वस्ति गच्छ महाऽसुर।\nप्रीतिमान्भव मे नित्यं प्रीतिमन्तो वयं च ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2012644, "chapter_id": 1260, "verse_number": "२-१-१२", "content_sanskrit": "प्रोपकारादर्थं हि नादास्यामीति मे व्रतम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2012645, "chapter_id": 1260, "verse_number": "२-१-१२x", "content_sanskrit": "उवाच।\nयुक्तमेतत्त्वयि विभो यदात्थ पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2012646, "chapter_id": 1260, "verse_number": "२-१-१३", "content_sanskrit": "प्रीतिपूर्वमहं किञ्चित्कर्तुमिच्छामि तेऽर्जुन।\nअहं हि विश्वकर्मा वै दानवानां महाकविः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2012647, "chapter_id": 1260, "verse_number": "२-१-१४", "content_sanskrit": "सोऽहं वै त्वत्कृते किञ्चित्कर्तुमिच्छामि पाण्डव।\nदानवानां पुरा पार्थ प्रासादा हि मया कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2012648, "chapter_id": 1260, "verse_number": "२-१-१५", "content_sanskrit": "रम्याणि सुखगर्भाणि भोगाढ्यानि सहस्रशः।\nउद्यानानि च रम्याणि सरांसि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2012649, "chapter_id": 1260, "verse_number": "२-१-१६", "content_sanskrit": "विचित्राणि च वस्त्राणि कामगानि रथानि च।\nनगराणि विशालानि साट्टप्राकारवन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2012650, "chapter_id": 1260, "verse_number": "२-१-१७", "content_sanskrit": "वाहनानि च मुख्यानि विचित्राणि सहस्रशः।\nबिलानि रमणीयानि सुखयुक्तानि वै भृशम्।\nएते कृता मया तस्मादिच्छामि फल्गुन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2012651, "chapter_id": 1260, "verse_number": "२-१-१८x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2012652, "chapter_id": 1260, "verse_number": "२-१-१८", "content_sanskrit": "प्राणकृच्छ्राद्विनिर्मुक्तमात्मानं मन्यसे मया।\nएवं गते न शक्ष्यामि किञ्चित्कारयितुं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2012653, "chapter_id": 1260, "verse_number": "२-१-१९", "content_sanskrit": "न चापि तव सङ्कल्पं मोघमिच्छामि दानव।\nकृष्णस्य क्रियतां किञ्चित्तथा प्रतिकृतं मयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2012654, "chapter_id": 1260, "verse_number": "२-१-२०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2012655, "chapter_id": 1260, "verse_number": "२-१-२०", "content_sanskrit": "चोदितो वासुदेवस्तु मयं प्रति नरर्षभ।\nमुहूर्तमिव सन्दध्यौ किमयं चोद्यतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2012656, "chapter_id": 1260, "verse_number": "२-१-२१", "content_sanskrit": "ततो विचिन्त्य मनसा लोकनाथः प्रजापितः।\nचोदयामास तं कृष्णः सभा वै क्रियतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2012657, "chapter_id": 1260, "verse_number": "२-१-२२", "content_sanskrit": "यदि त्वं कर्तुकामोऽसि प्रियं शिल्पवतां वर।\nधर्मराजस्य दयितां यादृशीमिह मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2012658, "chapter_id": 1260, "verse_number": "२-१-२३", "content_sanskrit": "यां क्रियां नानुकुर्युस्ते मानवाः प्रेक्ष्य विष्ठिताः।\nमनुष्यलोके सकले तादृशीं कुरु वै सभाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2012659, "chapter_id": 1260, "verse_number": "२-१-२४", "content_sanskrit": "यत्र द्विव्यानभिप्रायान्पश्येम विहितांस्त्वया।\nआसुरान्मानुपांश्चैव तादृशीं कुरु वै सभाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2012660, "chapter_id": 1260, "verse_number": "२-१-२५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2012661, "chapter_id": 1260, "verse_number": "२-१-२५", "content_sanskrit": "प्रतिगृह्य तु तद्वाक्यं सम्प्रहृष्टो मयस्तदा।\nविमानप्रतिमां चक्रे पाण्डवस्य शुभां सभाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2012662, "chapter_id": 1260, "verse_number": "२-१-२६", "content_sanskrit": "ततः कृष्णश्च पार्थश्च धर्मराजे युधिष्ठिरे।\nसर्वमेतत्समावेद्य दर्शयामासतुर्मयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2012663, "chapter_id": 1260, "verse_number": "२-१-२७", "content_sanskrit": "तस्मै युधिष्ठिरः पूजां यथार्हमकरोत्तदा।\nस तु तां प्रतिजग्राह मयः सत्कृत्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2012664, "chapter_id": 1260, "verse_number": "२-१-२८", "content_sanskrit": "स पूर्वदेवचरितं तदा तत्र विशाम्पते।\nकथयामास दैतेयः पाण्डुपुत्रेषु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2012665, "chapter_id": 1260, "verse_number": "२-१-२९", "content_sanskrit": "स कालं कञ्चिदाश्वस्य विश्वकर्मा विचिन्त्य तु।\nसभां प्रचकमे कर्तुं पाण्डवानां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2012666, "chapter_id": 1260, "verse_number": "२-१-३०", "content_sanskrit": "अभिप्रायेण पार्थानां कृष्णस्य च महात्मनः।\nपुण्येऽहनि महातेजाः कृतकौतुकमङ्गलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2012667, "chapter_id": 1260, "verse_number": "२-१-३१", "content_sanskrit": "तर्पयित्वा द्विजश्रेष्ठान्पायसेन सहस्रशः।\nधनं बहुविधं दत्त्वा तेभ्य एव च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2012668, "chapter_id": 1260, "verse_number": "२-१-३१", "content_sanskrit": "सर्वर्तुगुणसम्पन्नां दिव्यरूपां मनोरमाम्।\nदशकिष्कुसहस्रां तां मापयामास सर्वतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2012669, "chapter_id": 1260, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि मन्त्रपर्वणि प्रथमोऽध्यायः॥ १॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]