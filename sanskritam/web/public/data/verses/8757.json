[{"id": 900009702, "chapter_id": 8757, "verse_number": "1.1", "content_sanskrit": "लक्ष्मीपतिं सम्प्रणम्य सर्वज्ञादिगुरूनपि पदार्थानां सङ्ग्रहोऽयं क्रियते शास्त्रतोऽञ्जसा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009703, "chapter_id": 8757, "verse_number": "1.2", "content_sanskrit": "द्रवणप्राप्यत्वं द्रव्यसामान्यलक्षणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009704, "chapter_id": 8757, "verse_number": "1.3", "content_sanskrit": "दोषभिन्नत्वं गुणत्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009705, "chapter_id": 8757, "verse_number": "1.4", "content_sanskrit": "ज्ञानकरणं त्रिविधम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009706, "chapter_id": 8757, "verse_number": "1.5", "content_sanskrit": "एवं पदार्थे निरूपिते तत्सृष्ट्यादिकर्तृत्वेन भगवज्ज्ञानं मोक्ष-साधनमिति सृष्ट्यादिकं निरूप्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900009707, "chapter_id": 8757, "verse_number": "1.6", "content_sanskrit": "ज्ञानमपि परमात्माधीनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]