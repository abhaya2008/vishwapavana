[{"id": 7003910000, "chapter_id": 23910, "verse_number": "२-९-५-१", "content_sanskrit": "स्कन्द उवाच ।\nआसीद्राजोपरिचरो वसुनामा पुरा मुने ।\nभूभर्त्तुरायोस्तनयः ख्यातश्चासावमावसुः ।\nआखण्डलसखो भक्तिं प्राप्तो नारायणे प्रभौ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003910001, "chapter_id": 23910, "verse_number": "२-९-५-२", "content_sanskrit": "धार्मिकः पितृभक्तश्च पितॄन्देवांश्च तर्पयन् ।\nसदाचाररतो दक्षः क्षमावाननसूयकः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003910002, "chapter_id": 23910, "verse_number": "२-९-५-३", "content_sanskrit": "सर्वोपकारकः शान्तो ब्रह्मचर्यरतः शुचिः ।\nअक्रोधनश्च मितभुङ्मृदुर्निर्व्यसनो मुनिः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003910003, "chapter_id": 23910, "verse_number": "२-९-५-४", "content_sanskrit": "निर्द्वन्द्वो निर्विकारश्च निर्मानो धीर आत्मवित् ।\nनिर्द्दम्भो मानदो योगी तपस्वी विजितेन्द्रियः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003910004, "chapter_id": 23910, "verse_number": "२-९-५-५", "content_sanskrit": "धनपुत्रकलत्रेषु विरक्तः स्वजनादिषु ।\nनारायणमनुं भक्त्या स जजापान्वहं नृपः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003910005, "chapter_id": 23910, "verse_number": "२-९-५-६", "content_sanskrit": "तस्मै तुष्टोऽथ भगवान्वासुदेवः स्वयं ददौ ।\nसाम्राज्यं सोऽथ नासक्तस्तत्र भेजे तमादरात् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003910006, "chapter_id": 23910, "verse_number": "२-९-५-७", "content_sanskrit": "तत्रोक्तेन विधानेन पञ्चकालसमाहितः ।\nपूजयामास देवेशं तच्छेषेण सुरान्पितॄन् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003910007, "chapter_id": 23910, "verse_number": "२-९-५-८", "content_sanskrit": "तेषां शेषेण विप्राश्च संविभज्याश्रितांश्च सः ।\nशेषान्नभुक्सत्यपरः सर्वभूतेष्वहिंसकः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003910008, "chapter_id": 23910, "verse_number": "२-९-५-९", "content_sanskrit": "भक्षणे दोषमविदत्प्राणिमात्रामिषस्य तु ।\nमहापातकवद्राजा स्वप्रजाश्च तथाऽवदत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003910009, "chapter_id": 23910, "verse_number": "२-९-५-१०", "content_sanskrit": "सर्वभावेन भेजेऽसौ देवदेवं जनार्दनम् ।\nअनादिमध्यनिधनं लोककर्त्तारमव्ययम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003910010, "chapter_id": 23910, "verse_number": "२-९-५-११", "content_sanskrit": "श्रीवासुदेवपदयोः स चकार मनः स्थिरम् ।\nश्रोत्रे च नित्यं भगवत्कथायाः श्रवणे नृपः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003910011, "chapter_id": 23910, "verse_number": "२-९-५-१२", "content_sanskrit": "नयने स्वे मुकुन्दस्य तद्भक्तानां च दर्शने ।\nगुणगाने हरेर्वाणीं चक्रे भूमिपतिः स तु ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003910012, "chapter_id": 23910, "verse_number": "२-९-५-१३", "content_sanskrit": "नारायणांघ्रिसंस्पृष्ट तुलसीपुष्पसौरभे ।\nप्राणं चकार च नृपो नान्यगन्धेषु कर्हिचित् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003910013, "chapter_id": 23910, "verse_number": "२-९-५-१४", "content_sanskrit": "श्रीशोपभुक्तवस्त्रादि स्पर्शने च त्वचं निजाम् ।\nचकार रसनामन्ने नारायणनिवेदिते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003910014, "chapter_id": 23910, "verse_number": "२-९-५-१५", "content_sanskrit": "भगवन्मन्दिरक्षेत्रसदन्तिकगतौतथा ।\nचकार चरणौ राजा सेवायां च करौ हरेः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003910015, "chapter_id": 23910, "verse_number": "२-९-५-१६", "content_sanskrit": "उत्तमांगं च चक्रेऽसौ विष्णुपादाभिवन्दने ।\nसख्यं चकार परमं महाभागवतेषु सः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003910016, "chapter_id": 23910, "verse_number": "२-९-५-१७", "content_sanskrit": "एकोपि न क्षणस्तस्य विना भक्तिं रमापतेः ।\nजगाम किल राजर्षेस्तदीय व्रतचारिणः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003910017, "chapter_id": 23910, "verse_number": "२-९-५-१८", "content_sanskrit": "महद्भिरेव संभारैर्विष्णोर्ज्जन्मदिनोत्सवान् ।\nचक्रे तदर्थमुद्यानमंदिरोपवनानि च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003910018, "chapter_id": 23910, "verse_number": "२-९-५-१९", "content_sanskrit": "इत्थं नारायणे भक्तिं वहतो ब्राह्मणोत्तम ।\nएकशय्यासनं तस्य दत्तवान्देवराट् स्वयम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003910019, "chapter_id": 23910, "verse_number": "२-९-५-२०", "content_sanskrit": "वैजयन्तीं ददौ मालां तस्मा इन्द्रोऽतिशोभनाम् ।\nअम्लानपङ्कजमयीं तथा रत्नानि भूरिशः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003910020, "chapter_id": 23910, "verse_number": "२-९-५-२१", "content_sanskrit": "आत्मा राज्यं धनं चैव कलत्रं वाहनादि च ।\nयत्तद्भगवतः सर्वमिति तत्प्रेक्षितं सदा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003910021, "chapter_id": 23910, "verse_number": "२-९-५-२२", "content_sanskrit": "काम्या नैमित्तिकाजस्रं यज्ञियाः परमाः क्रियाः ।\nसर्वाः सात्वतमास्थाय विधिं चक्रे समाहितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003910022, "chapter_id": 23910, "verse_number": "२-९-५-२३", "content_sanskrit": "पञ्चरात्रविदो मुख्यास्तस्य गेहे महात्मनः ।\nप्रायणं भगवत्प्रत्तं भुञ्जतेस्माग्रतो द्विजाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003910023, "chapter_id": 23910, "verse_number": "२-९-५-२४", "content_sanskrit": "तस्य प्रशासतो राज्यं धर्मेणाऽमित्रघातिनः ।\nनानृता वाक्समभवन्मनो दुष्टं न चाऽभवत् ।\nन च कायेन कृतवान्स पापं परमण्वपि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003910024, "chapter_id": 23910, "verse_number": "२-९-५-२५", "content_sanskrit": "पञ्चरात्रं महातन्त्रं भगवद्भक्तिपुष्टये ।\nशुश्रावानुदिनं राजा भगवद्भक्तवक्त्रतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003910025, "chapter_id": 23910, "verse_number": "२-९-५-२६", "content_sanskrit": "धर्मं संस्थापयञ्छुद्धं रञ्जयन्सकलाः प्रजाः ।\nपालयामास पृथिवीं दिवमाखण्डलो यथा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003910026, "chapter_id": 23910, "verse_number": "२-९-५-२७", "content_sanskrit": "अपि सप्तविधस्तस्य राज्ये पललभक्षकः ।\nपुमान्कोप्यभवन्नैव न च पाषण्डवेषिणः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003910027, "chapter_id": 23910, "verse_number": "२-९-५-२८", "content_sanskrit": "असाध्यो योषितश्चैव पुरुषाः पारदारिकाः ।\nन श्रुतास्तस्य राज्ये च धर्मसंकरकारिणः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003910028, "chapter_id": 23910, "verse_number": "२-९-५-२९", "content_sanskrit": "एकादशविधं मद्यं त्रिविधां च सुरामपि ।\nनाजिघ्रदपि कोपीह तस्मिन्राज्यं प्रशासति ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003910029, "chapter_id": 23910, "verse_number": "२-९-५-३०", "content_sanskrit": "एवंगुणः स तु क्वापि पक्षपाताद्दिवौकसाम् ।\nमिथ्यालापाद्दिवो भ्रष्टः प्रविवेश महीतलम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003910030, "chapter_id": 23910, "verse_number": "२-९-५-३१", "content_sanskrit": "अन्तर्भूमिगतश्चासौ सततं धर्मवत्सलः ।\nनारायणपरो भूत्वा तन्मंत्रमजपत्स्थिरः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003910031, "chapter_id": 23910, "verse_number": "२-९-५-३२", "content_sanskrit": "तस्यैव च प्रसादेन पुनरेवोत्थितस्तु सः ।\nदिवं प्राप्य सुखं तत्र मनोभीष्टं समन्वभूत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003910032, "chapter_id": 23910, "verse_number": "२-९-५-३३", "content_sanskrit": "पुनश्चेदिपतिर्भूत्वा भुव्यसौ पितृशापतः ।\nपञ्चरात्रोक्तविधिना भेजे हरिमतन्द्रितः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003910033, "chapter_id": 23910, "verse_number": "२-९-५-३४", "content_sanskrit": "स्वर्गलोकं ततः प्रापद्दिव्यदेहेन भूपतिः ।\nउपासनां च तत्रत्यैः परमर्षिगणैः सह ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003910034, "chapter_id": 23910, "verse_number": "२-९-५-३५", "content_sanskrit": "दृढीकुर्वन्भगवतः कञ्चित्कालमुवास तत् ।\nपरं पदमथ प्रापद्वासुदेवस्य निर्भयम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003910035, "chapter_id": 23910, "verse_number": "२-९-५-३६", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे श्रीवासुदेवमाहात्म्य उपरिचरवसुसद्गुणवर्णनं नाम पंचमोऽध्यायः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]