[{"id": 2114874, "chapter_id": 3471, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2114875, "chapter_id": 3471, "verse_number": "१", "content_sanskrit": "अथ रात्र्यां व्यतीतायां सशोको नागरो जनः ।\nतत्राजगाम त्वरितो दिदृक्षुः पाण्डुनन्दनान् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2114876, "chapter_id": 3471, "verse_number": "२", "content_sanskrit": "निर्वापयन्तो ज्वलनं ते जना ददृशुस्तदा ।\nजातुषं तद्गृहं दग्धममात्यं च पुरोचनम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2114877, "chapter_id": 3471, "verse_number": "३", "content_sanskrit": "नूनं दुर्योधनेनेदं विहितं पापकर्मणा ।\nपाण्डवानां विनाशाय इत्येवं चुक्रुशुर्जनाः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2114878, "chapter_id": 3471, "verse_number": "४", "content_sanskrit": "विदितं धृतराष्ट्रस्य धार्तराष्ट्रो न संशयः ।\nदग्धवान् पाण्डवान् बालान् न ह्येतत् प्रतिषिद्धवान् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2114879, "chapter_id": 3471, "verse_number": "५", "content_sanskrit": "नूनं शान्तनवो भीष्मो न धर्ममनुवर्तते ।\nद्रोणश्च विदुरश्चैव कृपश्चान्ये च कौरवाः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2114880, "chapter_id": 3471, "verse_number": "६", "content_sanskrit": "ते वयं धृतराष्ट्राय प्रेषयामो दुरात्मने ।\nसंवृत्तस्ते परः कामः पाण्डवान् दग्धवानसि \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2114881, "chapter_id": 3471, "verse_number": "७", "content_sanskrit": "ततो व्यपोहमानास्ते पाण्डवार्थे हुताशनम् ।\nनिषादीं ददृशुर्दग्धां पञ्चपुत्रामनागसीम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2114882, "chapter_id": 3471, "verse_number": "८", "content_sanskrit": "खनकेन तु तेनैव वेश्म शोधयता बिलम् ।\nपांसुभिः प्रत्यपिहितं पुरुषैस्तैरलक्षितम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2114883, "chapter_id": 3471, "verse_number": "९", "content_sanskrit": "ततस्ते प्रेषयामासुर्धृतराष्ट्रस्य नागराः ।\nपाण्डवानग्निना दग्धानमात्यं च पुरोचनम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2114884, "chapter_id": 3471, "verse_number": "१०", "content_sanskrit": "श्रुत्वा तु धृतराष्ट्रस्तं राजा सुमहदप्रियम् ।\nविनाशं पाण्डवेयानां विललाप सुदुःखितः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2114885, "chapter_id": 3471, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2114886, "chapter_id": 3471, "verse_number": "११", "content_sanskrit": "अद्य पाण्डुर्मृतो राजा भ्राता मम सुदुर्लभः ।\nतेषु वीरेषु दग्धेषु मात्रा सह विशेषतः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2114887, "chapter_id": 3471, "verse_number": "१२", "content_sanskrit": "गच्छन्तु पुरुषाः शीघ्रं नगरं वारणावतम् ।\nसंस्कारयन्तु तान् वीरान् कुन्तीं राजसुतां तु ताम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2114888, "chapter_id": 3471, "verse_number": "१३", "content_sanskrit": "ये च तत्र मृतास्तेषां सुहृदोऽर्चन्तु तानपि ।\nकारयन्तु च कुल्यानि शुभ्राणि च महान्ति च \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2114889, "chapter_id": 3471, "verse_number": "१४", "content_sanskrit": "मम दग्धा महात्मानः कुलवंशविवर्धनाः ।\nएवं गते मया शक्यं यद्यत् कारयितुं वरम् ।\nपाण्डवानां च कुन्त्याश्च तत्सर्वं क्रियतामिति \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2114890, "chapter_id": 3471, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2114891, "chapter_id": 3471, "verse_number": "१५", "content_sanskrit": "समेतास्तु ततः सर्वे भीष्मेण सह कौरवाः ।\nधृतराष्ट्रः सपुत्रश्च गङ्गामभिमुखा ययुः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2114892, "chapter_id": 3471, "verse_number": "१६", "content_sanskrit": "एकवस्त्रा निरानन्दा निराभरणवेष्टनाः ।\nउदकं कर्तुकामा वै पाण्डवानां महात्मनाम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2114893, "chapter_id": 3471, "verse_number": "१७", "content_sanskrit": "एवं गत्वा ततश्चक्रे ज्ञातिभिः परिवारितः ।\nउदकं पाण्डुपुत्रेभ्यो धृतराष्ट्रोऽम्बिकासुतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2114894, "chapter_id": 3471, "verse_number": "१८", "content_sanskrit": "चुक्रुशुः कुरवः सर्वे भृशं शोकसमन्विताः ।\nविदुरस्त्वल्पशः शोकं चक्रे वेद हि तत् परम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2114895, "chapter_id": 3471, "verse_number": "१९", "content_sanskrit": "ततः प्रव्यथितो भीष्मः पाण्डुराजसुतान् मृतान् ।\nसह मात्रेति तच्छ्रुत्वा विललाप रुरोद च \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2114896, "chapter_id": 3471, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2114897, "chapter_id": 3471, "verse_number": "२०", "content_sanskrit": "हा युधिष्ठिर हा भीम हा धनञ्जय हा यमौ ।\nहा पृथे सह पुत्रैस्त्वमेकरात्रेण स्वर्गता \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2114898, "chapter_id": 3471, "verse_number": "२१", "content_sanskrit": "मात्रा सह कुमारास्ते सर्वे तत्रैव संस्थिताः ।\nन हि तौ नोत्सहेयातां भीमसेनधनञ्जयौ \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2114899, "chapter_id": 3471, "verse_number": "२२", "content_sanskrit": "तरसाऽवहितात्मानौ निर्भेत्तुमपि मन्दिरम् ।\nपरासुत्वं न पश्यामि पृथायाः सह पाण्डवैः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2114900, "chapter_id": 3471, "verse_number": "२३", "content_sanskrit": "सर्वथा विकृतं तत् तु यदि ते निधनं गताः ।\nधर्मराजः स निर्दिष्टो ननु विप्रैर्युधिष्ठिरः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2114901, "chapter_id": 3471, "verse_number": "२४", "content_sanskrit": "पृथिव्यां च रथिश्रेष्ठो भविता स धनञ्जयः ।\nसत्यव्रतो धर्मदत्तः सत्यवाक् शुभलक्षणः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2114902, "chapter_id": 3471, "verse_number": "", "content_sanskrit": "कथं कालवशं प्राप्तः पाण्डवेयो युधिष्ठिरः ।\nआत्मानमुपमां कृत्वा परेषां वर्तते तु यः \t॥२५ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2114903, "chapter_id": 3471, "verse_number": "२६", "content_sanskrit": "सह मात्रा तु कौरव्यः कथं कालवशं गतः ।\nपालितश्च चिरं कालं फलकाले यथा द्रुमः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2114904, "chapter_id": 3471, "verse_number": "२७", "content_sanskrit": "भग्नः स्याद् वायुवेगेन तथा राजा युधिष्ठिरः ।\nयौवराज्येऽभिषिक्तेन पितुर्येनाहृतं यशः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2114905, "chapter_id": 3471, "verse_number": "२८", "content_sanskrit": "आत्मनश्च पितुश्चैव सत्यधर्मस्य वृत्तिभिः ।\nब्रह्मण्यस्तु परप्रेक्षी हृदि शोकं निधाय मे \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2114906, "chapter_id": 3471, "verse_number": "२९", "content_sanskrit": "कालेन स हि सम्भग्नो धिक् कृतान्तमनर्थदम् ।\nयच्च सा वनवासेन दुःखिता क्लेशभागिनी \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2114907, "chapter_id": 3471, "verse_number": "३०", "content_sanskrit": "पुत्रगृध्नुतया कुन्ती न भर्तारं मृता त्वनु ।\nअल्पकालं कुले जाता भर्तुः प्रीतिमवाप या \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2114908, "chapter_id": 3471, "verse_number": "३१", "content_sanskrit": "दग्धाऽद्य सह पुत्रैः सा असम्पूर्णमनोरथा ।\nएतच्च चिन्तयानस्य व्यथितं बहुधा मनः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2114909, "chapter_id": 3471, "verse_number": "३२", "content_sanskrit": "अवस्फूर्ज्य च मे देहं हृदयाग्निरुदीर्यते ।\nपीनस्कन्धश्चारुबाहुर्मेरुकुञ्जसमो युवा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2114910, "chapter_id": 3471, "verse_number": "३३", "content_sanskrit": "मृतो भीम इति श्रुत्वा मनो न श्रद्दधाति मे ।\nअनिन्द्यानि च यो गच्छन् क्षिप्रहस्तो दृढायुधः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2114911, "chapter_id": 3471, "verse_number": "३४", "content_sanskrit": "प्रपत्तिमाँल्लब्धलक्षो रथयानविशारदः ।\nदूरपाती त्वसम्भ्रान्तो महावीर्यो महास्त्रवित्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2114912, "chapter_id": 3471, "verse_number": "३५", "content_sanskrit": "अदीनात्मा नरव्याघ्रः श्रेष्ठः सर्वधनुष्मताम् ।\nयेन प्राच्याः ससौवीरा दाक्षिणात्याश्च निर्जिताः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2114913, "chapter_id": 3471, "verse_number": "३६", "content_sanskrit": "ख्यापितं येन शूरेण त्रिषु लोकेषु पौरुषम् ।\nयस्मिञ्जाते विशोकाऽभूत् कुन्ती पाण्डुश्च वीर्यवान् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2114914, "chapter_id": 3471, "verse_number": "३७", "content_sanskrit": "पुरन्दरसमो जिष्णुः कथं कालवशं गतः ।\nकथं तावृषभस्कन्धौ सिंहविक्रान्तगामिनौ\nमृत्युधर्ममनुप्राप्तौ यमावरिनिबर्हणौ \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2114915, "chapter_id": 3471, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2114916, "chapter_id": 3471, "verse_number": "३८", "content_sanskrit": "तस्य विक्रन्दितं श्रुत्वा उदकं च प्रसिञ्चतः ।\nदेशकालविदासाद्य विदुरः प्रत्यभाषत \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2114917, "chapter_id": 3471, "verse_number": "३९", "content_sanskrit": "मा शोचीस्त्वं नरव्याघ्र जहि शोकं महाव्रत ।\nन तेषां विद्यते पापं प्राप्तकालं कृतं मया \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2114918, "chapter_id": 3471, "verse_number": "४०", "content_sanskrit": "यच्च तेभ्यस्त्वमुदकं विप्रषिञ्चसि भारत ।\nसोऽब्रवीत् किञ्चिदुत्सार्य कौरवणामशृण्वताम् ।\nक्षत्तारमुपसङ्गृह्य बाष्पोत्पीडकलस्वरः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2114919, "chapter_id": 3471, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2114920, "chapter_id": 3471, "verse_number": "४१", "content_sanskrit": "कथं ते तात जीवन्ति पाण्डोः पुत्रा महारथाः ।\nकथमस्मत्कृते पक्षः पाण्डोर्न विनिपातितः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2114921, "chapter_id": 3471, "verse_number": "४२", "content_sanskrit": "कथं त्वत्प्रमुखाः सर्वे प्रमुक्ता महतो भयात् ।\nजननी गरुडेनेव कुमारास्ते समुद्धृताः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2114922, "chapter_id": 3471, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2114923, "chapter_id": 3471, "verse_number": "४३", "content_sanskrit": "एवमुक्तस्तु कौरव्य कौरवाणामशृण्वताम् ।\nआचचक्षे स धर्मात्मा भीष्मायाद्भुतकर्मणे \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2114924, "chapter_id": 3471, "verse_number": "४४", "content_sanskrit": "धृतराष्ट्रस्य शकुने राज्ञो दुर्योधनस्य च ।\nविनाशे पाण्डुपुत्राणां कृतो मतिविनिश्चयः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2114925, "chapter_id": 3471, "verse_number": "४५", "content_sanskrit": "तच्चाहमपि च ज्ञात्वा तस्य पापस्य निश्चयम् ।\nतज्जिघांसुरहं चापि तेषामनुमते स्थितः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2114926, "chapter_id": 3471, "verse_number": "४६", "content_sanskrit": "ततो जतुगृहं गत्वा दहनेऽस्मिन् नियोजिते ।\nपृथायाश्च सपुत्राया धार्तराष्ट्रस्य शासनात् \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2114927, "chapter_id": 3471, "verse_number": "४७", "content_sanskrit": "ततः खनकमाहूय सुरङ्गं वै बिलं तदा ।\nसगुहां कारयित्वा ते कुन्त्या पाण्डुसुतास्तदा \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2114928, "chapter_id": 3471, "verse_number": "४८", "content_sanskrit": "निष्क्रामिता मया पूर्वं मा स्म शोके मनः कृथाः ।\nततस्तु नावमारोप्य सहपुत्रां पृथामहम् \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2114929, "chapter_id": 3471, "verse_number": "", "content_sanskrit": "दत्त्वाऽभयं सपुत्रायै कुन्त्यै गृहमदाहयम् ।\nतस्मात् ते मा स्म भूद् दुःखं मुक्ताः पापात् तु पाण्डवाः \t॥४९", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2114930, "chapter_id": 3471, "verse_number": "५०", "content_sanskrit": "निर्गताः पाण्डवा राजन् मात्रा सह परन्तपाः ।\nअग्निदाहान्महाघोरान्मया तस्मादुपायतः \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2114931, "chapter_id": 3471, "verse_number": "५१", "content_sanskrit": "मा शोकं कार्षी राजंस्त्वं जीवन्त्येव च पाण्डवाः ।\nप्रच्छन्ना विचरिष्यन्ति यावत्कालस्य पर्ययः \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2114932, "chapter_id": 3471, "verse_number": "५२", "content_sanskrit": "तस्मिन् युधिष्ठिरं काले द्रक्ष्यन्ति भुवि भूमिपाः ।\nविमलं कृष्णपक्षान्ते जगच्चन्द्रमिवोदितम् \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2114933, "chapter_id": 3471, "verse_number": "५३", "content_sanskrit": "न तस्य नाशं पश्यामि यस्य भ्राता धनञ्जयः ।\nभीमसेनश्च दुर्धर्षौ माद्रीपुत्रौ च भ्रातरौ \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2114934, "chapter_id": 3471, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2114935, "chapter_id": 3471, "verse_number": "५४", "content_sanskrit": "ततः संहृष्टसर्वाङ्गो भीष्मो विदुरमब्रवीत् ।\nदिष्ट्या दिष्ट्येति संहृष्टः पूजयानो महामतिम् \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2114936, "chapter_id": 3471, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2114937, "chapter_id": 3471, "verse_number": "५५", "content_sanskrit": "युक्तं चैवानुरूपं च कृतं तात शुभं त्वया ।\nवयं विमोक्षिता दुःखात् पाण्डुपक्षो न नाशितः ।\nत्वं गतिस्त्वं पिता माता भ्राता मे त्वं गुरुर्हितः \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2114938, "chapter_id": 3471, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2114939, "chapter_id": 3471, "verse_number": "५६", "content_sanskrit": "एवमुक्त्वा नमस्कृत्वा देववद् हृदयं गतः ।\nप्रविवेश प्रहृष्टः स पुरं जनपदाकुलम् ।\nकुरुभिः सहितो राजन् नागरैश्च पितामहः \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2114940, "chapter_id": 3471, "verse_number": "८", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nपञ्चाशदधिकशततमोऽध्यायः ॥१५०॥ इति जतुगृहदाहपर्वणि अष्टमोऽध्यायः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2114941, "chapter_id": 3471, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]