[{"id": 7005960000, "chapter_id": 25960, "verse_number": "१-१४३-१", "content_sanskrit": "ब्रह्मोवाच । रामायणमतो वक्ष्ये श्रुतं पापविनाशनम् ।\nविष्णुनाभ्यब्जतो ब्रह्मा मरीचिस्तत्सुतोऽभवत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005960001, "chapter_id": 25960, "verse_number": "१-१४३-२", "content_sanskrit": "मरीचेः कश्यपस्तस्माद्रविस्तस्मान्मनुः स्मृत ।\nमनोरिक्ष्वाकुरस्याभूद्वंशे राजा रघुः स्मृतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005960002, "chapter_id": 25960, "verse_number": "१-१४३-३", "content_sanskrit": "रघोरजस्ततो जातो राजा दशरथो बली ।\nतस्य पुत्रास्तु चत्वारो महाबलपराक्रमाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005960003, "chapter_id": 25960, "verse_number": "१-१४३-४", "content_sanskrit": "कौसल्यायाम भूद्रामो भरतः कैकयीसुतः ।\nसुतौ लक्ष्मणशक्षुघ्नौ सुमित्रायां बभूवतुः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005960004, "chapter_id": 25960, "verse_number": "१-१४३-५", "content_sanskrit": "रामो भक्तः पितुर्मातुर्विश्वामित्रादवाप्तवान् ।\nअस्त्रग्रामं ततो यक्षीं ताटकां प्रजघान ह ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005960005, "chapter_id": 25960, "verse_number": "१-१४३-६", "content_sanskrit": "विशावमित्रस्य यज्ञे वै सुबाहुं न्यवधीद्बली। ।\nजनकस्य क्रतुं गत्वा उपयेमेऽथ जानकीम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005960006, "chapter_id": 25960, "verse_number": "१-१४३-७", "content_sanskrit": "ऊर्मिलां लक्ष्मणो वीरो भरतो माण्डवीं सुताम ।\nशत्रुघ्नो वै कीर्तिमतीं कुशध्वजसुते उभे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005960007, "chapter_id": 25960, "verse_number": "१-१४३-८", "content_sanskrit": "पित्रादिभिरयोध्यायां गत्वा रामादयः स्थिताः। ।\nयुधाजितं मातुलञ्च शत्रुघ्नभरतौ गतौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005960008, "chapter_id": 25960, "verse_number": "१-१४३-९", "content_sanskrit": "गतयोर्नृपवर्योऽसौ राज्यं दातुं समुद्यतः ।\nस रामाय तत्पुत्राय कैकेय्या प्रार्थितस्तदा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005960009, "chapter_id": 25960, "verse_number": "१-१४३-१०", "content_sanskrit": "चतुर्दशसमावासो वनेरामस्य वाञ्छितः ।\nरामः पितृहितार्थञ्च लक्ष्मणेन च सीतया ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005960010, "chapter_id": 25960, "verse_number": "१-१४३-११", "content_sanskrit": "राज्यञ्च तृणवत्त्यक्त्वा शृङ्गवेरपुरं गतः ।\nरथं त्यक्त्वा प्रयागञ्च चित्रकूटगिरिं गतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005960011, "chapter_id": 25960, "verse_number": "१-१४३-१२", "content_sanskrit": "रामस्य तु वियोगेन राजा स्वर्गं समाश्रित। ।\nसंस्कृत्य भरतश्चागाद्राममाह बलान्वितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005960012, "chapter_id": 25960, "verse_number": "१-१४३-१३", "content_sanskrit": "अयोध्यान्तु समागत्य राज्यं कुरु महामते ।\nस नैच्छत्पादुके दत्त्वा राज्याय भरताय तु ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005960013, "chapter_id": 25960, "verse_number": "१-१४३-१४", "content_sanskrit": "विसर्जितोऽथ भरतो रामराज्यमपालयत् ।\nनन्दिग्रामे स्थितो भक्तो ह्ययोध्यां नाविशद्व्रती ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005960014, "chapter_id": 25960, "verse_number": "१-१४३-१५", "content_sanskrit": "रामोऽपि चित्रकूटाच्च ह्यत्रेराश्रममाययौ ।\nनत्वा सुतीक्ष्णं चागस्त्यं दण्डकारण्यमागतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005960015, "chapter_id": 25960, "verse_number": "१-१४३-१६", "content_sanskrit": "तत्र शूर्पणखा नाम राक्षसी चात्तुमागत। ।\nनिकृत्य कर्णो नासे च रामेणाथापवारिता ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005960016, "chapter_id": 25960, "verse_number": "१-१४३-१७", "content_sanskrit": "तत्प्रेरितः खरश्चागाद्दूषणस्त्रिशिरास्तथा ।\nचतुर्दशसहस्रेण रक्षसान्तु बलेन च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005960017, "chapter_id": 25960, "verse_number": "१-१४३-१८", "content_sanskrit": "रामोऽपि प्रेषयामास बाणैर्यमपुरञ्च तान् ।\nराक्षस्या प्रेरितोऽभ्यागाद्रावणो हरणाय हि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005960018, "chapter_id": 25960, "verse_number": "१-१४३-१९", "content_sanskrit": "मृगरूपं स मारीचं कृत्वाग्रेऽथ त्रिदण्धक् ।\nसीतया प्रेरितो रामो मारीचं निजघान ह ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005960019, "chapter_id": 25960, "verse_number": "१-१४३-२०", "content_sanskrit": "म्रियमाणः स च प्राह हा सीते ! लक्ष्मणोति ।\nसीतोक्तो लक्ष्मणोऽथागाद्रामश्चानुददर्श तम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005960020, "chapter_id": 25960, "verse_number": "१-१४३-२१", "content_sanskrit": "उवाच राक्षसी माया नूनं सीता हृतेति सः ।\nरावणोऽन्तरमासाद्य ह्यङ्केनादाय जानकीम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005960021, "chapter_id": 25960, "verse_number": "१-१४३-२२", "content_sanskrit": "जटायुषं विनिर्भिद्य ययौ लङ्कां ततो बल। ।\nअशोकवृक्षच्छायायां रक्षितां तामधारयत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005960022, "chapter_id": 25960, "verse_number": "१-१४३-२३", "content_sanskrit": "आगत्य रामः सून्याञ्च पर्णशालां ददर्श ह ।\nशोकं कृत्वाथ जानक्या मार्गणं कृतवान्प्रभुः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005960023, "chapter_id": 25960, "verse_number": "१-१४३-२४", "content_sanskrit": "जटायुषञ्च संस्कृत्य तदुक्तो दक्षिणां दिशम् ।\nगत्वा सख्यं ततश्चक्रे सुग्रीवेण च राघवः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005960024, "chapter_id": 25960, "verse_number": "१-१४३-२५", "content_sanskrit": "सप्त तालान्विनिर्भिद्य शरेणानतपर्वणा ।\nवालिनञ्च विनिर्भिद्य किष्किन्धायां हरीश्वरम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005960025, "chapter_id": 25960, "verse_number": "१-१४३-२६", "content_sanskrit": "सुग्रीवं कृतवान्राम ऋश्यमूके स्वयं स्थित। ।\nसुग्रीवः प्रेषयामास वानरान्पर्वतोपमान् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005960026, "chapter_id": 25960, "verse_number": "१-१४३-२७", "content_sanskrit": "सीताया मार्गणं कर्तुं पूर्वाद्याशासु सोत्सवान। ।\nप्रतीचीमुत्तरां प्राचीं दिशं गत्वा समागताः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005960027, "chapter_id": 25960, "verse_number": "१-१४३-२८", "content_sanskrit": "दक्षिणान्तु दिशं ये च मार्गयन्तोऽथ जाकम् ।\nवनानि पर्वतान्द्वीपान्नदीनां पुलिनानि च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005960028, "chapter_id": 25960, "verse_number": "१-१४३-२९", "content_sanskrit": "जानकीन्ते ह्यपश्यन्तो मरणे कृतनिश्चयाः ।\nसम्पातिवचनाज्ज्ञात्वा हनूमान्कपिकुञ्जरः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005960029, "chapter_id": 25960, "verse_number": "१-१४३-३०", "content_sanskrit": "शतयोजनविस्तीर्णं पुप्लुवे मकरालयम् ।\nअपश्यज्जानकीं तत्र ह्यशोकवनिकास्थिताम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005960030, "chapter_id": 25960, "verse_number": "१-१४३-३१", "content_sanskrit": "भर्त्सितां राक्षसीभिश्च रावणेन च रक्षसा ।\nभव भार्येति वदता चिन्तयन्तीञ्च राघवम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005960031, "chapter_id": 25960, "verse_number": "१-१४३-३२", "content_sanskrit": "अङ्गुलीयं कपिर्दत्त्वा सीतां कौशल्यमब्रवीत् ।\nरामस्य तस्य दूतोऽहं शोकं मा कुरु मैथिलि ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005960032, "chapter_id": 25960, "verse_number": "१-१४३-३३", "content_sanskrit": "स्वाभिज्ञानञ्च मे देहि येन रामः स्मरिष्यति ।\nतच्छ्रुत्वा प्रददौ सीता वेणीरत्नं हनूमते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005960033, "chapter_id": 25960, "verse_number": "१-१४३-३४", "content_sanskrit": "यथा रामो नयेच्छीघ्रं तथा वाच्यं त्वया कपे ।\nतथेत्युक्त्वा तु हनुमान्वनं दिव्यं बभञ्ज ह ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005960034, "chapter_id": 25960, "verse_number": "१-१४३-३५", "content_sanskrit": "हत्वाक्षं राक्षसांश्चान्यान्बन्धनं स्वयमागतः ।\nसर्वैरिन्द्रजितो बाणैर्दृष्ट्वा रावणमब्रवीत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005960035, "chapter_id": 25960, "verse_number": "१-१४३-३६", "content_sanskrit": "रामदूतोऽस्मि हनुमान्देहि रामाय मैथिलीम् ।\nएतच्छ्रुत्वा प्रकुपितो दीपयामास पुच्छकम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005960036, "chapter_id": 25960, "verse_number": "१-१४३-३७", "content_sanskrit": "कपिर्ज्वलितलाङ्गूलो लङ्कां देहेऽ महाबलः ।\nदग्ध्वा लङ्कां समायातो रामपार्श्वं स वानरः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005960037, "chapter_id": 25960, "verse_number": "१-१४३-३८", "content_sanskrit": "जग्ध्वा फलं मधुवने दृष्टा सीतत्यवेदयत् ।\nवेणीरत्नञ्च रामाय रामो लङ्कापुर्री ययौ ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005960038, "chapter_id": 25960, "verse_number": "१-१४३-३९", "content_sanskrit": "ससुग्रीवः स हनुमान्सांगदश्च सलक्ष्मणः ।\nविभीषणोऽपि सम्प्राप्तः शरणं राघवं प्रति ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005960039, "chapter_id": 25960, "verse_number": "१-१४३-४०", "content_sanskrit": "लङ्कैश्वर्येष्वभ्यषिञ्चद्रामस्तं रावणानुजम् ।\nरामो नलेन सेतुञ्च कृत्वाब्धौ चोत्ततार तम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005960040, "chapter_id": 25960, "verse_number": "१-१४३-४१", "content_sanskrit": "सुवेलावस्थितश्चैव पुरीं लङ्कां ददर्श। ।\nअथ ते वानरा वीरा नीलाङ्गदनलादयः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005960041, "chapter_id": 25960, "verse_number": "१-१४३-४२", "content_sanskrit": "धूम्रधूम्राक्षवीरेन्द्रा जाम्बवत्प्रमुखास्तदा ।\nमैन्दद्विविदमुख्यास्ते पुरीं लङ्कां बभञ्जिरे ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005960042, "chapter_id": 25960, "verse_number": "१-१४३-४३", "content_sanskrit": "राक्षसांश्च महाकायान्कालाञ्जनचयोपमान् ।\nरामः सलक्ष्मणो हत्वा सकपिः सर्वराक्षसान् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005960043, "chapter_id": 25960, "verse_number": "१-१४३-४४", "content_sanskrit": "विद्युज्जिह्वञ्च धूम्राक्षं देवान्तकरन्त कौ ।\nमहोदरमहापार्श्वावतिकायं महाबलम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005960044, "chapter_id": 25960, "verse_number": "१-१४३-४५", "content_sanskrit": "कुम्भं निकुम्भं मत्तञ्च मकराक्षं ह्यकम्पनम। ।\nप्रहस्तं वीरमुन्मत्तं कुम्भकर्णं महाबलम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005960045, "chapter_id": 25960, "verse_number": "१-१४३-४६", "content_sanskrit": "रावणिं लक्ष्मणोऽच्छिन्त ह्यस्त्राद्यै राघवबली ।\nनिकृत्य बाहुचक्राणि रावणन्तु न्यपातयन् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005960046, "chapter_id": 25960, "verse_number": "१-१४३-४७", "content_sanskrit": "सीतां शुद्धां गृहीत्वाथ विमाने पुष्पके स्थितः ।\nसवानरः समायातो ह्ययोध्यां प्रवरां पुरीम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005960047, "chapter_id": 25960, "verse_number": "१-१४३-४८", "content_sanskrit": "तत्र राज्यं चकाराथ पुत्त्रवत्पालयनपरजाः ।\nदशाश्वमेधानाहृत्य गयाशिरसि पातनम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005960048, "chapter_id": 25960, "verse_number": "१-१४३-४९", "content_sanskrit": "पिण्डानां विधिवत्कृत्वा दत्त्वा दानानि राघवः ।\nपुत्रौ कुशलवौ दृष्ट्वा तौ च राज्येऽभ्यषेचयत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005960049, "chapter_id": 25960, "verse_number": "१-१४३-५०", "content_sanskrit": "एकादशसहस्राणि रामो राज्यमकारयत् ।\nशत्रुघ्नो लवणं जघ्ने शैलूषं भतस्ततः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005960050, "chapter_id": 25960, "verse_number": "१-१४३-५१", "content_sanskrit": "अगस्त्यादीन्मुनीन्नत्वा श्रुत्वोत्पत्तिञ्च रक्सम् ।\nस्वर्गं गतो जनैः सार्धमयोध्यास्थैः कृतार्थकः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]