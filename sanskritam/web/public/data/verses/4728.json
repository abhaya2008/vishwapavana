[{"id": 2176080, "chapter_id": 4728, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2176081, "chapter_id": 4728, "verse_number": "१", "content_sanskrit": "एवं तद्युद्धमभवत् तुमुलं जनमेजय ।\nयत्र दुःखान्वितो राजा धृतराष्ट्रोऽब्रवीदिदम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2176082, "chapter_id": 4728, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2176083, "chapter_id": 4728, "verse_number": "२", "content_sanskrit": "रामं सन्निहितं श्रुत्वा गदायुद्ध उपस्थिते ।\nमम पुत्रः कथं भीमं प्रत्ययुध्यत सञ्जय\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2176084, "chapter_id": 4728, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2176085, "chapter_id": 4728, "verse_number": "३", "content_sanskrit": "रामसान्निध्यमागम्य पुत्रो दुर्योधनस्तव ।\nयोद्धुकामो महाबाहुः समहृष्यत वीर्यवान्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2176086, "chapter_id": 4728, "verse_number": "४", "content_sanskrit": "दृष्ट्वा लाङ्गलिनं राजा प्रत्युत्थाय च भारत ।\nप्रीत्या परमया युक्तो युधिष्ठिरमथाब्रवीत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2176087, "chapter_id": 4728, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2176088, "chapter_id": 4728, "verse_number": "५", "content_sanskrit": "समन्तपञ्चकं पुण्यमितो याम विशाम्पते ।\nप्रथितोत्तरवेदिः सा ब्रह्मलोके प्रजापतेः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2176089, "chapter_id": 4728, "verse_number": "६", "content_sanskrit": "तस्मिन् ध्रुवे पुण्यतमे त्रैलोक्यस्य सनातने ।\nसङ्ग्रामे निधनं प्राप्य ध्रुवं स्वर्गं गमिष्यति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2176090, "chapter_id": 4728, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2176091, "chapter_id": 4728, "verse_number": "७", "content_sanskrit": "तथेत्युक्त्वा महाराज कुन्तीपुत्रो युधिष्ठिरः ।\nसमन्तपञ्चकं वीरः प्रायादभिमुखः प्रभुः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2176092, "chapter_id": 4728, "verse_number": "८", "content_sanskrit": "ततो दुर्योधनो राजन् प्रगृह्य महतीं गदाम् ।\nपद्भ्याममर्षी द्युतिमान् अगच्छत् पाण्डवैः सह\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2176093, "chapter_id": 4728, "verse_number": "९", "content_sanskrit": "तथा यान्तं गदाहस्तं वर्मिणं चापि दंसितम् ।\nअन्तरिक्षचरा देवाः साधु साध्वित्यपूजयन्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2176094, "chapter_id": 4728, "verse_number": "१०", "content_sanskrit": "वार्तिकाश्च नरव्याघ्रं दृष्ट्वा ते हर्षमागताः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2176095, "chapter_id": 4728, "verse_number": "११", "content_sanskrit": "स पाण्डवैः परिवृतः कुरुराजस्तवात्मजः ।\nमत्तस्येव गजेन्द्रस्य गतिमास्थाय सोऽव्रजत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2176096, "chapter_id": 4728, "verse_number": "१२", "content_sanskrit": "ततः शङ्खनिनादैश्च भेरीणां च महास्वनैः ।\nसिंहनादैश्च शूराणां दिशः सर्वाः प्रपूरिताः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2176097, "chapter_id": 4728, "verse_number": "१३", "content_sanskrit": "प्रतीच्यभिमुखं देशं यथोद्दिष्टं सुतेन ते ।\nगत्वा च तैः परिक्षिप्तं समन्तात् सर्वतोदिशम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2176098, "chapter_id": 4728, "verse_number": "१४", "content_sanskrit": "दक्षिणेन सरस्वत्याः स्नपनं तीर्थमुत्तमम् ।\nतस्मिन् देशे त्वनिरणे ते तु युद्धमरोचयन्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2176099, "chapter_id": 4728, "verse_number": "१५", "content_sanskrit": "ततो भीमो महाकोटिं गदां गृह्य च धर्मभृत् ।\nबिभ्रद्रूपं महाराज सदृशं हि गरुत्मतः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2176100, "chapter_id": 4728, "verse_number": "१६", "content_sanskrit": "अवबद्धशिरस्त्राणः शुद्धकाञ्चनवर्मधृक् ।\nरराज राजन् पुत्रस्ते काञ्चनः शैलराडिव\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2176101, "chapter_id": 4728, "verse_number": "१७", "content_sanskrit": "तद्यथा सङ्गतौ वीरौ भीमदुर्योधनावुभौ ।\nसंयुगे सम्प्रकाशेते संरब्धाविव कुञ्जरौ\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2176102, "chapter_id": 4728, "verse_number": "१८", "content_sanskrit": "रथमण्डलमध्यस्थौ भ्रातरौ भरतर्षभौ ।\nअशोभेतां महाराज चन्द्रसूर्याविवोदितौ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2176103, "chapter_id": 4728, "verse_number": "१९", "content_sanskrit": "तावन्योन्यं निरीक्षन्तौ क्रुद्धाविव महोरगौ ।\nदहन्तौ लोचनैर्वीरौ परस्परवधैषिणौ\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2176104, "chapter_id": 4728, "verse_number": "२०", "content_sanskrit": "सम्प्रहृष्टमना राजन् गदामादाय पाण्डवः ।\nसृक्विणी सँल्लिहन् राजन् क्रोधताम्रेक्षणः श्वसन्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2176105, "chapter_id": 4728, "verse_number": "२१", "content_sanskrit": "ततो दुर्योधनो राजन् गदामादाय भारत ।\nभीमो भीममभिप्रेक्ष्य गजो गजमिवाह्वयत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2176106, "chapter_id": 4728, "verse_number": "२२", "content_sanskrit": "अद्रिसारमयीं वीरस्तथैवादाय वेगवान् ।\nआह्वयामास नृपतिं सिंहं सिंहो यथा वने\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2176107, "chapter_id": 4728, "verse_number": "२३", "content_sanskrit": "तावुद्यतगदापाणी दुर्योधनवृकोदरौ ।\nसंयुगे सम्प्रकाशेते गिरी सशिखराविव\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2176108, "chapter_id": 4728, "verse_number": "२४", "content_sanskrit": "तावुभावपि सङ्क्रुद्धावुभौ भीमपराक्रमौ ।\nउभौ शिष्यौ गदायुद्धे रौहिणेयस्य धीमतः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2176109, "chapter_id": 4728, "verse_number": "२५", "content_sanskrit": "उभौ सदृशकर्माणौ वरुणस्य महाबलौ ।\nवासुदेवस्य रामस्य तथा वैश्रवणस्य च\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2176110, "chapter_id": 4728, "verse_number": "२६", "content_sanskrit": "सदृशौ तौ महाराज मधुकैटभयोरपि ।\nउभौ सदृशकर्माणौ रणे सुन्दोपसुन्दयोः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2176111, "chapter_id": 4728, "verse_number": "२७", "content_sanskrit": "रामरावणयोश्चैव वालिसुग्रीवयोस्तथा ।\nतथैव कालस्य सदृशौ मृत्योश्चैव परन्तपौ ।\nअन्योन्यमभिगर्जन्तौ मत्ताविव महागजौ\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2176112, "chapter_id": 4728, "verse_number": "२८", "content_sanskrit": "वाशितासङ्गमे दृप्तौ शरदीव मदोत्कटौ ।\nमत्ताविव जिगीषन्तौ मातङ्गौ भरतर्षभ\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2176113, "chapter_id": 4728, "verse_number": "२९", "content_sanskrit": "उभौ क्रोधविषं तीव्रं वमन्तावुरगाविव ।\nअन्योन्यमभिसंरब्धौ प्रेक्षमाणावरिन्दमौ\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2176114, "chapter_id": 4728, "verse_number": "३०", "content_sanskrit": "उभौ भरतशार्दूलौ विक्रमेण समन्वितौ ।\nसिंहाविव दुराधर्षौ गदायुद्धे परन्तपौ\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2176115, "chapter_id": 4728, "verse_number": "३१", "content_sanskrit": "नखदंष्ट्रायुधौ वीरौ सिंहाविव दुरुत्सहौ ।\nप्रजासंहरणे क्षुब्धौ समुद्राविव दुस्तरौ\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2176116, "chapter_id": 4728, "verse_number": "३२", "content_sanskrit": "लोहितार्काविव क्रुद्धौ प्रतपन्तौ महारथौ\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2176117, "chapter_id": 4728, "verse_number": "३३", "content_sanskrit": "पूर्वपश्चिमयो राजन् वायुनाक्षाभिषो यथा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2176118, "chapter_id": 4728, "verse_number": "३४", "content_sanskrit": "गर्जमानौ सुविषमं क्षरन्तौ प्रावृषीव हि ।\nरश्मियुक्तौ महात्मानौ दीप्तिमन्तौ महाबलौ\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2176119, "chapter_id": 4728, "verse_number": "३५", "content_sanskrit": "ददृशाते कुरुश्रेष्ठौ कालसूर्याविवोदितौ ।\nव्याघ्राविव सुसंरब्धौ गर्जन्ताविव तोयदौ\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2176120, "chapter_id": 4728, "verse_number": "३६", "content_sanskrit": "जहृषाते महाबाहू सिंहकेसरिणाविव ।\nगजाविव सुसंरब्धौ ज्वलिताविव पावकौ\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2176121, "chapter_id": 4728, "verse_number": "३७", "content_sanskrit": "ददृशाते महात्मानौ सशृङ्गाविव पर्वतौ ।\nरोषात्प्रस्फुरणमाणोष्ठौ निरीक्षन्तौ परस्परम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2176122, "chapter_id": 4728, "verse_number": "३८", "content_sanskrit": "तौ समेतौ महात्मानौ गदाहस्तौ नरोत्तमौ ।\nउभौ परमसंहृष्टावुभौ परमसम्मतौ\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2176123, "chapter_id": 4728, "verse_number": "३९", "content_sanskrit": "सदश्वाविव हेषन्तौ बृहन्ताविव कुञ्जरौ ।\nवृषभाविव गर्जन्तौ दुर्योधनवृकोदरौ ।\nदैत्याविव बलोन्मत्तौ रेजतुस्तौ नरोत्तमौ\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2176124, "chapter_id": 4728, "verse_number": "४०", "content_sanskrit": "ततो दुर्योधनो राजन्निदमाह युधिष्ठिरम् ।\nसृञ्जयैः सह तिष्ठन्तं तपन्तमिव भास्करम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2176125, "chapter_id": 4728, "verse_number": "४१", "content_sanskrit": "इदं व्यवसितं युद्धं मम भीमस्य चोभयोः ।\nउपोपविष्टाः पश्यध्वं विमर्दं नृपसत्तमाः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2176126, "chapter_id": 4728, "verse_number": "४२", "content_sanskrit": "ततः समुपविष्टं तत्सुमहद् राजमण्डलम् ।\nविराजमानं ददृशे दिवीवादित्यमण्डलम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2176127, "chapter_id": 4728, "verse_number": "४३", "content_sanskrit": "तेषां मध्ये महाबाहुः श्रीमान् केशवपूर्वजः ।\nउपविष्टो महाराज पूज्यमानः समन्ततः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2176128, "chapter_id": 4728, "verse_number": "४४", "content_sanskrit": "शुशुभे राजमध्यस्थो नीलवासाः सितप्रभः ।\nनक्षत्रैरिव सम्पूर्णो वृतो निशि निशाकरः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2176129, "chapter_id": 4728, "verse_number": "४५", "content_sanskrit": "तौ तथा तु महाराज गदाहस्तौ सुदुःसहौ ।\nअन्योन्यं वाग्भिरुग्राभिस्तक्षमाणौ व्यवस्थितौ\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2176130, "chapter_id": 4728, "verse_number": "४६", "content_sanskrit": "अप्रियाणि ततोऽन्योन्यमुक्त्वा तौ कुरुसत्तमौ ।\nउदीक्षन्तौ स्थितौ तत्र वृत्रशक्रौ यथाऽऽहवे\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2176131, "chapter_id": 4728, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2176132, "chapter_id": 4728, "verse_number": "४७", "content_sanskrit": "ततो वाग्युद्धमभवत् तुमुलं जनमेजय ।\nयत्र दुःखान्वितो राजा धृतराष्ट्रोऽब्रवीदिदम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2176133, "chapter_id": 4728, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2176134, "chapter_id": 4728, "verse_number": "४८", "content_sanskrit": "धिगस्तु खलु मानुष्यं यस्य निष्ठेयमीदृशी ।\nएकादशचमूभर्ता यत्र पुत्रो ममाभिभूः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2176135, "chapter_id": 4728, "verse_number": "४९", "content_sanskrit": "आज्ञाप्य सर्वान् नृपतीन् भुक्त्वा च पृथिवीमिमाम् ।\nगदामादाय चैकाकी पदातिः प्रस्थितो रणम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2176136, "chapter_id": 4728, "verse_number": "५०", "content_sanskrit": "भूत्वा हि जगतो नाथः सोऽनाथ इव मे सुतः ।\nगदामादाय यो याति किमन्यद् भागधेयतः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2176137, "chapter_id": 4728, "verse_number": "५१", "content_sanskrit": "अहो दुःखं महत् प्राप्तं पुत्रेण मम सञ्जय\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2176138, "chapter_id": 4728, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2176139, "chapter_id": 4728, "verse_number": "५२", "content_sanskrit": "एवमुक्त्वा स दुःखार्तो विरराम जनाधिपः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2176140, "chapter_id": 4728, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2176141, "chapter_id": 4728, "verse_number": "५३", "content_sanskrit": "स मेघनिस्वनो हर्षाद् विनदन्निव गोवृषः ।\nआजुहाव ततः पार्थ युद्धाय युधि वीर्यवान्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2176142, "chapter_id": 4728, "verse_number": "५४", "content_sanskrit": "भीममाह्वयमाने तु कुरुराजे महात्मनि ।\nप्रादुरासन् सुघोराणि रूपाणि विविधान्युत\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2176143, "chapter_id": 4728, "verse_number": "५५", "content_sanskrit": "ववुर्वाताः सनिर्घाताः पांसुवर्षं पपात ह ।\nबभूवुश्च दिशः सर्वास्तिमिरेण समावृताः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2176144, "chapter_id": 4728, "verse_number": "५६", "content_sanskrit": "महास्वनाः सुनिर्घाताः तुमुला रोमहर्षणाः ।\nपेतुः पृथिव्यां शतशः स्फोटयन्तो नभस्तलात्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2176145, "chapter_id": 4728, "verse_number": "५७", "content_sanskrit": "राहुरग्रसदादित्यम् अपर्वणि विशाम्पते ।\nचकम्पे च महाकम्पं पृथिवी सवनद्रुमा\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2176146, "chapter_id": 4728, "verse_number": "५८", "content_sanskrit": "रूक्षाश्च वाताः प्रववुर्नीचैः शर्करवर्षिणः ।\nगिरीणां शिखराण्याशु न्यपतन्त महीतळे\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2176147, "chapter_id": 4728, "verse_number": "५९", "content_sanskrit": "मृगा बहुविधाकाराः सम्पतन्ति दिशो दश ।\nदीप्ताः शिवाश्च प्रणदन् दारुणं भयवेदिनः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2176148, "chapter_id": 4728, "verse_number": "६०", "content_sanskrit": "निर्घाताश्च महाघोरा बभूवू रोमहर्षणाः ।\nदीप्तायां दिशि राजेन्द्र मृगाश्चाशुभवादिनः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2176149, "chapter_id": 4728, "verse_number": "६१", "content_sanskrit": "उदपानगताश्चापो व्यवर्धन्त समन्ततः ।\nअशरीरा महानादाः श्रूयन्ते स्म भयानकाः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2176150, "chapter_id": 4728, "verse_number": "६२", "content_sanskrit": "एवमादीनि दृष्ट्वा स निमित्तानि वृकोदरः ।\nउवाच भ्रातरं ज्येष्ठं धर्मराजं युधिष्ठिरम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2176151, "chapter_id": 4728, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2176152, "chapter_id": 4728, "verse_number": "६३", "content_sanskrit": "एक शक्यो रणे जेतुं मन्दात्मा च सुयोधनः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2176153, "chapter_id": 4728, "verse_number": "६४", "content_sanskrit": "अद्य क्रोधं विमोक्ष्यामि निगूढं हृदये स्थितम् ।\nसुयोधने कौरवेन्द्रे खाण्डवेऽग्निमिवार्जुनः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2176154, "chapter_id": 4728, "verse_number": "६५", "content_sanskrit": "शल्यमद्योद्धरिष्यामि तव पाण्डव हृद्गतम् ।\nनिहत्य गदया पापमिदं कुरुकुलान्तकम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2176155, "chapter_id": 4728, "verse_number": "६६", "content_sanskrit": "अद्य कीर्तिमयीं मालां प्रतिमोक्ष्याम्यहं त्वयि ।\nहत्वेमं पापकर्माणं गदया रणमूर्धनि\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2176156, "chapter_id": 4728, "verse_number": "६७", "content_sanskrit": "अस्योरू गदया राजन् भेत्तास्मि समरेऽनया ।\nनायं प्रवेष्टा नगरं पुनर्वारणसाह्वयम्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2176157, "chapter_id": 4728, "verse_number": "६८", "content_sanskrit": "सर्पोत्सर्गस्य शयने विषदानस्य भोजने ।\nप्रमाणकोट्यां पातस्य दाहस्य जतुवेश्मनि\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2176158, "chapter_id": 4728, "verse_number": "६९", "content_sanskrit": "सभायामपहासस्य सर्वस्वहरणस्य च ।\nवर्षमज्ञातवासस्य वनवासस्य चानघ\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2176159, "chapter_id": 4728, "verse_number": "७०", "content_sanskrit": "अद्यान्तमेषां दुःखानां गन्ता भरतसत्तम\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2176160, "chapter_id": 4728, "verse_number": "७१", "content_sanskrit": "एकाह्ना विनिहत्येमं भविष्याम्यात्मनोऽनृणः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2176161, "chapter_id": 4728, "verse_number": "७२", "content_sanskrit": "अद्यास्य धार्तराष्ट्रस्य दुर्मतेरकृतात्मनः ।\nसमाप्तं भरतश्रेष्ठ मातापित्रोश्च दर्शनम्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2176162, "chapter_id": 4728, "verse_number": "७३", "content_sanskrit": "अद्यायं कुरुराजस्य शन्तनोः कुलपांसनः ।\nप्राणान् श्रियं च राज्यं च त्यक्त्वा शेष्यति भूतळे\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2176163, "chapter_id": 4728, "verse_number": "७४", "content_sanskrit": "स राजा धृतराष्ट्रोऽद्य श्रुत्वा पुत्रं मया हतम् ।\nस्मरिष्यत्यशुभं कर्म यत्तच्छकुनिबुद्धिजम्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2176164, "chapter_id": 4728, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2176165, "chapter_id": 4728, "verse_number": "७५", "content_sanskrit": "इत्युक्त्वा राजशार्दूल गदामुद्यम्य वीर्यवान् ।\nअवातिष्ठत युद्धाय शक्रो वृत्रमिवाह्वयन्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2176166, "chapter_id": 4728, "verse_number": "७६", "content_sanskrit": "तमुद्यतगदं दृष्ट्वा कैलासमिव शृङ्गिणम् ।\nभीमसेनः पुनः क्रोधाद् दुर्योधनमुवाच ह\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2176167, "chapter_id": 4728, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2176168, "chapter_id": 4728, "verse_number": "७७", "content_sanskrit": "राज्ञस्तु धृतराष्ट्रस्य तथा त्वमपि चात्मनः ।\nस्मर तद्दुष्कृतं कर्म यद्वृत्तं वारणावते\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2176169, "chapter_id": 4728, "verse_number": "७८", "content_sanskrit": "द्रौपदी च परिक्लिष्टा सभायां यद्रजस्वला ।\nद्यूतेन वञ्चितो राजा यत्त्वया सौबलेन च\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2176170, "chapter_id": 4728, "verse_number": "७९", "content_sanskrit": "वने दुःखं च सम्प्राप्तमस्माभिस्त्वत्कृतं महत् ।\nविराटनगरे चैव योन्यन्तरगतैरिव\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2176171, "chapter_id": 4728, "verse_number": "८०", "content_sanskrit": "तत्सर्वं यातयाम्यद्य दिष्ट्या दृष्टोऽसि दुर्मते\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2176172, "chapter_id": 4728, "verse_number": "८१", "content_sanskrit": "त्वत्कृतेऽसौ हतःशेते शरतल्पे पितामहः ।\nगाङ्गेयो रथिनां श्रेष्ठो रथिना याज्ञसेनिना\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2176173, "chapter_id": 4728, "verse_number": "८२", "content_sanskrit": "हतो द्रोणश्च कर्णश्च तथा शल्यः प्रतापवान् ।\nवैराग्नेरादिकर्ता च शकुनिः सौबलो हतः\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2176174, "chapter_id": 4728, "verse_number": "८३", "content_sanskrit": "प्रातिकामी तथा पापो द्रौपद्याः क्लेशकृद्धतः ।\nभ्रातरस्ते हताः शूराः सर्वे विक्रान्तयोधिनः\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2176175, "chapter_id": 4728, "verse_number": "८४", "content_sanskrit": "एते चान्ये च निहताः बहवस्त्वत्कृते नृपाः ।\nत्वामप्यद्य हनिष्यामि गदया नात्र संशयः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2176176, "chapter_id": 4728, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2176177, "chapter_id": 4728, "verse_number": "८५", "content_sanskrit": "इत्येवमुच्चै राजानं भाषमाणं वृकोदरम् ।\nउवाच वीतभी राजन् पुत्रस्ते सत्यविक्रमः\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2176178, "chapter_id": 4728, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2176179, "chapter_id": 4728, "verse_number": "८६", "content_sanskrit": "किं कत्थनेन बहुना युध्यस्वेह वृकोदर ।\nअद्य तेऽहं विनेष्यामि युद्धश्रद्धां वृकोदर\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2176180, "chapter_id": 4728, "verse_number": "समाप्तिः", "content_sanskrit": "इति दुर्योधनोऽक्षुद्रः त्वया क्षुद्रबलेन वै ।\nशक्यस्त्रासयितुं वाचा न चान्यः प्राकृतो यथा\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2176181, "chapter_id": 4728, "verse_number": "८८", "content_sanskrit": "चिरकालेप्सितं दिष्ट्या हृदयस्थमिदं मम ।\nत्वया सह गदायुद्धं त्रिदशैरुपपादितम्\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2176182, "chapter_id": 4728, "verse_number": "८९", "content_sanskrit": "किं वाचा बहुनोक्तेन कत्थितेन च दुर्मते ।\nवाणी सङ्कोच्यतामेषा कर्मणा मा चिरं कृथाः\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2176183, "chapter_id": 4728, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2176184, "chapter_id": 4728, "verse_number": "९०", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा सर्व एवाभ्यपूजयन् ।\nराजानः सोमकाश्चैव ये तत्रासन् समागताः\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2176185, "chapter_id": 4728, "verse_number": "९१", "content_sanskrit": "स तैः सम्पूजितः सर्वैः सम्प्रहृष्टतनूरुहः\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2176186, "chapter_id": 4728, "verse_number": "९२", "content_sanskrit": "तं मत्तमिव मातङ्गं तळताळैर्नराधिपाः ।\nभूयः संहर्षयामासुर्दुर्योधनममर्षणम्\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2176187, "chapter_id": 4728, "verse_number": "९३", "content_sanskrit": "भूयो धीरं मनश्चक्रे युद्धाय कृतनिश्चयः\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2176188, "chapter_id": 4728, "verse_number": "९४", "content_sanskrit": "तं महात्मा महात्मानं गदामुद्यम्य पाण्डवः ।\nअभिदुद्राव वेगेन तव पुत्रं वृकोदरः\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2176189, "chapter_id": 4728, "verse_number": "९५", "content_sanskrit": "बृहन्ति कुञ्जरास्तत्र हया ह्रेषन्ति चासकृत् ।\nशस्त्राणि चाप्यदीप्यन्त पाण्डवानां जयैषिणाम्\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2176190, "chapter_id": 4728, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां गदापर्वणि भीमदुर्योधनयोः परस्परभर्त्सनं नाम षड्विंशोऽध्यायः ॥२६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}]