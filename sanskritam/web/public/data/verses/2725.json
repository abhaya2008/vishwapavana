[{"id": 2081183, "chapter_id": 2725, "verse_number": "१२-२३०-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2081184, "chapter_id": 2725, "verse_number": "१२-२३०-१", "content_sanskrit": "यया बुद्ध्या महीपालो भ्रष्टश्रीर्विचरेन्महीम्।\nकालदण्डविनिष्पिष्टस्तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2081185, "chapter_id": 2725, "verse_number": "१२-२३०-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2081186, "chapter_id": 2725, "verse_number": "१२-२३०-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nवासवस्य च संवादं बलेर्वैरोचनस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2081187, "chapter_id": 2725, "verse_number": "१२-२३०-३", "content_sanskrit": "पितामहमुपागम्य प्रणिपत्य कृताञ्जलिः।\nसर्वानेवासुराञ्जित्वा बलिं पप्रच्छ वासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2081188, "chapter_id": 2725, "verse_number": "१२-२३०-४", "content_sanskrit": "यस्य स्म ददतो वित्तं न कदाचन हीयते।\nतं बलिं नाधिगच्छामि ब्रह्मन्नाचक्ष्व मे बलिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2081189, "chapter_id": 2725, "verse_number": "१२-२३०-५", "content_sanskrit": "स वायुर्वरुणश्चैव स रविः स च चन्द्रमाः।\nसोऽग्निस्तपति भूतानि जलं च स भवत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2081190, "chapter_id": 2725, "verse_number": "१२-२३०-६", "content_sanskrit": "तं बलिं नाधिगच्छामि ब्रह्मन्नाचक्ष्व मे बलिम्।\nस एव ह्यस्तमयते स स्म विद्योतते दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2081191, "chapter_id": 2725, "verse_number": "१२-२३०-७", "content_sanskrit": "स वर्षति स्म वर्षाणि यथाकालमतन्द्रितः।\nतं बलिं नाधिगच्छामि ब्रह्मन्नाचक्ष्व मे बलिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2081192, "chapter_id": 2725, "verse_number": "१२-२३०-८x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2081193, "chapter_id": 2725, "verse_number": "१२-२३०-८", "content_sanskrit": "नैतत्ते साधु मघवन्यदेनमनुपृच्छसि।\nपृष्टस्तु नानृतं ब्रूयात्तस्माद्वक्ष्यामि ते बलिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2081194, "chapter_id": 2725, "verse_number": "१२-२३०-९", "content_sanskrit": "उष्ट्रेषु यदि वा गोषु खरेष्वश्वेषु वा पुनः।\nवरिष्ठो भविता जन्तुः शून्यागारे शचीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2081195, "chapter_id": 2725, "verse_number": "१२-२३०-१०x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2081196, "chapter_id": 2725, "verse_number": "१२-२३०-१०", "content_sanskrit": "यदि स्म बलिना ब्रह्मञ्शून्यागारे समेयिवान्।\nहन्यामेनं न वा हन्यां तद्ब्रह्मन्ननुशाधि माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2081197, "chapter_id": 2725, "verse_number": "१२-२३०-११x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2081198, "chapter_id": 2725, "verse_number": "१२-२३०-११", "content_sanskrit": "मा स्म शक्र बलिं हिंसीर्न बलिर्वधमर्हति।\nन्यायस्तु शक्र प्रष्टव्यस्त्वया वासव काम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2081199, "chapter_id": 2725, "verse_number": "१२-२३०-१२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2081200, "chapter_id": 2725, "verse_number": "१२-२३०-१२", "content_sanskrit": "एवमुक्तो भगवता महेन्द्रः पृथिवीं तदा।\nचचारैरावतस्कन्धमधिरुह्य श्रिया वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2081201, "chapter_id": 2725, "verse_number": "१२-२३०-१३", "content_sanskrit": "ततो ददर्श स बलिं खरवेषेण संवृतम्।\nयथाख्यातं भगवता शून्यागारकृतालयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2081202, "chapter_id": 2725, "verse_number": "१२-२३०-१४x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2081203, "chapter_id": 2725, "verse_number": "१२-२३०-१४", "content_sanskrit": "खरयोनिमनुप्राप्तस्तुपभक्षोऽसि दानव।\nइदं ते योनिरसमा शोचस्याहो न शोचसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2081204, "chapter_id": 2725, "verse_number": "१२-२३०-१५", "content_sanskrit": "अदृष्टं वत पश्यामि द्विषतां वशमागतम्।\nश्रिया विहीनं मित्रैश्च भ्रष्टैश्वर्यपराक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2081205, "chapter_id": 2725, "verse_number": "१२-२३०-१६", "content_sanskrit": "यत्तद्यानसहस्रैस्त्वं ज्ञातिभिः परिवारितः।\nलोकान्प्रतापयन्सर्वान्यास्यस्मानवितर्कयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2081206, "chapter_id": 2725, "verse_number": "१२-२३०-१७", "content_sanskrit": "त्वन्मुखाश्चैव दैतेय व्यतिष्ठंस्तव शासने।\nअकृष्टपच्या पृथिवी तवैश्वर्ये बभूव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2081207, "chapter_id": 2725, "verse_number": "१२-२३०-१८", "content_sanskrit": "इदं च तेऽद्य व्यसनं शोचस्याहो न शोचसि।\nयदाऽतिष्ठः समुद्रस्य पूर्वकूले विलेलिखन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2081208, "chapter_id": 2725, "verse_number": "१२-२३०-१९", "content_sanskrit": "ज्ञातिभ्यो विभजन्वित्तं तदासीत्ते मनः कथम्।\nयत्ते सहस्रसमिता ननुतुर्देवसोषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2081209, "chapter_id": 2725, "verse_number": "१२-२३०-२०", "content_sanskrit": "बहूनि वर्षपूगानि विहारे दीप्यतः श्रिया।\nसर्वाः पुष्करमालिन्यः सर्वाः काञ्चनसप्रभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2081210, "chapter_id": 2725, "verse_number": "१२-२३०-२१", "content_sanskrit": "कथमद्य तदा चैव मनस्ते दानवेश्वर।\nछत्रं तवासीत्सुमहत्सौवर्णं रत्नभूषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2081211, "chapter_id": 2725, "verse_number": "१२-२३०-२२", "content_sanskrit": "ननृतुस्तत्र गन्धर्वाः षट्सहस्राणि सप्तचा।\nयूपस्तवासीत्सुमहान्यजतः सर्वकाञ्चनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2081212, "chapter_id": 2725, "verse_number": "१२-२३०-२३", "content_sanskrit": "यत्राददः सहस्राणि अयुतानां गवां दश।\nअनन्तरं सहस्रेण तदाऽऽसीद्दैत्या का मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2081213, "chapter_id": 2725, "verse_number": "१२-२३०-२४", "content_sanskrit": "यदा च पृथिवीं सर्वां यजमानोऽनुपर्यगाः।\nशम्याक्षेपेण विधिना तदाऽऽसीत्किंतु ते हृदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2081214, "chapter_id": 2725, "verse_number": "१२-२३०-२५", "content_sanskrit": "न ते पश्यामि भृङ्गारं न च्छत्रं व्यजनं न च।\nब्रह्मदत्तां च ते मालां न पश्याम्यसुराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2081215, "chapter_id": 2725, "verse_number": "१२-२३०-२६x", "content_sanskrit": "`भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2081216, "chapter_id": 2725, "verse_number": "१२-२३०-२६", "content_sanskrit": "ततः प्रहस्य स बलिर्वासवेन समीरितम्।\nनिशम्य मानगम्भीरं सुरराजमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2081217, "chapter_id": 2725, "verse_number": "१२-२३०-२७", "content_sanskrit": "अहो हि तव बालिश्यमिह देवगणाधिप।\nअयुक्तं देवराजस्य तव कष्टमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2081218, "chapter_id": 2725, "verse_number": "१२-२३०-२८", "content_sanskrit": "न त्वं पश्यसि भृङ्गारं न च्छन्नं व्यजनं न च।\nब्रह्मदत्तां च मे मालां न त्वं द्रक्ष्यसि वासव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2081219, "chapter_id": 2725, "verse_number": "१२-२३०-२९", "content_sanskrit": "गुहायां निहितानि त्वं मम रत्नानि पृच्छसि।\nयदा मे भविता कालस्तदा त्वं तानि द्रक्ष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2081220, "chapter_id": 2725, "verse_number": "१२-२३०-३०", "content_sanskrit": "`न जानीषे भवान्सिद्धिं शुभाङ्गस्वरूपरूपिणीम्।\nकालेन भविता सर्वो नात्र गच्छति वासव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2081221, "chapter_id": 2725, "verse_number": "१२-२३०-३१", "content_sanskrit": "न त्वेतदनुरूपं ते यशसो वा कुलस्य च।\nसमृद्धार्थोऽसमृद्धार्थं यन्मां कत्थितुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2081222, "chapter_id": 2725, "verse_number": "१२-२३०-३२", "content_sanskrit": "न हि दुःखेषु शोचन्ते न प्रहृष्यन्ति चर्द्धिषु।\nकृतप्रज्ञाः ज्ञानतृप्ताः क्षान्ताः सन्तो मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2081223, "chapter_id": 2725, "verse_number": "१२-२३०-३३", "content_sanskrit": "त्वं तु प्राकृतया बुद्ध्या पुरंदर विकत्थसे।\nयदाऽहमिव भावी स्यास्तदा नैवं वदिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2081224, "chapter_id": 2725, "verse_number": "१२-२३०-३४", "content_sanskrit": "`ऐश्वर्यमदमत्तो मां स त्वं किंचिन्न बुद्ध्यसे।\nराज्याद्विनिपतानेन सोहं न त्वपराजितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2081225, "chapter_id": 2725, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शन्तिपर्वणि मोश्रधर्मपर्वणि त्रिंशदधिकद्विशततमोऽध्यायः॥ २३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]