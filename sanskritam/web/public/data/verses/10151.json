[{"id": 6000151000, "chapter_id": 10151, "verse_number": null, "content_sanskrit": "अथ त्रयोदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000151001, "chapter_id": 10151, "verse_number": null, "content_sanskrit": "नारद उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.001.m4a", "display_order": 2}, {"id": 6000151002, "chapter_id": 10151, "verse_number": "७-१३-१", "content_sanskrit": "कल्पस्त्वेवं परिव्रज्य देहमात्रावशेषितः।\nग्रामैकरात्रविधिना निरपेक्षश्चरेन्महीम्॥ ७/१३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.002.m4a", "display_order": 3, "topics": [{"text": "यतिधर्मकथनम्", "range": "१–१०"}]}, {"id": 6000151003, "chapter_id": 10151, "verse_number": "७-१३-२", "content_sanskrit": "बिभृयाद् यद्यसौ वासः कौपीनाच्छादनं परम्।\nत्यक्तं न लिङ्गदण्डाभ्यामन्यत् किञ्चिदनापदि॥ ७/१३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.003.m4a", "display_order": 4}, {"id": 6000151004, "chapter_id": 10151, "verse_number": "७-१३-३", "content_sanskrit": "एक एव चरेद् भिक्षुरात्मारामोऽनपाश्रयः।\nसर्वभूतसुहृच्छान्तो नारायणपरायणः॥ ७/१३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.004.m4a", "display_order": 5}, {"id": 6000151005, "chapter_id": 10151, "verse_number": "७-१३-४", "content_sanskrit": "पश्येदात्मन्यदो विश्वं परे सदसतोऽद्वये।\nआत्मानं च परं ब्रह्म सर्वत्र सदसन्मये॥ ७/१३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.005.m4a", "display_order": 6}, {"id": 6000151006, "chapter_id": 10151, "verse_number": "७-१३-५", "content_sanskrit": "सुप्तप्रबोधयोः सन्धावत्मनो गतिमात्मदृक्।\nपश्यन् बन्धं च मोक्षं च मायामात्रं न वस्तुतः॥ ७/१३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.006.m4a", "display_order": 7}, {"id": 6000151007, "chapter_id": 10151, "verse_number": "७-१३-६", "content_sanskrit": "नाभिनन्देद् ध्रुवं मृत्युमध्रुवं वा स्वजीवितम्।\nकालं परं प्रतीक्षेत भूतानां प्रभवाप्ययम्॥ ७/१३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.007.m4a", "display_order": 8}, {"id": 6000151008, "chapter_id": 10151, "verse_number": "७-१३-७", "content_sanskrit": "नासच्छास्‍त्रेषु सज्जेत नोपजीवेत जीविकाम्।\nअतिवादान् त्यजेत् तर्कान् पक्षं कञ्चिन्न संश्रयेत्॥ ७/१३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.008.m4a", "display_order": 9}, {"id": 6000151009, "chapter_id": 10151, "verse_number": "७-१३-८", "content_sanskrit": "न शिष्याननुबध्नीत ग्रन्थान् नैवाभ्यसेद् बहून्।\nन व्याख्यामुपजीवेत नारम्भान्नारभेत्क्‍वचित्॥ ७/१३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.009.m4a", "display_order": 10}, {"id": 6000151010, "chapter_id": 10151, "verse_number": "७-१३-९", "content_sanskrit": "न यतेराश्रमः प्रायो धर्महेतुर्महात्मनः।\nशान्तस्य समचित्तस्य बिभृयादुत वा त्यजेत्॥ ७/१३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.010.m4a", "display_order": 11}, {"id": 6000151011, "chapter_id": 10151, "verse_number": "७-१३-१०", "content_sanskrit": "अव्यक्तलिङ्गो व्यक्तार्थो मनीष्युन्मत्तबालवत्।\nकविर्मूकवदात्मानमदृश्यो दर्शयेन्नृणाम्॥ ७/१३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.011.m4a", "display_order": 12}, {"id": 6000151012, "chapter_id": 10151, "verse_number": "७-१३-११", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nप्रह्लादस्य च संवादं मुनेराजगरस्य च॥ ७/१३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.012.m4a", "display_order": 13, "topics": [{"text": "आजगरमुनिचरित्रम्", "range": "११–४६"}]}, {"id": 6000151013, "chapter_id": 10151, "verse_number": "७-१३-१२", "content_sanskrit": "तं शयानं धरोपस्थे कावेर्यां सह्यसानुनि।\nरजस्वलैस्तनूदेशैर्निगूढामलतेजसम्॥ ७/१३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.013.m4a", "display_order": 14}, {"id": 6000151014, "chapter_id": 10151, "verse_number": "७-१३-१३", "content_sanskrit": "ददर्श लोकान् विचरन् लोकतत्त्वविवित्सया।\nवृतोऽमात्यैः कतिपयैः प्रह्लादो भगवत्प्रियः॥ ७/१३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.014.m4a", "display_order": 15}, {"id": 6000151015, "chapter_id": 10151, "verse_number": "७-१३-१४", "content_sanskrit": "कर्मणाऽऽकृतिभिर्वाचा लिङ्गैर्वर्णाश्रमादिभिः।\nनाविन्दत जनोऽयं वै सोऽसाविति न वेति च॥ ७/१३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.015.m4a", "display_order": 16}, {"id": 6000151016, "chapter_id": 10151, "verse_number": "७-१३-१५", "content_sanskrit": "तं नत्वाऽभ्यर्च्य विधिवत् पादयोः शिरसा स्पृशन्।\nविवित्सुरिदमप्राक्षीन्महाभागवतोऽसुरः॥ ७/१३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.016.m4a", "display_order": 17}, {"id": 6000151017, "chapter_id": 10151, "verse_number": null, "content_sanskrit": "प्रह्लाद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.017.m4a", "display_order": 18}, {"id": 6000151018, "chapter_id": 10151, "verse_number": null, "content_sanskrit": "बिभर्षि कायं पीवानं सोद्यमो भोगवान् यथा।\nवित्तं नैवाद्य भवतो भोगो वित्तवतामिह॥ ७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.018.m4a", "display_order": 19}, {"id": 6000151019, "chapter_id": 10151, "verse_number": "७-१३-१६", "content_sanskrit": "भोगिनां खलु देहोऽयं पीवा भवति नान्यथा॥ ७/१३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.019.m4a", "display_order": 20}, {"id": 6000151020, "chapter_id": 10151, "verse_number": "७-१३-१७", "content_sanskrit": "न ते शयानस्य निरुद्यमस्य ब्रह्मन्निहार्थो यत एव भोगाः।\nअभोगिनोऽयं तव विप्र देहः पीवा यतस्तद् वद नः क्षमं चेत्॥ ७/१३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.020.m4a", "display_order": 21}, {"id": 6000151021, "chapter_id": 10151, "verse_number": "७-१३-१८", "content_sanskrit": "कविः कल्पो निपुणदृक् चित्रप्रियकथः समः।\nलोकस्य कुर्वतः कर्म शेषे न द्वेक्षि नौषि वा॥ ७/१३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.021.m4a", "display_order": 22}, {"id": 6000151022, "chapter_id": 10151, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.022.m4a", "display_order": 23}, {"id": 6000151023, "chapter_id": 10151, "verse_number": "७-१३-१९", "content_sanskrit": "स इत्थं दैत्यपतिना परिपृष्टो महामुनिः।\nस्मयमानस्तमभ्याह तद्वागमृतयन्त्रितः॥ ७/१३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.023.m4a", "display_order": 24}, {"id": 6000151024, "chapter_id": 10151, "verse_number": null, "content_sanskrit": "ब्राह्मण उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.024.m4a", "display_order": 25}, {"id": 6000151025, "chapter_id": 10151, "verse_number": "७-१३-२०", "content_sanskrit": "वेदेदमसुरश्रेष्ठ भवान् नन्वार्यसम्मतः।\nईहोपरमयोर्नॄणां पदमध्यात्मचक्षुषा॥ ७/१३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.025.m4a", "display_order": 26}, {"id": 6000151026, "chapter_id": 10151, "verse_number": "७-१३-२१", "content_sanskrit": "यस्य नारायणो देवो भगवान् हृद्गतः सदा।\nभक्त्या केवलया श्लिष्टो धुनोति ध्वान्तमर्कवत्॥ ७/१३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.026.m4a", "display_order": 27}, {"id": 6000151027, "chapter_id": 10151, "verse_number": "७-१३-२२", "content_sanskrit": "अथापि ब्रूमहे प्रश्नान् तव राजन् यथाश्रुतम्।\nसम्भाषणीयो हि भवानात्मनः शुद्धिमिच्छता॥ ७/१३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.027.m4a", "display_order": 28}, {"id": 6000151028, "chapter_id": 10151, "verse_number": "७-१३-२३", "content_sanskrit": "तृष्णया भववाहिन्या ग्राम्यकामैरपूर्णया।\nकर्माणि कार्यमाणोऽहं नानायोनिषु योजितः॥ ७/१३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.028.m4a", "display_order": 29}, {"id": 6000151029, "chapter_id": 10151, "verse_number": "७-१३-२४", "content_sanskrit": "यदृच्छया लोकमिमं प्रापितः कर्मभिर्भ्रमन्।\nस्वर्गापवर्गयोर्द्वारं तिरश्चां पुनरस्य च॥ ७/१३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.029.m4a", "display_order": 30}, {"id": 6000151030, "chapter_id": 10151, "verse_number": "७-१३-२५", "content_sanskrit": "अत्रापि दम्पतीनां च सुखायान्यापनुत्तये।\nकर्माणि कुर्वतां दृष्ट्वा निवृत्तोऽस्मि विपर्ययम्॥ ७/१३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.030.m4a", "display_order": 31}, {"id": 6000151031, "chapter_id": 10151, "verse_number": "७-१३-२६", "content_sanskrit": "सुखमस्यात्मनो रूपं सर्वेहोपरतेर्हि यत्।\nमनःसंस्पर्शजान् दृष्ट्वा भोगान् शस्तान्न संविशेत्॥ ७/१३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.031.m4a", "display_order": 32}, {"id": 6000151032, "chapter_id": 10151, "verse_number": "७-१३-२७", "content_sanskrit": "इत्येतदात्मनः स्वार्थं सन्तं विस्मृत्य वै पुमान्।\nविचित्रामसति द्वैते घोरामाप्नोति संसृतिम्॥ ७/१३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.032.m4a", "display_order": 33}, {"id": 6000151033, "chapter_id": 10151, "verse_number": "७-१३-२८", "content_sanskrit": "जलं तदुद्भवैश्छन्नं हित्वाऽज्ञो जलकाम्यया।\nमृगतृष्णामुपाधावेत् तथाऽन्यत्रार्थदृक् स्वतः॥ ७/१३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.033.m4a", "display_order": 34}, {"id": 6000151034, "chapter_id": 10151, "verse_number": "७-१३-२९", "content_sanskrit": "देहादिभिर्देवतन्त्रैरात्मनः सुखमीहतः।\nदुःखात्ययं वाऽनीशस्य क्रिया मोघाः कृताः कृताः॥ ७/१३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.034.m4a", "display_order": 35}, {"id": 6000151035, "chapter_id": 10151, "verse_number": "७-१३-३०", "content_sanskrit": "आध्यात्मिकादिभिर्दुःखैरविमुक्तस्य कर्हिचित्।\nमर्त्यस्य कृच्छ्रोपनतैरर्थैः कामैः क्रियेत किम्॥ ७/१३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.035.m4a", "display_order": 36}, {"id": 6000151036, "chapter_id": 10151, "verse_number": "७-१३-३१", "content_sanskrit": "पश्यामि धनिनां क्लेशं लुब्धानामजितात्मनाम्।\nभयादलब्धनिद्राणां सर्वतोऽपि विशङ्किनाम्॥ ७/१३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.036.m4a", "display_order": 37}, {"id": 6000151037, "chapter_id": 10151, "verse_number": "७-१३-३२", "content_sanskrit": "राजतश्चोरतः शत्रोः स्वजनात् पशुपक्षितः।\nअर्थिभ्यः कालतः स्वस्मात् नित्यं प्राणार्थवद्भयम्॥ ७/१३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.037.m4a", "display_order": 38}, {"id": 6000151038, "chapter_id": 10151, "verse_number": "७-१३-३३", "content_sanskrit": "शोकमोहभयक्रोधा रागक्लैब्यश्रमादयः।\nयन्मूलाः स्युर्नृणां जह्यात् स्पृहां प्राणार्थयोर्बुधः॥ ७/१३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.038.m4a", "display_order": 39}, {"id": 6000151039, "chapter_id": 10151, "verse_number": "७-१३-३४", "content_sanskrit": "मधुकारमहासर्पौ लोकेऽस्मिन् नो गुरूत्तमौ।\nवैराग्यं परितोषं च प्राप्ता यच्छिक्षया वयम्॥ ७/१३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.039.m4a", "display_order": 40}, {"id": 6000151040, "chapter_id": 10151, "verse_number": "७-१३-३५", "content_sanskrit": "विरागः सर्वकामेभ्यः शिक्षितो मे मधुव्रतात्।\nकृच्छ्राप्तं मधु तद्वित्तं हत्वाऽप्यन्यो हरेत् पतिम्॥ ७/१३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.040.m4a", "display_order": 41}, {"id": 6000151041, "chapter_id": 10151, "verse_number": "७-१३-३६", "content_sanskrit": "अनीहः परितुष्टात्मा यदृच्छोपनतादहम्।\nनो चेच्छये बह्वहानि महाहिरिव सत्त्ववान्॥ ७/१३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.041.m4a", "display_order": 42}, {"id": 6000151042, "chapter_id": 10151, "verse_number": "७-१३-३७", "content_sanskrit": "क्‍वचिदल्पं क्‍वचिद् भूरि भुञ्जेऽन्नं साध्वसाधु वा।\nक्वचिद् भूरिगुणोपेतं गुणहीनमुतक्‍वचित्॥ ७/१३/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.042.m4a", "display_order": 43}, {"id": 6000151043, "chapter_id": 10151, "verse_number": "७-१३-३८", "content_sanskrit": "श्रद्धयोपहृतं क्‍वाऽपि कदाचिन्मानवर्जितम्।\nभुञ्जेऽभुक्त्वाऽथ कस्मिंश्चिद् दिवा नक्तं यदृच्छया॥ ७/१३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.043.m4a", "display_order": 44}, {"id": 6000151044, "chapter_id": 10151, "verse_number": "७-१३-३९", "content_sanskrit": "क्षौमं दुकूलमजिनं चीरं वल्कलमेव वा।\nवसेऽन्यदपि सम्प्राप्तं दिष्टभुक् तुष्टधीरहम्॥ ७/१३/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.044.m4a", "display_order": 45}, {"id": 6000151045, "chapter_id": 10151, "verse_number": "७-१३-४०", "content_sanskrit": "क्‍वचिच्छये धरोपस्थे तृणपर्णाश्मभस्मसु।\nक्‍वचित् प्रासादपर्यङ्के कशिपौ वा परेच्छया॥ ७/१३/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.045.m4a", "display_order": 46}, {"id": 6000151046, "chapter_id": 10151, "verse_number": "७-१३-४१", "content_sanskrit": "क्‍वचित् स्नातोऽनुलिप्ताङ्गः सुवासाः स्रगलङ्कृतः।\nरथेभाश्वैश्चरे क्वापि दिग्वासा ग्रहवत् क्‍वचित्॥ ७/१३/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.046.m4a", "display_order": 47}, {"id": 6000151047, "chapter_id": 10151, "verse_number": "७-१३-४२", "content_sanskrit": "नाहं निन्दे च न स्तौमि स्वभावविषमं जनम्।\nएतेषां श्रेय आशासे उतैकात्म्यं महात्मनि॥ ७/१३/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.047.m4a", "display_order": 48}, {"id": 6000151048, "chapter_id": 10151, "verse_number": "७-१३-४३", "content_sanskrit": "विकल्पं जुहुयाच्चित्ते तन्मनस्यर्थविभ्रमे।\nमनो वैकारिके हुत्वा मायायां वै जुहोत्यमुम्॥ ७/१३/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.048.m4a", "display_order": 49}, {"id": 6000151049, "chapter_id": 10151, "verse_number": "७-१३-४४", "content_sanskrit": "आत्मानुभूतौ तां मायां जुहुयात् सत्यदृङ् मुनिः।\nततो निरीहो विरमेत् स्वानुभूत्याऽत्मनि स्थितः॥ ७/१३/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.049.m4a", "display_order": 50}, {"id": 6000151050, "chapter_id": 10151, "verse_number": "७-१३-४५", "content_sanskrit": "स्वात्मवृत्तं मयेत्थं ते सुगुप्तमनुवर्णितम्।\nव्यपेतं लोकशास्‍त्राभ्यां भवान् हि भगवत्प्रियः॥ ७/१३/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.050.m4a", "display_order": 51}, {"id": 6000151051, "chapter_id": 10151, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.051.m4a", "display_order": 52}, {"id": 6000151052, "chapter_id": 10151, "verse_number": "७-१३-४६", "content_sanskrit": "धर्मं पारमहंस्यं वै मुनेः श्रुत्वाऽसुरेश्वरः।\nपूजयित्वा ततः प्रीतः आमन्त्र्य प्रययौ गृहान्॥ ७/१३/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_013/BhP_07.013.052.m4a", "display_order": 53}, {"id": 6000151053, "chapter_id": 10151, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां सप्तमस्कन्धे त्रयोदशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]