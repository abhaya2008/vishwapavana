[{"id": 2074148, "chapter_id": 2565, "verse_number": "१२-७०-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2074149, "chapter_id": 2565, "verse_number": "१२-७०-१", "content_sanskrit": "क्तेन वृत्तेन वृत्तक्ष वर्तमानो महीपतिः।\nसुखेनार्यान्तुसुखोदर्कानिह च प्रेत्य चाश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2074150, "chapter_id": 2565, "verse_number": "१२-७०-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2074151, "chapter_id": 2565, "verse_number": "१२-७०-२", "content_sanskrit": "इत्थं गुणानां षट्त्रिंशी षट्त्रिंशद्गुणसंयुता।\nयान्गुणांस्तु गुणोपेतः कुर्वन्गुणमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2074152, "chapter_id": 2565, "verse_number": "१२-७०-३", "content_sanskrit": "चरेद्धर्मानकटुको मुञ्चेत्स्नेहं न चास्तिकः।\nअनृशंसश्चरेदर्थं चरेत्काममनुद्धतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2074153, "chapter_id": 2565, "verse_number": "१२-७०-४", "content_sanskrit": "प्रियं ब्रूयादकृपणः शूरः स्यादविकत्थनः।\nदाता नापात्रवर्षी स्यात्प्रगल्भः स्यादनिष्ठुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2074154, "chapter_id": 2565, "verse_number": "१२-७०-५", "content_sanskrit": "संदधीत न चानार्यैर्विगृह्णीयाच्च शत्रुभिः।\nनानाप्तैश्चारयेच्चारं कुर्यात्कार्यमपीडया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2074155, "chapter_id": 2565, "verse_number": "१२-७०-६", "content_sanskrit": "अर्थं ब्रूयान्न चासत्सु गुणान्ब्रूयान्न चात्मनः।\nआदद्यान्न च साधुभ्यो नासत्पुरुषमाश्रयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2074156, "chapter_id": 2565, "verse_number": "१२-७०-७", "content_sanskrit": "नापरीक्ष्य नयेद्दण्डं न च मन्त्रं प्रकाशयेत्।\nविसृजेन्न च लुब्धेभ्यो विश्वसेन्नापकारिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2074157, "chapter_id": 2565, "verse_number": "१२-७०-८", "content_sanskrit": "अनीर्षुर्गुप्तदारः स्याच्चोक्षः स्यादघृणी नृपः।\nस्त्रियः सेवेत नात्यर्थं मृष्टं भुञ्जीत नाहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2074158, "chapter_id": 2565, "verse_number": "१२-७०-९", "content_sanskrit": "अस्तब्धः पूजयन्मान्यान्गुरून्सेवेदमायया।\nअर्चेद्देवानदम्भेन श्रियमिच्छेदकृत्सिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2074159, "chapter_id": 2565, "verse_number": "१२-७०-१०", "content_sanskrit": "सेवेत प्रणयं हित्वा दक्षः स्यान्न त्वकालवित्।\nसान्त्वयेन्न च मोक्षाय अनुगृह्णन्न चाक्षिपेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2074160, "chapter_id": 2565, "verse_number": "१२-७०-११", "content_sanskrit": "प्रहरेन्न त्वविज्ञाय हत्वा शत्रून्न शोचयेत्।\nक्रोधं कुर्यान्न चाकस्मान्मृदुः स्यान्नापकारिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2074161, "chapter_id": 2565, "verse_number": "१२-७०-१२", "content_sanskrit": "एवं चरस्व राज्यस्थो यदि श्रेय इहेच्छसि।\nअतोऽन्यथा नरपतिर्भयमृच्छत्यनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2074162, "chapter_id": 2565, "verse_number": "१२-७०-१३", "content_sanskrit": "इति सर्वान्गुणानेतान्यथोक्तान्योऽनुवर्तते।\nअनुभूयेह भद्राणि प्रेत्य स्वर्गे महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2074163, "chapter_id": 2565, "verse_number": "१२-७०-१४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2074164, "chapter_id": 2565, "verse_number": "", "content_sanskrit": "इदं वचः शान्तनवस्य शुश्रुवा\nन्युधिष्ठिरः पार्थिवमुख्यसंवृतः।\nतदा ववन्दे च पितामहं नृपो\nयथोक्तमेतच्च चकार बुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]