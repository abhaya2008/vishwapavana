[{"id": 5000273000, "chapter_id": 9273, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे प्रथमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000273001, "chapter_id": 9273, "verse_number": "४-१-१", "content_sanskrit": "स तां पुष्करिणीं गत्वा पद्मोत्पलझषाकुलाम्।\nरामः सौमित्रिसहितो विललापाकुलेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000273002, "chapter_id": 9273, "verse_number": "४-१-२", "content_sanskrit": "तत्र दृष्ट्वैव तां हर्षादिन्द्रियाणि चकम्पिरे।\nस कामवशमापन्नः सौमित्रिमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000273003, "chapter_id": 9273, "verse_number": "४-१-३", "content_sanskrit": "सौमित्रे शोभते पम्पा वैदूर्यविमलोदका।\nफुल्लपद्मोत्पलवती शोभिता विविधैर्द्रुमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000273004, "chapter_id": 9273, "verse_number": "४-१-४", "content_sanskrit": "सौमित्रे पश्य पम्पायाः काननं शुभदर्शनम्।\nयत्र राजन्ति शैला वा द्रुमाः सशिखरा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000273005, "chapter_id": 9273, "verse_number": "४-१-५", "content_sanskrit": "मां तु शोकाभिसंतप्तमाधयः पीडयन्ति वै।\nभरतस्य च दुःखेन वैदेह्या हरणेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000273006, "chapter_id": 9273, "verse_number": "४-१-६", "content_sanskrit": "शोकार्तस्यापि मे पम्पा शोभते चित्रकानना।\nव्यवकीर्णा बहुविधैः पुष्पैः शीतोदका शिवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000273007, "chapter_id": 9273, "verse_number": "४-१-७", "content_sanskrit": "नलिनैरपि संछन्ना ह्यत्यर्थशुभदर्शना।\nसर्पव्यालानुचरिता मृगद्विजसमाकुला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000273008, "chapter_id": 9273, "verse_number": "४-१-८", "content_sanskrit": "अधिकं प्रविभात्येतन्नीलपीतं तु शाद्वलम्।\nद्रुमाणां विविधैः पुष्पैः परिस्तोमैरिवार्पितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000273009, "chapter_id": 9273, "verse_number": "४-१-९", "content_sanskrit": "पुष्पभारसमृद्धानि शिखराणि समन्ततः।\nलताभिः पुष्पिताग्राभिरुपगूढानि सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000273010, "chapter_id": 9273, "verse_number": "४-१-१०", "content_sanskrit": "सुखानिलोऽयं सौमित्रे कालः प्रचुरमन्मथः।\nगन्धवान् सुरभिर्मासो जातपुष्पफलद्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000273011, "chapter_id": 9273, "verse_number": "४-१-११", "content_sanskrit": "पश्य रूपाणि सौमित्रे वनानां पुष्पशालिनाम्।\nसृजतां पुष्पवर्षाणि वर्षं तोयमुचामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000273012, "chapter_id": 9273, "verse_number": "४-१-१२", "content_sanskrit": "प्रस्तरेषु च रम्येषु विविधाः काननद्रुमाः।\nवायुवेगप्रचलिताः पुष्पैरवकिरन्ति गाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000273013, "chapter_id": 9273, "verse_number": "४-१-१३", "content_sanskrit": "पतितैः पतमानैश्च पादपस्थैश्च मारुतः।\nकुसुमैः पश्य सौमित्रे क्रीडतीव समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000273014, "chapter_id": 9273, "verse_number": "४-१-१४", "content_sanskrit": "विक्षिपन् विविधाः शाखां नगानां कुसुमोत्कटाः।\nमारुतश्चलितस्थानैः षट्पदैरनुगीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000273015, "chapter_id": 9273, "verse_number": "४-१-१५", "content_sanskrit": "मत्तकोकिलसंनादैर्नर्तयन्निव पादपान्।\nशैलकंदर निष्क्रान्तः प्रगीत इव चानिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000273016, "chapter_id": 9273, "verse_number": "४-१-१६", "content_sanskrit": "तेन विक्षिपतात्यर्थं पवनेन समन्ततः।\nअमी संसक्तशाखाग्रा ग्रथिता इव पादपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000273017, "chapter_id": 9273, "verse_number": "४-१-१७", "content_sanskrit": "स एव सुखसंस्पर्शो वाति चन्दनशीतलः।\nगन्धमभ्यवहन् पुण्यं श्रमापनयनोऽनिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000273018, "chapter_id": 9273, "verse_number": "४-१-१८", "content_sanskrit": "अमी पवनविक्षिप्ता विनदन्तीव पादपाः।\nषट्पदैरनुकूजद्भिर्वनेषु मधुगन्धिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000273019, "chapter_id": 9273, "verse_number": "४-१-१९", "content_sanskrit": "गिरिप्रस्थेषु रम्येषु पुष्पवद्भिर्मनोरमैः।\nसंसक्तशिखराः शैला विराजन्ति महाद्रुमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000273020, "chapter_id": 9273, "verse_number": "४-१-२०", "content_sanskrit": "पुष्पसंछन्नशिखरा मारुतोत्क्षेपचञ्चलाः।\nअमी मधुकरोत्तंसाः प्रगीता इव पादपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000273021, "chapter_id": 9273, "verse_number": "४-१-२१", "content_sanskrit": "सुपुष्पितांस्तु पश्यैतान् कर्णिकारान् समन्ततः।\nहाटकप्रतिसंछन्नान् नरान् पीताम्बरानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000273022, "chapter_id": 9273, "verse_number": "४-१-२२", "content_sanskrit": "अयं वसन्तः सौमित्रे नानाविहगनादितः।\nसीतया विप्रहीणस्य शोकसंदीपनो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000273023, "chapter_id": 9273, "verse_number": "४-१-२३", "content_sanskrit": "मां हि शोकसमाक्रान्तं संतापयति मन्मथः।\nहृष्टं प्रवदमानश्च समाह्वयति कोकिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000273024, "chapter_id": 9273, "verse_number": "४-१-२४", "content_sanskrit": "एष दात्यूहको हृष्टो रम्ये मां वननिर्झरे।\nप्रणदन्मन्मथाविष्टं शोचयिष्यति लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000273025, "chapter_id": 9273, "verse_number": "४-१-२५", "content_sanskrit": "श्रुत्वैतस्य पुरा शब्दमाश्रमस्था मम प्रिया।\nमामाहूय प्रमुदिताः परमं प्रत्यनन्दत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000273026, "chapter_id": 9273, "verse_number": "४-१-२६", "content_sanskrit": "एवं विचित्राः पतगा नानारावविराविणः।\nवृक्षगुल्मलताः पश्य सम्पतन्ति समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000273027, "chapter_id": 9273, "verse_number": "४-१-२७", "content_sanskrit": "विमिश्रा विहगाः पुंभिरात्मव्यूहाभिनन्दिताः।\nभृङ्गराजप्रमुदिताः सौमित्रे मधुरस्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000273028, "chapter_id": 9273, "verse_number": "४-१-२८", "content_sanskrit": "अस्याः कूले प्रमुदिताः सङ्घशः शकुनास्त्विह।\nदात्यूहरतिविक्रन्दैः पुंस्कोकिलरुतैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000273029, "chapter_id": 9273, "verse_number": "४-१-२९", "content_sanskrit": "स्वनन्ति पादपाश्चेमे ममानङ्गप्रदीपकाः।\nअशोकस्तबकाङ्गारः षट्पदस्वननिःस्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000273030, "chapter_id": 9273, "verse_number": "४-१-३०", "content_sanskrit": "मां हि पल्लवताम्रार्चिर्वसन्ताग्निः प्रधक्ष्यति।\nनहि तां सूक्ष्मपक्ष्माक्षीं सुकेशीं मृदुभाषिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000273031, "chapter_id": 9273, "verse_number": "४-१-३१", "content_sanskrit": "अपश्यतो मे सौमित्रे जीवितेऽस्ति प्रयोजनम्।\nअयं हि रुचिरस्तस्याः कालो रुचिरकाननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000273032, "chapter_id": 9273, "verse_number": "४-१-३२", "content_sanskrit": "कोकिलाकुलसीमान्तो दयिताया ममानघ।\nमन्मथायाससम्भूतो वसन्तगुणवर्धितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000273033, "chapter_id": 9273, "verse_number": "४-१-३३", "content_sanskrit": "अयं मां धक्ष्यति क्षिप्रं शोकाग्निर्नचिरादिव।\nअपश्यतस्तां वनितां पश्यतो रुचिरान् द्रुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000273034, "chapter_id": 9273, "verse_number": "४-१-३४", "content_sanskrit": "ममायमात्मप्रभवो भूयस्त्वमुपयास्यति।\nअदृश्यमाना वैदेही शोकं वर्धयतीह मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000273035, "chapter_id": 9273, "verse_number": "४-१-३५", "content_sanskrit": "दृश्यमानो वसन्तश्च स्वेदसंसर्गदूषकः।\nमां हि सा मृगशावाक्षी चिन्ताशोकबलात्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000273036, "chapter_id": 9273, "verse_number": "४-१-३६", "content_sanskrit": "संतापयति सौमित्रे क्रूरश्चैत्रवनानिलः।\nअमी मयूराः शोभन्ते प्रनृत्यन्तस्ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000273037, "chapter_id": 9273, "verse_number": "४-१-३७", "content_sanskrit": "स्वैः पक्षैः पवनोद‍्धूतैर्गवाक्षैः स्फाटिकैरिव।\nशिखिनीभिः परिवृतास्त एते मदमूर्च्छिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000273038, "chapter_id": 9273, "verse_number": "४-१-३८", "content_sanskrit": "मन्मथाभिपरीतस्य मम मन्मथवर्धनाः।\nपश्य लक्ष्मण नृत्यन्तं मयूरमुपनृत्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000273039, "chapter_id": 9273, "verse_number": "४-१-३९", "content_sanskrit": "शिखिनी मन्मथार्तैषा भर्तारं गिरिसानुनि।\nतामेव मनसा रामां मयूरोऽप्यनुधावति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000273040, "chapter_id": 9273, "verse_number": "४-१-४०", "content_sanskrit": "वितत्य रुचिरौ पक्षौ रुतैरुपहसन्निव।\nमयूरस्य वने नूनं रक्षसा न हृता प्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000273041, "chapter_id": 9273, "verse_number": "४-१-४१", "content_sanskrit": "तस्मान्नृत्यति रम्येषु वनेषु सह कान्तया।\nमम त्वयं विना वासः पुष्पमासे सुदुःसहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000273042, "chapter_id": 9273, "verse_number": "४-१-४२", "content_sanskrit": "पश्य लक्ष्मण संरागस्तिर्यग्योनिगतेष्वपि।\nयदेषा शिखिनी कामाद् भर्तारमभिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000273043, "chapter_id": 9273, "verse_number": "४-१-४३", "content_sanskrit": "ममाप्येवं विशालाक्षी जानकी जातसम्भ्रमा।\nमदनेनाभिवर्तेत यदि नापहृता भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000273044, "chapter_id": 9273, "verse_number": "४-१-४४", "content_sanskrit": "पश्य लक्ष्मण पुष्पाणि निष्फलानि भवन्ति मे।\nपुष्पभारसमृद्धानां वनानां शिशिरात्यये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000273045, "chapter_id": 9273, "verse_number": "४-१-४५", "content_sanskrit": "रुचिराण्यपि पुष्पाणि पादपानामतिश्रिया।\nनिष्फलानि महीं यान्ति समं मधुकरोत्करैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000273046, "chapter_id": 9273, "verse_number": "४-१-४६", "content_sanskrit": "नदन्ति कामं शकुना मुदिताः सङ्घशः कलम्।\nआह्वयन्त इवान्योन्यं कामोन्मादकरा मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000273047, "chapter_id": 9273, "verse_number": "४-१-४७", "content_sanskrit": "वसन्तो यदि तत्रापि यत्र मे वसति प्रिया।\nनूनं परवशा सीता सापि शोचत्यहं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000273048, "chapter_id": 9273, "verse_number": "४-१-४८", "content_sanskrit": "नूनं न तु वसन्तस्तं देशं स्पृशति यत्र सा।\nकथं ह्यसितपद्माक्षी वर्तयेत् सा मया विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000273049, "chapter_id": 9273, "verse_number": "४-१-४९", "content_sanskrit": "अथवा वर्तते तत्र वसन्तो यत्र मे प्रिया।\nकिं करिष्यति सुश्रोणी सा तु निर्भर्त्सिता परैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000273050, "chapter_id": 9273, "verse_number": "४-१-५०", "content_sanskrit": "श्यामा पद्मपलाशाक्षी मृदुभाषा च मे प्रिया।\nनूनं वसन्तमासाद्य परित्यक्ष्यति जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000273051, "chapter_id": 9273, "verse_number": "४-१-५१", "content_sanskrit": "दृढं हि हृदये बुद्धिर्मम सम्परिवर्तते।\nनालं वर्तयितुं सीता साध्वी मद्विरहं गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000273052, "chapter_id": 9273, "verse_number": "४-१-५२", "content_sanskrit": "मयि भावो हि वैदेह्यास्तत्त्वतो विनिवेशितः।\nममापि भावः सीतायां सर्वथा विनिवेशितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000273053, "chapter_id": 9273, "verse_number": "४-१-५३", "content_sanskrit": "एष पुष्पवहो वायुः सुखस्पर्शो हिमावहः।\nतां विचिन्तयतः कान्तां पावकप्रतिमो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000273054, "chapter_id": 9273, "verse_number": "४-१-५४", "content_sanskrit": "सदा सुखमहं मन्ये यं पुरा सह सीतया।\nमारुतः स विना सीतां शोकसंजननो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000273055, "chapter_id": 9273, "verse_number": "४-१-५५", "content_sanskrit": "तां विनाथ विहङ्गोऽसौ पक्षी प्रणदितस्तदा।\nवायसः पादपगतः प्रहृष्टमभिकूजति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000273056, "chapter_id": 9273, "verse_number": "४-१-५६", "content_sanskrit": "एष वै तत्र वैदेह्या विहगः प्रतिहारकः।\nपक्षी मां तु विशालाक्ष्याः समीपमुपनेष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000273057, "chapter_id": 9273, "verse_number": "४-१-५७", "content_sanskrit": "पश्य लक्ष्मण संनादं वने मदविवर्धनम्।\nपुष्पिताग्रेषु वृक्षेषु द्विजानामवकूजताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000273058, "chapter_id": 9273, "verse_number": "४-१-५८", "content_sanskrit": "विक्षिप्तां पवनेनैतामसौ तिलकमञ्जरीम्।\nषट्पदः सहसाभ्येति मदोद‍्धूतामिव प्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000273059, "chapter_id": 9273, "verse_number": "४-१-५९", "content_sanskrit": "कामिनामयमत्यन्तमशोकः शोकवर्धनः।\nस्तबकैः पवनोत्क्षिप्तैस्तर्जयन्निव मां स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000273060, "chapter_id": 9273, "verse_number": "४-१-६०", "content_sanskrit": "अमी लक्ष्मण दृश्यन्ते चूताः कुसुमशालिनः।\nविभ्रमोत्सिक्तमनसः साङ्गरागा नरा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000273061, "chapter_id": 9273, "verse_number": "४-१-६१", "content_sanskrit": "सौमित्रे पश्य पम्पायाश्चित्रासु वनराजिषु।\nकिंनरा नरशार्दूल विचरन्ति यतस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000273062, "chapter_id": 9273, "verse_number": "४-१-६२", "content_sanskrit": "इमानि शुभगन्धीनि पश्य लक्ष्मण सर्वशः।\nनलिनानि प्रकाशन्ते जले तरुणसूर्यवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000273063, "chapter_id": 9273, "verse_number": "४-१-६३", "content_sanskrit": "एषा प्रसन्नसलिला पद्मनीलोत्पलायुता।\nहंसकारण्डवाकीर्णा पम्पा सौगन्धिकायुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000273064, "chapter_id": 9273, "verse_number": "४-१-६४", "content_sanskrit": "जले तरुणसूर्याभैः षट्पदाहतकेसरैः।\nपङ्कजैः शोभते पम्पा समन्तादभिसंवृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000273065, "chapter_id": 9273, "verse_number": "४-१-६५", "content_sanskrit": "चक्रवाकयुता नित्यं चित्रप्रस्थवनान्तरा।\nमातङ्गमृगयूथैश्च शोभते सलिलार्थिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000273066, "chapter_id": 9273, "verse_number": "४-१-६६", "content_sanskrit": "पवनाहतवेगाभिरूर्मिभिर्विमलेऽम्भसि।\nपङ्कजानि विराजन्ते ताड्यमानानि लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000273067, "chapter_id": 9273, "verse_number": "४-१-६७", "content_sanskrit": "पद्मपत्रविशालाक्षीं सततं प्रियपङ्कजाम्।\nअपश्यतो मे वैदेहीं जीवितं नाभिरोचते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000273068, "chapter_id": 9273, "verse_number": "४-१-६८", "content_sanskrit": "अहो कामस्य वामत्वं यो गतामपि दुर्लभाम्।\nस्मारयिष्यति कल्याणीं कल्याणतरवादिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000273069, "chapter_id": 9273, "verse_number": "४-१-६९", "content_sanskrit": "शक्यो धारयितुं कामो भवेदभ्यागतो मया।\nयदि भूयो वसन्तो मां न हन्यात् पुष्पितद्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000273070, "chapter_id": 9273, "verse_number": "४-१-७०", "content_sanskrit": "यानि स्म रमणीयानि तया सह भवन्ति मे।\nतान्येवारमणीयानि जायन्ते मे तया विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000273071, "chapter_id": 9273, "verse_number": "४-१-७१", "content_sanskrit": "पद्मकोशपलाशानि द्रष्टुं दृष्टिर्हि मन्यते।\nसीताया नेत्रकोशाभ्यां सदृशानीति लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 5000273072, "chapter_id": 9273, "verse_number": "४-१-७२", "content_sanskrit": "पद्मकेसरसंसृष्टो वृक्षान्तरविनिःसृतः।\nनिःश्वास इव सीताया वाति वायुर्मनोहरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 5000273073, "chapter_id": 9273, "verse_number": "४-१-७३", "content_sanskrit": "सौमित्रे पश्य पम्पाया दक्षिणे गिरिसानुषु।\nपुष्पितां कर्णिकारस्य यष्टिं परमशोभिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 5000273074, "chapter_id": 9273, "verse_number": "४-१-७४", "content_sanskrit": "अधिकं शैलराजोऽयं धातुभिस्तु विभूषितः।\nविचित्रं सृजते रेणुं वायुवेगविघट्टितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 5000273075, "chapter_id": 9273, "verse_number": "४-१-७५", "content_sanskrit": "गिरिप्रस्थास्तु सौमित्रे सर्वतः सम्प्रपुष्पितैः।\nनिष्पत्रैः सर्वतो रम्यैः प्रदीप्ता इव किंशुकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 5000273076, "chapter_id": 9273, "verse_number": "४-१-७६", "content_sanskrit": "पम्पातीररुहाश्चेमे संसिक्ता मधुगन्धिनः।\nमालतीमल्लिकापद्मकरवीराश्च पुष्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 5000273077, "chapter_id": 9273, "verse_number": "४-१-७७", "content_sanskrit": "केतक्यः सिन्दुवाराश्च वासन्त्यश्च सुपुष्पिताः।\nमाधव्यो गन्धपूर्णाश्च कुन्दगुल्माश्च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 5000273078, "chapter_id": 9273, "verse_number": "४-१-७८", "content_sanskrit": "चिरिबिल्वा मधूकाश्च वञ्जुला बकुलास्तथा।\nचम्पकास्तिलकाश्चैव नागवृक्षाश्च पुष्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 5000273079, "chapter_id": 9273, "verse_number": "४-१-७९", "content_sanskrit": "पद्मकाश्चैव शोभन्ते नीलाशोकाश्च पुष्पिताः।\nलोध्राश्च गिरिपृष्ठेषु सिंहकेसरपिञ्जराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 5000273080, "chapter_id": 9273, "verse_number": "४-१-८०", "content_sanskrit": "अङ्कोलाश्च कुरण्टाश्च चूर्णकाः पारिभद्रकाः।\nचूताः पाटलयश्चापि कोविदाराश्च पुष्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 5000273081, "chapter_id": 9273, "verse_number": "४-१-८१", "content_sanskrit": "मुचुकुन्दार्जुनाश्चैव दृश्यन्ते गिरिसानुषु।\nकेतकोद्दालकाश्चैव शिरीषाः शिंशपा धवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 5000273082, "chapter_id": 9273, "verse_number": "४-१-८२", "content_sanskrit": "शाल्मल्यः किंशुकाश्चैव रक्ताः कुरबकास्तथा।\nतिनिशा नक्तमालाश्च चन्दनाः स्यन्दनास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 5000273083, "chapter_id": 9273, "verse_number": "४-१-८३", "content_sanskrit": "हिन्तालास्तिलकाश्चैव नागवृक्षाश्च पुष्पिताः।\nपुष्पितान् पुष्पिताग्राभिर्लताभिः परिवेष्टितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 5000273084, "chapter_id": 9273, "verse_number": "४-१-८४", "content_sanskrit": "द्रुमान् पश्येह सौमित्रे पम्पाया रुचिरान् बहून्।\nवातविक्षिप्तविटपान् यथासन्नान् द्रुमानिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 5000273085, "chapter_id": 9273, "verse_number": "४-१-८५", "content_sanskrit": "लताः समनुवर्तन्ते मत्ता इव वरस्त्रियः।\nपादपात् पादपं गच्छन् शैलाच्छैलं वनाद् वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 5000273086, "chapter_id": 9273, "verse_number": "४-१-८६", "content_sanskrit": "वाति नैकरसास्वादसम्मोदित इवानिलः।\nकेचित् पर्याप्तकुसुमाः पादपा मधुगन्धिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 5000273087, "chapter_id": 9273, "verse_number": "४-१-८७", "content_sanskrit": "केचिन्मुकुलसंवीताः श्यामवर्णा इवाबभुः।\nइदं मृष्टमिदं स्वादु प्रफुल्लमिदमित्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 5000273088, "chapter_id": 9273, "verse_number": "४-१-८८", "content_sanskrit": "रागरक्तो मधुकरः कुसुमेष्वेव लीयते।\nनिलीय पुनरुत्पत्य सहसान्यत्र गच्छति।\nमधुलुब्धो मधुकरः पम्पातीरद्रुमेष्वसौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 5000273089, "chapter_id": 9273, "verse_number": "४-१-८९", "content_sanskrit": "इयं कुसुमसंघातैरुपस्तीर्णा सुखाकृता।\nस्वयं निपतितैर्भूमिः शयनप्रस्तरैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 5000273090, "chapter_id": 9273, "verse_number": "४-१-९०", "content_sanskrit": "विविधा विविधैः पुष्पैस्तैरेव नगसानुषु।\nविस्तीर्णाः पीतरक्ताभाः सौमित्रे प्रस्तराः कृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 5000273091, "chapter_id": 9273, "verse_number": "४-१-९१", "content_sanskrit": "हिमान्ते पश्य सौमित्रे वृक्षाणां पुष्पसम्भवम्।\nपुष्पमासे हि तरवः संघर्षादिव पुष्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 5000273092, "chapter_id": 9273, "verse_number": "४-१-९२", "content_sanskrit": "आह्वयन्त इवान्योन्यं नगाः षट्पदनादिताः।\nकुसुमोत्तंसविटपाः शोभन्ते बहु लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 5000273093, "chapter_id": 9273, "verse_number": "४-१-९३", "content_sanskrit": "एष कारण्डवः पक्षी विगाह्य सलिलं शुभम्।\nरमते कान्तया सार्धं काममुद्दीपयन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 5000273094, "chapter_id": 9273, "verse_number": "४-१-९४", "content_sanskrit": "मन्दाकिन्यास्तु यदिदं रूपमेतन्मनोरमम्।\nस्थाने जगति विख्याता गुणास्तस्या मनोरमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 5000273095, "chapter_id": 9273, "verse_number": "४-१-९५", "content_sanskrit": "यदि दृश्येत सा साध्वी यदि चेह वसेमहि।\nस्पृहयेयं न शक्राय नायोध्यायै रघूत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 5000273096, "chapter_id": 9273, "verse_number": "४-१-९६", "content_sanskrit": "न ह्येवं रमणीयेषु शाद्वलेषु तया सह।\nरमतो मे भवेच्चिन्ता न स्पृहान्येषु वा भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 5000273097, "chapter_id": 9273, "verse_number": "४-१-९७", "content_sanskrit": "अमी हि विविधैः पुष्पैस्तरवो विविधच्छदाः।\nकाननेऽस्मिन् विना कान्तां चिन्तामुत्पादयन्ति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 5000273098, "chapter_id": 9273, "verse_number": "४-१-९८", "content_sanskrit": "पश्य शीतजलां चेमां सौमित्रे पुष्करायुताम्।\nचक्रवाकानुचरितां कारण्डवनिषेविताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 5000273099, "chapter_id": 9273, "verse_number": "४-१-९९", "content_sanskrit": "प्लवैः क्रौञ्चैश्च सम्पूर्णां महामृगनिषेविताम्।\nअधिकं शोभते पम्पा विकूजद्भिर्विहंगमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 5000273100, "chapter_id": 9273, "verse_number": "४-१-१००", "content_sanskrit": "दीपयन्तीव मे कामं विविधा मुदिता द्विजाः।\nश्यामां चन्द्रमुखीं स्मृत्वा प्रियां पद्मनिभेक्षणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 5000273101, "chapter_id": 9273, "verse_number": "४-१-१०१", "content_sanskrit": "पश्य सानुषु चित्रेषु मृगीभिः सहितान् मृगान्।\nमां पुनर्मृगशावाक्ष्या वैदेह्या विरहीकृतम्।\nव्यथयन्तीव मे चित्तं संचरन्तस्ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 5000273102, "chapter_id": 9273, "verse_number": "४-१-१०२", "content_sanskrit": "अस्मिन् सानुनि रम्ये हि मत्तद्विजगणाकुले।\nपश्येयं यदि तां कान्तां ततः स्वस्ति भवेन्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 5000273103, "chapter_id": 9273, "verse_number": "४-१-१०३", "content_sanskrit": "जीवेयं खलु सौमित्रे मया सह सुमध्यमा।\nसेवेत यदि वैदेही पम्पायाः पवनं शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 5000273104, "chapter_id": 9273, "verse_number": "४-१-१०४", "content_sanskrit": "पद्मसौगन्धिकवहं शिवं शोकविनाशनम्।\nधन्या लक्ष्मण सेवन्ते पम्पाया वनमारुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 5000273105, "chapter_id": 9273, "verse_number": "४-१-१०५", "content_sanskrit": "श्यामा पद्मपलाशाक्षी प्रिया विरहिता मया।\nकथं धारयति प्राणान् विवशा जनकात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 5000273106, "chapter_id": 9273, "verse_number": "४-१-१०६", "content_sanskrit": "किं नु वक्ष्यामि धर्मज्ञं राजानं सत्यवादिनम्।\nजनकं पृष्टसीतं तं कुशलं जनसंसदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 5000273107, "chapter_id": 9273, "verse_number": "४-१-१०७", "content_sanskrit": "या मामनुगता मन्दं पित्रा प्रस्थापितं वनम्।\nसीता धर्मं समास्थाय क्व नु सा वर्तते प्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 5000273108, "chapter_id": 9273, "verse_number": "४-१-१०८", "content_sanskrit": "तया विहीनः कृपणः कथं लक्ष्मण धारये।\nया मामनुगता राज्याद् भ्रष्टं विहतचेतसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 5000273109, "chapter_id": 9273, "verse_number": "४-१-१०९", "content_sanskrit": "तच्चार्वाञ्चितपद्माक्षं सुगन्धि शुभमव्रणम्।\nअपश्यतो मुखं तस्याः सीदतीव मतिर्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 5000273110, "chapter_id": 9273, "verse_number": "४-१-११०", "content_sanskrit": "स्मितहास्यान्तरयुतं गुणवन्मधुरं हितम्।\nवैदेह्या वाक्यमतुलं कदा श्रोष्यामि लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 5000273111, "chapter_id": 9273, "verse_number": "४-१-१११", "content_sanskrit": "प्राप्य दुःखं वने श्यामा मां मन्मथविकर्शितम्।\nनष्टदुःखेव हृष्टेव साध्वी साध्वभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 5000273112, "chapter_id": 9273, "verse_number": "४-१-११२", "content_sanskrit": "किं नु वक्ष्याम्ययोध्यायां कौसल्यां हि नृपात्मज।\nक्व सा स्नुषेति पृच्छन्तीं कथं चापि मनस्विनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 5000273113, "chapter_id": 9273, "verse_number": "४-१-११३", "content_sanskrit": "गच्छ लक्ष्मण पश्य त्वं भरतं भ्रातृवत्सलम्।\nनह्यहं जीवितुं शक्तस्तामृते जनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 5000273114, "chapter_id": 9273, "verse_number": "४-१-११४", "content_sanskrit": "इति रामं महात्मानं विलपन्तमनाथवत्।\nउवाच लक्ष्मणो भ्राता वचनं युक्तमव्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 5000273115, "chapter_id": 9273, "verse_number": "४-१-११५", "content_sanskrit": "संस्तम्भ राम भद्रं ते मा शुचः पुरुषोत्तम।\nनेदृशानां मतिर्मन्दा भवत्यकलुषात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 5000273116, "chapter_id": 9273, "verse_number": "४-१-११६", "content_sanskrit": "स्मृत्वा वियोगजं दुःखं त्यज स्नेहं प्रिये जने।\nअतिस्नेहपरिष्वङ्गाद् वर्तिरार्द्रापि दह्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 5000273117, "chapter_id": 9273, "verse_number": "४-१-११७", "content_sanskrit": "यदि गच्छति पातालं ततोऽभ्यधिकमेव वा।\nसर्वथा रावणस्तात न भविष्यति राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 5000273118, "chapter_id": 9273, "verse_number": "४-१-११८", "content_sanskrit": "प्रवृत्तिर्लभ्यतां तावत् तस्य पापस्य रक्षसः।\nततो हास्यति वा सीतां निधनं वा गमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 5000273119, "chapter_id": 9273, "verse_number": "४-१-११९", "content_sanskrit": "यदि याति दितेर्गर्भं रावणं सह सीतया।\nतत्राप्येनं हनिष्यामि न चेद् दास्यति मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 5000273120, "chapter_id": 9273, "verse_number": "४-१-१२०", "content_sanskrit": "स्वास्थ्यं भद्रं भजस्वार्य त्यज्यतां कृपणा मतिः।\nअर्थो हि नष्टकार्यार्थैरयत्नेनाधिगम्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 5000273121, "chapter_id": 9273, "verse_number": "४-१-१२१", "content_sanskrit": "उत्साहो बलवानार्य नास्त्युत्साहात् परं बलम्।\nसोत्साहस्य हि लोकेषु न किंचिदपि दुर्लभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 5000273122, "chapter_id": 9273, "verse_number": "४-१-१२२", "content_sanskrit": "उत्साहवन्तः पुरुषा नावसीदन्ति कर्मसु।\nउत्साहमात्रमाश्रित्य प्रतिलप्स्याम जानकीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 5000273123, "chapter_id": 9273, "verse_number": "४-१-१२३", "content_sanskrit": "त्यजतां कामवृत्तत्वं शोकं संन्यस्य पृष्ठतः।\nमहात्मानं कृतात्मानमात्मानं नावबुध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 5000273124, "chapter_id": 9273, "verse_number": "४-१-१२४", "content_sanskrit": "एवं सम्बोधितस्तेन शोकोपहतचेतनः।\nत्यज्य शोकं च मोहं च रामो धैर्यमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 5000273125, "chapter_id": 9273, "verse_number": "४-१-१२५", "content_sanskrit": "सोऽभ्यतिक्रामदव्यग्रस्तामचिन्त्यपराक्रमः।\nरामः पम्पां सुरुचिरां रम्यां पारिप्लवद्रुमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 5000273126, "chapter_id": 9273, "verse_number": "४-१-१२६", "content_sanskrit": "निरीक्षमाणः सहसा महात्मा\nसर्वं वनं निर्झरकन्दरं च।\nउद्विग्नचेताः सह लक्ष्मणेन\nविचार्य दुःखोपहतः प्रतस्थे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 5000273127, "chapter_id": 9273, "verse_number": "४-१-१२७", "content_sanskrit": "तं मत्तमातङ्गविलासगामी\nगच्छन्तमव्यग्रमना महात्मा।\nस लक्ष्मणो राघवमिष्टचेष्टो\nररक्ष धर्मेण बलेन चैव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 5000273128, "chapter_id": 9273, "verse_number": "४-१-१२८", "content_sanskrit": "तावृष्यमूकस्य समीपचारी\nचरन् ददर्शाद्भुतदर्शनीयौ।\nशाखामृगाणामधिपस्तरस्वी\nवितत्रसे नैव विचेष्ट चेष्टाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 5000273129, "chapter_id": 9273, "verse_number": "४-१-१२९", "content_sanskrit": "स तौ महात्मा गजमन्दगामी\nशाखामृगस्तत्र चरंश्चरन्तौ।\nदृष्ट्वा विषादं परमं जगाम\nचिन्तापरीतो भयभारभग्नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 5000273130, "chapter_id": 9273, "verse_number": "४-१-१३०", "content_sanskrit": "तमाश्रमं पुण्यसुखं शरण्यं\nसदैव शाखामृगसेवितान्तम्।\nत्रस्ताश्च दृष्ट्वा हरयोऽभिजग्मु-\nर्महौजसौ राघवलक्ष्मणौ तौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 5000273131, "chapter_id": 9273, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे प्रथमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}]