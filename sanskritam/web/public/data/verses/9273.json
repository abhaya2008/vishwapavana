[{"id": 40017883, "chapter_id": 9273, "verse_number": "1", "content_sanskrit": "त्तस्यतद्वचनंश्रुत्वाराघवश्शोककर्शितः । नोपधारयतेव्यक्तंयदुक्तंतेनरक्षसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40017884, "chapter_id": 9273, "verse_number": "2", "content_sanskrit": "ततोधैर्यमवष्टभ्यरामःपरपुरञ्जयः । विभीषणमुपासीनमुवाचकपिसन्निधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40017885, "chapter_id": 9273, "verse_number": "3", "content_sanskrit": "नैरृताधिपतेवाक्यंयदुक्तंतेविभीषण । भूयस्तच्छ्रोतुमिच्छामिब्रूहियत्तेविवक्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40017886, "chapter_id": 9273, "verse_number": "4", "content_sanskrit": "राघवस्यवचःश्रुत्वावाक्यंवाक्यविशारद. । यत्तत्पुनरिदंवाक्यंबभाषे स विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40017887, "chapter_id": 9273, "verse_number": "5", "content_sanskrit": "यथाज्ञप्तंमहाबाहोत्वयागुल्मनिवेशनम् । तत्तथाऽनुष्ठितंवीरत्वद्वाक्यसमनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40017888, "chapter_id": 9273, "verse_number": "6", "content_sanskrit": "तान्यनीकानिसर्वाणिविभग्नानिसमन्ततः । विन्यस्तायूथपाश्चैवयथान्यायंविभागशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40017889, "chapter_id": 9273, "verse_number": "7", "content_sanskrit": "भूयस्तुममविज्ञाप्यंतच्छ्रुणुष्वमहायश: । त्वय्यकारणसन्तप्तेसन्तप्तहृदयावयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40017890, "chapter_id": 9273, "verse_number": "8", "content_sanskrit": "त्यजराजन्निमंशोकंमिथ्यासन्तापमागतम् । तदियंत्यज्यतांचिन्ताशत्रुहर्षविवर्धिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40017891, "chapter_id": 9273, "verse_number": "9", "content_sanskrit": "उद्यमःक्रियतांवीरहर्षःसमुपसेव्यताम् । प्राप्तव्यायदितेसीताहन्तव्याश्चनिशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40017892, "chapter_id": 9273, "verse_number": "10", "content_sanskrit": "रघुनन्दनवक्ष्यामिश्रूयतांमेहितंवचः । साध्वयंयातुसौमित्रिर्बलेनमहतावृतः ॥ निकुम्भिलायांसम्प्राप्यहन्तुंरावणिमाहवे । धनुर्मण्डलनिर्मुक्तैराशीविषविषोपमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40017893, "chapter_id": 9273, "verse_number": "11", "content_sanskrit": "रघुनन्दनवक्ष्यामिश्रूयतांमेहितंवचः । साध्वयंयातुसौमित्रिर्बलेनमहतावृतः ॥ निकुम्भिलायांसम्प्राप्यहन्तुंरावणिमाहवे । धनुर्मण्डलनिर्मुक्तैराशीविषविषोपमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40017894, "chapter_id": 9273, "verse_number": "12", "content_sanskrit": "तेनवीरेणतपसावरदानात्स्वयम्भुवः । अस्त्रंब्रह्मशिरःप्राप्तंकामगाश्चतुरङ्गमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40017895, "chapter_id": 9273, "verse_number": "13", "content_sanskrit": "स एषसहसैन्येनप्राप्तःकिलनिकुम्भिलाम् । यद्युततिष्ठेत्कृतंकर्महतान्सर्वांश्चविद्धिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40017896, "chapter_id": 9273, "verse_number": "14", "content_sanskrit": "निकुम्भिलामसम्प्राप्तमहुताग्निं च योरिपुः । त्वामातायिनंहन्यादिन्द्रशत्रोस्सतेवधः ॥ वरोदत्तोमहाबाहो सर्वलोकेश्वरेणवै । इत्येवंविहितोराजन्वधस्तस्यैषधीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40017897, "chapter_id": 9273, "verse_number": "15", "content_sanskrit": "निकुम्भिलामसम्प्राप्तमहुताग्निं च योरिपुः । त्वामातायिनंहन्यादिन्द्रशत्रोस्सतेवधः ॥ वरोदत्तोमहाबाहो सर्वलोकेश्वरेणवै । इत्येवंविहितोराजन्वधस्तस्यैषधीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40017898, "chapter_id": 9273, "verse_number": "16", "content_sanskrit": "वधायेन्द्रजितोरामसन्दिशस्वमहाबल । हतेतस्मिन्हतंविद्धिरावणंससुहृज्जनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40017899, "chapter_id": 9273, "verse_number": "17", "content_sanskrit": "विभीषणवच्श्रुत्वारामोवाक्यमथाब्रवीत् । जानामितस्यरौद्रस्यमायांसत्यपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40017900, "chapter_id": 9273, "verse_number": "18", "content_sanskrit": "स हिब्रह्मास्त्रवित्प्राज्ञोमहामायोमहाबल. । करोत्यसंज्ञान् सङ्ग्रामेदेवान्सवरुणानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40017901, "chapter_id": 9273, "verse_number": "19", "content_sanskrit": "तस्यान्तरिक्षेचरतःसरथस्यमहायशः । न गतिर्ज्ञायतेवीरसूर्यस्येवाभ्रसम्ल्पवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40017902, "chapter_id": 9273, "verse_number": "20", "content_sanskrit": "राघवस्तुरिपोर्ज्ञात्वामायावीर्यंदुरात्मनः । लक्ष्मणंकीर्तिसम्पन्नमिदंवचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40017903, "chapter_id": 9273, "verse_number": "21", "content_sanskrit": "यद्वानरेन्द्रस्यबलंतेनसर्वेणसम्वृतः । हनूमत्प्रमुखैश्चवयूथपैस्सहलक्ष्मण ॥ जाम्बवेनार्क्षपतिनासहसैन्येनसम्वृतः । जहितंराक्षससुतंमायाबलविशारदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40017904, "chapter_id": 9273, "verse_number": "22", "content_sanskrit": "यद्वानरेन्द्रस्यबलंतेनसर्वेणसम्वृतः । हनूमत्प्रमुखैश्चवयूथपैस्सहलक्ष्मण ॥ जाम्बवेनार्क्षपतिनासहसैन्येनसम्वृतः । जहितंराक्षससुतंमायाबलविशारदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40017905, "chapter_id": 9273, "verse_number": "23", "content_sanskrit": "अयंत्वांसचिवैःसार्थंमहात्मारजनीचरः । अभिज्ञस्तस्यमायानांपृष्ठतोऽनुगमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40017906, "chapter_id": 9273, "verse_number": "24", "content_sanskrit": "राघवस्यवच्श्रुत्वालक्ष्मणस्सविभीषणः । जग्राहकार्मुकश्रेष्ठमत्यद्भुतपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40017907, "chapter_id": 9273, "verse_number": "25", "content_sanskrit": "सन्नद्धःकवचीखङ्गीसशरोवामचापभृत् । रामपादावुपस्पृश्यहृष्टःसौमित्रिरब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40017908, "chapter_id": 9273, "verse_number": "26", "content_sanskrit": "अद्यमत्कार्मुकोन्मुक्ताश्शरानिर्भिद्यरावणिम् । लङ्कामभितिष्यन्तिहंसाःपुष्करिणीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40017909, "chapter_id": 9273, "verse_number": "27", "content_sanskrit": "अद्यैवतस्यरौद्रस्यशरीरंमामकाश्शराः । विधमिष्यन्तिभित्त्वातंमहाचापगुणच्युताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40017910, "chapter_id": 9273, "verse_number": "28", "content_sanskrit": "एवमुक्त्वा स द्युतिमान् वचनंभ्रातुरग्रतः । स रावणिवधाकाङ्क्षीलक्ष्मणस्त्वरितोययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40017911, "chapter_id": 9273, "verse_number": "29", "content_sanskrit": "सोऽभिवाद्यगुरोःपादौकृत्वाचापिप्रदक्षिणम् । निकुम्भिलामभिययौचैत्यंरावणिपालितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40017912, "chapter_id": 9273, "verse_number": "30", "content_sanskrit": "विभीषणेनसहितोराजपुत्रःप्रतापवान् । कृतस्वस्त्ययनोभ्रात्रालक्ष्मणस्त्वरितोययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40017913, "chapter_id": 9273, "verse_number": "31", "content_sanskrit": "वानराणांसहस्रैस्तुहनूमान् बहुभिर्वृतः । विभीषणश्चसामात्योतदालक्ष्मणमन्वगात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40017914, "chapter_id": 9273, "verse_number": "32", "content_sanskrit": "महताहरिसैन्येनसवेगमभिसंवृतः । ऋक्षराजबलंचैवददर्शपथिविष्ठितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40017915, "chapter_id": 9273, "verse_number": "33", "content_sanskrit": "स गत्वादूरमध्वानंसौमित्रिर्मित्रनन्दनः । राक्षसेन्द्रबलंदूरादपश्यद्व्यूहमाश्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40017916, "chapter_id": 9273, "verse_number": "34", "content_sanskrit": "स तंप्राप्यधनुष्पाणिर्मायायोगमरिन्दमः । तस्थौब्रह्मविधानेनविजेतुंरघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40017917, "chapter_id": 9273, "verse_number": "35", "content_sanskrit": "भीषणेनसहितोराजपुत्रःप्रतापवान् । अङ्गदेन च वीरेणतथानिलसुतेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]