[{"id": 7001937000, "chapter_id": 21937, "verse_number": "११६-१", "content_sanskrit": "विविंशचरितवर्णनम् ।\nमार्कण्डेय उवाच ।\nक्षुपः खनित्रपुत्रस्तु प्राप्य राज्यं यथा पिता ।\nतथैव पालयामास प्रजाधर्मेण रञ्जयन् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001937001, "chapter_id": 21937, "verse_number": "११६-२", "content_sanskrit": "स दानशीलो यष्टा च यज्ञानामवनीपतिः ।\nसमः शत्रौ च मित्रे च व्यवहारादिवर्त्मनि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001937002, "chapter_id": 21937, "verse_number": "११६-३", "content_sanskrit": "एकदा स महीपालो निजस्थानगतो मुने ।\nसूतैरुक्तो यथा पूर्वं क्षुपो राजा तथाऽभवत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001937003, "chapter_id": 21937, "verse_number": "११६-४", "content_sanskrit": "ब्रह्मणस्तनयः पूर्वं क्षुपोऽभूत्पृथिवीपतिः ।\nयादृक्चरितमस्यासीत्तादृक्तस्यैव चेष्टितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001937004, "chapter_id": 21937, "verse_number": "११६-५", "content_sanskrit": "राजोवाच ।\nश्रोतुमिच्छामि चरितं क्षुपस्य सुमहात्मनः ।\nयदि तादृङ्मया शक्यं चेष्टितुं तत्करोम्यहम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001937005, "chapter_id": 21937, "verse_number": "११६-६", "content_sanskrit": "सूता ऊचुः ।\nस चकाराकरान्भूप राजा गोब्राह्मणान्पुरा ।\nषष्ठांशेन कृता चोर्व्यामिष्टिस्तेन महात्मना ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001937006, "chapter_id": 21937, "verse_number": "११६-७", "content_sanskrit": "राजोवाच ।\nतेषां महात्मनां राज्ञां कोऽनुयास्यति मद्विधः ।\nतथाप्युत्कृष्टचेतानां चेष्टासूद्यमवान्भवेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001937007, "chapter_id": 21937, "verse_number": "११६-८", "content_sanskrit": "तच्छ्रूयतां प्रतिज्ञा या साम्प्रतं क्रियते मया ।\nक्षुपस्यानुकरिष्यामि महाराजस्य चेष्टितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001937008, "chapter_id": 21937, "verse_number": "११६-९", "content_sanskrit": "त्रींस्त्रीन्यज्ञान्करिष्यामि सस्यापाते गतागते ।\nपृथिव्यां चतुरन्तायां प्रतिज्ञेयं कृता मया ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001937009, "chapter_id": 21937, "verse_number": "११६-१०", "content_sanskrit": "यच्च गोब्राह्मणाः पूर्वमददन्भूभृते करम् ।\nतमेव प्रतिदास्यामि ब्राह्मणानां तथा गवाम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001937010, "chapter_id": 21937, "verse_number": "११६-११", "content_sanskrit": "मार्कण्डेय उवाच ।\nइति प्रतिज्ञाय वचः क्षुपस्तत्कृतवांस्तथा ।\nसस्यापाते स यज्ञांस्त्रीनयजद्यजतांवरः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001937011, "chapter_id": 21937, "verse_number": "११६-१२", "content_sanskrit": "गोब्राह्मणाः पुरा राज्ञामददद्यं च वै करम् ।\nतावत्संख्यमदाद्वित्तमन्यद्गोब्राह्मणाय सः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001937012, "chapter_id": 21937, "verse_number": "११६-१३", "content_sanskrit": "तस्य पुत्रोऽभवद्वीरः प्रमथायामनिन्दितः ।\nयस्य प्रतापशौर्याभ्यां कृता वश्या महीभृतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001937013, "chapter_id": 21937, "verse_number": "११६-१४", "content_sanskrit": "तस्यापि नन्दिनी नाम वैदर्भी दयिताऽभवत् ।\nविविंशं तनयं तस्यां जनयामास स प्रभुः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001937014, "chapter_id": 21937, "verse_number": "११६-१५", "content_sanskrit": "विविंशे शासति महीं महीपाले महौजसि ।\nमहीतलमभूद्व्याप्तं निरन्तरतया नरैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001937015, "chapter_id": 21937, "verse_number": "११६-१६", "content_sanskrit": "ववर्ष काले पर्जन्यो मही सस्यवती तथा ।\nसुफलानि च सस्यानि रसवन्ति फलानि च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001937016, "chapter_id": 21937, "verse_number": "११६-१७", "content_sanskrit": "रसाः पुष्टिकराश्चासन्पुष्टिर्नोन्मादकारिणी ।\nन वित्तनिचया नॄणां प्रभूतां मदहेतवः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001937017, "chapter_id": 21937, "verse_number": "११६-१८", "content_sanskrit": "तत्प्रतापेन रिपवो भयमापुर्महामुने ।\nस्वास्थ्यं जनः सुहृद्वर्गो मुदमाप सुपूजितः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001937018, "chapter_id": 21937, "verse_number": "११६-१९", "content_sanskrit": "इष्ट्वा स यज्ञान्सुबहून्सम्यक्सम्पाल्य मेदिनीम् ।\nसङ्ग्रामे निधनं प्राप्य शक्रलोकमितो गतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]