[{"id": 7006240000, "chapter_id": 26240, "verse_number": "२-६८-१", "content_sanskrit": "ऋषय ऊचुः मरुतेन कथं कन्या राज्ञे दत्ता महात्मना ।\nकिंवीर्याश्च महात्मानो जाता मरुतकन्यया ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006240001, "chapter_id": 26240, "verse_number": "२-६८-२", "content_sanskrit": "सूत उवाच आहरत्स मरुत्सोममन्नकामः प्रजेश्वरः ।\nमासिमासि महातेजाः षष्टिसंवत्सरान्नृप ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006240002, "chapter_id": 26240, "verse_number": "२-६८-३", "content_sanskrit": "तेन ते मरुतस्तस्य मरुत्सोमेन तोषिताः ।\nअक्षय्यान्नं ददुः प्रीताः सर्वकामपरिच्छदम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006240003, "chapter_id": 26240, "verse_number": "२-६८-४", "content_sanskrit": "अन्नं तस्य सकृद्भुक्तमहोरात्रं न क्षीयते ।\nकोटिशो दीय मानं च सूर्यस्योदयनादपि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006240004, "chapter_id": 26240, "verse_number": "२-६८-५", "content_sanskrit": "मित्रज्योतेस्तु कन्याया मरितस्य च धीमतः ।\nतस्माज्जाता महासत्त्वा धर्मज्ञा मोक्षदर्शिनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006240005, "chapter_id": 26240, "verse_number": "२-६८-६", "content_sanskrit": "संन्यस्य गृहधर्माणि वैराग्यं समुपस्थिताः ।\nयतिधर्ममवाप्येह ब्रह्मभूयाय ते गताः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006240006, "chapter_id": 26240, "verse_number": "२-६८-७", "content_sanskrit": "अनेनसः सुतो जातः क्षत्रधर्मः प्रतापवान् ।\nक्षत्रधर्मसुतो जातः प्रतिपक्षो महातपाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006240007, "chapter_id": 26240, "verse_number": "२-६८-८", "content_sanskrit": "प्रतिपक्षसुतश्चापि सृंजयो नाम विश्रुतः ।\nसृंजयस्य जयः पुत्रो विजयस्तस्य जज्ञिवान् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006240008, "chapter_id": 26240, "verse_number": "२-६८-९", "content_sanskrit": "विजयस्य जयः पुत्रस्तस्य हर्यश्वकः स्मृतः ।\nइर्यश्वस्य सुतो राजा सहदेवः प्रतापवान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006240009, "chapter_id": 26240, "verse_number": "२-६८-१०", "content_sanskrit": "सहदेवस्य धर्मात्मा अहीन इति विश्रुतः ।\nअहीनस्य चयत्सेनस्तस्य पुत्रोऽथ संकृतिः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006240010, "chapter_id": 26240, "verse_number": "२-६८-११", "content_sanskrit": "संकृतेरपि धर्मात्मा कृतधर्मा महायशाः ।\nइत्येते क्षत्रधर्माणो नहुषस्य निबोधत ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006240011, "chapter_id": 26240, "verse_number": "२-६८-१२", "content_sanskrit": "नहुषस्य तु दायादाः षडिन्द्रोपमतेजसः ।\nयतिर्ययातिः संयातिरायतिर्वियतिः कृतिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006240012, "chapter_id": 26240, "verse_number": "२-६८-१३", "content_sanskrit": "यतिर्ज्येष्ठस्तु तेषां वै ययातिस्तु ततोऽवरः ।\nकाकुत्स्थकन्यां गां नाम लेभे पत्नीं यतिस्तदा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006240013, "chapter_id": 26240, "verse_number": "२-६८-१४", "content_sanskrit": "स यतिर्मोक्षमास्थाय ब्रह्मभूतोऽभवन्मुनिः ।\nतेषां मध्ये तु पञ्चानां ययातिः पृथिवीपतिः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006240014, "chapter_id": 26240, "verse_number": "२-६८-१५", "content_sanskrit": "देवयानीमुशनसः सुतां भार्यामवाप ह ।\nशर्मिष्ठामासुरीं चैव तनयां वृषपर्वणः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006240015, "chapter_id": 26240, "verse_number": "२-६८-१६", "content_sanskrit": "यदुं च तुर्वसुं चैव देवयानो व्यजायत ।\nद्रुह्युं चानुं च पूरुं च शर्मिष्ठा वार्षपर्वणी ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006240016, "chapter_id": 26240, "verse_number": "२-६८-१७", "content_sanskrit": "अजीजनन्महावीर्यान्सुतान्देवसुतोपमान् ।\nरथं तस्मै ददौ शक्रः प्रीतः परमभास्वरम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006240017, "chapter_id": 26240, "verse_number": "२-६८-१८", "content_sanskrit": "असंगं काञ्चनं दिव्यमक्षयौ च महेषुधी ।\nयुक्तं मनोजवैरश्वैर्येन कन्यां समुद्वहत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006240018, "chapter_id": 26240, "verse_number": "२-६८-१९", "content_sanskrit": "स तेन रथमुख्येन जिगाय सततं महीम् ।\nययातिर्युधि दुर्द्धर्षो देवदानवमानवैः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006240019, "chapter_id": 26240, "verse_number": "२-६८-२०", "content_sanskrit": "पौरवाणां नृपाणां च सर्वेषां सोऽभवद्रथी ।\nयावत्सुदेशप्रभवः कौरवो जनमेजयः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006240020, "chapter_id": 26240, "verse_number": "२-६८-२१", "content_sanskrit": "कुरोः पौत्रस्य राज्ञरतु राज्ञः पारीक्षितस्य ह ।\nजगाम सरथो नाशं शापाद्गार्ग्यस्य धीमतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006240021, "chapter_id": 26240, "verse_number": "२-६८-२२", "content_sanskrit": "गार्ग्यस्य हि सुतं बालं स राजा जनमेजयः ।\nदुर्बुद्धिर्हिंसया मास लोहगन्धी नराधिपः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006240022, "chapter_id": 26240, "verse_number": "२-६८-२३", "content_sanskrit": "स लोहगन्धी राजर्षिः परिधावन्नितस्ततः ।\nपौरजानपदैस्त्यक्तो न लेभे शर्म कर्हिचित् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006240023, "chapter_id": 26240, "verse_number": "२-६८-२४", "content_sanskrit": "ततः स दुःखसंतप्तो नालभत्संविदं क्वचित ।\nस प्रायाच्छौनकमृषिं शरणं व्यथितस्तदा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006240024, "chapter_id": 26240, "verse_number": "२-६८-२५", "content_sanskrit": "इन्द्रोतोनाम विख्यातो योऽसौ मुनि रुदारधीः ।\nयोजयामास चैन्द्रोतः शौनको जनमेजयम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006240025, "chapter_id": 26240, "verse_number": "२-६८-२६", "content_sanskrit": "अश्वमेधेन राजानं पावनार्थं द्विजोत्तमाः ।\nस लोहगन्धो व्यनशत्त स्यावभृथमेत्य ह ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006240026, "chapter_id": 26240, "verse_number": "२-६८-२७", "content_sanskrit": "स वै दिव्यो रथस्तस्माद्वसोश्चेदिपतेस्तथा ।\nदत्तः शक्रेन तुष्टेन लेभे तस्माद्बृहद्रथः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006240027, "chapter_id": 26240, "verse_number": "२-६८-२८", "content_sanskrit": "ततो हत्वा जरासंधं भीमस्तं रथमुत्तमम् ।\nप्रददौ वासुदेवाय प्रीत्या कौरवनन्दनः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006240028, "chapter_id": 26240, "verse_number": "२-६८-२९", "content_sanskrit": "स जरां प्राप्य राजर्षिर्ययातिर्नहुषात्मजः ।\nपुत्रं श्रेष्टं वरिष्ठं च यदुमित्यब्रवीद्वचः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006240029, "chapter_id": 26240, "verse_number": "२-६८-३०", "content_sanskrit": "जरावली च मां तात पलितानि च पर्ययुः ।\nकाव्यस्योशनसः शापान्न च तृप्तोऽस्मि यौवने ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006240030, "chapter_id": 26240, "verse_number": "२-६८-३१", "content_sanskrit": "त्वं यदो प्रतिपद्यस्व पाप्मानं जरया सह ।\nजरां मे प्रतिगृह्णीष्व तं यदुः प्रत्युवाच ह ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006240031, "chapter_id": 26240, "verse_number": "२-६८-३२", "content_sanskrit": "अनिर्दिष्टा हि मे भिक्षा ब्राह्मणस्य प्रतिश्रुता ।\nसा तु व्यायामसाध्या वै न ग्रहीष्यामि ते जराम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006240032, "chapter_id": 26240, "verse_number": "२-६८-३३", "content_sanskrit": "जरायां बहवो दोषाः पानभोजनकारिताः ।\nतस्माज्जरां न ते राजन्ग्रहीतुमहमुत्सहे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006240033, "chapter_id": 26240, "verse_number": "२-६८-३४", "content_sanskrit": "सितश्मश्रुधरो दीनो जरया शिथिलीकृतः ।\nवलीसंततगात्रश्च निराशो दुर्बलाकृतिः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006240034, "chapter_id": 26240, "verse_number": "२-६८-३५", "content_sanskrit": "अशक्तः कार्यकरणे परिबूतस्तु यौवने ।\nसहोपवीतिभिश्चैव तां जरां नाभिकामये ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006240035, "chapter_id": 26240, "verse_number": "२-६८-३६", "content_sanskrit": "संति ते बहवः पुत्रा मत्तः प्रियतरा नृप ।\nप्रतिगृह्णन्तु धर्मज्ञ पुत्रमन्यं वृणीष्व वै ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006240036, "chapter_id": 26240, "verse_number": "२-६८-३७", "content_sanskrit": "स एवमुक्तो यदुना दीव्रकोपसमन्वितः ।\nउवाच वदतां श्रेष्टो ज्येष्ठं तं गर्हयन्सुतम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006240037, "chapter_id": 26240, "verse_number": "२-६८-३८", "content_sanskrit": "आश्रमः कस्तवान्योऽस्ति को वा धर्मविधिस्तव ।\nमामनादृत्य दुर्बुद्धे यदहं तव देशिकः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006240038, "chapter_id": 26240, "verse_number": "२-६८-३९", "content_sanskrit": "एवमुक्त्वा यदुं राजा शशापैनं स मन्युमान् ।\nयस्त्वं मे त्दृदयाज्जातो वयः स्वं न प्रयच्छसि ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006240039, "chapter_id": 26240, "verse_number": "२-६८-४०", "content_sanskrit": "तस्मान्न राज्यभाङ्मूढ प्रजा ते वै भविष्यति ।\nतुर्वसो प्रतिपद्यस्व पाप्मानं जरया सह ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006240040, "chapter_id": 26240, "verse_number": "२-६८-४१", "content_sanskrit": "तुर्वसुरुवाच न कामये जरां तात कामभोगप्रणाशिनीम् ।\nजरायां बहवो दोषाः पानभोजन कारिताः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006240041, "chapter_id": 26240, "verse_number": "२-६८-४२", "content_sanskrit": "तस्माज्जरां न ते राजन्ग्रहीतुमहमुत्सहे ।\nययातिरुवाच यस्त्वं मे त्दृदयाज्जातो वयः स्वं न प्रयच्छसि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006240042, "chapter_id": 26240, "verse_number": "२-६८-४३", "content_sanskrit": "तस्मात्प्रजानु विच्छेदं तुर्वसो तव यास्यति ।\nसंकीर्णेषु च धर्मेण प्रतिलोमनरेषु च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006240043, "chapter_id": 26240, "verse_number": "२-६८-४४", "content_sanskrit": "पिशिताशिषु चान्येषु मूढ राजा भविष्यसि ।\nगुरुदारप्रसक्तेषु तिर्यग्योनिगतेषु वा ।\nवासस्ते पाप म्लेच्छेषु भविष्यति न संशयः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006240044, "chapter_id": 26240, "verse_number": "२-६८-४५", "content_sanskrit": "सूत उवाच एवं तु तुर्वसुंशप्त्वा ययातिः सुतमात्मनः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006240045, "chapter_id": 26240, "verse_number": "२-६८-४६", "content_sanskrit": "शर्मिष्ठायाः सुतं द्रुह्युमिदं वचनमब्रवीत् ।\nद्रुह्यो त्वं प्रतिपद्यस्व वर्णरूपविनाशिनीम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006240046, "chapter_id": 26240, "verse_number": "२-६८-४७", "content_sanskrit": "जरा वर्षसहस्रंवै यौवनं स्वं ददस्व मे ।\nपूर्णे वर्षसहस्रे ते प्रतिदास्यामि यौवनम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006240047, "chapter_id": 26240, "verse_number": "२-६८-४८", "content_sanskrit": "स्वं चादास्यामि भूयोऽहं पाप्मानं जरया सह ।\nद्रुह्युरुवाच नारोहेत रथं नाश्वं जीर्णो भुङ्क्ते न च स्त्रियम् ।\nन सुखं चास्य भवति न जरां तेन कामये ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006240048, "chapter_id": 26240, "verse_number": "२-६८-४९", "content_sanskrit": "ययातिरुवाच यस्त्वं मे हृदयाज्जातो वयः स्वं न प्रयच्छसि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006240049, "chapter_id": 26240, "verse_number": "२-६८-५०", "content_sanskrit": "तस्माद्द्रुह्यो प्रियः कामो न ते संपत्स्यते क्वचित् ।\nनौप्लवोत्तरसंचारस्तव नित्यं भविष्यति ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006240050, "chapter_id": 26240, "verse_number": "२-६८-५१", "content_sanskrit": "अराजा राजवंशस्त्वं तत्र नित्यं वसिष्यसि ।\nअनो त्वं प्रतिपाद्यस्व पाप्मानं जरया सह ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006240051, "chapter_id": 26240, "verse_number": "२-६८-५२", "content_sanskrit": "एवं वर्षसहस्रं तु चरेयं यौवनेन ते ।\nअनुरुवाच जीर्णः शिशुरिवाशक्तो जरया ह्यशुचिः सदा ।\nन जुहोति स कालेऽग्निं तां जरां नाभिकामये ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006240052, "chapter_id": 26240, "verse_number": "२-६८-५३", "content_sanskrit": "ययातिरूवाच ।\nयस्त्वं मे हृदयाज्जातो वयः स्वं न प्रयच्छसि ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006240053, "chapter_id": 26240, "verse_number": "२-६८-५४", "content_sanskrit": "जरादोष स्त्वयोक्तोऽयं तस्मात्त्वं प्रतिपत्स्यसे ।\nप्रजा च यौवनं प्राप्ता विनशिष्यत्यनो तव ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006240054, "chapter_id": 26240, "verse_number": "२-६८-५५", "content_sanskrit": "अग्निप्रस्कन्दनपरास्त्वं वाप्येवं भविष्यसि ।\nपूरो त्वं प्रतिपद्यस्व पाप्मानं जरया सह ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006240055, "chapter_id": 26240, "verse_number": "२-६८-५६", "content_sanskrit": "जरावली च मां तात पलितानि च पर्ययुः ।\nकाव्यस्योशनसः शापान्न च तृप्तोऽस्मियौवने ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006240056, "chapter_id": 26240, "verse_number": "२-६८-५७", "content_sanskrit": "कञ्चित्कालं चरेयं वै विषयान्वयसा तव ।\nपूर्णे वर्षसहस्रे ते प्रतिदास्यामि यौवनम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006240057, "chapter_id": 26240, "verse_number": "२-६८-५८", "content_sanskrit": "स्वं चैव प्रतिपत्स्येऽहं पाप्मानं जरया सह ।\nसूत उवाच एवमुक्तः प्रत्युवाच पुत्रः पितरमञ्जसा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006240058, "chapter_id": 26240, "verse_number": "२-६८-५९", "content_sanskrit": "यथा तु मन्यसे तात करिष्यामि तथैव च ।\nप्रतिपत्स्ये च ते राजन्पाप्मानं जरया सह ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006240059, "chapter_id": 26240, "verse_number": "२-६८-६०", "content_sanskrit": "गृहाण यौवनं मत्तश्चर कामान्यथेप्सितान् ।\nजरयाहं प्रतिच्छन्नो वयोरूपधरस्तव ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006240060, "chapter_id": 26240, "verse_number": "२-६८-६१", "content_sanskrit": "यौवनं भवते दत्त्वा चरिष्यामि यथार्थवत् ।\nययातिरुवाच पूरो प्रीतोऽस्मि भद्रं ते प्रीतश्चेदं ददामि ते ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006240061, "chapter_id": 26240, "verse_number": "२-६८-६२", "content_sanskrit": "सर्वकामसमृद्धा ते प्रजा राज्ये भविष्यति ।\nसूत उवाच पूरोरनुमतो राजा ययातिः स्वजरां ततः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006240062, "chapter_id": 26240, "verse_number": "२-६८-६३", "content_sanskrit": "संक्रामयामास तदा प्रासादद्भार्गवस्य तु ।\nगौरवेणाथ वयसा ययातिर्नहुषात्मजः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006240063, "chapter_id": 26240, "verse_number": "२-६८-६४", "content_sanskrit": "प्रीतियुक्तो नरश्रेष्ठश्चचार विषयान्स्वकान् ।\nयथाकामं यथोत्साहं यथाकालं यथासुखम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006240064, "chapter_id": 26240, "verse_number": "२-६८-६५", "content_sanskrit": "धर्माविरोधी राजेन्द्रो यथाशक्ति स एव हि ।\nदेवानतर्पयद्यज्ञैः पितॄञ्श्राद्धैस्तथैव च ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006240065, "chapter_id": 26240, "verse_number": "२-६८-६६", "content_sanskrit": "दाराननुग्रहैरिष्टैः कामैश्च द्विजसत्तमान् ।\nअतिथीनन्नपानैश्च वैश्यंश्च परिपालनैः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006240066, "chapter_id": 26240, "verse_number": "२-६८-६७", "content_sanskrit": "आनृशंस्येन शूद्रांश्च दस्यून्संनिग्रहेण च ।\nधर्मेण च प्रजाः सर्वा यथावदनुरञ्जयत् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006240067, "chapter_id": 26240, "verse_number": "२-६८-६८", "content_sanskrit": "ययातिः पालयामास साक्षादिन्द्र इवापरः ।\nस राजा सिंहविक्रान्तो युवा विषयगोचरः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006240068, "chapter_id": 26240, "verse_number": "२-६८-६९", "content_sanskrit": "अविरोधेन धर्मस्य चचार सुखमुत्तमम् ।\nस मार्गमाणः कामानामतद्दोषनिदर्शनात् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006240069, "chapter_id": 26240, "verse_number": "२-६८-७०", "content_sanskrit": "विश्वाच्या सहितो रेमे वैब्राजे नन्दने वने ।\nअपश्यत्स यदा तान्वै वर्द्धमानान्नृपस्तदा ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006240070, "chapter_id": 26240, "verse_number": "२-६८-७१", "content_sanskrit": "गत्वा पूरोः सकाशं वै स्वां जरां प्रत्यपद्यत ।\nसंप्राप्य स तु तान्कामांस्तृप्तः खिन्नश्च पार्थिवः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006240071, "chapter_id": 26240, "verse_number": "२-६८-७२", "content_sanskrit": "कालं वर्षसहस्रं वै सस्मार मनुजाधिपः ।\nपरिसंख्याय काले च कलाः काष्ठास्तथैव च ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006240072, "chapter_id": 26240, "verse_number": "२-६८-७३", "content_sanskrit": "पूर्णं मत्वा ततः कालं पूरुं पुत्रमुवाच ह ।\nयथा सुखं यथोत्साहं यथाकालमरिन्दम ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006240073, "chapter_id": 26240, "verse_number": "२-६८-७४", "content_sanskrit": "सेविता विषयः पुत्र यौवनेन मया तव ।\nपूरो प्रीतोऽस्मि भद्रं ते गृहाण त्वं स्वयौवनम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006240074, "chapter_id": 26240, "verse_number": "२-६८-७५", "content_sanskrit": "राज्यं च त्वं गृहाणेदं त्वं हि मे प्रियकृत्सुतः ।\nप्रतिपेदे जरां राजा ययातिर्नहुषात्मजः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006240075, "chapter_id": 26240, "verse_number": "२-६८-७६", "content_sanskrit": "यौवनं प्रतिपेदे च पूरुः स्वं पुनरात्मनः ।\nअभिषेक्तुकामं च नृपं पूरुं पुत्रं कनीयसम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006240076, "chapter_id": 26240, "verse_number": "२-६८-७७", "content_sanskrit": "ब्राह्मणप्रमुखा वर्णा इदं वचनमब्रुवन् ।\nकथं शुक्रस्य नप्तारं देवयान्याः सुतं प्रभो ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006240077, "chapter_id": 26240, "verse_number": "२-६८-७८", "content_sanskrit": "ज्येष्ठं यदुमतिक्रम्य राज्यं दास्यसि पूरवे ।\nयदुर्ज्येष्ठस्तव सुतो जातस्तमनुदतुर्वसुः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006240078, "chapter_id": 26240, "verse_number": "२-६८-७९", "content_sanskrit": "शर्मिष्ठायाः सुतो द्रुह्युस्ततोऽनुः पूरुरेव च ।\nकथं ज्येष्ठानतिक्रम्य कनीयान्राज्यमर्हति ।\nसुतः संबोधयामस्त्वां धर्मं समनुपालय ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006240079, "chapter_id": 26240, "verse_number": "२-६८-८०", "content_sanskrit": "ययातिरुवाच ब्राह्मणप्रमुखा वर्णाः सर्वे शृण्वन्तु मे वचः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006240080, "chapter_id": 26240, "verse_number": "२-६८-८१", "content_sanskrit": "ज्येष्ठं प्रति यथा राज्यं न देयं मे कथञ्चन ।\nमातापित्रोर्वचनकृद्वीरः पुत्रः प्रशस्यते ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006240081, "chapter_id": 26240, "verse_number": "२-६८-८२", "content_sanskrit": "मम ज्येष्ठेन यदुना नियोगो नानुपालितः ।\nप्रतिकूलः पितुर्यश्च न स पुत्रः सतांमतः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006240082, "chapter_id": 26240, "verse_number": "२-६८-८३", "content_sanskrit": "स पुत्रः पुत्रवद्यश्च वर्त्तते पितृमातृषु ।\nयदुनाहमवज्ञातस्तथा तुर्वसुनापि च ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006240083, "chapter_id": 26240, "verse_number": "२-६८-८४", "content_sanskrit": "द्रुह्युना चानुना चैव मय्यवज्ञा कृता भृशम् ।\nपूरुणा तु कृतं वाक्यं मानितश्च विशेषतः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006240084, "chapter_id": 26240, "verse_number": "२-६८-८५", "content_sanskrit": "कनीयान्मम दायादो जरा येन धृता मम ।\nसर्वे कामा मम कृताः पूरुणा पुण्यकारिणा ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006240085, "chapter_id": 26240, "verse_number": "२-६८-८६", "content_sanskrit": "शुक्रेण च वरो दत्तः काव्येनोशनसा स्वयम् ।\nपुत्रो यस्त्वानुवर्त्तेत स राजा तु महामते ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006240086, "chapter_id": 26240, "verse_number": "२-६८-८७", "content_sanskrit": "प्रजा ऊचुः भवतोऽनुमतोऽप्येवं पूरू राज्येऽभिषिच्यताम् ।\nयः पुत्रो गुणसंपन्नो मातापित्रोर्हितः सदा ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006240087, "chapter_id": 26240, "verse_number": "२-६८-८८", "content_sanskrit": "सर्वमर्हति कल्याणं कनीयानपि स प्रभुः ।\nअर्हेऽस्य पूरू राज्यस्य यः प्रियः प्रियकृत्तव ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006240088, "chapter_id": 26240, "verse_number": "२-६८-८९", "content_sanskrit": "वरदानेन शुक्रस्य न शक्यं वक्तुमुत्तरम् ।\nपौरजान पदैस्तुष्टैरित्युक्ते नाहुषस्तदा ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006240089, "chapter_id": 26240, "verse_number": "२-६८-९०", "content_sanskrit": "अभिषिच्य ततः पूरुं स राज्ये सुतमात्मनः ।\nदिशि दक्षिणपूर्वस्यां तुर्वसुं तु न्यवेशयत् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006240090, "chapter_id": 26240, "verse_number": "२-६८-९१", "content_sanskrit": "दक्षिणापरतो राजा यदुं ज्येष्ठं न्यवेशयत् ।\nप्रतीच्यामुत्तरस्यां च द्रुह्युं चानुं च तावुभौ ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006240091, "chapter_id": 26240, "verse_number": "२-६८-९२", "content_sanskrit": "सप्तद्वीपां ययातिस्तु जित्वा पृथ्वीं ससागराम् ।\nव्यभजत्पञ्चधा राजा पुत्रेभ्यो नाहुषस्तदा ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006240092, "chapter_id": 26240, "verse_number": "२-६८-९३", "content_sanskrit": "तैरियं पृथिवी सर्वा सप्तद्वीपा सपत्तना ।\nयथाप्रदेशं धर्मज्ञैर्धर्मेण प्रतिपान्यते ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006240093, "chapter_id": 26240, "verse_number": "२-६८-९४", "content_sanskrit": "एवं विभज्य पृथिवीं पुत्रेभ्यो नाहुषस्तदा ।\nपुत्रसंक्रामितश्रीस्तु प्रीतिमा नभवन्नृपः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006240094, "chapter_id": 26240, "verse_number": "२-६८-९५", "content_sanskrit": "धनुर्न्यस्य पृषत्कांश्च राज्यं चैव सुतेषु तु ।\nप्रीतिमानभवद्राजा भारमावेश्य बन्धुषु ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006240095, "chapter_id": 26240, "verse_number": "२-६८-९६", "content_sanskrit": "अत्र गाथा महाराज्ञा पुरा गीता ययातिना ।\nयाभिः प्रत्याहरेत्कामात्कूर्मौंऽगानीव सर्वशः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006240096, "chapter_id": 26240, "verse_number": "२-६८-९७", "content_sanskrit": "न जातु कामः कामानमुपभोगेन शाम्यति ।\nहविषा कृष्णवर्त्मेव भूय एवाभिवर्द्धते ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006240097, "chapter_id": 26240, "verse_number": "२-६८-९८", "content_sanskrit": "यत्पृथिव्यां व्रीहियवं हिरण्यं पशवः स्त्रियः ।\nनालमेकस्य तत्सर्वमिति पश्यन्न मुह्यति ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006240098, "chapter_id": 26240, "verse_number": "२-६८-९९", "content_sanskrit": "यदा न कुरुते भावं सर्वभूतेष्वमङ्गलम् ।\nकर्मणा मनसा वाचा ब्रह्म संपद्यते तदा ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006240099, "chapter_id": 26240, "verse_number": "२-६८-१००", "content_sanskrit": "यदा परान्न बिभेति यदान्यस्मान्न बिभ्यति ।\nयदा नेच्छति न द्वेष्टि ब्रह्म संपद्यते तदा ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006240100, "chapter_id": 26240, "verse_number": "२-६८-१०१", "content_sanskrit": "या दुस्त्यजा दुर्मतिभिर्या न जीर्यति जीर्यतः ।\nयैषा प्राणान्तिको रोगस्तां तृष्णां त्यजतः सुखम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006240101, "chapter_id": 26240, "verse_number": "२-६८-१०२", "content_sanskrit": "जीर्यन्ति जीर्यतः केशा दन्ता जीर्यन्ति जीर्यतः ।\nजीविताशा धनाशा च जीर्यतोऽपि न जीर्यति ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7006240102, "chapter_id": 26240, "verse_number": "२-६८-१०३", "content_sanskrit": "यच्च कामसुखं लोके यच्छ दिव्यं महत्सुखम् ।\nकृष्णाक्षयसुखस्यैतत्कलां नर्हन्ति षोडशीम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7006240103, "chapter_id": 26240, "verse_number": "२-६८-१०४", "content_sanskrit": "एवमुक्त्वा स राजर्षिः सदारः प्रस्थितो वनम् ।\nभृगुतुङ्गे तपस्तप्त्वा तत्रैव च महायशाः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7006240104, "chapter_id": 26240, "verse_number": "२-६८-१०५", "content_sanskrit": "पालयित्वा व्रतं चार्षं तत्रैव स्वर्ग माप्तवान् ।\nतस्य वंशास्तु पञ्चैते पुण्या देवर्षिसत्कृताः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7006240105, "chapter_id": 26240, "verse_number": "२-६८-१०६", "content_sanskrit": "यैर्व्याप्ता पृथिवी कृत्स्ना सूर्यस्येव गभस्तिभिः ।\nधन्यः प्रजावा नायुष्मान्कीर्त्तिमांश्च भवेन्नरः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7006240106, "chapter_id": 26240, "verse_number": "२-६८-१०७", "content_sanskrit": "ययातेश्चारितं सर्वं पठञ्छृण्वन्द्विजोत्तमाः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}]