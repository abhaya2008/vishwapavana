[{"id": 6000050000, "chapter_id": 10050, "verse_number": null, "content_sanskrit": "अथ विंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "भगवता हिरण्याक्षवधः, देवतादिभिः भगवत्स्तवश्च", "range": null}]}, {"id": 6000050001, "chapter_id": 10050, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.001.m4a", "display_order": 2}, {"id": 6000050002, "chapter_id": 10050, "verse_number": "३-२०-१", "content_sanskrit": "अवधार्य विरिञ्चस्य निर्व्यलीकमृतं वचः।\nप्रहस्य प्रेमगर्भेण तदपाङ्गेन सोऽग्रहीत्॥ ३/२०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.002.m4a", "display_order": 3}, {"id": 6000050003, "chapter_id": 10050, "verse_number": "३-२०-२", "content_sanskrit": "ततः सपत्नं मुखतश्चरन्तमकुतोभयम्।\nजघानोत्पत्य गदया हनावसुरमक्षतः॥ ३/२०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.003.m4a", "display_order": 4}, {"id": 6000050004, "chapter_id": 10050, "verse_number": "३-२०-३", "content_sanskrit": "सा हता तेन गदया विगता भगवत्करात्।\nविघूर्णिता भृशं रेजे तदद्भुतमिवाभवत्॥ ३/२०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.004.m4a", "display_order": 5}, {"id": 6000050005, "chapter_id": 10050, "verse_number": "३-२०-४", "content_sanskrit": "स तदा लब्धवीर्योऽपि न बबाधे निरायुधम्।\nमानयन् स मृधे धर्मं विष्वक्सेनं प्रकोपयन्॥ ३/२०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.005.m4a", "display_order": 6}, {"id": 6000050006, "chapter_id": 10050, "verse_number": "३-२०-५", "content_sanskrit": "गदायामपविद्धायां हाहाकारे विनिर्गते।\nमानयामास तद्धर्मं सुनाभं चास्मरद् विभुः॥ ३/२०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.006.m4a", "display_order": 7}, {"id": 6000050007, "chapter_id": 10050, "verse_number": "३-२०-६", "content_sanskrit": "तं व्यग्रचक्रं दितिपुत्राधमेन स्वपार्षदमुख्येन विषज्जमानम्।\nचित्रा वाचस्तद्विदां खेचराणां तत्र स्मासन् स्वस्ति तेऽमुं जहीति॥ ३/२०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.007.m4a", "display_order": 8}, {"id": 6000050008, "chapter_id": 10050, "verse_number": "३-२०-७", "content_sanskrit": "स तन्निशम्यात्तरथाङ्गमग्रतो व्यवस्थितं पद्मपलाशलोचनम्।\nविलोक्य चामर्षपरिप्लुतेन्द्रियो रुषा स्वदन्तच्छदमादशच्छ्वसन्॥ ३/२०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.008.m4a", "display_order": 9}, {"id": 6000050009, "chapter_id": 10050, "verse_number": "३-२०-८", "content_sanskrit": "करालदंष्ट्रश्चक्षुर्भ्यां सञ्चक्षाणो दहन्निव।\nअभिद्रुत्य स्वगदया हतोऽसीत्यहनद्धरिम्॥ ३/२०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.009.m4a", "display_order": 10}, {"id": 6000050010, "chapter_id": 10050, "verse_number": "३-२०-९", "content_sanskrit": "पदा सव्येन तां साधो भगवान् यज्ञसूकरः।\nलीलया मिषतः शत्रोः प्राहरद् वातरंहसा॥ ३/२०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.010.m4a", "display_order": 11}, {"id": 6000050011, "chapter_id": 10050, "verse_number": "३-२०-१०", "content_sanskrit": "आह चायुधमादत्स्व घटस्व त्वं जिगीषसि।\nइत्युक्तः स तया भूयस्ताडयन् व्यनदद् भृशम्॥ ३/२०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.011.m4a", "display_order": 12}, {"id": 6000050012, "chapter_id": 10050, "verse_number": "३-२०-११", "content_sanskrit": "तां स आपततीं वीक्ष्य भगवान् समवस्थितः।\nजग्राह लीलया प्राप्तां गरुत्मानिव पन्नगीम्॥ ३/२०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.012.m4a", "display_order": 13}, {"id": 6000050013, "chapter_id": 10050, "verse_number": "३-२०-१२", "content_sanskrit": "स्वपौरुषे प्रतिहते हतमानो महासुरः।\nनैच्छद् गदां दीयमानां हरिणा विगतप्रभः॥ ३/२०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.013.m4a", "display_order": 14}, {"id": 6000050014, "chapter_id": 10050, "verse_number": "३-२०-१३", "content_sanskrit": "जग्राह त्रिशिखं शूलं ज्वलज्ज्वलनलोलुपम्।\nयज्ञाय धृतरूपाय विप्रायाभिचरन् यथा॥ ३/२०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.014.m4a", "display_order": 15}, {"id": 6000050015, "chapter_id": 10050, "verse_number": "३-२०-१४", "content_sanskrit": "तदौजसा दैत्यमहाभटार्पितं चकासदन्तः ख उदीर्णदीधिति।\nचक्रेण चिच्छेद निशातनेमिना हरिर्यथा तार्क्ष्यपतत्रमुज्झितम्॥ ३/२०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.015.m4a", "display_order": 16}, {"id": 6000050016, "chapter_id": 10050, "verse_number": "३-२०-१५", "content_sanskrit": "वृक्णे च शूले बहुधारिणा हरेः प्रत्येत्य विस्तीर्णमुरो विभूतिमत्।\nप्रवृद्धरोषः सकठोरमुष्टिना नदन् प्रहृत्यान्तरधीयतासुरः॥ ३/२०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.016.m4a", "display_order": 17}, {"id": 6000050017, "chapter_id": 10050, "verse_number": "३-२०-१६", "content_sanskrit": "तेनेत्थमाहते क्षत्तर्भगवानादिसूकरः।\nनाकम्पत मनाक्क्‍वापि स्रजाहत इव द्विपः॥ ३/२०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.017.m4a", "display_order": 18}, {"id": 6000050018, "chapter_id": 10050, "verse_number": "३-२०-१७", "content_sanskrit": "अथोरुधाऽसृजन्मायां योगमायेश्वरे हरौ।\nयां विलोक्य प्रजास्‍त्रस्ता मेनिरेऽस्योपसंयमम्॥ ३/२०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.018.m4a", "display_order": 19}, {"id": 6000050019, "chapter_id": 10050, "verse_number": "३-२०-१८", "content_sanskrit": "प्रववुर्वायवश्चण्डास्तमः पांसवमैरयन्।\nदिग्भ्यो निपेतुर्ग्रावाणः क्षेपणैः प्रहिता इव॥ ३/२०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.019.m4a", "display_order": 20}, {"id": 6000050020, "chapter_id": 10050, "verse_number": "३-२०-१९", "content_sanskrit": "द्यौर्नष्टभगणाऽभ्रौघैः सविद्युत्स्तनयित्नुभिः।\nवर्षद्भिः पूयकेशासृग्विण्मूत्रास्थीनि चासकृत्॥ ३/२०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.020.m4a", "display_order": 21}, {"id": 6000050021, "chapter_id": 10050, "verse_number": "३-२०-२०", "content_sanskrit": "गिरयः प्रत्यदृश्यन्त नानायुधमुचोऽनघ।\nदिग्वाससो यातुधान्यः शूलिन्यो मुक्तमूर्धजाः॥ ३/२०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.021.m4a", "display_order": 22}, {"id": 6000050022, "chapter_id": 10050, "verse_number": "३-२०-२१", "content_sanskrit": "बहुभिर्यक्षरक्षोभिः पत्त्यश्वरथकुञ्जरैः।\nआततायिभिरुत्सृष्टा हिंस्रा वाचोऽतिवैशसाः॥ ३/२०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.022.m4a", "display_order": 23}, {"id": 6000050023, "chapter_id": 10050, "verse_number": "३-२०-२२", "content_sanskrit": "प्रादुष्कृतानां मायानामासुरीणां विनाशनम्।\nसुदर्शनाख्यं स्वास्‍त्रं तु प्रायुङ्क्त दयितं त्रिपात्॥ ३/२०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.023.m4a", "display_order": 24}, {"id": 6000050024, "chapter_id": 10050, "verse_number": "३-२०-२३", "content_sanskrit": "तदा दितेः समभवत् सहसा हृदि वेपथुः।\nस्मरन्त्या भर्तुरादेशं स्तनाच्चासृक् प्रसुस्रुवे॥ ३/२०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.024.m4a", "display_order": 25}, {"id": 6000050025, "chapter_id": 10050, "verse_number": "३-२०-२४", "content_sanskrit": "व्युदस्तासु स्वमायासु भूयश्चाव्रज्य केशवम्।\nउपोपगूहमानोऽमुं ददृशेऽवस्थितं बहिः॥ ३/२०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.025.m4a", "display_order": 26}, {"id": 6000050026, "chapter_id": 10050, "verse_number": "३-२०-२५", "content_sanskrit": "तं मुष्टिभिर्विनिघ्नन्तं वज्रसारैरधोक्षजः।\nकरेण कर्णमूलेऽहन् यथा त्वाष्ट्रं मरुत्पतिः॥ ३/२०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.026.m4a", "display_order": 27}, {"id": 6000050027, "chapter_id": 10050, "verse_number": "३-२०-२६", "content_sanskrit": "समाहतो विश्वसृजा ह्यवज्ञया परिभ्रमद्गात्र उदस्तलोचनः।\nविशीर्णबाह्वङ्घ्रिशिरोधरोऽपतद् यथा नगेन्द्रो लुलितो नभस्वता॥ ३/२०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.027.m4a", "display_order": 28}, {"id": 6000050028, "chapter_id": 10050, "verse_number": "३-२०-२७", "content_sanskrit": "क्षितौ शयानं तमकुण्ठवर्चसं करालदंष्ट्रं परिदष्टदच्छदम्।\nअजादयो वीक्ष्य शशंसुरागता अहो इमां को नु लभेत संस्थितिम्॥ ३/२०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.028.m4a", "display_order": 29}, {"id": 6000050029, "chapter_id": 10050, "verse_number": "३-२०-२८", "content_sanskrit": "यं योगिनो योगसमाधिना हरेर्ध्यायन्ति लिङ्गादसतो मुमुक्षवः।\nतस्यैष दैत्यऋषभः पदाहतो मुखं प्रपश्यंस्तनुमुत्ससर्ज ह॥ ३/२०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.029.m4a", "display_order": 30}, {"id": 6000050030, "chapter_id": 10050, "verse_number": "३-२०-२९", "content_sanskrit": "एतौ हि पार्षदावस्य शापाद् यातावसद्गतिम्।\nपुनः कतिपयैः स्थानं प्रपत्स्येते ह जन्मभिः॥ ३/२०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.030.m4a", "display_order": 31}, {"id": 6000050031, "chapter_id": 10050, "verse_number": "३-२०-३०", "content_sanskrit": "नमो नमस्तेऽखिलयज्ञतन्तवे स्थितौ गृहीतामलसत्त्वमूर्तये।\nदिष्ट्या हतोऽयं जगतामरुन्तुदस्त्वत्पादभक्त्या वयमीश निर्वृताः॥ ३/२०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.031.m4a", "display_order": 32}, {"id": 6000050032, "chapter_id": 10050, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.032.m4a", "display_order": 33}, {"id": 6000050033, "chapter_id": 10050, "verse_number": "३-२०-३१", "content_sanskrit": "एवं हिरण्याक्षमसह्यविक्रमः संसादयित्वा हरिरादिसूकरः।\nजगाम लोकं स्वमखण्डितोत्सवं समीडितः पुष्करविष्टरादिभिः॥ ३/२०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.033.m4a", "display_order": 34}, {"id": 6000050034, "chapter_id": 10050, "verse_number": "३-२०-३२", "content_sanskrit": "मया यथाऽनूक्तमथादितो हरेः कृतावतारस्य सुमित्र चेष्टितम्।\nयथा हिरण्याक्ष उदारविक्रमो महामृधे क्रीडनवन्निराकृतः॥ ३/२०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.034.m4a", "display_order": 35}, {"id": 6000050035, "chapter_id": 10050, "verse_number": null, "content_sanskrit": "शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.035.m4a", "display_order": 36}, {"id": 6000050036, "chapter_id": 10050, "verse_number": "३-२०-३३", "content_sanskrit": "इति कौशारवाख्यातामाश्रुत्य भगवत्कथाम्।\nक्षत्ताऽऽनन्दं परं लेभे महाभागवतो नृप॥ ३/२०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.036.m4a", "display_order": 37}, {"id": 6000050037, "chapter_id": 10050, "verse_number": "३-२०-३४", "content_sanskrit": "अन्येषां पुण्यश्लोकानामुद्दामयशसां सताम्।\nउपश्रुत्य भवेन्मोदः श्रीवत्साङ्कस्य किं पुनः॥ ३/२०/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.037.m4a", "display_order": 38}, {"id": 6000050038, "chapter_id": 10050, "verse_number": "३-२०-३५", "content_sanskrit": "यो गजेन्द्रं झषग्रस्तं ध्यायन्तं चरणाम्बुजम्।\nक्रोशन्तीनां करेणूनां कृच्छ्रतोऽमोचयद् द्रुतम्॥ ३/२०/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.038.m4a", "display_order": 39}, {"id": 6000050039, "chapter_id": 10050, "verse_number": "३-२०-३६", "content_sanskrit": "तं सुखाराध्यमृजुभिरनन्यशरणैर्नृभिः।\nकृतज्ञः को न सेवेत दुराराध्यमसाधुभिः॥ ३/२०/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.039.m4a", "display_order": 40}, {"id": 6000050040, "chapter_id": 10050, "verse_number": "३-२०-३७", "content_sanskrit": "यो वै हिरण्याक्षवधं महाद्भुतं विक्रीडितं कारणसूकरात्मनः।\nशृणोति गायत्यनुमोदतेऽञ्जसा विमुच्यते ब्रह्मवधादपि द्विजः॥ ३/२०/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.040.m4a", "display_order": 41}, {"id": 6000050041, "chapter_id": 10050, "verse_number": "३-२०-३८", "content_sanskrit": "एतन्महापुण्यफलं पवित्रं धन्यं यशस्यं पदमायुराशिषाम्।\nप्राणेन्द्रियाणां युधि धैर्यवर्धनं नारायणोऽन्ते गतिरङ्ग शृण्वताम्॥ ३/२०/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_020/BhP_03.020.041.m4a", "display_order": 42}, {"id": 6000050042, "chapter_id": 10050, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे विंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]