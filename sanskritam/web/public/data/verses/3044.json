[{"id": 2095796, "chapter_id": 3044, "verse_number": "१३-१७४-१", "content_sanskrit": "युधिष्ठिर उवाच।\nअधर्मस्य गतिर्ब्रह्मन्कथिता मे त्वयाऽनघ।\nधर्मस्य तु गतिं श्रोतुमिच्छामि वदतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2095797, "chapter_id": 3044, "verse_number": "१३-१७४-२", "content_sanskrit": "कृत्वा कर्माणि पापानि कथं यान्ति शुभां गतिम्।\nकर्मणा च कृतेनेह केन यान्ति शुभां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2095798, "chapter_id": 3044, "verse_number": "१३-१७४-३x", "content_sanskrit": "बृहस्पतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2095799, "chapter_id": 3044, "verse_number": "१३-१७४-३", "content_sanskrit": "कृत्वा पापानि कर्माणि अधर्मवशमागतः।\nमनसा विपरीतेन निरयं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2095800, "chapter_id": 3044, "verse_number": "१३-१७४-४", "content_sanskrit": "मोहादधर्मं यः कृत्वा पुनः समनुतप्यते।\nमनःसमाधिसंयुक्तो न स सेवेत दुष्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2095801, "chapter_id": 3044, "verse_number": "१३-१७४-५", "content_sanskrit": "[यथायथा मनस्तस्य दुष्कृतं कर्म गर्हते।\nतथातथा शरीरं तु तेनाधर्मेण मुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2095802, "chapter_id": 3044, "verse_number": "१३-१७४-६", "content_sanskrit": "यदि व्याहरते राजन्विप्राणां धर्मवादिनाम्।\nततोऽधर्मकृतात्क्षिप्रमपवादात्प्रमुच्यते॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2095803, "chapter_id": 3044, "verse_number": "१३-१७४-७", "content_sanskrit": "यथायथा नरः सम्यगध्रममनुभाषते।\nसमाहितेन मनसा विमुच्येत तथातथा।\nभुजङ्ग इव निर्मोकात्पूर्वभुक्ताज्जरान्वितात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2095804, "chapter_id": 3044, "verse_number": "१३-१७४-८", "content_sanskrit": "दत्त्वा विप्रस्य दानानि विविधानि समाहितः।\nमनःसमाधिसंयुक्तः सुगतिं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2095805, "chapter_id": 3044, "verse_number": "१३-१७४-९", "content_sanskrit": "प्रदानानि तु वक्ष्यामि यानि दत्त्वा युधिष्ठिर।\nनरः कृत्वाऽप्यकार्याणि ततो धर्मेण युज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2095806, "chapter_id": 3044, "verse_number": "१३-१७४-१०", "content_sanskrit": "सर्वेषामेव दानानामन्नं श्रेष्ठमुदाहृतम्।\nपूर्वमन्नं प्रदातव्यमृजुना धर्ममिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2095807, "chapter_id": 3044, "verse_number": "१३-१७४-११", "content_sanskrit": "प्राणा ह्यन्नं मनुष्याणां तस्माज्जन्तुश्च जायते।\nअन्ने प्रतिष्ठितो लोकस्तस्मादन्नं प्रशस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2095808, "chapter_id": 3044, "verse_number": "१३-१७४-१२", "content_sanskrit": "अन्नमेव प्रशंसन्ति देवर्षिपितृमानवाः।\nअन्नस्य हि प्रदानेन स्वर्गमाप्नोति मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2095809, "chapter_id": 3044, "verse_number": "१३-१७४-१३", "content_sanskrit": "न्यायलब्धं प्रदातव्यं द्विजातिभ्योऽन्नमुत्तमम्।\nस्वाध्यायसमुपेतेभ्यः प्रहृष्टेनान्तरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2095810, "chapter_id": 3044, "verse_number": "१३-१७४-१४", "content_sanskrit": "यस्य ह्यन्नमुपाश्नन्ति ब्राह्मणानां शतं दश।\nहृष्टेन मनसा दत्तं न स तिर्यग्गतिर्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2095811, "chapter_id": 3044, "verse_number": "१३-१७४-१५", "content_sanskrit": "ब्राह्मणानां सहस्राणि दश भोज्य नरर्षभ।\nनरोऽधर्मात्प्रमुच्येत योगेष्वभिरतः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2095812, "chapter_id": 3044, "verse_number": "१३-१७४-१६", "content_sanskrit": "भैक्ष्येणान्नं समाहृत्य दद्यादन्नं द्विजेषु वै।\nसुवर्णदानात्पापानि नश्यन्ति सुबहून्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2095813, "chapter_id": 3044, "verse_number": "१३-१७४-१७", "content_sanskrit": "दत्त्वा वृत्तिकरीं भूमिं पातकेनापि मुच्यते।\nपारायणैश्च वेदानां मुच्यते पातकैर्द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2095814, "chapter_id": 3044, "verse_number": "१३-१७४-१८", "content_sanskrit": "गायत्र्याश्चैव लक्षेण गोसहस्रस्य तर्पणात्।\nवेदार्थं ज्ञापयित्वा तु शुद्धान्विप्रान्यथार्थतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2095815, "chapter_id": 3044, "verse_number": "१३-१७४-१९", "content_sanskrit": "सर्वत्यागादिभिश्चैव मुच्यते पातकैर्द्विजः।\nसर्वातिथ्यं परं ह्येषां तस्माद्दानं परं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2095816, "chapter_id": 3044, "verse_number": "१३-१७४-२०", "content_sanskrit": "अहिंसन्ब्राह्मणस्वानि न्यायेन परिपाल्य च।\nक्षत्रियस्तरसा प्राप्तमन्नं यो वै प्रयच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2095817, "chapter_id": 3044, "verse_number": "१३-१७४-२१", "content_sanskrit": "द्विजेभ्यो वेदवृद्धेभ्यः प्रयतः सुसमाहितः।\nतेनापोहति धर्मात्मन्दुष्कृतं कर्म पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2095818, "chapter_id": 3044, "verse_number": "१३-१७४-२२", "content_sanskrit": "षड्भागपरिशुद्धं च कृषेर्भागमुपार्जितम्।\nवैश्योऽददद्द्विजातिभ्यः पापेभ्यः परिमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2095819, "chapter_id": 3044, "verse_number": "१३-१७४-२३", "content_sanskrit": "अवाप्य प्राणसंदेहं कार्कश्येन समार्जितम्।\nअन्नं दत्त्वा द्विजातिभ्यः शूद्रः पापात्प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2095820, "chapter_id": 3044, "verse_number": "१३-१७४-२४", "content_sanskrit": "औरसेन बलेनान्नमर्जयित्वाऽविहिंसकः।\nयः प्रयच्छति विप्रेभ्यो न स दुर्गाणि पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2095821, "chapter_id": 3044, "verse_number": "१३-१७४-२५", "content_sanskrit": "न्यायेनैवाप्तमन्नं तु नरो हर्षसमन्वितः।\nद्विजेभ्यो वेदवृद्धेभ्यो दत्त्वा पापात्प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2095822, "chapter_id": 3044, "verse_number": "१३-१७४-२६", "content_sanskrit": "अन्नमूर्जस्करं लोके दत्त्वोर्जस्वी भवेन्नरः।\nसतां पन्थानमावृत्य सर्वपापैः प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2095823, "chapter_id": 3044, "verse_number": "१३-१७४-२७", "content_sanskrit": "`शूद्रान्नं नैव भोक्तव्यं विप्रैर्धर्मपरायणैः।\nआपद्येव स्वदासानां भोक्तव्यं स्वयमुद्यतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2095824, "chapter_id": 3044, "verse_number": "१३-१७४-२८", "content_sanskrit": "दानवद्भिः कृतः पन्था येन यान्ति मनीषिणः।\nते हि प्राणस्य दातारस्तेभ्यो धर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2095825, "chapter_id": 3044, "verse_number": "१३-१७४-२९", "content_sanskrit": "सर्वावस्थं मनुष्येण न्यायेनान्नमुपार्जितम्।\nकार्यं पात्रागतं नित्यमन्नं हि परमा गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2095826, "chapter_id": 3044, "verse_number": "१३-१७४-३०", "content_sanskrit": "अन्नस्य हि प्रदानेन नरो रौद्रं न सेवते।\nतस्मादन्नं प्रदातव्यमन्यायपरिवर्जितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2095827, "chapter_id": 3044, "verse_number": "१३-१७४-३१", "content_sanskrit": "यतेद्ब्राह्मणपूर्वं हि भोक्तुमन्नं गृही सदा।\nअवन्ध्यं दिवसं कुर्यादन्नपानीयदानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2095828, "chapter_id": 3044, "verse_number": "१३-१७४-३२", "content_sanskrit": "भोजयित्वा दशशतं नरो वेदविदां नृप।\nन्यायविद्धर्मविदुषामितिहासविदां तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2095829, "chapter_id": 3044, "verse_number": "१३-१७४-३३", "content_sanskrit": "न याति नरकं घोरं संसारांश्च न सेवते।\nसर्वकामसमायुक्तः प्रेत्य चाप्यश्नुते सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2095830, "chapter_id": 3044, "verse_number": "१३-१७४-३४", "content_sanskrit": "एवं सुखसमायुक्तो रमते विगतज्वरः।\nरूपवान्कीर्तिमांश्चैव धनवांश्चोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2095831, "chapter_id": 3044, "verse_number": "१३-१७४-३५", "content_sanskrit": "एतत्ते सर्वमाख्यातमन्नदानफलं महूत्।\nमूलमेतत्तु धर्माणां प्रदानानां च भारत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2095832, "chapter_id": 3044, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चतुःसप्तत्यधिकशततमोऽध्यायः॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]