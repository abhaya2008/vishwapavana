[{"id": 2120439, "chapter_id": 3584, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2120440, "chapter_id": 3584, "verse_number": "१", "content_sanskrit": "स श्वेतपर्वतं वीरः समतिक्रम्य भारत ।\nदेशं किम्पुरुषावासं रामभृत्येन रक्षितम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2120441, "chapter_id": 3584, "verse_number": "२", "content_sanskrit": "महता सन्निपातेन क्षत्रियान्तकरेण ह ।\nअजयत् पाण्डवश्रेष्ठः करे चैव न्यवेशयत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2120442, "chapter_id": 3584, "verse_number": "३", "content_sanskrit": "तं जित्वा हाटकं नाम देशं गुह्यकरक्षितम् ।\nपाकशासनिरव्यग्रः ससैन्यो वशमानयत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2120443, "chapter_id": 3584, "verse_number": "४", "content_sanskrit": "तांस्तु सान्त्वेन निर्जित्य मानसं सर उत्तमम् ।\nऋषिकुल्यांश्च तान् सर्वान् ददर्श कुरुनन्दनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2120444, "chapter_id": 3584, "verse_number": "५", "content_sanskrit": "मानसं सर आसाद्य हाटकानभितः प्रभुः ।\nगन्धर्वरक्षितं देशमगमत् पाण्डुनन्दनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2120445, "chapter_id": 3584, "verse_number": "६", "content_sanskrit": "तत्र तित्तिरिकल्माषान् समुद्राक्षान् हयोत्तमान् ।\nलेभे स करमत्यन्तं गन्धर्वनगरात् तदा ।\nहेमकूटमथासाद्य न्यविशत् फल्गुनस्तथा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2120446, "chapter_id": 3584, "verse_number": "७", "content_sanskrit": "तं हेमकूटं राजेन्द्र समतिक्रम्य पाण्डवः ।\nहरिवर्षं विवेशाथ सैन्येन महता वृतः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2120447, "chapter_id": 3584, "verse_number": "८", "content_sanskrit": "तत्र पार्थो ददर्शाथ बहूंश्चैव मनोरमान्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2120448, "chapter_id": 3584, "verse_number": "९", "content_sanskrit": "नगरांश्च नगांश्चैव नदीश्च विमलोदकाः ।\nपुरुषान् देवकल्पांश्च नारीश्च प्रियदर्शनाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2120449, "chapter_id": 3584, "verse_number": "१०", "content_sanskrit": "तान् सर्वांस्तत्र दृष्ट्वाऽथ मुदा युक्तो धनञ्जयः ।\nवशे चक्रे च रत्नानि लेभे च सुबहूनि च\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2120450, "chapter_id": 3584, "verse_number": "११", "content_sanskrit": "अथ राजन्नतिक्रम्य निषधं शैलमायतम् ।\nविवेश मध्यमं वर्षं पार्थो दिव्यमिळावृतम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2120451, "chapter_id": 3584, "verse_number": "१२", "content_sanskrit": "तत्र देवोपमान् दिव्यान् पुरुषान् देवदर्शनान् ।\nअदृष्टपूर्वान् सुभगान् स ददर्श धनञ्जयः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2120452, "chapter_id": 3584, "verse_number": "१३", "content_sanskrit": "सदनानि च शुभ्राणि नारीश्चाप्सरसन्निभाः ।\nदृष्ट्वा स पुरुषान् रम्यान् स तैश्च ददृशे तदा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2120453, "chapter_id": 3584, "verse_number": "१४", "content_sanskrit": "जित्वा च तान् महाभागान् करे च विनिवेश्य सः ।\nरत्नान्यादाय दिव्यानि भूषणैर्वसनैः सह\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2120454, "chapter_id": 3584, "verse_number": "१५", "content_sanskrit": "उदीचीमथ राजेन्द्र ययौ पार्थो मुदाऽन्वितः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2120455, "chapter_id": 3584, "verse_number": "१६", "content_sanskrit": "स ददर्श ततो मेरुं शिखराणां प्रभुं महत् ।\nतं काञ्चनमयं दिव्यं चतुर्वर्णं दुरासदम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2120456, "chapter_id": 3584, "verse_number": "१७", "content_sanskrit": "आयतं शतसाहस्रं योजनानां तु सुस्थिरम् ।\nज्वलन्तमचलं मेरुं तेजोराशिमनुत्तमम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2120457, "chapter_id": 3584, "verse_number": "१८", "content_sanskrit": "आक्षिपन्तं प्रभां भानोः स्वशृङ्गैः काञ्चनोज्ज्वलैः ।\nकाञ्चनाभरणं दिव्यं देवगन्धर्वसेवितम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2120458, "chapter_id": 3584, "verse_number": "१९", "content_sanskrit": "नित्यपुष्पफलोपेतं सिद्धचारणसेवितम् ।\nअप्रमेयमनाधृष्यमधर्मबहुलैर्जनैः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2120459, "chapter_id": 3584, "verse_number": "२०", "content_sanskrit": "व्याळैराचरितं घोरैर्दिव्यौषधिविदीपितम् ।\nस्वर्गमावृत्य तिष्ठन्तमुच्छ्रायेण महागिरिम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2120460, "chapter_id": 3584, "verse_number": "२१", "content_sanskrit": "अगम्यं मनसाऽप्येनं नदीवृक्षसमन्वितम् ।\nनानाविहगसङ्घैश्च नादितं सुमनोहरैः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2120461, "chapter_id": 3584, "verse_number": "२२", "content_sanskrit": "तं दृष्ट्वा फल्गुनो मेरुं प्रीतिमानभवत् तदा ।\nमेरोरिळावृतं वर्षं सर्वतः परिमण्डलम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2120462, "chapter_id": 3584, "verse_number": "२३", "content_sanskrit": "मेरोस्तु दक्षिणे पार्श्वे जम्बूर्नाम वनस्पतिः ।\nनित्यपुष्पफलोपेतः सिद्धचारणसेवितः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2120463, "chapter_id": 3584, "verse_number": "२४", "content_sanskrit": "आस्वर्गमुच्छ्रिता राजंस्तस्य शाखा वनस्पतेः ।\nयस्य नाम्ना त्विदं द्वीपं जम्बूद्वीपमिति श्रुतम् ।\nतां च जाम्बूं ददर्शाथ सव्यसाची परन्तपः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2120464, "chapter_id": 3584, "verse_number": "२५", "content_sanskrit": "तौ दृष्ट्वाऽप्रतिमौ लोके जम्बूं मेरुं च संस्थितौ ।\nप्रीतिमानभवद् राजन् सर्वतः स विलोकयन्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2120465, "chapter_id": 3584, "verse_number": "२६", "content_sanskrit": "तत्र लेभे ततो जिष्णुः सिद्धैर्दिव्यैश्च चारणैः ।\nरत्नानि बहुसाहस्रं वस्त्राण्याभरणानि च\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2120466, "chapter_id": 3584, "verse_number": "२७", "content_sanskrit": "अन्यानि च महार्हाणि तत्र लब्ध्वाऽर्जुनस्तदा ।\nआमन्त्रयित्वा तान् सर्वान् यज्ञमुद्दिश्य वै गुरोः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2120467, "chapter_id": 3584, "verse_number": "२८", "content_sanskrit": "बहून्यादाय रत्नानि गमनायोपचक्रमे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2120468, "chapter_id": 3584, "verse_number": "२९", "content_sanskrit": "मेरुं प्रदक्षिणं कृत्वा पर्वतप्रवरं प्रभुः ।\nययौ जम्बूनदीतीरे नदीं श्रेष्ठां विलोकयन्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2120469, "chapter_id": 3584, "verse_number": "३०", "content_sanskrit": "स तां मनोरमां दिव्यां जम्बूस्वादुरसावहाम् ।\nहैमपक्षिगणैर्जुष्टां सौवर्णजलजाकुलाम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2120470, "chapter_id": 3584, "verse_number": "३१", "content_sanskrit": "हैमपङ्कां हैमजलां शुभां सौवर्णवालुकाम् ।\nक्वचित् सौवर्णपद्मैश्च सङ्कुलां हैमपुष्पकैः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2120471, "chapter_id": 3584, "verse_number": "३२", "content_sanskrit": "क्वचित् सुपुष्पितैः कीर्णां सुवर्णकुमुदोत्पलैः ।\nक्वचित् तीररुहैः कीर्णां हैमवृक्षैः सुपुष्पितैः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2120472, "chapter_id": 3584, "verse_number": "३३", "content_sanskrit": "तीर्थैश्च रुग्मसोपानैः सर्वतः सङ्कुलां शुभाम् ।\nविमलैर्मणिजालैश्च नृत्तगीतरवैर्युताम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2120473, "chapter_id": 3584, "verse_number": "३४", "content_sanskrit": "दीप्तैर्हैमवितानैश्च समन्ताच्छोभितां शुभाम् ।\nतथाविधां नदीं दृष्ट्वा पार्थस्तां प्रशशंस ह\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2120474, "chapter_id": 3584, "verse_number": "३५", "content_sanskrit": "अदृष्टपूर्वां राजेन्द्र दृष्ट्वा हर्षमवाप च ।\nदर्शनीयान् नदीतीरे पुरुषान् सुमनोहरान्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2120475, "chapter_id": 3584, "verse_number": "३६", "content_sanskrit": "तान् नदीसलिलाहारान् सदारानमरोपमान् ।\nनित्यं सुखमुदा युक्तान् सर्वालङ्कारशोभितान् ।\nतेभ्यो बहूनि रत्नानि तदा लेभे धनञ्जयः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2120476, "chapter_id": 3584, "verse_number": "३७", "content_sanskrit": "दिव्यजाम्बूनदं हैमभूषणानि च पेशलम् ।\nलब्ध्वा तान् दुर्लभान् पार्थः प्रतीचीं प्रययौ दिशम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2120477, "chapter_id": 3584, "verse_number": "३८", "content_sanskrit": "नारीणां रक्षितं देशमजयच्चार्जुनस्ततः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2120478, "chapter_id": 3584, "verse_number": "३९", "content_sanskrit": "ततो गत्वा महाराज वारुणीं पाकशासनिः ।\nगन्धमादनमासाद्य तत्रस्थानजयत् प्रभुः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2120479, "chapter_id": 3584, "verse_number": "४०", "content_sanskrit": "तं गन्धमादनं राजन्नतिक्रम्य ततोऽर्जुनः ।\nकेतुमालं विवेशाथ वर्षं रत्नसमन्वितम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2120480, "chapter_id": 3584, "verse_number": "४१", "content_sanskrit": "सेवितं देवकल्पैश्च नारीभिः प्रियदर्शनैः ।\nतं जित्वा चार्जुनो राजन् करेण विनिवेश्य च\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2120481, "chapter_id": 3584, "verse_number": "४२", "content_sanskrit": "आहृत्य तत्र रत्नानि दुर्लभानि तथाऽर्जुनः ।\nपुनश्च परिवृत्याथ मध्यं देशमिळावृतम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2120482, "chapter_id": 3584, "verse_number": "४३", "content_sanskrit": "गत्वा प्राचीं दिशं राजन् सव्यसाची परन्तपः ।\nमेरुमन्दरयोर्मध्ये शैलोदामभितो नदीम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2120483, "chapter_id": 3584, "verse_number": "४४", "content_sanskrit": "ये ते कीचकवेणूनां छायां रम्यामुपासते ।\nखषान् झषांश्च नद्योतान् प्रघसान् दीर्घवैणिकान् ।\nपशुपांश्च कुणिन्दांश्च तङ्कणान् परतङ्कणान्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2120484, "chapter_id": 3584, "verse_number": "४५", "content_sanskrit": "एतान् समस्तान् जित्वा स करे च विनिवेश्य च ।\nरत्नान्यादाय सर्वेभ्यो माल्यवन्तं ततो ययौ\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2120485, "chapter_id": 3584, "verse_number": "४६", "content_sanskrit": "तं माल्यवन्तं शैलेन्द्रं समतिक्रम्य पाण्डवः ।\nभद्राश्वं प्रविवेशाथ वर्षं स्वर्गोपमं शुभम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2120486, "chapter_id": 3584, "verse_number": "४७", "content_sanskrit": "तत्रामरोपमान् रम्यान् पुरुषान् सुखसंयुतान् ।\nजित्वा तान् स्ववशे कृत्वा करे च विनिवेश्य च\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2120487, "chapter_id": 3584, "verse_number": "४८", "content_sanskrit": "आहृत्य सर्वरत्नानि असङ्ख्यानि ततस्ततः ।\nनीलं नाम गिरिं गत्वा तत्रस्थानजयत् प्रभुः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2120488, "chapter_id": 3584, "verse_number": "४९", "content_sanskrit": "ततो जिष्णुरतिक्रम्य पर्वतं नीलमायतम् ।\nविवेश रम्यकं वर्षं सङ्कीर्णं मिथुनैः शुभैः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2120489, "chapter_id": 3584, "verse_number": "५०", "content_sanskrit": "तं देशमथ जित्वा स करे च विनिवेश्य च ।\nअजयच्चापि बीभत्सुर्देशं गुह्यकरक्षितम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2120490, "chapter_id": 3584, "verse_number": "५१", "content_sanskrit": "तत्र लेभे च राजेन्द्र सौवर्णान् मृगपक्षिणः ।\nअगृह्णाद् यज्ञभृत्यर्थं रमणीयान् मनोरमान्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2120491, "chapter_id": 3584, "verse_number": "५२", "content_sanskrit": "अन्यांश्च लब्ध्वा रत्नानि पाण्डवोऽथ महाबलः ।\nगन्धर्वरक्षितं देशमजयत् सगणं तदा\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2120492, "chapter_id": 3584, "verse_number": "५३", "content_sanskrit": "तत्र रत्नानि दिव्यानि लब्ध्वा राजन्नथार्जुनः ।\nश्वेतपर्वतमासाद्य जित्वा पर्वतवासिनः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2120493, "chapter_id": 3584, "verse_number": "५४", "content_sanskrit": "स श्वेतं पर्वतं राजन् समतिक्रम्य पाण्डवः ।\nवर्षं हिरण्यकं नाम विवेशाथ महीपते\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2120494, "chapter_id": 3584, "verse_number": "५५", "content_sanskrit": "स तु देशेषु रम्येषु गन्तुं तत्रोपचक्रमे ।\nमध्ये प्रासादवृन्देषु नक्षत्राणां शशी यथा\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2120495, "chapter_id": 3584, "verse_number": "५६", "content_sanskrit": "महापथेषु राजेन्द्र सर्वतो यान्तमर्जुनम् ।\nप्रासादवरशृङ्गस्थाः परया वीर्यशोभया\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2120496, "chapter_id": 3584, "verse_number": "५७", "content_sanskrit": "ददृशुस्ताः स्त्रियः सर्वाः पार्थमात्मयशस्करम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2120497, "chapter_id": 3584, "verse_number": "५८", "content_sanskrit": "तं कलापधरं शूरं सरथं सानुगं प्रभुम् ।\nसवर्मं सकिरीटं वै सन्नद्धं सपरिच्छदम्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2120498, "chapter_id": 3584, "verse_number": "५९", "content_sanskrit": "सुकुमारं महासत्त्वं तेजोराशिमनुत्तमम् ।\nशक्रोपमममित्रघ्नं परवारणवारणम् ।\nपश्यन्तः स्त्रीगणास्तत्र शक्तिपाणिं स्म मेनिरे\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2120499, "chapter_id": 3584, "verse_number": "६०", "content_sanskrit": "अयं स पुरुषव्याघ्रो रणेऽद्भुतपराक्रमः ।\nयस्य बाहुबलं प्राप्य न भवन्त्यसुहृद्गणाः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2120500, "chapter_id": 3584, "verse_number": "समाप्तिः", "content_sanskrit": "इति वाचो ब्रुवन्त्यस्ताः स्त्रियः प्रेम्णा धनञ्जयम् ।\nतुष्टुवुः पुष्पवृष्टिं च ससृजुस्तस्य मूर्धनि\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2120501, "chapter_id": 3584, "verse_number": "६२", "content_sanskrit": "दृष्ट्वा ते तु मुदा युक्ताः कौतूहलसमन्विताः ।\nरत्नैर्विभूषणैश्चैव अभ्यवर्षंश्च पाण्डवम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2120502, "chapter_id": 3584, "verse_number": "६३", "content_sanskrit": "अथ जित्वा समस्तांस्तु करे च विनिवेश्य च\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2120503, "chapter_id": 3584, "verse_number": "६४", "content_sanskrit": "मणिहेमप्रवाळानि रत्नान्याभरणानि च ।\nएतानि लब्ध्वा पार्थोऽपि शृङ्गवन्तं गिरिं ययौ\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2120504, "chapter_id": 3584, "verse_number": "६५", "content_sanskrit": "शृङ्गवन्तं च कौन्तेयः समतिक्रम्य फल्गुनः ।\nउत्तरं कुरुवर्षं तु समासाद्य धनञ्जयः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2120505, "chapter_id": 3584, "verse_number": "६६", "content_sanskrit": "विद्याधरगणांश्चैव यक्षेन्द्रांश्च विनिर्जयन् ।\nतत्र लेभे महाबाहुर्वासो दिव्यमनुत्तमम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2120506, "chapter_id": 3584, "verse_number": "६७", "content_sanskrit": "किन्नरद्रुमपत्रांश्च तत्र कृष्णाजिनान् बहून् ।\nयाज्ञीयांश्चैव यान् दिव्यांस्तान् स लेभे धनञ्जयः ।\nइयेष जेतुं तं देशं पाकशासननन्दनः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2120507, "chapter_id": 3584, "verse_number": "६८", "content_sanskrit": "तत एनं महावीर्यं महाकाया महाबलाः ।\nद्वारपालाः समासाद्य धृष्टं वचनमब्रुवन्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2120508, "chapter_id": 3584, "verse_number": "६९", "content_sanskrit": "पार्थ नेदं त्वया शक्यं पुरं जेतुं कथञ्चन ।\nउपावर्तस्व कल्याण पर्याप्तमिदमच्युत\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2120509, "chapter_id": 3584, "verse_number": "७०", "content_sanskrit": "इदं पुरं यः प्रविशेद् ध्रुवं न स भवेन्नरः ।\nप्रीयामहे त्वया वीर पर्याप्तो विजयस्तव\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2120510, "chapter_id": 3584, "verse_number": "७१", "content_sanskrit": "नचापि किञ्चिज्जेतव्यमर्जुनात्र प्रदृश्यते ।\nउत्तराः कुरवो ह्येते नात्र युद्धं प्रवर्तते\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2120511, "chapter_id": 3584, "verse_number": "७२", "content_sanskrit": "प्रविष्टोऽपि हि कौन्तेय नेह द्रक्ष्यसि किञ्चन ।\nनहि मानुषदेहेन शक्यमत्राभिवीक्षितुम्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2120512, "chapter_id": 3584, "verse_number": "७३", "content_sanskrit": "अथेह पुरुषव्याघ्र किञ्चिदन्यच्चिकीर्षसि ।\nतद्वदस्व करिष्यामो वचनात् तव भारत\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2120513, "chapter_id": 3584, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2120514, "chapter_id": 3584, "verse_number": "७४", "content_sanskrit": "ततस्तानब्रवीद् राजन् पाण्डवः पाकशासनिः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2120515, "chapter_id": 3584, "verse_number": "७५", "content_sanskrit": "पार्थिवत्वं चिकीर्षामि धर्मराजस्य धीमतः ।\nन प्रवेक्ष्यामि वो देशं यद्यदृश्याः स्थ मानुषैः \t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2120516, "chapter_id": 3584, "verse_number": "७६", "content_sanskrit": "युधिष्ठिराय यत् किञ्चित् करं साधु प्रदीयताम्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2120517, "chapter_id": 3584, "verse_number": "७७", "content_sanskrit": "ततो दिव्यानि वस्त्राणि दिव्यान्याभरणानि च ।\nयोगाजिनानि शुभ्राणि तस्मै ते प्रददुः करम्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2120518, "chapter_id": 3584, "verse_number": "७८", "content_sanskrit": "एवं स पुरुषव्याघ्रो विजिग्ये दिशमुत्तराम् ।\nसङ्ग्रामान् विविधान् कृत्वा क्षत्रियैर्दस्युभिस्तथा\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2120519, "chapter_id": 3584, "verse_number": "७९", "content_sanskrit": "स विनिर्जित्य राज्ञस्तान् करे च विनिवेश्य च ।\nधनान्यादाय सर्वेभ्यो रत्नानि विविधानि च\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2120520, "chapter_id": 3584, "verse_number": "८०", "content_sanskrit": "हयांस्तित्तिरिकल्माषान् शुकपत्रनिभानपि ।\nमयूरसदृशानन्यान् सर्वाननिलरंहसः\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2120521, "chapter_id": 3584, "verse_number": "८१", "content_sanskrit": "वृतः स महता राजन् बलेन चतुरङ्गिणा ।\nआजगाम पुनर्वीरः शक्रप्रस्थं पुरोत्तमम्\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2120522, "chapter_id": 3584, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि षड्विंशोऽध्यायः ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2120523, "chapter_id": 3584, "verse_number": "२", "content_sanskrit": "दिग्विजयपर्वणि द्वितीयोऽध्यायः ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2120524, "chapter_id": 3584, "verse_number": "", "content_sanskrit": "—— ०  ——", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}]