[{"id": 2099031, "chapter_id": 3119, "verse_number": "१३-२४९-१", "content_sanskrit": "नारद उवाच।\nएवं ब्रुवन्त्यां स्त्रीधर्मं देव्यां देवस्य शासनात्।\nऋषिगन्धर्वयक्षाणां योषितश्चाप्सरोगणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2099032, "chapter_id": 3119, "verse_number": "१३-२४९-२", "content_sanskrit": "नागभूतस्त्रियश्चैव नद्यश्चैव समागताः।\nश्रुतुकामाः परं वाक्यं सर्वाः पर्यवतस्थिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2099033, "chapter_id": 3119, "verse_number": "१३-२४९-३", "content_sanskrit": "उमादेवी मुदा युक्ता पुज्यमानाऽङ्गनागणैः।\nआनृशंस्यपरा देवी सततं स्त्रीगणं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2099034, "chapter_id": 3119, "verse_number": "१३-२४९-४", "content_sanskrit": "स्त्रीगणस्य हितार्थाय भवप्रियचिकीर्षया।\nवक्तुं वचनमारेभे स्त्रीणां धर्माश्रयान्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2099035, "chapter_id": 3119, "verse_number": "१३-२४९-५x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2099036, "chapter_id": 3119, "verse_number": "१३-२४९-५", "content_sanskrit": "भगवन्सर्वभूतेश श्रूयतां वचनं मम।\nऋतुप्राप्ता सुशुद्दा या कन्या सेत्यभिधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2099037, "chapter_id": 3119, "verse_number": "१३-२४९-६", "content_sanskrit": "तां तु कन्यां पिता माता भ्राता मातुल एव वा।\nपितृव्यश्चैव पञ्चते दातुं प्रभवतां गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2099038, "chapter_id": 3119, "verse_number": "१३-२४९-७", "content_sanskrit": "विवाहाश्च तथा पञ्च तासां धर्मार्थकारणात्।\nकामतश्च मिथो दानमितरेतरकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2099039, "chapter_id": 3119, "verse_number": "१३-२४९-८", "content_sanskrit": "दत्ता यस्य भवेद्भार्या एतेषां येन केन चित्।\nदातारः सुविमृश्यैव दातुमर्हन्ति नान्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2099040, "chapter_id": 3119, "verse_number": "१३-२४९-९", "content_sanskrit": "उत्तमानां तु वर्णानां मन्त्रवत्पाणिसङ्ग्रहः।\nविवाहकारणं चाहुः शूद्राणां सम्प्रयोगतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2099041, "chapter_id": 3119, "verse_number": "१३-२४९-१०", "content_sanskrit": "यदा दत्ता भवेत्कन्या तस्माद्भार्यार्थिने स्वकैः।\nतदाप्रभृति सा नारी दशरात्रं विलज्जया।\nमनसा कर्मणा वाचा अनुकूला च सा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2099042, "chapter_id": 3119, "verse_number": "१३-२४९-११", "content_sanskrit": "इति भर्तृव्रतं कुर्यात्पतिमुद्दिश्य शोभना।\nतदाप्रभृति सा नारी न कुर्यात्पत्युरप्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2099043, "chapter_id": 3119, "verse_number": "१३-२४९-१२", "content_sanskrit": "यद्यदिच्छति वै भर्ता ध्रमकामार्थकारणात्।\nतथैवानुप्रिया भूत्वा तथैवोपचरेत्पतिम्।\nपतिव्रतात्वं नारीणामेतदेव सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2099044, "chapter_id": 3119, "verse_number": "१३-२४९-१३", "content_sanskrit": "तादृशी सा भवेन्नित्यं यादृशस्तु भवेत्पतिः।\nशुभाशुभसमाचार एतद्वृत्तं समासतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2099045, "chapter_id": 3119, "verse_number": "१३-२४९-१४", "content_sanskrit": "दैवतं सततं साध्वी भर्तारं या तु पश्यति।\nदैवमेव भवेत्तस्याः पतिरित्यवगम्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2099046, "chapter_id": 3119, "verse_number": "१३-२४९-१५", "content_sanskrit": "एतस्मिन्कारणं देव पौराणी श्रूयते श्रुतिः।\nकथयामि प्रसादात्ते शृणु देव समासतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2099047, "chapter_id": 3119, "verse_number": "१३-२४९-१६", "content_sanskrit": "कस्य चित्त्वथ विप्रस्य भार्ये द्वे हि बभूवतुः।\nतयोरेका धर्मकामा देवानुद्दिश्य भक्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2099048, "chapter_id": 3119, "verse_number": "१३-२४९-१७", "content_sanskrit": "भर्तारमवमत्यैव देवतासु समाहिता।\nचकार विपुलं धर्मं पूजयानाऽर्चयाऽन्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2099049, "chapter_id": 3119, "verse_number": "१३-२४९-१८", "content_sanskrit": "अपरा धर्मकामा च पतिमुद्दिश्य शोभना।\nभर्तारं दैवतं कृत्वा चकार किल तत्प्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2099050, "chapter_id": 3119, "verse_number": "१३-२४९-१९", "content_sanskrit": "एवं विवर्तमाने तु युगपन्मरणेऽध्वनि।\nगते किल महादेव तत्रैका या पतिव्रता।\nदेवप्रियायां तिष्ठन्त्यां पुण्यलोकं जगाम सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2099051, "chapter_id": 3119, "verse_number": "१३-२४९-२०", "content_sanskrit": "देवप्रिया च तिष्ठन्ती विललाप सुदुःखिता।\nतां यमो लोकपालस्तु बभाषे पुष्कलं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2099052, "chapter_id": 3119, "verse_number": "१३-२४९-२१", "content_sanskrit": "मा शुचस्त्वं निवर्तस्व न लोकाः सन्ति तेऽनघे।\nस्वधर्मविमुखा सा त्वं तस्माल्लोका न सन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2099053, "chapter_id": 3119, "verse_number": "१३-२४९-२२", "content_sanskrit": "देवता हि पतिर्नार्याः स्थापिता सर्वदैवतैः।\nअवमत्य शुभे तत्त्वं कथं लोकान्गमिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2099054, "chapter_id": 3119, "verse_number": "१३-२४९-२३", "content_sanskrit": "मोहेनि त्वं वरारोहे न जानीषे स्वदैवतम्।\nपतिमत्या स्त्रिया कार्यो धर्मः पत्यर्पणस्त्विति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2099055, "chapter_id": 3119, "verse_number": "१३-२४९-२४", "content_sanskrit": "तस्मात्त्वं हि निवर्तस्व कुरु पत्याश्रितं हितम्।\nतदा गन्तासि लोकांस्तान्यान्गच्छन्ति पतिव्रताः।\nनान्यथा शक्यते प्राप्तुं पतीनां लोकमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2099056, "chapter_id": 3119, "verse_number": "१३-२४९-२५", "content_sanskrit": "यमेनैवंविधं चोक्ता निवृत्ता पुनरेव सा।\nबभूव पतिमालम्ब्य पतिप्रियपरायणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2099057, "chapter_id": 3119, "verse_number": "१३-२४९-२६", "content_sanskrit": "एवमेतन्महगादेव दैवतं हि स्त्रियाः पतिः।\nतस्मात्पतिपरा भूत्वा पतीनुपचरेदिति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2099058, "chapter_id": 3119, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकोनपञ्चाशदधिकद्विशततमोऽध्यायः॥ २४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]