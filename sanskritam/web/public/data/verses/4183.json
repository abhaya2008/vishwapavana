[{"id": 2147272, "chapter_id": 4183, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2147273, "chapter_id": 4183, "verse_number": "१", "content_sanskrit": "एवमुक्तः सुपर्णेन तथ्यं वचनमुत्तमम् ।\nविमृश्यावहितो राजा निश्चित्य च पुनः पुनः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2147274, "chapter_id": 4183, "verse_number": "२", "content_sanskrit": "यष्टा क्रतुसहस्राणां दाता दानपतिः प्रभुः ।\nययातिः सूर्यसङ्काश इदं वचनमब्रवीत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2147275, "chapter_id": 4183, "verse_number": "३", "content_sanskrit": "दृष्ट्वा प्रियसखं तार्क्ष्यं गालवं च तपोनिधिम् ।\nनिदर्शनं च तपसो भिक्षां श्लाघ्यां च कीर्तिताम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2147276, "chapter_id": 4183, "verse_number": "४", "content_sanskrit": "अतीत्य च नृपानन्यान् आदित्यकुलसम्भवान् ।\nमत्सकाशमनुप्राप्तावेतां बुद्धिमवेक्ष्य च\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2147277, "chapter_id": 4183, "verse_number": "५", "content_sanskrit": "अद्य मे सफलं जन्म तारितं चाद्य मे कुलम् ।\nअद्यायं पावितो देशो मम तार्क्ष्य त्वयाऽनघ\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2147278, "chapter_id": 4183, "verse_number": "६", "content_sanskrit": "वक्तुमिच्छामि तु सखे यथा जानासि मां पुरा ।\nन तथा वित्तवानस्मि क्षीणं वित्तं हि मे सखे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2147279, "chapter_id": 4183, "verse_number": "७", "content_sanskrit": "न च शक्तोऽस्मि ते कर्तुं मोघमागमनं खग ।\nन चाशामस्य विप्रर्षेर्वितथां कर्तुमुत्सहे\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2147280, "chapter_id": 4183, "verse_number": "८", "content_sanskrit": "पुत्रीं दास्यामि यत् कार्यं द्वयं सम्पादयिष्यति ।\nअभिगम्य हताशो हि निवृत्तो दहते कुलम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2147281, "chapter_id": 4183, "verse_number": "९", "content_sanskrit": "नातः परं वैनतेय किञ्चित् पापिष्ठमुच्यते ।\nयथाऽऽशानाशनं लोके देहि नास्तीति वा वचः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2147282, "chapter_id": 4183, "verse_number": "१०", "content_sanskrit": "हताशो ह्यकृतार्थः सन् हतसम्भावनो नरः ।\nहिनस्ति तस्य पुत्रांश्च पौत्रांश्चाकुर्वतोऽर्थिताम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2147283, "chapter_id": 4183, "verse_number": "११", "content_sanskrit": "तस्माच्चतुर्णां वर्णानां स्थापयित्री सुता मम ।\nमाधवी नाम तार्क्ष्येयं सर्वधर्मप्रदायिनी\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2147284, "chapter_id": 4183, "verse_number": "१२", "content_sanskrit": "इयं सुरसुतप्रख्या सर्वधर्मोपचायिनी\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2147285, "chapter_id": 4183, "verse_number": "१३", "content_sanskrit": "सदा देवमनुष्याणामसुराणां च गालव ।\nकाङ्क्षिता रूपतो बाला सुता मे प्रतिगृह्यताम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2147286, "chapter_id": 4183, "verse_number": "१४", "content_sanskrit": "अस्याः शुल्कं प्रदास्यन्ति नृपा राज्यमपि ध्रुवम् ।\nकिं पुनः श्यामकर्णानां हयानां द्वे चतुःशते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2147287, "chapter_id": 4183, "verse_number": "१५", "content_sanskrit": "स भवान् प्रतिगृह्णातु ममैतां माधवीं सुताम् ।\nदौहित्रपूतः स्यामेष एष मे स्याद् वरः प्रभो\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2147288, "chapter_id": 4183, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2147289, "chapter_id": 4183, "verse_number": "१६", "content_sanskrit": "स तस्य वचनं श्रुत्वा ब्राह्मणः शंसितव्रतः ।\nप्रतिगृह्य च तां कन्यां गालवः सह पक्षिणा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2147290, "chapter_id": 4183, "verse_number": "१७", "content_sanskrit": "पुनर्द्रक्ष्याव इत्युक्त्वा प्रतस्थे सह कन्यया\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2147291, "chapter_id": 4183, "verse_number": "१८", "content_sanskrit": "उपलब्धमिदं द्वारमश्वानामिति चाण्डजः ।\nउक्त्वा गालवमापृच्छ्य जगाम भवनं प्रति\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2147292, "chapter_id": 4183, "verse_number": "१९", "content_sanskrit": "गते पतगराजे तु गालवः सह कन्यया ।\nचिन्तयानः क्षमं दाने राजानं शुल्कतोऽगमत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2147293, "chapter_id": 4183, "verse_number": "२०", "content_sanskrit": "सोऽगच्छन्मनसैक्ष्वाकं हर्यश्वं राजसत्तमम् ।\nअयोध्यायां महावीर्यं चतुरङ्गबलान्वितम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2147294, "chapter_id": 4183, "verse_number": "२१", "content_sanskrit": "कोशधान्यबलोपेतं प्रियपौरं प्रियद्विजम् ।\nप्रजाभिकामं शाम्यन्तं कुर्वाणं तप उत्तमम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2147295, "chapter_id": 4183, "verse_number": "२२", "content_sanskrit": "तमुपागम्य विप्रः स हर्यश्वं गालवोऽब्रवीत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2147296, "chapter_id": 4183, "verse_number": "२३", "content_sanskrit": "कन्येयं मम राजेन्द्र प्रसवैः कुलवर्धिनी ।\nइयं शुल्केन भार्यार्थे हर्यश्व प्रतिगृह्यताम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2147297, "chapter_id": 4183, "verse_number": "२४", "content_sanskrit": "शुल्कं ते कीर्तयिष्यामि तच्छ्रुत्वा सम्प्रधार्यताम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2147298, "chapter_id": 4183, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि चतुर्दशोत्तरशततमोऽध्यायः ॥११४॥\nभगवद्यानपर्वणि पञ्चचत्वारिंशोऽध्यायः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]