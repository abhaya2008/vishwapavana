[{"id": 5000250000, "chapter_id": 9250, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे चतुःपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000250001, "chapter_id": 9250, "verse_number": "३-५४-१", "content_sanskrit": "ह्रियमाणा तु वैदेही कंचिन्नाथमपश्यती।\nददर्श गिरिशृङ्गस्थान् पञ्च वानरपुङ्गवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000250002, "chapter_id": 9250, "verse_number": "३-५४-२", "content_sanskrit": "तेषां मध्ये विशालाक्षी कौशेयं कनकप्रभम्।\nउत्तरीयं वरारोहा शुभान्याभरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000250003, "chapter_id": 9250, "verse_number": "३-५४-३", "content_sanskrit": "मुमोच यदि रामाय शंसेयुरिति भामिनी।\nवस्त्रमुत्सृज्य तन्मध्ये निक्षिप्तं सहभूषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000250004, "chapter_id": 9250, "verse_number": "३-५४-४", "content_sanskrit": "सम्भ्रमात् तु दशग्रीवस्तत्कर्म च न बुद्धवान्।\nपिङ्गाक्षास्तां विशालाक्षीं नेत्रैरनिमिषैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000250005, "chapter_id": 9250, "verse_number": "३-५४-५", "content_sanskrit": "विक्रोशन्तीं तदा सीतां ददृशुर्वानरोत्तमाः।\nस च पम्पामतिक्रम्य लङ्कामभिमुखः पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000250006, "chapter_id": 9250, "verse_number": "३-५४-६", "content_sanskrit": "जगाम मैथिलीं गृह्य रुदतीं राक्षसेश्वरः।\nतां जहार सुसंहृष्टो रावणो मृत्युमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000250007, "chapter_id": 9250, "verse_number": "३-५४-७", "content_sanskrit": "उत्सङ्गेनैव भुजगीं तीक्ष्णदंष्ट्रां महाविषाम्।\nवनानि सरितः शैलान् सरांसि च विहायसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000250008, "chapter_id": 9250, "verse_number": "३-५४-८", "content_sanskrit": "स क्षिप्रं समतीयाय शरश्चापादिव च्युतः।\nतिमिनक्रनिकेतं तु वरुणालयमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000250009, "chapter_id": 9250, "verse_number": "३-५४-९", "content_sanskrit": "सरितां शरणं गत्वा समतीयाय सागरम्।\nसम्भ्रमात् परिवृत्तोर्मी रुद्धमीनमहोरगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000250010, "chapter_id": 9250, "verse_number": "३-५४-१०", "content_sanskrit": "वैदेह्यां ह्रियमाणायां बभूव वरुणालयः।\nअन्तरिक्षगता वाचः ससृजुश्चारणास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000250011, "chapter_id": 9250, "verse_number": "३-५४-११", "content_sanskrit": "एतदन्तो दशग्रीव इति सिद्धास्तथाब्रुवन्।\nस तु सीतां विचेष्टन्तीमङ्केनादाय रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000250012, "chapter_id": 9250, "verse_number": "३-५४-१२", "content_sanskrit": "प्रविवेश पुरीं लङ्कां रूपिणीं मृत्युमात्मनः।\nसोऽभिगम्य पुरीं लङ्कां सुविभक्तमहापथाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000250013, "chapter_id": 9250, "verse_number": "३-५४-१३", "content_sanskrit": "संरूढकक्ष्यां बहुलां स्वमन्तःपुरमाविशत्।\nतत्र तामसितापाङ्गीं शोकमोहसमन्विताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000250014, "chapter_id": 9250, "verse_number": "३-५४-१४", "content_sanskrit": "निदधे रावणः सीतां मयो मायामिवासुरीम्।\nअब्रवीच्च दशग्रीवः पिशाचीर्घोरदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000250015, "chapter_id": 9250, "verse_number": "३-५४-१५", "content_sanskrit": "यथा नैनां पुमान् स्त्री वा सीतां पश्यत्यसम्मतः।\nमुक्तामणिसुवर्णानि वस्त्राण्याभरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000250016, "chapter_id": 9250, "verse_number": "३-५४-१६", "content_sanskrit": "यद् यदिच्छेत् तदैवास्या देयं मच्छन्दतो यथा।\nया च वक्ष्यति वैदेहीं वचनं किंचिदप्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000250017, "chapter_id": 9250, "verse_number": "३-५४-१७", "content_sanskrit": "अज्ञानाद् यदि वा ज्ञानान्न तस्या जीवितं प्रियम्।\nतथोक्त्वा राक्षसीस्तास्तु राक्षसेन्द्रः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000250018, "chapter_id": 9250, "verse_number": "३-५४-१८", "content_sanskrit": "निष्क्रम्यान्तःपुरात् तस्मात् किं कृत्यमिति चिन्तयन्।\nददर्शाष्टौ महावीर्यान् राक्षसान् पिशिताशनान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000250019, "chapter_id": 9250, "verse_number": "३-५४-१९", "content_sanskrit": "स तान् दृष्ट्वा महावीर्यो वरदानेन मोहितः।\nउवाच तानिदं वाक्यं प्रशस्य बलवीर्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000250020, "chapter_id": 9250, "verse_number": "३-५४-२०", "content_sanskrit": "नानाप्रहरणाः क्षिप्रमितो गच्छत सत्वराः।\nजनस्थानं हतस्थानं भूतपूर्वं खरालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000250021, "chapter_id": 9250, "verse_number": "३-५४-२१", "content_sanskrit": "तत्रास्यतां जनस्थाने शून्ये निहतराक्षसे।\nपौरुषं बलमाश्रित्य त्रासमुत्सृज्य दूरतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000250022, "chapter_id": 9250, "verse_number": "३-५४-२२", "content_sanskrit": "बहुसैन्यं महावीर्यं जनस्थाने निवेशितम्।\nसदूषणखरं युद्धे निहतं रामसायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000250023, "chapter_id": 9250, "verse_number": "३-५४-२३", "content_sanskrit": "ततः क्रोधो ममापूर्वो धैर्यस्योपरि वर्धते।\nवैरं च सुमहज्जातं रामं प्रति सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000250024, "chapter_id": 9250, "verse_number": "३-५४-२४", "content_sanskrit": "निर्यातयितुमिच्छामि तच्च वैरं महारिपोः।\nनहि लप्स्याम्यहं निद्रामहत्वा संयुगे रिपुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000250025, "chapter_id": 9250, "verse_number": "३-५४-२५", "content_sanskrit": "तं त्विदानीमहं हत्वा खरदूषणघातिनम्।\nरामं शर्मोपलप्स्यामि धनं लब्ध्वेव निर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000250026, "chapter_id": 9250, "verse_number": "३-५४-२६", "content_sanskrit": "जनस्थाने वसद्भिस्तु भवद्भी राममाश्रिता।\nप्रवृत्तिरुपनेतव्या किं करोतीति तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000250027, "chapter_id": 9250, "verse_number": "३-५४-२७", "content_sanskrit": "अप्रमादाच्च गन्तव्यं सर्वैरेव निशाचरैः।\nकर्तव्यश्च सदा यत्नो राघवस्य वधं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000250028, "chapter_id": 9250, "verse_number": "३-५४-२८", "content_sanskrit": "युष्माकं तु बलं ज्ञातं बहुशो रणमूर्धनि।\nअतश्चास्मिञ्जनस्थाने मया यूयं निवेशिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000250029, "chapter_id": 9250, "verse_number": "३-५४-२९", "content_sanskrit": "ततः प्रियं वाक्यमुपेत्य राक्षसा\nमहार्थमष्टावभिवाद्य रावणम्।\nविहाय लङ्कां सहिताः प्रतस्थिरे\nयतो जनस्थानमलक्ष्यदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000250030, "chapter_id": 9250, "verse_number": "३-५४-३०", "content_sanskrit": "ततस्तु सीतामुपलभ्य रावणः\nसुसम्प्रहृष्टः परिगृह्य मैथिलीम्।\nप्रसज्य रामेण च वैरमुत्तमं\nबभूव मोहान्मुदितः स रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000250031, "chapter_id": 9250, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे चतुःपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]