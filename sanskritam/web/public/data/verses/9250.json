[{"id": 40016630, "chapter_id": 9250, "verse_number": "1", "content_sanskrit": "स तुराक्षसशार्दूलोनिद्रामदसमाकुलः । राजमार्गंश्रियाजुष्टंययौविपुलविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40016631, "chapter_id": 9250, "verse_number": "2", "content_sanskrit": "राक्षसानांसहस्रैश्चवृतःपरमदुर्जयः । गृहेभ्यःपुष्पवर्षेणकीर्यमाणस्तदाययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40016632, "chapter_id": 9250, "verse_number": "3", "content_sanskrit": "स हेमजालविततंभानुभास्वरदर्शनम् । ददर्शविपुलंरम्यंराक्षसेन्द्रनिवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40016633, "chapter_id": 9250, "verse_number": "4", "content_sanskrit": "स तत्तदासूर्यइवाभ्रजालंप्रविश्यरक्षोधिपतेर्निवेशम् । ददर्शदूरेऽग्रजमासनस्थंस्वयम्भुवंशक्रवासनस्थम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40016634, "chapter_id": 9250, "verse_number": "5", "content_sanskrit": "भ्रातुस्सभवनंगच्छन्रक्षोगणसमन्विम् । कुम्भकर्णःपदन्यासैरकम्पयतमेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40016635, "chapter_id": 9250, "verse_number": "6", "content_sanskrit": "सोऽभिगम्यगृहंभ्रातुःकक्ष्यामभिविगाह्य च । ददर्शोद्विगन्नमासीनंविमानेपुष्पकेगुरुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40016636, "chapter_id": 9250, "verse_number": "7", "content_sanskrit": "अथदृष्टवादशग्रीवःकुम्भकर्णमुपस्थितम् । तूर्णमुत्थायसंहृष्टःसन्निकर्षमुपानयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40016637, "chapter_id": 9250, "verse_number": "8", "content_sanskrit": "अथासीनस्यपर्यङ्केकुम्भकर्णोमहाबलः । भ्रातुर्ववन्देचरणौकिंकृत्यमितिचाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40016638, "chapter_id": 9250, "verse_number": "9", "content_sanskrit": "उत्पत्यचैनंमुदितोरावणःपरिषस्वजे । स भ्रात्रासम्परिष्वक्तोयथावच्छाभिनन्दितः ॥ कुम्भकर्णश्शुभंदिव्यंप्रतिपेदेवरासनम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40016639, "chapter_id": 9250, "verse_number": "10", "content_sanskrit": "स तदासनमाश्रित्यकुम्भकर्णोमहाबलः ॥ संरक्तनयनःक्रोधाद्रावणंवाक्यमब्रवीत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40016640, "chapter_id": 9250, "verse_number": "11", "content_sanskrit": "किमर्थमहमादृत्यत्वयाराजन्विबोधितः ॥ शंसकस्माद्भयंतेऽत्रकोऽद्यप्रेतोभविष्यति ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40016641, "chapter_id": 9250, "verse_number": "12", "content_sanskrit": "भ्रातरंरावणःक्रुद्धंकुम्भकर्णमवस्थितम् ॥ ईषत्तुपरिवृत्ताभ्यांनेत्राभ्यांवाक्यमब्रवीत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40016642, "chapter_id": 9250, "verse_number": "13", "content_sanskrit": "अद्यतेसुमहान्कालश्शयानस्यमहाबल ॥ सुखितस्त्वं न जानीषेममरामकृतंभयम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40016643, "chapter_id": 9250, "verse_number": "14", "content_sanskrit": "एषदाशरथीरामःसुग्रीवसहितोबली ॥ समुद्रंसबलस्तीर्त्वामूलंनःपरिकृन्तति ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40016644, "chapter_id": 9250, "verse_number": "15", "content_sanskrit": "हन्तपश्यस्वलङ्कायावनान्युपवनानि च ॥ सेतुनासुखमागम्यवानरैकार्णवीकृतम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40016645, "chapter_id": 9250, "verse_number": "16", "content_sanskrit": "येराक्षसामुख्यतमाहतास्तेवानरैर्युधि ॥ वानराणांक्षयंयुद्धे न पश्यामिकदाचन । नचापिवानरायुद्धेजितपूर्वाःकदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40016646, "chapter_id": 9250, "verse_number": "17", "content_sanskrit": "येराक्षसामुख्यतमाहतास्तेवानरैर्युधि ॥ वानराणांक्षयंयुद्धे न पश्यामिकदाचन । नचापिवानरायुद्धेजितपूर्वाःकदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40016647, "chapter_id": 9250, "verse_number": "18", "content_sanskrit": "तदेतद्भयमुत्पन्नंत्रायस्वेमांमहबल । नाशयत्वमिमानद्यतदर्थंबोधितोभवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40016648, "chapter_id": 9250, "verse_number": "19", "content_sanskrit": "सर्वक्षपितकोशं च स त्वमभ्यवपद्यमाम् । त्रायस्वेमांपुरींलङ्कांबालवृद्धावशेषिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40016649, "chapter_id": 9250, "verse_number": "20", "content_sanskrit": "भ्रातुरर्थेमहाबाहो कुरुकर्मसुदुष्करम् । मयैवंनोक्तपूर्वोहिकश्चिद्भ्रातः परन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40016650, "chapter_id": 9250, "verse_number": "21", "content_sanskrit": "त्वय्यस्तिममस्नेहःपरासम्भावना च मे । दैवासुरेषुयुद्धेषुबहुशोराक्षसर्षभ ॥ त्वयादेवाःप्रतिव्यूह्यनिर्जिताश्चासुरायुधि ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40016651, "chapter_id": 9250, "verse_number": "22", "content_sanskrit": "तदेतत्सर्वमातिष्ठवीर्यंभीमपराक्रम ॥ न हितेसर्वभूतेषुदृश्यतेसदृशोबली ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40016652, "chapter_id": 9250, "verse_number": "23", "content_sanskrit": "कुरुष्वमेप्रियहितमेतदुत्तमंयथाप्रियंप्रियरणबान्धवप्रिय । स्वतेजसाविधमसपत्नवाहिनींशरद्घनंपवनइवोद्यतोमहान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]