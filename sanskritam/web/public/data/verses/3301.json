[{"id": 2106131, "chapter_id": 3301, "verse_number": "१६-३०-१", "content_sanskrit": "वैशम्पायन उवाच।\nततः समुपविष्टेषु पाण्डवेषु महात्मसु।\nव्यासः सत्यवतीपुत्रः प्रोवाचामन्त्र्य पार्थिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2106132, "chapter_id": 3301, "verse_number": "१६-३०-२", "content_sanskrit": "धृतराष्ट्र महाबाहो कच्चित्ते वर्तते तपः।\nकच्चिन्मनस्ते प्रीणाति वनवासे नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2106133, "chapter_id": 3301, "verse_number": "१६-३०-३", "content_sanskrit": "कच्चिद्धृदि न ते शोको राजन्पुत्रविनाशजः।\nकच्चिज्ज्ञानानि सर्वाणि सुप्रसन्नानि तेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2106134, "chapter_id": 3301, "verse_number": "१६-३०-४", "content_sanskrit": "कच्चिद्बुद्धिं दृढां कृत्वा चरस्यारण्यकं विधिम्।\nकच्चिद्वधूश्च गान्धारी न शोकेनाभिभूयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2106135, "chapter_id": 3301, "verse_number": "१६-३०-५", "content_sanskrit": "महाप्रज्ञा बुद्धिमती देवी धर्मार्थदर्शिनी।\nआगमापायतत्त्वज्ञा कच्चिदेषा न शोचति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2106136, "chapter_id": 3301, "verse_number": "१६-३०-६", "content_sanskrit": "कच्चित्कुन्ती च राजंस्त्वां शुश्रूषत्यनहङ्कृता।\nया परित्यज्य स्वं पुत्रं गुरुशुश्रूषणे रता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2106137, "chapter_id": 3301, "verse_number": "१६-३०-७", "content_sanskrit": "कच्चिद्धर्मसुतो राजा त्वया प्रत्यभिनन्दितः।\nभीमार्जुनयमाश्चैव कच्चिदेतेऽपि सान्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2106138, "chapter_id": 3301, "verse_number": "१६-३०-८", "content_sanskrit": "कच्चिन्नन्दसि दृष्ट्रैतान्कच्चिते निर्मलं मनः।\nकच्चिच्च शुद्धभावोसि जातज्ञानो नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2106139, "chapter_id": 3301, "verse_number": "१६-३०-९", "content_sanskrit": "एतद्धि त्रितयं श्रेष्ठं सर्वभूतेषु भारत।\nनिर्वैरता महाराज सत्यमक्रोध एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2106140, "chapter_id": 3301, "verse_number": "१६-३०-१०", "content_sanskrit": "कच्चित्ते न च मोहोस्ति वनवासेन भारत।\nस्वदत्ते वन्यमन्नं वा उपवासोपि वा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2106141, "chapter_id": 3301, "verse_number": "१६-३०-११", "content_sanskrit": "विदितं चापि राजेन्द्र विदुरस्य महात्मनः।\nगमनं विधिनाऽनेन धर्मस्य सुमहात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2106142, "chapter_id": 3301, "verse_number": "१६-३०-१२", "content_sanskrit": "माण्डव्यशापाद्धि स वै धर्मो विदुरतां गतः।\nमहाबुद्धिर्महायोगी महात्मा सुमहामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2106143, "chapter_id": 3301, "verse_number": "१६-३०-१३", "content_sanskrit": "बृहस्पतिर्वा देवेषु शुक्रो वाऽप्यसुरेषु च।\nन तथा बुद्धिसम्पन्नो यथा स पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2106144, "chapter_id": 3301, "verse_number": "१६-३०-१४", "content_sanskrit": "तपोबलव्ययं कृत्वा सुचिरात्सम्भृतं तदा।\nमाण्डव्येनर्षिणा धर्मो ह्यभिभूतः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2106145, "chapter_id": 3301, "verse_number": "१६-३०-१५", "content_sanskrit": "नियोगाद्ब्रह्मणः पूर्वं मया स्वेन बलेन च।\nवैचित्रवीर्यके क्षेत्रे जातः स सुमहामतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2106146, "chapter_id": 3301, "verse_number": "१६-३०-१६", "content_sanskrit": "भ्राता तव महाराज देवदेवः सनातनः।\nधारणान्मनसा ध्यानाद्य धर्म कवयो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2106147, "chapter_id": 3301, "verse_number": "१६-३०-१७", "content_sanskrit": "सत्येन संवर्धयति यो दमेन शमेन च।\nअहिंसया च दानेन तपसा च सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2106148, "chapter_id": 3301, "verse_number": "१६-३०-१८", "content_sanskrit": "येन योगबलाज्जातः कुरुराजो युधिष्ठिरः।\nधर्म इत्येष नृपते प्राज्ञेनामितबुद्धिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2106149, "chapter_id": 3301, "verse_number": "१६-३०-१९", "content_sanskrit": "यथा वह्निर्यथा वायुर्यथाऽऽपः पृथिवी यथा।\nयथाऽऽकाशं तथा धर्म इह चामुत्र च स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2106150, "chapter_id": 3301, "verse_number": "१६-३०-२०", "content_sanskrit": "सर्वगश्चैव राजेन्द्र सर्वं व्याप्य चराचरम्।\nदृश्यते देवदेवैः स सिद्धैर्निर्मुक्तकल्मषैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2106151, "chapter_id": 3301, "verse_number": "१६-३०-२१", "content_sanskrit": "यो हि धर्मः स विदुरो विदुरो यः स पाण्डवः।\nस एष राजन्दृश्यस्ते माण्डवः प्रेष्यवत्स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2106152, "chapter_id": 3301, "verse_number": "१६-३०-२२", "content_sanskrit": "प्रविष्टः स महात्मानं भ्राता ते बुद्धिसम्मतः।\nदृष्ट्वा महात्मा कौन्तेयं महायोगबलान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2106153, "chapter_id": 3301, "verse_number": "१६-३०-२३", "content_sanskrit": "त्वां चापि श्रेयसा योक्ष्ये नचिराद्भरतर्षभ।\nसंशयच्छेदनार्थाय प्राप्तं मां विद्धि पुत्रक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2106154, "chapter_id": 3301, "verse_number": "१६-३०-२४", "content_sanskrit": "न कृतं यैः पुरा कैश्चित्कर्म लोके महर्षिभिः।\nआश्चर्यभूतं तपसः फलं तद्दर्शयामि वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2106155, "chapter_id": 3301, "verse_number": "१६-३०-२५", "content_sanskrit": "किमिच्छसि महीपाल मत्तः प्राप्तुमभीप्सितम्।\nद्रष्ट्रुं स्प्रष्टुमथ श्रोतुं तत्कर्तास्मि तवानघ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2106156, "chapter_id": 3301, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि आश्रमवासपर्वणि त्रिंशोऽध्यायः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]