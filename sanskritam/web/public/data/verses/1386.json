[{"id": 2018511, "chapter_id": 1386, "verse_number": "३-२४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2018512, "chapter_id": 1386, "verse_number": "३-२४-१", "content_sanskrit": "ततस्तेषु प्रयातेषु कौन्तेयः सत्यसंगरः।\nअभ्यभाषत धर्मात्मा भ्रातॄन्सर्वान्युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2018513, "chapter_id": 1386, "verse_number": "३-२४-२", "content_sanskrit": "द्वादशेमाः समाऽस्माभिर्वस्तव्यं निर्जने वने।\nसमीक्षध्वं महारण्ये देशं बहुमृगद्विजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2018514, "chapter_id": 1386, "verse_number": "३-२४-३", "content_sanskrit": "बहुपुष्पफलं रम्यं शिवं पुण्यजनोचितम्।\nयत्रेमा द्वादश समाः सुखं प्रतिवसेमहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2018515, "chapter_id": 1386, "verse_number": "३-२४-४", "content_sanskrit": "एवमुक्ते प्रत्युवाच धर्मराजं धनंजयः।\nगुरुवन्मानववरं मानयित्वा मनस्विनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2018516, "chapter_id": 1386, "verse_number": "३-२४-५", "content_sanskrit": "भवानेव महर्षीणां वृद्धानां पर्युपासिता।\nअज्ञातं मानुषे लोके भवतो नास्ति किंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2018517, "chapter_id": 1386, "verse_number": "३-२४-६", "content_sanskrit": "त्वया ह्युपासिता नित्यं ब्राह्मणा वेदपारगाः।\nद्वैपायनप्रभृतयो नारदश्च महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2018518, "chapter_id": 1386, "verse_number": "३-२४-७", "content_sanskrit": "यः सर्वलोकद्वाराणि नित्यं संचरते वशी।\nदेवलोकाद्ब्रह्मलोकं गन्धर्वाप्सरसामपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2018519, "chapter_id": 1386, "verse_number": "३-२४-८", "content_sanskrit": "अनुभावांश्च जानासि ब्राह्मणानां न संशयः।\nप्रभावांश्चैव वेत्थ त्वं सर्वेषामेव पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2018520, "chapter_id": 1386, "verse_number": "३-२४-९", "content_sanskrit": "त्वमेव राजञ्जानासि श्रेयःकारणमेव च।\nयत्रेच्छसि महाराज निवासं तत्र कुंर्महे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2018521, "chapter_id": 1386, "verse_number": "३-२४-१०", "content_sanskrit": "इदं द्वैतवनं नाम सरः पुण्यजनोषितम्।\nबहुपुष्पफलं रम्यं नानाद्विजनिषेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2018522, "chapter_id": 1386, "verse_number": "३-२४-११", "content_sanskrit": "अत्रेमा द्वादश समा विहरेमेति रोचये।\nयदि तेऽनुमतं राजन्किमन्यन्मन्यते भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2018523, "chapter_id": 1386, "verse_number": "३-२४-१२x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2018524, "chapter_id": 1386, "verse_number": "३-२४-१२", "content_sanskrit": "ममाप्येतन्मतं पार्थ त्वया यत्समुदाहृतम्।\nगच्छामः पुण्यविख्यातं महद्द्वैतवनं सरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2018525, "chapter_id": 1386, "verse_number": "३-२४-१३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2018526, "chapter_id": 1386, "verse_number": "३-२४-१३", "content_sanskrit": "ततस्ते प्रययुः सर्वे पाण्डवा धर्मचारिणः।\nब्राह्मणैर्बहुभिः सार्धं पुण्यं द्वैतवनं सरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2018527, "chapter_id": 1386, "verse_number": "३-२४-१४", "content_sanskrit": "ब्राह्मणाः साग्निहोत्राश्च तथैव च निरग्नयः।\nस्वाध्यायिनो भिक्षवश्च तथैव वनवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2018528, "chapter_id": 1386, "verse_number": "३-२४-१५", "content_sanskrit": "बहवो ब्राह्मणास्तत्र परिवव्रुर्युधिष्ठिरम्।\nतपस्विनः सत्यशीलाः शतशः संशितव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2018529, "chapter_id": 1386, "verse_number": "३-२४-१६", "content_sanskrit": "ते यात्वा पाण्डवास्तत्रब्राह्मणैर्बहुभिः सह।\nपुण्यं द्वैतवनं रम्यं विविशुर्बरतर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2018530, "chapter_id": 1386, "verse_number": "३-२४-१७", "content_sanskrit": "तत्सालतालाम्रमधूकनीप-\nकदम्बसर्जार्जुनकर्णिकारैः।\nतपात्यये पुष्पधरैरुपेतं\nमहावनं राष्ट्रपतिर्ददर्श ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2018531, "chapter_id": 1386, "verse_number": "३-२४-१८", "content_sanskrit": "महाद्रुमाणां शिखरेषु तस्थु-\nर्मनोरमां वाचमुदीरयन्तः।\nमयूरदात्यूहचकोरसङ्घा-\nस्तस्मिन्वने बर्हिणकोकिलाश्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2018532, "chapter_id": 1386, "verse_number": "३-२४-१९", "content_sanskrit": "करेणुयूथैः सह यूथपानां\nमदोत्कटानामचलप्रभाणाम्।\nमहान्ति यूथानि महाद्विपानां\nतस्मिन्वने राष्ट्रपतिर्ददर्श ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2018533, "chapter_id": 1386, "verse_number": "३-२४-२०", "content_sanskrit": "मनोरमां भोगवतीमुपेत्य\nपूतात्मनां चीरजटाधराणाम्।\nतस्मिन्वने धर्मभृतां निवासे\nददर्श सिद्धर्षिगणाननेकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2018534, "chapter_id": 1386, "verse_number": "३-२४-२१", "content_sanskrit": "ततः स यानादवरुह्य राजा\nसभ्रातृकः सजनः काननं तत्।\nविवेश धर्मात्मवतां बरिष्ठ-\nस्त्रिविष्टपं शक्र इवामितौजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2018535, "chapter_id": 1386, "verse_number": "३-२४-२२", "content_sanskrit": "तं सत्यसन्धं सहिताऽभिपेतु-\nर्दिदृक्षवश्चारणसिद्धसङ्घाः।\nवनौकसश्चापि नेरन्द्रसिंहं\nमनस्विनं तं परिवार्य तस्थुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2018536, "chapter_id": 1386, "verse_number": "३-२४-२३", "content_sanskrit": "स तत्रवृद्धानभिवाद्य सर्वान्\nप्रत्यर्चितो राजवद्देववच्च।\nविवेश सर्वैः सहितो द्विजाग्र्यैः\nकृताञ्जलिर्धर्मभृतां वरिष्ठः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2018537, "chapter_id": 1386, "verse_number": "३-२४-२४", "content_sanskrit": "स पुण्यशीलः पितृवन्महात्मा\nतपस्विभिर्मपरैरुपेत्य।\nप्रत्यर्चितः पुष्पधरस्य मूले\nमहाद्रुमस्योपविवेश राजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2018538, "chapter_id": 1386, "verse_number": "३-२४-२५", "content_sanskrit": "भीमश्च कृष्णा च धनंजयश्च\nयमौ च ते चानुचरा नरेन्द्रम्।\nविमुच्यवाहानवशाश्च सर्वे\nतत्रोपतस्थुर्भरतप्रबर्हाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2018539, "chapter_id": 1386, "verse_number": "३-२४-२६", "content_sanskrit": "लतावतानावनतः स पाण्डवै-\nर्महाद्रुमः पञ्चभिरेव धन्विभिः।\nबभौ निवासोपगतैर्महात्मभि-\nर्महागिरिर्वारणयूथपैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2018540, "chapter_id": 1386, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि अर्जुनाभिगमनपर्वणि चतुर्विंशोऽध्यायः ॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]