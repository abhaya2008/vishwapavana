[{"id": 2188641, "chapter_id": 5009, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2188642, "chapter_id": 5009, "verse_number": "१", "content_sanskrit": "यदिदं कर्म लोकेऽस्मिन् शुभं वा यदि वाशुभम् ।\nपुरुषं योजयत्येव फलयोगेन भारत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2188643, "chapter_id": 5009, "verse_number": "२", "content_sanskrit": "कर्ता स्वित् तस्य पुरुष उताहो नेति संशयः ।\nएतदिच्छामि तत्त्वेन त्वत्तः श्रोतुं पितामह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2188644, "chapter_id": 5009, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2188645, "chapter_id": 5009, "verse_number": "३", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nप्रह्रादस्य च संवादमिन्द्रस्य च युधिष्ठिर\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2188646, "chapter_id": 5009, "verse_number": "४", "content_sanskrit": "असक्तं धूतपाप्मानं कुले जातं बहुश्रुतम् ।\nअस्तम्भमनहङ्कारं सत्त्वस्थं समये रतम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2188647, "chapter_id": 5009, "verse_number": "५", "content_sanskrit": "तुल्यनिन्दास्तुतिं दान्तं शून्यागारनिवेशनम् ।\nचराचराणां भूतानां विदितप्रभवाप्ययम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2188648, "chapter_id": 5009, "verse_number": "६", "content_sanskrit": "अक्रुद्ध्यन्तमहृष्यन्तमप्रियेषु प्रियेषु च ।\nकाञ्चने वाथ लोष्टे वा उभयोः समदर्शनम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2188649, "chapter_id": 5009, "verse_number": "७", "content_sanskrit": "आत्मनिःश्रेयसज्ञाने धीरं निश्चितनिश्चयम् ।\nपरावरज्ञं भूतानां सर्वज्ञं समदर्शनम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2188650, "chapter_id": 5009, "verse_number": "८", "content_sanskrit": "अव्यक्तात्मनि गोविन्दे वासुदेवे महात्मनि ।\nहृदयेन समाविष्टं सर्वभावप्रियङ्करम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2188651, "chapter_id": 5009, "verse_number": "९", "content_sanskrit": "भक्तं भागवतं नित्यं नारायणपरायणम् ।\nध्यायन्तं परमात्मानं हिरण्यकशिपोः सुतम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2188652, "chapter_id": 5009, "verse_number": "१०", "content_sanskrit": "शक्रः प्रह्रादमासीनमेकान्ते संयतेन्द्रियम् ।\nबुभुत्समानस्तत् प्रज्ञामभिगम्येदमब्रवीत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2188653, "chapter_id": 5009, "verse_number": "११", "content_sanskrit": "यैः कैश्चित् सम्मतो लोके गुणैः स्यात् पुरुषो नृषु ।\nभवत्यनपगान् सर्वांस्तान् गुणाँल्लक्षयामहे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2188654, "chapter_id": 5009, "verse_number": "१२", "content_sanskrit": "अथ ते लक्ष्यते बुद्धिः समा बालजनैरिह ।\nआत्मानं मन्यमानः संश्रेयः किमिह मन्यसे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2188655, "chapter_id": 5009, "verse_number": "१३", "content_sanskrit": "बद्धः पाशैश्च्युतः स्थानाद्द्विषतां वशमागतः ।\nश्रिया विहीनः प्रह्राद शोचितव्ये न शोचसि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2188656, "chapter_id": 5009, "verse_number": "१४", "content_sanskrit": "प्रज्ञालाभात् तु दैतेय उताहो धृतिमत्तया ।\nप्रह्राद स्वस्थरूपोऽसि पश्यन् व्यसनमात्मनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2188657, "chapter_id": 5009, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2188658, "chapter_id": 5009, "verse_number": "समाप्तिः", "content_sanskrit": "इति सञ्चोदितस्तेन धीरो निश्चितनिश्चयः ।\nउवाच श्लक्ष्णया वाचा स्वां प्रज्ञामनुवर्णयन्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2188659, "chapter_id": 5009, "verse_number": "", "content_sanskrit": "प्रह्लादः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2188660, "chapter_id": 5009, "verse_number": "१६", "content_sanskrit": "प्रवृत्तिं च निवृत्तिं च भूतानां यो न बुध्यते ।\nतस्य स्तम्भो भवेद् बाल्यान्नास्ति स्तम्भोऽनुपश्यतः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2188661, "chapter_id": 5009, "verse_number": "१७", "content_sanskrit": "गहनं सर्वभूतानां ध्येयं नित्यं सनातनम् ।\nअनिग्रहमनौपम्यं सर्वाकारं परात् परम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2188662, "chapter_id": 5009, "verse_number": "१८", "content_sanskrit": "सर्वावरणसम्भूतं तस्मादेतत् प्रवर्तते ।\nतन्मया अपि सम्पश्य नानालक्षणलक्षिताः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2188663, "chapter_id": 5009, "verse_number": "१९", "content_sanskrit": "स वै पाति जगत्स्रष्टा विष्णुरित्यभिशब्दितः ।\nपुनर्दर्शति सम्प्राप्ते ...... सुरेश्वरः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2188664, "chapter_id": 5009, "verse_number": "२०", "content_sanskrit": "स्वभावात् सम्प्रवर्तन्ते निवर्तन्ते तथैव च ।\nसर्वे भावास्तथाभावाः पुरुषार्थो न विद्यते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2188665, "chapter_id": 5009, "verse_number": "२१", "content_sanskrit": "पुरुषार्थस्य चाभावे नास्ति कश्चित् स्वकारकः ।\nस्वयं तु कुर्वतस्तस्य जातु मानो भवेदिह\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2188666, "chapter_id": 5009, "verse_number": "२२", "content_sanskrit": "यस्तु कर्तारमात्मानं मन्यते साध्वसाधुनोः ।\nतस्य दोषवती प्रज्ञा स्वमूर्त्यज्ञेति मे मतिः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2188667, "chapter_id": 5009, "verse_number": "२३", "content_sanskrit": "यदि स्यात् पुरुषः कर्ता शक्रात्मश्रेयसे ध्रुवम् ।\nआरम्भास्तस्य सिद्ध्येरन्न च जातु पराभवेत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2188668, "chapter_id": 5009, "verse_number": "२४", "content_sanskrit": "अनिष्टस्य हि निर्वृत्तिरनिवृत्तिः प्रियस्य च ।\nलक्ष्यते यतमानानां पुरुषार्थस्ततः कुतः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2188669, "chapter_id": 5009, "verse_number": "२५", "content_sanskrit": "अनिष्टस्याभिनिर्वृत्तिमिष्टसंवृत्तिमेव च ।\nअप्रयत्नेन पश्यामः केषाञ्चित्तत्स्वभावतः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2188670, "chapter_id": 5009, "verse_number": "२६", "content_sanskrit": "प्रतिरूपधराः केचिद् दृश्यन्ते बुद्धिसत्तमाः ।\nविरूपेभ्योऽल्पबुद्धिभ्यो लिप्समाना धनागमम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2188671, "chapter_id": 5009, "verse_number": "२७", "content_sanskrit": "स्वभावप्रेरिताः सर्वे निविशन्ते गुणा यदा ।\nशुभाशुभास्तदा तत्र तस्य किं मानकारणम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2188672, "chapter_id": 5009, "verse_number": "२८", "content_sanskrit": "स्वभावादेव तत् सर्वमिति मे निश्चिता मतिः ।\nआत्मप्रतिष्ठिता प्रज्ञा मम नास्ति ततोऽन्यथा\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2188673, "chapter_id": 5009, "verse_number": "२९", "content_sanskrit": "कर्मजं त्विह मन्येऽहं फलयोगं शुभाशुभम् ।\nकर्मणां विषयं कृत्स्नमहं वक्ष्यामि तच्छृणु\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2188674, "chapter_id": 5009, "verse_number": "३०", "content_sanskrit": "यथा वेदयते कश्चिदोदनं पायसं त्वदन् ।\nएवं सर्वाणि कर्माणि स्वभावस्यैव लक्षणम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2188675, "chapter_id": 5009, "verse_number": "३१", "content_sanskrit": "विकारानेव यो वेद न वेद प्रकृतिं पराम् ।\nतस्य स्तम्भो भवेद् बाल्यान्नास्ति स्तम्भोऽनुपश्यतः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2188676, "chapter_id": 5009, "verse_number": "३२", "content_sanskrit": "स्वभावभाविनो भावान् सर्वानेवेह निश्चये ।\nबुद्ध्यमानस्य दर्पो वा मानो वा किं करिष्यति\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2188677, "chapter_id": 5009, "verse_number": "३३", "content_sanskrit": "वेद धर्मविधिं कृत्स्नं भूतानां चाप्यनित्यताम् ।\nतस्माच्छक्र न शोचामि सर्वं ह्येवेदमन्तवत्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2188678, "chapter_id": 5009, "verse_number": "३४", "content_sanskrit": "निर्ममो निरहङ्कारो निरीहो मुक्तबन्धनः ।\nस्वस्थोऽव्यपेतः पश्यामि भूतानां प्रभवाप्ययौ\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2188679, "chapter_id": 5009, "verse_number": "३५", "content_sanskrit": "कृतप्रज्ञस्य दान्तस्य वितृष्णस्य निराशिषः ।\nनायासो विद्यते शक्र पश्यतो लोकविद्यया\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2188680, "chapter_id": 5009, "verse_number": "३६", "content_sanskrit": "प्रकृतौ च विकारे च न मे प्रीतिर्न च द्विषे ।\nद्वेष्टारं न च पश्यामि यो ममाद्य ममायते\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2188681, "chapter_id": 5009, "verse_number": "३७", "content_sanskrit": "नोर्ध्वं नावाङ् न तिर्यक्च न क्वचिच्छक्र कामये ।\nन विज्ञाने न हि ज्ञेये नाज्ञाने शर्म विद्यते\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2188682, "chapter_id": 5009, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2188683, "chapter_id": 5009, "verse_number": "३८", "content_sanskrit": "येनैषा लभ्यते प्रज्ञा येन शान्तिरवाप्यते ।\nप्रब्रूहि तमुपायं मे सम्यक् प्रह्राद पृच्छते\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2188684, "chapter_id": 5009, "verse_number": "", "content_sanskrit": "प्रह्रादः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2188685, "chapter_id": 5009, "verse_number": "३९", "content_sanskrit": "आर्जवेनाप्रमादेन प्रसादेनात्मवत्तया ।\nवृद्धशुश्रूषया शक्र पुरुषो लभते महत्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2188686, "chapter_id": 5009, "verse_number": "४०", "content_sanskrit": "स्वभावाल्लभते प्रज्ञां शान्तिमेति स्वभावतः ।\nस्वभावादेव तत् सर्वं यत्किञ्चिदनुपश्यसि\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2188687, "chapter_id": 5009, "verse_number": "४१", "content_sanskrit": "नैवान्तरं विजानाति श्रुत्वा गुरुमुखात् ततः ।\nवाक्यं वाक्यार्थविज्ञानमालोक्य मनसा यतिः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2188688, "chapter_id": 5009, "verse_number": "४२", "content_sanskrit": "विवेकप्रत्ययापन्नमात्मानमनुपश्यति ।\nविरज्यति ततो भीत्या परमेश्वरमृच्छति\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2188689, "chapter_id": 5009, "verse_number": "४३", "content_sanskrit": "त्रातारं सर्वदुःखानां तत्सुखान्वेषणं ततः ।\nकरोति सद्भिः संसर्गमलं सन्तः सुखाय वै\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2188690, "chapter_id": 5009, "verse_number": "४४", "content_sanskrit": "सतां सकाशादाज्ञाय मार्गं लक्षणवत्तया ।\nसर्वसङ्गविनिर्मुक्तः परमात्मानमृच्छति \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2188691, "chapter_id": 5009, "verse_number": "४५", "content_sanskrit": "विषयेच्छाकृतो धर्मं सरजस्को भयावहः ।\nधर्महानिमवाप्नोति क्रमात् तेन नरः पुनः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2188692, "chapter_id": 5009, "verse_number": "४६", "content_sanskrit": "भक्तिहीनो भवत्येव परमात्मनि चाच्युत ।\nवाचके वाऽपि च स्थानं न हन्त्येव विमोचितः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2188693, "chapter_id": 5009, "verse_number": "४७", "content_sanskrit": "सार्क्ष्ये चास्य रतिर्नित्यं संसारे च रतिर्भवेत् ।\nतस्य नित्यमविज्ञानादात्मा चैव न सिद्ध्यति\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2188694, "chapter_id": 5009, "verse_number": "४८", "content_sanskrit": "उन्मत्तवृत्तिर्भवति क्रमादेवं प्रवर्तते ।\nआशौचं वर्धते नित्यं न शाम्यति कथञ्चन\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2188695, "chapter_id": 5009, "verse_number": "४९", "content_sanskrit": "विषये चान्वितस्यास्य मोक्षवाञ्छा न जायते ।\nहेत्वाभासेषु संलीनः स्तौति वैषयिकान् गुणान्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2188696, "chapter_id": 5009, "verse_number": "५०", "content_sanskrit": "न शास्त्राणि शृणोत्येव मानदर्पसमन्वितः ।\nस्वतः सिद्धं न भोगस्तं स्वतःसिद्धं न वेत्ति च ।\nचिद्रूपधारणं चैव परसृष्टिमथाव्ययम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2188697, "chapter_id": 5009, "verse_number": "५१", "content_sanskrit": "नानायोनिगतस्तेन भ्राम्यमाणः स्वकर्मभिः ।\nतीर्णपारं न जानाति महामोहसमन्वितः ।\nआचार्यसंश्रयाद् विद्याद् विनयं समुपागतः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2188698, "chapter_id": 5009, "verse_number": "५२", "content_sanskrit": "अनुकूलेषु धर्मेषु चिनोत्येनं ततस्ततः ।\nआचार्य इति च ख्यातस्तेनासौ बलवृत्रहन्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2188699, "chapter_id": 5009, "verse_number": "५३", "content_sanskrit": "नियतेनैव सद्भावस्तेन जन्मान्तरादिषु ।\nकर्मसञ्चयतूलौघः क्षिप्यते ज्ञानवायुना\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2188700, "chapter_id": 5009, "verse_number": "५४", "content_sanskrit": "एवं युक्तसमाचारः संसारविनिवर्तकः ।\nअनुकूलवृत्तिं सततं छिनत्त्येव भृगुर्यथा\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2188701, "chapter_id": 5009, "verse_number": "५५", "content_sanskrit": "येन चायं समापन्नो वैतृष्ण्यं नाधिगच्छति ।\nअभ्यन्तरः स्मृतः शक्र तत्साम्यं परिवर्जयेत् \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2188702, "chapter_id": 5009, "verse_number": "५६", "content_sanskrit": "प्रथमं तत्कृतेनैव कर्मणा परिमृच्छति ।\nद्वितीयं स्वप्नयोगं च कर्मणा परिगच्छति \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2188703, "chapter_id": 5009, "verse_number": "५७", "content_sanskrit": "एतैरक्षैः समापन्नः प्रत्यक्षोऽसौ समास्थितः ।\nसुषुप्त्याख्यस्तुरीयोऽसौ न च ह्यावरणान्वितः \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2188704, "chapter_id": 5009, "verse_number": "५८", "content_sanskrit": "लोकवृत्त्या तमीशानं यजन् जुह्वन् यमी भवेत् ।\nआत्मन्यायासयोगेन निष्क्रियं स परात्परम् \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2188705, "chapter_id": 5009, "verse_number": "५९", "content_sanskrit": "आयामे तां विजानाति मायैषा परमात्मनः ।\nप्रातिभासिकसामान्याद्बुद्धेर्या संविदात्मिका \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2188706, "chapter_id": 5009, "verse_number": "६०", "content_sanskrit": "स्फुलिङ्गसत्त्वसदृशादग्निभावो यथा भवेत् ।\nशिशूनामेवमज्ञानामात्मभावोऽन्यथा स्मृतः \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2188707, "chapter_id": 5009, "verse_number": "६१", "content_sanskrit": "साध्येऽप्यवस्तुभूताख्ये मित्रामित्रादयः कुतः ।\nतदभावे तु शोकाद्या न वर्तन्ते सुरेश्वर\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2188708, "chapter_id": 5009, "verse_number": "६२", "content_sanskrit": "एवं बुध्यस्व भगवन् समबुद्धिं समन्वियात् ।\nउपायमेतदाख्यातं मा वक्रं गच्छ देवप\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2188709, "chapter_id": 5009, "verse_number": "६३", "content_sanskrit": "ज्ञानेन पश्यते कर्म ज्ञानिनां न प्रवर्तकम् ।\nयावदारब्धमस्येह तावन्नैवोपशाम्यति\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2188710, "chapter_id": 5009, "verse_number": "६४", "content_sanskrit": "तदन्ते तं प्रयात्येव न विद्वानिति मे मतिः ।\nयदस्य वाचकं वक्ष्ये संस्मरे तद्भवेत् तदा\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2188711, "chapter_id": 5009, "verse_number": "६५", "content_sanskrit": "तेन तेन च भावेन अपायं तत्र पश्यति ।\nस्थानभेदेषु वागेषा तालुसंस्था यथा तथा \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2188712, "chapter_id": 5009, "verse_number": "६६", "content_sanskrit": "तद्वद् बुद्धिगता ह्यर्था बुद्धिमात्मगतः सदा\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2188713, "chapter_id": 5009, "verse_number": "६७", "content_sanskrit": "समस्तसङ्कल्पविशेषयुक्तं\nपरं पराणां परमं महात्मा ।\nत्रय्यन्तविद्भिः परिगीयतेऽसौ\nविष्णुर्विभुर्वास्ति गुणो न नित्यम्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2188714, "chapter_id": 5009, "verse_number": "६८", "content_sanskrit": "वर्णेषु लोकेषु विशेषणेषु\nस वासुदेवो वसनान्महात्मा ।\nगुणानुरूपं स च कर्मरूपं\nददाति सर्वस्य समस्तरूपम् ।\nन संदृशे तिष्ठति रूपमस्य\nन चक्षुषा पश्यति कश्चिदेनम् \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2188715, "chapter_id": 5009, "verse_number": "६९", "content_sanskrit": "भक्त्या च धृत्या च समाहितात्मा\nज्ञानस्वरूपं परिपश्यतीह ।\nवदन्ति तन्मे भगवान् ददौ स\nस एव शेषं मघवान् महात्मा \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2188716, "chapter_id": 5009, "verse_number": "७०", "content_sanskrit": "एवं ममोपायमवैहि शक्र\nतस्माल्लोको नास्ति मह्यं सदैव\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2188717, "chapter_id": 5009, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2188718, "chapter_id": 5009, "verse_number": "७१", "content_sanskrit": "इत्युक्तो दैत्यपतिना शक्रो विस्मयमागमत् ।\nप्रीतिमांश्च तदा राजंस्तद्वाक्यं प्रत्यपूजयत्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2188719, "chapter_id": 5009, "verse_number": "७२", "content_sanskrit": "स तदाभ्यर्च्य दैत्येन्द्रं त्रैलोक्यपतिरीश्वरः ।\nअसुरेन्द्रमुपामन्त्र्य जगाम स्वं निवेशनम्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2188720, "chapter_id": 5009, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे अष्टपञ्चाशोऽध्यायः ॥५८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]