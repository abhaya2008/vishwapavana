[{"id": 2087246, "chapter_id": 2850, "verse_number": "१२-३५५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2087247, "chapter_id": 2850, "verse_number": "१२-३५५-१", "content_sanskrit": "कस्यचित्त्वथ कालस्य नारदः परमेष्ठिजः।\nदैवं कृत्वा यथान्यायं पित्र्यं चक्रे ततः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2087248, "chapter_id": 2850, "verse_number": "१२-३५५-२", "content_sanskrit": "ततस्तं वचनं प्राह ज्येष्ठो धर्मात्मजः प्रभुः।\nक इज्यते द्विजश्रेष्ठ दैवे पित्र्ये च कल्पिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2087249, "chapter_id": 2850, "verse_number": "१२-३५५-३", "content_sanskrit": "त्वया मतिमतां श्रेष्ठ तन्मे शंस यथातथम्।\nकिमेतत्क्रियते कर्म फलं वाऽस्य किमिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2087250, "chapter_id": 2850, "verse_number": "१२-३५५-४x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2087251, "chapter_id": 2850, "verse_number": "१२-३५५-४", "content_sanskrit": "त्वयैतत्कथितं पूर्वं दैवं कर्तव्यमित्यपि।\nदैवतं च परो ज्ञेयः परमात्मा सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2087252, "chapter_id": 2850, "verse_number": "१२-३५५-५", "content_sanskrit": "ततस्तद्भावितो नित्यं यजे वैकुण्ठमव्ययम्।\nतस्माच्च प्रसृतः पूर्वं ब्रह्मा लोकपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2087253, "chapter_id": 2850, "verse_number": "१२-३५५-६", "content_sanskrit": "मम वै पितरं प्रीतः परमेष्ठ्यप्यजीजनत्।\nअहं संकल्पजस्तस्य पुत्रः प्रथमकल्पितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2087254, "chapter_id": 2850, "verse_number": "१२-३५५-७", "content_sanskrit": "यजामि वै पितॄन्साधो नारायणविधौ कृते।\nएवं स एव भगवान्पिता माता पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2087255, "chapter_id": 2850, "verse_number": "१२-३५५-८", "content_sanskrit": "इज्यते पितृयज्ञेषु मया नित्यं जगत्पतिः।\nश्रुतिश्चाप्यपरा देवाः पुत्रान्हि पितरोऽयजन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2087256, "chapter_id": 2850, "verse_number": "१२-३५५-९", "content_sanskrit": "वेदश्रुतिः प्रनष्टा च पुनरध्यापिता सुतैः।\nततस्ते मन्त्रदाः पुत्राः पितॄणामिति वैदिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2087257, "chapter_id": 2850, "verse_number": "१२-३५५-१०", "content_sanskrit": "नूनं सुरैस्तद्विदितं युवयोर्भावितात्मनोः।\nपुत्राश्च पितरश्चैव परस्परमपूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2087258, "chapter_id": 2850, "verse_number": "१२-३५५-११", "content_sanskrit": "त्रीन्पिण्डान्न्यस्य वै पित्र्यान्पूर्वं दत्त्वा कुशानिति।\nकथं तु पिण्डसंज्ञां ते पितरो लेभिरे पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2087259, "chapter_id": 2850, "verse_number": "१२-३५५-१२x", "content_sanskrit": "नरनारायणावूचतुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2087260, "chapter_id": 2850, "verse_number": "१२-३५५-१२", "content_sanskrit": "इमां हि धरणीं पूर्वं नष्टां सागरमेखलाम्।\nगोविन्द उज्जहाराशु वाराहं रूपमास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2087261, "chapter_id": 2850, "verse_number": "१२-३५५-१३", "content_sanskrit": "स्थापयित्वा तु धरणीं स्वे स्थाने पुरुषोत्तमः।\nजलकर्दमलिप्ताङ्गो लोककार्यार्थमुद्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2087262, "chapter_id": 2850, "verse_number": "१२-३५५-१४", "content_sanskrit": "प्राप्ते चाह्निककाले तु मध्यदेशगते रवौ।\nदंष्ट्राविलग्नांस्त्रीन्पिण्डान्विधूय सहसा प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2087263, "chapter_id": 2850, "verse_number": "१२-३५५-१५", "content_sanskrit": "स्थापयामास वै पृथ्व्यां कुशानास्तीर्य नारद।\nस तेष्वात्मानमुद्दिश्य पित्र्यं चक्रे यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2087264, "chapter_id": 2850, "verse_number": "१२-३५५-१६", "content_sanskrit": "संकल्पयित्वा त्रीन्पिण्डान्स्वेनैव विधिना प्रभुः।\nआत्मगात्रोष्मसंभूतैः स्नेहगर्भैस्तिलैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2087265, "chapter_id": 2850, "verse_number": "१२-३५५-१७", "content_sanskrit": "प्रोक्ष्यापसव्यं देवेशः प्राङ्भुखः कृतवान्स्वयम्।\nमर्यादास्थापनार्थं च ततो वचनमुक्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2087266, "chapter_id": 2850, "verse_number": "१२-३५५-१८x", "content_sanskrit": "वृषाकपिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2087267, "chapter_id": 2850, "verse_number": "१२-३५५-१८", "content_sanskrit": "अहं हि पितरः स्रष्टुमुद्यतो लोककृत्स्वयम्।\nतस्य चिन्तयतः सद्यः पितृकार्यविधीन्परान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2087268, "chapter_id": 2850, "verse_number": "१२-३५५-१९", "content_sanskrit": "दंष्ट्राभ्यां प्रविनिर्धूता ममैते दक्षिणां दिशम्।\nआश्रिता धरणीं पीड्य तस्मात्पितर एव ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2087269, "chapter_id": 2850, "verse_number": "१२-३५५-२०", "content_sanskrit": "त्रयो मूर्तिविहीना वै पिण्डमूर्तिधरास्त्विमे।\nभवन्तु पितरो लोके मया सृष्टाः सनातनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2087270, "chapter_id": 2850, "verse_number": "१२-३५५-२१", "content_sanskrit": "पिता पितामहश्चैव तथैव प्रपितामहः।\nअहमेवात्र विज्ञेयस्त्रिषु पिण्डेषु संस्थितः।\nनास्ति मत्तोऽधिकः कश्चित्को वान्योर्च्यो मया स्वयं", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2087271, "chapter_id": 2850, "verse_number": "१२-३५५-२२", "content_sanskrit": "अहमेव पिता लोके अहमेव पितामहः।\nपितामहपिता चैव अहमेवात्र कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2087272, "chapter_id": 2850, "verse_number": "१२-३५५-२३", "content_sanskrit": "इत्येतदुक्त्वा वचनं देवदेवो वृषाकपिः।\nवराहपर्वते विप्र दत्त्वा पिण्डान्सविस्तरान्।\nआत्मानं पूजयित्वैव तत्रैवादर्शनं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2087273, "chapter_id": 2850, "verse_number": "१२-३५५-२४", "content_sanskrit": "एतदर्थं सुभमते पितरः पिण्डसंज्ञिताः।\nलभन्ते सततं पूजां वृषाकपिवचो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2087274, "chapter_id": 2850, "verse_number": "१२-३५५-२५", "content_sanskrit": "ये यजन्ति पितॄन्देवान्गुरूंश्चैवातिर्थीस्तथा।\nगाश्चैव द्विजमुख्यांश्च पितरं मातरं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2087275, "chapter_id": 2850, "verse_number": "१२-३५५-२६", "content_sanskrit": "कर्मणा मनसा वाचा विष्णुमेव यजन्ति ते।\nअन्तर्गतः स भगवान्सर्वसत्वशरीरगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2087276, "chapter_id": 2850, "verse_number": "१२-३५५-२७", "content_sanskrit": "समः सर्वेषु भूतेषु ईश्वरः सुखदुःखयोः।\nमहान्महात्मा सर्वात्मा नारायण इति श्रुतिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2087277, "chapter_id": 2850, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि नारायणीये पञ्चपञ्चाशदधिकत्रिशततमोऽध्यायः॥ ३५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]