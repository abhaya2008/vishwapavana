[{"id": 5000279000, "chapter_id": 9279, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे सप्तमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000279001, "chapter_id": 9279, "verse_number": "४-७-१", "content_sanskrit": "एवमुक्तस्तु सुग्रीवो रामेणार्तेन वानरः।\nअब्रवीत् प्राञ्जलिर्वाक्यं सबाष्पं बाष्पगद‍्गदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000279002, "chapter_id": 9279, "verse_number": "४-७-२", "content_sanskrit": "न जाने निलयं तस्य सर्वथा पापरक्षसः।\nसामर्थ्यं विक्रमं वापि दौष्कुलेयस्य वा कुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000279003, "chapter_id": 9279, "verse_number": "४-७-३", "content_sanskrit": "सत्यं तु प्रतिजानामि त्यज शोकमरिंदम।\nकरिष्यामि तथा यत्नं यथा प्राप्स्यसि मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000279004, "chapter_id": 9279, "verse_number": "४-७-४", "content_sanskrit": "रावणं सगणं हत्वा परितोष्यात्मपौरुषम्।\nतथास्मि कर्ता नचिराद् यथा प्रीतो भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000279005, "chapter_id": 9279, "verse_number": "४-७-५", "content_sanskrit": "अलं वैक्लव्यमालम्ब्य धैर्यमात्मगतं स्मर।\nत्वद्विधानां न सदृशमीदृशं बुद्धिलाघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000279006, "chapter_id": 9279, "verse_number": "४-७-६", "content_sanskrit": "मयापि व्यसनं प्राप्तं भार्याविरहजं महत्।\nनाहमेवं हि शोचामि धैर्यं न च परित्यजे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000279007, "chapter_id": 9279, "verse_number": "४-७-७", "content_sanskrit": "नाहं तामनुशोचामि प्राकृतो वानरोऽपि सन्।\nमहात्मा च विनीतश्च किं पुनर्धृतिमान् महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000279008, "chapter_id": 9279, "verse_number": "४-७-८", "content_sanskrit": "बाष्पमापतितं धैर्यान्निग्रहीतुं त्वमर्हसि।\nमर्यादां सत्त्वयुक्तानां धृतिं नोत्स्रष्टुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000279009, "chapter_id": 9279, "verse_number": "४-७-९", "content_sanskrit": "व्यसने वार्थकृच्छ्रे वा भये वा जीवितान्तगे।\nविमृशंश्च स्वयाबुद्ध्या धृतिमान् नावसीदति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000279010, "chapter_id": 9279, "verse_number": "४-७-१०", "content_sanskrit": "बालिशस्तु नरो नित्यं वैक्लव्यं योऽनुवर्तते।\nस मज्जत्यवशः शोके भाराक्रान्तेव नौर्जले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000279011, "chapter_id": 9279, "verse_number": "४-७-११", "content_sanskrit": "एषोऽञ्जलिर्मया बद्धः प्रणयात् त्वां प्रसादये।\nपौरुषं श्रय शोकस्य नान्तरं दातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000279012, "chapter_id": 9279, "verse_number": "४-७-१२", "content_sanskrit": "ये शोकमनुवर्तन्ते न तेषां विद्यते सुखम्।\nतेजश्च क्षीयते तेषां न त्वं शोचितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000279013, "chapter_id": 9279, "verse_number": "४-७-१३", "content_sanskrit": "शोकेनाभिप्रपन्नस्य जीविते चापि संशयः।\nस शोकं त्यज राजेन्द्र धैर्यमाश्रय केवलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000279014, "chapter_id": 9279, "verse_number": "४-७-१४", "content_sanskrit": "हितं वयस्यभावेन ब्रूहि नोपदिशामि ते।\nवयस्यतां पूजयन्मे न त्वं शोचितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000279015, "chapter_id": 9279, "verse_number": "४-७-१५", "content_sanskrit": "मधुरं सान्त्वितस्तेन सुग्रीवेण स राघवः।\nमुखमश्रुपरिक्लिन्नं वस्त्रान्तेन प्रमार्जयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000279016, "chapter_id": 9279, "verse_number": "४-७-१६", "content_sanskrit": "प्रकृतिस्थस्तु काकुत्स्थः सुग्रीवचनात् प्रभुः।\nसम्परिष्वज्य सुग्रीवमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000279017, "chapter_id": 9279, "verse_number": "४-७-१७", "content_sanskrit": "कर्तव्यं यद् वयस्येन स्निग्धेन च हितेन च।\nअनुरूपं च युक्तं च कृतं सुग्रीव तत् त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000279018, "chapter_id": 9279, "verse_number": "४-७-१८", "content_sanskrit": "एष च प्रकृतिस्थोऽहमनुनीतस्त्वया सखे।\nदुर्लभो हीदृशो बन्धुरस्मिन् काले विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000279019, "chapter_id": 9279, "verse_number": "४-७-१९", "content_sanskrit": "किं तु यत्नस्त्वया कार्यो मैथिल्याः परिमार्गणे।\nराक्षसस्य च रौद्रस्य रावणस्य दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000279020, "chapter_id": 9279, "verse_number": "४-७-२०", "content_sanskrit": "मया च यदनुष्ठेयं विस्रब्धेन तदुच्यताम्।\nवर्षास्विव च सुक्षेत्रे सर्वं सम्पद्यते तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000279021, "chapter_id": 9279, "verse_number": "४-७-२१", "content_sanskrit": "मया च यदिदं वाक्यमभिमानात् समीरितम्।\nतत्त्वया हरिशार्दूल तत्त्वमित्युपधार्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000279022, "chapter_id": 9279, "verse_number": "४-७-२२", "content_sanskrit": "अनृतं नोक्तपूर्वं मे न च वक्ष्ये कदाचन।\nएतत्ते प्रतिजानामि सत्येनैव शपाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000279023, "chapter_id": 9279, "verse_number": "४-७-२३", "content_sanskrit": "ततः प्रहृष्टः सुग्रीवो वानरैः सचिवैः सह।\nराघवस्य वचः श्रुत्वा प्रतिज्ञातं विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000279024, "chapter_id": 9279, "verse_number": "४-७-२४", "content_sanskrit": "एवमेकान्तसम्पृक्तौ ततस्तौ नरवानरौ।\nउभावन्योन्यसदृशं सुखं दुःखमभाषताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000279025, "chapter_id": 9279, "verse_number": "४-७-२५", "content_sanskrit": "महानुभावस्य वचो निशम्य\nहरिर्नृपाणामधिपस्य तस्य।\nकृतं स मेने हरिवीरमुख्य-\nस्तदा च कार्यं हृदयेन विद्वान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000279026, "chapter_id": 9279, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे सप्तमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]