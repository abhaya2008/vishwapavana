[{"id": 40018111, "chapter_id": 9279, "verse_number": "1", "content_sanskrit": "स हताश्वोमहातेजाभूमौतिष्ठन्निशाचरः । इन्द्रजित्परमक्रुद्धस्सजज्वालतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40018112, "chapter_id": 9279, "verse_number": "2", "content_sanskrit": "तौधवनिनौजिघांसन्तवन्योन्यमिषुभिर्भृशम् । विजयेनाभिनिष्क्रान्तौवनेगजवृषाविव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40018113, "chapter_id": 9279, "verse_number": "3", "content_sanskrit": "निबर्हयन्तश्चान्योन्यंतेराक्ष्वनौकसः । भर्तारं न जहुर्युद्धेसम्पतन्तस्ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40018114, "chapter_id": 9279, "verse_number": "4", "content_sanskrit": "ततस्तान् राक्षसान् सर्वान् हर्षयन् रावणात्मजः । स्तुवानोहर्षमाणश्चइदंवचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40018115, "chapter_id": 9279, "verse_number": "5", "content_sanskrit": "तमसाबहुलेनेमास्सम्सक्तांसर्वतोदिशः । नेहविज्ञायतेस्वोवापरोवारक्षसोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40018116, "chapter_id": 9279, "verse_number": "6", "content_sanskrit": "धृष्टंभवन्तोयुध्यन्तुहरीणांमोहनायवै । अहंतुरथमास्थायआगमिष्यामिसंयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40018117, "chapter_id": 9279, "verse_number": "7", "content_sanskrit": "तथाभवन्तःकुर्वन्तुयथेमेहिवनौकसः । न युध्येयुर्दुरात्मानःप्रविष्टेनगरंमयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40018118, "chapter_id": 9279, "verse_number": "8", "content_sanskrit": "इत्युक्त्वारावणसुतोवञ्चयित्वावनौकसः । प्रविवेशपुरींलङ्कांरथहेतोरमित्रहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40018119, "chapter_id": 9279, "verse_number": "9", "content_sanskrit": "स रथंभूषयित्वाथरुचिरंहेमभूषितम् । प्रासासिशरसंयुक्तंयुक्तंपरमवाजिभिः ॥ अधिष्ठितंहयज्ञेनसूतेनाप्तोपदेशिना । आरुरोहमहातेजारावणिःसमतिञ्जियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40018120, "chapter_id": 9279, "verse_number": "10", "content_sanskrit": "स रथंभूषयित्वाथरुचिरंहेमभूषितम् । प्रासासिशरसंयुक्तंयुक्तंपरमवाजिभिः ॥ अधिष्ठितंहयज्ञेनसूतेनाप्तोपदेशिना । आरुरोहमहातेजारावणिःसमतिञ्जियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40018121, "chapter_id": 9279, "verse_number": "11", "content_sanskrit": "स राक्षसगणैर्मुख्यैर्वृतोमन्दोदरीसुतः । निर्ययौनगरावदीरःकृतान्तबलचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40018122, "chapter_id": 9279, "verse_number": "12", "content_sanskrit": "सोऽभिनिष्क्रम्यनगरादिन्द्रजित्परवीरहा । अभ्ययाज्ञवनैरश्वैर्लक्ष्मणंसविभीषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40018123, "chapter_id": 9279, "verse_number": "13", "content_sanskrit": "ततोरथस्थमालोक्यसौमत्रीरावणात्मजम् । वानराश्चमहावीर्याराक्षसश्चविभीषणः ॥ विस्मयंपरमंजग्मुर्लाघवात्तस्यधीमतः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40018124, "chapter_id": 9279, "verse_number": "14", "content_sanskrit": "रावणिश्चापिसङ्क्रुद्धोरणेवानरयूथपान् ॥ पातयामासबाणौघैःशतशोऽथसहस्रशः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url"