[{"id": 5000136000, "chapter_id": 9136, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे एकोनषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000136001, "chapter_id": 9136, "verse_number": "२-५९-१", "content_sanskrit": "मम तु अश्वा निवृत्तस्य न प्रावर्तन्त वर्त्मनि ।\nउष्णम् अश्रु विमुन्चन्तः रामे सम्प्रस्थिते वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000136002, "chapter_id": 9136, "verse_number": "२-५९-२", "content_sanskrit": "उभाभ्याम् राज पुत्राभ्याम् अथ कृत्वा अहम् ज्ञलिम् ।\nप्रस्थितः रथम् आस्थाय तत् दुह्खम् अपि धारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000136003, "chapter_id": 9136, "verse_number": "२-५९-३", "content_sanskrit": "गुहा इव सार्धम् तत्र एव स्थितः अस्मि दिवसान् बहून् ।\nआशया यदि माम् रामः पुनः शब्दापयेद् इति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000136004, "chapter_id": 9136, "verse_number": "२-५९-४", "content_sanskrit": "विषये ते महा राज माम व्यसन कर्शिताः ।\nअपि वृक्षाः परिम्लानः सपुष्प अन्कुर कोरकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000136005, "chapter_id": 9136, "verse_number": "२-५९-५", "content_sanskrit": "उपतप्तोदका नद्यः पल्वलानि सराम्सि च ।\nपरिष्कुपलाशानि वनान्युपवनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000136006, "chapter_id": 9136, "verse_number": "२-५९-६", "content_sanskrit": "न च सर्पन्ति सत्त्वानि व्याला न प्रसरन्ति च ।\nराम शोक अभिभूतम् तन् निष्कूजम् अभवद् वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000136007, "chapter_id": 9136, "verse_number": "२-५९-७", "content_sanskrit": "लीन पुष्कर पत्राः च नर इन्द्र कलुष उदकाः ।\nसम्तप्त पद्माः पद्मिन्यो लीन मीन विहम्गमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000136008, "chapter_id": 9136, "verse_number": "२-५९-८", "content_sanskrit": "जलजानि च पुष्पाणि माल्यानि स्थलजानि च ।\nन अद्य भान्ति अल्प गन्धीनि फलानि च यथा पुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000136009, "chapter_id": 9136, "verse_number": "२-५९-९", "content_sanskrit": "अत्रोद्यानानि शून्यानि प्रलीनविहगानि च ।\nन चाभिरामानारामान् पश्यामि मनुजर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000136010, "chapter_id": 9136, "verse_number": "२-५९-१०", "content_sanskrit": "प्रविशन्तम् अयोध्याम् माम् न कश्चित् अभिनन्दति ।\nनरा रामम् अपश्यन्तः निह्श्वसन्ति मुहुर् मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000136011, "chapter_id": 9136, "verse_number": "२-५९-११", "content_sanskrit": "देव राजरथम् दृष्ट्वा विना राममिहागतम् ।\nदुःखादश्रुमुखः सर्वो राजमार्गगतो जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000136012, "chapter_id": 9136, "verse_number": "२-५९-१२", "content_sanskrit": "हर्म्यैः विमानैः प्रासादैः अवेक्ष्य रथम् आगतम् ।\nहाहा कार कृता नार्यो राम अदर्शन कर्शिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000136013, "chapter_id": 9136, "verse_number": "२-५९-१३", "content_sanskrit": "आयतैः विमलैः नेत्रैः अश्रु वेग परिप्लुतैः ।\nअन्योन्यम् अभिवीक्षन्ते व्यक्तम् आर्ततराः स्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000136014, "chapter_id": 9136, "verse_number": "२-५९-१४", "content_sanskrit": "न अमित्राणाम् न मित्राणाम् उदासीन जनस्य च ।\nअहम् आर्ततया कम्चित् विशेषम् न उपलक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000136015, "chapter_id": 9136, "verse_number": "२-५९-१५", "content_sanskrit": "अप्रहृष्ट मनुष्या च दीन नाग तुरम्गमा ।\nआर्त स्वर परिम्लाना विनिह्श्वसित निह्स्वना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000136016, "chapter_id": 9136, "verse_number": "२-५९-१६", "content_sanskrit": "निरानन्दा महा राज राम प्रव्राजन आतुला ।\nकौसल्या पुत्र हीना इवायोध्या प्रतिभाति मा मा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000136017, "chapter_id": 9136, "verse_number": "२-५९-१७", "content_sanskrit": "सूतस्य वचनम् श्रुत्वा वाचा परम दीनया ।\nबाष्प उपहतया राजा तम् सूतम् इदम् अब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000136018, "chapter_id": 9136, "verse_number": "२-५९-१८", "content_sanskrit": "कैकेय्या विनियुक्तेन पाप अभिजन भावया ।\nमया न मन्त्र कुशलैः वृद्धैः सह समर्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000136019, "chapter_id": 9136, "verse_number": "२-५९-१९", "content_sanskrit": "न सुहृद्भिर् न च अमात्यैः मन्त्रयित्वा न नैगमैः ।\nमया अयम् अर्थः सम्मोहात् स्त्री हेतोह् सहसा कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000136020, "chapter_id": 9136, "verse_number": "२-५९-२०", "content_sanskrit": "भवितव्यतया नूनम् इदम् वा व्यसनम् महत् ।\nकुलस्य अस्य विनाशाय प्राप्तम् सूत यदृच्चया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000136021, "chapter_id": 9136, "verse_number": "२-५९-२१", "content_sanskrit": "सूत यद्य् अस्ति ते किम्चिन् मया अपि सुकृतम् कृतम् ।\nत्वम् प्रापय आशु माम् रामम् प्राणाः सम्त्वरयन्ति माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000136022, "chapter_id": 9136, "verse_number": "२-५९-२२", "content_sanskrit": "यद् यद् या अपि मम एव आज्ञा निवर्तयतु राघवम् ।\nन शक्ष्यामि विना राम मुहूर्तम् अपि जीवितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000136023, "chapter_id": 9136, "verse_number": "२-५९-२३", "content_sanskrit": "अथवा अपि महा बाहुर् गतः दूरम् भविष्यति ।\nमाम् एव रथम् आरोप्य शीघ्रम् रामाय दर्शय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000136024, "chapter_id": 9136, "verse_number": "२-५९-२४", "content_sanskrit": "वृत्त दम्ष्ट्रः महा इष्वासः क्व असौ लक्ष्मण पूर्वजः ।\nयदि जीवामि साध्व् एनम् पश्येयम् सह सीतया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000136025, "chapter_id": 9136, "verse_number": "२-५९-२५", "content_sanskrit": "लोहित अक्षम् महा बाहुम् आमुक्त मणि कुण्डलम् ।\nरामम् यदि न पश्यामि गमिष्यामि यम क्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000136026, "chapter_id": 9136, "verse_number": "२-५९-२६", "content_sanskrit": "अतः नु किम् दुह्खतरम् यो अहम् इक्ष्वाकु नन्दनम् ।\nइमाम् अवस्थाम् आपन्नो न इह पश्यामि राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000136027, "chapter_id": 9136, "verse_number": "२-५९-२७", "content_sanskrit": "हा राम राम अनुज हा हा वैदेहि तपस्विनी ।\nन माम् जानीत दुह्खेन म्रियमाणम् अनाथवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000136028, "chapter_id": 9136, "verse_number": "२-५९-२८", "content_sanskrit": "स तेन राजा दुःखेन भृशमर्पितचेतनः ।\nअवगाढः सुदुष्पारम् शोकसागमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000136029, "chapter_id": 9136, "verse_number": "२-५९-२९", "content_sanskrit": "रामशोकमहाभोगः सीताविरहपारगः ।\nश्वसितोर्मिमहावर्तो बाष्पफेनजलाविलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000136030, "chapter_id": 9136, "verse_number": "२-५९-३०", "content_sanskrit": "बाहुविक्षेपमीनौघो विक्रन्दितमहास्वनः ।\nप्रकीर्णकेशशैवालः कैकेयीबडबामुखः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000136031, "chapter_id": 9136, "verse_number": "२-५९-३१", "content_sanskrit": "ममाश्रुवेगप्रभवः कुब्जावाक्यमहाग्रहः ।\nवरवेलो नृशम्साया रामप्रव्राजनायतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000136032, "chapter_id": 9136, "verse_number": "२-५९-३२", "content_sanskrit": "यस्मिन् बत निमग्नोऽहम् कौसल्ये राघवम् विना ।\nदुस्तरः जीवता देवि मया अयम् शोक सागरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000136033, "chapter_id": 9136, "verse_number": "२-५९-३३", "content_sanskrit": "अशोभनम् यो अहम् इह अद्य राघवम् ।\nदिदृक्षमाणो न लभे सलक्ष्मणम्इति इव राजा विलपन् महा यहाशःपपात तूर्णम् शयने स मूर्चितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000136034, "chapter_id": 9136, "verse_number": "२-५९-३४", "content_sanskrit": "इति विलपति पार्थिवे प्रनष्टे ।\nकरुणतरम् द्विगुणम् च राम हेतोः ।\nवचनम् अनुनिशम्य तस्य देवी ।\nभयम् अगमत् पुनर् एव राम माता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000136035, "chapter_id": 9136, "verse_number": null, "content_sanskrit": "इति वाल्मीकि रामायणे आदि काव्ये अयोध्याकाण्डे एकोनषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]