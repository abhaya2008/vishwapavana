[{"id": 2179705, "chapter_id": 4807, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2179706, "chapter_id": 4807, "verse_number": "१", "content_sanskrit": "भगवन् कर्मणा केन सुद्युम्नो वसुधाधिपः ।\nसंसिद्धिं परमां प्राप्तः श्रोतुमिच्छामि तं नृपम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2179707, "chapter_id": 4807, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2179708, "chapter_id": 4807, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nशङ्खश्च लिखितश्चास्तां भ्रातरौ संयतव्रतौ\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2179709, "chapter_id": 4807, "verse_number": "३", "content_sanskrit": "तयोरावसथावास्तां रमणीयौ पृथक् पृथक् ।\nनित्यपुष्पफलैर्वृक्षैरुपेतौ बाहुदामनु\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2179710, "chapter_id": 4807, "verse_number": "४", "content_sanskrit": "ततः कदाचिल्लिखितः शङ्खस्याश्रममागमत् ।\nयदृच्छयापि शङ्खोऽथ निष्क्रान्तोऽभवदाश्रमात्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2179711, "chapter_id": 4807, "verse_number": "५", "content_sanskrit": "सोऽभगम्याश्रमं भ्रातुः शङ्खस्य लिखितस्तदा ।\nफलानि शातयामास सम्यक् परिणतान्युत \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2179712, "chapter_id": 4807, "verse_number": "६", "content_sanskrit": "तान्युपादाय विस्रब्धो भक्षयामास स द्विजः ।\nतस्मिंश्च भक्षयत्येव शङ्खोऽप्याश्रममागमत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2179713, "chapter_id": 4807, "verse_number": "७", "content_sanskrit": "भक्षयन्तं तु तं दृष्ट्वा शङ्खो भ्रातरमब्रवीत् ।\nकुतः फलान्यवाप्तानि हेतुना केन खादसि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2179714, "chapter_id": 4807, "verse_number": "८", "content_sanskrit": "सोऽब्रवीद् भ्रातरं ज्येष्ठमुपस्पृश्याभिवाद्य च ।\nइत एव गृहीतानि मयेति प्रहसन्निव\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2179715, "chapter_id": 4807, "verse_number": "९", "content_sanskrit": "तमब्रवीत् तदा शङ्खस्तीव्रकोपसमन्वितः ।\nस्तेयं त्वया कृतमिदं फलान्याददता स्वयम् ।\nगच्छ राजानमासाद्य स्वकर्म प्रथयस्व वै\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2179716, "chapter_id": 4807, "verse_number": "१०", "content_sanskrit": "अदत्तादानमेवेदं कृतं पार्थिवसत्तम ।\nस्तेनं मां त्वं विदित्वा च स्वधर्ममनुपालय ।\nशीघ्रं धारय चौरस्य मम दण्डं नराधिप\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2179717, "chapter_id": 4807, "verse_number": "११", "content_sanskrit": "इत्युक्तस्तस्य वचनात् सुद्युम्नं वसुधाधिपम् ।\nअभ्यगच्छन्महाबाहो लिखितः संशितव्रतः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2179718, "chapter_id": 4807, "verse_number": "१२", "content_sanskrit": "सुद्युम्नस्त्वन्तपालेभ्यः श्रुत्वा लिखितमागतम् ।\nअभ्यगच्छत् सहामात्यः पद्भ्यामेव नरेश्वरः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2179719, "chapter_id": 4807, "verse_number": "१३", "content_sanskrit": "तमब्रवीत् समागत्य स राजा ब्रह्मवित्तमम् ।\nकिमागमनमाचक्ष्व भगवन् कृतमेव तत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2179720, "chapter_id": 4807, "verse_number": "१४", "content_sanskrit": "एवमुक्तः स विप्रर्षिः सुद्युम्नमिदमब्रवीत् ।\nप्रतिश्रौषि करिष्येति श्रुत्वा तत् कर्तुमर्हसि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2179721, "chapter_id": 4807, "verse_number": "१५", "content_sanskrit": "अनिसृष्टानि गुरुणा फलानि पुरुषर्षभ ।\nभक्षितानि मया राजंस्तत्र मां शाधि माचिरम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2179722, "chapter_id": 4807, "verse_number": "", "content_sanskrit": "सुद्युम्नः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2179723, "chapter_id": 4807, "verse_number": "१६", "content_sanskrit": "प्रमाणं चेन्मतो राजा भवतो दण्डधारणे ।\nअनुज्ञायामपि तथा हेतुः स्याद् ब्राह्मणर्षभ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2179724, "chapter_id": 4807, "verse_number": "१७", "content_sanskrit": "स भवानभ्यनुज्ञातः शुचिकर्मा महाव्रतः ।\nब्रूहि कामानतोऽन्यांस्त्वं करिष्यामि हि ते वचः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2179725, "chapter_id": 4807, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2179726, "chapter_id": 4807, "verse_number": "१८", "content_sanskrit": "छन्द्यमानोऽपि ब्रह्मर्षिः पार्थिवेन महात्मना ।\nनान्यं वै वरयामास तस्माद् दण्डादृते वरम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2179727, "chapter_id": 4807, "verse_number": "१९", "content_sanskrit": "ततः स पृथिवीपालो लिखितस्य महात्मनः ।\nकरौ प्रच्छेदयामास धृतदण्डो जगाम सः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2179728, "chapter_id": 4807, "verse_number": "२०", "content_sanskrit": "स गत्वा भ्रातरं शङ्खमार्तरूपोऽब्रवीदिदम् ।\nधृतदण्डस्य दुर्बुद्धेर्भगवन् क्षन्तुमर्हसि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2179729, "chapter_id": 4807, "verse_number": "", "content_sanskrit": "शङ्खः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2179730, "chapter_id": 4807, "verse_number": "२१", "content_sanskrit": "न कुप्ये तव धर्मज्ञ नच दूषयसे मम ।\nसुनिर्मल कुलं ब्रह्मन्नस्मिन् जगति विश्रुतम् ।\nधर्मस्तु ते व्यतिक्रान्तस्ततस्ते निष्कृतिः कृता\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2179731, "chapter_id": 4807, "verse_number": "२२", "content_sanskrit": "स गत्वा बाहुदां शीघ्रं तर्पयस्व यथाविधि ।\nदेवान् पितॄनृषींश्चैव मा चाधर्मे मनः कृथाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2179732, "chapter_id": 4807, "verse_number": "२३", "content_sanskrit": "ब्रह्महत्यां सुरापानं स्तेयं गुर्वङ्गनागमम् ।\nमहान्ति पातकान्याहुः सयोगं चैव तैः सह\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2179733, "chapter_id": 4807, "verse_number": "२४", "content_sanskrit": "न स्तेयसदृशं ब्ऱ्हमन् महापातकमस्त्युत ।\nजगत्यस्मिन् महाभाग ब्रह्महत्यासमो हि तत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2179734, "chapter_id": 4807, "verse_number": "२५", "content_sanskrit": "सर्वपातकिना ब्रह्मन् दण्डः शारीर उच्यते ।\nतस्करस्य विशेषेण नान्यो दण्डो विधीयते\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2179735, "chapter_id": 4807, "verse_number": "२६", "content_sanskrit": "ब्राह्मणः क्षत्रियो वापि वैश्यः शूद्रोऽथ वा द्विज ।\nसर्वे कामकृते पापे हन्तव्या न विचारणा \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2179736, "chapter_id": 4807, "verse_number": "२७", "content_sanskrit": "राजभिर्धृतदण्डा वै कृत्वा पापानि मानवाः ।\nनिर्मलाः स्वर्गमायान्ति सन्तः सुकृतिनो यथा ।\nउद्धृतं न कुलं ब्रह्मन् राज्ञा दण्डे धृते त्वयि\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2179737, "chapter_id": 4807, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2179738, "chapter_id": 4807, "verse_number": "२८", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा शङ्खस्य लिखितस्तदा ।\nअवगाह्यापगां पुण्यामुदकार्थं प्रचक्रमे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2179739, "chapter_id": 4807, "verse_number": "२९", "content_sanskrit": "प्रादुरास्तां ततस्तस्य करौ जलजसन्निभौ ।\nततः स विस्मितो भ्रातुर्दर्शयामास तौ करौ\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2179740, "chapter_id": 4807, "verse_number": "३०", "content_sanskrit": "ततस्तमब्रवीच्छङ्खस्तपसेदं कृतं मया ।\nमा च तेऽत्र विशङ्का भूद् दैवमेव विधीयते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2179741, "chapter_id": 4807, "verse_number": "", "content_sanskrit": "लिखितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2179742, "chapter_id": 4807, "verse_number": "३१", "content_sanskrit": "किन्नु नाहं त्वया पूतः पूर्वमेव महाद्युते ।\nयस्य ते तपसो वीर्यमीदृशं द्विजसत्तम\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2179743, "chapter_id": 4807, "verse_number": "", "content_sanskrit": "शङ्खः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2179744, "chapter_id": 4807, "verse_number": "३२", "content_sanskrit": "एवमेतन्मया कार्यं नाहं दण्डधरस्तव ।\nस च पूतो नरपतिस्त्वं चापि पितृभिः सह\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2179745, "chapter_id": 4807, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2179746, "chapter_id": 4807, "verse_number": "३३", "content_sanskrit": "स राजा पाण्डवश्रेष्ठ श्रेष्ठो वै तेन कर्मणा ।\nप्राप्तवान् परमां सिद्धिं दक्षः प्राचेतसो यथा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2179747, "chapter_id": 4807, "verse_number": "३४", "content_sanskrit": "एष धर्मः क्षत्रियाणां प्रजानां परिपालनम् ।\nउत्पथेऽस्मिन् महाराज मा च शोके मनः कृथाः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2179748, "chapter_id": 4807, "verse_number": "३५", "content_sanskrit": "भ्रातुरस्य हितं वाक्यं शृणु धर्मज्ञसत्तम ।\nदण्ड एव हि राजेन्द्र क्षत्रधर्मो न मुण्डनम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2179749, "chapter_id": 4807, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे चतुर्विंशोऽध्यायः ॥ २४ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]