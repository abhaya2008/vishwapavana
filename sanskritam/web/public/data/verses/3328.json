[{"id": 2107837, "chapter_id": 3328, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2107838, "chapter_id": 3328, "verse_number": "१", "content_sanskrit": "शप्तस्तु भृगुणा वह्निः क्रुद्धो वाक्यमथाब्रवीत्\nकिमिदं साहसं ब्रह्मन् कृतवानसि साम्प्रतम्\t ॥ १॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2107839, "chapter_id": 3328, "verse_number": "२", "content_sanskrit": "धर्मेऽपि यतमानस्य सत्यं च वदतः समम् ।\nपृष्टो यदब्रुवं सत्यं व्यभिचारोऽत्र को मम \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2107840, "chapter_id": 3328, "verse_number": "३", "content_sanskrit": "पृष्टो हि साक्षी यः साक्ष्ये जानमानोऽन्यथा वदेत् ।\nस पूर्वानात्मनः सप्त कुले हन्यात् तथाऽपरान् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2107841, "chapter_id": 3328, "verse_number": "४", "content_sanskrit": "यश्च कार्यार्थतत्त्वज्ञो जानमानो न भाषते ।\nसोऽपि तेनैव पापेन लिप्यते नात्र संशयः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2107842, "chapter_id": 3328, "verse_number": "५", "content_sanskrit": "शक्तोऽहमभिशप्तुं  त्वां मान्यास्तु ब्राह्मणा मम ।\nजानतोऽपि च ते व्यक्तं कथयिष्ये निबोध तत् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2107843, "chapter_id": 3328, "verse_number": "६", "content_sanskrit": "योगेन बहुधाऽऽत्मानं कृत्वा तिष्ठामि मूर्तिषु\nअग्निहोत्रेषु सत्रेषु क्रियासु च मखेषु च \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2107844, "chapter_id": 3328, "verse_number": "७", "content_sanskrit": "वेदोक्तेन विधानेन मयि यद्धूयते हविः\nदेवताः पितरश्चैव तृप्तास्तेन भवन्ति वै \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2107845, "chapter_id": 3328, "verse_number": "८", "content_sanskrit": "आयुर्देवगणाः सर्वे आयुःपितृगणास्तथा ।\nदर्शश्च पौर्णमासश्च देवानां पितृभिः सह \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2107846, "chapter_id": 3328, "verse_number": "९", "content_sanskrit": "देवताः पितरस्तस्मात् पितरश्चापि देवताः\nएकीभूताश्च दृश्यन्ते पृथक्त्वेन च पर्वसु \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2107847, "chapter_id": 3328, "verse_number": "१०", "content_sanskrit": "देवाश्च पितरश्चैव जुह्वते मयि सर्वदा ।\nत्रिदशानां पितॄणां च मुखमेवमहं परम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2107848, "chapter_id": 3328, "verse_number": "११", "content_sanskrit": "अमावास्यायां च पितरः पौर्णमास्यां च देवताः ।\nमन्मुखेनैव हूयन्ते भुञ्जते यद्धुतं हविः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2107849, "chapter_id": 3328, "verse_number": "१२", "content_sanskrit": "सर्वभक्षः कथं तेषां भविष्यामि मुखं त्वहम्\nचिन्तयित्वा ततो वह्निश्चक्रे संहारमात्मनः\t ॥ १२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2107850, "chapter_id": 3328, "verse_number": "१३", "content_sanskrit": "द्विजानामग्निहोत्रेषु यज्ञसत्रक्रियासु च ।\nनिरोङ्कारवषट्काराः स्वधास्वाहाविवर्जिताः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2107851, "chapter_id": 3328, "verse_number": "१४", "content_sanskrit": "विनाग्निना प्रजाः सर्वास्त्रस्ताः ह्यासन् सुदुःखिताः ।\nअथर्षयः समुद्विग्ना देवान् गत्वाऽब्रुवन्वचः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2107852, "chapter_id": 3328, "verse_number": "१५", "content_sanskrit": "अग्निनाशात् क्रियाभ्रंशान्नष्टा लोकास्त्रयोऽनघाः ।\nविदध्वमत्र यत् कार्यं न स्यात् कालात्ययो यथा\t ॥ १५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2107853, "chapter_id": 3328, "verse_number": "१६", "content_sanskrit": "अथर्षयश्च देवाश्च ब्रह्माणमुपजग्मतुः\nअग्नेरावेदयन् नाशं क्रियासंहारमेव च \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2107854, "chapter_id": 3328, "verse_number": "१७", "content_sanskrit": "भृगुणा वै महाभागः शप्तोऽग्निः कारणान्तरे\nकथं देवमुखं भूत्वा यज्ञभागाग्रभुक् तथा \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2107855, "chapter_id": 3328, "verse_number": "१८", "content_sanskrit": "हुतभुक् सर्वलोकेषु सर्वभक्षत्वमेष्यति ।\nश्रुत्वा तु तद्वचस्तेषामग्निमाहूय लोककृत् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2107856, "chapter_id": 3328, "verse_number": "", "content_sanskrit": "उवाच वचनं श्लक्ष्णं भूतभावनमव्ययम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2107857, "chapter_id": 3328, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2107858, "chapter_id": 3328, "verse_number": "१९", "content_sanskrit": "लोकानामिह सर्वेषां त्वं कर्ता चान्त एव च \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2107859, "chapter_id": 3328, "verse_number": "२०", "content_sanskrit": "त्वं धारयसि लोकांस्त्रीन् गुणानां च प्रवर्तकः ।\nस तथा कुरु लोकेश नोच्छिद्येरन् क्रिया यथा\t ॥ २०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2107860, "chapter_id": 3328, "verse_number": "२१", "content_sanskrit": "कस्मादेवं स मूढस्त्वं ईशस्त्वं हि हुताशन ।\nत्वं पवित्रं सदा लोके सर्वभूतगतश्च ह\t ॥ २१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2107861, "chapter_id": 3328, "verse_number": "२२", "content_sanskrit": "न त्वं सर्वशरीरेण सर्वभक्षत्वमेष्यसि ।\nउपादानाऽर्चिषो यास्ते सर्वं भक्ष्यन्ति ताः शिखाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2107862, "chapter_id": 3328, "verse_number": "२३", "content_sanskrit": "यथा सूर्यांशुभिः स्पृष्टं सर्वं शुचि विभाव्यते ।\nतथा त्वदर्चिर्निर्दग्धं सर्वं शुचि भविष्यति \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2107863, "chapter_id": 3328, "verse_number": "२४", "content_sanskrit": "तदग्ने त्वं महातेजाः स्वप्रभावाद्विनिर्गतम् ।\nस्वतेजसैव तं शापं कुरु सत्यमृषेर्विभो ।\nदेवानां चात्मनो भागं गृहाण त्वं मुखे हुतम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2107864, "chapter_id": 3328, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2107865, "chapter_id": 3328, "verse_number": "२५", "content_sanskrit": "एवमस्त्विति तं वह्निः प्रत्युवाच पितामहम् ।\nजगाम शासनं कर्तुं देवस्य परमेष्ठिनः\t ॥ २५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2107866, "chapter_id": 3328, "verse_number": "२६", "content_sanskrit": "देवर्षयश्च मुदितास्ततो जग्मुर्यथागतम् ।\nऋषयश्च यथापूर्वं क्रियाः सर्वाः प्रचक्रिरे \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2107867, "chapter_id": 3328, "verse_number": "२७", "content_sanskrit": "दिवि देवा मुमुदिरे भूतसङ्घाश्च लौकिकाः ।\nअग्निश्च परमां प्रीतिमवाप गतकल्मषः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2107868, "chapter_id": 3328, "verse_number": "२८", "content_sanskrit": "एवमेष पुरावृत्त इतिहासोऽग्निशापजः ।\nपुलोम्नोऽस्य विनाशश्च च्यवनस्य च सम्भवः\t ॥ २८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2107869, "chapter_id": 3328, "verse_number": "४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आदिपर्वणि सप्तमोऽध्यायः ॥७॥ ॥ पौलोमपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]