[{"id": 2115314, "chapter_id": 3482, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2115315, "chapter_id": 3482, "verse_number": "१", "content_sanskrit": "एकचक्रां गताः पार्थाः कुन्तीपुत्रा महाबलाः ।\nअतः परं द्विजश्रेष्ठ किमकुर्वत कर्शिताः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2115316, "chapter_id": 3482, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2115317, "chapter_id": 3482, "verse_number": "२", "content_sanskrit": "एकचक्रां गताः पार्था ब्राह्मणस्य निवेशने ।\nरमणीयानि पश्यन्तो वनान्युपवनानि च \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2115318, "chapter_id": 3482, "verse_number": "३", "content_sanskrit": "पार्थिवानपि चोद्देशान् सरितश्च सरांसि च ।\nचेरुर्भैक्षं सदा ते तु सर्व एव विशाम्पते \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2115319, "chapter_id": 3482, "verse_number": "४", "content_sanskrit": "युधिष्ठिरं च कुन्तीं च चिन्तयन्त उपासते ।\nभैक्षं चरन्तस्तु तदा जटिला ब्रह्मचारिणः ।\nबभूवुर्नागराणां ते स्वगुणैः प्रियदर्शनाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2115320, "chapter_id": 3482, "verse_number": "", "content_sanskrit": "नागराः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2115321, "chapter_id": 3482, "verse_number": "५", "content_sanskrit": "दर्शनीया द्विजाः शुद्धा देवगर्भोपमाः शुभाः ।\nभैक्षानर्हाश्च राज्यार्हाः सुकुमारास्तपस्विनः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2115322, "chapter_id": 3482, "verse_number": "६", "content_sanskrit": "सर्वलक्षणसम्पन्ना भैक्षं नार्हन्ति नित्यशः ।\nकार्यार्थिनश्चरन्तीति तर्कयन्त इति ब्रुवन् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2115323, "chapter_id": 3482, "verse_number": "७", "content_sanskrit": "बन्धूनामागमान्नित्यमुपचिन्त्य तु नागराः ।\nभाजनानि च पूर्णानि भक्ष्यभोज्यैरकारयन् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2115324, "chapter_id": 3482, "verse_number": "८", "content_sanskrit": "मौनव्रतेन सम्पूर्णा भैक्षं गृह्णन्ति पाण्डवाः ।\nमाता चिरगतान् दृष्ट्वा शोचतीति च पाण्डवाः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2115325, "chapter_id": 3482, "verse_number": "९", "content_sanskrit": "त्वरमाणा निवर्तन्ते मातृगौरवयन्त्रिताः ।\nनिवेदयन्ति स्म सदा भैक्षं कुन्त्यै च ते निशि \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2115326, "chapter_id": 3482, "verse_number": "१०", "content_sanskrit": "तया विभक्तान् भिक्षाशान् भुञ्जते स्म पृथक्पृथक् ।\nअर्धं तु भुञ्जते वीराः सह मात्रा परन्तपाः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2115327, "chapter_id": 3482, "verse_number": "११", "content_sanskrit": "अर्धं सर्वस्य भैक्षस्य भीमो भुङ्क्ते महाभुजः ।\nन चाशितं स्म भवति कल्याणान्नभृतः पुरा \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2115328, "chapter_id": 3482, "verse_number": "१२", "content_sanskrit": "भीमो विक्रीडयित्वा तु मिथो ब्राह्मणबन्धुषु ।\nकुम्भकारेण सम्बन्धं कृत्वा पात्रं बृहत्ततः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2115329, "chapter_id": 3482, "verse_number": "१३", "content_sanskrit": "स ददाति महत् पात्रं भीमाय प्रहसन्निव ।\nतस्याद्भुतं कर्म कृत्वा महन्मृद्भारमाददे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2115330, "chapter_id": 3482, "verse_number": "१४", "content_sanskrit": "तस्य भारः शतगुणः कुम्भकारमतोषयत् ।\nचक्रे चक्रे तु मृद्भाण्डं सततं भैक्षहारकम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2115331, "chapter_id": 3482, "verse_number": "१५", "content_sanskrit": "तदादायागतं दृष्ट्वा हसन्ति प्रहसन्ति च ।\nभक्ष्यभोज्यानि विविधान्यादाय प्रक्षिपन्ति च \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2115332, "chapter_id": 3482, "verse_number": "१६", "content_sanskrit": "फलमूलानि चान्यानि सखायश्चाहरन्ति च ।\nएवमेष सदा भुक्त्वा मात्रे वदति वै रहः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2115333, "chapter_id": 3482, "verse_number": "१७", "content_sanskrit": "न चाशितोऽस्मि भवति कल्याणान्नभृतः पुरा ।\nस वैवर्ण्यं च कार्श्यं च जगामातृप्तिकारितम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2115334, "chapter_id": 3482, "verse_number": "१८", "content_sanskrit": "तथैव वसतां तेषां ततो राजन् महात्मनाम् ।\nअतिचक्राम सुमहान् कालोऽथ भरतर्षभ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2115335, "chapter_id": 3482, "verse_number": "१९", "content_sanskrit": "ततः कदाचिद् भैक्षार्थं गतास्ते पुरुषर्षभाः ।\nसङ्गत्य भीमसेनस्तु तत्रास्ते पृथया सह \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2115336, "chapter_id": 3482, "verse_number": "२०", "content_sanskrit": "अथार्तिजं महाशब्दं ब्राह्मणस्य निवेशने ।\nभृशमुत्पतितं क्रूरं कुन्ती शुश्राव भारत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2115337, "chapter_id": 3482, "verse_number": "२१", "content_sanskrit": "रोरूयमाणांस्तान् सर्वान् परिदेवयतश्च सा ।\nकारुण्यात् साधुभावाच्च कुन्ती राजन् न चक्षमे\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2115338, "chapter_id": 3482, "verse_number": "२२", "content_sanskrit": "मथ्यमानेव दुःखेन हृदयेन पृथा ततः ।\nउवाच भीमं कल्याणी कृपान्वितमिदं वचः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2115339, "chapter_id": 3482, "verse_number": "२३", "content_sanskrit": "वसामः सुसुखं पुत्र ब्राह्मणस्य निवेशने ।\nअज्ञाता धार्तराष्ट्राणां सत्कृता वीतमन्यवः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2115340, "chapter_id": 3482, "verse_number": "२४", "content_sanskrit": "सा चिन्तये सदा पुत्र ब्राह्मणस्यास्य किं न्वहम् ।\nकदा प्रियं करिष्यामि यत्कुर्यामुषिता वयम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2115341, "chapter_id": 3482, "verse_number": "२५", "content_sanskrit": "एतावान् पुरुषस्तात कृतं यस्मिन् न नश्यति ।\nयावच्च कुर्यादन्योऽस्य कुर्यादभ्यधिकं ततः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2115342, "chapter_id": 3482, "verse_number": "२६", "content_sanskrit": "तथेदं ब्राह्मणस्यास्य दुःखमापतितं ध्रुवम् ।\nतत्रास्य यदि साहाय्यं कुर्यां साधु कृतं भवेत् ।\nगत्वा ज्ञास्यामि यद् दुःखं ब्राह्मणस्याभवत् तदा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2115343, "chapter_id": 3482, "verse_number": "", "content_sanskrit": "भीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2115344, "chapter_id": 3482, "verse_number": "२७", "content_sanskrit": "ज्ञायतामस्य यद् दुःखं यतश्चैव समुत्थितम् ।\nविदित्वा व्यवसिष्यामि यद्यपि स्यात् सुदुष्करम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2115345, "chapter_id": 3482, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2115346, "chapter_id": 3482, "verse_number": "२८", "content_sanskrit": "तथैव कथयन्तौ तौ भूयः शुश्रुवतुः स्वनम् ।\nआर्तिजं तस्य दुःखस्य सभार्यस्य विशाम्पते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2115347, "chapter_id": 3482, "verse_number": "२९", "content_sanskrit": "अन्तर्गृहं ततस्तस्य ब्राह्मणस्य महात्मनः ।\nविवेश कुन्ती त्वरिता बद्धवत्सेव सौरभी \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2115348, "chapter_id": 3482, "verse_number": "३०", "content_sanskrit": "ततस्तं ब्राह्मणं तत्र भार्यया च सुतेन च ।\nदुहित्रा चैव सहितं ददर्श विनताननम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2115349, "chapter_id": 3482, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2115350, "chapter_id": 3482, "verse_number": "३१", "content_sanskrit": "धिगिदं जीवितं लोके गतसारमनर्थकम् ।\nदुःखमूलं पराधीनं भृशमप्रियभावि च\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2115351, "chapter_id": 3482, "verse_number": "३२", "content_sanskrit": "जीविते परमं दुःखं जीविते परमो ज्वरः ।\nजीविते वर्तमानस्य द्वन्द्वानामागमो ध्रुवः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2115352, "chapter_id": 3482, "verse_number": "३३", "content_sanskrit": "एकात्मना च धर्मार्थौ कामं च न निषेवते ।\nएतैश्च विप्रयोगेऽपि दुःखं परतरं मतम् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2115353, "chapter_id": 3482, "verse_number": "३४", "content_sanskrit": "आहुः केचित् परं मोक्षं स च नास्ति कथञ्चन ।\nअर्थप्राप्तौ च नरकं कृत्स्नमेवोपलभ्यते\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2115354, "chapter_id": 3482, "verse_number": "३५", "content_sanskrit": "अर्थेप्सुना परं दुःखमर्थप्राप्तौ ततोऽधिकम् ।\nजातस्नेहस्य चार्थेषु विप्रयोगे महत्तरम् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2115355, "chapter_id": 3482, "verse_number": "३६", "content_sanskrit": "तदिदं जीवितं प्राप्य कल्पकालं महाभयम् ।\nत्यागोऽप्ययं मया प्राप्तो भार्यया सहितेन च \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2115356, "chapter_id": 3482, "verse_number": "३७", "content_sanskrit": "न हि योगं प्रपश्यामि येन मुच्येयमापदः ।\nपुत्रदारेण वा सार्धं प्राद्रवेयमनामयम् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2115357, "chapter_id": 3482, "verse_number": "३८", "content_sanskrit": "उदितं हि मया पूर्वं न स्वार्थं वेत्थ ब्राह्मणि ।\nक्षेमं यतस्ततो गन्तुं त्वया तु मम न श्रुतम् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2115358, "chapter_id": 3482, "verse_number": "३९", "content_sanskrit": "इह जाता विवृद्धाऽस्मि पिता माता ममेति वै ।\nउक्तवत्यसि दुर्मेधे याच्यमाना मयाऽसकृत् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2115359, "chapter_id": 3482, "verse_number": "४०", "content_sanskrit": "स्वर्गतश्च पिता वृद्धः तथा माता चिरं तव ।\nबान्धवा भूतपूर्वाश्च तत्र वासो न कारितः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2115360, "chapter_id": 3482, "verse_number": "४१", "content_sanskrit": "न भोजनं विरुद्धं स्यान्न स्त्रीदेशो निबन्धनः ।\nसुदूरमपि कार्यार्थं व्रजेद् गरुडहंसवत् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2115361, "chapter_id": 3482, "verse_number": "४२", "content_sanskrit": "सोऽयं ते बन्धुकामाया अशृण्वन्त्या वचो मम ।\nबन्धुप्रणाशः सम्प्राप्तो भृशं दुःखकरो मम \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2115362, "chapter_id": 3482, "verse_number": "४३", "content_sanskrit": "सेयमापदमनुप्राप्ता भुङ्क्ष्व ब्राह्मणि तत्फलम् ।\nअथवा त्वद्विनाशाय न हि शक्ष्यामि कञ्चन \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2115363, "chapter_id": 3482, "verse_number": "४४", "content_sanskrit": "परित्यक्तुमहं बन्धुं स्वयं शीघ्रं नृशंसवत् ।\nसहधर्मचरीं दान्तां सदा मातृसमां तथा \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2115364, "chapter_id": 3482, "verse_number": "४५", "content_sanskrit": "सखायं विहितं देवैर्नित्यं परमिकां रतिम् ।\nमात्रा पित्रा विरहितां सदा दाक्षिण्यभागिनीम् \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2115365, "chapter_id": 3482, "verse_number": "४६", "content_sanskrit": "वरयित्वा यथान्यायं मन्त्रवत् परिगृह्य च ।\nकुलीनां शीलसम्पन्नामपत्यजननीमथ \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2115366, "chapter_id": 3482, "verse_number": "४७", "content_sanskrit": "त्वामहं जीवितस्यार्थे साध्वीमनपकारिणीम् ।\nपरित्यक्तुं न शक्ष्यामि भार्यां नित्यमनुव्रताम् \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2115367, "chapter_id": 3482, "verse_number": "४८", "content_sanskrit": "प्रार्थयेऽहं परां प्रीतिं यस्मिन् स्वर्गफलानि च ।\nदयितं मे कथं बालमहं त्यक्तुमिहोत्सहे \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2115368, "chapter_id": 3482, "verse_number": "४९", "content_sanskrit": "यस्य जातस्य पितरो मुखं दृष्ट्वा दिवं गताः ।\nपितॄणां ऋणनिर्मुक्तो यस्य जातस्य तेजसा \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2115369, "chapter_id": 3482, "verse_number": "५०", "content_sanskrit": "तमहं ज्येष्ठपुत्रं मे कुलनिस्तारकं भुवि ।\nमम पिण्डोदकनिधिं कथं त्यक्ष्यामि पुत्रकम् \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2115370, "chapter_id": 3482, "verse_number": "५१", "content_sanskrit": "कुत एव परित्यक्तुं पुत्रीं शक्ष्याम्यहं स्वयम् ।\nभर्तुरर्थाय निक्षिप्तां न्यासं धात्रा महात्मना \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2115371, "chapter_id": 3482, "verse_number": "५१", "content_sanskrit": "यस्यां दौहित्रजाँल्लोकानाशंसे पितृभिः सह ।\nस्वयमुत्पादितां बालां कथमुत्स्रष्टुमुत्सहे \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2115372, "chapter_id": 3482, "verse_number": "५२", "content_sanskrit": "मन्यन्ते केचिदधिकं स्नेहं पुत्रे पितुर्जनाः ।\nकन्यायां केचिदपरे मम तुल्यावुभौ मतौ \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2115373, "chapter_id": 3482, "verse_number": "५३", "content_sanskrit": "यस्यां कामप्रतिष्ठा च वरं नित्यमथो सुखम् ।\nअपापां तां कथं बालामहमुत्स्रष्टुमुत्सहे \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2115374, "chapter_id": 3482, "verse_number": "५४", "content_sanskrit": "मेधाविनीमदोषां च शुश्रूषुमनहङ्कृताम् ।\nकाङ्क्षमाणां रतिं चेह सुखानि च बहूनि च \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2115375, "chapter_id": 3482, "verse_number": "५५", "content_sanskrit": "उत्पादयत्यपत्यानि धर्मकामार्थहेतवे ।\nआत्मानमपि चोत्सृज्य मयि प्रेतवशं गते \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2115376, "chapter_id": 3482, "verse_number": "५६", "content_sanskrit": "त्यक्ता ह्येते मया सर्वे नेह शक्ष्यन्ति जीवितुम् ।\nएषां चान्यतमत्यागो नृशंसो गर्हितो बुधैः \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2115377, "chapter_id": 3482, "verse_number": "५७", "content_sanskrit": "स कृच्छ्रामहमापन्नो न शक्तस्तर्तुमापदम् ।\nअहो धिक् कां गतिं त्वद्य गमिष्यामि सबान्धवः ।\nसर्वैः सह मृतिः श्रेयो न हि मे जीवितुं क्षमम् \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2115378, "chapter_id": 3482, "verse_number": "२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकषष्ठ्यधिकशततमोऽध्यायः ॥१६१॥ ॥ इति बकवधपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2115379, "chapter_id": 3482, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]