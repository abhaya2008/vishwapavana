[{"id": 40017551, "chapter_id": 9264, "verse_number": "1", "content_sanskrit": "प्रवृत्तेसङ्कुलेतस्मिन् घोरेवीरजनक्ष्ये । अङ्गदःकम्पनंवीरमाससादरणोत्सुकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40017552, "chapter_id": 9264, "verse_number": "2", "content_sanskrit": "आहूयसोङ्गदंकोपात्ताडयामासवेगितः । गदयाकम्पनःपूर्वं स चचालभृशाहतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40017553, "chapter_id": 9264, "verse_number": "3", "content_sanskrit": "स संज्ञांप्राप्यतेजस्वीचिक्षेपशिखरंगिरेः । अर्दितस्तत्प्रहारेणकम्पनःपतितोभुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40017554, "chapter_id": 9264, "verse_number": "4", "content_sanskrit": "ततस्तुकम्पनंदृष्टवाशोणिताक्षोहतंरणे । रथेनाभ्यपतत् क्षिप्रंतत्राङ्गदमभीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40017555, "chapter_id": 9264, "verse_number": "5", "content_sanskrit": "सोङ्गदंनिशितैर्बाणैस्तदाविव्याधवेगितः । शरीरदारणैस्तीक्ष्णैःकालाग्निसमविग्रहैः ॥ क्षुरक्षुरप्रैर्नाराचैर्वत्सदन्तैश्शिलीमुखैः । कर्णिशल्यविपाठैश्चबहुभिश्चशितैश्शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40017556, "chapter_id": 9264, "verse_number": "6", "content_sanskrit": "सोङ्गदंनिशितैर्बाणैस्तदाविव्याधवेगितः । शरीरदारणैस्तीक्ष्णैःकालाग्निसमविग्रहैः ॥ क्षुरक्षुरप्रैर्नाराचैर्वत्सदन्तैश्शिलीमुखैः । कर्णिशल्यविपाठैश्चबहुभिश्चशितैश्शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40017557, "chapter_id": 9264, "verse_number": "7", "content_sanskrit": "अङ्गदःप्रतिविद्धाङ्गोवालिपुत्रःप्रतापवान् । धनुरग्य्रंरथंबाणान्ममर्दतरसाबली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40017558, "chapter_id": 9264, "verse_number": "8", "content_sanskrit": "शोणिताक्षस्ततःक्षिप्रमसिचर्मसमाददे । उत्पपातदिवंक्रुद्धोवेगवानविचारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40017559, "chapter_id": 9264, "verse_number": "9", "content_sanskrit": "तंक्षिप्रतरमाफ्लुत्यपरामृश्याङ्गदोबली । करेणतस्यतंखङ्गंसमाच्छिद्यननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40017560, "chapter_id": 9264, "verse_number": "10", "content_sanskrit": "तस्यांसफलकेखडगंनिजघानततोऽङ्गदः । यज्ञोपवीतवच्चैनंचिच्छेदकपिकुञ्जरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40017561, "chapter_id": 9264, "verse_number": "11", "content_sanskrit": "तंप्रगृह्यमहाखडगंविनद्य च पुनःपुनः । वालिपुत्रोऽभिदुद्रावरणशीर्षेपरानरीन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40017562, "chapter_id": 9264, "verse_number": "12", "content_sanskrit": "आयसींतुगदांप्रगृह्य स वीरःकनकाङ्गदः । शोणिताक्षस्समाविध्यतमेवानुपपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40017563, "chapter_id": 9264, "verse_number": "13", "content_sanskrit": "प्रजङ्घसहितोवीरोयूपाक्षस्तुततोबली । रथेनाभिययौक्रुद्दोवालिपुत्रंमहाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40017564, "chapter_id": 9264, "verse_number": "14", "content_sanskrit": "तयोर्मध्येकपिश्रेष्ठश्शोणिताक्षप्रजङ्घयोः । विशाखयोर्मध्यगतःपूर्णचन्द्रइवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40017565, "chapter_id": 9264, "verse_number": "15", "content_sanskrit": "अङ्गदंपरिरक्षन्तौमैन्दोद्विविदएव च । तस्यतस्थतुरभ्याशेपरस्परदिदृक्ष्या ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40017566, "chapter_id": 9264, "verse_number": "16", "content_sanskrit": "भिपेतुर्महाकायाःप्रतियत्तामहाबलाः । राक्षसावानरान् रोषादसिचर्मगदाधराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40017567, "chapter_id": 9264, "verse_number": "17", "content_sanskrit": "त्रयाणांवानरेन्द्राणांत्रिभीराक्षसपुङ्गवैः । संसक्तानांमहद्युद्धमभवद्रोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40017568, "chapter_id": 9264, "verse_number": "18", "content_sanskrit": "तेतुवृक्षान् समादायसम्प्रचिपुराहवे । खडगेनप्रतिचिच्छेदतान् प्रजङ्घोमहाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40017569, "chapter_id": 9264, "verse_number": "19", "content_sanskrit": "रथानश्वान् द्रुमैश्शैलैस्तेप्रचिक्षिपुराहवे । शरौघैःप्रतिचिच्छेदतान्यूपाक्षोनिशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40017570, "chapter_id": 9264, "verse_number": "20", "content_sanskrit": "सृष्टाव्निविदमैन्दाभ्यांद्रुमानुत्पाट्यवीर्यवान् । बभञ्जगदयामध्येशोणिताक्षःप्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40017571, "chapter_id": 9264, "verse_number": "21", "content_sanskrit": "उद्यम्यविपुलंखडगंपरमर्मनिकृन्तनम् । प्रजङ्घोवालिपुत्रायअभिदुद्राववेगितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40017572, "chapter_id": 9264, "verse_number": "22", "content_sanskrit": "तमभ्याशगतंदृष्टवावानरेन्द्रोमहाबलः । आजघानाश्वकर्णेनद्रुमेणातिबलस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40017573, "chapter_id": 9264, "verse_number": "23", "content_sanskrit": "बाहुंचास्यसनिस्त्रिंशमाजघान स मुष्टिना । वालिपुत्रस्यघातेन स पपातक्षितावसिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40017574, "chapter_id": 9264, "verse_number": "24", "content_sanskrit": "तंदृष्टवापतितंभूमौखङ्गमुलसन्निभम् । मुष्टिंसम्वर्तयामासवज्रकल्पंमहाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40017575, "chapter_id": 9264, "verse_number": "25", "content_sanskrit": "स ललाटेमहावीर्यमङ्गदंवानरर्षभम् । आजघानमहातेजास्समुहूर्तंचचाल ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40017576, "chapter_id": 9264, "verse_number": "26", "content_sanskrit": "स संज्ञांप्राप्यतेजस्वीवालिपुत्रःप्रतापवान् । प्रजङ्घस्यशिरःकायातखङ्गेनपातयत्क्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40017577, "chapter_id": 9264, "verse_number": "27", "content_sanskrit": "स यूपाक्षोऽश्रुपूर्णाक्षःपितृव्येनिहतेरणे । अवरुह्यरथात्क्षिप्रंक्षीणेषुखङ्गमाददे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40017578, "chapter_id": 9264, "verse_number": "28", "content_sanskrit": "तमापतन्तंसम्प्रेक्ष्ययूपाक्षंद्विविदस्त्वरन् । आजघानोरसिक्रुद्धोजग्राह च बलाद्बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40017579, "chapter_id": 9264, "verse_number": "29", "content_sanskrit": "गृहीतंभ्रातरंदृष्टवाशोणिताक्षोमहाबलः । आजघानगदाग्रेणवक्षसिद्विविदंततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40017580, "chapter_id": 9264, "verse_number": "30", "content_sanskrit": "स गदाभिहतस्तेनसञ्चचालमहाबलः । उद्यता च पुनस्तस्यजहारद्विविदोगदाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40017581, "chapter_id": 9264, "verse_number": "31", "content_sanskrit": "तस्मिन्नन्तरेमैन्दोवीरोवानरयूथपः । यूपाक्षंताडयामासतलेनोरसिवीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40017582, "chapter_id": 9264, "verse_number": "32", "content_sanskrit": "तौशोणिताक्ष्यूपाक्षौप्लवङ्गाभ्यांतरस्विनौ । चक्रतुस्समरेतीव्रमाकर्षोत्पाटनंभृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40017583, "chapter_id": 9264, "verse_number": "33", "content_sanskrit": "द्विविदश्शोणिताक्षंतुविददारनखैर्मुखै । निष्पिपेष च वेगेनक्षितावाविध्यवीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40017584, "chapter_id": 9264, "verse_number": "34", "content_sanskrit": "पाक्षमभिसङ्कृद्धो मैन्दो वानरयूथपः । पीडयामासबाहुभ्यांसपपातहतःक्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40017585, "chapter_id": 9264, "verse_number": "35", "content_sanskrit": "हतप्रवीराव्यथिताराक्षसेन्द्रचमूस्तदा । जगामाभिमुखीसातुकुम्भकर्णसुतोयतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40017586, "chapter_id": 9264, "verse_number": "36", "content_sanskrit": "आपततनीं च वेगेनकुम्भस्तांसान्त्वयच्चमूम् । अथोत्कष्टंमहावीर्यैर्लब्धलक्ष्यैःप्लवङ्गमैः ॥ निपातितमहावीरांदृष्टवारक्षश्चमूंततः । कुम्भःप्रचक्रेतेजस्वीरणेकर्मसुदुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40017587, "chapter_id": 9264, "verse_number": "37", "content_sanskrit": "आपततनीं च वेगेनकुम्भस्तांसान्त्वयच्चमूम् । अथोत्कष्टंमहावीर्यैर्लब्धलक्ष्यैःप्लवङ्गमैः ॥ निपातितमहावीरांदृष्टवारक्षश्चमूंततः । कुम्भःप्रचक्रेतेजस्वीरणेकर्मसुदुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40017588, "chapter_id": 9264, "verse_number": "38", "content_sanskrit": "स धनुर्धन्विनांश्रेष्ठःप्रगृह्यसुसमाहितः । मुमोचाशीविषप्रख्यान्शरान्देहविदारणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40017589, "chapter_id": 9264, "verse_number": "39", "content_sanskrit": "तस्यतच्छुशुभेभूयस्सशरंधनुरुत्तमम् । विद्युदैरावतार्चिष्मद्िद्वतीयेन्द्रधनुर्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40017590, "chapter_id": 9264, "verse_number": "40", "content_sanskrit": "आकर्णाकृष्टमुक्तेनजघानद्विविदंतदा । तेनहाटकपुङ्खेनपत्रतिणापत्त्रवाससा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40017591, "chapter_id": 9264, "verse_number": "41", "content_sanskrit": "सहसाभिहतस्तेनविप्रमुक्तपदस्स्फुरन् । निपपाताद्रिकूटाभोविह्वलन् प्लवगोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40017592, "chapter_id": 9264, "verse_number": "42", "content_sanskrit": "मन्दस्तुभ्रातरंभग्नंदृष्टवातत्रमहाहवे । लभिदुद्राववेगेनप्रगृह्यमहतींशिलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40017593, "chapter_id": 9264, "verse_number": "43", "content_sanskrit": "तांशिलांतुप्रचिक्षेपराक्षसायमहाबलः । बिभेदतांशिलांकुम्भःप्रसन्नैःपञ्चभिश्शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40017594, "chapter_id": 9264, "verse_number": "44", "content_sanskrit": "सन्धायचान्यंसुमुखंशरमाशीविषोपमम् । आजघानमहातेजावक्षसिद्विविदाग्रजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40017595, "chapter_id": 9264, "verse_number": "45", "content_sanskrit": "स तुतेनप्रहारेणमैन्दोवानरयूथपः । मर्मण्यभिहतस्तेनपपा त भुविमूर्छितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40017596, "chapter_id": 9264, "verse_number": "46", "content_sanskrit": "अङ्गदोमातुलौदृष्टवापथितौतुमहाबलौ । अभिदुद्राववेगेनकुम्भमुद्यतकार्मुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40017597, "chapter_id": 9264, "verse_number": "47", "content_sanskrit": "तमापतन्तंविव्याधकुम्भःपञ्चभिरायसैः । त्रिभिश्चान्यैश्शितैर्बाणैर्मातङ्गमिवतोमरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40017598, "chapter_id": 9264, "verse_number": "48", "content_sanskrit": "सोऽङ्गदंविविधैभिर्बाणैःकुम्भोविव्याथवीर्यवान् । अकुण्ठधारैर्निशितैस्तीक्ष्णैःकनकभूषणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40017599, "chapter_id": 9264, "verse_number": "49", "content_sanskrit": "अङ्गदःप्रतिविद्धाङ्गोवालिपुत्रो न कम्पते । शिलापादपवर्षाणितस्यमूर्ध्निववर्ष ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40017600, "chapter_id": 9264, "verse_number": "50", "content_sanskrit": "स प्रचिच्छेदतान् सर्वान् बिभेद च पुनश्शिलाः । कुम्भकर्णात्मजश्रशीमान् वालिपुत्त्रसमीरितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 40017601, "chapter_id": 9264, "verse_number": "51", "content_sanskrit": "आपतन्तं च ससम्प्रेक्ष्यकुम्भोवानरयूथपम् । भ्रुवोर्विव्याथबाणाभ्यामुल्काभ्यामिवकुञ्जरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 40017602, "chapter_id": 9264, "verse_number": "52", "content_sanskrit": "तस्यसुस्रावरुधिरंपिहितेचास्यलोचने । अङ्गदःपाणिनानेत्रेपिधायरुधिरोक्षिते ॥ सालमासन्नमेकेनपरिजग्राहपाणिवा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 40017603, "chapter_id": 9264, "verse_number": "53", "content_sanskrit": "सम्पीड्यरसिचास्कन्धम् करेणाभिनिवेश्य च ॥ किञ्चिदभ्यवनम्यैनमुन्ममाथयथागजः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 40017604, "chapter_id": 9264, "verse_number": "54", "content_sanskrit": "तमिन्द्रकेतुप्रतिमंवृक्षंमन्दरसन्निभम् ॥ समुत्सृजन्तंवेगेनपश्यतांसर्वरक्षसाम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 40017605, "chapter_id": 9264, "verse_number": "55", "content_sanskrit": "सबिभेदशितैर्बाणैस्सप्तभिःकायभेदनैः ॥ अङ्गदोविव्यधेऽभीक्षणंससादचमुमोह च ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 40017606, "chapter_id": 9264, "verse_number": "56", "content_sanskrit": "अङ्गदंव्यथितंदृष्टवासीदन्तमिवसागरम् ॥ दुरासदंहरिश्रेष्ठंरामायन्येन्यवेदयन् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 40017607, "chapter_id": 9264, "verse_number": "57", "content_sanskrit": "रामस्तुव्यथितंश्रुत्वावालिपुत्त्रंरणाजरे ॥ व्यादिदेशहरिश्रेष्ठान्जाम्बवत्प्रमुखांस्ततः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 40017608, "chapter_id": 9264, "verse_number": "58", "content_sanskrit": "तेतुवानरशार्दूलाश्श्रुत्वारामस्यशासनम् ॥ अभिपेतुस्सुसङ्कृद्धाःकुम्भमुद्यतकार्मुकम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 40017609, "chapter_id": 9264, "verse_number": "59", "content_sanskrit": "ततोद्रुमशिलाहस्ताःकोपसंरक्तलोचनाः ॥ रिरक्षिषन्तोऽभ्यपतन्नङ्गदंवानरर्षभाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 40017610, "chapter_id": 9264, "verse_number": "60", "content_sanskrit": "जाम्बवांश्चसुषेणश्चवेगदर्शी च वानरः ॥ कुम्भकर्णात्मजंवीरंक्रुद्धास्समभिदुद्रुवुः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 40017611, "chapter_id": 9264, "verse_number": "61", "content_sanskrit": "समीक्ष्यापततस्तांस्तुवानरेन्द्रान् महाबलान् ॥ आववारशरौघेणनगेनेवजलाशयम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 40017612, "chapter_id": 9264, "verse_number": "62", "content_sanskrit": "तस्यबाणपथंप्राप्य न शेकुरतिवर्तितुम् ॥ वानरेन्द्रामहात्मानोवेलामिवमहादधिः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 40017613, "chapter_id": 9264, "verse_number": "63", "content_sanskrit": "तांस्तुदृष्टवाहरिगणान् शरवृष्टिभिरर्दितान् ॥ अङ्गदंपृष्ठतःकृत्वाभ्रातृजंप्लवगेश्वरः । भिदुद्राववेगेनसुग्रीवःकुम्भमाहवे ॥ शैलसानुचरंनागंवेगवानिवकेसरी ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 40017614, "chapter_id": 9264, "verse_number": "64", "content_sanskrit": "तांस्तुदृष्टवाहरिगणान् शरवृष्टिभिरर्दितान् ॥ अङ्गदंपृष्ठतःकृत्वाभ्रातृजंप्लवगेश्वरः । भिदुद्राववेगेनसुग्रीवःकुम्भमाहवे ॥ शैलसानुचरंनागंवेगवानिवकेसरी ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 40017615, "chapter_id": 9264, "verse_number": "65", "content_sanskrit": "उत्पाट्य च महाशैलनश्वकर्णान्दवान्बहून् ॥ अन्यांश्चविविधान्ववृक्षाचिक्षेपचिमहाबलः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 40017616, "chapter_id": 9264, "verse_number": "66", "content_sanskrit": "तांछादयन्तीमाकाशंवृक्षवृष्टिंदुरासदाम् ॥ कुम्भकर्णात्मजश्शीघ्रंचिच्छेदनिशितैश्शरैः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 40017617, "chapter_id": 9264, "verse_number": "67", "content_sanskrit": "अभिलक्षेणतीव्रेणकुम्भेननिशितैश्शरैः ॥ अचितास्तेद्रुमारेजुर्यथाघोराषतघ्नयः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 40017618, "chapter_id": 9264, "verse_number": "68", "content_sanskrit": "द्रुमवर्षंतुसञ्छिन्नंदृष्टवाकुम्भोनवीर्यवान् ॥ वानराधिपति: शीमान्महासत्त्वो न विव्यथे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 40017619, "chapter_id": 9264, "verse_number": "69", "content_sanskrit": "निर्भिद्यमानस्सहसासहमानश्चतान् शरान् ॥ कुम्भस्यधनुराक्षिप्यबभञ्जेन्द्रधनुष्प्रभम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 40017620, "chapter_id": 9264, "verse_number": "70", "content_sanskrit": "अवफ्लुत्यततश्शीघ्रंकृत्वाकर्मसुदुष्करम् ॥ अब्रवीत्कुपितःकुम्भंभग्नशृङ्गमिवद्विपम् ।", "pad