[{"id": 5000264000, "chapter_id": 9264, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे सप्तषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000264001, "chapter_id": 9264, "verse_number": "३-६७-१", "content_sanskrit": "पूर्वजोऽप्युक्तमात्रस्तु लक्ष्मणेन सुभाषितम्।\nसारग्राही महासारं प्रतिजग्राह राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000264002, "chapter_id": 9264, "verse_number": "३-६७-२", "content_sanskrit": "स निगृह्य महाबाहुः प्रवृद्धं रोषमात्मनः।\nअवष्टभ्य धनुश्चित्रं रामो लक्ष्मणमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000264003, "chapter_id": 9264, "verse_number": "३-६७-३", "content_sanskrit": "किं करिष्यावहे वत्स क्व वा गच्छाव लक्ष्मण।\nकेनोपायेन पश्यावः सीतामिह विचिन्तय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000264004, "chapter_id": 9264, "verse_number": "३-६७-४", "content_sanskrit": "तं तथा परितापार्तं लक्ष्मणो वाक्यमब्रवीत्।\nइदमेव जनस्थानं त्वमन्वेषितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000264005, "chapter_id": 9264, "verse_number": "३-६७-५", "content_sanskrit": "राक्षसैर्बहुभिः कीर्णं नानाद्रुमलतायुतम्।\nसन्तीह गिरिदुर्गाणि निर्दराः कन्दराणि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000264006, "chapter_id": 9264, "verse_number": "३-६७-६", "content_sanskrit": "गुहाश्च विविधा घोरा नानामृगगणाकुलाः।\nआवासाः किंनराणां च गन्धर्वभवनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000264007, "chapter_id": 9264, "verse_number": "३-६७-७", "content_sanskrit": "तानि युक्तो मया सार्धं समन्वेषितुमर्हसि।\nत्वद्विधा बुद्धिसम्पन्ना महात्मानो नरर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000264008, "chapter_id": 9264, "verse_number": "३-६७-८", "content_sanskrit": "आपत्सु न प्रकम्पन्ते वायुवेगैरिवाचलाः।\nइत्युक्तस्तद् वनं सर्वं विचचार सलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000264009, "chapter_id": 9264, "verse_number": "३-६७-९", "content_sanskrit": "क्रुद्धो रामः शरं घोरं संधाय धनुषि क्षुरम्।\nततः पर्वतकूटाभं महाभागं द्विजोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000264010, "chapter_id": 9264, "verse_number": "३-६७-१०", "content_sanskrit": "ददर्श पतितं भूमौ क्षतजार्द्रं जटायुषम्।\nतं दृष्ट्वा गिरिशृङ्गाभं रामो लक्ष्मणमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000264011, "chapter_id": 9264, "verse_number": "३-६७-११", "content_sanskrit": "अनेन सीता वैदेही भक्षिता नात्र संशयः।\nगृध्ररूपमिदं व्यक्तं रक्षो भ्रमति काननम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000264012, "chapter_id": 9264, "verse_number": "३-६७-१२", "content_sanskrit": "भक्षयित्वा विशालाक्षीमास्ते सीतां यथासुखम्।\nएनं वधिष्ये दीप्ताग्रैः शरैर्घोरैरजिह्मगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000264013, "chapter_id": 9264, "verse_number": "३-६७-१३", "content_sanskrit": "इत्युक्त्वाभ्यपतद् द्रष्टुं संधाय धनुषि क्षुरम्।\nक्रुद्धो रामः समुद्रान्तां चालयन्निव मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000264014, "chapter_id": 9264, "verse_number": "३-६७-१४", "content_sanskrit": "तं दीनदीनया वाचा सफेनं रुधिरं वमन्।\nअभ्यभाषत पक्षी स रामं दशरथात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000264015, "chapter_id": 9264, "verse_number": "३-६७-१५", "content_sanskrit": "यामोषधीमिवायुष्मन्नन्वेषसि महावने।\nसा देवी मम च प्राणा रावणेनोभयं हृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000264016, "chapter_id": 9264, "verse_number": "३-६७-१६", "content_sanskrit": "त्वया विरहिता देवी लक्ष्मणेन च राघव।\nह्रियमाणा मया दृष्टा रावणेन बलीयसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000264017, "chapter_id": 9264, "verse_number": "३-६७-१७", "content_sanskrit": "सीतामभ्यवपन्नोऽहं रावणश्च रणे प्रभो।\nविध्वंसितरथच्छत्रः पतितो धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000264018, "chapter_id": 9264, "verse_number": "३-६७-१८", "content_sanskrit": "एतदस्य धनुर्भग्नमेते चास्य शरास्तथा।\nअयमस्य रणे राम भग्नः सांग्रामिको रथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000264019, "chapter_id": 9264, "verse_number": "३-६७-१९", "content_sanskrit": "अयं तु सारथिस्तस्य मत्पक्षनिहतो भुवि।\nपरिश्रान्तस्य मे पक्षौ छित्त्वा खड्गेन रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000264020, "chapter_id": 9264, "verse_number": "३-६७-२०", "content_sanskrit": "सीतामादाय वैदेहीमुत्पपात विहायसम्।\nरक्षसा निहतं पूर्वं मां न हन्तुं त्वमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000264021, "chapter_id": 9264, "verse_number": "३-६७-२१", "content_sanskrit": "रामस्तस्य तु विज्ञाय सीतासक्तां प्रियां कथाम्।\nगृध्रराजं परिष्वज्य परित्यज्य महद् धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000264022, "chapter_id": 9264, "verse_number": "३-६७-२२", "content_sanskrit": "निपपातावशो भूमौ रुरोद सहलक्ष्मणः।\nद्विगुणीकृततापार्तो रामो धीरतरोऽपि सन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000264023, "chapter_id": 9264, "verse_number": "३-६७-२३", "content_sanskrit": "एकमेकायने कृच्छ्रे निःश्वसन्तं मुहुर्मुहुः।\nसमीक्ष्य दुःखितो रामः सौमित्रिमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000264024, "chapter_id": 9264, "verse_number": "३-६७-२४", "content_sanskrit": "राज्यं भ्रष्टं वने वासः सीता नष्टा मृतो द्विजः।\nईदृशीयं ममालक्ष्मीर्दहेदपि हि पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000264025, "chapter_id": 9264, "verse_number": "३-६७-२५", "content_sanskrit": "सम्पूर्णमपि चेदद्य प्रतरेयं महोदधिम्।\nसोऽपि नूनं ममालक्ष्म्या विशुष्येत् सरितां पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000264026, "chapter_id": 9264, "verse_number": "३-६७-२६", "content_sanskrit": "नास्त्यभाग्यतरो लोके मत्तोऽस्मिन् स चराचरे।\nयेनेयं महती प्राप्ता मया व्यसनवागुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000264027, "chapter_id": 9264, "verse_number": "३-६७-२७", "content_sanskrit": "अयं पितुर्वयस्यो मे गृध्रराजो महाबलः।\nशेते विनिहतो भूमौ मम भाग्यविपर्ययात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000264028, "chapter_id": 9264, "verse_number": "३-६७-२८", "content_sanskrit": "इत्येवमुक्त्वा बहुशो राघवः सहलक्ष्मणः।\nजटायुषं च पस्पर्श पितृस्नेहं निदर्शयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000264029, "chapter_id": 9264, "verse_number": "३-६७-२९", "content_sanskrit": "निकृत्तपक्षं रुधिरावसिक्तं\nतं गृध्रराजं परिगृह्य राघवः।\nक्व मैथिली प्राणसमा गतेति\nविमुच्य वाचं निपपात भूमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000264030, "chapter_id": 9264, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे सप्तषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]