nt_sanskrit": "महाविमर्दंसमरेमयासहतवाद्भुतम् । अद्यभूतानिपश्यन्तुशक्रशम्बरयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 40017628, "chapter_id": 9264, "verse_number": "78", "content_sanskrit": "कृतमप्रतिमंकर्मदर्शितंचास्त्रकौशलम् । पातिताहरिवीराश्चत्वयावैभीमविक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 40017629, "chapter_id": 9264, "verse_number": "79", "content_sanskrit": "उपालम्भभयाच्चापिनासिवीरमयाहतः । कृतकर्मपरिश्रान्तोविश्रान्तःपश्यमेबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 40017630, "chapter_id": 9264, "verse_number": "80", "content_sanskrit": "तेनसुग्रीववाक्येनसावमानेनमानितः । अग्नेराज्याहुतस्येवतेजस्तस्याभ्यवर्धत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 40017631, "chapter_id": 9264, "verse_number": "81", "content_sanskrit": "तेनसुग्रीववाक्येनसावमानेनमानितः । अग्नेराज्याहुतस्येवतेजस्तस्याभ्यवर्धत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 40017632, "chapter_id": 9264, "verse_number": "82", "content_sanskrit": "तेनसुग्रीववाक्येनसावमानेनमानितः । अग्नेराज्याहुतस्येवतेजस्तस्याभ्यवर्धत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 40017633, "chapter_id": 9264, "verse_number": "83", "content_sanskrit": "तयोःपादाभिघाताच्चनिमग्नाचाभवन्महि । व्याघूर्णिततरङ्गश्चचुक्षुभेवरुणालयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 40017634, "chapter_id": 9264, "verse_number": "84", "content_sanskrit": "ततःकुम्भंसमुत्क्षिप्यसुग्रीवोलवणाम्भसि । पातयामासवेगेनदर्शयन