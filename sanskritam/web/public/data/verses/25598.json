[{"id": 7005598000, "chapter_id": 25598, "verse_number": "७१-१", "content_sanskrit": "अशून्यशयनव्रतकथनम्  ।\nब्रह्मोवाच ।\nभगवन् पुरुषस्येह स्त्रियाश्च विराहादिकम् ।\nशोकव्याधिभयं दुःखं न भवेद्येन तद्वद ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005598001, "chapter_id": 25598, "verse_number": "७१-२", "content_sanskrit": "श्रीभगवानुवाच ।\nश्रावणस्य द्वितीयायां कृष्णायां मधुसूदनः ।\nक्षीरार्णवे सपत्नीकः सदा वसति केशवः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005598002, "chapter_id": 25598, "verse_number": "७१-३", "content_sanskrit": "तस्यां सम्पूज्य गोविन्दं सर्वान् कामान् समश्नुते ।\nगोभूहिरण्यदानादि सप्तकल्पशतानुगम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005598003, "chapter_id": 25598, "verse_number": "७१-४", "content_sanskrit": "अशून्यशयनं नाम द्वितीया सम्प्रकीर्त्तिता ।\nतस्यां सम्पूजयेद्विष्णुमेभिर्मन्त्रैर्विधानतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005598004, "chapter_id": 25598, "verse_number": "७१-५", "content_sanskrit": "श्रीवत्सधारिन्! श्रीकान्त! श्रीधामन्!श्रीपतेऽव्यय! ।\nगार्हस्थ्यं मा प्रणाशं मे यातु धर्म्मार्थकामदम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005598005, "chapter_id": 25598, "verse_number": "७१-६", "content_sanskrit": "अग्नयो मा प्रणश्यन्तु देवताः पुरुषोत्तम! ।\nपितरो मा प्रणश्यन्तु मास्तु दाम्पत्यभेदनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005598006, "chapter_id": 25598, "verse_number": "७१-७", "content_sanskrit": "लक्ष्म्या वियुज्य ते देव! न कदाचिद्यथा भवान् ।\nतथा कलत्र सम्बन्धो देव! मा मे वियुज्यताम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005598007, "chapter_id": 25598, "verse_number": "७१-८", "content_sanskrit": "लक्ष्म्या न शून्यो वरद! श्य्यां त्वं शयनं गतः ।\nशय्याममाप्यशून्यास्तु तथैव मधुसूदन! ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005598008, "chapter_id": 25598, "verse_number": "७१-९", "content_sanskrit": "गीतवादित्रनिर्घोषं देवदेवस्य कीर्त्तयेत् ।\nघण्टाभवेदशक्तस्य सर्ववाद्यमयी यतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005598009, "chapter_id": 25598, "verse_number": "७१-१०", "content_sanskrit": "एवं सम्पूज्य गोविन्दमश्नीयात्तैलवर्जितम् ।\nनक्तमक्षारलवणं यावत्तत्स्याच्चतुष्टयम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005598010, "chapter_id": 25598, "verse_number": "७१-११", "content_sanskrit": "ततः प्रभावे सञ्जाते लक्ष्मीपतिसमन्विताम् ।\nदीपान्नभाजनैर्युक्तां शय्यां दद्याद्विलक्षणाम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005598011, "chapter_id": 25598, "verse_number": "७१-१२", "content_sanskrit": "पादुकोपानहच्छत्रचामरासनसंयुताम् ।\nअभीष्टोपस्करैर्युक्तां शुक्लपुष्पाम्बरावृताम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005598012, "chapter_id": 25598, "verse_number": "७१-१३", "content_sanskrit": "सोपधानकविश्रामां फलैर्नानाविधैर्युताम् ।\nतथाभरणधान्यैश्च यथाशक्त्या समन्विताम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005598013, "chapter_id": 25598, "verse_number": "७१-१४", "content_sanskrit": "अव्यङ्गाङ्गाय विप्राय वैष्णवाय कुटुम्बिने ।\nदातव्या वेदविदुषे भावेनापतिताय च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005598014, "chapter_id": 25598, "verse_number": "७१-१५", "content_sanskrit": "तत्रोपविश्यदाम्पत्यमलङ्कृत्य विधानतः ।\nपत्न्यास्तु भाजनं दद्यात् भक्ष्यभोज्यसमन्वितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005598015, "chapter_id": 25598, "verse_number": "७१-१६", "content_sanskrit": "ब्राह्मणस्यापि सौवर्णीमुपस्करसमन्विताम् ।\nप्रतिमां देवदेवस्य सोदकुम्भां निवेदयेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005598016, "chapter_id": 25598, "verse_number": "७१-१७", "content_sanskrit": "एवं यस्तु पुमान् कुर्य्यादशून्यशयनं हरेः ।\nवित्तशाठ्येन रहितो नारायणपरायणः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005598017, "chapter_id": 25598, "verse_number": "७१-१८", "content_sanskrit": "नारीवा विधवा ब्रह्मन्! यावच्चन्द्रार्कतारकम् ।\nन विरूपौ न शोकार्त्ती दम्पती भवतः क्वचित् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005598018, "chapter_id": 25598, "verse_number": "७१-१९", "content_sanskrit": "न पुत्रपशुरत्नानि क्षयं यान्ति पितामह! ।\nसप्तकल्पसहस्राणि सप्तकल्पशतानि  ।\nकुर्वन्नशून्यशयनं विष्णुलोके महीयते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]