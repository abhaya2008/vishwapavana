[{"id": 7000581000, "chapter_id": 20581, "verse_number": "५-४०-१", "content_sanskrit": "शेष उवाच ।\nसेनाचरा महाराज्ञो महाबलसमन्विताः ।\nसमागतास्तं पश्यंतो हयं रामस्य भूपतेः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000581001, "chapter_id": 20581, "verse_number": "५-४०-२", "content_sanskrit": "क्वा सावश्वः केन नीतः कथं वा दृश्यते न सः ।\nको गंता यमपुर्यां वै वाहं हृत्वा सुमंदधीः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000581002, "chapter_id": 20581, "verse_number": "५-४०-३", "content_sanskrit": "विलोकयंतस्तन्मार्गं यावत्सेनाचरा रघोः ।\nतावत्प्राप्तो महाराजो महासैन्यपरीवृतः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000581003, "chapter_id": 20581, "verse_number": "५-४०-४", "content_sanskrit": "पप्रच्छ सेवकान्सर्वान्कुत्राश्वो मम सांप्रतम् ।\nन दृश्यते कथं वाहः स्वर्णपत्रसुशोभितः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000581004, "chapter_id": 20581, "verse_number": "५-४०-५", "content_sanskrit": "इति तद्वचनं श्रुत्वा सेवकास्ते हयानुगाः ।\nप्रोचुर्नाथ मनोवेगो वाहः केनापि कानने॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000581005, "chapter_id": 20581, "verse_number": "५-४०-६", "content_sanskrit": "हृतो न लक्ष्यते तस्मादस्माभिर्मार्गकोविदैः ।\nतदत्र यत्नः कर्तव्यो हयप्राप्तिं प्रति प्रभो॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000581006, "chapter_id": 20581, "verse_number": "५-४०-७", "content_sanskrit": "तेषां वचनमाकर्ण्य पप्रच्छ सुमतिं नृपः ।\nशत्रुघ्नः शत्रुसंहारकारीमोहनरूपधृक्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000581007, "chapter_id": 20581, "verse_number": "५-४०-८", "content_sanskrit": "शत्रुघ्न उवाच ।\nकोऽत्र राजा निवसति कथं वाहस्य संगमः ।\nकियद्बलं भूमिपतेर्येन मेऽद्य हृतो हयः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000581008, "chapter_id": 20581, "verse_number": "५-४०-९", "content_sanskrit": "सुमतिरुवाच ।\nराजन्देवपुरं ह्येतद्देवेनैव विनिर्मितम् ।\nकैलासमिव दुर्गम्यं वैरिसंघैः सुसंहतैः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000581009, "chapter_id": 20581, "verse_number": "५-४०-१०", "content_sanskrit": "अस्मिन्वीरमणी राजा महाशूरः प्रतापवान् ।\nराज्यं करोति धर्मेण शिवेन परिरक्षितः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000581010, "chapter_id": 20581, "verse_number": "५-४०-११", "content_sanskrit": "योऽसौ प्रलयकारी स आस्ते भक्त्या वशीकृतः ।\nचंद्रचूडः स्वभक्तस्य पक्षपातं सृजन्सदा॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000581011, "chapter_id": 20581, "verse_number": "५-४०-१२", "content_sanskrit": "तस्मादत्र महद्युद्धं गृहीतश्चेद्भविष्यति ।\nयत्ताः संतः प्रकुर्वंतु रक्षणं कटकस्य हि॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000581012, "chapter_id": 20581, "verse_number": "५-४०-१३", "content_sanskrit": "एवं श्रुत्वा स शत्रुघ्नः सर्वभूपशिरोमणिः ।\nसैन्यव्यूहं रचित्वासौ तिष्ठति स्म महायशाः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000581013, "chapter_id": 20581, "verse_number": "५-४०-१४", "content_sanskrit": "अथ तं सुखमासीनं मंत्रयंतं सुमंत्रिणा ।\nआजगाम स देवर्षिर्युद्धकौतुकसंयुतः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000581014, "chapter_id": 20581, "verse_number": "५-४०-१५", "content_sanskrit": "तमागतं मुनिं दृष्ट्वा शत्रुघ्नस्तपसां निधिम् ।\nअभ्युत्थायासने स्थाप्य मधुपर्कमथार्पयत्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000581015, "chapter_id": 20581, "verse_number": "५-४०-१६", "content_sanskrit": "स्वागतेन च संतुष्टं नारदं मुनिसत्तमम् ।\nउवाच प्रीणयन्वाचा वाक्यवादविशारदः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000581016, "chapter_id": 20581, "verse_number": "५-४०-१७", "content_sanskrit": "शत्रुघ्न उवाच ।\nमदीयोऽश्व कुत्र विप्र कथयस्व महामते ।\nन लक्ष्यते गतिस्तस्य सेवकैर्मम कोविदैः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000581017, "chapter_id": 20581, "verse_number": "५-४०-१८", "content_sanskrit": "शंस तं येन वा नीतं क्षत्त्रियेण च मानिना ।\nकथमत्र हयप्राप्तिर्भविष्यति तपोधन॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000581018, "chapter_id": 20581, "verse_number": "५-४०-१९", "content_sanskrit": "इति वाक्यं समाकर्ण्य शत्रुघ्नस्य स नारदः ।\nउवाच वीणां रणयन्गायन्रामकथां मुहुः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000581019, "chapter_id": 20581, "verse_number": "५-४०-२०", "content_sanskrit": "नारद उवाच ।\nएतद्देवपुरं राजन्भूपो वीरमणिर्महान् ।\nतत्पुत्रेण वनस्थेन गृहीतस्तव वाजिराट्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000581020, "chapter_id": 20581, "verse_number": "५-४०-२१", "content_sanskrit": "तत्र युद्धं महत्तेऽद्य भविष्यति सुदारुणम् ।\nअत्र वीराः पतिष्यंति बलशौर्यसमन्विताः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000581021, "chapter_id": 20581, "verse_number": "५-४०-२२", "content_sanskrit": "तस्मादत्र महायत्नात्स्थातव्यं ते महाबल ।\nरचय व्यूहरचनां दुर्गमां परसैनिकैः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000581022, "chapter_id": 20581, "verse_number": "५-४०-२३", "content_sanskrit": "जयस्ते भविता राजन्कृच्छ्रेणास्मान्नृपोत्तमात् ।\nरामं को नु पराजीयाद्भुवने सकले ह्यपि॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000581023, "chapter_id": 20581, "verse_number": "५-४०-२४", "content_sanskrit": "इत्युक्त्वांतर्दधे विप्रो नभसि स्थितवांस्ततः ।\nयुद्धं सुदारुणं द्रक्ष्यन्देवदानवयोरिव॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000581024, "chapter_id": 20581, "verse_number": "५-४०-२५", "content_sanskrit": "शेष उवाच ।\nअथ राजा वीरमणिः सर्वशूरशिरोमणिः ।\nपटहं घोषितुं स्वीये पुरमध्ये महारवम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000581025, "chapter_id": 20581, "verse_number": "५-४०-२६", "content_sanskrit": "आह्वयामास सेनान्यं रिपुवीरं महोन्नतम् ।\nकथयामास च क्षिप्रं मेघगंभीरया गिरा॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000581026, "chapter_id": 20581, "verse_number": "५-४०-२७", "content_sanskrit": "वीरमणिरुवाच ।\nसेनानीः पटहस्याज्ञां देहि मे शोभने पुरे ।\nतच्छ्रुत्वा मे सुसन्नद्धाः शत्रुघ्नं प्रति यांतु ते॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000581027, "chapter_id": 20581, "verse_number": "५-४०-२८", "content_sanskrit": "इति वाक्यं समाकर्ण्य राज्ञो वीरमणेस्तदा ।\nकारयामास पटहं महारवनिनादितम्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000581028, "chapter_id": 20581, "verse_number": "५-४०-२९", "content_sanskrit": "गेहे गेहे च रथ्यायां श्रूयते पटहध्वनिः ।\nशत्रुघ्नं यांतु ये सर्वे वीरा राजपुरे स्थिताः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000581029, "chapter_id": 20581, "verse_number": "५-४०-३०", "content_sanskrit": "ये वै राज्ञः समुल्लंघ्य शासनं वीरमानिनः ।\nपुत्रा वा भ्रातरो वापि ते वध्याः स्युर्नृपाज्ञया॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000581030, "chapter_id": 20581, "verse_number": "५-४०-३१", "content_sanskrit": "शृण्वंतु वीराः पुनरप्याह ते पटहे रवम् ।\nश्रुत्वा विधीयतामाशु कर्तव्यं मा विलंबितम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000581031, "chapter_id": 20581, "verse_number": "५-४०-३२", "content_sanskrit": "शेष उवाच ।\nइति पटहरवं स्वकर्णगोचरं ।\nनरवरवीरवरा ययुर्नृपोत्तमम् ।\nकनककवचभूषितस्वदेहाः ।\nसमरमहोत्सव हृष्टचित्तकोशाः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000581032, "chapter_id": 20581, "verse_number": "५-४०-३३", "content_sanskrit": "केचिद्ययुः शिरस्त्राणं धृत्वा शिरसि शोभनम् ।\nकवचेन सुशोभाढ्याः शतकोटिसुशोभिताः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000581033, "chapter_id": 20581, "verse_number": "५-४०-३४", "content_sanskrit": "रथेन हययुग्मेन मणिकांचनशोभिना ।\nययुस्ते राजसंदेशान्नृवरालयमुन्मदाः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000581034, "chapter_id": 20581, "verse_number": "५-४०-३५", "content_sanskrit": "केचिन्मतंगजैर्मत्तैः केचिद्वाहैः सुशोभनैः ।\nययुर्नपगृहं सर्वे राजसंदेशकारकाः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000581035, "chapter_id": 20581, "verse_number": "५-४०-३६", "content_sanskrit": "विविक्तस्वर्णकवचशिरस्त्राणसुशोभितः ।\nरुक्मांगदोऽपि च निजे रथे तिष्ठन्मनोजवे॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000581036, "chapter_id": 20581, "verse_number": "५-४०-३७", "content_sanskrit": "शुभांगदोऽनुजस्तस्य महारत्नमयं दधत् ।\nकवचं वपुषि श्रेष्ठं निजं प्रायाद्रणोत्सवे॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000581037, "chapter_id": 20581, "verse_number": "५-४०-३८", "content_sanskrit": "राजभ्राता वीरसिंहः सर्वशस्त्रास्त्रकोविदः ।\nययौ नृपाज्ञया तत्र शासनं भूमिपस्य हि॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000581038, "chapter_id": 20581, "verse_number": "५-४०-३९", "content_sanskrit": "जामेयस्तस्य राज्ञोऽपि बलमित्र इति स्मृतः ।\nसन्नद्धः कवची खड्गी जगाम नृपमंदिरम्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000581039, "chapter_id": 20581, "verse_number": "५-४०-४०", "content_sanskrit": "सेनानी रिपुवारोऽपि सेनां तां चतुरंगिणीम् ।\nसज्जां विधाय भूपाय न्यवेदयदथो महान्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000581040, "chapter_id": 20581, "verse_number": "५-४०-४१", "content_sanskrit": "अथ राजा वीरमणिः सर्वशस्त्रास्त्रपूरितम् ।\nमणिसृष्टोच्चचक्रोच्चमारोहत्स्यंदनोत्तमम्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000581041, "chapter_id": 20581, "verse_number": "५-४०-४२", "content_sanskrit": "ततो वीरार्णवे शंखनिनादश्च समंततः ।\nश्रूयते कातरान्वीरान्प्रेरयन्निव संगरे॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000581042, "chapter_id": 20581, "verse_number": "५-४०-४३", "content_sanskrit": "भेर्यः समंततो जघ्नुः शुभवादकवादिताः ।\nअनीकान्यत्र तस्यासन्संग्रामाय प्रतस्थुषः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000581043, "chapter_id": 20581, "verse_number": "५-४०-४४", "content_sanskrit": "सर्वे कृतस्वस्त्ययनाः सर्वाभरणभूषिताः ।\nसर्वशस्त्रास्त्रसंपूर्णा ययुः समरमण्डलम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000581044, "chapter_id": 20581, "verse_number": "५-४०-४५", "content_sanskrit": "भेरीशंखनिनादेन पूरिताश्च नगा गुहाः ।\nआकारितुं गतः किं नु तद्रवः स्वर्गसंस्थितान्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000581045, "chapter_id": 20581, "verse_number": "५-४०-४६", "content_sanskrit": "तस्मिन्कोलाहले वृत्ते राजा वीरमणिर्महान् ।\nरणोत्साहेन संयुक्तो ययौ प्रधनमंडलम्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000581046, "chapter_id": 20581, "verse_number": "५-४०-४७", "content_sanskrit": "आगत्य संस्थितस्तावद्रथपत्तिसमाकुलम् ।\nसमुद्र इव तत्स्थानात्प्लावितुं पुरुषानयात्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000581047, "chapter_id": 20581, "verse_number": "५-४०-४८", "content_sanskrit": "तदागतं बलं दृष्ट्वा रथिभिः शस्त्रकोविदैः ।\nकोलाहलीकृतं सर्वमुवाच सुमतिं नृपः॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000581048, "chapter_id": 20581, "verse_number": "५-४०-४९", "content_sanskrit": "शत्रुघ्न उवाच ।\nसमागतो वीरमणिर्मम वाजिधरो बली ।\nयोद्धुं मां महता भूयः सैन्येन चतुरंगिणा॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000581049, "chapter_id": 20581, "verse_number": "५-४०-५०", "content_sanskrit": "कथं युद्धं प्रकर्तव्यं के योत्स्यंति बलोत्कटाः ।\nतान्सर्वान्दिश मे वीरान्यथा स्याज्जय ईप्सितः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000581050, "chapter_id": 20581, "verse_number": "५-४०-५१", "content_sanskrit": "सुमतिरुवाच ।\nस्वामिन्नसौ महाराजो महासैन्यपरीवृतः ।\nसमागतः स युद्धार्थं शिवभक्तिसमन्वितः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000581051, "chapter_id": 20581, "verse_number": "५-४०-५२", "content_sanskrit": "सांप्रतं युद्ध्यतां वीरः पुष्कलः परमास्त्रवित् ।\nअन्येपि नीलरत्नाद्या योद्धारो युद्धकोविदाः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000581052, "chapter_id": 20581, "verse_number": "५-४०-५३", "content_sanskrit": "शिवेन सह योद्धव्यं राज्ञा वा भवतानघ ।\nद्वंद्वयुद्धेन जेतव्यो महाबलपराक्रमः॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000581053, "chapter_id": 20581, "verse_number": "५-४०-५४", "content_sanskrit": "अनेन विधिना राजञ्जयस्तेऽत्र भविष्यति ।\nपश्चाद्यद्रोचते स्वामिंस्तत्कुरुष्व महामते॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000581054, "chapter_id": 20581, "verse_number": "५-४०-५५", "content_sanskrit": "शेष उवाच ।\nइति वाक्यं समाकर्ण्य शत्रुघ्नः परवीरहा ।\nसुभटानादिदेशाथ युद्धाय कृतनिश्चयः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000581055, "chapter_id": 20581, "verse_number": "५-४०-५६", "content_sanskrit": "सर्वैः ससैन्यैर्युद्धार्थं राजभिः शस्त्रकोविदैः ।\nयथा स्यान्मे जयः क्षिप्रं यतितव्यं तथा पुनः॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000581056, "chapter_id": 20581, "verse_number": "५-४०-५७", "content_sanskrit": "जयार्थं राघवस्यैव श्रुत्वा ते रणकोविदाः ।\nमहोत्साहेन संयुक्ता ययुर्योद्धुं तु सैनिकैः॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]