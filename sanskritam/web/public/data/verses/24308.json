[{"id": 7004308000, "chapter_id": 24308, "verse_number": "५-३-२-१", "content_sanskrit": "सूत उवाच॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004308001, "chapter_id": 24308, "verse_number": "५-३-२-२", "content_sanskrit": "नर्मदायास्तु माहात्म्यं कृष्णद्वैपायनोऽब्रवीत् ।\nतत्तेऽहं सम्प्रवक्ष्यामि यत्त्वया परिपृच्छितम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004308002, "chapter_id": 24308, "verse_number": "५-३-२-३", "content_sanskrit": "विस्तरं नर्मदायास्तु तीर्थानां मुनिसत्तम ।\nकोऽन्यः शक्तोऽस्ति वै वक्तुमृते ब्रह्माणमीश्वरम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004308003, "chapter_id": 24308, "verse_number": "५-३-२-४", "content_sanskrit": "एतमेव पुरा प्रश्नं पृष्टवाञ्जनमेजयः ।\nवैशंपायनसंज्ञं तु शिष्यं द्वैपायनस्य ह॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004308004, "chapter_id": 24308, "verse_number": "५-३-२-५", "content_sanskrit": "रेवातीर्थाश्रितं पुण्यं तत्ते वक्ष्यामि शौनक ।\nपुरा पारीक्षितो राजा यज्ञादीक्षासु दीक्षितः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004308005, "chapter_id": 24308, "verse_number": "५-३-२-६", "content_sanskrit": "संभृते तु हविर्द्रव्ये वर्तमानेषु कर्मसु ।\nआसीनेषु द्विजाग्र्येषु हूयमाने हुताशने॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004308006, "chapter_id": 24308, "verse_number": "५-३-२-७", "content_sanskrit": "वर्तमानासु सर्वत्र तथा धर्मकथासु च ।\nश्रूयमाणे तथा शब्दे जनैरुक्ते त्वहर्निशम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004308007, "chapter_id": 24308, "verse_number": "५-३-२-८", "content_sanskrit": "यज्ञभूमौ कुलपते दीयतां भुज्यतामिति ।\nविविधांश्च विनोदान्वै कुर्वाणेषु विनोदिषु॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004308008, "chapter_id": 24308, "verse_number": "५-३-२-९", "content_sanskrit": "एवंविधे वर्तमाने यज्ञे स्वर्गसदःसमे ।\nवैशंपायनमासीनं पप्रच्छ जनमेजयः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004308009, "chapter_id": 24308, "verse_number": "५-३-२-१०", "content_sanskrit": "जनमेजय उवाच ।\nद्वैपायनप्रसादेन ज्ञानवानसि मे मतः ।\nवैशंपायन तस्मात्त्वां पृच्छामि ऋषिसन्निधौ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004308010, "chapter_id": 24308, "verse_number": "५-३-२-११", "content_sanskrit": "ब्रूहि मे त्वं पुरावृत्तं पितृणां तीर्थसेवनम् ।\nचिरं नानाविधान्क्लेशान् प्राप्तास्त इति मे श्रुतम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004308011, "chapter_id": 24308, "verse_number": "५-३-२-१२", "content_sanskrit": "कथं द्यूतजिताः पार्था मम पूर्वपितामहाः ।\nआसमुद्रां महीं विप्र भ्रमन्तस्तीर्थलोभतः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004308012, "chapter_id": 24308, "verse_number": "५-३-२-१३", "content_sanskrit": "केन ते सहितास्तात भूमिभागाननेकशः ।\nचेरुः कथय तत्सर्वं सर्वज्ञोऽसि मतो मम॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004308013, "chapter_id": 24308, "verse_number": "५-३-२-१४", "content_sanskrit": "वैशंपायन उवाच॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004308014, "chapter_id": 24308, "verse_number": "५-३-२-१५", "content_sanskrit": "कथयिष्यामि भूनाथ यत्पृष्टं तु त्वयाऽनघ ।\nनमस्कृत्य विरूपाक्षं वेदव्यासं महाकविम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004308015, "chapter_id": 24308, "verse_number": "५-३-२-१६", "content_sanskrit": "पितामहास्तु ते पञ्च पाण्डवाः सह कृष्णया ।\nउषित्वा ब्राह्मणैः सार्धं काम्यके वन उत्तमे॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004308016, "chapter_id": 24308, "verse_number": "५-३-२-१७", "content_sanskrit": "प्रधानोद्दालके तत्र कश्यपोऽथ महामतिः ।\nविभाण्डकश्च राजेन्द्र मुरुश्चैव महामुनिः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004308017, "chapter_id": 24308, "verse_number": "५-३-२-१८", "content_sanskrit": "पुलस्त्यो लोमशश्चैव तथान्ये पुत्रपौत्रिणः ।\nस्नात्वा निःशेषतीर्थेषु गतास्ते विन्ध्यपर्वतम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004308018, "chapter_id": 24308, "verse_number": "५-३-२-१९", "content_sanskrit": "ते च तत्राश्रमं पुण्यं सर्वैर्वृक्षैः समाकुलम् ।\nचम्पकैः कर्णकारैश्च पुन्नागैर्नागकेसरैः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004308019, "chapter_id": 24308, "verse_number": "५-३-२-२०", "content_sanskrit": "बकुलैः कोविदारैश्च दाडिमैरुपशोभितम् ।\nपुष्पितैरर्जुनैश्चैव बिल्वपाटलकेतकैः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004308020, "chapter_id": 24308, "verse_number": "५-३-२-२१", "content_sanskrit": "कदम्बाम्रमधूकैश्च निम्बजम्बीरतिन्दुकैः ।\nनालिकेरैः कपित्थैश्च खर्जूरपनसैस्तथा॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004308021, "chapter_id": 24308, "verse_number": "५-३-२-२२", "content_sanskrit": "नानाद्रुमलताकीर्णं नानावल्लीभिरावृतम् ।\nसपुष्पं फलितं कान्तं वनं चैत्ररथं यथा॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004308022, "chapter_id": 24308, "verse_number": "५-३-२-२३", "content_sanskrit": "जलाश्रयैस्तु विपुलैः पद्मिनीखण्डमण्डितम् ।\nसितोत्पलैश्च संछन्नं नीलपीतैः सितारुणैः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004308023, "chapter_id": 24308, "verse_number": "५-३-२-२४", "content_sanskrit": "हंसकारण्डवाकीर्णं चक्रवाकोपशोभितम् ।\nआडीकाकबलाकाभिः सेवितं कोकिलादिभिः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004308024, "chapter_id": 24308, "verse_number": "५-३-२-२५", "content_sanskrit": "सिंहैर्व्याघ्रैर्वराहैश्च गजैश्चैव महोत्कटैः ।\nमहिषैश्च महाकायैः कुरङ्गैश्चित्रकैः शशैः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004308025, "chapter_id": 24308, "verse_number": "५-३-२-२६", "content_sanskrit": "गण्डकैश्चैव खड्गैश्च गोमायुसुरभी युतम् ।\nसारङ्गैर्मल्लकैश्चैव द्विपदैश्च चतुष्पदैः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004308026, "chapter_id": 24308, "verse_number": "५-३-२-२७", "content_sanskrit": "तथाच कोकिलाकीर्णं मनःकान्तं सुशोभितम् ।\nजीवंजीवकसंघैश्च नानापक्षिसमायुतम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004308027, "chapter_id": 24308, "verse_number": "५-३-२-२८", "content_sanskrit": "दुःखशोकविनिर्मुक्तं सत्त्वोत्कटमनोरमम् ।\nक्षुत्तृषारहितं कान्तं सर्वव्याधिविवर्जितम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004308028, "chapter_id": 24308, "verse_number": "५-३-२-२९", "content_sanskrit": "सिंहीस्तनं पिबन्त्यत्र कुरंगाः स्नेहसंयुतम् ।\nमार्जारमूषकौ चोभाववलेहत उन्मुखौ॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004308029, "chapter_id": 24308, "verse_number": "५-३-२-३०", "content_sanskrit": "पञ्चास्याः पोतकेभाश्च भोगिनस्तु कलापिनः ।\nदृष्ट्वा तद्विपिनं रम्यं प्रविष्टाः पाण्डुनन्दनाः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004308030, "chapter_id": 24308, "verse_number": "५-३-२-३१", "content_sanskrit": "मार्कण्डं दृष्टवांस्तत्र तरुणादित्यसन्निभम् ।\nऋषिभिः सेव्यमानं तु नानाशास्त्रविशारदैः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004308031, "chapter_id": 24308, "verse_number": "५-३-२-३२", "content_sanskrit": "कुलीनैः सत्त्वसम्पन्नैः शौचाचारसमन्वितैः ।\nधीसंगतैः क्षमायुक्तैस्त्रिसंध्यं जपतत्परैः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004308032, "chapter_id": 24308, "verse_number": "५-३-२-३३", "content_sanskrit": "ऋग्यजुःसामविहितैर्मन्त्रैर्होमपरायणैः ।\nकेचित्पञ्चाग्निमध्यस्थाः केचिदेकान्तसंस्थिताः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004308033, "chapter_id": 24308, "verse_number": "५-३-२-३४", "content_sanskrit": "ऊर्ध्वबाहुनिरालम्बा आदित्यभ्रमणाः परे ।\nसायंप्रातर्भुजश्चान्ये एकाहारास्तथा परे॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004308034, "chapter_id": 24308, "verse_number": "५-३-२-३५", "content_sanskrit": "द्वादशाहात्तथा चान्ये अन्ये मासार्धभोजनाः ।\nदर्शे दर्शे तथा चान्ये अन्ये शैवालभोजनाः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004308035, "chapter_id": 24308, "verse_number": "५-३-२-३६", "content_sanskrit": "पिण्याकमपरेऽभुजन् केचित्पालाशभोजनाः ।\nअपरे नियताहारा वायुभक्ष्याम्बुभोजनाः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004308036, "chapter_id": 24308, "verse_number": "५-३-२-३७", "content_sanskrit": "एवंभूतैस्तथा वृद्धैः सेव्यते मुनिपुंगवैः ।\nततो धर्मसुतः श्रीमानाश्रमं तं प्रविश्य सः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004308037, "chapter_id": 24308, "verse_number": "५-३-२-३८", "content_sanskrit": "दृष्ट्वा मुनिवरं शान्तं ध्यायमानं परं पदम् ।\nप्रादक्षिण्येन सहसा दण्डवत्पतितोऽग्रतः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004308038, "chapter_id": 24308, "verse_number": "५-३-२-३९", "content_sanskrit": "भक्त्यानुपतितं दृष्ट्वा चिरादादाय लोचनम् ।\nको भवानित्युवाचेदं धर्मं धीमानपृच्छत॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004308039, "chapter_id": 24308, "verse_number": "५-३-२-४०", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा दारकस्तत्समीपगः ।\nआहायं धर्मराजस्ते दर्शनार्थं समागतः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004308040, "chapter_id": 24308, "verse_number": "५-३-२-४१", "content_sanskrit": "तच्छ्रुत्वादारकेणोक्तं वचनं प्राह सादरः ।\nएह्येहि वत्सवत्सेति किंचित्स्थानाच्चलन्मुनिः ।\nतं तु स्नेहादुपाघ्राय आसने उपवेशयत्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004308041, "chapter_id": 24308, "verse_number": "५-३-२-४२", "content_sanskrit": "उपविष्टे सभायां तु पूजां कृत्वा यथाविधि ।\nवन्यैर्धान्यैः फलैर्मूलै रसैश्चैव पृथग्विधैः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004308042, "chapter_id": 24308, "verse_number": "५-३-२-४३", "content_sanskrit": "पाण्डवा ब्राह्मणैः सार्द्धं यथायोग्यं प्रपूजिताः ।\nमुहूर्तादथ विश्रम्य धर्मपुत्रो युधिष्ठिरः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004308043, "chapter_id": 24308, "verse_number": "५-३-२-४४", "content_sanskrit": "पृच्छति स्म मुनिश्रेष्ठं कौतूहलसमन्वितः ।\nभगवन्सर्वलोकानां दीर्घायुस्त्वं मतो मम॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004308044, "chapter_id": 24308, "verse_number": "५-३-२-४५", "content_sanskrit": "सप्तकल्पानशेषेण कथयस्व ममानघ ।\nकल्पक्षयेऽपि लोकस्य स्थावरस्येतरस्य च॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004308045, "chapter_id": 24308, "verse_number": "५-३-२-४६", "content_sanskrit": "न विनष्टोऽसि विप्रेन्द्र कथं वा केन हेतुना ।\nगङ्गाद्याः सरितः सर्वाः समुद्रान्ताश्च या मुने॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004308046, "chapter_id": 24308, "verse_number": "५-३-२-४७", "content_sanskrit": "तासां मध्ये स्थिताः काः स्वित्काश्चैव प्रलयं गताः ।\nका नु पुण्यजला नित्यं कानु न क्षयमागता॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004308047, "chapter_id": 24308, "verse_number": "५-३-२-४८", "content_sanskrit": "एतत्कथय मे तात प्रसन्नेनान्तरात्मना ।\nश्रोतुमिच्छाम्यशेषेण ऋषिभिः सह बान्धवैः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004308048, "chapter_id": 24308, "verse_number": "५-३-२-४९", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nसाधुसाधु महाप्राज्ञ धर्मपुत्र युधिष्ठिर ।\nकथयामि यथा न्यायं यत्पृच्छसि ममानघ॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004308049, "chapter_id": 24308, "verse_number": "५-३-२-५०", "content_sanskrit": "सर्वपापहरं पुण्यं पुराणं रुद्रभाषितम् ।\nयः शृणोति नरो भक्त्या तस्य पुण्यफलं शृणु॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004308050, "chapter_id": 24308, "verse_number": "५-३-२-५१", "content_sanskrit": "अश्वमेध सहस्रेण वाजपेयशतेन च ।\nतत्फलं समवाप्नोति राजन्नास्त्यत्र संशयः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004308051, "chapter_id": 24308, "verse_number": "५-३-२-५२", "content_sanskrit": "ब्रह्मघ्नश्च सुरापी च स्तेयी गोघ्नश्च यो नरः ।\nमुच्यते सर्वपापेभ्यो रुद्रस्य वचनं यथा॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004308052, "chapter_id": 24308, "verse_number": "५-३-२-५३", "content_sanskrit": "गङ्गा तु सरितां श्रेष्ठा तथा चैव सरस्वती ।\nकावेरी देविका चैव सिन्धुः सालकुटी तथा॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004308053, "chapter_id": 24308, "verse_number": "५-३-२-५४", "content_sanskrit": "सरयूः शतरुद्रा च मही चर्मिलया सह ।\nगोदावरी तथा पुण्या तथैव यमुना नदी॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004308054, "chapter_id": 24308, "verse_number": "५-३-२-५५", "content_sanskrit": "पयोष्णी च शतद्रुश्च तथा धर्मनदी शुभा ।\nएताश्चान्याश्च सरितः सर्वपापहराः स्मृताः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004308055, "chapter_id": 24308, "verse_number": "५-३-२-५६", "content_sanskrit": "किं तु ते कारणं तात वक्ष्यामि नृपसत्तम ।\nसमुद्राः सरितः सर्वाः कल्पे कल्पे क्षयं गताः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004308056, "chapter_id": 24308, "verse_number": "५-३-२-५७", "content_sanskrit": "सप्तकल्पक्षये क्षीणे न मृता तेन नर्मदा ।\nनर्मदैकैव राजेन्द्र परं तिष्ठेत्सरिद्वरा॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004308057, "chapter_id": 24308, "verse_number": "५-३-२-५८", "content_sanskrit": "तोयपूर्णा महाभाग मुनिसंघैरभिष्टुता ।\nगंगाद्याः सरितश्चान्याः कल्पे कल्पे क्षयं गताः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004308058, "chapter_id": 24308, "verse_number": "५-३-२-५९", "content_sanskrit": "एषा देवी पुरा दृष्टा तेन वक्ष्यामि तेऽनघ॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]