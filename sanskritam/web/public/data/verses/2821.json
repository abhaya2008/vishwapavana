[{"id": 2085666, "chapter_id": 2821, "verse_number": "१२-३२६-०x", "content_sanskrit": "* युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2085667, "chapter_id": 2821, "verse_number": "१२-३२६-१", "content_sanskrit": "अव्यक्तव्यक्ततत्वानां निश्चयं भरतर्षभ।\nवक्तुमर्हसि कौरव्य देवस्याजस्य या कृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2085668, "chapter_id": 2821, "verse_number": "१२-३२६-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2085669, "chapter_id": 2821, "verse_number": "१२-३२६-२", "content_sanskrit": "अत्राप्युदाहरन्तीमं संवादं गुरुशिष्ययोः।\nकपिलस्यासुरेश्चैव सर्वदुःखविमोक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2085670, "chapter_id": 2821, "verse_number": "१२-३२६-३x", "content_sanskrit": "असुरिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2085671, "chapter_id": 2821, "verse_number": "१२-३२६-३", "content_sanskrit": "अव्यक्तव्यक्ततत्वानां निश्चयं बुद्धिनिश्चयम्।\nभगवन्नमितप्रज्ञ वक्तुमर्हसि मेऽर्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2085672, "chapter_id": 2821, "verse_number": "१२-३२६-४", "content_sanskrit": "किं व्यक्तं किमव्यक्तं किं व्यक्ता\nव्यक्तं किमिति तत्वानि।\nकिमाद्यं मध्यमं च तत्वानां\nकिमध्यात्माधिभूतदैवतं च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2085673, "chapter_id": 2821, "verse_number": "१२-३२६-५", "content_sanskrit": "किंनु सर्गाप्ययं कति सर्गाः किं भूतं\nकिं भविष्यं किं भव्यं च किं ज्ञानम्।\nको ज्ञाता किं बुद्धं किमप्रबुद्धं\nकिं बुध्यमानं कति पर्वाणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2085674, "chapter_id": 2821, "verse_number": "१२-३२६-६", "content_sanskrit": "कति स्रोतांसि कति कर्मयोनयः\nकिमेकत्वं नानात्वम्।\nकिं सहवासं निवासं\nकिं विद्याविद्यमिति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2085675, "chapter_id": 2821, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि षङ्विंशत्यधिकत्रिशततमोऽध्यायः॥ ३२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]