[{"id": 7003359000, "chapter_id": 23359, "verse_number": "२-५४-१", "content_sanskrit": "सूत उवाच  ।\nत्रियंबकेण मंत्रेण देवदेवं त्रियंबकम् ।\nपूजयेद्बाणलिंगे वा स्वयंभूतेऽपि वा पुनः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003359001, "chapter_id": 23359, "verse_number": "२-५४-२", "content_sanskrit": "आयुर्वेदविदैर्वापि यथावदनुपूर्वशः ।\nअष्टोत्तरसहस्रेण पुंडरीकेण शंकरम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003359002, "chapter_id": 23359, "verse_number": "२-५४-३", "content_sanskrit": "कमलेन सहस्रेण तथा नीलोत्पलेन वा ।\nसंपूज्य पायसं दत्त्वा सघृतं चौदनं पुनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003359003, "chapter_id": 23359, "verse_number": "२-५४-४", "content_sanskrit": "मुद्गान्नं मधुना युक्तं भक्ष्याणि सुरभीणि च ।\nअग्नौ होमश्च विपुलो यथावदनुपूर्वशः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003359004, "chapter_id": 23359, "verse_number": "२-५४-५", "content_sanskrit": "पूर्वोक्तैरपि पुष्पैश्च चरुणा च विशेषतः ।\nजपेद्वै नियुतं सम्यक् समाप्य च यथाक्रमम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003359005, "chapter_id": 23359, "verse_number": "२-५४-६", "content_sanskrit": "ब्राह्मणानां सहस्रं च भोजयेद्वै सदक्षिणम् ।\nगवां सहस्रं दत्त्वा तु हिरण्यमपि दापयेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003359006, "chapter_id": 23359, "verse_number": "२-५४-७", "content_sanskrit": "एतद्वः कथितं सर्वं सरहस्यं समासतः ।\nशिवेन देवदेवेन शर्वेणात्युग्रशूलिना ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003359007, "chapter_id": 23359, "verse_number": "२-५४-८", "content_sanskrit": "कथितं मेरुशिखरे स्कंदायामिततेजसे ।\nस्कंदेन देवदेवेन ब्रह्मपुत्राय धीमते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003359008, "chapter_id": 23359, "verse_number": "२-५४-९", "content_sanskrit": "साक्षात्सनत्कुमारेण सर्वलोकहितैषिणा ।\nपाराशर्याय कथितं पारंपर्यक्रमागतम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003359009, "chapter_id": 23359, "verse_number": "२-५४-१०", "content_sanskrit": "शुके गते परंधाम दृष्ट्वा रुद्रं त्रियंबकम् ।\nगतशोको महाभागो व्यसः पर ऋषिः प्रभुः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003359010, "chapter_id": 23359, "verse_number": "२-५४-११", "content_sanskrit": "स्कंदस्य संभवं श्रुत्वा स्थिताय च महात्मने ।\nत्रियंबकस्य माहात्म्यं मंत्रस्य च विशेषतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003359011, "chapter_id": 23359, "verse_number": "२-५४-१२", "content_sanskrit": "कथितं बहुधा तस्मै कृष्णद्वैपायानाय वै ।\nतत्सक्वं कथयिष्यामि प्रसादादेव तस्य वै ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003359012, "chapter_id": 23359, "verse_number": "२-५४-१३", "content_sanskrit": "देवं संपूज्य विधिना जपेन्मंत्रं त्रियंबकम् ।\nमुच्यते सर्पपापैश्च सप्तजन्मकृतैरपि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003359013, "chapter_id": 23359, "verse_number": "२-५४-१४", "content_sanskrit": "संग्रामे तत्सर्वं लब्ध्वा सौभाग्यमतुलं भवेत् ।\nलक्षहोमेन राज्यार्थी राज्यं लब्ध्वा सुखी भवेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003359014, "chapter_id": 23359, "verse_number": "२-५४-१५", "content_sanskrit": "पुत्रार्थी पुत्रमाप्नोति नियुतेन न संशयः ।\nधनार्थी प्रयुतेनैव जपेदेव न संशयः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003359015, "chapter_id": 23359, "verse_number": "२-५४-१६", "content_sanskrit": "धनधान्यादिभिः सर्वैः संपूर्णः सर्वमंगलैः ।\nक्रीडते पुत्रपौत्रैश्च मृतः स्वर्गे प्रजायते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003359016, "chapter_id": 23359, "verse_number": "२-५४-१७", "content_sanskrit": "नानेन सदृशो मंत्रो लोके वेदे च सुव्रताः ।\nतस्मात्त्रियंबकं देवं तेन नित्यं प्रपूजयेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003359017, "chapter_id": 23359, "verse_number": "२-५४-१८", "content_sanskrit": "अग्निष्टोमस्य यज्ञस्य फलमष्टगुणं भवेत् ।\nत्रयाणामपि लोकानां गुणानामपि यः प्रभुः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003359018, "chapter_id": 23359, "verse_number": "२-५४-१९", "content_sanskrit": "वेदानामपि देवानां ब्रह्मक्षत्रविशामपि ।\nअकारोकारमकाराणां मात्राणामपि वाचकः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003359019, "chapter_id": 23359, "verse_number": "२-५४-२०", "content_sanskrit": "तथा सोमस्य सूर्यस्य वह्नेरग्नित्रयस्य च ।\nअंबा उमा महादेवो ह्यंबकस्तु त्रियंबकः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003359020, "chapter_id": 23359, "verse_number": "२-५४-२१", "content_sanskrit": "सुपुष्पितस्य वृक्षस्य यथा गंधः सुशोभनः ।\nवाति द्वरात्तथा तस्य गंधः शंभोर्महात्मनः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003359021, "chapter_id": 23359, "verse_number": "२-५४-२२", "content_sanskrit": "तस्मात्सुगंधो भगवान्गंधारयति शंकरः ।\nगांधारश्च७महादेवो देवानामपि लीलया ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003359022, "chapter_id": 23359, "verse_number": "२-५४-२३", "content_sanskrit": "सुगंधस्तस्य लोकेस्मिन्वायुर्वाति नभस्तले ।\nतस्मात्सुगंधिस्तं देवं सुगंधि पुष्टिवर्धनम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003359023, "chapter_id": 23359, "verse_number": "२-५४-२४", "content_sanskrit": "यस्य रेतः पुरा शंभोर्हरेर्योनौ प्रतिष्ठितम् ।\nतस्य वीर्यादभूदंडं हिरण्यमजोद्भवम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003359024, "chapter_id": 23359, "verse_number": "२-५४-२५", "content_sanskrit": "चंद्रादित्यौ सनक्षत्रौ भूर्भुवः स्वर्महस्तपः ।\nसत्यलोकमतिक्रम्य पुष्टिर्वीर्यस्य तस्य वै ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003359025, "chapter_id": 23359, "verse_number": "२-५४-२६", "content_sanskrit": "पंचभूतान्यहंकारो बुद्धिः प्रकृतिरेव च ।\nपुष्टिर्बीजस्य तस्यैव तस्माद्वै पुष्टिवर्धनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003359026, "chapter_id": 23359, "verse_number": "२-५४-२७", "content_sanskrit": "तं पुष्टिवर्धनं देवं घृतेन पयसा तथा ।\nमधुना यवगोधूममाषबिल्वफलेन च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003359027, "chapter_id": 23359, "verse_number": "२-५४-२८", "content_sanskrit": "कुमुदार्कशमीपत्रगौरसर्षपशालिभिः ।\nहुत्वा लिंगे यथान्यायं भक्त्या देवं यजामहे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003359028, "chapter_id": 23359, "verse_number": "२-५४-२९", "content_sanskrit": "ऋतेनानेन मां पाशाद्बंधनात्कर्मयोगतः ।\nमृत्योश्च बंदनाच्चैव मुक्षीय भव तेजसा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003359029, "chapter_id": 23359, "verse_number": "२-५४-३०", "content_sanskrit": "उर्वारुकाणां पक्वानां यथा कालादभूत्पुनः ।\nतथैव कालः संप्राप्तो मनुना तेन यत्नतः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003359030, "chapter_id": 23359, "verse_number": "२-५४-३१", "content_sanskrit": "एवं मंत्रविधिं ज्ञात्वा शिवलिंगं समर्चयेत् ।\nतस्य पाशक्षयोऽतीव योगिनो मृत्युनिग्रहः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003359031, "chapter_id": 23359, "verse_number": "२-५४-३२", "content_sanskrit": "त्रियंबकसमो नास्ति देवो वा घृणयान्वितः ।\nप्रसादशीलः प्रीतश्च तथा मंत्रोपि सुव्रताः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003359032, "chapter_id": 23359, "verse_number": "२-५४-३३", "content_sanskrit": "तस्मात्सर्वं परित्यज्य त्रियंबकमुमापतिम् ।\nत्रियंबकेण मंत्रेण पूजयेत्सुसमाहितः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003359033, "chapter_id": 23359, "verse_number": "२-५४-३४", "content_sanskrit": "सर्वावस्थां गतो वापि मुक्तोऽयं सर्वपातकैः ।\nशिवध्यानान्न संदेहो यथा रुद्रस्तथा स्वयम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003359034, "chapter_id": 23359, "verse_number": "२-५४-३५", "content_sanskrit": "हत्वा भित्त्वा च भूतानि भुक्त्वा चान्यायतोऽपि वा ।\nशिवमेकं सकृत्स्मृत्वा सर्वपापैः प्रमुच्यते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]