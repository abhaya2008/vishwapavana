[{"id": 2047778, "chapter_id": 2057, "verse_number": "६-१०६-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2047779, "chapter_id": 2057, "verse_number": "६-१०६-१", "content_sanskrit": "ततः पिता तव क्रुद्धो निशितैः सायकोत्तमैः।\nआजघान रणे पार्थान्सहसेनान्समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2047780, "chapter_id": 2057, "verse_number": "६-१०६-२", "content_sanskrit": "भीमं द्वादशभिर्विद्ध्वा सात्यकिं नवभिः शरैः ।\nनकुलं च त्रिभिर्विद्ध्वा सहदेवं च सप्तभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2047781, "chapter_id": 2057, "verse_number": "६-१०६-३", "content_sanskrit": "युधिष्ठिरं द्वादशभिर्बाह्वोरुरसि चार्पयत्।\nधृष्टद्युम्नं ततो विद्ध्वा ननाद सुमहाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2047782, "chapter_id": 2057, "verse_number": "६-१०६-४", "content_sanskrit": "तं द्वादशाख्यैर्नकुलो माधवश्च त्रिभिः शरैः ।\nधृष्टद्युम्नश्च सप्तत्या भीमसेनश्च सप्तभिः ।\nयुधिष्ठिरो द्वादशभिः प्रत्यविध्यत्पितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2047783, "chapter_id": 2057, "verse_number": "६-१०६-५", "content_sanskrit": "द्रोणस्तु सात्यकिं विद्ध्वा भीमसेनमविध्यत ।\nएकैकं पञ्चभिर्बाणैर्यमदण्डोपमैः शितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2047784, "chapter_id": 2057, "verse_number": "६-१०६-६", "content_sanskrit": "तौ च तं प्रत्यविध्येतां त्रिभिस्त्रिभिरजिह्मगैः ।\nतोत्रैरिव महानागं द्रोणं ब्राह्मणपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2047785, "chapter_id": 2057, "verse_number": "६-१०६-७", "content_sanskrit": "सौवीरा कितवाः प्राच्याः प्रतीच्योदीच्यमालवाः ।\nअभीषाहाः शूरसेनाः शिबयोऽथ वसातयः।\nसंग्रमे नाजहुर्भीष्मं वध्यमानाः शितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2047786, "chapter_id": 2057, "verse_number": "६-१०६-८", "content_sanskrit": "तथैवान्ये महीपाला नानादेशसमागताः ।\nपाण्डवानभ्यवर्तन्त विविधायुधपाणयः ।\nतथैव पाण्डवा राजन्परिवव्रुः पितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2047787, "chapter_id": 2057, "verse_number": "६-१०६-९", "content_sanskrit": "स समन्तात्परिवृतो रथौघैरपराजितः ।\nगहनेऽग्निरिवोत्सृष्टः प्रजज्वाल दहन्परान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2047788, "chapter_id": 2057, "verse_number": "६-१०६-१०", "content_sanskrit": "रथाग्न्यगारश्चापार्चिरसिशक्तिगजेन्धनः ।\nशरस्फुलिङ्गो भीष्माग्निर्ददाह क्षत्रियर्षभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2047789, "chapter_id": 2057, "verse_number": "६-१०६-११", "content_sanskrit": "` यथा हि सुमहानग्निः कक्षे चरसि सानिलः ।\nतथा भीष्मो महाराज दिव्यमस्त्रमुदीरयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2047790, "chapter_id": 2057, "verse_number": "६-१०६-१२", "content_sanskrit": "सुवर्णपुङ्खैरिषुभिर्गार्ध्रपक्षैः सुतेजनैः ।\nकर्णिनालीकनाराचैश्छादयामास तद्बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2047791, "chapter_id": 2057, "verse_number": "६-१०६-१३", "content_sanskrit": "अपातयद्ध्वजांश्चैव रथिनश्च शितैः शरैः ।\nमुण्डतालवनानीव चकार स रथव्रजान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2047792, "chapter_id": 2057, "verse_number": "६-१०६-१४", "content_sanskrit": "निर्मनुष्यान्रथान्राजन्गजानश्वांश्च संयुगे।\nअकरोत्स महाबाहुः सर्वशस्त्रभृतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2047793, "chapter_id": 2057, "verse_number": "६-१०६-१५", "content_sanskrit": "तस्य ज्यातलनिर्घोषं विस्फूर्जितमिवाशनेः।\nनिशम्य सर्वभूतानि समकम्पन्त भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2047794, "chapter_id": 2057, "verse_number": "६-१०६-१६", "content_sanskrit": "अमोघा ह्यपत्नबाणाः पितुस्ते भरतर्षभ।\nनासज्जन्त तनुत्रेषु भीष्मचापच्युताः शराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2047795, "chapter_id": 2057, "verse_number": "६-१०६-१७", "content_sanskrit": "हतवीरान्रथान्राजन्संयुक्ताञ्जवनैर्हयैः ।\nअपश्याम महाराज ह्रियमाणान्रणाजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2047796, "chapter_id": 2057, "verse_number": "६-१०६-१८", "content_sanskrit": "चेदिकाशिकरूषाणां सहस्राणि चतुर्दश ।\nमहारथाः समाख्याताः कलपुत्रास्तनुत्यजः ।\nअपरावर्तिनः सर्वे सुवर्णविकृतध्वजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2047797, "chapter_id": 2057, "verse_number": "६-१०६-१९", "content_sanskrit": "संग्रामे भीष्ममासाद्य व्यादितास्यमिवान्तकम्।\nनिमग्नाः परलोकाय सवाजिरथकुञ्जराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2047798, "chapter_id": 2057, "verse_number": "६-१०६-२०", "content_sanskrit": "भग्नाक्षोपस्करान्कांश्चिद्भग्नचक्रांश्च भारत।\nअपश्याम महाराज शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2047799, "chapter_id": 2057, "verse_number": "६-१०६-२१", "content_sanskrit": "सवरूथै रथैर्भग्नै रथिभिश्च निपातितैः ।\nशरैः सुकवचैश्छिन्नैः पट्टसैश्च विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2047800, "chapter_id": 2057, "verse_number": "६-१०६-२२", "content_sanskrit": "गदाभिर्भिण्डिपालैश्च निशितैश्च शिलीमुखैः ।\nअनुकर्षैरुपासङ्गैश्चक्रैर्भग्नैश्च मारिष ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2047801, "chapter_id": 2057, "verse_number": "६-१०६-२३", "content_sanskrit": "बाहुभिः कार्मुकैः खङ्गैः शिरोभिश्च सकुण्डलैः।\nतलत्रैरङ्गुलित्रैश्च ध्वजैश्च विनिपातितैः।\nचापैश्च बहुधा च्छिन्नैः समास्तीर्यत मेदिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2047802, "chapter_id": 2057, "verse_number": "६-१०६-२४", "content_sanskrit": "गजारोहा गजान्राजन्हयांश्च हयसादिनः ।\nअभिपेतुर्द्रुतं तत्र शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2047803, "chapter_id": 2057, "verse_number": "६-१०६-२५", "content_sanskrit": "यतमानाश्च ते वीरा द्रवमाणान्महारथान्।\nनाशक्नुवन्वारयितुं भीष्मबाणप्रपीडितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2047804, "chapter_id": 2057, "verse_number": "६-१०६-२६", "content_sanskrit": "महेन्द्रसमवीर्येण वध्यमाना महाचमूः ।\nअभज्यत महाराज न च द्वौ समधावताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2047805, "chapter_id": 2057, "verse_number": "६-१०६-२७", "content_sanskrit": "आविद्धरथनागाश्वं पतितध्वजसंकुलम् ।\nअनीकं पाण्डुपुत्राणां हाहाभूतमचेतनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2047806, "chapter_id": 2057, "verse_number": "६-१०६-२८", "content_sanskrit": "जघानात्र पिता पुत्रं पुत्रश्च पितरं तथ।\nप्रियं सखाय चाक्रन्दे सखा दैवबलात्कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2047807, "chapter_id": 2057, "verse_number": "६-१०६-२९", "content_sanskrit": "विमुच्य कवचानन्ये पाण्डुपुत्रस्य सैनिकाः ।\nप्रकीर्य केशान्धावन्तः प्रत्यदृश्यन्त सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2047808, "chapter_id": 2057, "verse_number": "६-१०६-३०", "content_sanskrit": "तद्गोकुलमिवोद्भ्रान्तमुद्भान्तरथकूबरम् ।\nददृशे पाण्डुपुत्रस्य सैन्यमार्तस्वरं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2047809, "chapter_id": 2057, "verse_number": "६-१०६-३१", "content_sanskrit": "प्रभज्यमानं सैन्यं तु दृष्ट्वा यादवनन्दनः ।\nउवाच पार्थं बीभत्सुं निगृह्य रथमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2047810, "chapter_id": 2057, "verse_number": "६-१०६-३२x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2047811, "chapter_id": 2057, "verse_number": "६-१०६-३२", "content_sanskrit": "अयं स कालः संप्राप्तः पार्थ यः काङ्क्षितस्तव।\nप्रहरास्मै नरव्याघ्र भीष्मायाहवशोभिने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2047812, "chapter_id": 2057, "verse_number": "६-१०६-३३", "content_sanskrit": "यत्पुरा कथितं वीर त्वया राज्ञां समागमे।\nविराटनगरे तात सञ्जयस्य समीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2047813, "chapter_id": 2057, "verse_number": "६-१०६-३४", "content_sanskrit": "भीष्मद्रोणमुखान्सर्वान्धार्तराष्ट्रस्य सैनिकान् ।\nसानुबन्धान्हनिष्यामि ये मां योत्स्यन्ति सङ्गरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2047814, "chapter_id": 2057, "verse_number": "६-१०६-३५", "content_sanskrit": "इति तत्कुरु कौन्तेय सत्यं वाक्यमरिन्दम।\nक्षत्रधर्ममनुस्मृत्य युध्यस्व विगतज्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2047815, "chapter_id": 2057, "verse_number": "६-१०६-३६x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2047816, "chapter_id": 2057, "verse_number": "६-१०६-३६", "content_sanskrit": "इत्युक्तो वासुदेवेन तिर्यग्दृष्टिरधोमुखः।\nअकाम इव बीभत्सुरिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2047817, "chapter_id": 2057, "verse_number": "६-१०६-३७", "content_sanskrit": "अवध्यानां वधं कृत्वा राज्यं वा नरकोत्तरम् ।\nदुःखानि वनवासे वा किं नु मे सुकृतं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2047818, "chapter_id": 2057, "verse_number": "६-१०६-३८", "content_sanskrit": "चोदयाश्वान्यतो भीष्मः करिष्ये वचनं तव।\nपातयिष्यामि दुर्धर्षं भीष्मं कुरुपितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2047819, "chapter_id": 2057, "verse_number": "६-१०६-३९x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2047820, "chapter_id": 2057, "verse_number": "६-१०६-३९", "content_sanskrit": "स चाश्वान्रजतप्रख्यांश्चोदयामास माधवः।\nयतो भीष्मस्ततो राजन्दुष्प्रेक्ष्यो रश्मिवानिव ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2047821, "chapter_id": 2057, "verse_number": "६-१०६-४०", "content_sanskrit": "ततस्तत्पुनरावृत्तं युधिष्ठिरबलं महत्।\nदृष्ट्वा पार्थं महाबाहुं भीष्मायोद्यतमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2047822, "chapter_id": 2057, "verse_number": "६-१०६-४१", "content_sanskrit": "ततो भीष्मः कुरुश्रेष्ठः सिंहवद्विनदन्मुहुः ।\nधनंजयरथं शीघ्रं शरवर्षैरवाकिरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2047823, "chapter_id": 2057, "verse_number": "६-१०६-४२", "content_sanskrit": "क्षणेन स रथस्तस्य सहयः सहसारथिः ।\nशरवर्षेण महता न प्राज्ञायत भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2047824, "chapter_id": 2057, "verse_number": "६-१०६-४३", "content_sanskrit": "वासुदेवस्त्वसंभ्रान्तो धैर्यमास्थाय सत्वरः ।\nचोदयामास तानश्वान्विनुन्नान्भीष्मसायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2047825, "chapter_id": 2057, "verse_number": "६-१०६-४४", "content_sanskrit": "ततः पार्थो धनुर्गृह्य दिव्यं जलदनिःस्वनम् ।\nपातयामास भीष्मस्य धनुश्छित्त्वा शितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2047826, "chapter_id": 2057, "verse_number": "६-१०६-४५", "content_sanskrit": "स च्छिन्नधन्वा कौरव्यः पुनरन्यन्महद्धनुः ।\nनिमेषान्तरमात्रेण सज्यं चक्रे पिता तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2047827, "chapter_id": 2057, "verse_number": "६-१०६-४६", "content_sanskrit": "चकर्ष च ततो दोर्भ्यां धनुर्जलदनिःस्वनम् ।\nअथास्य तदपि क्रुद्धश्चिच्छेद धनुरर्जुनः ।\nतस्य तत्पूजयामास लाघवं शन्तनोः सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2047828, "chapter_id": 2057, "verse_number": "६-१०६-४७", "content_sanskrit": "गाङ्गेयस्त्वब्रवीत्पार्थं धन्विश्रेष्ठमरिंदम।\nसाधुसाधु महाबाहो साधु कुन्तीसुतेति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2047829, "chapter_id": 2057, "verse_number": "६-१०६-४८", "content_sanskrit": "समाभाष्यैवमपरं प्रगृह्य रुचिरं धनुः।\nमुमोच समरे भीष्मः शरान्पार्थरथं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2047830, "chapter_id": 2057, "verse_number": "६-१०६-४९", "content_sanskrit": "अदर्शयद्वसुदेवो हययाने परं बलम्।\nमोघान्कुर्वञ्शरांस्तस्य मण्डलानि निदर्शयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2047831, "chapter_id": 2057, "verse_number": "६-१०६-५०", "content_sanskrit": "शुशुभाते नरव्याघ्रौ तौ भीष्मशरविक्षतौ ।\nगोवृषाविव संरब्धौ विषाणोल्लिखिताङ्कितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2047832, "chapter_id": 2057, "verse_number": "६-१०६-५१", "content_sanskrit": "वासुदेवस्तु संप्रेक्ष्य पार्थस्य मृदुयुद्धताम् ।\nभीष्मं च शरवर्षाणि सृजन्तमनिशं युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2047833, "chapter_id": 2057, "verse_number": "६-१०६-५२", "content_sanskrit": "प्रतपन्तमिवादित्यं मध्यमासाद्य सेनयोः ।\nवरान्वरान्विनिघ्नन्तं पाण्डुपुत्रस्य सैनिकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2047834, "chapter_id": 2057, "verse_number": "६-१०६-५३", "content_sanskrit": "युगान्तमिव कुर्वाणं भीष्मं यौधिष्ठिरे बले ।\nनामृष्यत महाबाहुर्माधवः परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2047835, "chapter_id": 2057, "verse_number": "६-१०६-५४", "content_sanskrit": "उत्सृज्य रजतप्रख्यान्हयान्पार्थस्य मारिष ।\nवासुदेवस्ततो योगी प्रचस्कन्द महारथात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2047836, "chapter_id": 2057, "verse_number": "६-१०६-५५", "content_sanskrit": "अभिदुद्राव भीष्मं स भुजप्रहरणो बली।\nप्रतोदपाणिस्तेजस्वी सिंहवद्विनदन्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2047837, "chapter_id": 2057, "verse_number": "६-१०६-५६", "content_sanskrit": "दारयन्निव पद्भ्यां स जगतीं जगदीश्वरः ।\nक्रोधताम्रेक्षणः कृष्णो जिघांसुरमितद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2047838, "chapter_id": 2057, "verse_number": "६-१०६-५७", "content_sanskrit": "ग्रसन्निव च तेजांसि तावकानां महाहवे ।\nदृष्ट्वा माधवमाक्रन्दे भीष्मायोद्यतमन्तिके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2047839, "chapter_id": 2057, "verse_number": "६-१०६-५८", "content_sanskrit": "हतो भीष्मो हतो भीष्म इति तत्रस्म सैनिकाः ।\nक्रोशन्तः प्राद्रवन्सर्वे वासुदेवभयातुराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2047840, "chapter_id": 2057, "verse_number": "६-१०६-५९", "content_sanskrit": "पीतकौशेयसंवीतो मणिश्यामो जनार्दनः ।\nशुशुभे विद्रवन्भीष्मं विद्युन्माली यथाम्बुदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2047841, "chapter_id": 2057, "verse_number": "६-१०६-६०", "content_sanskrit": "स सिंह इव मातङ्गं यथर्षभ इवर्षभम् ।\nअभिदुद्राव वेगेन विनदन्यादवर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2047842, "chapter_id": 2057, "verse_number": "६-१०६-६१", "content_sanskrit": "तमापतन्तं संप्रेक्ष्य पुण्डरीकाक्षमाहवे।\nअसंभ्रमं रणे भीष्मो विचकर्ष महद्धनुः ।\nउवाच चैव गोविन्दमसंभ्रान्तेन चेतसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2047843, "chapter_id": 2057, "verse_number": "६-१०६-६२", "content_sanskrit": "एह्येहि पुण्डरीकाक्ष देवदेव नमोस्तु ते ।\nमामद्य सात्वतश्रेष्ठ तापयस्त महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2047844, "chapter_id": 2057, "verse_number": "६-१०६-६३", "content_sanskrit": "त्वया हि देव संग्रामे हतस्यापि ममानघ ।\nश्रेय एव परं कृष्ण लोके भवति सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2047845, "chapter_id": 2057, "verse_number": "६-१०६-६४", "content_sanskrit": "संभावितोऽस्मि गोविन्द त्रैलोक्येनाद्य संयुगे।\nप्रहरस्व यथेष्टं वै दासोऽस्मि तव चानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2047846, "chapter_id": 2057, "verse_number": "६-१०६-६५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2047847, "chapter_id": 2057, "verse_number": "६-१०६-६५", "content_sanskrit": "अन्वगेव ततः पार्थः समभिद्रुत्य केशवम् ।\nनिजग्राह महाबाहुर्बाहुभ्यां परिगृह्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2047848, "chapter_id": 2057, "verse_number": "६-१०६-६६", "content_sanskrit": "निगृह्यमाणः पार्थेन कृष्णो राजीवलोचनः ।\nजगामैवैनमादाय वेगेन पुरुषोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2047849, "chapter_id": 2057, "verse_number": "६-१०६-६७", "content_sanskrit": "पार्थस्तु विष्टभ्य बलाच्चरणौ परवीरहा ।\nनिजग्राह हृषीकेशं कथंचिद्दशमे पदे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2047850, "chapter_id": 2057, "verse_number": "६-१०६-६८", "content_sanskrit": "तत एवमुवाचार्तः क्रोधपर्याकुलेक्षणम् ।\nनिःश्वसन्तं यथा नागमर्जुनः प्रणयात्सखा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2047851, "chapter_id": 2057, "verse_number": "६-१०६-६९", "content_sanskrit": "निवर्तस्व महाबाहो नानृतं कर्तुमर्हसि ।\nयत्त्वया कथितं पूर्वं न योत्स्यामीति केशव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2047852, "chapter_id": 2057, "verse_number": "६-१०६-७०", "content_sanskrit": "मिथ्यावादीति लोकास्त्वां कथयिष्यन्ति माधव ।\nममैष भारः सर्वो हि हनिष्यामि पितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2047853, "chapter_id": 2057, "verse_number": "६-१०६-७१", "content_sanskrit": "शपे केशव शस्त्रेण सत्येन सुकृतेन च।\nअन्तं यथा गमिष्यामि शत्रूणां शत्रुसूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2047854, "chapter_id": 2057, "verse_number": "६-१०६-७२", "content_sanskrit": "अद्यैव पश्य दुर्धर्षं पात्यमानं महारथम् ।\nतारापतिमिवापूर्णमन्तकाले यदृच्छया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2047855, "chapter_id": 2057, "verse_number": "६-१०६-७३", "content_sanskrit": "माधवस्तु वचः श्रुत्वा फल्गुनस्य महात्मनः।\n`अभवत्परमप्रीतो दृष्ट्वा पार्थस्य विक्रमम्।\nन किंचिदुक्त्वा सक्रोध आरुरोह रथं पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2047856, "chapter_id": 2057, "verse_number": "६-१०६-७४", "content_sanskrit": "तौ रथस्थौ नरव्याघ्रौ भीष्मः शान्तनवः पुनः।\nववर्ष शरवर्षेण मेघो वृष्ट्या यथाऽचलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2047857, "chapter_id": 2057, "verse_number": "६-१०६-७५", "content_sanskrit": "प्राणानादत्त योधानां पिता देवव्रतस्तव।\nगभस्तिभिरिवादित्यस्तेजांसि शिशिरात्यये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2047858, "chapter_id": 2057, "verse_number": "६-१०६-७६", "content_sanskrit": "यथा कुरूणां सैन्यानि बभञ्जुर्युधि पाण्डवाः ।\nतथा पाण्डवसैन्यानि बभञ्ज युधि ते पिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2047859, "chapter_id": 2057, "verse_number": "६-१०६-७७", "content_sanskrit": "हतविद्रुतसैन्यास्तु निरुत्साहा विचेतसः ।\nनिरीक्षितुं न शेकुस्ते भीष्ममप्रतिमं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2047860, "chapter_id": 2057, "verse_number": "६-१०६-७८", "content_sanskrit": "मध्यं गतमिवादित्यं प्रतपन्तं स्वतेजसा ।\nते वध्यमाना भीष्मेण शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2047861, "chapter_id": 2057, "verse_number": "६-१०६-७९", "content_sanskrit": "कुर्वाणं समरे कर्माण्यतिमानुषविक्रमम्।\nवीक्षांचक्रुर्महाराज पाण्डवा भयपीडिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2047862, "chapter_id": 2057, "verse_number": "६-१०६-८०", "content_sanskrit": "तथा पाण्डवसैन्यानि द्राव्यमाणानि भारत।\nत्रातारं नाध्यगच्छन्त गावः पङ्कगता इव।\nपिपीलिका इव क्षुण्णा दुर्बला बलिना रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2047863, "chapter_id": 2057, "verse_number": "६-१०६-८१", "content_sanskrit": "तथैव योधा राजेन्द्र भीष्मेणामित्रघातिना।\nसमरे मृदिताः सर्वे पाण्डवाः सह सृञ्जयैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2047864, "chapter_id": 2057, "verse_number": "६-१०६-८२", "content_sanskrit": "महारथं भारत दुष्प्रकम्पं\nशरौघिणं प्रतपन्तं नरेन्द्रान्।\nभीष्मं न शेकुः प्रतिवीक्षितुं ते\nशरार्चिषं सूर्यमिवातपन्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2047865, "chapter_id": 2057, "verse_number": "६-१०६-८३", "content_sanskrit": "विमृद्गतस्तस्य तु पाण्डुसेना-\nमस्तं जगामाथ सहस्ररश्मिः।\nततो हि भीष्मः सबलान्ससैन्या-\nन्न्यवारयत्पाण्डुसुताञ्शरौघैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2047866, "chapter_id": 2057, "verse_number": "६-१०६-८४", "content_sanskrit": "जघान चैतान्सुभृशं महाबलो\nमहाव्रतः पाण्डुसुतान्महास्त्रैः ।\nरणे करूणाधिपचेदिपैर्बलै-\nर्वृतान्सदा चक्रधरस्य पश्यतः।\nततो बलानां श्रमकर्शितानां", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2047867, "chapter_id": 2057, "verse_number": "", "content_sanskrit": "६-१०६-८४f\"\nमनोऽवहारं प्रति संबभूव ॥ ॥\nइति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि नवमदिवसयुद्धे षडधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}]