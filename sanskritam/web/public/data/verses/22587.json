[{"id": 7002587000, "chapter_id": 22587, "verse_number": "३-१२-१", "content_sanskrit": "सूत उवाच ।\nततो भेर्यादिघोषेण यजमान उदङ्मुखः ।\nकनकतोयेन गन्धेन मुद्गलाग्रेण लेपयेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002587001, "chapter_id": 22587, "verse_number": "३-१२-२", "content_sanskrit": "ऐशान्यां मध्यभागे वा यजेद्वा सुसमाहितः ।\nवर्तुलाकारयेद्यस्मान्मन इच्छति संजपन् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002587002, "chapter_id": 22587, "verse_number": "३-१२-३", "content_sanskrit": "ऋषिः कंठोथ गायत्री छन्द इत्यभिधीयते ।\nदेवता पृथिवी चैव स्तुतौ च विनियोजयेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002587003, "chapter_id": 22587, "verse_number": "३-१२-४", "content_sanskrit": "विवरे पूजयेत्कर्म ब्रह्माणं च धराधरम् ।\nपृथिवीं गन्धपुष्पाद्यैर्नैवेद्यैर्विविधैरपि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002587004, "chapter_id": 22587, "verse_number": "३-१२-५", "content_sanskrit": "अग्रतोऽष्टदलं लेख्यं स्थापयेत्कलशं ततः ।\nमुखे विधाय कनकं राजतेन विनिर्मितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002587005, "chapter_id": 22587, "verse_number": "३-१२-६", "content_sanskrit": "शुक्तिशंखसमं वापि विश्वामित्रसमुद्भवम् ।\nपूजयेत्तीर्थतोयेन गन्धपुष्पाक्षतादिना ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002587006, "chapter_id": 22587, "verse_number": "३-१२-७", "content_sanskrit": "विष्णुक्रांता वचाकुष्ठचन्दनेन विलोडितम् ।\nक्षीरं च मातुलिंगं च सावित्रं च सदूर्वया ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002587007, "chapter_id": 22587, "verse_number": "३-१२-८", "content_sanskrit": "दध्यक्षतं मधुयुतमेवमर्घ्यं च साधयेत् ।\nसितचन्दनवस्त्राद्यैः शाल्यैश्च विविधैरपि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002587008, "chapter_id": 22587, "verse_number": "३-१२-९", "content_sanskrit": "अव्रणं कलशं कृत्वा पञ्चवर्णसमन्वितम् ।\nआवाहयेत्तोयनिधिं मंत्रेणानेन भक्तितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002587009, "chapter_id": 22587, "verse_number": "३-१२-१०", "content_sanskrit": "आयाहि भगवन्देव तोयमूर्ते जलेश्वर ।\nहृद्वर्णार्घ्यं मया दत्तं परितोषाय ते नमः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002587010, "chapter_id": 22587, "verse_number": "३-१२-११", "content_sanskrit": "गृहेभ्यश्चैव सोमाय त्वष्ट्रे चैव च शूलिने ।\nइमं मे वरुणेत्यादि प्रत्येकं स्याद्गतित्रयम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002587011, "chapter_id": 22587, "verse_number": "३-१२-१२", "content_sanskrit": "ततोर्घ्यदानं विधिवत्क्षीरेण हविषा मधु ।\nयजमानः सपत्नीकः कुंभं कुक्षौ निधाय च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002587012, "chapter_id": 22587, "verse_number": "३-१२-१३", "content_sanskrit": "हिरण्यगर्भेति मंत्रस्य भरद्वाजऋषिः स्मृतः ।\nछन्दश्च जगती ख्यातं देवता च जलाधिपः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002587013, "chapter_id": 22587, "verse_number": "३-१२-१४", "content_sanskrit": "वरुणस्योत्तंभनेति मंत्रस्य जलकुंभं निवेदयेत् ।\nअस्य मंत्रस्य च ऋषिर्नारदः परिकीर्तितः ।\nविराट्छन्दश्च ईशानो देवता समुदाहृता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002587014, "chapter_id": 22587, "verse_number": "३-१२-१५", "content_sanskrit": "मोचयेन्मीनयुग्मं च मेषयुग्मं तथैव च ।\nसंभवे पक्षियुग्मं च आडीं वा चक्रवाककम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002587015, "chapter_id": 22587, "verse_number": "३-१२-१६", "content_sanskrit": "मोचयेन्नागयुग्मं च आयुवृद्धेश्च हेतवे ।\nदिक्षु जीवंतिकां दद्याद्राक्षसेभ्यो बलिं हरेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002587016, "chapter_id": 22587, "verse_number": "३-१२-१७", "content_sanskrit": "निर्मितं माषभक्तेन रक्तपुष्पैरलंकृतम् ।\nक्षात्रको लक्ष्मणश्चैव मणिभद्रो गणेश्वरः ।\nसबिंदुकेन हंतेन दिक्षु मध्ये यथा क्रमात् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002587017, "chapter_id": 22587, "verse_number": "३-१२-१८", "content_sanskrit": "ये भवा भाविनो भूता ये च तेषु मयासिनः ।\nआहरं तु बलिं तुष्ट्या प्रयच्छंतु शुभं मम ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002587018, "chapter_id": 22587, "verse_number": "३-१२-१९", "content_sanskrit": "इत्युक्त्वा च बलिं दद्यान्नमस्कुर्यादनंतरम् ।\nदद्यात्पयस्विनीं गां च आचार्याय विशेषतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002587019, "chapter_id": 22587, "verse_number": "३-१२-२०", "content_sanskrit": "अन्येषां हि हिरण्यं च गां च दद्याद्द्विजन्मने ।\nव्याहृतिद्वितयं चैव ततो वारुणपंचकम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002587020, "chapter_id": 22587, "verse_number": "३-१२-२१", "content_sanskrit": "प्राजापत्यं स्विष्टकृच्च जुहुयात्तदनंतरम् ।\nघृतैः स्विष्टकृतं नास्ति तथा रसविसारकैः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002587021, "chapter_id": 22587, "verse_number": "३-१२-२२", "content_sanskrit": "पद्मोत्पलैर्मातुलिंगैः पनसैर्मातुलुंगकैः ।\nमधूकैर्विश्वपुष्पैश्च तथाम्रातककाशकैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002587022, "chapter_id": 22587, "verse_number": "३-१२-२३", "content_sanskrit": "अभिषेकं ततः कुर्यात्सुवास्त्विति च वै जपन् ।\nदद्यात्पूर्णां च विधिवत्सूर्यायार्घ्यं निवेदयेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002587023, "chapter_id": 22587, "verse_number": "३-१२-२४", "content_sanskrit": "पञ्चदोषं पुरस्कृत्य ब्राह्मणानुमतेन च ।\nगृहं प्रविश्य च ततो ब्राह्मणानथ भोजयेत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002587024, "chapter_id": 22587, "verse_number": "३-१२-२५", "content_sanskrit": "दीनांधकृपणे चैव दद्याद्वित्तानुसारतः ।\nज्ञातिभिः सह भुञ्जीत दधिक्षीरामिषं विना ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002587025, "chapter_id": 22587, "verse_number": "३-१२-२६", "content_sanskrit": "न क्षीरं च कषायं च भर्जितं शाकमेव च ।\nन काण्डं च न पुष्पं च करीरं च कदाचन ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002587026, "chapter_id": 22587, "verse_number": "३-१२-२७", "content_sanskrit": "शाल्यन्नं मूलकं चैव पनसाम्रफलानि च ।\nमस्तं मधुघृतगुडं मातुलिंगं ससैंधवम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002587027, "chapter_id": 22587, "verse_number": "३-१२-२८", "content_sanskrit": "बदरं धातकिफलं कुन्द पुष्पं तथा तिलम् ।\nएतत्प्रशस्तं जानीयान्मरीचानि विशेषतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002587028, "chapter_id": 22587, "verse_number": "३-१२-२९", "content_sanskrit": "त्रिरात्रमथ सप्ताहं परित्यज्य खले ततः ।\nपञ्चांगकं ततः कुर्यात्स्थाप येन्नेति युग्मकम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002587029, "chapter_id": 22587, "verse_number": "३-१२-३०", "content_sanskrit": "प्रथमा चार्कहस्तेन द्वितीया दशहस्तिका ।\nवितस्ते तु भवेच्छतं द्विगुणं तदनंतरम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002587030, "chapter_id": 22587, "verse_number": "३-१२-३१", "content_sanskrit": "शतार्धं ततः पश्चात्षष्टिहस्तमनंतरम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]