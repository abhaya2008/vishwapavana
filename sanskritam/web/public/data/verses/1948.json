[{"id": 2042497, "chapter_id": 1948, "verse_number": "५-१९३-०x", "content_sanskrit": "संजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042498, "chapter_id": 1948, "verse_number": "५-१९३-१", "content_sanskrit": "प्रभातायां तु शर्वर्यां पुनरेव सुतस्तव।\nमध्ये सर्वस्य सैन्यस्य पितामहमपृच्छत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042499, "chapter_id": 1948, "verse_number": "५-१९३-२x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042500, "chapter_id": 1948, "verse_number": "५-१९३-२", "content_sanskrit": "पाण्डवेयस्य गाङ्गेय यदेतत्सैन्यमुद्यतम्।\nप्रभूतनरनागाश्वं महारथसमाकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042501, "chapter_id": 1948, "verse_number": "५-१९३-३", "content_sanskrit": "भीमार्जुनप्रभृतिभिर्महेष्वासैर्महाबलैः ।\nलोकपालसमैर्गुप्तं धृष्टद्युम्नपुरोगमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042502, "chapter_id": 1948, "verse_number": "५-१९३-४", "content_sanskrit": "अप्रधृष्यमनावार्यमुद्धूतमिव सागरम् ।\nसेनासागरमक्षोभ्यमपि देवार्महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042503, "chapter_id": 1948, "verse_number": "५-१९३-५", "content_sanskrit": "केन कालेन गाङ्गेय क्षपयेथा महाद्युते ।\nआचार्यो वा महेष्वासः कृपो वाऽऽशु महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042504, "chapter_id": 1948, "verse_number": "५-१९३-६", "content_sanskrit": "कर्णो वा समरश्लाघी द्रौणिर्वा द्विजसत्तमः ।\nदिव्यास्त्रविदुषः सर्वे भवन्तो हि बले मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042505, "chapter_id": 1948, "verse_number": "५-१९३-७", "content_sanskrit": "एतदिच्छाम्यहं ज्ञातुं परं कौतूहलं हि मे।\nहृदि नित्यं महाबाहो वक्तुमर्हसि तन्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042506, "chapter_id": 1948, "verse_number": "५-१९३-८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042507, "chapter_id": 1948, "verse_number": "५-१९३-८", "content_sanskrit": "अनुरूपं कुरुश्रेष्ठ त्वय्येतत्पृथिवीपते।\nबलाबलममित्राणां तेषां यदिह पृच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042508, "chapter_id": 1948, "verse_number": "५-१९३-९", "content_sanskrit": "श्रृणु राजन्मम रणे या शक्तिः परमा भवेत् ।\nशस्त्रवीर्ये रणे यच्च भुजयोश्च महाभुज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042509, "chapter_id": 1948, "verse_number": "५-१९३-१०", "content_sanskrit": "आर्जवेनैव युद्धेन योद्धव्य इतरो जनः।\nमायायुद्धेन मायावी इत्येतद्धर्मनिश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042510, "chapter_id": 1948, "verse_number": "५-१९३-११", "content_sanskrit": "हन्यामहं महाभाग पाण्डवानामनीकिनीम् ।\nदिवसे दिवसे कृत्वा भागान्भागान्निजान्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042511, "chapter_id": 1948, "verse_number": "५-१९३-१२", "content_sanskrit": "योधानां दशसाहस्रं कृत्वा भागं महाद्युते ।\nसहस्रं रथिनामेकमेष भागो मतो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042512, "chapter_id": 1948, "verse_number": "५-१९३-१३", "content_sanskrit": "अनेनाहं विधानेन सन्नद्धः सततोत्थितः ।\nक्षपयेयं महत्सैन्यं कालेनानेन भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042513, "chapter_id": 1948, "verse_number": "५-१९३-१४", "content_sanskrit": "मुञ्चेयं यदि वास्त्राणि महान्ति समरे स्थितः ।\nशतसाहस्रघातीनि हन्यां मासेन भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042514, "chapter_id": 1948, "verse_number": "५-१९३-१५x", "content_sanskrit": "संजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042515, "chapter_id": 1948, "verse_number": "५-१९३-१५", "content_sanskrit": "श्रुत्वा भीष्मस्य तद्वाक्यं राजा दुर्योधनस्ततः ।\nपर्यपृच्छत राजेन्द्र द्रोणमङ्गिरसां वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042516, "chapter_id": 1948, "verse_number": "५-१९३-१६", "content_sanskrit": "आचार्य केन कालेन पाण्डुपुत्रस्य सैनिकान् ।\nनिहन्या इति तं द्रोणः प्रत्युवाच हसन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042517, "chapter_id": 1948, "verse_number": "५-१९३-१७", "content_sanskrit": "स्थविरोऽस्मि महाबाहो मन्दप्राणविचेष्टितः ।\nशस्त्राग्निना निर्दहेयं पाण्डवानामनीकिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2042518, "chapter_id": 1948, "verse_number": "५-१९३-१८", "content_sanskrit": "यथा भीष्मः शान्तनवो मासेनेति मतिर्मम ।\nएषा मे परमा शक्तिरेतन्मे परमं बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2042519, "chapter_id": 1948, "verse_number": "५-१९३-१९", "content_sanskrit": "द्वाभ्यामेव तु मासाभ्यां कृपः शारद्वतोऽब्रवीत्।\nद्रौणिस्तु दशरात्रेण प्रतिजज्ञे बलक्षयम्।\nकर्णस्तु पञ्चरात्रेण प्रतिजज्ञे महास्त्रवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2042520, "chapter_id": 1948, "verse_number": "५-१९३-२०", "content_sanskrit": "तच्छ्रुत्वा सूतपुत्रस्य वाक्यं सागरगासुतः।\nजहास सस्वनं हासं वाक्यं चेदमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2042521, "chapter_id": 1948, "verse_number": "५-१९३-२१", "content_sanskrit": "न हि यावद्रणे पार्थं बाणशङ्खधनुर्धरम्।\nवासुदेवसमायुक्तं रथेनायान्तमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2042522, "chapter_id": 1948, "verse_number": "५-१९३-२२", "content_sanskrit": "समागच्छसि राधेय तेनैवमभिमन्यसे ।\nशक्यमेवं च भूयश्च त्वया वक्तुं यथेष्टतः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2042523, "chapter_id": 1948, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि अम्बोपाख्यानपर्वणि विनवत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]