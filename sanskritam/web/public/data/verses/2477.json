[{"id": 2070432, "chapter_id": 2477, "verse_number": "११-९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070433, "chapter_id": 2477, "verse_number": "११-९-१", "content_sanskrit": "विदुरस्य तु तद्वाक्यं श्रुत्वा तु पुरुषर्षभः।\nयुज्यतां यानमित्युक्त्वा पुनर्वचनमव्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070434, "chapter_id": 2477, "verse_number": "११-९-२x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070435, "chapter_id": 2477, "verse_number": "", "content_sanskrit": "शीघ्रमानय गान्धारीं सर्वाश्च भरतस्त्रियः।\nवधूं कुन्तीमुपादाय याश्चान्यास्तत्र योषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]