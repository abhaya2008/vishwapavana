[{"id": 5000420000, "chapter_id": 9420, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे त्रयोदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000420001, "chapter_id": 9420, "verse_number": "६-१३-१", "content_sanskrit": "रावणं क्रुद्धमाज्ञाय महापार्श्वो महाबलः।\nमुहूर्तमनुसंचिन्त्य प्राञ्जलिर्वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000420002, "chapter_id": 9420, "verse_number": "६-१३-२", "content_sanskrit": "यः खल्वपि वनं प्राप्य मृगव्यालनिषेवितम्।\nन पिबेन्मधु सम्प्राप्य स नरो बालिशो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000420003, "chapter_id": 9420, "verse_number": "६-१३-३", "content_sanskrit": "ईश्वरस्येश्वरः कोऽस्ति तव शत्रुनिबर्हण।\nरमस्व सह वैदेह्या शत्रूनाक्रम्य मूर्धसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000420004, "chapter_id": 9420, "verse_number": "६-१३-४", "content_sanskrit": "बलात् कुक्कुटवृत्तेन प्रवर्तस्व महाबल।\nआक्रम्याक्रम्य सीतां वै तां भुङ्क्ष्व च रमस्व च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000420005, "chapter_id": 9420, "verse_number": "६-१३-५", "content_sanskrit": "लब्धकामस्य ते पश्चादागमिष्यति किं भयम्।\nप्राप्तमप्राप्तकालं वा सर्वं प्रतिविधास्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000420006, "chapter_id": 9420, "verse_number": "६-१३-६", "content_sanskrit": "कुम्भकर्णः सहास्माभिरिन्द्रजिच्च महाबलः।\nप्रतिषेधयितुं शक्तौ सवज्रमपि वज्रिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000420007, "chapter_id": 9420, "verse_number": "६-१३-७", "content_sanskrit": "उपप्रदानं सान्त्वं वा भेदं वा कुशलैः कृतम्।\nसमतिक्रम्य दण्डेन सिद्धिमर्थेषु रोचये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000420008, "chapter_id": 9420, "verse_number": "६-१३-८", "content_sanskrit": "इह प्राप्तान् वयं सर्वाञ्छत्रूंस्तव महाबल।\nवशे शस्त्रप्रतापेन करिष्यामो न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000420009, "chapter_id": 9420, "verse_number": "६-१३-९", "content_sanskrit": "एवमुक्तस्तदा राजा महापार्श्वेन रावणः।\nतस्य सम्पूजयन् वाक्यमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000420010, "chapter_id": 9420, "verse_number": "६-१३-१०", "content_sanskrit": "महापार्श्व निबोध त्वं रहस्यं किंचिदात्मनः।\nचिरवृत्तं तदाख्यास्ये यदवाप्तं पुरा मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000420011, "chapter_id": 9420, "verse_number": "६-१३-११", "content_sanskrit": "पितामहस्य भवनं गच्छन्तीं पुञ्जिकस्थलाम्।\nचञ्चूर्यमाणामद्राक्षमाकाशेऽग्निशिखामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000420012, "chapter_id": 9420, "verse_number": "६-१३-१२", "content_sanskrit": "सा प्रसह्य मया भुक्ता कृता विवसना ततः।\nस्वयम्भूभवनं प्राप्ता लोलिता नलिनी यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000420013, "chapter_id": 9420, "verse_number": "६-१३-१३", "content_sanskrit": "तच्च तस्य तथा मन्ये ज्ञातमासीन्महात्मनः।\nअथ संकुपितो वेधा मामिदं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000420014, "chapter_id": 9420, "verse_number": "६-१३-१४", "content_sanskrit": "अद्यप्रभृति यामन्यां बलान्नारीं गमिष्यसि।\nतदा ते शतधा मूर्धा फलिष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000420015, "chapter_id": 9420, "verse_number": "६-१३-१५", "content_sanskrit": "इत्यहं तस्य शापस्य भीतः प्रसभमेव ताम्।\nनारोहये बलात् सीतां वैदेहीं शयने शुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000420016, "chapter_id": 9420, "verse_number": "६-१३-१६", "content_sanskrit": "सागरस्येव मे वेगो मारुतस्येव मे गतिः।\nनैतद् दाशरथिर्वेद ह्यासादयति तेन माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000420017, "chapter_id": 9420, "verse_number": "६-१३-१७", "content_sanskrit": "को हि सिंहमिवासीनं सुप्तं गिरिगुहाशये।\nक्रुद्धं मृत्युमिवासीनं प्रबोधयितुमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000420018, "chapter_id": 9420, "verse_number": "६-१३-१८", "content_sanskrit": "न मत्तो निर्गतान् बाणान् द्विजिह्वान् पन्नगानिव।\nरामः पश्यति संग्रामे तेन मामभिगच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000420019, "chapter_id": 9420, "verse_number": "६-१३-१९", "content_sanskrit": "क्षिप्रं वज्रसमैर्बाणैः शतधा कार्मुकच्युतैः।\nराममादीपयिष्यामि उल्काभिरिव कुञ्जरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000420020, "chapter_id": 9420, "verse_number": "६-१३-२०", "content_sanskrit": "तच्चास्य बलमादास्ये बलेन महता वृतः।\nउदितः सविता काले नक्षत्राणां प्रभामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000420021, "chapter_id": 9420, "verse_number": "६-१३-२१", "content_sanskrit": "न वासवेनापि सहस्रचक्षुषा\nयुधास्मि शक्यो वरुणेन वा पुनः।\nमया त्वियं बाहुबलेन निर्जिता\nपुरा पुरी वैश्रवणेन पालिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000420022, "chapter_id": 9420, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे त्रयोदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]