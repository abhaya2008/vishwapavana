[{"id": 40023050, "chapter_id": 9420, "verse_number": "1", "content_sanskrit": "श्रुत्वा सेनापतिं प्राप्तं भरतं केकयाधिपः । युधाजिद्गार्ग्यसहितं परां प्रीतिमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40023051, "chapter_id": 9420, "verse_number": "2", "content_sanskrit": "स निर्ययौ जनौघेन महता केकयाधिपः । त्वरमाणो ऽभिचक्राम गन्धर्वान्कामरूपिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40023052, "chapter_id": 9420, "verse_number": "3", "content_sanskrit": "भरतश्च युधाजिच्च समेतौ लघुविक्रमैः । गन्धर्वनगरं प्राप्तौ सबलौ सपदानुगौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40023053, "chapter_id": 9420, "verse_number": "4", "content_sanskrit": "श्रुत्वा तु भरतं प्राप्तं गन्धर्वास्ते समागताः । योद्धुकामा महावीर्या व्यनदन् वै समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40023054, "chapter_id": 9420, "verse_number": "5", "content_sanskrit": "ततः समभवद्युद्धं तुमुलं रोमहर्षणम् । सप्तरात्रं महाभीमं न चान्यतरयोर्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40023055, "chapter_id": 9420, "verse_number": "6", "content_sanskrit": "खड्गशक्तिधनुर्ग्राहा नद्यः शोणितसंस्रवाः । नृकलेवरवाहिन्यः प्रवृत्ताः सर्वतोदिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40023056, "chapter_id": 9420, "verse_number": "7", "content_sanskrit": "ततो रामानुजः क्रुद्धः कालस्यास्त्रं सुदारुणम् । संवर्तं नाम भरतो गन्धर्वेष्वभ्यचोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40023057, "chapter_id": 9420, "verse_number": "8", "content_sanskrit": "ते बद्धाः कालपाशेन संवर्तेन विदारिताः । क्षणेनाभिहतास्तेन तिस्रः कोट्यो महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40023058, "chapter_id": 9420, "verse_number": "9", "content_sanskrit": "तं घातं घोरसङ्काशं न स्मरन्ति दिवौकसः । निमेषान्तरमात्रेण तादृशानां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40023059, "chapter_id": 9420, "verse_number": "10", "content_sanskrit": "हतेषु तेषु सर्वेषु भरतः केकयीसुतः । निवेशयामास तदा समृद्धे द्वे पुरोत्तमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40023060, "chapter_id": 9420, "verse_number": "11", "content_sanskrit": "तक्षं तक्षशिलायां तु पुष्कलं पुष्कलावते । गन्धर्वदेशे रुचिरे गान्धारविषये च सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40023061, "chapter_id": 9420, "verse_number": "12", "content_sanskrit": "धनरत्नौघसङ्कीर्णे काननैरुपशोभिते । अन्योन्यसङ्घर्षकृते स्पर्धया गुणविस्तरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40023062, "chapter_id": 9420, "verse_number": "13", "content_sanskrit": "उभे सुरुचिरप्रख्ये व्यवहारैरकिल्बिषैः । उद्यानयानसम्पूर्णे सुविभक्तान्तरापणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40023063, "chapter_id": 9420, "verse_number": "14", "content_sanskrit": "उभे पुरवरे रम्ये विस्तरैरुपशोभिते । गृहमुख्यैः सुरुचिरैर्विमानसमवर्णिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40023064, "chapter_id": 9420, "verse_number": "15", "content_sanskrit": "शोभिते शोभनीयैश्च देवायतनविस्तरैः । तालैस्तमालैस्तिलकैर्वकुलैरुपशोभिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40023065, "chapter_id": 9420, "verse_number": "16", "content_sanskrit": "निवेश्य पञ्चभिर्वर्षैर्भरतो राघवानुजः । पुनरायान्महाबाहुरयोध्यां केकयीसुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40023066, "chapter_id": 9420, "verse_number": "17", "content_sanskrit": "सो ऽभिवाद्य महात्मानं साक्षाद्धर्ममिवापरम् । राघवं भरतः श्रीमान्ब्रह्माणमिव वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40023067, "chapter_id": 9420, "verse_number": "18", "content_sanskrit": "शशंस च यथावृत्तं गन्धर्ववधमुत्तमम् । निवेशनं च देशस्य श्रुत्वा प्रीतो ऽस्य राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]