[{"id": 7000389000, "chapter_id": 20389, "verse_number": "२-६१-१", "content_sanskrit": "वेन उवाच ।\nभार्यातीर्थं समाख्यातं सर्वतीर्थोत्तमोत्तमम् ।\nपितृतीर्थं समाख्याहि पुत्राणां तारणं परम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000389001, "chapter_id": 20389, "verse_number": "२-६१-२", "content_sanskrit": "विष्णुरुवाच ।\nकुरुक्षेत्रे महाक्षेत्रे कुंडलो नाम ब्राह्मणः ।\nसुकर्मा नाम सत्पुत्रः कुंडलस्य महात्मनः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000389002, "chapter_id": 20389, "verse_number": "२-६१-३", "content_sanskrit": "गुरू तस्य महावृद्धौ धर्मज्ञौ शास्त्रकोविदौ ।\nद्वावेतौ तु महात्मानौ जरया परिपीडितौ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000389003, "chapter_id": 20389, "verse_number": "२-६१-४", "content_sanskrit": "तयोः शुश्रूषणं चक्रे भक्त्या च परया ततः ।\nधर्मज्ञो भावसंयुक्तो अहर्निशमनारतम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000389004, "chapter_id": 20389, "verse_number": "२-६१-५", "content_sanskrit": "तस्माद्वेदानधीते स पितुः शास्त्राण्यनेकशः ।\nसर्वाचारपरो दक्षो धर्मज्ञो ज्ञानवत्सलः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000389005, "chapter_id": 20389, "verse_number": "२-६१-६", "content_sanskrit": "अंगसंवाहनं चक्रे गुर्वोश्च स्वयमेव सः ।\nपादप्रक्षालनं चैव स्नानभोजनकीं क्रियाम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000389006, "chapter_id": 20389, "verse_number": "२-६१-७", "content_sanskrit": "भक्त्या चैव स्वभावेन तद्ध्याने तन्मयो भवेत् ।\nमातापित्रोश्च राजेंद्र उपचर्यां प्रकारयेत्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000389007, "chapter_id": 20389, "verse_number": "२-६१-८", "content_sanskrit": "सूत उवाच ।\nतद्वर्तमानकाले तु बभूव नृपसत्तम ।\nपिप्पलो नाम वै विप्रः कश्यपस्य महात्मनः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000389008, "chapter_id": 20389, "verse_number": "२-६१-९", "content_sanskrit": "तपस्तेपे निराहारो जितात्मा जितमत्सरः ।\nदयादानदमोपेतः कामं क्रोधं विजित्य सः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000389009, "chapter_id": 20389, "verse_number": "२-६१-१०", "content_sanskrit": "दशारण्यगतो धीमाञ्ज्ञानशांतिपरायणः ।\nसर्वेंद्रियाणि संयम्य तपस्तेपे महामनाः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000389010, "chapter_id": 20389, "verse_number": "२-६१-११", "content_sanskrit": "तपःप्रभावतस्तस्य जंतवो गतविग्रहाः ।\nवसंति सुयुगे तत्र एकोदरगता इव॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000389011, "chapter_id": 20389, "verse_number": "२-६१-१२", "content_sanskrit": "तत्तपस्तस्य मुनयो दृष्ट्वा विस्मयमाययुः ।\nनेदृशं केनचित्तप्तं यथासौ तप्यते मुनिः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000389012, "chapter_id": 20389, "verse_number": "२-६१-१३", "content_sanskrit": "देवाश्च इंद्रप्रमुखाः परं विस्मयमाययुः ।\nअहो अस्य तपस्तीव्रं शमश्चेंद्रियसंयमः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000389013, "chapter_id": 20389, "verse_number": "२-६१-१४", "content_sanskrit": "निर्विकारो निरुद्वेगः कामक्रोधविवर्जितः ।\nशीतवातातपसहो धराधर इवस्थितः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000389014, "chapter_id": 20389, "verse_number": "२-६१-१५", "content_sanskrit": "विषये विमुखो धीरो मनसोतीतसंग्रहम् ।\nन शृणोति यथा शब्दं कस्यचिद्द्विजसत्तमः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000389015, "chapter_id": 20389, "verse_number": "२-६१-१६", "content_sanskrit": "संस्थानं तादृशं गत्वा स्थित्वा एकाग्रमानसः ।\nब्रह्मध्यानमयो भूत्वा सानंदमुखपंकजः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000389016, "chapter_id": 20389, "verse_number": "२-६१-१७", "content_sanskrit": "अश्मकाष्ठमयो भूत्वा निश्चेष्टो गिरिवत्स्थितः ।\nस्थाणुवद्दृश्यते चासौ सुस्थिरो धर्मवत्सलः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000389017, "chapter_id": 20389, "verse_number": "२-६१-१८", "content_sanskrit": "तपःक्लिष्टशरीरोति श्रद्धावाननसूयकः ।\nएवं वर्षसहस्रैकं संजातं तस्य धीमतः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000389018, "chapter_id": 20389, "verse_number": "२-६१-१९", "content_sanskrit": "पिपीलिकाभिर्बह्वीभिः कृतं मृद्भारसंचयम् ।\nतस्योपरि महाकायं वल्मीकं निजमंदिरम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000389019, "chapter_id": 20389, "verse_number": "२-६१-२०", "content_sanskrit": "वल्मीकोदरमध्यस्थो जडीभूत इवस्थितः ।\nस एवं पिप्पलो विप्रस्तपते सुमहत्तपः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000389020, "chapter_id": 20389, "verse_number": "२-६१-२१", "content_sanskrit": "कृष्णसर्पैस्तु सर्वत्र वेष्टितो द्विजसत्तमः ।\nतमुग्रतेजसं विप्रं प्रदशंति विषोल्बणाः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000389021, "chapter_id": 20389, "verse_number": "२-६१-२२", "content_sanskrit": "संप्राप्य गात्रमर्माणि विषं तस्य न भेदयेत् ।\nतेजसा तस्य विप्रस्य नागाः शांतिमथागमन्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000389022, "chapter_id": 20389, "verse_number": "२-६१-२३", "content_sanskrit": "तस्य कायात्समुद्भूता अर्चिषो दीप्ततेजसः ।\nनानारूपाः सुबहुशो दृश्यंते च पृथक्पृथक्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000389023, "chapter_id": 20389, "verse_number": "२-६१-२४", "content_sanskrit": "यथा वह्नेः खरतरास्तथाविधा नरोत्तम ।\nयथामेघोदरे सूर्यः प्रविष्टो भाति रश्मिभिः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000389024, "chapter_id": 20389, "verse_number": "२-६१-२५", "content_sanskrit": "वल्मीकस्थस्तथाविप्रः पिप्पलो भाति तेजसा ।\nसर्पा दशंति विप्रं तं सक्रोधा दशनैरपि॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000389025, "chapter_id": 20389, "verse_number": "२-६१-२६", "content_sanskrit": "न भिंदंति च दंष्ट्राग्राच्चर्म भित्त्वा नृपोत्तम ।\nएवं वर्षसहस्रैकं तप आचरतस्ततः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000389026, "chapter_id": 20389, "verse_number": "२-६१-२७", "content_sanskrit": "गतं तु राजराजेंद्र मुनेस्तस्य महात्मनः ।\nत्रिकालं साध्यमानस्य शीतवर्षातपान्वितः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000389027, "chapter_id": 20389, "verse_number": "२-६१-२८", "content_sanskrit": "गतः कालो महाराज पिप्पलस्य महात्मनः ।\nतद्वच्च वायुभक्षं तु कृतं तेन महात्मना॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000389028, "chapter_id": 20389, "verse_number": "२-६१-२९", "content_sanskrit": "त्रीणि वर्षसहस्राणि गतानि तस्य तप्यतः ।\nतस्य मूर्ध्नि ततो देवैः पुष्पवृष्टिः कृता पुरा॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000389029, "chapter_id": 20389, "verse_number": "२-६१-३०", "content_sanskrit": "ब्रह्मज्ञोसि महाभाग धर्मज्ञोसि न संशयः ।\nसर्वज्ञानमयोऽसि त्वं संजातः स्वेनकर्मणा॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000389030, "chapter_id": 20389, "verse_number": "२-६१-३१", "content_sanskrit": "यं यं त्वं वांछसे कामं तं तं प्राप्स्यसि नान्यथा ।\nसर्वकामप्रसिद्धस्त्वं स्वत एव भविष्यसि॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000389031, "chapter_id": 20389, "verse_number": "२-६१-३२", "content_sanskrit": "समाकर्ण्य महद्वाक्यं पिप्पलोपि महामनाः ।\nप्रणम्य देवताः सर्वा भक्त्या नमितकंधरः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000389032, "chapter_id": 20389, "verse_number": "२-६१-३३", "content_sanskrit": "हर्षेण महताविष्टो वचनं प्रत्युवाच सः ।\nइदं विश्वं जगत्सर्वं ममवश्यं यथा भवेत्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000389033, "chapter_id": 20389, "verse_number": "२-६१-३४", "content_sanskrit": "तथा कुरुध्वं देवेंद्रा विद्याधरो भवाम्यहम् ।\nएवमुक्त्वा स मेधावी विरराम नृपोत्तम॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000389034, "chapter_id": 20389, "verse_number": "२-६१-३५", "content_sanskrit": "एवमस्त्विति ते प्रोचुर्द्विजश्रेष्ठं सुरास्तदा ।\nदत्वा वरं महाभाग जग्मुस्तस्मै महात्मने॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000389035, "chapter_id": 20389, "verse_number": "२-६१-३६", "content_sanskrit": "गतेषु तेषु देवेषु पिप्पलो द्विजसत्तमः ।\nब्रह्मण्यं साधयेन्नित्यं विश्ववश्यं प्रचिंतयेत्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000389036, "chapter_id": 20389, "verse_number": "२-६१-३७", "content_sanskrit": "तदाप्रभृति राजेंद्र पिप्पलो द्विजसत्तमः ।\nविद्याधरपदं लब्ध्वा कामगामी महीयते॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000389037, "chapter_id": 20389, "verse_number": "२-६१-३८", "content_sanskrit": "एवं स पिप्पलो विप्रो विद्याधरपदं गतः ।\nसंजातो देवलोकेशः सर्वशास्त्रविशारदः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000389038, "chapter_id": 20389, "verse_number": "२-६१-३९", "content_sanskrit": "एकदा तु महातेजाः पिप्पलः पर्यचिंतयत् ।\nविश्ववश्यं भवेत्सर्वं मम दत्तो वरोत्तमः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000389039, "chapter_id": 20389, "verse_number": "२-६१-४०", "content_sanskrit": "तदर्थं प्रत्ययं कर्तुमुद्यतो द्विजपुंगवः ।\nयं यं चिंतयते कर्तुं तं तं हि वशमानयेत्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000389040, "chapter_id": 20389, "verse_number": "२-६१-४१", "content_sanskrit": "एवं स प्रत्यये जाते मनसा पर्यकल्पयत् ।\nद्वितीयो नास्ति वै लोके मत्समः पुरुषोत्तमः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000389041, "chapter_id": 20389, "verse_number": "२-६१-४२", "content_sanskrit": "सूत उवाच ।\nएवं हि कल्पमानस्य पिप्पलस्य महात्मनः ।\nज्ञात्वा मानसिकं भावं सारसस्तमुवाच ह॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000389042, "chapter_id": 20389, "verse_number": "२-६१-४३", "content_sanskrit": "सरस्तीरगतो राजन्सुस्वरं व्यंजनान्वितम् ।\nस्वनं सौष्ठवसंयुक्तमुक्तवान्पिप्पलं प्रति॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000389043, "chapter_id": 20389, "verse_number": "२-६१-४४", "content_sanskrit": "कस्मादुद्वहसे गर्वमेवं त्वं परमात्मकम् ।\nसर्ववश्यात्मिकीं सिद्धिं नाहं मन्ये तवैव हि॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000389044, "chapter_id": 20389, "verse_number": "२-६१-४५", "content_sanskrit": "वश्यावश्यमिदं कर्म अर्वाचीनं प्रशस्यते ।\nपराचीनं न जानासि पिप्पल त्वं हि मूढधीः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000389045, "chapter_id": 20389, "verse_number": "२-६१-४६", "content_sanskrit": "वर्षाणां तु सहस्राणि यावत्त्रीणि त्वया तपः ।\nसमाचीर्णं ततो गर्वं कुरुषे किं मुधा द्विज॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000389046, "chapter_id": 20389, "verse_number": "२-६१-४७", "content_sanskrit": "कुंडलस्य सुतो धीरः सुकर्मानाम यः सुधीः ।\nवश्यावश्यं जगत्सर्वं तस्यासीच्छृणु सांप्रतम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000389047, "chapter_id": 20389, "verse_number": "२-६१-४८", "content_sanskrit": "अर्वाचीनं पराचीनं स वै जानाति बुद्धिमान् ।\nलोके नास्ति महाज्ञानी तत्समः शृणु पिप्पल॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000389048, "chapter_id": 20389, "verse_number": "२-६१-४९", "content_sanskrit": "न कुंडलस्य पुत्रेण सदृशस्त्वं सुकर्मणा ।\nन दत्तं तेन वै दानं न ज्ञानं परिचिंतितम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000389049, "chapter_id": 20389, "verse_number": "२-६१-५०", "content_sanskrit": "हुतयज्ञादिकं कर्म न कृतं तेन वै कदा ।\nन गतस्तीर्थयात्रायां न च वह्नेरुपासनम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000389050, "chapter_id": 20389, "verse_number": "२-६१-५१", "content_sanskrit": "स कदा कृतवान्विप्र धर्मसेवार्थमुत्तमम् ।\nस्वच्छंदचारी ज्ञानात्मा पितृमातृसुहृत्सदा॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000389051, "chapter_id": 20389, "verse_number": "२-६१-५२", "content_sanskrit": "वेदाध्ययनसंपन्नः सर्वशास्त्रार्थकोविदः ।\nयादृशं तस्य वै ज्ञानं बालस्यापि सुकर्मणः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000389052, "chapter_id": 20389, "verse_number": "२-६१-५३", "content_sanskrit": "तादृशं नास्ति ते ज्ञानं वृथा त्वं गर्वमुद्वहेः ।\nपिप्पल उवाच ।\nको भवान्पक्षिरूपेण मामेवं परिकुत्सयेत्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000389053, "chapter_id": 20389, "verse_number": "२-६१-५४", "content_sanskrit": "कस्मान्निंदसि मे ज्ञानं पराचीनं तु कीदृशम् ।\nतन्मे विस्तरतो ब्रूहि त्वयि ज्ञानं कथं भवेत्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000389054, "chapter_id": 20389, "verse_number": "२-६१-५५", "content_sanskrit": "अर्वाचीनगतिं सर्वां पराचीनस्य सांप्रतम् ।\nवद त्वमंडजश्रेष्ठ ज्ञानपूर्वं सुविस्तरम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000389055, "chapter_id": 20389, "verse_number": "२-६१-५६", "content_sanskrit": "किं वा ब्रह्मा च विष्णुश्च किं वा रुद्रो भविष्यसि ।\nसारस उवाच ।\nनास्ति ते तपसो भावः फलं नास्ति च तस्य तु॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000389056, "chapter_id": 20389, "verse_number": "२-६१-५७", "content_sanskrit": "त्वया न परितप्तस्य तपसः सांप्रतं शृणु ।\nकुंडलस्यापि पुत्रस्य बालस्यापि यथा गुणः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000389057, "chapter_id": 20389, "verse_number": "२-६१-५८", "content_sanskrit": "तथा ते नास्ति वै ज्ञानं परिज्ञातं न तत्पदम् ।\nइतो गत्वापि पृच्छ त्वं मम रूपं द्विजोत्तम॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000389058, "chapter_id": 20389, "verse_number": "२-६१-५९", "content_sanskrit": "स वदिष्यति धर्मात्मा सर्वं ज्ञानं तवैव हि ।\nविष्णुरुवाच ।\nएवमाकर्ण्य तत्सर्वं सारसेन प्रभाषितम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000389059, "chapter_id": 20389, "verse_number": "२-६१-६०", "content_sanskrit": "निर्जगाम स वेगेन दशारण्यं महाश्रमम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]