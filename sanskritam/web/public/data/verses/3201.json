[{"id": 2101978, "chapter_id": 3201, "verse_number": "१४-५७-१", "content_sanskrit": "वैशम्पायन उवाच।\nस तं दृष्ट्वा तथाभूतं राजानं घोरदर्शनम्।\nदीर्घश्मश्रुधरं नॄणां शोणितेन समुक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101979, "chapter_id": 3201, "verse_number": "१४-५७-२", "content_sanskrit": "चकार न व्यथां विप्रो राजा त्वेनमथाब्रवीत्।\nप्रत्युत्थाय महातेजा भयकर्ता यमोपमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101980, "chapter_id": 3201, "verse_number": "१४-५७-३", "content_sanskrit": "दिष्ट्या त्वमसि कल्याण षष्ठे काले ममान्तिकम्।\nभक्ष्यं मृगयमाणस्य सम्प्राप्तो द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101981, "chapter_id": 3201, "verse_number": "१४-५७-४x", "content_sanskrit": "उदङ्ग उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101982, "chapter_id": 3201, "verse_number": "१४-५७-४", "content_sanskrit": "राजन्गुर्वर्थिनं विद्धि चरन्तं मामिहागतम्।\nन च गुर्वर्थमुद्युक्तं हिंस्यमाहुर्मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101983, "chapter_id": 3201, "verse_number": "१४-५७-५x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101984, "chapter_id": 3201, "verse_number": "१४-५७-५", "content_sanskrit": "षष्ठे काले ममाहारो विहितो द्विजसत्तम।\nन शक्यस्त्वं समुत्स्रष्टुं क्षुधितेन मयाऽद्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101985, "chapter_id": 3201, "verse_number": "१४-५७-६x", "content_sanskrit": "उदङ्क उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101986, "chapter_id": 3201, "verse_number": "१४-५७-६", "content_sanskrit": "एवमस्तु महाराजि समयः क्रियतां तु मे।\nगुर्वर्थमभिनिर्वर्त्य पुनरेष्यामि ते वशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101987, "chapter_id": 3201, "verse_number": "१४-५७-७", "content_sanskrit": "संश्रुतश्च मया योऽर्थो गुरवे राजसत्तम।\nत्वदधीनः स राजेन्द्र तं त्वां भिक्षे नरेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101988, "chapter_id": 3201, "verse_number": "१४-५७-८", "content_sanskrit": "ददासि विप्रमुख्येभ्यस्त्वं हि रत्नानि नित्यदा।\nदाता च त्वं नरव्याघ्र पात्रभूतः क्षिताविह।\nपात्रं प्रतिग्रहे चापि विद्धि मां नृपसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101989, "chapter_id": 3201, "verse_number": "१४-५७-९", "content_sanskrit": "उपाहृत्य गुरोरर्थं त्वदायत्तमरिंदम।\nसमयेनेह राजेन्द्र पुनरेष्यामि ते वशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101990, "chapter_id": 3201, "verse_number": "१४-५७-१०", "content_sanskrit": "सत्यं ते प्रतिजानामि नात्र मिथ्या कथञ्चन।\nअनृतं नोक्तपूर्वं मे स्वैरेष्वपि कुतोऽन्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101991, "chapter_id": 3201, "verse_number": "१४-५७-११x", "content_sanskrit": "सौदास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101992, "chapter_id": 3201, "verse_number": "१४-५७-११", "content_sanskrit": "यदि मत्तस्तवायत्तो गुर्वर्थः कृत एव सः।\nयदि चास्ति प्रतिग्राह्यं साम्प्रतं तद्वदस्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101993, "chapter_id": 3201, "verse_number": "१४-५७-१२x", "content_sanskrit": "उदङ्क उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101994, "chapter_id": 3201, "verse_number": "१४-५७-१२", "content_sanskrit": "प्रतिग्राह्यो मतो मे त्वं सदैव पुरुषर्षभ।\nसोहं त्वामनुसम्प्राप्तो भिक्षितुं मणिकुण्डले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101995, "chapter_id": 3201, "verse_number": "१४-५७-१३x", "content_sanskrit": "सौदास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2101996, "chapter_id": 3201, "verse_number": "१४-५७-१३", "content_sanskrit": "पत्न्यास्ते मम विप्रर्षे उचिते मणिकुण्डले।\nवरयार्थं त्वमन्यं वै तं ते दास्यामि सुव्रत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2101997, "chapter_id": 3201, "verse_number": "१४-५७-१४x", "content_sanskrit": "उदङ्ग उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2101998, "chapter_id": 3201, "verse_number": "१४-५७-१४", "content_sanskrit": "अलं ते व्यपदेशेन प्रमाणं यदि ते वयम्।\nप्रयच्छ कुण्डले मह्यं सत्यवाग्भव पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2101999, "chapter_id": 3201, "verse_number": "१४-५७-१५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2102000, "chapter_id": 3201, "verse_number": "१४-५७-१५", "content_sanskrit": "इत्युक्तस्त्वब्रवीद्राजा तमुदङ्कं पुनर्वचः।\nगच्छ मद्वचनाद्देवीं ब्रूहि देहीति सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2102001, "chapter_id": 3201, "verse_number": "१४-५७-१६", "content_sanskrit": "सैवमुक्ता त्वया नूनं मद्वाक्येन शुचिव्रता।\nप्रदास्यति द्विजश्रेष्ठ कुण्डले ते न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2102002, "chapter_id": 3201, "verse_number": "१४-५७-१७x", "content_sanskrit": "उदङ्क उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2102003, "chapter_id": 3201, "verse_number": "१४-५७-१७", "content_sanskrit": "क्व पत्नी भवतः शक्या मया द्रष्टुं नरेश्वर।\nस्वयं वाऽपि भवान्पत्नीं किमर्थं नोपसर्पति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2102004, "chapter_id": 3201, "verse_number": "१४-५७-१८x", "content_sanskrit": "सौदास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2102005, "chapter_id": 3201, "verse_number": "१४-५७-१८", "content_sanskrit": "तां द्रक्ष्यति भवानद्य कास्मिंश्चिद्वननिर्झरे।\nषष्ठे काले न हि मया सा शक्या द्रष्टुमद्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2102006, "chapter_id": 3201, "verse_number": "१४-५७-१९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2102007, "chapter_id": 3201, "verse_number": "१४-५७-१९", "content_sanskrit": "उदङ्कस्तु तथोक्तः स जगाम भरतर्षभ।\nमदयन्तीं च दृष्ट्वा स ज्ञापयत्स्वप्रयोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2102008, "chapter_id": 3201, "verse_number": "१४-५७-२०", "content_sanskrit": "सौदासवचनं श्रुत्वा ततः सा पृथुलोचना।\nप्रत्युवाच महावुद्धिमुदङ्कं जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2102009, "chapter_id": 3201, "verse_number": "१४-५७-२१", "content_sanskrit": "एवमेतन्महाब्रह्मन्नानृतं वदसेऽनघ।\nअभिज्ञानं तु किञ्चित्त्वं समानयितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2102010, "chapter_id": 3201, "verse_number": "१४-५७-२२", "content_sanskrit": "इमे हि दिव्ये मणिकुण्डले मे\nदेवाश्च यक्षाश्च महर्षयश्च।\nतैस्तैरुपायैरपहर्तुकामा-\nश्छिद्रेषु नित्यं परितर्कयन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2102011, "chapter_id": 3201, "verse_number": "१४-५७-२३", "content_sanskrit": "निक्षिप्तमेतद्भुवि पन्नगास्तु\nरत्नं समासाद्य परामृशेयुः।\nयक्षास्तथोच्छिष्टधृतं सुराश्च\nनिद्रावशाद्वा परिधर्षयेयुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2102012, "chapter_id": 3201, "verse_number": "१४-५७-२४", "content_sanskrit": "छिद्रेष्वेतेष्विमे नित्यं ह्रियते द्विजसत्तम।\nदेवराक्षसनागानामप्रमत्तेनि धार्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2102013, "chapter_id": 3201, "verse_number": "१४-५७-२५", "content_sanskrit": "एते दिवापि भासेते रात्रौ च द्विजसत्तम।\nनक्तं नक्षत्रताराणां प्रभामाक्षिप्य वर्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2102014, "chapter_id": 3201, "verse_number": "१४-५७-२६", "content_sanskrit": "एते ह्यामुच्य भगन्क्षुत्पिपासाभयं कुतः।\nविषाग्निश्वापदेभ्यश्च भयं जातु न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2102015, "chapter_id": 3201, "verse_number": "१४-५७-२७", "content_sanskrit": "ह्रस्वेन चैते आमुक्ते भवतो ह्रस्वके तदा।\nअनुरूपेण चामुक्ते जायेते तत्प्रमाणके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2102016, "chapter_id": 3201, "verse_number": "१४-५७-२८", "content_sanskrit": "एवंविधे ममैते वै कुण्डले परमार्चिते।\nत्रिषु लोकेषु विज्ञाते तदभिज्ञानमानय॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2102017, "chapter_id": 3201, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि सप्तपञ्चाशोऽध्यायः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]