[{"id": 2044167, "chapter_id": 1992, "verse_number": "६-४१-०x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2044168, "chapter_id": 1992, "verse_number": "६-४१-१", "content_sanskrit": "ये शास्त्रविधिमुत्सृज्य यजन्ते श्रद्धयान्विता।\nतेषां निष्ठा तु का कृष्ण सत्वमाहो सजस्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2044169, "chapter_id": 1992, "verse_number": "६-४१-२x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2044170, "chapter_id": 1992, "verse_number": "६-४१-२", "content_sanskrit": "त्रिविधा भवति श्रद्धा देहिनां सा स्वभावजा।\nसात्विकी राजसी चैव तामसी चेति तां श्रृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2044171, "chapter_id": 1992, "verse_number": "६-४१-३", "content_sanskrit": "सत्वानुरूपा सर्वस्य श्रद्धा भवति भारत।\nश्रद्धामयोऽयं पुरुषो यो यच्छ्रद्धः स एव सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2044172, "chapter_id": 1992, "verse_number": "६-४१-४", "content_sanskrit": "यजन्ते सात्विका देवान्यक्षरक्षांसि राजसाः।\nप्रेतान्भूतगणांश्चान्ये यजन्ते तामसा जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2044173, "chapter_id": 1992, "verse_number": "६-४१-५", "content_sanskrit": "अशास्त्रविहितं घोरं तप्यन्ते ये तपो जनाः ।\nदम्भाहङ्कारसंयुक्ताः कामरागबलान्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2044174, "chapter_id": 1992, "verse_number": "६-४१-६", "content_sanskrit": "कर्शयन्तः शरीरस्थं भूतग्राममचेतसः।\nमां चैवान्तः शरीरस्थं तान्विद्ध्यासुरनिश्चयान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2044175, "chapter_id": 1992, "verse_number": "६-४१-७", "content_sanskrit": "आहारस्त्वपि सर्वस्य त्रिविधो भवति प्रियः ।\nयज्ञस्तपस्तथा दानं तेषां भेदमिमं श्रृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2044176, "chapter_id": 1992, "verse_number": "६-४१-८", "content_sanskrit": "आयुःसत्वबलारोग्यसुखप्रीतिविवर्धनाः ।\nरस्याःस्रिग्धाः स्थिरा हृद्या आहाराःसात्विकप्रियाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2044177, "chapter_id": 1992, "verse_number": "६-४१-९", "content_sanskrit": "कट्वम्ललवणात्युष्णतीक्ष्णरूक्षविदाहिनः ।\nआहारा राजसस्येष्टा दुःखशोकामयप्रदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2044178, "chapter_id": 1992, "verse_number": "६-४१-१०", "content_sanskrit": "यातयामं गतरसं पूति पर्युषितं च यत्।\nउच्छिष्टमपि चामेध्यं भोजनं तामसप्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2044179, "chapter_id": 1992, "verse_number": "६-४१-११", "content_sanskrit": "अफलाकाङ्क्षिभिर्यज्ञो विधिदृष्टो य इज्यते।\nयष्टव्यमेवेति मनः समाधाय स सात्विकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2044180, "chapter_id": 1992, "verse_number": "६-४१-१२", "content_sanskrit": "अभिसंघाय तु फलं दम्भार्थमपि चैव यत्।\nइज्यते भरतश्रेष्ठ तं यज्ञं विद्धि राजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2044181, "chapter_id": 1992, "verse_number": "६-४१-१३", "content_sanskrit": "विधिहीनमसृष्टान्नं मन्त्रहीनमदक्षिणम् ।\nश्रद्धाविरहितं यज्ञं तामसं परिचक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2044182, "chapter_id": 1992, "verse_number": "६-४१-१४", "content_sanskrit": "देवद्विजगुरुप्राज्ञपूजनं शौचमार्जवम् ।\nब्रह्मचर्यमहिंसा च शारीरं तप उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2044183, "chapter_id": 1992, "verse_number": "६-४१-१५", "content_sanskrit": "अनुद्वेगकरं वाक्यं सत्यं प्रियहितं च यत् ।\nस्वाध्यायाभ्यसनं चैव वाङ्भयं तप उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2044184, "chapter_id": 1992, "verse_number": "६-४१-१६", "content_sanskrit": "मनःप्रसादः सम्यत्वं मौनमात्मविनिग्रहः ।\nभावसंशुद्धिरित्येतत्तपो मानसमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2044185, "chapter_id": 1992, "verse_number": "६-४१-१७", "content_sanskrit": "श्रद्धया परया तप्तं तपस्तत्रिविधं नरैः ।\nअफलाकाङ्क्षिभिर्युक्तैः सात्विकं परिचक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2044186, "chapter_id": 1992, "verse_number": "६-४१-१८", "content_sanskrit": "सत्कारमानपूजाराथं तपो दम्भेन चैव यत् ।\nक्रियते तदिह प्रोक्तं राजसं चलमध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2044187, "chapter_id": 1992, "verse_number": "६-४१-१९", "content_sanskrit": "मूढग्राहेणात्मनो यत्पीडया क्रियते तपः ।\nपरस्योत्सादनार्थं वा तत्तामसमुदाहृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2044188, "chapter_id": 1992, "verse_number": "६-४१-२०", "content_sanskrit": "दातव्यमिति यद्दानं दीयतेऽनुपकारिणे ।\nदेशे काले च पात्रे च तद्दानं सात्विकं स्मृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2044189, "chapter_id": 1992, "verse_number": "६-४१-२१", "content_sanskrit": "यत्तु प्रत्युपकारार्थं फलमुद्दिश्य वा पुनः ।\nदीयते च परिक्लिष्टं तद्दानं राजसं स्मृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2044190, "chapter_id": 1992, "verse_number": "६-४१-२२", "content_sanskrit": "अदेशकाले यद्दानमपात्रेभ्यश्च दीयते।\nअसत्कृतमवज्ञातं तत्तामसमुदाहृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2044191, "chapter_id": 1992, "verse_number": "६-४१-२३", "content_sanskrit": "ओंतत्सदिति निर्देशो ब्रह्मणस्त्रिविधः स्मृताः ।\nब्राह्मणास्तेन वेदाश्च यज्ञाश्च विहिताः पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2044192, "chapter_id": 1992, "verse_number": "६-४१-२४", "content_sanskrit": "तस्मादोमित्युदाहृत्य यज्ञदानतपःक्रियाः ।\nप्रवर्तन्ते विधानोक्ताः सततं ब्रह्मवादिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2044193, "chapter_id": 1992, "verse_number": "६-४१-२५", "content_sanskrit": "तदित्यनभिसंधाय फलं यज्ञतपःक्रियाः ।\nदानक्रियाश्च विविधाः क्रियन्ते मोक्षकाङ्क्षिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2044194, "chapter_id": 1992, "verse_number": "६-४१-२६", "content_sanskrit": "सद्भावे साधुभावे च सदित्येतत्प्रुयुज्यते।\nप्रशस्ते कर्मणि तथा सच्छब्दः पार्थ युज्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2044195, "chapter_id": 1992, "verse_number": "६-४१-२७", "content_sanskrit": "यज्ञे तपसि दाने च स्थितिः सदिति चोच्यते ।\nकर्म चैव तदर्थीयं सादित्येवाभिधीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2044196, "chapter_id": 1992, "verse_number": "६-४१-२८", "content_sanskrit": "अश्रद्धया हुतं दत्तं तपस्तप्तं कृतं च यत् ।\nअसदित्युच्यते पार्थ न च तत्प्रेत्य नो इह ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2044197, "chapter_id": 1992, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भगवद्गीतापर्वणि एकचत्वारिंशोऽध्यायः ॥\nइति श्रीमद्भगवद्गीतासूपनिषत्सु ब्रह्मविद्यायां योगशास्त्रे श्रीकृष्णार्जुनसंवादे श्रद्धात्रयबिभागयोगोनाम सप्तदशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]