[{"id": 2113683, "chapter_id": 3444, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2113684, "chapter_id": 3444, "verse_number": "", "content_sanskrit": "आनीय सुहृदः सर्वान् क्षत्तारमिदमब्रवीत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2113685, "chapter_id": 3444, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2113686, "chapter_id": 3444, "verse_number": "१", "content_sanskrit": "श्राद्धं दास्यामि पाण्डोस्तु स्वप्ने दर्शितवान् हि माम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2113687, "chapter_id": 3444, "verse_number": "२", "content_sanskrit": "अस्थीनि तीरे गङ्गाया गाङ्गेनाप्युदकेन च ।\nप्लावयित्वा महानद्यां जाह्नव्यां वै महामते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2113688, "chapter_id": 3444, "verse_number": "३", "content_sanskrit": "त्रिलोकपावनीं पुण्यां गत्वा त्वं स्वर्गगामिनीम् ।\nपाण्डोर्विदुर सर्वाणि प्रेतकार्याणि कारय \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2113689, "chapter_id": 3444, "verse_number": "४", "content_sanskrit": "राजवद् राजसिंहस्य माद्र्याश्चैव विशेषतः ।\nपशून् वासांसि रत्नानि धनानि विविधानि च\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2113690, "chapter_id": 3444, "verse_number": "५", "content_sanskrit": "पाण्डोः प्रयच्छ माद्र्याश्च येभ्यो यावच्च वाञ्छितम् ।\nयथा च कुन्ती सत्कारं कुर्यान्माद्र्यास्तथा कुरु \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2113691, "chapter_id": 3444, "verse_number": "६", "content_sanskrit": "यथा न वायुर्नादित्यः पश्येत् कुन्तीं सुसंवृताम् ।\nन शोच्यः पाण्डुरस्माकं प्रशस्यः स नराधिपः ।\nयस्य पञ्च सुता वीरा जाताः सुरसुतोपमाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2113692, "chapter_id": 3444, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2113693, "chapter_id": 3444, "verse_number": "७", "content_sanskrit": "विदुरः स तथेत्युक्त्वा भीष्मेण सह भारत ।\nपाण्डोरस्थीनि संस्कार्य देशे परमसम्मते \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2113694, "chapter_id": 3444, "verse_number": "८", "content_sanskrit": "ब्राह्मणैः सहिताः पौरा गङ्गां जग्मुः सहस्रशः ।\nततस्तु नगरात् तूर्णमाज्यहेमपुरस्कृताः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2113695, "chapter_id": 3444, "verse_number": "९", "content_sanskrit": "निर्हृताः पावका दीप्ताः पाण्डो राजन् पुरोहितैः ।\nअथैतमार्तवैर्गन्धैर्माल्यैश्च विविधैर्वरैः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2113696, "chapter_id": 3444, "verse_number": "१०", "content_sanskrit": "शिबिकास्थमलञ्चक्रुर्वस्त्रैराच्छाद्य सर्वशः ।\nतं तथा शोभितं माल्यैर्विविधैश्च महाधनैः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2113697, "chapter_id": 3444, "verse_number": "११", "content_sanskrit": "अमात्या ज्ञातयश्चैव सुहृदश्चोपतस्थिरे ।\nनृसिंहं नरयुक्तेन परमालङ्कृतेन तम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2113698, "chapter_id": 3444, "verse_number": "१२", "content_sanskrit": "अवहन् यानमुख्येन सह माद्र्या सुसम्भृतम् ।\nपाण्डरेणातपत्रेण चामरव्यजनेन च \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2113699, "chapter_id": 3444, "verse_number": "१३", "content_sanskrit": "सर्ववादित्रनादैश्च समलञ्चक्रिरे ततः ।\nततः सर्वाणि रत्नानि बहूनि शतशो नराः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2113700, "chapter_id": 3444, "verse_number": "१४", "content_sanskrit": "प्रददुः काङ्क्षमाणेभ्यः पाण्डोस्तत्रौर्ध्वदैहिके ।\nअच्छिद्राणि च शुभ्राणि पाण्डराणि बहूनि च \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2113701, "chapter_id": 3444, "verse_number": "१५", "content_sanskrit": "आजह्रुः कौरवस्यार्थे वासांसि रुचिराणि च ।\nयाजकैः शुक्लवासोभिर्हूयमाना हुताशनाः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2113702, "chapter_id": 3444, "verse_number": "१६", "content_sanskrit": "अगच्छन्नग्रतस्तस्य दीप्यमानाः स्वलङ्कृताः ।\nब्राह्मणाः क्षत्रिया वैश्याः शूद्राश्चैव सहस्रशः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2113703, "chapter_id": 3444, "verse_number": "१७", "content_sanskrit": "रुदन्तः शोकसन्तप्ता अनुजग्मुर्नराधिपम् ।\nअयमस्मानपाहाय दुःखं चाधाय शाश्वतम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2113704, "chapter_id": 3444, "verse_number": "१८", "content_sanskrit": "कृत्वाऽनाथान् परो नाथान् क्व यास्यति नराधिपः ।\nक्रोशन्तः पाण्डवाः सर्वे भीष्मो विदुर एव च \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2113705, "chapter_id": 3444, "verse_number": "१९", "content_sanskrit": "बाह्लीकः सोमदत्तश्च तथा भूरिश्रवा नृपाः ।\nअन्योन्यं वै समाश्लिष्य अनुजग्मुः सहस्रशः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2113706, "chapter_id": 3444, "verse_number": "२०", "content_sanskrit": "रमणीये वनोद्देशे गङ्गातीरे समे शुभे ।\nवासयामासुरथ तां शिबिकां सत्यवादिनः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2113707, "chapter_id": 3444, "verse_number": "२१", "content_sanskrit": "सभार्यस्य नृसिंहस्य पाण्डोरक्लिष्टकर्मणः ।\nततस्तस्य शरीरं तत् सर्वगन्धनिषेवितम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2113708, "chapter_id": 3444, "verse_number": "२२", "content_sanskrit": "शुचिकालेयकादिग्धं मुख्यस्नानाधिवासितम् ।\nक्षीरेण मधुनाऽऽज्येन पाण्डवाः शोककर्शिताः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2113709, "chapter_id": 3444, "verse_number": "२३", "content_sanskrit": "पर्यषिञ्चन् जलेनाशु शातकुम्भमयैर्घटैः ।\nअस्थीनि याजकाः सर्वे गङ्गायामौर्ध्वदैहिके \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2113710, "chapter_id": 3444, "verse_number": "२४", "content_sanskrit": "चन्दनेनापि मुख्येन शुक्लेन समलेपयन् ।\nकालागरुविमिश्रेण तथा तुङ्गरसेन च \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2113711, "chapter_id": 3444, "verse_number": "२५", "content_sanskrit": "आच्छन्नः सह वासोभिर्जीवन्निव नरर्षभः ।\nअथैनं देशजैः शुभ्रैर्वासोभिः समयोजयन् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2113712, "chapter_id": 3444, "verse_number": "२६", "content_sanskrit": "शुशुभे पुरुषव्याघ्रो महार्हशयनोचितः ।\nहयमेधाग्निना सर्वे याजकाः सपुरोहिताः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2113713, "chapter_id": 3444, "verse_number": "२७", "content_sanskrit": "वेदोक्तेन विधानेन क्रियां चक्रुः समन्त्रकम् ।\nयाजकैरभ्यनुज्ञाताः प्रेतकर्मणि निष्ठितैः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2113714, "chapter_id": 3444, "verse_number": "२८", "content_sanskrit": "घृतावसिक्तं राजानं सह माद्र्या स्वलङ्कृतम् ।\nतुङ्गपद्मकमिश्रेण चन्दनेन सुगन्धिना \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2113715, "chapter_id": 3444, "verse_number": "२९", "content_sanskrit": "सरलं देवदारुं च गुग्गुलुं लाक्षया सह ।\nरक्तचन्दनकाष्ठैश्च हरिवेरैरुशीरजैः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2113716, "chapter_id": 3444, "verse_number": "३०", "content_sanskrit": "अन्यैश्च विविधैर्गन्धै राजानं समदाहयन् ।\nघृतपूर्णैस्तथा कुम्भैर्विधिना समदाहयन् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2113717, "chapter_id": 3444, "verse_number": "३१", "content_sanskrit": "ततस्तयोः शरीरे तु दृष्ट्वा मोहवशं गताः ।\nहाहा पुत्रेति कौसल्या पतिता सहसा भुवि\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2113718, "chapter_id": 3444, "verse_number": "३२", "content_sanskrit": "तां प्रेक्ष्य पतितामार्तां पौरजानपदा जनाः ।\nरुरुदुः सस्वरं सर्वे राजभक्त्या कृपान्विताः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2113719, "chapter_id": 3444, "verse_number": "३३", "content_sanskrit": "श्वादीनि चार्तनादेन सर्वाणि च विचुक्रुशुः ।\nमानुषैः सह भूतानि तिर्यग्योनिगतान्यपि \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2113720, "chapter_id": 3444, "verse_number": "३५", "content_sanskrit": "तथा भीष्मः शान्तनवो विदुरश्च महामतिः ।\nज्ञातयः कौरवाश्चैव प्राणदन् भृशदुःखिताः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2113721, "chapter_id": 3444, "verse_number": "३६", "content_sanskrit": "चुक्रुशुः पाण्डवाः सर्वे धृतराष्ट्रश्च भारत ।\nरमणीये ततो देशे गङ्गातीरे समे शुभे\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2113722, "chapter_id": 3444, "verse_number": "३७", "content_sanskrit": "प्रक्षिप्य कुण्डके तानि भूमौ सन्निहितं कृशम् ।\nशोचन्त ज्ञातयः सर्वे दृष्ट्वाऽस्थीनि पुनःपुनः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2113723, "chapter_id": 3444, "verse_number": "३८", "content_sanskrit": "तथा भीष्मोऽथ विदुरो राजा च सह बान्धवैः ।\nउदकं चक्रिरे पाण्डोः सर्वाश्च कुरुयोषितः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2113724, "chapter_id": 3444, "verse_number": "३९", "content_sanskrit": "कृतोदकांस्तानादाय पाण्डवान् शोककर्शितान् ।\nसर्वाः प्रकृतयो राजन् शोचन्त्यः पर्यवारयन् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2113725, "chapter_id": 3444, "verse_number": "४०", "content_sanskrit": "यथा च पाण्डवा भूमौ शेरते सह बान्धवाः ।\nतथैव नागरा राजन् शिश्यिरे ब्राह्मणादयः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2113726, "chapter_id": 3444, "verse_number": "४१", "content_sanskrit": "तदनानन्दमस्वस्थमाकुमारमहृष्टवत् ।\nबभूव पाण्डवैः सार्धं नगरं द्वादश क्षपाः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2113727, "chapter_id": 3444, "verse_number": "१२३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nत्रयोविंशत्यधिकशततमोऽध्यायः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2113728, "chapter_id": 3444, "verse_number": "७१", "content_sanskrit": "॥ इति सम्भवपर्वणि एकसप्ततितमोऽध्यायः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2113729, "chapter_id": 3444, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]