[{"id": 5000521000, "chapter_id": 9521, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे चतुर्दशाधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000521001, "chapter_id": 9521, "verse_number": "६-११४-१", "content_sanskrit": "तमुवाच महाप्राज्ञः सोऽभिवाद्य प्लवङ्गमः।\nरामं कमलपत्राक्षं वरं सर्वधनुष्मताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000521002, "chapter_id": 9521, "verse_number": "६-११४-२", "content_sanskrit": "यन्निमित्तोऽयमारम्भः कर्मणां यः फलोदयः।\nतां देवीं शोकसंतप्तां द्रष्टुमर्हसि मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000521003, "chapter_id": 9521, "verse_number": "६-११४-३", "content_sanskrit": "सा हि शोकसमाविष्टा बाष्पपर्याकुलेक्षणा।\nमैथिली विजयं श्रुत्वा द्रष्टुं त्वामभिकांक्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000521004, "chapter_id": 9521, "verse_number": "६-११४-४", "content_sanskrit": "पूर्वकात् प्रत्ययाच्चाहमुक्तो विश्वस्तया तया।\nद्रष्टुमिच्छामि भर्तारमिति पर्याकुलेक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000521005, "chapter_id": 9521, "verse_number": "६-११४-५", "content_sanskrit": "एवमुक्तो हनुमता रामो धर्मभृतां वरः।\nआगच्छत् सहसा ध्यानमीषद‍्बाष्पपरिप्लुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000521006, "chapter_id": 9521, "verse_number": "६-११४-६", "content_sanskrit": "स दीर्घमभिनिःश्वस्य जगतीमवलोकयन्।\nउवाच मेघसंकाशं विभीषणमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000521007, "chapter_id": 9521, "verse_number": "६-११४-७", "content_sanskrit": "दिव्याङ्गरागां वैदेहीं दिव्याभरणभूषिताम्।\nइह सीतां शिरःस्नातामुपस्थापय मा चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000521008, "chapter_id": 9521, "verse_number": "६-११४-८", "content_sanskrit": "एवमुक्तस्तु रामेण त्वरमाणो विभीषणः।\nप्रविश्यान्तःपुरं सीतां स्त्रीभिः स्वाभिरचोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000521009, "chapter_id": 9521, "verse_number": "६-११४-९", "content_sanskrit": "ततः सीतां महाभागां दृष्ट्वोवाच विभीषणः।\nमूर्ध्नि बद्धाञ्जलिः श्रीमान् विनीतो राक्षसेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000521010, "chapter_id": 9521, "verse_number": "६-११४-१०", "content_sanskrit": "दिव्याङ्गरागा वैदेहि दिव्याभरणभूषिता।\nयानमारोह भद्रं ते भर्ता त्वां द्रष्टुमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000521011, "chapter_id": 9521, "verse_number": "६-११४-११", "content_sanskrit": "एवमुक्ता तु वैदेही प्रत्युवाच विभीषणम्।\nअस्नात्वा द्रष्टुमिच्छामि भर्तारं राक्षसेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000521012, "chapter_id": 9521, "verse_number": "६-११४-१२", "content_sanskrit": "तस्यास्तद् वचनं श्रुत्वा प्रत्युवाच विभीषणः।\nयथाऽऽह रामो भर्ता ते तत् तथा कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000521013, "chapter_id": 9521, "verse_number": "६-११४-१३", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा मैथिली पतिदेवता।\nभर्तृभक्त्यावृता साध्वी तथेति प्रत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000521014, "chapter_id": 9521, "verse_number": "६-११४-१४", "content_sanskrit": "ततः सीतां शिरःस्नातां संयुक्तां प्रतिकर्मणा।\nमहार्हाभरणोपेतां महार्हाम्बरधारिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000521015, "chapter_id": 9521, "verse_number": "६-११४-१५", "content_sanskrit": "आरोप्य शिबिकां दीप्तां परार्घ्याम्बरसंवृताम्।\nरक्षोभिर्बहुभिर्गुप्तामाजहार विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000521016, "chapter_id": 9521, "verse_number": "६-११४-१६", "content_sanskrit": "सोऽभिगम्य महात्मानं ज्ञात्वापि ध्यानमास्थितम्।\nप्रणतश्च प्रहृष्टश्च प्राप्तां सीतां न्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000521017, "chapter_id": 9521, "verse_number": "६-११४-१७", "content_sanskrit": "तामागतामुपश्रुत्य रक्षोगृहचिरोषिताम्।\nरोषं हर्षं च दैन्यं च राघवः प्राप शत्रुहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000521018, "chapter_id": 9521, "verse_number": "६-११४-१८", "content_sanskrit": "ततो यानगतां सीतां सविमर्शं विचारयन्।\nविभीषणमिदं वाक्यमहृष्टो राघवोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000521019, "chapter_id": 9521, "verse_number": "६-११४-१९", "content_sanskrit": "राक्षसाधिपते सौम्य नित्यं मद्विजये रत।\nवैदेही संनिकर्षं मे क्षिप्रं समभिगच्छतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000521020, "chapter_id": 9521, "verse_number": "६-११४-२०", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा राघवस्य विभीषणः।\nतूर्णमुत्सारणं तत्र कारयामास धर्मवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000521021, "chapter_id": 9521, "verse_number": "६-११४-२१", "content_sanskrit": "कञ्चुकोष्णीषिणस्तत्र वेत्रझर्झरपाणयः।\nउत्सारयन्तस्तान् योधान् समन्तात् परिचक्रमुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000521022, "chapter_id": 9521, "verse_number": "६-११४-२२", "content_sanskrit": "ऋक्षाणां वानराणां च राक्षसानां च सर्वशः।\nवृन्दान्युत्सार्यमाणानि दूरमुत्तस्थुरन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000521023, "chapter_id": 9521, "verse_number": "६-११४-२३", "content_sanskrit": "तेषामुत्सार्यमाणानां निःस्वनः सुमहानभूत्।\nवायुनोद्‍धूयमानस्य सागरस्येव निःस्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000521024, "chapter_id": 9521, "verse_number": "६-११४-२४", "content_sanskrit": "उत्सार्यमाणांस्तान् दृष्ट्वा समन्ताज्जातसम्भ्रमान्।\nदाक्षिण्यात्तदमर्षाच्च वारयामास राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000521025, "chapter_id": 9521, "verse_number": "६-११४-२५", "content_sanskrit": "संरम्भाच्चाब्रवीद् रामश्चक्षुषा प्रदहन्निव।\nविभीषणं महाप्राज्ञं सोपालम्भमिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000521026, "chapter_id": 9521, "verse_number": "६-११४-२६", "content_sanskrit": "किमर्थं मामनादृत्य क्लिश्यतेऽयं त्वया जनः।\nनिवर्तयैनमुद्वेगं जनोऽयं स्वजनो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000521027, "chapter_id": 9521, "verse_number": "६-११४-२७", "content_sanskrit": "न गृहाणि न वस्त्राणि न प्राकारस्तिरस्क्रिया।\nनेदृशा राजसत्कारा वृत्तमावरणं स्त्रियाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000521028, "chapter_id": 9521, "verse_number": "६-११४-२८", "content_sanskrit": "व्यसनेषु न कृच्छ्रेषु न युद्धेषु स्वयंवरे।\nन क्रतौ नो विवाहे वा दर्शनं दूष्यते स्त्रियाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000521029, "chapter_id": 9521, "verse_number": "६-११४-२९", "content_sanskrit": "सैषा विपद‍्गता चैव कृच्छ्रेण च समन्विता।\nदर्शने नास्ति दोषोऽस्या मत्समीपे विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000521030, "chapter_id": 9521, "verse_number": "६-११४-३०", "content_sanskrit": "विसृज्य शिबिकां तस्मात् पद्भ्यामेवापसर्पतु।\nसमीपे मम वैदेहीं पश्यन्त्वेते वनौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000521031, "chapter_id": 9521, "verse_number": "६-११४-३१", "content_sanskrit": "एवमुक्तस्तु रामेण सविमर्शो विभीषणः।\nरामस्योपानयत् सीतां संनिकर्षं विनीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000521032, "chapter_id": 9521, "verse_number": "६-११४-३२", "content_sanskrit": "ततो लक्ष्मणसुग्रीवौ हनूमांश्च प्लवङ्गमः।\nनिशम्य वाक्यं रामस्य बभूवुर्व्यथिता भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000521033, "chapter_id": 9521, "verse_number": "६-११४-३३", "content_sanskrit": "कलत्रनिरपेक्षैश्च इङ्गितैरस्य दारुणैः।\nअप्रीतमिव सीतायां तर्कयन्ति स्म राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000521034, "chapter_id": 9521, "verse_number": "६-११४-३४", "content_sanskrit": "लज्जया त्ववलीयन्ती स्वेषु गात्रेषु मैथिली।\nविभीषणेनानुगता भर्तारं साभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000521035, "chapter_id": 9521, "verse_number": "६-११४-३५", "content_sanskrit": "विस्मयाच्च प्रहर्षाच्च स्नेहाच्च पतिदेवता।\nउदैक्षत मुखं भर्तुः सौम्यं सौम्यतरानना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000521036, "chapter_id": 9521, "verse_number": "६-११४-३६", "content_sanskrit": "अथ समपनुदन्मनःक्लमं सा\nसुचिरमदृष्टमुदीक्ष्य वै प्रियस्य।\nवदनमुदितपूर्णचन्द्रकान्तं\nविमलशशाङ्कनिभानना तदाऽऽसीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000521037, "chapter_id": 9521, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे चतुर्दशाधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]