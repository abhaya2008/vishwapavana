[{"id": 7006229000, "chapter_id": 26229, "verse_number": "२-५७-१", "content_sanskrit": "जैमिनिरुवाच ततः शुष्कसुमित्राद्या मुनयः शंसितव्रताः ।\nययुर्दिदृक्षवो रामं महेन्द्रमचलं प्रति ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006229001, "chapter_id": 26229, "verse_number": "२-५७-२", "content_sanskrit": "अतीत्य सुबहून्देशान्वनानि सरितस्तथा ।\nआसेदुरचलश्रेष्ठं क्रमेण मुनिपुङ्गवाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006229002, "chapter_id": 26229, "verse_number": "२-५७-३", "content_sanskrit": "तमारुह्य शनैस्तस्यख्यातमाश्रममण्डलम् ।\nप्रशान्तक्रूरसत्त्वाढ्यं शुभं मध्ये तपोवनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006229003, "chapter_id": 26229, "verse_number": "२-५७-४", "content_sanskrit": "सर्वर्त्तुफलपुष्पाढ्यतरुखण्डमनोहरम् ।\nस्निग्धच्छायमनौपम्यं स्वामोदिसुखमारुतम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006229004, "chapter_id": 26229, "verse_number": "२-५७-५", "content_sanskrit": "तं तदाश्रममासाद्य ब्रह्मघोषेण नादितम् ।\nविविशुर्त्दृष्टमनसो यथावृद्धपुरस्सरम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006229005, "chapter_id": 26229, "verse_number": "२-५७-६", "content_sanskrit": "ब्रह्मासने सुखासीनं मृदुकृष्णाजिनोत्तरे ।\nशिष्यैः परिवृतं शान्तं ददृशुस्ते तपोधनाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006229006, "chapter_id": 26229, "verse_number": "२-५७-७", "content_sanskrit": "कालाग्निमिव लोकांस्त्रीन्दग्ध्वा पूर्वं निजेच्छया ।\nतद्दोषशान्त्यै तपसि प्रवृत्तमिव्देहिनम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006229007, "chapter_id": 26229, "verse_number": "२-५७-८", "content_sanskrit": "ते समेत्य भृगुश्रेष्ठं विनयाचारशालिनः ।\nववन्दिरे महामौनं भक्तिप्रणतकन्धराः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006229008, "chapter_id": 26229, "verse_number": "२-५७-९", "content_sanskrit": "ततस्तानागतान्दृष्ट्वा मुनीन्भृगुकुलोद्वहः ।\nअर्घपाद्यादिभिः सम्यक्पूजयामास सादरम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006229009, "chapter_id": 26229, "verse_number": "२-५७-१०", "content_sanskrit": "तानासीनान्कृतातिथ्यानृषीन्देशान्तरागतान् ।\nउवाच भृगुशार्दूलः स्मितपूर्वमिदं वचः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006229010, "chapter_id": 26229, "verse_number": "२-५७-११", "content_sanskrit": "स्वागतं वो महाभागा यूयं सर्वे समागताः ।\nकरणीयं किमस्माभिर्वदध्वमविचारितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006229011, "chapter_id": 26229, "verse_number": "२-५७-१२", "content_sanskrit": "ततस्ते मुनयो रामं प्रणम्येदमथाब्रुवन् ।\nअवेह्यस्मान्मुनिश्रेष्ठ गोकर्णनिलयान्मुनीन् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006229012, "chapter_id": 26229, "verse_number": "२-५७-१३", "content_sanskrit": "खनद्भिः सागरैर्भूमिं कस्मिंश्चित्कारणान्तरे ।\nसतीर्थं तन्महाक्षेत्रं पतितं सागरांभसि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006229013, "chapter_id": 26229, "verse_number": "२-५७-१४", "content_sanskrit": "उत्सारितार्मवजलं क्षेत्रं तत्सर्वपावनम् ।\nउपलब्धुमभीप्सामो भवतस्तु न संशयः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006229014, "chapter_id": 26229, "verse_number": "२-५७-१५", "content_sanskrit": "विष्णोरंशेन संजातो भवान्भृगुकुले किल ।\nतस्मात्कर्तुमशक्यं ते त्रैलोक्येऽपि न किञ्चन ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006229015, "chapter_id": 26229, "verse_number": "२-५७-१६", "content_sanskrit": "वाञ्छितार्थप्रदो लोके त्वमेवेत्यनुशुश्रुम ।\nवयं त्वामागताः सर्वे रामैतदभियाचितुम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006229016, "chapter_id": 26229, "verse_number": "२-५७-१७", "content_sanskrit": "स त्वमात्मप्रभावेण क्षेत्रप्रवरमद्य तत् ।\nदातुमर्हसि विप्रेन्द्र समुत्सार्यार्मवोदकम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006229017, "chapter_id": 26229, "verse_number": "२-५७-१८", "content_sanskrit": "राम उवाच एतत्सर्वमशेषण विदितं मे तपोधनाः ।\nकरणीयं च वः कृत्यं मया नात्र विचारणा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006229018, "chapter_id": 26229, "verse_number": "२-५७-१९", "content_sanskrit": "किं तु युष्मदभिप्रेतं कर्म लोके सुदारुणम् ।\nशस्त्रसंग्रहणाच्छक्यं मयापि न तदन्यथा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006229019, "chapter_id": 26229, "verse_number": "२-५७-२०", "content_sanskrit": "दत्तसर्वाभयोऽहं वै न्यस्तशस्त्रः शमान्वितः ।\nतपः समास्थितश्चर्तु प्रागेव पितृ शासनात् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006229020, "chapter_id": 26229, "verse_number": "२-५७-२१", "content_sanskrit": "न जातु शस्त्रग्रहणं करिष्यामीत्यहं पुरा ।\nप्रतिश्रुत्य सतां मध्ये तपः कर्त्तुमिहानघाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006229021, "chapter_id": 26229, "verse_number": "२-५७-२२", "content_sanskrit": "शस्त्रग्रहणसाध्यत्वाद्युष्मदीप्सितवस्तुनः ।\nकिङ्कर्त्तव्यं मयात्रेति मम डोलायते मनः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006229022, "chapter_id": 26229, "verse_number": "२-५७-२३", "content_sanskrit": "शुष्क उपाच ।\nसतां संरक्षणार्थाय शस्त्रसंग्रहणं तु यत् ।\nतन्नच्यावयते सत्यद्यथोक्तं ब्रह्मणा पुरा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006229023, "chapter_id": 26229, "verse_number": "२-५७-२४", "content_sanskrit": "तस्मादस्मद्धितार्थाय भवता ग्राह्यमायुधम् ।\nधर्म एव महांस्तेन चरितस्ते भविष्यति ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006229024, "chapter_id": 26229, "verse_number": "२-५७-२५", "content_sanskrit": "जैमिनिरुवाच एवं संप्रार्थ्यमानस्तु मुनिभिर्भृगुपुङ्गवः ।\nतमनुद्रुत्य मेधावी धर्ममुद्दिश्य केवलम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006229025, "chapter_id": 26229, "verse_number": "२-५७-२६", "content_sanskrit": "स तैः सह मुनिश्रेष्ठो दिशं दक्षिणपश्चिमाम् ।\nसमुद्दिश्य चचौ राजन्द्रष्टुकामः सरित्पतिम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006229026, "chapter_id": 26229, "verse_number": "२-५७-२७", "content_sanskrit": "स सह्यमचलश्रेष्ठमवतीर्य भृगूद्वहः ।\nतत्परं सरितां पत्युस्तीरं प्राप महामनाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006229027, "chapter_id": 26229, "verse_number": "२-५७-२८", "content_sanskrit": "स ददर्श महाभागः परितो मारुताकुलम् ।\nआकरं सर्वरत्नानां पूर्यमाणमनारतम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006229028, "chapter_id": 26229, "verse_number": "२-५७-२९", "content_sanskrit": "अपरिज्ञेयगांभीर्यं महातामिव मानसम् ।\nदुष्पारपारं सर्वस्य विविधग्रहसंहतिम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006229029, "chapter_id": 26229, "verse_number": "२-५७-३०", "content_sanskrit": "अप्रधृष्य तमं लोके धातारमिव केवलम् ।\nआत्मानमिव चात्मत्वे न्यक्कृताखिलमुद्धतम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006229030, "chapter_id": 26229, "verse_number": "२-५७-३१", "content_sanskrit": "आश्रयं सर्वसत्त्वानामापगानां च पार्थिवः ।\nअत्यर्थचपलोत्तुगतरङ्गशतमालिनम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006229031, "chapter_id": 26229, "verse_number": "२-५७-३२", "content_sanskrit": "उपान्तोपलसंघातकुहरान्तरसंश्रयात् ।\nविशीर्यमाणलहरीशतफेनौघसोभितम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006229032, "chapter_id": 26229, "verse_number": "२-५७-३३", "content_sanskrit": "गंभीरघोषं जलधिं पश्यन्मुनिगणैः सह ।\nसंसेव्यमानस्तरलैर्लहरीकणशीतलैः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006229033, "chapter_id": 26229, "verse_number": "२-५७-३४", "content_sanskrit": "मुहूर्त्तमिव राजेन्द्र तीरेनदनदीपतेः ।\nविशश्रमे महाबाहुर्द्रष्टुकामः प्रचेतसम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006229034, "chapter_id": 26229, "verse_number": "२-५७-३५", "content_sanskrit": "ततो रामः समुत्थाय दक्षिणाभिमुखः स्थितः ।\nमेघगंभिरया वाचा वरुणं वाक्यमब्रवीत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006229035, "chapter_id": 26229, "verse_number": "२-५७-३६", "content_sanskrit": "अहं मुनिगणैः सार्द्धमागतस्त्वद्दिदृक्षया ।\nतस्मात्स्वरूपधृङ्मह्यं प्रचेतो देहि दर्शनम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006229036, "chapter_id": 26229, "verse_number": "२-५७-३७", "content_sanskrit": "इति श्रुत्वापि तद्वाक्यं वरुणो यादसां पतिः ।\nन चचाल निजस्थानान्नृप धीरतरस्त्वयम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006229037, "chapter_id": 26229, "verse_number": "२-५७-३८", "content_sanskrit": "पुनः पुनश्च रामेण समाहूतोऽपि तोयराट् ।\nन ददौ दर्शनं तस्मै प्रतिवाच्यं च नाभ्यधात् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006229038, "chapter_id": 26229, "verse_number": "२-५७-३९", "content_sanskrit": "अलङ्घनीयं तद्वाक्यं वरुणेनावधीरितम् ।\nअत्यन्तमिति कार्यार्थी विदुषा समुपेक्षितम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006229039, "chapter_id": 26229, "verse_number": "२-५७-४०", "content_sanskrit": "ततः प्रचेतसा वाक्यं मन्यमानोऽवधीरितम् ।\nचुकोप तमभिप्रेक्ष्य रामः शस्त्रभृतां वरः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006229040, "chapter_id": 26229, "verse_number": "२-५७-४१", "content_sanskrit": "संक्षुब्धसागराकारः स तदा स्वबलाश्रयात् ।\nनिस्तोयमर्णवं कर्तुमियेष रुषितो भृशम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006229041, "chapter_id": 26229, "verse_number": "२-५७-४२", "content_sanskrit": "ततो जलमुपस्पृश्य समीपे विजयं धनुः ।\nततः प्रणम्य मनसा शर्वं रामो महाद्धनुः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006229042, "chapter_id": 26229, "verse_number": "२-५७-४३", "content_sanskrit": "गृहीत्वारोपयामास क्रोधसंरक्तलोचनः ।\nअभिमृश्य धनुःश्रेष्ठं सगुणं भृगुसत्तमः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006229043, "chapter_id": 26229, "verse_number": "२-५७-४४", "content_sanskrit": "पश्यतां सर्वभूतानां ज्याघोषमकरोत्तदा ।\nज्याघोषः शुश्रुवे तस्य दिविस्पृगतिनिष्ठुरः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006229044, "chapter_id": 26229, "verse_number": "२-५७-४५", "content_sanskrit": "चचाल निखिलायेन सप्तद्वीपार्मवा मही ।\nततः सरभसं रामश्चापे कालानलोपमम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006229045, "chapter_id": 26229, "verse_number": "२-५७-४६", "content_sanskrit": "सुवर्मपुङ्खं विशिखं संदधे शरसत्तमम् ।\nतस्मिन्नस्त्रं महाघोरं भार्गवं वह्निदैवतम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006229046, "chapter_id": 26229, "verse_number": "२-५७-४७", "content_sanskrit": "युयोज भृगुशार्दूलः समन्त्राभ्यासमोक्षणम् ।\nततश्चचाल वसुधा सशैलवनकानना ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006229047, "chapter_id": 26229, "verse_number": "२-५७-४८", "content_sanskrit": "प्रक्षोभं परमं जग्मुर्देवासुरमहोरगाः ।\nसंधितास्त्रं भृगुश्रेष्ठं क्रोधसंरक्तलोचनम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006229048, "chapter_id": 26229, "verse_number": "२-५७-४९", "content_sanskrit": "दृष्ट्वा संभ्रान्तमनसो बभूवुः सचराचराः ।\nसदिग्दाहभ्रपटलैरभवन्संवृता दिशः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006229049, "chapter_id": 26229, "verse_number": "२-५७-५०", "content_sanskrit": "ववुश्च परुषा वाता रजोव्याप्ता महारवाः ।\nमन्दरश्मिरशीतांशुरभूतसंरक्तमण्डलः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006229050, "chapter_id": 26229, "verse_number": "२-५७-५१", "content_sanskrit": "सोल्कापाताशनिर्वृष्टिर्बभूव रुधिरोदका ।\nकिमेतदिति संभ्रान्ता धूमोद्गारातिभीषणम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006229051, "chapter_id": 26229, "verse_number": "२-५७-५२", "content_sanskrit": "अधिरोपितदिव्यास्त्रं प्रचकर्ष महाशरम् ।\nधनुर्विकर्षमाणं तं स्फुरज्ज्वालाग्रसायकम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006229052, "chapter_id": 26229, "verse_number": "२-५७-५३", "content_sanskrit": "ददृशुर्मुनयो रामं कल्पान्तानलसन्निभम् ।\nआकर्णाकृष्टकोदण्डमण्डलाभ्यं तरस्थितम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006229053, "chapter_id": 26229, "verse_number": "२-५७-५४", "content_sanskrit": "तस्य प्रतिभयाकारं दुष्प्रापमभवद्वपुः ।\nविकृष्टधनुषस्तस्य रूपमुग्रं रवेरिव ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006229054, "chapter_id": 26229, "verse_number": "२-५७-५५", "content_sanskrit": "कल्पान्तेऽभ्युदितस्येव मण्डलं परिवेषितम् ।\nकल्पान्ताग्नसमज्वालाभीषणं स्फुरतो वपुः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006229055, "chapter_id": 26229, "verse_number": "२-५७-५६", "content_sanskrit": "तस्यालक्ष्यत चक्रम्य हरेरिव च मण्डलम् ।\nस्फुरत्क्रोधानलज्वालापरीतस्यातिरौद्रताम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006229056, "chapter_id": 26229, "verse_number": "२-५७-५७", "content_sanskrit": "अवाप विष्णोः स तदा नरसिंहाकृतेरिव ।\nवपुर्विकृष्टचापस्य भृकुटीकुटिलाननम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006229057, "chapter_id": 26229, "verse_number": "२-५७-५८", "content_sanskrit": "रामस्याभूद्भवस्येव दिधक्षोस्त्रिपुरं पुरा ।\nजाज्वल्यमानवपुषं तं दृष्ट्वा सहसा भयात् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006229058, "chapter_id": 26229, "verse_number": "२-५७-५९", "content_sanskrit": "प्रसीद जय रामेति तुष्टुवुर्मुनयोऽखिलाः ।\nततोऽस्त्राग्निस्फुरद्धूमपटलैः शकलीकृतम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006229059, "chapter_id": 26229, "verse_number": "२-५७-६०", "content_sanskrit": "बभूव च्छन्नमंभोधेरन्तः पुरमशैषतः ।\nज्वलदस्त्रानलज्वालाप रितापपराहतः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006229060, "chapter_id": 26229, "verse_number": "२-५७-६१", "content_sanskrit": "अत्यरिच्यत संभ्रान्तसलिलौघ उदन्वतः ।\nतिमिङ्गिलतिमिग्राहनक्रमत्स्याहिकच्छपाः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006229061, "chapter_id": 26229, "verse_number": "२-५७-६२", "content_sanskrit": "प्रजग्मुः परमामार्त्तिं प्राणिनः सलिलेशयाः ।\nउत्पतन्निपतत्ताम्यन्नानासत्त्वोद्धतोर्मिभिः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006229062, "chapter_id": 26229, "verse_number": "२-५७-६३", "content_sanskrit": "प्रक्षोभं भृशमंभोधिः सहसा समुपागमत् ।\nत्रासरासं च विपुलमंभसा प्लवता सह ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006229063, "chapter_id": 26229, "verse_number": "२-५७-६४", "content_sanskrit": "उद्वेलतामितस्तप्ताः सलिलान्तरचारिणः ।\nततस्तस्माच्छराज्ज्वालाः फूत्कृताशेष भीषणाः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006229064, "chapter_id": 26229, "verse_number": "२-५७-६५", "content_sanskrit": "निरूपितमिव व्यक्तं निश्चेरुः सर्वतो दिशम् ।\nततः प्रचण्डपवनैः सर्वतः परिवर्त्तितम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006229065, "chapter_id": 26229, "verse_number": "२-५७-६६", "content_sanskrit": "अग्निज्वालामयं रक्तवितानाभमलक्ष्यत ।\nप्रलयाब्धेरिवात्यर्थमस्त्राग्निव्याकुलांभसः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006229066, "chapter_id": 26229, "verse_number": "२-५७-६७", "content_sanskrit": "समुद्रिक्ततया तस्य तरङ्गास्तीरमभ्ययुः ।\nअस्त्राग्निविद्धाकुलितजलघोषेण भूयसा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006229067, "chapter_id": 26229, "verse_number": "२-५७-६८", "content_sanskrit": "ककुभो बधिरीकुवन्नलक्ष्यत पयोनिधिः ।\nपरितोऽस्त्रानलज्वालापरिवीतजलाविलः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006229068, "chapter_id": 26229, "verse_number": "२-५७-६९", "content_sanskrit": "जगाम परमामार्त्तिं सह्यः सद्यस्तदाश्रयः ।\nआकर्णाकृष्टकोदण्डं दृष्ट्वा रामं पयोनिधिः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006229069, "chapter_id": 26229, "verse_number": "२-५७-७०", "content_sanskrit": "विषादमगमत्तीव्रं यमं दृष्ट्वेव पातकी ।\nभयकंपितसर्वाङ्गस्ततो नदनदीपतिः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006229070, "chapter_id": 26229, "verse_number": "२-५७-७१", "content_sanskrit": "विहाय सहजं धैर्यं भीरुत्वं समुपागमत् ।\nततः स्वरूपमास्थाय सर्वाभरणभूषितः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006229071, "chapter_id": 26229, "verse_number": "२-५७-७२", "content_sanskrit": "उत्तीर्यमाणः स्वजलं वरुणः प्रत्यदृश्यत ।\nकृताञ्जलिः सार्वहस्तः प्रचेता भार्गवान्तिकम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006229072, "chapter_id": 26229, "verse_number": "२-५७-७३", "content_sanskrit": "त्वरयाभ्यायायौ शीघ्रसायकाद्भीतभीतवत् ।\nअभ्येत्याकृष्टधनुषः स तस्य चरणाब्जयोः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006229073, "chapter_id": 26229, "verse_number": "२-५७-७४", "content_sanskrit": "अब्रवीच्च भृशं भीतः संभ्रमाकुलिताक्षरम् ।\nरक्ष मां भृगुशार्दूल कृपया शरणागतम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006229074, "chapter_id": 26229, "verse_number": "२-५७-७५", "content_sanskrit": "अपराधमिमं राम मया कृतमजानता ।\nस्थितोऽस्मि तव निर्देशेशाधि किं करवाणि वै ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]