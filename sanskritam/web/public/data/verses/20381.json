[{"id": 7000381000, "chapter_id": 20381, "verse_number": "२-५३-१", "content_sanskrit": "सुकलोवाच ।\nएवं धर्मं श्रुतं पूर्वं पुराणेषु तदा मया ।\nपतिहीना कथं भोगं करिष्ये पापनिश्चया॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000381001, "chapter_id": 20381, "verse_number": "२-५३-२", "content_sanskrit": "कांतेन तु विना तेन जीवं काये न धारये ।\nविष्णुरुवाच ।\nएवमुक्त्वा परं धर्मं पतिव्रतमनुत्तमम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000381002, "chapter_id": 20381, "verse_number": "२-५३-३", "content_sanskrit": "तास्तु सख्यो वरा नार्यो हर्षेण महतान्विताः ।\nश्रुत्वा धर्मं परं पुण्यं नारीणां गतिदायकम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000381003, "chapter_id": 20381, "verse_number": "२-५३-४", "content_sanskrit": "स्तुवंति तां महाभागां सुकलां धर्मवत्सलाम् ।\nब्राह्मणाश्च सुराः सर्वे पुण्यस्त्रियो नरोत्तम॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000381004, "chapter_id": 20381, "verse_number": "२-५३-५", "content_sanskrit": "तस्या ध्यानं प्रकुर्वंति पतिकामप्रभावतः ।\nअत्यर्थं दृढतामिंद्र सुःविचिंत्य सुरेश्वरः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000381005, "chapter_id": 20381, "verse_number": "२-५३-६", "content_sanskrit": "सुकलायाः परं भावं सुविचार्यामरेश्वरः ।\nचालये धैर्यमस्याश्च पतिस्नेहं न संशयः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000381006, "chapter_id": 20381, "verse_number": "२-५३-७", "content_sanskrit": "सस्मार मन्मथं देवं त्वरमाणः सुराधिपः ।\nपुष्पचापं स संगृह्य मीनकेतुः समागतः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000381007, "chapter_id": 20381, "verse_number": "२-५३-८", "content_sanskrit": "प्रियया च तया युक्तो रत्या दृष्टमहाबलः ।\nबद्धांजलिपुटो भूत्वा सहस्राक्षमुवाच सः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000381008, "chapter_id": 20381, "verse_number": "२-५३-९", "content_sanskrit": "कस्मादहं त्वया नाथ अधुना संस्मृतो विभो ।\nआदेशो दीयतां मेद्य सर्वभावेन मानद॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000381009, "chapter_id": 20381, "verse_number": "२-५३-१०", "content_sanskrit": "इंद्र उवाच ।\nसुकलेयं महाभागा पतिव्रतपरायणा ।\nशृणुष्व कामदेव त्वं कुरु साहाय्यमुत्तमम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000381010, "chapter_id": 20381, "verse_number": "२-५३-११", "content_sanskrit": "निष्कर्षय महाभागां सुकलां पुण्यमंगलाम् ।\nतच्छ्रुत्वा वचनं तस्य शक्रस्य तमथाब्रवीत्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000381011, "chapter_id": 20381, "verse_number": "२-५३-१२", "content_sanskrit": "एवमस्तु सहस्राक्ष करिष्यामि न संशयः ।\nसाहाय्यं देवदेवेश तव कौतुककारणात्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000381012, "chapter_id": 20381, "verse_number": "२-५३-१३", "content_sanskrit": "एवमुक्त्वा महातेजाः कंदर्पो मुनिदुर्जयः ।\nदेवाञ्जेतुं समर्थोऽहं समुनीनृषिसत्तमान्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000381013, "chapter_id": 20381, "verse_number": "२-५३-१४", "content_sanskrit": "किं पुनः कामिनीं देव यस्या अंगे न वै बलम् ।\nकामिनीनामहं देव अंगेषु निवसाम्यहम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000381014, "chapter_id": 20381, "verse_number": "२-५३-१५", "content_sanskrit": "भाले कुचेषु नेत्रेषु कचाग्रेषु च सर्वदा ।\nनाभौ कट्यां पृष्ठदेशे जघने योनिमंडले॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000381015, "chapter_id": 20381, "verse_number": "२-५३-१६", "content_sanskrit": "अधरे दंतभागेषु कक्षायां हि न संशयः ।\nअंगेष्वेवं प्रत्यंगेषु सर्वत्र निवसाम्यहम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000381016, "chapter_id": 20381, "verse_number": "२-५३-१७", "content_sanskrit": "नारी मम गृहं देव सदा तत्र वसाम्यहम् ।\nतत्रस्थः पुरुषान्सर्वान्मारयामि न संशयः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000381017, "chapter_id": 20381, "verse_number": "२-५३-१८", "content_sanskrit": "स्वभावेनाबलादेव संतप्ता मम मार्गणैः ।\nपितरं मातरं दृष्ट्वा अन्यं स्वजनबांधवम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000381018, "chapter_id": 20381, "verse_number": "२-५३-१९", "content_sanskrit": "सुरूपं सगुणं देव मम बाणा हता सती ।\nचलते नात्र संदेहो विपाकं नैव चिंतयेत्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000381019, "chapter_id": 20381, "verse_number": "२-५३-२०", "content_sanskrit": "योनिः स्पंदेत नारीणां स्तनाग्रौ च सुरेश्वर ।\nनास्ति धैर्यं सुरेशान सुकलां नाशयाम्यहम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000381020, "chapter_id": 20381, "verse_number": "२-५३-२१", "content_sanskrit": "इंद्र उवाच ।\nपुरुषोहं भविष्यामि रूपवान्गुणवान्धनी ।\nकौतुकार्थमिमां नारीं चालयामि मनोभव॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000381021, "chapter_id": 20381, "verse_number": "२-५३-२२", "content_sanskrit": "नैव कामान्न संत्रासान्न वा लोभान्न कारणात् ।\nन वै मोहान्न वै क्रोधात्सत्यं सत्यं रतिप्रिय॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000381022, "chapter_id": 20381, "verse_number": "२-५३-२३", "content_sanskrit": "कथं मे दृश्यते तस्या महत्सत्यं पतिव्रतम् ।\nनिष्कर्षिष्य इतो गत्वा भवन्मोहोत्र कारणम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000381023, "chapter_id": 20381, "verse_number": "२-५३-२४", "content_sanskrit": "एवं कामं च संदिश्य जगाम सुरराट्स्वयम् ।\nआत्मविकृतिसंभूतो रूपवान्गुणवान्स्वयम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000381024, "chapter_id": 20381, "verse_number": "२-५३-२५", "content_sanskrit": "सर्वाभरणशोभांगः सर्वभोगसमन्वितः ।\nभोगलीलासमाकीर्णः सर्वदौदार्यसंयुतः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000381025, "chapter_id": 20381, "verse_number": "२-५३-२६", "content_sanskrit": "यत्र सा तिष्ठते देवी कृकलस्य प्रिया नृप ।\nआत्मलीलां स्वरूपं च गुणं भावं प्रदर्शयेत्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000381026, "chapter_id": 20381, "verse_number": "२-५३-२७", "content_sanskrit": "नैव पश्यति सा तं तु पुरुषं रूपसंपदम् ।\nयत्रयत्र व्रजेत्सा हि तत्र तां पश्यते नृप॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000381027, "chapter_id": 20381, "verse_number": "२-५३-२८", "content_sanskrit": "साभिलाषेण मनसा तामेवं परिपश्यति ।\nकामचेष्टां सहस्राक्षोऽदर्शयत्सर्वभावकैः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000381028, "chapter_id": 20381, "verse_number": "२-५३-२९", "content_sanskrit": "चतुष्पथे पथे तीर्थे यत्र देवी प्रयाति सा ।\nतत्रतत्र सहस्राक्षस्तामेव परिपश्यति॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000381029, "chapter_id": 20381, "verse_number": "२-५३-३०", "content_sanskrit": "इंद्रेण प्रेषिता दूती सुकलां प्रति सा गता ।\nसुकलां सुमहाभागां प्रत्युवाच प्रहस्य वै॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000381030, "chapter_id": 20381, "verse_number": "२-५३-३१", "content_sanskrit": "अहो सत्यमहोधैर्यमहो कांतिरहो क्षमा ।\nअस्या रूपेण संसारे नास्ति नारी वरानना॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000381031, "chapter_id": 20381, "verse_number": "२-५३-३२", "content_sanskrit": "का त्वं भवसि कल्याणि कस्य भार्या भविष्यसि ।\nयस्य त्वं सगुणा भार्या स धन्यः पुण्यभाग्भुवि॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000381032, "chapter_id": 20381, "verse_number": "२-५३-३३", "content_sanskrit": "तस्यास्तु वचनं श्रुत्वा तामुवाच मनस्विनी ।\nवैश्यजात्यां समुत्पन्नो धर्मात्मा सत्यवत्सलः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000381033, "chapter_id": 20381, "verse_number": "२-५३-३४", "content_sanskrit": "तस्याहं हि प्रिया भार्या सत्यसंधस्य धीमतः ।\nकृकलस्यापि वैश्यस्य सत्यमेव वदामि ते॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000381034, "chapter_id": 20381, "verse_number": "२-५३-३५", "content_sanskrit": "मम भर्ता स धर्मात्मा तीर्थयात्रां गतः सुधीः ।\nतस्मिन्गते महाभागे मम भर्तरि संप्रति॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000381035, "chapter_id": 20381, "verse_number": "२-५३-३६", "content_sanskrit": "अतिक्रांताः शृणुष्व त्वं त्रयश्चैवापि वत्सराः ।\nततोहं दुःखिता जाता विना तेन महात्मना॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000381036, "chapter_id": 20381, "verse_number": "२-५३-३७", "content_sanskrit": "एतत्ते सर्वमाख्यातमात्मवृत्तांतमेव ते ।\nभवती पृच्छते मां का भविष्यति वदस्व मे॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000381037, "chapter_id": 20381, "verse_number": "२-५३-३८", "content_sanskrit": "सुकलाया वचः श्रुत्वा दूत्या आभाषितं पुनः ।\nमामेवं पृच्छसे भद्रे तत्ते सर्वं वदाम्यहम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000381038, "chapter_id": 20381, "verse_number": "२-५३-३९", "content_sanskrit": "अहं तवांतिकं प्राप्ता कार्यार्थं वरवर्णिनि ।\nश्रूयतामभिधास्यामि श्रुत्वा चैवाव धार्यताम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000381039, "chapter_id": 20381, "verse_number": "२-५३-४०", "content_sanskrit": "गतस्ते निर्घृणो भर्ता त्वां त्यक्त्वा तु वरानने ।\nकिं करिष्यसि तेनापि प्रियाघातकरेण च॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000381040, "chapter_id": 20381, "verse_number": "२-५३-४१", "content_sanskrit": "यस्त्वां त्यक्त्वा गतः पापी साध्व्याचारसमन्विताम् ।\nकिं वा स ते गतो बाले तत्र जीवति वै मृतः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000381041, "chapter_id": 20381, "verse_number": "२-५३-४२", "content_sanskrit": "किं करिष्यति तेनैवं भवती खिद्यते वृथा ।\nकस्मान्नाशयते चांगं दिव्यं हेमसमप्रभम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000381042, "chapter_id": 20381, "verse_number": "२-५३-४३", "content_sanskrit": "बाल्ये वयसि संप्राप्ते मानवो न च विंदति ।\nएकं सुखं महाभागे बालक्रीडां विना शुभे॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000381043, "chapter_id": 20381, "verse_number": "२-५३-४४", "content_sanskrit": "वार्द्धके दुःखसंप्राप्तिर्जरा कायं प्रहिंसयेत् ।\nतारुण्ये भुज्यते भोगः सुखात्सर्वो वरानने॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000381044, "chapter_id": 20381, "verse_number": "२-५३-४५", "content_sanskrit": "यावत्तिष्ठति तारुण्यं तावद्भुंजंति मानवाः ।\nसुखभोगादिकं सर्वं स्वेच्छया रमते नरः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000381045, "chapter_id": 20381, "verse_number": "२-५३-४६", "content_sanskrit": "यावत्तिष्ठति तारुण्यं तावद्भोगान्प्रभुंजते ।\nवयस्यपि गते भद्रे तारुण्ये किं करिष्यति॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000381046, "chapter_id": 20381, "verse_number": "२-५३-४७", "content_sanskrit": "संप्राप्ते वार्द्धके देवि किंचित्कार्यं न सिध्यति ।\nस्थविरश्चिंतयेन्नित्यं सुखकार्यं न गच्छति॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000381047, "chapter_id": 20381, "verse_number": "२-५३-४८", "content_sanskrit": "वयस्यपि गते बाले क्रियते सेतुबंधनम् ।\nतादृशोयं भवेत्कायस्तारुण्ये तु गते शुभे॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000381048, "chapter_id": 20381, "verse_number": "२-५३-४९", "content_sanskrit": "तस्माद्भुंक्ष्व सुखेनापि पिबस्व मधुमाधवीम् ।\nकामाबाणा दहंत्यंगं तवेमे चारुलोचने॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000381049, "chapter_id": 20381, "verse_number": "२-५३-५०", "content_sanskrit": "अयमेकः समायातः पुरुषो रूपवान्गुणी ।\nअयं हि पुरुषव्याघ्रः सर्वज्ञो गुणवान्धनी॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000381050, "chapter_id": 20381, "verse_number": "२-५३-५१", "content_sanskrit": "तवार्थे नित्यसंयुक्तः स्नेहेन वरवर्णिनि ।\nसुकलोवाच ।\nबाल्यं नास्त्यपि जीवस्य तारुण्यं नास्ति जीविते॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000381051, "chapter_id": 20381, "verse_number": "२-५३-५२", "content_sanskrit": "वृद्धत्वं नास्ति चैवास्य स्वयंसिद्धः सुसिद्धिदः ।\nअमरो निर्जरो व्यापी सुसिद्धः सर्ववित्तमः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000381052, "chapter_id": 20381, "verse_number": "२-५३-५३", "content_sanskrit": "अकामः कामदो लोके आत्मरूपेण वर्तते ।\nयथा गेहस्य संस्थानं तथा कायस्य दृश्यते॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000381053, "chapter_id": 20381, "verse_number": "२-५३-५४", "content_sanskrit": "यथा वार्द्धकिना कायस्तथा सूत्रेण मंदिरम् ।\nअनेककाष्ठसंघातैर्नाना दारुसमुच्चयैः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000381054, "chapter_id": 20381, "verse_number": "२-५३-५५", "content_sanskrit": "मृत्तिकयोदकेनापि समंतात्परिणामयेत् ।\nलिपितं लेपकैः काष्ठं चित्रं भवति चित्रकैः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000381055, "chapter_id": 20381, "verse_number": "२-५३-५६", "content_sanskrit": "प्रथमं रूपमायाति गृहं सूत्रेण सूत्रितम् ।\nपुष्णंति च स्वयं तत्तु लेपनाद्वै दिने दिने॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000381056, "chapter_id": 20381, "verse_number": "२-५३-५७", "content_sanskrit": "वायुनांदोलितं नित्यं गृहं च मलिनायते ।\nमध्यमो वर्तुतः कालो गृहस्य परिकथ्यते॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000381057, "chapter_id": 20381, "verse_number": "२-५३-५८", "content_sanskrit": "रूपहानिर्भवेत्तस्य गृहस्वामी विलेपयेत् ।\nस्वेच्छया च गृहस्वामी रूपवत्त्वं नयेद्गृहम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000381058, "chapter_id": 20381, "verse_number": "२-५३-५९", "content_sanskrit": "तारुण्यं तस्य गेहस्य दूतिके परिकथ्यते ।\nकाष्ठसंघैश्च जीर्णत्वं बहुकालैः प्रयाति सः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000381059, "chapter_id": 20381, "verse_number": "२-५३-६०", "content_sanskrit": "स्थानभ्रष्टाः प्रजायंते मूलाग्रे प्रचलंति ते ।\nन सहेल्लेपनाभारमाधारेण प्रतिष्ठति॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000381060, "chapter_id": 20381, "verse_number": "२-५३-६१", "content_sanskrit": "एतद्गृहस्य वार्द्धक्यं कथितं शृणु दूतिके ।\nपतमानं गृहं दृष्ट्वा गृहस्वामी परित्यजेत्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000381061, "chapter_id": 20381, "verse_number": "२-५३-६२", "content_sanskrit": "गृहमन्यं प्रवेशाय प्रयात्येव हि सत्वरम् ।\nतथा बाल्यं च तारुण्यं नृणां वृद्धत्वमेव च॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000381062, "chapter_id": 20381, "verse_number": "२-५३-६३", "content_sanskrit": "स बाल्ये बालरूपश्च ज्ञानहीनं प्रकारयेत् ।\nचित्रयेत्कायमेवापि वस्त्रालंकारभूषणैः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000381063, "chapter_id": 20381, "verse_number": "२-५३-६४", "content_sanskrit": "लेपनैश्चंदनैश्चान्यैस्तांबूलप्रभवादिभिः ।\nकायस्तरुणतां याति अतिरूपो विजायते॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000381064, "chapter_id": 20381, "verse_number": "२-५३-६५", "content_sanskrit": "बाह्याभ्यंतरमेवापि रसैः सर्वैः प्रपोषयेत् ।\nतेन पोषणभावेन परिपुष्टः प्रजायते॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000381065, "chapter_id": 20381, "verse_number": "२-५३-६६", "content_sanskrit": "जायते मांसवृद्धिस्तु रसैश्चापि नवोत्तमा ।\nयांति विस्तरतां राजन्नंगान्याप्यायितान्यपि॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000381066, "chapter_id": 20381, "verse_number": "२-५३-६७", "content_sanskrit": "प्रत्यंगानि रसैश्चैव स्वंस्वं रूपं प्रयांति वै ।\nदंताधरौ स्तनौ बाहू कटिपृष्ठमुरू उभे॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000381067, "chapter_id": 20381, "verse_number": "२-५३-६८", "content_sanskrit": "हस्तपादतलौ तद्वद्वृद्धित्वं प्रतिपेदिरे ।\nउभाभ्यामपि तान्येव वृद्धिमायांति तानि वै॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000381068, "chapter_id": 20381, "verse_number": "२-५३-६९", "content_sanskrit": "अंगानि रसमांसाभ्यां सुरूपाणि भवंति ते ।\nतैः स्वरूपैर्भवेन्मर्त्यो रसबद्धश्च दूतिके॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000381069, "chapter_id": 20381, "verse_number": "२-५३-७०", "content_sanskrit": "सुरूपः कथ्यते मर्त्यो लोके केन प्रियो भवेत् ।\nविष्ठामूत्रस्य वै कोशः काय एष च दूतिके॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000381070, "chapter_id": 20381, "verse_number": "२-५३-७१", "content_sanskrit": "अपवित्रशरीरोयं सदा स्रवति निर्घृणः ।\nतस्य किं वर्ण्यते रूपं जलबुद्बुदवच्छुभे॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000381071, "chapter_id": 20381, "verse_number": "२-५३-७२", "content_sanskrit": "यावत्पंचाशद्वर्षाणि तावत्तिष्ठति वै दृढः ।\nपश्चाच्च जायते हानिस्तस्यैवापि दिनेदिने॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000381072, "chapter_id": 20381, "verse_number": "२-५३-७३", "content_sanskrit": "दंताः शिथिलतां यांति तथा लालायते मुखम् ।\nचक्षुर्भ्यामपि पश्येन्न कर्णाभ्यां न शृणोति च॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000381073, "chapter_id": 20381, "verse_number": "२-५३-७४", "content_sanskrit": "गतिं कर्तुं न शक्नोति हस्तपादैश्च दूतिके ।\nअक्षमो जायते कायो जराकालेन पीडितः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000381074, "chapter_id": 20381, "verse_number": "२-५३-७५", "content_sanskrit": "तद्रसः शोषमायाति जराग्नितापशोषितः ।\nअक्षमो जायते दूति केन रूपत्वमिष्यते॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000381075, "chapter_id": 20381, "verse_number": "२-५३-७६", "content_sanskrit": "यथा जीर्णं गृहं याति क्षयमेवं न संशयः ।\nतथा संक्षयमायाति वार्द्धके तु कलेवरम्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000381076, "chapter_id": 20381, "verse_number": "२-५३-७७", "content_sanskrit": "ममरूपं समायातं वर्णस्येवं दिने दिने ।\nकेनाहं रूपसंयुक्ता केन रूपत्वमिष्यते॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000381077, "chapter_id": 20381, "verse_number": "२-५३-७८", "content_sanskrit": "यथा जीर्णं गृहं याति केनासौ पुरुषो बली ।\nयस्यार्थमागता दूति भवती केन शंसति॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000381078, "chapter_id": 20381, "verse_number": "२-५३-७९", "content_sanskrit": "किमु चैव त्वया दृष्टं ममांगे वद सांप्रतम् ।\nतस्यांगादिह हीनं च दूति नास्त्यधिकं तथा॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000381079, "chapter_id": 20381, "verse_number": "२-५३-८०", "content_sanskrit": "यथा त्वं च तथासौवै तथाहं नात्र संशयः ।\nकस्य रूपं न विद्येत रूपवान्नास्ति भूतले॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000381080, "chapter_id": 20381, "verse_number": "२-५३-८१", "content_sanskrit": "उच्छ्रायाः पतनांताश्च नगास्तु गिरयः शुभे ।\nकालेन पीडिता यांति तद्वद्भूताश्च नान्यथा॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000381081, "chapter_id": 20381, "verse_number": "२-५३-८२", "content_sanskrit": "अरूपो रूपवान्दिव्य आत्मा सर्वगतः शुचिः ।\nस्थावरेष्वेव सर्वेषु जंगमेषु च दूतिके॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000381082, "chapter_id": 20381, "verse_number": "२-५३-८३", "content_sanskrit": "एको निवसते शुद्धो घटेष्वेकं यथोदकम् ।\nघटनाशात्प्रयात्येकमेकत्वं त्वं न बुध्यसे॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000381083, "chapter_id": 20381, "verse_number": "२-५३-८४", "content_sanskrit": "पिंडनाशादयं चात्मा एकरूपो विजायते ।\nएकं रूपं मया दृष्टं संसारे वसता सदा॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000381084, "chapter_id": 20381, "verse_number": "२-५३-८५", "content_sanskrit": "एवं वद स्वतं ज्ञात्वा यस्यार्थमिह चागता ।\nदर्शयस्व अपूर्वं मे यदि भोक्तुमिहेच्छसि॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000381085, "chapter_id": 20381, "verse_number": "२-५३-८६", "content_sanskrit": "व्याधिना पीड्यमानस्य कफेनापि वृतस्य च ।\nअंगाद्विचलते शोणः स्थानभ्रष्टोभिजायते॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000381086, "chapter_id": 20381, "verse_number": "२-५३-८७", "content_sanskrit": "अंगसंधिषु सर्वासु पलत्वं चांतरं गतः ।\nएकतो नाशमायाति स्वं हि रूपं परित्यजेत्॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000381087, "chapter_id": 20381, "verse_number": "२-५३-८८", "content_sanskrit": "विष्ठात्वं जायते शीघ्रं कृमिभिश्च भवेत्किल ।\nतद्वद्दुःखकरं वापि निजरूपं परित्यजेत्॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000381088, "chapter_id": 20381, "verse_number": "२-५३-८९", "content_sanskrit": "श्रूयतां जायते पश्चात्कृमिदुर्गंधसंकुलम् ।\nजायंते तत्र वै यूकाः कृमयो वा न संशयः॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000381089, "chapter_id": 20381, "verse_number": "२-५३-९०", "content_sanskrit": "सकृमिः कुरुते स्फोटं कंडूं च परिदारुणाम् ।\nव्यथामुत्पादयेद्यूका सर्वांगं परिचालयेत्॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000381090, "chapter_id": 20381, "verse_number": "२-५३-९१", "content_sanskrit": "नखाग्रैर्घृष्यमाणा सा कंडूः शांता प्रजायते ।\nतद्वत्तैश्च शृणुष्वैव सुरतस्य न संशयः॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000381091, "chapter_id": 20381, "verse_number": "२-५३-९२", "content_sanskrit": "भुंजत्येव रसान्मर्त्यः सुभिक्षान्पिबते पुनः ।\nवायुना तेन प्राणेन पाकस्थानं प्रणीयते॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000381092, "chapter_id": 20381, "verse_number": "२-५३-९३", "content_sanskrit": "यद्भक्तं प्राणिभिर्दूति पाकस्थानं गतं पुनः ।\nसर्वं तत्पिहितं तत्र वायुर्वै पातयेन्मलम्॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000381093, "chapter_id": 20381, "verse_number": "२-५३-९४", "content_sanskrit": "सारभूतो रसस्तत्र तद्रक्तश्च प्रजायते ।\nनिर्मलः शुद्धवीर्यस्तु ब्रह्मस्थानं प्रयाति च॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000381094, "chapter_id": 20381, "verse_number": "२-५३-९५", "content_sanskrit": "आकृष्टः स समानेन नीतस्तेनापि वायुना ।\nस्थानं न लभते वीर्यं चंचलत्वेन वर्तते॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000381095, "chapter_id": 20381, "verse_number": "२-५३-९६", "content_sanskrit": "प्राणिनां हि कपालेषु कृमयः संति पंच वै ।\nद्वावेतौ कर्णमूले तु नेत्रस्थाने ततः पुनः॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000381096, "chapter_id": 20381, "verse_number": "२-५३-९७", "content_sanskrit": "कनिष्ठांगुलिमानेन रक्तपुच्छाश्च दूतिके ।\nनवनीतस्य वर्णेन कृष्णपुच्छा न संशयः॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000381097, "chapter_id": 20381, "verse_number": "२-५३-९८", "content_sanskrit": "तेषां नामापि भद्रे त्वं मत्तो निगदितं शृणु ।\nपिंगली शृंखली नाम द्वौ कृमी कर्णमूलयोः॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000381098, "chapter_id": 20381, "verse_number": "२-५३-९९", "content_sanskrit": "चपलः पिप्पलश्चैव द्वावेतौ नासिकाग्रयोः ।\nशृंगली जंगली चान्यौ नेत्रयोरंतरस्थितौ॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000381099, "chapter_id": 20381, "verse_number": "२-५३-१००", "content_sanskrit": "कृमीणां शतपंचाशत्तादृग्भूता न संशयः ।\nभालांतेवस्थिताः सर्वे राजिकायाः प्रमाणतः॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000381100, "chapter_id": 20381, "verse_number": "२-५३-१०१", "content_sanskrit": "कपालरोगिणः सर्वे विकुर्वंति न संशयः ।\nकेशद्वयं मुखे तस्य विद्यते शृणु दूतिके॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000381101, "chapter_id": 20381, "verse_number": "२-५३-१०२", "content_sanskrit": "प्राणिनां संक्षयं विद्धि तत्क्षणे हि न संशयः ।\nस्वस्थाने संस्थितस्यापि प्राजापत्यस्य वै मुखे॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000381102, "chapter_id": 20381, "verse_number": "२-५३-१०३", "content_sanskrit": "तद्वीर्यं रसरूपेण पतते नात्र संशयः ।\nमुखेन पिबते वीर्यं तेन मत्तः प्रजायते॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000381103, "chapter_id": 20381, "verse_number": "२-५३-१०४", "content_sanskrit": "तालुमध्यप्रदेशे च चंचलत्वेन वर्तते ।\nइडा च पिंगला नाडी सुषुम्णाख्या च संस्थिता॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000381104, "chapter_id": 20381, "verse_number": "२-५३-१०५", "content_sanskrit": "सुबलेनापि तस्यैव नाडिका जालपंजरे ।\nकामकंडूर्भवेद्दूति सर्वेषां प्राणिनां किल॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000381105, "chapter_id": 20381, "verse_number": "२-५३-१०६", "content_sanskrit": "पुंसश्च स्फुरते लिंगं नार्या योनिश्च दूतिके ।\nस्त्रीपुंसौ संप्रमत्तौ तु व्रजतः संगमं ततः॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000381106, "chapter_id": 20381, "verse_number": "२-५३-१०७", "content_sanskrit": "कायेन कायसंघृष्टिर्मैथुनेन हि जायते ।\nक्षणमात्रं सुखं काये पुनः कंडूश्च तादृशी॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000381107, "chapter_id": 20381, "verse_number": "२-५३-१०८", "content_sanskrit": "सर्वत्र दृश्यते दूति भाव एवंविधः किल ।\nव्रज त्वमात्मनः स्थानं नैवास्त्यत्र अपूर्वता॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000381108, "chapter_id": 20381, "verse_number": "२-५३-१०९", "content_sanskrit": "अपूर्वं नास्ति मे किंचित्करोम्येव न संशयः॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}]