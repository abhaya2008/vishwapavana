[{"id": 7002701000, "chapter_id": 22701, "verse_number": "८-१२-१", "content_sanskrit": "सूत उवाच  ।\nपुनः शृणु कथां रम्यां प्रयागे जीवभाषिताम्  ।\nहिर्बुर्नाम पुरा चासीद्दानवो लोककंटकः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002701001, "chapter_id": 22701, "verse_number": "८-१२-२", "content_sanskrit": "निकुंभान्वयसंभूतः शक्रतुल्यपराक्रमः ।\nसहस्राब्दं तपः कृत्वा तापयामास वै सुरान् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002701002, "chapter_id": 22701, "verse_number": "८-१२-३", "content_sanskrit": "तदा लोकपतिर्ब्रह्मा लोकरक्षार्थमुद्यतः  ।\nवरं ब्रूहीति वचनमुवाच दनुजेश्वरम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002701003, "chapter_id": 22701, "verse_number": "८-१२-४", "content_sanskrit": "नमस्कृत्य विधातारं वचनं प्राह नम्रधीः  ।\nयदि देयो वरः स्वामिंस्त्वया विश्वकृता विभो ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002701004, "chapter_id": 22701, "verse_number": "८-१२-५", "content_sanskrit": "मरणं न च मेभूयात्त्वत्कृतैश्च चराचरैः  ।\nइत्युक्तस्स तथेत्युक्त्वा ब्रह्म लोकमुपाययौ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002701005, "chapter_id": 22701, "verse_number": "८-१२-६", "content_sanskrit": "दानवस्स ।\nतु रौद्रात्मा जित्वा स्वर्गनिवासिनः  ।\nआहूय दानवान्दैत्यान्विवरेभ्यः प्रसन्नधीः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002701006, "chapter_id": 22701, "verse_number": "८-१२-७", "content_sanskrit": "स्वर्गे निवासयामास ते देवा भूतलीकृताः  ।\nलक्षाब्दं च सुरास्सर्वे बुभुजुः परमापदः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002701007, "chapter_id": 22701, "verse_number": "८-१२-८", "content_sanskrit": "एकदा नारदो धीमान्दृष्ट्वा देवांस्तथागतान्  ।\nवचनं प्राह योगात्मा भजध्वं लोकशंकरम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002701008, "chapter_id": 22701, "verse_number": "८-१२-९", "content_sanskrit": "स देवश्च महादेवो ब्रह्माण्डेशो विपत्तिहा  ।\nइति श्रुत्वा तु वचनं ते देवा विस्मयान्विताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002701009, "chapter_id": 22701, "verse_number": "८-१२-१०", "content_sanskrit": "पार्थिवैः पूजया मासुर्देवदेवमुमापतिम्  ।\nगतैकादशवर्षाश्च तेषां पूजनकारिणाम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002701010, "chapter_id": 22701, "verse_number": "८-१२-११", "content_sanskrit": "तदा प्रसन्नो भगवान्महेशो लोकशंकरः  ।\nज्योतिर्लिंगमयो भूत्वा लोकांस्त्रीन्समदाहयत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002701011, "chapter_id": 22701, "verse_number": "८-१२-१२", "content_sanskrit": "ये तु वै देवभक्ताश्च शेषाश्चासन्महाभये  ।\nअन्ये तु दानवैस्सार्द्धं भस्मीभूता बभूविरे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002701012, "chapter_id": 22701, "verse_number": "८-१२-१३", "content_sanskrit": "एतस्मिन्नन्तरे ब्रह्मा विष्णुना सह हर्षितः  ।\nतुष्टाव स महारुद्रं स्तोत्रैस्सामसमुद्भवैः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002701013, "chapter_id": 22701, "verse_number": "८-१२-१४", "content_sanskrit": "मिथुनस्थे दिवानाथे शशिमण्डलभूपतिम्  ।\nहिर्बुघ्नं च महारुद्रं चकार सुरहेतवे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002701014, "chapter_id": 22701, "verse_number": "८-१२-१५", "content_sanskrit": "इति श्रुत्वा स हिर्बुघ्नो देवकार्यार्थमुद्यतः  ।\nहिमालये गिरौ रम्ये पुत्रोऽभूत्साद्यकर्मणः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002701015, "chapter_id": 22701, "verse_number": "८-१२-१६", "content_sanskrit": "पतिरूपः कलाभिज्ञो भारतीश इति श्रुतः  ।\nस जित्वा विदुषां वृंदान्काशीनगरमागतः ।\nशंकराचार्यमागम्य शिष्योऽभूत्तेन निर्जितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002701016, "chapter_id": 22701, "verse_number": "८-१२-१७", "content_sanskrit": "बृहस्पति रुवाच  ।\nमयपुत्रः स्मृतो मायी तपो घोरं चकार ह ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002701017, "chapter_id": 22701, "verse_number": "८-१२-१८", "content_sanskrit": "पदैकेन स्थितः सूर्ये सहस्राब्दं प्रयत्नतः  ।\nस लोकांस्तापयामास तपसा लोकवासिनः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002701018, "chapter_id": 22701, "verse_number": "८-१२-१९", "content_sanskrit": "तदा प्रसन्नो भगवान्परमेष्ठी पितामहः  ।\nत्रयो ग्रामास्तत्प्रियार्थे क्रमाद्वै तेन निर्मिताः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002701019, "chapter_id": 22701, "verse_number": "८-१२-२०", "content_sanskrit": "सौवर्णं स्वर्गसदृशं पुरं षोडशयोजनम्  ।\nतदधो योजनान्ते च राजतं च भुवर्मयम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002701020, "chapter_id": 22701, "verse_number": "८-१२-२१", "content_sanskrit": "तदधो योजनान्ते च भूर्लोकमिव चायसम्  ।\nएवं पुरनिवासिन्यो दैत्यानां योषितो मुदा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002701021, "chapter_id": 22701, "verse_number": "८-१२-२२", "content_sanskrit": "शतकोटिमिता दैत्या धर्मात्मानो निवासिनः  ।\nगृहीत्वा यज्ञभागं च देवतुल्या बभूविरे ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002701022, "chapter_id": 22701, "verse_number": "८-१२-२३", "content_sanskrit": "तदा निर्बलिनो देवाः क्षुधया पीडिताः प्रभुम्  ।\nभगवन्तं महाविष्णुं तुष्टुवुः परया गिरा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002701023, "chapter_id": 22701, "verse_number": "८-१२-२४", "content_sanskrit": "चतुर्युगसमूहानां वर्षाणां भगवन्प्रभो  ।\nअधिकारविहीनाश्च वर्तंते स्वर्गमण्डले ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002701024, "chapter_id": 22701, "verse_number": "८-१२-२५", "content_sanskrit": "तामसांतरमेवापि षोडशैव चतुर्युगम्  ।\nव्यतीतानि महाविष्णो मायिनां दुःखं भुंजताम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002701025, "chapter_id": 22701, "verse_number": "८-१२-२६", "content_sanskrit": "इति श्रुत्वा वचस्तेषां भगवान्मधुसूदनः  ।\nदृष्ट्वा संस्कृतवार्तायां दैत्यान्धर्मपरायणान् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002701026, "chapter_id": 22701, "verse_number": "८-१२-२७", "content_sanskrit": "वौद्धरूपस्त्वयं जातः कलौ प्राप्ते भयानके  ।\nअजिनस्य द्विजस्यैव सुतो भूत्वा जनार्दनः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002701027, "chapter_id": 22701, "verse_number": "८-१२-२८", "content_sanskrit": "वेदधर्मपरान्विप्रान्मोहयामास वीर्यवान्  ।\nनिर्वेदाः कर्मरहितास्त्रिवर्णास्तामसान्तरे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002701028, "chapter_id": 22701, "verse_number": "८-१२-२९", "content_sanskrit": "षोडशे च कलौ प्राप्ते बभूबुर्यज्ञवर्जिताः  ।\nतदा दैत्या रुषाविष्टास्सर्वे त्रिपुरवासिनः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002701029, "chapter_id": 22701, "verse_number": "८-१२-३०", "content_sanskrit": "मनुजान्पीडयामासुर्निर्यज्ञान्वेदवर्जितान्  ।\nक्षयं जग्मुर्नरास्सर्वे कल्पांते दैत्यभक्षिताः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002701030, "chapter_id": 22701, "verse_number": "८-१२-३१", "content_sanskrit": "पुनस्सत्ययुगे प्राप्ते कैलासे गुह्यकालये  ।\nदेवैश्चाराधितः शंभुस्सर्वलोकशिवंकरः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002701031, "chapter_id": 22701, "verse_number": "८-१२-३२", "content_sanskrit": "ज्योतिर्लिगं वपुः कृत्वा तत्र तस्थौ भयंकरः  ।\nएतस्मिन्नन्तरे देवाः प्रसन्नास्तामसान्तरे ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002701032, "chapter_id": 22701, "verse_number": "८-१२-३३", "content_sanskrit": "भूमेस्सारं गृहीत्वा ते रथं कृत्वा विधानतः  ।\nचंद्रभास्करयोस्साराच्चक्रे कृत्वा तथैव च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002701033, "chapter_id": 22701, "verse_number": "८-१२-३४", "content_sanskrit": "सुमेरोश्च तथा सारात्केतुं कृत्वा रथस्य वै  ।\nददौ शिवाय महते यानं स्यन्दनरूपि तत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002701034, "chapter_id": 22701, "verse_number": "८-१२-३५", "content_sanskrit": "तदा ब्रह्मा स्वयं प्राप्य बभूव रथसारथिः  ।\nवेदाश्च वाजिनश्चासन्देवदेवस्य वै रथे ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002701035, "chapter_id": 22701, "verse_number": "८-१२-३६", "content_sanskrit": "लोकालोकगिरेः सारो धनुश्चासीन्महात्मनः  ।\nघोरं चाजगवं नाम प्रसिद्ध मभवद्धनुः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002701036, "chapter_id": 22701, "verse_number": "८-१२-३७", "content_sanskrit": "सज्यं चकार भगवांस्तद्धनुः कठिनं महत्  ।\nभग्नीभूतमभूच्चापं देवदेवस्य वै रुषा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002701037, "chapter_id": 22701, "verse_number": "८-१२-३८", "content_sanskrit": "विस्मितो भगवान्विष्णुस्सारं स्वर्गस्य वै तदा  ।\nगृहीत्वाशु धनुर्दिव्यं पिनाकं स चकार ह ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002701038, "chapter_id": 22701, "verse_number": "८-१२-३९", "content_sanskrit": "सज्यं जातं च रुद्रेण पुष्टिभूतं महद्धनुः  ।\nतदा ब्रह्मर्षयस्तुष्टास्तुष्टुवु र्मनसा हरम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002701039, "chapter_id": 22701, "verse_number": "८-१२-४०", "content_sanskrit": "पिनाकीति च तन्नामा प्रसिद्धोभून्महेश्वरः  ।\nगुणश्चापस्य वै शेषः शक्रो वाणस्तदाभवत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002701040, "chapter_id": 22701, "verse_number": "८-१२-४१", "content_sanskrit": "शरपक्षौ वह्निवायू शल्यं विष्णुः सनातनः  ।\nतेन बाणेन दैत्यानां कोटिसंख्या मृता च खे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002701041, "chapter_id": 22701, "verse_number": "८-१२-४२", "content_sanskrit": "त्रिपुरं दाहयामास मायिना पालितं शिवः  ।\nभस्मीभूते पुरे घोरे तदा लोकपतिर्विधिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002701042, "chapter_id": 22701, "verse_number": "८-१२-४३", "content_sanskrit": "पिनाकिनं महारुद्रं मीनराशिस्थिते रवौ  ।\nशशिनो मण्डलस्यैव राजानं स चकार तम्  ।\nस्वाधिकारांस्तदा देवा अवापुस्तामसान्तरे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002701043, "chapter_id": 22701, "verse_number": "८-१२-४४", "content_sanskrit": "सूत उवाच  ।\nइति श्रुत्वा पिनाकी च स्वमुखात्स्वांशमुत्तमम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002701044, "chapter_id": 22701, "verse_number": "८-१२-४५", "content_sanskrit": "समुत्पाद्य हरद्वारे हिम सानौ चकार ह  ।\nमच्छन्दो नाम तत्रैव योगी शंभुपरायणः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002701045, "chapter_id": 22701, "verse_number": "८-१२-४६", "content_sanskrit": "गोरखस्य गुरुर्यो वै तन्मुखे तेज आविशत्  ।\nरंभा नाम्नैव तत्रैव स्वर्वेश्या कामरूपिणी ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002701046, "chapter_id": 22701, "verse_number": "८-१२-४७", "content_sanskrit": "मच्छन्दं च वशीकृत्य बुभुजे स्मरविह्वला  ।\nतयोस्सकाशाद्वै जातस्स पुत्रो रुचिराननः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002701047, "chapter_id": 22701, "verse_number": "८-१२-४८", "content_sanskrit": "नाथशर्मेति विख्यातो विद्वाञ्च्छ्रेष्ठतरोऽभवत्  ।\nस जित्वा पंडितान्भूमौ पुरीं काशीं समागतः  ।\nशंकराचार्यविजितस्तस्य शिष्यो बभूव ह ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002701048, "chapter_id": 22701, "verse_number": "८-१२-४९", "content_sanskrit": "बृहस्पतिरुवाच  ।\nचाक्षुषांतरसंप्राप्ते द्वादशे द्वापरे युगे ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002701049, "chapter_id": 22701, "verse_number": "८-१२-५०", "content_sanskrit": "क्षत्रियैस्तालजंघीयैर्ब्राह्मणा भृगुवंशजाः  ।\nविनाशिताः कुरुक्षेत्रे गृहीत्वा तद्धनं बहु ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002701050, "chapter_id": 22701, "verse_number": "८-१२-५१", "content_sanskrit": "बभुजुर्बलवंतस्ते दैत्यपक्षा महाधमाः  ।\nकस्यचित्तु मुनेः पत्नी गुर्विणी च भयान्विता ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002701051, "chapter_id": 22701, "verse_number": "८-१२-५२", "content_sanskrit": "हिमतुंगे समागम्य तद्गर्भं मुनिसंभवम्  ।\nशतवर्षं ददौ देवी तपसा ज्ञानरूपिणी ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002701052, "chapter_id": 22701, "verse_number": "८-१२-५३", "content_sanskrit": "मातुरूरू सुतो भित्त्वा ततो जातो महीतले  ।\nतेजसा तस्य पुत्रस्य भस्मीभूतमभूज्जगत् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002701053, "chapter_id": 22701, "verse_number": "८-१२-५४", "content_sanskrit": "तदा तु सकला देवाः पुरस्कृत्य प्रजापतिम्  ।\nवज्रस्थितश्च वै तालास्समाजग्मु र्भयातुराः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002701054, "chapter_id": 22701, "verse_number": "८-१२-५५", "content_sanskrit": "पितृभिदैवतैर्बालस्समाज्ञातो हिमाचले  ।\nलोकनाशकरं तेजो जलमध्ये स चाक्षिपत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002701055, "chapter_id": 22701, "verse_number": "८-१२-५६", "content_sanskrit": "जलदेवी च वडवा भूत्वा तत्तेज उत्तमम्  ।\nपीत्वा ववाम तत्रैव पीडिता रौद्रतेजसा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002701056, "chapter_id": 22701, "verse_number": "८-१२-५७", "content_sanskrit": "तदागत्य स्वयं ब्रह्मा त्रिकुटो यत्र वै गिरिः  ।\nतदधः सागरे घोरे स्थापयामास लोकपः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002701057, "chapter_id": 22701, "verse_number": "८-१२-५८", "content_sanskrit": "मेषगे द्युमणौ प्राप्ते शशिमण्डलगं प्रभुम्  ।\nतं रुद्रं स चकाराशु परमेष्ठी पितामहः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002701058, "chapter_id": 22701, "verse_number": "८-१२-५९", "content_sanskrit": "ऊरुजातात्स्मृतो वोर्वो दहनो लोकदाहतः  ।\nवडवामुखतो जातो वाडवो नाम स प्रभुः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002701059, "chapter_id": 22701, "verse_number": "८-१२-६०", "content_sanskrit": "सूत उवाच  ।\nइति श्रुत्वा तु दहनो गुरुवाक्यं मनोहरम्  ।\nस्वमुखात्तेज उत्पाद्य कुरुक्षेत्रं चकार ह ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002701060, "chapter_id": 22701, "verse_number": "८-१२-६१", "content_sanskrit": "सारस्वतस्य विप्रस्य गृहे जातस्स वै शिवः  ।\nक्षेत्रशर्मेति विख्यातो विद्वच्छ्रेष्ठो बभूव ह ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002701061, "chapter_id": 22701, "verse_number": "८-१२-६२", "content_sanskrit": "शंकराचार्यमागम्य शिष्यो भूत्वा पराजितः  ।\nब्रह्मचर्यव्रती काश्यां तस्थौ शंभुपरायणः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002701062, "chapter_id": 22701, "verse_number": "८-१२-६३", "content_sanskrit": "बृहस्पतिरुवाच  ।\nएकार्णवे पुरा जाते नष्टे स्थावर जंगमे  ।\nशताब्दे ब्रह्मणः प्राप्तेऽव्यक्तजन्मनि लोकगे ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002701063, "chapter_id": 22701, "verse_number": "८-१२-६४", "content_sanskrit": "अव्यक्तं प्रकृतिर्माया पीत्वा सर्वजलं मुदा  ।\nमहाकाली स्वयं मूर्तिरंधकारस्वरू पिणी ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002701064, "chapter_id": 22701, "verse_number": "८-१२-६५", "content_sanskrit": "एका बभूव तत्रैव प्राकृते कल्पदारुणे  ।\nचतुर्युगानां कोटीनां त्रयाणां दारुणे लये ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002701065, "chapter_id": 22701, "verse_number": "८-१२-६६", "content_sanskrit": "षष्टिलक्षयुतानां च कालस्तत्र व्यती तवान्  ।\nतदा सा प्रकृतिर्देवी नित्यशुद्धा सनातनी ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002701066, "chapter_id": 22701, "verse_number": "८-१२-६७", "content_sanskrit": "स्वेच्छया च स्वरूपं स्वं महागौरमनुत्तमम्  ।\nपंचवक्त्रं दशभुजं त्रिनेत्रं च दधौ शिवा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002701067, "chapter_id": 22701, "verse_number": "८-१२-६८", "content_sanskrit": "भालनेत्रेण सा माता सूक्ष्मतेजो ददर्श ह  ।\nशून्यभूतं परं नित्यमविकारि निरंजनम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002701068, "chapter_id": 22701, "verse_number": "८-१२-६९", "content_sanskrit": "तदा दिक्षु गतं ब्रह्म स्वभुजैः प्रकृतिः पुरा  ।\nग्रहीतुमिच्छती तत्र न समर्था बभूव वै ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002701069, "chapter_id": 22701, "verse_number": "८-१२-७०", "content_sanskrit": "विस्मिता प्रकृतिर्माता पंचवक्त्रैः सनातनम्  ।\nतुष्टाव परया भक्त्या चिरकालात्परात्परम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002701070, "chapter_id": 22701, "verse_number": "८-१२-७१", "content_sanskrit": "धातुशब्दैः प्राङ्मुखजैः प्रत्ययैर्याम्यवक्त्रजैः  ।\nसुविभक्तिमयैः शब्दैर्मुखपश्चिमजैः स्थिरा ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002701071, "chapter_id": 22701, "verse_number": "८-१२-७२", "content_sanskrit": "तिङ्विभक्तिमयैर्नित्या मुखोत्तरमयै र्मुदा  ।\nनभोवक्त्रमयैः शब्दैर्वर्णमात्रैर्निरंजनम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002701072, "chapter_id": 22701, "verse_number": "८-१२-७३", "content_sanskrit": "सच्चिदानंदघनकं पूर्णब्रह्म सनातनम्  ।\nतुतोष तत्तु सर्वज्ञं पचवक्त्रेषु चागमत् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002701073, "chapter_id": 22701, "verse_number": "८-१२-७४", "content_sanskrit": "पुरुषत्वमभूद्ब्रह्म स्वयंभूर्नाम चाभवत्  ।\nअव्यक्तात्प्रकृतेर्जातोऽव्यक्तजन्मा हि स स्मृतः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002701074, "chapter_id": 22701, "verse_number": "८-१२-७५", "content_sanskrit": "तस्य हेतोः स्वयं देवी वरदा लोकरूपिणी ।\nमहालक्ष्मीश्च पूर्वार्द्धाज्जाता षोडशलोकिनी ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002701075, "chapter_id": 22701, "verse_number": "८-१२-७६", "content_sanskrit": "अष्टादशभुजास्तस्या लोकरक्षणतत्पराः  ।\nदृष्ट्वा तदद्भुतं रूपं स्वयंभूर्विस्मयान्वितः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002701076, "chapter_id": 22701, "verse_number": "८-१२-७७", "content_sanskrit": "प्रविश्य बहुधा भूत्वा नान्तं तस्या जगाम ह  ।\nबृहत्वाद्बहुरूपत्वाद्ब्रह्मा नामेति विश्रुतः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002701077, "chapter_id": 22701, "verse_number": "८-१२-७८", "content_sanskrit": "श्रमितो भगवान्ब्रह्मा सत्यलोकमुप स्थितः  ।\nमुखेभ्य उद्भवैर्देवो वेदैस्तुष्टाव शंकरम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002701078, "chapter_id": 22701, "verse_number": "८-१२-७९", "content_sanskrit": "चिरं कालं तदंगाद्वै नदीनदसमुद्भवः  ।\nएकार्णवं तदा जातं शेते तत्र स्वयं प्रभुः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002701079, "chapter_id": 22701, "verse_number": "८-१२-८०", "content_sanskrit": "सहस्रयुगपर्यंतमुषित्वाऽव्यक्तभूः स्वयम्  ।\nसत्यलोकमुपागम्य पुनः सृष्टिं चकार ह ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002701080, "chapter_id": 22701, "verse_number": "८-१२-८१", "content_sanskrit": "अनन्ताः सृष्टयश्चासन्गणरूपाः पृथक्पृथक्  ।\nताभिर्व्यक्तमभूत्सर्वं महालक्ष्मीमयं जगत् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002701081, "chapter_id": 22701, "verse_number": "८-१२-८२", "content_sanskrit": "दृष्ट्वा बहुत्वं सृष्टीनां महालक्ष्मीः सनातनी  ।\nविस्मिताभूच्च सर्वेशं भगवन्तमुपाययौ ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002701082, "chapter_id": 22701, "verse_number": "८-१२-८३", "content_sanskrit": "नत्वोवाच वचो रम्यं कृष्णमव्यक्तमंगलम्  ।\nभगवन्नित्यशुद्धात्मन्नराश्चासन्महत्तराः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002701083, "chapter_id": 22701, "verse_number": "८-१२-८४", "content_sanskrit": "कथं तेषां च गणना कर्तव्या च मया सदा  ।\nइति श्रुत्वा वचस्तस्या द्विधाभूतश्च सोऽव्ययः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7002701084, "chapter_id": 22701, "verse_number": "८-१२-८५", "content_sanskrit": "पूर्वार्द्धात्स तु रक्ताङ्गः परार्द्धाद्गौररूपवान्  ।\nचतुर्भुजस्स रक्तांगो गौरवर्णश्चतु र्भुजः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7002701085, "chapter_id": 22701, "verse_number": "८-१२-८६", "content_sanskrit": "सर्वसृष्टिगणानां च स ईशो भगवान्भवः  ।\nगणेशो नाम विख्यातश्चेश्वरस्स तु विश्रुतः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7002701086, "chapter_id": 22701, "verse_number": "८-१२-८७", "content_sanskrit": "परश्चतुर्भुजो यो वै योगिध्येयो निरं जनः  ।\nएकदा विधितो जातः शिवः पार्वतिवल्लभः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7002701087, "chapter_id": 22701, "verse_number": "८-१२-८८", "content_sanskrit": "गणेशं पूजयामास सहस्राब्दं प्रयत्नतः  ।\nतदा प्रसन्नो भगवान्गणेशः शर्वपूजकः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7002701088, "chapter_id": 22701, "verse_number": "८-१२-८९", "content_sanskrit": "वरं वरय तं प्राह पार्वतीसहितं हरम्  ।\nप्रसन्नात्मा भवः साक्षात्तुष्टाव च विनम्रधीः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7002701089, "chapter_id": 22701, "verse_number": "८-१२-९०", "content_sanskrit": "शिव उवाच  ।\nनमो विष्णुस्वरूपाय गणेशाय परात्मने  ।\nचतुर्भुजाय रक्ताय यज्ञपूर्णकराय च ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7002701090, "chapter_id": 22701, "verse_number": "८-१२-९१", "content_sanskrit": "विघ्नहंत्रे जगद्भर्त्रे सर्वानन्दप्रदायिने  ।\nसिद्धीनां पतये तुभ्यं निधीनां पतये नमः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7002701091, "chapter_id": 22701, "verse_number": "८-१२-९२", "content_sanskrit": "प्रसन्नो भव देवेश पुत्रो भव मम प्रियः  ।\nइति श्रुत्वादिपूज्यस्तु गणेशो भक्तवत्सलः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7002701092, "chapter_id": 22701, "verse_number": "८-१२-९३", "content_sanskrit": "पार्वत्याः सर्वदेहात्तु तेजोभूतात्समु द्भवः  ।\nतदा कैलासशिखरे सर्वे देवास्सवासवाः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7002701093, "chapter_id": 22701, "verse_number": "८-१२-९४", "content_sanskrit": "मंगलार्थमुपाजग्मुर्देवदेवस्य मन्दिरे  ।\nमहोत्सवश्च तत्रासीत्सर्वलोकसुखावहः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7002701094, "chapter_id": 22701, "verse_number": "८-१२-९५", "content_sanskrit": "एतस्मिन्नंतरे तत्र सूर्यपुत्रः शनिः स्वयम्  ।\nक्रूरदृष्टिः समायातः कालात्मा देवमण्डपे ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7002701095, "chapter_id": 22701, "verse_number": "८-१२-९६", "content_sanskrit": "तस्य दर्शनमात्रेण स बालो विशिरा ह्यभूत्  ।\nहाहाकारो महांश्चासीत्कैलासे गुह्यकालये ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7002701096, "chapter_id": 22701, "verse_number": "८-१२-९७", "content_sanskrit": "तच्छिरश्चंद्रलोके वै तुलासंस्थे दिवाकरे  ।\nसप्तविंशद्दिनान्येव प्रकाशयति भूतले ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7002701097, "chapter_id": 22701, "verse_number": "८-१२-९८", "content_sanskrit": "निंदितो दैवतैस्तत्र शनिर्जनभयंकरः  ।\nगजस्य मस्तकं छित्त्वा दन्तैकं रागरूपि यत् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7002701098, "chapter_id": 22701, "verse_number": "८-१२-९९", "content_sanskrit": "तच्छिशोः कंधरे रक्तेऽरोपयत्सूर्यसंभवः  ।\nगज योन्या स्तुतो ब्रह्मा कर्कटस्य तदा शिरः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7002701099, "chapter_id": 22701, "verse_number": "८-१२-१००", "content_sanskrit": "समारोप्य तु तद्योनिः कर्कटो विशिरीकृतः  ।\nएवं गजाननो जातो गणेशश्चेश्वरः स्वयम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7002701100, "chapter_id": 22701, "verse_number": "८-१२-१०१", "content_sanskrit": "सूत उवाच  ।\nइति श्रुत्वा गणेशस्तु गुरोर्वचनमुत्तमम्  ।\nस्वमुखात्स्कंधमुत्पाद्य काश्यां जातः स चेश्वरः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7002701101, "chapter_id": 22701, "verse_number": "८-१२-१०२", "content_sanskrit": "दैवज्ञस्य द्विजस्यैव पुत्रो भूत्वा शुभाननः  ।\nढुंढिराजस्ततो नाम्ना प्रसिद्धोऽभून्महीतले ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7002701102, "chapter_id": 22701, "verse_number": "८-१२-१०३", "content_sanskrit": "जातकाभरणं नाम ज्योतिःशास्त्रं फलात्मकम्  ।\nकृत्वा स वेदरक्षार्थे शंकराचार्यमागमत् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7002701103, "chapter_id": 22701, "verse_number": "८-१२-१०४", "content_sanskrit": "शिष्यो भूत्वा प्रसन्नात्मा गुरुसेवापरोऽभवत्  ।\nइति ते कथितं विप्र ढुंढिराजो यथाभवत् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}]