[{"id": 7003341000, "chapter_id": 23341, "verse_number": "२-३६-१", "content_sanskrit": "सनत्कुमार उवाच  ।\nलक्ष्मीदानं प्रवक्ष्यामि महदैश्वर्यवर्धनम् ।\nपूर्वोक्तमंडपेकार्यं वेदिकोपरिमंडले ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003341001, "chapter_id": 23341, "verse_number": "२-३६-२", "content_sanskrit": "श्रीदेवीमतुलां कृत्वा हिरण्येन यथाविधि ।\nसहस्रेण तदर्धेन तदर्धार्धेन वा पुनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003341002, "chapter_id": 23341, "verse_number": "२-३६-३", "content_sanskrit": "अष्टोत्तरशतेनापि सर्वलक्षणसंयुताम् ।\nमंडले विन्यसेल्लक्ष्मीं सर्वालंकारसंयुताम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003341003, "chapter_id": 23341, "verse_number": "२-३६-४", "content_sanskrit": "तस्यास्तु दक्षिणे भागे स्थंडिले विष्णुमर्चयेत् ।\nअर्चयित्वा विधानेन श्रीसुक्तेन सुरेश्वरीम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003341004, "chapter_id": 23341, "verse_number": "२-३६-५", "content_sanskrit": "अर्चयेद्विष्णुगायत्र्या विष्णुं विश्वगुरुं हरिम् ।\nआराध्य विधिना देवीं पूर्ववद्धोम माचरेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003341005, "chapter_id": 23341, "verse_number": "२-३६-६", "content_sanskrit": "समिद्ध्रुत्वा विधानेन आज्याहुतिमथाचरेत् ।\nपृथगष्टोरशतं होमयेद्ब्राह्मणोत्तमैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003341006, "chapter_id": 23341, "verse_number": "२-३६-७", "content_sanskrit": "आहूय यजमानं तु तस्याः पूर्वदिशि स्थले ।\nतस्मै तां दर्शयेद्देवीं दंडवत्प्रणमोत्क्षितौ ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003341007, "chapter_id": 23341, "verse_number": "२-३६-८", "content_sanskrit": "प्रणम्य विष्णुं तत्रस्थं शिवं पूर्ववदर्चयेत् ।\nतस्या विंशतिभागं तु दक्षिणा परिकीर्तिता ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003341008, "chapter_id": 23341, "verse_number": "२-३६-९", "content_sanskrit": "तदर्धांशं तु दातव्यमितरेषां यथार्हतः ।\nततस्तु होमयेच्छंभुं भक्तो योगी विशेषतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]