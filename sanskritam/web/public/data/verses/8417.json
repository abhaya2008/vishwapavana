[{"id": 900005091, "chapter_id": 8417, "verse_number": "4.1", "content_sanskrit": "भेदो मिथ्या भेदत्वाच्चन्द्रभेदवदित्यनुमान-मस्त्विति चेन्न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900005092, "chapter_id": 8417, "verse_number": "4.2", "content_sanskrit": "अप्रमाणगम्यत्वमुपाधिश्च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900005093, "chapter_id": 8417, "verse_number": "4.3", "content_sanskrit": "ननु कथं प्रत्यक्षस्य भेदग्राहकत्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900005094, "chapter_id": 8417, "verse_number": "4.4", "content_sanskrit": "अनन्तभेदाभ्युपगमेऽपि मूलक्षतेरभावान्नान-वस्थादोष इति चेन्न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900005095, "chapter_id": 8417, "verse_number": "4.5", "content_sanskrit": "विद्यमानभेदस्य स्वरूपेण गृहीतस्य..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900005096, "chapter_id": 8417, "verse_number": "4.6", "content_sanskrit": "किञ्च धर्मिणो भिन्नत्वेन..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900005097, "chapter_id": 8417, "verse_number": "4.7", "content_sanskrit": "किञ्च किमयं भेदो भिन्नमेव धर्मिणं परिरभत उताभिन्नम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900005098, "chapter_id": 8417, "verse_number": "4.8", "content_sanskrit": "न द्वितीयः । विरोधादेव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900005099, "chapter_id": 8417, "verse_number": "4.9", "content_sanskrit": "विप्रतिपन्नानि शरीराणि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900005100, "chapter_id": 8417, "verse_number": "4.10", "content_sanskrit": "अत्र प्रष्टव्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900005101, "chapter_id": 8417, "verse_number": "4.11", "content_sanskrit": "तृतीयेऽपि किं तर्केणैव सदोषत्वाध्यवसायोऽथ स्फुटतरबाधकवशात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900005102, "chapter_id": 8417, "verse_number": "4.12", "content_sanskrit": "कल्प्यमानमपि बाधकं किं भेदमेव गोचर-येदुताभेदम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900005103, "chapter_id": 8417, "verse_number": "4.13", "content_sanskrit": "किञ्च नायं भेद इति वा नास्त्यत्र भेद इति वा..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900005104, "chapter_id": 8417, "verse_number": "4.14", "content_sanskrit": "न च प्रातिभासिक एवायं भेदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900005105, "chapter_id": 8417, "verse_number": "4.15", "content_sanskrit": "तृतीयेऽपि सापेक्षतामात्रं निवर्तताम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900005106, "chapter_id": 8417, "verse_number": "4.16", "content_sanskrit": "न हि दृष्टपदार्थस्य पुरुषस्य वस्त्वन्तरात्तस्य भेदे संशयः क्वचिद्दृष्टः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900005107, "chapter_id": 8417, "verse_number": "4.17", "content_sanskrit": "स्वरूपत्वेन च भेदस्यानेकप्रतीत्यभावान्ना-न्योन्याश्रयादेरवकाशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900005108, "chapter_id": 8417, "verse_number": "4.18", "content_sanskrit": "अत्र केचिदाहुः । बहुतरणिपरिस्पन्दान्तरित-जन्मत्वं परत्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900005109, "chapter_id": 8417, "verse_number": "4.19", "content_sanskrit": "तदसत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900005110, "chapter_id": 8417, "verse_number": "4.20", "content_sanskrit": "न चैवमाकाशस्यैवापह्नवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900005111, "chapter_id": 8417, "verse_number": "4.21", "content_sanskrit": "प्रमाणानां प्रामाण्यनिर्वाहकत्वेन चापेक्षणीयः साक्षी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900005112, "chapter_id": 8417, "verse_number": "4.22", "content_sanskrit": "न पञ्चमः अनुपसञ्जातबाधभ्रमेष्वपि प्रामाण्यनिश्चयापातात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900005113, "chapter_id": 8417, "verse_number": "4.23", "content_sanskrit": "स च ज्ञानं गृह्णन्न दोषं चेत्प्रमाणं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900005114, "chapter_id": 8417, "verse_number": "4.24", "content_sanskrit": "न च परीक्षायां परीक्षान्तरापेक्षायामनवस्था", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900005115, "chapter_id": 8417, "verse_number": "4.25", "content_sanskrit": "तथा ह्यस्त्यत्र पानीयमिति श्रुतवतस्तत्प्रामाण्ये सन्दिहानस्य..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900005116, "chapter_id": 8417, "verse_number": "4.26", "content_sanskrit": "न हि स्वात्मनि कदाऽप्यन्यथाभावः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900005117, "chapter_id": 8417, "verse_number": "4.27", "content_sanskrit": "कथञ्चित्सापेक्षत्वेन परतस्त्वे साक्षिणः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900005118, "chapter_id": 8417, "verse_number": "4.28", "content_sanskrit": "तेन च कालेन सर्वं विशिष्टमेवानुभूयत इति सर्वाधारतया स्थेयम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900005119, "chapter_id": 8417, "verse_number": "4.29", "content_sanskrit": "परमात्मतदितरभेदोऽपि तत्तत्स्वरूपग्राहक-प्रमाणावसेय इति नोक्तदोषावकाशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]