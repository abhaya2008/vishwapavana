[{"id": 2088195, "chapter_id": 2877, "verse_number": "१३-७-१", "content_sanskrit": "भीष्म उवाच।\nश्रूयतां पार्थ तत्त्वेन विश्वामित्रो यथा पुरा।\nब्राह्मणत्वं गतस्तात् ब्रह्मर्षित्वं तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088196, "chapter_id": 2877, "verse_number": "१३-७-२", "content_sanskrit": "भरतस्यान्ववाये वै मिथिलो नाम पार्थिवः।\nबभूव भरतश्रेष्ठ यज्वा धर्मभृतांवरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088197, "chapter_id": 2877, "verse_number": "१३-७-३", "content_sanskrit": "तस्य पुत्रो महानासीञ्जह्नुर्नाम नरेश्वरः।\nदुहितृत्वमनुप्राप्ता गङ्गा यस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088198, "chapter_id": 2877, "verse_number": "१३-७-४", "content_sanskrit": "तस्यात्मजस्तुल्यगुणः सिन्धुद्वीपो महायशाः।\nसिन्धुद्वीपाच्च राजर्षिर्बलाकाश्वो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088199, "chapter_id": 2877, "verse_number": "१३-७-५", "content_sanskrit": "वल्लभस्तस्य तनयः साक्षाद्धर्म इवापरः।\nकुशिकस्तस्य तनयः सहस्राक्षसमद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088200, "chapter_id": 2877, "verse_number": "१३-७-६", "content_sanskrit": "कुशिकस्यात्मजः श्रीमान्गाधिर्नाम जनेश्वरः।\nअपुत्रः प्रसवेनार्थी वनवासमुपावसत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088201, "chapter_id": 2877, "verse_number": "१३-७-७", "content_sanskrit": "कन्या जज्ञे सुतात्तस्य वने निवसतः सतः।\nनाम्ना सत्यवती नाम रूपेणाप्रतिमा भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088202, "chapter_id": 2877, "verse_number": "१३-७-८", "content_sanskrit": "तां वव्रे भार्गवः श्रीमांश्च्यवनस्यात्मसम्भवः।\nऋचीक इति विख्यातो विपुले तपसि स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088203, "chapter_id": 2877, "verse_number": "१३-७-९", "content_sanskrit": "स तां न प्रददौ तस्मै ऋचीकाय महात्मने।\nदरिद्र इति मत्वा वै गाधिः शत्रुनिबर्हणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088204, "chapter_id": 2877, "verse_number": "१३-७-१०", "content_sanskrit": "प्रत्याख्याय पुनर्यान्तमब्रवीद्राजसत्तप्रः।\nशुल्कं प्रदीयतां मह्यं ततो वत्स्यसि मे सुताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088205, "chapter_id": 2877, "verse_number": "१३-७-११x", "content_sanskrit": "ऋचीक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088206, "chapter_id": 2877, "verse_number": "१३-७-११", "content_sanskrit": "किं प्रयच्छामि राजेन्द्र तुभ्यं शुल्कमहं नृप।\nदुहितुर्ब्रूह्यसंसक्तो माऽभूत्तत्र विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088207, "chapter_id": 2877, "verse_number": "१३-७-१२x", "content_sanskrit": "गाधिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088208, "chapter_id": 2877, "verse_number": "१३-७-१२", "content_sanskrit": "चन्द्ररश्मिप्रकाशानां हयानां वातरहसाम्।\nएकतः श्यामकर्णानां सहस्रं दाह भार्गव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088209, "chapter_id": 2877, "verse_number": "१३-७-१३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2088210, "chapter_id": 2877, "verse_number": "१३-७-१३", "content_sanskrit": "ततः स भृगुशार्दूलश्च्यवनस्यात्मजः प्रभुः।\nअब्रवीद्वरुणं देवमादित्यं पतिमम्भसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2088211, "chapter_id": 2877, "verse_number": "१३-७-१४", "content_sanskrit": "एकतः श्यामकर्णानां हयानां चन्द्रवर्चसाम्।\nसहस्रं वातवेगानां भिक्षे त्वां देवसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2088212, "chapter_id": 2877, "verse_number": "१३-७-१५", "content_sanskrit": "तथेति वरुणो देव आदित्यो भृगुसत्तमम्।\nउवाच यत्र ते च्छन्दस्तत्रोत्थास्यन्ति वाजिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2088213, "chapter_id": 2877, "verse_number": "१३-७-१६", "content_sanskrit": "ध्यातमात्रे ऋचीकेन हयानां चन्द्रवर्चसाम्।\nगङ्गाजलात्समुत्तस्थौ सहस्रं विपुलौजसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2088214, "chapter_id": 2877, "verse_number": "१३-७-१७", "content_sanskrit": "अदूरे कान्यकुब्जस्य गङ्गायास्तीरमुत्तमम्।\nअश्वतीर्थं तदद्यापि मानवाः परिचक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2088215, "chapter_id": 2877, "verse_number": "१३-७-१८", "content_sanskrit": "ततो वै गाधये तात सहस्रं वाजिनां शुभम्।\nऋचीकः प्रददौ प्रीतः शुल्कार्थं तपतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2088216, "chapter_id": 2877, "verse_number": "१३-७-१९", "content_sanskrit": "ततः स विस्मितो राजा गाधिः शापभयेन च।\nददौ तां समलङ्कृत्य कन्यां भृगुसुताय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2088217, "chapter_id": 2877, "verse_number": "१३-७-२०", "content_sanskrit": "जग्राह विधिवत्पाणिं तस्या ब्रह्मर्षिसत्तमः।\nसा च तं पतिमासाद्य परं हर्षमवाप ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2088218, "chapter_id": 2877, "verse_number": "१३-७-२१", "content_sanskrit": "स तुतोष च ब्रह्मर्षिस्तस्या वृत्तेन भारत।\nछन्दयामास चैवैनां वरेण वरवर्णिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2088219, "chapter_id": 2877, "verse_number": "१३-७-२२", "content_sanskrit": "मात्रे तत्सर्वमाचख्यौ सा कन्या राजसत्तम।\nअथतामब्रवीन्माता सुतां किञ्चिदवाङ्मुखीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2088220, "chapter_id": 2877, "verse_number": "१३-७-२३", "content_sanskrit": "ममापि पुत्रि भर्ता ते प्रसादं कर्तुमर्हति।\nअपत्यस्य प्रदानेन समर्थश्च महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2088221, "chapter_id": 2877, "verse_number": "१३-७-२४", "content_sanskrit": "ततः सा त्वरितं गत्वा तत्सर्वं प्रत्यवेदयत्।\nमातुश्चिकीर्षितं राजन्ऋचीकस्तामथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2088222, "chapter_id": 2877, "verse_number": "१३-७-२५", "content_sanskrit": "गुणवन्तं च पुत्रं वै त्वं च साऽथ जनिष्यथ।\nजनन्यास्तव कल्याणि मा भूद्वै प्रणयोऽन्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2088223, "chapter_id": 2877, "verse_number": "१३-७-२६", "content_sanskrit": "तव चैव गुणश्लाघी पुत्र उत्पत्स्यते महान्।\nअस्मद्वंशकरः श्रीमांस्तव भ्राता च वंशकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2088224, "chapter_id": 2877, "verse_number": "१३-७-२७", "content_sanskrit": "ऋतुस्नाता च साऽश्वत्थं त्वं च वृक्षमुदुम्बरम्।\nपरिष्वजेतं कल्याणि तत इष्टमवाप्स्यथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2088225, "chapter_id": 2877, "verse_number": "१३-७-२८", "content_sanskrit": "चरुद्वयमिदं चैव मन्त्रपूतं शुचिस्मिते।\nत्वं च सा चोपभुञ्जीतं ततः पुत्राववाप्स्यथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2088226, "chapter_id": 2877, "verse_number": "१३-७-२९", "content_sanskrit": "ततः सत्यवती हृष्टा मातरं प्रत्यभाषत।\nयदृचीकेन कथितं तच्चाचख्यौ चरुद्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2088227, "chapter_id": 2877, "verse_number": "१३-७-३०", "content_sanskrit": "तामुवाच ततो माता सुतां सत्यवतीं तदा।\nपुत्रि पूर्वोपपन्नायाः कुरुष्व वचनं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2088228, "chapter_id": 2877, "verse_number": "१३-७-३१", "content_sanskrit": "भर्त्रा य एष दत्तस्ते चरुर्मन्त्रपुरस्कृतः।\nएनं प्रयच्छ मह्यं त्वं मदीयं त्वं गृहाण च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2088229, "chapter_id": 2877, "verse_number": "१३-७-३२", "content_sanskrit": "व्यत्यासं वृक्षयोश्चापि करवाव शुचिस्मिते।\nयदि प्रमाणं वचनं मम मातुरनिन्दिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2088230, "chapter_id": 2877, "verse_number": "१३-७-३३", "content_sanskrit": "स्वमपत्यं विशिष्टं हि सर्व इच्छत्यनाविलम्।\nव्यक्तं भगवता चात्र कृतमेवं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2088231, "chapter_id": 2877, "verse_number": "१३-७-३४", "content_sanskrit": "ततो मे त्वच्चरौ भावः पादपे च समुध्यमे।\nकथं विशिष्टो भ्राता मे भवेदित्येव चिन्तय", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2088232, "chapter_id": 2877, "verse_number": "१३-७-३५", "content_sanskrit": "तथाच कृतवत्यौ ते माता सत्यवती च सा।\nअथ गर्भावनुप्राप्ते उभे ते वै युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2088233, "chapter_id": 2877, "verse_number": "१३-७-३६", "content_sanskrit": "दृष्ट्वा गर्भमनुप्राप्तां भार्यां स च महानृषिः।\nउवाच तां सत्यवतीं दुर्मना भृगुसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2088234, "chapter_id": 2877, "verse_number": "१३-७-३७", "content_sanskrit": "व्यत्यासेनोपयुक्तस्ते चरुर्व्यक्तं भविष्यति।\nव्यत्यासः पादपे चापि सुव्यक्तं ते कृतः शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2088235, "chapter_id": 2877, "verse_number": "१३-७-३८", "content_sanskrit": "मया हि विश्वं यद्ब्राह्म त्वच्चरौ सन्निवेशितम्।\nक्षत्रवीर्यं च सकलं चरौ तस्या निवेशितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2088236, "chapter_id": 2877, "verse_number": "१३-७-३९", "content_sanskrit": "त्रैलोक्यविख्यातगुणं त्वं विप्रं जनयिष्यसि।\nसा च क्षत्रं विशिष्टं वै तत एतत्कृतं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2088237, "chapter_id": 2877, "verse_number": "१३-७-४०", "content_sanskrit": "व्यत्यासस्तु कृतो यस्मात्त्वया मात्रा च ते शुभे।\nतस्मात्सा ब्राह्मणं श्रेष्ठं माता ते जनयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2088238, "chapter_id": 2877, "verse_number": "१३-७-४१", "content_sanskrit": "क्षत्रियं तूग्रकर्माणं त्वं भद्रे जनयिष्यसि।\nन हि ते तत्कृतं साधु मातृस्नेहेन भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2088239, "chapter_id": 2877, "verse_number": "१३-७-४२", "content_sanskrit": "सा श्रुत्वा शोकसंतप्ता पपात वरवर्णिनी।\nभूमौ सत्यवती राजंश्छिन्नेव रुचिरा लता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2088240, "chapter_id": 2877, "verse_number": "१३-७-४३", "content_sanskrit": "प्रतिलभ्य च सा सञ्ज्ञां शिरसा प्रणिपत्य च।\nउवाच भार्या भर्तारं गाधेयी भार्गवर्षभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2088241, "chapter_id": 2877, "verse_number": "१३-७-४४", "content_sanskrit": "प्रसादयन्त्यां भार्यायां मयि ब्रह्मविदांवर।\nप्रसादं कुरु विप्रर्षे न मे स्यात्त्रत्रियः सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2088242, "chapter_id": 2877, "verse_number": "१३-७-४५", "content_sanskrit": "कामं ममोग्रकर्मा वै पौत्रो भवितुमर्हति।\nन तु मे स्यात्सुतो ब्रह्मन्नेष मे दीयतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2088243, "chapter_id": 2877, "verse_number": "१३-७-४६", "content_sanskrit": "एवमस्त्विति होवाच स्वां भार्यां सुमहातपाः।\nततः सा जनयामास जमदग्निं सुतं शुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2088244, "chapter_id": 2877, "verse_number": "१३-७-४७", "content_sanskrit": "विश्वामित्रं चाजनयद्गाधिभार्या यशस्विनी।\nऋषेः प्रसादाद्राजेन्द्र ब्रह्मर्षि ब्रह्मवादिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2088245, "chapter_id": 2877, "verse_number": "१३-७-४८", "content_sanskrit": "ततो ब्राह्मणतां यातो विश्वामित्रो महातपाः।\nक्षत्रियः सोऽप्यथ तथा ब्रह्मवंशस्य कारकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2088246, "chapter_id": 2877, "verse_number": "१३-७-४९", "content_sanskrit": "तस्य पुत्रा महात्मानो ब्रह्मवंशविवर्धनाः।\nतपस्विनो ब्रह्मविदो गोत्रकर्तार एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2088247, "chapter_id": 2877, "verse_number": "१३-७-५०", "content_sanskrit": "मधुच्छन्दश्च भगवान्देवरातश्च वीर्यवान्।\nअक्षीणश्च शकुन्तश्च बभ्रुः कालपथस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2088248, "chapter_id": 2877, "verse_number": "१३-७-५१", "content_sanskrit": "याज्ञवल्क्यश्च विख्यातस्तथा स्थूणो महाव्रतः।\nउलूको यमदूतश्च तथर्षिः सैन्धवायनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2088249, "chapter_id": 2877, "verse_number": "१३-७-५२", "content_sanskrit": "पर्णजङ्घश्च भगवान्गावलश्च महानृषिः।\nऋषिर्वज्रस्तथा ख्यातः सालङ्कायन एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2088250, "chapter_id": 2877, "verse_number": "१३-७-५३", "content_sanskrit": "लीलाढ्यो नारदश्चैव तथा कूर्चामुखः स्मृतः।\nवादुलिर्मुसलश्चैव वक्षोग्रीवस्तथैव च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2088251, "chapter_id": 2877, "verse_number": "१३-७-५४", "content_sanskrit": "आङ्घ्रिको नैकदृक्चैव शिलायूपः सितः शुचिः।\nचक्रको मारुतन्तव्यो वातघ्नोऽथाश्वलायनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2088252, "chapter_id": 2877, "verse_number": "१३-७-५५", "content_sanskrit": "श्यामायनोऽथ गार्ग्यश्च जाबालिः सुश्रुतस्तथा।\nकारीषिरथ संश्रुत्यः परपौरवतन्तवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2088253, "chapter_id": 2877, "verse_number": "१३-७-५६", "content_sanskrit": "महानृषिश्च कपिलस्तथर्षिस्ताडकायनः।\nतथैव चोपगहनस्तथर्षिश्चासुरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2088254, "chapter_id": 2877, "verse_number": "१३-७-५७", "content_sanskrit": "मार्दमर्षिर्हिरण्याक्षो जङ्गारिर्बाभ्रवायणिः।\nभूतिर्विभूतिः सूतश्च सुरकृत्तु तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2088255, "chapter_id": 2877, "verse_number": "१३-७-५८", "content_sanskrit": "अरालिर्नाचिकश्चैव चाम्पेयोज्जयनौ तथा।\nनवतन्तुर्बकनखः सेयनो यतिरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2088256, "chapter_id": 2877, "verse_number": "१३-७-५९", "content_sanskrit": "अम्भोरुदश्चारुमत्स्यः शिरीषी चाथ गार्दभिः।\nऊर्जयोनिरुदापेक्षी नारदी च महानृषिः।\nविश्वामित्रात्मजाः सर्वे मुनयो ब्रह्मवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2088257, "chapter_id": 2877, "verse_number": "१३-७-६०", "content_sanskrit": "तथैव क्षत्रियो राजन्विश्वामित्रो महातपाः।\nऋचीकेनाहितं ब्रह्म परमेतद्युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2088258, "chapter_id": 2877, "verse_number": "१३-७-६१", "content_sanskrit": "एतत्ते सर्वमाख्यातं तत्वेन भरतर्षभ।\nविश्वामित्रस्य वै जन्म सोमसूर्याग्नितेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2088259, "chapter_id": 2877, "verse_number": "१३-७-६२", "content_sanskrit": "यत्रयत्र च सन्देहो भूयस्ते राजसत्तम।\nतत्रतत्र च मां ब्रूहि च्छेत्ताऽस्मि तव संशयान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2088260, "chapter_id": 2877, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्तमोऽध्यायः॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]