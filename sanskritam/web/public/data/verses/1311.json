[{"id": 2014926, "chapter_id": 1311, "verse_number": "२-५२-१", "content_sanskrit": "भीष्ण उवाच।\nयच्चके भगवान्विष्णुर्वसुदेवसुतस्तदा।\nतत्तेऽहं सम्प्रवक्ष्यामि शृणु स्रवमशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2014927, "chapter_id": 1311, "verse_number": "२-५२-२", "content_sanskrit": "वासुदेवस्य महात्म्यं चरितं च महात्मनः।\nहितार्थं सुरसर्त्यानां लोकानां च हिताय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2014928, "chapter_id": 1311, "verse_number": "२-५२-३", "content_sanskrit": "यदा दिवि विभुस्तात न रेमे भगवानसौ।\nततो व्यादिशय भूतानि विभुर्भूमिसुखावहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2014929, "chapter_id": 1311, "verse_number": "२-५२-४", "content_sanskrit": "निग्रहार्थाय दैत्यानां चोदयामास वै तदा।\nमुरुतश्च वसूंश्चैव सूर्याचन्द्रमसावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2014930, "chapter_id": 1311, "verse_number": "२-५२-५", "content_sanskrit": "गन्धर्वाप्सरसश्चैव रुद्रादित्यांस्तथाऽश्विनौ।\nजायध्वं मानुषे लोके सर्वलोकमहेश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2014931, "chapter_id": 1311, "verse_number": "२-५२-६", "content_sanskrit": "जङ्गमानि विशालाक्षो ह्यात्मार्थमसृजत्प्रभुः।\nजायन्तामिति गोविन्दस्तिर्यग्योनिगतैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2014932, "chapter_id": 1311, "verse_number": "२-५२-७", "content_sanskrit": "तानि सर्वाणि सर्वज्ञो व्यजायत यदोः कुले।\nआत्मानमात्मना तात कृत्वा बहुविधं हरिः।\nरत्यर्थमिह गास्तत्र ररक्ष पुरुषोत्तमः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2014933, "chapter_id": 1311, "verse_number": "२-५२-८", "content_sanskrit": "अजातशत्रो जातस्तु यथेष्ट भुवि भूमिप।\nकीर्त्यमानं मया तात निबोध भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2014934, "chapter_id": 1311, "verse_number": "२-५२-९", "content_sanskrit": "सागराः समकम्पन्त मुदा चेलुश्च पर्वताः।\nजज्वलुश्चाग्नयः शान्ता जायमाने जनार्दने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2014935, "chapter_id": 1311, "verse_number": "२-५२-१०", "content_sanskrit": "शिवाः सम्प्रववुर्वाताः प्रशान्तमभवद्रजः।\nज्योतींषि सम्प्रकाशन्त जायमाने जनार्दने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2014936, "chapter_id": 1311, "verse_number": "२-५२-११", "content_sanskrit": "देवदुन्दुभयश्चापि सस्वनुर्भृशमम्बरे।\nअभ्यवर्षंस्तदाऽऽगम्य देवताः पुष्पवृष्टिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2014937, "chapter_id": 1311, "verse_number": "२-५२-१२", "content_sanskrit": "गीर्भिर्मङ्गलयुक्ताभिः स्तुवन्वै मधुसदनम्।\nउपतस्थुस्तदा प्रीताः प्रादुर्भावे महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2014938, "chapter_id": 1311, "verse_number": "२-५२-१३", "content_sanskrit": "ततस्तानभिसम्प्रेक्ष्य नारदप्रमुखानृषीन्।\nउपानृत्यन्नुपजगुर्गन्धर्वाप्सरसां गणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2014939, "chapter_id": 1311, "verse_number": "२-५२-१४", "content_sanskrit": "उपतस्थे च गोविन्दं सहस्राक्षः शचीपतिः।\nअभ्यभाषत तेजस्वी महर्षीन्पूजयंस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2014940, "chapter_id": 1311, "verse_number": "२-५२-१५", "content_sanskrit": "कृत्वा च देवकार्याणि कृत्वा देवहितानि च।\nखं लोकं लोककृद्देवः पुनर्गच्छति तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2014941, "chapter_id": 1311, "verse_number": "२-५२-१६", "content_sanskrit": "इत्युक्त्वा ऋषिभिः सार्घं जगाम त्रिदिवं पुनः।\nअभ्यनुज्ञाय तान्सर्वाञ्छादयन्प्रकृतिं पराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2014942, "chapter_id": 1311, "verse_number": "२-५२-१७", "content_sanskrit": "नन्दगोपकुले कृष्ण उवास बहुलाः समाः।\nततः कदाचित्सुप्तं तं शकटस्य त्वधः शिशुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2014943, "chapter_id": 1311, "verse_number": "२-५२-१८", "content_sanskrit": "यशोदा सम्परित्यज्य जगाम यमुनां नदीम्।\nशिशुलीलां ततः कुर्वन्स्वहस्तचरणौ क्षिपन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2014944, "chapter_id": 1311, "verse_number": "२-५२-१९", "content_sanskrit": "रुरोद मधुरं कृष्णः पादावूर्ध्वं प्रसारयन्।\nपादाङ्गुष्ठेन शकटं दारयन्नथ केशवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2014945, "chapter_id": 1311, "verse_number": "२-५२-२०", "content_sanskrit": "तत्र एकेन पादेन पातयित्वा तथा शिशुः।\nन्युब्जं पयोधराकाङ्क्षी ससार च रुरोद च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2014946, "chapter_id": 1311, "verse_number": "२-५२-२१", "content_sanskrit": "पाटितं शकटं दृष्ट्वा भिन्नभाण्डपुटीकटम्।\nजनास्ते शिशुना तेन विस्मयं परमं ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2014947, "chapter_id": 1311, "verse_number": "२-५२-२२", "content_sanskrit": "प्रत्यक्षं शूरसेनानां दृश्यते महदद्भुतम्।\nशयानेन हतः कंसपक्षवांस्तिग्मतेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2014948, "chapter_id": 1311, "verse_number": "२-५२-२३", "content_sanskrit": "पूतना चापि निहता महाकाया महास्तनी।\nततः काले महाराज संसक्तौ रामकेशवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2014949, "chapter_id": 1311, "verse_number": "२-५२-२४", "content_sanskrit": "कृष्णः सङ्कर्षणश्चोभौ रिङ्खिणौ च बभूवतुः।\nअन्योन्यकिरणाक्रान्तौ चन्द्रसूर्याविवाम्बरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2014950, "chapter_id": 1311, "verse_number": "२-५२-२५", "content_sanskrit": "विसर्पन्तौ च सर्वत्र महासर्पभुजौ तदा।\nरेजतुः पांसुदिग्धाङ्गौ रामकृष्णौ तदा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2014951, "chapter_id": 1311, "verse_number": "२-५२-२६", "content_sanskrit": "क्वचिच्च जानुभिः स्पृष्टौ क्रीडमानौ क्वचिद्वने।\nपिबन्तौ दधिकुल्यांश्च मथ्यमाने च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2014952, "chapter_id": 1311, "verse_number": "२-५२-२७", "content_sanskrit": "ततः स बालो गोविन्दो नवनीतं तदा क्षयम्।\nग्रासमानस्तु तत्रायं गोपीभिर्ददृशे तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2014953, "chapter_id": 1311, "verse_number": "२-५२-२८", "content_sanskrit": "दाम्नाऽथोलूखले कृष्णो गोपीभिश्च निबन्धितः।\nतत्तथा शिशुना तेन कर्षता चार्जुनावृभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2014954, "chapter_id": 1311, "verse_number": "२-५२-२९", "content_sanskrit": "समूलविटपौ भग्नौ तदद्भुतमिवाभवत्।\nततस्तौ बाल्यमुत्तीर्णौ कृष्णसङ्कर्षणावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2014955, "chapter_id": 1311, "verse_number": "२-५२-३०", "content_sanskrit": "तस्मिन्नेव व्रजस्थाने सप्तवर्षै बभूवतुः।\nनीलपीताम्बरधरौ पीतश्वेतानुलेपनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2014956, "chapter_id": 1311, "verse_number": "२-५२-३१", "content_sanskrit": "बभुवतुर्वत्सपालौ काकपक्षधरावुभौ।\nपर्णवाद्यं श्रुतिसुखं वादयन्तौ वराननौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2014957, "chapter_id": 1311, "verse_number": "२-५२-३२", "content_sanskrit": "शुशुभाते वनगतौ त्रिशीर्षाविव पन्नगौ।\nमयूराङ्गजकर्णौ तौ पल्लवापीडधारिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2014958, "chapter_id": 1311, "verse_number": "२-५२-३३", "content_sanskrit": "वनमालापरिक्षिप्तौ सालपोताविवोद्गतौ।\nअरविन्दकृतापीडौ रज्जुयज्ञोपवीतिनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2014959, "chapter_id": 1311, "verse_number": "२-५२-३४", "content_sanskrit": "सशिक्यतुम्बुरुकरौ गोपवेणुप्रवादकौ।\nक्वचिद्वसन्तावन्योन्यं क्रडमानौ क्वचिद्वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2014960, "chapter_id": 1311, "verse_number": "२-५२-३५", "content_sanskrit": "पर्णशय्यासु तौ सुप्तौ क्वचिन्निद्रान्तरैषिणौ।\nतौ वत्सान्पालयन्तौ हि शोभयन्तौ महद्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2014961, "chapter_id": 1311, "verse_number": "२-५२-३६", "content_sanskrit": "चञ्चूर्यन्तौ रमन्तौ च राजन्नेवं तदा शुभम्।\nततो बृन्दावनं गत्वा वसुदेवसुतावुभौ।\nगोकुलं तत्र कौन्येय चारयन्तौ विजह्रतुः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2014962, "chapter_id": 1311, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अर्घाहरणपर्वणि द्विपञ्चाशोऽध्यायः॥ ५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]