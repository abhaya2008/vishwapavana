[{"id": 7001992000, "chapter_id": 21992, "verse_number": "३७-१", "content_sanskrit": "अग्निरुवाच ।\nसङ्क्षेपात्सर्वदेवानां पवित्रारोहणं शृणु ।\nपवित्र सर्वलक्ष्म स्यात्स्वरसानलगं त्वपि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001992001, "chapter_id": 21992, "verse_number": "३७-२", "content_sanskrit": "जगद्योने समागच्छ परिवारगणैः सह ।\nनिमन्त्रयाम्यहं प्रातर्द्दद्यान्तुभ्यं पवित्रकम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001992002, "chapter_id": 21992, "verse_number": "३७-३", "content_sanskrit": "जगत्‌सृजे नमस्तुभ्यं गृह्णीष्वेदं पवित्रकम् ।\nपवित्रीकरणार्थाय वर्षपूजाफलप्रदम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001992003, "chapter_id": 21992, "verse_number": "३७-४", "content_sanskrit": "शिवदेव नमस्तुभ्यं गृह्णीष्वेदं पवित्रकं ।\nमणिविद्रुममालाभिर्मन्दारकुसुमादिभिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001992004, "chapter_id": 21992, "verse_number": "३७-५", "content_sanskrit": "इयं सांवत्सरी पूजा तवास्तु वेदवित्पते ।\nसांवत्सरीमिमां पूजां सम्पाद्य विधिमन्मम ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001992005, "chapter_id": 21992, "verse_number": "३७-६", "content_sanskrit": "व्रज पवित्रकेदानीं स्वर्गलोकं विसर्जितः ।\nसूर्यदेव नमस्तुभ्यं गृह्णीष्वेदं पवित्रकं ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001992006, "chapter_id": 21992, "verse_number": "३७-७", "content_sanskrit": "पवित्रीकरणार्थाय वर्षपूजाफलप्रदं ।\nशिवदेव नमस्तुभ्यं गृह्णीष्वेदं पवित्रकं ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001992007, "chapter_id": 21992, "verse_number": "३७-८", "content_sanskrit": "पवित्रीकरणार्थाय वर्षपूजाफलप्रदं ।\nवाणेश्वर नमस्तुभ्यं गृह्णीष्वेदं पवित्रकं ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001992008, "chapter_id": 21992, "verse_number": "३७-९", "content_sanskrit": "पवित्रीकरणार्थाय वर्षपूजाफलप्रदं ।\nशक्तिदेव नमस्तुभ्यं गृह्णीष्वेदं पवित्रकं ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001992009, "chapter_id": 21992, "verse_number": "३७-१०", "content_sanskrit": "पवित्रीकरणार्थाय वर्षपूजाफलप्रदं ।\nनारायणमयं सूत्रमनिरुद्धमयं वरं ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001992010, "chapter_id": 21992, "verse_number": "३७-११", "content_sanskrit": "धनधान्यायुरारोग्यप्रदं सम्प्रददामि ते ।\nकामदेवमयं सूत्रं सङ्कर्षणमयं वरं ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001992011, "chapter_id": 21992, "verse_number": "३७-१२", "content_sanskrit": "विद्यासन्ततिसौभाग्यप्रदं सम्प्रददामि ते ।\nवासुदेवमयं सूत्रं धर्मकामार्थमोक्षदं ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001992012, "chapter_id": 21992, "verse_number": "३७-१३", "content_sanskrit": "संसारसागरोत्तारकारणं प्रददामि ते ।\nविश्वरूपमयं सूत्रं सर्वदं पापनाशनं ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001992013, "chapter_id": 21992, "verse_number": "३७-१४", "content_sanskrit": "अतीतानागतकुलसमुद्धारं ददामि ते ।\nकनिष्ठादीनि चत्वारि मनुभिस्तु क्रमाद्ददे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]