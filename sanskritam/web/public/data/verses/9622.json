[{"id": 5000622000, "chapter_id": 9622, "verse_number": "७-८७-१", "content_sanskrit": "तच्छ्रुत्वा लक्ष्मणेनोक्तं वाक्यं वाक्यविशारदः ।\nप्रत्युवाच महातेजाः प्रहसन्राघवो वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000622001, "chapter_id": 9622, "verse_number": "७-८७-२", "content_sanskrit": "एवमेव नरश्रेष्ठ यथा वदसि लक्ष्मण ।\nवृत्रघातमशेषेण वाजिमेधफलं च यत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000622002, "chapter_id": 9622, "verse_number": "७-८७-३", "content_sanskrit": "श्रूयते हि पुरा सौम्य कर्दमस्य प्रजापतेः ।\nपुत्रो बाह्लीश्वरः श्रीमानिलो नाम महाशयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000622003, "chapter_id": 9622, "verse_number": "७-८७-४", "content_sanskrit": "स राजा पृथिवीं सर्वां वशे कृत्वा सुधार्मिकः ।\nराज्यं चैव नरव्याघ्र पुत्रवत्पर्यपालयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000622004, "chapter_id": 9622, "verse_number": "७-८७-५", "content_sanskrit": "सुरैश्च परमोदारैर्दैतेयैश्च महाधनैः ।\nनागराक्षसगन्धर्वैर्यक्षैश्च सुमहात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000622005, "chapter_id": 9622, "verse_number": "७-८७-६", "content_sanskrit": "पूज्यते नित्यशः सौम्य भयार्तै रघुनन्दन ।\nअबिभ्यंश्च त्रयो लोकाः सरोषस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000622006, "chapter_id": 9622, "verse_number": "७-८७-७", "content_sanskrit": "स राजा तादृशो ह्यासीद्धर्मे वीर्ये च निष्ठितः ।\nबुद्ध्या च परमोदारो बाह्लीकेशो महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000622007, "chapter_id": 9622, "verse_number": "७-८७-८", "content_sanskrit": "स प्रचक्रे महाबाहुर्मृगयां रुचिरे वने ।\nचैत्रे मनोरमे मासि सभृत्यबलवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000622008, "chapter_id": 9622, "verse_number": "७-८७-९", "content_sanskrit": "प्रजघ्ने च नृपो ऽरण्ये मृगाञ्छतसहस्रशः ।\nहत्वैव तृप्तिर्नाभूच्च राज्ञस्तस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000622009, "chapter_id": 9622, "verse_number": "७-८७-१०", "content_sanskrit": "नानामृगाणामयुतं वध्यमानं महात्मना ।\nयत्र जातो माहासेनस्तं देशमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000622010, "chapter_id": 9622, "verse_number": "७-८७-११", "content_sanskrit": "तस्मिन्प्रदेशे देवेश शैलराजसुतां हरः ।\nरमयामास दुर्धर्षः सर्वैरनुचरैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000622011, "chapter_id": 9622, "verse_number": "७-८७-१२", "content_sanskrit": "कृत्वा स्त्रीरूपमात्मानमुमेशो गोपतिध्वजः ।\nदेव्याः प्रियचिकीर्षुः संस्तस्मिन्पर्वतनिर्झरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000622012, "chapter_id": 9622, "verse_number": "७-८७-१३", "content_sanskrit": "ये तु तत्र वनोद्देशे सत्त्वाः पुरुषवादिनः ।\nवृक्षाः पुरुषनामानस्ते ऽभवन् स्त्रीजनास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000622013, "chapter_id": 9622, "verse_number": "७-८७-१४", "content_sanskrit": "यच्च किञ्चन तत्सर्वं नारीसञ्ज्ञं बभूव ह ।\nएतस्मिन्नन्तरे राजा स इलः कर्दमात्मजः ।\nनिघ्नन्मृगसहस्राणि तं देशमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000622014, "chapter_id": 9622, "verse_number": "७-८७-१५", "content_sanskrit": "स दृष्ट्वा स्त्रीकृतं सर्वं सव्यालमृगपक्षकम् ।\nआत्मनं स्त्रीकृतं चैव सानुगं रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000622015, "chapter_id": 9622, "verse_number": "७-८७-१६", "content_sanskrit": "तस्य दुःखं महच्चासीद्दृष्ट्वा ऽ ऽत्मानं तथागतम् ।\nउमापतेश्च तत्कर्म ज्ञात्वा त्रासमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000622016, "chapter_id": 9622, "verse_number": "७-८७-१७", "content_sanskrit": "ततो देवं महात्मानं शितिकण्ठं कपर्दिनम् ।\nजगाम शरणं राजा सभृत्यबलवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000622017, "chapter_id": 9622, "verse_number": "७-८७-१८", "content_sanskrit": "ततः प्रहस्य वरदः सह देव्या महेश्वरः ।\nप्रजापतिसुतं वाक्यमुवाच वरदः स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000622018, "chapter_id": 9622, "verse_number": "७-८७-१९", "content_sanskrit": "उत्तिष्ठोत्तिष्ठ राजर्षे कार्दमेय महाबल ।\nपुरुषत्वमृते सौम्य वरं वरय सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000622019, "chapter_id": 9622, "verse_number": "७-८७-२०", "content_sanskrit": "ततः स राजा दुःखार्तः प्रत्याख्यातो महात्मना ।\nन च जग्राह स्त्रीभूतो वरमन्यं सुरोत्तमात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000622020, "chapter_id": 9622, "verse_number": "७-८७-२१", "content_sanskrit": "ततः शोकेन महता शैलराजसुतां नृपः ।\nप्रणिपत्य ह्युमां देवीं सर्वेणैवान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000622021, "chapter_id": 9622, "verse_number": "७-८७-२२", "content_sanskrit": "ईशे वराणां वरदे लोकानामसि भामिनी ।\nअमोघदर्शने देवी भज सौम्येन चक्षुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000622022, "chapter_id": 9622, "verse_number": "७-८७-२३", "content_sanskrit": "हृद्गतं तस्य राजर्षेर्विज्ञाय हरसन्निधौ ।\nप्रत्युवाच शुभं वाक्यं देवी रुद्रस्य संमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000622023, "chapter_id": 9622, "verse_number": "७-८७-२४", "content_sanskrit": "अर्धस्य देवो वरदो वरार्धस्य तव ह्यहम् ।\nतस्मादर्धं गृहाण त्वं स्त्रीपुंसोर्यावदिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000622024, "chapter_id": 9622, "verse_number": "७-८७-२५", "content_sanskrit": "तदद्भुततरं श्रुत्वा देव्या वरमनुत्तमम् ।\nसम्प्रहृष्टमना भूत्वा राजा वाक्यमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000622025, "chapter_id": 9622, "verse_number": "७-८७-२६", "content_sanskrit": "यदि देवि प्रसन्ना मे रूपेणाप्रतिमा भुवि ।\nमासं स्त्रीत्वमुपासित्वा मासं स्यां पुरुषः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000622026, "chapter_id": 9622, "verse_number": "७-८७-२७", "content_sanskrit": "ईप्सितं तस्य विज्ञाय देवी सुरुचिरानना ।\nप्रत्युवाच शुभं वाक्यमेवमेव भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000622027, "chapter_id": 9622, "verse_number": "७-८७-२८", "content_sanskrit": "राजन्पुरुषभूतस्त्वं स्त्रीभावं न स्मरिष्यसि ।\nस्त्रीभूतश्च परं मासं न स्मरिष्यसि पौरुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000622028, "chapter_id": 9622, "verse_number": "७-८७-२९", "content_sanskrit": "एवं स राजा पुरुषो मासं भूत्वाथ कार्दमिः ।\nत्रैलोक्यसुन्दरी नारी मासमेकमिला ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000622029, "chapter_id": 9622, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे सप्ताशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]