[{"id": 2003276, "chapter_id": 1067, "verse_number": "१-६८-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2003277, "chapter_id": 1067, "verse_number": "१-६८-१", "content_sanskrit": "देवानां दानवानां च गन्धर्वोरगरक्षसाम्।\nसिंहव्याघ्रमृगाणां च पन्नगानां पतत्त्रिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2003278, "chapter_id": 1067, "verse_number": "१-६८-२", "content_sanskrit": "अन्येषां चैव भूतानां संभवं भगवन्नहम्।\nश्रोतुमिच्छामि तत्त्वेन मानुषेषु महात्मनाम्।\nजन्म कर्म च भूतानामेतेषामनुपूर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2003279, "chapter_id": 1067, "verse_number": "१-६८-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2003280, "chapter_id": 1067, "verse_number": "१-६८-३", "content_sanskrit": "मानुषेषु मनुष्येन्द्र संभूता ये दिवौकसः।\nप्रथमं दानवाश्चैव तांस्ते वक्ष्यामि सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2003281, "chapter_id": 1067, "verse_number": "१-६८-४", "content_sanskrit": "विप्रचित्तिरिति ख्यातो य आसीद्दानवर्षभः।\nजरासन्ध इति ख्यातः स आसीन्मनुजर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2003282, "chapter_id": 1067, "verse_number": "१-६८-५", "content_sanskrit": "दितेः पुत्रस्तु यो राजन्हिरण्यकशिपुः स्मृतः।\nस जज्ञे मानुषे लोके शिशुपालो नरर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2003283, "chapter_id": 1067, "verse_number": "१-६८-६", "content_sanskrit": "संह्लाद इति विख्यातः प्रह्लादस्यानुजस्तु यः।\nस शल्य इति विख्यातो जज्ञे वाहीकपुङ्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2003284, "chapter_id": 1067, "verse_number": "१-६८-७", "content_sanskrit": "अनुह्लादस्तु तेजस्वी योऽभूत्ख्यातो जघन्यजः।\nधृष्टकेतुरिति ख्यातः स बभूव नरेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2003285, "chapter_id": 1067, "verse_number": "१-६८-८", "content_sanskrit": "यस्तु राजञ्शिबिर्नाम दैतेयः परिकीर्तितः।\nद्रुम इत्यभिविख्यातः स आसीद्भुवि पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2003286, "chapter_id": 1067, "verse_number": "१-६८-९", "content_sanskrit": "बाष्कलो नाम यस्तेषामासीदसुरसत्तमः।\nभगदत्त इति ख्यातः सं जज्ञे पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2003287, "chapter_id": 1067, "verse_number": "१-६८-१०", "content_sanskrit": "अयःशिरा अश्वशिरा अयःशङ्कुश्च वीर्यवान्।\nतथा गगनमूर्धा च वेगवांश्चात्र पञ्चमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2003288, "chapter_id": 1067, "verse_number": "१-६८-११", "content_sanskrit": "पञ्चैते जज्ञिरे राजन्वीर्यवन्तो महासुराः।\nकेकयेषु महात्मानः पार्थिवर्षभसत्तमाः।\nकेतुमानिति विख्यातो यस्ततोऽन्यःप्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2003289, "chapter_id": 1067, "verse_number": "१-६८-१२", "content_sanskrit": "अमितौजा इति ख्यातः सोग्रकर्मा नराधिपः।\nस्वर्भानुरिति विख्यातः श्रीमान्यस्तु महासुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2003290, "chapter_id": 1067, "verse_number": "१-६८-१३", "content_sanskrit": "उग्रसेन इति ख्यात उग्रकर्मा नराधिपः।\nयस्त्वश्व इति विख्यातः श्रीमानासीन्महासुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2003291, "chapter_id": 1067, "verse_number": "१-६८-१४", "content_sanskrit": "अशोको नाम राजाऽभून्महावीर्योऽपराजितः।\nतस्मादवरजो यस्तु राजन्नश्वपतिः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2003292, "chapter_id": 1067, "verse_number": "१-६८-१५", "content_sanskrit": "दैतेयः सोऽभवद्राजा हार्दिक्यो मनुजर्षभः।\nवृषपर्वेति विख्यातः श्रीमान्यस्तु महासुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2003293, "chapter_id": 1067, "verse_number": "१-६८-१६", "content_sanskrit": "दीर्घप्रज्ञ इति ख्यातः पृथिव्यां सोऽभवन्नृपः।\nअजकस्त्ववरो राजन्य आसीद्वृषपर्वणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2003294, "chapter_id": 1067, "verse_number": "१-६८-१७", "content_sanskrit": "स शाल्व इति विख्यातः पृथिव्यामभवन्नृपः।\nअश्वग्रीव इति ख्यातः सत्ववान्यो महासुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2003295, "chapter_id": 1067, "verse_number": "१-६८-१८", "content_sanskrit": "रोचमान इति ख्यातः पृथिव्यां कोऽभवन्नृपः।\nसूक्ष्मस्तु मतिमान्राजन्कीर्तिमान्यः प्रकीर्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2003296, "chapter_id": 1067, "verse_number": "१-६८-१९", "content_sanskrit": "बृहद्रथ इति ख्यातः क्षितावासीत्स पार्थिवः।\nतुहुण्ड इति विख्यातो य आसीदसुरोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2003297, "chapter_id": 1067, "verse_number": "१-६८-२०", "content_sanskrit": "सेनाबिन्दुरिति ख्यातः स बूभव नराधिपः।\nइषुमान्नाम यस्तेषामसुराणां बलाधिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2003298, "chapter_id": 1067, "verse_number": "१-६८-२१", "content_sanskrit": "नग्नजिन्नाम राजासीद्भुवि विख्यातविक्रमः।\nएकचक्र इति ख्यात आसीद्यस्तु महासुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2003299, "chapter_id": 1067, "verse_number": "१-६८-२२", "content_sanskrit": "प्रतिविन्घ्य इति ख्यातो बभूव प्रथितः क्षितौ।\nविरूपाक्षस्तु दैतेयश्चित्रयोधी महासुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2003300, "chapter_id": 1067, "verse_number": "१-६८-२३", "content_sanskrit": "चित्रधर्मेति विख्यातः क्षितावासीत्स पार्थिवः।\nहरस्त्वरिहरो वीर आसीद्यो दानवोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2003301, "chapter_id": 1067, "verse_number": "१-६८-२४", "content_sanskrit": "सुबाहुरिति विख्यातः श्रीमानासीत्स पार्थिवः।\nअहरस्तु महातेजाः शत्रुपक्षक्षयंकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2003302, "chapter_id": 1067, "verse_number": "१-६८-२५", "content_sanskrit": "बाह्लिको नाम राजा स बभूव प्रथितः क्षितौ।\nनिचन्द्रश्चन्द्रवक्त्रस्तु य आसीदसुरोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2003303, "chapter_id": 1067, "verse_number": "१-६८-२६", "content_sanskrit": "मुञ्जकेश इति ख्यातः श्रीमानासीत्स पार्थिवः।\nनिकुम्भस्त्वजितः संख्ये महामतिरजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2003304, "chapter_id": 1067, "verse_number": "१-६८-२७", "content_sanskrit": "भूमौ भूमिपतिश्रेष्ठो देवाधिप इति स्मृतः।\nशरभो नाम यस्तेषां दैतेयानां महासुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2003305, "chapter_id": 1067, "verse_number": "१-६८-२८", "content_sanskrit": "पौरवो नाम राजर्षिः स बभूव नरोत्तमः।\nकुपटस्तु महावीर्यः श्रीमान्राजन्महासुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2003306, "chapter_id": 1067, "verse_number": "१-६८-२९", "content_sanskrit": "सुपार्श्व इति विख्यातः क्षितौ जज्ञे महीपतिः।\nकपटस्तु राजन्राजर्षिः क्षितौ जज्ञे महासुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2003307, "chapter_id": 1067, "verse_number": "१-६८-३०", "content_sanskrit": "पार्वतेय इति ख्यातः काञ्चनाचलसन्निभः।\nद्वितीयः शलभस्तेषामसुराणां बभूव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2003308, "chapter_id": 1067, "verse_number": "१-६८-३१", "content_sanskrit": "प्रह्लादो नाम बाह्लीकः स बभूव नराधिपः।\nचन्द्रस्तु दितिजश्रेष्ठो लोके ताराधिपोपमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2003309, "chapter_id": 1067, "verse_number": "१-६८-३२", "content_sanskrit": "चन्द्रवर्मेति विख्यातः काम्बोजानां नराधिपः।\nअर्क इत्यभिविख्यातो यस्तु दानवपुङ्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2003310, "chapter_id": 1067, "verse_number": "१-६८-३३", "content_sanskrit": "ऋषिको नाम राजर्षिर्बभूव नृपसत्तमः।\nमृतपा इति विख्यातो य आसीदसुरोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2003311, "chapter_id": 1067, "verse_number": "१-६८-३४", "content_sanskrit": "पश्चिमानूपकं विद्धि तं नृपं नृपसत्तम।\nगविष्ठस्तु महातेजा यः प्रख्यातो महासुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2003312, "chapter_id": 1067, "verse_number": "१-६८-३५", "content_sanskrit": "द्रुमसेन इति ख्यातः पृथिव्यां सोऽभवन्नृपः।\nमयूर इति विख्यातः श्रीमान्यस्तु महासुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2003313, "chapter_id": 1067, "verse_number": "१-६८-३६", "content_sanskrit": "स विश्व इति विख्यातो बभूव पृथिवीपतिः।\nसुपर्ण इति विख्यातस्तस्मादवरजस्तु यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2003314, "chapter_id": 1067, "verse_number": "१-६८-३७", "content_sanskrit": "कालकीर्तिरिति ख्यातः पृथिव्यां सोऽभवन्नृपः।\nचन्द्रहन्तेति यस्तेषां कीर्तितः प्रवरोऽसुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2003315, "chapter_id": 1067, "verse_number": "१-६८-३८", "content_sanskrit": "शुनको नाम राजर्षिः स बभूव नराधिपः।\nविनाशनस्तु चन्द्रस्य य आख्यातो महासुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2003316, "chapter_id": 1067, "verse_number": "१-६८-३९", "content_sanskrit": "जानकिर्नाम विख्यातः सोऽभवन्मनुजाधिपः।\nदीर्घजिह्वस्तु कौरव्य य उक्तो दानवर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2003317, "chapter_id": 1067, "verse_number": "१-६८-४०", "content_sanskrit": "काशिराजः स विख्यातः पृथिव्यां पृथिवीपते।\nग्रहं तु सुषुवे यं तु सिंहिकार्केन्दुमर्दनम्।\nस क्राथ इति विख्यातो बभूव मनुजाधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2003318, "chapter_id": 1067, "verse_number": "१-६८-४१", "content_sanskrit": "दनायुषस्तु पुत्राणां चतुर्णां प्रवरोऽसुरः।\nविक्षरो नाम तेजस्वी वसुमित्रो नृपः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2003319, "chapter_id": 1067, "verse_number": "१-६८-४२", "content_sanskrit": "द्वितीयो विक्षराद्यस्तु नराधिप महासुरः।\nपाण्ड्यराष्ट्राधिप इति विख्यातः सोऽभवन्नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2003320, "chapter_id": 1067, "verse_number": "१-६८-४३", "content_sanskrit": "बली वीर इति ख्यातो यस्त्वासीदसुरोत्तमः।\nपौण्ड्रमात्स्यक इत्येवं बभूव स नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2003321, "chapter_id": 1067, "verse_number": "१-६८-४४", "content_sanskrit": "वृत्र इत्यभिविख्यातो यस्तु राजन्महासुरः।\nमणिमान्नाम राजर्षिः स बभूव नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2003322, "chapter_id": 1067, "verse_number": "१-६८-४५", "content_sanskrit": "क्रोधहन्तेति यस्तस्य बभूवावरजोऽसुरः।\nदण्ड इत्यभिविख्यातः स आसीन्नृपतिः क्षितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2003323, "chapter_id": 1067, "verse_number": "१-६८-४६", "content_sanskrit": "क्रोधवर्धन इत्येवं यस्त्वन्यः परिकीर्तितः।\nदण्डधार इति ख्यातः सोऽभवन्मनुजर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2003324, "chapter_id": 1067, "verse_number": "१-६८-४७", "content_sanskrit": "कालेयानां तु ये पुत्रास्तेषामष्टौ नराधिपाः।\nजज्ञिरे राजशार्दूल शार्दूलसमविक्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2003325, "chapter_id": 1067, "verse_number": "१-६८-४८", "content_sanskrit": "मगधेषु जयत्सेनस्तेषामासीत्स पार्थिवः।\nअष्टानां प्रवरस्तेषां कालेयानां महासुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2003326, "chapter_id": 1067, "verse_number": "१-६८-४९", "content_sanskrit": "द्वितीयस्तु ततस्तेषां श्रीमान्हरिहयोपमः।\nअपराजित इत्येवं स बभूव नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2003327, "chapter_id": 1067, "verse_number": "१-६८-५०", "content_sanskrit": "तृतीयस्तु महातेजा महामायो महासुरः।\nनिषादाधिपतिर्जज्ञे भुवि भीमपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2003328, "chapter_id": 1067, "verse_number": "१-६८-५१", "content_sanskrit": "तेषामन्यतमो यस्तु चतुर्थः परिकीर्तितः।\nश्रेणिमानिति विख्यातः क्षितौ राजर्षिसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2003329, "chapter_id": 1067, "verse_number": "१-६८-५२", "content_sanskrit": "पञ्चमस्त्वभवत्तेषां प्रवरो यो महासुरः।\nमहौजा इति विख्यातो बभूवेह परन्दपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2003330, "chapter_id": 1067, "verse_number": "१-६८-५३", "content_sanskrit": "षष्ठस्तु मतिमान्यो वै तेषामासीन्महासुरः।\nअभीरुरिति विख्यातः क्षितौ राजर्षिसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2003331, "chapter_id": 1067, "verse_number": "१-६८-५४", "content_sanskrit": "समुद्रसेनस्तु नृपस्तेषामेवाभवद्गणात्।\nविश्रुतः सागरान्तायां क्षितौ धर्मार्थतत्त्ववित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2003332, "chapter_id": 1067, "verse_number": "१-६८-५५", "content_sanskrit": "बृहन्नामाष्टमस्तेषां कालेयानां नराधिप।\nबभूव राजा धर्मात्मा सर्वभूतहिते रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2003333, "chapter_id": 1067, "verse_number": "१-६८-५६", "content_sanskrit": "कुक्षिस्तु राजन्विख्यातो दानवानां महाबलः।\nपार्वतीय इति ख्यातः काञ्चनाचलसन्निभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2003334, "chapter_id": 1067, "verse_number": "१-६८-५७", "content_sanskrit": "क्रथनश्च महावीर्यः श्रीमान्राजा महासुरः।\nसूर्याक्ष इति विख्यातः क्षितौ जज्ञे महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2003335, "chapter_id": 1067, "verse_number": "१-६८-५८", "content_sanskrit": "असुराणां तु यः सकूर्यः श्रीमांश्चैव महासुरः।\nदरदो नाम बाह्लीको वरः सर्वमहीक्षिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2003336, "chapter_id": 1067, "verse_number": "१-६८-५९", "content_sanskrit": "गणः क्रोधवशो नाम यस्ते राजन्प्रकीर्तितः।\nततः संजज्ञिरे वीराः क्षिताविह नराधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2003337, "chapter_id": 1067, "verse_number": "१-६८-६०", "content_sanskrit": "मद्रकः कर्णवेष्टश्च सिद्धार्थः कीटकस्तथा।\nसुवीरश्च सुबाहुश्च महावीरोऽथ बाह्लिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2003338, "chapter_id": 1067, "verse_number": "१-६८-६१", "content_sanskrit": "क्रथो विचित्रः सुरथः श्रीमान्नीलश्च भूमिपः।\nचीरवासाश्च कौरव्य भूमिपालश्च नामतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2003339, "chapter_id": 1067, "verse_number": "१-६८-६२", "content_sanskrit": "दन्तवक्त्रश्च नामासीद्दुर्जयश्चैव दानवः।\nरुक्मी च नृपशार्दूलो राजा च जनमेजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2003340, "chapter_id": 1067, "verse_number": "१-६८-६३", "content_sanskrit": "आषाढो वायुवेगश्च भूरितेजास्तथैव च।\nएकलव्यः सुमित्रश्च वाटधानोऽथ गोमुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2003341, "chapter_id": 1067, "verse_number": "१-६८-६४", "content_sanskrit": "कारूषकाश्च राजानः क्षेमधूर्तिस्तथैव च।\nश्रुतायुरुद्वहश्चैव बृहत्सेनस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2003342, "chapter_id": 1067, "verse_number": "१-६८-६५", "content_sanskrit": "क्षेमोग्रतीर्थः कुहरः कलिङ्गेषु नराधिपः।\nमतिमांश्च मनुष्येन्द्र ईश्वरश्चेति विश्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2003343, "chapter_id": 1067, "verse_number": "१-६८-६६", "content_sanskrit": "गणात्क्रोधवशादेष राजपूगोऽभवत्क्षितौ।\nजातः पुरा महाभागो महाकीर्तिर्महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2003344, "chapter_id": 1067, "verse_number": "१-६८-६७", "content_sanskrit": "कालनेमिरिति ख्यातो दानवानां महाबलः।\nस कंस इति विख्यात उग्रसेनसुतो बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2003345, "chapter_id": 1067, "verse_number": "१-६८-६८", "content_sanskrit": "यस्त्वासीद्देवको नाम देवराजसमद्युतिः।\nस गन्धर्वपतिर्मुख्यः क्षितौ जज्ञे नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2003346, "chapter_id": 1067, "verse_number": "१-६८-६९", "content_sanskrit": "बृहस्पतेर्बृहत्कीर्तेर्देवर्षेर्विद्धि भारत।\nअशाद्द्रोणं समुत्पन्नं भारद्वाजमयोनिजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2003347, "chapter_id": 1067, "verse_number": "१-६८-७०", "content_sanskrit": "धन्विनां नृपशार्दूल यः सर्वास्त्रविदुत्तमः।\nमहाकीर्तिर्महातेजाः स जज्ञे मनुजेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2003348, "chapter_id": 1067, "verse_number": "१-६८-७१", "content_sanskrit": "धनुर्वेदे च वेदे च यं तं वेदविदो विदुः।\nवरिष्ठं चित्रकर्माणं द्रोणं स्वकुलवर्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2003349, "chapter_id": 1067, "verse_number": "१-६८-७२", "content_sanskrit": "महादेवान्तकाभ्यां च कामात्क्रोधाच्च भारत।\nएकत्वमुपसंपद्य जज्ञे शूरः परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2003350, "chapter_id": 1067, "verse_number": "१-६८-७३", "content_sanskrit": "अश्वत्थामा महावीर्यः शत्रुपक्षभयावहः।\nवीरः कमलपत्राक्षः क्षितावासीन्नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2003351, "chapter_id": 1067, "verse_number": "१-६८-७४", "content_sanskrit": "जज्ञिरे वसवस्त्वष्टौ गङ्गायां शन्तनोः सुताः।\nवसिष्ठस्य च शापेन नियोगाद्वासवस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2003352, "chapter_id": 1067, "verse_number": "१-६८-७५", "content_sanskrit": "तेषामवरजो भीष्मः कुरूणामभयङ्करः।\nमतिमान्वेदविद्वाग्मी शत्रुपक्षक्षयङ्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2003353, "chapter_id": 1067, "verse_number": "१-६८-७६", "content_sanskrit": "जामदग्न्येन रामेण सर्वास्त्रविदुषां वरः।\nयोऽप्युध्यत महातेजा भार्गवेण महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2003354, "chapter_id": 1067, "verse_number": "१-६८-७७", "content_sanskrit": "यस्तु राजन्कृपो नाम ब्रह्मर्षिरभवत्क्षितौ।\nरुद्राणां तु गणाद्विद्धि संभूतमतिपौरुषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2003355, "chapter_id": 1067, "verse_number": "१-६८-७८", "content_sanskrit": "शकुनिर्नाम यस्त्वासीद्राजा लोके महारथः।\nद्वापरं विद्धि तं राजन्संभूतमरिमर्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2003356, "chapter_id": 1067, "verse_number": "१-६८-७९", "content_sanskrit": "सात्यकिः सत्यसन्धश्च योऽसौ वृष्णिकुलोद्वहः।\nपक्षात्स जज्ञे मरुतां देवानामरिमर्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2003357, "chapter_id": 1067, "verse_number": "१-६८-८०", "content_sanskrit": "द्रुपदश्चैव राजर्षिस्तत एवाभवद्गणात्।\nमानुषे नृप लोकेऽस्मिन्सर्वशस्त्रभृतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2003358, "chapter_id": 1067, "verse_number": "१-६८-८१", "content_sanskrit": "ततश्च कृतवर्माणं विद्धि राजञ्जनाधिपम्।\nतमप्रतिमकर्माणं क्षत्रियर्षभसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2003359, "chapter_id": 1067, "verse_number": "१-६८-८२", "content_sanskrit": "मरुतां तु गणाद्विद्धि संजातमरिमर्दनम्।\nविराटं नाम राजानं परराष्ट्रप्रतापनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2003360, "chapter_id": 1067, "verse_number": "१-६८-८३", "content_sanskrit": "अरिष्टायास्तु यः पुत्रो हंस इत्यभिविश्रुतः।\nस गन्धर्वपतिर्जज्ञे कुरुवंशविवर्धनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2003361, "chapter_id": 1067, "verse_number": "१-६८-८४", "content_sanskrit": "धृतराष्ट्र इति ख्यातः कृष्णद्वैपायनात्मजः।\nदीर्घबाहुर्महातेजाः प्रज्ञाचक्षुर्नराधिपः॥\nमातुर्दोषादृषेः कोपादन्ध एव व्यजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2003362, "chapter_id": 1067, "verse_number": "१-६८-८५", "content_sanskrit": "मरुतां तु गणाद्वीरः सर्वशस्त्रभृतां वरः।\nपाण्डुर्जज्ञे महाबाहुस्तव पूर्वपितामहः।\nतस्यैवावरजो भ्राता महासत्वो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2003363, "chapter_id": 1067, "verse_number": "१-६८-८६", "content_sanskrit": "धर्मात्तु सुमहाभागं पुत्रं पुत्रवतां वरम्।\nविदुरं विद्धि तं लोके जातं बुद्धिमतां वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2003364, "chapter_id": 1067, "verse_number": "१-६८-८७", "content_sanskrit": "कलेरंशस्तु संजज्ञे भुवि दुर्योधनो नृपः।\nदुर्बद्धिर्दुर्मतिश्चैव कुरूणामयशस्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2003365, "chapter_id": 1067, "verse_number": "१-६८-८८", "content_sanskrit": "जगतो यस्तु सर्वस्य विद्विष्टः कलिपूरुषः।\nयः सर्वां घातयामास पृथिवीं पृथिवीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2003366, "chapter_id": 1067, "verse_number": "१-६८-८९", "content_sanskrit": "उद्दीपितं येन वैरं भूतान्तकरणं महत्।\nपौलस्त्या भ्रातरश्चास्य जज्ञिरे मनुजेष्विह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2003367, "chapter_id": 1067, "verse_number": "१-६८-९०", "content_sanskrit": "शतं दुःशासनादीनां सर्वेषां क्रूरकर्मणाम्।\nदुर्मुखो दुःसहश्चैव ये चान्ये नानुकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2003368, "chapter_id": 1067, "verse_number": "१-६८-९१", "content_sanskrit": "दुर्योधनसहायास्ते पौलस्त्या भरतर्षभ।\nवैश्यापुत्रो युयुत्सुश्च धार्तराष्ट्रः शताधिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2003369, "chapter_id": 1067, "verse_number": "१-६८-९२x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2003370, "chapter_id": 1067, "verse_number": "१-६८-९२", "content_sanskrit": "ज्येष्ठानुज्येष्ठतामेषां नामधेयानि वा विभो।\nधृतराष्ट्रस्य पुत्राणामानुपूर्व्येण कीर्तय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2003371, "chapter_id": 1067, "verse_number": "१-६८-९३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2003372, "chapter_id": 1067, "verse_number": "१-६८-९३", "content_sanskrit": "दुर्योधनो युयुत्सुश्च राजन्दुःशासनस्तथा।\nदुःसहो दुःशलश्चैव दुर्मुखश्च तथापरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2003373, "chapter_id": 1067, "verse_number": "१-६८-९४", "content_sanskrit": "विविंशतिर्विकर्णश्च जलसन्धः सुलोचनः।\nविन्दानुविन्दौ दुर्धर्षः सुबाहुर्दुष्प्रधर्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2003374, "chapter_id": 1067, "verse_number": "१-६८-९५", "content_sanskrit": "दुर्मर्षणो दुर्मुखश्च दुष्कर्णः कर्ण एव च।\nचत्रोपचित्रौ चित्राक्षश्चारुचित्राङ्गदश्च ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2003375, "chapter_id": 1067, "verse_number": "१-६८-९६", "content_sanskrit": "दुर्मदो दुष्प्रहर्षश्च विवित्सुर्विकटः समः।\nऊर्णनाभः पद्मनाभस्तथा नन्दोपनन्दकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2003376, "chapter_id": 1067, "verse_number": "१-६८-९७", "content_sanskrit": "सेनापतिः सुषेणश्च कुण्डोदरमहोदरौ।\nचित्रबाहुश्चित्रवर्मा सुवर्मा दुर्विरोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2003377, "chapter_id": 1067, "verse_number": "१-६८-९८", "content_sanskrit": "अयोबाहुर्महाबाहुश्चित्रचापसुकुण्डलौ।\nभीमवेगो भीमबलो बलाकी भीमविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2003378, "chapter_id": 1067, "verse_number": "१-६८-९९", "content_sanskrit": "उग्रायुधो भीमशरः कनकायुर्दृढायुधः।\nदृढवर्मा दृढक्षत्रः सोमकीर्तिरनूदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2003379, "chapter_id": 1067, "verse_number": "१-६८-१००", "content_sanskrit": "जरासन्धो दृढसन्धः सत्यसन्धः सहस्रवाक्।\nउग्रश्रवा उग्रसेनः क्षेममूर्तिस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2003380, "chapter_id": 1067, "verse_number": "१-६८-१०१", "content_sanskrit": "अपराजितः पण्डितको विशालाक्षो दुराधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2003381, "chapter_id": 1067, "verse_number": "१-६८-१०२", "content_sanskrit": "दृढहस्तः सुहस्तश्च वातवेगसुवर्चसौ।\nआदित्यकेतुर्बह्वाशी नागदत्तानुयायिनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2003382, "chapter_id": 1067, "verse_number": "१-६८-१०३", "content_sanskrit": "कवाची निषङ्गी दण्डी दण्डधारो धनुर्ग्रहः।\nउग्रो भीमरथो वीरो वीरबाहुरलोलुपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2003383, "chapter_id": 1067, "verse_number": "१-६८-१०४", "content_sanskrit": "अभयो रौद्रकर्मा च तथा दृढरथश्च यः।\nअनाधृष्यः कुम्डभेदी विरावी दीर्घलोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2003384, "chapter_id": 1067, "verse_number": "१-६८-१०५", "content_sanskrit": "दीर्घबाहुर्महाबाहुर्व्यूढोरुः कनकाङ्गदः।\nकुण्डजश्चित्रकश्चैव दुःशला च शताधिका॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2003385, "chapter_id": 1067, "verse_number": "१-६८-१०६", "content_sanskrit": "वैश्यापुत्रो युयुत्सुश्च धार्तराष्ट्रः शताधिकः।\nएतदेकशतं राजन्कन्या चैका प्रकीर्तिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2003386, "chapter_id": 1067, "verse_number": "१-६८-१०७", "content_sanskrit": "नामधेयानुपूर्व्या च ज्येष्ठानुज्येष्ठतां विदुः।\nसर्वे त्वतिरथाः शूराः सर्वे युद्धविशारदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2003387, "chapter_id": 1067, "verse_number": "१-६८-१०८", "content_sanskrit": "सर्वे वेदविदश्चैव राजञ्शास्त्रे च परागाः।\nसर्वे सङ्घ्रामविद्यासु विद्याभिजनशोभिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2003388, "chapter_id": 1067, "verse_number": "१-६८-१०९", "content_sanskrit": "सर्वेषामनुरूपाश्च कृता दारा महीपते।\nदुःशलां समये राजसिन्धुराजाय कौरवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2003389, "chapter_id": 1067, "verse_number": "१-६८-११०", "content_sanskrit": "जयद्रथाय प्रददौ सौबलानुमते तदा।\nधर्मस्यांशं तु राजानं विद्धि राजन्युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2003390, "chapter_id": 1067, "verse_number": "१-६८-१११", "content_sanskrit": "भीमसेनं तु वातस्य देवराजस्य चार्जुनम्।\nअश्विनोस्तु तथैवांशौ रूपेणाप्रतिमौ भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2003391, "chapter_id": 1067, "verse_number": "१-६८-११२", "content_sanskrit": "नकुलः सहदेवश्च सर्वभूतमनोहरौ।\nस्युवर्चा इति ख्यातः सोमपुत्रः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2003392, "chapter_id": 1067, "verse_number": "१-६८-११३", "content_sanskrit": "सोऽभिमन्युर्बृहत्कीर्तिरर्जुनस्य सुतोऽभवत्।\nयस्यावतरणे राजन्सुरान्सोमोऽब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2003393, "chapter_id": 1067, "verse_number": "१-६८-११४", "content_sanskrit": "नाहं दद्यां प्रियं पुत्रं मम प्राणैर्गरीयसम्।\nसमयः क्रियतामेष न शक्यमतिवर्तितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2003394, "chapter_id": 1067, "verse_number": "१-६८-११५", "content_sanskrit": "सुरकार्यं हि नः कार्यमसुराणां क्षितौ वधः।\nतत्र यास्यत्ययं वर्चा न च स्थास्यति वै चिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2003395, "chapter_id": 1067, "verse_number": "१-६८-११६", "content_sanskrit": "ऐन्द्रिर्नरस्तु भविता यस्य नारायणः सखा।\nसोर्जुनेत्यभिविख्यातः पाण्डोः पुत्रः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2003396, "chapter_id": 1067, "verse_number": "१-६८-११७", "content_sanskrit": "तस्यायं भविता पुत्रो बालो भुवि महारथः।\nततः षोडशवर्षाणि स्थास्यत्यमरसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2003397, "chapter_id": 1067, "verse_number": "१-६८-११८", "content_sanskrit": "अस्य षोडशवर्षस्य स सङ्ग्रामो भविष्यति।\nयत्रांशा वः करिष्यन्ति कर्म वीरनिषूदनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2003398, "chapter_id": 1067, "verse_number": "१-६८-११९", "content_sanskrit": "नरनारायणाभ्यां तु स सङ्ग्रामो विनाकृतः।\nचक्रव्यूहं समास्थाय योधयिष्यन्ति वःसुराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2003399, "chapter_id": 1067, "verse_number": "१-६८-१२०", "content_sanskrit": "विमुखाञ्छात्रवान्सर्वान्कारयिष्यति मे सुतः।\nबालः प्रविश्य च व्यूहमभेद्यं विचरिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2003400, "chapter_id": 1067, "verse_number": "१-६८-१२१", "content_sanskrit": "महारथानां वीराणां कदनं च करिष्यति।\nसर्वेषामेव शत्रूणां चतुर्थांशं नयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2003401, "chapter_id": 1067, "verse_number": "१-६८-१२२", "content_sanskrit": "दिनार्धेन महाबाहुः प्रेतराजपुरं प्रति।\nततो महारथैर्वीरैः समेत्य बहुशो रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2003402, "chapter_id": 1067, "verse_number": "१-६८-१२३", "content_sanskrit": "दिनक्षये महाबाहुर्मया भूयः समेष्यति।\nएकं वंशकरं पुत्रं वीरं वै जनयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2003403, "chapter_id": 1067, "verse_number": "१-६८-१२४", "content_sanskrit": "प्रनष्टं भारतं वंशं स भूयो धारयिष्यति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2003404, "chapter_id": 1067, "verse_number": "१-६८-१२४x", "content_sanskrit": "वैशम्पायन उवाच।\nएतत्सोमवचः श्रुत्वा तथास्त्विति दिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2003405, "chapter_id": 1067, "verse_number": "१-६८-१२५", "content_sanskrit": "प्रत्यूचुः सहिताः सर्वे ताराधिपमपूजयन्।\nएवं ते कथितं राजंस्तव जन्म पितुः पितुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2003406, "chapter_id": 1067, "verse_number": "१-६८-१२६", "content_sanskrit": "अग्नेर्भागं तु विद्धि त्वं धृष्टद्युम्नं महारथण्।\nशिखण्डिनमथो राजंस्त्रीपूर्वं विद्धि राक्षसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2003407, "chapter_id": 1067, "verse_number": "१-६८-१२७", "content_sanskrit": "द्रौपदेयाश्च ये पञ्च बभूवुर्भरतर्षभ।\nविश्वान्देवगणान्विद्धि संजातान्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2003408, "chapter_id": 1067, "verse_number": "१-६८-१२८", "content_sanskrit": "प्रतिविन्ध्यः सुतसोमः श्रुतकीर्तिस्तथापरः।\nनाकुलिस्तु शतानीकः श्रुतसेनश्च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2003409, "chapter_id": 1067, "verse_number": "१-६८-१२९", "content_sanskrit": "शूरो नाम यदुश्रेष्ठो वसुदेवपिताऽभवत्।\nतस्य कन्या पृथा नाम रूपेणासदृशी भुवि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2003410, "chapter_id": 1067, "verse_number": "१-६८-१३०", "content_sanskrit": "पितुः स्वस्रीयपुत्राय सोऽनपत्याय वीर्यवान्।\nअग्रमग्रे प्रतिज्ञाय स्वस्यापत्यस्य वै तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2003411, "chapter_id": 1067, "verse_number": "१-६८-१३१", "content_sanskrit": "अग्रजातेति तां कन्यां शूरोऽनुग्रहकाङ्क्षया।\nअददत्कुन्तिभोजाय स तां दुहितरं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2003412, "chapter_id": 1067, "verse_number": "१-६८-१३२", "content_sanskrit": "सा नियुक्ता पितुर्गेहे ब्राह्मणातिथिपूजने।\nउग्रं पर्यचरद्धोरं ब्राह्मणं संशितव्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2003413, "chapter_id": 1067, "verse_number": "१-६८-१३३", "content_sanskrit": "निकूढनिश्चयं धर्मे यं तं दुर्वाससं विदुः।\nसमुग्रं शंसितात्मानं सर्वयत्नैरतोषयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2003414, "chapter_id": 1067, "verse_number": "१-६८-१३४", "content_sanskrit": "तुष्टोऽभिचारसंयुक्तमाचचक्षे यथाविधि।\nउवाच चैनां भगवान्प्रीतोऽस्मि सुभगे तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2003415, "chapter_id": 1067, "verse_number": "१-६८-१३५", "content_sanskrit": "यं यं देवं त्वमेतेन मन्त्रेणावाहयिष्यसि।\nतस्य तस्य प्रसादात्त्वं देवि पुत्राञ्जनिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2003416, "chapter_id": 1067, "verse_number": "१-६८-१३६", "content_sanskrit": "एवमुक्ता च सा बाला तदा कौतूहलान्विता।\nकन्या सती देवमर्कमाजुहाव यशस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 2003417, "chapter_id": 1067, "verse_number": "१-६८-१३७", "content_sanskrit": "प्रकाशकर्ता भगवांस्तस्यां गर्भं दधौ तदा।\nअजीजनत्सुतं चास्यां सर्वशस्त्रभृतांवरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 2003418, "chapter_id": 1067, "verse_number": "१-६८-१३८", "content_sanskrit": "सकुण्डलं सकवचं देवगर्भं श्रियान्वितम्।\nदिवाकरसमं दीप्त्या चारुसर्वाङ्गभूषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 2003419, "chapter_id": 1067, "verse_number": "१-६८-१३९", "content_sanskrit": "निगूहमाना जातं वै बन्धुपक्षभयात्तदा।\nउत्ससर्ज जले कुन्ती तं कुमारं यशस्विनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 2003420, "chapter_id": 1067, "verse_number": "१-६८-१४०", "content_sanskrit": "तमुत्सृष्टं जले गर्भं राधाभर्ता महायशाः।\nराधायाः कल्पयामास पुत्रं सोऽधिरथस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 2003421, "chapter_id": 1067, "verse_number": "१-६८-१४१", "content_sanskrit": "चक्रतुर्नामधेयं च तस्य बालस्य तावुभौ।\nदंपती वसुषेणेति दिक्षु सर्वासु विश्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 2003422, "chapter_id": 1067, "verse_number": "१-६८-१४२", "content_sanskrit": "संवर्धमानो बलवान्सर्वास्त्रेषूत्तमोऽभवत्।\nवेदाङ्गानि च सर्वाणि जजाप जपतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 2003423, "chapter_id": 1067, "verse_number": "१-६८-१४३", "content_sanskrit": "यस्मिन्काले जपन्नास्ते धीमान्सत्यपराक्रमः।\nनादेयं ब्राह्मणेष्वासीत्तस्मिन्काले महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 2003424, "chapter_id": 1067, "verse_number": "१-६८-१४४", "content_sanskrit": "तमिन्द्रो ब्राह्मणो भूत्वा पुत्रार्थे भूतभावनः।\nययाचे कुण्डले वीरं कवचं च सहाङ्गजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 2003425, "chapter_id": 1067, "verse_number": "१-६८-१४५", "content_sanskrit": "उत्कृत्य कर्णो ह्यददत्कवचं कुण्डले तथा॥\nशक्तिं शक्रो ददौ तस्मै विस्मितश्चेदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 2003426, "chapter_id": 1067, "verse_number": "१-६८-१४६", "content_sanskrit": "देवासुरमनुष्याणां गन्धर्वोरगरक्षसाम्।\nयस्मिन्क्षेप्स्यसि दुर्धर्ष स एको न भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 2003427, "chapter_id": 1067, "verse_number": "१-६८-१४७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 2003428, "chapter_id": 1067, "verse_number": "१-६८-१४७", "content_sanskrit": "पुरा नाम च तस्यासीद्वसुषेण इति क्षितौ।\nततो वैकर्तनः कर्णः कर्मणा तेन सोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 2003429, "chapter_id": 1067, "verse_number": "१-६८-१४८", "content_sanskrit": "आमुक्तकवचो वीरो यस्तु जज्ञे महायशाः।\nस कर्ण इति विख्यातः पृथायाः प्रथमः सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}, {"id": 2003430, "chapter_id": 1067, "verse_number": "१-६८-१४९", "content_sanskrit": "स तु सूतकुले वीरो ववृधे राजसत्तम।\nकर्णं नरवरश्रेष्ठं सर्वशस्त्रभृतां वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 155}, {"id": 2003431, "chapter_id": 1067, "verse_number": "१-६८-१५०", "content_sanskrit": "दुर्योधनस्य सचिवं मित्रं शत्रुविनाशनम्।\nदिवाकरस्य तं विद्धि राजन्नंशमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 156}, {"id": 2003432, "chapter_id": 1067, "verse_number": "१-६८-१५१", "content_sanskrit": "यस्तु नारायणो नाम देवदेवः सनातनः।\nतस्यांशो मानुषेष्वासीद्वासुदेवः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 157}, {"id": 2003433, "chapter_id": 1067, "verse_number": "१-६८-१५२", "content_sanskrit": "शेषस्यांशश्च नागस्य बलदेवो महाबलः।\nसनत्कुमारं प्रद्युम्नं विद्धि राजन्महौजसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 158}, {"id": 2003434, "chapter_id": 1067, "verse_number": "१-६८-१५३", "content_sanskrit": "एवमन्ये मनुष्येन्द्रा बहवोंशा दिवौकसाम्।\nजज्ञिरे वसुदेवस्य कुले कुलविवर्धनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 159}, {"id": 2003435, "chapter_id": 1067, "verse_number": "१-६८-१५४", "content_sanskrit": "गणस्त्वप्सरसां यो वै मया राजन्प्रकीर्तितः।\nतस्य भागः क्षितौ जज्ञे नियोगाद्वासवस्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 160}, {"id": 2003436, "chapter_id": 1067, "verse_number": "१-६८-१५५", "content_sanskrit": "तानि षोडशदेवीनां सहस्राणि नराधिप।\nबभूवुर्मानुषे लोके वासुदेवपरिग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 161}, {"id": 2003437, "chapter_id": 1067, "verse_number": "१-६८-१५६", "content_sanskrit": "श्रियस्तु भागः संजज्ञे रत्यर्थं पृथिवीतले।\n[भीष्मकस्य कुले साध्वी रुक्मिणी नाम नामतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 162}, {"id": 2003438, "chapter_id": 1067, "verse_number": "१-६८-१५७", "content_sanskrit": "द्रौपदी त्वथ संजज्ञे शची भागादनिन्दिता।]\nद्रुपदस्य कुले जाता वेदिमध्यादनिन्दिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 163}, {"id": 2003439, "chapter_id": 1067, "verse_number": "१-६८-१५८", "content_sanskrit": "नातिह्रस्वा न महती नीलोत्पलसुगन्धिनी।\nपद्मायताक्षी सुश्रोणी स्वसिताञ्चितमूर्धजा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 164}, {"id": 2003440, "chapter_id": 1067, "verse_number": "१-६८-१५९", "content_sanskrit": "सर्वलक्षणसंपन्ना वैदूर्यमणिसंनिभा।\nपञ्चानां पुरुषेन्द्राणां चित्तप्रमथनी रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 165}, {"id": 2003441, "chapter_id": 1067, "verse_number": "१-६८-१६०", "content_sanskrit": "सिद्धिर्धृतिश्च ये देव्यौ पञ्चानां मातरौ तु ते।\nकुन्ती माद्री च जज्ञाते मतिस्तु कुबलात्मजा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 166}, {"id": 2003442, "chapter_id": 1067, "verse_number": "१-६८-१६१", "content_sanskrit": "इति देवासुराणां ते गन्धर्वाप्सरसां तथा।\nअंशावतरणं राजन्राक्षसानां च कीर्तितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 167}, {"id": 2003443, "chapter_id": 1067, "verse_number": "१-६८-१६२", "content_sanskrit": "ये पृथिव्यां समुद्भूता राजानो युद्धदुर्मदाः।\nमहात्मानो यदूनां च ये जाता विपुले कुले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 168}, {"id": 2003444, "chapter_id": 1067, "verse_number": "१-६८-१६३", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्या मया ते परिकीर्तिताः।\nधन्यं यशस्यं पुत्रीयमायुष्यं विजयावहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 169}, {"id": 2003445, "chapter_id": 1067, "verse_number": "१-६८-१६४", "content_sanskrit": "इदमंशावतरणं श्रोतव्यमनसूयता।\nअंशावतरणं श्रुत्वा देवगन्धर्वरक्षसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 170}, {"id": 2003446, "chapter_id": 1067, "verse_number": "१-६८-१६५", "content_sanskrit": "प्रभवाप्ययवित्प्राज्ञो न कृच्छ्रेष्ववसीदति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 171}, {"id": 2003447, "chapter_id": 1067, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि अष्टषष्टितमोऽध्यायः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 172}]