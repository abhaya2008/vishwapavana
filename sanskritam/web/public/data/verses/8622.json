[{"id": 900008203, "chapter_id": 8622, "verse_number": "3.1", "content_sanskrit": "जिज्ञासाकारणीभूतगुणपूर्तिप्रसिद्धये", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008204, "chapter_id": 8622, "verse_number": "3.2", "content_sanskrit": "अत्र ‘‘तद्विजिज्ञासस्व तद् ब्रह्म’’", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008205, "chapter_id": 8622, "verse_number": "3.3", "content_sanskrit": "न च जिज्ञास्येऽपि रूढिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008206, "chapter_id": 8622, "verse_number": "3.4", "content_sanskrit": "नन्वत्रापि जिज्ञास्यत्वमेव बाधकम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008207, "chapter_id": 8622, "verse_number": "3.5", "content_sanskrit": "यद्वा इह टीकायां पूर्वपक्षे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008208, "chapter_id": 8622, "verse_number": "3.6", "content_sanskrit": "न च जीवपरत्वे यतो वेत्यादिपूर्ववाक्योक्तकारणत्वमेव बाधकम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008209, "chapter_id": 8622, "verse_number": "3.7", "content_sanskrit": "सिद्धान्तस्तु विष्णुरेव जिज्ञास्यं ब्रह्म", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008210, "chapter_id": 8622, "verse_number": "3.8", "content_sanskrit": "न च यत इत्यादेः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008211, "chapter_id": 8622, "verse_number": "3.9", "content_sanskrit": "किञ्च कवीनां मते ‘‘तदेव परमं ब्रह्मेत्याहु’’रिति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008212, "chapter_id": 8622, "verse_number": "3.10", "content_sanskrit": "विद्वद्रूढेश्च यवादिशब्दानां प्रियङ्ग्वादिषु..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008213, "chapter_id": 8622, "verse_number": "3.11", "content_sanskrit": "सुधायां तु ब्रह्मशब्दः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900008214, "chapter_id": 8622, "verse_number": "3.12", "content_sanskrit": "सिद्धान्तस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900008215, "chapter_id": 8622, "verse_number": "3.13", "content_sanskrit": "अनुव्याख्याने तु ‘‘मोक्षदत्वाद् ब्रह्म जिज्ञास्यम्’’", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900008216, "chapter_id": 8622, "verse_number": "3.14", "content_sanskrit": "अत्र परैर्न तावदुपलभ्यमानं जगदेव ब्रह्मलक्षणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900008217, "chapter_id": 8622, "verse_number": "3.15", "content_sanskrit": "केचित्तु न तावज्जन्मादयो विशेषणत्वेन लक्षयन्ति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900008218, "chapter_id": 8622, "verse_number": "3.16", "content_sanskrit": "तन्न पूर्वपक्षानौचित्यस्योक्तत्वात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900008219, "chapter_id": 8622, "verse_number": "3.17", "content_sanskrit": "यच्चोक्तं परैर्जन्मादीत्यत्रोत्पत्तिस्थितिभङ्गमेवोच्यते न त्वन्यत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900008220, "chapter_id": 8622, "verse_number": "3.18", "content_sanskrit": "‘‘यतो वै’’ इत्यत्र सृष्टिस्थितिप्रलयमोक्षाणां ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900008221, "chapter_id": 8622, "verse_number": "3.19", "content_sanskrit": "अज्ञानं तु न बन्धः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900008222, "chapter_id": 8622, "verse_number": "3.20", "content_sanskrit": "अथवा विषयोपपादकगुणपूर्तिप्रसिद्धये ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900008223, "chapter_id": 8622, "verse_number": "3.21", "content_sanskrit": "केचित्तु ‘‘यतो वै’’ इत्यादिश्रुतौ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900008224, "chapter_id": 8622, "verse_number": "3.22", "content_sanskrit": "यच्चोक्तं परैर्जन्मादिकारणत्वं तटस्थलक्षणं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900008225, "chapter_id": 8622, "verse_number": "3.23", "content_sanskrit": "प्रकृते तु न तथा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900008226, "chapter_id": 8622, "verse_number": "3.24", "content_sanskrit": "एतेन यत इत्यनेनैव पदेन शुद्धप्रतीतिरिति निरस्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900008227, "chapter_id": 8622, "verse_number": "3.25", "content_sanskrit": "नापि लक्ष्यान्तर्गतानन्तर्गते स्वरूपतटस्थे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900008228, "chapter_id": 8622, "verse_number": "3.26", "content_sanskrit": "एतेन यदुक्तं विवरणे ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900008229, "chapter_id": 8622, "verse_number": "3.27", "content_sanskrit": "किञ्च जन्महेतुत्वेनैवोपलक्षणेनोपलक्ष्यज्ञानसिद्धेः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900008230, "chapter_id": 8622, "verse_number": "3.28", "content_sanskrit": "केचित्तु यतो वेत्यादिवाक्येन..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]