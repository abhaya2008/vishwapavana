[{"id": 7001881000, "chapter_id": 21881, "verse_number": "६०-१", "content_sanskrit": "मार्कण्डेय उवाच ।\nयत्तु किम्पुरुषं वर्षं तत् प्रवक्ष्याम्यहं द्विज ।\nयत्रायुर्दशसाहस्त्रं पुरुषाणां वपुष्मताम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001881001, "chapter_id": 21881, "verse_number": "६०-२", "content_sanskrit": "अनामया ह्यशोकाश्च नरा यत्र तथा स्त्रियः ।\nप्लक्षः षण्डश्च तत्रोक्तः सुमहान्नन्दनोपमः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001881002, "chapter_id": 21881, "verse_number": "६०-३", "content_sanskrit": "तस्य ते वै फलरसं पिबन्तः पुरुषाः सदा ।\nस्थिरयौवननिष्पन्नाः स्त्रियश्चोत्पलगन्धिकाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001881003, "chapter_id": 21881, "verse_number": "६०-४", "content_sanskrit": "अतः परं किंपुरुषाद्धरिवर्षं प्रचक्ष्यते ।\nमहारजतसङ्काशा जायन्ते तत्र मानवाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001881004, "chapter_id": 21881, "verse_number": "६०-५", "content_sanskrit": "देवलोकच्युताः सर्वे देवरूपाश्च सर्वशः ।\nहरिवर्षे नराः सर्वे पिबन्तीक्षुरसं शुभम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001881005, "chapter_id": 21881, "verse_number": "६०-६", "content_sanskrit": "न जरा बाधते तत्र न जीर्यन्ते च कर्हिचित् ।\nतावन्तमेव ते कालं जीवन्त्यथ निरामयाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001881006, "chapter_id": 21881, "verse_number": "६०-७", "content_sanskrit": "मेरुवर्षं मया प्रोक्तं मध्यमं यदिलावृतम् ।\nन तत्र सूर्यस्तपति न ते जीर्यन्ति मानवाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001881007, "chapter_id": 21881, "verse_number": "६०-८", "content_sanskrit": "लभन्ते नात्मलाभञ्च रश्मयश्चन्द्रसूर्ययोः ।\nनक्षत्राणां ग्रहाणाञ्च मेरोस्तत्र परा द्युतिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001881008, "chapter_id": 21881, "verse_number": "६०-९", "content_sanskrit": "पद्मप्रभाः पद्मगन्धा जम्बूफलरसाशिनः ।\nपद्मपत्रायताक्षास्तु जायन्ते तत्र मानवाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001881009, "chapter_id": 21881, "verse_number": "६०-१०", "content_sanskrit": "वर्षाणान्तु सहस्राणि तत्राप्यायुस्त्रयोदश ।\nसरावाकारसंस्तारो मेरुमध्ये इलावृते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001881010, "chapter_id": 21881, "verse_number": "६०-११", "content_sanskrit": "मेरुस्तत्र महाशैलस्तदाख्यातमिलावृतम् ।\nरम्यकं वर्षमस्माच्च कथयिष्ये निबोध तत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001881011, "chapter_id": 21881, "verse_number": "६०-१२", "content_sanskrit": "वृक्षस्तत्रापि चोत्तुङ्गो न्यग्रोधो हरितच्छदः ।\nतस्यापि ते फलरसं पिबन्तो वर्तयन्ति वै ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001881012, "chapter_id": 21881, "verse_number": "६०-१३", "content_sanskrit": "वर्षायुतायुषस्तत्र नरास्तत्फलभोगिनः ।\nरतिप्रधानविमला जरादौर्गन्ध्यवर्जिताः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001881013, "chapter_id": 21881, "verse_number": "६०-१४", "content_sanskrit": "तस्मादथोत्तरं वर्षं नाम्ना ख्यातं हिरण्मयम् ।\nहिरण्वती नदी यत्र प्रभूतकमलोज्ज्वला ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001881014, "chapter_id": 21881, "verse_number": "६०-१५", "content_sanskrit": "महाबलाः सतेजस्का जायन्ते तत्र मानवाः ।\nमहाकाया महासत्त्वा धनिनः प्रियदर्शनाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]