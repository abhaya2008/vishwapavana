[{"id": 7001118000, "chapter_id": 21118, "verse_number": "२-२-९-१", "content_sanskrit": "ब्रह्मोवाच ।\nतस्मिन् गते सानुचरे शिवस्थानं च मन्मथे ।\nचरित्रमभवच्चित्रं तच्छृणुष्व मुनीश्वर॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001118001, "chapter_id": 21118, "verse_number": "२-२-९-२", "content_sanskrit": "गत्वा तत्र महावीरो मन्मथो मोहकारकः ।\nस्वप्रभावं ततानाशु मोहयामास प्राणिनः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001118002, "chapter_id": 21118, "verse_number": "२-२-९-३", "content_sanskrit": "वसंतोपि प्रभावं स्वं चकार हरमोहनम् ।\nसर्वे वृक्षा एकदैव प्रफुल्ला अभवन्मुने॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001118003, "chapter_id": 21118, "verse_number": "२-२-९-४", "content_sanskrit": "विविधान्कृतवान्यत्नान् रत्या सह मनोभवः ।\nजीवास्सर्वे वशं यातास्सगणेशश्शिवो न हि॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001118004, "chapter_id": 21118, "verse_number": "२-२-९-५", "content_sanskrit": "समधोर्मदनस्यासन्प्रयासा निप्फला मुने ।\nजगाम स मम स्थानं निवृत्त्य विमदस्तदा॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001118005, "chapter_id": 21118, "verse_number": "२-२-९-६", "content_sanskrit": "कृत्वा प्रणामं विधये मह्यं गद्गदया गिरा ।\nउवाच मदनो मां चोदासीनो विमदो मुने॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001118006, "chapter_id": 21118, "verse_number": "२-२-९-७", "content_sanskrit": "काम उवाच ।\nब्रह्मन् शंभुर्मोहनीयो न वै योगपरायणः ।\nन शक्तिर्मम नान्यस्य तस्य शंभोर्हि मोहने॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001118007, "chapter_id": 21118, "verse_number": "२-२-९-८", "content_sanskrit": "समित्रेण मया ब्रह्मन्नुपाया विविधाः कृताः ।\nरत्या सहाखिलास्ते च निष्फला अभवञ्च्छिवे॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001118008, "chapter_id": 21118, "verse_number": "२-२-९-९", "content_sanskrit": "शृणु ब्रह्मन्यथाऽस्माभिः कृतां हि हरमोहने ।\nप्रयासा विविधास्तात गदतस्तान्मुने मम॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001118009, "chapter_id": 21118, "verse_number": "२-२-९-१०", "content_sanskrit": "यदा समाधिमाश्रित्य स्थितश्शंभुर्नियंत्रितः ।\nतदा सुगंधिवातेन शीतलेनातिवेगिना॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001118010, "chapter_id": 21118, "verse_number": "२-२-९-११", "content_sanskrit": "उद्वीजयामि रुद्रं स्म नित्यं मोहनकारिणा ।\nप्रयत्नतो महादेवं समाधिस्थं त्रिलोचनम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001118011, "chapter_id": 21118, "verse_number": "२-२-९-१२", "content_sanskrit": "स्वसायकांस्तथा पंच समादाय शरासनम् ।\nतस्याभितो भ्रमंतस्तु मोहयंस्तद्ग णानहम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001118012, "chapter_id": 21118, "verse_number": "२-२-९-१३", "content_sanskrit": "मम प्रवेशमात्रेण सुवश्यास्सर्वजंतवः ।\nअभवद्विकृतो नैव शंकरस्सगणः प्रभुः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001118013, "chapter_id": 21118, "verse_number": "२-२-९-१४", "content_sanskrit": "यदा हिमवतः प्रस्थं स गतः प्रमथाधिपः ।\nतत्रागतस्तदैवाहं सरतिस्समधुर्विधे॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001118014, "chapter_id": 21118, "verse_number": "२-२-९-१५", "content_sanskrit": "यदा मेरुं गतो रुद्रो यदा वा नागकेशरम् ।\nकैलासं वा यदा यातस्तत्राहं गतवांस्तदा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001118015, "chapter_id": 21118, "verse_number": "२-२-९-१६", "content_sanskrit": "यदा त्यक्तसमाधिस्तु हरस्तस्थौ कदाचन ।\nतदा तस्य पुरश्चक्रयुगं रचितवानहम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001118016, "chapter_id": 21118, "verse_number": "२-२-९-१७", "content_sanskrit": "तच्च भ्रूयुगलं ब्रह्मन् हावभावयुतं मुहुः ।\nनानाभावानकार्षीच्च दांपत्यक्रममुत्तमम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001118017, "chapter_id": 21118, "verse_number": "२-२-९-१८", "content_sanskrit": "नीलकंठं महादेवं सगणं तत्पुरःस्थिताः ।\nअकार्षुमोहितं भावं मृगाश्च पक्षिणस्तथा॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001118018, "chapter_id": 21118, "verse_number": "२-२-९-१९", "content_sanskrit": "मयूरमिथुनं तत्राकार्षीद्भावं रसोत्सुकम् ।\nविविधां गतिमाश्रित्य पार्श्वे तस्य पुरस्तथा॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001118019, "chapter_id": 21118, "verse_number": "२-२-९-२०", "content_sanskrit": "नालभद्विवरं तस्मिन् कदाचिदपि मच्छरः ।\nसत्यं ब्रवीमि लोकेश मम शक्तिर्न मोहने॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001118020, "chapter_id": 21118, "verse_number": "२-२-९-२१", "content_sanskrit": "मधुरप्यकरोत्कर्म युक्तं यत्तस्य मोहने ।\nतच्छृणुष्व महाभाग सत्यं सत्यं वदाम्यहम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001118021, "chapter_id": 21118, "verse_number": "२-२-९-२२", "content_sanskrit": "चंपकान्केशरान्वालान्कारणान्पाटलांस्तथा ।\nनागकेशरपुन्नागान्किंशुकान्केतकान्करान्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001118022, "chapter_id": 21118, "verse_number": "२-२-९-२३", "content_sanskrit": "मागंधिमल्लिकापर्णभरान्कुरवकांस्तथा ।\nउत्फुल्लयति तत्र स्म यत्र तिष्ठति वै हरः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001118023, "chapter_id": 21118, "verse_number": "२-२-९-२४", "content_sanskrit": "सरांस्युत्फुल्लपद्मानि वीजयन् मलयानिलैः ।\nयत्नात्सुगंधीन्यकरोदतीव गिरिशाश्रमे॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001118024, "chapter_id": 21118, "verse_number": "२-२-९-२५", "content_sanskrit": "लतास्सर्वास्सुमनसो दधुरंकुरसंचयान् ।\nवृक्षांकं चिरभावेन वेष्टयंति स्म तत्र च॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001118025, "chapter_id": 21118, "verse_number": "२-२-९-२६", "content_sanskrit": "तान्वृक्षांश्च सुपुष्पौघान् तैः सुगंधिसमीरणैः ।\nदृष्ट्वा कामवशं याता मुनयोपि परे किमु॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001118026, "chapter_id": 21118, "verse_number": "२-२-९-२७", "content_sanskrit": "एवं सत्यपि शंभोर्न दृष्टं मोहस्य कारणम् ।\nभावमात्रमकार्षीन्नो कोपो मय्यपि शंकरः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001118027, "chapter_id": 21118, "verse_number": "२-२-९-२८", "content_sanskrit": "इति सर्वमहं दृष्ट्वा ज्ञात्वा तस्य च भावनाम् ।\nविमुखोहं शंभुमोहान्नियतं ते वदाम्यहम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001118028, "chapter_id": 21118, "verse_number": "२-२-९-२९", "content_sanskrit": "तस्य त्यक्तसमाधेस्तु क्षणं नो दृष्टिगोचरे ।\nशक्नुयामो वयं स्थातुं तं रुद्रं को विमोहयेत्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001118029, "chapter_id": 21118, "verse_number": "२-२-९-३०", "content_sanskrit": "ज्वलदग्निप्रकाशाक्षं जट्टाराशिकरालिनम् ।\nशृंगिणं वीक्ष्य कस्स्थातुं ब्रह्मन् शक्नोति तत्पुरः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001118030, "chapter_id": 21118, "verse_number": "२-२-९-३१", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nमनो भववचश्चेत्थं श्रुत्वाहं चतुराननः ।\nविवक्षुरपि नावोचं चिंताविष्टोऽभवं तदा॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001118031, "chapter_id": 21118, "verse_number": "२-२-९-३२", "content_sanskrit": "मोहनेहं समर्थो न हरस्येति मनोभवः ।\nवचः श्रुत्वा महादुःखान्निरश्वसमहं मुने॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001118032, "chapter_id": 21118, "verse_number": "२-२-९-३३", "content_sanskrit": "निश्श्वासमारुता मे हि नाना रूपमहाबलः ।\nजाता गता लोलजिह्वा लोलाश्चातिभयंकराः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001118033, "chapter_id": 21118, "verse_number": "२-२-९-३४", "content_sanskrit": "अवादयंत ते सर्वे नानावाद्यानसंख्यकान् ।\nपटहादिगणास्तांस्तान् विकरालान्महारवान्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001118034, "chapter_id": 21118, "verse_number": "२-२-९-३५", "content_sanskrit": "अथ ते मम निश्श्वाससंभवाश्च महागणाः ।\nमारयच्छेदयेत्यूचुर्ब्रह्मणो मे पुरः स्थिताः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001118035, "chapter_id": 21118, "verse_number": "२-२-९-३६", "content_sanskrit": "तेषां तु वदतां तत्र मारयच्छेदयेति माम् ।\nवचः श्रुत्वा विधिं कामः प्रवक्तुमुपचक्रमे॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001118036, "chapter_id": 21118, "verse_number": "२-२-९-३७", "content_sanskrit": "मुनेऽथ मां समाभाष्य तान् दृष्ट्वा मदनो गणान् ।\nउवाच वारयन् ब्रह्मन्गणानामग्रतः स्मरः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001118037, "chapter_id": 21118, "verse_number": "२-२-९-३८", "content_sanskrit": "काम उवाच ।\nहे ब्रह्मन् हे प्रजानाथ सर्वसृष्टिप्रवर्तक ।\nउत्पन्नाः क इमे वीरा विकराला भयंकराः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001118038, "chapter_id": 21118, "verse_number": "२-२-९-३९", "content_sanskrit": "किं कर्मैते करिष्यंति कुत्र स्थास्यंति वा विधे ।\nकिन्नामधेया एते तद्वद तत्र नियोजय॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001118039, "chapter_id": 21118, "verse_number": "२-२-९-४०", "content_sanskrit": "नियोज्य तान्निजे कृत्ये स्थानं दत्त्वा च नाम च ।\nमामाज्ञापय देवेश कृपां कृत्वा यथोचिताम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001118040, "chapter_id": 21118, "verse_number": "२-२-९-४१", "content_sanskrit": "ब्रह्मोवाच ।\nइति तद्वाक्यमाकर्ण्य मुनेऽहं लोककारकः ।\nतमवोचं ह मदनं तेषां कर्मादिकं दिशन्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001118041, "chapter_id": 21118, "verse_number": "२-२-९-४२", "content_sanskrit": "ब्रह्मोवाच ।\nएत उत्पन्नमात्रा हि मारयेत्यवदन् वचः ।\nमुहुर्मुहुरतोमीषां नाम मारेति जायताम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001118042, "chapter_id": 21118, "verse_number": "२-२-९-४३", "content_sanskrit": "सदैव विघ्नं जंतूनां करिष्यन्ति गणा इमे ।\nविना निजार्चनं काम नाना कामरतात्मनाम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001118043, "chapter_id": 21118, "verse_number": "२-२-९-४४", "content_sanskrit": "तवानुगमने कर्म मुख्यमेषां मनोभव ।\nसहायिनो भविष्यंति सदा तव न संशयः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001118044, "chapter_id": 21118, "verse_number": "२-२-९-४५", "content_sanskrit": "यत्रयत्र भवान् याता स्वकर्मार्थं यदा यदा ।\nगंता स तत्रतत्रैते सहायार्थं तदातदा॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001118045, "chapter_id": 21118, "verse_number": "२-२-९-४६", "content_sanskrit": "चित्तभ्रांतिं करिष्यंति त्वदस्त्रवशवर्तिनाम् ।\nज्ञानिनां ज्ञानमार्गं च विघ्नयिष्यंति सर्वथा॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001118046, "chapter_id": 21118, "verse_number": "२-२-९-४७", "content_sanskrit": "ब्रह्मोवाच ।\nइत्याकर्ण्य वचो मे हि सरतिस्समहानुगः ।\nकिंचित्प्रसन्नवदनो बभूव मुनिसत्तम॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001118047, "chapter_id": 21118, "verse_number": "२-२-९-४८", "content_sanskrit": "श्रुत्वा तेपि गणास्सर्वे मदनं मां च सर्वतः ।\nपरिवार्य्य यथाकामं तस्थुस्तत्र निजाकृतिम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001118048, "chapter_id": 21118, "verse_number": "२-२-९-४९", "content_sanskrit": "अथ ब्रह्मा स्मरं प्रीत्याऽगदन्मे कुरु शासनम् ।\nएभिस्सहैव गच्छ त्वं पुनश्च हरमोहने॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001118049, "chapter_id": 21118, "verse_number": "२-२-९-५०", "content_sanskrit": "मन आधाय यवाद्धि कुरु मारगणैस्सह ।\nमोहो भवेद्यथा शंभोर्दारग्रहणहेतवे॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001118050, "chapter_id": 21118, "verse_number": "२-२-९-५१", "content_sanskrit": "इत्याकर्ण्य वचः कामः प्रोवाच वचनं पुनः ।\nदेवर्षे गौरवं मत्वा प्रणम्य विनयेन माम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001118051, "chapter_id": 21118, "verse_number": "२-२-९-५२", "content_sanskrit": "काम उवाच ।\nमया सम्यक् कृतं कर्म मोहने तस्य यत्नतः ।\nतन्मोहो नाभवत्तात न भविष्यति नाधुना॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001118052, "chapter_id": 21118, "verse_number": "२-२-९-५३", "content_sanskrit": "तव वाग्गौरवं मत्वा दृष्ट्वा मारगणानपि ।\nगमिष्यामि पुनस्तत्र सदारोहं त्वदाज्ञया॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001118053, "chapter_id": 21118, "verse_number": "२-२-९-५४", "content_sanskrit": "मनो निश्चितमेतद्धि तन्मोहो न भविष्यति ।\nभस्म कुर्यान्न मे देहमिति शंकास्ति मे विधे॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001118054, "chapter_id": 21118, "verse_number": "२-२-९-५५", "content_sanskrit": "इत्युक्त्वा समधुः कामस्सरतिस्सभयस्तदा ।\nययौ मारगणैः सार्द्धं शिवस्थानं मुनीश्वर॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001118055, "chapter_id": 21118, "verse_number": "२-२-९-५६", "content_sanskrit": "पूर्ववत् स्वप्रभावं च चक्रे मनसिजस्तदा ।\nबहूपायं स हि मधुर्विविधां बुद्धिमावहन्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001118056, "chapter_id": 21118, "verse_number": "२-२-९-५७", "content_sanskrit": "उपायं स चकाराति तत्र मारगणोऽपि च ।\nमोहोभवन्न वै शंभोरपि कश्चित्परात्मनः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001118057, "chapter_id": 21118, "verse_number": "२-२-९-५८", "content_sanskrit": "निवृत्त्य पुनरायातो मम स्थानं स्मरस्तदा ।\nआसीन्मारगणोऽगर्वोऽहर्षो मेपि पुरस्थितः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001118058, "chapter_id": 21118, "verse_number": "२-२-९-५९", "content_sanskrit": "कामः प्रोवाच मां तात प्रणम्य च निरुत्सवः ।\nस्थित्वा मम पुरोऽगर्वो मारैश्च मधुना तदा॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001118059, "chapter_id": 21118, "verse_number": "२-२-९-६०", "content_sanskrit": "कृतं पूर्वादधिकतः कर्म तन्मोहने विधे ।\nनाभवत्तस्य मोहोपि कश्चिद्ध्यानरतात्मनः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001118060, "chapter_id": 21118, "verse_number": "२-२-९-६१", "content_sanskrit": "न दग्धा मे तनुश्चैव तत्र तेन दयालुना ।\nकारणं पूर्वपुण्यं च निर्विकारी स वै प्रभुः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001118061, "chapter_id": 21118, "verse_number": "२-२-९-६२", "content_sanskrit": "चेद्वरस्ते हरो भार्यां गृह्णीयादिति पद्मज ।\nपरोपायं कुरु तदा विगर्व इति मे मतिः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001118062, "chapter_id": 21118, "verse_number": "२-२-९-६३", "content_sanskrit": "ब्रह्मोवाच ।\nइत्युक्त्वा सपरीवारो ययौ कामस्स्वमाश्रमम् ।\nप्रणम्य मां स्मरन् शंभुं गर्वदं दीनवत्सलम्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]