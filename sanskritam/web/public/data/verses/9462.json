[{"id": 5000462000, "chapter_id": 9462, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे पञ्चपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000462001, "chapter_id": 9462, "verse_number": "६-५५-१", "content_sanskrit": "वज्रदंष्ट्रं हतं श्रुत्वा वालिपुत्रेण रावणः।\nबलाध्यक्षमुवाचेदं कृताञ्जलिमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000462002, "chapter_id": 9462, "verse_number": "६-५५-२", "content_sanskrit": "शीघ्रं निर्यान्तुदुर्धर्षा राक्षसा भीमविक्रमाः।\nअकम्पनं पुरस्कृत्य सर्वशस्त्रास्त्रकोविदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000462003, "chapter_id": 9462, "verse_number": "६-५५-३", "content_sanskrit": "एष शास्ता च गोप्ता च नेता च युधि सत्तमः।\nभूतिकामश्च मे नित्यं नित्यं च समरप्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000462004, "chapter_id": 9462, "verse_number": "६-५५-४", "content_sanskrit": "एष जेष्यति काकुत्स्थौ सुग्रीवं च महाबलम्।\nवानरांश्चापरान् घोरान् हनिष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000462005, "chapter_id": 9462, "verse_number": "६-५५-५", "content_sanskrit": "परिगृह्य स तामाज्ञां रावणस्य महाबलः।\nबलं सम्प्रेरयामास तदा लघुपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000462006, "chapter_id": 9462, "verse_number": "६-५५-६", "content_sanskrit": "ततो नानाप्रहरणा भीमाक्षा भीमदर्शनाः।\nनिष्पेतू राक्षसा मुख्या बलाध्यक्षप्रचोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000462007, "chapter_id": 9462, "verse_number": "६-५५-७", "content_sanskrit": "रथमास्थाय विपुलं तप्तकाञ्चनभूषणम्।\nमेघाभो मेघवर्णश्च मेघस्वनमहास्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000462008, "chapter_id": 9462, "verse_number": "६-५५-८", "content_sanskrit": "राक्षसैः संवृतो घोरैस्तदा निर्यात्यकम्पनः।\nनहि कम्पयितुं शक्यः सुरैरपि महामृधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000462009, "chapter_id": 9462, "verse_number": "६-५५-९", "content_sanskrit": "अकम्पनस्ततस्तेषामादित्य इव तेजसा।\nतस्य निर्धावमानस्य संरब्धस्य युयुत्सया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000462010, "chapter_id": 9462, "verse_number": "६-५५-१०", "content_sanskrit": "अकस्माद् दैन्यमागच्छद्धयानां रथवाहिनाम्।\nव्यस्फुरन्नयनं चास्य सव्यं युद्धाभिनन्दिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000462011, "chapter_id": 9462, "verse_number": "६-५५-११", "content_sanskrit": "विवर्णो मुखवर्णश्च गद‍्गदश्चाभवत् स्वनः।\nअभवत् सुदिने काले दुर्दिनं रूक्षमारुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000462012, "chapter_id": 9462, "verse_number": "६-५५-१२", "content_sanskrit": "ऊचुः खगमृगाः सर्वे वाचः क्रूरा भयावहाः।\nस सिंहोपचितस्कन्धः शार्दूलसमविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000462013, "chapter_id": 9462, "verse_number": "६-५५-१३", "content_sanskrit": "तानुत्पातानचिन्त्यैव निर्जगाम रणाजिरम्।\nतथा निर्गच्छतस्तस्य रक्षसः सह राक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000462014, "chapter_id": 9462, "verse_number": "६-५५-१४", "content_sanskrit": "बभूव सुमहान् नादः क्षोभयन्निव सागरम्।\nतेन शब्देन वित्रस्ता वानराणां महाचमूः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000462015, "chapter_id": 9462, "verse_number": "६-५५-१५", "content_sanskrit": "द्रुमशैलप्रहाराणां योद्धुं समुपतिष्ठताम्।\nतेषां युद्धं महारौद्रं संजज्ञे कपिरक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000462016, "chapter_id": 9462, "verse_number": "६-५५-१६", "content_sanskrit": "रामरावणयोरर्थे समभित्यक्तदेहिनः।\nसर्वे ह्यतिबलाः शूराः सर्वे पर्वतसंनिभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000462017, "chapter_id": 9462, "verse_number": "६-५५-१७", "content_sanskrit": "हरयो राक्षसाश्चैव परस्परजिघांसया।\nतेषां विनर्दतां शब्दः संयुगेऽतितरस्विनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000462018, "chapter_id": 9462, "verse_number": "६-५५-१८", "content_sanskrit": "शुश्रुवे सुमहान् कोपादन्योन्यमभिगर्जताम्।\nरजश्चारुणवर्णाभं सुभीममभवद् भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000462019, "chapter_id": 9462, "verse_number": "६-५५-१९", "content_sanskrit": "उद‍्धृतं हरिरक्षोभिः संरुरोध दिशो दश।\nअन्योन्यं रजसा तेन कौशेयोद्धतपाण्डुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000462020, "chapter_id": 9462, "verse_number": "६-५५-२०", "content_sanskrit": "संवृतानि च भूतानि ददृशुर्न रणाजिरे।\nन ध्वजो न पताका वा चर्म वा तुरगोऽपि वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000462021, "chapter_id": 9462, "verse_number": "६-५५-२१", "content_sanskrit": "आयुधं स्यन्दनो वापि ददृशे तेन रेणुना।\nशब्दश्च सुमहांस्तेषां नर्दतामभिधावताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000462022, "chapter_id": 9462, "verse_number": "६-५५-२२", "content_sanskrit": "श्रूयते तुमुलो युद्धे न रूपाणि चकाशिरे।\nहरीनेव सुसंरुष्टा हरयो जघ्नुराहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000462023, "chapter_id": 9462, "verse_number": "६-५५-२३", "content_sanskrit": "राक्षसा राक्षसांश्चापि निजघ्नुस्तिमिरे तदा।\nते परांश्च विनिघ्नन्तः स्वांश्च वानरराक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000462024, "chapter_id": 9462, "verse_number": "६-५५-२४", "content_sanskrit": "रुधिरार्द्रां तदा चक्रुर्महीं पङ्कानुलेपनाम्।\nततस्तु रुधिरौघेण सिक्तं ह्यपगतं रजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000462025, "chapter_id": 9462, "verse_number": "६-५५-२५", "content_sanskrit": "शरीरशवसंकीर्णा बभूव च वसुंधरा।\nद्रुमशक्तिगदाप्रासैः शिलापरिघतोमरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000462026, "chapter_id": 9462, "verse_number": "६-५५-२६", "content_sanskrit": "राक्षसा हरयस्तूर्णं जघ्नुरन्योन्यमोजसा।\nबाहुभिः परिघाकारैर्युध्यन्तः पर्वतोपमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000462027, "chapter_id": 9462, "verse_number": "६-५५-२७", "content_sanskrit": "हरयो भीमकर्माणो राक्षसाञ्जघ्नुराहवे।\nराक्षसास्त्वभिसंक्रुद्धाः प्रासतोमरपाणयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000462028, "chapter_id": 9462, "verse_number": "६-५५-२८", "content_sanskrit": "कपीन् निजघ्निरे तत्र शस्त्रैः परमदारुणैः।\nअकम्पनः सुसंक्रुद्धो राक्षसानां चमूपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000462029, "chapter_id": 9462, "verse_number": "६-५५-२९", "content_sanskrit": "संहर्षयति तान् सर्वान् राक्षसान् भीमविक्रमान्।\nहरयस्त्वपि रक्षांसि महाद्रुममहाश्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000462030, "chapter_id": 9462, "verse_number": "६-५५-३०", "content_sanskrit": "विदारयन्त्यभिक्रम्य शस्त्राण्याच्छिद्य वीर्यतः।\nएतस्मिन्नन्तरे वीरा हरयः कुमुदो नलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000462031, "chapter_id": 9462, "verse_number": "६-५५-३१", "content_sanskrit": "मैन्दश्च द्विविदः क्रुद्धाश्चक्रुर्वेगमनुत्तमम्।\nते तु वृक्षैर्महावीरा राक्षसानां चमूमुखे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000462032, "chapter_id": 9462, "verse_number": "६-५५-३२", "content_sanskrit": "कदनं सुमहच्चक्रुर्लीलया हरिपुंगवाः।\nममन्थू राक्षसान् सर्वे नानाप्रहरणैर्भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000462033, "chapter_id": 9462, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे पञ्चपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]