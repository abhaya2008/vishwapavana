[{"id": 2117835, "chapter_id": 3537, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2117836, "chapter_id": 3537, "verse_number": "१", "content_sanskrit": "तं प्रयान्तं महात्मानं कौरवाणां यशस्करम् ।\nअनुजग्मुर्महात्मानो ब्राह्मणा वेदपारगाः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2117837, "chapter_id": 3537, "verse_number": "२", "content_sanskrit": "वेदवेदाङ्गविद्वांसस्तथैवाध्यात्मचिन्तकाः ।\nवौक्षाश्च भगवद्भक्ता दूताः पौराणिकाश्च ये \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2117838, "chapter_id": 3537, "verse_number": "३", "content_sanskrit": "कथकाश्चापरे राजन् रमणाश्च वनौकसः ।\nदिव्याख्यानानि ये चापि पठन्ति मधुरं द्विजाः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2117839, "chapter_id": 3537, "verse_number": "४", "content_sanskrit": "एतैश्चान्यैश्च बहुभिः सहायैः पाण्डुनन्दनः ।\nवृतः शिष्टजनैः प्रायाद् मरुद्भिरिव वासवः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2117840, "chapter_id": 3537, "verse_number": "५", "content_sanskrit": "रमणीयानि चित्राणि वनानि च सरांसि च ।\nसरितः सागरांश्चैव देशानपि च भारत \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2117841, "chapter_id": 3537, "verse_number": "६", "content_sanskrit": "पुण्यान्यपि च तीर्थानि ददर्श भरतर्षभः ।\nस गङ्गाद्वारमासाद्य निवेशमकरोत् प्रभुः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2117842, "chapter_id": 3537, "verse_number": "७", "content_sanskrit": "तस्य तत्राद्भुतं कर्म शृणु त्वं जनमेज्य ।\nकृतवान् यद् विशुद्धात्मा पाण्डूनां प्रवरो रथी \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2117843, "chapter_id": 3537, "verse_number": "८", "content_sanskrit": "निविष्टे तत्र कौन्तेये ब्राह्मणैः सह भारत ।\nअग्निहोत्राणि विप्रास्ते प्रादुश्चक्रुरनेकशः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2117844, "chapter_id": 3537, "verse_number": "९", "content_sanskrit": "तेषु प्रबोध्यमानेषु ज्वलिते च हुताशने ।\nकृतपुष्पोपहारेषु तीरान्तरगतेषु च \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2117845, "chapter_id": 3537, "verse_number": "१०", "content_sanskrit": "कृताभिषेकैर्विद्वद्भिर्नियतैः सत्पथे स्थितैः ।\nशुशुभेऽतीव तद् राजन् गङ्गाद्वारं महात्मभिः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2117846, "chapter_id": 3537, "verse_number": "११", "content_sanskrit": "अथ पर्याकुले तस्मिन् निवेशे पाण्डवर्षभः ।\nअभिषेकाय कौन्तेयो गङ्गामवततार ह \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2117847, "chapter_id": 3537, "verse_number": "१२", "content_sanskrit": "तत्राभिषेकं कृत्वा स तर्पयित्वा पितामहान् ।\nउत्तितीर्षुर्जलाद् राजन्नग्निकार्यचिकीर्षया \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2117848, "chapter_id": 3537, "verse_number": "१३", "content_sanskrit": "अपकृष्टो महाबाहुर्नागराजस्य कन्यया ।\nअन्तर्जले महाबाहुरुलूप्या कामयानया \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2117849, "chapter_id": 3537, "verse_number": "१४", "content_sanskrit": "ददर्श पाण्डवस्तत्र पावकं सुसमाहितः ।\nकौरव्यस्याथ नागस्य भवने परमार्चिते \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2117850, "chapter_id": 3537, "verse_number": "१५", "content_sanskrit": "तत्राग्निकार्यं कृतवान् कुन्तीपुत्रो धनञ्जयः ।\nअशङ्कमानेन हुतस्तेनातुष्यद् हुताशनः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2117851, "chapter_id": 3537, "verse_number": "१६", "content_sanskrit": "अग्निकार्यं स कृत्वा तु नागराजसुतां तदा ।\nप्रहसन्निव कौन्तेय इदं वचनमब्रवीत् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2117852, "chapter_id": 3537, "verse_number": "१७", "content_sanskrit": "किमिदं साहसं भीरु कृतवत्यसि भामिनि ।\nकस्यायं सुभगे देशः का च त्वं कस्य चात्मजा \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2117853, "chapter_id": 3537, "verse_number": "", "content_sanskrit": "उलूपी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2117854, "chapter_id": 3537, "verse_number": "१८", "content_sanskrit": "ऐरावतकुले जातः कौरव्यो नाम पन्नगः ।\nतस्याहं दुहिता पार्थ उलूपी नाम पन्नगी \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2117855, "chapter_id": 3537, "verse_number": "१९", "content_sanskrit": "साऽहं त्वामभिषेकार्थमवतीर्णं सरिद्वराम् ।\nदृष्टवत्येव कौन्तेय कन्दर्पेणास्मि मूर्च्छिता \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2117856, "chapter_id": 3537, "verse_number": "२०", "content_sanskrit": "तां मामनङ्गमथितां त्वत्कृते कुरुनन्दन ।\nअनन्यां नन्दयस्वाद्य प्रदानेनात्मनो रहः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2117857, "chapter_id": 3537, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2117858, "chapter_id": 3537, "verse_number": "२१", "content_sanskrit": "ब्रह्मचर्यमिदं भद्रे मम द्वादशमासिकम् ।\nधर्मराजेन चादिष्टो नाहमस्मि स्वयं वशः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2117859, "chapter_id": 3537, "verse_number": "२२", "content_sanskrit": "तव चापि प्रियं कर्तुमिच्छामि जलचारिणि ।\nअनृतं नोक्तपूर्वं च मया किञ्चन कर्हि चित् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2117860, "chapter_id": 3537, "verse_number": "२३", "content_sanskrit": "कथञ्चिन्नानृतं तस्य तव चैव प्रियं भवेत् ।\nन हि पीड्येत मे धर्मस्तथा कुरु भुजङ्गमे \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2117861, "chapter_id": 3537, "verse_number": "", "content_sanskrit": "उलूपी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2117862, "chapter_id": 3537, "verse_number": "२४", "content_sanskrit": "जानाम्यहं कौरवेय यथा चरसि मेदिनीम् ।\nयथा हि ते ब्रह्मचर्यमिति वः समयः कृतः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2117863, "chapter_id": 3537, "verse_number": "२५", "content_sanskrit": "तथाहि ते ब्रह्मचर्यमिदमादिष्टवान् गुरुः ।\nपरस्परं वर्तमानान् द्रुपदस्य सुतां प्रति \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2117864, "chapter_id": 3537, "verse_number": "२६", "content_sanskrit": "यो नोऽनुप्रविशेन्मोहात् स नो द्वादशमासिकम् ।\nवने चरेद् ब्रह्मचर्यमिति वः समयः कृतः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2117865, "chapter_id": 3537, "verse_number": "२७", "content_sanskrit": "तदिदं द्रौपदीहेतोरन्योन्यस्य प्रवासनम् ।\nकृतवांस्तत्र धर्मार्थमत्र धर्मो न लुप्यते \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2117866, "chapter_id": 3537, "verse_number": "२८", "content_sanskrit": "परित्राणं च कर्तव्यमार्तानां पृथुलोचन ।\nकृत्वा मम परित्राणं तव धर्मो न लुप्यते \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2117867, "chapter_id": 3537, "verse_number": "२९", "content_sanskrit": "त्वया कामप्रचाराय प्रेरितं न हि यन्मनः ।\nतस्मात् तव प्रत्यवायो युज्यते न हि कुत्रचित् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2117868, "chapter_id": 3537, "verse_number": "३०", "content_sanskrit": "यदि वाऽप्यस्य धर्मस्य सूक्ष्मोऽपि स्याद् व्यतिक्रमः ।\nस च ते धर्म एव स्याद् दत्त्वा प्राणान् ममार्जुन \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2117869, "chapter_id": 3537, "verse_number": "३१", "content_sanskrit": "भक्तां भजस्व मां पार्थ सतामेतन्मतं प्रभो ।\nन करिष्यसि चेदेवं मृतां मामुपधारय \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2117870, "chapter_id": 3537, "verse_number": "३२", "content_sanskrit": "प्राणदानान्महाबाहो वरं धर्ममनुत्तमम् ।\nशरणं च प्रपन्नाऽस्मि त्वामद्य पुरुषोत्तम \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2117871, "chapter_id": 3537, "verse_number": "३३", "content_sanskrit": "दीनानाथांश्च कौन्तेय परिरक्षसि नित्यशः ।\nसाऽहं शरणमभ्येमि रोरवीमि च दुःखिता \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2117872, "chapter_id": 3537, "verse_number": "३४", "content_sanskrit": "याचे त्वामभिकामाऽहं तस्मात् कुरु मम प्रियम् ।\nस्पृष्ट्वैवात्मप्रदानेन सकामां कर्तुमर्हसि \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2117873, "chapter_id": 3537, "verse_number": "", "content_sanskrit": "वैश्म्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2117874, "chapter_id": 3537, "verse_number": "३५", "content_sanskrit": "एवमुक्तस्तु कौन्तेयः पन्नगेश्वरकन्यया ।\nकृतवांस्तत् तथा सर्वं धर्ममुद्दिश्य कारणम् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2117875, "chapter_id": 3537, "verse_number": "३६", "content_sanskrit": "स नागभवने रात्रिमुषित्वा तां प्रतापवान् ।\nपूत्रमुत्पादयामास स तस्यां सुमनोहरम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2117876, "chapter_id": 3537, "verse_number": "३७", "content_sanskrit": "इरावन्तं महाबाहुं महाबलपराक्रमम् ।\nविमलेऽभ्युदिते सूर्ये कौरव्यस्य निवेशनात् ।\nनिश्चक्राम तदा पार्थः शुभं भवनमुत्तमम् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2117877, "chapter_id": 3537, "verse_number": "२१६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nषोडशाधिकद्विशततमोऽध्यायः ॥२१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2117878, "chapter_id": 3537, "verse_number": "२", "content_sanskrit": "॥ इति अर्जुनवनवासपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2117879, "chapter_id": 3537, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]