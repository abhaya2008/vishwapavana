[{"id": 5000041000, "chapter_id": 9041, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे एकचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000041001, "chapter_id": 9041, "verse_number": "१-४१-१", "content_sanskrit": "पुत्रांश्चिरगताञ्ज्ञात्वा सगरो रघुनन्दन ।\nनप्तारमब्रवीद् राजा दीप्यमानं स्वतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000041002, "chapter_id": 9041, "verse_number": "१-४१-२", "content_sanskrit": "शूरश्च कृतविद्यश्च पूर्वैस्तुल्योऽसि तेजसा ।\nपितॄणां गतिमन्विच्छ येन चाश्वोऽपवाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000041003, "chapter_id": 9041, "verse_number": "१-४१-३", "content_sanskrit": "अन्तर्भौमानि सत्त्वानि वीर्यवन्ति महान्ति च ।\nतेषां तु प्रतिघातार्थं सासिं गृह्णीष्व कार्मुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000041004, "chapter_id": 9041, "verse_number": "१-४१-४", "content_sanskrit": "अभिवाद्याभिवाद्यांस्त्वं हत्वा विघ्नकरानपि ।\nसिद्धार्थः संनिवर्तस्व मम यज्ञस्य पारगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000041005, "chapter_id": 9041, "verse_number": "१-४१-५", "content_sanskrit": "एवमुक्तोंऽशुमान् सम्यक् सगरेण महात्मना ।\nधनुरादाय खड्गं च जगाम लघुविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000041006, "chapter_id": 9041, "verse_number": "१-४१-६", "content_sanskrit": "स खातं पितृभिर्मार्गमन्तर्भौमं महात्मभिः ।\nप्रापद्यत नरश्रेष्ठ तेन राज्ञाभिचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000041007, "chapter_id": 9041, "verse_number": "१-४१-७", "content_sanskrit": "देवदानवरक्षोभिः पिशाचपतगोरगैः ।\nपूज्यमानं महातेजा दिशागजमपश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000041008, "chapter_id": 9041, "verse_number": "१-४१-८", "content_sanskrit": "स तं प्रदक्षिणं कृत्वा पृष्ट्वा चैव निरामयम् ।\nपितॄन् स परिपप्रच्छ वाजिहर्तारमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000041009, "chapter_id": 9041, "verse_number": "१-४१-९", "content_sanskrit": "दिशागजस्तु तच्छ्रुत्वा प्रत्युवाच महामतिः ।\nआसमञ्ज कृतार्थस्त्वं सहाश्वः शीघ्रमेष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000041010, "chapter_id": 9041, "verse_number": "१-४१-१०", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा सर्वानेव दिशागजान् ।\nयथाक्रमं यथान्यायं प्रष्टुं समुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000041011, "chapter_id": 9041, "verse_number": "१-४१-११", "content_sanskrit": "तैश्च सर्वैर्दिशापालैर्वाक्यज्ञैर्वाक्यकोविदैः ।\nपूजितः सहयश्चैवागन्तासीत्यभिचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000041012, "chapter_id": 9041, "verse_number": "१-४१-१२", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा जगाम लघुविक्रमः ।\nभस्मराशीकृता यत्र पितरस्तस्य सागराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000041013, "chapter_id": 9041, "verse_number": "१-४१-१३", "content_sanskrit": "स दुःखवशमापन्नस्त्वसमञ्जसुतस्तदा ।\nचुक्रोश परमार्तस्तु वधात् तेषां सुदुःखितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000041014, "chapter_id": 9041, "verse_number": "१-४१-१४", "content_sanskrit": "यज्ञियं च हयं तत्र चरन्तमविदूरतः ।\nददर्श पुरुषव्याघ्रो दुःखशोकसमन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000041015, "chapter_id": 9041, "verse_number": "१-४१-१५", "content_sanskrit": "स तेषां राजपुत्राणां कर्तुकामो जलक्रियाम् ।\nस जलार्थी महातेजा न चापश्यज्जलाशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000041016, "chapter_id": 9041, "verse_number": "१-४१-१६", "content_sanskrit": "विसार्य निपुणां दृष्टिं ततोऽपश्यत् खगाधिपम् ।\nपितॄणां मातुलं राम सुपर्णमनिलोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000041017, "chapter_id": 9041, "verse_number": "१-४१-१७", "content_sanskrit": "स चैनमब्रवीद् वाक्यं वैनतेयो महाबलः ।\nमा शुचः पुरुषव्याघ्र वधोऽयं लोकसम्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000041018, "chapter_id": 9041, "verse_number": "१-४१-१८", "content_sanskrit": "कपिलेनाप्रमेयेण दग्धा हीमे महाबलाः ।\nसलिलं नार्हसि प्राज्ञ दातुमेषां हि लौकिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000041019, "chapter_id": 9041, "verse_number": "१-४१-१९", "content_sanskrit": "गङ्गा हिमवतो ज्येष्ठा दुहिता पुरुषर्षभ ।\nतस्यां कुरु महाबाहो पितॄणां तु जल क्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000041020, "chapter_id": 9041, "verse_number": "१-४१-२०", "content_sanskrit": "भस्मराशीकृतानेतान् प्लावयेल्लोकपावनी ।\nतया क्लिन्नमिदं भस्म गङ्गया लोककान्तया ।\nषष्टिं पुत्रसहस्राणि स्वर्गलोकं गमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000041021, "chapter_id": 9041, "verse_number": "१-४१-२१", "content_sanskrit": "निर्गच्छाश्वं महाभाग संगृह्य पुरुषर्षभ।\nयज्ञं पैतामहं वीर निर्वर्तयितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000041022, "chapter_id": 9041, "verse_number": "१-४१-२२", "content_sanskrit": "सुपर्णवचनं श्रुत्वा सोंऽशुमानतिवीर्यवान् ।\nत्वरितं हयमादाय पुनरायान्महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000041023, "chapter_id": 9041, "verse_number": "१-४१-२३", "content_sanskrit": "ततो राजानमासाद्य दीक्षितं रघुनन्दन ।\nन्यवेदयद् यथावृत्तं सुपर्णवचनं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000041024, "chapter_id": 9041, "verse_number": "१-४१-२४", "content_sanskrit": "तच्छ्रुत्वा घोरसंकाशं वाक्यमंशुमतो नृपः ।\nयज्ञं निर्वर्तयामास यथाकल्पं यथाविधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000041025, "chapter_id": 9041, "verse_number": "१-४१-२५", "content_sanskrit": "स्वपुरं त्वगमच्छ्रीमानिष्टयज्ञो महीपतिः ।\nगङ्गायाश्चागमे राजा निश्चयं नाध्यगच्छत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000041026, "chapter_id": 9041, "verse_number": "१-४१-२६", "content_sanskrit": "अगत्वा निश्चयं राजा कालेन महता महान् ।\nत्रिंशद्वर्षसहस्राणि राज्यं कृत्वा दिवं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000041027, "chapter_id": 9041, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे एकचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]