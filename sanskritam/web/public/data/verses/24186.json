[{"id": 7004186000, "chapter_id": 24186, "verse_number": "५-१-३५-१", "content_sanskrit": "सनत्कुमार उवाच ।\nस्वर्णक्षुरे नरः स्नात्वा दृष्ट्वा देवं महेश्वरम् ।\nकपिलाशतदानस्य फलमप्यधिकं भवेत्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004186001, "chapter_id": 24186, "verse_number": "५-१-३५-२", "content_sanskrit": "वाप्यां पितामह स्यापि यः स्नायाद्विजितेंद्रियः ।\nहंसयुक्तेन यानेन ब्रह्मलोकं स गच्छति॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004186002, "chapter_id": 24186, "verse_number": "५-१-३५-३", "content_sanskrit": "तैलाभिधानमातॄणां रात्रौ यच्छति यो बलिम् ।\nतस्य सिद्धिर्भवे त्सद्यो मृतः शिवपुरं यजेत्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004186003, "chapter_id": 24186, "verse_number": "५-१-३५-४", "content_sanskrit": "विष्णुवाप्यां नरः स्नात्वा चैत्रे वा फाल्गुनेऽथवा ।\nजागरं यस्तु कुर्वीत सोपवासो जितेन्द्रियः ।\nमुच्यते सर्व पापेभ्यो विष्णुलोकं स गच्छति॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004186004, "chapter_id": 24186, "verse_number": "५-१-३५-५", "content_sanskrit": "अभयेश्वरदेवस्य भक्त्या नियतमानसः ।\nपूजाबन्धमथो दृष्ट्वा रुद्रलोकं स गच्छति॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004186005, "chapter_id": 24186, "verse_number": "५-१-३५-६", "content_sanskrit": "लोके तु जायते दाता सार्वभौमो महीपतिः ।\nयस्त्वगस्त्वेश्वरं गच्छेदेकचित्तो नरो मुने॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004186006, "chapter_id": 24186, "verse_number": "५-१-३५-७", "content_sanskrit": "दृष्ट्वागस्त्येश्वरं देवं सोपवासो जितेंद्रियः ।\nअगस्त्योदयवेलायां मुच्यते सर्वपातकैः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004186007, "chapter_id": 24186, "verse_number": "५-१-३५-८", "content_sanskrit": "कृत्वागस्त्यं च सौवर्णं रौप्यं वाथ स्वशक्तितः ।\nपञ्चरत्नसमायुक्तं वस्त्रेण च समन्वितम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004186008, "chapter_id": 24186, "verse_number": "५-१-३५-९", "content_sanskrit": "तत्कालीनैः फलैः पुष्पैः पूजनीयो विधानतः ।\nविधानं तस्य वक्ष्यामि चातुर्वर्ण्ये द्विजोत्तम॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004186009, "chapter_id": 24186, "verse_number": "५-१-३५-१०", "content_sanskrit": "सप्तधान्यानि मुख्यानि तावन्त्येव फलानि च ।\nएकं धान्यं फलं चैकमग्रे त्याज्यं भवेन्मुने॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004186010, "chapter_id": 24186, "verse_number": "५-१-३५-११", "content_sanskrit": "यावद्वै सप्त वर्षाणि व्रतमेवं समाचरेत्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004186011, "chapter_id": 24186, "verse_number": "५-१-३५-१२", "content_sanskrit": "अर्घ्यमन्त्रः ।\nकाशपुष्पप्रतीकाश वह्निमारुतसं भव ।\nमित्रावरुणयोः पुत्र कुम्भयोने नमोऽस्तु ते॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004186012, "chapter_id": 24186, "verse_number": "५-१-३५-१३", "content_sanskrit": "दत्तेऽर्घे यत्फलं व्यास तद्वै ह्येकमनाः शृणु ।\nपुत्रवान्धनवांश्चैव जायते नात्र संशयः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004186013, "chapter_id": 24186, "verse_number": "५-१-३५-१४", "content_sanskrit": "मृतः स्वर्गमवाप्नोति संपन्ने जायतेकुले ।\nमर्त्यलोकं पुनः प्राप्य महायोगीश्वरो भवेत्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004186014, "chapter_id": 24186, "verse_number": "५-१-३५-१५", "content_sanskrit": "यश्चैतच्छृणुयान्नित्यं पठेद्वा सुसमाहितः ।\nसर्वपापविनिर्मुक्तो मुनिलोके स मोदते॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]