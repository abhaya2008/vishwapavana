[{"id": 2119879, "chapter_id": 3576, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2119880, "chapter_id": 3576, "verse_number": "१", "content_sanskrit": "सम्राड्गुणमभीप्सन् वै युष्मान् स्वार्थपरायणः ।\nकथं प्रहिणुयां भीमं बलात् केवलसाहसात्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2119881, "chapter_id": 3576, "verse_number": "२", "content_sanskrit": "भीमार्जुनावुभौ नेत्रे मनो मन्ये जनार्दनम् ।\nमनश्चक्षुर्विहीनस्य कीदृशं जीवितं भवेत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2119882, "chapter_id": 3576, "verse_number": "३", "content_sanskrit": "जरासन्धबलं प्राप्य दुष्पारं भीमविक्रमम् ।\nसमा हि यः परोक्षः स्यात् किमु तत्र विचेष्टितम् ।\nअस्मिन्नर्थान्तरे युक्तमनर्थं प्रतिपद्यते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2119883, "chapter_id": 3576, "verse_number": "४", "content_sanskrit": "यथावद् विमृशाम्येकः तत् तावच्छ्रूयतां मम ।\nसन्न्यासं रोचये साधु कार्यस्यास्य जनार्दन ।\nप्रतिहन्ति मनो मेऽद्य राजसूयो दुराहरः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2119884, "chapter_id": 3576, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2119885, "chapter_id": 3576, "verse_number": "५", "content_sanskrit": "पार्थः प्राप्य धनुःश्रेष्ठमक्षय्यौ च महेषुधी ।\nरथं ध्वजं हयांश्चैव युधिष्ठिरमभाषत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2119886, "chapter_id": 3576, "verse_number": "६", "content_sanskrit": "धनुरस्त्रं शरा वीर्यं पक्षो भूमिर्यशो बलम् ।\nप्राप्तमेतन्मया राजन् दुष्प्रापं यदभीप्सितम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2119887, "chapter_id": 3576, "verse_number": "७", "content_sanskrit": "कुले जन्म प्रशंसन्ति वैद्याः साधु सुनिष्ठिताः ।\nबलेन सदृशं नास्ति वीर्यं तु मम रोचते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2119888, "chapter_id": 3576, "verse_number": "८", "content_sanskrit": "कृतविद्यः कुले जातो निर्वीर्यः किं करिष्यति ।\nक्षत्रियः सर्वशो राजन् यस्य वृत्तिः पराजये\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2119889, "chapter_id": 3576, "verse_number": "९", "content_sanskrit": "द्रव्यभूता गुणाः सर्वे तिष्ठन्ति हि पराक्रमे ।\nजयस्य हेतुः सिद्धिर्हि कर्म दैवं च संश्रितम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2119890, "chapter_id": 3576, "verse_number": "१०", "content_sanskrit": "संयुक्तो हि बलैः कैश्चित् प्रमादान्नेह युज्यते ।\nतेन द्वारेण शत्रुभ्यः क्षीयते सबलो रिपुः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2119891, "chapter_id": 3576, "verse_number": "११", "content_sanskrit": "अबले विक्रिया यादृक् तथा मोहो बलान्विते ।\nएतावुभौ महादोषौ नित्यं त्याज्यौ जयार्थिना\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2119892, "chapter_id": 3576, "verse_number": "१२", "content_sanskrit": "जरासन्धविनाशं च राज्ञां च परिमोक्षणम् ।\nयदि कुर्याम यज्ञार्थे तदारम्भो महान् भवेत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2119893, "chapter_id": 3576, "verse_number": "१३", "content_sanskrit": "अनारम्भे तु निर्युक्तो भवेदगुणनिश्चयः ।\nगुणान्निस्संशयाद् राजन् नैर्गुण्यं मन्यसे कथम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2119894, "chapter_id": 3576, "verse_number": "१४", "content_sanskrit": "कालोऽयं सुलभः पश्चान्मुनीनां शममिच्छताम् ।\nसाम्राज्यं तु तवेच्छन्तो वयं योत्स्यामहे परैः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2119895, "chapter_id": 3576, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि अष्टादशोऽध्यायः ॥१८॥ ॥ मन्त्रपर्वणि अष्टादशोऽध्यायः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2119896, "chapter_id": 3576, "verse_number": "", "content_sanskrit": "— ० —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]