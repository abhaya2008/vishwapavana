[{"id": 900005707, "chapter_id": 8442, "verse_number": "23.1", "content_sanskrit": "ॐ छन्दोभिधानान्नेति चेन्न तथा चेतोर्पणनिगदात्तथा हि दर्शनम् ॐ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900005708, "chapter_id": 8442, "verse_number": "23.2", "content_sanskrit": "कथं प्रसिद्धबहुलशब्दानामन्यथार्थता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900005709, "chapter_id": 8442, "verse_number": "23.3", "content_sanskrit": "इति चेत्तद्धरेरेव बाहुल्याच्छतिलिङ्गयोः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900005710, "chapter_id": 8442, "verse_number": "23.4", "content_sanskrit": "तादृशत्वाच्च तच्छक्तेः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900005711, "chapter_id": 8442, "verse_number": "23.5", "content_sanskrit": "तादृशत्वाच्च तच्छक्तेः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]