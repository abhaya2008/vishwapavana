[{"id": 6000092000, "chapter_id": 10092, "verse_number": null, "content_sanskrit": "अथ अष्टाविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000092001, "chapter_id": 10092, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.001.m4a", "display_order": 2}, {"id": 6000092002, "chapter_id": 10092, "verse_number": "४-२८-१", "content_sanskrit": "सैनिका भयनाम्नो ये बर्हिष्मन् दिष्टकारिणः।\nप्रज्वारकालकन्याभ्यां विचेरुरवनीमिमाम्॥ ४/२८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.002.m4a", "display_order": 3, "topics": [{"text": "पुरञ्जनपुरध्वंसः", "range": "१–१३"}]}, {"id": 6000092003, "chapter_id": 10092, "verse_number": "४-२८-२", "content_sanskrit": "त एकदा तु रभसा पुरञ्जनपुरीं नृप।\nरुरुधुर्भौमभोगाढ्यां जरत्पन्नगपालिताम्॥ ४/२८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.003.m4a", "display_order": 4}, {"id": 6000092004, "chapter_id": 10092, "verse_number": "४-२८-३", "content_sanskrit": "कालकन्याऽपि बुभुजे पुरञ्जनपुरीं बलात्।\nययाऽभिभूतः पुरुषः सद्यो निस्सारतामियात्॥ ४/२८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.004.m4a", "display_order": 5}, {"id": 6000092005, "chapter_id": 10092, "verse_number": "४-२८-४", "content_sanskrit": "तयोपभुज्यमानां वै यवनाः सर्वतो दिशम्।\nद्वार्भिः प्रविश्य सुभृशं प्रार्दयन् सकलां पुरीम्॥ ४/२८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.005.m4a", "display_order": 6}, {"id": 6000092006, "chapter_id": 10092, "verse_number": "४-२८-५", "content_sanskrit": "तस्यां प्रपीड्यमानायामभिमानी पुरञ्जनः।\nअवापोरुविधांस्तापान् कुटुम्बी ममताकुलः॥ ४/२८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.006.m4a", "display_order": 7}, {"id": 6000092007, "chapter_id": 10092, "verse_number": "४-२८-६", "content_sanskrit": "कन्योपगूढो नष्टश्रीः कृपणो विषयात्मकः।\nनष्टप्रज्ञो हतैश्वर्यो गन्धर्वयवनैर्बलात्॥ ४/२८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.007.m4a", "display_order": 8}, {"id": 6000092008, "chapter_id": 10092, "verse_number": "४-२८-७", "content_sanskrit": "विशीर्णां स्वपुरीं वीक्ष्य प्रतिकूलाननादृतान्।\nपुत्रपौत्रानुगामात्यान् जायां च गतसौहृदाम्॥ ४/२८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.008.m4a", "display_order": 9}, {"id": 6000092009, "chapter_id": 10092, "verse_number": "४-२८-८", "content_sanskrit": "आत्मानं कन्यया ग्रस्तं पाञ्चालानरिदूषितान्।\nदुरन्तचिन्तामापन्नो न लेभे तत्प्रतिक्रियाम्॥ ४/२८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.009.m4a", "display_order": 10}, {"id": 6000092010, "chapter_id": 10092, "verse_number": "४-२८-९", "content_sanskrit": "कामानभिलषन् दीनो यातयामांश्च कन्यया।\nगतात्मसंविन्निस्स्नेहः पुत्रदारांश्च लालयन्॥ ४/२८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.010.m4a", "display_order": 11}, {"id": 6000092011, "chapter_id": 10092, "verse_number": "४-२८-१०", "content_sanskrit": "गन्धर्वयवनाक्रान्तां कालकन्योपमर्दिताम्।\nहातुं प्रचक्रमे राजा तां पुरीमनिकामतः॥ ४/२८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.011.m4a", "display_order": 12}, {"id": 6000092012, "chapter_id": 10092, "verse_number": "४-२८-११", "content_sanskrit": "भयनाम्नोऽग्रजो भ्राता प्रज्वारः प्रत्युपस्थितः।\nददाह तां पुरीं कृत्स्नां भ्रातुः प्रियचिकीर्षया॥ ४/२८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.012.m4a", "display_order": 13}, {"id": 6000092013, "chapter_id": 10092, "verse_number": "४-२८-१२", "content_sanskrit": "तस्यां संदह्यमानायां सपौरः सपरिच्छदः।\nकौटुम्बिकः कुटुम्बिन्या उपातप्यत सान्वयः॥ ४/२८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.013.m4a", "display_order": 14}, {"id": 6000092014, "chapter_id": 10092, "verse_number": "४-२८-१३", "content_sanskrit": "यवनोपरुद्धायतनो ग्रस्तायां कालकन्यया।\nपुर्यां प्रज्वारसंस्पृष्टः पुरपालोऽन्वतप्यत॥ ४/२८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.014.m4a", "display_order": 15}, {"id": 6000092015, "chapter_id": 10092, "verse_number": "४-२८-१४", "content_sanskrit": "न शेके सेवितुं तत्र पुरुकृच्छ्रोरुवेपथुः।\nगन्तुमैच्छत् ततो वृक्षकोटरादिव सानलात्॥ ४/२८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.015.m4a", "display_order": 16, "topics": [{"text": "जराग्रस्तस्य स्वीयदारापत्यादीन्यतिशोचतः पुरञ्जनस्य मरणसमयप्राप्तिः", "range": "१४–२४"}]}, {"id": 6000092016, "chapter_id": 10092, "verse_number": "४-२८-१५", "content_sanskrit": "शिथिलावयवो यर्हि गन्धर्वैर्हृतपौरुषः।\nयवनैररिभी राजन्नुपरुद्धो रुरोद ह॥ ४/२८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.016.m4a", "display_order": 17}, {"id": 6000092017, "chapter_id": 10092, "verse_number": "४-२८-१६", "content_sanskrit": "दुहितॄः पुत्रपौत्रांश्च जामिजामातृपार्षदान्।\nस्मृत्वाऽवशिष्टं यत्किञ्चिद् गृहकोशपरिच्छदम्॥ ४/२८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.017.m4a", "display_order": 18}, {"id": 6000092018, "chapter_id": 10092, "verse_number": "४-२८-१७", "content_sanskrit": "अहं ममेति स्वीकृत्य गृहेषु कुमतिर्गृही।\nदध्यौ प्रमदया दीनो विप्रयोग उपस्थिते॥ ४/२८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.018.m4a", "display_order": 19}, {"id": 6000092019, "chapter_id": 10092, "verse_number": "४-२८-१८", "content_sanskrit": "लोकान्तरं गतवति मय्यनाथा कुटुम्बिनी।\nवर्तिष्यते कथं त्वेषा बालकाननुशोचती॥ ४/२८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.019.m4a", "display_order": 20}, {"id": 6000092020, "chapter_id": 10092, "verse_number": "४-२८-१९", "content_sanskrit": "न मय्यनशिते भुङ्क्ते नास्नाते स्नाति मत्परा।\nमयि तुष्टे सुसन्तुष्टा भर्त्सिते यतवाग् भयात्॥ ४/२८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.020.m4a", "display_order": 21}, {"id": 6000092021, "chapter_id": 10092, "verse_number": "४-२८-२०", "content_sanskrit": "प्रबोधयति माऽविज्ञं व्युषिते शोककर्शिता।\nवर्त्मैतद् गृहमेधीयं वीरसूरपि नेष्यति॥ ४/२८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.021.m4a", "display_order": 22}, {"id": 6000092022, "chapter_id": 10092, "verse_number": "४-२८-२१", "content_sanskrit": "कथं नु दारका दीना दारिका अपरायणाः।\nवर्तिष्यन्ते मयि गते भिन्ननाव इवोदधौ॥ ४/२८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.022.m4a", "display_order": 23}, {"id": 6000092023, "chapter_id": 10092, "verse_number": "४-२८-२२", "content_sanskrit": "एवं कृपणया बुद्ध्या शोचन्तमतदर्हणम्।\nग्रहीतुं कृतधीरेनं भयनामाऽभ्यपद्यत॥ ४/२८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.023.m4a", "display_order": 24}, {"id": 6000092024, "chapter_id": 10092, "verse_number": "४-२८-२३", "content_sanskrit": "पशुवद् यवनेनैष नीयमानः स्वकं क्षयम्।\nअन्वद्रुवन्ननुपथाः शोचन्तो भृशमातुराः॥ ४/२८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.024.m4a", "display_order": 25}, {"id": 6000092025, "chapter_id": 10092, "verse_number": "४-२८-२४", "content_sanskrit": "पुरीं विहायोपगत उपरुद्धो विहङ्गमः।\nतदा तमेवानुपुरी विशीर्णा प्रकृतिं गता॥ ४/२८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.025.m4a", "display_order": 26}, {"id": 6000092026, "chapter_id": 10092, "verse_number": "४-२८-२५", "content_sanskrit": "विकृष्यमाणः प्रसभं यवनेन बलीयसा।\nनाविन्दत् तम आविष्टः सखायं सुहृदं परम्॥ ४/२८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.026.m4a", "display_order": 27, "topics": [{"text": "परलोके नरकयातनानुभवानन्तरं पुरञ्‍जनस्य अन्यजन्मनि विदर्भदेशे स्त्रीत्वेन जननम्, पतिवियोगश्च", "range": "२५–५०"}]}, {"id": 6000092027, "chapter_id": 10092, "verse_number": "४-२८-२६", "content_sanskrit": "तं यज्ञपशवोऽनेन संज्ञप्ता येऽदयालुना।\nकुठारैश्चिच्छिदुः क्रुद्धाः स्मरन्तो वैशसं तु तत्॥ ४/२८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.027.m4a", "display_order": 28}, {"id": 6000092028, "chapter_id": 10092, "verse_number": "४-२८-२७", "content_sanskrit": "अनन्तपारे तमसि मग्नो नष्टस्मृतिः समाः।\nशाश्वतीरनुभूयार्तीः प्रमदासङ्गदूषितः॥ ४/२८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.028.m4a", "display_order": 29}, {"id": 6000092029, "chapter_id": 10092, "verse_number": "४-२८-२८", "content_sanskrit": "तामेव मनसा गृह्णन् बभूव प्रमदोत्तमा।\nअनन्तरं विदर्भस्य राजसिंहस्य वेश्मनि॥ ४/२८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.029.m4a", "display_order": 30}, {"id": 6000092030, "chapter_id": 10092, "verse_number": "४-२८-२९", "content_sanskrit": "उपयेमे वीर्यपणां वैदर्भीं मलयध्वजः।\nयुधि निर्जित्य राजन्यान् पाण्ड्यः परपुरञ्जयः॥ ४/२८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.030.m4a", "display_order": 31}, {"id": 6000092031, "chapter_id": 10092, "verse_number": "४-२८-३०", "content_sanskrit": "तस्यां सञ्जनयांचक्रे आत्मजामसितेक्षणाम्।\nयवीयसः सप्त सुतान् सप्तद्रविडभूभृतः॥ ४/२८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.031.m4a", "display_order": 32}, {"id": 6000092032, "chapter_id": 10092, "verse_number": "४-२८-३१", "content_sanskrit": "एकैकस्याभवत् तेषां राजन्नर्बुदमर्बुदम्।\nभोक्ष्यते यद्वंशधरैर्मही मन्वन्तरं परम्॥ ४/२८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.032.m4a", "display_order": 33}, {"id": 6000092033, "chapter_id": 10092, "verse_number": "४-२८-३२", "content_sanskrit": "अगस्त्यः प्राग्दुहितरमुपयेमे धृतव्रताम्।\nयस्यां दृढच्युतो जात इध्मवासात्मजो मुनिः॥ ४/२८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.033.m4a", "display_order": 34}, {"id": 6000092034, "chapter_id": 10092, "verse_number": "४-२८-३३", "content_sanskrit": "विभज्य तनयेभ्यः क्ष्मां राजर्षिर्मलयध्वजः।\nआरिराधयिषुः कृष्णं स जगाम कुलाचलम्॥ ४/२८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.034.m4a", "display_order": 35}, {"id": 6000092035, "chapter_id": 10092, "verse_number": "४-२८-३४", "content_sanskrit": "हित्वा गृहान् सुतान् भोगान् वैदर्भी मदिरेक्षणा।\nअन्वधावत पाण्ड्येशं ज्योत्स्नेव रजनीकरम्॥ ४/२८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.035.m4a", "display_order": 36}, {"id": 6000092036, "chapter_id": 10092, "verse_number": "४-२८-३५", "content_sanskrit": "तत्र चन्द्रमदा नाम ताम्रपर्णी वरोदका।\nतत्पुण्यसलिलैर्नित्यमुभयत्रात्मनो मृजन्॥ ४/२८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.036.m4a", "display_order": 37}, {"id": 6000092037, "chapter_id": 10092, "verse_number": "४-२८-३६", "content_sanskrit": "कन्दादिभिर्मूलफलैः पुष्पपर्णैस्तृणोदकैः।\nवर्तमानः शनैर्गात्रकर्शणं तप आस्थितः॥ ४/२८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.037.m4a", "display_order": 38}, {"id": 6000092038, "chapter_id": 10092, "verse_number": "४-२८-३७", "content_sanskrit": "शीतोष्णवातवर्षाणि क्षुत्पिपासे प्रियाप्रिये।\nसुखदुःखे इति द्वन्द्वान्यजयत् समदर्शनः॥ ४/२८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.038.m4a", "display_order": 39}, {"id": 6000092039, "chapter_id": 10092, "verse_number": "४-२८-३८", "content_sanskrit": "तपसा विद्यया पक्‍वकषायो नियमैर्यमैः।\nयुयुजे ब्रह्मणाऽऽत्मानं विजिताक्षानिलाशयः॥ ४/२८/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.039.m4a", "display_order": 40}, {"id": 6000092040, "chapter_id": 10092, "verse_number": "४-२८-३९", "content_sanskrit": "आस्ते स्थाणुरिवैकत्र दिव्यं वर्षशतं स्थितः।\nवासुदेवे भगवति नान्यद् वेदोद्वहन् रतिम्॥ ४/२८/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.040.m4a", "display_order": 41}, {"id": 6000092041, "chapter_id": 10092, "verse_number": "४-२८-४०", "content_sanskrit": "स व्यापकतयाऽऽत्मानं व्यतिरिक्ततयाऽऽत्मनि।\nविद्वान् स्वप्न इवामृश्य साक्षिणं विरराम ह॥ ४/२८/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.041.m4a", "display_order": 42}, {"id": 6000092042, "chapter_id": 10092, "verse_number": "४-२८-४१", "content_sanskrit": "साक्षाद्भगवतोक्तेन गुरुणा हरिणा नृपः।\nविशुद्धज्ञानदीपेन स्फुरता विश्वतोमुखम्॥ ४/२८/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.042.m4a", "display_order": 43}, {"id": 6000092043, "chapter_id": 10092, "verse_number": "४-२८-४२", "content_sanskrit": "परे ब्रह्मणि चात्मानं परं ब्रह्म तथाऽऽत्मनि।\nवीक्षमाणो विहायेक्षामस्मादुपरराम ह॥ ४/२८/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.043.m4a", "display_order": 44}, {"id": 6000092044, "chapter_id": 10092, "verse_number": "४-२८-४३", "content_sanskrit": "पतिं परमधर्मज्ञं वैदर्भी मलयध्वजम्।\nप्रेम्णा पर्यचरद्धित्वा भोगान् सा पतिदेवता॥ ४/२८/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.044.m4a", "display_order": 45}, {"id": 6000092045, "chapter_id": 10092, "verse_number": "४-२८-४४", "content_sanskrit": "चीरवासा व्रतक्षामा वेणीभूतशिरोरुहा।\nबभावुप पतिं शान्ता शिखाशान्तमिवानलम्॥ ४/२८/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.045.m4a", "display_order": 46}, {"id": 6000092046, "chapter_id": 10092, "verse_number": "४-२८-४५", "content_sanskrit": "अजानती प्रियतमं यदोपरतमङ्गना।\nसुस्थिरासनमासाद्य यथा पूर्वमुपाचरत्॥ ४/२८/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.046.m4a", "display_order": 47}, {"id": 6000092047, "chapter_id": 10092, "verse_number": "४-२८-४६", "content_sanskrit": "यदा नोपलभेताङ्घ्रावूष्माणं पत्युरर्चती।\nआसीत् संविग्नहृदया यूथभ्रष्टा मृगी यथा॥ ४/२८/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.047.m4a", "display_order": 48}, {"id": 6000092048, "chapter_id": 10092, "verse_number": "४-२८-४७", "content_sanskrit": "आत्मानं शोचती दीनमबन्धुर्विक्लवाऽश्रुभिः।\nस्तनावासिच्य विपिने सुस्वरं प्ररुरोद सा॥ ४/२८/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.048.m4a", "display_order": 49}, {"id": 6000092049, "chapter_id": 10092, "verse_number": "४-२८-४८", "content_sanskrit": "उत्तिष्ठोत्तिष्ठ राजर्षे इमामुदधिमेखलाम्।\nदस्युभ्यः क्षत्रबन्धुभ्यो बिभ्यतीं पातुमर्हसि॥ ४/२८/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.049.m4a", "display_order": 50}, {"id": 6000092050, "chapter_id": 10092, "verse_number": "४-२८-४९", "content_sanskrit": "एवं विलपती बाला विपिनेऽनुगता पतिम्।\nपतिता पादयोर्भर्तू रुदन्त्यश्रूण्यवर्तयत्॥ ४/२८/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.050.m4a", "display_order": 51}, {"id": 6000092051, "chapter_id": 10092, "verse_number": "४-२८-५०", "content_sanskrit": "चितिं दारुमयीं कृत्वा तस्यां पत्युः कलेवरम्।\nआदीप्य चानुमरणे विलपन्ती मनो दधे॥ ४/२८/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.051.m4a", "display_order": 52}, {"id": 6000092052, "chapter_id": 10092, "verse_number": "४-२८-५१", "content_sanskrit": "तत्र पूर्वतरः कश्चित् सखा ब्राह्मण आत्मवान्।\nसान्त्वयन् वल्गुना साम्ना तामाह रुदतीं प्रभो॥ ४/२८/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.052.m4a", "display_order": 53, "topics": [{"text": "स्रीभूतस्य पुरंजनस्य भगवज्ज्ञानप्राप्त्या मोक्षप्राप्तिः", "range": "५१–६५"}]}, {"id": 6000092053, "chapter_id": 10092, "verse_number": "४-२८-५२", "content_sanskrit": "का त्वं कस्यासि को वाऽयं शयानो यस्य शोचसि।\nजानासि किं सखायं मां येनाग्रे विचचर्थ ह॥ ४/२८/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.053.m4a", "display_order": 54}, {"id": 6000092054, "chapter_id": 10092, "verse_number": "४-२८-५३", "content_sanskrit": "अपि स्मरसि चात्मानमविज्ञातसखं सखे।\nहित्वा मां पदमन्विच्छन् भौमभोगरतो गतः॥ ४/२८/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.054.m4a", "display_order": 55}, {"id": 6000092055, "chapter_id": 10092, "verse_number": "४-२८-५४", "content_sanskrit": "हंसावहं च त्वं चार्य सखायौ मानसायनौ।\nअवात्स्व रमणौ चोभौ सहस्रपरिवत्सरान्॥ ४/२८/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.055.m4a", "display_order": 56}, {"id": 6000092056, "chapter_id": 10092, "verse_number": "४-२८-५५", "content_sanskrit": "स त्वं विहाय मां बन्धो गतो ग्राम्यमतिर्महीम्।\nविचरन् पदमद्राक्षीः कयाचिन्निर्मितं स्‍त्रिया॥ ४/२८/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.056.m4a", "display_order": 57}, {"id": 6000092057, "chapter_id": 10092, "verse_number": "४-२८-५६", "content_sanskrit": "पञ्चारामं नवद्वारमेकपालं त्रिकोष्ठकम्।\nषट्कलं पञ्चविपणं पञ्चप्रकृति स्‍त्रीधवम्॥ ४/२८/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.057.m4a", "display_order": 58}, {"id": 6000092058, "chapter_id": 10092, "verse_number": "४-२८-५७", "content_sanskrit": "पञ्चेन्द्रियार्था आरामा द्वारो घ्राणादयः प्रभो।\nतेजोबन्नानि कोष्ठानि गोलकेन्द्रियसंग्रहः॥ ४/२८/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.058.m4a", "display_order": 59}, {"id": 6000092059, "chapter_id": 10092, "verse_number": "४-२८-५८", "content_sanskrit": "विपणस्तु क्रियाशक्तिर्भूतप्रकृतिरव्यया।\nशक्त्यधीशः पुमानत्र प्रविष्टो नावबुध्यते॥ ४/२८/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.059.m4a", "display_order": 60}, {"id": 6000092060, "chapter_id": 10092, "verse_number": "४-२८-५९", "content_sanskrit": "तस्मिंस्त्वं रामया स्पृष्टो रममाणो हतस्मृतिः।\nतत्सङ्गादीदृशीं प्राप्तो दशां पापीयसीं विभो॥ ४/२८/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.060.m4a", "display_order": 61}, {"id": 6000092061, "chapter_id": 10092, "verse_number": "४-२८-६०", "content_sanskrit": "न त्वं विदर्भदुहिता नायं वीरः सुहृत् तव।\nन पतिस्त्वं पुरञ्जन्या रुद्धो नवमुखे यया॥ ४/२८/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.061.m4a", "display_order": 62}, {"id": 6000092062, "chapter_id": 10092, "verse_number": "४-२८-६१", "content_sanskrit": "माया ह्येषा मया सृष्टा यत् पुमांसं स्‍त्रियं पतिम्।\nमन्यसे नोभयं यद् वै हंसं पश्यात्मनो गतिम्॥ ४/२८/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.062.m4a", "display_order": 63}, {"id": 6000092063, "chapter_id": 10092, "verse_number": "४-२८-६२", "content_sanskrit": "अहं भवान्न चान्यस्त्वं त्वमेवाहं विचक्ष्व भोः।\nन नौ पश्यन्ति कवयश्छिद्रं जातु मनागपि॥ ४/२८/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.063.m4a", "display_order": 64}, {"id": 6000092064, "chapter_id": 10092, "verse_number": "४-२८-६३", "content_sanskrit": "यथा पुरुष आत्मानमेकमादर्शचक्षुषोः।\nद्विधाभूतमिवेक्षेत तथैवान्तरमावयोः॥ ४/२८/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.064.m4a", "display_order": 65}, {"id": 6000092065, "chapter_id": 10092, "verse_number": "४-२८-६४", "content_sanskrit": "एवं स मानसो हंसो हंसेन प्रतिबोधितः।\nस्वस्थस्तद्व्यभिचारेण नष्टामाप पुनः स्मृतिम्॥ ४/२८/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.065.m4a", "display_order": 66}, {"id": 6000092066, "chapter_id": 10092, "verse_number": "४-२८-६५", "content_sanskrit": "बर्हिष्मन्नेतदध्यात्मं पारोक्ष्येण प्रदर्शितम्।\nयत् परोक्षप्रियो देवो भगवान् विश्वभावनः॥ ४/२८/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_028/BhP_04.028.066.m4a", "display_order": 67}, {"id": 6000092067, "chapter_id": 10092, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे अष्टाविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]