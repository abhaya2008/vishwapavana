[{"id": 7001826000, "chapter_id": 21826, "verse_number": "५-१", "content_sanskrit": "पक्षिण ऊचुः ।\nत्वष्टृपुत्रे हते पूर्वं ब्रह्मन्निन्द्रस्य तेजसः ।\nब्रह्महत्याभिभूतस्य परा हानिरजायत ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001826001, "chapter_id": 21826, "verse_number": "५-२", "content_sanskrit": "तद्धमं प्रविवेशाथ शाक्रतेजोऽपचारतः ।\nनिस्तेजाश्चाभवच्छक्रो धर्मे तेजसि निर्गते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001826002, "chapter_id": 21826, "verse_number": "५-३", "content_sanskrit": "ततः पुत्रं हतं श्रुत्वा त्वष्टा क्रुद्धः प्रजापतिः ।\nअवलुञ्च्य जटामेकामिदं वचनमब्रवीत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001826003, "chapter_id": 21826, "verse_number": "५-४", "content_sanskrit": "अद्य पश्यन्तु मे वीर्यं त्रयो लोकाः सदेवताः ।\nस च पश्यतु दुर्बुद्धिर्ब्रह्महा पाकशासनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001826004, "chapter_id": 21826, "verse_number": "५-५", "content_sanskrit": "स्वकर्माभिरतो येन मत्सुतो विनपातितः ।\nइत्युक्त्वा कोपरक्ताक्षो जटामग्नौ जुहाव ताम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001826005, "chapter_id": 21826, "verse_number": "५-६", "content_sanskrit": "ततो वृत्रः समुत्तस्थौ ज्वालामाली महासुरः ।\nमहाकायो महादंष्ट्रो भिन्नाञ्जनचयप्रभः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001826006, "chapter_id": 21826, "verse_number": "५-७", "content_sanskrit": "इन्द्रशत्रुरमेयात्मा त्वष्टृतेजोपबृंहितः ।\nअहन्यहनि सोऽवर्धदिषुपातं महाबलः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001826007, "chapter_id": 21826, "verse_number": "५-८", "content_sanskrit": "वधाय चात्मनो दृष्ट्वा वृत्रं शक्रो महासुरम् ।\nप्रेषयामास सप्तर्षोन् सन्धिमिच्छन् भयातुरः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001826008, "chapter_id": 21826, "verse_number": "५-९", "content_sanskrit": "सख्यञ्चक्रुस्ततस्तस्य वृत्रेण समयांस्तथा ।\nऋषयः प्रीतमनसः सर्वभूतहिते रताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001826009, "chapter_id": 21826, "verse_number": "५-१०", "content_sanskrit": "समयस्थितिमुल्लङ्घ्य यदा शक्रेण घातितः ।\nवृत्रो हत्याभिभूतस्य तदा बलमशीर्यत ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001826010, "chapter_id": 21826, "verse_number": "५-११", "content_sanskrit": "तच्छक्रदेहविभ्रष्टं बलं मारुतमाविशत् ।\nसर्वव्यापिनमव्यक्तं बलस्यैवाधिदैवतम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001826011, "chapter_id": 21826, "verse_number": "५-१२", "content_sanskrit": "अहल्याञ्च यदा शक्रो गौतमं रूपमास्थितः ।\nधर्षयामास देवेन्द्रस्तदा रूपमहीयत ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001826012, "chapter_id": 21826, "verse_number": "५-१३", "content_sanskrit": "अङ्गप्रत्यङ्गलावण्यं यदतीव मनोरम् ।\nविहाय दुष्टं देवेन्द्रं नासत्यावगमत् ततः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001826013, "chapter_id": 21826, "verse_number": "५-१४", "content_sanskrit": "धर्मेण तेजसा त्यक्तं बलहीनमरूपिणम् ।\nज्ञात्वा सुरेशं दैतेयास्तज्जये चक्रुरुद्यमम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001826014, "chapter_id": 21826, "verse_number": "५-१५", "content_sanskrit": "राज्ञामुद्रिक्तवीर्याणां देवेन्द्रं विजिगीषवः ।\nकुलेष्वतिबला दैत्या अजायन्त महामुने ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001826015, "chapter_id": 21826, "verse_number": "५-१६", "content_sanskrit": "कस्यचित्त्वथ कालस्य धरणी भारपीडिता ।\nजगाम मेरुशिखरं सदो यत्र दिवौकसाम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001826016, "chapter_id": 21826, "verse_number": "५-१७", "content_sanskrit": "तेषां सा कथयामास भूरिभारावपीडिता ।\nदनुजात्मजदैत्योत्थं खेदकारणमात्मनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001826017, "chapter_id": 21826, "verse_number": "५-१८", "content_sanskrit": "एते भवद्भिरसुरा निहताः पृथुलौजसः ।\nते सर्वे मानुषे लोके जाता गेहेषु भूभृताम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001826018, "chapter_id": 21826, "verse_number": "५-१९", "content_sanskrit": "अक्षौहिण्यो हि बहुलास्तद्भारार्ता व्रजाम्यधः ।\nतथा कुरुध्वं त्रिदशा यथा शान्तिर्भवेन्मम ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001826019, "chapter_id": 21826, "verse_number": "५-२०", "content_sanskrit": "पक्षिण ऊचुः ।\nतेजोभागैस्ततो देवा अवतेरुर्दिवो महीम् ।\nप्रजानामुपकारार्थं भूभारहरणाय च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001826020, "chapter_id": 21826, "verse_number": "५-२१", "content_sanskrit": "यदिन्द्रदेहजं तेजस्तन्मुमोच स्वयं वृषः ।\nकुन्त्या जातो महातेजास्ततो राजा युधिष्ठिरः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001826021, "chapter_id": 21826, "verse_number": "५-२२", "content_sanskrit": "बलं मुमोच पवनस्ततो भीमो व्यजायत ।\nशक्रवीर्यार्धतश्चैव जज्ञे पार्थो धनञ्जयः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001826022, "chapter_id": 21826, "verse_number": "५-२३", "content_sanskrit": "उत्पन्नौ यमजौ माद्रयां शक्ररूपौ महाद्युती ।\nपञ्चधा भगवानित्थमवतीर्णः शतक्रतुः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001826023, "chapter_id": 21826, "verse_number": "५-२४", "content_sanskrit": "तस्योत्पन्ना महाभागा पत्नी कृष्णा हुताशनात् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001826024, "chapter_id": 21826, "verse_number": "५-२५", "content_sanskrit": "शक्रस्यैकस्य सा पत्नी कृष्णा नान्यस्य कस्यचित् ।\nयोगीश्वराः शरीराणि कुर्वन्ति बहुलान्यपि ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001826025, "chapter_id": 21826, "verse_number": "५-२६", "content_sanskrit": "पञ्चानामेकपत्नीत्वमित्येतत् कथितं तव ।\nश्रूयतां बलदेवोऽपि यथा यातः सरस्वतीम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]