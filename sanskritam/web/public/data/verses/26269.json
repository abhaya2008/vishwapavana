[{"id": 7006269000, "chapter_id": 26269, "verse_number": "३-२३-१", "content_sanskrit": "अथाश्वरूढया क्षिप्ते कुरण्डे भण्डदानवः ।\nकुटिलाक्षमिदं प्रोचे पुनरेव युयुत्सया ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006269001, "chapter_id": 26269, "verse_number": "३-२३-२", "content_sanskrit": "स्वप्नेऽपि यन्न संभाव्यं यन्न श्रुतमितः पुरा ।\nयच्च नो शङ्कितं चित्ते तदेतत्कष्टमागतम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006269002, "chapter_id": 26269, "verse_number": "३-२३-३", "content_sanskrit": "कुरण्डदुर्मदौ सत्त्वशालिनौ भ्रातरौ हितौ ।\nदुष्टदास्याः प्रभावोऽयं मायाविन्या महत्तरः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006269003, "chapter_id": 26269, "verse_number": "३-२३-४", "content_sanskrit": "इतः परं करङ्कादीन्पञ्चसेनाधिनायकान् ।\nशतमक्षौहिणीनां च प्रस्थापय रणाङ्गणे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006269004, "chapter_id": 26269, "verse_number": "३-२३-५", "content_sanskrit": "ते युद्धदुर्मदाः शूराः संग्रामेषु तनुत्यजः ।\nसर्वथैव विजेष्यन्ते दुर्विदग्धविलासिनीम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006269005, "chapter_id": 26269, "verse_number": "३-२३-६", "content_sanskrit": "इति भण्डवचः श्रुत्वा भृशं चत्वरयान्वितः ।\nकुटिलाक्षः करङ्कादीनाजुहाव चमूपतीन् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006269006, "chapter_id": 26269, "verse_number": "३-२३-७", "content_sanskrit": "ते स्वामिनं नमस्कृत्य कुटिलाक्षेण देशिताः ।\nअग्नौ प्रविष्णव इव क्रोधान्धा निर्ययुः पुरात् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006269007, "chapter_id": 26269, "verse_number": "३-२३-८", "content_sanskrit": "तेषां प्रयाणनिःसाणरणितं भृशदुःसहम् ।\nआकर्ण्य दिग्गजास्तूर्णं शीर्णकर्णा जुघूर्णिरे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006269008, "chapter_id": 26269, "verse_number": "३-२३-९", "content_sanskrit": "शतमक्षौहिणीनां च प्राचलत्केतुमालकम् ।\nउत्तरङ्गतुरङ्गादि बभौ मत्तमतङ्गजम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006269009, "chapter_id": 26269, "verse_number": "३-२३-१०", "content_sanskrit": "ह्रेषमाणहयाकीर्णं क्रन्दद्भटकुलोद्भवम् ।\nबृंहमाणगजं गर्जद्रथयक्रं चचाल तत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006269010, "chapter_id": 26269, "verse_number": "३-२३-११", "content_sanskrit": "चक्रनेमिहतक्षोणीरेणुक्षपितरोचिषा ।\nबभूवे तुहिनासारच्छन्नेनेव विवस्वता ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006269011, "chapter_id": 26269, "verse_number": "३-२३-१२", "content_sanskrit": "धूलीमयमिवाशेषमभवद्विश्वमण्डलम् ।\nक्वचिच्छब्दमयं चैव निःसाणकठिनस्वनैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006269012, "chapter_id": 26269, "verse_number": "३-२३-१३", "content_sanskrit": "उद्भूतैर्धूलिकाजालैराक्रान्ता दैत्यसैनिकाः ।\nइयत्तयातः सेनायाः संख्यापि परिभाविता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006269013, "chapter_id": 26269, "verse_number": "३-२३-१४", "content_sanskrit": "ध्वजा बहुविधाकारा मीनव्यालादिचित्रिताः ।\nप्रचेलुर्धूलिकाजाले मत्स्या इव महोदधौ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006269014, "chapter_id": 26269, "verse_number": "३-२३-१५", "content_sanskrit": "तानापतत आलोक्य ललितासैनिकं प्रति ।\nवित्रेसुरमराः सर्वे शक्तीनां भङ्गशङ्कया ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006269015, "chapter_id": 26269, "verse_number": "३-२३-१६", "content_sanskrit": "ते करङ्कमुखाः पञ्च सेनापतय उद्धताः ।\nसर्पिणीं नाम समरे मायां चक्रुर्महीयसीम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006269016, "chapter_id": 26269, "verse_number": "३-२३-१७", "content_sanskrit": "तैः समुत्पतिता दुष्टा सर्पिणी रमशांबरी ।\nधूम्रवर्णा च धूम्रोष्ठी धूम्रवर्मपयोधरा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006269017, "chapter_id": 26269, "verse_number": "३-२३-१८", "content_sanskrit": "महोदधिरिवात्यन्तं गंभीरकुहरोदरी ।\nपुरश्चचाल शक्तीनान्त्रासयन्ती मनो रणे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006269018, "chapter_id": 26269, "verse_number": "३-२३-१९", "content_sanskrit": "कद्रूरिवापरा दुष्टा बहुसर्पविभूषणा ।\nसर्पाणामुद्भवस्थानं मायामयशरीरिणाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006269019, "chapter_id": 26269, "verse_number": "३-२३-२०", "content_sanskrit": "सेनापतीनां नासीरे वेल्लयन्तीमहीतले ।\nवेल्लितं बहुधा चक्रे घोरारावविराविणी ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006269020, "chapter_id": 26269, "verse_number": "३-२३-२१", "content_sanskrit": "तथैव मायया पूर्वं तेऽसुरेद्रा व्यजीजयन् ।\nकरङ्काद्या दुरात्मानः पञ्चपञ्चत्त्वकामुकाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006269021, "chapter_id": 26269, "verse_number": "३-२३-२२", "content_sanskrit": "अथ प्रववृते युद्धं शक्तीनाममरद्रुहाम् ।\nअन्योन्यवीरभाषाभिः प्रोत्साहितघनक्रुधाम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006269022, "chapter_id": 26269, "verse_number": "३-२३-२३", "content_sanskrit": "अत्यन्तसंकुलतया न विज्ञातपरस्पराः ।\nशक्तयो दानवश्चैव प्रजहुः शस्त्रपाणयः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006269023, "chapter_id": 26269, "verse_number": "३-२३-२४", "content_sanskrit": "अन्योन्यशस्त्रसंघट्टसमुत्थितहुताशने ।\nप्रवृत्तविशिखस्रोतःप्रच्छन्नहरिदन्तरे ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006269024, "chapter_id": 26269, "verse_number": "३-२३-२५", "content_sanskrit": "बहुरक्तनदीपूरह्रियमाणमतङ्गजे ।\nमांसकर्दमनिर्मग्ननिष्पन्दरथमण्डले ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006269025, "chapter_id": 26269, "verse_number": "३-२३-२६", "content_sanskrit": "विकीर्णकेशशैवालविलसद्रक्तनिर्झरे ।\nअतिनिष्ठुरविध्वंसि सिंहनादभयङ्करे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006269026, "chapter_id": 26269, "verse_number": "३-२३-२७", "content_sanskrit": "रजोऽन्धकारतु मुले राक्षसीतृप्तिदायिनि ।\nशस्त्रीशरणिविच्छिन्नदैत्यकण्ठोत्थितासृजि ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006269027, "chapter_id": 26269, "verse_number": "३-२३-२८", "content_sanskrit": "प्रवृत्ते घोरसंग्रामे शक्तीनां च सुरद्विषाम् ।\nअथस्वबलमादाय पञ्चभिः प्रेरिता सती ।\nसर्पिणी बहुधा सर्पान्विससर्ज शरीरतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006269028, "chapter_id": 26269, "verse_number": "३-२३-२९", "content_sanskrit": "तक्षकर्केटकसमा वासुकिप्रमुखत्विषः ।\nनानाविधवपुर्वर्णा नानादृष्टिभयङ्कराः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006269029, "chapter_id": 26269, "verse_number": "३-२३-३०", "content_sanskrit": "नानाविधविषज्वालानिर्दग्धभुवनत्रयाः ।\nदारदं वत्सनाभं च कालकूटमथापरम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006269030, "chapter_id": 26269, "verse_number": "३-२३-३१", "content_sanskrit": "सौराष्ट्रं च विषं घोरं ब्रह्मपुत्रमथापरम् ।\nप्रतिपन्नं शौक्लिकेयमन्यान्यपि विषाणि च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006269031, "chapter_id": 26269, "verse_number": "३-२३-३२", "content_sanskrit": "व्यालैः स्वकीयवदनैर्विलोलरसनाद्वयैः ।\nविकिरन्तः शक्तिसैन्ये विसम्रुः सर्पिणीतनोः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006269032, "chapter_id": 26269, "verse_number": "३-२३-३३", "content_sanskrit": "धूम्रवर्णा द्विवदना सर्पा अतिभयङ्कराः ।\nसर्पिण्या नयनद्वन्द्वा दुत्थिताः क्रोधदीपिताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006269033, "chapter_id": 26269, "verse_number": "३-२३-३४", "content_sanskrit": "पीतवर्णास्त्रिफणका दंष्ट्राभिर्विकटाननाः ।\nसर्पिण्याः कर्णकुहरादुत्थिताः सर्पकोटयः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006269034, "chapter_id": 26269, "verse_number": "३-२३-३५", "content_sanskrit": "अग्रेपुच्छे च वदनं धारयन्तः फणान्वितम् ।\nआस्यादा नीलवपुषः सर्पिण्याः फणिनोऽभवन् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006269035, "chapter_id": 26269, "verse_number": "३-२३-३६", "content_sanskrit": "अन्यैश्च बलवर्णाश्च चतुर्वक्त्राश्चतुष्पदाः ।\nनासिकाविवरात्तस्या उद्गता उग्ररोचिषः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006269036, "chapter_id": 26269, "verse_number": "३-२३-३७", "content_sanskrit": "लंबमानमहाचर्मावृत्तस्थूलपयोधरात् ।\nनाभिकुण्डाच्च बहवो रक्तवर्णा भयानकाः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006269037, "chapter_id": 26269, "verse_number": "३-२३-३८", "content_sanskrit": "हलाहलं वहन्तश्च प्रोत्थिताः पन्नगाधिपाः ।\nविदशन्तः शक्तिसेनां दहन्तो विषवह्निभिः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006269038, "chapter_id": 26269, "verse_number": "३-२३-३९", "content_sanskrit": "बध्नन्तो भोगपाशैश्च निघ्नन्तः फणमण्डलैः ।\nअत्यन्तमाकुलां चक्रुर्ललितेशीचमूममी ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006269039, "chapter_id": 26269, "verse_number": "३-२३-४०", "content_sanskrit": "खण्ड्यमाना अपि मुहुः शक्तीनां शस्त्रकोटिभिः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006269040, "chapter_id": 26269, "verse_number": "३-२३-४१", "content_sanskrit": "उपर्युपरि वर्धन्ते सपिण्डप्रविसर्पिणः ।\nनश्यन्ति बहवः सर्पा जायन्ते चापरे पुनः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006269041, "chapter_id": 26269, "verse_number": "३-२३-४२", "content_sanskrit": "एकस्य नाशसमये बहवोऽन्ये समुत्थिताः ।\nमूलभूता यतो दुष्टा सर्पिणी न विनश्यति ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006269042, "chapter_id": 26269, "verse_number": "३-२३-४३", "content_sanskrit": "अतस्तत्कृतसर्पाणां नाशे सर्पान्तरोद्भवः ।\nततश्चशक्तिसैन्यानां शरीराणि विषानलैः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006269043, "chapter_id": 26269, "verse_number": "३-२३-४४", "content_sanskrit": "दह्यमानानि दुःखेन विप्लुतान्यभवन्रणे ।\nकिङ्कर्तव्यविमूढेषु शक्तिचक्रेषु भोगिभिः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006269044, "chapter_id": 26269, "verse_number": "३-२३-४५", "content_sanskrit": "पराक्रमं बहुविधं चक्रुस्ते पञ्च दानवाः ।\nकरीन्द्री गर्दभशतैर्युक्तं स्यन्दनमास्थितः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006269045, "chapter_id": 26269, "verse_number": "३-२३-४६", "content_sanskrit": "चक्रेण तीक्ष्णधारेण शक्तिसेनाममर्दयत् ।\nवज्रदन्ताभिधश्चान्यो भण्डदैत्यचमूपतिः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006269046, "chapter_id": 26269, "verse_number": "३-२३-४७", "content_sanskrit": "वज्रबाणाभिघातेन होष्ट्रतो हि रणं व्यधात् ।\nअथ वज्रमुखश्चैव चक्रिवन्तं महत्तरम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006269047, "chapter_id": 26269, "verse_number": "३-२३-४८", "content_sanskrit": "आरुह्य कुन्तधाराभिः शक्तिचक्रममर्दयत् ।\nवज्रदन्ताभिधानोऽन्यश्चमूनामधिपो बली ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006269048, "chapter_id": 26269, "verse_number": "३-२३-४९", "content_sanskrit": "गृध्रयुग्मरथारूढः प्रजहार शिलीमुखैः ।\nतैः सेनापतिभिर्दुष्टैः प्रोत्साहितमथाहवे ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006269049, "chapter_id": 26269, "verse_number": "३-२३-५०", "content_sanskrit": "शतमक्षौहिणीनां च निपपातैकहेलया ।\nसर्पिणी च दुराचारा बहुमायापरिग्रहा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006269050, "chapter_id": 26269, "verse_number": "३-२३-५१", "content_sanskrit": "क्षणेक्षणे कोटिसंख्यान्विससर्ज फणाधरान् ।\nतथा विकलितं सैन्यमवलोक्य रुषाकुला ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006269051, "chapter_id": 26269, "verse_number": "३-२३-५२", "content_sanskrit": "नकुली गरुडारूढा सा पपात रणाजिरे ।\nप्रतप्तकनकप्रख्या ललितातालुसम्भवा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006269052, "chapter_id": 26269, "verse_number": "३-२३-५३", "content_sanskrit": "समस्तवाङ्मयाकारा दन्तैर्वज्रमयैर्युता ।\nसर्पिण्यभिमुखं तत्र विससर्ज निजं बलम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006269053, "chapter_id": 26269, "verse_number": "३-२३-५४", "content_sanskrit": "तयाधिष्ठिततुङ्गांसः पक्षविक्षिप्तभूधरः ।\nगरुडः प्राचलद्युद्धे सुमेरुरिव जङ्गमः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006269054, "chapter_id": 26269, "verse_number": "३-२३-५५", "content_sanskrit": "सर्पिणीमायया जातान्सर्पान्दृष्ट्वा भयानकान् ।\nक्रोधरक्तेक्षणं व्यात्तं नकुली विदधे मुखम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006269055, "chapter_id": 26269, "verse_number": "३-२३-५६", "content_sanskrit": "अथ श्रीनकुलीदेव्या द्वात्रिंशद्दन्तकोटयः ।\nद्वात्रिंशत्कोटयो जाता नकुलाः कनकप्रभाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006269056, "chapter_id": 26269, "verse_number": "३-२३-५७", "content_sanskrit": "इतस्ततः खण्डयन्तः सर्पिणीसर्पमण्डलम् ।\nनिजदंष्ट्राविमर्देन नाशयन्तश्च तद्विषम् ।\nव्यभ्रमन्समरे घोरे विषघ्नाः स्वर्णबभ्रवः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006269057, "chapter_id": 26269, "verse_number": "३-२३-५८", "content_sanskrit": "उत्कर्णाः क्रोध सम्पर्काद्धूनिताशेषलोमकाः ।\nउत्फुल्ला नकुला व्यात्तवदना व्यदशन्नहीन् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006269058, "chapter_id": 26269, "verse_number": "३-२३-५९", "content_sanskrit": "एकैकमायासर्पस्य बभ्रुरेकैक उद्गतः ।\nतीक्ष्णदन्तनिपातेन खण्डयामास विग्रहम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006269059, "chapter_id": 26269, "verse_number": "३-२३-६०", "content_sanskrit": "भोगिभोगसृतै रक्तैः सृक्किणी शोणतां गते ।\nलिहन्तो नकुला जिह्वापल्लवैः पुप्लुवुर्मृधे ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006269060, "chapter_id": 26269, "verse_number": "३-२३-६१", "content_sanskrit": "नकुलैर्दश्यमानानामत्यन्तचटुलं वपुः ।\nमुहुः कुण्डलितैर्भोगैः पन्नगानां व्यचेष्टत ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006269061, "chapter_id": 26269, "verse_number": "३-२३-६२", "content_sanskrit": "नकुलावलिदष्टानां नष्टासूनां फणाभृताम् ।\nफणाभरसमुत्कीर्णा मणयो व्यरुचन्रणे ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006269062, "chapter_id": 26269, "verse_number": "३-२३-६३", "content_sanskrit": "नकुलाघातसंशीर्णफणाचक्रैर्विनिर्गतैः ।\nफणयस्तन्महाद्रोहवह्विज्वाला इवाबभुः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006269063, "chapter_id": 26269, "verse_number": "३-२३-६४", "content_sanskrit": "एवंप्रकारतो बभ्रुमण्डलैरवखण्डिते ।\nमायामये सर्पजाले सर्पिणी कोपमादधे ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006269064, "chapter_id": 26269, "verse_number": "३-२३-६५", "content_sanskrit": "तया सह महद्युद्धं कृत्वा सा नकुलेश्वरी ।\nगारुडास्त्रमतिक्रूरं समाधत्त शिलीमुखे ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006269065, "chapter_id": 26269, "verse_number": "३-२३-६६", "content_sanskrit": "तद्गारुडास्त्रमुद्दामज्वालादीपितदिङ्मुखम् ।\nप्रविश्य सर्पिणीदेहं सर्पमायां व्यशोषयत् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006269066, "chapter_id": 26269, "verse_number": "३-२३-६७", "content_sanskrit": "मायाशक्तोर्विनाशेन सर्पिणी विलयं गता ।\nक्रोधं च तद्विनाशेन प्राप्ताः पञ्च चमूवराः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006269067, "chapter_id": 26269, "verse_number": "३-२३-६८", "content_sanskrit": "यद्बलेन सुरान्सर्वान्सेनान्यस्तेऽवमेनिरे ।\nसा सर्पिणी कथाशेषं नीता नकुलवीर्यतः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006269068, "chapter_id": 26269, "verse_number": "३-२३-६९", "content_sanskrit": "अतःस्वबलनाशेन भृशं क्रुद्धाश्चमूचराः ।\nएकोद्यमेन शस्त्रौघैर्नकुलीं तामवाकिरन् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006269069, "chapter_id": 26269, "verse_number": "३-२३-७०", "content_sanskrit": "एकैव सा तार्क्ष्यरथा पञ्चभिः पृतनेश्वरी ।\nलघुहस्ततया युद्धे चक्रे वै शस्त्रवर्षिणी ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006269070, "chapter_id": 26269, "verse_number": "३-२३-७१", "content_sanskrit": "पट्टिशैर्मुसलैश्चैव भिन्दिपालैः सहस्रशः ।\nवज्रसारमयैर्दन्तैर्व्यदशन्मर्म सीमसु ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006269071, "chapter_id": 26269, "verse_number": "३-२३-७२", "content_sanskrit": "ततो हाहारुतं घोरं कुर्वाणा दैत्यकिङ्कराः ।\nउदग्रदंशनकुलैर्नकुलैराकुलीकृताः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006269072, "chapter_id": 26269, "verse_number": "३-२३-७३", "content_sanskrit": "उत्पत्य गगनात्केचिद्घोरचीत्कार कारिणः ।\nदेशन्तस्तद्द्विषां सैन्य सकुलाः प्रज्वलक्रुधः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006269073, "chapter_id": 26269, "verse_number": "३-२३-७४", "content_sanskrit": "कर्णेषु दष्ट्वा नासायामन्ये दष्टाः शिरस्तटे ।\nपृष्ठतो प्यदशन्केचिदा गत्य व्याकृतक्रियाः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006269074, "chapter_id": 26269, "verse_number": "३-२३-७५", "content_sanskrit": "विकलाश्छिन्नवर्माणो भयविस्रस्तशस्त्रिकाः ।\nनकुलैरभिभूतास्ते न्यपतन्नमरद्रुहः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006269075, "chapter_id": 26269, "verse_number": "३-२३-७६", "content_sanskrit": "केचित्प्रविश्यनकुला व्यात्तान्यास्यानि वैरिणाम् ।\nभोगिभोगानि वाकृष्य व्यदशन्रसनातलम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006269076, "chapter_id": 26269, "verse_number": "३-२३-७७", "content_sanskrit": "अन्ये कर्णेषु नकुलाः प्राविशन्देववैरिणाम् ।\nसूक्ष्मरूपा विशन्तिस्म नानारन्ध्राणि बभ्रवः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006269077, "chapter_id": 26269, "verse_number": "३-२३-७८", "content_sanskrit": "इति तैरभिभूतानि नकुलैरवलोकयन् ।\nनिजसैन्यानि दीनानि करङ्कः कोपमास्थितः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006269078, "chapter_id": 26269, "verse_number": "३-२३-७९", "content_sanskrit": "अन्येऽपि च चमूनाथा लघुहस्ता महाबलाः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006269079, "chapter_id": 26269, "verse_number": "३-२३-८०", "content_sanskrit": "प्रतिबभ्रु शरस्तोमान्ववृषुर्वारिदा इव ।\nदैत्यसैन्यपतिप्रौढ कोदडोत्थाः शिलीमुखाः ।\nबभ्रूणां दन्तकोटीषु कठोरघट्टनं व्यधुः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006269080, "chapter_id": 26269, "verse_number": "३-२३-८१", "content_sanskrit": "चमूपतिशख्यूहैराहतेभ्यः परःशतैः ।\nबभ्रूणां वज्रदतेभ्यो निश्चक्राम हुताशनः ।\nपञ्चापि ते चमूनाथविसृष्टैरेकहेलया ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006269081, "chapter_id": 26269, "verse_number": "३-२३-८२", "content_sanskrit": "स्फुरत्फलैः शरकुलैर्बभ्रुसेनां व्यमर्दयत् ।\nइतस्ततश्चमूनाथविक्षिप्तशरकोटिभिः ।\nविशीर्णगात्रा नकुला नकुलीं पर्यवारयन् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006269082, "chapter_id": 26269, "verse_number": "३-२३-८३", "content_sanskrit": "अथ सा नकुली वाणी वाङ्मयस्यैकनायिका ।\nनकुलानां परावृत्त्या महान्तं रोषमाश्रिता ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006269083, "chapter_id": 26269, "verse_number": "३-२३-८४", "content_sanskrit": "अक्षीणनकुलं नाम महास्त्रं सर्वतोमुखम् ।\nवह्निज्वालापरीताग्रं संदधे शार्ङ्गधन्वनि ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006269084, "chapter_id": 26269, "verse_number": "३-२३-८५", "content_sanskrit": "तदस्त्रतो विनिष्ठ्यूता नकुलाः कोटिसंख्याकाः ।\nवज्राङ्गा वज्रलोमानो वज्रदंष्ट्रा महाजवा ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006269085, "chapter_id": 26269, "verse_number": "३-२३-८६", "content_sanskrit": "वज्रसाराश्च निबिडा वज्रजाल भयङ्करा ।\nवज्राकारैर्नशैस्तूर्ण दारयन्तो महीतलम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006269086, "chapter_id": 26269, "verse_number": "३-२३-८७", "content_sanskrit": "वज्ररत्नप्रकाशेन लोचनेनापि शोभिताः ।\nवज्रसंपातसदृशा नासाचीत्कार कारिणः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006269087, "chapter_id": 26269, "verse_number": "३-२३-८८", "content_sanskrit": "मर्दयन्ति सुरारातिसैन्यं दशनकोटिभिः ।\nपराक्रमं बहुविधं तेनिरे ते निरेनसः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006269088, "chapter_id": 26269, "verse_number": "३-२३-८९", "content_sanskrit": "एवं नकुलकोटीभिर्वज्रघोरैर्महाबलैः ।\nविनष्टाः प्रत्यवयवं विनेशुर्दानवाधमाः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006269089, "chapter_id": 26269, "verse_number": "३-२३-९०", "content_sanskrit": "एवं वज्रमयैर्बभुमण्डलैः शण्डिते बले ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006269090, "chapter_id": 26269, "verse_number": "३-२३-९१", "content_sanskrit": "शताक्षौहिणिके संख्ये ते स्वमात्रावशेषिताः ।\nअतित्रासेन रोषेण गृहीताश्च चमूवराः ।\nसंग्राममधिकं तेनुः समाकृष्टशरासनाः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006269091, "chapter_id": 26269, "verse_number": "३-२३-९२", "content_sanskrit": "तैः समं बहुधा युद्धं तन्वाना नकुलेश्वरी ।\nपट्टिशेन करङ्कस्य चिच्छेद कठिनं शिरः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006269092, "chapter_id": 26269, "verse_number": "३-२३-९३", "content_sanskrit": "काकवाशितसुख्यानां चतुर्णामपि वैरिणाम् ।\nउत्पत्योत्पत्य तार्क्ष्येण व्यलुनादसिना शिरः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006269093, "chapter_id": 26269, "verse_number": "३-२३-९४", "content_sanskrit": "तादृशं लाघवं दृष्ट्वा नकुल्या श्यामलांबिका ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006269094, "chapter_id": 26269, "verse_number": "३-२३-९५", "content_sanskrit": "बहु मेने महासत्त्वां दुष्टासुरविनाशिनीम् ।\nनिजाङ्गदेवतत्त्वं च तस्यै श्यामांबिका ददौ ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006269095, "chapter_id": 26269, "verse_number": "३-२३-९६", "content_sanskrit": "लोकोत्तरे गुणे दृष्टे कस्य न प्रीतिसंभवः ।\nहतशिष्टा भीतभीता नकुलीशरणं गताः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006269096, "chapter_id": 26269, "verse_number": "३-२३-९७", "content_sanskrit": "सापि तान्वीक्ष्य कृपया मा भैष्टेति विहस्य च ।\nभवद्राज्ञे रणोदन्तमशेषं च निबोधत ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006269097, "chapter_id": 26269, "verse_number": "३-२३-९८", "content_sanskrit": "तयैवं प्रेषिताः शीघ्रं तदालोक्य रणक्षितिम् ।\nमुदितास्ते पुनर्भीत्या शून्यकायां पलायिताः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006269098, "chapter_id": 26269, "verse_number": "३-२३-९९", "content_sanskrit": "तदुदन्तं ततः श्रुत्वा भण्डश्चण्डो रुषाभवत् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}]