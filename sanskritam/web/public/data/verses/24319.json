[{"id": 7004319000, "chapter_id": 24319, "verse_number": "५-३-१३-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nएवं भगवती पुण्या स्तुता सा मुनिपुंगवैः ।\nचिन्तयामास सर्वेषां दास्यामि वरमुत्तमम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004319001, "chapter_id": 24319, "verse_number": "५-३-१३-२", "content_sanskrit": "ततः प्रसुप्तांस्ताञ्ज्ञात्वा रात्रौ देवी जगाम ह ।\nएकैकस्य ऋषेः स्वप्ने दर्शनं चारुहासिनी॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004319002, "chapter_id": 24319, "verse_number": "५-३-१३-३", "content_sanskrit": "ततोऽर्धरात्रे सम्प्राप्त उत्थिता जलमध्यतः ।\nविमलाम्बरसंवीता दिव्यमालाविभूषिता॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004319003, "chapter_id": 24319, "verse_number": "५-३-१३-४", "content_sanskrit": "घृतातपत्रा सुश्रोणी पद्मरागविभूषिता ।\nजगाद मा भैरिति तानेकैकं तु पृथक्पृथक्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004319004, "chapter_id": 24319, "verse_number": "५-३-१३-५", "content_sanskrit": "वसध्वं मम पार्श्वे तु भयं त्यक्त्वा क्षुधादिजम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004319005, "chapter_id": 24319, "verse_number": "५-३-१३-६", "content_sanskrit": "एवमुक्त्वा तदा देवी स्वप्नान्ते तान्महामुनीन् ।\nजगामादर्शनं पश्चात्प्रविश्य जलमात्मिकम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004319006, "chapter_id": 24319, "verse_number": "५-३-१३-७", "content_sanskrit": "ततः प्रभाते मुनयो मिथ ऊचुर्मुदन्विताः ।\nतथा दृष्टा मया दृष्टा स्वप्ने देवी सुदर्शना॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004319007, "chapter_id": 24319, "verse_number": "५-३-१३-८", "content_sanskrit": "अभयं दत्तमस्माकं सिद्धिश्चाप्यचिरेण तु ।\nप्रशस्तं दर्शनं तस्या नर्मदाया न संशयः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004319008, "chapter_id": 24319, "verse_number": "५-३-१३-९", "content_sanskrit": "अथान्यदिवसे राजन्मत्स्यानां रूपमुत्तमम् ।\nपश्यन्ति सपरीवाराः स्वकीयाश्रमसन्निधौ॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004319009, "chapter_id": 24319, "verse_number": "५-३-१३-१०", "content_sanskrit": "तान्दृष्ट्वा विस्मयाविष्टा मत्स्यांस्तत्र महर्षयः ।\nपूजयामासुरव्यग्रा हव्यकव्येन देवताः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004319010, "chapter_id": 24319, "verse_number": "५-३-१३-११", "content_sanskrit": "तान्मत्स्यसङ्घान्सम्प्राप्य महादेव्याः प्रसादतः ।\nसपुत्रदारभृत्यास्ते वर्तयन्ति पृथक्पृथक्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004319011, "chapter_id": 24319, "verse_number": "५-३-१३-१२", "content_sanskrit": "दिने दिने तथाप्येवमाश्रमेषु द्विजातयः ।\nमत्स्यानां सञ्चयं दृष्ट्वा विस्मिताश्चाभवंस्तदा॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004319012, "chapter_id": 24319, "verse_number": "५-३-१३-१३", "content_sanskrit": "मृतांस्तांस्तु सुपुष्टाङ्गान् पाठीनांश्च विशेषतः ।\nद्वारे द्वारे चाश्रमाणां तापसानां युधिष्ठिर॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004319013, "chapter_id": 24319, "verse_number": "५-३-१३-१४", "content_sanskrit": "हृष्टपुष्टास्तदा सर्वे नर्मदातीरवासिनः ।\nऋषयस्ते भयं सर्वे तत्यजुः क्षुत्तृषोद्भवम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004319014, "chapter_id": 24319, "verse_number": "५-३-१३-१५", "content_sanskrit": "ते जपन्तस्तपन्तश्च तिष्ठन्ति भरतर्षभ ।\nअर्चयन्ति पित्ःन्देवान्नर्मदातटमाश्रिताः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004319015, "chapter_id": 24319, "verse_number": "५-३-१३-१६", "content_sanskrit": "तैर्जपद्भिस्तपद्भिश्च सततं द्विजसत्तमैः ।\nभ्राजते सा सरिच्छ्रेष्ठा ताराभिर्द्यौर्ग्रहैरिव॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004319016, "chapter_id": 24319, "verse_number": "५-३-१३-१७", "content_sanskrit": "तत्र तैर्बहुलैः शुभ्रैर्ब्राह्मणैर्वेदपरागैः ।\nनर्मदा धर्मदा पूर्वं संविभक्ता यथाक्रमम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004319017, "chapter_id": 24319, "verse_number": "५-३-१३-१८", "content_sanskrit": "ऋषिभिर्दशकोटिभिर्नर्मदातीरवासिभिः ।\nविभक्तेयं विभक्ताङ्गी नर्मदा शर्मदा नृणाम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004319018, "chapter_id": 24319, "verse_number": "५-३-१३-१९", "content_sanskrit": "यज्ञोपवीतैश्च शुभैरक्षसूत्रैश्च भारत ।\nकूलद्वये महापुण्या नर्मदोदधिगामिनी॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004319019, "chapter_id": 24319, "verse_number": "५-३-१३-२०", "content_sanskrit": "पृथगायतनैः शुभ्रैर्लिङ्गैर्वालुकमृन्मयैः ।\nभ्राजते या सरिच्छ्रेष्ठा नक्षत्रैरिव शर्वरी॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004319020, "chapter_id": 24319, "verse_number": "५-३-१३-२१", "content_sanskrit": "एवं त ऋषयः सर्वे तर्पयन्तः सुरान्पित्ःन् ।\nन्यवसन्नर्मदातीरे यावदाभूतसम्प्लवम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004319021, "chapter_id": 24319, "verse_number": "५-३-१३-२२", "content_sanskrit": "किंचिद्गते ततस्तस्मिन्घोरे वर्षशताधिके ।\nअर्धरात्रे तदा कन्या जलादुत्तीर्य भारत॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004319022, "chapter_id": 24319, "verse_number": "५-३-१३-२३", "content_sanskrit": "विद्युत्पुंजसमाभासा व्यालयज्ञोपवीतिनी ।\nत्रिशूलाग्रकरा सौम्या तानुवाच ऋषींस्तदा॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004319023, "chapter_id": 24319, "verse_number": "५-३-१३-२४", "content_sanskrit": "आगच्छध्वं मुनिगणा विशध्वं मामयोनिजाम् ।\nसमेताः पुत्रदारैश्च ततः सिद्धिमवाप्स्यथ॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004319024, "chapter_id": 24319, "verse_number": "५-३-१३-२५", "content_sanskrit": "यस्य यस्य हि या वाञ्छा तस्य तां तां ददाम्यहम् ।\nविष्णुं ब्रह्माणमीशानमन्यं वा सुरमुत्तमम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004319025, "chapter_id": 24319, "verse_number": "५-३-१३-२६", "content_sanskrit": "तत्र सर्वान्नयिष्यामि प्रसन्ना वरदा ह्यहम् ।\nप्राणायामपरा भूत्वा मां विशध्वं समाहिताः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004319026, "chapter_id": 24319, "verse_number": "५-३-१३-२७", "content_sanskrit": "सह पुत्रैश्च दारैश्च त्यक्त्वाश्रमपदानि च ।\nकालक्षेपो न कर्तव्यः प्रलयोऽयमुपस्थितः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004319027, "chapter_id": 24319, "verse_number": "५-३-१३-२८", "content_sanskrit": "संहारः सर्वभूतानां कल्पदाहः सुदारुणः ।\nएकाहमभवं पूर्वं महाघोरे जनक्षये॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004319028, "chapter_id": 24319, "verse_number": "५-३-१३-२९", "content_sanskrit": "शेषा नद्यः समुद्राश्च सर्व एव क्षयंगताः ।\nवरदानान्महेशस्य तेनाहं न क्षयं गता॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004319029, "chapter_id": 24319, "verse_number": "५-३-१३-३०", "content_sanskrit": "अमृतः शाश्वतो देवः स्थाणुरीशः सनातनः ।\nस पूजितः प्रार्थितो वा किं न दद्याद्द्विजोत्तमाः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004319030, "chapter_id": 24319, "verse_number": "५-३-१३-३१", "content_sanskrit": "एवमुक्त्वा ऋषीव्रेवा प्रविवेश जलं ततः ।\nकरात्तशूला सा देवी व्यालयज्ञोपवीतिनी॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004319031, "chapter_id": 24319, "verse_number": "५-३-१३-३२", "content_sanskrit": "ततस्ते तद्वचः श्रुत्वा विस्मयापन्नमानसाः ।\nअभिवन्द्य च मां सर्वे क्षामयन्तः पुनः पुनः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004319032, "chapter_id": 24319, "verse_number": "५-३-१३-३३", "content_sanskrit": "क्षम्यतां नो यदुक्तं हि वसतां तव संश्रये ।\nगृहांस्त्यक्त्वा महाभागाः सशिष्याः सहबान्धवाः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004319033, "chapter_id": 24319, "verse_number": "५-३-१३-३४", "content_sanskrit": "जप्त्वा चैकाक्षरं ब्रह्म हृदि ध्यात्वा महेश्वरम् ।\nस्नात्वा च मन्त्रपूताभिरथ चाद्भिर्जितव्रताः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004319034, "chapter_id": 24319, "verse_number": "५-३-१३-३५", "content_sanskrit": "विविशुर्नर्मदातोयं सपक्षा इव पर्वताः ।\nद्योतयन्तो दिशः सर्वाः कुशहस्ताः सहाग्रयः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004319035, "chapter_id": 24319, "verse_number": "५-३-१३-३६", "content_sanskrit": "गतेषु तेषु राजेन्द्र अहमेकः स्थितस्तदा ।\nअमरेशं समासाद्य पूजयन्नर्मदां नदीम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004319036, "chapter_id": 24319, "verse_number": "५-३-१३-३७", "content_sanskrit": "अनुभूताः सप्तकल्पा मायूराद्या मया नृप ।\nप्रसादाद्वेधसः सर्वे रेवया सह भारत॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004319037, "chapter_id": 24319, "verse_number": "५-३-१३-३८", "content_sanskrit": "जन्मतोऽद्य दिनं यावन्न जानेऽस्याः पुरास्थितिम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004319038, "chapter_id": 24319, "verse_number": "५-३-१३-३९", "content_sanskrit": "इयं हि शांकरी शक्तिः कला शम्भोरिलाह्वया ।\nनर्मदा दुरितध्वंसकारिणी भवतारिणी॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004319039, "chapter_id": 24319, "verse_number": "५-३-१३-४०", "content_sanskrit": "यदाहमपि नाभूवं पुराकल्पेषु पाण्डव ।\nचतुर्दशसु कल्पेषु तेष्वियं सुखसंस्थिता॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004319040, "chapter_id": 24319, "verse_number": "५-३-१३-४१", "content_sanskrit": "चतुर्दश पुरा कल्पा न मृता येषु नर्मदा ।\nतानहं सम्प्रवक्ष्यामि देवी प्राह यथा मम॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004319041, "chapter_id": 24319, "verse_number": "५-३-१३-४२", "content_sanskrit": "कापिलं प्रथमं विद्धि प्राजापत्यं द्वितीयकम् ।\nब्राह्मं सौम्यं च सावित्रं बार्हस्पत्यं प्रभासकम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004319042, "chapter_id": 24319, "verse_number": "५-३-१३-४३", "content_sanskrit": "माहेन्द्रमग्निकल्पं च जयन्तं मारुतं तथा ।\nवैष्णवं बहुरूपं च ज्यौतिषं च चतुर्दशम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004319043, "chapter_id": 24319, "verse_number": "५-३-१३-४४", "content_sanskrit": "एते कल्पा मया ख्याता न मृता येषु नर्मदा ।\nमायूरं पञ्चदशमं कौर्मं चैवात्र षोडशम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004319044, "chapter_id": 24319, "verse_number": "५-३-१३-४५", "content_sanskrit": "बकं मात्स्यं च पाद्मं च वटकल्पं च भारत ।\nएकविंशतिमं चैतं वाराहं सांप्रतीनकम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004319045, "chapter_id": 24319, "verse_number": "५-३-१३-४६", "content_sanskrit": "इमे सप्त मया साकं रेवया परिशीलिताः ।\nएकविंशतिकल्पास्तु नर्मदायाः शिवाङ्गतः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004319046, "chapter_id": 24319, "verse_number": "५-३-१३-४७", "content_sanskrit": "संजाताया नृपश्रेष्ठ मया दृष्टा ह्यनेकशः ।\nकथिता नृपतिश्रेष्ठ भूयः किं कथयामि ते॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]