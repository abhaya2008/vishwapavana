[{"id": 2167330, "chapter_id": 4593, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2167331, "chapter_id": 4593, "verse_number": "१", "content_sanskrit": "ततः कर्णो महेष्वासः पाण्डवानामनीकिनीम् ।\nजघान समरे शूरः शरैः सन्नतपर्वभिः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2167332, "chapter_id": 4593, "verse_number": "२", "content_sanskrit": "तथैव पाण्डवा राजन् तव पुत्रस्य वाहिनीम् ।\nकर्णस्य पश्यतो राजन् निजघ्नुस्ते महारथाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2167333, "chapter_id": 4593, "verse_number": "३", "content_sanskrit": "कर्णोऽपि सुमहाबाहुरविध्यत् पाण्डवीं चमूम् ।\nनाराचैरर्करश्म्याभैः कर्मारपरिमार्जितैः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2167334, "chapter_id": 4593, "verse_number": "४", "content_sanskrit": "तत्र भारत कर्णेन नाराचैस्ताडिता गजाः ।\nनेदुः सेदुश्च मम्लुश्च बभ्रमुश्च दिशो दश\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2167335, "chapter_id": 4593, "verse_number": "५", "content_sanskrit": "वध्यमाने बले तस्मिन् सूतपुत्रेण मारिष ।\nनकुलोऽभ्यद्रवत् तूर्णं सूतपुत्रं महारथम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2167336, "chapter_id": 4593, "verse_number": "६", "content_sanskrit": "भीमसेनस्तथा द्रौणिं कुर्वाणं कर्म दुष्करम् ।\nविन्दानुविन्दौ कैकेयौ सात्यकिः समवारयत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2167337, "chapter_id": 4593, "verse_number": "७", "content_sanskrit": "श्रुतकर्माणमायान्तं चित्रसेनो महीपतिः ।\nप्रतिविन्ध्यस्तथा चित्रं चित्रकेतनकार्मुकम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2167338, "chapter_id": 4593, "verse_number": "८", "content_sanskrit": "दुर्योधनस्तु राजानं धर्मपुत्रं युधिष्ठिरम् ।\nसंशप्तकगणा हृष्टा ह्यभ्यधावन् धनञ्जयम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2167339, "chapter_id": 4593, "verse_number": "९", "content_sanskrit": "धृष्टद्युम्नः कृपं प्रायात् तस्मिन् वीरवरक्षये ।\nशिखण्डी कृतवर्माणमाससाद महाबलः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2167340, "chapter_id": 4593, "verse_number": "१०", "content_sanskrit": "श्रुतकीर्तिस्तथा शल्यं माद्रीपुत्रः सुतं तव ।\nदुःशासनं महाराज सहदेवः प्रतापवान्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2167341, "chapter_id": 4593, "verse_number": "११", "content_sanskrit": "कैकेयौ सात्यकिं युद्धे शरवर्षेण भास्वता ।\nसात्यकिः केकयौ चैव छादयामास सायकैः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2167342, "chapter_id": 4593, "verse_number": "१२", "content_sanskrit": "तावेनं भ्रातरौ वीरौ युधि विव्यधतुर्भृशम् ।\nविषाणाभ्यां यथा नागौ प्रतिनागं महावने\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2167343, "chapter_id": 4593, "verse_number": "१३", "content_sanskrit": "शरसञ्छिन्नवर्माणौ तावुभौ भ्रातरौ रणे ।\nसात्यकिं सत्यकर्माणं रणे विव्यधतुर्भृशम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2167344, "chapter_id": 4593, "verse_number": "१४", "content_sanskrit": "तौ सात्यकिर्महाराज प्रहसन् युद्धदुर्मदः ।\nछादयन् शरवर्षेण वारयामास सर्वतः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2167345, "chapter_id": 4593, "verse_number": "१५", "content_sanskrit": "वार्यमाणौ ततस्तौ तु शैनेयशरवृष्टिभिः ।\nशैनेयस्य रथं तूर्णं छादयामासतुः शरैः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2167346, "chapter_id": 4593, "verse_number": "१६", "content_sanskrit": "तयोस्तु धनुषी चित्रे छित्त्वा शौरिर्महाहवे ।\nअथ तौ सायकैस्तीक्ष्णैः छादयामास सात्वतः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2167347, "chapter_id": 4593, "verse_number": "१७", "content_sanskrit": "अथान्ये धनुषी चित्रे प्रगृह्याशु महाशरान् ।\nसात्यकिं छादयन्तौ तौ चेरतुर्लघु सुष्ठु च\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2167348, "chapter_id": 4593, "verse_number": "१८", "content_sanskrit": "ताभ्यां मुक्ता महाबाणाः कङ्कबर्हिणवाससः ।\nद्योतयन्तो दिशः सर्वाः सम्पेतुर्हेमभूषणाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2167349, "chapter_id": 4593, "verse_number": "१९", "content_sanskrit": "बाणान्धकारमभवत् ततो राजन् महाहवे ।\nअन्योन्यस्य तु चापानि चिच्छिदुस्ते महारथाः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2167350, "chapter_id": 4593, "verse_number": "२०", "content_sanskrit": "ततः क्रुद्धो महाराज सात्यकिर्युद्धदुर्मदः ।\nधनुरन्यत् समादाय सज्यं कृत्वा महाबलः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2167351, "chapter_id": 4593, "verse_number": "२१", "content_sanskrit": "(अनुमृज्य च राजेन्द्र तद्धनुर्भारसाधनम् ।)\nक्षुरप्रेण सुतीक्ष्णेन ह्यनुविन्दशिरोऽहरत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2167352, "chapter_id": 4593, "verse_number": "२२", "content_sanskrit": "तच्छिरो ह्यपतद् भूमौ कुण्डलोपचितं शुभम् ।\nशम्बरस्य शिरो यद्वत् निहतस्य महामृधे\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2167353, "chapter_id": 4593, "verse_number": "२३", "content_sanskrit": "शोचयत् केकयान् सर्वान् जगामाथ वसुन्धराम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2167354, "chapter_id": 4593, "verse_number": "२४", "content_sanskrit": "तं दृष्ट्वा निहतं शूरं भ्राता तस्य महारथः ।\nसज्यमन्यद् धनुः कृत्वा शैनेयं प्रत्यवारयत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2167355, "chapter_id": 4593, "verse_number": "२५", "content_sanskrit": "सहसा सात्यकिर्विद्धः स्वर्णपुङ्खैः शिलाशितैः ।\nननाद बलवन्नादं तिष्ठ तिष्ठेति चाब्रवीत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2167356, "chapter_id": 4593, "verse_number": "२६", "content_sanskrit": "सात्यकिं च पुनस्तूर्णं केकयानां महारथः ।\nशरैरग्निशिखाकारैः बाह्वोरुरसि चार्पयत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2167357, "chapter_id": 4593, "verse_number": "२७", "content_sanskrit": "स शराहतसर्वाङ्गः सात्यकिः सत्यविक्रमः ।\nरराज समरे राजन् सपुष्प इव किंशुकः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2167358, "chapter_id": 4593, "verse_number": "२८", "content_sanskrit": "सात्यकिः समरे विद्धः कैकयेन महात्मना ।\nकैकेयं पञ्चविंशत्या विव्याध प्रहसन्निव\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2167359, "chapter_id": 4593, "verse_number": "२९", "content_sanskrit": "तावन्योन्यस्य धनुषी सञ्छिद्य समरे शुभे ।\nहत्वा च सारथी तूर्णं हयांश्च रथिनां वरौ\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2167360, "chapter_id": 4593, "verse_number": "३०", "content_sanskrit": "विरथावसियुद्धाय समाजग्मतुराहवे ।\nशतचन्द्रचिते गृह्य चर्मणी सुभुजौ तु तौ\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2167361, "chapter_id": 4593, "verse_number": "३१", "content_sanskrit": "विरोचेतां महारङ्गे निस्त्रिंशवरधारिणौ ।\nयथा दैवासुरे युद्धे बलशक्रौ महाबलौ\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2167362, "chapter_id": 4593, "verse_number": "३२", "content_sanskrit": "मण्डलानि ततस्तौ तु विचरन्तौ महारणे ।\nअन्योन्यमसिभिस्तूर्णं समाजघ्नतुराहवे\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2167363, "chapter_id": 4593, "verse_number": "३३", "content_sanskrit": "अन्योन्यस्य वधे चैव चक्रतुर्यत्नमुत्तमम् ।\nकैकेयस्य ततश्चर्म द्विधा चिच्छेद सात्यकिः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2167364, "chapter_id": 4593, "verse_number": "३४", "content_sanskrit": "सात्यकेश्च तथैवासौ चर्म चिच्छेद पार्थिवः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2167365, "chapter_id": 4593, "verse_number": "३५", "content_sanskrit": "शैनेयश्चर्म छित्वा तु तारागणशतैश्चितम् ।\nचचार मण्डलान्येव गतप्रत्यागतानि च\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2167366, "chapter_id": 4593, "verse_number": "३६", "content_sanskrit": "चरन्तं तं महारङ्गे निस्त्रिंशवरधारिणम् ।\nअपहस्तेन चिच्छेद सात्यकिस्त्वरयाऽन्वितः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2167367, "chapter_id": 4593, "verse_number": "३७", "content_sanskrit": "सवर्मा केकयो राजन् द्विधा च्छिन्नो महाहवे ।\nनिपपात महेष्वासो वज्रनुन्न इवाचलः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2167368, "chapter_id": 4593, "verse_number": "३८", "content_sanskrit": "तं निहत्य रणे शूरः शैनेयो रथसत्तमः ।\nयुधामन्यो रथं तूर्णमारुरोह परन्तपः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2167369, "chapter_id": 4593, "verse_number": "३९", "content_sanskrit": "ततोऽन्यं रथमारुह्य विधिवत् कल्पितं पुनः ।\nकेकयानां महत् सैन्यं व्यधमत् सात्यकिः शरैः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2167370, "chapter_id": 4593, "verse_number": "४०", "content_sanskrit": "सा वध्यमाना समरे केकयानां महाचमूः ।\nसमुत्सृज्य रणे शस्त्रं प्रदुद्राव दिशो दश\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2167371, "chapter_id": 4593, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nकैकेयवधो नाम त्रयोदशोऽध्यायः ॥१३॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]