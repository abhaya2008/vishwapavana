[{"id": 2109112, "chapter_id": 3367, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2109113, "chapter_id": 3367, "verse_number": "१", "content_sanskrit": "एवमुक्त्वा ततः श्रीमान् मन्त्रिभिश्चानुमोदितः ।\nआरुरोह प्रतिज्ञां च सर्पसत्राय पार्थिवः\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2109114, "chapter_id": 3367, "verse_number": "२", "content_sanskrit": "ब्रह्मन् भरतशार्दूलो राजा पारिक्षितस्तदा ।\nपुरोहितमथाहूय ऋत्विजो वसुधाधिपः ।\nअब्रवीद् वाक्यसम्पन्नः सम्पन्नार्थकरं वचः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2109115, "chapter_id": 3367, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2109116, "chapter_id": 3367, "verse_number": "३", "content_sanskrit": "यो नो हिंसितवांस्तातं तक्षकः स दुरात्मवान् ।\nप्रतिकुर्यां तथा तस्य तद् भवन्तो ब्रुवन्तु मे \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2109117, "chapter_id": 3367, "verse_number": "४", "content_sanskrit": "अपि तत्कर्म विदितं भवतां येन पन्नगम् ।\nतक्षकं सम्प्रदीप्तेऽग्नौ प्रापयेयं सबान्धवान् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2109118, "chapter_id": 3367, "verse_number": "५", "content_sanskrit": "यथा तेन पिता मह्यं पूर्वं दग्धो विषाग्निना ।\nतथाऽहमपि तं पापं दग्धुमिच्छामि पन्नगम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2109119, "chapter_id": 3367, "verse_number": "", "content_sanskrit": "ऋत्विजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2109120, "chapter_id": 3367, "verse_number": "६", "content_sanskrit": "अस्ति राजन् महत् सत्रं तदर्थं देवनिर्मितम् ।\nसर्पसत्रमिति ख्यातं पुराणे कथ्यते नृप\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2109121, "chapter_id": 3367, "verse_number": "७", "content_sanskrit": "आहर्ता तस्य सत्रस्य त्वन्नान्योऽद्य जनाधिप ।\nइति पौराणिकाः प्राहुरस्माकं चास्ति स क्रतुः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2109122, "chapter_id": 3367, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2109123, "chapter_id": 3367, "verse_number": "८", "content_sanskrit": "एवमुक्तः स राजर्षिर्मेने सर्पं हि तक्षकम् ।\nहुताशनमुखं दीप्तं प्रविष्टं द्विजसत्तम\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2109124, "chapter_id": 3367, "verse_number": "९", "content_sanskrit": "ततोऽब्रवीन्मन्त्रविदः कर्मज्ञान् ब्राह्मणांस्तदा ।\nआहरिष्यामि तत्सत्रं सम्भाराः सम्भ्रियन्तु मे\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2109125, "chapter_id": 3367, "verse_number": "१०", "content_sanskrit": "ततस्त ऋत्विजस्तस्य शास्त्रेण द्विजसत्तम ।\nदेशं तं मापयामासुर्यज्ञायतनकारणात् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2109126, "chapter_id": 3367, "verse_number": "११", "content_sanskrit": "यथावज्ज्ञानविद्वांसः सर्वे विद्यापरांगताः ।\nऋद्ध्या परमया युक्तमिष्टं विद्वज्जनायुतम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2109127, "chapter_id": 3367, "verse_number": "१२", "content_sanskrit": "प्रभूतधनधान्याढ्यम् ऋत्विजः सुनिवेशितम्  ।\nनिर्माय चापि विधिवद् यज्ञायतनमुत्तमम्\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2109128, "chapter_id": 3367, "verse_number": "१३", "content_sanskrit": "राजानं दीक्षयामासुः सर्पसत्राय वै द्विजाः ।\nइदं चासीत् तत्र पूर्वं सर्पसत्रे भविष्यति\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2109129, "chapter_id": 3367, "verse_number": "१४", "content_sanskrit": "निमित्तं महदुत्पन्नं यज्ञविघ्नकरं तदा ।\nयज्ञस्यायतने तस्मिन् क्रियमाणे वचोऽब्रवीत् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2109130, "chapter_id": 3367, "verse_number": "१५", "content_sanskrit": "स्थपतिर्बुद्धिसम्पन्नो वास्तुविद्याविशारदः ।\nइत्यब्रवीत् सूत्रधारः सूतः पौराणिकस्तदा\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2109131, "chapter_id": 3367, "verse_number": "१६", "content_sanskrit": "यस्मिन् काले च देशे वः स्थापनेयं प्रकीर्तितम् ।\nब्राह्मणं कारणं कृत्वा नायं संस्थाप्यते  क्रतुः\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2109132, "chapter_id": 3367, "verse_number": "१७", "content_sanskrit": "एतच्छ्रुत्वा च राजा स प्राग्दीक्षाकालमब्रवीत् ।\nक्षत्तारं नेह मे कश्चिदज्ञातः प्रविशेदिति\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2109133, "chapter_id": 3367, "verse_number": "१८", "content_sanskrit": "ततः कर्म प्रववृधे सर्पसत्रे विधानतः ।\nपर्यक्रामंश्च विधिवत् स्वे स्वे कर्मणि याजकाः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2109134, "chapter_id": 3367, "verse_number": "१९", "content_sanskrit": "विधाय कृष्णवासांसि धूमसंरक्तलोचनाः ।\nजुहुवुर्मन्त्रवच्चैव समिद्धं जातवेदसम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2109135, "chapter_id": 3367, "verse_number": "२०", "content_sanskrit": "कम्पयन्तश्च सर्वेषामुरगाणां मनांसि ते ।\nसर्पानाजुहुवुस्तत्र सर्वानग्निमुखे तदा \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2109136, "chapter_id": 3367, "verse_number": "२१", "content_sanskrit": "ततः सर्पाः समापेतुः प्रदीप्ते हव्यवाहने ।\nविवेष्टमानाः कृपणा आह्वयन्तः परस्परम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2109137, "chapter_id": 3367, "verse_number": "२२", "content_sanskrit": "विस्फुरन्तः श्वसन्तश्च वेष्टयन्तस्तथापरे ।\nपुच्छैः शिरोभिश्च भृशं चित्रभानुं प्रपेदिरे \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2109138, "chapter_id": 3367, "verse_number": "२३", "content_sanskrit": "श्वेताः कृष्णाश्च रक्ताश्च स्थविराः शिशवस्तथा ।\nरवन्तो भैरवान् नादान् पेतुर्दीप्ते विभावसौ \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2109139, "chapter_id": 3367, "verse_number": "२४", "content_sanskrit": "क्रोशो योजनमात्रो हि गोकर्णस्य प्रमाणतः ।\nपतन्त्यजस्रं वेगेन चाश्नावग्निमतोऽपरे \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2109140, "chapter_id": 3367, "verse_number": "२५", "content_sanskrit": "एवं शतसहस्राणि प्रयुतान्यर्बुदानि च ।\nअवशानि प्रविष्टानि पन्नगानां द्विजोत्तम \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2109141, "chapter_id": 3367, "verse_number": "२६", "content_sanskrit": "उन्दुरा इव तत्रान्ये हस्तिहस्ता इवापरे ।\nमत्ता इव च मातङ्गा महाकाया महाबलाः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2109142, "chapter_id": 3367, "verse_number": "२७", "content_sanskrit": "उच्चावचाश्च बहवो नानावर्णा विषोद्बणाः ।\nघोराश्च परिघप्रख्या दन्दशूका महाबलाः ।\nप्रपेतुरग्नावुरगा मातृवाग्दण्डपीडिताः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2109143, "chapter_id": 3367, "verse_number": "३४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nषट्चत्वारिंशोऽध्यायः ॥४६॥ ॥ आस्तीकपर्वणि चतुस्त्रिंशोऽध्यायः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]