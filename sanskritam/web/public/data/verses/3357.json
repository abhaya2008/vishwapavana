[{"id": 2108727, "chapter_id": 3357, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108728, "chapter_id": 3357, "verse_number": "१", "content_sanskrit": "एवमुक्तः स तेजस्वी शृङ्गी कोपसमन्वितः ।\nमृतधारं गुरुं श्रुत्वा पर्यतप्यत मन्युना\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108729, "chapter_id": 3357, "verse_number": "२", "content_sanskrit": "स तं कृशमभिप्रेक्ष्य सूनृतां वाचमुत्सृजन् ।\nअपृच्छत कथं तातः स मेऽद्य मृतभारकः\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108730, "chapter_id": 3357, "verse_number": "", "content_sanskrit": "कृशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108731, "chapter_id": 3357, "verse_number": "३", "content_sanskrit": "राज्ञा परीक्षिता तत्र मृगयां परिधावता ।\nअवसक्तः पितुस्तेऽद्य मृतः स्कन्धे भुजङ्गमः\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108732, "chapter_id": 3357, "verse_number": "", "content_sanskrit": "शृङ्गी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108733, "chapter_id": 3357, "verse_number": "४", "content_sanskrit": "किं मे पित्रा कृतं तस्य राज्ञोऽनिष्टं दुरात्मनः ।\nब्रूहि त्वं कृश तत्त्वेन पश्य मे तपसो बलम्\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108734, "chapter_id": 3357, "verse_number": "", "content_sanskrit": "कृशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108735, "chapter_id": 3357, "verse_number": "५", "content_sanskrit": "स राजा मृगयां यातः परीक्षिदभिमन्युजः ।\nससार मृगमेकाकी विद्धोऽयान्नष्टवान् मृगः\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108736, "chapter_id": 3357, "verse_number": "६", "content_sanskrit": "न चाप स मृगं राजा चरंस्तस्मिन्महावने ।\nपितरं ते स दृष्ट्वैव पप्रच्छानभिभाषिणम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2108737, "chapter_id": 3357, "verse_number": "७", "content_sanskrit": "तं स्थूणभूतं तिष्ठन्तं क्षुत्पिपासाश्रमान्वितः ।\nपुनःपुनर्मृगं नष्टं पप्रच्छ पितरं तव \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2108738, "chapter_id": 3357, "verse_number": "८", "content_sanskrit": "स च मौनव्रतोपेतो नैव तं प्रत्यभाषत ।\nतस्य राजा धनुष्कोट्या सर्प्पं स्कन्धे समासृजत् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2108739, "chapter_id": 3357, "verse_number": "९", "content_sanskrit": "शृङ्गिन् तव पिता सौम्य तथैवास्ते यतव्रतः ।\nसोऽपि राजा स्वनगरं प्रतियातो गजाह्वयम्\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2108740, "chapter_id": 3357, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2108741, "chapter_id": 3357, "verse_number": "१०", "content_sanskrit": "श्रुत्वैतद् ऋषिपुत्रः स भृशं क्रुद्धो व्यतिष्ठत ।\nकोपसंरक्तनयनः प्रज्वलन्निव मन्युना \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2108742, "chapter_id": 3357, "verse_number": "११", "content_sanskrit": "आविष्टः स तु कोपेन शशाप नृपतिं तदा ।\nवार्युपस्पृश्य तेजस्वी क्रोधेन च बलात्कृतः\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2108743, "chapter_id": 3357, "verse_number": "", "content_sanskrit": "शृङ्गी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2108744, "chapter_id": 3357, "verse_number": "१२", "content_sanskrit": "योऽसौ वृद्धस्य तातस्य तथा कृच्छ्रगतस्य च ।\nस्कन्धे मृतमवास्राक्षीत् पन्नगं राजकिल्बिषी \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2108745, "chapter_id": 3357, "verse_number": "१३", "content_sanskrit": "तं पापमतिसंरब्धस्तक्षकः पन्नगोत्तमः ।\nआशीविषस्तिग्मतेजा मद्वाक्यबलचोदितः\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2108746, "chapter_id": 3357, "verse_number": "१४", "content_sanskrit": "सप्तरात्रादितो नेता यमस्य सदनं प्रति ।\nद्विजानामवमन्तारं कुरूणामयशस्करम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2108747, "chapter_id": 3357, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2108748, "chapter_id": 3357, "verse_number": "समाप्तिः", "content_sanskrit": "इति शप्त्वा नृपं क्रुद्धः शृङ्गी पितरमभ्यगात् ।\nआसीनं गोचरे तस्मिन् वहन्तं शवपन्नगम्\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2108749, "chapter_id": 3357, "verse_number": "१६", "content_sanskrit": "स तमालक्ष्य पितरं शृङ्गी स्कन्धगतेन वै ।\nशवेन भुजगेनासीद् भूयः क्रोधसमन्वितः ।\nदुःखाच्चाश्रूणि मुञ्चन् वै पितरं चेदमब्रवीत्\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2108750, "chapter_id": 3357, "verse_number": "", "content_sanskrit": "शृङ्गी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2108751, "chapter_id": 3357, "verse_number": "१७", "content_sanskrit": "श्रुत्वेमां धर्षणां तात तव तेन दुरात्मना ।\nराज्ञा परीक्षिता कोपादशपं तमहं नृपम्\t ॥ १७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2108752, "chapter_id": 3357, "verse_number": "१८", "content_sanskrit": "तदर्हति सदा चोग्रं शापं कुरुकुलाधमः ।\nसप्तमेऽहनि तं पापं तक्षकः पन्नगोत्तमः ।\nवैवस्वतस्य भवनं नेता परमदारुणम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2108753, "chapter_id": 3357, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2108754, "chapter_id": 3357, "verse_number": "१९", "content_sanskrit": "तमब्रवीत्पिता ब्रह्मंस्तथा कोपसमन्वितम् ।\nन मे प्रियं कृतं तात नैष धर्मस्तपस्विनाम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2108755, "chapter_id": 3357, "verse_number": "२०", "content_sanskrit": "वयं तस्य नरेन्द्रस्य विषये निवसामहे ।\nन्यायतो रक्षितास्तेन तस्य शापं न रोचये\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2108756, "chapter_id": 3357, "verse_number": "२१", "content_sanskrit": "सर्वथा वर्तमानस्य राज्ञो हि विषये सदा ।\nक्षन्तव्यं पुत्र धर्मो हि हतो हन्ति न संशयः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2108757, "chapter_id": 3357, "verse_number": "२२", "content_sanskrit": "यदि राजा न रक्षेत पीडा वै नः परा भवेत् ।\nन शक्नुयाम चरितुं धर्मं पुत्र यथासुखम्\t ॥ २२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2108758, "chapter_id": 3357, "verse_number": "२३", "content_sanskrit": "रक्ष्यमाणा वयं तात राजभिः शास्त्रदृष्टिभिः ।\nचरामो विपुलं धर्मं तेषां नाशोऽस्ति धर्मतः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2108759, "chapter_id": 3357, "verse_number": "२४", "content_sanskrit": "परीक्षित्तु विशेषेण यथाऽस्य प्रपितामहः ।\nरक्षत्यस्मान् यथा राज्ञा रक्षितव्याः प्रजास्तथा\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2108760, "chapter_id": 3357, "verse_number": "२५", "content_sanskrit": "तेनेह क्षुधितेनैत्य श्रान्तेन मृगलिप्सुना ।\nआजानता व्रतमिदं कृतमेतदसंशयम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2108761, "chapter_id": 3357, "verse_number": "२६", "content_sanskrit": "कस्मादिदं त्वया बाल्यात् सहसा दुष्कृतं कृतम् ।\nन ह्यर्हति नृपः शापम् अस्मत्तः पुत्र सर्वथा \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2108762, "chapter_id": 3357, "verse_number": "२४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nषड्त्रिंशोऽध्यायः ॥३६॥ ॥ आस्तीकपर्वणि चतुर्विंशोऽध्यायः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]