[{"id": 7000395000, "chapter_id": 20395, "verse_number": "२-६७-१", "content_sanskrit": "ययातिरुवाच ।\nअस्मद्भाग्यप्रसंगेन भवतो दर्शनं मम ।\nसंजातं शक्रसंवाह एतच्छ्रेयो ममातुलम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000395001, "chapter_id": 20395, "verse_number": "२-६७-२", "content_sanskrit": "मानवा मर्त्यलोके च पापं कुर्वंति दारुणम् ।\nतेषां कर्मविपाकं च मातले वद सांप्रतम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000395002, "chapter_id": 20395, "verse_number": "२-६७-३", "content_sanskrit": "मातलिरुवाच ।\nश्रूयतामभिधास्यामि पापाचारस्य लक्षणम् ।\nश्रुते सति महज्ज्ञानमत्रलोके प्रजायते॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000395003, "chapter_id": 20395, "verse_number": "२-६७-४", "content_sanskrit": "वेदनिंदां प्रकुर्वंति ब्रह्माचारस्य कुत्सनम् ।\nमहापातकमेवापि ज्ञातव्यं ज्ञानपंडितैः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000395004, "chapter_id": 20395, "verse_number": "२-६७-५", "content_sanskrit": "साधूनामपि सर्वेषां यः पीडां हि समाचरेत् ।\nमहापातकमेवापि प्रायश्चित्ते न हि व्रजेत्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000395005, "chapter_id": 20395, "verse_number": "२-६७-६", "content_sanskrit": "कुलाचारं परित्यज्य अन्याचारं व्रजंति च ।\nएतच्च पातकं घोरं कथितं कृत्यवेदिभिः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000395006, "chapter_id": 20395, "verse_number": "२-६७-७", "content_sanskrit": "मातापित्रोश्च यो निंदां ताडनं भगिनीषु च ।\nपितृस्वसृनिंदनं च तदेव पातकं ध्रुवम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000395007, "chapter_id": 20395, "verse_number": "२-६७-८", "content_sanskrit": "संप्राप्ते श्राद्धकालेपि पंचक्रोशांतरेस्थितम् ।\nजामातरं परित्यज्य तथा च दुहितुः सुतम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000395008, "chapter_id": 20395, "verse_number": "२-६७-९", "content_sanskrit": "स्वसारं चैव स्वस्रीयं परित्यज्य प्रवर्तते ।\nकामात्क्रोधाद्भयाद्वापि अन्यं भोजयते यदा॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000395009, "chapter_id": 20395, "verse_number": "२-६७-१०", "content_sanskrit": "पितरो नैव भुंजंति देवाश्चैव न भुंजते ।\nएतच्च पातकं तस्य पितृघातसमं कृतम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000395010, "chapter_id": 20395, "verse_number": "२-६७-११", "content_sanskrit": "दानकालेपि संप्राप्ते आगते ब्राह्मणे किल ।\nभूरिदानं परित्यज्य कतिभ्यो हि प्रदीयते॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000395011, "chapter_id": 20395, "verse_number": "२-६७-१२", "content_sanskrit": "एकस्मै दीयते दानमन्येभ्योपि न दीयते ।\nएतच्च पातकं घोरं दानभ्रंशकरं स्मृतम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000395012, "chapter_id": 20395, "verse_number": "२-६७-१३", "content_sanskrit": "यजमानगृहे सेवा संस्थितान्ब्राह्मणान्निजान् ।\nपरित्यज्य हि यद्दानं न दानस्य च लक्षणम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000395013, "chapter_id": 20395, "verse_number": "२-६७-१४", "content_sanskrit": "समाश्रितं हि यं विप्रं धर्माचारसमन्वितम् ।\nसर्वोपायैः सुपुष्येत्तं सुदानैर्बहुभिर्नृप॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000395014, "chapter_id": 20395, "verse_number": "२-६७-१५", "content_sanskrit": "न गणयेन्मूर्खं विद्वांसं पोष्यो विप्रः सदा भवेत् ।\nसर्वैः पुण्यैः समायुक्तं सुदानैर्बहुभिर्नृप॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000395015, "chapter_id": 20395, "verse_number": "२-६७-१६", "content_sanskrit": "तं समभ्यर्च्य विद्वांसं प्राप्तं विप्रं सदार्हयेत् ।\nतं हि त्यक्त्वा ददेद्दानमन्यस्मै ब्राह्मणाय वै॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000395016, "chapter_id": 20395, "verse_number": "२-६७-१७", "content_sanskrit": "दत्तं हुतं भवेत्तस्य निष्फलं नात्र संशयः ।\nब्राह्मणः क्षत्रियो वैश्यः शूद्रश्चापि चतुर्थकः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000395017, "chapter_id": 20395, "verse_number": "२-६७-१८", "content_sanskrit": "पुण्यकालेषु सर्वेषु संश्रितं पूजयेद्द्विजम् ।\nमूर्खं वापि हि विद्वांसं तस्य पुण्यफलं शृणु॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000395018, "chapter_id": 20395, "verse_number": "२-६७-१९", "content_sanskrit": "अश्वमेधस्य यज्ञस्य फलं तस्य प्रजायते ।\nकस्माद्धिकारणाद्राजञ्छक्यं प्राप्य न कारयेत्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000395019, "chapter_id": 20395, "verse_number": "२-६७-२०", "content_sanskrit": "अन्यो विप्रः समायातस्तत्कालं श्राद्धकर्मणि ।\nउभौ तौ पूजयेत्तत्र भोजनाच्छादनैस्ततः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000395020, "chapter_id": 20395, "verse_number": "२-६७-२१", "content_sanskrit": "तांबूलदक्षिणाभिश्च पितरस्तस्य हर्षिताः ।\nश्राद्धभुक्ताय दातव्यं सदा दानं च दक्षिणा॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000395021, "chapter_id": 20395, "verse_number": "२-६७-२२", "content_sanskrit": "न ददेच्छ्राद्धकर्ता यो गोहत्यादि समं भवेत् ।\nद्वावेतौ पूजयेत्तस्माच्छ्रद्धया नृपसत्तम॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000395022, "chapter_id": 20395, "verse_number": "२-६७-२३", "content_sanskrit": "निर्द्धनत्व प्रभावाद्वै तमेकं हि प्रपूजयेत् ।\nव्यतीपातेपि संप्राप्ते वैधृतौ च नृपोत्तम॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000395023, "chapter_id": 20395, "verse_number": "२-६७-२४", "content_sanskrit": "अमावास्यां तथा राजन्क्षयाहे परपक्षके ।\nश्राद्धमेवं प्रकर्तव्यं ब्राह्मणादि त्रिवर्णकैः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000395024, "chapter_id": 20395, "verse_number": "२-६७-२५", "content_sanskrit": "यज्ञे तथा महाराज ऋत्विजश्च प्रकारयेत् ।\nतथा विप्राः प्रकर्तव्याः श्राद्धदानाय सर्वदा॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000395025, "chapter_id": 20395, "verse_number": "२-६७-२६", "content_sanskrit": "अविज्ञातः प्रकर्तव्यो ब्राह्मणो नैव जानता ।\nयस्यापि ज्ञायते वंशः कुलं त्रिपुरुषं तथा॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000395026, "chapter_id": 20395, "verse_number": "२-६७-२७", "content_sanskrit": "आचारश्च तथा राजंस्तं विप्रं सन्निमंत्रयेत् ।\nकुलं न ज्ञायते यस्य आचारेण विचारयेत्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000395027, "chapter_id": 20395, "verse_number": "२-६७-२८", "content_sanskrit": "श्राद्धदाने प्रकर्तव्ये विशुद्धो मूर्ख एव हि ।\nअविज्ञातो भवेद्विप्रो वेदवेदांगपारगः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000395028, "chapter_id": 20395, "verse_number": "२-६७-२९", "content_sanskrit": "श्राद्धदानं प्रकर्तव्यं तस्माद्विप्रं निमंत्रयेत् ।\nआतिथ्यं तु प्रकर्तव्यमपूर्वं नृपसत्तम॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000395029, "chapter_id": 20395, "verse_number": "२-६७-३०", "content_sanskrit": "अन्यथा कुरुते पापी स याति नरकं ध्रुवम् ।\nतस्माद्विप्रः प्रकर्तव्यो दाने श्राद्धे च पर्वसु॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000395030, "chapter_id": 20395, "verse_number": "२-६७-३१", "content_sanskrit": "आदौ परीक्षयेद्विप्रं श्राद्धे दाने प्रकारयेत् ।\nनाश्नंति तस्य वै गेहे पितरो विप्रवर्जिताः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000395031, "chapter_id": 20395, "verse_number": "२-६७-३२", "content_sanskrit": "शापं दत्त्वा ततो यांति श्राद्धाद्विप्रविवर्जितात् ।\nमहापापी भवेत्सोपि ब्रह्मणः सदृशो यदि॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000395032, "chapter_id": 20395, "verse_number": "२-६७-३३", "content_sanskrit": "पैत्राचारं परित्यज्य यो वर्तेत नरोत्तम ।\nमहापापी स विज्ञेयः सर्वधर्मबहिष्कृतः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000395033, "chapter_id": 20395, "verse_number": "२-६७-३४", "content_sanskrit": "ये त्यजंति शिवाचारं वैष्णवं भोगदायकम् ।\nनिंदंति ब्राह्मणं धर्मं विज्ञेयाः पापवर्द्धनाः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000395034, "chapter_id": 20395, "verse_number": "२-६७-३५", "content_sanskrit": "ये त्यजंति शिवाचारं शिवभक्तान्द्विषंति च ।\nहरिं निंदंति ये पापा ब्रह्मद्वेषकराः सदा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000395035, "chapter_id": 20395, "verse_number": "२-६७-३६", "content_sanskrit": "आचारनिंदका ये ते महापातककृत्तमाः ।\nआद्यं पूज्यं परं ज्ञानं पुण्यं भागवतं तथा॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000395036, "chapter_id": 20395, "verse_number": "२-६७-३७", "content_sanskrit": "वैष्णवं हरिवंशं वा मत्स्यं वा कूर्ममेव च ।\nपाद्मं वा ये पूजयंति तेषां श्रेयो वदाम्यहम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000395037, "chapter_id": 20395, "verse_number": "२-६७-३८", "content_sanskrit": "प्रत्यक्षं तेन वै देवः पूजितो मधुसूदनः ।\nतस्मात्प्रपूजयेज्ज्ञानं वैष्णवं विष्णुवल्लभम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000395038, "chapter_id": 20395, "verse_number": "२-६७-३९", "content_sanskrit": "देवस्थाने च नित्यं वै वैष्णवं पुस्तकं नृप ।\nतस्मिन्प्रपूजिते विप्र पूजितः कमलापतिः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000395039, "chapter_id": 20395, "verse_number": "२-६७-४०", "content_sanskrit": "असंपूज्य हरेर्ज्ञानं ये गायंति लिखंति च ।\nअज्ञाय तत्प्रयच्छंति शृण्वंत्युच्चारयंति च॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000395040, "chapter_id": 20395, "verse_number": "२-६७-४१", "content_sanskrit": "विक्रीडंति च लोभेन कुज्ञान नियमेन च ।\nअसंस्कृतप्रदेशेषु यथेष्टं स्थापयंति च॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000395041, "chapter_id": 20395, "verse_number": "२-६७-४२", "content_sanskrit": "हरिज्ञानं यथाक्षेमं प्रत्यक्षाच्च प्रकाशयेत् ।\nअधीते च समर्थश्च यः प्रमादं करोति च॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000395042, "chapter_id": 20395, "verse_number": "२-६७-४३", "content_sanskrit": "अशुचिश्चाशुचौ स्थाने यः प्रवक्ति शृणोति च ।\nइति सर्वं समासेन ज्ञाननिंदा समं स्मृतम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000395043, "chapter_id": 20395, "verse_number": "२-६७-४४", "content_sanskrit": "गुरुपूजामकृत्वैव यः शास्त्रं श्रोतुमिच्छति ।\nन करोति च शुश्रूषामाज्ञाभंगं च भावतः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000395044, "chapter_id": 20395, "verse_number": "२-६७-४५", "content_sanskrit": "नाभिनंदति तद्वाक्यमुत्तरं संप्रयच्छति ।\nगुरुकर्मणि साध्ये च तदुपेक्षां करोति च॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000395045, "chapter_id": 20395, "verse_number": "२-६७-४६", "content_sanskrit": "गुरुमार्तमशक्तं च विदेशं प्रस्थितं तथा ।\nअरिभिः परिभूतं वा यः संत्यजति पापकृत्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000395046, "chapter_id": 20395, "verse_number": "२-६७-४७", "content_sanskrit": "पठमानं पुराणं तु तस्य पापं वदाम्यहम् ।\nकुंभीपाके वसेत्तावद्यावदिंद्राश्चतुर्दश॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000395047, "chapter_id": 20395, "verse_number": "२-६७-४८", "content_sanskrit": "पठमानं गुरुं यो हि उपेक्षयति पापधीः ।\nतस्यापि पातकं घोरं चिरं नरकदायकम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000395048, "chapter_id": 20395, "verse_number": "२-६७-४९", "content_sanskrit": "भार्यापुत्रेषु मित्रेषु यश्चावज्ञां करोति च ।\nइत्येतत्पातकं ज्ञेयं गुरुनिन्दासमं महत्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000395049, "chapter_id": 20395, "verse_number": "२-६७-५०", "content_sanskrit": "ब्रह्महा स्वर्णस्तेयी च सुरापी गुरुतल्पगः ।\nमहापातकिनश्चैते तत्संयोगी च पंचमः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000395050, "chapter_id": 20395, "verse_number": "२-६७-५१", "content_sanskrit": "क्रोधाद्द्वेषाद्भयाल्लोभाद्ब्राह्मणस्य विशेषतः ।\nमर्मातिकृन्तको यश्च ब्रह्मघ्नः स प्रकीर्तितः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000395051, "chapter_id": 20395, "verse_number": "२-६७-५२", "content_sanskrit": "ब्राह्मणं यः समाहूय याचमानमकिंचनम् ।\nपश्चान्नास्तीति यो ब्रूयात्स च वै ब्रह्महा नृप॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000395052, "chapter_id": 20395, "verse_number": "२-६७-५३", "content_sanskrit": "यस्तु विद्याभिमानेन निस्तेजयति वै द्विजम् ।\nउदासीनं सभामध्ये ब्रह्महा स प्रकीर्तितः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000395053, "chapter_id": 20395, "verse_number": "२-६७-५४", "content_sanskrit": "मिथ्यागुणैरथात्मानं नयत्युत्कर्षतां पुनः ।\nगुरुं विरोधयेद्यस्तु स च वै ब्रह्महा स्मृतः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000395054, "chapter_id": 20395, "verse_number": "२-६७-५५", "content_sanskrit": "क्षुत्तृषातप्तदेहानामन्नभोजनमिच्छताम् ।\nयः समाचरते विघ्नं तमाहुर्ब्रह्मघातकम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000395055, "chapter_id": 20395, "verse_number": "२-६७-५६", "content_sanskrit": "पिशुनः सर्वलोकानां रंध्रान्वेषणतत्परः ।\nउद्वेजनकरः क्रूरः स च वै ब्रह्महा स्मृतः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000395056, "chapter_id": 20395, "verse_number": "२-६७-५७", "content_sanskrit": "देवद्विज गवां भूमिं पूर्वदत्तां हरेत्तु यः ।\nप्रनष्टामपि कालेन तमाहुर्ब्रह्मघातकम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000395057, "chapter_id": 20395, "verse_number": "२-६७-५८", "content_sanskrit": "द्विजवित्तापहरणं न्यासेन समुपार्जितम् ।\nब्रह्महत्यासमं ज्ञेयं तस्य पातकमुत्तमम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000395058, "chapter_id": 20395, "verse_number": "२-६७-५९", "content_sanskrit": "अग्निहोत्रं परित्यज्य पंचयज्ञीयकर्मणि ।\nमातापित्रोर्गुरूणां च कूटसाक्ष्यं च यश्चरेत्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000395059, "chapter_id": 20395, "verse_number": "२-६७-६०", "content_sanskrit": "अप्रियं शिवभक्तानामभक्ष्याणां च भक्षणम् ।\nवने निरपराधानां प्राणिनां च प्रमारणम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000395060, "chapter_id": 20395, "verse_number": "२-६७-६१", "content_sanskrit": "गवां गोष्ठे वने चाग्नेः पुरे ग्रामे च दीपनम् ।\nइति पापानि घोराणि सुरापानसमानि तु॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000395061, "chapter_id": 20395, "verse_number": "२-६७-६२", "content_sanskrit": "दीनसर्वस्वहरणं परस्त्रीगजवाजिनाम् ।\nगोभूरजतवस्त्राणामोषधीनां रसस्य च॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000395062, "chapter_id": 20395, "verse_number": "२-६७-६३", "content_sanskrit": "चंदनागुरुकर्पूर कस्तूरी पट्ट वाससाम् ।\nपरन्यासापहरणं रुक्मस्तेयसमं स्मृतम्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000395063, "chapter_id": 20395, "verse_number": "२-६७-६४", "content_sanskrit": "कन्याया वरयोग्याया अदानं सदृशे वरे ।\nपुत्रमित्रकलत्रेषु गमनं भगिनीषु च॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000395064, "chapter_id": 20395, "verse_number": "२-६७-६५", "content_sanskrit": "कुमारीसाहसं घोरमंत्यजस्त्रीनिषेवणम् ।\nसवर्णायाश्च गमनं गुरुतल्पसमं स्मृतम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000395065, "chapter_id": 20395, "verse_number": "२-६७-६६", "content_sanskrit": "महापातकतुल्यानि पापान्युक्तानि यानि तु ।\nतानि पातकसंज्ञानि तन्न्यूनमुपपातकम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000395066, "chapter_id": 20395, "verse_number": "२-६७-६७", "content_sanskrit": "द्विजायार्थं प्रतिज्ञाय न प्रयच्छति यः पुनः ।\nतत्र विस्मरते विप्रस्तुल्यं तदुपपातकम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000395067, "chapter_id": 20395, "verse_number": "२-६७-६८", "content_sanskrit": "द्विजद्रव्यापहरणं मर्यादाया व्यतिक्रमम् ।\nअतिमानातिकोपश्च दांभिकत्वं कृतघ्नता॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000395068, "chapter_id": 20395, "verse_number": "२-६७-६९", "content_sanskrit": "अन्यत्र विषयासक्तिः कार्पर्ण्यं शाठ्यमत्सरम् ।\nपरदाराभिगमनं साध्वीकन्याभिदूषणम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000395069, "chapter_id": 20395, "verse_number": "२-६७-७०", "content_sanskrit": "परिवित्तिः परिवेत्ता यया च परिविद्यते ।\nतयोर्दानं च कन्यायास्तयोरेव च याजनम्॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000395070, "chapter_id": 20395, "verse_number": "२-६७-७१", "content_sanskrit": "पुत्रमित्रकलत्राणामभावे स्वामिनस्तथा ।\nभार्याणां च परित्यागः साधूनां च तपस्विनाम्॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000395071, "chapter_id": 20395, "verse_number": "२-६७-७२", "content_sanskrit": "गवां क्षत्रियवैश्यानां स्त्रीशूद्राणां च घातनम् ।\nशिवायतनवृक्षाणां पुण्याराम विनाशनम्॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000395072, "chapter_id": 20395, "verse_number": "२-६७-७३", "content_sanskrit": "यः पीडामाश्रमस्थानामाचरेदल्पिकामपि ।\nतद्भृत्यपरिवर्गस्य पशुधान्यवनस्य च॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000395073, "chapter_id": 20395, "verse_number": "२-६७-७४", "content_sanskrit": "कर्ष धान्य पशुस्तेयमयाज्यानां च याजनम् ।\nयज्ञारामतडागानां दारापत्यस्य विक्रयः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000395074, "chapter_id": 20395, "verse_number": "२-६७-७५", "content_sanskrit": "तीर्थयात्रोपवासानां व्रतानां च सुकर्मणाम् ।\nस्त्रीधनान्युपजीवंति स्त्रीभगात्यंतजीविता॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000395075, "chapter_id": 20395, "verse_number": "२-६७-७६", "content_sanskrit": "स्वधर्मं विक्रयेद्यस्तु अधर्मं वर्णते नरः ।\nपरदोषप्रवादी च परच्छिद्रावलोककः॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000395076, "chapter_id": 20395, "verse_number": "२-६७-७७", "content_sanskrit": "परद्रव्याभिलाषी च परदारावलोककः ।\nएते गोघ्नसमानाश्च ज्ञातव्या नृपनंदन॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000395077, "chapter_id": 20395, "verse_number": "२-६७-७८", "content_sanskrit": "यः कर्ता सर्वशास्त्राणां गोहर्ता गोश्च विक्रयी ।\nनिर्दयोऽतीव भृत्येषु पशूनां दमकश्च यः॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000395078, "chapter_id": 20395, "verse_number": "२-६७-७९", "content_sanskrit": "मिथ्या प्रवदते वाचमाकर्णयति यः परैः ।\nस्वामिद्रोही गुरुद्रोही मायावी चपलः शठः॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000395079, "chapter_id": 20395, "verse_number": "२-६७-८०", "content_sanskrit": "यो भार्यापुत्रमित्राणि बालवृद्धकृशातुरान् ।\nभृत्यानतिथिबंधूंश्च त्यक्त्वाश्नाति बुभुक्षितान्॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000395080, "chapter_id": 20395, "verse_number": "२-६७-८१", "content_sanskrit": "ये तु मृष्टं समश्नंति नो वांच्छंतं ददंति च ।\nपृथक्पाकी स विज्ञेयो ब्रह्मवादिषु गर्हितः॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000395081, "chapter_id": 20395, "verse_number": "२-६७-८२", "content_sanskrit": "नियमान्स्वयमादाय ये त्यजंत्यजितेंद्रियाः ।\nप्रव्रज्यागमिता यैश्च संयुक्ता ये च मद्यपैः॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000395082, "chapter_id": 20395, "verse_number": "२-६७-८३", "content_sanskrit": "ये चापि क्षयरोगार्तां गां पिपासा क्षुधातुराम् ।\nन पालयंति यत्नेन ते गोघ्ना नारकाः स्मृताः॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000395083, "chapter_id": 20395, "verse_number": "२-६७-८४", "content_sanskrit": "सर्वपापरता ये च चतुष्पात्क्षेत्रभेदकाः ।\nसाधून्विप्रान्गुरूंश्चैव यश्च गां हि प्रताडयेत्॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000395084, "chapter_id": 20395, "verse_number": "२-६७-८५", "content_sanskrit": "ये ताडयंत्यदोषां च नारीं साधुपदेस्थिताम् ।\nआलस्यबद्धसर्वांगो यः स्वपिति मुहुर्मुहुः॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000395085, "chapter_id": 20395, "verse_number": "२-६७-८६", "content_sanskrit": "दुर्बलांश्च न पुष्णंति नष्टान्नान्वेषयंति च ।\nपीडयंत्यतिभारेण सक्षतान्वाहयंति च॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000395086, "chapter_id": 20395, "verse_number": "२-६७-८७", "content_sanskrit": "सर्वपापरता ये च संयुक्ता ये च भुंजते ।\nभग्नांगीं क्षतरोगार्तां गोरूपां च क्षुधातुराम्॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000395087, "chapter_id": 20395, "verse_number": "२-६७-८८", "content_sanskrit": "न पालयंति यत्नेन ते जना नारकाः स्मृताः ।\nवृषाणां वृषणौ ये च पापिष्ठा घातयंति च॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000395088, "chapter_id": 20395, "verse_number": "२-६७-८९", "content_sanskrit": "बाधयंति च गोवत्सान्महानारकिणो नराः ।\nआशया समनुप्राप्तं क्षुत्तृषाश्रमपीडितम्॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000395089, "chapter_id": 20395, "verse_number": "२-६७-९०", "content_sanskrit": "ये चातिथिं न मन्यंते ते वै निरयगामिनः ।\nअनाथं विकलं दीनं बालं वृद्धं भृशातुरम्॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000395090, "chapter_id": 20395, "verse_number": "२-६७-९१", "content_sanskrit": "नानुकंपंति ये मूढास्ते यांति नरकार्णवम् ।\nअजाविको माहिषिको यः शूद्रा वृषलीपतिः॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000395091, "chapter_id": 20395, "verse_number": "२-६७-९२", "content_sanskrit": "शूद्रो विप्रस्य क्षत्रस्य य आचारेण वर्तते ।\nशिल्पिनः कारवो वैद्यास्तथा देवलका नराः॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000395092, "chapter_id": 20395, "verse_number": "२-६७-९३", "content_sanskrit": "भृतकामात्यकर्माणः सर्वे निरयगामिनः ।\nयश्चोदितमतिक्रम्य स्वेच्छया आहरेत्करम्॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000395093, "chapter_id": 20395, "verse_number": "२-६७-९४", "content_sanskrit": "नरकेषु स पच्येत यश्च दंडं वृथा नयेत् ।\nउत्कोचकैरधिकृतैस्तस्करैश्च प्रपीड्यते॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000395094, "chapter_id": 20395, "verse_number": "२-६७-९५", "content_sanskrit": "यस्य राज्ञः प्रजा राज्ये पच्यते नरकेषु सः ।\nये द्विजाः प्रतिगृह्णंति नृपस्य पापवर्तिनः॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000395095, "chapter_id": 20395, "verse_number": "२-६७-९६", "content_sanskrit": "प्रयांति तेपि घोरेषु नरकेषु न संशयः ।\nपारदारिकचौराणां यत्पापं पार्थिवस्य च॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000395096, "chapter_id": 20395, "verse_number": "२-६७-९७", "content_sanskrit": "भवत्यरक्षतो घोरो राज्ञस्तस्य परिग्रहः ।\nअचौरं चौरवद्यश्च चौरं चाचौरवत्पुनः॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000395097, "chapter_id": 20395, "verse_number": "२-६७-९८", "content_sanskrit": "अविचार्य नृपः कुर्यात्सोऽपि वै नरकं व्रजेत् ।\nघृततैलान्नपानादि मधुमांस सुरासवम्॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000395098, "chapter_id": 20395, "verse_number": "२-६७-९९", "content_sanskrit": "गुडेक्षुक्षीरशाकादि दधिमूलफलानि च ।\nतृणकाष्ठं पुष्पपत्रं कांस्यभाजनमेव च॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000395099, "chapter_id": 20395, "verse_number": "२-६७-१००", "content_sanskrit": "उपानच्छत्रकटक शिबिकामासनं मृदु ।\nताम्रं सीसं त्रपुकांस्यं शंखाद्यं च जलोद्भवम्॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000395100, "chapter_id": 20395, "verse_number": "२-६७-१०१", "content_sanskrit": "वादित्रं वेणुवंशाद्यं गृहोपस्करणानि च ।\nऊर्णाकार्पासकौशेय रंगपद्मोद्भवानि च॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000395101, "chapter_id": 20395, "verse_number": "२-६७-१०२", "content_sanskrit": "तूलं सूक्ष्माणिवस्त्राणि ये लोभेन हरंति च ।\nएवमादीनि चान्यानि द्रव्याणि विविधानि च॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000395102, "chapter_id": 20395, "verse_number": "२-६७-१०३", "content_sanskrit": "नरकेषु द्रुतं गच्छेदपहृत्याल्पकान्यपि ।\nयद्वा तद्वा परद्रव्यमपि सर्षपमात्रकम्॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000395103, "chapter_id": 20395, "verse_number": "२-६७-१०४", "content_sanskrit": "अपहृत्य नरो याति नरके नात्र संशयः ।\nबह्वल्पकाद्यपि तथा परस्य ममताकृतम्॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000395104, "chapter_id": 20395, "verse_number": "२-६७-१०५", "content_sanskrit": "अपहृत्य नरो याति नरके नात्र संशयः ।\nएवमाद्यैर्नरः पापैरुत्क्रांतिसमनंतरम्॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000395105, "chapter_id": 20395, "verse_number": "२-६७-१०६", "content_sanskrit": "शरीरघातनार्थाय पूर्वाकारमवाप्नुयात् ।\nयमलोकं व्रजंत्येते शरीरस्था यमाज्ञया॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000395106, "chapter_id": 20395, "verse_number": "२-६७-१०७", "content_sanskrit": "यमदूतैर्महाघोरैर्नीयमानाः सुदुःखिताः ।\nदेवतिर्यङ्मनुष्याणामधर्मनियतात्मनाम्॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000395107, "chapter_id": 20395, "verse_number": "२-६७-१०८", "content_sanskrit": "धर्मराजः स्मृतः शास्ता सुघोरैर्विविधैर्वधैः ।\nविनयाचारयुक्तानां प्रमादान्मलिनात्मनाम्॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000395108, "chapter_id": 20395, "verse_number": "२-६७-१०९", "content_sanskrit": "प्रायश्चित्तैर्गुरुः शास्ता न च तैरीक्ष्यते यमः ।\nपारदारिकचौराणामन्यायव्यवहारिणाम्॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000395109, "chapter_id": 20395, "verse_number": "२-६७-११०", "content_sanskrit": "नृपतिः शासकः प्रोक्तः प्रच्छन्नानां च धर्मराट् ।\nतस्मात्कृतस्य पापस्य प्रायश्चित्तं समाचरेत्॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000395110, "chapter_id": 20395, "verse_number": "२-६७-१११", "content_sanskrit": "नाभुक्तस्यान्यथा नाशः कल्पकोटिशतैरपि ।\nयः करोति स्वयं कर्म कारयेद्वानुमोदयेत्॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000395111, "chapter_id": 20395, "verse_number": "२-६७-११२", "content_sanskrit": "कायेन मनसा वाचा तस्य चाधोगतिः फलम् ।\nइति संक्षेपतः प्रोक्ताः पापभेदास्त्रिधाधुना॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000395112, "chapter_id": 20395, "verse_number": "२-६७-११३", "content_sanskrit": "कथ्यंते गतयश्चित्रा नराणां पापकर्मणाम् ।\nएतत्ते नृपते धर्म फलं प्रोक्तं सुविस्तरात्॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000395113, "chapter_id": 20395, "verse_number": "२-६७-११४", "content_sanskrit": "अन्यत्किंते प्रवक्ष्यामि तन्मे ब्रूहि नरोत्तम ।\nअधर्मस्य फलं प्रोक्तं धर्मस्यापि वदाम्यहम्॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000395114, "chapter_id": 20395, "verse_number": "२-६७-११५", "content_sanskrit": "इत्युक्त्वा मातलिस्तत्र राजानं सर्ववत्सलम् ।\nतस्मिन्धर्मप्रसंगेन इत्याख्यातं महात्मना॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}]