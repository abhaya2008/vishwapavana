[{"id": 2076130, "chapter_id": 2614, "verse_number": "१२-११९-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2076131, "chapter_id": 2614, "verse_number": "१२-११९-१", "content_sanskrit": "एवं गुणयुतान्भृत्यान्स्वेस्वे स्थाने नराधिपः।\nनियोजयति कृत्येषु स राज्यफलमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2076132, "chapter_id": 2614, "verse_number": "१२-११९-२", "content_sanskrit": "न वा स्वस्थानमुत्क्रम्य प्रमाणमपि सत्कृतम्।\nआरोप्य चापि स्वस्थानमुत्क्रम्यान्यत्प्रपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2076133, "chapter_id": 2614, "verse_number": "१२-११९-३", "content_sanskrit": "स्वजातिगुणसंपन्नाः स्वेषु धर्मेष्ववस्थिताः।\nप्रकर्तव्या ह्यमात्यास्तु नास्थाने प्रक्रिया क्षमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2076134, "chapter_id": 2614, "verse_number": "१२-११९-४", "content_sanskrit": "अनुरूपाणि कर्माणि भृत्येभ्यो यः प्रयच्छति।\nस भृत्यगुणसंपन्नं राजा फलमुपाश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2076135, "chapter_id": 2614, "verse_number": "१२-११९-५", "content_sanskrit": "शरभः शरभस्थाने सिंहः सिंह इवोत्थितः।\nव्याघ्रो व्याघ्र इव स्थाप्यो द्वीपी द्वीपी यथा तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2076136, "chapter_id": 2614, "verse_number": "१२-११९-६", "content_sanskrit": "कर्मस्विहानुरूपेषु न्यस्या भृत्या यथाविधि।\nप्रतिलोमं न भृत्यास्ते स्थाप्याः कर्मफलैषिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2076137, "chapter_id": 2614, "verse_number": "१२-११९-७", "content_sanskrit": "यः प्रमाणमतिक्रम्य प्रतिलोमं नराधिपः।\nभृत्यान्स्थापयतेऽबुद्धिर्न स रञ्जयते प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2076138, "chapter_id": 2614, "verse_number": "१२-११९-८", "content_sanskrit": "न बालिशा न च क्षुद्रा नाप्राज्ञा नाजितेन्द्रियाः।\nनाकुलीना जनाः पार्श्वे स्थाप्या राज्ञा गुणैषिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2076139, "chapter_id": 2614, "verse_number": "१२-११९-९", "content_sanskrit": "साधवः कुलजाः शूरा ज्ञानवन्तोऽनसूयकाः।\nअक्षुद्राः शुचयो दक्षाः स्युर्नराः पारिपार्श्वकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2076140, "chapter_id": 2614, "verse_number": "१२-११९-१०", "content_sanskrit": "उद्भूतास्तत्पराः शान्ताश्चौक्षाः प्रकृतिजाः शुभाः।\nस्वेस्वे स्थानेऽनुपाकृष्टास्ते स्यू राज्ञो बहिश्चराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2076141, "chapter_id": 2614, "verse_number": "१२-११९-११", "content_sanskrit": "सिंहस्य सततं पार्श्वे सिंह एव जनो भवेत्।\nअसिंहः सिंहसहितः सिंहवल्लभते फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2076142, "chapter_id": 2614, "verse_number": "१२-११९-१२", "content_sanskrit": "यस्तु सिंहः श्वभिः कीर्णः सिंहकर्मफले रतः।\nन स सिंहफलं भोक्तुं शक्तः श्वभिरुपासितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2076143, "chapter_id": 2614, "verse_number": "१२-११९-१३", "content_sanskrit": "एव मेतैर्मनुष्येन्द्र शूरैः प्राज्ञैर्बहुश्रुतैः।\nकुलीनैः सह शक्येत कृत्स्ना जेतुं वसुंधरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2076144, "chapter_id": 2614, "verse_number": "१२-११९-१४", "content_sanskrit": "नावैद्यो नानृजुः पार्श्वे नाप्राज्ञो ना महायशाः।\nसंग्राह्यो वसुधापालैर्भृत्यो भृत्यवतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2076145, "chapter_id": 2614, "verse_number": "१२-११९-१५", "content_sanskrit": "वाणवद्विसृता यान्ति स्वामिकार्यपरा नराः।\nये भृत्याः पार्थिवहितास्तेषु सान्त्वं सदा चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2076146, "chapter_id": 2614, "verse_number": "१२-११९-१६", "content_sanskrit": "कोशश्च सततं रक्ष्यो यत्नमास्थाय राजभिः।\nकोशमूला हि राजानः कोशवृद्धिकरो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2076147, "chapter_id": 2614, "verse_number": "१२-११९-१७", "content_sanskrit": "कोष्ठागारं च ते नित्यं स्फीतं धान्यैः सुसंचितैः।\nसदा त्वं सत्सु संन्यस्तधनधान्यपको भव।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2076148, "chapter_id": 2614, "verse_number": "१२-११९-१८", "content_sanskrit": "नित्ययुक्ताश्च ते भृत्या भवन्तु रणकोविदाः।\nवाजिनां च प्रयोगेषु वैशारद्यमिहेष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2076149, "chapter_id": 2614, "verse_number": "१२-११९-१९", "content_sanskrit": "ज्ञातिबन्धुजनावेक्षी मित्रसंबन्धिसत्कृतः।\nपौरकार्यहितान्वेक्षई भव कौरवनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2076150, "chapter_id": 2614, "verse_number": "१२-११९-२०", "content_sanskrit": "एषा ते नैष्ठिकी बुद्धिः प्रज्ञा चाभिहिता मषा।\nश्वाते निदर्शनं तात किं भूयः श्रोतुमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2076151, "chapter_id": 2614, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि एकोनविंशत्यधिकशततमोऽध्यायः॥ ११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]