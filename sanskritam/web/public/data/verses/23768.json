[{"id": 7003768000, "chapter_id": 23768, "verse_number": "२-२-१२-१", "content_sanskrit": "जैमिनिरुवाच ।\nउक्ते ब्रह्मसुतेनेत्थमिंद्रद्युम्नो महीपतिः ।\nमुनेस्तुवचनं श्रुत्वा प्रहृष्टेनांतरात्मना ।\nविचार्य परया बुद्ध्या श्रमं मेने फलावहम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003768001, "chapter_id": 23768, "verse_number": "२-२-१२-२", "content_sanskrit": "अहो मे परमं भाग्यं बहुजन्मांतरार्जितम् ।\nव्यवसाये ममोद्युक्तः सर्वलोकपितामहः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003768002, "chapter_id": 23768, "verse_number": "२-२-१२-३", "content_sanskrit": "जीवन्मुक्तं स्वतनुजं मत्सहायमकारयत् ।\nसहायो यादृशः पुंसां भवेत्कार्यं हि तादृशम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003768003, "chapter_id": 23768, "verse_number": "२-२-१२-४", "content_sanskrit": "श्रुतं सभासु सर्वासु इति वृद्धानुशासनम् ।\nस इत्थं चिंतयन्राजा विसृज्य च सभासदः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003768004, "chapter_id": 23768, "verse_number": "२-२-१२-५", "content_sanskrit": "ततो मुनिं करे धृत्वा विवेशांतःपुरे द्विजाः ।\nतमर्चयित्वा विधिवत्पल्यंके सह तेन वै ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003768005, "chapter_id": 23768, "verse_number": "२-२-१२-६", "content_sanskrit": "निशावशेषं नृपतिर्निनाय संलपन्मिथः ।\nततः प्रभाते विमले नित्यं कर्म समाप्य वै ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003768006, "chapter_id": 23768, "verse_number": "२-२-१२-७", "content_sanskrit": "पूजयित्वा जगन्नाथं संततार महानदीम् ।\nओढ्रदेशाधिपेनाग्रे गच्छतादिष्टपद्धतिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003768007, "chapter_id": 23768, "verse_number": "२-२-१२-८", "content_sanskrit": "एकाम्र वनकं क्षेत्रमभियातो बलान्वितः ।\nस गत्वा किंचिदध्वानं प्राप्य गंधवहाभिधाम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003768008, "chapter_id": 23768, "verse_number": "२-२-१२-९", "content_sanskrit": "नदीं वेगवतीं शीततोयामाक्रम्य वेगवान् ।\nपूर्वाह्नपूजासमये कोटिलिंगेश्वरस्य वै ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003768009, "chapter_id": 23768, "verse_number": "२-२-१२-१०", "content_sanskrit": "चर्चरीशंखकाहालमृदंगमुरजध्वनिम् ।\nव्यश्नुवानं महारण्यं दूराच्छुश्राव भूपतिः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003768010, "chapter_id": 23768, "verse_number": "२-२-१२-११", "content_sanskrit": "मन्यमानो भगवतो नीलाचल निवासिनः ।\nउवाच नारदं प्रीतो ध्वनिः कुत्र महामुने ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003768011, "chapter_id": 23768, "verse_number": "२-२-१२-१२", "content_sanskrit": "नीलाद्रिशिखरावासः प्राप्तः किं परमेश्वरः ।\nयदर्चासमये ह्येष श्रूयते संकुलध्वनिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003768012, "chapter_id": 23768, "verse_number": "२-२-१२-१३", "content_sanskrit": "उताहोप्यन्यदेवो वा निकटे वर्त्तते मुने ।\nइति पृष्टस्तदा राज्ञा प्रोवाच मुनिपुंगवः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003768013, "chapter_id": 23768, "verse_number": "२-२-१२-१४", "content_sanskrit": "राजन्सुदुर्लभं क्षेत्रं गोपितं मुरवैरिणा ।\nन तत्रास्तीति भगवान्कैरपि ज्ञायते नृभिः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003768014, "chapter_id": 23768, "verse_number": "२-२-१२-१५", "content_sanskrit": "त्वं हि भाग्यवतां श्रेष्ठस्त्वद्भाग्यात्ते पुरोधसा ।\nदृष्टः कथंचिद्भगवान्संयतेंद्रियवर्त्मना ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003768015, "chapter_id": 23768, "verse_number": "२-२-१२-१६", "content_sanskrit": "त्वं हि तावद्बलैर्युक्तः षडंगैनृपसत्तम ।\nसाहसेऽतिप्रवृत्तोऽसि संशयो मे महीपते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003768016, "chapter_id": 23768, "verse_number": "२-२-१२-१७", "content_sanskrit": "संवर्त्तते नीलगिरिर्योजने तु तृतीयके ।\nइदं त्वेकाम्रकवनं क्षेत्रं गौरीपतेर्विभोः ।\nनातिदूरे महीपाल भीतः स शरणागतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003768017, "chapter_id": 23768, "verse_number": "२-२-१२-१८", "content_sanskrit": "इंद्रद्युम्न उवाच ।\nकथं स भीतो गौरीशः कं वा शरणमागतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003768018, "chapter_id": 23768, "verse_number": "२-२-१२-१९", "content_sanskrit": "ददाह त्रिपुरं घोरं शरेणैकेन यः पुरा ।\nअत्र मे विस्मयो जातः श्रोतुमिच्छामि दुर्लभम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003768019, "chapter_id": 23768, "verse_number": "२-२-१२-२०", "content_sanskrit": "रक्षिता भवभीतानां भवः परमपावनः ।\nकिमर्थं भयभीतोऽसौ कः समर्थोऽस्य वै जये ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003768020, "chapter_id": 23768, "verse_number": "२-२-१२-२१", "content_sanskrit": "नारद उवाच ।\nअत्र ते कथयिष्यामि पुरावृत्तं महीपते ।\nउपयेमे पुरा गौरीं तपसा वशमागतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003768021, "chapter_id": 23768, "verse_number": "२-२-१२-२२", "content_sanskrit": "ब्रह्मचारी हिमगिरौ भगवान्नीललोहितः ।\nउत्सृज्य ब्रह्मचर्यं तु सोऽनंगशरपीडितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003768022, "chapter_id": 23768, "verse_number": "२-२-१२-२३", "content_sanskrit": "तया रेमे रुचिरया यौवनोन्मत्तया नृप ।\nतत्पितुर्विषये भोगान्बुभुजे देवकांक्षितान् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003768023, "chapter_id": 23768, "verse_number": "२-२-१२-२४", "content_sanskrit": "कदाचिदथ निर्याती स्ववासभवनात्सती ।\nसामपूर्वं कुलस्त्रीभिर्मात्रोक्ता सस्मितं वचः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003768024, "chapter_id": 23768, "verse_number": "२-२-१२-२५", "content_sanskrit": "आर्ये महत्तपस्तप्तं वरार्थं गहने वने ।\nनिष्कुलो निर्गुणो वृद्धो वरः प्राप्तो वरानने ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003768025, "chapter_id": 23768, "verse_number": "२-२-१२-२६", "content_sanskrit": "दिवारात्रिं न त्यजसि सन्निधिं तादृशस्य वै ।\nको गुणः कथ्यतां वत्से किं वा पत्युः प्रसादजम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003768026, "chapter_id": 23768, "verse_number": "२-२-१२-२७", "content_sanskrit": "भूषणाच्छादनं प्राप्तं ममैव गृहवासिनी ।\nचिरं तिष्ठसि भद्रे त्वं पितृभोगोपलालिता ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003768027, "chapter_id": 23768, "verse_number": "२-२-१२-२८", "content_sanskrit": "त्रैलोक्ये यास्तु कन्या वै परिणीताः पितुर्गृहात् ।\nप्रयात्यलंकृताभर्त्रा भर्तृवेश्मनि शुश्रुम ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003768028, "chapter_id": 23768, "verse_number": "२-२-१२-२९", "content_sanskrit": "अहं तु मानसी कन्या पितृणां पितृलोकतः ।\nआगता तु महाभागे परिणीता हिमाद्रिणा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003768029, "chapter_id": 23768, "verse_number": "२-२-१२-३०", "content_sanskrit": "इत्थमुक्ता मया हास्यान्न क्रोधाच्चललोचने ।\nजामातुरग्रे नो वाच्यं स हि विष्णुसमो मतः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003768030, "chapter_id": 23768, "verse_number": "२-२-१२-३१", "content_sanskrit": "नारद उवाच ।\nमातुरित्थं वचः श्रुत्वा भर्तृनिंदाप्रपीडिता ।\nकोपप्रस्फुरदोष्ठी सा वाचं नोचे मनागपि ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003768031, "chapter_id": 23768, "verse_number": "२-२-१२-३२", "content_sanskrit": "प्रययावंतिकं भर्तुर्निह्नु वानांऽबिकावचः ।\nजगाद परुषं वाक्यं स्नेहगर्भं मिताक्षरम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003768032, "chapter_id": 23768, "verse_number": "२-२-१२-३३", "content_sanskrit": "स्वामिन्न सांप्रतं चैतद्यद्वासः श्वशुरालये ।\nक्षौद्रीयसामपि गुरोस्त्रैलोक्यस्य कथं नु ते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003768033, "chapter_id": 23768, "verse_number": "२-२-१२-३४", "content_sanskrit": "तदावयोर्नात्र योग्या वसतिर्मे प्रिया विभो ।\nन संति किं ते वासाय योग्या वै भूमयः प्रभोः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003768034, "chapter_id": 23768, "verse_number": "२-२-१२-३५", "content_sanskrit": "इत्युक्तः शिवया सोऽथ भगवान्वृषभध्वजः ।\nतया सार्द्धं वृषारूढो मध्यदेशं ययौ त्वरन् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003768035, "chapter_id": 23768, "verse_number": "२-२-१२-३६", "content_sanskrit": "विलंघ्य सर्व तीर्थानि प्रयागं पावनं महत् ।\nपूर्वसागरगामिन्या गंगाया उत्तरे तटे ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003768036, "chapter_id": 23768, "verse_number": "२-२-१२-३७", "content_sanskrit": "वाराणसीं नाम पुरीं गौर्या वासाय निर्ममे ।\nपंचक्रोशमितां रम्यां वरप्रासादशोभिताम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003768037, "chapter_id": 23768, "verse_number": "२-२-१२-३८", "content_sanskrit": "अट्टालकशतैर्युक्तामसंख्योपवनैर्युताम् ।\nनानातीर्थसमायुक्तां नानाजनसमाकुलाम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003768038, "chapter_id": 23768, "verse_number": "२-२-१२-३९", "content_sanskrit": "आज्ञया धूर्जटेः शुभ्रां निर्मितां विश्वकर्मणा ।\nपावनैः शीतलैर्गंगातरंगैः क्षपितांहसाम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003768039, "chapter_id": 23768, "verse_number": "२-२-१२-४०", "content_sanskrit": "तत्र मध्ये पुरे स्वर्णप्राकाराट्टालशोभिते ।\nरत्नस्तंभैः सुघटिते सर्वाशापरिपूरके ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003768040, "chapter_id": 23768, "verse_number": "२-२-१२-४१", "content_sanskrit": "तया रेमे पशुपतिः श्रियेव मधुसूदनः ।\nसा पुरी विश्वनाथेन कदाचिन्नैव मुच्यते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003768041, "chapter_id": 23768, "verse_number": "२-२-१२-४२", "content_sanskrit": "अविमुक्तेति सा ख्याता नृणां मुक्तिप्रदायिनी ।\nपुरासीन्मनुजाधीश सेविता भवभीरुभिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003768042, "chapter_id": 23768, "verse_number": "२-२-१२-४३", "content_sanskrit": "तत्रोषिता तदा गौरी तेन भर्त्रा स्वलंकृता ।\nमातरं पितरं चापि न सस्मार महीपते ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003768043, "chapter_id": 23768, "verse_number": "२-२-१२-४४", "content_sanskrit": "एवं बहुयुगेऽतीते कैलासाद्रिं स जग्मिवान् ।\nआत्मनः कोटिलिंगानि तत्र संस्थाप्य वै प्रभुः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003768044, "chapter_id": 23768, "verse_number": "२-२-१२-४५", "content_sanskrit": "राजानः पालयामासुस्तां पुरीं बहुशो नृप ।\nतत्रासीत्काशिराजाख्यः पुरा द्वापरके युगे ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003768045, "chapter_id": 23768, "verse_number": "२-२-१२-४६", "content_sanskrit": "शंभुं संतोषयामास तपसोग्रेण वै प्रभुम् ।\nजरासन्धपुरोगाणां राज्ञां जेतारमच्युतम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003768046, "chapter_id": 23768, "verse_number": "२-२-१२-४७", "content_sanskrit": "संग्रामे प्रभविष्यामीत्यभिसंधाय पार्थिवः ।\nप्रादात्तस्मै वरं सोऽपि पिनाकी पारितोषितः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003768047, "chapter_id": 23768, "verse_number": "२-२-१२-४८", "content_sanskrit": "जेतासि कंसहंतारं संग्रामे त्वमरिंदम ।\nतवार्थे प्रमथैः सार्द्धमहं योत्स्ये वृषे स्थितः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003768048, "chapter_id": 23768, "verse_number": "२-२-१२-४९", "content_sanskrit": "शंभोरिति वरं लब्ध्वा प्रमत्तः स नराधिपः ।\nशंखचक्रधरं संख्ये हरिमाह्वत वीर्यवान् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003768049, "chapter_id": 23768, "verse_number": "२-२-१२-५०", "content_sanskrit": "अन्तर्यामी स भगवाञ्ज्ञात्वा वृत्तांतमीदृशम् ।\nचक्रं प्रस्थापयामास काशिराजस्य सूदने ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003768050, "chapter_id": 23768, "verse_number": "२-२-१२-५१", "content_sanskrit": "तदुग्रदर्शनं चक्रं सहस्रादित्यवर्चसम् ।\nकाशिराजशिरश्छित्त्वा तद्बलं तां पुरीं ततः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003768051, "chapter_id": 23768, "verse_number": "२-२-१२-५२", "content_sanskrit": "ददाह कुपितं राजन्विष्णोराशयवीर्यवित् ।\nतद्दृष्ट्वा सुमहत्कर्म क्रुद्धः पशुपतिस्तदा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003768052, "chapter_id": 23768, "verse_number": "२-२-१२-५३", "content_sanskrit": "गणैर्वृतो वृषारूढः पिनाकी तदुपाद्रवत् ।\nततः सुदर्शनं चक्रं दृष्ट्वा तं प्रथमं पुरः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003768053, "chapter_id": 23768, "verse_number": "२-२-१२-५४", "content_sanskrit": "शंभुः पाशुपतास्त्रं तच्चकारोत्पातसन्निभम् ।\nपुरा विष्णोर्वरं प्राप्तं शंभुना भक्तितोषितात् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003768054, "chapter_id": 23768, "verse_number": "२-२-१२-५५", "content_sanskrit": "बलेनाप्याययिष्यामि तवास्त्रं संस्मृतस्त्वया ।\nमयि चेत्प्रतिकूलस्त्वं भविष्यति च निष्प्रभम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003768055, "chapter_id": 23768, "verse_number": "२-२-१२-५६", "content_sanskrit": "घोरे पाशुपते चास्मिन्नस्त्रे च विफलीकृते ।\nवाराणस्यां च दग्धायां भयत्रस्तो वृषध्वजः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003768056, "chapter_id": 23768, "verse_number": "२-२-१२-५७", "content_sanskrit": "तुष्टाव जगतामदिमनादिं पुरुषोत्तमम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003768057, "chapter_id": 23768, "verse_number": "२-२-१२-५८", "content_sanskrit": "महादेव उवाच ।\nनारायण परंधाम परमात्मन्परात्पर ।\nसच्चिदानन्दविभव निरञ्जन नमोऽस्तु ते ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003768058, "chapter_id": 23768, "verse_number": "२-२-१२-५९", "content_sanskrit": "जगत्कारणसृष्ट्यादि कर्मकृद्गुणभेदतः ।\nमायया निजया गुप्त स्वप्रकाश नमोऽस्तु ते ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003768059, "chapter_id": 23768, "verse_number": "२-२-१२-६०", "content_sanskrit": "नांतर्बहिर्बहिश्चांतर्दूरस्थो निकटाश्रयः ।\nगुरुर्लघुः स्थिरोऽणीयान्स्थवीयांश्च नमोऽस्तु ते ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003768060, "chapter_id": 23768, "verse_number": "२-२-१२-६१", "content_sanskrit": "कोटयश्चतुरास्यस्य पलार्द्धं मम चातुल ।\nयदपांगविलासोत्थं तस्मै कालात्मने नमः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003768061, "chapter_id": 23768, "verse_number": "२-२-१२-६२", "content_sanskrit": "एकैकरोमाकलितब्रह्माण्डगणसंवृतम् ।\nमानातीतं वपुर्यस्य तस्मै विश्वात्मने नमः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003768062, "chapter_id": 23768, "verse_number": "२-२-१२-६३", "content_sanskrit": "स्वकालपरिमाणेन वेधसः प्रलयोद्भवौ ।\nमन्वंतरादिघटनाकलनाय नमोऽस्तु ते ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003768063, "chapter_id": 23768, "verse_number": "२-२-१२-६४", "content_sanskrit": "सृष्टोऽहं तमसा नाथ त्वत्प्रभावानभिज्ञकः ।\nतत्क्षमस्वापराधं मे त्राहि मां शरणागतम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003768064, "chapter_id": 23768, "verse_number": "२-२-१२-६५", "content_sanskrit": "स्तुतिमित्थं प्रकुर्वाणे तस्मिंस्त्रिपुरदाहिनि ।\nचक्ररूपं परित्यज्य आविरासीदधोक्षजः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003768065, "chapter_id": 23768, "verse_number": "२-२-१२-६६", "content_sanskrit": "प्रसन्नवदनः श्रीमाञ्छंखचक्रगदाधरः ।\nतार्क्ष्यपद्मासनगतो वनमालाविभूषणः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003768066, "chapter_id": 23768, "verse_number": "२-२-१२-६७", "content_sanskrit": "हारकुण्डलकेयूरमुकुटादिभिरुज्ज्वलः ।\nवामोत्संगगतां लक्ष्मीं सत्यां दक्षिणपार्श्वगाम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003768067, "chapter_id": 23768, "verse_number": "२-२-१२-६८", "content_sanskrit": "बिभ्राणः कृष्णजीमूतकांतदेहं कृपाम्बुधिः ।\nक्रोधाविष्ट इवोवाच बिभ्यतं गिरिजापतिम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003768068, "chapter_id": 23768, "verse_number": "२-२-१२-६९", "content_sanskrit": "श्रीभगवानुवाच ।\nकालेनैतावता शंभो दुर्बुद्धिः कथमागता ।\nहेतोर्नृपतिकीटस्य मया योद्धुमुपस्थितः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003768069, "chapter_id": 23768, "verse_number": "२-२-१२-७०", "content_sanskrit": "कति वा मत्प्रभावास्ते नो ज्ञाता धूर्जटे त्वया ।\nसत्यं पाशुपतं तेऽस्त्रं दुर्जयं ससुरासुरैः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003768070, "chapter_id": 23768, "verse_number": "२-२-१२-७१", "content_sanskrit": "मत्क्रोधरूपं तच्चक्रं त्वामपि क्षमते न यत् ।\nमामवज्ञाय जगति भ्रमति त्वामृते हि कः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003768071, "chapter_id": 23768, "verse_number": "२-२-१२-७२", "content_sanskrit": "तपोभिर्बहुभिः पूर्वं मच्छरीरतयोर्जितः ।\nसांप्रतं चेच्चिरं रंतुं गौर्या सार्द्धमिहेच्छसि ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003768072, "chapter_id": 23768, "verse_number": "२-२-१२-७३", "content_sanskrit": "पुरीं वाराणसीं चेमां यदीच्छसि चिरस्थिताम् ।\nमन्नाम्ना भुवि विख्यातं क्षेत्रं श्रीपुरुषोत्तमम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003768073, "chapter_id": 23768, "verse_number": "२-२-१२-७४", "content_sanskrit": "दक्षिणस्योदधेस्तीरे नीलाचलविभूषितम् ।\nदशयोजनविस्तीर्णं यावद्विरजमण्डलम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003768074, "chapter_id": 23768, "verse_number": "२-२-१२-७५", "content_sanskrit": "क्रमशः पावनं क्षेत्रं यावच्चित्रोत्पला नदी ।\nततः प्रभृति यो देशो यावत्स्याद्दक्षिणार्णवः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003768075, "chapter_id": 23768, "verse_number": "२-२-१२-७६", "content_sanskrit": "पदात्पदाच्छ्रेष्ठतमो नीलाद्रिरपवर्गदः ।\nचतुर्देहस्थितोऽहं वै यत्र नीलमणीमयः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003768076, "chapter_id": 23768, "verse_number": "२-२-१२-७७", "content_sanskrit": "तस्योत्तरस्यां विख्यातं वनमेकाम्रकाह्वयम् ।\nपार्वत्या तत्र निवस निर्भयस्त्रिपुरांतक ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003768077, "chapter_id": 23768, "verse_number": "२-२-१२-७८", "content_sanskrit": "सृजता सर्वलोकानां मन्निदेशात्स्वयंभुवा ।\nतत्रापि कोटिलिंगानां राजा त्वमभिषेक्ष्यसे ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003768078, "chapter_id": 23768, "verse_number": "२-२-१२-७९", "content_sanskrit": "सर्वतीर्थमयं चेदं तीर्थं यन्मणिकर्णिकम् ।\nइहाहंकारमुत्सृज्य व्रज त्वं सपरिच्छदः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003768079, "chapter_id": 23768, "verse_number": "२-२-१२-८०", "content_sanskrit": "नारद उवाच ।\nइत्युक्तो वासुदेवेन त्र्यंबको नतकन्धरः ।\nकृतांजलिपुटो भूत्वा प्रोवाच मधुसूदनम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003768080, "chapter_id": 23768, "verse_number": "२-२-१२-८१", "content_sanskrit": "महादेव उवाच ।\nदेवदेव जगन्नाथ प्रणतार्तिहर प्रभो ।\nत्वदाज्ञापालनं श्रेयः कारणं मे जगत्पते ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003768081, "chapter_id": 23768, "verse_number": "२-२-१२-८२", "content_sanskrit": "यत्तु मूढतया देव अवलेपः कृतो मया ।\nतवैवानुग्रहस्तत्र प्रभो चांचल्यकारणम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003768082, "chapter_id": 23768, "verse_number": "२-२-१२-८३", "content_sanskrit": "यदादिशसि देवेश प्रयाणं पुरुषोत्तमम् ।\nतन्मूर्ध्नि कृत्वा यास्यामि क्षेत्रं मुक्तिप्रदं शिवम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003768083, "chapter_id": 23768, "verse_number": "२-२-१२-८४", "content_sanskrit": "अभिसंधिं कुरुष्वाद्य ममानुग्रहकारणम् ।\nपुरुषोत्तमं मम क्षेत्रं त्वमेव परिपालय ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003768084, "chapter_id": 23768, "verse_number": "२-२-१२-८५", "content_sanskrit": "यथा पुनर्नेदृशं तद्विनाशमुपयास्यति ।\nइत्थमेतत्पुरा क्षेत्रं महादेवेन निर्मितम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003768085, "chapter_id": 23768, "verse_number": "२-२-१२-८६", "content_sanskrit": "बलश्रीसहितं देवमर्चयन्पुरुषोत्तमम् ।\nअत्र साक्षादुमाकांतः स्थापितः परमेष्ठिना ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003768086, "chapter_id": 23768, "verse_number": "२-२-१२-८७", "content_sanskrit": "वयं तत्र व्रजिष्यामो द्रक्ष्यामः पुरनाशनम् ।\nसुदृढांतस्तमःस्तोमभास्वंतं गिरिजापतिम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003768087, "chapter_id": 23768, "verse_number": "२-२-१२-८८", "content_sanskrit": "यदेतच्छांभवं क्षेत्रं तमसो नाशनं परम् ।\nरजःप्रक्षालनं श्रेयः ख्यातं विरजमण्डलम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003768088, "chapter_id": 23768, "verse_number": "२-२-१२-८९", "content_sanskrit": "सत्त्वोद्रिक्ततया ख्यातं मुक्तिदं पुरुषोत्तमम् ।\nयावत्यन्यानि क्षेत्राणि मुक्तिदानि श्रुतानि ते ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003768089, "chapter_id": 23768, "verse_number": "२-२-१२-९०", "content_sanskrit": "तानि सर्वाणि राजेंद्र ददते मुक्तिमत्र वै ।\nएतत्क्षेत्रं महाराज दुष्कृताविलचेतसाम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003768090, "chapter_id": 23768, "verse_number": "२-२-१२-९१", "content_sanskrit": "न विश्वासपथं याति रहस्यं चक्रपाणिनः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003768091, "chapter_id": 23768, "verse_number": "२-२-१२-९२", "content_sanskrit": "जैमिनिरुवाच ।\nनारदस्य वचः श्रुत्वा प्रहृष्टहृदयो नृपः ।\nउवाच मुनिशार्दूलं विस्मयोत्फुल्ललोचनः ।\nसाधु मे कथितं ब्रह्मन्क्षेत्रं परमपावनम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003768092, "chapter_id": 23768, "verse_number": "२-२-१२-९३", "content_sanskrit": "यत्रोमापतिरास्तेऽसौ पालकः पुरुषोत्तमः ।\nअवश्यं तत्र गच्छामः पन्था यद्यपि वक्रभूः ।\nउद्दिष्टेष्टपरिप्राप्तौ यदिदं कारणं महत् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003768093, "chapter_id": 23768, "verse_number": "२-२-१२-९४", "content_sanskrit": "जैमिनिरुवाच ।\nततस्तौ मुनिभूपालौ मध्याह्नसमये द्विजाः ।\nप्रापतुः सबलौ क्षेत्रमेकाम्रवनसंज्ञकम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003768094, "chapter_id": 23768, "verse_number": "२-२-१२-९५", "content_sanskrit": "बिंदुतीर्थे नृपः स्नात्वा तीरस्थं पुरुषोत्तमम् ।\nसंपूज्य विधिवद्यातः कोटीश्वरमहालयम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003768095, "chapter_id": 23768, "verse_number": "२-२-१२-९६", "content_sanskrit": "तद्वारि सम्यगाचांतस्तत्प्रीत्यै सुबहूनि सः ।\nगजाश्वधनरत्नानि वस्त्रालंकरणानि च ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003768096, "chapter_id": 23768, "verse_number": "२-२-१२-९७", "content_sanskrit": "द्विजेभ्यः प्रददौ राजा सात्त्विकं धर्ममास्थितः ।\nलिंगं त्रिभुवनेशं तं महास्नानेन पूजयन् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003768097, "chapter_id": 23768, "verse_number": "२-२-१२-९८", "content_sanskrit": "अतुलां प्रीतिमालेभे विष्णोरद्वैतदर्शनः ।\nस्तुत्वा प्रणम्य भक्त्यासौ वीणया चोपगाय्य च ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003768098, "chapter_id": 23768, "verse_number": "२-२-१२-९९", "content_sanskrit": "कृतांजलिपुटो देवप्रसादनकृतोद्यमः ।\nअनन्यमनसा तस्थौ चिंतयन्वृषभध्वजम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003768099, "chapter_id": 23768, "verse_number": "२-२-१२-१००", "content_sanskrit": "ततः प्रसन्नो भगवांस्त्र्यंबकः परमेश्वरः ।\nसाक्षान्नृपमुवाचेदं स्पष्टाक्षरपदं द्विजाः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003768100, "chapter_id": 23768, "verse_number": "२-२-१२-१०१", "content_sanskrit": "कोटिलिंगेश उवाच ।\nइन्द्रद्युम्न महाराज वैष्णवस्त्वादृशो भुवि ।\nदुर्लभः खलु ते वांछा चिरात्सम्यग्भविष्यति ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003768101, "chapter_id": 23768, "verse_number": "२-२-१२-१०२", "content_sanskrit": "इत्युक्त्वांतर्दधे शंभुः पश्यतस्तु महीक्षितः ।\nनारदं पुनराहेदं यदादिष्टं स्वयंभुवा ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003768102, "chapter_id": 23768, "verse_number": "२-२-१२-१०३", "content_sanskrit": "तत्कल्पय महाभाग वाजिमेधपुरःसरम् ।\nविष्णोः कलेवरे तस्मिन्क्षेत्रे श्रीपुरुषोत्तमे ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003768103, "chapter_id": 23768, "verse_number": "२-२-१२-१०४", "content_sanskrit": "अंतर्वेदी महापुण्या विष्णोर्हृदयसंनिभा ।\nतस्याः संरक्षणायाहं स्थापितो विष्णुनाष्टधा ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003768104, "chapter_id": 23768, "verse_number": "२-२-१२-१०५", "content_sanskrit": "शंखाकृतेरग्रभागे नीलकण्ठोऽहमास्थितः ।\nदुर्गया सह विप्रेंद्र तत्रेमं भूपतिं नय ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003768105, "chapter_id": 23768, "verse_number": "२-२-१२-१०६", "content_sanskrit": "अन्तर्हितः खल्विदानीं नीलरत्नतनुर्हरिः ।\nतत्र श्रीनरसिंहस्य क्षेत्रं कुरु मदाज्ञया ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003768106, "chapter_id": 23768, "verse_number": "२-२-१२-१०७", "content_sanskrit": "तत्र नः सन्निधौ वाजिमेधेन यजतामयम् ।\nसहस्रेण नृपश्रेष्ठ तदन्ते तरुमद्भुतम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003768107, "chapter_id": 23768, "verse_number": "२-२-१२-१०८", "content_sanskrit": "दर्शयैनं द्विजश्रेष्ठ ब्रह्मरूपमकल्मषम् ।\nचतस्रः प्रतिमास्तेन विश्वकर्मा घटिष्यति ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003768108, "chapter_id": 23768, "verse_number": "२-२-१२-१०९", "content_sanskrit": "तासां प्रतिष्ठितौ ब्रह्मा स्वयमेवागमिष्यति ।\nयथायं क्षीणपापः स्याद्वाजिमेधैर्यजन्हरिम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003768109, "chapter_id": 23768, "verse_number": "२-२-१२-११०", "content_sanskrit": "तिष्ठत्वब्दसहस्रं वै तदंते लोकयिष्यति ।\nसमस्तजगदाधारं सर्वकल्मषनाशनम् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003768110, "chapter_id": 23768, "verse_number": "२-२-१२-१११", "content_sanskrit": "दारवीं तनुमास्थाय दर्शनादपवर्गदम् ।\nन तस्य चरितं वेत्ति ब्रह्माऽहं त्वं च नारद ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003768111, "chapter_id": 23768, "verse_number": "२-२-१२-११२", "content_sanskrit": "आज्ञानुष्ठानतो भक्त्या प्रसीदति स केवलम् ।\nनारदोऽपि महादेवं प्रणिपत्य जगद्गुरुम् ।\nउवाच प्रांजलिर्भूत्वा यदादिष्टं त्वया विभो ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003768112, "chapter_id": 23768, "verse_number": "२-२-१२-११३", "content_sanskrit": "पितामहोऽपि मामित्थं निर्दिदेशास्य कल्पनम् ।\nपितामहश्च त्वं नाथ नो भिन्नौ परमात्मनः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003768113, "chapter_id": 23768, "verse_number": "२-२-१२-११४", "content_sanskrit": "नृपतेरस्य भाग्यर्द्धिरीदृशी यत्कृते विभो ।\nअगोचरोऽसि मनसस्त्र्याणामप्यनुग्रहः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003768114, "chapter_id": 23768, "verse_number": "२-२-१२-११५", "content_sanskrit": "यत्प्रसंगेन तरणं भवाब्धेरपि दुष्कृताम् ।\nअचिंत्यमहिमा ह्येष भगवान्भूतभावनः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003768115, "chapter_id": 23768, "verse_number": "२-२-१२-११६", "content_sanskrit": "न बुद्धिगोचरे भक्तिर्यावत्या प्रीयते ह्यसौ ।\nचिरं यतंतस्तिष्ठंति वेदानुवचनादिभिः ।\nक्षुद्रोऽपि लभते मुक्तिमनायासेन कर्मणा ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003768116, "chapter_id": 23768, "verse_number": "२-२-१२-११७", "content_sanskrit": "गव्योपजीव्या गोप्यस्तु वनचारगृहोषिताः ।\nअरण्यजीवनाः प्रापुर्मुक्तिं कामोपभोगतः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003768117, "chapter_id": 23768, "verse_number": "२-२-१२-११८", "content_sanskrit": "द्रुहन्निरंतरं प्राप शिशुपालः सभांतरे ।\nव्याधोः हृदयमाविध्य गतिं प्राप सुदुर्लभाम् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003768118, "chapter_id": 23768, "verse_number": "२-२-१२-११९", "content_sanskrit": "वस्त्राकर्षं गृहं नीत्वा कुब्जैनं बुभुजे पुरा ।\nयं ध्यानलयमापन्ना लभंते न सुरस्त्रियः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003768119, "chapter_id": 23768, "verse_number": "२-२-१२-१२०", "content_sanskrit": "चंडालाय ददौ मुक्तिं दूरस्थायापि नो पुनः ।\nआसन्नायातिभक्ताय श्रोत्रियाय पुरा विभुः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003768120, "chapter_id": 23768, "verse_number": "२-२-१२-१२१", "content_sanskrit": "मायाभिर्वंचयेत्त्वां हि पितामहमपि प्रभुः ।\nतिष्ठंति दुःखबहुलास्तपोभिर्देहबंधनाः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003768121, "chapter_id": 23768, "verse_number": "२-२-१२-१२२", "content_sanskrit": "गौतमाद्या ब्रह्मचर्यनिष्ठाः कल्पान्तवासिनः ।\nईदृक्तादृक्परिच्छेदगोचरं नास्य चेष्टितम् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003768122, "chapter_id": 23768, "verse_number": "२-२-१२-१२३", "content_sanskrit": "व्यवसायेन बहुना कालेन महता तथा ।\nनिर्णेतुं शक्यते नास्य चरितं वा सुमेधसः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003768123, "chapter_id": 23768, "verse_number": "२-२-१२-१२४", "content_sanskrit": "उपाया बहवः संति ये शास्त्रपरिनिष्ठिताः ।\nविदुषां मोचनायेह बहुशस्तैर्यजंति वै ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7003768124, "chapter_id": 23768, "verse_number": "२-२-१२-१२५", "content_sanskrit": "सर्वेषामुत्तमोपायो वसतिः पुरुषोत्तमे ।\nयाऽवश्यं स्वामिसायुज्यं प्रापयेत्सुसखा यथा ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7003768125, "chapter_id": 23768, "verse_number": "२-२-१२-१२६", "content_sanskrit": "तदेनं मायिनं प्राप्तुमुपायो नांतरीयकः ।\nस्वयं निधाय हरिणा यत्र वासः सुरक्षितः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7003768126, "chapter_id": 23768, "verse_number": "२-२-१२-१२७", "content_sanskrit": "इंद्रद्युम्नप्रसंगेन जायते सार्वलौकिकः ।\nतदाज्ञापय देवेश गृहीत्वैनं बलान्वितम् ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7003768127, "chapter_id": 23768, "verse_number": "२-२-१२-१२८", "content_sanskrit": "उपत्यकायां संस्थाप्य दीक्षयित्वा महाक्रतौ ।\nआगमिष्यामि पादाब्जसमीपं ते वृषध्वज ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7003768128, "chapter_id": 23768, "verse_number": "२-२-१२-१२९", "content_sanskrit": "जैमिनिरुवाच ।\nतथेत्युक्त्वा महादेवः क्षणादंतर्दधे मुनेः ।\nसोऽपि राज्ञो रथे तिष्ठन्प्रययौ क्षेत्रमुत्तमम् ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7003768129, "chapter_id": 23768, "verse_number": "२-२-१२-१३०", "content_sanskrit": "द्वितीयेऽह्नि कपोतेशस्थलीमासेदिवान्नृपः ।\nदैर्घ्यायामसमायुक्तां जलाशयद्रुमाकुलाम् ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7003768130, "chapter_id": 23768, "verse_number": "२-२-१२-१३१", "content_sanskrit": "बिल्वेशः पूर्वसीमायां समुद्रतटमास्थितः ।\nसेनानिवेश योग्यां तां मत्रिणा संनिवेदिताम् ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7003768131, "chapter_id": 23768, "verse_number": "२-२-१२-१३२", "content_sanskrit": "यथायोग्यं यथास्थानं स्थापयित्वा नृपोत्तमः ।\nबिल्वेश्वरकपोतेशं नमस्कृत्य प्रपूज्य च ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7003768132, "chapter_id": 23768, "verse_number": "२-२-१२-१३३", "content_sanskrit": "रथमास्थाय मतिमान्सहितो ब्रह्मसूनुना ।\nमनसा वचसा विष्णुं नीलाचलनिवासिनम् ।\nचिंतयन्कीर्तयन्विप्रा जगाम संनिधिं हरेः ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7003768133, "chapter_id": 23768, "verse_number": "२-२-१२-१३४", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे पुरुषोत्तमक्षेत्रमाहात्म्ये जैमिनिऋषिसंवादे द्वादशोऽध्यायः ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}]