[{"id": 2119506, "chapter_id": 3567, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2119507, "chapter_id": 3567, "verse_number": "१", "content_sanskrit": "युधिष्ठिर सभा दिव्या वरुणस्यामितप्रभा ।\nप्रमाणेन यथा याम्या शुभप्राकारतोरणा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2119508, "chapter_id": 3567, "verse_number": "", "content_sanskrit": "अन्तःसलिलमास्थाय विहिता विश्वकर्मणा ।\nदिव्यै रत्नमयैर्वृक्षैः फलपुष्पप्रदैर्युता ॥*॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2119509, "chapter_id": 3567, "verse_number": "२", "content_sanskrit": "नीलपीतहरिच्छ्यामैः सितैर्लोहितकैरपि।\nअवतानैस्तथा गुल्मैः पुष्पमञ्जरिधारिभिः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2119510, "chapter_id": 3567, "verse_number": "३", "content_sanskrit": "सदा शकुनयस्तस्यां नानावर्णा मृदुस्वराः ।\nअनिर्देश्या वपुष्मन्तः शतशोऽथ सहस्रशः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2119511, "chapter_id": 3567, "verse_number": "४", "content_sanskrit": "सा सभा सुखसंस्पर्शा नातिशीता न घर्मदा ।\nशुभासनवती रम्या सिता वरुणसम्मता\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2119512, "chapter_id": 3567, "verse_number": "५", "content_sanskrit": "तत्रास्ते वरुणो राजा वारुण्या सह भारत ।\nदिव्यमाल्याम्बरधरो दिव्यरत्नविभूषितः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2119513, "chapter_id": 3567, "verse_number": "६", "content_sanskrit": "द्वितीयेन तु नाम्ना वै गौरीति भुवि विश्रुता ।\nपत्न्न्या स वरुणो देवः प्रमोदति सुखी सुखम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2119514, "chapter_id": 3567, "verse_number": "७", "content_sanskrit": "दिव्यमाल्याम्बरधरा दिव्यालङ्कारभूषिताः ।\nआदित्यास्तत्र वरुणं जलेश्वरमुपासते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2119515, "chapter_id": 3567, "verse_number": "८", "content_sanskrit": "वासुकिस्तक्षकश्चैव नागश्चैरावतस्तथा ।\nकृष्णश्च लोहितश्चैव पद्मश्चित्रश्च वीर्यवान्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2119516, "chapter_id": 3567, "verse_number": "९", "content_sanskrit": "कम्बळाश्वतरौ नागौ धृतराष्ट्रबलाहकौ ।\nघृणिनागश्च नागश्च मणिः शङ्खनखस्तथा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2119517, "chapter_id": 3567, "verse_number": "१०", "content_sanskrit": "कौरव्यः स्वस्तिकश्चैव एलापत्रश्च वामनः ।\nअपराजितश्च दोषश्च नन्दकः पूरणस्तथा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2119518, "chapter_id": 3567, "verse_number": "११", "content_sanskrit": "अभीकः शभिकः श्वेतो भद्रो भद्रेश्वरस्तथा ।\nमणिमान् पिण्डकः सारः कार्कोटकधनञ्जयौ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2119519, "chapter_id": 3567, "verse_number": "१२", "content_sanskrit": "प्रह्लादो मूषिकादश्च तथैव जनमेजयः ।\nपताकिनो मण्डलिनः फणावन्तश्च सर्वशः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2119520, "chapter_id": 3567, "verse_number": "१३", "content_sanskrit": "अनन्तश्च महानागो यं दृष्ट्वा स जलेश्वरः ।\nअभ्यर्चयति सत्कारैरासनेन च तं विभुम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2119521, "chapter_id": 3567, "verse_number": "१४", "content_sanskrit": "वासुकिप्रमुखाश्चैव सर्वे प्राञ्जलयः स्थिताः ।\nअनुज्ञाताश्च शेषेण यथार्हमुपविश्य च\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2119522, "chapter_id": 3567, "verse_number": "१५", "content_sanskrit": "एते चान्ये च बहवः सर्पास्तस्यां युधिष्ठिर\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2119523, "chapter_id": 3567, "verse_number": "१६", "content_sanskrit": "वैनतेयश्च गरुडो ये चान्ये परिचारिणः ।\nउपासते महात्मानं वरुणं विगतज्वराः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2119524, "chapter_id": 3567, "verse_number": "१७", "content_sanskrit": "बलिर्वैरोचनिश्चैव नरकः पृथिवीञ्जयः ।\nप्रह्लादो विप्रचित्तिश्च कालकेयाश्च सर्वशः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2119525, "chapter_id": 3567, "verse_number": "१८", "content_sanskrit": "सुमुखो दुर्मुखः शङ्खः सुमनाः सुमतिः स्वनः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2119526, "chapter_id": 3567, "verse_number": "१९", "content_sanskrit": "घटोदरो महापार्श्वः क्रथश्च पितरस्तथा ।\nविश्वरूपः स्वरूपश्च विरूपश्च महाशिराः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2119527, "chapter_id": 3567, "verse_number": "२०", "content_sanskrit": "दशग्रीवश्च वाली च मेघवासाश्च भारत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2119528, "chapter_id": 3567, "verse_number": "२१", "content_sanskrit": "दोदम्भो विगदूभश्च प्रभवश्चेन्द्रतापनः ।\nदैत्यदानवसङ्घाश्च सर्वे रुचिरकुण्डलाः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2119529, "chapter_id": 3567, "verse_number": "२२", "content_sanskrit": "स्रग्विणो मौळिनः सर्वे सर्वे च चरितव्रताः ।\nसर्वे लब्धवराः शूराः सर्वे विजितमृत्यवः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2119530, "chapter_id": 3567, "verse_number": "२३", "content_sanskrit": "ते तस्यां वरुणं पार्थ धर्मपाशस्थिताः सदा ।\nउपासते महात्मानं सर्वे दिव्यपरिच्छदाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2119531, "chapter_id": 3567, "verse_number": "२४", "content_sanskrit": "तथा समुद्राश्चत्वारो नदी भागीरथी च या ।\nकाळिन्दी विदिशा वेण्णा नर्मदा वेगवाहिनी\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2119532, "chapter_id": 3567, "verse_number": "२५", "content_sanskrit": "विपाशा च शतद्रुश्च चन्द्रभागा सरस्वती ।\nइरावती वितस्ता च सिन्धुर्देवनदस्तथा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2119533, "chapter_id": 3567, "verse_number": "२६", "content_sanskrit": "गोदावरी कृष्णवेणी कावेरी सरितां वरा ।\nकम्बुदा च विशल्या च कौशिकी गोमती तथा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2119534, "chapter_id": 3567, "verse_number": "२७", "content_sanskrit": "देविका च विपाका च तथा वैतरणी नदी ।\nतृतीया ज्येष्ठिला चैव शोणश्चैव महानदः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2119535, "chapter_id": 3567, "verse_number": "२८", "content_sanskrit": "चर्मण्वती श्वेतनदी फल्गुनी च महानदी ।\nसरयूश्चीरवल्केला कुलिश्च सरितस्तथा\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2119536, "chapter_id": 3567, "verse_number": "२९", "content_sanskrit": "एताश्चान्याश्च सरितः तीर्थानि च सरांसि च ।\nह्रदाश्च वरुणं देवं सभायां पर्युपासते\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2119537, "chapter_id": 3567, "verse_number": "३०", "content_sanskrit": "कूपाश्च सप्रस्रवणा देहवन्तो युधिष्ठिर ।\nपल्वलानि तटाकानि देहवन्त्यथ भारत\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2119538, "chapter_id": 3567, "verse_number": "३१", "content_sanskrit": "दिशश्चाथ मही चैव विदिशश्च महीधराः ।\nउपासते महात्मानं सर्वे जलचरास्तथा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2119539, "chapter_id": 3567, "verse_number": "३२", "content_sanskrit": "गीतवादित्रवादाश्च गन्धर्वाप्सरसां गणाः ।\nस्तुवन्तस्तत्र वरुणं सभायां च समासते\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2119540, "chapter_id": 3567, "verse_number": "३३", "content_sanskrit": "महीधरा रत्नवन्तो रसा ये च प्रतिष्ठिताः ।\nकथयन्तः सुमधुराः कथास्ते तु समासते\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2119541, "chapter_id": 3567, "verse_number": "", "content_sanskrit": "वरुणस्य महामन्त्री सुनाभः पर्युपासते ।\nपुत्रपौत्रैः परिवृतो गोनाम्ना पुष्करेण च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2119542, "chapter_id": 3567, "verse_number": "३४", "content_sanskrit": "सर्वे विग्रहवन्तस्ते तमीश्वरमुपासते\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2119543, "chapter_id": 3567, "verse_number": "३५", "content_sanskrit": "एषा मया सम्प्रगीता वारुणी भरतर्षभ ।\nदृष्टपूर्वा सभा रम्या कुबेरस्य सभां शृणु\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2119544, "chapter_id": 3567, "verse_number": "९", "content_sanskrit": "॥ इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि नवमोऽध्यायः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2119545, "chapter_id": 3567, "verse_number": "९", "content_sanskrit": "॥ मन्त्रपर्वणि नवमोऽध्यायः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2119546, "chapter_id": 3567, "verse_number": "", "content_sanskrit": "—— ०  ——", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]