[{"id": 7003641000, "chapter_id": 23641, "verse_number": "१-२-२८-१", "content_sanskrit": "नारद उवाच ।\nव्रजंती गिरिजाऽपश्यत्सखीं मातुर्महाप्रभाम् ।\nकुसुमामोदिनींनाम तस्य शैलस्य देवताम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003641001, "chapter_id": 23641, "verse_number": "१-२-२८-२", "content_sanskrit": "सापि दृष्ट्वा गिरिसुतां स्नेहविक्लवमानसा ।\nक्वपुनर्गच्छसीत्युच्चैरालिंग्योवाच देवता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003641002, "chapter_id": 23641, "verse_number": "१-२-२८-३", "content_sanskrit": "सा चास्यै सर्वमाचख्यौ शंकरात्कोपकारणम् ।\nपुनश्चोवाच गिरिजा देवतां मातृसंमताम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003641003, "chapter_id": 23641, "verse_number": "१-२-२८-४", "content_sanskrit": "नित्यं शैलाधिराजस्य देवता त्वमनिंदिते ।\nसर्वं च सन्निधानं च मयि चातीव वत्सला ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003641004, "chapter_id": 23641, "verse_number": "१-२-२८-५", "content_sanskrit": "तदहं संप्रवक्ष्यामि यद्विधेयं तवाधुना ।\nअथान्य स्त्रीप्रवेशे तु समीपे तु पिनाकिनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003641005, "chapter_id": 23641, "verse_number": "१-२-२८-६", "content_sanskrit": "त्वयाख्येयं मम शुबे युक्तं पश्चात्करोम्यहम् ।\nतथेत्युक्ते तया देव्या ययौ देवी गिरिं प्रति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003641006, "chapter_id": 23641, "verse_number": "१-२-२८-७", "content_sanskrit": "रम्ये तत्र महाशृंगे नानाश्चर्योपशोभिते ।\nविभूषणादि सन्यस्य वृक्षवल्कलधारिणी ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003641007, "chapter_id": 23641, "verse_number": "१-२-२८-८", "content_sanskrit": "तपस्तेपे गिरिसुता पुत्रेण परिपालिता ।\nग्रीष्मे पंचाग्निसंतप्ता वर्षासु च जलोषिता ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003641008, "chapter_id": 23641, "verse_number": "१-२-२८-९", "content_sanskrit": "यथा न काचित्प्रविशेद्योषिदत्र हरांतिके ।\nदृष्ट्वा परां स्त्रियं चात्र वदेथा मम पुत्रक ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003641009, "chapter_id": 23641, "verse_number": "१-२-२८-१०", "content_sanskrit": "शीघ्रमेव करिष्यामि ततो युक्तमनंतरम् ।\nएवमस्त्विति तां देवीं वीरकः प्राह सांप्रतम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003641010, "chapter_id": 23641, "verse_number": "१-२-२८-११", "content_sanskrit": "मातुराज्ञा सुतो ह्लाद प्लावितांगो गतज्वरः ।\nजगाम त्र्यक्षं संद्रष्टुं प्रणिपत्य च मातरम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003641011, "chapter_id": 23641, "verse_number": "१-२-२८-१२", "content_sanskrit": "गजवक्त्रं ततः प्राह प्रणम्य समवस्थितम् ।\nसाश्रुकंठं प्रयाचंतं नय मामपि पार्वति ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003641012, "chapter_id": 23641, "verse_number": "१-२-२८-१३", "content_sanskrit": "गजवक्त्रं हि त्वां बाल मामिवोपहसिष्यति ।\nतदागच्छ मया सार्धं या गतिर्मे तवापि सा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003641013, "chapter_id": 23641, "verse_number": "१-२-२८-१४", "content_sanskrit": "पराभवाद्धि धूर्तानां मरणं साधु पुत्रक ।\nएवमुक्त्वा समादाय हिमाद्रिं प्रति सा ययौ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]