[{"id": 2100637, "chapter_id": 3160, "verse_number": "१४-१६-१", "content_sanskrit": "जनमेजय उवाच।\nविजिते पाण्डवेयैस्तु प्रशान्ते च द्विजोत्तम।\nराष्ट्रे ते चत्रतुर्वीरौ वासुदेवधनंजयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2100638, "chapter_id": 3160, "verse_number": "१४-१६-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2100639, "chapter_id": 3160, "verse_number": "१४-१६-२", "content_sanskrit": "विजिते पाण्डवै राजन्प्रशान्ते च विशाम्पतौ।\nराष्ट्रे बभूवतुर्हृष्टौ वासुदेवधनंजयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2100640, "chapter_id": 3160, "verse_number": "१४-१६-३", "content_sanskrit": "विजह्राते मुदा युक्तौ दिवि देवश्वराविव।\nतौ वनेषु विचित्रेषु पर्वतेषु ससानुषुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2100641, "chapter_id": 3160, "verse_number": "१४-१६-४", "content_sanskrit": "तीर्थेषु चैव पुण्येषु पल्वलेषु नदीषु च।\nचंक्रम्यमाणौ संहृष्टावश्विनाविव नन्दने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2100642, "chapter_id": 3160, "verse_number": "१४-१६-५", "content_sanskrit": "इन्द्रप्रस्थे महात्मानौ रेमाते कृष्णपाण्डवौ।\nप्रविश्य तां सभां रम्यां विजह्राते च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2100643, "chapter_id": 3160, "verse_number": "१४-१६-६", "content_sanskrit": "तत्र युद्धकथाश्चित्राः परिक्लेशांश्च पार्थिव।\nकथायोगे कथायोगे कथयामासतुः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2100644, "chapter_id": 3160, "verse_number": "१४-१६-७", "content_sanskrit": "ऋषीणां देवतानां च वंशांस्तावाहतुः सदा।\nप्रीयमाणौ महात्मानौ पुराणावृषिसत्तमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2100645, "chapter_id": 3160, "verse_number": "१४-१६-८", "content_sanskrit": "मधुरास्तु कथाश्चित्राश्चित्रार्थपदनिश्चयाः।\nनिश्चयज्ञः स पार्थाय कथयामास केशवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2100646, "chapter_id": 3160, "verse_number": "१४-१६-९", "content_sanskrit": "पुत्रशोकाभिसंतप्तं ज्ञातीनां च सहस्रशः।\nकथाभिः शमयामास पार्तं शौरिर्जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2100647, "chapter_id": 3160, "verse_number": "१४-१६-१०", "content_sanskrit": "स तमाश्वास्य विधिवद्विधानज्ञो महातपाः।\nअपहृत्यात्मनो भारं विशश्रामेव सात्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2100648, "chapter_id": 3160, "verse_number": "१४-१६-११", "content_sanskrit": "ततः कथान्ते गोविन्दो गुडाखेशमुवाच ह।\nसान्त्वयञ्श्लक्ष्णया वाचा हेतुयुक्तमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2100649, "chapter_id": 3160, "verse_number": "१४-१६-१२", "content_sanskrit": "विजितेयं धरा कृत्स्ना सव्यसाचिन्परंतप।\nत्वद्बाहुबलामाश्रित्य राज्ञा धर्मसुतेन ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2100650, "chapter_id": 3160, "verse_number": "१४-१६-१३", "content_sanskrit": "असपत्नां महीं भुङ्क्ते धर्मराजो युधिष्ठिरः।\nभीमसेनानुभावेन यमयोश्च नरोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2100651, "chapter_id": 3160, "verse_number": "१४-१६-१४", "content_sanskrit": "धर्मेणि राज्ञा धर्मज्ञ प्राप्तं राज्यमकण्टकम्।\nधर्मेण निहतः सङ्ख्ये स च राजा सुयोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2100652, "chapter_id": 3160, "verse_number": "१४-१६-१५", "content_sanskrit": "अधर्मरुचयो लुब्धाः सदा चाप्रियवादिनः।\nधार्तराष्ट्रा दुरात्मानः सानुबन्धा निपातिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2100653, "chapter_id": 3160, "verse_number": "१४-१६-१६", "content_sanskrit": "प्रशान्तामखिलां पार्थ पृथिवीं पृथिवीपतिः।\nभुङ्क्ते धर्मसुतो राजा त्वया गुप्तः कुरूद्वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2100654, "chapter_id": 3160, "verse_number": "१४-१६-१७", "content_sanskrit": "रमे चाहं त्वया सार्धमरण्येष्वपि पाण्डव।\nकिमु यत्र जनोऽयं वै पृथा चामित्रकर्मन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2100655, "chapter_id": 3160, "verse_number": "१४-१६-१८", "content_sanskrit": "यत्र धर्मसुतो राजा यत्र यत्र भीमो महाबलः।\nयत्र माद्रवतीपुत्रौ रतिस्तत्र परा मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2100656, "chapter_id": 3160, "verse_number": "१४-१६-१९", "content_sanskrit": "तथैव स्वर्गलोकेषु सभोद्देशेषु कौरव।\nरमणीयेषु पुष्णेषु सहितस्य त्वयाऽनध॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2100657, "chapter_id": 3160, "verse_number": "१४-१६-२०", "content_sanskrit": "कालो महांस्त्वतीतो मे शूरसूनुमपश्यतः।\nबलदेवं च कौरव्यं तथाऽन्यान्वृष्णिपुङ्गवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2100658, "chapter_id": 3160, "verse_number": "१४-१६-२१", "content_sanskrit": "सोहं गन्तुमभीप्सामि पुरीं द्वारावतीं प्रति।\nरोचतां गमनं तुभ्यं ममापि पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2100659, "chapter_id": 3160, "verse_number": "१४-१६-२२", "content_sanskrit": "उक्तो बहुविधं राजा तत्रतत्र युधिष्ठिरः।\nसह भीष्मेण यद्युक्तमस्माभिः शोकर्शितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2100660, "chapter_id": 3160, "verse_number": "१४-१६-२३", "content_sanskrit": "शिष्टो युधिष्ठिरोऽस्माभिः शास्ता सन्नपि पाण्डवः।\nतेन तत्तु वचः सम्यग्गृहीतं सुमहात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2100661, "chapter_id": 3160, "verse_number": "१४-१६-२४", "content_sanskrit": "धर्मपुत्रे हि धर्मज्ञे कृतज्ञे सत्यवादिनि।\nसत्यं धर्मो मतिश्चाग्र्या स्थितिश्च सततं स्थिरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2100662, "chapter_id": 3160, "verse_number": "१४-१६-२५", "content_sanskrit": "तत्र गत्वा महात्मानं यदि ते रोचतेऽर्जुन।\nअस्मद्गमनसंयुक्तं वचो ब्रूहि जनाधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2100663, "chapter_id": 3160, "verse_number": "१४-१६-२६", "content_sanskrit": "न हि तस्याप्रियं कुर्यां प्राणत्योगेऽप्युपस्थिते।\nकुतो गन्तुं महाबाहो पुरीं द्वारावतीं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2100664, "chapter_id": 3160, "verse_number": "१४-१६-२७", "content_sanskrit": "सर्वं त्विदमहं पार्त त्वत्प्रीतिहितकाम्यया।\nब्रवीमि सत्यं कौरव्य न मिथ्यैतत्कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2100665, "chapter_id": 3160, "verse_number": "१४-१६-२८", "content_sanskrit": "प्रयोजनं च निर्वृत्तमिह वासेन मेऽर्जुन।\nधार्तराष्ट्रो हतो राजा सबलः सपदानुगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2100666, "chapter_id": 3160, "verse_number": "१४-१६-२९", "content_sanskrit": "पृथिवी च वशे तात धर्मपुत्रस्य धीमतः।\nस्थिता समुद्रवसना सशैलवनकानना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2100667, "chapter_id": 3160, "verse_number": "१४-१६-३०", "content_sanskrit": "चिता रत्नैर्बहुविधैः कुरुराजस्य पाण्डव।\nधर्मेण राजा धर्मज्ञः पातु सर्वां वसुन्धराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2100668, "chapter_id": 3160, "verse_number": "१४-१६-३१", "content_sanskrit": "उपास्यमानो मुनिभिः सिद्धैश्चापि महात्मभिः।\nस्तूयमानश्च सततं बन्दिभिर्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2100669, "chapter_id": 3160, "verse_number": "१४-१६-३२", "content_sanskrit": "तं मया सह गत्वाऽद्य राजानं कुरुवर्धनम्।\nआपृच्छ कुरुशार्दूल गमनं द्वारकां प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2100670, "chapter_id": 3160, "verse_number": "१४-१६-३३", "content_sanskrit": "इदं शरीरं वसु यच्च मे गृहे\nनिवेदितं पार्थ सदा युधिष्ठिरे।\nप्रियश्च मान्यश्च हि मे युधिष्ठिरः\nसदा कुरूणामधिपो महामतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2100671, "chapter_id": 3160, "verse_number": "१४-१६-३४", "content_sanskrit": "प्रयोजनं चापि निवासकारणे\nन विद्यते मे त्वदृते नृपात्मज।\nस्थिता हि पृथ्वी तव पार्थ शासने\nगुरोः सुवृत्तस्य युधिष्ठिरस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2100672, "chapter_id": 3160, "verse_number": "१४-१६-३५", "content_sanskrit": "इतीदमुक्तः स तदा महात्मना\nजनार्दनेनामितविक्रमोऽर्जुनः।\nतथेति दुःखादिव वाक्यमैरय-\nज्जनार्दनं सम्प्रतिपूज्य पार्थिव॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2100673, "chapter_id": 3160, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अश्वमेधपर्वणि षोडशोऽध्यायः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]