[{"id": 2011331, "chapter_id": 1231, "verse_number": "१-२३२-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2011332, "chapter_id": 1231, "verse_number": "१-२३२-१", "content_sanskrit": "जित्वा तु पृथिवीं दैत्यौ निःसपत्नौ गतव्यथौ।\nकृत्वा त्रैलोक्यमव्यग्रं कृतकृत्यौ बभूवतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2011333, "chapter_id": 1231, "verse_number": "१-२३२-२", "content_sanskrit": "देवगन्धर्वयक्षाणां नागपार्थिवरक्षसाम्।\nआदाय सर्वरत्नानि परां तुष्टिमुपागतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2011334, "chapter_id": 1231, "verse_number": "१-२३२-३", "content_sanskrit": "यदा न प्रतिषेद्धारस्तयोः सन्तीह केचन॥\nनिरुद्योगौ तदा भूत्वा विजह्रातेऽमराविव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2011335, "chapter_id": 1231, "verse_number": "१-२३२-४", "content_sanskrit": "स्त्रीभिर्माल्यैश्च गन्धैश्च भक्ष्यभोज्यैः सुपुष्कलैः।\nपानैश्च विविधैर्हृद्यैः परां प्रीतिमवापतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2011336, "chapter_id": 1231, "verse_number": "१-२३२-५", "content_sanskrit": "अन्तःपुरवनोद्याने पर्वतेषु वनेषु च।\nयथेप्सितेषु देशेषु विजह्रातेऽमराविव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2011337, "chapter_id": 1231, "verse_number": "१-२३२-६", "content_sanskrit": "ततः कदाचिद्विन्ध्यस्य प्रस्थे समशिलातले।\nपुष्पिताग्रेषु सालेषु विहारमभिजग्मतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2011338, "chapter_id": 1231, "verse_number": "१-२३२-७", "content_sanskrit": "दिव्येषु सर्वकामेषु समानीतेषु तावुभौ।\nवरासनेषु संहृष्टौ सह स्त्रीभिर्निषीदतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2011339, "chapter_id": 1231, "verse_number": "१-२३२-८", "content_sanskrit": "ततो वादित्रनृत्ताभ्यामुपातिष्ठन्त तौ स्त्रियः।\nगीतैश्च स्तुतिसंयुक्तैः प्रीत्या समुपजग्मिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2011340, "chapter_id": 1231, "verse_number": "१-२३२-९", "content_sanskrit": "ततस्तिलोत्तमा तत्र वने पुष्पाणि चिन्वती।\nवेषं सा क्षिप्तमाधाय रक्तेनैकेन वाससा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2011341, "chapter_id": 1231, "verse_number": "१-२३२-१०", "content_sanskrit": "नदीतीरेषु जातान्सा कर्णिकारान्प्रचिन्वती।\nशनैर्जगाम तं देशं यत्रास्तां तौ महासुरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2011342, "chapter_id": 1231, "verse_number": "१-२३२-११", "content_sanskrit": "तौ तु पीत्वा वरं पानं मदरक्तान्तलोचनौ।\nदृष्ट्वैव तां वरारोहां व्यथितौ संबभूवतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2011343, "chapter_id": 1231, "verse_number": "१-२३२-१२", "content_sanskrit": "तावुत्थायासनं हित्वा जग्मतुर्यत्र सा स्थिता।\nउभौ च कामसंमत्तावुभौ प्रार्थयतश्च ताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2011344, "chapter_id": 1231, "verse_number": "१-२३२-१३", "content_sanskrit": "दक्षिणे तां करे सुभ्रूं सुन्दो जग्राह पाणिना।\nउपसुन्दोपि जग्राह वामे पाणौ तिलोत्तमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2011345, "chapter_id": 1231, "verse_number": "१-२३२-१४", "content_sanskrit": "वरप्रदानमत्तौ तावौरसेन बलेन च।\nधनरत्नमदाभ्यां च सुरापानमदेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2011346, "chapter_id": 1231, "verse_number": "१-२३२-१५", "content_sanskrit": "सर्वैरेतैर्मदैर्मत्तावन्योन्यं भ्रुकुटीकृतौ।\nमदकामसमाविष्टौ परस्परमथोचतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2011347, "chapter_id": 1231, "verse_number": "१-२३२-१६", "content_sanskrit": "मम भार्या तव गुरुरिति सुन्दोऽभ्यभाषत।\nमम भार्या तव वधूरुपसुन्दोऽभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2011348, "chapter_id": 1231, "verse_number": "१-२३२-१७", "content_sanskrit": "नैषा तव ममैषेति ततस्तौ मन्युराविशत्।\nतस्या रूपेण संमत्तौ विगतस्नेहसौहृदौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2011349, "chapter_id": 1231, "verse_number": "१-२३२-१८", "content_sanskrit": "तस्या हेतोर्गदे भीमे संगृह्णीतामुभौ तदा।\nप्रगृह्य च गदे भीमे तस्यां तौ काममोहितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2011350, "chapter_id": 1231, "verse_number": "१-२३२-१९", "content_sanskrit": "अहंपूर्वमहंपूर्वमित्यन्योन्यं निजघ्नतुः।\nतौ गदाभिहतौ भीमौ पेततुर्धरणीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2011351, "chapter_id": 1231, "verse_number": "१-२३२-२०", "content_sanskrit": "रुधिरेणावसिक्ताङ्गौ द्वाविवार्कौ नभश्च्युतौ।\nततस्ता विद्रुता नार्यः स च दैत्यगणस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2011352, "chapter_id": 1231, "verse_number": "१-२३२-२१", "content_sanskrit": "पातालमगमत्सर्वो विषादभयकम्पितः।\nततः पितामहस्तत्र सहदेवैर्महर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2011353, "chapter_id": 1231, "verse_number": "१-२३२-२२", "content_sanskrit": "आजगाम विशुद्धात्मा पूजयंश्च तिलोत्तमाम्।\nवरेण च्छन्दयामास भगवान्प्रपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2011354, "chapter_id": 1231, "verse_number": "१-२३२-२३", "content_sanskrit": "वरं दित्सुः स तत्रैनां प्रीतः प्राह पितामहः।\nआदित्यचरिताँल्लोकान्विचरिष्यसि भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2011355, "chapter_id": 1231, "verse_number": "१-२३२-२४", "content_sanskrit": "तेजसा च सुदृष्टां त्वां न करिष्यति कश्चन।\nएवं तस्यै वरं दत्वा सर्वलोकपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2011356, "chapter_id": 1231, "verse_number": "१-२३२-२५", "content_sanskrit": "इन्द्रे त्रैलोक्यमाधाय ब्रह्मलोकं गतः प्रभुः।\nएवं तौ सहितौ भऊत्वा सर्वार्थेष्वेकनिश्चयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2011357, "chapter_id": 1231, "verse_number": "१-२३२-२६", "content_sanskrit": "तिलोत्तमार्थं संक्रुद्धावन्योन्यमभिजघ्नतुः।\nतस्माद्ब्रवीमि वः स्नेहात्सर्वाभरतसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2011358, "chapter_id": 1231, "verse_number": "१-२३२-२७", "content_sanskrit": "यथा वो नात्र भेदः स्यात्सर्वेषां द्रौपदीकृते।\nतथा कुरुत भद्रं वो मम चेत्प्रियमिच्छथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2011359, "chapter_id": 1231, "verse_number": "१-२३२-२८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2011360, "chapter_id": 1231, "verse_number": "१-२३२-२८", "content_sanskrit": "एवमुक्ता महात्मानो नारदेन महर्षिणा।\nसमयं चक्रिरे राजंस्तेऽन्योन्यवशमागताः।\nसमक्षं तस्य देवर्षेर्नारदस्यामितौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2011361, "chapter_id": 1231, "verse_number": "१-२३२-२९", "content_sanskrit": "एकैकस्य गृहे कृष्णा वसेद्वर्षमकल्मषा\nद्रौपद्या नः सहासीनानन्योन्यं योऽभिदर्शयेत्।\nस नो द्वादश मासानि ब्रह्मचारी वने वसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2011362, "chapter_id": 1231, "verse_number": "१-२३२-३०", "content_sanskrit": "कृते तु समये तस्मिन्पाण्डवैर्धर्मचारिभिः।\nनारदोऽप्यगमत्प्रीत इष्टं देशं महामुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2011363, "chapter_id": 1231, "verse_number": "१-२३२-३१", "content_sanskrit": "एवं तैः समयः पूर्वं कृतो नारदचोदितैः।\nन चाभिद्यन्त ते सर्वे तदान्योन्येन भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2011364, "chapter_id": 1231, "verse_number": "१-२३२-३२", "content_sanskrit": "अभ्यनन्दन्त ते सर्वे तदान्योन्यं च पाण्डवाः।\nएतद्विस्तरशः सर्वमाख्यातं ते नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2011365, "chapter_id": 1231, "verse_number": "१-२३२-३३", "content_sanskrit": "काले च तस्मिन्संपन्ने यथावज्जनमेजय॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2011366, "chapter_id": 1231, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि विदुरागमनराज्यलाभपर्वणि द्वात्रिंशदधिकद्विशततमोऽध्यायः॥ २३२ ॥ ॥ समाप्तं च विदुरागमनराज्यलाभपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]