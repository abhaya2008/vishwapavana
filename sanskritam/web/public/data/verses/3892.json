[{"id": 2133955, "chapter_id": 3892, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2133956, "chapter_id": 3892, "verse_number": "१", "content_sanskrit": "(श्रुत्वेमां धर्मसंयुक्तां धर्मराजः कथां शुभाम् ।\nपुनः पप्रच्छ तमृषिं मार्कण्डेयं तपस्विनम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2133957, "chapter_id": 3892, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2133958, "chapter_id": 3892, "verse_number": "२", "content_sanskrit": "कुमारस्तु यथा जातो यथा चाग्नेः सुतोऽभवत् ।\nयथा रुद्राच्च सम्भूतो गङ्गायां कृत्तिकासु च ।\nएतदिच्छाम्यहं श्रोतुं कौतूहलमतीव मे)\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2133959, "chapter_id": 3892, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2133960, "chapter_id": 3892, "verse_number": "३", "content_sanskrit": "अग्नीनां विविधा वंशाः कीर्तितास्ते मयाऽनघ ।\nशृणु जन्म तु कौरव्य कार्त्तिकेयस्य धीमतः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2133961, "chapter_id": 3892, "verse_number": "४", "content_sanskrit": "अद्भुतस्याद्भुतं पुत्रं प्रवक्ष्याम्यमितौजसम् ।\nजातं ब्रह्मर्षिभार्याभिर्ब्रह्मण्यं कीर्तिवर्धनम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2133962, "chapter_id": 3892, "verse_number": "५", "content_sanskrit": "देवासुराः पुरा यत्ता विनिघ्नन्तः परस्परम् ।\nतत्राजयन् सदा देवान् दानवा घोररूपिणः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2133963, "chapter_id": 3892, "verse_number": "६", "content_sanskrit": "वध्यमानं बलं दृष्ट्वा बहुशस्तैः पुरन्दरः ।\nस सैन्यनायकार्थाय चिन्तामाप भृशं तदा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2133964, "chapter_id": 3892, "verse_number": "", "content_sanskrit": "देवसेनां दानवैर्हि भग्नां दृष्ट्वा महाबलः ।\nपालयेद् वीर्यमाश्रित्य स ज्ञेयः पुरुषो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2133965, "chapter_id": 3892, "verse_number": "७", "content_sanskrit": "स शैलं मानसं गत्वा ध्यायन्नर्थमिमं भृशम् ।\nशुश्रावार्तस्वरं घोरमथ मुक्तं स्त्रिया तदा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2133966, "chapter_id": 3892, "verse_number": "८", "content_sanskrit": "अभिधावतु मां कश्चित् पुरुषस्त्रातु चैव ह ।\nपतिं च मे प्रदिशतु स्वयं वा पतिरस्तु मे \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2133967, "chapter_id": 3892, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2133968, "chapter_id": 3892, "verse_number": "९", "content_sanskrit": "पुरन्दरस्तु तामाह मा भैर्नास्ति भयं तव\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2133969, "chapter_id": 3892, "verse_number": "१०", "content_sanskrit": "एवमुक्त्वा ततोऽपश्यत् केशिनं स्थितमग्रतः ।\nकिरीटिनं गदापाणिं धातुमन्तमिवाचलम् ।\nहस्ते गृहीत्वा कन्यां तामथैनं वासवोऽब्रवीत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2133970, "chapter_id": 3892, "verse_number": "११", "content_sanskrit": "अनार्यकर्मन् कस्मात् त्वमिमां कन्यां जिहीर्षसि ।\nवज्रिणं मां विजानीहि विरमास्याः प्रबाधनात्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2133971, "chapter_id": 3892, "verse_number": "", "content_sanskrit": "केशी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2133972, "chapter_id": 3892, "verse_number": "१२", "content_sanskrit": "विसृजस्व त्वमेवैनां शक्रैषा प्रार्थिता मया ।\nक्षमं ते जीवतो गन्तुं स्वपुरं पाकशासन\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2133973, "chapter_id": 3892, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2133974, "chapter_id": 3892, "verse_number": "१३", "content_sanskrit": "एवमुक्त्वा गदां केशी चिक्षेपेन्द्रवधाय वै ।\nतामापतन्तीं चिच्छेद मध्ये वज्रेण वासवः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2133975, "chapter_id": 3892, "verse_number": "१४", "content_sanskrit": "अथास्य शैलशिखरं केशी क्रुद्धो व्यवासृजत् \t॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2133976, "chapter_id": 3892, "verse_number": "१५", "content_sanskrit": "महामेघप्रतीकाशं चलत् पावकसङ्कुलम् ।\nतदापतन्तं सम्प्रेक्ष्य शैलशृङ्गं शतक्रतुः ।\nबिभेद राजन् वज्रेण भुवि तन्निपपात ह \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2133977, "chapter_id": 3892, "verse_number": "१६", "content_sanskrit": "पतता तु तदा केशी तेन शृङ्गेण ताडितः ।\nहित्वा कन्यां महाभागां प्राद्रवद् भृशपीडितः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2133978, "chapter_id": 3892, "verse_number": "१७", "content_sanskrit": "अपयातेऽसुरे तस्मिंस्तां कन्यां वासवोऽब्रवीत्।\nकासि कस्यासि किञ्चेह कुरुषे त्वं शुभानने \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2133979, "chapter_id": 3892, "verse_number": "", "content_sanskrit": "कन्या", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2133980, "chapter_id": 3892, "verse_number": "१८", "content_sanskrit": "अहं प्रजापतेः कन्या देवसेनेति विश्रुता ।\nभगिनी मे दैत्यसेना सा पूर्वं केशिना हृता\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2133981, "chapter_id": 3892, "verse_number": "१९", "content_sanskrit": "सदैवावां भगिन्यौ तु सखीभिः सह मानसम् ।\nआगच्छावेह रत्यर्थमनुज्ञाय प्रजापतिम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2133982, "chapter_id": 3892, "verse_number": "२०", "content_sanskrit": "नित्यं चावां प्रार्थयते हर्तुं केशी महासुरः ।\nइच्छत्येनं दैत्यसेना न चाहं पाकशासन \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2133983, "chapter_id": 3892, "verse_number": "२१", "content_sanskrit": "सा हृताऽनेन भगवन् मुक्ताहं त्वद्बलेन तु ।\nत्वया देवेन्द्र निर्दिष्टं पतिमिच्छामि दुर्जयम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2133984, "chapter_id": 3892, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2133985, "chapter_id": 3892, "verse_number": "२२", "content_sanskrit": "मम मातृष्वसेयी त्व माता दाक्षायणी मम ।\nआख्यातं त्वहमिच्छामि स्वयमात्मबलं त्वया\t ॥ २२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2133986, "chapter_id": 3892, "verse_number": "", "content_sanskrit": "कन्या", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2133987, "chapter_id": 3892, "verse_number": "२३", "content_sanskrit": "अबलाऽहं महाबाहो पतिस्तु बलवान् मम ।\nवरदानात् पितुर्भावी सुरासुरनमस्कृतः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2133988, "chapter_id": 3892, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2133989, "chapter_id": 3892, "verse_number": "२४", "content_sanskrit": "कीदृशं तु बलं देवि पत्युस्तव भविष्यति ।\nएतदिच्छाम्यहं श्रोतुं तव वाक्यमनिन्दिते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2133990, "chapter_id": 3892, "verse_number": "", "content_sanskrit": "कन्या", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2133991, "chapter_id": 3892, "verse_number": "२५", "content_sanskrit": "देवदानवयक्षाणां किन्नरोरगरक्षसाम् ।\nजेता यो दुष्टदैत्यानां महावीर्यो महाबलः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2133992, "chapter_id": 3892, "verse_number": "२६", "content_sanskrit": "यस्तु सर्वाणि भूतानि त्वया सह विजेष्यति ।\nस हि मे भविता भर्ता ब्रह्मण्यः कीर्तिवर्धनः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2133993, "chapter_id": 3892, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2133994, "chapter_id": 3892, "verse_number": "२७", "content_sanskrit": "इन्द्रस्तस्या वचः श्रुत्वा दुःखितोऽचिन्तयद् भृशम् ।\nअस्या देव्याः पतिर्नास्ति यादृशं सम्प्रभाषते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2133995, "chapter_id": 3892, "verse_number": "२८", "content_sanskrit": "अथापश्यत् स उदये भास्करं भास्करद्युतिः ।\nसोमं चैव महाभागं विशमानं दिवाकरम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2133996, "chapter_id": 3892, "verse_number": "२९", "content_sanskrit": "अमावास्यां प्रवृत्तायां मुहूर्ते रौद्र एव तु ।\nदेवासुरं च सङ्ग्रामं सोऽपश्यदुदये गिरौ\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2133997, "chapter_id": 3892, "verse_number": "३०", "content_sanskrit": "लोहितैश्च घनैर्युक्तां पूर्वां सन्ध्यां शतक्रतुः ।\nअपश्यल्लोहितोदं च भगवान् वरुणालयम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2133998, "chapter_id": 3892, "verse_number": "३१", "content_sanskrit": "भृगुभिश्चाङ्गिरोभ्यश्च हुतं मन्त्रैः पृथग्विधैः ।\nहव्यं गृहीत्वा वह्नि च प्रविशन्तं दिवाकरम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2133999, "chapter_id": 3892, "verse_number": "३२", "content_sanskrit": "पर्व चैव चतुर्विंशत् तदा सूर्यमुपस्थितम् ।\nतथा सूर्यं वह्निगतं सोमं सूर्यगतं च तम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2134000, "chapter_id": 3892, "verse_number": "३३", "content_sanskrit": "समालोक्यैकतामेव शशिनो भास्करस्य च ।\nसमवायं तु तं रौद्रं दृष्ट्वा शक्रोऽन्वचिन्तयत्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2134001, "chapter_id": 3892, "verse_number": "३४", "content_sanskrit": "सूर्याचन्द्रमसोर्घोरं दृश्यते परिवेषणम् ।\nएतस्मिन्नेव रात्र्यन्ते महद्युद्धं तु शंसति \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2134002, "chapter_id": 3892, "verse_number": "३५", "content_sanskrit": "सरित् सिन्धुरपीयं तु प्रत्यसृग्वाहिनी भृशम् ।\nशृगालिन्यग्निवक्त्रा च प्रत्यादित्यं विराविणी \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2134003, "chapter_id": 3892, "verse_number": "३६", "content_sanskrit": "एष रौद्रश्च सङ्घातो महान् युक्तश्च तेजसा ।\nसोमस्य वह्निसूर्याभ्यामद्भुतोऽयं समागमः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2134004, "chapter_id": 3892, "verse_number": "३७", "content_sanskrit": "जनयेद् यं सुतं सोमः सोऽस्या देव्याः पतिर्भवेत् ।\nअग्निश्चैतैर्गुणैर्युक्तः अग्नौ सर्वाश्च देवताः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2134005, "chapter_id": 3892, "verse_number": "३८", "content_sanskrit": "एष चेज्जनयेद् गर्भं सोऽस्या देव्याः पतिर्भवेत्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2134006, "chapter_id": 3892, "verse_number": "३९", "content_sanskrit": "एवं सञ्चिन्त्य मघवान् ब्रह्मलोकं तदा गतः ।\nगृहीत्वा देवसेनां तामवदत् स पितामहम् ।\nउवाच चास्या देव्यास्त्वं साधुशूरं पतिं दिश\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2134007, "chapter_id": 3892, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2134008, "chapter_id": 3892, "verse_number": "४०", "content_sanskrit": "मयैतच्चिन्तितं कार्यं त्वया दानवसूदन ।\nतथैव भविता गर्भो बलवानुरुविक्रमः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2134009, "chapter_id": 3892, "verse_number": "४१", "content_sanskrit": "स भविष्यति सेनानीस्त्वया सह शतक्रतो ।\nअस्या देव्याः पतिश्चैव स भविष्यति वीर्यवान्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2134010, "chapter_id": 3892, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2134011, "chapter_id": 3892, "verse_number": "४२", "content_sanskrit": "एतच्छ्रुत्वा नमस्तस्मै कृत्वाऽसौ सह कन्यया ।\nतत्राभ्यगच्छद् देवेन्द्रो यत्र देवर्षयोऽभवन् \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2134012, "chapter_id": 3892, "verse_number": "४३", "content_sanskrit": "वसिष्ठप्रमुखा मुख्या विप्रेन्द्रा सुमहाबलाः ।\nभागार्थं तपसो धातुं तेषां सोमं तथाऽध्वरे\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2134013, "chapter_id": 3892, "verse_number": "४४", "content_sanskrit": "पिपासवोऽभ्ययुर्देवाः शतक्रतुपुरोगमाः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2134014, "chapter_id": 3892, "verse_number": "४५", "content_sanskrit": "इष्टिं कृत्वा यथान्यायं सुसमिद्धे हुताशने ।\nजुहुवुस्ते महात्मानो हव्यं सर्वदिवौकसाम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2134015, "chapter_id": 3892, "verse_number": "४६", "content_sanskrit": "समाहूतो हुतवहः सोऽद्भुतः सूर्यमण्डलात् ।\nविनिःसृत्य ययौ वह्निर्वाग्यतो विधिवत् प्रभुः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2134016, "chapter_id": 3892, "verse_number": "४७", "content_sanskrit": "आगम्याहवनीयं वै तैर्द्विजैर्मन्त्रतो हुतम् ।\nस तत्र विविधं हव्यं प्रतिगृह्य हुताशनः \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2134017, "chapter_id": 3892, "verse_number": "४८", "content_sanskrit": "ऋषिभ्यो भरतश्रेष्ठ प्रायच्छत दिवौकसाम् ।\nनिष्क्रामंश्चाप्यपश्यत् स पत्नीस्तेषां महात्मनाम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2134018, "chapter_id": 3892, "verse_number": "४९", "content_sanskrit": "स्वेष्वासनेषूपविष्टाः स्वपन्तीश्च तथा सुखम् ।\nदृष्ट्वाश्रमेषूपविष्टाः स्नायन्तीश्च पतिव्रताः ।\nरुग्मवेदिनिभास्तास्तु चन्द्रलेखा इवामलाः \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2134019, "chapter_id": 3892, "verse_number": "", "content_sanskrit": "हुताशनार्चिप्रतिमाः सर्वास्तारा इवाद्भुताः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2134020, "chapter_id": 3892, "verse_number": "५०", "content_sanskrit": "स तत्र तेन मनसा बभूव क्षुभितेन्द्रियः ।\nपत्नीर्दृष्ट्वा द्विजेन्द्राणां वह्निः कामवशं ययौ\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2134021, "chapter_id": 3892, "verse_number": "५१", "content_sanskrit": "भूयः स चिन्तयामास न न्याय्यं क्षुभितो ह्यहम् ।\nसाध्व्यः पत्न्यो द्विजेन्द्राणामकामाः कामयाम्यहम् \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2134022, "chapter_id": 3892, "verse_number": "५२", "content_sanskrit": "नैताः शक्या मया द्रष्टुं स्प्रष्टुं वाऽप्यनिमित्ततः ।\nगार्हपत्यं समाविश्य तस्मात् पश्याम्यभीक्ष्णशः \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2134023, "chapter_id": 3892, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2134024, "chapter_id": 3892, "verse_number": "५३", "content_sanskrit": "संस्पृशन्निव सर्वास्ताः शिखाभिः काञ्चनप्रभाः ।\nपश्यमानश्च मुमुदे गार्हपत्यं समाश्रितः \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2134025, "chapter_id": 3892, "verse_number": "५४", "content_sanskrit": "निरुष्य तत्र सुचिरमेवं वह्निर्वशं गतः ।\nमनस्तासु विनिक्षिप्य कामयानो वराङ्गनाः \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2134026, "chapter_id": 3892, "verse_number": "५५", "content_sanskrit": "कामसन्तप्तहृदयो देहत्यागविनिश्चितः ।\nअलाभे ब्राह्मणस्त्रीणामग्निर्वनमुपागमत् ।\nस्वाहा तं दक्षदुहिता प्रथमं कामयत् तदा \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2134027, "chapter_id": 3892, "verse_number": "५६", "content_sanskrit": "सा तस्य च्छिद्रमन्वैच्छच्चिरात् प्रभृति भामिनी ।\nअप्रमत्तस्य देवस्य न च पश्यत्यनिन्दिता\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2134028, "chapter_id": 3892, "verse_number": "५७", "content_sanskrit": "सा तं ज्ञात्वा यथावत् तु वह्नि वनमुपागतम् ।\nतत्त्वतः कामसन्तप्तं चिन्तयामास भारत\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2134029, "chapter_id": 3892, "verse_number": "५८", "content_sanskrit": "अहं सप्तर्षिपत्नीनां कृत्वा रूपाणि पावकम्\nकामयिष्यामि कामार्ता तासां रूपेण मोहितम्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2134030, "chapter_id": 3892, "verse_number": "५९", "content_sanskrit": "एवं कृते प्रीतिरस्य कामावाप्तिश्च मे भवेत् \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2134031, "chapter_id": 3892, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि मार्कण्डेयसमास्यापर्वणि आङ्गिरसोपाख्याने स्कन्दोत्पत्तौ त्रयोदशाधिकद्विशततमोऽध्यायः ॥२१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2134032, "chapter_id": 3892, "verse_number": "", "content_sanskrit": "॥ इति मार्कण्डेयसमास्यापर्वणि अष्टत्रिंशोऽध्यायः ॥३८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]