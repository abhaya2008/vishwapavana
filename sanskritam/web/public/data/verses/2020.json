[{"id": 2045924, "chapter_id": 2020, "verse_number": "६-६९-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2045925, "chapter_id": 2020, "verse_number": "६-६९-१", "content_sanskrit": "व्युषितायां तु शर्वर्यामुदिते च दिवाकरे।\nउभे सेने महाराज युद्धायैव समीयतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2045926, "chapter_id": 2020, "verse_number": "६-६९-२", "content_sanskrit": "अभ्यधावन्त संक्रुद्धाः परस्परजिगीषवः ।\nते सर्वे सहिता युद्धे समालोक्य परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2045927, "chapter_id": 2020, "verse_number": "६-६९-३", "content_sanskrit": "पाण्डवा धार्तराष्ट्राश्च राजन्दर्मन्त्रिते तव।\nव्यूहौ च व्यूह्य संरब्धाः संप्रहृष्टाः प्रहारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2045928, "chapter_id": 2020, "verse_number": "६-६९-४", "content_sanskrit": "अरक्षन्मकरव्यूहं भीष्मो राजन्समन्ततः ।\nतथैव पाण्डवा राजन्नरक्षन्व्यूहमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2045929, "chapter_id": 2020, "verse_number": "६-६९-५", "content_sanskrit": "`अजातशत्रुः शत्रूणां मनांसि समकम्पयत्।\nश्येनवद्व्यूह्य तं व्यूहं धौम्यस्य वचनात्स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2045930, "chapter_id": 2020, "verse_number": "६-६९-६", "content_sanskrit": "स हि तस्य सुविज्ञात अग्निचित्येषु भारत।\nमकरस्तु महाव्यूहस्तव पुत्रस्य धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2045931, "chapter_id": 2020, "verse_number": "६-६९-७", "content_sanskrit": "स्वयं सर्वेण सैन्येन द्रोणेनानुमतस्तदा ।\nयथाव्यूहं शान्तनवः सोऽन्ववर्तत तत्पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2045932, "chapter_id": 2020, "verse_number": "६-६९-८", "content_sanskrit": "स निर्ययौ महाराज पिता देवव्रतस्तव ।\nमहता रथवंशेन संवृतो रथिनां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2045933, "chapter_id": 2020, "verse_number": "६-६९-९", "content_sanskrit": "इतरेतरमन्वीयुर्यथाभागमवस्थिताः ।\nरथिनः पत्तयश्चैव दन्तिनः सादिनस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2045934, "chapter_id": 2020, "verse_number": "६-६९-१०", "content_sanskrit": "तान्दृष्ट्वाऽभ्युद्यतान्सङ्ख्ये पाण्डवा हि यशस्विनः ।\nश्येनव्यूहेन संव्यूह्य समनह्यन्त संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2045935, "chapter_id": 2020, "verse_number": "६-६९-११", "content_sanskrit": "अशोभत मुखे तस्य भीमसेनो महाबलः ।\nनेत्रे शिखण्डी दुर्धर्षो धृष्टद्युम्नश्च पार्षतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2045936, "chapter_id": 2020, "verse_number": "६-६९-१२", "content_sanskrit": "शीर्षे तस्याभवद्वीरः सात्यकिः सत्यविक्रमः ।\nविधुन्वन्गाण्डिवं पार्थो ग्रीवायामभवत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2045937, "chapter_id": 2020, "verse_number": "६-६९-१३", "content_sanskrit": "अक्षौहिण्या समं तत्र वामपक्षोऽभवत्तदा ।\nमहात्मा द्रुपदः श्रीमान्सह पुत्रेण संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2045938, "chapter_id": 2020, "verse_number": "६-६९-१४", "content_sanskrit": "दक्षिणश्चाभवत्पक्षः कैकेयोऽक्षौहिणीपतिः ।\nपृष्ठतो द्रौपदेयाश्च सौभद्रश्चापि वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2045939, "chapter_id": 2020, "verse_number": "६-६९-१५", "content_sanskrit": "पृष्ठे समभवच्छ्रीमान्स्वयं राजा युधिष्ठिरःक ।\nभ्रातृभ्यां सहितो वीरो यमाभ्यां चारुविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2045940, "chapter_id": 2020, "verse_number": "६-६९-१६", "content_sanskrit": "प्रविश्य तु रणे भीमो मकरं मुखतस्तदा।\nभीष्ममासाद्य संग्रामे च्छादयामास सायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2045941, "chapter_id": 2020, "verse_number": "६-६९-१७", "content_sanskrit": "ततो भीष्मो महास्राणि पातयामास भारत।\nमोहयन्पाण्डुपुत्राणां व्यूढं सैन्यं महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2045942, "chapter_id": 2020, "verse_number": "६-६९-१८", "content_sanskrit": "संमुह्यति तदा सैन्ये त्वरमाणो धनंजयः ।\nभीष्मं शरसहस्रेण विव्याध रणमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2045943, "chapter_id": 2020, "verse_number": "६-६९-१९", "content_sanskrit": "प्रतिसंवार्य चास्राणि भीष्ममुक्तानि संयुगे।\nस्वेनानीकेन हृष्टेन युद्धाय समुपस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2045944, "chapter_id": 2020, "verse_number": "६-६९-२०", "content_sanskrit": "ततो दुर्योधनो राजा भारज्वाजमभाषत ।\nपूर्वं दृष्ट्वा वधं घोरं बलस्य बलिनां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2045945, "chapter_id": 2020, "verse_number": "६-६९-२१", "content_sanskrit": "भ्रातॄणां च वधं युद्धे स्मरमाणो महारथः।\nआचार्यः सततं हि त्वं हितकामो ममानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2045946, "chapter_id": 2020, "verse_number": "६-६९-२२", "content_sanskrit": "वयं हि त्वां समाश्रित्य भीष्मं चैव पितामहम् ।\nदेवानपि रणे जेतुं प्रार्थयामो न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2045947, "chapter_id": 2020, "verse_number": "६-६९-२३", "content_sanskrit": "किमु पाण्डुसुताकन्युद्धे हीनवीर्यपराक्रमान् ।\nस तथा कुरु भद्रं ते यथा वध्यन्ति पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2045948, "chapter_id": 2020, "verse_number": "६-६९-२४", "content_sanskrit": "एवमुक्तस्ततो द्रोणस्तव पुत्रेण मारिष ।\nतत्र संप्रेक्ष्य राजनं संक्रुद्ध इव निश्चसन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2045949, "chapter_id": 2020, "verse_number": "६-६९-२५", "content_sanskrit": "बालिशस्त्वं न जानीषे पाण्डवानां पराक्रमम् ।\nन शक्या हि यथा जेतुं पाण्डवा हि महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2045950, "chapter_id": 2020, "verse_number": "६-६९-२६", "content_sanskrit": "यथाबलं यथावीर्यं कर्म कुर्यामहं हि ते।\nइत्युक्तवा ते सुतं राजन्नभ्यपद्यत वाहिनीम् ।\nअभिनत्पाण्डवानीकं प्रेक्षमाणस्य सात्यकेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2045951, "chapter_id": 2020, "verse_number": "६-६९-२७", "content_sanskrit": "सात्यकिस्तु ततो द्रौणं वारयामात भारत।\nतयोः प्रववृते युद्धं घोररूपं भयावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2045952, "chapter_id": 2020, "verse_number": "६-६९-२८", "content_sanskrit": "शैनेयं तु रणे क्रुद्धो भारद्वाजः प्रतापावान्।\nअविध्यन्निशितैर्बाणैर्जत्रुदेशे हसन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2045953, "chapter_id": 2020, "verse_number": "६-६९-२९", "content_sanskrit": "भीमसेनस्ततः क्रुद्धो भारद्वाजमविध्यत ।\nसंरक्षन्सात्यकिं राजन्द्रोणाच्छस्त्रभृतां वरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2045954, "chapter_id": 2020, "verse_number": "६-६९-३०", "content_sanskrit": "ततो द्रोणश्च भीष्मश्च तथा शल्यश्च मारिष।\nभीमसेनं रणे क्रुद्धाश्छादयांचक्रिरे शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2045955, "chapter_id": 2020, "verse_number": "६-६९-३१", "content_sanskrit": "तत्राभिमन्युः संक्रुद्धो द्रौपदेयाश्च मारिष ।\nविव्यधुर्निशितैर्बैणैः सर्वांस्तानुद्यतायुधान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2045956, "chapter_id": 2020, "verse_number": "६-६९-३२", "content_sanskrit": "द्रोणभीष्मौ तु संक्रुद्धावापतन्तौ महाबलौ ।\nप्रत्युद्ययौ शिखण्डी तु महेष्वासो महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2045957, "chapter_id": 2020, "verse_number": "६-६९-३३", "content_sanskrit": "प्रगृह्य बलवद्वीरो धनुर्जलदनिःश्वनम् ।\nअभ्यवर्षच्छरैस्तूर्णं छादयानो दिवाकरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2045958, "chapter_id": 2020, "verse_number": "६-६९-३४", "content_sanskrit": "शिखण्डिनं समासाद्य भरतानां पितामहः ।\nअवर्जयत संग्रामं स्त्रीत्वं तस्यानुसंस्मरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2045959, "chapter_id": 2020, "verse_number": "६-६९-३५", "content_sanskrit": "ततो द्रोणो महाराज अभ्यद्रवत तं रणे।\nरक्षमाणस्तदा भीष्मं तव पुत्रेण चोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2045960, "chapter_id": 2020, "verse_number": "६-६९-३६", "content_sanskrit": "शिखण्डी तु समासाद्य द्रोणं शस्त्रभृतां वरम्।\nअवर्जयत संत्रस्तो युगान्ताग्निमिवोल्बणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2045961, "chapter_id": 2020, "verse_number": "६-६९-३७", "content_sanskrit": "ततो बलेन महता पुत्रस्तव विशांपते ।\nजुगोप भीष्ममासाद्य प्रार्थयानो महद्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2045962, "chapter_id": 2020, "verse_number": "६-६९-३८", "content_sanskrit": "तथैव पाण्डवा राजन्पुरुस्कृत्य धनञ्जयम्।\nभीष्ममेवाभ्यवर्तन्त जये कृत्वा दृढां मतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2045963, "chapter_id": 2020, "verse_number": "६-६९-३९", "content_sanskrit": "तद्युद्धमभवद्धोरं देवानां दानवैरिव।\nजयमाकाङ्क्षतां सङ्क्ष्ये यशश्च सुमहाद्भुतम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2045964, "chapter_id": 2020, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि पञ्चमदिवसयुद्धे एकोनसप्ततितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]