[{"id": 7002861000, "chapter_id": 22861, "verse_number": "९-१४६-१", "content_sanskrit": "श्रीवसिष्ठ उवाच ।\nअथान्यदपि ते वच्मि व्रतं राजन्महाफलम् ।\nअपराधशतं येन क्षयं याति शृणुष्व तत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002861001, "chapter_id": 22861, "verse_number": "९-१४६-२", "content_sanskrit": "इक्ष्वाकुरुवाच ।\nकिं व्रतं तन्ममाचक्ष्व कोऽपराधस्तु तं वद ।\nकः पूज्यते च वै तस्मिन्कदा वा क्रियते नरैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002861002, "chapter_id": 22861, "verse_number": "९-१४६-३", "content_sanskrit": "श्रीवसिष्ठ उवाच ।\nशृणु राजन्महाबाहो अपराधशतव्रतम् ।\nयेनानुष्ठितमात्रेण काममोक्षौ लभेत ना ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002861003, "chapter_id": 22861, "verse_number": "९-१४६-४", "content_sanskrit": "प्रायश्चित्तान्यशेषाणि सर्वपापापनुत्तये ।\nकृतान्यप्यकृतानि स्युरिति होवाच पद्मजः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002861004, "chapter_id": 22861, "verse_number": "९-१४६-५", "content_sanskrit": "पापं गुरुतरं चापि दह्यते तूलराशिवत् ।\nअपराधशतं राजञ्शृणुष्व गदतो मम ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002861005, "chapter_id": 22861, "verse_number": "९-१४६-६", "content_sanskrit": "न करोति नरो मोहाद्व्रतमेतद्दिनेदिने ।\nअनाश्रमित्वं प्रथमोऽनग्निता व्रतहीनता ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002861006, "chapter_id": 22861, "verse_number": "९-१४६-७", "content_sanskrit": "अदातृत्वमशौचं च निर्दयत्वं स्पृहालुता ।\nअक्षांतिर्जनपीडा च मायित्वमप्यमंगलम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002861007, "chapter_id": 22861, "verse_number": "९-१४६-८", "content_sanskrit": "क्षतव्रतत्वं नास्तिक्यं वेदनिंदा कठोरता ।\nअसत्यता हिंसकत्वं स्तैन्यमि न्द्रियविप्लवः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002861008, "chapter_id": 22861, "verse_number": "९-१४६-९", "content_sanskrit": "मनसोऽनिग्रहश्चैव क्रोध ईर्ष्याथ मत्सरः ।\nदंभः शाठ्यं च धौर्त्यं च कटुकोक्तिः प्रमादता ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002861009, "chapter_id": 22861, "verse_number": "९-१४६-१०", "content_sanskrit": "भार्यामातृसुतादीनां त्यागश्चापूज्य पूजनम् ।\nश्राद्धहानिर्जपत्यागः पंचयज्ञविवर्जनम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002861010, "chapter_id": 22861, "verse_number": "९-१४६-११", "content_sanskrit": "संध्यातर्पणहोमानां हानिरग्नेः प्रणाशनम् ।\nअनृतौ मैथुनं पार्थ पर्वण्यपि च मैथुनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002861011, "chapter_id": 22861, "verse_number": "९-१४६-१२", "content_sanskrit": "पैशुन्यं परदारेषु दानं वेश्याभिगामिता ।\nअपात्रदानं चाल्पं च मूलिकाकुलिभक्षणम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002861012, "chapter_id": 22861, "verse_number": "९-१४६-१३", "content_sanskrit": "अंत्यजागमनं मातृत्यागः पितृविवर्जनम् ।\nपित्रोरभक्तिर्वादश्च पुराणस्मृतिवर्जनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002861013, "chapter_id": 22861, "verse_number": "९-१४६-१४", "content_sanskrit": "अभक्ष्यभोजनं चापि पतिद्रोहोऽविचारता ।\nकृषिकर्मक्रियावाहं भार्यासंग्रहकारिता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002861014, "chapter_id": 22861, "verse_number": "९-१४६-१५", "content_sanskrit": "इंद्रियाजयमायित्वं विद्याविस्मरणं तथा ।\nशास्त्रत्याग ऋणं चित्रकर्म चानंगधावनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002861015, "chapter_id": 22861, "verse_number": "९-१४६-१६", "content_sanskrit": "भार्यापुत्रसुतादीनां विक्रयः पशुमैथुनम् ।\nइन्धनार्थं द्रुमच्छेदो बिले वार्यादिपूरणम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002861016, "chapter_id": 22861, "verse_number": "९-१४६-१७", "content_sanskrit": "तडागागमने वृत्तं विद्याविक्रयकारिता ।\nवृत्तिलोपो महीपाल याचकत्वं कुमित्रता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002861017, "chapter_id": 22861, "verse_number": "९-१४६-१८", "content_sanskrit": "स्त्रीवधो गोवधश्चैव पौरोहित्यं सुहृद्वधः ।\nभ्रूणहत्या परान्नं च शूद्रान्नस्य निषेवणम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002861018, "chapter_id": 22861, "verse_number": "९-१४६-१९", "content_sanskrit": "शूद्रस्य चाग्निकर्मत्वमविधित्वं कुपुत्रता ।\nविद्वद्भ्यो याचकत्वं हि वाचाटत्वं प्रतिग्रहः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002861019, "chapter_id": 22861, "verse_number": "९-१४६-२०", "content_sanskrit": "श्रौतसंस्कार दीनत्वमार्तत्राणविवर्जनम् ।\nब्रह्महत्यासुरापानरुक्मस्तैन्यमतः परम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002861020, "chapter_id": 22861, "verse_number": "९-१४६-२१", "content_sanskrit": "गुरुदाराभिगामित्वं संयोगश्चापि तैः सह ।\nअपराधशतं त्वेतत्कथितं ते मयानघ ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002861021, "chapter_id": 22861, "verse_number": "९-१४६-२२", "content_sanskrit": "अन्येऽपि विविधाः संति प्रोक्ताः प्राधान्यतस्त्वमी ।\nयदि वक्त्रसहस्राणि वक्त्रे जिह्वाशतानि च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002861022, "chapter_id": 22861, "verse_number": "९-१४६-२३", "content_sanskrit": "तथाप्येते न शक्यंते वक्तुं यस्मादनंतकाः ।\nअपराधसहस्राणि लक्षकोटिशतानि च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002861023, "chapter_id": 22861, "verse_number": "९-१४६-२४", "content_sanskrit": "नश्यंति तत्क्षणान्नूनं सत्येशस्यानुपूजनात् ।\nपूज्ये भगवानत्र कृतकृत्ये पराजिते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002861024, "chapter_id": 22861, "verse_number": "९-१४६-२५", "content_sanskrit": "ध्वजे सत्ये स्थितश्चायं लक्ष्म्या सह जगत्पतिः ।\nवामदेवस्ततः पूर्वं नृसिंहो दक्षिणे स्थितः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002861025, "chapter_id": 22861, "verse_number": "९-१४६-२६", "content_sanskrit": "कपिलः पश्चिमास्ये तु वाराहश्चोत्तरे स्थितः ।\nऊर्ध्ववक्त्रोऽच्युतो ज्ञेय एतद्वै ब्रह्मपंचकम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002861026, "chapter_id": 22861, "verse_number": "९-१४६-२७", "content_sanskrit": "तं सत्येशं स्थितं राजन्पूजयेच्च सदैव हि ।\nक्षीरोदयार्धचन्द्रस्थपद्मकर्णिकसंस्थितम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002861027, "chapter_id": 22861, "verse_number": "९-१४६-२८", "content_sanskrit": "पद्मकौमोदकीशंखचक्रायुधविधारणम् ।\nवामे चाधस्तथा दक्षे ऊर्ध्वे पश्चादधो नृप ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002861028, "chapter_id": 22861, "verse_number": "९-१४६-२९", "content_sanskrit": "पादाधस्ताद्विनिष्क्रांता गंगा पूता सदा नृभिः ।\nशक्त्यष्टकं तथा चान्यत्तन्नामानि च मे शृणु ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002861029, "chapter_id": 22861, "verse_number": "९-१४६-३०", "content_sanskrit": "जया च विजया चैव जयंती पापनाशिनी ।\nउन्मीलिनी वंजुली च त्रिस्पृशाथ विवर्द्धना ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002861030, "chapter_id": 22861, "verse_number": "९-१४६-३१", "content_sanskrit": "एताभिः शक्तिभिर्युक्तं लोकदिक्पालवर्जितम् ।\nशुक्लांबरधरं सौम्यं प्रहृष्टवदनं शिवम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002861031, "chapter_id": 22861, "verse_number": "९-१४६-३२", "content_sanskrit": "सर्वाभरणशोभाढ्यं भुक्तिमुक्तिप्रदं हरिम् ।\nपूजयेच्च प्रयत्नेन विधिना येन तं शृणु ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002861032, "chapter_id": 22861, "verse_number": "९-१४६-३३", "content_sanskrit": "मार्गशीर्षादिमासेषु द्वादशस्वपि सर्वदा ।\nद्वादश्यामप्यमायां वा अष्टम्यां च सितासिते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002861033, "chapter_id": 22861, "verse_number": "९-१४६-३४", "content_sanskrit": "कृतोपवासः शुद्धात्मा कुर्याद्व्रतमतंद्रितः ।\nपक्षयोरुभयोरेवं पूजयेऽहं जनार्दनम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002861034, "chapter_id": 22861, "verse_number": "९-१४६-३५", "content_sanskrit": "एवं तु नियमं कृत्वा दंतधावनपूर्वकम् ।\nगच्छेत्ततस्तडागे वा पुष्करिण्यां गृहेऽपि वा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002861035, "chapter_id": 22861, "verse_number": "९-१४६-३६", "content_sanskrit": "स्नात्वा तु नैत्यकं कर्म कृत्वा नैमित्तिकं ततः ।\nकुर्यात्सर्वं प्रयत्नेन यथावदनुपूर्वशः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002861036, "chapter_id": 22861, "verse_number": "९-१४६-३७", "content_sanskrit": "सौवर्णं कारयेद्देवं पूर्वोक्तं सत्यरूपिणम् ।\nशक्त्यष्टकयुतं लक्ष्म्या युक्तं पद्मासनस्थया ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002861037, "chapter_id": 22861, "verse_number": "९-१४६-३८", "content_sanskrit": "सुवर्णपलमानेन कार्यमेतत्सविस्तरम् ।\nदुग्धकुंभोपरिष्टात्तु स्वर्णपद्मं प्रकल्पयेत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002861038, "chapter_id": 22861, "verse_number": "९-१४६-३९", "content_sanskrit": "तत्कर्णिकागतं देवं शक्तिवृन्दसमन्वितम् ।\nपूजयेद्विधिवत्पश्चाद्गुरुमंत्रप्रचोदितः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002861039, "chapter_id": 22861, "verse_number": "९-१४६-४०", "content_sanskrit": "शुद्धशुक्लांबरधरो मंत्रसंभारसंस्थितः ।\nदेवक्षीरसमुद्रेऽस्मिन्वृत्ते चन्द्रे च पुष्करे ।\nतत्र त्वं सत्यया सार्द्धं सत्येश भव सन्निधौ ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002861040, "chapter_id": 22861, "verse_number": "९-१४६-४१", "content_sanskrit": "ॐ क्षीरसागरकल्लोले स्नाहि पापनिषूदन ।\nअनेन भूतभव्येन दत्तेन जलबिन्दुना ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002861041, "chapter_id": 22861, "verse_number": "९-१४६-४२", "content_sanskrit": "हरस्व सर्वं दुरितं मम नाथ जनार्दन ।\nवस्त्रदानेन शुभ्रेण सत्येश कुरु मे शुभम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002861042, "chapter_id": 22861, "verse_number": "९-१४६-४३", "content_sanskrit": "यज्ञे योगे तथा सांख्ये पवित्रस्त्वं सदोच्यसे ।\nयज्ञोपवीतदानेन कुरु मां सर्वपावनम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002861043, "chapter_id": 22861, "verse_number": "९-१४६-४४", "content_sanskrit": "विलिप्तं कर्मणा सर्वं सत्यं सत्यं न केनचित् ।\nमम चन्दनलिप्तांगः सर्वलेपापहो भव ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002861044, "chapter_id": 22861, "verse_number": "९-१४६-४५", "content_sanskrit": "सत्यनाथ नमस्तुभ्यं मूर्तामूर्तस्वरूपिणे ।\nवासुदेव नृसिंहाख्य कपिलादिव्यभूधर ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002861045, "chapter_id": 22861, "verse_number": "९-१४६-४६", "content_sanskrit": "वाराहाच्युत यज्ञेश लक्ष्मीकांत नृपेश्वर ।\nपशुं पुत्रं च मे देहि पापशत्रो निरंजन ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002861046, "chapter_id": 22861, "verse_number": "९-१४६-४७", "content_sanskrit": "संकर्षण महावीर्य सर्वेशामितविक्रम ।\nअनिरुद्धेन्द्र गोविन्द धृतचक्र नमोऽस्तु ते ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002861047, "chapter_id": 22861, "verse_number": "९-१४६-४८", "content_sanskrit": "कृष्णकृष्ण प्रभो रामराम कृष्ण विभो हरे ।\nत्राहि मां सर्वदुःखेभ्यो रमया सह माधव ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002861048, "chapter_id": 22861, "verse_number": "९-१४६-४९", "content_sanskrit": "पूजा चेयं मया दत्ता पितामहजगद्गुरो ।\nगृहाण जगदीशान नारायण नमोऽस्तु ते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002861049, "chapter_id": 22861, "verse_number": "९-१४६-५०", "content_sanskrit": "धनं गुप्तं महीपाल सर्वपापापनुत्तये ।\nएकस्यैव तु विप्रस्य यावद्वर्षं समर्पयेत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002861050, "chapter_id": 22861, "verse_number": "९-१४६-५१", "content_sanskrit": "दानं दद्यान्महाराज ह्यशक्तौ तदभावतः ।\nपक्षेपक्षे प्रकर्तव्यं व्रतमेतन्महत्तरम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002861051, "chapter_id": 22861, "verse_number": "९-१४६-५२", "content_sanskrit": "संवत्सरे ततः पूर्णे कुर्यादुद्यापनं बुधः ।\nपूर्ववत्पूजयेदेवं बहुसंभारवि स्तरैः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002861052, "chapter_id": 22861, "verse_number": "९-१४६-५३", "content_sanskrit": "अनुज्ञां प्रार्थयेद्विप्रान्पापघ्वंसो ममास्तु वै ।\nपापध्वंसोऽस्तु सततं तवेति च द्विजो वदेत् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002861053, "chapter_id": 22861, "verse_number": "९-१४६-५४", "content_sanskrit": "ततः सर्वं ब्राह्मणाय समर्प्य च क्षमापयेत् ।\nअस्मिन्व्रते कृते राजन्भवेद्बहुफलोदयः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002861054, "chapter_id": 22861, "verse_number": "९-१४६-५५", "content_sanskrit": "यत्फलं सर्ववेदेषु सर्वतीर्थेषु यत्फलम् ।\nतत्फलं कोटिगुणितं व्रतस्यास्य निषेवणात् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002861055, "chapter_id": 22861, "verse_number": "९-१४६-५६", "content_sanskrit": "इहलोके धनं धान्यं पुत्रमित्रसुखादिकम् ।\nप्राप्नोति पुरुषः सम्यग्विद्यारोग्यकलायुधम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002861056, "chapter_id": 22861, "verse_number": "९-१४६-५७", "content_sanskrit": "धर्ममथ च कामं च मोक्षं च नृपसत्तम ।\nलभते नात्र संदेहो ब्रह्मणो वचनं यथा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002861057, "chapter_id": 22861, "verse_number": "९-१४६-५८", "content_sanskrit": "यः पठेच्छृणुयाद्वापि सर्वपापैः प्रमुच्यते ।\nयः कुर्यात्पुनरेतद्धि सोऽनन्तफलभाग्भवेत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002861058, "chapter_id": 22861, "verse_number": "९-१४६-५९", "content_sanskrit": "अशक्तस्तु तथा शक्तो वित्तशाठ्यविवर्जितः ।\nव्रतं कुर्वन्नरो भक्त्या लभते शाश्वतं पदम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002861059, "chapter_id": 22861, "verse_number": "९-१४६-६०", "content_sanskrit": "कृते वै क्रियमाणे तु कर्ता फलमवाप्नुयात् ।\nअपराधशताघौघं व्रतेनानेन नाशयेत् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]