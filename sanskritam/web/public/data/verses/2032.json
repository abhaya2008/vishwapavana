[{"id": 2046446, "chapter_id": 2032, "verse_number": "६-८१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2046447, "chapter_id": 2032, "verse_number": "६-८१-१", "content_sanskrit": "अथात्मजं तव पुनर्गाङ्गेयो ध्यानमास्थितम् ।\nअब्रवीद्भरतश्रेष्ठः संप्रहर्षकर वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2046448, "chapter_id": 2032, "verse_number": "६-८१-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2046449, "chapter_id": 2032, "verse_number": "६-८१-२", "content_sanskrit": "अहं द्रोणश्च शल्यश्च कृतवर्मा च सात्वतः।\nअश्वत्थामा विकर्णश्च भगदत्तोऽथ सौबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2046450, "chapter_id": 2032, "verse_number": "६-८१-३", "content_sanskrit": "विन्दानुविन्दावावन्त्यौ बाह्लीकः सह बाह्लिकैः ।\nत्रिगर्तराजो बलवान्मागधश्च सुदुर्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2046451, "chapter_id": 2032, "verse_number": "६-८१-४", "content_sanskrit": "बृहद्बलश्च कौसल्यश्चित्रसेनो विविंशतिः ।\n`कृपश्च सह सोदर्यैस्तव राजन्पदानुगाः।\nरथाश्च बहुसाहस्राः शोभनाश्च महाध्वजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2046452, "chapter_id": 2032, "verse_number": "६-८१-५", "content_sanskrit": "देशजाश्च हया राजन्स्वारूढा हयसादिभिः ।\nगजेन्द्राश्च मदोद्वृत्ताः प्रभिन्नकरटामुखाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2046453, "chapter_id": 2032, "verse_number": "६-८१-६", "content_sanskrit": "पादाताश्च तथा शूरा नानाप्रहरणा युधि।\nनानादेशसमुत्पन्नास्त्वदर्थे योद्धुमुद्यताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2046454, "chapter_id": 2032, "verse_number": "६-८१-७", "content_sanskrit": "एते चान्ये च बहवस्त्वदर्थे त्यक्तजीविताः।\nदेवानपि रणे जेतुं समर्था इति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2046455, "chapter_id": 2032, "verse_number": "६-८१-८", "content_sanskrit": "अवश्यं हि मया राजंस्तव वाच्यं हितं सदा।\nअशक्याः पाण्डवा जेतुं देवैरपि सवासवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2046456, "chapter_id": 2032, "verse_number": "६-८१-९", "content_sanskrit": "वासुदेवसहायाश्च महेन्द्रसमविक्रमाः ।\nसर्वथाऽहं तु राजेन्द्र करिष्ये वचनं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2046457, "chapter_id": 2032, "verse_number": "६-८१-१०", "content_sanskrit": "पाण्डवांश्च रणे जेष्ये मां वा जेष्यन्ति पाण्डवाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2046458, "chapter_id": 2032, "verse_number": "६-८१-१०x", "content_sanskrit": "सञ्जय उवाच।\nएवमुक्त्वा ददावस्मै विशल्यकरणीं शुभाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2046459, "chapter_id": 2032, "verse_number": "६-८१-११", "content_sanskrit": "ओषधीं वीयसंपन्नां विशल्यश्चाभवत्तदा ।\nततः प्रभाते विमले स्वेन सैन्येन वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2046460, "chapter_id": 2032, "verse_number": "६-८१-१२", "content_sanskrit": "अव्यूहत स्वयं व्यूहं भीष्मो व्यूहविशारदः ।\nमण़्डलं मनुजश्रेष्ठो नानाशस्त्रसमाकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2046461, "chapter_id": 2032, "verse_number": "६-८१-१३", "content_sanskrit": "संपूर्णं योधमुख्यैश्च तथा दन्तिपदातिभिः ।\nरथैरनेकसाहस्रैः समन्तत्परिवारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2046462, "chapter_id": 2032, "verse_number": "६-८१-१४", "content_sanskrit": "अश्ववृन्दैर्महद्भिश्च रिष्टितोमरधारिभिः ।\nनागेनागे रथाः सप्त सप्त चाश्वा रथेरथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2046463, "chapter_id": 2032, "verse_number": "६-८१-१५", "content_sanskrit": "अन्वश्वं दश धानुष्का धानुष्के दश चर्मिणः।\nएवं व्यूहं महाराज तव सैन्यस्य दंशितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2046464, "chapter_id": 2032, "verse_number": "६-८१-१६", "content_sanskrit": "स्थितं रणाय महते भीष्मेण युधि पालितम् ।\nदशाश्वानां सहस्राणि दन्तिनां च तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2046465, "chapter_id": 2032, "verse_number": "६-८१-१७", "content_sanskrit": "रथानामयुतं चापि पुत्राश्च तव दंशिताः।\nचित्रसेनादयः शूरा अभ्यरक्षन्तितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2046466, "chapter_id": 2032, "verse_number": "६-८१-१८", "content_sanskrit": "रक्ष्यमाणाः स तैः शूरैर्गोप्यमानाश्च तेन ते।\nसन्नद्धाः समदृश्यन्त राजानश्च महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2046467, "chapter_id": 2032, "verse_number": "६-८१-१९", "content_sanskrit": "दुर्योधनस्तु समरे दंशितो रथमास्थितः ।\nव्यराजत श्रिया जुष्टो यथा शक्रस्त्रिविष्टपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2046468, "chapter_id": 2032, "verse_number": "६-८१-२०", "content_sanskrit": "ततः शब्दो महानासीत्पुत्राणां तव भारत ।\nरथघोषश्च विपुलो वादित्राणां च निःस्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2046469, "chapter_id": 2032, "verse_number": "६-८१-२१", "content_sanskrit": "भीष्मेण धार्तराष्ट्राणां व्यूढः प्रत्यङ्भुखो युधि।\nमण्डलः स महाव्यूहो दुर्भेद्योऽमित्रघातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2046470, "chapter_id": 2032, "verse_number": "६-८१-२२", "content_sanskrit": "सर्वतः शुशुभे राजन्रणेऽरीणां दुरासदः ।\nमण्डलं तु समालोक्य व्यूहं परमदुर्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2046471, "chapter_id": 2032, "verse_number": "६-८१-२३", "content_sanskrit": "स्वयं युधिष्ठिरो राजा वज्रं व्यूहमथाकरोत्।\nतथा व्यूढेष्वनीकेषु यथास्थानमवस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2046472, "chapter_id": 2032, "verse_number": "६-८१-२४", "content_sanskrit": "रथिनः सादिनः सर्वे सिंहनादमथानदन् ।\nबिभित्सवस्ततो व्यूहं निर्ययुर्युद्धकाङ्क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2046473, "chapter_id": 2032, "verse_number": "६-८१-२५", "content_sanskrit": "इतरेतरतः शूराः सहसैन्याः प्रहारिणः ।\nभारद्वाजो ययौ मत्स्यं द्रौणिश्चापि सिखण्डिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2046474, "chapter_id": 2032, "verse_number": "६-८१-२६", "content_sanskrit": "स्वयं दुर्योधनो राजा पार्षतं समुपाद्रवत् ।\nनकुलः सहदेवश्च मद्रराजानमीयतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2046475, "chapter_id": 2032, "verse_number": "६-८१-२७", "content_sanskrit": "विन्दानुविन्दावावन्त्यौ युयुधानमभिद्रुतौ ।\nसर्वे नृपास्तु समरे धनंजयमयोधयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2046476, "chapter_id": 2032, "verse_number": "६-८१-२८", "content_sanskrit": "भीमसेनो रणे यान्तं हार्दिक्यं समवारयत्।\nचित्रसेनं विकर्णं च तथा दुर्मर्षणं विभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2046477, "chapter_id": 2032, "verse_number": "६-८१-२९", "content_sanskrit": "आर्जुनिः समरे राजंस्तव मुत्रानयोधयत् ।\nप्राग्ज्योतिषो महेष्वासो हैडिम्बं राक्षसोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2046478, "chapter_id": 2032, "verse_number": "६-८१-३०", "content_sanskrit": "अभिदुद्राव वेगेन मत्तो मत्तमिव द्विपम् ।\nअलम्बुसस्तदा राजन्सात्यकिं युद्धदुर्मदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2046479, "chapter_id": 2032, "verse_number": "६-८१-३१", "content_sanskrit": "ससैन्यं समरे क्रुद्धो राक्षसः समुपाद्रवत्।\nभूरिश्रवा रणे यत्तो धृष्टकेतुमयोधयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2046480, "chapter_id": 2032, "verse_number": "६-८१-३२", "content_sanskrit": "श्रुतायुषं च राजानं धर्मपुत्रो युधिष्ठिरः ।\nचेकितानश्च समरे कृपमेवान्वयोधयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2046481, "chapter_id": 2032, "verse_number": "६-८१-३३", "content_sanskrit": "शेषाः प्रतिययुर्यत्ता भीष्ममेव महारथम् ।\nततो राजसमूहास्ते परिवव्रुर्धनंजयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2046482, "chapter_id": 2032, "verse_number": "६-८१-३४", "content_sanskrit": "शक्तितोमरनाराचगदापरिघपाणयः।\nअर्जुनोऽथ भृशं क्रुद्धो वार्ष्णेयमिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2046483, "chapter_id": 2032, "verse_number": "६-८१-३५", "content_sanskrit": "पश्य माधव सैन्यानि धार्तराष्ट्रस्य संयुगे।\nव्यूढानि व्यूहविदुषा गाङ्गेयेन महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2046484, "chapter_id": 2032, "verse_number": "६-८१-३६", "content_sanskrit": "युद्धाभिकामाञ्शूरांश्च पश्य माधव दंशितान् ।\nत्रिगर्तराजं सहितं भ्रातृभिः पश्य केशव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2046485, "chapter_id": 2032, "verse_number": "६-८१-३७", "content_sanskrit": "अद्यैतान्नाशयिष्यामि पश्यतस्ते जनार्दन ।\nय इमे मां यदुश्रेष्ठ योद्धुकामा रणाजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2046486, "chapter_id": 2032, "verse_number": "६-८१-३८", "content_sanskrit": "एतदुक्त्वा तु कौन्तेयो धनुर्ज्यामवमृद्य च ।\nववर्ष शरवर्षाणि नराधिपगणान्प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2046487, "chapter_id": 2032, "verse_number": "६-८१-३९", "content_sanskrit": "तेऽपि तं परमेष्वासाः शरवर्षैरपूरयन् ।\nतटाकं वारिधाराभिर्यथा प्रावृषि तोयदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2046488, "chapter_id": 2032, "verse_number": "६-८१-४०", "content_sanskrit": "हाहाकारो महानासीत्तव सैन्ये विशांपते ।\nछाद्ममानौ रणे कृष्णौ शरैर्दृष्ट्वा महारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2046489, "chapter_id": 2032, "verse_number": "६-८१-४१", "content_sanskrit": "देवा देवर्षयश्चैव गन्धर्वाश्च सहोरगैः ।\nविस्मयं परमं जग्मुर्दृष्ट्वा कृष्णौ तथाऽऽगतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2046490, "chapter_id": 2032, "verse_number": "६-८१-४२", "content_sanskrit": "ततः क्रुद्धोऽर्जुनो राजन्नैन्द्रमस्त्रमुदैरयत् ।\nतत्राद्भुतमपश्याम विजयस्य पराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2046491, "chapter_id": 2032, "verse_number": "६-८१-४३", "content_sanskrit": "शस्त्रवृष्टिं परैर्मुक्तां शरौघैर्यदवारयत् ।\nन च तत्राप्यनिर्भिन्नः कश्चिदासीद्विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2046492, "chapter_id": 2032, "verse_number": "६-८१-४४", "content_sanskrit": "तेषां राजसहस्राणां हयानां दन्तिनां तथा।\nद्वाभ्यां त्रिभिः शरैश्चान्यान्पार्थो विव्याध मारिष ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2046493, "chapter_id": 2032, "verse_number": "६-८१-४५", "content_sanskrit": "ते हन्यमानाः पार्थेन भीष्मं शान्तनवं ययुः ।\nअगाधे मञ्जमानानां भीष्मः पोतोऽभवत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2046494, "chapter_id": 2032, "verse_number": "६-८१-४६", "content_sanskrit": "आपतद्भिस्तु तैस्तत्र प्रभग्नं तावकं बलम् ।\nसंचुक्षुभे महाराज वातैरिव महार्णवः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2046495, "chapter_id": 2032, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि सप्तमदिवसयुद्धे एकाशीतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]