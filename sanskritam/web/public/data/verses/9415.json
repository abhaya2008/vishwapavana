[{"id": 5000415000, "chapter_id": 9415, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे अष्टमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000415001, "chapter_id": 9415, "verse_number": "६-८-१", "content_sanskrit": "ततो नीलाम्बुदप्रख्यः प्रहस्तो नाम राक्षसः।\nअब्रवीत् प्राञ्जलिर्वाक्यं शूरः सेनापतिस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000415002, "chapter_id": 9415, "verse_number": "६-८-२", "content_sanskrit": "देवदानवगन्धर्वाः पिशाचपतगोरगाः।\nसर्वे धर्षयितुं शक्याः किं पुनर्मानवौ रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000415003, "chapter_id": 9415, "verse_number": "६-८-३", "content_sanskrit": "सर्वे प्रमत्ता विश्वस्ता वञ्चिताः स्म हनूमता।\nनहि मे जीवतो गच्छेज्जीवन् स वनगोचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000415004, "chapter_id": 9415, "verse_number": "६-८-४", "content_sanskrit": "सर्वां सागरपर्यन्तां सशैलवनकाननाम्।\nकरोम्यवानरां भूमिमाज्ञापयतु मां भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000415005, "chapter_id": 9415, "verse_number": "६-८-५", "content_sanskrit": "रक्षां चैव विधास्यामि वानराद् रजनीचर।\nनागमिष्यति ते दुःखं किंचिदात्मापराधजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000415006, "chapter_id": 9415, "verse_number": "६-८-६", "content_sanskrit": "अब्रवीत् तु सुसंक्रुद्धो दुर्मुखो नाम राक्षसः।\nइदं न क्षमणीयं हि सर्वेषां नः प्रधर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000415007, "chapter_id": 9415, "verse_number": "६-८-७", "content_sanskrit": "अयं परिभवो भूयः पुरस्यान्तःपुरस्य च।\nश्रीमतो राक्षसेन्द्रस्य वानरेण प्रधर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000415008, "chapter_id": 9415, "verse_number": "६-८-८", "content_sanskrit": "अस्मिन् मुहूर्ते गत्वैको निवर्तिष्यामि वानरान्।\nप्रविष्टान् सागरं भीममम्बरं वा रसातलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000415009, "chapter_id": 9415, "verse_number": "६-८-९", "content_sanskrit": "ततोऽब्रवीत् सुसंक्रुद्धो वज्रदंष्ट्रो महाबलः।\nप्रगृह्य परिघं घोरं मांसशोणितरूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000415010, "chapter_id": 9415, "verse_number": "६-८-१०", "content_sanskrit": "किं नो हनूमता कार्यं कृपणेन तपस्विना।\nरामे तिष्ठति दुर्धर्षे सुग्रीवेऽपि सलक्ष्मणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000415011, "chapter_id": 9415, "verse_number": "६-८-११", "content_sanskrit": "अद्य रामं ससुग्रीवं परिघेण सलक्ष्मणम्।\nआगमिष्यामि हत्वैको विक्षोभ्य हरिवाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000415012, "chapter_id": 9415, "verse_number": "६-८-१२", "content_sanskrit": "इदं ममापरं वाक्यं शृणु राजन् यदिच्छसि।\nउपायकुशलो ह्येव जयेच्छत्रूनतन्द्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000415013, "chapter_id": 9415, "verse_number": "६-८-१३", "content_sanskrit": "कामरूपधराः शूराः सुभीमा भीमदर्शनाः।\nराक्षसा वा सहस्राणि राक्षसाधिप निश्चिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000415014, "chapter_id": 9415, "verse_number": "६-८-१४", "content_sanskrit": "काकुत्स्थमुपसंगम्य बिभ्रतो मानुषं वपुः।\nसर्वे ह्यसम्भ्रमा भूत्वा ब्रुवन्तु रघुसत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000415015, "chapter_id": 9415, "verse_number": "६-८-१५", "content_sanskrit": "प्रेषिता भरतेनैव भ्रात्रा तव यवीयसा।\nस हि सेनां समुत्थाप्य क्षिप्रमेवोपयास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000415016, "chapter_id": 9415, "verse_number": "६-८-१६", "content_sanskrit": "ततो वयमितस्तूर्णं शूलशक्तिगदाधराः।\nचापबाणासिहस्ताश्च त्वरितास्तत्र यामहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000415017, "chapter_id": 9415, "verse_number": "६-८-१७", "content_sanskrit": "आकाशे गणशः स्थित्वा हत्वा तां हरिवाहिनीम्।\nअश्मशस्त्रमहावृष्ट्या प्रापयाम यमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000415018, "chapter_id": 9415, "verse_number": "६-८-१८", "content_sanskrit": "एवं चेदुपसर्पेतामनयं रामलक्ष्मणौ।\nअवश्यमपनीतेन जहतामेव जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000415019, "chapter_id": 9415, "verse_number": "६-८-१९", "content_sanskrit": "कौम्भकर्णिस्ततो वीरो निकुम्भो नाम वीर्यवान्।\nअब्रवीत् परमक्रुद्धो रावणं लोकरावणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000415020, "chapter_id": 9415, "verse_number": "६-८-२०", "content_sanskrit": "सर्वे भवन्तस्तिष्ठन्तु महाराजेन संगताः।\nअहमेको हनिष्यामि राघवं सहलक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000415021, "chapter_id": 9415, "verse_number": "६-८-२१", "content_sanskrit": "सुग्रीवं सहनूमन्तं सर्वांश्चैवात्र वानरान्।\nततो वज्रहनुर्नाम राक्षसः पर्वतोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000415022, "chapter_id": 9415, "verse_number": "६-८-२२", "content_sanskrit": "क्रुद्धः परिलिहन् सृक्कां जिह्वया वाक्यमब्रवीत्।\nस्वैरं कुर्वन्तु कार्याणि भवन्तो विगतज्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000415023, "chapter_id": 9415, "verse_number": "६-८-२३", "content_sanskrit": "एकोऽहं भक्षयिष्यामि तां सर्वां हरिवाहिनीम्।\nस्वस्थाः क्रीडन्तु निश्चिन्ताः पिबन्तु मधु वारुणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000415024, "chapter_id": 9415, "verse_number": "६-८-२४", "content_sanskrit": "अहमेको वधिष्यामि सुग्रीवं सहलक्ष्मणम्।\nसाङ्गदं च हनूमन्तं सर्वांश्चैवात्र वानरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000415025, "chapter_id": 9415, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे अष्टमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]