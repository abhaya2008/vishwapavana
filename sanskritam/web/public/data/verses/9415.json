[{"id": 40022927, "chapter_id": 9415, "verse_number": "1", "content_sanskrit": "तस्यां रजन्यां व्युष्टायां यज्ञवाटगतो नृपः । ऋषीन्सर्वान्महातेजाः शब्दापयति राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40022928, "chapter_id": 9415, "verse_number": "2", "content_sanskrit": "वसिष्ठो वामदेवश्च जाबालिरथ काश्यपः । विश्वामित्रो दीर्घतपा दुर्वासाश्च महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40022929, "chapter_id": 9415, "verse_number": "3", "content_sanskrit": "पुलस्त्यो ऽपि तथा शक्तिर्भार्गवश्चैव वामनः । मार्कण्डेयश्च दीर्घायुर्मौद्गल्यश्च महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40022930, "chapter_id": 9415, "verse_number": "4", "content_sanskrit": "गर्गश्च च्यवनश्चैव शतानन्दश्च धर्मवित् । भरद्वाजश्च तेजस्वी ह्यग्निपुत्रश्च सुप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40022931, "chapter_id": 9415, "verse_number": "5", "content_sanskrit": "नारदः पर्वतश्चैव गौतमश्च महायशाः । कात्यायनः सुयज्ञश्च ह्यगस्त्यस्तपसां निधिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40022932, "chapter_id": 9415, "verse_number": "6", "content_sanskrit": "एते चान्ये च बहवो मुनयः संशितव्रताः । कौतूहलसमाविष्टाः सर्व एव समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40022933, "chapter_id": 9415, "verse_number": "7", "content_sanskrit": "राक्षसाश्च महावीर्या वानराश्च महाबलाः । सर्व एव समाजग्मुर्महात्मानः कुतूहलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40022934, "chapter_id": 9415, "verse_number": "8", "content_sanskrit": "क्षत्रिया ये च शूद्राश्च वैश्याश्चैव सहस्रशः । नानादेशगताश्चैव ब्राह्मणाः संशितव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40022935, "chapter_id": 9415, "verse_number": "9", "content_sanskrit": "ज्ञाननिष्ठाः कर्मनिष्ठाः योगनिष्ठास्तथापरे । सीताशपथवीक्षार्थं सर्व एव समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40022936, "chapter_id": 9415, "verse_number": "10", "content_sanskrit": "तदा समागतं सर्वमश्मभूतमिवाचलम् । श्रुत्वा मुनिवरस्तूर्णं ससीतः समुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40022937, "chapter_id": 9415, "verse_number": "11", "content_sanskrit": "तमृषिं पृष्ठतः सीता त्वन्वगच्छदवाङ्मुखी । कृताञ्जलिर्बाष्पगला कृत्वा रामं मनोगतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40022938, "chapter_id": 9415, "verse_number": "12", "content_sanskrit": "दृष्ट्वा श्रुतिमिवायान्तीं ब्रह्माणमनुगामिनीम् । वाल्मीकेः पृष्ठतः सीतां साधुवादो महानभूत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40022939, "chapter_id": 9415, "verse_number": "13", "content_sanskrit": "ततो हलहलाशब्दः सर्वेषामेवमाबभौ । दुःखजन्मविशालेन शोकेनाकुलितात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40022940, "chapter_id": 9415, "verse_number": "14", "content_sanskrit": "साधु रामेति केचित्तु साधु सीतेति चापरे । उभावेव च तत्रान्ये प्रेक्षकाः सम्प्रचुक्रुशुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40022941, "chapter_id": 9415, "verse_number": "15", "content_sanskrit": "ततो मध्ये जनौघस्य प्रविश्य मुनिपुङ्गवः । सीतासहायो वाल्मीकिरिति होवाच राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40022942, "chapter_id": 9415, "verse_number": "16", "content_sanskrit": "इयं दाशरथे सीता सुव्रता धर्मचारिणी । अपवादैः परित्यक्ता ममाश्रमसमीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40022943, "chapter_id": 9415, "verse_number": "17", "content_sanskrit": "लोकापवादभीतस्य तव राम महाव्रत । प्रत्ययं दास्यते सीता तदनुज्ञातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40022944, "chapter_id": 9415, "verse_number": "18", "content_sanskrit": "इमौ तु जानकीपुत्रावुभौ च यमजातकौ । सुतौ तवैव दुर्धर्षौ सत्यमेतद्ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40022945, "chapter_id": 9415, "verse_number": "19", "content_sanskrit": "प्रचेतसो ऽहं दशमः पुत्रो राघवनन्दन । न स्मराम्यनृतं वाक्यमिमौ तु तव पुत्रकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40022946, "chapter_id": 9415, "verse_number": "20", "content_sanskrit": "बहुवर्षसहस्राणि तपश्चर्या मया कृता । नोपाश्नीयां फलं तस्या दुष्टेयं यदि मैथिली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40022947, "chapter_id": 9415, "verse_number": "21", "content_sanskrit": "मनसा कर्मणा वाचा भूतपूर्वं न किल्बिषम् । तस्याः फलमुपाश्नीयामपापा मैथिली यदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40022948, "chapter_id": 9415, "verse_number": "22", "content_sanskrit": "अहं पञ्चसु भूतेषु मनष्षष्ठेषु राघव । विचिन्त्य सीतां शुद्धेति जग्राह वननिर्झरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40022949, "chapter_id": 9415, "verse_number": "23", "content_sanskrit": "इयं शुद्धसमाचारा अपापा पतिदेवता । लोकापवादभीतस्य प्रत्ययं तव दास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40022950, "chapter_id": 9415, "verse_number": "24", "content_sanskrit": "तस्मादियं नरवरात्मज शुद्धभावा दिव्येन दृष्टिविषयेण तदा प्रविष्टा । लोकापवादकलुषीकृतचेतसा या त्यक्ता त्वया प्रियतमा विदिता ऽपि शुद्धा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]