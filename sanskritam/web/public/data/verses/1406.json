[{"id": 2019494, "chapter_id": 1406, "verse_number": "३-४४-०x", "content_sanskrit": "वैसंपायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2019495, "chapter_id": 1406, "verse_number": "३-४४-१", "content_sanskrit": "कदाचित्स हि देवेन्द्रश्चित्रसेनं रहोऽब्रवीत्।\nपार्थस्य चक्षुरुर्वश्यां सक्तं विज्ञाय वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2019496, "chapter_id": 1406, "verse_number": "३-४४-२", "content_sanskrit": "गन्धर्वराज गच्छाद्य प्रहितोऽप्सरसांवराम्।\nउर्वशीं पुरुषव्याघ्रं सोपातिष्ठतु फल्गुनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2019497, "chapter_id": 1406, "verse_number": "३-४४-३", "content_sanskrit": "यथा न तामभिसृतां विद्यादस्मन्नियोगतः।\nतथा त्वया विधातव्यं स्त्रीसंसर्गविशारद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2019498, "chapter_id": 1406, "verse_number": "३-४४-४", "content_sanskrit": "एवमुक्तस्तथेत्युक्त्वा सोऽनुज्ञां प्राप्य वासवात्।\nगन्धर्वराजोऽप्सरसमभ्यगादुर्वशीं वराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2019499, "chapter_id": 1406, "verse_number": "३-४४-५", "content_sanskrit": "तां दृष्ट्वा विदितो हृष्टः स्वागतेनार्चितस्तया।\nसुखासीनः सुखासीनां स्मितपूर्वं वचोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2019500, "chapter_id": 1406, "verse_number": "३-४४-६", "content_sanskrit": "विदितं तेऽस्तु सुश्रोणि प्रेषितोऽहमिहागतः।\nत्रिदिवस्यैकराजेन त्वत्प्रसादाभिनन्दिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2019501, "chapter_id": 1406, "verse_number": "३-४४-७", "content_sanskrit": "यः स देवमनुष्येषु प्रख्यातः सहजैर्गुणैः।\nश्रिया शीलेन रूपेण श्रुतेन च बलेन च।\nप्रख्यातः शौर्यवीर्याभ्यां प्रपन्नः प्रतिभानवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2019502, "chapter_id": 1406, "verse_number": "३-४४-८", "content_sanskrit": "तेजस्वी सौम्यीलश्च क्षमावाञ्जितमत्सरः।\nसाङ्गोपनिषदान्वेदांश्चतुराख्यानपञ्चमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2019503, "chapter_id": 1406, "verse_number": "३-४४-९", "content_sanskrit": "योऽधीते गुरुशुश्रूषां मेधां चाष्टगुणाश्रयाम्।\nब्रह्मचर्येण दाक्ष्येण प्रसवैर्वयसाऽपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2019504, "chapter_id": 1406, "verse_number": "३-४४-१०", "content_sanskrit": "एको वै रक्षिता चैव त्रिदिवं मघवानिव।\nअकत्थनो मानयिता स्थूललक्ष्यः प्रियंवदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2019505, "chapter_id": 1406, "verse_number": "३-४४-११", "content_sanskrit": "सुहृदश्चान्नपानेन विविधेनाभिवर्षति।\nसत्यवागूर्जितो वक्ता रूपवाननहंकृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2019506, "chapter_id": 1406, "verse_number": "३-४४-१२", "content_sanskrit": "भक्तानुकम्पी कान्तश्च प्रियश्च स्थिरसंगरः।\nप्रार्थनीयैर्गुणगणैर्महेन्द्रवरुणोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2019507, "chapter_id": 1406, "verse_number": "३-४४-१३", "content_sanskrit": "विदितस्तेऽर्जुनो वीरः स स्वर्गफलमाप्तवान्।\nतव शक्राभ्यनुज्ञातः पादावद्यप्रपद्यताम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2019508, "chapter_id": 1406, "verse_number": "३-४४-१४", "content_sanskrit": "एवमुक्ता स्मितं कृत्वा स्वात्मानं बहुमान्य च।\nप्रत्युवाचोर्वशी प्रीता चित्रसेनमनिन्दिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2019509, "chapter_id": 1406, "verse_number": "३-४४-१५", "content_sanskrit": "यत्त्वस्य कथितः सत्यो गुणोद्देशस्त्वयाऽनघ।\nतं श्रुत्वाऽन्यं प्रियं नारी वृणुयात्किमतोऽर्जुनं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2019510, "chapter_id": 1406, "verse_number": "३-४४-१६", "content_sanskrit": "तस्य चाहं गुणौघेन फल्गुने जातमन्मथा।\nगच्छत्वं हि याथाकाममागमिष्याम्यहं सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2019511, "chapter_id": 1406, "verse_number": "३-४४-१७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2019512, "chapter_id": 1406, "verse_number": "३-४४-१७", "content_sanskrit": "ततो विसृज्यगन्धर्वं कृतकृत्या शुचिस्मिता।\nउर्वशी चाकरोत्स्नानं पार्थप्रार्थनलालसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2019513, "chapter_id": 1406, "verse_number": "३-४४-१८", "content_sanskrit": "स्नानालङ्कारनेपथ्यैर्गन्धमाल्यैश्च शौभनैः।\nधनंजयस्य रूपेण शरैर्मन्मथचोदितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2019514, "chapter_id": 1406, "verse_number": "३-४४-१९", "content_sanskrit": "अतिविद्धेन मनसा मन्मथेन प्रदीपिता।\nदिव्यास्तरणसंस्तीर्णे विस्तीर्णे शयनोत्तमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2019515, "chapter_id": 1406, "verse_number": "३-४४-२०", "content_sanskrit": "चित्तसंकल्पभावेन सुचित्ताऽनन्यमानसा।\nमनोरथेन संप्राप्तं रमयन्तीव फल्गुनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2019516, "chapter_id": 1406, "verse_number": "३-४४-२१", "content_sanskrit": "निशाम्य चन्द्रोदयनं विगाढे रजनीमुखे।\nप्रस्थिता सा पृथुश्रोणी पार्थस्य भवनं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2019517, "chapter_id": 1406, "verse_number": "३-४४-२२", "content_sanskrit": "मृदुकुञ्चितदीर्घेण कुसुमोत्तमधारिणा।\nकेशपाशेन ललना गच्छमाना व्यराजत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2019518, "chapter_id": 1406, "verse_number": "३-४४-२३", "content_sanskrit": "भ्रूक्षेपालापमाधुर्यैः कान्त्या सौम्यतयाऽपि च।\nशशिनं वक्रचन्द्रेण साऽऽह्वयन्तीव गच्छती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2019519, "chapter_id": 1406, "verse_number": "३-४४-२४", "content_sanskrit": "दिव्याङ्गरागौ सुमुखौ दिव्यचन्दनरूषितौ।\nगच्छन्त्या हाररुचिरौ स्तनौ तस्या ववल्गतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2019520, "chapter_id": 1406, "verse_number": "३-४४-२५", "content_sanskrit": "स्तनोद्वहनसंक्षोभात्ताम्यमाना पदेपदे।\nत्रिवलीदामचित्रेण मध्येनातीव शेभिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2019521, "chapter_id": 1406, "verse_number": "३-४४-२६", "content_sanskrit": "रथकूबरविस्तीर्णं नितम्बोन्नतपीवरम्।\nमन्मथायतनं शुभ्रं रशनादामभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2019522, "chapter_id": 1406, "verse_number": "३-४४-२७", "content_sanskrit": "ऋषीणामपि दिव्यानां मनोव्याघातकारणम्।\nसूक्ष्मवस्त्रधरं भाति जघनं निरवद्यवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2019523, "chapter_id": 1406, "verse_number": "३-४४-२८", "content_sanskrit": "गूडगुल्फधरौ पादौ ताम्रायततलाङ्गुली।\nकूर्मपृष्ठोन्तौ चास्याः शोभेते किङ्किणीकिणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2019524, "chapter_id": 1406, "verse_number": "३-४४-२९", "content_sanskrit": "शीधुपानेन चाल्पेन तुष्टा च मदनेन च।\nविलासितैश्च विविधैः प्रेक्षणीयतराऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2019525, "chapter_id": 1406, "verse_number": "३-४४-३०", "content_sanskrit": "सिद्धचारणगन्धर्वैः साध्यैर्याति विलासिनी।\nबब्वाश्चर्येऽपि वै स्वर्गे दर्शनीयतमाकृतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2019526, "chapter_id": 1406, "verse_number": "३-४४-३१", "content_sanskrit": "सुमूक्ष्मेणोत्तरीयेण मेघवर्णेन राजता।\nतन्वभ्रप्रावृता व्योम्नि चन्द्रलेखेन गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2019527, "chapter_id": 1406, "verse_number": "३-४४-३२", "content_sanskrit": "ततः प्राप्तातिदुष्प्रापा मनसाऽपि विकर्मभिः।\nभवनं पाण्डुपुत्रस्य फल्गुनस्य शुचिस्मिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2019528, "chapter_id": 1406, "verse_number": "३-४४-३३", "content_sanskrit": "तत्र द्वारमनुप्राप्ता द्वारस्थैश्च निवेदिता।\nअर्जुनस्य नरश्रेष्ठ उर्वशी शुभलोचना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2019529, "chapter_id": 1406, "verse_number": "३-४४-३४", "content_sanskrit": "उपातिष्ठत तद्वेश्म निर्मलं सुमनोहरम्।\nस शङ्कितमना राजन्प्रत्यगच्छत तां निशि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2019530, "chapter_id": 1406, "verse_number": "३-४४-३५", "content_sanskrit": "दृष्ट्वैव चोर्वशीं पार्थो लज्जासंवृलोचनः।\nतदाऽभिवादनं कृत्वा गुरुपूजां प्रयुक्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2019531, "chapter_id": 1406, "verse_number": "३-४४-३६x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2019532, "chapter_id": 1406, "verse_number": "३-४४-३६", "content_sanskrit": "अभिवादये त्वां शिरसा प्रवराप्सरसांवरे।\nकिं चागमनकृत्यं ते ब्रूहि सर्वं यथातथम्।\nकिमाज्ञापयसे देवि प्रेष्यस्तेऽहमुपस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2019533, "chapter_id": 1406, "verse_number": "३-४४-३७", "content_sanskrit": "अकामं फल्गुनं ज्ञात्वा इङ्गितज्ञा तदोर्वशी।\nगन्धर्ववचनं सर्वं श्रावयामास फल्गुनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2019534, "chapter_id": 1406, "verse_number": "३-४४-३८x", "content_sanskrit": "उर्वश्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2019535, "chapter_id": 1406, "verse_number": "३-४४-३८", "content_sanskrit": "यथा मे चित्रसेनेन कथितं मनुजोत्तम।\nनत्तेऽहं संप्रवक्ष्यामि यथा चाहमिहागता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2019536, "chapter_id": 1406, "verse_number": "३-४४-३९", "content_sanskrit": "उपस्ताने महेन्द्रस् वर्तमाने मनोरमे।\nतवागमनतुष्ट्या च स्वर्गस्य परमोत्सवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2019537, "chapter_id": 1406, "verse_number": "३-४४-४०", "content_sanskrit": "रुद्राणां चैव सान्निध्यमादित्यानां च सर्वशः।\nसमागमेऽश्विनोश्चैव वसूनां च नरोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2019538, "chapter_id": 1406, "verse_number": "३-४४-४१", "content_sanskrit": "महर्षीणां च सङ्घेषु राजर्षिप्रवरेषु च।\nसिद्धचारणयक्षेषु महोरगगणेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2019539, "chapter_id": 1406, "verse_number": "३-४४-४२", "content_sanskrit": "उपविष्टेषु सर्वेषु स्थानमानप्रभावतः।\nऋद्ध्या प्रज्वलमानेषु अग्निसोमार्कवर्ष्मसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2019540, "chapter_id": 1406, "verse_number": "३-४४-४३", "content_sanskrit": "वीणासु वाद्यमानासु गन्धर्वैः शक्रनन्दन।\nदिव्ये मनोरमे गीते प्रवृत्ते पृथुलोचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2019541, "chapter_id": 1406, "verse_number": "३-४४-४४", "content_sanskrit": "सर्वाप्सरःसु मुख्यासु प्रनृत्तासु कुरूद्वह।\nत्वं किलानिमिषः पार्थ मामेकां तत्र दृष्टवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2019542, "chapter_id": 1406, "verse_number": "३-४४-४५", "content_sanskrit": "तत्र चावभृथे तस्मिन्नुपस्थाने दिवौकसाम्।\nतव पित्राऽभ्यनुज्ञाता गताः स्वनिलयान्सुराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2019543, "chapter_id": 1406, "verse_number": "३-४४-४६", "content_sanskrit": "तथैवाप्सरसः सर्वाविशिष्टाः स्वगृहं गताः।\nअपि चान्याश्च शत्रुघ्न तव पित्रा विसर्जिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2019544, "chapter_id": 1406, "verse_number": "३-४४-४७", "content_sanskrit": "ततः शक्रेण संदिष्टश्चित्रसेनो ममान्तिकम्।\nप्राप्तः कमलपत्राक्ष स च मामब्रवीत्स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2019545, "chapter_id": 1406, "verse_number": "३-४४-४८", "content_sanskrit": "त्वत्कृतेऽहं सुरेशेन प्रेषितो वरवर्णिनि।\nप्रियं कुरु महेन्द्रस्य मम चैवात्मनश्च ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2019546, "chapter_id": 1406, "verse_number": "३-४४-४९", "content_sanskrit": "शक्रतुल्यं रणे शूरं रूपौदार्यगुणान्वितम्।\nपार्थं प्रार्थय सुश्रोणि त्वमित्येवं तदाऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2019547, "chapter_id": 1406, "verse_number": "३-४४-५०", "content_sanskrit": "ततोऽहं समनुज्ञाता तेन पित्रा च तेऽनघ।\nतवान्तिकमनुप्राप्ता शुश्रूषितुमरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2019548, "chapter_id": 1406, "verse_number": "३-४४-५१", "content_sanskrit": "न केवलं हि चक्रेण प्रेषिता चाहमागता।\nचिराभिलषितो वीर ममाप्येष मनोरथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2019549, "chapter_id": 1406, "verse_number": "३-४४-५२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2019550, "chapter_id": 1406, "verse_number": "३-४४-५२", "content_sanskrit": "तां तथा ब्रुवतीं श्रुत्वा भृशं लज्जान्वितोऽर्जुनः।\nउवाच कर्णौ हस्ताभ्यां पिधाय त्रिदशोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2019551, "chapter_id": 1406, "verse_number": "३-४४-५३", "content_sanskrit": "दुःश्रुतं मेऽस्तु सुभगे यन्मां वदसि भामिनि।\nगुरुदारैः समाना मे निश्चयेन वरानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2019552, "chapter_id": 1406, "verse_number": "३-४४-५४", "content_sanskrit": "[यथा कुन्तीमहाभागा यथेन्राणी शची मम।\nतथा त्वमपि कल्याणीनात्र कार्या विचारणा]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2019553, "chapter_id": 1406, "verse_number": "३-४४-५५", "content_sanskrit": "यच्चेक्षिताऽसि विस्पष्टं विशेषेण मया शुभे।\nतच्च मे कारणं सर्वं शृणु सत्येन सुस्मिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2019554, "chapter_id": 1406, "verse_number": "३-४४-५६", "content_sanskrit": "इयं पौरववंशस् जननी सुदतीति ह।\nत्वामहं दृष्टवांस्तत्र विस्मयोत्फुल्ललोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2019555, "chapter_id": 1406, "verse_number": "३-४४-५७", "content_sanskrit": "न मामर्हसि कल्याणि अन्यथा ध्यात्रमप्सरः।\nगुरोर्गरुतरा मे त्वं मम त्वं वंशवर्धिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2019556, "chapter_id": 1406, "verse_number": "३-४४-५८x", "content_sanskrit": "उर्वश्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2019557, "chapter_id": 1406, "verse_number": "३-४४-५८", "content_sanskrit": "अनावृताश्च सर्वाः स्म देवराजाभिनन्दन।\nगुरुस्थाने न मां वीर नियोक्तुं त्वमिहार्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2019558, "chapter_id": 1406, "verse_number": "३-४४-५९", "content_sanskrit": "पितरः सोदराः पुत्रा नप्तारो वा त्विहागताः।\nतपसा रमयन्त्यस्मान्न च तेषां व्यतिक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2019559, "chapter_id": 1406, "verse_number": "३-४४-६०", "content_sanskrit": "तत्प्रसीद न मामार्तां विसर्जयितुमर्हसि।\nहृच्छयेन च संतप्तां भक्तां च भज मानद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2019560, "chapter_id": 1406, "verse_number": "३-४४-६१x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2019561, "chapter_id": 1406, "verse_number": "३-४४-६१", "content_sanskrit": "शृणु सत्यंवरारोहे यत्त्वां वक्ष्याम्यनिन्दिते।\nशृण्वन्तु मे दिशश्चैव विदिशश्च सदेवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2019562, "chapter_id": 1406, "verse_number": "३-४४-६२", "content_sanskrit": "यथा कुन्ती च माद्री च शची चैव समा इह।\nतथा च वंशजननी त्वं हि मेऽद्य गरीयसी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2019563, "chapter_id": 1406, "verse_number": "३-४४-६३", "content_sanskrit": "गच्छ मूर्ध्ना प्रपन्नोस्मि पादौ ते वरवर्णिनि।\nत्वं हि मे मातृवत्पूज्या रक्ष्योऽहं पुत्रवत्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2019564, "chapter_id": 1406, "verse_number": "३-४४-६४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2019565, "chapter_id": 1406, "verse_number": "३-४४-६४", "content_sanskrit": "ततोऽवधूता पार्थेन उर्वशी क्रोधमूर्च्छिता।\nवेपन्ती भ्रुकुटीकक्रा शशापाथ धनंजयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2019566, "chapter_id": 1406, "verse_number": "३-४४-६५x", "content_sanskrit": "उर्वश्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2019567, "chapter_id": 1406, "verse_number": "३-४४-६५", "content_sanskrit": "तव पित्राऽभ्यनुज्ञातां स्वयं च गृहमागताम्।\nयस्मान्मां नाभिनन्देथाः कामबाणवशंगताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2019568, "chapter_id": 1406, "verse_number": "३-४४-६६", "content_sanskrit": "तस्मात्त्वं नर्तकः पार्थ स्त्रीमध्ये मानवर्जितः।\nअपुंस्त्वेन च विख्यातः पण्ढवद्विचरिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2019569, "chapter_id": 1406, "verse_number": "३-४४-६७", "content_sanskrit": "एवं दत्त्वाऽर्जुने शापं स्फुरितोष्ठी श्वसन्त्यथ।\nपुनः प्रत्यागता क्षिप्रमुर्वशी स्वं निवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2019570, "chapter_id": 1406, "verse_number": "३-४४-६८", "content_sanskrit": "पार्थोपि लब्ध्वा शापं तं तां निशां दुःखितोऽवसम्।\nविवक्षुश्चित्रसेनाय प्रातः सर्वमहृष्टवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2019571, "chapter_id": 1406, "verse_number": "३-४४-६९", "content_sanskrit": "ततः प्रभाते विमले गन्धर्वाय यथातथम्।\nनिवेदयामास तदा चित्रसेनाय पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2019572, "chapter_id": 1406, "verse_number": "३-४४-७०", "content_sanskrit": "तच्च सर्वं यथावृत्तं शापं चैव यथातथम्।\nअवेदयच्च शक्रस्य चित्रसेनोऽपि सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2019573, "chapter_id": 1406, "verse_number": "३-४४-७१", "content_sanskrit": "तदा त्वानाय्य तनयं विविक्ते हरिवाहनः।\nसान्त्वयित्वा शुभैर्वाक्यैः स्मयमानोऽभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2019574, "chapter_id": 1406, "verse_number": "३-४४-७२", "content_sanskrit": "सुपुत्राद्यपृथा तात त्वया पुत्रेण सत्तम।\nऋषयोपि हि धैर्येण जिता वै ते महाभुज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2019575, "chapter_id": 1406, "verse_number": "३-४४-७३", "content_sanskrit": "यं च दत्तवती शापमुर्वशी तव मानद।\nस चापि तेऽर्थकृत्तात साधकश्च भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2019576, "chapter_id": 1406, "verse_number": "३-४४-७४", "content_sanskrit": "अज्ञातवासो वस्तव्यो भवद्भिर्भूतलेऽनघ।\nवर्पे त्रयोदशे वीर तत्र त्वं गमयिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2019577, "chapter_id": 1406, "verse_number": "३-४४-७५", "content_sanskrit": "तेन नर्तकवेपेण अपुंस्त्वेन तथैव च।\nवर्षमेकं विहृत्यैव ततः पुंस्त्वमवाप्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2019578, "chapter_id": 1406, "verse_number": "३-४४-७६", "content_sanskrit": "एवमुक्तस्तु शक्रेण फल्गुनः परवीरहा।\nमुदं परमिकां लेभे न च शापं व्यचिन्तयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2019579, "chapter_id": 1406, "verse_number": "३-४४-७७", "content_sanskrit": "चित्रसेनेन सहितो गन्धर्वेण यशस्विना।\nरेमे स स्वर्गभवने पाण्डुपुत्रो धनंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2019580, "chapter_id": 1406, "verse_number": "३-४४-७८", "content_sanskrit": "य इमां शृणुयान्नित्यं धृतिं पाण्डुसुतस्य वै।\nन तस्य कामः कामेषु पापकेषु प्रवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2019581, "chapter_id": 1406, "verse_number": "३-४४-७९", "content_sanskrit": "इदममरवरात्मजस्य घोरं\nसुचि चरितं विनिशाम्य फल्गुनस्य।\nव्यपगतमददम्भरागदोषा-\nस्त्रिदिवगताऽभिरमन्ति मानवेन्द्राः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2019582, "chapter_id": 1406, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि इन्द्रलोकाभिगमनपर्वणि चतुश्चत्वारिंशोऽध्यायः ॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}]