[{"id": 7003576000, "chapter_id": 23576, "verse_number": "२१६-१", "content_sanskrit": "ब्रह्मोवाच ।\nतस्मात्स्थानादपक्रान्ते त्र्यम्बके मृगरूपिणि ।\nअन्योऽन्यं मन्त्रयित्वा तु मया सह सुरोत्तमाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003576001, "chapter_id": 23576, "verse_number": "२१६-२", "content_sanskrit": "त्रिधाविभक्तं तच्छृङ्गं पृथक्पृथगवस्थितम् ।\nसम्यक्स्थापयितुं देवा विधिदृष्टेन कर्मणा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003576002, "chapter_id": 23576, "verse_number": "२१६-३", "content_sanskrit": "स्थापितं देवि नीत्वा वै शृंगाग्रं वज्रपाणिना ।\nमया तत्रैव तन्मध्यं स्थापितं विधिवत्प्रभोः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003576003, "chapter_id": 23576, "verse_number": "२१६-४", "content_sanskrit": "देवैर्देवर्षिभिश्चैव सिद्धैर्ब्रह्मर्षिभिस्तथा ।\nगोकर्ण इति विख्यातिः कृता वैशेषिकी वरा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003576004, "chapter_id": 23576, "verse_number": "२१६-५", "content_sanskrit": "विष्णुना देवतीर्थेन तन्मूलं स्थापितं ततः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]