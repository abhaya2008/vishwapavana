[{"id": 2041451, "chapter_id": 1919, "verse_number": "५-१६४-०x", "content_sanskrit": "संजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2041452, "chapter_id": 1919, "verse_number": "५-१६४-१", "content_sanskrit": "उलूकस्य वृत्तः श्रुत्वा कुन्तीपुत्रो युधिष्ठिरः।\nसेनां नियापयामास धृष्टद्युम्नपुरोगमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2041453, "chapter_id": 1919, "verse_number": "५-१६४-२", "content_sanskrit": "पदातिनीं नागवतीं रथिनीमश्वबृन्दिनीम् ।\nचतुर्विधबलां भीमामकम्पां पृथिवीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2041454, "chapter_id": 1919, "verse_number": "५-१६४-३", "content_sanskrit": "भीमसेनादिभिर्गुप्तां सार्जुनैश्च महारथैः ।\nधृष्टद्युम्नवशां दुर्गां सागरस्तिमितोपमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2041455, "chapter_id": 1919, "verse_number": "५-१६४-४", "content_sanskrit": "तस्यास्त्वग्रे महेष्वासः पाञ्चाल्यो युद्धदुर्मदः।\nद्रोणप्रेप्सुरनीकानि धृष्टद्युम्नो व्यकर्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2041456, "chapter_id": 1919, "verse_number": "५-१६४-५", "content_sanskrit": "यथाबलं यथोत्साहं रथिनः समुपादिशत् ।\nअर्जुनं सूतपुत्राय भीमं दुर्योधनाय च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2041457, "chapter_id": 1919, "verse_number": "५-१६४-६", "content_sanskrit": "धृष्टकेतुं च शल्याय गौतमायोत्तमौजसम् ।\nअश्वात्थाम्ने च नकुलं शैब्यं च कृतवर्मणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2041458, "chapter_id": 1919, "verse_number": "५-१६४-७", "content_sanskrit": "सैन्धवाय च वार्ष्णेयं युयुधानं समादिशत्।\nशिखण्डिनं च भीष्माय प्रमुखे समकल्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2041459, "chapter_id": 1919, "verse_number": "५-१६४-८", "content_sanskrit": "सहदेवं शकुनये चेकितानं शलाय वै।\nद्रौपदेयांस्तथा पञ्च त्रिगर्तेभ्यः समादिशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2041460, "chapter_id": 1919, "verse_number": "५-१६४-९", "content_sanskrit": "वृषसेनाय सौभद्रं शेषाणां च महीक्षिताम् ।\nस समर्थं हि तं मेने पार्थादभ्यधिकं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2041461, "chapter_id": 1919, "verse_number": "५-१६४-१०", "content_sanskrit": "एवं विभज्य योधांस्तान्पृथक्व सह चैव ह ।\nज्वालावर्णो महेष्वासो द्रोणमंशमकल्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2041462, "chapter_id": 1919, "verse_number": "५-१६४-११", "content_sanskrit": "धृष्टद्युम्नो महेष्वासः सेनापतिपतिस्ततः ।\nविधिवद्व्यूह्य मेधावी युद्धाय धृतमानसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2041463, "chapter_id": 1919, "verse_number": "५-१६४-१२", "content_sanskrit": "यथोद्दिष्टानि सैन्यानि पाण्डवानामयोजयत्।\nजयाय पाण्डुपुत्राणां यत्तस्तस्थौ रणाजिरे ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2041464, "chapter_id": 1919, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि उलूकदूतागमनपर्वणि चतुःषष्ट्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]