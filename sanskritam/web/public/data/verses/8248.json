[{"id": 900001673, "chapter_id": 8248, "verse_number": "5.1", "content_sanskrit": "ॐ पूर्णमदः पूर्णमिदं पूर्णात् पूर्णमुदच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001674, "chapter_id": 8248, "verse_number": "5.2", "content_sanskrit": "त्रयाः प्राजापत्याः प्रजापतौ पितरि ब्रह्मचर्यमूषुर्देवा ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001675, "chapter_id": 8248, "verse_number": "5.3", "content_sanskrit": "एष प्रजापतिर्यद्धृदयमेतद्ब्रह्मैतत्सत्यं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001676, "chapter_id": 8248, "verse_number": "5.4", "content_sanskrit": "तद्धैतदेतदेव तदास सत्यमेव स यो हैतं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001677, "chapter_id": 8248, "verse_number": "5.5", "content_sanskrit": "आप एवेदमग्र आसुस्ता आपः सत्यमसृजन्त ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001678, "chapter_id": 8248, "verse_number": "5.6", "content_sanskrit": "तद्यत्तत् सत्यमसौ स आदित्यो य एष ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900001679, "chapter_id": 8248, "verse_number": "5.7", "content_sanskrit": "य एष एतस्मिन् मंडले पुरुषस्तस्य भूरिति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900001680, "chapter_id": 8248, "verse_number": "5.8", "content_sanskrit": "मनोमयोऽयं पुरुषो भाः सत्यस्तस्मिन् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900001681, "chapter_id": 8248, "verse_number": "5.9", "content_sanskrit": "विद्युद्ब्रह्मेत्याहुर्विदानाद् विद्युत् विद्यत्येनं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900001682, "chapter_id": 8248, "verse_number": "5.10", "content_sanskrit": "वाचं धेनुमुपासीत तस्याश्चत्वारः स्तनाः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900001683, "chapter_id": 8248, "verse_number": "5.11", "content_sanskrit": "अयमग्निर्वैश्वानरो योऽयमन्तःपुरुषे येनेदमन्नं पच्यते ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900001684, "chapter_id": 8248, "verse_number": "5.12", "content_sanskrit": "यदा वै पुरुषोऽस्माल्लोकात् प्रैति स वायुमागच्छति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900001685, "chapter_id": 8248, "verse_number": "5.13", "content_sanskrit": "एतद्वै परमं तपो यद् व्याधितस्तप्यते परमं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900001686, "chapter_id": 8248, "verse_number": "5.14", "content_sanskrit": "अन्नं ब्रह्मेत्येक आहुस्तन्न तथा पूयति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900001687, "chapter_id": 8248, "verse_number": "5.15", "content_sanskrit": "उक्थं प्राणो वा उक्थं प्राणो हीदं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900001688, "chapter_id": 8248, "verse_number": "5.16", "content_sanskrit": "यजुः प्राणो वै यजुः प्राणे हीमानि सर्वाणि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900001689, "chapter_id": 8248, "verse_number": "5.17", "content_sanskrit": "साम प्राणो वै साम प्राणे हीमानि सर्वाणि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900001690, "chapter_id": 8248, "verse_number": "5.18", "content_sanskrit": "क्षत्रं प्राणो वै क्षत्रं प्राणे हि वै क्षत्रं त्रायते..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900001691, "chapter_id": 8248, "verse_number": "5.19", "content_sanskrit": "भूमिरन्तरिक्षं द्यौरित्यष्टावक्षराण्यष्टाक्षरं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900001692, "chapter_id": 8248, "verse_number": "5.20", "content_sanskrit": "हिरण्मयेन पात्रेण सत्यस्यापिहितं मुखम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]