[{"id": 7002302000, "chapter_id": 22302, "verse_number": "३४७-१", "content_sanskrit": "अग्निरुवाच ।\nउद्वेगजनको दोषः सभ्यानां स च सप्तधा ।\nवक्तृवाचकवाच्यानामेकद्वित्रिनियोगतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002302001, "chapter_id": 22302, "verse_number": "३४७-२", "content_sanskrit": "तत्र वक्ता कविर्नाम प्रथते स च भेदतः ।\nसन्दिहानोऽविनीतः सन्नज्ञो ज्ञाता चतुर्व्विंधः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002302002, "chapter_id": 22302, "verse_number": "३४७-३", "content_sanskrit": "निमित्तपरिभाषाभ्यामर्थसंस्पर्शिवाचकम् ।\nतद्भेदो पदवाक्ये द्वे कथितं लक्षणं द्व्योः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002302003, "chapter_id": 22302, "verse_number": "३४७-४", "content_sanskrit": "असाधुत्वाप्रयुक्तत्वे द्वावेव पदनिग्रहौ ।\nशब्दशास्त्रविरुद्धत्वमसाधुत्वं विदुर्बुधाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002302004, "chapter_id": 22302, "verse_number": "३४७-५", "content_sanskrit": "व्युत्पन्नैरनिबद्धत्वमप्रयुक्तत्वमुच्यते ।\nछान्दसत्वमविस्पष्टत्वञ्च कष्टत्वमेव च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002302005, "chapter_id": 22302, "verse_number": "३४७-६", "content_sanskrit": "तदसामयिकत्वञ्च ग्राम्यत्वञ्चेति पञ्चधा ।\nछान्दसत्वं न भाषायामविस्पष्टमबोधतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002302006, "chapter_id": 22302, "verse_number": "३४७-७", "content_sanskrit": "गूढ़ार्थता विपर्य्यस्तार्थता संशयितार्थता ।\nअविस्पष्टार्थता भेदास्तत्र गूढ़ार्थतेति सा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002302007, "chapter_id": 22302, "verse_number": "३४७-८", "content_sanskrit": "यत्रार्थो दुःखसंवेद्यो विपर्य्यस्तार्थ्ता पुनः ।\nविवक्षितान्यशब्दार्थप्रतिपत्तिर्मलीमसा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002302008, "chapter_id": 22302, "verse_number": "३४७-९", "content_sanskrit": "अन्यार्थत्वासमर्थत्वे एतामेवोपसर्पतः ।\nसन्दिह्यमानवाच्यत्वमाहुः संशयितार्थतां ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002302009, "chapter_id": 22302, "verse_number": "३४७-१०", "content_sanskrit": "दोषत्वमनुबध्नाति सज्जनोद्वेजनादृते ।\nअसुखोच्चार्य्यमाणत्वं कष्टत्वं समयाच्युतिः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002302010, "chapter_id": 22302, "verse_number": "३४७-११", "content_sanskrit": "असामयितता नेयामेताञ्च मुनयो जगुः ।\nग्राम्यता तु जघन्यार्थप्रतिपत्तिः शलीकृता ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002302011, "chapter_id": 22302, "verse_number": "३४७-१२", "content_sanskrit": "वक्तव्यग्राम्यवाच्यस्य वचनात्स्मरणादपि ।\nतद्वाचकपदेनाभिसाम्याद्भवति सा त्रिधा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002302012, "chapter_id": 22302, "verse_number": "३४७-१३", "content_sanskrit": "दोषः साधारणः प्रातिस्विकोऽर्थस्य स तु द्विधा ।\nअनेकभागुपालम्भः साधारण इति स्मृतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002302013, "chapter_id": 22302, "verse_number": "३४७-१४", "content_sanskrit": "क्रियाकारकयोर्भ्रंशो विसन्धिः पुनरुक्तता ।\nव्यस्तसम्बन्धता चेति पञ्च साधारणा मताः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002302014, "chapter_id": 22302, "verse_number": "३४७-१५", "content_sanskrit": "अक्रियत्वं त्रियाभ्रंशो भ्रष्टकारकता पुनः ।\nसर्त्त्र्यादिकारकाभावो विसन्धिः सन्धिदूषणम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002302015, "chapter_id": 22302, "verse_number": "३४७-१६", "content_sanskrit": "विगतो वा विरुद्धो वा सन्धिः स भवति द्विधा ।\nसन्धेर्व्विरुद्धता कष्टपादादर्थान्तरागमात् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002302016, "chapter_id": 22302, "verse_number": "३४७-१७", "content_sanskrit": "पुनरुक्तत्वमाभीक्ष्ण्यादभिधानं द्विधैव तत् ।\nअर्थावृत्तिः पदावृत्तिरर्थावृत्तिरपि द्विधा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002302017, "chapter_id": 22302, "verse_number": "३४७-१८", "content_sanskrit": "प्रयुक्त वरशब्देन तथा शब्दान्तरेण च ।\nनावर्त्तते पदावृत्तौ वाच्यमावर्त्तते पदम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002302018, "chapter_id": 22302, "verse_number": "३४७-१९", "content_sanskrit": "व्यस्तसम्बन्धता सुष्ठुसम्बन्धो व्यवधानतः ।\nसम्बन्धान्तरनिर्भाषात् सम्बन्धान्तरजन्मनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002302019, "chapter_id": 22302, "verse_number": "३४७-२०", "content_sanskrit": "अभावेपि तयोरन्तर्व्यवधानात्त्त्रिधैव सा ।\nअन्तरा पदवाक्याभ्यां पुनर्द्विधा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002302020, "chapter_id": 22302, "verse_number": "३४७-२१", "content_sanskrit": "वाच्यमर्थार्थ्यमानत्वात्तद्द्विधा पदवाक्ययोः ।\nव्युत्पादितपूर्व्ववाच्यं व्युत्पाद्यञ्चेति भिद्यते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002302021, "chapter_id": 22302, "verse_number": "३४७-२२", "content_sanskrit": "इष्टव्याघातकारित्वं हेतोः स्यादसमर्थता ।\nअसिद्धत्वं विरुद्धत्वमनैकान्तिकता तथा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002302022, "chapter_id": 22302, "verse_number": "३४७-२३", "content_sanskrit": "एवं सत्प्रतिपक्षत्वं कालातीतत्वसङ्करः ।\nपक्षे सपक्षे नास्तित्वं विपक्षेऽस्तित्वमेव तत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002302023, "chapter_id": 22302, "verse_number": "३४७-२४", "content_sanskrit": "काव्येषु परिषद्यानां न भवेदप्यरुन्तुदम् ।\nएकादशनिरर्थत्वं दुष्करादौ न दुष्यति ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002302024, "chapter_id": 22302, "verse_number": "३४७-२५", "content_sanskrit": "दुःखीकरोति दोषज्ञान् गूढार्थत्वं न दुष्करे ।\nन ग्राम्यतोद्वेगकारी प्रसिद्धेर्ल्लोकशास्त्रयोः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002302025, "chapter_id": 22302, "verse_number": "३४७-२६", "content_sanskrit": "क्रियाभ्रंशेन लक्ष्मास्ति क्रियाध्याहारयोगतः ।\nभ्रष्टकारकताक्षेपबलाध्याहृतकारके ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002302026, "chapter_id": 22302, "verse_number": "३४७-२७", "content_sanskrit": "प्रगृह्यो गृह्यते नैव क्षतं विगतसन्धिना ।\nकष्टपाठाद्विसन्धित्वं दुर्व्वचादौ न दुर्भगम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002302027, "chapter_id": 22302, "verse_number": "३४७-२८", "content_sanskrit": "अनुप्रासे पदावृत्तिर्व्यस्तसम्बन्धता शुभा ।\nनार्थसंग्रहणे दोषो व्युत्क्रमाद्यैर्न्न लिप्यते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002302028, "chapter_id": 22302, "verse_number": "३४७-२९", "content_sanskrit": "विभक्तिसंज्ञालिङ्गानां यत्रोद्वेगो न धीमतां ।\nसंख्यायास्तत्र भिन्नत्वमुप्मानोपमेययोः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002302029, "chapter_id": 22302, "verse_number": "३४७-३०", "content_sanskrit": "अनेकस्य तथैकेन बहूनां बहुभिः शुभा ।\nकवीनां समुदाचारः समयो नाम गीयते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002302030, "chapter_id": 22302, "verse_number": "३४७-३१", "content_sanskrit": "सामान्यश्च विशिष्टश्च धर्म्मवद्भवति द्विधा ।\nसिद्धसैद्धान्तिकानाञ्च कवीनाञ्चाविवादतः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002302031, "chapter_id": 22302, "verse_number": "३४७-३२", "content_sanskrit": "यः प्रसिध्यति सामान्य इत्यसौ समयो मतः ।\nसर्व्वे सिद्धान्तिका येन सञ्चरन्ति निरत्ययं ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002302032, "chapter_id": 22302, "verse_number": "३४७-३३", "content_sanskrit": "कियन्त एव वा येन सामान्यस्तेन स द्विधा ।\nछेदसिद्धान्ततोऽन्यः स्यात् केषाञ्चिद् भ्रान्तितो यथा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002302033, "chapter_id": 22302, "verse_number": "३४७-३४", "content_sanskrit": "तर्कज्ञानां मुनेः कस्य कस्यचित् क्षणभङ्गिका ।\nभूतचैतन्यता कस्य ज्ञानस्य सुप्रकाशता ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002302034, "chapter_id": 22302, "verse_number": "३४७-३५", "content_sanskrit": "प्रज्ञातस्थूलताशबप्दानेकान्तत्वं तथार्हतः ।\nशैववैष्णवशाक्तेयसौरसिद्धान्तिनां मतिः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002302035, "chapter_id": 22302, "verse_number": "३४७-३६", "content_sanskrit": "जगतः कारणं ब्रह्म साङ्ख्यानां सप्रधानकं ।\nअस्मिन् सरस्वतीलोके सञ्चरन्तः परस्परम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002302036, "chapter_id": 22302, "verse_number": "३४७-३७", "content_sanskrit": "बध्नन्ति व्यतिपश्यन्तो यद्विशिष्टः स उच्यते ।\nपरिग्रहादप्यसतां सतामेवापरिग्रहात् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002302037, "chapter_id": 22302, "verse_number": "३४७-३८", "content_sanskrit": "भिद्यमानस्य तस्यायं द्वैविध्यमुपगीयते ।\nप्रत्यज्ञादिप्रमाणैर्यद्बाधितं तदसद्विदुः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002302038, "chapter_id": 22302, "verse_number": "३४७-३९", "content_sanskrit": "कविभिस्तत् प्रतिग्राह्यं ज्ञानस्य द्योतमानता ।\nयदेवार्थक्रियाकारि तदेव परमार्थसत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002302039, "chapter_id": 22302, "verse_number": "३४७-४०", "content_sanskrit": "अज्ञानाज्ज्ञानतस्त्वेकं ब्रह्मैव परमार्थसत् ।\nविष्णुः स्वर्गादिहेतुः स शब्दालङ्काररूपवान् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002302040, "chapter_id": 22302, "verse_number": "३४७-४१", "content_sanskrit": "अपरा च परा विद्या तां ज्ञात्वा मुच्यते भवात् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]