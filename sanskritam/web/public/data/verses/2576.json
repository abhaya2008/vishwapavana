[{"id": 2074600, "chapter_id": 2576, "verse_number": "१२-८१-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2074601, "chapter_id": 2576, "verse_number": "१२-८१-१", "content_sanskrit": "एवमग्राह्यके तस्मिञ्ज्ञातिसंबन्धिमण्डले।\nमित्रेष्वमित्रेष्वपि च कथं भावो विभाव्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2074602, "chapter_id": 2576, "verse_number": "१२-८१-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2074603, "chapter_id": 2576, "verse_number": "१२-८१-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nसंवादं वासुदेवस्य महर्षेर्नारदस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2074604, "chapter_id": 2576, "verse_number": "१२-८१-३x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2074605, "chapter_id": 2576, "verse_number": "१२-८१-३", "content_sanskrit": "नासुहृत्परर्म मन्त्रं नारदार्हति वेदितुम्।\nअपण्डितो वाऽपि सुहृत्पण्डितो वाप्यनात्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2074606, "chapter_id": 2576, "verse_number": "१२-८१-४", "content_sanskrit": "स ते सौहृदमास्थाय किंचिद्वक्ष्यामि नारद।\nकृत्स्नां बुद्धिं च ते प्रेक्ष्य संपृच्छे त्रिदिवङ्गम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2074607, "chapter_id": 2576, "verse_number": "१२-८१-५", "content_sanskrit": "दास्यमैश्वर्यवादेन ज्ञातीनां वै करोम्यहम्।\nअर्धंभोक्ताऽस्मि भोगानां वाग्दुरुक्तानि च क्षमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2074608, "chapter_id": 2576, "verse_number": "१२-८१-६", "content_sanskrit": "अरणीमग्निकामो वा मथ्नाति दहृयं मम।\nवाचा दुरुक्तं देवर्षे तन्मां दहति नित्यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2074609, "chapter_id": 2576, "verse_number": "१२-८१-७", "content_sanskrit": "बलं सङ्कर्षणे नित्यं सौकुमार्यं पुनर्गदे।\nरूपेण मत्तः प्रद्युम्नः सोऽसहायोऽस्मि नारद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2074610, "chapter_id": 2576, "verse_number": "१२-८१-८", "content_sanskrit": "अन्ये हि सुमहाभागा बलवन्तो दुरासदाः।\nनित्योत्थानेन संपन्ना नारदान्धकवृष्णयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2074611, "chapter_id": 2576, "verse_number": "१२-८१-९", "content_sanskrit": "यस्य न स्युर्न वै स स्याद्यस्य स्युः कृत्स्नमेव तत्।\nद्वयोरेनं प्रचरतोर्वृणोम्येकरतं न च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2074612, "chapter_id": 2576, "verse_number": "१२-८१-१०", "content_sanskrit": "स्यातां यस्याहुकाक्रूरौ किं नु दुःखतरं ततः।\nयस्य चापि न तौ स्यातां किं नु दुःखतरं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2074613, "chapter_id": 2576, "verse_number": "१२-८१-११", "content_sanskrit": "सोऽहं कित्नवमातेव द्वयोरपि महामुने।\nनैकस्य जयमाशंसे द्वितीयस्य पराजयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2074614, "chapter_id": 2576, "verse_number": "१२-८१-१२", "content_sanskrit": "ममैवं क्लिश्यमानस्य नारदोभयदर्शनात्।\nवक्तुमर्हसि यच्छ्रेयो ज्ञातीनामात्मनस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2074615, "chapter_id": 2576, "verse_number": "१२-८१-१३x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2074616, "chapter_id": 2576, "verse_number": "१२-८१-१३", "content_sanskrit": "आपदो द्विविधाः कृष्ण बाह्याश्चाम्यन्तराश्च ह।\nप्रादुर्भवन्ति वार्ष्णेय स्वकृता यदि वाऽन्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2074617, "chapter_id": 2576, "verse_number": "१२-८१-१४", "content_sanskrit": "सेयमाभ्यन्तरा तुभ्यमापत्कृच्छ्रा स्वकर्मजा।\nअक्रूरभोजप्रभवा सर्वे ह्येते तदन्वयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2074618, "chapter_id": 2576, "verse_number": "१२-८१-१५", "content_sanskrit": "अर्थहेतोर्हि कामाद्वा वीरबीभत्सयाऽपि वा।\nआत्मना प्राप्तमैश्वर्यमन्यत्र प्रतिपादितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2074619, "chapter_id": 2576, "verse_number": "१२-८१-१६", "content_sanskrit": "कृतमूलमिदानीं तद्राजशब्दसहायवत्।\nन शक्यं पुनरादातुं वान्तमन्नमिव स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2074620, "chapter_id": 2576, "verse_number": "१२-८१-१७", "content_sanskrit": "बभ्रूग्रसेनतो राज्यं नाप्नुं शक्यं कथंचन।\nज्ञातिभेदभयात्कृष्ण त्वया चापि विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2074621, "chapter_id": 2576, "verse_number": "१२-८१-१८", "content_sanskrit": "तच्च सिध्येत्प्रयत्नेन कृत्वा कर्म सुदुष्करम्।\nमहाक्षयं व्ययो वा स्याद्विनाशो वा पुनर्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2074622, "chapter_id": 2576, "verse_number": "१२-८१-१९", "content_sanskrit": "अनायसेन शस्त्रेण मृदुना हृदयच्छिदा।\nजिह्वामुद्धर सर्वेषां परिमृदज्यानुमृज्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2074623, "chapter_id": 2576, "verse_number": "१२-८१-२०x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2074624, "chapter_id": 2576, "verse_number": "१२-८१-२०", "content_sanskrit": "अनायसं मुने शस्त्रं मृदु विद्यामहं कथम्।\nयेनैषामुद्धरे जिह्वां परिमृज्यानुमृज्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2074625, "chapter_id": 2576, "verse_number": "१२-८१-२१x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2074626, "chapter_id": 2576, "verse_number": "१२-८१-२१", "content_sanskrit": "शक्त्याऽन्नदानं सततं तितिक्षाऽऽर्जवमार्दवम्।\nयथार्हप्रतिपूजा च शस्त्रमेतदनायसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2074627, "chapter_id": 2576, "verse_number": "१२-८१-२२", "content_sanskrit": "ज्ञातीनां वक्तुकामानां कटुकानि लधूनि च।\nगिरा त्वं हृदयं वाचं शमयस्य मनांसि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2074628, "chapter_id": 2576, "verse_number": "१२-८१-२३", "content_sanskrit": "नामहापुरुषः कश्चिन्नानात्मा नासहायवान्।\nमहतीं धुरमादाय समुद्यम्योरसा वहेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2074629, "chapter_id": 2576, "verse_number": "१२-८१-२४", "content_sanskrit": "सर्व एव गुरुं भारमनङ्वान्वहते समे।\nदुर्गे प्रतीतः सुगवो भारं वहति दुर्वहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2074630, "chapter_id": 2576, "verse_number": "१२-८१-२५", "content_sanskrit": "भेदाद्विनाशः सङ्घानां सङ्घमुख्योऽसि केशव।\nयथा त्वां प्राप्य नोत्सीदेदयं सङ्घस्तथा कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2074631, "chapter_id": 2576, "verse_number": "१२-८१-२६", "content_sanskrit": "नान्यत्र बुद्धिक्षान्तिभ्यां नान्यत्रेन्द्रियनिग्रहात्।\nनान्यत्र धनसन्त्यागाद्गुणः प्राज्ञेऽवतिष्ठते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2074632, "chapter_id": 2576, "verse_number": "१२-८१-२७", "content_sanskrit": "धन्यं यशस्यमायुष्वं स्वपक्षोद्भावनं सदा।\nज्ञातीनामविनाशः स्याद्यथा कृष्ण तथा कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2074633, "chapter_id": 2576, "verse_number": "१२-८१-२८", "content_sanskrit": "आयत्यां च तदात्वे च न तेऽस्त्यविदितं प्रभो।\nषाङ्गुण्यस्य विधानेन यात्रा यानविधौ तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2074634, "chapter_id": 2576, "verse_number": "१२-८१-२९", "content_sanskrit": "यादवाः कुकुरा भोजाः सर्वे चान्धकवृष्णयः।\nत्वय्यायत्ता महाबाहो लोका लोकेश्वराश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2074635, "chapter_id": 2576, "verse_number": "१२-८१-३०", "content_sanskrit": "उपासन्ते हि त्वद्बुद्धिमृषयश्चापि माधव।\nत्वं गुरुः सर्वभूतानां जानीषे त्वं परां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2074636, "chapter_id": 2576, "verse_number": "१२-८१-३१", "content_sanskrit": "त्वामासाद्य यदुश्रेष्ठमेधन्ते वादवाः सुखम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2074637, "chapter_id": 2576, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि एकाशीतितमोऽध्यायः॥ ८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]