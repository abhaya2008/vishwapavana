[{"id": 2001192, "chapter_id": 1014, "verse_number": "१-१५-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001193, "chapter_id": 1014, "verse_number": "१-१५-१", "content_sanskrit": "मात्रा हि भुजगाः शप्ताः पूर्वं ब्रह्मविदां वर।\nजनमेजयस्य वो यज्ञे धक्ष्यत्यनिलसारथिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001194, "chapter_id": 1014, "verse_number": "१-१५-२", "content_sanskrit": "तस्य शापस्य शान्त्यर्थं प्रददौ पन्नगोत्तमः।\nस्वसारमृषये तस्मै सुव्रताय महात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001195, "chapter_id": 1014, "verse_number": "१-१५-३", "content_sanskrit": "स च तां प्रतिजग्राह विधिदृष्टेन कर्मणा।\nआस्तीको नाम पुत्रश्च तस्यां जज्ञे महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001196, "chapter_id": 1014, "verse_number": "१-१५-४", "content_sanskrit": "तपस्वी च महात्मा च वेदवेदाङ्गपारगः।\nसमः सर्वस्य लोकस्य पितृमातृभयापहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001197, "chapter_id": 1014, "verse_number": "१-१५-५", "content_sanskrit": "अथ दीर्घस्य कालस्य पाण्डवेयो नराधिपः।\nआजहार महायज्ञं सर्पसत्रमिति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001198, "chapter_id": 1014, "verse_number": "१-१५-६", "content_sanskrit": "तस्मिन्प्रवृत्ते सत्रे तु सर्पाणामन्तकाय वै।\nमोचयामास ताञ्शापादास्तीकः सुमहातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001199, "chapter_id": 1014, "verse_number": "१-१५-७", "content_sanskrit": "भ्रातॄंश्च मातुलांश्चैव तथैवान्यान्स पन्नगान्।\nपितॄंश्च तारयामास संतत्या तपसा तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001200, "chapter_id": 1014, "verse_number": "१-१५-८", "content_sanskrit": "व्रतैश्च विविधैर्ब्रह्मन्स्वाध्यायैश्चानृणोऽभवत्।\nदेवांश्च तर्पयामास यज्ञैर्विविधदक्षिणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001201, "chapter_id": 1014, "verse_number": "१-१५-९", "content_sanskrit": "ऋषींश्च ब्रह्मचर्येम सन्तत्या च पितामहान्।\nअपहृत्य गुरं भारं पितॄणां संशितव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001202, "chapter_id": 1014, "verse_number": "१-१५-१०", "content_sanskrit": "जरत्कारुर्गतः स्वर्गं सहितः स्वैः पितामहैः।\nआस्तीकं च सुतं प्राप्य धर्मं चानुत्तमं मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001203, "chapter_id": 1014, "verse_number": "१-१५-११", "content_sanskrit": "जरत्कारुः सुमहता कालेन स्वर्गमेयिवान्।\nएतदाख्यानमास्तीकं यथावत्कथितं मया।\nप्रब्रूहि भृगुशार्दूल किमन्यत्कथयामि ते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001204, "chapter_id": 1014, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि पञ्चदशोऽध्यायः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]