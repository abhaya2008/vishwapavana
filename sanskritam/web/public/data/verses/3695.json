[{"id": 2125807, "chapter_id": 3695, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2125808, "chapter_id": 3695, "verse_number": "१", "content_sanskrit": "तस्य सम्पश्यतस्त्वेव पिनाकी वृषभध्वजः ।\nजगामादर्शनं भानुर्लोकस्येवास्तमेयिवान् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2125809, "chapter_id": 3695, "verse_number": "२", "content_sanskrit": "ततोऽर्जुनः परं चक्रे विस्मयं परवीरहा ।\nमया साक्षान्महादेवो दृष्ट इत्यसकृत् प्रभुः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2125810, "chapter_id": 3695, "verse_number": "३", "content_sanskrit": "धन्योऽस्म्यनुगृहीतोऽस्मि यन्मया त्र्यम्बको हरः ।\nपिनाकी वरदो रूपी दृष्टः स्पृष्टश्च पाणिना\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2125811, "chapter_id": 3695, "verse_number": "४", "content_sanskrit": "कृतार्थं चावगच्छामि पुनरात्मानमात्मना ।\nशत्रूंश्च विजितान् सर्वान् निर्वृत्तं च प्रयोजनम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2125812, "chapter_id": 3695, "verse_number": "५", "content_sanskrit": "ततो वैडूर्यवर्णाभो द्योतयन् सर्वतोदिशम् ।\nयादोगणवृतः श्रीमानाजगाम जलेश्वरः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2125813, "chapter_id": 3695, "verse_number": "६", "content_sanskrit": "नागैर्नदैर्नदीभिश्च दैत्यैः साध्यैर्मरुद्गणैः ।\nवरुणो यादसां भर्ता वशी तं देशमभ्यगात् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2125814, "chapter_id": 3695, "verse_number": "७", "content_sanskrit": "अथ जाम्बूनदवपुर्विमानेन महार्चिषा ।\nकुबेरः समनुप्राप्तो यक्षैरनुगतः प्रभुः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2125815, "chapter_id": 3695, "verse_number": "८", "content_sanskrit": "विद्योतयन्निवाकाशम् अद्भुतोपमदर्शनः ।\nधनानामीश्वरः श्रीमान् अर्जुनं द्रष्टुमागमत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2125816, "chapter_id": 3695, "verse_number": "९", "content_sanskrit": "तथा लोकान्तकः श्रीमान् यमः साक्षात् प्रतापवान् ।\nमर्त्यमूर्तिधरैः सार्धं पितृभिर्लोकभावनैः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2125817, "chapter_id": 3695, "verse_number": "१०", "content_sanskrit": "दण्डपाणिरचिन्त्यात्मा सर्वभूतविनाशकृत् ।\nवैवस्वतो धर्मराजो विमानेनावभासयन् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2125818, "chapter_id": 3695, "verse_number": "११", "content_sanskrit": "त्रील्लँोकान् गुह्यकांश्चैव गन्धर्वांश्च सपन्नगान् ।\nद्वितीय इव मार्ताण्डो युगान्ते समुपस्थिते \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2125819, "chapter_id": 3695, "verse_number": "१२", "content_sanskrit": "भानुमन्ति विचित्राणि शिखराणि महागिरेः ।\nसमास्थायार्जुनं तत्र ददृशुस्तपसान्वितम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2125820, "chapter_id": 3695, "verse_number": "१३", "content_sanskrit": "ततो मुहूर्ताद् भगवानैरावतशिरोगतः ।\nआजगाम सहेन्द्राण्या शक्रः सुरगणैर्वृतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2125821, "chapter_id": 3695, "verse_number": "१४", "content_sanskrit": "पाण्डरेणातपत्रेण ध्रियमाणेन मूर्धनि ।\nशुशुभे नागराजस्थः सितमभ्रमिवास्थितः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2125822, "chapter_id": 3695, "verse_number": "१५", "content_sanskrit": "संस्तूयमानो गन्धर्वैः ऋषिभिश्च तपोधनैः ।\nशृङ्गं गिरेः समासाद्य तस्थौ सूर्य इवोदितः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2125823, "chapter_id": 3695, "verse_number": "१६", "content_sanskrit": "अथ मेघस्वनः श्रीमान् व्याजहार शुभां गिरम् ।\nयमः परमधर्मज्ञो दक्षिणां दिशमाश्रितः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2125824, "chapter_id": 3695, "verse_number": "१७", "content_sanskrit": "अर्जुनार्जुन पश्यास्माँल्लोकपालान् समागतान् ।\nदृष्टिं ते वितरामोऽद्य भवानर्हसि दर्शनम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2125825, "chapter_id": 3695, "verse_number": "१८", "content_sanskrit": "पूर्वर्षिरमितात्मा त्वं नरो नाम महाबलः ।\nनियोगाद् ब्रह्मणस्तात मर्त्यतां समुपागतः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2125826, "chapter_id": 3695, "verse_number": "१९", "content_sanskrit": "त्वं वासव समुद्भूतो महावीर्यपराक्रमः ।\nक्षात्रं चाग्निसमस्पर्शं भारद्वाजेन रक्षितम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2125827, "chapter_id": 3695, "verse_number": "२०", "content_sanskrit": "दानवाश्च महावीर्या ये मनुष्यत्वमागताः ।\nनिवातकवचाश्चैव संसाध्याः कुरुनन्दन\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2125828, "chapter_id": 3695, "verse_number": "२१", "content_sanskrit": "पितुर्ममांशो देवस्य सर्वर्लोकप्रतापिनः ।\nकर्णः स सुमहावीर्यः त्वया वध्यो धनञ्जय\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2125829, "chapter_id": 3695, "verse_number": "२२", "content_sanskrit": "अंशाश्च भुविसम्प्राप्ता देवगन्धर्वरक्षसाम् ।\nत्वया निपातिता युद्धे स्वकर्मफलनिर्जिताम् ।\nगतिं प्राप्स्यन्ति कौन्तेय यथास्वमरिकर्शन\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2125830, "chapter_id": 3695, "verse_number": "२३", "content_sanskrit": "अक्षया तव कीर्तिश्च लोके स्थास्यति फल्गुन ।\nत्वया साक्षान्महादेवः तोषितो हि महामृधे ।\nलघ्वी वसुमती चापि कर्तव्या विष्णुना सह \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2125831, "chapter_id": 3695, "verse_number": "२४", "content_sanskrit": "गृहाणास्त्रं महाबाहो दण्डमप्रतिमं महत्।\nअनेनास्त्रेण सुमहत् त्वं हि कर्म करिष्यसि\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2125832, "chapter_id": 3695, "verse_number": "२५", "content_sanskrit": "प्रतिजग्राह तत् पार्थो विधिवत् कुरुनन्दनः ।\nसमन्त्रं सोपचारं च समोक्षं सनिवर्तनम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2125833, "chapter_id": 3695, "verse_number": "२६", "content_sanskrit": "ततो जलधरश्यामो वरुणो यादसां पतिः ।\nपश्चिमां दिशमास्थाय गिरमुच्चारयन् प्रभुः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2125834, "chapter_id": 3695, "verse_number": "२७", "content_sanskrit": "पार्थ क्षत्रियमुख्यस्त्वं क्षत्रधर्मे व्यवस्थितः ।\nपश्य मां पृथुताम्राक्ष वरुणोऽस्मि जलेश्वरः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2125835, "chapter_id": 3695, "verse_number": "२८", "content_sanskrit": "मया समुद्यतान् पाशान् वारुणाननिवारणान् ।\nप्रतिगृह्णीष्व कौन्तेय सरहस्यनिवर्तनान् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2125836, "chapter_id": 3695, "verse_number": "२९", "content_sanskrit": "एभिस्तदा मया वीर सङ्ग्रामे तारकामये ।\nदैतेयानां सहस्राणि संयतानि महात्मनाम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2125837, "chapter_id": 3695, "verse_number": "३०", "content_sanskrit": "तस्मादिमान् महासत्त्व मत्प्रसादसमुत्थितान् ।\nगृहाण न हि ते मुच्येदन्तकोऽप्याततायिनः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2125838, "chapter_id": 3695, "verse_number": "३१", "content_sanskrit": "अनेन त्वं यदाऽस्त्रेण सङ्ग्रामे विचरिष्यसि ।\nतदा निःक्षत्रिया भूमिर्भविष्यति न संशयः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2125839, "chapter_id": 3695, "verse_number": "३२", "content_sanskrit": "ततस्तान् वारुणान् दिव्यान् अस्त्रानस्त्रविदां वरः ।\nप्रतिजग्राह विधिवद् वरुणाद् वासविस्तदा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2125840, "chapter_id": 3695, "verse_number": "३३", "content_sanskrit": "ततः कैलासनिलयो धनाध्यक्षोऽभ्यभाषत ।\nदत्तेष्वस्त्रेषु दिव्येषु वरुणेन यमेन च \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2125841, "chapter_id": 3695, "verse_number": "३४", "content_sanskrit": "सव्यसाचिन् महाबाहो पूर्वदेव सनातन ।\nसहास्माभिर्भवान् जातः पुराकल्पेषु नित्यशः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2125842, "chapter_id": 3695, "verse_number": "३५", "content_sanskrit": "मत्तोऽपि त्वं गृहाणास्त्रमन्तर्धानं प्रियं मम ।\nओजस्तेजोद्युतिकरं प्रस्वापनममित्रहन्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2125843, "chapter_id": 3695, "verse_number": "३६", "content_sanskrit": "ततोऽर्जुनो महाबाहुर्विधिवत् कुरुनन्दनः ।\nकौबेरमपि जग्राह दिव्यमस्त्रं महाबलः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2125844, "chapter_id": 3695, "verse_number": "३७", "content_sanskrit": "ततोऽब्रवीद् देवराजः पार्थमक्लिष्टकारिणम् ।\nसान्त्वयन् श्लक्ष्णया वाचा मेघदुन्दुभिनिःस्वनः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2125845, "chapter_id": 3695, "verse_number": "३८", "content_sanskrit": "कुन्तीपुत्र महाबाहो त्वमीशानः पुरातनः ।\nपरां सिद्धिमनुप्राप्तः साक्षाद् देवगतिं गतः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2125846, "chapter_id": 3695, "verse_number": "३९", "content_sanskrit": "देवकार्यं हि सुमहत् त्वया कार्यमरिन्दम ।\nआरोढव्यस्त्वया स्वर्गः सज्जीभव महाद्युते \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2125847, "chapter_id": 3695, "verse_number": "४०", "content_sanskrit": "रथो मातलिसंयुक्त आगन्ता त्वत्कृते मम ।\nतत्र तेऽहं प्रदास्यामि सर्वाण्यस्त्राणि कौरव\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2125848, "chapter_id": 3695, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2125849, "chapter_id": 3695, "verse_number": "४१", "content_sanskrit": "तान् दृष्ट्वा लोकपालांस्तु समेतान् गिरिमूर्धनि ।\nजगाम विस्मयं धीमान् कुन्तीपुत्रो धनञ्जयः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2125850, "chapter_id": 3695, "verse_number": "४२", "content_sanskrit": "ततोऽर्जुनो महातेजा लोकपालान् समागतान् ।\nपूजयामास विधिवद् वाग्भिरद्भिः फलैरपि\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2125851, "chapter_id": 3695, "verse_number": "४३", "content_sanskrit": "ततः प्रतिययुर्देवाः प्रतिपूज्य धनञ्जयम् ।\nयथागतेन विबुधाः सर्वे काममनोजवाः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2125852, "chapter_id": 3695, "verse_number": "४४", "content_sanskrit": "ततोऽर्जुनो मुदं लेभे लब्धास्त्रः पुरुषर्षभः ।\nकृतार्थमिति चात्मानं स मेने पूर्णमानसम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2125853, "chapter_id": 3695, "verse_number": "२७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि सप्तत्रिंशोऽध्यायः ॥३७॥\n॥ कैरातपर्वणि सप्तविंशोऽध्यायः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2125854, "chapter_id": 3695, "verse_number": "", "content_sanskrit": "॥ समाप्तं कैरातपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2125855, "chapter_id": 3695, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]