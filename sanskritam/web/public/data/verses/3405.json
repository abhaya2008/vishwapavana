[{"id": 2111171, "chapter_id": 3405, "verse_number": "", "content_sanskrit": "सङ्क्षेपेण दुष्षन्तसाम्राज्यवर्णनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2111172, "chapter_id": 3405, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2111173, "chapter_id": 3405, "verse_number": "१", "content_sanskrit": "भगवन् विस्तरेणेह भरतस्य महात्मनः ।\nजन्म कर्म च शुश्रूषोस्तन्मे शंसितुमर्हसि\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2111174, "chapter_id": 3405, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2111175, "chapter_id": 3405, "verse_number": "२", "content_sanskrit": "पौरवाणां वंशकरो दुष्षन्तो नाम वीर्यवान् ।\nपृथिव्याश्चतुरन्ताया गोप्ता भरतसत्तम \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2111176, "chapter_id": 3405, "verse_number": "३", "content_sanskrit": "चतुर्भागं भुवः कृत्स्नं यो भुङ्क्ते मनुजेश्वरः ।\nसमुद्रवसनांश्चापि देशान् स समितिञ्जयः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2111177, "chapter_id": 3405, "verse_number": "४", "content_sanskrit": "म्लेच्छानाटविकांश्चापि यो भुङ्क्ते रिपुमर्दनः ।\nरत्नाकरान् समुद्रांश्च चातुर्वर्ण्यजनावृतान्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2111178, "chapter_id": 3405, "verse_number": "५", "content_sanskrit": "न वर्णसङ्करकरो नाकृष्टकरकृज्जनः ।\nन पापकृत् कश्चिदासीत् तस्मिन् राजनि शासति\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2111179, "chapter_id": 3405, "verse_number": "६", "content_sanskrit": "धर्म्यां वृत्तिं सेवमानाः कामार्थौ च प्रपेदिरे ।\nतदा नरा नरव्याघ्र तस्मिन् जनपदेश्वरे \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2111180, "chapter_id": 3405, "verse_number": "७", "content_sanskrit": "नासीच्चोरभयं तात न क्षुधाभयमण्वपि ।\nनासीद् व्याधिभयं चापि तस्मिन् जनपदेश्वरे\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2111181, "chapter_id": 3405, "verse_number": "८", "content_sanskrit": "स्वैर्धर्मै रेमिरे वर्णा दैवे कर्मणि निष्ठिताः ।\nतमाश्रित्य महीपालमासंश्चैवाकुतोभयाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2111182, "chapter_id": 3405, "verse_number": "९", "content_sanskrit": "कालवर्षी च पर्जन्यः सस्यानि फलवन्ति च ।\nसर्वसस्यसमृद्धा च मही पशुमती तथा \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2111183, "chapter_id": 3405, "verse_number": "१०", "content_sanskrit": "स चाद्भुतमहावीर्यो वज्रसंहननो युवा ।\nउद्यम्य मन्दरं दोर्भ्यां हरेत् सवनकाननम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2111184, "chapter_id": 3405, "verse_number": "११", "content_sanskrit": "धनुष्यस्त्रे गदायुद्धे सर्वप्रहरणेषु च ।\nनागपृष्ठेऽश्वपृष्ठे च बभूव परिनिष्ठितः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2111185, "chapter_id": 3405, "verse_number": "१२", "content_sanskrit": "बले विष्णुसमश्चासीत् तेजसा भास्करोपमः ।\nअक्षोभ्यत्वेऽर्णवसमः सहिष्णुत्वे धरासमः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2111186, "chapter_id": 3405, "verse_number": "१३", "content_sanskrit": "समन्तात् स महीपालः प्रसन्नपुरराष्ट्रवान् ।\nभूयो धर्मपरैर्भावैर्विहितं जनमावसत् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2111187, "chapter_id": 3405, "verse_number": "८४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nचतुरशीतितमोऽध्यायः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2111188, "chapter_id": 3405, "verse_number": "", "content_sanskrit": "॥ सम्भवपर्वणि द्वात्रिंशोऽध्यायः ॥३२॥\n* * * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]