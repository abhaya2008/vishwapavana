[{"id": 2093103, "chapter_id": 2984, "verse_number": "१३-११४-१", "content_sanskrit": "वसिष्ठ उवाच।\nशतं वर्षसहस्राणां तपस्तप्तं सुदुष्करम्।\nगोभिः पूर्वं विसृष्टाभिर्गच्छेम श्रेष्ठतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093104, "chapter_id": 2984, "verse_number": "१३-११४-२", "content_sanskrit": "लोकेऽस्मिन्दक्षिणानां च सर्वासां वयमुत्तमाः।\nभवेम न च लोप्येम दोषेणेति परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093105, "chapter_id": 2984, "verse_number": "१३-११४-३", "content_sanskrit": "अस्मत्पुरीषस्नानेन जनः पुयेत सर्वदा।\nशकृता च पवित्रार्थं कुर्वीरन्देवमानुषाःठ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093106, "chapter_id": 2984, "verse_number": "१३-११४-४", "content_sanskrit": "तथा सर्वाणि भूतानि स्थावराणि चराणि च।\nप्रदातारश्च लोकान्नो गच्छेयुरिति मानद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093107, "chapter_id": 2984, "verse_number": "१३-११४-५", "content_sanskrit": "ताभ्यो वरं ददौ ब्रह्मा तपसोऽन्ते स्वयं प्रभुः।\nएवं भवन्विति विभुर्लोकांस्तारयतेति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093108, "chapter_id": 2984, "verse_number": "१३-११४-६", "content_sanskrit": "उत्तस्थुः सिद्धकामास्ता भूतभव्यस्य मातरः।\nतपसोऽन्ते महाराज गावो लोकपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093109, "chapter_id": 2984, "verse_number": "१३-११४-७", "content_sanskrit": "तस्माद्गावो महाभागाः पवित्रं परमुच्यते।\nतथैव सर्वभूतानां समतिष्ठन्त मूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093110, "chapter_id": 2984, "verse_number": "१३-११४-८", "content_sanskrit": "सम्मनवत्सां कपिलां धेनुं दत्त्वा पयस्विनीम्॥\nसुव्रतां वस्त्रसंवीतां ब्रह्मलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093111, "chapter_id": 2984, "verse_number": "१३-११४-९", "content_sanskrit": "लोहितां तुल्यवत्सां तु धेनुं दत्त्वा पयस्विनीम्।\nसुव्रतां वस्त्रसंवीतां सूर्यलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093112, "chapter_id": 2984, "verse_number": "१३-११४-१०", "content_sanskrit": "समानवत्सां शबलां धेनुं दत्त्वा पयस्विनीम्।\nसुव्रतां वस्त्रसंवीतीं सोमलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093113, "chapter_id": 2984, "verse_number": "१३-११४-११", "content_sanskrit": "समानवत्सां श्वेतां तु धेनुं दत्त्वा पयस्विनीम्।\nसुव्रतां वस्त्रसंवीतामिन्द्रलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093114, "chapter_id": 2984, "verse_number": "१३-११४-१२", "content_sanskrit": "समानवत्सां कृष्णां तु धेनु दत्त्वा पयस्विनीम्।\nसुव्रतां वस्त्रसंवीतामग्निलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093115, "chapter_id": 2984, "verse_number": "१३-११४-१३", "content_sanskrit": "समानवत्सां धूम्रां तु धेनुं दत्त्वा पयस्विनीम्।\nसुव्रतां वस्त्रसंवीतां याम्यलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093116, "chapter_id": 2984, "verse_number": "१३-११४-१४", "content_sanskrit": "अपां फेनसवर्णां तु सवत्सां कांस्यदोहनाम्।\nप्रदाय वस्त्रसंवीतां वारुणं लोकमाप्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093117, "chapter_id": 2984, "verse_number": "१३-११४-१५", "content_sanskrit": "वातरेणुसवर्णां तु सवत्सां कांस्यदोहनाम्।\nप्रदाय वस्त्रसंवीतां वायुलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093118, "chapter_id": 2984, "verse_number": "१३-११४-१६", "content_sanskrit": "हिरण्यवर्णां पिङ्गाक्षीं सवत्सां कांस्यदोहनाम्।\nप्रदाय वस्त्रसंवीतां कौबेरं लोकमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2093119, "chapter_id": 2984, "verse_number": "१३-११४-१७", "content_sanskrit": "पलालधूम्रवर्णां तु सवत्सां कांस्यदोहनाम्।\nप्रदाय वस्त्रसंवीतां पितृलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2093120, "chapter_id": 2984, "verse_number": "१३-११४-१८", "content_sanskrit": "सवत्सां पीवरीं दत्त्वा दृतिकण्ठामलङ्कृताम्।\nवैश्वदेवमसम्बाधं स्थानं श्रेष्ठं प्रपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2093121, "chapter_id": 2984, "verse_number": "१३-११४-१९", "content_sanskrit": "समानवत्सां गौरीं तु धेनुं दत्त्वा पयस्विनीम्।\nसुव्रतां वस्त्रसंवीतां वसूनां लोकमाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2093122, "chapter_id": 2984, "verse_number": "१३-११४-२०", "content_sanskrit": "पाण्डुकम्बलवर्णाभां सवत्सां कांस्यकदोहनाम्।\nप्रदाय वस्त्रसंवीतां साध्यानां लोकमाप्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2093123, "chapter_id": 2984, "verse_number": "१३-११४-२१", "content_sanskrit": "वैराटपृष्ठमुक्षाणं सर्वरत्नैरलङ्कृतम्।\nप्रददन्मरुतां लोकान्स राजन्प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2093124, "chapter_id": 2984, "verse_number": "१३-११४-२२", "content_sanskrit": "वत्सोपपन्नां नीलां गां सर्वरत्नसमन्विताम्।\nगन्धर्वाप्सरसां लोकान्दत्त्वा प्राप्नोति मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2093125, "chapter_id": 2984, "verse_number": "१३-११४-२३", "content_sanskrit": "दृतिकण्ठमनड्वाहं सर्वरत्नैरलङ्कृतम्।\nदत्त्वा प्रजापतेर्लोकान्विशोकः प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2093126, "chapter_id": 2984, "verse_number": "१३-११४-२४", "content_sanskrit": "गोप्रदानरतो याति भित्त्वा जलदसञ्चयान्।\nविमानेनार्कवर्णेन दिवि राजन्विराजता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2093127, "chapter_id": 2984, "verse_number": "१३-११४-२५", "content_sanskrit": "तं चोरुवेषाः सुश्रोण्यः सहस्रं वारयोपितः।\nरमयन्ति नरश्रेष्ठं गोप्रदानरतं नरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2093128, "chapter_id": 2984, "verse_number": "१३-११४-२६", "content_sanskrit": "वीणानां वल्लकीनां च नू पुराणां च शिञ्जितैः।\nहासैश्च हरिणाक्षीणां सुप्तः सुप्रतिबोध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2093129, "chapter_id": 2984, "verse_number": "१३-११४-२७", "content_sanskrit": "यावन्ति रोमाणि भवन्ति धेन्वा-\nस्तावन्ति वर्षाणि महीयते सः।\nस्वर्गच्युतश्चापि ततो नृलोके\nकुले प्रसूतो विपुले विशोकः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2093130, "chapter_id": 2984, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चतुर्दशाधिकशततमोऽध्यायः॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]