[{"id": 7006445000, "chapter_id": 26445, "verse_number": "२-१०५-१", "content_sanskrit": "वैशम्पायन उवाच\nततः प्रवृद्धं युद्धं तु तुमुलं लोमहर्षणम् ।\nशम्बरस्य तु पुत्राणां रुक्मिण्या नन्दनस्य च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006445001, "chapter_id": 26445, "verse_number": "२-१०५-२", "content_sanskrit": "ततः क्रुद्धा महादैत्याः शरशक्तिपरश्वधान् ।\nचक्रतोमरकुन्तानि भुशुण्डीर्मुसलानि च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006445002, "chapter_id": 26445, "verse_number": "२-१०५-३", "content_sanskrit": "युगपत् पातयन्ति स्म प्रद्युम्नोपरि वेगिताः ।\nकार्ष्णायनिस्तु संक्रुद्धः सर्वास्त्रधनुषश्च्युतैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006445003, "chapter_id": 26445, "verse_number": "२-१०५-४", "content_sanskrit": "एकैकं पञ्चभिः क्रुद्धश्चिच्छेद रणमूर्धनि ।\nपुनरेवासुराः क्रुद्धाः सर्वे ते कृतनिश्चयाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006445004, "chapter_id": 26445, "verse_number": "२-१०५-५", "content_sanskrit": "ववृषुः शरजालानि प्रद्युम्नवधकाङ्क्षया ।\nततः प्रकुपितोऽनङ्गो धनुरादाय सत्वरः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006445005, "chapter_id": 26445, "verse_number": "२-१०५-६", "content_sanskrit": "शम्बरस्य जघानाशु दश पुत्रान् महौजसः ।\nततोऽपरेण भल्लेन कुपितः केशवात्मजः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006445006, "chapter_id": 26445, "verse_number": "२-१०५-७", "content_sanskrit": "चिच्छेदाशु शिरस्तस्य चित्रसेनस्य वीर्यवान् ।\nततस्ते हतशेषास्तु समेत्य समयुद्ध्यत ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006445007, "chapter_id": 26445, "verse_number": "२-१०५-८", "content_sanskrit": "शरवर्षं विमुञ्चन्तो ह्यभ्यधावञ्जिघांसितुम् ।\nततः संधाय बाणांस्ते विमुञ्चन्तो रणोत्सुकाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006445008, "chapter_id": 26445, "verse_number": "२-१०५-९", "content_sanskrit": "क्रीडन्निव महातेजाः शिरांस्येषामपातयत् ।\nनिहत्य समरे सर्वाञ्छतमुत्तमधन्विनाम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006445009, "chapter_id": 26445, "verse_number": "२-१०५-१०", "content_sanskrit": "प्रद्युम्नः समराकाङ्क्षी तस्थौ संग्राममूर्धनि ।\nहतं पुत्रशतं श्रुत्वा शम्बरः क्रोधमादधे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006445010, "chapter_id": 26445, "verse_number": "२-१०५-११", "content_sanskrit": "सूतं संचोदयामास रथं मे सम्प्रयोजय ।\nराज्ञो वाक्यं निशम्याथ प्रणम्य शिरसा भुवि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006445011, "chapter_id": 26445, "verse_number": "२-१०५-१२", "content_sanskrit": "ससैन्यं नोदयामास रथं स सुसमाहितम् ।\nयुक्तमृष्यसहस्रेण सर्पयोक्त्रेण योजितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006445012, "chapter_id": 26445, "verse_number": "२-१०५-१३", "content_sanskrit": "शार्दूलचर्मसंविष्टं किङ्किणीजालमालिनम् ।\nईहामृगगणाकीर्णं पङ्क्तिभक्तिविराजितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006445013, "chapter_id": 26445, "verse_number": "२-१०५-१४", "content_sanskrit": "ताराचित्रपिनद्धाङ्गं स्वर्णकृबरभूषितम् ।\nसुपताकमहोच्छ्रायं मृगराजोग्रकेतनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006445014, "chapter_id": 26445, "verse_number": "२-१०५-१५", "content_sanskrit": "सुविभक्तवरूथं च लोहेषावज्रकूबरम् ।\nमन्दरोदग्रशिखरं चारुचामरभूषितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006445015, "chapter_id": 26445, "verse_number": "२-१०५-१६", "content_sanskrit": "नक्षत्रमालापिहितं हेमदण्डसमाहितम् ।\nविराजमानं श्रीमन्तमारोहच्छम्बरो रथम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006445016, "chapter_id": 26445, "verse_number": "२-१०५-१७", "content_sanskrit": "काञ्चनं चित्रसंनाहं धनुर्गृह्य शरांस्तथा ।\nप्रस्थितः समराकाङ्क्षी मृत्युना परिचोदितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006445017, "chapter_id": 26445, "verse_number": "२-१०५-१८", "content_sanskrit": "चतुर्भिः सचिवैः सार्द्धं सैन्येन महता वृतः ।\nदुर्धरः केतुमाली च शत्रुहन्ता प्रमर्दनः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006445018, "chapter_id": 26445, "verse_number": "२-१०५-१९", "content_sanskrit": "एतैः परिवृतोऽमात्यैर्युयुत्सुः प्रस्थितो रणे ।\nदशनागसहस्राणि रथानां द्वे शते तथा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006445019, "chapter_id": 26445, "verse_number": "२-१०५-२०", "content_sanskrit": "हयानां चाष्टसाहस्रैः प्रयुतैश्च पदातिनाम् ।\nएतैः परिवृतो योधैः शम्बरः प्रययौ तदा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006445020, "chapter_id": 26445, "verse_number": "२-१०५-२१", "content_sanskrit": "प्रयातस्य तु संग्रामे उत्पाता बहवोऽभवन् ।\nगृध्रचक्राकुलं व्योम संध्याकाराभ्रनादितम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006445021, "chapter_id": 26445, "verse_number": "२-१०५-२२", "content_sanskrit": "गर्जन्ति परुषं मेघा निर्घातश्चाम्बरात् पतत् ।\nशिवा विनेदुरशिवं सैन्यं संकालयन्महत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006445022, "chapter_id": 26445, "verse_number": "२-१०५-२३", "content_sanskrit": "ध्श्जशीर्षेऽपतद्गृध्रः काङ्क्षन् वै दानवासृजम् ।\nरथाग्रे पतितश्चास्य कबन्धो भुवि दृश्यते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006445023, "chapter_id": 26445, "verse_number": "२-१०५-२४", "content_sanskrit": "चीचीकूचीति वाशन्ति शम्बरस्य रथोपरि ।\nस्वर्भानुग्रस्त आदित्यः परिघैः परिवेष्टितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006445024, "chapter_id": 26445, "verse_number": "२-१०५-२५", "content_sanskrit": "स्फुरते नयनं चास्य सव्यं भयनिवेदनम् ।\nबाहुः प्रकम्पते सव्यः प्रास्खलन्रथवाजिनः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006445025, "chapter_id": 26445, "verse_number": "२-१०५-२६", "content_sanskrit": "ध्वाङ्क्षो मूर्घ्नि निपतितः शम्बरस्य सुरारिणः ।\nववर्ष रुधिरं देवः शर्कराङ्गारमिश्रितम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006445026, "chapter_id": 26445, "verse_number": "२-१०५-२७", "content_sanskrit": "उल्कापातसहस्राणि निपेत् रणमूर्धनि ।\nप्रतोदो न्यपतद्धस्तात् सारथेर्हययायिनः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006445027, "chapter_id": 26445, "verse_number": "२-१०५-२८", "content_sanskrit": "एतानचिन्तयित्वा तु उत्पातान् समुपस्थितान् ।\nप्रययौ शम्बरः क्रुद्धः प्रद्युम्नवधकाङ्क्षया ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006445028, "chapter_id": 26445, "verse_number": "२-१०५-२९", "content_sanskrit": "भेरीमृदङ्गशङ्खानां पणवानकदुन्दुभेः ।\nयुगपन्नाद्यमानानां पृथिवी समकम्पत ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006445029, "chapter_id": 26445, "verse_number": "२-१०५-३०", "content_sanskrit": "तेन शब्देन महता संत्रस्ता मृगपक्षिणः ।\nसमन्ताद् दुद्रुवुस्तस्माद् भयविक्लवचेतसः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006445030, "chapter_id": 26445, "verse_number": "२-१०५-३१", "content_sanskrit": "रणमध्ये स्थितः कार्ष्णिश्चिन्तयन्निधनं रिपोः ।\nसैन्यैः परिवृतोऽसंख्यैर्युद्धाय कृतनिश्चयः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006445031, "chapter_id": 26445, "verse_number": "२-१०५-३२", "content_sanskrit": "क्रुद्धः शरसहस्रेण प्रद्युम्नं समताडयत् ।\nसम्प्राप्ताश्चैव तान् बाणांश्चिच्छेद कृतहस्तवत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006445032, "chapter_id": 26445, "verse_number": "२-१०५-३३", "content_sanskrit": "प्रद्युम्नो धनुरादाय शरवर्षं मुमोच ह ।\nतस्मिन्सैन्येन कोऽप्यस्ति यो न विद्धः शरेण वै ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006445033, "chapter_id": 26445, "verse_number": "२-१०५-३४", "content_sanskrit": "प्रद्युम्नशरपातेन तत् सैन्यं विमुखीकृतम् ।\nशम्बरस्य तथाभ्याशे स्थितं संहृत्य भीतवत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006445034, "chapter_id": 26445, "verse_number": "२-१०५-३५", "content_sanskrit": "स्वबलं विद्रुतं दृष्ट्वा शम्बरः क्रोधमूर्च्छितः ।\nआज्ञापयामास तदा सचिवान् दानवेश्वरः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006445035, "chapter_id": 26445, "verse_number": "२-१०५-३६", "content_sanskrit": "गच्छध्वं मन्नियोगेन प्रहरध्वं रिपोः सुतम् ।\nनोपेक्षणीयः शत्रुर्वै वध्यतां क्षिप्रमेष वै ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006445036, "chapter_id": 26445, "verse_number": "२-१०५-३७", "content_sanskrit": "उपेक्षित इव व्याधिः शरीरं नाशयेद् धुवम् ।\nतदेष दुर्मतिः पापो वध्यतां मत्प्रियेप्सया ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006445037, "chapter_id": 26445, "verse_number": "२-१०५-३८", "content_sanskrit": "ततस्ते सचिवाः कुद्धाः शिरसा गृह्य शासनम् ।\nशरवर्षं विमुञ्चन्तस्त्वरिता नोदयन् रथान् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006445038, "chapter_id": 26445, "verse_number": "२-१०५-३९", "content_sanskrit": "तान् दृष्ट्वा धावतः संख्ये क्रुद्धो मकरकेतनः ।\nचापमुद्यम्य सम्भ्रान्तस्तस्थौ प्रमुखतो बली ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006445039, "chapter_id": 26445, "verse_number": "२-१०५-४०", "content_sanskrit": "दुर्धरं पञ्चविंशत्या शरैः संनतपर्वभिः ।\nबिभेद सुमहातेजाः केतुमालिं त्रिषष्टिभिः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006445040, "chapter_id": 26445, "verse_number": "२-१०५-४१", "content_sanskrit": "सप्तत्या शत्रुहन्तारं द्व्यशीत्या तु प्रमर्दनम् ।\nबिभेद परमामर्षी रुक्मिण्या नन्दिवर्धनः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006445041, "chapter_id": 26445, "verse_number": "२-१०५-४२", "content_sanskrit": "ततस्ते सचिवाः क्रुद्धाः प्रद्युम्नं शरवृष्टिभिः।\nएकैकशो बिभेदाजौ षष्टिभिः षष्टिभिः शरैः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006445042, "chapter_id": 26445, "verse_number": "२-१०५-४३", "content_sanskrit": "तानप्राप्ताञ्छरान् बाणैश्चिच्छेद मकरध्वजः ।\nततोऽर्द्धचन्द्रमादाय दुर्द्धरस्य स सारथिम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006445043, "chapter_id": 26445, "verse_number": "२-१०५-४४", "content_sanskrit": "जघान पश्यतां राज्ञां सर्वेषां सैनिकस्य वै ।\nचतुर्भिरथ नाराचैः सुपर्वैः कङ्कतेजितैः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006445044, "chapter_id": 26445, "verse_number": "२-१०५-४५", "content_sanskrit": "जघान चतुरः सोऽश्वान्दुर्धरस्य रथं प्रति ।\nएकेन योक्त्रं छत्रं च ध्वजमेकेन बन्धुरम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006445045, "chapter_id": 26445, "verse_number": "२-१०५-४६", "content_sanskrit": "षष्ट्या च युगचक्राक्षं चिच्छेद मकरध्वजः ।\nअथापरं शरं गृह्य कङ्कपत्रं सुतेजितम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006445046, "chapter_id": 26445, "verse_number": "२-१०५-४७", "content_sanskrit": "मुमोच हृदये तस्य दुर्द्धरस्यान्यजीविनः ।\nस गतासुर्गतश्रीको गतसत्त्वो गतप्रभः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006445047, "chapter_id": 26445, "verse_number": "२-१०५-४८", "content_sanskrit": "निपपात रथोपस्थात् क्षीणपुण्य इव ग्रहः ।\nदुर्धरे निहते शूरे दानवे दानवेश्वरः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006445048, "chapter_id": 26445, "verse_number": "२-१०५-४९", "content_sanskrit": "केतुमाली शरव्रातैरभिदुद्राव कृष्णजम् ।\nप्रद्युम्नमथ संक्रुद्धो भ्रुकुटीभीषणाननः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006445049, "chapter_id": 26445, "verse_number": "२-१०५-५०", "content_sanskrit": "कृत्वाभ्यधावत्सहसा तिष्ठ तिष्ठेति चाब्रवीत् ।\nसंक्रुद्धः कृष्णसूनुस्तु शरवर्षैरवाकिरत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006445050, "chapter_id": 26445, "verse_number": "२-१०५-५१", "content_sanskrit": "पर्वतं वारिधाराभिः प्रावृषीव यथा घनः ।\nस विद्धो दानवामात्यः प्रद्युम्नेन धनुष्मता ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006445051, "chapter_id": 26445, "verse_number": "२-१०५-५२", "content_sanskrit": "चक्रमादाय चिक्षेप प्रद्युम्नवधकाङ्क्षया ।\nतं तु प्राप्तं सहस्रारं कृष्णचक्रसमद्युतिम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006445052, "chapter_id": 26445, "verse_number": "२-१०५-५३", "content_sanskrit": "निपत्योत्पत्य सहसा सर्वेषामेव पश्यताम् ।\nतेनैव तस्य चिच्छेद केतुमालेः शिरस्तदा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006445053, "chapter_id": 26445, "verse_number": "२-१०५-५४", "content_sanskrit": "तद् दृष्ट्वा कर्म विपुलं रौक्मिणेयस्य देवराट् ।\nविस्मयं परमं प्राप्तः सर्वैर्देवगणैः सह ।\nगन्धर्वाप्सरसश्चैव पुष्पवर्षैरवाकिरन् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006445054, "chapter_id": 26445, "verse_number": "२-१०५-५५", "content_sanskrit": "केतुमालिं हतं दृष्ट्वा शत्रुहन्ता प्रमर्दनः ।\nमहाबलसमूहेन प्रद्युम्नमथ दुद्रुवे ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006445055, "chapter_id": 26445, "verse_number": "२-१०५-५६", "content_sanskrit": "ते गदां मुसलं चक्रं प्रासतोमरसायकान् ।\nभिन्दिपालान्कुठारांश्च भास्वरान्कूटमुद्गरान् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006445056, "chapter_id": 26445, "verse_number": "२-१०५-५७", "content_sanskrit": "युगपत् संक्षिपन्ति स्म वधार्थं कृष्णनन्दने ।\nसोऽपि तान्यस्त्रजालानि शस्त्रजालैरनेकधा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006445057, "chapter_id": 26445, "verse_number": "२-१०५-५८", "content_sanskrit": "चिच्छेद बहुधा वीरो दर्शयन्पाणिलाघवम् ।\nगजान्सोऽभ्यहनत्कुद्धो गजारोहान्सहस्रशः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006445058, "chapter_id": 26445, "verse_number": "२-१०५-५९", "content_sanskrit": "रथान् सारथिभिः सार्धं हयांश्चैव ममर्द ह ।\nपातयंस्ताञ्छरव्रातैर्नाविद्धः कश्चिदीक्ष्यते ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006445059, "chapter_id": 26445, "verse_number": "२-१०५-६०", "content_sanskrit": "एवं सर्वाणि सैन्यानि ममन्थ मकरध्वजः ।\nनदीं प्रावर्तयद् घोरां शोणिताम्बुतरङ्गिणीम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006445060, "chapter_id": 26445, "verse_number": "२-१०५-६१", "content_sanskrit": "मुक्ताहारोर्मिबहुलां मांसमेदःसपङ्किनीम् ।\nछत्रद्वीपां शरावर्तां रथैः पुलिनमण्डिताम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006445061, "chapter_id": 26445, "verse_number": "२-१०५-६२", "content_sanskrit": "केयूरकुण्डलाकूर्मां ध्वजमत्स्यविभूषिताम् ।\nनागग्राहवतीं रौद्रामसिनक्रविभूषिताम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006445062, "chapter_id": 26445, "verse_number": "२-१०५-६३", "content_sanskrit": "केशशैवलसंछन्नां श्रोणिसूत्रमृणालिकाम् ।\nवराननसुपद्मां च हंमचामरवीजिताम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006445063, "chapter_id": 26445, "verse_number": "२-१०५-६४", "content_sanskrit": "शिरस्तिमिसमाकीर्णो शोणितौघप्रवर्तिनीम् ।\nनदीं दुस्तरणीं भीमामनङ्गेन प्रवर्तिताम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006445064, "chapter_id": 26445, "verse_number": "२-१०५-६५", "content_sanskrit": "दुष्प्रेक्षां दुर्गमां रौद्रां हीनतेजःसुदुस्तराम् ।\nशस्त्रग्राहवतीं घोरां यमराष्ट्रविवर्द्धनीम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006445065, "chapter_id": 26445, "verse_number": "२-१०५-६६", "content_sanskrit": "तत्र रुक्मिसुतः श्रीमान्विलोडयति धन्विनः ।\nशत्रुहन्तारमाश्रित्य शरानभ्यकिरद् बहून् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006445066, "chapter_id": 26445, "verse_number": "२-१०५-६७", "content_sanskrit": "शत्रुहन्ता पुनः क्रुद्धो मुमोच शरमुत्तमम् ।\nप्रद्युम्नस्य समासाद्य हृदये निपपात ह ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006445067, "chapter_id": 26445, "verse_number": "२-१०५-६८", "content_sanskrit": "स विद्धस्तेन बाणेन प्रद्युम्नो न व्यकम्पत ।\nशक्तिं जग्राह बलवाञ्छत्रुहन्त्रे मुमूर्षवे ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006445068, "chapter_id": 26445, "verse_number": "२-१०५-६९", "content_sanskrit": "सा क्षिप्ता रौक्मिणेयेन शक्तिर्ज्वालाकुला रणे ।\nपपात हृदयं भित्त्वा शक्राशनिसमस्वना ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006445069, "chapter_id": 26445, "verse_number": "२-१०५-७०", "content_sanskrit": "स भिन्नहृच्च स्रस्ताङ्गो मुक्तमर्मास्थिबन्धनः ।\nपपात रुधिरोद्गारी शत्रुहन्ता महाबलः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006445070, "chapter_id": 26445, "verse_number": "२-१०५-७१", "content_sanskrit": "पतितं शत्रुहन्तारं दृष्ट्वा तस्थौ प्रमर्दनः ।\nजग्राह मुसलं सोऽथ वचनं चेदमाददे ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006445071, "chapter_id": 26445, "verse_number": "२-१०५-७२", "content_sanskrit": "तिष्ठ किं प्राकृतैरेभिः करिष्यसि रणप्रियः ।\nमां योधयस्व दुर्बुद्धे ततस्त्वं न भविष्यसि ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006445072, "chapter_id": 26445, "verse_number": "२-१०५-७३", "content_sanskrit": "वृष्णिवंशकुले जातः शत्रुरस्मत्पिता तव ।\nपुत्रं हन्तास्त्वहं तस्य ततोऽसौ निहतो भवेत् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006445073, "chapter_id": 26445, "verse_number": "२-१०५-७४", "content_sanskrit": "मृतेन तेन दुर्बुद्धे सर्वदेवक्षयो भवेत् ।\nदैतेया दानवाः सर्वे मोदन्तां हतशत्रवः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006445074, "chapter_id": 26445, "verse_number": "२-१०५-७५", "content_sanskrit": "हते त्वयि ममास्त्रेण त्वत्समुत्थैश्च शोणितैः ।\nशम्बरस्य तु पुत्राणां करोम्युदकसत्क्रियाम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006445075, "chapter_id": 26445, "verse_number": "२-१०५-७६", "content_sanskrit": "अद्य सा भीष्मकसुता करुणं विलपिष्यति ।\nनिहतं त्वां च श्रुत्वैव यौवनस्थं गतायुषम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006445076, "chapter_id": 26445, "verse_number": "२-१०५-७७", "content_sanskrit": "स ते पिता चक्रधरो निष्फलाशो भविष्यति ।\nहतं त्वां स विदित्वाथ प्राणांस्त्यक्ष्यति मन्दधीः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006445077, "chapter_id": 26445, "verse_number": "२-१०५-७८", "content_sanskrit": "इत्युक्त्वा परिघेणाशु ताडयद्रुक्मिणीसुतम् ।\nताडितो हि महातेजा रौक्मिणेयः प्रतापवान् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006445078, "chapter_id": 26445, "verse_number": "२-१०५-७९", "content_sanskrit": "दोर्भ्यामुत्क्षिप्य तस्यैव रथ मह्यां व्यचूर्णयत् ।\nसोऽवप्लुत्य रथात्तस्मात्पदातिरवतस्थिवान् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006445079, "chapter_id": 26445, "verse_number": "२-१०५-८०", "content_sanskrit": "तां गदां गृह्य सहसा रौक्मिणेयमुपाद्रवत् ।\nतयैव गदया कामः प्रमर्दनमपोथयत् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006445080, "chapter_id": 26445, "verse_number": "२-१०५-८१", "content_sanskrit": "हते प्रमर्दने दैत्ये दृष्ट्वा सर्वे प्रदुद्रुवुः ।\nन शक्ताः प्रमुखे स्थातुं सिंहत्रासाद् गजा इव ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006445081, "chapter_id": 26445, "verse_number": "२-१०५-८२", "content_sanskrit": "सारमेयं यथा दृष्ट्वाविगणो वै पलायते ।\nतथा सेना विषीदन्ती प्रद्युम्नस्य भयार्दिता ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006445082, "chapter_id": 26445, "verse_number": "२-१०५-८३", "content_sanskrit": "क्षतजादिग्धवस्त्रा वै मुक्तकेशा विशोभना ।\nरजस्वलेव युवतिः सेना समवगूहते ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006445083, "chapter_id": 26445, "verse_number": "२-१०५-८४", "content_sanskrit": "मदनशरविभिन्ना सैनिकानभ्ययायाद्\nयुवतिसदृशवेषा साध्वसैः पीड्यमाना ।\nरतिसमरमशक्ता वीक्षितुं सोच्छ्वसन्ती\nस्वगृहगमनकामा नेच्छते स्थातुमत्र ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}]