[{"id": 7004457000, "chapter_id": 24457, "verse_number": "५-३-१५१-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nउत्तरे नर्मदाकूले तीर्थं परमशोभनम् ।\nजयवाराहमाहात्म्यं सर्वपापप्रणाशनम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004457001, "chapter_id": 24457, "verse_number": "५-३-१५१-२", "content_sanskrit": "उद्धृता जगती येन सर्वदेवनमस्कृता ।\nलोकानुग्रहबुद्ध्या च संस्थितो नर्मदातटे॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004457002, "chapter_id": 24457, "verse_number": "५-३-१५१-३", "content_sanskrit": "तत्र तीर्थे तु यः स्नात्वा वीक्षते मधुसूदनम् ।\nमुच्यते सर्वपापेभ्यो दशजन्मानुकीर्तनात्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004457003, "chapter_id": 24457, "verse_number": "५-३-१५१-४", "content_sanskrit": "मत्स्यः कूर्मो वराहश्च नरसिंहोऽथ वामनः ।\nरामो रामश्च कृष्णश्च बुद्धः कल्किश्च ते दश॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004457004, "chapter_id": 24457, "verse_number": "५-३-१५१-५", "content_sanskrit": "युधिष्ठिर उवाच ।\nमत्स्येन किं कृतं तात कूर्मेण मुनिसत्तम ।\nवराहेण च किं कर्म नरसिंहेन किं कृतम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004457005, "chapter_id": 24457, "verse_number": "५-३-१५१-६", "content_sanskrit": "वामनेन च रामेण राघवेण च किं कृतम् ।\nबुद्धरूपेण किं वापि कल्किना किं कृतं वद॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004457006, "chapter_id": 24457, "verse_number": "५-३-१५१-७", "content_sanskrit": "एवमुक्तस्तु विप्रेन्द्रो धर्मपुत्रेण धीमता ।\nउवाच मधुरां वाणीं तदा धर्मसुतं प्रति॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004457007, "chapter_id": 24457, "verse_number": "५-३-१५१-८", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nमीनो भूत्वा पुरा कल्पे प्रीत्यर्थं ब्रह्मणो विभुः ।\nसमर्पयत्समुद्धृत्य वन्दान्मग्नान्महार्णवे॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004457008, "chapter_id": 24457, "verse_number": "५-३-१५१-९", "content_sanskrit": "अमृतोत्पादने राजन्कूर्मो भूत्वा जगद्गुरुः ।\nमन्दरं धारयामास तथा देवीं वसुंधराम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004457009, "chapter_id": 24457, "verse_number": "५-३-१५१-१०", "content_sanskrit": "उज्जहार धरां मग्नां पातालतलवासिनीम् ।\nवाराहं रूपमास्थाय देवदेवो जनार्दनः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004457010, "chapter_id": 24457, "verse_number": "५-३-१५१-११", "content_sanskrit": "नरस्यार्द्धतनुं कृत्वा सिंहस्यार्द्धतनुं तथा ।\nहिरण्यकशिपोर्वक्षो विददार नखाङ्कुशैः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004457011, "chapter_id": 24457, "verse_number": "५-३-१५१-१२", "content_sanskrit": "जटी वामनरूपेण स्तूयमानो द्विजोत्तमैः ।\nतद्दिव्यं रूपमास्थाय क्रमित्वा मेदिनीं क्रमैः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004457012, "chapter_id": 24457, "verse_number": "५-३-१५१-१३", "content_sanskrit": "कृतवांश्च बलिं पश्चात्पातालतलवासिनम् ।\nस्थापयित्वा सुरान् सर्वान् गतो विष्णुः स्वकं पुरम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004457013, "chapter_id": 24457, "verse_number": "५-३-१५१-१४", "content_sanskrit": "जमदग्निसुतो रामो भूत्वा शस्त्रभृतां वरः ।\nक्षत्रियान् पृथिवीपालानवधीद्धैहयादिकान्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004457014, "chapter_id": 24457, "verse_number": "५-३-१५१-१५", "content_sanskrit": "कश्यपाय महीं दत्त्वा सपर्वतवनाकराम् ।\nतपस्तपति देवेशो महेन्द्रेऽद्यापि भारत॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004457015, "chapter_id": 24457, "verse_number": "५-३-१५१-१६", "content_sanskrit": "ततो दाशरथी रामो रावणं देवकण्टकम् ।\nसगणं समरे हत्वा राज्यं दत्त्वा विभीषणे॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004457016, "chapter_id": 24457, "verse_number": "५-३-१५१-१७", "content_sanskrit": "पालयित्वा नयाद्भूमिं मखैः संतर्प्य देवताः ।\nस्वर्गं गतो महातेजा रामो राजीवलोचनः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004457017, "chapter_id": 24457, "verse_number": "५-३-१५१-१८", "content_sanskrit": "वसुदेवगृहे भूयः संकर्षणसहायवान् ।\nअवतीर्णो जगन्नाथो वासुदेवो युधिष्ठिर॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004457018, "chapter_id": 24457, "verse_number": "५-३-१५१-१९", "content_sanskrit": "सोऽवधीत्तव सामर्थ्याद्वधार्थं दुष्टभूभृताम् ।\nचाणूरकंसकेशीनां जरासंधस्य भारत॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004457019, "chapter_id": 24457, "verse_number": "५-३-१५१-२०", "content_sanskrit": "तेन त्वं सुसहायेन हत्वा शत्रून्नरेश्वर ।\nभोक्ष्यसे पृथिवीं सर्वां भ्रातृभिः सह संभृताम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004457020, "chapter_id": 24457, "verse_number": "५-३-१५१-२१", "content_sanskrit": "तथा बुद्धत्वमपरं नवमं प्राप्स्यतेऽच्युतः ।\nशान्तिमान्देवदेवेशो मधुहन्ता मधुप्रियः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004457021, "chapter_id": 24457, "verse_number": "५-३-१५१-२२", "content_sanskrit": "तेन बुद्धस्वरूपेण देवेन परमेष्ठिना ।\nभविष्यति जगत्सर्वं मोहितं सचराचरम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004457022, "chapter_id": 24457, "verse_number": "५-३-१५१-२३", "content_sanskrit": "न श्रोष्यन्ति पितुः पुत्रास्तदाप्रभृति भारत ।\nन गुरोर्बान्धवाः शिष्या भविष्यत्यधरोत्तरम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004457023, "chapter_id": 24457, "verse_number": "५-३-१५१-२४", "content_sanskrit": "जितो धर्मो ह्यधर्मेण चासत्येन ऋतं जितम् ।\nजिताश्चौरैश्च राजानः स्त्रीभिश्च पुरुषा जिताः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004457024, "chapter_id": 24457, "verse_number": "५-३-१५१-२५", "content_sanskrit": "सीदन्ति चाग्निहोत्राणि गुरौ पूजा प्रणश्यति ।\nसीदन्ति मानवा धर्माः कलौ प्राप्ते युधिष्ठिर॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004457025, "chapter_id": 24457, "verse_number": "५-३-१५१-२६", "content_sanskrit": "द्वादशे दशमे वर्षे नारी गर्भवती भवेत् ।\nकन्यास्तत्र प्रसूयन्ते ब्राह्मणो हरिपिङ्गलः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004457026, "chapter_id": 24457, "verse_number": "५-३-१५१-२७", "content_sanskrit": "भविष्यति ततः कल्किर्दशमे जन्मनि प्रभुः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004457027, "chapter_id": 24457, "verse_number": "५-३-१५१-२८", "content_sanskrit": "एतत्ते कथितं राजन्देवस्य परमेष्ठिनः ।\nकारणं दश जन्मनां सर्वपापक्षयंकरम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]