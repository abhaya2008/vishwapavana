[{"id": 2149513, "chapter_id": 4236, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2149514, "chapter_id": 4236, "verse_number": "१", "content_sanskrit": "समुद्यतोयं भारो मे सुमहान् सागरोपमः ।\nधार्तराष्ट्रस्य सङ्ग्रामे वर्षपूगाभिचिन्तितः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2149515, "chapter_id": 4236, "verse_number": "२", "content_sanskrit": "तस्मिन्नभ्यागते काले प्रतप्ते लोमहर्षणे ।\nमिथो भेदो न मे कार्यस्तेन जीवसि सूतज\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2149516, "chapter_id": 4236, "verse_number": "३", "content_sanskrit": "न ह्यहं त्वद्य विक्रम्य स्थविरोऽपि शिशोस्तव ।\nयुद्धश्रद्धां रणे छिन्द्यां जीवितस्य च सूतज\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2149517, "chapter_id": 4236, "verse_number": "४", "content_sanskrit": "जामदग्न्येन रामेण महास्त्राणि प्रमुञ्चता ।\nन मे व्यथा कृता काचित् त्वं तु मे किं करिष्यसि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2149518, "chapter_id": 4236, "verse_number": "५", "content_sanskrit": "कामं नैतत् प्रशंसन्ति सन्तः आत्मबलस्तवम् ।\nवक्ष्यामि त्वां तु सन्तप्तो निहीन कुलपांसन\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2149519, "chapter_id": 4236, "verse_number": "६", "content_sanskrit": "समेतं पार्थिवं क्षत्रं काशिराजस्वयंवरे ।\nनिर्जित्यैकरथेनैव याः कन्यास्तरसा हृताः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2149520, "chapter_id": 4236, "verse_number": "७", "content_sanskrit": "ईदृशानां सहस्राणि विशिष्टानामथो पुनः ।\nमयैकेन निरस्तानि ससैन्यानि रणाजिरे\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2149521, "chapter_id": 4236, "verse_number": "८", "content_sanskrit": "त्वां प्राप्य वै कापुरुषं कुरूणामनयो महान् ।\nउपस्थितो विनाशाय यतस्व पुरुषो भव\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2149522, "chapter_id": 4236, "verse_number": "९", "content_sanskrit": "युध्यस्व समरे पार्थं येन विस्पर्धसे सह ।\nद्रक्ष्यामि त्वां विनिर्मुक्तमस्माद् युद्धात् सुदुर्मते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2149523, "chapter_id": 4236, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2149524, "chapter_id": 4236, "verse_number": "१०", "content_sanskrit": "तमुवाच ततो राजा धार्तराष्ट्रः प्रतापवान्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2149525, "chapter_id": 4236, "verse_number": "११", "content_sanskrit": "मां समीक्षस्व गाङ्गेय कार्यं हि महदुद्यतम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2149526, "chapter_id": 4236, "verse_number": "१२", "content_sanskrit": "चिन्त्यतामिदमेकाग्रं मम निश्रेयसं परम् ।\nउभावपि भवन्तौ मे महत् कर्म करिष्यतः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2149527, "chapter_id": 4236, "verse_number": "१३", "content_sanskrit": "भूयश्च श्रोतुमिच्छामि परेषां रथसत्तमान् ।\nये चैवातिरथास्तत्र ये चैव रथयूथपाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2149528, "chapter_id": 4236, "verse_number": "१४", "content_sanskrit": "बलाबलममित्राणां श्रोतुमिच्छामि कौरव ।\nप्रभातायां तु शर्वर्यामिदं युद्धं भविष्यति\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2149529, "chapter_id": 4236, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2149530, "chapter_id": 4236, "verse_number": "१५", "content_sanskrit": "एते रथास्तवाख्यातास्तथैवातिरथा नृप ।\nये चाप्यर्धरथा राजन् पाण्डवानामतः शृणु\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2149531, "chapter_id": 4236, "verse_number": "१६", "content_sanskrit": "यदि कौतूहलं तेऽद्य पाण्डवानां निबोध मे ।\nरथसङ्ख्यां शृणुष्व त्वं सहैभिर्वसुधाधिपैः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2149532, "chapter_id": 4236, "verse_number": "१७", "content_sanskrit": "स्वयं राजा रथोदारः पाण्डवः कुन्तिनन्दनः ।\nअग्निवत् समरे तात चरिष्यति न संशयः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2149533, "chapter_id": 4236, "verse_number": "१८", "content_sanskrit": "भीमसेनस्तु राजेन्द्र रथोऽष्टगुणसम्मितः ।\nनागायुतबलो मानी तेजसा न स मानुषः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2149534, "chapter_id": 4236, "verse_number": "१९", "content_sanskrit": "माद्रीपुत्रौ तु रथिनौ द्वावेव पुरुषर्षभौ ।\nअश्विनाविव रूपेण तेजसा च समन्वितौ\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2149535, "chapter_id": 4236, "verse_number": "२०", "content_sanskrit": "एते चमूमुखगताः स्मरन्तः क्लेशमात्मनः ।\nरुद्रवत् प्रचरिष्यन्ति तत्र मे नास्ति संशयः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2149536, "chapter_id": 4236, "verse_number": "२१", "content_sanskrit": "सर्व एव महात्मानः सालस्तम्भा इवोद्गताः ।\nप्रादेशेनाधिकाः पुम्भिरन्यैस्ते च प्रमाणतः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2149537, "chapter_id": 4236, "verse_number": "२२", "content_sanskrit": "सिंहसंहननाः सर्वे पाण्डुपुत्रा महाबलाः ।\nचरितब्रह्मचर्याश्च सर्वे तात तपस्विनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2149538, "chapter_id": 4236, "verse_number": "२३", "content_sanskrit": "ह्रीमन्तः पुरुषव्याघ्रा व्याघ्रा इव बलोत्कटाः ।\nजवे प्रहारे सम्मर्दे सर्व एवातिमानुषाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2149539, "chapter_id": 4236, "verse_number": "२४", "content_sanskrit": "सर्वैर्जिता महीपाला दिग्जये भरतर्षभ\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2149540, "chapter_id": 4236, "verse_number": "२५", "content_sanskrit": "न चैषां पुरुषाः केचिदायुधानि गदाः शरान् ।\nविषहन्ति सदा कर्तुमधिज्यानपि कौरव\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2149541, "chapter_id": 4236, "verse_number": "२६", "content_sanskrit": "उद्यन्तुं वा गदा गुर्वीः शरान् वा क्षेप्तुमाहवे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2149542, "chapter_id": 4236, "verse_number": "२७", "content_sanskrit": "जवे लक्षस्य हरणे भङ्गे चापि विकर्षणे ।\nबालैरपि भवन्तस्तैः सर्व एव विशेषिताः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2149543, "chapter_id": 4236, "verse_number": "२८", "content_sanskrit": "एतत् सैन्यं समासाद्य व्याघ्रा इव बलोत्कटाः ।\nविध्वंसयिष्यन्ति रणे मा स्म तैः सह सङ्गमः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2149544, "chapter_id": 4236, "verse_number": "२९", "content_sanskrit": "एकैकशस्ते सङ्ग्रामे हन्युः सर्वान् महीक्षितः ।\nप्रत्यक्षं तव राजेन्द्र राजसूये यथाऽभवत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2149545, "chapter_id": 4236, "verse_number": "३०", "content_sanskrit": "द्रौपद्याश्च परिक्लेशं द्यूते च परुषा गिरः ।\nते स्मरन्तश्च सङ्ग्रामे विचरिष्यन्ति रुद्रवत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2149546, "chapter_id": 4236, "verse_number": "३१", "content_sanskrit": "लोहिताक्षो गुडाकेशो नारायणसहायवान् ।\nउभयोः सेनयोर्वीरो रथो नास्तीह तादृशः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2149547, "chapter_id": 4236, "verse_number": "३२", "content_sanskrit": "न हि देवेषु वा पूर्वं दानवेषूरगेषु वा ।\nराक्षसेष्वथ यक्षेषु नरेषु कुत एव तु\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2149548, "chapter_id": 4236, "verse_number": "३३", "content_sanskrit": "भूतोऽथवा भविष्यो वा रथः कश्चिन्मया श्रुतः ।\nसमायुक्तो महाराज रथः पार्थस्य धीमतः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2149549, "chapter_id": 4236, "verse_number": "३४", "content_sanskrit": "वासुदेवश्च संयन्ता रथश्चैवात्र तादृशः ।\nगाण्डीवं च धनुर्दिव्यं ते चाश्वा वातरंहसः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2149550, "chapter_id": 4236, "verse_number": "३५", "content_sanskrit": "अभेद्यकवचं दिव्यमक्षय्यौ च महेषुधी ।\nअस्त्रग्रामश्च माहेन्द्रो रौद्रः कौबेर एव च\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2149551, "chapter_id": 4236, "verse_number": "३६", "content_sanskrit": "याम्यश्च वारुणश्चैव गदाश्चोग्रप्रदर्शनाः ।\nवज्रादीनि च मुख्यानि नानाप्रहरणानि वै\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2149552, "chapter_id": 4236, "verse_number": "३७", "content_sanskrit": "दानवानां सहस्राणि हिरण्यपुरवासिनाम् ।\nहतान्येकरथेनाजौ कस्तस्य सदृशो रथः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2149553, "chapter_id": 4236, "verse_number": "३८", "content_sanskrit": "एष हन्याद्धि संरम्भी बलवान् सत्यसङ्गरः ।\nभवत्सेनां महाबाहुः स्वां चैव परिपालयन्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2149554, "chapter_id": 4236, "verse_number": "३९", "content_sanskrit": "अहं चैनं प्रत्युदीयामाचार्यो वा धनञ्जयम् ।\nन तृतीयोऽस्ति राजेन्द्र सेनयोरुभयोरपि\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2149555, "chapter_id": 4236, "verse_number": "४०", "content_sanskrit": "य एनं शरवर्षाणि मुञ्चन्तमुदियाद् रथी ।\nजीमूत इव घर्मान्ते महावातसमीरितः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2149556, "chapter_id": 4236, "verse_number": "४१", "content_sanskrit": "समायुक्तस्तु कौन्तेयो वासुदेवसहायवान् ।\nतरुणश्च कृती चैव जीर्णौ चावामुभावपि\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2149557, "chapter_id": 4236, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2149558, "chapter_id": 4236, "verse_number": "४२", "content_sanskrit": "एतच्छ्रुत्वा तु भीष्मस्य राज्ञां दध्वंसिरे तदा ।\nकाञ्चनाङ्गदिनः पीना भुजाश्चन्दनरूषिताः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2149559, "chapter_id": 4236, "verse_number": "४३", "content_sanskrit": "मनोभिः सहसा वेगैः संस्मृत्य च पुरातनम् ।\nसामर्थ्यं पाण्डवेयानां यथा प्रत्यक्षदर्शनात्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2149560, "chapter_id": 4236, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि सप्तषष्ट्युत्तरशततमोऽध्यायः ॥१६७॥\nरथातिरथसङ्ख्यानपर्वणि पञ्चमोऽध्यायः ॥५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]