[{"id": 2072809, "chapter_id": 2539, "verse_number": "१२-४४-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2072810, "chapter_id": 2539, "verse_number": "१२-४४-१", "content_sanskrit": "प्राप्य राज्यं महाबाहुर्धर्मपुत्रो युधिष्ठिरः।\nयदन्यदकरोद्विप्र तन्मे वक्तुमिहार्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2072811, "chapter_id": 2539, "verse_number": "१२-४४-२", "content_sanskrit": "भगवान्वा हृषीकेशस्त्रैलोक्यस्य परो गुरुः।\nऋषे यदकरोद्वीरस्तच्च व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2072812, "chapter_id": 2539, "verse_number": "१२-४४-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2072813, "chapter_id": 2539, "verse_number": "१२-४४-३", "content_sanskrit": "शृणु तत्त्वेन राजेन्द्र कीर्त्यमानं मयाऽनघ।\nवासुदेवं पुरस्कृत्य यदकुर्वत पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2072814, "chapter_id": 2539, "verse_number": "१२-४४-४", "content_sanskrit": "प्राप्य राज्यं महाराज कुन्तीपुत्रो युधिष्ठिरः।\nवर्णान्संस्थापयामास नयेन विनयेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2072815, "chapter_id": 2539, "verse_number": "१२-४४-५", "content_sanskrit": "ब्राह्मणानां सहस्रं च स्नातकानां महात्मनाम्।\nसहस्रनिष्कैरेकैकं तर्पयामास पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2072816, "chapter_id": 2539, "verse_number": "१२-४४-६", "content_sanskrit": "तथाऽनुजीविनो भृत्यान्संश्रितानतिथीनपि।\nकामैः संतर्पयामास कृपणांस्तार्किकानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2072817, "chapter_id": 2539, "verse_number": "१२-४४-७", "content_sanskrit": "पुरोहिताय धौम्याय प्रादादयुतशः स गाः।\nधनं सुवर्णं रजतं वासांसि विविधान्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2072818, "chapter_id": 2539, "verse_number": "१२-४४-८", "content_sanskrit": "कृपाय च महाराज पितृवत्तमतर्पयत्।\nविदुराय च राजाऽसौ पूजां चक्रे यतव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2072819, "chapter_id": 2539, "verse_number": "१२-४४-९", "content_sanskrit": "भक्ष्यान्नपानैर्विविधैर्वासोभिः शयनासनैः।\nसर्वान्संतोपयामास संश्रितान्ददतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2072820, "chapter_id": 2539, "verse_number": "१२-४४-१०", "content_sanskrit": "लब्धप्रशमनं कृत्वा स राजा राजसत्तम।\nयुयुत्सोर्धार्तराष्ट्रस्य पूजां चक्रे महायेशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2072821, "chapter_id": 2539, "verse_number": "१२-४४-११", "content_sanskrit": "धृतराष्ट्राय तद्राज्यं गान्धार्यै विदुराय च।\nनिवेद्य सुस्थवद्राजा सुखमास्ते युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2072822, "chapter_id": 2539, "verse_number": "१२-४४-१२", "content_sanskrit": "तथा सर्वं स नगरं प्रसाद्य भरतर्षभ।\nवासुदेवं महात्मानमभ्यगच्छत्कृताञ्जलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2072823, "chapter_id": 2539, "verse_number": "१२-४४-१३", "content_sanskrit": "ततो महति पर्यङ्के मणिकाञ्चनभूषिते।\nददर्श कृष्णमासीनं नीलं मेराविवाम्बुदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2072824, "chapter_id": 2539, "verse_number": "१२-४४-१४", "content_sanskrit": "जाज्वल्यमानं वपुषा दिव्याभरणभूषितम्।\nपीतकौशेयवसनं हेम्नेवोपगत मणिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2072825, "chapter_id": 2539, "verse_number": "१२-४४-१५", "content_sanskrit": "कौस्तुभेनोरसिस्थेन मणिनाऽभिविराजितम्।\nउद्यतेवोदयं शैलं सूर्येणाभिविराजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2072826, "chapter_id": 2539, "verse_number": "१२-४४-१६", "content_sanskrit": "नौपम्यं विद्यते तस्य त्रिषु लोकेषु किंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2072827, "chapter_id": 2539, "verse_number": "१२-४४-१७", "content_sanskrit": "सोऽभिगम्य महात्मानं विष्णुं पुरुषसत्तमम्।\nउवाच मधुरं राजा स्मितपूर्वमिदं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2072828, "chapter_id": 2539, "verse_number": "१२-४४-१८", "content_sanskrit": "सुखेन ते निशा कच्चिद्व्युष्टा बुद्धिमतां वर।\nकच्चिज्ज्ञानानि सर्वाणि प्रसन्नानि तवाच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2072829, "chapter_id": 2539, "verse_number": "१२-४४-१९", "content_sanskrit": "तथैवोपश्रिता देवी बुद्धिर्बुद्धिमतां वर।\nवयं राज्यमनुप्राप्ताः पृथिवी च वशे स्थिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2072830, "chapter_id": 2539, "verse_number": "१२-४४-२०", "content_sanskrit": "तव प्रसादाद्भगवंस्त्रिलोकगतिविक्रम।\nजयं प्राप्ता यशश्चाग्र्यं न च धर्मच्युता वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2072831, "chapter_id": 2539, "verse_number": "१२-४४-२१", "content_sanskrit": "तं तथा भाषमाणं तु धर्मराजमरिंदमम्।\nनोवाच भगवान्किंचिद्ध्यानमेवान्वपद्यत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2072832, "chapter_id": 2539, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि चतुश्चत्वारिंशोऽध्यायः॥ ४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]