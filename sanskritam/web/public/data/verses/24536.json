[{"id": 7004536000, "chapter_id": 24536, "verse_number": "५-३-२३०-१", "content_sanskrit": "सूत उवाच ।\nइत्युक्त्वोपररामथ पाण्डोः पुत्राय वै मुनिः ।\nमृकण्डतनयो धीमान्सप्तकल्पस्मरः पुरः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004536001, "chapter_id": 24536, "verse_number": "५-३-२३०-२", "content_sanskrit": "मार्कण्डमुनिना प्रोक्तं यथा पार्थाय सत्तमाः ।\nतथा वः कथितं सर्वं रेवामाहात्म्यमुत्तमम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004536002, "chapter_id": 24536, "verse_number": "५-३-२३०-३", "content_sanskrit": "इयं पुण्या सरिच्छ्रेष्ठा रेवा विश्वैकपावनी ।\nरुद्रदेहसमुद्भूता सर्वभूताभयप्रदा॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004536003, "chapter_id": 24536, "verse_number": "५-३-२३०-४", "content_sanskrit": "ओङ्कारजलधिं यावदुवाच भृगुनन्दनः ।\nतीर्थसङ्गमभेदान्वै धर्मपुत्राय पृच्छते॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004536004, "chapter_id": 24536, "verse_number": "५-३-२३०-५", "content_sanskrit": "समासेनैव मुनयस्तथाहं कथयामि वः ।\nसप्तषष्टिसहस्राणि षष्टिकोट्यस्तथैव च॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004536005, "chapter_id": 24536, "verse_number": "५-३-२३०-६", "content_sanskrit": "कथं केनात्र शक्यन्ते वक्तुं वर्षशतैरपि ।\nतथाप्यत्र मुनिश्रेष्ठाः प्रोक्तं पार्थाय वै यथा॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004536006, "chapter_id": 24536, "verse_number": "५-३-२३०-७", "content_sanskrit": "तीर्थमोंकारमारभ्य वक्ष्ये तीर्थावलिं शुभाम् ।\nप्रोच्यमानां समासेन तां शृणुध्वं महर्षयः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004536007, "chapter_id": 24536, "verse_number": "५-३-२३०-८", "content_sanskrit": "नत्वा सोमं महेशानं नत्वा ब्रह्माच्युतावुभौ ।\nसरस्वतीं गणेशानं देव्यासाङ्घ्रिपञ्कजम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004536008, "chapter_id": 24536, "verse_number": "५-३-२३०-९", "content_sanskrit": "पूर्वाचार्यांस्तथा सर्वान्दृष्ट्वादृष्टार्थवेदिनः ।\nप्रणम्य नर्मदां देवीं वक्ष्ये तीर्थावलिं त्विमाम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004536009, "chapter_id": 24536, "verse_number": "५-३-२३०-१०", "content_sanskrit": "ॐ नमो विश्वरूपाय ओङ्कारायाखिलात्मने ।\nयमारभ्ये प्रवक्ष्यामि रेवातीर्थावलिं द्विजाः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004536010, "chapter_id": 24536, "verse_number": "५-३-२३०-११", "content_sanskrit": "अस्मिन्मार्कण्डगदिते रेवातीर्थक्रमे शुभे ।\nपुराणसंहिताध्याया मार्कण्डाश्रमवर्णनम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004536011, "chapter_id": 24536, "verse_number": "५-३-२३०-१२", "content_sanskrit": "ततः प्रश्नाधिकारश्च प्रशंसा नर्मदोद्भवा ।\nतथा पञ्चदशानां च प्रवाहानां प्रकीर्तनम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004536012, "chapter_id": 24536, "verse_number": "५-३-२३०-१३", "content_sanskrit": "नामनिर्वचनं तद्वत्तथा कल्पसमुद्भवाः ।\nएकविंशतिकल्पानां तद्वन्नामानुकीर्तनम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004536013, "chapter_id": 24536, "verse_number": "५-३-२३०-१४", "content_sanskrit": "मार्कण्डेयानुभूतानां सप्तानां लक्षणानि च ।\nमाहात्म्यं चैव रेवायाः शिवविष्ण्वोस्तथैव च॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004536014, "chapter_id": 24536, "verse_number": "५-३-२३०-१५", "content_sanskrit": "संहारलक्षणं तद्वदोङ्कारस्य च सम्भवः ।\nतथैवौंकारमाहात्म्यममरकण्टकीर्तनम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004536015, "chapter_id": 24536, "verse_number": "५-३-२३०-१६", "content_sanskrit": "अमरेश्वरतीर्थं च तथा दारुवनं महत् ।\nदारुकेश्वरतीर्थं च तीर्थं वै चरुकेश्वरम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004536016, "chapter_id": 24536, "verse_number": "५-३-२३०-१७", "content_sanskrit": "चरुकासङ्गमस्तद्व्यद्वतीपातेश्वरं तथा ।\nपातालेश्वरतीर्थं च कोटियज्ञाह्वयं तथा॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004536017, "chapter_id": 24536, "verse_number": "५-३-२३०-१८", "content_sanskrit": "वरुणेश्वरतीर्थं च लिङ्गान्यष्टोत्तरं शतम् ।\nसिद्धेश्वरं यमेशं च ब्रह्मेश्वरमतः परम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004536018, "chapter_id": 24536, "verse_number": "५-३-२३०-१९", "content_sanskrit": "सारस्वतं चाष्टरुद्रं सावित्रं सोमसंज्ञितम् ।\nशिवखातं महातीर्थं रुद्रावर्तं द्विजोत्तमाः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004536019, "chapter_id": 24536, "verse_number": "५-३-२३०-२०", "content_sanskrit": "ब्रह्मावर्तं परं तीर्थं सूर्यावर्तमतः परम् ।\nपिप्पलावर्ततीर्थं च पिप्पल्याश्चैव सङ्गमः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004536020, "chapter_id": 24536, "verse_number": "५-३-२३०-२१", "content_sanskrit": "अमरकण्टमाहात्म्यं कपिलासङ्गमस्तथा ।\nविशल्यासम्भवश्चापि भृगुतुङ्गाद्रिकीर्तनम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004536021, "chapter_id": 24536, "verse_number": "५-३-२३०-२२", "content_sanskrit": "विशल्यासङ्गमः पुण्यः करमर्दासमागमः ।\nकरमर्देश्वरं तीर्थं चक्रतीर्थमनुत्तमम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004536022, "chapter_id": 24536, "verse_number": "५-३-२३०-२३", "content_sanskrit": "सङ्गमो नीलगङ्गायाः विध्वंसस्त्रिपुरस्य च ।\nकीर्तनं तीर्थदानानां मधुकतृतीयाव्रतम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004536023, "chapter_id": 24536, "verse_number": "५-३-२३०-२४", "content_sanskrit": "अप्सरेश्वरतीर्थं च देहक्षेपे विधिस्ततः ।\nतीर्थं ज्वालेश्वरं नाम ज्वालायाः सङ्गमस्तथा॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004536024, "chapter_id": 24536, "verse_number": "५-३-२३०-२५", "content_sanskrit": "शक्रतीर्थं कुशावर्तं हंसतीर्थं तथैव च ।\nअम्बरीषस्य तीर्थं च महाकालेश्वरं तथा॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004536025, "chapter_id": 24536, "verse_number": "५-३-२३०-२६", "content_sanskrit": "मातृकेश्वरतीर्थं च भृगुतुङ्गानुवर्णनम् ।\nतत्र भैरवमाहात्म्यं चपलेश्वरकीर्तनम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004536026, "chapter_id": 24536, "verse_number": "५-३-२३०-२७", "content_sanskrit": "चण्डपाणेश्च माहात्म्यं कावेरीसङ्गमस्तथा ।\nकुबेरेश्वरतीर्थं च वाराहीसङ्गमस्तथा॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004536027, "chapter_id": 24536, "verse_number": "५-३-२३०-२८", "content_sanskrit": "सङ्गमश्चण्डवेगायास्तीर्थं चण्डेश्वरं तथा ।\nएरण्डीसङ्गमः पुण्य एरण्डेश्वरमुत्तमम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004536028, "chapter_id": 24536, "verse_number": "५-३-२३०-२९", "content_sanskrit": "पितृतीर्थं च तत्रैव ओङ्कारस्य च सम्भवम् ।\nमाहात्म्यं पञ्चलिङ्गानामोङ्कारस्य मुनीश्वराः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004536029, "chapter_id": 24536, "verse_number": "५-३-२३०-३०", "content_sanskrit": "कोटितीर्थस्य माहात्म्यं तीर्थं काकह्रदं तथा ।\nजम्बुकेश्वरतीर्थं च सारस्वतमतः परम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004536030, "chapter_id": 24536, "verse_number": "५-३-२३०-३१", "content_sanskrit": "कपिलासङ्गमस्तद्वत्तीर्थं च कपिलेश्वरम् ।\nदैत्यसूदनतीर्थं च चक्रतीर्थं च वामनम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004536031, "chapter_id": 24536, "verse_number": "५-३-२३०-३२", "content_sanskrit": "तीर्थलक्षं विदुः पूर्वे कपिलायास्तु सङ्गमे ।\nस्वर्गस्य नरकस्यापि लक्षणं मुनिभाषितम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004536032, "chapter_id": 24536, "verse_number": "५-३-२३०-३३", "content_sanskrit": "व्यवस्थानं शरीरस्य गोप्रदानानुवर्णनम् ।\nअशोकवनिकातीर्थं मतङ्गाश्रमवर्णनम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004536033, "chapter_id": 24536, "verse_number": "५-३-२३०-३४", "content_sanskrit": "अशोकेश्वरतीर्थं च मतङ्गेश्वरमुत्तमम् ।\nतथा मृगवनं पुण्यं तत्र तीर्थं मनोरथम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004536034, "chapter_id": 24536, "verse_number": "५-३-२३०-३५", "content_sanskrit": "सङ्गमोऽङ्गारगर्ताया अङ्गारेश्वरमुत्तमम् ।\nतथा मेघवनं तीर्थं देव्या नामानुकीर्तनम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004536035, "chapter_id": 24536, "verse_number": "५-३-२३०-३६", "content_sanskrit": "सङ्गमश्चापि कुब्जायास्तीर्थं कुब्जेश्वरं तथा ।\nबिल्वाम्रकं तथा तीर्थं पूर्णद्वीपमतः परम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004536036, "chapter_id": 24536, "verse_number": "५-३-२३०-३७", "content_sanskrit": "तथा हिरण्यगर्भायाः सङ्गमः पुण्यकीर्तनः ।\nद्वीपेश्वरं नाम तीर्थं पुण्यं यज्ञेश्वरं तथा॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004536037, "chapter_id": 24536, "verse_number": "५-३-२३०-३८", "content_sanskrit": "माण्डव्याश्रमतीर्थं च विशोकासङ्गमस्तथा ।\nवागीश्वरं नाम तीर्थं पुण्यो वै वागुसङ्गमः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004536038, "chapter_id": 24536, "verse_number": "५-३-२३०-३९", "content_sanskrit": "सहस्रावर्तकं तत्र तीर्थं सौगन्धिकं तथा ।\nसङ्गमश्च सरस्वत्या ईशानं तीर्थमुत्तमम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004536039, "chapter_id": 24536, "verse_number": "५-३-२३०-४०", "content_sanskrit": "देवतात्रयतीर्थं च शूलखातं ततः परम् ।\nब्रह्मोदं शाङ्करं सौम्यं सारस्वतमतः परम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004536040, "chapter_id": 24536, "verse_number": "५-३-२३०-४१", "content_sanskrit": "सहस्रयज्ञतीर्थं च कपालमोचनं तथा ।\nआग्नेयमदितीशं च वाराहं तीर्थमुत्तमम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004536041, "chapter_id": 24536, "verse_number": "५-३-२३०-४२", "content_sanskrit": "तथा देवपथं तीर्थं तीर्थं यज्ञसहस्रकम् ।\nशुक्लतीर्थं दीप्तिकेशं विष्णुतीर्थं च योधनम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004536042, "chapter_id": 24536, "verse_number": "५-३-२३०-४३", "content_sanskrit": "नर्मदेश्वरतीर्थं च वरुणेशं च मारुतम् ।\nयोगेशं रोहिणीतीर्थं दारुतीर्थं च सत्तमाः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004536043, "chapter_id": 24536, "verse_number": "५-३-२३०-४४", "content_sanskrit": "ब्रह्मावर्तं च पत्त्रेशं वाह्नं सौरं च कीर्त्यते ।\nमेघनादं दारुतीर्थं देवतीर्थं गुहाश्रयम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004536044, "chapter_id": 24536, "verse_number": "५-३-२३०-४५", "content_sanskrit": "नर्मदेश्वरसंज्ञं तत्कपिलातीर्थमुत्तमम् ।\nकरञ्जेशं कुण्डलेशं पिप्पलादमतः परम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004536045, "chapter_id": 24536, "verse_number": "५-३-२३०-४६", "content_sanskrit": "विमलेश्वरतीर्थं च पुष्करिण्याश्च सङ्गमः ।\nप्रशंसा शूलभेदस्य तत्रैवान्धकविक्रमः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004536046, "chapter_id": 24536, "verse_number": "५-३-२३०-४७", "content_sanskrit": "देवाश्वासनदानं च तथैवान्धकनिग्रहः ।\nशूलभेदस्य चोत्पत्तिस्तथा पात्रपरीक्षणम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004536047, "chapter_id": 24536, "verse_number": "५-३-२३०-४८", "content_sanskrit": "प्रशंसा दानधर्मस्य ऋषिशृङ्गानुभावनम् ।\nस्वर्गतिं दीर्घतपसो भानुमत्यास्तथेङ्गितम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004536048, "chapter_id": 24536, "verse_number": "५-३-२३०-४९", "content_sanskrit": "शबरस्वर्गगमनं माहात्म्यं शूलभेदजम् ।\nकपिलेश्वरतीर्थं च मोक्षतीर्थमतः परम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004536049, "chapter_id": 24536, "verse_number": "५-३-२३०-५०", "content_sanskrit": "सङ्गमो मोक्षनद्याश्च तीर्थं च विमलेश्वरम् ।\nतथैवोलूकतीर्थं च पुष्करिण्याश्च सङ्गमः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004536050, "chapter_id": 24536, "verse_number": "५-३-२३०-५१", "content_sanskrit": "आदित्येश्वरतीर्थं च तीर्थं वै सङ्गमेश्वरम् ।\nसङ्गमो भीमकुल्यायास्तीर्थं भीमेश्वरं शुभम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004536051, "chapter_id": 24536, "verse_number": "५-३-२३०-५२", "content_sanskrit": "मार्कण्डेश्वरतीर्थं च तथा वै पिप्पलेश्वरम् ।\nकरोटीश्वरतीर्थं च तीर्थमिन्द्रेश्वरं शुभम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004536052, "chapter_id": 24536, "verse_number": "५-३-२३०-५३", "content_sanskrit": "अगस्त्येशं कुमारेशं व्यासेश्वरमनुत्तमम् ।\nवैद्यनाथं च केदारमानन्देश्वरसंज्ञितम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004536053, "chapter_id": 24536, "verse_number": "५-३-२३०-५४", "content_sanskrit": "मातृतीर्थं च मुण्डेशं चौरं कामेश्वरं तथा ।\nसङ्गमश्चानुदुह्या वै तीर्थे भीमार्जुनाह्वये ।\nतीर्थं धर्मेश्वरं नाम लुङ्केश्वरमतः परम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004536054, "chapter_id": 24536, "verse_number": "५-३-२३०-५५", "content_sanskrit": "ततो धनदतीर्थं च जटेशं मङ्गलेश्वरम् ।\nकपिलेश्वरतीर्थं च गोपारेश्वरमुत्तमम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004536055, "chapter_id": 24536, "verse_number": "५-३-२३०-५६", "content_sanskrit": "मणिनागेश्वरं नाम मणिनद्याश्च सङ्गमः ।\nतिलकेश्वरतीर्थं च गौतमेशमतः परम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004536056, "chapter_id": 24536, "verse_number": "५-३-२३०-५७", "content_sanskrit": "तत्रैव मातृतीर्थं च मुनिनोक्तं मुनीश्वराः ।\nशङ्खचूडं च केदारं पाराशरमतः परम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004536057, "chapter_id": 24536, "verse_number": "५-३-२३०-५८", "content_sanskrit": "भीमेश्वरं च चन्द्रेशमश्ववत्याश्च सङ्गमः ।\nबह्वीश्वरं नारदेशं वैद्यनाथं कपीश्वरम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004536058, "chapter_id": 24536, "verse_number": "५-३-२३०-५९", "content_sanskrit": "कुम्भेश्वरं च मार्कण्डं रामेशं लक्ष्मणेश्वरम् ।\nमेघेश्वरं मत्स्यकेशमप्सराह्रदसंज्ञकम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004536059, "chapter_id": 24536, "verse_number": "५-३-२३०-६०", "content_sanskrit": "दधिस्कन्दं मधुस्कन्दं नन्दिकेशं च वारुणम् ।\nपावकेश्वरतीर्थं च तथैव कपिलेश्वरम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004536060, "chapter_id": 24536, "verse_number": "५-३-२३०-६१", "content_sanskrit": "नारायणाह्वयं तीर्थं चक्रतीर्थमनुत्तमम् ।\nचण्डादित्यं परं तीर्थं चण्डिकातीर्थमुत्तमम्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004536061, "chapter_id": 24536, "verse_number": "५-३-२३०-६२", "content_sanskrit": "यमहासाह्वयं तीर्थं तथा गङ्गेश्वरं शुभम् ।\nनन्दिकेश्वरसंज्ञं च नरनारायणाह्वयम्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004536062, "chapter_id": 24536, "verse_number": "५-३-२३०-६३", "content_sanskrit": "नलेश्वरं च मार्कण्डं शुक्लतीर्थमतः परम् ।\nव्यासेश्वरं परं तीर्थं तत्र सिद्धेश्वरं तथा॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004536063, "chapter_id": 24536, "verse_number": "५-३-२३०-६४", "content_sanskrit": "कोटितीर्थं प्रभातीर्थं वासुकीश्वरमुत्तमम् ।\nसङ्गमश्च करञ्जाया मार्कण्डेश्वरमुत्तमम्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004536064, "chapter_id": 24536, "verse_number": "५-३-२३०-६५", "content_sanskrit": "तीर्थं कोटीश्वरं नाम तथा संकर्षणाह्वयम् ।\nकनकेशं मन्मथेशं तीर्थं चैवानसूयकम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004536065, "chapter_id": 24536, "verse_number": "५-३-२३०-६६", "content_sanskrit": "एरण्डीसङ्गमः पुण्यो मातृतीर्थं च शोभनम् ।\nतीर्थं स्वर्णशलाकाख्यं तथा चैवाम्बिकेश्वरम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004536066, "chapter_id": 24536, "verse_number": "५-३-२३०-६७", "content_sanskrit": "करञ्जेशं भारतेशं नागेशं मुकुटेश्वरम् ।\nसौभाग्यसुन्दरी तीर्थं धनदेश्वरमुत्तमम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004536067, "chapter_id": 24536, "verse_number": "५-३-२३०-६८", "content_sanskrit": "रोहिण्यं चक्रतीर्थं च उत्तरेश्वरसंज्ञितम् ।\nभोगेश्वरं च केदारं निष्कलङ्कमतः परम्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004536068, "chapter_id": 24536, "verse_number": "५-३-२३०-६९", "content_sanskrit": "मार्कण्डं धौतपापं च तीर्थमाङ्गिरसेश्वरम् ।\nकोटवीसङ्गमः पुण्यं कोटितीर्थं च तत्र वै॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004536069, "chapter_id": 24536, "verse_number": "५-३-२३०-७०", "content_sanskrit": "अयोनिजं परं तीर्थमङ्गारेश्वरमुत्तमम् ।\nस्कान्दं च नार्मदं ब्राह्मं वाल्मीकेश्वरसंज्ञितम्॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004536070, "chapter_id": 24536, "verse_number": "५-३-२३०-७१", "content_sanskrit": "कोटितीर्थं कपालेशं पाण्डुतीर्थं त्रिलोचनम् ।\nकपिलेशं कम्बुकेशं प्रभासं कोहनेश्वरम्॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004536071, "chapter_id": 24536, "verse_number": "५-३-२३०-७२", "content_sanskrit": "इन्द्रेशं वालुकेशं च देवेशं शक्रमेव च ।\nनागेश्वरं गौतमेशमहल्यातीर्थमुत्तमम्॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004536072, "chapter_id": 24536, "verse_number": "५-३-२३०-७३", "content_sanskrit": "रामेश्वरं मोक्षतीर्थं तथा कुशलवेश्वरौ ।\nनर्मदेशं कपर्दीशं सागरेशमतः परम्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004536073, "chapter_id": 24536, "verse_number": "५-३-२३०-७४", "content_sanskrit": "धौरादित्यं परं तीर्थं तीर्थं चापरयोनिजम् ।\nपिङ्गलेश्वरतीर्थ च भृग्वीश्वरमनुत्तमम्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004536074, "chapter_id": 24536, "verse_number": "५-३-२३०-७५", "content_sanskrit": "दशाश्वमेधिकं तीर्थं कोटितीर्थं च सत्तमाः ।\nमार्कण्डं ब्रह्मतीर्थं च आदिवाराहमुत्तमम्॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004536075, "chapter_id": 24536, "verse_number": "५-३-२३०-७६", "content_sanskrit": "आशापूराभिधं तीर्थं कौबेरं मारुतं तथा ।\nवरुणेशं यमेशं च रामेशं कर्कटेश्वरम्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004536076, "chapter_id": 24536, "verse_number": "५-३-२३०-७७", "content_sanskrit": "शक्रेशं सोमतीर्थं च नन्दाह्रदमनुत्तमम् ।\nवैष्णवं चक्रतीर्थं च रामकेशवसंज्ञितम्॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004536077, "chapter_id": 24536, "verse_number": "५-३-२३०-७८", "content_sanskrit": "तथैव रुक्मिणीतीर्थं शिवतीर्थमनुत्तमम् ।\nजयवाराहर्तीर्थं च तीर्थमस्माहकाह्वयम्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004536078, "chapter_id": 24536, "verse_number": "५-३-२३०-७९", "content_sanskrit": "अङ्गारेशं च सिद्धेशं तपेश्वरमतः परम् ।\nपुनः सिद्धेश्वरं नामतीर्थं च वरुणेश्वरम्॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004536079, "chapter_id": 24536, "verse_number": "५-३-२३०-८०", "content_sanskrit": "पराशरेश्वरं पुण्यं कुसुमेशमनुत्तमम् ।\nकुण्डलेश्वरतीर्थं च तथा कलकलेश्वरम्॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004536080, "chapter_id": 24536, "verse_number": "५-३-२३०-८१", "content_sanskrit": "न्यङ्कुवाराहसंज्ञं च अङ्कोलं तीर्थमुत्तमम् ।\nश्वेतवाराहतीर्थं च भार्गलं सौरमुत्तमम्॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004536081, "chapter_id": 24536, "verse_number": "५-३-२३०-८२", "content_sanskrit": "हुङ्कारस्वामितीर्थं च शुक्लतीर्थं च शोभनम् ।\nसङ्गमो मधुमत्याश्च तीर्थं वै सङ्गमेश्वरम्॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004536082, "chapter_id": 24536, "verse_number": "५-३-२३०-८३", "content_sanskrit": "नर्मदेश्वरसंज्ञं च नदीत्रितयसङ्गमः ।\nअनेकेश्वरतीर्थं च शर्भेशं मोक्षसंज्ञितम्॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004536083, "chapter_id": 24536, "verse_number": "५-३-२३०-८४", "content_sanskrit": "कावेरीसङ्गमः पुण्यस्तीर्थं गोपेश्वराह्वयम् ।\nमार्कण्डेशं च नागेशमुदम्बर्याश्च सङ्गमः॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004536084, "chapter_id": 24536, "verse_number": "५-३-२३०-८५", "content_sanskrit": "साम्बादित्याह्वयं तीर्थमुदम्बर्याश्च सङ्गमः ।\nसिद्धेश्वरं च मार्कण्डं तथा सिद्धेश्वरीकृतम्॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004536085, "chapter_id": 24536, "verse_number": "५-३-२३०-८६", "content_sanskrit": "गोपेशं कपिलेशं च वैद्यनाथमनुत्तमम् ।\nपिङ्गलेश्वरतीर्थं च सैन्धवायतनं महत्॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004536086, "chapter_id": 24536, "verse_number": "५-३-२३०-८७", "content_sanskrit": "भूतीश्वराह्वयं तीर्थं गङ्गावाहमतः परम् ।\nगौतमेश्वरतीर्थं च दशाश्वमेधिकं तथा॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004536087, "chapter_id": 24536, "verse_number": "५-३-२३०-८८", "content_sanskrit": "भृगुतीर्थं तथा पुण्यं ख्याता सौभाग्यसुन्दरी ।\nवृषखातं च तत्रैव केदारं धूतपातकम्॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004536088, "chapter_id": 24536, "verse_number": "५-३-२३०-८९", "content_sanskrit": "तीर्थं धूतेश्वरीसङ्गमेरण्डीसंज्ञकं तथा ।\nतीर्थं च कनकेश्वर्या ज्वालेश्वरं ततः परम्॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004536089, "chapter_id": 24536, "verse_number": "५-३-२३०-९०", "content_sanskrit": "शालग्रामाह्वयं तीर्थं सोमनाथमनुत्तमम् ।\nतथैवोदीर्णवाराहं तीर्थं चन्द्रप्रभासकम्॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004536090, "chapter_id": 24536, "verse_number": "५-३-२३०-९१", "content_sanskrit": "द्वादशादित्यतीर्थं च तथा सिद्धेश्वराभिधम् ।\nकपिलेश्वरतीर्थं च तथा त्रैविक्रमं शुभम्॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004536091, "chapter_id": 24536, "verse_number": "५-३-२३०-९२", "content_sanskrit": "विश्वरूपाह्वयं तीर्थं नारायणकृतं तथा ।\nमूलश्रीपतितीर्थं च चौलश्रीपतिसंज्ञकम्॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004536092, "chapter_id": 24536, "verse_number": "५-३-२३०-९३", "content_sanskrit": "देवतीर्थं हंसतीर्थ प्रभासं तीर्थमुत्तमम् ।\nमूलस्थानं च कण्ठेशमट्टहासमतः परम्॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004536093, "chapter_id": 24536, "verse_number": "५-३-२३०-९४", "content_sanskrit": "भूर्भुवेश्वरतीर्थं च ख्याता शूलेश्वरी तथा ।\nसारस्वतं दारुकेशमश्विनोस्तीर्थमुत्तमम्॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004536094, "chapter_id": 24536, "verse_number": "५-३-२३०-९५", "content_sanskrit": "सावित्रीतीर्थमतुलं वालखिल्येश्वरं तथा ।\nनर्मदेशं मातृतीर्थं देवतीर्थमनुत्तमम्॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004536095, "chapter_id": 24536, "verse_number": "५-३-२३०-९६", "content_sanskrit": "मच्छकेश्वरतीर्थं च शिखितीर्थं च शोभनम् ।\nकोटितीर्थं मुनिश्रेष्ठास्तत्र कोटीश्वरी मृडा॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004536096, "chapter_id": 24536, "verse_number": "५-३-२३०-९७", "content_sanskrit": "तीर्थं पैतामहं नाम माण्डव्ये श्वरसंज्ञितम् ।\nतत्र नारायणेशं च अक्रूरेशमतः परम्॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004536097, "chapter_id": 24536, "verse_number": "५-३-२३०-९८", "content_sanskrit": "देवखातं सिद्धरुद्रं वैद्यनाथमनुत्तमम् ।\nतथैव मातृतीर्थं च उत्तरेशमतः परम्॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004536098, "chapter_id": 24536, "verse_number": "५-३-२३०-९९", "content_sanskrit": "तथैव नर्मदेशां च मातृतीर्थं तथा पुनः ।\nतथा च कुररीतीर्थं ढौण्ढेशं दशकन्यकम्॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004536099, "chapter_id": 24536, "verse_number": "५-३-२३०-१००", "content_sanskrit": "सुवर्णबिन्दुतीर्थं च ऋणपापप्रमोचनम् ।\nभारभूतेश्वरं तीर्थं तथा मुण्डीश्वरं विदुः॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004536100, "chapter_id": 24536, "verse_number": "५-३-२३०-१०१", "content_sanskrit": "एकशालं डिण्डिपाणिं तीर्थं चाप्सरसं परम् ।\nमुन्यालयं च मार्कण्डं गणितादेवताह्वयम्॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004536101, "chapter_id": 24536, "verse_number": "५-३-२३०-१०२", "content_sanskrit": "आमलेश्वरतीर्थं च तीर्थं कन्थेश्वरं तथा ।\nआषाढीतीर्थमित्याहुः शृङ्गीतीर्थं तथैव च॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004536102, "chapter_id": 24536, "verse_number": "५-३-२३०-१०३", "content_sanskrit": "बकेश्वरतीर्थं च कपालेशं तथैव च ।\nमार्कण्डं कपिलेशं च एरण्डीसङ्गमस्तथा॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004536103, "chapter_id": 24536, "verse_number": "५-३-२३०-१०४", "content_sanskrit": "एरण्डीदेवतातीर्थं रामतीर्थमतःपरम् ।\nजमदग्नेः परं तीर्थं रेवासागरसङ्गमः॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004536104, "chapter_id": 24536, "verse_number": "५-३-२३०-१०५", "content_sanskrit": "लोटनेश्वरतीर्थ तल्लुङ्केशनामकं तथा ।\nवृषरखातं तत्र कुण्डं तथैव ऋषिसत्तमाः॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004536105, "chapter_id": 24536, "verse_number": "५-३-२३०-१०६", "content_sanskrit": "तथा हंसेश्वरंनाम तिलादं वासवेश्वरम् ।\nतथा कोटीश्वरं तीर्थमलिकातीर्थमुत्तमम् ।\nविमलेश्वरतीर्थं च रेवासागरसङ्गमे॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004536106, "chapter_id": 24536, "verse_number": "५-३-२३०-१०७", "content_sanskrit": "एवं तीर्थावलिः पुण्या मया प्रोक्ता महर्षयः ।\nतीर्थसुक्तावलिः पुण्या ग्रथिता तटरज्जुना॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004536107, "chapter_id": 24536, "verse_number": "५-३-२३०-१०८", "content_sanskrit": "नर्मदानीरनिर्णिक्ता मार्कण्डेयविनिर्मिता ।\nमण्डनायेह साधूनां सर्वलोकहिताय च॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004536108, "chapter_id": 24536, "verse_number": "५-३-२३०-१०९", "content_sanskrit": "दरितध्वान्तशमनीधार्या धर्मार्थिभिः सदा ।\nअहोरात्रकृतं पापं सकृज्जप्त्वाशु नाशयेत्॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004536109, "chapter_id": 24536, "verse_number": "५-३-२३०-११०", "content_sanskrit": "त्रिकालं जप्त्वा मासोत्थं शिवाग्रे च त्रिमासिकम् ।\nमासं जप्त्वाथ वर्षोत्थं वर्षं जप्त्वा शताब्दिकम्॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004536110, "chapter_id": 24536, "verse_number": "५-३-२३०-१११", "content_sanskrit": "श्राद्धकाले च विप्राणां भुञ्जतां पुरतः स्थितः ।\nपठंस्तीर्थावलिं पुण्यां गयाश्राद्धप्रदो भवेत्॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004536111, "chapter_id": 24536, "verse_number": "५-३-२३०-११२", "content_sanskrit": "पूजाकाले च देवानां श्रद्धया पुरतः पठन् ।\nप्रीणयेत्सर्वदेवांश्च पुनाति सकलं कुलम्॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004536112, "chapter_id": 24536, "verse_number": "५-३-२३०-११३", "content_sanskrit": "एवं तीर्थावलिः पुण्या रेवातीरद्वयाश्रिता ।\nमया प्रोक्ता मुनिश्रेष्ठास्तथैवशृणुतानघाः॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}]