[{"id": 7000514000, "chapter_id": 20514, "verse_number": "३-६१-१", "content_sanskrit": "सूत उवाच ।\nएवमुक्ता पुरा विप्रा व्यासेनामिततेजसा ।\nएतावदुक्त्वा भगवान्व्यासः सत्यवतीसुतः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000514001, "chapter_id": 20514, "verse_number": "३-६१-२", "content_sanskrit": "समाश्वास्य मुनीन्सर्वान्जगाम च यथागतम् ।\nभवद्भ्यस्तु मया प्रोक्तं वर्णाश्रमविधानकम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000514002, "chapter_id": 20514, "verse_number": "३-६१-३", "content_sanskrit": "एवं कृत्वा प्रियो विष्णोर्भवत्येव न चान्यथा ।\nरहस्यं तत्र वक्ष्यामि शृणुत द्विजसत्तमाः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000514003, "chapter_id": 20514, "verse_number": "३-६१-४", "content_sanskrit": "ये चात्र कथिता धर्मा वर्णाश्रमनिबंधनाः ।\nहरिभक्तिकलांशांश समाना न हि ते द्विजाः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000514004, "chapter_id": 20514, "verse_number": "३-६१-५", "content_sanskrit": "पुंसामेकेह वै साध्या हरिभक्तिः कलौ युगे ।\nयुगांतरेण धर्मा हि सेवितव्या नरेण हि॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000514005, "chapter_id": 20514, "verse_number": "३-६१-६", "content_sanskrit": "कलौ नारायणं देवं यजते यः स धर्म्मभाक् ।\nदामोदरं हृषीकेशं पुरुहूतं सनातनम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000514006, "chapter_id": 20514, "verse_number": "३-६१-७", "content_sanskrit": "हृदि कृत्वा परं शांतं जितमेव जगत्त्रयम् ।\nकलिकालोरगादंशात्किल्बिषात्कालकूटतः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000514007, "chapter_id": 20514, "verse_number": "३-६१-८", "content_sanskrit": "हरिभक्तिसुधां पीत्वा उल्लंघ्यो भवति द्विजः ।\nकिं जपैः श्रीहरेर्नाम गृहीतं यदि मानुषैः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000514008, "chapter_id": 20514, "verse_number": "३-६१-९", "content_sanskrit": "किं स्नानैर्विष्णुपादांबु मस्तके येन धार्यते ।\nकिं यज्ञेन हरेः पादपद्मं येन धृतं हृदि॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000514009, "chapter_id": 20514, "verse_number": "३-६१-१०", "content_sanskrit": "किं दानेन हरेः कर्म सभायां वै प्रकाशितम् ।\nहरेर्गुणगणान्श्रुत्वा यः प्रहृष्येत्पुनः पुनः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000514010, "chapter_id": 20514, "verse_number": "३-६१-११", "content_sanskrit": "समाधिना प्रहृष्टस्य सा गतिः कृष्णचेतसः ।\nतत्र विघ्नकराः प्रोक्ताः पाखंडालापपेशलाः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000514011, "chapter_id": 20514, "verse_number": "३-६१-१२", "content_sanskrit": "नार्यस्तत्संगिनश्चापि हरिभक्तिविघातकाः ।\nनारीणां नयनादेशः सुराणामपि दुर्जयः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000514012, "chapter_id": 20514, "verse_number": "३-६१-१३", "content_sanskrit": "स येन विजितो लोके हरिभक्तः स उच्यते ।\nमाद्यंति मुनयोप्यत्र नारीचरितलोलुपाः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000514013, "chapter_id": 20514, "verse_number": "३-६१-१४", "content_sanskrit": "हरिभक्तिः कुतः पुंसां नारीभक्तिजुषां द्विजाः ।\nराक्षस्यः कामिनीवेषाश्चरंति जगति द्विजाः ।\nनराणां बुद्धिकवलं कुर्वंति सततं हिताः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000514014, "chapter_id": 20514, "verse_number": "३-६१-१५", "content_sanskrit": "तावद्विद्या प्रभवति तावज्ज्ञानं प्रवर्तते ।\nतावत्सुनिर्मला मेधा सर्वशास्त्रविधारिणी॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000514015, "chapter_id": 20514, "verse_number": "३-६१-१६", "content_sanskrit": "तावज्जपस्तपस्तावत्तावतीर्थनिषेवणम् ।\nतावच्च गुरुशुश्रूषा तावद्धि तरणे मतिः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000514016, "chapter_id": 20514, "verse_number": "३-६१-१७", "content_sanskrit": "तावत्प्रबोधो भवति विवेकस्तावदेव हि ।\nतावत्सतां संगरुचिस्तावत्पौराणलालसा॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000514017, "chapter_id": 20514, "verse_number": "३-६१-१८", "content_sanskrit": "यावत्सीमंतिनी लोलनयनांदोलनं नहि ।\nजनोपरि पतेद्विप्राः सर्वधर्मविलोपनम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000514018, "chapter_id": 20514, "verse_number": "३-६१-१९", "content_sanskrit": "तत्र ये हरिपादाब्जमधुलेशप्रसादिताः ।\nतेषां न नारीलोलाक्षिक्षेपणं हि प्रभुर्भवेत्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000514019, "chapter_id": 20514, "verse_number": "३-६१-२०", "content_sanskrit": "जन्मजन्म हृषीकेश सेवनं यैः कृतं द्विजाः ।\nद्विजे दत्तं हुतं वह्नौ विरतिस्तत्र तत्र हि॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000514020, "chapter_id": 20514, "verse_number": "३-६१-२१", "content_sanskrit": "नारीणां किल किं नाम सौंदर्य्यं परिचक्षते ।\nभूषणानां च वस्त्राणां चाकचक्यं तदुच्यते॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000514021, "chapter_id": 20514, "verse_number": "३-६१-२२", "content_sanskrit": "स्नेहात्मज्ञानरहितं नारीरूपं कुतः स्मृतम् ।\nपूयमूत्रपुरीषासृक्त्वङ्मेदोस्थिवसान्वितम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000514022, "chapter_id": 20514, "verse_number": "३-६१-२३", "content_sanskrit": "कलेवरं हि तन्नाम कुतः सौंदर्य्यमत्र हि ।\nतदेवं पृथगाचिंत्य स्पृष्ट्वा स्नात्वा शुचिर्भवेत्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000514023, "chapter_id": 20514, "verse_number": "३-६१-२४", "content_sanskrit": "तैः संहितं शंरीरं हि दृश्यते सुंदरं जनैः ।\nअहोतिदुर्दशा नॄणां दुर्दैव घटिता द्विजाः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000514024, "chapter_id": 20514, "verse_number": "३-६१-२५", "content_sanskrit": "कुचावृतेंगे पुरुषो नारी बुद्ध्वा प्रवर्त्तते ।\nका नारी वा पुमान्को वा विचारे सति किंचन॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000514025, "chapter_id": 20514, "verse_number": "३-६१-२६", "content_sanskrit": "तस्मात्सर्वात्मना साधुर्नारीसंगं विवर्जयेत् ।\nको नाम नारीमासाद्य सिद्धिं प्राप्नोति भूतले॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000514026, "chapter_id": 20514, "verse_number": "३-६१-२७", "content_sanskrit": "कामिनी कामिनीसंगि संगमित्यपि संत्यजेत् ।\nतत्संगाद्रौरवमिति साक्षादेव प्रतीयते॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000514027, "chapter_id": 20514, "verse_number": "३-६१-२८", "content_sanskrit": "अज्ञानाल्लोलुपा लोकास्तत्र दैवेन वंचिताः ।\nसाक्षान्नरककुंडेस्मिन्नारीयोनौ पचेन्नरः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000514028, "chapter_id": 20514, "verse_number": "३-६१-२९", "content_sanskrit": "यत एवागतः पृथ्व्यां तस्मिन्नेव पुना रमेत् ।\nयतः प्रसरते नित्यं मूत्रं रेतो मलोत्थितम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000514029, "chapter_id": 20514, "verse_number": "३-६१-३०", "content_sanskrit": "तत्रैव रमते लोकः कस्तस्मादशुचिर्भवेत् ।\nतत्रातिकष्टं लोकेस्मिन्नहो दैवविडंबना॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000514030, "chapter_id": 20514, "verse_number": "३-६१-३१", "content_sanskrit": "पुनः पुना रमेत्तत्र अहो निस्त्रपता नृणाम् ।\nतस्माद्विचारयेद्धीमान्नारीदोषगणान्बहून्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000514031, "chapter_id": 20514, "verse_number": "३-६१-३२", "content_sanskrit": "मैथुनाद्बलहानिः स्यान्निद्राति तरुणायते ।\nनिद्रयापहृतज्ञानः स्वल्पायुर्जायते नरः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000514032, "chapter_id": 20514, "verse_number": "३-६१-३३", "content_sanskrit": "तस्मात्प्रयत्नतो धीमान्नारीं मृत्युमिवात्मनः ।\nपश्येद्गोविंदपादाब्जे मनो वै रमयेद्बुधः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000514033, "chapter_id": 20514, "verse_number": "३-६१-३४", "content_sanskrit": "इहामुत्र सुखं तद्धि गोविंदपदसेवनम् ।\nविहाय को महामूढो नारीपादं हि सेवते॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000514034, "chapter_id": 20514, "verse_number": "३-६१-३५", "content_sanskrit": "जनार्द्दनांघ्रिसेवा हि ह्यपुनर्भवदायिनी ।\nनारीणां योनिसेवा हि योनिसंकटकारिणी॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000514035, "chapter_id": 20514, "verse_number": "३-६१-३६", "content_sanskrit": "पुनःपुनः पतेद्योनौ यंत्रनिष्पाचितो यथा ।\nपुनस्तामेवाभिलषेद्विद्यादस्य विडंबनम्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000514036, "chapter_id": 20514, "verse_number": "३-६१-३७", "content_sanskrit": "ऊर्ध्वबाहुरहं वच्मि शृणु मे परमं वचः ।\nगोविंदे धेहि हृदयं न योनौ यातनाजुषि॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000514037, "chapter_id": 20514, "verse_number": "३-६१-३८", "content_sanskrit": "नारीसंगं परित्यज्य यश्चापि परिवर्त्तते ।\nपदेपदेश्वमेधस्य फलमाप्नोति मानवः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000514038, "chapter_id": 20514, "verse_number": "३-६१-३९", "content_sanskrit": "कुलांगना दैवयोगादूढा यदि नृणां सती ।\nपुत्रमुत्पाद्य यस्तत्र तत्संगं परिवर्जयेत्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000514039, "chapter_id": 20514, "verse_number": "३-६१-४०", "content_sanskrit": "तस्य तुष्टो जगन्नाथो भवत्येव न संशयः ।\nनारीसंगो हि धर्मज्ञैरसत्संगः प्रकीर्त्यते॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000514040, "chapter_id": 20514, "verse_number": "३-६१-४१", "content_sanskrit": "तस्मिन्सति हरौ भक्तिः सुदृढा नैव जायते ।\nसर्वसंगं परित्यज्य हरौ भक्तिं समाचरेत्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000514041, "chapter_id": 20514, "verse_number": "३-६१-४२", "content_sanskrit": "हरिभक्तिश्च लोकेत्र दुर्ल्लभा हि मता मम ।\nहरौ यस्य भवेद्भक्तिः स कृतार्थो न संशयः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000514042, "chapter_id": 20514, "verse_number": "३-६१-४३", "content_sanskrit": "तत्तदेवाचरेत्कर्म हरिः प्रीणाति येन हि ।\nतस्मिंस्तुष्टे जगत्तुष्टं प्रीणिते प्रीणितं जगत्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000514043, "chapter_id": 20514, "verse_number": "३-६१-४४", "content_sanskrit": "हरौ भक्तिं विना नॄणां वृथा जन्म प्रकीर्तितम् ।\nब्रह्मेशादि सुरा यस्य यजंते प्रीतिहेतवे॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000514044, "chapter_id": 20514, "verse_number": "३-६१-४५", "content_sanskrit": "नारायणमनाव्यक्तं न तं सेवेत को जनः ।\nतस्य माता महाभागा पिता तस्य महाकृती॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000514045, "chapter_id": 20514, "verse_number": "३-६१-४६", "content_sanskrit": "जनार्द्दनपदद्वंद्वं हृदये येन धार्यते ।\nजनार्दनजगद्वंद्य शरणागतवत्सल॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000514046, "chapter_id": 20514, "verse_number": "३-६१-४७", "content_sanskrit": "इतीरयंति ये मर्त्या न तेषां निरये गतिः ।\nब्राह्मणा हि विशेषेण प्रत्यक्षं हरिरूपिणः॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000514047, "chapter_id": 20514, "verse_number": "३-६१-४८", "content_sanskrit": "पूजयेयुर्यथायोगं हरिस्तेषां प्रसीदति ।\nविष्णुर्ब्राह्मणरूपेण विचरेत्पृथिवीमिमाम्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000514048, "chapter_id": 20514, "verse_number": "३-६१-४९", "content_sanskrit": "ब्राह्मणेन विना कर्म्म सिद्धिं प्राप्नोति नैव हि ।\nद्विजपादांबुभक्त्या यैः पीत्वा शिरसि चार्पितम्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000514049, "chapter_id": 20514, "verse_number": "३-६१-५०", "content_sanskrit": "तर्पिता पितरस्तेन आत्मापि किल तारितः ।\nब्राह्मणानां मुखे येन दत्तं मधुरमर्चितम्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000514050, "chapter_id": 20514, "verse_number": "३-६१-५१", "content_sanskrit": "साक्षात्कृष्णमुखे दत्तं तद्वै भुंक्ते हरिः स्वयम् ।\nअहोतिदुर्ल्लभा लोका प्रत्यक्षे केशवे द्विजे॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000514051, "chapter_id": 20514, "verse_number": "३-६१-५२", "content_sanskrit": "प्रतिमादिषु सेवंते तदभावे हि तत्क्रिया ।\nब्राह्मणानामधिष्ठानात्पृथ्वी धन्येति गीयते॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000514052, "chapter_id": 20514, "verse_number": "३-६१-५३", "content_sanskrit": "तेषां पाणौ च यद्दत्तं हरिपाणौ तदर्पितम् ।\nतेभ्यः कृतान्नमस्कारात्तिरस्कारो हि पाप्मताम्॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000514053, "chapter_id": 20514, "verse_number": "३-६१-५४", "content_sanskrit": "मुच्यते ब्रह्महत्यादि पापेभ्यो विप्रवंदनात् ।\nतस्मात्सतां समाराध्यो ब्राह्मणो विष्णुबुद्धितः॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000514054, "chapter_id": 20514, "verse_number": "३-६१-५५", "content_sanskrit": "क्षुधितस्य द्विजस्यास्ये यत्किंचिद्दीयते यदि ।\nप्रेत्य पीपूषधाराभिः सिंचते कल्पकोटिकम्॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000514055, "chapter_id": 20514, "verse_number": "३-६१-५६", "content_sanskrit": "द्विजतुंडं महाक्षेत्रमनूषरमकंटकम् ।\nतत्र चेदुप्यते किंचित्कोटिकोटिफलं लभेत्॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000514056, "chapter_id": 20514, "verse_number": "३-६१-५७", "content_sanskrit": "सघृतं भोजनं चास्मै दत्त्वा कल्पं स मोदते ।\nनानासुमिष्टमन्नं यो ददाति द्विजतुष्टये॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000514057, "chapter_id": 20514, "verse_number": "३-६१-५८", "content_sanskrit": "तस्य लोका महाभोगाः कोटिकल्पांतमुक्तिदाः ।\nब्राह्मणं च पुरस्कृत्य ब्राह्मणेनानुकीर्तितम्॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000514058, "chapter_id": 20514, "verse_number": "३-६१-५९", "content_sanskrit": "पुराणं शृणुयान्नित्यं महापापदवानलम् ।\nपुराणं सर्वतीर्थेषु तीर्थं चाधिकमुच्यते॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000514059, "chapter_id": 20514, "verse_number": "३-६१-६०", "content_sanskrit": "यस्यैकपादश्रवणाद्धरिरेव प्रसीदति ।\nयथा सूर्यवपुर्भूत्वा प्रकाशाय चरेद्धरिः॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000514060, "chapter_id": 20514, "verse_number": "३-६१-६१", "content_sanskrit": "सर्वेषां जगतामेव हरिरालोकहेतवे ।\nतथैवांतःप्रकाशाय पुराणावयवो हरिः॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000514061, "chapter_id": 20514, "verse_number": "३-६१-६२", "content_sanskrit": "विचरेदिह भूतेषु पुराणं पावनं परम् ।\nतस्माद्यदि हरेः प्रीतेरुत्पादे धीयते मतिः॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000514062, "chapter_id": 20514, "verse_number": "३-६१-६३", "content_sanskrit": "श्रोतव्यमनिशं पुंभिः पुराणं कृष्णरूपिणम् ।\nविष्णुभक्तेन शांतेन श्रोतव्यमपि दुर्लभम्॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000514063, "chapter_id": 20514, "verse_number": "३-६१-६४", "content_sanskrit": "पुराणाख्यानममलममलीकरणं परम् ।\nयस्मिन्वेदार्थमाहृत्य हरिणा व्यासरूपिणा॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000514064, "chapter_id": 20514, "verse_number": "३-६१-६५", "content_sanskrit": "पुराणं निर्मितं विप्र तस्मात्तत्परमो भवेत् ।\nपुराणे निश्चितो धर्मो धर्मश्च केशवः स्वयम्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000514065, "chapter_id": 20514, "verse_number": "३-६१-६६", "content_sanskrit": "तस्मात्कृते पुराणे हि श्रुते विष्णुर्भवेदिति ।\nसाक्षात्स्वयं हरिर्विप्रः पुराणं च तथाविधम्॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000514066, "chapter_id": 20514, "verse_number": "३-६१-६७", "content_sanskrit": "एतयोः संगमासाद्य हरिरेव भेवन्नरः ।\nतथा गंगांबुसेकेन नाशयेत्किल्बिषं स्वकम्॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000514067, "chapter_id": 20514, "verse_number": "३-६१-६८", "content_sanskrit": "केशवो द्रवरूपेण पापात्तारयते महीम् ।\nवैष्णवो विष्णुभजनस्याकांक्षी यदि वर्तते॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000514068, "chapter_id": 20514, "verse_number": "३-६१-६९", "content_sanskrit": "गंगांबुसेकममलममलीकरणं चरेत् ।\nविष्णुभक्तिप्रदा देवी गंगा भुवि च गीयते॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000514069, "chapter_id": 20514, "verse_number": "३-६१-७०", "content_sanskrit": "विष्णुरूपा हि सा गंगा लोकविस्तारकारिणी॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000514070, "chapter_id": 20514, "verse_number": "३-६१-७१", "content_sanskrit": "ब्राह्मणेषु पुराणेषु गंगायां गोषु पिप्पले ।\nनारायणधिया पुंभिर्भक्तिः कार्या ह्यहैतुकी॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000514071, "chapter_id": 20514, "verse_number": "३-६१-७२", "content_sanskrit": "प्रत्यक्षविष्णुरूपा हि तत्वज्ञैर्निश्चिता अमी ।\nतस्मात्सततमभ्यर्च्या विष्णुभक्त्यभिलाषिणा॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000514072, "chapter_id": 20514, "verse_number": "३-६१-७३", "content_sanskrit": "विष्णौ भक्तिं विना नॄणां निष्फलं जन्म उच्यते ।\nकलिकालपयोराशिं पापग्राहसमाकुलम्॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000514073, "chapter_id": 20514, "verse_number": "३-६१-७४", "content_sanskrit": "विषयामज्जनावर्तं दुर्बोधफेनिलं परम् ।\nमहादुष्टजनव्याल महाभीमं भयानकम्॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000514074, "chapter_id": 20514, "verse_number": "३-६१-७५", "content_sanskrit": "दुस्तरं च तरंत्येव हरिभक्तितरि स्थिताः ।\nतस्माद्यतेत वै लोको विष्णुभक्तिप्रसाधने॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000514075, "chapter_id": 20514, "verse_number": "३-६१-७६", "content_sanskrit": "किं सुखं लभते जंतुरसद्वार्तावधारणे ।\nहरेरद्भुतलीलस्य लीलाख्यानेन सज्जते॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000514076, "chapter_id": 20514, "verse_number": "३-६१-७७", "content_sanskrit": "तद्विचित्रकथालोके नानाविषयमिश्रिताः ।\nश्रोतव्या यदि वै नॄणां विषये सज्जते मनः॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000514077, "chapter_id": 20514, "verse_number": "३-६१-७८", "content_sanskrit": "निर्वाणे यदि वा चित्तं श्रोतव्या तदपि द्विजाः ।\nहेलया श्रवणाच्चापि तस्य तुष्टो भवेद्धरिः॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000514078, "chapter_id": 20514, "verse_number": "३-६१-७९", "content_sanskrit": "निष्क्रियोपि हृषीकेशो नानाकर्म चकार सः ।\nशुश्रूषूणां हितार्थाय भक्तानां भक्तवत्सलः॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000514079, "chapter_id": 20514, "verse_number": "३-६१-८०", "content_sanskrit": "न लभ्यते कर्मणापि वाजपेयशतादिना ।\nराजसूयायुतेनापि यथा भक्त्या स लभ्यते॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000514080, "chapter_id": 20514, "verse_number": "३-६१-८१", "content_sanskrit": "यत्पदं चेतसा सेव्यं सद्भिराचरितं मुहुः ।\nभवाब्धितरणे सारमाश्रयध्वं हरेः पदम्॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000514081, "chapter_id": 20514, "verse_number": "३-६१-८२", "content_sanskrit": "रे रे विषयसंलुब्धाः पामरा निष्ठुरा नराः ।\nरौरवे हि किमात्मानमात्मना पातयिष्यथ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000514082, "chapter_id": 20514, "verse_number": "३-६१-८३", "content_sanskrit": "विना गोविंदसौम्यांघ्रिसेवनं मा गमिष्यति ।\nअनायासेन दुःखानां तरणं यदि वांछथ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000514083, "chapter_id": 20514, "verse_number": "३-६१-८४", "content_sanskrit": "भजध्वं कृष्णचरणावपुनर्भवकारणे ।\nकुत एवागतो मर्त्यः कुत एव पुनर्व्रजेत्॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000514084, "chapter_id": 20514, "verse_number": "३-६१-८५", "content_sanskrit": "एतद्विचार्य मतिमानाश्रयेद्धर्मसंग्रहम् ।\nनानानरकसंपातादुत्थितो यदि पूरुषः॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000514085, "chapter_id": 20514, "verse_number": "३-६१-८६", "content_sanskrit": "स्थावरादि तनुं लब्ध्वा यदि भाग्यवशात्पुनः ।\nमानुष्यं लभते तत्र गर्भवासोतिदुःखदः॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000514086, "chapter_id": 20514, "verse_number": "३-६१-८७", "content_sanskrit": "ततः कर्मवशाज्जंतुर्यदि वा जायते भुवि ।\nबाल्यादिबहुदोषेण पीडितो भवति द्विजाः॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000514087, "chapter_id": 20514, "verse_number": "३-६१-८८", "content_sanskrit": "पुनर्यौवनमासाद्य दारिद्र्येण प्रपीड्यते ।\nरोगेण गुरुणा वापि अनावृष्ट्यादिना तथा॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000514088, "chapter_id": 20514, "verse_number": "३-६१-८९", "content_sanskrit": "वार्द्धकेन लभेत्पीडामनिर्वाच्यामितस्ततः ।\nमनसश्चलनाद्व्याधेस्ततो मरणमाप्नुयात्॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000514089, "chapter_id": 20514, "verse_number": "३-६१-९०", "content_sanskrit": "न तस्मादधिकं दुःखं संसारेप्यनुभूयते ।\nततः कर्म्मवशाज्जंतुर्यमलोके प्रपीड्यते॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000514090, "chapter_id": 20514, "verse_number": "३-६१-९१", "content_sanskrit": "तत्रातियातनां भुक्त्वा पुनरेव प्रजायते ।\nजायते म्रियते जंतु म्रियते जायते पुनः॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000514091, "chapter_id": 20514, "verse_number": "३-६१-९२", "content_sanskrit": "अनाराधित गोविंदचरणे त्वीदृशी दशा ।\nअनायासेन मरणं विनायासेन जीवनम्॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000514092, "chapter_id": 20514, "verse_number": "३-६१-९३", "content_sanskrit": "अनाराधितगोविंदचरणस्य न जायते ।\nधनं यदि भवेद्गेहे रक्षणात्तस्य किं फलम्॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000514093, "chapter_id": 20514, "verse_number": "३-६१-९४", "content_sanskrit": "यदासौ कृष्यते याम्यैर्दूतैः किं धनमन्वियात् ।\nतस्माद्द्विजातिसत्कार्यं द्रविणं सर्वसौख्यदम्॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000514094, "chapter_id": 20514, "verse_number": "३-६१-९५", "content_sanskrit": "दानं स्वर्गस्य सोपानं दानं किल्बिषनाशनम् ।\nगोविंदभक्तिभजनं महापुण्यविवर्द्धनम्॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000514095, "chapter_id": 20514, "verse_number": "३-६१-९६", "content_sanskrit": "बलं यदि भवेन्मर्त्ये न वृथा तद्व्ययं चरेत् ।\nहरेरग्रे नृत्यगीतं कुर्यादेवमतंद्रितः॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000514096, "chapter_id": 20514, "verse_number": "३-६१-९७", "content_sanskrit": "यत्किंचिद्विद्यते पुंसां तच्च कृष्णे समर्पयेत् ।\nकृष्णार्पितं कुशलदमन्यार्पितमसौख्यदम्॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000514097, "chapter_id": 20514, "verse_number": "३-६१-९८", "content_sanskrit": "चक्षुर्भ्यां श्रीहरेरेव प्रतिमादिनिरूपणम् ।\nश्रोत्राभ्यां कलयेत्कृष्ण गुणनामान्यहर्निशम्॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000514098, "chapter_id": 20514, "verse_number": "३-६१-९९", "content_sanskrit": "जिह्वया हरिपादांबु स्वादितव्यं विचक्षणैः ।\nघ्राणेनाघ्राय गोविंदपादाब्जतुलसीदलम्॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000514099, "chapter_id": 20514, "verse_number": "३-६१-१००", "content_sanskrit": "त्वचा स्पृष्ट्वा हरेर्भक्तं मनसाध्याय तत्पदम् ।\nकृतार्थो जायते जंतुर्नात्र कार्या विचारणा॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000514100, "chapter_id": 20514, "verse_number": "३-६१-१०१", "content_sanskrit": "तन्मना हि भवेत्प्राज्ञस्तथा स्यात्तद्गताशयः ।\nतमेवांतेभ्येति लोको नात्र कार्या विचारणा॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000514101, "chapter_id": 20514, "verse_number": "३-६१-१०२", "content_sanskrit": "चेतसा चाप्यनुध्यातः स्वपदं यः प्रयच्छति ।\nनारायणमनाद्यंतं न तं सेवेत को जनः॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000514102, "chapter_id": 20514, "verse_number": "३-६१-१०३", "content_sanskrit": "सतत नियतचित्तो विष्णुपादारविंदे वितरणमनुशक्ति प्रीतये तस्य कुर्यात् ।\nनतिमतिरतिमस्यांघ्रिद्वये संविदध्यात्स हि खलु नरलोके पूज्यतामाप्नुयाच्च॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}]