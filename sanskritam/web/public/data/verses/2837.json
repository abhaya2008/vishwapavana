[{"id": 2086370, "chapter_id": 2837, "verse_number": "१२-३४२-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2086371, "chapter_id": 2837, "verse_number": "१२-३४२-१", "content_sanskrit": "गृहस्थो ब्रह्मचारी वा वानप्रस्थोऽथ भिक्षुकः।\nय इच्छेत्सिद्धिमास्थातुं देवतां कां यजेत सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2086372, "chapter_id": 2837, "verse_number": "१२-३४२-२", "content_sanskrit": "कुतो ह्यस्य ध्रुवः स्वर्गः कुतो नैःश्रेयसं परम्।\nविधिना केन जुहुयाद्दैवं पित्र्यं तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2086373, "chapter_id": 2837, "verse_number": "१२-३४२-३", "content_sanskrit": "मुक्तश्च कां गतिं गच्छेन्मोक्षश्चैव किमात्मकः।\nस्वर्गतश्चैव किं कुर्याद्येन न च्यवते दिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2086374, "chapter_id": 2837, "verse_number": "१२-३४२-४", "content_sanskrit": "देवतानां च को देवः पितॄणां च पिता तथा।\nतस्मात्परतरं यच्च तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2086375, "chapter_id": 2837, "verse_number": "१२-३४२-५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2086376, "chapter_id": 2837, "verse_number": "१२-३४२-५", "content_sanskrit": "गूढं मां प्रश्नवित्प्रश्नं पृच्छसे त्वमिहानघ।\nन ह्येतत्तर्कया शक्यं वक्तुं वर्षशतैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2086377, "chapter_id": 2837, "verse_number": "१२-३४२-६", "content_sanskrit": "ऋते देवप्रसादाद्वा राजञ्ज्ञानागमेन वा।\nगहनं ह्येतदाख्यानं व्याख्यातव्यं तवारिहन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2086378, "chapter_id": 2837, "verse_number": "१२-३४२-७", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nनारदस्य च संवादमृषेर्नारायणस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2086379, "chapter_id": 2837, "verse_number": "१२-३४२-८", "content_sanskrit": "नारायणो हि विश्वात्मा चतुर्मूर्तिः सनातनः।\nधर्मात्मजः संबभूव पितैवं मेऽभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2086380, "chapter_id": 2837, "verse_number": "१२-३४२-९", "content_sanskrit": "कृते युगे महाराज पुरा स्वायंभुवेऽन्तरे।\nनरो नारायणश्चैव हरिः कृष्णस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2086381, "chapter_id": 2837, "verse_number": "१२-३४२-१०", "content_sanskrit": "तेषां नारायणनरौ तपस्तेपतुरव्ययौ।\nबदर्याश्रममासाद्य शकटे कनकामये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2086382, "chapter_id": 2837, "verse_number": "१२-३४२-११", "content_sanskrit": "अष्टचक्रं हि तद्यानं भूतयुक्तं मनोरमम्।\nतत्राद्यौ लोकनाथौ तौ कृशौ धमनिसंततौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2086383, "chapter_id": 2837, "verse_number": "१२-३४२-१२", "content_sanskrit": "तपसा तेजसा चैव दुर्निरीक्ष्यौ सुरैरपि।\nयस्य प्रसादं कुर्वाते स देवौ द्रष्टुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2086384, "chapter_id": 2837, "verse_number": "१२-३४२-१३", "content_sanskrit": "नूनं तयोरनुमते हृदि हृच्छपचोदितः।\nमहामेरोगिंरेः शृङ्गात्प्रत्युतो गन्धमादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2086385, "chapter_id": 2837, "verse_number": "१२-३४२-१४", "content_sanskrit": "नारदः सुमहद्भूतं सर्वलोकानचीचरत्।\nतं देशमगमद्राजन्वदर्याश्रममाशुगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2086386, "chapter_id": 2837, "verse_number": "१२-३४२-१५", "content_sanskrit": "तयोराह्निकवेलायां तस्य कौतूहलं त्वभूत्।\nइदं तदास्पदं कृत्स्नं यस्मिँल्लोकाः प्रतिष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2086387, "chapter_id": 2837, "verse_number": "१२-३४२-१६", "content_sanskrit": "सदेवासुरगन्धर्वाः सकिन्नरमहोरगाः।\nएका मूर्तिरियं पूर्वं जाता भूयश्चतुर्विधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2086388, "chapter_id": 2837, "verse_number": "१२-३४२-१७", "content_sanskrit": "धर्मस्य कुलसंताने धर्मादेभिर्विवर्धितः।\nअहो ह्यनुगृहीतोऽद्य धर्म एभिः सुरैरिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2086389, "chapter_id": 2837, "verse_number": "१२-३४२-१८", "content_sanskrit": "नरनारायणाभ्यां च कृष्णेन हरिणा तथा।\nअत्र कृष्णो हरिश्चैव कस्मिंश्चित्कारणान्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2086390, "chapter_id": 2837, "verse_number": "१२-३४२-१९", "content_sanskrit": "स्थितौ धर्मसुतावेतौ तथा तपसि धिष्ठितौ।\nएतौ हि परमं धाम काऽनयोराह्निकक्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2086391, "chapter_id": 2837, "verse_number": "१२-३४२-२०", "content_sanskrit": "पितरौ सर्वभूतानां दैवतं च यशस्विनौ।\nकां देवतां तु यजतः पितॄन्वा कान्महामती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2086392, "chapter_id": 2837, "verse_number": "१२-३४२-२१", "content_sanskrit": "इति संचिन्त्य मनसा भक्त्या नारायणस्य तु।\nसहसा प्रादुरभवत्समीपे देवयोस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2086393, "chapter_id": 2837, "verse_number": "१२-३४२-२२", "content_sanskrit": "कृते दैवे च पित्र्ये च ततस्ताभ्यां निरीक्षितः।\nपूजितश्चैव विधिना यथाप्रोक्तेन शास्त्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2086394, "chapter_id": 2837, "verse_number": "१२-३४२-२३", "content_sanskrit": "तद्दृष्ट्वा महदाश्चर्यमपूर्वं विधिविस्तरम्।\nउपोपविष्टः सुप्रीतो नारदो भगवानृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2086395, "chapter_id": 2837, "verse_number": "१२-३४२-२४", "content_sanskrit": "नारायणं संनिरीक्ष्य प्रसन्नेनान्तरात्मना।\nनमस्कृत्य महादेवमिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2086396, "chapter_id": 2837, "verse_number": "१२-३४२-२५", "content_sanskrit": "वेदेषु सपुराणेषु साङ्गोपाङ्गेषु गीयसे।\nत्वमजः शाश्वतो धाता माता मृतमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2086397, "chapter_id": 2837, "verse_number": "१२-३४२-२६", "content_sanskrit": "प्रतिष्ठितं भूतभव्यं त्वयि सर्वमिदं जगत्।\nचत्वारो ह्याश्रमा देव सर्वे गार्हस्थ्यमूलकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2086398, "chapter_id": 2837, "verse_number": "१२-३४२-२७", "content_sanskrit": "यजन्ते त्वामहरहर्नानामूर्तिसमास्थितम्।\nपिता माता च सर्वस्य देवतानां च शाश्वतम्।\nकं त्वद्य यजसे देवं पितरं कं न विद्महे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2086399, "chapter_id": 2837, "verse_number": "१२-३४२-२८", "content_sanskrit": "`कमर्चसि महाभाग तन्मे प्रब्रूहि पृच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2086400, "chapter_id": 2837, "verse_number": "१२-३४२-२९x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2086401, "chapter_id": 2837, "verse_number": "१२-३४२-२९", "content_sanskrit": "अवाच्यमेतद्वक्तव्यमात्मगुह्यं सनातनम्।\nतव भक्तिमतो ब्रह्मन्वक्ष्यामि तु यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2086402, "chapter_id": 2837, "verse_number": "१२-३४२-३०", "content_sanskrit": "यत्तत्सूक्ष्ममविज्ञेयमव्यक्तमचलं ध्रुवम्।\nइन्द्रियैन्द्रियार्थैश्च सर्वभूतैश्च वर्जितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2086403, "chapter_id": 2837, "verse_number": "१२-३४२-३१", "content_sanskrit": "स ह्यन्तरात्मा भूतानां क्षेत्रज्ञश्चेति कथ्यते।\nत्रिगुणव्यतिरिक्तो वै पुरुषश्चेति कल्पितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2086404, "chapter_id": 2837, "verse_number": "१२-३४२-३२", "content_sanskrit": "तस्मादव्यक्तमुत्पन्नं त्रिगुणं द्विजसत्तम।\nअव्यक्ताव्यक्तभावस्था या सा प्रकृतिरव्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2086405, "chapter_id": 2837, "verse_number": "१२-३४२-३३", "content_sanskrit": "तां योनिमावयोर्विद्धि योसौ सदसदात्मकः।\nआवाभ्यां पूज्यते यो हि दैवे पित्र्ये च कल्प्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2086406, "chapter_id": 2837, "verse_number": "१२-३४२-३४", "content_sanskrit": "नास्ति तस्मात्परोऽन्यो हि पिता देवोऽथवा द्विज।\nआत्मा हि नौ स विज्ञेयस्ततस्तं पूजयावहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2086407, "chapter_id": 2837, "verse_number": "१२-३४२-३५", "content_sanskrit": "तेनैषा प्रथिता ब्रह्मन्मर्यादा लोकमाविनी।\nदैवं पित्र्यं च कर्तव्यमिति तस्यानुशासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2086408, "chapter_id": 2837, "verse_number": "१२-३४२-३६", "content_sanskrit": "ब्रह्मा स्थाणुर्मनुर्दक्षो भृगुर्धर्मस्तथा यमः।\nमरीचिरङ्गिराश्चात्रिः पुलस्त्यः पुलहः क्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2086409, "chapter_id": 2837, "verse_number": "१२-३४२-३७", "content_sanskrit": "वसिष्ठः परमेष्ठी च विवस्वान्सोम एव च।\nकर्दमश्चापि यः प्रोक्तः क्रोधो विक्रीत एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2086410, "chapter_id": 2837, "verse_number": "१२-३४२-३८", "content_sanskrit": "*एकविंशतिरुत्पन्नास्ते प्रजापतयः स्मृताः।\nतस्य देवस्य मर्यादां पूजयन्तः सनातनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2086411, "chapter_id": 2837, "verse_number": "१२-३४२-३९", "content_sanskrit": "दैवं पित्र्यं च सततं तस्य विज्ञाय तत्त्वतः।\nआत्मप्राप्तानि च ततो जानन्ति द्विजसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2086412, "chapter_id": 2837, "verse_number": "१२-३४२-४०", "content_sanskrit": "स्वर्गस्था अपि ये केचित्तान्नमस्यन्ति देहिनः।\nते तत्प्रसादाद्गच्छन्ति तेनादिष्टफलां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2086413, "chapter_id": 2837, "verse_number": "१२-३४२-४१", "content_sanskrit": "ये हीनाः सप्तदशभिर्गुणैः कर्मभिरेव च।\nकलाः पञ्चदश त्यक्त्वा ते मुक्ता इति निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2086414, "chapter_id": 2837, "verse_number": "१२-३४२-४२", "content_sanskrit": "मुक्तानां तु गतिर्ब्रह्मन्क्षेत्रज्ञ इति कल्पिता।\nस हि सर्वगतिश्चैव निर्गुणश्चैव कथ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2086415, "chapter_id": 2837, "verse_number": "१२-३४२-४३", "content_sanskrit": "दृश्यते ज्ञानयोगेन आवां च प्रसृतौ ततः।\nएवं ज्ञात्वा तमात्मानं पूजयावः सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2086416, "chapter_id": 2837, "verse_number": "१२-३४२-४४", "content_sanskrit": "तं वेदाश्चाश्रमाश्चैव नानातनुसमाश्रितम्।\nभक्त्या संपूजयन्त्यद्य गतिं चैषां ददाति सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2086417, "chapter_id": 2837, "verse_number": "१२-३४२-४५", "content_sanskrit": "ये तु तद्भाविता लोके ह्येकान्तित्वं समास्थिताः।\nएतदभ्यधिकं तेषां यत्ते तं प्रविशन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2086418, "chapter_id": 2837, "verse_number": "१२-३४२-४६", "content_sanskrit": "इति गुह्यसमुद्देशस्तव नारद कीर्तितः।\nभक्त्या प्रेम्णा च विप्रर्षे अस्मद्भक्त्या च ते श्रुतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2086419, "chapter_id": 2837, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि द्विचत्वारिंशदधिकत्रिशततमोऽध्यायः॥ ३४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]