[{"id": 2209935, "chapter_id": 5490, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209936, "chapter_id": 5490, "verse_number": "१", "content_sanskrit": "स तु वाजी समुद्रान्ताम् अभ्येत्य पृथिवीमिमाम् ।\nनिवृत्तोऽभिमुखो राजन् येन नागाह्वयं पुरम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209937, "chapter_id": 5490, "verse_number": "२", "content_sanskrit": "अनुगच्छन् स तेजस्वी निवृत्तोऽथ किरीटधृक् ।\nयदृच्छया समापेदे पुरं राजगृहं तदा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209938, "chapter_id": 5490, "verse_number": "३", "content_sanskrit": "तमभ्याशगतं राजा जरासन्धात्मजात्मजः ।\nक्षत्रधर्मे स्थितो वीरः समरायाजुहाव ह ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209939, "chapter_id": 5490, "verse_number": "४", "content_sanskrit": "ततः पुरात् स निष्क्रम्य रथी धन्वी तली शरी ।\nमेघसन्धिः पदातिं तं धनञ्जयमुपाद्रवत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209940, "chapter_id": 5490, "verse_number": "५", "content_sanskrit": "आसाद्य तु महातेजा मेघसन्धिर्धनञ्जयम् ।\nबालभावान्महाराज प्रोवाचेदं न कौशलात् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209941, "chapter_id": 5490, "verse_number": "", "content_sanskrit": "मेघसन्धिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209942, "chapter_id": 5490, "verse_number": "६", "content_sanskrit": "किमयं चार्यते वाजी स्त्रीमध्य इव कौरव ।\nहयमेनं हरिष्यामि प्रयतस्व विमोक्षणे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209943, "chapter_id": 5490, "verse_number": "७", "content_sanskrit": "आर्तो ननु पुरा युद्धे यदि त्वं भ्रातृभिः सह ।\nकरिष्यामि तवातिथ्यं प्रहर प्रहरामि च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209944, "chapter_id": 5490, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209945, "chapter_id": 5490, "verse_number": "८", "content_sanskrit": "इत्युक्तः प्रत्युवाचेदं पाण्डवः प्रहसन्निव ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209946, "chapter_id": 5490, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209947, "chapter_id": 5490, "verse_number": "९", "content_sanskrit": "विघ्नकर्ता मया वार्य इति मे व्रतमाहितम् ।\nभ्रात्रा ज्येष्ठेन नृपते तवापि विदितं ध्रुवम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209948, "chapter_id": 5490, "verse_number": "१०", "content_sanskrit": "प्रहरस्व यथाशक्ति न मन्युर्विद्यते मम ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209949, "chapter_id": 5490, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209950, "chapter_id": 5490, "verse_number": "११", "content_sanskrit": "इत्युक्तः प्राहरत् पूर्वं पाण्डवं मगधेश्वरः ।\nकिरन् शरसहस्राणि वर्षाणीव सहस्रदृक् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209951, "chapter_id": 5490, "verse_number": "१२", "content_sanskrit": "ततो गाण्डीवभृत् शूरो गाण्डीवप्रेरितैः शरैः ।\nचकार बाणांस्तान् मोघान् अयत्नाद् भरतर्षभ ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209952, "chapter_id": 5490, "verse_number": "१३", "content_sanskrit": "स मोघं तस्य बाणौघं कृत्वा वानरकेतनः ।\nशरान् मुमोच ज्वलितान् दीप्तास्यानिव पन्नगान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209953, "chapter_id": 5490, "verse_number": "१४", "content_sanskrit": "रथे पताकादण्डे च रथयन्त्रहयेषु च ।\nअन्येषु च हयाङ्गेषु न शरीरे न सारथौ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209954, "chapter_id": 5490, "verse_number": "१५", "content_sanskrit": "संरक्ष्यमाणः पार्थेन शरीरे फल्गुनस्य ह ।\nमन्यमानः स्ववीर्यं तं मागधः प्राहिणोच्छरान् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209955, "chapter_id": 5490, "verse_number": "१६", "content_sanskrit": "ततो गाण्डीवभृच्छूरो मागधेन भृशार्दितः ।\nबभौ वासन्तिक इव पलाशः पुष्पितो महान् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209956, "chapter_id": 5490, "verse_number": "१७", "content_sanskrit": "अवध्यमानः सोऽभ्यघ्नन् मागधः पाण्डवर्षभम् ।\nतेन तस्थौ स कौरव्य लोकवीरस्य दर्शने ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209957, "chapter_id": 5490, "verse_number": "१८", "content_sanskrit": "सव्यसाची तु सङ्क्रुद्धो विकृष्य बलवद्धनुः ।\nहयांश्चकार निर्देहान् सारथेश्च शिरोऽहरत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209958, "chapter_id": 5490, "verse_number": "१९", "content_sanskrit": "धनुश्चास्य महच्चित्रं क्षुरेण विचकर्त ह ।\nहस्तावापं पताकां च ध्वजं चास्य न्यवातयत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2209959, "chapter_id": 5490, "verse_number": "२०", "content_sanskrit": "स राजा व्यथितो व्यश्वो विधनुष्को विसारथिः ।\nगदामादाय कौन्तेयमभिदुद्राव वेगवान् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2209960, "chapter_id": 5490, "verse_number": "२१", "content_sanskrit": "तस्यापतत एवाशु गदां हेमपरिष्कृताम् ।\nशरैश्चकर्त निशितैर्बहुभिर्गृध्रवाजितैः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2209961, "chapter_id": 5490, "verse_number": "२२", "content_sanskrit": "सा गदा शकलीभूता विकीर्णमणिबन्धना ।\nव्याली निर्मुच्यमानेव पपात धरणीं पति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2209962, "chapter_id": 5490, "verse_number": "२३", "content_sanskrit": "विरथं तं विधनुषं गदया परिवर्जितम् ।\nनैच्छत् ताडयितुं धीमान् अर्जुनः समराग्रणीः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2209963, "chapter_id": 5490, "verse_number": "२४", "content_sanskrit": "तत एनं विमनसं क्षत्रधर्मं समास्थितम् ।\nसान्त्वपूर्वमिदं वाक्यमब्रवीत् कपिकेतनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2209964, "chapter_id": 5490, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2209965, "chapter_id": 5490, "verse_number": "२५", "content_sanskrit": "पर्याप्तः क्षत्रधर्मोऽयं दर्शितः पुत्र गम्यताम् ।\nबह्वेतत् समरे कर्म तव बालस्य पार्थिव ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2209966, "chapter_id": 5490, "verse_number": "२६", "content_sanskrit": "युधिष्ठिरस्य सन्देशो न हन्तव्या नृपा इति ।\nतेन जीवसि राजंस्त्वमपराद्धोऽपि मे रणे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2209967, "chapter_id": 5490, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2209968, "chapter_id": 5490, "verse_number": "समाप्तिः", "content_sanskrit": "इति मत्वा स चात्मानं प्रत्यादिष्टः स मागधः ।\nतथ्यमित्यभिगम्यैनं प्राञ्जलिः प्रत्यपूजयत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2209969, "chapter_id": 5490, "verse_number": "२८", "content_sanskrit": "तमर्जुनः समाश्वास्य पुनरेवेदमब्रवीत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2209970, "chapter_id": 5490, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2209971, "chapter_id": 5490, "verse_number": "२९", "content_sanskrit": "आगन्तव्यं परां चैत्रीमश्वमेधे नृपस्य नः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2209972, "chapter_id": 5490, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2209973, "chapter_id": 5490, "verse_number": "३०", "content_sanskrit": "इत्युक्तः स तथेत्युक्त्वा पूजयामास तं हयम् ।\nफल्गुनं च युधि श्रेष्ठं विधिवत् सहदेवजः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2209974, "chapter_id": 5490, "verse_number": "३१", "content_sanskrit": "ततो यथेष्टमगमत् पुनरेव स कौरवः ।\nततः समुद्रतीरेण वङ्गान् पुण्ड्रान् सकेरलान् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2209975, "chapter_id": 5490, "verse_number": "३२", "content_sanskrit": "तत्र तत्र च भूरीणि म्लेच्छसैन्यान्यनेकशः ।\nविजिग्ये धनुषा राजन् गाण्डीवेन धनञ्जयः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2209976, "chapter_id": 5490, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अश्वसञ्चरणे मागधयुद्धं नाम चतुरशीतितमोऽध्यायः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]