[{"id": 6000187000, "chapter_id": 10187, "verse_number": null, "content_sanskrit": "अथ द्वादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000187001, "chapter_id": 10187, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.001.m4a", "display_order": 2}, {"id": 6000187002, "chapter_id": 10187, "verse_number": "९-१२-१", "content_sanskrit": "अथातः श्रूयतां राजन् वंशः सोमस्य पावनः।\nयस्मिन्नैलादयो भूपाः कीर्त्यन्ते पुण्यकीर्तयः॥ ९/१२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.002.m4a", "display_order": 3, "topics": [{"text": "एवं षष्ठादित्रयोदशान्तैरष्टभिरध्यायैः इक्ष्वाकोर्वंशमुक्त्वा चन्द्रवंशकथनारम्भः", "range": "१–३"}]}, {"id": 6000187003, "chapter_id": 10187, "verse_number": "९-१२-२", "content_sanskrit": "सहस्रशिरसः पुंसो नाभिह्रदसरोरुहात्।\nजातस्यासीत् सुतो धातुरत्रिः पितृसमो गुणैः॥ ९/१२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.003.m4a", "display_order": 4}, {"id": 6000187004, "chapter_id": 10187, "verse_number": "९-१२-३", "content_sanskrit": "तस्य दृग्भ्योऽभवत् पुत्रः सोमोऽमृतमयः किल।\nविप्रौषध्यम्बुगर्भाणां ब्रह्मणा कल्पितः पतिः॥ ९/१२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.004.m4a", "display_order": 5}, {"id": 6000187005, "chapter_id": 10187, "verse_number": "९-१२-४", "content_sanskrit": "सोऽयजद् राजसूयेन विजित्य भुवनत्रयम्।\nपत्नीं बृहस्पतेर्दर्पात् तारां नामाहरद् बलात्॥ ९/१२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.005.m4a", "display_order": 6, "topics": [{"text": "बृहस्पतिभार्यायां तारायां चन्द्राद्बुधोत्पत्तिः", "range": "४–१५"}]}, {"id": 6000187006, "chapter_id": 10187, "verse_number": "९-१२-५", "content_sanskrit": "यदा स देवगुरुणा याचितोऽभीक्ष्णशो मदात्।\nनात्यजत् तत्कृते जज्ञे सुरदानवविग्रहः॥ ९/१२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.006.m4a", "display_order": 7}, {"id": 6000187007, "chapter_id": 10187, "verse_number": "९-१२-६", "content_sanskrit": "शुक्रो बृहस्पतेर्द्वेषादग्रहीत् सासुरोडुपम्।\nहरो गुरुसुतस्नेहात् सर्वभूतगणावृतः॥ ९/१२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.007.m4a", "display_order": 8}, {"id": 6000187008, "chapter_id": 10187, "verse_number": "९-१२-७", "content_sanskrit": "सर्वदेवगणोपेतो महेन्द्रो गुरुमन्वयात्।\nसुरासुरविनाशोऽभूत् समरस्तारकामयः॥ ९/१२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.008.m4a", "display_order": 9}, {"id": 6000187009, "chapter_id": 10187, "verse_number": "९-१२-८", "content_sanskrit": "निवेदितोऽजोऽङ्गिरसा सोमं निर्भर्त्स्य विश्वकृत्।\nतारां स्वभर्त्रे प्रायच्छदन्तर्वत्नीं बृहस्पतिः॥ ९/१२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.009.m4a", "display_order": 10}, {"id": 6000187010, "chapter_id": 10187, "verse_number": "९-१२-९", "content_sanskrit": "गर्भं त्यजाशु दुष्प्रज्ञे मत्क्षेत्रादाहितं परैः।\nनाहं त्वां भस्मसात् कुर्यां स्‍त्रियं सान्तानिके सति॥ ९/१२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.010.m4a", "display_order": 11}, {"id": 6000187011, "chapter_id": 10187, "verse_number": "९-१२-१०", "content_sanskrit": "तत्याज व्रीडिता तारा कुमारं कनकप्रभम्।\nतस्यां जज्ञे दस्युहन्ता कुमारः कनकप्रभः॥ ९/१२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.011.m4a", "display_order": 12}, {"id": 6000187012, "chapter_id": 10187, "verse_number": "९-१२-११", "content_sanskrit": "स्पृहामाङ्गिरसश्चक्रे कुमारे सोम एव च।\nममायं न तवेत्युच्चैस्तस्मिन् विवदमानयोः॥ ९/१२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.012.m4a", "display_order": 13}, {"id": 6000187013, "chapter_id": 10187, "verse_number": "९-१२-१२", "content_sanskrit": "पप्रच्छुर्ऋषयो देवा नैवोचे व्रीडिता च सा।\nकुमारो मातरं प्राह कुपितोऽलीकलज्जया॥ ९/१२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.013.m4a", "display_order": 14}, {"id": 6000187014, "chapter_id": 10187, "verse_number": "९-१२-१३", "content_sanskrit": "किं न वोचस्यसद्वृत्ते पितरं मे वदाशु वै।\nन त्वां तु भस्मसात् कुर्यामात्मावद्यविगूहीनीम्॥ ९/१२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.014.m4a", "display_order": 15}, {"id": 6000187015, "chapter_id": 10187, "verse_number": "९-१२-१४", "content_sanskrit": "ब्रह्मा तं तु विनिर्भर्त्स्य क्षेप्तारं मातुरन्तिके।\nतामाहूय समप्राक्षीद् रह एव तु सान्त्वया॥ ९/१२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.015.m4a", "display_order": 16}, {"id": 6000187016, "chapter_id": 10187, "verse_number": "९-१२-१५", "content_sanskrit": "सोमस्येत्याह शनकैः सोमस्तं तावदग्रहीत्।\nतस्यात्मयोनिरकृत बुध इत्यभिधां नृप॥ ९/१२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.016.m4a", "display_order": 17}, {"id": 6000187017, "chapter_id": 10187, "verse_number": "९-१२-१६", "content_sanskrit": "बुद्ध्या गम्भीरया येन पुत्रेणापोडुराण् मुदम्।\nततः पुरूरवा जज्ञे इलायां य उदाहृतः॥ ९/१२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.017.m4a", "display_order": 18, "topics": [{"text": "वैवस्वतमनुपुत्र्याम् इलायां बुधादुत्पन्नस्य पुरूरवसः उर्वश्यां पुत्रोत्पत्तिः", "range": "१६–५१"}]}, {"id": 6000187018, "chapter_id": 10187, "verse_number": "९-१२-१७", "content_sanskrit": "तस्य रूपगुणौदार्यशीलद्रविणविक्रमान्।\nश्रुत्वोर्वशीन्द्रभवने गीयमानान् सुरर्षिणा॥ ९/१२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.018.m4a", "display_order": 19}, {"id": 6000187019, "chapter_id": 10187, "verse_number": "९-१२-१८", "content_sanskrit": "तदन्तिकमुपेयाय देवी स्मरशरार्दिता।\nमित्रावरुणयोः शापादापन्ना नरलोकताम्॥ ९/१२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.019.m4a", "display_order": 20}, {"id": 6000187020, "chapter_id": 10187, "verse_number": "९-१२-१९", "content_sanskrit": "निशाम्य पुरुषश्रेष्ठं कन्दर्पमिव रूपिणम्।\nधृतिं विहाय ललना उपतस्थे तदन्तिकम्॥ ९/१२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.020.m4a", "display_order": 21}, {"id": 6000187021, "chapter_id": 10187, "verse_number": "९-१२-२०", "content_sanskrit": "स तां विलोक्य नृपतिर्हर्षेणोत्फुल्ललोचनः।\nउवाच श्लक्ष्णया वाचा देवीं हृष्टतनूरुहः॥ ९/१२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.021.m4a", "display_order": 22}, {"id": 6000187022, "chapter_id": 10187, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.022.m4a", "display_order": 23}, {"id": 6000187023, "chapter_id": 10187, "verse_number": "९-१२-२१", "content_sanskrit": "स्वागतं ते वरारोहे आस्यतां करवाम किम्।\nसंरमस्व मया साकं रतिर्नौ शाश्वतीः समाः॥ ९/१२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.023.m4a", "display_order": 24}, {"id": 6000187024, "chapter_id": 10187, "verse_number": null, "content_sanskrit": "ऊर्वश्युवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.024.m4a", "display_order": 25}, {"id": 6000187025, "chapter_id": 10187, "verse_number": "९-१२-२२", "content_sanskrit": "कस्यास्त्वयि न सज्जेत मनो दृष्टिश्च सुन्दर।\nयदङ्गान्न रमा याति स दृष्टो हरिराश्रयः॥ ९/१२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.025.m4a", "display_order": 26}, {"id": 6000187026, "chapter_id": 10187, "verse_number": "९-१२-२३", "content_sanskrit": "एतावुरणकौ राजन् न्यस्तौ रक्षस्व मानद।\nसंरंस्ये भवता साकं श्लाघ्यः स्‍त्रीणां वरः स्मृतः॥ ९/१२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.026.m4a", "display_order": 27}, {"id": 6000187027, "chapter_id": 10187, "verse_number": "९-१२-२४", "content_sanskrit": "घृतं मे वीर भक्ष्यं स्यान्नेक्षे त्वाऽन्यत्र मैथुनात्।\nविवाससं तत् तथेति प्रतिपेदे महामनाः॥ ९/१२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.027.m4a", "display_order": 28}, {"id": 6000187028, "chapter_id": 10187, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.028.m4a", "display_order": 29}, {"id": 6000187029, "chapter_id": 10187, "verse_number": "९-१२-२५", "content_sanskrit": "अहो रूपमहो भावं नरलोकविमोहनम्।\nको न सेवेत मनुजो देवीं त्वां स्वयमागताम्॥ ९/१२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.029.m4a", "display_order": 30}, {"id": 6000187030, "chapter_id": 10187, "verse_number": null, "content_sanskrit": "शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.030.m4a", "display_order": 31}, {"id": 6000187031, "chapter_id": 10187, "verse_number": "९-१२-२६", "content_sanskrit": "तया स पुरुषश्रेष्ठो रमयन्त्या यथार्हतः।\nरेमे सुरविहारेषु कामं चैत्ररथादिषु॥ ९/१२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.031.m4a", "display_order": 32}, {"id": 6000187032, "chapter_id": 10187, "verse_number": "९-१२-२७", "content_sanskrit": "रममाणस्तया देव्या पद्मकिञ्जल्कगन्धया।\nतन्मुखामोदमुषितो मुमुदेऽब्दगणान् बहून्॥ ९/१२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.032.m4a", "display_order": 33}, {"id": 6000187033, "chapter_id": 10187, "verse_number": "९-१२-२८", "content_sanskrit": "अपश्यन्नुर्वशीमिन्द्रो गन्धर्वान् समचोदयत्।\nउर्वशीरहितं मह्यमास्थानं नातिशोभते॥ ९/१२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.033.m4a", "display_order": 34}, {"id": 6000187034, "chapter_id": 10187, "verse_number": "९-१२-२९", "content_sanskrit": "त उपेत्य महारात्रौ तमसि प्रत्युपस्थिते।\nउर्वश्या उरणौ जह्रुर्न्यस्तौ राजनि जायया॥ ९/१२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.034.m4a", "display_order": 35}, {"id": 6000187035, "chapter_id": 10187, "verse_number": "९-१२-३०", "content_sanskrit": "निशम्याक्रन्दितं देवी पुत्रयोर्नीयमानयोः।\nहताऽस्म्यहं कुनाथेन नपुंसा वीरमानिना॥ ९/१२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.035.m4a", "display_order": 36}, {"id": 6000187036, "chapter_id": 10187, "verse_number": "९-१२-३१", "content_sanskrit": "यद्विस्रम्भादहं नष्टा हृतापत्या च दस्युभिः।\nयः शेते निशि सन्त्रस्तो यथा नारी दिवा पुमान्॥ ९/१२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.036.m4a", "display_order": 37}, {"id": 6000187037, "chapter_id": 10187, "verse_number": "९-१२-३२", "content_sanskrit": "इति वाक्सायकैर्विद्धः प्रतोदैरिव कुञ्जरः।\nनिशि निस्‍त्रिंशमादाय विवस्‍त्रोऽभ्यद्रवद् रुषा॥ ९/१२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.037.m4a", "display_order": 38}, {"id": 6000187038, "chapter_id": 10187, "verse_number": "९-१२-३३", "content_sanskrit": "ते विसृज्योरणौ तत्र प्राद्योतन्त स्वविद्युता।\nआदाय मेषावायान्तं नग्नमैक्षत सा पतिम्॥ ९/१२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.038.m4a", "display_order": 39}, {"id": 6000187039, "chapter_id": 10187, "verse_number": "९-१२-३४", "content_sanskrit": "ऐलोऽपि शयने जायामपश्यन् विमना अभूत्।\nतच्चित्तो विक्लवः शोचन् बभ्रामोन्मत्तवन्महीम्॥ ९/१२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.039.m4a", "display_order": 40}, {"id": 6000187040, "chapter_id": 10187, "verse_number": "९-१२-३५", "content_sanskrit": "स तां वीक्ष्य कुरुक्षेत्रे सरस्वत्यां च तत्सखीः।\nपञ्‍च प्रहृष्टवदनः प्राह सूक्तं पुरूरवाः॥ ९/१२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.040.m4a", "display_order": 41}, {"id": 6000187041, "chapter_id": 10187, "verse_number": "९-१२-३६", "content_sanskrit": "अहो जाये तिष्ठ तिष्ठ घोरे न त्यक्तुमर्हसि।\nमन्त्रा अद्याप्यनिर्वृत्ता वचांसि कृणवावहै॥ ९/१२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.041.m4a", "display_order": 42}, {"id": 6000187042, "chapter_id": 10187, "verse_number": "९-१२-३७", "content_sanskrit": "सुदेवोऽयं पतत्यत्र देवि दूरं हृतस्त्वया।\nखादन्त्येनं वृका गृध्रास्त्वत्प्रसादस्य नास्पदम्॥ ९/१२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.042.m4a", "display_order": 43}, {"id": 6000187043, "chapter_id": 10187, "verse_number": null, "content_sanskrit": "ऊर्वश्युवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.043.m4a", "display_order": 44}, {"id": 6000187044, "chapter_id": 10187, "verse_number": "९-१२-३८", "content_sanskrit": "मा मृथाः पुरुषोऽसि त्वं मा स्म त्वाऽद्युर्वृका इमे।\nक्‍वापि सख्यं न वै स्‍त्रीणां वृकाणां हृदयं यथा॥ ९/१२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.044.m4a", "display_order": 45}, {"id": 6000187045, "chapter_id": 10187, "verse_number": "९-१२-३९", "content_sanskrit": "स्‍त्रियो ह्यकरुणाः क्रूरा दुर्मर्षाः प्रियसाहसाः।\nघ्नन्त्यल्पार्थेऽपि विस्रब्धं पतिं भ्रातरमप्युत॥ ९/१२/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.045.m4a", "display_order": 46}, {"id": 6000187046, "chapter_id": 10187, "verse_number": "९-१२-४०", "content_sanskrit": "विधायालीकविस्‍त्रम्भमज्ञेष्वत्यन्तसौख्यदाः।\nनवं नवमभीप्सन्त्यः पुंश्चल्यः स्वैरवृत्तयः॥ ९/१२/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.046.m4a", "display_order": 47}, {"id": 6000187047, "chapter_id": 10187, "verse_number": "९-१२-४१", "content_sanskrit": "संवत्सरान्तेऽपि भवानेकरात्रं मयेश्वर। वत्स्यत्यपत्यानि च ते भविष्यन्त्यपराणि भोः।\nअन्तर्वत्नीमुपालक्ष्य देवीं स प्रययौ पुरीम्॥ ९/१२/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.047.m4a", "display_order": 48}, {"id": 6000187048, "chapter_id": 10187, "verse_number": "९-१२-४२", "content_sanskrit": "पुनस्तत्र गतोऽब्दान्ते ऊर्वशीं वीरमातरम्।\nउपलभ्य मुदा युक्तः समुवास तया निशाम्॥ ९/१२/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.048.m4a", "display_order": 49}, {"id": 6000187049, "chapter_id": 10187, "verse_number": "९-१२-४३", "content_sanskrit": "अथैनमुर्वशी प्राह कृपणं विरहातुरम्।\nगन्धर्वानुपधावेमांस्तुभ्यं दास्यन्ति मामिति॥ ९/१२/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.049.m4a", "display_order": 50}, {"id": 6000187050, "chapter_id": 10187, "verse_number": "९-१२-४४", "content_sanskrit": "तस्य संस्तुवतस्तुष्टा अग्निस्थालीं ददुर्नृप।\nऊर्वशीं मन्यमानस्तां नाबुध्यत चरन् वने॥ ९/१२/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.050.m4a", "display_order": 51}, {"id": 6000187051, "chapter_id": 10187, "verse_number": "९-१२-४५", "content_sanskrit": "स्थालीं न्यस्य वने गत्वा गृहानध्युषितो निशि।\nत्रेतायां सम्प्रवृत्तायां मनसि त्रय्यवर्तत॥ ९/१२/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.051.m4a", "display_order": 52}, {"id": 6000187052, "chapter_id": 10187, "verse_number": "९-१२-४६", "content_sanskrit": "स्थालीस्थानं गतोऽश्वत्थं शमीगर्भं विलक्ष्य सः।\nतेन द्वे अरणी कृत्वा ऊर्वशीलोककाम्यया॥ ९/१२/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.052.m4a", "display_order": 53}, {"id": 6000187053, "chapter_id": 10187, "verse_number": "९-१२-४७", "content_sanskrit": "उर्वशीं मन्त्रतो ध्यायन्नधरारणिमुत्तराम्।\nआत्मानमुभयोर्मध्ये यत् तत् प्रजननं प्रभुः॥ ९/१२/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.053.m4a", "display_order": 54}, {"id": 6000187054, "chapter_id": 10187, "verse_number": "९-१२-४८", "content_sanskrit": "तस्य निर्मथनाज्जातो जातवेदा विभावसुः।\nत्रय्या स विद्यया राज्ञा पुत्रत्वे कल्पितस्‍त्रिवृत्॥ ९/१२/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.054.m4a", "display_order": 55}, {"id": 6000187055, "chapter_id": 10187, "verse_number": "९-१२-४९", "content_sanskrit": "तेनायजत यज्ञेशं भगवन्तमधोक्षजम्।\nउर्वशीलोकमन्विच्छन् सर्वदेवमयं हरिम्॥ ९/१२/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.055.m4a", "display_order": 56}, {"id": 6000187056, "chapter_id": 10187, "verse_number": "९-१२-५०", "content_sanskrit": "एक एव पुरा वेदः प्रणवः सर्ववाङ्मयः।\nदेवो नारायणो नान्य एकोऽग्निर्वर्ण एव च॥ ९/१२/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.056.m4a", "display_order": 57}, {"id": 6000187057, "chapter_id": 10187, "verse_number": "९-१२-५१", "content_sanskrit": "पुरूरवस एवासीत् त्रयी त्रेतामुखे नृप।\nअग्निना प्रजया राजा लोकं गान्धर्वमेयिवान्॥ ९/१२/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_012/BhP_09.012.057.m4a", "display_order": 58}, {"id": 6000187058, "chapter_id": 10187, "verse_number": null, "content_sanskrit": "इति श्रीमद्भागवते वैयासिक्यां संहितायां नवमस्कन्धे द्वादशाध्यायः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]