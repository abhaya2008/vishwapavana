[{"id": 7002542000, "chapter_id": 22542, "verse_number": "१-२०४-१", "content_sanskrit": "सुमन्तुरुवाच ।\nअतः परं प्रवक्ष्यामि विधिं परमपूजितम् ।\nरत्नव्योमप्रतिष्ठायां यथा भानुं प्रपूजयेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002542001, "chapter_id": 22542, "verse_number": "१-२०४-२", "content_sanskrit": "अर्चयित्वा तु प्रकृतिं गंधपुष्पाक्षतैर्विभो ।\nसहोदकेनांजलिना सहपुष्पाक्षतेन वा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002542002, "chapter_id": 22542, "verse_number": "१-२०४-३", "content_sanskrit": "आवाहयेन्महादेवं खषोल्कं भास्करं विभुम् ।\nमन्त्रेण कुरुशार्दूल प्रत्यक्षकिरणाय वै ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002542003, "chapter_id": 22542, "verse_number": "१-२०४-४", "content_sanskrit": "ॐ खषोल्कमावाहयामि ॐ भूर्भुवः स्वरों आदित्याराधने मन्त्रः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002542004, "chapter_id": 22542, "verse_number": "१-२०४-५", "content_sanskrit": "अभिमन्त्र्य भुवे मात्रं सावित्र्या च ऋचा विभो ।\nआपो हिष्ठेति या प्रोक्ता वृथा सूर्यस्य सर्वदा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002542005, "chapter_id": 22542, "verse_number": "१-२०४-६", "content_sanskrit": "यथान्यायं तु संक्षाल्य पूरयेच्चान्यतो यतः ।\nहिरण्यगर्भः समवर्ततेत्यनया क्षालयेद्बुधः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002542006, "chapter_id": 22542, "verse_number": "१-२०४-७", "content_sanskrit": "सविता पश्चातात्सविता ह्यनया पूरयेद्बुधः ।\nइत्येवं पूरयित्वा तु वारि पुष्पाक्षतैर्बुधः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002542007, "chapter_id": 22542, "verse_number": "१-२०४-८", "content_sanskrit": "पात्रमौदुम्बरं गृह्य कृत्स्नं सूर्यस्य दर्शयेत् ।\nउदुत्यं जातवेदसमनया व्योम्नि निक्षिपेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002542008, "chapter_id": 22542, "verse_number": "१-२०४-९", "content_sanskrit": "हंसः शुचिषदिति पाद्यं दद्याद्विचक्षणः ।\nनिर्वापयेच्च पयसा खषोल्कं स्नापयेत्ततः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002542009, "chapter_id": 22542, "verse_number": "१-२०४-१०", "content_sanskrit": "अग्निस्तु सप्तभिर्वीर कीर्तितास्ताश्च कृत्स्नशः ।\nआपो हिष्ठेति च क्रमात्तिसृभिः कुरुनंदन ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002542010, "chapter_id": 22542, "verse_number": "१-२०४-११", "content_sanskrit": "हिरण्यवर्णेति क्रमाच्चतुर्भिश्च नराधिप ।\nअभिमंत्र्योदकमृग्भिस्तिसृभि र्निक्षिपेन्नृप ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002542011, "chapter_id": 22542, "verse_number": "१-२०४-१२", "content_sanskrit": "भानोः प्रदक्षिणं कृत्वा कृणुष्वपाज इत्यपि ।\nत्य मूषु वाजिनं गिरः प्रथमा परिकीर्तिता ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002542012, "chapter_id": 22542, "verse_number": "१-२०४-१३", "content_sanskrit": "पतिमिंद्रस्तवाचाम द्वितीया परिकीर्तिता ।\nपतिमिंद्रस्तु शुद्धो न आगहि तृतीया परिकीर्तिता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002542013, "chapter_id": 22542, "verse_number": "१-२०४-१४", "content_sanskrit": "सिध्ये वृत्राणि जिघ्ने शगंधैर्भानुं प्रपूजयेत् ।\nअस्य वामस्येत्यनया अक्षतैः पूजयेद्रविम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002542014, "chapter_id": 22542, "verse_number": "१-२०४-१५", "content_sanskrit": "सप्त युंजंति रथमनया पूजयेद्रविम् ।\nपुष्पैर्भरतशार्दूल सततं तमनाशनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002542015, "chapter_id": 22542, "verse_number": "१-२०४-१६", "content_sanskrit": "को ददर्श प्रथम मनया धूपमादिशेत् ।\nपाकः पृच्छाम्यनया चंदनं प्रतिपादयेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002542016, "chapter_id": 22542, "verse_number": "१-२०४-१७", "content_sanskrit": "उद्दीप्यस्येत्यनया दीपं दद्याद्विभावसोः ।\nअर्चित्वा कुंकुमं चैव शीर्षं क्षीरं तु मंडलम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002542017, "chapter_id": 22542, "verse_number": "१-२०४-१८", "content_sanskrit": "युक्ता मातासीत्यनया नैवेद्यं प्रतिपादयेत् ।\nगौरीर्मिमायेति दद्यात्तथा शुक्ले च वाससी ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002542018, "chapter_id": 22542, "verse_number": "१-२०४-१९", "content_sanskrit": "तस्याः समुद्रेत्यनया उपवीतं निवेदयेत् ।\nइति संपूज्य देवेशं ततः कुर्यात्परां स्तुतिम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002542019, "chapter_id": 22542, "verse_number": "१-२०४-२०", "content_sanskrit": "ऋग्भिर्वै पंचभिस्तात शृणु चैकमनादृतः ।\nउक्षाणं पृश्निरिति च प्रथमा परिकीर्तिता ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002542020, "chapter_id": 22542, "verse_number": "१-२०४-२१", "content_sanskrit": "चत्वारि वागिति भवेद्द्वितीया परिकीर्तिता ।\nइंद्रं मित्रं तृतीया तु वराधिक्ये प्रकीर्तिता ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002542021, "chapter_id": 22542, "verse_number": "१-२०४-२२", "content_sanskrit": "कृष्णं नियानं हि तथा चतुर्थी परिकीर्तिता ।\nयो रत्नवाहीत्यनया किरीटं योजयेद्रवौ ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002542022, "chapter_id": 22542, "verse_number": "१-२०४-२३", "content_sanskrit": "गतेहनामित्यनया अव्यंगं भास्करं न्यसेत् ।\nइयमददाद्रभसमृणच्युतमिति ऋगादितः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002542023, "chapter_id": 22542, "verse_number": "१-२०४-२४", "content_sanskrit": "कृत्वा पूजां ततश्चर्ग्भिरष्टाभिरिति चाच्युत ।\nदेवस्य शक्तयोऽष्टौ च पूजयेद्विधिवत्क्रमात् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002542024, "chapter_id": 22542, "verse_number": "१-२०४-२५", "content_sanskrit": "इत्येष ते मयाख्यातः प्रतिमापूजने विधिः ।\nयः पुरोक्तो महाबाहो ब्रह्मणा विष्णवे तथा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002542025, "chapter_id": 22542, "verse_number": "१-२०४-२६", "content_sanskrit": "अनेन विधिना यस्तु सततं पूजयेद्रविम् ।\nस प्राप्नोत्यखिलान्कामानिह लोके परत्र च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002542026, "chapter_id": 22542, "verse_number": "१-२०४-२७", "content_sanskrit": "पुत्रार्थी लभते पुत्रान्धनार्थी लभते धनम् ।\nकन्यार्थी लभते कन्यां वेदार्थी वेदविद्भवेत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002542027, "chapter_id": 22542, "verse_number": "१-२०४-२८", "content_sanskrit": "निष्कामः पूजयेद्यस्तु स मोक्षं प्राप्नुयान्नरः ।\nअनेन विधिना पूज्य गतः सिद्धिं स वैष्णवः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002542028, "chapter_id": 22542, "verse_number": "१-२०४-२९", "content_sanskrit": "ब्रह्मादयस्तथा देवं पूजयित्वा विभावसुम् ।\nअनेन विधिना पूज्य संतः सिद्धिं परां गताः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]