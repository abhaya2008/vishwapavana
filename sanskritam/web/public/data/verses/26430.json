[{"id": 7006430000, "chapter_id": 26430, "verse_number": "२-९०-१", "content_sanskrit": "वैशम्पायन उवाच\nतेषां क्रीडावसक्तानां यदूनां पुण्यकर्मणाम् ।\nछिद्रमासाद्य दुर्बुद्धिर्देवशत्रुर्दुरासदः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006430001, "chapter_id": 26430, "verse_number": "२-९०-२", "content_sanskrit": "कन्यां भानुमतीं नाम भानोर्दुहितरं नृप ।\nजहारात्मवधाकाङ्क्षी निकुम्भो नाम दानवः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006430002, "chapter_id": 26430, "verse_number": "२-९०-३", "content_sanskrit": "अन्तर्हितो मोहयित्वा यदूनां प्रमदाजनम् ।\nमायावी मायया राजन् पूर्ववैरमनुस्मरन् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006430003, "chapter_id": 26430, "verse_number": "२-९०-४", "content_sanskrit": "भ्रातुर्हिं वज्रनाभस्य तस्य कन्या प्रभावती ।\nप्रद्युम्नेन हृता वीर वज्रनाभस्तथा हतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006430004, "chapter_id": 26430, "verse_number": "२-९०-५", "content_sanskrit": "भानोरेव तथारण्ये वसत्यवसरेण हि ।\nअस्वाधीने दुराधर्षे छिद्रज्ञो दानवाधमः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006430005, "chapter_id": 26430, "verse_number": "२-९०-६", "content_sanskrit": "कन्यापुरे महानादः सहसा समुपस्थितः ।\nतस्यां ह्रियन्त्यां कन्यायां रुदन्त्यां समितिंजय ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006430006, "chapter_id": 26430, "verse_number": "२-९०-७", "content_sanskrit": "वसुदेबाहुकौ वीरौ दंशितौ निर्गतावुभौ ।\nआर्तनादमुपश्रुत्य भानोः कन्यापुरे तदा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006430007, "chapter_id": 26430, "verse_number": "२-९०-८", "content_sanskrit": "न दृष्टिगोचरे तौ तु ददृशातेऽपकारिणम् ।\nतथैव दंशितौ यातौ यत्र कृष्णो महाबलः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006430008, "chapter_id": 26430, "verse_number": "२-९०-९", "content_sanskrit": "श्रुतार्थः स्वं विमानं तदारुरोह जनार्दनः ।\nपार्थेन सहितस्तार्क्ष्यं नागशत्रुमरिंदमः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006430009, "chapter_id": 26430, "verse_number": "२-९०-१०", "content_sanskrit": "रथी त्वमनुगच्छेति संदिश्य मकरध्वजम् ।\nत्वरेति गरुडं वीरः संदिदेश च काश्यपम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006430010, "chapter_id": 26430, "verse_number": "२-९०-११", "content_sanskrit": "वज्रं नगरमायान्तं निकुम्भं रणदुर्जयम् ।\nपार्थकृष्णौ महात्मानावासेदतुररिंदमौ ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006430011, "chapter_id": 26430, "verse_number": "२-९०-१२", "content_sanskrit": "प्रद्युम्नश्च महातेजा मायिनां प्रवरो नृप ।\nनिकुम्भश्चाथ तान् दृष्ट्वा त्रिधाऽऽत्मानमथाकरोत्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006430012, "chapter_id": 26430, "verse_number": "२-९०-१३", "content_sanskrit": "तान् सर्वान् योधयामास निकुम्भः प्रहसन्निव ।\nबहुकण्टकगुर्वीभिर्गदाभिरमरोपमः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006430013, "chapter_id": 26430, "verse_number": "२-९०-१४", "content_sanskrit": "सव्येनालम्ब्य हस्तेन कन्यां भानुमतीं नृप ।\nदक्षिणेनाथ हस्तेन गदया प्राहरत् पुनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006430014, "chapter_id": 26430, "verse_number": "२-९०-१५", "content_sanskrit": "कन्यार्थं न च कृष्णौ वा कामो वा नृपसत्तम ।\nनिर्दयं प्रहरन्ति स्म निकुम्भे च महासुरे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006430015, "chapter_id": 26430, "verse_number": "२-९०-१६", "content_sanskrit": "समर्थास्ते महात्मानः शत्रुं हन्तुं दुरासदाः ।\nनिशश्वसुर्नरपते दयाभारावपीडिताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006430016, "chapter_id": 26430, "verse_number": "२-९०-१७", "content_sanskrit": "श्रेष्ठो धनुष्मतां पार्थः सर्वथा कुशलो युधि ।\nनागोष्ट्रविधिना दैत्यं शरपङ्क्त्या जघान ह ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006430017, "chapter_id": 26430, "verse_number": "२-९०-१८", "content_sanskrit": "ते तु वैतस्तिकैर्बाणैर्विविधान् दानवान् युधि ।\nन कन्यां कलया युक्त्या शिक्षया च महीपते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006430018, "chapter_id": 26430, "verse_number": "२-९०-१९", "content_sanskrit": "ततः स कन्यया सार्द्ध तत्रैवान्तरधीयत ।\nआसुरीमाश्रितो मायां न च तां वेत्ति कश्चन ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006430019, "chapter_id": 26430, "verse_number": "२-९०-२०", "content_sanskrit": "तं कृष्णौ रौक्मिणेयश्च पृष्ठतोऽनुययुस्तदा ।\nहारितः शकुनो भूत्वा तस्थावथ महासुरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006430020, "chapter_id": 26430, "verse_number": "२-९०-२१", "content_sanskrit": "तं बाणैः पुनरेवाथ वीरो भूयो धनंजयः ।\nवैतस्तिकैर्मर्मभिद्भिः कन्यां रक्षन्नताडयत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006430021, "chapter_id": 26430, "verse_number": "२-९०-२२", "content_sanskrit": "स इमां पृथिवीं कृत्स्नां सप्तद्वीपां महासुरः ।\nबभ्रामानुगतश्चैव तैर्वीरैररिमर्दनः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006430022, "chapter_id": 26430, "verse_number": "२-९०-२३", "content_sanskrit": "गोकर्णस्योपरिष्टात्तु पर्वतस्य महासुरः ।\nपपात वेलां गङ्गायाः पुलिने सह कन्यया ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006430023, "chapter_id": 26430, "verse_number": "२-९०-२४", "content_sanskrit": "न देवा नासुराश्चापि लङ्घयन्ति तपोधनाः ।\nगोकर्णं तेजसा गुप्तं महादेवस्य भारत ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006430024, "chapter_id": 26430, "verse_number": "२-९०-२५", "content_sanskrit": "एतदन्तरमासाद्य प्रद्युम्नः शीघ्रविक्रमः ।\nकन्यां भानुमतीं भैमो जग्राह रणदुर्जयः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006430025, "chapter_id": 26430, "verse_number": "२-९०-२६", "content_sanskrit": "असुरः सोऽर्दितो राजन् कृष्णाभ्यां निशितैः शरैः ।\nत्यक्त्वाथोत्तरगोकर्णं निकुम्भो दक्षिणां दिशम् ।\nजगाम पृष्ठतो यातौ कृष्णौ तार्क्ष्यगतौ तदा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006430026, "chapter_id": 26430, "verse_number": "२-९०-२७", "content_sanskrit": "विवेश षट्पुरं चैव ज्ञातीनामालयं तदा ।\nतत्र वीरौ गुहाद्वारि कृष्णौ रात्रै तदोषतुः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006430027, "chapter_id": 26430, "verse_number": "२-९०-२८", "content_sanskrit": "रौक्मिणेयोऽपि कृष्णेन संदिष्टो द्वारकां पुरीम्।\nअनयद् भानुतनया प्रहृष्टेनान्तरात्मना ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006430028, "chapter_id": 26430, "verse_number": "२-९०-२९", "content_sanskrit": "नयित्वा चाययौ वीरः षट्पुरं दानवाकुलम् ।\nददर्श च गुहाद्वारि कृष्णौ भीमपराक्रमौ ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006430029, "chapter_id": 26430, "verse_number": "२-९०-३०", "content_sanskrit": "ऊषतुर्द्वारमाक्रम्य षटपुरस्य महाबलौ ।\nकृष्णौ प्रद्युम्नसहितौ निकुम्भवधकाङ्क्षक्षिणौ ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006430030, "chapter_id": 26430, "verse_number": "२-९०-३१", "content_sanskrit": "ततोऽनन्तरमेतस्माद् बिलादतिबलस्तदा ।\nनिर्जगाम बली योद्धुं निकुम्भो भीमविक्रमः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006430031, "chapter_id": 26430, "verse_number": "२-९०-३२", "content_sanskrit": "तस्य निर्गच्छतस्तस्माद् बिलात्पार्थो विशाम्पते ।\nरुरोध सर्वतो मार्गं शरैर्गाण्डीवनिःसृतैः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006430032, "chapter_id": 26430, "verse_number": "२-९०-३३", "content_sanskrit": "सोऽभिसृत्य गदां घोरामुद्यम्य बहुकण्टकाम् ।\nशिरस्यताडयत् पार्थं निकुम्भो बलिनां वरः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006430033, "chapter_id": 26430, "verse_number": "२-९०-३४", "content_sanskrit": "अदृष्टेनाहतो वीरः शिरस्यथ मुमोह सः ।\nगदयाभिहते पार्थे रक्तं वमति मुह्यति ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006430034, "chapter_id": 26430, "verse_number": "२-९०-३५", "content_sanskrit": "हसित्वा सोऽसुरो दृप्तो रौक्मिणेयमताडयत् ।\nतं प्राङ्मुखमुखं वीरं मायावी मायिनां वरम् ।\nअदृष्टेनाहतो वीरः शिरस्यथ मुमोह सः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006430035, "chapter_id": 26430, "verse_number": "२-९०-३६", "content_sanskrit": "तयागतौ तु दृष्ट्वा तौ मुह्यमानौ सुताडितौ ।\nअभिदुद्राव गोविन्दो निकुम्भं क्रोधमूर्छितः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006430036, "chapter_id": 26430, "verse_number": "२-९०-३७", "content_sanskrit": "कौमोदकीं समुद्यम्य गदपूर्वोद्भवो गदाम् ।\nतावन्योन्यं दुराधर्षौ गर्जन्तावभिपेततुः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006430037, "chapter_id": 26430, "verse_number": "२-९०-३८", "content_sanskrit": "ऐरावतगतः शक्रः सर्वैर्देवगणैः सह ।\nददर्श तन्महायुद्धं घोरं देवासुरं तदा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006430038, "chapter_id": 26430, "verse_number": "२-९०-३९", "content_sanskrit": "दृष्ट्वा देवान् हृषीकेशश्चित्रैर्युद्धैररिंदमः ।\nइयेष दानवं हन्तुं देवानां हितकाम्यया ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006430039, "chapter_id": 26430, "verse_number": "२-९०-४०", "content_sanskrit": "स मण्डलानि चित्राणि दर्शयामास केशवः ।\nकौमोदकीं महाबाहुर्लालयन् युद्धकोविदः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006430040, "chapter_id": 26430, "verse_number": "२-९०-४१", "content_sanskrit": "तथैवासुरमुख्योऽपि गदां तां बहुकण्टकाम् ।\nशिक्षया भ्रामयाणोऽथ मण्डलानि चचार ह ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006430041, "chapter_id": 26430, "verse_number": "२-९०-४२", "content_sanskrit": "वृषभाविव गर्जन्तौ बृहन्ताविव कुञ्जरौ ।\nइषितान्तरमासाद्य क्रुद्धौ शालावृकाविव ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006430042, "chapter_id": 26430, "verse_number": "२-९०-४३", "content_sanskrit": "आजघान निकुम्भस्तु गदया गदपूर्वजम् ।\nस्पष्टाष्टघंटया वीर नादं मुक्त्वातिदारुणम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006430043, "chapter_id": 26430, "verse_number": "२-९०-४४", "content_sanskrit": "तत्कालमेव कृष्णोऽपि भ्रामयित्वा महागदाम् ।\nनिकुम्भमूर्द्धनि तदा पातयामास भारत ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006430044, "chapter_id": 26430, "verse_number": "२-९०-४५", "content_sanskrit": "अवष्टभ्य मुहूर्तं तु हरिः कौमोदकीं गदाम् ।\nतस्थौ जगद्गुरुर्धीमान् मुमोह पतितः क्षितौ ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006430045, "chapter_id": 26430, "verse_number": "२-९०-४६", "content_sanskrit": "हाहाभूतं जगत् सर्वं तत्कालमभवत् तदा ।\nतथागते वासुदेवे नरदेव महात्मनि ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006430046, "chapter_id": 26430, "verse_number": "२-९०-४७", "content_sanskrit": "आकाशगङ्गातोयेन शीतेन च सुगन्धिना ।\nसिषेचामृतमिश्रेण कृष्णं देवेश्वरः स्वयम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006430047, "chapter_id": 26430, "verse_number": "२-९०-४८", "content_sanskrit": "नूनमात्मेच्छया कृष्णस्तथा चक्रे सुरोत्तमः ।\nको हि शक्तो महात्मानं युद्धे मोहयितुं हरिम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006430048, "chapter_id": 26430, "verse_number": "२-९०-४९", "content_sanskrit": "कृष्णः प्रत्यागतप्राणश्चक्रमुद्यम्य भारत ।\nप्रतीच्छेति दुरात्मानमुवाच रिपुनाशनः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006430049, "chapter_id": 26430, "verse_number": "२-९०-५०", "content_sanskrit": "निकुम्भोऽप्यतिमायावी उत्पपात दुरासदः ।\nशरीरं तत् परित्यज्य न तु तं वेत्ति केशवः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006430050, "chapter_id": 26430, "verse_number": "२-९०-५१", "content_sanskrit": "मुमूर्षति मृतो वायमिति मत्वा जनार्दनः ।\nररक्ष स्मरमाणोऽथ वीरो वीरव्रतं विभो ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006430051, "chapter_id": 26430, "verse_number": "२-९०-५२", "content_sanskrit": "अथ प्रद्युम्नकौन्तेयावागतौ लब्धचेतनौ ।\nस्थितौ नारायणाभ्याशे निकुम्भवधनिश्चितौ ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006430052, "chapter_id": 26430, "verse_number": "२-९०-५३", "content_sanskrit": "प्रद्युम्नोऽप्यथ मायावी विदितः कृष्णमब्रवीत् ।\nनिकुम्भस्तात नास्त्यत्र गतः क्वापि सुदुर्मतिः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006430053, "chapter_id": 26430, "verse_number": "२-९०-५४", "content_sanskrit": "प्रद्युम्नेनैवमुक्ते तु तन्ननाश कलेवरम् ।\nप्रजहासाथ भगवानर्जुनेन सह प्रभुः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006430054, "chapter_id": 26430, "verse_number": "२-९०-५५", "content_sanskrit": "तदायुतसहस्राणि निकुम्भानां जनाधिप ।\nददृशुस्ते ततो वीराः क्षितौ दिवि च सर्वतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006430055, "chapter_id": 26430, "verse_number": "२-९०-५६", "content_sanskrit": "सहस्राण्येव कृष्णं तु तथा पार्थमरिंदम ।\nरौक्मिणेयं तथा वीरं तदद्भुतमिवाभवत् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006430056, "chapter_id": 26430, "verse_number": "२-९०-५७", "content_sanskrit": "पाण्डवस्य धनुः केचित्केचिदस्य महाशरान् ।\nअन्येऽस्य जगृहुर्हस्तावन्ये पादौ महासुराः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006430057, "chapter_id": 26430, "verse_number": "२-९०-५८", "content_sanskrit": "एवं ग्रहाय तं वीरमगमंस्ते विहायसि ।\nपार्थानामपि कोट्यस्तु गृहीतानां तदाभवन् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006430058, "chapter_id": 26430, "verse_number": "२-९०-५९", "content_sanskrit": "नान्तं ददर्श कृष्णश्च कार्ष्णिश्च रिपुनाशनौ ।\nविच्छिद्य तौ शरैर्वीरौ निकुम्भं पार्थवर्जितौ ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006430059, "chapter_id": 26430, "verse_number": "२-९०-६०", "content_sanskrit": "एकैकस्तु द्विधा च्छिन्नो द्वेधा भवति भारत ।\nदिव्यज्ञानस्तदा कृष्णो भगवाननुदृष्टवान् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006430060, "chapter_id": 26430, "verse_number": "२-९०-६१", "content_sanskrit": "निकुम्भं तत्त्वतश्चापि ददर्श मधुसूदनः ।\nस्रष्टारं सर्वमायानां हर्तारं फाल्गुनस्य च ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006430061, "chapter_id": 26430, "verse_number": "२-९०-६२", "content_sanskrit": "स चक्रेण शिरस्तस्य चकर्तासुरसूदनः ।\nपश्यतां सर्वभूतानां भूतभव्यभवो हरिः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006430062, "chapter_id": 26430, "verse_number": "२-९०-६३", "content_sanskrit": "स मुक्त्वा फाल्गुनं राजञ्छिन्ने शिरसि भारत ।\nपपातासुरमुख्योऽथ च्छिन्नमूल इव द्रुमः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006430063, "chapter_id": 26430, "verse_number": "२-९०-६४", "content_sanskrit": "अथाकाशगतं पार्थं पतमानं विहायसः ।\nकृष्णवाक्येन जग्राह कार्ष्णिर्वियति मानद ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006430064, "chapter_id": 26430, "verse_number": "२-९०-६५", "content_sanskrit": "निकुम्भे पतिते भूमौ समाश्वास्य धनंजयम् ।\nजगाम द्वारकां देवः पार्थकामसमन्वितः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006430065, "chapter_id": 26430, "verse_number": "२-९०-६६", "content_sanskrit": "समियाय दशार्होऽथ द्वारकां मुदितो विभुः ।\nनारदं च महात्मानं ववन्दे यदुनन्दनः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006430066, "chapter_id": 26430, "verse_number": "२-९०-६७", "content_sanskrit": "नारदोऽथ महातेजा भानुं यादवमब्रवीत् ।\nभानो मा कार्षीर्मन्युं त्वं श्रूयतां भैमनन्दन ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006430067, "chapter_id": 26430, "verse_number": "२-९०-६८", "content_sanskrit": "क्रीडन्त्या रैवतोद्याने दुर्वासाः कोपितोऽनया ।\nस शशाप ततो रोषान्मुनिर्दुहितरं तव ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006430068, "chapter_id": 26430, "verse_number": "२-९०-६९", "content_sanskrit": "अतिदुर्ललितैः कन्या शत्रुहस्तं गमिष्यति ।\nसुतार्थे ते मया सार्द्धं मुनिभिः स प्रसादितः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006430069, "chapter_id": 26430, "verse_number": "२-९०-७०", "content_sanskrit": "बालां व्रतवतीं कन्यामनागसमिमां मुने ।\nशप्तवानसि धर्मज्ञ कथं धर्मभृतां वर ।\nअनुग्रहं विधत्स्वात्र वयं विज्ञापयामहे ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006430070, "chapter_id": 26430, "verse_number": "२-९०-७१", "content_sanskrit": "अस्माभिरेवमुक्तस्तु दुर्वासा भैमनन्दन ।\nउवाचाधोमुखो भूत्वा मुहूर्तं कृपयान्वितः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006430071, "chapter_id": 26430, "verse_number": "२-९०-७२", "content_sanskrit": "यदवोचमहं वाक्यं तत् तथा न तदन्यथा ।\nरिपुहस्तमवश्यं हि गमिष्यति न संशयः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006430072, "chapter_id": 26430, "verse_number": "२-९०-७३", "content_sanskrit": "अदूषिता नु धर्मेण भर्तारमुपलप्स्यति ।\nबहुपुत्रा बहुधना सुभगा च भविष्यति ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006430073, "chapter_id": 26430, "verse_number": "२-९०-७४", "content_sanskrit": "सुगन्धगन्धा च सदा कुमारी च पुनः पुनः ।\nन च शोकमिमं घोरं तन्वङ्गी धारयिष्यति ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006430074, "chapter_id": 26430, "verse_number": "२-९०-७५", "content_sanskrit": "एवं भानुमती वीर सहदेवाय दीयताम् ।\nश्रद्दधानः स शूरश्च धर्मशीलश्च पाण्डवः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006430075, "chapter_id": 26430, "verse_number": "२-९०-७६", "content_sanskrit": "ततो भानुमतीं भानुर्ददौ माद्रीसुताय वै ।\nसहदेवाय धर्मात्मा नारदस्य वचः स्मरन् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006430076, "chapter_id": 26430, "verse_number": "२-९०-७७", "content_sanskrit": "आनीतः सहदेवश्च प्रेषितश्चक्रपाणिना ।\nविवाहे च तदा वृत्ते सभार्यः स पुरीं गतः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006430077, "chapter_id": 26430, "verse_number": "२-९०-७८", "content_sanskrit": "इमं कृष्णस्य विजयं यः पठेच्छृणुयादथ ।\nविजयं सर्वकृत्येषु श्रद्दधानो लभेन्नरः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]