[{"id": 7000257000, "chapter_id": 20257, "verse_number": "१-११-१", "content_sanskrit": "भीष्म उवाच ।\nकस्मिन्वासरभागे तु श्राद्धी श्राद्धं समाचरेत् ।\nतीर्थेषु केषु वै श्राद्धं कृतं बहुफलं द्विज ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000257001, "chapter_id": 20257, "verse_number": "१-११-२", "content_sanskrit": "पुलस्त्य उवाच ।\nतीर्थं तु पुष्करं नाम यत्तु श्रेष्ठतमं स्मृतम् ।\nसर्वेषां द्विजमुख्यानां मनोरथमिव स्थितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000257002, "chapter_id": 20257, "verse_number": "१-११-३", "content_sanskrit": "तत्र दत्तं हुतं जप्तमनन्तं भवति ध्रुवम् ।\nपितॄणां वल्लभं नित्यमृषीणां परमं मतम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000257003, "chapter_id": 20257, "verse_number": "१-११-४", "content_sanskrit": "नंदाथ ललिता तद्वत्तीर्थं मायापुरी शुभा ।\nतथा मित्रपदं राजंस्ततः केदारमुत्तमम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000257004, "chapter_id": 20257, "verse_number": "१-११-५", "content_sanskrit": "गंगासागरमित्याहुः सर्वतीर्थमयं शुभम् ।\nतीर्थं ब्रह्मसरस्तद्वच्छतद्रुसलिलं शुभम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000257005, "chapter_id": 20257, "verse_number": "१-११-६", "content_sanskrit": "तीर्थं तु नैमिषं नाम सर्वतीर्थफलप्रदम् ।\nगंगोद्भेदस्तु गोमत्यां यत्रोद्भूतः सनातनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000257006, "chapter_id": 20257, "verse_number": "१-११-७", "content_sanskrit": "तथा यज्ञवराहस्तु देवदेवश्च शूलधृक् ।\nयत्र तत्कांचनं दानमष्टादशभुजो हरः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000257007, "chapter_id": 20257, "verse_number": "१-११-८", "content_sanskrit": "नेमिस्तु धर्मचक्रस्य शीर्णा यत्राभवत्पुरा ।\nतदेतन्नैमिशारण्यं सर्वतीर्थनिषेवितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000257008, "chapter_id": 20257, "verse_number": "१-११-९", "content_sanskrit": "देवदेवस्य तत्रापि वराहस्य च दर्शनम् ।\nयः प्रयाति स पूतात्मा नारायणपुरं व्रजेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000257009, "chapter_id": 20257, "verse_number": "१-११-१०", "content_sanskrit": "कोकामुखं परं तीर्थमिन्द्रमार्गोपि लक्ष्यते ।\nअथापि पितृतीर्थं तु ब्रह्मणोव्यक्तजन्मनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000257010, "chapter_id": 20257, "verse_number": "१-११-११", "content_sanskrit": "पुष्करारण्यसंस्थोसौ यत्र देवः पितामहः ।\nविरिंचिदर्शनं श्रेष्ठमपवर्गफलप्रदम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000257011, "chapter_id": 20257, "verse_number": "१-११-१२", "content_sanskrit": "कृतं नाम महापुण्यं सर्वपापनिषूदनम् ।\nयत्राद्यो नारसिंहस्तु स्वयमेव जनार्दनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000257012, "chapter_id": 20257, "verse_number": "१-११-१३", "content_sanskrit": "तीर्थमिक्षुमतीनाम पितॄणां च शुभावहा ।\nतुष्यन्ति पितरो नित्यं गंगायमुनसंगमे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000257013, "chapter_id": 20257, "verse_number": "१-११-१४", "content_sanskrit": "कुरुक्षेत्रं महापुण्यं यत्र मार्गोपि लक्ष्यते ।\nअद्यापि पितृतीर्थं तु सर्वकामफलप्रदम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000257014, "chapter_id": 20257, "verse_number": "१-११-१५", "content_sanskrit": "नीलकण्ठमिति ख्यातं पितृतीर्थं नराधिप ।\nतथा भद्रसरः पुण्यं सरो मानसमेव च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000257015, "chapter_id": 20257, "verse_number": "१-११-१६", "content_sanskrit": "मंदाकिनी तथाऽच्छोदा विपाशा च सरस्वती ।\nसर्वमित्रपदं तद्वद्वैद्यनाथं महाफलम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000257016, "chapter_id": 20257, "verse_number": "१-११-१७", "content_sanskrit": "क्षिप्रा नदी तथा पुण्या तथा कालञ्जरं शुभम् ।\nतीर्थोद्भेदं हरोद्भेदं गर्भभेदं महालयम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000257017, "chapter_id": 20257, "verse_number": "१-११-१८", "content_sanskrit": "भद्रेश्वरं विष्णुपदं नर्मदा द्वारमेव च ।\nगयापिंडप्रदानेन समान्याहुर्महर्षयः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000257018, "chapter_id": 20257, "verse_number": "१-११-१९", "content_sanskrit": "एतानि पितृतीर्थानि सर्वपापहराणि च ।\nस्मरणादपि लोकानां किमु श्राद्धप्रदायिनाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000257019, "chapter_id": 20257, "verse_number": "१-११-२०", "content_sanskrit": "ओंकारं पितृतीर्थं तु कावेरीकपिलोदकम् ।\nसंभेदश्चण्डवेगायां तथैवामरकंटकम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000257020, "chapter_id": 20257, "verse_number": "१-११-२१", "content_sanskrit": "कुरुक्षेत्राच्चद्विगुणं तस्मिन्स्नानादिकं भवेत् ।\nशुक्लतीर्थं तु विख्यातं तीर्थं सोमेश्वरं परम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000257021, "chapter_id": 20257, "verse_number": "१-११-२२", "content_sanskrit": "सर्वव्याधिहरंपुण्यंफलंकोटिगुणाधिकम् ।\nश्राद्धेदानेतथाहोमेस्वाध्यायेचापिसन्निधौ ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000257022, "chapter_id": 20257, "verse_number": "१-११-२३", "content_sanskrit": "कायावारोहणं नाम देवदेवस्य शूलिनः ।\nअवतारं रोचमानं ब्राह्मणावसथे शुभे ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000257023, "chapter_id": 20257, "verse_number": "१-११-२४", "content_sanskrit": "जातं तत्सुमहापुण्यं तथा चर्मण्वती नदी ।\nशूलतापी पयोष्णी च पयोष्णीसंगमस्तथा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000257024, "chapter_id": 20257, "verse_number": "१-११-२५", "content_sanskrit": "महौषधी चारणा च नागतीर्थप्रवर्त्तिनी ।\nमहावेणा नदी पुण्या महाशालस्तथैव च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000257025, "chapter_id": 20257, "verse_number": "१-११-२६", "content_sanskrit": "गोमती वरुणा तद्वत्तीर्थं हौताशनं परम् ।\nभैरवं भृगुतुंगं च गौरीतीर्थमनुत्तमम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000257026, "chapter_id": 20257, "verse_number": "१-११-२७", "content_sanskrit": "तीर्थं वैनायकं नाम वस्त्रेश्वरमनुत्तमम् ।\nतथा पापहरं नाम पुण्या वेत्रवती नदी ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000257027, "chapter_id": 20257, "verse_number": "१-११-२८", "content_sanskrit": "महारुद्रं महालिंगं दशार्णा च महानदी ।\nशतरुद्रा शताह्वा च तथा पितृपदं पुरम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000257028, "chapter_id": 20257, "verse_number": "१-११-२९", "content_sanskrit": "अंगारवाहिका तद्वन्नदौ द्वौ शोणघर्घरौ ।\nकालिका च नदी पुण्या पितरा च नदी शुभा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000257029, "chapter_id": 20257, "verse_number": "१-११-३०", "content_sanskrit": "एतानि पितृतीर्थानि शस्यंते स्नानदानयोः ।\nश्राद्धमेतेषु यद्दत्तं तदनंतफलं स्मृतम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000257030, "chapter_id": 20257, "verse_number": "१-११-३१", "content_sanskrit": "शतावटा नदी ज्वाला शरद्वी च नदी तथा ।\nद्वारका कृष्णतीर्थं च तथा ह्युदक्सरस्वती ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000257031, "chapter_id": 20257, "verse_number": "१-११-३२", "content_sanskrit": "नदी मालवती नाम तथा च गिरिकर्णिका ।\nधूतपापं तथा तीर्थं समुद्रे दक्षिणे तथा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000257032, "chapter_id": 20257, "verse_number": "१-११-३३", "content_sanskrit": "गोकर्णो गजकर्णश्च तथा चक्रनदी शुभा ।\nश्रीशैलं शाकतीर्थं च नारसिंहमतः परम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000257033, "chapter_id": 20257, "verse_number": "१-११-३४", "content_sanskrit": "महेंद्रं च तथा पुण्या पुण्या चापि महानदी ।\nएतेष्वपि सदा श्राद्धमनंतफलदं स्मृतम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000257034, "chapter_id": 20257, "verse_number": "१-११-३५", "content_sanskrit": "दर्शनादपि पुण्यानि सद्यः पापहराणि वै ।\nतुंगभद्रा नदी पुण्या तथा चक्ररथीति च ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000257035, "chapter_id": 20257, "verse_number": "१-११-३६", "content_sanskrit": "भीमेश्वरं कृष्णवेणा कावेरी चांजना नदी ।\nनदी गोदावरी पुण्या त्रिसंध्या पूर्णमुत्तमम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000257036, "chapter_id": 20257, "verse_number": "१-११-३७", "content_sanskrit": "तीर्थं त्रैयंबकं नाम सर्वतीर्थनमस्कृतम् ।\nयत्रास्ते भगवान्भीमः स्वयमेव त्रिलोचनः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000257037, "chapter_id": 20257, "verse_number": "१-११-३८", "content_sanskrit": "श्राद्धमेतेषु सर्वेषु दत्तं कोटिगुणं भवेत् ।\nस्मरणादपि पापानि व्रजंति शतधा नृप ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000257038, "chapter_id": 20257, "verse_number": "१-११-३९", "content_sanskrit": "श्रीपर्णा च नदी पुण्या व्यासतीर्थमनुत्तमम् ।\nतथा मत्स्यनदी कारा शिवधारा तथैव च ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000257039, "chapter_id": 20257, "verse_number": "१-११-४०", "content_sanskrit": "भवतीर्थं च विख्यातं पुण्यतीर्थं च शाश्वतम् ।\nपुण्यं रामेश्वरं तद्वद्वेणापुरमलंपुरम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000257040, "chapter_id": 20257, "verse_number": "१-११-४१", "content_sanskrit": "अंगारकं च विख्यातमात्मदर्शमलंबुषम् ।\nवत्सव्रातेश्वरं तद्वत्तथागोकामुखं परम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000257041, "chapter_id": 20257, "verse_number": "१-११-४२", "content_sanskrit": "गोवर्द्धनं हरिश्चंद्रं पुरश्चन्द्रं पृथूदकम् ।\nसहस्राक्षं हिरण्याक्षं तथा च कदलीनदी ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000257042, "chapter_id": 20257, "verse_number": "१-११-४३", "content_sanskrit": "नामधेयानि च तथा तथा सौमित्रिसंगतम् ।\nइंद्रनीलं महानादं तथा च प्रियमेलकम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000257043, "chapter_id": 20257, "verse_number": "१-११-४४", "content_sanskrit": "एतान्यपि सदा श्राद्धे प्रशस्तान्यधिकानि च ।\nएतेषु सर्वदेवानां सांनिध्यं पठ्यते यतः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000257044, "chapter_id": 20257, "verse_number": "१-११-४५", "content_sanskrit": "दानमेतेषु सर्वेषु भवेत्कोटिशताधिकम् ।\nबाहुदा च नदी पुण्या तथा सिद्धवटं शुभम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000257045, "chapter_id": 20257, "verse_number": "१-११-४६", "content_sanskrit": "तीर्थं पाशुपतं चैव नदी पर्यटिका तथा ।\nश्राद्धमेतेषु सर्वेषु दत्तं कोटिशतोत्तरम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000257046, "chapter_id": 20257, "verse_number": "१-११-४७", "content_sanskrit": "तथैव पंचतीर्थं च यत्र गोदावरी नदी ।\nयुता लिंगसहस्रेण सव्येतर जलावहा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000257047, "chapter_id": 20257, "verse_number": "१-११-४८", "content_sanskrit": "जामदग्न्यस्य तत्तीर्थं मोदायतनमुत्तमम् ।\nप्रतीकस्य भयात्सिद्धा यत्र गोदावरी नदी ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000257048, "chapter_id": 20257, "verse_number": "१-११-४९", "content_sanskrit": "तीर्थं तद्धव्यकव्यानामप्सरोगणसंयुतम् ।\nश्राद्धाग्नि दानकार्यं च तत्र कोटिशताधिकम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000257049, "chapter_id": 20257, "verse_number": "१-११-५०", "content_sanskrit": "तथा सहस्रलिंगं च राघवेश्वरमुत्तमम् ।\nसेन्द्रकाला नदी पुण्या तत्र शक्रो गतः पुरा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000257050, "chapter_id": 20257, "verse_number": "१-११-५१", "content_sanskrit": "निहत्य नमुचिं मित्रं तपसा स्वर्गमाप्तवान् ।\nतत्र दत्तं नरैः श्राद्धमनंतफलदं भवेत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000257051, "chapter_id": 20257, "verse_number": "१-११-५२", "content_sanskrit": "पुष्करं नाम वै तीर्थं शालग्रामं तथैव च ।\nशोणपातश्च विख्यातो यत्र वैश्वानराशयः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000257052, "chapter_id": 20257, "verse_number": "१-११-५३", "content_sanskrit": "तीर्थं सारस्वतं चैव स्वामितीर्थं तथैव च ।\nमलंदरा नदी पुण्या कौशिकी चंद्रका तथा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000257053, "chapter_id": 20257, "verse_number": "१-११-५४", "content_sanskrit": "विदर्भा चाथ वेगा च पयोष्णी प्राङ्मुखा परा ।\nकावेरी चोत्तरांगा च तथा जालंधरो गिरिः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000257054, "chapter_id": 20257, "verse_number": "१-११-५५", "content_sanskrit": "एतेषु श्राद्धतीर्थेषु श्राद्धमानंत्यमश्नुते ।\nलोहदंडं तथा तीर्थं चित्रकूटस्तथैव च ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000257055, "chapter_id": 20257, "verse_number": "१-११-५६", "content_sanskrit": "दिव्यं सर्वत्र गंगायास्तथा नद्यास्तटं शुभम् ।\nकुब्जाम्रकं तथा तीर्थमुर्वशीपुलिनं तथा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000257056, "chapter_id": 20257, "verse_number": "१-११-५७", "content_sanskrit": "संसारमोचनं तीर्थं तथैव ऋणमोचनम् ।\nएतेषु पितृतीर्थेषु श्राद्धमानंत्यमश्नुते ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000257057, "chapter_id": 20257, "verse_number": "१-११-५८", "content_sanskrit": "अट्टहासं तथा तीर्थं गौतमेश्वरमेव च ।\nतथा वसिष्ठतीर्थं च भारतं च ततः परम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000257058, "chapter_id": 20257, "verse_number": "१-११-५९", "content_sanskrit": "ब्रह्मावर्तं कुशावर्तं हंसतीर्थं तथैव च ।\nपिंडारकं च विख्यातं शंखोद्धारं तथैव च ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000257059, "chapter_id": 20257, "verse_number": "१-११-६०", "content_sanskrit": "भांडेश्वरं बिल्वकं च नीलपर्वतमेव च ।\nतथा च बदरीतीर्थं सर्वतीर्थेश्वरेश्वरम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000257060, "chapter_id": 20257, "verse_number": "१-११-६१", "content_sanskrit": "वसुधाराह्वयं तीर्थं रामतीर्थं तथैव च ।\nजयंती विजया चैव शुक्लतीर्थं तथैव च ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000257061, "chapter_id": 20257, "verse_number": "१-११-६२", "content_sanskrit": "एषु श्राद्धप्रदातारः प्रयांति परमं पदम् ।\nतीर्थं मातृगृहं नाम करवीरपुरं तथा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000257062, "chapter_id": 20257, "verse_number": "१-११-६३", "content_sanskrit": "सप्तगोदावरीनाम सर्वतीर्थेश्वरेश्वरम् ।\nतत्र श्राद्धं प्रदातव्यमनंतफलमीप्सुभिः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000257063, "chapter_id": 20257, "verse_number": "१-११-६४", "content_sanskrit": "कीकटेषु गया पुण्या पुण्यं राजगृहं वनम् ।\nच्यवनस्याश्रमं पुण्यं नदी पुण्या पुनःपुना ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000257064, "chapter_id": 20257, "verse_number": "१-११-६५", "content_sanskrit": "विषयाराधनं पुण्यं नदी या तु पुनःपुना ।\nयत्र गाथा विचरति ब्रह्मणा परिकीर्तिता ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000257065, "chapter_id": 20257, "verse_number": "१-११-६६", "content_sanskrit": "एष्टव्या बहवः पुत्रा यद्येकोपि गयां व्रजेत् ।\nयजेत वाश्वमेधेन नीलं वा वृषमुत्सृजेत् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000257066, "chapter_id": 20257, "verse_number": "१-११-६७", "content_sanskrit": "एषा गाथा विचरति तीर्थेष्वायतनेषु च ।\nसर्वे मनुष्या राजेंद्र कीर्त्तयंतः समागताः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000257067, "chapter_id": 20257, "verse_number": "१-११-६८", "content_sanskrit": "किमस्माकं कुले कश्चिद्गयां यास्यति यः सुतः ।\nप्रीणयिष्यति तान्गत्वा सप्तपूर्वांस्तथापरान् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000257068, "chapter_id": 20257, "verse_number": "१-११-६९", "content_sanskrit": "मातामहानामप्येवं श्रुतिरेषा चिरंतनी ।\nगंगायामस्थिनिचयं गत्वा क्षेप्स्यति यः सुतः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000257069, "chapter_id": 20257, "verse_number": "१-११-७०", "content_sanskrit": "तिलैः सप्ताष्टभिर्वापि दास्यते च जलांजलिम् ।\nअरण्यत्रितये वापि पिंडदानं करिष्यति ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000257070, "chapter_id": 20257, "verse_number": "१-११-७१", "content_sanskrit": "प्रथमं पुष्करारण्ये नैमिषे तदनंतरं ।\nधर्मारण्यं पुनः प्राप्य श्राद्धं भक्त्या प्रदास्यति ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000257071, "chapter_id": 20257, "verse_number": "१-११-७२", "content_sanskrit": "गयायां धर्मपृष्ठे वा सरसि ब्रह्मणस्तथा ।\nगयाशीर्षवटे चैव पितॄणां दत्तमक्षयम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000257072, "chapter_id": 20257, "verse_number": "१-११-७३", "content_sanskrit": "व्रजन्कृत्वा निवापं यस्त्वध्वानं परिसर्पति ।\nनरकस्थान्पितॄन्सोपि स्वर्गं नयति सत्वरं ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000257073, "chapter_id": 20257, "verse_number": "१-११-७४", "content_sanskrit": "कुले तस्य न राजेंद्र प्रेतो भवति कश्चन ।\nप्रेतत्वं मोक्षभावं च पिंडदानाच्च गच्छति ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000257074, "chapter_id": 20257, "verse_number": "१-११-७५", "content_sanskrit": "एको मुनिस्ताम्रकराग्रहस्तो ह्याम्रेषु मूले सलिलं ददाति ।\nआम्राश्च सिक्ताः पितरश्च तृप्ता एका क्रिया द्व्यर्थकरी प्रसिद्धा ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000257075, "chapter_id": 20257, "verse_number": "१-११-७६", "content_sanskrit": "गयायां पिण्डदानस्य नान्यद्दानं विशिष्यते ।\nएकेन पिंडदानेन तृप्तास्ते मोक्षगामिनः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000257076, "chapter_id": 20257, "verse_number": "१-११-७७", "content_sanskrit": "धान्यप्रदानं प्रवरं वदंति वसुप्रदानं च तथामुनींद्राः ।\nगया सुतीर्थेषु नरैः प्रदत्तं तद्धर्महेतुं प्रवरं वदंति ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000257077, "chapter_id": 20257, "verse_number": "१-११-७८", "content_sanskrit": "सर्वात्मना सुरुचिना महाचल महानदी ।\nये तु पश्यंति तां गत्वा मानसे दक्षिणोत्तरे ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000257078, "chapter_id": 20257, "verse_number": "१-११-७९", "content_sanskrit": "प्रणम्य द्विजमुख्येभ्यः प्राप्तं तैर्जन्मनः फलं ।\nयद्यदिच्छति वै मर्त्यस्तत्तदाप्नोत्यसंशयम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000257079, "chapter_id": 20257, "verse_number": "१-११-८०", "content_sanskrit": "एष तूद्देशतः प्रोक्तस्तीर्थानां सग्रहो मया ।\nवागीशोपि न शक्नोति विस्तरात्किमु मानुषः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000257080, "chapter_id": 20257, "verse_number": "१-११-८१", "content_sanskrit": "सत्यं तीर्थं दया तीर्थं तीर्थमिन्द्रियनिग्रहः ।\nवर्णाश्रमाणां गेहेपि तीर्थं शम उदाहृतम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000257081, "chapter_id": 20257, "verse_number": "१-११-८२", "content_sanskrit": "येषु तीर्थेषु यच्छ्राद्धं तत्कोटिगुणमिष्यते ।\nगयायां यत्तु वै श्राद्धं तच्छ्राद्धमपवर्गदम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000257082, "chapter_id": 20257, "verse_number": "१-११-८३", "content_sanskrit": "यस्मात्तस्मात्प्रयत्नेन तीर्थे श्राद्धं विधीयते ।\nप्रातःकालो मुहूर्तांस्त्रीन्संगवस्तावदेव तु ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000257083, "chapter_id": 20257, "verse_number": "१-११-८४", "content_sanskrit": "मध्याह्नस्त्रिमुहूर्तः स्यादपराह्णस्ततः परम् ।\nसायाह्नस्त्रिमुहूर्तः स्याच्छ्राद्धं तत्र न कारयेत् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000257084, "chapter_id": 20257, "verse_number": "१-११-८५", "content_sanskrit": "राक्षसी नाम सा वेला गर्हिता सर्वकर्मसु ।\nअह्नो मुहूर्ता व्याख्याता दशपंच च सर्वदा ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000257085, "chapter_id": 20257, "verse_number": "१-११-८६", "content_sanskrit": "तत्राष्टमो मुहूर्तो यः स कालः कुतपः स्मृतः ।\nमध्याह्नात्सर्वदा यस्मान्मंदी भवति भास्करः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000257086, "chapter_id": 20257, "verse_number": "१-११-८७", "content_sanskrit": "तस्मादनंतफलदस्तत्रारंभो विशिष्यते ।\nखड्गपात्रं च कुतपस्तथा नैपालकंबलम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000257087, "chapter_id": 20257, "verse_number": "१-११-८८", "content_sanskrit": "रुक्मं दर्भास्तिला गावो दौहित्रश्चाष्टमः स्मृतः ।\nपापं कुत्सितमित्याहुस्तस्य तत्तापकारिणः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000257088, "chapter_id": 20257, "verse_number": "१-११-८९", "content_sanskrit": "अष्टावेते यतस्तस्मात्कुतपा इति विश्रुताः ।\nऊर्ध्वं मुहुर्त्तात्कुतपान्महूर्त्तं च चतुष्टयम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000257089, "chapter_id": 20257, "verse_number": "१-११-९०", "content_sanskrit": "मुहूर्त्तपंचकं चैव स्वधावाचनमिष्यते ।\nविष्णुदेहसमुद्भूताः कुशाः कृष्णतिलास्तथा ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000257090, "chapter_id": 20257, "verse_number": "१-११-९१", "content_sanskrit": "श्राद्धस्य लक्षणं कालमिति प्राहुर्मनीषिणः ।\nतिलोदकांजलिर्देयो जलांते तीर्थवासिभिः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000257091, "chapter_id": 20257, "verse_number": "१-११-९२", "content_sanskrit": "सदर्भहस्तेनैकेन गृहे श्राद्धं गमिष्यति ।\nपुण्यं पवित्रमायुष्यं सर्वपापविनाशनम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000257092, "chapter_id": 20257, "verse_number": "१-११-९३", "content_sanskrit": "ब्रह्मणा चैव कथितं तीर्थश्राद्धानुकीर्तनम् ।\nशृणोति यः पठेद्वापि श्रीमान्संजायते नरः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000257093, "chapter_id": 20257, "verse_number": "१-११-९४", "content_sanskrit": "श्राद्धकाले च वक्तव्यं तथा तीर्थनिवासिभिः ।\nसर्वपापोपशांन्त्यर्थमलक्ष्मीनाशनं मतं ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000257094, "chapter_id": 20257, "verse_number": "१-११-९५", "content_sanskrit": "इदं पवित्रं यशसो निधानमिदं महापातकनाशनं च ।\nब्रह्मार्करुद्रैरभिपूजितं च श्राद्धस्य माहात्म्यमुशंति तज्ज्ञाः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]