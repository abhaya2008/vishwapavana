[{"id": 2004020, "chapter_id": 1077, "verse_number": "१-७८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2004021, "chapter_id": 1077, "verse_number": "१-७८-१", "content_sanskrit": "जरां प्राप्य ययातिस्तु स्वपुरं प्राप्य चैव हि।\nपुत्रं ज्येष्ठं वरिष्ठं च यदुमित्यब्रवीद्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2004022, "chapter_id": 1077, "verse_number": "१-७८-२x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2004023, "chapter_id": 1077, "verse_number": "१-७८-२", "content_sanskrit": "जरावली च मां तात पलितानि च पर्यगुः।\nकाव्यस्योशनसः शापान्न च तृप्तोऽस्मि यौवने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2004024, "chapter_id": 1077, "verse_number": "१-७८-३", "content_sanskrit": "त्वं यदो प्रतिपद्यस्व पाप्मानं जरया सह।\nयौवनेन त्वदीयेन चरेयं विषयानहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2004025, "chapter_id": 1077, "verse_number": "१-७८-४", "content_sanskrit": "पूर्णे वर्षसहस्रे तु पुनस्ते यौवनं त्वहम्।\nदत्त्वा स्वं प्रतिपत्स्यामि पाप्मानं जरया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2004026, "chapter_id": 1077, "verse_number": "१-७८-५x", "content_sanskrit": "यदुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2004027, "chapter_id": 1077, "verse_number": "१-७८-५", "content_sanskrit": "जरायां बहवो दोषाः पानभोजनकारिताः।\nतस्माज्जरां न ते राजन्ग्रहीष्य इति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2004028, "chapter_id": 1077, "verse_number": "१-७८-६", "content_sanskrit": "सितश्मश्रुर्निरानन्दो जरया शिथिलीकृतः।\nवलीसङ्गतगात्रस्तु दुर्दर्शो दुर्बलः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2004029, "chapter_id": 1077, "verse_number": "१-७८-७", "content_sanskrit": "अशक्तः कार्यकरणे परिभूतः स यौवतैः।\nसहोपजीविभिश्चैव तां जरां नाभिकामये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2004030, "chapter_id": 1077, "verse_number": "१-७८-८", "content_sanskrit": "सन्ति ते बहवः पुत्रा मत्तः प्रियतरा नृप।\nजरां ग्रहीतुं धर्मज्ञ तस्मादन्यं वृणीष्व वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2004031, "chapter_id": 1077, "verse_number": "१-७८-९x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2004032, "chapter_id": 1077, "verse_number": "१-७८-९", "content_sanskrit": "यत्त्वं मे हृदयाज्जातो वयः स्वं न प्रयच्छसि।\nतस्मादराज्यभाक्तात प्रजा तव भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2004033, "chapter_id": 1077, "verse_number": "१-७८-१०", "content_sanskrit": "प्रत्याख्यातस्तु राजा स तुर्वसुं प्रत्युवाच ह।\nतुर्वसो प्रतिपद्यस्व पाप्मानं जरया सह।\nयौवनेन चरेयं वै विषयांस्तव पुत्रक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2004034, "chapter_id": 1077, "verse_number": "१-७८-११", "content_sanskrit": "पूर्णे वर्षसहस्रे तु पुनर्दास्यामि यौवनम्।\nस्वं चैव प्रतिपत्स्यामि पाप्मानं जरया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2004035, "chapter_id": 1077, "verse_number": "१-७८-१२x", "content_sanskrit": "तुर्वसुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2004036, "chapter_id": 1077, "verse_number": "१-७८-१२", "content_sanskrit": "न कामये जरां तात कामभोगप्रणाशिनीम्।\nबलरूपान्तकरणीं बुद्धिप्राणप्रणाशिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2004037, "chapter_id": 1077, "verse_number": "१-७८-१३x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2004038, "chapter_id": 1077, "verse_number": "१-७८-१३", "content_sanskrit": "यत्त्वं मे हृदयाज्जातो वयः स्वं न प्रयच्छसि।\nतस्मात्प्रजा समुच्छेदं तुर्वसो तव यास्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2004039, "chapter_id": 1077, "verse_number": "१-७८-१४", "content_sanskrit": "संकीर्णाचारधर्मेषु प्रतिलोमचरेषु च।\nपिशिताशिषु चान्त्येषु मूढ राजा भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2004040, "chapter_id": 1077, "verse_number": "१-७८-१५", "content_sanskrit": "गुरुदारप्रसक्तेषु तिर्यग्योनिगतेषु च।\nपशुधर्मेषु पापेषु म्लेच्छेषु त्वं भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2004041, "chapter_id": 1077, "verse_number": "१-७८-१६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2004042, "chapter_id": 1077, "verse_number": "१-७८-१६", "content_sanskrit": "एवं स तुर्वसुं शप्त्वा ययातिः सुतमात्मनः।\nशर्मिष्ठायाः सुतं द्रुह्युमिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2004043, "chapter_id": 1077, "verse_number": "१-७८-१७x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2004044, "chapter_id": 1077, "verse_number": "१-७८-१७", "content_sanskrit": "द्रुह्यो त्वं प्रतिपद्यस्व वर्णरूपविनाशिनीम्।\nजरां वर्षसहस्रं मे यौवनं स्वं ददस्व च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2004045, "chapter_id": 1077, "verse_number": "१-७८-१८", "content_sanskrit": "पूर्णे वर्षसहस्रे तु पुनर्दास्यामि यौवनम्।\nस्वं चादास्यामि भूयोऽहं पाप्मानं जरया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2004046, "chapter_id": 1077, "verse_number": "१-७८-१९x", "content_sanskrit": "द्रुह्युरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2004047, "chapter_id": 1077, "verse_number": "१-७८-१९", "content_sanskrit": "न गजं न रथं नाश्वं जीर्णो भुङ्क्ते न च स्त्रियम्।\nवाग्भङ्गश्चास्य भवति तां जरां नाभिकामये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2004048, "chapter_id": 1077, "verse_number": "१-७८-२०x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2004049, "chapter_id": 1077, "verse_number": "१-७८-२०", "content_sanskrit": "यत्त्वं मे हृदयाज्जातो वयः स्वं न प्रयच्छसि।\nतस्माद्द्रुह्यो प्रियः कामो न ते संपत्स्यते क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2004050, "chapter_id": 1077, "verse_number": "१-७८-२१", "content_sanskrit": "यत्राश्वरथमुख्यानामश्वानां स्याद्गतं न च।\nहस्तिनां पीठकानां च गर्दभानां तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2004051, "chapter_id": 1077, "verse_number": "१-७८-२२", "content_sanskrit": "बस्तानां च गवां चैव शिबिकायास्तथैव च।\nउडुपप्लवसंतारो यत्र नित्यं भविष्यति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2004052, "chapter_id": 1077, "verse_number": "१-७८-२३x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2004053, "chapter_id": 1077, "verse_number": "१-७८-२३", "content_sanskrit": "अनो त्वं प्रतिपद्यस्व पाप्मानं जरया सह।\nएकं वर्षसहस्रं तु चरेयं यौवनेन ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2004054, "chapter_id": 1077, "verse_number": "१-७८-२४x", "content_sanskrit": "अनुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2004055, "chapter_id": 1077, "verse_number": "१-७८-२४", "content_sanskrit": "जीर्णः शिशुवदादत्ते कालेऽन्नमशुचिर्यथा।\nन जुहोति च कालेऽग्निं तां जरां नाभिकामये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2004056, "chapter_id": 1077, "verse_number": "१-७८-२५x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2004057, "chapter_id": 1077, "verse_number": "१-७८-२५", "content_sanskrit": "यत्त्वं मे हृदयाज्जातो वयः स्वं न प्रयच्छसि।\nजरादोषस्त्वया प्रोक्तस्तस्मात्त्वं प्रतिलप्स्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2004058, "chapter_id": 1077, "verse_number": "१-७८-२६", "content_sanskrit": "प्रजाश्च यौवनप्राप्ता विनशिष्यन्त्यनो तव।\nअग्निप्रस्कन्दनपरस्त्वं चाप्येवं भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2004059, "chapter_id": 1077, "verse_number": "१-७८-२७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2004060, "chapter_id": 1077, "verse_number": "१-७८-२७", "content_sanskrit": "प्रत्याख्यातश्चतुर्भिश्च शप्त्वा तान्यदुपूर्वकान्।\nपूरोः सकाशमगमन्मत्त्वा पूरुमलङ्घनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2004061, "chapter_id": 1077, "verse_number": "१-७८-२८x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2004062, "chapter_id": 1077, "verse_number": "१-७८-२८", "content_sanskrit": "पूरो त्वं मे प्रियः पुत्रस्त्वं वरीयान्भविष्यसि।\nजरा वली च मांतात पलितानि च पर्यगुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2004063, "chapter_id": 1077, "verse_number": "१-७८-२९", "content_sanskrit": "काव्यस्योशनसः शापान्न च तृप्तोऽस्मि यौवने।\nपूरो त्वं प्रतिपद्यस्व पाप्मानं जरया सह।\nकंचित्कालं चरेयं वै विषयान्वयसातव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2004064, "chapter_id": 1077, "verse_number": "१-७८-३०", "content_sanskrit": "पूर्णे वर्षसहस्रे तु पुनर्दास्यामि यौवनम्।\nस्वं चैव प्रतिपत्स्यामि पाप्मानं जरया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2004065, "chapter_id": 1077, "verse_number": "१-७८-३१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2004066, "chapter_id": 1077, "verse_number": "१-७८-३१", "content_sanskrit": "एवमुक्तः प्रत्युवाच पूरुः पितरमज्जसा।\nयदात्थ मां महाराज तत्करिष्यामि ते वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2004067, "chapter_id": 1077, "verse_number": "१-७८-३२", "content_sanskrit": "गुरोर्वै वचनं पुण्यं स्वर्ग्यमायुष्करं नृणाम्।\nगुरुप्रसादात्त्रैलोक्यमन्वशासच्छतक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2004068, "chapter_id": 1077, "verse_number": "१-७८-३३", "content_sanskrit": "गुरोरनुमतं प्राप्य सर्वान्कामानमाप्नुयात्।\nयावदिच्छसि तावच्च धारयिष्यामि ते जराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2004069, "chapter_id": 1077, "verse_number": "१-७८-३४", "content_sanskrit": "प्रतिपत्स्यामि ते राजन्पाप्मानं जरया सह।\nगृहाण यौवनं मत्तश्चर कामान्यथेप्सितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2004070, "chapter_id": 1077, "verse_number": "१-७८-३५", "content_sanskrit": "जरयाहं प्रतिच्छन्नो वयोरूपधरस्तव।\nयौवनं भवते दत्त्वा चरिष्यामि यथात्थमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2004071, "chapter_id": 1077, "verse_number": "१-७८-३६x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2004072, "chapter_id": 1077, "verse_number": "१-७८-३६", "content_sanskrit": "पूरो प्रीतोऽस्मि ते वत्स प्रीतश्चेदं ददामि ते।\nसर्वकामसमृद्धा ते प्रजा राज्ये भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2004073, "chapter_id": 1077, "verse_number": "१-७८-३७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2004074, "chapter_id": 1077, "verse_number": "१-७८-३७", "content_sanskrit": "एवमुक्त्वा ययातिस्तु स्मृत्वा काव्यं महातपाः।\nसंक्रामयामास जरां तदा पूरौ महात्मनि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2004075, "chapter_id": 1077, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि अष्टसप्ततितमोऽध्यायः॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]