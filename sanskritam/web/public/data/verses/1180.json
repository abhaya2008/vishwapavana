[{"id": 2009191, "chapter_id": 1180, "verse_number": "१-१८१-०x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2009192, "chapter_id": 1180, "verse_number": "१-१८१-१", "content_sanskrit": "अमर्षी द्रुपदो राजा कर्मसिद्धान्द्विजर्षभान्।\nअन्विच्छन्परिचक्राम ब्राह्मणावसथान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2009193, "chapter_id": 1180, "verse_number": "१-१८१-२", "content_sanskrit": "पुत्रजन्म परीप्सन्वै शोकोपहतचेतनः।\nद्रोणेन वैरं द्रुपदो न सुष्वाप स्मरन्सदा।\nनास्ति श्रेष्ठमपत्यं म इति नित्यमचिन्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2009194, "chapter_id": 1180, "verse_number": "१-१८१-३", "content_sanskrit": "जातान्पुत्रान्स निर्वेदाद्धिग्बन्धूनिति चाब्रवीत्।\nनिःश्वासपरमश्चासीद्द्रोणं प्रतिचिकीर्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2009195, "chapter_id": 1180, "verse_number": "१-१८१-४", "content_sanskrit": "प्रभावं विनयं शिक्षां द्रोणस्य चरितानि च।\nक्षात्रेण च बलेनास्य चिन्तयन्नाध्यगच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2009196, "chapter_id": 1180, "verse_number": "१-१८१-५", "content_sanskrit": "प्रतिकर्तुं नृपश्रेष्ठो यतमानोऽपि भारत।\nअभितः सोऽथ कल्माषीं गङ्गाकूले परिभ्रमन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2009197, "chapter_id": 1180, "verse_number": "१-१८१-६", "content_sanskrit": "ब्राह्मणावसथं पुम्यमाससाद महीपतिः।\nतत्र नास्नातकः कश्चिन्न चासीदव्रती द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2009198, "chapter_id": 1180, "verse_number": "१-१८१-७", "content_sanskrit": "अधीयानौ महाभागौ सोऽपश्यत्संशितव्रतौ।\nयाजोपयाजौ ब्रह्मर्षी शाम्यन्तौ परमेष्ठिनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2009199, "chapter_id": 1180, "verse_number": "१-१८१-८", "content_sanskrit": "संहिताध्ययने युक्तौ गोत्रतश्चापि काश्यपौ।\nतारणेयौ युक्तरूपौ ब्राह्मणावृषिसत्तमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2009200, "chapter_id": 1180, "verse_number": "१-१८१-९", "content_sanskrit": "स तावामन्त्रयामास सर्वकामैरतन्द्रितः।\nबुद्ध्वा बलं तयोस्तत्र कनीयांसमुपह्वरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2009201, "chapter_id": 1180, "verse_number": "१-१८१-१०", "content_sanskrit": "प्रपेदे च्छन्दयन्कामैरुपयाजं धृतव्रतम्।\nपादशुश्रूषणे युक्तः प्रियवाक्सर्वकामदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2009202, "chapter_id": 1180, "verse_number": "१-१८१-११", "content_sanskrit": "अर्चयित्वा यथान्यायमुपयाजमुवाच सः।\nयेन मे कर्मणा ब्रह्मन्पुत्रः स्याद्द्रोणमृत्यवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2009203, "chapter_id": 1180, "verse_number": "१-१८१-१२", "content_sanskrit": "अर्जुनस्य भवेद्भार्या भवेद्या वरवर्णिनी।\nउपयाज कृते तस्मिन् गवां दाताऽस्मि तेऽर्बुदं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2009204, "chapter_id": 1180, "verse_number": "१-१८१-१३", "content_sanskrit": "यद्वा तेऽन्यद्द्विजश्रेष्ठ मनसः सुप्रियं भवेत्।\nसर्वं तत्ते प्रदाताऽहं न हि मेऽत्रास्ति संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2009205, "chapter_id": 1180, "verse_number": "१-१८१-१४", "content_sanskrit": "इत्युक्तो नाहमित्येवं तमृषिः प्रत्यभाषत।\nआराधयिष्यन्द्रुपदः स तं पर्यचरत्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2009206, "chapter_id": 1180, "verse_number": "१-१८१-१५", "content_sanskrit": "ततः संवत्सरस्यान्ते द्रुपदं स द्विजोत्तमः।\nउपयाजोऽब्रवीत्काले राजन्मधुरया गिरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2009207, "chapter_id": 1180, "verse_number": "१-१८१-१६", "content_sanskrit": "ज्येष्ठो भ्राता ममागृह्माद्विचरन् गहने वने।\nअपरिज्ञातशौचायां भूमौ निपतितं फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2009208, "chapter_id": 1180, "verse_number": "१-१८१-१७", "content_sanskrit": "तदपश्यमहं भ्रातुरसाम्प्रतमनुव्रजन्।\nविमर्शं संकरादाने नायं कुर्यात्कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2009209, "chapter_id": 1180, "verse_number": "१-१८१-१८", "content_sanskrit": "दृष्ट्वा फलस्य नापश्यद्दोषान्पापानुबन्धकान्।\nविविनक्ति न शौचं यः सोऽन्यत्रापि कथं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2009210, "chapter_id": 1180, "verse_number": "१-१८१-१९", "content_sanskrit": "संहिताध्ययनं कुर्वन्वसन्गुरुकुले च यः।\nभैक्षमुत्सृष्टमन्येषां भुङ्क्ते स्म च यदा तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2009211, "chapter_id": 1180, "verse_number": "१-१८१-२०", "content_sanskrit": "कीर्तयन्गुणमन्नानामघृणी च पुनः पुनः।\nतं वै फलार्थिनं मन्ये भ्रातरं तर्कचक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2009212, "chapter_id": 1180, "verse_number": "१-१८१-२१", "content_sanskrit": "तं वै गच्छस्व नृपते स त्वां संयाजयिष्यति।\nजुगुप्समानो नृपतिर्मनसेदं विचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2009213, "chapter_id": 1180, "verse_number": "१-१८१-२२", "content_sanskrit": "उपयाजवचः श्रुत्वा याजस्याश्रममभ्यगात्।\nअभिसम्पूज्य पूजार्हमथ याजमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2009214, "chapter_id": 1180, "verse_number": "१-१८१-२३", "content_sanskrit": "अयुतानि ददान्यष्टौ गवां याजय मां विभो।\nद्रोणवैराभिसन्तप्तं प्रह्लादयितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2009215, "chapter_id": 1180, "verse_number": "१-१८१-२४", "content_sanskrit": "स हि ब्रह्मविदां श्रेष्ठो ब्रह्मास्त्रे चाप्यनुत्तमः।\nतस्माद्द्रोणः पराजैष्ट मां वै स सखिविग्रहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2009216, "chapter_id": 1180, "verse_number": "१-१८१-२५", "content_sanskrit": "क्षत्रियो नास्ति तस्यास्यां पृथिव्यां कश्चिदग्रणीः।\nकौरवाचायर्मुख्यस्य भारद्वाजस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2009217, "chapter_id": 1180, "verse_number": "१-१८१-२६", "content_sanskrit": "द्रोणस्य शरजालानि प्राणिदेहहराणि च।\nषडरत्नि धनुश्चास्य दृश्यते परमं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2009218, "chapter_id": 1180, "verse_number": "१-१८१-२७", "content_sanskrit": "स हि ब्राह्मणवेषेण क्षात्रं वेगमशंसयम्।\nप्रतिहन्ति महेष्वासो भारद्वाजो महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2009219, "chapter_id": 1180, "verse_number": "१-१८१-२८", "content_sanskrit": "क्षत्रोच्छेदाय विहितो जामदग्न्य इवास्थितः।\nतस्य ह्यस्त्रबलं घोरमप्रधृष्यं नरैर्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2009220, "chapter_id": 1180, "verse_number": "१-१८१-२९", "content_sanskrit": "ब्राह्मं सन्धारयंस्तेजो हुताहुतिरिवानलः।\nसमेत्य स दहत्याजौ क्षात्रधर्मपुरःसरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2009221, "chapter_id": 1180, "verse_number": "१-१८१-३०", "content_sanskrit": "ब्रह्मक्षत्रे च विहिते ब्राह्मं तेजो विशिष्यते।\nसोऽहं क्षात्राद्बलाद्धीनो ब्राह्मं तेजः प्रपेदिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2009222, "chapter_id": 1180, "verse_number": "१-१८१-३१", "content_sanskrit": "द्रोणाद्विशिष्टमासाद्य भवन्तं ब्रह्मवित्तमम्।\nद्रोणान्तकमहं पुत्रं लभेयं युधि दुर्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2009223, "chapter_id": 1180, "verse_number": "१-१८१-३२", "content_sanskrit": "तत्कर्म कुरु मे मे याज वितराम्यर्बुदं गवाम्।\nतथेत्युक्त्वा तु तं याजो याज्यार्थमुपकल्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2009224, "chapter_id": 1180, "verse_number": "१-१८१-३३", "content_sanskrit": "गुर्वर्थ इति चाकाममुपयाजमचोदयत्।\nयाजो द्रोणविनाशाय प्रतिजज्ञे तथा च सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2009225, "chapter_id": 1180, "verse_number": "१-१८१-३४", "content_sanskrit": "ततस्तस्य नरेन्द्रस्य उपयाजो महातपाः।\nआचख्यौ कर्म वैतानं तदा पुत्रफलाय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2009226, "chapter_id": 1180, "verse_number": "१-१८१-३५", "content_sanskrit": "स च पुत्रो महावीर्यो महातेजा महाबलः।\nइष्यते यद्विधो राजन्भविता ते तथाविधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2009227, "chapter_id": 1180, "verse_number": "१-१८१-३६", "content_sanskrit": "भारद्वाजस्य हन्तारं सोऽभिसन्धाय भूपतिः।\nआजह्वे तत्तथा सर्वं द्रुपदः कर्मसिद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2009228, "chapter_id": 1180, "verse_number": "१-१८१-३७", "content_sanskrit": "याजस्तु हवनस्यान्ते देवीमाज्ञापयत्तदा।\nप्रेहि मां राज्ञि पृषति मिथुनं त्वामुपस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2009229, "chapter_id": 1180, "verse_number": "१-१८१-३८x", "content_sanskrit": "राज्ञ्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2009230, "chapter_id": 1180, "verse_number": "१-१८१-३८", "content_sanskrit": "अवलिप्तं मुखं ब्रह्मन्दिव्यान्गन्धान्बिभर्मि च।\nसूतार्थे नोपलब्धाऽस्मि तिष्ठ याज मम प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2009231, "chapter_id": 1180, "verse_number": "१-१८१-३९x", "content_sanskrit": "याज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2009232, "chapter_id": 1180, "verse_number": "१-१८१-३९", "content_sanskrit": "याजेन श्रपितं हव्यमुपयाजाभिमन्त्रितम्।\nकथं कामं न सन्दध्यात्सा त्वं विप्रेहि तिष्ठ वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2009233, "chapter_id": 1180, "verse_number": "१-१८१-४०x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2009234, "chapter_id": 1180, "verse_number": "१-१८१-४०", "content_sanskrit": "एवमुक्त्वा तु याजेन हुते हविषि संस्कृते।\nउत्तस्थौ पावकात्तस्मात्कुमारो देवसन्निभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2009235, "chapter_id": 1180, "verse_number": "१-१८१-४१", "content_sanskrit": "ज्वालावर्णो घोररूपः किरीटी वर्म चोत्तमम्।\nबिभ्रत्सखङ्गः सशरो धनुष्मान्विनदन्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2009236, "chapter_id": 1180, "verse_number": "१-१८१-४२", "content_sanskrit": "सोऽध्यारोदद्रथवरं तेन च प्रययौ तदा।\nततः प्रणेदुः पञ्चालाः प्रहृष्टाः साधुसाध्विति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2009237, "chapter_id": 1180, "verse_number": "१-१८१-४३", "content_sanskrit": "हर्षाविष्टांस्ततश्चैतान्नेयं सेहे वसुन्धरा।\nभयापहो राजपुत्रः पञ्चालानां यशस्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2009238, "chapter_id": 1180, "verse_number": "१-१८१-४४", "content_sanskrit": "राज्ञः शोकापहो जात एष द्रोणवधाय वै।\nइत्युवाच महद्भूतमदृश्यं खेचरं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2009239, "chapter_id": 1180, "verse_number": "१-१८१-४५", "content_sanskrit": "कुमारी चापि पाञ्चाली वेदीमध्यात्समुत्थिता।\nसुभगा दर्शनीयाङ्गी स्वसितायतलोचना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2009240, "chapter_id": 1180, "verse_number": "१-१८१-४६", "content_sanskrit": "श्यामा पद्मपलाशाक्षी नीलकुञ्चितमूर्धजा।\nताम्रतुङ्गनखी सुभ्रूश्चारुपीनपयोधरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2009241, "chapter_id": 1180, "verse_number": "१-१८१-४७", "content_sanskrit": "मानुषं विग्रहं कृत्वा साक्षादमरवर्णिनी।\nनीलोत्पलसमो गन्धो यस्याः क्रोशात्प्रधावति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2009242, "chapter_id": 1180, "verse_number": "१-१८१-४८", "content_sanskrit": "या बिभर्ति परं रूपं यस्या नास्त्युपमा भुवि।\nदेवदानवयक्षाणामीप्सितां देवरूपिणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2009243, "chapter_id": 1180, "verse_number": "१-१८१-४९", "content_sanskrit": "सदृशी पाण्डुपुत्रस्य अर्जुनस्येति भारत।\nऊचुः प्रहृष्टमनसो राजभक्तिपुरस्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2009244, "chapter_id": 1180, "verse_number": "१-१८१-५०", "content_sanskrit": "तां चापि जातां सुश्रोणीं वागुवाचाशरीरिणी।\nसर्वयोषिद्वरा कृष्णा निनीषुः क्षत्रियान्क्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2009245, "chapter_id": 1180, "verse_number": "१-१८१-५१", "content_sanskrit": "सुरकार्यमियं काले करिष्यति सुमध्यमा।\nअस्या हेतोः कौरवाणां महदुत्पत्स्यते भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2009246, "chapter_id": 1180, "verse_number": "१-१८१-५२", "content_sanskrit": "तच्छ्रुत्वा सर्वपञ्चालाः प्रणेदुः सिंहसङ्घवत्।\nन चैतान्हर्षसम्पूर्णानियं सेहे वसुन्धरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2009247, "chapter_id": 1180, "verse_number": "१-१८१-५३", "content_sanskrit": "पाञ्चालराजस्तां दृष्ट्वा हर्षादश्रूण्यवर्तयत्।\nपरिष्वज्य च तां कृष्णां स्नुषा पाण्डोरिति ब्रुवन्।\nअङ्कमारोप्य पाञ्चालीं राजा हर्षमवाप सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2009248, "chapter_id": 1180, "verse_number": "१-१८१-५४", "content_sanskrit": "तौ दृष्ट्वा पार्षती याजं प्रपेदे वै सुतार्थिनी।\nन वै मदन्यां जननीं जानीयातामिमाविति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2009249, "chapter_id": 1180, "verse_number": "१-१८१-५५", "content_sanskrit": "तथेत्युवाच तां याजो राज्ञः प्रियचिकीर्षया।\nतयोश्च नामनी चक्रुर्द्विजाः सम्पूर्णमानसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2009250, "chapter_id": 1180, "verse_number": "१-१८१-५६", "content_sanskrit": "धृष्टत्वादत्यमर्षित्वाद्द्युम्नाद्युत्संभवादपि।\nधृष्टद्युम्नः कुमारोऽयं द्रुपदस्य भवत्विति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2009251, "chapter_id": 1180, "verse_number": "१-१८१-५७", "content_sanskrit": "कृष्णेत्येवाब्रुवकन्कृष्णां कृष्णा।ञभूत्सा हि वर्णतः।\nतथा तन्मिथुनं जज्ञे द्रुपदस्य महामखे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2009252, "chapter_id": 1180, "verse_number": "१-१८१-५८", "content_sanskrit": "वैदिकाध्ययने पारं धृष्टद्युम्नो गतः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2009253, "chapter_id": 1180, "verse_number": "१-१८१-५९", "content_sanskrit": "धृष्टद्युम्नं तु पाञ्चाल्यमानीय स्वं निवेशनम्।\nउपाकरोदस्त्रहेतोर्भारद्वाजः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2009254, "chapter_id": 1180, "verse_number": "१-१८१-६०", "content_sanskrit": "अमोक्षणीयं दैवं हि भावि मत्वा महामतिः।\nतथा तत्कृतवान्द्रोण आत्मकीर्त्यनुरक्षणात्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2009255, "chapter_id": 1180, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि चैत्ररथपर्वमि एकाशीत्यधिकशततमोऽध्यायः॥ १८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]