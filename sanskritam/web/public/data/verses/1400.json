[{"id": 2019186, "chapter_id": 1400, "verse_number": "३-३८-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2019187, "chapter_id": 1400, "verse_number": "३-३८-१", "content_sanskrit": "भगवञ्श्रोतुमिच्छासमि पार्थस्याक्लिष्टकर्मणः।\nविस्तरेण कथामेतां यथाऽस्त्राण्युपलब्धवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2019188, "chapter_id": 1400, "verse_number": "३-३८-२", "content_sanskrit": "कथं च पुरुषव्याघ्रो दीर्घबाहुर्धनंजयः।\nवनं प्रविष्टस्तेजस्वी निर्मनुष्यमभीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2019189, "chapter_id": 1400, "verse_number": "३-३८-३", "content_sanskrit": "किंचानेन कृतंतत्रवसता ब्रह्मवित्तम।\nकथं च भगवान्स्थाणुर्देवराजश्च तोषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2019190, "chapter_id": 1400, "verse_number": "३-३८-४", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं त्वत्प्रसादाद्द्विजोत्तम।\nत्वं हि सर्वज्ञ दिव्यं च मानुषं चैव वेत्थ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2019191, "chapter_id": 1400, "verse_number": "३-३८-५", "content_sanskrit": "अत्यद्भुतं महाप्राज्ञ रोमहर्षणमर्जुनः।\nभवेन सह संग्रामं चकाराप्रतिमं किल।\nपुरा प्रहरतांश्रेष्ठः संग्रामेष्वपराजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2019192, "chapter_id": 1400, "verse_number": "३-३८-६", "content_sanskrit": "यच्छ्रुत्वा नरसिंहानां दैन्यहर्षातिविस्मयात्।\nशूराणामपि पार्थानां हृदयानि चकम्पिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2019193, "chapter_id": 1400, "verse_number": "३-३८-७", "content_sanskrit": "यद्यच्च कृतवानन्यत्पार्थस्तदस्विलं वद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2019194, "chapter_id": 1400, "verse_number": "३-३८-८", "content_sanskrit": "न ह्यस् निन्दितं जिष्णोः सुसूक्ष्ममपि लक्षये।\nचरितं यस्य शूरस्य तन्मे सर्वं प्रकीर्तय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2019195, "chapter_id": 1400, "verse_number": "३-३८-९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2019196, "chapter_id": 1400, "verse_number": "३-३८-९", "content_sanskrit": "कथयिष्यामि ते तात कथामेतां महात्मनः।\nदिव्यां कौरवशार्दूल महतीमद्भुतोपमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2019197, "chapter_id": 1400, "verse_number": "३-३८-१०", "content_sanskrit": "गात्रसंस्पर्शसंबद्धां त्र्यम्बकेण महाहवे।\nपार्थस्य देवदेवेन शृणु सम्यक्समागमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2019198, "chapter_id": 1400, "verse_number": "३-३८-११", "content_sanskrit": "युधिष्ठिरनियोगात्स जगामामितविक्रमः।\nशक्रं सुरेश्वरं द्रष्टुं देवदेवं च शंकरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2019199, "chapter_id": 1400, "verse_number": "३-३८-१२", "content_sanskrit": "दिव्यं तद्धनुरादाय खङ्गं च पुरुषर्षभः।\nमहाबलो महाबाहुरर्जुनः कार्यसिद्धये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2019200, "chapter_id": 1400, "verse_number": "३-३८-१३", "content_sanskrit": "दिशं ह्युदीचीं कौरव्यो हिमवच्छिखरं प्रति।\nऐन्द्रिः स्थिरमना राजन्सर्वलोकमहारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2019201, "chapter_id": 1400, "verse_number": "३-३८-१४", "content_sanskrit": "त्वरया परया युक्तस्तपसे धृतनिश्चयः।\nवनं कण्टकितं घोरमेक एवान्वपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2019202, "chapter_id": 1400, "verse_number": "३-३८-१५", "content_sanskrit": "नानापुष्पफलोपेतं नानापक्षिनिनादितम्।\nनानामृगगणाकीर्णं सिद्धचारणसेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2019203, "chapter_id": 1400, "verse_number": "३-३८-१६", "content_sanskrit": "ततः प्रयाते बीभत्सौ वनं मानुषवर्जितम्।\nशङ्खानां पटहानां च शब्दः समभवद्दिवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2019204, "chapter_id": 1400, "verse_number": "३-३८-१७", "content_sanskrit": "पुष्पवर्षं च सुमहन्निपपात महीतले।\nमेघजालं च सततं छादयामास सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2019205, "chapter_id": 1400, "verse_number": "३-३८-१८", "content_sanskrit": "सोतीत्य वनदुर्गाणि सन्निकर्षे महागिरेः।\nशुशुभे हिमवत्पृष्ठे वसमानोऽर्जुनस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2019206, "chapter_id": 1400, "verse_number": "३-३८-१९", "content_sanskrit": "तत्रतत्र द्रुमान्फुल्लान्विहगैर्वल्गुनादितान्।\nनदीश्च विपुलावर्ता वैदूर्यनीलसंनिभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2019207, "chapter_id": 1400, "verse_number": "३-३८-२०", "content_sanskrit": "हंसकारण्डवोद्गीताः सारसाभिरुतास्तथा।\nपुंस्कोकिलरुताश्चैव क्रौञ्चबर्हिणनादिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2019208, "chapter_id": 1400, "verse_number": "३-३८-२१", "content_sanskrit": "मनोहरवनोपेतास्तस्मिन्नतिरथोऽर्जुनः।\nपुण्यशीतामलजलाः पश्यन्प्रीतमनाऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2019209, "chapter_id": 1400, "verse_number": "३-३८-२२", "content_sanskrit": "रमणीये वनोद्देशे रममाणोऽर्जुनस्तदा।\nतपस्युग्रे वर्तमान उग्रतेजा महामनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2019210, "chapter_id": 1400, "verse_number": "३-३८-२३", "content_sanskrit": "दर्भचीरं निवस्याथ दण्डाजिनबिभूषितः।\nशीर्णं च पतितं भूमौ पर्णं समुपभुक्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2019211, "chapter_id": 1400, "verse_number": "३-३८-२४", "content_sanskrit": "पूर्णेपूर्णे त्रिररात्रे तु मासमेकं फलाशनः।\nद्विगुणेनैव कालेन द्वितीयं मासमत्ययात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2019212, "chapter_id": 1400, "verse_number": "३-३८-२५", "content_sanskrit": "तृतीयमपि मासं स क्रमेणाहारमाचरन्।\nचतुर्थे त्वथ संप्राप्ते मासे भरतसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2019213, "chapter_id": 1400, "verse_number": "३-३८-२६", "content_sanskrit": "वायुभक्षो महाबाहुरभवत्पाण्डुनन्दनः।\nऊर्ध्वबाहुर्निरालम्बः पादाङ्गुष्ठाग्रधिष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2019214, "chapter_id": 1400, "verse_number": "३-३८-२७", "content_sanskrit": "सदोपस्पर्शनाच्चास्य बभूवुरमितौजसः।\nविद्युदम्भोरुहनिभा जटास्तस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2019215, "chapter_id": 1400, "verse_number": "३-३८-२८", "content_sanskrit": "ततो महर्षयः सर्वे जग्मुर्देवं पिनाकिनम्।\nविवेदयिषवः पार्थं तपस्युग्रे समास्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2019216, "chapter_id": 1400, "verse_number": "३-३८-२९", "content_sanskrit": "नीलकण्ठं महादेवमभिवाद्य प्रणम्य च।\nसर्वे निवेदयामासुः कर्म तत्फल्गुनस्य ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2019217, "chapter_id": 1400, "verse_number": "३-३८-३०", "content_sanskrit": "एकः पार्थो महातेजा हिमवत्पृष्ठमाश्रितः।\nउग्रे तपरसि दुष्पारे स्थितो धूमापयन्दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2019218, "chapter_id": 1400, "verse_number": "३-३८-३१", "content_sanskrit": "तस्य देवेश न वयं विद्मः सर्वे चिकीर्षितम्।\nसंतापयति नः सर्वानसौ साधु निवार्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2019219, "chapter_id": 1400, "verse_number": "३-३८-३२", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा मुननां भावितात्मनाम्।\nउमापतिर्भूतपतिर्वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2019220, "chapter_id": 1400, "verse_number": "३-३८-३३", "content_sanskrit": "न वो विषादः कर्तव्यः फल्गुनं प्रति सर्वशः।\nशीघ्रं गच्छत संहृष्टा यथागतमतन्द्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2019221, "chapter_id": 1400, "verse_number": "३-३८-३४", "content_sanskrit": "अहमस्य विजानामि संकल्पं मनसि स्थितम्।\nनास्य स्वर्गस्पृहा काचिन्नैश्वर्यस्य न चायुषः।\nयत्तस्य काङ्क्षितं प्राप्तुं तत्करिष्येऽहमद्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2019222, "chapter_id": 1400, "verse_number": "३-३८-३५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2019223, "chapter_id": 1400, "verse_number": "३-३८-३५", "content_sanskrit": "तच्छ्रुत्वा शर्ववचनमृषयः सत्यवादिनः।\nप्रहृष्टमनसो जग्मुर्यथास्वं पुनराश्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2019224, "chapter_id": 1400, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि कैरातपर्वणि अष्टत्रिंशोऽध्यायः ॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]