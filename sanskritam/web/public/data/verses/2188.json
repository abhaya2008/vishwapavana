[{"id": 2054087, "chapter_id": 2188, "verse_number": "७-११५-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2054088, "chapter_id": 2188, "verse_number": "७-११५-१", "content_sanskrit": "शृणुष्वैकमना राजन्यन्मां त्वं परिपृच्छसि।\nद्राव्यमाणे बले तस्मिन्हार्दिक्येन महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2054089, "chapter_id": 2188, "verse_number": "७-११५-२", "content_sanskrit": "लज्जयावनते चापि परिहृष्टे च तावके।\nद्वीपो य आसीत्पाण्डूनामगाधे गाधमिच्छताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2054090, "chapter_id": 2188, "verse_number": "७-११५-३", "content_sanskrit": "श्रुत्वा स निनदं भीमं तावकानां महाहवे।\nशैनेयस्त्वरितो राजन्कृतवर्माणमभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2054091, "chapter_id": 2188, "verse_number": "७-११५-४", "content_sanskrit": "उवाच सारथिं तत्र क्रोधामर्षसमन्वितः।\nहार्दिक्याभिमुखं सूत कुरु मे रथमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2054092, "chapter_id": 2188, "verse_number": "७-११५-५", "content_sanskrit": "कुरुते कदनं पश्य पाण्डुसैन्ये ह्यमर्षितः।\nएनं जित्वा पुनः सूत यास्यामि विजयं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2054093, "chapter_id": 2188, "verse_number": "७-११५-६", "content_sanskrit": "एवमुक्ते तु वचने सूतस्तस्य महामते।\nनिमेषान्तरमात्रेण कृतवर्माणमभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2054094, "chapter_id": 2188, "verse_number": "७-११५-७", "content_sanskrit": "कृतवर्मा तु हार्दिक्यः शैनेयं निशितैः शरैः।\nअवाकिरत्सुसंक्रुद्धस्ततोऽक्रुद्ध्यत्स सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2054095, "chapter_id": 2188, "verse_number": "७-११५-८", "content_sanskrit": "अथाशु निशितं भल्लुं शैनेयः कृतवर्मणः।\nप्रेषयामास समरे शरांश्च चतुरोऽपरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2054096, "chapter_id": 2188, "verse_number": "७-११५-९", "content_sanskrit": "ते तस्य जघ्निरे वाहान्भल्लेनास्याच्छिनद्धनुः।\nपृष्ठरक्षं तथा सूतमविध्यन्निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2054097, "chapter_id": 2188, "verse_number": "७-११५-१०", "content_sanskrit": "ततस्तं विरथं कृत्वा सात्यकिः सत्यविक्रमः।\nसेनामस्यार्दयामास शरैः सन्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2054098, "chapter_id": 2188, "verse_number": "७-११५-११", "content_sanskrit": "अभज्यताथ पृतना शैनेयशरपीडिता।\n`पलायनकृतोत्साहा भ्रमन्ती तत्रतत्र ह।\nततः प्रायात्स त्वरितः सात्यकिः सत्यविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2054099, "chapter_id": 2188, "verse_number": "७-११५-१२", "content_sanskrit": "शृणु राजन्यदकरोत्तव सैन्येषु वीर्यवान्।\nअतीत्य स महाराज द्रोणानीकमहार्णवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2054100, "chapter_id": 2188, "verse_number": "७-११५-१३", "content_sanskrit": "पराजित्य तु संहृष्टः कृतवर्माणमाहवे।\nयन्तारमब्रवीच्छूरः शनैर्याहीत्यसम्भ्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2054101, "chapter_id": 2188, "verse_number": "७-११५-१४", "content_sanskrit": "दृष्ट्वा तु तव तत्सैन्यं रथाश्वद्वि पसङ्कुलम्।\nपदातिजनसम्पूर्णमब्रवीत्सारथिं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2054102, "chapter_id": 2188, "verse_number": "७-११५-१५", "content_sanskrit": "यदेतन्मेघसङ्काशं द्रोणानीकस्य सव्यतः।\nसुमहत्कुञ्जरानीकं यस्य रुक्मरथो मुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2054103, "chapter_id": 2188, "verse_number": "७-११५-१६", "content_sanskrit": "एते हि बहवः सूत दुर्निवार्याश्च संयुगे।\nदुर्योधनसमादिष्टा मदर्थे त्यक्तजीविताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2054104, "chapter_id": 2188, "verse_number": "७-११५-१७", "content_sanskrit": "राजपुत्रा महेष्वासाः सर्वे विक्रान्तयोधिनः।\n`न चाजित्वा रणे ह्येताञ्शक्यः प्राप्तुं जयद्रथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2054105, "chapter_id": 2188, "verse_number": "७-११५-१८", "content_sanskrit": "नापि सूत मया पार्थः शक्यः प्राप्तुं कथञ्चन।\nएते तिष्ठन्ति सहिताः सर्वविद्यासु निष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2054106, "chapter_id": 2188, "verse_number": "७-११५-१९", "content_sanskrit": "त्रिगर्तानां रथोदाराः सुवर्णविकृतध्वजाः।\nमामेवाभिमुखा वीरा योत्स्यमाना व्यवस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2054107, "chapter_id": 2188, "verse_number": "७-११५-२०", "content_sanskrit": "अत्र मां प्रापय क्षिप्रमश्वांश्चोदय सारथे।\nत्रिगर्तैः सह योत्स्यामि भारद्वाजस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2054108, "chapter_id": 2188, "verse_number": "७-११५-२१x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2054109, "chapter_id": 2188, "verse_number": "७-११५-२१", "content_sanskrit": "ततः प्रायाच्छनैः सूतः सात्वतस्य मते स्थितः।\nरथेनादित्यवर्णेन भास्वरेण पताकिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2054110, "chapter_id": 2188, "verse_number": "७-११५-२२", "content_sanskrit": "तमूहुः सारथेर्वश्या वल्गमाना हयोत्तमाः।\nवायुवेगसमाः सङ्ख्ये कुन्देन्दुरजतप्रभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2054111, "chapter_id": 2188, "verse_number": "७-११५-२३", "content_sanskrit": "आपतन्तं रणे तं तु शङ्खवर्णैर्हयोत्तमैः।\nपरिववुस्ततः शूरा गजानीकेन सर्वतः।\nकिरन्तो विविधांस्तीक्ष्णान्सायकाँल्लघुवेधिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2054112, "chapter_id": 2188, "verse_number": "७-११५-२४", "content_sanskrit": "सात्वतोऽपि शितैर्बाणैर्गजानीकमयोधयत्।\nपर्वतानिव वर्षेण तपान्ते जलदो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2054113, "chapter_id": 2188, "verse_number": "७-११५-२५", "content_sanskrit": "वज्राशनिसमस्पर्शैर्वध्यमानाः शरैर्गजाः।\nप्राद्रवन्रणमुत्सृज्य शिनिवीरसमीरितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2054114, "chapter_id": 2188, "verse_number": "७-११५-२६", "content_sanskrit": "शीर्णदन्ता विरुधिरा भिन्नमस्तकपिण्डिकाः।\nविशीर्णकर्णास्यकरा विनियन्तृपताकिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2054115, "chapter_id": 2188, "verse_number": "७-११५-२७", "content_sanskrit": "सम्भिन्नवर्मघण्टाश्च विनिकृत्तमहाध्वजाः।\nहतारोहा दिशो राजन्भेजिरे भ्रष्टकम्बलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2054116, "chapter_id": 2188, "verse_number": "७-११५-२८", "content_sanskrit": "रुवन्तो विविधान्नादाञ्जलदोपमनिःस्वनाः।\nनारचैर्वत्सदन्तैश्च भल्लैरञ्जलिकैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2054117, "chapter_id": 2188, "verse_number": "७-११५-२९", "content_sanskrit": "क्षुरप्रैरर्धचन्द्रैश्च सात्वतेन विदारिताः।\nक्षरन्तोऽसृक्तथा मूत्रं पुरीषं च प्रदुद्रुवुः।\nबभ्रुमुश्चस्खलुश्चान्ये पेतुर्मम्लुस्तथाऽपरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2054118, "chapter_id": 2188, "verse_number": "७-११५-३०", "content_sanskrit": "एवं तत्कुञ्जरानीकं युयुधानेन पीडितम्।\nशरैरग्न्यर्कसङ्काशैः प्रदुद्राव समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2054119, "chapter_id": 2188, "verse_number": "७-११५-३१", "content_sanskrit": "तस्मिन्हते गजानीके जलसन्धो महाबलः।\nयत्तः सम्प्रापयन्नागं रजताश्वरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2054120, "chapter_id": 2188, "verse_number": "७-११५-३२", "content_sanskrit": "रुक्मवर्मधरः शूरस्तपनीयाङ्गदः शुचिः।\nकुण्डली मकुटी खङ्गी रक्तचन्दनरूषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2054121, "chapter_id": 2188, "verse_number": "७-११५-३३", "content_sanskrit": "शिरसा धारयन्दीप्तां तपनीयमयीं स्रजम्।\nउरसा धारयन्निष्कं कण्ठसूत्रं च भास्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2054122, "chapter_id": 2188, "verse_number": "७-११५-३४", "content_sanskrit": "चापं च रुक्मविकृतं विधुन्वन्गजमूर्धनि।\nअशोभत महाराज सविद्युदिव तोयदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2054123, "chapter_id": 2188, "verse_number": "७-११५-३५", "content_sanskrit": "तमापतन्तं सहसा मागधस्य गजोत्तमम्।\nसात्यकिर्वारयामास वेलेव मकरालयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2054124, "chapter_id": 2188, "verse_number": "७-११५-३६", "content_sanskrit": "नागं निवारितं दृष्ट्वा शैनेयस्य शरोत्तमैः।\nअक्रुध्यत रणे राजञ्जलसन्धो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2054125, "chapter_id": 2188, "verse_number": "७-११५-३७", "content_sanskrit": "ततः क्रुद्धो महाराज मार्गणैर्भारसाधनैः।\nअविध्यत शिनेः पौत्रं जलसन्धो महोरसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2054126, "chapter_id": 2188, "verse_number": "७-११५-३८", "content_sanskrit": "ततोऽपरेण भल्लेन पीतेन निशितेन च।\nअस्यतो वृष्णिवीरस्य निचकर्त शरासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2054127, "chapter_id": 2188, "verse_number": "७-११५-३९", "content_sanskrit": "सात्यकिं छिन्नधन्वानां प्रहसन्निव भारत।\nअविध्यन्मागधो वीरः पञ्चभिर्निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2054128, "chapter_id": 2188, "verse_number": "७-११५-४०", "content_sanskrit": "स विद्धो बहुभिर्बाणैर्जलसन्धेन वीर्यवान्।\nनाकम्पत महाबाहुस्तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2054129, "chapter_id": 2188, "verse_number": "७-११५-४१", "content_sanskrit": "अचिन्तयन्वै स शरान्नात्यर्थं सम्भ्रमाद्बली।\nधनुरन्यत्समादाय तिष्ठतिष्ठेत्युवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2054130, "chapter_id": 2188, "verse_number": "७-११५-४२", "content_sanskrit": "एतावदुक्त्वा शैनेयो जलसन्धं महोरसि।\nविव्याध षष्ट्या सुभृशं शराणां प्रहसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2054131, "chapter_id": 2188, "verse_number": "७-११५-४३", "content_sanskrit": "क्षुरप्रेण सुतीक्ष्णेन मुष्टिदेशे महद्धनुः।\nजलसन्धस्य चिच्छेद विव्याध च त्रिभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2054132, "chapter_id": 2188, "verse_number": "७-११५-४४", "content_sanskrit": "जलसन्धस्तु तत्त्यक्त्वा सशरं वै शरासनम्।\nतोमरं व्यसृजत्तूर्णं सात्यकिं प्रति मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2054133, "chapter_id": 2188, "verse_number": "७-११५-४५", "content_sanskrit": "स निर्भिद्य भुजं सव्यं माधवस्य महारणे।\nअभ्यगाद्धरणीं घोरः श्वसन्निव महोरगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2054134, "chapter_id": 2188, "verse_number": "७-११५-४६", "content_sanskrit": "निर्भिन्ने तु भुजे सव्ये सात्यकिः सत्यविक्रमः।\nत्रिंशद्भिर्विशिखैस्तीक्ष्णैर्जलसन्धमताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2054135, "chapter_id": 2188, "verse_number": "७-११५-४७", "content_sanskrit": "प्रगृह्य तु ततः खङ्गं जलसन्धो महाबलः।\nआर्षभं चर्म च महच्छतचन्द्रकसङ्कुलम्।\nआविध्य च ततः खङ्गं सात्वतायोत्ससर्ज ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2054136, "chapter_id": 2188, "verse_number": "७-११५-४८", "content_sanskrit": "शैनेयस्य धनुश्छित्त्वा स खङ्गो न्यपतन्महीम्।\nअलातचक्रवच्चैव व्यरोचत महीं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2054137, "chapter_id": 2188, "verse_number": "७-११५-४९", "content_sanskrit": "अथान्यद्धनुरादाय सर्वकायावदारणम्।\n`जलसन्धमभिप्रेक्ष्य उत्स्मयित्वा च माधवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2054138, "chapter_id": 2188, "verse_number": "७-११५-५०", "content_sanskrit": "शालस्कन्धप्रतीकाशमिन्द्राशनिसमस्वनम्।\nविष्फार्य विव्यधे क्रुद्धो जलसन्धं शरेण ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2054139, "chapter_id": 2188, "verse_number": "७-११५-५१", "content_sanskrit": "ततः साभरणौ बाहू क्षुराभ्यां माधवोत्तमः।\nसाङ्गदौ जलसन्धस्य चिच्छेद प्रहसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2054140, "chapter_id": 2188, "verse_number": "७-११५-५२", "content_sanskrit": "तौ बाहू परिघप्रख्यौ पेततुर्गजसत्तमात्।\nवसुन्धराधराद्धष्टौ पञ्चशीर्षाविवोरगौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2054141, "chapter_id": 2188, "verse_number": "७-११५-५३", "content_sanskrit": "ततः सुदंष्ट्रं सुहनु चारुकुण्डलमण्डितम्।\nक्षुरेणास्य तृतीयेन शिरश्चिच्छेद सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2054142, "chapter_id": 2188, "verse_number": "७-११५-५४", "content_sanskrit": "तत्पातितशिरोबाहुकबन्धं भीमदर्शनम्।\nद्विरदं जलसन्धस्य रुधिरेणाभ्यषिञ्चत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2054143, "chapter_id": 2188, "verse_number": "७-११५-५५", "content_sanskrit": "जलसन्धं निहत्याजौ त्वरमाणस्तु सात्वतः।\nविमानं पातयामास गजस्कन्धाद्विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2054144, "chapter_id": 2188, "verse_number": "७-११५-५६", "content_sanskrit": "रुधिरेणावसिक्ताङ्गौ जलसन्धस्य कुञ्जरः।\nविलम्बमानमवहत्संश्लिष्टं परमासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2054145, "chapter_id": 2188, "verse_number": "७-११५-५७", "content_sanskrit": "शरार्दितः सात्वतेन मर्दमानः स्ववाहिनीम्।\nघोरमार्तस्वरं कृत्वा विदुद्राव महागजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2054146, "chapter_id": 2188, "verse_number": "७-११५-५८", "content_sanskrit": "हाहाकारो महानासीत्तव सैन्यस्य मारिष।\nजलसन्धं हतं दृष्ट्वा वृष्णीनामृपभेण तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2054147, "chapter_id": 2188, "verse_number": "७-११५-५९", "content_sanskrit": "विमुखाश्चाभ्यधावन्त तव योधाः समन्ततः।\nपलायनकृतोत्साहा निरुत्साहा द्विषञ्जये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2054148, "chapter_id": 2188, "verse_number": "७-११५-६०", "content_sanskrit": "एतस्मिन्नन्तरे राजन्द्रोणः शस्त्रभृतां वरः।\n`सन्न्यस्य भारं सुमहत्कृतवर्मणि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2054149, "chapter_id": 2188, "verse_number": "७-११५-६१", "content_sanskrit": "अभ्ययाज्जवनैरश्वैर्युयुधानं महारथम्।\nस हि पार्थान्रणे यत्तान्दधारैको महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2054150, "chapter_id": 2188, "verse_number": "७-११५-६२", "content_sanskrit": "तमुदीर्णं तथा दृष्ट्वा शैनेयं कुरुपुङ्गवाः।\nद्रोणेनैव सह क्रुद्धा सात्यकिं समुपाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2054151, "chapter_id": 2188, "verse_number": "७-११५-६३", "content_sanskrit": "ततः प्रववृते युद्धं कुरूणां सात्वतस्य च।\nद्रोणस्य च रणे राजन्घोरं देवासुरोपमम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2054152, "chapter_id": 2188, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे पञ्चदशाधिकशततमोऽध्यायः॥ ११५ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-११५-२३ द्रोणo ५-११५-२६ पिण्डिक्रा गण्डः॥ ५-११५-३३ कण्ठसूत्रं हारम्॥ ५-११५-४७ ततो ग्रहणानन्तरम्। आविध्य भ्रामयित्वा॥ ५-११५-५२ वसुन्धराधरात् पर्वताम्॥ ५-११५-११५ पञ्चदशाधिकशततमोऽध्याय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]