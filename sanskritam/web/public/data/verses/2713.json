[{"id": 2080554, "chapter_id": 2713, "verse_number": "१२-२१८-०x", "content_sanskrit": "गुरुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2080555, "chapter_id": 2713, "verse_number": "१२-२१८-१", "content_sanskrit": "निष्कल्मषं ब्रह्मचर्यमिच्छताचरितुं सदा।\nनिद्रा सर्वात्मना त्याज्या स्वप्नदोषमवेक्षता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2080556, "chapter_id": 2713, "verse_number": "१२-२१८-२", "content_sanskrit": "स्वप्ने हि रजसा देही तमसा चाभिभूयते।\nदेहान्तरमिवापन्नश्चरत्यपगतस्मृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2080557, "chapter_id": 2713, "verse_number": "१२-२१८-३", "content_sanskrit": "ज्ञानाभ्यासाज्जागरिता जिज्ञासार्थमनन्तरम्।\nविज्ञानाभिनिवेशात्तु स जागर्त्यनिशं सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2080558, "chapter_id": 2713, "verse_number": "१२-२१८-४", "content_sanskrit": "अत्राह कोन्वयं भावः स्वप्ने विषयवानिव।\nप्रलीनैरिन्द्रियैर्देही वर्तते देहवानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2080559, "chapter_id": 2713, "verse_number": "१२-२१८-५", "content_sanskrit": "अत्रोच्यते यथा ह्येतद्वेद योगेश्वरो हरिः।\nतथैतदुपपन्नार्थं वर्णयन्ति महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2080560, "chapter_id": 2713, "verse_number": "१२-२१८-६", "content_sanskrit": "इन्द्रियाणां श्रमात्स्वप्नमाहुः सर्वगतं मनः।\n`तन्मयानीन्द्रियाण्याहुस्तावद्गच्छन्ति तानि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2080561, "chapter_id": 2713, "verse_number": "१२-२१८-७", "content_sanskrit": "अत्राहुस्त्रितयं नित्यमतथ्यमिति चेच्च न।\nप्रथमे वर्तमानोऽसौ त्रितयं चेति सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2080562, "chapter_id": 2713, "verse_number": "१२-२१८-८", "content_sanskrit": "नेतरावुपसंगम्य विजानाति कथंचन।\nस्वप्नावस्थागतो ह्येष स्वप्न इत्येव वेत्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2080563, "chapter_id": 2713, "verse_number": "१२-२१८-९", "content_sanskrit": "तदप्यसदृशं युक्त्या त्रितयं मोहलक्षणम्।\nयदात्मत्रितयान्मुक्तस्तदा जानात्यसत्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2080564, "chapter_id": 2713, "verse_number": "१२-२१८-१०", "content_sanskrit": "मनसस्त्वप्रलीनत्वात्तत्तदाहुर्निदर्शनम्।\nकार्ये चासक्तमनसः संकल्पो जाग्रतो ह्यपि।\nयद्वन्मनोरथैश्चर्यं स्वप्ने तद्वन्मनोगतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2080565, "chapter_id": 2713, "verse_number": "१२-२१८-११", "content_sanskrit": "संसाराणामसंख्यानां कामात्मा तदवाप्नुयात्।\nमनस्यन्तर्हितं सर्वं वेद सोत्तमपूरुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2080566, "chapter_id": 2713, "verse_number": "१२-२१८-१२", "content_sanskrit": "गुणानामपि यद्येतत्कर्मणा चाप्युपस्थितम्।\nतत्तच्छंसन्ति भूतानि मनो यद्भावितं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2080567, "chapter_id": 2713, "verse_number": "१२-२१८-१३", "content_sanskrit": "ततस्तमुपसर्पन्ति गुणा राजसतामसाः।\nसात्विका वा यथायोगमानन्तर्यफलोदयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2080568, "chapter_id": 2713, "verse_number": "१२-२१८-१४", "content_sanskrit": "ततः पश्यन्त्यसंबन्धान्वातपित्तकफोत्तरान्।\nरजस्तमोभवैर्भावैस्तदप्याहुर्दुरत्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2080569, "chapter_id": 2713, "verse_number": "१२-२१८-१५", "content_sanskrit": "प्रसन्नैरिन्द्रियैर्यद्यत्संकल्पयति मानसम्।\nतत्तत्स्वप्नेप्युपरते मनो बुद्धिर्निरीक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2080570, "chapter_id": 2713, "verse_number": "१२-२१८-१६", "content_sanskrit": "व्यापकं सर्वभूतेषु वर्तते दीपवन्मनः।\nआत्मप्रभावात्तं विद्यात्सर्वा ह्यात्मनि देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2080571, "chapter_id": 2713, "verse_number": "१२-२१८-१७", "content_sanskrit": "मनस्यन्तर्हितं द्वारं देहमास्थाय मानुषम्।\nयत्तत्सदसदव्यक्तं स्वपित्यस्मिन्निदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2080572, "chapter_id": 2713, "verse_number": "१२-२१८-१८", "content_sanskrit": "`व्यक्तभेदमतीतोऽसौ चिन्मात्रं परिदृश्यते।\nसर्वभूतात्मभूतस्थं तमध्यात्मगुणं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2080573, "chapter_id": 2713, "verse_number": "१२-२१८-१९", "content_sanskrit": "लिप्सेन मनसा यश्च संकल्पादैश्वरं गुणम्।\nआत्मप्रसादात्तं विद्यात्सर्वा ह्यात्मनि देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2080574, "chapter_id": 2713, "verse_number": "१२-२१८-२०", "content_sanskrit": "एवं हि तपसा युञ्ज्यादर्कवत्तमसः परम्।\nत्रैलोक्यप्रकृतिर्देही तमसोन्ते महेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2080575, "chapter_id": 2713, "verse_number": "१२-२१८-२१", "content_sanskrit": "तपो ह्यधिष्ठितं देवैस्तपोघ्नमसुरैस्तमः।\nएतद्देवासुरैर्गुप्तं तदाहुर्ज्ञानलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2080576, "chapter_id": 2713, "verse_number": "१२-२१८-२२", "content_sanskrit": "सत्त्वं रजस्तमश्चेति देवासुरगुणान्विदुः।\nसत्त्वं देवगुणं विद्यादितरावासुरौ गुणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2080577, "chapter_id": 2713, "verse_number": "१२-२१८-२३", "content_sanskrit": "`सत्त्वं मनस्तथा बुद्धिर्देवा इत्यभिशंब्दिताः।\nतैरेव हि वृतस्तस्माज्ज्ञात्वैवं परमं-----॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2080578, "chapter_id": 2713, "verse_number": "१२-२१८-२४", "content_sanskrit": "निद्राविकल्पेन सतां---- विशति लोकवत्।\nस्वस्थो भवति गूढात्मा कलुषैः परिवर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2080579, "chapter_id": 2713, "verse_number": "१२-२१८-२५", "content_sanskrit": "निशादिका ये कथिता लोकानां कलुषा मताः।\nतैर्हीनं यत्पुरं शुद्धं बाह्याभ्यन्तरवर्तिनम्।\nसदानन्दमयं नित्यं भूत्वा तत्परमन्वियात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2080580, "chapter_id": 2713, "verse_number": "१२-२१८-२६", "content_sanskrit": "एवमाख्यातमत्यर्थं ब्रह्मचर्यमकल्मषम्।\nसर्वसंयोगहीनं तद्विष्ण्वाख्यं परमं पदम्।\nअचिन्त्यमद्भुतं लोके ज्ञानेन परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2080581, "chapter_id": 2713, "verse_number": "१२-२१८-२७", "content_sanskrit": "ब्रह्म तत्परमं ज्ञानममृतं ज्योतिरक्षरम्।\nये विदुर्भावितात्मानस्ते यान्ति परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2080582, "chapter_id": 2713, "verse_number": "१२-२१८-२८", "content_sanskrit": "हेतुमच्छक्यमाख्यातुमेतावज्ज्ञानचक्षुषा।\nप्रत्याहारेण वा शक्यमव्यक्तं ब्रह्म वेदितुम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2080583, "chapter_id": 2713, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि अष्टादशाधिकद्विशततमोऽध्यायः॥ २१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]