[{"id": 7005470000, "chapter_id": 25470, "verse_number": "१-४०-१", "content_sanskrit": "श्रीकूर्म उवाच ।\nएवमुक्तास्तु मुनयो नैमिषीया महामतिम् ।\nपप्रच्छुरुत्तरं सूतं पृथिव्यादिविनिर्णयम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005470001, "chapter_id": 25470, "verse_number": "१-४०-२", "content_sanskrit": "ऋषय ऊचुः कथितो भवता सूत सर्गः स्वयंभुवः शुभः ।\nइदानीं श्रोतुमिच्छामस्त्रिलोकस्यास्य मण्डलम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005470002, "chapter_id": 25470, "verse_number": "१-४०-३", "content_sanskrit": "यावन्तः सागरा द्वीपास्तथा वर्षाणि पर्वताः ।\nवनानि सरितः सूर्यग्रहाणां स्थितिरेव च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005470003, "chapter_id": 25470, "verse_number": "१-४०-४", "content_sanskrit": "यदाधारमिदं कृत्स्नं येषां पृथ्वी पुरा त्वियम् ।\nनृपाणां तत्समासेन सूत वक्तुमिहार्हसि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005470004, "chapter_id": 25470, "verse_number": "१-४०-५", "content_sanskrit": "सूत उवाच ।\nवक्ष्ये देवादिदेवाय विष्णवे प्रभविष्णवे ।\nनमस्कृत्याप्रमेयाय यदुक्तं तेन धीमता ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005470005, "chapter_id": 25470, "verse_number": "१-४०-६", "content_sanskrit": "स्वायंभुवस्य तु मनोः प्रागुक्तो यः प्रियव्रतः ।\nपुत्रस्तस्याभवन् पुत्राः प्रजापतिसमा दश ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005470006, "chapter_id": 25470, "verse_number": "१-४०-७", "content_sanskrit": "अग्नीध्रश्चाग्निबाहुश्च वपुष्मान् द्युतिमांस्तथा ।\nमेधा मेधातिथिर्हव्यः सवनः पुत्र एव च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005470007, "chapter_id": 25470, "verse_number": "१-४०-८", "content_sanskrit": "ज्योतिष्मान् दशमस्तेषां महाबलपराक्रमः ।\nधार्मिको दाननिरतः सर्वभूतानुकम्पकः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005470008, "chapter_id": 25470, "verse_number": "१-४०-९", "content_sanskrit": "मेधाग्निबाहुपुत्रास्तु त्रयो योगपरायणाः ।\nजातिस्मरा महाभागा न राज्ये दधिरे मतिम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005470009, "chapter_id": 25470, "verse_number": "१-४०-१०", "content_sanskrit": "प्रियव्रतोऽभ्यषिञ्चद् वै सप्तद्वीपेषु सप्त तान् ।\nजम्बुद्वीपेश्वरं पुत्रमग्नीध्रमकरोन्नृपः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005470010, "chapter_id": 25470, "verse_number": "१-४०-११", "content_sanskrit": "प्लक्ष्द्वीपेश्वरश्चैव तेन मेधातिथिः कृतः ।\nशाल्मलीशं वपुष्मन्तं नरेन्द्रमभिषिक्तवान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005470011, "chapter_id": 25470, "verse_number": "१-४०-१२", "content_sanskrit": "ज्योतिष्मन्तं कुशद्वीपे राजानं कृतवान् प्रभुः ।\nद्युतिमन्तं च राजानं क्रौञ्चद्वीपे समादिशत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005470012, "chapter_id": 25470, "verse_number": "१-४०-१३", "content_sanskrit": "शाकद्वीपेश्वरं चापि हव्यं चक्रे प्रियव्रतः ।\nपुष्कराधिपतिं चक्रे सवनं च प्रजापतिः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005470013, "chapter_id": 25470, "verse_number": "१-४०-१४", "content_sanskrit": "पुष्करेश्वरतश्चापि महावीतः सुतोऽभवत् ।\nधातिकिश्चैव द्वावेतौ पुत्रौ पुत्रवतां वरौ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005470014, "chapter_id": 25470, "verse_number": "१-४०-१५", "content_sanskrit": "महावीतं स्मृतं वर्षं तस्य स्यात्तु महात्मनः ।\nनाम्ना वैधातकेश्चापि धातकीखण्डमुच्यते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005470015, "chapter_id": 25470, "verse_number": "१-४०-१६", "content_sanskrit": "शाकद्वीपेश्वरस्याथ हव्यस्याप्यभवन् सुताः ।\nजलदश्च कुमारश्च सुकुमारो मणीचकः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005470016, "chapter_id": 25470, "verse_number": "१-४०-१७", "content_sanskrit": "कुशोत्तरोऽथ मोदाकिः सप्तमः स्यान्महाद्रुमः ।\nजलदं जलदस्याथ वर्षं प्रथममुच्यते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005470017, "chapter_id": 25470, "verse_number": "१-४०-१८", "content_sanskrit": "कुमारस्य तु कौमारं तृतीयं सुकुमारकम् ।\nमणीचकं चतुर्थं तु पञ्चमं कुसुमोत्तरम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005470018, "chapter_id": 25470, "verse_number": "१-४०-१९", "content_sanskrit": "मोदाकं षष्ठमित्युक्तं सप्तमं तु महाद्रुमम् ।\nक्रौञ्चद्वीपेश्वरस्यापि सुता द्युतिमतोऽभवन् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005470019, "chapter_id": 25470, "verse_number": "१-४०-२०", "content_sanskrit": "कुशलः प्रथमस्तेषां द्वितीयस्तु मनोहरः ।\nउष्णस्तृतीयः संप्रोक्तश्चतुर्थः प्रवरः स्मृतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005470020, "chapter_id": 25470, "verse_number": "१-४०-२१", "content_sanskrit": "अन्धकारो मुनिश्चैव दुन्दुभिश्चेति सप्तमः ।\nतेषां स्वनामभिर्देशाः क्रौञ्चद्वीपाश्रयाः शुभाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005470021, "chapter_id": 25470, "verse_number": "१-४०-२२", "content_sanskrit": "ज्योतिष्मतः कुशद्वीपे सप्तैवासन् महौजसः ।\nउद्‌भेदो वेणुमांश्चैवाश्वरथो लम्बनो धृतिः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005470022, "chapter_id": 25470, "verse_number": "१-४०-२३", "content_sanskrit": "षष्ठः प्रभाकारश्चापि सप्तमः कपिलः स्मृतः ।\nस्वनामचिह्निता यत्र तथा वर्षाणि सुव्रताः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005470023, "chapter_id": 25470, "verse_number": "१-४०-२४", "content_sanskrit": "ज्ञेयानि च तथान्येषु द्वीपेष्वेवं न यो मतः ।\nशाल्मलिद्वीपनाथस्य सुताश्चासन् वपुष्मतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005470024, "chapter_id": 25470, "verse_number": "१-४०-२५", "content_sanskrit": "श्वेतश्च हरितश्चैव जीमूतो रोहितस्तथा ।\nवैद्युतौ मानसश्चैव सप्तमः सुप्रभो मतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005470025, "chapter_id": 25470, "verse_number": "१-४०-२६", "content_sanskrit": "प्लक्षद्वीपेश्वरस्यापि सप्त मेधातिथेः सुताः ।\nज्येष्ठः शान्तमयस्तेषां शिशिरस्तु सुखोदयः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005470026, "chapter_id": 25470, "verse_number": "१-४०-२७", "content_sanskrit": "आनन्दश्च शिवश्चैव क्षेमकश्च ध्रुवस्तथा ।\nप्लक्षद्वीपादिषु ज्ञेयाः शाकद्वीपान्तिकेषु च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005470027, "chapter_id": 25470, "verse_number": "१-४०-२८", "content_sanskrit": "वर्णाश्रमविभागेन स्वधर्मो मुक्तये द्विजाः ।\nजम्बुद्वीपेश्वरस्यापि पुत्रास्त्वासन् महाबलाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005470028, "chapter_id": 25470, "verse_number": "१-४०-२९", "content_sanskrit": "अग्नीध्रस्य द्विजश्रेष्ठास्तन्नामानि निबोधत ।\nनाभिः किंपुरुषश्चैव तथा हरिरिलावृतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005470029, "chapter_id": 25470, "verse_number": "१-४०-३०", "content_sanskrit": "रम्यो हिरण्वांश्च कुरुर्भद्राश्वः केतुमालकः ।\nजम्बुद्वीपेश्वरो राजा स चाग्नीध्रो महामतिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005470030, "chapter_id": 25470, "verse_number": "१-४०-३१", "content_sanskrit": "विभज्य नवधा तेभ्यो यथान्यायं ददौ पुनः ।\nनाभेस्तु दक्षिणं वर्षं हिमाह्वं प्रददौ पिता ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005470031, "chapter_id": 25470, "verse_number": "१-४०-३२", "content_sanskrit": "हेमकूटं ततो वर्षं ददौ किंपुरुषाय सः ।\nतृतीयं नैषधं वर्षं हरये दत्तवान् पिता ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005470032, "chapter_id": 25470, "verse_number": "१-४०-३३", "content_sanskrit": "इलावृताय प्रददौ मेरुमध्यमिलावृतम् ।\nनीलाचलाश्रृतं वर्षं रम्याय प्रददौ पिता ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005470033, "chapter_id": 25470, "verse_number": "१-४०-३४", "content_sanskrit": "श्वेतं यदुत्तरं वर्षं पित्रा दत्तं हिरण्वते ।\nयदुत्तरं श्रृङ्गवतो वर्षं तत् कुरुवे ददौ ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005470034, "chapter_id": 25470, "verse_number": "१-४०-३५", "content_sanskrit": "मेरोः पूर्वेण यद् वर्षं भद्राश्वाय न्यवेदयत् ।\nगन्धमादनवर्षं तु केतुमालाय दत्तवान् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005470035, "chapter_id": 25470, "verse_number": "१-४०-३६", "content_sanskrit": "वर्षेष्वेतेषु तान् पुत्रानभिषिच्य नराधिपः ।\nसंसारकष्टतां ज्ञात्वा तपस्तेपे वनं गतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005470036, "chapter_id": 25470, "verse_number": "१-४०-३७", "content_sanskrit": "हिमाह्वयं तु यस्यैतन्नाभेरासीन्महात्मनः ।\nतस्यर्षभोऽभवत् पुत्रो मरुदेव्यां महाद्युतिः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005470037, "chapter_id": 25470, "verse_number": "१-४०-३८", "content_sanskrit": "ऋषभाद् भरतो जज्ञे वीरः पुत्रशताग्रजः ।\nसोऽभिषिच्यर्षभः पुत्रं भरतं पृथिवीपतिः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005470038, "chapter_id": 25470, "verse_number": "१-४०-३९", "content_sanskrit": "वानप्रस्थाश्रमं गत्वा तपस्तेपे यथाविधि ।\nतपसा कर्षितोऽत्यर्थं कृशो धमनिसन्ततः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005470039, "chapter_id": 25470, "verse_number": "१-४०-४०", "content_sanskrit": "ज्ञानयोगरतो भूत्वा महापाशुपतोऽभवत् ।\nसुमतिर्भरतस्याभूत् पुत्रः परमधार्मिकः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005470040, "chapter_id": 25470, "verse_number": "१-४०-४१", "content_sanskrit": "सुमतेस्तैजसस्तस्मादिन्द्रिद्युम्नो महाद्युतिः ।\nपरमेष्ठी सुतस्तस्मात् प्रतीहारस्तदन्वयः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005470041, "chapter_id": 25470, "verse_number": "१-४०-४२", "content_sanskrit": "प्रतिहर्त्तेति विख्यात उत्पन्नस्तस्य चात्मजः ।\nभवस्तस्मादथोद्‌गीथः प्रस्तावस्तत्सुतोऽभवत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005470042, "chapter_id": 25470, "verse_number": "१-४०-४३", "content_sanskrit": "पृथुस्ततस्ततो नक्तो नक्तस्यापि गयः स्मृतः ।\nनरो गयस्य तनयस्तस्य पुत्रो विराडभूत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005470043, "chapter_id": 25470, "verse_number": "१-४०-४४", "content_sanskrit": "तस्य पुत्रो महावीर्यो धीमांस्तस्मादजायत ।\nधीमतोऽपि ततश्चाभूद् शौचनस्तत्सुतोऽभवत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005470044, "chapter_id": 25470, "verse_number": "१-४०-४५", "content_sanskrit": "त्वष्टा त्वष्टुश्च विरजो रजस्तस्मादभूत् सुतः ।\nशतजिद् रथजित्तस्य जज्ञे पुत्रशतं द्विजाः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005470045, "chapter_id": 25470, "verse_number": "१-४०-४६", "content_sanskrit": "तेषां प्रधानो बलवान् विश्वज्योतिरिति स्मृतः ।\nआराध्य देवं ब्रह्माणं क्षेमकं नाम पार्थिवम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005470046, "chapter_id": 25470, "verse_number": "१-४०-४७", "content_sanskrit": "असूत पुत्रं धर्मज्ञं महाबाहुमरिंदमम्‌ ।\nएते पुरस्ताद् राजानो महासत्त्वा महौजसः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005470047, "chapter_id": 25470, "verse_number": "१-४०-४८", "content_sanskrit": "एषां वंशप्रसूतैश्च भुक्तेयं पृथिवी पुरा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]