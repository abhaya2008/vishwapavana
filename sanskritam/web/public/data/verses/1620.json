[{"id": 2028552, "chapter_id": 1620, "verse_number": "३-२५८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028553, "chapter_id": 1620, "verse_number": "३-२५८-१", "content_sanskrit": "प्रविशन्तं महाराज सूतास्तुष्टुवुरच्युतम्।\nजनाश्चापि महेष्वासं तुष्टुवू राजसत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028554, "chapter_id": 1620, "verse_number": "३-२५८-२", "content_sanskrit": "लाजैश्चन्दनचूर्णैश्च विकीर्य च जनास्ततः।\nऊटुर्दिष्ट्या नृपाविघ्नः समाप्तोयं क्रतुस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028555, "chapter_id": 1620, "verse_number": "३-२५८-३", "content_sanskrit": "अपरे त्वब्रुवंस्तत्रवादिकास्तं महीपतिम्।\nयौधिष्ठिरस्य यज्ञस्य न समो ह्येष ते क्रतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028556, "chapter_id": 1620, "verse_number": "३-२५८-४", "content_sanskrit": "नैव तस्य क्रतोरेष कलामर्हति षोडशीम्।\nएवं तत्राब्रुवन्केचिद्वातिकास्तं जनेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028557, "chapter_id": 1620, "verse_number": "३-२५८-५", "content_sanskrit": "सुहृदस्त्वब्रुवंस्तत्र अति सर्वानयं क्रतुः।\n`प्रवर्तितो ह्ययं राज्ञा धार्तराष्ट्रेण धीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028558, "chapter_id": 1620, "verse_number": "३-२५८-६", "content_sanskrit": "ययातिर्नहुषश्चापि मान्धाता भरतस्तथा।\nक्रतुमेनं समाहृत्य पूताः सर्वे दिवं गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028559, "chapter_id": 1620, "verse_number": "३-२५८-७", "content_sanskrit": "एता वाचः शुभाः शृण्वन्सुहृदां भरतर्षभ।\nप्रविवेश पुरं हृष्टः स्ववेश्म च नराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028560, "chapter_id": 1620, "verse_number": "३-२५८-८", "content_sanskrit": "अभिवाद्य ततः पादान्मतापित्रोर्विशांपते।\nभीष्मद्रोणकृपादीनां विदुरस्य च धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028561, "chapter_id": 1620, "verse_number": "३-२५८-९", "content_sanskrit": "अभिवादितः कनीयोभिर्भ्रातृभिर्भ्रातृनन्दनः।\nनिषसादासने मुख्ये भ्रातृभिः परिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028562, "chapter_id": 1620, "verse_number": "३-२५८-१०", "content_sanskrit": "तमुत्थाय महाराजं सूतपुत्रोऽब्रवीद्वचः।\nदिष्ट्या ते भरतश्रेष्ठ समाप्तोऽयं महाक्रतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028563, "chapter_id": 1620, "verse_number": "३-२५८-११", "content_sanskrit": "हतेषु युधि पार्थेषु राजसूये तथा त्वया।\nआहृतेऽहं नरश्रेष्ठ त्वां सभाजयिता पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028564, "chapter_id": 1620, "verse_number": "३-२५८-१२", "content_sanskrit": "तमब्रवीन्महाराजो धार्तराष्ट्रो महायशाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028565, "chapter_id": 1620, "verse_number": "३-२५८-१३", "content_sanskrit": "सत्यमेतत्त्वयोक्तं हि पाण्डवेषु दुरात्मसु।\nनिहतेषु नरश्रेष्ठ प्राप्ते चापि महाक्रतौ।\nराजसूये पुनर्वीर त्वमेवं वर्धयिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028566, "chapter_id": 1620, "verse_number": "३-२५८-१४", "content_sanskrit": "एवमुक्त्वा महाराज कर्णमाश्लिष्य भारत।\nराजसूयं क्रतुश्रेष्ठं चिन्तयामास कौरवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028567, "chapter_id": 1620, "verse_number": "३-२५८-१५", "content_sanskrit": "सोऽब्रवीत्कौरवांश्चापि पार्श्वस्थान्नृपसत्तमः।\n`राधेयसौबलादीन्वै धार्तराष्ट्रो महीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2028568, "chapter_id": 1620, "verse_number": "३-२५८-१६", "content_sanskrit": "कदा तु तं क्रतुवरं राजसूयं महाधनम्।\nनिहत्य पाण्डवान्सर्वानाहरिष्यामि कौरवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2028569, "chapter_id": 1620, "verse_number": "३-२५८-१७", "content_sanskrit": "तमब्रवीत्तदा कर्णः शृणु मे राजकुञ्जर।\nपादौ न धावये तावद्यावन्न निहतोऽर्जुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2028570, "chapter_id": 1620, "verse_number": "३-२५८-१८", "content_sanskrit": "कीलालजं न खादेयं करिष्ये चासुरव्रतम्।\nनास्तीति नैव वक्ष्यामि याचितो येन केचनित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2028571, "chapter_id": 1620, "verse_number": "३-२५८-१९", "content_sanskrit": "अथोत्क्रुष्टं महेष्वासैर्धार्तराष्ट्रैर्महारथैः।\nप्रतिज्ञाते फल्गुनस्य वधे कर्णेन संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2028572, "chapter_id": 1620, "verse_number": "३-२५८-२०", "content_sanskrit": "विजितांश्चाप्यमन्यन्त पाण्डवान्धृतराष्ट्रजाः।\n`तदा प्रतिज्ञामारुह्य सूतपुत्रेण भाषिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2028573, "chapter_id": 1620, "verse_number": "३-२५८-२१", "content_sanskrit": "दूर्योधनोऽपि राजेन्द्र विसृज्यनरपुङ्गवान्।\nप्रविवेश गृहंश्रीमान्यथा चैत्ररथं प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2028574, "chapter_id": 1620, "verse_number": "३-२५८-२२", "content_sanskrit": "तेऽपिसर्वे महेष्वासा जग्मुर्वेश्मानि भारत।\n`स्वानिस्वनि महाराज भीष्मद्रोणादयो नृपा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2028575, "chapter_id": 1620, "verse_number": "३-२५८-२३", "content_sanskrit": "पाण्डवाश्च महेष्वासा दूतवाक्यप्रचोदिताः।\nचिन्तयन्तस्तमेवार्थं नालभन्त सुखं क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2028576, "chapter_id": 1620, "verse_number": "३-२५८-२४", "content_sanskrit": "भूयश्च चारै राजेन्द्र प्रवृत्तिरुपपादिता।\nप्रतिज्ञा सूतपुतर्स्य विजयस्य वधं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2028577, "chapter_id": 1620, "verse_number": "३-२५८-२५", "content_sanskrit": "एतच्छ्रुत्वा धर्मसुतः समुद्विग्नो नराधिप।\n`अधोमुखश्चिरं तस्थौ किं कार्यमिति चिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2028578, "chapter_id": 1620, "verse_number": "३-२५८-२६", "content_sanskrit": "अभेद्यकवचं मत्वा कर्णमद्भुतविक्रमम्।\nअनुस्मरंश् संक्लेशान्न शान्तिमुपजग्मिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2028579, "chapter_id": 1620, "verse_number": "३-२५८-२७", "content_sanskrit": "तस्य चिन्तापरीतस्य बुद्धिर्जज्ञे महात्मनः।\nबहुव्यालमृगाकीर्णं त्यक्तुं द्वैतवनं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2028580, "chapter_id": 1620, "verse_number": "३-२५८-२८", "content_sanskrit": "धार्तराष्ट्रोऽपि नृपतिः प्रशशास वसुंधराम्।\nभ्रातृभिः सहितो वीरैर्भीष्मद्रोणकृपैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2028581, "chapter_id": 1620, "verse_number": "३-२५८-२९", "content_sanskrit": "संगम्य सूतपुत्रेण कर्णेनाहवशोभिना।\n`सततं प्रीयमाणो वै देविना सौबलेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2028582, "chapter_id": 1620, "verse_number": "३-२५८-३०", "content_sanskrit": "दुर्योधनः प्रिये नित्यं वर्तमानो महीभृताम्।\nपूजयामास विप्रेन्द्रान्क्रतुभिर्भूरिदक्षिणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2028583, "chapter_id": 1620, "verse_number": "३-२५८-३१", "content_sanskrit": "भ्रातॄणां च प्रियं राजन्स चकार परंतपः।\nनिश्चित्य मनसा वीरो दत्तभुक्तफलं धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2028584, "chapter_id": 1620, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि घोषयात्रापर्वणि अष्टपञ्चाशदधिकद्विशततमोऽध्यायः ॥ २५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]