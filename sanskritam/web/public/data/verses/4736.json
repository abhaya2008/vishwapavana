[{"id": 2176726, "chapter_id": 4736, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2176727, "chapter_id": 4736, "verse_number": "१", "content_sanskrit": "अधिष्ठितः पदा मूर्ध्नि भग्नसक्थिर्महीं गतः ।\nशौण्डिर्यमानी पुत्रो मे कान्यभाषत सञ्जय\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2176728, "chapter_id": 4736, "verse_number": "२", "content_sanskrit": "अत्यर्थे कोपनो राजा कृतवैरश्च पाण्डुषु ।\nव्यसनं परमं प्राप्तः किमाह परमाहवे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2176729, "chapter_id": 4736, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2176730, "chapter_id": 4736, "verse_number": "३", "content_sanskrit": "शृणु राजन् यथावृत्तं प्रवक्ष्यामि परन्तप ।\nराज्ञा यदुक्तं मग्नेन तस्मिन् व्यसनसागरे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2176731, "chapter_id": 4736, "verse_number": "४", "content_sanskrit": "भिन्नसक्थो नृपो राजन् पांसुना परिकुण्ठितः ।\nसंयम्य मूर्धजांस्तत्र वीक्ष्य चैव दिशो दश\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2176732, "chapter_id": 4736, "verse_number": "५", "content_sanskrit": "क्रोधं नियम्य यत्नेन निःश्वसन्नुरगो यथा ।\nसंरम्भाश्रुपरीताभ्यां नेत्राभ्यामभिवीक्ष्य माम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2176733, "chapter_id": 4736, "verse_number": "६", "content_sanskrit": "बाहू धरण्यां निष्पीड्य मुहुर्मत्त इव द्विपः ।\nप्रकीर्णान् मूर्धजान् धून्वन् दन्तैर्दन्तानुपस्पृशन्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2176734, "chapter_id": 4736, "verse_number": "७", "content_sanskrit": "गर्हयन् पाण्डवश्रेष्ठं विनिःश्वस्येदमब्रवीत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2176735, "chapter_id": 4736, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2176736, "chapter_id": 4736, "verse_number": "८", "content_sanskrit": "भीष्मे शान्तनवे नाथे द्रोणे चाचार्यसत्तमे ।\nगौतमे शकुनौ चापि कर्णे शस्त्रभृतां वरे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2176737, "chapter_id": 4736, "verse_number": "९", "content_sanskrit": "अश्वत्थाम्नि तथा शूरे शल्ये च कृतवर्मणि ।\nअन्येष्वपि च शूरेषु न्यस्तभारो महात्मसु\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2176738, "chapter_id": 4736, "verse_number": "१०", "content_sanskrit": "इमामवस्थां प्राप्तोऽस्मि कालो हि दुरतिक्रमः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2176739, "chapter_id": 4736, "verse_number": "११", "content_sanskrit": "एकादशचमूभर्ता सोऽहमेतां दशां गतः ।\nकालं प्राप्य महाबाहो न कश्चिदतिवर्तते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2176740, "chapter_id": 4736, "verse_number": "१२", "content_sanskrit": "आख्यातव्यं मदीयानां ये तु जीवन्ति सङ्गरे ।\nयथाऽहं भीमसेनेन व्युत्क्रम्य समयं हतः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2176741, "chapter_id": 4736, "verse_number": "१३", "content_sanskrit": "बहूनि सुनृशंसानि कृतानि खलु पाण्डवैः ।\nभूरिश्रवसि कर्णे च द्रोणे भीष्मे च श्रीमति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2176742, "chapter_id": 4736, "verse_number": "१४", "content_sanskrit": "इदं चाकीर्तिदं कर्म नृशंसं पाण्डवैः कृतम् ।\nवाच्यतां येन ते सत्सु गमिष्यन्तीति मे मतिः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2176743, "chapter_id": 4736, "verse_number": "१५", "content_sanskrit": "का प्रीतिः सत्त्वयुक्तस्य कृत्वोपाधिकृतं जयम् ।\nको वा समयभेत्तारं बुधः सम्मन्तुमर्हति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2176744, "chapter_id": 4736, "verse_number": "१६", "content_sanskrit": "अधर्मेण जयं लब्ध्वा को नु हृष्येत पण्डितः ।\nयथा संहृष्यते पापः पाण्डुपुत्रो वृकोदरः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2176745, "chapter_id": 4736, "verse_number": "१७", "content_sanskrit": "किं नु चित्रमतस्त्वन्यत् भग्नसक्थस्य वै मम ।\nक्रुद्धेन भीमसेनेन पदा यन्मृदितं शिरः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2176746, "chapter_id": 4736, "verse_number": "१८", "content_sanskrit": "प्रतपन्तं श्रिया जुष्टं वर्तमानं च बन्धुषु ।\nनिगृह्णीयाद् रिपुं यो हि स वै सञ्जय पूरुषः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2176747, "chapter_id": 4736, "verse_number": "१९", "content_sanskrit": "अभिज्ञौ क्षत्रधर्मस्य मम माता पिता च यौ ।\nतौ हि सञ्जय दुःखार्तौ विज्ञाप्यौ वचनान्मम\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2176748, "chapter_id": 4736, "verse_number": "२०", "content_sanskrit": "इष्टं भृत्या भृताः सम्यग् भूः प्रशस्ता ससागरा ।\nमूर्ध्नि स्थितममित्राणां जीवतामेव सञ्जय\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2176749, "chapter_id": 4736, "verse_number": "२१", "content_sanskrit": "दत्ता देया यथाशक्ति मित्राणां च प्रियं कृतम् ।\nअमित्रा बाधिताः सर्वे को नु स्वन्ततरो मया\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2176750, "chapter_id": 4736, "verse_number": "२२", "content_sanskrit": "नृपमुख्येषु मानश्च मया प्राप्तः सुदुर्लभः ।\nआजानेयैस्तथा नेयं(यातः) को नु स्वन्ततरो मया\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2176751, "chapter_id": 4736, "verse_number": "२३", "content_sanskrit": "यातानि परराष्ट्राणि नृपा भुक्ताश्च दासवत् ।\nप्रियेभ्यश्च कृतं साधु को नु स्वन्ततरो मया\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2176752, "chapter_id": 4736, "verse_number": "२४", "content_sanskrit": "मानिता बान्धवाः सर्वे मान्यः सम्पूजितो जनः ।\nत्रितयं सेवितं सर्वं को नु स्वन्ततरो मया\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2176753, "chapter_id": 4736, "verse_number": "२५", "content_sanskrit": "अधीतं विहृतं दत्तं प्राप्तमायुर्निरामयम् ।\nस्वधर्मेण जिता लोकाः को नु स्वन्ततरो मया\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2176754, "chapter_id": 4736, "verse_number": "२६", "content_sanskrit": "दिष्ट्या नाहं जितः सङ्खे परान् प्रेष्यवदाश्रितः ।\nदिष्ट्या मे विपुला लक्ष्मीर्मृते त्वन्यं गता मयि\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2176755, "chapter_id": 4736, "verse_number": "२७", "content_sanskrit": "यदिष्टं क्षत्रबन्धूनां स्वधर्ममनुतिष्ठताम् ।\nनिधनं तन्मया प्राप्तं को नु स्वन्ततरो मया\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2176756, "chapter_id": 4736, "verse_number": "२८", "content_sanskrit": "दिष्ट्या नाहं परावृत्तो वैरात् प्राकृतवज्जितः ।\nदिष्ट्या न विमतिं कञ्चिद् भजित्वाऽहं पराजितः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2176757, "chapter_id": 4736, "verse_number": "२९", "content_sanskrit": "सुप्तं वाऽपि प्रमत्तं वा यथा हन्याद् विषेण वा ।\nएवं व्युत्क्रान्तधर्मेण व्युत्क्रम्य समयं हतः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2176758, "chapter_id": 4736, "verse_number": "३०", "content_sanskrit": "अश्वत्थामा महाबाहुः कृतवर्मा च सात्वतः ।\nकृपः शारद्वतश्चापि वक्तव्या वचनान्मम\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2176759, "chapter_id": 4736, "verse_number": "३१", "content_sanskrit": "अधर्मेण प्रवृत्तानां पाण्डवानामनेकशः ।\nविश्वासं समयघ्नानां न यूयं गन्तुमर्हथ\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2176760, "chapter_id": 4736, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2176761, "chapter_id": 4736, "verse_number": "३२", "content_sanskrit": "वार्तिकान् चाब्रवीत् सर्वान् पुत्रस्ते सत्यविक्रमः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2176762, "chapter_id": 4736, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2176763, "chapter_id": 4736, "verse_number": "३३", "content_sanskrit": "अधर्माद् भीमसेनेन निहतोऽहं यथा रणे ।\nसोऽहं द्रोणं स्वर्गगतं शल्यकर्णावुभौ तथा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2176764, "chapter_id": 4736, "verse_number": "३४", "content_sanskrit": "वृषसेनं महावीर्यं शकुनिं चापि सौबलम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2176765, "chapter_id": 4736, "verse_number": "३५", "content_sanskrit": "जलसन्धं महात्मानं भगदत्तं च पार्थिवम् ।\nसोमदत्तं महेष्वासं सैन्धवं च जयद्रथम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2176766, "chapter_id": 4736, "verse_number": "३६", "content_sanskrit": "दुःशासनपुरोगांश्च भ्रातॄनात्मसमान् मम ।\nद्रौःशासनिं च विक्रान्तं लक्ष्मणं चात्मजावुभौ\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2176767, "chapter_id": 4736, "verse_number": "३७", "content_sanskrit": "एतांश्चान्यांश्च सुबहून् अस्मदीयान् सहस्रशः ।\nपृष्ठतोऽनुगमिष्यामि सार्थहीन इवाऽध्वगः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2176768, "chapter_id": 4736, "verse_number": "३८", "content_sanskrit": "नूनं भ्रातॄन् हतान् श्रुत्वा भर्तारं च स्वसा मम ।\nरोरूयमाणा दुःखार्ता दुःशला सा भविष्यति\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2176769, "chapter_id": 4736, "verse_number": "३९", "content_sanskrit": "स्नुषाभिः प्रस्नुषाभिश्च वृद्धो राजा पिता मम ।\nगान्धारीसहितः क्रोशन् कां गतिं प्रतिपत्स्यते\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2176770, "chapter_id": 4736, "verse_number": "४०", "content_sanskrit": "नूनं लक्ष्मणमाताऽपि हतपुत्रा हतेश्वरा ।\nविनाशं यास्यति क्षिप्रं कल्याणी पृथुलोचना\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2176771, "chapter_id": 4736, "verse_number": "४१", "content_sanskrit": "यदि जीवति चार्वाकः परिव्राड् वा विशारदः ।\nकरिष्यति महाभागो ध्रुवं सोऽपचितिं मम\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2176772, "chapter_id": 4736, "verse_number": "४२", "content_sanskrit": "समन्तपञ्चके पुण्ये त्रिषु लोकेषु विश्रुते ।\nअहं निधनमापद्य लोकान् प्राप्स्यामि शाश्वतान्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2176773, "chapter_id": 4736, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2176774, "chapter_id": 4736, "verse_number": "४३", "content_sanskrit": "ततो जनसहस्राणि बाष्पपूर्णानि मारिष ।\nप्रलापं नृपतेः श्रुत्वा विद्रवन्ति दिशो दश\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2176775, "chapter_id": 4736, "verse_number": "४४", "content_sanskrit": "ससागरवना घोरा पृथिवी सचराचरा ।\nचचालाथ सनिह्रादा दिशश्चैवाखिला भवन्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2176776, "chapter_id": 4736, "verse_number": "४५", "content_sanskrit": "ते द्रोणपुत्रमासाद्य यथावृत्तं न्यवेदयन् ।\nव्यवहारं गदायुद्धे पार्थिवस्य च पातनम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2176777, "chapter_id": 4736, "verse_number": "४६", "content_sanskrit": "तदाख्याय ततः सर्वे द्रोणपुत्रस्य मारिष ।\nवादिका दुःखसन्तप्ताः शोकोपहतचेतसः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2176778, "chapter_id": 4736, "verse_number": "४७", "content_sanskrit": "ध्यात्वा च सुचिरं कालं जग्मुश्चार्ता यथागतम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2176779, "chapter_id": 4736, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि दुर्योधनप्रलापो नाम चतुस्त्रिंशोऽध्यायः ॥३४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]