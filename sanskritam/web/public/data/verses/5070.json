[{"id": 2191412, "chapter_id": 5070, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2191413, "chapter_id": 5070, "verse_number": "१", "content_sanskrit": "शोकाद् दुःखाच्च मृत्योश्च त्रस्यन्ति प्राणिनः सदा ।\nउभयं मे यथा न स्यात्तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2191414, "chapter_id": 5070, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2191415, "chapter_id": 5070, "verse_number": "२", "content_sanskrit": "अत्रैवोदाहरन्तीममितिहासं पुरातनम् ।\nनारदस्य च संवादं समङ्गस्य च भारत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2191416, "chapter_id": 5070, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2191417, "chapter_id": 5070, "verse_number": "३", "content_sanskrit": "उरसेव प्रणमसे बाहुभ्यां तरसीव च ।\nसम्प्रहृष्टमना नित्यं विशोक इव लक्ष्यसे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2191418, "chapter_id": 5070, "verse_number": "४", "content_sanskrit": "उद्वेगं नेह ते किञ्चित् सुसूक्ष्ममपि लक्षये ।\nनित्यतृप्त इव स्वस्थो बालवच्च विचेष्टसे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2191419, "chapter_id": 5070, "verse_number": "", "content_sanskrit": "समङ्गः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2191420, "chapter_id": 5070, "verse_number": "५", "content_sanskrit": "भूतं भव्यं भविष्यच्च सर्वं सत्त्वेषु मानद ।\nतेषां तत्त्वानि जानामि ततो न विमना ह्यहम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2191421, "chapter_id": 5070, "verse_number": "६", "content_sanskrit": "उपक्रमानहं वेद पुनरेव फलोदयान् ।\nलोके फलानि चित्राणि ततो न विमना ह्यहम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2191422, "chapter_id": 5070, "verse_number": "७", "content_sanskrit": "अगाधाश्चाप्रतिष्ठाश्च गतिमन्तश्च नारद ।\nअन्धा जडाश्च जीवन्ति पश्यास्मानपि जीवतः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2191423, "chapter_id": 5070, "verse_number": "८", "content_sanskrit": "विहितेनैव जीवन्ति अरोगाङ्गा दिवौकसः ।\nबलवन्तोऽबलाश्चैव तद्वदस्मान् सभाजय\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2191424, "chapter_id": 5070, "verse_number": "९", "content_sanskrit": "सहस्रिणश्च जीवन्ति जीवन्ति शतिनस्तथा ।\nशाकेन चान्ये जीवन्ति पश्यास्मानपि जीवतः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2191425, "chapter_id": 5070, "verse_number": "१०", "content_sanskrit": "यदा न शोचेमहि किं नु\nन स्याद्धर्मेण वा नारद कर्मणा वा ।\nकृतान्तवश्यानि यदा सुखानि\nदुःखानि वा यन्न विधर्षयन्ति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2191426, "chapter_id": 5070, "verse_number": "११", "content_sanskrit": "यस्मै प्रज्ञां कथयन्ते मनुष्याः\nप्रज्ञामूलो हीन्द्रियाणां प्रसादः ।\nमुह्यन्ति शोचन्ति यदेन्द्रियाणि\nप्रज्ञालाभो नास्ति मूढेन्द्रियस्य\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2191427, "chapter_id": 5070, "verse_number": "१२", "content_sanskrit": "मूढस्य दर्पः स पुनर्मोह एव\nमूढस्य नायं न परोऽस्ति लोकः ।\nन ह्येव दुःखानि सदा भवन्ति\nसुखस्य वा नित्यशो लाभ एव\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2191428, "chapter_id": 5070, "verse_number": "१३", "content_sanskrit": "भावात्मकं सम्परिवर्तमानं\nन मादृशः सञ्ज्वरं जातु कुर्यात् ।\nइष्टान् भोगान्नानुरुद्ध्येत् सुखं वा\nन चिन्तयेद् दुःखमभ्यागतं वा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2191429, "chapter_id": 5070, "verse_number": "१४", "content_sanskrit": "समाहितो न स्पृहयेत् परेषां\nनानागतं नाभिनन्देत लाभम् ।\nन चापि हृष्येद् विपुलेऽर्थलाभे\nतथार्थनाशे च न वै विषीदेत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2191430, "chapter_id": 5070, "verse_number": "१५", "content_sanskrit": "न बान्धवा न च वित्तं न कौली\nन च श्रुतं न च मन्त्रा न वीर्यम् ।\nदुःखात् त्रातुं सर्व एवोत्सहन्ते\nपरत्र शीले न तु यान्ति शान्तिम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2191431, "chapter_id": 5070, "verse_number": "१६", "content_sanskrit": "नास्ति बुद्धिरयुक्तस्य नायोगाद् विद्यते सुखम् ।\nधृतिश्च दुःखत्यागश्चाप्युभयं नः सुखोदयम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2191432, "chapter_id": 5070, "verse_number": "१७", "content_sanskrit": "प्रियं हि हर्षजननं हर्ष उत्सेकवर्धनः ।\nउत्सेको नरकायैव तस्मात्तं सन्त्यजाम्यहम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2191433, "chapter_id": 5070, "verse_number": "१८", "content_sanskrit": "एतान् शोकभयोत्सेकान्मोहनान् सुखदुःखयोः ।\nपश्यामि साक्षिवल्लोके देहस्यास्य विचेष्टनात्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2191434, "chapter_id": 5070, "verse_number": "", "content_sanskrit": "अर्थकामौ परित्यज्य विशोको विगतज्वरः ।\nतृष्णामोहौ तु सन्त्यज्य चरामि पृथिवीमिमाम्\t॥१९ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2191435, "chapter_id": 5070, "verse_number": "२०", "content_sanskrit": "न मृत्युतो न चाधर्मान्न लोभान्न कुतश्चन ।\nपीतामृतस्येवात्यन्तमिह चामुत्र वा भयम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2191436, "chapter_id": 5070, "verse_number": "२१", "content_sanskrit": "एतद्ब्रह्मन् विजानामि महत्कृत्वा तपोऽव्ययम् ।\nतेन नारद सम्प्राप्तो न मां शोकः प्रबाधते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2191437, "chapter_id": 5070, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे एकोनविंशोत्तरशततमोऽध्यायः ॥११९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]