[{"id": 2111218, "chapter_id": 3407, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2111219, "chapter_id": 3407, "verse_number": "१", "content_sanskrit": "ततो मृगसहस्राणि हत्वा सबलवाहनः ।\nतत्र मेघघनप्रख्यं सिद्धचारणसेवितम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2111220, "chapter_id": 3407, "verse_number": "२", "content_sanskrit": "वनमालोकयामास नगराद् योजनद्वये ।\nमृगाननुचरन् वन्याञ्छ्रमेण परिपीडितः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2111221, "chapter_id": 3407, "verse_number": "३", "content_sanskrit": "मृगाननुचरन् राजा वेगेनाश्वानचोदयत् ।\nराजा मृगप्रसङ्गेन वनमन्यद् विवेश ह \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2111222, "chapter_id": 3407, "verse_number": "४", "content_sanskrit": "एक एवोत्तमबलः क्षुत्पिपासाश्रमान्वितः ।\nवनस्यान्तं समासाद्य सोऽपश्यदिरिणं ततः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2111223, "chapter_id": 3407, "verse_number": "५", "content_sanskrit": "तथाप्यतीत्य नृपतिरुत्तमाश्रमसंयुतम् ।\nमनःप्रह्लादजननं दृष्टिकान्तमतीव च\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2111224, "chapter_id": 3407, "verse_number": "६", "content_sanskrit": "शीतमारुतसंयुक्तं जगामान्यन्महद्वनम् ।\nपुष्पितैः पादपैः कीर्णमतीव सुखशाद्वलम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2111225, "chapter_id": 3407, "verse_number": "७", "content_sanskrit": "विपुलं मधुरारावैर्नादितं विहगैस्तथा ।\nपुंस्कोकिलनिनादैश्च झिल्लीकगणनादितम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2111226, "chapter_id": 3407, "verse_number": "८", "content_sanskrit": "प्रवृद्धविटपैर्वृक्षैः सुखच्छायैः समावृतम् ।\nषट्पदाघूर्णिततळं लक्ष्म्या परमया युतम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2111227, "chapter_id": 3407, "verse_number": "९", "content_sanskrit": "नापुष्पः पादपः कश्चिन्नाफलो नापि कण्टकी ।\nषट्पदैर्नाप्यपाकीर्णस्तस्मिन् वै काननेऽभवत् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2111228, "chapter_id": 3407, "verse_number": "१०", "content_sanskrit": "विहगैर्नादितं पुष्पैरलङ्कृतमतीव च ।\nसर्वर्तुकुसुमैर्वृक्षैः सुखच्छायैः समावृतम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2111229, "chapter_id": 3407, "verse_number": "११", "content_sanskrit": "मनोरमं सहेष्वासो विवेश वनमुत्तमम् ।\nमारुताकलितास्तत्र द्रुमाः कुसुमशाखिनः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2111230, "chapter_id": 3407, "verse_number": "१२", "content_sanskrit": "पुष्पवृष्टिं विचित्रां तु व्यसृजंस्ते पुनःपुनः ।\nदिवस्पृशोऽथ सङ्घुष्टाः पक्षिभिर्मधुरस्वनैः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2111231, "chapter_id": 3407, "verse_number": "१३", "content_sanskrit": "विरेजुः पादपास्तत्र विचित्रकुसुमाम्बराः ।\nतेषां तत्र प्रवालेषु पुष्पभारावनामिषु\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2111232, "chapter_id": 3407, "verse_number": "१४", "content_sanskrit": "रुवन्ति रावान् मधुरान् षट्पदा मधुलिप्सवः ।\nतत्र प्रदेशांश्च बहून् कुसुमोत्करमण्डितात् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2111233, "chapter_id": 3407, "verse_number": "१५", "content_sanskrit": "लतागृहपरिक्षिप्तान् मनसः प्रीतिवर्धनान् ।\nसम्पश्यन् सुमहातेजा बभूव मुदितस्तदा \t॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2111234, "chapter_id": 3407, "verse_number": "१६", "content_sanskrit": "परस्पराश्लिष्टशाखैः पादपैः कुसुमान्वितैः ।\nअशोभत वनं तत् तु महेन्द्रध्वजसन्निभैः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2111235, "chapter_id": 3407, "verse_number": "१७", "content_sanskrit": "सिद्धचारणसङ्घैश्च गन्धर्वाप्सरसां गणैः ।\nसेवितं वनमत्यर्थं मत्तवानरकिन्नरैः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2111236, "chapter_id": 3407, "verse_number": "१८", "content_sanskrit": "सुखः शीतः सुगन्धी च पुष्परेणुवहोऽनिलः ।\nपरिक्रामन् वने वृक्षानुपैतीव रिरंसया \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2111237, "chapter_id": 3407, "verse_number": "१९", "content_sanskrit": "एवंगुणसमायुक्तं ददर्श स वनं नृपः ।\nनदीकच्छोद्भवं कान्तमुच्छ्रितध्वजसन्निभम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2111238, "chapter_id": 3407, "verse_number": "२०", "content_sanskrit": "प्रेक्षमाणो वनं तत् तु सुप्रहृष्टविहङ्गमम् ।\nआश्रमप्रवरं रम्यं ददर्श च मनोरमम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2111239, "chapter_id": 3407, "verse_number": "२१", "content_sanskrit": "नानावृक्षसमाकीर्णं सम्प्रज्वलितपावकम् ।\nतं तदाऽप्रतिमं श्रीमानाश्रमं प्रत्यपूजयत् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2111240, "chapter_id": 3407, "verse_number": "२२", "content_sanskrit": "यतिभिर्वालखिल्यैश्च वृतं मुनिगणान्वितम् ।\nअग्न्यगारैश्च बहुभिः पुष्पसंस्तरसंस्तृतम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2111241, "chapter_id": 3407, "verse_number": "२३", "content_sanskrit": "महाकच्छैर्बृहद्भिश्च विभ्राजितमतीव च ।\nमालिनीमभितो राजन् नदीं पुण्यां सुखोदकाम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2111242, "chapter_id": 3407, "verse_number": "२४", "content_sanskrit": "नैकपक्षिगणाकीर्णां तपोवनमनोरमाम् ।\nतत्र व्यालमृगान् सौम्यान् पश्यन् प्रीतिमवाप सः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2111243, "chapter_id": 3407, "verse_number": "२५", "content_sanskrit": "तं चाप्रतिरथः श्रीमानाश्रमं प्रत्यपद्यत ।\nदेवलोकप्रतीकाशं सर्वतः सुमनोहरम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2111244, "chapter_id": 3407, "verse_number": "२६", "content_sanskrit": "नदीं चाश्रमसंश्लिष्टां पुण्यतोयां ददर्श सः ।\nसर्वप्राणभृतां तत्र जननीमिव धिष्ठिताम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2111245, "chapter_id": 3407, "verse_number": "२७", "content_sanskrit": "सचक्रवाकपुलिनां पुष्पफेनप्रवाहिनीम् ।\nसकिन्नरगणावासां वानरर्क्षनिषेविताम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2111246, "chapter_id": 3407, "verse_number": "२८", "content_sanskrit": "पुण्यस्वाध्यायसङ्घुष्टां पुलिनैरुपशोभिताम् ।\nमत्तवारणशार्दूलभुजगेन्द्रनिषेविताम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2111247, "chapter_id": 3407, "verse_number": "२९", "content_sanskrit": "तस्यास्तीरे भगवतः काश्यपस्य महात्मनः ।\nआश्रमप्रवरं रम्यं महर्षिगणसेवितम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2111248, "chapter_id": 3407, "verse_number": "३०", "content_sanskrit": "नदीमाश्रमसम्बद्धां दृष्ट्वाऽऽश्रमपदं तथा ।\nचकाराभिप्रवेशाय मतिं स नृपतिस्तदा \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2111249, "chapter_id": 3407, "verse_number": "३१", "content_sanskrit": "अलङ्कृतं द्वीपवत्या मालिन्या रम्यतीरया ।\nनरनारायणस्थानं गङ्गयेवोपशोभितम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2111250, "chapter_id": 3407, "verse_number": "३२", "content_sanskrit": "मत्तबर्हिणसङ्घुष्टं प्रविवेश तदाश्रमम् ।\nतत्र चैत्ररथप्रख्यं समुपेत्य नरर्षभः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2111251, "chapter_id": 3407, "verse_number": "३३", "content_sanskrit": "अतीव गुणसम्पन्नमनिर्देश्यं च वर्चसा ।\nमहर्षिं काश्यपं द्रष्टुमथ कण्वं तपोधनम् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2111252, "chapter_id": 3407, "verse_number": "४४", "content_sanskrit": "ध्वजिनीमश्वसम्बाधां पदातिगजसङ्कुलाम् ।\nअवस्थाप्य वनद्वारि सेनामिदमुवाच सः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2111253, "chapter_id": 3407, "verse_number": "५५", "content_sanskrit": "मुनिं विरजसं द्रष्टुं गमिष्यामि तपोधनम् ।\nकाश्यपं स्थीयतामत्र यावदागमनं मम \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2111254, "chapter_id": 3407, "verse_number": "६६", "content_sanskrit": "तद्वनं नन्दनप्रख्यमासाद्य मनुजेश्वरः ।\nक्षुत्पिपासे जहौ राजा मुदं चावाप पुष्कलाम् \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2111255, "chapter_id": 3407, "verse_number": "३७", "content_sanskrit": "सामात्यो राजलिङ्गानि सोपनीय नराधिपः ।\nपुरोहितसहायश्च जगामाश्रममुत्तमम् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2111256, "chapter_id": 3407, "verse_number": "३८", "content_sanskrit": "दिदृक्षुस्तत्र तमृषिं तपोराशिमथाव्ययम् ।\nब्रह्मलोकप्रतीकाशमाश्रमं सोऽभिवीक्ष्य ह \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2111257, "chapter_id": 3407, "verse_number": "३९", "content_sanskrit": "षट्पदोद्गीतसङ्घुष्टं नानाद्विजगणायुतम् ।\nविस्मयोत्फुल्लनयनो राजा प्रीतो बभूव ह \t॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2111258, "chapter_id": 3407, "verse_number": "४०", "content_sanskrit": "ऋचो बह्वृचमुख्यैश्च प्रेर्यमाणाः पदक्रमैः ।\nशुश्राव मनुजव्याघ्रो विततेष्विह कर्मसु \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2111259, "chapter_id": 3407, "verse_number": "४१", "content_sanskrit": "यज्ञविद्याङ्गविद्भिश्च यजुर्विद्भिश्च शोभितम् ।\nमधुरैः सामगीतैश्च तच्छिरोभिश्च शोभितम् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2111260, "chapter_id": 3407, "verse_number": "४२", "content_sanskrit": "भारुण्डसामगीताभिस्तच्छिरोभिरथोद्गतैः ।\nयतात्मभिः सुनियतैः शुशुभे स तदाश्रमः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2111261, "chapter_id": 3407, "verse_number": "४३", "content_sanskrit": "अथर्ववेदप्रवराः पूगयज्ञियसामगाः ।\nसंहितामीरयन्ति स्म पदक्रमयुतां तु ते\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2111262, "chapter_id": 3407, "verse_number": "४४", "content_sanskrit": "शब्दसंस्कारसंयुक्तैर्ब्रुवद्भिश्चापरैर्द्विजैः ।\nयज्ञसंस्कारविद्भिश्च क्रमशिक्षाविशारदैः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2111263, "chapter_id": 3407, "verse_number": "४५", "content_sanskrit": "द्रव्यकर्मगुणज्ञैश्च कार्यकारणवेदिभिः ।\nन्यायतत्त्वार्थविज्ञानसम्पन्नैर्वेदपारगैः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2111264, "chapter_id": 3407, "verse_number": "४६", "content_sanskrit": "नानावाक्यसमाहारतत्वज्ञानविशारदैः ।\nवैशेषिकार्थविद्भिश्च मोक्षधर्मविशारदैः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2111265, "chapter_id": 3407, "verse_number": "४७", "content_sanskrit": "स्थापनाक्षेपसिद्धान्तपरमार्थज्ञतां गतैः ।\nशब्दच्छन्दोनिरुक्तज्ञैः कालज्ञानविशारदैः \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2111266, "chapter_id": 3407, "verse_number": "४८", "content_sanskrit": "जल्पवादवितण्डज्ञैर्व्यासग्रन्थसमाश्रितैः ।\nनानाशास्त्रेषु मुख्यैश्च शुश्राव स्वनमीरितम् \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2111267, "chapter_id": 3407, "verse_number": "४९", "content_sanskrit": "लोकायतिकमुख्यैश्च समन्तादभिनादितम् ।\nतत्र तत्र च विप्रेन्द्रान् नियतान् संशितव्रतान् \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2111268, "chapter_id": 3407, "verse_number": "५०", "content_sanskrit": "जपहोमरतान् सिद्धान् ददर्श परवीरहा ।\nआसनानि पवित्राणि पुष्पवन्ति महीपतिः \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2111269, "chapter_id": 3407, "verse_number": "५१", "content_sanskrit": "प्रयत्नोपहितानि स्म दृष्ट्वा विस्मयमागमत् ।\nदेवतायतनानां च प्रेक्ष्य पूजां कृतां द्विजैः \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2111270, "chapter_id": 3407, "verse_number": "५२", "content_sanskrit": "ब्रह्मलोकस्थमात्मानं मेने स नृपसत्तमः\nतं काश्यपतपोगुप्तमाश्रमप्रवरं शुभम् ।\nनातृप्यत् प्रेक्षमाणो वै तपोवनगुणैर्युतम् \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2111271, "chapter_id": 3407, "verse_number": "५३", "content_sanskrit": "स काश्यपस्यायतनं महाव्रतै-\nर्वृतं समान्तादृषिभिस्तपोधनैः ।\nविवेश सामात्यपुरोहितोऽरिहा\nविविक्तमत्यर्थमनोहरं शिवम् \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2111272, "chapter_id": 3407, "verse_number": "८६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nषडशीतितमोऽध्यायः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2111273, "chapter_id": 3407, "verse_number": "२४", "content_sanskrit": "॥ सम्भवपर्वणि चतुस्त्रिंशोऽध्यायः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2111274, "chapter_id": 3407, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]