[{"id": 2012251, "chapter_id": 1250, "verse_number": "१-२५१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2012252, "chapter_id": 1250, "verse_number": "१-२५१-१", "content_sanskrit": "एवमुक्तः स भगवान्धूमकेतुर्हुताशनः।\nचिन्तयामास वरुणं लोकपालं दिदृक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2012253, "chapter_id": 1250, "verse_number": "१-२५१-२", "content_sanskrit": "आदित्यमुदके देवं निवसन्तं जलेश्वरम्।\nस च तच्चिन्तितं ज्ञात्वा दर्शयामास पावकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2012254, "chapter_id": 1250, "verse_number": "१-२५१-३", "content_sanskrit": "तमब्रवीद्भमकेतुः प्रतिगृह्य जलेश्वरम्।\nचतुर्थं लोकपालानां देवदेवं सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2012255, "chapter_id": 1250, "verse_number": "१-२५१-४", "content_sanskrit": "सोमेन राज्ञा यद्दत्तं धनुश्चैवेषुधी च ते।\nतत्प्रयच्छोभयं शीघ्रं रथं च कपिलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2012256, "chapter_id": 1250, "verse_number": "१-२५१-५", "content_sanskrit": "कार्यं च सुमहत्पार्थो गाण्डीवेन करिष्यति।\nचक्रेण वासुदेवश्च तन्ममाद्य प्रदीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2012257, "chapter_id": 1250, "verse_number": "१-२५१-६", "content_sanskrit": "ददानीत्येव वरुणः पावकं प्रत्यभाषत।\nतदद्भुतं महावीर्यं यशःकीर्तिविवर्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2012258, "chapter_id": 1250, "verse_number": "१-२५१-७", "content_sanskrit": "सर्वशस्त्रैरनाधृष्यं सर्वशस्त्रप्रमाथि च।\nसर्वायुधमहामात्रं परसैन्यप्रधर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2012259, "chapter_id": 1250, "verse_number": "१-२५१-८", "content_sanskrit": "एकं शतसहस्रेण संमितं राष्ट्रवर्धनम्।\nचित्रमुच्चावचैर्वर्णैः शोभितं श्लक्ष्णमव्रणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2012260, "chapter_id": 1250, "verse_number": "१-२५१-९", "content_sanskrit": "देवदानवगन्धर्वैः पूजितं शाश्वतीः समाः।\nप्रादाच्चैव धनूरत्नमक्षय्यौ च महेषुधी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2012261, "chapter_id": 1250, "verse_number": "१-२५१-१०", "content_sanskrit": "रथं च दिव्याश्वयुजं कपिप्रवरकेतनम्।\nउपेतं राजतैरश्वैर्गान्धर्वैर्हेममालिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2012262, "chapter_id": 1250, "verse_number": "१-२५१-११", "content_sanskrit": "पाण्डुराभ्रप्रतीकाशैर्मनोवायुसमैर्जवे।\nसर्वोपकरणैर्युक्तमजय्यं देवदानवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2012263, "chapter_id": 1250, "verse_number": "१-२५१-१२", "content_sanskrit": "भावुमन्तं महाघोषं सर्वरत्नमनोरमम्।\nससर्ज यं सुतपसा भौमनो भुवनप्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2012264, "chapter_id": 1250, "verse_number": "१-२५१-१३", "content_sanskrit": "प्रजापतिरनिर्देश्यं यस्य रूपं रवेरिव।\nयं स्म सोमः समारुह्य दानवानजयत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2012265, "chapter_id": 1250, "verse_number": "१-२५१-१४", "content_sanskrit": "नवमेघप्रतीकाशं ज्ललन्तमिव च श्रिया।\nआश्रितौ तं रथश्रेष्ठं शक्रायुधसमावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2012266, "chapter_id": 1250, "verse_number": "१-२५१-१५", "content_sanskrit": "तापनीया सुरुचिरा ध्वजयष्टिरनुत्तमा।\nतस्यां तु वानरो दिव्यः सिंहशार्दूलकेतनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2012267, "chapter_id": 1250, "verse_number": "१-२५१-१६", "content_sanskrit": "हनूमान्नाम तेजस्वी कामरूपी महाबलः।\nदिधक्षन्निव तत्र स्म संस्थितो मूर्ध्न्यशोभत।\nध्वजे भूतानि तत्रासन्विविधानि महान्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2012268, "chapter_id": 1250, "verse_number": "१-२५१-१७", "content_sanskrit": "नादेन रिपुसैन्यानां येषां संज्ञा प्रणश्यति।\nस तं नानापताकाभिः शोभितं रथसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2012269, "chapter_id": 1250, "verse_number": "१-२५१-१८", "content_sanskrit": "प्रदक्षिणमुपावृत्य दैवतेभ्यः प्रणम्य च।\nसन्नद्धः कवची खड्गी बद्धगोधाङ्गुलित्रकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2012270, "chapter_id": 1250, "verse_number": "१-२५१-१९", "content_sanskrit": "आरुरोह तदा पार्थो विमानं सुकृती यथा।\nतच्च दिव्यं धनुः श्रेष्ठं ब्रह्मणा निर्मितं पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2012271, "chapter_id": 1250, "verse_number": "१-२५१-२०", "content_sanskrit": "गाण्डीवमुपसंगृह्य बभूव मुदितोऽर्जुनः।\nहुताशनं पुरस्कृत्य ततस्तदपि वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2012272, "chapter_id": 1250, "verse_number": "१-२५१-२१", "content_sanskrit": "जग्राह बलमास्थाय ज्यया च युयुजे धनुः।\nमौर्व्यां तु योज्यमानायां बलिना पाण्डवेन ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2012273, "chapter_id": 1250, "verse_number": "१-२५१-२२", "content_sanskrit": "येऽशृष्वन्कूजितं यत्र तेषां वै व्यथितं मनः।\nलब्ध्वा रथं धनुश्चैव तथाऽक्षय्ये महेषुधी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2012274, "chapter_id": 1250, "verse_number": "१-२५१-२३", "content_sanskrit": "बभूव कल्यः कौन्तेयः प्रहृष्टः साह्यकर्मणि।\nवज्रनाभं ततश्चक्रं ददौ कृष्णाय पावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2012275, "chapter_id": 1250, "verse_number": "१-२५१-२४", "content_sanskrit": "आग्नेयमस्त्रं दयितं स च कल्योऽभवत्तदा।\nअब्रवीत्पावकश्चैवमेतेन मधुसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2012276, "chapter_id": 1250, "verse_number": "१-२५१-२५", "content_sanskrit": "अमानुषानपि रणे जेष्यसि त्वमसंशयम्।\nअनेन तु मनुष्याणां देवानामपि चाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2012277, "chapter_id": 1250, "verse_number": "१-२५१-२६", "content_sanskrit": "रक्षःपिशाचदैत्यानां नागानां चाधिकस्तथा।\nभविष्यसि न सन्देहः प्रवरोऽपि निबर्हणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2012278, "chapter_id": 1250, "verse_number": "१-२५१-२७", "content_sanskrit": "क्षिप्तं क्षिप्तं रणे चैतत्त्वया माधव शत्रुषु।\nहत्वाऽप्रतिहतं सङ्ख्ये पाणिमेष्यति ते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2012279, "chapter_id": 1250, "verse_number": "१-२५१-२८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2012280, "chapter_id": 1250, "verse_number": "१-२५१-२८", "content_sanskrit": "वरुणश्च ददौ तस्मै गदामशनिनिःस्वनाम्।\nदैत्यान्तकरणीं घोरां नाम्ना कौमोदकीं प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2012281, "chapter_id": 1250, "verse_number": "१-२५१-२९", "content_sanskrit": "ततः पावकमब्रूतां प्रहृष्टावर्जुनाच्युतौ।\nकृतास्त्रौ शस्त्रसंपन्नौ रथिनौ ध्वजिनावपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2012282, "chapter_id": 1250, "verse_number": "१-२५१-३०", "content_sanskrit": "कल्यौ स्वो भगवन्योद्धुमपि सर्वैः सुरासुरैः।\nकिं पुनर्वज्रिणैकेन पन्नगार्थे युयुत्सता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2012283, "chapter_id": 1250, "verse_number": "१-२५१-३१x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2012284, "chapter_id": 1250, "verse_number": "१-२५१-३१", "content_sanskrit": "चक्रपाणिर्हृषीकेशो विचरन्युधि वीर्यवान्।\nचक्रेण भस्मसात्सर्वं विसृष्टेन तु वीर्यवान्।\nत्रिषु लोकेषु तन्नास्ति यन्न कुर्याज्जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2012285, "chapter_id": 1250, "verse_number": "१-२५१-३२", "content_sanskrit": "गाण्डीवं धनुरादाय तथाऽक्षय्ये महेषुधी।\nअहमप्युत्सहे लोकान्विजेतुं युधि पावक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2012286, "chapter_id": 1250, "verse_number": "१-२५१-३३", "content_sanskrit": "सर्वतः परिवार्यैवं दावमेतं महाप्रभो।\nकामं संप्रज्वलाद्यैव कल्यौ स्वः साह्यकर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2012287, "chapter_id": 1250, "verse_number": "१-२५१-३४", "content_sanskrit": "यदि खाण्डवमेष्यति प्रमादा-\nत्सगणो वा परिरक्षितुं महेन्द्रः।\nशरताडितगात्रकुण्डलानां\nकदनं द्रक्ष्यति देववाहिनीनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2012288, "chapter_id": 1250, "verse_number": "१-२५१-३५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2012289, "chapter_id": 1250, "verse_number": "१-२५१-३५", "content_sanskrit": "एवमुक्तः स भगवान्दाशार्हेणार्जुनेन च।\nतैजसं रपमास्थाय दावं दग्धुं प्रचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2012290, "chapter_id": 1250, "verse_number": "१-२५१-३६", "content_sanskrit": "सर्वतः परिवार्याथ सप्तार्चिर्ज्वलनस्तथा।\nददाह खाण्डवं दावं युगान्तमिव दर्शयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2012291, "chapter_id": 1250, "verse_number": "१-२५१-३७", "content_sanskrit": "प्रतिगृह्य समाविश्य तद्वनं भरतर्षभ।\nमेघस्तनितनिर्घोषः सर्वभूतान्यकम्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2012292, "chapter_id": 1250, "verse_number": "१-२५१-३८", "content_sanskrit": "दह्यतस्तस्य च बभौ रूपं दावस्य भारत।\nमेरोरिव नगेन्द्रस्य कीर्णस्यांशुमतोंशुभिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2012293, "chapter_id": 1250, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि खाण्डवदाहपर्वणि एकपञ्चाशदधिकद्विशततमोऽध्यायः॥ २५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]