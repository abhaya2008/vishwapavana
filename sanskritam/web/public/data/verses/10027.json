[{"id": 6000027000, "chapter_id": 10027, "verse_number": null, "content_sanskrit": "अथ सप्तमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000027001, "chapter_id": 10027, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.001.m4a", "display_order": 2}, {"id": 6000027002, "chapter_id": 10027, "verse_number": "२-७-१", "content_sanskrit": "यत्रोद्गतः क्षितितलोद्धरणाय बिभ्रत् क्रौडीं तनुं सकलयज्ञमयीमनन्तः।\nअन्तर्महार्णव उपागतमादिदैत्यं तं दंष्ट्रयाऽद्रिमिव वज्रधरो ददार॥ २/७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.002.m4a", "display_order": 3, "topics": [{"text": "ब्रह्मणा नारदं प्रति संक्षेपेण भगवतो वराहादिनानावतारचरित्रकथनम्", "range": "१–३८"}]}, {"id": 6000027003, "chapter_id": 10027, "verse_number": "२-७-२", "content_sanskrit": "जातो रुचेरजनयत्सुयशाः सुयज्ञ आकूतिसूनुरमरान् अथ दक्षिणायाम्।\nलोकत्रयस्य महतीमहरद्य आर्तिं स्वायम्भुवेन मनुना हरिरित्यनूक्तः॥ २/७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.003.m4a", "display_order": 4}, {"id": 6000027004, "chapter_id": 10027, "verse_number": "२-७-३", "content_sanskrit": "जज्ञे च कर्दमगृहे द्विज देवहूत्यां स्‍त्रीभिः समं नवभिरात्मगतिं स्वमात्रे।\nऊचे य आत्मशमलं गुणसङ्गपङ्कम् अस्मिन्विधूय कपिलः स्वगतिं प्रपेदे॥ २/७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.004.m4a", "display_order": 5}, {"id": 6000027005, "chapter_id": 10027, "verse_number": "२-७-४", "content_sanskrit": "अत्रेरपत्यमभिकाङ्क्षत आह तुष्टो दत्तो मयाऽहमिति यद्भगवान्स दत्तः।\nयत्पादपङ्कजपरागपवित्रदेहा योगर्ध्दिमापुरमयीं यदुहैहयाद्याः॥ २/७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.005.m4a", "display_order": 6}, {"id": 6000027006, "chapter_id": 10027, "verse_number": "२-७-५", "content_sanskrit": "तप्तं तपो विविधलोकसिसृक्षया म आदौ सनात्सुतपसस्तपतः स नोऽभूत्।\nप्राक्‍कल्पसम्प्लवविनष्टमिहात्मतत्त्वं सम्यग्जगाद मुनयो यदचक्षतात्मन्॥ २/७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.006.m4a", "display_order": 7}, {"id": 6000027007, "chapter_id": 10027, "verse_number": "२-७-६", "content_sanskrit": "धर्मस्य दक्षदुहितर्यजनि स्वमूर्त्या नारायणो नर इति स्वतपःप्रभावः।\nदृष्टात्मनो भगवतो नियमावलोपं देव्यस्त्वनङ्गपृतना घटितुं न शेकुः॥ २/७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.007.m4a", "display_order": 8}, {"id": 6000027008, "chapter_id": 10027, "verse_number": "२-७-७", "content_sanskrit": "कामं दहन्ति कृतिनो ननु रोषदृष्ट्या रोषं दहन्तमुत ते न दहन्त्यसह्यम्।\nसोऽयं यदन्तरमलं निविशन्बिभेति कामः कथं नु पुनरस्य मनः श्रयेत॥ २/७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.008.m4a", "display_order": 9}, {"id": 6000027009, "chapter_id": 10027, "verse_number": "२-७-८", "content_sanskrit": "विद्धः सपत्न्युदितपत्रिभिरन्ति राज्ञो बालोऽपि सन्नपगतस्तपसे वनाय।\nतस्मा अदाद् ध्रुवगतिं गृणते प्रसन्नो दिव्याः स्तुवन्ति मुनयो यदुपर्यधस्तात्॥ २/७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.009.m4a", "display_order": 10}, {"id": 6000027010, "chapter_id": 10027, "verse_number": "२-७-९", "content_sanskrit": "यद्वेनमुत्पथगतं द्विजवाक्यवज्रनिष्पिष्टपौरुषभगं निरये पतन्तम्।\nज्ञात्वार्थितो जगति पुत्रपदं च लेभे दुग्धा वसूनि वसुधा सकलानि येन॥ २/७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.010.m4a", "display_order": 11}, {"id": 6000027011, "chapter_id": 10027, "verse_number": "२-७-१०", "content_sanskrit": "नाभेरसावृषभ आस सुदेविसूनुः यो वै चचार समदृग् हृदि योगचर्याम्।\nयत्पारमहंस्यमृषयः पदमामनन्ति स्वस्थः प्रशान्तकरणः परिमुक्तसङ्गः॥ २/७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.011.m4a", "display_order": 12}, {"id": 6000027012, "chapter_id": 10027, "verse_number": "२-७-११", "content_sanskrit": "सत्रे ममाऽस भगवान्हयशीर्ष एष साक्षात्स यज्ञपुरुषस्तपनीयवर्णः।\nछन्दोमयो मखमयोऽखिलदेवतात्मा वाचो बभूवुरुशतीः श्वसतोऽस्य नस्तः॥ २/७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.012.m4a", "display_order": 13}, {"id": 6000027013, "chapter_id": 10027, "verse_number": "२-७-१२", "content_sanskrit": "मत्स्यो युगान्तसमये मनुनोपलब्धः क्षोणीमयो निखिलजीवनिकायकेतः।\nविस्रंसितानुरुभये सलिले मुखान्मे आदाय तत्र विजहार ह वेदमार्गान्॥ २/७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.013.m4a", "display_order": 14}, {"id": 6000027014, "chapter_id": 10027, "verse_number": "२-७-१३", "content_sanskrit": "क्षीरोदधावमरदानवयूथपानाम् उन्मथ्नताममृतलब्धय आदिदेवः।\nपृष्ठेन कच्छपवपुर्विदधार गोत्रं निद्रेक्षणोऽद्रिपरिवर्तकषाणकण्डुः॥ २/७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.014.m4a", "display_order": 15}, {"id": 6000027015, "chapter_id": 10027, "verse_number": "२-७-१४", "content_sanskrit": "त्रैविष्टपोरुभयहारिनृसिंहरूपं कृत्वा भ्रमद्भ्रुकुटिदंष्ट्रकरालवक्त्रम्।\nदैत्येन्द्रमाशु गदयाऽभिपतन्तमारात् ऊरौ निपात्य विददार नखैः स्फुरन्तम्॥ २/७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.015.m4a", "display_order": 16}, {"id": 6000027016, "chapter_id": 10027, "verse_number": "२-७-१५", "content_sanskrit": "अन्तः सरस्युरुबलेन पदे गृहीतो ग्राहेण यूथपतिरम्बुजहस्त आर्तः।\nआहेदमादिपुरुषाखिललोकनाथ तीर्थश्रवः श्रवणमङ्गलनामधेय॥ २/७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.016.m4a", "display_order": 17}, {"id": 6000027017, "chapter_id": 10027, "verse_number": "२-७-१६", "content_sanskrit": "स्मृत्वा हरिस्तमरणार्थिनमप्रमेयः चक्रायुधः पतगराजभुजाधिरूढः।\nचक्रेण नक्रवदनं विनिपाट्य तस्माद् हस्ते प्रगृह्य भगवान्कृपयोज्जहार॥ २/७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.017.m4a", "display_order": 18}, {"id": 6000027018, "chapter_id": 10027, "verse_number": "२-७-१७", "content_sanskrit": "ज्यायान्गुणैरवरजोऽप्यदितेः सुतानां लोकान्विचक्रम इमान्यदथोऽधियज्ञः।\nक्ष्मां वामनेन जगृहे त्रिपदच्छलेन याञ्चामृते पथि चरन्प्रभुभिर्न चाल्यः॥ २/७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.018.m4a", "display_order": 19}, {"id": 6000027019, "chapter_id": 10027, "verse_number": "२-७-१८", "content_sanskrit": "नार्थो बलेरयमुरुक्रमपादशौचम् अम्भः शिवं धृतवतो विबुधाधिपत्यम्।\nयो वै प्रतिश्रुतमृतेऽपि च शीर्षमाणम् आत्मन्यमङ्ग मनसा हरयेऽभिमेने॥ २/७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.019.m4a", "display_order": 20}, {"id": 6000027020, "chapter_id": 10027, "verse_number": "२-७-१९", "content_sanskrit": "तुभ्यं च नारद भृशं भगवान्विवृद्धभावेन साधु परितुष्ट उवाच योगम्।\nज्ञानं च भागवतमात्मसुतत्त्वदीपं यद्वासुदेवशरणा विदुरञ्जसैव॥ २/७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.020.m4a", "display_order": 21}, {"id": 6000027021, "chapter_id": 10027, "verse_number": "२-७-२०", "content_sanskrit": "चक्रं च दिक्ष्वविहतं दशसु स्वतेजो मन्वन्तरेषु मनुवंशधरो बिभर्ति।\nदुष्टेषु राजसु दमं विदधत्स्वकीर्तिं सत्ये निविष्ट उशतीं प्रथयंश्चरित्रैः॥ २/७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.021.m4a", "display_order": 22}, {"id": 6000027022, "chapter_id": 10027, "verse_number": "२-७-२१", "content_sanskrit": "धन्वन्तरिश्च भगवान्स्वयमास देवो नाम्ना नृणां पुरुरुजां रुज आशु हन्ति।\nयज्ञे च भागममृतायुरवाप चाद्धा आयुश्च वेदमनुशास्त्यवतीर्य लोके॥ २/७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.022.m4a", "display_order": 23}, {"id": 6000027023, "chapter_id": 10027, "verse_number": "२-७-२२", "content_sanskrit": "क्षत्रं क्षयाय विधिनोपहृतं महात्मा ब्रह्मध्रुगुज्झितपथं नरकार्तिलिप्सु।\nउद्धन्त्यसाववनिकण्टकमुग्रवीर्यः त्रिःसप्तकृत्व उरुधारपरश्वधेन॥ २/७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.023.m4a", "display_order": 24}, {"id": 6000027024, "chapter_id": 10027, "verse_number": "२-७-२३", "content_sanskrit": "कृत्स्नप्रसादसुमुखः कलया कलेशः इक्ष्वाकुवंश अवतीर्य गुरोर्निदेशे।\nतिष्ठन्वनं सदयितानुज आविवेश यस्मिन्विरुध्य दशकन्धर आर्तिमार्च्छत्॥ २/७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.024.m4a", "display_order": 25}, {"id": 6000027025, "chapter_id": 10027, "verse_number": "२-७-२४", "content_sanskrit": "यस्मा अदादुदधिरूढभयाङ्गवेपो मार्गं सपद्यरिपुरं हरवद्दिधक्षोः।\nदूरे सुहृन्मथितरोषसुशोषदृष्ट्या तातप्यमानमकरोरगनक्रचक्रः॥ २/७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.025.m4a", "display_order": 26}, {"id": 6000027026, "chapter_id": 10027, "verse_number": "२-७-२५", "content_sanskrit": "वक्षःस्थलस्पर्शरुग्णमहेन्द्रवाहदन्तैर्विलम्बितककुब्जयरूढहासः।\nसद्योऽसुभिः सह विनेष्यति दारहर्तुर्विस्फूर्जितैर्धनुष उच्चरितैः ससैन्यः॥ २/७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.026.m4a", "display_order": 27}, {"id": 6000027027, "chapter_id": 10027, "verse_number": "२-७-२६", "content_sanskrit": "भूमेः सुरेतरवरूथविमर्दितायाः क्लेशव्ययाय कलया सितकृष्णकेशः।\nजातः करिष्यति जनानुपलक्ष्यमार्गः कर्माणि चात्ममहिमोपनिबन्धनानि॥ २/७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.027.m4a", "display_order": 28}, {"id": 6000027028, "chapter_id": 10027, "verse_number": "२-७-२७", "content_sanskrit": "तोकेन जीवहरणं यदुलूपिकायाः त्रैमासिकस्य च पदा शकटोऽपवृत्तः।\nयद्रङ्गताऽन्तरगतेन दिवि स्पृशोर्वा उन्मूलनन्त्वितरथाऽर्जुनयोर्न भाव्यम्॥ २/७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.028.m4a", "display_order": 29}, {"id": 6000027029, "chapter_id": 10027, "verse_number": "२-७-२८", "content_sanskrit": "यद्वै व्रजे व्रजपशून् विषतोयपीतान् गोपांस्तु जीवयदनुग्रहदृष्टिवृष्ट्या।\nतच्छुद्धयेऽतिविषवीर्यविलोलजिह्वमुच्चाटयिष्यदुरगं व्यहरद् ह्रदिन्याम्॥ २/७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.029.m4a", "display_order": 30}, {"id": 6000027030, "chapter_id": 10027, "verse_number": "२-७-२९", "content_sanskrit": "तत्कर्म दिव्यमिव यन्निशि निःशयानं दावाग्निनाऽशु विपिने परिदह्यमाने।\nउन्नेष्यति व्रजमितोऽवसितान्तकालं नेत्रे पिधाय्य सबलोऽनधिगम्यवीर्यः॥ २/७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.030.m4a", "display_order": 31}, {"id": 6000027031, "chapter_id": 10027, "verse_number": "२-७-३०", "content_sanskrit": "गृह्णीत यद्यदुपबद्धुममुष्य माता शुल्बं सुतस्य न तु तत्तदमुष्य माति।\nयज्जृम्भतोऽस्य वदने भुवनानि गोपी संवीक्ष्य शङ्कितमनाः प्रतिबोधितस्य॥ २/७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.031.m4a", "display_order": 32}, {"id": 6000027032, "chapter_id": 10027, "verse_number": "२-७-३१", "content_sanskrit": "नन्दं च मोक्ष्यति भयाद्वरुणस्य पाशाद् गोपान्बिलेषु पिहितान्मयसूनुना च।\nजल्प्यावृतं निशि शयानमतिश्रमेण लोके विकुण्ठ उपधास्यति गोकुलं स्म॥ २/७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.032.m4a", "display_order": 33}, {"id": 6000027033, "chapter_id": 10027, "verse_number": "२-७-३२", "content_sanskrit": "गोपैर्मखे प्रतिहते व्रजविप्लवाय देवेऽभिवर्षति पशून् कृपया रिरक्षुः।\nधर्तोच्छिलीन्ध्रमिव सप्त दिनानि सप्तवर्षो महीध्रमनघैककरे सलीलम्॥ २/७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.033.m4a", "display_order": 34}, {"id": 6000027034, "chapter_id": 10027, "verse_number": "२-७-३३", "content_sanskrit": "क्रीडन् वने निशि निशाकररश्मिगौर्यां रासोन्मुखः कलपदायतमूर्च्छितेन।\nउद्दीपितस्मररुजां व्रजसद्वधूनां हर्तुर्हरिष्यति शिरो धनदानुगस्य॥ २/७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.034.m4a", "display_order": 35}, {"id": 6000027035, "chapter_id": 10027, "verse_number": "२-७-३४", "content_sanskrit": "ये च प्रलम्बखरदर्दुरकेश्यरिष्टमल्‍लेभकंसयवनाः कुजपौण्ड्रकाद्याः।\nअन्येऽपि शाल्वकपिबल्वलदन्तवक्रसप्तोक्षशम्बरविडूरथरुग्मिमुख्याः॥ २/७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.035.m4a", "display_order": 36}, {"id": 6000027036, "chapter_id": 10027, "verse_number": "२-७-३५", "content_sanskrit": "ये वा मृधे समितिशालिन आत्तचापाः काम्भोजमत्स्यकुरुसृञ्जयकैकयाद्याः।\nयास्यन्त्यदर्शनमिता बलपार्थभीमव्याजाह्वयेन हरिणा निलयं तदीयम्॥ २/७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.036.m4a", "display_order": 37}, {"id": 6000027037, "chapter_id": 10027, "verse_number": "२-७-३६", "content_sanskrit": "कालेन मीलितदृशामवमृश्य नॄणां स्तोकायुषां स्वनिगमो बत दूरपारः।\nआविर्हितस्त्वनुयुगं स हि सत्यवत्यां वेदद्रुमं विटपशो विभजिष्यति स्म॥ २/७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.037.m4a", "display_order": 38}, {"id": 6000027038, "chapter_id": 10027, "verse_number": "२-७-३७", "content_sanskrit": "देवद्विषां निगमवर्त्मनि विष्ठितानां पूर्भिर्मयेन विहिताभिरदृश्यमूर्तिः।\nलोकान् घ्नतां मतिविमोहमतिप्रलोभं वेषं विधाय यदभाषत औपधर्म्यम्॥ २/७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.038.m4a", "display_order": 39}, {"id": 6000027039, "chapter_id": 10027, "verse_number": "२-७-३८", "content_sanskrit": "यर्ह्यालयेष्वपि सतां न कथा हरेः स्युः पाषण्डिनो द्विजजना वृषला नृदेवाः।\nस्वाहा स्वधा वषडिति स्म गिरो न यत्र शास्ता भविष्यति कलेर्भगवान्युगान्ते॥ २/७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.039.m4a", "display_order": 40}, {"id": 6000027040, "chapter_id": 10027, "verse_number": "२-७-३९", "content_sanskrit": "सर्गे तु योऽहमृषयो नव ये प्रजेशाः स्थानेऽथ धर्ममखमन्वमरावनीशाः।\nअन्ते त्वधर्महरमन्युवशासुराद्याः मायाविभूतय इमाः पुरुशक्तिभाजः॥ २/७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.040.m4a", "display_order": 41, "topics": [{"text": "भगवच्छक्तिनिरूपणम्", "range": "३९–५५"}]}, {"id": 6000027041, "chapter_id": 10027, "verse_number": "२-७-४०", "content_sanskrit": "विष्णोर्नु वीर्यगणनां कतमोऽर्हतीह यः पार्थिवान्यपि कविर्विममे रजांसि।\nचस्कम्भ यः स्वरभसा स्खलितं त्रिपृष्ठं यन्मां निशाम्य सदनादुरुकम्पमानम्॥ २/७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.041.m4a", "display_order": 42}, {"id": 6000027042, "chapter_id": 10027, "verse_number": "२-७-४१", "content_sanskrit": "नान्तं विदाम्यहममी मुनयः प्रजेशाः मायाबलस्य पुरुषस्य कुतोऽपरे ये।\nगायन्गुणान्दशशतानन आदिदेवः शेषोऽधुनाऽपि समवस्यति नास्य पारम्॥ २/७/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.042.m4a", "display_order": 43}, {"id": 6000027043, "chapter_id": 10027, "verse_number": "२-७-४२", "content_sanskrit": "येषां स एव भगवान्दययेदनन्तः सर्वात्मनाऽऽश्रितपदो यदि निर्व्यलीकम्।\nते वै विदन्त्यतितरन्ति च देवमायां नैषां ममाहमिति धीः श्वसृगालभक्ष्ये॥ २/७/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.043.m4a", "display_order": 44}, {"id": 6000027044, "chapter_id": 10027, "verse_number": "२-७-४३", "content_sanskrit": "वेदाहमङ्ग परमस्य हि योगमायां यूयं भवश्च भगवानथ दैत्यवर्यः।\nपत्नी मनोः स च मनुस्तदपत्यभूताः प्राचीनबर्हिऋभुरङ्ग उत ध्रुवश्च॥ २/७/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.044.m4a", "display_order": 45}, {"id": 6000027045, "chapter_id": 10027, "verse_number": "२-७-४४", "content_sanskrit": "इक्ष्वाकुरैलमुचुकुन्दविदेहगाधिरघ्वम्बरीषसगरा गयनाहुषाद्याः।\nमान्धात्रलर्कशतधन्वनरन्तिदेवदेवव्रता बलिरमूर्तरयो दिलीपः॥ २/७/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.045.m4a", "display_order": 46}, {"id": 6000027046, "chapter_id": 10027, "verse_number": "२-७-४५", "content_sanskrit": "सौभर्युदङ्कशिबिदेवलपिप्पलादाः सारस्वतोद्धवपराशरभूरिषेणाः।\nयेऽन्ये विभीषणहनूमदुपेन्द्रदत्तपार्थार्ष्टिषेणविदुरश्रुतदेवमुख्याः॥ २/७/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.046.m4a", "display_order": 47}, {"id": 6000027047, "chapter_id": 10027, "verse_number": "२-७-४६", "content_sanskrit": "ते वै विदन्त्यतितरन्ति च देवमायां स्‍त्रीशूद्रहूणशबरा अपि पापजीवाः।\nयद्यद्भुतक्रमपरायणशीलशिक्षाः तिर्यग्जना अपि किमु श्रुतधारणा ये॥ २/७/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.047.m4a", "display_order": 48}, {"id": 6000027048, "chapter_id": 10027, "verse_number": "२-७-४७", "content_sanskrit": "शश्वत्प्रशान्तमभयं प्रतिबोधमात्रं शुद्धं समं सदसतः परमात्मतत्त्वम्।\nशब्दो न यत्र पुरुकारकवान्क्रियार्थो माया परैत्यभिमुखे च विलज्जमाना॥ २/७/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.048.m4a", "display_order": 49}, {"id": 6000027049, "chapter_id": 10027, "verse_number": "२-७-४८", "content_sanskrit": "तद्वै पदं भगवतः परमस्य पुंसो ब्रह्मेति यद्विदुरजस्रसुखं विशोकम्।\nसम्यङ् निशाम्य यतयो यमलोकहेतुं जह्युः सुधामिव निपानखनित्रमिन्द्रः॥ २/७/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.049.m4a", "display_order": 50}, {"id": 6000027050, "chapter_id": 10027, "verse_number": "२-७-४९", "content_sanskrit": "स श्रेयसामपि विभुर्भगवान्यतोऽस्य भावस्वभावविहितस्य सतः प्रसिद्धः।\nदेहे स्वधातुविगमे तु विशीर्यमाणे व्योमेव तत्र पुरुषो न विशीर्यतेऽजः॥ २/७/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.050.m4a", "display_order": 51}, {"id": 6000027051, "chapter_id": 10027, "verse_number": "२-७-५०", "content_sanskrit": "सोऽयं तेऽभिहितस्तात भगवान्विश्वभावनः।\nसमासेन हरेर्नान्यदन्यस्मात्सदसच्च यत्॥ २/७/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.051.m4a", "display_order": 52}, {"id": 6000027052, "chapter_id": 10027, "verse_number": "२-७-५१", "content_sanskrit": "इदं भागवतं नाम यन्मे भगवतोदितम्।\nसङ्ग्रहोऽयं विभूतीनां तदेतद्विपुलीकुरु॥ २/७/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.052.m4a", "display_order": 53}, {"id": 6000027053, "chapter_id": 10027, "verse_number": "२-७-५२", "content_sanskrit": "यथा हरौ भगवति नृणां भक्तिर्भविष्यति।\nसर्वात्मन्यखिलाधार इति सङ्कल्प्य वर्णय॥ २/७/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.053.m4a", "display_order": 54}, {"id": 6000027054, "chapter_id": 10027, "verse_number": "२-७-५३", "content_sanskrit": "नृजन्मनि न तुष्येत किम्फलं यमनश्वरे।\nकृष्णे यद्यपवर्गेशे भक्तिः स्यान्नानपायिनी॥ २/७/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.054.m4a", "display_order": 55}, {"id": 6000027055, "chapter_id": 10027, "verse_number": "२-७-५४", "content_sanskrit": "किं स्याद्वर्णाश्रमाचारैः किं दानैः किं तपःश्रुतैः।\nसर्वाघघ्नोत्तमश्लोके न चेद्भक्तिरधोक्षजे॥ २/७/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.055.m4a", "display_order": 56}, {"id": 6000027056, "chapter_id": 10027, "verse_number": "२-७-५५", "content_sanskrit": "मायां वर्णयतोऽमुष्य ईश्वरस्यानुमोदतः।\nशृृण्वतः श्रद्धया नित्यं माययाऽऽत्मा न मुह्यति॥ २/७/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_007/BhP_02.007.056.m4a", "display_order": 57}, {"id": 6000027057, "chapter_id": 10027, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां द्वितीयस्कन्धे सप्तमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]