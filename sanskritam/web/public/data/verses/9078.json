[{"id": 5000078000, "chapter_id": 9078, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे प्रथमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000078001, "chapter_id": 9078, "verse_number": "२-१-१", "content_sanskrit": "गच्छता मातुलकुलं भरतेन तदानघः।\nशत्रुघ्नो नित्यशत्रुघ्नो नीतः प्रीतिपुरस्कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000078002, "chapter_id": 9078, "verse_number": "२-१-२", "content_sanskrit": "स तत्र न्यवसद् भ्रात्रा सह सत्कारसत्कृतः।\nमातुलेनाश्वपतिना पुत्रस्नेहेन लालितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000078003, "chapter_id": 9078, "verse_number": "२-१-३", "content_sanskrit": "तत्रापि निवसन्तौ तौ तर्प्यमाणौ च कामतः।\nभ्रातरौ स्मरतां वीरौ वृद्धं दशरथं नृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000078004, "chapter_id": 9078, "verse_number": "२-१-४", "content_sanskrit": "राजापि तौ महातेजाः सस्मार प्रोषितौ सुतौ।\nउभौ भरतशत्रुघ्नौ महेन्द्रवरुणोपमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000078005, "chapter_id": 9078, "verse_number": "२-१-५", "content_sanskrit": "सर्व एव तु तस्येष्टाश्चत्वारः पुरुषर्षभाः।\nस्वशरीराद् विनिर्वृत्ताश्चत्वार इव बाहवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000078006, "chapter_id": 9078, "verse_number": "२-१-६", "content_sanskrit": "तेषामपि महातेजा रामो रतिकरः पितुः।\nस्वयम्भूरिव भूतानां बभूव गुणवत्तरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000078007, "chapter_id": 9078, "verse_number": "२-१-७", "content_sanskrit": "स हि देवैरुदीर्णस्य रावणस्य वधार्थिभिः।\nअर्थितो मानुषे लोके जज्ञे विष्णुः सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000078008, "chapter_id": 9078, "verse_number": "२-१-८", "content_sanskrit": "कौसल्या शुशुभे तेन पुत्रेणामिततेजसा।\nयथा वरेण देवानामदितिर्वज्रपाणिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000078009, "chapter_id": 9078, "verse_number": "२-१-९", "content_sanskrit": "स हि रूपोपपन्नश्च वीर्यवाननसूयकः।\nभूमावनुपमः सूनुर्गुणैर्दशरथोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000078010, "chapter_id": 9078, "verse_number": "२-१-१०", "content_sanskrit": "स च नित्यं प्रशान्तात्मा मृदुपूर्वं च भाषते।\nउच्यमानोऽपि परुषं नोत्तरं प्रतिपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000078011, "chapter_id": 9078, "verse_number": "२-१-११", "content_sanskrit": "कदाचिदुपकारेण कृतेनैकेन तुष्यति।\nन स्मरत्यपकाराणां शतमप्यात्मवत्तया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000078012, "chapter_id": 9078, "verse_number": "२-१-१२", "content_sanskrit": "शीलवृद्धैर्ज्ञानवृद्धैर्वयोवृद्धैश्च सज्जनैः।\nकथयन्नास्त वै नित्यमस्त्रयोग्यान्तरेष्वपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000078013, "chapter_id": 9078, "verse_number": "२-१-१३", "content_sanskrit": "बुद्धिमान् मधुराभाषी पूर्वभाषी प्रियंवदः।\nवीर्यवान्न च वीर्येण महता स्वेन विस्मितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000078014, "chapter_id": 9078, "verse_number": "२-१-१४", "content_sanskrit": "न चानृतकथो विद्वान् वृद्धानां प्रतिपूजकः।\nअनुरक्तः प्रजाभिश्च प्रजाश्चाप्यनुरज्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000078015, "chapter_id": 9078, "verse_number": "२-१-१५", "content_sanskrit": "सानुक्रोशो जितक्रोधो ब्राह्मणप्रतिपूजकः।\nदीनानुकम्पी धर्मज्ञो नित्यं प्रग्रहवान् शुचिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000078016, "chapter_id": 9078, "verse_number": "२-१-१६", "content_sanskrit": "कुलोचितमतिः क्षात्रं स्वधर्मं बहु मन्यते।\nमन्यते परया प्रीत्या महत् स्वर्गफलं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000078017, "chapter_id": 9078, "verse_number": "२-१-१७", "content_sanskrit": "नाश्रेयसि रतो यश्च न विरुद्धकथारुचिः।\nउत्तरोत्तरयुक्तीनां वक्ता वाचस्पतिर्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000078018, "chapter_id": 9078, "verse_number": "२-१-१८", "content_sanskrit": "अरोगस्तरुणो वाग्मी वपुष्मान् देशकालवित्।\nलोके पुरुषसारज्ञः साधुरेको विनिर्मितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000078019, "chapter_id": 9078, "verse_number": "२-१-१९", "content_sanskrit": "स तु श्रेष्ठैर्गुणैर्युक्तः प्रजानां पार्थिवात्मजः।\nबहिश्चर इव प्राणो बभूव गुणतः प्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000078020, "chapter_id": 9078, "verse_number": "२-१-२०", "content_sanskrit": "सर्वविद्याव्रतस्नातो यथावत् साङ्गवेदवित्।\nइष्वस्त्रे च पितुः श्रेष्ठो बभूव भरताग्रजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000078021, "chapter_id": 9078, "verse_number": "२-१-२१", "content_sanskrit": "कल्याणाभिजनः साधुरदीनः सत्यवागृजुः।\nवृद्धैरभिविनीतश्च द्विजैर्धर्मार्थदर्शिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000078022, "chapter_id": 9078, "verse_number": "२-१-२२", "content_sanskrit": "धर्मकामार्थतत्त्वज्ञः स्मृतिमान् प्रतिभानवान्।\nलौकिके समयाचारे कृतकल्पो विशारदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000078023, "chapter_id": 9078, "verse_number": "२-१-२३", "content_sanskrit": "निभृतः संवृताकारो गुप्तमन्त्रः सहायवान्।\nअमोघक्रोधहर्षश्च त्यागसंयमकालवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000078024, "chapter_id": 9078, "verse_number": "२-१-२४", "content_sanskrit": "दृढभक्तिः स्थिरप्रज्ञो नासद्‍ग्राही न दुर्वचः।\nनिस्तन्द्रीरप्रमत्तश्च स्वदोषपरदोषवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000078025, "chapter_id": 9078, "verse_number": "२-१-२५", "content_sanskrit": "शास्त्रज्ञश्च कृतज्ञश्च पुरुषान्तरकोविदः।\nयः प्रग्रहानुग्रहयोर्यथान्यायं विचक्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000078026, "chapter_id": 9078, "verse_number": "२-१-२६", "content_sanskrit": "सत्संग्रहानुग्रहणे स्थानविन्निग्रहस्य च।\nआयकर्मण्युपायज्ञः संदृष्टव्ययकर्मवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000078027, "chapter_id": 9078, "verse_number": "२-१-२७", "content_sanskrit": "श्रैष्ठ्यं चास्त्रसमूहेषु प्राप्तो व्यामिश्रकेषु च।\nअर्थधर्मौ च संगृह्य सुखतन्त्रो न चालसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000078028, "chapter_id": 9078, "verse_number": "२-१-२८", "content_sanskrit": "वैहारिकाणां शिल्पानां विज्ञातार्थविभागवित्।\nआरोहे विनये चैव युक्तो वारणवाजिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000078029, "chapter_id": 9078, "verse_number": "२-१-२९", "content_sanskrit": "धनुर्वेदविदां श्रेष्ठो लोकेऽतिरथसम्मतः।\nअभियाता प्रहर्ता च सेनानयविशारदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000078030, "chapter_id": 9078, "verse_number": "२-१-३०", "content_sanskrit": "अप्रधृष्यश्च संग्रामे क्रुद्धैरपि सुरासुरैः।\nअनसूयो जितक्रोधो न दृप्तो न च मत्सरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000078031, "chapter_id": 9078, "verse_number": "२-१-३१", "content_sanskrit": "नावज्ञेयश्च भूतानां न च कालवशानुगः।\nएवं श्रेष्ठैर्गुणैर्युक्तः प्रजानां पार्थिवात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000078032, "chapter_id": 9078, "verse_number": "२-१-३२", "content_sanskrit": "सम्मतस्त्रिषु लोकेषु वसुधायाः क्षमागुणैः।\nबुद्ध्या बृहस्पतेस्तुल्यो वीर्ये चापि शचीपतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000078033, "chapter_id": 9078, "verse_number": "२-१-३३", "content_sanskrit": "तथा सर्वप्रजाकान्तैः प्रीतिसंजननैः पितुः।\nगुणैर्विरुरुचे रामो दीप्तः सूर्य इवांशुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000078034, "chapter_id": 9078, "verse_number": "२-१-३४", "content_sanskrit": "तमेवंवृत्तसम्पन्नमप्रधृष्यपराक्रमम्।\nलोकनाथोपमं नाथमकामयत मेदिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000078035, "chapter_id": 9078, "verse_number": "२-१-३५", "content_sanskrit": "एतैस्तु बहुभिर्युक्तं गुणैरनुपमैः सुतम्।\nदृष्ट्वा दशरथो राजा चक्रे चिन्तां परंतपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000078036, "chapter_id": 9078, "verse_number": "२-१-३६", "content_sanskrit": "अथ राज्ञो बभूवैव वृद्धस्य चिरजीविनः।\nप्रीतिरेषा कथं रामो राजा स्यान्मयि जीवति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000078037, "chapter_id": 9078, "verse_number": "२-१-३७", "content_sanskrit": "एषा ह्यस्य परा प्रीतिर्हृदि सम्परिवर्तते।\nकदा नाम सुतं द्रक्ष्याम्यभिषिक्तमहं प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000078038, "chapter_id": 9078, "verse_number": "२-१-३८", "content_sanskrit": "वृद्धिकामो हि लोकस्य सर्वभूतानुकम्पकः।\nमत्तः प्रियतरो लोके पर्जन्य इव वृष्टिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000078039, "chapter_id": 9078, "verse_number": "२-१-३९", "content_sanskrit": "यमशक्रसमो वीर्ये बृहस्पतिसमो मतौ।\nमहीधरसमो धृत्यां मत्तश्च गुणवत्तरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000078040, "chapter_id": 9078, "verse_number": "२-१-४०", "content_sanskrit": "महीमहमिमां कृत्स्नामधितिष्ठन्तमात्मजम्।\nअनेन वयसा दृष्ट्वा यथा स्वर्गमवाप्नुयाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000078041, "chapter_id": 9078, "verse_number": "२-१-४१", "content_sanskrit": "इत्येवं विविधैस्तैस्तैरन्यपार्थिवदुर्लभैः।\nशिष्टैरपरिमेयैश्च लोके लोकोत्तरैर्गुणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000078042, "chapter_id": 9078, "verse_number": "२-१-४२", "content_sanskrit": "तं समीक्ष्य तदा राजा युक्तं समुदितैर्गुणैः।\nनिश्चित्य सचिवैः सार्धं यौवराज्यममन्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000078043, "chapter_id": 9078, "verse_number": "२-१-४३", "content_sanskrit": "दिव्यन्तरिक्षे भूमौ च घोरमुत्पातजं भयम्।\nसंचचक्षेऽथ मेधावी शरीरे चात्मनो जराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000078044, "chapter_id": 9078, "verse_number": "२-१-४४", "content_sanskrit": "पूर्णचन्द्राननस्याथ शोकापनुदमात्मनः।\nलोके रामस्य बुबुधे सम्प्रियत्वं महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000078045, "chapter_id": 9078, "verse_number": "२-१-४५", "content_sanskrit": "आत्मनश्च प्रजानां च श्रेयसे च प्रियेण च।\nप्राप्ते काले स धर्मात्मा भक्त्या त्वरितवान् नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000078046, "chapter_id": 9078, "verse_number": "२-१-४६", "content_sanskrit": "नानानगरवास्तव्यान् पृथग्जानपदानपि।\nसमानिनाय मेदिन्यां प्रधानान् पृथिवीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000078047, "chapter_id": 9078, "verse_number": "२-१-४७", "content_sanskrit": "तान् वेश्मनानाभरणैर्यथार्हं प्रतिपूजितान्।\nददर्शालंकृतो राजा प्रजापतिरिव प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000078048, "chapter_id": 9078, "verse_number": "२-१-४८", "content_sanskrit": "न तु केकयराजानं जनकं वा नराधिपः।\nत्वरया चानयामास पश्चात्तौ श्रोष्यतः प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000078049, "chapter_id": 9078, "verse_number": "२-१-४९", "content_sanskrit": "अथोपविष्टे नृपतौ तस्मिन् परपुरार्दने।\nततः प्रविविशुः शेषा राजानो लोकसम्मताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000078050, "chapter_id": 9078, "verse_number": "२-१-५०", "content_sanskrit": "अथ राजवितीर्णेषु विविधेष्वासनेषु च।\nराजानमेवाभिमुखा निषेदुर्नियता नृपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000078051, "chapter_id": 9078, "verse_number": "२-१-५१", "content_sanskrit": "स लब्धमानैर्विनयान्वितैर्नृपैः\nपुरालयैर्जानपदैश्च मानवैः।\nउपोपविष्टैर्नृपतिर्वृतो बभौ\nसहस्रचक्षुर्भगवानिवामरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000078052, "chapter_id": 9078, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे प्रथमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]