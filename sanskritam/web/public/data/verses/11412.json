[{"id": 50008947, "chapter_id": 11412, "verse_number": "1", "content_sanskrit": "राजोवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50008948, "chapter_id": 11412, "verse_number": "2", "content_sanskrit": "कपिलस्तत्त्वसङ्ख्याता भगवानात्ममायया। जातः स्वयमजः साक्षादात्मप्रज्ञप्तये नृणाम्॥ ३/२६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50008949, "chapter_id": 11412, "verse_number": "3", "content_sanskrit": "अर्हस्य धर्मिणां पुंसां गरिम्णः सर्वयोगिनाम्। विश्रुतौ श्रुतदेवस्य भूरि तृप्यन्ति मेऽसवः॥ ३/२६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50008950, "chapter_id": 11412, "verse_number": "4", "content_sanskrit": "यद्यद् विधत्ते भगवान् स्वच्छन्दात्माऽऽत्ममायया। तानि मे श्रद्धधानस्य कार्तन्यान्यनुकार्तय॥ ३/२६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50008951, "chapter_id": 11412, "verse_number": "5", "content_sanskrit": "श्रीशुक उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50008952, "chapter_id": 11412, "verse_number": "6", "content_sanskrit": "द्वैपायनसखश्चैवं मैत्रेयो भगवांस्तथा। प्राहेदं विदुरं प्रीत आन्वीक्षिक्यां प्रचोदितः॥ ३/२६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50008953, "chapter_id": 11412, "verse_number": "7", "content_sanskrit": "पितरि प्रस्थितेऽरण्यं मातुः प्रियचिकार्षया। तस्मिन् बिन्दुसरेऽवात्सीद् भगवान् कपिलः किल॥ ३/२६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50008954, "chapter_id": 11412, "verse_number": "8", "content_sanskrit": "तमासीनमकर्माणं तत्त्वमार्गाग्य्रदर्शनम्। स्वसुतं देवहूत्याह धातुः संस्मरती वचः॥ ३/२६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50008955, "chapter_id": 11412, "verse_number": "9", "content_sanskrit": "देवहूतिरुवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50008956, "chapter_id": 11412, "verse_number": "10", "content_sanskrit": "निर्विण्णाऽऽतितरां भूमन्नसदिन्द्रियतर्पणात्। येन सम्भाव्यमानेन प्रपन्नाऽन्धतमः प्रभो॥ ३/२६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50008957, "chapter_id": 11412, "verse_number": "11", "content_sanskrit": "तस्य त्वं तमसोऽन्धस्य दुष्पारस्याद्य पारगः। सच्चक्षुर्जन्मनामन्ते लब्धं मे त्वदनुग्रहात्॥ ३/२६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50008958, "chapter_id": 11412, "verse_number": "12", "content_sanskrit": "य आद्यो भगवान् पुंसामीश्वरो वै भवान् किल। लोकस्य तमसाऽन्धस्य चक्षुः सूर्य इवोदितः॥ ३/२६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50008959, "chapter_id": 11412, "verse_number": "13", "content_sanskrit": "अथ मे देव सम्मोहमपाक्रष्टुं त्वमर्हसि। योऽवग्रहोऽहम्ममेतीत्येतस्मिन् योजितस्त्वया॥ ३/२६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50008960, "chapter_id": 11412, "verse_number": "14", "content_sanskrit": "तं त्वा गताऽहं शरणं शरण्यं स्वभृत्यसंसारतरोः कुठारम्। जिज्ञासया प्रकृतेः पूरुषस्य नमामि सद्धर्मविदां वरिष्ठम्॥ ३/२६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50008961, "chapter_id": 11412, "verse_number": "15", "content_sanskrit": "मैत्रेय उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50008962, "chapter_id": 11412, "verse_number": "16", "content_sanskrit": "इति स्वमातुर्निरवद्यमीप्सितं निशम्य पुंसामपवर्गचोदनम्। धियाऽभिनन्द्यात्मवतां सतां गतिर्बभाष ईषत्स्मितशोभिताननः॥ ३/२६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50008963, "chapter_id": 11412, "verse_number": "17", "content_sanskrit": "श्रीभगवानुवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50008964, "chapter_id": 11412, "verse_number": "18", "content_sanskrit": "योग आध्यात्मिकः पुंसां मतो निःश्रेयसाय मे। अत्यन्तोपरतिर्यत्र दुःखस्य च सुखस्य च॥ ३/२६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50008965, "chapter_id": 11412, "verse_number": "19", "content_sanskrit": "तमिमं ते प्रवक्ष्यामि यमवोचं पुराऽनघे। ऋषीणां श्रोतुकामानां योगमुर्वङ्गनैपुणम्॥ ३/२६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50008966, "chapter_id": 11412, "verse_number": "20", "content_sanskrit": "चेतः खल्वस्य बन्धाय मुक्तये चात्मनो मतम्। गुणेषु सक्तं बन्धाय तेष्वसक्तं हि मुक्तये॥ ३/२६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50008967, "chapter_id": 11412, "verse_number": "21", "content_sanskrit": "अहम्ममाभिमानोत्थैः कामलोभादिभिर्मलैः। वीतं यदा मनः शुद्धमदुःखमसुखं समम्॥ ३/२६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50008968, "chapter_id": 11412, "verse_number": "22", "content_sanskrit": "तदा पुरुष आत्मानं केवलं प्रकृतेः परम्। निरन्तरं स्वयञ्ज्योतिरणिमानमखण्डितम्॥ ३/२६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50008969, "chapter_id": 11412, "verse_number": "23", "content_sanskrit": "ज्ञानवैराग्ययुक्तेन भक्तियोगेन चात्मना। परिपश्यत्युदासीनां प्रकृतिं च हतौजसम्॥ ३/२६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50008970, "chapter_id": 11412, "verse_number": "24", "content_sanskrit": "न युज्यमानया भक्त्या भगवत्यखिलात्मनि। सदृशोऽस्ति शिवः पन्था योगिनां ब्रह्मसिद्धये॥ ३/२६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50008971, "chapter_id": 11412, "verse_number": "25", "content_sanskrit": "प्रसङ्गमजरं पाशमात्मनः कवयो विदुः। स एव साधुषु कृतो मोक्षद्वारमपावृतम्॥ ३/२६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50008972, "chapter_id": 11412, "verse_number": "26", "content_sanskrit": "तितिक्षवः कारुणिकाः सुहृदः सर्वदेहिनाम्। अजातशत्रवः शान्ताः साधवः साधुभूषणाः॥ ३/२६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50008973, "chapter_id": 11412, "verse_number": "27", "content_sanskrit": "मय्यनन्येन भावेन भक्तिं कुर्वन्ति ये दृढाम्। मत्कृते त्यक्तकर्माणस्त्यक्तस्वजनबान्धवाः॥ ३/२६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50008974, "chapter_id": 11412, "verse_number": "28", "content_sanskrit": "मदाश्रयाः कथा हृष्टाः शृण्वन्ति कथयन्ति च। तपन्ति विविधांस्तापानैकात्म्यगतचेतसः॥ ३/२६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50008975, "chapter_id": 11412, "verse_number": "29", "content_sanskrit": "त एते साधवः साध्वि सर्वसङ्गविवर्जिताः। सङ्गस्तेष्वथ ते प्रार्थ्यः सङ्गदोषहरा हि ते॥ ३/२६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50008976, "chapter_id": 11412, "verse_number": "30", "content_sanskrit": "सतां प्रसङ्गान्मम वीर्यसम्पदो भवन्ति हृत्कर्णरसायनाः कथाः। तज्जोषणादाश्वपवर्गवर्त्मनि श्रद्धावती भक्तिरनुक्रमिष्यति॥ ३/२६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50008977, "chapter_id": 11412, "verse_number": "31", "content_sanskrit": "भक्त्या पुमान् जातविराग ऐन्द्रियाद् दृष्टश्रुतात्मद्रविणानुचिन्तया। चित्तस्य यत्तो ग्रहणे योगयुक्तो यतिष्यते ऋजुभिर्योगमार्गैः॥ ३/२६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50008978, "chapter_id": 11412, "verse_number": "32", "content_sanskrit": "असेवयाऽयं प्रकृतेर्गुणानां ज्ञानेन वैराग्यविजृम्भितेन। योगेन मय्यर्पितया च भक्त्या मां प्रत्यगात्मानमिहावरुन्धे॥ ३/२६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50008979, "chapter_id": 11412, "verse_number": "33", "content_sanskrit": "देवहूतिरुवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50008980, "chapter_id": 11412, "verse_number": "34", "content_sanskrit": "का स्वित् त्यय्यर्पिता भक्तिः कादृशी मम गोचरा। यया पदं ते निर्वाणमञ्जसा ह्यश्नवान्यहम्॥ ३/२६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50008981, "chapter_id": 11412, "verse_number": "35", "content_sanskrit": "यो योगो भगवत्प्राप्तौ निर्वाणात्मंस्त्वयोदितः। कादृशः कति चाङ्गानि यतस्तत्त्वावबोधनम्॥ ३/२६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50008982, "chapter_id": 11412, "verse_number": "36", "content_sanskrit": "तदेतन्मे विजानीहि यथाऽहं मन्दधीर्हरे। सुखं बुद्ध्येय दुर्बोधं योषा भवदनुग्रहात्॥ ३/२६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50008983, "chapter_id": 11412, "verse_number": "37", "content_sanskrit": "मैत्रेय उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50008984, "chapter_id": 11412, "verse_number": "38", "content_sanskrit": "विदित्वाऽर्थं कपिलो मातुरित्थं जातस्नेहो यत्र तन्वाऽभिजातः। तत्त्वाम्नायं यत् प्रवदन्ति साङ्ख्यं प्रावोचद् वै भक्तिवितानयोगम्॥ ३/२६/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50008985, "chapter_id": 11412, "verse_number": "39", "content_sanskrit": "श्रीभगवानुवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50008986, "chapter_id": 11412, "verse_number": "40", "content_sanskrit": "देवानां गुणलिङ्गानामानुश्रविककर्मणाम्। सत्त्व एवैकमनसो वृत्तिः स्वाभाविका तु या॥ ३/२६/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50008987, "chapter_id": 11412, "verse_number": "41", "content_sanskrit": "अनिमित्ता भगवति भक्तिः सिद्धेर्गरीयसी। जरयत्याशु या कोशं निगीर्णमनलो यथा॥ ३/२६/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50008988, "chapter_id": 11412, "verse_number": "42", "content_sanskrit": "नैकात्म्यतां मे स्पृहयन्ति केचिन्मत्पादसेवाभिरता मदीहाः। येऽन्योन्यतो भागवताः प्रसज्य सम्भाजयन्ते मम पौरुषाणि॥ ३/२६/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50008989, "chapter_id": 11412, "verse_number": "43", "content_sanskrit": "पश्यन्ति मे ते रुचिराण्येव सन्तः प्रसन्नवक्त्रारुणलोचनानि। रूपाणि दिव्यानि वरप्रदानि साकं वाचं स्पृहणीयां वदन्ति॥ ३/२६/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50008990, "chapter_id": 11412, "verse_number": "44", "content_sanskrit": "तैर्दर्शनीयावयवैरुदारविलासहासेक्षितवामसूक्तैः। हृतात्मनो हृतप्राणस्य भक्तिमन्विच्छतो गतिमण्वीं प्रयुञ्जे॥ ३/२६/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50008991, "chapter_id": 11412, "verse_number": "45", "content_sanskrit": "अथो विभूतिं मम मायया चितामैश्वर्यमष्टाङ्गमनुप्रवृत्तम्। श्रियं न देवीं स्पृहयन्ति भद्रां परस्य मे तेऽश्नुवते हि लोके॥ ३/२६/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50008992, "chapter_id": 11412, "verse_number": "46", "content_sanskrit": "न कर्हिचिन्मत्पराः शान्तरूपा नङ्क्ष्यन्ति मे नोऽनिमिषो लेढि हेतिः। येषामहं प्रिय आत्मा सुतश्च सखा गुरुः सुहृदो दैवमिष्टम्॥ ३/२६/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50008993, "chapter_id": 11412, "verse_number": "47", "content_sanskrit": "इमं लोकं तथैवामुमात्मानमुभयायिनम्। आत्मानमनु ये चेमे ये रायः पशवो गृहाः॥ ३/२६/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50008994, "chapter_id": 11412, "verse_number": "48", "content_sanskrit": "विसृज्य सर्वानन्यांश्च मामेवं विश्वतोमुखम्। भजन्त्यनन्यया भक्त्या तान् मृत्योरतिपारये॥ ३/२६/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50008995, "chapter_id": 11412, "verse_number": "49", "content_sanskrit": "नान्यत्र मद् भगवतः प्रधानपुरुषेश्वरात्। आत्मनः सर्वभूतानां भयं तीव्रं निवर्तते॥ ३/२६/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50008996, "chapter_id": 11412, "verse_number": "50", "content_sanskrit": "मद्भयाद् वाति वातोऽयं सूर्यस्तपति मद्भयात्। वर्षतीन्द्रो दहत्यग्निर्मृत्युश्चरति मद्भयात्॥ ३/२६/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50008997, "chapter_id": 11412, "verse_number": "51", "content_sanskrit": "ज्ञानवैराग्ययुक्तेन भक्तियोगेन योगिनः। क्षेमाय पादमूलं मे प्रविशन्त्यकुतोभयम्॥ ३/२६/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50008998, "chapter_id": 11412, "verse_number": "52", "content_sanskrit": "एतावानेव लोकेऽस्मिन् पुंसां निःश्रेयसोदयः। तीव्रेण भक्तियोगेन मनो मय्यर्पितं स्थितम्॥ ३/२६/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 50008999, "chapter_id": 11412, "verse_number": "53", "content_sanskrit": "॥ इति श्रीमद्भागवते तृतीयस्कन्धे षड्विंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]