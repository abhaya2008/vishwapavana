[{"id": 7001038000, "chapter_id": 21038, "verse_number": "५-२०-१", "content_sanskrit": "श्रीपराशर उवाच।\nराजमार्गे ततः कृष्णस्सानुलेपनभाजनाम् ।\nददर्श कुब्जामायांतीं नवयौवनगोचराम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001038001, "chapter_id": 21038, "verse_number": "५-२०-२", "content_sanskrit": "तामाह ललितं कृष्णः कस्येदमनुलेपनम् ।\nभवत्या नीयते सत्यं वदेंदीवरलोचने ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001038002, "chapter_id": 21038, "verse_number": "५-२०-३", "content_sanskrit": "सकामेनेव सा प्रोक्ता सानुरागा हरिं प्रति ।\nप्राह सा ललितं कुब्जा तद्दर्शनबलात्कृता ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001038003, "chapter_id": 21038, "verse_number": "५-२०-४", "content_sanskrit": "कांत कस्मान्न जानासि कंसेन विनियोजिताम् ।\nनैकवक्रेति विख्यातामनुलेपनकर्मणि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001038004, "chapter_id": 21038, "verse_number": "५-२०-५", "content_sanskrit": "नान्यपिष्टं हि कंसस्य प्रीतये ह्यनुलेपनम् ।\nभवाम्यहमतीवास्य प्रसादधनभाजनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001038005, "chapter_id": 21038, "verse_number": "५-२०-६", "content_sanskrit": "श्रीकृष्ण उवाच।\nसुगंधमेतद्रा जार्हं रुचिरं रुचिरानने ।\nआवयोर्गात्र सदृशं दीयतामनुलेपनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001038006, "chapter_id": 21038, "verse_number": "५-२०-७", "content_sanskrit": "श्रीपराशर उवाच।\nश्रुत्वैतदाह सा कुब्जा गृह्यतामिति सादरम् ।\nअनुलेपनं च प्रददौ गात्रयोग्यमथोभयोः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001038007, "chapter_id": 21038, "verse_number": "५-२०-८", "content_sanskrit": "भक्तिच्छेदानुलिप्तांगौ ततस्तौ पुरुषर्षभौ ।\nसेंद्र चापौ व्यराजेतां सितकृष्णाविवांबुदौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001038008, "chapter_id": 21038, "verse_number": "५-२०-९", "content_sanskrit": "ततस्तां चुबुके शौरिरुल्लापन विधानवित् ।\nउत्पाट्य तोलयामास द्व्यंगुलेनाग्रपाणिना ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001038009, "chapter_id": 21038, "verse_number": "५-२०-१०", "content_sanskrit": "चकर्ष पद्भ्यां च तदा ऋजुत्वं केशवोऽनयत् ।\nततस्सा ऋजुतां प्राप्ता योषितामभवद्वरा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001038010, "chapter_id": 21038, "verse_number": "५-२०-११", "content_sanskrit": "विलासललितं प्राह प्रेमगर्भभरालसम् ।\nवस्त्रे प्रगृह्य गोविंदं मम गेहं व्रजेति वै ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001038011, "chapter_id": 21038, "verse_number": "५-२०-१२", "content_sanskrit": "एवमुक्तस्तया शौरी रामस्यालोक्य चाननम् ।\nप्रहस्य कुब्जां तामाह नैकवक्रामनिंदिताम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001038012, "chapter_id": 21038, "verse_number": "५-२०-१३", "content_sanskrit": "आयास्ये भवतीगेहमिति तां प्रहसन्हरिः ।\nविससर्ज जहासोच्चै रामस्यालोक्य चाननम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001038013, "chapter_id": 21038, "verse_number": "५-२०-१४", "content_sanskrit": "भक्तिभेदानुलिप्तांगौ नीलपीतांबरौ तु तौ ।\nधनुश्शालां ततो यातौ चित्रमाल्योपशोभितौ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001038014, "chapter_id": 21038, "verse_number": "५-२०-१५", "content_sanskrit": "आयागं तद्धनूरत्नं ताभ्यां पृष्टैस्तु रक्षिभिः ।\nआख्याते सहसा कृष्णो गृहीत्वा पूरयद्धनुः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001038015, "chapter_id": 21038, "verse_number": "५-२०-१६", "content_sanskrit": "ततः पूरयता तेन भज्यमानं बलाद्धनुः ।\nचकार सुमहच्छब्दं मथुरा येन पूरिता ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001038016, "chapter_id": 21038, "verse_number": "५-२०-१७", "content_sanskrit": "अनुयुक्तौ ततस्तौ तु भग्ने धनुषि रक्षिभिः ।\nरक्षिसैन्यं निहत्योभौ निष्क्रांतौ कार्मुकालयात् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001038017, "chapter_id": 21038, "verse_number": "५-२०-१८", "content_sanskrit": "अक्रूरागमवृत्तांतमुपलभ्य महद्धनुः ।\nभग्नं श्रुत्वा च कंसोऽपि प्राह चाणूरमुष्टिकौ ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001038018, "chapter_id": 21038, "verse_number": "५-२०-१९", "content_sanskrit": "कंस उवाच।\nगोपालदारकौ प्राप्तौ भवद्भ्यां तु ममाग्रतः ।\nमल्लयुद्धेन हंतव्यौ मम प्राणहरौ हि तौ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001038019, "chapter_id": 21038, "verse_number": "५-२०-२०", "content_sanskrit": "नियुद्धे तद्विनाश्नो भवद्भ्यां तोषितो ह्यहम् ।\nदास्याम्यभिमतान्कामान्नान्यथैतौ महाबलौ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001038020, "chapter_id": 21038, "verse_number": "५-२०-२१", "content_sanskrit": "न्यायतोन्यायतो वापि भवद्भ्यां तौ ममाहितौ ।\nहंताव्यौ तद्वधाद्रा ज्यं सामान्यं वां भविष्यति ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001038021, "chapter_id": 21038, "verse_number": "५-२०-२२", "content_sanskrit": "इत्यादिश्य स तौ मल्लौ ततश्चाहूय हस्तिपम् ।\nप्रोवाचोच्चैस्त्वया मल्लसमाजद्वारि कुंजरः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001038022, "chapter_id": 21038, "verse_number": "५-२०-२३", "content_sanskrit": "स्थाप्यः कुवलयापीडस्तेन तौ गोपदारकौ ।\nघातनीयौ नियुद्धाय रंगद्वारमुपागतौ ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001038023, "chapter_id": 21038, "verse_number": "५-२०-२४", "content_sanskrit": "तमप्याज्ञाप्य दृष्ट्वा च सर्वान्मंचानुपाकृतान् ।\nआसन्न मरणः कंसः सूर्योदयमुदैक्षत ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001038024, "chapter_id": 21038, "verse_number": "५-२०-२५", "content_sanskrit": "ततः समस्तमंचेषु नागरस्स तदा जनः ।\nराजमंचेषु चारूढास्सह भृत्यैर्नराधिपाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001038025, "chapter_id": 21038, "verse_number": "५-२०-२६", "content_sanskrit": "मल्लप्राश्निकवर्गश्च रंगमध्यसमीपगः ।\nकृतः कंसेन कंसोऽपि तुंगमंचे व्यवस्थितः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001038026, "chapter_id": 21038, "verse_number": "५-२०-२७", "content_sanskrit": "अंतःपुराणां मंचाश्च तथाऽन्ये परिकल्पिताः ।\nअन्ये च वारमुख्यानामन्ये नागरयोषिताम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001038027, "chapter_id": 21038, "verse_number": "५-२०-२८", "content_sanskrit": "नंदगोपादयो गोपा मंचेष्वन्येष्ववस्थिताः ।\nअक्रूरवसुदेवौ च मंचप्रांते व्यवस्थितौ ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001038028, "chapter_id": 21038, "verse_number": "५-२०-२९", "content_sanskrit": "नागरीयोषितां मध्ये देवकीपुत्रगर्द्धिनी ।\nअंतकालेऽपि पुत्रस्य द्रक्ष्यामीति मुखं स्थिता ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001038029, "chapter_id": 21038, "verse_number": "५-२०-३०", "content_sanskrit": "वाद्यमानेषु तूर्येषु चाणूरे चातिवल्गति ।\nहाहाकारपरे लोके ह्यास्फोटयति मुष्टिके ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001038030, "chapter_id": 21038, "verse_number": "५-२०-३१", "content_sanskrit": "ईषद्धसंतौ तौ वीरौ बलभद्र जनार्दनौ ।\nगोपवेषधरौ बालौ रंगद्वारमुपागतौ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001038031, "chapter_id": 21038, "verse_number": "५-२०-३२", "content_sanskrit": "ततः कुवलयापीडो महामात्रप्रचोदितः ।\nअभ्यधावत वेगेन हंतुं गोपकुमारकौ ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001038032, "chapter_id": 21038, "verse_number": "५-२०-३३", "content_sanskrit": "हाहाकारो महाञ्जज्ञे रंगमध्ये द्विजोत्तम ।\nबलदेवोऽनुजं दृष्ट्वा वचनं चेदमब्रवीत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001038033, "chapter_id": 21038, "verse_number": "५-२०-३४", "content_sanskrit": "हंतव्यो हि महाभाग नागोऽयं शत्रुचोदितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001038034, "chapter_id": 21038, "verse_number": "५-२०-३५", "content_sanskrit": "इत्युक्तस्सोऽग्रजेनाथ बलदेवेन वै द्विज ।\nसिंहनादं ततश्चक्रे माधवः परवीरहा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001038035, "chapter_id": 21038, "verse_number": "५-२०-३६", "content_sanskrit": "करेण करमाकृष्य तस्य केशिनिषूदनः ।\nभ्रामयामास तं शौरिरैरावतसमं बले ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001038036, "chapter_id": 21038, "verse_number": "५-२०-३७", "content_sanskrit": "ईशोपि सर्वजगतां बाललीलानुसारतः ।\nक्रीडित्वा सुचिरं कृष्णः करिदंतपदांतरे ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001038037, "chapter_id": 21038, "verse_number": "५-२०-३८", "content_sanskrit": "उत्पाट्य वामदंतं तु दक्षिणेनैव पाणिना ।\nताडयामास यंतारं तस्यासीच्छतधा शिरः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001038038, "chapter_id": 21038, "verse_number": "५-२०-३९", "content_sanskrit": "दक्षिणं दंतमुत्पाट्य बलभद्रो ऽपि तत्क्षणात् ।\nस रोषस्तेन पार्श्वस्थान् गजपालानपोथयत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001038039, "chapter_id": 21038, "verse_number": "५-२०-४०", "content_sanskrit": "ततस्तूत्प्लुत्य वेगेन रौहिणेयो महाबलः ।\nजघान वामपादेन मस्तके हस्तिनं रुषा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001038040, "chapter_id": 21038, "verse_number": "५-२०-४१", "content_sanskrit": "स पपात हतस्तेन बलभद्रे ण लीलया ।\nसहस्राक्षेण वज्रेण ताडितः पर्वतो यथा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001038041, "chapter_id": 21038, "verse_number": "५-२०-४२", "content_sanskrit": "हत्वा कुवलयापीडं हस्त्यारोहप्रचोदितम् ।\nमदासृगनुलिप्तांगौ हस्तिदंतवरायुधौ ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001038042, "chapter_id": 21038, "verse_number": "५-२०-४३", "content_sanskrit": "मृगमध्ये यथा सिंहौ गर्वलीलावलोकिनौ ।\nप्रविष्टौ सुमहारंगं बलभद्र जनार्दनौ ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001038043, "chapter_id": 21038, "verse_number": "५-२०-४४", "content_sanskrit": "हाहाकारो महाञ्जज्ञे महारंगे त्वनंतरम् ।\nकृष्णोऽयं बलभद्रो यमिति लोकस्य विस्मयः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001038044, "chapter_id": 21038, "verse_number": "५-२०-४५", "content_sanskrit": "सोऽयं येन हता घोरा पूतना बालघातिनी ।\nक्षिप्तं तु शकटं येन भग्नौ तु यमलार्जुनौ ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001038045, "chapter_id": 21038, "verse_number": "५-२०-४६", "content_sanskrit": "सोयं यः कालियं नागं ममर्दारुह्य वालकः ।\nधृतो गोवर्द्धनो येन सप्तरात्रं महागिरिः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001038046, "chapter_id": 21038, "verse_number": "५-२०-४७", "content_sanskrit": "अरिष्टो धेनुकः केशी लीलयैव महात्मना ।\nनिहता येन दुर्वृत्ता दृश्यतामेष सोऽच्युतः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001038047, "chapter_id": 21038, "verse_number": "५-२०-४८", "content_sanskrit": "अयं चास्य महाबाहुर्बलभद्रो ऽग्रतोऽग्रजः ।\nप्रयाति लीलया योषिन्मनोनयननंदनः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001038048, "chapter_id": 21038, "verse_number": "५-२०-४९", "content_sanskrit": "अयं स कथ्यते प्राज्ञैः पुराणार्थविशारदैः ।\nगोपालो यादवं वंशं मग्नमभ्यद्धरिष्यति ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001038049, "chapter_id": 21038, "verse_number": "५-२०-५०", "content_sanskrit": "अयं हि सर्वलोकस्य विष्णोरखिलजन्मनः ।\nअवतीर्णो महीमंशो नूनं भारहरो भुवः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001038050, "chapter_id": 21038, "verse_number": "५-२०-५१", "content_sanskrit": "इत्येवं वर्णिते पौरै रामे कृष्णे च तत्क्षणात् ।\nउरस्तताप देवक्याः स्नेहस्नुतपयोधरम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001038051, "chapter_id": 21038, "verse_number": "५-२०-५२", "content_sanskrit": "महोत्सवमिवासाद्य पुत्राननविलोकनात् ।\nयुवेव वसुदेवोऽभूद्विहायाभ्यागतां जराम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001038052, "chapter_id": 21038, "verse_number": "५-२०-५३", "content_sanskrit": "विस्तारिताक्षियुगलो राजांतःपुरयोषिताम् ।\nनागरस्त्रीसमूहश्च द्र ष्टुं न विरराम तम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001038053, "chapter_id": 21038, "verse_number": "५-२०-५४", "content_sanskrit": "सख्यः पश्यत कृष्णस्य मुखमत्यरुणेक्षणम् ।\nगजयुद्धकृतायासस्वेदांबुकणिकाचितम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001038054, "chapter_id": 21038, "verse_number": "५-२०-५५", "content_sanskrit": "विकासिशरदंभोजमपश्यामजलोक्षितम् ।\nपरिभूयं स्थितं जन्म सफलं क्रियतां दृशः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001038055, "chapter_id": 21038, "verse_number": "५-२०-५६", "content_sanskrit": "श्रीवत्सांकं महद्धाम बालस्यैतद्विलोक्यताम् ।\nविपक्षक्षपणं वक्षो भुजयुग्मं च भामिनि ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001038056, "chapter_id": 21038, "verse_number": "५-२०-५७", "content_sanskrit": "किं न पश्यसि दुग्धेंदुमृणालधवलाकृतिम् ।\nबलभद्र मिमं नीलपरिधानमुपागतम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001038057, "chapter_id": 21038, "verse_number": "५-२०-५८", "content_sanskrit": "वल्गतामुष्टिकेनैव चाणूरेण तथा सखि ।\nक्रीडतो बलभद्र स्य हरेर्हास्यं विलोक्यताम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001038058, "chapter_id": 21038, "verse_number": "५-२०-५९", "content_sanskrit": "सख्यः पश्यत चाणूरं नियुद्धार्थमयं हरिः ।\nसमुपैति न संत्यत्र किं वृद्धा मुक्तकारिणः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001038059, "chapter_id": 21038, "verse_number": "५-२०-६०", "content_sanskrit": "क्व यौवनोन्मुखीभूतसुकुमारतनुर्हरिः ।\nक्व वज्रकठिनाभोगशरीरोऽयं महासुरः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001038060, "chapter_id": 21038, "verse_number": "५-२०-६१", "content_sanskrit": "इमौ सुललितैरंगैर्वर्त्तेते नवयौवनौ ।\nदैतेयमल्लाश्चाणूरप्रमुखास्त्वतिदारुणाः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001038061, "chapter_id": 21038, "verse_number": "५-२०-६२", "content_sanskrit": "नियुद्धप्राश्निकानां तु महानेष व्यतिक्रमः ।\nयद्बालबलिनोर्युद्धं मध्यस्थैस्समुपेक्ष्यते ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001038062, "chapter_id": 21038, "verse_number": "५-२०-६३", "content_sanskrit": "श्रीपराशर उवाच।\nइत्थं पुरस्त्रीलोकस्व वदतश्चालयन्भुवम् ।\nववल्ग बद्धकक्ष्यॐतर्जनस्य भगवान्हरिः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001038063, "chapter_id": 21038, "verse_number": "५-२०-६४", "content_sanskrit": "बलभद्रो ऽपि चास्फोट्य ववल्गललितं तथा ।\nपदेपदे तथा भूमिर्यन्न शीर्णा तदद्भुतम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001038064, "chapter_id": 21038, "verse_number": "५-२०-६५", "content_sanskrit": "चाणूरेण ततः कृष्णो ययुधेऽमितविक्रमः ।\nनियुद्धकुशलो दैत्यो बलभद्रे ण मुष्टिकः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001038065, "chapter_id": 21038, "verse_number": "५-२०-६६", "content_sanskrit": "सन्निपातावधूतैस्तु चाणूरेण समं हरिः ।\nप्रक्षेपणैर्मुष्टिभिश्च कीलवज्रनिपातनैः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001038066, "chapter_id": 21038, "verse_number": "५-२०-६७", "content_sanskrit": "पादोद्धूतैः प्रमृष्टैश्च तयोर्युद्धमभून्महत् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001038067, "chapter_id": 21038, "verse_number": "५-२०-६८", "content_sanskrit": "अशस्त्रमतिघोरं तत्तयोर्युद्धं सुदारुणम् ।\nबलप्राणविनिष्पाद्यं समाजोत्सवसन्निधौ ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001038068, "chapter_id": 21038, "verse_number": "५-२०-६९", "content_sanskrit": "यावद्यावच्च चाणूरो युयुधे हरिणा सह ।\nप्राणहानिमवापाग्र्यां तावत्तावल्लवाल्लवम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001038069, "chapter_id": 21038, "verse_number": "५-२०-७०", "content_sanskrit": "कृष्णोपि युयुधे तेन लीलयैव जगन्मयः ।\nखेदाच्चालयता कोपान्निजकेसरश्खोरम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001038070, "chapter_id": 21038, "verse_number": "५-२०-७१", "content_sanskrit": "बलक्षयं विवृद्धिं च दृष्ट्वा चाणूकृष्णयोः ।\nवारयामास तूर्याणि कंसः कोपपरायणः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001038071, "chapter_id": 21038, "verse_number": "५-२०-७२", "content_sanskrit": "मृदंगादिषु तूर्येषु प्रतिषिद्धेषु तत्क्षणात् ।\nखे संगतान्यवाद्यंत देवतूर्याण्यनेकशः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001038072, "chapter_id": 21038, "verse_number": "५-२०-७३", "content_sanskrit": "जय गोविंद चाणूरं जहि केशव दानवम् ।\nअंतर्द्धानगता देवास्तमूचुरतिहर्षिताः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001038073, "chapter_id": 21038, "verse_number": "५-२०-७४", "content_sanskrit": "चाणूरेण चिरं कालं पीडित्वा मधुसूदनः ।\nउत्पाट्य भ्रामयामास तद्वधाय कृतोद्यमः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001038074, "chapter_id": 21038, "verse_number": "५-२०-७५", "content_sanskrit": "भ्रामयित्वा शतगुणं दैत्यमल्लममित्रजित् ।\nभूमावास्फोटयामास गगने गतजीवितम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001038075, "chapter_id": 21038, "verse_number": "५-२०-७६", "content_sanskrit": "भूमावास्फोटितस्तेन चाणूरः शतधाऽभवत् ।\nरक्तस्रावमहापंकां चकार च तदा भुवम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001038076, "chapter_id": 21038, "verse_number": "५-२०-७७", "content_sanskrit": "बलदेवोऽपि तत्कालं मुष्टिकेन महाबलः ।\nयुयुधे दैत्यमल्लेन चाणूरेण यथा हरिः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001038077, "chapter_id": 21038, "verse_number": "५-२०-७८", "content_sanskrit": "सोऽप्येनं मुष्टिना मूर्ध्नि वक्षस्याहत्य जानुना ।\nपातयित्वा धरापृष्ठे निष्पिपेष गतायुषम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001038078, "chapter_id": 21038, "verse_number": "५-२०-७९", "content_sanskrit": "कृष्ण स्तोशलकं भूयो मल्लराजं महाबलम् ।\nवाममुष्टिप्रहारेण पातयामास भूतले ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001038079, "chapter_id": 21038, "verse_number": "५-२०-८०", "content_sanskrit": "चाणूरे नहते मल्ले मुष्टेके विनिपातिते ।\nनीते क्षयं तोशलके सर्वे मल्लाः प्रदुद्रु वुः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001038080, "chapter_id": 21038, "verse_number": "५-२०-८१", "content_sanskrit": "ववल्गतुस्ततो रंगे कृष्णसंकर्षणावुभौ ।\nसमानवयसो गोपान्बलादाकृष्य हर्षितौ ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001038081, "chapter_id": 21038, "verse_number": "५-२०-८२", "content_sanskrit": "कंसोऽपि कोपरक्ताक्षः प्राहोच्चैर्व्यायतान्नरान् ।\nगोपावेतौ समाजौघान्निष्क्राम्येतां बलादितः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001038082, "chapter_id": 21038, "verse_number": "५-२०-८३", "content_sanskrit": "नंदोऽपि गृह्यतां पापो निर्गलैरायसैरिह ।\nअवृद्धार्हेण दंडेन वसुदेवोऽपि बध्यताम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001038083, "chapter_id": 21038, "verse_number": "५-२०-८४", "content_sanskrit": "वल्गंति गोपाः कृष्णेन ये चेमे सहिताः पुरः ।\nगावो निगृह्य तामेषां यच्चास्ति वसु किंचन ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001038084, "chapter_id": 21038, "verse_number": "५-२०-८५", "content_sanskrit": "एवमाज्ञापयानं तु प्रहस्य मधुसूदनः ।\nउत्प्लुत्यारुह्य तं मंचं कंसं जग्राह वेगतः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001038085, "chapter_id": 21038, "verse_number": "५-२०-८६", "content_sanskrit": "केश्ष्वोआ!कृष्य विगलत्किरीटमवनीतले ।\nस कंसं पातयामास तस्योपरि पपात च ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001038086, "chapter_id": 21038, "verse_number": "५-२०-८७", "content_sanskrit": "अश्षोजगदाधारगुरुणा पततोपरि ।\nकृष्णेन त्याजितः प्राणानुग्रसेनात्मजो नृपः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001038087, "chapter_id": 21038, "verse_number": "५-२०-८८", "content_sanskrit": "नृतस्य केश्षोउ! तदा गृहीत्वा मधुसूदनः ।\nचकर्ष देहं कंसस्य रंगमध्ये महाबलः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001038088, "chapter_id": 21038, "verse_number": "५-२०-८९", "content_sanskrit": "गौरवेणातिपतता परिघातेन कृष्यता ।\nकृता कंसस्य देहेन वेगेनेव महांभसः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001038089, "chapter_id": 21038, "verse_number": "५-२०-९०", "content_sanskrit": "कंसे गृहीते कृष्णेन तद्भ्राताऽभ्यागतो रुषा ।\nसुनामा बलभद्रे ण लीलयैव निपातितः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001038090, "chapter_id": 21038, "verse_number": "५-२०-९१", "content_sanskrit": "ततो हाहाकृतं सर्वमासीत्तद्रं गमंडलम् ।\nअवज्ञया हतं दृष्ट्वा कृष्णेन मथुरेश्वरम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001038091, "chapter_id": 21038, "verse_number": "५-२०-९२", "content_sanskrit": "कृष्णोऽपि वसुदेवस्य पादौ जग्राह सत्वरः ।\nदेवक्याश्च महाबाहुर्बलदेवसहायवान् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001038092, "chapter_id": 21038, "verse_number": "५-२०-९३", "content_sanskrit": "उत्थाप्य वसुदेवस्तं देवकी च जनार्दनम् ।\nस्मृतजन्मोक्तवचनौ तावेव प्रणतौ स्थितौ ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001038093, "chapter_id": 21038, "verse_number": "५-२०-९४", "content_sanskrit": "श्रीवसुदेव उवाच।\nप्रसीद सीदतां दत्तो देवानां यो वरः प्रभो ।\nतथावयोः प्रसादेन कृतोद्धारस्स केशव ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7001038094, "chapter_id": 21038, "verse_number": "५-२०-९५", "content_sanskrit": "आराधितो यद्भगवानवतीर्णो गृहे मम ।\nदुर्वृत्तनिधनार्थाय तेन नः पावितं कुलम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7001038095, "chapter_id": 21038, "verse_number": "५-२०-९६", "content_sanskrit": "त्वमंतः सर्वभूतानां सर्वभूतमयस्थितः ।\nप्रवर्त्तेते समस्तात्मंस्त्वत्तो भूतभविष्यती ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7001038096, "chapter_id": 21038, "verse_number": "५-२०-९७", "content_sanskrit": "यज्ञैस्त्वमिज्यसेऽचिंत्य सर्वदेवमयाच्युत ।\nत्वमेव यज्ञो यष्टा च यज्वनां परमेश्वरः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7001038097, "chapter_id": 21038, "verse_number": "५-२०-९८", "content_sanskrit": "समुद्भवस्समस्तस्य जगतस्त्वं जनार्दन ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7001038098, "chapter_id": 21038, "verse_number": "५-२०-९९", "content_sanskrit": "सापह्नवं मम मनो यदेतत्त्वयि जायते ।\nदेवक्याश्चात्मजप्रीत्या तदत्यंतविडंबना ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7001038099, "chapter_id": 21038, "verse_number": "५-२०-१००", "content_sanskrit": "त्वं कर्त्ता सर्वभूतानामनादिनिधनो भवान् ।\nत्वं मनुष्यस्य कस्यैषा जिह्वा पुत्रेति वक्ष्यति ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7001038100, "chapter_id": 21038, "verse_number": "५-२०-१०१", "content_sanskrit": "जगदेतज्जगन्नाथ संभूतमखिलं यतः ।\nकया युक्त्या विना मायां सोऽस्मत्तः संभविष्यति ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7001038101, "chapter_id": 21038, "verse_number": "५-२०-१०२", "content_sanskrit": "यस्मिन्प्रतिष्ठितं सर्वं जगत्स्थावरजंगमम् ।\nस कोष्ठोत्संगशयनो मानुषो जाय ते कथम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7001038102, "chapter_id": 21038, "verse_number": "५-२०-१०३", "content_sanskrit": "स त्वं प्रसीद परमेश्वर पाहि विश्वमंशावतारकरणैर्न ममासि पुत्रः ।\nआब्रह्यपादपमिदं जगदेतदीश त्वत्तो विमोहयसि किं पुरुषोत्तमास्मान् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7001038103, "chapter_id": 21038, "verse_number": "५-२०-१०४", "content_sanskrit": "मायाविमोहितदृशा तनयो ममेति कंसाद्भयं कृतमपास्तभयोऽतितीव्रम् ।\nनीतोऽसि गोकुलमरातिभया कुलेन वृद्धिं गतोऽसि मम नास्ति ममत्वमीश ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7001038104, "chapter_id": 21038, "verse_number": "५-२०-१०५", "content_sanskrit": "कर्माणि रुद्र मरुदश्विशतक्रतूनां साध्यानि यस्य न भवंति निरीक्षितानि ।\nत्वं विष्णुरीश जगतामुपकारहेतोः प्राप्तोसि नः परिगतो विगतो हि मोहः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}]