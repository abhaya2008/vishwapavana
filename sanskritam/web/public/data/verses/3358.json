[{"id": 2108763, "chapter_id": 3358, "verse_number": "", "content_sanskrit": "शृङ्गी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108764, "chapter_id": 3358, "verse_number": "१", "content_sanskrit": "यद्येतत् साहसं तात यदि वा दुष्कृतं कृतम् ।\nप्रियं वाप्यप्रियं वापि वागुक्ता न मृषा मम \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108765, "chapter_id": 3358, "verse_number": "२", "content_sanskrit": "नैवान्यथा तद् भविता पितरेतद् ब्रवीमि ते ।\nनाहं मृषा ब्रुवन् स्वामिन् स्वैरेष्वपि कुतः शपन्\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108766, "chapter_id": 3358, "verse_number": "", "content_sanskrit": "शमीकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108767, "chapter_id": 3358, "verse_number": "३", "content_sanskrit": "जानाम्यत्युग्रभावं त्वां तात सत्यगिरं तथा ।\nनानृतं ह्युक्तपूर्वं ते नैतन्मिथ्या भविष्यति\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108768, "chapter_id": 3358, "verse_number": "४", "content_sanskrit": "पित्रा पुत्रो वयःस्थोऽपि सततं वाच्य एव च ।\nयथा स्याद् गुणयुक्तश्च प्राप्नुयाच्च महद्यशः\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108769, "chapter_id": 3358, "verse_number": "५", "content_sanskrit": "किं पुनर्बाल एव त्वं तपसा भावितः प्रभो ।\nवर्धते च प्रभवतां कोपोऽतीव महात्मनाम्\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108770, "chapter_id": 3358, "verse_number": "६", "content_sanskrit": "सोऽहं वक्ष्यामि वक्तव्यं त्वयि धर्मवतां वर ।\nपुत्रत्वं बालकत्वं च तवावेक्ष्य च साहसम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108771, "chapter_id": 3358, "verse_number": "७", "content_sanskrit": "स त्वं शमपरो भूत्वा वन्यमाहारमाचरन् ।\nचरन् क्रोधमिमं त्यक्त्वा नैव धर्मं प्रहास्यसि \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108772, "chapter_id": 3358, "verse_number": "८", "content_sanskrit": "क्रोधो हि धर्मं हरति यतीनां दुःखसञ्चितम् ।\nततो धर्मविहीनानां गतिरिष्टा न विद्यते \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2108773, "chapter_id": 3358, "verse_number": "९", "content_sanskrit": "शम एव यतीनां हि क्षमिणां सिद्धिकारकः ।\nक्षमावतामयं लोकः परश्चापि क्षमावताम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2108774, "chapter_id": 3358, "verse_number": "१०", "content_sanskrit": "तस्माच्चरेथाः सततं क्षमाशीलो जितेन्द्रियः ।\nक्षमया प्राप्स्यते लोकं ब्रह्मणः समनन्तरम्\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2108775, "chapter_id": 3358, "verse_number": "११", "content_sanskrit": "मया तु शममास्थाय यच्छक्यं कर्तुमद्य वै ।\nतत् करिष्यामि ताताहं प्रेषयिष्ये नृपाय वै \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2108776, "chapter_id": 3358, "verse_number": "१२", "content_sanskrit": "मम पुत्रेण शप्तोऽसि बालेनाकृतबुद्धिना ।\nममेमां धर्षणां त्वत्तः प्रेक्ष्य राजन्नमर्षिणा \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2108777, "chapter_id": 3358, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2108778, "chapter_id": 3358, "verse_number": "१३", "content_sanskrit": "एवमादिश्य शिष्यं स प्रेषयामास सुव्रतः ।\nपरीक्षिते नृपतये दयापूर्णो महातपाः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2108779, "chapter_id": 3358, "verse_number": "१४", "content_sanskrit": "सन्दिश्य कुशलप्रश्नं कार्यवृत्तान्तमेव च ।\nशिष्यं गौरमुखं नाम शीघ्रवन्तं गुणान्वितम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2108780, "chapter_id": 3358, "verse_number": "१५", "content_sanskrit": "सोऽपगम्य ततः शीघ्रं नरेन्द्रं कुरुवर्धनम् ।\nविवेश भवनं राज्ञः पूर्वं द्वाःर्स्थैर्निवेदितः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2108781, "chapter_id": 3358, "verse_number": "१६", "content_sanskrit": "पूजितस्तु नरेन्द्रेण द्विजो गौरमुखस्ततः ।\nआचख्यौ च परिश्रान्तो राज्ञः सर्वविशेषतः ।\nशमीकवचनं घोरं यथोक्तं मन्त्रिसन्निधौ \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2108782, "chapter_id": 3358, "verse_number": "", "content_sanskrit": "गौरमुखः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2108783, "chapter_id": 3358, "verse_number": "१७", "content_sanskrit": "शमीको नाम राजेन्द्र विषये वर्तते तव ।\nऋषिः शमदमोपेतो मौनव्रतसमन्वितः\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2108784, "chapter_id": 3358, "verse_number": "१८", "content_sanskrit": "तस्य त्वया नरव्याघ्र स्कन्धे भरतसत्तम ।\nअवसक्तो धनुष्कोट्या सर्पः प्राणैर्वियोजितः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2108785, "chapter_id": 3358, "verse_number": "१९", "content_sanskrit": "क्षान्तवांस्तव तत्कर्म पुत्रस्तस्य न चक्षमे ।\nतेन शप्तोऽसि राजेन्द्र पितुरज्ञातमद्य वै \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2108786, "chapter_id": 3358, "verse_number": "२०", "content_sanskrit": "तक्षकात् सप्तरात्रेण मृत्युर्वै ते भविष्यति ।\nतत्र रक्षां कुरुष्वेति पुनः पुनरथाब्रवीत्\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2108787, "chapter_id": 3358, "verse_number": "२१", "content_sanskrit": "तदन्यथा न शक्यं च कर्तुं केनचिदप्युत ।\nन हि शक्नोति संयन्तुं पुत्रं कोपसमन्वितम् ।\nततोऽहं प्रेषितस्तेन तव राजन् हितार्थिना\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2108788, "chapter_id": 3358, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2108789, "chapter_id": 3358, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रुत्वा वचो घोरं स राजा कुरुनन्दनः ।\nपर्यतप्यत तत्पापं कृत्वा ब्रह्मन् महात्मनः\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2108790, "chapter_id": 3358, "verse_number": "२३", "content_sanskrit": "तं च मौनव्रतधरं श्रुत्वा मुनिवरं तदा ।\nभूय एवाभवद् राजा शोकसन्तप्तमानसः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2108791, "chapter_id": 3358, "verse_number": "२४", "content_sanskrit": "अनुक्रोशान्मतं तस्य शमीकस्योपधार्य तु ।\nपर्यतप्यत भूयोऽपि कृत्वा तत् किल्बिषं मुने \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2108792, "chapter_id": 3358, "verse_number": "२५", "content_sanskrit": "न हि मृत्युं तथा राजा श्रुत्वा वै सोऽन्वतप्यत ।\nअशोचदमरप्रख्यो यथा कृत्वेह कर्म तत् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2108793, "chapter_id": 3358, "verse_number": "२६", "content_sanskrit": "ततस्तं पूजयामास राजा गौरमुखं तदा ।\nभूयः प्रसादं भगवान् करोत्विति ममैष वै \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2108794, "chapter_id": 3358, "verse_number": "२७", "content_sanskrit": "श्रुत्वा तद्वचनं राज्ञो मुनिर्गौरमुखस्तदा ।\nतमनुज्ञाप्य वेगेन प्रजगामाश्रमं गुरोः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2108795, "chapter_id": 3358, "verse_number": "२८", "content_sanskrit": "तस्मिंस्तु गतमात्रे तु राजा गौरमुखे तदा ।\nमन्त्रिभिर्मन्त्रयामास सह संविग्नमानसः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2108796, "chapter_id": 3358, "verse_number": "२९", "content_sanskrit": "निश्चित्य मन्त्रिभिश्चैव सहितो मन्त्रतत्त्ववित् ।\nप्रासादं कारयामास एकस्तम्भं सुरक्षितम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2108797, "chapter_id": 3358, "verse_number": "३०", "content_sanskrit": "रक्षां च विदधे तत्र भिषजश्चौषधानि च ।\nब्राह्मणान् सिद्धमन्त्रांश्च सर्वतो वै न्यवेशयत् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2108798, "chapter_id": 3358, "verse_number": "३१", "content_sanskrit": "राजकार्याणि तत्रस्थः सर्वाण्येवाकरोच्च सः ।\nमन्त्रिभिः सह मन्त्रज्ञैः समन्तात् परिरक्षितः\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2108799, "chapter_id": 3358, "verse_number": "३२", "content_sanskrit": "प्राप्ते तु दिवसे तस्मिन् सप्तमे द्विजसत्तम ।\nकाश्यपोऽभ्यागमद् विद्वांस्तं राजानं चिकित्सितुम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2108800, "chapter_id": 3358, "verse_number": "३३", "content_sanskrit": "श्रुतं हि तेन तदभूदद्य तं राजसत्तमम् ।\nतक्षकः पन्नगश्रेष्ठो नेष्यते यमसादनम्\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2108801, "chapter_id": 3358, "verse_number": "३४", "content_sanskrit": "तं दष्टं भुजगेन्द्रेण करिष्येऽहमपज्वरम् ।\nतत्र मेऽर्थश्च धर्मश्च भवेदिति विचिन्तयन् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2108802, "chapter_id": 3358, "verse_number": "३५", "content_sanskrit": "तं ददर्श स नागेन्द्रस्तक्षकः काश्यपं पथि ।\nगच्छन्तमेकमनसं द्विजो भूत्वा वयोऽधिकः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2108803, "chapter_id": 3358, "verse_number": "३६", "content_sanskrit": "तमब्रवीत् पन्नगेन्द्रः काश्यपं मुनिसत्तमम् ।\nक्व भवांस्त्वरितो याति किं च कार्यं चिकीर्षति \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2108804, "chapter_id": 3358, "verse_number": "", "content_sanskrit": "काश्यपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2108805, "chapter_id": 3358, "verse_number": "३७", "content_sanskrit": "नृपं कुरुकुलोत्पन्नं परीक्षितमरिन्दमम् ।\nतक्षकः पन्नगश्रेष्ठस्तेजसाऽद्य प्रधक्ष्यति \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2108806, "chapter_id": 3358, "verse_number": "३८", "content_sanskrit": "तं दष्टं पन्नगेन्द्रेण तेनाग्निसमतेजसा ।\nपाण्डवानां कुलकरं राजानममितौजसम् ।\nगच्छामि सोऽहं त्वरितः सद्यः कर्तुमपज्वरम् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2108807, "chapter_id": 3358, "verse_number": "", "content_sanskrit": "तक्षकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2108808, "chapter_id": 3358, "verse_number": "३९", "content_sanskrit": "अहं स तक्षको ब्रह्मंस्तं धक्ष्यामि महीपतिम् ।\nनिवर्तस्व मया दष्टं न शक्यं स्याच्चिकित्सितुम् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2108809, "chapter_id": 3358, "verse_number": "", "content_sanskrit": "काश्यपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2108810, "chapter_id": 3358, "verse_number": "४०", "content_sanskrit": "अहं तु नृपतिं नाग त्वया दष्टमपज्वरम् ।\nकरिष्य इति मे बुद्धिर्विद्याबलमुपाश्रितः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2108811, "chapter_id": 3358, "verse_number": "३७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यामादिपर्वणि सप्तत्रिंशोऽध्यायः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2108812, "chapter_id": 3358, "verse_number": "२५", "content_sanskrit": "॥ आस्तीकपर्वणि पञ्चविंशोऽध्यायः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]