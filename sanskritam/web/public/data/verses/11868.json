[{"id": 50024606, "chapter_id": 11868, "verse_number": "1", "content_sanskrit": "॥ कण्वो घौरः। मरुतः। गायत्री ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024607, "chapter_id": 11868, "verse_number": "2", "content_sanskrit": "क्री॒ळं व॒ः शर्धो॒ मारु॑तमन॒र्वाणं॑ रथे॒शुभ॑म्। कण्वा॑ अ॒भि प्र गा॑यत॥ ३७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024608, "chapter_id": 11868, "verse_number": "3", "content_sanskrit": "ये पृष॑तीभिरृ॒ष्टिभि॑ः सा॒कं वाशी॑भिर॒ञ्जिभि॑ः। अजा॑यन्त॒ स्वभा॑नवः॥ ३७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024609, "chapter_id": 11868, "verse_number": "4", "content_sanskrit": "इ॒हेव॑ शृण्व एषां॒ कशा॒ हस्ते॑षु॒ यद्वदा॑न्। नि याम॑ञ्चि॒त्रमृ॑ञ्जते॥ ३७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024610, "chapter_id": 11868, "verse_number": "5", "content_sanskrit": "प्र व॒ः शर्धा॑य॒ घृष्व॑ये त्वे॒षद्यु॑म्नाय शु॒ष्मिणे॑। दे॒वत्तं॒ ब्रह्म॑ गायत॥ ३७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024611, "chapter_id": 11868, "verse_number": "6", "content_sanskrit": "प्र शं॑सा॒ गोष्वघ्न्यं॑ क्री॒ळं यच्छर्धो॒ मारु॑तम्। जम्भे॒ रस॑स्य वावृधे॥ ३७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024612, "chapter_id": 11868, "verse_number": "7", "content_sanskrit": "को वो॒ वर्षि॑ष्ठ॒ आ न॑रो दि॒वश्च॒ ग्मश्च॑ धूतयः। यत्सी॒मन्तं॒ न धू॑नु॒थ॥ ३७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024613, "chapter_id": 11868, "verse_number": "8", "content_sanskrit": "नि वो॒ यामा॑य॒ मानु॑षो द॒ध्र उ॒ग्राय॑ म॒न्यवे॑। जिही॑त॒ पर्व॑तो गि॒रिः॥ ३७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024614, "chapter_id": 11868, "verse_number": "9", "content_sanskrit": "येषा॒मज्मे॑षु पृथि॒वी जु॑जु॒र्वाँ इ॑व वि॒श्पति॑ः। भि॒या यामे॑षु॒ रेज॑ते॥ ३७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50024615, "chapter_id": 11868, "verse_number": "10", "content_sanskrit": "स्थि॒रं हि जान॑मेषां॒ वयो॑ मा॒तुर्निरे॑तवे। यत्सी॒मनु॑ द्वि॒ता शव॑ः॥ ३७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50024616, "chapter_id": 11868, "verse_number": "11", "content_sanskrit": "उदु॒ त्ये सू॒नवो॒ गिर॒ः काष्ठा॒ अज्मे॑ष्वत्नत। वा॒श्रा अ॑भि॒ज्ञु यात॑वे॥ ३७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50024617, "chapter_id": 11868, "verse_number": "12", "content_sanskrit": "त्यं चि॑द्घा दी॒र्घं पृ॒थुं मि॒हो नपा॑त॒ममृ॑ध्रम्। प्र च्या॑वयन्ति॒ याम॑भिः॥ ३७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50024618, "chapter_id": 11868, "verse_number": "13", "content_sanskrit": "मरु॑तो॒ यद्ध॑ वो॒ बलं॒ जनाँ॑ अचुच्यवीतन। गि॒रीँर॑चुच्यवीतन॥ ३७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50024619, "chapter_id": 11868, "verse_number": "14", "content_sanskrit": "यद्ध॒ यान्ति॑ म॒रुत॒ः सं ह॑ ब्रुव॒तेऽध्व॒न्ना। शृ॒णोति॒ कश्चि॑देषाम्॥ ३७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50024620, "chapter_id": 11868, "verse_number": "15", "content_sanskrit": "प्र या॑त॒ शीभ॑मा॒शुभि॒ः सन्ति॒ कण्वे॑षु वो॒ दुव॑ः। तत्रो॒ षु मा॑दयाध्वै॥ ३७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50024621, "chapter_id": 11868, "verse_number": "16", "content_sanskrit": "अस्ति॒ हि ष्मा॒ मदा॑य व॒ः स्मसि॑ ष्मा व॒यमे॑षाम्। विश्वं॑ चि॒दायु॑र्जी॒वसे॑॥ ३७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]