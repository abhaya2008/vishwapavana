[{"id": 2191043, "chapter_id": 5067, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2191044, "chapter_id": 5067, "verse_number": "१", "content_sanskrit": "वृत्रस्य तु महाराज ज्वराविष्टस्य सर्वशः ।\nअभवन्यानि लिङ्गानि शरीरे तानि मे शृणु\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2191045, "chapter_id": 5067, "verse_number": "२", "content_sanskrit": "ज्वलितास्योऽभवद्घोरो वैवर्ण्यं चागमत् परम् ।\nगात्रकम्पश्च सुमहान् श्वासश्चाप्यभवन्महान् ।\nरोमहर्षश्च तीव्रोऽभून्निःश्वासश्च महान्नृप\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2191046, "chapter_id": 5067, "verse_number": "३", "content_sanskrit": "शिवा चाशिवसङ्काशा तस्य वक्त्रात् सुदारुणा ।\nनिष्पपात महाघोरा स्मृतिः सा तस्य भारत ।\nउल्काश्च ज्वलितास्तस्य दीप्ताः पार्श्वे प्रपेदिरे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2191047, "chapter_id": 5067, "verse_number": "४", "content_sanskrit": "गृध्रकङ्कवडाश्चैव वाचोऽमुञ्चन् सुदारुणाः ।\nवृत्रस्योपरि संहृष्टाश्चक्रवत् परिबभ्रमुः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2191048, "chapter_id": 5067, "verse_number": "५", "content_sanskrit": "ततस्तं रथमास्थाय देवाप्यायितमाहवे ।\nवज्रोद्यतकरः शक्रस्तं दैत्यं प्रत्यवैक्षत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2191049, "chapter_id": 5067, "verse_number": "६", "content_sanskrit": "अमानुषमथो नादं स मुमोच महासुरः ।\nव्यजृम्भत च राजेन्द्र तीव्रज्वरसमन्वितः॥\nअथास्य जृम्भतः शक्रस्ततो वज्रमवासृजत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2191050, "chapter_id": 5067, "verse_number": "७", "content_sanskrit": "स वज्रः सुमहातेजाः कालाग्निसदृशोपमः ।\nक्षिप्रमेव महाकायं वृत्रं दैत्यमपातयत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2191051, "chapter_id": 5067, "verse_number": "८", "content_sanskrit": "ततो नादः समभवत् पुनरेव समन्ततः ।\nवृत्रं विनिहतं दृष्ट्वा देवानां भरतर्षभ\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2191052, "chapter_id": 5067, "verse_number": "९", "content_sanskrit": "वृत्रं तु हत्वा भगवान्दानवारिर्महायशाः ।\nवज्रेण विष्णुयुक्तेन दिवमेव समाविशत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2191053, "chapter_id": 5067, "verse_number": "१०", "content_sanskrit": "अथ वृत्रस्य कौरव्य शरीरादभिनिःसृता ।\nब्रह्महत्या महाघोरा रौद्रा लोकभयावहा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2191054, "chapter_id": 5067, "verse_number": "११", "content_sanskrit": "करालदशना भीमा विकृता कृष्णपिङ्गला ।\nप्रकीर्णमूर्धजा चैव घोरनेत्रा च भारत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2191055, "chapter_id": 5067, "verse_number": "१२", "content_sanskrit": "कपालमालिनी चैव कृशा च भरतर्षभ ।\nरुधिरार्द्रा च धर्मज्ञ चीरवस्त्रनिवासिनी\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2191056, "chapter_id": 5067, "verse_number": "१३", "content_sanskrit": "साभिनिष्क्रम्य राजेन्द्र तादृग्रूपा भयावहा ।\nवज्रिणं मृगयामास तदा भरतसत्तम\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2191057, "chapter_id": 5067, "verse_number": "१४", "content_sanskrit": "कस्यचित्त्वथ कालस्य वृत्रहा कुरुनन्दन ।\nस्वर्गायाभिमुखः प्रायाल्लोकानां हितकाम्यया\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2191058, "chapter_id": 5067, "verse_number": "१५", "content_sanskrit": "बिसान्निःसरमाणं तु दृष्ट्वा शक्रं महौजसम् ।\nकण्ठे जग्राह देवेन्द्रं सुलग्ना चाभवत्तदा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2191059, "chapter_id": 5067, "verse_number": "१६", "content_sanskrit": "स हि तस्मिन् समुत्पन्ने ब्रह्महत्याकृते भये ।\nनलिन्यां बिसमध्यस्थो बभूवाब्दगणान् बहून्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2191060, "chapter_id": 5067, "verse_number": "१७", "content_sanskrit": "अनुसृत्य तु यत्नात्स तया वै ब्रह्महत्यया ।\nतदा गृहीतः कौरव्य निश्चेष्टः समपद्यत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2191061, "chapter_id": 5067, "verse_number": "१८", "content_sanskrit": "तस्या व्यपोहने शक्रः परं यत्नं चकार ह ।\nन चाशकत्तां देवेन्द्रो ब्रह्महत्यां व्यपोहितुम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2191062, "chapter_id": 5067, "verse_number": "१९", "content_sanskrit": "गृहीत एव तु तया देवेन्द्रो भरतर्षभ ।\nपितामहमुपागम्य शिरसा प्रत्यपूजयत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2191063, "chapter_id": 5067, "verse_number": "२०", "content_sanskrit": "ज्ञात्वा गृहीतं शक्रं तु द्विजप्रवरहत्यया ।\nब्रह्मा सञ्चिन्तयामास तदा भरतसत्तम\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2191064, "chapter_id": 5067, "verse_number": "२१", "content_sanskrit": "तामुवाच महाबाहो ब्रह्महत्यां पितामहः ।\nस्वरेण मधुरेणाथ सान्त्वयन्निव भारत\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2191065, "chapter_id": 5067, "verse_number": "२२", "content_sanskrit": "मुच्यतां त्रिदशेन्द्रोऽयं मत्प्रियं कुरु भामिनि ।\nब्रूहि किं ते करोम्यद्य कामं कं त्वमिहेच्छसि\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2191066, "chapter_id": 5067, "verse_number": "", "content_sanskrit": "ब्रह्महत्या", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2191067, "chapter_id": 5067, "verse_number": "२३", "content_sanskrit": "त्रिलोकपूजिते देवे प्रीते त्रैलोक्यकर्तरि ।\nकृतमेवेह मन्येऽहं निवासं तु विधत्स्व मे\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2191068, "chapter_id": 5067, "verse_number": "२४", "content_sanskrit": "त्वया कृतेयं मर्यादा लोकसंरक्षणार्थिना ।\nस्थापना वै सुमहती त्वया देव प्रवर्तिता\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2191069, "chapter_id": 5067, "verse_number": "२५", "content_sanskrit": "प्रीते तु त्वयि धर्मज्ञ सर्वलोकेश्वरे प्रभो ।\nशक्रादपगमिष्यामि निवासं तु विधत्स्व मे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2191070, "chapter_id": 5067, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2191071, "chapter_id": 5067, "verse_number": "२६", "content_sanskrit": "तथेति तां प्राह तदा ब्रह्महत्यां पितामहः ।\nउपायतः स शक्रस्य ब्रह्महत्यां व्यपोहत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2191072, "chapter_id": 5067, "verse_number": "२७", "content_sanskrit": "ततः स्वयम्भुवा ध्यातस्तत्र वह्निर्महात्मना ।\nब्रह्माणमुपसङ्गम्य ततो वचनमब्रवीत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2191073, "chapter_id": 5067, "verse_number": "२८", "content_sanskrit": "प्राप्तोऽस्मि भगवन्देव त्वत्सकाशमरिन्दम ।\nयत् कर्तव्यं मया देव तद्भवान्वक्तुमर्हति\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2191074, "chapter_id": 5067, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2191075, "chapter_id": 5067, "verse_number": "२९", "content_sanskrit": "बहुधा विभजिष्यामि ब्रह्महत्यामिमामहम् ।\nशक्रस्याद्य विमोक्षार्थं चतुर्भागं प्रतीच्छ मे\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2191076, "chapter_id": 5067, "verse_number": "", "content_sanskrit": "अग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2191077, "chapter_id": 5067, "verse_number": "३०", "content_sanskrit": "मम मोक्षस्य कोऽन्तो वै ब्रह्मन् ध्यायस्व वै प्रभो ।\nएतदिच्छामि विज्ञातुं तत्त्वतो लोकपूजित\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2191078, "chapter_id": 5067, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2191079, "chapter_id": 5067, "verse_number": "३१", "content_sanskrit": "यस्त्वां ज्वलन्तमासाद्य स्वयं वै मानवः क्वचित् ।\nबीजौषधिरसैर्वह्ने न यक्ष्यति तमोवृतः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2191080, "chapter_id": 5067, "verse_number": "३२", "content_sanskrit": "तमेषा यास्यति क्षिप्रं तत्रैव च निवत्स्यति ।\nब्रह्महत्या हव्यवाह व्येतु ते मानसो ज्वरः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2191081, "chapter_id": 5067, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2191082, "chapter_id": 5067, "verse_number": "३३", "content_sanskrit": "इत्युक्तः प्रतिजग्राह तद्वचो हव्यकव्यभुक् ।\nपितामहस्य भगवांस्तथा च तदभूत् प्रभो\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2191083, "chapter_id": 5067, "verse_number": "३४", "content_sanskrit": "ततो वृक्षौषधितृणं समाहूय पितामहः ।\nइममर्थं महाराज वक्तुं समुपचक्रमे\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2191084, "chapter_id": 5067, "verse_number": "३५", "content_sanskrit": "ततो वृक्षौषधितृणं तथैवोक्तं यथातथम् ।\nव्यथितं वह्निवद्राजन् ब्रह्माणमिदमब्रवीत्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2191085, "chapter_id": 5067, "verse_number": "३६", "content_sanskrit": "अस्माकं ब्रह्महत्यातो कोऽन्तो लोकपितामह ।\nस्वभावनिहतानस्मान्न पुनर्हन्तुमर्हसि\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2191086, "chapter_id": 5067, "verse_number": "३७", "content_sanskrit": "वयमग्निं तथा शीतं वर्षं च पवनेरितम् ।\nसहामः सततं देव तथा छेदनभेदनम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2191087, "chapter_id": 5067, "verse_number": "३८", "content_sanskrit": "ब्रह्महत्यामिमामद्य भवतः शासनाद्वयम् ।\nग्रहीष्यामस्त्रिलोकेश मोक्षं चिन्तयतां भवान्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2191088, "chapter_id": 5067, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2191089, "chapter_id": 5067, "verse_number": "३९", "content_sanskrit": "पर्वकाले तु सम्प्राप्ते यो वै छेदनभेदनम् ।\nकरिष्यति नरो मोहात्तमेषानुगमिष्यति\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2191090, "chapter_id": 5067, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2191091, "chapter_id": 5067, "verse_number": "४०", "content_sanskrit": "ततो वृक्षौषधितृणमेवमुक्तं महात्मना ।\nब्रह्माणमभिसम्पूज्य जगामाशु यथागतम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2191092, "chapter_id": 5067, "verse_number": "४१", "content_sanskrit": "आहूयाप्सरसो देवस्ततो लोकपितामहः ।\nवाचा मधुरया प्राह सान्त्वयन्निव भारत\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2191093, "chapter_id": 5067, "verse_number": "४२", "content_sanskrit": "इयमिन्द्रादनुप्राप्ता ब्रह्महत्या वराङ्गनाः ।\nचतुर्थमस्या भागं हि मयोक्ताः सम्प्रतीच्छत\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2191094, "chapter_id": 5067, "verse_number": "", "content_sanskrit": "अप्सरसः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2191095, "chapter_id": 5067, "verse_number": "४३", "content_sanskrit": "ग्रहणे कृतबुद्धीनां देवेश तव शासनात् ।\nमोक्षं समयतोऽस्माकं चिन्तयस्व पितामह\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2191096, "chapter_id": 5067, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2191097, "chapter_id": 5067, "verse_number": "४४", "content_sanskrit": "रजस्वलासु नारीषु यो वै मैथुनमाचरेत् ।\nतमेषा यास्यति क्षिप्रं व्येतु वो मानसो ज्वरः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2191098, "chapter_id": 5067, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2191099, "chapter_id": 5067, "verse_number": "४५", "content_sanskrit": "तथेति हृष्टमनस उक्त्वाथाप्सरसां गणाः ।\nस्वानि स्थानानि सम्प्राप्य रेमिरे भरतर्षभ\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2191100, "chapter_id": 5067, "verse_number": "४६", "content_sanskrit": "ततस्त्रिलोककृद् देवः पुनरेव महातपाः ।\nअपः सञ्चिन्तयामास ध्यातास्ताश्चाप्यथागमन्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2191101, "chapter_id": 5067, "verse_number": "४७", "content_sanskrit": "तास्तु सर्वाः समागम्य ब्रह्माणममितौजसम् ।\nइदमूचुर्वचो राजन् प्रणिपत्य पितामहम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2191102, "chapter_id": 5067, "verse_number": "४८", "content_sanskrit": "इमाः स्म देव सम्प्राप्तास्त्वत्सकाशमरिन्दम ।\nशासनात्तव देवेश समाज्ञापय नो विभो\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2191103, "chapter_id": 5067, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2191104, "chapter_id": 5067, "verse_number": "४९", "content_sanskrit": "इयं वृत्रादनुप्राप्ता पुरुहूतं महाभया ।\nब्रह्महत्या चतुर्थांशमस्या यूयं प्रतीच्छत\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2191105, "chapter_id": 5067, "verse_number": "", "content_sanskrit": "आपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2191106, "chapter_id": 5067, "verse_number": "५०", "content_sanskrit": "एवं भवतु लोकेश यथा वदसि नः प्रभो ।\nमोक्षं समयतोऽस्माकं सञ्चिन्तयितुमर्हसि\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2191107, "chapter_id": 5067, "verse_number": "५१", "content_sanskrit": "त्वं हि देवेश सर्वस्य जगतः परमो गुरुः ।\nकोऽन्यः प्रसादो हि भवेद्यः कृच्छ्रान्नः समुद्धरेत्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2191108, "chapter_id": 5067, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2191109, "chapter_id": 5067, "verse_number": "५२", "content_sanskrit": "अल्पा इति मतिं कृत्वा यो नरो बुद्धिमोहितः ।\nश्लेष्ममूत्रपुरीषाणि युष्मासु प्रतिमोक्ष्यति\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2191110, "chapter_id": 5067, "verse_number": "५३", "content_sanskrit": "तमेषा यास्यति क्षिप्रं तत्रैव च निवत्स्यति ।\nतथा वो भविता मोक्ष इति सत्यं ब्रवीमि वः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2191111, "chapter_id": 5067, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2191112, "chapter_id": 5067, "verse_number": "५४", "content_sanskrit": "ततो विमुच्य देवेन्द्रं ब्रह्महत्या युधिष्ठिर ।\nयथानिसृष्टं तं देशमगच्छद्देवशासनात्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2191113, "chapter_id": 5067, "verse_number": "५५", "content_sanskrit": "एवं शक्रेण सम्प्राप्ता ब्रह्महत्या जनाधिप ।\nपितामहमनुज्ञाप्य सोऽश्वमेधमकल्पयत्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2191114, "chapter_id": 5067, "verse_number": "५६", "content_sanskrit": "श्रूयते हि महाराज सम्प्राप्ता वासवेन वै ।\nब्रह्महत्या ततः शुद्धिं हयमेधेन लब्धवान्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2191115, "chapter_id": 5067, "verse_number": "५७", "content_sanskrit": "समवाप्य श्रियं देवो हत्वारींश्च सहस्रशः ।\nप्रहर्षमतुलं लेभे वासवः पृथिवीपते\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2191116, "chapter_id": 5067, "verse_number": "५८", "content_sanskrit": "वृत्रस्य रुधिराच्चैव खुखुण्डाः पार्थ जज्ञिरे ।\nद्विजातिभिरभक्ष्यास्ते दीक्षितैश्च तपोधनैः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2191117, "chapter_id": 5067, "verse_number": "५९", "content_sanskrit": "सर्वावस्थं त्वमप्येषां द्विजातीनां प्रियं कुरु ।\nइमे हि भूतले देवाः प्रथिताः कुरुनन्दन\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2191118, "chapter_id": 5067, "verse_number": "६०", "content_sanskrit": "एवं शक्रेण कौरव्य बुद्धिसौक्ष्म्यान्महासुरः ।\nउपायपूर्वं निहतो वृत्रोऽथामिततेजसा\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2191119, "chapter_id": 5067, "verse_number": "६१", "content_sanskrit": "एवं त्वमपि कौरव्य पृथिव्यामपराजितः ।\nभविष्यसि यथा देवः शतक्रतुरमित्रहा\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2191120, "chapter_id": 5067, "verse_number": "६२", "content_sanskrit": "ये तु शक्रकथां दिव्यामिमां पर्वसु पर्वसु ।\nविप्रमध्ये पठिष्यन्ति न ते प्राप्स्यन्ति किल्बिषम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2191121, "chapter_id": 5067, "verse_number": "६३", "content_sanskrit": "इत्येतद् वृत्रमाश्रित्य शक्रस्यात्यद्भुतं महत् ।\nकथितं कर्म ते तात किं भूयः श्रोतुमिच्छसि\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2191122, "chapter_id": 5067, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे षोडशाधिकशततमोऽध्यायः ॥११६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]