[{"id": 7003085000, "chapter_id": 23085, "verse_number": "४-२०-१", "content_sanskrit": "श्रीनारायण उवाच ।\nएकदा बालकैः सार्द्धं बलेन सह माधवः।\nभुक्त्वा पीत्वाऽनुलिप्तश्च वृन्दारण्यं जगाम ह ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003085001, "chapter_id": 23085, "verse_number": "४-२०-२", "content_sanskrit": "क्रीडां चकार भगवान्कौतुकेन च तैः सह ।\nक्रीडानि मग्नचित्तानां दूरं तद्गोकुलं ययौ ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003085002, "chapter_id": 23085, "verse_number": "४-२०-३", "content_sanskrit": "तस्य प्रभावं विज्ञातुं विधाता जगतां पतिः ।\nचकार निह्नुतिं गाश्च वत्सांश्च बालकानपि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003085003, "chapter_id": 23085, "verse_number": "४-२०-४", "content_sanskrit": "विज्ञाय तदभिप्रायं सर्वज्ञः सर्वकारकः ।\nपुनश्चकार तत्सर्वं योगीन्द्रो योगमायया ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003085004, "chapter_id": 23085, "verse_number": "४-२०-५", "content_sanskrit": "जगाम श्रीहरिर्गेहं कालयित्वा च गोकुलम् ।\nबलेन बालकैः सार्धं क्रीडाकौतुकमानसः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003085005, "chapter_id": 23085, "verse_number": "४-२०-६", "content_sanskrit": "एवं चकार भगवान्वर्षमेकं च प्रत्यहम् ।\nयमुनागमनं गोभिर्बलेन सह बालकैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003085006, "chapter_id": 23085, "verse_number": "४-२०-७", "content_sanskrit": "ब्रह्मा प्रभावं विज्ञाय लज्जानम्रात्मकन्धरः ।\nआजगाम हरेःस्थानं भाण्डीरवटमूलके ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003085007, "chapter_id": 23085, "verse_number": "४-२०-८", "content_sanskrit": "ददर्श कृष्णं तत्रैव गोपालगणवेष्टितम् ।\nयथा पार्वणचन्द्रं च विभान्तं स्वगणैः सह ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003085008, "chapter_id": 23085, "verse_number": "४-२०-९", "content_sanskrit": "रत्नसिंहासनस्थं च हसन्तं सस्मितं मुदा।\nपीतवस्त्रपरीधानं ज्वलन्तं ब्रह्मतेजसा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003085009, "chapter_id": 23085, "verse_number": "४-२०-१०", "content_sanskrit": "रत्नकेयूरवलयरत्नमञ्जीररञ्जितम्। ।\nरत्नकुण्डलयुग्माभ्यां स्वकपोलस्थलोज्ज्वलम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003085010, "chapter_id": 23085, "verse_number": "४-२०-११", "content_sanskrit": "कोटिकन्दर्पलावण्यं लीलाधाममनोहरम् ।\nचन्दनागुरुकस्तूरीकुङ्कुमार्चितविग्रहम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003085011, "chapter_id": 23085, "verse_number": "४-२०-१२", "content_sanskrit": "पारिजातप्रसूनानां मालाजालैर्विभूषितम् ।\nनवीननीरदश्यामं प्रोद्भिन्ननवयौवनम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003085012, "chapter_id": 23085, "verse_number": "४-२०-१३", "content_sanskrit": "मालतीमाल्यसंयुक्तं मयूरपिच्छचूडकम् ।\nस्वाङ्गसौन्दर्यदीप्त्या च कृतभूषणभूषितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003085013, "chapter_id": 23085, "verse_number": "४-२०-१४", "content_sanskrit": "शरत्पार्वणचन्द्रस्य प्रभामुष्टास्यसुन्दरम् ।\nपक्वबिम्बाधरौष्ठं च खगेन्द्रचञ्चुनासिकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003085014, "chapter_id": 23085, "verse_number": "४-२०-१५", "content_sanskrit": "शरन्मध्याह्नपद्मानां प्रभामोचनलोचनम्।\nमुक्तापङ्क्तिविनिन्द्यैकदन्तपङ्क्तिमनोहरम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003085015, "chapter_id": 23085, "verse_number": "४-२०-१६", "content_sanskrit": "कौस्तुभेन मणीन्द्रेण वक्षःस्थलसमुज्ज्वलम्। ।\nशान्तं च राधिकाकान्तं परिपूर्णतमं परम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003085016, "chapter_id": 23085, "verse_number": "४-२०-१७", "content_sanskrit": "एवंभूतं प्रभुं दृष्ट्वा प्रणनामातिविस्मितः। ।\nदर्शंदर्शमीश्वरं तं प्रणनाम पुनःपुनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003085017, "chapter_id": 23085, "verse_number": "४-२०-१८", "content_sanskrit": "यद्दृष्टं हृदयाम्भोजे तद्रूपं बहिरेव च ।\nया मूर्तिः पुरतो दृष्टा सा पश्चात्परितस्ततः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003085018, "chapter_id": 23085, "verse_number": "४-२०-१९", "content_sanskrit": "तत्र वृन्दावने सर्वं दृष्ट्वा कृष्णसमं मुने ।\nध्यायंध्यायं च तद्रूपं तत्र तस्थौ जगद्गुरुः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003085019, "chapter_id": 23085, "verse_number": "४-२०-२०", "content_sanskrit": "गावो वत्साश्च बालाश्च लतागुल्माश्च वीरुधः ।\nसर्वं वृन्दावनं ब्रह्मा श्यामरूपं ददर्श ह ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003085020, "chapter_id": 23085, "verse_number": "४-२०-२१", "content_sanskrit": "दृष्ट्वैवं परमाश्चर्यं पुनर्ध्यानं चकार ह ।\nददर्श त्रिजगद्ब्रह्मा नान्यत्कृष्णं विना मुने ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003085021, "chapter_id": 23085, "verse_number": "४-२०-२२", "content_sanskrit": "क्व च वृक्षः क्व वा शैलः क्व मही क्व च सागराः ।\nक्व देवाः क्व च गन्धर्वा मुनीन्द्राः क्व च मानवाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003085022, "chapter_id": 23085, "verse_number": "४-२०-२३", "content_sanskrit": "क्व चात्मा क्व जगद्बीजं क्व स्वर्गः क्वायमेव च। ।\nसर्वं च स्वदृशा ब्रह्मा ददर्श मायया हरेः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003085023, "chapter_id": 23085, "verse_number": "४-२०-२४", "content_sanskrit": "क्व कृष्णो जगतां नाथः क्व वा मायाविभूतयः ।\nसर्वं कृष्णमयं दृष्ट्वा किंचिन्निर्वक्तुमक्षमः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003085024, "chapter_id": 23085, "verse_number": "४-२०-२५", "content_sanskrit": "किं स्तौमि किं करोमीति मनसैवं प्रगृह्य च ।\nतत्र स्थित्वा जगद्धाता जपं कर्तुं समुद्यतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003085025, "chapter_id": 23085, "verse_number": "४-२०-२६", "content_sanskrit": "सुखं योगासनं कृत्वा बभूव संपुटाञ्जलिः ।\nपुलकाङ्कितसर्वाङ्गः साश्रुनेत्रोऽतिदीनवत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003085026, "chapter_id": 23085, "verse_number": "४-२०-२७", "content_sanskrit": "इडां सुषुम्नां मध्यां च पिङ्गलां नलिनीं धुराम् ।\nनाडीषट्कं च योगेन निबद्ध्य च प्रयत्नतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003085027, "chapter_id": 23085, "verse_number": "४-२०-२८", "content_sanskrit": "मूलाधारं स्वाधिष्ठानं मणिपूरं मनोहरम् ।\nविशुद्धं परमाज्ञाख्यं षट्चक्रं च निबद्ध्य च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003085028, "chapter_id": 23085, "verse_number": "४-२०-२९", "content_sanskrit": "लङ्घनं कारयित्वा च तत्षट्चक्रं क्रमाद्विधिः। ।\nब्रह्मरन्ध्रं समानीय वायुबन्धं चकार ह ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003085029, "chapter_id": 23085, "verse_number": "४-२०-३०", "content_sanskrit": "निबध्य वायुं मध्यां तामानीय हृदयाम्बुजम्। ।\nतं वायुं भ्रामयित्वा च योजयामास मध्यया ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003085030, "chapter_id": 23085, "verse_number": "४-२०-३१", "content_sanskrit": "एवं कृत्वा तु निष्पन्दो यो दत्तो हरिणा पुरा ।\nजजाप परमं मन्त्रं तस्यैव च दशाक्षरम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003085031, "chapter_id": 23085, "verse_number": "४-२०-३२", "content_sanskrit": "मुहूर्तं च जपं कृत्वा ध्यायंध्यायं पदाम्बुजम् ।\nददर्श हृदयाम्भोजे सर्वतेजोमयं मुने ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003085032, "chapter_id": 23085, "verse_number": "४-२०-३३", "content_sanskrit": "तत्तेजसोऽन्तरे रूपमतीव सुमनोहरम् ।\nद्विभुजं मुरलीहस्तं भूषितं पीतवाससा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003085033, "chapter_id": 23085, "verse_number": "४-२०-३४", "content_sanskrit": "श्रुतिमूलस्थलन्यस्तज्वलन्मकरकुण्डलम् ।\nईषद्धास्यप्रसन्नास्यं भक्तानुग्रहकातरम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003085034, "chapter_id": 23085, "verse_number": "४-२०-३५", "content_sanskrit": "यद्दृष्टं ब्रह्मरन्ध्रे  च हृदि तद्बहिरेव च ।\nदृष्ट्वा च परमाश्चर्यं तुष्टाव परमेश्वरम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003085035, "chapter_id": 23085, "verse_number": "४-२०-३६", "content_sanskrit": "यत्स्तोत्रं च पुरा दत्तं हरिणैकार्णवे मुने ।\nतमीशं तेन विधिना भक्तिनम्रात्मकन्धरः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003085036, "chapter_id": 23085, "verse_number": "४-२०-३७", "content_sanskrit": "ब्रह्मोवाच ।\nसर्वस्वरूपं सर्वेशं सर्वकारणकारणम् ।\nसर्वानिर्वचनीयं तं नमामि शिवरूपिणम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003085037, "chapter_id": 23085, "verse_number": "४-२०-३८", "content_sanskrit": "नवीनजलदाकारं श्यामसुन्दरविग्रहम् ।\nस्थितं जन्तुषु सर्वेषु निर्लिप्तं साक्षिरूपिणम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003085038, "chapter_id": 23085, "verse_number": "४-२०-३९", "content_sanskrit": "स्वात्मारामं पूर्णकामं जगद्व्यापिजगत्परम् ।\nसर्वस्वरूपं सर्वेषां बीजरूपं सनातनम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003085039, "chapter_id": 23085, "verse_number": "४-२०-४०", "content_sanskrit": "सर्वाधारं सर्ववरं सर्वशक्तिसमन्वितम् ।\nसर्वाराध्यं सर्वगुरुं सर्वमङ्गलकारणम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003085040, "chapter_id": 23085, "verse_number": "४-२०-४१", "content_sanskrit": "सर्वमंत्रस्वरूपं च सर्वसंपत्करं वरम् ।\nशक्तियुक्तमयुक्तं च स्तौमि स्वेच्छामयं विभुम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003085041, "chapter_id": 23085, "verse_number": "४-२०-४२", "content_sanskrit": "शक्तीशं शक्तिबीजं च शक्तिरूपधरं वरम् ।\nसंसारसागरे घोरे शक्तिनौकासमन्वितम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003085042, "chapter_id": 23085, "verse_number": "४-२०-४३", "content_sanskrit": "कृपालुं कर्णधारं च नमामि भक्तवत्सलम् ।\nआत्मस्वरूपमेकांतं लिप्तं निर्लिप्तमेव च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003085043, "chapter_id": 23085, "verse_number": "४-२०-४४", "content_sanskrit": "सगुणं निर्गुणं ब्रह्म स्तौमि स्वेच्छास्वरूपिणम्। ।\nसर्वेन्द्रियादिदेवं तमिन्द्रियालयमेव च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003085044, "chapter_id": 23085, "verse_number": "४-२०-४५", "content_sanskrit": "सर्वेन्द्रियस्वरूपं च विराड्रूपं नमाम्यहम् ।\nवेदं च वेदजनकं सर्ववेदाङ्गरूपिणम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003085045, "chapter_id": 23085, "verse_number": "४-२०-४६", "content_sanskrit": "सर्वमन्तस्वरूपं च नमामि परमेश्वरम् ।\nसारात्सारतरं द्रव्यमपूर्वमनिरूपिणम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003085046, "chapter_id": 23085, "verse_number": "४-२०-४७", "content_sanskrit": "स्वतन्त्रमस्वतन्त्रं च यशोदानन्दनं भजे ।\nसन्तं सर्वशरीरेषु तमदृष्टमनूहकम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003085047, "chapter_id": 23085, "verse_number": "४-२०-४८", "content_sanskrit": "ध्यानासाध्यं विद्यमानं योगीन्द्राणां गुरुं भजे ।\nरासमण्डलमध्यस्थं रासोल्लाससमुत्सुकम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003085048, "chapter_id": 23085, "verse_number": "४-२०-४९", "content_sanskrit": "गोपीभिः सेव्यमानं च तं धरेशं नमाम्यहम् ।\nसतां सदैव सन्तं तमसन्तमसतामपि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003085049, "chapter_id": 23085, "verse_number": "४-२०-५०", "content_sanskrit": "योगीशं योगसाध्यं च नमामि शिवसेवितम्। ।\nमन्त्रबीजं मन्त्रराजं मन्त्रदं फलदं फलम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003085050, "chapter_id": 23085, "verse_number": "४-२०-५१", "content_sanskrit": "मन्त्रसिद्धिस्वरूपं तं नमामि च परात्परम् ।\nसुखं दुःखं च सुखदं दुःखदं पुण्यमेव च ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003085051, "chapter_id": 23085, "verse_number": "४-२०-५२", "content_sanskrit": "पुण्यप्रदं च शुभदं शुभबीजं नमाम्यहम् ।\nइत्येवं स्तवनं कृत्वा दत्त्वा गाश्च स बालकान् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003085052, "chapter_id": 23085, "verse_number": "४-२०-५३", "content_sanskrit": "निपत्य दण्डवद्भूमौ रुरोद प्रणनाम च ।\nददर्श चक्षुरुन्मील्य विधाता जगतां मुने ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003085053, "chapter_id": 23085, "verse_number": "४-२०-५४", "content_sanskrit": "ब्रह्मणा च कृतं स्तोत्रं नित्यं भक्त्या च यः पठेत् ।\nइह लोके सुखं भुक्त्वा यात्यन्ते श्रीहरेः पदम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003085054, "chapter_id": 23085, "verse_number": "४-२०-५५", "content_sanskrit": "लभते दास्यमतुलं स्थानमीश्वरसन्निधौ ।\nलब्ध्वा च कृष्णसान्निध्यं पार्षदप्रवरो भवेत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003085055, "chapter_id": 23085, "verse_number": "४-२०-५६", "content_sanskrit": "श्रीनारायण उवाच ।\nगते जगत्कारणे च ब्रह्मलोकं च ब्रह्मणि ।\nश्रीकृष्णो बालकैः सार्धं जगाम स्वालयं विभुः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003085056, "chapter_id": 23085, "verse_number": "४-२०-५७", "content_sanskrit": "गावो वत्साश्च बालाश्च जग्मुर्वर्षान्तरे गृहम् ।\nश्रीकृष्णमायया सर्वे मेनिरे ते दिनान्तरम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003085057, "chapter_id": 23085, "verse_number": "४-२०-५८", "content_sanskrit": "गोपा गोपालिका किंचित्तत्कर्तुं न क्षमास्तदा ।\nयोगिनः कृत्रिमं सर्वं किं नूत्नं वा पुरातनम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003085058, "chapter_id": 23085, "verse_number": "४-२०-५९", "content_sanskrit": "इत्येवं कथितं सर्वं श्रीकृष्णचरितं शुभम् ।\nसुखदं मोक्षदं पुण्यं सर्वकालसुखावहम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]