[{"id": 2158505, "chapter_id": 4433, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2158506, "chapter_id": 4433, "verse_number": "१", "content_sanskrit": "द्वैधीभवति मे चित्तं ह्रिया तुष्ट्या च सञ्जय ।\nयत् सैन्यं मम पुत्रस्य सौभद्रः प्रत्यवारयत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2158507, "chapter_id": 4433, "verse_number": "२", "content_sanskrit": "विस्तरेणैव मे शंस सर्वं गावल्गणे कथम् ।\nविक्रीडितं कुमारस्य स्कन्दस्येवासुरैः सह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2158508, "chapter_id": 4433, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2158509, "chapter_id": 4433, "verse_number": "३", "content_sanskrit": "हन्त ते सम्प्रवक्ष्यामि विमर्दमतिदारुणम् ।\nएकस्य च बहूनां च रणे चिक्रीडितं महत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2158510, "chapter_id": 4433, "verse_number": "४", "content_sanskrit": "अभिमन्युः कृतोत्साहः कृतोत्साहानरिन्दमान् ।\nरथस्थो रथिनः सर्वांस्तावकानभ्यधावत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2158511, "chapter_id": 4433, "verse_number": "५", "content_sanskrit": "द्रोणं कर्णं कृपं शल्यं द्रौणिं भोजं बृहद्बलम् ।\nदुर्योधनं सौमदत्तिं शकुनिं सुबलात्मजम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2158512, "chapter_id": 4433, "verse_number": "६", "content_sanskrit": "नानानृपान् नृपसुतान् सैन्यानि विविधानि च ।\nअलातचक्रवत् सर्वाश्चरन् बाणैरवाकिरत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2158513, "chapter_id": 4433, "verse_number": "७", "content_sanskrit": "निघ्नन्नमित्रान् सौभद्रः परमास्त्रः प्रतापवान् ।\nप्रत्यदृश्यत तेजस्वी दिक्षु सर्वासु भारत\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2158514, "chapter_id": 4433, "verse_number": "८", "content_sanskrit": "तद् दृष्ट्वा चरितं तस्य सौभद्रस्यामितौजसः ।\nसमकम्पन्त सैन्यानि त्वदीयानां पुनःपुनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2158515, "chapter_id": 4433, "verse_number": "९", "content_sanskrit": "अथाब्रवीन्महाप्राज्ञो भारद्वाजो प्रतापवान् ।\nहर्षेणोत्फुल्लनयनः कृपमाभाष्य सस्मितम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2158516, "chapter_id": 4433, "verse_number": "१०", "content_sanskrit": "घट्टयन्निव मर्माणि पुत्रस्य तव भारत ।\nअभिमन्युं तदा दृष्ट्वा रणे वीरं कृतव्रतम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2158517, "chapter_id": 4433, "verse_number": "११", "content_sanskrit": "एष गच्छति सौभद्रः पार्थानामग्रतो युवा ।\nनन्दयन् सुहृदः सर्वान् राजानं च युधिष्ठिरम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2158518, "chapter_id": 4433, "verse_number": "१२", "content_sanskrit": "नकुलं सहदेवं च भीमसेनं च पाण्डवम् ।\nसम्बन्धिबान्धवांश्चान्यान् मध्यस्थान् सुहृदस्तथा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2158519, "chapter_id": 4433, "verse_number": "१३", "content_sanskrit": "नास्य युद्धे समं मन्ये कञ्चिदन्यं धनुर्धरम् ।\nइच्छन् हन्यादिमां सेनां किमर्थमिह नेच्छति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2158520, "chapter_id": 4433, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2158521, "chapter_id": 4433, "verse_number": "१४", "content_sanskrit": "द्रोणस्याप्रियसंयुक्तं श्रुत्वा वाक्यं तवात्मजः ।\nआर्जुनिं प्रति सङ्क्रुद्धो द्रोणं दृष्ट्वा स्मयन्निव\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2158522, "chapter_id": 4433, "verse_number": "१५", "content_sanskrit": "ततो दुर्योधनः कर्णमब्रवीद् बाह्लिकं नृपम् ।\nदुःशासनं मद्रराजं तांस्तांश्चान्यान् महारथान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2158523, "chapter_id": 4433, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2158524, "chapter_id": 4433, "verse_number": "१६", "content_sanskrit": "सर्वमूर्धावसिक्तानामाचार्यो ब्रह्मवित्तमः ।\nअर्जुनस्य सुतं मूढं न हिनस्ति न चेच्छति\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2158525, "chapter_id": 4433, "verse_number": "१७", "content_sanskrit": "न ह्यस्य समरे मुच्येदन्तकोऽप्याततायिनः ।\nकिमङ्ग पुनरेवान्यो मर्त्यः सत्यं ब्रवीमि वः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2158526, "chapter_id": 4433, "verse_number": "१८", "content_sanskrit": "अर्जुनस्य सुतं चैष शिष्यत्वादभिरक्षति ।\nपुत्राः शिष्याश्च दयितास्तदपत्यं च धर्मिणाम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2158527, "chapter_id": 4433, "verse_number": "१९", "content_sanskrit": "संरक्ष्यमाणो द्रोणेन मन्यते वीर्यमात्मनः ।\nआत्मसम्भावितं मूढं सम्प्रमथ्नीत माचिरम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2158528, "chapter_id": 4433, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2158529, "chapter_id": 4433, "verse_number": "२०", "content_sanskrit": "एवमुक्तास्तु राजानः सात्वतीपुत्रमभ्ययुः\nसंरब्धास्तं जिघांसन्तो भारद्वाजस्य पश्यतः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2158530, "chapter_id": 4433, "verse_number": "२१", "content_sanskrit": "दुःशासनस्तु संरब्धं ज्ञात्वा भ्रातरमग्रजम् ।\nतान् निवर्त्य रथोदारानथ भ्रातरमब्रवीत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2158531, "chapter_id": 4433, "verse_number": "२२", "content_sanskrit": "अहमेनं हनिष्यामि राजन् सत्यं ब्रवीमि ते ।\nमिषतां पाण्डवेयानां पाञ्चालानां च पश्यताम्\nग्रसिष्याम्यद्य सौभद्रं स्वर्भानुरिव भास्करम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2158532, "chapter_id": 4433, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2158533, "chapter_id": 4433, "verse_number": "२३", "content_sanskrit": "उत्क्रुश्य चाब्रवीद् राजन् कुरुराजमिदं वचः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2158534, "chapter_id": 4433, "verse_number": "२४", "content_sanskrit": "श्रुत्वा कृष्णौ मया ग्रस्तं सौभद्रमतिमानिनौ ।\nगमिष्यतः प्रेतलोकं जीवलोकान्न संशयः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2158535, "chapter_id": 4433, "verse_number": "२५", "content_sanskrit": "तौ श्रुत्वा तु मृतौ व्यक्तं पाण्डोः क्षेत्रोद्भवाः सुताः ।\nसुहृद्गणास्तदेकाग्राः क्लैब्यात् त्यक्ष्यन्ति जीवितम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2158536, "chapter_id": 4433, "verse_number": "२६", "content_sanskrit": "तस्मादस्मिन् हते शत्रौ हताः सर्वेऽहितास्तव ।\nशिवेन ध्याहि मां राजन्नेष हन्मि रिपुं तव\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2158537, "chapter_id": 4433, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2158538, "chapter_id": 4433, "verse_number": "२७", "content_sanskrit": "एवमुक्त्वा ततो राजन् पुत्रो दुःशासनस्तव ।\nसौभद्रमभ्ययात् क्रुद्धः शरवर्षैरवाकिरत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2158539, "chapter_id": 4433, "verse_number": "२८", "content_sanskrit": "तमभिक्रुद्धमायान्तं तव पुत्रमरिन्दमम् ।\nअभिमन्युः शरैस्तीक्ष्णैः षड्विंशत्या समर्पयत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2158540, "chapter_id": 4433, "verse_number": "२९", "content_sanskrit": "दुःशासनस्तु सङ्क्रुद्धः प्रभिन्न इव कुञ्जरः ।\nआयोधयत च सौभद्रमभिमन्युश्च तं रणे\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2158541, "chapter_id": 4433, "verse_number": "३०", "content_sanskrit": "तौ मण्डलानि चित्राणि रथाभ्यां सव्यदक्षिणम् ।\nचरमाणावयुद्ध्येतां रथशिक्षाविशारदौ\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2158542, "chapter_id": 4433, "verse_number": "३१", "content_sanskrit": "अथ पणवमृदङ्गदुन्दुभीनां\nक्रकचमहानकभेरिझर्झरीणाम् ।\nनिनदमतिभृशं नराः प्रचक्रुः\nलवणजलोद्भवसिंहनादमिश्रम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2158543, "chapter_id": 4433, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि अष्टत्रिंशोऽध्यायः ॥ ३८ ॥\nअभिमन्युवधपर्वणि सप्तमोऽध्यायः ॥ ७ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]