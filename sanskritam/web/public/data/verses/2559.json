[{"id": 2073820, "chapter_id": 2559, "verse_number": "१२-६४-०x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2073821, "chapter_id": 2559, "verse_number": "१२-६४-१", "content_sanskrit": "एवंवीर्यः सर्वधर्मोपपन्नः\nक्षात्रः श्रेष्ठः सर्वधर्मेषु धर्मः।\nपाल्यो युष्माभिर्लोकपालैरुदारै\nर्विपर्यये स्यादभवः प्रजानाम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2073822, "chapter_id": 2559, "verse_number": "१२-६४-२", "content_sanskrit": "भूसस्कारं धर्मसंस्कारयोग्यं\nदीक्षाचर्यां पालनं च प्रजानाम्।\nविद्याद्राज्ञः सर्वभूतानुकम्पा\nदेहत्यागं चाहवे धर्ममग्र्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2073823, "chapter_id": 2559, "verse_number": "१२-६४-३", "content_sanskrit": "त्यागं श्रेष्ठं मुनयो वै वदन्ति\nसर्वश्रेष्ठं यच्छरीरं त्यजन्ति।\nनित्यं व्यक्तं राजधर्मेषु सर्वे\nप्रत्यक्षं ते भूमिपाला यथैते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2073824, "chapter_id": 2559, "verse_number": "१२-६४-४", "content_sanskrit": "बहुश्रुत्या गुरुशुश्रूषया वा\nपरस्पराः संहननाद्वदन्ति।\nनित्यं धर्मं क्षत्रियो ब्रह्मचारी।\nचरेदेको ह्याश्रमं धर्मकामः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2073825, "chapter_id": 2559, "verse_number": "१२-६४-५", "content_sanskrit": "सामान्यार्थे व्यवहारे प्रवृत्ते\nप्रियाप्रिये वर्जयन्नैव यत्नात्।\nचातुर्वर्ण्यं स्थापनात्पालनाच्च\nतैस्तैर्योगैर्नियमैरौषधैश्च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2073826, "chapter_id": 2559, "verse_number": "१२-६४-६", "content_sanskrit": "सर्वोद्योगैराश्रमं धर्ममाहुः\nक्षात्रं श्रेष्ठं सर्वधर्मोपपन्नम्।\nवंस्वं धर्मं येन चरन्ति वर्णा\nस्तांस्तान्धर्मानन्यथार्थान्वदन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2073827, "chapter_id": 2559, "verse_number": "१२-६४-७", "content_sanskrit": "नेर्मर्यादान्नित्यमर्थे निविष्टा\nनाहुस्तान्वै पशुभूतान्मनुष्यान्।\nयथा नीतिं गमयत्यर्थयोगा\nच्छ्रेयस्तस्मादाश्रमात्क्षत्रधर्मः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2073828, "chapter_id": 2559, "verse_number": "१२-६४-८", "content_sanskrit": "त्रैविद्यानां या गतिर्ब्राह्मणानां\nये चैवोक्ताः स्वाश्रमा ब्राह्मणानाम्।\nएतत्कर्म क्षत्रियस्याहुरग्र्य\nमन्यत्कुर्वञ्छूद्रवच्छस्त्रवध्यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2073829, "chapter_id": 2559, "verse_number": "१२-६४-९", "content_sanskrit": "चातुराश्रम्यधर्माश्च वेदवादाश्च पार्थिव।\nब्राह्मणेनानुगन्तव्या नान्यो विद्यात्कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2073830, "chapter_id": 2559, "verse_number": "१२-६४-१०", "content_sanskrit": "अन्यथा वर्तमानस्य न सा वृत्तिः प्रकल्प्यते।\nकर्मणा वर्धते धर्मो यथा धर्मस्तथैव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2073831, "chapter_id": 2559, "verse_number": "१२-६४-११", "content_sanskrit": "यो विकर्मस्थितो विप्रो न स सन्मानमर्हति।\nकर्म स्वमप्रयुञ्जानमविश्वास्यं हि तं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2073832, "chapter_id": 2559, "verse_number": "१२-६४-१२", "content_sanskrit": "एते वर्णाः सर्वधर्मैश्च हीना\nउत्क्रष्टव्याः क्षत्रियैरेव धर्माः।\nतस्माच्छ्रेष्ठा राजधर्मा न चान्ये\nवीर्यश्रेष्ठा राजधर्मा मता मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2073833, "chapter_id": 2559, "verse_number": "१२-६४-१३x", "content_sanskrit": "मान्धातोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2073834, "chapter_id": 2559, "verse_number": "१२-६४-१३", "content_sanskrit": "यवनाः किराता गान्धाराश्चीनाः शबरबर्बराः।\nशकास्तुषाराः कङ्काश्च पल्लवाश्चान्ध्रमद्रकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2073835, "chapter_id": 2559, "verse_number": "१२-६४-१४", "content_sanskrit": "उष्ट्राः पुलिन्दा आरट्टाः काचा म्लेच्छाश्च सर्वशः।\nब्रह्मक्षत्रप्रसूताश्च वैश्याः शूद्राश्च मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2073836, "chapter_id": 2559, "verse_number": "१२-६४-१५", "content_sanskrit": "कथं धर्मांश्चरिष्यन्ति सर्वे विषयवासिनः।\nमद्विधैश्च कथं स्थाप्याः सर्वे वै दस्युजीविनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2073837, "chapter_id": 2559, "verse_number": "१२-६४-१६", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं मघवंस्तद्ब्रवीहि मे।\nत्वं बन्धुभूतो ह्यस्माकं क्षत्रियाणां सुरेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2073838, "chapter_id": 2559, "verse_number": "१२-६४-१७x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2073839, "chapter_id": 2559, "verse_number": "१२-६४-१७", "content_sanskrit": "मातापित्रोर्हि शुश्रूषा कर्तव्या सर्वदस्युभिः।\nआचार्यगुरुशुश्रूषा तथैवाश्रमवासिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2073840, "chapter_id": 2559, "verse_number": "१२-६४-१८", "content_sanskrit": "भूमिपानां च शुश्रूषा कर्तव्या सर्वदस्युभिः।\nदेशधर्मक्रियाश्चैव तेषां धर्मो विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2073841, "chapter_id": 2559, "verse_number": "१२-६४-१९", "content_sanskrit": "पितृयज्ञास्तथा कूपाः प्रपाश्च शयनानि च।\nदानानि च यथाकालं दातव्यानि द्विजातिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2073842, "chapter_id": 2559, "verse_number": "१२-६४-२०", "content_sanskrit": "अहिंसा सत्यमक्रोधो वृत्तिदायानुपालनम्।\nभरणं पुत्रदाराणां शौचमद्रोह एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2073843, "chapter_id": 2559, "verse_number": "१२-६४-२१", "content_sanskrit": "दक्षिणा सर्वयज्ञानां दातव्या धर्ममिच्छता।\nपाकयज्ञा महार्थाश्च दातव्याः सर्वदस्युभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2073844, "chapter_id": 2559, "verse_number": "१२-६४-२२", "content_sanskrit": "एतान्येवंप्रकाराणि विहितानि पुराऽनघ।\nसर्वलोकस्य कर्माणि कर्तव्यानीह पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2073845, "chapter_id": 2559, "verse_number": "१२-६४-२३x", "content_sanskrit": "मान्धातोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2073846, "chapter_id": 2559, "verse_number": "१२-६४-२३", "content_sanskrit": "दृश्यन्ते मानुषे लोके सर्ववर्णेषु दस्यवः।\nलिङ्गान्तरे वर्तमाना आश्रमेषु तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2073847, "chapter_id": 2559, "verse_number": "१२-६४-२४x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2073848, "chapter_id": 2559, "verse_number": "१२-६४-२४", "content_sanskrit": "विनष्टायां दण्डनीत्यां राजधर्मे विनाकृते।\nसंप्रमुह्यन्ति भूतानि राजदौरात्म्यतोऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2073849, "chapter_id": 2559, "verse_number": "१२-६४-२५", "content_sanskrit": "असङ्ख्याता भविष्यन्ति भिक्षवो लिङ्गिनस्तथा।\nआश्रमाणां विकल्पाश्च वृत्तेऽस्मिन्वैकृते युगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2073850, "chapter_id": 2559, "verse_number": "१२-६४-२६", "content_sanskrit": "अशृण्वानाः पुराणानां धर्माणां शतशो नराः।\nउत्पथं प्रतिपत्स्यन्ते काममन्युसमीरिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2073851, "chapter_id": 2559, "verse_number": "१२-६४-२७", "content_sanskrit": "यदा निवर्त्यते पापो दण्डनीत्या महात्मभिः।\nतदा धर्मो न चलते संभूतः शाश्वतः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2073852, "chapter_id": 2559, "verse_number": "१२-६४-२८", "content_sanskrit": "सर्वलोकगुरुं चैव राजानं योऽवमन्यते।\nन तस्य दत्तं न कृतं न श्रुतं फलति क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2073853, "chapter_id": 2559, "verse_number": "१२-६४-२९", "content_sanskrit": "मानुषाणामधिपतिं देवभूतं महाद्युतिम्।\nदेवाश्च बहुमन्यन्ते धर्मकामं नरेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2073854, "chapter_id": 2559, "verse_number": "१२-६४-३०", "content_sanskrit": "प्रजापतिर्हि भगवान्यः सर्वमसृजज्जगत्।\nस प्रवृत्तिनिवृत्त्यर्थं धर्माणां क्षत्रमिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2073855, "chapter_id": 2559, "verse_number": "१२-६४-३१", "content_sanskrit": "प्रवृत्तस्य हि धर्मस्य बुद्ध्या यः स्मरते गतिम्।\nस मे मान्यश्च पूज्यश्च स च क्षत्रे प्रतिष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2073856, "chapter_id": 2559, "verse_number": "१२-६४-३२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2073857, "chapter_id": 2559, "verse_number": "१२-६४-३२", "content_sanskrit": "एवमुक्त्वा स भगवान्मरुद्गणवृतः प्रभुः।\nजगाम भवनं विष्णुरक्षरं शाश्वतं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2073858, "chapter_id": 2559, "verse_number": "१२-६४-३३", "content_sanskrit": "एवं प्रवर्तिते धर्मे पुरा सुचरितेऽनघ।\nकः क्षत्रमतिवर्तेत चेतनावान्बहुश्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2073859, "chapter_id": 2559, "verse_number": "१२-६४-३४", "content_sanskrit": "अन्यायेन प्रवृत्तानि निवृत्तानि तथैव च।\nअन्तरा विलयं यान्ति यथा पथि विचक्षुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2073860, "chapter_id": 2559, "verse_number": "१२-६४-३५", "content_sanskrit": "आदौ प्रवर्तिते चक्रे तथैवादिपरायणे।\nवर्तस्व पुरुषव्याघ्र संविजानामि तेऽनघ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2073861, "chapter_id": 2559, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि चतुःषष्टितमोऽध्यायः॥ ६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]