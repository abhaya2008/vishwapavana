[{"id": 7006166000, "chapter_id": 26166, "verse_number": "१-२-२७-१", "content_sanskrit": "सूत उवाच ।\nयुगेषु यास्तु जायन्ते प्रजास्ता मे निबोधत ।\nआसुरी सर्पगांधर्वा पैशाची यक्षराक्षसी ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006166001, "chapter_id": 26166, "verse_number": "१-२-२७-२", "content_sanskrit": "यस्मिन्युगे च संभूति स्तासां यावच्च जीवितम् ।\nपिशाचासुरगंधर्वां यक्षराक्षसपन्नगाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006166002, "chapter_id": 26166, "verse_number": "१-२-२७-३", "content_sanskrit": "परिणाहोच्छ्रयैस्तुल्या जायंते ह कृते युगे ।\nषण्णवत्यंगुलो त्सेधो ह्यष्टानां देवजन्मनाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006166003, "chapter_id": 26166, "verse_number": "१-२-२७-४", "content_sanskrit": "स्वेनांगुलप्रमाणेन निष्पन्नेन च पौष्टिकात् ।\nएतत्स्वाभाविकं तेषां प्रमाणमिति कुर्वते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006166004, "chapter_id": 26166, "verse_number": "१-२-२७-५", "content_sanskrit": "मनुष्या वर्तमानास्तु युगं संध्याशकेष्विह ।\nदेवासुरप्रमाणं तु सप्तसप्तंगुलादसत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006166005, "chapter_id": 26166, "verse_number": "१-२-२७-६", "content_sanskrit": "अंगुलानां शतं पूर्णमष्टपंचाशदुत्तरम् ।\nदेवासुरप्रमाणं तु उच्छ्रयात्कलिजैः स्मृतम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006166006, "chapter_id": 26166, "verse_number": "१-२-२७-७", "content_sanskrit": "चत्वारश्चाप्यशीतिश्च कलिजैरंगुलैः स्मृतः ।\nस्वेनांगुलिप्रमाणेन ऊर्द्ध्वमापादमस्तकात् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006166007, "chapter_id": 26166, "verse_number": "१-२-२७-८", "content_sanskrit": "इत्येष मानुषोत्सेधो ह्रसतीह युगांशके ।\nसर्वेषु युगकालेषु अतीतानागतेष्विह ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006166008, "chapter_id": 26166, "verse_number": "१-२-२७-९", "content_sanskrit": "स्वेनांगुलिप्रमाणेन अष्टतालः स्मृतो नरः ।\nआपादतलमस्तिष्को नवतालो भवेत्तु यः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006166009, "chapter_id": 26166, "verse_number": "१-२-२७-१०", "content_sanskrit": "संहता जानुबाहुस्तु स सुरैरपि पूज्यते ।\nगवाश्वहस्तिनां चैव महिष स्यावरात्मनाम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006166010, "chapter_id": 26166, "verse_number": "१-२-२७-११", "content_sanskrit": "कर्मणैतेन विज्ञेये ह्रासवृद्धी युगे युगे ।\nषट्सप्तत्यंगुलोत्सेधः पशूनां ककुदस्तु वै ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006166011, "chapter_id": 26166, "verse_number": "१-२-२७-१२", "content_sanskrit": "अंगुलाष्टशतं पूर्णमुत्सेधः करिणां स्मृतः ।\nअंगुलानां सहस्रं तु चत्वारिंशांगुलैर्विना ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006166012, "chapter_id": 26166, "verse_number": "१-२-२७-१३", "content_sanskrit": "पञ्चाशता यवानां च उत्सेधः शाखिनां स्मृतः ।\nमानुषस्य शरीरस्य सन्निवेशस्तु यादृशः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006166013, "chapter_id": 26166, "verse_number": "१-२-२७-१४", "content_sanskrit": "तल्लक्षणस्तु देवानां दृश्येत तत्त्वदर्शनात् ।\nबुद्ध्यातिशययुक्तश्च देवानां काय उच्यते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006166014, "chapter_id": 26166, "verse_number": "१-२-२७-१५", "content_sanskrit": "तथा सातिशयस्छैव मानुषः काय उच्यते ।\nइत्येते वै परिक्रांता भावा ये दिव्यमानुषाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006166015, "chapter_id": 26166, "verse_number": "१-२-२७-१६", "content_sanskrit": "पशूनां पक्षिणां चैव स्थावराणां च सर्वशः ।\nगावो ह्यजावयोऽश्वाश्च हस्तिनः पक्षिणो नगाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006166016, "chapter_id": 26166, "verse_number": "१-२-२७-१७", "content_sanskrit": "उपयुक्ताः क्रियास्वेते यज्ञियास्विह सर्वशः ।\nदेवस्थानेषु जायन्ते तद्रूपा एव ते पुनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006166017, "chapter_id": 26166, "verse_number": "१-२-२७-१८", "content_sanskrit": "यथाशयोपभोगास्तु देवानां शुभमूर्त्तयः ।\nतेषां रूपानुरूपैस्तु प्रमाणैः स्थाणुजंगमैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006166018, "chapter_id": 26166, "verse_number": "१-२-२७-१९", "content_sanskrit": "मनोज्ञैस्तत्र भावैस्ते सुखिनो ह्युपपेदिरे ।\nअतः शिष्टान्प्रवक्ष्यामि सतः साधूंस्तथैव च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006166019, "chapter_id": 26166, "verse_number": "१-२-२७-२०", "content_sanskrit": "सदिति ब्रह्मणः शब्दस्तद्वंतो ये भवंत्युत ।\nसाजात्याद्ब्रह्मणस्त्वेते तेन सन्तः प्रचक्षते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006166020, "chapter_id": 26166, "verse_number": "१-२-२७-२१", "content_sanskrit": "दशात्मके ये विषये कारणे चाष्टलक्षणे ।\nन क्रुध्यंति न त्दृष्यंति जितात्मानस्तु ते स्मृताः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006166021, "chapter_id": 26166, "verse_number": "१-२-२७-२२", "content_sanskrit": "सामान्येषु तु धर्मेषु तथा वैशेषिकेषु च ।\nब्रह्मक्षत्रविशो यस्माद्युक्तास्तस्मा द्द्विजातयः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006166022, "chapter_id": 26166, "verse_number": "१-२-२७-२३", "content_sanskrit": "वर्णाश्रमेषु युक्तस्य स्वर्गतौ सुखचारिमः ।\nश्रौतस्मार्तस्य धर्मस्य ज्ञानाद्धर्मज्ञ उच्यते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006166023, "chapter_id": 26166, "verse_number": "१-२-२७-२४", "content_sanskrit": "विद्यायाः साधनात्साधुर्ब्रह्मचारी गुरोर्हितः ।\nगृहाणां साधनाच्चैव गृहस्थः साधुरुच्यते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006166024, "chapter_id": 26166, "verse_number": "१-२-२७-२५", "content_sanskrit": "साधनात्तपसोऽरण्ये साधुर्वैखानसः स्मृतः ।\nयतमानो यतिः साधुः स्मृतो योगस्य साधनात् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006166025, "chapter_id": 26166, "verse_number": "१-२-२७-२६", "content_sanskrit": "एवमाश्रमधर्माणां साधनात्साधवः स्मृताः ।\nगृहस्थो ब्रह्मचारी च वानप्रस्थो यतिस्तथा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006166026, "chapter_id": 26166, "verse_number": "१-२-२७-२७", "content_sanskrit": "अथ देवा न पितरो मुनयो न च मानुषाः ।\nअयं धर्मो ह्ययं नेति विंदते भिन्नदर्शनाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006166027, "chapter_id": 26166, "verse_number": "१-२-२७-२८", "content_sanskrit": "धर्माधर्माविहप्रोक्तौ शब्दावेतौ क्रियात्मकौ ।\nकुशलाकुशलं कर्म धर्माधर्माविह स्मृताम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006166028, "chapter_id": 26166, "verse_number": "१-२-२७-२९", "content_sanskrit": "धारणर्थो धृतिश्चैव धातुः शब्दे प्रकीर्त्तितः ।\nअधारणामहत्त्वे च अधर्म इति चोच्यते ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006166029, "chapter_id": 26166, "verse_number": "१-२-२७-३०", "content_sanskrit": "अथेष्टप्रापको धर्म आचार्यैरुपदिश्यते ।\nअधर्मश्चानिष्टफलोह्याचार्यैरुपदिश्यते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006166030, "chapter_id": 26166, "verse_number": "१-२-२७-३१", "content_sanskrit": "वृद्धाश्चालोलुपाश्चैव त्वात्मवन्तो ह्यदांभिकाः ।\nसम्यग्विनीता ऋजवस्तानाचार्यान्प्रजक्षते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006166031, "chapter_id": 26166, "verse_number": "१-२-२७-३२", "content_sanskrit": "स्वयमाचरते यस्मादाचारं स्थापयत्यपि ।\nआचिनोति च शास्त्राणि आचार्यस्तेन चोच्यते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006166032, "chapter_id": 26166, "verse_number": "१-२-२७-३३", "content_sanskrit": "धर्मज्ञैर्विहितो धर्मः श्रौतः स्मार्त्तो द्विधा द्विजैः ।\nदाराग्निहोत्रसम्बन्धाद्द्विधा श्रौतस्य लक्षणम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006166033, "chapter_id": 26166, "verse_number": "१-२-२७-३४", "content_sanskrit": "स्मार्त्तो वर्णाश्रमाचारैर्यमैः सनियमैः स्मृतः ।\nपूर्वेभ्यो वेदयित्वेह श्रौतं सप्तर्ष योऽब्रुवन् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006166034, "chapter_id": 26166, "verse_number": "१-२-२७-३५", "content_sanskrit": "ऋचो यजूंसामानि ब्रह्मणोऽङ्गानि च श्रुतिः ।\nमन्वंतरस्यातीतस्य स्मृत्वाचारान्मनुर्जगौ ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006166035, "chapter_id": 26166, "verse_number": "१-२-२७-३६", "content_sanskrit": "तस्मा त्स्मार्त्तः धर्मो वर्णाश्रमविभाजकः ।\nस एष विविधो धर्मः शिष्टाचार इहोच्यते ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006166036, "chapter_id": 26166, "verse_number": "१-२-२७-३७", "content_sanskrit": "शेषशब्दः शिष्ट इति शेषं शिष्टं प्रचक्षते ।\nमन्वंतरेषु ये शिष्टा इह तिष्ठंति धार्मिकाः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006166037, "chapter_id": 26166, "verse_number": "१-२-२७-३८", "content_sanskrit": "मनुः सप्तर्षयश्चैव लोकसंतानकारमात् ।\nधर्मार्थं ये च तिष्ठंति ताञ्छिष्टान्वै प्रचक्षते ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006166038, "chapter_id": 26166, "verse_number": "१-२-२७-३९", "content_sanskrit": "मन्वादयश्च येऽशिष्टा ये मया प्रागुदीरिताः ।\nतैः शिष्टैश्चरितो धर्मः सम्यगेव युगे युगे ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006166039, "chapter_id": 26166, "verse_number": "१-२-२७-४०", "content_sanskrit": "त्रयी वार्त्ता दंडनीतिरिज्या वर्णाश्रमास्तथा ।\nशिष्टैराचर्यते यस्मान्मनुना च पुनः पुनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006166040, "chapter_id": 26166, "verse_number": "१-२-२७-४१", "content_sanskrit": "पूर्वैः पूर्वगतत्वाच्च शिष्टाचारः स सात्वतः ।\nदानं सत्यं तपो ज्ञानं विद्येज्या व्रजनं दया ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006166041, "chapter_id": 26166, "verse_number": "१-२-२७-४२", "content_sanskrit": "अष्टौ तानि चरित्राणि शिष्टाचारस्य लक्षणम् ।\nशिष्टा यस्माच्चरंत्येनं मनुः सप्तर्षयस्तु वै ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006166042, "chapter_id": 26166, "verse_number": "१-२-२७-४३", "content_sanskrit": "मन्वंतरेषु सर्वेषु शिष्टाचारस्ततः स्मृतः ।\nविज्ञेयः श्रवणाच्छ्रौतः स्मरणात्स्मार्त्त उच्यते ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006166043, "chapter_id": 26166, "verse_number": "१-२-२७-४४", "content_sanskrit": "इज्यावेदात्मकः श्रौतः स्मार्त्तो वर्णाश्रमात्मकः ।\nप्रत्यंगानि च वक्ष्यामि धर्मस्येह तु लक्षणम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006166044, "chapter_id": 26166, "verse_number": "१-२-२७-४५", "content_sanskrit": "दृष्ट्वा तु भूतमर्थं यः पृष्टो वै न निगू हति ।\nयथा भूतप्रवादस्तु इत्येतत्सत्यलक्षणम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006166045, "chapter_id": 26166, "verse_number": "१-२-२७-४६", "content_sanskrit": "ब्रह्मचर्यं जपो मौनं निराहारत्वमेव च ।\nइत्येतत्तपसो रूपं सुघोरं सुदुरा सदम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006166046, "chapter_id": 26166, "verse_number": "१-२-२७-४७", "content_sanskrit": "पशूनां द्रव्यहविषामृक्सामयजुषां तथा ।\nऋत्विजां दक्षिणानां च संयोगो यज्ञ उच्यते ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006166047, "chapter_id": 26166, "verse_number": "१-२-२७-४८", "content_sanskrit": "आत्मवत्सर्वभूतेषु या हितायाहिताय च ।\nप्रवर्त्तंते समा दृष्टिः कृत्स्नाप्येषा दया स्मृता ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006166048, "chapter_id": 26166, "verse_number": "१-२-२७-४९", "content_sanskrit": "आक्रुष्टो निहतो वापि नाक्रोशेद्यो न हंति च ।\nवाङ्मनःकर्मभिर्वेत्ति तितिक्षैषा क्षमा स्मृता ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006166049, "chapter_id": 26166, "verse_number": "१-२-२७-५०", "content_sanskrit": "स्वामिना रक्ष्यमाणानामुत्सृष्टानां च संभ्रमे ।\nपरस्वानामनादानमलोभ इति कीर्त्यते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006166050, "chapter_id": 26166, "verse_number": "१-२-२७-५१", "content_sanskrit": "मैथुनस्यासमाचारो न चिंता नानुजल्पनम् ।\nनिवृत्तिर्ब्रह्मचर्यं तदच्छिद्रं तप उच्यते ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006166051, "chapter_id": 26166, "verse_number": "१-२-२७-५२", "content_sanskrit": "आत्मार्थं वा परार्थं वा चेंद्रियाणीह यस्य वै ।\nमिथ्या न संप्रवर्त्तंते शामस्यैतत्तु लक्षमम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006166052, "chapter_id": 26166, "verse_number": "१-२-२७-५३", "content_sanskrit": "दशात्मके यो विषये कारणे चाष्टलक्षणे ।\nन क्रुद्ध्येत प्रतिहतः स जितात्मा विभाव्यते ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006166053, "chapter_id": 26166, "verse_number": "१-२-२७-५४", "content_sanskrit": "यद्यदिष्टतमं द्रव्यं न्यायेनैवागतं च यत् ।\nतत्तद्गुणवते देयमित्येतद्दानलक्षणम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006166054, "chapter_id": 26166, "verse_number": "१-२-२७-५५", "content_sanskrit": "दानं त्रिविधमित्येतत्कनिष्ठज्येष्ठमध्यमम् ।\nतत्र नैश्रेयसं ज्येष्ठं कनिष्ठं स्वार्थसिद्धये ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006166055, "chapter_id": 26166, "verse_number": "१-२-२७-५६", "content_sanskrit": "कारुण्यात्सर्वभूतेषु संविभागस्तु मध्यमः ।\nश्रुतिस्मृतिभ्यां विहितो धर्मो वर्माश्रमात्मकः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006166056, "chapter_id": 26166, "verse_number": "१-२-२७-५७", "content_sanskrit": "शिष्टाचाराविरुद्धश्च धर्मः सत्साधुसंमतः ।\nअप्रद्वेषोह्यनि ष्टेषु तथेष्टस्याभिनंदनम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006166057, "chapter_id": 26166, "verse_number": "१-२-२७-५८", "content_sanskrit": "प्रीतितापविषादेभ्यो विनिवृत्तिर्विरक्तता ।\nसंन्यासः कर्मणां न्यासः कृतानामकृतैः सह ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006166058, "chapter_id": 26166, "verse_number": "१-२-२७-५९", "content_sanskrit": "कुशलाकुशलानां तु प्रहाणं न्यास उच्यते ।\n्व्यक्ता ये विशेषास्ते विकारेऽस्मिन्नचेतने ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006166059, "chapter_id": 26166, "verse_number": "१-२-२७-६०", "content_sanskrit": "चेतनाचेतनान्यत्वविज्ञानं ज्ञानमुच्यते ।\nप्रत्यंगानां तु धर्मस्य त्वित्येतल्लक्षणं स्मृतम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006166060, "chapter_id": 26166, "verse_number": "१-२-२७-६१", "content_sanskrit": "ऋषिभिर्धर्मतत्त्वज्ञैः पूर्वं स्वायंभुवेऽन्तरे ।\nअत्र वो वर्णयिष्यामि विधिं मन्वंतरस्य यः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006166061, "chapter_id": 26166, "verse_number": "१-२-२७-६२", "content_sanskrit": "तथैव चातुर्होत्रस्य चातुर्विद्यस्य चैव हि ।\nप्रतिमन्वंतरे चैव श्रुतिरन्या विधीयते ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006166062, "chapter_id": 26166, "verse_number": "१-२-२७-६३", "content_sanskrit": "ऋचो यजूंषि समानि यथा च प्रतिदैवतम् ।\nआभूतसंप्लवस्यापि वर्ज्यैकं शतरुद्रियम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006166063, "chapter_id": 26166, "verse_number": "१-२-२७-६४", "content_sanskrit": "विधिर्हौत्रस्तथा स्तोत्रं पूर्ववत्संप्रवर्तते ।\nद्रव्यस्तोत्रं गुणस्तोत्रं फलस्तोत्रं तथैव च ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006166064, "chapter_id": 26166, "verse_number": "१-२-२७-६५", "content_sanskrit": "चतुर्थमाभिजनकं स्तोत्रमेतच्चतुर्विधम् ।\nमन्वंतरेषु सर्वेषु यथा देवा भवंति ये ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006166065, "chapter_id": 26166, "verse_number": "१-२-२७-६६", "content_sanskrit": "प्रवर्तयति तेषां वै ब्रह्मा स्तोत्रं चतुर्विधम् ।\nएवं मंत्रगणानां तु समुत्पत्तिश्चतुर्विधा ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006166066, "chapter_id": 26166, "verse_number": "१-२-२७-६७", "content_sanskrit": "अथर्वगर्यजुषां साम्नां वेदेष्विह पृथक्पृथक् ।\nऋषीणां तप्यतामुग्रं तपः परमदुष्करम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006166067, "chapter_id": 26166, "verse_number": "१-२-२७-६८", "content_sanskrit": "मंत्राः प्रादुर्बभूवुर्हि पूर्वमन्वंतरेष्विह ।\nअसंतोषाद्भया द्दुःखात्सुखाच्छोकाच्च पंचधा ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006166068, "chapter_id": 26166, "verse_number": "१-२-२७-६९", "content_sanskrit": "ऋषीणां तारकाख्येन दर्शनेन यदृच्छया ।\nऋषीणां यदृषित्वं हि तद्वक्ष्यामीह लक्षणैः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006166069, "chapter_id": 26166, "verse_number": "१-२-२७-७०", "content_sanskrit": "अतीतानागतानां च पंचधा त्वृषिरुच्यते ।\nअतस्त्वृषीणां वक्ष्यामि तत्र ह्यार्षसमुद्भवम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006166070, "chapter_id": 26166, "verse_number": "१-२-२७-७१", "content_sanskrit": "गुणसाम्ये वर्त्तमाने सर्वसंप्रलये तदा ।\nअविभागे तु वेदानामनिर्देश्ये तमोमये ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006166071, "chapter_id": 26166, "verse_number": "१-२-२७-७२", "content_sanskrit": "अबुद्धिबूर्वकं तद्वै चेतनार्थे प्रवर्त्तते ।\nचेतनाबुद्धिपूर्वं तु चेतनेन प्रवर्त्तते ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006166072, "chapter_id": 26166, "verse_number": "१-२-२७-७३", "content_sanskrit": "प्रवर्त्तते तथा द्वौ तु यथा मत्स्योदके उभे ।\nचेतनाधिष्ठितं सत्त्वं प्रवर्त्तति गुणात्मकम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006166073, "chapter_id": 26166, "verse_number": "१-२-२७-७४", "content_sanskrit": "कारणत्वात्तथा कार्यं तदा तस्य प्रवर्त्तते ।\nविषयो विषयित्वाच्च अर्थेऽर्थत्वात्तथैव च ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006166074, "chapter_id": 26166, "verse_number": "१-२-२७-७५", "content_sanskrit": "कालेन प्रापणीयेन भेदास्तु करणात्मकाः ।\nसंसिध्यंति तदा व्यक्ताः क्रमेण महदादयः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006166075, "chapter_id": 26166, "verse_number": "१-२-२७-७६", "content_sanskrit": "महतश्चाप्यहंकारस्तस्माद्भूतेद्रियाणि च ।\nभूतभेदाश्च भूतेभ्यो जज्ञिरे स्म परस्परम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006166076, "chapter_id": 26166, "verse_number": "१-२-२७-७७", "content_sanskrit": "संसिद्धकार्यकरणः सद्य एव व्यवर्त्तत ।\nयथोल्मुकात्तु त्रुटयः एककालाद्भवंति हि ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006166077, "chapter_id": 26166, "verse_number": "१-२-२७-७८", "content_sanskrit": "तथा विवृत्ताः क्षेत्रज्ञाः कालेनैकेन कारणात् ।\nयथांधकारे खद्योतः सहसा संप्रदृश्यते ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006166078, "chapter_id": 26166, "verse_number": "१-२-२७-७९", "content_sanskrit": "तथा विवृत्तो ह्यव्यक्तात्खद्योत इव सञ्ज्वलन् ।\nस माहन्सशरीरस्तु यत्रैवायमवर्त्तत ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006166079, "chapter_id": 26166, "verse_number": "१-२-२७-८०", "content_sanskrit": "तत्रैव संस्थितो विद्वान्द्वारशालामुखे विभुः ।\nमहांस्तु तमसः पारे वैलक्षण्याद्विभाव्यते ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006166080, "chapter_id": 26166, "verse_number": "१-२-२७-८१", "content_sanskrit": "तत्रैव संस्थिते विद्वांस्तमसोंऽत इति श्रुतिः ।\nबुद्धिर्विवर्त्तमानस्य प्रादुर्भूता चतुर्विधा ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006166081, "chapter_id": 26166, "verse_number": "१-२-२७-८२", "content_sanskrit": "ज्ञानं वैराग्यमैश्वर्यं धर्मश्चेति चतुष्टयम् ।\nसांसिद्धिकान्यथैतानि विज्ञेयानि नरस्य वै ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006166082, "chapter_id": 26166, "verse_number": "१-२-२७-८३", "content_sanskrit": "स महात्मा शरीरस्य वैवर्त्तात्सिद्धिरुच्यते ।\nअनुशेते यतः सर्वान्क्षेत्रज्ञानमथापि वा ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006166083, "chapter_id": 26166, "verse_number": "१-२-२७-८४", "content_sanskrit": "पुरिषत्वाच्च पुरुषः क्षत्रेज्ञानात्स उच्यते ।\nयस्माद्वुद्ध्यानुशेते च तस्माद्वोधात्मकः स वै ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006166084, "chapter_id": 26166, "verse_number": "१-२-२७-८५", "content_sanskrit": "संसिद्धये परिगतं व्यक्ताव्यक्तमचेतनम् ।\nएवं विवृत्तः क्षेत्रज्ञः क्षेत्रज्ञानाभिसंहितः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006166085, "chapter_id": 26166, "verse_number": "१-२-२७-८६", "content_sanskrit": "विवृत्तिसमकालं तु बुद्ध्याव्यक्तमृषिः स्वयम् ।\nपरं ह्यर्षयते यस्मात्परमर्षित्वमस्य तत् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006166086, "chapter_id": 26166, "verse_number": "१-२-२७-८७", "content_sanskrit": "गत्यर्थादृषतेर्धातोर्नाम निर्वृतिरादितः ।\nयस्मादेव स्वयं भूतस्तस्माच्चाप्यृषिता स्मृता ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006166087, "chapter_id": 26166, "verse_number": "१-२-२७-८८", "content_sanskrit": "ईश्वरात्स्वयमुद्भूता मानसा ब्रह्मणः सुताः ।\nयस्मादुत्पद्यमानैस्तैर्महान्परिगतः परः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006166088, "chapter_id": 26166, "verse_number": "१-२-२७-८९", "content_sanskrit": "यस्माद-षंति ते धीरा महांतं सर्वतो गुणैः ।\nतस्मान्महर्षयः प्रोक्ता बुद्धेः परम दर्शिना ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006166089, "chapter_id": 26166, "verse_number": "१-२-२७-९०", "content_sanskrit": "ईश्वराणां सुतास्तेषां मानसा औरसाश्च वै ।\nअहंकारं तपश्चैव ऋषंति ऋषितां गताः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006166090, "chapter_id": 26166, "verse_number": "१-२-२७-९१", "content_sanskrit": "तस्मात्सप्तर्षयस्ते वै भूतादौ तत्त्वदर्शनात् ।\nऋषिपुत्रा ऋषीकास्तु मैथुनाद्गर्भसंभवाः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006166091, "chapter_id": 26166, "verse_number": "१-२-२७-९२", "content_sanskrit": "तन्मात्राणि च सत्यं च ऋषंते ते महौजसः ।\nसप्तषर्यस्त तस्ते च परसत्यस्य दर्शनाः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006166092, "chapter_id": 26166, "verse_number": "१-२-२७-९३", "content_sanskrit": "ऋषीकाणां सुतास्ते स्युर्विज्ञेया ऋषिपुत्रकाः ।\nऋषंति ते ऋतं यस्माद्विशेषांश्चैव तत्त्वतः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006166093, "chapter_id": 26166, "verse_number": "१-२-२७-९४", "content_sanskrit": "तस्मात्सप्तर्षयस्तेपि श्रुतेः परमदर्शनात् ।\nअव्यक्तात्मा महानात्माहंकारात्मा तथैव च ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006166094, "chapter_id": 26166, "verse_number": "१-२-२७-९५", "content_sanskrit": "भूतात्मा चेंद्रियात्मा च तेषां तज्ज्ञानमुच्यते ।\nइत्येता ऋषिजातीस्ता नामभिः पंच वै श्रृणु ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006166095, "chapter_id": 26166, "verse_number": "१-२-२७-९६", "content_sanskrit": "भृगुर्मरीचिरत्रिश्च ह्यंगिराः पुलहः क्रतुः ।\nमनुर्दक्षो वसिष्टश्च पुलस्त्यश्चेति ते दश ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006166096, "chapter_id": 26166, "verse_number": "१-२-२७-९७", "content_sanskrit": "ब्रह्मणो मानसा ह्येते उद्भूताः स्वयमीश्वराः ।\nपरत्वेनर्षयो यस्मात्स्मृतास्तस्मान्महर्षयः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006166097, "chapter_id": 26166, "verse_number": "१-२-२७-९८", "content_sanskrit": "ईश्वराणां सुता ह्येते ऋषयस्तान्निबोधत ।\nकाव्यो बृहस्पतिश्चैव कश्यपश्व्यवनस्तथा ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006166098, "chapter_id": 26166, "verse_number": "१-२-२७-९९", "content_sanskrit": "उतथ्यो वामदेवश्च अपा स्यश्चोशिजस्तथा ।\nकर्दमो विश्रवाः शक्तिर्वालखिल्यास्तथार्वतः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006166099, "chapter_id": 26166, "verse_number": "१-२-२७-१००", "content_sanskrit": "इत्येते ऋषयः प्रोक्तास्तपसा चर्षितां गताः ।\nऋषिपुत्रानृ षीकांस्तु गर्भोत्पन्नान्निबोधत ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006166100, "chapter_id": 26166, "verse_number": "१-२-२७-१०१", "content_sanskrit": "वत्सरो नगृहूश्चैव भरद्वाजस्तथैव च ।\nऋषिदीर्घतमाश्चैव बृहदुक्थः शरद्वतः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006166101, "chapter_id": 26166, "verse_number": "१-२-२७-१०२", "content_sanskrit": "वाजश्रवाः शुचिश्चैव वश्याश्वश्च पराशरः ।\nदधीचः शंशपाश्चैव राजा वैश्रवणस्तथा ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7006166102, "chapter_id": 26166, "verse_number": "१-२-२७-१०३", "content_sanskrit": "इत्येते ऋषिकाः प्रोक्तास्ते सत्यादृषितां गताः ।\nईश्वरा ऋषयश्चैव ऋषिकाश्चैव ते स्मृताः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7006166103, "chapter_id": 26166, "verse_number": "१-२-२७-१०४", "content_sanskrit": "एते मंत्रकृतः सर्वे कृत्स्नशस्तान्निबोधत ।\nभृगुः काव्यः प्रचेताश्च ऋचीको ह्यात्मवानपि ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7006166104, "chapter_id": 26166, "verse_number": "१-२-२७-१०५", "content_sanskrit": "और्वाऽथ जमदग्निश्च विदः सारस्वतस्तथा ।\nआर्ष्टिषेणो युधाजिच्च वीतहव्यसुवर्चसौ ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7006166105, "chapter_id": 26166, "verse_number": "१-२-२७-१०६", "content_sanskrit": "वैन्यः पृथुर्दिवोदासो बाध्यश्वो गृत्सशौनकौ ।\nएकोनविशतिर्ह्येतेभृगवो मंत्रवादितः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7006166106, "chapter_id": 26166, "verse_number": "१-२-२७-१०७", "content_sanskrit": "अंगिरा वैद्यगश्चैव भरद्वाजोऽथ बाष्कलिः ।\nऋतवाकस्तथा गर्गः शिनिः संकृतिरेव च ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7006166107, "chapter_id": 26166, "verse_number": "१-२-२७-१०८", "content_sanskrit": "पुरुकुत्सश्च मांधाता ह्यंबरीषस्तथैव च ।\nयुवनाश्वः पौरकुत्सस्त्रसद्दस्युश्च दस्युमान् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7006166108, "chapter_id": 26166, "verse_number": "१-२-२७-१०९", "content_sanskrit": "आहार्यो ह्यजमीढश्च तुक्षयः कपिरेव च ।\nवृषादर्भो विरूपाश्वः कण्वश्चैवाथ मुद्गलः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7006166109, "chapter_id": 26166, "verse_number": "१-२-२७-११०", "content_sanskrit": "उतथ्यश्च सनद्वाजस्तथा वाजश्रवा अपि ।\nअयास्यश्चक्रवर्त्ती चवामदेवस्तथैव च ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7006166110, "chapter_id": 26166, "verse_number": "१-२-२७-१११", "content_sanskrit": "असिजो बृहदुक्थश्च ऋषिर्दीर्घतमास्तथा ।\nकक्षीवांश्च त्रयस्त्रिंशत्स्मृता ह्यांगिरसा वराः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7006166111, "chapter_id": 26166, "verse_number": "१-२-२७-११२", "content_sanskrit": "एते मंत्रकृतः सर्वे काश्यपांस्तु निबोधत ।\nकाश्यपश्चैव वत्सारो नैध्रुवो रैभ्य एव च ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7006166112, "chapter_id": 26166, "verse_number": "१-२-२७-११३", "content_sanskrit": "असितो देव लश्चैव षडेते ब्रह्मवादिनः ।\nअत्रिरर्वसनश्चैव श्यावाश्वश्च गविष्ठिरः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7006166113, "chapter_id": 26166, "verse_number": "१-२-२७-११४", "content_sanskrit": "आविहोत्र ऋषिर्द्धीमांस्तथा पूर्वातिथिश्च सः ।\nइत्येते चा त्रयः प्रोक्ता मंत्रकारा महर्षयः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7006166114, "chapter_id": 26166, "verse_number": "१-२-२७-११५", "content_sanskrit": "वसिष्ठश्चैव शक्तिश्च तथैव च पराशरः ।\nचतुर्थ इन्द्रप्रमतिः पंचमश्च भरद्वसुः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7006166115, "chapter_id": 26166, "verse_number": "१-२-२७-११६", "content_sanskrit": "षष्ठश्च मैत्रावरुणिः कुंडिनः सप्तमस्तथा ।\nइति सप्त वशिष्ठाश्च विज्ञेया ब्रह्मवादिनः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7006166116, "chapter_id": 26166, "verse_number": "१-२-२७-११७", "content_sanskrit": "विश्वामित्रस्तु गाधेयो देवरातस्तथोद्गलः ।\nतथा विद्वान्मधुच्छंदा ऋषिश्चान्योऽघमर्षणः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7006166117, "chapter_id": 26166, "verse_number": "१-२-२७-११८", "content_sanskrit": "अष्टको लोहितश्चैव कतः कोलश्च तावुभौ ।\nदेवश्रवास्तथा रेणुः पूरणोऽथ धनंजयः ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7006166118, "chapter_id": 26166, "verse_number": "१-२-२७-११९", "content_sanskrit": "त्रयोदशैते धर्मिष्ठा विज्ञेयाः कुशिकावराः ।\nअगस्त्योऽयो दृढायुश्च विध्मवाहस्तथैव च ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7006166119, "chapter_id": 26166, "verse_number": "१-२-२७-१२०", "content_sanskrit": "ब्रह्मिष्ठागस्तपा ह्येते त्रयः परमकीर्त्तयः ।\nमनुर्वैवस्वतश्चैव एलो राजा पुरूखाः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7006166120, "chapter_id": 26166, "verse_number": "१-२-२७-१२१", "content_sanskrit": "क्षत्र्रियाणां चरावेतौ विज्ञेयौ मंत्रवादिनौ ।\nभलंदनश्च वत्सश्च संकीलश्चैव ते त्रयः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7006166121, "chapter_id": 26166, "verse_number": "१-२-२७-१२२", "content_sanskrit": "एते मंत्रकृतश्चैव वैश्यानां प्रवराः स्मृताः ।\nइत्येषा नवतिः प्रोक्ता मंत्रा यैर्ऋषिभिः कृताः ।\nब्राह्यणाः क्षत्रिया वैश्या ऋषिपुत्रान्निबोधत ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}]