[{"id": 2149710, "chapter_id": 4243, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2149711, "chapter_id": 4243, "verse_number": "१", "content_sanskrit": "सा निष्क्रमन्ती नगरात् चिन्तयामास भारत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2149712, "chapter_id": 4243, "verse_number": "२", "content_sanskrit": "पृथिव्यां नास्ति युवतिर्विषमस्थतरा मया ।\nबन्धुभिर्विप्रहीणाऽस्मि साल्वेन च निराकृता\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2149713, "chapter_id": 4243, "verse_number": "३", "content_sanskrit": "न च शक्यं पुनर्गन्तुं मया वारणसाह्वये ।\nअनुज्ञाता तु भीष्मेण साल्वमुद्दिश्य कारणम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2149714, "chapter_id": 4243, "verse_number": "४", "content_sanskrit": "किं नु गर्हाम्यथात्मानमथ भीष्मं दुरासदम् ।\nआहोस्वित् पितरं मूढं यो मेऽकार्षीत् स्वयंवरम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2149715, "chapter_id": 4243, "verse_number": "५", "content_sanskrit": "ममायं स्वकृतो दोषो याऽहं भीष्मरथात् तदा ।\nप्रवृत्ते वैशसे युद्धे साल्वार्थं नापतं पुरा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2149716, "chapter_id": 4243, "verse_number": "६", "content_sanskrit": "तस्येयं फलनिर्वृत्तिर्यदापन्नाऽस्मि मूढवत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2149717, "chapter_id": 4243, "verse_number": "७", "content_sanskrit": "धिग् भीष्मं धिक् च मे मन्दं पितरं मूढचेतसम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2149718, "chapter_id": 4243, "verse_number": "८", "content_sanskrit": "येनाहं वीर्यशुल्केति पण्यस्त्रीवत् प्रवेशिता\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2149719, "chapter_id": 4243, "verse_number": "९", "content_sanskrit": "धिङ् मां धिक् साल्वराजानं धिग् धातारमथापि वा ।\nयेषां दुर्नीतभावेन प्राप्ताऽस्म्यापदमुत्तमाम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2149720, "chapter_id": 4243, "verse_number": "१०", "content_sanskrit": "सर्वथा भागधेयानि स्वानि प्राप्नोति मानवः ।\nअनयस्यास्य तु मुखं भीष्मः शान्तनवो मम\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2149721, "chapter_id": 4243, "verse_number": "११", "content_sanskrit": "सा भीष्मे प्रतिकर्तव्यमहं पश्यामि साम्प्रतम् ।\nतपसा वा युधा वाऽपि दुःखहेतुः स मे मतः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2149722, "chapter_id": 4243, "verse_number": "१२", "content_sanskrit": "को नु भीष्मं युधा जेतुमुत्सहेत महीपतिः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2149723, "chapter_id": 4243, "verse_number": "१३", "content_sanskrit": "एवं सा परिनिश्चित्य जगाम नगराद् बहिः ।\nआश्रमं पुण्यशीलानां तापसानां महात्मनाम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2149724, "chapter_id": 4243, "verse_number": "१४", "content_sanskrit": "ततस्तामवसद् रात्रिं तापसैः परिपालिता\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2149725, "chapter_id": 4243, "verse_number": "१५", "content_sanskrit": "आचख्यौ च यथावृत्तं सर्वमात्मनि भारत ।\nविस्तरेण महाबाहो निखिलेन शुचिस्मिता\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2149726, "chapter_id": 4243, "verse_number": "१६", "content_sanskrit": "हरणं च विसर्गं च साल्वेन च विसर्जनम् ।\nततस्तत्र महानासीद् ब्राह्मणः संशितव्रतः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2149727, "chapter_id": 4243, "verse_number": "१७", "content_sanskrit": "शैखावत्यस्तपोवृद्धः शास्त्रे चारण्यके गुरुः ।\nआर्तां तामाह स मुनिः शैखावत्यो महातपाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2149728, "chapter_id": 4243, "verse_number": "१८", "content_sanskrit": "निःश्वसन्तीं स तां बालां दुःखशोकपरायणाम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2149729, "chapter_id": 4243, "verse_number": "१९", "content_sanskrit": "एवं गते तु किं भद्रे शक्यं कर्तुं तपस्विभिः ।\nआश्रमस्थैर्महाभागैः तपोयुक्तैर्महात्मभिः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2149730, "chapter_id": 4243, "verse_number": "२०", "content_sanskrit": "सा त्वेनमब्रवीद् राजन् क्रियतां मदनुग्रहः ।\nप्रव्राजितुमिहेच्छामि तपस्तप्स्यामि दुश्चरम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2149731, "chapter_id": 4243, "verse_number": "२१", "content_sanskrit": "मयैव तानि कर्माणि पूर्वदेहेषु मूढया ।\nकृतानि नूनं पापानि तेषामेतत् फलं ध्रुवम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2149732, "chapter_id": 4243, "verse_number": "२२", "content_sanskrit": "नोत्सहेऽहं पुनर्गन्तुं स्वजनं प्रति तापसाः ।\nप्रत्याख्याता निरानन्दा साल्वेन च निराकृता\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2149733, "chapter_id": 4243, "verse_number": "२३", "content_sanskrit": "उपदिष्टमिहेच्छामि तपसे वीतकल्मषाः ।\nयुष्माभिर्देवसङ्काशैः कृपा भवतु वो मयि\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2149734, "chapter_id": 4243, "verse_number": "२४", "content_sanskrit": "स तामाश्वासयत् कन्यां दृष्टान्तागमहेतुभिः ।\nसान्त्वयामास कार्यं च प्रतिजज्ञे द्विजैः सह\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2149735, "chapter_id": 4243, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि चतुःसप्तत्युत्तरशततमोऽध्यायः ॥१७४॥\nअम्बोपाख्यानपर्वणि चतुर्थोऽध्यायः ॥४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]