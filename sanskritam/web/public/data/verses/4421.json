[{"id": 2157977, "chapter_id": 4421, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2157978, "chapter_id": 4421, "verse_number": "१", "content_sanskrit": "यन्मां पार्थस्य कर्माणि सङ्ग्रामे परिपृच्छसि ।\nशृणु राजन् यथा पार्थश्चकार कदनं महत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2157979, "chapter_id": 4421, "verse_number": "२", "content_sanskrit": "रजो दृष्ट्वा समुद्भूतं श्रुत्वा च जननिस्वनम् ।\nभगदत्ते विकुर्वाणे कौन्तेयः कृष्णमब्रवीत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2157980, "chapter_id": 4421, "verse_number": "३", "content_sanskrit": "यथा प्राग्ज्योतिषो राजा गजेन मधुसूदन ।\nत्वरमाणो ह्यतिक्रान्तो ध्रुवं तस्यैष निस्वनः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2157981, "chapter_id": 4421, "verse_number": "४", "content_sanskrit": "इन्द्रादनवमः सङ्खे गजयानविशारदः ।\nप्रथमो वा द्वितीयो वा पृथिव्यामिति मे मतिः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2157982, "chapter_id": 4421, "verse_number": "५", "content_sanskrit": "स चापि द्विरदश्रेष्ठः सदाऽप्रतिगजो युधि ।\nसर्वशस्त्रातिगः सङ्खे कृतवर्मा जितक्लमः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2157983, "chapter_id": 4421, "verse_number": "६", "content_sanskrit": "सोढा शस्त्रनिपातानामग्निस्पर्शस्य चानघ ।\nस पाण्डवबलं व्यक्तमद्यैको नाशयिष्यति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2157984, "chapter_id": 4421, "verse_number": "७", "content_sanskrit": "सिंहनादं महत् कृत्वा धनुर्बाणरवैः सह ।\nविद्राव्यमाणं सम्पश्य हतभूयिष्ठनायकम्\nदृष्ट्वा विनद्य सहसा मम सेनां प्रमृद्गति\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2157985, "chapter_id": 4421, "verse_number": "८", "content_sanskrit": "न चावाभ्यां पुमानन्यः शक्तः सम्प्रतिबाधितुम् ।\nत्वरमाणस्ततो याहि यत्र प्राग्ज्योतिषो नृपः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2157986, "chapter_id": 4421, "verse_number": "९", "content_sanskrit": "शक्रसख्याद् द्विपबलाद् वयसा चापि विस्मितम् ।\nअद्यैव प्रेषयिष्यामि बलहन्तुः प्रियातिथिम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2157987, "chapter_id": 4421, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2157988, "chapter_id": 4421, "verse_number": "१०", "content_sanskrit": "कृष्णस्तु वचनात् तस्य प्रययौ यत्र तद्बलम् ।\nकाल्यन्ते भगदत्तेन पाञ्चालाः सह पाण्डवैः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2157989, "chapter_id": 4421, "verse_number": "११", "content_sanskrit": "तं प्रयान्तं ततः पश्चादाह्वयन्तो महारथाः ।\nसंशप्तकाः समारोहन् सहस्राणि चतुर्दश\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2157990, "chapter_id": 4421, "verse_number": "१२", "content_sanskrit": "दशैव तु सहस्राणि त्रिगर्तानां नराधिप ।\nचत्वारिंशत् सहस्राणि वासुदेवस्य धेनुपाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2157991, "chapter_id": 4421, "verse_number": "१३", "content_sanskrit": "दीर्यमाणां चमूं दृष्ट्वा भगदत्तेन मारिष ।\nआहूयमानस्य च तैरभवद् वै मनो द्विधा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2157992, "chapter_id": 4421, "verse_number": "१४", "content_sanskrit": "किन्नु श्रेयस्करं कृत्यं भवेदत्रेत्यचिन्तयत् ।\nन चैव विनिवर्तेयं पालयेयं च पाण्डवान्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2157993, "chapter_id": 4421, "verse_number": "१५", "content_sanskrit": "तथा बुद्ध्या विचार्यैतदसकृत् कुरुनन्दनः ।\nअकरोत् परमां बुद्धिं संशप्तकवधे स्थिराम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2157994, "chapter_id": 4421, "verse_number": "१६", "content_sanskrit": "स सन्निवृत्तः सहसा कपिप्रवरकेतनः ।\nएको रथसहस्राणां निहन्तुं वासवी रणे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2157995, "chapter_id": 4421, "verse_number": "१७", "content_sanskrit": "सा हि दुर्योधनस्यासीन्मतिः कर्णस्य चोभयोः ।\nअर्जुनस्य वधोपाये तेन द्वैधमकल्पयत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2157996, "chapter_id": 4421, "verse_number": "१८", "content_sanskrit": "स तु संवर्तयामास द्वैधीभावेन पाण्डवः ।\nवधे संशप्तकाख्यानामकरोत् तां मृषा तदा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2157997, "chapter_id": 4421, "verse_number": "१९", "content_sanskrit": "ततः शरसहस्राणि प्रयुतान्यर्बुदानि च ।\nव्यसृजन्नर्जुने क्रुद्धाः संशप्तकरथर्षभाः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2157998, "chapter_id": 4421, "verse_number": "२०", "content_sanskrit": "ततो नैवार्जुनोपेन्द्रौ न रथः साश्वकेतनः ।\nदृश्यते शरवर्षेण प्रबलेन समावृतः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2157999, "chapter_id": 4421, "verse_number": "२१", "content_sanskrit": "ततस्तेन शरौघेण महता च समावृतः ।\nनाशकन्नाम बीभत्सुरमित्रान् प्रतिबाधितुम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2158000, "chapter_id": 4421, "verse_number": "२२", "content_sanskrit": "यदा मोहमिव प्राप्तः प्रस्विन्नश्चाच्युतोऽभवत् ।\nततो जनार्दनः पार्थं प्रत्युवाच हसन्निव\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2158001, "chapter_id": 4421, "verse_number": "", "content_sanskrit": "वज्रमस्त्रं तु सन्धाय जहि संशप्तकानिह ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2158002, "chapter_id": 4421, "verse_number": "२३", "content_sanskrit": "ततस्तानहितान् पार्थो वज्रेणास्त्रेण जघ्निवान्\t॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2158003, "chapter_id": 4421, "verse_number": "२४", "content_sanskrit": "शतशः पाणयः छिन्नाः सेषुज्यातळकार्मुकाः ।\nकेतनानि हयाः सूता रथिनश्चापतन् क्षितौ\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2158004, "chapter_id": 4421, "verse_number": "२५", "content_sanskrit": "द्रुमाचलाग्राम्बुधरैः समरूपाः सुकल्पिताः ।\nहतारोहाः क्षितौ पेतुर्द्विपाः पार्थशराहताः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2158005, "chapter_id": 4421, "verse_number": "२६", "content_sanskrit": "विप्रविद्धकशावल्गाः छिन्नभाण्डप्रकीर्णकाः ।\nसारोहास्तुरगाः पेतुर्मथिताः पार्थमार्गणैः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2158006, "chapter_id": 4421, "verse_number": "२७", "content_sanskrit": "सर्ष्टिचर्मासिनखराः समुद्गरपरश्वथाः ।\nसञ्छिन्ना बाहवः पेतुर्नृणां भल्लैः किरीटिना\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2158007, "chapter_id": 4421, "verse_number": "२८", "content_sanskrit": "बालादित्याम्बुजेन्दूनां तुल्यरूपाणि मारिष ।\nसञ्छिन्नान्यर्जुनशरैः शिरांस्युर्वीं प्रपेदिरे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2158008, "chapter_id": 4421, "verse_number": "२९", "content_sanskrit": "जज्वालालङ्कृतैः सैन्यैः पत्रिभिः प्राणभोजनैः ।\nनानालिङ्गैः सदाऽमित्रान् क्रुद्धे निघ्नति फल्गुने\nशिरांसि विचकर्ताऽथ योधानां हि सहस्रशः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2158009, "chapter_id": 4421, "verse_number": "३०", "content_sanskrit": "क्षोभयन्तं तदा सेनां द्विरदं नळिनीमिव ।\nधनञ्जयं भूतगणाः साधु साध्वित्यपूजयन्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2158010, "chapter_id": 4421, "verse_number": "३१", "content_sanskrit": "दृष्ट्वा तु कर्म पार्थस्य वासवस्येव माधवः ।\nविस्मयं परमं गत्वा तळमाहत्य पूजयत्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2158011, "chapter_id": 4421, "verse_number": "३२", "content_sanskrit": "कर्मैतत् पार्थ शक्रेण यमेन धनदेन च ।\nदुष्करं समरे यत्ते कृतमद्येति मे मतिः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2158012, "chapter_id": 4421, "verse_number": "३३", "content_sanskrit": "युगपच्चैव सङ्ग्रामे शतशोऽथ सहस्रशः ।\nपतिता एव मे दृष्टाः संशप्तकमहारथाः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2158013, "chapter_id": 4421, "verse_number": "३४", "content_sanskrit": "ततः संशप्तकान् हत्वा भूयिष्ठं ये व्यवस्थिताः ।\nभगदत्ताय याहीति वासुदेवमचोदयत्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2158014, "chapter_id": 4421, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि षड्विंशोऽध्यायः ॥ २६ ॥\nसंशप्तकवधपर्वणि एकादशोऽध्यायः ॥ ११ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]