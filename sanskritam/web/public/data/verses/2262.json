[{"id": 2058437, "chapter_id": 2262, "verse_number": "७-१८९-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2058438, "chapter_id": 2262, "verse_number": "७-१८९-१", "content_sanskrit": "ततो दुःशासनः क्रुद्धः सहदेवमुपाद्रवत्।\nरथवेगेन तीव्रेण कम्पयन्निव मेदिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2058439, "chapter_id": 2262, "verse_number": "७-१८९-२", "content_sanskrit": "तस्यापतत एवाशु भल्लेनामित्रकर्शनः।\nमाद्रीपुत्रः शिरो यन्तुः सशिरस्त्राणमच्छिनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2058440, "chapter_id": 2262, "verse_number": "७-१८९-३", "content_sanskrit": "नैनं दुःशासनः सूतं नापि कश्चन सैनिकः।\nकृत्तोत्तमाङ्गमाशुत्वात्सहदेवेन बुद्धवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2058441, "chapter_id": 2262, "verse_number": "७-१८९-४", "content_sanskrit": "यदा त्वसङ्गृहीतत्वात्प्रयान्त्यश्वा यथासुखम्।\nततो दुःशासनः सूतं बुबुधे गतचेतसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2058442, "chapter_id": 2262, "verse_number": "७-१८९-५", "content_sanskrit": "स हयान्सन्निगृह्याजौ स्वयं हयविशारदः।\nयुयुधे रथिनां श्रेष्ठो लघु चित्रं च सुष्ठु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2058443, "chapter_id": 2262, "verse_number": "७-१८९-६", "content_sanskrit": "तदस्यापूजयन्कर्म स्वे परे चापि संयुगे।\nहतसूतरथेनाजौ व्यचरद्यदभीतवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2058444, "chapter_id": 2262, "verse_number": "७-१८९-७", "content_sanskrit": "सहदेवस्तु तानश्वांस्तीक्ष्णैर्बाणैरवाकिरत्।\nपीड्यमानाः शरैश्चाशु प्राद्रवंस्ते ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2058445, "chapter_id": 2262, "verse_number": "७-१८९-८", "content_sanskrit": "स रश्मिषु विषक्तत्वादुत्सर्ज शरासनम्।\nधनुषा कर्म कुर्वंस्तु रश्मींश्च पुनरुत्सृजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2058446, "chapter_id": 2262, "verse_number": "७-१८९-९", "content_sanskrit": "छिद्रेष्वेतेषु तं बाणैर्माद्रीपुत्रोऽभ्यवाकिरत्।\nपरीप्संस्त्वत्सुतं कर्णस्तदन्तरमवापतत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2058447, "chapter_id": 2262, "verse_number": "७-१८९-१०", "content_sanskrit": "वृकोदरस्ततः कर्णं त्रिभिर्भल्लैः समाहितः।\nआकर्णपूर्णैरभ्यघ्नद्बाह्वोरुरसि चानदत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2058448, "chapter_id": 2262, "verse_number": "७-१८९-११", "content_sanskrit": "स निवृत्तस्ततः कर्णः सङ्घट्टित इवोरगः।\nभीममावारयामास विकिरन्निशिताञ्छरान्।\nततोऽभूत्तुमुलं युद्धं भीमराधेययोस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2058449, "chapter_id": 2262, "verse_number": "७-१८९-१२", "content_sanskrit": "तौ वृषाविव नर्दन्तौ विवृत्तनयनावुभौ।\nवेगेन महताऽन्योन्यं संरब्धावभिपेततुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2058450, "chapter_id": 2262, "verse_number": "७-१८९-१३", "content_sanskrit": "अभिसंश्लिष्टयोस्तत्र तयोराहवशौण्डयोः।\nविच्छिन्नशरपातत्वाद्गदायुद्धमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2058451, "chapter_id": 2262, "verse_number": "७-१८९-१४", "content_sanskrit": "गदया भीमसेनस्तु कर्णस्य रथकूबरम्।\nबिभेद शतधा राजंस्तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2058452, "chapter_id": 2262, "verse_number": "७-१८९-१५", "content_sanskrit": "ततो भीमस्य राधेयो गदामाविध्य वीर्यवान्।\nअवासृजद्रथे तां तु बिभेद गदया गदाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2058453, "chapter_id": 2262, "verse_number": "७-१८९-१६", "content_sanskrit": "ततो भीमः पुनर्गुर्वीं चिक्षेपाधिरथेर्गदाम्।\nतां गदां बहुभिः कर्णः सुपुङ्खैः सुप्रवेजितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2058454, "chapter_id": 2262, "verse_number": "७-१८९-१७", "content_sanskrit": "प्रत्यविध्यत्पुनश्चान्यैः सा भीमं पुनराव्रजत्।\nव्यालीव मन्त्राभिहता कर्णबाणैरभिद्रुता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2058455, "chapter_id": 2262, "verse_number": "७-१८९-१८", "content_sanskrit": "तस्याः प्रतिनिपातेन भीमस्य विपुलो ध्वजः।\nपपात सारथिश्चास्य मुमोह च गदाहतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2058456, "chapter_id": 2262, "verse_number": "७-१८९-१९", "content_sanskrit": "स कर्णं सायकानष्टौ व्यसृजत्क्रोधमूर्च्छितः।\nतैस्तस्य निशितैस्तीक्ष्णैर्भीमसेनो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2058457, "chapter_id": 2262, "verse_number": "७-१८९-२०", "content_sanskrit": "चिच्छेद परवीरघ्नः प्रहसन्निव भारत।\nध्वजं शरासनं चैव शरावापं च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2058458, "chapter_id": 2262, "verse_number": "७-१८९-२१", "content_sanskrit": "कर्णोऽप्यन्यद्धनुर्गृह्य हेमपृष्ठं दुरासदम्।\nततः पुनस्तु राधेयो हयानस्य रथेषुभिः।\nऋक्षवर्णाञ्जघानाशु तथोभौ पार्ष्णिसारथी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2058459, "chapter_id": 2262, "verse_number": "७-१८९-२२", "content_sanskrit": "स विपन्नरथो भीमो नकुलस्याप्लुतो रथम्।\nहरिर्यथा गिरेः शृङ्गं समाक्रमदरिन्दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2058460, "chapter_id": 2262, "verse_number": "७-१८९-२३", "content_sanskrit": "तथा द्रोणार्जुनौ चित्रमयुध्येतां महारथौ।\nआचार्यशिष्यौ राजेन्द्र कृतप्रतिकृतौ युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2058461, "chapter_id": 2262, "verse_number": "७-१८९-२४", "content_sanskrit": "लघुसन्धानयोगाभ्यां रथयोश्च रणेन च।\nमोहयन्तौ मनुष्याणां चक्षूंषि च मनांसि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2058462, "chapter_id": 2262, "verse_number": "७-१८९-२५", "content_sanskrit": "उपारमन्त ते सर्वे योधाऽस्माकं परे तथा।\nविचित्रान्पृतनामध्ये रथमार्गानुदीर्य तौ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2058463, "chapter_id": 2262, "verse_number": "७-१८९-२६", "content_sanskrit": "अन्योन्यमपसव्यं च कर्तुं वीरौ तदेषतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2058464, "chapter_id": 2262, "verse_number": "७-१८९-२७", "content_sanskrit": "पराक्रमं तयोर्योधा ददृशुस्ते सुविस्मिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2058465, "chapter_id": 2262, "verse_number": "७-१८९-२८", "content_sanskrit": "तयोः समभवद्युद्धं द्रोणपाण्डवयोर्महत्।\nआमिषार्थे महाराज गगने श्येनयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2058466, "chapter_id": 2262, "verse_number": "७-१८९-२९", "content_sanskrit": "यद्यच्चकार द्रोणस्तु कुन्तीपुत्रजिगीषया।\nतत्तत्प्रतिजघानाशु प्रहसंस्तस्य पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2058467, "chapter_id": 2262, "verse_number": "७-१८९-३०", "content_sanskrit": "यदा द्रोणो न शक्नोति पाण्डवं स्म विशेषितुम्।\nततः प्रादुश्चकारास्त्रमस्त्रमार्गविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2058468, "chapter_id": 2262, "verse_number": "७-१८९-३१", "content_sanskrit": "ऐन्द्रं पाशुपतं त्वाष्ट्रं वायव्यमथ वारुणम्।\nमुक्तंमुक्तं द्रोणचापात्तज्जघान धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2058469, "chapter_id": 2262, "verse_number": "७-१८९-३२", "content_sanskrit": "अस्त्राण्यस्त्रैर्यदा तस्य विधिवद्धन्ति पाण्डवः।\nततोऽस्त्रैः परमैर्दिव्यैर्द्रोणः पार्थमवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2058470, "chapter_id": 2262, "verse_number": "७-१८९-३३", "content_sanskrit": "यद्यदस्त्रं स पार्थाय प्रयुङ्क्ते विजिगीषया।\nतस्यतस्य विघाताय तत्तद्धि कुरुतेऽर्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2058471, "chapter_id": 2262, "verse_number": "७-१८९-३४", "content_sanskrit": "स वध्यमानेष्वस्त्रेषु दिव्येष्वपि यथाविधि।\nअर्जुनेनार्जुनं द्रोणो मनसैवाभ्यपूजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2058472, "chapter_id": 2262, "verse_number": "७-१८९-३५", "content_sanskrit": "मेने चात्मानमधिकं पृथिव्यामधि भारत।\nतेन शिष्येण सर्वेभ्यः शस्त्रविद्भ्य परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2058473, "chapter_id": 2262, "verse_number": "७-१८९-३६", "content_sanskrit": "वार्यमाणस्तु पार्थेन तथा मध्ये महात्मनाम्।\nयतमानोऽर्जुनं प्रीत्या प्रीयते स्मार्जुनेन सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2058474, "chapter_id": 2262, "verse_number": "७-१८९-३७", "content_sanskrit": "ततोऽन्तरिक्षे देवाश्च गन्धर्वाश्च सहस्रशः।\nऋषयः सिद्धसङ्घाश्च व्यतिष्ठन्त दिदृक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2058475, "chapter_id": 2262, "verse_number": "७-१८९-३८", "content_sanskrit": "तदप्सरोभिराकीर्णं यक्षगन्धर्वसङ्कुलम्।\nश्रीमदाकाशमभवद्भूयो मेघाकुलं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2058476, "chapter_id": 2262, "verse_number": "७-१८९-३९", "content_sanskrit": "तत्रास्मान्तर्हिता वाचो व्यचरन्त पुनः पुनः।\nद्रोणपार्थस्तवोपेता व्यश्रूयन्त नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2058477, "chapter_id": 2262, "verse_number": "७-१८९-४०", "content_sanskrit": "विसृज्यमानेष्वस्त्रेषु ज्वालयस्तु दिशो दश।\nअब्रुवंस्तत्र सिद्धाश्च ऋषयश्च समागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2058478, "chapter_id": 2262, "verse_number": "७-१८९-४१", "content_sanskrit": "नैवेदं मानुषं युद्धं नासुरं न च राक्षसम्।\nन दैवं न च गान्धर्वं ब्राह्मणं ध्रुवमिदं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2058479, "chapter_id": 2262, "verse_number": "७-१८९-४२", "content_sanskrit": "विचित्रमिदमाश्चर्यं न नो दृष्टं न च श्रुतम्।\nअति पाण्डवमाचार्यो द्रोणं चाप्यति पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2058480, "chapter_id": 2262, "verse_number": "७-१८९-४३", "content_sanskrit": "नानयोरन्तरं शक्यं द्रष्टुमन्येन केनचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2058481, "chapter_id": 2262, "verse_number": "७-१८९-४४", "content_sanskrit": "यदि रुद्रो द्विधाकृत्य युध्येतात्मानमात्मना।\nतत्र शक्योपमा कर्तुमन्यत्र तु न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2058482, "chapter_id": 2262, "verse_number": "७-१८९-४५", "content_sanskrit": "ज्ञानमेकस्थमाचार्ये ज्ञानं योगश्च पाण्डवे।\nशौर्यमेकस्थमाचार्ये बलं शौर्यं च पाण्डवे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2058483, "chapter_id": 2262, "verse_number": "७-१८९-४६", "content_sanskrit": "नेमौ शक्यौ महेष्वासौ युद्धे क्षपयितुं परैः।\nइच्छमानौ पुनरिमौ हन्येतां सामरं जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2058484, "chapter_id": 2262, "verse_number": "७-१८९-४७", "content_sanskrit": "इत्यब्रुवन्महाराज दृष्ट्वा तौ पुरुषर्षभौ।\nअन्तर्हितानि भूतानि प्रकाशानि च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2058485, "chapter_id": 2262, "verse_number": "७-१८९-४८", "content_sanskrit": "`यदा द्रोणं महाराज विशेषयति पाण्डवः।\nततो द्रोणो ब्राह्ममस्त्रं प्रादुश्चक्रे महामतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2058486, "chapter_id": 2262, "verse_number": "७-१८९-४९", "content_sanskrit": "`तदस्त्रं संहितं राजन्धोररूपं महाहवे।\nसन्तापयद्रणे पार्थं भूतान्यन्तर्हितानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2058487, "chapter_id": 2262, "verse_number": "७-१८९-५०", "content_sanskrit": "ततश्चचाल पृथिवी सपर्वतवनद्रुमा।\n`सरितश्च प्रतिस्रोतः प्रवहुर्वै क्षणान्तरम्।\nववौ च विषमो वायुः सागराश्चापि चुक्षुभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2058488, "chapter_id": 2262, "verse_number": "७-१८९-५१", "content_sanskrit": "ततस्त्रासो महानासीत्कुरुपाण्डवसेनयोः।\nसर्वेषां चैव भूतानामुद्यतेऽस्त्रे महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2058489, "chapter_id": 2262, "verse_number": "७-१८९-५२", "content_sanskrit": "ततः पार्थोऽप्यसम्भ्रान्तस्तदस्त्रं प्रतिजघ्निवान्।\nब्रह्मास्त्रेणैव राजेन्द्र ततः सर्वमशीशमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2058490, "chapter_id": 2262, "verse_number": "७-१८९-५३", "content_sanskrit": "यदा न गम्यते पारं तयोरन्यतरस्य वा।\nततः सङ्कुलयुद्धेन तद्युद्धं व्याकुलीकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2058491, "chapter_id": 2262, "verse_number": "७-१८९-५४", "content_sanskrit": "नाज्ञायत ततः किञ्चित्पुनरेव विशाम्पते।\nप्रवृत्ते तुमुले युद्धे द्रोणपाण्डवयोर्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2058492, "chapter_id": 2262, "verse_number": "७-१८९-५५", "content_sanskrit": "`द्रोणो मुक्त्वा रणे पार्थं पाञ्चालानन्वधावत।\nअर्जुनोपि रणे द्रोणं त्यक्त्वा प्राद्रवयत्कुरून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2058493, "chapter_id": 2262, "verse_number": "७-१८९-५६", "content_sanskrit": "शरौघैरथ ताभ्यां तु छायाभूतं महामृधे।\nतुमलं प्रबभौ राजन्सर्वस्य जगतो भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2058494, "chapter_id": 2262, "verse_number": "७-१८९-५७", "content_sanskrit": "शरजालैः समाकीर्णे मेघजालैरिवाम्बरे।\nनापतच्च ततः कश्चिदन्तरिक्षचरस्तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2058495, "chapter_id": 2262, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि द्रोणवधपर्वणि पञ्चदशदिसयुद्धे एकोननवत्यधिकशततमोऽध्यायः॥ १८९ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१८९-४५ ज्ञानमेकस्थमिति आचार्यो ज्ञानस्य शौर्यस्य चावधिरित्यर्थः। अर्जुनस्तु योगेन बलेन चाधिकः। कृष्णसारथिगाण्डीवदिव्यरथध्वजबुद्भ्यादिभिर्यौवनेन च युक्तत्वात्। तथाच योगबलाभ्यां मार्चार्यसाम्यं प्राप्त इत्यर्थः॥ ५-१८९-५७ नापतत् बाणैरन्तरिक्षस्य पूरितत्वादिति भावः॥ ५-१८९-१८९ एकोननवत्यधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]