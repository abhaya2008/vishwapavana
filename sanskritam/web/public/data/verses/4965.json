[{"id": 2186630, "chapter_id": 4965, "verse_number": "", "content_sanskrit": "भृगुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2186631, "chapter_id": 4965, "verse_number": "१", "content_sanskrit": "असृजद् ब्राह्मणानेव पूर्वं ब्रह्मा प्रजापतिः ।\nआत्मतेजोभिनिर्वृत्तान् भास्कराग्निसमप्रभान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2186632, "chapter_id": 4965, "verse_number": "२", "content_sanskrit": "ततः सत्यं च धर्मं च तपो ब्रह्म च शाश्वतम् ।\nआचारं चैव शौचं च स्वर्गाय विदधे प्रभुः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2186633, "chapter_id": 4965, "verse_number": "३", "content_sanskrit": "देवदानवगन्धर्वदैत्यासुरमहोरगाः ।\nयक्षराक्षसनागाश्च पिशाचा मनुजास्तथा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2186634, "chapter_id": 4965, "verse_number": "४", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः शूद्राश्च द्विजसत्तम ।\nये चान्ये भूतसङ्घानां सङ्घास्तांश्चापि निर्ममे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2186635, "chapter_id": 4965, "verse_number": "५", "content_sanskrit": "ब्राह्मणानां सितो वर्णः क्षत्रियाणां तु लोहितः ।\nवैश्यानां पीतको वर्णः शूद्राणामसितस्तथा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2186636, "chapter_id": 4965, "verse_number": "", "content_sanskrit": "भरद्वाजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2186637, "chapter_id": 4965, "verse_number": "६", "content_sanskrit": "चातुर्वर्ण्यस्य वर्णेन यदि वर्णो विभज्यते ।\nसर्वेषां खलु वर्णानां दृश्यते वर्णसङ्करः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2186638, "chapter_id": 4965, "verse_number": "७", "content_sanskrit": "कामः क्रोधो भयं लोभः शोकश्चिन्ता क्षुधा श्रमः ।\nसर्वेषां नः प्रभवति कस्माद्वर्णो विभज्यते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2186639, "chapter_id": 4965, "verse_number": "८", "content_sanskrit": "स्वेदमूत्रपुरीषाणि श्लेष्मा पित्तं सशोणितम् ।\nतनुः क्षरति सर्वेषां कस्माद्वर्णो विभज्यते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2186640, "chapter_id": 4965, "verse_number": "९", "content_sanskrit": "जङ्गमानामसङ्ख्येयाः स्थावराणां च जातयः ।\nतेषां विविधवर्णानां कुतो वर्णविनिश्चयः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2186641, "chapter_id": 4965, "verse_number": "", "content_sanskrit": "भृगुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2186642, "chapter_id": 4965, "verse_number": "१०", "content_sanskrit": "न विशेषोऽस्ति वर्णानां सर्वं ब्राह्ममिदं जगत् ।\nब्रह्मणा पूर्वसृष्टं हि कर्मभिर्वर्णतां गतम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2186643, "chapter_id": 4965, "verse_number": "११", "content_sanskrit": "कामभोगप्रियास्तीक्ष्णाः क्रोधनाः प्रियसाहसाः ।\nत्यक्तस्वधर्मा रक्ताङ्गास्ते द्विजाः क्षत्रतां गताः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2186644, "chapter_id": 4965, "verse_number": "१२", "content_sanskrit": "गोषु वृत्तिं समाधाय पीताः कृष्युपजीविनः ।\nस्वधर्मं नानुतिष्ठन्ति ते द्विजा वैश्यतां गताः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2186645, "chapter_id": 4965, "verse_number": "१३", "content_sanskrit": "हिंसानृतप्रिया लुब्धाः सर्वकर्मोपजीविनः ।\nकृष्णाः शौचपरिभ्रष्टास्ते द्विजाः शूद्रतां गताः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2186646, "chapter_id": 4965, "verse_number": "१४", "content_sanskrit": "इत्येतैः कर्मभिर्व्यस्ता द्विजा वर्णान्तरं गताः ।\nधर्मो यज्ञक्रिया चैषां नित्यं न प्रतिषिध्यते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2186647, "chapter_id": 4965, "verse_number": "१५", "content_sanskrit": "वर्णाश्चत्वार एते हि येषां ब्राह्मी सरस्वती ।\nविहिता ब्रह्मणा पूर्वं लोभात्त्वज्ञानतां गताः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2186648, "chapter_id": 4965, "verse_number": "१६", "content_sanskrit": "ब्राह्मणा धर्मतन्त्रस्थास्तपस्तेषां न नश्यति ।\nब्रह्म धारयतां नित्यं व्रतानि नियमांस्तथा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2186649, "chapter_id": 4965, "verse_number": "१७", "content_sanskrit": "ब्रह्म चैतत् पुरा सृष्टं ये न जानन्त्यतद्विदः ।\nतेषां बहुविधास्त्वन्यास्तत्र तत्र हि जातयः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2186650, "chapter_id": 4965, "verse_number": "१८", "content_sanskrit": "पिशाचा राक्षसाः प्रेता बहुधा म्लेच्छजातयः ।\nप्रनष्टज्ञानविज्ञानाः स्वच्छन्दाचारचेष्टिताः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2186651, "chapter_id": 4965, "verse_number": "१९", "content_sanskrit": "प्रजा ब्राह्मणसंस्काराः स्वधर्मकृतनिश्चयाः ।\nऋषिभिः स्वेन तपसा सृज्यन्ते चापरे परैः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2186652, "chapter_id": 4965, "verse_number": "२०", "content_sanskrit": "आदिदेवसमुद्भूता ब्रह्ममूलाक्षयाव्यया ।\nसा सृष्टिर्मानसी नाम धर्मतन्त्रपरायणा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2186653, "chapter_id": 4965, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे चतुर्दशोऽध्यायः ॥ १४ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]