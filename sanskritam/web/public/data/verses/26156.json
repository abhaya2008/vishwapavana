[{"id": 7006156000, "chapter_id": 26156, "verse_number": "१-२-१७-१", "content_sanskrit": "सूत उवाच ।\nस्वायंभूवनिसर्गे तु व्याख्यातान्यंतराणि च ।\nभविष्याणि च सर्वाणि तेषां वक्ष्याम्यनुक्रमम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006156001, "chapter_id": 26156, "verse_number": "१-२-१७-२", "content_sanskrit": "एतच्छ्रुतवा तु मुनयः पप्रच्छू रोमहर्षणम् ।\nसूर्याचंद्रमसोश्चारं ग्रहाणां चैव सर्वशः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006156002, "chapter_id": 26156, "verse_number": "१-२-१७-३", "content_sanskrit": "ऋषय ऋचुः ।\nभ्रमंति कथमेतानि ज्योतीषि दिवमंडलम् ।\nअव्यूहेन च सर्वाणि तथैवासंकरेण वा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006156003, "chapter_id": 26156, "verse_number": "१-२-१७-४", "content_sanskrit": "कश्चिद्भामयते तानि भ्रमंते यदि वा स्वयम् ।\nएतद्वेदितुमिच्छामस्तन्नो निगद सत्तम ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006156004, "chapter_id": 26156, "verse_number": "१-२-१७-५", "content_sanskrit": "सूत उवाच ।\nभूतसंमोहनं ह्येतद्वदतो मे निबोधत ।\nप्रत्यक्षमपि दृश्यं च संमोहयति यत्प्रजाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006156005, "chapter_id": 26156, "verse_number": "१-२-१७-६", "content_sanskrit": "योऽयं चतुर्द्दिशं पुच्छे शैशुमारे व्यवस्थितः ।\nउत्तानपादपुत्रोऽसौ मेढीभूतो ध्रुवो दिवि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006156006, "chapter_id": 26156, "verse_number": "१-२-१७-७", "content_sanskrit": "स वै भ्रामयते नित्यं चंद्रादित्यौ ग्रहैः सह ।\nभ्रमंतमनुगच्छंति नक्षत्राणि च चक्रवत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006156007, "chapter_id": 26156, "verse_number": "१-२-१७-८", "content_sanskrit": "ध्रुवस्य मनसा चासौ सर्वते ज्योतिषां गणः ।\nसूर्याचन्द्रमसौ तारा नक्षत्राणि ग्रहैः सह ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006156008, "chapter_id": 26156, "verse_number": "१-२-१७-९", "content_sanskrit": "वातानीकमयैर्बंधैर्ध्रुवे बद्धानि तानि वै ।\nतेषां योगश्च भेदश्च कालश्चारस्तथैव च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006156009, "chapter_id": 26156, "verse_number": "१-२-१७-१०", "content_sanskrit": "अस्तोदयौ तथोत्पाता अयने दक्षणोत्तरे ।\nविषुवद्ग्रहवर्णाश्च द्रुवात्सर्वं प्रवर्त्तते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006156010, "chapter_id": 26156, "verse_number": "१-२-१७-११", "content_sanskrit": "वर्षा घर्मो हिमं रात्रिः संध्या चैव दिनं तथा ।\nशुभाशुभं प्रजानां च ध्रुवात्सर्वं प्रवर्त्तते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006156011, "chapter_id": 26156, "verse_number": "१-२-१७-१२", "content_sanskrit": "ध्रुवेणाधिष्टितश्चैव सूर्योऽपो गृह्य वर्षति ।\nतदेष दीप्त किरणः स कालग्निर्दिवाकरः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006156012, "chapter_id": 26156, "verse_number": "१-२-१७-१३", "content_sanskrit": "परिवर्त्तक्रमाद्विप्रा भाभिरालोकयन् दिशः ।\nसूर्यः किरमजालेन वायुयुक्तेन सर्वशः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006156013, "chapter_id": 26156, "verse_number": "१-२-१७-१४", "content_sanskrit": "जगतो जलमादत्ते कृत्स्नस्य द्विजसत्तमाः ।\nआदित्यपीतं सकलं सोमः संक्रमते जलम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006156014, "chapter_id": 26156, "verse_number": "१-२-१७-१५", "content_sanskrit": "नाडीभिर्वायुयुक्ताभिर्लोकधारा प्रवर्त्तते ।\nयत्सोमात्स्रवते ह्यंबु तदन्नेष्वेव तिष्ठति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006156015, "chapter_id": 26156, "verse_number": "१-२-१७-१६", "content_sanskrit": "मेघा वायुविघातेन विसृजंति जलं भूवि ।\nएवमुत्ङिप्यते चैव पतते चासकृज्जलम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006156016, "chapter_id": 26156, "verse_number": "१-२-१७-१७", "content_sanskrit": "न नाश उदकस्यास्ति तदेव परिवर्त्तते ।\nसंधारणार्थं लोकानां मायैषा विश्वनिर्मिता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006156017, "chapter_id": 26156, "verse_number": "१-२-१७-१८", "content_sanskrit": "अन्या मायया व्याप्तं त्रैलोक्यं सचराचरम् ।\nविश्वेशो लोककृद्देवः सहस्राक्षः प्रजापतिः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006156018, "chapter_id": 26156, "verse_number": "१-२-१७-१९", "content_sanskrit": "धाता कृत्स्नस्य लोकस्य प्रभविष्णुर्दिवाकरः ।\nसार्वलोकिकमंभो यत्तत्सोमान्नभसश्व्युतम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006156019, "chapter_id": 26156, "verse_number": "१-२-१७-२०", "content_sanskrit": "सोमाधारं जगत्सर्वमेतत्तथ्यं प्रकीर्तितम् ।\nसूर्यादुष्णं निस्रवते सोमाच्छीतं प्रवर्त्तते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006156020, "chapter_id": 26156, "verse_number": "१-२-१७-२१", "content_sanskrit": "शीतोष्णवीर्यौ द्वावेतौ युक्त्या धारयतो जगत् ।\nसोमाधारा नदी गंगा पवित्रा विमलोदका ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006156021, "chapter_id": 26156, "verse_number": "१-२-१७-२२", "content_sanskrit": "भद्रसोमपुरोगाश्च महानद्यो द्विजोत्तमाः ।\nसर्वभूतशरीरेषु ह्यापो ह्यनुसृताश्च याः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006156022, "chapter_id": 26156, "verse_number": "१-२-१७-२३", "content_sanskrit": "तेषु संदह्यमानेषु जंगमस्थावरेषु च ।\nधूमभूतास्तु ता ह्यापो निष्कामंतीह सर्वशः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006156023, "chapter_id": 26156, "verse_number": "१-२-१७-२४", "content_sanskrit": "तेन चाभ्राणि जायंते स्थानमभ्रमयं स्मृतम् ।\nतेजोऽर्कः सर्वभूतेभ्य आदत्ते रश्मिभिर्जलम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006156024, "chapter_id": 26156, "verse_number": "१-२-१७-२५", "content_sanskrit": "समुद्राद्वायुसंयोगाद्वहंत्यापो गभस्तयः ।\nसंजीवनं च सस्यानामंभस्तदमृतोपमम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006156025, "chapter_id": 26156, "verse_number": "१-२-१७-२६", "content_sanskrit": "ततस्त्वृतुवशात्काले परिवत्य दिवाकरः ।\nयच्छत्यापो हि मेघेभ्यः घुक्लाशुक्लैर्गभस्तिभिः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006156026, "chapter_id": 26156, "verse_number": "१-२-१७-२७", "content_sanskrit": "अभ्रस्थाः प्रपतन्त्यापो वायुना समुदीरिताः ।\nसर्वभूतहितार्थाय वायुमिश्राः समंततः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006156027, "chapter_id": 26156, "verse_number": "१-२-१७-२८", "content_sanskrit": "ततो वर्षति षण्मासान्सर्वभूतविवृद्धये ।\nवायव्यं स्तनितं चैव वैद्युतं चाग्निसंभवम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006156028, "chapter_id": 26156, "verse_number": "१-२-१७-२९", "content_sanskrit": "मेहनाच्च मिहेधातोमघत्वं व्यजयंति हि ।\nन भ्रश्यंति यतश्चापस्तदभं कवयो विदुः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006156029, "chapter_id": 26156, "verse_number": "१-२-१७-३०", "content_sanskrit": "मेघानां पुनरुत्पत्तिश्त्रिविधा योनिरुच्यते ।\nआग्नेया ब्रह्मजाश्चैव पक्षजाश्च पृथग्विधाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006156030, "chapter_id": 26156, "verse_number": "१-२-१७-३१", "content_sanskrit": "त्रिधा मेघाः समाख्यातास्तेषां वक्ष्यामि संभवम् ।\nआग्नेया स्तूष्णजाः प्रोक्तास्तेषां धूमप्रवर्त्तनम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006156031, "chapter_id": 26156, "verse_number": "१-२-१७-३२", "content_sanskrit": "शीतदुर्दिनवाता ये स्वगुणास्ते व्यवस्थिताः ।\nमहिषाश्च वाराहाश्च मत्तमातंगरूपिणः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006156032, "chapter_id": 26156, "verse_number": "१-२-१७-३३", "content_sanskrit": "भूत्वा धरणिमभ्येत्य रमंते विचरंति च ।\nजीमूता नाम ते मेघा ह्येतेभ्यो जीवसंभवः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006156033, "chapter_id": 26156, "verse_number": "१-२-१७-३४", "content_sanskrit": "विद्युद्गुणविहीनाश्च जलधारा विलंबिनः ।\nमूकमेघा महाकाया आवहस्य वशानुगाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006156034, "chapter_id": 26156, "verse_number": "१-२-१७-३५", "content_sanskrit": "क्रोशमात्राच्च वर्षंति क्रोशार्द्धादपि वा पुनः ।\nपर्वताग्र नितंबेषु वर्षति च रसंति च ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006156035, "chapter_id": 26156, "verse_number": "१-२-१७-३६", "content_sanskrit": "बलाकागर्भदाश्चैव बलाकागर्भधारिणः ।\nब्रह्मजा नाम ते मेघा ब्रह्मनिश्वाससंभवाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006156036, "chapter_id": 26156, "verse_number": "१-२-१७-३७", "content_sanskrit": "ते हि विद्युद्गुणोपेतास्तनयित्नुप्रियस्वनाः ।\nतेषां शश्र्वत्प्रणादेन भूमिः स्वांगरूहोद्भवा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006156037, "chapter_id": 26156, "verse_number": "१-२-१७-३८", "content_sanskrit": "राज्ञी राज्याभिषिक्तेव पुनर्यौवनमश्नुते ।\nतेष्वियं प्रावृडासक्ता भूतानां जीवितोद्भवा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006156038, "chapter_id": 26156, "verse_number": "१-२-१७-३९", "content_sanskrit": "द्वितीयं प्रवहं वायुं मेघास्ते तु समाश्रिताः ।\nएतं योजनमात्राच्च साध्यर्द्धा निष्कृतादपि ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006156039, "chapter_id": 26156, "verse_number": "१-२-१७-४०", "content_sanskrit": "वृष्टिर्गर्भस्त्रिधा तेषां धारासारः प्रकीर्त्तितः ।\nपुष्करावर्त्तका नाम ते मेघाः पक्षसंभवाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006156040, "chapter_id": 26156, "verse_number": "१-२-१७-४१", "content_sanskrit": "शक्रेण पक्षच्छिन्ना ये पर्वतानां महौजसाम् ।\nकामागानां प्रवृद्धानां भूतानां शिवमिच्छता ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006156041, "chapter_id": 26156, "verse_number": "१-२-१७-४२", "content_sanskrit": "पुष्करा नाम ते मेघा बृंहंतस्तोयमत्सराः ।\nपुष्करावर्त्तकास्तेन कारणेनेह शब्दिताः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006156042, "chapter_id": 26156, "verse_number": "१-२-१७-४३", "content_sanskrit": "नानारूपधराश्चैव महाघोरस्वनाश्च ते ।\nकल्पांतवृष्टेः स्रष्टारः संवर्ताग्ने र्नियामकाः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006156043, "chapter_id": 26156, "verse_number": "१-२-१७-४४", "content_sanskrit": "वर्षंत्येते युगांतेषु तृतीयास्ते प्रकीर्त्तिताः ।\nअनेकरूपसंस्थानाः पूरयंतो महीतलम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006156044, "chapter_id": 26156, "verse_number": "१-२-१७-४५", "content_sanskrit": "वायुं पुरा वहन्तः स्युराश्रिताः कल्पसाधकाः ।\nयान्यंडस्य तु भिन्नस्य प्राकृतस्याभवंस्तदा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006156045, "chapter_id": 26156, "verse_number": "१-२-१७-४६", "content_sanskrit": "यस्मिन्ब्रह्मा समुत्पन्नश्चतुर्वक्त्रः स्वयंप्रभुः ।\nतान्येवांडकपालानि सर्वे मेघाः प्रकीर्त्तिताः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006156046, "chapter_id": 26156, "verse_number": "१-२-१७-४७", "content_sanskrit": "तेषामाप्यायनं धूमः सर्वेषामविशेषतः ।\nतेषां श्रेष्ठस्तु पर्जन्यश्चत्वारश्चैव दिग्गजाः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006156047, "chapter_id": 26156, "verse_number": "१-२-१७-४८", "content_sanskrit": "गजानां पर्वतानां च मेघानां भोगिभिः सह ।\nकुलमेकं पृथग्भूतं योनिरेका जलं स्मृतम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006156048, "chapter_id": 26156, "verse_number": "१-२-१७-४९", "content_sanskrit": "पर्जन्यो दिग्गजा श्चैव हेमन्ते शीतसंभवाः ।\nतुषारवृष्टिं वर्षंति शिष्टः सस्यप्रवृद्धये ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006156049, "chapter_id": 26156, "verse_number": "१-२-१७-५०", "content_sanskrit": "षष्ठः परिवहो नाम तेषां वायुरपाश्रयः ।\nयोऽसौ बिबर्त्ति भगवान्गंगामाकाशगोचराम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006156050, "chapter_id": 26156, "verse_number": "१-२-१७-५१", "content_sanskrit": "दिव्यामृतजला पुण्यां त्रिधास्वातिपथे स्थिताम् ।\nतस्या निष्यंदतोयानि दिग्गजाः पृथुभिः करैः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006156051, "chapter_id": 26156, "verse_number": "१-२-१७-५२", "content_sanskrit": "शीकरं संप्रमुंचंति नीहार इति स स्मृतः ।\nदक्षिणेन गिरिर्योऽसौ हेमकूट इति स्मृतः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006156052, "chapter_id": 26156, "verse_number": "१-२-१७-५३", "content_sanskrit": "उदग्घिमवतः शैल उत्तरप्रायदक्षिणे ।\nपुंड्रं नाम समाख्यातं नगरं तत्र विस्तृतम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006156053, "chapter_id": 26156, "verse_number": "१-२-१७-५४", "content_sanskrit": "तस्मिन्निपतितं वर्षं तत्तुषारसमुद्भवम् ।\nततस्तदा वहो वायुर्हेमवंतं समुद्वहन् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006156054, "chapter_id": 26156, "verse_number": "१-२-१७-५५", "content_sanskrit": "आनयत्यात्मयोगेन सिंचमानो महागिरिम् ।\nहिमवंतमतिक्रम्य वृष्टिशेषं ततः परम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006156055, "chapter_id": 26156, "verse_number": "१-२-१७-५६", "content_sanskrit": "इहाभ्येति ततः पश्चादपरांतविवृद्धये ।\nवर्षद्वयं समाख्यातं सस्यद्वयविवृद्धये ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006156056, "chapter_id": 26156, "verse_number": "१-२-१७-५७", "content_sanskrit": "मेघाश्चाप्यायनं चैव सर्वमेतत्प्रकीर्त्तितम् ।\nसूर्य एव तु वृष्टीनां स्रष्टा समुपदिश्यते ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006156057, "chapter_id": 26156, "verse_number": "१-२-१७-५८", "content_sanskrit": "सूर्यमूला च वै वृष्टिर्जलं सूर्यात्प्रवर्तते ।\nध्रुवेणाधिष्ठितः सूर्यस्तस्यां वृष्टौ प्रवर्त्तते ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006156058, "chapter_id": 26156, "verse_number": "१-२-१७-५९", "content_sanskrit": "ध्रुवेणाधिष्टितो वायुर्वृष्टिं संहरते पुनः ।\nग्रहो निःसृत्य सूर्यात्तु कृत्स्ने नक्षत्रमंडले ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006156059, "chapter_id": 26156, "verse_number": "१-२-१७-६०", "content_sanskrit": "चरित्वान्ते विशत्यर्कं ध्रुवेण समाधिष्ठितम् ।\nततः सूर्यरथस्याथ सन्निवेशं निबोधत ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006156060, "chapter_id": 26156, "verse_number": "१-२-१७-६१", "content_sanskrit": "संस्थितेनैकचक्रेण पंचारेण त्रिनाभिना ।\nहिरण्मयेन भगवांस्तथैव हरिदर्वणा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006156061, "chapter_id": 26156, "verse_number": "१-२-१७-६२", "content_sanskrit": "अष्टापदनिबद्धेन षट्प्रकारैकनेमिना ।\nचक्रेण भास्वता सूर्यः स्यंदनेन प्रसर्पति ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006156062, "chapter_id": 26156, "verse_number": "१-२-१७-६३", "content_sanskrit": "दशयोजनसाहस्रो विस्तारायामतः स्मृतः ।\nद्विगुणोऽस्य रथोपस्थादीषादंडः प्रमाणतः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006156063, "chapter_id": 26156, "verse_number": "१-२-१७-६४", "content_sanskrit": "स तस्य ब्रह्मणा सृष्टो रथो ह्यर्थवशेन तु ।\nअसंगः कांचनो दिव्यो युक्तः पवनगैर्हयैः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006156064, "chapter_id": 26156, "verse_number": "१-२-१७-६५", "content_sanskrit": "छंदोभिर्वाजिरूपैस्तु यतश्चक्रं ततः स्थितैः ।\nवारुणस्यंदनस्येह लक्षणैः सदृशस्तु सः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006156065, "chapter_id": 26156, "verse_number": "१-२-१७-६६", "content_sanskrit": "तेनासौ सर्वते व्योम्नि भास्वता तु दिवाकरः ।\nअथैतानि तु सूर्यस्य प्रत्यंगानि रथस्य ह ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006156066, "chapter_id": 26156, "verse_number": "१-२-१७-६७", "content_sanskrit": "संवत्सरस्यावयवैः कल्पि तस्य यथाक्रमम् ।\nअहस्तु नाभिः सौरस्य एकचक्रस्य वै स्मृतः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006156067, "chapter_id": 26156, "verse_number": "१-२-१७-६८", "content_sanskrit": "अराः पंचार्त्तवांस्तस्य नेमिः षडृतवः स्मृतः ।\nरथनीडः स्मृतो ह्येष चायने कूबरावुभौ ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006156068, "chapter_id": 26156, "verse_number": "१-२-१७-६९", "content_sanskrit": "मुहूर्त्ता बंधुरास्तस्य रम्याश्चास्य कलाः स्मृताः ।\nतस्य काष्ठा स्मृता घोणा अक्षदंडः क्षणस्तु वै ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006156069, "chapter_id": 26156, "verse_number": "१-२-१७-७०", "content_sanskrit": "निमेषश्चानुकर्षोऽस्य हीषा चास्य लवाःस्मृताः ।\nरात्रिर्वरूथो धर्मोऽस्य ध्वज ऊर्द्ध्व समुच्छ्रितः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006156070, "chapter_id": 26156, "verse_number": "१-२-१७-७१", "content_sanskrit": "युगाक्षकोडी ते तस्य अर्थकामावुभौ स्मृतौ ।\nसप्ताश्वरूपाश्छंदासि वहंतो वामतो धुरम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006156071, "chapter_id": 26156, "verse_number": "१-२-१७-७२", "content_sanskrit": "गायत्री चैव त्रिष्टुप्य ह्यनुष्टुब्जगती तथा ।\nपंक्तिश्च बृहती चैव ह्युष्णिक्चैव तु सप्तमी ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006156072, "chapter_id": 26156, "verse_number": "१-२-१७-७३", "content_sanskrit": "चक्रमक्षे निबद्धं तु ध्रुवे चाक्षः समर्पितः ।\nसहचक्रो भ्रमत्यक्षः सहक्षो भ्रमते ध्रुवः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006156073, "chapter_id": 26156, "verse_number": "१-२-१७-७४", "content_sanskrit": "अक्षेण सह चक्रेशो भ्रमतेऽसौ ध्रुवेरितः ।\nएवमर्थवशात्तस्य सन्निवेशो रथस्य तु ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006156074, "chapter_id": 26156, "verse_number": "१-२-१७-७५", "content_sanskrit": "तथा संयोगभावेन संसिद्धो भासुरो रथः ।\nतेनासौ तरणिर्देवो भास्वता सर्पते दिवि ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006156075, "chapter_id": 26156, "verse_number": "१-२-१७-७६", "content_sanskrit": "युगाक्षकोटिसन्नद्धौ द्वौ रश्मी स्यन्दनस्य तु ।\nध्रुवे तौ भ्राम्यते रश्मी च चक्रयुगयोस्तु वै ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006156076, "chapter_id": 26156, "verse_number": "१-२-१७-७७", "content_sanskrit": "भ्रमतो मण्डलान्यस्य खेचरस्य रथस्य तु ।\nयुगाक्षकोटी ते तस्य दक्षिणे स्यंदनस्य हि ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006156077, "chapter_id": 26156, "verse_number": "१-२-१७-७८", "content_sanskrit": "ध्रुवेण प्रगृहीते वै विचक्रम तुरक्षवत् ।\nभ्रमंतमनुगच्छेतां ध्रुवं रश्मी तु तावुभौ ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006156078, "chapter_id": 26156, "verse_number": "१-२-१७-७९", "content_sanskrit": "युगाक्षकोटिस्तत्तस्य रश्मिभिः स्यंदनस्य तु ।\nकीलासक्ता यथा रज्जुर्भ्रंमते सर्वतो दिशम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006156079, "chapter_id": 26156, "verse_number": "१-२-१७-८०", "content_sanskrit": "ह्रसतस्तस्य रश्मी तु मंडलेषूत्तरायणे ।\nवर्द्धते दक्षिणे चैव भ्रमतो मंडलानि तु ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006156080, "chapter_id": 26156, "verse_number": "१-२-१७-८१", "content_sanskrit": "युगाक्षकोटिसंबद्धौ रश्मी द्वौ स्यन्दनस्य तु ।\nध्रुवेण प्रगृहीतौ वै तौ रश्मी नयतो रविम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006156081, "chapter_id": 26156, "verse_number": "१-२-१७-८२", "content_sanskrit": "आकृष्येते यदा तौ वै ध्रुवेण सम धिष्ठितौ ।\nतदा सोऽभ्यंतरे सूर्यो भ्रमते मंडलानि तु ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006156082, "chapter_id": 26156, "verse_number": "१-२-१७-८३", "content_sanskrit": "अशीतिर्मंडलशतं काष्ठयोरंतरं स्मृतम् ।\nध्रुवेण मुच्यमानाभ्यां रश्मिभ्यां पुनरेव तु ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006156083, "chapter_id": 26156, "verse_number": "१-२-१७-८४", "content_sanskrit": "तथैव बाह्यतः सूर्यो भ्रमते मंडलानि तु ।\nउद्वेष़्टयन्स वेगेन मंडलानि तु गच्छति ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}]