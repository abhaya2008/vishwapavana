[{"id": 2198201, "chapter_id": 5213, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2198202, "chapter_id": 5213, "verse_number": "१", "content_sanskrit": "ब्राह्मणानेव सततं भृशं सम्प्रतिपूजयेत् ।\nएते हि सोमराजान ईश्वराः सुखदुःखयोः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2198203, "chapter_id": 5213, "verse_number": "२", "content_sanskrit": "एते भोगैरलङ्कारैरन्यैश्चैव किमिच्छकैः ।\nसदा पूज्या नमस्कार्या रक्ष्याश्च पितृवन्नृपैः ।\nअतो राष्ट्रस्य शान्तिर्हि भूतानामिव वासवात्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2198204, "chapter_id": 5213, "verse_number": "३", "content_sanskrit": "जायतां ब्रह्मवर्चस्वी राष्ट्रे वै ब्राह्मणः शुचिः ।\nमहारथश्च राजन्य एष्टव्यः शत्रुतापनः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2198205, "chapter_id": 5213, "verse_number": "४", "content_sanskrit": "ब्राह्मणं जातिसम्पन्नं धर्मज्ञं संशितव्रतम् ।\nवासयेत गृहे राजन् न तस्मात् परमस्ति वै\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2198206, "chapter_id": 5213, "verse_number": "५", "content_sanskrit": "ब्राह्मणेभ्यो हविर्दत्तं प्रतिगृह्णन्ति देवताः ।\nपितरः सर्वभूतानां नैतेभ्यो विद्यते परम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2198207, "chapter_id": 5213, "verse_number": "६", "content_sanskrit": "आदित्यश्चन्द्रमा वायुर्भूमिरापोऽम्बरं दिशः ।\nसर्वे ब्राह्मणमाविश्य सदाऽन्नमुपभुञ्जते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2198208, "chapter_id": 5213, "verse_number": "७", "content_sanskrit": "न तस्याश्नन्ति पितरो यस्य विप्रा न भुञ्जते ।\nदेवाश्चाप्यस्य नाश्नन्ति पापस्य ब्राह्मणद्विषः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2198209, "chapter_id": 5213, "verse_number": "८", "content_sanskrit": "ब्राह्मणेषु तु तुष्टेषु प्रीयन्ते पितरः सदा ।\nतथैव देवता राजन् नात्र कार्या विचारणा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2198210, "chapter_id": 5213, "verse_number": "९", "content_sanskrit": "तथैव तेऽपि प्रीयन्ते येषां भवति तद्धविः ।\nन च प्रेत्य विनश्यन्ति गच्छन्ति परमां गतिम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2198211, "chapter_id": 5213, "verse_number": "१०", "content_sanskrit": "येन येनैव हविषा ब्राह्मणांस्तर्पयेन्नरः ।\nतेन तेनैव प्रीयन्ते पितरो देवतास्तथा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2198212, "chapter_id": 5213, "verse_number": "११", "content_sanskrit": "ब्राह्मणादेव तद्भूतं प्रभवन्ति यतः प्रजाः ।\nयतश्चायं प्रभवति प्रेत्य यत्र च गच्छति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2198213, "chapter_id": 5213, "verse_number": "१२", "content_sanskrit": "वेदैष मार्गं स्वर्गस्य तथैव नरकस्य च ।\nआगतानागते चोभे ब्राह्मणो द्विपदांवरः ।\nब्राह्मणो भरतश्रेष्ठ स्वधर्मं वेद मेधया\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2198214, "chapter_id": 5213, "verse_number": "१३", "content_sanskrit": "ये चैनमनुवर्तन्ते ते न यान्ति पराभवम् ।\nन ते प्रेत्य विनश्यन्ति गच्छन्ति न पराभवम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2198215, "chapter_id": 5213, "verse_number": "१४", "content_sanskrit": "ये ब्राह्मणमुखात् प्राप्तं प्रतिगृह्णन्ति वै वचः ।\nकृतात्मानो महात्मानस्ते न यान्ति पराभवम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2198216, "chapter_id": 5213, "verse_number": "१५", "content_sanskrit": "क्षत्रियाणां प्रतपतां तेजसा च बलेन च ।\nब्राह्मणेष्वेव शाम्यन्ति तेजांसि च बलानि च\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2198217, "chapter_id": 5213, "verse_number": "१६", "content_sanskrit": "भृगवोऽजयंस्ताळजङ्घान् नीपानङ्गिरसोऽजयन् ।\nभरद्वाजो वैतहव्यानैलांश्च भरतर्षभ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2198218, "chapter_id": 5213, "verse_number": "१७", "content_sanskrit": "चित्रायुधांश्चाप्यजयन्नेते कृष्णाजिनध्वजाः ।\nप्रक्षिप्याथ च कुम्भान् वै पारगामिनमाहरन्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2198219, "chapter_id": 5213, "verse_number": "१८", "content_sanskrit": "यत्किञ्चित् कथ्यते लोके श्रूयते पश्यतेऽपि वा ।\nसर्वं तद् ब्राह्मणेष्वेव गूढोऽग्निरिव दारुषु\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2198220, "chapter_id": 5213, "verse_number": "१९", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nसंवादं वासुदेवस्य पृथ्व्याश्च भरतर्षभ\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2198221, "chapter_id": 5213, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2198222, "chapter_id": 5213, "verse_number": "२०", "content_sanskrit": "मातरं सर्वभूतानां पृच्छे त्वा संशयं शुभे ।\nकेनस्वित् कर्मणा पापं व्यपोहति नरो गृही\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2198223, "chapter_id": 5213, "verse_number": "", "content_sanskrit": "पृथिवी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2198224, "chapter_id": 5213, "verse_number": "२१", "content_sanskrit": "ब्राह्मणानेव सेवेत पवित्रं ह्येतदुत्तमम् ।\nब्राह्मणान् सेवमानस्य रजः सर्वं प्रणश्यति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2198225, "chapter_id": 5213, "verse_number": "२२", "content_sanskrit": "अतो भूतिरतः कीर्तिरतो बुद्धिः प्रजायते ।\nअपरेषां परेषां च परेभ्यश्चैव ये परे\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2198226, "chapter_id": 5213, "verse_number": "२३", "content_sanskrit": "ब्राह्मणा यं प्रशंसन्ति पुरुषः स प्रवर्धते ।\nअथ यो ब्राह्मणाक्रुष्टः पराभवति सोऽचिरात्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2198227, "chapter_id": 5213, "verse_number": "२४", "content_sanskrit": "यथा महार्णवे क्षिप्तं आमलोष्टो विनश्यति ।\nतथा दुश्चरितं कर्म पराभावाय कल्पते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2198228, "chapter_id": 5213, "verse_number": "२५", "content_sanskrit": "पश्य चन्द्रे कृतं लक्ष्म समुद्रे लवणोदकम् ।\nतथा भगसहस्रेण महेन्द्रं परिचिह्नितम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2198229, "chapter_id": 5213, "verse_number": "२६", "content_sanskrit": "तेषामेव प्रभावेन सहस्रनयनो ह्यसौ ।\nशतक्रतुः समभवत् पश्य माधव यादृशम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2198230, "chapter_id": 5213, "verse_number": "२७", "content_sanskrit": "इच्छन् भूतिं च कीर्तिं च लोकांश्च मधुसूदन ।\nब्राह्मणानुमते तिष्ठेत् पुरुषः शुचिरात्मवान्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2198231, "chapter_id": 5213, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2198232, "chapter_id": 5213, "verse_number": "२८", "content_sanskrit": "इत्येतद्वचनं श्रुत्वा मेदिन्या मधुसूदनः ।\nसाधु साध्वित्यथेत्युक्त्वा मेदिनीं प्रत्यपूजयत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2198233, "chapter_id": 5213, "verse_number": "२९", "content_sanskrit": "एतां श्रुत्वोपमां पार्थ प्रयतो ब्राह्मणर्षभान् ।\nसततं पूजयेथास्त्वं ततः श्रेयोऽभिपत्स्यसे\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2198234, "chapter_id": 5213, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे ब्राह्मणप्रशंसानाम चतुःषष्टितमोऽध्यायः ॥६४॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]