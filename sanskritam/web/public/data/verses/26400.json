[{"id": 7006400000, "chapter_id": 26400, "verse_number": "२-५७-१", "content_sanskrit": "जनमेजय उवाच\nभगवञ्छ्रोतुमिच्छामि विस्तरेण महात्मनः ।\nचरितं वासुदेवस्य यदुश्रेष्ठस्य धीमतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006400001, "chapter_id": 26400, "verse_number": "२-५७-२", "content_sanskrit": "किमर्थं च परित्यज्य मथुरां मधुसूदनः ।\nमध्यदेशस्य ककुदं धाम लक्ष्म्याश्च केवलम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006400002, "chapter_id": 26400, "verse_number": "२-५७-३", "content_sanskrit": "शृङ्गं पृथिव्याः स्वालक्ष्यं प्रभूतधनधान्यवत् ।\nआर्याढ्यजलभूयिष्ठमधिष्ठानवरोत्तमम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006400003, "chapter_id": 26400, "verse_number": "२-५७-४", "content_sanskrit": "अयुद्धेनैव दाशार्हस्त्यक्तवान् द्विजसत्तम ।\nस कालयवनश्चापि कृष्णे किं प्रत्यपद्यत ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006400004, "chapter_id": 26400, "verse_number": "२-५७-५", "content_sanskrit": "द्वारकां च समासाद्य वारिदुर्गां जनार्दनः ।\nकिं चकार महाबाहुर्महायोगी महातपाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006400005, "chapter_id": 26400, "verse_number": "२-५७-६", "content_sanskrit": "किं वीर्यः कालयवनः केन जातश्च वीर्यवान् ।\nयमसह्यं समालक्ष्य व्यपयातो जनार्दनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006400006, "chapter_id": 26400, "verse_number": "२-५७-७", "content_sanskrit": "वैशम्पायन उवाच\nवृष्णीनामन्धकानां च गुरुर्गार्ग्यो महामनाः ।\nब्रह्मचारी पुरा भूत्वा न स्म दारान्स विन्दति ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006400007, "chapter_id": 26400, "verse_number": "२-५७-८", "content_sanskrit": "तथा हि वर्तमानं तमूर्ध्वरेतसमव्ययम् ।\nश्यालोऽभिशस्तवान् गार्ग्यमपुमानितिराजनि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006400008, "chapter_id": 26400, "verse_number": "२-५७-९", "content_sanskrit": "सोऽभिशस्तस्तदा राजन् नगरे त्वजितं जये ।\nअलिप्संस्तु स्त्रियं चैव तपस्तेपे सुदारुणम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006400009, "chapter_id": 26400, "verse_number": "२-५७-१०", "content_sanskrit": "ततो द्वादशवर्षाणि सोऽयश्चूर्णमभक्षयत् ।\nआराधयन् महादेवमचिन्त्यं शूलपाणिनम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006400010, "chapter_id": 26400, "verse_number": "२-५७-११", "content_sanskrit": "रुद्रस्तस्मै वरं प्रादात् समर्थं युधि निग्रहे ।\nवृष्णीनामन्धकानां च सर्वतेजोमयं सुतम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006400011, "chapter_id": 26400, "verse_number": "२-५७-१२", "content_sanskrit": "ततः शुश्राव तं राजा यवनाधिपतिर्वरम् ।\nपुत्रप्रसवजं दैवादपुत्रः पुत्रकामिता ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006400012, "chapter_id": 26400, "verse_number": "२-५७-१३", "content_sanskrit": "स नृपस्तमुपानाय्य सान्त्वयित्वा द्विजोत्तमम् ।\nतं घोषमध्ये यवनो गोपस्त्रीषु समासृजत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006400013, "chapter_id": 26400, "verse_number": "२-५७-१४", "content_sanskrit": "गोपाली त्वप्सरास्तत्र गोपस्त्रीवेषधारिणी ।\nधारयामास गार्ग्यस्य गर्भं दुर्धरमच्युतम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006400014, "chapter_id": 26400, "verse_number": "२-५७-१५", "content_sanskrit": "मानुष्यां गार्ग्यभार्यायां नियोगाच्छूलपाणिनः ।\nस कालयवनो नाम जज्ञे शूरो महाबलः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006400015, "chapter_id": 26400, "verse_number": "२-५७-१६", "content_sanskrit": "अपुत्रस्याथ राज्ञस्तु ववृधेऽन्तःपुरे शिशुः ।\nतस्मिन्नुपरते राजन् स कालयवनो नृपः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006400016, "chapter_id": 26400, "verse_number": "२-५७-१७", "content_sanskrit": "युद्धाभिकामो नृपतिः पर्यपृच्छद्द्विजोत्तमान् ।\nवृष्ण्यन्धककुलं तस्य नारदेन निवेदितम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006400017, "chapter_id": 26400, "verse_number": "२-५७-१८", "content_sanskrit": "ज्ञात्वा तु वरदानं तन्नारदान्मधुसूदनः ।\nउपप्रैक्षत तेजस्वी वर्द्धन्तं यवनेषु तम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006400018, "chapter_id": 26400, "verse_number": "२-५७-१९", "content_sanskrit": "समृद्धो हि यदा राजा यवनानां महाबलः ।\nतत एवं नृपा म्लेच्छाः संश्रित्यानुययुस्तदा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006400019, "chapter_id": 26400, "verse_number": "२-५७-२०", "content_sanskrit": "शकास्तुषारा दरदाः पारदाः शृङ्गलाः खसाः ।\nपह्लवाः शतशश्चान्ये म्लेच्छा हैमवतास्तथा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006400020, "chapter_id": 26400, "verse_number": "२-५७-२१", "content_sanskrit": "स तैः परिवृतो राजा दस्युभिः शलभैरिव ।\nनानावेषायुधैर्भीमैर्मथुरामभ्यवर्तत ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006400021, "chapter_id": 26400, "verse_number": "२-५७-२२", "content_sanskrit": "गजवाजिखरोष्ट्राणामयुतैरर्बुदैरपि ।\nपृथिवीं कम्पयामास सैन्येन महता वृतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006400022, "chapter_id": 26400, "verse_number": "२-५७-२३", "content_sanskrit": "रेणुना सूर्यमार्गं तु समवच्छाद्य पार्थिवः ।\nमूत्रेण शकृता चैव सैन्येन ससृजे नदीम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006400023, "chapter_id": 26400, "verse_number": "२-५७-२४", "content_sanskrit": "अश्वोष्ट्रशकृतां राशेर्निस्सृतेति जनाधिप।\nततोऽश्वशकृदित्येवं नाम नद्या बभूव ह ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006400024, "chapter_id": 26400, "verse_number": "२-५७-२५", "content_sanskrit": "तत्सैन्यं महदायाद् वै श्रुत्वा वृष्ण्यन्धकाग्रणीः ।\nवसुदेवः समानाय्य ज्ञातीनिदमुवाच ह ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006400025, "chapter_id": 26400, "verse_number": "२-५७-२६", "content_sanskrit": "इदं समुत्थितं घोरं वृष्ण्यन्धकभयं महत् ।\nअवध्यश्चापि नः शत्रुर्वरदानात् पिनाकिनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006400026, "chapter_id": 26400, "verse_number": "२-५७-२७", "content_sanskrit": "सामादयोऽभ्युपायाश्च विहितास्तस्य सर्वशः ।\nमत्तो मदबलाभ्यां तु युद्धमेव चिकीर्षति ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006400027, "chapter_id": 26400, "verse_number": "२-५७-२८", "content_sanskrit": "एतावानिह वासश्च कथितो नारदेन मे ।\nएतावति च वक्तव्यं सामैव परमं मतम ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006400028, "chapter_id": 26400, "verse_number": "२-५७-२९", "content_sanskrit": "जरासंधश्च नो राजा नित्यमेव न मृष्यते ।\nतथान्ये पृथिवीपाला वृष्णिचक्रप्रतापिताः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006400029, "chapter_id": 26400, "verse_number": "२-५७-३०", "content_sanskrit": "केचित् कंसवधाच्चापि विरक्तास्तद्गता नृपाः ।\nसमाश्रित्य जरासंधमस्मानिच्छन्ति बाधितुम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006400030, "chapter_id": 26400, "verse_number": "२-५७-३१", "content_sanskrit": "बहवो ज्ञातयश्चैव यदूनां निहता नृपैः ।\nवर्द्धितुं नैव शक्ष्याम पुरेऽस्मिन्निति केशवः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006400031, "chapter_id": 26400, "verse_number": "२-५७-३२", "content_sanskrit": "अपयाने मतिं कृत्वा दूतं तस्मै ससर्ज ह ।\nततः कुम्भे महासर्पं भिन्नाञ्जनचयोपमम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006400032, "chapter_id": 26400, "verse_number": "२-५७-३३", "content_sanskrit": "घोरमाशीविषं कृष्णं कृष्णः प्राक्षेपयत् तदा ।\nततस्तं मुद्रयित्वा तु स्वेन दूतेन हारयत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006400033, "chapter_id": 26400, "verse_number": "२-५७-३४", "content_sanskrit": "निदर्शनार्थं गोविन्दो भीषयामास तं नृपम् ।\nस दूतः कालयवने दर्शयामास तं घटम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006400034, "chapter_id": 26400, "verse_number": "२-५७-३५", "content_sanskrit": "कालसर्पोपमः कृष्ण इत्युक्त्वा भरतर्षभ ।\nतत्कालयवनो बुद्ध्वा त्रासनं यादवैः कृतम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006400035, "chapter_id": 26400, "verse_number": "२-५७-३६", "content_sanskrit": "पिपीलिकानां चण्डानां पूरयामास तं घटम् ।\nस सर्पो बहुभिस्तीक्ष्णैः सर्वतस्तैः पिपीलिकैः ।\nभक्ष्यमाणःकिलाङ्गेषु भस्मीभूतोऽभवत्तदा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006400036, "chapter_id": 26400, "verse_number": "२-५७-३७", "content_sanskrit": "तं मुद्रयित्वा तु घटं तथैव यवनाधिपः ।\nप्रेषयामास कृष्णाय बाहुल्यमुपवर्णयन् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006400037, "chapter_id": 26400, "verse_number": "२-५७-३८", "content_sanskrit": "वासुदेवस्तु तं दृष्ट्वा योगं विहतमात्मनः ।\nउत्सृज्य मथुरामाशु द्वारकामभिजग्मिवान् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006400038, "chapter_id": 26400, "verse_number": "२-५७-३९", "content_sanskrit": "वैरस्यान्तं विधित्संस्तु वासुदेवो महायशाः ।\nनिवेश्य द्वारकां राजन्वृष्णीनाश्वास्य चैव ह ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006400039, "chapter_id": 26400, "verse_number": "२-५७-४०", "content_sanskrit": "पदातिः पुरुषव्याघ्रो बाहुप्रहरणस्तदा ।\nआजगाम महावीर्यो मथुरां मधुसूदनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006400040, "chapter_id": 26400, "verse_number": "२-५७-४१", "content_sanskrit": "तं दृष्ट्वा निर्ययौ हृष्टः स कालयवनो रुषा ।\nप्रेक्षापूर्वं च कृष्णोऽपि निश्चकर्ष महाबलः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006400041, "chapter_id": 26400, "verse_number": "२-५७-४२", "content_sanskrit": "अथाभ्यगच्छद् गोविन्दं जिघृक्षुर्यवनेश्वरः ।\nन चैनमशकद् राजा ग्रहीतुं योगधर्मिणम्. ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006400042, "chapter_id": 26400, "verse_number": "२-५७-४३", "content_sanskrit": "मान्धातुस्तु सुतो राजा मुचुकुन्दो महायशाः ।\nपुरा देवासुरे युद्धे कृतकर्मा महाबलः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006400043, "chapter_id": 26400, "verse_number": "२-५७-४४", "content_sanskrit": "वरेण च्छन्दितो देवैर्निद्रामेव गृहीतवान् ।\nश्रान्तस्य तस्य वागेवं तदा प्रादुरभूत् किल ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006400044, "chapter_id": 26400, "verse_number": "२-५७-४५", "content_sanskrit": "प्रसुप्तं बोधयेद् यो मां तं दहेयमहं सुराः ।\nचक्षुषा क्रोधदीप्तेन एवमाह पुनः पुनः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006400045, "chapter_id": 26400, "verse_number": "२-५७-४६", "content_sanskrit": "एवमस्त्विति तं शक्र उवाच त्रिदशैः सह ।\nस सुरैरभ्यनुज्ञातो ह्यद्रिराजमुपागमत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006400046, "chapter_id": 26400, "verse_number": "२-५७-४७", "content_sanskrit": "स पर्वतगुहां कांचित् प्रविश्य श्रमकर्शितः ।\nसुष्वाप कालमेतं वै यावत्कृष्णस्य दर्शनम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006400047, "chapter_id": 26400, "verse_number": "२-५७-४८", "content_sanskrit": "तत्सर्वं वासुदेवाय नारदेन निवेदितम् ।\nवरदानं च देवेभ्यस्तेजस्तस्य च भूपतेः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006400048, "chapter_id": 26400, "verse_number": "२-५७-४९", "content_sanskrit": "कृष्णोऽनुगम्यमानश्च तेन म्लेच्छेन शत्रुणा ।\nतां गुहां मुचुकुन्दस्य प्रविवेश विनीतवत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006400049, "chapter_id": 26400, "verse_number": "२-५७-५०", "content_sanskrit": "शिरःस्थाने तु राजर्षेर्मुचुकुन्दस्य केशवः ।\nसंदर्शनपथं त्यक्त्वा तस्थौ बुद्धिमतां वरः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006400050, "chapter_id": 26400, "verse_number": "२-५७-५१", "content_sanskrit": "अनुप्रविश्य यवनो ददर्श पृथिवीपतिम् ।\nस तं सुप्तं कृतान्ताभमाससाद सुदुर्मतिः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006400051, "chapter_id": 26400, "verse_number": "२-५७-५२", "content_sanskrit": "वासुदेवं तु तं मत्वा घट्टयामास पार्थिवम् ।\nपादेनात्मविनाशाय शलभः पावकं यथा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006400052, "chapter_id": 26400, "verse_number": "२-५७-५३", "content_sanskrit": "मुचुकुन्दस्तु राजर्षिः पादस्पर्शप्रबोधितः ।\nनिद्राच्छेदेन चुक्रोध पादस्पर्शेन तेन च ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006400053, "chapter_id": 26400, "verse_number": "२-५७-५४", "content_sanskrit": "संस्मृत्य स वरं शक्रादवैक्षत तमग्रतः ।\nस दृष्टमात्रः क्रोधेन सम्प्रजज्वाल सर्वशः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006400054, "chapter_id": 26400, "verse_number": "२-५७-५५", "content_sanskrit": "ददाह पावकस्तं तु शुष्कं वृक्षमिवाशनिः ।\nक्षणेन कालयवनं नेत्रतेजोविनिर्गतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006400055, "chapter_id": 26400, "verse_number": "२-५७-५६", "content_sanskrit": "तं वासुदेवः श्रीमन्तं चिरसुप्तं नराधिपम् ।\nकृतकार्योऽब्रवीद् धीमानिदं वचनमुत्तमम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006400056, "chapter_id": 26400, "verse_number": "२-५७-५७", "content_sanskrit": "राजंश्चिरप्रसुप्तोऽसि कथितो नारदेन मे ।\nकृतं मे सुमहत्कार्यं स्वस्ति तेऽस्तु व्रजाम्यहम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006400057, "chapter_id": 26400, "verse_number": "२-५७-५८", "content_sanskrit": "वासुदेवमुपालक्ष्य राजा ह्रस्वं प्रमाणतः ।\nपरिष्कृतं युगं मेने कालेन महता तदा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006400058, "chapter_id": 26400, "verse_number": "२-५७-५९", "content_sanskrit": "उवाच राजा गोविन्दं को भवान् किमिहागतः ।\nकश्च कालः प्रसुप्तस्य यदि जानासि कथ्यताम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006400059, "chapter_id": 26400, "verse_number": "२-५७-६०", "content_sanskrit": "श्रीकृष्ण उवाच\nसोमवंशोद्भवो राजा ययातिर्नाम नाहुषः ।\nतस्य पुत्रो यदुर्ज्येष्ठश्चत्वारोऽन्ये यवीयसः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006400060, "chapter_id": 26400, "verse_number": "२-५७-६१", "content_sanskrit": "यदुवंशात् समुत्पन्नं वसुदेवात्मजं विभो ।\nवासुदेवं विजानीहि नृपते मामिहागतम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006400061, "chapter_id": 26400, "verse_number": "२-५७-६२", "content_sanskrit": "त्रेतायुगे प्रसुप्तोऽसि विदितो मेऽसि नारदात् ।\nइदं कलियुगं विद्धि किमन्यत् करवाणि ते ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006400062, "chapter_id": 26400, "verse_number": "२-५७-६३", "content_sanskrit": "मम शत्रुस्त्वया दग्धो देवदत्तवरो नृप ।\nअवध्यो यो मया संख्ये भवेद् वर्षशतैरपि ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006400063, "chapter_id": 26400, "verse_number": "२-५७-६४", "content_sanskrit": "वैशम्पायन उवाच\nइत्युक्तः स तु कृष्णेन निर्जगाम गुहामुखात् ।\nअन्वीयमानः कृष्णेन कृतकार्येण धीमता ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006400064, "chapter_id": 26400, "verse_number": "२-५७-६५", "content_sanskrit": "ततो ददर्श पृथिवीमावृतां ह्रस्वकैर्नरैः ।\nस्वल्पोत्साहैरल्पबलैरल्पवीर्यपराक्रमैः ।\nपरेणाधिष्ठितं चैव राज्यं केवलमात्मनः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006400065, "chapter_id": 26400, "verse_number": "२-५७-६६", "content_sanskrit": "प्रीत्या विसृज्य गोविन्दं प्रविवेश महद् वनम् ।\nहिमवन्तमगाद् राजा तपसे धृतमानसः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006400066, "chapter_id": 26400, "verse_number": "२-५७-६७", "content_sanskrit": "ततः स तप आस्थाय विनिर्मुच्य कलेवरम् ।\nआरुरोह दिवं राजा कर्मभिः स्वैर्जिताशुभैः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006400067, "chapter_id": 26400, "verse_number": "२-५७-६८", "content_sanskrit": "वासुदेवोऽपि धर्मात्मा उपायेन महामनाः ।\nघातयित्वाऽऽत्मनः शत्रुं तत्सैन्यं प्रत्यपद्यत ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006400068, "chapter_id": 26400, "verse_number": "२-५७-६९", "content_sanskrit": "प्रभूतरथहस्त्यश्ववर्मशस्त्रायुधध्वजम् ।\nआदायोपययौ धीमान्ससैन्यं निहतेश्वरम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006400069, "chapter_id": 26400, "verse_number": "२-५७-७०", "content_sanskrit": "निवेदयामास ततो नराधिपे तदुग्रसेने प्रतिपूर्णमानसः ।\nजनार्दनो द्वारवतीं च तां पुरीमशोभयत् तेन धनेन भूरिणा ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]