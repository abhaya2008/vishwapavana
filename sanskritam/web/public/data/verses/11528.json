[{"id": 50014219, "chapter_id": 11528, "verse_number": "1", "content_sanskrit": "राजोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50014220, "chapter_id": 11528, "verse_number": "2", "content_sanskrit": "मन्वन्तरेषु भगवान् यथा मन्वादयस्त्विमे। यस्मिन् कर्मणि ये येन नियुक्तास्तद्वदस्व मे॥ ८/१३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50014221, "chapter_id": 11528, "verse_number": "3", "content_sanskrit": "ऋषिरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50014222, "chapter_id": 11528, "verse_number": "4", "content_sanskrit": "मनवो मनुपुत्राश्च मुनयश्च महीपते। इन्द्राः सुरगणाश्चैव सर्वे पुरुषशासनाः॥ ८/१३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50014223, "chapter_id": 11528, "verse_number": "5", "content_sanskrit": "यज्ञादयो याः कथिताः पौरुष्यस्तनवो नृप। मन्वादयो जगद्यात्रां नयन्त्याभिः प्रचोदिताः॥ ८/१३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50014224, "chapter_id": 11528, "verse_number": "6", "content_sanskrit": "चतुर्युगान्ते कालेन ग्रस्ताञ्छ्रुतिगणान् यथा। तपसा ऋषयोऽपश्यन् यतो धर्मः सनातनः॥ ८/१३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50014225, "chapter_id": 11528, "verse_number": "7", "content_sanskrit": "ततो धर्मं चतुष्पादं मनवो हरिणोदिताः। युक्ताः सञ्चारयन्त्यद्धा स्वेस्वे काले महीनृपाः॥ ८/१३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50014226, "chapter_id": 11528, "verse_number": "8", "content_sanskrit": "पालयन्ति प्रजापाला यावदन्तं विभागशः। यज्ञभागभुजो देवा ये च तत्रानुकार्तिताः॥ ८/१३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50014227, "chapter_id": 11528, "verse_number": "9", "content_sanskrit": "इन्द्रो भगवता दत्तां त्रैलोक्यश्रियमूर्जिताम्। भुञ्जानः पाति लोकांस्त्रीन् कामं लोके प्रवर्षति॥ ८/१३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50014228, "chapter_id": 11528, "verse_number": "10", "content_sanskrit": "ज्ञानं चातुर्युगं ब्रूते हरिः सिद्धस्वरूपधृक्। ऋषिरूपधरः कर्म योगं योगेशरूपधृक्॥ ८/१३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50014229, "chapter_id": 11528, "verse_number": "11", "content_sanskrit": "सर्गं प्रजेशरूपेण दस्यून् हन्ति स्वराड्वपुः। कालरूपेण सर्वेषामभवाय पृथग्गुणः॥ ८/१३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50014230, "chapter_id": 11528, "verse_number": "12", "content_sanskrit": "स्तूयमानो जनैरेभिर्माययाऽनामरूपया। विमोहितात्मभिर्नानादर्शनैर्न च दृश्यते॥ ८/१३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50014231, "chapter_id": 11528, "verse_number": "13", "content_sanskrit": "एतत् कल्पविकल्पस्य प्रमाणं परिकार्तितम्। यत्र मन्वन्तराण्याहुश्चतुर्दश पुराविदः॥ ८/१३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50014232, "chapter_id": 11528, "verse_number": "14", "content_sanskrit": "इति श्रीमद्भागवते अष्टमस्कन्धे त्रयोदशोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]