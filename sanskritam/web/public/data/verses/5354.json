[{"id": 2204300, "chapter_id": 5354, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2204301, "chapter_id": 5354, "verse_number": "१", "content_sanskrit": "भगवन् देवदेवेश भूतपाल नमोस्तु ते ।\nह्रस्वाङ्गाश्चैव वक्राङ्गाः कुब्जा वामनकास्तथा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2204302, "chapter_id": 5354, "verse_number": "२", "content_sanskrit": "अपरे मानुषा देव दृश्यन्ते कुणिबाहवः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2204303, "chapter_id": 5354, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2204304, "chapter_id": 5354, "verse_number": "३", "content_sanskrit": "ये पुरा मनुजा देवि लोभमोहसमन्विताः ।\nधान्यमानान् विकुर्वन्ति क्रयविक्रयकारणात्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2204305, "chapter_id": 5354, "verse_number": "४", "content_sanskrit": "तुलादोषं तदा देवि धृतमानेषु नित्यशः ।\nअर्धापकर्षणं चैव सर्वेषां क्रयविक्रये\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2204306, "chapter_id": 5354, "verse_number": "५", "content_sanskrit": "अङ्गदोषकरा ये तु परेषां कोपकारणात् ।\nमांसादाश्चैव ये मूर्खा अयथावद् वृथा सदा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2204307, "chapter_id": 5354, "verse_number": "६", "content_sanskrit": "एवंयुक्तसमाचाराः पुनर्जन्मनि शोभने ।\nवामनाश्चैव ह्रस्वाङ्गा कुब्जाश्चैव भवन्ति ते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2204308, "chapter_id": 5354, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2204309, "chapter_id": 5354, "verse_number": "७", "content_sanskrit": "भगवन् मानुषाः केचिद् दृश्यन्ते मानुषेषु वै ।\nउन्मत्ताश्च पिशाचाश्च पर्यटन्तो यतस्ततः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2204310, "chapter_id": 5354, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2204311, "chapter_id": 5354, "verse_number": "८", "content_sanskrit": "ये पुरा मनुजा देवि दर्पाहङ्कारसंयुताः ।\nबहुधा प्रलपन्त्येव प्रहसन्ति परान् भृशम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2204312, "chapter_id": 5354, "verse_number": "९", "content_sanskrit": "मोहयन्ति परान् भोगैर्मदलैर्लोभकारणात् ।\nवृद्धान् गुरूंश्च ये मूर्खा वृथैवापहसन्ति च ।\nशौण्डा विदग्धाः शास्त्रेषु तथैवानृतवादिनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2204313, "chapter_id": 5354, "verse_number": "", "content_sanskrit": "एवंयुक्तसमाचाराः पुनर्जन्मनि शोभने ।\nउन्मत्ताश्च पिशाचाश्च भवन्त्येव न संशयः\t॥१०", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2204314, "chapter_id": 5354, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2204315, "chapter_id": 5354, "verse_number": "", "content_sanskrit": "भगवन् मानुषाः केचिन्निरपत्याः सुदुःखिताः ।\nयतन्तो न लभन्त्येव अपत्यानि यतस्ततः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t॥११", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2204316, "chapter_id": 5354, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2204317, "chapter_id": 5354, "verse_number": "१२", "content_sanskrit": "ये पुरा मनुजा देवि सर्वप्राणिषु निर्दयाः ।\nघ्नन्ति बालांश्च भुञ्जन्ते मृगाणां पक्षिणामपि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2204318, "chapter_id": 5354, "verse_number": "१३", "content_sanskrit": "गुरुविद्वेषिणश्चैव परपुत्राभ्यसूयकाः ।\nपितृपूजां न कुर्वन्ति यथोक्तं चाष्टकादिभिः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2204319, "chapter_id": 5354, "verse_number": "१४", "content_sanskrit": "एवंयुक्तसमाचाराः पुनर्जन्मनि शोभने ।\nमानुष्यं सुचिरात् प्राप्य निरपत्या भवन्ति ते ।\nपुत्रशोकयुता वापि नास्ति तत्र विचारणा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2204320, "chapter_id": 5354, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2204321, "chapter_id": 5354, "verse_number": "१५", "content_sanskrit": "भगवन् मानुषाः केचित् प्रदृश्यन्ते सुदुःखिताः ।\nउद्वेगवासनिरताः सोद्वेगाश्च यतव्रताः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2204322, "chapter_id": 5354, "verse_number": "", "content_sanskrit": "नित्यं शोकसमाविष्टा दुर्गताश्च तथैव च ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t॥१६", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2204323, "chapter_id": 5354, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2204324, "chapter_id": 5354, "verse_number": "१७", "content_sanskrit": "ये पुरा मनुजा नित्यमुत्कोचनपरायणाः ।\nभीषयन्ति परान् नित्यं विकुर्वन्ति तथैव च\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2204325, "chapter_id": 5354, "verse_number": "१८", "content_sanskrit": "ऋणैर्वृद्धिं च ये कृत्वा दरिद्रेभ्यो यथेष्टतः ।\nऋणार्थमभिगच्छन्ति सततं वृद्धिरूपकाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2204326, "chapter_id": 5354, "verse_number": "१९", "content_sanskrit": "उद्विजन्ते हि तान् दृष्ट्वा धारकाः स्वार्थकारणात् ।\nअतिवृद्धिर्न कर्तव्या दरिद्रेभ्यो यथेष्टतः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2204327, "chapter_id": 5354, "verse_number": "२०", "content_sanskrit": "ये श्वभिः क्रीडमानाश्च त्रासयन्ति वने मृगान् ।\nप्राणिहिंसां तथा देवि कुर्वन्ति च यतस्ततः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2204328, "chapter_id": 5354, "verse_number": "२१", "content_sanskrit": "येषां गृहेषु वै श्वानस्त्रासयन्ति वृथा नरान् ।\nएवंयुक्तसमाचाराः कालधर्मगताः पुनः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2204329, "chapter_id": 5354, "verse_number": "२२", "content_sanskrit": "पीडिता यमदण्डेन निरयस्थाश्चिरं प्रिये ।\nकथञ्चित् प्राप्य मानुष्यं तत्र ते दुःखसंयुताः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2204330, "chapter_id": 5354, "verse_number": "", "content_sanskrit": "कुदेशे दुःखभूयिष्ठे व्याघातशतसङ्कुले ।\nजायन्ते तत्र शोचन्तः सोद्वेगाश्च यतस्ततः\t॥२३", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2204331, "chapter_id": 5354, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2204332, "chapter_id": 5354, "verse_number": "", "content_sanskrit": "भगवन् मानुषाः केचिदैश्वर्यज्ञानसंयुताः ।\nम्लेच्छभूमिषु दृश्यन्ते म्लेच्छैश्वर्यसमन्विताः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t॥२४", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2204333, "chapter_id": 5354, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2204334, "chapter_id": 5354, "verse_number": "२५", "content_sanskrit": "ये पुरा मनुजा देवि धनधान्यसमन्विताः ।\nअयथावत् प्रयच्छन्ति श्रद्धावर्जितमेव वा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2204335, "chapter_id": 5354, "verse_number": "२६", "content_sanskrit": "अपात्रेभ्यश्च ये दानं शौचमङ्गलवर्जिताः ।\nददत्येव च ये मूर्खाः श्लाघयाऽवज्ञयाऽपि वा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2204336, "chapter_id": 5354, "verse_number": "", "content_sanskrit": "एवंयुक्तसमाचाराः पुनर्जन्मनि शोभने ।\nकुदेशे म्लेच्छभूयिष्ठे दुर्गमे वनसङ्कटे ।\nम्लेच्छाधिपत्यं सम्प्राप्य जायन्ते तत्रतत्र वै\t॥२७", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2204337, "chapter_id": 5354, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2204338, "chapter_id": 5354, "verse_number": "२८", "content_sanskrit": "भगवन् भगनेत्रघ्न मानुषेषु च केचन ।\nक्लीबा नपुंसकाश्चैव प्रदृश्यन्ते च षण्डकाः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2204339, "chapter_id": 5354, "verse_number": "", "content_sanskrit": "नीचकर्मरता नीचा नीचसौख्यास्तथा भुवि ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t॥२९", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2204340, "chapter_id": 5354, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2204341, "chapter_id": 5354, "verse_number": "३०", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु कल्याणि कारणम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2204342, "chapter_id": 5354, "verse_number": "३१", "content_sanskrit": "ये पुरा मनुजा भूत्वा घोरकर्मरतास्तथा ।\nपशुपुंस्त्वोपघातेन जीवन्ति च रमन्ति च\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2204343, "chapter_id": 5354, "verse_number": "३२", "content_sanskrit": "पुंस्त्वोपघातिनश्चैव नराणां कोपकारणात् ।\nये धूर्ताः स्त्रीषु गच्छन्ति अयथावद् यथेष्टतः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2204344, "chapter_id": 5354, "verse_number": "३३", "content_sanskrit": "कामविघ्नकरा ये तु द्वेषपैशुन्यकारणात् ।\nएवंयुक्तसमाचाराः पुनर्जन्मनि शोभने ।\nदण्डिता यमदण्डेन निरयस्थाश्चिरं प्रिये\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2204345, "chapter_id": 5354, "verse_number": "३४", "content_sanskrit": "यदि चेन्मानुषं जन्म लभेरंस्ते तथाविधाः ।\nक्लीबा वर्षवराश्चैव षण्डकाश्च भवन्ति ते\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2204346, "chapter_id": 5354, "verse_number": "३५", "content_sanskrit": "नीचकर्मपरा लोके निर्लज्जा वीतसम्भ्रमाः ।\nपरनिन्दां बहिष्कृत्य ते भवन्ति स्वकर्मणा\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2204347, "chapter_id": 5354, "verse_number": "३६", "content_sanskrit": "यदि चेत्संविमृश्येरन् ते मुच्यन्ते हि कल्मषात् ।\nअत्रापि ते प्रमाद्येयुः पतन्ति नरकालये\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2204348, "chapter_id": 5354, "verse_number": "३७", "content_sanskrit": "स्त्रीणामपि तथा देवि यथा पुंसां तु कर्मजम् ।\nइति ते कथितं देवि भूयः श्रोतुं किमिच्छसि\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2204349, "chapter_id": 5354, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nअनुशासनपर्वणि दानधर्मे उमामहेश्वरसंवादे रोगाणां निमित्तकथनं नाम पञ्चाधिकद्विशततमोऽध्यायः ॥२०५॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]