[{"id": 2054335, "chapter_id": 2193, "verse_number": "७-१२०-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2054336, "chapter_id": 2193, "verse_number": "७-१२०-१", "content_sanskrit": "जित्वा यवनकाम्भोजान्युयुधानस्ततोऽर्जुनम्।\nजगाम तव सैन्यस्य मध्येन रथिनां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2054337, "chapter_id": 2193, "verse_number": "७-१२०-२", "content_sanskrit": "शरदंष्ट्रो नरव्याघ्रो विचित्रकवचच्छविः।\nमृगं व्याघ्र इवाजिघ्रंस्तव सैन्यमभीषयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2054338, "chapter_id": 2193, "verse_number": "७-१२०-३", "content_sanskrit": "स रथेन चरन्मार्गान्धनुरुद्धामयद्भृशम्।\nरुक्मपृष्ठं महावेगं रुक्मचन्द्रकसङ्कुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2054339, "chapter_id": 2193, "verse_number": "७-१२०-४", "content_sanskrit": "रुक्माङ्गदशिरस्त्राणो रुक्मवर्मसमावृतः।\nरुक्मध्वजधनुः शूरो मेरुशृङ्गमिवाबभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2054340, "chapter_id": 2193, "verse_number": "७-१२०-५", "content_sanskrit": "सधनुर्मण्डलः सङ्ख्ये तेजोभासुररश्मिवान्।\nशरदीवोदितः सूर्यो नृसूर्यो विरराज ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2054341, "chapter_id": 2193, "verse_number": "७-१२०-६", "content_sanskrit": "वृषभस्कन्धविक्रान्तो वृषभाक्षो नरर्षभः।\nतावकानां बभौ मध्ये गवां मध्ये यथा वृषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2054342, "chapter_id": 2193, "verse_number": "७-१२०-७", "content_sanskrit": "मत्तद्विरदसङ्काशं मत्तद्विरदगामिनम्।\nप्रभिन्नमिव मातङ्गं यूथमध्ये व्यवस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2054343, "chapter_id": 2193, "verse_number": "७-१२०-८", "content_sanskrit": "व्याधा इव जिघांसन्तस्त्वदीयाः समुपाद्रवन्।\n`सात्यकिं समरे राजन्परिवव्रुस्तवात्मजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2054344, "chapter_id": 2193, "verse_number": "७-१२०-९", "content_sanskrit": "द्रोणानीकमतिक्रान्तं भोजानीकं च दुस्तरम्।\nजलसन्धार्णवं तीर्त्वा काम्भोजानां च वाहिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2054345, "chapter_id": 2193, "verse_number": "७-१२०-१०", "content_sanskrit": "हार्दिक्यमकरान्मुक्तं तीर्णं वै सैन्यसागरम्।\nपरिवव्रुः सुसङ्क्रुद्वास्त्वदीयाः सात्यकिं रथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2054346, "chapter_id": 2193, "verse_number": "७-१२०-११", "content_sanskrit": "दुर्योधनश्चित्रसेनो दुःशासनविविंशती।\nशकुनिर्दुःसहश्चैव युवा दुर्धर्षणः क्रथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2054347, "chapter_id": 2193, "verse_number": "७-१२०-१२", "content_sanskrit": "अन्ये च बहवः शूराः शस्त्रवन्तो दुरासदाः।\nपृष्ठतः सात्यकिं यान्तमन्वधावन्नमर्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2054348, "chapter_id": 2193, "verse_number": "७-१२०-१३", "content_sanskrit": "अथ शब्दो महानासीत्तव सैन्यस्य मारिष।\nमारुतोद्धूतवेगस्य सागरस्येव पर्वणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2054349, "chapter_id": 2193, "verse_number": "७-१२०-१४", "content_sanskrit": "तानभिद्रवतः सर्वान्समीक्ष्य शिनिपुङ्गवः।\nशनैर्याहीति यन्तारमब्रवीत्प्रहसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2054350, "chapter_id": 2193, "verse_number": "७-१२०-१५", "content_sanskrit": "इदमेति समुद्धूतं धार्तराष्ट्रबलं महत्।\nमामेवाभिमुखं तूर्णं गजाश्वरथपत्तिमत्।\nनादयद्वै दिशः सर्वा रथघोषेण सारथे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2054351, "chapter_id": 2193, "verse_number": "७-१२०-१६", "content_sanskrit": "पृथिवीं चान्तरिक्षं च कम्पयन्सागरानपि।\nएतद्बलार्णवं सूत वारयिष्ये महारणे।\nपौर्णमास्यामिवोद्धूतं वेलेव मकरालयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2054352, "chapter_id": 2193, "verse_number": "७-१२०-१७", "content_sanskrit": "पश्य मे सूत विक्रान्तमिन्द्रस्येव महामृधे।\nएष सैन्यानि शत्रूणां विधमामि शितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2054353, "chapter_id": 2193, "verse_number": "७-१२०-१८", "content_sanskrit": "निहतानाहवे पश्य पदात्यश्वरथद्विपान्।\nमच्छरैरग्निसङ्काशैर्विद्धदेहान्सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2054354, "chapter_id": 2193, "verse_number": "७-१२०-१९", "content_sanskrit": "इत्येवं ब्रुवतस्तस्य सात्यकेरमितौजसः।\nसमीपे सैनिकास्ते तु शीघ्रमीयुर्युयुत्सवः।\nजह्याद्रवस्व तिष्ठेति पश्यपश्येति वादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2054355, "chapter_id": 2193, "verse_number": "७-१२०-२०", "content_sanskrit": "तानेवं ब्रुवतो वीरान्सात्यकिर्निशितैः शरैः।\nजघानं त्रिशतानश्वान्कुञ्जरांश्च चतुःशतान्।\n`लध्वस्त्रश्चित्रयोधी च प्रहरञ्शिनिपुङ्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2054356, "chapter_id": 2193, "verse_number": "७-१२०-२१", "content_sanskrit": "स सम्प्रहारस्तुमुलस्तस्य तेषां च धन्विनाम्।\nदेवासुररणप्रख्यः प्रावर्तत जनक्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2054357, "chapter_id": 2193, "verse_number": "७-१२०-२२", "content_sanskrit": "मेघजालनिभं सैन्यं तव पुत्रस्य मारिष।\nप्रत्यगृह्णाच्छिनेः पौत्रः शरैराशीविषोपमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2054358, "chapter_id": 2193, "verse_number": "७-१२०-२३", "content_sanskrit": "प्रच्छाद्यमानः समरे शरजालैः स वीर्यवान्।\nअसम्भ्रमन्महाराज तावकानवधीद्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2054359, "chapter_id": 2193, "verse_number": "७-१२०-२४", "content_sanskrit": "आश्चर्यं तत्र राजेन्द्र सुमहद्दृष्टवानहम्।\nन मोघः सायकः कश्चित्सात्यकेरभवत्प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2054360, "chapter_id": 2193, "verse_number": "७-१२०-२५", "content_sanskrit": "रथनागाश्वकलिलः पदात्यूर्मिसमाकुलः।\nशैनेयवेलामासाद्य स्थितः सैन्यमहार्णवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2054361, "chapter_id": 2193, "verse_number": "७-१२०-२६", "content_sanskrit": "सम्भ्रान्तनरनागाश्वमावर्तत मुहुर्मुहुः।\nतत्सैन्यमिषुभिस्तेन वध्यमानं समन्ततः।\nबभ्राम तत्रतत्रैव गावः शीतार्दिता इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2054362, "chapter_id": 2193, "verse_number": "७-१२०-२७", "content_sanskrit": "पदातिनं रथं नागं सादिनं तुरगं तथा।\nअविद्वं तत्र नाद्राक्षं युयुधानस्य सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2054363, "chapter_id": 2193, "verse_number": "७-१२०-२८", "content_sanskrit": "न तादृक्कदनं राजन्कृतवांस्तत्र फल्गुनः।\nयादृक्क्षयमनीकानामकरोत्सात्यकिर्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2054364, "chapter_id": 2193, "verse_number": "७-१२०-२९", "content_sanskrit": "अत्यर्जुनं शिनेः पौत्रो युध्यते पुरुषर्षभः।\nवीतभीर्लाघवोपेतः कृतित्वं सम्प्रदर्शयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2054365, "chapter_id": 2193, "verse_number": "७-१२०-३०", "content_sanskrit": "ततो दुर्योधनो राजा सात्वतस्य त्रिभिः शरैः।\nविव्याध सूतं निशितैश्चतुर्भिश्चतुरो हयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2054366, "chapter_id": 2193, "verse_number": "७-१२०-३१", "content_sanskrit": "सात्यकिं च त्रिभिर्विद्व्वा पुनरष्टाभिरेव च।\nदुःशासनः षोडशभिर्विव्याध शिनिपुङ्गवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2054367, "chapter_id": 2193, "verse_number": "७-१२०-३२", "content_sanskrit": "शकुनिः पञ्चविंशत्या चित्रसेनश्च पञ्चभिः।\nदुःसहः पञ्चदशभिर्विव्याधोरसि सात्यकिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2054368, "chapter_id": 2193, "verse_number": "७-१२०-३३", "content_sanskrit": "उत्स्मयन्वृष्णिशार्दूलस्तथा बाणैः समाहतः।\nतानविध्यन्महाराज सर्वानेव त्रिभिस्त्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2054369, "chapter_id": 2193, "verse_number": "७-१२०-३४", "content_sanskrit": "गाढविद्धानरीन्कृत्वा मार्गणैः सोऽतितेजनैः।\nशैनेयः श्येनवत्सङ्ख्ये व्यचरल्लघुविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2054370, "chapter_id": 2193, "verse_number": "७-१२०-३५", "content_sanskrit": "सौबलस्य धनुश्छित्त्वा हस्तावापं निकृत्य च।\nदुर्योधनं त्रिभिर्बाणैरभ्यविध्यत्स्तनान्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2054371, "chapter_id": 2193, "verse_number": "७-१२०-३६", "content_sanskrit": "चित्रसेनं शतेनैव दशभिर्दुःसहं तथा।\nदुःशासनं तु विंशत्या विव्याध शिनिपुङ्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2054372, "chapter_id": 2193, "verse_number": "७-१२०-३७", "content_sanskrit": "अथान्यद्धनुरादाय श्यालस्तव विशाम्पते।\nअष्टाभिः सात्यकिं विद्व्वा पुनर्विव्याध पञ्चभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2054373, "chapter_id": 2193, "verse_number": "७-१२०-३८", "content_sanskrit": "दुःशासनश्च दशभिर्दुःसहश्च त्रिभिः शरैः।\nदुर्मुखश्च द्वादशभी राजन्विव्याध सात्यकिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2054374, "chapter_id": 2193, "verse_number": "७-१२०-३९", "content_sanskrit": "दुर्योधनस्त्रिसप्तत्या किद्व्वा भारत माधवम्।\nततोस्य निशितैर्बाणैस्त्रिभिर्विव्याध सारथिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2054375, "chapter_id": 2193, "verse_number": "७-१२०-४०", "content_sanskrit": "तान्सर्वान्सहिताञ्शूरान्यतमानान्महारथान्।\nपञ्चभिः पञ्चभिर्बाणैः पुनर्विव्याध सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2054376, "chapter_id": 2193, "verse_number": "७-१२०-४१", "content_sanskrit": "ततः स रथिनां श्रेष्ठस्तव पुत्रस्य सारथिम्।\nआजघानाशु भल्लेन स हतो न्यपतद्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2054377, "chapter_id": 2193, "verse_number": "७-१२०-४२", "content_sanskrit": "पतिते सारथौ तस्मिंस्तव पुत्ररथः प्रभो।\nवातायमानैस्तैरश्वैरपानीयत सङ्गरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2054378, "chapter_id": 2193, "verse_number": "७-१२०-४३", "content_sanskrit": "ततस्तव सुतो राजन्सैनिकाश्च विशाम्पते।\nराज्ञो रथमभिप्रेक्ष्य विद्रुताः शतशोऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2054379, "chapter_id": 2193, "verse_number": "७-१२०-४४", "content_sanskrit": "विद्रुतं तत्र तत्सैन्यं दृष्ट्वा भारत सात्यकिः।\nअवाकिरच्छरैस्तीक्ष्णै रुक्मपुङ्खैः शिलाशितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2054380, "chapter_id": 2193, "verse_number": "७-१२०-४५", "content_sanskrit": "विद्राव्य सर्वसैन्यानि तावकानि सहस्रशः।\nप्रययौ सात्यकी राजञ्श्वेताश्वस्य रथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2054381, "chapter_id": 2193, "verse_number": "७-१२०-४६", "content_sanskrit": "`तं प्रयान्तं महाबाहुं तावकाः प्रेक्ष्य मारिष।\nदृष्टं चादृष्टवत्कृत्वा क्रियामन्यामयोजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2054382, "chapter_id": 2193, "verse_number": "७-१२०-४७", "content_sanskrit": "तं शरानाददानं च रक्षमाणं च सारथिम्।\nआत्मानं पालयानं च तावकाः समपूजयन्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2054383, "chapter_id": 2193, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे विंशत्यधिकशततमोऽध्यायः॥ १२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]