[{"id": 7000726000, "chapter_id": 20726, "verse_number": "६-६९-१", "content_sanskrit": "नारद उवाच ।\nउपवासासमर्थानां सदैवामरसत्तम ।\nएका या द्वादशी पुण्या तां वदस्व ममानघ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000726001, "chapter_id": 20726, "verse_number": "६-६९-२", "content_sanskrit": "शिव उवाच ।\nमासि भाद्रपदे शुक्ले द्वादशी श्रवणान्विता ।\nसा वै सर्वप्रदा पुण्या ह्युपवासे महाफला॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000726002, "chapter_id": 20726, "verse_number": "६-६९-३", "content_sanskrit": "संगमे सरितः स्नात्वा द्वादशीं तामुपोषितः ।\nअयत्नात्समवाप्नोति द्वादश द्वादशीफलम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000726003, "chapter_id": 20726, "verse_number": "६-६९-४", "content_sanskrit": "बुधश्रवणसंयुक्ता या च वै द्वादशी भवेत् ।\nअतीव महती तस्यां कृतं सर्वमथाक्षयम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000726004, "chapter_id": 20726, "verse_number": "६-६९-५", "content_sanskrit": "द्वादशी श्रवणोपेता यदा भवति नारद ।\nसंगमे सरितां स्नात्वा लभेद्गोदानजं फलम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000726005, "chapter_id": 20726, "verse_number": "६-६९-६", "content_sanskrit": "जलपूर्णं तदा कुंभं स्थापयित्वा विचक्षणः ।\nतस्योपरि न्यसेत्पात्रं स्थापयित्वा जनार्दनम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000726006, "chapter_id": 20726, "verse_number": "६-६९-७", "content_sanskrit": "ततस्तस्याग्रतो देयं नैवेद्यं घृतपाचितम् ।\nसोदकांश्च नवान्कुंभान्दद्याच्छक्त्या विचक्षणः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000726007, "chapter_id": 20726, "verse_number": "६-६९-८", "content_sanskrit": "एवं संपूज्य गोविंदं जागरं तत्र कारयेत् ।\nप्रभाते विमले स्नात्वा संपूज्य गरुडध्वजम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000726008, "chapter_id": 20726, "verse_number": "६-६९-९", "content_sanskrit": "पुष्पधूपादि नैवेद्यैः फलैर्वस्त्रैः सुशोभनैः ।\nपुष्पांजलिं ततो दद्यान्मंत्रमेनमुदीरयेत्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000726009, "chapter_id": 20726, "verse_number": "६-६९-१०", "content_sanskrit": "नमो नमस्ते गोविंद बुधश्रवणसंयुत ।\nअघौघसंक्षयं कृत्वा सर्वसौख्यप्रदो भव॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000726010, "chapter_id": 20726, "verse_number": "६-६९-११", "content_sanskrit": "अन्नं तु ब्राह्मणे पूतं वेदवेदांगपारगे ।\nपुराणज्ञे विशेषेण विधिवत्संप्रदापयेत्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000726011, "chapter_id": 20726, "verse_number": "६-६९-१२", "content_sanskrit": "अनेन विधिना चैव नद्यास्तीरे नरोत्तमः ।\nसर्वं निर्वर्त्तयेत्सम्यगेकचित्तरतोऽपि सन्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000726012, "chapter_id": 20726, "verse_number": "६-६९-१३", "content_sanskrit": "अत्राप्युदाहरंतीममितिहासं पुरातनम् ।\nमहत्यरण्ये यद्वृतं भूमिदेव शृणुष्व तत्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000726013, "chapter_id": 20726, "verse_number": "६-६९-१४", "content_sanskrit": "यं श्रुत्वा मानवो लोके महादुःखात्प्रमुच्यते ।\nदेशो दासरको नाम तस्य भागे च पश्चिमे॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000726014, "chapter_id": 20726, "verse_number": "६-६९-१५", "content_sanskrit": "तत्र विद्वन्मरुर्देशः सर्वसत्वभयंकरः ।\nसुतप्तसिकता भूमिर्यत्र दुष्टा महोरगाः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000726015, "chapter_id": 20726, "verse_number": "६-६९-१६", "content_sanskrit": "अल्पच्छायाद्रुमाकीर्णा मृतप्राणिसमाकुला ।\nशमीखदिरपालाशकरीरैः पीलुभिः सह॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000726016, "chapter_id": 20726, "verse_number": "६-६९-१७", "content_sanskrit": "तत्र भीमा द्रुमगणाः कंटकैरचिता दृढैः ।\nजग्धप्राणजनाकीर्णा यत्र भूर्दृश्यते क्वचित्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000726017, "chapter_id": 20726, "verse_number": "६-६९-१८", "content_sanskrit": "तथापि जीवा जीवंति सर्वे कर्मनिबंधनात् ।\nनोदकं नोदकाधारा विद्वंस्तत्र बलाहकाः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000726018, "chapter_id": 20726, "verse_number": "६-६९-१९", "content_sanskrit": "पक्षांतरगतैः कैश्चिच्छिशुभिस्तृषितैः समम् ।\nउत्क्रांतजीविनो विप्र दृश्यंते नु खगोत्तमाः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000726019, "chapter_id": 20726, "verse_number": "६-६९-२०", "content_sanskrit": "तस्मिंस्तथाविधे देशे कश्चिद्दैववशाद्वणिक् ।\nनिजसार्थपरिभ्रष्टः प्रविष्टो मरुजांगले॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000726020, "chapter_id": 20726, "verse_number": "६-६९-२१", "content_sanskrit": "बभ्रामोद्भ्रांतहृदयः क्षुत्तृट्भ्यां श्रमपीडितः ।\nक्व ग्रामः क्व जलं क्वाहं यास्यामि न बुबोध ह॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000726021, "chapter_id": 20726, "verse_number": "६-६९-२२", "content_sanskrit": "अथ प्रेतान्ददर्शासौ क्षुत्तृषाव्याकुलेंद्रियान् ।\nउत्कटान्खलिनो भीमान्निर्मांसान्रौद्रदर्शनान्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000726022, "chapter_id": 20726, "verse_number": "६-६९-२३", "content_sanskrit": "प्रेतस्कंधसमारूढमेकं विकृतदर्शनम् ।\nददर्श बहुभिः प्रेतैः समंतात्परिवारितम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000726023, "chapter_id": 20726, "verse_number": "६-६९-२४", "content_sanskrit": "अगच्छमानमत्युग्रं प्रेतशब्दपुरःसरम् ।\nप्रेतोऽपि दृष्ट्वा तां घोरामटवीमागतं नरम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000726024, "chapter_id": 20726, "verse_number": "६-६९-२५", "content_sanskrit": "प्रेतस्कंधान्महीं गत्वा तस्यांतिकमुपागमत् ।\nप्रणिपत्य वणिक्श्रेष्ठमिदं वचनमब्रवीत्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000726025, "chapter_id": 20726, "verse_number": "६-६९-२६", "content_sanskrit": "अस्मिन्घोरतरे देशे प्रवेशो भवतः कथम् ।\nतमुवाच वणिक्धीमान्सार्थभ्रष्टस्य मे वने॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000726026, "chapter_id": 20726, "verse_number": "६-६९-२७", "content_sanskrit": "प्रवेशो दैवयोगेन पूर्वकर्मकृतेन च ।\nतृषा मे बाधतेऽत्यर्थं क्षुधा चैव भृशं तथा॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000726027, "chapter_id": 20726, "verse_number": "६-६९-२८", "content_sanskrit": "प्राणांतिकमनुप्राप्तं वचनं भ्रमतीव मे ।\nअत्रोपायं न पश्यामि जीवेयं येन केनचित्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000726028, "chapter_id": 20726, "verse_number": "६-६९-२९", "content_sanskrit": "इत्येवमुक्ते प्रेतस्तं वणिजं वाक्यमब्रवीत् ।\nफुल्लां शमीं समाश्रित्य प्रतीक्ष त्वं मुहूर्त्तकम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000726029, "chapter_id": 20726, "verse_number": "६-६९-३०", "content_sanskrit": "कृतातिथ्यो मया पश्चाद्गमिष्यसि यथासुखम् ।\nएवमुक्तस्तथा चक्रे स वणिक्तृष्णयार्दितः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000726030, "chapter_id": 20726, "verse_number": "६-६९-३१", "content_sanskrit": "मध्याह्नसमये प्राप्ते प्रेतस्तं देशमागतः ।\nफुल्लां सवृक्षां शीतोदां वारिधानीं मनोरमाम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000726031, "chapter_id": 20726, "verse_number": "६-६९-३२", "content_sanskrit": "दध्योदनसमायुक्तां वर्द्धमानेन संयुताम् ।\nअवतीर्य ततः स्वन्नं प्रादादतिथये तदा॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000726032, "chapter_id": 20726, "verse_number": "६-६९-३३", "content_sanskrit": "स तत्राशनमात्रेण परं तृप्तित्वमागतः ।\nवितृष्णो विज्वरश्चैव क्षणेन समपद्यत॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000726033, "chapter_id": 20726, "verse_number": "६-६९-३४", "content_sanskrit": "ततश्च प्रेताः संप्राप्ताः सोऽस्माद्भागं क्रमाद्ददौ ।\nदध्योदनात्सपानीयात्प्रेतास्तृप्तिं परां गताः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000726034, "chapter_id": 20726, "verse_number": "६-६९-३५", "content_sanskrit": "अतिथिं तर्पयित्वा तु प्रेतलोकं च सर्वतः ।\nततः स्वयं स बुभुजे भुक्तशेषं यथासुखम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000726035, "chapter_id": 20726, "verse_number": "६-६९-३६", "content_sanskrit": "तस्य भुक्तवतः स्वन्नं पानीयं च क्षयं ययौ ।\nप्रेताधिपं ततस्तं वै वणिग्वचनमब्रवीत्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000726036, "chapter_id": 20726, "verse_number": "६-६९-३७", "content_sanskrit": "आश्चर्यमेतत्परमं वनेऽस्मिन्प्रतिभाति मे ।\nअन्नं पानं च परमं संप्राप्तं च कुतस्तव॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000726037, "chapter_id": 20726, "verse_number": "६-६९-३८", "content_sanskrit": "स्वल्पेनैव तथान्नेन त्वमेतांस्तु बहूनपि ।\nअतर्पयः कथं त्वेते निर्मांसा भिन्नकुक्षयः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000726038, "chapter_id": 20726, "verse_number": "६-६९-३९", "content_sanskrit": "कथमस्यां सुघोरायामटव्यां च कृतालयाः ।\nतदेतत्संशयं छिंधि परं कौतूहलं मम॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000726039, "chapter_id": 20726, "verse_number": "६-६९-४०", "content_sanskrit": "एवमुक्तः स वणिजा प्रेतो वचनमब्रवीत् ।\nवाणिज्यसक्तस्य पुरा जन्मातीते ममानघ॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000726040, "chapter_id": 20726, "verse_number": "६-६९-४१", "content_sanskrit": "सकले नगरे नास्ति ममान्यो हि दुरात्मकः ।\nधनलोभान्न कस्यापि दत्ता भिक्षा मया तदा॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000726041, "chapter_id": 20726, "verse_number": "६-६९-४२", "content_sanskrit": "सखा चैव ततश्चासीद्ब्राह्मणो गुणवान्मम ।\nश्रावणद्वादशीयोगे मासि भाद्रपदे ततः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000726042, "chapter_id": 20726, "verse_number": "६-६९-४३", "content_sanskrit": "स कदाचिन्मया सार्द्धं तापीं नाम नदीं ययौ ।\nतस्याश्च संगमः पुण्यो यत्रासीच्चंद्रभागया॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000726043, "chapter_id": 20726, "verse_number": "६-६९-४४", "content_sanskrit": "चंद्रभागा चंद्रसुता तापी चैवार्कनंदिनी ।\nतयोः शीतोष्णसलिले प्रविवेश स ह द्विजः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000726044, "chapter_id": 20726, "verse_number": "६-६९-४५", "content_sanskrit": "श्रवणद्वादशीयोगे नराश्च समुपोषिताः ।\nचंद्रभागा सुतो येन वारिधानीं ददुर्द्विजे॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000726045, "chapter_id": 20726, "verse_number": "६-६९-४६", "content_sanskrit": "दध्योदनयुतां सार्द्धं संपूर्णैर्वर्द्धमानकैः ।\nछत्रोपानद्युगं वस्त्रं प्रतिमां च तथा हरेः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000726046, "chapter_id": 20726, "verse_number": "६-६९-४७", "content_sanskrit": "प्रददौ विप्रमुख्येभ्यो हरस्याग्रे महामते ।\nवित्तसंरक्षणार्थाय तस्यास्तीरे व्रते मया॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000726047, "chapter_id": 20726, "verse_number": "६-६९-४८", "content_sanskrit": "सोपवासेन दत्तैका वारिधानी मनोरमा ।\nतत्कृत्वाहं गृहं प्राप्तः ततः कालेन केनचित्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000726048, "chapter_id": 20726, "verse_number": "६-६९-४९", "content_sanskrit": "पंचत्त्वमहमासाद्य नास्तिक्यात्प्रेततां गतः ।\nअस्यामटव्यां घोरायां यथा ह्यहिकुलं तथा॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000726049, "chapter_id": 20726, "verse_number": "६-६९-५०", "content_sanskrit": "श्रवणद्वादशीयोगे वारिधान्यर्पिता मया ।\nसेयं मध्याह्नसमये लभ्यते च दिनेदिने॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000726050, "chapter_id": 20726, "verse_number": "६-६९-५१", "content_sanskrit": "ब्रह्मस्वरूपिणः सर्वे पापाः प्रेतत्वमागताः ।\nपरदारगताः केचित्स्वामिद्रोहरताश्च ये॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000726051, "chapter_id": 20726, "verse_number": "६-६९-५२", "content_sanskrit": "भूतप्रेतजरूपेण ते जाता ह्यत्र मानवाः ।\nदेशे मरुस्थले त्वस्मिन्ममैते मित्रतां गताः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000726052, "chapter_id": 20726, "verse_number": "६-६९-५३", "content_sanskrit": "अक्षयो भगवान्विष्णुः परमात्मा सनातनः ।\nदीयते यत्समुद्दिश्य ह्यक्षयं तत्प्रकीर्तनम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000726053, "chapter_id": 20726, "verse_number": "६-६९-५४", "content_sanskrit": "अक्षयेनापि चान्नेन तृप्ता एते पुनः पुनः ।\nप्रेतत्वभावं दौर्बल्यं न विमुंचति कर्हिचित्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000726054, "chapter_id": 20726, "verse_number": "६-६९-५५", "content_sanskrit": "पूजयित्वाहमन्नैस्त्वामतिथिं समुपस्थितम् ।\nप्रेतभावाद्विनिर्मुक्तो यास्यामि परमां गतिम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000726055, "chapter_id": 20726, "verse_number": "६-६९-५६", "content_sanskrit": "मया विहीनाः किंत्वेते वनेऽस्मिन्भृशदारुणे ।\nपीडामनुभविष्यंति दारुणां कर्मयोनिजाम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000726056, "chapter_id": 20726, "verse_number": "६-६९-५७", "content_sanskrit": "एतेषां तु महाभाग ममानुग्रहकाम्यया ।\nप्रत्येकं नामगोत्राणि गृह्णीष्व लिखितानि च॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000726057, "chapter_id": 20726, "verse_number": "६-६९-५८", "content_sanskrit": "अस्ति कक्षागता चैव तव संपुटिका शुभा ।\nहिमवंतमथासाद्य तत्र त्वं लप्स्यसे निधिम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000726058, "chapter_id": 20726, "verse_number": "६-६९-५९", "content_sanskrit": "गयाशीर्षं ततो गत्वा श्राद्धं कुरु महामते ।\nइत्याज्ञाप्य स वै प्रेतो वणिजं च यथासुखम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000726059, "chapter_id": 20726, "verse_number": "६-६९-६०", "content_sanskrit": "विसर्जयामास तदा स वै प्रायात्समुत्सुकः ।\nसमासाद्य गृहं तत्र पश्चात्प्रायाद्धिमालयम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000726060, "chapter_id": 20726, "verse_number": "६-६९-६१", "content_sanskrit": "ततो दृष्टं निधिं तत्र गृहीत्वा स समागतः ।\nषष्ठांशं प्रतिगृह्याथ गयाशीर्षं ततोऽभ्यगात्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000726061, "chapter_id": 20726, "verse_number": "६-६९-६२", "content_sanskrit": "तत्र गत्वा गयायां स श्राद्धं कृत्वा महामतिः ।\nप्रेतानां तु यथोद्दिष्टं श्राद्धं सम्यग्विधानतः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000726062, "chapter_id": 20726, "verse_number": "६-६९-६३", "content_sanskrit": "प्रत्येकं नामगोत्राणि गृहीत्वा पिंडमुत्सृजत् ।\nयस्य यस्य भवेच्छ्राद्धं स करोति दिने वणिक्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000726063, "chapter_id": 20726, "verse_number": "६-६९-६४", "content_sanskrit": "स स तस्य तदा स्वप्ने दर्शयत्यात्मनस्तनुम् ।\nब्रवीति च महाभाग प्रसादाद्भवतोऽनघ॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000726064, "chapter_id": 20726, "verse_number": "६-६९-६५", "content_sanskrit": "प्रेतभावं मया त्यक्तं प्राप्तोऽस्मि परमां गतिम् ।\nएवं कृत्वा विधानेन गयाशीर्षं महामनाः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000726065, "chapter_id": 20726, "verse_number": "६-६९-६६", "content_sanskrit": "पश्चाज्जगाम स्वगृहं विष्णुं ध्यायन्पुनः पुनः ।\nमासि भाद्रपदे प्राप्ते शुक्लपक्षे तथा सुधीः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000726066, "chapter_id": 20726, "verse_number": "६-६९-६७", "content_sanskrit": "श्रवणद्वादशीयोगे संगमे सरितां पुनः ।\nजगाम स महाबुद्धिः सर्वोपस्करसंयुतः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000726067, "chapter_id": 20726, "verse_number": "६-६९-६८", "content_sanskrit": "संगमे सरितां स्नात्वा द्वादशीं तामुपोषितः ।\nतत्र स्नात्वापि दत्त्वा तु पूजयित्वा जनार्दनम्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000726068, "chapter_id": 20726, "verse_number": "६-६९-६९", "content_sanskrit": "अनंतरं ब्राह्मणस्य ह्युपहारांस्तदा ददौ ।\nशास्त्रोक्तेनापि विधिना ह्येकचित्तरतोऽपि सः॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000726069, "chapter_id": 20726, "verse_number": "६-६९-७०", "content_sanskrit": "निवर्त्तयामास तदा वणिजो बुद्धिमान्स वै ।\nवर्षेवर्षे तु संप्राप्ते मासि भाद्रपदे तथा॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000726070, "chapter_id": 20726, "verse_number": "६-६९-७१", "content_sanskrit": "श्रवणद्वादशीयोगे संगमे सरितां पुनः ।\nएवं वै कृतवान्सर्वं विष्णुमुद्दिश्य सत्वरम्॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000726071, "chapter_id": 20726, "verse_number": "६-६९-७२", "content_sanskrit": "कालेन चातिमहता पंचत्वं समुपागतः ।\nअवाप परमं स्थानं दुर्लभं सर्वमानवैः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000726072, "chapter_id": 20726, "verse_number": "६-६९-७३", "content_sanskrit": "क्रीडतेऽद्यापि वैकुंठे विष्णुदूतैः स सेवितः ।\nएवं कुरु त्वं भो ब्रह्मन्श्रवणद्वादशीव्रतम्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000726073, "chapter_id": 20726, "verse_number": "६-६९-७४", "content_sanskrit": "सर्वसौभाग्यदं चैव इह लोके परत्र च ।\nसुबुद्धिजननं चैव सर्वपापहरं परम्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000726074, "chapter_id": 20726, "verse_number": "६-६९-७५", "content_sanskrit": "श्रवणद्वादशीयोगे यः कुर्याद्व्रतमीदृशम् ।\nव्रतस्यास्य प्रभावेन विष्णुलोकं च गच्छति॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]