[{"id": 50014273, "chapter_id": 11530, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50014274, "chapter_id": 11530, "verse_number": "2", "content_sanskrit": "एवं पुत्रेषु नष्टेषु देवमाताऽदितिस्तदा। हृते त्रिविष्टपे दैत्यैः पर्यतप्यदनाथवत्॥ ८/१५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50014275, "chapter_id": 11530, "verse_number": "3", "content_sanskrit": "एकदा कश्यपस्तस्या आश्रमं भगवानगात्। निरुत्सवं निरानन्दं समाधेर्विरतश्चिरात्॥ ८/१५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50014276, "chapter_id": 11530, "verse_number": "4", "content_sanskrit": "स पत्नीं दीनवदनां कृतासनपरिग्रहः। सभाजितो यथान्यायमिदमाह कुरूद्वह॥ ८/१५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50014277, "chapter_id": 11530, "verse_number": "5", "content_sanskrit": "अप्यभद्रं न विप्राणां भद्रे लोकेऽधुनाऽऽगतम्। न धर्मस्य न लोकस्य मृत्योश्छन्दानुवर्तिनः॥ ८/१५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50014278, "chapter_id": 11530, "verse_number": "6", "content_sanskrit": "अपि वाऽकुशलं किञ्चिद् गृहेषु गृहमेधिनि। धर्मस्यार्थस्य कामस्य यत्र योगो ह्ययोगिनाम्॥ ८/१५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50014279, "chapter_id": 11530, "verse_number": "7", "content_sanskrit": "अपि वाऽतिथयोऽभ्येत्य कुडुम्बासक्तया त्वया। गृहादपूजिता याताः प्रत्युत्थानेन वा क्वचित्॥ ८/१५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50014280, "chapter_id": 11530, "verse_number": "8", "content_sanskrit": "गृहेषु येष्वतिथयो नार्चिताः सलिलैरपि। यदि निर्यान्ति ते नूनं प्रेतराजगृहोपमाः॥ ८/१५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50014281, "chapter_id": 11530, "verse_number": "9", "content_sanskrit": "अथाग्नयस्तु वेळायां न हुता हविषा सति। त्वयोद्विग्नधिया भद्रे प्रोषिते मयि कर्हिचित्॥ ८/१५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50014282, "chapter_id": 11530, "verse_number": "10", "content_sanskrit": "यत्पूजया कामदुघान् यान्ति लोकान् गृहान्विताः। ब्राह्मणोऽग्निश्च वै विष्णोः सर्वदेवात्मनो मुखम्॥ ८/१५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50014283, "chapter_id": 11530, "verse_number": "11", "content_sanskrit": "अपि सर्वे कुशलिनस्तव पुत्रा मनस्विनि। लक्षयेऽस्वस्थमात्मानं भवत्या लक्षणैरहम्॥ ८/१५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50014284, "chapter_id": 11530, "verse_number": "12", "content_sanskrit": "अदितिरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50014285, "chapter_id": 11530, "verse_number": "13", "content_sanskrit": "भद्रं द्विजगवां ब्रह्मन् धर्मस्यास्य जनस्य च। त्रिवर्गस्य परं क्षेत्रं गृहमेधिन् गृहा इमे॥ ८/१५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50014286, "chapter_id": 11530, "verse_number": "14", "content_sanskrit": "अग्नयोऽतिथयो भृत्या भिक्षवो ये च लिप्सवः। सर्वं भगवतो ब्रह्मन्ननुध्यानान्न रिष्यति॥ ८/१५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50014287, "chapter_id": 11530, "verse_number": "15", "content_sanskrit": "को नु मे भगवन् कामो न सम्पद्येत मानसः। यस्या भवान् प्रजाध्यक्ष एवं धर्मान् प्रभाषते॥ ८/१५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50014288, "chapter_id": 11530, "verse_number": "16", "content_sanskrit": "तवैव मारीच मनःशरीरजाः प्रजा इमाः सत्वरजस्तमोजुषः। मनोरथं तासु सुरादिषु प्रभो यथाविभागं भजते महेश्वरः॥ ८/१५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50014289, "chapter_id": 11530, "verse_number": "17", "content_sanskrit": "तस्मादंशं भजन्त्या मे श्रेयश्चिन्तय सुव्रत। हृतश्रियो हृतस्थानान् सपत्नौः पाहि नः प्रभो॥ ८/१५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50014290, "chapter_id": 11530, "verse_number": "18", "content_sanskrit": "परैर्विवासिता साऽहं मग्ना व्यसनसागरे। ऐश्वर्यं श्रीर्यशः स्थानं हृतानि प्रबलैर्मम॥ ८/१५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50014291, "chapter_id": 11530, "verse_number": "19", "content_sanskrit": "यथा तानि पुनः साधो प्रपद्येरन् ममात्मजाः। तथा विधेहि कल्याणं धिया कल्याणकृत्तम॥ ८/१५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50014292, "chapter_id": 11530, "verse_number": "20", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50014293, "chapter_id": 11530, "verse_number": "21", "content_sanskrit": "एवमभ्यर्थितोऽदित्या मुनिराह स्मयन्निव। अहो मायामयं विष्णोः स्नेहबन्धमिदं जगत्॥ ८/१५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50014294, "chapter_id": 11530, "verse_number": "22", "content_sanskrit": "क्व देहो भौतिकोऽनात्मा क्व चात्मा प्रकृतेः परः। कस्य के पतिपुत्राद्या मोह एव हि कारणम्॥ ८/१५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50014295, "chapter_id": 11530, "verse_number": "23", "content_sanskrit": "उपतिष्ठस्व पुरुषं भगवन्तं जनार्दनम्। सर्वभूतगुहावासं वासुदेवं जगद्गुरुम्॥ ८/१५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50014296, "chapter_id": 11530, "verse_number": "24", "content_sanskrit": "स विधास्यति ते कामान् हरिर्दीनानुकम्पनः। अमोघा भगवत्सेवा नेतरेति१ मतिर्मम॥ ८/१५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50014297, "chapter_id": 11530, "verse_number": "25", "content_sanskrit": "अदितिरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50014298, "chapter_id": 11530, "verse_number": "26", "content_sanskrit": "केनाहं विधिना ब्रह्मन्नुपस्थास्ये जगत्पतिम्। यथा मे सत्यसङ्कल्पो विदध्यात् स मनोरथम्॥ ८/१५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50014299, "chapter_id": 11530, "verse_number": "27", "content_sanskrit": "आदिश त्वं द्विजश्रेष्ठ विधिं तदुपधावनम्। आशु तुष्यति मे देवः सीदन्त्याः सह पुत्रकैः॥ ८/१५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50014300, "chapter_id": 11530, "verse_number": "28", "content_sanskrit": "कश्यप उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50014301, "chapter_id": 11530, "verse_number": "29", "content_sanskrit": "एतन्मे भगवन् पृष्टः प्रजाकामस्य पदम्जः। यदाह ते प्रवक्ष्यामि व्रतं केशवतोषणम्॥ ८/१५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50014302, "chapter_id": 11530, "verse_number": "30", "content_sanskrit": "फाल्गुनस्यामले पक्षे द्वादशाहं पयोव्रतः। अर्चयेदरविन्दाक्षं भक्त्या परमयाऽन्वितः॥ ८/१५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50014303, "chapter_id": 11530, "verse_number": "31", "content_sanskrit": "सिनीवाल्यां मृदाऽऽलिप्य स्नायात् क्रोडविदीर्णया। यदि लभ्येत वै स्रोत एतं मन्त्रमुदीरयेत्॥ ८/१५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50014304, "chapter_id": 11530, "verse_number": "32", "content_sanskrit": "त्वं देव्यादिवराहेण रसायाः स्थानमिच्छता। उद्धृताऽसि नमस्तुभ्यं पाप्मानं मे प्रणाशय॥ ८/१५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50014305, "chapter_id": 11530, "verse_number": "33", "content_sanskrit": "निर्वर्तितात्मनियमो देवमर्चेत् समाहितः। अर्चायां स्थण्डिले सूर्ये जले वह्नौ गुरावपि॥ ८/१५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50014306, "chapter_id": 11530, "verse_number": "34", "content_sanskrit": "नमस्तुभ्यं भगवते पुरुषाय महीयसे। सर्वभूतनिवासाय वासुदेवाय साक्षिणे॥ ८/१५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50014307, "chapter_id": 11530, "verse_number": "35", "content_sanskrit": "नमोऽव्यक्ताय सूक्ष्माय प्रधानपुरुषाय च। चतुर्विंशगणज्ञाय गुणसंस्थानहेतवे॥ ८/१५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50014308, "chapter_id": 11530, "verse_number": "36", "content_sanskrit": "नमो द्विशीर्षे त्रिपदे चतुःशृङ्गाय तन्तवे। सप्तहस्ताय यज्ञाय त्रयीविद्यात्मने नमः॥ ८/१५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50014309, "chapter_id": 11530, "verse_number": "37", "content_sanskrit": "नमः शिवाय रुद्राय नमस्ते योगहेतवे\\patha{सार्धश्लोकोऽयं प्राचीनकोशेषु नास्ति - इति पूर्णप्रज्ञविद्यापीठस्य संशोधकः शेषगिरि आचार्यः।। सर्वविद्याधिपतये भूतानां पतये नमः॥ ८/१५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50014310, "chapter_id": 11530, "verse_number": "38", "content_sanskrit": "नमो हिरण्यगर्भाय प्राणाय जगदात्मने। योगैश्वर्यशरीराय नमस्ते योगहेतवे॥ ८/१५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50014311, "chapter_id": 11530, "verse_number": "39", "content_sanskrit": "नमस्त आदिदेवाय देवदेवाय ते नमः। नारायणाय ऋषये नराय हरये नमः॥ ८/१५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50014312, "chapter_id": 11530, "verse_number": "40", "content_sanskrit": "नमो मरतकश्यामवपुषेऽधिगतश्रिये। केशवाय नमस्तुभ्यं नमस्ते पीतवाससे॥ ८/१५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50014313, "chapter_id": 11530, "verse_number": "41", "content_sanskrit": "त्वं सर्ववरदः पुंसां वरेण्य वरदर्षभ। अतस्ते श्रेयसे धीराः पादरेणुमुपासते॥ ८/१५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50014314, "chapter_id": 11530, "verse_number": "42", "content_sanskrit": "अन्ववर्तन्त यं देवाः श्रीविनिर्जितपदम्योः। स्पृहयन्त इवामोदं भगवन् मे प्रसीदताम्॥ ८/१५/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50014315, "chapter_id": 11530, "verse_number": "43", "content_sanskrit": "एतैर्मन्त्रैर्हृषीकेशमावाहनपुरस्सरम्। अर्चयेच्छ्रद्धया युक्तः पाद्योपस्पर्शनादिभिः॥ ८/१५/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50014316, "chapter_id": 11530, "verse_number": "44", "content_sanskrit": "अर्चितं गन्धमाल्याद्यैः पयसा स्नापयेद् विभुम्। वस्त्रोपवीताभरणपाद्योपस्पर्शनैस्ततः॥ ८/१५/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50014317, "chapter_id": 11530, "verse_number": "45", "content_sanskrit": "गन्धधूपादिभिश्चार्चेत् द्वादशाक्षरविद्यया। शृतं पयसि नैवेद्यं शाल्यन्नं विभवे सति॥ ८/१५/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50014318, "chapter_id": 11530, "verse_number": "46", "content_sanskrit": "ससर्पिः सगुडं दत्वा जुहुयान्मूलविद्यया। निवेदितं तद्भक्ताय दद्यात् भुञ्जीत वा स्वयम्॥ ८/१५/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50014319, "chapter_id": 11530, "verse_number": "47", "content_sanskrit": "दत्वाऽऽचमनमर्चित्वा ताम्बूलं च निवेदयेत्। जपेदष्टोत्तरशतं स्तुवीत स्तुतिभिः प्रभुम्॥ ८/१५/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50014320, "chapter_id": 11530, "verse_number": "48", "content_sanskrit": "कृत्वा प्रदक्षिणं भूमौ प्रणमेद् दण्डवन्मुदा। कृत्वा शिरसि तच्छेषं देवमुद्वासयेत् ततः॥ ८/१५/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50014321, "chapter_id": 11530, "verse_number": "49", "content_sanskrit": "द्व्यवरान् भोजयेद् विप्रान् पायसेन यथोचितम्। भुञ्जीत तैरनुज्ञातो हुतशेषं सभाजितैः॥ ८/१५/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50014322, "chapter_id": 11530, "verse_number": "50", "content_sanskrit": "ब्रह्मचार्यथ तद्रात्र्यां श्वोभूते प्रथमेऽहनि। प्रातः शुचिर्यथोक्तेन विधिना सुसमाहितः॥ ८/१५/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50014323, "chapter_id": 11530, "verse_number": "51", "content_sanskrit": "पयसा स्नापयित्वाऽर्चेद् यावद् व्रतसमापनम्। पयोभक्षो व्रतमिदं चरेद् विष्ण्वर्चनादृतः॥ ८/१५/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50014324, "chapter_id": 11530, "verse_number": "52", "content_sanskrit": "पूर्ववज्जुहुयादग्निं ब्राह्मणांश्चापि भोजयेत्। एवं त्वहरहः कुर्याद् द्वादशाहं पयोव्रतम्॥ ८/१५/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 50014325, "chapter_id": 11530, "verse_number": "53", "content_sanskrit": "हरेराराधनं होममर्हणं द्विजतर्पणम्। प्रतिपद्दिनमारभ्य यावच्छुक्ल्त्रयोदशी॥ ८/१५/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 50014326, "chapter_id": 11530, "verse_number": "54", "content_sanskrit": "ब्रह्मचर्यमधःस्वापं स्नानं त्रिषवणं चरेत्। वर्जयेदसदालापं भोगानुच्चावचांस्तथा॥ ८/१५/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 50014327, "chapter_id": 11530, "verse_number": "55", "content_sanskrit": "अहिंस्रः सर्वभूतानां नारायणपरायणः। त्रयोदश्यामथो विष्णोः स्नापनं स्नापकैर्विभोः॥ ८/१५/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 50014328, "chapter_id": 11530, "verse_number": "56", "content_sanskrit": "कारयेच्छास्त्रदृष्टेन विधिना विधिकोर्विदैः। पूजां च महतीं कुर्याद् वित्तशाठ्यविवर्जितः॥ ८/१५/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 50014329, "chapter_id": 11530, "verse_number": "57", "content_sanskrit": "चरुं निरूप्य पयसि शिपिविष्टाय विष्णवे। शृतेन तेन पुरुषं यजेत सुसमाहितः॥ ८/१५/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 50014330, "chapter_id": 11530, "verse_number": "58", "content_sanskrit": "नैवेद्यं चापि गुणवद् दद्यात् पुरुषतुष्टिदम्॥ ८/१५/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 50014331, "chapter_id": 11530, "verse_number": "59", "content_sanskrit": "आचार्यं ज्ञानसम्पन्नं वस्त्राभरणधेनुभिः। तोषयेद् ऋत्विजश्चैव तद् विध्द्याराधनं हरेः॥ ८/१५/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 50014332, "chapter_id": 11530, "verse_number": "60", "content_sanskrit": "भोजयेत् तान् गुणवता सदन्नेन शुचिस्मिते। अन्यांश्च ब्राह्मणान् युक्तान् ये च तत्र समागताः॥ ८/१५/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 50014333, "chapter_id": 11530, "verse_number": "61", "content_sanskrit": "दक्षिणां गुरवे दद्याद् ऋत्विग्भ्यश्च यथाऽर्हतः। अन्नाद्येनाश्वपाकांश्च प्रीणयेत् समुपागतान्॥ ८/१५/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 50014334, "chapter_id": 11530, "verse_number": "62", "content_sanskrit": "भुक्तवत्सु च विप्रेषु दीनान्धकृपणादिषु। विष्णोस्तत्प्रीणनं विद्वान् सह भुञ्जीत बन्धुभिः॥ ८/१५/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 50014335, "chapter_id": 11530, "verse_number": "63", "content_sanskrit": "नृत्तवादित्रगीतैश्च स्तुतिभिः स्वस्तिवाचकैः। कारयेत् तत्कथाभिश्च पूजां भगवतोऽन्वहम्॥ ८/१५/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 50014336, "chapter_id": 11530, "verse_number": "64", "content_sanskrit": "एतत् पयोव्रतं नाम पुरुषाराधनं परम्। पितामहेनाभिहितं मम ते समुदाहृतम्॥ ८/१५/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 50014337, "chapter_id": 11530, "verse_number": "65", "content_sanskrit": "त्वं चानेन महाभागे सम्यक् चीर्णेन केशवम्। आत्मना शुद्धभावेन भजनीयं भजाव्ययम्॥ ८/१५/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 50014338, "chapter_id": 11530, "verse_number": "66", "content_sanskrit": "अयं वै सर्वयज्ञाख्यो सर्वव्रतमिदं स्मृतम्। तपःसारमिदं भद्रे दानं चेश्वरतर्पणम्॥ ८/१५/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 50014339, "chapter_id": 11530, "verse_number": "67", "content_sanskrit": "त एव नियमाः साक्षात् त एव च यमोत्तमाः। तपो दानं व्रतं यज्ञो येन तुष्यत्यधोक्षजः॥ ८/१५/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 50014340, "chapter_id": 11530, "verse_number": "68", "content_sanskrit": "तस्मादेतद्व्रतं भद्रे प्रयता श्रद्धया चर। भगवानपि तुष्टस्ते वरानाशु विधास्यति॥ ८/१५/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 50014341, "chapter_id": 11530, "verse_number": "69", "content_sanskrit": "इति श्रीमद्भागवते अष्टमस्कन्धे पञ्चदशोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]