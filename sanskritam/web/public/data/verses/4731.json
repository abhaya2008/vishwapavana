[{"id": 2176329, "chapter_id": 4731, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2176330, "chapter_id": 4731, "verse_number": "१", "content_sanskrit": "पातितं तं तदा दृष्ट्वा महासालमिव च्युतम् ।\nप्रहृष्टमनसः सर्वे बभूवुस्तत्र पाण्डवाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2176331, "chapter_id": 4731, "verse_number": "२", "content_sanskrit": "तं मत्तमिव मातङ्गं सिंहेन विनिपातितम् ।\nददृशुर्हृष्टरोमाणः पाण्डवाः सृञ्जयैः सह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2176332, "chapter_id": 4731, "verse_number": "३", "content_sanskrit": "ततो दुर्योधनं हत्वा भीमसेनः प्रतापवान् ।\nपतितं कौरवेन्द्रं तमुपगम्येदमब्रवीत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2176333, "chapter_id": 4731, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2176334, "chapter_id": 4731, "verse_number": "४", "content_sanskrit": "गौर्गौरिति पुरा मूढ द्रौपदीमेकवाससाम् ।\nयत् सभायां हसन्नस्मान् तदा वदसि दुर्मते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2176335, "chapter_id": 4731, "verse_number": "५", "content_sanskrit": "तस्यापहासस्य फलमद्य त्वं समवाप्नुहि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2176336, "chapter_id": 4731, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2176337, "chapter_id": 4731, "verse_number": "६", "content_sanskrit": "एवमुक्त्वा स वामेन पदा मौलिमवाक्षिपत् ।\nशिरश्च राजसिंहस्य पादेन समताडयत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2176338, "chapter_id": 4731, "verse_number": "७", "content_sanskrit": "तथैव क्रोधसंयुक्तो भीमः परबलार्दनः ।\nपुनरेवाब्रवीद् वाक्यं यत् तच्छृणु नराधिप\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2176339, "chapter_id": 4731, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2176340, "chapter_id": 4731, "verse_number": "८", "content_sanskrit": "येऽस्मान् पुरा प्रनृत्यन्ति पुनर्गौरिति गौरिति ।\nतान् वयं प्रतिनृत्यामः पुनर्गौरिति गौरिति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2176341, "chapter_id": 4731, "verse_number": "९", "content_sanskrit": "नास्माकं निकृतिद्यूतं नाक्षद्यूतं न वञ्चना ।\nस्वबाहुबलमाश्रित्य प्रबाधाम वयं रिपून्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2176342, "chapter_id": 4731, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2176343, "chapter_id": 4731, "verse_number": "१०", "content_sanskrit": "समाप्य वैरस्य परस्य पारं\nवृकोदरः प्राह ततः प्रहस्य ।\nयुधिष्ठिरं केशवसृञ्जयांश्च\nधनञ्जयं माद्रवतीसुतौ च\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2176344, "chapter_id": 4731, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2176345, "chapter_id": 4731, "verse_number": "११", "content_sanskrit": "रजस्वलां द्रौपदीमानयन् ये\nये चाप्यकुर्वन्त सदस्यवस्त्राम् ।\nतान् पश्यध्वं पाण्डवैर्धार्तराष्ट्रान्\nरणे हतांस्तपसा याज्ञसेन्याः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2176346, "chapter_id": 4731, "verse_number": "१२", "content_sanskrit": "ये नः पुरा षण्डतिलानवोचन्\nक्रूरात्मानो धृतराष्ट्रस्य पुत्राः ।\nते नो हताः सगणाः सानुबन्धाः\nकामं स्वर्गं नरकं वा व्रजामः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2176347, "chapter_id": 4731, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2176348, "chapter_id": 4731, "verse_number": "१३", "content_sanskrit": "पुनश्च राज्ञः पतितस्य भूमौ\nभीमो गदां स्कन्धगतां प्रगृह्य ।\nवामेन पादेन शिरः प्रमथ्य\nदुर्योधनं नैकृतिकेत्यवोचत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2176349, "chapter_id": 4731, "verse_number": "१४", "content_sanskrit": "हृष्टेन राजन् कुरुपार्थिवस्य\nक्षुद्रात्मना भीमसेनेन पादम् ।\nदृष्ट्वा कृतं मूर्ध्न्यथ नाभ्यनन्दन्\nधर्मात्मानः सोमकानां प्रबर्हाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2176350, "chapter_id": 4731, "verse_number": "१५", "content_sanskrit": "तव पुत्रं तथा हत्वा कत्थमानं वृकोदरम् ।\nनृत्यमानं च बहुशो धर्मराजोऽब्रवीदिदम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2176351, "chapter_id": 4731, "verse_number": "१६", "content_sanskrit": "गतोऽसि वैरस्यानृण्यं प्रतिज्ञा पूरिता त्वया ।\nशुभेनाथाशुभेनैव कर्मणा विरमाधुना\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2176352, "chapter_id": 4731, "verse_number": "१७", "content_sanskrit": "मा शिरोऽस्य पदाऽमर्दीर्मा धर्मस्तेऽतिगो भवेत् ।\nराजा ज्ञातिर्हतश्चायं नैतन्न्याय्यं तवानघ\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2176353, "chapter_id": 4731, "verse_number": "१८", "content_sanskrit": "एकादशचमूनाथं कुरूणामधिपं तथा ।\nमास्प्राक्षीर्भीम पादेन राजानं ज्ञातिमेव च\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2176354, "chapter_id": 4731, "verse_number": "१९", "content_sanskrit": "हतबन्धुर्हतामात्यो भ्रष्टसैन्यो हतो मृधे ।\nसर्वाकारेण शोच्योऽयं नावहास्योऽयमीश्वरः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2176355, "chapter_id": 4731, "verse_number": "२०", "content_sanskrit": "विध्वस्तोऽयं हतामात्यो हतबन्धुर्हतात्मजः ।\nउत्सन्नपिण्डो भ्राता च नैतन्न्याय्यं कृतं त्वया\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2176356, "chapter_id": 4731, "verse_number": "२१", "content_sanskrit": "धार्मिको भीमसेनोऽसावित्याहुस्त्वां पुरा जनाः ।\nस कस्माद् भीमसेन त्वं राजानमधितिष्ठसि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2176357, "chapter_id": 4731, "verse_number": "२२", "content_sanskrit": "इत्युक्त्वा भीमसेनं तु साश्रुकण्ठो युधिष्ठिरः ।\nउपसृत्याब्रवीद् दीनो दुर्योधनमरिन्दमम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2176358, "chapter_id": 4731, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2176359, "chapter_id": 4731, "verse_number": "२३", "content_sanskrit": "नूनमेतद् बलवता धात्राऽऽदिष्टं महात्मना ।\nयद्वयं त्वां जिघांसामः त्वं चास्मान् कुरुनन्दन\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2176360, "chapter_id": 4731, "verse_number": "२४", "content_sanskrit": "आत्मनो ह्यपराधेन महद् व्यसनमीदृशम् ।\nप्राप्तवानसि लोभाच्च मदाद् बाल्याच्च भारत\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2176361, "chapter_id": 4731, "verse_number": "२५", "content_sanskrit": "घातयित्वा वयस्यांश्च भ्रातॄनपि पितॄंस्तथा ।\nपुत्रान् पौत्रांस्तथाऽऽचार्यान् ततोऽसि निधनं गतः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2176362, "chapter_id": 4731, "verse_number": "२६", "content_sanskrit": "तवापराधादस्माभिर्भ्रातरस्ते महारथाः ।\nनिहता ज्ञातयश्चान्ये दिष्टं मन्ये दुरत्ययम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2176363, "chapter_id": 4731, "verse_number": "२७", "content_sanskrit": "स्नुषाश्च प्रस्नुषाश्चैव धृतराष्ट्रस्य विह्वलाः ।\nगर्हयिष्यन्ति नो नूनं विधवाः शोककर्शिताः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2176364, "chapter_id": 4731, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2176365, "chapter_id": 4731, "verse_number": "२८", "content_sanskrit": "एवमुक्त्वा सुदुःखार्तो निशश्वास स पार्थिवः ।\nविललाप चिरं चापि धर्मसूनुर्युधिष्ठिरः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2176366, "chapter_id": 4731, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां गदापर्वणि\nदुर्योधनप्रहरणे युधिष्ठिरप्रलापो नाम एकोनत्रिंशोऽध्यायः ॥२९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]