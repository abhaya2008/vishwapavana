[{"id": 7005472000, "chapter_id": 25472, "verse_number": "१-४२-१", "content_sanskrit": "सूत उवाच ।\nस रथोऽधिष्ठितो देवैरादित्यैर्वसुभिस्तथा ।\nगन्धर्वैरप्सरोभिश्च ग्रामणीसर्पराक्षसैः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005472001, "chapter_id": 25472, "verse_number": "१-४२-२", "content_sanskrit": "धाताऽर्यमा च मित्रश्च वरुणः शक्र एव च ।\nविवस्वानथ पूषा च पर्जन्यश्चांशुरेव च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005472002, "chapter_id": 25472, "verse_number": "१-४२-३", "content_sanskrit": "भगस्त्वष्टा च विष्णुश्च द्वादशैते दिवाकराः ।\nआप्याययति वै भानुः वसन्तादिषु वै क्रमात् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005472003, "chapter_id": 25472, "verse_number": "१-४२-४", "content_sanskrit": "पुलस्त्यः पुलहश्चात्रिर्वसिष्ठश्चाङ्गिरा भृगुः ।\nभरद्वाजो गौतमश्च कश्यपः क्रतुरेव च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005472004, "chapter_id": 25472, "verse_number": "१-४२-५", "content_sanskrit": "जमदग्निः कौशिकश्च मुनयो ब्रह्मवादिनः ।\nस्तुवन्ति देवं विविधैश्छन्दोभिस्ते यथाक्रमम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005472005, "chapter_id": 25472, "verse_number": "१-४२-६", "content_sanskrit": "रथकृच्च रथौजाश्च रथचित्रः सुबाहुकः ।\nरथस्वनोऽथ वरुणः सुषेणः सेनजित्तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005472006, "chapter_id": 25472, "verse_number": "१-४२-७", "content_sanskrit": "तार्क्ष्यश्चारिष्टनेमिश्च रथजित् सत्यजित् तथा ।\nग्रामण्यो देवदेवस्य कुर्वतेऽभीषुसंग्रहम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005472007, "chapter_id": 25472, "verse_number": "१-४२-८", "content_sanskrit": "अथ हेतिः प्रहेतिश्च पौरुषेयो वधस्तथा ।\nसर्पो व्याघ्रस्तथापश्च वातो विद्युद्दिवाकरः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005472008, "chapter_id": 25472, "verse_number": "१-४२-९", "content_sanskrit": "ब्रह्मोपेतश्च विप्रेन्द्रा यज्ञोपेतस्तथैव१च ।\nराक्षसप्रवरा ह्येते प्रयान्ति पुरतः क्रमात् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005472009, "chapter_id": 25472, "verse_number": "१-४२-१०", "content_sanskrit": "वासुकिः कङ्कनीरश्च तक्षकः सर्पपुंगवः ।\nएलापत्रः शङ्खपालस्तथैरावतसंज्ञितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005472010, "chapter_id": 25472, "verse_number": "१-४२-११", "content_sanskrit": "धनंजयो महापद्मस्तथा कर्कोटको द्विजाः ।\nकम्बलाश्वतरश्चैव वहन्त्येनं यथाक्रमम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005472011, "chapter_id": 25472, "verse_number": "१-४२-१२", "content_sanskrit": "तुम्बुरुर्नारदो हाहा हूहूर्विश्वावसुस्तथा ।\nउग्रसेनोऽथ सुरूचिरर्वावसुरथापरः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005472012, "chapter_id": 25472, "verse_number": "१-४२-१३", "content_sanskrit": "चित्रसेनस्तथोर्णायुर्धृतराष्ट्रो द्विजोत्तमाः ।\nसूर्यवर्चा द्वादशैते गन्धर्वा गायतां वराः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005472013, "chapter_id": 25472, "verse_number": "१-४२-१४", "content_sanskrit": "गायन्ति विविधैर्गानैर्भानुं षड्‌जादिभिः क्रमात् ।\nऋतुस्थलाप्सरोवर्या तथान्या पुञ्जिकस्थला ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005472014, "chapter_id": 25472, "verse_number": "१-४२-१५", "content_sanskrit": "मेनका सहजन्या च प्रम्लोचा च द्विजोत्तमाः ।\nअनुम्लोचा घृतीची च विश्वाची चोर्वशी तथा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005472015, "chapter_id": 25472, "verse_number": "१-४२-१६", "content_sanskrit": "अन्या च पूर्वचित्तिः स्याद्रम्भा चैव तिलोत्तमा ।\nताण्डवैर्विविधैरेनं वसन्तादिषु वै क्रमात् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005472016, "chapter_id": 25472, "verse_number": "१-४२-१७", "content_sanskrit": "तोषयन्ति महादेवं भानुमात्मानमव्ययम् ।\nएवं देवा वसन्त्यर्के द्वौ द्वौ मासौ क्रमेण तु ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005472017, "chapter_id": 25472, "verse_number": "१-४२-१८", "content_sanskrit": "सूर्यमाप्याययन्त्येते तेजसा तेजसां निधिम् ।\nग्रथितैः स्वैर्वचोभिस्तु स्तुवन्ति मुनयो रविम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005472018, "chapter_id": 25472, "verse_number": "१-४२-१९", "content_sanskrit": "गन्धर्वाप्सरसश्चैनं नृत्यगेयैरुपासते ।\nग्रामणीयक्षभूतानि कुर्वतेऽभीषुसंग्रहम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005472019, "chapter_id": 25472, "verse_number": "१-४२-२०", "content_sanskrit": "सर्पा वहन्ति देवेशं यातुधानाः प्रयान्ति च ।\nवालखिल्या नयन्त्यस्तं परिवार्योदयाद् रविम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005472020, "chapter_id": 25472, "verse_number": "१-४२-२१", "content_sanskrit": "एते तपन्ति वर्षन्ति भान्ति वान्ति सृजन्ति च ।\nभूतानामशुभं कर्म व्यपोहन्तीह कीर्त्तिताः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005472021, "chapter_id": 25472, "verse_number": "१-४२-२२", "content_sanskrit": "एते सहैव सूर्येण भ्रमन्ति दिवि भानुगाः ।\nविमाने च स्थितो नित्यं कामगे वातरंहसि ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005472022, "chapter_id": 25472, "verse_number": "१-४२-२३", "content_sanskrit": "वर्षन्तश्च तपन्तश्च ह्लादयन्तश्च वै प्रजाः ।\nगोपयन्तीह भूतानि सर्वाणीहायुगक्रमात् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005472023, "chapter_id": 25472, "verse_number": "१-४२-२४", "content_sanskrit": "एतेषामेव देवानां यथावीर्यं यथातपः ।\nयथायोगं यथासत्त्वं स एष तपति प्रभुः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005472024, "chapter_id": 25472, "verse_number": "१-४२-२५", "content_sanskrit": "अहोरात्रव्यवस्थानकारणं स प्रजापतिः ।\nपितृदेवमनुष्यादीन् स सदाप्याययद्रविः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005472025, "chapter_id": 25472, "verse_number": "१-४२-२६", "content_sanskrit": "तत्र देवो महादेवो भास्वान् साक्षान्महेश्वरः ।\nभासते वेदविदुषां नीलग्रीवः सनातनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005472026, "chapter_id": 25472, "verse_number": "१-४२-२७", "content_sanskrit": "स एष देवो भगवान् परमेष्ठी प्रजापतिः ।\nस्थानं तद्‌ विदुरादित्ये वेदज्ञा वेदविग्रहाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]