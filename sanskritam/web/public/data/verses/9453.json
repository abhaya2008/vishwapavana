[{"id": 5000453000, "chapter_id": 9453, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे षट्चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000453001, "chapter_id": 9453, "verse_number": "६-४६-१", "content_sanskrit": "ततो द्यां पृथिवीं चैव वीक्षमाणा वनौकसः।\nददृशुः संततौ बाणैर्भ्रातरौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000453002, "chapter_id": 9453, "verse_number": "६-४६-२", "content_sanskrit": "वृष्ट्वेवोपरते देवे कृतकर्मणि राक्षसे।\nआजगामाथ तं देशं ससुग्रीवो विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000453003, "chapter_id": 9453, "verse_number": "६-४६-३", "content_sanskrit": "नीलश्च द्विविदो मैन्दः सुषेणः कुमुदोऽङ्गदः।\nतूर्णं हनुमता सार्धमन्वशोचन्त राघवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000453004, "chapter_id": 9453, "verse_number": "६-४६-४", "content_sanskrit": "अचेष्टौ मन्दनिःश्वासौ शोणितेन परिप्लुतौ।\nशरजालाचितौ स्तब्धौ शयानौ शरतल्पगौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000453005, "chapter_id": 9453, "verse_number": "६-४६-५", "content_sanskrit": "निःश्वसन्तौ यथा सर्पौ निश्चेष्टौ मन्दविक्रमौ।\nरुधिरस्रावदिग्धाङ्गौ तपनीयाविव ध्वजौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000453006, "chapter_id": 9453, "verse_number": "६-४६-६", "content_sanskrit": "तौ वीरशयने वीरौ शयानौ मन्दचेष्टितौ।\nयूथपैः स्वैः परिवृतौ बाष्पव्याकुललोचनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000453007, "chapter_id": 9453, "verse_number": "६-४६-७", "content_sanskrit": "राघवौ पतितौ दृष्ट्वा शरजालसमन्वितौ।\nबभूवुर्व्यथिताः सर्वे वानराः सविभीषणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000453008, "chapter_id": 9453, "verse_number": "६-४६-८", "content_sanskrit": "अन्तरिक्षं निरीक्षन्तो दिशः सर्वाश्च वानराः।\nन चैनं मायया छन्नं ददृशू रावणिं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000453009, "chapter_id": 9453, "verse_number": "६-४६-९", "content_sanskrit": "तं तु मायाप्रतिच्छन्नं माययैव विभीषणः।\nवीक्षमाणो ददर्शाग्रे भ्रातुः पुत्रमवस्थितम्।\nतमप्रतिमकर्माणमप्रतिद्वन्द्वमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000453010, "chapter_id": 9453, "verse_number": "६-४६-१०", "content_sanskrit": "ददर्शान्तर्हितं वीरं वरदानाद् विभीषणः।\nतेजसा यशसा चैव विक्रमेण च संयुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000453011, "chapter_id": 9453, "verse_number": "६-४६-११", "content_sanskrit": "इन्द्रजित् त्वात्मनः कर्म तौ शयानौ समीक्ष्य च।\nउवाच परमप्रीतो हर्षयन् सर्वराक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000453012, "chapter_id": 9453, "verse_number": "६-४६-१२", "content_sanskrit": "दूषणस्य च हन्तारौ खरस्य च महाबलौ।\nसादितौ मामकैर्बाणैर्भ्रातरौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000453013, "chapter_id": 9453, "verse_number": "६-४६-१३", "content_sanskrit": "नेमौ मोक्षयितुं शक्यावेतस्मादिषुबन्धनात्।\nसर्वैरपि समागम्य सर्षिसङ्घैः सुरासुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000453014, "chapter_id": 9453, "verse_number": "६-४६-१४", "content_sanskrit": "यत्कृते चिन्तयानस्य शोकार्तस्य पितुर्मम।\nअस्पृष्ट्वा शयनं गात्रैस्त्रियामा याति शर्वरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000453015, "chapter_id": 9453, "verse_number": "६-४६-१५", "content_sanskrit": "कृत्स्नेयं यत्कृते लङ्का नदी वर्षास्विवाकुला।\nसोऽयं मूलहरोऽनर्थः सर्वेषां शमितो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000453016, "chapter_id": 9453, "verse_number": "६-४६-१६", "content_sanskrit": "रामस्य लक्ष्मणस्यैव सर्वेषां च वनौकसाम्।\nविक्रमा निष्फलाः सर्वे यथा शरदि तोयदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000453017, "chapter_id": 9453, "verse_number": "६-४६-१७", "content_sanskrit": "एवमुक्त्वा तु तान् सर्वान् राक्षसान् परिपश्यतः।\nयूथपानपि तान् सर्वांस्ताडयत् स च रावणिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000453018, "chapter_id": 9453, "verse_number": "६-४६-१८", "content_sanskrit": "नीलं नवभिराहत्य मैन्दं सद्विविदं तथा।\nत्रिभिस्त्रिभिरमित्रघ्नस्तताप परमेषुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000453019, "chapter_id": 9453, "verse_number": "६-४६-१९", "content_sanskrit": "जाम्बवन्तं महेष्वासो विद्‍ध्वा बाणेन वक्षसि।\nहनूमतो वेगवतो विससर्ज शरान् दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000453020, "chapter_id": 9453, "verse_number": "६-४६-२०", "content_sanskrit": "गवाक्षं शरभं चैव तावप्यमितविक्रमौ।\nद्वाभ्यां द्वाभ्यां महावेगो विव्याध युधि रावणिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000453021, "chapter_id": 9453, "verse_number": "६-४६-२१", "content_sanskrit": "गोलाङ्गूलेश्वरं चैव वालिपुत्रमथाङ्गदम्।\nविव्याध बहुभिर्बाणैस्त्वरमाणोऽथ रावणिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000453022, "chapter_id": 9453, "verse_number": "६-४६-२२", "content_sanskrit": "तान् वानरवरान् भित्त्वा शरैरग्निशिखोपमैः।\nननाद बलवांस्तत्र महासत्त्वः स रावणिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000453023, "chapter_id": 9453, "verse_number": "६-४६-२३", "content_sanskrit": "तानर्दयित्वा बाणौघैस्त्रसयित्वा च वानरान्।\nप्रजहास महाबाहुर्वचनं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000453024, "chapter_id": 9453, "verse_number": "६-४६-२४", "content_sanskrit": "शरबन्धेन घोरेण मया बद्धौ चमूमुखे।\nसहितौ भ्रातरावेतौ निशामयत राक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000453025, "chapter_id": 9453, "verse_number": "६-४६-२५", "content_sanskrit": "एवमुक्तास्तु ते सर्वे राक्षसाः कूटयोधिनः।\nपरं विस्मयमापन्नाः कर्मणा तेन हर्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000453026, "chapter_id": 9453, "verse_number": "६-४६-२६", "content_sanskrit": "विनेदुश्च महानादान् सर्वे ते जलदोपमाः।\nहतो राम इति ज्ञात्वा रावणिं समपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000453027, "chapter_id": 9453, "verse_number": "६-४६-२७", "content_sanskrit": "निष्पन्दौ तु तदा दृष्ट्वा भ्रातरौ रामलक्ष्मणौ।\nवसुधायां निरुच्छ्वासौ हतावित्यन्वमन्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000453028, "chapter_id": 9453, "verse_number": "६-४६-२८", "content_sanskrit": "हर्षेण तु समाविष्ट इन्द्रजित् समितिञ्जयः।\nप्रविवेश पुरीं लङ्कां हर्षयन् सर्वनैर्ऋतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000453029, "chapter_id": 9453, "verse_number": "६-४६-२९", "content_sanskrit": "रामलक्ष्मणयोर्दृष्ट्वा शरीरे सायकैश्चिते।\nसर्वाणि चाङ्गोपाङ्गानि सुग्रीवं भयमाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000453030, "chapter_id": 9453, "verse_number": "६-४६-३०", "content_sanskrit": "तमुवाच परित्रस्तं वानरेन्द्रं विभीषणः।\nसबाष्पवदनं दीनं शोकव्याकुललोचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000453031, "chapter_id": 9453, "verse_number": "६-४६-३१", "content_sanskrit": "अलं त्रासेन सुग्रीव बाष्पवेगो निगृह्यताम्।\nएवंप्रायाणि युद्धानि विजयो नास्ति नैष्ठिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000453032, "chapter_id": 9453, "verse_number": "६-४६-३२", "content_sanskrit": "सभाग्यशेषतास्माकं यदि वीर भविष्यति।\nमोहमेतौ प्रहास्येते महात्मानौ महाबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000453033, "chapter_id": 9453, "verse_number": "६-४६-३३", "content_sanskrit": "पर्यवस्थापयात्मानमनाथं मां च वानर।\nसत्यधर्माभिरक्तानां नास्ति मृत्युकृतं भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000453034, "chapter_id": 9453, "verse_number": "६-४६-३४", "content_sanskrit": "एवमुक्त्वा ततस्तस्य जलक्लिन्नेन पाणिना।\nसुग्रीवस्य शुभे नेत्रे प्रममार्ज विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000453035, "chapter_id": 9453, "verse_number": "६-४६-३५", "content_sanskrit": "ततः सलिलमादाय विद्यया परिजप्य च।\nसुग्रीवनेत्रे धर्मात्मा प्रममार्ज विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000453036, "chapter_id": 9453, "verse_number": "६-४६-३६", "content_sanskrit": "विमृज्य वदनं तस्य कपिराजस्य धीमतः।\nअब्रवीत् कालसम्प्राप्तमसम्भ्रान्तमिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000453037, "chapter_id": 9453, "verse_number": "६-४६-३७", "content_sanskrit": "न कालः कपिराजेन्द्र वैक्लव्यमवलम्बितुम्।\nअतिस्नेहोऽपि कालेऽस्मिन् मरणायोपकल्पते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000453038, "chapter_id": 9453, "verse_number": "६-४६-३८", "content_sanskrit": "तस्मादुत्सृज्य वैक्लव्यं सर्वकार्यविनाशनम्।\nहितं रामपुरोगाणां सैन्यानामनुचिन्तय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000453039, "chapter_id": 9453, "verse_number": "६-४६-३९", "content_sanskrit": "अथ वा रक्ष्यतां रामो यावत्संज्ञाविपर्ययः।\nलब्धसंज्ञौ हि काकुत्स्थौ भयं नौ व्यपनेष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000453040, "chapter_id": 9453, "verse_number": "६-४६-४०", "content_sanskrit": "नैतत् किंचन रामस्य न च रामो मुमूर्षति।\nनह्येनं हास्यते लक्ष्मीर्दुर्लभा या गतायुषाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000453041, "chapter_id": 9453, "verse_number": "६-४६-४१", "content_sanskrit": "तस्मादाश्वासयात्मानं बलं चाश्वासय स्वकम्।\nयावत् सैन्यानि सर्वाणि पुनः संस्थापयाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000453042, "chapter_id": 9453, "verse_number": "६-४६-४२", "content_sanskrit": "एते हि फुल्लनयनास्त्रासादागतसाध्वसाः।\nकर्णे कर्णे प्रकथिता हरयो हरिसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000453043, "chapter_id": 9453, "verse_number": "६-४६-४३", "content_sanskrit": "मां तु दृष्ट्वा प्रधावन्तमनीकं सम्प्रहर्षितम्।\nत्यजन्तु हरयस्त्रासं भुक्तपूर्वामिव स्रजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000453044, "chapter_id": 9453, "verse_number": "६-४६-४४", "content_sanskrit": "समाश्वास्य तु सुग्रीवं राक्षसेन्द्रो विभीषणः।\nविद्रुतं वानरानीकं तत् समाश्वासयत् पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000453045, "chapter_id": 9453, "verse_number": "६-४६-४५", "content_sanskrit": "इन्द्रजित् तु महामायः सर्वसैन्यसमावृतः।\nविवेश नगरीं लङ्कां पितरं चाभ्युपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000453046, "chapter_id": 9453, "verse_number": "६-४६-४६", "content_sanskrit": "तत्र रावणमासाद्य अभिवाद्य कृताञ्जलिः।\nआचचक्षे प्रियं पित्रे निहतौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000453047, "chapter_id": 9453, "verse_number": "६-४६-४७", "content_sanskrit": "उत्पपात ततो हृष्टः पुत्रं च परिषस्वजे।\nरावणो रक्षसां मध्ये श्रुत्वा शत्रू निपातितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000453048, "chapter_id": 9453, "verse_number": "६-४६-४८", "content_sanskrit": "उपाघ्राय च तं मूर्ध्नि पप्रच्छ प्रीतमानसः।\nपृच्छते च यथावृत्तं पित्रे तस्मै न्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000453049, "chapter_id": 9453, "verse_number": "६-४६-४९", "content_sanskrit": "यथा तौ शरबन्धेन निश्चेष्टौ निष्प्रभौ कृतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000453050, "chapter_id": 9453, "verse_number": "६-४६-५०", "content_sanskrit": "स हर्षवेगानुगतान्तरात्मा\nश्रुत्वा गिरं तस्य महारथस्य।\nजहौ ज्वरं दाशरथेः समुत्थं\nप्रहृष्टवाचाभिननन्द पुत्रम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000453051, "chapter_id": 9453, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमद्युद्धकाण्डे षट्चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]