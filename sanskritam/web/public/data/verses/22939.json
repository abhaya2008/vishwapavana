[{"id": 7002939000, "chapter_id": 22939, "verse_number": "१-१६-१", "content_sanskrit": "ब्राह्मण उवाच ।\nदृष्टः कालो यमो मृत्युकन्या व्याधिगणा अहो ।\nकस्तेऽधुना च सन्देहस्तं पृच्छ कन्यके शुभे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002939001, "chapter_id": 22939, "verse_number": "१-१६-२", "content_sanskrit": "ब्राह्मणस्य वचः श्रुत्वा हृष्टा मालावती सती ।\nयन्मनोनि हितं प्रश्नं चकार जगदीश्वरम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002939002, "chapter_id": 22939, "verse_number": "१-१६-३", "content_sanskrit": "मालावत्युवाच ।\nत्वया यत्कथितो व्याधिः प्राणिनां प्राणहारकः ।\nतत्कारणं च विविधं सर्वं वेदे निरूपितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002939003, "chapter_id": 22939, "verse_number": "१-१६-४", "content_sanskrit": "यतो न सञ्चरेद्व्याधिर्दुर्निवारोऽशुभावहः ।\nतदुपायं च साकल्यं भवान्वक्तुमिहार्हति ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002939004, "chapter_id": 22939, "verse_number": "१-१६-५", "content_sanskrit": "यद्यत्पृष्मपृष्टं वा ज्ञातमज्ञातमेव वा ।\nसर्वं कथय तद्भद्रं त्वं गुरुर्दीनवत्सलः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002939005, "chapter_id": 22939, "verse_number": "१-१६-६", "content_sanskrit": "मालावतीवचः श्रुत्वा विप्ररूपी जनार्दनः ।\nसंहितां वक्तुमारेभे सहितार्थां च वैद्यकीम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002939006, "chapter_id": 22939, "verse_number": "१-१६-७", "content_sanskrit": "ब्राह्मण उवाच ।\nवन्दे तं सर्वतत्त्वज्ञं सर्वकारणकारणम् ।\nवेदवेदांगबीजस्य बीजं श्रीकृष्णमीश्वरम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002939007, "chapter_id": 22939, "verse_number": "१-१६-८", "content_sanskrit": "स ईशश्चतुरो वेदान्ससृजे मङ्गलालयान् ।\nसर्वमङ्गलमङ्गल्य बीजरूपः सनातनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002939008, "chapter_id": 22939, "verse_number": "१-१६-९", "content_sanskrit": "ऋग्यजुःसामाथर्वाख्यान्दृष्ट्वा वेदान्प्रजापतिः ।\nविचिन्त्य तेषामर्थं चैवायुर्वेदं चकार सः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002939009, "chapter_id": 22939, "verse_number": "१-१६-१०", "content_sanskrit": "कृत्वा तु पञ्चमं वेदं भास्कराय ददौ विभुः ।\nस्वतन्त्रसंहितां तस्माद्भास्करश्च चकार सः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002939010, "chapter_id": 22939, "verse_number": "१-१६-११", "content_sanskrit": "भास्करश्च स्वशिष्येभ्य आयुर्वेदं स्वसंहिताम् ।\nप्रददौ पाठयामास ते चक्रुः संहितास्ततः॥ ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002939011, "chapter_id": 22939, "verse_number": "१-१६-१२", "content_sanskrit": "तेषां नामानि विदुषां तन्त्राणि तत्कृतानि च ।\nव्याधिप्रणाशबीजानि साध्वि मत्तो निशामय ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002939012, "chapter_id": 22939, "verse_number": "१-१६-१३", "content_sanskrit": "धन्वन्तरिर्दिवो दासः काशीराजोऽश्विनीसुतौ ।\nनकुलः सहदेवोऽर्किश्च्यवनो जनको बुधः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002939013, "chapter_id": 22939, "verse_number": "१-१६-१४", "content_sanskrit": "जाबालो जाजलिः पैलः करथोऽगस्त्य एव च ।\nएते वेदाङ्गवेदज्ञाः षोडश व्याधिनाशकाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002939014, "chapter_id": 22939, "verse_number": "१-१६-१५", "content_sanskrit": "चिकित्सातत्त्वविज्ञानं नाम तन्त्रं मनोहरम् ।\nधन्वन्तरिश्च भग वांश्चकार प्रथमं सति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002939015, "chapter_id": 22939, "verse_number": "१-१६-१६", "content_sanskrit": "चिकित्सादर्पणं नाम दिवोदासश्चकार सः ।\nचिकित्साकौमुदीं दिव्यां काशीगजश्चकार सः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002939016, "chapter_id": 22939, "verse_number": "१-१६-१७", "content_sanskrit": "चिकित्सासारतन्त्रं च श्रमघ्नं चाश्विनीसुतौ ।\nतन्त्रं वैद्यकसर्वस्वं नकुलश्च चकार सः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002939017, "chapter_id": 22939, "verse_number": "१-१६-१८", "content_sanskrit": "चकार सहदेवश्च व्याधिसिन्धुविमर्दनम् ।\nज्ञानार्णवं महातन्त्रं यमराजश्चकार ह ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002939018, "chapter_id": 22939, "verse_number": "१-१६-१९", "content_sanskrit": "च्यवनो जीवदानं च चकार भगवानृषिः ।\nचकार जनको योगी वैद्यसन्देहभञ्जनम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002939019, "chapter_id": 22939, "verse_number": "१-१६-२०", "content_sanskrit": "सर्वसारं चन्द्रसुतो जाबालस्तन्त्रसारकम् ।\nवेदाङ्गसारं तन्त्रं च चकार जाजलिर्मुनिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002939020, "chapter_id": 22939, "verse_number": "१-१६-२१", "content_sanskrit": "पैलो निदानं करथस्तन्त्रं सर्वधरं परम् ।\nद्वैधनिर्णयतन्त्रं च चकार कुम्भसम्भवः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002939021, "chapter_id": 22939, "verse_number": "१-१६-२२", "content_sanskrit": "चिकित्साशास्त्रबीजानि त न्त्राण्येतानि षोडश॥। ।\nव्याधिप्रणाशबीजानि बलाधानकरीषि ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002939022, "chapter_id": 22939, "verse_number": "१-१६-२३", "content_sanskrit": "मथित्वा ज्ञानमन्त्रेणैवायुर्वेदपयोनिधिम्॥।\nततस्तस्मादुदाजह्रुर्नवनीतानि कोविदाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002939023, "chapter_id": 22939, "verse_number": "१-१६-२४", "content_sanskrit": "एतानि क्रमशो दृष्ट्वा दिव्यां भास्करसंहिताम् ।\nआयुर्वेदं सर्वबीजं सर्वं जानासि सुन्दरि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002939024, "chapter_id": 22939, "verse_number": "१-१६-२५", "content_sanskrit": "व्याधेस्तत्त्वपरिज्ञानं वेदनायाश्च निग्रहः ।\nएतद्वैद्यस्य वैद्यत्वं न वैद्यः प्रभुरायुषः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002939025, "chapter_id": 22939, "verse_number": "१-१६-२६", "content_sanskrit": "आयुर्वेदस्य विज्ञाता चिकित्सासु यथार्थवित् ।\nधर्मिष्ठश्च दयालुश्च तेन वैद्यः प्रकीर्तितः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002939026, "chapter_id": 22939, "verse_number": "१-१६-२७", "content_sanskrit": "जनकः सर्वरोगाणां दुर्वारो दारुणो ज्वरः ।\nशिवभक्तश्च योगी च निष्ठुरो विकृताकृतिः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002939027, "chapter_id": 22939, "verse_number": "१-१६-२८", "content_sanskrit": "भीमस्त्रिपादस्त्रिशिराः षड्भुजो नवलोचनः ।\nभस्मप्रहरणो रौद्रः कालान्तकयमोपमः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002939028, "chapter_id": 22939, "verse_number": "१-१६-२९", "content_sanskrit": "मन्दाग्निस्तस्य जनको मन्दाग्नेर्जनकास्त्रयः ।\nपित्तश्लेष्मसमीराश्च प्राणिनां दुःखदायकाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002939029, "chapter_id": 22939, "verse_number": "१-१६-३०", "content_sanskrit": "वायुजः पित्तजश्चैव श्लेष्मजश्च तथैव च ।\nज्वरभेदाश्च त्रिविधाश्चतुर्थश्च त्रिदोषजः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002939030, "chapter_id": 22939, "verse_number": "१-१६-३१", "content_sanskrit": "पाण्डुश्च कामलः कुष्ठः शोथः प्लीहा च शूलकः ।\nज्वरातिसारग्रहणीकासव्रणहलीमकाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002939031, "chapter_id": 22939, "verse_number": "१-१६-३२", "content_sanskrit": "मूत्रकृच्छ्रश्च गुल्मश्च रक्तदोषविकारजः ।\nविषमेहश्च कब्जश्च गोदश्च गलगण्डकः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002939032, "chapter_id": 22939, "verse_number": "१-१६-३३", "content_sanskrit": "भ्रमरी सन्निपातश्च विषूची दारुणी सति ।\nएषां भेदप्रभेदेन चतुःषष्टी रुजः स्मृताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002939033, "chapter_id": 22939, "verse_number": "१-१६-३४", "content_sanskrit": "मृत्युकन्यासुताश्चैते जरा तस्याश्च कन्यका ।\nजरा च भ्रातृभिः सार्द्धं शश्वद् भ्रमति भूतलम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002939034, "chapter_id": 22939, "verse_number": "१-१६-३५", "content_sanskrit": "एते चोपायवेत्तारं न गच्छन्ति च संयतम् ।\nपलायन्ते च तं दृष्ट्वा वैनतेयमिवोरगाः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002939035, "chapter_id": 22939, "verse_number": "१-१६-३६", "content_sanskrit": "चक्षुर्जलं च व्यायामः पादाधस्तैलमर्दनम् ।\nकर्णयोर्मूर्ध्नि तैलं च जराव्याधिविनाशनम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002939036, "chapter_id": 22939, "verse_number": "१-१६-३७", "content_sanskrit": "वसन्ते भ्रमणं वह्निसेवां स्वल्पां करोति यः ।\nबालां च सेवते काले जरा तं नोपगच्छति ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002939037, "chapter_id": 22939, "verse_number": "१-१६-३८", "content_sanskrit": "खातशीतोदकस्नायी सेवते चन्दनद्रवम् ।\nनोपयाति जरा तं च निदाघेऽनिलसेवकम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002939038, "chapter_id": 22939, "verse_number": "१-१६-३९", "content_sanskrit": "प्रावृष्युष्णोदकस्नायी घनतोयं न सेवते ।\nसमये च समाहारी जरा तं नोपगच्छति ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002939039, "chapter_id": 22939, "verse_number": "१-१६-४०", "content_sanskrit": "शरद्रौद्रं न गृह्णाति भ्रमणं तत्र वर्जयेत् ।\nखातस्नायी समाहारी जरा तं नोपगच्छति ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002939040, "chapter_id": 22939, "verse_number": "१-१६-४१", "content_sanskrit": "खातस्नायी च हेमन्ते काले वह्निं च सेवते ।\nभुङ्क्ते नवान्नमुष्णं च जरा तं नोपगच्छति ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002939041, "chapter_id": 22939, "verse_number": "१-१६-४२", "content_sanskrit": "शिशिरेंऽशुकवह्निं च नवोष्णान्नं च सेवते ।\nयश्च वोष्णोदकस्नायी जरा तं नोपगच्छति ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002939042, "chapter_id": 22939, "verse_number": "१-१६-४३", "content_sanskrit": "सद्योमांसं नवान्नं च बालास्त्रीक्षीरभोजनम् ।\nघृतं च सेवते यो हि जरा तं नोपगच्छति ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002939043, "chapter_id": 22939, "verse_number": "१-१६-४४", "content_sanskrit": "भुङ्क्ते सदन्नं क्षुत्काले तृष्णायां पीयते जलम् ।\nनित्यं भुङ्क्ते च ताम्बूलं जरा तं नोपगच्छति ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002939044, "chapter_id": 22939, "verse_number": "१-१६-४५", "content_sanskrit": "दधि हैयङ्गवीनं च नवनीतं तथा गुडम् ।\nनित्यं भुङ्क्ते संयमी यो जरा तं नोपगच्छति ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002939045, "chapter_id": 22939, "verse_number": "१-१६-४६", "content_sanskrit": "शुष्कमांसं स्त्रियं वृद्धां बालार्कं तरुणं दधि ।\nसंसेवन्ते जरा याति प्रहृष्टा भ्रातृभिः सह ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002939046, "chapter_id": 22939, "verse_number": "१-१६-४७", "content_sanskrit": "रात्रौ ये दधि सेवन्ते पुंश्चलीश्च रजस्वलाः ।\nतानुपैति जरा हृष्टा भ्रातृभिः सह सुन्दरि ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002939047, "chapter_id": 22939, "verse_number": "१-१६-४८", "content_sanskrit": "रजस्वला च कुलटा चावीरा जारदूतिका ।\nशूद्रयाजकपत्नी या ऋतुहीना च या सति ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002939048, "chapter_id": 22939, "verse_number": "१-१६-४९", "content_sanskrit": "यो हि तासामन्नभोजी ब्रह्महत्यां लभेत्तु सः ।\nतेन पापेन सार्द्धं सा जरा तमुपगच्छति ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002939049, "chapter_id": 22939, "verse_number": "१-१६-५०", "content_sanskrit": "पापानां व्याधिभिः सार्द्धं मित्रता सन्ततं ध्रुवम् ।\nपापं व्याधिजराबीजं विघ्नबीजं च निश्चितम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002939050, "chapter_id": 22939, "verse_number": "१-१६-५१", "content_sanskrit": "पापेन जायते व्याधिः पापेन जायते जरा ।\nपापेन जायते दैन्यं दुःखं शोको भयङ्करः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002939051, "chapter_id": 22939, "verse_number": "१-१६-५२", "content_sanskrit": "तस्मात्पापं महावैरं दोषबीजममङ्गलम् ।\nभारते सततं सन्तो नाचरन्ति भयातुराः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002939052, "chapter_id": 22939, "verse_number": "१-१६-५३", "content_sanskrit": "स्वधर्माचारयुक्तं च दीक्षितं हरिसेवकम् ।\nगुरुदेवातिथीनां च भक्तं सक्तं तपःसु च ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002939053, "chapter_id": 22939, "verse_number": "१-१६-५४", "content_sanskrit": "व्रतोपवासयुक्तं च सदा तीर्थनिषेवकम् ।\nरोगा द्रवन्ति तं दृष्ट्वा वैनतेयमिवोरगाः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002939054, "chapter_id": 22939, "verse_number": "१-१६-५५", "content_sanskrit": "एताञ्जरा न सेवेत व्याधिसंघश्च दुर्जयः ।\nसर्वं बोध्यमसमये काले सर्वं ग्रसिष्यति ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002939055, "chapter_id": 22939, "verse_number": "१-१६-५६", "content_sanskrit": "ज्वरस्य सर्वरोगाणां जनकः कथितः सति ।\nपित्तश्लेष्मसमीराश्च ज्वरस्य जनकास्त्रयः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002939056, "chapter_id": 22939, "verse_number": "१-१६-५७", "content_sanskrit": "एते यथा सं चरन्ति स्वयं यान्ति च देहिषु ।\nतमेव विविधोपायं साध्वि मत्तो निशामय ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002939057, "chapter_id": 22939, "verse_number": "१-१६-५८", "content_sanskrit": "क्षुधि जाज्वल्यमानायामाहाराभाव एव च ।\nप्राणिनां जायते पित्तं चक्रे च मणिपूरके ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002939058, "chapter_id": 22939, "verse_number": "१-१६-५९", "content_sanskrit": "तालबिल्वफलं भुक्त्वा जलपानं च तत्क्षणम् ।\nतदेव तु भवेत्पित्तं सद्यः प्राणहरं परम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002939059, "chapter_id": 22939, "verse_number": "१-१६-६०", "content_sanskrit": "तप्तोदकं च शिरसि भाद्रे तिक्तं विशेषतः ।\nदैवग्रस्तश्च यो भुङ्क्ते पित्तं तस्य प्रजायते ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002939060, "chapter_id": 22939, "verse_number": "१-१६-६१", "content_sanskrit": "सशर्करं च धान्याकं पिष्टं शीतोदकान्वितम् ।\nचणकं सर्वगव्यं च दधितक्रविवर्जितम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002939061, "chapter_id": 22939, "verse_number": "१-१६-६२", "content_sanskrit": "बिल्वतालफलं पक्वं सर्वमैक्षवमेव च ।\nआर्द्रकं मुद्गयूषं च तिलपिष्टं सशर्करम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002939062, "chapter_id": 22939, "verse_number": "१-१६-६३", "content_sanskrit": "पित्तक्षयकरं सद्यो बलपुष्टिप्रदं परम् ।\nपित्तनाशं च तद्बीजमुक्तमन्यन्निबोध मे ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002939063, "chapter_id": 22939, "verse_number": "१-१६-६४", "content_sanskrit": "भोजनानन्तरं स्नानं जलपानं विना तृषा ।\nतिलतैलं स्निग्धतैलं स्निग्धमामलकीद्रवम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002939064, "chapter_id": 22939, "verse_number": "१-१६-६५", "content_sanskrit": "पर्य्युषितान्नं च तक्रं च पक्वं रम्भाफलं दधि ।\nमेघाम्बु शर्करातोयं सुस्निग्धजलसेवनम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002939065, "chapter_id": 22939, "verse_number": "१-१६-६६", "content_sanskrit": "नारिकेलोदकं रूक्षस्नानं पर्युषिते जले ।\nतरुगुंजापक्वफलं सुपक्वं कर्क्कटीफलम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002939066, "chapter_id": 22939, "verse_number": "१-१६-६७", "content_sanskrit": "खातस्नानं च वर्षासु मूलकं श्लेष्मकारकम् ।\nब्रह्मरन्ध्रे च तज्जन्म महद्वीर्य्य विनाशनम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002939067, "chapter_id": 22939, "verse_number": "१-१६-६८", "content_sanskrit": "वह्निस्वेदं भ्रष्टभङ्गं पक्वतैलविशेषकम् ।\nभ्रमणं शुष्कभक्षं च शुष्कपक्वहरीतकी ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002939068, "chapter_id": 22939, "verse_number": "१-१६-६९", "content_sanskrit": "पिण्डारकमपक्वं च रम्भा फलमपक्वकम् ।\nवेसवारः सिन्धुवार अनाहारमपानकम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002939069, "chapter_id": 22939, "verse_number": "१-१६-७०", "content_sanskrit": "सघृतं रोचनाचूर्णं सघृतं शुष्कशर्करम् ।\nमरीचं पिप्पलं शुष्कमार्द्रकं जीवकं मधु ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002939070, "chapter_id": 22939, "verse_number": "१-१६-७१", "content_sanskrit": "द्रव्याण्येतानि गान्धर्वि सद्यः श्लेष्महराणि च ।\nबलपुष्टिकराण्येव वायुबीजं निशामय ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002939071, "chapter_id": 22939, "verse_number": "१-१६-७२", "content_sanskrit": "भोजनानन्तरं सद्यो गमनं धावनं तथा ।\nछेदनं वह्नितापश्च शश्वद्भ्रमणमैथुनम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002939072, "chapter_id": 22939, "verse_number": "१-१६-७३", "content_sanskrit": "वृद्धस्त्रीगमनं चैव मनःसन्ताप एव च ।\nअतिरूक्षमनाहारं युद्धं कलहमेव च ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002939073, "chapter_id": 22939, "verse_number": "१-१६-७४", "content_sanskrit": "कटु वाक्यं भयं शोकः केवलं वायुकारणम् ।\nआज्ञाख्यचक्रे तजन्म निशामय तदौषधम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002939074, "chapter_id": 22939, "verse_number": "१-१६-७५", "content_sanskrit": "पक्वं रम्भाफलं चैव सबीजं शर्करोदकम् ।\nनारिकेलोदकं चैव सद्यस्तक्रं सुपिष्टकम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002939075, "chapter_id": 22939, "verse_number": "१-१६-७६", "content_sanskrit": "माहिषं दधि मिष्टं च केवलं वा सशर्करम् ।\nसद्यः पर्य्युषितान्नं च सौवीरं शीतलोदकम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002939076, "chapter_id": 22939, "verse_number": "१-१६-७७", "content_sanskrit": "पक्वतैलविशेषं च तिलतैलं च केवलम् ।\nलांगलीतालखर्जूरमुष्णमामलकीद्रवम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002939077, "chapter_id": 22939, "verse_number": "१-१६-७८", "content_sanskrit": "शीतलोष्णोदकस्नानं सुस्निग्धचन्दनद्रवम् ।\nस्निग्धपद्मपत्रतल्पं सुस्निग्धव्यजनानि च ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002939078, "chapter_id": 22939, "verse_number": "१-१६-७९", "content_sanskrit": "एतत्ते कथितं वत्से सद्योवायुप्रणाशनम् ।\nवायवस्त्रिविधाः पुंसां क्लेशसन्तापकामजाः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002939079, "chapter_id": 22939, "verse_number": "१-१६-८०", "content_sanskrit": "व्याधिसंघश्च कथितस्तन्त्राणि विविधानि च ।\nतानि व्याधिप्रणाशाय कृतानि सद्भिरेव च ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002939080, "chapter_id": 22939, "verse_number": "१-१६-८१", "content_sanskrit": "तन्त्राण्येतानि सर्वाणि व्याधिक्षयकराणि च ।\nरसायनादयो येषु चोपायाश्च सुदुर्लभाः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002939081, "chapter_id": 22939, "verse_number": "१-१६-८२", "content_sanskrit": "न शक्तः कथितुं साध्वि यथार्थं वत्सरेण च ।\nतेषां च सर्वतन्त्राणां कृतानां च विचक्षणैः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002939082, "chapter_id": 22939, "verse_number": "१-१६-८३", "content_sanskrit": "केन रोगेण त्वत्कान्तो मृतः कथय शोभने ।\nतदुपायं करिष्यामि येन जीवेदयं सति ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002939083, "chapter_id": 22939, "verse_number": "१-१६-८४", "content_sanskrit": "सौतिरुवाच ।\nब्राह्मणस्य वचः  श्रुत्वा कन्या चित्ररथस्य च ।\nकथां कथितुमारेभे सा गान्धर्वी प्रहर्षिता ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7002939084, "chapter_id": 22939, "verse_number": "१-१६-८५", "content_sanskrit": "मालावत्युवाच ।\nयोगेन प्राणांस्तत्याज ब्रह्मणः शापहेतुना ।\nसभायां लज्जितः कान्तो मम विप्र निशामय ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7002939085, "chapter_id": 22939, "verse_number": "१-१६-८६", "content_sanskrit": "सर्वं श्रुतमपूर्वं च शुभाख्यानं मनोहरम् ।\nभवेद्भवे कुतः केषां महल्लभ्यं विपद्विना ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7002939086, "chapter_id": 22939, "verse_number": "१-१६-८७", "content_sanskrit": "अधुना मत्प्राणकान्तं देहि देहि विचक्षण ।\nनत्वा वः स्वामिना सार्द्धं यास्यामि स्वगृहं प्रति ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7002939087, "chapter_id": 22939, "verse_number": "१-१६-८८", "content_sanskrit": "मालावतीवचः श्रुत्वा विप्ररूपी जनार्दनः ।\nसभां जगाम देवानां शीघ्रं विप्रस्तदन्तिकात् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}]