[{"id": 7000650000, "chapter_id": 20650, "verse_number": "५-१०९-१", "content_sanskrit": "शंभुरुवाच ।\nअत्र ते कीर्तयिष्यामि कथां पापप्रणाशिनीम् ।\nश्रुत्वा यां प्राप धर्मात्मा शिवभक्तिमनुत्तमाम् ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000650001, "chapter_id": 20650, "verse_number": "५-१०९-२", "content_sanskrit": "इक्ष्वाकुर्नाम विप्रेंद्रो महाविद्यो महामतिः ।\nबहुशास्त्रप्रवीणश्च नीतिशास्त्रविशारदः ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000650002, "chapter_id": 20650, "verse_number": "५-१०९-३", "content_sanskrit": "न यष्टा न च दाता च न देवानां च पूजकः ।\nन चाध्यापयिता वेदं न व्याख्याता श्रुतस्य च ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000650003, "chapter_id": 20650, "verse_number": "५-१०९-४", "content_sanskrit": "न पुराणेतिहासानां श्रुतीनामागमस्य वा ।\nयत्नाद्भोक्ता तथा देहसंस्कारैकप्रवर्तकः ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000650004, "chapter_id": 20650, "verse_number": "५-१०९-५", "content_sanskrit": "तादृशस्य द्विजस्याथ समालक्ष्यायुरत्यगात् ।\nलक्षांतरे तथैकस्मिन्वत्सरे मासि पंचमे ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000650005, "chapter_id": 20650, "verse_number": "५-१०९-६", "content_sanskrit": "तृतीय दिवसे रात्र्यां पुराणं श्रुतवानिदम् ।\nस्वसंपादितवित्तस्य येन दानं न वै कृतम् ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000650006, "chapter_id": 20650, "verse_number": "५-१०९-७", "content_sanskrit": "दिनेदिने भुज्यमानं निःसारं स्यात्क्रमेण हि ।\nवर्षाण्येव च तावंति नरके पच्यते ध्रुवम् ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000650007, "chapter_id": 20650, "verse_number": "५-१०९-८", "content_sanskrit": "कृमियोनिसहस्रं च अनुभूय ततः परम् ।\nदरिद्रो व्याधितोऽबंधुर्दुष्टभार्यो बहुप्रजः ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000650008, "chapter_id": 20650, "verse_number": "५-१०९-९", "content_sanskrit": "दिनेदिने भिक्षितेन याचितेन च जीवनम् ।\nयन्न क्वापि च बीजानां मग्नानामथ मार्गणात् ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000650009, "chapter_id": 20650, "verse_number": "५-१०९-१०", "content_sanskrit": "लब्धेनजीवनं कर्म भृत्यानामथ जीवनम् ।\nमध्ये श्रोत्रविहीनश्च नेत्रहीनः स्खलन्मलः ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000650010, "chapter_id": 20650, "verse_number": "५-१०९-११", "content_sanskrit": "एवं पुराणं श्रुत्वा साविक्ष्वाकुर्भृशदुःखितः ।\nमनसा चिंतयच्चेदं स्मारं स्मारं द्विजाधमः ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000650011, "chapter_id": 20650, "verse_number": "५-१०९-१२", "content_sanskrit": "रूपपुष्पैर्माहिष्मयी दुर्गापि फलवर्जिता ।\nतथा पुराणरहिता विद्या नो गतिदर्शनी ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000650012, "chapter_id": 20650, "verse_number": "५-१०९-१३", "content_sanskrit": "बहुशास्त्रं समभ्यस्य बहुवेदान्सविस्तरान् ।\nपुंसोश्रुतपुराणस्य सम्यग्याति न दर्शनम् ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000650013, "chapter_id": 20650, "verse_number": "५-१०९-१४", "content_sanskrit": "शंभुरुवाच ।\nएवं चिंतयतस्तस्य अकालमरणं त्वभूत् ।\nयमलोकं गतश्चाथ यमेन परिभाषितः ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000650014, "chapter_id": 20650, "verse_number": "५-१०९-१५", "content_sanskrit": "यम उवाच ।\nअनेकपापयुक्तोसि पुण्यं नैव महत्तव ।\nन वेदाध्यापनात्प्राप्तं पापं च विदितं तव ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000650015, "chapter_id": 20650, "verse_number": "५-१०९-१६", "content_sanskrit": "कोटिवर्षाणि नरके तवस्थितिरिति द्विज ।\nआयुरस्ति तवात्यल्पं गम्यतां पौर्विकीं तनुम् ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000650016, "chapter_id": 20650, "verse_number": "५-१०९-१७", "content_sanskrit": "कुरु पुण्यं हितं दानं देवतापूजनं जपम् ।\nसांगमध्यापनं विप्र भोजनं भस्मधारणम् ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000650017, "chapter_id": 20650, "verse_number": "५-१०९-१८", "content_sanskrit": "भज विश्वेश्वरं देवं देवदेवमुमापतिम् ।\nतस्य प्रयत्नमात्रेण मम लोकं न गच्छसि ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000650018, "chapter_id": 20650, "verse_number": "५-१०९-१९", "content_sanskrit": "यत्किंचित्प्रत्यहं पापिन्पुराणं शृणु सादरम् ।\nततस्तच्छ्रवणादेव नेक्षसे मम यातनाः ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000650019, "chapter_id": 20650, "verse_number": "५-१०९-२०", "content_sanskrit": "यमस्य वचनं श्रुत्वा ब्राह्मणः स्वां ययौ तनुम् ।\nअथेशपूजनकृते यत्नमास्थाय स द्विजः ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000650020, "chapter_id": 20650, "verse_number": "५-१०९-२१", "content_sanskrit": "अगमन्मुनिवर्यं तु जाबालिशिवपूजकम् ।\nतपः स्वाध्यायसंपन्नं श्रुतिस्मृतिविवेचकम् ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000650021, "chapter_id": 20650, "verse_number": "५-१०९-२२", "content_sanskrit": "पुराणतत्त्ववेत्तारं लक्षशिष्यसमावृतम् ।\nजराशिथिलसर्वांगं वेदवेदांगपारगम् ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000650022, "chapter_id": 20650, "verse_number": "५-१०९-२३", "content_sanskrit": "द्रष्टुकामो ययौ शैलं मंदरं चारुकंदरम् ।\nनानाविहंगसंपूर्णं नानापुष्पलतावृतम् ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000650023, "chapter_id": 20650, "verse_number": "५-१०९-२४", "content_sanskrit": "सर्वर्तुकुसुमोपेतं नानागंधोपशोभितम् ।\nकिन्नराणां च मिथुनैर्गीतपूर्णमहागुहम् ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000650024, "chapter_id": 20650, "verse_number": "५-१०९-२५", "content_sanskrit": "अनेकरूपलावण्य वनितोषितपादपम् ।\nलंबमानविचित्राभिस्ताभिः शोभितपादपम् ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000650025, "chapter_id": 20650, "verse_number": "५-१०९-२६", "content_sanskrit": "रतिश्रमप्रसुप्तानां बोधनादितषट्पदम् ।\nकूजंति च पिकाः कामं वियुक्तानां युजे किल ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000650026, "chapter_id": 20650, "verse_number": "५-१०९-२७", "content_sanskrit": "नानामुनिगणाकीर्णं प्रशांतमृगचारिणम् ।\nअप्सरोगणसंकीर्णं गंधर्वगणसेवितम् ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000650027, "chapter_id": 20650, "verse_number": "५-१०९-२८", "content_sanskrit": "नानासिद्धमुखोद्भूतगीतपूर्णवनांतरम् ।\nविचित्रफलसंपूर्णं नानादेवालयान्वितम् ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000650028, "chapter_id": 20650, "verse_number": "५-१०९-२९", "content_sanskrit": "प्रासादशतसंबाधं नानागृहसमन्वितम् ।\nसिंहाननैर्गजमुखैरुलूकवदनैरथ ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000650029, "chapter_id": 20650, "verse_number": "५-१०९-३०", "content_sanskrit": "अमुखैर्विमुखैरुग्रैरर्द्धवक्त्रैर्मृगीमुखैः ।\nरुरुजंतुकगोधाहि वानरर्क्षमुखैरपि ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000650030, "chapter_id": 20650, "verse_number": "५-१०९-३१", "content_sanskrit": "व्याघ्रवृश्चिकभल्लूष्ट्रश्वानगर्दभतुंडकैः ।\nसमस्तजीववदनसदृशास्यैर्गणेश्वरैः ।\nवल्लीमुखैर्वृक्षमुखैः शिलावक्त्रैरयोमुखैः ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000650031, "chapter_id": 20650, "verse_number": "५-१०९-३२", "content_sanskrit": "शंखमुक्तादिजलजवदनैरुपशोभितम् ।\nअधिकांगैरनंगैश्च जटिलैः शिखिमुंडितैः ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000650032, "chapter_id": 20650, "verse_number": "५-१०९-३३", "content_sanskrit": "पत्रिवक्त्रैर्द्विषड्वक्त्रैस्त्रिविग्रहमुखैरपि ।\nघंटास्यैः शूर्पवदनकर्णपादमुखैरपि ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000650033, "chapter_id": 20650, "verse_number": "५-१०९-३४", "content_sanskrit": "घंटामुखैर्वेणुमुखैः किंकिणीवदनैरपि ।\nयादृग्वस्तु जगत्यस्ति तादृशास्यैरयोमुखैः ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000650034, "chapter_id": 20650, "verse_number": "५-१०९-३५", "content_sanskrit": "कैश्चिन्निभृतकंदर्परूपलावण्यकोमलैः ।\nकोटिसूर्यप्रतीकाशैश्चंद्र कोटिसमप्रभैः ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000650035, "chapter_id": 20650, "verse_number": "५-१०९-३६", "content_sanskrit": "नानावर्णैर्विश्वमुखैर्विश्वरूपैश्चतुर्मुखैः ।\nद्विमुखैः पंचवक्त्रैश्च त्रिमुखैः षण्मुखैरपि ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000650036, "chapter_id": 20650, "verse_number": "५-१०९-३७", "content_sanskrit": "एकानेकमुखैः शांतैः सर्वदा सुखिभिर्युतम् ।\nनानाभोगसमृद्धैश्च रतिकामसमैरपि ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000650037, "chapter_id": 20650, "verse_number": "५-१०९-३८", "content_sanskrit": "लक्ष्मीनारायणमुखैरुमेशसमविग्रहैः ।\nनानारूपधरैश्चान्यैः सेवितं मंदराचलम् ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000650038, "chapter_id": 20650, "verse_number": "५-१०९-३९", "content_sanskrit": "धेनवो यत्र वेदाश्च मीमांसावत्स संयुताः ।\nधर्मादयः सवर्ष्माणः पुराणानि च कर्मणा ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000650039, "chapter_id": 20650, "verse_number": "५-१०९-४०", "content_sanskrit": "स्मृतीतिहासजातानि आगमाश्च शरीरिणः ।\nस्थिताश्च मंदरे यत्र सशैलः पापनाशनः ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000650040, "chapter_id": 20650, "verse_number": "५-१०९-४१", "content_sanskrit": "तस्य मध्ये महापुण्यं पुरं परमशोभितम् ।\nवापीतडागोपवनप्रासादशतशोभितम् ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000650041, "chapter_id": 20650, "verse_number": "५-१०९-४२", "content_sanskrit": "सप्तप्राकारपरिखं रत्नाट्टालकसंयुतम् ।\nगोपुरैर्नवभिर्युक्तं विचित्रगृहसंयुतम् ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000650042, "chapter_id": 20650, "verse_number": "५-१०९-४३", "content_sanskrit": "यस्य चाप्रतिमं तेज उष्णशीतादिवर्जितम् ।\nतन्मध्ये नगरी पुण्या तन्मध्ये च सभा शुभा ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000650043, "chapter_id": 20650, "verse_number": "५-१०९-४४", "content_sanskrit": "तस्यां भद्रासनं मध्ये वेदपादविचित्रितम् ।\nसर्वोपनिषदाकॢप्तं पादपीठं सुशोभनम् ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000650044, "chapter_id": 20650, "verse_number": "५-१०९-४५", "content_sanskrit": "पुराणान्यागमास्तस्य स्वस्तीति शिवपादयोः ।\nतत्रासीनो महायोगी गोक्षीरसदृशाकृतिः ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000650045, "chapter_id": 20650, "verse_number": "५-१०९-४६", "content_sanskrit": "मंदस्मितसुचार्वास्योद्व्यष्टवर्षवयाः प्रभुः ।\nदधान उरसामालां मणिरुद्राक्षकल्पिताम् ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000650046, "chapter_id": 20650, "verse_number": "५-१०९-४७", "content_sanskrit": "बिभ्राण उपवीतं च कर्णिकारसमद्युतिः ।\nसुरत्नकुंडलो देवः किरीटकनकांबरः ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000650047, "chapter_id": 20650, "verse_number": "५-१०९-४८", "content_sanskrit": "नानाभूषणसंयुक्तो नानागंधविलेपनः ।\nवामांकन्यस्तगिरिजो वीक्षमाणस्तदाननम् ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000650048, "chapter_id": 20650, "verse_number": "५-१०९-४९", "content_sanskrit": "मुग्धां च सुमुखीं बालां नवयौवनशोभिताम् ।\nभूषितां चारुसर्वांगीं बिभ्रतीं कनकांबुजम् ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000650049, "chapter_id": 20650, "verse_number": "५-१०९-५०", "content_sanskrit": "आलिंग्य वामेनकरेण देवीं दक्षेण तस्या मुखमुन्नमय्य ।\nस्पृष्ट्वा शिरो वामकरेण तस्या दक्षेण कुर्वंस्तिलकं च देवः ॥५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000650050, "chapter_id": 20650, "verse_number": "५-१०९-५१", "content_sanskrit": "भक्तिर्वीजयते देवं प्रणव व्यजनेन च ।\nपूजाकांतापि कुसुमैर्मालां देवाय बिभ्रती ॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000650051, "chapter_id": 20650, "verse_number": "५-१०९-५२", "content_sanskrit": "ज्ञप्तिर्विरक्तिर्वनिते बिभ्रत्यौ योगचामरे ।\nसमाधिः कार्यकर्तास्य धारणायोषिदस्य च ॥५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000650052, "chapter_id": 20650, "verse_number": "५-१०९-५३", "content_sanskrit": "यमाश्चनियमाश्चैव किंकरास्तस्य कीर्तिताः ।\nप्राणायामः पुरोधास्तु प्रत्याहारः सुवर्णधृक् ॥५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000650053, "chapter_id": 20650, "verse_number": "५-१०९-५४", "content_sanskrit": "ध्यानं च द्रविणाध्यक्षः सत्यं सेनापतिस्तथा ।\nब्रह्मप्रभृतिकीटांताः पशवस्तत्पतिः शिवः ॥५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000650054, "chapter_id": 20650, "verse_number": "५-१०९-५५", "content_sanskrit": "पशूनां पालको धर्मः स्यादधर्मश्च तस्करः ।\nमायापाशेन ते बद्धा मोचनी काशिका मृतिः ॥५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000650055, "chapter_id": 20650, "verse_number": "५-१०९-५६", "content_sanskrit": "नानाविधाश्च प्रमदा देवदेवमुमापतिम् ।\nएतादृशमुमानाथं कोटिजंतुरनुस्मरेत् ॥५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000650056, "chapter_id": 20650, "verse_number": "५-१०९-५७", "content_sanskrit": "इष्टान्भोगानवाप्याथ शिवलोके महीयते ।\nब्रह्मविष्णुमहेंद्राद्यास्तत्पुरद्वारपालकाः ॥५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000650057, "chapter_id": 20650, "verse_number": "५-१०९-५८", "content_sanskrit": "लक्ष्मीसरस्वतीदेव्यौ देहल्याद्यर्च्चनेक्षितेः ।\nनियुक्ते देवदेवस्य देवाश्च सुरयोषितः ॥५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000650058, "chapter_id": 20650, "verse_number": "५-१०९-५९", "content_sanskrit": "दास्यो देवाः समस्ताश्च दासा यस्य महात्मनः ।\nएतादृशमहाशैलमिक्ष्वाकुः संददर्श ह ॥५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000650059, "chapter_id": 20650, "verse_number": "५-१०९-६०", "content_sanskrit": "मुनिं प्रणम्य जाबालिमिदमाह वचस्तदा ।\nगंतुकामो महाशैलं शक्तोस्यस्मिन्न वा मुने ॥६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000650060, "chapter_id": 20650, "verse_number": "५-१०९-६१", "content_sanskrit": "ममायुरल्पं कथितं यमेन ज्ञानिना पुरा ॥६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000650061, "chapter_id": 20650, "verse_number": "५-१०९-६२", "content_sanskrit": "नरकश्च बहुःप्रोक्तः कथं श्रेयो भविष्यति ।\nजाबालिरुवाच ।\nमयापि सर्वमेतत्ते ज्ञातं दिव्येन चक्षुषा ॥६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000650062, "chapter_id": 20650, "verse_number": "५-१०९-६३", "content_sanskrit": "आयुर्दशदिनं ब्रह्मन्विद्वानपि न धर्मकृत् ।\nन तपस्ते ह्यनभ्यासान्न च योगोऽल्पकालतः ॥६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000650063, "chapter_id": 20650, "verse_number": "५-१०९-६४", "content_sanskrit": "न दानं द्रविणाभावादसामर्थ्यात्तथार्हणा ।\nन यज्ञो न व्रतं पूर्तं न च पुण्यमनायुषः ॥६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000650064, "chapter_id": 20650, "verse_number": "५-१०९-६५", "content_sanskrit": "न चाध्यापनतीर्थादि सेवाकालविरोधतः ।\nतस्मात्तत्पापनाशाय प्रायश्चित्तं न विद्यते ॥६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000650065, "chapter_id": 20650, "verse_number": "५-१०९-६६", "content_sanskrit": "गतिप्रदं तथा धर्मं गच्छ वा तिष्ठ वा मुने ।\nइक्ष्वाकुरुवाच ।\nयावज्जीवं प्रतिज्ञाय क्रियते यो वृषो द्विज ॥६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000650066, "chapter_id": 20650, "verse_number": "५-१०९-६७", "content_sanskrit": "तेन पापपरीहारो भविष्यति सुनिश्चितम् ।\nतं ब्रूहि येन धर्मेण मम पापं प्रणश्यति ॥६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000650067, "chapter_id": 20650, "verse_number": "५-१०९-६८", "content_sanskrit": "केन वा पुण्ययोगेन स्वर्गतिश्च भविष्यति ।\nशरणं भव विप्रर्षे नरकादतिबिभ्यतः ॥६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000650068, "chapter_id": 20650, "verse_number": "५-१०९-६९", "content_sanskrit": "सर्वधर्मफलं प्राहुः शरणागतपालनम् ।\nजाबालिरुवाच ।\nसत्यं स्वल्पेन कालेन न तादृग्लभ्यते वृषः ॥६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000650069, "chapter_id": 20650, "verse_number": "५-१०९-७०", "content_sanskrit": "अमृतेत्वनृते शक्यं वक्तुं स्वप्नांतरेष्वपि ।\nरहस्यमेकं किंचित्तु यस्य कस्यापि नोच्यते ॥७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000650070, "chapter_id": 20650, "verse_number": "५-१०९-७१", "content_sanskrit": "इक्ष्वाकुरुवाच ।\nशरणं पालय मुने कालो मे निर्गमिष्यति ।\nजाबालिरुवाच ।\nमम प्राणाधिकं विप्र रहस्यं श्रुतिचोदितम् ॥७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000650071, "chapter_id": 20650, "verse_number": "५-१०९-७२", "content_sanskrit": "शिवलिंगार्चनं नाम ब्रह्मादिभिरनुष्ठितम् ।\nसमस्तपापशमनं सर्वोपद्रवनाशनम् ॥७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000650072, "chapter_id": 20650, "verse_number": "५-१०९-७३", "content_sanskrit": "भुक्तिमुक्तिप्रदं तस्माच्छिवपूजां समाचर ।\nनातिक्रामेद्यदि मुने शिवलिंगार्चनं शुभम् ॥७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000650073, "chapter_id": 20650, "verse_number": "५-१०९-७४", "content_sanskrit": "यः शंभुपूजां विच्छिंद्यात्तेन च्छिन्नं हि मे शिरः ।\nवरं शूलविनिक्षेपो वरं शाल्मलिकर्षणम् ॥७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000650074, "chapter_id": 20650, "verse_number": "५-१०९-७५", "content_sanskrit": "वरं प्राणपरित्यागो नैव पूजाव्यतिक्रमः ।\nवरं वह्निप्रपतनं वरं चाधःशिरः कृतम् ॥७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000650075, "chapter_id": 20650, "verse_number": "५-१०९-७६", "content_sanskrit": "वरं स्वमलभुक्तिर्वा नेशपूजाव्यतिक्रमः ।\nअपूजयित्वा चेशानं यो हि भुंक्ते नराधमः ॥७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000650076, "chapter_id": 20650, "verse_number": "५-१०९-७७", "content_sanskrit": "पापानामन्नरूपाणां तस्य भोजनमुच्यते ।\nअनुच्चार्य पदं शंभोर्भुङ्क्ते यदि च खादति ॥७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000650077, "chapter_id": 20650, "verse_number": "५-१०९-७८", "content_sanskrit": "शिवेति मंगलं नाम यस्य वाचि प्रवर्तते ।\nभस्मीभवंति तस्याशु महापातककोटयः ॥७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000650078, "chapter_id": 20650, "verse_number": "५-१०९-७९", "content_sanskrit": "शिवं प्रदक्षिणीकृत्य यो नमस्यति मानवः ।\nभूमेः प्रदक्षिणं कृत्वा यत्तत्पुण्यमवाप्नुयात् ॥७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000650079, "chapter_id": 20650, "verse_number": "५-१०९-८०", "content_sanskrit": "प्रदक्षिणत्रयं कृत्वा नमस्कारं च पंचधा ।\nपुनः प्रदक्षिणं कृत्वा नत्वा मुच्येत पातकैः ॥८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000650080, "chapter_id": 20650, "verse_number": "५-१०९-८१", "content_sanskrit": "सर्ववाद्यानि यः कुर्यात्कारयेद्वा शिवालये ।\nबलेन महता युक्तो वेदसेव्यत्र जायते ॥८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000650081, "chapter_id": 20650, "verse_number": "५-१०९-८२", "content_sanskrit": "श्रावयेद्यः पुराणानि देवदेवं त्रिलोचनम् ।\nसर्वपापविनिर्मुक्तो वसेच्छिवपुरे कृती ॥८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000650082, "chapter_id": 20650, "verse_number": "५-१०९-८३", "content_sanskrit": "तं नित्यमादरेणेशो वक्ति वाक्यं प्रियं सदा ।\nएतत्संक्षेपतः प्रोक्तमीशपूजनमुत्तमम् ॥८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000650083, "chapter_id": 20650, "verse_number": "५-१०९-८४", "content_sanskrit": "अल्पायुश्च भवान्विप्र शिवपूजनमाचर ।\nत्रिकालं वा द्विकालं वा एककालमथापि वा ॥८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000650084, "chapter_id": 20650, "verse_number": "५-१०९-८५", "content_sanskrit": "यामं यामार्धमथवा शिवपूजनमाचर ।\nवानप्रस्थाश्रमो भूत्वा वानप्रस्थकृताश्रयः ॥८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000650085, "chapter_id": 20650, "verse_number": "५-१०९-८६", "content_sanskrit": "वानप्रस्थप्रसूनैश्च प्रातःपूजय शंकरम् ।\nश्रीफलैः शतपत्रैश्च पद्मसौगंधिकैरपि ॥८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000650086, "chapter_id": 20650, "verse_number": "५-१०९-८७", "content_sanskrit": "नीपैर्जपाभिः पुन्नागैः करवीरैश्च पाटलैः ।\nतुलस्याच रविदलैरपराजितया तथा ॥८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000650087, "chapter_id": 20650, "verse_number": "५-१०९-८८", "content_sanskrit": "अपामार्गदलै रुद्र जटादमनकेन च ।\nसर्वैरेभिः समफलैर्बिल्वपत्रैश्च धूर्तकैः ॥८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000650088, "chapter_id": 20650, "verse_number": "५-१०९-८९", "content_sanskrit": "द्रोणैः शिरीषैः शक्तैश्च दूर्वया कोरकैरपि ।\nनंद्यावर्तैरक्षतैश्च तिलमिश्रैश्च केवलैः ॥८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000650089, "chapter_id": 20650, "verse_number": "५-१०९-९०", "content_sanskrit": "अन्यैरपि यथाशक्ति प्रातः संपूजयेच्छिवम् ।\nकर्णिकारैश्च सौवर्णर्दूवर्ययापि शिवार्चनम् ॥९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000650090, "chapter_id": 20650, "verse_number": "५-१०९-९१", "content_sanskrit": "मुकुलैर्नार्चयेद्देवं चंपकैर्जलजं विना ।\nजलजानां च सर्वेषां पत्राणामक्षतस्य च ॥९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000650091, "chapter_id": 20650, "verse_number": "५-१०९-९२", "content_sanskrit": "कुशपुष्पस्य रजतसुवर्णकृतयोरपि ।\nअन्यत्कृत्वा यथा यत्तु तैलपक्वं भवेन्नृप ॥९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000650092, "chapter_id": 20650, "verse_number": "५-१०९-९३", "content_sanskrit": "न तत्पर्युषितं प्रोक्तमपूपादि गमिष्यति ।\nउक्षितं यत्फलायुक्तं तैलक्षाराम्लजीरकैः ॥९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000650093, "chapter_id": 20650, "verse_number": "५-१०९-९४", "content_sanskrit": "जले तत्प्रोक्षितं मूलफलशाकादिकं नृप ।\nन च पर्युषितं प्रोक्तं गंगातोयं च सागरम् ॥९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000650094, "chapter_id": 20650, "verse_number": "५-१०९-९५", "content_sanskrit": "महानदीजलं सर्वं केदारजलमेव च ।\nह्रदरूपेण यत्तीर्थं कूपतीर्थेन राघव ॥९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000650095, "chapter_id": 20650, "verse_number": "५-१०९-९६", "content_sanskrit": "तडागवापीसरसां कूपेनापां च यद्भवेत् ।\nतत्तीर्थतोयं सर्वं च न च पर्युषितं भवेत् ॥९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000650096, "chapter_id": 20650, "verse_number": "५-१०९-९७", "content_sanskrit": "न रात्रौ जलमाहार्यं दिवा संपादयेज्जलम् ।\nससैकतं तथा धार्यं न च पर्युषितं हि तत् ॥९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000650097, "chapter_id": 20650, "verse_number": "५-१०९-९८", "content_sanskrit": "एवं विदित्वा पूजां त्वं शिवलिंगे समाचर ।\nशंभुरुवाच ।\nएवमुक्तोथ मुनिना इक्ष्वाकुर्ब्राह्मणप्रियः ॥९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000650098, "chapter_id": 20650, "verse_number": "५-१०९-९९", "content_sanskrit": "शिवपूजापरो भूत्वा दिनाष्टकमतिष्ठत ।\nनवमेऽथ दिने प्राप्ते प्रातःकाले कृतार्चनः ॥९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000650099, "chapter_id": 20650, "verse_number": "५-१०९-१००", "content_sanskrit": "मरणावसरे प्राप्ते शिवपूजां विधाय सः ।\nस्वान्प्राणानुपहाराय तत्याजैव महेशितुः ॥१०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000650100, "chapter_id": 20650, "verse_number": "५-१०९-१०१", "content_sanskrit": "मृतं तमथ विज्ञाय यमदूताः समागताः ।\nयमलोकप्रापका ये यतमास्थाय तस्थिरे ॥१०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000650101, "chapter_id": 20650, "verse_number": "५-१०९-१०२", "content_sanskrit": "शैवाश्चापि समायाता दूता वह्निमुखादयः ।\nतेषामन्योन्यवादोभून्मामको मामकस्त्विति ॥१०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000650102, "chapter_id": 20650, "verse_number": "५-१०९-१०३", "content_sanskrit": "अथ यामः पाशपाणिः शिवदूतमथार्दयत् ।\nअथ वह्निमुखः क्रुद्धो यमदूतशतं ततः ॥१०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000650103, "chapter_id": 20650, "verse_number": "५-१०९-१०४", "content_sanskrit": "महाकायस्तथा भूत्वा गृहीत्वा च करेण तत् ।\nशिरांसि च तथैकेनापीड्य चिच्छेद शष्पवत् ॥१०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000650104, "chapter_id": 20650, "verse_number": "५-१०९-१०५", "content_sanskrit": "मारयित्वा ततो दूतानादायेक्ष्वाकुमभ्यगात् ।\nनिवेदयामास च तं वीरभद्राय धीमते ॥१०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000650105, "chapter_id": 20650, "verse_number": "५-१०९-१०६", "content_sanskrit": "स चापि शंकरायाथ तं प्राह च महेश्वरः ।\nत्वयाष्टदिनपूजैव कृता कृष्णा दिने दिने ॥१०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000650106, "chapter_id": 20650, "verse_number": "५-१०९-१०७", "content_sanskrit": "त्वमनिंदः पुरा मां च लिंगं शिश्नाग्रमित्युत ।\nतेनैव पापयोगेन शिश्नवक्त्रो भविष्यसि ॥१०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000650107, "chapter_id": 20650, "verse_number": "५-१०९-१०८", "content_sanskrit": "शिश्नाग्रे विवरं चक्रं जिह्वानासादिवर्जितः ।\nपूर्वं मन्नामवक्तृत्वाद्वक्ता चापि भविष्यसि ॥१०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000650108, "chapter_id": 20650, "verse_number": "५-१०९-१०९", "content_sanskrit": "अथेशवचनात्सोपि तथाभूतोभवत्क्षणात् ।\nशंभुरुवाच ।\nय इदं शृणुयान्नित्यं पुराणाख्यानमुत्तमम् ॥१०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000650109, "chapter_id": 20650, "verse_number": "५-१०९-११०", "content_sanskrit": "विमुक्तपापबंधश्च शिवभक्तो भविष्यति ।\nस याति च शिवस्थाने वक्ता चापि तथा भवेत् ॥११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000650110, "chapter_id": 20650, "verse_number": "५-१०९-१११", "content_sanskrit": "यश्च वक्ति कथामेनां हरेण सदृशो भवेत् ।\nउक्त्वा कथामिमां पूर्वमधीरो नाम भूमिपः ॥१११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000650111, "chapter_id": 20650, "verse_number": "५-१०९-११२", "content_sanskrit": "स्वर्गं स गतवान्राजा कृतपापोथ भार्यया ॥११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}]