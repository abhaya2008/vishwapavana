[{"id": 2197807, "chapter_id": 5204, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2197808, "chapter_id": 5204, "verse_number": "१", "content_sanskrit": "इदं मे तत्त्वतो राजन् वक्तुमर्हसि भारत ।\nअहिंसयित्वा केनेह ब्रह्महत्या विधीयते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2197809, "chapter_id": 5204, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2197810, "chapter_id": 5204, "verse_number": "२", "content_sanskrit": "व्यासमामन्त्र्य राजेन्द्र पुरा यत् पृष्टवानहम् ।\nतत् तेऽहं सम्प्रवक्ष्यामि तदिहैकमनाः शृणु\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2197811, "chapter_id": 5204, "verse_number": "३", "content_sanskrit": "चतुर्थस्त्वं वसिष्ठस्य तत्त्वमाख्याहि मे मुने ।\nअहिंसयित्वा केनेह ब्रह्महत्या विधीयते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2197812, "chapter_id": 5204, "verse_number": "समाप्तिः", "content_sanskrit": "इति पृष्टो महाराज पराशरशरीरजः ।\nअब्रवीन्निपुणो धर्मे निःसंशयमनुत्तमम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2197813, "chapter_id": 5204, "verse_number": "५", "content_sanskrit": "ब्राह्मणं स्वयमाहूय भिक्षार्थे कृशवृत्तिनम् ।\nब्रूयान्नास्तीति यः पश्चात् तं विद्याद् ब्रह्मघातिनम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2197814, "chapter_id": 5204, "verse_number": "६", "content_sanskrit": "मध्यस्थस्येह विप्रस्य योऽनूचानस्य भारत ।\nवृत्तिं हरति दुर्बुद्धिस्तं विद्याद् ब्रह्मघातिनम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2197815, "chapter_id": 5204, "verse_number": "७", "content_sanskrit": "गोकुलस्य तृषार्तस्य जलार्थे वसुधाधिप ।\nउत्पादयति यो विघ्नं तं विद्याद् ब्रह्मघातिनम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2197816, "chapter_id": 5204, "verse_number": "८", "content_sanskrit": "यः प्रवृत्तां श्रुतिं सम्यक् शास्त्रं वा मुनिभिः कृतम् ।\nदूषयत्यनभिज्ञाय तं विद्याद् ब्रह्मघातिनम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2197817, "chapter_id": 5204, "verse_number": "९", "content_sanskrit": "आत्मजां रूपसम्पन्नां महतीं सदृशे वरे ।\nन प्रयच्छति यः कन्यां तं विद्याद् ब्रह्मघातिनम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2197818, "chapter_id": 5204, "verse_number": "१०", "content_sanskrit": "अधर्मनिरतो मूढो मिथ्या यो वै द्विजातिषु ।\nदद्यान्मर्मातिगं शोकं तं विद्याद् ब्रह्मघातिनम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2197819, "chapter_id": 5204, "verse_number": "११", "content_sanskrit": "चक्षुषा विप्रहीनस्य पङ्गुलस्य जडस्य वा ।\nहरेत यो वै सर्वस्वं तं विद्याद् ब्रह्मघातिनम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2197820, "chapter_id": 5204, "verse_number": "१२", "content_sanskrit": "आश्रमे वा वने वा यो ग्रामे वा यदि वा पुरे ।\nअग्निं समुत्सृजेन्मोहात् तं विद्याद् ब्रह्मघातिनम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2197821, "chapter_id": 5204, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे ब्रह्महत्याकथनं नाम पञ्चपञ्चाशोऽध्यायः ॥ ५५॥\n* * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]