[{"id": 2007827, "chapter_id": 1151, "verse_number": "१-१५२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2007828, "chapter_id": 1151, "verse_number": "१-१५२-१", "content_sanskrit": "प्राणाधिकं भीमसेनं कृतविद्यं धनञ्जयम्।\nदुर्योधनो लक्षयित्वा पर्यतप्यत दुर्मनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2007829, "chapter_id": 1151, "verse_number": "१-१५२-२", "content_sanskrit": "ततो वैकर्तनः कर्णः शकुनिश्चापि सौबलः।\nअनेकारभ्युपायैस्ते जिघांसन्ति स्म पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2007830, "chapter_id": 1151, "verse_number": "१-१५२-३", "content_sanskrit": "पाण्डवा अपि तत्सर्वं प्रतिचक्रुर्यथाबलम्।\nउद्भावनमकुर्वन्तो विदुरस्य मते स्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2007831, "chapter_id": 1151, "verse_number": "१-१५२-४", "content_sanskrit": "गुणैः समुदितान्दृष्ट्वा पौराः पाण्डुसुतांस्तदा।\nकथयाञ्चक्रिरे तेषां गुणान्संसत्सु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2007832, "chapter_id": 1151, "verse_number": "१-१५२-५", "content_sanskrit": "राज्यप्राप्तिं च संप्राप्तं ज्येष्ठं पाण्डुसुतं तदा।\nकथयन्ति स्म संभूय चत्वरेषु सभासु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2007833, "chapter_id": 1151, "verse_number": "१-१५२-६", "content_sanskrit": "प्रज्ञाश्चक्षुरचक्षुष्ट्वाद्धृतराष्ट्रो जनेश्वरः।\nराज्यं न प्राप्तवान्पूर्वं स कथं नृपतिर्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2007834, "chapter_id": 1151, "verse_number": "१-१५२-७", "content_sanskrit": "तथा शान्तनवो भीष्मः सत्यसन्धो महाव्रतः।\nप्रत्याख्याय पुरा राज्यं न स जातु ग्रहीष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2007835, "chapter_id": 1151, "verse_number": "१-१५२-८", "content_sanskrit": "ते वयं पाण्डवज्येष्ठं तरुणं वृद्धशीलिनम्।\nअभिषिञ्चाम साध्वद्य सत्यकारुण्यवेदिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2007836, "chapter_id": 1151, "verse_number": "१-१५२-९", "content_sanskrit": "स हि भीष्मं शान्तनवं धृतराष्ट्रं च धर्मवित्।\nसपुत्रं विविधैर्भोगैर्योजयिष्यति पूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2007837, "chapter_id": 1151, "verse_number": "१-१५२-१०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2007838, "chapter_id": 1151, "verse_number": "१-१५२-१०", "content_sanskrit": "तेषां दुर्योधनः श्रुत्वा तानि वाक्यानि जल्पताम्।\nयुधिष्ठिरानुरक्तानां पर्यतप्यत दुर्मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2007839, "chapter_id": 1151, "verse_number": "१-१५२-११", "content_sanskrit": "स तप्यमानो दुष्टात्मा तेषां वाचो न चक्षमे।\nईर्ष्यया चापि संतप्तो धृतराष्ट्रमुपागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2007840, "chapter_id": 1151, "verse_number": "१-१५२-१२", "content_sanskrit": "ततो विरहितं दृष्ट्वा पितरं प्रतिपूज्य सः।\nपौरानुरागसंतप्तः पश्चादिदमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2007841, "chapter_id": 1151, "verse_number": "१-१५२-१३", "content_sanskrit": "श्रुता मे जल्पतां तात पौराणामशिवा गिरः।\nत्वामनादृत्य भीष्मं च पतिमिच्छन्ति पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2007842, "chapter_id": 1151, "verse_number": "१-१५२-१४", "content_sanskrit": "मतमेतच्च भीष्मस्य न स राज्यं बुभुक्षति।\nअस्माकं तु परां पीडां चिकीर्षन्ति पुरे जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2007843, "chapter_id": 1151, "verse_number": "१-१५२-१५", "content_sanskrit": "पितृतः प्राप्तवान्राज्यं पाण्डुरात्मगुणैः पुरा।\nत्वमन्धगुणसंयोगात्प्राप्तं राज्यं न लब्धवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2007844, "chapter_id": 1151, "verse_number": "१-१५२-१६", "content_sanskrit": "स एष पाण्डोर्दायाद्यं यदि प्राप्नोति पाण्डवः।\nतस्य पुत्रो ध्रुवं प्राप्तस्तस्य तस्यापि चापरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2007845, "chapter_id": 1151, "verse_number": "१-१५२-१७", "content_sanskrit": "ते वयं राजवंशेन हीनाः सह सुतैरपि।\nअवज्ञाता भविष्यामो लोकस्य जगतीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2007846, "chapter_id": 1151, "verse_number": "१-१५२-१८", "content_sanskrit": "सततं निरयं प्राप्ताः परपिण्डोपजीविनः।\nन भवेम यथा राजंस्तथा नीतिर्विधीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2007847, "chapter_id": 1151, "verse_number": "१-१५२-१९", "content_sanskrit": "यदि त्वं हि पुरा राजन्निदं राज्यमवाप्तवान्।\nध्रुवं प्राप्स्याम च वयं राज्यमप्यवशे जने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2007848, "chapter_id": 1151, "verse_number": "१-१५२-२०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2007849, "chapter_id": 1151, "verse_number": "१-१५२-२०", "content_sanskrit": "धृतराष्ट्रस्तु पुत्रस्य श्रुत्वा वचनमीदृशम्।\nमुहूर्तमिव संचिन्त्य दुर्योधनमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2007850, "chapter_id": 1151, "verse_number": "१-१५२-२१", "content_sanskrit": "धर्मनित्यस्तथा पाण्डुः सुप्रीतो मयि कौरवः।\nसर्वेषु ज्ञातिषु तथा मदीयेषु विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2007851, "chapter_id": 1151, "verse_number": "१-१५२-२२", "content_sanskrit": "नात्र किंचन जानाति भोजनादि चिकीर्षितम्।\nनिवेदयति तत्सर्वं मयि धर्मभृतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2007852, "chapter_id": 1151, "verse_number": "१-१५२-२३", "content_sanskrit": "तस्य पुत्रो यथा पाण्डुस्तथा धर्मपरः सदा।\nगुणावाँल्लोकविख्यातो नगरे च प्रतिष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2007853, "chapter_id": 1151, "verse_number": "१-१५२-२४", "content_sanskrit": "स कथं शक्यतेऽस्माभिरपाक्रष्टुं नरर्षभः।\nराज्यमेष हि नः प्राप्तः ससहयो विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2007854, "chapter_id": 1151, "verse_number": "१-१५२-२५", "content_sanskrit": "भृता हि पाण्डुनाऽमात्या बलं च सततं मतम्।\nधृताः पुत्राश्च पौत्राश्च तेषामपि विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2007855, "chapter_id": 1151, "verse_number": "१-१५२-२६", "content_sanskrit": "ते तथा संस्तुतास्तात विषये पाण्डुना नराः।\nकथं युधिष्ठिरस्यार्थे न नो हन्युः सबान्धवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2007856, "chapter_id": 1151, "verse_number": "१-१५२-२७", "content_sanskrit": "नैते विषयमिच्छेयुर्धर्मत्यागे विशेषतः।\nते वयं कौरवेन्द्राणामेतेषां च महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2007857, "chapter_id": 1151, "verse_number": "१-१५२-२८", "content_sanskrit": "कथं न वाच्यतां तात गच्छेम जगतस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2007858, "chapter_id": 1151, "verse_number": "१-१५२-२९x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2007859, "chapter_id": 1151, "verse_number": "१-१५२-२९", "content_sanskrit": "मध्यस्थः सततं भीष्मो द्रोणपुत्रो मयि स्थितः।\nयतः पुतस्ततो द्रोणो भविता नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2007860, "chapter_id": 1151, "verse_number": "१-१५२-३०", "content_sanskrit": "कृपः शारद्वतश्चैव यत एव वयं ततः।\nबागिनेयं ततो द्रौणिं न त्यक्ष्यति कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2007861, "chapter_id": 1151, "verse_number": "१-१५२-३१", "content_sanskrit": "क्षत्ता तु बन्धुरस्माकं प्रच्छन्नस्तु ततः परैः।\nन चैकः स समर्थोऽस्मान्पाण्डवार्थे प्रबाधितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2007862, "chapter_id": 1151, "verse_number": "१-१५२-३२", "content_sanskrit": "सुविस्रब्धान्पाण्डुसुतान्सह मात्रा विवासय।\nवारणावतमद्यैव नात्र दोषो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2007863, "chapter_id": 1151, "verse_number": "१-१५२-३३", "content_sanskrit": "विनिद्राकरणं घोरं हृदि शल्यमिवार्पितम्।\nशोपकपावकमुद्धूतं कर्मणानेन नाशय॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2007864, "chapter_id": 1151, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि द्विपञ्चाशदधिकशततमोऽध्यायः॥ १५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]