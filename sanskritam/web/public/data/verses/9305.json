[{"id": 40019204, "chapter_id": 9305, "verse_number": "1", "content_sanskrit": "स उवाचमहाप्रामस्सोऽभिवाद्यप्लवङ्गमः । रामंवचनमर्थज्ञोवरंसर्वधनुष्मताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40019205, "chapter_id": 9305, "verse_number": "2", "content_sanskrit": "यन्निमित्तोऽयमारम्बःकर्मणांयःफलोदयः । तांदेवींशोकसन्तप्तांद्रष्टुमर्हसिमैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40019206, "chapter_id": 9305, "verse_number": "3", "content_sanskrit": "साहिशोकसमाविष्टाबाष्पपर्याकुलेक्षणा । मैथिलीविजयंश्रुत्वाद्रष्टुंत्वामभिकाङ्क्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40019207, "chapter_id": 9305, "verse_number": "4", "content_sanskrit": "पूर्वकात्प्रत्ययाच्चाहमुक्तोविश्वस्तयातया । भर्तारंद्रष्टुमिच्छामिकृतार्थंसहलक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40019208, "chapter_id": 9305, "verse_number": "5", "content_sanskrit": "एवमुक्तोहनुमतारामोधर्मभृतांवरः । आगच्छत्सहसाध्यानमीषद्भाष्पपरिप्लुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40019209, "chapter_id": 9305, "verse_number": "6", "content_sanskrit": "दीर्घमुष्णंविनिःश्वस्यजगतीमवलोकयन् । उवाचमेघसङ्काशंविभीषणमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40019210, "chapter_id": 9305, "verse_number": "7", "content_sanskrit": "दिव्याङ्गरागांवैदेहींदिव्याभरणभूषिताम् । इहसीतांशिरःस्नातामुपस्थापयमाचिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40019211, "chapter_id": 9305, "verse_number": "8", "content_sanskrit": "एवमुक्तस्तुरामेणत्वरमाणोविभीषणः । प्रविश्यान्तःपुरंसीतांस्त्रीभिस्स्वाभिरोचदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40019212, "chapter_id": 9305, "verse_number": "9", "content_sanskrit": "ततस्सीतांमहाभागांदृष्टवोवाचविभीषणः । मूर्ध्निबद्धाञ्जलिश्रीमान्विनीतोराक्षसेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40019213, "chapter_id": 9305, "verse_number": "10", "content_sanskrit": "दिव्याङ्गरागावैदेहीदिव्याभरणभूषिता । यानमारोहभद्रंतेभर्तात्वांद्रष्टुमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40019214, "chapter_id": 9305, "verse_number": "11", "content_sanskrit": "एवमुक्तातुवैदेहीप्रत्युवाचविभीषणम् । अस्नात्वाद्रष्टुमिच्छामिभर्तारंराक्षसेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40019215, "chapter_id": 9305, "verse_number": "12", "content_sanskrit": "तस्यास्तद्वचनंश्रुत्वाप्रत्युवाचविभीषणः । यथाहरामोभहर्तातेतत्तथाकर्तुमार्हसिमार्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40019216, "chapter_id": 9305, "verse_number": "13", "content_sanskrit": "तस्यतद्वचनंश्रुत्वामैथिलीपतिदेवता । भर्तृभक्त्यावृतासाध्वीतथेतिप्रत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40019217, "chapter_id": 9305, "verse_number": "14", "content_sanskrit": "ततस्सीतांशिरःस्नातांसंयुक्तांप्रतिकर्मणा । महार्हाभरणोपेतांमहार्हाम्बरधारिणीम् ॥ आरोप्यशिबिकांदीप्तांपरार्घ्याम्बरसम्वृताम् । राक्षसैर्भहुभिर्गुप्तामाजहारविभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40019218, "chapter_id": 9305, "verse_number": "15", "content_sanskrit": "ततस्सीतांशिरःस्नातांसंयुक्तांप्रतिकर्मणा । महार्हाभरणोपेतांमहार्हाम्बरधारिणीम् ॥ आरोप्यशिबिकांदीप्तांपरार्घ्याम्बरसम्वृताम् । राक्षसैर्भहुभिर्गुप्तामाजहारविभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40019219, "chapter_id": 9305, "verse_number": "16", "content_sanskrit": "सोऽभिगम्यमहात्मानंज्ञातावपिध्यानमास्थितम् । प्रणतश्चप्रहृष्टश्चप्राप्तांसीतांन्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40019220, "chapter_id": 9305, "verse_number": "17", "content_sanskrit": "तामागतामुपश्रुत्यरक्षोगृहचिरोषिताम् । हर्षोदैन्यंच रोषश्चत्रयंराघवमाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40019221, "chapter_id": 9305, "verse_number": "18", "content_sanskrit": "ततःपार्श्वगतंदृष्टवासविमर्शंविचारयन् । विभीषणमिदंवाक्यमहृष्टोराघवोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40019222, "chapter_id": 9305, "verse_number": "19", "content_sanskrit": "राक्षसाधिपतेसौम्यनित्यंमद्विजयेरत । वैदेहीसंनिकर्षंमेशीघ्रंसमुपगच्छतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40019223, "chapter_id": 9305, "verse_number": "20", "content_sanskrit": "तस्यतद्वचनंश्रुत्वाराघवस्यविभीषणः । तूर्णमुत्सारणंतत्रकारयामासधर्मवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40019224, "chapter_id": 9305, "verse_number": "21", "content_sanskrit": "कञ्चुकोष्णीषिणस्तत्रवेत्रजर्जरपाणयः । उत्सारयन्तस्तान्योधान्समन्तात् परिचक्रमुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40019225, "chapter_id": 9305, "verse_number": "22", "content_sanskrit": "ऋक्षाणांवानराणां च राक्षसानां च सर्वशः । वृन्दान्युत्सार्यमाणानिदूरमुत्तस्थुरन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40019226, "chapter_id": 9305, "verse_number": "23", "content_sanskrit": "तेषामुत्सार्यमाणानांनिःस्वनःसुमहानभूत् । वायुनोद्धूयामानस्यसागरस्येवनिःस्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40019227, "chapter_id": 9305, "verse_number": "24", "content_sanskrit": "उत्सार्यमाणान् दृष्टवाथजगत्यांजातसम्भ्रमान् । दाक्षिण्यात्तदमर्षाच्चवारयामासराघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40019228, "chapter_id": 9305, "verse_number": "25", "content_sanskrit": "संरम्बश्चाब्रवीद्रामश्चक्षुषाप्रदहन्निव । विभीषणंमहाप्राज्ञंसोपालम्बमिदंवचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40019229, "chapter_id": 9305, "verse_number": "26", "content_sanskrit": "किमर्थंमामनादृत्यक्लिश्यतेऽयंत्वयाजनः । निवर्तयैनमुद्योगंजनोऽयंस्वजनोमम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40019230, "chapter_id": 9305, "verse_number": "27", "content_sanskrit": "न गृहाणि न वस्त्राणि न प्राकारास्तिरस्क्रिया । नेदृशाराजसत्कारावृत्तमावरणंस्त्रियाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40019231, "chapter_id": 9305, "verse_number": "28", "content_sanskrit": "व्यसनेषु न कृच्छ्रेषु न युद्धेषुस्वयंवरे । न क्रतौनोविवाहेवादर्शनंदूष्यतेस्त्रियाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40019232, "chapter_id": 9305, "verse_number": "29", "content_sanskrit": "सैषाविपद्गताचैवकृच्छ्रेव च महतिस्थिता । दर्शनेनास्तिदोषोऽस्यामत्समीपेविशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40019233, "chapter_id": 9305, "verse_number": "30", "content_sanskrit": "विसृज्यशिबिकांतस्मात्पद्भ्यामेवोपसर्पतु । समीपेममवैदेहींपश्यन्त्वेतेवनौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40019234, "chapter_id": 9305, "verse_number": "31", "content_sanskrit": "एवमुक्तस्तुरामेणसविमर्शोविभीषणम् । रामस्योपानयसतीतांसन्निकर्षंविनीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40019235, "chapter_id": 9305, "verse_number": "32", "content_sanskrit": "ततोलक्ष्मणसुग्रीवौहनूमांश्चप्लवङ्गमः । निशम्यवाक्यंरामस्यबभूवुर्व्यथिताभृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40019236, "chapter_id": 9305, "verse_number": "33", "content_sanskrit": "कलत्रनिरपेक्ष्षैश्चइङ्गितैरस्यदारुणैः । अप्रीतमिवसीतायांतर्कयन्तिस्मराघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40019237, "chapter_id": 9305, "verse_number": "34", "content_sanskrit": "लज्जयात्ववलीयन्तीस्वेषुगात्रेषुमैथिली । विभीषणेनानुगताभर्तारंसाभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40019238, "chapter_id": 9305, "verse_number": "35", "content_sanskrit": "विस्मयाच्छप्रहर्षाच्चस्नेहाच्चपतिदेवता । उदैक्षतमुखंभर्तुःसौम्यंसौम्यतरानना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]