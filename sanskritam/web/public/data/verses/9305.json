[{"id": 5000305000, "chapter_id": 9305, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे त्रयस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000305001, "chapter_id": 9305, "verse_number": "४-३३-१", "content_sanskrit": "अथ प्रतिसमादिष्टो लक्ष्मणः परवीरहा।\nप्रविवेश गुहां रम्यां किष्किन्धां रामशासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000305002, "chapter_id": 9305, "verse_number": "४-३३-२", "content_sanskrit": "द्वारस्था हरयस्तत्र महाकाया महाबलाः।\nबभूवुर्लक्ष्मणं दृष्ट्वा सर्वे प्राञ्जलयः स्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000305003, "chapter_id": 9305, "verse_number": "४-३३-३", "content_sanskrit": "निःश्वसन्तं तु तं दृष्ट्वा क्रुद्धं दशरथात्मजम्।\nबभूवुर्हरयस्त्रस्ता न चैनं पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000305004, "chapter_id": 9305, "verse_number": "४-३३-४", "content_sanskrit": "स तां रत्नमयीं दिव्यां श्रीमान् पुष्पितकाननाम्।\nरम्यां रत्नसमाकीर्णां ददर्श महतीं गुहाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000305005, "chapter_id": 9305, "verse_number": "४-३३-५", "content_sanskrit": "हर्म्यप्रासादसम्बाधां नानारत्नोपशोभिताम्।\nसर्वकामफलैर्वृक्षैः पुष्पितैरुपशोभिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000305006, "chapter_id": 9305, "verse_number": "४-३३-६", "content_sanskrit": "देवगन्धर्वपुत्रैश्च वानरैः कामरूपिभिः।\nदिव्यमाल्याम्बरधरैः शोभितां प्रियदर्शनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000305007, "chapter_id": 9305, "verse_number": "४-३३-७", "content_sanskrit": "चन्दनागुरुपद्मानां गन्धैः सुरभिगन्धिताम्।\nमैरेयाणां मधूनां च सम्मोदितमहापथाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000305008, "chapter_id": 9305, "verse_number": "४-३३-८", "content_sanskrit": "विन्ध्यमेरुगिरिप्रख्यैः प्रासादैर्नैकभूमिभिः।\nददर्श गिरिनद्यश्च विमलास्तत्र राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000305009, "chapter_id": 9305, "verse_number": "४-३३-९", "content_sanskrit": "अङ्गदस्य गृहं रम्यं मैन्दस्य द्विविदस्य च।\nगवयस्य गवाक्षस्य गजस्य शरभस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000305010, "chapter_id": 9305, "verse_number": "४-३३-१०", "content_sanskrit": "विद्युन्मालेश्च सम्पातेः सूर्याक्षस्य हनूमतः।\nवीरबाहोः सुबाहोश्च नलस्य च महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000305011, "chapter_id": 9305, "verse_number": "४-३३-११", "content_sanskrit": "कुमुदस्य सुषेणस्य तारजाम्बवतोस्तथा।\nदधिवक्त्रस्य नीलस्य सुपाटलसुनेत्रयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000305012, "chapter_id": 9305, "verse_number": "४-३३-१२", "content_sanskrit": "एतेषां कपिमुख्यानां राजमार्गे महात्मनाम्।\nददर्श गृहमुख्यानि महासाराणि लक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000305013, "chapter_id": 9305, "verse_number": "४-३३-१३", "content_sanskrit": "पाण्डुराभ्रप्रकाशानि गन्धमाल्ययुतानि च।\nप्रभूतधनधान्यानि स्त्रीरत्नैः शोभितानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000305014, "chapter_id": 9305, "verse_number": "४-३३-१४", "content_sanskrit": "पाण्डुरेण तु शैलेन परिक्षिप्तं दुरासदम्।\nवानरेन्द्रगृहं रम्यं महेन्द्रसदनोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000305015, "chapter_id": 9305, "verse_number": "४-३३-१५", "content_sanskrit": "शुक्लैः प्रासादशिखरैः कैलासशिखरोपमैः।\nसर्वकामफलैर्वृक्षैः पुष्पितैरुपशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000305016, "chapter_id": 9305, "verse_number": "४-३३-१६", "content_sanskrit": "महेन्द्रदत्तैः श्रीमद्भिर्नीलजीमूतसंनिभैः।\nदिव्यपुष्पफलैर्वृक्षैः शीतच्छायैर्मनोरमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000305017, "chapter_id": 9305, "verse_number": "४-३३-१७", "content_sanskrit": "हरिभिः संवृतद्वारं बलिभिः शस्त्रपाणिभिः।\nदिव्यमाल्यावृतं शुभ्रं तप्तकाञ्चनतोरणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000305018, "chapter_id": 9305, "verse_number": "४-३३-१८", "content_sanskrit": "सुग्रीवस्य गृहं रम्यं प्रविवेश महाबलः।\nअवार्यमाणः सौमित्रिर्महाभ्रमिव भास्करः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000305019, "chapter_id": 9305, "verse_number": "४-३३-१९", "content_sanskrit": "स सप्त कक्ष्या धर्मात्मा यानासनसमावृताः।\nददर्श सुमहद‍्गुप्तं ददर्शान्तःपुरं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000305020, "chapter_id": 9305, "verse_number": "४-३३-२०", "content_sanskrit": "हैमराजतपर्यङ्कैर्बहुभिश्च वरासनैः।\nमहार्हास्तरणोपेतैस्तत्र तत्र समावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000305021, "chapter_id": 9305, "verse_number": "४-३३-२१", "content_sanskrit": "प्रविशन्नेव सततं शुश्राव मधुरस्वनम्।\nतन्त्रीगीतसमाकीर्णं समतालपदाक्षरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000305022, "chapter_id": 9305, "verse_number": "४-३३-२२", "content_sanskrit": "बह्वीश्च विविधाकारा रूपयौवनगर्विताः।\nस्त्रियः सुग्रीवभवने ददर्श स महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000305023, "chapter_id": 9305, "verse_number": "४-३३-२३", "content_sanskrit": "दृष्ट्वाभिजनसम्पन्नास्तत्र माल्यकृतस्रजः।\nवरमाल्यकृतव्यग्रा भूषणोत्तमभूषिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000305024, "chapter_id": 9305, "verse_number": "४-३३-२४", "content_sanskrit": "नातृप्तान् नाति चाव्यग्रान् नानुदात्तपरिच्छदान्।\nसुग्रीवानुचरांश्चापि लक्षयामास लक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000305025, "chapter_id": 9305, "verse_number": "४-३३-२५", "content_sanskrit": "कूजितं नूपुराणां च काञ्चीनां निःस्वनं तथा।\nस निशम्य ततः श्रीमान् सौमित्रिर्लज्जितोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000305026, "chapter_id": 9305, "verse_number": "४-३३-२६", "content_sanskrit": "रोषवेगप्रकुपितः श्रुत्वा चाभरणस्वनम्।\nचकार ज्यास्वनं वीरो दिशः शब्देन पूरयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000305027, "chapter_id": 9305, "verse_number": "४-३३-२७", "content_sanskrit": "चारित्रेण महाबाहुरपकृष्टः स लक्ष्मणः।\nतस्थावेकान्तमाश्रित्य रामकोपसमन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000305028, "chapter_id": 9305, "verse_number": "४-३३-२८", "content_sanskrit": "तेन चापस्वनेनाथ सुग्रीवः प्लवगाधिपः।\nविज्ञायागमनं त्रस्तः स चचाल वरासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000305029, "chapter_id": 9305, "verse_number": "४-३३-२९", "content_sanskrit": "अङ्गदेन यथा मह्यं पुरस्तात् प्रतिवेदितम्।\nसुव्यक्तमेष सम्प्राप्तः सौमित्रिर्भ्रातृवत्सलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000305030, "chapter_id": 9305, "verse_number": "४-३३-३०", "content_sanskrit": "अङ्गदेन समाख्यातो ज्यास्वनेन च वानरः।\nबुबुधे लक्ष्मणं प्राप्तं मुखं चास्य व्यशुष्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000305031, "chapter_id": 9305, "verse_number": "४-३३-३१", "content_sanskrit": "ततस्तारां हरिश्रेष्ठः सुग्रीवः प्रियदर्शनाम्।\nउवाच हितमव्यग्रस्त्राससम्भ्रान्तमानसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000305032, "chapter_id": 9305, "verse_number": "४-३३-३२", "content_sanskrit": "किं नु रुट्कारणं सुभ्रु प्रकृत्या मृदुमानसः।\nसरोष इव सम्प्राप्तो येनायं राघवानुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000305033, "chapter_id": 9305, "verse_number": "४-३३-३३", "content_sanskrit": "किं पश्यसि कुमारस्य रोषस्थानमनिन्दिते।\nन खल्वकारणे कोपमाहरेन्नरपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000305034, "chapter_id": 9305, "verse_number": "४-३३-३४", "content_sanskrit": "यद्यस्य कृतमस्माभिर्बुध्यसे किंचिदप्रियम्।\nतद‍्बुद‍्ध्या सम्प्रधार्याशु क्षिप्रमेवाभिधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000305035, "chapter_id": 9305, "verse_number": "४-३३-३५", "content_sanskrit": "अथवा स्वयमेवैनं द्रष्टुमर्हसि भामिनि।\nवचनैः सान्त्वयुक्तैश्च प्रसादयितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000305036, "chapter_id": 9305, "verse_number": "४-३३-३६", "content_sanskrit": "त्वद्दर्शने विशुद्धात्मा न स्म कोपं करिष्यति।\nनहि स्त्रीषु महात्मानः क्वचित् कुर्वन्ति दारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000305037, "chapter_id": 9305, "verse_number": "४-३३-३७", "content_sanskrit": "त्वया सान्त्वैरुपक्रान्तं प्रसन्नेन्द्रियमानसम्।\nततः कमलपत्राक्षं द्रक्ष्याम्यहमरिंदमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000305038, "chapter_id": 9305, "verse_number": "४-३३-३८", "content_sanskrit": "सा प्रस्खलन्ती मदविह्वलाक्षी\nप्रलम्बकाञ्चीगुणहेमसूत्रा।\nसलक्षणा लक्ष्मणसंनिधानं\nजगाम तारा नमिताङ्गयष्टिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000305039, "chapter_id": 9305, "verse_number": "४-३३-३९", "content_sanskrit": "स तां समीक्ष्यैव हरीशपत्नीं\nतस्थावुदासीनतया महात्मा।\nअवाङ्मुखोऽभून्मनुजेन्द्रपुत्रः\nस्त्रीसंनिकर्षाद् विनिवृत्तकोपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000305040, "chapter_id": 9305, "verse_number": "४-३३-४०", "content_sanskrit": "सा पानयोगाच्च निवृत्तलज्जा\nदृष्टिप्रसादाच्च नरेन्द्रसूनोः।\nउवाच तारा प्रणयप्रगल्भं\nवाक्यं महार्थं परिसान्त्वरूपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000305041, "chapter_id": 9305, "verse_number": "४-३३-४१", "content_sanskrit": "किं कोपमूलं मनुजेन्द्रपुत्र\nकस्ते न संतिष्ठति वाङ्‍‍निदेशे।\nकः शुष्कवृक्षं वनमापतन्तं\nदावाग्निमासीदति निर्विशङ्कः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000305042, "chapter_id": 9305, "verse_number": "४-३३-४२", "content_sanskrit": "स तस्या वचनं श्रुत्वा सान्त्वपूर्वमशङ्कितः।\nभूयः प्रणयदृष्टार्थं लक्ष्मणो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000305043, "chapter_id": 9305, "verse_number": "४-३३-४३", "content_sanskrit": "किमयं कामवृत्तस्ते लुप्तधर्मार्थसंग्रहः।\nभर्ता भर्तृहिते युक्ते न चैनमवबुध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000305044, "chapter_id": 9305, "verse_number": "४-३३-४४", "content_sanskrit": "न चिन्तयति राज्यार्थं सोऽस्मान् शोकपरायणान्।\nसामात्यपरिषत् तारे काममेवोपसेवते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000305045, "chapter_id": 9305, "verse_number": "४-३३-४५", "content_sanskrit": "स मासांश्चतुरः कृत्वा प्रमाणं प्लवगेश्वरः।\nव्यतीतांस्तान् मदोदग्रो विहरन् नावबुध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000305046, "chapter_id": 9305, "verse_number": "४-३३-४६", "content_sanskrit": "नहि धर्मार्थसिद्ध्यर्थं पानमेवं प्रशस्यते।\nपानादर्थश्च कामश्च धर्मश्च परिहीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000305047, "chapter_id": 9305, "verse_number": "४-३३-४७", "content_sanskrit": "धर्मलोपो महांस्तावत् कृते ह्यप्रतिकुर्वतः।\nअर्थलोपश्च मित्रस्य नाशे गुणवतो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000305048, "chapter_id": 9305, "verse_number": "४-३३-४८", "content_sanskrit": "मित्रं ह्यर्थगुणश्रेष्ठं सत्यधर्मपरायणम्।\nतद‍्द्वयं तु परित्यक्तं न तु धर्मे व्यवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000305049, "chapter_id": 9305, "verse_number": "४-३३-४९", "content_sanskrit": "तदेवं प्रस्तुते कार्ये कार्यमस्माभिरुत्तरम्।\nतत् कार्यं कार्यतत्त्वज्ञे त्वमुदाहर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000305050, "chapter_id": 9305, "verse_number": "४-३३-५०", "content_sanskrit": "सा तस्य धर्मार्थसमाधियुक्तं\nनिशम्य वाक्यं मधुरस्वभावम्।\nतारा गतार्थे मनुजेन्द्रकार्ये\nविश्वासयुक्तं तमुवाच भूयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000305051, "chapter_id": 9305, "verse_number": "४-३३-५१", "content_sanskrit": "न कोपकालः क्षितिपालपुत्र\nन चापि कोपः स्वजने विधेयः।\nत्वदर्थकामस्य जनस्य तस्य\nप्रमादमप्यर्हसि वीर सोढुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000305052, "chapter_id": 9305, "verse_number": "४-३३-५२", "content_sanskrit": "कोपं कथं नाम गुणप्रकृष्टः\nकुमार कुर्यादपकृष्टसत्त्वे।\nकस्त्वद्विधः कोपवशं हि गच्छेत्\nसत्त्वावरुद्धस्तपसः प्रसूतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000305053, "chapter_id": 9305, "verse_number": "४-३३-५३", "content_sanskrit": "जानामि कोपं हरिवीरबन्धो-\nर्जानामि कार्यस्य च कालसङ्गम्।\nजानामि कार्यं त्वयि यत्कृतं न-\nस्तच्चापि जानामि यदत्र कार्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000305054, "chapter_id": 9305, "verse_number": "४-३३-५४", "content_sanskrit": "तच्चापि जानामि तथाविषह्यं\nबलं नरश्रेष्ठ शरीरजस्य।\nजानामि यस्मिंश्च जनेऽवबद्धं\nकामेन सुग्रीवमसक्तमद्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000305055, "chapter_id": 9305, "verse_number": "४-३३-५५", "content_sanskrit": "न कामतन्त्रे तव बुद्धिरस्ति\nत्वं वै यथा मन्युवशं प्रपन्नः।\nन देशकालौ हि यथार्थधर्मा-\nववेक्षते कामरतिर्मनुष्यः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000305056, "chapter_id": 9305, "verse_number": "४-३३-५६", "content_sanskrit": "तं कामवृत्तं मम संनिकृष्टं\nकामाभियोगाच्च विमुक्तलज्जम्।\nक्षमस्व तावत् परवीरहन्त-\nस्त्वद्‍भ्रातरं वानरवंशनाथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000305057, "chapter_id": 9305, "verse_number": "४-३३-५७", "content_sanskrit": "महर्षयो धर्मतपोऽभिरामाः\nकामानुकामाः प्रतिबद्धमोहाः।\nअयं प्रकृत्या चपलः कपिस्तु\nकथं न सज्जेत सुखेषु राजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000305058, "chapter_id": 9305, "verse_number": "४-३३-५८", "content_sanskrit": "इत्येवमुक्त्वा वचनं महार्थं\nसा वानरी लक्ष्मणमप्रमेयम्।\nपुनः सखेदं मदविह्वलाक्षी\nभर्तुर्हितं वाक्यमिदं बभाषे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000305059, "chapter_id": 9305, "verse_number": "४-३३-५९", "content_sanskrit": "उद्योगस्तु चिराज्ञप्तः सुग्रीवेण नरोत्तम।\nकामस्यापि विधेयेन तवार्थप्रतिसाधने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000305060, "chapter_id": 9305, "verse_number": "४-३३-६०", "content_sanskrit": "आगता हि महावीर्या हरयः कामरूपिणः।\nकोटीः शतसहस्राणि नानानगनिवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000305061, "chapter_id": 9305, "verse_number": "४-३३-६१", "content_sanskrit": "तदागच्छ महाबाहो चारित्रं रक्षितं त्वया।\nअच्छलं मित्रभावेन सतां दारावलोकनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000305062, "chapter_id": 9305, "verse_number": "४-३३-६२", "content_sanskrit": "तारया चाभ्यनुज्ञातस्त्वरया वापि चोदितः।\nप्रविवेश महाबाहुरभ्यन्तरमरिंदमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000305063, "chapter_id": 9305, "verse_number": "४-३३-६३", "content_sanskrit": "ततः सुग्रीवमासीनं काञ्चने परमासने।\nमहार्हास्तरणोपेते ददर्शादित्यसंनिभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000305064, "chapter_id": 9305, "verse_number": "४-३३-६४", "content_sanskrit": "दिव्याभरणचित्राङ्गं दिव्यरूपं यशस्विनम्।\nदिव्यमाल्याम्बरधरं महेन्द्रमिव दुर्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000305065, "chapter_id": 9305, "verse_number": "४-३३-६५", "content_sanskrit": "दिव्याभरणमाल्याभिः प्रमदाभिः समावृतम्।\nसंरब्धतररक्ताक्षो बभूवान्तकसंनिभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000305066, "chapter_id": 9305, "verse_number": "४-३३-६६", "content_sanskrit": "रुमां तु वीरः परिरभ्य गाढं\nवरासनस्थो वरहेमवर्णः।\nददर्श सौमित्रिमदीनसत्त्वं\nविशालनेत्रः स विशालनेत्रम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000305067, "chapter_id": 9305, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे त्रयस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]