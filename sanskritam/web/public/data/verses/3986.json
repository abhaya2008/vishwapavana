[{"id": 2137667, "chapter_id": 3986, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2137668, "chapter_id": 3986, "verse_number": "१", "content_sanskrit": "एवं हृतायां भार्यायां प्राप्य क्लेशमनुत्तमम् ।\nप्रतिपद्य ततः कृष्णां किमकुर्वत पाण्डवाः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2137669, "chapter_id": 3986, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2137670, "chapter_id": 3986, "verse_number": "२", "content_sanskrit": "एवं हृतायां कृष्णायां प्राप्य क्लेशमनुत्तमम् ।\nविहाय काम्यकं राजा सह भ्रातृभिरच्युतः \t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2137671, "chapter_id": 3986, "verse_number": "३", "content_sanskrit": "पुनर्द्वैतवनं रम्यमाजगाम युधिष्ठिरः ।\nस्वादुमूलफलं रम्यं विचित्रबहुपादपम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2137672, "chapter_id": 3986, "verse_number": "४", "content_sanskrit": "अनुभुक्तफलाहाराः सर्व एव मिताशनाः ।\nन्यवसन् पाण्डवास्तत्र कृष्णया सह भार्यया \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2137673, "chapter_id": 3986, "verse_number": "५", "content_sanskrit": "वसन् द्वैतवने राजा कुन्तीपुत्रो युधिष्ठिरः ।\nभीमसेनोऽर्जुनश्चैव माद्रीपुत्रौ च पाण्डवौ\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2137674, "chapter_id": 3986, "verse_number": "६", "content_sanskrit": "ब्राह्मणार्थे पराक्रान्ता धर्मात्मानो यतव्रताः ।\nक्लेशमार्च्छन्त विपुलं सुखोदर्कं परन्तपाः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2137675, "chapter_id": 3986, "verse_number": "", "content_sanskrit": "तस्मिन् प्रतिवसन्तस्ते यत्प्रापुः कुरुसत्तमाः ।\nवने क्लेशं सुखोदर्कं तत्प्रवक्ष्यामि ते शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2137676, "chapter_id": 3986, "verse_number": "", "content_sanskrit": "अरणीसहितं मन्थं ब्राह्मणस्य तपस्विनः ।\nमृगस्य घर्षमाणस्य विषाणे समसज्जत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2137677, "chapter_id": 3986, "verse_number": "", "content_sanskrit": "तदादाय गतो राजंस्त्वरमाणो महामृगः ।\nआश्रमान्तरितः शीघ्रं प्लवमानो महाजवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2137678, "chapter_id": 3986, "verse_number": "", "content_sanskrit": "ह्रियमाणं तु तं दृष्ट्वा स विप्रः कुरुसत्तम ।\nत्वरितोऽभ्यागमत्तत्र अग्निहोत्रपरीप्सया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2137679, "chapter_id": 3986, "verse_number": "७", "content_sanskrit": "तेजस्तु वसतां तत्र पाण्डवानां महारथम् ।\nअजातशत्रुमासीनं भ्रातृभिः सहितं वने ।\nआगम्य ब्राह्मणस्तूर्णं सन्तप्तश्चेदमब्रवीत् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2137680, "chapter_id": 3986, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2137681, "chapter_id": 3986, "verse_number": "८", "content_sanskrit": "अरणीसहितं मन्थं समासक्तं वनस्पतौ ।\nमृगस्य घर्षमाणस्य विषाणे समसज्जत \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2137682, "chapter_id": 3986, "verse_number": "९", "content_sanskrit": "तमादाय गतो राजंस्त्वरमाणो महामृगः ।\nआश्रमात् त्वरितः शीघ्रं प्लवमानो महाजवः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2137683, "chapter_id": 3986, "verse_number": "१०", "content_sanskrit": "तस्य गत्वा पदं राजन्नासाद्य च महामृगम् ।\nअग्निहोत्रं न लुप्येत तदानयत पाण्डवाः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2137684, "chapter_id": 3986, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2137685, "chapter_id": 3986, "verse_number": "११", "content_sanskrit": "ब्राह्मणस्य वचः श्रुत्वा सन्तप्तोऽथ युधिष्ठिरः ।\nधनुरादाय कौन्तेयः प्राद्रवद् भ्रातृभिः सह \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2137686, "chapter_id": 3986, "verse_number": "१२", "content_sanskrit": "सन्नद्धा धन्विनः सर्वे प्राद्रवन् नरपुङ्गवाः ।\nब्राह्मणार्थे यतन्तस्ते शीघ्रमन्वगमन् मृगम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2137687, "chapter_id": 3986, "verse_number": "१३", "content_sanskrit": "कर्णिनालीकनाराचानुत्सृजन्तो महारथाः ।\nनाविध्यन्पाण्डवास्तत्र पश्यन्तो मृगमन्तिकात् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2137688, "chapter_id": 3986, "verse_number": "१४", "content_sanskrit": "तेषां प्रयतमानानां नादृश्यत महामृगः ।\nअपश्यन्तो मृगं श्रान्ता दुःखं प्राप्ता मनस्विनः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2137689, "chapter_id": 3986, "verse_number": "१५", "content_sanskrit": "शीतलच्छायमागम्य न्यग्रोधं गहने वने ।\nक्षुत्पिपासापरीताङ्गाः पाण्डवाः समुपाविशन् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2137690, "chapter_id": 3986, "verse_number": "१६", "content_sanskrit": "तेषां समुपविष्टानां नकुलो दुःखितस्तदा ।\nअब्रवीद् भ्रातरं श्रेष्ठममर्षात् कुरुनन्दनम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2137691, "chapter_id": 3986, "verse_number": "", "content_sanskrit": "नकुलः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2137692, "chapter_id": 3986, "verse_number": "१७", "content_sanskrit": "नास्मिन् कुले जातु ममज्ज धर्मो\nन चालस्यादर्थलोपो बभूव ।\nअनुत्तराः सर्ववर्णेषु भूयः\nसम्प्राप्ताः स्मः संशयं किंनु राजन् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2137693, "chapter_id": 3986, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि त्रिशततमोऽध्यायः ॥३००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2137694, "chapter_id": 3986, "verse_number": "१", "content_sanskrit": "आरणेयपर्वणि मृगान्वेषणे प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2137695, "chapter_id": 3986, "verse_number": "", "content_sanskrit": "––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]