[{"id": 40021962, "chapter_id": 9375, "verse_number": "1", "content_sanskrit": "रामस्य भाषितं श्रुत्वा लक्ष्मणः परवीरहा । उवाच प्राञ्जलिर्वाक्यं राघवं दीप्ततेजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40021963, "chapter_id": 9375, "verse_number": "2", "content_sanskrit": "निक्षिप्तदेहौ काकुत्स्य कथं तौ द्विजपार्थिवौ । पुनर्देहेन संयोगं जग्मतुर्देवसम्मतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40021964, "chapter_id": 9375, "verse_number": "3", "content_sanskrit": "लक्ष्मणेनैवमुक्तस्तु रामश्चेक्ष्वाकुनन्दनः । प्रत्युवाच महातेजा लक्ष्मणं पुरुषर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40021965, "chapter_id": 9375, "verse_number": "4", "content_sanskrit": "तौ परस्परशापेन देहावुत्सृज्य धार्मिकौ । अभूतां नृपविप्रर्षी वायुभूतौ तपोधनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40021966, "chapter_id": 9375, "verse_number": "5", "content_sanskrit": "अशरीरः शरीरस्य कृते ऽन्यस्य महामुनिः । वसिष्ठः सुमहातेजा जगाम पितुरन्तिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40021967, "chapter_id": 9375, "verse_number": "6", "content_sanskrit": "सो ऽभिवाद्य ततः पादौ देवदेवस्य धर्मवित् । पितामहमथोवाच वायुभूत इदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40021968, "chapter_id": 9375, "verse_number": "7", "content_sanskrit": "भगवन्निमिशापेन विदेहत्वमुपागमम् । लोकनाथ महादेव अण्डजो ऽपि त्वमब्जजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40021969, "chapter_id": 9375, "verse_number": "8", "content_sanskrit": "सर्वेषां देहहीनानां महद्दुःखं भविष्यति । लुप्यन्ते सर्वकार्यणि हीनदेहस्य वै प्रभो । देहस्यान्यस्य सद्भावे प्रसादं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40021970, "chapter_id": 9375, "verse_number": "9", "content_sanskrit": "तमुवाच ततो ब्रह्मा स्वयम्भूरमितप्रभः । मित्रावरुणजं तेज प्रविश त्वं महायशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40021971, "chapter_id": 9375, "verse_number": "10", "content_sanskrit": "अयोनिजस्त्वं भविता तत्रापि द्विजसत्तम । धर्मेण महता युक्तः पुनरेष्यसि मे वशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40021972, "chapter_id": 9375, "verse_number": "11", "content_sanskrit": "एवमुक्तस्तु देवेन चाभिवाद्य प्रदक्षिणम् । कृत्वा पितामहं तूर्णं प्रययौ वरुणालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40021973, "chapter_id": 9375, "verse_number": "12", "content_sanskrit": "तमेव कालं मित्रो ऽपि वरुणत्वमकारयत् । क्षीरोदेन सहोपेतः पूज्यमानः सुरोत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40021974, "chapter_id": 9375, "verse_number": "13", "content_sanskrit": "एतस्मिन्नेव काले तु उर्वशी परमाप्सराः । यदृच्छया तमुद्देशमाययौ सखिभिर्वृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40021975, "chapter_id": 9375, "verse_number": "14", "content_sanskrit": "तां दृष्ट्वा रूपसम्पन्नां क्रीडन्तीं वरुणालये । आविशत्परमो हर्षो वरुणं चोर्वशीकृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40021976, "chapter_id": 9375, "verse_number": "15", "content_sanskrit": "स तां पद्मपलाशाक्षीं पूर्णचन्द्रनिभाननाम् । वरुणो वरयामास मैथुनायाप्सरोवराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40021977, "chapter_id": 9375, "verse_number": "16", "content_sanskrit": "प्रत्युवाच ततः सा तु वरुणं प्राञ्जलिः स्थिता । मित्रेणाहं वृता साक्षात्पूर्वमेव सुरेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40021978, "chapter_id": 9375, "verse_number": "17", "content_sanskrit": "वरुणस्त्वब्रवीद्वाक्यं कन्दर्पशरपीडितः । इदं तेजः समुत्स्रक्ष्ये कुम्भे ऽस्मिन्देवनिर्मिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40021979, "chapter_id": 9375, "verse_number": "18", "content_sanskrit": "एवमुत्सृज्य सुश्रोणि त्वय्यहं वरवर्णिनि । कृतकामो भविष्यामि यदि नेच्छसि सङ्गमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40021980, "chapter_id": 9375, "verse_number": "19", "content_sanskrit": "तस्य तल्लोकपालस्य वरुणस्य सुभाषितम् । उर्वशी परमप्रीता श्रुत्वा वाक्यमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40021981, "chapter_id": 9375, "verse_number": "20", "content_sanskrit": "काममेतद्भवत्वेवं हृदयं मे त्वयि स्थितम् । भावश्चाप्यधिकस्तुभ्यं देहो मित्रस्य तु प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40021982, "chapter_id": 9375, "verse_number": "21", "content_sanskrit": "उर्वश्या एवमुक्तस्तु रेतस्तन्महदद्भुतम् । ज्वलदग्निशिखाप्रख्यं तस्मिन्कुम्भे ह्यपासृजत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40021983, "chapter_id": 9375, "verse_number": "22", "content_sanskrit": "उर्वशी त्वगमत्तत्र मित्रो वै यत्र देवता । तां तु मित्रः सुसङ्क्रम्य उर्वशीमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40021984, "chapter_id": 9375, "verse_number": "23", "content_sanskrit": "मया निमन्त्रिता पूर्वं कस्मात्त्वमवसर्जिता । पतिमन्यं वृतवती तस्मात्त्वं दुष्टचारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40021985, "chapter_id": 9375, "verse_number": "24", "content_sanskrit": "अनेन दुष्कृतेन त्वं मत्क्रोधकलुषीकृता । मनुष्यलोकमास्थाय कञ्चित्कालं निवत्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40021986, "chapter_id": 9375, "verse_number": "25", "content_sanskrit": "बुधस्य पुत्रो राजर्षिः काशीराजः पुरूरवाः । तमद्य गच्छ दुर्बुद्धे स ते भर्ता भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40021987, "chapter_id": 9375, "verse_number": "26", "content_sanskrit": "ततः सा शापदोषेण पुरूरवसमभ्यगात् । प्रतियाते पुरूरवं बुधस्यात्मजमौरसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40021988, "chapter_id": 9375, "verse_number": "27", "content_sanskrit": "तस्य जज्ञे ततः श्रीमानायुः पुत्रो महाबलः । नहुषो यस्य पुत्रस्तु बभूवेन्द्रसमद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40021989, "chapter_id": 9375, "verse_number": "28", "content_sanskrit": "वज्रमुत्सृज्य वृत्राय भ्रान्ते ऽथ त्रिदिवेश्वरे । शतं वर्षसहस्राणि येनेन्द्रत्वं प्रशासितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40021990, "chapter_id": 9375, "verse_number": "29", "content_sanskrit": "सा तेन शापेन जगाम भूमिं तदोर्वशी चारुदती सुनेत्रा । बहूनि वर्षाण्यवसच्च सुभ्रूः शापक्षयादिन्द्रसदो ययौ च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]