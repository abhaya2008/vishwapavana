[{"id": 5000375000, "chapter_id": 9375, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे षट्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000375001, "chapter_id": 9375, "verse_number": "५-३६-१", "content_sanskrit": "भूय एव महातेजा हनूमान् पवनात्मजः।\nअब्रवीत् प्रश्रितं वाक्यं सीताप्रत्ययकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000375002, "chapter_id": 9375, "verse_number": "५-३६-२", "content_sanskrit": "वानरोऽहं महाभागे दूतो रामस्य धीमतः।\nरामनामाङ्कितं चेदं पश्य देव्यङ्गुलीयकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000375003, "chapter_id": 9375, "verse_number": "५-३६-३", "content_sanskrit": "प्रत्ययार्थं तवानीतं तेन दत्तं महात्मना।\nसमाश्वसिहि भद्रं ते क्षीणदुःखफला ह्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000375004, "chapter_id": 9375, "verse_number": "५-३६-४", "content_sanskrit": "गृहीत्वा प्रेक्षमाणा सा भर्तुः करविभूषितम्।\nभर्तारमिव सम्प्राप्तं जानकी मुदिताभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000375005, "chapter_id": 9375, "verse_number": "५-३६-५", "content_sanskrit": "चारु तद् वदनं तस्यास्ताम्रशुक्लायतेक्षणम्।\nबभूव हर्षोदग्रं च राहुमुक्त इवोडुराट् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000375006, "chapter_id": 9375, "verse_number": "५-३६-६", "content_sanskrit": "ततः सा ह्रीमती बाला भर्तुः संदेशहर्षिता।\nपरितुष्टा प्रियं कृत्वा प्रशशंस महाकपिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000375007, "chapter_id": 9375, "verse_number": "५-३६-७", "content_sanskrit": "विक्रान्तस्त्वं समर्थस्त्वं प्राज्ञस्त्वं वानरोत्तम।\nयेनेदं राक्षसपदं त्वयैकेन प्रधर्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000375008, "chapter_id": 9375, "verse_number": "५-३६-८", "content_sanskrit": "शतयोजनविस्तीर्णः सागरो मकरालयः।\nविक्रमश्लाघनीयेन क्रमता गोष्पदीकृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000375009, "chapter_id": 9375, "verse_number": "५-३६-९", "content_sanskrit": "नहि त्वां प्राकृतं मन्ये वानरं वानरर्षभ।\nयस्य ते नास्ति संत्रासो रावणादपि सम्भ्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000375010, "chapter_id": 9375, "verse_number": "५-३६-१०", "content_sanskrit": "अर्हसे च कपिश्रेष्ठ मया समभिभाषितुम्।\nयद्यसि प्रेषितस्तेन रामेण विदितात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000375011, "chapter_id": 9375, "verse_number": "५-३६-११", "content_sanskrit": "प्रेषयिष्यति दुर्धर्षो रामो नह्यपरीक्षितम्।\nपराक्रममविज्ञाय मत्सकाशं विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000375012, "chapter_id": 9375, "verse_number": "५-३६-१२", "content_sanskrit": "दिष्ट्या च कुशली रामो धर्मात्मा सत्यसंगरः।\nलक्ष्मणश्च महातेजाः सुमित्रानन्दवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000375013, "chapter_id": 9375, "verse_number": "५-३६-१३", "content_sanskrit": "कुशली यदि काकुत्स्थः किं न सागरमेखलाम्।\nमहीं दहति कोपेन युगान्ताग्निरिवोत्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000375014, "chapter_id": 9375, "verse_number": "५-३६-१४", "content_sanskrit": "अथवा शक्तिमन्तौ तौ सुराणामपि निग्रहे।\nममैव तु न दुःखानामस्ति मन्ये विपर्ययः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000375015, "chapter_id": 9375, "verse_number": "५-३६-१५", "content_sanskrit": "कच्चिन्न व्यथते रामः कच्चिन्न परितप्यते।\nउत्तराणि च कार्याणि कुरुते पुरुषोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000375016, "chapter_id": 9375, "verse_number": "५-३६-१६", "content_sanskrit": "कच्चिन्न दीनः सम्भ्रान्तः कार्येषु च न मुह्यति।\nकच्चित् पुरुषकार्याणि कुरुते नृपतेः सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000375017, "chapter_id": 9375, "verse_number": "५-३६-१७", "content_sanskrit": "द्विविधं त्रिविधोपायमुपायमपि सेवते।\nविजिगीषुः सुहृत् कच्चिन्मित्रेषु च परंतपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000375018, "chapter_id": 9375, "verse_number": "५-३६-१८", "content_sanskrit": "कच्चिन्मित्राणि लभतेऽमित्रैश्चाप्यभिगम्यते।\nकच्चित् कल्याणमित्रश्च मित्रैश्चापि पुरस्कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000375019, "chapter_id": 9375, "verse_number": "५-३६-१९", "content_sanskrit": "कच्चिदाशास्ति देवानां प्रसादं पार्थिवात्मजः।\nकच्चित् पुरुषकारं च दैवं च प्रतिपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000375020, "chapter_id": 9375, "verse_number": "५-३६-२०", "content_sanskrit": "कच्चिन्न विगतस्नेहो विवासान्मयि राघवः।\nकच्चिन्मां व्यसनादस्मान्मोक्षयिष्यति राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000375021, "chapter_id": 9375, "verse_number": "५-३६-२१", "content_sanskrit": "सुखानामुचितो नित्यमसुखानामनूचितः।\nदुःखमुत्तरमासाद्य कच्चिद् रामो न सीदति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000375022, "chapter_id": 9375, "verse_number": "५-३६-२२", "content_sanskrit": "कौसल्यायास्तथा कच्चित् सुमित्रायास्तथैव च।\nअभीक्ष्णं श्रूयते कच्चित् कुशलं भरतस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000375023, "chapter_id": 9375, "verse_number": "५-३६-२३", "content_sanskrit": "मन्निमित्तेन मानार्हः कच्चिच्छोकेन राघवः।\nकच्चिन्नान्यमना रामः कच्चिन्मां तारयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000375024, "chapter_id": 9375, "verse_number": "५-३६-२४", "content_sanskrit": "कच्चिदक्षौहिणीं भीमां भरतो भ्रातृवत्सलः।\nध्वजिनीं मन्त्रिभिर्गुप्तां प्रेषयिष्यति मत्कृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000375025, "chapter_id": 9375, "verse_number": "५-३६-२५", "content_sanskrit": "वानराधिपतिः श्रीमान् सुग्रीवः कच्चिदेष्यति।\nमत्कृते हरिभिर्वीरैर्वृतो दन्तनखायुधैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000375026, "chapter_id": 9375, "verse_number": "५-३६-२६", "content_sanskrit": "कच्चिच्च लक्ष्मणः शूरः सुमित्रानन्दवर्धनः।\nअस्त्रविच्छरजालेन राक्षसान् विधमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000375027, "chapter_id": 9375, "verse_number": "५-३६-२७", "content_sanskrit": "रौद्रेण कच्चिदस्त्रेण रामेण निहतं रणे।\nद्रक्ष्याम्यल्पेन कालेन रावणं ससुहृज्जनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000375028, "chapter_id": 9375, "verse_number": "५-३६-२८", "content_sanskrit": "कच्चिन्न तद्धेमसमानवर्णं\nतस्याननं पद्मसमानगन्धि।\nमया विना शुष्यति शोकदीनं\nजलक्षये पद्ममिवातपेन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000375029, "chapter_id": 9375, "verse_number": "५-३६-२९", "content_sanskrit": "धर्मापदेशात् त्यजतः स्वराज्यं\nमां चाप्यरण्यं नयतः पदातेः।\nनासीद् यथा यस्य न भीर्न शोकः\nकच्चित् स धैर्यं हृदये करोति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000375030, "chapter_id": 9375, "verse_number": "५-३६-३०", "content_sanskrit": "न चास्य माता न पिता न चान्यः\nस्नेहाद् विशिष्टोऽस्ति मया समो वा।\nतावद्ध्यहं दूत जिजीविषेयं\nयावत् प्रवृत्तिं शृणुयां प्रियस्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000375031, "chapter_id": 9375, "verse_number": "५-३६-३१", "content_sanskrit": "इतीव देवी वचनं महार्थं\nतं वानरेन्द्रं मधुरार्थमुक्त्वा।\nश्रोतुं पुनस्तस्य वचोऽभिरामं\nरामार्थयुक्तं विरराम रामा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000375032, "chapter_id": 9375, "verse_number": "५-३६-३२", "content_sanskrit": "सीताया वचनं श्रुत्वा मारुतिर्भीमविक्रमः।\nशिरस्यञ्जलिमाधाय वाक्यमुत्तरमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000375033, "chapter_id": 9375, "verse_number": "५-३६-३३", "content_sanskrit": "न त्वामिहस्थां जानीते रामः कमललोचनः।\nतेन त्वां नानयत्याशु शचीमिव पुरंदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000375034, "chapter_id": 9375, "verse_number": "५-३६-३४", "content_sanskrit": "श्रुत्वैव च वचो मह्यं क्षिप्रमेष्यति राघवः।\nचमूं प्रकर्षन् महतीं हर्यृक्षगणसंयुताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000375035, "chapter_id": 9375, "verse_number": "५-३६-३५", "content_sanskrit": "विष्टम्भयित्वा बाणौघैरक्षोभ्यं वरुणालयम्।\nकरिष्यति पुरीं लङ्कां काकुत्स्थः शान्तराक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000375036, "chapter_id": 9375, "verse_number": "५-३६-३६", "content_sanskrit": "तत्र यद्यन्तरा मृत्युर्यदि देवा महासुराः।\nस्थास्यन्ति पथि रामस्य स तानपि वधिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000375037, "chapter_id": 9375, "verse_number": "५-३६-३७", "content_sanskrit": "तवादर्शनजेनार्ये शोकेन परिपूरितः।\nन शर्म लभते रामः सिंहार्दित इव द्विपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000375038, "chapter_id": 9375, "verse_number": "५-३६-३८", "content_sanskrit": "मन्दरेण च ते देवि शपे मूलफलेन च।\nमलयेन च विन्ध्येन मेरुणा दर्दुरेण च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000375039, "chapter_id": 9375, "verse_number": "५-३६-३९", "content_sanskrit": "यथा सुनयनं वल्गु बिम्बोष्ठं चारुकुण्डलम्।\nमुखं द्रक्ष्यसि रामस्य पूर्णचन्द्रमिवोदितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000375040, "chapter_id": 9375, "verse_number": "५-३६-४०", "content_sanskrit": "क्षिप्रं द्रक्ष्यसि वैदेहि रामं प्रस्रवणे गिरौ।\nशतक्रतुमिवासीनं नागपृष्ठस्य मूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000375041, "chapter_id": 9375, "verse_number": "५-३६-४१", "content_sanskrit": "न मांसं राघवो भुङ्‍क्ते न चैव मधु सेवते।\nवन्यं सुविहितं नित्यं भक्तमश्नाति पञ्चमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000375042, "chapter_id": 9375, "verse_number": "५-३६-४२", "content_sanskrit": "नैव दंशान् न मशकान् न कीटान् न सरीसृपान्।\nराघवोऽपनयेद् गात्रात् त्वद‍्गतेनान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000375043, "chapter_id": 9375, "verse_number": "५-३६-४३", "content_sanskrit": "नित्यं ध्यानपरो रामो नित्यं शोकपरायणः।\nनान्यच्चिन्तयते किंचित् स तु कामवशं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000375044, "chapter_id": 9375, "verse_number": "५-३६-४४", "content_sanskrit": "अनिद्रः सततं रामः सुप्तोऽपि च नरोत्तमः।\nसीतेति मधुरां वाणीं व्याहरन् प्रतिबुध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000375045, "chapter_id": 9375, "verse_number": "५-३६-४५", "content_sanskrit": "दृष्ट्वा फलं वा पुष्पं वा यच्चान्यत् स्त्रीमनोहरम्।\nबहुशो हा प्रियेत्येवं श्वसंस्त्वामभिभाषते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000375046, "chapter_id": 9375, "verse_number": "५-३६-४६", "content_sanskrit": "स देवि नित्यं परितप्यमान-\nस्त्वामेव सीतेत्यभिभाषमाणः।\nधृतव्रतो राजसुतो महात्मा\nतवैव लाभाय कृतप्रयत्नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000375047, "chapter_id": 9375, "verse_number": "५-३६-४७", "content_sanskrit": "सा रामसंकीर्तनवीतशोका\nरामस्य शोकेन समानशोका।\nशरन्मुखेनाम्बुदशेषचन्द्रा\nनिशेव वैदेहसुता बभूव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000375048, "chapter_id": 9375, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमत्सुन्दरकाण्डे षट्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]