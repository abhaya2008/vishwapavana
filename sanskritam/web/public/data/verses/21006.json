[{"id": 7001006000, "chapter_id": 21006, "verse_number": "४-१२-१", "content_sanskrit": "श्रीपराशर उवाच\nक्रोष्टोस्तु यदुपुत्रस्यात्मजो ध्वजिनीवान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001006001, "chapter_id": 21006, "verse_number": "४-१२-२", "content_sanskrit": "ततश्च स्वातिः ततो रुशङ्कुः रुशङ्कोश्चित्ररथः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001006002, "chapter_id": 21006, "verse_number": "४-१२-३", "content_sanskrit": "तत्तनयः शशिबिन्दुः चतुर्दशमहारत्नेशश्चक्रवर्त्यभवत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001006003, "chapter_id": 21006, "verse_number": "४-१२-४", "content_sanskrit": "तस्य च शतसहस्रं पत्नी नामभवत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001006004, "chapter_id": 21006, "verse_number": "४-१२-५", "content_sanskrit": "दशलक्षसंख्याश्च पुत्राः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001006005, "chapter_id": 21006, "verse_number": "४-१२-६", "content_sanskrit": "तेषां च पृथुश्रवाः पृथुकर्मा पृथुकीर्तिः पृथुयशाः पृथुजयः पृथुदानः षट्पुत्राः प्रधानाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001006006, "chapter_id": 21006, "verse_number": "४-१२-७", "content_sanskrit": "पृथुश्रवसश्च पुत्रः पृथुतमः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001006007, "chapter_id": 21006, "verse_number": "४-१२-८", "content_sanskrit": "तस्मादुशना यो वाजिमेधानां शतमाजहार ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001006008, "chapter_id": 21006, "verse_number": "४-१२-९", "content_sanskrit": "तस्य च शितपुर्नाम पुत्रोऽभवत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001006009, "chapter_id": 21006, "verse_number": "४-१२-१०", "content_sanskrit": "तस्यापि रुक्मकवचस्ततः परवृत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001006010, "chapter_id": 21006, "verse_number": "४-१२-११", "content_sanskrit": "तस्य परावृतो रुक्मेषुपृथुज्यामघवलितहरितसंज्ञास्तस्य पञ्चात्मजा बभूवुः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001006011, "chapter_id": 21006, "verse_number": "४-१२-१२", "content_sanskrit": "तस्माद्यापि ज्यामघस्य श्लोको गीयते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001006012, "chapter_id": 21006, "verse_number": "४-१२-१३", "content_sanskrit": "भार्यावश्यास्तु ये केचिद्भविष्यन्त्यथ वा मृताः ।\nतेषां तु ज्यामघः श्रेष्ठः शैव्यापतिरभून्नृपः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001006013, "chapter_id": 21006, "verse_number": "४-१२-१४", "content_sanskrit": "अपुत्रा तस्य सा पत्नी शैव्या नाम तथाप्यसौ ।\nअपत्यकामोऽपि भयान्नान्यां भार्यामविन्दत ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001006014, "chapter_id": 21006, "verse_number": "४-१२-१५", "content_sanskrit": "स त्वेकदा प्रभूतरथतुरगगजसंमर्दातिदारुणे महाहवे युद्ध्यमानःच सकलमेवारिचक्रमजयत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001006015, "chapter_id": 21006, "verse_number": "४-१२-१६", "content_sanskrit": "तच्चारिचक्रमपास्तपुत्रकलत्रबन्धुबलकोशं स्वमधिष्ठानं परित्यज्य दिशः प्रतिविद्रुतम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001006016, "chapter_id": 21006, "verse_number": "४-१२-१७", "content_sanskrit": "तस्मिंश्च विद्रुतेतित्रासलोलायतलोचनयुगलं त्राहित्राहि मां तातांब भ्रतरित्याकुलविलापविधुरं स राजकन्यारत्नमद्राक्षीत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001006017, "chapter_id": 21006, "verse_number": "४-१२-१८", "content_sanskrit": "तद्दर्शनाच्च तस्यामनुरागनुगतान्तरात्मा स नृपोऽचिन्तयत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001006018, "chapter_id": 21006, "verse_number": "४-१२-१९", "content_sanskrit": "साध्विदं ममापत्यरहितस्य वन्ध्याभर्तुः सांप्रतं विधिनापत्यकारणं कन्यारत्नमुपपादितम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001006019, "chapter_id": 21006, "verse_number": "४-१२-२०", "content_sanskrit": "तदेतत्समुद्वहामीति ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001006020, "chapter_id": 21006, "verse_number": "४-१२-२१", "content_sanskrit": "अथ वैनां स्यन्दनमारोप्य स्वमधिष्ठानं नयामि ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001006021, "chapter_id": 21006, "verse_number": "४-१२-२२", "content_sanskrit": "तयैव देव्याशैव्ययाहमनुज्ञातःसमुद्वहामीति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001006022, "chapter_id": 21006, "verse_number": "४-१२-२३", "content_sanskrit": "अथैनां रथमारोप्य स्वनगरमगच्छत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001006023, "chapter_id": 21006, "verse_number": "४-१२-२४", "content_sanskrit": "विजयिनं च राजानमशेषपौरभृत्वयरिजनामात्यसमेता शैव्या द्रष्टुमधिष्ठनद्वारमागता ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001006024, "chapter_id": 21006, "verse_number": "४-१२-२५", "content_sanskrit": "सा चावलोक्य राज्ञः सव्यपार्शववर्त्तिनीं कन्यामीषदुद्भूतामर्षस्फुरदधरपल्लवा राजानमवोचत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001006025, "chapter_id": 21006, "verse_number": "४-१२-२६", "content_sanskrit": "अतिचपलचित्तात्र स्यन्दने केयमारोपितेति ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001006026, "chapter_id": 21006, "verse_number": "४-१२-२७", "content_sanskrit": "असावप्यनालोचितोत्तरवचनोतिभयात्तामाह स्नुषा ममेयमिति ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001006027, "chapter_id": 21006, "verse_number": "४-१२-२८", "content_sanskrit": "अथैनं शैव्योवाच ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001006028, "chapter_id": 21006, "verse_number": "४-१२-२९", "content_sanskrit": "नाहं प्रसूता पुत्रेण नान्या पत्न्यभवत्तव ।\nस्नुषासंबन्धता ह्योषा कतमेन सुतेन ते ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001006029, "chapter_id": 21006, "verse_number": "४-१२-३०", "content_sanskrit": "श्रीपराशर उवाच\nइत्यात्मेर्ष्याकोपकलुषितवचनमुषितविवेको भयाद्दुरुक्तापरिहारार्थमिदमवनीपतिराह ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001006030, "chapter_id": 21006, "verse_number": "४-१२-३१", "content_sanskrit": "यस्ते जनिष्यत्यात्मजस्तस्येयमनागतस्यैव भार्या निरूपितेत्याकर्ण्योद्भूतमृदुहासा तथेत्याह ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001006031, "chapter_id": 21006, "verse_number": "४-१२-३२", "content_sanskrit": "प्रविवेश च राज्ञा सहाधिष्ठानम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001006032, "chapter_id": 21006, "verse_number": "४-१२-३३", "content_sanskrit": "अनन्तरं चातिशुद्धलग्नहोरांशकावयवोक्तकृतपुत्रजन्मलाभगुणाद्वयसः परिणाममुपगतापि शैव्या स्वल्पैरेवाहोभिर्गर्भमवाप ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001006033, "chapter_id": 21006, "verse_number": "४-१२-३४", "content_sanskrit": "कालेन च कुमारमजीजनत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001006034, "chapter_id": 21006, "verse_number": "४-१२-३५", "content_sanskrit": "तस्य च विदर्भ इति पिता नाम चक्रे ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001006035, "chapter_id": 21006, "verse_number": "४-१२-३६", "content_sanskrit": "स च तां स्नुषामुपयेमे ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001006036, "chapter_id": 21006, "verse_number": "४-१२-३७", "content_sanskrit": "तस्यां चासौक्रथकैशिकसंज्ञौ पुत्रावजनयत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001006037, "chapter_id": 21006, "verse_number": "४-१२-३८", "content_sanskrit": "पुनश्च तृतीयं रोमपादसंज्ञं पुत्रमजीजनद्यो नारदादवाप्तज्ञानवान्भविष्यतीति ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001006038, "chapter_id": 21006, "verse_number": "४-१२-३९", "content_sanskrit": "रोमपादाद्बभ्रुः बभ्रोर्धृतिर्ः धृतेः कैशिकः कैशिकस्यापि चेदिः पुत्रोऽभवत्यस्य संततौ चैद्या भूपालाः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001006039, "chapter_id": 21006, "verse_number": "४-१२-४०", "content_sanskrit": "क्रथस्य स्नषापुत्रस्यकुन्तिरभवत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001006040, "chapter_id": 21006, "verse_number": "४-१२-४१", "content_sanskrit": "कुन्तेर्धृष्टिः धृष्टेर्निधृतिः निधृतेर्दशार्हस्ततश्च व्योमः तस्यापि जीमूतः ततश्च विकृतिः ततश्च भीभरथः तस्मान्नवरथः तस्यापि दशरथः ततश्च शकुनिः तत्तनयः करंभिः करंभेर्देवरातोऽभवत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001006041, "chapter_id": 21006, "verse_number": "४-१२-४२", "content_sanskrit": "तस्माद्देवक्षत्रः तस्यापि मधुः मधोः कुमारवंशः कुमारवंशादनुः अनोः पुरुमित्रः पृथिवीपतिरभवत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001006042, "chapter_id": 21006, "verse_number": "४-१२-४३", "content_sanskrit": "ततश्चांशुस्तस्माच्च सत्वतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001006043, "chapter_id": 21006, "verse_number": "४-१२-४४", "content_sanskrit": "सत्वतादेते सात्वताः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001006044, "chapter_id": 21006, "verse_number": "४-१२-४५", "content_sanskrit": "इत्येतां ज्यामघस्य संततिं सम्यक्छ्रद्धासमन्वितः श्रुत्वा पुमान्मैत्रेय स्वपापैः प्रमुच्यते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]