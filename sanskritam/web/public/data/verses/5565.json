[{"id": 2213670, "chapter_id": 5565, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213671, "chapter_id": 5565, "verse_number": "१", "content_sanskrit": "अदृष्ट्वा तु नृपः पुत्रान् दर्शनं प्रतिलब्धवान् ।\nऋषेः प्रसादात् पुत्राणां स्वरूपाणां कुरूद्वह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213672, "chapter_id": 5565, "verse_number": "२", "content_sanskrit": "स राजा राजधर्मांश्च ब्रह्मोपनिषदं तथा ।\nअवाप्तवान् नरश्रेष्ठो बुद्धिनिश्चयमेव च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213673, "chapter_id": 5565, "verse_number": "३", "content_sanskrit": "विदुरश्च महाप्राज्ञो ययौ सिद्धिं तपोबलात् ।\nधृतराष्ट्रः समासाद्य व्यासं चैव तपस्विनम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213674, "chapter_id": 5565, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213675, "chapter_id": 5565, "verse_number": "४", "content_sanskrit": "ममापि वरदो व्यासो दर्शयेत् पितरं यदि ।\nतद्रूपवेषवयसं श्रद्दध्यां सर्वमेव तत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213676, "chapter_id": 5565, "verse_number": "५", "content_sanskrit": "प्रियं मे स्यात् कृतार्थश्च स्यामहं कृतनिश्चयः ।\nप्रसादादृषिमुख्यस्य मम कामः समृद्ध्यताम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213677, "chapter_id": 5565, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213678, "chapter_id": 5565, "verse_number": "६", "content_sanskrit": "इत्युक्तवचने तस्मिन्नृपे व्यासः प्रतापवान् ।\nप्रसादमकरोद्धीमानानयच्च परिक्षितम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213679, "chapter_id": 5565, "verse_number": "७", "content_sanskrit": "ततस्तद्रूपवयसमागतं नृपतिं दिवः ।\nश्रीमन्तं पितरं राजा ददर्श स परिक्षितम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213680, "chapter_id": 5565, "verse_number": "८", "content_sanskrit": "शमीकं च महात्मानं पुत्रं तं चास्य शृङ्गिणम् ।\nअमात्या ये च निहता राज्ञस्तांश्च ददर्श ह\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213681, "chapter_id": 5565, "verse_number": "९", "content_sanskrit": "ततः सोवभृथे राजा मुदितो जनमेजयः ।\nपितरं स्नापयामास स्वयं सस्नौ च पार्थिवः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213682, "chapter_id": 5565, "verse_number": "१०", "content_sanskrit": "(परीक्षिदपि तत्रैव बभूव स तिरोहितः ।)\nस्नात्वा स नृपतिर्विप्रमास्तीकमिदमब्रवीत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213683, "chapter_id": 5565, "verse_number": "११", "content_sanskrit": "यायावरकुलोत्पन्नं जरत्कारुसुतं तदा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213684, "chapter_id": 5565, "verse_number": "१२", "content_sanskrit": "आस्तीक विविधाश्चर्यो यज्ञोऽयमिति मे मतिः ।\nयदद्यायं पिता प्राप्तो मम शोकप्रणाशनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213685, "chapter_id": 5565, "verse_number": "", "content_sanskrit": "आस्तीकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213686, "chapter_id": 5565, "verse_number": "१३", "content_sanskrit": "ऋषिर्द्वैपायनो यत्र पुराणस्तपसो निधिः ।\nयज्ञे कुरुकुलश्रेष्ठ तस्य लोकावुभौ जितौ\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2213687, "chapter_id": 5565, "verse_number": "१४", "content_sanskrit": "श्रुतं विचित्रमाख्यानं त्वया पाण्डवनन्दन ।\nसर्पाश्च भस्मसान्नीता गताश्च पदवीं पितुः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2213688, "chapter_id": 5565, "verse_number": "१५", "content_sanskrit": "कथञ्चित् तक्षको मुक्तः सत्यत्वात् तव पार्थिव ।\nऋषयः पूजिताः सर्वे गतिर्दृष्टा महात्मनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2213689, "chapter_id": 5565, "verse_number": "१६", "content_sanskrit": "प्राप्तः सुविपुलो धर्मः श्रुत्वा पापविनाशनम् ।\nविमुक्तो हृदयग्रन्थिरुदारजनदर्शनात्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2213690, "chapter_id": 5565, "verse_number": "१७", "content_sanskrit": "ये च पक्षधरा धर्मे सद्वृत्तरुचयश्च ये ।\nयान् दृष्ट्वा हीयते पापं तेभ्यः कार्या नमस्क्रिया\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2213691, "chapter_id": 5565, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2213692, "chapter_id": 5565, "verse_number": "१८", "content_sanskrit": "एतच्छ्रुत्वा द्विजश्रेष्ठात् स राजा जनमेजयः ।\nपूजयामास तमृषिमनुमान्य पुनः पुनः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2213693, "chapter_id": 5565, "verse_number": "१९", "content_sanskrit": "पप्रच्छ तमृषिं चापि वैशम्पायनमच्युतम् ।\nकथावशेषं धर्मज्ञो वनवासस्य सत्तम\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2213694, "chapter_id": 5565, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्रमवासिकपर्वणि\nजनमेजयेन स्वपितृपरिक्षिद्दर्शनकथनं नाम एकचत्वारिंशोऽध्यायः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2213695, "chapter_id": 5565, "verse_number": "", "content_sanskrit": "पुत्रदर्शनपर्वणि अष्टमोऽध्यायः ॥८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]