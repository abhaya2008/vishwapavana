[{"id": 7000324000, "chapter_id": 20324, "verse_number": "१-७८-१", "content_sanskrit": "वैशम्पायन उवाच ।\nभगवंस्त्वत्प्रसादाच्च श्रुतं मे पावनं व्रतं ।\nअपरं श्रोतुमिच्छामि ब्रध्नस्य च प्रियं च यत्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000324001, "chapter_id": 20324, "verse_number": "१-७८-२", "content_sanskrit": "व्यास उवाच ।\nकैलासशिखरे रम्ये सुखासीनं महेश्वरं ।\nप्रणम्य शिरसा भूमौ स्कंदो वचनमब्रवीत्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000324002, "chapter_id": 20324, "verse_number": "१-७८-३", "content_sanskrit": "अर्काङ्गाख्यविधिस्त्वत्तो मयैवं विस्तराच्छ्रुतः ।\nवारादेर्यत्फलं नाथ श्रोतुमिच्छामि तत्त्वतः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000324003, "chapter_id": 20324, "verse_number": "१-७८-४", "content_sanskrit": "ईश्वर उवाच ।\nरक्तपुष्पै रवेर्वारे त्वर्घ्यं दद्याद्व्रती नरः ।\nनक्ताहारं हविष्यान्नं कृत्वा स्वर्गान्न हीयते॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000324004, "chapter_id": 20324, "verse_number": "१-७८-५", "content_sanskrit": "सप्तम्याश्च सदाचारं सर्वमेवार्कवासरे ।\nकुर्वतः प्रीतिमाप्नोति सगणः परमेश्वरः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000324005, "chapter_id": 20324, "verse_number": "१-७८-६", "content_sanskrit": "शूरस्य सदृशं याति तिथिवारस्य पालनात् ।\nएकेन गाणपत्यस्य यावत्सूरो नभस्तले॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000324006, "chapter_id": 20324, "verse_number": "१-७८-७", "content_sanskrit": "सर्वकामप्रदं पुण्यमैश्वर्यं रोगनाशनम् ।\nस्वर्गदं मोक्षदं पुण्यं रवेर्वारे व्रतं हितम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000324007, "chapter_id": 20324, "verse_number": "१-७८-८", "content_sanskrit": "रविवारेण संक्रांत्या सप्तम्या तद्दिने शिवे ।\nव्रतपूजादिकं चाप्यं सर्वं चाक्षयतां व्रजेत्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000324008, "chapter_id": 20324, "verse_number": "१-७८-९", "content_sanskrit": "आदित्यवासरे शुभ्रे ग्रहाधिपप्रपूजनम् ।\nप्राणादहतवक्त्रेण निःसार्य मंडले न्यसेत्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000324009, "chapter_id": 20324, "verse_number": "१-७८-१०", "content_sanskrit": "द्विभुजं रक्तपद्मस्थं सुगलं रक्तवाससं ।\nसर्वरक्ताभरणं ध्यात्वा हस्ताभ्यां पुष्पं विधृतसंघ्रायैशान्यां क्षिपेत्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000324010, "chapter_id": 20324, "verse_number": "१-७८-११", "content_sanskrit": "आदित्याय विद्महे भास्कराय धीमहि ।\nतन्नो भानुः प्रचोदयात्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000324011, "chapter_id": 20324, "verse_number": "१-७८-१२", "content_sanskrit": "ततो गुरूपदिष्टेन विधिना च विलेपनम् ।\nविलेपनांते सद्धूपं धूपांते च प्रदीपकम्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000324012, "chapter_id": 20324, "verse_number": "१-७८-१३", "content_sanskrit": "प्रदीपांते च नैवेद्यं ततो वारि निवेदयेत् ।\nततो जप्यं स्तुतिं मुद्रां नमस्कारं तु कारयेत्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000324013, "chapter_id": 20324, "verse_number": "१-७८-१४", "content_sanskrit": "अंजलि प्रथमा मुद्रा द्वितीया धेनुका स्मृता ।\nएवं यः पूजयेदर्कं रविसायुज्यमाव्रजेत्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000324014, "chapter_id": 20324, "verse_number": "१-७८-१५", "content_sanskrit": "मम ब्रह्मवधं घोरं कपालं करलग्नकम् ।\nरवेस्तस्यप्रसादात्तु मुक्तं वाराणसीतटे॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000324015, "chapter_id": 20324, "verse_number": "१-७८-१६", "content_sanskrit": "रवेः परतरं दैवं त्रैलोक्ये तु न विद्यते ।\nयस्य प्रसादतो घोरान्मुक्तोहं गुरुकिल्बिषात्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000324016, "chapter_id": 20324, "verse_number": "१-७८-१७", "content_sanskrit": "स्कंद उवाच ।\nश्रुत्वा त्वत्तो गिरं नाथ विस्मयो मेऽभवत्प्रभो ।\nत्वदन्योस्ति न को देवः कथं ब्रह्मवधं त्वयि॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000324017, "chapter_id": 20324, "verse_number": "१-७८-१८", "content_sanskrit": "त्वं च ज्ञानीश्वरो योगी लोके भोक्ताऽक्षरोऽव्ययः ।\nदेवानां गुरुरेकस्त्वं व्याप्तरूपी महेश्वरः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000324018, "chapter_id": 20324, "verse_number": "१-७८-१९", "content_sanskrit": "सर्वज्ञो वरदो नित्यं सर्वेषां प्राणिनां प्रभुः ।\nदुष्कृतं ते कुतो नाथ तथा क्रोधो विशेषतः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000324019, "chapter_id": 20324, "verse_number": "१-७८-२०", "content_sanskrit": "शिव उवाच ।\nलोकानां च हितार्थाय पृथग्भूता युगे युगे ।\nसर्वं कुर्मो वयं पुत्र ब्रह्मविष्णुमहेश्वराः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000324020, "chapter_id": 20324, "verse_number": "१-७८-२१", "content_sanskrit": "नास्माकं बंधमोक्षौ च नाकार्यं कार्यमेव वा ।\nतथा लोकस्य रक्षार्थं चरामो विधिपूर्वकम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000324021, "chapter_id": 20324, "verse_number": "१-७८-२२", "content_sanskrit": "सर्वं च परमं चैव सर्वविघ्नविनाशनम् ।\nसर्वरोगप्रशमनं सर्वार्थप्रतिसाधकम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000324022, "chapter_id": 20324, "verse_number": "१-७८-२३", "content_sanskrit": "एकोसौ बहुधा भूत्वा कालभेदादनिंदितः ।\nमासे मासे तु तपति एको द्वादशतां व्रजेत्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000324023, "chapter_id": 20324, "verse_number": "१-७८-२४", "content_sanskrit": "मित्रो मार्गशिरे मासि पौषे विष्णुः सनातनः ।\nवरुणो माघमासे तु सूर्यो वै फाल्गुने तथा॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000324024, "chapter_id": 20324, "verse_number": "१-७८-२५", "content_sanskrit": "चैत्रे मासि तपेद्भानुर्वैशाखे तापनः स्मृतः ।\nज्येष्ठमासे तपेदिंद्र आषाढे तपते रविः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000324025, "chapter_id": 20324, "verse_number": "१-७८-२६", "content_sanskrit": "गभस्तिः श्रावणे मासि यमो भाद्रपदे तथा ।\nहिरण्यरेताश्वयुजि कार्तिके तु दिवाकरः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000324026, "chapter_id": 20324, "verse_number": "१-७८-२७", "content_sanskrit": "इत्येते द्वादशादित्या मासि मासि प्रकीर्तिताः ।\nउरुरूपा महातेजा युगांतानलवर्चसः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000324027, "chapter_id": 20324, "verse_number": "१-७८-२८", "content_sanskrit": "य इदं पठते नित्यं तस्य पापं न विद्यते ।\nन रोगो न च दारिद्र्यं नावमानो भवेत्क्वचित्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000324028, "chapter_id": 20324, "verse_number": "१-७८-२९", "content_sanskrit": "अक्षयं लभते स्वर्गं सुखं राज्यं यशः क्रमात् ।\nमहामंत्रं प्रवक्ष्यामि सर्वप्रीतिकरं परम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000324029, "chapter_id": 20324, "verse_number": "१-७८-३०", "content_sanskrit": "ऊं नमः सहस्रबाहवे आदित्याय नमोनमः ।\nनमस्ते पद्महस्ताय वरुणाय नमोनमः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000324030, "chapter_id": 20324, "verse_number": "१-७८-३१", "content_sanskrit": "नमस्तिमिरनाशाय श्रीसूर्याय नमोनमः ।\nनमः सहस्रजिह्वाय भानवे च नमोनमः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000324031, "chapter_id": 20324, "verse_number": "१-७८-३२", "content_sanskrit": "त्वं च ब्रह्मा त्वं च विष्णू रुद्रस्त्वं च नमोनमः ।\nत्वमग्निः सर्वभूतेषु वायुस्त्वं च नमोनमः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000324032, "chapter_id": 20324, "verse_number": "१-७८-३३", "content_sanskrit": "सर्वगः सर्वभूतेषु नहि किंचित्त्वया विना ।\nचराचरे जगत्यस्मिन्सर्वदेहे व्यवस्थितः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000324033, "chapter_id": 20324, "verse_number": "१-७८-३४", "content_sanskrit": "इति जप्त्वा लभेत्कामं स्वर्गभोग्यादिकं क्रमात् ।\nआदित्यो भास्करः सूर्यो अर्को भानुर्दिवाकरः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000324034, "chapter_id": 20324, "verse_number": "१-७८-३५", "content_sanskrit": "सुवर्णरेता मित्रश्च पूषा त्वष्टा च ते दश ।\nस्वयंभूस्तिमिराशश्च द्वादशः परिकीर्तितः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000324035, "chapter_id": 20324, "verse_number": "१-७८-३६", "content_sanskrit": "नामान्येतानि सूर्यस्य शुचिर्यस्तु पठेन्नरः ।\nसर्वपापाच्च रोगाच्च मुक्तो याति परां गतिम्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000324036, "chapter_id": 20324, "verse_number": "१-७८-३७", "content_sanskrit": "पुनरन्यत्प्रवक्ष्यामि भास्करस्य महात्मनः ।\nरक्ताख्याये रक्तनिभास्सिंदूरारुणविग्रहाः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000324037, "chapter_id": 20324, "verse_number": "१-७८-३८", "content_sanskrit": "यानि नामानि मुख्यानि तच्छृणुष्व षडानन ।\nतपनस्तापनश्चैव कर्त्ता हर्त्ता ग्रहेश्वरः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000324038, "chapter_id": 20324, "verse_number": "१-७८-३९", "content_sanskrit": "लोकसाक्षी त्रिलोकेषु व्योमाधिपो दिवाकरः ।\nअग्निगर्भो महाविप्रः स्वर्गः सप्ताश्ववाहनः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000324039, "chapter_id": 20324, "verse_number": "१-७८-४०", "content_sanskrit": "पद्महस्तस्तमोभेदी ऋग्वेदो यजुस्सामगः ।\nकालप्रियं पुंडरीकं मूलस्थानं च भावितम्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000324040, "chapter_id": 20324, "verse_number": "१-७८-४१", "content_sanskrit": "यः स्मरेच्च सदा भक्त्या तस्य रोगभयं कुतः ।\nशृणु कार्तिक यत्नेन सर्वपापहरं शुभम्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000324041, "chapter_id": 20324, "verse_number": "१-७८-४२", "content_sanskrit": "न संदेहो मनाक्कार्य आदित्यस्य महामते ।\nऊं इंद्राय नमः ऊं विष्णवे नमः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000324042, "chapter_id": 20324, "verse_number": "१-७८-४३", "content_sanskrit": "एष जप्यश्च होमश्च संध्योपासनमेव च ।\nसर्वशांतिकरश्चैव सर्वविघ्नविनाशनः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000324043, "chapter_id": 20324, "verse_number": "१-७८-४४", "content_sanskrit": "नाशयेत्सर्वरोगांश्च लूताविस्फोटकादिकान् ।\nकामलादिकरोगांश्च ये रोगाश्चैव दारुणाः॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000324044, "chapter_id": 20324, "verse_number": "१-७८-४५", "content_sanskrit": "एकाहिकं त्र्यहिकं च ज्वरं चातुर्थिकं तथा ।\nकुष्ठं रोगं क्षयं रोगं कुक्षिरोगं ज्वरं तथा॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000324045, "chapter_id": 20324, "verse_number": "१-७८-४६", "content_sanskrit": "अश्मरीमूत्रंकृच्छ्रांश्च नानारोगामयांस्तथा ।\nये वातप्रभवा रोगा ये रोगा गर्भसंभवाः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000324046, "chapter_id": 20324, "verse_number": "१-७८-४७", "content_sanskrit": "मर्दयन्तो महारोगा मर्दिता वेदनात्मकाः ।\nविलयं यांति ते सर्व आदित्योच्चारणेन तु॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000324047, "chapter_id": 20324, "verse_number": "१-७८-४८", "content_sanskrit": "रक्ष मां देवदेवेश ग्रहरोगभयेषु च ।\nप्रशमं यांति ते सर्वे कीर्तिते तु दिवाकरे॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000324048, "chapter_id": 20324, "verse_number": "१-७८-४९", "content_sanskrit": "मूलमंत्रं प्रवक्ष्यामि सर्वकामार्थसाधकम् ।\nभुक्तिमुक्तिप्रदं नित्यं भास्करस्य महात्मनः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000324049, "chapter_id": 20324, "verse_number": "१-७८-५०", "content_sanskrit": "मंत्रश्चायं ॐ ह्रां ह्रीं सः सूर्याय नमः ।\nअनेन मंत्रेण सदा सर्वसिद्धिर्भवेद्ध्रुवं॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000324050, "chapter_id": 20324, "verse_number": "१-७८-५१", "content_sanskrit": "व्याधयो वै न बाधंते न चानिष्टं भयं भवेत् ।\nसूर्यावर्तोदकं यस्तु गृहीत्वा तु क्रमेण तु॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000324051, "chapter_id": 20324, "verse_number": "१-७८-५२", "content_sanskrit": "तस्य प्राशनमात्रेण नरो रोगात्प्रमुच्यते ।\nन दातव्यं न ख्यातव्यं जप्तव्यं च प्रयत्नतः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000324052, "chapter_id": 20324, "verse_number": "१-७८-५३", "content_sanskrit": "अभक्तेष्वनपत्येषु पाषण्डलौकिकेषु च ।\nकटुतैलसमायुक्तं नस्ये पाने च दापयेत्॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000324053, "chapter_id": 20324, "verse_number": "१-७८-५४", "content_sanskrit": "सूर्यावर्तजलं पुत्र सर्वरोगाद्विमुच्यते ।\nमूलमंत्रस्तु जप्तव्यः संध्यायां होमकर्मसु॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000324054, "chapter_id": 20324, "verse_number": "१-७८-५५", "content_sanskrit": "जप्यमाने तु नश्यंति रोगाः क्रूरग्रहास्तथा ।\nकिमन्यैर्बहुभिः शास्त्रैर्मंत्रैर्वा बहुविस्तरैः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000324055, "chapter_id": 20324, "verse_number": "१-७८-५६", "content_sanskrit": "सर्वशांतिरियं वत्स सर्वार्थप्रतिसाधिका ।\nनास्तिकाय न दातव्या देवब्राह्मणनिंदके॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000324056, "chapter_id": 20324, "verse_number": "१-७८-५७", "content_sanskrit": "गुरुभक्ताय दातव्या नान्येभ्योपि कदाचन ।\nप्रातरुत्थाय यो नित्यं कीर्तयिष्यति मानवः॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000324057, "chapter_id": 20324, "verse_number": "१-७८-५८", "content_sanskrit": "गोघ्नः कृतघ्नकश्चैव मुच्यते सर्वपातकैः ।\nशरीरारोग्यकृच्चैव धनवृद्धियशस्करः॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000324058, "chapter_id": 20324, "verse_number": "१-७८-५९", "content_sanskrit": "जायते नात्र संदेहो यस्य तुष्येद्दिवाकरः ।\nएककालं द्विकालं वा त्रिकालं नित्यमेव च॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000324059, "chapter_id": 20324, "verse_number": "१-७८-६०", "content_sanskrit": "यः पठेद्रविसान्निध्ये सोऽभीष्टं फलमाप्नुयात् ।\nपुत्रार्थी लभते पुत्रं कन्यार्थी कन्यकां लभेत्॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000324060, "chapter_id": 20324, "verse_number": "१-७८-६१", "content_sanskrit": "विद्यार्थी लभते विद्यां धनार्थी लभते धनं ।\nशृणुयात्संयुतो भक्त्या शुद्धाचारसमन्वितः॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000324061, "chapter_id": 20324, "verse_number": "१-७८-६२", "content_sanskrit": "सर्वपापविनिर्मुक्तस्सूर्यलोकं व्रजत्यपि ।\nभास्करस्य व्रते यच्च व्रताचारमखेषु च॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000324062, "chapter_id": 20324, "verse_number": "१-७८-६३", "content_sanskrit": "पुण्यस्थानेषु तीर्थेषु पठेत्कोटिगुणं भवेत् ।\nग्रहे भोज्येषु पूजायां ब्रह्मभोज्ये द्विजाग्रतः॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000324063, "chapter_id": 20324, "verse_number": "१-७८-६४", "content_sanskrit": "य इदं पठते विप्रस्तस्यानंतफलं भवेत् ।\nतपस्विनां च विप्राणां देवानामग्रतः सुधीः॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000324064, "chapter_id": 20324, "verse_number": "१-७८-६५", "content_sanskrit": "यः पठेत्पाठयेद्वापि सुरलोके महीयते॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]