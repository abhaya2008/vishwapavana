[{"id": 2134897, "chapter_id": 3916, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2134898, "chapter_id": 3916, "verse_number": "१", "content_sanskrit": "ततोऽर्जुनश्चित्रसेनं प्रहसन्निदमब्रवीत् ।\nमध्ये गन्धर्वसैन्यानां महेष्वासो महाद्युतिः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2134899, "chapter_id": 3916, "verse_number": "२", "content_sanskrit": "किं ते व्यवसितं वीर कौरवाणां विनिग्रहे ।\nकिमर्थं च सदारोऽयं निगृहीतः सुयोधनः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2134900, "chapter_id": 3916, "verse_number": "", "content_sanskrit": "चित्रसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2134901, "chapter_id": 3916, "verse_number": "३", "content_sanskrit": "विदितोऽयमभिप्रायस्तत्रस्थेन दुरात्मनः ।\nदुर्योधनस्य पापस्य कर्णस्य च धनञ्जयः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2134902, "chapter_id": 3916, "verse_number": "४", "content_sanskrit": "वनस्थान् भवतो ज्ञात्वा क्लिश्यमानाननाथवत् ।\nइमे च(ऽव)हसितुं प्राप्ता द्रौपदीं च यशस्विनीम् ।\nज्ञात्वा चिकीर्षितं चैषां मामुवाच सुरेश्वरः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2134903, "chapter_id": 3916, "verse_number": "५", "content_sanskrit": "गच्छ दुर्योधनं बद्ध्वा सहामात्यमिहानय ।\nधनञ्जयश्च ते रक्ष्यः सह भ्रातृभिराहवे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2134904, "chapter_id": 3916, "verse_number": "६", "content_sanskrit": "स च प्रियः सखा तुभ्यं शिष्यश्च तव पाण्डवः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2134905, "chapter_id": 3916, "verse_number": "७", "content_sanskrit": "वचनाद् देवराजस्य ततोऽस्मीहागतो द्रुतम् ।\nअयं दुरात्मा बद्धश्च गमिष्यामि सुरालयम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2134906, "chapter_id": 3916, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2134907, "chapter_id": 3916, "verse_number": "८", "content_sanskrit": "उत्सृज्यतां चित्रसेन भ्राताऽस्माकं सुयोधनः ।\nधर्मराजस्य सन्देशान्मम चेदिच्छसि प्रियम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2134908, "chapter_id": 3916, "verse_number": "", "content_sanskrit": "चित्रसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2134909, "chapter_id": 3916, "verse_number": "९", "content_sanskrit": "पापोऽयं नित्यसन्दुष्टो न विमोक्षणमर्हति ।\nप्रलब्धा धर्मराजस्य कृष्णायाश्च धनञ्जय \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2134910, "chapter_id": 3916, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2134911, "chapter_id": 3916, "verse_number": "१०", "content_sanskrit": "नेदं चिकीर्षितं तस्य कुन्तीपुत्रो महाव्रतः ।\nजानाति धर्मराजो हि श्रुत्वा कुरु यथेच्छसि \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2134912, "chapter_id": 3916, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2134913, "chapter_id": 3916, "verse_number": "११", "content_sanskrit": "ते सर्व एव राजानमभिजग्मुर्युधिष्ठिरम् ।\nअभिगम्य च तत्सर्वं शशंसुस्तस्य चेष्टितम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2134914, "chapter_id": 3916, "verse_number": "१२", "content_sanskrit": "अजातशत्रुस्तच्छ्रुत्वा गन्धर्वस्य वचस्तदा ।\nमोक्षयामास तान् सर्वान् गन्धर्वान् प्रशशंस च \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2134915, "chapter_id": 3916, "verse_number": "१३", "content_sanskrit": "दिष्ट्या भवद्भिर्बलिभिः शक्तैः सर्वैर्न हिंसितः ।\nदुर्वृत्तो धार्तराष्ट्रोऽयं सामात्यज्ञातिबान्धवः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2134916, "chapter_id": 3916, "verse_number": "१४", "content_sanskrit": "उपकारो महांस्तात कृतोऽयं मम खेचरैः ।\nकुलं न परिभूतं मे मोक्षणेऽस्य दुरात्मनः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2134917, "chapter_id": 3916, "verse_number": "१५", "content_sanskrit": "आज्ञापयध्वमिष्टानि प्रयामो दर्शनेन वः ।\nप्राप्य सर्वानभिप्रायांस्ततो व्रजत मा चिरम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2134918, "chapter_id": 3916, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2134919, "chapter_id": 3916, "verse_number": "१६", "content_sanskrit": "अनुज्ञातास्तु गन्धर्वाः पाण्डुपुत्रेण धीमता ।\nसहाप्सरोभिः संहृष्टाश्चित्रसेनमुखा ययुः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2134920, "chapter_id": 3916, "verse_number": "१७", "content_sanskrit": "देवलोकं ततो गत्वा गन्धर्वैः सहितस्तदा ।\nन्यवेदयच्च तत्सर्वं चित्रसेनः शतक्रतोः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2134921, "chapter_id": 3916, "verse_number": "१८", "content_sanskrit": "देवराडपि गन्धर्वान् मृतांस्तान् समजीवयत् ।\nदिव्येनामृतवर्षेण ये हताः कौरवैर्युधि \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2134922, "chapter_id": 3916, "verse_number": "१९", "content_sanskrit": "चित्रसेनस्तदा वाक्यमुवाच प्रौढया गिरा ।\nमुञ्चध्वं सानुजामात्यं सदारं च सुयोधनम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2134923, "chapter_id": 3916, "verse_number": "२०", "content_sanskrit": "गन्धर्वास्तु वचश्श्रुत्वा चित्रसेनस्य वैदृतम् ।\nराजानं मोचयामासुर्बद्धं निगडबन्धनैः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2134924, "chapter_id": 3916, "verse_number": "२१", "content_sanskrit": "सदारं सानुगामात्यं बाणजालमये वने ।\nलुण्ठतश्चाऽपि सर्वे युधिष्ठिरसमीपतः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2134925, "chapter_id": 3916, "verse_number": "२२", "content_sanskrit": "पतिताः लज्जिताश्चैव तस्थुश्चाधोमुखास्तदा ।\nयुधिष्ठिरोऽपि दयया तान् समीक्ष्य तथागतम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2134926, "chapter_id": 3916, "verse_number": "२३", "content_sanskrit": "ज्ञातींस्तानवमुच्याथ राजदारांश्च सर्वशः ।\nकृत्वा च दुष्करं कर्म प्रीतियुक्ताश्च पाण्डवाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2134927, "chapter_id": 3916, "verse_number": "२४", "content_sanskrit": "सस्त्रीकुमारैः कुरुभिः पूज्यमाना महारथाः ।\nबभ्राजिरे महात्मानः क्रतुमध्ये यथाऽग्नयः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2134928, "chapter_id": 3916, "verse_number": "२५", "content_sanskrit": "ततो दुर्योधनं मुक्तं भ्रातृभिः सहितस्तदा ।\nयुधिष्ठिरस्तु प्रणयादिदं वचनमब्रवीत् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2134929, "chapter_id": 3916, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2134930, "chapter_id": 3916, "verse_number": "२६", "content_sanskrit": "मा स्म तात पुनः कार्षीरीदृशं साहसं क्वचित् ।\nन हि साहसकर्तारः सुखमेधन्ति भारत \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2134931, "chapter_id": 3916, "verse_number": "२७", "content_sanskrit": "स्वस्तिमान् सहितः सर्वैर्भ्रातृभिः कुरुनन्दन ।\nगृहान् व्रज यथाकामं वैमनस्यं च मा कृथाः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2134932, "chapter_id": 3916, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2134933, "chapter_id": 3916, "verse_number": "२८", "content_sanskrit": "पाण्डवेनाभ्यनुज्ञातो राजा दुर्योधनस्तदा ।\nविदीर्यमाणो व्रीडावान् जगाम नगरं प्रति \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2134934, "chapter_id": 3916, "verse_number": "२९", "content_sanskrit": "तस्मिन् गते कौरवेये कुन्तीपुत्रो युधिष्ठिरः ।\nभ्रातृभिः सहितो वीरः पूज्यमानो द्विजातिभिः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2134935, "chapter_id": 3916, "verse_number": "३०", "content_sanskrit": "तपोधनैश्च तैः सर्वैर्वृतः शक्र इवामरैः ।\nतदा द्वैतवने तस्मिन् विजहार मुदा युतः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2134936, "chapter_id": 3916, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि घोषयात्रापर्वणि दुर्योधनमोक्षणे पञ्चत्रिंशदधिकद्विशततमोऽध्यायः ॥२३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2134937, "chapter_id": 3916, "verse_number": "११", "content_sanskrit": "घोषयात्रापर्वणि एकादशोऽध्यायः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2134938, "chapter_id": 3916, "verse_number": "", "content_sanskrit": "॥ समाप्तं घोषयात्रापर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]