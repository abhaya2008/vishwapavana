[{"id": 7004174000, "chapter_id": 24174, "verse_number": "५-१-२३-१", "content_sanskrit": "सनत्कुमार उवाच ।\nअथ यात्रां प्रवक्ष्यामि महाकालस्य यत्नतः ।\nशिवां श्रेयस्करीं पुण्यां पुण्यलोकप्रदायिनीम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004174001, "chapter_id": 24174, "verse_number": "५-१-२३-२", "content_sanskrit": "स्नात्वा सरसि रुद्रस्य दृष्ट्वा कोटेश्वरं शिवम् ।\nनमस्कृत्य ततो गच्छेन्महाकालं सनातनम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004174002, "chapter_id": 24174, "verse_number": "५-१-२३-३", "content_sanskrit": "गन्धैः पुष्पैर्नमस्कारैः संपूज्य त्रिदशेश्वरम् ।\nप्रणिपत्य ततो गच्छेद्देवं कपालमोचनम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004174003, "chapter_id": 24174, "verse_number": "५-१-२३-४", "content_sanskrit": "तत्रैव देवदेवेशः कपालं न्यस्तवान्क्षितौ ।\nकपाले तत्क्षणान्न्यस्ते तत्राभूल्लिंगमुत्तमम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004174004, "chapter_id": 24174, "verse_number": "५-१-२३-५", "content_sanskrit": "कपालमोचनं नाम सर्वपापप्रणाशनम् ।\nतत्र वै स्नपनं कुर्यादाज्यपलशतेन वै॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004174005, "chapter_id": 24174, "verse_number": "५-१-२३-६", "content_sanskrit": "तदर्धार्धेन पादेन वित्तशाठ्यविवर्जितः ।\nकाले पूर्णे स विप्रेन्द्र शिवलोके महीयते॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004174006, "chapter_id": 24174, "verse_number": "५-१-२३-७", "content_sanskrit": "नमस्कृत्य ततो गच्छेत्कपिलेश्वरमुत्तमम् ।\nदर्शनादस्य देवस्य मुच्यते ब्रह्महत्यया॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004174007, "chapter_id": 24174, "verse_number": "५-१-२३-८", "content_sanskrit": "हनुमत्केश्वरं देवं ततो गच्छेत्समाहितः ।\nऐश्वर्यमतुलं व्यास दर्शनादस्य जायते॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004174008, "chapter_id": 24174, "verse_number": "५-१-२३-९", "content_sanskrit": "ततो गच्छेन्महादेवं पैप्पलाख्यं सनातनम् ।\nयस्य दर्शनमात्रेण मुक्तिः स्याद्द्विजसत्तम॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004174009, "chapter_id": 24174, "verse_number": "५-१-२३-१०", "content_sanskrit": "स्वप्नेश्वरं ततो गच्छेद्भक्तिश्रद्धासमन्वितः ।\nदर्शनादस्य देवस्य दुःस्वप्नं च विनश्यति॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004174010, "chapter_id": 24174, "verse_number": "५-१-२३-११", "content_sanskrit": "ततो गच्छेन्महादेवमीशानं विश्वतोमुखम् ।\nयस्य दर्शनमात्रेण विश्वस्यैव पतिर्भवेत्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004174011, "chapter_id": 24174, "verse_number": "५-१-२३-१२", "content_sanskrit": "सोमेश्वरं ततो गच्छेज्जितक्रोधो जितेंद्रियः ।\nकुष्ठरोगादिदोषेभ्यो दर्शनादस्य मुच्यते॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004174012, "chapter_id": 24174, "verse_number": "५-१-२३-१३", "content_sanskrit": "वैश्वानरेश्वरं व्यास ततो गच्छेत्समाहितः ।\nतस्य वृद्धिः सदा लोके जायते तस्य दर्शनात्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004174013, "chapter_id": 24174, "verse_number": "५-१-२३-१४", "content_sanskrit": "बीजपूरकहस्तं तु लकु लीशं ततो व्रजेत् ।\nरुद्रत्वं दर्शनात्तस्य जायते नात्र संशयः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004174014, "chapter_id": 24174, "verse_number": "५-१-२३-१५", "content_sanskrit": "ततो गच्छेन्महादेवं गद्याणेश्वरमुत्तमम् ।\nयस्य दर्शनमात्रेण जायंते सर्व सिद्धयः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004174015, "chapter_id": 24174, "verse_number": "५-१-२३-१६", "content_sanskrit": "अभ्यर्थितः सदा देवैः पूजितः सिद्धिकारणात् ।\nतेनाभ्यर्थितेश्वरोऽयं विख्यातो विघ्ननायकः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004174016, "chapter_id": 24174, "verse_number": "५-१-२३-१७", "content_sanskrit": "वयोवृद्धं ततो गच्छेन्महाकालं सनातनम् ।\nन रोगो न जराव्याधिर्दर्शनान्नात्र संशयः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004174017, "chapter_id": 24174, "verse_number": "५-१-२३-१८", "content_sanskrit": "विघ्ननाशं ततो गच्छेत्प्राणीशं बलमुत्तमम् ।\nस्नानं घटशतैस्तस्य कुर्याद्भक्त्या समाहितः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004174018, "chapter_id": 24174, "verse_number": "५-१-२३-१९", "content_sanskrit": "तस्य चैव कृते स्नाने लभ्यंते सर्वसिद्धयः ।\nस्वर्गश्चापि सदा व्यास दर्शनादस्य जायते॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004174019, "chapter_id": 24174, "verse_number": "५-१-२३-२०", "content_sanskrit": "तनयं तमनूल्लंघ्य दंड पाणिं ततो व्रजेत् ।\nयस्य दर्शनमात्रेण यमलोको न दृश्यते॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004174020, "chapter_id": 24174, "verse_number": "५-१-२३-२१", "content_sanskrit": "पुष्पदन्तं ततो गच्छेद्भक्तिश्रद्धासमन्वितः ।\nयस्य दर्शनमात्रेण मुच्यते सर्वपातकैः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004174021, "chapter_id": 24174, "verse_number": "५-१-२३-२२", "content_sanskrit": "गुह्यं चैव महाकालं ततो गच्छेत्समाहितः ।\nयस्य दर्शनमात्रेण गुह्यपापैः प्रमुच्यते॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004174022, "chapter_id": 24174, "verse_number": "५-१-२३-२३", "content_sanskrit": "ततो गच्छेत्समाधिस्थो दुर्वासेश्वरमुत्तमम् ।\nयस्य दर्शनमात्रेण कृतकृत्यो नरो भवेत्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004174023, "chapter_id": 24174, "verse_number": "५-१-२३-२४", "content_sanskrit": "श्वासावरोधनं कृत्वा दुर्वाससः समीपतः ।\nगौरीं गत्वा महादुर्गां त्यजेच्छ्वासमनंतरम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004174024, "chapter_id": 24174, "verse_number": "५-१-२३-२५", "content_sanskrit": "तत्रोच्छ्वासो विमोक्त्यस्तामभ्यर्च्य तु सर्वथा ।\nकालेश्वरं ततो गच्छेद्देवदेवं महेश्वरम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004174025, "chapter_id": 24174, "verse_number": "५-१-२३-२६", "content_sanskrit": "यस्य दर्शनमात्रेण यमलोकं न पश्यति ।\nविधीशं च ततो गच्छेद्देवदेवं महेश्वरम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004174026, "chapter_id": 24174, "verse_number": "५-१-२३-२७", "content_sanskrit": "यस्य दर्शनमात्रेण बधिरत्वं न जायते ।\nकीर्तयेदात्मनो नाम स्थानं गोत्रं च तस्य वै॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004174027, "chapter_id": 24174, "verse_number": "५-१-२३-२८", "content_sanskrit": "न कीर्तयेद्यदा नाम सा यात्रा विफली भवेत् ।\nदेवस्याग्रे ततो व्यास उपविश्य समाहितः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004174028, "chapter_id": 24174, "verse_number": "५-१-२३-२९", "content_sanskrit": "भक्तियुक्तस्ततो ब्रूयान्नमस्कृत्वा पुनःपुनः ।\nमया समर्पिता यात्रा त्वत्प्रसादान्महेश्वर॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004174029, "chapter_id": 24174, "verse_number": "५-१-२३-३०", "content_sanskrit": "संसारसागराद्धोरान्मामुद्धर जगत्पते ।\nअनेन विधिना यस्तु महाकालं प्रदक्षयेत्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004174030, "chapter_id": 24174, "verse_number": "५-१-२३-३१", "content_sanskrit": "प्रदक्षिणीकृता तेन सप्तद्वीपा वसुंधरा ।\nगोलक्षं द्विजलक्षाय दत्त्वा यल्लभते फलम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004174031, "chapter_id": 24174, "verse_number": "५-१-२३-३२", "content_sanskrit": "तत्फलं देवदेवस्य सकृद्दत्त्वा प्रदक्षिणम् ।\nभक्त्या परमया युक्तो महाकालं प्रदक्षयेत्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004174032, "chapter_id": 24174, "verse_number": "५-१-२३-३३", "content_sanskrit": "पदेपदे यज्ञफलमिति मे शंकरोऽब्रवीत् ।\nषष्टिकोटि सहस्राणि षष्टिकोटिशतानि च॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004174033, "chapter_id": 24174, "verse_number": "५-१-२३-३४", "content_sanskrit": "पूजितानि भवंत्यत्र यात्रेश्वरसमर्चनात् ।\nय एवं कुरुते यात्रां शिवध्यानपरायणः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004174034, "chapter_id": 24174, "verse_number": "५-१-२३-३५", "content_sanskrit": "सहस्रदक्षिणां दद्यात्तस्य पुण्यफलं शृणु ।\nसप्तजन्मकृतात्पापान्मुच्यते नात्र संशयः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004174035, "chapter_id": 24174, "verse_number": "५-१-२३-३६", "content_sanskrit": "एवं यात्रां समाप्याथ गत्वा निजगृहं नरः ।\nयात्रादैवत संख्यान्वै षड्विंशतिद्विजोत्तमान्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004174036, "chapter_id": 24174, "verse_number": "५-१-२३-३७", "content_sanskrit": "भोजयेच्छिवभक्तांश्च शिवध्यानपरायणान् ।\nसवस्त्रां दक्षिणां दत्त्वा प्राप्यानुज्ञां विसर्जयेत्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004174037, "chapter_id": 24174, "verse_number": "५-१-२३-३८", "content_sanskrit": "यात्राक्रमेण चैकैकं द्वारांतरमनुव्रजेत् ।\nधर्मोपदेशके पश्चात्सर्वोपस्करसंयुताम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004174038, "chapter_id": 24174, "verse_number": "५-१-२३-३९", "content_sanskrit": "धेनुं पयस्विनीं दद्याद्वित्तशाठ्यविवर्जितः ।\nभुञ्जीताथ स्वयं व्यास सर्वभृत्यसमन्वितः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004174039, "chapter_id": 24174, "verse_number": "५-१-२३-४०", "content_sanskrit": "दीनानाथदरिद्रांधविकलाद्यांश्च भोजयेत् ।\nयदत्र फलमुद्दिष्टं तद्वदामि शृणुष्व मे॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004174040, "chapter_id": 24174, "verse_number": "५-१-२३-४१", "content_sanskrit": "कुलानां शतमुद्धृत्य मातापित्रोः समाहितः ।\nकल्पकोटिसहस्राणि शिवलोके स मोदते॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]