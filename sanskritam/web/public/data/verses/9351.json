[{"id": 40021211, "chapter_id": 9351, "verse_number": "1", "content_sanskrit": "नर्मदापुलिने यत्र राक्षसेन्द्रः सुदारुणः । पुष्पोपहारं कुरुते तस्माद्देशाददूरतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40021212, "chapter_id": 9351, "verse_number": "2", "content_sanskrit": "अर्जुनो जयतां श्रेष्ठो माहिष्मत्याः पतिः प्रभुः । क्रीडते सह नारीभिर्नर्मदातोयमाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40021213, "chapter_id": 9351, "verse_number": "3", "content_sanskrit": "तासां मध्यगतो राजा रराज च तदार्जुनः । करेणूनां सहस्रस्य मध्यस्थ इव कुञ्जरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40021214, "chapter_id": 9351, "verse_number": "4", "content_sanskrit": "जिज्ञासुः स तु बाहूनां सहस्रस्योत्तमं बलम् । रुरोध नर्मदावेगं बाहुभिर्बहुभिर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40021215, "chapter_id": 9351, "verse_number": "5", "content_sanskrit": "कार्तवीर्यभुजासक्तं तज्जलं प्राप्य निर्मलम् । कूलोपहारं कुर्वाणं प्रतिस्रोतः प्रधावति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40021216, "chapter_id": 9351, "verse_number": "6", "content_sanskrit": "समीननक्रमकरः सपुष्पकुशसंस्तरः । स नर्मदाम्भसो वेगः प्रावृट्काल इवाबभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40021217, "chapter_id": 9351, "verse_number": "7", "content_sanskrit": "स वेगः कार्तवीर्येण सम्प्रेषित इवाम्भसः । पुष्पोपहारं सकलं रावणस्य जहार ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40021218, "chapter_id": 9351, "verse_number": "8", "content_sanskrit": "रावणो ऽर्धसमाप्तं तमुत्सृज्य नियमं तदा । नर्मदां पश्यते कान्तां प्रतिकूलां यथा प्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40021219, "chapter_id": 9351, "verse_number": "9", "content_sanskrit": "पश्चिमेन तु तं दृष्ट्वा सागरोद्गारसन्निभम् । वर्धन्तमम्भसो वेगं पूर्वामाशां प्रविश्य तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40021220, "chapter_id": 9351, "verse_number": "10", "content_sanskrit": "ततो ऽनुभ्रान्तशकुनां स्वभावोपरमे स्थिताम् । निर्विकाराङ्गनाभासामपश्यद्रावणो नदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40021221, "chapter_id": 9351, "verse_number": "11", "content_sanskrit": "सव्येतरकराङ्गुल्या सशब्दं च दशाननः । वेगप्रभावमन्वेष्टुं सो ऽदिशच्छुकसारणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40021222, "chapter_id": 9351, "verse_number": "12", "content_sanskrit": "तौ तु रावणसन्दिष्टौ भ्रातरौ शुकसारणौ । व्योमान्तरगतौ वीरौ प्रस्थितौ पश्चिमामुखौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40021223, "chapter_id": 9351, "verse_number": "13", "content_sanskrit": "अर्धयोजनमात्रं तु गत्वा तौ रजनीचरौ । पश्येतां पुरुषं तोये क्रीडन्तं सहयोषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40021224, "chapter_id": 9351, "verse_number": "14", "content_sanskrit": "बृहत्सालप्रतीकाशं तोयव्याकुलमूर्धजम् । मदरक्तान्तनयनं मदव्याकुलतेजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40021225, "chapter_id": 9351, "verse_number": "15", "content_sanskrit": "नदीं बाहुसहस्रेण रुन्धन्तमरिमर्दनम् । गिरिं पादसहस्रेण रुन्धन्तमिव मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40021226, "chapter_id": 9351, "verse_number": "16", "content_sanskrit": "बालानां वरनारीणां सहस्रेण समावृतम् । समदानां करेणूनां सहस्रेणेव कुञ्जरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40021227, "chapter_id": 9351, "verse_number": "17", "content_sanskrit": "तमद्भुततमं दृष्ट्वा राक्षसौ शुकसारणौ । सन्निवृत्तावुपागम्य रावणं तमथोचतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40021228, "chapter_id": 9351, "verse_number": "18", "content_sanskrit": "बृहत्सालप्रतीकाशः को ऽप्यसौ राक्षसेश्वर । नर्मदां रोधवद्रुद्ध्वा क्रीडापयति योषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40021229, "chapter_id": 9351, "verse_number": "19", "content_sanskrit": "तेन बाहुसहस्रेण सन्निरुद्धजला नदी । सागरोद्गारसङ्काशानुद्गारान्सृजते मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40021230, "chapter_id": 9351, "verse_number": "20", "content_sanskrit": "इत्येवं भाषमाणौ तौ निशाम्य शुकसारणौ । रावणो ऽर्जुन इत्युक्त्वा प्रययौ युद्धलालसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40021231, "chapter_id": 9351, "verse_number": "21", "content_sanskrit": "अर्जुनाभिमुखे तस्मिन्रावणे राक्षसाधिपे । चण्डः प्रवाति पवनः सनादः सुरजास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40021232, "chapter_id": 9351, "verse_number": "22", "content_sanskrit": "सकृदेव कृतो रावः सरक्तः प्रेषितो घनैः । महोदरमहापार्श्वधूम्राक्षशुकसारणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40021233, "chapter_id": 9351, "verse_number": "23", "content_sanskrit": "संवृतो राक्षसेन्द्रस्तु तत्रागाद्यत्र चार्जुनः । अदीर्घेणैव कालेन स तदा राक्षसो बली । तं नर्मदाह्रदं भीममाजगामाञ्जनप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40021234, "chapter_id": 9351, "verse_number": "24", "content_sanskrit": "स तत्र स्त्रीपरिवृतं वाशिताभिरिव द्विपम् । नरेन्द्रं पश्यते राजा राक्षसानां तदार्जुनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40021235, "chapter_id": 9351, "verse_number": "25", "content_sanskrit": "स रोषाद्रक्तनयनो राक्षसेन्द्रो बलोद्धतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40021236, "chapter_id": 9351, "verse_number": "26", "content_sanskrit": "इत्येवमर्जुनामात्यनाह गम्भीरया गिरा । अमात्याः क्षिप्रमाख्यात हैहयस्य नृपस्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40021237, "chapter_id": 9351, "verse_number": "27", "content_sanskrit": "युद्धार्थी समनुप्राप्तो रावणो नाम राक्षसः । रावणस्य वचः श्रुत्वा मन्त्रिणो ऽथार्जुनस्य ते । उत्तस्थुः सायुधास्त्राश्च रावणं वाक्यमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40021238, "chapter_id": 9351, "verse_number": "28", "content_sanskrit": "युद्धस्य कालो विज्ञेयः साधु भोः साधु रावण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40021239, "chapter_id": 9351, "verse_number": "29", "content_sanskrit": "चः श्रुत्वा मन्त्रिणो ऽथार्जुनस्य ते । यः क्षीबं स्त्रीवृतं चैव योद्धुमुत्सहते नृपम् । स्त्रीसमक्षं कथं यत्तद्योद्धुमुत्सहसे ऽर्जुनम् । वाशितामध्यगं मत्तं शार्दूल इव कुञ्जरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40021240, "chapter_id": 9351, "verse_number": "30", "content_sanskrit": "क्षमस्वाद्य दशग्रीव चोष्यतां रजनी त्वया । युद्धे श्रद्धा च यद्यस्ति श्वस्तात समरे ऽर्जुनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40021241, "chapter_id": 9351, "verse_number": "31", "content_sanskrit": "यद्यद्यास्ति मतिर्योद्धुं युद्धतृष्णासमावृता । निहत्यास्मांस्ततो युद्धमर्जुनेनोपयास्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40021242, "chapter_id": 9351, "verse_number": "32", "content_sanskrit": "ततस्ते रावणामात्यैरमात्याः पार्थिवस्य तु । सूदिताश्चापि ते युद्धे भक्षिताश्च बुभुक्षितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40021243, "chapter_id": 9351, "verse_number": "33", "content_sanskrit": "ततो हलहलाशब्दो नर्मदातीर आबभौ । अर्जुनस्यानुयातऽणां रावणस्य च मन्त्रिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40021244, "chapter_id": 9351, "verse_number": "34", "content_sanskrit": "इषुभिस्तोमरैः शूलैस्त्रिशूलैर्वज्रकर्षणैः । सरावणानर्दयन्तः समन्तात्समभिद्रुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40021245, "chapter_id": 9351, "verse_number": "35", "content_sanskrit": "हैहयाधिपयोधानां वेग आसीत्सुदारुणः । सनक्रमीनमकरसमुद्रस्येव निःस्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40021246, "chapter_id": 9351, "verse_number": "36", "content_sanskrit": "रावणस्य तु ते ऽमात्याः प्रहस्तशुकसारणाः । कार्तवीर्यबलं क्रुद्धा निर्दहन्ति स्म तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40021247, "chapter_id": 9351, "verse_number": "37", "content_sanskrit": "अर्जुनाय तु तत्कर्म रावणस्य समन्त्रिणः । क्रीडमानाय कथितं पुरुषैर्द्वाररक्षिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40021248, "chapter_id": 9351, "verse_number": "38", "content_sanskrit": "श्रुत्वा न भेतव्यमिति स्त्रीजनं तं ततो ऽर्जुनः । उत्ततार जलात्तस्माद्गङ्गातोयादिवाञ्जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40021249, "chapter_id": 9351, "verse_number": "39", "content_sanskrit": "क्रोधदूषितनेत्रस्तु स ततो ऽर्जुनपावकः । प्रजज्वाल महाघोरो युगान्त इव पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40021250, "chapter_id": 9351, "verse_number": "40", "content_sanskrit": "स तूर्णतरमादाय वरहेमाङ्गदो गदाम् । अभिदुद्राव रक्षांसि तमांसीव दिवाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40021251, "chapter_id": 9351, "verse_number": "41", "content_sanskrit": "बाहुविक्षेपकरणां समुद्यम्य महागदाम् । गारुडं वेगमास्थाय चापपातैव सो ऽर्जुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40021252, "chapter_id": 9351, "verse_number": "42", "content_sanskrit": "तस्य मार्गं समारुद्ध्य विन्ध्यो ऽर्कस्येव पर्वतः । स्थितो विन्ध्य इवाकम्प्यः प्रहस्तो मुसलायुधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40021253, "chapter_id": 9351, "verse_number": "43", "content_sanskrit": "ततो ऽस्य मुसलं घोरं लोहबद्धं महोद्धतः । प्रहस्तः प्रेषयन्क्रुद्धो ररास च यथाम्बुदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40021254, "chapter_id": 9351, "verse_number": "44", "content_sanskrit": "तस्याग्रे मुसलस्याग्निरशोकापीडसन्निभः । प्रहस्तकरमुक्तस्य बभूव प्रदहन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40021255, "chapter_id": 9351, "verse_number": "45", "content_sanskrit": "अथायान्तं तु मुसलं कार्तवीर्यस्तदार्जुनः । निपुणं वञ्चयामास सगदो ऽगदविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40021256, "chapter_id": 9351, "verse_number": "46", "content_sanskrit": "ततस्तमभिदुद्राव प्रहस्तं हैहयाधिपः । भ्रामयानो गदां गुर्वीं पञ्चबाहुशतोच्छ्रयाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40021257, "chapter_id": 9351, "verse_number": "47", "content_sanskrit": "तथा हतो ऽतिवेगेन प्रहस्तो गदया तदा । निपपात स्थितः शैलो वज्रिवज्रहतो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40021258, "chapter_id": 9351, "verse_number": "48", "content_sanskrit": "प्रहस्तं पतितं दृष्ट्वा मारीचशुकसारणाः । समहोदरधूम्राक्षा ह्यपसृष्टा रणाजिरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40021259, "chapter_id": 9351, "verse_number": "49", "content_sanskrit": "अपक्रान्तेष्वमात्येषु प्रहस्ते वै निपातिते । रावणो ऽभ्यद्रवत्तूर्णमर्जुनं नृपसत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40021260, "chapter_id": 9351, "verse_number": "50", "content_sanskrit": "सहस्रबाहोस्तद्युद्धं विंशद्बाहोश्च दारुणम् । नृपराक्षसयोस्तत्र चारब्धं रोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 40021261, "chapter_id": 9351, "verse_number": "51", "content_sanskrit": "सागराविव संरब्धौ चलन्मूलाविवाचलौ । तेजोयुक्ताविवादित्यौ प्रदहन्ताविवानलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 40021262, "chapter_id": 9351, "verse_number": "52", "content_sanskrit": "बलोद्धतौ यथा नागौ वाशितार्थे यथा वृषौ । मेघाविव विनर्दन्तौ सिंहाविव बलोत्कटौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 40021263, "chapter_id": 9351, "verse_number": "53", "content_sanskrit": "रुद्रकालाविव क्रुद्धौ तदा तौ राक्षसार्जुनौ । परस्परं गदाभ्यां तौ ताडयामासतुर्भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 40021264, "chapter_id": 9351, "verse_number": "54", "content_sanskrit": "वज्रप्रहारानचला यथा घोरान्विषेहिरे । गदाप्रहारांस्तौ तत्र सेहाते नरराक्षसौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 40021265, "chapter_id": 9351, "verse_number": "55", "content_sanskrit": "यथा ऽ शनिरवेभ्यस्तु जायते ऽथ प्रतिश्रुतिः । तथा तयोर्गदापोथैर्दिशः सर्वाः प्रतिश्रुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 40021266, "chapter_id": 9351, "verse_number": "56", "content_sanskrit": "अर्जुनस्य गदा सा तु पात्यमाना ऽहितोरसि । काञ्चनाभं नभश्चक्रे विद्युत्सौदामिनी यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 40021267, "chapter_id": 9351, "verse_number": "57", "content_sanskrit": "तथैव रावणेनापि पात्यमाना मुहुर्मुहुः । अर्जुनोरसि निर्भाति गदोल्केव महागिरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 40021268, "chapter_id": 9351, "verse_number": "58", "content_sanskrit": "नार्जुनः खेदमायाति न राक्षसगणेश्वरः । इदमासीत्तयोर्युद्धं यथा पूर्वं बलीन्द्रयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 40021269, "chapter_id": 9351, "verse_number": "59", "content_sanskrit": "शृङ्गैरिव वृषायुध्यन्दन्ताग्रैरिव कुञ्जरौ । परस्परं तौ निघ्नन्तौ नरराक्षससत्तमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 40021270, "chapter_id": 9351, "verse_number": "60", "content_sanskrit": "ततो ऽर्जुनेन क्रुद्धेन सर्वप्राणेन सा गदा । स्तनयोरन्तरे मुक्ता रावणस्य महोरसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 40021271, "chapter_id": 9351, "verse_number": "61", "content_sanskrit": "वरदानकृतत्राणे सा गदा रावणोरसि । दुर्बलेव यथावेगं द्विधाभूत्वा ऽपतत्क्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 40021272, "chapter_id": 9351, "verse_number": "62", "content_sanskrit": "स त्वर्जुनप्रमुक्तेन गदापातेन रावणः । अपासर्पद्धनुर्मात्रं निषसाद च निष्टनन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 40021273, "chapter_id": 9351, "verse_number": "63", "content_sanskrit": "स विह्वलं तदालक्ष्य दशग्रीवं ततो ऽर्जुनः । सहसोत्पत्य जग्राह गरुत्मानिव पन्नगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 40021274, "chapter_id": 9351, "verse_number": "64", "content_sanskrit": "स तु बाहुसहस्रेण बलाद्गृह्य दशाननम् । बबन्ध बलवान्राजा बलिं नारायणो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 40021275, "chapter_id": 9351, "verse_number": "65", "content_sanskrit": "बध्यमाने दशग्रीवे सिद्धचारणदेवताः । साध्वीतिवादिनः पुष्पैः किरन्त्यर्जुनमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 40021276, "chapter_id": 9351, "verse_number": "66", "content_sanskrit": "व्याघ्रो मृगमिवादाय मृगराडिव दन्तिनम् । ननाद हैहयो राजा हर्षादम्बुदवन्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 40021277, "chapter_id": 9351, "verse_number": "67", "content_sanskrit": "प्रहस्तस्तु समाश्वस्तो दृष्ट्वा बद्धं दशाननम् । सह तै राक्षसैः क्रुद्धश्चाभिदुद्राव पार्थिवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 40021278, "chapter_id": 9351, "verse_number": "68", "content_sanskrit": "नक्तञ्चराणां वेगस्तु तेषामापततां बभौ । उद्भूत आतपापाये पयोदानामिवाम्बुधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 40021279, "chapter_id": 9351, "verse_number": "69", "content_sanskrit": "मुञ्च मुञ्चेति भाषन्तस्तिष्ठतिष्ठेति चासकृत् । मुसलानि सशूलानि सोत्ससर्ज तदार्जुने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 40021280, "chapter_id": 9351, "verse_number": "70", "content_sanskrit": "अप्राप्तान्येव तान्याशु असम्भ्रान्तस्तदार्जुनः । आयुधान्यमरारीणां जग्राहारिनिषूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 40021281, "chapter_id": 9351, "verse_number": "71", "content_sanskrit": "ततस्तैरेव रक्षांसि दुर्धरैः प्रवरायुधैः । भित्त्वा विद्रावयामास वायुरम्बुधरानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 40021282, "chapter_id": 9351, "verse_number": "72", "content_sanskrit": "राक्षसांस्त्रासयित्वा तु कार्तवीर्यो ऽर्जुनस्तदा । रावणं गृह्य नगरं प्रविवेश सुहृद्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 40021283, "chapter_id": 9351, "verse_number": "73", "content_sanskrit": "स कीर्यमाणः कुसुमाक्षतोत्करैर्द्विजैः सपौरैः पुरुहूतसन्निभः । तदा ऽर्जुनः सम्प्रविवेश तां पुरीं बलिं निगृह्येव सहस्रलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]