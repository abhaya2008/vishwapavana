[{"id": 2014825, "chapter_id": 1309, "verse_number": "२-५०-१", "content_sanskrit": "भीष्म उवाच॥\nशृणु राजंस्ततो विष्णोः प्रादुर्भावं महात्मनः।\nअष्टाविंशे युगे चापि मार्कण्डेयपुरः सरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2014826, "chapter_id": 1309, "verse_number": "२-५०-२", "content_sanskrit": "तिथौ नावमिके जज्ञे तथा दशरथादपि।\nकृत्वाऽऽत्मानं महाबाहुश्चतुर्धा विष्णुरव्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2014827, "chapter_id": 1309, "verse_number": "२-५०-३", "content_sanskrit": "लोके राम इति ख्यातस्तेजसा भास्करोपमः।\nप्रसादनार्थं लोकस्य विष्णुस्तत्र सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2014828, "chapter_id": 1309, "verse_number": "२-५०-४", "content_sanskrit": "धर्मार्थमेव कौन्तेय जज्ञे तत्र महायशाः।\nतमप्याहुर्मनुष्येन्द्रं सर्वभूतपतेस्तनुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2014829, "chapter_id": 1309, "verse_number": "२-५०-५", "content_sanskrit": "यज्ञविघ्नकरस्तत्र विश्वामित्रस्य भारत।\nसुबाहुर्निहतस्तेन मारीचस्ताडितो भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2014830, "chapter_id": 1309, "verse_number": "२-५०-६", "content_sanskrit": "तस्मै दत्तानि चास्राणि विश्वमित्रेण धीमता।\nवधार्थं सर्वशत्रूणां दुर्वाराणि सुरैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2014831, "chapter_id": 1309, "verse_number": "२-५०-७", "content_sanskrit": "वर्तमाने महायज्ञे जनकस्य महात्मनः।\nभग्नं माहेश्वरं चापं क्रीडता लीलया भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2014832, "chapter_id": 1309, "verse_number": "२-५०-८", "content_sanskrit": "ततस्तु सीतां जग्राह भार्यार्थे जानकीं विभुः।\nनगरीं पुनरासाद्य मुमुदे तत्र सीतया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2014833, "chapter_id": 1309, "verse_number": "२-५०-९", "content_sanskrit": "कस्यचित्त्वथ कालस्य पित्रा तत्राभिचोदितः।\nकैकेय्याः प्रियमन्विच्छन्वनमभ्यवपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2014834, "chapter_id": 1309, "verse_number": "२-५०-१०", "content_sanskrit": "यः समाः सर्वधर्मज्ञश्चतुर्दश वने वसन।\nलक्ष्मणानुचरो रामः सर्वभूतहिते रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2014835, "chapter_id": 1309, "verse_number": "२-५०-११", "content_sanskrit": "चतुर्दश वने तीर्त्वा तदा वर्षाणि भारत।\nरूपिणी यस्य पार्श्वस्था सीतेत्यभिहिता जनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2014836, "chapter_id": 1309, "verse_number": "२-५०-१२", "content_sanskrit": "पूर्वोचितत्वात्सा लक्ष्मीर्भर्तारमनुशोचति।\nजनस्थाने वसन्कार्यं त्रिदशानां चकार सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2014837, "chapter_id": 1309, "verse_number": "२-५०-१३", "content_sanskrit": "मारीचं दूषणं हुत्वा खरं त्रिशिरसं तथा।\nचतुर्दश सहस्राणि रक्षसां घोरकर्मणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2014838, "chapter_id": 1309, "verse_number": "२-५०-१४", "content_sanskrit": "जघान रामो धर्मात्मा प्रजानां हितकाम्यय।\nविराधं च कबन्धं च राक्षसौ घोरकर्मिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2014839, "chapter_id": 1309, "verse_number": "२-५०-१५", "content_sanskrit": "जघान च तदा रामो गन्धर्वौ शाषविक्षतौ।\nस रावणस्य भगिनीनासाच्छेदमकारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2014840, "chapter_id": 1309, "verse_number": "२-५०-१६", "content_sanskrit": "भार्यावियोगं तं प्राप्य मृगयन्व्यचरद्वनम्।\nस तस्मादृश्यमूकं तु गत्वा पम्पामतीत्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2014841, "chapter_id": 1309, "verse_number": "२-५०-१७", "content_sanskrit": "सुग्रीवं मारुतिं दृष्ट्वा चक्रे मैत्रीं तयोः स वै।\nअथ गत्वा स किष्किन्धां सुग्रीवेण तदा सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2014842, "chapter_id": 1309, "verse_number": "२-५०-१८", "content_sanskrit": "निहत्य वालिनं युद्धे वानरेद्रं महाबलम्।\nअभ्यपिञ्चत्तदा रामः सुग्रीवं वानरेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2014843, "chapter_id": 1309, "verse_number": "२-५०-१९", "content_sanskrit": "ततः स वीर्यवान्राजंस्त्वरया वै समुत्सुकः।\nविचित्य वायुपुत्रेण लङ्कादेशं निवेदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2014844, "chapter_id": 1309, "verse_number": "२-५०-२०", "content_sanskrit": "मेतुं वद्ध्वा समुद्रस्य वानरैः स समुत्सुकः।\nसीतायाः पदमन्विच्छन्रामो लङ्कां विवेश वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2014845, "chapter_id": 1309, "verse_number": "२-५०-२१", "content_sanskrit": "देवोरगगणानां हि यक्षराक्षसपक्षिणाम्।\nतत्रावद्यं राक्षसेन्द्रं रावणं युधि दुर्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2014846, "chapter_id": 1309, "verse_number": "२-५०-२२", "content_sanskrit": "युक्तं राक्षसकोटीभिर्भिन्नाञ्जनचयोपमम्।\nदुर्निरीक्ष्यं सुरगणैर्वरदानेन दर्पितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2014847, "chapter_id": 1309, "verse_number": "२-५०-२३", "content_sanskrit": "जघान सचिवैः सार्धं सान्वयं रावणं रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2014848, "chapter_id": 1309, "verse_number": "२-५०-२४", "content_sanskrit": "त्रैलोक्यकण्टकं वीरं महाकायं महाबलम्।\nरावमं सगणं हत्वा रामो भूतपतिः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2014849, "chapter_id": 1309, "verse_number": "२-५०-२५", "content_sanskrit": "लङ्कायां तं महात्मानं राक्षसेन्द्रं विभीषणम्।\nअभिषिच्य ततो राम अमरत्वं ददौ तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2014850, "chapter_id": 1309, "verse_number": "२-५०-२६", "content_sanskrit": "आरुह्य पुष्पकं रामः सीतामादाय पाण्डव।\nसबलं स्वपुरं गत्वा धर्मराज्यमपालयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2014851, "chapter_id": 1309, "verse_number": "२-५०-२७", "content_sanskrit": "दानवो लवणो नाम मधोः पुत्रो महाबलः।\nशत्रुघ्नेन हतो राजंस्तदा रामस्य शासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2014852, "chapter_id": 1309, "verse_number": "२-५०-२८", "content_sanskrit": "एवं बहूनि कर्माणि कृत्वा लोकहिताय सः।\nराजं चकार विधिवद्रामो धर्मभृतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2014853, "chapter_id": 1309, "verse_number": "२-५०-२९", "content_sanskrit": "शताश्वमेधानाजह्रे ज्योतिरुक्थ्यान्निरर्गलान्।\nनाश्रूयन्ताशुभा वाचो नात्ययः प्राणिनां तदा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2014854, "chapter_id": 1309, "verse_number": "२-५०-३०", "content_sanskrit": "न दस्युजं भयं चासीद्रामे राज्यं प्रशसति।\nऋषीणां देवतानां च मनुष्याणां तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2014855, "chapter_id": 1309, "verse_number": "२-५०-३१", "content_sanskrit": "पृथिव्यां धार्मिकाः सर्वे रामे राज्यं प्रशासति।\nनाधर्मिष्ठो नरः कश्चिद्बभूव प्राणिनां क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2014856, "chapter_id": 1309, "verse_number": "२-५०-३२", "content_sanskrit": "प्राणापानौ समौ ह्यास्तां रामे राज्यं प्रशासति।\nगाधामप्यत्र गायन्ति ये पुराणविदो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2014857, "chapter_id": 1309, "verse_number": "२-५०-३३", "content_sanskrit": "श्यामो युवा लोहिताक्षो मातङ्गानामिवर्षभः।\nआजानुबाहुः सुमुखः सिंहस्कन्धो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2014858, "chapter_id": 1309, "verse_number": "२-५०-३४", "content_sanskrit": "दशवर्षसहस्राणि दशवर्षशतानि च।\nराज्यं भोगं च सम्प्राप्य शशास पृथिवीमिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2014859, "chapter_id": 1309, "verse_number": "२-५०-३५", "content_sanskrit": "रामो रामो राम इति प्राजानामभवन्कथाः।\nरामभूतं जगदिदं रामे राज्यं प्रशासति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2014860, "chapter_id": 1309, "verse_number": "२-५०-३६", "content_sanskrit": "ऋग्यजुः सामहीनाश्च न तदाऽसन्द्विजायः।\nउषित्वा दण्डके कार्यं त्रिदशानां चकार सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2014861, "chapter_id": 1309, "verse_number": "२-५०-३७", "content_sanskrit": "पूर्वापकारिणं तं तु पौलस्त्यं मनुजर्षभम्।\nदेवगन्धर्वनागानामरिं स निजघानह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2014862, "chapter_id": 1309, "verse_number": "२-५०-३८", "content_sanskrit": "सत्ववान्गुणसम्पन्नो दीप्यमानः स्वतेजसा।\nएवमेव महाबाहुरिक्ष्वाकुकुलवर्धनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2014863, "chapter_id": 1309, "verse_number": "२-५०-३९", "content_sanskrit": "रावणं सगणं हत्वा दिवमाक्रमताभिभूः।\nइति दाशरथेः ख्यातः प्रादुर्भावो महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2014864, "chapter_id": 1309, "verse_number": "२-५०-४०", "content_sanskrit": "ततः कृष्णो महाबाहुर्भीतानामभयङ्करः।\nअष्टाविंशे युगे राजञ्जज्ञे श्रीवत्सलक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2014865, "chapter_id": 1309, "verse_number": "२-५०-४१", "content_sanskrit": "पेशलश्च वदान्यश्चलोके बहुमतो नृषु।\nस्मृतिमान्देशकालज्ञः शङ्खचक्रगदासिभृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2014866, "chapter_id": 1309, "verse_number": "२-५०-४२", "content_sanskrit": "वासुदेव इति ख्यातो लोकानां हितकृत्सदा।\nवृष्णीनां च कुले जातो भूमेः प्रियचिकीर्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2014867, "chapter_id": 1309, "verse_number": "२-५०-४३", "content_sanskrit": "शत्रूणां भयकृद्दाता मधुहेति स विश्रुतः।\nशकटार्जुनरामाणां कीलस्थानान्यसूदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2014868, "chapter_id": 1309, "verse_number": "२-५०-४४", "content_sanskrit": "कंसादीन्निजघानाजौ दैत्यान्मानुषविग्रहान्।\nअयं लोकहितार्थाय प्रादुर्भावो महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2014869, "chapter_id": 1309, "verse_number": "२-५०-४५", "content_sanskrit": "कल्की विष्णुयशा नाम भूयश्चोत्पत्स्यते हरिः।\nलेर्युगान्ते सम्प्राप्ते धर्मे शिथिलतां गते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2014870, "chapter_id": 1309, "verse_number": "२-५०-४६", "content_sanskrit": "पाषण्डिनां गणानां हि वधार्थं भरतर्षभ।\nधर्मस्य च विवृद्ध्यर्थं विप्राणां हितकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2014871, "chapter_id": 1309, "verse_number": "२-५०-४७", "content_sanskrit": "एते चान्ये च बहवो विष्णोर्देवगणैर्युताः।\nप्रादुर्भावाः पुराणेषु गीयन्ते ब्रह्मवादिभिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2014872, "chapter_id": 1309, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अर्घाहरणपर्वणि पञ्चाशोऽध्यायः॥ ५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]