[{"id": 5000611000, "chapter_id": 9611, "verse_number": "७-७६-१", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा रामस्याक्लिष्टकर्मणः ।\nअवाक्छिरास्तथाभूत्वा वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000611001, "chapter_id": 9611, "verse_number": "७-७६-२", "content_sanskrit": "शूद्रयोन्यां प्रसूतो ऽस्मि शम्बूको नाम नामतः ।\nदेवत्वं पार्थये राम सशरीरो महायशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000611002, "chapter_id": 9611, "verse_number": "७-७६-३", "content_sanskrit": "न मिथ्या ऽहं वदे राम देवलोकजिगीषया ।\nशूद्रं मां विद्धि काकुत्स्थ तप उग्रं समास्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000611003, "chapter_id": 9611, "verse_number": "७-७६-४", "content_sanskrit": "भाषतस्तस्य शूद्रस्य खड्गं सुरुचिरप्रभम् ।\nनिष्कृष्य कोशाद्विमलं शिरश्चिच्छेद राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000611004, "chapter_id": 9611, "verse_number": "७-७६-५", "content_sanskrit": "तस्मिञ्छूद्रे हते देवाः सेन्द्राः साग्निपुरोगमाः ।\nसाधु साध्विति काकुत्स्थं प्रशशंसुर्मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000611005, "chapter_id": 9611, "verse_number": "७-७६-६", "content_sanskrit": "पुष्पवृष्टिर्महत्यासीद्दिव्यानां सुसुगन्धिनाम् ।\nपुष्पाणां वायुमुक्तानां सर्वतः प्रपपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000611006, "chapter_id": 9611, "verse_number": "७-७६-७", "content_sanskrit": "सुप्रीताश्चाब्रुवन्रामं देवाः सत्यपराक्रमम् ।\nसुरकार्यमिदं सौम्य सुकृतं ते महामते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000611007, "chapter_id": 9611, "verse_number": "७-७६-८", "content_sanskrit": "गृहाण च वरं सौम्य यत्त्वमिच्छस्यरिन्दम ।\nस्वर्गभाङ्नहि शूद्रो ऽयं त्वत्कृते रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000611008, "chapter_id": 9611, "verse_number": "७-७६-९", "content_sanskrit": "देवानां भाषितं श्रुत्वा राघवः सुसमाहितः ।\nउवाच प्राञ्जलिर्वाक्यं सहस्राक्षं पुरन्दरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000611009, "chapter_id": 9611, "verse_number": "७-७६-१०", "content_sanskrit": "यदि देवाः प्रसन्ना मे द्विजपुत्रः स जीवतु ।\nदिशन्तु वरमेतं मे इप्सितं परमं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000611010, "chapter_id": 9611, "verse_number": "७-७६-११", "content_sanskrit": "ममापचाराद्यातो ऽसौ ब्राह्मणस्यैकपुत्रकः ।\nअप्राप्तकालः कालेन नीतो वैवस्वतक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000611011, "chapter_id": 9611, "verse_number": "७-७६-१२", "content_sanskrit": "तं जीवयथ भद्रं वो नानृतं कर्तुमर्हथ ।\nद्विजस्य संश्रुतो ऽर्थो मे जीवयिष्यामि ते सुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000611012, "chapter_id": 9611, "verse_number": "७-७६-१३", "content_sanskrit": "राघवस्य तु तद्वाक्यं श्रुत्वा विबुधसत्तमाः ।\nप्रत्युचू राघवं प्रीता देवाः प्रीतिसमन्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000611013, "chapter_id": 9611, "verse_number": "७-७६-१४", "content_sanskrit": "निर्वृतो भव काकुत्स्थ सो ऽस्मिन्नहनि बालकः ।\nजीवितं प्राप्तवान्भूयः समेतश्चापि बन्धुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000611014, "chapter_id": 9611, "verse_number": "७-७६-१५", "content_sanskrit": "यस्मिन्मुहूर्ते काकुत्स्थ शूद्रो ऽयं विनिपातितः ।\nतस्मिन्मुहूर्ते बालो ऽसौ जीवेन समयुज्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000611015, "chapter_id": 9611, "verse_number": "७-७६-१६", "content_sanskrit": "स्वस्ति प्राप्नुहि भद्रं ते साधु याम नरर्षभ ।\nअगस्त्यस्याश्रमपदं द्रष्टुमिच्छाम राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000611016, "chapter_id": 9611, "verse_number": "७-७६-१७", "content_sanskrit": "तस्य दीक्षा समाप्ता हि ब्रह्मर्षेः सुमहाद्युतेः ।\nद्वादशं हि गतं वर्षं जलशय्यां समासतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000611017, "chapter_id": 9611, "verse_number": "७-७६-१८", "content_sanskrit": "काकुत्स्थ तद्गमिष्यामो मुनिं समभिनन्दितुम् ।\nत्वं चाप्यागच्छ भद्रं ते द्रष्टुं तमृषिसत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000611018, "chapter_id": 9611, "verse_number": "७-७६-१९", "content_sanskrit": "स तथेति प्रतिज्ञाय देवानां रघुनन्दनः ।\nआरुरोह विमानं तं पुष्पकं हेमभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000611019, "chapter_id": 9611, "verse_number": "७-७६-२०", "content_sanskrit": "ततो देवाः प्रयातास्ते विमानैर्बहुविस्तरैः ।\nरामो ऽप्यनुजगामाशु कुम्भयोनेस्तपोवनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000611020, "chapter_id": 9611, "verse_number": "७-७६-२१", "content_sanskrit": "दृष्ट्वा तु देवान्सम्प्राप्तानगस्त्यस्तपसां निधिः ।\nअर्चयामास धर्मात्मा सर्वांस्तानविशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000611021, "chapter_id": 9611, "verse_number": "७-७६-२२", "content_sanskrit": "प्रतिगृह्य ततः पूजां सम्पूज्य च महामुनिम् ।\nजग्मुस्ते त्रिदशा हृष्टा नाकपृष्ठं सहानुगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000611022, "chapter_id": 9611, "verse_number": "७-७६-२३", "content_sanskrit": "गतेषु तेषु काकुत्स्थः पुष्पकादवरुह्य च ।\nततो ऽभिवादयामास ह्यगस्त्यमृषिसत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000611023, "chapter_id": 9611, "verse_number": "७-७६-२४", "content_sanskrit": "सो ऽभिवाद्य महात्मानं ज्वलन्तमिव तेजसा ।\nआतिथ्यं परमं प्राप्य निषसाद नराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000611024, "chapter_id": 9611, "verse_number": "७-७६-२५", "content_sanskrit": "तमुवाच महातेजाः कुम्भयोनिर्महातपाः ।\nस्वागतं ते नरश्रेष्ठ दिष्ट्या प्राप्तो ऽसि राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000611025, "chapter_id": 9611, "verse_number": "७-७६-२६", "content_sanskrit": "त्वं मे बहुमतो राम गुणैर्बहुभिरुत्तमैः ।\nअतिथिः पूजनीयश्च मम नित्यं हृदि स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000611026, "chapter_id": 9611, "verse_number": "७-७६-२७", "content_sanskrit": "सुरा हि कथयन्ति त्वामागतं शूद्रघातिनम् ।\nब्राह्मणस्य तु धर्मेण त्वया जीवापितः सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000611027, "chapter_id": 9611, "verse_number": "७-७६-२८", "content_sanskrit": "उष्यतां चेह रजनी सकाशे मम राघव ।\nप्रभाते पुष्पकेण त्वं गन्ता ऽसि पुरमेव हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000611028, "chapter_id": 9611, "verse_number": "७-७६-२९", "content_sanskrit": "त्वं हि नारायणः श्रीमांस्त्वयि सर्वं प्रतिष्ठितम् ।\nत्वं प्रभुः सर्वदेवानां पुरुषस्त्वं सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000611029, "chapter_id": 9611, "verse_number": "७-७६-३०", "content_sanskrit": "इदं चाभरणं सौम्य निर्मितं विश्वकर्मणा ।\nदिव्यं दिव्येन वपुषा दीप्यमानं स्वतेजसा ।\nप्रतिगृह्णीष्व काकुत्स्थ मत्प्रियं कुरु राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000611030, "chapter_id": 9611, "verse_number": "७-७६-३१", "content_sanskrit": "दत्तस्य हि पुनर्दाने सुमहत्फलमुच्यते ।\nभरणे हि भवान् शक्तः सेन्द्राणां मरुतामपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000611031, "chapter_id": 9611, "verse_number": "७-७६-३२", "content_sanskrit": "त्वं हि शक्तस्तारयितुं सेन्द्रानपि दिवौकसः ।\nतस्मात्प्रदास्ये विधिवत्तत्प्रतीच्छ नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000611032, "chapter_id": 9611, "verse_number": "७-७६-३३", "content_sanskrit": "दिव्यमाभरणं चित्रं प्रदीप्तमिव भास्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000611033, "chapter_id": 9611, "verse_number": "७-७६-३४", "content_sanskrit": "अथोवाच महात्मानमिक्ष्वाकूणां महारथः ।\nरामो मतिमतां श्रेष्ठः क्षत्रधर्ममनुस्मरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000611034, "chapter_id": 9611, "verse_number": "७-७६-३५", "content_sanskrit": "प्रतिग्रहो ऽयं भगवन्ब्राह्मणस्याविगर्हितः ।\nगृह्णीयां क्षत्रियो ऽहं वै कथं ब्राह्मणपुङ्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000611035, "chapter_id": 9611, "verse_number": "७-७६-३६", "content_sanskrit": "ब्राह्मणेन विशेषेण दत्तं तद्वक्तुमर्हसि ।\nएवमुक्तस्तु रामेण प्रत्युवाच महानृषिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000611036, "chapter_id": 9611, "verse_number": "७-७६-३७", "content_sanskrit": "आसन्कृतयुगे राम ब्रह्मभूते पुरायुगे ।\nअपार्थिवाः प्रजाः सर्वाः सुराणां तु शतक्रतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000611037, "chapter_id": 9611, "verse_number": "७-७६-३८", "content_sanskrit": "ताः प्रजा देवदेवेशं राजार्थं समुपाद्रवन् ।\nसुराणां स्थापितो राजा त्वया देव शतक्रतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000611038, "chapter_id": 9611, "verse_number": "७-७६-३९", "content_sanskrit": "प्रयच्छ नो हि लोकेश पार्थिवं नरपुङ्गवम् ।\nयस्मै पूजां प्रयुञ्जाना धूतपापाश्चरेमहि ।\nन वसामो विना राज्ञा एष नो निश्चयः परः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000611039, "chapter_id": 9611, "verse_number": "७-७६-४०", "content_sanskrit": "प्रजानां वचनं श्रुत्वा निश्चयित्वा ऽर्थमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000611040, "chapter_id": 9611, "verse_number": "७-७६-४१", "content_sanskrit": "ततो ब्रह्मा सुरश्रेष्ठो लोकपालान्सवासवान् ।\nसमाहूयाब्रवीत्सर्वांस्तेजोभागान्प्रयच्छत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000611041, "chapter_id": 9611, "verse_number": "७-७६-४२", "content_sanskrit": "ततो ददुर्लोकपालाः सर्वे भागान्स्वतेजसः ।\nअक्षुपच्च ततो ब्रह्मा यतो जातः क्षुपो नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000611042, "chapter_id": 9611, "verse_number": "७-७६-४३", "content_sanskrit": "तं ब्रह्मा लोकपालानां सहांशैः समयोजयत् ।\nततो ददौ नृपं तासां प्रजानामीश्वरं क्षुपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000611043, "chapter_id": 9611, "verse_number": "७-७६-४४", "content_sanskrit": "तत्रैन्द्रेण च भागेन महीमाज्ञापयन्नृपः ।\nवारुणेन तु भागेन वपुः पुष्यति पार्थिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000611044, "chapter_id": 9611, "verse_number": "७-७६-४५", "content_sanskrit": "कौबेरेण तु भागेन वित्तमासां ददौ तदा ।\nयस्तु याम्यो ऽभवद्भागस्तेन शास्ति स्म स प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000611045, "chapter_id": 9611, "verse_number": "७-७६-४६", "content_sanskrit": "तत्रैन्द्रेण नरश्रेष्ठ भागेन रघुनन्दन ।\nप्रतिगृह्णीष्व भद्रं ते तारणार्थं मम प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000611046, "chapter_id": 9611, "verse_number": "७-७६-४७", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा ऋषेः परमधार्मिकम् ।\nतद्रामः प्रतिजग्राह मुनेराभरणं वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000611047, "chapter_id": 9611, "verse_number": "७-७६-४८", "content_sanskrit": "प्रतिगृह्य ततो रामस्तदाभरणमुत्तमम् ।\nआगमं तस्य दीप्तस्य प्रष्टुमेवोपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000611048, "chapter_id": 9611, "verse_number": "७-७६-४९", "content_sanskrit": "अत्यद्भुतमिदं दिव्यं वपुषा युक्तमुत्तमम् ।\nकथं वा भगवता प्राप्तं कुतो वा केन वा हृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000611049, "chapter_id": 9611, "verse_number": "७-७६-५०", "content_sanskrit": "कुतूहलितया ब्रह्मन्पृच्छामि त्वां महायशः ।\nआश्चर्याणां बहूनां हि निधिः परमको भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000611050, "chapter_id": 9611, "verse_number": "७-७६-५१", "content_sanskrit": "एवं ब्रुवति काकुत्स्थे मुनिर्वाक्यमथाब्रवीत् ।\nशृणु राम यथावृत्तं पुरा त्रेतायुगे युगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000611051, "chapter_id": 9611, "verse_number": "७-७६-५२", "content_sanskrit": "रमणीयप्रदेशे ऽस्मिन् वने यद्दृष्टवानहम् ।\nआश्चर्यं मे महाबाहो दानमाश्रित्य केवलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000611052, "chapter_id": 9611, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे षट्सप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]