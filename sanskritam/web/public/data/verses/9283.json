[{"id": 5000283000, "chapter_id": 9283, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे एकादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000283001, "chapter_id": 9283, "verse_number": "४-११-१", "content_sanskrit": "रामस्य वचनं श्रुत्वा हर्षपौरुषवर्धनम्।\nसुग्रीवः पूजयांचक्रे राघवं प्रशशंस च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000283002, "chapter_id": 9283, "verse_number": "४-११-२", "content_sanskrit": "असंशयं प्रज्वलितैस्तीक्ष्णैर्मर्मातिगैः शरैः।\nत्वं दहेः कुपितो लोकान् युगान्त इव भास्करः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000283003, "chapter_id": 9283, "verse_number": "४-११-३", "content_sanskrit": "वालिनः पौरुषं यत्तद् यच्च वीर्यं धृतिश्च या।\nतन्ममैकमनाः श्रुत्वा विधत्स्व यदनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000283004, "chapter_id": 9283, "verse_number": "४-११-४", "content_sanskrit": "समुद्रात् पश्चिमात् पूर्वं दक्षिणादपि चोत्तरम्।\nक्रामत्यनुदिते सूर्ये वाली व्यपगतक्लमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000283005, "chapter_id": 9283, "verse_number": "४-११-५", "content_sanskrit": "अग्राण्यारुह्य शैलानां शिखराणि महान्त्यपि।\nऊर्ध्वमुत्पात्य तरसा प्रतिगृह्णाति वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000283006, "chapter_id": 9283, "verse_number": "४-११-६", "content_sanskrit": "बहवः सारवन्तश्च वनेषु विविधा द्रुमाः।\nवालिना तरसा भग्ना बलं प्रथयताऽऽत्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000283007, "chapter_id": 9283, "verse_number": "४-११-७", "content_sanskrit": "महिषो दुन्दुभिर्नाम कैलासशिखरप्रभः।\nबलं नागसहस्रस्य धारयामास वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000283008, "chapter_id": 9283, "verse_number": "४-११-८", "content_sanskrit": "स वीर्योत्सेकदुष्टात्मा वरदानेन मोहितः।\nजगाम स महाकायः समुद्रं सरितां पतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000283009, "chapter_id": 9283, "verse_number": "४-११-९", "content_sanskrit": "ऊर्मिमन्तमतिक्रम्य सागरं रत्नसंचयम्।\nमम युद्धं प्रयच्छेति तमुवाच महार्णवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000283010, "chapter_id": 9283, "verse_number": "४-११-१०", "content_sanskrit": "ततः समुद्रो धर्मात्मा समुत्थाय महाबलः।\nअब्रवीद् वचनं राजन्नसुरं कालचोदितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000283011, "chapter_id": 9283, "verse_number": "४-११-११", "content_sanskrit": "समर्थो नास्मि ते दातुं युद्धं युद्धविशारद।\nश्रूयतां त्वभिधास्यामि यस्ते युद्धं प्रदास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000283012, "chapter_id": 9283, "verse_number": "४-११-१२", "content_sanskrit": "शैलराजो महारण्ये तपस्विशरणं परम्।\nशंकरश्वशुरो नाम्ना हिमवानिति विश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000283013, "chapter_id": 9283, "verse_number": "४-११-१३", "content_sanskrit": "महाप्रस्रवणोपेतो बहुकन्दरनिर्झरः।\nस समर्थस्तव प्रीतिमतुलां कर्तुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000283014, "chapter_id": 9283, "verse_number": "४-११-१४", "content_sanskrit": "तं भीतमिति विज्ञाय समुद्रमसुरोत्तमः।\nहिमवद्वनमागम्य शरश्चापादिव च्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000283015, "chapter_id": 9283, "verse_number": "४-११-१५", "content_sanskrit": "ततस्तस्य गिरेः श्वेता गजेन्द्रप्रतिमाः शिलाः।\nचिक्षेप बहुधा भूमौ दुन्दुभिर्विननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000283016, "chapter_id": 9283, "verse_number": "४-११-१६", "content_sanskrit": "ततः श्वेताम्बुदाकारः सौम्यः प्रीतिकराकृतिः।\nहिमवानब्रवीद् वाक्यं स्व एव शिखरे स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000283017, "chapter_id": 9283, "verse_number": "४-११-१७", "content_sanskrit": "क्लेष्टुमर्हसि मां न त्वं दुन्दुभे धर्मवत्सल।\nरणकर्मस्वकुशलस्तपस्विशरणो ह्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000283018, "chapter_id": 9283, "verse_number": "४-११-१८", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा गिरिराजस्य धीमतः।\nउवाच दुन्दुभिर्वाक्यं क्रोधात् संरक्तलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000283019, "chapter_id": 9283, "verse_number": "४-११-१९", "content_sanskrit": "यदि युद्धेऽसमर्थस्त्वं मद्भयाद् वा निरुद्यमः।\nतमाचक्ष्व प्रदद्यान्मे यो हि युद्धं युयुत्सतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000283020, "chapter_id": 9283, "verse_number": "४-११-२०", "content_sanskrit": "हिमवानब्रवीद् वाक्यं श्रुत्वा वाक्यविशारदः।\nअनुक्तपूर्वं धर्मात्मा क्रोधात् तमसुरोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000283021, "chapter_id": 9283, "verse_number": "४-११-२१", "content_sanskrit": "वाली नाम महाप्राज्ञ शक्रपुत्रः प्रतापवान्।\nअध्यास्ते वानरः श्रीमान् किष्किन्धामतुलप्रभाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000283022, "chapter_id": 9283, "verse_number": "४-११-२२", "content_sanskrit": "स समर्थो महाप्राज्ञस्तव युद्धविशारदः।\nद्वन्द्वयुद्धं स दातुं ते नमुचेरिव वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000283023, "chapter_id": 9283, "verse_number": "४-११-२३", "content_sanskrit": "तं शीघ्रमभिगच्छ त्वं यदि युद्धमिहेच्छसि।\nस हि दुर्मर्षणो नित्यं शूरः समरकर्मणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000283024, "chapter_id": 9283, "verse_number": "४-११-२४", "content_sanskrit": "श्रुत्वा हिमवतो वाक्यं कोपाविष्टः स दुन्दुभिः।\nजगाम तां पुरीं तस्य किष्किन्धां वालिनस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000283025, "chapter_id": 9283, "verse_number": "४-११-२५", "content_sanskrit": "धारयन् माहिषं रूपं तीक्ष्णशृङ्गो भयावहः।\nप्रावृषीव महामेघस्तोयपूर्णो नभस्तले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000283026, "chapter_id": 9283, "verse_number": "४-११-२६", "content_sanskrit": "ततस्तु द्वारमागम्य किष्किन्धाया महाबलः।\nननर्द कम्पयन् भूमिं दुन्दुभिर्दुन्दुभिर्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000283027, "chapter_id": 9283, "verse_number": "४-११-२७", "content_sanskrit": "समीपजान् द्रुमान् भञ्जन् वसुधां दारयन् खुरैः।\nविषाणेनोल्लिखन् दर्पात् तद्‍द्वारं द्विरदो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000283028, "chapter_id": 9283, "verse_number": "४-११-२८", "content_sanskrit": "अन्तःपुरगतो वाली श्रुत्वा शब्दममर्षणः।\nनिष्पपात सह स्त्रीभिस्ताराभिरिव चन्द्रमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000283029, "chapter_id": 9283, "verse_number": "४-११-२९", "content_sanskrit": "मितं व्यक्ताक्षरपदं तमुवाच स दुन्दुभिम्।\nहरीणामीश्वरो वाली सर्वेषां वनचारिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000283030, "chapter_id": 9283, "verse_number": "४-११-३०", "content_sanskrit": "किमर्थं नगरद्वारमिदं रुद्‍ध्वा विनर्दसे।\nदुन्दुभे विदितो मेऽसि रक्ष प्राणान् महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000283031, "chapter_id": 9283, "verse_number": "४-११-३१", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा वानरेन्द्रस्य धीमतः।\nउवाच दुन्दुभिर्वाक्यं क्रोधात् संरक्तलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000283032, "chapter_id": 9283, "verse_number": "४-११-३२", "content_sanskrit": "न त्वं स्त्रीसंनिधौ वीर वचनं वक्तुमर्हसि।\nमम युद्धं प्रयच्छाद्य ततो ज्ञास्यामि ते बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000283033, "chapter_id": 9283, "verse_number": "४-११-३३", "content_sanskrit": "अथवा धारयिष्यामि क्रोधमद्य निशामिमाम्।\nगृह्यतामुदयः स्वैरं कामभोगेषु वानर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000283034, "chapter_id": 9283, "verse_number": "४-११-३४", "content_sanskrit": "दीयतां सम्प्रदानं च परिष्वज्य च वानरान्।\nसर्वशाखामृगेन्द्रस्त्वं संसादय सुहृज्जनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000283035, "chapter_id": 9283, "verse_number": "४-११-३५", "content_sanskrit": "सुदृष्टां कुरु किष्किन्धां कुरुष्वात्मसमं पुरे।\nक्रीडस्व च समं स्त्रीभिरहं ते दर्पशासनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000283036, "chapter_id": 9283, "verse_number": "४-११-३६", "content_sanskrit": "यो हि मत्तं प्रमत्तं वा भग्नं वा रहितं कृशम्।\nहन्यात् स भ्रूणहा लोके त्वद्विधं मदमोहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000283037, "chapter_id": 9283, "verse_number": "४-११-३७", "content_sanskrit": "स प्रहस्याब्रवीन्मन्दं क्रोधात् तमसुरेश्वरम्।\nविसृज्य ताः स्त्रियः सर्वास्ताराप्रभृतिकास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000283038, "chapter_id": 9283, "verse_number": "४-११-३८", "content_sanskrit": "मत्तोऽयमिति मा मंस्था यद्यभीतोऽसि संयुगे।\nमदोऽयं सम्प्रहारेऽस्मिन् वीरपानं समर्थ्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000283039, "chapter_id": 9283, "verse_number": "४-११-३९", "content_sanskrit": "तमेवमुक्त्वा संक्रुद्धो मालामुत्क्षिप्य काञ्चनीम्।\nपित्रा दत्तां महेन्द्रेण युद्धाय व्यवतिष्ठत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000283040, "chapter_id": 9283, "verse_number": "४-११-४०", "content_sanskrit": "विषाणयोर्गृहीत्वा तं दुन्दुभिं गिरिसंनिभम्।\nआविध्यत तथा वाली विनदन् कपिकुञ्जरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000283041, "chapter_id": 9283, "verse_number": "४-११-४१", "content_sanskrit": "बलाद् व्यापादयांचक्रे ननर्द च महास्वनम्।\nश्रोत्राभ्यामथ रक्तं तु तस्य सुस्राव पात्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000283042, "chapter_id": 9283, "verse_number": "४-११-४२", "content_sanskrit": "तयोस्तु क्रोधसंरम्भात् परस्परजयैषिणोः।\nयुद्धं समभवद् घोरं दुन्दुभेर्वालिनस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000283043, "chapter_id": 9283, "verse_number": "४-११-४३", "content_sanskrit": "अयुध्यत तदा वाली शक्रतुल्यपराक्रमः।\nमुष्टिभिर्जानुभिः पद्भिः शिलाभिः पादपैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000283044, "chapter_id": 9283, "verse_number": "४-११-४४", "content_sanskrit": "परस्परं घ्नतोस्तत्र वानरासुरयोस्तदा।\nआसीद्धीनोऽसुरो युद्धे शक्रसूनुर्व्यवर्धत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000283045, "chapter_id": 9283, "verse_number": "४-११-४५", "content_sanskrit": "तं तु दुन्दुभिमुद्यम्य धरण्यामभ्यपातयत्।\nयुद्धे प्राणहरे तस्मिन्निष्पिष्टो दुन्दुभिस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000283046, "chapter_id": 9283, "verse_number": "४-११-४६", "content_sanskrit": "स्रोतोभ्यो बहु रक्तं तु तस्य सुस्राव पात्यतः।\nपपात च महाबाहुः क्षितौ पञ्चत्वमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000283047, "chapter_id": 9283, "verse_number": "४-११-४७", "content_sanskrit": "तं तोलयित्वा बाहुभ्यां गतसत्त्वमचेतनम्।\nचिक्षेप वेगवान् वाली वेगेनैकेन योजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000283048, "chapter_id": 9283, "verse_number": "४-११-४८", "content_sanskrit": "तस्य वेगप्रविद्धस्य वक्त्रात् क्षतजबिन्दवः।\nप्रपेतुर्मारुतोत्क्षिप्ता मतङ्गस्याश्रमं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000283049, "chapter_id": 9283, "verse_number": "४-११-४९", "content_sanskrit": "तान् दृष्ट्वा पतितांस्तत्र मुनिः शोणितविप्रुषः।\nक्रुद्धस्तस्य महाभाग चिन्तयामास को न्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000283050, "chapter_id": 9283, "verse_number": "४-११-५०", "content_sanskrit": "येनाहं सहसा स्पृष्टः शोणितेन दुरात्मना।\nकोऽयं दुरात्मा दुर्बुद्धिरकृतात्मा च बालिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000283051, "chapter_id": 9283, "verse_number": "४-११-५१", "content_sanskrit": "इत्युक्त्वा स विनिष्क्रम्य ददृशे मुनिसत्तमः।\nमहिषं पर्वताकारं गतासुं पतितं भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000283052, "chapter_id": 9283, "verse_number": "४-११-५२", "content_sanskrit": "स तु विज्ञाय तपसा वानरेण कृतं हि तत्।\nउत्ससर्ज महाशापं क्षेप्तारं वानरं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000283053, "chapter_id": 9283, "verse_number": "४-११-५३", "content_sanskrit": "इह तेनाप्रवेष्टव्यं प्रविष्टस्य वधो भवेत्।\nवनं मत्संश्रयं येन दूषितं रुधिरस्रवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000283054, "chapter_id": 9283, "verse_number": "४-११-५४", "content_sanskrit": "क्षिपता पादपाश्चेमे सम्भग्नाश्चासुरीं तनुम्।\nसमन्तादाश्रमं पूर्णं योजनं मामकं यदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000283055, "chapter_id": 9283, "verse_number": "४-११-५५", "content_sanskrit": "आगमिष्यति दुर्बुद्धिर्व्यक्तं स न भविष्यति।\nये चास्य सचिवाः केचित् संश्रिता मामकं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000283056, "chapter_id": 9283, "verse_number": "४-११-५६", "content_sanskrit": "न च तैरिह वस्तव्यं श्रुत्वा यान्तु यथासुखम्।\nतेऽपि वा यदि तिष्ठन्ति शपिष्ये तानपि ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000283057, "chapter_id": 9283, "verse_number": "४-११-५७", "content_sanskrit": "वनेऽस्मिन् मामके नित्यं पुत्रवत् परिरक्षिते।\nपत्राङ्कुरविनाशाय फलमूलाभवाय च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000283058, "chapter_id": 9283, "verse_number": "४-११-५८", "content_sanskrit": "दिवसश्चाद्य मर्यादा यं द्रष्टा श्वोऽस्मि वानरम्।\nबहुवर्षसहस्राणि स वै शैलो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000283059, "chapter_id": 9283, "verse_number": "४-११-५९", "content_sanskrit": "ततस्ते वानराः श्रुत्वा गिरं मुनिसमीरिताम्।\nनिश्चक्रमुर्वनात् तस्मात् तान् दृष्ट्वा वालिरब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000283060, "chapter_id": 9283, "verse_number": "४-११-६०", "content_sanskrit": "किं भवन्तः समस्ताश्च मतङ्गवनवासिनः।\nमत्समीपमनुप्राप्ता अपि स्वस्ति वनौकसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000283061, "chapter_id": 9283, "verse_number": "४-११-६१", "content_sanskrit": "ततस्ते कारणं सर्वं तथा शापं च वालिनः।\nशशंसुर्वानराः सर्वे वालिने हेममालिने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000283062, "chapter_id": 9283, "verse_number": "४-११-६२", "content_sanskrit": "एतच्छ्रुत्वा तदा वाली वचनं वानरेरितम्।\nस महर्षिं समासाद्य याचते स्म कृताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000283063, "chapter_id": 9283, "verse_number": "४-११-६३", "content_sanskrit": "महर्षिस्तमनादृत्य प्रविवेशाश्रमं प्रति।\nशापधारणभीतस्तु वाली विह्वलतां गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000283064, "chapter_id": 9283, "verse_number": "४-११-६४", "content_sanskrit": "ततः शापभयाद् भीतो ऋष्यमूकं महागिरिम्।\nप्रवेष्टुं नेच्छति हरिर्द्रष्टुं वापि नरेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000283065, "chapter_id": 9283, "verse_number": "४-११-६५", "content_sanskrit": "तस्याप्रवेशं ज्ञात्वाहमिदं राम महावनम्।\nविचरामि सहामात्यो विषादेन विवर्जितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000283066, "chapter_id": 9283, "verse_number": "४-११-६६", "content_sanskrit": "एषोऽस्थिनिचयस्तस्य दुन्दुभेः सम्प्रकाशते।\nवीर्योत्सेकान्निरस्तस्य गिरिकूटनिभो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000283067, "chapter_id": 9283, "verse_number": "४-११-६७", "content_sanskrit": "इमे च विपुलाः सालाः सप्त शाखावलम्बिनः।\nयत्रैकं घटते वाली निष्पत्रयितुमोजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000283068, "chapter_id": 9283, "verse_number": "४-११-६८", "content_sanskrit": "एतदस्यासमं वीर्यं मया राम प्रकाशितम्।\nकथं तं वालिनं हन्तुं समरे शक्ष्यसे नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000283069, "chapter_id": 9283, "verse_number": "४-११-६९", "content_sanskrit": "तथा ब्रुवाणं सुग्रीवं प्रहसँल्लक्ष्मणोऽब्रवीत्।\nकस्मिन् कर्मणि निर्वृत्ते श्रद्दध्या वालिनो वधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000283070, "chapter_id": 9283, "verse_number": "४-११-७०", "content_sanskrit": "तमुवाचाथ सुग्रीवः सप्त सालानिमान् पुरा।\nएवमेकैकशो वाली विव्याधाथ स चासकृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000283071, "chapter_id": 9283, "verse_number": "४-११-७१", "content_sanskrit": "रामो निर्दारयेदेषां बाणेनैकेन च द्रुमम्।\nवालिनं निहतं मन्ये दृष्ट्वा रामस्य विक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 5000283072, "chapter_id": 9283, "verse_number": "४-११-७२", "content_sanskrit": "हतस्य महिषस्यास्थि पादेनैकेन लक्ष्मण।\nउद्यम्य प्रक्षिपेच्चापि तरसा द्वे धनुःशते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 5000283073, "chapter_id": 9283, "verse_number": "४-११-७३", "content_sanskrit": "एवमुक्त्वा तु सुग्रीवो रामं रक्तान्तलोचनम्।\nध्यात्वा मुहूर्तं काकुत्स्थं पुनरेव वचोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 5000283074, "chapter_id": 9283, "verse_number": "४-११-७४", "content_sanskrit": "शूरश्च शूरमानी च प्रख्यातबलपौरुषः।\nबलवान् वानरो वाली संयुगेष्वपराजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 5000283075, "chapter_id": 9283, "verse_number": "४-११-७५", "content_sanskrit": "दृश्यन्ते चास्य कर्माणि दुष्कराणि सुरैरपि।\nयानि संचिन्त्य भीतोऽहमृष्यमूकमुपाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 5000283076, "chapter_id": 9283, "verse_number": "४-११-७६", "content_sanskrit": "तमजय्यमधृष्यं च वानरेन्द्रममर्षणम्।\nविचिन्तयन्न मुञ्चापि ऋष्यमूकममुं त्वहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 5000283077, "chapter_id": 9283, "verse_number": "४-११-७७", "content_sanskrit": "उद्विग्नः शङ्कितश्चाहं विचरामि महावने।\nअनुरक्तैः सहामात्यैर्हनुमत्प्रमुखैर्वरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 5000283078, "chapter_id": 9283, "verse_number": "४-११-७८", "content_sanskrit": "उपलब्धं च मे श्लाघ्यं सन्मित्रं मित्रवत्सल।\nत्वामहं पुरुषव्याघ्र हिमवन्तमिवाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 5000283079, "chapter_id": 9283, "verse_number": "४-११-७९", "content_sanskrit": "किं तु तस्य बलज्ञोऽहं दुर्भ्रातुर्बलशालिनः।\nअप्रत्यक्षं तु मे वीर्यं समरे तव राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 5000283080, "chapter_id": 9283, "verse_number": "४-११-८०", "content_sanskrit": "न खल्वहं त्वां तुलये नावमन्ये न भीषये।\nकर्मभिस्तस्य भीमैश्च कातर्यं जनितं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 5000283081, "chapter_id": 9283, "verse_number": "४-११-८१", "content_sanskrit": "कामं राघव ते वाणी प्रमाणं धैर्यमाकृतिः।\nसूचयन्ति परं तेजो भस्मच्छन्नमिवानलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 5000283082, "chapter_id": 9283, "verse_number": "४-११-८२", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा सुग्रीवस्य महात्मनः।\nस्मितपूर्वमथो रामः प्रत्युवाच हरिं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 5000283083, "chapter_id": 9283, "verse_number": "४-११-८३", "content_sanskrit": "यदि न प्रत्ययोऽस्मासु विक्रमे तव वानर।\nप्रत्ययं समरे श्लाघ्यमहमुत्पादयामि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 5000283084, "chapter_id": 9283, "verse_number": "४-११-८४", "content_sanskrit": "एवमुक्त्वा तु सुग्रीवं सान्त्वयँल्लक्ष्मणाग्रजः।\nराघवो दुन्दुभेः कायं पादाङ्गुष्ठेन लीलया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 5000283085, "chapter_id": 9283, "verse_number": "४-११-८५", "content_sanskrit": "तोलयित्वा महाबाहुश्चिक्षेप दशयोजनम्।\nअसुरस्य तनुं शुष्कां पादाङ्गुष्ठेन वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 5000283086, "chapter_id": 9283, "verse_number": "४-११-८६", "content_sanskrit": "क्षिप्तं दृष्ट्वा ततः कायं सुग्रीवः पुनरब्रवीत्।\nलक्ष्मणस्याग्रतो रामं तपन्तमिव भास्करम्।\nहरीणामग्रतो वीरमिदं वचनमर्थवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 5000283087, "chapter_id": 9283, "verse_number": "४-११-८७", "content_sanskrit": "आर्द्रः समांसः प्रत्यग्रः क्षिप्तः कायः पुरा सखे।\nपरिश्रान्तेन मत्तेन भ्रात्रा मे वालिना तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 5000283088, "chapter_id": 9283, "verse_number": "४-११-८८", "content_sanskrit": "लघुः सम्प्रति निर्मांसस्तृणभूतश्च राघव।\nक्षिप्त एवं प्रहर्षेण भवता रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 5000283089, "chapter_id": 9283, "verse_number": "४-११-८९", "content_sanskrit": "नात्र शक्यं बलं ज्ञातुं तव वा तस्य वाधिकम्।\nआर्द्रं शुष्कमिति ह्येतत् सुमहद् राघवान्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 5000283090, "chapter_id": 9283, "verse_number": "४-११-९०", "content_sanskrit": "स एव संशयस्तात तव तस्य च यद‍्बलम्।\nसालमेकं विनिर्भिद्य भवेद् व्यक्तिर्बलाबले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 5000283091, "chapter_id": 9283, "verse_number": "४-११-९१", "content_sanskrit": "कृत्वैतत् कार्मुकं सज्यं हस्तिहस्तमिवाततम्।\nआकर्णपूर्णमायम्य विसृजस्व महाशरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 5000283092, "chapter_id": 9283, "verse_number": "४-११-९२", "content_sanskrit": "इमं हि सालं प्रहितस्त्वया शरो\nन संशयोऽत्रास्ति विदारयिष्यति।\nअलं विमर्शेन मम प्रियं ध्रुवं\nकुरुष्व राजन् प्रतिशापितो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 5000283093, "chapter_id": 9283, "verse_number": "४-११-९३", "content_sanskrit": "यथा हि तेजःसु वरः सदारवि-\nर्यथा हि शैलो हिमवान् महाद्रिषु।\nयथा चतुष्पात्सु च केसरी वर-\nस्तथा नराणामसि विक्रमे वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 5000283094, "chapter_id": 9283, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे एकादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]