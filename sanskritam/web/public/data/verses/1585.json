[{"id": 2027242, "chapter_id": 1585, "verse_number": "३-२२३-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2027243, "chapter_id": 1585, "verse_number": "३-२२३-१", "content_sanskrit": "गुरुभिर्नियमैर्युक्तो भरतो नाम पार्थिव।\nअग्निः पुष्टिमग्निमि तुष्टः पुष्टिं प्रयच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2027244, "chapter_id": 1585, "verse_number": "३-२२३-२", "content_sanskrit": "`सततं भरतश्रेष्ठ पावकोयं महाप्रभः।\nअग्निर्यश्च शिवो नाम शक्तिपूजायनिश्च सः।\nदुःखार्तानां स सर्वेषां शिवकृत्सततं शिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2027245, "chapter_id": 1585, "verse_number": "३-२२३-३", "content_sanskrit": "तपसस्तु फलं दृष्ट्वासंप्रवृत्तं तपोमयम्।\nउद्धर्तुकामो मतिमान्पुत्रो जज्ञे पुरंदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2027246, "chapter_id": 1585, "verse_number": "३-२२३-४", "content_sanskrit": "उष्मा चैवोष्मणो जज्ञे सोऽग्निर्भूतेषु लक्ष्यते।\nअग्निश्चापि मनुर्नाम प्राजापत्यं सकारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2027247, "chapter_id": 1585, "verse_number": "३-२२३-५", "content_sanskrit": "शंभुमग्निमथ प्राहुर्ब्राह्मणा वेदपारगाः।\nआवसथ्यं देविजाः प्राहुर्दीप्तमग्निं महाप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2027248, "chapter_id": 1585, "verse_number": "३-२२३-६", "content_sanskrit": "ऊर्जस्करान्हव्यवाहान्सुवर्णसदृशप्रभान्।\nअग्निस्तपो ह्यजनयत्पञ्च यज्ञसुतानिह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2027249, "chapter_id": 1585, "verse_number": "३-२२३-७", "content_sanskrit": "प्रततोऽग्निर्महाभाग परिश्रान्तो गवांपतिः।\nअसुराञ्जनयन्धोरान्मत्यांश्चैव पृथिग्विधान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2027250, "chapter_id": 1585, "verse_number": "३-२२३-८", "content_sanskrit": "तपसश्च मनुं भानुं चाप्यङ्गिराः सृजत्।\nबृहद्भानुं तु तं प्राहुर्ब्राह्मणा वेदपारघाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2027251, "chapter_id": 1585, "verse_number": "३-२२३-९", "content_sanskrit": "भानोर्भार्या महाराज बृहद्भासा तु सोमजा।\nषट्पुत्राञ्जनयामास तदा सा कन्यया सह।\nभानोराङ्गिरसस्याथ शृणु तस्य प्रजाविधिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2027252, "chapter_id": 1585, "verse_number": "३-२२३-१०", "content_sanskrit": "दुर्बलानां तु भूतानामसून्यः संप्रयच्छति।\nतमग्निं बलदं प्राहुः प्रथमं भानुजं सुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2027253, "chapter_id": 1585, "verse_number": "३-२२३-११", "content_sanskrit": "यः प्रशान्तेषु भूतेषु मन्युर्भवति दारुणः।\nअग्निः स मन्युमान्नाम द्वितीयो भानुजः सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2027254, "chapter_id": 1585, "verse_number": "३-२२३-१२", "content_sanskrit": "दर्शे च पौर्णमासे च यस्येह हविरुच्यते।\nविष्णुर्नामेह योऽग्निस्तु धृतिमान्नाम सोङ्गिराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2027255, "chapter_id": 1585, "verse_number": "३-२२३-१३", "content_sanskrit": "इन्द्रेण सहितं यस्य हविराग्रयणं स्मृतम्।\nअग्निराग्रयणो नाम भानोरेवान्वयस्तु सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2027256, "chapter_id": 1585, "verse_number": "३-२२३-१४", "content_sanskrit": "चातुर्मास्येषु नित्यानां हविषां यो निरग्रहः।\nचतुर्भिः सहितः पुत्रैर्भानोरेवान्वयस्तु सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2027257, "chapter_id": 1585, "verse_number": "३-२२३-१५", "content_sanskrit": "निशां त्वजनयत्कन्यामग्नीषोमावुभौ तथा।\nमनोरेवाभवद्भार्या सुषुवे पञ्च पावकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2027258, "chapter_id": 1585, "verse_number": "३-२२३-१६", "content_sanskrit": "पूज्यते हविषा योऽग्रे चातुर्मास्येषु पावकः।\nपर्जन्यसहितः श्रीमानग्निर्वैश्वानरस्तु सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2027259, "chapter_id": 1585, "verse_number": "३-२२३-१७", "content_sanskrit": "अस्य लोकस्य सर्वस्य यः प्रभुः परिषठ्यते।\nसोऽग्निर्विश्वपतिर्नाम द्वितीयस्तापसः सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2027260, "chapter_id": 1585, "verse_number": "३-२२३-१८", "content_sanskrit": "कन्या या हरिणी नाम हिरण्यकशिपोः सुताः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2027261, "chapter_id": 1585, "verse_number": "३-२२३-१९", "content_sanskrit": "कर्मणाऽसौ बभौ भार्या स वह्निः स प्रजापतिः।\nप्राणानाश्रित्य यो देहं प्रवर्तयति देहिनाम्।\nतस्य सन्निहितो नाम शब्दरूपस् साधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2027262, "chapter_id": 1585, "verse_number": "३-२२३-२०", "content_sanskrit": "शुक्लं कृष्णं वपुर्देवो यो बिभर्ति हुताशनः।\nअकल्मषः कल्मषाणां कर्ता क्रोधाश्रितस्तुसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2027263, "chapter_id": 1585, "verse_number": "३-२२३-२१", "content_sanskrit": "कपिलं परमर्षिं च यं प्राहुर्यतयः सदा।\nअग्निः स कपिलो नाम साङ्ख्ययोगप्रवर्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2027264, "chapter_id": 1585, "verse_number": "३-२२३-२२", "content_sanskrit": "योऽन्तर्यच्छति भूतानि येन चेष्टन्ति नित्यदा।\nकर्मस्विह विचित्रेषु सोऽग्रणीर्वह्निरुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2027265, "chapter_id": 1585, "verse_number": "३-२२३-२३", "content_sanskrit": "इमामन्यान्समसृजत्पावकान्प्रथितौजसः।\nअग्निहोत्रस्य दुष्टस्य प्रायश्चित्तार्थमुल्वणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2027266, "chapter_id": 1585, "verse_number": "३-२२३-२४", "content_sanskrit": "संस्पृशेयुर्यदाऽन्योन्यं कथंचिद्वायुनाऽग्नयः।\nइष्टिरष्टाकपालेन कार्या वै शुचयेऽग्नये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2027267, "chapter_id": 1585, "verse_number": "३-२२३-२५", "content_sanskrit": "दक्षिणाग्निर्यदा द्वाभ्यां संसृजेत तदा किल।\nइष्टिरष्टाकपालेन कार्या वै वीतयेऽग्नये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2027268, "chapter_id": 1585, "verse_number": "३-२२३-२६", "content_sanskrit": "यद्यग्नयो हि स्पृश्येयुर्निवेशस्था दवाग्निना।\nइष्टरष्टाकपालेन कार्या तु शुचयेऽग्नये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2027269, "chapter_id": 1585, "verse_number": "३-२२३-२७", "content_sanskrit": "अग्निं रजस्वला वै स्त्री संस्पृशेदाग्निहौत्रिकम्।\nइष्टिरष्टाकपालेन कार्या वसुमतेऽग्नये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2027270, "chapter_id": 1585, "verse_number": "३-२२३-२८", "content_sanskrit": "मृतः श्रूयेत यो जीवन्परासुरशुचिर्यथा।\nइष्टिरष्टाकपालेन कार्या सुरभिमतेऽग्नये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2027271, "chapter_id": 1585, "verse_number": "३-२२३-२९", "content_sanskrit": "आर्तो न जुहुयादग्निं त्रिरात्रं यस्तु ब्राह्मणः।\nइष्टिरष्टाकपालेन कार्या तन्तुमतेऽग्नये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2027272, "chapter_id": 1585, "verse_number": "३-२२३-३०", "content_sanskrit": "दर्शश्च पौर्णमासश्च यस् तिष्ठेत्प्रतिष्ठितम्।\nइष्टिरष्टाकपालेन कार्या पथिकृतेऽग्नये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2027273, "chapter_id": 1585, "verse_number": "३-२२३-३१", "content_sanskrit": "सूतिकाग्निर्यदा चाग्निं संस्पृशेदाग्निहौत्रिकम्।\nइष्टिरष्टाकपालेन कार्यां चाग्निमतेऽग्नये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2027274, "chapter_id": 1585, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि त्रयोविंशत्यधिकद्विशततमोऽध्यायः ॥ २२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]