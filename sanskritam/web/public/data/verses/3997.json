[{"id": 2138365, "chapter_id": 3997, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2138366, "chapter_id": 3997, "verse_number": "१", "content_sanskrit": "कर्माण्युक्तानि युष्माभिर्यानि तानि चरिष्यथ ।\nमम चापि यथा बुद्धिरुचिता हि विनिश्चयात्\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2138367, "chapter_id": 3997, "verse_number": "२", "content_sanskrit": "पुरोहितोऽयमस्माकम् अग्निहोत्राणि रक्षतु ।\nसूदाः पौरोगवैः सार्धं द्रुपदस्य निवेशने\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2138368, "chapter_id": 3997, "verse_number": "३", "content_sanskrit": "इन्द्रसेनमुखाश्चैते रथानादाय केवलान् ।\nयान्तु द्वारवतीं शीघ्रमिति मे वर्तते मतिः\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2138369, "chapter_id": 3997, "verse_number": "४", "content_sanskrit": "इमाश्च नार्यो द्रौपद्याः सर्वतः परिचारिकाः ।\nपाञ्चालानेव गच्छन्तु सूदाः पौरोगवैः सह\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2138370, "chapter_id": 3997, "verse_number": "५", "content_sanskrit": "सर्वैरपि च वक्तव्यं न प्राज्ञायन्त पाण्डवाः ।\nगता ह्यस्मानपाहाय सर्वे द्वैतवनादिति\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2138371, "chapter_id": 3997, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2138372, "chapter_id": 3997, "verse_number": "६", "content_sanskrit": "तानन्वशासद् धर्मात्मा सर्वधर्मविशेषवित् ।\nधौम्यः पुरोहितो राजन् पाण्डवान् पुरुषर्षभान्\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2138373, "chapter_id": 3997, "verse_number": "", "content_sanskrit": "धौम्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2138374, "chapter_id": 3997, "verse_number": "७", "content_sanskrit": "विदिते चापि वक्तव्यं सुहृद्भिरनुरागतः ।\nअतोऽहमपि वक्ष्यामि हेतुमात्रं निबोधत\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2138375, "chapter_id": 3997, "verse_number": "८", "content_sanskrit": "हन्तेमां राजवसतिं राजपुत्रा ब्रवीमि वः ।\nयथा राजकुलं प्राप्य चरन् प्रेष्यो न दुष्यति\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2138376, "chapter_id": 3997, "verse_number": "९", "content_sanskrit": "दुर्वसन्नेव कौरव्याजानता राजवेश्मनि ।\nअमानितेन मानार्ह गूढेन परिवत्सरान्\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2138377, "chapter_id": 3997, "verse_number": "१०", "content_sanskrit": "दृष्टद्वारो लभेद् द्रष्टुं राजस्वेषु न विश्वसेत् ।\nन चानुशिष्याद् राजानमपृच्छन्तं कदाचन\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2138378, "chapter_id": 3997, "verse_number": "११", "content_sanskrit": "तूष्णीं त्वेनमुपासीत काले समभिपूजयन् ।\nतदेवासनमातिष्ठेद् यत्र नाभिषजेत् परः\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2138379, "chapter_id": 3997, "verse_number": "१२", "content_sanskrit": "यो नयानयपर्यङ्कं न पीठं न गजं रथम् ।\nआरोहेत् सम्मतोस्मीति स राजवसतिं वसेत्\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2138380, "chapter_id": 3997, "verse_number": "१३", "content_sanskrit": "नैषां दारेषु कुर्वीत मैत्रीं प्राज्ञः कदाचन ।\nअन्तःपुरचरा ये च द्वेष्टि यानहिताश्च ते\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2138381, "chapter_id": 3997, "verse_number": "१४", "content_sanskrit": "पाण्डवाग्निरयं लोके सर्वशस्त्रमयो महान् ।\nभर्ता गोप्ता च भूतानां राजा पुरुषविग्रहः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2138382, "chapter_id": 3997, "verse_number": "१५", "content_sanskrit": "सर्वात्मना वर्तमानं यथा दोषो न संस्पृशेत् ।\nराजानमुपजीवन्तं तस्य वृत्तिं निबोधत\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2138383, "chapter_id": 3997, "verse_number": "१६", "content_sanskrit": "नातिवर्तेत मर्यादां पुरुषो राजसम्मतः ।\nव्यवहारं पुनर्लोके मर्यादां पण्डिता विदुः\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2138384, "chapter_id": 3997, "verse_number": "१७", "content_sanskrit": "न हि पुत्रं न नप्तारं न भ्रातरमरिन्दम ।\nसमतिक्रान्तमर्यादं पूजयन्ति नराधिपाः\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2138385, "chapter_id": 3997, "verse_number": "१८", "content_sanskrit": "गच्छन्नपि परां भूमिं भूमिपालनियोजितः ।\nजात्यन्ध इव मन्येत मर्यादामनुचिन्तयन्\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2138386, "chapter_id": 3997, "verse_number": "१९", "content_sanskrit": "यत्रोपविष्टः सङ्कल्पं नोपहन्याद् बलीयसः ।\nतदासनं राजकुले ईप्सेत पुरुषो वसन्\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2138387, "chapter_id": 3997, "verse_number": "२०", "content_sanskrit": "यत्र यत्रैनमासीनं शङ्केरन् दृष्टचारिणः ।\nन तत्रोपविशेद् यो वै स राजवसतिं वसेत्\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2138388, "chapter_id": 3997, "verse_number": "२१", "content_sanskrit": "स भूमौ काममासीत तिष्ठेद्वा राजसन्निधौ ।\nन त्वेवासनमन्यस्य प्रार्थयीत कदाचन\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2138389, "chapter_id": 3997, "verse_number": "२२", "content_sanskrit": "परासनगतं ह्येनं परस्य परिचारकाः ।\nपरिषद्यपकर्षेयुः परिहास्येन शत्रुभिः\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2138390, "chapter_id": 3997, "verse_number": "२३", "content_sanskrit": "नित्यं विप्रतिषिद्धं तु पुरस्तादासनं मतम् ।\nअर्थार्थे हि यदा भृत्यो राजानमुपतिष्ठते\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2138391, "chapter_id": 3997, "verse_number": "२४", "content_sanskrit": "यत्नाच्चोपचरेदेनमग्निवद् देववच्च ह ।\nअनृतेनोपचीर्णा हि हिंस्यादेनमसंशयम्\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2138392, "chapter_id": 3997, "verse_number": "२५", "content_sanskrit": "यस्य भर्ताऽनुयुञ्जीत तदेवाभ्यनुवर्णयेत् ।\nप्रमादमवहेलां च कोपं च परिवर्जयेत्\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2138393, "chapter_id": 3997, "verse_number": "२६", "content_sanskrit": "समर्थनासु सर्वासु हितं च प्रियमेव च ।\nसंवर्णयेत् तदेवास्य प्रियादपि हितं भवेत्\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2138394, "chapter_id": 3997, "verse_number": "२७", "content_sanskrit": "अनुकूलो भवेच्चास्य सर्वार्थेषु कथासु च ।\nअप्रियं चाहितं यत् स्यात् तदस्मै नानुवर्णयेत्\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2138395, "chapter_id": 3997, "verse_number": "२८", "content_sanskrit": "नाहमस्य प्रियोऽस्मीति मत्वा सेवेत पण्डितः ।\nअप्रमत्तश्च यत्तश्च हितं कुर्यात् प्रियं च तत्\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2138396, "chapter_id": 3997, "verse_number": "२९", "content_sanskrit": "दक्षिणं वाऽथ वामं भागमासीत पण्डितः ।\nरक्षिणामात्तशस्त्राणां पश्चात्स्थानं विधीयते\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2138397, "chapter_id": 3997, "verse_number": "३०", "content_sanskrit": "पूज्यमानोऽपि यो राज्ञा नरो न प्रतिपूजयेत् ।\nनैतमाराधयेज्जातु शास्ता शिष्यानिवालसान्\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2138398, "chapter_id": 3997, "verse_number": "३१", "content_sanskrit": "नास्य युग्यं न पर्यङ्कं नासनं न रथं तथा ।\nआरोहेत् सान्वितोऽस्मीति यो राजवसतिं वसेत्\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2138399, "chapter_id": 3997, "verse_number": "३२", "content_sanskrit": "यो वै गृहेभ्यः प्रवसन् चात्मानमनुसंस्मरेत् ।\nउत्थाने नित्यसङ्कल्पो निस्तन्द्री संयतात्मवान्\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2138400, "chapter_id": 3997, "verse_number": "३३", "content_sanskrit": "परीतः क्षुत्पिपासाभ्यां विहाय परिदेवनम् ।\nदुःखेन सुखमन्विच्छेद् यो राजवसतिं वसेत्\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2138401, "chapter_id": 3997, "verse_number": "३४", "content_sanskrit": "अन्येषु प्रेष्यमाणेषु पुरस्ताद् धीर उत्पतेत् ।\nकरिष्याम्यहमित्येवं यः स राजसु सिद्ध्यति\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2138402, "chapter_id": 3997, "verse_number": "३५", "content_sanskrit": "उष्णे वा यदि वा शीते रात्रौ वा यदि वा दिवा ।\nआदिष्टो न विकल्पेत यः स राजसु सिद्ध्यति\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2138403, "chapter_id": 3997, "verse_number": "३६", "content_sanskrit": "ऋजुर्मृदुः सत्यवादी यः स राजसु सिद्ध्यति\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2138404, "chapter_id": 3997, "verse_number": "३७", "content_sanskrit": "नैव लाभाद्धर्षमियान्न व्यथेच्च विमानितः ।\nसमः पूर्णतुलेव स्याद् यो राजवसतिं वसेत्\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2138405, "chapter_id": 3997, "verse_number": "३८", "content_sanskrit": "अल्पेच्छो धृतिमान् राज्ञः छायेवानपगः सदा ।\nदक्षः प्रदक्षिणो धीरो यो राजवसतिं वसेत्\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2138406, "chapter_id": 3997, "verse_number": "समाप्तिः", "content_sanskrit": "इतिहासपुराणज्ञः कुशलः सत्कथासु च ।\nवदान्यः सत्यवाक् चापि यो राजवसतिं वसेत्\t ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2138407, "chapter_id": 3997, "verse_number": "४०", "content_sanskrit": "न मिथो भाषितं राज्ञो मनुष्येषु प्रकाशयेत् ।\nयं चासूयन्ति राजानः पुरुषं न वदेच्च तम्\t ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2138408, "chapter_id": 3997, "verse_number": "", "content_sanskrit": "नैषां कर्मसु संयुक्तो धनं किञ्चिदपि स्पृशेत् ।\nप्राप्नुयादाददानो हि बन्धं वा वधमेव वा\t ॥४१॥\n(प्राप्नोति हि हरन् द्रव्यं बन्धं वा वधमेव वा)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2138409, "chapter_id": 3997, "verse_number": "४२", "content_sanskrit": "यानं वस्त्रमलङ्कारं यच्चान्यत् सम्प्रयच्छति ।\nतदेव धारयेन्नित्यमेवं प्रियतरो भवेत्\t ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2138410, "chapter_id": 3997, "verse_number": "४३", "content_sanskrit": "तुल्योपस्थितयोः पश्यन् मम चान्यस्य चोभयोः ।\nअन्यं पुष्णाति मद्धीनमिति धीरो न मुह्यति\t ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2138411, "chapter_id": 3997, "verse_number": "४४", "content_sanskrit": "श्रेयांसं हि परित्यज्य वैद्यं कर्मणि निष्ठितम् ।\nपापीयांसं प्रकुर्वीरन् शीलमेषां तथाविधम्\t ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2138412, "chapter_id": 3997, "verse_number": "४५", "content_sanskrit": "नैषां दारेषु कुर्वीत प्राज्ञो मैत्रीं कथञ्चन ।\nरक्षिणश्च न सेवेत यो राजवसतिं वसेत्\t ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2138413, "chapter_id": 3997, "verse_number": "४६", "content_sanskrit": "यदा ह्यभिसमीक्षेत प्रेष्यं स्त्रीभिः समागतम् ।\nबुद्धिः परिभवेत् तस्य राजा शङ्केत वा पुनः\t ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2138414, "chapter_id": 3997, "verse_number": "४७", "content_sanskrit": "शङ्कितस्य पुनः स्त्रीषु कस्य भृत्यस्य भूमिपः ।\nजीवितं साधु मन्येत प्रकृतिस्थो बलात्कृतः\t ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2138415, "chapter_id": 3997, "verse_number": "४८", "content_sanskrit": "हर्षवस्तुषु चाप्यत्र वर्तमानेषु केषुचित् ।\nनातिगाढं प्रहृष्टः स्यात् तान्येवास्यानुपूजयेत्\t ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2138416, "chapter_id": 3997, "verse_number": "४९", "content_sanskrit": "हर्षाद्धि मन्दः पुरुषः स्वैरं कुर्वीत वैकृतम् ।\nतस्य चान्तःपुरे वृत्तमीक्षाङ्कुर्वीत भूमिपः\t ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2138417, "chapter_id": 3997, "verse_number": "५०", "content_sanskrit": "अन्तःपुरगतं ह्येनं स्त्रियः क्लीबाश्च सर्वशः ।\nवर्तमानं यथावच्च कुत्सयेयुरसंशयम्\t ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2138418, "chapter_id": 3997, "verse_number": "५१", "content_sanskrit": "तस्माद् गम्भीरमात्मानं कृत्वा हर्षं नियम्य च ।\nनित्यमन्तःपुरे राज्ञो न वृत्तं कीर्तयेद् बहिः\t ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2138419, "chapter_id": 3997, "verse_number": "५२", "content_sanskrit": "यथा हि सुमहामन्त्रो भिद्यमानो हरेत् सुखम् ।\nएवमन्तःपुरे वृत्तं श्रूयमाणं बहिर्भवेत्\t ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2138420, "chapter_id": 3997, "verse_number": "५३", "content_sanskrit": "या तु वृत्तिरबाह्यानां बाह्यानामपि केवलम् ।\nउभयेषां समस्तानां शृणु राजोपजीविनाम्\t ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2138421, "chapter_id": 3997, "verse_number": "५४", "content_sanskrit": "न स्त्रियो जातु मन्येत बाह्यो वाऽऽभ्यन्तरोऽपि वा ।\nअनुजीविनां नरेन्द्रस्तु सृजेद्धि सुमहद्भयम्\t ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2138422, "chapter_id": 3997, "verse_number": "५५", "content_sanskrit": "मत्वाऽस्य प्रियमात्मानं राजरत्नानि राजवत् ।\nअराजा राजयोग्यानि नोपयुञ्जीत पण्डितः\t ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2138423, "chapter_id": 3997, "verse_number": "५६", "content_sanskrit": "अराजानं हि रत्नानि राजकान्तानि राजवत् ।\nभुञ्जानं न नरं राजा तितिक्षेतानुजीविनम्\t ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2138424, "chapter_id": 3997, "verse_number": "५७", "content_sanskrit": "तस्मादव्यक्तभोगेन भोक्तव्यं भूतिमिच्छता ।\nतुल्यभोगं हि राजा तु भृत्यं कोपेन योजयेत्\t ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2138425, "chapter_id": 3997, "verse_number": "५८", "content_sanskrit": "न चापत्येन सम्प्रीतिं राज्ञः कुर्वीत केनचित् ।\nअधिक्षिप्तमनर्थं च द्वेष्यं च परिवर्जयेत्\t ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2138426, "chapter_id": 3997, "verse_number": "५९", "content_sanskrit": "एतान् तु सेवमानस्य नरसीमां चतुर्विधाम् ।\nद्विधा विभिद्यते मूलं राजमूलोपसेविनः\t ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2138427, "chapter_id": 3997, "verse_number": "६०", "content_sanskrit": "एतैस्तु विपरीता या नरसीमा नराधिपैः ।\nतया कुर्वीत संसर्गं न विरोधं कथञ्चन\t ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2138428, "chapter_id": 3997, "verse_number": "६१", "content_sanskrit": "बन्धुभिश्च नरेन्द्रस्य बलवद्भिश्च मानवैः ।\nसाधु मन्येत संसर्गं न विरोधं कथञ्चन\t ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2138429, "chapter_id": 3997, "verse_number": "६२", "content_sanskrit": "आभ्यां तु नरसीमाभ्यां विरुद्धस्याल्पचेतसः ।\nप्रथमं छिद्यते निद्रा द्वितीयं जायते भयम्\t ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2138430, "chapter_id": 3997, "verse_number": "६३", "content_sanskrit": "उद्धतानां च यो वेषः कुहकानां च यो भवेत् ।\nराजवेषं च विस्पष्टं सेवमानो न वर्धते\t ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2138431, "chapter_id": 3997, "verse_number": "६४", "content_sanskrit": "इतराभ्यां तु वेषाभ्यां परिहास्येत बान्धवैः\t ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2138432, "chapter_id": 3997, "verse_number": "६५", "content_sanskrit": "अपुम्भिश्चैव पुम्भिश्च स्त्रीभिः स्त्रीदर्शिभिर्नरैः ।\nशक्ये सति न सम्भाषां जातु कुर्वीत कर्हिचित्\t ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2138433, "chapter_id": 3997, "verse_number": "६६", "content_sanskrit": "प्रतिसम्भाषमाणोऽपि त्रिभिरेतैरचेतनः ।\nश्येनः पेशीमिवादत्ते पुरुषो भूतिमात्मनः\t ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2138434, "chapter_id": 3997, "verse_number": "६७", "content_sanskrit": "ये तु राज्ञा ह्यसत्कारं लभेरन् कारणार्थिनः ।\nतैश्च सामन्तदूतैश्च न संसज्जेत कर्हिचित्\t ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2138435, "chapter_id": 3997, "verse_number": "६८", "content_sanskrit": "न चान्याचरितां भूमिमसन्दिष्टो महीपतिः ।\nउपसेवेत मेधावी यो राजवसतिं वसेत्\t ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2138436, "chapter_id": 3997, "verse_number": "६९", "content_sanskrit": "न च सन्दर्शने किञ्चित् प्रवृद्धमभिसञ्जपेत् ।\nअपि ह्यैतद् दरिद्राणां व्यलीकस्थानमुत्तमम्\t ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2138437, "chapter_id": 3997, "verse_number": "७०", "content_sanskrit": "अर्थकामा च या नारी राजानं स्यादुपस्थिता ।\nअनुजीवी तथायुक्तां निध्यायन् दुष्यते च सः\t ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2138438, "chapter_id": 3997, "verse_number": "७१", "content_sanskrit": "तस्मान्नारीं न निध्यायेत् तथायुक्तां विचक्षणः ।\nतथा क्षुतं च वातं च निष्ठीवं चाचरेच्छनैः\t ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2138439, "chapter_id": 3997, "verse_number": "७२", "content_sanskrit": "न नर्मसु हसेज्जातु मूढवृत्तिर्हि सा स्मृता ।\nस्मितं तु मृदुपूर्वेण दर्शयीत प्रसादजम्\t ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2138440, "chapter_id": 3997, "verse_number": "७३", "content_sanskrit": "न चाक्षौ न भुजौ जातु न च वक्त्रं समाक्षिपेत् ।\nन च तिर्यगवेक्षेत चक्षुर्भ्यां सम्यगाचरेत्\t ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2138441, "chapter_id": 3997, "verse_number": "७४", "content_sanskrit": "भ्रुकुटिं च न कुर्वीत न चाङ्गुष्ठैर्महीं लिखेत् ।\nनातिगाढं प्रहृष्येत जातु राज्ञः समीपतः\t ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2138442, "chapter_id": 3997, "verse_number": "७४", "content_sanskrit": "न प्रशंसेन्न चासूयेत् प्रियेषु च हितेषु च ।\nस्तूयमानेषु वा तत्र दुष्यमाणेषु वा पुनः\t ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2138443, "chapter_id": 3997, "verse_number": "७६", "content_sanskrit": "अथ सन्दृश्यमानेषु प्रियेषु च हितेषु च ।\nश्रूयमाणेषु वाक्येषु वर्णयेदमृतं यथा\t ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2138444, "chapter_id": 3997, "verse_number": "७७", "content_sanskrit": "न राज्ञः प्रतिकूलानि सेवमानः सुखी भवेत् ।\nपुत्रो वा यदि वा भ्राता यद्यप्यात्मसमो भवेत्\t ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2138445, "chapter_id": 3997, "verse_number": "७८", "content_sanskrit": "अप्रमत्तो हि राजानं रञ्जयेत् शीलसम्पदा ।\nउत्थानेन तु मेधावी शौचेन द्विविधेन तम्\t ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2138446, "chapter_id": 3997, "verse_number": "७९", "content_sanskrit": "स्नानं हि वस्त्रशुद्धिश्च शारीरं शौचमुच्यते ।\nअसक्तिः प्राकृतार्थेषु द्वितीयं शौचमुच्यते\t ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2138447, "chapter_id": 3997, "verse_number": "८०", "content_sanskrit": "राजा भोजो विराट् सम्राट् क्षत्रियो भूपतिर्नृपः ।\nय एतैः स्तूयते शब्दैः कस्तं नार्चितुमर्हति\t ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2138448, "chapter_id": 3997, "verse_number": "८१", "content_sanskrit": "तस्माद् भक्तो हि युक्तः सन् सत्यवादी जितेन्द्रियः ।\nमेधावी धृतिमान् प्राज्ञः संश्रयीत महीपतिम्\t ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2138449, "chapter_id": 3997, "verse_number": "८२", "content_sanskrit": "एष वः समुदाचारः समुद्दिष्टो यथाविधि ।\nयथाऽर्थान् सम्प्रपत्स्यन्ते पार्थ राजोपजीविनः\t ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2138450, "chapter_id": 3997, "verse_number": "८३", "content_sanskrit": "संवत्सरमिमं तावद् एवंशीला बुभूषत ।\nततः स्वविषयं प्राप्य यथाकामं चरिष्यथ\t ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2138451, "chapter_id": 3997, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2138452, "chapter_id": 3997, "verse_number": "८४", "content_sanskrit": "तं तथेत्यब्रुवन् पार्थाः ऋषिकल्पं यशस्विनम् ।\nप्रहृष्टाश्चाभिवाद्यैनमुपातिष्ठन् परन्तपाः\t ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2138453, "chapter_id": 3997, "verse_number": "८५", "content_sanskrit": "तेषां प्रतिष्ठमानानां मन्त्रांश्च ब्राह्मणोऽजपत् ।\nसर्वविघ्नप्रशमनानर्थसिद्धिकरांस्तथा\t ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2138454, "chapter_id": 3997, "verse_number": "८६", "content_sanskrit": "भवाय राष्ट्रलाभाय पराय विजयाय च\t ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2138455, "chapter_id": 3997, "verse_number": "८७", "content_sanskrit": "ततोऽब्रवीदसौ विप्रो वाचमाशीः प्रयुज्य च ।\nस्वद्रव्यप्रतिलाभाय शत्रूणां विनयाय च\t ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2138456, "chapter_id": 3997, "verse_number": "८८", "content_sanskrit": "स्वस्ति वोऽस्तु शिवः पन्था द्रक्ष्यामि पुनरागतान् ।\nइत्युक्ता हृष्टमनसो गुरुणा तेन धीमता\t ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2138457, "chapter_id": 3997, "verse_number": "८९", "content_sanskrit": "युधिष्ठिरमुखाः सर्वे गन्तुं समुपचक्रमुः\t ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2138458, "chapter_id": 3997, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि पञ्चमोऽध्यायः ॥५॥ वैराटपर्वणि धौम्यवाक्यं नाम पञ्चमोऽध्यायः ॥५॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}]