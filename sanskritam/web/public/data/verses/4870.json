[{"id": 2182563, "chapter_id": 4870, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2182564, "chapter_id": 4870, "verse_number": "१", "content_sanskrit": "कथंस्विदिह राजेन्द्र पालयन् पार्थिवः प्रजाः ।\nप्रैति धर्मं विशेषेण कीर्तिमाप्नोति शाश्वतीम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2182565, "chapter_id": 4870, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2182566, "chapter_id": 4870, "verse_number": "२", "content_sanskrit": "व्यवहारेण शुद्धेन प्रजापालनतत्परः ।\nप्राप्य धर्मं च कीर्तिं च लोकावाप्नोत्युभौ शुचिः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2182567, "chapter_id": 4870, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2182568, "chapter_id": 4870, "verse_number": "३", "content_sanskrit": "कीदृशं व्यवहारं तु कैश्च व्यवहरेन्नृपः ।\nएतत्पृष्टो महाप्राज्ञ यथावद् वक्तुमर्हसि\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2182569, "chapter_id": 4870, "verse_number": "४", "content_sanskrit": "ये चैते पूर्वकथिता गुणास्ते पुरुषं प्रति ।\nनैकस्मिन् पुरुषे ह्येते विद्यन्त इति मे मतिः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2182570, "chapter_id": 4870, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2182571, "chapter_id": 4870, "verse_number": "५", "content_sanskrit": "एवमेतन्महाप्राज्ञ यथा वदसि बुद्धिमान् ।\nदुर्लभः पुरुषः कश्चिदेभिर्गुणगणैर्युतः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2182572, "chapter_id": 4870, "verse_number": "६", "content_sanskrit": "किन्तु सङ्क्षेपतः शीलं प्रयत्ने नेह दुर्लभम् ।\nवक्ष्यामि तु यथामात्यान् यादृशांश्च करिष्यसि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2182573, "chapter_id": 4870, "verse_number": "७", "content_sanskrit": "चतुरो ब्राह्मणान् वैद्यान् प्रगल्भान् सात्विकान् शुचीन् ।\nक्षत्रियांश्च तथा चाष्टौ बलिनः शस्त्रपाणिनः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2182574, "chapter_id": 4870, "verse_number": "८", "content_sanskrit": "वैश्यान् वित्तेन सम्पन्नानेकविंशति सङ्ख्यया ।\nत्रींश्च शूद्रान् विनीतांश्च शुचीन् कर्मणि पूर्वके\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2182575, "chapter_id": 4870, "verse_number": "९", "content_sanskrit": "अष्टाभिश्च गुणैर्युक्तः सूतः पौराणिको भवेत् ।\nपञ्चाशद्वर्षवयसं प्रगल्भमनसूयकम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2182576, "chapter_id": 4870, "verse_number": "१०", "content_sanskrit": "मतिस्मृतिसमायुक्तं विनीतं समदर्शनम् ।\nकल्पयेद् वदमानानां शक्तमर्थेष्वलोलुपम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2182577, "chapter_id": 4870, "verse_number": "११", "content_sanskrit": "वि्अवर्जितानां व्यसनैः सुघोरैः सप्तभिर्भृशम् ।\nअष्टानां मन्त्रिणां मध्ये मन्त्रं राजोपधारयेत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2182578, "chapter_id": 4870, "verse_number": "१२", "content_sanskrit": "ततः सम्प्रेषयेद् राष्ट्रे राष्ट्रियाथ च दर्शयेत् ।\nअनेन व्यवहारेण द्रष्टव्यास्ते प्रजाः सदा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2182579, "chapter_id": 4870, "verse_number": "१३", "content_sanskrit": "नचापि गूढं कार्यं ते ग्राह्यं कार्योपघातकम् ।\nकार्ये खलु विपन्ने त्वां सोऽधर्मस्तांश्च पीडयेत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2182580, "chapter_id": 4870, "verse_number": "१४", "content_sanskrit": "विद्रवेच्चैव राष्ट्रं ते श्येनात् पक्षिगणा इव ।\nपरिस्रवेच्च सततं नौर्विशीर्णेव सागरे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2182581, "chapter_id": 4870, "verse_number": "१५", "content_sanskrit": "प्रजाः पालयतोऽसम्यगधर्मेणेह भूपतेः ।\nहार्दं भयं सम्भवति स्वर्गश्चास्य विरुद्ध्यते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2182582, "chapter_id": 4870, "verse_number": "१६", "content_sanskrit": "अथ योऽधर्मतः पाति राजाऽमात्योऽथ वात्मजः ।\nधमार्सने नियुक्तः सन् धर्ममूलं नरर्षभ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2182583, "chapter_id": 4870, "verse_number": "१७", "content_sanskrit": "कार्येष्वधिकृताः सम्यगकुर्वन्तो नृपानुगाः ।\nआत्मानं पुरतः कृत्वा यान्त्यधः सहपार्थिवाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2182584, "chapter_id": 4870, "verse_number": "१८", "content_sanskrit": "बलात्कृतानां बलिभि्अः कृपणं बहु जल्पताम् ।\nनाथो वै भूमिपो नित्यमनाथानां नृणां भवेत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2182585, "chapter_id": 4870, "verse_number": "१९", "content_sanskrit": "ततः साक्षिबलं साधु द्वैधवादे कृतं भवेत् ।\nअसाक्षिकमनाथं वा परीक्ष्यं तद् विशेषतः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2182586, "chapter_id": 4870, "verse_number": "२०", "content_sanskrit": "अपराधानुरूपं च दण्डं पापेषु पातयेत् ।\nउद्वेजयेद्धनैर्ऋद्धान् दरिद्रान् वधबन्धनैः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2182587, "chapter_id": 4870, "verse_number": "२१", "content_sanskrit": "विनयैरपि दुर्वृत्तान् प्रहारैरपि पार्थिवः ।\nसान्त्वेनोपप्रदानेन शिष्टांश्च परिपालयेत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2182588, "chapter_id": 4870, "verse_number": "२२", "content_sanskrit": "राज्ञो वधं चिकीर्षेद् यस्तस्य चित्रो वधो भवेत् ।\nआदीपकस्य स्तेनस्य वर्णसङ्करकस्य च\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2182589, "chapter_id": 4870, "verse_number": "२३", "content_sanskrit": "सम्यक् प्रणयतो दण्डं भूमिपस्य विशाम्पते ।\nयुक्तस्य वा नास्त्यधर्मो धर्म एवेह शाश्वतः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2182590, "chapter_id": 4870, "verse_number": "२४", "content_sanskrit": "कामकारेण दण्डं तु यः कुर्यादविचक्षणः ।\nस इहाकीर्तिसंयुक्तो मृतो नरकमाप्नुयात्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2182591, "chapter_id": 4870, "verse_number": "२५", "content_sanskrit": "न परस्य श्रवादेव परेषां दण्डमर्पयेत् ।\nआगमानुगमं कृत्वा बध्नीयान्मोक्षयेत वा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2182592, "chapter_id": 4870, "verse_number": "२६", "content_sanskrit": "नतु हन्यान्नृपो जातु दूतं कस्याञ्चिदापदि ।\nदूतस्य हन्ता निरयमाविशेत् सचिवैः सह\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2182593, "chapter_id": 4870, "verse_number": "२७", "content_sanskrit": "यथोक्तवादिनं दूतं क्षत्रधर्मरतो नृपः ।\nयो हन्यात् पितरस्तस्य भ्रूणहत्यामवाप्नुयुः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2182594, "chapter_id": 4870, "verse_number": "२८", "content_sanskrit": "कुलीनः शीलसम्पन्नो वाग्मी दक्षः प्रियंवदः ।\nयथोक्तवादी स्मृतिमान् दूतः स्यात् सप्तभिर्गुणैः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2182595, "chapter_id": 4870, "verse_number": "२९", "content_sanskrit": "एतैरेव गुणैर्युक्तः प्रतीहारोऽस्य रक्षिता ।\nशिरोरक्षश्च भवति गुणैरेतैः समन्वितः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2182596, "chapter_id": 4870, "verse_number": "३०", "content_sanskrit": "धर्मार्थशास्त्रतत्त्वज्ञः सन्धिविग्रहकोविदः ।\nमतिमान् धृतिमान् धीमान् रहस्यविनिगूहिता\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2182597, "chapter_id": 4870, "verse_number": "३१", "content_sanskrit": "कुलीनः सत्यसम्पन्नः शक्तोऽमात्यः प्रशंसितः ।\nएतैरेव गुणैर्युक्तस्तथा सेनापतिर्भवेत्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2182598, "chapter_id": 4870, "verse_number": "३२", "content_sanskrit": "व्यूहयन्त्रायुधीयानां तत्त्वज्ञो विक्रमान्वितः ।\nवर्षशीतोष्णवातानां सहिष्णुः पररन्ध्रवित्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2182599, "chapter_id": 4870, "verse_number": "३३", "content_sanskrit": "विश्वासयेत् परांश्चैव विश्वसेन्नतु कस्यचित् ।\nपुत्रेष्वपि हि राजेन्द्र विश्वासो न प्रशस्यते\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2182600, "chapter_id": 4870, "verse_number": "३४", "content_sanskrit": "एतच्छास्त्रार्थतत्त्वं तु तवाख्यातं मयाऽनघ ।\nअविश्वासो नरेन्द्राणां गुह्यं परममुच्यते\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2182601, "chapter_id": 4870, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे सप्ताशीतितमोऽध्यायः ॥ ८७ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]