[{"id": 2157388, "chapter_id": 4411, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2157389, "chapter_id": 4411, "verse_number": "१", "content_sanskrit": "ते सेने शिबिरं गत्वा न्यविशेतां विशाम्पते ।\nयथान्यायं यथागुल्मं यथाभागं च सर्वशः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2157390, "chapter_id": 4411, "verse_number": "२", "content_sanskrit": "कृत्वाऽवहारं सैन्यानां द्रोणः परमदुर्मनाः ।\nदुर्योधनमिदं वाक्यं सव्रीडमिदमब्रवीत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2157391, "chapter_id": 4411, "verse_number": "३", "content_sanskrit": "उक्तमेतन्मया पूर्वं न तिष्ठति धनञ्जये ।\nशक्यो ग्रहीतुं समरे देवैरपि युधिष्ठिरः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2157392, "chapter_id": 4411, "verse_number": "समाप्तिः", "content_sanskrit": "इति तद्वचनं सत्यं जानीध्वं साधु संयुगे ।\nमाऽतिशङ्कीर्वचो मह्यमजय्यौ कृष्णपाण्डवौ\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2157393, "chapter_id": 4411, "verse_number": "५", "content_sanskrit": "अपनीते तु योगेन केनचिच्छ्वेतवाहने ।\nतत एष्यति ते राजन् वशमद्य युधिष्ठिरः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2157394, "chapter_id": 4411, "verse_number": "६", "content_sanskrit": "कश्चिदाह्वयतां सङ्खे देशमन्यमितोऽर्जुनम् ।\nतमजित्वा तु कौन्तेयो निवर्तेन्न कथञ्चन\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2157395, "chapter_id": 4411, "verse_number": "७", "content_sanskrit": "एतस्मिन्नन्तरे शून्ये धर्मराजमहं नृपम् ।\nग्रहीष्यामि चमूं भित्त्वा धृष्टद्युम्नस्य पश्यतः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2157396, "chapter_id": 4411, "verse_number": "८", "content_sanskrit": "अर्जुनेन परित्यक्तो न चेत् त्रासात् पलायते ।\nमामुपायान्तमालोक्य गृहीतमिति विद्धि तम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2157397, "chapter_id": 4411, "verse_number": "९", "content_sanskrit": "क्षोभयित्वा बलं तेषां पाण्डवानां महात्मनाम् ।\nतमानेष्यामि सगणं वशं तव न संशयः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2157398, "chapter_id": 4411, "verse_number": "१०", "content_sanskrit": "यदि स्थास्यति सङ्ग्रामे मुहूर्तमपि पाण्डवः ।\nयद्यपेष्यति सङ्ग्रामाद् ग्रहणात् तद् विशिष्यते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2157399, "chapter_id": 4411, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2157400, "chapter_id": 4411, "verse_number": "११", "content_sanskrit": "द्रोणस्य तद् वचः श्रुत्वा त्रिगर्ताधिपतिस्ततः ।\nभ्रातृभिः सहितो राजन्निदं वचनमब्रवीत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2157401, "chapter_id": 4411, "verse_number": "१२", "content_sanskrit": "वयं विनिकृता राजन् सदा गाण्डीवधन्वना ।\nअनागसोऽपि चाकस्मात् प्रेष्याः प्रभवता यथा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2157402, "chapter_id": 4411, "verse_number": "१३", "content_sanskrit": "ते वयं स्मरमाणास्तान् विप्रकारान् पृथग्विधान् ।\nक्रोधाग्निना दह्यमाना नाशीमहि दिवानिशम्\nस नो दिव्यास्त्रसम्पन्नः चक्षुर्विषयमागतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2157403, "chapter_id": 4411, "verse_number": "१४", "content_sanskrit": "यदि कुर्याम तत् कर्म यच्चिकीर्षाम हृद्गतम् ।\nभवतश्च प्रियं तत् स्याद् अस्माकं च यशस्करम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2157404, "chapter_id": 4411, "verse_number": "१५", "content_sanskrit": "अद्यास्त्वनर्जुना भूमिरत्रिगर्ताऽथवा पुनः ।\nवयमेनं हनिष्यामो निकृष्यायोधनाद् बहिः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2157405, "chapter_id": 4411, "verse_number": "१६", "content_sanskrit": "सत्यं ते प्रतिजानीमो नैतन्मिथ्या भविष्यति \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2157406, "chapter_id": 4411, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2157407, "chapter_id": 4411, "verse_number": "१७", "content_sanskrit": "एवं सत्यरथश्चोक्त्वा सत्यवर्मा च भारत ।\nसत्यधर्माऽपि सत्येषुः सत्यकर्मा च भारत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2157408, "chapter_id": 4411, "verse_number": "१८", "content_sanskrit": "सहिता भ्रातरः पञ्च रथानामयुतेन च ।\nन्यवर्तन्त महाराज कर्तुं समयबन्धनम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2157409, "chapter_id": 4411, "verse_number": "१९", "content_sanskrit": "मालवास्तुण्डिकेराश्च रथानामयुतैस्त्रिभिः ।\nसुशर्मा च नरव्याघ्रः त्रैगर्तः प्रस्थलाधिपः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2157410, "chapter_id": 4411, "verse_number": "२०", "content_sanskrit": "मच्चिल्लकैर्लिलिन्ध्रैश्च सहितो मद्रकैरपि ।\nरथानामयुतेनैवमगमद् भ्रातृभिः सह\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2157411, "chapter_id": 4411, "verse_number": "२१", "content_sanskrit": "मलदाश्च करूशाश्च दरदाश्च महारथाः ।\nतङ्कणाश्च परादाश्च युगपत् ते समागताः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2157412, "chapter_id": 4411, "verse_number": "२२", "content_sanskrit": "नानाजनपदेभ्यश्च रथानामयुतं पुनः ।\nसमुच्छ्रितं विशिष्टानां शपथार्थमुपागमत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2157413, "chapter_id": 4411, "verse_number": "२३", "content_sanskrit": "ततो ज्वलनमाधाय हुत्वा सर्वे पृथक् पृथक् ।\nजगृहुः कुशचीराणि चित्राणि कवचानि च\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2157414, "chapter_id": 4411, "verse_number": "२४", "content_sanskrit": "ते च बद्धतनुत्राणा घृताक्ताः कुशचीरिणः ।\nमौर्वीमेखलिनो वीराः सहस्रशतदक्षिणाः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2157415, "chapter_id": 4411, "verse_number": "२५", "content_sanskrit": "यज्वानः पुत्रिणः सर्वे कृतकृत्यास्तनुत्यजः ।\nयोक्तुकामास्तदाऽऽत्मानं यशसा विजयेन च\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2157416, "chapter_id": 4411, "verse_number": "२६", "content_sanskrit": "ब्रह्मचर्यश्रुतिमुखाः क्रतुभिश्चाप्तदक्षिणैः ।\nप्राप्यलोकान् सुयुद्धेन क्षिप्रमेव यियासवः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2157417, "chapter_id": 4411, "verse_number": "२७", "content_sanskrit": "ब्राह्मणांस्तर्पयित्वा च निष्कं दत्वा पृथक् पृथक् ।\nगाश्च वासांसि च पुनः समाभाष्य परस्परम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2157418, "chapter_id": 4411, "verse_number": "२८", "content_sanskrit": "द्विजमुख्यैः समुदितैः कृतस्वस्त्ययनाशिषः ।\nमुदिताश्च प्रहृष्टाश्च जलं संस्पृश्य निर्मलम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2157419, "chapter_id": 4411, "verse_number": "२९", "content_sanskrit": "ते ज्वालयित्वा ज्वलनम् उपागम्य रणव्रतम् ।\nतस्मिन्नग्नौ ततश्चक्रुः प्रतिज्ञां दृढनिश्चयाम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2157420, "chapter_id": 4411, "verse_number": "३०", "content_sanskrit": "शृण्वतां सर्वभूतानामप्युच्चैर्वाक्यमीरयन् ।\nधृत्याऽर्जुनवधे शूराः प्रतिज्ञामथ चक्रिरे\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2157421, "chapter_id": 4411, "verse_number": "", "content_sanskrit": "संशप्तकाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2157422, "chapter_id": 4411, "verse_number": "३१", "content_sanskrit": "अनृतस्य च ये लोका ये लोका ब्रह्मघातिनाम् ।\nपानपस्य च ये लोका गुरुदाररतस्य च\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2157423, "chapter_id": 4411, "verse_number": "३२", "content_sanskrit": "ब्रह्मस्वहारिणां चैव राजपिण्डापहारिणाम् ।\nशरणागतं च त्यजतां याचमानाभिघातिनाम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2157424, "chapter_id": 4411, "verse_number": "३३", "content_sanskrit": "अगारदाहिनां चापि ये च गां निघ्नतामपि ।\nअभिचारिणां च ये लोका ये च ब्रह्मद्विषामपि\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2157425, "chapter_id": 4411, "verse_number": "३४", "content_sanskrit": "भार्यां चाप्यृतुकालेषु ये लोका नाभिगच्छताम् ।\nश्राद्धसङ्गतिकानां च ये चाप्यात्मापहारिणाम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2157426, "chapter_id": 4411, "verse_number": "३५", "content_sanskrit": "क्लीबेन सान्त्व्यमानानां ये दीनानुसारिणाम् ।\nन्यासापहारिणां ये च श्रुतं नाशयतां च ये\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2157427, "chapter_id": 4411, "verse_number": "३६", "content_sanskrit": "नास्तिकानां च ये लोका येऽग्निमातृपितृत्यजाम् ।\nसस्यमाक्रमतां ये च प्रत्यादित्यं प्रमेहताम्\nतानाप्नुयामहे लोकान् ये च पापकृतामपि\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2157428, "chapter_id": 4411, "verse_number": "३७", "content_sanskrit": "यद्यहत्वा निवर्तेम वयं सङ्खे धनञ्जयम् ।\nतेन चाभ्यर्दितास्त्रासाद् यद्यास्याम पराङ्मुखाः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2157429, "chapter_id": 4411, "verse_number": "३८", "content_sanskrit": "यद्यप्यसुकरं कर्म लोके कुर्याम संयुगे ।\nइष्टान् पुण्यकृतां लोकान् प्राप्नुयाम सुवर्चसः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2157430, "chapter_id": 4411, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2157431, "chapter_id": 4411, "verse_number": "३९", "content_sanskrit": "एवमुक्त्वा ततो राजन् तेऽभ्यवर्तन्त संयुगम् ।\nआह्वयन्तोऽर्जुनं वीराः पितृजुष्टां दिशं प्रति\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2157432, "chapter_id": 4411, "verse_number": "४०", "content_sanskrit": "आहूतस्तैर्नरव्याघ्रः पार्थः परपुरञ्जयः ।\nधर्मराजमिदं वाक्यमपदान्तरमब्रवीत्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2157433, "chapter_id": 4411, "verse_number": "४१", "content_sanskrit": "एष वै भ्रातृभिः सार्धं सुशर्माऽऽह्वयते रणे ।\nवधाय सगणस्यास्य मामनुज्ञातुमर्हसि\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2157434, "chapter_id": 4411, "verse_number": "४२", "content_sanskrit": "आहूतो न निवर्तेयमिति मे व्रतमाहितम् ।\nसंशप्तकाश्च ते राजन्नाह्वयन्ते महामृधे\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2157435, "chapter_id": 4411, "verse_number": "४३", "content_sanskrit": "न शक्नोमि च संसोढुमाह्वानं भरतर्षभ ।\nसत्यं ते प्रतिजानेऽहं हतान् विद्धि परान् युधि\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2157436, "chapter_id": 4411, "verse_number": "४४", "content_sanskrit": "न ह्यर्जुनो रणे राजन् मिथ्या किञ्चित् प्रवक्ष्यति ।\nहतांस्त्रिगर्तकान् पश्य मा स्म ते कश्मलं भवेत्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2157437, "chapter_id": 4411, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2157438, "chapter_id": 4411, "verse_number": "४५", "content_sanskrit": "अश्रौषीस्तात तत् प्रोक्तं यद् द्रोणस्य चिकीर्षितम् ।\nयथाऽनृतं तस्य भवेत् तथा नीतिर्विधीयताम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2157439, "chapter_id": 4411, "verse_number": "४६", "content_sanskrit": "द्रोणो हि बलवान् शूरः कृतास्त्रश्च जितश्रमः ।\nप्रतिज्ञातं च तस्यैतद् ग्रहणं मे महारथ\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2157440, "chapter_id": 4411, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2157441, "chapter_id": 4411, "verse_number": "४७", "content_sanskrit": "सर्वथा न निवर्तेयमाहूतोऽहं परन्तप ।\nत्रिगर्तो भ्रातृभिः सार्धं स मामाह्वयते भृशम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2157442, "chapter_id": 4411, "verse_number": "४८", "content_sanskrit": "तवापि तु रणे रक्षा विहिता मे जनाधिप ।\nनिरपेक्षो गमिष्यामि वधायैषां दुरात्मनाम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2157443, "chapter_id": 4411, "verse_number": "४९", "content_sanskrit": "एष वै सत्यजिद् राजन्नद्य त्वां रक्षिता युधि ।\nध्रियमाणे च पाञ्चाल्ये नाचार्यः काममाप्स्यति\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2157444, "chapter_id": 4411, "verse_number": "५०", "content_sanskrit": "हते तु पुरुषव्याघ्रे सत्यजित्यनिवर्तिनि ।\nसर्वैरपि समेतैर्वा न स्थातव्यं कथञ्चन\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2157445, "chapter_id": 4411, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2157446, "chapter_id": 4411, "verse_number": "५१", "content_sanskrit": "अनुज्ञातस्ततो राज्ञा परिष्वक्तश्च फल्गुनः ।\nप्रेम्णा दृष्टश्च बहुधा आशिषा चैव योजितः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2157447, "chapter_id": 4411, "verse_number": "५२", "content_sanskrit": "वधायैव ततः पार्थस्त्रिगर्तानां बलं ययौ ।\nक्षुधितः क्षुद्विघातार्थं सिंहो मृगगणानिव\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2157448, "chapter_id": 4411, "verse_number": "५३", "content_sanskrit": "ततो दौर्योधनं सैन्यं मुदा परमया युतम् ।\nग्रहणे धर्मराजस्य कृतोत्साहं महामृधे\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2157449, "chapter_id": 4411, "verse_number": "५४", "content_sanskrit": "ततोऽन्योन्यं तु ते सेने समाजग्मतुरञ्जसा \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2157450, "chapter_id": 4411, "verse_number": "५५", "content_sanskrit": "वेगेन शङ्खानापूर्य हर्षयुक्ते महास्वने ।\nगङ्गासरय्वौ वेगेन प्रावृषीवोल्बणोदके\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2157451, "chapter_id": 4411, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि षोडशोऽध्यायः ॥ १६ ॥\nसंशप्तकवधपर्वणि प्रथमोऽध्यायः ॥ १ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]