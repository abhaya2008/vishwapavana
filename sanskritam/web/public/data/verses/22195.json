[{"id": 7002195000, "chapter_id": 22195, "verse_number": "२४०-१", "content_sanskrit": "राम उवाच ।\nमण्डलं चिन्तयेत्मुख्यं राजा द्वादशराजकं ।\nअरिर्मित्रमरेर्मित्रं मित्रमित्रमतः परं ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002195001, "chapter_id": 22195, "verse_number": "२४०-२", "content_sanskrit": "तथारिमित्रमित्रञ्च विजिगीषोः पुरः स्मृताः ।\nपार्ष्णिग्राहः स्मृतः पश्चादाक्रन्दस्तदनन्तरं ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002195002, "chapter_id": 22195, "verse_number": "२४०-३", "content_sanskrit": "आसारावनयोश्चैवं विजगीषाश्च मण्डलं ।\nअरेश्च विजिगीषोश्च मध्यमो भूम्यनन्तरः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002195003, "chapter_id": 22195, "verse_number": "२४०-४", "content_sanskrit": "अनुग्रहे संहतयोर्निग्रहे व्यस्तयोः प्रभुः ।\nमण्डलाद्वहिरेतेषामुदासीनो बलाधिकः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002195004, "chapter_id": 22195, "verse_number": "२४०-५", "content_sanskrit": "अनुग्रहे संहतानां व्यस्तानां च बुधे प्रभुः ।\nसन्धिञ्च विग्रहं यानमासानदि वदामि ते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002195005, "chapter_id": 22195, "verse_number": "२४०-६", "content_sanskrit": "बलवद्विग्रहीतेन सन्धिं कुर्याच्छिवाय च ।\nकपाल उपहारश्च सन्तानः सङ्गतस्तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002195006, "chapter_id": 22195, "verse_number": "२४०-७", "content_sanskrit": "उपन्यासः प्रतीकारः संयोगः पुरुषान्तरः ।\nअदृष्टनर आदिष्ट आत्मापि स उपग्रहः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002195007, "chapter_id": 22195, "verse_number": "२४०-८", "content_sanskrit": "परिक्रमस्तथा छिन्नस्तथा च परदूषणं ।\nस्कन्धोपयेयः सन्धिश्च सन्धयः षोडशेरिताः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002195008, "chapter_id": 22195, "verse_number": "२४०-९", "content_sanskrit": "परस्परोपकारश्च मैत्रः सम्बन्धकस्तथा ।\nउपहाराश्च चत्वारस्तेषु मुख्याश्च सन्धयः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002195009, "chapter_id": 22195, "verse_number": "२४०-१०", "content_sanskrit": "बालो वृद्धो दीर्घरोगस्तथा बन्धुवहिष्कृतः ।\nमौरुको भीरुकजनो लुब्धो लुब्धजनस्तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002195010, "chapter_id": 22195, "verse_number": "२४०-११", "content_sanskrit": "विरक्तप्रकृतिश्चैव विषयेष्वतिशक्तिमान् ।\nअनेकचित्तमन्त्रश्च देवब्राह्मणनिन्दकः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002195011, "chapter_id": 22195, "verse_number": "२४०-१२", "content_sanskrit": "दैवोपहतकश्चैव दैवनिन्दक एव च ।\nदुर्भिक्षव्यसनोपेतो बलव्यसनसङ्कुलः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002195012, "chapter_id": 22195, "verse_number": "२४०-१३", "content_sanskrit": "स्वदेशस्थो बहुरिपुर्मुक्तः कालेन यश्च ह ।\nसत्यधर्मव्यपेतश्च विंशतिः पुरुषा अमी ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002195013, "chapter_id": 22195, "verse_number": "२४०-१४", "content_sanskrit": "एर्तैः सन्धिं न कुर्वीत विगृह्णीयात्तु केबलं ।\nपरस्परापकारेण पुंसां भवति विग्रहः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002195014, "chapter_id": 22195, "verse_number": "२४०-१५", "content_sanskrit": "आत्मनोऽभ्युदयाकाङ्क्षी पीड्यमानः परेण वा ।\nदेशकालबलोपेतः प्रारभेतेह विग्रहं ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002195015, "chapter_id": 22195, "verse_number": "२४०-१६", "content_sanskrit": "राज्यस्त्रीस्थानदेशानां ज्ञानस्य च बलस्य च ।\nअपहारी मदो मानः पीडा वैषयिकी तथा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002195016, "chapter_id": 22195, "verse_number": "२४०-१७", "content_sanskrit": "ज्ञानात्मशक्तिधर्माणां विघातो दैवमेव च ।\nमित्रार्थञ्चापमानश्च तथा बन्धुविनाशनं ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002195017, "chapter_id": 22195, "verse_number": "२४०-१८", "content_sanskrit": "भूतानुग्रहविच्छेदस्तथा मण्डलदूषणं ।\nएकार्थाभिनिवेशत्वमिति विग्रहयोनयः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002195018, "chapter_id": 22195, "verse_number": "२४०-१९", "content_sanskrit": "सापत्न्यं वास्तुजं स्त्रीजं वाग्जातमपराधजं ।\nवैरं पञ्चविधं प्रोक्तं साधनैः प्रशमन्नयेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002195019, "chapter_id": 22195, "verse_number": "२४०-२०", "content_sanskrit": "किञ्चित्फलं निष्फलं वा सन्दिग्धफलमेव च ।\nतदात्वे दोषजननमायत्याञ्चैव निष्फलं ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002195020, "chapter_id": 22195, "verse_number": "२४०-२१", "content_sanskrit": "आयत्याञ्च तदात्वे च दोषसञ्जननं तथा ।\nअपरिज्ञातवीर्येण परेण स्तोभितोऽपि वा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002195021, "chapter_id": 22195, "verse_number": "२४०-२२", "content_sanskrit": "परार्थं स्त्रीनिमित्तञ्च दीर्घकालं द्विजैः सह ।\nअकालदैवयुक्तेन बलोद्धतसखेन च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002195022, "chapter_id": 22195, "verse_number": "२४०-२३", "content_sanskrit": "तदात्वे फलसंयुक्तमायत्यां फलवर्जितं ।\nआयत्यां फलसंयुक्तं तदात्वे निष्फलं तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002195023, "chapter_id": 22195, "verse_number": "२४०-२४", "content_sanskrit": "इतीमं षोडशविधन्नकुर्यादेव विग्रहं ।\nतदात्वायतिसंशुद्धं कर्म राजा सदाचरेत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002195024, "chapter_id": 22195, "verse_number": "२४०-२५", "content_sanskrit": "हृष्टं पुष्टं बलं मत्वा गृह्णीयाद्विपरीतकं ।\nमित्रमाक्रन्द आसारो यदा स्युर्दृढभक्तयः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002195025, "chapter_id": 22195, "verse_number": "२४०-२६", "content_sanskrit": "परस्य विपरीतञ्च तदा विग्रहमाचरेत् ।\nविगृह्य सन्धाय तथा सम्भूयाथ प्रसङ्गतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002195026, "chapter_id": 22195, "verse_number": "२४०-२७", "content_sanskrit": "उपेक्षया च निपुणैर्यानं पञ्चविधं स्मृतं ।\nपरस्परस्य सामर्थ्यविघातादासनं स्मृतं ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002195027, "chapter_id": 22195, "verse_number": "२४०-२८", "content_sanskrit": "अरेश्च विजगीषोश्च यानवत्पञ्चधा स्मृतम् ।\nबलिनीर्द्विषतोर्मध्ये वाचात्मानं समर्पयन् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002195028, "chapter_id": 22195, "verse_number": "२४०-२९", "content_sanskrit": "द्वैधीभावेन तिष्ठेत काकाक्षिवदलक्षितः ।\nउभयोरपि सम्पाते सेवेत बलवत्तरं ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002195029, "chapter_id": 22195, "verse_number": "२४०-३०", "content_sanskrit": "यदा द्वावपि नेच्छेतां संश्लेषं जातसंविदौ ।\nतदोपसर्पेत्तच्छत्रुमधिकं वा स्वयं व्रजेत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002195030, "chapter_id": 22195, "verse_number": "२४०-३१", "content_sanskrit": "उच्छिद्यमानो बलिना निरुपायप्रतिक्रियः ।\nकुलोद्धतं सत्यमार्यमासेवेत बलोत्कटं ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002195031, "chapter_id": 22195, "verse_number": "२४०-३२", "content_sanskrit": "तद्दर्शनोपास्तिकता नित्यन्तद्भावभाविता ।\nतत्कारितप्रश्रियता वृत्तं संश्रयिणः श्रुतं ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]