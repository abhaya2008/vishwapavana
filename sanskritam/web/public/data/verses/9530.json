[{"id": 5000530000, "chapter_id": 9530, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे त्रयोविंशत्यधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000530001, "chapter_id": 9530, "verse_number": "६-१२३-१", "content_sanskrit": "अनुज्ञातं तु रामेण तद् विमानमनुत्तमम्।\nहंसयुक्तं महानादमुत्पपात विहायसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000530002, "chapter_id": 9530, "verse_number": "६-१२३-२", "content_sanskrit": "पातयित्वा ततश्चक्षुः सर्वतो रघुनन्दनः।\nअब्रवीन्मैथिलीं सीतां रामः शशिनिभाननाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000530003, "chapter_id": 9530, "verse_number": "६-१२३-३", "content_sanskrit": "कैलासशिखराकारे त्रिकूटशिखरे स्थिताम्।\nलङ्कामीक्षस्व वैदेहि निर्मितां विश्वकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000530004, "chapter_id": 9530, "verse_number": "६-१२३-४", "content_sanskrit": "एतदायोधनं पश्य मांसशोणितकर्दमम्।\nहरीणां राक्षसानां च सीते विशसनं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000530005, "chapter_id": 9530, "verse_number": "६-१२३-५", "content_sanskrit": "एष दत्तवरः शेते प्रमाथी राक्षसेश्वरः।\nतव हेतोर्विशालाक्षि निहतो रावणो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000530006, "chapter_id": 9530, "verse_number": "६-१२३-६", "content_sanskrit": "कुम्भकर्णोऽत्र निहतः प्रहस्तश्च निशाचरः।\nधूम्राक्षश्चात्र निहतो वानरेण हनूमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000530007, "chapter_id": 9530, "verse_number": "६-१२३-७", "content_sanskrit": "विद्युन्माली हतश्चात्र सुषेणेन महात्मना।\nलक्ष्मणेनेन्द्रजिच्चात्र रावणिर्निहतो रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000530008, "chapter_id": 9530, "verse_number": "६-१२३-८", "content_sanskrit": "अङ्गदेनात्र निहतो विकटो नाम राक्षसः।\nविरूपाक्षश्च दुष्प्रेक्षो महापार्श्वमहोदरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000530009, "chapter_id": 9530, "verse_number": "६-१२३-९", "content_sanskrit": "अकम्पनश्च निहतो बलिनोऽन्ये च राक्षसाः।\nत्रिशिराश्चातिकायश्च देवान्तकनरान्तकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000530010, "chapter_id": 9530, "verse_number": "६-१२३-१०", "content_sanskrit": "युद्धोन्मत्तश्च मत्तश्च राक्षसप्रवरावुभौ।\nनिकुम्भश्चैव कुम्भश्च कुम्भकर्णात्मजौ बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000530011, "chapter_id": 9530, "verse_number": "६-१२३-११", "content_sanskrit": "वज्रदंष्ट्रश्च दंष्ट्रश्च बहवो राक्षसा हताः।\nमकराक्षश्च दुर्धर्षो मया युधि निपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000530012, "chapter_id": 9530, "verse_number": "६-१२३-१२", "content_sanskrit": "अकम्पनश्च निहतः शोणिताक्षश्च वीर्यवान्।\nयूपाक्षश्च प्रजङ्घश्च निहतौ तु महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000530013, "chapter_id": 9530, "verse_number": "६-१२३-१३", "content_sanskrit": "विद्युज्जिह्वोऽत्र निहतो राक्षसो भीमदर्शनः।\nयज्ञशत्रुश्च निहतः सुप्तघ्नश्च महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000530014, "chapter_id": 9530, "verse_number": "६-१२३-१४", "content_sanskrit": "सूर्यशत्रुश्च निहतो ब्रह्मशत्रुस्तथापरः।\nअत्र मन्दोदरी नाम भार्या तं पर्यदेवयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000530015, "chapter_id": 9530, "verse_number": "६-१२३-१५", "content_sanskrit": "सपत्नीनां सहस्रेण साग्रेण परिवारिता।\nएतत् तु दृश्यते तीर्थं समुद्रस्य वरानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000530016, "chapter_id": 9530, "verse_number": "६-१२३-१६", "content_sanskrit": "यत्र सागरमुत्तीर्य तां रात्रिमुषिता वयम्।\nएष सेतुर्मया बद्धः सागरे लवणार्णवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000530017, "chapter_id": 9530, "verse_number": "६-१२३-१७", "content_sanskrit": "तव हेतोर्विशालाक्षि नलसेतुः सुदुष्करः।\nपश्य सागरमक्षोभ्यं वैदेहि वरुणालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000530018, "chapter_id": 9530, "verse_number": "६-१२३-१८", "content_sanskrit": "अपारमिव गर्जन्तं शङ्खशुक्तिसमाकुलम्।\nहिरण्यनाभं शैलेन्द्रं काञ्चनं पश्य मैथिलि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000530019, "chapter_id": 9530, "verse_number": "६-१२३-१९", "content_sanskrit": "विश्रमार्थं हनुमतो भित्त्वा सागरमुत्थितम्।\nएतत् कुक्षौ समुद्रस्य स्कन्धावारनिवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000530020, "chapter_id": 9530, "verse_number": "६-१२३-२०", "content_sanskrit": "अत्र पूर्वं महादेवः प्रसादमकरोद् विभुः।\nएतत् तु दृश्यते तीर्थं सागरस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000530021, "chapter_id": 9530, "verse_number": "६-१२३-२१", "content_sanskrit": "सेतुबन्ध इति ख्यातं त्रैलोक्येन च पूजितम्।\nएतत् पवित्रं परमं महापातकनाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000530022, "chapter_id": 9530, "verse_number": "६-१२३-२२", "content_sanskrit": "अत्र राक्षसराजोऽयमाजगाम विभीषणः।\nएषा सा दृश्यते सीते किष्किन्धा चित्रकानना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000530023, "chapter_id": 9530, "verse_number": "६-१२३-२३", "content_sanskrit": "सुग्रीवस्य पुरी रम्या यत्र वाली मया हतः।\nअथ दृष्ट्वा पुरीं सीता किष्किन्धां वालिपालिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000530024, "chapter_id": 9530, "verse_number": "६-१२३-२४", "content_sanskrit": "अब्रवीत् प्रश्रितं वाक्यं रामं प्रणयसाध्वसा।\nसुग्रीवप्रियभार्याभिस्ताराप्रमुखतो नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000530025, "chapter_id": 9530, "verse_number": "६-१२३-२५", "content_sanskrit": "अन्येषां वानरेन्द्राणां स्त्रीभिः परिवृता ह्यहम्।\nगन्तुमिच्छे सहायोध्यां राजधानीं त्वया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000530026, "chapter_id": 9530, "verse_number": "६-१२३-२६", "content_sanskrit": "एवमुक्तोऽथ वैदेह्या राघवः प्रत्युवाच ताम्।\nएवमस्त्विति किष्किन्धां प्राप्य संस्थाप्य राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000530027, "chapter_id": 9530, "verse_number": "६-१२३-२७", "content_sanskrit": "विमानं प्रेक्ष्य सुग्रीवं वाक्यमेतदुवाच ह।\nब्रूहि वानरशार्दूल सर्वान् वानरपुङ्गवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000530028, "chapter_id": 9530, "verse_number": "६-१२३-२८", "content_sanskrit": "स्त्रीभिः परिवृताः सर्वे ह्ययोध्यां यान्तु सीतया।\nतथा त्वमपि सर्वाभिः स्त्रीभिः सह महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000530029, "chapter_id": 9530, "verse_number": "६-१२३-२९", "content_sanskrit": "अभित्वरय सुग्रीव गच्छामः प्लवगाधिप।\nएवमुक्तस्तु सुग्रीवो रामेणामिततेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000530030, "chapter_id": 9530, "verse_number": "६-१२३-३०", "content_sanskrit": "वानराधिपतिः श्रीमांस्तैश्च सर्वैः समावृतः।\nप्रविश्यान्तःपुरं शीघ्रं तारामुद्वीक्ष्य सोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000530031, "chapter_id": 9530, "verse_number": "६-१२३-३१", "content_sanskrit": "प्रिये त्वं सह नारीभिर्वानराणां महात्मनाम्।\nराघवेणाभ्यनुज्ञाता मैथिलीप्रियकाम्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000530032, "chapter_id": 9530, "verse_number": "६-१२३-३२", "content_sanskrit": "त्वर त्वमभिगच्छामो गृह्य वानरयोषितः।\nअयोध्यां दर्शयिष्यामः सर्वा दशरथस्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000530033, "chapter_id": 9530, "verse_number": "६-१२३-३३", "content_sanskrit": "सुग्रीवस्य वचः श्रुत्वा तारा सर्वाङ्गशोभना।\nआहूय चाब्रवीत् सर्वा वानराणां तु योषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000530034, "chapter_id": 9530, "verse_number": "६-१२३-३४", "content_sanskrit": "सुग्रीवेणाभ्यनुज्ञाता गन्तुं सर्वैश्च वानरैः।\nमम चापि प्रियं कार्यमयोध्यादर्शनेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000530035, "chapter_id": 9530, "verse_number": "६-१२३-३५", "content_sanskrit": "प्रवेशं चैव रामस्य पौरजानपदैः सह।\nविभूतिं चैव सर्वासां स्त्रीणां दशरथस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000530036, "chapter_id": 9530, "verse_number": "६-१२३-३६", "content_sanskrit": "तारया चाभ्यनुज्ञाताः सर्वा वानरयोषितः।\nनेपथ्यविधिपूर्वं तु कृत्वा चापि प्रदक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000530037, "chapter_id": 9530, "verse_number": "६-१२३-३७", "content_sanskrit": "अध्यारोहन् विमानं तत् सीतादर्शनकाङ्क्षया।\nताभिः सहोत्थितं शीघ्रं विमानं प्रेक्ष्य राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000530038, "chapter_id": 9530, "verse_number": "६-१२३-३८", "content_sanskrit": "ऋष्यमूकसमीपे तु वैदेहीं पुनरब्रवीत्।\nदृश्यतेऽसौ महान् सीते सविद्युदिव तोयदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000530039, "chapter_id": 9530, "verse_number": "६-१२३-३९", "content_sanskrit": "ऋष्यमूको गिरिवरः काञ्चनैर्धातुभिर्वृतः।\nअत्राहं वानरेन्द्रेण सुग्रीवेण समागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000530040, "chapter_id": 9530, "verse_number": "६-१२३-४०", "content_sanskrit": "समयश्च कृतः सीते वधार्थं वालिनो मया।\nएषा सा दृश्यते पम्पा नलिनी चित्रकानना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000530041, "chapter_id": 9530, "verse_number": "६-१२३-४१", "content_sanskrit": "त्वया विहीनो यत्राहं विललाप सुदुःखितः।\nअस्यास्तीरे मया दृष्टा शबरी धर्मचारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000530042, "chapter_id": 9530, "verse_number": "६-१२३-४२", "content_sanskrit": "अत्र योजनबाहुश्च कबन्धो निहतो मया।\nदृश्यतेऽसौ जनस्थाने श्रीमान् सीते वनस्पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000530043, "chapter_id": 9530, "verse_number": "६-१२३-४३", "content_sanskrit": "जटायुश्च महातेजास्तव हेतोर्विलासिनि।\nरावणेन हतो यत्र पक्षिणां प्रवरो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000530044, "chapter_id": 9530, "verse_number": "६-१२३-४४", "content_sanskrit": "खरश्च निहतो यत्र दूषणश्च निपातितः।\nत्रिशिराश्च महावीर्यो मया बाणैरजिह्मगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000530045, "chapter_id": 9530, "verse_number": "६-१२३-४५", "content_sanskrit": "एतत् तदाश्रमपदमस्माकं वरवर्णिनि।\nपर्णशाला तथा चित्रा दृश्यते शुभदर्शने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000530046, "chapter_id": 9530, "verse_number": "६-१२३-४६", "content_sanskrit": "यत्र त्वं राक्षसेन्द्रेण रावणेन हृता बलात्।\nएषा गोदावरी रम्या प्रसन्नसलिला शुभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000530047, "chapter_id": 9530, "verse_number": "६-१२३-४७", "content_sanskrit": "अगस्त्यस्याश्रमश्चैव दृश्यते कदलीवृतः।\nदीप्तश्चैवाश्रमे ह्येष सुतीक्ष्णस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000530048, "chapter_id": 9530, "verse_number": "६-१२३-४८", "content_sanskrit": "दृश्यते चैव वैदेहि शरभङ्गाश्रमो महान्।\nउपयातः सहस्राक्षो यत्र शक्रः पुरंदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000530049, "chapter_id": 9530, "verse_number": "६-१२३-४९", "content_sanskrit": "अस्मिन् देशे महाकायो विराधो निहतो मया।\nएते ते तापसा देवि दृश्यन्ते तनुमध्यमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000530050, "chapter_id": 9530, "verse_number": "६-१२३-५०", "content_sanskrit": "अत्रिः कुलपतिर्यत्र सूर्यवैश्वानरोपमः।\nअत्र सीते त्वया दृष्टा तापसी धर्मचारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000530051, "chapter_id": 9530, "verse_number": "६-१२३-५१", "content_sanskrit": "असौ सुतनु शैलेन्द्रश्चित्रकूटः प्रकाशते।\nअत्र मां कैकयीपुत्रः प्रसादयितुमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000530052, "chapter_id": 9530, "verse_number": "६-१२३-५२", "content_sanskrit": "एषा सा यमुना रम्या दृश्यते चित्रकानना।\nभरद्वाजाश्रमः श्रीमान् दृश्यते चैष मैथिलि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000530053, "chapter_id": 9530, "verse_number": "६-१२३-५३", "content_sanskrit": "इयं च दृश्यते गङ्गा पुण्या त्रिपथगा नदी।\nनानाद्विजगणाकीर्णा सम्प्रपुष्पितकानना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000530054, "chapter_id": 9530, "verse_number": "६-१२३-५४", "content_sanskrit": "शृङ्गवेरपुरं चैतद् गुहो यत्र सखा मम।\nएषा सा दृश्यते सीते सरयूर्यूपमालिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000530055, "chapter_id": 9530, "verse_number": "६-१२३-५५", "content_sanskrit": "एषा सा दृश्यते सीते राजधानी पितुर्मम।\nअयोध्यां कुरु वैदेहि प्रणामं पुनरागता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000530056, "chapter_id": 9530, "verse_number": "६-१२३-५६", "content_sanskrit": "ततस्ते वानराः सर्वे राक्षसाः सविभीषणाः।\nउत्पत्योत्पत्य संहृष्टास्तां पुरीं ददृशुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000530057, "chapter_id": 9530, "verse_number": "६-१२३-५७", "content_sanskrit": "ततस्तु तां पाण्डुरहर्म्यमालिनीं\nविशालकक्ष्यां गजवाजिभिर्वृताम्।\nपुरीमपश्यन् प्लवगाः सराक्षसाः\nपुरीं महेन्द्रस्य यथामरावतीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000530058, "chapter_id": 9530, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे त्रयोविंशत्यधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]