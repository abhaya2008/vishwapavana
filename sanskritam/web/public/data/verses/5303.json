[{"id": 2201876, "chapter_id": 5303, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2201877, "chapter_id": 5303, "verse_number": "१", "content_sanskrit": "ब्रह्मस्वानि च ये मन्दा हरन्ति भरतर्षभ ।\nनृशंसकारिणो मूढाः क्व ते गच्छन्ति मानवाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2201878, "chapter_id": 5303, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2201879, "chapter_id": 5303, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nचण्डालस्य च संवादं क्षत्रबन्धोश्च भारत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2201880, "chapter_id": 5303, "verse_number": "", "content_sanskrit": "राजन्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2201881, "chapter_id": 5303, "verse_number": "३", "content_sanskrit": "वृद्धरूपोऽसि चण्डाल बालवच्च विचेष्टसे ।\nश्वखराणां रजःसेवी कस्मादुद्विजसे गवाम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2201882, "chapter_id": 5303, "verse_number": "४", "content_sanskrit": "साधुभिर्गर्हितं कर्म चण्डालस्य विधीयते ।\nकस्माद् गोरजसा ध्वस्तमपां कुण्डे निषिञ्चसि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2201883, "chapter_id": 5303, "verse_number": "", "content_sanskrit": "चण्डालः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2201884, "chapter_id": 5303, "verse_number": "५", "content_sanskrit": "ब्राह्मणस्य गवां राजन् ह्रियतीनां रजः पुरा ।\nसोममुद्ध्वंसयामास तं च सोमं पपुर्द्विजाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2201885, "chapter_id": 5303, "verse_number": "६", "content_sanskrit": "दीक्षितश्च स राजाऽपि क्षिप्रं नरकमाविशत् ।\nसह तैर्याजकैः सर्वैर्ब्रह्मस्वमुपजीव्य तत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2201886, "chapter_id": 5303, "verse_number": "७", "content_sanskrit": "येऽपि तत्रापिबन् क्षीरं घृतं दधि च मानवाः ।\nब्राह्मणाः सहराजन्याः सर्वे नरकमाविशन्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2201887, "chapter_id": 5303, "verse_number": "८", "content_sanskrit": "जघ्नुतुस्तपसा पुत्रांस्तथा पौत्रान् विधुन्वतीः ।\nपशूनवेक्षमाणांश्च साधुवृत्तेन दम्पती\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2201888, "chapter_id": 5303, "verse_number": "९", "content_sanskrit": "अहं तत्रावसं राजन् ब्रह्मचारी जितेन्द्रियः ।\nतासां मे रजसा ध्वस्तं भैक्षमासीन्नराधिप\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2201889, "chapter_id": 5303, "verse_number": "१०", "content_sanskrit": "चण्डालोऽहं ततो राजन् भुक्त्वा तदभवं मृतः ।\nब्रह्मस्वहारी च नृप सोऽप्रतिष्ठां गतिं ययौ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2201890, "chapter_id": 5303, "verse_number": "११", "content_sanskrit": "तस्माद् हरेन्न विप्रस्वं कदाचिदपि किञ्चन ।\nब्रह्मस्वरजसा ध्वस्तं भुक्त्वा मां पश्य यादृशम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2201891, "chapter_id": 5303, "verse_number": "१२", "content_sanskrit": "तस्मात् सोमोऽप्यविक्रेयः पुरुषेण विपश्चिता ।\nविक्रयं हीह सोमस्य गर्हयन्ति मनीषिणः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2201892, "chapter_id": 5303, "verse_number": "१३", "content_sanskrit": "ये चैनं क्रीणते राजन् ये च विक्रीणते जनाः ।\nते तु वैवस्वतं प्राप्य रौरवं यान्ति सर्वशः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2201893, "chapter_id": 5303, "verse_number": "१४", "content_sanskrit": "सोमं तु रजसा ध्वस्तं विक्रीयाविधिपूर्वकम् ।\nश्रोत्रियो वार्धुषी भूत्वा चिररात्राय नश्यति ।\nनरकं त्रिंशतं प्राप्य श्वविष्ठामुपजीवति\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2201894, "chapter_id": 5303, "verse_number": "१५", "content_sanskrit": "श्वचर्यामतिमानं च सखिदारेषु विप्लवम् ।\nतुलयाऽधारयद् धर्मो ह्यतिमानोऽतिरिच्यते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2201895, "chapter_id": 5303, "verse_number": "१६", "content_sanskrit": "श्वानं वै पापिनं पश्य विवर्णं हरिणं कृशम् ।\nअतिमानेन भूतानामिमां गतिमुपागतम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2201896, "chapter_id": 5303, "verse_number": "१७", "content_sanskrit": "अहं वै विपुले जातः कुले धनसमन्विते ।\nअन्यस्मिन् जन्मनि विभो ज्ञानविज्ञानपारगः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2201897, "chapter_id": 5303, "verse_number": "१८", "content_sanskrit": "अभवं तत्र जानानो दोषानेतानहं सदा ।\nसंरब्ध एव भूतानां पृष्ठमांसान्यभक्षयम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2201898, "chapter_id": 5303, "verse_number": "१९", "content_sanskrit": "सोऽहं तेन च वृत्तेन भोजनेन च तेन वै ।\nइमामवस्थां सम्प्राप्तः पश्य कालस्य पर्ययम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2201899, "chapter_id": 5303, "verse_number": "२०", "content_sanskrit": "आदीप्तमिव तैलान्ते भ्रमरैरिव चार्दितम् ।\nधावमानं सुसंरब्धं पश्य मां रजसाऽन्वितम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2201900, "chapter_id": 5303, "verse_number": "२१", "content_sanskrit": "स्वाध्यायैस्तु महत् पापं तरन्ति गृहमेधिनः ।\nदानैः पृथग्विधैश्चापि यथा प्राहुर्मनीषिणः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2201901, "chapter_id": 5303, "verse_number": "२२", "content_sanskrit": "तथा पापकृतं विप्रमाश्रमस्थं महीपते ।\nसर्वसङ्गविनिर्मुक्तं छन्दांस्युत्तारयन्त्युत\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2201902, "chapter_id": 5303, "verse_number": "२३", "content_sanskrit": "अहं तु पापयोन्यां वै प्रसूतः क्षत्रियर्षभ ।\nनिश्चयं नाधिगच्छामि कथं मुच्येयमित्युत\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2201903, "chapter_id": 5303, "verse_number": "२४", "content_sanskrit": "जातिस्मरत्वं तु मम केनचित् पूर्वकर्मणा ।\nशुभेन येन मोक्षं वै प्राप्तुमिच्छाम्यहं नृप\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2201904, "chapter_id": 5303, "verse_number": "२५", "content_sanskrit": "त्वमिमं मे प्रपन्नाय शरणं परिपृच्छतः ।\nचण्डालत्वात् कथमहं मुच्येयमिति सत्तम\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2201905, "chapter_id": 5303, "verse_number": "", "content_sanskrit": "राजन्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2201906, "chapter_id": 5303, "verse_number": "२६", "content_sanskrit": "चण्डाल प्रतिजानीहि येन मोक्षमवाप्स्यसि ।\nब्राह्मणार्थे त्यजन् प्राणान् गतिमिष्टामवाप्स्यसि\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2201907, "chapter_id": 5303, "verse_number": "२७", "content_sanskrit": "दत्त्वा शरीरं क्रव्याद्भ्यो रणाग्नौ द्विजहेतुकम् ।\nहुत्वा प्राणान् प्रमोक्षस्ते नान्यथा मोक्षमाप्स्यसि\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2201908, "chapter_id": 5303, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2201909, "chapter_id": 5303, "verse_number": "२८", "content_sanskrit": "इत्युक्तः स तदा राजन् ब्रह्मस्वार्थे परन्तप ।\nहुत्वा रणमुखे प्राणान् गतिमिष्टामवाप ह\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2201910, "chapter_id": 5303, "verse_number": "२९", "content_sanskrit": "तस्माद् रक्ष्यं त्वया पुत्र ब्रह्मस्वं भरतर्षभ ।\nयदीच्छसि महाबाहो शाश्वतीमुत्तमां गतिम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2201911, "chapter_id": 5303, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे ब्रह्मस्वापहारफलनिरूपणं नाम\nचतुःपञ्चाशदुत्तरशततमोऽध्यायः ॥१५४॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]