[{"id": 5000059000, "chapter_id": 9059, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे एकोनषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000059001, "chapter_id": 9059, "verse_number": "१-५९-१", "content_sanskrit": "उक्तवाक्यं तु राजानं कृपया कुशिकात्मजः।\nअब्रवीन्मधुरं वाक्यं साक्षाच्चण्डालतां गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000059002, "chapter_id": 9059, "verse_number": "१-५९-२", "content_sanskrit": "इक्ष्वाको स्वागतं वत्स जानामि त्वां सुधार्मिकम्।\nशरणं ते प्रदास्यामि मा भैषीर्नृपपुंगव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000059003, "chapter_id": 9059, "verse_number": "१-५९-३", "content_sanskrit": "अहमामन्त्रये सर्वान् महर्षीन् पुण्यकर्मणः।\nयज्ञसाह्यकरान् राजंस्ततो यक्ष्यसि निर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000059004, "chapter_id": 9059, "verse_number": "१-५९-४", "content_sanskrit": "गुरुशापकृतं रूपं यदिदं त्वयि वर्तते।\nअनेन सह रूपेण सशरीरो गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000059005, "chapter_id": 9059, "verse_number": "१-५९-५", "content_sanskrit": "हस्तप्राप्तमहं मन्ये स्वर्गं तव नराधिप।\nयस्त्वं कौशिकमागम्य शरण्यं शरणागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000059006, "chapter_id": 9059, "verse_number": "१-५९-६", "content_sanskrit": "एवमुक्त्वा महातेजाः पुत्रान् परमधार्मिकान्।\nव्यादिदेश महाप्राज्ञान् यज्ञसम्भारकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000059007, "chapter_id": 9059, "verse_number": "१-५९-७", "content_sanskrit": "सर्वान् शिष्यान् समाहूय वाक्यमेतदुवाच ह।\nसर्वानृषीन् सवासिष्ठानानयध्वं ममाज्ञया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000059008, "chapter_id": 9059, "verse_number": "१-५९-८", "content_sanskrit": "सशिष्यान् सुहृदश्चैव सर्त्विजः सुबहुश्रुतान्।\nयदन्यो वचनं ब्रूयान्मद्वाक्यबलचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000059009, "chapter_id": 9059, "verse_number": "१-५९-९", "content_sanskrit": "तत् सर्वमखिलेनोक्तं ममाख्येयमनादृतम्।\nतस्य तद् वचनं श्रुत्वा दिशो जग्मुस्तदाज्ञया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000059010, "chapter_id": 9059, "verse_number": "१-५९-१०", "content_sanskrit": "आजग्मुरथ देशेभ्यः सर्वेभ्यो ब्रह्मवादिनः।\nते च शिष्याः समागम्य मुनिं ज्वलिततेजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000059011, "chapter_id": 9059, "verse_number": "१-५९-११", "content_sanskrit": "ऊचुश्च वचनं सर्वं सर्वेषां ब्रह्मवादिनाम्।\nश्रुत्वा ते वचनं सर्वे समायान्ति द्विजातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000059012, "chapter_id": 9059, "verse_number": "१-५९-१२", "content_sanskrit": "सर्वदेशेषु चागच्छन् वर्जयित्वा महोदयम्।\nवासिष्ठं यच्छतं सर्वं क्रोधपर्याकुलाक्षरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000059013, "chapter_id": 9059, "verse_number": "१-५९-१३", "content_sanskrit": "यथाह वचनं सर्वं शृणु त्वं मुनिपुंगव।\nक्षत्रियो याजको यस्य चण्डालस्य विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000059014, "chapter_id": 9059, "verse_number": "१-५९-१४", "content_sanskrit": "कथं सदसि भोक्तारो हविस्तस्य सुरर्षयः।\nब्राह्मणा वा महात्मानो भुक्त्वा चाण्डालभोजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000059015, "chapter_id": 9059, "verse_number": "१-५९-१५", "content_sanskrit": "कथं स्वर्गं गमिष्यन्ति विश्वामित्रेण पालिताः।\nएतद् वचननैष्ठुर्यमूचुः संरक्तलोचनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000059016, "chapter_id": 9059, "verse_number": "१-५९-१६", "content_sanskrit": "वासिष्ठा मुनिशार्दूल सर्वे सहमहोदयाः।\nतेषां तद् वचनं श्रुत्वा सर्वेषां मुनिपुंगवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000059017, "chapter_id": 9059, "verse_number": "१-५९-१७", "content_sanskrit": "क्रोधसंरक्तनयनः सरोषमिदमब्रवीत्।\nयद् दूषयन्त्यदुष्टं मां तप उग्रं समास्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000059018, "chapter_id": 9059, "verse_number": "१-५९-१८", "content_sanskrit": "भस्मीभूता दुरात्मानो भविष्यन्ति न संशयः।\nअद्य ते कालपाशेन नीता वैवस्वतक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000059019, "chapter_id": 9059, "verse_number": "१-५९-१९", "content_sanskrit": "सप्तजातिशतान्येव मृतपाः सम्भवन्तु ते।\nश्वमांसनियताहारा मुष्टिका नाम निर्घृणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000059020, "chapter_id": 9059, "verse_number": "१-५९-२०", "content_sanskrit": "विकृताश्च विरूपाश्च लोकाननुचरन्त्विमान्।\nमहोदयश्च दुर्बुद्धिर्मामदूष्यं ह्यदूषयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000059021, "chapter_id": 9059, "verse_number": "१-५९-२१", "content_sanskrit": "दूषितः सर्वलोकेषु निषादत्वं गमिष्यति।\nप्राणातिपातनिरतो निरनुक्रोशतां गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000059022, "chapter_id": 9059, "verse_number": "१-५९-२२", "content_sanskrit": "दीर्घकालं मम क्रोधाद् दुर्गतिं वर्तयिष्यति।\nएतावदुक्त्वा वचनं विश्वामित्रो महातपाः।\nविरराम महातेजा ऋषिमध्ये महामुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000059023, "chapter_id": 9059, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे एकोनषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]