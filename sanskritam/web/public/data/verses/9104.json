[{"id": 5000104000, "chapter_id": 9104, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे सप्तविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000104001, "chapter_id": 9104, "verse_number": "२-२७-१", "content_sanskrit": "एवमुक्ता तु वैदेही प्रियार्हा प्रियवादिनी।\nप्रणयादेव संक्रुद्धा भर्तारमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000104002, "chapter_id": 9104, "verse_number": "२-२७-२", "content_sanskrit": "किमिदं भाषसे राम वाक्यं लघुतया ध्रुवम्।\nत्वया यदपहास्यं मे श्रुत्वा नरवरोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000104003, "chapter_id": 9104, "verse_number": "२-२७-३", "content_sanskrit": "वीराणां राजपुत्राणां शस्त्रास्त्रविदुषां नृप।\nअनर्हमयशस्यं च न श्रोतव्यं त्वयेरितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000104004, "chapter_id": 9104, "verse_number": "२-२७-४", "content_sanskrit": "आर्यपुत्र पिता माता भ्राता पुत्रस्तथा स्नुषा।\nस्वानि पुण्यानि भुञ्जानाः स्वं स्वं भाग्यमुपासते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000104005, "chapter_id": 9104, "verse_number": "२-२७-५", "content_sanskrit": "भर्तुर्भाग्यं तु नार्येका प्राप्नोति पुरुषर्षभ।\nअतश्चैवाहमादिष्टा वने वस्तव्यमित्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000104006, "chapter_id": 9104, "verse_number": "२-२७-६", "content_sanskrit": "न पिता नात्मजो वात्मा न माता न सखीजनः।\nइह प्रेत्य च नारीणां पतिरेको गतिः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000104007, "chapter_id": 9104, "verse_number": "२-२७-७", "content_sanskrit": "यदि त्वं प्रस्थितो दुर्गं वनमद्यैव राघव।\nअग्रतस्ते गमिष्यामि मृद्नन्ती कुशकण्टकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000104008, "chapter_id": 9104, "verse_number": "२-२७-८", "content_sanskrit": "ईर्ष्यां रोषं बहिष्कृत्य भुक्तशेषमिवोदकम्।\nनय मां वीर विस्रब्धः पापं मयि न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000104009, "chapter_id": 9104, "verse_number": "२-२७-९", "content_sanskrit": "प्रासादाग्रे विमानैर्वा वैहायसगतेन वा।\nसर्वावस्थागता भर्तुः पादच्छाया विशिष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000104010, "chapter_id": 9104, "verse_number": "२-२७-१०", "content_sanskrit": "अनुशिष्टास्मि मात्रा च पित्रा च विविधाश्रयम्।\nनास्मि सम्प्रति वक्तव्या वर्तितव्यं यथा मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000104011, "chapter_id": 9104, "verse_number": "२-२७-११", "content_sanskrit": "अहं दुर्गं गमिष्यामि वनं पुरुषवर्जितम्।\nनानामृगगणाकीर्णं शार्दूलगणसेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000104012, "chapter_id": 9104, "verse_number": "२-२७-१२", "content_sanskrit": "सुखं वने निवत्स्यामि यथैव भवने पितुः।\nअचिन्तयन्ती त्रीँल्लोकांश्चिन्तयन्ती पतिव्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000104013, "chapter_id": 9104, "verse_number": "२-२७-१३", "content_sanskrit": "शुश्रूषमाणा ते नित्यं नियता ब्रह्मचारिणी।\nसह रंस्ये त्वया वीर वनेषु मधुगन्धिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000104014, "chapter_id": 9104, "verse_number": "२-२७-१४", "content_sanskrit": "त्वं हि कर्तुं वने शक्तो राम सम्परिपालनम्।\nअन्यस्यापि जनस्येह किं पुनर्मम मानद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000104015, "chapter_id": 9104, "verse_number": "२-२७-१५", "content_sanskrit": "साहं त्वया गमिष्यामि वनमद्य न संशयः।\nनाहं शक्या महाभाग निवर्तयितुमुद्यता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000104016, "chapter_id": 9104, "verse_number": "२-२७-१६", "content_sanskrit": "फलमूलाशना नित्यं भविष्यामि न संशयः।\nन ते दुःखं करिष्यामि निवसन्ती त्वया सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000104017, "chapter_id": 9104, "verse_number": "२-२७-१७", "content_sanskrit": "अग्रतस्ते गमिष्यामि भोक्ष्ये भुक्तवति त्वयि।\nइच्छामि परतः शैलान् पल्वलानि सरांसि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000104018, "chapter_id": 9104, "verse_number": "२-२७-१८", "content_sanskrit": "द्रष्टुं सर्वत्र निर्भीता त्वया नाथेन धीमता।\nहंसकारण्डवाकीर्णाः पद्मिनीः साधुपुष्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000104019, "chapter_id": 9104, "verse_number": "२-२७-१९", "content_sanskrit": "इच्छेयं सुखिनी द्रष्टुं त्वया वीरेण संगता।\nअभिषेकं करिष्यामि तासु नित्यमनुव्रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000104020, "chapter_id": 9104, "verse_number": "२-२७-२०", "content_sanskrit": "सह त्वया विशालाक्ष रंस्ये परमनन्दिनी।\nएवं वर्षसहस्राणि शतं वापि त्वया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000104021, "chapter_id": 9104, "verse_number": "२-२७-२१", "content_sanskrit": "व्यतिक्रमं न वेत्स्यामि स्वर्गोऽपि हि न मे मतः।\nस्वर्गेऽपि च विना वासो भविता यदि राघव।\nत्वया विना नरव्याघ्र नाहं तदपि रोचये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000104022, "chapter_id": 9104, "verse_number": "२-२७-२२", "content_sanskrit": "अहं गमिष्यामि वनं सुदुर्गमं\nमृगायुतं वानरवारणैश्च।\nवने निवत्स्यामि यथा पितुर्गृहे\nतवैव पादावुपगृह्य सम्मता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000104023, "chapter_id": 9104, "verse_number": "२-२७-२३", "content_sanskrit": "अनन्यभावामनुरक्तचेतसं\nत्वया वियुक्तां मरणाय निश्चिताम्।\nनयस्व मां साधु कुरुष्व याचनां\nनातो मया ते गुरुता भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000104024, "chapter_id": 9104, "verse_number": "२-२७-२४", "content_sanskrit": "तथा ब्रुवाणामपि धर्मवत्सलां\nन च स्म सीतां नृवरो निनीषति।\nउवाच चैनां बहु संनिवर्तने\nवने निवासस्य च दुःखितां प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000104025, "chapter_id": 9104, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे सप्तविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]