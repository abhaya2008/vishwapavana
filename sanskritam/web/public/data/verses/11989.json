[{"id": 50025176, "chapter_id": 11989, "verse_number": "1", "content_sanskrit": "॥ सुखदुःखव्यवस्थानुपपत्तिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50025177, "chapter_id": 11989, "verse_number": "2", "content_sanskrit": "उपाधिभेदाङ्गीकारे हस्तपादाद्युपाधिभेदेऽपि तद्गतसुखदुःखादिभोक्तुर्यथा भेदो न प्रतीयते, एवमेव शरीरादिभेदे 【पाठभेदः: BG—शरीरादिभेदेऽपि】 भोक्तुर्भेदो न दृश्येत। सर्वदेहगतसुखदुःखादिकमेकेनैव भुज्येत।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50025178, "chapter_id": 11989, "verse_number": "3", "content_sanskrit": "॥ उपाधिनिवृत्त्यभावः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50025179, "chapter_id": 11989, "verse_number": "4", "content_sanskrit": "यथाचैकाङ्गुल्याद्यपगमेऽपि न मुक्तिः, एवमेकोपाध्यपगमेऽपि तस्यैवानन्तोपाधिसम्बद्धत्वान्न मुक्तिः स्यात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50025180, "chapter_id": 11989, "verse_number": "5", "content_sanskrit": "॥ उभयत्रापि संश्लेषविश्लेषाभ्यामविशेषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50025181, "chapter_id": 11989, "verse_number": "6", "content_sanskrit": "“उद्यतायुधदोर्दण्डाः पतितस्वशिरोक्षिभिः। पश्यन्तः पातयन्ति स्म कबन्धा अप्यरीन्युधि॥” इति भारतवचनान्न विश्लेषाद् विशेषः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50025182, "chapter_id": 11989, "verse_number": "7", "content_sanskrit": "॥ उपाधेर्भेदकत्वनिरासः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50025183, "chapter_id": 11989, "verse_number": "8", "content_sanskrit": "किञ्चोपाधिरात्मन एकदेशं ग्रसति, उत सर्वमात्मानम्? एकदेशाङ्गीकारे सावयवत्वम्। सावयवस्य चानित्यत्वं तैरङ्गीकृतम्। सर्वग्रासे च नोपाधिर्भेदकः स्यात्। उपाधिकृतांशकल्पने तदुपाधिकृतत्वे, आत्माश्रयत्वम्। उपाध्यन्तरकल्पने, अनवस्था।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50025184, "chapter_id": 11989, "verse_number": "9", "content_sanskrit": "॥ त्रिस्कन्धचैतन्यव्यवस्थानुपपत्तिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50025185, "chapter_id": 11989, "verse_number": "10", "content_sanskrit": "॥ ब्रह्मेश्वरव्यवस्थानुपपत्तिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50025186, "chapter_id": 11989, "verse_number": "11", "content_sanskrit": "नचेश्वरस्य सर्वगतत्वादौपाधिकभेदो ब्रह्मणा भवति। नहि देशतः कालतश्चापरिच्छिन्नयोरौपाधिकभेदो दृष्टः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50025187, "chapter_id": 11989, "verse_number": "12", "content_sanskrit": "॥ जीवेश्वरव्यवस्थानुपपत्तिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50025188, "chapter_id": 11989, "verse_number": "13", "content_sanskrit": "सर्वोपाधिगतत्वाच्चैकस्यैवेश्वरस्य, भेदस्य मिथ्यात्वात्, हस्तपादादिभेदेऽपि भोक्तुरेकत्ववत् सर्वसुखदुःखादिभोक्तृत्वमीश्वरस्यैव स्यात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50025189, "chapter_id": 11989, "verse_number": "14", "content_sanskrit": "॥ जीवब्रह्मव्यवस्थानुपपत्तिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50025190, "chapter_id": 11989, "verse_number": "15", "content_sanskrit": "देशतः कालतश्चापरिच्छिन्नयोरौपचारिकभेदाभावादेव दुःखिनोऽन्यच्छुद्धं ब्रह्म न सिद्ध्यति। अतः स्वाभाविकः संसार इत्यनिवृत्तिरेव स्यात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50025191, "chapter_id": 11989, "verse_number": "16", "content_sanskrit": "॥ प्रकारान्तरेण बहुव्यवस्थानुपपत्तिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50025192, "chapter_id": 11989, "verse_number": "17", "content_sanskrit": "किञ्च। विशिष्टस्य शुद्धस्य वा संसारः? शुद्धस्य संसार इत्युक्ते स्वव्याहतिः। विशिष्टस्येत्युक्ते विशिष्टोऽन्यः, स एव वा? स एव चेत्, उक्तो दोषः। अन्यश्चेत्, नित्योऽनित्यो वा? अनित्यश्चेत्, नाश एव तस्य न मोक्षः। नित्यत्वे च, भेदस्य सत्यत्वम्, मोक्षेऽपि तस्य भावात्। स्वरूपमात्रस्याभेद उपाधिभिन्न एवेत्यङ्गीकारे स्वरूपमेवोपाधिसम्बद्धमिति न तस्य शुद्धत्वम्। अशुद्धस्वभावस्य न कदाचिच्छुद्धत्वमिति च तत्पक्षः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]