[{"id": 7003343000, "chapter_id": 23343, "verse_number": "२-३८-१", "content_sanskrit": "सनत्कुमार उवाच  ।\nगोसहस्रप्रदानं च वदामि श्रृणु सुव्रत ।\nगवां सहस्रमादाय सवत्सं सगुणं शुभम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003343001, "chapter_id": 23343, "verse_number": "२-३८-२", "content_sanskrit": "तास्त्वभ्यर्च्य यथाशास्त्रमष्टौ सम्यक्प्रत्नतः ।\nतासां श्रृंगाणि हेम्नाथ प्रतिनिष्केण बंधयेत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003343002, "chapter_id": 23343, "verse_number": "२-३८-३", "content_sanskrit": "खुरांश्च रजतेनैव बंदयेत्कंठदेसतः ।\nप्रतिनिष्केण कर्तव्यं कर्णे वज्रं च शोभनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003343003, "chapter_id": 23343, "verse_number": "२-३८-४", "content_sanskrit": "शिवाय दद्याद्विप्रेभ्यो दक्षिणां च पृथक्पृथक् ।\nदशनिष्कं तदर्धं वा तस्यार्धार्धमथापि वा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003343004, "chapter_id": 23343, "verse_number": "२-३८-५", "content_sanskrit": "यथाविभवविस्तारं निष्कमात्रमथापि वा ।\nवस्त्रयुग्मं च दातव्यं पृथग्विप्रेषु शोभनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003343005, "chapter_id": 23343, "verse_number": "२-३८-६", "content_sanskrit": "गावश्चाराध्य यत्नेन दातव्याः सुमनोरमाः ।\nएवं दत्त्वा विधानेन शिवमभ्यर्च्य संकरम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003343006, "chapter_id": 23343, "verse_number": "२-३८-७", "content_sanskrit": "जपेदग्रे यथान्यायं गवां स्तवमनुत्तमम् ।\nगावो ममाग्रतो नित्यं गावो नः पृष्ठतस्तथा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003343007, "chapter_id": 23343, "verse_number": "२-३८-८", "content_sanskrit": "हृदये मे सदा गावं मध्ये वसाम्यहम् ।\nइति कृत्वा द्विजाग्र्येभ्योदत्त्वा गत्वा प्रदक्षिणम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003343008, "chapter_id": 23343, "verse_number": "२-३८-९", "content_sanskrit": "तद्रोमवर्षसंख्यानि स्वर्गलोके महीयते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]