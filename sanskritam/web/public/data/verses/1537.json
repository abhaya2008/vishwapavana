[{"id": 2025011, "chapter_id": 1537, "verse_number": "३-१७५-०x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2025012, "chapter_id": 1537, "verse_number": "३-१७५-१", "content_sanskrit": "निवर्तमानेन मया महद्दृष्टं ततोऽपरम्।\nपुरं कामगमं दिव्यं पावकार्कसमप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2025013, "chapter_id": 1537, "verse_number": "३-१७५-२", "content_sanskrit": "रत्नद्रुममयैश्चित्रैर्भास्वरैश्च पतत्रिभिः।\nपौलोमैः कालकेयैश्च रनित्यहृष्टैरधिष्ठिरतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2025014, "chapter_id": 1537, "verse_number": "३-१७५-३", "content_sanskrit": "गोपुराट्टालकोपेतं चतुर्द्वारं दुरासदम्।\nसर्वरत्नमयं दिव्यमद्भुतोपमदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2025015, "chapter_id": 1537, "verse_number": "३-१७५-४", "content_sanskrit": "द्रुमैः पुष्पलोपेतैः सर्वरत्नमयैर्वृतम्।\nतथा पतत्रिभिर्दिव्यैरुपेतं सुमनोहरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2025016, "chapter_id": 1537, "verse_number": "३-१७५-५", "content_sanskrit": "असुरैर्नित्यमुदितैः शूलर्ष्टिमुसलायुधैः।\nचापमुद्गरहस्तैश्च स्रग्विभिः सर्वतो वृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2025017, "chapter_id": 1537, "verse_number": "३-१७५-६", "content_sanskrit": "तदहं प्रेक्ष्यदैत्यानां पुरमद्भुतदर्शनम्।\nअपृच्छं मातलिं राजन्किमिदं दृश्यतेति वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2025018, "chapter_id": 1537, "verse_number": "३-१७५-७x", "content_sanskrit": "मातलिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2025019, "chapter_id": 1537, "verse_number": "३-१७५-७", "content_sanskrit": "पुलोमा नाम दैतेयी कालका च महासुरी।\nदिव्यंवर्षसहस्रं ते चेरतुः परमं तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2025020, "chapter_id": 1537, "verse_number": "३-१७५-८", "content_sanskrit": "तपसोन्ते ततस्ताभ्यां स्वयंभूरददाद्वरम्।\nअगृह्णीतां वरं ते तु सुतानामल्पदुःखताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2025021, "chapter_id": 1537, "verse_number": "३-१७५-९", "content_sanskrit": "अवध्यतां च राजेन्द्र सुरराक्षसपन्नगैः।\nपुरं सुरमणीयं च स्वचरं सुकृतप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2025022, "chapter_id": 1537, "verse_number": "३-१७५-१०", "content_sanskrit": "सर्वरत्नैः समुदितं दुर्धर्षममरैरपि।\nमहर्षियक्षगन्धर्वपन्नगासुरराक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2025023, "chapter_id": 1537, "verse_number": "३-१७५-११", "content_sanskrit": "सर्वकामगुणोपेतं वीतशोकमनामयम्।\nब्र्हमणो भवनाच्छ्रेष्ठं कालकेयकृतं विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2025024, "chapter_id": 1537, "verse_number": "३-१७५-१२", "content_sanskrit": "तदेतत्खपुरं दिव्यं चरत्यमरवर्जितम्।\nपौलोमाध्युषितं वीर कालकेयैश्च दानवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2025025, "chapter_id": 1537, "verse_number": "३-१७५-१३", "content_sanskrit": "हिरण्यपुरमित्येवं ख्यायते नगरं महत्।\nरक्षितंकालकेयैश्च पौलोमैश्च महासुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2025026, "chapter_id": 1537, "verse_number": "३-१७५-१४", "content_sanskrit": "त एतेमुदिता राजन्नवध्याः सर्वदैवतैः।\nनिवसन्त्यत्रराजेन्द्र गतोद्वेगा निरुत्सुकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2025027, "chapter_id": 1537, "verse_number": "३-१७५-१५", "content_sanskrit": "`सुरासुरैरवध्यानां दानवानां धनञ्जय।\nमानुषान्मृत्युरेतेषां निर्दिष्टो ब्रह्मणा पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2025028, "chapter_id": 1537, "verse_number": "३-१७५-१६", "content_sanskrit": "[एतानपि रणे पार्त कालकेयान्दुरासदान्।\nवज्रास्त्रेण नयस्वाशु विनाशं सुमहाबलान्] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2025029, "chapter_id": 1537, "verse_number": "३-१७५-१७x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2025030, "chapter_id": 1537, "verse_number": "३-१७५-१७", "content_sanskrit": "सुरासुरैरवध्यं तदहं ज्ञात्वा विशांपते।\nअब्रुवं मातलिं हृष्टो याह्येतत्पुरमञ्जसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2025031, "chapter_id": 1537, "verse_number": "३-१७५-१८", "content_sanskrit": "त्रिदशेशद्विषो यावत्क्षयमस्त्रैर्नयाम्यहम्।\nन कथंचिद्धि मे पापा न वध्या ये सुरद्विषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2025032, "chapter_id": 1537, "verse_number": "३-१७५-१९", "content_sanskrit": "उवाह मां ततः शीघ्रं हिरण्यपुरमन्तिकात्।\nरथेन तेन दिव्येन हरियुक्तेन मातलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2025033, "chapter_id": 1537, "verse_number": "३-१७५-२०", "content_sanskrit": "ते मामालक्ष्य दैतेया विचित्राभरणाम्बराः।\nसमुत्पेतुर्महावेगा रथानास्थाय दंशिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2025034, "chapter_id": 1537, "verse_number": "३-१७५-२१", "content_sanskrit": "ततो नालीकनाराचैर्भल्लैः शक्त्यृष्टितोमरैः।\nप्रत्यघ्नन्दानवेन्द्रा मां क्रुद्धास्तीव्रपराक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2025035, "chapter_id": 1537, "verse_number": "३-१७५-२२", "content_sanskrit": "तदहं शस्त्रवर्षेण महता प्रत्यवारयम्।\nशस्त्रवर्षं महद्राजन्विद्याबलमुपाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2025036, "chapter_id": 1537, "verse_number": "३-१७५-२३", "content_sanskrit": "व्यामोहयं च तान्सर्वान्रथमार्गैश्चरन्रणे।\nतेऽन्योन्यमभिसंमूढाः पातयन्ति स्म दानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2025037, "chapter_id": 1537, "verse_number": "३-१७५-२४", "content_sanskrit": "तेषामेवं विमूढानामन्योन्यमभिधावताम्।\nशिरांसि विशिखैर्दीप्तैरच्छिन्दं शतसङ्घशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2025038, "chapter_id": 1537, "verse_number": "३-१७५-२५", "content_sanskrit": "ते वध्यमाना दैतेयाः पुरमास्थाय तत्पुनः।\nखमुत्पेतुः सनगरा मायामास्थाय दानवीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2025039, "chapter_id": 1537, "verse_number": "३-१७५-२६", "content_sanskrit": "ततोऽहं शरवर्षेण महता कुरुनन्दन।\nमार्गमावृत्य दैत्यानां गतिं चैषामवारयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2025040, "chapter_id": 1537, "verse_number": "३-१७५-२७", "content_sanskrit": "तत्पुरं खचरं दिव्यं कामगं दिव्यवर्चसम्।\nदैतेयैर्वरदानेन धार्यते स्म यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2025041, "chapter_id": 1537, "verse_number": "३-१७५-२८", "content_sanskrit": "अन्तर्भूमौ निपतति पुनरूर्ध्वं प्रतिष्ठते।\nपुनस्तिर्यक् प्रयात्याशु पुनरप्सु निमज्जति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2025042, "chapter_id": 1537, "verse_number": "३-१७५-२९", "content_sanskrit": "अमरावतिसंकाशं तत्पुरं कामगं महत्।\nअहमस्त्रैर्बहुविधैः प्रत्यगृह्णां परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2025043, "chapter_id": 1537, "verse_number": "३-१७५-३०", "content_sanskrit": "ततोऽहं शरजालेन दिव्यास्त्रनुदितेन च।\nव्यगृह्णां सह दैतेयैस्तत्पुरं पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2025044, "chapter_id": 1537, "verse_number": "३-१७५-३१", "content_sanskrit": "विक्षत चायसैर्बाणैर्मत्प्रयुक्तैरजिह्मगैः।\nमहीमभ्यपतद्राजन्प्रभग्नं पुरमासुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2025045, "chapter_id": 1537, "verse_number": "३-१७५-३२", "content_sanskrit": "ते वध्यमाना मद्बाणैर्वज्रवेगैरयस्मयैः।\nपर्यभ्रमन्त वै राजन्नसुराः कालचोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2025046, "chapter_id": 1537, "verse_number": "३-१७५-३३", "content_sanskrit": "ततो मातलिरारुह्यपुरस्तान्निपतन्निव।\nमहीमवातरत्क्षिप्रं रथेनादित्यवर्चसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2025047, "chapter_id": 1537, "verse_number": "३-१७५-३४", "content_sanskrit": "ततो रथसहस्राणि षष्टिस्तेषाममर्षिणाम्।\nयुयुत्सूनां मया सार्धं पर्यवर्तन्त भारत।\nतान्यहं निशितैर्बाणैर्व्यधमं गार्ध्रराजितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2025048, "chapter_id": 1537, "verse_number": "३-१७५-३५", "content_sanskrit": "ते युद्धे संन्यवर्तन्त समुद्रस्य यथोर्मयः।\nनेमे शक्या मानुषेण युद्धेनेति प्रचिन्त्य तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2025049, "chapter_id": 1537, "verse_number": "३-१७५-३६", "content_sanskrit": "ततोऽहमानुपूर्व्येण दिव्यान्यस्त्राण्ययोजयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2025050, "chapter_id": 1537, "verse_number": "३-१७५-३७", "content_sanskrit": "ततस्तानि सहस्राणइ रथिनां चित्रयोधिनाम्।\nअस्त्राणि मम दिव्यानि प्रत्यघ्नञ्छनकैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2025051, "chapter_id": 1537, "verse_number": "३-१७५-३८", "content_sanskrit": "रथमार्गान्विचित्रांस्ते विचरन्तो महाबलाः।\nप्रत्यदृश्यन्त संग्रामे शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2025052, "chapter_id": 1537, "verse_number": "३-१७५-३९", "content_sanskrit": "विचित्रमुकुटापीडा विचित्रकवचध्वजाः।\nविचित्राभरणाश्चैव मम प्रीतिकराऽभवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2025053, "chapter_id": 1537, "verse_number": "३-१७५-४०", "content_sanskrit": "अहं तुशरवर्षैस्तानस्त्रप्रचुदितै रणे।\nनाशक्रुवं पीडयितुं ते तु मां प्रत्यपीडयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2025054, "chapter_id": 1537, "verse_number": "३-१७५-४१", "content_sanskrit": "तैः पीड्यमानो बहुभिः कृतास्त्रैः कुशलैर्युधि।\nव्यथितोस्मि महायुद्धे भयं चागान्महन्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2025055, "chapter_id": 1537, "verse_number": "३-१७५-४२", "content_sanskrit": "`ततोहं परमायत्तो मातलिं परिपृष्टवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2025056, "chapter_id": 1537, "verse_number": "३-१७५-४३", "content_sanskrit": "किमेते मम बाणौघैर्दिव्यास्त्रप्रतिमन्त्रितैः।\nन वध्यन्ते महाघोरैस्तत्त्वमाख्याहि पृच्छतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2025057, "chapter_id": 1537, "verse_number": "३-१७५-४४", "content_sanskrit": "स मामुवाच पर्याप्तस्त्वमेषां भरतर्षभ।\nतानुद्दिश्याथ मर्माणि प्रतिघातं तदाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2025058, "chapter_id": 1537, "verse_number": "३-१७५-४५", "content_sanskrit": "एतच्छ्रुत्वा तु राजेनद्रसंप्रहृष्टस्तमूचिवान्।\nनिवर्तय रथं शीघ्रं पश्य चैतान्निपातितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2025059, "chapter_id": 1537, "verse_number": "३-१७५-४६", "content_sanskrit": "एवमुक्तो रथं तत्र मातलिः पर्यवर्तयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2025060, "chapter_id": 1537, "verse_number": "३-१७५-४७", "content_sanskrit": "ततो मत्वा रणे भग्नं दानवाः प्रतिहर्षिताः।\nविचुक्रुशुर्महाराज स्वरेण महता मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2025061, "chapter_id": 1537, "verse_number": "३-१७५-४८", "content_sanskrit": "अभग्नः कैश्चिदप्येष पाण्डवो रणमूर्धनि।\nअस्माभिः समरे भग्न इत्येवं संघशस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2025062, "chapter_id": 1537, "verse_number": "३-१७५-४९", "content_sanskrit": "ततोहं देवदेवाय रुद्रायाव्यक्तमूर्तये।\nप्रयतः प्रणतो भूत्वा नमस्कृत्य महात्मने।\nयत्तद्रौद्रमिति ख्यातं सर्वामित्रविनाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2025063, "chapter_id": 1537, "verse_number": "३-१७५-५०", "content_sanskrit": "यत्तद्रौद्रमिति ख्यातं सर्वामित्रविनाशनम्।\n`महत्पाशुपतं दिव्यं सर्वलोकनमस्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2025064, "chapter_id": 1537, "verse_number": "३-१७५-५१", "content_sanskrit": "`ततोऽपश्यं त्रिशिरसं पुरुषं नवलोचनम्।\nत्रिमुखं षङ्भुजं दीप्तमर्कज्वलनमूर्धजम्।\nलेलिहानैर्महानागैः कृतचिह्नममित्रहन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2025065, "chapter_id": 1537, "verse_number": "३-१७५-५२", "content_sanskrit": "विभीस्ततस्तदस्त्रं तु घोरं रौद्रं सनातनम्।\nदृष्ट्वा गाण्डीवसंयोगमानीय भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2025066, "chapter_id": 1537, "verse_number": "३-१७५-५३", "content_sanskrit": "नमस्कृत्वा त्रिनेत्राय शर्वायामिततेजसे।\nमुक्तवान्दानवेन्द्राणां पराभावाय भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2025067, "chapter_id": 1537, "verse_number": "३-१७५-५४", "content_sanskrit": "मुक्तमात्रे ततस्तस्मिन्रूपाण्यासन्सहस्रशः।\nमृगाणामथ सिंहानां व्याग्राणां च विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2025068, "chapter_id": 1537, "verse_number": "३-१७५-५५", "content_sanskrit": "ऋक्षाणां महिषाणां च पन्नगानां तथा गवाम्।\nशरभाणां गजानां च वानराणां च सङ्घशः।\nऋषभाणां वराहाणां मार्जाराणां तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2025069, "chapter_id": 1537, "verse_number": "३-१७५-५६", "content_sanskrit": "सालावृकाणां प्रेतानां भुरुण्डानां च सर्वशः।\nगृध्राणां गरुडानां च चमराणां तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2025070, "chapter_id": 1537, "verse_number": "३-१७५-५७", "content_sanskrit": "देवानां च ऋषीणां रच गन्धर्वाणां च सर्वशः।\nपिशाचानां सयक्षाणां तथैव च सुरद्विषाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2025071, "chapter_id": 1537, "verse_number": "३-१७५-५८", "content_sanskrit": "गुह्यकानां च संग्रामे नैर्ऋतानां तथैव च।\nझषाणां गजवक्राणामुलूकानां तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2025072, "chapter_id": 1537, "verse_number": "३-१७५-५९", "content_sanskrit": "मीनवाजिसरूपाणां नानाशस्त्रासिपाणिनाम्।\nतथैव यातुधानानां गदामुद्गरधारिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2025073, "chapter_id": 1537, "verse_number": "३-१७५-६०", "content_sanskrit": "एतैस्चान्यैश्च बहुभिर्नानारूपधरैस्तदा।\nसर्वमासीज्जगद्व्याप्तं तस्मिन्नस्त्रे विसर्जिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2025074, "chapter_id": 1537, "verse_number": "३-१७५-६१", "content_sanskrit": "त्रिशिरोभिश्चतुर्दंष्ट्रैश्चतुरास्यैश्चतुर्भुजैः।\nअनेकरूपसंयुक्तैर्मांसमेदोवसास्तिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2025075, "chapter_id": 1537, "verse_number": "३-१७५-६२", "content_sanskrit": "अभीक्ष्णं वध्यमानास्ते दानवा ये समागताः।\nअर्कज्वलनतेजोभिर्वज्राशनिसमप्रभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2025076, "chapter_id": 1537, "verse_number": "३-१७५-६३", "content_sanskrit": "अद्रिसारमयैश्चान्यैर्बाणैरपि निबर्हणैः।\nन्यहनं दानवान्सर्वान्मुहूर्तेनैव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2025077, "chapter_id": 1537, "verse_number": "३-१७५-६४", "content_sanskrit": "गाण्डीवास्त्रप्रणुन्नांस्तान्गतासून्नभसश्च्युतान्।\nदृष्ट्वाऽहं प्राणमं भूयस्त्रिपुरघ्नाय वेधसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2025078, "chapter_id": 1537, "verse_number": "३-१७५-६५", "content_sanskrit": "तथा रौद्रास्त्रनिष्पिष्टान्दिव्याभरणभूषितान्।\nनिशाम्य परमं हर्षमगमद्देवसारथिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2025079, "chapter_id": 1537, "verse_number": "३-१७५-६६", "content_sanskrit": "तदसह्यं कृतं कर्म देवैरपि दुरासदम्।\nदृष्ट्वा मां पूजयामास मातलिः शक्रसारथिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2025080, "chapter_id": 1537, "verse_number": "३-१७५-६७", "content_sanskrit": "उचाच वचनं चेदंप्रीयमाणः कृताञ्जलिः।\n`हतांस्तान्दानवान्दृष्ट्वा मया सङ्ख्ये सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2025081, "chapter_id": 1537, "verse_number": "३-१७५-६८", "content_sanskrit": "सुरासुरैरसह्यं हि कर्म यत्साधितं त्वया।\nन ह्येतत्संयुगे कर्तुमपि शक्तः सुरेश्वरः।\n`ध्रुवं धनञ्जय प्रीतस्त्वयि शक्रः पुरार्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2025082, "chapter_id": 1537, "verse_number": "३-१७५-६९", "content_sanskrit": "सुरासुरैरवध्यं हि पुरमेतत्खगं महत्।\nत्वया विमथितं वीर स्ववीर्यतपसो बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2025083, "chapter_id": 1537, "verse_number": "३-१७५-६९x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2025084, "chapter_id": 1537, "verse_number": "३-१७५-७०", "content_sanskrit": "विद्वस्ते खपुरे तस्मिन्दानवेषु हतेषु च।\nविनदन्त्यः स्त्रियः सर्वा निष्पेतुर्नगराद्बहिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2025085, "chapter_id": 1537, "verse_number": "३-१७५-७१", "content_sanskrit": "प्रकीर्णकेश्यो व्यथिताः कुरर्य इव दुःखिताः।\nपेतुः पुत्रान्पितृन्भ्रातॄञ्शोचमाना महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2025086, "chapter_id": 1537, "verse_number": "३-१७५-७२", "content_sanskrit": "रुदत्यो दीनकण्ठ्यस्तु निनदन्त्यो हतेश्वराः।\nउरांसि पाणिभिर्घ्नन्त्यो विस्रस्तस्रग्विभूषणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2025087, "chapter_id": 1537, "verse_number": "३-१७५-७३", "content_sanskrit": "तच्छोकयुक्तमश्रीकं दुःखदैन्यसमाहतम्।\nन बभौ दानवपुरं हतत्विट्कं हतेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2025088, "chapter_id": 1537, "verse_number": "३-१७५-७४", "content_sanskrit": "गन्धर्वनगराकारं हृतनागमिव ह्रदम्।\nशुष्कवृक्षमिवारण्यमदृश्यमभवत्पुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2025089, "chapter_id": 1537, "verse_number": "३-१७५-७५", "content_sanskrit": "मां तु संहृष्टमनसं क्षिप्रं मातलिरानयत्।\nदेवराजस्य भवनं कृतकर्माणमाहवात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2025090, "chapter_id": 1537, "verse_number": "३-१७५-७६", "content_sanskrit": "हिरण्यपुरमुत्सृज्य निहत्य च महासुरान्।\nनिवातकवचांश्चैव ततोऽहंशक्रमागमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2025091, "chapter_id": 1537, "verse_number": "३-१७५-७७", "content_sanskrit": "मम कर्म च देवेन्द्रं मातलिर्विस्तरेण तत्।\nसर्वं विश्रावयामास यथाभूतं महाद्युते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2025092, "chapter_id": 1537, "verse_number": "३-१७५-७८", "content_sanskrit": "हिरण्यपुरघातं च मायानां च निवारणम्।\nनिवातकवचानां च वधं सङ्ख्ये महौजसाम्।\n`कालकेयवधं चैव अद्भुतं रोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2025093, "chapter_id": 1537, "verse_number": "३-१७५-७९", "content_sanskrit": "तच्छ्रुत्वा भगवान्प्रीतः सहस्राक्षः पुरंदरः।\nमरुद्भिः सहितः श्रीमान्साधुसाध्वित्यथाब्रवीत्।\n`परिष्वज्य च मां प्रेम्णा मूर्ध्नि चाघ्राय सस्मितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2025094, "chapter_id": 1537, "verse_number": "३-१७५-८०", "content_sanskrit": "ततो मां देवराजो वै समाश्वास्य पुनः पुनः।\nअब्रवीद्विबुधैः सार्धमिदं समधुरं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2025095, "chapter_id": 1537, "verse_number": "३-१७५-८१", "content_sanskrit": "अतिदेवासुरं कर्म कृतमेव त्वया रणे।\nगुर्वर्थश्च कृतः पार्थ महाशत्रून्घ्नता मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2025096, "chapter_id": 1537, "verse_number": "३-१७५-८२", "content_sanskrit": "एवमेव सदा भाव्यं स्थिरेणाजौ धनंजय।\nअसंमूढेन चास्त्राणां कर्तव्यं प्रतिपादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2025097, "chapter_id": 1537, "verse_number": "३-१७५-८३", "content_sanskrit": "अविषह्यो रणे हि त्वं देवदानवराक्षसैः।\nसयक्षासुरगन्धर्वैः सपक्षिगणपन्नगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2025098, "chapter_id": 1537, "verse_number": "३-१७५-८४", "content_sanskrit": "वसुधां चापि कौन्तेय त्वद्बाहुबलनिर्जिताम्।\nपालयिष्यति धर्मात्मा कुन्तीपुत्रो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2025099, "chapter_id": 1537, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि निवातकवचयुद्धपर्वणि पञ्चसप्तत्यधिकशततमोऽध्यायः ॥ १७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}]