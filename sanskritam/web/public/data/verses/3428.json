[{"id": 2112633, "chapter_id": 3428, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2112634, "chapter_id": 3428, "verse_number": "१", "content_sanskrit": "ततः सत्यवती हृष्टा स्नुषां स्नातामृतौ तदा ।\nसंवेशयन्ती शयने शनैर्वचनमब्रवीत् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2112635, "chapter_id": 3428, "verse_number": "२", "content_sanskrit": "कौसल्ये देवरो देवि समेत्यानुप्रवेक्ष्यति ।\nअप्रमत्ताऽभिवीक्षेथा निशायामागमिष्यति \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2112636, "chapter_id": 3428, "verse_number": "३", "content_sanskrit": "श्वश्र्वास्तु वचनं श्रुत्वा शयाना शयने शुभे ।\nसाऽचिन्तयत् तदा भीष्ममन्यांश्च कुरुसत्तमान् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2112637, "chapter_id": 3428, "verse_number": "४", "content_sanskrit": "ततः सुप्तजनप्राये व्यासः स भगवानृषिः ।\nदीप्यमानेषु दीपेषु शरणं प्रविवेश तत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2112638, "chapter_id": 3428, "verse_number": "५", "content_sanskrit": "ततोऽम्बिकायां प्रथमं नियुक्तः सत्यवान् ऋषिः ।\nजगाम तस्याः शयनं विपुले तपसि स्थितः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2112639, "chapter_id": 3428, "verse_number": "६", "content_sanskrit": "तं समीक्ष्य तु कौसल्या दुष्प्रेक्षमतथोचितम् ।\nविरूपमिति वित्रस्ता सङ्कुच्यासीन्निमीलिता \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2112640, "chapter_id": 3428, "verse_number": "७", "content_sanskrit": "विरूपो हि जटी चापि दुर्वर्णः परुषः कृशः ।\nसुगन्धेतरगन्धश्च सर्वथा दुष्प्रधर्षणः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2112641, "chapter_id": 3428, "verse_number": "८", "content_sanskrit": "तस्य कृष्णस्य कपिलां जटां दीप्ते च लोचने ।\nकद्रूणि चैव श्मश्रूणि दृष्ट्वा देवी न्यमीलयत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2112642, "chapter_id": 3428, "verse_number": "९", "content_sanskrit": "सम्बभूव तया रात्रौ मातुः प्रियचिकीर्षया ।\nभयात् काशीसुता तं तु नाशक्नोदभिवीक्षितुम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2112643, "chapter_id": 3428, "verse_number": "१०", "content_sanskrit": "ततो निष्क्रान्तमासाद्य तन्माता प्रत्यभाषत ।\nअप्यत्र गुणवांस्तात राजपुत्रो भविष्यति \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2112644, "chapter_id": 3428, "verse_number": "११", "content_sanskrit": "निशम्य वचनं मातुर्व्यासः परमधर्मवित् ।\nप्रोवाचातीन्द्रियज्ञानो विधिना सम्प्रचोदितः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2112645, "chapter_id": 3428, "verse_number": "१२", "content_sanskrit": "नागायुतसमप्राणो विद्वान् राजर्षिसत्तमः ।\nमहाभागो महावीर्यो महाबुद्धिर्भविष्यति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2112646, "chapter_id": 3428, "verse_number": "१३", "content_sanskrit": "तस्य चापि शतं पुत्रा भविष्यन्ति महाबलाः ।\nकिन्तु मातुः स वैगुण्यादन्ध एव भविष्यति \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2112647, "chapter_id": 3428, "verse_number": "१४", "content_sanskrit": "निशम्य वचनं तस्य तन्माता पुनरब्रवीत् ।\nअलब्धलाभः पुत्रोऽयं यद्यन्धो वै भविष्यति \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2112648, "chapter_id": 3428, "verse_number": "१५", "content_sanskrit": "अस्य वंशस्य गोप्तारं सतां शोकविनाशनम् ।\nतस्मादवरजं पुत्रं जनयान्यं नराधिपम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2112649, "chapter_id": 3428, "verse_number": "१६", "content_sanskrit": "भ्रातुर्भार्याऽपरा चेयं रूपयौवनशालिनी ।\nअस्यामुत्पादयापत्यं मन्नियोगाद् गुणाधिकम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2112650, "chapter_id": 3428, "verse_number": "१७", "content_sanskrit": "द्वितीयं कुरुवंशस्य राजानं दातुमर्हसि ।\nस तथेति प्रतिज्ञाय निश्चक्राम महातपाः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2112651, "chapter_id": 3428, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2112652, "chapter_id": 3428, "verse_number": "१८", "content_sanskrit": "अम्बालिकां समादाय तस्यां सत्यवती सुतम् ।\nभूयो नियोजयामास सन्तानाय कुलस्य वै \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2112653, "chapter_id": 3428, "verse_number": "१९", "content_sanskrit": "विषण्णाऽम्बालिका साध्वी निषण्णा शयनोत्तमे ।\nको न्वेष्यतीति ध्यायन्ती नियता सम्प्रतीक्षते \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2112654, "chapter_id": 3428, "verse_number": "२०", "content_sanskrit": "ततस्तेनैव विधिना महर्षिः समपद्यत ।\nअम्बालिकामथाभ्यागाद् ऋषिं दृष्ट्वा च साऽपि तम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2112655, "chapter_id": 3428, "verse_number": "२१", "content_sanskrit": "विषण्णा पाण्डुसङ्काशा समपद्यत भारत ।\nतां बालां पाण्डुसङ्काशां विषण्णां प्रेक्ष्य पार्थिव\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2112656, "chapter_id": 3428, "verse_number": "२२", "content_sanskrit": "व्यासः सत्यवतीपुत्र इदं वचनमब्रवीत् ।\nयस्मात् पाण्डुत्वमापन्ना विरूपं प्रेक्ष्य मामसि\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2112657, "chapter_id": 3428, "verse_number": "२३", "content_sanskrit": "तस्मादेष सुतस्तुभ्यं पाण्डुस्त्वेव भविष्यति ।\nनाम चास्य तदेवेह भविष्यति शुभानने\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2112658, "chapter_id": 3428, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2112659, "chapter_id": 3428, "verse_number": "२४", "content_sanskrit": "इत्युक्त्वा तां निराक्रामद्भगवानृषिसत्तमः ।\nतमुवाच ततो माता अप्यत्र भविता शुभः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2112660, "chapter_id": 3428, "verse_number": "२५", "content_sanskrit": "कुमारो ब्रूहि मे पुत्र ऋषिस्तां प्रत्युवाच ह ।\nभविष्यति सुविक्रान्तः कुमारो दिक्षु विश्रुतः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2112661, "chapter_id": 3428, "verse_number": "२६", "content_sanskrit": "पाण्डुत्वं वर्णतस्तस्य मातृदोषाद् भविष्यति ।\nअस्य पुत्रा महेष्वासा भविष्यन्तीह पञ्च वै \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2112662, "chapter_id": 3428, "verse_number": "२७", "content_sanskrit": "इत्युक्त्वा मातरं तत्र सोऽभिवाद्य जगाम ह ।\nमुनौ यातेऽम्बिका पुत्रं महाभागमसूयत \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2112663, "chapter_id": 3428, "verse_number": "२८", "content_sanskrit": "धृतराष्ट्रं महाप्राज्ञं प्रज्ञाचक्षुषमीश्वरम् ।\nअनुजाऽम्बालिका तत्र पुत्रं काले व्यजायत\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2112664, "chapter_id": 3428, "verse_number": "२९", "content_sanskrit": "पाण्डुं लक्षणसम्पन्नं दीप्यमानं श्रिया वृतम् ।\nतयोर्जन्मक्रियाः सर्वा यथावदनुपूर्वशः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2112665, "chapter_id": 3428, "verse_number": "३०", "content_sanskrit": "कारयामास वै भीष्मो ब्राह्मणैर्वेदपारगैः ।\nअन्घं दृष्ट्वाऽम्बिकापुत्रं जातं सत्यवती सुतम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2112666, "chapter_id": 3428, "verse_number": "३१", "content_sanskrit": "कौसल्यार्थे समाहूय पुत्रमन्यमयाचत ।\nअन्धोऽयमन्यमिच्छामि कौसल्यातनयं शुभम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2112667, "chapter_id": 3428, "verse_number": "३२", "content_sanskrit": "एवमुक्तो महर्षिस्तां मातरं प्रत्यभाषत ।\nनियता यदि कौसल्या भविष्यति पुनः शुभा \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2112668, "chapter_id": 3428, "verse_number": "३३", "content_sanskrit": "भविष्यति कुमारोऽस्या धर्मशास्त्रार्थतत्त्ववित् ।\nतां समाधाय वै भूयः स्नुषां सत्यवती तदा \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2112669, "chapter_id": 3428, "verse_number": "३४", "content_sanskrit": "ऋतुकालं च विज्ञाय देव्या सञ्चोदिताऽम्बिका ।\nसा तु रूपं च गन्घं च महर्षेः प्रविचिन्त्य तम् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2112670, "chapter_id": 3428, "verse_number": "३५", "content_sanskrit": "नाकरोद् वचनं देव्या भयात् सुरसुतोपमा ।\nततः स्वैर्भूषणैर्दासीं भूषयित्वाऽप्सरोपमाम् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2112671, "chapter_id": 3428, "verse_number": "३६", "content_sanskrit": "प्रेषयामास कृष्णाय ततः काशिपतेः सुता ।\nदासी ऋषिमनुप्राप्तं प्रत्युत्थायाभिवाद्य च \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2112672, "chapter_id": 3428, "verse_number": "३७", "content_sanskrit": "संविवेशाभ्यनुज्ञाता सत्कृत्योपचचार सा ।\nआहार्योपप्रदानेन गात्रसंस्पर्शनेन च \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2112673, "chapter_id": 3428, "verse_number": "३८", "content_sanskrit": "कामोपभोगसंयुक्तो महर्षिर्विस्मितोऽभवत् ।\nतया सहोषितो रात्रिं महर्षिः प्रीयमाणया \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2112674, "chapter_id": 3428, "verse_number": "३९", "content_sanskrit": "उत्तिष्ठन्नब्रवीदेनां त्वं भुजिष्या भविष्यसि ।\nएष ते सुभगे गर्भः श्रीमानुदरमागतः \t॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2112675, "chapter_id": 3428, "verse_number": "४०", "content_sanskrit": "धर्मात्मा विश्रुतो लोके सर्वधर्मविदां वरः ।\nइत्युक्त्वा स निराक्रामत् कृष्णद्वैपायनः प्रभुः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2112676, "chapter_id": 3428, "verse_number": "४१", "content_sanskrit": "जज्ञे स विदुरो नाम कृष्णद्वैपायनात्मजः ।\nधृतराष्ट्रस्य च भ्राता पाण्डोश्च पृथिवीपतेः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2112677, "chapter_id": 3428, "verse_number": "४२", "content_sanskrit": "धर्मो विदुररूपेण शापात् तस्य महात्मनः ।\nमाण्डव्यस्यार्थतत्त्वज्ञः कामक्रोधविवर्जितः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2112678, "chapter_id": 3428, "verse_number": "४३", "content_sanskrit": "क्षेत्रे विचित्रवीर्यस्य कृष्णद्वैपायनादपि ।\nजज्ञिरे देवगर्भाभाः कुरुवंशविवर्धनाः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2112679, "chapter_id": 3428, "verse_number": "४४", "content_sanskrit": "तेषु त्रिषु कुमारेषु जातेषु कुरुजाङ्गलम् ।\nकुरवोऽथ कुरुक्षेत्रं सर्वं क्षेममवर्धत \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2112680, "chapter_id": 3428, "verse_number": "४५", "content_sanskrit": "गन्धवत्यास्तथैवोकत्वा धर्मरूपं सुतं प्रति ।\nनाहमस्मि पुनर्योक्तुं शक्यो मातः सुतान् प्रति \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2112681, "chapter_id": 3428, "verse_number": "४६", "content_sanskrit": "स धर्मस्यानृणो भूत्वा पुनर्मात्रा समेत्य च ।\nतस्याश्च सर्वमाख्याय तत्रैवान्तरधीयत \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2112682, "chapter_id": 3428, "verse_number": "५५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nसप्ताधिकशततमोऽध्यायः ॥१०७॥\n॥ इति सम्भवपर्वणि पञ्चपञ्चाशोऽध्यायः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2112683, "chapter_id": 3428, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]