[{"id": 7001242000, "chapter_id": 21242, "verse_number": "२-५-१५-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nभगवान्मंत्रमाहात्म्यं भवता कथितं प्रभो ।\nतत्प्रयोगविधानं च साक्षाच्छ्रुतिसमं यथा॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001242001, "chapter_id": 21242, "verse_number": "२-५-१५-२", "content_sanskrit": "इदानीं श्रोतुमिच्छामि शिवसंस्कारमुत्तमम् ।\nमंत्रसंग्रहणे किंचित्सूचितन्न तु विस्मृतम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001242002, "chapter_id": 21242, "verse_number": "२-५-१५-३", "content_sanskrit": "उपमन्युरुवाच ।\nहन्त ते कथयिष्यामि सर्वपापविशोधनम् ।\nसंस्कारं परमं पुण्यं शिवेन पतिभाषितम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001242003, "chapter_id": 21242, "verse_number": "२-५-१५-४", "content_sanskrit": "सम्यक्कृताधिकारः स्यात्पूजादिषु नरो यतः ।\nसंस्कारः कथ्यते तेन षडध्वपरिशोधनम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001242004, "chapter_id": 21242, "verse_number": "२-५-१५-५", "content_sanskrit": "दीयते येन विज्ञानं क्षीयते पाशबंधनम् ।\nतस्मात्संस्कार एवायं दीक्षेत्यपि च कथ्यते॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001242005, "chapter_id": 21242, "verse_number": "२-५-१५-६", "content_sanskrit": "शांभवी चैव शाक्ती च मांत्री चैव शिवागमे ।\nदीक्षोपदिश्यते त्रेधा शिवेन परमात्मना॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001242006, "chapter_id": 21242, "verse_number": "२-५-१५-७", "content_sanskrit": "गुरोरालोकमात्रेण स्पर्शात्संभाषणादपि ।\nसद्यस्संज्ञा भवेज्जंतोः पाशोपक्षयकारिणी॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001242007, "chapter_id": 21242, "verse_number": "२-५-१५-८", "content_sanskrit": "सा दीक्षा शांभवी प्रोक्ता सा पुनर्भिद्यते द्विधा ।\nतीव्रा तीव्रतरा चेति पाशो पक्षयभेदतः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001242008, "chapter_id": 21242, "verse_number": "२-५-१५-९", "content_sanskrit": "यया स्यान्निर्वृतिः सद्यस्सैव तीव्रतरा मता ।\nतीव्रा तु जीवतोत्यंतं पुंसः पापविशोधिका॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001242009, "chapter_id": 21242, "verse_number": "२-५-१५-१०", "content_sanskrit": "शक्ती ज्ञानवती दीक्षा शिष्यदेहं प्रविश्य तु ।\nगुरुणा योगमार्गेण क्रियते ज्ञानचक्षुषा॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001242010, "chapter_id": 21242, "verse_number": "२-५-१५-११", "content_sanskrit": "मांत्री क्रियावती दीक्षा कुंडमंडलपूर्विका ।\nमंदमंदतरोद्देशात्कर्तव्या गुरुणा बहिः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001242011, "chapter_id": 21242, "verse_number": "२-५-१५-१२", "content_sanskrit": "शक्तिपातानुसारेण शिष्यो ऽनुग्रहमर्हति ।\nशैवधर्मानुसारस्य तन्मूलत्वात्समासतः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001242012, "chapter_id": 21242, "verse_number": "२-५-१५-१३", "content_sanskrit": "यत्र शक्तिर्न पतिता तत्र शुद्धिर्न जायते ।\nन विद्या न शिवाचारो न मुक्तिर्न च सिद्धयः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001242013, "chapter_id": 21242, "verse_number": "२-५-१५-१४", "content_sanskrit": "तस्माल्लिंगानि संवीक्ष्य शक्तिपातस्य भूयसः ।\nज्ञानेन क्रियया वाथ गुरुश्शिष्यं विशोधयेत्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001242014, "chapter_id": 21242, "verse_number": "२-५-१५-१५", "content_sanskrit": "यो ऽन्यथा कुरुते मोहात्स विनश्यति दुर्मतिः ।\nतस्मात्सर्वप्रकारेण गुरुः शिष्यं परीक्षयेत्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001242015, "chapter_id": 21242, "verse_number": "२-५-१५-१६", "content_sanskrit": "लक्षणं शक्तिपातस्य प्रबोधानंदसंभवः ।\nसा यस्मात्परमा शक्तिः प्रबोधानंदरूपिणी॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001242016, "chapter_id": 21242, "verse_number": "२-५-१५-१७", "content_sanskrit": "आनंदबोधयोर्लिंगमंतःकरणविक्रियाः ।\nयथा स्यात्कंपरोमांचस्वरनेत्रांगविक्रियाः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001242017, "chapter_id": 21242, "verse_number": "२-५-१५-१८", "content_sanskrit": "शिष्योपि लक्षणैरेभिः कुर्याद्गुरुपरीक्षणम् ।\nतत्संपर्कैः शिवार्चादौ संगतैर्वाथ तद्गतैः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001242018, "chapter_id": 21242, "verse_number": "२-५-१५-१९", "content_sanskrit": "शिष्यस्तु शिक्षणीयत्वाद्गुरोर्गौरवकारणात् ।\nतस्मात्सर्वप्रयत्नेन गुरोर्गौरवमाचरेत्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001242019, "chapter_id": 21242, "verse_number": "२-५-१५-२०", "content_sanskrit": "यो गुरुस्स शिवः प्रोक्तो यः शिवः स गुरुः स्मृतः ।\nगुरुर्वा शिव एवाथ विद्याकारेण संस्थितः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001242020, "chapter_id": 21242, "verse_number": "२-५-१५-२१", "content_sanskrit": "यथा शिवस्तथा विद्या यथा विद्या तथा गुरुः ।\nशिवविद्या गुरूणां च पूजया सदृशं फलम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001242021, "chapter_id": 21242, "verse_number": "२-५-१५-२२", "content_sanskrit": "सर्वदेवात्मकश्चासौ सर्वमंत्रमयो गुरुः ।\nतस्मात्सर्वप्रयत्नेन यस्याज्ञां शिरसा वहेत्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001242022, "chapter_id": 21242, "verse_number": "२-५-१५-२३", "content_sanskrit": "श्रेयो ऽर्थी यदि गुर्वाज्ञां मनसापि न लंघयेत् ।\nगुर्वाज्ञापालको यस्माज्ज्ञानसंपत्तिमश्नुते॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001242023, "chapter_id": 21242, "verse_number": "२-५-१५-२४", "content_sanskrit": "गच्छंस्तिष्ठन्स्वपन्भुंजन्नान्यत्कर्म समाचरेत् ।\nसमक्षं यदि कुर्वीत सर्वं चानुज्ञया गुरोः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001242024, "chapter_id": 21242, "verse_number": "२-५-१५-२५", "content_sanskrit": "गुरोर्गृहे समक्षं वा न यथेष्टासनो भवेत् ।\nगुरुर्देवो यतः साक्षात्तद्गृहं देवमन्दिरम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001242025, "chapter_id": 21242, "verse_number": "२-५-१५-२६", "content_sanskrit": "पापिनां च यथा संगात्तत्पापात्पतितो भवेत् ।\nयथेह वह्निसंपर्कान्मलं त्यजति कांचनम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001242026, "chapter_id": 21242, "verse_number": "२-५-१५-२७", "content_sanskrit": "तथैव गुरुसंपर्कात्पापं त्यजति मानवः ।\nयथा वह्निसमीपस्थो घृतकुम्भो विलीयते॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001242027, "chapter_id": 21242, "verse_number": "२-५-१५-२८", "content_sanskrit": "तथा पापं विलीयेत ह्याचार्यस्य समीपतः ।\nयथा प्रज्वलितो वह्निः शुष्कमार्द्रं च निर्दहेत्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001242028, "chapter_id": 21242, "verse_number": "२-५-१५-२९", "content_sanskrit": "तथायमपि संतुष्टो गुरुः पापं क्षणाद्दहेत् ।\nमनसा कर्मणा वाचा गुरोः क्रोधं न कारयेत्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001242029, "chapter_id": 21242, "verse_number": "२-५-१५-३०", "content_sanskrit": "तस्य क्रोधेन दह्यंते ह्यायुःश्रीज्ञानसत्क्रियाः ।\nतत्क्रोधकारिणो ये स्युस्तेषां यज्ञाश्च निष्फलाः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001242030, "chapter_id": 21242, "verse_number": "२-५-१५-३१", "content_sanskrit": "यमश्च नियमाश्चैव नात्र कार्या विचारणा ।\nगुरोर्विरुद्धं यद्वाक्यं न वदेज्जातुचिन्नरः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001242031, "chapter_id": 21242, "verse_number": "२-५-१५-३२", "content_sanskrit": "वदेद्यदि महामोहाद्रौरवं नरकं व्रजेत् ।\nमनसा कर्मणा वाचा गुरुमुद्दिश्य यत्नतः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001242032, "chapter_id": 21242, "verse_number": "२-५-१५-३३", "content_sanskrit": "श्रेयोर्थी चेन्नरो धीमान्न मिथ्याचारमाचरेत् ।\nगुरोर्हितं प्रियं कुर्यादादिष्टो वा न वा सदा॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001242033, "chapter_id": 21242, "verse_number": "२-५-१५-३४", "content_sanskrit": "असमक्षं समक्षं वा तस्य कार्यं समाचरेत् ।\nइत्थमाचारवान्भक्तो नित्यमुद्युक्तमानसः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001242034, "chapter_id": 21242, "verse_number": "२-५-१५-३५", "content_sanskrit": "गुरुप्रियकरः शिष्यः शैवधर्मांस्ततो ऽर्हति ।\nगुरुश्चेद्गुणवान्प्राज्ञः परमानंदभासकः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001242035, "chapter_id": 21242, "verse_number": "२-५-१५-३६", "content_sanskrit": "तत्त्वविच्छिवसंसक्तो मुक्तिदो न तु चापरः ।\nसंवित्संजननं तत्त्वं परमानंदसंभवम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001242036, "chapter_id": 21242, "verse_number": "२-५-१५-३७", "content_sanskrit": "तत्तत्त्वं विदितं येन स एवानंददर्शकः ।\nन पुनर्नाममात्रेण संविदारहितस्तु यः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001242037, "chapter_id": 21242, "verse_number": "२-५-१५-३८", "content_sanskrit": "अन्योन्यं तारयेन्नौका किं शिला तारयेच्छिलाम् ।\nएतस्या नाममात्रेण मुक्तिर्वै नाममात्रिका॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001242038, "chapter_id": 21242, "verse_number": "२-५-१५-३९", "content_sanskrit": "यैः पुनर्विदितं तत्त्वं ते मुक्ता मोचयन्त्यपि ।\nतत्त्वहीने कुतो बोधः कुतो ह्यात्मपरिग्रहः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001242039, "chapter_id": 21242, "verse_number": "२-५-१५-४०", "content_sanskrit": "परिग्रहविनिर्मुक्तः पशुरित्यभिधीयते ।\nपशुभिः प्रेरितश्चापि पशुत्वं नातिवर्तते॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001242040, "chapter_id": 21242, "verse_number": "२-५-१५-४१", "content_sanskrit": "तस्मात्तत्त्वविदेवेह मुक्तो मोचक इष्यते ।\nसर्वलक्षणसंयुक्तः सर्वशास्त्रविदप्ययम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001242041, "chapter_id": 21242, "verse_number": "२-५-१५-४२", "content_sanskrit": "सर्वोपायविधिज्ञो ऽपि तत्त्वहीनस्तु निष्फलः ।\nयस्यानुभवपर्यंता बुद्धिस्तत्त्वे प्रवर्तते॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001242042, "chapter_id": 21242, "verse_number": "२-५-१५-४३", "content_sanskrit": "तस्यावलोकनाद्यैश्च परानन्दो ऽभिजायते ।\nतस्माद्यस्यैव संपर्कात्प्रबोधानंदसंभवः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001242043, "chapter_id": 21242, "verse_number": "२-५-१५-४४", "content_sanskrit": "गुरुं तमेव वृणुयान्नापरं मतिमान्नरः ।\nस शिष्यैर्विनयाचारचतुरैरुचितो गुरुः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001242044, "chapter_id": 21242, "verse_number": "२-५-१५-४५", "content_sanskrit": "यावद्विज्ञायते तावत्सेवनीयो मुमुक्षुभिः ।\nज्ञाते तस्मिन्स्थिरा भक्तिर्यावत्तत्त्वं समाश्रयेत्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001242045, "chapter_id": 21242, "verse_number": "२-५-१५-४६", "content_sanskrit": "न तु तत्त्वं त्यजेज्जातु नोपेक्षेत कथंचन ।\nयत्रानंदः प्रबोधो वा नाल्पमप्युपलभ्यते॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001242046, "chapter_id": 21242, "verse_number": "२-५-१५-४७", "content_sanskrit": "वत्सरादपि शिष्येण सो ऽन्यं गुरुमुपाश्रयेत् ।\nगुरुमन्यं प्रपन्ने ऽपि नावमन्येत पौर्विकम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001242047, "chapter_id": 21242, "verse_number": "२-५-१५-४८", "content_sanskrit": "गुरोर्भ्रात्ःंस्तथा पुत्रान्बोधकान्प्रेरकानपि ।\nतत्रादावुपसंगम्य ब्राह्मणं वेदपारगम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001242048, "chapter_id": 21242, "verse_number": "२-५-१५-४९", "content_sanskrit": "गुरुमाराधयेत्प्राज्ञं शुभगं प्रियदर्शनम् ।\nसर्वाभयप्रदातारं करुणाक्रांतमानसम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001242049, "chapter_id": 21242, "verse_number": "२-५-१५-५०", "content_sanskrit": "तोषयेत्तं प्रयत्नेन मनसा कर्मणा गिरा ।\nतावदाराधयेच्छिष्यः प्रसन्नोसौ भवेद्यथा॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001242050, "chapter_id": 21242, "verse_number": "२-५-१५-५१", "content_sanskrit": "तस्मिन्प्रसन्ने शिष्यस्य सद्यः पापक्षयो भवेत् ।\nतस्माद्धनानि रत्नानि क्षेत्राणि च गृहाणि च॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001242051, "chapter_id": 21242, "verse_number": "२-५-१५-५२", "content_sanskrit": "भूषणानि च वासांसि यानशय्यासनानि च ।\nएतानि गुरवे दद्याद्भक्त्या वित्तानुसारतः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001242052, "chapter_id": 21242, "verse_number": "२-५-१५-५३", "content_sanskrit": "वित्तशाठ्यं न कुर्वीत यदीच्छेत्परमां गतिम् ।\nस एव जनको माता भर्ता बन्धुर्धनं सुखम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001242053, "chapter_id": 21242, "verse_number": "२-५-१५-५४", "content_sanskrit": "सखा मित्रं च यत्तस्मात्सर्वं तस्मै निवेदयेत् ।\nनिवेद्य पश्चात्स्वात्मानं सान्वयं सपरिग्रहम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001242054, "chapter_id": 21242, "verse_number": "२-५-१५-५५", "content_sanskrit": "समर्प्य सोदकं तस्मै नित्यं तद्वशगो भवेत् ।\nयदा शिवाय स्वात्मानं दत्तवान् देशिकात्मने॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001242055, "chapter_id": 21242, "verse_number": "२-५-१५-५६", "content_sanskrit": "तदा शैवो भवेद्देही न ततो ऽस्ति पुनर्भवः ।\nगुरुश्च स्वाश्रितं शिष्यं वर्षमेकं परीक्षयेत्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001242056, "chapter_id": 21242, "verse_number": "२-५-१५-५७", "content_sanskrit": "ब्राह्मणं क्षत्रियं वैश्यं द्विवर्षं च त्रिवर्षकम् ।\nप्राणद्रव्यप्रदानाद्यैरादेशैश्च समासमैः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001242057, "chapter_id": 21242, "verse_number": "२-५-१५-५८", "content_sanskrit": "उत्तमांश्चाधमे कृत्वा नीचानुत्तमकर्मणि ।\nआक्रुष्टास्ताडिता वापि ये विषादं न यान्त्यपि॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001242058, "chapter_id": 21242, "verse_number": "२-५-१५-५९", "content_sanskrit": "ते योग्याः संयताः शुद्धाः शिवसंस्कारकर्मणि ।\nअहिंसका दयावंतो नित्यमुद्युक्तचेतसः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001242059, "chapter_id": 21242, "verse_number": "२-५-१५-६०", "content_sanskrit": "अमानिनो बुद्धिमंतस्त्यक्तस्पर्धाः प्रियंवदाः ।\nऋजवो मृदवः स्वच्छा विनीताः स्थिरचेतसः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001242060, "chapter_id": 21242, "verse_number": "२-५-१५-६१", "content_sanskrit": "शौचाचारसमायुक्ताः शिवभक्ता द्विजातयः ।\nएवं वृत्तसमोपेता वाङ्मनःकायकर्मभिः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001242061, "chapter_id": 21242, "verse_number": "२-५-१५-६२", "content_sanskrit": "शोध्या बोध्या यथान्यायमिति शास्त्रेषु निश्चयः ।\nनाधिकारः स्वतो नार्याः शिवसंस्कारकर्मणि॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001242062, "chapter_id": 21242, "verse_number": "२-५-१५-६३", "content_sanskrit": "नियोगाद्भर्तुरस्त्येव भक्तियुक्ता यदीश्वरे ।\nतथैव भर्तृहीनाया पुत्रादेरभ्यनुज्ञया॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001242063, "chapter_id": 21242, "verse_number": "२-५-१५-६४", "content_sanskrit": "अधिकारो भवत्येव कन्यायाः पितुराज्ञया ।\nशूद्राणां मर्त्यजातीनां पतितानां विशेषतः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001242064, "chapter_id": 21242, "verse_number": "२-५-१५-६५", "content_sanskrit": "तथा संकरजातीनां नाध्वशुद्धिर्विधीयते ।\nतैप्यकृत्रिमभावश्चेच्छिवे परमकारणे॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001242065, "chapter_id": 21242, "verse_number": "२-५-१५-६६", "content_sanskrit": "पादोदकप्रदानाद्यैः कुर्युः पापविशोधनम् ।\nअत्रानुलोमजाता ये युक्ता एव द्विजातिषु॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001242066, "chapter_id": 21242, "verse_number": "२-५-१५-६७", "content_sanskrit": "तेषामध्वविशुद्ध्यादि कुर्यान्मातृकुलोचितम् ।\nया तु कन्या स्वपित्राद्यैश्शिवधर्मे नियोजिता॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001242067, "chapter_id": 21242, "verse_number": "२-५-१५-६८", "content_sanskrit": "सा भक्ताय प्रदातव्या नापराय विरोधिने ।\nदत्ता चेत्प्रतिकूलाय प्रमादाद्बोधयेत्पतिम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001242068, "chapter_id": 21242, "verse_number": "२-५-१५-६९", "content_sanskrit": "अशक्ता तं परित्यज्य मनसा धर्ममाचरेत् ।\nयथा मुनिवरं त्यक्त्वा पतिमत्रिं पतिव्रता॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001242069, "chapter_id": 21242, "verse_number": "२-५-१५-७०", "content_sanskrit": "कृतकृत्या ऽभवत्पूर्वं तपसाराध्य शङ्करम् ।\nयथा नारायणं देवं तपसाराध्य पांडवान्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001242070, "chapter_id": 21242, "verse_number": "२-५-१५-७१", "content_sanskrit": "पतींल्लब्धवती धर्मे गुरुभिर्न नियोजिता ।\nअस्वातन्त्र्यकृतो दोषो नेहास्ति परमार्थतः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001242071, "chapter_id": 21242, "verse_number": "२-५-१५-७२", "content_sanskrit": "शिवधर्मे नियुक्तायाश्शिवशासनगौरवात् ।\nबहुनात्र किमुक्तेन यो ऽपि को ऽपि शिवाश्रयः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001242072, "chapter_id": 21242, "verse_number": "२-५-१५-७३", "content_sanskrit": "संस्कार्यो गुर्वधीनश्चेत्संस्क्रिया न प्रभिद्यते ।\nगुरोरालोकनादेव स्पर्शात्संभाषणादपि॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001242073, "chapter_id": 21242, "verse_number": "२-५-१५-७४", "content_sanskrit": "यस्य संजायते प्रज्ञा तस्य नास्ति पराजयः ।\nमनसा यस्तु संस्कारः क्रियते योगवर्त्मना॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001242074, "chapter_id": 21242, "verse_number": "२-५-१५-७५", "content_sanskrit": "स नेह कथितो गुह्यो गुरुवक्त्रैकगोचरः ।\nक्रियावान्यस्तु संस्कारः कुंडमंडपपूर्वकः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001242075, "chapter_id": 21242, "verse_number": "२-५-१५-७६", "content_sanskrit": "स वक्ष्यते समासेन तस्य शक्यो न विस्तरः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]