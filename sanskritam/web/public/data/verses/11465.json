[{"id": 50011352, "chapter_id": 11465, "verse_number": "1", "content_sanskrit": "रहूगण उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50011353, "chapter_id": 11465, "verse_number": "2", "content_sanskrit": "नमोनमः कारणविग्रहाय स्वरूपतुच्छीकृतविग्रहाय। नमोऽवधूतद्विजबन्धुलिङ्गनिगूढनित्यानुभवाय तुभ्यम्॥ ५/१२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50011354, "chapter_id": 11465, "verse_number": "3", "content_sanskrit": "ज्वरामयार्तस्य यथाऽगदं सन्निदाघदग्धस्य यथा हिमाम्भः। कुदेहमानाहिसुदष्टदृष्टेः ब्रह्मन् वचस्तेऽमृतमौषधं मे॥ ५/१२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50011355, "chapter_id": 11465, "verse_number": "4", "content_sanskrit": "तस्माद् भवन्तं मम संशयार्थं प्रक्ष्यामि पश्चादधुना सुबोधम्। अध्यात्मयोगग्रथितं पुरोक्तमाख्याहि कौतूहलचेतसो मे॥ ५/१२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50011356, "chapter_id": 11465, "verse_number": "5", "content_sanskrit": "यदाह योगेश्वर दृश्यमानं क्रियाफलं सद्व्यवहारमूलम्। नह्यञ्जसा तत्त्वविमर्शनाय भवानमुष्मिन् भ्रमते मनो मे॥ ५/१२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50011357, "chapter_id": 11465, "verse_number": "6", "content_sanskrit": "ब्राह्मण उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50011358, "chapter_id": 11465, "verse_number": "7", "content_sanskrit": "अयं जनो नाम चलन् पृथिव्यां यः पार्थिवः पार्थिव कस्य हेतोः। तस्यापि चङ्घ्रायोरधि गुल्फजङ्घाजानूरुमध्योरशिरोधरांसाः॥ ५/१२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50011359, "chapter_id": 11465, "verse_number": "8", "content_sanskrit": "अंसे च दार्वी शिबिका च यस्यां सौवीरराजेत्यपदेश आस्ते। यस्मिन् भवान् रूढनिजाभिमानो राजाऽस्मि सिन्धुष्विति दुर्मदान्धः॥ ५/१२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50011360, "chapter_id": 11465, "verse_number": "9", "content_sanskrit": "शोच्यानिमांस्तानधिकः समाधिः विष्ट्या निगृह्णन् निरनुग्रहोऽसि। जनस्य गोप्तेति विकत्थमानो न शोभसे वृद्धसभासु धृष्टः॥ ५/१२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50011361, "chapter_id": 11465, "verse_number": "10", "content_sanskrit": "यदि क्षितावेव चराचरस्य विदाम निष्ठां प्रभवं च नित्यम्। तन्नामतोऽन्यद् व्यवहारमूलं निरूप्यतां सत्क्रिययाऽनुमेयम्॥ ५/१२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50011362, "chapter_id": 11465, "verse_number": "11", "content_sanskrit": "एवं निरुक्तं क्षितिशब्दवृत्तमसन्निधानं परमाणवो ये। अविद्यया मनसा कल्पितास्ते येषां समूहेन कृतो विशेषः॥ ५/१२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50011363, "chapter_id": 11465, "verse_number": "12", "content_sanskrit": "एवं कृशस्थूलमणुर्बृहद् यदसच्च सज्जीवमजीवमन्यत्। द्रव्यस्वभावाशयकालकर्मनाम्न्याऽजयाऽवैहि कृतं द्वितीयम्॥ ५/१२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50011364, "chapter_id": 11465, "verse_number": "13", "content_sanskrit": "ज्ञानं विशुद्धं परमार्थमेकमनन्तरं न बहिर्ब्रह्म सत्यम्। प्रत्यक् प्रशान्तं भगवच्छब्दवाच्यं यद् वासुदेवं कवयो वदन्ति॥ ५/१२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50011365, "chapter_id": 11465, "verse_number": "14", "content_sanskrit": "रहूगणैतत् तपसा न याति न चेज्यया निर्वसनाद् गृहाद् वा। न छन्दसा नोत जलाग्निसूर्यैर्विना महत्पादरजोभिषेकम्॥ ५/१२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50011366, "chapter_id": 11465, "verse_number": "15", "content_sanskrit": "यत्रोत्तमश्लोकगुणानुवादः प्रस्तूयते ग्राम्यकथाविघातः। निषेव्यमाणोऽनुदिनं मुमुक्षोर्मतिं सतीं यच्छति वासुदेवे॥ ५/१२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50011367, "chapter_id": 11465, "verse_number": "16", "content_sanskrit": "अहं पुरा भरतो नाम राजा विमुक्तदृष्टश्रुतसङ्गबन्धः। आराधनं भगवत ईहमानो मृगोऽभवं मृगसङ्गाद् हतार्थः॥ ५/१२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50011368, "chapter_id": 11465, "verse_number": "17", "content_sanskrit": "सा मां स्मृतिर्मृगदेहेऽपि वीर कृष्णार्चनप्रभवा नो जहाति। अथो अहं जनसङ्गादसङ्गो विशङ्कमानोऽविवृतश्चरामि॥ ५/१२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50011369, "chapter_id": 11465, "verse_number": "18", "content_sanskrit": "तस्मान्नरोऽसङ्गसुसङ्गजातज्ञानासिनेवैह विवृक्णमोहः। हरिं तदीहाकथनश्रुतिभ्यां लब्धस्मृतिर्यात्यतिपारमध्वनः॥ ५/१२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50011370, "chapter_id": 11465, "verse_number": "19", "content_sanskrit": "इति श्रीमद्भागवते पञ्चमस्कन्धे द्वादशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]