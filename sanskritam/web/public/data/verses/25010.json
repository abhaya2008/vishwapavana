[{"id": 7005010000, "chapter_id": 25010, "verse_number": "७-१-१९३-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि यमेश्वरमनुत्तमम् ।\nतस्यैव नैरृते भागे नातिदूरे व्यवस्थितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005010001, "chapter_id": 25010, "verse_number": "७-१-१९३-२", "content_sanskrit": "दर्शनात्पापशमनं सर्वकामफलप्रदम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005010002, "chapter_id": 25010, "verse_number": "७-१-१९३-३", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखंडे प्रथमे प्रभासक्षेत्रमाहात्म्ये यमेश्वरमाहात्म्यवर्णनं नाम त्रिणवत्युत्तरशततमोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}]