[{"id": 2091491, "chapter_id": 2946, "verse_number": "१३-७६-१", "content_sanskrit": "भीष्म उवाच।\nततः कदाचिद्देवेन्द्रो दिव्यरूपवपुर्धरः।\nइदमन्तरमित्येवमभ्यगात्तमथाश्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2091492, "chapter_id": 2946, "verse_number": "१३-७६-२", "content_sanskrit": "रूपमप्रतिमं कृत्वा लोभनीयं जनाधिपः।\nदर्शनीयतमो भूत्वा प्रविवेश तमाश्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2091493, "chapter_id": 2946, "verse_number": "१३-७६-३", "content_sanskrit": "स ददर्श तमासीनं विपुलस्य कलेबरम्।\nनिश्चेष्टं स्तब्धनयनं यताऽऽलेख्यगतं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2091494, "chapter_id": 2946, "verse_number": "१३-७६-४", "content_sanskrit": "रुचिं च रुचिरापाङ्गीं पीनश्रोणिपयोधराम्।\nपद्मपत्रविशालाक्षीं सम्पूर्णेन्दुनिभाननाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2091495, "chapter_id": 2946, "verse_number": "१३-७६-५", "content_sanskrit": "सा तमालोक्य सहसा प्रत्युत्तातुमियेष ह।\nरूपेण विस्मिता कोऽसीत्यथ वक्तुमिवेच्छती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2091496, "chapter_id": 2946, "verse_number": "१३-७६-६", "content_sanskrit": "उत्थातुकामा तु सती विष्टव्धा विपुलेन सा।\nनिगृहीता मनुष्येन्द्र न शशाक विचेष्टितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2091497, "chapter_id": 2946, "verse_number": "१३-७६-७", "content_sanskrit": "तामाबभाषे देवेन्द्रः साम्ना परमवल्*******।\nत्वदर्थमागतं विद्धि देवेन्द्र मां शुचिस्मिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2091498, "chapter_id": 2946, "verse_number": "१३-७६-८", "content_sanskrit": "क्लिश्यमानमनङ्गेन त्वत्सङ्कल्पभवेन ह।\nतत्पर्याप्नुहि मां सुभ्रु पुरा कालोऽतिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2091499, "chapter_id": 2946, "verse_number": "१३-७६-९", "content_sanskrit": "तमेवंवादिनं शक्रं शुश्राव विपुलो मुनिः।\nगुरुपत्नयाः शरीरस्थो ददर्श त्रिदसाधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2091500, "chapter_id": 2946, "verse_number": "१३-७६-१०", "content_sanskrit": "न शशाक च सा राजन्प्रत्युत्थातुमनिन्दिता।\nवक्तुं च नाशकद्राजन्विष्टब्दा विपुलेन सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2091501, "chapter_id": 2946, "verse_number": "१३-७६-११", "content_sanskrit": "आकारं गुरुपत्न्यास्तु स विज्ञाय भृगूद्वहः।\nनिजय्नाह महातेजा योगेन बलवत्प्रभो।\nबबन्ध योगबन्धैश्च तस्याः सर्वेन्द्रियाणि सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2091502, "chapter_id": 2946, "verse_number": "१३-७६-१२", "content_sanskrit": "तां निर्विकारां दृष्ट्वा तु पुनरेव शचीपतिः।\nउवाच व्रीहितो राजंस्तां योगबलमोहिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2091503, "chapter_id": 2946, "verse_number": "१३-७६-१३", "content_sanskrit": "एह्येहीति ततः सा तु प्रतिवक्तुमियेष तम्।\nस तां वाच्यं गुरोः पत्न्या विपुलः पर्यवर्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2091504, "chapter_id": 2946, "verse_number": "१३-७६-१४", "content_sanskrit": "भोः किमागमने कृत्यमिति तस्यास्तु निःसृता।\nवक्त्राच्छशाङ्कसदृशाद्वाणी संस्कारभूषणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2091505, "chapter_id": 2946, "verse_number": "१३-७६-१५", "content_sanskrit": "वीडिता सा तु तद्वाक्यमुक्त्वा परवशा तदा।\nपुरन्दरश्च संत्रस्तो बभूव विमना भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2091506, "chapter_id": 2946, "verse_number": "१३-७६-१६", "content_sanskrit": "स तद्वैकृतमालक्ष्य देवराजो विशांपते।\nअवैक्षत सहस्राक्षस्तदा दिव्येन चक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2091507, "chapter_id": 2946, "verse_number": "१३-७६-१७", "content_sanskrit": "स ददर्श मुनिं तस्याः शरीरान्तरगोचरम्।\nप्रतिबिम्बमिवादर्शे गुरुपत्न्याः शरीरगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2091508, "chapter_id": 2946, "verse_number": "१३-७६-१८", "content_sanskrit": "स तं घोरेण तपसा युक्तं दृष्ट्वा पुरंदरः।\nप्रावेपत सुसंत्रस्तो व्रीडितश्च तदा विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2091509, "chapter_id": 2946, "verse_number": "१३-७६-१९", "content_sanskrit": "विमुच्य गुरुपत्नीं तु विपुलः सुमहातपाः।\nस्वकलेबरमाविश्य शक्रं भीतमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2091510, "chapter_id": 2946, "verse_number": "१३-७६-२०", "content_sanskrit": "अजितेन्द्रिय दुर्बुद्धे पापात्मक पुरंदर।\nन चिरं पूजयिष्यन्ति देवास्त्वां मानुषास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2091511, "chapter_id": 2946, "verse_number": "१३-७६-२१", "content_sanskrit": "किन्नु तद्विस्मृतं शक्र न तन्मनसि ते स्थितम्।\nगौतमेनासि यन्मुक्तो भगाङ्कपरिचिह्नितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2091512, "chapter_id": 2946, "verse_number": "१३-७६-२२", "content_sanskrit": "जाने त्वां बालिशमतिमकृतात्मानमस्थिरम्।\nमयेयं रक्ष्यते मूढ गच्छ पाप यथागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2091513, "chapter_id": 2946, "verse_number": "१३-७६-२३", "content_sanskrit": "नाहं त्वामद्य मूढात्मन्दहेयं हि स्वतेजसा।\nकृपायमानस्तु न ते दग्धुमिच्छामि वासव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2091514, "chapter_id": 2946, "verse_number": "१३-७६-२४", "content_sanskrit": "स च घोरतमो धीमान्गुरुर्मे पापचेतसम्।\nदृष्ट्वा त्वां निर्दहेदद्य क्रोधदीप्तेन चक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2091515, "chapter_id": 2946, "verse_number": "१३-७६-२५", "content_sanskrit": "नैवं तु शक्र कर्तव्यं पुनर्मान्याश्च ते द्विजाः।\nमा गमः ससुतामात्यः क्षयं ब्रह्मबलार्दितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2091516, "chapter_id": 2946, "verse_number": "१३-७६-२६", "content_sanskrit": "अमरोस्मीति यद्बुद्धिं समास्थाय प्रवर्तते।\nमावमंस्था न तपसा न साध्यं नाम किञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2091517, "chapter_id": 2946, "verse_number": "१३-७६-२७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2091518, "chapter_id": 2946, "verse_number": "१३-७६-२७", "content_sanskrit": "तच्छ्रुत्वा वचनं शक्रो विपुलस्य महात्मनः।\nन किञ्चिदुक्त्वा व्रीडार्तस्तत्रैवान्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2091519, "chapter_id": 2946, "verse_number": "१३-७६-२८", "content_sanskrit": "मुहूर्तयाते तस्मिंस्तु देवशर्मा महातपाः।\nकृत्वा यज्ञं यथाकाममाजगाम स्वमाश्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2091520, "chapter_id": 2946, "verse_number": "१३-७६-२९", "content_sanskrit": "आगतेऽथ गुरौ राजन्विपुलः प्रियकर्मकृत्।\nरक्षितां गुरेव भार्यां न्यवेदयदनिन्दिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2091521, "chapter_id": 2946, "verse_number": "१३-७६-३०", "content_sanskrit": "अभिवाद्य च शान्तात्मा स गुरुं गुरुवत्सलः।\nविपुलः पर्युपातिष्ठद्यथापूर्वमशङ्कितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2091522, "chapter_id": 2946, "verse_number": "१३-७६-३१", "content_sanskrit": "विश्रान्ताय ततस्तस्मै सहासीनाय भार्यया।\nनिवेदयामास तदा विपुलः शक्रकर्म तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2091523, "chapter_id": 2946, "verse_number": "१३-७६-३२", "content_sanskrit": "तच्छुत्वा स मुनिस्तुष्टों विपुलस्य प्रतापवान्।\nबभूव शीलवृत्ताभ्यां तपसा नियमेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2091524, "chapter_id": 2946, "verse_number": "१३-७६-३३", "content_sanskrit": "विपुलस्य गुरौ वृत्तिं भक्तिमात्मनि तत्प्रभुः।\nधर्मे च स्थिरतां दृष्ट्वा साधुसाध्वित्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2091525, "chapter_id": 2946, "verse_number": "१३-७६-३४", "content_sanskrit": "प्रतिनन्द्य च धर्मात्मा शिष्यं धर्मपरायणम्।\nवरेण च्छन्दयामास देवशर्मा महामतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2091526, "chapter_id": 2946, "verse_number": "१३-७६-३५", "content_sanskrit": "स्थितिं च धर्मे जग्राह स तस्माद्गुरुवत्सलः।\nअनुज्ञातश्च गुरुणा चचारानुत्तमं तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2091527, "chapter_id": 2946, "verse_number": "१३-७६-३६", "content_sanskrit": "तथैव देवशर्मापि सभार्यः स महातपाः।\nनिर्भयो बलवृत्रघ्नाच्चचार विजने वने॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2091528, "chapter_id": 2946, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि षट्सप्ततितमोऽध्यायः॥१३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]