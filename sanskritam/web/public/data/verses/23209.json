[{"id": 7003209000, "chapter_id": 23209, "verse_number": "१-१२-१", "content_sanskrit": "सूत उवाच  ।\nततस्त्रिंशत्तमः कल्पो रक्तो नाम प्रकीर्तितः  ।\nब्रह्म यत्र महातेजा रक्तवर्णमधारयत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003209001, "chapter_id": 23209, "verse_number": "१-१२-२", "content_sanskrit": "ध्यायतः पुत्रकामस्य ब्रह्मणः परमेष्ठिनः  ।\nप्रादुर्भूतो महातेजाः कुमारो रक्तभूषणः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003209002, "chapter_id": 23209, "verse_number": "१-१२-३", "content_sanskrit": "रक्तमाल्यांबरधरो रक्तनेत्रः प्रतापवान्  ।\nस तं दृष्ट्वा महात्मानं कुमारं रक्तवाससम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003209003, "chapter_id": 23209, "verse_number": "१-१२-४", "content_sanskrit": "परं ध्यानं समाश्रित्य बुबुधे देवमीश्वरम्  ।\nस तं प्रणम्य भगवान् ब्रह्मा परमयंत्रितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003209004, "chapter_id": 23209, "verse_number": "१-१२-५", "content_sanskrit": "वामदेवं ततो ब्रह्मा ब्रह्म वै समचिंतयत्  ।\nतथा स्तुतो महादेवो ब्रह्मणा परमेश्वरः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003209005, "chapter_id": 23209, "verse_number": "१-१२-६", "content_sanskrit": "प्रतीतहृदयः सर्व इदमाह पितामहम्  ।\nध्यायता पुत्रकामेन यस्मात्तेहं पितामह ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003209006, "chapter_id": 23209, "verse_number": "१-१२-७", "content_sanskrit": "दृष्टः परमया भक्त्या स्तुतश्च ब्रह्मपुर्वकम्  ।\nतस्माद्ध्यानबलं प्राप्य कल्पेकल्पे प्रयत्नतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003209007, "chapter_id": 23209, "verse_number": "१-१२-८", "content_sanskrit": "वेत्स्यसे मां प्रसंख्यातं लोकधातारमीश्वरम्  ।\nततस्तस्य महात्मानश्चत्वारस्ते कुमारकाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003209008, "chapter_id": 23209, "verse_number": "१-१२-९", "content_sanskrit": "संबभूवुर्महात्मानो विशुद्धा ब्रह्मवर्चसः  ।\nविरजाश्च विबाहुश्च विशोको विश्वभावनः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003209009, "chapter_id": 23209, "verse_number": "१-१२-१०", "content_sanskrit": "ब्रह्मण्या ब्रह्मणस्तुल्या वीरा अध्यवसायिनः  ।\nरक्तांबरधराः सर्वे रक्तमाल्यानुलेपनाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003209010, "chapter_id": 23209, "verse_number": "१-१२-११", "content_sanskrit": "रक्तकुंकुमलिप्तांगा रक्तभस्मानुलेपनाः  ।\nततो वर्षसहस्रांते ब्रह्मत्वेध्यवसायिनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003209011, "chapter_id": 23209, "verse_number": "१-१२-१२", "content_sanskrit": "गृणंतश्च महात्मानो ब्रह्म तद्वामदैविकम्  ।\nअनुग्रहार्थं लोकानां शिष्याणां हितकाम्यया ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003209012, "chapter_id": 23209, "verse_number": "१-१२-१३", "content_sanskrit": "धर्मोपदेशमखिलं कृत्वा ते ब्रह्मणः प्रियाः  ।\nपुनरेव महादेवं प्रविष्टा रुद्रमव्ययम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003209013, "chapter_id": 23209, "verse_number": "१-१२-१४", "content_sanskrit": "येपि चान्ये द्विजश्रेष्ठा युंजाना वाममीश्वरम्  ।\nप्रपश्यंति महादेवं तद्भक्तास्तत्परायणाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003209014, "chapter_id": 23209, "verse_number": "१-१२-१५", "content_sanskrit": "ते सर्वे पापनिर्मुक्ता विमला ब्रह्मचारिणः  ।\nरुद्रलोकं गमिष्यंति पुनरावृत्तिदुर्लभम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]