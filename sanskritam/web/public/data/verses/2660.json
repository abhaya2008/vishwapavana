[{"id": 2078244, "chapter_id": 2660, "verse_number": "१२-१६५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2078245, "chapter_id": 2660, "verse_number": "१२-१६५-१", "content_sanskrit": "इत्युक्तवति भीष्मे तु तूष्णींभूते युधिष्ठिरः।\nपप्रच्छावसथं गत्वा भ्रातृन्विदुरपञ्चमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2078246, "chapter_id": 2660, "verse_number": "१२-१६५-२", "content_sanskrit": "धर्मे चार्थे च कामे च लोकवृत्तिः समाहिता।\nतेषां गरीयान्कतमो मध्यमः को लघुश्च कः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2078247, "chapter_id": 2660, "verse_number": "१२-१६५-३", "content_sanskrit": "कस्मिंश्चात्मा नियन्तव्यस्त्रिवर्गविजयाय वै।\nसंपृष्टा नैष्ठिकं वाक्यं यथाबद्वक्तुमर्हथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2078248, "chapter_id": 2660, "verse_number": "१२-१६५-४", "content_sanskrit": "ततोऽर्थगतितत्त्वज्ञः प्रथमं प्रतिभानवान्।\nजगाद विदुरो वाक्यं धर्मशास्त्रमनुस्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2078249, "chapter_id": 2660, "verse_number": "१२-१६५-५x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2078250, "chapter_id": 2660, "verse_number": "१२-१६५-५", "content_sanskrit": "बहुश्रुतं तपस्त्यागः श्रद्धा यज्ञक्रिया क्षमा।\nभावशुद्धिर्दया सत्यं संयमश्चात्मसंपदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2078251, "chapter_id": 2660, "verse_number": "१२-१६५-६", "content_sanskrit": "एतदेवाभिपद्यस्व मा ते भूच्चलितं मनः।\nएतन्मूलौ हि धर्मार्थावेतदेकपदं हितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2078252, "chapter_id": 2660, "verse_number": "१२-१६५-७", "content_sanskrit": "धर्मेणैवर्षयस्तीर्णा धर्मे लोकाः प्रतिष्ठिताः।\nधर्मेण देवा दिवि च धर्मे चार्थः समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2078253, "chapter_id": 2660, "verse_number": "१२-१६५-८", "content_sanskrit": "धर्मो राजन्गुणः श्रेष्ठो मध्यमो ह्यर्थ उच्यते।\nकामो यवीयानिति च प्रवदन्ति मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2078254, "chapter_id": 2660, "verse_number": "१२-१६५-९", "content_sanskrit": "तस्माद्धर्मप्रधानेन भवितव्यं यतात्मना।\nतथा च सर्वभूतेषु वर्तितव्यं यतात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2078255, "chapter_id": 2660, "verse_number": "१२-१६५-१०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2078256, "chapter_id": 2660, "verse_number": "१२-१६५-१०", "content_sanskrit": "समाप्तवचने तस्मिन्भीमकर्मा धनञ्जयः।\nततोऽर्थगतितत्त्वज्ञो जगौ वाक्यं प्रचोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2078257, "chapter_id": 2660, "verse_number": "१२-१६५-११", "content_sanskrit": "कर्मभूमिरियं राजन्निह वार्ता प्रशस्यते।\nकृषिर्वाणिज्यगोरक्षं शिल्पानि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2078258, "chapter_id": 2660, "verse_number": "१२-१६५-१२", "content_sanskrit": "अर्थ इत्येव सर्वेषां कर्मणामव्यतिक्रमः।\nनिवृत्तेऽर्थे न वर्तेते धर्मकामाविति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2078259, "chapter_id": 2660, "verse_number": "१२-१६५-१३", "content_sanskrit": "विषहेतार्थवान्धर्ममाराधयितुमुत्तमम्।\nकामं च चरितुं शक्तो दुष्प्रापमकृतात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2078260, "chapter_id": 2660, "verse_number": "१२-१६५-१४", "content_sanskrit": "अर्थस्यावयवावेतौ धर्मकामाविति श्रुतिः।\nअर्थसिद्ध्या विनिर्वृत्तावृभावेतौ भविष्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2078261, "chapter_id": 2660, "verse_number": "१२-१६५-१५", "content_sanskrit": "तद्गतार्थं हि पुरुषं विशिष्टतरयोनयः।\nब्रह्माणमिव भूतानि सततं पर्युपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2078262, "chapter_id": 2660, "verse_number": "१२-१६५-१६", "content_sanskrit": "जटाजिनधरा दान्ताः पङ्कदिग्धा जितेन्द्रियाः।\nमुण्डा निस्तन्तवश्चापि वसन्त्यर्थार्थिनः पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2078263, "chapter_id": 2660, "verse_number": "१२-१६५-१७", "content_sanskrit": "काषायवसनाश्चान्ये श्मश्रुला हि सुसंयताः।\nविद्वांसश्चैव शान्ताश्च मुक्ताः सर्वपरिग्रहैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2078264, "chapter_id": 2660, "verse_number": "१२-१६५-१८", "content_sanskrit": "`अर्थार्थिनः सन्ति नित्यं परितष्यन्ति कर्मभिः।\nअर्थार्थिनः सन्ति केचिदपरे स्वर्गकाङ्क्षिणः।\nकुलप्रत्यागमाश्चैके स्वंस्वं धर्ममनुष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2078265, "chapter_id": 2660, "verse_number": "१२-१६५-१९", "content_sanskrit": "आस्तिका नास्तिकाश्चैव नियताः संयमे परे।\nअप्रज्ञानं तमोभूतं प्रज्ञानं तु प्रकाशिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2078266, "chapter_id": 2660, "verse_number": "१२-१६५-२०", "content_sanskrit": "भृत्यान्भोगैर्द्विषो दण्डैर्यो योजयति सोऽर्थवान्।\nएतन्मतिमतांश्रेष्ठ मतं मम यथातथम्।\nअनयोस्तु विबोध त्वं वचनं शक्रकण्वयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2078267, "chapter_id": 2660, "verse_number": "१२-१६५-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2078268, "chapter_id": 2660, "verse_number": "१२-१६५-२१", "content_sanskrit": "तथा धर्मार्थकुशलौ माद्रीपुत्रावनन्तरम्।\nनकुलः सहदेवश्च वाक्यमूचतुरुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2078269, "chapter_id": 2660, "verse_number": "१२-१६५-२२", "content_sanskrit": "आसीनश्च शयानश्च विचरन्नपि वा स्थितः।\nअर्थयोगं दृढं कुर्याद्योगैरुच्चावचैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2078270, "chapter_id": 2660, "verse_number": "१२-१६५-२३", "content_sanskrit": "अस्मिंस्तु वै विनिर्वृत्ते दुर्लभे परमप्रिये।\nइह कामानवाप्नोति प्रत्यक्षं नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2078271, "chapter_id": 2660, "verse_number": "१२-१६५-२४", "content_sanskrit": "योऽर्थो धर्मेण संयुक्तो धर्मो यश्चार्थसंयुतः।\nमध्विवामृतसंसृष्टं तस्मादेतौ मताविह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2078272, "chapter_id": 2660, "verse_number": "१२-१६५-२५", "content_sanskrit": "अनर्थस्य न कामोस्ति तथाऽर्थोऽधर्मिणः कुतः।\nतस्मादुद्विजले लोको धर्मार्थाभ्यां बहिष्कृतात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2078273, "chapter_id": 2660, "verse_number": "१२-१६५-२६", "content_sanskrit": "तस्माद्धर्मप्रधानेन साध्योऽर्थः संयतात्मना।\nविश्वस्तेषु हि भूतेषु कल्पते सर्वमेव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2078274, "chapter_id": 2660, "verse_number": "१२-१६५-२७", "content_sanskrit": "धर्मं समाचरेत्पूर्वं ततोऽर्थं धर्मसंयुतम्।\nततः कामं चरेत्पश्चात्सिद्धार्थस्य हि तत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2078275, "chapter_id": 2660, "verse_number": "१२-१६५-२८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2078276, "chapter_id": 2660, "verse_number": "१२-१६५-२८", "content_sanskrit": "विरेमतुस्तु तद्वाक्यमुक्त्वा तावश्विनोः सुतौ।\nभीमसेनस्ततो वाक्यमिदं वक्तुं प्रचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2078277, "chapter_id": 2660, "verse_number": "१२-१६५-२९", "content_sanskrit": "नाकामः कामयत्यर्थं नाकामो धर्ममिच्छति।\nनाकामः कामयानोऽस्ति तस्मात्कामो विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2078278, "chapter_id": 2660, "verse_number": "१२-१६५-३०", "content_sanskrit": "कामेन युक्ता ऋषयस्तपस्येव समाहिताः।\nपलाशाः शाकमूलाशा वायुभक्षाः सुसंयताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2078279, "chapter_id": 2660, "verse_number": "१२-१६५-३१", "content_sanskrit": "वेदोपवेदेष्वपरे युक्ताः स्वाध्यायपारगाः।\nश्राद्धे यज्ञक्रियायां च तथा दानप्रतिग्रहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2078280, "chapter_id": 2660, "verse_number": "१२-१६५-३२", "content_sanskrit": "वणिजः कर्षका गोपाः कारवः शिल्पिनस्तथा।\nदेशधर्मकृतश्चैव युक्ताः कामेन कर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2078281, "chapter_id": 2660, "verse_number": "१२-१६५-३३", "content_sanskrit": "समुद्रं वा विशन्त्यन्ये नराः कामेन संयुताः।\nकामो हि विविधाकारः सर्वं कामेन संततम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2078282, "chapter_id": 2660, "verse_number": "१२-१६५-३४", "content_sanskrit": "नास्ति नासीन्न भविता भूतं काममृते परम्।\nएतत्सारं महाराज धर्मार्थावत्र संश्रितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2078283, "chapter_id": 2660, "verse_number": "१२-१६५-३५", "content_sanskrit": "नवनीतं यथा दध्नस्तथा कामोऽर्थधर्मतः।\nश्रेयस्तैलं न पिण्याको घृतं श्रेय उदश्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2078284, "chapter_id": 2660, "verse_number": "१२-१६५-३६", "content_sanskrit": "श्रेयः पुष्पफलं काष्ठात्कामो धर्मार्थयोर्वरः।\nपुष्पतो मध्विव परं कामात्संजायते सुखम्।\nकामो धर्मार्थयोर्योनिः कामश्चाथ तदात्मकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2078285, "chapter_id": 2660, "verse_number": "१२-१६५-३७", "content_sanskrit": "[नाकामतो ब्राह्मणाः स्वन्नमर्था\nन्नाकामतो ददति ब्राह्मणेभ्यः।\nनाकामतो विविधा लोकचेष्टा\nतस्मात्कामः प्राक् त्रिवर्गस्य दृष्टः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2078286, "chapter_id": 2660, "verse_number": "१२-१६५-३८", "content_sanskrit": "सुचारुवेषाभिरलंकृताभि\nर्मदोत्कटाभिः प्रियवादिनीभिः।\nरमस्व योषिद्भिरुपेत्य कामं\nकामो हि राजन्परमाभिरामः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2078287, "chapter_id": 2660, "verse_number": "१२-१६५-३९", "content_sanskrit": "बुद्धिर्ममैषा परिखास्थितस्य\nमाभूद्विचारस्तव धर्मपुत्र।\nस्वात्संहितं सद्भिरफल्गुसार\nमसस्तवाक्यं परमानृशंसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2078288, "chapter_id": 2660, "verse_number": "१२-१६५-४०", "content_sanskrit": "वर्मार्थकामाः सममेव सेव्या\nयो ह्येकभक्तः स नरो जघन्यः।\nद्वयोस्तु सक्तं प्रवदन्ति मध्यमं\nस उत्तमो योऽभिरतस्त्रिवर्गे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2078289, "chapter_id": 2660, "verse_number": "१२-१६५-४१", "content_sanskrit": "प्राज्ञः सुहृच्चन्दनसारलिप्तो\nविचित्रमाल्याभरणैरुपेतः।\nततो वचः संग्रहविस्तरेण\nप्रोक्त्वाऽथ वीरान्विरराम भीमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2078290, "chapter_id": 2660, "verse_number": "१२-१६५-४२", "content_sanskrit": "ततो मुहूर्तादथ धर्मराजो\nवाक्यानि तेषामनुचिन्त्य सम्यक्।\nउवाच वाचाऽवितथं स्मयन्वै\nबहुश्रुतो धर्मभृतां वरिष्ठः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2078291, "chapter_id": 2660, "verse_number": "१२-१६५-४३", "content_sanskrit": "निःसंशयं निश्चितसर्वशास्त्राः\nसर्वे भवन्तो विदितप्रमाणाः।\nविज्ञातुकामस्य ममेह वाक्य\nमुक्तं यद्वो नैष्ठिकं तच्छ्रुतं मे।\nइहानुवंशं गदतो ममापि\nवाक्यं निबोधध्वमनन्यभावाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2078292, "chapter_id": 2660, "verse_number": "१२-१६५-४४", "content_sanskrit": "यो वै न पापे निरतो न पुण्ये\nनार्थे न धर्मे मनुजो न कामे।\nविमुक्तदोषः समफल्गुसारो\nविमुच्यते दुःखसुखात्स सिद्धः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2078293, "chapter_id": 2660, "verse_number": "१२-१६५-४५", "content_sanskrit": "भूतानि जातीमरणान्वितानि\nजराविकारैश्च समन्वितानि।\nभूयश्च तैस्तैरुपसेवितानि\nमोक्षं प्रशंसन्ति न तं च विद्मः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2078294, "chapter_id": 2660, "verse_number": "१२-१६५-४६", "content_sanskrit": "स्नेहेन बद्धस्य न सन्ति तानि\nचैवं स्वयंभूर्भगवानुवाच।\nबोधाय निर्वाणपरा भवन्ति\nतस्मान्न कुर्यात्प्रियमप्रियं च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2078295, "chapter_id": 2660, "verse_number": "१२-१६५-४७", "content_sanskrit": "एतच्च मुख्यं न तु कामकारो\nयथा नियुक्तोऽस्मि तथा करोमि।\nभूतानि सर्वाणि विधिर्नियुङ्क्ते\nविधिर्बलीयानिति वित्त सर्वे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2078296, "chapter_id": 2660, "verse_number": "१२-१६५-४८", "content_sanskrit": "न कर्मणाऽप्नोत्यनवाप्यमर्थं\nयद्भावि तद्वै भवतीति विद्मः।\nत्रिवर्गहीनोऽपि हि विन्दतेऽर्थं\nतस्माददो लोकहिताय गुह्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2078297, "chapter_id": 2660, "verse_number": "१२-१६५-४९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2078298, "chapter_id": 2660, "verse_number": "१२-१६५-४९", "content_sanskrit": "तदग्र्यबुद्धेर्वचनं मनोनुगं\nसमस्तमाज्ञाय तथाहि हेतुमत्।\nतदा प्रणेदुश्च जहर्षिरे च ते\nकुरुप्रवीराय च चक्रिरेऽञ्जलिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2078299, "chapter_id": 2660, "verse_number": "१२-१६५-५०", "content_sanskrit": "सुचारुवर्णाक्षरशब्दभूषितां\nमनोनुगां निर्गतवाक्यकण्टकाम्।\nनिशम्य तां पार्थिवभाषितां गिरं\nपार्थस्य सर्वे प्रणता बभूवुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2078300, "chapter_id": 2660, "verse_number": "१२-१६५-५१", "content_sanskrit": "तथैव राजा प्रशशंस् वीर्यवान्\nपुनश्च पप्रच्छ सरिद्वरासुतम्।\nधर्मार्थकामेषु विनिश्चयज्ञं\nततः परं धर्ममहीनचेतसम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2078301, "chapter_id": 2660, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि पञ्चषष्ट्यधिकशततमोऽध्यायः॥ १६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]