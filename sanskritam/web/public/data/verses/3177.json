[{"id": 2101171, "chapter_id": 3177, "verse_number": "१४-३३-१", "content_sanskrit": "ब्राह्मणि उवाच।\nअत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nब्राह्मणस्य च संवादं जनकस्य च भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101172, "chapter_id": 3177, "verse_number": "१४-३३-२", "content_sanskrit": "ब्राह्मणं जनको राजा सन्नं कस्मिंश्चिदागसि।\nविषये मे न वस्तव्यमिति शिष्ट्यर्थमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101173, "chapter_id": 3177, "verse_number": "१४-३३-३", "content_sanskrit": "इत्युक्तः प्रत्युवाचाथ ब्राह्मणो राजसत्तमम्।\nआचक्ष्व विषयं राजन्यावांस्तव वशे स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101174, "chapter_id": 3177, "verse_number": "१४-३३-४", "content_sanskrit": "सोऽन्यस्य विषये राज्ञो वस्तुमिच्छाम्यहं विभो।\nवचस्ते कर्तुमिच्छामि यथाशास्त्रं महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101175, "chapter_id": 3177, "verse_number": "१४-३३-५", "content_sanskrit": "इत्युक्तस्तु तदा राजा ब्राह्मणेन यशस्विना।\nमुहुरुष्णं विनिःस्वस्य न किञ्चित्प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101176, "chapter_id": 3177, "verse_number": "१४-३३-६", "content_sanskrit": "तमासीनं ध्यायमानं राजानममितौजसम्।\nकश्मलं सहसाऽगच्छद्भानुमन्तमिव ग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101177, "chapter_id": 3177, "verse_number": "१४-३३-७", "content_sanskrit": "समाश्वास्य ततो राजा विगते कश्यमे तदा।\nततो मूहूर्तादिव तं ब्राह्मणं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101178, "chapter_id": 3177, "verse_number": "१४-३३-८", "content_sanskrit": "पितृपैतामहे राज्ये वश्ये जनपदे सति।\nविषयं नाधिगच्छामि विचिन्वन्पृथिवीमहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101179, "chapter_id": 3177, "verse_number": "१४-३३-९", "content_sanskrit": "नाध्यगच्छं यदा पृथ्व्यां मिथिला मार्गिता मया।\nनाध्यगच्छं यदा तस्यां स्वप्रजा मार्गिता मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101180, "chapter_id": 3177, "verse_number": "१४-३३-१०", "content_sanskrit": "नाध्यगच्छं यदा तस्यां तदा मे कश्मलोऽभवत्।\nततो मे कश्मलस्यान्ते मतिः पुनरुपस्थिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101181, "chapter_id": 3177, "verse_number": "१४-३३-११", "content_sanskrit": "तदा न विषयं मन्ये सर्वो वा विषयो मम।\nआत्माऽपि चायं न मम सर्वा वा पृथिवी मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101182, "chapter_id": 3177, "verse_number": "१४-३३-१२", "content_sanskrit": "यथा मम तथाऽन्येषामिति मन्ये द्विजोत्तम।\nउष्यतां यावदुत्साहो भुज्यतां यावदिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101183, "chapter_id": 3177, "verse_number": "१४-३३-१३x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101184, "chapter_id": 3177, "verse_number": "१४-३३-१३", "content_sanskrit": "पितृपैतामहे राज्ये वश्ये जनपदे सति।\nब्रूहि कां मतिमास्थाय ममत्वं वर्जितं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101185, "chapter_id": 3177, "verse_number": "१४-३३-१४", "content_sanskrit": "कां वै बुद्धिं समाश्रित्य सर्वो वै विषयस्तव।\nनावैषि विषयं येन सर्वो वा विषयस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101186, "chapter_id": 3177, "verse_number": "१४-३३-१५x", "content_sanskrit": "जनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101187, "chapter_id": 3177, "verse_number": "१४-३३-१५", "content_sanskrit": "अन्तवन्त इहारम्भा विदिताः सर्वकर्मसु।\nनाध्यगच्छमहं तस्मान्ममेदमिति यद्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101188, "chapter_id": 3177, "verse_number": "१४-३३-१६", "content_sanskrit": "कस्येदमिति कस्य स्वमिति वेदवचस्तथा।\nनाध्यगच्छमहं बुद्ध्या ममेदमिति यद्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2101189, "chapter_id": 3177, "verse_number": "१४-३३-१७", "content_sanskrit": "एतां बुद्धिं समाश्रित्य ममत्वं वर्जितं मया।\nशृणु बुद्धिं च यां ज्ञात्वा सर्वत्र विषयो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2101190, "chapter_id": 3177, "verse_number": "१४-३३-१८", "content_sanskrit": "नाहमात्मार्थमिच्छामि गन्धान्घ्राणगतानपि।\nतस्मान्मे निर्जिता भूमिर्वशे तिष्ठति नित्यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2101191, "chapter_id": 3177, "verse_number": "१४-३३-१९", "content_sanskrit": "नाहमात्मार्थमिच्छामि रसानास्येऽपि वर्ततः।\nआपो मे निर्जितास्तस्माद्वशे तिष्ठन्ति नित्यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2101192, "chapter_id": 3177, "verse_number": "१४-३३-२०", "content_sanskrit": "नाहमात्मार्थमिच्छामि रूपं ज्योतिश्च चक्षुषः।\nतस्मान्मे निर्जितं ज्योतिर्वशे तिष्ठति नित्यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2101193, "chapter_id": 3177, "verse_number": "१४-३३-२१", "content_sanskrit": "नाहमात्मार्थमिच्छामि स्पर्शांस्त्वचि गताश्च ये।\nतस्मान्मे निर्जितो वायुर्वशे तिष्ठति नित्यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2101194, "chapter_id": 3177, "verse_number": "१४-३३-२२", "content_sanskrit": "नाहमात्मार्थमिच्छामि शब्दाञ्श्रोत्रगतानपि।\nआकाशं मे जितं तस्माद्वशे तिष्ठति नित्यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2101195, "chapter_id": 3177, "verse_number": "१४-३३-२३", "content_sanskrit": "नाहमात्मार्थमिच्छामि मनो नित्यं मनोन्तरे।\nमनो मे निर्जितं तस्माद्वशे तिष्ठति नित्यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2101196, "chapter_id": 3177, "verse_number": "१४-३३-२४", "content_sanskrit": "देवेभ्यश्च पितृभ्यश्च भूतेभ्योऽतिथिभिः सह।\nइत्यर्थं सर्व एवेति समारम्भा भवन्ति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2101197, "chapter_id": 3177, "verse_number": "१४-३३-२५", "content_sanskrit": "ततः प्रहस्य जनकं ब्राह्मणः पुनरब्रवीत्।\nत्वज्जिज्ञासार्थमद्येह विद्धि मां धर्ममागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2101198, "chapter_id": 3177, "verse_number": "१४-३३-२६", "content_sanskrit": "त्वमस्य ब्रह्मिनाभस्य दुर्वारस्यानिवर्तिनः।\nसत्वनेमिनिरुद्धस्य चक्रस्यैकः प्रवर्तकः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2101199, "chapter_id": 3177, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि त्र्यस्त्रिंशोऽध्यायः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]