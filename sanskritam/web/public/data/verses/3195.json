[{"id": 2101710, "chapter_id": 3195, "verse_number": "१४-५१-१", "content_sanskrit": "ब्रह्मोवाच।\nभूतानामथ पञ्चानामथेषामीश्वरं मनः।\nनियमे च विसर्गे च भूतानां मन एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101711, "chapter_id": 3195, "verse_number": "१४-५१-२", "content_sanskrit": "अधिष्ठातृमनो नित्यं भूतानां महतां तथा।\nबुद्धिरैश्वर्यमाचष्टे क्षेत्रज्ञश्च स उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101712, "chapter_id": 3195, "verse_number": "१४-५१-३", "content_sanskrit": "इनद्रियाणि मनो युङ्क्ते सदश्वानिव सारथिः।\nइन्द्रियाणि मनो बुद्धिः क्षेत्रज्ञे युज्यते सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101713, "chapter_id": 3195, "verse_number": "१४-५१-४", "content_sanskrit": "महदश्वसमायुक्तं बुद्धिसंयमनं रथम्।\nसमारुह्य स भूतात्मा समन्तात्परिधावति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101714, "chapter_id": 3195, "verse_number": "१४-५१-५", "content_sanskrit": "इन्द्रियग्रामसंयुक्तो मनःसारथिरेव च।\nबुद्धिसंयमनो नित्यं महान्ब्रह्ममयो रथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101715, "chapter_id": 3195, "verse_number": "१४-५१-६", "content_sanskrit": "एवं यो वेत्ति विद्वान्वै सदा ब्रह्ममयं रथम्।\nस धीरः सर्वलोकेषु न मोहमधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101716, "chapter_id": 3195, "verse_number": "१४-५१-७", "content_sanskrit": "अव्यक्तादिविशेषान्तं सहस्थावरजङ्गमम्॥\nसूर्यचन्द्रप्रभालोकं ग्रहनक्षत्रमण्डितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101717, "chapter_id": 3195, "verse_number": "१४-५१-८", "content_sanskrit": "नदीपर्वतजालैश्च सर्वतः परिभूषितम्।\nविविधाभिस्तथा चाद्भिः सततं समलंकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101718, "chapter_id": 3195, "verse_number": "१४-५१-९", "content_sanskrit": "अजितं सर्वभूतानां सर्वप्राणभृतां गतिः।\nएतद्ब्रह्मवनं नित्यं तस्मिंश्चरति क्षेत्रवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101719, "chapter_id": 3195, "verse_number": "१४-५१-१०", "content_sanskrit": "लोकेऽस्मिन्यानि सत्वानि त्रसानि स्थावराणि च।\nतान्येवाग्रे प्रलीयन्ते पश्चाद्भूतकृता गुणाः।\nगुणेभ्यः पञ्च भूतानि एष भूतसमुच्छ्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101720, "chapter_id": 3195, "verse_number": "१४-५१-११", "content_sanskrit": "देवा मनुष्या गन्धर्वाः पिशाचासुरराक्षसाः।\nसर्वे स्वभावतः सृष्टा न क्रियाभ्यो न कारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101721, "chapter_id": 3195, "verse_number": "१४-५१-१२", "content_sanskrit": "एते विश्वसृजो विप्रा जायन्तीह पुनः पुनः।\nतेभ्यः प्रसूतास्तेष्वेव महाभूतेषु पञ्चसु।\nप्रलीयन्ते यथाकालमूर्मयः सागरे यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101722, "chapter_id": 3195, "verse_number": "१४-५१-१३", "content_sanskrit": "विश्वसृग्भ्यस्तु भूतेभ्यो महाभूतास्तु सर्वशः।\nभूतेब्यश्चापि पञ्चभ्यो भुक्तो गच्छेत्परां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101723, "chapter_id": 3195, "verse_number": "१४-५१-१४", "content_sanskrit": "प्रजापतिरिदं सर्वं मनसैवासृजत्प्रभुः।\nतथैव देवानृषयस्तपसा प्रतिपेदिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101724, "chapter_id": 3195, "verse_number": "१४-५१-१५", "content_sanskrit": "तपसश्चानुपूर्व्येण फलमूलाशिनस्तथा।\nत्रैलोक्यं तपसा सिद्धाः पश्यन्तीह समाहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101725, "chapter_id": 3195, "verse_number": "१४-५१-१६", "content_sanskrit": "औषधान्यगदादीनि नानाविद्याश्च सर्वशः।\nतपसैव प्रसिद्ध्यन्ति तपोमूलं हि साधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101726, "chapter_id": 3195, "verse_number": "१४-५१-१७", "content_sanskrit": "यद्दुरापं दुराम्नायं दुराधर्षं दुरन्वयम्।\nतत्सर्वं तपसा साध्यं तपो हि दुरतिक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101727, "chapter_id": 3195, "verse_number": "१४-५१-१८", "content_sanskrit": "सुरापो ब्रह्महा स्तेनो भ्रूणहागुरुतल्पगः।\nतपसैव सुतप्तेन मुच्यते किल्बिषात्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2101728, "chapter_id": 3195, "verse_number": "१४-५१-१९", "content_sanskrit": "मनुष्याः पितरो देवाः पशवो मृगपक्षिणः।\nयानि चान्यानि भूतानि चराणि स्थावराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2101729, "chapter_id": 3195, "verse_number": "१४-५१-२०", "content_sanskrit": "तपःपरायणा नित्यं सिद्ध्यन्ते तपसा सदा।\nतथैव तपसा देवा महाभागा दिवं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2101730, "chapter_id": 3195, "verse_number": "१४-५१-२१", "content_sanskrit": "आशीर्युक्तानि कर्माणि कुर्वते ये त्वतन्द्रिताः।\nअहङ्कारसमायुक्तास्ते सकाशे प्रजापतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2101731, "chapter_id": 3195, "verse_number": "१४-५१-२२", "content_sanskrit": "ध्यानयोगेन शुद्वेन निर्ममा निरहंकृताः।\nआप्नुवन्ति महात्मानो महान्तं लोकमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2101732, "chapter_id": 3195, "verse_number": "१४-५१-२३", "content_sanskrit": "ध्यानयोगमुपागम्य प्रसन्नमतयः सदा।\nसुखोपचयमव्यक्तं प्रविशन्त्यात्मवित्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2101733, "chapter_id": 3195, "verse_number": "१४-५१-२४", "content_sanskrit": "ध्यानयोगादुपागम्य निर्ममा निरहंकृताः।\nअव्यक्तं प्रविशन्तीह महतां लोकमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2101734, "chapter_id": 3195, "verse_number": "१४-५१-२५", "content_sanskrit": "अव्यक्तादेव सम्भूताः समयज्ञा गताः पुनः।\nतमोरजोभ्यां निर्मुक्ताः सत्वमास्थाय केवलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2101735, "chapter_id": 3195, "verse_number": "१४-५१-२६", "content_sanskrit": "निर्मुक्तः सर्वपापेभ्यः सर्वं त्यजति निष्कलः।\nक्षेत्रज्ञ इति तं विद्याद्यस्तं वेद स वेदवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2101736, "chapter_id": 3195, "verse_number": "१४-५१-२७", "content_sanskrit": "चित्तं चित्तादुपागम्य मुनिरासीत संयतः।\nयच्चित्तस्तन्मना भूत्वा ग्राह्यमेतत्सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2101737, "chapter_id": 3195, "verse_number": "१४-५१-२८", "content_sanskrit": "अव्यक्तादिविशेषान्तमविद्यालक्षणं स्मृतम्।\nनिबोधत तथा ज्ञानं गुणैर्लक्षणमित्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2101738, "chapter_id": 3195, "verse_number": "१४-५१-२९", "content_sanskrit": "द्व्यक्षरस्तु भवेन्मृत्युस्त्र्यक्षरं ब्रह्म शाश्वतम्।\nममेति च भवेन्मृत्युर्न ममेति च शाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2101739, "chapter_id": 3195, "verse_number": "१४-५१-३०", "content_sanskrit": "कर्म केचित्प्रशंसन्ति मन्दबुद्धितया नराः।\nये तु वृद्धा महात्मानो न प्रशंसन्ति कर्म ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2101740, "chapter_id": 3195, "verse_number": "१४-५१-३१", "content_sanskrit": "कर्मणा जायते जन्तुर्मूर्तिमान्षोडशात्मकः।\nपुरुषं ग्रसते विद्या तद्ग्राह्यममृताशिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2101741, "chapter_id": 3195, "verse_number": "१४-५१-३२", "content_sanskrit": "तस्मात्कर्मसु निःस्नेहा ये केचित्पारदर्शिनः।\nविद्यामयोऽयं पुरुषो न तु कर्ममयः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2101742, "chapter_id": 3195, "verse_number": "१४-५१-३३", "content_sanskrit": "य एवममृतं नित्यमग्राह्यं शश्वदक्षरम्॥\nवश्यात्मानमसंश्लिष्टं यो वेद न मृतो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2101743, "chapter_id": 3195, "verse_number": "१४-५१-३४", "content_sanskrit": "अपूर्वमकृतं नित्यं य एनमविचारिणम्।\nय एवं विन्देदात्मानमग्राह्यममृताशनम्।\nअग्राह्यो ह्यमृतो भवति स एभिः कारणैर्ध्रुवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2101744, "chapter_id": 3195, "verse_number": "१४-५१-३५", "content_sanskrit": "आयोज्य सर्वसंस्कारान्संयम्यात्मानमात्मनि।\nस तद्ब्रह्म शुभं वेत्ति यस्माद्भूयो न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2101745, "chapter_id": 3195, "verse_number": "१४-५१-३६", "content_sanskrit": "प्रसादे चैव सत्वस्य प्रसादं समवाप्नुयात्।\nलक्षणं हि प्रसादस्य यथा स्यात्स्वप्नदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2101746, "chapter_id": 3195, "verse_number": "१४-५१-३७", "content_sanskrit": "गतिरेषा तु मुक्तानां ये ज्ञानपरिनिष्ठिताः।\nप्रवृत्तयश्च याः सर्वाः पश्यन्ति परिणामजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2101747, "chapter_id": 3195, "verse_number": "१४-५१-३८", "content_sanskrit": "एषा गतिर्विरक्तानामेष धर्मः सनातनः।\nएषा ज्ञानवतां प्राप्तिरेतद्वृत्तमनिन्दितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2101748, "chapter_id": 3195, "verse_number": "१४-५१-३९", "content_sanskrit": "समेन सर्वभूतेषु निस्पृहेण निराशिषा।\nशक्या गतिरियं गन्तुं सर्वत्र समदर्शिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2101749, "chapter_id": 3195, "verse_number": "१४-५१-४०", "content_sanskrit": "एतद्वः सर्वमाख्यातं मया विप्रर्षिसत्तमाः।\nएवमाचरत क्षिप्रं ततः सिद्धिमवाप्स्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2101750, "chapter_id": 3195, "verse_number": "१४-५१-४१x", "content_sanskrit": "गुरुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2101751, "chapter_id": 3195, "verse_number": "१४-५१-४१", "content_sanskrit": "इत्युक्तास्ते तु मुनयो गुरुणा ब्रह्मणा तथा।\nकृतवन्तो महात्मानस्ततो लोकमवाप्नुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2101752, "chapter_id": 3195, "verse_number": "१४-५१-४२", "content_sanskrit": "त्वमप्येतन्महाभाग मयोक्तं ब्रह्मणो वचः।\nसम्यगाचर शुद्धात्भंस्ततः सिद्धिमवाप्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2101753, "chapter_id": 3195, "verse_number": "१४-५१-४३x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2101754, "chapter_id": 3195, "verse_number": "१४-५१-४३", "content_sanskrit": "इत्युक्तः स तदा शिष्यो गुरुणा धर्ममुत्तमम्।\nचकार सर्वं कौन्तेय ततो मोक्षमवाप्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2101755, "chapter_id": 3195, "verse_number": "१४-५१-४४", "content_sanskrit": "कृतकृत्यश्च स तदा शिष्यः कुरुकुलोद्वह।\nतत्पदं समनुप्राप्तो यत्र गत्वा न शोचति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2101756, "chapter_id": 3195, "verse_number": "१४-५१-४५x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2101757, "chapter_id": 3195, "verse_number": "१४-५१-४५", "content_sanskrit": "को न्वसौ ब्राह्मणः कृष्ण कश्च शिष्यो जनार्दन।\nश्रोतव्यं चेन्मयैतद्वै तत्त्वमाचक्ष्व मे विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2101758, "chapter_id": 3195, "verse_number": "१४-५१-४६x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2101759, "chapter_id": 3195, "verse_number": "१४-५१-४६", "content_sanskrit": "अहं गुरुर्महाबाहो मनः शिष्य च विद्धि मे।\nत्वत्प्रीत्या गुह्यमेतच्च कथितं ते धनंजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2101760, "chapter_id": 3195, "verse_number": "१४-५१-४७", "content_sanskrit": "मयि चेदस्ति ते प्रीतिर्नित्यं कुरुकुलोद्वह।\nअध्यात्ममेतच्छ्रुत्वा त्वं सम्यगाचर सुव्रत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2101761, "chapter_id": 3195, "verse_number": "१४-५१-४८", "content_sanskrit": "ततस्त्वं सम्यगाचीर्णो धर्मेऽस्मिन्नरिकर्शन।\nसर्वपापविनिर्मुक्तो मोक्षं प्राप्स्यसि केवलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2101762, "chapter_id": 3195, "verse_number": "१४-५१-४९", "content_sanskrit": "पूर्वमप्येतदेवोक्तं युद्धकाल उपस्थिते।\nमया तव महाबाहो तस्मादत्र मनः कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2101763, "chapter_id": 3195, "verse_number": "१४-५१-५०", "content_sanskrit": "मया तु भरतश्रेष्ठ चिरदृष्टः पिता प्रभुः।\nतमहं द्रष्टमिच्छामि सम्मते तव फल्गुन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2101764, "chapter_id": 3195, "verse_number": "१४-५१-५१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2101765, "chapter_id": 3195, "verse_number": "१४-५१-५१", "content_sanskrit": "इत्युक्तवचनं कृष्णं प्रत्युवाच धनंजयः।\n`यदिष्टं कुरु सर्वेषामीश्वरोऽस्मान्प्रपालय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2101766, "chapter_id": 3195, "verse_number": "१४-५१-५२", "content_sanskrit": "नमस्ते सर्वलोकात्मन्नारायण परात्पर।\nमनोमलात्तपोशक्यं कर्म चाविद्यया हतम्।\nदानमप्यर्थदोषेणि नाम तस्मात्कलौ स्मरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2101767, "chapter_id": 3195, "verse_number": "१४-५१-५३", "content_sanskrit": "यदि गन्तुं कृता बुद्धिर्वासुदेव नमोस्तु ते।\nगच्छावो नगरं कृष्ण गजसाह्वयमद्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2101768, "chapter_id": 3195, "verse_number": "१४-५१-५४", "content_sanskrit": "समेत्य तत्रि राजानं धर्मात्मानं युधिष्ठिरम्।\nसमनुज्ञाप्य राजानं स्वां पुरीं यातुमर्हसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2101769, "chapter_id": 3195, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि एकपञ्चाशोऽध्यायः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]