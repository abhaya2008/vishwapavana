[{"id": 7000939000, "chapter_id": 20939, "verse_number": "१-१-१", "content_sanskrit": "श्रीसूत उवाच ।\nॐ पराशरं मुनिवरं कृतपौर्वाह्णिकक्रियम् ।\nमैत्रेयः परिपप्रच्छ प्रणिपत्याभिवाद्य च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000939001, "chapter_id": 20939, "verse_number": "१-१-२", "content_sanskrit": "त्वत्तो हि वेदाध्ययनमधीतमखिलं गुरो ।\nधर्मशास्त्राणि सर्वाणि तथांगनि यथाक्रमम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000939002, "chapter_id": 20939, "verse_number": "१-१-३", "content_sanskrit": "त्वत्प्रसादान्मुनिश्रेष्ठ मानन्ये नाकृतश्रमम् ।\nवक्ष्यन्ति सर्वशास्त्रेषु प्रायशो येऽपि विद्विषः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000939003, "chapter_id": 20939, "verse_number": "१-१-४", "content_sanskrit": "सोऽहमिच्छामि धर्मज्ञ श्रोतुं त्वत्तो यथा जगत् ।\nबभूत भूयश्र्च यथा महाभाग भविष्यति ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000939004, "chapter_id": 20939, "verse_number": "१-१-५", "content_sanskrit": "यन्मयं च जगद्बह्मन्यतश्चैतच्चराचरम् ।\nलीनमासीद्यथा यत्र लयमेष्यति यत्र च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000939005, "chapter_id": 20939, "verse_number": "१-१-६", "content_sanskrit": "यत्प्रमाणानि भूतानि देवादीनां च सम्भवम् ।\nसमुद्रपर्वतानां च संस्थानं च यथा भुवः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000939006, "chapter_id": 20939, "verse_number": "१-१-७", "content_sanskrit": "सूर्यादीनां च संस्थानं प्रमाणं मुनिसत्तम ।\nदेवादीनां तथा वंशान्मनून्मन्वन्तराणि च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000939007, "chapter_id": 20939, "verse_number": "१-१-८", "content_sanskrit": "कल्पान् कल्पविभागांश्च चातुर्युगविकल्पितान् ।\nकल्पान्तस्य स्वरूपं च युगधर्माश्च कृत्स्नशः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000939008, "chapter_id": 20939, "verse_number": "१-१-९", "content_sanskrit": "देवर्षिपार्थिवानां च चरितं यन्महामुने ।\nवेदशाखाप्रणयनं यथावद्व्‌यासकर्तृकम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000939009, "chapter_id": 20939, "verse_number": "१-१-१०", "content_sanskrit": "धर्माश्च ब्राह्मणादीनां तथा चाश्रमवासिनाम् ।\nश्रोतुमिच्छाम्यहं सर्वं त्वृत्तो वासिष्ठनन्दन ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000939010, "chapter_id": 20939, "verse_number": "१-१-११", "content_sanskrit": "ब्रह्मन्प्रसादप्रवणं कुरुष्व मयि मानसम् ।\nयेनाहमेतज्जानीयां त्वत्प्रसादान्महामुने ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000939011, "chapter_id": 20939, "verse_number": "१-१-१२", "content_sanskrit": "श्रीपराशर उवाच ।\nसाधु मैत्रेय धर्मज्ञ स्मारितोऽस्मि पुरातनम् ।\nपितुः पिता मे भगवान् वसिष्ठो यदुवाच ह ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000939012, "chapter_id": 20939, "verse_number": "१-१-१३", "content_sanskrit": "विश्वामित्रप्रयुक्तेन रक्षसा भक्षितः पुरा ।\nश्रुतस्तातस्ततः क्रोधो मैत्रेयाभून्ममातुलः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000939013, "chapter_id": 20939, "verse_number": "१-१-१४", "content_sanskrit": "ततोऽहं रक्षसां सत्रं विनाशाय समारभम् ।\nभस्मीभूताश्च शतशस्तस्मिन्सत्रे निशाचराः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000939014, "chapter_id": 20939, "verse_number": "१-१-१५", "content_sanskrit": "ततः सड्‌क्षीयमाणेषु तेषु रक्षस्स्वशेषतः ।\nमामुवाच महाभागो वसिष्ठो मत्पितामहः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000939015, "chapter_id": 20939, "verse_number": "१-१-१६", "content_sanskrit": "अलमत्यन्तकोपेन तात मन्युमिमं जहि ।\nराक्षसा नापराध्यन्ति पितुस्ते विहितं हि तत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000939016, "chapter_id": 20939, "verse_number": "१-१-१७", "content_sanskrit": "मूढानामेव भवति क्रोधो ज्ञानवतां कृतः ।\nहन्यते तात कः केन यतः स्वकृतभुक्पुमान् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000939017, "chapter_id": 20939, "verse_number": "१-१-१८", "content_sanskrit": "सत्र्चितस्यापि महता वत्स क्लेशेन मानवैः ।\nयशसस्तपसश्र्चैव क्रोधो नाशकरः परः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000939018, "chapter_id": 20939, "verse_number": "१-१-१९", "content_sanskrit": "स्वर्गापवर्गव्यासेधकारणं परमर्षयः ।\nवर्जयन्ति सदा क्रोधं तात मा तद्वशो भव ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000939019, "chapter_id": 20939, "verse_number": "१-१-२०", "content_sanskrit": "अलं निशाचरैर्दग्धैदीनैरनपकारिभिः ।\nसत्रं ते विरमत्वेतत्क्षमासारा हि साधवः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000939020, "chapter_id": 20939, "verse_number": "१-१-२१", "content_sanskrit": "एवं तातेन तेनाहमनुनीतो महात्मना ।\nउपसंहृतवान्सत्रं सद्यस्तद्वाक्यगौरवात् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000939021, "chapter_id": 20939, "verse_number": "१-१-२२", "content_sanskrit": "ततः प्रीतः स भगवान्वसिष्ठो मुनिसत्तमः ।\nसम्प्राप्तश्च तदा तत्र पुलस्त्यो ब्रह्मणः सुतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000939022, "chapter_id": 20939, "verse_number": "१-१-२३", "content_sanskrit": "पितामहेन दत्तार्घ्यः कृतासनपरिग्रहः ।\nमामुवाच महाभागो मैत्रेय पुलहाग्रजः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000939023, "chapter_id": 20939, "verse_number": "१-१-२४", "content_sanskrit": "वैरे महति यद्दाक्याद्‌गुरोरद्याश्रिता क्षमा ।\nत्वया तस्मात्समस्तानि भवात्र्च्छास्त्राणि वेत्स्यति ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000939024, "chapter_id": 20939, "verse_number": "१-१-२५", "content_sanskrit": "सन्ततेर्न ममोच्छेदः क्रुद्धेनापि यतः कृतः ।\nत्वया तस्मान्महाभाग ददाम्यन्यं महावरम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000939025, "chapter_id": 20939, "verse_number": "१-१-२६", "content_sanskrit": "पुराणसंहिताकर्ता भवान्वत्स भविष्यति ।\nदेवतापारमार्थ्यं च यथावद्वेत्स्यते भवान् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000939026, "chapter_id": 20939, "verse_number": "१-१-२७", "content_sanskrit": "प्रवृत्ते च निवृत्ते च कर्मण्यस्तमला मतिः ।\nमत्प्रसादादसन्दिग्धा तव वत्स भविष्यति ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000939027, "chapter_id": 20939, "verse_number": "१-१-२८", "content_sanskrit": "ततश्च प्राह भगवान्वसिष्ठो मे पितामहः ।\nपुलस्त्येन यदुक्तं ते सर्वमेतद्भविष्यति ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000939028, "chapter_id": 20939, "verse_number": "१-१-२९", "content_sanskrit": "इति पूर्वं वसिष्ठेन पुलस्त्येन च धीमता ।\nयदुक्तं तत्स्मृतिं याति त्वत्प्रश्नादखिलं मम ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000939029, "chapter_id": 20939, "verse_number": "१-१-३०", "content_sanskrit": "सोऽहं वदाम्यशेषं ते मैत्रेय परिपृच्छते ।\nपुराणसंहितां सम्यक् तां निबोध यथातथम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000939030, "chapter_id": 20939, "verse_number": "१-१-३१", "content_sanskrit": "विष्णोः सकाशादुद्भूतं जगत्तत्रैव च स्थितम् ।\nस्थितिसंयमकर्ताऽसौ जगतोऽस्य जगच्च सः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]