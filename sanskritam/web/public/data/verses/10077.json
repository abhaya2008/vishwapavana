[{"id": 6000077000, "chapter_id": 10077, "verse_number": null, "content_sanskrit": "अथ त्रयोदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000077001, "chapter_id": 10077, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.001.m4a", "display_order": 2}, {"id": 6000077002, "chapter_id": 10077, "verse_number": "४-१३-१", "content_sanskrit": "निशम्य कौषारविणोपवर्णितं ध्रुवस्य वैकुण्ठपदाधिरोहणम्।\nप्ररूढभावो भगवत्यधोक्षजे प्रष्टुं पुनस्तं विदुरः प्रचक्रमे॥ ४/१३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.002.m4a", "display_order": 3, "topics": [{"text": "ध्रुवपुत्रस्य उत्कलस्य वैराग्यम्", "range": "१–१०"}]}, {"id": 6000077003, "chapter_id": 10077, "verse_number": null, "content_sanskrit": "विदुर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.003.m4a", "display_order": 4}, {"id": 6000077004, "chapter_id": 10077, "verse_number": "४-१३-२", "content_sanskrit": "के ते प्रचेतसो नाम कस्यापत्यानि सुव्रत।\nकस्यान्ववाये प्रख्याताः कुत्र वा सत्रमासत॥ ४/१३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.004.m4a", "display_order": 5}, {"id": 6000077005, "chapter_id": 10077, "verse_number": "४-१३-३", "content_sanskrit": "मन्ये महाभागवतं नारदं देवदर्शनम्।\nयेन प्रोक्तः क्रियायोगः परिचर्याविधिर्हरेः॥ ४/१३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.005.m4a", "display_order": 6}, {"id": 6000077006, "chapter_id": 10077, "verse_number": "४-१३-४", "content_sanskrit": "स्वधर्मशीलैः पुरुषैर्भगवान् पुरुषोत्तमः।\nइज्यमानो भक्तिमता नारदेनेरितः किल॥ ४/१३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.006.m4a", "display_order": 7}, {"id": 6000077007, "chapter_id": 10077, "verse_number": "४-१३-५", "content_sanskrit": "यास्ता देवर्षिणा तत्र वर्णिता भगवत्कथाः।\nमह्यं शुश्रूषवे ब्रह्मन् कार्त्स्न्येनाचष्टुमर्हसि॥ ४/१३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.007.m4a", "display_order": 8}, {"id": 6000077008, "chapter_id": 10077, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.008.m4a", "display_order": 9}, {"id": 6000077009, "chapter_id": 10077, "verse_number": "४-१३-६", "content_sanskrit": "ध्रुवस्य चोत्कलः पुत्रः पितरि प्रस्थिते वनम्।\nसार्वभौमश्रियं नैच्छदधिराजासनं पितुः॥ ४/१३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.009.m4a", "display_order": 10}, {"id": 6000077010, "chapter_id": 10077, "verse_number": "४-१३-७", "content_sanskrit": "स जन्मनोपशान्तात्मा निःसङ्गः समदर्शनः।\nददर्श लोके विततमात्मानं लोकमात्मनि॥ ४/१३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.010.m4a", "display_order": 11}, {"id": 6000077011, "chapter_id": 10077, "verse_number": "४-१३-८", "content_sanskrit": "आत्मानं ब्रह्म निर्वाणं प्रत्यस्तमितविग्रहम्।\nअवबोधरसैकात्म्यमानन्दमनुसन्ततम्॥ ४/१३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.011.m4a", "display_order": 12}, {"id": 6000077012, "chapter_id": 10077, "verse_number": "४-१३-९", "content_sanskrit": "अव्यवच्छिन्नयोगाग्निदग्धकर्ममलाशयः।\nस्वरूपमवरुन्धानो नान्यदस्मात् तदैक्षत॥ ४/१३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.012.m4a", "display_order": 13}, {"id": 6000077013, "chapter_id": 10077, "verse_number": "४-१३-१०", "content_sanskrit": "जडान्धबधिरोन्मत्तमूकाकृतिरतन्मतिः।\nलक्षितः पथि बालानां प्रशान्तार्चिरिवानलः॥ ४/१३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.013.m4a", "display_order": 14}, {"id": 6000077014, "chapter_id": 10077, "verse_number": "४-१३-११", "content_sanskrit": "मत्वा तं जडमुन्मत्तं कुलवृद्धाः समन्त्रिणः।\nवत्सरं भूपतिं चक्रुर्यवीयांसं भ्रमेः सुतम्॥ ४/१३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.014.m4a", "display_order": 15, "topics": [{"text": "ततो ध्रुववंशकथनप्रसङ्गेन तद्वंश्यस्य अङ्गराजस्य वेननामकपुत्रोत्पत्तिकथनम्", "range": "११–४०"}]}, {"id": 6000077015, "chapter_id": 10077, "verse_number": "४-१३-१२", "content_sanskrit": "स्वर्वीथिर्वत्सरस्येष्टा भार्याऽसूत षडात्मजान्।\nपुष्पार्णं तिग्मकेतुं च इषमूर्जं वसुं जयम्॥ ४/१३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.015.m4a", "display_order": 16}, {"id": 6000077016, "chapter_id": 10077, "verse_number": "४-१३-१३", "content_sanskrit": "पुष्पार्णस्य प्रभा भार्या दोषा च द्वे बभूवतुः।\nप्रातर्मध्यन्दिनं सायमिति ह्यासन् प्रभासुताः॥ ४/१३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.016.m4a", "display_order": 17}, {"id": 6000077017, "chapter_id": 10077, "verse_number": "४-१३-१४", "content_sanskrit": "प्रदोषो निशिथो व्युष्ट इति दोषासुतास्‍त्रयः।\nव्युष्टः सुतं पुष्करिण्यां सर्वतेजसमादधे॥ ४/१३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.017.m4a", "display_order": 18}, {"id": 6000077018, "chapter_id": 10077, "verse_number": "४-१३-१५", "content_sanskrit": "स चक्षुः सुतमाकूत्यां पत्न्यां मनुमवाप ह।\nमनोरसूत महिषी वैराजा नड्वला सुतान्॥ ४/१३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.018.m4a", "display_order": 19}, {"id": 6000077019, "chapter_id": 10077, "verse_number": "४-१३-१६", "content_sanskrit": "पुरुकुत्सं त्रितं द्युम्नं सत्यव्रतमृतव्रतम्।\nअग्निष्टोममतीरात्रं सुद्युम्नं शिबिमुल्मुकम्॥ ४/१३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.019.m4a", "display_order": 20}, {"id": 6000077020, "chapter_id": 10077, "verse_number": "४-१३-१७", "content_sanskrit": "उल्मुकोऽजनयत् पुत्रान् पुष्करिण्यां षडुत्तमान्।\nअङ्गं सुनासमाख्यातिं क्रतुमाङ्गिरसं गयम्॥ ४/१३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.020.m4a", "display_order": 21}, {"id": 6000077021, "chapter_id": 10077, "verse_number": "४-१३-१८", "content_sanskrit": "सुनीथाऽङ्गस्य या पत्नी सुषुवे वेनमुल्बणम्।\nयद्दौःशील्यात् स राजर्षिर्निर्विण्णो निरगात् पुरात्॥ ४/१३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.021.m4a", "display_order": 22}, {"id": 6000077022, "chapter_id": 10077, "verse_number": "४-१३-१९", "content_sanskrit": "यमङ्ग शेपुः कुपिता वाग्वज्रा मुनयः किल।\nगतासोस्तस्य भूयस्ते ममन्थुर्दक्षिणं करम्॥ ४/१३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.022.m4a", "display_order": 23}, {"id": 6000077023, "chapter_id": 10077, "verse_number": "४-१३-२०", "content_sanskrit": "अराजके तदा लोके दस्युभिः पीडिताः प्रजाः।\nजातो नारायणांशेन पृथुः पृथुपराक्रमः॥ ४/१३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.023.m4a", "display_order": 24}, {"id": 6000077024, "chapter_id": 10077, "verse_number": null, "content_sanskrit": "विदुर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.024.m4a", "display_order": 25}, {"id": 6000077025, "chapter_id": 10077, "verse_number": "४-१३-२१", "content_sanskrit": "तस्य शीलनिधेः साधोर्ब्रह्मण्यस्य महात्मनः।\nराज्ञः कथमभूद् दुष्टा प्रजा यद्विमना ययौ॥ ४/१३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.025.m4a", "display_order": 26}, {"id": 6000077026, "chapter_id": 10077, "verse_number": "४-१३-२२", "content_sanskrit": "किं चांहो वेनमुद्दिश्य ब्रह्मदण्डमयूयुजन्।\nदण्डव्रतधरे राज्ञि मुनयो धर्मकोविदाः॥ ४/१३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.026.m4a", "display_order": 27}, {"id": 6000077027, "chapter_id": 10077, "verse_number": "४-१३-२३", "content_sanskrit": "नावध्येयः प्रजापालः प्रजाभिरघवानपि।\nयदसौ लोकपालानां बिभर्त्योजः स्वतेजसा॥ ४/१३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.027.m4a", "display_order": 28}, {"id": 6000077028, "chapter_id": 10077, "verse_number": "४-१३-२४", "content_sanskrit": "एतदाख्याहि मे ब्रह्मन् सुनीथात्मजचेष्टितम्।\nश्रद्धधानाय भक्ताय त्वं परावरवित्तमः॥ ४/१३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.028.m4a", "display_order": 29}, {"id": 6000077029, "chapter_id": 10077, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.029.m4a", "display_order": 30}, {"id": 6000077030, "chapter_id": 10077, "verse_number": "४-१३-२५", "content_sanskrit": "अङ्गोऽश्वमेधं राजर्षिराजहार महाक्रतुम्।\nनाजग्मुर्देवतास्तस्मिन्नाहूता ब्रह्मवादिभिः॥ ४/१३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.030.m4a", "display_order": 31}, {"id": 6000077031, "chapter_id": 10077, "verse_number": "४-१३-२६", "content_sanskrit": "तमूचुर्विस्मितास्तात यजमानमथर्त्विजः।\nहवींषि हूयमानानि न ते गृह्णन्ति देवताः॥ ४/१३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.031.m4a", "display_order": 32}, {"id": 6000077032, "chapter_id": 10077, "verse_number": "४-१३-२७", "content_sanskrit": "राजन् हवींष्यदुष्टानि श्रद्धयाऽऽसादितानि ते।\nछन्दांस्ययातयामानि योजितानि धृतव्रतैः॥ ४/१३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.032.m4a", "display_order": 33}, {"id": 6000077033, "chapter_id": 10077, "verse_number": "४-१३-२८", "content_sanskrit": "न विदामेह देवानां हेलनं वयमण्वपि।\nयन्न गृह्णन्ति भागान् स्वान् ये देवाः कर्मसाक्षिणः॥ ४/१३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.033.m4a", "display_order": 34}, {"id": 6000077034, "chapter_id": 10077, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.034.m4a", "display_order": 35}, {"id": 6000077035, "chapter_id": 10077, "verse_number": "४-१३-२९", "content_sanskrit": "अङ्गो द्विजवचः श्रुत्वा यजमानः सुदुर्मनाः।\nतत् प्रष्टुं व्यसृजद् वाचं सदस्यांस्तदनुज्ञया॥ ४/१३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.035.m4a", "display_order": 36}, {"id": 6000077036, "chapter_id": 10077, "verse_number": "४-१३-३०", "content_sanskrit": "नागच्छन्त्याहुता देवा न गृह्णन्ति ग्रहानिह।\nसदसस्पतयो ब्रूत किमवद्यं मया कृतम्॥ ४/१३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.036.m4a", "display_order": 37}, {"id": 6000077037, "chapter_id": 10077, "verse_number": null, "content_sanskrit": "सदस्या ऊचुः —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.037.m4a", "display_order": 38}, {"id": 6000077038, "chapter_id": 10077, "verse_number": "४-१३-३१", "content_sanskrit": "नरदेवेह भवतो नावद्यं हि मनाक् स्थितम्।\nअस्त्येकं प्राक्तनमघं यदिहेदृक् त्वमप्रजः॥ ४/१३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.038.m4a", "display_order": 39}, {"id": 6000077039, "chapter_id": 10077, "verse_number": "४-१३-३२", "content_sanskrit": "तथा साधय भद्रं त आत्मानं सुप्रजं नृप।\nइष्टस्ते पुत्रकामस्य पुत्रं दास्यति यज्ञभुक्॥ ४/१३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.039.m4a", "display_order": 40}, {"id": 6000077040, "chapter_id": 10077, "verse_number": "४-१३-३३", "content_sanskrit": "यथा स्वभागधेयानि ग्रहीष्यन्ति दिवौकसः।\nयद् यज्ञपुरुषः साक्षादपत्याय हरिर्वृतः॥ ४/१३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.040.m4a", "display_order": 41}, {"id": 6000077041, "chapter_id": 10077, "verse_number": "४-१३-३४", "content_sanskrit": "तांस्तान् कामान् हरिर्दद्याद् यान् यान् कामयते जनः।\nआराधितो यथैवैष यथा पुंसां फलोदयः॥ ४/१३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.041.m4a", "display_order": 42}, {"id": 6000077042, "chapter_id": 10077, "verse_number": "४-१३-३५", "content_sanskrit": "इति व्यवसिता विप्रास्तस्य राज्ञः प्रजातये।\nपुरोडाशं निरवपन् शिपिविष्टाय विष्णवे॥ ४/१३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.042.m4a", "display_order": 43}, {"id": 6000077043, "chapter_id": 10077, "verse_number": "४-१३-३६", "content_sanskrit": "तस्मात् पुरुष उत्तस्थौ हेममाल्यमलाम्बरः।\nहिरण्मयेन पात्रेण सिद्धमादाय पायसम्॥ ४/१३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.043.m4a", "display_order": 44}, {"id": 6000077044, "chapter_id": 10077, "verse_number": "४-१३-३७", "content_sanskrit": "स विप्रानुमतो राजा गृहीत्वाऽञ्जलिनोदनम्।\nअवघ्राय मुदा युक्तः प्रादात् पत्न्या उदारधीः॥ ४/१३/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.044.m4a", "display_order": 45}, {"id": 6000077045, "chapter_id": 10077, "verse_number": "४-१३-३८", "content_sanskrit": "सा तत् पुंसवनं राज्ञी प्राश्यर्तौ पत्युरादधे।\nततः काल उपावृत्ते कुमारं सुषुवेऽप्रजा॥ ४/१३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.045.m4a", "display_order": 46}, {"id": 6000077046, "chapter_id": 10077, "verse_number": "४-१३-३९", "content_sanskrit": "स बाल एव पुरुषो मातामहमनुव्रतः।\nअधर्मांशोद्भवं मृत्युं तेनाभवदधार्मिकः॥ ४/१३/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.046.m4a", "display_order": 47}, {"id": 6000077047, "chapter_id": 10077, "verse_number": "४-१३-४०", "content_sanskrit": "स शरासनमुद्यम्य मृगयुर्वनगोचरः।\nहन्त्यसाधुर्मृगान् दीनान् वेनोऽसावित्यरौज्जनः॥ ४/१३/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.047.m4a", "display_order": 48}, {"id": 6000077048, "chapter_id": 10077, "verse_number": "४-१३-४१", "content_sanskrit": "आक्रीडे क्रीडतो बालान् वयस्यानतिदारुणः।\nप्रसह्य निरनुक्रोशः पशुमारममारयत्॥ ४/१३/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.048.m4a", "display_order": 49, "topics": [{"text": "स्वपुत्रदौश्शील्य-निर्विष्णेनाङ्गराजेन इतरालक्षितं वनगमनम्", "range": "४१–४९"}]}, {"id": 6000077049, "chapter_id": 10077, "verse_number": "४-१३-४२", "content_sanskrit": "तं विलक्ष्य खलं पुत्रं शासनैर्विविधैर्नृपः।\nयदा न शासितुं कल्पो भृशमासीत् सुदुर्मनाः॥ ४/१३/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.049.m4a", "display_order": 50}, {"id": 6000077050, "chapter_id": 10077, "verse_number": "४-१३-४३", "content_sanskrit": "प्रायेणाभ्यर्चितो देवो येऽप्रजा गृहमेधिनः।\nकदपत्यकृतं दुःखं ये न विन्दन्ति दुर्भरम्॥ ४/१३/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.050.m4a", "display_order": 51}, {"id": 6000077051, "chapter_id": 10077, "verse_number": "४-१३-४४", "content_sanskrit": "यतः पापीयसी कीर्तिरधर्मश्च महान् नृणाम्।\nयतो विरोधः सर्वेषां यत आधिरनन्तकः॥ ४/१३/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.051.m4a", "display_order": 52}, {"id": 6000077052, "chapter_id": 10077, "verse_number": "४-१३-४५", "content_sanskrit": "कस्तं प्रजापदेशं वै मोहं बन्धनमात्मनः।\nपण्डितो बहुमन्येत यदर्थाः क्लेशदा गृहाः॥ ४/१३/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.052.m4a", "display_order": 53}, {"id": 6000077053, "chapter_id": 10077, "verse_number": "४-१३-४६", "content_sanskrit": "कदपत्यं वरं मन्ये सदपत्याच्छुचां पदात्।\nनिर्विद्येत गृहान्मर्त्यो यत् क्लेशनिवहा गृहाः॥ ४/१३/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.053.m4a", "display_order": 54}, {"id": 6000077054, "chapter_id": 10077, "verse_number": "४-१३-४७", "content_sanskrit": "एवं स निर्विण्णमना नृपो गृहान्निशीथ उत्थाय महोदयोदयात्।\nअलब्धनिद्रोऽनुपलक्षितो नृभिर्हित्वा गतो वेनसुवं प्रसुप्ताम्॥ ४/१३/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.054.m4a", "display_order": 55}, {"id": 6000077055, "chapter_id": 10077, "verse_number": "४-१३-४८", "content_sanskrit": "विज्ञाय निर्विद्य गतं पतिं प्रजाः पुरोहितामात्यसुहृद्गणादयः।\nविचिक्युरुर्व्यामतिशोककातरा यथा निगूढं पुरुषं कुयोगिनः॥ ४/१३/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.055.m4a", "display_order": 56}, {"id": 6000077056, "chapter_id": 10077, "verse_number": "४-१३-४९", "content_sanskrit": "अलक्षयन्तः पदवीं प्रजापतेर्हतोद्यमाः प्रत्युपसृत्य ते पुरीम्।\nऋषीन् समेतानभिवन्द्य साश्रवो न्यवेदयन् पौरव भर्तृविप्लवम्॥ ४/१३/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_013/BhP_04.013.056.m4a", "display_order": 57}, {"id": 6000077057, "chapter_id": 10077, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे त्रयोदशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]