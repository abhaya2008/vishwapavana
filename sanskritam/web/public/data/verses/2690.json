[{"id": 2079353, "chapter_id": 2690, "verse_number": "१२-१९५-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2079354, "chapter_id": 2690, "verse_number": "१२-१९५-१", "content_sanskrit": "गतीनामुत्तमा प्राप्तिः कथिता जापकेष्विह।\nएकैवैषा गतिस्तेषामुत यान्त्यपरामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2079355, "chapter_id": 2690, "verse_number": "१२-१९५-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2079356, "chapter_id": 2690, "verse_number": "१२-१९५-२", "content_sanskrit": "शृणु वहितो राजञ्जापकानां गतिं विभो।\nयथा गच्छन्ति निरयमनेकं पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2079357, "chapter_id": 2690, "verse_number": "१२-१९५-३", "content_sanskrit": "यथोक्तमेतत्पूर्वं यो नानुतिष्ठति जापकः॥\nएकदेशक्रियश्चात्र निरयं स निगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2079358, "chapter_id": 2690, "verse_number": "१२-१९५-४", "content_sanskrit": "अवमानेन कुरुते न तुष्यति न शोचति।\nईदृशो जापको याति निरयं नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2079359, "chapter_id": 2690, "verse_number": "१२-१९५-५", "content_sanskrit": "अहंकारकृतश्चैव सर्वे निरयग्रामिनः।\nपरावमानी पुरुषो भविता निरयोपगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2079360, "chapter_id": 2690, "verse_number": "१२-१९५-६", "content_sanskrit": "अभिध्यापूर्वकं जप्यं कुरुते यश्च मोहितः।\nयत्रास्य रागः पतति तत्रतत्रोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2079361, "chapter_id": 2690, "verse_number": "१२-१९५-७", "content_sanskrit": "अथैश्वर्यप्रसक्तः सञ्जापको यत्र रज्यते।\nस एव निरयस्तस्य नासौ तस्मात्प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2079362, "chapter_id": 2690, "verse_number": "१२-१९५-८", "content_sanskrit": "रागेण जापको जप्यं कुरुते यश्च मोहितः।\nयत्रास्य रागः पतति तत्र तत्रोपजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2079363, "chapter_id": 2690, "verse_number": "१२-१९५-९", "content_sanskrit": "दुर्बुद्धिरकृतप्रज्ञश्चले मनसि तिष्ठति।\nफलस्यापचितिं याति निरयं चाधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2079364, "chapter_id": 2690, "verse_number": "१२-१९५-१०", "content_sanskrit": "अकृतव्रज्ञको बालो मोहं गच्छति जापकः।\nस मोहान्निरयं याति यत्र गत्वाऽनुशोचति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2079365, "chapter_id": 2690, "verse_number": "१२-१९५-११", "content_sanskrit": "दृढग्राही करोमीति जाप्यं जपति जापकः।\nन संपूर्णो न वा युक्तो निरयं सोऽधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2079366, "chapter_id": 2690, "verse_number": "१२-१९५-१२", "content_sanskrit": "अनिमित्तं परं यत्तदव्यक्तं ब्रह्मणि स्थितम्।\nतद्भूतो जापकः कस्मात्सशरीरमिहाविशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2079367, "chapter_id": 2690, "verse_number": "१२-१९५-१३", "content_sanskrit": "दुष्प्रज्ञानेन निरया बहवः समुदाहृताः।\nप्रशस्तं जापकत्वं च दोषाश्चैते तदात्मकाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2079368, "chapter_id": 2690, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि पञ्चनवत्यधिकशततमोऽध्यायः॥ १९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]