[{"id": 7002138000, "chapter_id": 22138, "verse_number": "१८३-१", "content_sanskrit": "अग्निरुवाच ।\nवक्ष्ये व्रतानि चाष्टम्यां रोहिण्यां प्रथमं व्रतं ।\nमासि भाद्रपदेऽष्टभ्यां रोहिण्यामर्धरात्रके ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002138001, "chapter_id": 22138, "verse_number": "१८३-२", "content_sanskrit": "कृष्णो जातो यतस्तस्यां जयन्ती स्यात्ततोऽष्टमी ।\nसप्तजन्मकृतात्पापात्मुच्यते चोपवासतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002138002, "chapter_id": 22138, "verse_number": "१८३-३", "content_sanskrit": "कृष्णपक्षे भाद्रपदे अष्टम्यां रोहिणीयुते ।\nउपाषितोर्चयेत्कृष्णं भुक्तिमुक्तिप्रदायकं ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002138003, "chapter_id": 22138, "verse_number": "१८३-४", "content_sanskrit": "आवाहयाम्यहं कृष्णं बलभद्रञ्च देवकीं ।\nवसुदेवं यशोदाङ्गाः पूजयामि नमोऽस्तु ते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002138004, "chapter_id": 22138, "verse_number": "१८३-५", "content_sanskrit": "योगाय योगपतये योगेशाय नमो नमः ।\nयोगादिसम्भावयैव गोविन्दाय नमो नमः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002138005, "chapter_id": 22138, "verse_number": "१८३-६", "content_sanskrit": "स्नानं कृष्णाय दद्यात्तु अर्घ्यं चानेन दापयेत् ।\nयज्ञाय यज्ञेश्वराय यज्ञानां पतये नमः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002138006, "chapter_id": 22138, "verse_number": "१८३-७", "content_sanskrit": "यज्ञादिसंभवायैव गोविन्दाय नमो नमः ।\nगृहाण देव पुष्पाणि सुगन्धीनि प्रियाणि ते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002138007, "chapter_id": 22138, "verse_number": "१८३-८", "content_sanskrit": "सर्वकामप्रदो देव भव मे देववन्दित ।\nधूपधूपित धूपं त्वं धूपितैस्त्वं गृहाण मे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002138008, "chapter_id": 22138, "verse_number": "१८३-९", "content_sanskrit": "सुगन्ध धूपगन्धाढ्यं कुरु मां सर्वदा हरे ।\nदीपदीप्त महादीपं दीपदीप्तद सर्वदा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002138009, "chapter_id": 22138, "verse_number": "१८३-१०", "content_sanskrit": "मया दत्तं गृहाण त्वं कुरु चोर्ध्वगतिं च मां ।\nविश्वाय विश्वपतये विश्वेशाय नमो नमः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002138010, "chapter_id": 22138, "verse_number": "१८३-११", "content_sanskrit": "विश्वादिसम्भवायैव गोविन्दाय निवेदितं ।\nधर्माय धर्मपतये दर्मेशाय नमो नमः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002138011, "chapter_id": 22138, "verse_number": "१८३-१२", "content_sanskrit": "धर्मादिसम्भवायैव गोविन्दशयनं कुरु ।\nसर्वाय सर्वपतये सर्वेशाय नमो नमः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002138012, "chapter_id": 22138, "verse_number": "१८३-१३", "content_sanskrit": "सर्वादिसम्भवायैव गोविन्दाय च पावनं ।\nक्षीरोदार्णवसम्भूत अत्रिनेत्रसमुद्भव ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002138013, "chapter_id": 22138, "verse_number": "१८३-१४", "content_sanskrit": "गृहाणार्घ्यं शशाङ्केदं रोहिण्या सहितो मम ।\nस्थण्डिले स्थापयेद्देवं सचन्द्रां रोहिणीं यजेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002138014, "chapter_id": 22138, "verse_number": "१८३-१५", "content_sanskrit": "देवकीं वसुदेवं च यशोदां नन्दकं बलं ।\nअर्धरात्रे परोधाराः पातयेद्गुडसर्पिषा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002138015, "chapter_id": 22138, "verse_number": "१८३-१६", "content_sanskrit": "वस्त्रहेमादिकं दद्याद्ब्राह्मणान् भोजयेद्व्रती ।\nजन्माष्टमीव्रतकरः पुत्रवान्विष्णुलोकभाक् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002138016, "chapter_id": 22138, "verse_number": "१८३-१७", "content_sanskrit": "वर्षे वर्षे तु यः कुर्यात्पुत्रार्थी वेत्ति नो भयं ।\nपुत्रान् देहि धनं देहि आयुरारोग्यसन्ततिं ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]