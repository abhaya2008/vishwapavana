[{"id": 2013916, "chapter_id": 1287, "verse_number": "२-२८-१", "content_sanskrit": "वैशम्पायन उवाच।\nएवमुक्तः प्रत्युवाच भगदत्तं धनञ्जयः।\nअनेनैव कृतं सर्वं भविष्यत्यनुजानता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2013917, "chapter_id": 1287, "verse_number": "२-२८-२", "content_sanskrit": "तं विजित्य महाबाहुः कुन्तीपुत्रो धनञ्जयः।\nप्रययावुत्तरां तस्माद्दिशं धनदपालिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2013918, "chapter_id": 1287, "verse_number": "२-२८-३", "content_sanskrit": "अन्तर्गिरिं च कौन्तेयस्तथैव च बहिर्गिरिम्।\nतथैवोपगिरं चैव विजिग्ये पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2013919, "chapter_id": 1287, "verse_number": "२-२८-४", "content_sanskrit": "विजित्य पर्वतान्सर्वान्ये च तत्र नराधिपाः।\nतान्वशे स्थापयित्वा स धनान्यादाय सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2013920, "chapter_id": 1287, "verse_number": "२-२८-५", "content_sanskrit": "तैरेव सहितः सर्वैरनुरज्य च तान्नुपान्।\nउलूकवासिनं राजन्बृहन्तमुपजग्मिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2013921, "chapter_id": 1287, "verse_number": "२-२८-६", "content_sanskrit": "मृदङ्गवरनादेन रथनेमिस्वनेन च।\nहस्तिनां च निनादेन कम्पयन्वसुधामिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2013922, "chapter_id": 1287, "verse_number": "२-२८-७", "content_sanskrit": "ततो बृहन्तस्त्वरितो बलेन चतुरङ्गिणा।\nनिष्क्रम्य नगरात्तस्माद्योधयामास फाल्गुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2013923, "chapter_id": 1287, "verse_number": "२-२८-८", "content_sanskrit": "सुमहान्सन्निपातोऽभूद्धनञ्जयबृहन्तयोः।\nन शशाक बृहन्तस्तु सोढुं पाण्डवविक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2013924, "chapter_id": 1287, "verse_number": "२-२८-९", "content_sanskrit": "सोऽविषह्यतमं मत्वा कौन्तेयं पर्वतेश्वरः।\nउपावर्तत दुर्धर्षो रत्नान्यादाय सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2013925, "chapter_id": 1287, "verse_number": "२-२८-१०", "content_sanskrit": "स तद्राज्यमवस्थाप्य उलूकसहितो ययौ।\nसेनाबिन्दुमथो राजन्राज्यादाशु समाक्षिपत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2013926, "chapter_id": 1287, "verse_number": "२-२८-११", "content_sanskrit": "मोदापुरं वामवेदं सुदामानं सुसङ्कुलम्।\nउलूकानुत्तरांश्चैव तांश्च राज्ञः समानयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2013927, "chapter_id": 1287, "verse_number": "२-२८-१२", "content_sanskrit": "तत्रस्थः पुरुषैरेव धर्मराजस्य शासनात्।\nकिरीटी जितवान्राजन्देशान्पञ्चगणांस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2013928, "chapter_id": 1287, "verse_number": "२-२८-१३", "content_sanskrit": "स देवप्रस्थमासाद्य सेनाबिन्दोः पुरं प्रति।\nबलेन चतुरङ्गेण निवेशमकरोत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2013929, "chapter_id": 1287, "verse_number": "२-२८-१४", "content_sanskrit": "स तैः परिवृतः सर्वैर्विष्वगश्वं नराधिपम्॥\nअभ्यगच्छन्महातेजाः पौरवं पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2013930, "chapter_id": 1287, "verse_number": "२-२८-१५", "content_sanskrit": "विजित्य चाहवे शूरान्पार्वतीयान्महारथान्।\nजिगाय सेनया राजन्पुरं पौरवरक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2013931, "chapter_id": 1287, "verse_number": "२-२८-१६", "content_sanskrit": "पौरवं युधि निर्जित्य दस्यून्पर्वतवासिनः।\nगणानुत्सवसङ्केतानजयत्सप्त पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2013932, "chapter_id": 1287, "verse_number": "२-२८-१७", "content_sanskrit": "ततः काश्मीरकान्वीरान्क्षत्रियान्क्षत्रियर्षभः।\nव्यजयल्लोहितं चैव मण्डलैर्दशभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2013933, "chapter_id": 1287, "verse_number": "२-२८-१८", "content_sanskrit": "ततस्त्रिगर्ताः कौन्तेयं दार्वाः कोकनदास्तथा।\nक्षत्रिया बहवो राजन्नुपावर्तन्त सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2013934, "chapter_id": 1287, "verse_number": "२-२८-१९", "content_sanskrit": "अभिसारीं ततो रम्यां विजिग्ये कुरुनन्दनः।\nउरगावासिनं रम्यं रोचमानं रणेऽजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2013935, "chapter_id": 1287, "verse_number": "२-२८-२०", "content_sanskrit": "ततः सिंहपुरं रम्यं चित्रायुधसुरक्षितम्।\nप्राधमद्बलमास्थाय पाकशासनिराहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2013936, "chapter_id": 1287, "verse_number": "२-२८-२१", "content_sanskrit": "ततः सुह्यांश्च चोलांश्च किरीटी पाण्डवर्षभः।\nसहितः सर्वसैन्येन प्रामथत्कुरुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2013937, "chapter_id": 1287, "verse_number": "२-२८-२२", "content_sanskrit": "ततः परमविक्रान्तो बाह्लीकान्पाकशासनिः।\nमहता परिमर्देन वशे चक्रे दुरासदान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2013938, "chapter_id": 1287, "verse_number": "२-२८-२३", "content_sanskrit": "गृहीत्वा तु बलं सारं फल्गुनः पाण्डुनन्दनः।\nदरदान्सहकाम्भोजैरजयत्पाकशासनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2013939, "chapter_id": 1287, "verse_number": "२-२८-२४", "content_sanskrit": "प्रागुत्तरं दिशं ये च वसन्त्याश्रित्य दस्यवः।\nनिवसन्ति वने ये च तान्सर्वानजयत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2013940, "chapter_id": 1287, "verse_number": "२-२८-२५", "content_sanskrit": "लोहान्परमकाम्भोजानृषिकानुत्तरानपि।\nसहितांस्तान्महाराज व्यजयत्पाकशासनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2013941, "chapter_id": 1287, "verse_number": "२-२८-२६", "content_sanskrit": "ऋषिकेष्वपि सङ्ग्रामे बभूवातिभयङ्करः।\nतारकामयसङ्काशः परस्त्वृषिकपार्थयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2013942, "chapter_id": 1287, "verse_number": "२-२८-२७", "content_sanskrit": "स विजित्य ततो राजन्नृषिकान्रणमूर्धनि।\nशुकोदरसमांस्तत्र हयानष्टौ समानयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2013943, "chapter_id": 1287, "verse_number": "२-२८-२८", "content_sanskrit": "मयूरसदृशानन्यानुत्तरानपरानपि।\nजवनानाशुगांश्चैव करार्थं समुपानयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2013944, "chapter_id": 1287, "verse_number": "२-२८-२९", "content_sanskrit": "स विनिर्जित्य सङ्ग्रामे हिमवन्तं सनिष्कृटम्।\nश्वेतपर्वतमासाद्य न्यविशत्पुरुषर्षभः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2013945, "chapter_id": 1287, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि दिग्विजयपर्वणि अष्टाविंशोध्यायः॥ २८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]