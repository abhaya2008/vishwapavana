[{"id": 40007380, "chapter_id": 9007, "verse_number": "1", "content_sanskrit": "खरं तु विरथं रामो गदापाणिमवस्थितम्। मृदुपूर्वं महातेजाः परुषं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40007381, "chapter_id": 9007, "verse_number": "2", "content_sanskrit": "गजाश्वरथसम्बाधे बले महति तिष्ठता। कृतं सुदारुणं कर्म सर्वलोकजुगुप्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40007382, "chapter_id": 9007, "verse_number": "3", "content_sanskrit": "उद्वेजनीयो भूतानां नृशंसः पापकर्मकृत्। त्रयाणामपि लोकानामीश्वरोऽपि न तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40007383, "chapter_id": 9007, "verse_number": "4", "content_sanskrit": "कर्म लोकविरुद्धं तु कुर्वाणं क्षणदाचर। तीक्ष्णं सर्वजनो हन्ति सर्पं दुष्टमिवागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40007384, "chapter_id": 9007, "verse_number": "5", "content_sanskrit": "लोभात्पापानि कुर्वाणः कामाद्वा यो न बुध्यते। भ्रष्टः पश्यति तस्यान्तं ब्राह्मणी करकादिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40007385, "chapter_id": 9007, "verse_number": "6", "content_sanskrit": "वसतो दण्डकारण्ये तापसान्धर्मचारिणः। किन्नु हत्वा महाभागान्फलं प्राप्स्यसि राक्षस ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40007386, "chapter_id": 9007, "verse_number": "7", "content_sanskrit": "न चिरं पापकर्माणः क्रूरा लोकजुगुप्सिताः। ऐश्वर्यं प्राप्य तिष्ठन्ति शीर्णमूला इव द्रुमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40007387, "chapter_id": 9007, "verse_number": "8", "content_sanskrit": "अवश्यं लभते जन्तुः फलं पापस्य कर्मणः। घोरं पर्यागते काले द्रुमाः पुष्पमिवार्तवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40007388, "chapter_id": 9007, "verse_number": "9", "content_sanskrit": "नचिरात्प्राप्यते लोके पापानां कर्मणां फलम्। सविषाणामिवान्नानां भुक्तानां क्षणदाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40007389, "chapter_id": 9007, "verse_number": "10", "content_sanskrit": "पापमाचरतां घोरं लोकस्याप्रियमिच्छताम्। अहमासादितो राजा प्राणान्हन्तुं निशाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40007390, "chapter_id": 9007, "verse_number": "11", "content_sanskrit": "अद्य हि त्वां मया मुक्ताश्शराः काञ्चनभूषणाः। विदार्यातिपतिष्यन्ति वल्मीकमिव पन्नगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40007391, "chapter_id": 9007, "verse_number": "12", "content_sanskrit": "ये त्वया दण्डकारण्ये भक्षिता धर्मचारिणः। तानद्य निहतस्सङ्ख्ये ससैन्योऽनुगमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40007392, "chapter_id": 9007, "verse_number": "13", "content_sanskrit": "अद्य त्वां निहतं बाणैः पश्यन्तु परमर्षयः। निरयस्थं विमानस्था ये त्वया हिंसिताः पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40007393, "chapter_id": 9007, "verse_number": "14", "content_sanskrit": "प्रहर त्वं यथाकामं कुरु यत्नं कुलाधम। अद्य ते पातयिष्यामि शिरस्तालफलं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40007394, "chapter_id": 9007, "verse_number": "15", "content_sanskrit": "एवमुक्तस्तु रामेण कृद्धस्संरक्तलोचनः। प्रत्युवाच खरो रामं प्रहसन्क्रोधमूर्छितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40007395, "chapter_id": 9007, "verse_number": "16", "content_sanskrit": "प्राकृतान्राक्षसान्हत्वा युद्धे दशरथात्मज। आत्मना कथमात्मानमप्रशस्यं प्रशंससि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40007396, "chapter_id": 9007, "verse_number": "17", "content_sanskrit": "विक्रान्ता बलवन्तो वा ये भवन्ति नरर्षभाः। कथयन्ति न ते किञ्चित्तेजसा स्वेन गर्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40007397, "chapter_id": 9007, "verse_number": "18", "content_sanskrit": "प्राकृतास्त्वकृतात्मानो लोके क्षत्रियपांसनाः। निरर्थकं विकत्थन्ते यथा राम विकत्थसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40007398, "chapter_id": 9007, "verse_number": "19", "content_sanskrit": "कुलं व्यपदिशन्वीरस्समरे कोऽभिधास्यति। मृत्युकाले हि सम्प्राप्ते स्वयमप्रस्तवे स्तवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40007399, "chapter_id": 9007, "verse_number": "20", "content_sanskrit": "सर्वथैव लघुत्वं ते कत्थनेन विदर्शितम्। सुवर्णप्रतिरूपेण तप्तेनेव कुशाग्निना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40007400, "chapter_id": 9007, "verse_number": "21", "content_sanskrit": "न तु मामिह तिष्ठन्तं पश्यसि त्वं गदाधरम्। धराधरमिवाकम्प्यं पर्वतं धातुभिश्चितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40007401, "chapter_id": 9007, "verse_number": "22", "content_sanskrit": "पर्याप्तोऽहं गदापाणिर्हन्तुं प्राणान्रणे तव। त्रयाणामपि लोकानां पाशहस्त इवान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40007402, "chapter_id": 9007, "verse_number": "23", "content_sanskrit": "कामं बह्वपि वक्तव्यं त्वयि वक्ष्यामि न त्वहम्। अस्तं गच्छेद्धि सविता युद्धविघ्नस्ततो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40007403, "chapter_id": 9007, "verse_number": "24", "content_sanskrit": "चतुर्दश सहस्राणि राक्षसानां हतानि ते। त्वद्विनाशात्करोम्येषां तेषामश्रुप्रमार्जनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40007404, "chapter_id": 9007, "verse_number": "25", "content_sanskrit": "इत्युक्त्वा परमक्रुद्धस्तां गदां परमाङ्गदः। खरश्चिक्षेप रामाय प्रदीप्तामशनिं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40007405, "chapter_id": 9007, "verse_number": "26", "content_sanskrit": "खरबाहुप्रयुक्ता सा प्रदीप्ता महती गदा। भस्मवृक्षांश्च गुल्मांश्च कृत्वागात्तत्समीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40007406, "chapter_id": 9007, "verse_number": "27", "content_sanskrit": "तामापतन्तीं ज्वलतां मृत्युपाशोपमां गदाम्। अन्तरिक्षगतां रामचशिच्छेद बहुधा शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40007407, "chapter_id": 9007, "verse_number": "28", "content_sanskrit": "सा विकीर्णा शरैर्भग्ना पपात धरणीतले। गदा मन्त्रौषधबलैर्व्यालीव विनिपातिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]