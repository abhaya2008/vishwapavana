[{"id": 2008360, "chapter_id": 1162, "verse_number": "१-१६३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2008361, "chapter_id": 1162, "verse_number": "१-१६३-१", "content_sanskrit": "तेन विक्रममाणेन ऊरुवेगसमीरितम्।\nवनं सवृक्षविटपं व्याघूर्णितमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2008362, "chapter_id": 1162, "verse_number": "१-१६३-२", "content_sanskrit": "जङ्गावातो ववौ चास्य शुचिशुक्रागमे यथा।\nआवर्जितालतावृक्षं मार्गं चक्रे महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2008363, "chapter_id": 1162, "verse_number": "१-१६३-३", "content_sanskrit": "स मृद्गन्पुष्पितांश्चैव फलितांश्च वनस्पतीन्।\nअवरुज्य ययौ गुल्मान्पथस्तस्य समीपजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2008364, "chapter_id": 1162, "verse_number": "१-१६३-४", "content_sanskrit": "स रोषित इव क्रुद्धो वने भञ्जन्महाद्रुमान्।\nत्रिप्रस्रुतमदः शुष्मी षष्टिवर्षो मतङ्गराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2008365, "chapter_id": 1162, "verse_number": "१-१६३-५", "content_sanskrit": "गच्छतस्तस्य वेगेन तार्क्ष्यमारुतरंहसः।\nभीमस्य पाण्डुपुत्राणां मूर्च्छेव समजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2008366, "chapter_id": 1162, "verse_number": "१-१६३-६", "content_sanskrit": "असकृच्चापि सतीर्य दूरपारं भुजप्लवैः।\nपथि प्रच्छन्नमासेदुर्धार्तराष्ट्रभयात्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2008367, "chapter_id": 1162, "verse_number": "१-१६३-७", "content_sanskrit": "कृच्छ्रेण मातरं चैव सुकुमारीं यशस्विनीम्।\nअवहत्स तु पृष्ठेन रोधःसु विषमेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2008368, "chapter_id": 1162, "verse_number": "१-१६३-८", "content_sanskrit": "अगमच्च वनोद्देशमल्पमूलफलोदकम्।\nक्रूरपक्षिमृगं घोरं सायाह्ने भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2008369, "chapter_id": 1162, "verse_number": "१-१६३-९", "content_sanskrit": "घोरा समभवत्सन्ध्या दारुणा मृगपक्षिणः।\nअप्रकाशा दिशः सर्वा वातैरासन्ननार्तवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2008370, "chapter_id": 1162, "verse_number": "१-१६३-१०", "content_sanskrit": "शीर्णपर्णफलै राजन्बहुगुल्मक्षुपद्रुमैः।\nभग्नावभुग्नभूयिष्ठैर्नानाद्रुमसमाकुलैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2008371, "chapter_id": 1162, "verse_number": "१-१६३-११", "content_sanskrit": "ते श्रमेण च कौरव्यास्तृष्णया च प्रपीडिताः।\nनाशक्नुवंस्तदा गन्तुं निद्रया च प्रवृद्धया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2008372, "chapter_id": 1162, "verse_number": "१-१६३-१२", "content_sanskrit": "न्यविशन्ति हि ते सर्वे निरास्वादे महावने।\nरात्र्यामेव गतास्तूर्णं चतुर्विंशतियोजनम्।\nततस्तृषा परिक्लन्ता कुन्ती वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2008373, "chapter_id": 1162, "verse_number": "१-१६३-१३", "content_sanskrit": "माता सती पाण्डवानां पञ्चानां मध्यतः स्थिता।\nतृष्णया हि परीताऽहमनाथेव महावने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2008374, "chapter_id": 1162, "verse_number": "१-१६३-१४", "content_sanskrit": "इतः परं तु शक्ताहं गन्तुं च न पदात्पदम्।\nशयिष्ये वृक्षमूलेऽत्र धार्तराष्ट्रा हरन्तु माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2008375, "chapter_id": 1162, "verse_number": "१-१६३-१५", "content_sanskrit": "शृणु भीम वचो मह्यं तव बाहुबलात्पुरः।\nस्थातुं न शक्ताः कौरव्याः किं बिभेषि पृथासुत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2008376, "chapter_id": 1162, "verse_number": "१-१६३-१६", "content_sanskrit": "अन्यो रथो न मेऽस्तीह भीमसेनादृते भुवि।\nधार्तराष्ट्राद्वृथा भीरुर्न मां स्वप्तुमिहेच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2008377, "chapter_id": 1162, "verse_number": "१-१६३-१७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2008378, "chapter_id": 1162, "verse_number": "१-१६३-१७", "content_sanskrit": "भीमपृष्ठस्थिता चेत्थं दूयमानेन चेतसा।\nनिश्यध्वनि रुदन्ती सा निद्रावश्मुपागता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2008379, "chapter_id": 1162, "verse_number": "१-१६३-१८", "content_sanskrit": "तच्छ्रुत्वा भीमसेनस्य मातृस्नेहात्प्रजल्पितम्।\nकारुण्येन मनस्तप्तं गमनायोपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2008380, "chapter_id": 1162, "verse_number": "१-१६३-१९", "content_sanskrit": "ततो भीमो वनं घोरं प्रविश्य विजनं महत्।\nन्यग्रोधं विपुलच्छायं रमणीयं ददर्श ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2008381, "chapter_id": 1162, "verse_number": "१-१६३-२०", "content_sanskrit": "तत्र निक्षिप्य तान्सर्वानुवाच भरतर्षभः।\nपानीयं मृगयामीह तावद्विश्रम्यतामिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2008382, "chapter_id": 1162, "verse_number": "१-१६३-२१", "content_sanskrit": "एते रुवन्ति मधुरं सारसा जलचारिणः।\nध्रुवमत्र जलस्थानं महच्चेति मतिर्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2008383, "chapter_id": 1162, "verse_number": "१-१६३-२२", "content_sanskrit": "अनुज्ञातः स गच्छेति भ्रात्रा ज्येष्ठेन भारत।\nजगाम तत्र यत्र स्म सारसा जलचारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2008384, "chapter_id": 1162, "verse_number": "१-१६३-२३", "content_sanskrit": "अपश्यत्पद्मिनीखण्डमण्डितं स सरोवरम्।\nस तत्र पीत्वा पानीयं स्नात्वा च भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2008385, "chapter_id": 1162, "verse_number": "१-१६३-२४", "content_sanskrit": "तेषामर्थे च जग्राह भ्रातॄणां भ्रातृवत्सलः।\nउत्तरीयेण पानीयमानयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2008386, "chapter_id": 1162, "verse_number": "१-१६३-२५", "content_sanskrit": "पङ्कजानामनेकैश्च पत्रैर्बध्वा पृथक्पृथक्।\nगव्यूतिमात्रादागत्य त्वरितो मातरं प्रति।\nशोकदुःखपरीतात्मा निशश्वासोरगो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2008387, "chapter_id": 1162, "verse_number": "१-१६३-२६", "content_sanskrit": "स सुप्तां मातरं भ्रातॄन्निद्राविद्रावितौजसः।\nमहारौद्रे वने घोरे वृक्षमूले सुशीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2008388, "chapter_id": 1162, "verse_number": "१-१६३-२७", "content_sanskrit": "विक्षिप्तकरपादांश्च दीर्घोच्छ्वासान्महाबलान्।\nऊर्ध्ववक्त्रान्महाकायान्पञ्चेन्द्रानिव भूपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2008389, "chapter_id": 1162, "verse_number": "१-१६३-२८", "content_sanskrit": "अज्ञातवृक्षनित्यस्थप्रेतराक्षससाध्वसान्।\nदृष्ट्वा वै भृशशोकार्तो बिललापानिलात्मजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2008390, "chapter_id": 1162, "verse_number": "१-१६३-२९", "content_sanskrit": "भृशं शोकपरीत्मा विललाप वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2008391, "chapter_id": 1162, "verse_number": "१-१६३-३०", "content_sanskrit": "अतः कष्टतरं किं नु द्रष्टव्यं हि भविष्यति।\nयत्पश्यामि महीसुप्तान्भ्रातॄनद्य सुमन्दभाक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2008392, "chapter_id": 1162, "verse_number": "१-१६३-३१", "content_sanskrit": "शयनेषु परार्ध्येषु ये पुरा वारणावते।\nनाधिजग्मुस्तदा निद्रां तेऽद्य सुप्ता महीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2008393, "chapter_id": 1162, "verse_number": "१-१६३-३२", "content_sanskrit": "स्वसारं वसुदेवस्य शत्रुसङ्घावमर्दिनः।\nकुन्तिराजसुतां कुन्तीं सर्वलक्षणपूजिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2008394, "chapter_id": 1162, "verse_number": "१-१६३-३३", "content_sanskrit": "स्नुषां विचित्रवीर्यस्य भार्यां पाण्डोर्महात्मनः।\nतथैव चास्मज्जननीं पुण्डरीकोदरप्रभाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2008395, "chapter_id": 1162, "verse_number": "१-१६३-३४", "content_sanskrit": "सुकुमारतरामेनां महार्हशयनोचिताम्।\nशयानां पश्यताऽद्येह पृथिव्यामतथोचिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2008396, "chapter_id": 1162, "verse_number": "१-१६३-३५", "content_sanskrit": "धर्मादिन्द्राच्च वाताच्च सुपुवे या सुतानिमान्।\nसेयं भूमौ परिश्रान्ता शेषे प्रासादशायिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2008397, "chapter_id": 1162, "verse_number": "१-१६३-३६", "content_sanskrit": "किं नु दुःखतरं शक्यं मया द्रष्टुमतः परम्।\nयोऽहमद्य नरव्याघ्रान्सुप्तान्पश्यामि भूतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2008398, "chapter_id": 1162, "verse_number": "१-१६३-३७", "content_sanskrit": "त्रिषु लोकेषु यो राज्यं धर्मनित्योऽर्हते नृपः।\nसोऽयं भूमौ परिश्रान्तः शेते प्राकृतवत्कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2008399, "chapter_id": 1162, "verse_number": "१-१६३-३८", "content_sanskrit": "अयं नीलाम्बुदश्यामो नरेष्वप्रतिमोऽर्जुनः।\nशेते प्राकृतवद्भूमौ ततो दुःखतरं नु किम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2008400, "chapter_id": 1162, "verse_number": "१-१६३-३९", "content_sanskrit": "अश्विनाविव देवानां याविमौ रूपसंपदा।\nतौ प्राकृतवदद्येमौ प्रसुप्तौ धरणीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2008401, "chapter_id": 1162, "verse_number": "१-१६३-४०", "content_sanskrit": "ज्ञातयो यस्य नै स्युर्विषमाः कुलपांसनाः।\nस जीवेत सुखं लोके ग्रामद्रुम इवैकजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2008402, "chapter_id": 1162, "verse_number": "१-१६३-४१", "content_sanskrit": "एको वृक्षो हि यो ग्रामे भवेत्पर्णफलान्वितः।\nचैत्यो भवति निर्ज्ञातिरध्वनीनैश्च पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2008403, "chapter_id": 1162, "verse_number": "१-१६३-४२", "content_sanskrit": "येषां च बहवः शूरा ज्ञातयो धर्ममाश्रिताः।\nते जीवन्ति सुखं लोके भवन्ति च निरामयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2008404, "chapter_id": 1162, "verse_number": "१-१६३-४३", "content_sanskrit": "बलवन्तः समृद्धार्था मित्रबान्धवनन्दनाः।\nजीवन्त्यन्योन्यमाश्रित्य द्रुमाः काननजा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2008405, "chapter_id": 1162, "verse_number": "१-१६३-४४", "content_sanskrit": "वयं तु धृतराष्ट्रेण दुष्पुत्रेण दुरात्मना।\nराज्यलुब्धेन मूर्खेण दुर्मन्त्रिसहितेन वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2008406, "chapter_id": 1162, "verse_number": "१-१६३-४५", "content_sanskrit": "दुष्टेनाधर्मशीलेन स्वार्थनिष्ठैकबुद्धिना।\nविवासिता न दग्धाश्च क्षत्तुर्बुद्धिपराक्रमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2008407, "chapter_id": 1162, "verse_number": "१-१६३-४६", "content_sanskrit": "तस्मान्मुक्ता वयं दाहादिमं वृक्षमुपाश्रिताः।\nकां दिशं प्रतिपत्स्यामः प्राप्ताः क्लेशमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2008408, "chapter_id": 1162, "verse_number": "१-१६३-४७", "content_sanskrit": "सकामो भव दुर्बुद्धे धार्तराष्ट्राल्पदर्शन।\nनूनं देवाः प्रसन्नास्ते नानुज्ञां मे युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2008409, "chapter_id": 1162, "verse_number": "१-१६३-४८", "content_sanskrit": "प्रयच्छति वधे तुभ्यं तेन जीवसि दुर्मते।\nनन्वद्य ससुतामात्यं सकर्णानुजसौबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2008410, "chapter_id": 1162, "verse_number": "१-१६३-४९", "content_sanskrit": "गत्वा क्रोधसमाविष्टः प्रेषयिष्ये यमक्षयम्।\nकिं नु शक्यं मया कर्तुं यत्तेन क्रुध्यते नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2008411, "chapter_id": 1162, "verse_number": "१-१६३-५०", "content_sanskrit": "धर्मात्मा पाण्डवश्रेष्ठः पापाचार युधिष्ठिरः।\nएवमुक्त्वा महाबाहुः क्रोधसन्दीप्तमानसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2008412, "chapter_id": 1162, "verse_number": "१-१६३-५१", "content_sanskrit": "करं करेण निष्पिष्य निःश्वसन्दीनमानसः।\nपुनर्दीनमना भूत्वा शान्तार्चिरिव पावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2008413, "chapter_id": 1162, "verse_number": "१-१६३-५२", "content_sanskrit": "भ्रातॄन्महीतले सुप्तानवैक्षत वृकोदरः।\nविश्वस्तानिव संविष्टान्पृथग्जनसमानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2008414, "chapter_id": 1162, "verse_number": "१-१६३-५३", "content_sanskrit": "नातिदूरेण नगरं वनादस्माद्धि लक्षये।\nजागर्तव्ये स्वपन्तीमे हन्त जागर्म्यहंस्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2008415, "chapter_id": 1162, "verse_number": "१-१६३-५४", "content_sanskrit": "प्राश्यन्तीमे जलं पश्चात्प्रतिबुद्धा जितक्लमाः।\nइति भीमो व्यवस्यैव जजागार स्वयं तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2008416, "chapter_id": 1162, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि जतुगृहपर्वणि त्रिषष्ट्यधिकशततमोऽध्यायः॥ १६३ ॥ ॥ समाप्तं जतुर्गृहपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]