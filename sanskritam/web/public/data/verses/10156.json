[{"id": 6000156000, "chapter_id": 10156, "verse_number": null, "content_sanskrit": "अथ तृतीयाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000156001, "chapter_id": 10156, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.001.m4a", "display_order": 2}, {"id": 6000156002, "chapter_id": 10156, "verse_number": "८-३-१", "content_sanskrit": "एवं व्यवसितो बुद्ध्या समाधाय मनो हृदि।\nजजाप परमं जाप्यं प्राग्जन्मन्यनुशिक्षितम्॥ ८/३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.002.m4a", "display_order": 3, "topics": [{"text": "ग्राहगृहीतेन गजेन्द्रेण भगवत्स्तुतिः", "range": "१–२७"}]}, {"id": 6000156003, "chapter_id": 10156, "verse_number": null, "content_sanskrit": "गजेन्द्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.003.m4a", "display_order": 4}, {"id": 6000156004, "chapter_id": 10156, "verse_number": "८-३-२", "content_sanskrit": "ओं नमो भगवते तस्मै यत एतच्चिदात्मकम्।\nपुरुषायाऽऽदिबीजाय परेशाय हि धीमहि॥ ८/३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.004.m4a", "display_order": 5}, {"id": 6000156005, "chapter_id": 10156, "verse_number": "८-३-३", "content_sanskrit": "यस्मिन्निदं यतश्चेदं येनेदं य इदं स्वयम्।\nयोऽस्मात् परस्माच्च परस्तं प्रपद्ये स्वयम्भुवम्॥ ८/३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.005.m4a", "display_order": 6}, {"id": 6000156006, "chapter_id": 10156, "verse_number": "८-३-४", "content_sanskrit": "यः स्वात्मनीदं निजमाययाऽर्पितं क्‍वचिद् विभातं क्‍व च तत्तिरोहितम्।\nअविद्धदृक् साक्ष्युभयं तदीक्षते स आत्ममूलोऽवतु मां परात्परः॥ ८/३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.006.m4a", "display_order": 7}, {"id": 6000156007, "chapter_id": 10156, "verse_number": "८-३-५", "content_sanskrit": "कालेन पञ्चत्वमितेषु कृत्स्नशो लोकेषु लीनेषु च सर्वहेतुषु।\nतमस्तदासीद् गहनं गभीरं यस्तस्य पारेऽभिविराजते विभुः॥ ८/३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.007.m4a", "display_order": 8}, {"id": 6000156008, "chapter_id": 10156, "verse_number": "८-३-६", "content_sanskrit": "न यस्य देवा ऋषयः पदं विदुर्जन्तुः पुनः कोऽर्हति गन्तुमीरितम्।\nयथा नटस्याकृतिभिर्विचेष्टतो दुरत्ययानुक्रमणः स माऽवतु॥ ८/३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.008.m4a", "display_order": 9}, {"id": 6000156009, "chapter_id": 10156, "verse_number": "८-३-७", "content_sanskrit": "दिदृक्षवो यस्य पदं सुमङ्गलं विमुक्तसङ्गा मुनयः सुसाधवः।\nचरन्त्यलोकव्रतमव्रणं वने सर्वात्मभूताः सुहृदः स मे गतिः॥ ८/३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.009.m4a", "display_order": 10}, {"id": 6000156010, "chapter_id": 10156, "verse_number": "८-३-८", "content_sanskrit": "न विद्यते यस्य च जन्म कर्म वा न नामरूपे गुणदोष एव वा।\nतथाऽपि लोकाश्रयसंभवाय यः स्वमायया तान्यनुकालमृच्छति॥ ८/३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.010.m4a", "display_order": 11}, {"id": 6000156011, "chapter_id": 10156, "verse_number": "८-३-९", "content_sanskrit": "तस्मै नमः परेशाय ब्रह्मणेऽनन्तशक्तये।\nअरूपायोरुरूपाय नम आश्चर्यकर्मणे॥ ८/३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.011.m4a", "display_order": 12}, {"id": 6000156012, "chapter_id": 10156, "verse_number": "८-३-१०", "content_sanskrit": "नम आत्मप्रदीपाय साक्षिणे परमात्मने।\nनमो गिरां विदूराय मनसश्चेतसामपि॥ ८/३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.012.m4a", "display_order": 13}, {"id": 6000156013, "chapter_id": 10156, "verse_number": "८-३-११", "content_sanskrit": "सत्त्वेन प्रतिलभ्याय नैष्कर्म्येण विपश्चिताम्।\nनमः कैवल्यनाथाय निर्वाणसुखसंविदे॥ ८/३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.013.m4a", "display_order": 14}, {"id": 6000156014, "chapter_id": 10156, "verse_number": "८-३-१२", "content_sanskrit": "नमः शान्ताय घोराय मूढाय गुणकर्मणे।\nनिर्विशेषाय साम्याय नमो ज्ञानघनाय च॥ ८/३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.014.m4a", "display_order": 15}, {"id": 6000156015, "chapter_id": 10156, "verse_number": "८-३-१३", "content_sanskrit": "क्षेत्रज्ञाय नमस्तुभ्यं सर्वाध्यक्षाय साक्षिणे।\nपुरुषायाऽत्ममूलाय मूलप्रकृतये नमः॥ ८/३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.015.m4a", "display_order": 16}, {"id": 6000156016, "chapter_id": 10156, "verse_number": "८-३-१४", "content_sanskrit": "सर्वेन्द्रियगुणद्रष्ट्रे सर्वप्रत्ययहेतवे।\nअसत्याच्च विमुक्ताय सदाभासाय ते नमः॥ ८/३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.016.m4a", "display_order": 17}, {"id": 6000156017, "chapter_id": 10156, "verse_number": "८-३-१५", "content_sanskrit": "नमो नमस्तेऽखिलकारणाय नारायणायार्तिविनाशनाय।\nसर्वागमाम्नायमहार्णवाय नमोऽपवर्गाय परायणाय॥ ८/३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.017.m4a", "display_order": 18}, {"id": 6000156018, "chapter_id": 10156, "verse_number": "८-३-१६", "content_sanskrit": "गुणारणिच्छन्नचिदुष्मपाय तत्क्षोभविस्फूर्जितमानसाय।\nयुक्तात्मभिः स्वहृदये परिभाविताय ज्ञानात्मने भगवते नम ईश्वराय॥ ८/३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.018.m4a", "display_order": 19}, {"id": 6000156019, "chapter_id": 10156, "verse_number": "८-३-१७", "content_sanskrit": "यं धर्मकामार्थविमुक्तकामा भजन्त इष्टां गतिमाप्नुवन्ति।\nकिं चाशिषो रात्यपि देहमव्ययं करोतु मेऽदभ्रदयो विमोक्षणम्॥ ८/३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.019.m4a", "display_order": 20}, {"id": 6000156020, "chapter_id": 10156, "verse_number": "८-३-१८", "content_sanskrit": "एकान्तिनो यस्य न कञ्चनार्थं वाञ्छन्ति ये ते भगवत्प्रधानाः।\nअत्यद्भुतं यच्चरितं सुमङ्गलं गायन्त आनन्दसमुद्रमग्नाः॥ ८/३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.020.m4a", "display_order": 21}, {"id": 6000156021, "chapter_id": 10156, "verse_number": "८-३-१९", "content_sanskrit": "तमक्षरं ब्रह्म परं परेशम् अव्यक्तमाध्यात्मिकयोगगम्यम्।\nअतीन्द्रियं सूक्ष्ममिवातिदूरम् अनन्तमाद्यं परिपूर्णमीडे॥ ८/३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.021.m4a", "display_order": 22}, {"id": 6000156022, "chapter_id": 10156, "verse_number": "८-३-२०", "content_sanskrit": "यस्य ब्रह्मादयो देवा वेदा लोकाश्चरचराः।\nनामरूपविभेदेन जल्प्या च कलया कृताः॥ ८/३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.022.m4a", "display_order": 23}, {"id": 6000156023, "chapter_id": 10156, "verse_number": "८-३-२१", "content_sanskrit": "यथाऽर्चिषोऽग्नेः सवितुर्गभस्तयो निर्यान्ति संयान्त्यसकृत् स्वरोचिषः।\nतथा यतोऽयं गुणसम्प्रवाहो बुद्धिर्मनः खानि शरीरसर्गः॥ ८/३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.023.m4a", "display_order": 24}, {"id": 6000156024, "chapter_id": 10156, "verse_number": "८-३-२२", "content_sanskrit": "स वै न देवासुरमर्त्यतिर्यङ् न स्‍त्री न षण्ढो न पुमान् न जन्तुः।\nनायं गुणः कर्म न सन् न चासन् निषेधशेषो जयतादशेषः॥ ८/३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.024.m4a", "display_order": 25}, {"id": 6000156025, "chapter_id": 10156, "verse_number": "८-३-२३", "content_sanskrit": "जिजीविषे नाहमिहामुया किमन्तर्बहिश्चावृतयेभयोन्या।\nइच्छामि कालेन न यस्य विप्लवस्तस्यात्मलोकावरणस्य मोक्षणम्॥ ८/३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.025.m4a", "display_order": 26}, {"id": 6000156026, "chapter_id": 10156, "verse_number": "८-३-२४", "content_sanskrit": "सोऽहं विश्वसृजं विश्वमविश्वं विश्ववेदसम्।\nविश्वात्मानमजं ब्रह्म प्रणतोऽस्मि परं पदम्॥ ८/३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.026.m4a", "display_order": 27}, {"id": 6000156027, "chapter_id": 10156, "verse_number": "८-३-२५", "content_sanskrit": "योगरन्धितकर्माणो हृदि योगविभाविते।\nयोगिनो यं प्रपश्यन्ति योगीशं तं नतोऽस्म्यहम्॥ ८/३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.027.m4a", "display_order": 28}, {"id": 6000156028, "chapter_id": 10156, "verse_number": "८-३-२६", "content_sanskrit": "नमो नमस्तुभ्यमसह्यवेगशक्तित्रयायाखिलधीगुणाय।\nप्रपन्नपालाय दुरन्तशक्तये बुद्धीन्द्रियाणामनवाप्यवर्त्मने॥ ८/३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.028.m4a", "display_order": 29}, {"id": 6000156029, "chapter_id": 10156, "verse_number": "८-३-२७", "content_sanskrit": "नायं वेद स्वमात्मानं यच्छक्त्याऽहं धिया हतः।\nतं दुरत्ययमाहात्म्यं भगवन्तं नतोऽस्म्यहम्॥ ८/३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.029.m4a", "display_order": 30}, {"id": 6000156030, "chapter_id": 10156, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.030.m4a", "display_order": 31}, {"id": 6000156031, "chapter_id": 10156, "verse_number": "८-३-२८", "content_sanskrit": "एवं गजेन्द्रमुपवर्णितनिर्विशेषं ब्रह्मादयो विविधलिङ्गभिदाभिमानाः।\nनैते यदोपससृपुर्निखिलात्मकत्वात् तत्राखिलामरवरो हरिराविरासीत्॥ ८/३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.031.m4a", "display_order": 32, "topics": [{"text": "तत्क्षणागतेन हरिणा ग्राहाद्गजेन्द्रमोचनम्, ग्राहस्य च देवलशापतो मोचनम्", "range": "२८–३१"}]}, {"id": 6000156032, "chapter_id": 10156, "verse_number": "८-३-२९", "content_sanskrit": "तं तद्वदार्तमुपलभ्य जगन्निवासः स्तोत्रं निशम्य दिविजैः सह संस्तुवद्भिः।\nछन्दोमयेन गरुडेन समुह्यमानश्चक्रायुधो ह्यगमदाशु यतो गजेन्द्रः॥ ८/३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.032.m4a", "display_order": 33}, {"id": 6000156033, "chapter_id": 10156, "verse_number": "८-३-३०", "content_sanskrit": "सोऽन्तः सरस्युरुबलेन गृहीत आर्तो दृष्ट्वा गरुत्मति हरिं ख उपात्तचक्रम्।\nउत्क्षिप्य साम्बुजकरं गिरमाह कृच्छ्रान्नारायणाखिलगुरो भगवन् नमस्ते॥ ८/३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.033.m4a", "display_order": 34}, {"id": 6000156034, "chapter_id": 10156, "verse_number": "८-३-३१", "content_sanskrit": "तं वीक्ष्य पीडितमजः सहसाऽवतीर्य सग्राहमाशु सरसः कृपयोज्जहार।\nग्राहाद् विपाटितमुखादरिणा गजेन्द्रं सम्पश्यतां हरिरमूमुचदुस्रियाणाम्॥ ८/३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_003/BhP_08.003.034.m4a", "display_order": 35}, {"id": 6000156035, "chapter_id": 10156, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायाम् अष्टमस्कन्धे तृतीयाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]