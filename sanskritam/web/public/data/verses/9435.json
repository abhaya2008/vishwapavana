[{"id": 5000435000, "chapter_id": 9435, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे अष्टाविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000435001, "chapter_id": 9435, "verse_number": "६-२८-१", "content_sanskrit": "सारणस्य वचः श्रुत्वा रावणं राक्षसाधिपम्।\nबलमादिश्य तत् सर्वं शुको वाक्यमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000435002, "chapter_id": 9435, "verse_number": "६-२८-२", "content_sanskrit": "स्थितान् पश्यसि यानेतान् मत्तानिव महाद्विपान्।\nन्यग्रोधानिव गाङ्गेयान् सालान् हैमवतानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000435003, "chapter_id": 9435, "verse_number": "६-२८-३", "content_sanskrit": "एते दुष्प्रसहा राजन् बलिनः कामरूपिणः।\nदैत्यदानवसंकाशा युद्धे देवपराक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000435004, "chapter_id": 9435, "verse_number": "६-२८-४", "content_sanskrit": "एषां कोटिसहस्राणि नव पञ्च च सप्त च।\nतथा शङ्कुसहस्राणि तथा वृन्दशतानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000435005, "chapter_id": 9435, "verse_number": "६-२८-५", "content_sanskrit": "एते सुग्रीवसचिवाः किष्किन्धानिलयाः सदा।\nहरयो देवगन्धर्वैरुत्पन्नाः कामरूपिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000435006, "chapter_id": 9435, "verse_number": "६-२८-६", "content_sanskrit": "यौ तौ पश्यसि तिष्ठन्तौ कुमारौ देवरूपिणौ।\nमैन्दश्च द्विविदश्चैव ताभ्यां नास्ति समो युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000435007, "chapter_id": 9435, "verse_number": "६-२८-७", "content_sanskrit": "ब्रह्मणा समनुज्ञातावमृतप्राशिनावुभौ।\nआशंसेते यथा लङ्कामेतौ मर्दितुमोजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000435008, "chapter_id": 9435, "verse_number": "६-२८-८", "content_sanskrit": "यं तु पश्यसि तिष्ठन्तं प्रभिन्नमिव कुञ्जरम्।\nयो बलात् क्षोभयेत् क्रुद्धः समुद्रमपि वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000435009, "chapter_id": 9435, "verse_number": "६-२८-९", "content_sanskrit": "एषोऽभिगन्ता लङ्कायां वैदेह्यास्तव च प्रभो।\nएनं पश्य पुरा दृष्टं वानरं पुनरागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000435010, "chapter_id": 9435, "verse_number": "६-२८-१०", "content_sanskrit": "ज्येष्ठः केसरिणः पुत्रो वातात्मज इति श्रुतः।\nहनूमानिति विख्यातो लङ्घितो येन सागरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000435011, "chapter_id": 9435, "verse_number": "६-२८-११", "content_sanskrit": "कामरूपो हरिश्रेष्ठो बलरूपसमन्वितः।\nअनिवार्यगतिश्चैव यथा सततगः प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000435012, "chapter_id": 9435, "verse_number": "६-२८-१२", "content_sanskrit": "उद्यन्तं भास्करं दृष्ट्वा बालः किल बुभुक्षितः।\nत्रियोजनसहस्रं तु अध्वानमवतीर्य हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000435013, "chapter_id": 9435, "verse_number": "६-२८-१३", "content_sanskrit": "आदित्यमाहरिष्यामि न मे क्षुत् प्रतियास्यति।\nइति निश्चित्य मनसा पुप्लुवे बलदर्पितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000435014, "chapter_id": 9435, "verse_number": "६-२८-१४", "content_sanskrit": "अनाधृष्यतमं देवमपि देवर्षिराक्षसैः।\nअनासाद्यैव पतितो भास्करोदयने गिरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000435015, "chapter_id": 9435, "verse_number": "६-२८-१५", "content_sanskrit": "पतितस्य कपेरस्य हनुरेका शिलातले।\nकिंचिद् भिन्ना दृढहनुर्हनूमानेष तेन वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000435016, "chapter_id": 9435, "verse_number": "६-२८-१६", "content_sanskrit": "सत्यमागमयोगेन ममैष विदितो हरिः।\nनास्य शक्यं बलं रूपं प्रभावो वानुभाषितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000435017, "chapter_id": 9435, "verse_number": "६-२८-१७", "content_sanskrit": "एष आशंसते लङ्कामेको मथितुमोजसा।\nयेन जाज्वल्यतेऽसौ वै धूमकेतुस्तवाद्य वै।\nलङ्कायां निहितश्चापि कथं विस्मरसे कपिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000435018, "chapter_id": 9435, "verse_number": "६-२८-१८", "content_sanskrit": "यश्चैषोऽनन्तरः शूरः श्यामः पद्मनिभेक्षणः।\nइक्ष्वाकूणामतिरथो लोके विश्रुतपौरुषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000435019, "chapter_id": 9435, "verse_number": "६-२८-१९", "content_sanskrit": "यस्मिन् न चलते धर्मो यो धर्मं नातिवर्तते।\nयो ब्राह्ममस्त्रं वेदांश्च वेद वेदविदां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000435020, "chapter_id": 9435, "verse_number": "६-२८-२०", "content_sanskrit": "यो भिन्द्याद् गगनं बाणैर्मेदिनीं वापि दारयेत्।\nयस्य मृत्योरिव क्रोधः शक्रस्येव पराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000435021, "chapter_id": 9435, "verse_number": "६-२८-२१", "content_sanskrit": "यस्य भार्या जनस्थानात् सीता चापि हृता त्वया।\nस एष रामस्त्वां राजन् योद्धुं समभिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000435022, "chapter_id": 9435, "verse_number": "६-२८-२२", "content_sanskrit": "यस्यैष दक्षिणे पार्श्वे शुद्धजाम्बूनदप्रभः।\nविशालवक्षास्ताम्राक्षो नीलकुञ्चितमूर्धजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000435023, "chapter_id": 9435, "verse_number": "६-२८-२३", "content_sanskrit": "एषो हि लक्ष्मणो नाम भ्रातुः प्रियहिते रतः।\nनये युद्धे च कुशलः सर्वशस्त्रभृतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000435024, "chapter_id": 9435, "verse_number": "६-२८-२४", "content_sanskrit": "अमर्षी दुर्जयो जेता विक्रान्तश्च जयी बली।\nरामस्य दक्षिणो बाहुर्नित्यं प्राणो बहिश्चरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000435025, "chapter_id": 9435, "verse_number": "६-२८-२५", "content_sanskrit": "नह्येष राघवस्यार्थे जीवितं परिरक्षति।\nएषैवाशंसते युद्धे निहन्तुं सर्वराक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000435026, "chapter_id": 9435, "verse_number": "६-२८-२६", "content_sanskrit": "यस्तु सव्यमसौ पक्षं रामस्याश्रित्य तिष्ठति।\nरक्षोगणपरिक्षिप्तो राजा ह्येष विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000435027, "chapter_id": 9435, "verse_number": "६-२८-२७", "content_sanskrit": "श्रीमता राजराजेन लङ्कायामभिषेचितः।\nत्वामसौ प्रतिसंरब्धो युद्धायैषोऽभिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000435028, "chapter_id": 9435, "verse_number": "६-२८-२८", "content_sanskrit": "यं तु पश्यसि तिष्ठन्तं मध्ये गिरिमिवाचलम्।\nसर्वशाखामृगेन्द्राणां भर्तारममितौजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000435029, "chapter_id": 9435, "verse_number": "६-२८-२९", "content_sanskrit": "तेजसा यशसा बुद्ध्या बलेनाभिजनेन च।\nयः कपीनतिबभ्राज हिमवानिव पर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000435030, "chapter_id": 9435, "verse_number": "६-२८-३०", "content_sanskrit": "किष्किन्धां यः समध्यास्ते गुहां सगहनद्रुमाम्।\nदुर्गां पर्वतदुर्गम्यां प्रधानैः सह यूथपैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000435031, "chapter_id": 9435, "verse_number": "६-२८-३१", "content_sanskrit": "यस्यैषा काञ्चनी माला शोभते शतपुष्करा।\nकान्ता देवमनुष्याणां यस्यां लक्ष्मीः प्रतिष्ठिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000435032, "chapter_id": 9435, "verse_number": "६-२८-३२", "content_sanskrit": "एतां मालां च तारां च कपिराज्यं च शाश्वतम्।\nसुग्रीवो वालिनं हत्वा रामेण प्रतिपादितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000435033, "chapter_id": 9435, "verse_number": "६-२८-३३", "content_sanskrit": "शतं शतसहस्राणां कोटिमाहुर्मनीषिणः।\nशतं कोटिसहस्राणां शङ्कुरित्यभिधीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000435034, "chapter_id": 9435, "verse_number": "६-२८-३४", "content_sanskrit": "शतं शङ्कुसहस्राणां महाशङ्कुरिति स्मृतः।\nमहाशङ्कुसहस्राणां शतं वृन्दमिहोच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000435035, "chapter_id": 9435, "verse_number": "६-२८-३५", "content_sanskrit": "शतं वृन्दसहस्राणां महावृन्दमिति स्मृतम्।\nमहावृन्दसहस्राणां शतं पद्ममिहोच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000435036, "chapter_id": 9435, "verse_number": "६-२८-३६", "content_sanskrit": "शतं पद्मसहस्राणां महापद्ममिति स्मृतम्।\nमहापद्मसहस्राणां शतं खर्वमिहोच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000435037, "chapter_id": 9435, "verse_number": "६-२८-३७", "content_sanskrit": "शतं खर्वसहस्राणां महाखर्वमिति स्मृतम्।\nमहाखर्वसहस्राणां समुद्रमभिधीयते।\nशतं समुद्रसाहस्रमोघ इत्यभिधीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000435038, "chapter_id": 9435, "verse_number": "६-२८-३८", "content_sanskrit": "शतमोघसहस्राणां महौघा इति विश्रुतः।\nएवं कोटिसहस्रेण शङ्कूनां च शतेन च।\nमहाशङ्कुसहस्रेण तथा वृन्दशतेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000435039, "chapter_id": 9435, "verse_number": "६-२८-३९", "content_sanskrit": "महावृन्दसहस्रेण तथा पद्मशतेन च।\nमहापद्मसहस्रेण तथा खर्वशतेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000435040, "chapter_id": 9435, "verse_number": "६-२८-४०", "content_sanskrit": "समुद्रेण च तेनैव महौघेन तथैव च\nएष कोटिमहौघेन समुद्रसदृशेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000435041, "chapter_id": 9435, "verse_number": "६-२८-४१", "content_sanskrit": "विभीषणेन वीरेण सचिवैः परिवारितः।\nसुग्रीवो वानरेन्द्रस्त्वां युद्धार्थमनुवर्तते।\nमहाबलवृतो नित्यं महाबलपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000435042, "chapter_id": 9435, "verse_number": "६-२८-४२", "content_sanskrit": "इमां महाराज समीक्ष्य वाहिनी-\nमुपस्थितां प्रज्वलितग्रहोपमाम्।\nततः प्रयत्नः परमो विधीयतां\nयथा जयः स्यान्न परैः पराभवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000435043, "chapter_id": 9435, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे अष्टाविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]