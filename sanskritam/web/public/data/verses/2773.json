[{"id": 2083219, "chapter_id": 2773, "verse_number": "१२-२७८-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2083220, "chapter_id": 2773, "verse_number": "१२-२७८-१", "content_sanskrit": "बहूनां यज्ञतपसामेकार्थानां पितामह।\nधर्मार्थं न सुखार्थार्थं कथं यज्ञः समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2083221, "chapter_id": 2773, "verse_number": "१२-२७८-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2083222, "chapter_id": 2773, "verse_number": "१२-२७८-२", "content_sanskrit": "अत्र ते वर्तयिष्यामि नारदेनानुकीर्तितम्।\nउञ्छवृत्तेः पुरावृत्तं यज्ञार्थे ब्राह्मणस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2083223, "chapter_id": 2773, "verse_number": "१२-२७८-३x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2083224, "chapter_id": 2773, "verse_number": "१२-२७८-३", "content_sanskrit": "राष्ट्रे धर्मोत्तरे श्रेष्ठे विदर्भेष्वभवद्द्विजः।\nउञ्छवृत्तिर्ऋषिः कश्चिद्यज्ञं यष्टुं समादधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2083225, "chapter_id": 2773, "verse_number": "१२-२७८-४", "content_sanskrit": "श्यामाकमशनं तत्र सूर्यपर्णी सुवर्चला।\nतिक्तं च विरसं शाकं तपसा स्वादुतां गतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2083226, "chapter_id": 2773, "verse_number": "१२-२७८-५", "content_sanskrit": "उपगम्य वने पृथ्वीं सर्वभूताविहिंसया।\nअपि मूलफलैरिष्टो यज्ञः स्वर्ग्यः परंतप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2083227, "chapter_id": 2773, "verse_number": "१२-२७८-६", "content_sanskrit": "तस्य भार्या व्रतकृशा शुचिः पुष्करमालिनी।\nयज्ञपत्नी समानीता सत्येनानुविधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2083228, "chapter_id": 2773, "verse_number": "१२-२७८-७", "content_sanskrit": "सा तु शापपरित्रस्ता तत्स्वभावानुर्तिनी।\nमायूरजीर्णपर्णानां वस्त्रं तस्याश्च वर्णितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2083229, "chapter_id": 2773, "verse_number": "१२-२७८-८", "content_sanskrit": "अकामया कृतस्तत्र यज्ञो होत्रनुमार्गतः।\nशुकस्य पुनराजातिरवध्यानादधर्मवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2083230, "chapter_id": 2773, "verse_number": "१२-२७८-९", "content_sanskrit": "तस्मिन्वने समीपस्थो मृगोऽभूत्सहचारिकः।\nवचोभिरब्रवीत्सत्यं त्वयेदं दुष्कृतं कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2083231, "chapter_id": 2773, "verse_number": "१२-२७८-१०", "content_sanskrit": "यदि मन्त्राङ्गहीनोऽयं यज्ञो भवति वैकृतः।\nमा भोःप्रक्षिप होत्रे त्वं गच्छ स्वर्गमतन्द्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2083232, "chapter_id": 2773, "verse_number": "१२-२७८-११", "content_sanskrit": "ततस्तु यज्ञे सावित्री साक्षात्तं संन्यमन्त्रयत्।\nनिमन्त्रयन्ती प्रत्युक्ता न हन्यां सहवासिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2083233, "chapter_id": 2773, "verse_number": "१२-२७८-१२", "content_sanskrit": "एवमुक्त्वा निवृत्ता सा प्रवृत्ता यज्ञपावकात्।\nकिंनु दुश्चरितं यज्ञे दिदृक्षुः सा रसातलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2083234, "chapter_id": 2773, "verse_number": "१२-२७८-१३", "content_sanskrit": "स तु बद्धाञ्जलिं सत्यमयाचद्धरिणः पुनः।\nसत्येन स परिष्वज्य संदिष्टो गम्यतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2083235, "chapter_id": 2773, "verse_number": "१२-२७८-१४", "content_sanskrit": "ततः स हरिणो गत्वा पदान्यष्टौ न्यवर्तत।\nसाधु हिंसय मां सत्य हतो यास्यामि सद्गदितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2083236, "chapter_id": 2773, "verse_number": "१२-२७८-१५", "content_sanskrit": "पश्य ह्यप्सरसो दिव्या मया दत्तेन चक्षुषा।\nविमानानि विचित्राणि गन्धर्वाणां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2083237, "chapter_id": 2773, "verse_number": "१२-२७८-१६", "content_sanskrit": "ततः स सुचिरं दृष्ट्वा स्पृहालग्नेन चक्षुषा।\nमृगमालोक्य हिंसायां स्वर्गवासं समर्थयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2083238, "chapter_id": 2773, "verse_number": "१२-२७८-१७", "content_sanskrit": "स तु धर्मो मृगो भूत्वा बहुवर्षोषितो वने।\nतस्य निष्कृतिमाधत्त न त्वसौ यज्ञसंविधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2083239, "chapter_id": 2773, "verse_number": "१२-२७८-१८", "content_sanskrit": "तस्य तेनानुभावेन मृगहिंसात्मनस्तदा।\nतपो महत्समुच्छिन्नं तस्माद्धिंसा न यज्ञिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2083240, "chapter_id": 2773, "verse_number": "१२-२७८-१९", "content_sanskrit": "ततस्तं भगवान्धर्मो यज्ञं याजयत स्वयम्।\nसमाधानं च भार्याया लेभे स तपसा परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2083241, "chapter_id": 2773, "verse_number": "१२-२७८-२०", "content_sanskrit": "अहिंसा परो धर्मो हिंसाधर्मस्तथा हितः।\nसत्यं तेऽहं प्रवक्ष्यामि नो धर्मः सत्यवादिनाम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2083242, "chapter_id": 2773, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि अष्टसप्तत्यधिकद्विशततमोऽध्यायः॥ २७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]