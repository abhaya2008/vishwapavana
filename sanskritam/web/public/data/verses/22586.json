[{"id": 7002586000, "chapter_id": 22586, "verse_number": "३-११-१", "content_sanskrit": "सूत उवाच ।\nअथ पूजाक्रमं वक्ष्ये पुराणस्मृतिचोदितम् ।\nउत्तरे पश्चिमे वाथ पूर्वे चापि समाचरेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002586001, "chapter_id": 22586, "verse_number": "३-११-२", "content_sanskrit": "नदीतीरे नेमिप्रांते दशद्वादशसंख्यया ।\nमंडलं रचयेद्विप्राश्चरुकद्वयसंयुतम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002586002, "chapter_id": 22586, "verse_number": "३-११-३", "content_sanskrit": "त्रिभागं विभजेत्क्षेत्रं मध्यभागद्वयेन तु ।\nत्रिहस्तवेदिकां कुर्यात्तालोत्सेधामुदक्प्लवाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002586003, "chapter_id": 22586, "verse_number": "३-११-४", "content_sanskrit": "उत्तराशे दक्षिणे चारत्निहस्तांतरेऽपि च ।\nत्रिमेखलां हस्तमात्रां गुणवेदीसमन्विताम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002586004, "chapter_id": 22586, "verse_number": "३-११-५", "content_sanskrit": "मूले सार्धं च शुक्लां च मेखलां तु तथैव च ।\nचतुरंगुलिकां वेदिं मध्योन्नतां प्रकल्पयेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002586005, "chapter_id": 22586, "verse_number": "३-११-६", "content_sanskrit": "षट्सप्तांगुलिकां योनिं पश्चिमे मेखलोपरि ।\nविन्यसेन्नाभिसंयुक्तमेवं कुण्डं प्रकल्पयेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002586006, "chapter_id": 22586, "verse_number": "३-११-७", "content_sanskrit": "श्राद्धं वृद्ध्यात्मकं कुर्यात्संकल्पं मानसं चरेत् ।\nश्राद्धार्थं नैव संकल्पेत्तथा वै देवदर्शने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002586007, "chapter_id": 22586, "verse_number": "३-११-८", "content_sanskrit": "गयाश्राद्धार्थकं चाष्टतीर्थश्राद्धार्थमेव च ।\nऐशान्यां कलशे देवं पूजयेद्गणनायकम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002586008, "chapter_id": 22586, "verse_number": "३-११-९", "content_sanskrit": "मध्ये कुण्डे महांश्चैव विष्णुदेवं दिगीश्वरान् ।\nब्रह्माणं चाग्निकुण्डे तु स्वैः स्वैर्मन्त्रैः प्रपूजयेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002586009, "chapter_id": 22586, "verse_number": "३-११-१०", "content_sanskrit": "प्राणायामं विधायाथ भूतशुद्धिं समाचरेत् ।\nध्यायेद्वाटवीशपुरुषं सर्वलक्षणसंयुतम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002586010, "chapter_id": 22586, "verse_number": "३-११-११", "content_sanskrit": "श्वेतं चतुर्भुजं शांतं कुण्डलाद्यैरलंकृतम् ।\nपुस्तकं चाक्षमालां च वराभयकरं परम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002586011, "chapter_id": 22586, "verse_number": "३-११-१२", "content_sanskrit": "पितृवैश्वानरोपेतं कुटिलभ्रूपशोभितम् ।\nकरालवदनं चैव आजानुकरलंबितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]