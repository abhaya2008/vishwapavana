[{"id": 2079964, "chapter_id": 2702, "verse_number": "१२-२०७-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2079965, "chapter_id": 2702, "verse_number": "१२-२०७-१", "content_sanskrit": "के पूर्वमासन्पतयः प्रजानां भरतर्षभ।\nके चर्षयो महाभागा दिक्षु प्रत्येकशः स्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2079966, "chapter_id": 2702, "verse_number": "१२-२०७-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2079967, "chapter_id": 2702, "verse_number": "१२-२०७-२", "content_sanskrit": "श्रूयतां भरतश्रेष्ठ यन्मां त्वं परिपृच्छसि।\nप्रजानां पतयो ये च दिक्षु ये चर्षयः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2079968, "chapter_id": 2702, "verse_number": "१२-२०७-३", "content_sanskrit": "एकः स्वयंभूर्भगवानाद्यो ब्रह्मा सनातनः।\nब्रह्मणः सप्त वै पुत्रा महात्मानः स्वयंभुवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2079969, "chapter_id": 2702, "verse_number": "१२-२०७-४", "content_sanskrit": "मरीचिरत्र्यङ्गिरसौ पुलस्त्यः पुलहः क्रतुः।\nवसिष्ठश्च महाभागः सदृशो वै स्वयंभुवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2079970, "chapter_id": 2702, "verse_number": "१२-२०७-५", "content_sanskrit": "सप्त ब्रह्मण इत्येते पुराणे निश्चयं गताः।\nअत ऊर्ध्वं प्रवक्ष्यामि सर्वानेव प्रजापतीन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2079971, "chapter_id": 2702, "verse_number": "१२-२०७-६", "content_sanskrit": "अत्रिवंशतमुत्पन्नो ब्रह्मयोनिः सनातनः।\nप्राचनवर्हिर्भगवांस्तस्मात्प्राचेतसो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2079972, "chapter_id": 2702, "verse_number": "१२-२०७-७", "content_sanskrit": "दशानां तनयस्त्वेको दक्षो नाम प्रजापतिः।\nतस्य द्वे नामनी लोके दक्षः क इति चोच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2079973, "chapter_id": 2702, "verse_number": "१२-२०७-८", "content_sanskrit": "मरीचेः कश्यपः पुत्रस्तस्य द्वे नामनी स्मृते।\nअरिष्टनेमिरित्येके कश्यपेत्यपरे विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2079974, "chapter_id": 2702, "verse_number": "१२-२०७-९", "content_sanskrit": "अत्रेश्चैवौरसः श्रीमान्राजा सोमश्च वीर्यवान्।\nसहस्रं यश्च दिव्यानां युगानां पर्युपासिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2079975, "chapter_id": 2702, "verse_number": "१२-२०७-१०", "content_sanskrit": "अर्यमा चैव भगवान्ये चास्य तनया विभो।\nएते प्रदेशाः कथिता भुवनानां प्रभावनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2079976, "chapter_id": 2702, "verse_number": "१२-२०७-११", "content_sanskrit": "शशबिन्दोश्च भार्याणां सहस्राणि दशाच्युत।\nएकैकस्यां सहस्रं तु तनयानामभूत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2079977, "chapter_id": 2702, "verse_number": "१२-२०७-१२", "content_sanskrit": "एवं शतसहस्राणि दश तस्य महात्मनः।\nपुत्राणां च न ते संचिदिच्छन्त्यन्यं प्रजापतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2079978, "chapter_id": 2702, "verse_number": "१२-२०७-१३", "content_sanskrit": "प्रजामाचक्षते विप्राः पुराणाः शाशबिन्दवीम्।\nस वृष्णिवंशप्रभवो महावंशः प्रजापतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2079979, "chapter_id": 2702, "verse_number": "१२-२०७-१४", "content_sanskrit": "एते प्रजानां पतयः समुद्दिष्टा यशस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2079980, "chapter_id": 2702, "verse_number": "१२-२०७-१५", "content_sanskrit": "`शशबिन्दुस्तु राजर्षिर्महायोगी महामनाः।\nअध्यात्मवित्सहस्राणां भार्याणां दशमध्यगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2079981, "chapter_id": 2702, "verse_number": "१२-२०७-१६", "content_sanskrit": "स योगी योगमापन्नस्ततः सायुच्यतां गतः।\nअतः परं प्रवक्ष्यामि देवांस्त्रिभुवनेश्वरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2079982, "chapter_id": 2702, "verse_number": "१२-२०७-१७", "content_sanskrit": "भयोंऽशश्चार्यमा चैव मित्रोऽथ वरुणस्तथा।\nसविता चैव घाता च विवस्वांश्च महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2079983, "chapter_id": 2702, "verse_number": "१२-२०७-१८", "content_sanskrit": "त्वष्टा पूषा तथैवेन्द्रो द्वादशो विष्णुरुच्यते।\nइत्येते द्वादशादित्याः कश्यपस्यात्मसंभवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2079984, "chapter_id": 2702, "verse_number": "१२-२०७-१९", "content_sanskrit": "नासत्यश्चैव दस्रश्च स्मृतो द्वावश्विनावपि।\nमार्तण्डस्यात्मजावेतावात्मस्य प्रजापतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2079985, "chapter_id": 2702, "verse_number": "१२-२०७-२०", "content_sanskrit": "त्वष्टुश्चैवात्मजः श्रीमान्विश्वरूपो महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2079986, "chapter_id": 2702, "verse_number": "१२-२०७-२१", "content_sanskrit": "अजैकपादहिर्बुध्न्यो विरूपाक्षोऽथ रैवतः।\nहरश्च बहुरूपश्च त्र्यम्बकश्च सुरेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2079987, "chapter_id": 2702, "verse_number": "१२-२०७-२२", "content_sanskrit": "सावित्रश्च जयन्तश्च पिनाकी चापराजितः।\n`एकादशैते कथिता रुद्रास्त्रिभुवनेश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2079988, "chapter_id": 2702, "verse_number": "१२-२०७-२३", "content_sanskrit": "पूर्वमेव महाभागा वसवोऽष्टौ प्रकीर्तिताः।\nएत एवविधा देवा मनोरेव प्रजापतेः।\nते च पूर्वं सुराश्चेति द्विविधाः पितरः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2079989, "chapter_id": 2702, "verse_number": "१२-२०७-२४", "content_sanskrit": "शीलयौवनयोस्त्वन्यस्तथाऽन्ये सिद्धसाध्ययोः।\nऋभवो मरुतश्चैव देवानां चोदितो गणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2079990, "chapter_id": 2702, "verse_number": "१२-२०७-२५", "content_sanskrit": "एवमेते समाम्नाता विश्वेदेवास्तथाऽश्विनौ।\nआदित्याः क्षत्रियास्तेषां विशश्च मरुतस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2079991, "chapter_id": 2702, "verse_number": "१२-२०७-२६", "content_sanskrit": "अश्विनौ तु स्मृतौ शूद्रौ तपस्युग्रे समास्थितौ।\nस्मृतास्त्वङ्गिरसो देवा ब्राह्मणा इति निश्चयः।\nइत्येतत्सर्वदेवानां चातुर्वर्ण्यं प्रकीर्तितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2079992, "chapter_id": 2702, "verse_number": "१२-२०७-२७", "content_sanskrit": "एतान्वै प्रातरुत्थाय देवान्यस्तु प्रकीर्तयेत्।\nस्वजादन्यकृताच्चैव सर्वपापात्प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2079993, "chapter_id": 2702, "verse_number": "१२-२०७-२८", "content_sanskrit": "यवक्रीतोऽथ रैभ्यश्च अर्वावसुपरावसू।\nऔशिजश्चैव कक्षीवान्बलश्चाङ्गिरसः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2079994, "chapter_id": 2702, "verse_number": "१२-२०७-२९", "content_sanskrit": "ऋषिर्मेधातिथेः पुत्रः कण्वो बर्हिषदस्तथा।\nत्रैलोक्यभावनास्तात प्राच्यां सप्तर्षयस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2079995, "chapter_id": 2702, "verse_number": "१२-२०७-३०", "content_sanskrit": "उन्मुचो विमुचश्चैव स्वस्त्यात्रेयश्च वीर्यवान्।\nप्रमुचश्चेध्मवाहश्च भगवांश्च दृढव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2079996, "chapter_id": 2702, "verse_number": "१२-२०७-३१", "content_sanskrit": "मित्रावरुणयोः पुत्रस्तथाऽगस्त्यः प्रतापवान्।\nएते ब्रह्मर्षयो नित्यमास्थिता दक्षिणां दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2079997, "chapter_id": 2702, "verse_number": "१२-२०७-३२", "content_sanskrit": "उषङ्गुः कवषो धौम्यः परिव्याधश्च वीर्यवान्।\nएकतश्च द्वितश्चैव त्रितश्चैवं महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2079998, "chapter_id": 2702, "verse_number": "१२-२०७-३३", "content_sanskrit": "अत्रेः पुत्रश्च दुर्वासास्तथा सारस्वतः प्रभुः।\nएते चैव महात्मानः पश्चिमामाश्रिता दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2079999, "chapter_id": 2702, "verse_number": "१२-२०७-३४", "content_sanskrit": "अत्रिश्चैव वसिष्ठश्च काश्यपश्च महानुषिः।\nगौतमोऽथ भरद्वाजो विश्वामित्रोऽथ कौशिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2080000, "chapter_id": 2702, "verse_number": "१२-२०७-३५", "content_sanskrit": "तथैव पुत्रो भगवानृचीकस्य महात्मनः।\nजमदग्निश्च सप्तैते उदीचीमाश्रिता दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2080001, "chapter_id": 2702, "verse_number": "१२-२०७-३६", "content_sanskrit": "एते प्रतिदिशं सर्वे कीर्तितास्तिग्मतेजसः।\nसाक्षिभूता महात्मानो भुवनानां प्रभावनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2080002, "chapter_id": 2702, "verse_number": "१२-२०७-३७", "content_sanskrit": "एवमेते महात्मानः स्थिताः प्रत्येकशो दिशम्।\nएतेषां कीर्तनं कृत्वा सर्वपापात्प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2080003, "chapter_id": 2702, "verse_number": "१२-२०७-३८", "content_sanskrit": "यस्यांयस्यां दिशि ह्येते तां दिशं शरणं गतः।\nमुच्यते सर्वपापेभ्यः स्वस्तिमांश्च तथा भवेत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2080004, "chapter_id": 2702, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि सप्ताधिकद्विशततमोऽध्यायः॥ २०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]