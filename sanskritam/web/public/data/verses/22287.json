[{"id": 7002287000, "chapter_id": 22287, "verse_number": "३३२-१", "content_sanskrit": "अग्निरुवाच ।\nवृत्तं समञ्चार्द्धसमं विषमञ्च त्रिधा वदे ।\nसमन्तावत् कृत्वकृतमर्द्धसमञ्च कारयेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002287001, "chapter_id": 22287, "verse_number": "३३२-२", "content_sanskrit": "पिषमञ्चैव वास्यूनमतिवृत्तं समान्यपि ।\nग्लौचतुःप्रमाणी स्यादाभ्यामन्यद्वितानकं ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002287002, "chapter_id": 22287, "verse_number": "३३२-३", "content_sanskrit": "पादस्याद्यन्तु वक्रं स्यात् शनौ न प्रथमास्मृतौ ।\nबाल्यमुश्चतुर्थाद्वर्णात् पथ्या वर्णं युजेयतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002287003, "chapter_id": 22287, "verse_number": "३३२-४", "content_sanskrit": "विपरीतपथ्यान्या साच्चपला वा युजस्वनः ।\nविपुलायुग्नसप्तमः सर्व्वं तस्यैव तस्य च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002287004, "chapter_id": 22287, "verse_number": "३३२-५", "content_sanskrit": "तौन्तौ वा विपुलानेका चक्रजातिः समीरिता ।\nभवेन् पदचतुरूद्र्ध्वं चतुर्वृद्ध्या पदेषु च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002287005, "chapter_id": 22287, "verse_number": "३३२-६", "content_sanskrit": "गुरुद्वयान्त आपीडः प्रत्यापीडो गणादिकः ।\nप्रथमस्य विपर्य्यासे मञ्जरी लवणी क्रमात् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002287006, "chapter_id": 22287, "verse_number": "३३२-७", "content_sanskrit": "भवेदमृतधाराख्या उद्धताद्य्चयतेऽधुना ।\nएकतः ससजसानः स्युर्न सौ जो गोऽथ भौनजौ ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002287007, "chapter_id": 22287, "verse_number": "३३२-८", "content_sanskrit": "नोगोऽथ सजसा गोगस्तृतीयचरणस्य च ।\nसौरभे केचनभगा ललितञ्च नमौ जसौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002287008, "chapter_id": 22287, "verse_number": "३३२-९", "content_sanskrit": "उपस्थितं प्रचुपितं प्रथमाद्यं समौ जसौ ।\nगोगथां मलजा रोगः समो नगरजयाः पदे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002287009, "chapter_id": 22287, "verse_number": "३३२-१०", "content_sanskrit": "वर्द्धमानं मलौ स्वौ नसौ अथो भोजोव इरिता ।\nशुद्धविराड़ार्षभाख्यं वक्ष्ये चार्द्धसमन्ततः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]