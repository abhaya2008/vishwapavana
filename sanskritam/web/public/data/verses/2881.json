[{"id": 2088418, "chapter_id": 2881, "verse_number": "१३-११-१", "content_sanskrit": "युधिष्ठिर उवाच।\nआनृशंस्यस्य धर्मज्ञ गुणान्भक्तजनस्य च।\nश्रोतुमिच्छामि धर्मज्ञ तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088419, "chapter_id": 2881, "verse_number": "१३-११-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088420, "chapter_id": 2881, "verse_number": "१३-११-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nवासवस्य च संवादं शुकस्य च महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088421, "chapter_id": 2881, "verse_number": "१३-११-३", "content_sanskrit": "विषये काशिराजस्य ग्रामान्निष्क्रम्य लुब्धकः।\nसविषं काण्डमादाय मृगयामास वै मृगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088422, "chapter_id": 2881, "verse_number": "१३-११-४", "content_sanskrit": "तत्र चामिषलुब्धेन लुब्धकेन महावने।\nअविदूरे मृगान्दृष्ट्वा बाणः प्रतिसमाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088423, "chapter_id": 2881, "verse_number": "१३-११-५", "content_sanskrit": "तेन दुर्वारितास्त्रेण निमित्तचपलेषुणा।\nमहान्वनतरुस्तत्र विद्धो मृगजिघांसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088424, "chapter_id": 2881, "verse_number": "१३-११-६", "content_sanskrit": "स तीक्ष्णविषदिग्धेन शरेणातिबलात्क्षतः।\nउत्सृज्य फलपत्राणि पादपः शोषमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088425, "chapter_id": 2881, "verse_number": "१३-११-७", "content_sanskrit": "तस्मिन्वृक्षे तथाभूते कोटरेषु चिरोषितः।\nन जहाति शुको वासं तस्य भक्त्या वनस्पतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088426, "chapter_id": 2881, "verse_number": "१३-११-८", "content_sanskrit": "निष्प्रचारो निराहारो ग्लानः शिथिलवागपि।\nकृतज्ञः सह वृक्षेण धर्मात्मा सोप्यशुष्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088427, "chapter_id": 2881, "verse_number": "१३-११-९", "content_sanskrit": "तमुदारं महासत्वमतिमानुषचेष्टितम्।\nसमदुःखसुखं दृष्ट्वा विस्मितः पाकशासनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088428, "chapter_id": 2881, "verse_number": "१३-११-१०", "content_sanskrit": "ततश्चिन्तामुपगतः शक्रः कथमयं द्विजः।\nतिर्यग्योनावसम्भाव्यमानृशंस्यमवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088429, "chapter_id": 2881, "verse_number": "१३-११-११", "content_sanskrit": "अथवा नात्र चित्रं हीत्यभवद्वासवस्य तु।\nप्राणिनामपि सर्वेषां सर्वं सर्वत्र दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088430, "chapter_id": 2881, "verse_number": "१३-११-१२", "content_sanskrit": "ततो ब्राह्मणवेषेणि मानुषं रूपमास्थितः।\nअवतीर्य महीं शक्रस्तं पक्षिणमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088431, "chapter_id": 2881, "verse_number": "१३-११-१३", "content_sanskrit": "शुक भो पक्षिणांश्रेष्ठ दाक्षेयी सुप्रजास्त्वया।\nपृच्छे त्वां शुकमेनं त्वं कस्मान्न त्यजसि द्रुमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088432, "chapter_id": 2881, "verse_number": "१३-११-१४", "content_sanskrit": "अथ पृष्टः शुकः प्राह मूर्ध्ना समभिवाद्य तम्।\nस्वागतं देवराज त्वं विज्ञातस्तपसा मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2088433, "chapter_id": 2881, "verse_number": "१३-११-१५", "content_sanskrit": "ततो दशशताक्षेण साधुसाध्विति भाषितम्।\nअहो विज्ञानमित्येवं मनसा पूजितस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2088434, "chapter_id": 2881, "verse_number": "१३-११-१६", "content_sanskrit": "तमेवं शुभकर्माणं शुकं परमधार्मिकम्।\nजानन्नपि च तत्पापं पप्रच्छ बलसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2088435, "chapter_id": 2881, "verse_number": "१३-११-१७", "content_sanskrit": "निष्पत्रमफलं शुष्कमशरण्यं पतत्त्रिणाम्।\nकिमर्थं सेवसे वृक्षं यदा महदिदं वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2088436, "chapter_id": 2881, "verse_number": "१३-११-१८", "content_sanskrit": "अन्येऽपि बहवो वृक्षाः पत्रसंछन्नकोटराः।\nशुभाः पर्याप्तसञ्चारा विद्यन्तेऽस्मिन्महावने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2088437, "chapter_id": 2881, "verse_number": "१३-११-१९", "content_sanskrit": "गतायुषमसामर्थ्यं क्षीणसारं हतश्रियम्।\nविमृश्य प्रज्ञया धीर जहीमं ह्यस्थिरं द्रुमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2088438, "chapter_id": 2881, "verse_number": "१३-११-२०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2088439, "chapter_id": 2881, "verse_number": "१३-११-२०", "content_sanskrit": "तदुपश्रुत्य धर्मात्मा शुकः शक्रेण भाषितम्।\nसुदीर्घमतिनिःश्वस्य दीनो वाक्यमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2088440, "chapter_id": 2881, "verse_number": "१३-११-२१", "content_sanskrit": "अनतिक्रमणीयानि दैवतानि शचीपते।\nयत्राभवंस्तत्र भवांस्तन्निबोध सुराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2088441, "chapter_id": 2881, "verse_number": "१३-११-२२", "content_sanskrit": "अस्मिन्नहं द्रुमे जातः साधुभिश्च गुणैर्युते।\nचालभावेन सङ्गुप्तः शत्रुभिश्च न धर्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2088442, "chapter_id": 2881, "verse_number": "१३-११-२३", "content_sanskrit": "किमनुक्रोश्यं वैफल्यमुत्पादयसि मेऽनघ।\n`अनुरक्तस्य भक्तस्य संस्पृशे न च पावकम्।\nआनृशंस्याभियुक्तस्य भक्तस्यानन्यगस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2088443, "chapter_id": 2881, "verse_number": "१३-११-२४", "content_sanskrit": "अनुक्रोशो हि साधूनां महद्धर्मस्य लक्षणम्।\nअनुक्रोशश्च साधूनां सदा प्रीतिं प्रयच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2088444, "chapter_id": 2881, "verse_number": "१३-११-२५", "content_sanskrit": "त्वमेव दैवतैः सर्वैः पृच्छ्यसे धर्मसंशयात्।\nअतस्त्वं देवदेवानामाधिपत्ये प्रतिष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2088445, "chapter_id": 2881, "verse_number": "१३-११-२६", "content_sanskrit": "नार्हसे मां सहस्राक्ष द्रुमं त्याजयितुं चिरात्।\nसमस्थमुपजीवन्वै विषमस्थं कथं त्यजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2088446, "chapter_id": 2881, "verse_number": "१३-११-२७", "content_sanskrit": "तस्य वाक्येन सौम्येन हर्षितः पाकशासनः।\nशुकं प्रोवाच धर्मज्ञमानृशंस्येन तोषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2088447, "chapter_id": 2881, "verse_number": "१३-११-२८", "content_sanskrit": "वरं वृणीष्वेति तदा स च वव्रे वरं शुकः।\nआनृशंस्यपरो नित्यं तस्य वृक्षस्य सम्भवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2088448, "chapter_id": 2881, "verse_number": "१३-११-२९", "content_sanskrit": "विदित्वा च दृढां भक्तिं तां शुके शीलसम्पदम्।\nप्रीतः क्षिप्रमथो वृक्षममृतेनावसिक्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2088449, "chapter_id": 2881, "verse_number": "१३-११-३०", "content_sanskrit": "ततः फलानि पत्राणि शाखाश्चापि मनोहराः।\nशुकस्य दृढभक्तित्वाच्छ्रीमत्तां प्राप स द्रुमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2088450, "chapter_id": 2881, "verse_number": "१३-११-३१", "content_sanskrit": "शुकश्च कर्मणा तेन आनृशंस्यकृतेन वै।\nआयुषोन्ते महाराज प्राप शक्रसलोकताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2088451, "chapter_id": 2881, "verse_number": "१३-११-३२", "content_sanskrit": "एवमेव मनुष्येन्द्र भक्तिमन्तं समाश्रितः।\nसर्वार्थसिद्धिं लभते शुकं प्राप्य यथा द्रुमः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2088452, "chapter_id": 2881, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकादशोऽध्यायः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]