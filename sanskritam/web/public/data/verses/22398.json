[{"id": 7002398000, "chapter_id": 22398, "verse_number": "१-६०-१", "content_sanskrit": "सुमन्तुरुवाच ।\nइत्युक्त्वा स जगामाशु सुरज्येष्ठं त्रिलोचनम् ।\nरथयात्रा महाबाहो सूर्यस्येत्यमितौजसः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002398001, "chapter_id": 22398, "verse_number": "१-६०-२", "content_sanskrit": "शतानीक उवाच ।\nयमाराध्य जगन्नाथं मम पूर्वपितामहाः ।\nतुष्ट्यर्थं ब्राह्मणानां तु अन्नमापुश्चतुर्विधम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002398002, "chapter_id": 22398, "verse_number": "१-६०-३", "content_sanskrit": "तस्य देवस्य माहात्म्यं श्रुतं च बहुशो मया ।\nदेवर्षिसिद्धमनुजैः स्तुतस्य हि दिनेदिने ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002398003, "chapter_id": 22398, "verse_number": "१-६०-४", "content_sanskrit": "कः स्तोतुमीशस्तमजं१ यस्यैतत्सचराचरम् ।\nअव्ययस्याप्रमेयस्य विबुध्येतोदयाज्जगत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002398004, "chapter_id": 22398, "verse_number": "१-६०-५", "content_sanskrit": "कराभ्यां यस्य देवेशौ कविष्णू लोकपूजितौ ।\nउत्पन्नौ द्विजशार्दूल ललाटात्त्रिपुरान्तकः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002398005, "chapter_id": 22398, "verse_number": "१-६०-६", "content_sanskrit": "तस्य देवस्य कैः शक्या वक्तुं सर्वा विभूतयः ।\nसोऽहमिच्छामि देवस्य तस्य सर्वात्मना द्विज ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002398006, "chapter_id": 22398, "verse_number": "१-६०-७", "content_sanskrit": "श्रोतुमाराधनं येन निस्तरेयं भवार्णवम् ।\nकेनोपायेन मन्त्रैर्वा रहस्यैः परिचर्यया ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002398007, "chapter_id": 22398, "verse_number": "१-६०-८", "content_sanskrit": "दानैर्वृतोपवासैर्वा होमैर्जाप्यैरथापि वा ।\nआराधितः समस्तानां क्लेशानां हानिदो भवेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002398008, "chapter_id": 22398, "verse_number": "१-६०-९", "content_sanskrit": "सैका विद्या हि विद्यानां यया तुष्यति सर्वकृत् ।\nश्रुतानामपि तत्पुण्यं यत्र भानोः प्रकीर्तनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002398009, "chapter_id": 22398, "verse_number": "१-६०-१०", "content_sanskrit": "रहस्यानां रहस्यं तद्येन हंसः प्रसीदति ।\nएकः श्रेष्ठतमो मंत्रस्तदेकं परमं व्रतम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002398010, "chapter_id": 22398, "verse_number": "१-६०-११", "content_sanskrit": "उपोषितं च तच्छ्रेष्ठं येन भानुः प्रसीदति ।\nसा चैका रसना धन्या मार्तण्डं स्तौति या सदा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002398011, "chapter_id": 22398, "verse_number": "१-६०-१२", "content_sanskrit": "तदेकं निर्मलं चित्तं यद्गतं सततं रवौ ।\nश्लाघ्यानामपि तौ श्लाघ्याविह लोके परत्र च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002398012, "chapter_id": 22398, "verse_number": "१-६०-१३", "content_sanskrit": "यो सदा द्विजशार्दूल भानोः पूजाकरौ करौ ।\nतदेकं केवलं धन्यं शरीरं सर्वजन्तुषु ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002398013, "chapter_id": 22398, "verse_number": "१-६०-१४", "content_sanskrit": "यदेव पुलकोद्भासि भानोर्नामानुकीर्तने ।\nसा जिह्वा कण्ठतालूकमथ वा प्रतिजिह्विका ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002398014, "chapter_id": 22398, "verse_number": "१-६०-१५", "content_sanskrit": "अथ वा सापरो रोगो या न वक्ति रवेर्गुणम् ।\nनवद्वाराणि सन्त्यस्मिन्पुरे पुरुषसत्तम ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002398015, "chapter_id": 22398, "verse_number": "१-६०-१६", "content_sanskrit": "प्राकारैस्त्वावृते विष्वग्वृथा तानि विदुर्बुधाः ।\nदत्त्वावधानं यच्छब्दे विनैव रविसंस्तुतिम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002398016, "chapter_id": 22398, "verse_number": "१-६०-१७", "content_sanskrit": "श्रेयसां न हि ।\nसम्प्राप्तौ पुरुषाणां विचेष्टितम् ।\nजन्मन्यविफला सेवा कृता याश्रित्य भास्करम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002398017, "chapter_id": 22398, "verse_number": "१-६०-१८", "content_sanskrit": "दुर्गसंसारकांतारमपारमभिधावताम् ।\nएको भानुनमस्कारः संसारार्णवतारकः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002398018, "chapter_id": 22398, "verse_number": "१-६०-१९", "content_sanskrit": "रत्नानामाकरो मेरुः सर्वाश्चर्यमयं नभः ।\nतीर्थानामाश्रयो गंगा देवानामाश्रयो रविः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002398019, "chapter_id": 22398, "verse_number": "१-६०-२०", "content_sanskrit": "एवमादिगुणो भोगो भानोरमिततेजसः ।\nश्रुतो मे बहुशः सिद्धैर्गीयमानैस्तथामरैः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002398020, "chapter_id": 22398, "verse_number": "१-६०-२१", "content_sanskrit": "सोऽहमिच्छामि तं देवं सप्तलोकपरायणम् ।\nदिवाकरमशेषस्य जगतो हृद्यवस्थितम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002398021, "chapter_id": 22398, "verse_number": "१-६०-२२", "content_sanskrit": "आराधयितुमीशेशं भास्करं चामितौजसम् ।\nमार्तण्डं भुवनाधारं स्मृतमात्राघदारिणम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]