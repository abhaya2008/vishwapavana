rit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008088, "chapter_id": 8616, "verse_number": "7.10", "content_sanskrit": "अतः कैर्विशेषणैर्विशिष्ट इति प्रश्ने..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008089, "chapter_id": 8616, "verse_number": "7.11", "content_sanskrit": "तत्त्वमसीत्यादिवाक्ये..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900008090, "chapter_id": 8616, "verse_number": "7.12", "content_sanskrit": "अङ्गीक्रियमाणत्वाद्विशिष्टादे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900008091, "chapter_id": 8616, "verse_number": "7.13", "content_sanskrit": "अङ्गीक्रियमाणत्वाद्विशिष्टादे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900008092, "chapter_id": 8616, "verse_number": "7.14", "content_sanskrit": "दृष्टस्य वस्तुनो..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900008093, "chapter_id": 8616, "verse_number": "7.15", "content_sanskrit": "दृष्टस्य वस्तुनो..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]