[{"id": 2028833, "chapter_id": 1627, "verse_number": "३-२६५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028834, "chapter_id": 1627, "verse_number": "३-२६५-१", "content_sanskrit": "तस्मिन्बहुमृगेऽरण्ये अटमाना महारथाः।\nकाम्यके भरतश्रेष्ठा विजह्वुस्ते यथामराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028835, "chapter_id": 1627, "verse_number": "३-२६५-२", "content_sanskrit": "प्रेक्षमाणा बहुविधान्वनोद्देशान्समन्ततः।\nयथर्तुकालरम्याश्चवनराजीः सुषुष्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028836, "chapter_id": 1627, "verse_number": "३-२६५-३", "content_sanskrit": "पाण्डवा मृगयाशीलाश्चरन्तस्तन्महद्वनम्।\nविजह्नरिन्द्रप्रिमाः कंचित्कालमरिंदमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028837, "chapter_id": 1627, "verse_number": "३-२६५-४", "content_sanskrit": "ततस्ते यौगपद्येन ययुः सर्वे चतुर्दिशम्।\nमृगयां पुरुषव्याघ्रा ब्राह्मणार्थे परतपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028838, "chapter_id": 1627, "verse_number": "३-२६५-५", "content_sanskrit": "द्रौपदीमाश्रमे न्यस् तृणबिन्दोरनुज्ञया।\nमहर्षेर्दीप्ततपसो घौम्यस्य च पुरोधसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028839, "chapter_id": 1627, "verse_number": "३-२६५-६", "content_sanskrit": "तस्तु राजा सिंधूनां वार्धक्षत्रिर्महायशाः।\nविवाहकामः साल्वेयान्प्रयातः सोऽभवत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028840, "chapter_id": 1627, "verse_number": "३-२६५-७", "content_sanskrit": "महता परिबर्हेण राजयोग्येन संवृतः।\nराजभिर्बहुभिः सार्धमुपायात्काम्यकं च सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028841, "chapter_id": 1627, "verse_number": "३-२६५-८", "content_sanskrit": "तत्रापश्यत्प्रियां भार्यां पाण्डवानां यशस्विनीम्।\nतिष्ठन्तीमाश्रमद्वारि द्रौपदीं निर्जने वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028842, "chapter_id": 1627, "verse_number": "३-२६५-९", "content_sanskrit": "विभ्राजमानां वपुषा बिभ्रतीं रूपमुत्तमम्।\nभ्राजयन्तीं वनोद्देशं नीलाभ्रमिव विद्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028843, "chapter_id": 1627, "verse_number": "३-२६५-१०", "content_sanskrit": "अप्सरा देवकन्या वा माया वा देवनिर्मिता।\nइतिकृत्वाञ्जलिं सर्वे ददृशृस्तामनिन्दिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028844, "chapter_id": 1627, "verse_number": "३-२६५-११", "content_sanskrit": "तः स राजा सिन्धूनां वार्धक्षत्रिर्जयद्रथः।\nविस्मितस्त्वनवद्याङ्गीं दृष्ट्वा तां दुष्टमानसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028845, "chapter_id": 1627, "verse_number": "३-२६५-१२", "content_sanskrit": "स कोटिकाश्यं राजानमब्रवीत्काममोहितः।\nकस्य त्वेषाऽनवद्याङ्गी यदिवाऽपिन मानुषी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028846, "chapter_id": 1627, "verse_number": "३-२६५-१३", "content_sanskrit": "विवाहार्थो न मे कश्चिदिमां दृष्ट्वाऽतिमुन्दरीम्।\nएतामेवाहमादाय गमिष्यामि स्वमालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028847, "chapter_id": 1627, "verse_number": "३-२६५-१४", "content_sanskrit": "गच्छ जानीहि सौम्येमां कस्य वाऽत्र कुतोपि वा।\nकिमर्थमागता सुभ्रूरिदं कष्टकितं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028848, "chapter_id": 1627, "verse_number": "३-२६५-१५", "content_sanskrit": "अपि नाम वरारोहा मामेषा लोकसुन्दरी।\nभजेदद्यायतापाङ्गी सुदती तनुमध्यमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2028849, "chapter_id": 1627, "verse_number": "३-२६५-१६", "content_sanskrit": "अप्यहं कृतकामः स्यामिमां प्राप्य वरस्रियम्।\nगच्छजानीहि कोन्वस्या नाथ इत्येव कोटिक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2028850, "chapter_id": 1627, "verse_number": "३-२६५-१७", "content_sanskrit": "स कोटिकाश्यस्तच्छ्रुत्वा रथात्प्रस्कन्द्य कुण्डली।\nउपेत्यपप्रच्छ तदा क्रोष्टा व्याघ्रवधूमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2028851, "chapter_id": 1627, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि द्रौपदीहरणपर्वणि पञ्चषष्ट्यधिकद्विशततमोऽध्यायः ॥ २६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]