[{"id": 7004966000, "chapter_id": 24966, "verse_number": "७-१-१४९-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि भैरवेश्वरमुत्तमम् ।\nब्रह्मकुण्डस्य ईशाने स्थितं पापप्रणाशनम् ।\nचतुर्वक्त्रं महादेवं संस्थितं तीर्थरक्षणे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004966001, "chapter_id": 24966, "verse_number": "७-१-१४९-२", "content_sanskrit": "तत्र स्नात्वा महाकुण्डे यस्तं पूजयते नरः ।\nपंचोपचारविधिना भक्तियुक्तो यतेन्द्रियः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004966002, "chapter_id": 24966, "verse_number": "७-१-१४९-३", "content_sanskrit": "कुलानि यान्यतीतानि भविष्याणि च यानि वै ।\nतारयेत्स नरो देवि नात्र कार्या विचारणा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004966003, "chapter_id": 24966, "verse_number": "७-१-१४९-४", "content_sanskrit": "न चात्र संभवस्तस्य विनाशो नैव जायते ।\nविमानैश्चरते नित्यं दिवाकरसमप्रभैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004966004, "chapter_id": 24966, "verse_number": "७-१-१४९-५", "content_sanskrit": "स्त्रीसहस्रैर्वृतो नित्यं क्रीडते देवव द्दिवि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004966005, "chapter_id": 24966, "verse_number": "७-१-१४९-६", "content_sanskrit": "एतल्लिंगं महादेवि चतुर्वक्त्रं महाप्रभम् ।\nदृष्ट्वापि तद्विमुच्येत सर्वपापैस्तु मानवः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]