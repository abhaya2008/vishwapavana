[{"id": 7006594000, "chapter_id": 26594, "verse_number": "३-१३३-१", "content_sanskrit": "त्रिपुरवधस्य कथा जनमेजय उवाच त्र्यक्षाद् वधमहं ब्रह्मञ्छ्रोतुमिच्छामि तत्त्वतः ।\nत्रयाणां पुरसंज्ञानां खेचराणां समासतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006594001, "chapter_id": 26594, "verse_number": "३-१३३-२", "content_sanskrit": "वैशम्पायन उवाच शृणु विस्तरतः सर्वं यन्मां पृच्छसि नैधनम् ।\nदैत्यानां बाहुबलिनां सर्वप्राणिविरोधिनाम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006594002, "chapter_id": 26594, "verse_number": "३-१३३-३", "content_sanskrit": "शंकरेण वधं राजञ्शूलैस्त्रिभिरजिह्मगैः ।\nकृतं पुरासुरेन्द्राणां सर्वभूतवधैषिणाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006594003, "chapter_id": 26594, "verse_number": "३-१३३-४", "content_sanskrit": "त्रिपुरं पुरुषव्याघ्र वृहद्धातुसमीरितम् ।\nविक्रामति नभोमध्ये मेघवृन्दमिवोत्थितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006594004, "chapter_id": 26594, "verse_number": "३-१३३-५", "content_sanskrit": "प्राकारेण प्रवृद्धेन काञ्चनेन विराजता ।\nमणिभिश्च प्रकाशद्भिः सर्वरत्नैश्च तोरणैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006594005, "chapter_id": 26594, "verse_number": "३-१३३-६", "content_sanskrit": "बभासे नभसो मध्ये श्रिया परमया ज्वलत् ।\nगन्धर्वाणामिवोदग्रं कर्मणा साधितं पुरम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006594006, "chapter_id": 26594, "verse_number": "३-१३३-७", "content_sanskrit": "वाजिनः पक्षसंयुक्ता वहन्ति बलदर्पिताः ।\nपुरं प्रभाकरश्रेष्ठं मनोभिः कामबृंहणैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006594007, "chapter_id": 26594, "verse_number": "३-१३३-८", "content_sanskrit": "धावन्ति ह्रेषमाणास्ते विक्रमैः प्राणसम्भृतैः ।\nआहूयत इवाकाशं खुरैः श्यामदलप्रभैः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006594008, "chapter_id": 26594, "verse_number": "३-१३३-९", "content_sanskrit": "वायुवेगसमैर्वेगैः कालयन्त इवाम्बरम् ।\nअसुराः समदृश्यन्त चक्षुर्भिर्विदितात्मभिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006594009, "chapter_id": 26594, "verse_number": "३-१३३-१०", "content_sanskrit": "ऋषिभिर्ज्वलनप्रख्यैस्तपसा दग्धकिल्बिषैः ।\nगीतवादित्रबहुलं गन्धर्वनगरोपमम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006594010, "chapter_id": 26594, "verse_number": "३-१३३-११", "content_sanskrit": "चित्रायुधसमाकीर्णैः प्रतप्तकनकप्रभैः ।\nभवनैर्बहुभिश्चैव प्रांशुभिः समलंकृतैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006594011, "chapter_id": 26594, "verse_number": "३-१३३-१२", "content_sanskrit": "देवेन्द्रभवनाकारैः शुशुभे तन्महाद्युति ।\nप्रासादाग्रैः प्रवृद्धैश्च कैलासशिखरप्रभैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006594012, "chapter_id": 26594, "verse_number": "३-१३३-१३", "content_sanskrit": "शुशुभे दैत्यनगरं बहुसूर्यमिवाम्बरम् ।\nवराट्टालकसम्पन्नं तप्तकाञ्चनसप्रभम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006594013, "chapter_id": 26594, "verse_number": "३-१३३-१४", "content_sanskrit": "प्रदीप्तमिव तेजोभी रराजाथ महाप्रभो ।\nक्ष्वेडितोत्क्रुष्टबहुलं सिंहनादविनादितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006594014, "chapter_id": 26594, "verse_number": "३-१३३-१५", "content_sanskrit": "बभौ वल्गुजनाकीर्ण वनं चैत्ररथं यथा ।\nसमुच्छ्रितपताकं तदसिभिश्च विराजितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006594015, "chapter_id": 26594, "verse_number": "३-१३३-१६", "content_sanskrit": "रराज त्रिपुरं राजन् महाविद्युदिवाम्बरे ।\nसूर्यनाभश्च दैत्येन्द्रश्चन्द्रनाभश्च भारत ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006594016, "chapter_id": 26594, "verse_number": "३-१३३-१७", "content_sanskrit": "तथान्ये च महावीर्या दानवा बलदर्पिताः ।\nममृदुश्च बभञ्जुश्च मोहिताः परमेष्ठिना ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006594017, "chapter_id": 26594, "verse_number": "३-१३३-१८", "content_sanskrit": "पन्थानं देवगमनं पितृयानं च भारत ।\nतैरेवमसुराग्रैश्च प्रगृहीतशरासनैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006594018, "chapter_id": 26594, "verse_number": "३-१३३-१९", "content_sanskrit": "दानवैर्नरशार्दूल देवयाने महापथे ।\nपितृवह्नियलोपेते हृते भरतसत्तम ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006594019, "chapter_id": 26594, "verse_number": "३-१३३-२०", "content_sanskrit": "ब्रह्माणमभ्यधावन्त सर्वे सुरगणास्तथा ।\nविवर्णवदना दीनाश्छिन्ने वै गतिकर्मणि ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006594020, "chapter_id": 26594, "verse_number": "३-१३३-२१", "content_sanskrit": "अब्रुवंश्च गताः स्थित्वा स्वरेणार्तनिनादिना ।\nहन्यामहे शत्रुगणैर्भागोच्छेदेन भागद ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006594021, "chapter_id": 26594, "verse_number": "३-१३३-२२", "content_sanskrit": "तेषां चैव वधोपायं वदस्व वदतां वर ।\nयं ज्ञात्वा बाहुबलिनो बाधेम समरे परान् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006594022, "chapter_id": 26594, "verse_number": "३-१३३-२३", "content_sanskrit": "सान्त्वयित्वा तु वरदो ब्रह्मा प्रोवाच देवताः ।\nशृणुध्वं देवताः सर्वाः शत्रुप्रतिकृतिं पराम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006594023, "chapter_id": 26594, "verse_number": "३-१३३-२४", "content_sanskrit": "अवध्या दानवाः सर्वे ऋते शंकरमव्ययम् ।\nप्रतिगृह्य च तद् वाक्यं मनोभिर्वाग्भिरेव च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006594024, "chapter_id": 26594, "verse_number": "३-१३३-२५", "content_sanskrit": "भूमौ प्रपेदिरे सर्वे सह रुद्रैश्च भारत ।\nविन्ध्यपादे च मेरौ च मध्ये च पृथिवीतले ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006594025, "chapter_id": 26594, "verse_number": "३-१३३-२६", "content_sanskrit": "तपसोग्रेण योगज्ञा सर्वे ते मुनयोऽभवन् ।\nकाश्यपेयं हरं प्राप्ता जपन्तो ब्रह्मसंहिताम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006594026, "chapter_id": 26594, "verse_number": "३-१३३-२७", "content_sanskrit": "तेषां च परदाराणामभवद् वन्ध्यता जने ।\nविन्यस्तदर्भनिचये ताम्रलोहं च भूषणम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006594027, "chapter_id": 26594, "verse_number": "३-१३३-२८", "content_sanskrit": "परिधानानि चर्माणि मृदूनि च शुभानि च ।\nस्वयं मृतानां कृष्णानां मृगाणां कुरुसत्तम ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006594028, "chapter_id": 26594, "verse_number": "३-१३३-२९", "content_sanskrit": "गृहीतानि विमुक्तानि देहेभ्यो वनचारिणाम् ।\nअन्तरिक्षमथोपेत्य विविशुर्माययाऽऽवृताः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006594029, "chapter_id": 26594, "verse_number": "३-१३३-३०", "content_sanskrit": "हरालयं सुराः सर्वे व्याघ्रचर्भनिवासिनः ।\nप्रणिपत्याथ ते दीना भगवन्तं जगत्पतिम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006594030, "chapter_id": 26594, "verse_number": "३-१३३-३१", "content_sanskrit": "सुव्यक्तेनाभिधानेन प्रभाषन्त हरं ततः ।\nहविर्दत्तमविज्ञानाद् भस्मच्छन्नेषु वह्निषु ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006594031, "chapter_id": 26594, "verse_number": "३-१३३-३२", "content_sanskrit": "वरदानं वृथास्मासु भगवन् विमुखे त्वयि ।\nयथादेशं यथाकालं क्रियतां ब्रह्मणो वचः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006594032, "chapter_id": 26594, "verse_number": "३-१३३-३३", "content_sanskrit": "यदुक्तं देवदेवेन खेचराणां समीपतः ।\nएवं देववचोभिश्च भाविनोऽर्थस्य वैभवात् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006594033, "chapter_id": 26594, "verse_number": "३-१३३-३४", "content_sanskrit": "समनह्यन्महादेवो देवैः सह सवासवैः ।\nआदित्यपथमास्थाय संनद्धाः समलंकृताः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006594034, "chapter_id": 26594, "verse_number": "३-१३३-३५", "content_sanskrit": "सर्वे काञ्चनवर्णाभा बभुर्दीप्ता इवाग्नयः ।\nरुद्रेण सहिता रुद्रा दहन्त इव तेजसा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006594035, "chapter_id": 26594, "verse_number": "३-१३३-३६", "content_sanskrit": "संनद्धाः कुशलाः सर्वे प्रांशवः पर्वता इव ।\nविश्वे विश्वेन वपुषा बलिनः कामरूपिणः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006594036, "chapter_id": 26594, "verse_number": "३-१३३-३७", "content_sanskrit": "समनह्यन्महात्मानो दानवान्तं विधित्सवः ।\nएभिः सहधनाध्यक्षैः समन्तात् परिवारितः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006594037, "chapter_id": 26594, "verse_number": "३-१३३-३८", "content_sanskrit": "त्रिपुरं योधयत् त्र्यक्षः प्रगृह्य सशरं धनुः ।\nअथ दैत्या भिन्नदेहाः पुराट्टालं गता इव ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006594038, "chapter_id": 26594, "verse_number": "३-१३३-३९", "content_sanskrit": "न्यपतन्त विदेहास्ते विशीर्णा इव पर्वताः ।\nअ तिविद्धाः सुविद्धाश्च रणमध्यगता नृप ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006594039, "chapter_id": 26594, "verse_number": "३-१३३-४०", "content_sanskrit": "न्यपतन् दैत्यसंघाता वज्रेणेव हता नगाः ।\nअसिभिश्च हता देवैः शक्तिचक्रपरश्वधैः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006594040, "chapter_id": 26594, "verse_number": "३-१३३-४१", "content_sanskrit": "बाणैश्च भिन्नमर्माणो दैत्येन्द्रा युद्धगोचरे ।\nप्रपेतुः सहिता उर्व्यां छिन्नपक्षा इवाचलाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006594041, "chapter_id": 26594, "verse_number": "३-१३३-४२", "content_sanskrit": "तत्र संज्ञां विमुञ्चन्ति दीप्यमानेन तेजसा ।\nएवं तेऽन्योन्यसम्बाधे क्षीयन्ते क्षयकर्मणा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006594042, "chapter_id": 26594, "verse_number": "३-१३३-४३", "content_sanskrit": "नोपालभ्यन्त चक्षुर्भ्यामपि दिव्येन चक्षुषा ।\nअस्तं प्राप्ते दिनकरे सुरेन्द्रास्ते निशामुखे ।\nछिन्नभिन्नक्षतमुखा निपेतुर्वसुधातले ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006594043, "chapter_id": 26594, "verse_number": "३-१३३-४४", "content_sanskrit": "अथ दैत्या जयं प्राप्ता निशायां निशितैः शरैः ।\nविनेदुर्विपुलैर्नादैर्मेघा इव महारवाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006594044, "chapter_id": 26594, "verse_number": "३-१३३-४५", "content_sanskrit": "जयप्राप्त्यासुराश्चैव तेऽन्योन्यमभिजल्पिरे ।\nत्रासितास्त्रिदशाः सर्वे संग्रामजयकाङ्क्षिणः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006594045, "chapter_id": 26594, "verse_number": "३-१३३-४६", "content_sanskrit": "अस्माभिर्बलसम्पन्नैः सह प्रासासितोमरैः ।\nविरेजुश्च जयं प्राप्ता उशनोहव्यबोधिताः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006594046, "chapter_id": 26594, "verse_number": "३-१३३-४७", "content_sanskrit": "समरे ब लसम्पन्नाः सायुधा दैत्यसत्तमाः ।\nसुरैश्च सहितः सर्वै रथमास्थाय शंकरः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006594047, "chapter_id": 26594, "verse_number": "३-१३३-४८", "content_sanskrit": "दर्पितान् निनदन् दैत्यान् प्रदहन्निव तेजसा ।\nयुगान्तकाले वितते रश्मिवानिव निर्दहन् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006594048, "chapter_id": 26594, "verse_number": "३-१३३-४९", "content_sanskrit": "सर्वभूतानि भूताग्र्यः प्रलये समुपस्थिते ।\nस रथो वाजिभिः शीघ्रैरुह्यमानो मनोजवैः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006594049, "chapter_id": 26594, "verse_number": "३-१३३-५०", "content_sanskrit": "विबभौ नभसो मध्यं सविद्युदिव तोयदः ।\nवृषभेण .ध्वजाग्रेण गर्जमानेन भारत ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006594050, "chapter_id": 26594, "verse_number": "३-१३३-५१", "content_sanskrit": "भाति स्म स रथो राजन्सेन्द्रायुध इवाम्बुदः ।\nततोऽम्बरगताः सिद्धास्तुष्टुवुर्वृषभध्वजम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006594051, "chapter_id": 26594, "verse_number": "३-१३३-५२", "content_sanskrit": "कर्मभिः पूर्वजं पूर्वैः शुचिभिस्त्र्यम्बकं तदा ।\nऋषयश्च तपःशान्ताः सत्यव्रतपरायणाः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006594052, "chapter_id": 26594, "verse_number": "३-१३३-५३", "content_sanskrit": "अमृतप्राशिनश्चैव सुरसंघास्तथैव च ।\nगन्धर्वाप्सरसश्चैव गान्धर्वेण स्वरेण वै ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006594053, "chapter_id": 26594, "verse_number": "३-१३३-५४", "content_sanskrit": "प्रहृष्टवदनाः सौम्याः पैत्र्ये स्थानान्तरे नृप ।\nचयाट्टालकसम्पन्ने शतघ्नीशतसंकुले ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006594054, "chapter_id": 26594, "verse_number": "३-१३३-५५", "content_sanskrit": "तस्मिंस्तु दैत्यनगरे सर्वभूतभयावहे ।\nततस्तु शरवर्षाणि मुमुचुर्दैत्यदानवाः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006594055, "chapter_id": 26594, "verse_number": "३-१३३-५६", "content_sanskrit": "सुराणामरयो मध्ये तीक्ष्णाग्राणि समन्ततः ।\nशतघ्नीभिश्च निघ्नन्तो भल्लैः शूलैश्च भारत ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006594056, "chapter_id": 26594, "verse_number": "३-१३३-५७", "content_sanskrit": "ते चक्रिरे महत्कर्म दानवा युद्धकोविदाः ।\nगदाभिश्च गदा जघ्नुर्भल्लैर्भल्लांश्च चिच्छिदुः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006594057, "chapter_id": 26594, "verse_number": "३-१३३-५८", "content_sanskrit": "अस्त्रैरस्त्राण्यबाधन्त माया मायाभिरेव च ।\nततोऽपरे समुद्यम्य शरशक्तिपरश्वधान् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006594058, "chapter_id": 26594, "verse_number": "३-१३३-५९", "content_sanskrit": "अशनींश्च महाघोरानमुञ्चन्त सहस्रशः ।\nअसिभिर्मायाविहितैर्मृत्योर्विषयगोचरे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006594059, "chapter_id": 26594, "verse_number": "३-१३३-६०", "content_sanskrit": "ते वध्यमाना विबुधाः शरवर्षैरवस्थिताः ।\nगन्धर्वनगराकारः सोऽसीदत् सहरो रथः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006594060, "chapter_id": 26594, "verse_number": "३-१३३-६१", "content_sanskrit": "हन्यमानोऽसुरगणैः प्रासासिशरतोमरैः ।\nतैश्च दैत्यप्रहरणैर्गुरुभिर्भारसाहिभिः ।\nचित्रैश्च बहुभिः शस्त्रैरतिष्ठत शचीपतिः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006594061, "chapter_id": 26594, "verse_number": "३-१३३-६२", "content_sanskrit": "ततो मध्ये दिव्यशब्दः प्रादुरासीन्महीपते ।\nऋषीणां ब्रह्मपुत्राणां महतामपि भारत ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006594062, "chapter_id": 26594, "verse_number": "३-१३३-६३", "content_sanskrit": "स एष शंकरस्याग्रे रथो भूमिं प्रतिष्ठितः ।\nअजेयो जय्यतां प्राप्तः सर्वलोकस्य पश्यतः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006594063, "chapter_id": 26594, "verse_number": "३-१३३-६४", "content_sanskrit": "तस्मिन्निपतिते राजन् रथानां प्रवरे रथे ।\nनिपेतुः सर्वभूतानि भूतले वसुधाधिप ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006594064, "chapter_id": 26594, "verse_number": "३-१३३-६५", "content_sanskrit": "विचेलुः पर्वताग्राणि चेलुश्चैव महाद्रुमाः ।\nविचुक्षुभुः समुद्राश्च न रेजुश्च दिशो दश ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006594065, "chapter_id": 26594, "verse_number": "३-१३३-६६", "content_sanskrit": "वृद्धाश्च ब्राह्मणास्तत्र जेपुश्च परमं जपम् ।\nयत्तद् ब्रह्ममयं तेजः सर्वत्र विजयैषिणाम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006594066, "chapter_id": 26594, "verse_number": "३-१३३-६७", "content_sanskrit": "शान्त्यर्थं सर्वभूतानामिह लोके परत्र च ।\nसमाधायात्मनाऽऽत्मानं योगप्राप्तेन हेतुना ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006594067, "chapter_id": 26594, "verse_number": "३-१३३-६८", "content_sanskrit": "रथन्तरेण साम्नाथ ब्रह्मभूतेन भारत ।\nतेजसा ज्वलयन्विष्णोस्त्र्यक्षस्य च महात्मनः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006594068, "chapter_id": 26594, "verse_number": "३-१३३-६९", "content_sanskrit": "सर्वेषां चैव देवानां बलिनां कामरूपिणाम् ।\nऋषीणां तपसाऽऽढ्यानां वसतां विजने वने ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006594069, "chapter_id": 26594, "verse_number": "३-१३३-७०", "content_sanskrit": "अथ विष्णुर्महायोगी सर्वतोदृश्य तत्त्वतः ।\nवृषरूपं समास्थाय प्रोज्जहार रथोत्तमम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006594070, "chapter_id": 26594, "verse_number": "३-१३३-७१", "content_sanskrit": "समाक्रान्तं देवगणैः समग्रबलपौरुषैः ।\nबलवांस्तोलयित्वा तु विषाणाभ्यां महाबलः ।\nननाद प्राणयोगेन मथ्यमान इवार्णवः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006594071, "chapter_id": 26594, "verse_number": "३-१३३-७२", "content_sanskrit": "तृतीयं वायुविषयं समाक्रम्य विषाणवान् ।\nननाद बलवान् नादं समुद्र इव पर्वणि ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006594072, "chapter_id": 26594, "verse_number": "३-१३३-७३", "content_sanskrit": "ततो नादेन वित्रस्ता दैतेया युद्धदुर्मदाः ।\nपुनस्ते कृतसन्नाहा युयुधुः सुमहाबलाः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006594073, "chapter_id": 26594, "verse_number": "३-१३३-७४", "content_sanskrit": "सर्वे वै बाहुबलिनः समर्थबलपौरुषाः ।\nसुरसैन्यं प्रमर्दन्तः प्रगृहीतशरासनाः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006594074, "chapter_id": 26594, "verse_number": "३-१३३-७५", "content_sanskrit": "अग्निं संधाय धनुषि शितं बाणं सुपत्रिणम् ।\nब्रह्मास्त्रेणाभिसंयोज्य ब्रह्मदण्डं शिवोऽव्ययः ।\nमुमोच दैत्यनगरे त्रिधाशब्देन संज्ञितम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006594075, "chapter_id": 26594, "verse_number": "३-१३३-७६", "content_sanskrit": "तं बाणं त्रिविधं वीर्यात् संधाय मनसा प्रभुः ।\nसत्येन ब्रह्मयोगेन तपसोग्रेण भारत ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006594076, "chapter_id": 26594, "verse_number": "३-१३३-७७", "content_sanskrit": "मुमोच दैत्यनगरे सर्वप्राणहराञ्छरान् ।\nदीप्तान्कनकवर्णाभान् सुवर्णांश्च सुनिर्मलान् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006594077, "chapter_id": 26594, "verse_number": "३-१३३-७८", "content_sanskrit": "मुक्त्वा वरशरान् घोरान् सविषानिव पन्नगान् ।\nसुप्रदीप्तैस्त्रिभिर्बाणैर्वेगिभिस्तद्विदारितम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006594078, "chapter_id": 26594, "verse_number": "३-१३३-७९", "content_sanskrit": "शरघातप्रदीप्तानि विन्ध्याग्राणीव भारत ।\nगोपुराणि पुरैः सार्धं व्यशीर्यन्त नराधिप ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006594079, "chapter_id": 26594, "verse_number": "३-१३३-८०", "content_sanskrit": "अग्निना सम्प्रदीप्तानि वह्निगर्भाणि भारत ।\nधरणीं सम्प्रपद्यन्त पुराणि वसुधाधिप ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006594080, "chapter_id": 26594, "verse_number": "३-१३३-८१", "content_sanskrit": "तानि वैदूर्यवर्णानि शिखराणि गिरेरिव ।\nशंकरेण प्रदग्धानि ब्रह्मास्त्रेणापतन्नृप ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006594081, "chapter_id": 26594, "verse_number": "३-१३३-८२", "content_sanskrit": "हते च त्रिपुरे देवैर्वाचो हर्षात् किलेरिताः ।\nसर्वाञ्जहीति शत्रूंस्त्वं प्रवृद्धान् पुरुषोत्तम ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006594082, "chapter_id": 26594, "verse_number": "३-१३३-८३", "content_sanskrit": "विष्णुरेव महायोगी योगेन प्रस्मयन्निव ।\nस्तूयते ब्रह्मसदृशैर्ऋषिभिः शंकरेण च ।\nब्रह्मणा सहितैर्देवैः सम्पन्नबलपौरुषैः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}]