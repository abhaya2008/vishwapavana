[{"id": 2105614, "chapter_id": 3280, "verse_number": "१६-९-१", "content_sanskrit": "युधिष्ठिर उवाच।\nएवमेतत्करिष्यामि यथाऽऽत्थ पृथिवीपते।\nभूयश्चैवानुशास्योऽहं भवता पार्थिवर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105615, "chapter_id": 3280, "verse_number": "१६-९-२", "content_sanskrit": "भीष्मे स्वर्गमनुप्राप्तो गते च मधुसूदने।\nविदुरे संजये चैव कोऽन्यो मां वक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105616, "chapter_id": 3280, "verse_number": "१६-९-३", "content_sanskrit": "यत्तु मामनुशास्तीह भवानद्य हिते स्थितः।\nकर्तास्मि तन्महीपाल निर्वृतो भव पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105617, "chapter_id": 3280, "verse_number": "१६-९-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105618, "chapter_id": 3280, "verse_number": "१६-९-४", "content_sanskrit": "एवमुक्तः स राजर्षिर्धर्मराजेन धीमता।\nकौन्तेयं समनुज्ञातुमियेष भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105619, "chapter_id": 3280, "verse_number": "१६-९-५", "content_sanskrit": "पुत्र विश्राम्यतां तावन्ममापि बलवाञ्श्रमः।\nइत्युक्त्वा प्राविशद्राजा गान्धार्या भवनं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105620, "chapter_id": 3280, "verse_number": "१६-९-६", "content_sanskrit": "तमासनगतं देवी गान्धारी धर्मचारिणी।\nउवाच काले कालज्ञा प्रजापतिसमं पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105621, "chapter_id": 3280, "verse_number": "१६-९-७", "content_sanskrit": "अनुज्ञातः स्वयं तेन व्यासेनि त्वं महर्षिणा।\nयुधिष्ठिरस्यानुमते कदाऽरण्यं गमिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105622, "chapter_id": 3280, "verse_number": "१६-९-८x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105623, "chapter_id": 3280, "verse_number": "१६-९-८", "content_sanskrit": "गान्धार्यहमनुज्ञातः स्वयं पित्रा महात्मना।\nयुधिष्ठिरस्यानुमते गन्तास्मि नचिराद्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105624, "chapter_id": 3280, "verse_number": "१६-९-९", "content_sanskrit": "अहं हि तावत्सर्वेषां तेषां दुर्द्यूतदेविनाम्।\nपुत्राणां दातुमिच्छामि प्रेत्यभावानुगं वसु।\nसर्वप्रकृतितिसान्निध्यं कारयित्वा स्ववेश्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105625, "chapter_id": 3280, "verse_number": "१६-९-१०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105626, "chapter_id": 3280, "verse_number": "१६-९-१०", "content_sanskrit": "इत्युक्त्वा धर्मराजाय प्रेषयामास वै तदा।\nस च तद्वचनात्सर्वं समानिन्ये महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105627, "chapter_id": 3280, "verse_number": "१६-९-११", "content_sanskrit": "ततः प्रतीतमनसो ब्राह्मणाः कुरुजाङ्गलाः।\nक्षत्रियाश्चैव वैश्याश्च शूद्राश्चैव समाययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105628, "chapter_id": 3280, "verse_number": "१६-९-१२", "content_sanskrit": "ततो निष्क्रम्य नृपतिस्तस्मादन्तःकपुरात्तदा।\nदद्दशे तं जनं सर्वं सर्वाश्च प्रकृतीस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105629, "chapter_id": 3280, "verse_number": "१६-९-१३", "content_sanskrit": "समवेतांश्च तान्सर्वान्पौराञ्जानपदांस्तथा।\nतानागतानभिप्रेक्ष्य समस्तं च सुहृञ्जनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2105630, "chapter_id": 3280, "verse_number": "१६-९-१४", "content_sanskrit": "ब्राह्मणांश्च महीपाल नानादेशसमागतान्।\nउवाच मतिमान्राजा धृतराष्ट्रोऽम्बिकासुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2105631, "chapter_id": 3280, "verse_number": "१६-९-१५", "content_sanskrit": "भवन्तः कुरुवश्चैव चिरकालं सहोषिताः।\nपरस्परस्य सुहृदः परस्परहिते रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2105632, "chapter_id": 3280, "verse_number": "१६-९-१६", "content_sanskrit": "यदिदानीमहं ब्रूयामस्मिन्काल उपस्थिते।\nतथा भवद्भिः कर्तव्यमविचार्य वचो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2105633, "chapter_id": 3280, "verse_number": "१६-९-१७", "content_sanskrit": "अरण्यगमने बुद्धिर्गान्धारीसहितस्य मे।\nव्यासस्यानुमते राज्ञस्तथा कुन्तीसुतस्य मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2105634, "chapter_id": 3280, "verse_number": "१६-९-१८", "content_sanskrit": "भवन्तोप्यनुजानन्तु मान्या वोऽभूद्विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2105635, "chapter_id": 3280, "verse_number": "१६-९-१९", "content_sanskrit": "अस्माकं भवतां चैव येयं प्रीतिर्हि शाश्वती।\nन च साऽन्येषु देशेषु राज्ञामिति मतिर्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2105636, "chapter_id": 3280, "verse_number": "१६-९-२०", "content_sanskrit": "शान्तोस्मि वयसाऽनेन तथा पुत्रविनाकृतः।\nउपवासकृशश्चास्मि गान्धारीसहितोऽनघाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2105637, "chapter_id": 3280, "verse_number": "१६-९-२१", "content_sanskrit": "युधिष्ठिरगते राज्ये प्राप्तश्चास्मि सुखं महत्।\nमन्ये दुर्योधनैश्वर्याद्विशिष्टं बहुभिर्गुणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2105638, "chapter_id": 3280, "verse_number": "१६-९-२२", "content_sanskrit": "मम चान्धस्य वृद्धस्य हतपुत्रस्य का गतिः।\nऋते वनं महाभागास्तन्माऽनुज्ञातुमर्हथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2105639, "chapter_id": 3280, "verse_number": "१६-९-२३", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा सर्वे ते कुरुजाङ्गलाः।\nबाप्पसंदिग्धया वाचा रुरुदुर्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2105640, "chapter_id": 3280, "verse_number": "१६-९-२४", "content_sanskrit": "तानविब्रुवतः किञ्चित्सर्वाञ्शोकपरायणान्।\nपुनरेव महातेजा धृतराष्ट्रोऽब्रवीदिदम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2105641, "chapter_id": 3280, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि आश्रमवासपर्वणि नवमोऽध्यायः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]