[{"id": 7003746000, "chapter_id": 23746, "verse_number": "२-१-३०-१", "content_sanskrit": "अथ सुवर्णमुखरीवर्णनम् ।\nसूत उवाच ।\nतथा सर्वाणि तीर्थानि समालोक्यागतस्य च ।\nमुदं प्रगुणयाञ्चके सा पार्थस्य महापगा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003746001, "chapter_id": 23746, "verse_number": "२-१-३०-२", "content_sanskrit": "यस्यास्तटनिकुञ्जेषु मोदन्ते वनिताः सुखाः ।\nसिद्धाः संसेविता वातैः शीकरासारशीतलैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003746002, "chapter_id": 23746, "verse_number": "२-१-३०-३", "content_sanskrit": "या समुद्यतहस्तेव गङ्गामाकाशवाहिनीम् ।\nआलिंगितुं समुत्तुंगैः कल्लोलैरभ्रसंगिभिः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003746003, "chapter_id": 23746, "verse_number": "२-१-३०-४", "content_sanskrit": "धूमैराहुतिसंभूतैस्तरुशाखोपलंभिभिः ।\nवल्कलैश्च विराजन्ते यत्तटाश्रमभूमयः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003746004, "chapter_id": 23746, "verse_number": "२-१-३०-५", "content_sanskrit": "मुनीन्द्रैः सुरवर्यैश्च स्थापितानि समन्ततः ।\nयत्तटद्वितये भांति दिव्यलिंगानि शूलिनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003746005, "chapter_id": 23746, "verse_number": "२-१-३०-६", "content_sanskrit": "यदीयसैकतावासविश्रान्ता मानसं सरः ।\nन स्मरंति निजावासं मराला विहगोत्तमाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003746006, "chapter_id": 23746, "verse_number": "२-१-३०-७", "content_sanskrit": "शमितावग्रहातंकैः कुल्यामुखविनिर्गतैः ।\nपुष्णाति तोयैः सस्यानि लोकरक्षाक्षमाणि या ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003746007, "chapter_id": 23746, "verse_number": "२-१-३०-८", "content_sanskrit": "चक्रवाककुचोत्तुंगवीचिवल्लीविभूषिता ।\nआवर्तनाभिविलसत्सैकतश्रोणि मण्डला ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003746008, "chapter_id": 23746, "verse_number": "२-१-३०-९", "content_sanskrit": "प्रफुल्लपद्मवदना चलन्मीनयुगेक्षणा ।\nविलसत्फेनवसना हंसयानमनोहरा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003746009, "chapter_id": 23746, "verse_number": "२-१-३०-१०", "content_sanskrit": "जलपक्षिरवालापा नयनानन्दकारिणी ।\nअपूर्वकामिनीरूपा या विभात्यम्बुधिप्रिया ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003746010, "chapter_id": 23746, "verse_number": "२-१-३०-११", "content_sanskrit": "रोधस्यन्तरवाहिन्या नद्याः प्राच्यां धनञ्जयः ।\nददर्श शैलमुत्तुंगं कालहस्तिसमाहयम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003746011, "chapter_id": 23746, "verse_number": "२-१-३०-१२", "content_sanskrit": "उदग्रशिखराभोगोल्लिखिताकाशमण्डलम् ।\nसप्तपातालमूलाधोरूढमूलोपलांचितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003746012, "chapter_id": 23746, "verse_number": "२-१-३०-१३", "content_sanskrit": "अथ अर्जुनस्य स्वर्णमुखरीतीरस्थकालहस्तीश्वरादिसेवाप्राप्तिः ।\nस्नात्वा तस्यां महानद्यां तस्मिञ्छैले सुरार्चितम् ।\nअपश्यदर्जुनो देवं कालहस्तीशनामकम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003746013, "chapter_id": 23746, "verse_number": "२-१-३०-१४", "content_sanskrit": "संपूज्य च महादेवं नगेन्द्रतनयासखम् ।\nमनसा भक्तियुक्तेन कृतार्थत्वमुपेयिवान् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003746014, "chapter_id": 23746, "verse_number": "२-१-३०-१५", "content_sanskrit": "ततो महागिरौ तस्मिन्नद्भुतैकनिकेतने ।\nचचाराभूतपूर्वाणां विशेषाणां दिदृक्षया ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003746015, "chapter_id": 23746, "verse_number": "२-१-३०-१६", "content_sanskrit": "सिद्धानालोकयामास वसतो गिरिसानुषु ।\nगायतो देवदेवस्य चरित्राण्यबलायुतान् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003746016, "chapter_id": 23746, "verse_number": "२-१-३०-१७", "content_sanskrit": "अप्सरोललनाजुष्टान्पुष्पासवमदाकुलान् ।\nनिकुञ्जेषु समासीनान्गंधर्वानैक्षतादरात् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003746017, "chapter_id": 23746, "verse_number": "२-१-३०-१८", "content_sanskrit": "विविक्तेषु प्रदेशेषु शिवध्यानपरायणान् ।\nअपश्यद्योगिनो दिव्यानादरानन्दशालिनः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003746018, "chapter_id": 23746, "verse_number": "२-१-३०-१९", "content_sanskrit": "प्रशान्तान्याश्रमपदान्यवैक्षत समंततः ।\nबलिनीवारविलसद्द्वारभूमीश्च पाण्डवः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003746019, "chapter_id": 23746, "verse_number": "२-१-३०-२०", "content_sanskrit": "निराहारान्वायुभुजः पर्णादानातपाशनान् ।\nशान्तानालोकयामास मुनीन्नियमितेन्द्रियान् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003746020, "chapter_id": 23746, "verse_number": "२-१-३०-२१", "content_sanskrit": "मुदं वितेनिरे तस्य नेत्रयोः कमलाकराः ।\nफुल्लसौगन्धिकामोदसंवासितदिगन्तराः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003746021, "chapter_id": 23746, "verse_number": "२-१-३०-२२", "content_sanskrit": "मृगयासंभृतधियश्चरतोऽधिज्यकार्मुकान् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003746022, "chapter_id": 23746, "verse_number": "२-१-३०-२३", "content_sanskrit": "अथाऽर्जुनस्य सुवर्णमुखरीतीरस्थभरद्वाजाश्रमगमनम् ।\nददर्शान्वेषितमृगान्किरातान्वनितायुतान् ।\nततो दक्षिणदिग्भागे चरन्नद्रेर्मनोहरे ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003746023, "chapter_id": 23746, "verse_number": "२-१-३०-२४", "content_sanskrit": "पुण्यमाश्रममद्राक्षीद्भरद्वाजस्य कौरवः ।\nकदलीनारिकेलाम्रकोलचंपकचंदनैः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003746024, "chapter_id": 23746, "verse_number": "२-१-३०-२५", "content_sanskrit": "तक्कोलाशोकहिन्तालतालकेतकिदाडिमैः ।\nजंबूकदम्वकतकखदिरार्जुनपाटलैः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003746025, "chapter_id": 23746, "verse_number": "२-१-३०-२६", "content_sanskrit": "नागपुन्नागसरलदेवदारुकरञ्जकैः ।\nलवंगलुंगलवलीप्रियंगुतिलकैरपि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003746026, "chapter_id": 23746, "verse_number": "२-१-३०-२७", "content_sanskrit": "बिभीतश्रीफलाश्वत्थमधूकप्लक्षकेसरैः ।\nपूगजम्बीरनारंगनिम्बामलककौशिकैः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003746027, "chapter_id": 23746, "verse_number": "२-१-३०-२८", "content_sanskrit": "अन्यैश्च फलपुष्पाढ्यैः शोभितं धरणीरुहैः ।\nवासन्तीकुन्दजात्यादिलताभिः परिवेष्टितम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003746028, "chapter_id": 23746, "verse_number": "२-१-३०-२९", "content_sanskrit": "अपूर्वसौरभाकृष्टभ्रमरीभिः समन्ततः ।\nचक्रवाकबकक्रौञ्चहंसकारण्डवाश्रयैः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003746029, "chapter_id": 23746, "verse_number": "२-१-३०-३०", "content_sanskrit": "सौगन्धिकोत्पलांभोजकैरवौघविराजितैः ।\nसरोभिरमृतस्यंदिमधुरस्फारवारिभिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003746030, "chapter_id": 23746, "verse_number": "२-१-३०-३१", "content_sanskrit": "समापादितलक्ष्मीकं कौतुकैकनिकेतनम् ।\nसिंहदन्तावलव्याघ्रतरक्षुरुरुरङ्कुभिः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003746031, "chapter_id": 23746, "verse_number": "२-१-३०-३२", "content_sanskrit": "मृगैरन्यैः समाकीर्णमन्योऽन्यहितकारिभिः ।\nजितचैत्ररथोद्यानमधरीकृतनन्दनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003746032, "chapter_id": 23746, "verse_number": "२-१-३०-३३", "content_sanskrit": "अतिवाङ्मनसोदारं परमानन्दकारणम् ।\nशिवागमानां दिव्यानामर्थजातमनुत्तमम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003746033, "chapter_id": 23746, "verse_number": "२-१-३०-३४", "content_sanskrit": "प्रकाशयन्ति शावानां यत्र मञ्जुगिरः शुकाः ।\nयस्मिन्हुताशनो दारधूमश्यामलितं नभः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003746034, "chapter_id": 23746, "verse_number": "२-१-३०-३५", "content_sanskrit": "अकालजलदभ्रांतिमातनोति शिखण्डिनाम् ।\nयस्मिन्विहारश्रान्तानां सिंहानां स्वेच्छयागताः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003746035, "chapter_id": 23746, "verse_number": "२-१-३०-३६", "content_sanskrit": "निर्वापयन्ति गात्राणि करिणः करशीकरैः ।\nतदाश्रमपदं पश्यन्विस्मयाक्रांतमानसः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003746036, "chapter_id": 23746, "verse_number": "२-१-३०-३७", "content_sanskrit": "प्रभावं पाण्डुतनयः प्रशशंस तपस्विनाम् ।\nनिवार्य तत्र तत्रैव सकलाननुजीविनः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003746037, "chapter_id": 23746, "verse_number": "२-१-३०-३८", "content_sanskrit": "अथार्जुनकृतभरद्वाजसेवाक्रमः ।\nमित्रैर्विप्रवरैः सार्धं प्रविवेश तमाश्रमम् ।\nअग्रे ददर्श कौन्तेयः स्फुरत्पावकतेजसम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003746038, "chapter_id": 23746, "verse_number": "२-१-३०-३९", "content_sanskrit": "भरद्वाजं मुनिवरैरनेकैः परिवारितम् ।\nभस्मानुलिप्तसर्वांगं मृगचर्मोत्तरीयकम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003746039, "chapter_id": 23746, "verse_number": "२-१-३०-४०", "content_sanskrit": "नववारिदसंवीतं कैलासमिव भास्वरम् ।\nजटाभिर्लम्बमानाभिर्भास्वन्तं स्वर्णकांतिभिः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003746040, "chapter_id": 23746, "verse_number": "२-१-३०-४१", "content_sanskrit": "स्थिरविद्युल्लताकीर्णमिव शारदनीरदम् ।\nश्रुतिस्मृति पुराणार्थैरेकीभूय समागतैः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003746041, "chapter_id": 23746, "verse_number": "२-१-३०-४२", "content_sanskrit": "अङ्गीकृतमिवाकारं दिव्यज्ञानशुभास्पदम् ।\nधृतिक्षांतिदयातुष्टिशांतिभिर्नित्यसेवितम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003746042, "chapter_id": 23746, "verse_number": "२-१-३०-४३", "content_sanskrit": "प्रियाभिरिव रक्ताभिरखंडब्रह्मवर्चसम् ।\nउपगम्य शनैः पार्थस्तत्पादांबुजयोः पुरः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003746043, "chapter_id": 23746, "verse_number": "२-१-३०-४४", "content_sanskrit": "चक्रे प्रणामं साष्टांगं समालिंगितभूतलम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003746044, "chapter_id": 23746, "verse_number": "२-१-३०-४५", "content_sanskrit": "अथार्जुनं प्रति भरद्वाजकृतातिथ्यप्रकारः ।\nतमागतं पृथापुत्रमुत्थाप्य मुनिपुङ्गवः ।\nआशीर्भिरेधयाञ्चक्रे प्रहर्षोत्फुल्लमानसः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003746045, "chapter_id": 23746, "verse_number": "२-१-३०-४६", "content_sanskrit": "संपूज्य च यथान्यायं तमर्घ्याद्यैः प्रियातिथिम् ।\nविनिर्दिष्टासनासीनं समपृच्छदनामयम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003746046, "chapter_id": 23746, "verse_number": "२-१-३०-४७", "content_sanskrit": "संमाननमवाप्यास्मान्मुनेः पाण्डवमध्यमः ।\nप्रियैर्वाक्यैर्मुनिपतेरकरोन्मनसो मुदम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003746047, "chapter_id": 23746, "verse_number": "२-१-३०-४८", "content_sanskrit": "सस्माराथ भरद्वाजः स्वर्धेनुं कामदोहिनीम् ।\nसा वितेनेऽतिमहतीं भक्ष्यभोज्यादिकल्पनाम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003746048, "chapter_id": 23746, "verse_number": "२-१-३०-४९", "content_sanskrit": "भुक्त्वा पार्थः सानुचरस्तमुपास्य तपोनिधिम् ।\nदिनशेषं कथालापकौतुकेनात्यवाहयत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003746049, "chapter_id": 23746, "verse_number": "२-१-३०-५०", "content_sanskrit": "ततः सायन्तनीं संध्यामुपास्य हुतपावकः ।\nविप्रैरमात्यैः सहितो ययौ तस्य कुटीगृहान् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003746050, "chapter_id": 23746, "verse_number": "२-१-३०-५१", "content_sanskrit": "तत्रासीनो मुनिपतेराशीर्भिरभिनन्दितः ।\nआनन्द्यमानो मुमुदे तन्नदीशीतलानिलैः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003746051, "chapter_id": 23746, "verse_number": "२-१-३०-५२", "content_sanskrit": "संप्रापिता केन भुवः प्रभूता कस्मान्महीध्रादधिकप्रभावा ।\nइति प्रभावं परिपृच्छ्य नद्याः श्रोतुं मुनीन्द्रान्मतिरस्य जज्ञे ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003746052, "chapter_id": 23746, "verse_number": "२-१-३०-५३", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे श्रीवेंकटाचलमाहात्म्ये सुवर्णमुखरीमाहात्म्यप्रशंसायां भरद्वाजाश्रमवर्णनंनाम त्रिंशोऽध्यायः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]