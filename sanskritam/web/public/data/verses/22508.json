[{"id": 7002508000, "chapter_id": 22508, "verse_number": "१-१७०-१", "content_sanskrit": "सुमन्तुरुवाच ।\nसवृषं गोशतं दत्त्वा भास्कराय नराधिप ।\nत्रिःसप्तकुलजैः सार्धं शृणु यत्फलमाप्नुयात् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002508001, "chapter_id": 22508, "verse_number": "१-१७०-२", "content_sanskrit": "वरकोटिप्रतीकाशैः सर्वकामसमन्वितैः ।\nमहायानैरसंख्येयैरमरासुरपूजितैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002508002, "chapter_id": 22508, "verse_number": "१-१७०-३", "content_sanskrit": "द्वादशादित्यसंकाशो दिवाकर इवापरः ।\nगत्वादित्यपुरं रम्यं क्रीडते सूर्यमंडपे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002508003, "chapter_id": 22508, "verse_number": "१-१७०-४", "content_sanskrit": "भुक्त्वा तु विपुलान्भोगान्प्रलये सर्वदेहिनाम् ।\nमोहकंचुकमुत्सृज्य विशत्यादित्यमंडले ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002508004, "chapter_id": 22508, "verse_number": "१-१७०-५", "content_sanskrit": "सर्वज्ञः सूरपरमः शुद्धः स्वात्मन्यवस्थितः ।\nसर्वगः परिपूर्णत्वात्सूर्यवद्दीप्तिमान्भवेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002508005, "chapter_id": 22508, "verse_number": "१-१७०-६", "content_sanskrit": "यो दद्यादुभयमुखीं सौरभेयीं दिवाकरे ।\nसप्तद्वीपां महीं दत्त्वा यत्फलं तदवाप्नुयात् ।\nपादद्वयं शिरोऽर्धं च सशैलवनकानना ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]