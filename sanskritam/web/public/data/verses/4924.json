[{"id": 2185038, "chapter_id": 4924, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2185039, "chapter_id": 4924, "verse_number": "१", "content_sanskrit": "यदिदं घोरमुद्दिष्टमश्रद्धेयमिवानृतम् ।\nअस्ति स्विदस्य मर्यादा यामहं परिवर्जये\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2185040, "chapter_id": 4924, "verse_number": "२", "content_sanskrit": "सम्मुह्यामि विषीदामि धर्मो मे शिथिलीकृतः ।\nउद्यमं नाधिगच्छामि कुतश्चित् परिचिन्तयन्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2185041, "chapter_id": 4924, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2185042, "chapter_id": 4924, "verse_number": "३", "content_sanskrit": "नैतद् बुद्ध्वागमादेव तव धर्मानुशासनम् ।\nप्रज्ञासमभिहारोऽयं कविभिः सम्भृतं मधु\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2185043, "chapter_id": 4924, "verse_number": "४", "content_sanskrit": "बाह्याः प्रतिविधातव्याः प्रजा राज्ञा ततस्ततः ।\nबहुशाखेन धर्मेण यात्रैषा सम्प्रवर्तते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2185044, "chapter_id": 4924, "verse_number": "५", "content_sanskrit": "बुद्धिसञ्जननं राज्ञां धर्ममाचरतां सदा ।\nजयो भवति कौरव्य तदा तद्विद्धि मे वचः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2185045, "chapter_id": 4924, "verse_number": "६", "content_sanskrit": "बुद्धिश्रेष्ठा हि राजानो जयन्ति विजयैषिणः ।\nधर्मः प्रतिविधातव्यो बुद्ध्या राज्ञा ततस्ततः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2185046, "chapter_id": 4924, "verse_number": "७", "content_sanskrit": "नैकशाखेन धर्मेण राज्ञां धर्मो विधीयते ।\nदुर्बलस्य कुतः प्रज्ञा पुरस्तादनुदाहृता\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2185047, "chapter_id": 4924, "verse_number": "८", "content_sanskrit": "अद्वैधज्ञः प्रतिद्वैधे संशयं प्राप्तुमर्हति ।\nबुद्धिद्वैधं वेदितव्यं पुरस्तादेव भारत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2185048, "chapter_id": 4924, "verse_number": "९", "content_sanskrit": "पार्श्वतःकरणं प्रज्ञा विषूची त्वापगा इव ।\nजनस्तूच्चारितं धर्मं विजानात्यन्यथान्यथा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2185049, "chapter_id": 4924, "verse_number": "१०", "content_sanskrit": "सम्यग् विज्ञानिनः केचिन्मिथ्याविज्ञानिनोऽपरे ।\nतद्वै यथातथं बुद्ध्वा ज्ञानमाददते सताम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2185050, "chapter_id": 4924, "verse_number": "११", "content_sanskrit": "परिमुष्णन्ति शास्त्राणि धर्मस्य परिपन्थिनः ।\nवैषम्यमपि विद्यानां नैरर्थ्यात् ख्यापयन्ति ते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2185051, "chapter_id": 4924, "verse_number": "१२", "content_sanskrit": "आजिजीविषवो विद्यां यशस्कामाः समन्ततः ।\nते सर्वे नरपापिष्ठा धर्मस्य परिपन्थिनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2185052, "chapter_id": 4924, "verse_number": "१३", "content_sanskrit": "अपक्वमतयो मन्दा न जानन्ति यथातथम् ।\nसदा ह्यशास्त्रकुशलाः सर्वत्रापरिनिष्ठिताः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2185053, "chapter_id": 4924, "verse_number": "१४", "content_sanskrit": "परिमुष्णन्ति शास्त्राणि शास्त्रदोषानुदर्शिनः ।\nविज्ञानमथ विद्यानां न सम्यगिति वर्तते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2185054, "chapter_id": 4924, "verse_number": "१५", "content_sanskrit": "निन्दया परविद्यानां स्वां विद्यां ख्यापयन्ति ये ।\nवागास्तिक्यानुनीताश्च दुग्धविद्याफला इव॥\nतान् विद्यावणिजो विद्धि राक्षसानिव भारत\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2185055, "chapter_id": 4924, "verse_number": "१६", "content_sanskrit": "व्याजेन कृत्स्नो विहितो धर्मस्ते परिहास्यते ।\nन धर्मवचनं वाचा किन्तु बुद्ध्येति नः श्रुतम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2185056, "chapter_id": 4924, "verse_number": "समाप्तिः", "content_sanskrit": "इति बार्हस्पतं ज्ञानं प्रोवाच मघवा स्वयम् ।\nन त्वेव वचनं किञ्चिदनिमित्तादिहोच्यते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2185057, "chapter_id": 4924, "verse_number": "१८", "content_sanskrit": "स्वविनीतेन शास्त्रेण व्यवस्यन्ति यथा परः ।\nलोकयात्रामिहैके तु धर्ममाहुर्मनीषिणः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2185058, "chapter_id": 4924, "verse_number": "१९", "content_sanskrit": "समुद्दिष्टं सतां धर्मं स्वयं मुच्येदपण्डितः ।\nअमर्षाच्छास्त्रसम्मोहादनिमित्तादिहोच्यते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2185059, "chapter_id": 4924, "verse_number": "२०", "content_sanskrit": "शास्त्रं प्रज्ञास्य वदतः समूहे यत्प्रदर्शनम् ।\nआजगाम तयोर्बुद्ध्या वचनेन प्रशस्यते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2185060, "chapter_id": 4924, "verse_number": "२१", "content_sanskrit": "अज्ञानाज्ज्ञानहेतुत्वाद् वचनं साधु मन्यते ।\nअनुपागतमेवेदं शास्त्रमेवमपार्थकम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2185061, "chapter_id": 4924, "verse_number": "२२", "content_sanskrit": "दैतेयानुशनाः प्राह संशयच्छेदने पुरा ।\nज्ञानमव्यपदेश्यं हि यथा नास्ति तथैव तत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2185062, "chapter_id": 4924, "verse_number": "२३", "content_sanskrit": "तेन सञ्छिन्नमूलेन कस्तोषयितुमिच्छति ।\nपुनर्व्यवसितुं यो वा नेदं वाक्यमुपाश्रयेत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2185063, "chapter_id": 4924, "verse_number": "२४", "content_sanskrit": "उग्रायैव हि सृष्टोऽसि तदेव त्वमपीक्षसे ।\nअङ्गेमामन्ववेक्षस्व राजनीतिं बुभूषितुम् ।\nयया प्रमुच्यते त्वन्यो यदर्थं च प्रमोदते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2185064, "chapter_id": 4924, "verse_number": "२५", "content_sanskrit": "अजोऽश्वः क्षत्रमित्येतत् सदृशं ब्रह्मणा कृतम् ।\nतस्मान्न तैक्ष्ण्याद् भूतानां यात्रा काचित् प्रसिध्यति\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2185065, "chapter_id": 4924, "verse_number": "२६", "content_sanskrit": "यस्त्ववध्यवधे दोषः स वध्यस्यावधे स्मृतः ।\nएषैव खलु मर्यादा यामयं परिवर्जयेत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2185066, "chapter_id": 4924, "verse_number": "२७", "content_sanskrit": "तस्मात् तीक्ष्णः प्रजा राजा स्वधर्मे स्थापयेदुत ।\nअन्योन्यं भक्षयन्तो हि प्रचरेयुर्वृका इव\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2185067, "chapter_id": 4924, "verse_number": "२८", "content_sanskrit": "यस्य दस्युगणा राष्ट्रे ध्वाङ्क्षा मत्स्याञ्जलादिव ।\nविहरन्ति परस्वानि स वै क्षत्रियपांसनः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2185068, "chapter_id": 4924, "verse_number": "२९", "content_sanskrit": "कुलीनान् सचिवान्कृत्वा वेदविद्यासमन्वितान् ।\nप्रशाधि पृथिवीं राजन् प्रजा धर्मेण पालयन्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2185069, "chapter_id": 4924, "verse_number": "३०", "content_sanskrit": "विहीनजन्मकर्माणं यः प्रगृह्णाति भूमिपः ।\nउभयस्याविशेषज्ञस्तद्वै क्षत्रं नपुंसकम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2185070, "chapter_id": 4924, "verse_number": "३१", "content_sanskrit": "नैवोग्रं नैव चानुग्रं धर्मेणेह प्रशस्यते ।\nउभयं न व्यतिक्रामेदुग्रो भूत्वा मृदुर्भव\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2185071, "chapter_id": 4924, "verse_number": "३२", "content_sanskrit": "कष्टः क्षत्रियधर्मोऽयं सौहृदं त्वयि यत् स्थितम् ।\nउग्रे कर्मणि सृष्टोऽसि तस्माद् राज्यं प्रशाधि वै\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2185072, "chapter_id": 4924, "verse_number": "३३", "content_sanskrit": "अशिष्टनिग्रहो नित्यं शिष्टस्य परिपालनम् ।\nइति शक्रोऽब्रवीद् धीमानापत्सु भरतर्षभ\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2185073, "chapter_id": 4924, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2185074, "chapter_id": 4924, "verse_number": "३४", "content_sanskrit": "अस्ति स्विद्दस्युमर्यादा यामन्यो नातिलङ्घयेत् ।\nपृच्छामि त्वां सतां श्रेष्ठ तन्मे ब्रूहि पितामह\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2185075, "chapter_id": 4924, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2185076, "chapter_id": 4924, "verse_number": "३५", "content_sanskrit": "ब्राह्मणानेव सेवेत विद्यावृद्धांस्तपस्विनः ।\nश्रुतचारित्रवृत्ताढ्यान् पवित्रं ह्येतदुत्तमम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2185077, "chapter_id": 4924, "verse_number": "३६", "content_sanskrit": "या देवतासु वृत्तिस्ते सास्तु विप्रेषु सर्वदा ।\nक्रुद्धैर्हि विप्रैः कर्माणि कृतानि बहुधा नृप\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2185078, "chapter_id": 4924, "verse_number": "३७", "content_sanskrit": "तेषां प्रीत्या यशो मुख्यमप्रीत्या तु विपर्ययः ।\nप्रीत्या ह्यमृतवद् विप्राः क्रुद्धाश्चैव यथा विषम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2185079, "chapter_id": 4924, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि आपद्धर्मे द्वादशोऽध्यायः ॥ १२ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]