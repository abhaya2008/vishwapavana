[{"id": 7005921000, "chapter_id": 25921, "verse_number": "१-१०४-१", "content_sanskrit": "याज्ञवल्क्य उवाच ।\nनरकात्पताकोद्भूतात्क्षयात्पापस्य कर्मणः ।\nब्रह्महा श्वा खरोष्ट्रः स्याद्भेको यकः सुराप्यपि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005921001, "chapter_id": 25921, "verse_number": "१-१०४-२", "content_sanskrit": "स्वर्णचोरः कृमिः कीटः तृणादिर्गुरुतल्पगः ।\nक्षयरोगी श्यावदन्तः कुनखी शिपिविष्टकः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005921002, "chapter_id": 25921, "verse_number": "१-१०४-३", "content_sanskrit": "ब्रह्महत्याक्रमात्स्युश्च तत्सर्वं वा शिशर्भवेत्।\nअन्नहर्त्ता मयावी स्यान्मूको रागापहारकः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005921003, "chapter_id": 25921, "verse_number": "१-१०४-४", "content_sanskrit": "धान्यहार्य्यतिरिक्ताङ्गः पिशुनः पूतिनासिकः।\nतैलाहारी तैलपायी पूतिवक्त्रस्तु सूचकः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005921004, "chapter_id": 25921, "verse_number": "१-१०४-५", "content_sanskrit": "ब्रह्मस्वं कन्यकां क्रीत्वा वने रक्षो वेद्वृषः।\nरत्नहृद्धीनजातः स्यात्पत्रशाकहरः शिखी ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005921005, "chapter_id": 25921, "verse_number": "१-१०४-६", "content_sanskrit": "गुच्छं चुचुन्दरी हृत्वा धान्यहृन्मूषको भवेत्।\nफलं कपिः पशून्हृत्वा त्वजा काकः पयस्तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005921006, "chapter_id": 25921, "verse_number": "१-१०४-७", "content_sanskrit": "मांसं गृध्रः पटं श्वित्री चीरीलवणहारकः ।\nयथाकर्म फलं प्राप्य तिर्यक्त्वं कालपर्ययात् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005921007, "chapter_id": 25921, "verse_number": "१-१०४-८", "content_sanskrit": "जायन्ते लक्षणभ्रष्टा दरिद्राः पुरुषामाः।\nततो निष्कलुषीभूता कुले महति योगिनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005921008, "chapter_id": 25921, "verse_number": "१-१०४-९", "content_sanskrit": "जायन्ते लक्षणोपेता धनधान्यसमन्विताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]