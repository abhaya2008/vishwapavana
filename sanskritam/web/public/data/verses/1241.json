[{"id": 2011764, "chapter_id": 1241, "verse_number": "१-२४२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2011765, "chapter_id": 1241, "verse_number": "१-२४२-१", "content_sanskrit": "कुकुरान्धकवृष्णीनामपयानं च पाण्डवः।\nविनिश्चित्य ततः पार्थः सुभद्रामिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2011766, "chapter_id": 1241, "verse_number": "१-२४२-२", "content_sanskrit": "शृणु भद्रे यथाशास्त्रं हितार्थं मुनिभिः कृतम्।\nविवाहं बहुधा सत्सु वर्णानां धर्मसंयुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2011767, "chapter_id": 1241, "verse_number": "१-२४२-३", "content_sanskrit": "कन्यायास्तु पिता भ्राता माता मातुल एव वा।\nपितुः पिता पितुर्भ्राता दाने तु प्रभुतां गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2011768, "chapter_id": 1241, "verse_number": "१-२४२-४", "content_sanskrit": "महोत्सवं पशुपतेर्द्रष्टुकामः पिता तव।\nअन्तर्द्वीपं गतो भद्रे पुत्रैः पौत्रैः सबान्धवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2011769, "chapter_id": 1241, "verse_number": "१-२४२-५", "content_sanskrit": "मम चैव विशालाक्षि विदेशस्था हि बान्धवाः।\nतस्मात्सुभद्रे गान्धर्वो विवाहः पञ्चमः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2011770, "chapter_id": 1241, "verse_number": "१-२४२-६", "content_sanskrit": "समागमे तु कन्यायाः क्रियाः प्रोक्ताश्चतुर्विधाः।\nतेषां प्रवृत्तिं साधूनां शृणु माधवि तद्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2011771, "chapter_id": 1241, "verse_number": "१-२४२-७", "content_sanskrit": "वरमाहूय विधिना पित्रा दत्ता तथार्थिने।\nसा पत्नी तु परैरुक्ता सा वश्या तु पतिव्रता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2011772, "chapter_id": 1241, "verse_number": "१-२४२-८", "content_sanskrit": "भृत्यानां भरणार्थाय आत्मनः पोषणाय च।\nदाने गृहीता या नारी सा भार्येति स्मृता बुधैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2011773, "chapter_id": 1241, "verse_number": "१-२४२-९", "content_sanskrit": "धर्मतो वरयित्वा तु आनीय स्वं निवेशनम्।\nन्यायेन दत्तातारुण्ये दाराः पितृकृताः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2011774, "chapter_id": 1241, "verse_number": "१-२४२-१०", "content_sanskrit": "गान्धर्वेण विवाहेन रागात्पुत्रार्थकारणात्।\nआत्मनाऽनुगृहीता या वश्या सा तु प्रजावती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2011775, "chapter_id": 1241, "verse_number": "१-२४२-११", "content_sanskrit": "जनयेद्या तु भर्तारं जाया इत्येव नामतः।\nपत्नी भार्या च दाराश्च जाया चेति चतुर्विधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2011776, "chapter_id": 1241, "verse_number": "१-२४२-१२", "content_sanskrit": "चतस्र एवाग्निसाक्ष्याः क्रियायुक्ताश्च धर्मतः।\nगान्धर्वस्तु क्रियाहीनो रागादेव प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2011777, "chapter_id": 1241, "verse_number": "१-२४२-१३", "content_sanskrit": "सकामायाः सकामेन निर्मन्त्रो रहसि स्मृतः।\nमयोक्तमक्रियं चापि कर्तव्यं माधवि त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2011778, "chapter_id": 1241, "verse_number": "१-२४२-१४", "content_sanskrit": "अयनं चैव मासश्च ऋतुः पक्षस्तथा तिथिः।\nकरणं च मुहूर्तं च लग्नसंपत्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2011779, "chapter_id": 1241, "verse_number": "१-२४२-१५", "content_sanskrit": "विवाहस्य विशालाक्षि प्रशस्तं चोत्तरायणम्।\nवैशाखश्चैव मासानां पक्षाणां शुक्ल एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2011780, "chapter_id": 1241, "verse_number": "१-२४२-१६", "content_sanskrit": "नक्षत्राणां तथा हस्तस्तृतीया च तिथिष्वपि।\nलग्नो हि मकरः श्रेष्ठः करणानां बवस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2011781, "chapter_id": 1241, "verse_number": "१-२४२-१७", "content_sanskrit": "मैत्रो मुहूर्तो वैवाह्य आवयोः शुभकर्मणि।\nसर्वसंपदियं भद्रे अद्य रात्रौ भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2011782, "chapter_id": 1241, "verse_number": "१-२४२-१८", "content_sanskrit": "भगवानस्तमभ्येति आदित्यस्तपतां वरः।\nरात्रौ विवाहकालोऽयं भविष्यति न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2011783, "chapter_id": 1241, "verse_number": "१-२४२-१९", "content_sanskrit": "नारायणोऽपि सर्वज्ञो नावबुध्येत विश्वकृत्।\nधर्मसङ्कटमापन्ने किं नु कृत्वा सुखं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2011784, "chapter_id": 1241, "verse_number": "१-२४२-२०", "content_sanskrit": "मनोभवेन कामेन मोहितं मां प्रलापिनम्।\nप्रतिवाक्यं च मे देवि किं न वक्ष्यसि माधवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2011785, "chapter_id": 1241, "verse_number": "१-२४२-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2011786, "chapter_id": 1241, "verse_number": "१-२४२-२१", "content_sanskrit": "अर्जुनस्य वचः श्रुत्वा चिन्तयन्ती जनार्दनम्।\nनोवाच किंचिद्वचनं बाष्पदूषितलोचना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2011787, "chapter_id": 1241, "verse_number": "१-२४२-२२", "content_sanskrit": "रागोन्मादप्रलापी सन्नर्जुनो जयतां वरः।\nचिन्तयामास पितरं प्रविश्य च लतागृहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2011788, "chapter_id": 1241, "verse_number": "१-२४२-२३", "content_sanskrit": "चिन्तयानं तु कौन्तेयं मत्वा शच्या शचीपतिः।\nसहितो नारदाद्यैश्च मुनिभिश्च महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2011789, "chapter_id": 1241, "verse_number": "१-२४२-२४", "content_sanskrit": "गन्धर्वैरप्सरोभिश्च चारणैश्चापि गुह्यकैः।\nअरुन्धत्या वसिष्ठेन ह्याजगाम कुशस्थलीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2011790, "chapter_id": 1241, "verse_number": "१-२४२-२५", "content_sanskrit": "चिन्तितं च सुभद्रायाश्चिन्तयित्वा जनार्दनः।\nनिद्रयापहृतज्ञानं रौहिणेयं विना तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2011791, "chapter_id": 1241, "verse_number": "१-२४२-२६", "content_sanskrit": "सहाक्रूरेण शिनिना सत्यकेन गदेन च।\nवसुदेवेन देवक्या आहूकेन च धीमता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2011792, "chapter_id": 1241, "verse_number": "१-२४२-२७", "content_sanskrit": "आजगाम पुरीं रात्रौ द्वारकां स्वजनैर्वृतः।\nपूजयित्वा तु देवेशो नारदादीन्महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2011793, "chapter_id": 1241, "verse_number": "१-२४२-२८", "content_sanskrit": "कुशलप्रश्नमुक्त्वा तु देवेन्द्रेणाभियाचितः।\nवैवाहिकीं क्रियां कृष्णः स तथेत्येवमुक्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2011794, "chapter_id": 1241, "verse_number": "१-२४२-२९", "content_sanskrit": "आहुको वसुदेवश्च सहाक्रूरः ससात्यकिः।\nअभिप्रणम्य शिरसा पाकशासनमब्रुवन्।\nदेवदेव नमस्तेस्तु लोकनाथ जगत्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2011795, "chapter_id": 1241, "verse_number": "१-२४२-३०", "content_sanskrit": "वयं धन्याः स्म सहितैर्बान्धवैः सहिताः प्रभो।\nकृतप्रसादास्तु वयं तव वाक्येन विश्वजित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2011796, "chapter_id": 1241, "verse_number": "१-२४२-३१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2011797, "chapter_id": 1241, "verse_number": "१-२४२-३१", "content_sanskrit": "एवमुक्त्वा प्रसाद्यैनं पूजयित्वा प्रयत्नतः।\nमहेन्द्रशासनात्सर्वे सहिता ऋषिभिस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2011798, "chapter_id": 1241, "verse_number": "१-२४२-३२", "content_sanskrit": "विवाहं कारयामासुः शक्रपुत्रस्य शास्त्रतः।\nअरुन्धती शची देवी रुग्मिणी देवकी तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2011799, "chapter_id": 1241, "verse_number": "१-२४२-३३", "content_sanskrit": "दिव्यस्त्रीभिश्च सहिताः सुभद्रायाः शुभाः क्रियाः।\nअर्जुनेऽपि तथा सर्वाः क्रिया भद्राः प्रयोजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2011800, "chapter_id": 1241, "verse_number": "१-२४२-३४", "content_sanskrit": "महर्षिः काश्यपो होता सदस्या नारदादयः।\nपुण्याशिषः प्रयोक्तारः सर्वे ते हि तदार्जुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2011801, "chapter_id": 1241, "verse_number": "१-२४२-३५", "content_sanskrit": "अभिषेकं तदा कृत्वा महेन्द्रः पाकशासनिम्।\nलोकपालैस्तु सहितः सर्वदेवैरभिष्टुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2011802, "chapter_id": 1241, "verse_number": "१-२४२-३६", "content_sanskrit": "किरीटाङ्गदहाराद्यैर्हस्ताभरणकुण्डलैः।\nभूषयित्वा तदा पार्थं द्वितीयमिव वासवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2011803, "chapter_id": 1241, "verse_number": "१-२४२-३७", "content_sanskrit": "पुत्रं परिष्वज्य तदा प्रीतिमाप पुरन्दरः।\nशछी देवी तदा भद्रामरुन्धत्यादिभिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2011804, "chapter_id": 1241, "verse_number": "१-२४२-३८", "content_sanskrit": "कारयामास वैवाह्यमङ्गलान्यादवस्त्रियः।\nसहाप्सरोभिर्मुदिता भूषयित्वा स्वभूषणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2011805, "chapter_id": 1241, "verse_number": "१-२४२-३९", "content_sanskrit": "पौलोमीमिव मन्यन्ते सुभद्रां तत्र योषितः।\nततो विवाहो ववृधे कृतः सर्वगुणान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2011806, "chapter_id": 1241, "verse_number": "१-२४२-४०", "content_sanskrit": "तस्याः पाणिं गृहीत्वा तु मन्त्रैर्होमपुरस्कृतम्।\nसुभद्रया बभौ जिष्णुः शच्या इव शचीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2011807, "chapter_id": 1241, "verse_number": "१-२४२-४१", "content_sanskrit": "सा जिष्णुमधिकं भेजे सुभद्रा चारुदर्शना।\nपार्थस्य सदृशी भद्रा रूपेण वयसा तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2011808, "chapter_id": 1241, "verse_number": "१-२४२-४२", "content_sanskrit": "सुभद्रायाश्च पार्थोऽपि सदृशो रूपलक्षणैः।\nइत्यूचुश्च तदा देवाः प्रीताः सेन्द्रपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2011809, "chapter_id": 1241, "verse_number": "१-२४२-४३", "content_sanskrit": "एवं निवेश्य देवास्ते गन्धर्वैः साप्सरोगणैः।\nआमन्त्र्य यादवाः सर्वे विप्रजग्मुर्यथागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2011810, "chapter_id": 1241, "verse_number": "१-२४२-४४", "content_sanskrit": "यादवाः पार्थमामन्त्र्य अन्तर्द्वीपं गतास्तदा।\nवासुदेवस्तदा पार्थमुवाच यदुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2011811, "chapter_id": 1241, "verse_number": "१-२४२-४५", "content_sanskrit": "द्वाविंशद्दिवसान्पार्थ इहोष्य भरतर्षभ।\nमामकं रथमारुह्य शैब्यसुग्रीवयोजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2011812, "chapter_id": 1241, "verse_number": "१-२४२-४६", "content_sanskrit": "सुभद्रया सुखं पार्थ खाण्डवप्रस्थमाविश।\nयादवैः सहितः पश्चादागमिष्यामि भारत।\nयतिवेषेण नियतो वस त्वं रुक्मिणीगृहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2011813, "chapter_id": 1241, "verse_number": "१-२४२-४७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2011814, "chapter_id": 1241, "verse_number": "१-२४२-४७", "content_sanskrit": "एवमुक्त्वा प्रचक्राम अन्तर्द्वीपं जनार्दनः।\nकृतोद्वाहस्ततः पार्थः कृतकार्योऽभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2011815, "chapter_id": 1241, "verse_number": "१-२४२-४८", "content_sanskrit": "तस्यां चोपगतो भावः पार्थस्य सुमहात्मनः।\nतस्मिन्भावः सुभद्राया अन्योन्यं समवर्धत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2011816, "chapter_id": 1241, "verse_number": "१-२४२-४९", "content_sanskrit": "स तथा युयुजे वीरो भद्रया भरतर्षभः।\nअभिनिष्पन्नया रामः सीतयेव समन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2011817, "chapter_id": 1241, "verse_number": "१-२४२-५०", "content_sanskrit": "अपि जिष्णुर्विजज्ञे तां ह्रीं श्रियं सन्नतिक्रियाम्।\nदेवतानां वरस्त्रीणां रूपेण सदृशीं सतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2011818, "chapter_id": 1241, "verse_number": "१-२४२-५१", "content_sanskrit": "स प्रकृत्या श्रिया दीप्त्या संदिदीपे तयाऽधिकम्।\nउद्यत्सहस्रदीप्तांशुः शरदीव दिवाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2011819, "chapter_id": 1241, "verse_number": "१-२४२-५२", "content_sanskrit": "सा तु तं मनुजव्याघ्रमनुरक्ता यशस्विनी।\nकन्यापुरगता भूत्वा तत्परा समपद्यत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2011820, "chapter_id": 1241, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि सुभद्राहरणपर्वणि द्विचत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]