[{"id": 7005769000, "chapter_id": 25769, "verse_number": "२४२-१", "content_sanskrit": "मनुमत्स्यसंवादे स्वप्नदर्शनवर्णनम् ।\nमनुरुवाच ।\nस्वप्नाख्यानं कथं देव! गमने प्रत्युपस्थिते ।\nदृश्यन्ते विविधाकाराः कथन् तेषां फलं भवेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005769001, "chapter_id": 25769, "verse_number": "२४२-२", "content_sanskrit": "मत्स्य उवाच ।\nइदीनीं कथयिष्यामि निमित्तं स्वप्नदर्शने ।\nनाभिं विनान्यगात्रेषु तृणवृक्षसमुद्भवः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005769002, "chapter_id": 25769, "verse_number": "२४२-३", "content_sanskrit": "चूर्णनं मूर्ध्नि कांस्यानां मुण्डनं नग्नता तथा ।\nमलिनाम्बरधारित्वमभ्यङ्गः पङ्कदिग्धता ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005769003, "chapter_id": 25769, "verse_number": "२४२-४", "content_sanskrit": "उच्चात् प्रपतनञ्चैव दोलारोहणमेव च  ।\nअर्जनं पक्कलोहानां हयानामपि मारणम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005769004, "chapter_id": 25769, "verse_number": "२४२-५", "content_sanskrit": "रक्तपुष्पद्रुमाणाञ्च मण्डलस्य तथैव च ।\nवराहर्क्षखरोष्ट्राणां तथा चारोहणक्रिया ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005769005, "chapter_id": 25769, "verse_number": "२४२-६", "content_sanskrit": "भक्षणं पक्वमांसानां तैरस्य कृसरस्य च ।\nनर्तनं हसनञ्चैव विवाहो गीतमेव च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005769006, "chapter_id": 25769, "verse_number": "२४२-७", "content_sanskrit": "तन्त्रीवाद्य विहीनानां वाद्यानामभिवादनम् ।\nस्रोतोऽवगाहगमनं स्नानं गोमयवारिणा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005769007, "chapter_id": 25769, "verse_number": "२४२-८", "content_sanskrit": "पङ्कोदकेन च तथा मही तोयेन चाप्यथ ।\nमातुः प्रवेशो जठरे चितारोहणमेव च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005769008, "chapter_id": 25769, "verse_number": "२४२-९", "content_sanskrit": "शक्रध्वजाभिपतनं पतनं शशिसूर्ययोः ।\nदिव्यान्तरिक्षभौमानामुत्पातानाञ्च दर्शनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005769009, "chapter_id": 25769, "verse_number": "२४२-१०", "content_sanskrit": "देवद्विजातिभूपाल गुरूणां क्रोध एव च ।\nआलिङ्गनं कुमारीणां पुरुषाणाञ्च मैथुनम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005769010, "chapter_id": 25769, "verse_number": "२४२-११", "content_sanskrit": "हानिश्चैव स्वगात्राणां विरेकवमनक्रिया ।\nदक्षिणाशाभिगमनं व्याधिनाभिभवस्तथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005769011, "chapter_id": 25769, "verse_number": "२४२-१२", "content_sanskrit": "फलापहानिश्च तथा पुष्पहानिस्तथैव च ।\nगृहाणाञ्चैव पातश्च गृहसम्मार्जनन्तथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005769012, "chapter_id": 25769, "verse_number": "२४२-१३", "content_sanskrit": "क्रीडा पिशाचक्रव्याद वानरर्क्षनरैरपि ।\nपरादभिभवश्चैव तस्माच्च व्यसनोद्भवः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005769013, "chapter_id": 25769, "verse_number": "२४२-१४", "content_sanskrit": "काषायवस्त्रधारित्वं तद्वत् स्त्री क्रीडनन्तथा ।\nस्नेहपानावगाहौ च रक्तमाल्यानुलेपनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005769014, "chapter_id": 25769, "verse_number": "२४२-१५", "content_sanskrit": "एवमादीनि चान्यानि दुःस्वप्नानि विनिर्दिशेत् ।\nएतां सङ्कथनं धन्यं भूयः प्रस्वापनन्तथा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005769015, "chapter_id": 25769, "verse_number": "२४२-१६", "content_sanskrit": "कल्कस्नानन्तिलैः होमो ब्राह्मणानाञ्च पूजनम् ।\nस्तुतिश्च वासुदेवस्य तथा तस्यैव पूजनम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005769016, "chapter_id": 25769, "verse_number": "२४२-१७", "content_sanskrit": "नागेन्द्रमोक्षश्रवणं ज्ञेयं दुःस्वप्नाशनम् ।\nस्वप्नस्तु प्रथमे यामे सम्वत्सरविपाकिनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005769017, "chapter_id": 25769, "verse_number": "२४२-१८", "content_sanskrit": "षड्भिर्मासैः द्वितीये तु त्रिभिर्मासैस्तृतीयके ।\nचतुर्थं मासमात्रेण पश्यतो नात्र संशयः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005769018, "chapter_id": 25769, "verse_number": "२४२-१९", "content_sanskrit": "अरुणोदयवेलायां दशाहेन फलम्भवेत् ।\nएकस्यां यदि वा रात्रौ शुभं वा यदि वाशुभम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005769019, "chapter_id": 25769, "verse_number": "२४२-२०", "content_sanskrit": "पश्चाद् वटस्तु यस्तत्र तस्य पाकं विनिर्दिशेत् ।\nतस्माच्छोभनके स्वप्ने पश्चात् स्वप्नो न पश्यति ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005769020, "chapter_id": 25769, "verse_number": "२४२-२१", "content_sanskrit": "शैलप्रासादनागाश्व वृषभारोहणं हितम् ।\nद्रुमाणां श्वेतपुष्पाणां गमने च तथा द्विज! ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005769021, "chapter_id": 25769, "verse_number": "२४२-२२", "content_sanskrit": "द्रुमतृणोद्भवो नाभौ तथैव बहुबाहुता ।\nतथैव बहुशीर्षत्वं फलितोद्भव एव च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005769022, "chapter_id": 25769, "verse_number": "२४२-२३", "content_sanskrit": "सुशुक्लमाल्यधारित्वं सुशुक्लाम्बरधारिता ।\nचन्द्रार्कताराग्रहणं परिमार्जनमेव च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005769023, "chapter_id": 25769, "verse_number": "२४२-२४", "content_sanskrit": "शक्रध्वजालिङ्गनञ्च तदुच्छ्रायक्रिया तथा ।\nभूम्यम्बुधानां ग्रसनं शत्रूणाञ्च वधक्रिया ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005769024, "chapter_id": 25769, "verse_number": "२४२-२५", "content_sanskrit": "जयो विवादे द्यूते च सङ्ग्रामे च तथा द्विज! ।\nभक्षणञ्चार्द्रमांसानां मत्स्यानां पायसस्य च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005769025, "chapter_id": 25769, "verse_number": "२४२-२६", "content_sanskrit": "दर्शनं रुधिरस्यापि स्नानं वा रुधिरेण च ।\nसुरारुधिरमद्यानां पानं क्षीरस्य चाथवा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005769026, "chapter_id": 25769, "verse_number": "२४२-२७", "content_sanskrit": "अन्त्रेर्वा वेष्टनं भूमौ निर्मलं गगनं तथा ।\nमुखेन दोहनं शस्तं महिषीणां तथा गवाम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005769027, "chapter_id": 25769, "verse_number": "२४२-२८", "content_sanskrit": "सिंहीनां हस्तिनीनाञ्च वडवानां तथैव च ।\nप्रसादो देवविप्रेभ्यो गुरुभ्यश्च तथा शुभः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005769028, "chapter_id": 25769, "verse_number": "२४२-२९", "content_sanskrit": "अम्भसा त्वभिषेकस्तु गवां श्रृङ्गश्रितेन वा ।\nचन्द्राद् भ्रष्टेन वा राजन्! ज्ञेयो राज्यप्रदो हि सः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005769029, "chapter_id": 25769, "verse_number": "२४२-३०", "content_sanskrit": "राज्याभिषेकश्च तथा छेदनं शिरसस्तथा ।\nमरणं वह्निदाहश्च वह्निदाहो गृहादिषु ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005769030, "chapter_id": 25769, "verse_number": "२४२-३१", "content_sanskrit": "लब्धिश्च राज्यलिङ्गानां तन्त्रीवाद्याभिवादनम् ।\nतथोदकानां तरणं तथा विषमलङ्घनम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005769031, "chapter_id": 25769, "verse_number": "२४२-३२", "content_sanskrit": "हस्तिनीवडवानाञ्च गवाञ्च प्रसवो गृहे ।\nआरोहणमथाश्वानां रोदनञ्च तथा शुभम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005769032, "chapter_id": 25769, "verse_number": "२४२-३३", "content_sanskrit": "वरस्त्रीणां तथालाभः तथालिङ्गनमेव च ।\nनिगडैर्बन्धनं धन्यं तथा विष्ठानुलेपनम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005769033, "chapter_id": 25769, "verse_number": "२४२-३४", "content_sanskrit": "जीवितां भूमिपालानां सुहृदामपि दर्शनम् ।\nदर्शं देवतानाञ्च विमलानां तथाम्भसाम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005769034, "chapter_id": 25769, "verse_number": "२४२-३५", "content_sanskrit": "शुभान्यथैतानि नरस्तु दृष्ट्वा प्राप्नोत्ययत्नाद् ध्रुवमर्थलाभम् ।\nस्वप्नानि वै धर्मभृतां वरिष्ठ! व्याधेर्विमोक्षञ्च तथाऽऽतुरोऽपि ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]