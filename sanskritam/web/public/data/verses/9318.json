[{"id": 5000318000, "chapter_id": 9318, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे षट्चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000318001, "chapter_id": 9318, "verse_number": "४-४६-१", "content_sanskrit": "गतेषु वानरेन्द्रेषु रामः सुग्रीवमब्रवीत्।\nकथं भवान् विजानीते सर्वं वै मण्डलं भुवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000318002, "chapter_id": 9318, "verse_number": "४-४६-२", "content_sanskrit": "सुग्रीवश्च ततो राममुवाच प्रणतात्मवान्।\nश्रूयतां सर्वमाख्यास्ये विस्तरेण वचो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000318003, "chapter_id": 9318, "verse_number": "४-४६-३", "content_sanskrit": "यदा तु दुन्दुभिं नाम दानवं महिषाकृतिम्।\nप्रतिकालयते वाली मलयं प्रति पर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000318004, "chapter_id": 9318, "verse_number": "४-४६-४", "content_sanskrit": "तदा विवेश महिषो मलयस्य गुहां प्रति।\nविवेश वाली तत्रापि मलयं तज्जिघांसया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000318005, "chapter_id": 9318, "verse_number": "४-४६-५", "content_sanskrit": "ततोऽहं तत्र निक्षिप्तो गुहाद्वारि विनीतवत्।\nन च निष्क्रामते वाली तदा संवत्सरे गते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000318006, "chapter_id": 9318, "verse_number": "४-४६-६", "content_sanskrit": "ततः क्षतजवेगेन आपुपूरे तदा बिलम्।\nतदहं विस्मितो दृष्ट्वा भ्रातुः शोकविषार्दितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000318007, "chapter_id": 9318, "verse_number": "४-४६-७", "content_sanskrit": "अथाहं गतबुद्धिस्तु सुव्यक्तं निहतो गुरुः।\nशिला पर्वतसंकाशा बिलद्वारि मया कृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000318008, "chapter_id": 9318, "verse_number": "४-४६-८", "content_sanskrit": "अशक्नुवन्निष्क्रमितुं महिषो विनशिष्यति।\nततोऽहमागां किष्किन्धां निराशस्तस्य जीविते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000318009, "chapter_id": 9318, "verse_number": "४-४६-९", "content_sanskrit": "राज्यं च सुमहत् प्राप्य तारां च रुमया सह।\nमित्रैश्च सहितस्तत्र वसामि विगतज्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000318010, "chapter_id": 9318, "verse_number": "४-४६-१०", "content_sanskrit": "आजगाम ततो वाली हत्वा तं वानरर्षभः।\nततोऽहमददां राज्यं गौरवाद् भययन्त्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000318011, "chapter_id": 9318, "verse_number": "४-४६-११", "content_sanskrit": "स मां जिघांसुर्दुष्टात्मा वाली प्रव्यथितेन्द्रियः।\nपरिकालयते वाली धावन्तं सचिवैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000318012, "chapter_id": 9318, "verse_number": "४-४६-१२", "content_sanskrit": "ततोऽहं वालिना तेन सोऽनुबद्धः प्रधावितः।\nनदीश्च विविधाः पश्यन् वनानि नगराणि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000318013, "chapter_id": 9318, "verse_number": "४-४६-१३", "content_sanskrit": "आदर्शतलसंकाशा ततो वै पृथिवी मया।\nअलातचक्रप्रतिमा दृष्टा गोष्पदवत् कृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000318014, "chapter_id": 9318, "verse_number": "४-४६-१४", "content_sanskrit": "पूर्वां दिशं ततो गत्वा पश्यामि विविधान् द्रुमान्।\nपर्वतान् सदरीन् रम्यान् सरांसि विविधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000318015, "chapter_id": 9318, "verse_number": "४-४६-१५", "content_sanskrit": "उदयं तत्र पश्यामि पर्वतं धातुमण्डितम्।\nक्षीरोदं सागरं चैव नित्यमप्सरसालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000318016, "chapter_id": 9318, "verse_number": "४-४६-१६", "content_sanskrit": "परिकाल्यमानस्तु तदा वालिनाभिद्रुतो ह्यहम्।\nपुनरावृत्य सहसा प्रस्थितोऽहं तदा विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000318017, "chapter_id": 9318, "verse_number": "४-४६-१७", "content_sanskrit": "दिशस्तस्यास्ततो भूयः प्रस्थितो दक्षिणां दिशम्।\nविन्ध्यपादपसंकीर्णां चन्दनद्रुमशोभिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000318018, "chapter_id": 9318, "verse_number": "४-४६-१८", "content_sanskrit": "द्रुमशैलान्तरे पश्यन् भूयो दक्षिणतोऽपराम्।\nअपरां च दिशं प्राप्तो वालिना समभिद्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000318019, "chapter_id": 9318, "verse_number": "४-४६-१९", "content_sanskrit": "स पश्यन् विविधान् देशानस्तं च गिरिसत्तमम्।\nप्राप्य चास्तं गिरिश्रेष्ठमुत्तरं सम्प्रधावितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000318020, "chapter_id": 9318, "verse_number": "४-४६-२०", "content_sanskrit": "हिमवन्तं च मेरुं च समुद्रं च तथोत्तरम्।\nयदा न विन्दे शरणं वालिना समभिद्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000318021, "chapter_id": 9318, "verse_number": "४-४६-२१", "content_sanskrit": "ततो मां बुद्धिसम्पन्नो हनुमान् वाक्यमब्रवीत्।\nइदानीं मे स्मृतं राजन् यथा वाली हरीश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000318022, "chapter_id": 9318, "verse_number": "४-४६-२२", "content_sanskrit": "मतङ्गेन तदा शप्तो ह्यस्मिन्नाश्रममण्डले।\nप्रविशेद् यदि वै वाली मूर्धास्य शतधा भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000318023, "chapter_id": 9318, "verse_number": "४-४६-२३", "content_sanskrit": "तत्र वासः सुखोऽस्माकं निरुद्विग्नो भविष्यति।\nततः पर्वतमासाद्य ऋष्यमूकं नृपात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000318024, "chapter_id": 9318, "verse_number": "४-४६-२४", "content_sanskrit": "न विवेश तदा वाली मतङ्गस्य भयात् तदा।\nएवं मया तदा राजन् प्रत्यक्षमुपलक्षितम्।\nपृथिवीमण्डलं सर्वं गुहामस्म्यागतस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000318025, "chapter_id": 9318, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे षट्चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]