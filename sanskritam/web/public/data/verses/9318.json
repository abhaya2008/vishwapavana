r": "57", "content_sanskrit": "ततःप्रहर्षाद्भरतमङ्गमारोप्यराघवः ॥ ययौतेनविमानेनससैन्योभरताश्रमम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 40019700, "chapter_id": 9318, "verse_number": "58", "content_sanskrit": "भरताश्रममासाद्यससैन्योराघवस्तदा ॥ अवतीर्यविमानाग्रादवतस्थेमहीतले ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 40019701, "chapter_id": 9318, "verse_number": "59", "content_sanskrit": "अब्रवीत्तुतदारामस्तद्विमानमनुत्तमम् ॥ वहवैश्रवणंदेवमनुजानामिगम्यताम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 40019702, "chapter_id": 9318, "verse_number": "60", "content_sanskrit": "ततोरामाभ्यनुज्ञातंतद्विमानमनुत्तमम् ॥ उत्तरांदिशमुद्दिश्यजगामधनदालयम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 40019703, "chapter_id": 9318, "verse_number": "61", "content_sanskrit": "विमानंपुष्पकंदिव्यंसम्गृहीतंतुरक्षसा ॥ अगमद्धनदंवेगाद्रामवाक्यप्रचोदितम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]