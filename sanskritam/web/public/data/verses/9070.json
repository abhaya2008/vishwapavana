[{"id": 5000070000, "chapter_id": 9070, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे सप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000070001, "chapter_id": 9070, "verse_number": "१-७०-१", "content_sanskrit": "ततः प्रभाते जनकः कृतकर्मा महर्षिभिः।\nउवाच वाक्यं वाक्यज्ञः शतानन्दं पुरोहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000070002, "chapter_id": 9070, "verse_number": "१-७०-२", "content_sanskrit": "भ्राता मम महातेजा वीर्यवानतिधार्मिकः।\nकुशध्वज इति ख्यातः पुरीमध्यवसच्छुभाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000070003, "chapter_id": 9070, "verse_number": "१-७०-३", "content_sanskrit": "वार्याफलकपर्यन्तां पिबन्निक्षुमतीं नदीम्।\nसांकाश्यां पुण्यसंकाशां विमानमिव पुष्पकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000070004, "chapter_id": 9070, "verse_number": "१-७०-४", "content_sanskrit": "तमहं द्रष्टुमिच्छामि यज्ञगोप्ता स मे मतः।\nप्रीतिं सोऽपि महातेजा इमां भोक्ता मया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000070005, "chapter_id": 9070, "verse_number": "१-७०-५", "content_sanskrit": "एवमुक्ते तु वचने शतानन्दस्य संनिधौ।\nआगताः केचिदव्यग्रा जनकस्तान् समादिशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000070006, "chapter_id": 9070, "verse_number": "१-७०-६", "content_sanskrit": "शासनात् तु नरेन्द्रस्य प्रययुः शीघ्रवाजिभिः।\nसमानेतुं नरव्याघ्रं विष्णुमिन्द्राज्ञया यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000070007, "chapter_id": 9070, "verse_number": "१-७०-७", "content_sanskrit": "सांकाश्यां ते समागम्य ददृशुश्च कुशध्वजम्।\nन्यवेदयन् यथावृत्तं जनकस्य च चिन्तितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000070008, "chapter_id": 9070, "verse_number": "१-७०-८", "content_sanskrit": "तद‍्वृत्तं नृपतिः श्रुत्वा दूतश्रेष्ठैर्महाजवैः।\nआज्ञया तु नरेन्द्रस्य आजगाम कुशध्वजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000070009, "chapter_id": 9070, "verse_number": "१-७०-९", "content_sanskrit": "स ददर्श महात्मानं जनकं धर्मवत्सलम्।\nसोऽभिवाद्य शतानन्दं जनकं चातिधार्मिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000070010, "chapter_id": 9070, "verse_number": "१-७०-१०", "content_sanskrit": "राजार्हं परमं दिव्यमासनं सोऽध्यरोहत।\nउपविष्टावुभौ तौ तु भ्रातरावमितद्युती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000070011, "chapter_id": 9070, "verse_number": "१-७०-११", "content_sanskrit": "प्रेषयामासतुर्वीरौ मन्त्रिश्रेष्ठं सुदामनम्।\nगच्छ मन्त्रिपते शीघ्रमिक्ष्वाकुममितप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000070012, "chapter_id": 9070, "verse_number": "१-७०-१२", "content_sanskrit": "आत्मजैः सह दुर्धर्षमानयस्व समन्त्रिणम्।\nऔपकार्यां स गत्वा तु रघूणां कुलवर्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000070013, "chapter_id": 9070, "verse_number": "१-७०-१३", "content_sanskrit": "ददर्श शिरसा चैनमभिवाद्येदमब्रवीत्।\nअयोध्याधिपते वीर वैदेहो मिथिलाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000070014, "chapter_id": 9070, "verse_number": "१-७०-१४", "content_sanskrit": "स त्वां द्रष्टुं व्यवसितः सोपाध्यायपुरोहितम्।\nमन्त्रिश्रेष्ठवचः श्रुत्वा राजा सर्षिगणस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000070015, "chapter_id": 9070, "verse_number": "१-७०-१५", "content_sanskrit": "सबन्धुरगमत् तत्र जनको यत्र वर्तते।\nराजा च मन्त्रिसहितः सोपाध्यायः सबान्धवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000070016, "chapter_id": 9070, "verse_number": "१-७०-१६", "content_sanskrit": "वाक्यं वाक्यविदां श्रेष्ठो वैदेहमिदमब्रवीत्।\nविदितं ते महाराज इक्ष्वाकुकुलदैवतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000070017, "chapter_id": 9070, "verse_number": "१-७०-१७", "content_sanskrit": "वक्ता सर्वेषु कृत्येषु वसिष्ठो भगवानृषिः।\nविश्वामित्राभ्यनुज्ञातः सह सर्वैर्महर्षिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000070018, "chapter_id": 9070, "verse_number": "१-७०-१८", "content_sanskrit": "एष वक्ष्यति धर्मात्मा वसिष्ठो मे यथाक्रमम्।\nतूष्णींभूते दशरथे वसिष्ठो भगवानृषिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000070019, "chapter_id": 9070, "verse_number": "१-७०-१९", "content_sanskrit": "उवाच वाक्यं वाक्यज्ञो वैदेहं सपुरोधसम्।\nअव्यक्तप्रभवो ब्रह्मा शाश्वतो नित्य अव्ययः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000070020, "chapter_id": 9070, "verse_number": "१-७०-२०", "content_sanskrit": "तस्मान्मरीचिः संजज्ञे मरीचेः कश्यपः सुतः।\nविवस्वान् कश्यपाज्जज्ञे मनुर्वैवस्वतः स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000070021, "chapter_id": 9070, "verse_number": "१-७०-२१", "content_sanskrit": "मनुः प्रजापतिः पूर्वमिक्ष्वाकुश्च मनोः सुतः।\nतमिक्ष्वाकुमयोध्यायां राजानं विद्धि पूर्वकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000070022, "chapter_id": 9070, "verse_number": "१-७०-२२", "content_sanskrit": "इक्ष्वाकोस्तु सुतः श्रीमान् कुक्षिरित्येव विश्रुतः।\nकुक्षेरथात्मजः श्रीमान् विकुक्षिरुदपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000070023, "chapter_id": 9070, "verse_number": "१-७०-२३", "content_sanskrit": "विकुक्षेस्तु महातेजा बाणः पुत्रः प्रतापवान्।\nबाणस्य तु महातेजा अनरण्यः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000070024, "chapter_id": 9070, "verse_number": "१-७०-२४", "content_sanskrit": "अनरण्यात् पृथुर्जज्ञे त्रिशङ्कुस्तु पृथोरपि।\nत्रिशङ्कोरभवत् पुत्रो धुन्धुमारो महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000070025, "chapter_id": 9070, "verse_number": "१-७०-२५", "content_sanskrit": "धुन्धुमारान्महातेजा युवनाश्वो महारथः।\nयुवनाश्वसुतश्चासीन्मान्धाता पृथिवीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000070026, "chapter_id": 9070, "verse_number": "१-७०-२६", "content_sanskrit": "मान्धातुस्तु सुतः श्रीमान् सुसन्धिरुदपद्यत।\nसुसन्धेरपि पुत्रौ द्वौ ध्रुवसन्धिः प्रसेनजित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000070027, "chapter_id": 9070, "verse_number": "१-७०-२७", "content_sanskrit": "यशस्वी ध्रुवसन्धेस्तु भरतो नाम नामतः।\nभरतात् तु महातेजा असितो नाम जायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000070028, "chapter_id": 9070, "verse_number": "१-७०-२८", "content_sanskrit": "यस्यैते प्रतिराजान उदपद्यन्त शत्रवः।\nहैहयास्तालजङ्घाश्च शूराश्च शशबिन्दवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000070029, "chapter_id": 9070, "verse_number": "१-७०-२९", "content_sanskrit": "तांश्च स प्रतियुध्यन् वै युद्धे राजा प्रवासितः।\nहिमवन्तमुपागम्य भार्याभ्यां सहितस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000070030, "chapter_id": 9070, "verse_number": "१-७०-३०", "content_sanskrit": "असितोऽल्पबलो राजा कालधर्ममुपेयिवान्।\nद्वे चास्य भार्ये गर्भिण्यौ बभूवतुरिति श्रुतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000070031, "chapter_id": 9070, "verse_number": "१-७०-३१", "content_sanskrit": "एका गर्भविनाशार्थं सपत्न्यै सगरं ददौ।\nततः शैलवरे रम्ये बभूवाभिरतो मुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000070032, "chapter_id": 9070, "verse_number": "१-७०-३२", "content_sanskrit": "भार्गवश्च्यवनो नाम हिमवन्तमुपाश्रितः।\nतत्र चैका महाभागा भार्गवं देववर्चसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000070033, "chapter_id": 9070, "verse_number": "१-७०-३३", "content_sanskrit": "ववन्दे पद्मपत्राक्षी कांक्षन्ती सुतमुत्तमम्।\nतमृषिं साभ्युपागम्य कालिन्दी चाभ्यवादयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000070034, "chapter_id": 9070, "verse_number": "१-७०-३४", "content_sanskrit": "स तामभ्यवदद् विप्रः पुत्रेप्सुं पुत्रजन्मनि।\nतव कुक्षौ महाभागे सुपुत्रः सुमहाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000070035, "chapter_id": 9070, "verse_number": "१-७०-३५", "content_sanskrit": "महावीर्यो महातेजा अचिरात् संजनिष्यति।\nगरेण सहितः श्रीमान् मा शुचः कमलेक्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000070036, "chapter_id": 9070, "verse_number": "१-७०-३६", "content_sanskrit": "च्यवनं च नमस्कृत्य राजपुत्री पतिव्रता।\nपत्या विरहिता तस्मात् पुत्रं देवी व्यजायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000070037, "chapter_id": 9070, "verse_number": "१-७०-३७", "content_sanskrit": "सपत्न्या तु गरस्तस्यै दत्तो गर्भजिघांसया।\nसह तेन गरेणैव संजातः सगरोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000070038, "chapter_id": 9070, "verse_number": "१-७०-३८", "content_sanskrit": "सगरस्यासमञ्जस्तु असमञ्जादथांशुमान्।\nदिलीपोंऽशुमतः पुत्रो दिलीपस्य भगीरथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000070039, "chapter_id": 9070, "verse_number": "१-७०-३९", "content_sanskrit": "भगीरथात् ककुत्स्थश्च ककुत्स्थाच्च रघुस्तथा।\nरघोस्तु पुत्रस्तेजस्वी प्रवृद्धः पुरुषादकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000070040, "chapter_id": 9070, "verse_number": "१-७०-४०", "content_sanskrit": "कल्माषपादोऽप्यभवत् तस्माज्जातस्तु शङ्खणः।\nसुदर्शनः शङ्खणस्य अग्निवर्णः सुदर्शनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000070041, "chapter_id": 9070, "verse_number": "१-७०-४१", "content_sanskrit": "शीघ्रगस्त्वग्निवर्णस्य शीघ्रगस्य मरुः सुतः।\nमरोः प्रशुश्रुकस्त्वासीदम्बरीषः प्रशुश्रुकात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000070042, "chapter_id": 9070, "verse_number": "१-७०-४२", "content_sanskrit": "अम्बरीषस्य पुत्रोऽभून्नहुषश्च महीपतिः।\nनहुषस्य ययातिस्तु नाभागस्तु ययातिजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000070043, "chapter_id": 9070, "verse_number": "१-७०-४३", "content_sanskrit": "नाभागस्य बभूवाज अजाद् दशरथोऽभवत्।\nअस्माद् दशरथाज्जातौ भ्रातरौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000070044, "chapter_id": 9070, "verse_number": "१-७०-४४", "content_sanskrit": "आदिवंशविशुद्धानां राज्ञां परमधर्मिणाम्।\nइक्ष्वाकुकुलजातानां वीराणां सत्यवादिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000070045, "chapter_id": 9070, "verse_number": "१-७०-४५", "content_sanskrit": "रामलक्ष्मणयोरर्थे त्वत्सुते वरये नृप।\nसदृशाभ्यां नरश्रेष्ठ सदृशे दातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000070046, "chapter_id": 9070, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे सप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]