[{"id": 7002513000, "chapter_id": 22513, "verse_number": "१-१७५-१", "content_sanskrit": "गरुड उवाच ।\nसर्वरोगहता ये तु आधिव्याधिसमन्विताः ।\nग्रहोपघातैर्विविधैरर्दिता ये च मानवाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002513001, "chapter_id": 22513, "verse_number": "१-१७५-२", "content_sanskrit": "अरिभिः पीडिता ये च विनायकहताश्च ये ।\nकर्तव्यं किं भवेत्तेषामात्मनः श्रेयसेऽनघ ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002513002, "chapter_id": 22513, "verse_number": "१-१७५-३", "content_sanskrit": "अरुण उवाच ।\nनानारोगहतानां तु अर्दितानां तथारिभिः ।\nआदित्याराधनं मुक्त्वा नान्यच्छ्रेयस्करं परम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002513003, "chapter_id": 22513, "verse_number": "१-१७५-४", "content_sanskrit": "तस्मादाराधयेन्नित्यं सर्वरोगविनाशनम् ।\nग्रहोपघातहंतारं राजोपद्रवनाशनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002513004, "chapter_id": 22513, "verse_number": "१-१७५-५", "content_sanskrit": "गरुड उवाच ।\nसर्वपत्रविहीनं मे सर्वरोगविवर्जितम् ।\nशापेन ब्रह्मवादिन्याः पश्यांगं द्विजसत्तम ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002513005, "chapter_id": 22513, "verse_number": "१-१७५-६", "content_sanskrit": "एवं मत्तस्य मे तात किं कार्यमवशिष्यते ।\nयेनाहं कर्मणा कल्पो भवेयं पत्रवान्पुनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002513006, "chapter_id": 22513, "verse_number": "१-१७५-७", "content_sanskrit": "तन्मे ब्रूहि खगश्रेष्ठ प्रपन्नस्य खगाधिप ।\nयत्कृत्वा कल्पतां प्राप्य पूजयामि दिवाकरम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002513007, "chapter_id": 22513, "verse_number": "१-१७५-८", "content_sanskrit": "अरुण उवाच ।\nपूजयस्व जगन्नाथं भास्करं तिमिरापहम् ।\nसूर्याग्निकार्यं सततं शुद्धचित्तः समाचर ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002513008, "chapter_id": 22513, "verse_number": "१-१७५-९", "content_sanskrit": "महाशांतिकरं ख्यातं सर्वोपद्रवनाशनम् ।\nग्रहोपघातहंतारं शुभकार्यंकरं परम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002513009, "chapter_id": 22513, "verse_number": "१-१७५-१०", "content_sanskrit": "गरुड उवाच ।\nनाहं शक्तोस्मि वै कर्तुं पूजां दिनकरस्य च ।\nन चाग्निकार्यं शक्नोमि कर्तुं विकलतां गतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002513010, "chapter_id": 22513, "verse_number": "१-१७५-११", "content_sanskrit": "तस्मान्मे कुरु शांत्यर्थमग्निकार्यं खगाधिप ।\nमहाशांतिरिति ख्यातं शांतये मम सुव्रत ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002513011, "chapter_id": 22513, "verse_number": "१-१७५-१२", "content_sanskrit": "अरुण उवाच  ।\nएवमेव यदात्थ त्वं वैनतेय खगाधिप ।\nअकल्पस्त्वं न शक्नोषि महाव्याधिप्रपीडितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002513012, "chapter_id": 22513, "verse_number": "१-१७५-१३", "content_sanskrit": "अहं करोमि ते पुत्र शांतये पावकार्चनम् ।\nयत्कृतं मम चार्केण पुरा शांतिदमादरात् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002513013, "chapter_id": 22513, "verse_number": "१-१७५-१४", "content_sanskrit": "सर्वपापहरं पुण्यं महाविप्रविनाशनम् ।\nमहोदयं शातिकरं लक्षहोमविधि स्मृतम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002513014, "chapter_id": 22513, "verse_number": "१-१७५-१५", "content_sanskrit": "अपमृत्युहरं वीर सर्वव्याधिहरं परम् ।\nपरचक्रप्रमथनं सदाविजयवर्धनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002513015, "chapter_id": 22513, "verse_number": "१-१७५-१६", "content_sanskrit": "तृप्तिदं सर्वदेवानां भास्करप्रियमुत्तम् ।\nआग्नेय्यां दिशि लिप्याथ स्थडिलं गोमयेन तु ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002513016, "chapter_id": 22513, "verse_number": "१-१७५-१७", "content_sanskrit": "देवालयस्य विधिवत्कुर्यादग्निप्रबोधनम् ।\nमहाव्याहृतिभिर्वीर लक्षहोमं समाचरेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002513017, "chapter_id": 22513, "verse_number": "१-१७५-१८", "content_sanskrit": "भूर्भुवःस्वरिति स्वाहा प्रणवेन समन्वितम् ।\nआरक्तदेहरूपाय रक्ताक्षाय महात्मने ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002513018, "chapter_id": 22513, "verse_number": "१-१७५-१९", "content_sanskrit": "धराधराय शान्ताय सहस्राक्षिशिराय च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002513019, "chapter_id": 22513, "verse_number": "१-१७५-२०", "content_sanskrit": "अधोमुखाय श्वेताय स्वाहा पूर्वाहुतिं सृजेत्  ।\nचतुर्मुखाय शांताय पद्मासनगताय च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002513020, "chapter_id": 22513, "verse_number": "१-१७५-२१", "content_sanskrit": "पद्मवर्णाय वेधाय कमण्डलुधराय च ।\nद्वितीयोर्ध्वमुखायेह स्वाहाकाराहुतिं सृजेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002513021, "chapter_id": 22513, "verse_number": "१-१७५-२२", "content_sanskrit": "हेमवर्णाय देहाय ऐरावतगताय च ।\nसहस्राक्षशरीराय पूर्वदिश्युन्मुखाय च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002513022, "chapter_id": 22513, "verse_number": "१-१७५-२३", "content_sanskrit": "देवाधिपाय चेन्द्राय विहस्ताय शुभाय च ।\nस्वाहाकारं चोत्सृजेदेव तृतीयवदनाय च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002513023, "chapter_id": 22513, "verse_number": "१-१७५-२४", "content_sanskrit": "दीप्ताय व्यक्तदेहाय ज्वालामालाकुलाय च ।\nइन्द्रनीलाभदेहाय सर्वारोग्यकराय च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002513024, "chapter_id": 22513, "verse_number": "१-१७५-२५", "content_sanskrit": "यमाय धर्मराजाय दक्षिणाशामुखाय च ।\nकृष्णांबरधरायेह स्वाहाहुतिमनुत्सृजेत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002513025, "chapter_id": 22513, "verse_number": "१-१७५-२६", "content_sanskrit": "नीलजीमूतवर्णाय रक्तांबरधराय च ।\nमुक्ताफलशरीराय पिंगाक्षाय महात्मने ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002513026, "chapter_id": 22513, "verse_number": "१-१७५-२७", "content_sanskrit": "शुक्लवस्त्राय पीताय दिव्यपाशधराय च ।\nस्वाहाकाराय च तथा पश्चिमाभिमुखाय च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002513027, "chapter_id": 22513, "verse_number": "१-१७५-२८", "content_sanskrit": "कृष्णपिंगलनेत्राय वायव्याभिमुखाय च ।\nनीलध्वजाय वीराय तथा चेन्द्राय वेधसे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002513028, "chapter_id": 22513, "verse_number": "१-१७५-२९", "content_sanskrit": "स्वाहेति पवनायेह आहुतिं चोत्सृजेद्बुधः ।\nगदाहस्ताय सूर्याय चित्रस्रग्भूषणाय च ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002513029, "chapter_id": 22513, "verse_number": "१-१७५-३०", "content_sanskrit": "महोदराय शांताय स्वाहाधिपतये तथा ।\nउत्तराभिमुखायेह महादेवप्रियाय च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002513030, "chapter_id": 22513, "verse_number": "१-१७५-३१", "content_sanskrit": "श्वेताय श्वेतवर्णाय चित्राक्षाय महात्मने ।\nशांताय शांतरूपाय पिनाकवरधारिणे ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002513031, "chapter_id": 22513, "verse_number": "१-१७५-३२", "content_sanskrit": "ईशानाभिमुखायेह दद्यादीशाय चाहुतिम् ।\nविसृजेत्खगशार्दूल विधिवच्छ्रेयसेनघ ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002513032, "chapter_id": 22513, "verse_number": "१-१७५-३३", "content_sanskrit": "एवं देवं महात्मानं पावकं विधिवत्खग ।\nअर्हेदिति तु यत्कार्यं तत्सौरं खगसत्तम ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002513033, "chapter_id": 22513, "verse_number": "१-१७५-३४", "content_sanskrit": "लक्षहोमं च विधिवत्कृत्वा शांतिकमाचरेत् ।\nभूर्भुवःस्वरिति स्वा हा लक्षहोमविधिः स्मृतः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002513034, "chapter_id": 22513, "verse_number": "१-१७५-३५", "content_sanskrit": "महाहोमे च वै सौर एष एव विधिः परः ।\nकृत्वैवमग्निकार्यं तु भोजको भास्कराय वै ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002513035, "chapter_id": 22513, "verse_number": "१-१७५-३६", "content_sanskrit": "शांत्यर्थं सर्वलोकानां ततः शांतिकमाचरेत् ।\nसिन्दूरासनरक्ताभः रक्तपद्माभलोचनः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002513036, "chapter_id": 22513, "verse_number": "१-१७५-३७", "content_sanskrit": "सहस्रकिरणो देवः सप्ताश्वरथवाहनः ।\nगभस्तिमाली भगवान्सर्वदेवनमस्कृतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002513037, "chapter_id": 22513, "verse_number": "१-१७५-३८", "content_sanskrit": "करोतु ते महाशांतिं ग्रहपीडानिवारिणीम् ।\nत्रिचक्ररथमारूढ अपां सारमयं तु यः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002513038, "chapter_id": 22513, "verse_number": "१-१७५-३९", "content_sanskrit": "दशाश्ववाहनो देव आत्रेय श्चामृतस्रवः ।\nशीतांशुरमृतात्मा च क्षयवृद्धिसमन्वितः ।\nसोमः सौम्येन भावेन ग्रहपीडां व्यपोहतु ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002513039, "chapter_id": 22513, "verse_number": "१-१७५-४०", "content_sanskrit": "पद्मरागनिभो भौमो मधुपिंगल लोचनः ।\nअंगारकोऽग्निसदृशो ग्रहपीडां व्यपोहतु ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002513040, "chapter_id": 22513, "verse_number": "१-१७५-४१", "content_sanskrit": "पुष्परागनिभेनेह देहेन परिपिंगलः ।\nपीतमाल्यांबरधरो बुधः पीडां व्यपोहतु ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002513041, "chapter_id": 22513, "verse_number": "१-१७५-४२", "content_sanskrit": "तप्तगैरिकसंकाशः सर्वशास्त्रविशारदः ।\nसर्वदेवगुरुर्विप्रो ह्यथर्वणवरो मुनिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002513042, "chapter_id": 22513, "verse_number": "१-१७५-४३", "content_sanskrit": "बृहस्पतिरिति ख्यात अर्थशास्त्रपरश्च यः ।\nशांतेन चेतसा सोपि परेण सुसमाहितः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002513043, "chapter_id": 22513, "verse_number": "१-१७५-४४", "content_sanskrit": "ग्रहपीडां विनिर्जित्य करोतु तव शांतिकम् ।\nसूर्यार्चनपरो नित्यं प्रसादाद्भास्करस्य तु ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002513044, "chapter_id": 22513, "verse_number": "१-१७५-४५", "content_sanskrit": "हिमकुंदेंदुवर्णाभो दैत्यदानवपूजितः ।\nमहेश्वरस्ततो धीमान्महासौरो महामतिः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002513045, "chapter_id": 22513, "verse_number": "१-१७५-४६", "content_sanskrit": "सूर्यार्चनपरो नित्यं शुक्रः शुक्लनिभस्तदा ।\nनीतिशास्त्रपरो नित्यं ग्रहपीडां व्यपोहतु ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002513046, "chapter_id": 22513, "verse_number": "१-१७५-४७", "content_sanskrit": "नानारूपधरोव्यक्त अविज्ञातगतिश्च यः ।\nनोत्पत्तिर्जायते यस्य नोदयपीडितैरपि ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002513047, "chapter_id": 22513, "verse_number": "१-१७५-४८", "content_sanskrit": "एकचूलो द्विचूलश्च त्रिशिखः पंचचूलकः ।\nसहस्रशिररूपस्तु चन्द्रकेतुरिव स्थितः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002513048, "chapter_id": 22513, "verse_number": "१-१७५-४९", "content_sanskrit": "सूर्यपुत्रोग्निपुत्रस्तु ब्रह्मविष्णुशिवात्मकः ।\nअनेकशिखरः केतुः स ते पीडां व्यपोहतु ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002513049, "chapter_id": 22513, "verse_number": "१-१७५-५०", "content_sanskrit": "एते ग्रहा महात्मानः सूर्यार्चनपराः सदा ।\nशांतिं कुर्वंतु ते हृष्टाः सदा कालं हितेक्षणाः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]