[{"id": 6000142000, "chapter_id": 10142, "verse_number": null, "content_sanskrit": "अथ चतुर्थाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000142001, "chapter_id": 10142, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.001.m4a", "display_order": 2}, {"id": 6000142002, "chapter_id": 10142, "verse_number": "७-४-१", "content_sanskrit": "एवं वृतः शतधृतिः हिरण्यकशिपोरथ।\nप्रादात् तत्तपसा प्रीतो वरान् तस्य सुदुर्लभान्॥ ७/४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.002.m4a", "display_order": 3, "topics": [{"text": "ब्रह्मणः सकाशात्प्राप्तवरेण हिरण्यकशिपुना इन्द्रस्य त्रिविष्टपहरणम्", "range": "१–२०"}]}, {"id": 6000142003, "chapter_id": 10142, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.003.m4a", "display_order": 4}, {"id": 6000142004, "chapter_id": 10142, "verse_number": "७-४-२", "content_sanskrit": "तातेमे दुर्लभाः पुंसो यान् वृणीषे वरान् मम।\nतथाऽपि वितराम्यङ्ग वरान् यदपि दुर्लभान्॥ ७/४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.004.m4a", "display_order": 5}, {"id": 6000142005, "chapter_id": 10142, "verse_number": "७-४-३", "content_sanskrit": "ततो जगाम भगवानमोघानुग्रहो विभुः।\nपूजितोऽसुरवर्येण स्तूयमानः प्रजेश्वरैः॥ ७/४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.005.m4a", "display_order": 6}, {"id": 6000142006, "chapter_id": 10142, "verse_number": "७-४-४", "content_sanskrit": "एवं लब्धवरो दैत्यो बिभ्रद्धेममयं वपुः।\nभगवत्यकरोद् द्वेषं भ्रातुर्वधमनुस्मरन्॥ ७/४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.006.m4a", "display_order": 7}, {"id": 6000142007, "chapter_id": 10142, "verse_number": "७-४-५", "content_sanskrit": "स विजित्य दिशः सर्वा लोकांश्च त्रीन् महासुरः।\nदेवासुरमनुष्येन्द्रान् गन्धर्वगरुडोरगान्॥ ७/४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.007.m4a", "display_order": 8}, {"id": 6000142008, "chapter_id": 10142, "verse_number": "७-४-६", "content_sanskrit": "सिद्धचारणविद्याध्रान् ऋषीन् पितृपतीन् मनून्।\nयक्षरक्षःपिशाचेशान् प्रेतभूतपतीनपि॥ ७/४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.008.m4a", "display_order": 9}, {"id": 6000142009, "chapter_id": 10142, "verse_number": "७-४-७", "content_sanskrit": "सर्वसत्त्वपतीन् जित्वा वशमानीय विश्वजित्।\nजहार लोकपालानां स्थानानि सह तेजसा॥ ७/४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.009.m4a", "display_order": 10}, {"id": 6000142010, "chapter_id": 10142, "verse_number": "७-४-८", "content_sanskrit": "देवोद्यानश्रिया जुष्टमध्यास्ते स्म त्रिविष्टपम्।\nमहेन्द्रभवनं साक्षान्निर्मितं विश्वकर्मणा॥ ७/४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.010.m4a", "display_order": 11}, {"id": 6000142011, "chapter_id": 10142, "verse_number": "७-४-९", "content_sanskrit": "त्रैलोक्यलक्ष्म्यायतनमध्युवासाखिलर्द्धिमत्।\nयत्र विद्रुमसोपाना महामरकता भुवः॥ ७/४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.011.m4a", "display_order": 12}, {"id": 6000142012, "chapter_id": 10142, "verse_number": "७-४-१०", "content_sanskrit": "यत्र स्फटिककुड्यानि वैदूर्यस्तम्भपङ्क्तयः।\nयत्र चित्रवितानानि पद्मरागासनानि च॥ ७/४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.012.m4a", "display_order": 13}, {"id": 6000142013, "chapter_id": 10142, "verse_number": "७-४-११", "content_sanskrit": "पयःफेननिभाः शय्या मुक्तादामपरिच्छदाः। कूजद्भिर्नूपुरैर्देव्यः शब्दयन्त्य इतस्ततः।\nरत्नस्थलीषु पश्यन्ति सुदतीः सुन्दरं मुखम्॥ ७/४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.013.m4a", "display_order": 14}, {"id": 6000142014, "chapter_id": 10142, "verse_number": "७-४-१२", "content_sanskrit": "तस्मिन् महेन्द्रभवने महासुरो महाबलो निर्जितलोक एकराट्।\nरेमेऽभिवन्द्याङ्घ्रियुगः सुरादिभिः प्रतापितैरूर्जितचण्डशासनः॥ ७/४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.014.m4a", "display_order": 15}, {"id": 6000142015, "chapter_id": 10142, "verse_number": "७-४-१३", "content_sanskrit": "तमङ्ग मत्तं मधुनोरुगन्धिना विवृत्तताम्राक्षमशेषधिष्ण्यपाः।\nउपासतोपायनपाणिभिर्विना त्रिभिस्तपोयोगबलौजसां पदम्॥ ७/४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.015.m4a", "display_order": 16}, {"id": 6000142016, "chapter_id": 10142, "verse_number": "७-४-१४", "content_sanskrit": "जगुर्महेन्द्रासनमोजसा स्थितं विश्वावसुस्तुम्बुरुरस्मदादयः।\nगन्धर्वसिद्धा ऋषयोऽस्तुवन् मुहुर्विद्याधरा अप्सरसश्च पाण्डव॥ ७/४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.016.m4a", "display_order": 17}, {"id": 6000142017, "chapter_id": 10142, "verse_number": "७-४-१५", "content_sanskrit": "स एव वर्णाश्रमिभिः क्रतुभिर्भूरिदक्षिणैः।\nइज्यमानो हविर्भागानग्रहीत् स्वेन तेजसा॥ ७/४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.017.m4a", "display_order": 18}, {"id": 6000142018, "chapter_id": 10142, "verse_number": "७-४-१६", "content_sanskrit": "अकृष्टपच्या तस्यासीत् सप्तद्वीपवती मही।\nतथा कामदुघा द्यौश्च नानाश्चर्यपदं नभः॥ ७/४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.018.m4a", "display_order": 19}, {"id": 6000142019, "chapter_id": 10142, "verse_number": "७-४-१७", "content_sanskrit": "रत्नाकराश्च रत्नानि तत्पत्न्यश्चोहुरूर्मिभिः।\nक्षारसीधुघृतक्षौद्रदधिक्षीरामृतोदकाः॥ ७/४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.019.m4a", "display_order": 20}, {"id": 6000142020, "chapter_id": 10142, "verse_number": "७-४-१८", "content_sanskrit": "शैला द्रोणीभिराक्रीडं सर्वर्तुषु गुणान् द्रुमाः।\nदधार लोकपालानामेक एव पृथग् गुणान्॥ ७/४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.020.m4a", "display_order": 21}, {"id": 6000142021, "chapter_id": 10142, "verse_number": "७-४-१९", "content_sanskrit": "स इत्थं निर्जितककुबेकराड् विषयान् प्रियान्।\nयथोपजोषं भुञ्जानो नातृप्यदजितेन्द्रियः॥ ७/४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.021.m4a", "display_order": 22}, {"id": 6000142022, "chapter_id": 10142, "verse_number": "७-४-२०", "content_sanskrit": "एवमैश्वर्यमत्तस्य दृप्तस्योच्छास्‍त्रवर्तिनः।\nकालो महान् व्यतीयाय ब्रह्मशापमुपेयुषः॥ ७/४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.022.m4a", "display_order": 23}, {"id": 6000142023, "chapter_id": 10142, "verse_number": "७-४-२१", "content_sanskrit": "तस्योग्रदण्डसंविग्नाः सर्वे लोकाः सपालकाः।\nअन्यत्रालब्धशरणाः शरणं ययुरच्युतम्॥ ७/४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.023.m4a", "display_order": 24, "topics": [{"text": "तदुपद्रवसंविग्नैर्देवैः भगवन्तं प्रति शरणगमनम्", "range": "२०–२५"}]}, {"id": 6000142024, "chapter_id": 10142, "verse_number": "७-४-२२", "content_sanskrit": "तस्यै नमोऽस्तु काष्ठायै यत्रात्मा हरिरीश्वरः।\nयद् गत्वा न निवर्तन्ते शान्ताः संन्यासिनोऽमलाः॥ ७/४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.024.m4a", "display_order": 25}, {"id": 6000142025, "chapter_id": 10142, "verse_number": "७-४-२३", "content_sanskrit": "इति ते संयतात्मानः समाहितधियोऽमलाः।\nउपतस्थुर्हृषीकेशं विनिद्रा वायुभोजनाः॥ ७/४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.025.m4a", "display_order": 26}, {"id": 6000142026, "chapter_id": 10142, "verse_number": "७-४-२४", "content_sanskrit": "ओं नमो भगवते महापुरुषाय महात्मने।\nविशुद्धानुभवानन्दसन्दोहाय यतोऽभयम्॥ ७/४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.026.m4a", "display_order": 27}, {"id": 6000142027, "chapter_id": 10142, "verse_number": "७-४-२५", "content_sanskrit": "तेषामाविरभूद् वाणी अरूपा मेघनिस्वना।\nसन्नादयन्ती ककुभः साधूनामभयङ्करी॥ ७/४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.027.m4a", "display_order": 28}, {"id": 6000142028, "chapter_id": 10142, "verse_number": "७-४-२६", "content_sanskrit": "मा भैष्ट विबुधश्रेष्ठाः सर्वेषां भद्रमस्तु वः।\nमद्दर्शनं हि भूतानां सर्वश्रेयोपपत्तये॥ ७/४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.028.m4a", "display_order": 29, "topics": [{"text": "श्रीमता नारायणेन तेषामभयदानपूर्वकं ‘यदाऽयमसुरः परमभागवताय स्वपुत्राय प्रह्लादाय द्रुह्यति तदा तं हनिष्यामि’ इत्युक्त्वा प्रेषणम्", "range": "२५–२९"}]}, {"id": 6000142029, "chapter_id": 10142, "verse_number": "७-४-२७", "content_sanskrit": "ज्ञातमेतस्य दौरात्म्यं दैतेयापसदस्य यत्।\nतस्य शान्तिं करिष्यामि कालस्तावत् प्रतीक्ष्यताम्॥ ७/४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.029.m4a", "display_order": 30}, {"id": 6000142030, "chapter_id": 10142, "verse_number": "७-४-२८", "content_sanskrit": "यदा देवेषु वेदेषु गोषु विप्रेषु साधुषु।\nधर्मे मयि च विद्वेषः स वा आशु विनश्यति॥ ७/४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.030.m4a", "display_order": 31}, {"id": 6000142031, "chapter_id": 10142, "verse_number": "७-४-२९", "content_sanskrit": "निर्वैराय प्रशान्ताय स्वसुताय महात्मने।\nप्रह्लादाय यदा द्रुह्येद्धनिष्येऽपि वरोर्जितम्॥ ७/४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.031.m4a", "display_order": 32}, {"id": 6000142032, "chapter_id": 10142, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.032.m4a", "display_order": 33}, {"id": 6000142033, "chapter_id": 10142, "verse_number": "७-४-३०", "content_sanskrit": "इत्युक्ता लोकगुरुणा तं प्रणम्य दिवौकसः।\nन्यवर्तन्त गतोद्वेगा मेनिरे चासुरं हतम्॥ ७/४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.033.m4a", "display_order": 34, "topics": [{"text": "नारदेन युधिष्ठिरं प्रति प्रह्लादकथाकथनम्", "range": "२९–४७"}]}, {"id": 6000142034, "chapter_id": 10142, "verse_number": "७-४-३१", "content_sanskrit": "तस्य दैत्यपतेः पुत्राश्चत्वारः परमाद्भुताः। प्रह्लादोऽभून्महान् तेषां गुणैर्महदुपासकः।\nब्रह्मण्यः शीलसम्पन्नः सत्यसन्धो जितेन्द्रियः॥ ७/४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.034.m4a", "display_order": 35}, {"id": 6000142035, "chapter_id": 10142, "verse_number": "७-४-३२", "content_sanskrit": "आत्मवत् सर्वभूतानामेकः प्रियसुहृत्तमः।\nदासवत् सन्नतार्याङ्घ्रिः पितृवद् दीनवत्सलः॥ ७/४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.035.m4a", "display_order": 36}, {"id": 6000142036, "chapter_id": 10142, "verse_number": "७-४-३३", "content_sanskrit": "भ्रातृवत् सदृशे स्निग्धो गुरुष्वीश्वरभावनः।\nविद्यार्थरूपजन्माद्यैर्मानस्तम्भविवर्जितः॥ ७/४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.036.m4a", "display_order": 37}, {"id": 6000142037, "chapter_id": 10142, "verse_number": "७-४-३४", "content_sanskrit": "नोद्विग्नचित्तो व्यसनेषु निःस्पृहः श्रुतेषु दृष्टेषु गुणेष्ववस्तुदृक्।\nदान्तेन्द्रियप्राणशरीरधीः सदा प्रशान्तकामो रहितासुरोऽसुरः॥ ७/४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.037.m4a", "display_order": 38}, {"id": 6000142038, "chapter_id": 10142, "verse_number": "७-४-३५", "content_sanskrit": "यस्मिन् महागुणा राजन् गृह्यन्ते कविभिर्मुहुः।\nन तेऽधुनाऽभिधीयन्ते यथा भगवतीश्वरे॥ ७/४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.038.m4a", "display_order": 39}, {"id": 6000142039, "chapter_id": 10142, "verse_number": "७-४-३६", "content_sanskrit": "यं साधुगाथासदसि रिपवोऽपि सुरा नृप।\nप्रतिमानं प्रकुर्वन्ति किमुतान्ये भवादृशाः॥ ७/४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.039.m4a", "display_order": 40}, {"id": 6000142040, "chapter_id": 10142, "verse_number": "७-४-३७", "content_sanskrit": "गुणैरलमसङ्ख्येयैर्माहात्म्यं तस्य सूच्यते।\nवासुदेवे भगवति यस्य नैसर्गिकी रतिः॥ ७/४/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.040.m4a", "display_order": 41}, {"id": 6000142041, "chapter_id": 10142, "verse_number": "७-४-३८", "content_sanskrit": "न्यस्तक्रीडनको बालो जडवत् तन्मनाः सदा।\nकृष्णग्रहगृहीतात्मा न वेद जगदीदृशम्॥ ७/४/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.041.m4a", "display_order": 42}, {"id": 6000142042, "chapter_id": 10142, "verse_number": "७-४-३९", "content_sanskrit": "आसीनः पर्यटन्नश्नन् शयानः प्रपिबन् ब्रुवन्।\nनानुसन्दध एतानि गोविन्दपरिरक्षितः॥ ७/४/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.042.m4a", "display_order": 43}, {"id": 6000142043, "chapter_id": 10142, "verse_number": "७-४-४०", "content_sanskrit": "क्‍वचिद् रुदति गोविन्दचिन्ताचञ्चलचेतनः।\nक्‍वचिद्धसति तच्चिन्ताह्लाद उद्गायति क्‍वचित्॥ ७/४/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.043.m4a", "display_order": 44}, {"id": 6000142044, "chapter_id": 10142, "verse_number": "७-४-४१", "content_sanskrit": "नदति क्‍वचिदुत्कण्ठो विलज्जो नृत्यति क्‍वचित्।\nक्‍वचित् तद्भावनायुक्तस्तन्मयोऽनुचकार ह॥ ७/४/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.044.m4a", "display_order": 45}, {"id": 6000142045, "chapter_id": 10142, "verse_number": "७-४-४२", "content_sanskrit": "क्‍वचिदुत्पुलकस्तूष्णीमशेषस्पर्शनिःस्पृहः।\nअस्पन्दप्राण आनन्दसलिलामीलितेक्षणः॥ ७/४/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.045.m4a", "display_order": 46}, {"id": 6000142046, "chapter_id": 10142, "verse_number": "७-४-४३", "content_sanskrit": "स उत्तमश्लोकपदारविन्दयोर्निषेवयाऽकिञ्चनसङ्गलब्धया।\nतन्वन् परां निर्वृतिमात्मनो मुहुर्दुःसङ्गहीनः स्वमनःशमं व्यधात्॥ ७/४/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.046.m4a", "display_order": 47}, {"id": 6000142047, "chapter_id": 10142, "verse_number": "७-४-४४", "content_sanskrit": "तस्मिन् महाभागवते महाभागे महात्मनि।\nहिरण्यकशिपू राजन् अकरोदघमात्मजे॥ ७/४/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.047.m4a", "display_order": 48}, {"id": 6000142048, "chapter_id": 10142, "verse_number": null, "content_sanskrit": "युधिष्ठिर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.048.m4a", "display_order": 49}, {"id": 6000142049, "chapter_id": 10142, "verse_number": "७-४-४५", "content_sanskrit": "देवर्ष एतदिच्छामो वेदितुं तव सुव्रत।\nयदात्मजाय शुद्धाय पिताऽधात् साधवे अघम्॥ ७/४/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.049.m4a", "display_order": 50}, {"id": 6000142050, "chapter_id": 10142, "verse_number": "७-४-४६", "content_sanskrit": "पुत्रान् विप्रतिकूलांश्च पितरः पुत्रवत्सलाः।\nउपालभन्ते शिक्षार्थं नैवाघमपरे यथा॥ ७/४/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.050.m4a", "display_order": 51}, {"id": 6000142051, "chapter_id": 10142, "verse_number": "७-४-४७", "content_sanskrit": "किमुतानुवशान् साधून् तादृशान् गुरुदेवतान्। एतत् कौतूहलं ब्रह्मन्नस्माकं विधम प्रभो।\nपितुः पुत्राय यद् द्वेषो मरणाय प्रयोजितः॥ ७/४/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_004/BhP_07.004.051.m4a", "display_order": 52}, {"id": 6000142052, "chapter_id": 10142, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां सप्तमस्कन्धे चतुर्थाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]