[{"id": 2185226, "chapter_id": 4931, "verse_number": "", "content_sanskrit": "शौनकेन जनमेजयप्रार्थनया तदीयब्रह्महत्यापनोदनाङ्गीकरणम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2185227, "chapter_id": 4931, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2185228, "chapter_id": 4931, "verse_number": "१", "content_sanskrit": "एवमुक्तः प्रत्युवाच तं मुनिं जनमेजयः ।\nगर्ह्यं भवान्गर्हयति निन्द्यं निन्दति मा भवान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2185229, "chapter_id": 4931, "verse_number": "२", "content_sanskrit": "धिक्कार्यं मा धिक्कुरुते तस्मात्त्वाहं प्रसादये ।\nसर्वं हीदं स्वकृतं मे ज्वलाम्यग्नाविवाहितः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2185230, "chapter_id": 4931, "verse_number": "३", "content_sanskrit": "स्वकर्माण्यभिसन्धाय नाभिनन्दति मे मनः ।\nप्राप्तं नूनं मया घोरं भयं वैवस्वतादपि\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2185231, "chapter_id": 4931, "verse_number": "४", "content_sanskrit": "तत्तु शल्यमनिर्हृत्य कथं शक्ष्यामि जीवितुम् ।\nसर्वमन्यून् विनीय त्वमभि मा वद शौनक\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2185232, "chapter_id": 4931, "verse_number": "५", "content_sanskrit": "महानासं ब्राह्मणानां भविष्याम्यर्थवान् पुनः ।\nअस्तु शेषं कुलस्यास्य मा पराभूदिदं कुलम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2185233, "chapter_id": 4931, "verse_number": "६", "content_sanskrit": "न हि नो ब्रह्मशप्तानां शेषो भवितुमर्हति ।\nश्रुतीरलभमानानां संविदं वेदनिश्चयात्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2185234, "chapter_id": 4931, "verse_number": "७", "content_sanskrit": "निर्विद्यमानः सुभृशं भूयो वक्ष्यामि साम्प्रतम् ।\nभूयश्चैवाभिनङ्क्षन्ति निर्धर्मा निर्जपा इव\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2185235, "chapter_id": 4931, "verse_number": "८", "content_sanskrit": "अर्वाक्च प्रतितिष्ठन्ति पुलिन्दशबरा इव ।\nन ह्ययज्ञा अमुं लोकं प्राप्नुवन्ति कथञ्चन\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2185236, "chapter_id": 4931, "verse_number": "९", "content_sanskrit": "अविज्ञायैव मे प्रज्ञां बालस्येव सुपण्डितः ।\nब्रह्मनि् पतेव पुत्रेभ्यः प्रति मां वाञ्छ शौनक\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2185237, "chapter_id": 4931, "verse_number": "", "content_sanskrit": "शौनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2185238, "chapter_id": 4931, "verse_number": "१०", "content_sanskrit": "किमाश्चर्यं यतः प्राज्ञो बहु कुर्याद्धि साम्प्रतम् ।\nइति वै पण्डितो भूत्वा भूतानां नोपतप्यति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2185239, "chapter_id": 4931, "verse_number": "११", "content_sanskrit": "प्रज्ञाप्रासादमारुह्य अशोच्यः शोचते जनान् ।\nजगतीस्थानिवाद्रिस्थः प्रज्ञया प्रतिपश्यति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2185240, "chapter_id": 4931, "verse_number": "१२", "content_sanskrit": "न चोपलभते तत्र न च कार्याणि पश्यति ।\nनिर्विण्णात्मा परोक्षो वा धिक्कृतः सर्वसाधुषु\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2185241, "chapter_id": 4931, "verse_number": "१३", "content_sanskrit": "विदित्वोभयतो वीर्यं माहात्म्यं वेद आगमे ।\nकुरुष्वेह महाशान्तिं ब्रह्मा शरणमस्तु ते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2185242, "chapter_id": 4931, "verse_number": "१४", "content_sanskrit": "तद्वै पारत्रिकं चारु ब्राह्मणानामकुप्यताम् ।\nअथ चेत्तप्यसे पापैर्धर्मं चेदनुपश्यसि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2185243, "chapter_id": 4931, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2185244, "chapter_id": 4931, "verse_number": "१५", "content_sanskrit": "अनुतप्ये च पापेन न चाधर्मं चराम्यहम् ।\nबुभूषुं भजमानं च प्रतिवाञ्छामि शौनक\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2185245, "chapter_id": 4931, "verse_number": "", "content_sanskrit": "शौनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2185246, "chapter_id": 4931, "verse_number": "१६", "content_sanskrit": "छित्त्वा स्तम्भं च मानं च प्रीतिमिच्छामि ते नृप ।\nसर्वभूतहिते तिष्ठ धर्मं चैव प्रतिस्मर\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2185247, "chapter_id": 4931, "verse_number": "१७", "content_sanskrit": "न भयान्न च कार्पण्यान्न लोभात्त्वामुपाह्वये ।\nतां मे देवा गिरं सत्यां शृण्वन्तु ब्राह्मणैः सह\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2185248, "chapter_id": 4931, "verse_number": "१८", "content_sanskrit": "सोऽहं न केनचिच्चार्थी त्वां च धर्ममुपाह्वये ।\nक्रोशतां सर्वभूतानामहो धिगिति कुर्वताम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2185249, "chapter_id": 4931, "verse_number": "१९", "content_sanskrit": "वक्ष्यन्ति मामधर्मज्ञा वक्ष्यन्त्यसुहृदो जनाः ।\n(वक्ष्यन्ति मामधर्मज्ञं त्यक्षन्ति सुहृदो जनाः ।)\nवाचस्ताः सुहृदः श्रुत्वा सञ्ज्वरिष्यन्ति मे भृशम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2185250, "chapter_id": 4931, "verse_number": "२०", "content_sanskrit": "केचिदेव महाप्राज्ञाः परिज्ञास्यन्ति कार्यताम् ।\nजानीहि मे कृतं तात ब्राह्मणान् प्रति भारत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2185251, "chapter_id": 4931, "verse_number": "२१", "content_sanskrit": "यथा ते मत्कृते क्षेमं लभेरंस्तत्तथा कुरु ।\nप्रतिजानीहि चाद्रोहं ब्राह्मणानां नराधिप\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2185252, "chapter_id": 4931, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2185253, "chapter_id": 4931, "verse_number": "२२", "content_sanskrit": "नैव वाचा न मनसा न पुनर्जातु कर्मणा ।\nद्रोग्धास्मि ब्राह्मणान् विप्र चरणावेव ते स्पृशे\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2185254, "chapter_id": 4931, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि आपद्धर्मे एकोनविंशोऽध्यायः ॥ १९ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]