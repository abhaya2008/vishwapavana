[{"id": 7002610000, "chapter_id": 22610, "verse_number": "४-१५-१", "content_sanskrit": "सूत उवाच ।\nज्येष्ठाषाढे तुलस्याश्च प्रतिष्ठां विधिवच्चरेत् ।\nयजमानः शुद्धदिने एकादश्यामथापि वा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002610001, "chapter_id": 22610, "verse_number": "४-१५-२", "content_sanskrit": "ततो रात्रौ घटं स्थाप्य पूजयेत्परमेश्वरम् ।\nनारायणं शिवं सोमं ब्रह्माणं चेंद्रमेव च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002610002, "chapter_id": 22610, "verse_number": "४-१५-३", "content_sanskrit": "गायत्र्या स्नपनं कुर्यात्तथोक्तैर्मंत्रकैरपि ।\nकयानेति च गंधेन अश्रुनेति च तैलकम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002610003, "chapter_id": 22610, "verse_number": "४-१५-४", "content_sanskrit": "त्वां गंधर्वेति च पुनः पुष्पं मंडंशनेति च ।\nमानस्तोकेति कुसुमं श्रीश्चतेति च चंदनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002610004, "chapter_id": 22610, "verse_number": "४-१५-५", "content_sanskrit": "वैश्वदेवीति च पुनर्मंत्रेणानेन चंदनम् ।\nदूर्वामंत्रेण दूर्वाश्च रूपेणेति च दर्प्पणम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002610005, "chapter_id": 22610, "verse_number": "४-१५-६", "content_sanskrit": "फलमंत्रेण च फलं समेधेति च अंजनम् ।\nसकुशैः पीतसूत्राद्यैर्वेष्टयेत्क्षीरधारया ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002610006, "chapter_id": 22610, "verse_number": "४-१५-७", "content_sanskrit": "शतधाराजलेनैव वेष्टयेत्स्वगृहं व्रजेत् ।\nवस्त्रेणावृत्य विधिवद्बुधः काले घटं न्यसेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002610007, "chapter_id": 22610, "verse_number": "४-१५-८", "content_sanskrit": "सप्तपंचत्रिभिर्वाथ तद्विष्णोरिति वै ऋचा ।\nस्नापयेदथ साध्वीभिः कृतमंगलपूर्वकम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002610008, "chapter_id": 22610, "verse_number": "४-१५-९", "content_sanskrit": "ततः श्राद्धं समाप्यैव मातृपूजापुरःसरम् ।\nआचार्यं वरयेत्पूर्वं गंधाद्यैः कुसुमैरपि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002610009, "chapter_id": 22610, "verse_number": "४-१५-१०", "content_sanskrit": "आचार्य एव होता स्याद्ब्रह्माणं च सदस्यकम् ।\nमंडपे दशहस्तेऽपि वर्तुले स्थंडिलेषु च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002610010, "chapter_id": 22610, "verse_number": "४-१५-११", "content_sanskrit": "सहस्रं मंडलं कुर्यात्तत्र नारायणं यजेत् ।\nग्रहांल्लोकेश्वरान्मध्ये आदित्यांश्च मरुद्गणान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002610011, "chapter_id": 22610, "verse_number": "४-१५-१२", "content_sanskrit": "रुद्रान्वसूंश्च कलशे परितश्च समर्चयेत् ।\nततः कुशकंडिकां कृत्वा होमं तिलयवेन तु ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002610012, "chapter_id": 22610, "verse_number": "४-१५-१३", "content_sanskrit": "अष्टोत्तरशतं कुर्यादन्येषां शक्तितो हुनेत् ।\nनारायणं समुद्दिश्य दद्यादुत्सृज्य सत्तमाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002610013, "chapter_id": 22610, "verse_number": "४-१५-१४", "content_sanskrit": "मध्ये यूपं समुद्दिश्य चरुपाकं बलिं ददेत् ।\nकदलीं दिक्षु संन्यस्य ध्वजान्दिक्षु प्ररोपयेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002610014, "chapter_id": 22610, "verse_number": "४-१५-१५", "content_sanskrit": "दक्षिणां कांचनं दद्यात्तिलं धान्यं सपुष्पकम् ।\nधेनुं पयस्विनीं दयाद्वेष्टयेत्क्षीरधारया ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002610015, "chapter_id": 22610, "verse_number": "४-१५-१६", "content_sanskrit": "जयंत्याः सोमवृक्षस्य तथा सोमवटस्य च ।\nपनसस्य कदंबस्य निंबस्य द्विजसत्तमाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002610016, "chapter_id": 22610, "verse_number": "४-१५-१७", "content_sanskrit": "पाटला कनकस्यैव शाल्मलीनिंबकस्य च ।\nबिंबाशोकवटस्यैव प्रतिष्ठां नैव कारयेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002610017, "chapter_id": 22610, "verse_number": "४-१५-१८", "content_sanskrit": "भद्रकस्य शमीकोणचंडातकबकस्य च ।\nखदिरस्यैव कर्तव्यं कर्णवेधं न कारयेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]