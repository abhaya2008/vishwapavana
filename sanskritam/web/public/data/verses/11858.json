[{"id": 50024455, "chapter_id": 11858, "verse_number": "1", "content_sanskrit": "॥ आजीगर्तिः शुनःशेपः। १-१२ अग्निः, १३ देवाः। १-१२ गायत्री, १३ त्रिष्टुप्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024456, "chapter_id": 11858, "verse_number": "2", "content_sanskrit": "अश्वं॒ न त्वा॒ वार॑वन्तं व॒न्दध्या॑ अ॒ग्निं नमो॑भिः। स॒म्राज॑न्तमध्व॒राणा॑म्॥ २७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024457, "chapter_id": 11858, "verse_number": "3", "content_sanskrit": "स घा॑ नः सू॒नुः शव॑सा पृ॒थुप्र॑गामा सु॒शेव॑ः। मी॒ढ्वाँ अ॒स्माकं॑ बभूयात्॥ २७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024458, "chapter_id": 11858, "verse_number": "4", "content_sanskrit": "स नो॑ दू॒राच्चा॒साच्च॒ नि मर्त्या॑दघा॒योः। पा॒हि सद॒मिद्वि॒श्वायु॑ः॥ २७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024459, "chapter_id": 11858, "verse_number": "5", "content_sanskrit": "इ॒ममू॒ षु त्वम॒स्माकं॑ स॒निं गा॑य॒त्रं नव्यां॑सम्। अग्ने॑ दे॒वेषु॒ प्र वो॑चः॥ २७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024460, "chapter_id": 11858, "verse_number": "6", "content_sanskrit": "आ नो॑ भज पर॒मेष्वा वाजे॑षु मध्य॒मेषु॑। शिक्षा॒ वस्वो॒ अन्त॑मस्य॥ २७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024461, "chapter_id": 11858, "verse_number": "7", "content_sanskrit": "वि॒भ॒क्तासि॑ चित्रभानो॒ सिन्धो॑रू॒र्मा उ॑पा॒क आ। स॒द्यो दा॒शुषे॑ क्षरसि॥ २७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024462, "chapter_id": 11858, "verse_number": "8", "content_sanskrit": "यम॑ग्ने पृ॒त्सु मर्त्य॒मवा॒ वाजे॑षु॒ यं जु॒नाः। स यन्ता॒ शश्व॑ती॒रिष॑ः॥ २७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024463, "chapter_id": 11858, "verse_number": "9", "content_sanskrit": "नकि॑रस्य सहन्त्य पर्ये॒ता कय॑स्य चित्। वाजो॑ अस्ति श्र॒वाय्य॑ः॥ २७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50024464, "chapter_id": 11858, "verse_number": "10", "content_sanskrit": "स वाजं॑ वि॒श्वच॑र्षणि॒रर्व॑द्भिरस्तु॒ तरु॑ता। विप्रे॑भिरस्तु॒ सनि॑ता॥ २७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50024465, "chapter_id": 11858, "verse_number": "11", "content_sanskrit": "जरा॑बोध॒ तद्वि॑विड्ढि वि॒शेवि॑शे य॒ज्ञिया॑य। स्तोमं॑ रु॒द्राय॒ दृशी॑कम्॥ २७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50024466, "chapter_id": 11858, "verse_number": "12", "content_sanskrit": "स नो॑ म॒हाँ अ॑निमा॒नो धू॒मके॑तुः पुरुश्च॒न्द्रः। धि॒ये वाजा॑य हिन्वतु॥ २७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50024467, "chapter_id": 11858, "verse_number": "13", "content_sanskrit": "स रे॒वाँ इ॑व वि॒श्पति॒र्दैव्य॑ः के॒तुः शृ॑णोतु नः। उ॒क्थैर॒ग्निर्बृ॒हद्भा॑नुः॥ २७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50024468, "chapter_id": 11858, "verse_number": "14", "content_sanskrit": "नमो॑ म॒हद्भ्यो॒ नमो॑ अर्भ॒केभ्यो॒ नमो॒ युव॑भ्यो॒ नम॑ आशि॒नेभ्य॑ः। यजा॑म दे॒वान्यदि॑ श॒क्नवा॑म॒ मा ज्याय॑स॒ः शंस॒मा वृ॑क्षि देवाः॥ २७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]