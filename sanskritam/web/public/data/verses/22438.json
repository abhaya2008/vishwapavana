[{"id": 7002438000, "chapter_id": 22438, "verse_number": "१-१००-१", "content_sanskrit": "ब्रह्मोवाच ।\nया तु मार्गशिरे मासि शुक्लपक्षे तु सप्तमी ।\nनन्दा सा कथिता वीर सर्वानन्दकरी शुभा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002438001, "chapter_id": 22438, "verse_number": "१-१००-२", "content_sanskrit": "पञ्चम्यामेकभक्तं तु षष्ठ्यां नक्तं प्रकीर्तितम् ।\nसप्तम्यामुपवासं तु कीर्तयन्ति मनीषिणः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002438002, "chapter_id": 22438, "verse_number": "१-१००-३", "content_sanskrit": "पारणान्यत्र वै त्रीणि शंसन्तीह मनीषिणः ।\nमालतीकुसुमानीह सुगन्धं चन्दनं तथा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002438003, "chapter_id": 22438, "verse_number": "१-१००-४", "content_sanskrit": "कर्पूरागरुसम्मिश्रं धूपं चात्र विनिर्दिशेत् ।\nदध्योदनं सखण्डं च नैवेद्यं भास्करप्रियम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002438004, "chapter_id": 22438, "verse_number": "१-१००-५", "content_sanskrit": "तमेव दद्याद्विप्रेभ्योऽश्नीयाच्च तदनु स्वयम् ।\nधूपार्थं भास्करस्यैष प्रथमे पारणे विधिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002438005, "chapter_id": 22438, "verse_number": "१-१००-६", "content_sanskrit": "पलाशपुष्पाणि विभो धूपो यः शक्य एव च ।\nकर्पूरं चन्दनं कुष्ठमगुरुः सिह्लकं तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002438006, "chapter_id": 22438, "verse_number": "१-१००-७", "content_sanskrit": "सग्रन्थि वृषणं भीम कुंकुमं गृञ्जनं तथा ।\nहरीतकी तथा भीम एष पक्षक उच्यते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002438007, "chapter_id": 22438, "verse_number": "१-१००-८", "content_sanskrit": "धूपः प्रबोध आदिष्टो नैवेद्यं खण्डमण्डकाः ।\nकृष्णागरुः सितं कञ्जं बालकं वृषणं तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002438008, "chapter_id": 22438, "verse_number": "१-१००-९", "content_sanskrit": "चंदनं तगरो मुस्ता प्रबोधशर्करान्विता ।\nभोजयेद्ब्राह्मणांश्चापि खण्डखाद्यैर्गणाधिप ।\nनिम्बपत्रं तु सम्प्राश्य ततो भुञ्जीत वाग्यतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002438009, "chapter_id": 22438, "verse_number": "१-१००-१०", "content_sanskrit": "पारणस्य द्वितीयस्य विधिरेष प्रकीर्तितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002438010, "chapter_id": 22438, "verse_number": "१-१००-११", "content_sanskrit": "नीलोत्पलानि शुभ्राणि धूपं गौग्गुलमाहरेत् ।\nनैवेद्यं पायसं देयं१ प्रीतये भास्करस्य तु ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002438011, "chapter_id": 22438, "verse_number": "१-१००-१२", "content_sanskrit": "विलेपनं चन्दनं तु प्राशने विधिरुच्यते ।\nतृतीयस्यापि ते वीर कथितो विधिरुत्तमः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002438012, "chapter_id": 22438, "verse_number": "१-१००-१३", "content_sanskrit": "शृणु नामानि देवस्य पावनानि नृणां सदा ।\nविष्णुर्भगस्तथा धाता प्रीयतामुद्गिरेच्च वै ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002438013, "chapter_id": 22438, "verse_number": "१-१००-१४", "content_sanskrit": "अनेन विधिना यस्तु कुर्यात्प्रयतमानसः ।\nसकामानिह सम्प्राप्य नन्दते शाश्वती समाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002438014, "chapter_id": 22438, "verse_number": "१-१००-१५", "content_sanskrit": "ततः सूर्यसदो गत्या नन्दते नन्दवर्धन ।\nएषा तु नन्दजननी तवाख्याता भया शिव ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002438015, "chapter_id": 22438, "verse_number": "१-१००-१६", "content_sanskrit": "यामुपोष्य ततो भुक्त्वा नन्दते हंसमाप्य वै ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]