[{"id": 2002570, "chapter_id": 1056, "verse_number": "१-५७-०x", "content_sanskrit": "शौनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2002571, "chapter_id": 1056, "verse_number": "१-५७-१", "content_sanskrit": "ये सर्पाः सर्पसत्रेऽस्मिन्पतिता हव्यवाहने।\nतेषां नामानि सर्वेषां श्रोतुमिच्छामि सूतज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2002572, "chapter_id": 1056, "verse_number": "१-५७-२x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2002573, "chapter_id": 1056, "verse_number": "१-५७-२", "content_sanskrit": "सहस्राणि बहून्यस्मिन्प्रयुतान्यर्बुदानि च।\nन शक्यं परिसंख्यातुं बहुत्वाद्द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2002574, "chapter_id": 1056, "verse_number": "१-५७-३", "content_sanskrit": "यथास्मृति तु नामानि पन्नगानां निबोध मे।\nउच्यमानानि मुख्यानां हुतानां जातवेदसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2002575, "chapter_id": 1056, "verse_number": "१-५७-४", "content_sanskrit": "वासुकेः कुलजातांस्तु प्राधान्येन निबोध मे।\nनीलरक्तान्सितान्घोरान्महाकायान्विषोल्बणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2002576, "chapter_id": 1056, "verse_number": "१-५७-५", "content_sanskrit": "अवशान्मातृवाग्दण्डपीडितान्कृपणान्हूतान्।\nकोटिशो मानसः पूर्णः शलः पालो हलीमकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2002577, "chapter_id": 1056, "verse_number": "१-५७-६", "content_sanskrit": "पिच्छलः कौणपश्चक्रः कालवेगः प्रकालनः।\nहिरण्यबाहुः शरणः कक्षकः कालदन्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2002578, "chapter_id": 1056, "verse_number": "१-५७-७", "content_sanskrit": "एते वासुकिजा नागाः प्रविष्टा हव्यवाहने।\nअन्ये च बहवो विप्र तथा वै कुलसंभवाः।\nप्रदीप्ताग्नौ हुताःसर्वे घोररूपा महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2002579, "chapter_id": 1056, "verse_number": "१-५७-८", "content_sanskrit": "तक्षकस्य कुले जातान्प्रवक्ष्यामि निबोध तान्।\nपुच्छाण्डको मण्डलकः पिण्डसेक्ता रभेणकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2002580, "chapter_id": 1056, "verse_number": "१-५७-९", "content_sanskrit": "उच्छिखः शरभो भङ्गो बिल्वतेजा विरोहणः।\nशिली शलकरो मूकः सुकुमारः प्रवेपनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2002581, "chapter_id": 1056, "verse_number": "१-५७-१०", "content_sanskrit": "मुद्गरः शिशुरोमा च सुरोमा च महाहनुः।\nएते तक्षकजा नागाः प्रविष्टा हव्यवाहनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2002582, "chapter_id": 1056, "verse_number": "१-५७-११", "content_sanskrit": "पारावतः पारियात्रः पाण्डरो हरिणः कृशः।\nविहङ्गः शरभो मोदः प्रमोदः संहतापनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2002583, "chapter_id": 1056, "verse_number": "१-५७-१२", "content_sanskrit": "ऐरावतकुलादेते प्रविष्टा हव्यवाहनम्।\nकौरव्यकुलजान्नागाञ्शृणु मे त्वं द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2002584, "chapter_id": 1056, "verse_number": "१-५७-१३", "content_sanskrit": "एरकः कुण्डलो वेणी वेणीस्कन्धः कुमारकः।\nबाहुकः शृङ्गबेरश्च धूर्तकः प्रातरातकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2002585, "chapter_id": 1056, "verse_number": "१-५७-१४", "content_sanskrit": "कौरव्यकुलजास्त्वेते प्रविष्टा हव्यवाहनम्।\nधृतराष्ट्रकुले जाताञ्शृणु नागान्यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2002586, "chapter_id": 1056, "verse_number": "१-५७-१५", "content_sanskrit": "कीर्त्यमानान्मया ब्रह्मन्वातवेगान्विषोल्बणान्।\nशङ्कुकर्णः पिठरकः कुठारमुखसेचकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2002587, "chapter_id": 1056, "verse_number": "१-५७-१६", "content_sanskrit": "पूर्णाङ्गदः पूर्णमुखः प्रहासः शकुनिर्दरिः।\nअमाहठः कामठकः सुषेणो मानसोऽव्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2002588, "chapter_id": 1056, "verse_number": "१-५७-१७", "content_sanskrit": "अष्टावक्रः कोमलकः श्वसनो मौनवेपगः।\nभैरवो मुण्डवेदाङ्गः पिशङ्गश्चोदपारकः।\nऋषभो वेगवान्नागः पिण्डारकमहाहनू॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2002589, "chapter_id": 1056, "verse_number": "१-५७-१८", "content_sanskrit": "रक्ताङ्गः सर्वसारङ्गः समृद्धपटवासकौ।\nवराहको वीरणकः सुचित्रश्चित्रवेगिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2002590, "chapter_id": 1056, "verse_number": "१-५७-१९", "content_sanskrit": "पराशरस्तरुणको मणिः स्कन्धस्तथाऽऽरुणिः।\nइति नागा मया ब्रह्मन्कीर्तिताः कीर्तिवर्धनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2002591, "chapter_id": 1056, "verse_number": "१-५७-२०", "content_sanskrit": "प्राधान्येन बहुत्वात्तु न सर्वे परिकीर्तिताः।\nएतेषां प्रसवो यश्च प्रसवस्य च सन्ततिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2002592, "chapter_id": 1056, "verse_number": "१-५७-२१", "content_sanskrit": "न शक्यं परिसंख्यातुं ये दीप्तं पावकं गताः।\nद्विशीर्षाः पञ्चशीर्षाश्च सप्तशीर्षास्तथाऽपरे।\nदशशीर्षाः शतशीर्षास्तथान्ये बहुशीर्षकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2002593, "chapter_id": 1056, "verse_number": "१-५७-२२", "content_sanskrit": "कालानलविषा घोरा हुताः शतसहस्रशः।\nमहाकाया महावेगाः शैलशृङ्गसमुच्छ्रयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2002594, "chapter_id": 1056, "verse_number": "१-५७-२३", "content_sanskrit": "योजनायामविस्तारा द्वियोजनसमायताः।\nकामरूपाः कामबला दीप्तानलविषोल्बणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2002595, "chapter_id": 1056, "verse_number": "१-५७-२४", "content_sanskrit": "दग्धास्तत्र महासत्रे ब्रह्मदण्डनिपाडिताः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2002596, "chapter_id": 1056, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि सप्तपञ्चाशत्तमोऽध्यायः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]