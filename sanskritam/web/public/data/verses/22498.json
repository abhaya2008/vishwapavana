[{"id": 7002498000, "chapter_id": 22498, "verse_number": "१-१६०-१", "content_sanskrit": "शतानीक उवाच ।\nअहो देवस्य चरितं भास्करस्य त्वयोदितम् ।\nब्रह्मादयोऽपि यं नित्यं पूजयंति विधानतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002498001, "chapter_id": 22498, "verse_number": "१-१६०-२", "content_sanskrit": "ब्रह्मा विष्णुः सुरा ब्रह्मंस्तमाराध्य दिवाकरम् ।\nददृशुस्तस्य किंभूतं रूपं यत्तन्महाद्भुतम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002498002, "chapter_id": 22498, "verse_number": "१-१६०-३", "content_sanskrit": "सुमंतुरुवाच ।\nआराध्य देवमीशानं भास्करं सूतिवाचकम् ।\nकविष्णू कुरुशार्दूल जग्मतुस्तौ हिमाचलम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002498003, "chapter_id": 22498, "verse_number": "१-१६०-४", "content_sanskrit": "गोपतेरंतिकं वीर प्रहृष्टौ विभुदर्शने ।\nकुंदेंदुसंनिभं द्रष्टुं कंजजश्चाच्युतश्च तौ ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002498004, "chapter_id": 22498, "verse_number": "१-१६०-५", "content_sanskrit": "ददृशतुर्महात्मानं चंद्रार्धकृतशेखरम् ।\nपूजयंतं विवस्वंतं भास्करं वीरवन्नृप ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002498005, "chapter_id": 22498, "verse_number": "१-१६०-६", "content_sanskrit": "आर्च्योचतुर्महात्मानं कविष्णू तं त्रिलोचनम् ।\nभोभो भीम सुरश्रेष्ठ पश्यावामिह चागतौ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002498006, "chapter_id": 22498, "verse_number": "१-१६०-७", "content_sanskrit": "श्रुत्वोवाच तयोर्वाक्यं कंजजस्याच्युतस्य च ।\nप्रणम्य शिरसा भूमौ कृत्वा पूजां विधानतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002498007, "chapter_id": 22498, "verse_number": "१-१६०-८", "content_sanskrit": "उवाच मधुरं वाक्यं शिक्षाक्षरसमन्वितम् ।\nहर्ष गद्गदया वाचा दिशः सन्नादयन्निव ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002498008, "chapter_id": 22498, "verse_number": "१-१६०-९", "content_sanskrit": "किमाराध्य रविं प्राप्तौ सर्वदेववरं विभुम् ।\nकथ्यतां निखिलं देवौ परमं कौतुकं मम ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002498009, "chapter_id": 22498, "verse_number": "१-१६०-१०", "content_sanskrit": "दृष्टवंतौ परं किंचिद्रूपं देवस्य शंकरम् ।\nअव्ययस्याप्रमेयस्य भानोरमिततेजसः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002498010, "chapter_id": 22498, "verse_number": "१-१६०-११", "content_sanskrit": "निशम्य वचनं वीर शंकरस्य महात्मनः ।\nऊचतुस्तौ महात्मानौ कविष्णू देवसत्तमौ ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002498011, "chapter_id": 22498, "verse_number": "१-१६०-१२", "content_sanskrit": "न तत्पश्यावहे रूपं यत्तत्परममद्भुतम् ।\nआराधयितुमेवापि ह्यागतौ तेंतिकं च तम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002498012, "chapter_id": 22498, "verse_number": "१-१६०-१३", "content_sanskrit": "तस्मादाराधयामो हि एकीभूय विभावसुम् ।\nगत्वोदयगिरिं पुण्यं पर्वतं कनकोज्ज्वलम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002498013, "chapter_id": 22498, "verse_number": "१-१६०-१४", "content_sanskrit": "श्रुत्वा तु वचनं वीर कंजजाच्युतयोर्हरः ।\nतथेत्याह महाबाहो हर्षादुत्फुल्ललोचनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002498014, "chapter_id": 22498, "verse_number": "१-१६०-१५", "content_sanskrit": "अथ ते राजशार्दूल विविगोगतयो नृप ।\nजग्मुस्तं पर्वतश्रेष्ठमुदयाचलमाशु वै ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002498015, "chapter_id": 22498, "verse_number": "१-१६०-१६", "content_sanskrit": "तमासाद्य नगं पुण्यं शृंगैस्त्रिभिरलंकृतम् ।\nनाना धातुपिनद्धाङ्गं नानाधातुविभूषितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002498016, "chapter_id": 22498, "verse_number": "१-१६०-१७", "content_sanskrit": "आराधनाय विधिवद्यत्नं चक्रुर्विभावसोः ।\nस्तुवन्तस्ते समर्चंतो ध्यायंतश्च विभावसुम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002498017, "chapter_id": 22498, "verse_number": "१-१६०-१८", "content_sanskrit": "दिव्यवर्षसहस्रांते तपंतः संस्थिता नगे ।\nपद्मासनगतो ब्रह्मा ध्यायमानो दिवाकरम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002498018, "chapter_id": 22498, "verse_number": "१-१६०-१९", "content_sanskrit": "स्थाणुवत्संस्थितो भूमावूर्ध्वबाहुस्त्रिलोचनः ।\nपंचाग्निं भजमानस्तु स्थितो विष्णुरवाक्छिराः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002498019, "chapter_id": 22498, "verse_number": "१-१६०-२०", "content_sanskrit": "एवं वर्षसहस्रांते तपश्चक्रुः सुदारुणम् ।\nआराधयंतो विधिवद्गोपतिं पुत्रमालिनम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002498020, "chapter_id": 22498, "verse_number": "१-१६०-२१", "content_sanskrit": "अथ ब्रह्मेशविष्णूनां कुर्वतां तप उत्तमम् ।\nतुतोष भगवान्भानुरुवाच च महीपते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002498021, "chapter_id": 22498, "verse_number": "१-१६०-२२", "content_sanskrit": "ब्रह्मञ्छंभो हरे ब्रूत मत्तः किमभिवांछथ ।\nतुष्टोहं भवतां दातु मिहायातो वरं स्वयम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002498022, "chapter_id": 22498, "verse_number": "१-१६०-२३", "content_sanskrit": "सुमंतुरुवाच ।\nनिशम्य वचनं भानोः शांतं हृद्यं मनोरमम् ।\nप्रणम्य शिरसा केशा इदं वचमब्रुवन् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002498023, "chapter_id": 22498, "verse_number": "१-१६०-२४", "content_sanskrit": "कृतकृत्या वयं सर्वे प्रसादात्तव गोपते ।\nत्वामाराध्य पुरा देव त्वत्तः प्राप्य वरं शुभम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002498024, "chapter_id": 22498, "verse_number": "१-१६०-२५", "content_sanskrit": "उत्पत्तिस्थितिनाशानां वयं सर्वे दिवाकर ।\nसंभूयेह समर्था वै त्वत्प्रसादान्न संशयः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002498025, "chapter_id": 22498, "verse_number": "१-१६०-२६", "content_sanskrit": "किं त्वेकं देवदेवेश वरमिच्छामहे विभो ।\nयत्ते परमकं रूपं दुर्लभं दुर्दृशं तथा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002498026, "chapter_id": 22498, "verse_number": "१-१६०-२७", "content_sanskrit": "तस्मादस्माज्जगन्नाथ रूपं दर्शय तेऽच्युतम् ।\nसर्वदेवमयं यत्ते यत्त्वयोक्तं पुरानघ ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002498027, "chapter_id": 22498, "verse_number": "१-१६०-२८", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा ब्रह्मविष्ण्वीशभाषितम् ।\nदर्शयामास तद्रूपमद्भुतं लोकपूजितम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002498028, "chapter_id": 22498, "verse_number": "१-१६०-२९", "content_sanskrit": "अनेकवक्त्रशिरसमनेकाद्भुतदर्शनम् ।\nसर्वदेवमयं दिव्यं सर्वलोकमयं तथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002498029, "chapter_id": 22498, "verse_number": "१-१६०-३०", "content_sanskrit": "भूः पादौ द्यौः शिरश्चापि तत्राग्नी लोचने मते ।\nपादांगुल्यः पिशाचाश्च हस्तांगुल्यश्च गुह्यकाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002498030, "chapter_id": 22498, "verse_number": "१-१६०-३१", "content_sanskrit": "विश्वे देवाः स्मृतास्तस्य जंघासंघाः सुरोत्तमाः ।\nयक्षाः कुक्षिषु संलीनाः केशाश्चाप्सरसां गणाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002498031, "chapter_id": 22498, "verse_number": "१-१६०-३२", "content_sanskrit": "दृष्टिधृष्ट्यश्च विपुलाः केशा वीरांशवः स्मृताः ।\nतारका रोमरूपाणि रोमाणि च महर्षयः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002498032, "chapter_id": 22498, "verse_number": "१-१६०-३३", "content_sanskrit": "बाहवो विदिशस्तस्य दिशः श्रोत्रे नराधिप ।\nअश्विनौ श्रवणे चास्य नासा वायुर्महाबलः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002498033, "chapter_id": 22498, "verse_number": "१-१६०-३४", "content_sanskrit": "प्रसादश्च क्षमा चैव मनो धर्मस्तथैव च ।\nसत्यमस्याभवद्वाणी जिह्वा देवी सरस्वती ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002498034, "chapter_id": 22498, "verse_number": "१-१६०-३५", "content_sanskrit": "ग्रीवादितिर्महादेवी तालू रुद्रश्च वीर्यवान् ।\nद्वारं स्वर्गस्य नाभिर्वै मित्रस्त्वष्टा पिचंडकः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002498035, "chapter_id": 22498, "verse_number": "१-१६०-३६", "content_sanskrit": "मुखं वैश्वानरश्चास्य वृषणौ च भगस्तदा ।\nहृदयं भगवान्ब्रह्मा ह्युदरं कश्यपो मुनिः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002498036, "chapter_id": 22498, "verse_number": "१-१६०-३७", "content_sanskrit": "पृष्ठेऽस्य वसवो देवा मरुतः सर्वसंधिषु ।\nसर्वच्छंदांसि दशना ज्योतींषि विमला प्रभा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002498037, "chapter_id": 22498, "verse_number": "१-१६०-३८", "content_sanskrit": "प्राणो रुद्रो महादेवः कुक्षौ चास्य महार्णवाः ।\nउदरे चास्य गंधर्वा भुजगाश्च महाबलाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002498038, "chapter_id": 22498, "verse_number": "१-१६०-३९", "content_sanskrit": "लक्ष्मीर्मेधा धृतिः कांतिः सर्वा विद्याश्च वै कटौ ।\nललाटमस्य परमं वयःस्थानं परात्मनः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002498039, "chapter_id": 22498, "verse_number": "१-१६०-४०", "content_sanskrit": "सर्वज्योतींषि जानीहि तपश्चक्रश्च देव राट् ।\nतदेतदादिदेवस्य तनौ ह्याहुर्महात्मनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002498040, "chapter_id": 22498, "verse_number": "१-१६०-४१", "content_sanskrit": "स्तनौ कुक्षौ च वेदाश्च तेष्टौ चास्य मखाः स्मृताः ।\nयष्टव्यपशुबंधाश्च द्विजानां वेष्टि तानि च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002498041, "chapter_id": 22498, "verse_number": "१-१६०-४२", "content_sanskrit": "सर्वदेवमयं दृष्ट्वा रूपमर्कस्य ते नृप ।\nब्रह्मा हरो हरिर्देवाः परं विस्मयमागताः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002498042, "chapter_id": 22498, "verse_number": "१-१६०-४३", "content_sanskrit": "प्रणम्य शिरसा देवं वेपमाना धरां गताः ।\nभयगद्गदया वाचा इदं वचनमब्रुवन् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002498043, "chapter_id": 22498, "verse_number": "१-१६०-४४", "content_sanskrit": "समीक्ष्य रूपं ते देव भीमं ज्वालासमाकुलम् ।\nअनेकमुखबाहूरुचरणं चकिता वयम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002498044, "chapter_id": 22498, "verse_number": "१-१६०-४५", "content_sanskrit": "दिग्ज्ञानं हृतमस्माकं तत्प्रसीद जगत्पते ।\nउपसंहर विश्वात्मन्द्रष्टुं शक्ता न ते वयम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002498045, "chapter_id": 22498, "verse_number": "१-१६०-४६", "content_sanskrit": "इति तेषां वचः श्रुत्वा देवदेवो दिवाकरः ।\nप्रसन्नो भगवानाह वचस्तान्प्रहसन्निदम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002498046, "chapter_id": 22498, "verse_number": "१-१६०-४७", "content_sanskrit": "आदित्य उवाच ।\nयदेतत्परमं पुण्यमद्भुतं लोकभावनम् ।\nदृष्टं भवद्भिर्देवेंद्रा मम सर्वजगन्मयम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002498047, "chapter_id": 22498, "verse_number": "१-१६०-४८", "content_sanskrit": "एतन्मया प्रसन्नेन युष्माकं श्रेयसेऽनघाः ।\nदर्शितं पूजितेनेह योगिनां यन्महालयम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002498048, "chapter_id": 22498, "verse_number": "१-१६०-४९", "content_sanskrit": "ब्रह्मेशाच्युता उचुः ।\nएवमेतन्न संदेहो यथात्थ त्वं दिवस्पते ।\nयोगिनामपि देवेश दर्शनं ह्यस्य दुर्लभम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002498049, "chapter_id": 22498, "verse_number": "१-१६०-५०", "content_sanskrit": "त्वामाराध्य जगन्नाथं नाप्राप्यमिह विद्यते ।\nतस्मात्पूज्यतमो लोके नान्यो देवेषु विद्यते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002498050, "chapter_id": 22498, "verse_number": "१-१६०-५१", "content_sanskrit": "एवमुक्त्वाऽदितेः पुत्रो जगामादर्शनं रविः ।\nब्रह्मादयोपि ते हर्षं प्रापुर्देवस्य दर्शनात् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002498051, "chapter_id": 22498, "verse_number": "१-१६०-५२", "content_sanskrit": "एवं ब्रह्मादयो देवाः पूजयित्वा दिवाकरम् ।\nगतास्ते परमां सिद्धिं गंधर्वा ऋषयस्तथा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]