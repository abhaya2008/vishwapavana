[{"id": 2079811, "chapter_id": 2700, "verse_number": "१२-२०५-०x", "content_sanskrit": "* युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2079812, "chapter_id": 2700, "verse_number": "१२-२०५-१", "content_sanskrit": "पितामह महाप्राज्ञ दुःखशोकसमाकुले।\nसंसारचक्रे लोकानां निर्वेदो नास्ति किंन्विदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2079813, "chapter_id": 2700, "verse_number": "१२-२०५-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2079814, "chapter_id": 2700, "verse_number": "१२-२०५-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nनिबन्धनस्य संवादं भोगवत्या नृपोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2079815, "chapter_id": 2700, "verse_number": "१२-२०५-३", "content_sanskrit": "मुनिं निबन्धनं शुष्कं धमनीयाकृतिं तथा।\nनिरारम्भं निरालम्बमसज्जन्तं च कर्मणि।\nपुत्रं दृष्ट्वाऽप्युवाचार्तं माता भोगवती तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2079816, "chapter_id": 2700, "verse_number": "१२-२०५-४", "content_sanskrit": "उत्तिष्ठ मूढ किं शेषे निरपेक्षः सुहृज्जनैः।\nनिरालम्बो धनोपाये पैतृकं तव किं धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2079817, "chapter_id": 2700, "verse_number": "१२-२०५-५x", "content_sanskrit": "निबन्धन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2079818, "chapter_id": 2700, "verse_number": "१२-२०५-५", "content_sanskrit": "पैतृकं मे महन्मातः सर्वदुःखालयं त्विह।\nअस्त्येतत्तद्विधाताय यतिष्ये तत्र मा शुचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2079819, "chapter_id": 2700, "verse_number": "१२-२०५-६", "content_sanskrit": "इदं शरीरमत्युग्रं पित्रा दत्तमसंशयम्।\nतमेव पितरं गत्वा धनं तिष्ठति शाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2079820, "chapter_id": 2700, "verse_number": "१२-२०५-७", "content_sanskrit": "कश्चिन्महति संसारे वर्तमान---।\nवनदुगमभिप्राप्तो महत्क्रव्या-----॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2079821, "chapter_id": 2700, "verse_number": "१२-२०५-८", "content_sanskrit": "सिंहव्याघ्रगजाकारैरतिघोरैर्महा-----।\nसमन्तात्सुपरिक्षिप्तं स दृष्ट्वा व्यथते पुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2079822, "chapter_id": 2700, "verse_number": "१२-२०५-९", "content_sanskrit": "स तद्वनं ह्यनुचरन्विप्रधावन्नितस्ततः।\nवीक्षमाणो दिशः सर्वाः शरणार्थं प्रधावति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2079823, "chapter_id": 2700, "verse_number": "१२-२०५-१०", "content_sanskrit": "अथापश्यद्वनं रूढं समन्ताद्वागुरावृतम्।\nवनमध्ये च तत्रासीदुदपानः समावृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2079824, "chapter_id": 2700, "verse_number": "१२-२०५-११", "content_sanskrit": "वल्लिभिस्तृणसंछिन्नैर्गूढाभिरभिसंवृतः।\nस पपात द्विजस्तत्र विजने सलिलाशये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2079825, "chapter_id": 2700, "verse_number": "१२-२०५-१२", "content_sanskrit": "विलग्नश्चाभवत्तस्मिँल्लतासन्तानसङ्कुले।\nबाहुभ्यां संपरिष्वक्तस्तया परमसत्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2079826, "chapter_id": 2700, "verse_number": "१२-२०५-१३", "content_sanskrit": "स तथा लम्बते तत्र ऊर्ध्वपादो ह्यधश्शिराः।\nअधस्तत्रैव जातश्च जम्बूवृक्षः सुदुस्तरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2079827, "chapter_id": 2700, "verse_number": "१२-२०५-१४", "content_sanskrit": "कूपस्य तस्य वेलाया अपश्यत्सुमहाफलम्।\nवृक्षं बहुविधं व्योमं वल्लीपुष्पसमाकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2079828, "chapter_id": 2700, "verse_number": "१२-२०५-१५", "content_sanskrit": "नानारूपा मधुकरास्तस्मिन्वुक्षऽभवन्किल।\nतेषां मधूनां बहुधा धारा प्रववृते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2079829, "chapter_id": 2700, "verse_number": "१२-२०५-१६", "content_sanskrit": "विलम्बमानः स पुमान्धारां पिबति सर्वदा।\nन तस्य तृष्णा विरता पीयमानस्य संकटे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2079830, "chapter_id": 2700, "verse_number": "१२-२०५-१७", "content_sanskrit": "परीप्सति च तां नित्यमतृप्तः स पुनः पुनः।\nएवं स वसते तत्र दुःखिदुःखी पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2079831, "chapter_id": 2700, "verse_number": "१२-२०५-१८", "content_sanskrit": "मया तु तद्धनं देयं तव दास्यामि चेच्छसि।\nतस्य च प्रार्थितः सोथ दत्वा मुक्तिमवाप सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2079832, "chapter_id": 2700, "verse_number": "१२-२०५-१९", "content_sanskrit": "सा च त्यक्त्वाऽर्थसंकल्पं जगाम परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2079833, "chapter_id": 2700, "verse_number": "१२-२०५-२०", "content_sanskrit": "एवं संसारचक्रस्य स्वरूपज्ञा नृपोत्तम।\nपरं वैराग्यमागम्य गच्छन्ति परमं पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2079834, "chapter_id": 2700, "verse_number": "१२-२०५-२१x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2079835, "chapter_id": 2700, "verse_number": "१२-२०५-२१", "content_sanskrit": "एवं संसारचक्रस्य स्वरूपं विदितं न मे।\nपैतृकं तु धनं प्रोक्तं किं तद्विद्वन्महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2079836, "chapter_id": 2700, "verse_number": "१२-२०५-२२", "content_sanskrit": "कान्तारमिति किं प्रोक्तं को हस्ती स तु कूपकः।\nकिंसंज्ञिको महावृक्षो मधु वाऽपि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2079837, "chapter_id": 2700, "verse_number": "१२-२०५-२३", "content_sanskrit": "एवं मे संशयं विद्धि धनशब्दं किमुच्यते।\nकथं लब्धं धनं तेन तथा च किमिदं त्विह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2079838, "chapter_id": 2700, "verse_number": "१२-२०५-२४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2079839, "chapter_id": 2700, "verse_number": "१२-२०५-२४", "content_sanskrit": "उपाख्यानमिदं सर्वं मोक्षविद्भिरुदाहृतम्।\nसुमतिं विन्दते येन बन्धनाशश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2079840, "chapter_id": 2700, "verse_number": "१२-२०५-२५", "content_sanskrit": "एतदुक्तं हि कान्तारं महान्संसार एव सः।\nये ते प्रतिष्ठिता व्याला व्याधयस्ते प्रकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2079841, "chapter_id": 2700, "verse_number": "१२-२०५-२६", "content_sanskrit": "या सा नारी महाघोरा वर्णरूपविनाशिनी।\nतामाहुश्च जरां प्राज्ञाः परिष्वक्तं यया जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2079842, "chapter_id": 2700, "verse_number": "१२-२०५-२७", "content_sanskrit": "यस्तत्र कूपे वसते महाहिः काल एव सः।\nयो वृक्षः स च मृत्युर्हि स्वकृतं तस्य तत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2079843, "chapter_id": 2700, "verse_number": "१२-२०५-२८", "content_sanskrit": "ये तु कृष्णाः सिता राजन्मूषिका रात्र्यहानि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2079844, "chapter_id": 2700, "verse_number": "१२-२०५-२९", "content_sanskrit": "द्विषट्कपदसंयुक्तो यो हस्ती षण्मुखाकृतिः।\nस च संवत्सरः प्रोक्तः पाशमासर्तवो मुखाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2079845, "chapter_id": 2700, "verse_number": "१२-२०५-३०", "content_sanskrit": "एतत्संसारचक्रस्य स्वरूपं व्याहृतं मया।\nएवं लब्धधनं राजंस्तत्स्वरूपं विनाशय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2079846, "chapter_id": 2700, "verse_number": "१२-२०५-३१", "content_sanskrit": "एतज्ज्ञात्वा तु सा राजन्परं वैराग्यमास्थिता।\nयथोक्तविधिना भूयः परं पदमवाप सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2079847, "chapter_id": 2700, "verse_number": "१२-२०५-३२", "content_sanskrit": "धत्ते धारयते चैव एतस्मात्कारणाद्धनम्।\nतद्गच्छ चामृतं शुद्धं हिरण्यममृतं तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2079848, "chapter_id": 2700, "verse_number": "१२-२०५-३३", "content_sanskrit": "तत्स्वरूपो महादेवः कृष्णो देवकिनन्दनः।\nतस्य प्रसादाद्दुःखस्य नाशं प्राप्स्यसि मानद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2079849, "chapter_id": 2700, "verse_number": "१२-२०५-३४", "content_sanskrit": "एकः कर्ता स कृष्णश्च ज्ञानिनां परमा गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2079850, "chapter_id": 2700, "verse_number": "१२-२०५-३५", "content_sanskrit": "इदमाश्रित्य देवेन्द्रो देवा रुद्रास्तथाऽश्विनौ।\nस्वेस्वे पदे विविशिरे भुक्तिमुक्तिविदो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2079851, "chapter_id": 2700, "verse_number": "१२-२०५-३६", "content_sanskrit": "भूतानामन्तरात्माऽसौ स नित्यपदसंवृतः।\nश्रूयतामस्य सद्भावः सम्यग्ज्ञानं यथा तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2079852, "chapter_id": 2700, "verse_number": "१२-२०५-३७", "content_sanskrit": "भवेदेतन्निबोध त्वं नारदाय पुरा हरिः।\nदर्शयित्वाऽऽत्मनो रूपं यदवोचत्स्वयं विभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2079853, "chapter_id": 2700, "verse_number": "१२-२०५-३८", "content_sanskrit": "पुरा देवऋषिः श्रीमान्नारदः परमार्थवान्।\nचचार पृथिवीं कृत्स्नां तीर्थान्यनुचरन्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2079854, "chapter_id": 2700, "verse_number": "१२-२०५-३९", "content_sanskrit": "हिमवत्पादमाश्रित्य विचार्य च पुनःपुनः।\nस ददर्श ह्रदं तत्र पद्मोत्पलसमाकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2079855, "chapter_id": 2700, "verse_number": "१२-२०५-४०", "content_sanskrit": "ददर्श कन्यां तत्तीरे सर्वाभरणभूषिताम्।\nशोभमानां श्रिया राजन्क्रीडन्तीमुत्पलैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2079856, "chapter_id": 2700, "verse_number": "१२-२०५-४१", "content_sanskrit": "सा महात्मानमालोक्य नारदेत्याह भामिनी।\nतस्याः समीपमासाद्य तस्थौ विस्मितमानसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2079857, "chapter_id": 2700, "verse_number": "१२-२०५-४२", "content_sanskrit": "वीक्षमाणं तमाज्ञाय सा कन्या चारुवासिनी।\nविजजृम्भे महाभागा स्मयमाना पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2079858, "chapter_id": 2700, "verse_number": "१२-२०५-४३", "content_sanskrit": "तस्मात्समभवद्वक्रात्पुरुषाकृतिसंयुतः।\nरत्नविन्दुचिताङ्गस्तु सर्वाभरणभूषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2079859, "chapter_id": 2700, "verse_number": "१२-२०५-४४", "content_sanskrit": "आदित्यसदृशाकारः शिरसा धारयन्मणिम्।\nपुनरेव तदाकारसदृशः समजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2079860, "chapter_id": 2700, "verse_number": "१२-२०५-४५", "content_sanskrit": "तृतीयस्तु महाराज विविधाभरणैर्युतः।\nप्रदक्षिणं तु तां कृत्वा विविधध्वनयस्तु ताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2079861, "chapter_id": 2700, "verse_number": "१२-२०५-४६", "content_sanskrit": "ततः सर्वेण विप्रर्षिः कन्यां पप्रच्छ तां शुभाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2079862, "chapter_id": 2700, "verse_number": "१२-२०५-४७", "content_sanskrit": "का त्वं परमकल्याणि पद्मेन्दुसदृशानने।\nन जाने त्वां महादेवि ब्रूहि सत्यमनिन्दिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2079863, "chapter_id": 2700, "verse_number": "१२-२०५-४८x", "content_sanskrit": "कन्योवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2079864, "chapter_id": 2700, "verse_number": "१२-२०५-४८", "content_sanskrit": "सावित्री नाम विप्रर्षे शृणु भद्रं तवास्तु वै।\nकिं करिष्यामि तद्ब्रूहि तव यच्चेतसि स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2079865, "chapter_id": 2700, "verse_number": "१२-२०५-४९x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2079866, "chapter_id": 2700, "verse_number": "१२-२०५-४९", "content_sanskrit": "अभिवादये त्वां सावित्रि कृतार्थोऽहमनिन्दिते।\nएतं मे संशयं देवि वक्तुमर्हसि शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2079867, "chapter_id": 2700, "verse_number": "१२-२०५-५०", "content_sanskrit": "यस्तु वै प्रथमोत्पन्नः कोऽसौ स पुरुषाकृतिः।\nबिन्दवस्तु महादेवि मूर्ध्नि ज्योतिर्मयाकृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2079868, "chapter_id": 2700, "verse_number": "१२-२०५-५१x", "content_sanskrit": "कन्योवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2079869, "chapter_id": 2700, "verse_number": "१२-२०५-५१", "content_sanskrit": "अग्रजः प्रथमोत्पन्नो यजुर्वेदस्तथाऽपरः।\nतृतीयः सामवेदस्तु संशयो व्येतु ते मुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2079870, "chapter_id": 2700, "verse_number": "१२-२०५-५२", "content_sanskrit": "वेदाश्च बिन्दुसंयुक्ता यज्ञस्य फलसंश्रिताः।\nयत्तद्दृष्टं महज्ज्योतिर्ज्योतिरित्युच्यते बुधैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2079871, "chapter_id": 2700, "verse_number": "१२-२०५-५३", "content_sanskrit": "ऋषे ज्ञेयं मया चाऽपीत्युक्त्वा चान्तरधीयत।\nततः स विस्मयाविष्टो नारदः पुरुषर्षभ।\nध्यानयुक्तः स तु चिरं न बुबोध महामतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2079872, "chapter_id": 2700, "verse_number": "१२-२०५-५४", "content_sanskrit": "ततः स्नात्वा महातेजा वाग्यतो नियतेन्द्रियः।\nतुष्टाव पुरुषव्याघ्रो जिज्ञासुश्च तदद्भुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2079873, "chapter_id": 2700, "verse_number": "१२-२०५-५५", "content_sanskrit": "ततो वर्षशते पूर्णे भगवाँलोकभावनः।\nप्रादुश्चकार विश्वात्मा ऋषेः परमसौहृदात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2079874, "chapter_id": 2700, "verse_number": "१२-२०५-५६", "content_sanskrit": "तमागतं जगन्नाथं सर्वकारणकारणम्।\nअखिलामरमौल्यङ्गरुक्मारुणपदद्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2079875, "chapter_id": 2700, "verse_number": "१२-२०५-५७", "content_sanskrit": "वैनतेयपदस्पर्शकिणशोभितजानुकम्।\nपीताम्बरलसत्काञ्चीदामबद्धकटीतटम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2079876, "chapter_id": 2700, "verse_number": "१२-२०५-५८", "content_sanskrit": "श्रीवत्सवक्षसं चारुमणिकौस्तुभकन्धरम्।\nमन्दस्मितमुखाम्भोजं चलदायतलोचनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2079877, "chapter_id": 2700, "verse_number": "१२-२०५-५९", "content_sanskrit": "नम्रचापानुकरणनम्रभ्रूयुगशोभितम्।\nनानारत्नमणीवज्रस्फुरन्मकरकुण्डलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2079878, "chapter_id": 2700, "verse_number": "१२-२०५-६०", "content_sanskrit": "इन्द्रनीलनिभासं तं केयूरमकुटोज्ज्वलम्।\nदेवैरिन्द्रपुरोगैश्च ऋषिसङघैरभिष्टुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2079879, "chapter_id": 2700, "verse_number": "१२-२०५-६१", "content_sanskrit": "नारदो जयशब्देन ववन्दे शिरसा हरिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2079880, "chapter_id": 2700, "verse_number": "१२-२०५-६२", "content_sanskrit": "ततः स भगवाञ्श्रीमान्मेघगम्भीरया गिरा।\nप्राहेशः सर्वभूतानां नारदं पतितं क्षितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2079881, "chapter_id": 2700, "verse_number": "१२-२०५-६३", "content_sanskrit": "भद्रमस्तु ऋषे तुभ्यं वरं वरय सुव्रत।\nयत्ते मनसि सुव्यक्तमस्ति च प्रददामि तन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2079882, "chapter_id": 2700, "verse_number": "१२-२०५-६४", "content_sanskrit": "स चेमं जयशब्देन प्रसीदेत्यातुरो मुनिः।\nप्रोवाच हृदि संरूढं शङ्खचक्रगदाधरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2079883, "chapter_id": 2700, "verse_number": "१२-२०५-६५", "content_sanskrit": "विवक्षितं जगन्नाथ मया ज्ञातं त्वयाऽच्युत।\nतत्प्रसीद हृषीकेश श्रोतुमिच्छामि तद्धरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2079884, "chapter_id": 2700, "verse_number": "१२-२०५-६६", "content_sanskrit": "ततः स्मयन्महाविष्णुरभ्यभाषत नारदम्।\nयद्दृष्टं मम रूपं तु वेदानां शिरसि त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2079885, "chapter_id": 2700, "verse_number": "१२-२०५-६७", "content_sanskrit": "निर्द्वन्द्वा निरहंकाराः शुचयः शुद्धलोचनाः।\nतं मां पश्यन्ति सततं तान्पृच्छ यदिहेच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2079886, "chapter_id": 2700, "verse_number": "१२-२०५-६८", "content_sanskrit": "ये योगिनो महाप्राज्ञा मदंशा ये व्यवस्थिताः।\nतेषां प्रसादं देवर्षे मत्प्रसादमवैहि तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2079887, "chapter_id": 2700, "verse_number": "१२-२०५-६९x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2079888, "chapter_id": 2700, "verse_number": "१२-२०५-६९", "content_sanskrit": "इत्युक्त्वा स जगामाथ भगवान्भूतभावनः।\nतस्माद्व्रज हृषीकेशं कृष्णं देवकिनन्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2079889, "chapter_id": 2700, "verse_number": "१२-२०५-७०", "content_sanskrit": "एतमाराध्य गोविन्दं गता मुक्तिं महर्षयः।\nएष कर्ता विकर्ता च सर्वकारणकारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2079890, "chapter_id": 2700, "verse_number": "१२-२०५-७१", "content_sanskrit": "मयाऽप्येतच्छ्रुतं राजन्नारदात्तु निबोध तत्।\nस्वयमेव समाचष्ट नारदो भगवान्मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2079891, "chapter_id": 2700, "verse_number": "१२-२०५-७२", "content_sanskrit": "समस्तसंसारविघातकारणं\nभजन्ति ये विष्णुमनन्यमानसाः।\nते यान्ति सायुज्यमतीव दुर्लभ\nमितीव नित्यं हृदि वर्णयन्ति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2079892, "chapter_id": 2700, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि पञ्चाधिकद्विशततमोऽध्यायः॥ २०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]