[{"id": 2003197, "chapter_id": 1066, "verse_number": "१-६७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2003198, "chapter_id": 1066, "verse_number": "१-६७-१", "content_sanskrit": "ब्रह्मणो मानसाः पुत्रा विदिताः षण्महर्षयः।\nएकादश सुताः स्थाणोः ख्याताः परमतेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2003199, "chapter_id": 1066, "verse_number": "१-६७-२", "content_sanskrit": "मृगव्याधश्च सर्पश्च निर्ऋतिश्च महायशाः।\nअजैकपादहिर्बिध्न्यः पिनाकी च परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2003200, "chapter_id": 1066, "verse_number": "१-६७-३", "content_sanskrit": "दहनोऽथेश्वरश्चैव कपाली च महाद्युतिः।\nस्थाणुर्भगश्च भगवान् रुद्रा एकादश स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2003201, "chapter_id": 1066, "verse_number": "१-६७-४", "content_sanskrit": "मरीचिरङ्गिरा अत्रिः पुलस्त्यः पुलहः क्रतुः।\nषडेते ब्रह्मणः पुत्रा वीर्यवन्तो महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2003202, "chapter_id": 1066, "verse_number": "१-६७-५", "content_sanskrit": "त्रयस्त्वङ्गिरसः पुत्रा लोके सर्वत्र विश्रुताः।\nबृहस्पतिरुतथ्यश्च संवर्तश्च धृतव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2003203, "chapter_id": 1066, "verse_number": "१-६७-६", "content_sanskrit": "अत्रेस्तु बहवः पुत्राः श्रूयन्ते मनुजाधिप।\nसर्वे वेदविदः सिद्धाः शान्तात्मानो महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2003204, "chapter_id": 1066, "verse_number": "१-६७-७", "content_sanskrit": "राक्षसाश्च पुलस्त्यस्य वानराः किन्नरास्तथा।\nयक्षाश्च मनुजव्याघ्र पुत्रास्तस्य च धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2003205, "chapter_id": 1066, "verse_number": "१-६७-८", "content_sanskrit": "पुलहस्य सुता राजञ्शरभाश्च प्रकीर्तिताः।\nसिंहाः किपुरुषा व्याघ्रा ऋक्षा ईहामृगास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2003206, "chapter_id": 1066, "verse_number": "१-६७-९", "content_sanskrit": "क्रतोः क्रतुसमाः पुत्राः पतङ्गसहचारिणः।\nविश्रुतास्त्रिषु लोकेषु सत्यव्रतपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2003207, "chapter_id": 1066, "verse_number": "१-६७-१०", "content_sanskrit": "दक्षस्त्वजायताङ्गुष्ठाद्दक्षिणाद्भगवानृषिः।\nब्रह्मणः पृथिवीपाल शान्तात्मा सुमहातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2003208, "chapter_id": 1066, "verse_number": "१-६७-११", "content_sanskrit": "वामादजायताङ्गुष्ठाद्भार्या तस्य महात्मनः।\nतस्यां पञ्चाशतं कन्याः स एवाजनयन्मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2003209, "chapter_id": 1066, "verse_number": "१-६७-१२", "content_sanskrit": "ताः सर्वास्त्वनवद्याङ्ग्यः कन्याः कमललोचनाः।\nपुत्रिकाः स्थापयामास नष्टपुत्रः प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2003210, "chapter_id": 1066, "verse_number": "१-६७-१३", "content_sanskrit": "ददौ स दश धर्माय सप्तविंशतिमिन्दवे।\nदिव्येन विधिना राजन्कश्यपाय त्रयोदश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2003211, "chapter_id": 1066, "verse_number": "१-६७-१४", "content_sanskrit": "नामतो धर्मपत्न्यस्ताः कीर्त्यमाना निबोध मे।\nकीर्तिर्लक्ष्मीर्धृतिर्मेधा पुष्टिः श्रद्धा क्रिया तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2003212, "chapter_id": 1066, "verse_number": "१-६७-१५", "content_sanskrit": "बुद्धिर्लज्जा मतिश्चैव पत्न्यो धर्मस्य ता दश।\nद्वाराण्येतानि धर्मस्य विहितानि स्वयंभुवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2003213, "chapter_id": 1066, "verse_number": "१-६७-१६", "content_sanskrit": "सप्तविंशतिः सोमस्य पत्न्यो लोकस्य विश्रुताः।\nकालस्य नयने युक्ताः सोमपत्न्याः शुचिव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2003214, "chapter_id": 1066, "verse_number": "१-६७-१७", "content_sanskrit": "सर्वा नक्षत्रयोगिन्यो लोकयात्राविधानतः।\nपैतामहो मुनिर्देवस्तस्य पुत्रः प्रजापतिः।\nतस्याष्टौ वसवः पुत्रास्तेषां वक्ष्यामि विस्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2003215, "chapter_id": 1066, "verse_number": "१-६७-१८", "content_sanskrit": "धरो ध्रुवश्च सोमश्च अहश्चैवानिलोऽनलः।\nप्रत्यूषश्च प्रभासश्च वसवोऽष्टौ प्रकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2003216, "chapter_id": 1066, "verse_number": "१-६७-१९", "content_sanskrit": "धूम्रायास्तु धरः पुत्रो ब्रह्मविद्यो ध्रुवस्तथा।\nचन्द्रमास्तु मनस्विन्याः श्वासायाः श्वसनस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2003217, "chapter_id": 1066, "verse_number": "१-६७-२०", "content_sanskrit": "रतायाश्चाप्यहः पुत्रः शाण्डिल्याश्च हुताशनः।\nप्रत्यूषश्च प्रभासश्च प्रभातायाः सुतौ स्मृतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2003218, "chapter_id": 1066, "verse_number": "१-६७-२१", "content_sanskrit": "धरस्य पुत्रो द्रविणो हुतहव्यवहस्तथा।\nआपस्य पुत्रो वैतण्ड्यः श्रमः शान्तोमुनिस्तथा।\nध्रुवस्य पुत्रो भगवान्कालो लोकप्रकालनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2003219, "chapter_id": 1066, "verse_number": "१-६७-२२", "content_sanskrit": "सोमस्य तु सुतो वर्चा वर्चस्वी येन जायते।\nमनोहरायाः शिशिरः प्राणोऽथ रमणस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2003220, "chapter_id": 1066, "verse_number": "१-६७-२३", "content_sanskrit": "अह्नः सुतस्तथा ज्योतिः शमः शान्तस्तथा मुनिः।\nअग्नेः पुत्रः कुमारस्तु श्रीमाञ्छरवणालयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2003221, "chapter_id": 1066, "verse_number": "१-६७-२४", "content_sanskrit": "तस्य शाखो विशाखश्च नैगमेयश्च पृष्ठजः।\nकृत्तिकाभ्युपपत्तेश्च कार्तिकेय इति स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2003222, "chapter_id": 1066, "verse_number": "१-६७-२५", "content_sanskrit": "अनिलस्य शिवा भार्या तस्याः पुत्रो मनोजवः।\nअविज्ञातगतिश्चैव द्वौ पुत्रावनिलस्य तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2003223, "chapter_id": 1066, "verse_number": "१-६७-२६", "content_sanskrit": "प्रत्यूषस्य विदुः पुत्रमृषिं नाम्नाऽथ देवलम्।\nद्वौ पुत्रौ देवलस्यापि क्षमावन्तौ मनीषिणौ।\nबृहस्पतेस्तु भगिनी वरस्त्री ब्रह्मवादिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2003224, "chapter_id": 1066, "verse_number": "१-६७-२७", "content_sanskrit": "योगसिद्धा जगत्कृत्स्नमसक्ता विचचार ह।\nप्रभासस्य तु भार्या सा वसूनामष्टमस्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2003225, "chapter_id": 1066, "verse_number": "१-६७-२८", "content_sanskrit": "विश्वकर्मा महाभागो जज्ञे शिल्पप्रजापतिः।\nकर्ता शिल्पसहस्राणां त्रिदशानां च वर्धकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2003226, "chapter_id": 1066, "verse_number": "१-६७-२९", "content_sanskrit": "भूषणानां च सर्वेषां कर्ता शिल्पवतां वरः।\nयो दिव्यानि विमानानि त्रिदशानां चकारह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2003227, "chapter_id": 1066, "verse_number": "१-६७-३०", "content_sanskrit": "मनुष्याश्चोपजीवन्ति यस्य शिल्पं महात्मनः।\nपूजयन्ति च यं नित्यं विश्वकर्माणमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2003228, "chapter_id": 1066, "verse_number": "१-६७-३१", "content_sanskrit": "स्तनं तु दक्षिणं भित्त्वा ब्रह्मणो नरविग्रहः।\nनिःसृतो भगवान्धर्मः सर्वलोकसुखावहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2003229, "chapter_id": 1066, "verse_number": "१-६७-३२", "content_sanskrit": "त्रयस्तस्य वराः पुत्राः सर्वभूतमनोहराः।\nशमः कामश्च हर्षश्च तेजसा लोकधारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2003230, "chapter_id": 1066, "verse_number": "१-६७-३३", "content_sanskrit": "कामस्य तु रतिर्भार्या शमस्य प्राप्तिरङ्गना।\nनन्दा तु भार्या हर्षस्य यासु लोकाः प्रतिष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2003231, "chapter_id": 1066, "verse_number": "१-६७-३४", "content_sanskrit": "मरीचेः कश्यपः पुत्रः कश्यपस्य सुरासुराः।\nजज्ञिरे नृपशार्दूल लोकानां प्रभवस्तु सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2003232, "chapter_id": 1066, "verse_number": "१-६७-३५", "content_sanskrit": "त्वाष्ट्री तु सवितुर्भार्या वडवारूपधारिणी।\nअसूयत महाभागा सान्तरिक्षेऽस्विनावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2003233, "chapter_id": 1066, "verse_number": "१-६७-३६", "content_sanskrit": "द्वादशैवादितेः पुत्राः शक्रमुख्या नराधिप।\nतेषामवरजो विष्णुर्यत्र लोकाः प्रतिष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2003234, "chapter_id": 1066, "verse_number": "१-६७-३७", "content_sanskrit": "त्रयस्त्रिंशत यत्येते देवास्तेषामहं तव।\nअन्वयं संप्रवक्ष्यामि पक्षैश्च कुलतो गणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2003235, "chapter_id": 1066, "verse_number": "१-६७-३८", "content_sanskrit": "रुद्राणामपरः पक्षः साध्यानां मरुतां तथा।\nवसूनां भार्गवं विद्याद्विश्वेदेवांस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2003236, "chapter_id": 1066, "verse_number": "१-६७-३९", "content_sanskrit": "वैनतेयस्तु गरुडो बलवानरुणस्तथा।\nबृहस्पतिश्च भगवानादित्येष्वेव गण्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2003237, "chapter_id": 1066, "verse_number": "१-६७-४०", "content_sanskrit": "अश्विनौ गुह्यकान्विद्धि सर्वौषध्यस्तथा पशून्।\nएते देवगणा राजन्कीर्तितास्तेऽनुपूर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2003238, "chapter_id": 1066, "verse_number": "१-६७-४१", "content_sanskrit": "यान्कीर्तयित्वा मनुजः सर्वपापैः प्रमुच्यते।\nब्रह्मणो हृदयं भित्त्वा निःसृतो भगवान्भृगुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2003239, "chapter_id": 1066, "verse_number": "१-६७-४२", "content_sanskrit": "भृगोः पुत्रः कविर्विद्वाञ्छुक्रः कविसुतो ग्रहः।\nत्रैलोक्यप्राणयात्रार्थं वर्षावर्षे भयाभये।\nस्वयंभुवा नियुक्तः सन्भुवनं परिधावति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2003240, "chapter_id": 1066, "verse_number": "१-६७-४३", "content_sanskrit": "योगाचार्यो महाबुद्धिर्दैत्यानामभवद्गुरुः।\nसुराणां चापि मेधावी ब्रह्मचारी यतव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2003241, "chapter_id": 1066, "verse_number": "१-६७-४४", "content_sanskrit": "तस्मिन्नियुक्ते विधिना योगक्षेमाय भार्गवे।\nअन्यमुत्पादयामास पुत्रं भृगुरनिन्दितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2003242, "chapter_id": 1066, "verse_number": "१-६७-४५", "content_sanskrit": "च्यवनं दीप्ततपसं धर्मात्मानं यशस्विनम्।\nयः स रोषाच्च्युतो गर्भान्मातुर्मोक्षाय भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2003243, "chapter_id": 1066, "verse_number": "१-६७-४६", "content_sanskrit": "आरुषी तु मनोः कन्या तस्य पत्नी मनीषिणः।\nऔर्वस्तस्यां समभवदूरुं भित्त्वा महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2003244, "chapter_id": 1066, "verse_number": "१-६७-४७", "content_sanskrit": "महातेजा महावीर्यो बाल एव गुणैर्युतः।\nऋचीकस्तस्य पुत्रस्तु जमदग्निस्ततोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2003245, "chapter_id": 1066, "verse_number": "१-६७-४८", "content_sanskrit": "जमदग्नेस्तु चत्वार आसन्पुत्रा महात्मनः।\nरामस्तेषां जघन्योऽभूदजघन्यैर्गुणैर्युतः।\nसर्वशस्त्रेषु कुशलः क्षत्रियान्तकरो वशी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2003246, "chapter_id": 1066, "verse_number": "१-६७-४९", "content_sanskrit": "और्वस्यासीत्पुत्रशतं जमदग्निपुरोगमम्।\nतेषां पुत्रसहस्राणि बभूवुर्भुवि विस्तरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2003247, "chapter_id": 1066, "verse_number": "१-६७-५०", "content_sanskrit": "द्वौ पुत्रो ब्रह्मणस्त्वन्यौ ययोस्तिष्ठति लक्षणम्।\nलोके धाता विधाता च यौ स्थितौ मनुना सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2003248, "chapter_id": 1066, "verse_number": "१-६७-५१", "content_sanskrit": "तयोरेव स्वसा देवी लक्ष्मीः पद्मगृहा शुभा।\nतस्यास्तु मानसाः पुत्रास्तुरगा व्योमचारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2003249, "chapter_id": 1066, "verse_number": "१-६७-५२", "content_sanskrit": "वरुणस्य भार्या या ज्येष्ठा शुक्राद्देवी व्यजायत।\nतस्याः पुत्रं बलं विद्धि सुरां च सुरनन्दिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2003250, "chapter_id": 1066, "verse_number": "१-६७-५३", "content_sanskrit": "प्रजानामन्नकामानामन्योन्यपरिभक्षणात्।\nअधर्मस्तत्र संजातः सर्वभूतविनाशकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2003251, "chapter_id": 1066, "verse_number": "१-६७-५४", "content_sanskrit": "तस्यापि निर्ऋतिर्भार्या नैर्ऋता येन राक्षसाः।\nघोरास्तस्यास्त्रयः पुत्राः पापकर्मरताः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2003252, "chapter_id": 1066, "verse_number": "१-६७-५५", "content_sanskrit": "भयो महाभयश्चैव मृत्युर्भूतान्तकस्तथा।\nन तस्य भार्या पुत्रो वा कश्चिदस्त्यन्तको हि सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2003253, "chapter_id": 1066, "verse_number": "१-६७-५६", "content_sanskrit": "काकीं श्येनीं तथा भासीं धृतराष्ट्रीं तथा शुकीम्।\nताम्रा तु सुषुवे देवी पञ्चैता लोकविश्रुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2003254, "chapter_id": 1066, "verse_number": "१-६७-५७", "content_sanskrit": "उलूकान्सुषुवे काकी श्येनी श्येनान्व्यजायत।\nभासी भासानजनयद्गृध्रांश्चैव जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2003255, "chapter_id": 1066, "verse_number": "१-६७-५८", "content_sanskrit": "धृतराष्ट्री तु हंसांश्च कलहंसांश्च सर्वशः।\nचक्रवाकांश्च भद्रा तु जनयामास सैव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2003256, "chapter_id": 1066, "verse_number": "१-६७-५९", "content_sanskrit": "शुकी च जनयामास शुकानेव यशस्विनी।\nकल्याणगुणसंपन्ना सर्वलक्षणपूजिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2003257, "chapter_id": 1066, "verse_number": "१-६७-६०", "content_sanskrit": "नव क्रोधवशा नारीः प्रजज्ञे क्रोधसंभवाः।\nमृगी च मृगमन्दा च हरी भद्रमना अपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2003258, "chapter_id": 1066, "verse_number": "१-६७-६१", "content_sanskrit": "मातङ्गी त्वथ शार्दूली श्वेता सुरभिरेव च।\nसर्वलक्षणसंपन्ना सुरसा चैव भामिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2003259, "chapter_id": 1066, "verse_number": "१-६७-६२", "content_sanskrit": "अपत्यं तु मृगाः सर्वे मृग्या नरवरोत्तम।\nऋक्षाश्च मृगमन्दायाः सृमराश्च परंतप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2003260, "chapter_id": 1066, "verse_number": "१-६७-६३", "content_sanskrit": "ततस्त्वैरावतं नागं जज्ञे भद्रमनाः सुतम्।\nऐरावतः सुतस्तस्या देवनागो महागजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2003261, "chapter_id": 1066, "verse_number": "१-६७-६४", "content_sanskrit": "हर्याश्च हरयोऽपत्यं वानराश्च तरस्विनः।\nगोलाङ्गूलांश्च भद्रं ते हर्याः पुत्रान्प्रचक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2003262, "chapter_id": 1066, "verse_number": "१-६७-६५", "content_sanskrit": "प्रजज्ञे त्वथ शार्दूली सिंहान्व्याग्राननेकशः।\nद्वीपिनश्च महासत्वान्सर्वानेव न सशंयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2003263, "chapter_id": 1066, "verse_number": "१-६७-६६", "content_sanskrit": "मातङ्ग्यपि च मातङ्गानपत्यानि नराधिप।\nदिशां गजं तु श्वेताख्यं श्वेताऽजनयदाशुगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2003264, "chapter_id": 1066, "verse_number": "१-६७-६७", "content_sanskrit": "तथा दुहितरौ राजन्सुरभिर्वै व्यजायत।\nरोहिणी चैव भद्रं ते गन्धर्वी तु यशस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2003265, "chapter_id": 1066, "verse_number": "१-६७-६८", "content_sanskrit": "विमलामपि भद्रं ते अनलामपि भारत।\nरोहिण्यां जज्ञिरे गावो गन्धर्व्यां वाजिनः सुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2003266, "chapter_id": 1066, "verse_number": "१-६७-६९", "content_sanskrit": "इरायाः कन्यका जातास्तिस्रः कमललोचनाः।\nवनस्पतीनां वृक्षाणां वीरुधां चैव मातरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2003267, "chapter_id": 1066, "verse_number": "१-६७-७०", "content_sanskrit": "लतारुहे च द्वे प्रोक्ते वीरुधां चैव ताः स्मृताः।\nगृह्णन्ति ये विना पुष्पं फलानि तरवः पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2003268, "chapter_id": 1066, "verse_number": "१-६७-७१", "content_sanskrit": "लतासुतास्ते विज्ञेयास्तानेवाहुर्वनस्पतीन्।\nपुष्पैः फलग्रहान्वृक्षान्रुहायाः प्रसवं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2003269, "chapter_id": 1066, "verse_number": "१-६७-७२", "content_sanskrit": "लतागुल्मानि वृक्षाश्च त्वक्सारतृणजन्तवः।\nवीरुधो याः प्रजास्तस्यास्तत्र वंशः समाप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2003270, "chapter_id": 1066, "verse_number": "१-६७-७३", "content_sanskrit": "सप्तपिम्डफलान्वृक्षाननलापि व्यजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2003271, "chapter_id": 1066, "verse_number": "१-६७-७४", "content_sanskrit": "अनलायाः शुकी पुत्री कंकस्तु सुरसासुतः।\nअरुणस्य भार्या श्येनी तु वीर्यवन्तौ महाबलौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2003272, "chapter_id": 1066, "verse_number": "१-६७-७५", "content_sanskrit": "संपातिं जनयामास वीर्यवन्तं जटायुषम्।\nसुरसाऽजनयन्नागान्कद्रूः पुत्रांस्तु पन्नगान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2003273, "chapter_id": 1066, "verse_number": "१-६७-७६", "content_sanskrit": "द्वौ पुत्रौ विनतायास्तु विख्यातौ गरुडारुणौ।\nइत्येष सर्वभूतानां महतां मनुजाधिप।\nप्रभवः कीर्तितः सम्यङ्मया मतिमतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2003274, "chapter_id": 1066, "verse_number": "१-६७-७७", "content_sanskrit": "यं श्रुत्वा पुरुषः सम्यङ्मुक्तो भवति पाप्मनः।\nसर्वज्ञतां च लभते रतिमग्र्यां च विन्दति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2003275, "chapter_id": 1066, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि सप्तषष्टितमोऽध्यायः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}]