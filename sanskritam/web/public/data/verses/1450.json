[{"id": 2021769, "chapter_id": 1450, "verse_number": "३-८८-०x", "content_sanskrit": "धौम्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2021770, "chapter_id": 1450, "verse_number": "३-८८-१", "content_sanskrit": "उदीच्यां राजशार्दूल दिशि पुण्यानि यानि वै।\nतानि ते कीर्तयिष्यामि पुण्यान्यायतनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2021771, "chapter_id": 1450, "verse_number": "३-८८-२", "content_sanskrit": "शृणुष्वावहितो भूत्वा मम मन्त्रयतः प्रभो।\nकथाप्रतिग्रहो वीर श्रद्धां जनयते शुभाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2021772, "chapter_id": 1450, "verse_number": "३-८८-३", "content_sanskrit": "सरस्वती महापुण्या ह्रदिनी तीर्थमालिनी।\nसमुद्रगा महावेगा यमुना यत्र पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2021773, "chapter_id": 1450, "verse_number": "३-८८-४", "content_sanskrit": "यत्र पुण्यतरं तीर्थं प्लक्षावतरणं शुभम्।\nयत्रसारस्वतैरिष्ट्वा गच्छन्त्यवभृथं द्विजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2021774, "chapter_id": 1450, "verse_number": "३-८८-५", "content_sanskrit": "पुण्यं चाख्यायते दिव्यं शिवमग्निशिरोऽनघ।\nसहदेवोऽयजद्यत्रशम्याक्षेपेण भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2021775, "chapter_id": 1450, "verse_number": "३-८८-६", "content_sanskrit": "एतस्मिन्नेव चार्थेऽसौ इन्द्रगीता युधिष्ठिर।\nगाथा चरति लोकेऽस्मिन्गीयमाना द्विजातिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2021776, "chapter_id": 1450, "verse_number": "३-८८-७", "content_sanskrit": "अग्नयः सहदेवेन ये चिता यमुनामनु।\nते तस्य कुरुशार्दूल सहस्रशतदक्षिणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2021777, "chapter_id": 1450, "verse_number": "३-८८-८", "content_sanskrit": "तत्रैव भरतो राजा चक्रवर्ती महायशाः।\nविंशतीं सप्त चाष्टौ च हयमेधानुपाहरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2021778, "chapter_id": 1450, "verse_number": "३-८८-९", "content_sanskrit": "कामकृद्यो द्विजातीनां श्रुतस्तात यथा पुरा।\nअत्यन्तमाश्रमः पुण्यः शरभङ्गस्य विश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2021779, "chapter_id": 1450, "verse_number": "३-८८-१०", "content_sanskrit": "सरस्वती नदी सद्भिः सततं पार्थ पूजिता।\nवालखिल्यैर्महाराज यत्रेष्टमृषिभिः पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2021780, "chapter_id": 1450, "verse_number": "३-८८-११", "content_sanskrit": "दृषद्वती महापुण्या यत्र रख्याता युधिष्ठिर।\nन्यग्रोधाख्यस्तु पाञ्चाल्यः पाञ्चाल्योद्विपदांवर।\nदाल्भ्यघोषश्च दाल्भ्याश् धरणीस्थो महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2021781, "chapter_id": 1450, "verse_number": "३-८८-१२", "content_sanskrit": "कौन्तेयानन्तयशसः सुव्रतस्यामितौजसः।\nआश्रमः ख्यायते पुण्यस्त्रिषु लोकेषु विश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2021782, "chapter_id": 1450, "verse_number": "३-८८-१३", "content_sanskrit": "एतावर्णाववर्णौ च विश्रुतौ मनुजाधिप।\nईजाते क्रतुभिर्मुख्यैः पुण्यैर्भरतसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2021783, "chapter_id": 1450, "verse_number": "३-८८-१४", "content_sanskrit": "समेत्य बहुशो देवाः सेन्द्राः सवरुणाः पुरा।\nविशाखयूपेऽतप्यन् तेन पुण्यतमश्च सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2021784, "chapter_id": 1450, "verse_number": "३-८८-१५", "content_sanskrit": "ऋषिर्महान्महाभागो जमदग्निर्महायशाः।\nपलाशकेषु पुण्येषु रम्येष्वयजत प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2021785, "chapter_id": 1450, "verse_number": "३-८८-१६", "content_sanskrit": "यत्रसर्वाः सरिच्छ्रेष्टाः साक्षात्तमृषिसत्तमम्।\nस्वं स्वं तोयमुपादाय परिवार्योपतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2021786, "chapter_id": 1450, "verse_number": "३-८८-१७", "content_sanskrit": "अपि चात्र महाराज स्वयं विश्वावसुर्जगौ।\nइमं श्लोकं तदा वीर प्रेक्ष्य दीक्षां महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2021787, "chapter_id": 1450, "verse_number": "३-८८-१८", "content_sanskrit": "यजमानस्य वै देवाञ्जमदग्नेर्महात्मनः।\nआगम्य सरितो विप्रान्मधुना समतर्पयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2021788, "chapter_id": 1450, "verse_number": "३-८८-१९", "content_sanskrit": "गन्धर्वयक्षरक्षोबिरप्सरोभिश्च सेवितम्।\nकिरातकिन्नरावासं शैलं शिखरिणांवरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2021789, "chapter_id": 1450, "verse_number": "३-८८-२०", "content_sanskrit": "बिभेद तरसा गङ्गा गङ्गाद्वारं युधिष्ठिर।\nपुण्यं तत्ख्यायते राजन्ब्रह्मर्षिगणसेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2021790, "chapter_id": 1450, "verse_number": "३-८८-२१", "content_sanskrit": "सनत्कुमारः कौरव्य पुण्यं कनखलं तथा।\nपर्वतश्च पुरुर्नाम यत्रयातः पुरूरवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2021791, "chapter_id": 1450, "verse_number": "३-८८-२२", "content_sanskrit": "भृगुर्यत्रतपस्तेपे महर्षिगणसेविते।\nराजन्स आश्रमः ख्यातो भृगुतुन्दो महागिरिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2021792, "chapter_id": 1450, "verse_number": "३-८८-२३", "content_sanskrit": "यः स भूतं भविष्यच्च भवच् भरतर्षभ।\nनारायणः प्रभुर्विष्णुः शाश्वतः पुरुषोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2021793, "chapter_id": 1450, "verse_number": "३-८८-२४", "content_sanskrit": "तस्यातियशसः पुण्यां विशालां बदरीमनु।\nआश्रमः ख्यायते पुण्यस्त्रिषु लोकेषु विश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2021794, "chapter_id": 1450, "verse_number": "३-८८-२५", "content_sanskrit": "उष्णतोयवहा गङ्गा शीततोयवहा पुरा।\nसुवर्णसिकता राजन्विशालां बदरीमनु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2021795, "chapter_id": 1450, "verse_number": "३-८८-२६", "content_sanskrit": "ऋषयो यत्रदेवाश्च महाभागा महौजसः।\nप्राप्य नित्यं नमस्यन्ति देवं नारायणं प्रभुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2021796, "chapter_id": 1450, "verse_number": "३-८८-२७", "content_sanskrit": "यत्रनाराजणो देवः परमात्मा सनातनः।\nतत्र कृत्स्नं जगत्सर्वं तीर्थान्यायतनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2021797, "chapter_id": 1450, "verse_number": "३-८८-२८", "content_sanskrit": "तत्पुण्यं परमं ब्रह्म तत्तीर्थं त्तपोवनम्।\nतत्परं परमं देवं भूतानां परमेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2021798, "chapter_id": 1450, "verse_number": "३-८८-२९", "content_sanskrit": "शाश्वतं परमं चैव धातारं परमं पदम्।\nयं विदित्वान शोचन्ति विद्वांसः शास्त्रदृष्टयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2021799, "chapter_id": 1450, "verse_number": "३-८८-३०", "content_sanskrit": "तत्र देवर्षयः सिद्धाः सर्वे चैव तपोधनाः।\nआदिदेवो महायोगी यत्रास्ते मधुसूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2021800, "chapter_id": 1450, "verse_number": "३-८८-३१", "content_sanskrit": "पुण्यानामपि तत्पुण्यमत्र ते संशयेस्तु मा।\nएतानि राजन्पुण्यानि पृथिव्यां पृथिवीपते।\nकीर्तितानि नरश्रेष्ठ तीर्थान्यायतनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2021801, "chapter_id": 1450, "verse_number": "३-८८-३२", "content_sanskrit": "एतानि वसुभिः साध्यैरादित्यैर्मरुदश्विभिः।\nऋषिभिर्देवकल्पैश्च सेवितानि महात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2021802, "chapter_id": 1450, "verse_number": "", "content_sanskrit": "चरन्नेतानि कौन्तेय सहितो ब्राह्मणर्षभैः।\nभ्रातृभिश्च महाभागैरुत्कण्ठां विजयिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]