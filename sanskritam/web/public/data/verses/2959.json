[{"id": 2092099, "chapter_id": 2959, "verse_number": "१३-८९-१", "content_sanskrit": "भीष्म उवाच।\nततः स राजा रात्र्यन्ते प्रतिबुद्धो महामनाः।\nकृतपूर्वाह्णिकः प्रायात्सभार्यस्तद्वनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2092100, "chapter_id": 2959, "verse_number": "१३-८९-२", "content_sanskrit": "ततो ददर्श नृपतिः प्रासादं सर्वकाञ्चनम्।\nमणिस्तम्भसहस्राढ्यं गन्धर्वनगरोपमम्।\nतत्र दिव्यानभिप्रायान्ददर्श कुशिकस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2092101, "chapter_id": 2959, "verse_number": "१३-८९-३", "content_sanskrit": "पर्वतान्रूप्यसानूंश्च नलिनीश्च सपङ्कजाः।\nचित्रशालाश्च विविधास्तोरणानि च भारत।\nशाद्वलोपचितां भूमिं तथा काञ्चनकुट्टिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2092102, "chapter_id": 2959, "verse_number": "१३-८९-४", "content_sanskrit": "सहकारान्प्रफुल्लांश्च केतकोद्दालकान्वरान्।\nअशोकान्सहकुन्दांश्च फुल्लांश्चैवातिमुक्तकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2092103, "chapter_id": 2959, "verse_number": "१३-८९-५", "content_sanskrit": "चम्पकांस्तिलकान्भव्यान्पनसान्वञ्जुलानपि।\nपुष्पितान्कर्णिकारांश्च तत्रतत्र ददर्श ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2092104, "chapter_id": 2959, "verse_number": "१३-८९-६", "content_sanskrit": "श्यामान्वारणपुष्पांश्च तथाऽष्टपदिका लताः।\nतत्रतत्र परिक्लृप्ता ददर्श स महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2092105, "chapter_id": 2959, "verse_number": "१३-८९-७", "content_sanskrit": "रम्यान्पद्मोत्पलधरान्सर्वर्तुकुसुमांस्तथा।\nविमानप्रतिमांश्चापि प्रासादाञ्शैलसन्निभान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2092106, "chapter_id": 2959, "verse_number": "१३-८९-८", "content_sanskrit": "शीतलानि च तोयानि क्वचिदुष्णानि भारत।\nआसनानि विचित्राणि शयनप्रवराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2092107, "chapter_id": 2959, "verse_number": "१३-८९-९", "content_sanskrit": "पर्यङ्कान्रत्नसौवर्णान्परार्ध्यास्तरणास्तृतान्।\nभक्ष्यं भोज्यमनन्तं च तत्रतत्रोपकल्पितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2092108, "chapter_id": 2959, "verse_number": "१३-८९-१०", "content_sanskrit": "वाणीवादाञ्छुकांश्चैव शारिका भृङ्गराजकान्।\nकोकिलाञ्छतपत्रांश्च सकोयष्टिककुक्कुभान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2092109, "chapter_id": 2959, "verse_number": "१३-८९-११", "content_sanskrit": "मयूरान्कुक्कुटांश्चापि दात्यूहाञ्जीवजीवकान्।\nचकोरान्वानरान्हंसान्सारसांश्चक्रसाह्वयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2092110, "chapter_id": 2959, "verse_number": "१३-८९-१२", "content_sanskrit": "समन्ततः प्रणदतो ददर्श सुमनोहरान्।\nक्वचिदप्सरसां सङ्घान्गन्धर्वाणां च पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2092111, "chapter_id": 2959, "verse_number": "१३-८९-१३", "content_sanskrit": "कान्ताभिरपरांस्तत्र परिष्वक्रान्ददर्श ह।\nन ददर्श च तान्भूयो ददर्श च पुनर्नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2092112, "chapter_id": 2959, "verse_number": "१३-८९-१४", "content_sanskrit": "गीतध्वनिं सुमधुरं तथैवाध्ययनध्वनिम्।\nहंसानसुमधुरांश्चापि तत्र शुश्राव पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2092113, "chapter_id": 2959, "verse_number": "१३-८९-१५", "content_sanskrit": "तं दृष्ट्वाऽत्यद्भुतं राजा मनसाऽचिन्तयत्तदा।\nस्वप्नोऽयं चित्तविभ्रंश उताहो सत्यमेव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2092114, "chapter_id": 2959, "verse_number": "१३-८९-१६", "content_sanskrit": "अहो सह शरीरेण प्राप्तोस्मि परमां गतिम्।\nउत्तरान्वा कुरून्पुण्यानथवाऽप्यमरावतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2092115, "chapter_id": 2959, "verse_number": "१३-८९-१७", "content_sanskrit": "किञ्चेदं महदाश्चर्यं सम्पश्यामीत्यचिन्तयत्।\nएवं सञ्चिन्तयन्नेव ददर्श मुनिपुङ्गवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2092116, "chapter_id": 2959, "verse_number": "१३-८९-१८", "content_sanskrit": "तस्मिन्विमाने सौवर्णे मणिस्तम्भसमाकुले।\nमहार्हे शयने दिव्ये शयानं भृगुनन्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2092117, "chapter_id": 2959, "verse_number": "१३-८९-१९", "content_sanskrit": "तमभ्ययात्प्रहर्षेण नरेन्द्रः सह भार्यया।\nअन्तर्हितस्ततो भूयश्च्यवनः शयनं व तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2092118, "chapter_id": 2959, "verse_number": "१३-८९-२०", "content_sanskrit": "ततोऽन्यस्मिन्वनोद्देशे पुनरेव ददर्श तम्।\nकौश्यां बृस्यां समासीनं जपमानं महाव्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2092119, "chapter_id": 2959, "verse_number": "१३-८९-२१", "content_sanskrit": "एवं योगबलाद्विप्रो मोहयामास पार्थिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2092120, "chapter_id": 2959, "verse_number": "१३-८९-२२", "content_sanskrit": "क्षणेन तद्वनं चैव ते चैवाप्सरसां गणाः।\nगन्धर्वाः पादपाश्चैव सर्वमन्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2092121, "chapter_id": 2959, "verse_number": "१३-८९-२३", "content_sanskrit": "निःशब्दमभवच्चापि गङ्गाकूलं पुनर्नृप।\nकुशवल्मीकभूयिष्ठं बभूव च यथा पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2092122, "chapter_id": 2959, "verse_number": "१३-८९-२४", "content_sanskrit": "ततः स राजा कुशिकः सभार्यस्तेन कर्मणा।\nविस्मयं परमं प्राप्तस्तद्दृष्ट्वा महदद्भुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2092123, "chapter_id": 2959, "verse_number": "१३-८९-२५", "content_sanskrit": "ततः प्रोवाच कुशिको भार्या हर्षसमन्वितः।\nपश्य भद्रे यथाभावाश्चित्रा दृष्टाः सुदुर्लभाः।\nप्रसादाद्भृगुमुख्यस्य किमन्यत्र तपोबलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2092124, "chapter_id": 2959, "verse_number": "१३-८९-२६", "content_sanskrit": "तपसा तदवाप्यं हि यन्न शक्यं मनोरथैः।\nत्रैलोक्यराज्यादपि हि तप एव विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2092125, "chapter_id": 2959, "verse_number": "१३-८९-२७", "content_sanskrit": "तपसा हि सुतप्तेनि क्रीडत्येष तपोधनः।\nअहो प्रभावो ब्रह्मर्षेश्च्यवनस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2092126, "chapter_id": 2959, "verse_number": "१३-८९-२८", "content_sanskrit": "इच्छयैष तपोवीर्यादन्याँल्लोकान्सृजेदपि।\nब्राह्मणा एव जायेरन्पुण्यवाग्बुद्धिकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2092127, "chapter_id": 2959, "verse_number": "१३-८९-२९", "content_sanskrit": "उत्सहेदिह कृत्वैव कोऽन्यो वै च्यवनादृते।\nब्राह्मण्यं दुर्लभं लोके राज्यं हि सुलभं नरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2092128, "chapter_id": 2959, "verse_number": "१३-८९-३०", "content_sanskrit": "ब्राह्मण्यस्य प्रभावाद्धि रथे युक्तौ स्वधुर्यवत्।\nइत्येवं चिन्तयानः स विदितश्च्यवनस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2092129, "chapter_id": 2959, "verse_number": "१३-८९-३१", "content_sanskrit": "सम्प्रेक्ष्योवाच नृपतिं क्षिप्रमागम्यतामिति।\nइत्युक्तः सहभार्यस्तु सोभ्यगच्छन्महामुनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2092130, "chapter_id": 2959, "verse_number": "१३-८९-३२", "content_sanskrit": "शिरसा वन्दनीयं तमवन्दत च पार्थिवः।\nतस्याशिषः प्रयुज्याथ स मुनिस्तं नराधिपम्।\nनिषीदेत्यब्रवीद्धीमान्सान्त्वयन्पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2092131, "chapter_id": 2959, "verse_number": "१३-८९-३३", "content_sanskrit": "ततः प्रकृतिमापन्नो भार्गवो नृपते नृपम्।\nउवाच श्लक्ष्णया वाचा तर्पयन्निव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2092132, "chapter_id": 2959, "verse_number": "१३-८९-३४", "content_sanskrit": "राजन्सम्यग्जितानीह पञ्चपञ्च स्वयं त्वया।\nमनःषष्ठानीन्द्रियाणि कृच्छ्रान्मुक्तोसि तेन वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2092133, "chapter_id": 2959, "verse_number": "१३-८९-३५", "content_sanskrit": "सम्यगाराधितः पुत्र त्वयाऽहं वदतांवर।\nन हि ते वृजितं किञ्चित्सुसूक्ष्ममपि दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2092134, "chapter_id": 2959, "verse_number": "१३-८९-३६", "content_sanskrit": "अनुजानीहि मां राजन्गमिष्यामि यथागतम्।\nप्रीतोस्मि तव राजेन्द्र वरश्च प्रतिगृह्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2092135, "chapter_id": 2959, "verse_number": "१३-८९-३७x", "content_sanskrit": "कुशिक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2092136, "chapter_id": 2959, "verse_number": "१३-८९-३७", "content_sanskrit": "अग्निमध्ये गतेनेव भगवन्सन्निधौ मया।\nवर्तितं भृगुशार्दूल यन्न दग्धोस्मि तद्बहु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2092137, "chapter_id": 2959, "verse_number": "१३-८९-३८", "content_sanskrit": "एष एव वरो मुख्यः प्राप्तो मे भृगुनन्दन।\nयत्प्रीतोसि ममाचारैः कुलं त्रातं च मेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2092138, "chapter_id": 2959, "verse_number": "१३-८९-३९", "content_sanskrit": "एथ मेऽन्द्रग्रहो विप्र जीविते च प्रयोजनम्।\nएतद्राज्यफलं चैव तपसश्च फलं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2092139, "chapter_id": 2959, "verse_number": "१३-८९-४०", "content_sanskrit": "यदि त्वं प्रीतिमान्विप्र मयि वै भृगुनन्दन।\nअस्ति मे संशयः कश्चित्तन्मे व्याख्यातुमर्हसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2092140, "chapter_id": 2959, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकोननवतितमोऽध्यायः॥ ८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]