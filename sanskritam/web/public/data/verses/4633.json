[{"id": 2169973, "chapter_id": 4633, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2169974, "chapter_id": 4633, "verse_number": "१", "content_sanskrit": "भीमसेनं सपाञ्चाल्यं चेदिकेकयसंवृतम् ।\nवैकर्तनः स्वयं रुद्ध्वा वारयामास सायकैः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2169975, "chapter_id": 4633, "verse_number": "२", "content_sanskrit": "ततस्तु चेदिकारूषान् सृञ्जयांश्च महारथान् ।\nकर्णो जघान सङ्क्रुद्धो भीमसेनस्य पश्यतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2169976, "chapter_id": 4633, "verse_number": "३", "content_sanskrit": "भीमसेनस्ततः कर्णं विहाय रथसत्तमम् ।\nप्रययौ कौरवं सैन्यं कक्षमग्निरिव ज्वलन्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2169977, "chapter_id": 4633, "verse_number": "४", "content_sanskrit": "सूतपुत्रोऽपि समरे पाञ्चालान् केकयांस्तथा ।\nसृञ्जयांश्च महेष्वासान् निजघान सहस्रशः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2169978, "chapter_id": 4633, "verse_number": "५", "content_sanskrit": "संशप्तकेषु पार्थश्च कौरवेषु वृकोदरः ।\nपाञ्चालेषु तथा कर्णः क्षयं चक्रुर्महारथाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2169979, "chapter_id": 4633, "verse_number": "६", "content_sanskrit": "ते क्षत्रिया दह्यमानास्त्रिभिस्तैः पावकोपमैः ।\nजग्मुर्विनाशं समरे राजन् दुर्मन्त्रिते तव\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2169980, "chapter_id": 4633, "verse_number": "७", "content_sanskrit": "ततो दुर्योधनः क्रुद्धो नकुलं नवभिः शरैः ।\nविव्याध भरतश्रेष्ठ चतुरश्चास्य वाजिनः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2169981, "chapter_id": 4633, "verse_number": "८", "content_sanskrit": "ततः पुनरमेयात्मा तव पुत्रो जनाधिपः ।\nक्षुरेण सहदेवस्य ध्वजं चिच्छेद काञ्चनम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2169982, "chapter_id": 4633, "verse_number": "९", "content_sanskrit": "नकुलस्तु ततः क्रुद्धस्तव पुत्रं त्रिसप्तभिः ।\nजघान समरे राजन् सहदेवश्च पञ्चभिः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2169983, "chapter_id": 4633, "verse_number": "१०", "content_sanskrit": "तावुभौ भरतश्रेष्ठः श्रेष्ठौ सर्वधनुष्मताम् ।\nविव्याधोरसि सङ्क्रुद्धः पञ्चभिः पञ्चभिः शरैः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2169984, "chapter_id": 4633, "verse_number": "११", "content_sanskrit": "ततोऽपराभ्यां भल्लाभ्यां धनुषी समकृन्तत ।\nयमयोः प्रहसन् राजन् विव्याधैव त्रिभिस्त्रिभिः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2169985, "chapter_id": 4633, "verse_number": "१२", "content_sanskrit": "तावन्ये धनुषी श्रेष्ठे शक्रचापनिभे शुभे ।\nप्रगृह्य रेजतुः शूरौ देवपुत्रसमौ युधि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2169986, "chapter_id": 4633, "verse_number": "१३", "content_sanskrit": "ततस्तौ रभसौ युद्धे भ्रातरौ भ्रातरं नृप ।\nशरैर्ववर्षतुर्घोरैर्महामेघौ यथाचलम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2169987, "chapter_id": 4633, "verse_number": "१४", "content_sanskrit": "ततः क्रुद्धो महाराज तव पुत्रो महारथः ।\nपाण्डुपुत्रौ महेष्वासौ वारयामास पत्रिभिः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2169988, "chapter_id": 4633, "verse_number": "१५", "content_sanskrit": "धनुर्मण्डलमेवास्य दृश्यते युधि भारत ।\nसायकाश्चैव दृश्यन्ते निश्चरन्तः समन्ततः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2169989, "chapter_id": 4633, "verse_number": "१६", "content_sanskrit": "तस्य सायकसञ्छन्नौ चकाशेतां च पाण्डवौ ।\nमेघच्छन्नौ यथा व्योम्नि चन्द्रसूर्यौ हतप्रभौ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2169990, "chapter_id": 4633, "verse_number": "१७", "content_sanskrit": "ते तु बाणा महाराज हेमपुङ्खाः शिलाशिताः ।\nआच्छादयन् दिशः सर्वाः सूर्यस्येवांशवस्तदा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2169991, "chapter_id": 4633, "verse_number": "१८", "content_sanskrit": "बाणभूते ततस्तस्मिन् सञ्छन्ने च नभस्तले ।\nयमाभ्यां ददृशे रूपं कालान्तकयमोपमम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2169992, "chapter_id": 4633, "verse_number": "१९", "content_sanskrit": "पराक्रमं तु तं दृष्ट्वा तव सूनोर्महारथाः ।\nमृत्योरिवान्तिकं प्राप्तौ माद्रीपुत्रौ स्म मेनिरे\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2169993, "chapter_id": 4633, "verse_number": "२०", "content_sanskrit": "ततः सेनापती राजन् पाण्डवस्य महात्मनः ।\nपार्षतः प्रययौ तत्र यत्र राजा सुयोधनः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2169994, "chapter_id": 4633, "verse_number": "२१", "content_sanskrit": "माद्रीपुत्रौ ततः शूरौ व्यतिक्रम्य महारथौ ।\nधृष्टद्युम्नस्तव सुतं ताडयामास सायकैः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2169995, "chapter_id": 4633, "verse_number": "२२", "content_sanskrit": "तमविध्यदमेयात्मा तव पुत्रोऽत्यमर्षणः ।\nपाञ्चाल्यं पञ्चविंशत्या प्रहस्य पुरुषर्षभ\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2169996, "chapter_id": 4633, "verse_number": "२३", "content_sanskrit": "ततः पुनरमेयात्मा तव पुत्रो ह्यमर्षणः ।\nविद्ध्वा ननाद पाञ्चाल्यं षष्ट्या पञ्चभिरेव च\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2169997, "chapter_id": 4633, "verse_number": "२४", "content_sanskrit": "अथास्य सशरं चापं हस्तावापं च मारिष ।\nक्षुरप्रेण सुतीक्ष्णेन राजा चिच्छेद संयुगे\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2169998, "chapter_id": 4633, "verse_number": "२५", "content_sanskrit": "तदपास्य धनुश्छिन्नं पाञ्चाल्यः शत्रुकर्शनः ।\nअन्यदादत्त वेगेन धनुर्भारसहं नवम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2169999, "chapter_id": 4633, "verse_number": "२६", "content_sanskrit": "प्रज्वलन्निव वेगेन संरम्भाद्रुधिरेक्षणः ।\nअशोभत महेष्वासो धृष्टद्युम्नः कृतव्रणः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2170000, "chapter_id": 4633, "verse_number": "२७", "content_sanskrit": "स पञ्चदश नाराचान् श्वसतः पन्नगानिव ।\nजिघांसुर्भरतश्रेष्ठं धृष्टद्युम्नो व्यवासृजत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2170001, "chapter_id": 4633, "verse_number": "२८", "content_sanskrit": "ते वर्म हेमविकृतं भित्त्वा राज्ञः शिलाशिताः ।\nविविशुर्वसुधां वेगात् कङ्कबर्हिणवाससः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2170002, "chapter_id": 4633, "verse_number": "२९", "content_sanskrit": "सोऽतिविद्धो महाराज पुत्रस्तेऽतिव्यराजत ।\nवसन्ते पुष्पबहुलः प्रफुल्ल इव किंशुकः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2170003, "chapter_id": 4633, "verse_number": "३०", "content_sanskrit": "स च्छिन्नवर्मा नाराचप्रहारैः जर्जरीकृतः ।\nधृष्टद्युम्नस्य भल्लेन क्रुद्धश्चिच्छेद कार्मुकम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2170004, "chapter_id": 4633, "verse_number": "३१", "content_sanskrit": "अथैनं छिन्नधन्वानं त्वरमाणो महीपतिः ।\nसायकैर्दशभी राजन् भ्रुवोर्मध्ये समार्दयत्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2170005, "chapter_id": 4633, "verse_number": "३२", "content_sanskrit": "तस्य तेऽशोभयन् वक्त्रं कर्मारपरिमार्जिताः ।\nप्रफुल्लं चम्पकं यद्वद् भ्रमरा मधुलिप्सवः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2170006, "chapter_id": 4633, "verse_number": "३३", "content_sanskrit": "तदपास्य धनुश्छिन्नं धृष्टद्युम्नो महामनाः ।\nअन्यदादत्त वेगेन धनुर्भल्लांश्च षोडश\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2170007, "chapter_id": 4633, "verse_number": "३४", "content_sanskrit": "ततो दुर्योधनस्याश्वान् हत्वा सूतं च पञ्चभिः ।\nधनुश्चिच्छेद भल्लेन जातरूपपरिष्कृतम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2170008, "chapter_id": 4633, "verse_number": "३५", "content_sanskrit": "रथं सोपस्करं छत्रं शक्तिं खड्गं गदां ध्वजम् ।\nभल्लैश्छिच्छेद दशभिः पुत्रस्य तव पार्षतः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2170009, "chapter_id": 4633, "verse_number": "३६", "content_sanskrit": "तपनीयाङ्गदं चित्रं नागं मणिमयं भुवम् ।\nध्वजं कुरुपतेश्छिन्नं ददृशुः सर्वपार्थिवाः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2170010, "chapter_id": 4633, "verse_number": "३७", "content_sanskrit": "दुर्योधनं तु विरथं छिन्नसर्वायुधं रणे ।\nभ्रातरं पर्यरक्षन्त सोदरा भरतर्षभ\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2170011, "chapter_id": 4633, "verse_number": "३८", "content_sanskrit": "तमारोप्य रथे राजन् दण्डधारो जनाधिपम् ।\nअपोवाह च सम्भ्रान्तो धृष्टद्युम्नस्य पश्यतः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2170012, "chapter_id": 4633, "verse_number": "३९", "content_sanskrit": "कर्णस्तु सात्यकिं जित्वा राजगृद्धी महाबलः ।\nद्रोणहन्तारमुग्रेषुं ससाराभिमुखे रणे\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2170013, "chapter_id": 4633, "verse_number": "४०", "content_sanskrit": "तं पृष्ठतोऽभ्ययात् तूर्णं शैनेयो वितुदन् शरैः ।\nवारणं जघनोपान्ते विषाणाभ्यामिव द्विपः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2170014, "chapter_id": 4633, "verse_number": "४१", "content_sanskrit": "स भारत महानासीद् योधानां सुमहात्मनाम् ।\nकर्णपार्षतयोर्युद्धे स क्रुद्धानां महारणः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2170015, "chapter_id": 4633, "verse_number": "४२", "content_sanskrit": "न पाण्डवानां नास्माकं योधः कश्चित् पराङ्मुखः ।\nप्रत्यदृश्यत यत्कर्णः पाञ्चालांस्त्वरितो ययौ\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2170016, "chapter_id": 4633, "verse_number": "४३", "content_sanskrit": "तस्मिन् रणे नरश्रेष्ठ गजवाजिनरक्षयः ।\nप्रादुरासीदुभयतो राजन् मध्यंगतेऽहनि\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2170017, "chapter_id": 4633, "verse_number": "४४", "content_sanskrit": "पाञ्चालास्तु महाराज त्वरिता विजिगीषवः ।\nसर्वतोऽभ्यद्रवन् कर्णं पतत्रिण इव द्रुमम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2170018, "chapter_id": 4633, "verse_number": "४५", "content_sanskrit": "तांस्तथाधिरथिः क्रुद्धो यतमानान् मनस्विनः ।\nविचिन्वन्निव बाणाग्रैः समासादयदग्रतः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2170019, "chapter_id": 4633, "verse_number": "४६", "content_sanskrit": "व्याघ्रकेतुं सुशर्माणं शङ्कुं चोग्रायुधं जयम् ।\nशुक्लं च रोचमानं च सिंहसेनं च दुर्जयम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2170020, "chapter_id": 4633, "verse_number": "४७", "content_sanskrit": "ते वीरा रथमार्गेण परिवव्रुर्नरोत्तमम् ।\nसृजन्तं सायकान् क्रुद्धं कर्णमाहवशोभिनम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2170021, "chapter_id": 4633, "verse_number": "४८", "content_sanskrit": "युध्यमानांस्तु तान् शूरान् मनुजेन्द्र प्रतापवान् ।\nअष्टाभिरष्टौ राधेयो न्यहनन्निशितैः शरैः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2170022, "chapter_id": 4633, "verse_number": "४९", "content_sanskrit": "अथापरान् महाराज सूतपुत्रः प्रतापवान् ।\nजघान बहुसाहस्रान् योधान् युद्धविशारदः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2170023, "chapter_id": 4633, "verse_number": "५०", "content_sanskrit": "विष्णुं च विष्णुकर्माणं देवापिं (म)भद्रमेव च ।\nदण्डं च समरे राजंश्चित्रं चित्रायुधं हरिम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2170024, "chapter_id": 4633, "verse_number": "५१", "content_sanskrit": "(सिंहकेतुं रोचमानं शलभं च महारथम् ।)\nनिजघान सुसङ्क्रुद्धश्चेदीनां च महारथान्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2170025, "chapter_id": 4633, "verse_number": "५२", "content_sanskrit": "तेषामाददतः प्राणानासीदाधिरथेर्वपुः ।\nशोणिताभ्युक्षिताङ्गस्य रुद्रस्येवोर्जितं महत्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2170026, "chapter_id": 4633, "verse_number": "५३", "content_sanskrit": "तत्र भारत कर्णेन मातङ्गास्ताडिताः शरैः ।\nसर्वतोऽभ्यद्रवन् भीताः कुर्वन्तो महदाकुलम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2170027, "chapter_id": 4633, "verse_number": "५४", "content_sanskrit": "निपेतुरुर्व्यां समरे कर्णसायकपीडिताः ।\nकुर्वन्तो विविधान्नादान् वज्रनुन्ना इवाचलाः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2170028, "chapter_id": 4633, "verse_number": "५५", "content_sanskrit": "गजवाजिमनुष्यैश्च निपतद्भिः समन्ततः ।\nरथैश्चाधिरथेर्मार्गे समास्तीर्यत मेदिनी\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2170029, "chapter_id": 4633, "verse_number": "५६", "content_sanskrit": "नैव भीष्मो न च द्रोणो नाप्यन्ये युधि तावकाः ।\nचक्रुः स्म तादृशं कर्म यादृशं वै कृतं रणे\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2170030, "chapter_id": 4633, "verse_number": "५७", "content_sanskrit": "सूतपुत्रेण नागेषु रथेषु च हयेषु च ।\nनरेषु च नरव्याघ्र कृतं स्म कदनं महत्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2170031, "chapter_id": 4633, "verse_number": "५८", "content_sanskrit": "मृगमध्ये यथा सिंहो दृश्यते निर्भयश्चरन् ।\nपाञ्चालानां तथा मध्ये कर्णोऽचरदभीतवत्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2170032, "chapter_id": 4633, "verse_number": "५९", "content_sanskrit": "यथा मृगगणांस्त्रस्तान् सिंहो द्रावयते दिशः ।\nपाञ्चालानां रथव्रातान् कर्णो द्रावयते तथा\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2170033, "chapter_id": 4633, "verse_number": "६०", "content_sanskrit": "सिंहास्यं च यथा प्राप्य न जीवन्ति मृगाः क्वचित् ।\nतथा कर्णमनुप्राप्य न जीवन्ति महारथाः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2170034, "chapter_id": 4633, "verse_number": "६१", "content_sanskrit": "वैश्वानरं यथा दीप्तं दह्यन्ते प्राप्य वै जनाः ।\nकर्णाग्निना रणे तद्वद्दग्धा भारत सृञ्जयाः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2170035, "chapter_id": 4633, "verse_number": "६२", "content_sanskrit": "कर्णेन चेदिष्वेकेन पाञ्चालेषु च भारत ।\nविश्राव्य नाम निहता बहवः शूरसम्मताः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2170036, "chapter_id": 4633, "verse_number": "६३", "content_sanskrit": "मम चासीन् मनुष्येन्द्र दृष्ट्वा कर्णस्य विक्रमम् ।\nनैकोऽप्याधिरथेर्जीवन् पाञ्चाल्यो मोक्ष्यते युधि\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2170037, "chapter_id": 4633, "verse_number": "६४", "content_sanskrit": "पाञ्चालानथ निघ्नन्तं कर्णं दृष्ट्वा महारणे\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2170038, "chapter_id": 4633, "verse_number": "६५", "content_sanskrit": "पाञ्चालान् विधमन् सङ्खे सूतपुत्रः प्रतापवान् ।\nअभ्यधावत सङ्क्रुद्धो धर्मपुत्रं युधिष्ठिरम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2170039, "chapter_id": 4633, "verse_number": "६६", "content_sanskrit": "धृष्टद्युम्नश्च राधेयं द्रौपदेयाश्च मारिष ।\nपरिवव्रुरमित्रघ्नं शतशश्चापरे जनाः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2170040, "chapter_id": 4633, "verse_number": "६७", "content_sanskrit": "शिखण्डी सहदेवश्च नकुलो नाकुलिस्तथा ।\nजनमेजयः शिनेर्नप्ता बहवश्च प्रभद्रकाः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2170041, "chapter_id": 4633, "verse_number": "६८", "content_sanskrit": "एते पुरोगमा भूत्वा धृष्टद्युम्नश्च संयुगे ।\nकर्णमस्यन्तमिष्वस्त्रैर्विचेरुरमितौजसः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2170042, "chapter_id": 4633, "verse_number": "६९", "content_sanskrit": "तांस्तत्राधिरथिः सङ्खे चेदिपाञ्चालपाण्डवान् ।\nएको बहूनभ्यपतद् गरुत्मान् पन्नगानिव\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2170043, "chapter_id": 4633, "verse_number": "७०", "content_sanskrit": "तैः कर्णस्याभवद् युद्धं घोररूपं विशाम्पते ।\nतादृग्यादृक्पुरा वृत्तं देवानां दानवैः सह\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2170044, "chapter_id": 4633, "verse_number": "७१", "content_sanskrit": "तान् समेतान् महेष्वासान् शरवर्षौघवर्षिणः ।\nएकोऽभ्यभवदव्यग्रस्तमांसीव दिवाकरः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2170045, "chapter_id": 4633, "verse_number": "७२", "content_sanskrit": "भीमसेनस्तु सङ्क्रुद्धो राधेयं पाण्डवैः सह ।\nकुरूंश्चाभ्यहनत् क्रुद्धान् यमदण्डनिभैः शरैः \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2170046, "chapter_id": 4633, "verse_number": "७३", "content_sanskrit": "बाह्लीकान् केकयान् मत्स्यान् वासात्यान् मद्रसैन्धवान्\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2170047, "chapter_id": 4633, "verse_number": "७४", "content_sanskrit": "एकः सङ्खे महेष्वासान् योधयन् बह्वशोभत\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2170048, "chapter_id": 4633, "verse_number": "७५", "content_sanskrit": "तत्र मर्मसु भीमेन नाराचैस्ताडिता गजाः ।\nप्रपतन्तो हतारोहाः कम्पयन्ति स्म मेदिनीम्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2170049, "chapter_id": 4633, "verse_number": "७६", "content_sanskrit": "वाजिनश्च हतारोहाः पत्तयश्च गतासवः ।\nअशेरत महाराज वमन्तो रुधिरं बहु\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2170050, "chapter_id": 4633, "verse_number": "७७", "content_sanskrit": "सहस्रशश्च रथिनः पतिताः पतितायुधाः ।\nअक्षताः समदृश्यन्त भीमाद् भीता गतासवः\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2170051, "chapter_id": 4633, "verse_number": "७८", "content_sanskrit": "रथिभिर्वाजिभिः सूतैः पत्तिभिश्च तथा गजैः ।\nभीमसेनशरश्छिन्नैरास्तीर्णा वसुधाऽभवत्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2170052, "chapter_id": 4633, "verse_number": "७९", "content_sanskrit": "तत्स्तम्भितमिवातिष्ठद् भीमसेनबलार्दितम् ।\nदुर्योधनबलं राजन्निरुत्साहं कृतव्रणम्\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2170053, "chapter_id": 4633, "verse_number": "८०", "content_sanskrit": "निश्चेष्टं तुमुले दीनं बभौ तस्मिन् महारणे ।\nप्रसन्नसलिलः काले यथा स्यात् सागरो नृप\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2170054, "chapter_id": 4633, "verse_number": "८१", "content_sanskrit": "तद्वत्तव बलं तद्वै निश्चलं समवस्थितम्\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2170055, "chapter_id": 4633, "verse_number": "८२", "content_sanskrit": "मन्युवीर्यबलोपेतं बलात् प्रत्यवरोपितम् ।\nअभवत् तव पुत्रस्य तत्सैन्यं निष्प्रभं तदा\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2170056, "chapter_id": 4633, "verse_number": "८३", "content_sanskrit": "रुधिरौघपरिक्लिन्नं रुधिरार्द्रं बभूव ह\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2170057, "chapter_id": 4633, "verse_number": "८४", "content_sanskrit": "सूतपुत्रो रणे क्रुद्धः पाण्डवानामनीकिनीम् ।\nभीमसेनः कुरूंश्चापि द्रावयन्तौ विरेजतुः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2170058, "chapter_id": 4633, "verse_number": "८५", "content_sanskrit": "वर्तमाने यथा रौद्रे सङ्ग्रामेऽद्भुतदर्शने ।\nनिहत्य पृतनामध्ये संशप्तकगणान् बहून्\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2170059, "chapter_id": 4633, "verse_number": "८६", "content_sanskrit": "अर्जुनो जयतां श्रेष्ठो वासुदेवमथाब्रवीत् ।\nप्रभग्नं बलमेतद्धि योत्स्यमानं जनार्दन\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2170060, "chapter_id": 4633, "verse_number": "८७", "content_sanskrit": "एते धावन्ति सगणाः संशप्तकमहारथाः ।\nअपारयन्तो मद्बाणान् सिंहशब्दान्मृगा इव\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2170061, "chapter_id": 4633, "verse_number": "८८", "content_sanskrit": "दीर्यते च महत्सैन्यं सृञ्जयानां महारणे ।\nहस्तिकक्ष्यो ह्यसौ कृष्ण केतुः कर्णस्य धीमतः\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2170062, "chapter_id": 4633, "verse_number": "८९", "content_sanskrit": "दृश्यते गजसैन्यस्य मध्ये विचरतो मुहुः\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2170063, "chapter_id": 4633, "verse_number": "९०", "content_sanskrit": "न च कर्णं रणे शक्ता जेतुमन्ये महारथाः ।\nजानीते हि भवान् कर्णं वीर्यवन्तं पराक्रमे\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2170064, "chapter_id": 4633, "verse_number": "९१", "content_sanskrit": "तत्र याहि यतः कर्णो द्रावयत्येष नो बलम्\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2170065, "chapter_id": 4633, "verse_number": "९२", "content_sanskrit": "त्वरयन् वै रणे याहि सूतपुत्रं महारथम् ।\nएवं मे रोचते कृष्ण यथा वा तव रोचते\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2170066, "chapter_id": 4633, "verse_number": "९३", "content_sanskrit": "एतच्छ्रुत्वा महाराज गोविन्दः प्रहसन्निव ।\nअब्रवीदर्जुनं तूर्णं कौरवान् जहि पाण्डव\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2170067, "chapter_id": 4633, "verse_number": "९४", "content_sanskrit": "ततस्तव महत्सैन्यं गोविन्दप्रेरिता हयाः ।\nहंसवर्णाः प्रविविशुर्वहन्तः कृष्णपाण्डवौ\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2170068, "chapter_id": 4633, "verse_number": "९५", "content_sanskrit": "केशवप्रहितैरश्वैः श्वेतैः काञ्चनभूषणैः ।\nप्रविशद्भिस्तव बलं चतुर्दिशमभिद्यत\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2170069, "chapter_id": 4633, "verse_number": "९६", "content_sanskrit": "मेघस्तनितनिर्ह्रादः स रथो वानरध्वजः ।\nचलत्पताकस्तां सेनां विमानं द्यामिवाविशत्\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2170070, "chapter_id": 4633, "verse_number": "९७", "content_sanskrit": "तौ विदार्य महासेनां प्रविष्टौ केशवार्जुनौ ।\nक्रुद्धौ संरम्भरक्ताक्षौ व्यभ्राजेतां महाद्युती\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2170071, "chapter_id": 4633, "verse_number": "९८", "content_sanskrit": "युद्धशौण्डौ समाहूतावरिभिस्तौ रणाध्वरम् ।\nयज्वभिर्विधिनाहूतौ मखे देवाविवाश्विनौ\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2170072, "chapter_id": 4633, "verse_number": "९९", "content_sanskrit": "क्रुद्धौ तौ तु नरव्याघ्रौ वेगवन्तौ बभूवतुः ।\nतलशब्देन रुषितौ यथा नागौ महाहवे\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2170073, "chapter_id": 4633, "verse_number": "१००", "content_sanskrit": "विगाहन् स रथानीकमश्वसङ्घांश्च फल्गुनः ।\nव्यचरत् पृतनामध्ये पाशहस्त इवान्तकः\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2170074, "chapter_id": 4633, "verse_number": "१०१", "content_sanskrit": "तं दृष्ट्वा युधि विक्रान्तं सेनायां तव भारत ।\nसंशप्तकगणान् भूयः पुत्रस्ते समचोदयत्\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2170075, "chapter_id": 4633, "verse_number": "१०२", "content_sanskrit": "ततो रथसहस्रेण द्विरदानां त्रिभिः शतैः ।\nचतुर्दशसहस्रैश्च तुरगाणां महाहवे\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2170076, "chapter_id": 4633, "verse_number": "१०३", "content_sanskrit": "द्वाभ्यां शतसहस्राभ्यां पदातीनां च धन्विनाम् ।\nशूराणां लब्धलक्षाणां विदितानां समन्ततः\t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2170077, "chapter_id": 4633, "verse_number": "१०४", "content_sanskrit": "अभ्यवर्तन्त तौ वीरौ छादयन्तो महारथाः ।\nशरवर्षैर्महाराज सर्वतः पाण्डुनन्दनम्\t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2170078, "chapter_id": 4633, "verse_number": "१०५", "content_sanskrit": "स च्छाद्यमानः समरे शरैः परबलार्दनः ।\nदर्शयन् रौद्रमात्मानं पाशहस्त इवान्तकः\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2170079, "chapter_id": 4633, "verse_number": "१०६", "content_sanskrit": "निघ्नन् संशप्तकान् पार्थः प्रेक्षणीयतरोऽभवत्\t॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2170080, "chapter_id": 4633, "verse_number": "१०७", "content_sanskrit": "ततो विद्युत्प्रभैर्बाणैः कार्तस्वरविभूषितैः ।\nनिरन्तरमिवाकाशमासीन्नुन्नैः किरीटिना\t॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2170081, "chapter_id": 4633, "verse_number": "१०८", "content_sanskrit": "किरीटिभुजनिर्मुक्तैः सम्पतद्भिर्महाशरैः ।\nसमाच्छन्नं बभौ सर्वं काद्रवेयैरिव प्रभो\t॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2170082, "chapter_id": 4633, "verse_number": "१०९", "content_sanskrit": "रुग्मपुङ्खान् प्रसन्नाग्रान् शरान् सन्नतपर्वणः ।\nअवासृजदमेयात्मा दिक्षु सर्वासु पाण्डवः\t॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2170083, "chapter_id": 4633, "verse_number": "११०", "content_sanskrit": "मही वियद्दिशः सर्वाः समुद्रा गिरयोऽपि वा ।\nस्फुटन्तीति जना जज्ञुः पार्थस्य तळनिस्वनात्\t॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2170084, "chapter_id": 4633, "verse_number": "१११", "content_sanskrit": "(हत्वा दश सहस्राणि पार्थिवानां महारथः ।\nसंशप्तकानां कौन्तेयः प्रपक्षं त्वरितोऽभ्ययात्\t॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2170085, "chapter_id": 4633, "verse_number": "११२", "content_sanskrit": "प्रपक्षं स समासाद्य पार्थः काम्बोजरक्षितम् ।\nप्रममाथ बलाद् बाणैर्दानवानिव वासवः\t॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2170086, "chapter_id": 4633, "verse_number": "११३", "content_sanskrit": "प्रचिच्छेदाशु भल्लैश्च द्विषतामाततायिनाम् ।\nशस्त्रपाणींस्तथा बाहूंस्तथापि च शिरांस्युत\t॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2170087, "chapter_id": 4633, "verse_number": "११४", "content_sanskrit": "अङ्गाङ्गावयवैश्छिन्नैर्व्यायुधास्तेऽपतन् क्षितौ ।)\nविष्वग्वाताभिसम्भग्ना बहुशाखा इव द्रुमाः\t॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2170088, "chapter_id": 4633, "verse_number": "११५", "content_sanskrit": "हस्त्यश्वरथपत्तीनां व्रातान् निघ्नन्तमर्जुनम् ।\nसुदक्षिणादवरजः शरवृष्ट्याभ्यवीवृषत्\t॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2170089, "chapter_id": 4633, "verse_number": "११६", "content_sanskrit": "अस्यास्यतोऽर्धचन्द्राभ्यां स बाहू परिघोपमौ ।\nपूर्णचन्द्राभवक्त्रं च क्षुरेणाभ्यहनच्छिरः\t॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2170090, "chapter_id": 4633, "verse_number": "११७", "content_sanskrit": "स पपात ततो वाहात् स्वलोहितपरिस्रवः ।\nमनःशिलागिरेः शृङ्गं वज्रेणेवावदारितम्\t॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2170091, "chapter_id": 4633, "verse_number": "११८", "content_sanskrit": "सुदक्षिणादवरजं काम्बोजं ददृशुर्हतम् ।\nप्रांशुं कमलपत्राक्षमत्यर्थं प्रियदर्शनम्\t॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2170092, "chapter_id": 4633, "verse_number": "११९", "content_sanskrit": "काञ्चनस्तम्भसङ्काशं भिन्नं हेमगिरिं यथा\t॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2170093, "chapter_id": 4633, "verse_number": "१२०", "content_sanskrit": "ततोऽभवत् पुनर्युद्धं घोरमद्भुतदर्शनम् ।\nनानावस्थाश्च योधानां बभूवुस्तत्र युध्यताम्\t॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2170094, "chapter_id": 4633, "verse_number": "१२१", "content_sanskrit": "एतेष्वावर्जितैरश्वैः काम्बोजैर्यवनैः शकैः ।\nशोणिताक्तैस्तदा रक्तं सर्वमासीद् विशाम्पते\t॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2170095, "chapter_id": 4633, "verse_number": "१२२", "content_sanskrit": "नरैर्हताश्वसूतैश्च हतारोहैश्च वाजिभिः ।\nद्विरदैश्च हतारोहैर्महामात्रैर्हतद्विपैः ।\nअन्योन्येन महाराज कृतो घोरो जनक्षयः \t॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2170096, "chapter_id": 4633, "verse_number": "१२३", "content_sanskrit": "तस्मिन् प्रपक्षे पक्षे च निहते सव्यसाचिना\t॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2170097, "chapter_id": 4633, "verse_number": "१२४", "content_sanskrit": "अर्जुनं जयतां श्रेष्ठं त्वरितो द्रोणिराययौ\t॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2170098, "chapter_id": 4633, "verse_number": "१२५", "content_sanskrit": "विधुन्वानो महच्चापं कार्तस्वरविभूषितम् ।\nआददानः शरान् घोरान् स्वरश्मीनिव भास्करः\t॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2170099, "chapter_id": 4633, "verse_number": "१२६", "content_sanskrit": "क्रोधामर्षविवृत्ताक्षो लोहिताक्षो बभौ बली ।\nअन्तकाले यथा क्रुद्धो मृत्युः किङ्करदण्डभृत्\t॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2170100, "chapter_id": 4633, "verse_number": "१२७", "content_sanskrit": "ततः प्रासृजदुग्राणि शरवर्षाणि सर्वशः ।\nतैर्विसृष्टैर्महाराज व्यद्रवत् पाण्डवी चमूः\t॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2170101, "chapter_id": 4633, "verse_number": "१२८", "content_sanskrit": "स दृष्ट्वैव तु दाशार्हं स्यन्दनस्थं विशाम्पते ।\nपुनः प्रासृजदुग्राणि शरवर्षाणि मारिष\t॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2170102, "chapter_id": 4633, "verse_number": "१२९", "content_sanskrit": "तैः पतद्भिर्महाराज द्रौणिमुक्तैः समन्ततः ।\nसञ्छादितौ रथस्थौ तावुभौ कृष्णधनञ्जयौ\t॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2170103, "chapter_id": 4633, "verse_number": "१३०", "content_sanskrit": "ततः शरशतैस्तीक्ष्णैर्भारद्वाजात्मजात्मजः ।\nनिश्चेष्टौ तावुभौ चक्रे युद्धे माधवपाण्डवौ\t॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2170104, "chapter_id": 4633, "verse_number": "१३१", "content_sanskrit": "हाहाकृतमभूत् सर्वं जङ्गमं स्थावरं तथा ।\nचराचरस्य गोप्तारौ दृष्ट्वा सञ्छादितौ शरैः\t॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2170105, "chapter_id": 4633, "verse_number": "१३२", "content_sanskrit": "सिद्धचारणसङ्घाश्च सम्पेतुर्वै समन्ततः ।\nअपि स्वस्ति भवेदद्य लोकानामिति चाब्रुवन्\t॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2170106, "chapter_id": 4633, "verse_number": "१३३", "content_sanskrit": "न मया तादृशो राजन् दृष्टपूर्वः पराक्रमः ।\nसञ्जज्ञे यादृशो द्रौणेः कृष्णौ सञ्छादयिष्यतः\t॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2170107, "chapter_id": 4633, "verse_number": "१३४", "content_sanskrit": "द्रौणेस्तु धनुषः शब्दमहितत्रासनं रणे ।\nअश्रौषं बहुशो राजन् सिंहस्य नदतो यथा\t॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2170108, "chapter_id": 4633, "verse_number": "१३५", "content_sanskrit": "ज्या चास्य चरतो युद्धे सव्यदक्षिणमस्यतः ।\nविद्युदम्बुदमध्यस्था भ्राजमानेव साऽभवत्\t॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2170109, "chapter_id": 4633, "verse_number": "१३६", "content_sanskrit": "स तथा क्षिप्रकारी च दृढहस्तश्च पाण्डवः ।\nसम्मोहं परमं गत्वा प्रैक्षत द्रोणजं ततः\t॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2170110, "chapter_id": 4633, "verse_number": "१३७", "content_sanskrit": "स विक्रमं हृतं मेने आत्मनः सुमहात्मना ।\nतथास्य समरे राजन् वपुरासीत् सुदुर्दृशम्\t॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2170111, "chapter_id": 4633, "verse_number": "१३८", "content_sanskrit": "द्रौणिपाण्डवयोरेवं वर्तमाने महारणे ।\nवर्धमाने च राजेन्द्र द्रोणपुत्रे महाबले ।\nहीयमाने च कौन्तेये कृष्णं रोषः समाविशत्\t॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2170112, "chapter_id": 4633, "verse_number": "१३९", "content_sanskrit": "स रोषान्निःश्वसन् राजन् निर्दहन्निव चक्षुषा ।\nद्रौणिं ह्यपश्यत् सङ्ग्रामे फल्गुनं च मुहुर्मुहुः\t॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2170113, "chapter_id": 4633, "verse_number": "१४०", "content_sanskrit": "ततः क्रुद्धोऽब्रवीत् कृष्णः पार्थं सप्रणयं तदा ।\nअत्यद्भुतमिदं पार्थ तव पश्यामि संयुगे\t॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 2170114, "chapter_id": 4633, "verse_number": "१४१", "content_sanskrit": "अतिशेते हि यत्र त्वा द्रोणपुत्रोऽद्य भारत\t॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 2170115, "chapter_id": 4633, "verse_number": "१४२", "content_sanskrit": "कच्चिद्वीर्यं यथापूर्वं भुजयोर्वा बलं तव\t॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 2170116, "chapter_id": 4633, "verse_number": "१४३", "content_sanskrit": "कच्चित्ते गाण्डिवं हस्ते रथे तिष्ठसि चार्जुन ।\nकच्चित् कुशलिनौ बाहू मुष्टिर्वा न विशीर्यते\t॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 2170117, "chapter_id": 4633, "verse_number": "१४४", "content_sanskrit": "उदीर्यमाणं हि रणे पश्यामि द्रौणिमाहवे ।\nगुरुपुत्र इति ह्येनं मानयन् भरतर्षभ\t॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 2170118, "chapter_id": 4633, "verse_number": "१४५", "content_sanskrit": "उपेक्षां कुरु मा पार्थ नायं काल उपेक्षितुम्\t॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 2170119, "chapter_id": 4633, "verse_number": "१४६", "content_sanskrit": "एवमुक्तस्तु कृष्णेन गृह्य भल्लांश्चतुर्दश ।\nत्वरमाणस्त्वराकाले द्रौणेर्धनुरथाच्छिनत्\t॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 2170120, "chapter_id": 4633, "verse_number": "१४७", "content_sanskrit": "ध्वजं छत्रं पताकां च खड्गं शक्तिं गदा तथा\t॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 2170121, "chapter_id": 4633, "verse_number": "१४८", "content_sanskrit": "जत्रुदेशे च सुभृशं वत्सदन्तैरताडयत् ।\nस मूर्च्छां परमां गत्वा ध्वजयष्टिं समाश्रितः\t॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 2170122, "chapter_id": 4633, "verse_number": "१४९", "content_sanskrit": "तं विसञ्ज्ञं महाराज पार्थेन भृशताडितम् ।\nअपोवाह रणात् सूतो रक्षमाणो धनञ्जयात्\t॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 2170123, "chapter_id": 4633, "verse_number": "१५०", "content_sanskrit": "एतस्मिन्नेव काले तु विजयः शत्रुतापनः ।\nन्यवधीत् तावकं सैन्यं शतशोऽथ सहस्रशः\t॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 2170124, "chapter_id": 4633, "verse_number": "१५१", "content_sanskrit": "पश्यतस्तव पुत्रस्य तस्य वीरस्य भारत\t॥१५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 2170125, "chapter_id": 4633, "verse_number": "१५२", "content_sanskrit": "एवमेष क्षयो वृत्तस्तावकानां परैः सह ।\nक्रूरो विशसनो घोरो राजन् दुर्मन्त्रिते तव\t॥१५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 2170126, "chapter_id": 4633, "verse_number": "१५३", "content_sanskrit": "संशप्तकांश्च कौन्तेयः कुरूंश्चापि वृकोदरः ।\nवसुषेणञ्च पाञ्चालान् क्षणेन व्यधमद् रणे\t॥१५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}, {"id": 2170127, "chapter_id": 4633, "verse_number": "१५४", "content_sanskrit": "वर्तमाने तथा रौद्रे राजन् वीरवरक्षये ।\nउत्थितान्यगणेयानि कबन्धानि समन्ततः\t॥१५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 155}, {"id": 2170128, "chapter_id": 4633, "verse_number": "१५५", "content_sanskrit": "युधिष्ठिरोऽपि सङ्ग्रामे प्रहारैर्गाढवेदनः ।\nक्रोशमात्रमपक्रम्य तस्थौ भरतसत्तम\t॥१५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 156}, {"id": 2170129, "chapter_id": 4633, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nत्रिपञ्चाशोऽध्यायः ॥५३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 157}]