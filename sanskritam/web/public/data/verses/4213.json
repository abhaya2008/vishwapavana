[{"id": 2148469, "chapter_id": 4213, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2148470, "chapter_id": 4213, "verse_number": "१", "content_sanskrit": "राधेयोऽहमाधिरथः कर्णस्त्वामभिवादये ।\nप्राप्ता किमर्थं भवती ब्रूहि किं करवाणि ते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2148471, "chapter_id": 4213, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2148472, "chapter_id": 4213, "verse_number": "२", "content_sanskrit": "कौन्तेयस्त्वं न राधेयो न तवाधिरथः पिता ।\nनासि सूतकुले जातः कर्ण तद् विद्धि मे वचः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2148473, "chapter_id": 4213, "verse_number": "३", "content_sanskrit": "कानीनस्त्वं मया जातः पूर्वजः कुक्षिणा धृतः ।\nकुन्तिभोजस्य भवने पार्थस्त्वमसि पुत्रक\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2148474, "chapter_id": 4213, "verse_number": "४", "content_sanskrit": "प्रकाशकर्मा तपनो योऽयं देवो विरोचनः ।\nअजीजनत् त्वां मय्येव कर्ण शस्त्रभृतां वरम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2148475, "chapter_id": 4213, "verse_number": "५", "content_sanskrit": "कुण्डली बद्धकवचो देवगर्भः श्रिया वृतः ।\nजातस्त्वमसि दुर्धर्ष मया पुत्र पितुर्गृहे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2148476, "chapter_id": 4213, "verse_number": "६", "content_sanskrit": "स त्वं भ्रातॄनसम्बुद्ध्वा मोहाद् यदुपसेवसे ।\nधार्तराष्ट्रान् न तद् युक्तं त्वयि पुत्र विशेषतः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2148477, "chapter_id": 4213, "verse_number": "७", "content_sanskrit": "एतद् धर्मफलं पुत्र नराणां धर्मनिश्चये ।\nयत् तुष्यन्त्यस्य पितरो माता चाप्येकदर्शिनी\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2148478, "chapter_id": 4213, "verse_number": "८", "content_sanskrit": "भ्रातृभिर्निर्जितां पूर्वं भीमार्जुनयमादिभिः ।\nआच्छिद्य धार्तराष्ट्रेभ्यो भुङ्क्ष्व यौधिष्ठिरीं श्रियम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2148479, "chapter_id": 4213, "verse_number": "९", "content_sanskrit": "अद्य पश्यन्तु कुरवः कर्णार्जुनसमागमम् ।\nसौभ्रात्रमेतदालक्ष्य सन्नमन्तामसाधवः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2148480, "chapter_id": 4213, "verse_number": "१०", "content_sanskrit": "कर्णार्जुनौ वै भवतां यथा रामजनार्दनौ ।\nअसाध्यं किं नु लोके स्याद् युवयोः संहतात्मनोः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2148481, "chapter_id": 4213, "verse_number": "११", "content_sanskrit": "कर्ण शोभिष्यसे नूनं पञ्चभिर्भ्रातृभिर्वृतः ।\nवेदैः परिवृतो ब्रह्मा यथा वेदाङ्गपञ्चमैः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2148482, "chapter_id": 4213, "verse_number": "१२", "content_sanskrit": "उपपन्नो गुणैः सर्वैर्ज्येष्ठः श्रेष्ठेषु बन्धुषु ।\nसूतपुत्रेति मा शब्दः पार्थस्त्वमसि वीर्यवान्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2148483, "chapter_id": 4213, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि चतुश्चत्वारिंशोत्तरशततमोऽध्यायः ॥१४४॥ विवादपर्वणि षष्ठोऽध्यायः ॥६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]