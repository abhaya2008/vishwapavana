[{"id": 50006325, "chapter_id": 11346, "verse_number": "1", "content_sanskrit": "[न्यायमाला (अनुव्याख्याने ३-१-१-३)- स्वाभाविकान्यथानामसहभावान्यथोक्तयः। अविशेषविशेषौ च सहभावो विमिश्रता॥ विरुद्धोक्तिः सहस्थानं वैयर्थ्यं चान्यथागतिः। युक्तयः पूर्वपक्षस्य गुणाधिक्यार्थतोभवौ॥ उपपत्तिद्विरूपत्वमाधिक्यमनुरूपता। योग्यता बलवत्त्वं च विभागः कारणाभवः। कॢप्तिरन्या गतिश्चैव सिद्धान्तस्यैव साधकाः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50006326, "chapter_id": 11346, "verse_number": "2", "content_sanskrit": "॥ ॐ तदन्तरप्रतिपत्तौ रंहति सम्परिष्वक्तः प्रश्ननिरूपणाभ्याम् ॐ॥ स्वाभाविकम्। गुणाधिक्यम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50006327, "chapter_id": 11346, "verse_number": "3", "content_sanskrit": "॥ ॐ त्र्यात्मकत्वात् तु भूयस्त्वात् ॐ॥ अन्यथानाम। अर्थतोभवः। ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50006328, "chapter_id": 11346, "verse_number": "4", "content_sanskrit": "॥ ॐ प्राणगतेश्च ॐ॥ सहभावः। उपपत्तिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50006329, "chapter_id": 11346, "verse_number": "5", "content_sanskrit": "॥ ॐ अग्न्यादिगतिश्रुतेरिति चेन्न भाक्तत्वात् ॐ॥ अन्यथोक्तिः। द्विरूपत्वम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50006330, "chapter_id": 11346, "verse_number": "6", "content_sanskrit": "॥ ॐ प्रथमेऽश्रवणादिति चेन्न ता एव ह्युपपत्तेः ॐ॥ अविशेषः। आधिक्यम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50006331, "chapter_id": 11346, "verse_number": "7", "content_sanskrit": "॥ ॐ अश्रुतत्वादिति चेन्नेष्टादिकारिणां प्रतीतेः ॐ॥ अविशेषः। अनु