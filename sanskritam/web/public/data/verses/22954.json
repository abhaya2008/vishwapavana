[{"id": 7002954000, "chapter_id": 22954, "verse_number": "२-१-१", "content_sanskrit": "॥ नारद उवाच ।\nगणेशजननी दुर्गा राधा लक्ष्मीः सरस्वती ।\nसावित्री वै सृष्टिविधौ प्रकृतिः पञ्चधा स्मृता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002954001, "chapter_id": 22954, "verse_number": "२-१-२", "content_sanskrit": "आविर्बभूव सा केन का वा सा ज्ञानिनां वरा ।\nकिं वा तल्लक्षणं ब्रूहि साभवत्पञ्चधा कथम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002954002, "chapter_id": 22954, "verse_number": "२-१-३", "content_sanskrit": "सर्वासां चरितं पूजाविधानं कथमीप्सितम् ।\nअवतारं कुत्र कस्यास्तन्मां व्याख्यातुमर्हसि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002954003, "chapter_id": 22954, "verse_number": "२-१-४", "content_sanskrit": "नारायण उवाच ।\nप्रकृतेर्लक्षणं वत्स को वा वक्तुं क्षमो भवेत् ।\nकिंचित्तथापि वक्ष्यामि यच्छ्रुतं धर्मवक्त्रतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002954004, "chapter_id": 22954, "verse_number": "२-१-५", "content_sanskrit": "प्रकृष्टवाचकः प्रश्च कृतिश्च सृष्टिवाचकः ।\nसृष्टौ प्रकृष्टा या देवी प्रकृतिः सा प्रकीर्तिता ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002954005, "chapter_id": 22954, "verse_number": "२-१-६", "content_sanskrit": "गुणे प्रकृष्टसत्त्वे च प्रशब्दो वर्तते श्रुतौ ।\nमध्यमे कृश्च रजसि तिशब्दस्तमसि स्मृतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002954006, "chapter_id": 22954, "verse_number": "२-१-७", "content_sanskrit": "त्रिगुणात्मस्वरूपा या सर्वशक्तिसमन्विता ।\nप्रधाना सृष्टिकरणे प्रकृतिस्तेन कथ्यते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002954007, "chapter_id": 22954, "verse_number": "२-१-८", "content_sanskrit": "प्रथमे वर्त्तते प्रश्च कृतिस्स्यात्सृष्टिवाचकः ।\nसृष्टेराद्या च या देवी प्रकृतिः सा प्रकीर्तिता ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002954008, "chapter_id": 22954, "verse_number": "२-१-९", "content_sanskrit": "योगेनात्मा सृष्टिविधौ द्विधारूपो बभूव सः ।\nपुमांश्च दक्षिणार्द्धाङ्गो वामाङ्गः प्रकृतिः स्मृतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002954009, "chapter_id": 22954, "verse_number": "२-१-१०", "content_sanskrit": "सा च ब्रह्मस्वरूपा स्यान्माया नित्या सनातनी ।\nयथाऽऽत्मा च यथाशक्तिर्यथाऽग्नौ दाहिका स्मृता ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002954010, "chapter_id": 22954, "verse_number": "२-१-११", "content_sanskrit": "अतएव हि योगीन्द्रः स्त्रीपुंभेदं न मन्यते ।\nसर्वं ब्रह्ममयं ब्रह्मञ्छश्वत्पश्यति नारद ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002954011, "chapter_id": 22954, "verse_number": "२-१-१२", "content_sanskrit": "स्वेच्छामयस्येच्छया च श्रीकृष्णस्य सिसृक्षया ।\nसाऽऽविर्बभूव सहसा मूलप्रकृतिरीश्वरी ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002954012, "chapter_id": 22954, "verse_number": "२-१-१३", "content_sanskrit": "तदाज्ञया पञ्चविधा सृष्टिकर्मणि भेदतः ।\nअथ भक्तानुरोधाद्वा भक्तानुग्रहविग्रहा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002954013, "chapter_id": 22954, "verse_number": "२-१-१४", "content_sanskrit": "गणेशमाता दुर्गा या शिवरूपा शिवप्रिया ।\nनारायणी विष्णुमाया पूर्णब्रह्मस्वरूपिणी ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002954014, "chapter_id": 22954, "verse_number": "२-१-१५", "content_sanskrit": "ब्रह्मादिदेवैर्मुनिभिर्मनुभिः पूजिता सदा ।\nसर्वाधिष्ठातृदेवी सा ब्रह्मरूपा सनातनी ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002954015, "chapter_id": 22954, "verse_number": "२-१-१६", "content_sanskrit": "यशोमङ्गलधर्मश्रीसत्यपुण्यप्रदायिनी ।\nमोक्षहर्षप्रदात्रीयं शोकदुःखार्तिनाशिनी ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002954016, "chapter_id": 22954, "verse_number": "२-१-१७", "content_sanskrit": "शरणागतदीनार्तपरित्राणपरायणा ।\nतेजःस्वरूपा परमा तदधिष्ठातृदेवता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002954017, "chapter_id": 22954, "verse_number": "२-१-१८", "content_sanskrit": "सर्वशक्तिस्वरूपा च शक्तिरीशस्य सन्ततम् ।\nसिद्धेश्वरी सिद्धरूपा सिद्धिदा सिद्धिदेश्वरी ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002954018, "chapter_id": 22954, "verse_number": "२-१-१९", "content_sanskrit": "बुद्धिर्निद्रा क्षुत्पिपासा च्छाया तन्द्रा दया स्मृतिः ।\nजातिः क्षान्तिश्च शान्तिश्च कांतिर्भ्रान्तिश्च चेतना ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002954019, "chapter_id": 22954, "verse_number": "२-१-२०", "content_sanskrit": "तुष्टिः पुष्टिस्तथा लक्ष्मीर्वृत्तिर्माता तथैव च ।\nसर्वशक्तिस्वरूपा सा कृष्णस्य परमात्मनः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002954020, "chapter_id": 22954, "verse_number": "२-१-२१", "content_sanskrit": "उक्तः श्रुतौ श्रुतगुणश्चातिस्वल्पो यथागमम् ।\nगुणोऽस्त्यनन्तोऽनन्ताया अपरां च निशामय ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002954021, "chapter_id": 22954, "verse_number": "२-१-२२", "content_sanskrit": "शुद्धसत्त्वस्वरूपा या पद्मा च परमात्मनः ।\nसर्वसम्पत्स्वरूपा या तदधिष्ठातृदेवता ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002954022, "chapter_id": 22954, "verse_number": "२-१-२३", "content_sanskrit": "कान्ता दान्ताऽतिशान्ता च सुशीला सर्वमङ्गला ।\nलोभान्मोहात्कामरोषान्मदाहङ्कारतस्तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002954023, "chapter_id": 22954, "verse_number": "२-१-२४", "content_sanskrit": "त्यक्ताऽनुरक्ता पत्युश्च सर्वाद्या च पतिव्रता ।\nप्राणतुल्या भगवतः प्रेमपात्री प्रियंवदा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002954024, "chapter_id": 22954, "verse_number": "२-१-२५", "content_sanskrit": "सर्वसस्यात्मिका सर्वजीवनोपायरूपिणी ।\nमहालक्ष्मीश्च वैकुण्ठे पतिसेवापरायणा॥ ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002954025, "chapter_id": 22954, "verse_number": "२-१-२६", "content_sanskrit": "स्वर्गे च स्वर्गलक्ष्मीश्च राजलक्ष्मीश्च राजसु ।\nगृहे च गृहलक्ष्मीश्च मर्त्यानां गृहिणां तथा॥ ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002954026, "chapter_id": 22954, "verse_number": "२-१-२७", "content_sanskrit": "सर्वेषु प्राणिद्रव्येषु शोभारूपा मनोहरा ।\nप्रीतिरूपा पुण्यवतां प्रभारूपा नृपेषु च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002954027, "chapter_id": 22954, "verse_number": "२-१-२८", "content_sanskrit": "वाणिज्यरूपा वणिजां पापिनां कलहङ्करी ।\nदयामयी भक्तमाता भक्तानुग्रहकारिका ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002954028, "chapter_id": 22954, "verse_number": "२-१-२९", "content_sanskrit": "चपले चपला भक्तसम्पदो रक्षणाय च ।\nजगज्जीवन्मृतं सर्वं यया देव्या विना मुने ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002954029, "chapter_id": 22954, "verse_number": "२-१-३०", "content_sanskrit": "शक्तिर्द्वितीया कथिता वेदोक्ता सर्वसम्मता ।\nसर्वपूज्या सर्ववन्द्या चान्यां मत्तो निशामय॥ ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002954030, "chapter_id": 22954, "verse_number": "२-१-३१", "content_sanskrit": "वाग्बुद्धिविद्याज्ञानाधिदेवता परमात्मनः ।\nसर्वविद्यास्वरूपा या सा च देवी सरस्वती ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002954031, "chapter_id": 22954, "verse_number": "२-१-३२", "content_sanskrit": "सुबुद्धिः कविता मेधा प्रतिभा स्मृतिदा सताम् ।\nनानाप्रकारसिद्धान्तभेदार्थकल्पनाप्रदा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002954032, "chapter_id": 22954, "verse_number": "२-१-३३", "content_sanskrit": "व्याख्याबोधस्वरूपा च सर्वसंदेहभञ्जिनी ।\nविचारकारिणी ग्रन्थकारिणी शक्तिरूपिणी ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002954033, "chapter_id": 22954, "verse_number": "२-१-३४", "content_sanskrit": "सर्वसङ्गीतसन्धानतालकारणरूपिणी ।\nविषयज्ञानवाग्रूपा प्रतिविश्वं च जीविनाम्॥ ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002954034, "chapter_id": 22954, "verse_number": "२-१-३५", "content_sanskrit": "यया विना च विश्वौघो मूको मृतसमः सदा ।\nव्याख्यामुद्राकरा शान्ता वीणापुस्तकधारिणी ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002954035, "chapter_id": 22954, "verse_number": "२-१-३६", "content_sanskrit": "शुद्धसत्त्वस्वरूपा या सुशीला श्रीहरिप्रिया ।\nहिमचन्दनकुन्देन्दुकुमुदाम्भोजसन्निभा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002954036, "chapter_id": 22954, "verse_number": "२-१-३७", "content_sanskrit": "जपन्ती परमात्मानं श्रीकृष्णं रत्नमालया ।\nतपस्स्वरूपा तपसां फलदात्री तपस्विनी ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002954037, "chapter_id": 22954, "verse_number": "२-१-३८", "content_sanskrit": "सिद्धिविद्यास्वरूपा च सर्वसिद्धिप्रदा सदा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002954038, "chapter_id": 22954, "verse_number": "२-१-३९", "content_sanskrit": "यथागमं यथाकिञ्चिदपरां संनिबोध मे ।\nमाता चतुर्णां वेदानां वेदाङ्गानां च छन्दसाम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002954039, "chapter_id": 22954, "verse_number": "२-१-४०", "content_sanskrit": "सन्ध्यावन्दनमन्त्राणां तन्त्राणां च विचक्षणा ।\nद्विजादिजातिरूपा च जपरूपा तपस्विनी ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002954040, "chapter_id": 22954, "verse_number": "२-१-४१", "content_sanskrit": "ब्राह्मण्यतेजोरूपा च सर्वसंस्कारकारिणी ।\nपवित्ररूपा सावित्री गायत्री ब्रह्मणः प्रिया ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002954041, "chapter_id": 22954, "verse_number": "२-१-४२", "content_sanskrit": "तीर्थानि यस्याः संस्पर्शं दर्शं वाञ्छन्ति शुद्धये ।\nशुद्धस्फटिकसंकाशा शुद्धसत्त्वस्वरूपिणी ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002954042, "chapter_id": 22954, "verse_number": "२-१-४३", "content_sanskrit": "परमानन्दरूपा च परमा च सनातनी ।\nपरब्रह्मस्वरूपा च निर्वाणपददायिनी ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002954043, "chapter_id": 22954, "verse_number": "२-१-४४", "content_sanskrit": "ब्रह्मतेजोमयी शक्तिस्तदधिष्ठातृदेवता ।\nयत्पादरजसा पूतं जगत्सर्वं च नारद ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002954044, "chapter_id": 22954, "verse_number": "२-१-४५", "content_sanskrit": "देवी चतुर्थी कथिता पञ्चमीं वर्णयामि ते ।\nप्रेमप्राणाधिदेवी या पञ्चप्राणस्वरूपिणी ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002954045, "chapter_id": 22954, "verse_number": "२-१-४६", "content_sanskrit": "प्राणाधिकप्रियतमा सर्वाद्या सुन्दरी वरा ।\nसर्वसौभाग्ययुक्ता च मानिनी गौरवान्विता ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002954046, "chapter_id": 22954, "verse_number": "२-१-४७", "content_sanskrit": "वामार्द्धाङ्गस्वरूपा च सुगुणैस्तेजसा समा ।\nपरावरा सर्वमाता परमाद्या सनातनी ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002954047, "chapter_id": 22954, "verse_number": "२-१-४८", "content_sanskrit": "परमानन्दरूपा च धन्या मान्या च पूजिता ।\nरासक्रीडाधिदेवी च कृष्णस्य परमात्मनः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002954048, "chapter_id": 22954, "verse_number": "२-१-४९", "content_sanskrit": "रासमण्डलसंभूता रासमण्डलमण्डिता ।\nरासेश्वरी सुरसिका रासावासनिवासिनी ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002954049, "chapter_id": 22954, "verse_number": "२-१-५०", "content_sanskrit": "गोलोकवासिनी देवी गोपीवेषविधायिका ।\nपरमाह्लादरूपा च सन्तोषामर्षरूपिणी ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002954050, "chapter_id": 22954, "verse_number": "२-१-५१", "content_sanskrit": "निर्गुणा च निराकारा निर्लिप्ताऽऽत्मस्वरूपिणी ।\nनिरीहा निरहङ्कारा भक्तानुग्रहविग्रहा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002954051, "chapter_id": 22954, "verse_number": "२-१-५२", "content_sanskrit": "वेदानुसारध्यानेन विज्ञेया सा विचक्षणैः ।\nदृष्टिर्दृष्टा सहस्रेषु सुरेन्द्रैर्मुनिपुङ्गवैः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002954052, "chapter_id": 22954, "verse_number": "२-१-५३", "content_sanskrit": "वह्निशुद्धांशुकाधाना रत्नालङ्कारभूषिता ।\nकोटिप्रभाजुष्टश्रीयुक्ता भक्तविग्रहा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002954053, "chapter_id": 22954, "verse_number": "२-१-५४", "content_sanskrit": "श्रीकृष्णभक्तदास्यैकदायिनी सर्वसम्पदाम् ।\nअवतारे च वाराहे वृषभानुसुता च या ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002954054, "chapter_id": 22954, "verse_number": "२-१-५५", "content_sanskrit": "यत्पादपद्मसंस्पर्शपवित्रा च वसुन्धरा ।\nब्रह्मादिभिरदृष्टा या सर्वदृष्टा च भारते ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002954055, "chapter_id": 22954, "verse_number": "२-१-५६", "content_sanskrit": "स्त्रीरत्नसारसंभूता कृष्णवक्षः स्थलस्थिता ।\nतथा घने नवघने लोला सौदामिनी मुने ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002954056, "chapter_id": 22954, "verse_number": "२-१-५७", "content_sanskrit": "षष्टिवर्षसहस्राणि प्रतप्तं ब्रह्मणा पुरा ।\nयत्पादपद्मनखरदृष्टये चात्मशुद्धये ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002954057, "chapter_id": 22954, "verse_number": "२-१-५८", "content_sanskrit": "स्वप्नेऽपि नैव दृष्टः स्यात्प्रत्यक्षेऽपि च का कथा ।\nतेनैव तपसा दृष्टा भूरि वृन्दावने वने ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002954058, "chapter_id": 22954, "verse_number": "२-१-५९", "content_sanskrit": "कथिता पञ्चमी देवी सा राधा परिकीर्त्तिता ।\nअंशरूपा कलारूपा कलांशांशसमुद्भवा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002954059, "chapter_id": 22954, "verse_number": "२-१-६०", "content_sanskrit": "प्रकृतेः प्रतिविश्वं च रूपं स्यात्सर्वयोषितः ।\nपरिपूर्णतमाः पञ्चविधा देव्यः प्रकीर्त्तिताः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002954060, "chapter_id": 22954, "verse_number": "२-१-६१", "content_sanskrit": "या याः प्रधानांशरूपा वर्णयामि निशामय ।\nप्रधानांशस्वरूपा च गङ्गा भुवनपावनी ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002954061, "chapter_id": 22954, "verse_number": "२-१-६२", "content_sanskrit": "विष्णुपादाब्जसंभूता द्रवरूपा सनातनी ।\nपापिपापेध्मदाहाय ज्वलदिन्धनरूपिणी ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002954062, "chapter_id": 22954, "verse_number": "२-१-६३", "content_sanskrit": "दर्शनस्पर्शनस्नानपानैर्निर्वाणदायिनी ।\nगोलोकस्थानगमनसुसोपानस्वरूपिणी ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002954063, "chapter_id": 22954, "verse_number": "२-१-६४", "content_sanskrit": "पवित्ररूपा तीर्थानां सरितां च परावरा ।\nशम्भुमौलिजटामेरुमुक्तापंक्तिस्वरूपिणी ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002954064, "chapter_id": 22954, "verse_number": "२-१-६५", "content_sanskrit": "तपस्सम्पादिनी सद्यो भारते च तपस्विनाम् ।\nशङ्खपद्मक्षीरनिभा शुद्धसत्त्वस्वरूपिणी ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002954065, "chapter_id": 22954, "verse_number": "२-१-६६", "content_sanskrit": "निर्मला निरहङ्कारा साध्वी नारायणप्रिया ।\nप्रधानांशस्वरूपा च तुलसी विष्णुकामिनी ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002954066, "chapter_id": 22954, "verse_number": "२-१-६७", "content_sanskrit": "विष्णुभूषणरूपा च विष्णुपादस्थिता सती ।\nतपस्सङ्कल्पपूजादिसद्यस्सम्पादिनी मुने ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002954067, "chapter_id": 22954, "verse_number": "२-१-६८", "content_sanskrit": "सारभूता च पुष्पाणां पवित्रा पुण्यदा सदा ।\nदर्शनस्पर्शनाभ्यां   च सद्यो निर्वाणदायिनी ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002954068, "chapter_id": 22954, "verse_number": "२-१-६९", "content_sanskrit": "कलौ कलुषशुष्केध्मदाहनायाग्निरूपिणी ।\nयत्पादपद्मसंस्पर्शात्सद्यः पूता वसुन्धरा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002954069, "chapter_id": 22954, "verse_number": "२-१-७०", "content_sanskrit": "यत्स्पर्शदर्शं वाञ्छन्ति तीर्थानामात्मशुद्धये ।\nयया विना च विश्वेषु सर्वं कर्मास्ति निष्फलम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002954070, "chapter_id": 22954, "verse_number": "२-१-७१", "content_sanskrit": "मोक्षदा या मुमुक्षूणां कामिनां सर्वकामदा ।\nकल्पवृक्षस्वरूपा च भारते वृक्षरूपिणी ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002954071, "chapter_id": 22954, "verse_number": "२-१-७२", "content_sanskrit": "त्राणाय भारतानां च पूजानां परदेवता ।\nप्रधानांशस्वरूपा च मनसा कश्यपात्मजा ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002954072, "chapter_id": 22954, "verse_number": "२-१-७३", "content_sanskrit": "शङ्करप्रियशिष्या च महाज्ञानविशारदा ।\nनागेश्वरस्यानन्तस्य भगिनी नागपूजिता ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002954073, "chapter_id": 22954, "verse_number": "२-१-७४", "content_sanskrit": "नागेश्वरी नागमाता सुन्दरी नागवाहिनी ।\nनागेन्द्रगणयुक्ता सा नागभूषणभूषिता ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002954074, "chapter_id": 22954, "verse_number": "२-१-७५", "content_sanskrit": "नागेन्द्रवन्दिता सिद्धयोगिनी नागवासिनी ।\nविष्णुभक्ता विष्णुरूपा विष्णुपूजापरायणा ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002954075, "chapter_id": 22954, "verse_number": "२-१-७६", "content_sanskrit": "तपःस्वरूपा तपसां फलदात्री तपस्विनी ।\nदिव्यं त्रिलक्षवर्षं च तपस्तप्तं यया हरेः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002954076, "chapter_id": 22954, "verse_number": "२-१-७७", "content_sanskrit": "तपस्विनीषु पूज्या च तपस्विषु च भारते ।\nसर्वमन्त्राधिदेवी च ज्वलन्ती ब्रह्मतेजसा ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002954077, "chapter_id": 22954, "verse_number": "२-१-७८", "content_sanskrit": "ब्रह्मस्वरूपा परमा ब्रह्मभावनतत्परा ।\nजरत्कारुमुनेः पत्नी कृष्णशम्भुपतिव्रता ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002954078, "chapter_id": 22954, "verse_number": "२-१-७९", "content_sanskrit": "आस्तीकस्य मुनेर्माता प्रवरस्य तपस्विनाम् ।\nप्रधानांशस्वरूपा या देवसेना च नारद ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002954079, "chapter_id": 22954, "verse_number": "२-१-८०", "content_sanskrit": "मातृका सा पूज्यतमा सा च षष्ठी प्रकीर्त्तिता ।\nशिशूनां प्रतिविश्वं तु प्रतिपालनकारिणी ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002954080, "chapter_id": 22954, "verse_number": "२-१-८१", "content_sanskrit": "तपस्विनी विष्णुभक्ता कार्त्तिकेयस्य कामिनी ।\nषष्ठांशरूपा प्रकृतेस्तेन षष्ठी प्रकीर्तिता ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002954081, "chapter_id": 22954, "verse_number": "२-१-८२", "content_sanskrit": "पुत्रपौत्रप्रदात्री च धात्री च जगतां सदा ।\nसुन्दरी युवती रम्या सततं भर्तुरन्तिके ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002954082, "chapter_id": 22954, "verse_number": "२-१-८३", "content_sanskrit": "स्थाने शिशूनां परमा वृद्धरूपा च योगिनी ।\nपूजा  द्वादशमासेषु यस्याः षष्ठ्यास्तु सन्ततम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002954083, "chapter_id": 22954, "verse_number": "२-१-८४", "content_sanskrit": "पूजा च सूतिकागारे परषष्ठदिने शिशोः ।\nएकविंशतिमे चैव पूजा कल्याणहेतुकी ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7002954084, "chapter_id": 22954, "verse_number": "२-१-८५", "content_sanskrit": "शश्वन्नियमिता चैषा नित्या काम्याऽप्यतः परा ।\nमातृरूपा दयारूपा शश्वद्रक्षणकारिणी ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7002954085, "chapter_id": 22954, "verse_number": "२-१-८६", "content_sanskrit": "जले स्थले चान्तरिक्षे शिशूनां स्वप्नगोचरा ।\nप्रधानांशस्वरूपा या देवी मङ्गलचण्डिका ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7002954086, "chapter_id": 22954, "verse_number": "२-१-८७", "content_sanskrit": "प्रकृतेर्मुखसंभूता सर्वमङ्गलदा सदा ।\nसृष्टौ मङ्गलरूपा च संहारे कोपरूपिणी ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7002954087, "chapter_id": 22954, "verse_number": "२-१-८८", "content_sanskrit": "तेन मङ्गलचण्डी सा पण्डितैः परिकीर्त्तिता ।\nप्रतिमङ्गलवारेषु प्रतिविश्वेषु पूजिता ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7002954088, "chapter_id": 22954, "verse_number": "२-१-८९", "content_sanskrit": "पञ्चोपचारैर्भक्त्या च योषिद्भिः परिपूजिता ।\nपुत्रपौत्रधनैश्वर्य्ययशोमङ्गलदायिनी ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7002954089, "chapter_id": 22954, "verse_number": "२-१-९०", "content_sanskrit": "शोक सन्तापपापार्त्तिदुःखदारिद्र्यनाशिनी ।\nपरितुष्टा सर्ववाच्छाप्रदात्री सर्वयोषिताम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7002954090, "chapter_id": 22954, "verse_number": "२-१-९१", "content_sanskrit": "रुष्टा क्षणेन संहर्तुं शक्ता विश्वं महेश्वरी ।\nप्रधानांशस्वरूपा च काली कमललोचना ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7002954091, "chapter_id": 22954, "verse_number": "२-१-९२", "content_sanskrit": "दुर्गाललाटसंभूता रणे शुम्भनिशुम्भयोः ।\nदुर्गार्द्धांशस्वरूपा स्याद्गुणैस्सा तेजसा समा ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7002954092, "chapter_id": 22954, "verse_number": "२-१-९३", "content_sanskrit": "कोटिसूर्य्यप्रभाजुष्टदिव्यसुन्दरविग्रहा ।\nप्रधाना सर्वशक्तीनां वरा बलवती परा ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7002954093, "chapter_id": 22954, "verse_number": "२-१-९४", "content_sanskrit": "सर्वसिद्धिप्रदा देवी परमा सिद्धियोगिनी ।\nकृष्णभक्ता कृष्णतुल्या तेजसा विक्रमैर्गुणैः ।\nकृष्णभावनया शश्वत्कृष्णवर्णा सनातनी ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7002954094, "chapter_id": 22954, "verse_number": "२-१-९५", "content_sanskrit": "ब्रह्माण्डं सकलं हर्तुं शक्ता निःश्वासमात्रतः ।\nरणं दैत्यैः समं तस्याः क्रीडया लोकरक्षया ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7002954095, "chapter_id": 22954, "verse_number": "२-१-९६", "content_sanskrit": "धर्मार्थकाममोक्षांश्च दातुं शक्ता सुपूजिता ।\nब्रह्मादिभिः स्तूयमाना मुनिभिर्मनुभिर्नरैः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7002954096, "chapter_id": 22954, "verse_number": "२-१-९७", "content_sanskrit": "प्रधानांशस्वरूपा च प्रकृतिश्च वसुन्धरा ।\nआधारभूता सर्वेषां सर्वसस्यप्रसूतिका ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7002954097, "chapter_id": 22954, "verse_number": "२-१-९८", "content_sanskrit": "रत्नाकारा रत्नगर्भा सर्वरत्नाकराश्रया ।\nप्रजादिभिः प्रजेशैश्च पूजिता वन्दिता सदा ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7002954098, "chapter_id": 22954, "verse_number": "२-१-९९", "content_sanskrit": "सर्वोपजीव्यरूपा च सर्वसम्पद्विधायिनी ।\nयया विना जगत्सर्वं निराधारं चराचरम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7002954099, "chapter_id": 22954, "verse_number": "२-१-१००", "content_sanskrit": "प्रकृतेश्च कला या यास्ता निबोध मुनीश्वर ।\nयस्य यस्य च याः पत्न्यस्ताः सर्वा वर्णयामि ते ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7002954100, "chapter_id": 22954, "verse_number": "२-१-१०१", "content_sanskrit": "स्वाहादेवी वह्निपत्नी त्रिषु लोकेषु पूजिता ।\nयया विना हविर्दत्तं न ग्रहीतुं सुराः क्षमाः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7002954101, "chapter_id": 22954, "verse_number": "२-१-१०२", "content_sanskrit": "दक्षिणा यज्ञपत्नी च दीक्षा सर्वत्र पूजिता ।\nयया विना च विश्वेषु सर्वं कर्म च निष्फलम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7002954102, "chapter_id": 22954, "verse_number": "२-१-१०३", "content_sanskrit": "स्वधा पितॄणां पत्नी च मुनिभिर्मनुभिर्नरैः ।\nपूजिता पैतृकं दानं निष्फलं च यया विना ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7002954103, "chapter_id": 22954, "verse_number": "२-१-१०४", "content_sanskrit": "स्वस्तिदेवी वायुपत्नी प्रति विश्वेषु पूजिता ।\nआदानं च प्रदानं च निष्फलं च यया विना ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7002954104, "chapter_id": 22954, "verse_number": "२-१-१०५", "content_sanskrit": "पुष्टिर्गणपतेः पत्नी पूजिता जगतीतले ।\nयया विना परिक्षीणाः पुमांसो योषितोऽपि च ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7002954105, "chapter_id": 22954, "verse_number": "२-१-१०६", "content_sanskrit": "अनन्तपत्नी तुष्टिश्च पूजिता वन्दिता सदा ।\nयया विना न सन्तुष्टाः सर्वे लोकाश्च सर्वतः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7002954106, "chapter_id": 22954, "verse_number": "२-१-१०७", "content_sanskrit": "ईशानपत्नी सम्पत्तिः पूजिता च सुरैर्नरैः ।\nसर्वे लोका दरिद्राश्च विश्वेषु च यया विना ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7002954107, "chapter_id": 22954, "verse_number": "२-१-१०८", "content_sanskrit": "धृतिः कपिलपत्नी च सर्वैः सर्वत्र पूजिता ।\nसर्वे लोका अधीरास्स्युर्जगत्सु च यया विना ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7002954108, "chapter_id": 22954, "verse_number": "२-१-१०९", "content_sanskrit": "यमपत्नी क्षमा साध्वी सुशीला सर्वपूजिता ।\nसमुन्मत्ताश्च रुद्राश्च सर्वे लोका यया विना ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7002954109, "chapter_id": 22954, "verse_number": "२-१-११०", "content_sanskrit": "क्रीडाधिष्ठातृदेवी सा कामपत्नी रतिः सती ।\nकेलिकौतुकहीनाश्च सर्वे लोका यया विना ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7002954110, "chapter_id": 22954, "verse_number": "२-१-१११", "content_sanskrit": "सत्यपत्नी सती मुक्तिः पूजिता जगतां प्रिया ।\nयया विना भवेल्लोको बन्धुतारहितः सदा ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7002954111, "chapter_id": 22954, "verse_number": "२-१-११२", "content_sanskrit": "मोहपत्नी दया साध्वी पूजिता च जगत्प्रिया ।\nसर्वे लोकाश्च सर्वत्र निष्ठुराश्च यया विना ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7002954112, "chapter_id": 22954, "verse_number": "२-१-११३", "content_sanskrit": "पुण्यपत्नी प्रतिष्ठा सा पुण्यरूपा च पूजिता ।\nयया विना जगत्सर्वं जीवन्मृतसमं मुने ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7002954113, "chapter_id": 22954, "verse_number": "२-१-११४", "content_sanskrit": "सुकर्मपत्नी कीर्तिश्च धन्या मान्या च पूजिता ।\nयया विना जगत्सर्वं यशोहीनं मृतं यथा ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7002954114, "chapter_id": 22954, "verse_number": "२-१-११५", "content_sanskrit": "क्रिया उद्योगपत्नी च पूजिता सर्वसङ्गता ।\nयया विना जगत्सर्वमुच्छिन्नमिव नारद ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7002954115, "chapter_id": 22954, "verse_number": "२-१-११६", "content_sanskrit": "अधर्मपत्नी मिथ्या सा सर्वधूर्तैश्च पूजिता ।\nयया विना जगत्सर्वमुच्छिन्नं विधिनिर्मितम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7002954116, "chapter_id": 22954, "verse_number": "२-१-११७", "content_sanskrit": "सत्ये अदर्शना या च त्रेतायां सूक्ष्मरूपिणी ।\nअर्द्धावयवरूपा च द्वापरे संहृता ह्रिया ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7002954117, "chapter_id": 22954, "verse_number": "२-१-११८", "content_sanskrit": "कलौ महाप्रगल्भा च सर्वत्र व्याप्तिकारणात् ।\nकपटेन सह भ्रात्रा भ्रमत्येव गृहे गृहे ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7002954118, "chapter_id": 22954, "verse_number": "२-१-११९", "content_sanskrit": "शान्तिर्लज्जा च भार्ये द्वे सुशीलस्य च पूजिते ।\nयस्यां विना जगत्सर्वमुन्मत्तमिव नारद ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7002954119, "chapter_id": 22954, "verse_number": "२-१-१२०", "content_sanskrit": "ज्ञानस्य तिस्रो भार्याश्च बुद्धिर्मेधा स्मृतिस्तथा ।\nयाभिर्विना जगत्सर्वं मूढं मृतसमं सदा ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7002954120, "chapter_id": 22954, "verse_number": "२-१-१२१", "content_sanskrit": "मूर्त्तिश्च धर्मपत्नी सा कान्तिरूपा मनोहरा ।\nपरमात्मा च विश्वौघा निराधारा यया विना ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7002954121, "chapter_id": 22954, "verse_number": "२-१-१२२", "content_sanskrit": "सर्वत्र शोभारूपा च लक्ष्मीर्मूर्तिमती सती ।\nश्रीरूपा मूर्तिरूपा च मान्या धन्या च पूजिता ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7002954122, "chapter_id": 22954, "verse_number": "२-१-१२३", "content_sanskrit": "कालाग्निरुद्रपत्नी च निद्रा या सिद्धयोगिनाम् ।\nसर्वलोकाः समाच्छन्ना मायायोगेन रात्रिषु ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7002954123, "chapter_id": 22954, "verse_number": "२-१-१२४", "content_sanskrit": "कालस्य तिस्रो भार्य्याश्च सन्ध्या रात्रिर्दिनानि च ।\nयाभिर्विना विधात्रा च संख्यां कर्तुं न शक्यते ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7002954124, "chapter_id": 22954, "verse_number": "२-१-१२५", "content_sanskrit": "क्षुत्पिपासे लोभभार्य्ये धन्ये मान्ये च पूजिते ।\nयाभ्यां व्याप्तं जगत्क्षोभयुक्तं चिन्तितमेव च॥ ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7002954125, "chapter_id": 22954, "verse_number": "२-१-१२६", "content_sanskrit": "प्रभा च दाहिका चैव द्वे भार्ये तेजसस्तथा ।\nयाभ्यां विना जगत्स्रष्टुं विधाता च न हीश्वरः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7002954126, "chapter_id": 22954, "verse_number": "२-१-१२७", "content_sanskrit": "कालकन्ये मृत्युजरे प्रज्वरस्य प्रिये प्रिये ।\nयस्यां जगत्समुच्छिन्नं विधात्रा निर्मिते विधौ ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7002954127, "chapter_id": 22954, "verse_number": "२-१-१२८", "content_sanskrit": "निद्राकन्या च तन्द्रा सा प्रीतिरन्या सुखप्रिये ।\nयाभ्यां व्याप्तं जगत्सर्वं विधिपुत्र विधेर्विधौ ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7002954128, "chapter_id": 22954, "verse_number": "२-१-१२९", "content_sanskrit": "वैराग्यस्य च द्वे भार्ये श्रद्धा भक्तिश्च पूजिते ।\nयाभ्यां शश्वज्जगत्सर्वं जीवन्मुक्तमिदं मुने ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7002954129, "chapter_id": 22954, "verse_number": "२-१-१३०", "content_sanskrit": "अदितिर्देवमाता च सुरभिश्च गवां प्रसूः ।\nदितिश्च दैत्यजननी कद्रूश्च विनता दनुः ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7002954130, "chapter_id": 22954, "verse_number": "२-१-१३१", "content_sanskrit": "उपयुक्ताः सृष्टिविधावेताश्च प्रकृतेः कलाः ।\nकलाश्चान्याः सन्ति बह्व्यस्तासु काश्चिन्निबोध मे॥ ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7002954131, "chapter_id": 22954, "verse_number": "२-१-१३२", "content_sanskrit": "रोहिणी चन्द्रपत्नी च संज्ञा सूर्यस्य कामिनी ।\nशतरूपा मनोर्भार्या शचीन्द्रस्य च गेहिनी ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7002954132, "chapter_id": 22954, "verse_number": "२-१-१३३", "content_sanskrit": "तारा बृहस्पतेर्भार्य्या वसिष्ठस्याप्यरुन्धती ।\nअहल्या गौतमस्त्री स्यादनसूयाऽत्रिकामिनी ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7002954133, "chapter_id": 22954, "verse_number": "२-१-१३४", "content_sanskrit": "देवहूतिः कर्दमस्य प्रसूतिर्दक्षकामिनी ।\nपितॄणां मानसी कन्या मेनका साऽम्बिकाप्रसूः ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7002954134, "chapter_id": 22954, "verse_number": "२-१-१३५", "content_sanskrit": "लोपामुद्रा तथा हूतिः कुबेरस्य तु कामिनी ।\nवरुणानी यमस्त्री च बलेर्विन्ध्यावलीति च ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7002954135, "chapter_id": 22954, "verse_number": "२-१-१३६", "content_sanskrit": "कुन्ती च दमयन्ती च यशोदा देवकी सती ।\nगान्धारी द्रौपदी सव्या सावित्री सत्यवत्प्रिया॥ ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7002954136, "chapter_id": 22954, "verse_number": "२-१-१३७", "content_sanskrit": "वृषभानुप्रिया साध्वी राधामाता कलावती ।\nमन्दोदरी च कौसल्या सुभद्रा कैकयी तथा ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7002954137, "chapter_id": 22954, "verse_number": "२-१-१३८", "content_sanskrit": "रेवती सत्यभामा च कालिन्दी लक्ष्मणा तथा ।\nमित्रविन्दा नाग्नजिती तथा जाम्बवती परा ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7002954138, "chapter_id": 22954, "verse_number": "२-१-१३९", "content_sanskrit": "लक्ष्मणा रुक्मिणी सीता स्वयं लक्ष्मीः प्रकीर्तिता ।\nकला योजनगन्धा च व्यासमाता महासती ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7002954139, "chapter_id": 22954, "verse_number": "२-१-१४०", "content_sanskrit": "बाणपुत्री तथोषा च चित्रलेखा च तत्सखी ।\nप्रभावती भानुमती तथा मायावती सती ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7002954140, "chapter_id": 22954, "verse_number": "२-१-१४१", "content_sanskrit": "रेणुका च भृगोर्माता हलिमाता च रोहिणी ।\nएकानंशा च दुर्गा सा श्रीकृष्णभगिनी सती ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7002954141, "chapter_id": 22954, "verse_number": "२-१-१४२", "content_sanskrit": "बह्व्यः सन्ति कलाश्चैवं प्रकृतेरेव भारते ।\nया याश्च ग्रामदेव्यस्ताः सर्वाश्च प्रकृतेः कलाः ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7002954142, "chapter_id": 22954, "verse_number": "२-१-१४३", "content_sanskrit": "कलांशांशसमुद्भूताः प्रतिविश्वेषु योषितः ।\nयोषितामपमानेन प्रकृतेश्च पराभवः ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7002954143, "chapter_id": 22954, "verse_number": "२-१-१४४", "content_sanskrit": "ब्राह्मणी पूजिता येन पतिपुत्रवती सती ।\nप्रकृतिः पूजिता तेन वस्त्रालङ्कारचन्दनैः ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7002954144, "chapter_id": 22954, "verse_number": "२-१-१४५", "content_sanskrit": "कुमारी चाष्टवर्षीया वस्त्रालङ्कारचन्दनैः ।\nपूजिता येन विप्रस्य प्रकृतिस्तेन पूजिता ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7002954145, "chapter_id": 22954, "verse_number": "२-१-१४६", "content_sanskrit": "सर्वाः प्रकृतिसम्भूता उत्तमाधममध्यमाः ।\nसत्त्वांशाश्चोत्तमा ज्ञेयाः सुशीलाश्च पतिव्रताः ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7002954146, "chapter_id": 22954, "verse_number": "२-१-१४७", "content_sanskrit": "मध्यमा रजसश्चांशास्ताश्च भोग्याः प्रकीर्त्तिताः ।\nसुखसम्भोगवत्यश्च स्वकार्ये तत्पराः सदा ॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7002954147, "chapter_id": 22954, "verse_number": "२-१-१४८", "content_sanskrit": "अधमास्तमसश्चांशा अज्ञातकुलसम्भवाः ।\nदुर्मुखाः कुलटा धूर्त्ताः स्वतन्त्राः कलहप्रियाः ॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7002954148, "chapter_id": 22954, "verse_number": "२-१-१४९", "content_sanskrit": "पृथिव्यां कुलटा याश्च स्वर्गे चाप्सरसां गणाः ।\nप्रकृतेस्तमसश्चांशाः पुंश्चल्यः परिकीर्त्तिताः ॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7002954149, "chapter_id": 22954, "verse_number": "२-१-१५०", "content_sanskrit": "एवं निगदितं सर्वं प्रकृतेर्भेदपञ्चकम् ।\nताः सर्वाः पूजिताः पृथ्व्यां पुण्यक्षेत्रे च भारते ॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 7002954150, "chapter_id": 22954, "verse_number": "२-१-१५१", "content_sanskrit": "पूजिता सुरथेनादौ दुर्गा दुर्गार्तिनाशिनी ।\nद्वितीया रामचन्द्रेण रावणस्य वधार्थिना ॥१५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 7002954151, "chapter_id": 22954, "verse_number": "२-१-१५२", "content_sanskrit": "तत्पश्चाज्जगतां माता त्रिषु लोकेषु पूजिता ।\nजाताऽऽदौ दक्षपत्न्यां च निहन्तुं दैत्यदानवान् ॥१५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 7002954152, "chapter_id": 22954, "verse_number": "२-१-१५३", "content_sanskrit": "ततो देहं परित्यज्य यज्ञे भर्तुश्च निन्दया ।\nजज्ञे हिमवतः पत्न्यां लेभे पशुपतिं पतिम् ॥१५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 7002954153, "chapter_id": 22954, "verse_number": "२-१-१५४", "content_sanskrit": "गणेशश्च स्वयं कृष्णः स्कन्दो विष्णुकलोद्भवः ।\nबभूवतुस्तौ तनयौ पश्चात्तस्याश्च नारद ॥१५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}, {"id": 7002954154, "chapter_id": 22954, "verse_number": "२-१-१५५", "content_sanskrit": "लक्ष्मीर्मङ्गलभूपेन प्रथमे परिपूजिता ।\nत्रिषु लोकेषु तत्पश्चाद्देवतामुनिमानवैः ॥१५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 155}, {"id": 7002954155, "chapter_id": 22954, "verse_number": "२-१-१५६", "content_sanskrit": "सावित्री प्रथमं चापि भक्त्या वै परिपूजिता ।\nतत्पश्चात्त्रिषु लोकेषु देवतामुनिमानवैः ॥१५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 156}, {"id": 7002954156, "chapter_id": 22954, "verse_number": "२-१-१५७", "content_sanskrit": "आदौ सरस्वती देवी ब्रह्मणा परिपूजिता ।\nतत्पश्चात्त्रिषु लोकेषु देवतामुनिमानवैः ॥१५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 157}, {"id": 7002954157, "chapter_id": 22954, "verse_number": "२-१-१५८", "content_sanskrit": "प्रथमं पूजिता राधा गोलोके रासमण्डले ।\nपौर्णमास्यां कार्त्तिकस्य कृष्णेन परमात्मना ॥१५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 158}, {"id": 7002954158, "chapter_id": 22954, "verse_number": "२-१-१५९", "content_sanskrit": "गोपिकाभिश्च गोपैश्च बालिकाभिश्च बालकैः ।\nगवां गणैः सुरगणैस्तत्पश्चान्मायया हरेः ॥१९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 159}, {"id": 7002954159, "chapter_id": 22954, "verse_number": "२-१-१६०", "content_sanskrit": "तदा ब्रह्मादिभिर्देवैर्मुनिभिर्मनुभिस्तथ ।\nपुष्पधूपादिभिर्भक्त्या  पूजिता वन्दिता सदा ॥१६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 160}, {"id": 7002954160, "chapter_id": 22954, "verse_number": "२-१-१६१", "content_sanskrit": "पृथिव्यां प्रथमे देवी सुयज्ञेन च पूजिता ।\nशङ्करेणोपदिष्टेन पुण्यक्षेत्रे च भारते ॥१६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 161}, {"id": 7002954161, "chapter_id": 22954, "verse_number": "२-१-१६२", "content_sanskrit": "त्रिषु लोकेषु तत्पश्चादाज्ञया परमात्मनः ।\nपुष्पधूपादिभिर्भक्त्या पूजिता मुनिभिः सुरैः॥ ॥१६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 162}, {"id": 7002954162, "chapter_id": 22954, "verse_number": "२-१-१६३", "content_sanskrit": "कला या याः सुसंभूताः पूजितास्ताश्च भारते ।\nपूजिता ग्रामदेव्यश्च ग्रामे च नगरे मुने ॥१६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 163}, {"id": 7002954163, "chapter_id": 22954, "verse_number": "२-१-१६४", "content_sanskrit": "एवं ते कथितं सर्वं प्रकृतेश्चरितं शुभम् ।\nयथागमं लक्षणञ्च किं भूयः श्रोतुमिच्छसि ॥१६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 164}]