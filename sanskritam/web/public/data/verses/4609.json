[{"id": 2168226, "chapter_id": 4609, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2168227, "chapter_id": 4609, "verse_number": "१", "content_sanskrit": "अतितीव्राणि दुःखानि दुःसहानि बहूनि च ।\nत्वत्तोऽहं सञ्जयाश्रौषं पुत्राणां चैव सङ्क्षयम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2168228, "chapter_id": 4609, "verse_number": "२", "content_sanskrit": "यथा त्वं मे कथयसे यथा युद्धमवर्तत ।\nन सन्ति सूत कौरव्या इति मे निश्चिता मतिः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2168229, "chapter_id": 4609, "verse_number": "३", "content_sanskrit": "दुर्योधनश्च विरथः कृतस्तत्र महारथः ।\nधर्मपुत्रः कथं चक्रे तस्य वा नृपतिः कथम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2168230, "chapter_id": 4609, "verse_number": "४", "content_sanskrit": "अपराह्णे कथं युद्धमभवद् रोमहर्षणम् ।\nतन्ममाचक्ष्व तत्त्वेन कुशलो ह्यसि सञ्जय\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2168231, "chapter_id": 4609, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2168232, "chapter_id": 4609, "verse_number": "५", "content_sanskrit": "संसक्तेषु तु सैन्येषु वध्यमानेषु भागशः ।\nरथमन्यं समास्थाय पुत्रस्तव विशाम्पते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2168233, "chapter_id": 4609, "verse_number": "६", "content_sanskrit": "क्रोधेन महता युक्तः सविषो भुजगो यथा ।\nदुर्योधनः समालक्ष्य धर्मराजं युधिष्ठिरम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2168234, "chapter_id": 4609, "verse_number": "७", "content_sanskrit": "प्रोवाच सूतं त्वरितो याहि याहीति भारत\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2168235, "chapter_id": 4609, "verse_number": "८", "content_sanskrit": "तत्र मां प्रापय क्षिप्रं सारथे यत्र पाण्डवः ।\nध्रियमाणातपत्रेण राजा राजति दंसितः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2168236, "chapter_id": 4609, "verse_number": "९", "content_sanskrit": "स सूतश्चोदितो राज्ञा राज्ञः स्यन्दनमुत्तमम् ।\nयुधिष्ठिरस्याभिमुखं प्रेषयामास संयुगे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2168237, "chapter_id": 4609, "verse_number": "१०", "content_sanskrit": "ततो युधिष्ठिरः क्रुद्धः प्रभिन्न इव कुञ्जरः ।\nसारथिं चोदयामास याहि यत्र सुयोधनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2168238, "chapter_id": 4609, "verse_number": "११", "content_sanskrit": "तौ समाजग्मतुर्वीरौ भ्रातरौ रथसत्तमौ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2168239, "chapter_id": 4609, "verse_number": "१२", "content_sanskrit": "समेत्य च महावीरौ संरब्धौ युद्धदुर्मदौ ।\nववर्षतुर्महेष्वासौ शरैरन्योन्यमाहवे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2168240, "chapter_id": 4609, "verse_number": "१३", "content_sanskrit": "ततो दुर्योधनो राजा धर्मशीलस्य मारिष ।\nशिलाशितेन भल्लेन धनुश्चिच्छेद संयुगे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2168241, "chapter_id": 4609, "verse_number": "१४", "content_sanskrit": "तं नामृष्यत सङ्क्रुद्धो ह्यवमानं युधिष्ठिरः ।\nअपविध्य धनुश्छिन्नं क्रोधसंरक्तलोचनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2168242, "chapter_id": 4609, "verse_number": "१५", "content_sanskrit": "अन्यत्कार्मुकमादाय धर्मपुत्रश्चमूमुखे ।\nदुर्योधनस्य चिच्छेद ध्वजं कार्मुकमेव च\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2168243, "chapter_id": 4609, "verse_number": "१६", "content_sanskrit": "अथान्यद्धनुरादाय पुत्रस्ते भरतर्षभ ।\n(युधिष्ठिरस्य चिक्षेप शरान् कनकभूषणान्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2168244, "chapter_id": 4609, "verse_number": "", "content_sanskrit": "रुग्मपुङ्खान् प्रसन्नाग्रान् सविषानिव पन्नगान्\t॥१७॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2168245, "chapter_id": 4609, "verse_number": "१८", "content_sanskrit": "तावन्योन्यं सुसङ्क्रुद्धौ शस्त्रवर्षाण्यमुञ्चताम् ।\nसिंहाविव सुसरंब्धौ परस्परजिगीषया\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2168246, "chapter_id": 4609, "verse_number": "१९", "content_sanskrit": "जघ्नतुस्तौ रणेऽन्योन्यं नर्दमानौ वृषाविव ।\nअन्तरं मार्गमाणौ च चेरतुस्तौ महारथौ\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2168247, "chapter_id": 4609, "verse_number": "२०", "content_sanskrit": "अन्तरं नागमत् तत्र राजा न(स) सुयोधनः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2168248, "chapter_id": 4609, "verse_number": "२१", "content_sanskrit": "ततः पूर्णायतोत्सृष्टैः शरैस्तौ तु कृतव्रणौ ।\nविरेजतुर्महाराज पुष्पितौ किंशुकाविव\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2168249, "chapter_id": 4609, "verse_number": "२२", "content_sanskrit": "ततो राजन् विमुञ्चन्तौ सिंहनादान् मुहुर्मुहुः ।\nतळयोश्च यथा शब्दान् धनुषश्च महाहवे\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2168250, "chapter_id": 4609, "verse_number": "२३", "content_sanskrit": "शङ्खशब्दवरांश्चैव चक्रतुस्तौ नरेश्वरौ ।\nअन्योन्यं तौ महाराज पीडयाञ्चक्रतुर्भृशम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2168251, "chapter_id": 4609, "verse_number": "२४", "content_sanskrit": "ततो युधिष्ठिरो राजा पुत्रं तव शरैस्त्रिभिः ।\nआजघानोरसि क्रुद्धो वज्रवेगैर्दुरासदैः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2168252, "chapter_id": 4609, "verse_number": "२५", "content_sanskrit": "प्रतिविव्याध तं तूर्णं तव पुत्रो महीपते ।\nपञ्चभिर्निशितैर्बाणैः स्वर्णपुङ्खैः शिलाशितैः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2168253, "chapter_id": 4609, "verse_number": "२६", "content_sanskrit": "ततो दुर्योधनो राजा शक्तिं चिक्षेप भारत ।\nसर्वपारशवीं तीक्ष्णां महोल्काप्रतिमां तदा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2168254, "chapter_id": 4609, "verse_number": "२७", "content_sanskrit": "तामापतन्तीं सहसा धर्मराजः शितैः शरैः ।\nत्रिभिश्चिच्छेद सहसा तं च विव्याध पञ्चभिः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2168255, "chapter_id": 4609, "verse_number": "२८", "content_sanskrit": "निपपात ततः साऽथ स्वर्णदण्डा महास्वना ।\nनिपतन्ती महोल्केव व्यराजच्छिखिसन्निभा\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2168256, "chapter_id": 4609, "verse_number": "२९", "content_sanskrit": "शक्तिं विनिहतां दृष्ट्वा पुत्रस्तव विशाम्पते ।\nनवभिर्निशितैर्भल्लैर्निजघान युधिष्ठिरम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2168257, "chapter_id": 4609, "verse_number": "३०", "content_sanskrit": "सोऽतिविद्धो बलवता शत्रुणा शत्रुतापनः ।\nदुर्योधनं समुद्दिश्य बाणं जग्राह सत्वरः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2168258, "chapter_id": 4609, "verse_number": "३१", "content_sanskrit": "समाधत्त च तं बाणं धनुर्मध्ये महाबलः ।\nचिक्षेप च महाराज ततः क्रुद्धः पराक्रमी\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2168259, "chapter_id": 4609, "verse_number": "३२", "content_sanskrit": "स तु बाणः समासाद्य तव पुत्रं महारथम् ।\nव्यामोहयत राजानं धरणीं च ददार ह\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2168260, "chapter_id": 4609, "verse_number": "३३", "content_sanskrit": "ततो दुर्योधनः क्रुद्धो गदामुद्यम्य वेगितः ।\nविधित्सुः कलहस्यान्तं धर्मराजमुपाद्रवत्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2168261, "chapter_id": 4609, "verse_number": "३४", "content_sanskrit": "तमुद्यतगदं दृष्ट्वा दण्डहस्तमिवान्तकम् ।\nधर्मराजो महाशक्तिं प्राहिणोत्तव सूनवे\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2168262, "chapter_id": 4609, "verse_number": "३५", "content_sanskrit": "दीप्यमानां महावेगां महोल्कां ज्वलितामिव ।\nयमदण्डनिभां घोरां कालरात्रिमिवापराम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2168263, "chapter_id": 4609, "verse_number": "३६", "content_sanskrit": "रथस्थः स तया विद्धो वर्म भित्त्वा स्तनान्तरे ।\nभृशं संविग्नहृदयः पपात च मुमोह च\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2168264, "chapter_id": 4609, "verse_number": "३७", "content_sanskrit": "भीमस्तमाह च ततः प्रतिज्ञामनुपालय ।\nनायं वध्यस्तव नृप इत्युक्तः स न्यवर्तत\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2168265, "chapter_id": 4609, "verse_number": "३८", "content_sanskrit": "ततस्त्वरितमागम्य कृतवर्मा तवात्मजम् ।\nप्रत्यपद्यत राजानं निमग्नं व्यसनार्णवे\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2168266, "chapter_id": 4609, "verse_number": "३९", "content_sanskrit": "गदामादाय भीमोऽपि हेमपट्टपरिष्कृताम् ।\nअभिदुद्राव वेगेन कृतवर्माणमाहवे\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2168267, "chapter_id": 4609, "verse_number": "४०", "content_sanskrit": "एवं तदभवद् युद्धं त्वदीयानां परैः सह \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2168268, "chapter_id": 4609, "verse_number": "४१", "content_sanskrit": "अपराह्णे महाराज काङ्क्षतां विजयं युधि\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2168269, "chapter_id": 4609, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nएकोनत्रिंशोऽध्यायः ॥२९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]