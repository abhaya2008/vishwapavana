[{"id": 50012988, "chapter_id": 11503, "verse_number": "1", "content_sanskrit": "नारद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50012989, "chapter_id": 11503, "verse_number": "2", "content_sanskrit": "पौरोहित्याय भगवान् वृतः काव्यो महासुरैः। शण्डामर्कौ सुतौ तस्य दैत्यराजगृहान्तिके॥ ७/५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50012990, "chapter_id": 11503, "verse_number": "3", "content_sanskrit": "तौ राज्ञा प्रापितं बालं प्रह्लादं नयकोविदम्। पाठयामासतुः पाठ्यानन्यांश्चासुरबालकान्॥ ७/५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50012991, "chapter_id": 11503, "verse_number": "4", "content_sanskrit": "यत् तत्र गुरुणा प्रोक्तं शुश्रुवे न पपाठ ह। न साधु मनसा मेने स्वरूपासद्ग्रहाश्रयम्॥ ७/५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50012992, "chapter_id": 11503, "verse_number": "5", "content_sanskrit": "एकदाऽसुरराट् पुत्रमङ्कमारोप्य लाळयन्। पप्रच्छ कथ्यतां वत्स मन्यते साधु यद् भवान्॥ ७/५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50012993, "chapter_id": 11503, "verse_number": "6", "content_sanskrit": "प्रह्लाद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50012994, "chapter_id": 11503, "verse_number": "7", "content_sanskrit": "तत् साधु मन्येऽसुरवर्य देहिनां सदा समुद्विग्नधियामसद्ग्रहात्। हित्वाऽऽत्मपातं गृहमन्धकूपं वनं गतो यद्धरिमाश्रयेत॥ ७/५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50012995, "chapter_id": 11503, "verse_number": "8", "content_sanskrit": "नारद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50012996, "chapter_id": 11503, "verse_number": "9", "content_sanskrit": "श्रुत्वा पुत्रगिरो दैत्यः परपक्षसमीहिताः। जहास बुद्धिर्बालानां भिद्यते परबुद्धिभिः॥ ७/५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50012997, "chapter_id": 11503, "verse_number": "10", "content_sanskrit": "सम्यग् विधार्यतां बालो गुरुगेहे द्विजातिभिः। विष्णुपक्षप्रतिच्छन्नैर्भिद्यते नास्य धीर्यथा॥ ७/५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50012998, "chapter_id": 11503, "verse_number": "11", "content_sanskrit": "गृहमागतमाहूय प्रह्लादं दैत्ययाजकाः। प्रशस्य श्लक्ष्णया वाचा समपृच्छन्त सामभिः॥ ७/५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50012999, "chapter_id": 11503, "verse_number": "12", "content_sanskrit": "वत्स प्रह्लाद भद्रं ते सत्यं कथय मा मृषा। बालानति कुतस्तुभ्यमेष बुद्धिविपर्ययः॥ ७/५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50013000, "chapter_id": 11503, "verse_number": "13", "content_sanskrit": "बुद्धिभेदः परकृत उताहो ते स्वतोऽभवत्। भण्यतां श्रोतुकामानां गुरूणां कुलनन्दन॥ ७/५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50013001, "chapter_id": 11503, "verse_number": "14", "content_sanskrit": "प्रह्लाद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50013002, "chapter_id": 11503, "verse_number": "15", "content_sanskrit": "परः स्वात्मेत्यसद्ग्राहः पुंसां यन्मायया कृतः। विमोहितधियां दृष्टस्तस्मै भगवते नमः॥ ७/५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50013003, "chapter_id": 11503, "verse_number": "16", "content_sanskrit": "स यदाऽनुगतः पुंसां पशुबुद्धिर्विभिद्यते। अन्य एष तथाऽन्योऽहमिति देहगताऽसती॥ ७/५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50013004, "chapter_id": 11503, "verse_number": "17", "content_sanskrit": "स एष आत्मा स्वपरेत्यबुद्धिभिर्दुरन्वयानुक्रमणो निरुच्यते। मुह्यन्ति यर्द्वत्मनि वेदवादिनो ब्रह्मादयो ह्येष भिनत्ति मे मतिम्॥ ७/५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50013005, "chapter_id": 11503, "verse_number": "18", "content_sanskrit": "यथा भ्राम्यत्ययो ब्रह्मन् स्वयमाकर्षसन्निधौ। तथा मे भिद्यते चेतश्चक्रपाणौ यदृच्छया॥ ७/५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50013006, "chapter_id": 11503, "verse_number": "19", "content_sanskrit": "नारद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50013007, "chapter_id": 11503, "verse_number": "20", "content_sanskrit": "एतावद् ब्राह्मणायोक्त्वा विरराम महामतिः। तं सन्निर्भत्स्य कुपितः सुदीनो राजसेवकः॥ ७/५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50013008, "chapter_id": 11503, "verse_number": "21", "content_sanskrit": "आनीयतामरे वेत्रमस्माकमयशस्कृतः। कुलाङ्गारस्य दुर्बुद्धेश्चतुर्थोऽस्योदितो दमः॥ ७/५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50013009, "chapter_id": 11503, "verse_number": "22", "content_sanskrit": "दैतेयचन्दनवने जातोऽयं कण्टकद्रुमः। तन्मूलोन्मूलपरशोर्विष्णोर्नाळायितोऽर्भकः॥ ७/५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50013010, "chapter_id": 11503, "verse_number": "23", "content_sanskrit": "इति तं विविधोपायैर्भीषयन् तर्जनादिभिः। प्रह्लादं ग्राहयामास त्रिवर्गस्योपपादनम्॥ ७/५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50013011, "chapter_id": 11503, "verse_number": "24", "content_sanskrit": "तत एनं गुरुर्ज्ञात्वा ज्ञातज्ञेयचतुष्टयम्। दैत्येन्द्रं दर्शयामास मातृमृष्टमलङ्कृतम्॥ ७/५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50013012, "chapter_id": 11503, "verse_number": "25", "content_sanskrit": "प्रणतं पादयोर्बालं प्रतिनन्द्याऽशिषाऽसुरः। परिष्वज्य चिरं दोर्भ्यां परमामाप निर्वृतिम्॥ ७/५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50013013, "chapter_id": 11503, "verse_number": "26", "content_sanskrit": "आरोप्याङ्कमवघ्राय मूर्धन्यश्रुकळाम्बुभिः। आसिञ्चन् विकसद्वक्त्र इदमाह युधिष्ठिर॥ ७/५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50013014, "chapter_id": 11503, "verse_number": "27", "content_sanskrit": "प्रह्लादानूच्यतां तात स्वधीतं किञ्चिदुत्तमम्। कालेनैतावताऽऽयुष्मन् यदशिक्षद् गुरोर्भवान्॥ ७/५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50013015, "chapter_id": 11503, "verse_number": "28", "content_sanskrit": "प्रह्लाद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50013016, "chapter_id": 11503, "verse_number": "29", "content_sanskrit": "श्रवणं कीर्तनं विष्णोः स्मरणं पादसेवनम्। अर्चनं वन्दनं दास्यं सख्यमात्मनिवेदनम्॥ ७/५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50013017, "chapter_id": 11503, "verse_number": "30", "content_sanskrit": "इति पुंसाऽर्पिता विष्णौ भक्तिश्चेन्नवलक्षणा। क्रियते भगवत्यद्धा तन्मन्येऽधीतमुत्तमम्॥ ७/५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50013018, "chapter_id": 11503, "verse_number": "31", "content_sanskrit": "नारद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50013019, "chapter_id": 11503, "verse_number": "32", "content_sanskrit": "निशम्यैतत् सुतवचो हिरण्यकशिपुस्तदा। गुरुपुत्रमुवाचेदं रुषा प्रस्फुरिताधरः॥ ७/५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50013020, "chapter_id": 11503, "verse_number": "33", "content_sanskrit": "हिरण्यकशिपुरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50013021, "chapter_id": 11503, "verse_number": "34", "content_sanskrit": "ब्रह्मबन्धो किमेतत् ते विपक्षं श्रयताऽसता। असारं ग्राहितो बालो मामनादृत्य दुर्मते॥ ७/५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50013022, "chapter_id": 11503, "verse_number": "35", "content_sanskrit": "सन्ति ह्यसाधवो लोके दुर्मैत्राश्छदम्वासिनः। तेषामुदेत्यघं काले रोगः पातकिनामिव॥ ७/५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50013023, "chapter_id": 11503, "verse_number": "36", "content_sanskrit": "गुरुपुत्र उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50013024, "chapter_id": 11503, "verse_number": "37", "content_sanskrit": "न मत्प्रणीतं न परप्रणीतं सुतो वदत्येष तवेन्द्रशत्रो। नैसर्गिकीयं मतिरस्य राजन् नियच्छ मन्युं क्व तदात्ममानः॥ ७/५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50013025, "chapter_id": 11503, "verse_number": "38", "content_sanskrit": "नारद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50013026, "chapter_id": 11503, "verse_number": "39", "content_sanskrit": "गुरुणैवं प्रतिप्रोक्तो भूय आहासुरः सुतम्। न चेद् गुरुमुखीयं ते कुतोऽभद्रासती मतिः॥ ७/५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50013027, "chapter_id": 11503, "verse_number": "40", "content_sanskrit": "प्रह्लाद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50013028, "chapter_id": 11503, "verse_number": "41", "content_sanskrit": "मतिर्न कृष्णे परतः स्वतोऽपि वा मिथोऽभिपद्येत गृहव्रतानाम्। अदान्तगोभिर्विशतां तमिस्रं पुनः पुनश्चर्वितचर्वणानाम्॥ ७/५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50013029, "chapter_id": 11503, "verse_number": "42", "content_sanskrit": "न ते विदुः स्वार्थगतिं हि विष्णुं दुराशया ये बहिरर्थभावाः। अन्धा यथान्धैरुपनीयमाना वाचीशतन्त्र्यामुरुदाम्नि बद्धाः॥ ७/५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50013030, "chapter_id": 11503, "verse_number": "43", "content_sanskrit": "नैषां मतिस्तावदुरुक्रमाङ्घ्रिं स्पृशत्यनर्थापगमो यदुत्थः। महीयसां पादरजोभिषेकं निष्किञ्चनानां न वृणीत यावत्॥ ७/५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50013031, "chapter_id": 11503, "verse_number": "44", "content_sanskrit": "नारद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50013032, "chapter_id": 11503, "verse_number": "45", "content_sanskrit": "इत्युक्त्वोपरतं पुत्रं हिरण्यकशिपू रुषा। अन्धीकृतात्मा स्वोत्सङ्गान्निरस्यत महीतळे। आहामर्षरुषाऽऽविष्टः कषायीकृतलोचनः॥ ७/५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50013033, "chapter_id": 11503, "verse_number": "46", "content_sanskrit": "हिरण्यकशिपुरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50013034, "chapter_id": 11503, "verse_number": "47", "content_sanskrit": "वध्यतामाश्वयं वध्यो निस्सारयत नैऋताः। अयं मे भ्रातृहा शोच्यो हित्वा स्वान् सुहृदोऽधमः॥ ७/५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50013035, "chapter_id": 11503, "verse_number": "48", "content_sanskrit": "पितृव्यहन्तुः स्वप्राणान् विष्णोर्दासवदर्पयन्। विष्णोर्वा साध्वसौ किं नु करिष्यत्यसमञ्जसः। सौहृदं दुस्त्यजं पित्रोरत्यजत् पञ्चहायनः॥ ७/५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50013036, "chapter_id": 11503, "verse_number": "49", "content_sanskrit": "परोऽप्यवश्यं हितकृद् यथौषधं स्वदेहजोऽप्यामयवत् सुतोऽहितः। छिन्द्यात् तदङ्गं हि यदात्मनोऽहितं शेषं सुखं जीवति यद्विवर्जनात्॥ ७/५/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50013037, "chapter_id": 11503, "verse_number": "50", "content_sanskrit": "सर्वैरुपायैर्हन्तव्यः सम्भोगशयनासनैः। सुहृल्लिङ्गधरः शत्रुर्मुनेर्दुष्टमिवेन्द्रियम्॥ ७/५/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50013038, "chapter_id": 11503, "verse_number": "51", "content_sanskrit": "नैऋर्तास्ते समुद्दिष्टा भर्त्रा वै शूलपाणयः। तिग्मदंष्ट्राः कराळास्याः ताम्रश्मश्रुशिरोरुहाः॥ ७/५/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50013039, "chapter_id": 11503, "verse_number": "52", "content_sanskrit": "नदन्तो भैरवं नादं छिन्धि भिन्धीति वादिनः। आसीनमाहनन् शूलैः प्रह्लादं सवमर्मसु॥ ७/५/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 50013040, "chapter_id": 11503, "verse_number": "53", "content_sanskrit": "परे ब्रह्मण्यनिर्देश्ये भगवत्यखिलात्मनि। युक्तात्मन्यफला आसन्नपुण्यस्येव तत्क्रियाः॥ ७/५/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 50013041, "chapter_id": 11503, "verse_number": "54", "content_sanskrit": "प्रयासे नाशितेतस्मिन् दैत्येन्द्रः परिशङ्कितः। चकार तद्वधोपायान् निर्बन्धेन युधिष्ठिर॥ ७/५/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 50013042, "chapter_id": 11503, "verse_number": "55", "content_sanskrit": "दिग्गजैर्दन्दशूकेन्द्रैरभिचारावपातनैः। मायाभिः सन्निरोधैश्च गरदानैरभोजनैः॥ ७/५/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 50013043, "chapter_id": 11503, "verse_number": "56", "content_sanskrit": "हिमवाय्वग्निसलिलैः पर्वताक्रमणैरपि। न शशाक यदा हन्तुमपापमसुरः सुतम्॥ ७/५/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 50013044, "chapter_id": 11503, "verse_number": "57", "content_sanskrit": "चिन्तां दीर्घतमां प्राप्तः तत् कर्तुं नाभ्यपद्यत। एष मे बह्वसाधूक्तो वधोपायाश्च निर्मिताः। तैस्तैर्द्रोहैरसद्धर्मैर्मुक्तः स्वेनैव तेजसा॥ ७/५/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 50013045, "chapter_id": 11503, "verse_number": "58", "content_sanskrit": "वर्तमानोऽविदूरे वा बालोऽप्यजडधीरयम्। न विस्मरति मेऽनार्यं शुनःशेप इव प्रभुः॥ ७/५/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 50013046, "chapter_id": 11503, "verse_number": "59", "content_sanskrit": "अप्रमेयानुभावोऽयमकुतश्चिद्भयोऽमरः। नूनमेतद्विरोधेन मृत्युर्मे भविता न वा॥ ७/५/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 50013047, "chapter_id": 11503, "verse_number": "60", "content_sanskrit": "इति तच्चिन्तया किञ्चिन्म्लानश्रियमधोमुखम्। शण्डामर्कावौशनसौ विविक्त इति होचतुः॥ ७/५/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 50013048, "chapter_id": 11503, "verse_number": "61", "content_sanskrit": "जितं त्वयैकेन जगत्त्रयं भ्रुवोर्विजृम्भणत्यक्तसमस्तधिष्ण्यपम्। न तस्य चिन्त्यं तव नाथ चक्ष्महे न वै शिशूनां गुणदोषयोः पदम्॥ ७/५/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 50013049, "chapter_id": 11503, "verse_number": "62", "content_sanskrit": "इमं तु पाशैर्वरुणस्य बद्धं निधेहि भीतो न पलायते यथा। बुद्धिश्च पुंसो वयसाऽऽर्यसेवया यावद् गुरुर्भार्गव आगमिष्यति॥ ७/५/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 50013050, "chapter_id": 11503, "verse_number": "63", "content_sanskrit": "तथेति गुरुपुत्रोक्तमनुज्ञायेदमब्रवीत्। धर्मा ह्यस्योपदेष्टव्या राज्ञां ये गृहमेधिनाम्॥ ७/५/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 50013051, "chapter_id": 11503, "verse_number": "64", "content_sanskrit": "धर्ममर्थं च कामं च नितरां चानुपूर्वशः। प्रह्लादायोचतू राजन् प्रश्रितावनताय च॥ ७/५/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 50013052, "chapter_id": 11503, "verse_number": "65", "content_sanskrit": "यथा त्रिवर्गो गुरुभिरात्मने उपशिक्षितः। न साधु मेने तच्छिक्षां द्वन्द्वारामोपवर्णिताम्॥ ७/५/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 50013053, "chapter_id": 11503, "verse_number": "66", "content_sanskrit": "यदाऽऽचार्यः परावृत्तो गृहमेधीयकर्मसु। वयस्यैर्बालकैस्तत्र सोपहूतः कृतक्षणैः॥ ७/५/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 50013054, "chapter_id": 11503, "verse_number": "67", "content_sanskrit": "अथ तान् श्लक्ष्णया वाचा प्रत्याहूय महान् बुधः। उवाच विद्वान् तन्निष्ठां कृपया प्रहसन्निव॥ ७/५/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 50013055, "chapter_id": 11503, "verse_number": "68", "content_sanskrit": "ते तु तद्गौरवात् सर्वे त्यक्तक्रीडापरिच्छदाः। बाला नदूषितधियो द्वन्द्वारामेरितेहितैः॥ ७/५/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 50013056, "chapter_id": 11503, "verse_number": "69", "content_sanskrit": "पर्युपासत राजेन्द्र तन्न्यस्तहृदयेक्षणाः। तानाह करुणो मैत्रो महाभागवतोऽसुरः॥ ७/५/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 50013057, "chapter_id": 11503, "verse_number": "70", "content_sanskrit": "इति श्रीमद्भागवते सप्तमस्कन्धे पञ्चमोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]