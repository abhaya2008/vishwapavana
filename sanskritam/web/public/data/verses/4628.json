[{"id": 2169704, "chapter_id": 4628, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2169705, "chapter_id": 4628, "verse_number": "१", "content_sanskrit": "सुदुष्करमिदं कर्म कृतं भीमेन सञ्जय ।\nयेन कर्णो महाबाहू रथोपस्थे निपातितः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2169706, "chapter_id": 4628, "verse_number": "२", "content_sanskrit": "कर्णो ह्येको रणे हन्ता सृञ्जयान् पाण्डवैः सह ।\nइति दुर्योधनः सूत प्राब्रवीन्मां मुहुर्मुहुः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2169707, "chapter_id": 4628, "verse_number": "३", "content_sanskrit": "पराजितं तु राधेयं दृष्ट्वा भीमेन संयुगे ।\nततः परं किमकरोत्पुत्रो दुर्योधनो मम\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2169708, "chapter_id": 4628, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2169709, "chapter_id": 4628, "verse_number": "४", "content_sanskrit": "विमुखं प्रेक्ष्य राधेयं सूतपुत्रं महाहवे ।\nपुत्रस्तव महाराज सोदर्यान् समभाषत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2169710, "chapter_id": 4628, "verse_number": "५", "content_sanskrit": "शीघ्रं गच्छत भद्रं वो राधेयं परिरक्षत ।\nभीमसेनभयागाधे मज्जन्तं व्यसनार्णवे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2169711, "chapter_id": 4628, "verse_number": "६", "content_sanskrit": "ते तु राज्ञा समादिष्टा भीमसेनजिघांसवः ।\nअभ्यवर्तन्त सङ्क्रुद्धाः पतङ्गा इव पावकम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2169712, "chapter_id": 4628, "verse_number": "७", "content_sanskrit": "श्रुतायुर्दुर्धरः क्राथो विवित्सुर्विकटः समः ।\nनिषङ्गी कवची पाशी तथा नन्दोपनन्दकौ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2169713, "chapter_id": 4628, "verse_number": "८", "content_sanskrit": "दुष्प्रधर्षः सुबाहुश्च वातवेगसुवर्चसौ ।\nधनुर्ग्राहो दुर्दमश्च तथा सत्त्वसमः सहः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2169714, "chapter_id": 4628, "verse_number": "९", "content_sanskrit": "एते रथैः परिवृता वीर्यवन्तो महाबलाः ।\nभीमसेनं समासाद्य समन्तात्पर्यवारयन्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2169715, "chapter_id": 4628, "verse_number": "१०", "content_sanskrit": "ते व्यमुञ्चन् शरव्रातान् नानालिङ्गान् समन्ततः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2169716, "chapter_id": 4628, "verse_number": "११", "content_sanskrit": "स तैरभ्यर्द्यमानस्तु भीमसेनो महाबलः ।\nतेषामापततां क्षिप्रं सुतानां ते नराधिप\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2169717, "chapter_id": 4628, "verse_number": "१२", "content_sanskrit": "रथैः पञ्चाशता सार्धं पञ्चाशन्न्यहनद् रथान् ।\nविवित्सोस्तु ततः क्रुद्धो भल्लेनापाहरच्छिरः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2169718, "chapter_id": 4628, "verse_number": "१३", "content_sanskrit": "भीमेन च महाराज स पपात हतो भुवि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2169719, "chapter_id": 4628, "verse_number": "१४", "content_sanskrit": "सकुण्डलशिरस्त्राणं पूर्णचन्द्रोपमं तदा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2169720, "chapter_id": 4628, "verse_number": "१५", "content_sanskrit": "तं दृष्ट्वा निहतं शूरं भ्रातरः सर्वतः प्रभो ।\nअभ्यद्रवन्त समरे भीमं भीमपराक्रमम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2169721, "chapter_id": 4628, "verse_number": "१६", "content_sanskrit": "ततोऽपराभ्यां भल्लाभ्यां पुत्रयोस्ते महाहवे ।\nजहार समरे प्राणान् भीमो भीमपराक्रमः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2169722, "chapter_id": 4628, "verse_number": "१७", "content_sanskrit": "तौ धरामन्वपद्येतां वातरुग्णाविव द्रुमौ ।\nविकटश्च समश्चोभौ देवगर्भसमौ नृप\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2169723, "chapter_id": 4628, "verse_number": "१८", "content_sanskrit": "ततस्तु त्वरितो भीमः क्राथं निन्ये यमक्षयम् ।\nनाराचेन सुतीक्ष्णेन स हतो न्यपतद् भुवि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2169724, "chapter_id": 4628, "verse_number": "१९", "content_sanskrit": "हाहाकारस्ततस्तीव्रः सम्बभूव जनेश्वर ।\nवध्यमानेषु ते राजंस्तदा पुत्रेषु धन्विषु\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2169725, "chapter_id": 4628, "verse_number": "२०", "content_sanskrit": "तेषां संलुलिते सैन्ये भीमसेनो महाबलः ।\nनन्दोपनन्दौ समरे प्रापयद् यमसादनम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2169726, "chapter_id": 4628, "verse_number": "२१", "content_sanskrit": "ततस्ते प्राद्रवन् भीताः पुत्रास्ते विह्वलीकृताः ।\nभीमसेनं रणे दृष्ट्वा कालान्तकयमोपमम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2169727, "chapter_id": 4628, "verse_number": "२२", "content_sanskrit": "पुत्रांस्ते निहतान् दृष्ट्वा सूतपुत्रो सुदुर्मनाः ।\nहंसवर्णान् हयान् भूयः प्राहिणोद् यत्र पाण्डवः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2169728, "chapter_id": 4628, "verse_number": "२३", "content_sanskrit": "ते प्रेषिता महाराज मद्रराजेन वाजिनः ।\nभीमसेनरथं प्राप्य समसज्जन्त वेगिताः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2169729, "chapter_id": 4628, "verse_number": "२४", "content_sanskrit": "स सन्निपातस्तुमुलो घोररूपो विशाम्पते ।\nआसीद् रौद्रो महाराज कर्णपाण्डवयोर्मृधे\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2169730, "chapter_id": 4628, "verse_number": "२५", "content_sanskrit": "दृष्ट्वा मम महाराज तौ समेतौ महारथौ ।\nआसीद् बुद्धिः कथं नूनमेतदद्य भविष्यति\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2169731, "chapter_id": 4628, "verse_number": "२६", "content_sanskrit": "ततो भीमो रणश्लाघी छादयामास पत्रिभिः ।\nकर्णं रणे महाराज पुत्राणां तव पश्यताम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2169732, "chapter_id": 4628, "verse_number": "२७", "content_sanskrit": "ततः कर्णो भृशं क्रुद्धो भीमं नवभिरायसैः ।\nविव्याध परमास्त्रज्ञो भल्लैः सन्नतपर्वभिः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2169733, "chapter_id": 4628, "verse_number": "२८", "content_sanskrit": "आहतः स महाबाहुर्भीमो भीमपराक्रमः ।\nआकर्णपूर्णैर्विशिखैः कर्णं विव्याध सप्तभिः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2169734, "chapter_id": 4628, "verse_number": "२९", "content_sanskrit": "ततः कर्णो महाराज आशीविष इव श्वसन् ।\nशरवर्षेण महता छादयामास पाण्डवम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2169735, "chapter_id": 4628, "verse_number": "३०", "content_sanskrit": "भीमोऽपि तं शरव्रातैश्छादयित्वा महारथम् ।\nपश्यतां कौरवेयाणां विननर्द महाबलः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2169736, "chapter_id": 4628, "verse_number": "३१", "content_sanskrit": "ततः कर्णो भृशं क्रुद्धो दृढमादाय कार्मुकम् ।\nभीमं विव्याध दशभिः कङ्कपत्रैः शिलाशितैः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2169737, "chapter_id": 4628, "verse_number": "३२", "content_sanskrit": "कार्मुकं चास्य चिच्छेद भल्लेन निशितेन च ।\nततो भीमो महाबाहुर्हेमपट्टविभूषितम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2169738, "chapter_id": 4628, "verse_number": "३३", "content_sanskrit": "परिघं घोरमादाय मृत्युदण्डमिवापरम् ।\nकर्णस्य निधनाकाङ्क्षी चिक्षेपातिबलो नदन्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2169739, "chapter_id": 4628, "verse_number": "३४", "content_sanskrit": "तमापतन्तं परिघं वज्राशनिसमस्वनम् ।\nचिच्छेद बहुधा कर्णः शरैराशीविषोपमैः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2169740, "chapter_id": 4628, "verse_number": "३५", "content_sanskrit": "ततः कार्मुकमादाय भीमो दृढतरं तदा ।\nछादयामास विशिखैः कर्णं परबलार्दनम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2169741, "chapter_id": 4628, "verse_number": "३६", "content_sanskrit": "चुक्रोध परमायस्तो दण्डाहत इवोरगः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2169742, "chapter_id": 4628, "verse_number": "३७", "content_sanskrit": "ततो युद्धमभूद् घोरं कर्णपाण्डवयोर्मृधे ।\nहरीन्द्रयोरिव मुहुः परस्परवधैषिणोः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2169743, "chapter_id": 4628, "verse_number": "३८", "content_sanskrit": "ततः कर्णो महाराज भीमसेनं त्रिभिः शरैः ।\nआकर्णमूलं विव्याध दृढमायम्य कार्मुकम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2169744, "chapter_id": 4628, "verse_number": "३९", "content_sanskrit": "सोऽतिविद्धो महेष्वासः कर्णेन बलिनां वरः ।\nघोरमादत्त विशिखं कर्णकायावदारणम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2169745, "chapter_id": 4628, "verse_number": "४०", "content_sanskrit": "तस्य भित्त्वा तनुत्राणं भित्त्वा कायं च सायकः ।\nप्राविशद् धरणीं राजन् वल्मीकमिव पन्नगः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2169746, "chapter_id": 4628, "verse_number": "४१", "content_sanskrit": "स तेनातिप्रहारेण व्यथितो विह्वलन्निव ।\nसञ्चचाल रथे कर्णः क्षितिकम्पे यथाचलः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2169747, "chapter_id": 4628, "verse_number": "४२", "content_sanskrit": "ततः कर्णो महाराज रोषामर्षसमन्वितः ।\nपाण्डवं पञ्चविंशत्या नाराचानां समार्पयत्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2169748, "chapter_id": 4628, "verse_number": "४३", "content_sanskrit": "ततो मुहूर्ताद् राजेन्द्र नातिकृच्छ्राद्धसन्निव ।\nविरथं भीमकर्माणं भीमं कर्णश्चकार ह\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2169749, "chapter_id": 4628, "verse_number": "४४", "content_sanskrit": "विरथो भरतश्रेष्ठः प्रहसन्ननिलोपमः ।\nगदाहस्तो महाबाहुरपतत्स्यन्दनोत्तमात्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2169750, "chapter_id": 4628, "verse_number": "४५", "content_sanskrit": "कर्णं शल्यं च युगपद् गदया प्रहसन्निव ।\nअपातयद् रथोपस्थे निहत्य विननाद ह\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2169751, "chapter_id": 4628, "verse_number": "४६", "content_sanskrit": "गदया च महाराज कर्णस्य रथकूबरम् ।\nपोथयामास सङ्क्रुद्धः समरे शत्रुतापनः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2169752, "chapter_id": 4628, "verse_number": "४७", "content_sanskrit": "नागान् सप्तशतान् राजन्नीषादन्तान् प्रहारिणः ।\nव्यधमत् सहसा भीमः क्रुद्धरूपः परन्तपः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2169753, "chapter_id": 4628, "verse_number": "४८", "content_sanskrit": "दन्तवेष्टेषु नेत्रेषु कुम्भेषु स कटेषु च ।\nमर्मस्वपि च मर्मज्ञो तान्नागान्नवधीद् बली\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2169754, "chapter_id": 4628, "verse_number": "४९", "content_sanskrit": "ततस्ते प्राद्रवन् भीताः प्रतीपं प्रहिताः पुनः ।\nमहामात्रैस्तमावव्रुर्मेघा इव दिवाकरम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2169755, "chapter_id": 4628, "verse_number": "५०", "content_sanskrit": "तान् स सप्तशतान् नागान् सारोहायुधकेतनान् ।\nभूमिष्ठो गदया जघ्ने शरन्मेघानिवानिलः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2169756, "chapter_id": 4628, "verse_number": "५१", "content_sanskrit": "ततः सुबलपुत्रस्य नागानतिबलान् पुनः ।\nपोथयामास कौन्तेयो द्विपञ्चाशदरिन्दमः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2169757, "chapter_id": 4628, "verse_number": "५२", "content_sanskrit": "तथा रथशतं साग्रं पत्तींश्च शतशोऽपरान् ।\nन्यहनत् पाण्डवो युद्धे तापयंस्तव वाहिनीम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2169758, "chapter_id": 4628, "verse_number": "५३", "content_sanskrit": "प्रताप्यमानं सूर्येण भीमेन च महात्मना ।\nतव सैन्यं सञ्चुकोच चर्माग्नावाहितं यथा\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2169759, "chapter_id": 4628, "verse_number": "५४", "content_sanskrit": "ते भीमभयसन्त्रस्तास्तावका भरतर्षभ ।\nविहाय समरे कर्णं दुद्रुवुर्वै दिशो दश\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2169760, "chapter_id": 4628, "verse_number": "५५", "content_sanskrit": "रथाः पञ्चशताश्चान्ये ह्रादिनश्चर्मवर्मिणः ।\nभीममभ्यद्रवंस्तूर्णं शरपूगैः समन्ततः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2169761, "chapter_id": 4628, "verse_number": "५६", "content_sanskrit": "तान् ससूतरथान् सर्वान् सपताकाध्वजायुधान् ।\nपोथयामास गदया भीमो विष्णुरिवासुरान्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2169762, "chapter_id": 4628, "verse_number": "५७", "content_sanskrit": "ततः शकुनिनिर्दिष्टाः सादिनः शूरसम्मताः ।\nत्रिसाहस्रा ययुर्भीमं शक्त्यृष्टिप्रासपाणयः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2169763, "chapter_id": 4628, "verse_number": "५८", "content_sanskrit": "तान् प्रत्युद्गम्य यवनानश्वारोहान् वरारिहा ।\nविचरन् विविधान् मार्गान् घातयामास योधयन्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2169764, "chapter_id": 4628, "verse_number": "५९", "content_sanskrit": "तेषामासीन्महान् शब्दस्ताडितानां च सर्वशः ।\nअश्मभिश्छिद्यमानानां तालानामिव भारत\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2169765, "chapter_id": 4628, "verse_number": "६०", "content_sanskrit": "एवं सुबलपुत्रस्य त्रिसाहस्रान् हयोत्तमान् ।\nहत्वान्यं रथमास्थाय क्रुद्धो राधेयमभ्ययात्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2169766, "chapter_id": 4628, "verse_number": "६१", "content_sanskrit": "कर्णोऽपि समरे राजन् धर्मपुत्रमरिन्दमम् ।\nशरैः प्रच्छादयामास सारथिं चाप्यपातयत्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2169767, "chapter_id": 4628, "verse_number": "६२", "content_sanskrit": "ततः सम्प्रद्रुतं सङ्खे रथं दृष्ट्वा महारथः ।\nअन्वधावत् किरन् बाणैः कङ्कपत्रैरजिह्मगैः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2169768, "chapter_id": 4628, "verse_number": "६३", "content_sanskrit": "राजानमभिधावन्तं शरैरावृत्य रोदसी ।\nक्रुद्धः प्रच्छादयामास शरजालेन मारुतिः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2169769, "chapter_id": 4628, "verse_number": "६४", "content_sanskrit": "सन्निवृत्तस्ततस्तूर्णं राधेयः शत्रुकर्शनः ।\nभीमं प्रच्छादयामास समन्तात् निशितैः शरैः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2169770, "chapter_id": 4628, "verse_number": "६५", "content_sanskrit": "भीमसेनरथव्यग्रं कर्णं भारत सात्यकिः ।\nअभ्यर्दयदमेयात्मा पार्ष्णिग्रहणकारणात्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2169771, "chapter_id": 4628, "verse_number": "६६", "content_sanskrit": "अभ्यवर्तत कर्णस्तमर्दितोऽपि शरैर्भृशम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2169772, "chapter_id": 4628, "verse_number": "६७", "content_sanskrit": "तावन्योन्यं समासाद्य वृषभौ सर्वधन्विनाम् ।\nविसृजन्तौ शरांश्चित्रान् विभ्राजेतां मनस्विनौ\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2169773, "chapter_id": 4628, "verse_number": "६८", "content_sanskrit": "ताभ्यां वियति राजेन्द्र विततं भीमदर्शनम् ।\nक्रौञ्चपृष्ठारुणं रौद्रं बाणजालं व्यदृश्यत\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2169774, "chapter_id": 4628, "verse_number": "६९", "content_sanskrit": "नैव सूर्यप्रभां खं वा न दिशः प्रदिशः कुतः ।\nप्राज्ञासिष्म वयं ताभ्यां शरैर्मुक्तैः सहस्रशः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2169775, "chapter_id": 4628, "verse_number": "७०", "content_sanskrit": "मध्याह्ने तपतो राजन् भास्करस्य महाप्रभाः ।\nहताः सर्वाः शरौघैस्तैः कर्णमाधवयोस्तदा\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2169776, "chapter_id": 4628, "verse_number": "७१", "content_sanskrit": "सौबलं कृतवर्माणं द्रौणिमाधिरथिं कृपम् ।\nसंसक्तान् पाण्डवैर्दृष्ट्वा निवृत्ताः कुरवः पुनः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2169777, "chapter_id": 4628, "verse_number": "७२", "content_sanskrit": "तेषामापततां शब्दस्तीव्र आसीद् विशाम्पते ।\nउद्धूतानां यथा वृष्ट्या सागराणां भयावहः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2169778, "chapter_id": 4628, "verse_number": "७३", "content_sanskrit": "ते सेने भृशसंविग्ने दृष्ट्वान्योन्यं महारणे ।\nहर्षेण महता युक्ते परिगृह्य परस्परम्\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2169779, "chapter_id": 4628, "verse_number": "७४", "content_sanskrit": "ततः प्रववृते युद्धं मध्यं प्राप्ते दिवाकरे ।\nयादृशं न कदाचिद्धि दृष्टपूर्वं न च श्रुतम्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2169780, "chapter_id": 4628, "verse_number": "७५", "content_sanskrit": "बलौघस्तु समासाद्य बलौघं सहसा रणे ।\nउपासर्पत वेगेन जलौघ इव सागरम्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2169781, "chapter_id": 4628, "verse_number": "७६", "content_sanskrit": "आसीन्निनादः सुमहान् बलौघानां परस्परम् ।\nगर्जतां सागरौघाणां यथा स्यान्निस्वनो महान्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2169782, "chapter_id": 4628, "verse_number": "७७", "content_sanskrit": "ते तु सेने समासाद्य वेगवत्यौ परस्परम् ।\nएकीभावमनुप्राप्ते नद्याविव समागमे\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2169783, "chapter_id": 4628, "verse_number": "७८", "content_sanskrit": "ततः प्रववृते युद्धं घोररूपं विशाम्पते ।\nकुरूणां पाण्डवानां च लिप्सतां सुमहद्यशः\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2169784, "chapter_id": 4628, "verse_number": "७९", "content_sanskrit": "शूराणां गर्जतां तत्र साधिक्षेपकृता गिरः ।\nश्रूयन्ते विविधा राजन्नामान्युद्दिश्य सर्वतः\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2169785, "chapter_id": 4628, "verse_number": "८०", "content_sanskrit": "यस्य यद्धि रणे न्यङ्गं पितृतो मातृतोऽपि वा ।\nकर्मतः शीलतो वापि स तच्छ्रावयते युधि\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2169786, "chapter_id": 4628, "verse_number": "८१", "content_sanskrit": "तान् दृष्ट्वा समरे शूरांस्तर्जयानान् परस्परम् ।\nअभवन्मे मती राजन्नैषामस्तीति जीवितम्\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2169787, "chapter_id": 4628, "verse_number": "८२", "content_sanskrit": "तेषां दृष्ट्वा तु क्रुद्धानां वपूंष्यमिततेजसाम् ।\nअभवन्मे भयं तीव्रं कथमेतद् भविष्यति\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2169788, "chapter_id": 4628, "verse_number": "८३", "content_sanskrit": "ततस्ते पाण्डवा राजन् कौरवाश्च महारथाः ।\nततक्षुः सायकैस्तीक्ष्णैर्निघ्नन्तो हि परस्परम्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2169789, "chapter_id": 4628, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nअष्टचत्वारिंशोऽध्यायः ॥४८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}]