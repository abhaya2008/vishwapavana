[{"id": 2040357, "chapter_id": 1893, "verse_number": "५-१३८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040358, "chapter_id": 1893, "verse_number": "५-१३८-१", "content_sanskrit": "कुन्त्यास्तु वचनं श्रुत्वा भीष्मद्रोणौ महारथौ।\nदुर्योधनमिदं वाक्यमूचतुः शासनातिगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040359, "chapter_id": 1893, "verse_number": "५-१३८-२", "content_sanskrit": "श्रुतं ते पुरुषव्याघ्र कुन्त्याः कृष्णस्य संनिधौ ।\nवाक्यमर्थवदत्युग्रमुक्तं धर्म्यमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040360, "chapter_id": 1893, "verse_number": "५-१३८-३", "content_sanskrit": "तत्करिष्यन्ति कौन्तेया वासुदेवस्य संमतम् ।\nन हि ते जातु शाम्येरन्नृते राज्येन कौरव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040361, "chapter_id": 1893, "verse_number": "५-१३८-४", "content_sanskrit": "क्लेशिता हि त्वया पार्था धर्मपाशसितास्तदा।\nसभायां द्रौपदी चैव तैश्च तन्मर्षितं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040362, "chapter_id": 1893, "verse_number": "५-१३८-५", "content_sanskrit": "कृतास्त्रं ह्यर्जुनं प्राप्य भीमं च कृतनिश्चयम् ।\nगाण्डीवं चेषुधी चैव रथं च ध्वजमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040363, "chapter_id": 1893, "verse_number": "५-१३८-६", "content_sanskrit": "नकुलं सहदेवं च बलवीर्यसमन्वितौ ।\nसहायं वासुदेवं च न क्षंस्यति युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040364, "chapter_id": 1893, "verse_number": "५-१३८-७", "content_sanskrit": "प्रत्यक्षं ते महाबाहो यथा पार्थेन धीमता ।\nविराटनगरे पूर्वं सर्वे स्म युधि निर्जिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040365, "chapter_id": 1893, "verse_number": "५-१३८-८", "content_sanskrit": "दानवा घोरकर्माणो निवातकवचा युधि।\nरौद्रमस्त्रं समादाय दग्धा वानरकेतुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040366, "chapter_id": 1893, "verse_number": "५-१३८-९", "content_sanskrit": "कर्णप्रभृतयश्चेमे त्वं चापि कवची रथी।\nमोक्षितो घोषयात्रायां पर्याप्तं तन्निदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040367, "chapter_id": 1893, "verse_number": "५-१३८-१०", "content_sanskrit": "प्रशाम्य भरतश्रेष्ठ भ्रातृभिः सह पाण्डवैः ।\nरक्षेमां पृथिवीं सर्वां मृत्योर्दंष्ट्रान्तरं गताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040368, "chapter_id": 1893, "verse_number": "५-१३८-११", "content_sanskrit": "ज्येष्ठो भ्राता धर्मशीलो वत्सलः श्लक्ष्णवाक्कविः ।\nतं गच्छ पुरुषव्याघ्रं व्यपनीयेह किल्बिषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040369, "chapter_id": 1893, "verse_number": "५-१३८-१२", "content_sanskrit": "दृष्टश्चेत्त्वं पाण्डवेन व्यपनीतशरासनः ।\nप्रशान्तभ्रुकुटिः श्रीमान्कृता शान्तिःकुलस्य नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040370, "chapter_id": 1893, "verse_number": "५-१३८-१३", "content_sanskrit": "तमभ्येत्य सहामात्यः परिष्वज्य नृपात्मजम् ।\nअभिवादय राजानं यथापूर्वमरिन्दम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040371, "chapter_id": 1893, "verse_number": "५-१३८-१४", "content_sanskrit": "अभिवादयमानं त्वां पाणिभ्यां भीमपूर्वजः ।\nप्रतिगृह्णातु सौहार्दात्कुन्तीपुत्रो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040372, "chapter_id": 1893, "verse_number": "५-१३८-१५", "content_sanskrit": "सिंहस्कन्धोरुबाहुस्त्वां वृत्तायतमहाभुजः ।\nपरिष्वजतु बाहुभ्यां भीमः प्रहरतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040373, "chapter_id": 1893, "verse_number": "५-१३८-१६", "content_sanskrit": "कम्बुग्रीवो गुडाकेशस्ततस्त्वां पुष्करेक्षणः ।\nअभिवादयतां पार्थः कुन्तीपुत्रो धनञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040374, "chapter_id": 1893, "verse_number": "५-१३८-१७", "content_sanskrit": "आश्विनेयौ नरव्याघ्रौ रूपेणाप्रतिमौ भुवि ।\nतौ च त्वां गुरुवत्प्रोम्णा पूजया प्रत्युदीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040375, "chapter_id": 1893, "verse_number": "५-१३८-१८", "content_sanskrit": "मुञ्चन्त्वानन्दजाश्रूणि दाशार्हप्रमुखा नृपाः ।\nसंगच्छ भ्रातृभिः सार्धं मानं संत्यज्य पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040376, "chapter_id": 1893, "verse_number": "५-१३८-१९", "content_sanskrit": "प्रशाधि पृथिवीं कृत्स्नां ततस्त्वं भ्रातृभिः सह ।\nसमालिङ्ग्य च हर्षेण नृपा यान्तु परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2040377, "chapter_id": 1893, "verse_number": "५-१३८-२०", "content_sanskrit": "अलं युद्धेन राजेन्द्र सुहृदां शृणु वारणम् ।\nध्रुवं विनाशो युद्धे हि क्षत्रियाणां प्रदृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2040378, "chapter_id": 1893, "verse_number": "५-१३८-२१", "content_sanskrit": "ज्योतींषि प्रतिकूलानि दारुणा मृगपक्षिणः।\nउत्पाता विविधा वीर दृश्यन्ते क्षत्रनाशनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2040379, "chapter_id": 1893, "verse_number": "५-१३८-२२", "content_sanskrit": "विशेषत इहास्माकं निमित्तानि विनाशने।\nउल्काभिर्हि प्रदीप्ताभिर्बाध्यते पृतना तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2040380, "chapter_id": 1893, "verse_number": "५-१३८-२३", "content_sanskrit": "वाहनान्यप्रहृष्टानि रुदन्तीव विशांपते।\nगृध्रास्ते पर्युपासन्ते सैन्यानि च समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2040381, "chapter_id": 1893, "verse_number": "५-१३८-२४", "content_sanskrit": "नगरं न यथापूर्वं तथा राजनिवेशनम् ।\nशिवाश्चाशिवनिर्घोषा दीप्तां सेवन्ति वै दिशं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2040382, "chapter_id": 1893, "verse_number": "५-१३८-२५", "content_sanskrit": "कुरु वाक्यं पितुर्मातुरस्माकं च हितैषिणाम् ।\nत्वय्यायत्तो महाबाहो शमो व्यायाम एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2040383, "chapter_id": 1893, "verse_number": "५-१३८-२६", "content_sanskrit": "न चेत्करिष्यसि वचः सुहृदामरिकर्शन ।\nतप्स्यसे वाहिनीं दृष्ट्वा पार्थबाणप्रपीडिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2040384, "chapter_id": 1893, "verse_number": "५-१३८-२७", "content_sanskrit": "भीमस्य च महानादं नदतः शुष्मिणो रणे।\nश्रुत्वा स्मर्तासि मे वाक्यं गाण्डीवस्य च निःश्वनम् ।\nयद्येतदपसव्यं ते वचो मम भविष्यति ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2040385, "chapter_id": 1893, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि अष्टत्रिंशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]