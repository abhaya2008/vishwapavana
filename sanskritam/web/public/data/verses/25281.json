[{"id": 7005281000, "chapter_id": 25281, "verse_number": "७-४-१६-१", "content_sanskrit": "प्रह्लाद उवाच ।\nततो गच्छेद्द्विजश्रेष्ठा गदातीर्थमनुत्तमम् ।\nयत्र स्नात्वा नरो भक्त्या लभेद्भूदानजं फलम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005281001, "chapter_id": 25281, "verse_number": "७-४-१६-२", "content_sanskrit": "तर्पयेत्पितृदेवांश्च ऋषींश्चैव यथाक्रमम् ।\nश्राद्धं च कारयेत्तत्र पितॄणां तृप्तिहेतवे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005281002, "chapter_id": 25281, "verse_number": "७-४-१६-३", "content_sanskrit": "गदातीर्थे तु देवेशं विष्णुं वाराहरूपिणम् ।\nसमभ्यर्च्य नरो भक्त्या विष्णुलोके महीयते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005281003, "chapter_id": 25281, "verse_number": "७-४-१६-४", "content_sanskrit": "नागतीर्थं ततो गच्छेत्सरः परमशो भनम् ।\nयत्र स्नात्वा नरः सम्यङ्नागलोकमवाप्नुयात् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005281004, "chapter_id": 25281, "verse_number": "७-४-१६-५", "content_sanskrit": "भद्रतीर्थं ततो गच्छेत्सरस्त्रिभुवनार्चितम् ।\nस्नानमात्रेण लभते तिलधेनुफलं नरः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005281005, "chapter_id": 25281, "verse_number": "७-४-१६-६", "content_sanskrit": "चित्रातीर्थं ततो गच्छेत्सरः परमशोभनम् ।\nस्नानमात्रेण लभते घृतधेनुफलं नरः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005281006, "chapter_id": 25281, "verse_number": "७-४-१६-७", "content_sanskrit": "यदा द्वारावती विप्रा प्लाविता सागरेण हि ।\nपुण्यानि बहुतीर्थानि च्छन्नानि जलपांसुभिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005281007, "chapter_id": 25281, "verse_number": "७-४-१६-८", "content_sanskrit": "दृश्यानि कतिचित्संति ह्यदृश्यान्यपराणि च ।\nतानि सर्वाणि विप्रेन्द्राः कथयिष्यामि सर्वतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005281008, "chapter_id": 25281, "verse_number": "७-४-१६-९", "content_sanskrit": "चंद्रभागां ततो गच्छेत्सर्वपापप्रणाशिनीम् ।\nयत्र स्नात्वा नरो भक्त्या वाजपेयफलं लभेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005281009, "chapter_id": 25281, "verse_number": "७-४-१६-१०", "content_sanskrit": "देवी चंद्रार्चिता यत्र यशोदा नंदनंदिनी ।\nकौमारिका शक्तिहस्ता खङ्गखेटकधारिणी ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005281010, "chapter_id": 25281, "verse_number": "७-४-१६-११", "content_sanskrit": "केश्यादिदैत्यदलिनी स्वसा वै रामकृष्णयोः ।\nयस्या दर्शनमात्रेण सर्वान्कामानवाप्नुयात् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005281011, "chapter_id": 25281, "verse_number": "७-४-१६-१२", "content_sanskrit": "ततो गच्छेत विप्रेन्द्रास्तीर्थं महिषसंज्ञकम् ।\nयस्य दर्शनमात्रेण मुच्यते सर्वपातकैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005281012, "chapter_id": 25281, "verse_number": "७-४-१६-१३", "content_sanskrit": "मुक्तिद्वारं ततो गच्छेत्तीर्थं पाप प्रणाशनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005281013, "chapter_id": 25281, "verse_number": "७-४-१६-१४", "content_sanskrit": "वसिष्ठेन समानीता मुनिना यत्र गोमती ।\nस्नातो भवति गंगायां यत्र स्नात्वा कलौ युगे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005281014, "chapter_id": 25281, "verse_number": "७-४-१६-१५", "content_sanskrit": "गोमती निःसृता यस्मा त्प्रविष्टा वरुणालयम् ।\nतत्र स्नात्वा नरो भक्त्या अश्वमेधफलं लभेत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005281015, "chapter_id": 25281, "verse_number": "७-४-१६-१६", "content_sanskrit": "भृगुणा हि तपस्तप्तं स्थापिता यत्र चांबिका ।\nभृग्वर्चिता ततो देवी प्रसिद्धा श्रूयते क्षितौ ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005281016, "chapter_id": 25281, "verse_number": "७-४-१६-१७", "content_sanskrit": "संसिद्धिं परमां याति यस्याः संस्मरणान्नरः ।\nशिवलिंगान्यनेकानि यत्र सन्ति महीतले ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005281017, "chapter_id": 25281, "verse_number": "७-४-१६-१८", "content_sanskrit": "ततो गच्छेत विप्रेन्द्राः कालिन्दीसर उत्तमम् ।\nकालिन्दी सूर्यतनया सरश्चक्रे त्वनुत्तमम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005281018, "chapter_id": 25281, "verse_number": "७-४-१६-१९", "content_sanskrit": "तत्र स्नात्वा नरो भक्त्या न दुर्गतिमवाप्नुयात् ।\nसांबतीर्थं ततो गच्छेत्सर्वपापप्रणाशनम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005281019, "chapter_id": 25281, "verse_number": "७-४-१६-२०", "content_sanskrit": "कृत्वा श्राद्धं च विधिवल्लभेद्गोदानजं फलम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005281020, "chapter_id": 25281, "verse_number": "७-४-१६-२१", "content_sanskrit": "गच्छेच्च शांकरं तीर्थं ततस्त्रैलोक्यपावनम् ।\nयत्र स्नात्वा नरो भक्त्या लभेद्बहुसुवर्णकम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005281021, "chapter_id": 25281, "verse_number": "७-४-१६-२२", "content_sanskrit": "ततो नागसरो गच्छेत्तीर्थं पापप्रणाशनम् ।\nपितॄन्सन्तर्प्य विधिवन्नागलोकमवाप्नुयात् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005281022, "chapter_id": 25281, "verse_number": "७-४-१६-२३", "content_sanskrit": "लक्ष्मीं नदीं ततो गच्छेद्गच्छन्तीं सागरं प्रति ।\nयस्या दर्शनमात्रेण मुच्यते सर्वपातकैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005281023, "chapter_id": 25281, "verse_number": "७-४-१६-२४", "content_sanskrit": "श्राद्धे कृते तु विप्रेन्द्राः पितरो मुक्तिमाप्नुयुः ।\nदाने मनोरथावाप्तिर्जायते नात्र संशयः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005281024, "chapter_id": 25281, "verse_number": "७-४-१६-२५", "content_sanskrit": "कंबुसरस्ततो गच्छेत्तीर्थं पापप्रणाशनम् ।\nतर्पणे च कृते श्राद्धे ह्यग्निष्टोमफलं लभेत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005281025, "chapter_id": 25281, "verse_number": "७-४-१६-२६", "content_sanskrit": "कुशतीर्थं ततो गच्छेत्स्नात्वा सन्तर्पयेत्पितॄन् ।\nदानं दत्त्वा यथाशक्त्या निर्मलं लोकमाप्नुयात् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005281026, "chapter_id": 25281, "verse_number": "७-४-१६-२७", "content_sanskrit": "द्युम्नतीर्थं च तत्रैव सर्वपापप्रणाशनम् ।\nकृत्वा श्राद्धं च तत्रैव वाजिमेधफलं लभेत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005281027, "chapter_id": 25281, "verse_number": "७-४-१६-२८", "content_sanskrit": "कुशतीर्थं ततो गच्छेत्पितॄणां तृप्तिरक्षया ।\nयत्र श्राद्धात्तर्पणाच्च जायते नात्र संशयः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005281028, "chapter_id": 25281, "verse_number": "७-४-१६-२९", "content_sanskrit": "जालतीर्थं ततो गच्छेत्सर्वपापहरं शुभम् ।\nदुर्वाससा यत्र शप्ताः कोपाद्यदुकुमारकाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005281029, "chapter_id": 25281, "verse_number": "७-४-१६-३०", "content_sanskrit": "देवो जालेश्वरस्तत्र सं बभूव उमापतिः ।\nजालेश्वरं नरो दृष्ट्वा सद्यः पापात्प्रमुच्यते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005281030, "chapter_id": 25281, "verse_number": "७-४-१६-३१", "content_sanskrit": "संपूज्य देवं भक्त्या च शिवलोकमवाप्नुयात् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005281031, "chapter_id": 25281, "verse_number": "७-४-१६-३२", "content_sanskrit": "चक्रस्वामिसुतीर्थं च ततो गच्छेद्धि मानवः ।\nकृत्वा स्नानं पितॄंस्तर्प्य विष्णुलोकमवाप्नुयात् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005281032, "chapter_id": 25281, "verse_number": "७-४-१६-३३", "content_sanskrit": "जरत्कारुकृतं तीर्थं सर्वपापप्रणाशनम् ।\nस्नात्वा तत्र द्विजश्रेष्ठा न दुर्गतिमवाप्नुयात् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005281033, "chapter_id": 25281, "verse_number": "७-४-१६-३४", "content_sanskrit": "ततो गच्छेद्द्विजश्रेष्ठास्तीर्थं खञ्जनकाभिधम् ।\nआसीत्खञ्जनको नाम दैत्यश्चातिबलान्वितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005281034, "chapter_id": 25281, "verse_number": "७-४-१६-३५", "content_sanskrit": "ततः खञ्जनकं तीर्थं तस्य नाम्नेति विश्रुतम् ।\nतत्र स्नात्वा नरो याति सोमलोकं न संशयः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005281035, "chapter_id": 25281, "verse_number": "७-४-१६-३६", "content_sanskrit": "सन्ति तीर्थान्यनेकानि सुगुप्तानि द्विजोत्तमाः ।\nतानि गच्छेत्तु विप्रेन्द्राः सर्वपापापनुत्तये ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005281036, "chapter_id": 25281, "verse_number": "७-४-१६-३७", "content_sanskrit": "ततो गच्छेद्द्विजश्रेष्ठास्तीर्थमानकदुन्दुभेः ।\nशूरतीर्थं परमकं गदतीर्थमतः परम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005281037, "chapter_id": 25281, "verse_number": "७-४-१६-३८", "content_sanskrit": "गावल्गणस्य तीर्थं च अक्रूरस्य महात्मनः ।\nबलदेवस्य तीर्थं तु उग्रसेनस्य चापरम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005281038, "chapter_id": 25281, "verse_number": "७-४-१६-३९", "content_sanskrit": "अर्जुनस्य च तीर्थं तु सुभद्रातीर्थमेव च ।\nदेवकीतीर्थमाद्यं तु रोहिणीतीर्थमेव च ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005281039, "chapter_id": 25281, "verse_number": "७-४-१६-४०", "content_sanskrit": "उद्धवस्य च तीर्थं तु सारंगाख्यं तथैव च ।\nसत्यभामाकृतं तीर्थं भद्रातीर्थमतः परम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005281040, "chapter_id": 25281, "verse_number": "७-४-१६-४१", "content_sanskrit": "जामदग्न्यस्य तीर्थं तु रामस्य च महात्मनः ।\nभासतीर्थं च तत्रैव शुकतीर्थमतः परम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005281041, "chapter_id": 25281, "verse_number": "७-४-१६-४२", "content_sanskrit": "कर्दमस्य च तीर्थं तु कपिलस्य महात्मनः ।\nसोमतीर्थं च तत्रैव रोहिणीतीर्थमेव च ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005281042, "chapter_id": 25281, "verse_number": "७-४-१६-४३", "content_sanskrit": "एतान्यन्यानि संक्षेपान्मया वः कथितानि च ।\nसर्वपापहराणीह मोक्षदानि न संशयः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005281043, "chapter_id": 25281, "verse_number": "७-४-१६-४४", "content_sanskrit": "प्रच्छन्नानि द्विजवरास्तीर्थानि कलिसंक्रमे ।\nप्लावितानि समुद्रेण पांसुनाऽप्युदकेन च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005281044, "chapter_id": 25281, "verse_number": "७-४-१६-४५", "content_sanskrit": "एतन्मया वः कथितं संक्षेपात्तीर्थविस्तरम् ।\nआत्मप्रज्ञानुमानेन किमन्यच्छ्रोतुमिच्छथ ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005281045, "chapter_id": 25281, "verse_number": "७-४-१६-४६", "content_sanskrit": "शृणुयात्परया भक्त्या तीर्थयात्रामिमां द्विजाः ।\nसर्वपापविनिर्मुक्तो विष्णुलोकं स गच्छति ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005281046, "chapter_id": 25281, "verse_number": "७-४-१६-४७", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे चतुर्थे द्वारका माहात्म्ये तीर्थवृन्दमाहात्म्यवर्णनंनाम षोडशोऽध्यायः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]