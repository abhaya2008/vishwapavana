[{"id": 2177131, "chapter_id": 4744, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2177132, "chapter_id": 4744, "verse_number": "१", "content_sanskrit": "एवं सञ्चिन्तयित्वा तु द्रोणपुत्रो विशाम्पते ।\nअवतीर्य रथोपस्थाद् दध्यौ सम्प्रयतः स्थितः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2177133, "chapter_id": 4744, "verse_number": "", "content_sanskrit": "द्रौणिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2177134, "chapter_id": 4744, "verse_number": "२", "content_sanskrit": "उग्रं स्थाणुं शिवं रुद्रं शर्वमीशानमीश्वरम् ।\nगिरिशं वरदं देवं भवं भावनमव्ययम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2177135, "chapter_id": 4744, "verse_number": "३", "content_sanskrit": "शितिकण्ठमजं रुद्रं दक्षक्रतुहरं हरम् ।\nविश्वरूपं विरूपाक्षं बहुरूपमुमापतिम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2177136, "chapter_id": 4744, "verse_number": "४", "content_sanskrit": "श्मशाननिलयं दृप्तं महागणपतिं विभुम् ।\nखट्वाङ्गधारिणं मुण्डं जटिलं ब्रह्मचारिणम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2177137, "chapter_id": 4744, "verse_number": "५", "content_sanskrit": "मनसा ह्यनुचिन्त्यैनं दुष्करेणाल्पतेजसा ।\nसोऽहमात्मोपहारेण यक्षे त्रिपुरान्तकम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2177138, "chapter_id": 4744, "verse_number": "६", "content_sanskrit": "स्तुतं स्तुत्यं स्तूयमानममोघं चर्मवाससम् ।\nविलोहितं नीलकण्ठं सुसूक्ष्मं दुर्निवारणम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2177139, "chapter_id": 4744, "verse_number": "७", "content_sanskrit": "शुक्रं विश्वसृजं ब्रह्म ब्रह्मचारिणमेव च ।\nप्रतपन्तं तपो नित्यमनन्तं तपसां पतिम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2177140, "chapter_id": 4744, "verse_number": "८", "content_sanskrit": "बहुरूपं गणाध्यक्षं त्र्यक्षं पारिषदप्रियम् ।\nधनाध्यक्षप्रियसखं गौरीहृदयनन्दनम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2177141, "chapter_id": 4744, "verse_number": "९", "content_sanskrit": "(कुमारपितरं पिङ्गं गोवृषोत्तमवाहनम् ।)\nकृत्तिवाससमत्युग्रम् उमाभूषणतत्परम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2177142, "chapter_id": 4744, "verse_number": "१०", "content_sanskrit": "परं परेभ्यः परमं परं यस्मान्न विद्यते ।\nइष्वस्त्रोत्तमभर्तारं दिगन्तं देशरक्षणम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2177143, "chapter_id": 4744, "verse_number": "११", "content_sanskrit": "हिरण्यण्डकवचं देवं चारुमौलिविभूषणम् ।\nप्रपद्ये शरणं देवं परमेण समाधिना\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2177144, "chapter_id": 4744, "verse_number": "१२", "content_sanskrit": "इमां चेदापदं घोरां तराम्यद्य सुदुस्तराम् ।\nसर्वभूतोपहारेण यक्ष्येऽहं शुचिना शुचिम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2177145, "chapter_id": 4744, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2177146, "chapter_id": 4744, "verse_number": "समाप्तिः", "content_sanskrit": "इति तस्य व्यवसितं ज्ञात्वा योगात् सुकर्मणः ।\nपुरस्तात् काञ्चनी वेदी प्रादुरासीन्महात्मनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2177147, "chapter_id": 4744, "verse_number": "१४", "content_sanskrit": "तस्यां वेद्यां तदा राजन् चित्रभानुरजायत ।\nगां दिशो विदिशः खं च ज्वालाभिरभिपूरयन्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2177148, "chapter_id": 4744, "verse_number": "१५", "content_sanskrit": "दीप्तास्यनयनाश्चासन् नैकपादशिरोभुजाः ।\nद्विपशैलप्रतीकाशाः प्रादुरासन् महारथाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2177149, "chapter_id": 4744, "verse_number": "१६", "content_sanskrit": "श्ववराहोष्ट्ररूपाश्च हयगोमायुगोमुखाः ।\nऋक्षमार्जारवदना द्विपव्याघ्रमुखास्तथा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2177150, "chapter_id": 4744, "verse_number": "१७", "content_sanskrit": "(काकवक्त्राः प्लवमुखाः शुकवक्त्रास्तथैव च ।\nमहागजसवक्त्राश्च हंसवक्त्राः सितप्रभाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2177151, "chapter_id": 4744, "verse_number": "१८", "content_sanskrit": "दार्वाघाटमुखाश्चापि चापवक्त्रास्तथैव च ।\nकूर्मनक्रमुखाश्चैव शिंशुमारमुखास्तथा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2177152, "chapter_id": 4744, "verse_number": "", "content_sanskrit": "महामकरवक्त्राश्च तिमिवक्त्राश्च भारत ।\nहरिवक्त्राः क्रौञ्चमुखाः कपोताहिमुखास्तथा\t॥१९॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2177153, "chapter_id": 4744, "verse_number": "२०", "content_sanskrit": "पारावतमुखाश्चैव कङ्कवक्त्रास्तथैव च ।\nफणिवक्त्राः सहस्राक्षास्तथैव च शतोदराः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2177154, "chapter_id": 4744, "verse_number": "२१", "content_sanskrit": "निर्मांसाः काकवक्त्राश्च श्येनवक्त्राश्च भारत ।\nतथैवाशिरसो राजन् ऋक्षवक्त्राश्च भीषणाः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2177155, "chapter_id": 4744, "verse_number": "२२", "content_sanskrit": "प्रदीप्तजिह्वानेत्रास्या ज्वालावक्त्रास्तथैव च\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2177156, "chapter_id": 4744, "verse_number": "२३", "content_sanskrit": "शङ्खमालापरिकराः शङ्खध्वनिसमस्वनाः ।\nजटाधराः पञ्चशिखास्तथा मुण्डाः कृशोदराः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2177157, "chapter_id": 4744, "verse_number": "२४", "content_sanskrit": "चतुर्दंष्ट्राश्चतुर्जिह्वाः शङ्कुकर्णाः किरीटिनः ।\nमौञ्जीधराश्च राजेन्द्र तथा कुञ्चितमूर्धजाः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2177158, "chapter_id": 4744, "verse_number": "२५", "content_sanskrit": "उष्णीषिणो मकुटिनश्चारुवक्त्राः स्वलङ्कृताः ।\nपद्मोत्पलापीडधरास्तथा कुमुदधारिणः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2177159, "chapter_id": 4744, "verse_number": "२६", "content_sanskrit": "माहात्म्येन च संयुक्ताः शतशोऽथ सहस्रशः ।\nशतघ्नीचक्रहस्ताश्च तथा मुसलपाणयः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2177160, "chapter_id": 4744, "verse_number": "२७", "content_sanskrit": "मुषण्डीपाशहस्ताश्च गदाहस्ताश्च भारत ।\nपृष्ठेषु बद्धेषुधयो चित्रचापा रणोत्कटाः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2177161, "chapter_id": 4744, "verse_number": "२८", "content_sanskrit": "सध्वजाः सपाताकाश्च सघण्टाः सपरश्वथाः ।\nमहापाशोद्यतकराः तथा लगुडपाणयः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2177162, "chapter_id": 4744, "verse_number": "२९", "content_sanskrit": "शूलहस्ताः खड्गहस्ताः सर्पोच्छ्रितकिरीटिनः ।\nमहासर्पाङ्गदधराश्चित्राभरणधारिणः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2177163, "chapter_id": 4744, "verse_number": "३०", "content_sanskrit": "रजोध्वस्ताः पङ्कदिग्धाः सर्वे चित्राम्बरस्रजः ।\nनीलाङ्गाः कमलाङ्गाश्च मुण्डवक्त्रास्तथैव च\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2177164, "chapter_id": 4744, "verse_number": "३१", "content_sanskrit": "भेरीशङ्खमृदङ्गास्ते झर्झरानकगोमुखान् ।\nअवादयन् पारिषदाः संहृष्टाः कनकप्रभाः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2177165, "chapter_id": 4744, "verse_number": "३२", "content_sanskrit": "गायमानास्तथैवान्ये संहृष्टाः पुरुषर्षभाः ।\nलङ्घयन्तः प्लवन्तश्च वल्गन्तश्च महारथाः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2177166, "chapter_id": 4744, "verse_number": "३३", "content_sanskrit": "धावन्तो जवनाश्चण्डाः पवनोद्धूतमूर्धजाः ।\nमत्ता इव महानागा विनदन्तो मुहुर्मुहुः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2177167, "chapter_id": 4744, "verse_number": "३४", "content_sanskrit": "सुभीमा घोररूपाश्च शूलपट्टिशपाणयः ।\nविरागचित्रवसनाः चित्रमाल्यानुलेपनाः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2177168, "chapter_id": 4744, "verse_number": "३५", "content_sanskrit": "रत्नचित्राङ्गदधराः समुद्यतकरास्तथा ।\nहन्तारो द्विषतां शूराः प्रसह्यासह्यविक्रमाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2177169, "chapter_id": 4744, "verse_number": "३६", "content_sanskrit": "पातारोऽसृग्वसौघानां मांसान्त्रकृतभोजनाः ।\nचूडालाः कर्णिकाराश्च प्रहृष्टा मन्थरोदराः ।\nअतिह्रस्वातिदीर्घाश्च प्रलम्बाश्चातिभैरवाः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2177170, "chapter_id": 4744, "verse_number": "३७", "content_sanskrit": "विकटाः काललम्बोष्ठा बृहच्छेफाण्डपिण्डकाः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2177171, "chapter_id": 4744, "verse_number": "३८", "content_sanskrit": "महार्हनानामकुटा मुण्डाश्च जटिलाः परे ।\nसार्केन्दुग्रहनक्षत्रां द्यां कुर्वंस्ते महीतळे\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2177172, "chapter_id": 4744, "verse_number": "३९", "content_sanskrit": "उत्सहेरंश्च ये हन्तुं भूतग्रामं चतुर्विधम् ।\nये च वीतभया नित्यं हरस्य भ्रुकुटीतटाः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2177173, "chapter_id": 4744, "verse_number": "४०", "content_sanskrit": "कामकारकराः सिद्धाः त्रैलोक्यस्येश्वरेश्वराः ।\nनित्यानन्दाः प्रमुदिता वागीशा वीतमत्सराः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2177174, "chapter_id": 4744, "verse_number": "४१", "content_sanskrit": "प्राप्याष्टगुणमैश्वर्यं ये न यान्ति च विस्मयम् ।\nयेषां विस्मयते नित्यं कर्मभिर्भगवान् भवः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2177175, "chapter_id": 4744, "verse_number": "", "content_sanskrit": "मनोवाक्कर्मभिर्युक्तैर्नित्यमाराधितश्च यैः ।\n(मनोवाक्कर्मभिर्भक्तान् पाति पुत्रानिवौरसान्\t॥४२॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2177176, "chapter_id": 4744, "verse_number": "४३", "content_sanskrit": "पिबन्तोऽसृग्वसाश्चान्ये क्रुद्धा ब्रह्मद्विषां सदा ।\nचतुर्विधात्मकं सोमं ये पिबन्ति च नित्यदा\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2177177, "chapter_id": 4744, "verse_number": "४४", "content_sanskrit": "श्रुतेन ब्रह्मचर्येण तपसा च दमेन च ।\nये समाराध्य शूलाङ्कं भवसायुज्यमागताः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2177178, "chapter_id": 4744, "verse_number": "४५", "content_sanskrit": "यैरात्मभूतैर्भगवान् पार्वत्या च महेश्वरः ।\nसह भूतगणैर्भुङ्क्ते भूतभव्यभवत्प्रभुः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2177179, "chapter_id": 4744, "verse_number": "४६", "content_sanskrit": "नानाविचित्रहसितैः क्ष्वेलितोत्कृष्टगर्जितैः ।\nसंनादयन्तस्ते विश्वमश्वत्थामानमभ्ययुः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2177180, "chapter_id": 4744, "verse_number": "४७", "content_sanskrit": "संस्तुवन्तो महादेवं हाकुर्वाणाः सुवर्चसः ।\nविवर्धयिषवो द्रौणेर्महिमानं महात्मनः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2177181, "chapter_id": 4744, "verse_number": "४८", "content_sanskrit": "जिज्ञासमानास्तत् तेजः सौप्तिकं च दिदृक्षवः ।\nभीमोग्रपरिघालातशूलपट्टसपाणयः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2177182, "chapter_id": 4744, "verse_number": "४९", "content_sanskrit": "घोररूपाः समाजग्मुर्भूतसङ्घाः सहस्रशः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2177183, "chapter_id": 4744, "verse_number": "५०", "content_sanskrit": "जनयेयुर्भयं ये हि त्रैलोक्यस्यापि दर्शनात् ।\nन तु तान् प्रेक्षमाणोऽपि व्यथामुपजगाम ह\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2177184, "chapter_id": 4744, "verse_number": "५१", "content_sanskrit": "अथ द्रौणिर्धनुष्पाणिर्बद्धगोधाङ्गुलित्रवान् ।\nस्वयमेवात्मनाऽऽत्मानमुपाहारमुपाहरत्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2177185, "chapter_id": 4744, "verse_number": "५२", "content_sanskrit": "धनूंषि समिधस्तत्र पवित्राणि सिताः शराः ।\nहविरात्मवतश्चात्मा तस्मिन् भारत कर्मणि\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2177186, "chapter_id": 4744, "verse_number": "५३", "content_sanskrit": "ततः सोमेन मन्त्रेण द्रोणपुत्रः प्रतापवान् ।\nउपहारं महामन्युरथात्मानमुपाहरत्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2177187, "chapter_id": 4744, "verse_number": "५४", "content_sanskrit": "तं रुद्रं रौद्रकर्माणं रौद्रैः कर्मभिरच्युतम् ।\nअभिष्टूय महात्मानमित्युवाच कृताञ्जलिः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2177188, "chapter_id": 4744, "verse_number": "", "content_sanskrit": "द्रौणिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2177189, "chapter_id": 4744, "verse_number": "५५", "content_sanskrit": "इममात्मानमद्याहं जातमाङ्गिरसे कुले ।\nअग्नौ जुहोमि भगवन् प्रतिगृह्णीष्व मे बलिम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2177190, "chapter_id": 4744, "verse_number": "५६", "content_sanskrit": "तव भक्त्या महादेव परमेण समाधिना ।\nअस्यामापदि विश्वात्मन्नुपाकुर्मि महाव्रतः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2177191, "chapter_id": 4744, "verse_number": "५७", "content_sanskrit": "त्वयि सर्वाणि भूतानि सर्वभूतेषु चासि वै ।\nगुणानां तु प्रधानानामेकत्वं त्वयि तिष्ठति\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2177192, "chapter_id": 4744, "verse_number": "५८", "content_sanskrit": "समभूताशय विभो हविर्भूतमवस्थितम् ।\nप्रतिगृहाण मां देव यदि शक्याः परे मया\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2177193, "chapter_id": 4744, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2177194, "chapter_id": 4744, "verse_number": "५९", "content_sanskrit": "इत्युक्त्वा द्रौणिरास्थाय तां वेदीं दीप्तपावकाम् ।\nसन्त्यज्यात्मानमारुह्य कृष्णवर्त्मन्युपाविशत्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2177195, "chapter_id": 4744, "verse_number": "६०", "content_sanskrit": "तमूर्ध्वबाहुं निश्चेष्टं दृष्ट्वा हविरुपस्थितम् ।\nअब्रवीद् भगवान् साक्षान्महादेवो हसन्निव\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2177196, "chapter_id": 4744, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2177197, "chapter_id": 4744, "verse_number": "६१", "content_sanskrit": "सत्यशौचार्जवत्यागैस्तपसा नियमेन च ।\nक्षान्त्या भक्त्या च धृत्या च कर्मणा मनसा गिरा\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2177198, "chapter_id": 4744, "verse_number": "६२", "content_sanskrit": "यथावदहमाराध्यः कृष्णेनाक्लिष्टकर्मणा ।\nतस्मादिष्टतमः कृष्णाद् अन्यो मम न विद्यते\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2177199, "chapter_id": 4744, "verse_number": "६३", "content_sanskrit": "कुर्वता तस्य सम्मानं त्वां च जिज्ञासता मया ।\nपाञ्चालः सर्वदा गुप्ता मायाश्च बहुशः कृताः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2177200, "chapter_id": 4744, "verse_number": "६४", "content_sanskrit": "ततस्तस्यैव मानार्थं पाञ्चाला रक्षिता मया ।\nअभिभूतास्तु कालेन नैषामद्यास्ति जीवितम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2177201, "chapter_id": 4744, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2177202, "chapter_id": 4744, "verse_number": "६५", "content_sanskrit": "एवमुक्त्वा महेष्वासं भगवानात्मनस्तनुम् ।\nआविवेश ददौ चास्मै विमलं खड्गमुत्तमम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2177203, "chapter_id": 4744, "verse_number": "६६", "content_sanskrit": "अथाविष्टो भगवता भूयो जज्वाल तेजसा ।\nवेगवांश्चाभवद् युद्धे देवसृष्टेन तेजसा\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2177204, "chapter_id": 4744, "verse_number": "६७", "content_sanskrit": "तं दृष्ट्वा सर्वभूतानि रक्षांसि च समाद्रवन्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2177205, "chapter_id": 4744, "verse_number": "६८", "content_sanskrit": "अभितः शिबिरं यान्तं द्रोणपुत्रं महारथम् ।\nदेवदेवं हरं स्थाणुं यान्तं साक्षादिवेश्वरम्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2177206, "chapter_id": 4744, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसौप्तिकपर्वणि अश्वत्थाम्नः खड्गलाभ-शिबिरप्रवेशो नाम सप्तमोऽध्यायः ॥७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]