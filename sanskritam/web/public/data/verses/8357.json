ay_order": 9}, {"id": 900004679, "chapter_id": 8357, "verse_number": "3.10", "content_sanskrit": "कादाचित्कभ्रान्ति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900004680, "chapter_id": 8357, "verse_number": "3.11", "content_sanskrit": "अतस्तद्वद्वेदस्यापि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900004681, "chapter_id": 8357, "verse_number": "3.12", "content_sanskrit": "न चानुमानादीनामागमं विना..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900004682, "chapter_id": 8357, "verse_number": "3.13", "content_sanskrit": "तत्प्रामाण्यं च स्वत ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900004683, "chapter_id": 8357, "verse_number": "3.14", "content_sanskrit": "अप्रामाण्यस्य च..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900004684, "chapter_id": 8357, "verse_number": "3.15", "content_sanskrit": "‘वाचा विरूप नित्यया’..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900004685, "chapter_id": 8357, "verse_number": "3.16", "content_sanskrit": "नित्या वेदाः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900004686, "chapter_id": 8357, "verse_number": "3.17", "content_sanskrit": "अतः श्रुतित्वमेतासां ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900004687, "chapter_id": 8357, "verse_number": "3.18", "content_sanskrit": "तदुत्पत्तिवचश्चैव ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_