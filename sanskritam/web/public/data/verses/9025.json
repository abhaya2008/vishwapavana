[{"id": 5000025000, "chapter_id": 9025, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे पञ्चविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000025001, "chapter_id": 9025, "verse_number": "१-२५-१", "content_sanskrit": "अथ तस्याप्रमेयस्य मुनेर्वचनमुत्तमम्।\nश्रुत्वा पुरुषशार्दूलः प्रत्युवाच शुभां गिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000025002, "chapter_id": 9025, "verse_number": "१-२५-२", "content_sanskrit": "अल्पवीर्या यदा यक्षी श्रूयते मुनिपुङ्गव ।\nकथं नागसहस्रस्य धारयत्यबला बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000025003, "chapter_id": 9025, "verse_number": "१-२५-३", "content_sanskrit": "इत्युक्तं वचनं श्रुत्वा राघवस्यामितौजसः ।\nहर्षयञ्श्लक्ष्णया वाचा सलक्ष्मणमरिन्दमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000025004, "chapter_id": 9025, "verse_number": "१-२५-४", "content_sanskrit": "विश्वामित्रोऽब्रवीद् वाक्यं शृणु येन बलोत्कटा ।\nवरदानकृतं वीर्यं धारयत्यबला बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000025005, "chapter_id": 9025, "verse_number": "१-२५-५", "content_sanskrit": "पूर्वमासीन्महायक्षः सुकेतुर्नाम वीर्यवान् ।\nअनपत्यः शुभाचारः स च तेपे महत्तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000025006, "chapter_id": 9025, "verse_number": "१-२५-६", "content_sanskrit": "पितामहस्तु सुप्रीतस्तस्य यक्षपतेस्तदा ।\nकन्यारत्नं ददौ राम ताटकां नाम नामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000025007, "chapter_id": 9025, "verse_number": "१-२५-७", "content_sanskrit": "ददौ नागसहस्रस्य बलं चास्याः पितामहः ।\nन त्वेव पुत्रं यक्षाय ददौ चासौ महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000025008, "chapter_id": 9025, "verse_number": "१-२५-८", "content_sanskrit": "तां तु बालां विवर्धन्तीं रूपयौवनशालिनीम् ।\nजम्भपुत्राय सुन्दाय ददौ भार्यां यशस्विनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000025009, "chapter_id": 9025, "verse_number": "१-२५-९", "content_sanskrit": "कस्यचित्त्वथ कालस्य यक्षी पुत्रं व्यजायत ।\nमारीचं नाम दुर्धर्षं यः शापाद् राक्षसोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000025010, "chapter_id": 9025, "verse_number": "१-२५-१०", "content_sanskrit": "सुन्दे तु निहते राम अगस्त्यमृषिसत्तमम् ।\nताटका सहपुत्रेण प्रधर्षयितुमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000025011, "chapter_id": 9025, "verse_number": "१-२५-११", "content_sanskrit": "भक्षार्थं जातसंरम्भा गर्जन्ती साभ्यधावत ।\nआपतन्तीं तु तां दृष्ट्वा अगस्त्यो भगवानृषिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000025012, "chapter_id": 9025, "verse_number": "१-२५-१२", "content_sanskrit": "राक्षसत्वं भजस्वेति मारीचं व्याजहार सः ।\nअगस्त्यः परमामर्षस्ताटकामपि शप्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000025013, "chapter_id": 9025, "verse_number": "१-२५-१३", "content_sanskrit": "पुरुषादी महायक्षी विकृता विकृतानना ।\nइदं रूपम् विहायाशु दारुणं रूपमस्तु ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000025014, "chapter_id": 9025, "verse_number": "१-२५-१४", "content_sanskrit": "सैषा शापकृतामर्षा ताटका क्रोधमूर्छिता ।\nदेशमुत्सादयत्येनमगस्त्याचरितं शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000025015, "chapter_id": 9025, "verse_number": "१-२५-१५", "content_sanskrit": "एनां राघव दुर्वृत्तां यक्षीं परमदारुणाम् ।\nगोब्राह्मणहितार्थाय जहि दुष्टपराक्रमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000025016, "chapter_id": 9025, "verse_number": "१-२५-१६", "content_sanskrit": "नह्येनां शापसंसृष्टां कश्चिदुत्सहते पुमान् ।\nनिहन्तुं त्रिषु लोकेषु त्वामृते रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000025017, "chapter_id": 9025, "verse_number": "१-२५-१७", "content_sanskrit": "नहि ते स्त्रीवधकृते घृणा कार्या नरोत्तम ।\nचातुर्वर्ण्यहितार्थं कर्तव्यं राजसूनुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000025018, "chapter_id": 9025, "verse_number": "१-२५-१८", "content_sanskrit": "नृशंसमनृशंसं वा प्रजारक्षणकारणात् ।\nपातकं वा सदोषं वा कर्तव्यं रक्षता सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000025019, "chapter_id": 9025, "verse_number": "१-२५-१९", "content_sanskrit": "राज्यभारनियुक्तानामेष धर्मः सनातनः ।\nअधर्म्यां जहि काकुत्स्थ धर्मो ह्यस्यां न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000025020, "chapter_id": 9025, "verse_number": "१-२५-२०", "content_sanskrit": "श्रूयते हि पुरा शक्रो विरोचनसुतां नृप ।\nपृथिवीं हन्तुमिच्छन्तीं मन्थरामभ्यसूदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000025021, "chapter_id": 9025, "verse_number": "१-२५-२१", "content_sanskrit": "विष्णुना च पुरा राम भृगुपत्नी पतिव्रता ।\nअनिन्द्रं लोकमिच्छन्ती काव्यमाता निषूदिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000025022, "chapter_id": 9025, "verse_number": "१-२५-२२", "content_sanskrit": "एतैश्चान्यैश्च बहुभी राजपुत्रैर्महात्मभिः ।\nअधर्मसहिता नार्यो हताः पुरुषसत्तमैः ।\nतस्मादेनां घृणां त्यक्त्वा जहि मच्छासनान्नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000025023, "chapter_id": 9025, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे पञ्चविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]