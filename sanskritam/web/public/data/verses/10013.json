[{"id": 6000013000, "chapter_id": 10013, "verse_number": null, "content_sanskrit": "अथ त्रयोदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000013001, "chapter_id": 10013, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.001.m4a", "display_order": 2}, {"id": 6000013002, "chapter_id": 10013, "verse_number": "१-१३-१", "content_sanskrit": "सम्प्रस्थिते द्वारकायां जिष्णौ बन्धुदिदृक्षया।\nज्ञातुं मायामनुष्यस्य वासुदेवस्य चेहितम्॥ १/१३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.002.m4a", "display_order": 3, "topics": [{"text": "बन्धुदिदृक्षया द्वारकां गते पार्थे चिरायति सति युधिष्‍ठिरेण नानाविधदुर्निमित्तदर्शनम्", "range": "१–२१"}]}, {"id": 6000013003, "chapter_id": 10013, "verse_number": "१-१३-२", "content_sanskrit": "व्यतीताः कतिचिन्मासास्तदा तु शतशो नृपः।\nददर्श घोररूपाणि निमित्तानि भृगूद्वह॥ १/१३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.003.m4a", "display_order": 4}, {"id": 6000013004, "chapter_id": 10013, "verse_number": "१-१३-३", "content_sanskrit": "कालस्य च गतिं रौद्रां विपर्यस्तर्तुधर्मिणः।\nपापीयसीं नृणां वार्तां क्रोधलोभानृतात्मनाम्॥ १/१३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.004.m4a", "display_order": 5}, {"id": 6000013005, "chapter_id": 10013, "verse_number": "१-१३-४", "content_sanskrit": "जिह्मप्रायं व्यवहृतं साध्यमिश्रं ‍च सौहृदम्।\nपितृमातृसुहृद्भ्रातृदम्पतीनां ‍च कल्किताम्॥ १/१३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.005.m4a", "display_order": 6}, {"id": 6000013006, "chapter_id": 10013, "verse_number": "१-१३-५", "content_sanskrit": "निमित्तान्यप्यरिष्‍टानि काले त्वनुगते नृणाम्।\nलोभाद्यधर्मप्रकृतिं दृष्‍ट्वोवाचानुजं नृपः॥ १/१३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.006.m4a", "display_order": 7}, {"id": 6000013007, "chapter_id": 10013, "verse_number": null, "content_sanskrit": "युधिष्‍ठिर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.007.m4a", "display_order": 8}, {"id": 6000013008, "chapter_id": 10013, "verse_number": "१-१३-६", "content_sanskrit": "सम्प्रेषिते द्वारकायां जिष्णौ बन्धुदिदृक्षया।\nज्ञातुं ‍च पुण्यश्लोकस्य कृष्णस्य च विचेष्‍टितम्॥ १/१३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.008.m4a", "display_order": 9}, {"id": 6000013009, "chapter_id": 10013, "verse_number": "१-१३-७", "content_sanskrit": "गताः सप्‍ताधुना मासा भीमसेन तवानुजः।\nनायाति कस्य वा हेतोर्नाहं वेदेदमञ्जसा॥ १/१३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.009.m4a", "display_order": 10}, {"id": 6000013010, "chapter_id": 10013, "verse_number": "१-१३-८", "content_sanskrit": "अपि देवर्षिणाऽऽदिष्‍टः स कालः प्रत्युपस्थितः।\nयदाऽऽत्मनोऽङ्गमाक्रीडं भगवानुत्सिसृक्षति॥ १/१३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.010.m4a", "display_order": 11}, {"id": 6000013011, "chapter_id": 10013, "verse_number": "१-१३-९", "content_sanskrit": "येषां नः सम्पदो राज्यं दाराः प्राणाः कुलं प्रजाः।\nआसन्सपत्नविजयो लोकाश्‍च यदनुग्रहात्॥ १/१३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.011.m4a", "display_order": 12}, {"id": 6000013012, "chapter_id": 10013, "verse_number": "१-१३-१०", "content_sanskrit": "पश्योत्पातान्नरव्याघ्र भौमान्दिव्यान्सदैहिकान्।\nघोरमाशंसतोऽदूराद्भयं नो बुद्धिमोहनम्॥ १/१३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.012.m4a", "display_order": 13}, {"id": 6000013013, "chapter_id": 10013, "verse_number": "१-१३-११", "content_sanskrit": "ऊर्वक्षिबाहवो मह्यं स्फुरन्त्यङ्ग पुनः पुनः।\nवेपथुश्‍चापि हृदये आराद्दास्यन्ति विप्रियम्॥ १/१३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.013.m4a", "display_order": 14}, {"id": 6000013014, "chapter_id": 10013, "verse_number": "१-१३-१२", "content_sanskrit": "शिवैषोद्यन्तमरुणमभिरौत्यनलानना।\nमामङ्ग सारमेयोऽयमभिधावत्यभीतवत्॥ १/१३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.014.m4a", "display_order": 15}, {"id": 6000013015, "chapter_id": 10013, "verse_number": "१-१३-१३", "content_sanskrit": "शस्ताः कुर्वन्ति मां सव्यं दक्षिणं पशवोऽपरे।\nवाहांश्‍च पुरुषव्याघ्र लक्षये रुदतो मम॥ १/१३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.015.m4a", "display_order": 16}, {"id": 6000013016, "chapter_id": 10013, "verse_number": "१-१३-१४", "content_sanskrit": "मृत्युदूतः कपोतोऽग्नावुलूकः कम्पयन्मनः।\nप्रत्युलूकश्‍च हुङ्कारैरनिद्रौ शून्यमिच्छतः॥ १/१३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.016.m4a", "display_order": 17}, {"id": 6000013017, "chapter_id": 10013, "verse_number": "१-१३-१५", "content_sanskrit": "धूम्रा दिशः परिधयः कम्पते कुः सहाद्रिभिः।\nनिर्घातश्‍च महांस्तात साकं ‍च स्तनयित्नुभिः॥ १/१३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.017.m4a", "display_order": 18}, {"id": 6000013018, "chapter_id": 10013, "verse_number": "१-१३-१६", "content_sanskrit": "वायुर्वाति खरस्पर्शो रजसा विसृजंस्तमः।\nअसृग्वर्षन्ति जलदा बीभत्समिव सर्वतः॥ १/१३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.018.m4a", "display_order": 19}, {"id": 6000013019, "chapter_id": 10013, "verse_number": "१-१३-१७", "content_sanskrit": "सूर्यं हतप्रभं पश्य ग्रहमर्दं मिथो दिवि।\nससङ्कुले तु भगणे ज्वलिते इव रोदसी॥ १/१३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.019.m4a", "display_order": 20}, {"id": 6000013020, "chapter_id": 10013, "verse_number": "१-१३-१८", "content_sanskrit": "नद्यो नदाश्‍च क्षुभिताः सरांसि च मनांसि च।\nन ज्वलत्यग्निराज्येन कालोऽयं किं विधास्यति॥ १/१३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.020.m4a", "display_order": 21}, {"id": 6000013021, "chapter_id": 10013, "verse_number": "१-१३-१९", "content_sanskrit": "न पिबन्ति स्तनं वत्सा न दुह्यन्ति च मातरः। रुदन्त्यश्रुमुखा गावो न हृष्यन्त्यृषभा व्रजे।\nदैवतानि रुदन्तीव स्विद्यन्ति ह्युच्चलन्ति च॥ १/१३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.021.m4a", "display_order": 22}, {"id": 6000013022, "chapter_id": 10013, "verse_number": "१-१३-२०", "content_sanskrit": "इमे जनपदा ग्रामाः पुरोद्यानाकराश्रमाः।\nभ्रष्‍टश्रियो निरानन्दाः किमघं दर्शयन्ति नः॥ १/१३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.022.m4a", "display_order": 23}, {"id": 6000013023, "chapter_id": 10013, "verse_number": "१-१३-२१", "content_sanskrit": "मन्य एतैर्महोत्पातैर्नूनं भगवतः पदैः।\nअनन्यपुरुषस्‍त्रीभिर्हीना भूर्हतसौभगा॥ १/१३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.023.m4a", "display_order": 24}, {"id": 6000013024, "chapter_id": 10013, "verse_number": "१-१३-२२", "content_sanskrit": "इति चिन्तयतस्तस्य दृष्‍टारिष्‍टेन चेतसा।\nराज्ञः प्रत्यागमद्ब्रह्मन्यदुपुर्याः कपिध्वजः॥ १/१३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.024.m4a", "display_order": 25, "topics": [{"text": "ततः प्रत्यागतमर्जुनं प्रति युधिष्‍ठिरेण द्वारकाजनकुशलप्रश्नपूर्वकं तन्मुखमालिन्यादिकारणप्रश्नः", "range": "२२–४४"}]}, {"id": 6000013025, "chapter_id": 10013, "verse_number": "१-१३-२३", "content_sanskrit": "तं पादयोर्निपतितमयथापूर्वमातुरम्।\nअधोवदनमब्बिन्दून्मुञ्चन्तं नयनाब्जयोः॥ १/१३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.025.m4a", "display_order": 26}, {"id": 6000013026, "chapter_id": 10013, "verse_number": "१-१३-२४", "content_sanskrit": "विलोक्योद्विग्नहृदयो विच्छायमनुजं नृप।\nपृच्छति स्म सुहृन्मध्ये संस्मरन्नारदेरितम्॥ १/१३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.026.m4a", "display_order": 27}, {"id": 6000013027, "chapter_id": 10013, "verse_number": null, "content_sanskrit": "युधिष्‍ठिर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.027.m4a", "display_order": 28}, {"id": 6000013028, "chapter_id": 10013, "verse_number": "१-१३-२५", "content_sanskrit": "कच्चिदानर्तपुर्यां नः स्वजनाः सुखमासते।\nमधुभोजदशार्हार्हसात्वतान्धकवृष्णयः॥ १/१३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.028.m4a", "display_order": 29}, {"id": 6000013029, "chapter_id": 10013, "verse_number": "१-१३-२६", "content_sanskrit": "शूरो मातामहः कच्चित्स्वस्त्यास्ते चाथ मारिषः।\nमातुलः सानुजः कच्चित्कुशल्यानकदुन्दुभिः॥ १/१३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.029.m4a", "display_order": 30}, {"id": 6000013030, "chapter_id": 10013, "verse_number": "१-१३-२७", "content_sanskrit": "सप्‍तस्वसारस्तत्पत्न्यो मातुलान्याः सहात्मजाः।\nआसते सस्नुषा क्षेमं देवकीप्रमुखाः स्‍त्रियः॥ १/१३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.030.m4a", "display_order": 31}, {"id": 6000013031, "chapter_id": 10013, "verse_number": "१-१३-२८", "content_sanskrit": "कच्चिद्राजाऽऽहुको जीवत्यसत्पुत्रोऽस्य चानुजः।\nहृदीकः ससुतोऽक्रूरो जयन्तगदसारणाः॥ १/१३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.031.m4a", "display_order": 32}, {"id": 6000013032, "chapter_id": 10013, "verse_number": "१-१३-२९", "content_sanskrit": "आसते कुशलं कच्चिद्ये च शत्रुजिदादयः।\nकच्चिदास्ते सुखं रामो भगवान्सात्वतां पतिः॥ १/१३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.032.m4a", "display_order": 33}, {"id": 6000013033, "chapter_id": 10013, "verse_number": "१-१३-३०", "content_sanskrit": "प्रद्युम्नः सर्ववृष्णीनां सुखमास्ते महारथः।\nगम्भीररयोऽनिरुद्धो वर्तते भगवानुत॥ १/१३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.033.m4a", "display_order": 34}, {"id": 6000013034, "chapter_id": 10013, "verse_number": "१-१३-३१", "content_sanskrit": "सुषेणश्‍चारुदेष्णश्‍च साम्बो जाम्बवतीसुतः।\nअन्ये च कार्ष्णिप्रवराः सपुत्रा ऋषभादयः॥ १/१३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.034.m4a", "display_order": 35}, {"id": 6000013035, "chapter_id": 10013, "verse_number": "१-१३-३२", "content_sanskrit": "तथैवानुचराः शौरेः श्रुतसेनोद्धवादयः।\nसुनन्दनन्दशीर्षण्या ये चान्ये सात्वतर्षभाः॥ १/१३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.035.m4a", "display_order": 36}, {"id": 6000013036, "chapter_id": 10013, "verse_number": "१-१३-३३", "content_sanskrit": "अपि स्वस्त्यासते सर्वे रामकृष्णभुजाश्रयाः।\nअपि स्मरन्ति कुशलमस्माकं बद्धसौहृदाः॥ १/१३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.036.m4a", "display_order": 37}, {"id": 6000013037, "chapter_id": 10013, "verse_number": "१-१३-३४", "content_sanskrit": "भगवानपि गोविन्दो ब्रह्मण्यो भक्‍तवत्सलः।\nकच्चित्पुरे सुधर्मायां सुखमास्ते सुहृद्वृतः॥ १/१३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.037.m4a", "display_order": 38}, {"id": 6000013038, "chapter_id": 10013, "verse_number": "१-१३-३५", "content_sanskrit": "मङ्गलाय च लोकानां क्षेमाय च भवाय च।\nआस्ते यदुकुलाम्भोधावाद्योऽनन्तसखः पुमान्॥ १/१३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.038.m4a", "display_order": 39}, {"id": 6000013039, "chapter_id": 10013, "verse_number": "१-१३-३६", "content_sanskrit": "यद्बाहुदण्डैर्गुप्‍तायां स्वपुर्यां यदवोऽर्चिताः।\nक्रीडन्ति परमानन्दं महापौरुषिका इव॥ १/१३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.039.m4a", "display_order": 40}, {"id": 6000013040, "chapter_id": 10013, "verse_number": "१-१३-३७", "content_sanskrit": "यत्पादशुश्रूषणमुख्यकर्मणा सत्यादयो द्व्यष्‍टसहस्रयोषितः।\nनिर्जित्य सङ्ख्ये त्रिदशांस्तदाशिषो हरन्ति वज्रायुधवल्‍लभोचिताः॥ १/१३/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.040.m4a", "display_order": 41}, {"id": 6000013041, "chapter_id": 10013, "verse_number": "१-१३-३८", "content_sanskrit": "यद्बाहुदण्डाभ्युदयानुजीविनो यदुप्रवीरा ह्यकुतोभया मुहुः।\nअधिक्रमन्त्यङ्घ्रिभिराहतां बलात् सभां सुधर्मां सुरसत्तमोचिताम्॥ १/१३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.041.m4a", "display_order": 42}, {"id": 6000013042, "chapter_id": 10013, "verse_number": "१-१३-३९", "content_sanskrit": "कच्चित्तेऽनामयं तात भ्रष्‍टतेजा विभासि मे।\nअलब्धमानोऽवज्ञातः किं वा तात चिरोषितः॥ १/१३/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.042.m4a", "display_order": 43}, {"id": 6000013043, "chapter_id": 10013, "verse_number": "१-१३-४०", "content_sanskrit": "कच्चिन्नाभिहतो भावैः शब्दादिभिरमङ्गलैः।\nन दत्तं युक्‍तमर्थिभ्य आशया यत्प्रतिश्रुतम्॥ १/१३/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.043.m4a", "display_order": 44}, {"id": 6000013044, "chapter_id": 10013, "verse_number": "१-१३-४१", "content_sanskrit": "कच्चित्त्वं ब्राह्यणं बालं गां वृद्धं रोगिणं स्‍त्रियम्।\nशरण्योपसृतं सत्त्वं नात्याक्षीः शरणप्रदः॥ १/१३/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.044.m4a", "display_order": 45}, {"id": 6000013045, "chapter_id": 10013, "verse_number": "१-१३-४२", "content_sanskrit": "कच्चित्त्वं नागमोऽगम्यां गम्यां वाऽसत्कृतां स्‍त्रियम्।\nपराजितो वाऽथ भवान्नोत्तमैर्नाधमैः पथि॥ १/१३/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.045.m4a", "display_order": 46}, {"id": 6000013046, "chapter_id": 10013, "verse_number": "१-१३-४३", "content_sanskrit": "अपिस्वित्पर्यभुङ्‍क्थास्त्वं सम्भोज्यावृद्धबालकान्।\nजुगुप्सितं कर्म किञ्चित्कृतवानसदक्षमम्॥ १/१३/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.046.m4a", "display_order": 47}, {"id": 6000013047, "chapter_id": 10013, "verse_number": "१-१३-४४", "content_sanskrit": "कच्चित्प्रेष्‍ठतमेनाथ हृदयेनाऽत्मबन्धुना।\nशून्योऽसि रहितो नित्यं मन्यसे तेऽन्यथा हि रुक्॥ १/१३/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_013/BhP_01.013.047.m4a", "display_order": 48}, {"id": 6000013048, "chapter_id": 10013, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां प्रथमस्कन्धे त्रयोदशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]