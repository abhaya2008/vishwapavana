[{"id": 5000123000, "chapter_id": 9123, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे षड्चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000123001, "chapter_id": 9123, "verse_number": "२-४६-१", "content_sanskrit": "ततस्तु तमसातीरं रम्यमाश्रित्य राघवः।\nसीतामुद्वीक्ष्य सौमित्रिमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000123002, "chapter_id": 9123, "verse_number": "२-४६-२", "content_sanskrit": "इयमद्य निशा पूर्वा सौमित्रे प्रहिता वनम्।\nवनवासस्य भद्रं ते न चोत्कण्ठितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000123003, "chapter_id": 9123, "verse_number": "२-४६-३", "content_sanskrit": "पश्य शून्यान्यरण्यानि रुदन्तीव समन्ततः।\nयथानिलयमायद्भिर्निलीनानि मृगद्विजैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000123004, "chapter_id": 9123, "verse_number": "२-४६-४", "content_sanskrit": "अद्यायोध्या तु नगरी राजधानी पितुर्मम।\nसस्त्रीपुंसा गतानस्मान् शोचिष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000123005, "chapter_id": 9123, "verse_number": "२-४६-५", "content_sanskrit": "अनुरक्ता हि मनुजा राजानं बहुभिर्गुणैः।\nत्वां च मां च नरव्याघ्र शत्रुघ्नभरतौ तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000123006, "chapter_id": 9123, "verse_number": "२-४६-६", "content_sanskrit": "पितरं चानुशोचामि मातरं च यशस्विनीम्।\nअपि नान्धौ भवेतां नौ रुदन्तौ तावभीक्ष्णशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000123007, "chapter_id": 9123, "verse_number": "२-४६-७", "content_sanskrit": "भरतः खलु धर्मात्मा पितरं मातरं च मे।\nधर्मार्थकामसहितैर्वाक्यैराश्वासयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000123008, "chapter_id": 9123, "verse_number": "२-४६-८", "content_sanskrit": "भरतस्यानृशंसत्वं संचिन्त्याहं पुनः पुनः।\nनानुशोचामि पितरं मातरं च महाभुज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000123009, "chapter_id": 9123, "verse_number": "२-४६-९", "content_sanskrit": "त्वया कार्यं नरव्याघ्र मामनुव्रजता कृतम्।\nअन्वेष्टव्या हि वैदेह्या रक्षणार्थं सहायता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000123010, "chapter_id": 9123, "verse_number": "२-४६-१०", "content_sanskrit": "अद्भिरेव हि सौमित्रे वत्स्याम्यद्य निशामिमाम्।\nएतद्धि रोचते मह्यं वन्येऽपि विविधे सति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000123011, "chapter_id": 9123, "verse_number": "२-४६-११", "content_sanskrit": "एवमुक्त्वा तु सौमित्रिं सुमन्त्रमपि राघवः।\nअप्रमत्तस्त्वमश्वेषु भव सौम्येत्युवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000123012, "chapter_id": 9123, "verse_number": "२-४६-१२", "content_sanskrit": "सोऽश्वान् सुमन्त्रः संयम्य सूर्येऽस्तं समुपागते।\nप्रभूतयवसान् कृत्वा बभूव प्रत्यनन्तरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000123013, "chapter_id": 9123, "verse_number": "२-४६-१३", "content_sanskrit": "उपास्य तु शिवां संध्यां दृष्ट्वा रात्रिमुपागताम्।\nरामस्य शयनं चक्रे सूतः सौमित्रिणा सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000123014, "chapter_id": 9123, "verse_number": "२-४६-१४", "content_sanskrit": "तां शय्यां तमसातीरे वीक्ष्य वृक्षदलैर्वृताम्।\nरामः सौमित्रिणा सार्धं सभार्यः संविवेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000123015, "chapter_id": 9123, "verse_number": "२-४६-१५", "content_sanskrit": "सभार्यं सम्प्रसुप्तं तु श्रान्तं सम्प्रेक्ष्य लक्ष्मणः।\nकथयामास सूताय रामस्य विविधान् गुणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000123016, "chapter_id": 9123, "verse_number": "२-४६-१६", "content_sanskrit": "जाग्रतोरेव तां रात्रिं सौमित्रेरुदितो रविः।\nसूतस्य तमसातीरे रामस्य ब्रुवतो गुणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000123017, "chapter_id": 9123, "verse_number": "२-४६-१७", "content_sanskrit": "गोकुलाकुलतीरायास्तमसाया विदूरतः।\nअवसत् तत्र तां रात्रिं रामः प्रकृतिभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000123018, "chapter_id": 9123, "verse_number": "२-४६-१८", "content_sanskrit": "उत्थाय च महातेजाः प्रकृतीस्ता निशाम्य च।\nअब्रवीद् भ्रातरं रामो लक्ष्मणं पुण्यलक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000123019, "chapter_id": 9123, "verse_number": "२-४६-१९", "content_sanskrit": "अस्मद्‍व्यपेक्षान् सौमित्रे निर्व्यपेक्षान् गृहेष्वपि।\nवृक्षमूलेषु संसक्तान् पश्य लक्ष्मण साम्प्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000123020, "chapter_id": 9123, "verse_number": "२-४६-२०", "content_sanskrit": "यथैते नियमं पौराः कुर्वन्त्यस्मन्निवर्तने।\nअपि प्राणान् न्यसिष्यन्ति न तु त्यक्ष्यन्ति निश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000123021, "chapter_id": 9123, "verse_number": "२-४६-२१", "content_sanskrit": "यावदेव तु संसुप्तास्तावदेव वयं लघु।\nरथमारुह्य गच्छामः पन्थानमकुतोभयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000123022, "chapter_id": 9123, "verse_number": "२-४६-२२", "content_sanskrit": "अतो भूयोऽपि नेदानीमिक्ष्वाकुपुरवासिनः।\nस्वपेयुरनुरक्ता मा वृक्षमूलेषु संश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000123023, "chapter_id": 9123, "verse_number": "२-४६-२३", "content_sanskrit": "पौरा ह्यात्मकृताद् दुःखाद् विप्रमोच्या नृपात्मजैः।\nन तु खल्वात्मना योज्या दुःखेन पुरवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000123024, "chapter_id": 9123, "verse_number": "२-४६-२४", "content_sanskrit": "अब्रवील्लक्ष्मणो रामं साक्षाद् धर्ममिव स्थितम्।\nरोचते मे तथा प्राज्ञ क्षिप्रमारुह्यतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000123025, "chapter_id": 9123, "verse_number": "२-४६-२५", "content_sanskrit": "अथ रामोऽब्रवीत् सूतं शीघ्रं संयुज्यतां रथः।\nगमिष्यामि ततोऽरण्यं गच्छ शीघ्रमितः प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000123026, "chapter_id": 9123, "verse_number": "२-४६-२६", "content_sanskrit": "सूतस्ततः संत्वरितः स्यन्दनं तैर्हयोत्तमैः।\nयोजयित्वा तु रामस्य प्राञ्जलिः प्रत्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000123027, "chapter_id": 9123, "verse_number": "२-४६-२७", "content_sanskrit": "अयं युक्तो महाबाहो रथस्ते रथिनां वर।\nत्वरयाऽऽरोह भद्रं ते ससीतः सहलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000123028, "chapter_id": 9123, "verse_number": "२-४६-२८", "content_sanskrit": "तं स्यन्दनमधिष्ठाय राघवः सपरिच्छदः।\nशीघ्रगामाकुलावर्तां तमसामतरन्नदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000123029, "chapter_id": 9123, "verse_number": "२-४६-२९", "content_sanskrit": "स संतीर्य महाबाहुः श्रीमान् शिवमकण्टकम्।\nप्रापद्यत महामार्गमभयं भयदर्शिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000123030, "chapter_id": 9123, "verse_number": "२-४६-३०", "content_sanskrit": "मोहनार्थं तु पौराणां सूतं रामोऽब्रवीद् वचः।\nउदङ्मुखः प्रयाहि त्वं रथमारुह्य सारथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000123031, "chapter_id": 9123, "verse_number": "२-४६-३१", "content_sanskrit": "मुहूर्तं त्वरितं गत्वा निवर्तय रथं पुनः।\nयथा न विद्युः पौरा मां तथा कुरु समाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000123032, "chapter_id": 9123, "verse_number": "२-४६-३२", "content_sanskrit": "रामस्य तु वचः श्रुत्वा तथा चक्रे च सारथिः।\nप्रत्यागम्य च रामस्य स्यन्दनं प्रत्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000123033, "chapter_id": 9123, "verse_number": "२-४६-३३", "content_sanskrit": "तौ सम्प्रयुक्तं तु रथं समास्थितौ\nतदा ससीतौ रघुवंशवर्धनौ।\nप्रचोदयामास ततस्तुरंगमान्\nस सारथिर्येन पथा तपोवनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000123034, "chapter_id": 9123, "verse_number": "२-४६-३४", "content_sanskrit": "ततः समास्थाय रथं महारथः\nससारथिर्दाशरथिर्वनं ययौ।\nउदङ्मुखं तं तु रथं चकार\nप्रयाणमाङ्गल्यनिमित्तदर्शनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000123035, "chapter_id": 9123, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे षड्चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]