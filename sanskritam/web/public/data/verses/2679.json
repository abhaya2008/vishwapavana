[{"id": 2079000, "chapter_id": 2679, "verse_number": "१२-१८४-०x", "content_sanskrit": "भरद्वाज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2079001, "chapter_id": 2679, "verse_number": "१२-१८४-१", "content_sanskrit": "यदि प्राणयते वायुर्वायुरेव विचेष्टते।\nश्वसित्याभाषते चैव तस्माज्जीवो निरर्थकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2079002, "chapter_id": 2679, "verse_number": "१२-१८४-२", "content_sanskrit": "यदूष्मभाव आग्नेयो वह्निना पच्यते यदि।\nअग्निर्जरयते चैतत्तस्माज्जीवो निरर्थकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2079003, "chapter_id": 2679, "verse_number": "१२-१८४-३", "content_sanskrit": "जन्तोः प्रमीयमाणस्य जीवो नैवोपलभ्यते।\nवायुरेव जहात्येनमूष्मभावश्च नश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2079004, "chapter_id": 2679, "verse_number": "१२-१८४-४", "content_sanskrit": "यदि वायुमयो जीवः संश्लेषो यदि वायुना।\nवायुमण्डलवद्दृश्येद्गच्छन्सह मरुद्गणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2079005, "chapter_id": 2679, "verse_number": "१२-१८४-५", "content_sanskrit": "श्लेष्मं वा यदि वा जीवः सह तेन प्रणश्यति।\nमहार्णववियुक्तत्वादन्यत्सलिलभाजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2079006, "chapter_id": 2679, "verse_number": "१२-१८४-६", "content_sanskrit": "यत्क्षिपेत्सलिलं कूपे प्रदीपं वा हुताशने।\nतन्नश्यत्युभयं तद्वज्जीवो वातानलात्मकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2079007, "chapter_id": 2679, "verse_number": "१२-१८४-७", "content_sanskrit": "पञ्च साधारणो ह्यस्मिञ्शरीरे जीवितं कुतः।\nतेषामन्यतरत्यागाच्चतुर्णां नास्ति संग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2079008, "chapter_id": 2679, "verse_number": "१२-१८४-८", "content_sanskrit": "नश्यन्त्यापो ह्यनाधाराद्वायुरुच्छ्वासनिग्रहात्।\nनश्यते कोष्ठभेदात्खमग्निर्नश्यत्यभोजनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2079009, "chapter_id": 2679, "verse_number": "१२-१८४-९", "content_sanskrit": "व्याधिप्राणपरिक्लेशैर्मेदिनी चैव शीर्यते।\nपीडितेऽन्यतमे ह्येषां संघातो याति पञ्चताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2079010, "chapter_id": 2679, "verse_number": "१२-१८४-१०", "content_sanskrit": "तस्मिन्पञ्चत्वमापन्ने जीवः किमनुधावति।\nकिं वेदयति वा जीवः किं शृणोति ब्रवीति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2079011, "chapter_id": 2679, "verse_number": "१२-१८४-११", "content_sanskrit": "एषा गौः परलोकस्थं तारयिष्यति मामिति।\nयो दत्त्वा म्रियते जन्तुः सा गौः कं तारयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2079012, "chapter_id": 2679, "verse_number": "१२-१८४-१२", "content_sanskrit": "गौश्च प्रतिग्रहीता च दाता चैव समं यदा।\nइहैव विलयं यान्ति कुतस्तेषां समागमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2079013, "chapter_id": 2679, "verse_number": "१२-१८४-१३", "content_sanskrit": "विहगैरुपभुक्तस्य शैलाग्नात्पतितस्य च।\nअग्निना चोपयुक्तस्य कुतः संजीवनं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2079014, "chapter_id": 2679, "verse_number": "१२-१८४-१४", "content_sanskrit": "छिन्नस्य यदि वृक्षस्य न मूलं प्रतिरोहति।\nबीजान्यस्य प्ररोहन्ति मृतः क्व पुनरेष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2079015, "chapter_id": 2679, "verse_number": "१२-१८४-१५", "content_sanskrit": "बीजमात्रं पुरा सृष्टं यदेतत्परिवर्तते।\nमृतामृताः प्रणश्यन्ति बीजाद्वीजं प्रवर्तते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2079016, "chapter_id": 2679, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि चतुरशीत्यधिकशततमोऽध्यायः॥ १८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]