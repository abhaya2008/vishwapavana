[{"id": 2043458, "chapter_id": 1974, "verse_number": "६-२३-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2043459, "chapter_id": 1974, "verse_number": "६-२३-१", "content_sanskrit": "धार्तराष्ट्रबलं दृष्ट्वा युद्धाय समुपस्थितम्।\nअर्जुनस्य हितार्थाय कृष्णो वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2043460, "chapter_id": 1974, "verse_number": "६-२३-२x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2043461, "chapter_id": 1974, "verse_number": "६-२३-२", "content_sanskrit": "शुचिर्भूत्वा महाबाहो संग्रामाभिमुखे स्थितः।\nपराजयाय श्त्रुणां दुर्गास्तोत्रमुदीरय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2043462, "chapter_id": 1974, "verse_number": "६-२३-३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2043463, "chapter_id": 1974, "verse_number": "६-२३-३", "content_sanskrit": "एवमुक्तोऽर्जुनः सङ्ख्ये वासुदेवेन धीमता।\nअवतीर्य रथात्पार्थः स्तोत्रमाह कृताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2043464, "chapter_id": 1974, "verse_number": "६-२३-४x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2043465, "chapter_id": 1974, "verse_number": "६-२३-४", "content_sanskrit": "नमस्ते सिद्धसेनानि आर्ये मन्दरवासिनि ।\nकुमारि कालि कापालि कपिले कृष्णपिङ्गले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2043466, "chapter_id": 1974, "verse_number": "६-२३-५", "content_sanskrit": "भद्रकालि नमस्तुभ्यं महाकालि नमोऽस्तु ते ।\nचण्डि चण्डे नमस्तुभ्यं तारिणि वरवर्णिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2043467, "chapter_id": 1974, "verse_number": "६-२३-६", "content_sanskrit": "कात्यायनि महाभागे करालि विजये जये।\nशिखिपिच्छध्वजधरे नानाभरणभूषिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2043468, "chapter_id": 1974, "verse_number": "६-२३-७", "content_sanskrit": "अट्टशूलप्रहरणे स्वङ्गखेटकधारिणि ।\nगोपेन्द्रस्यानुजे ज्येष्ठे नन्दगोपकुलोद्भवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2043469, "chapter_id": 1974, "verse_number": "६-२३-८", "content_sanskrit": "महिषासृक्प्रिये नित्यं कौशिकि पीतवासिनि ।\nअट्टहासे कोकमुखे नमस्तेऽस्तु रणप्रिये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2043470, "chapter_id": 1974, "verse_number": "६-२३-९", "content_sanskrit": "उभे शाकम्भरि श्वेते कृष्णे कैटभनाशिनि ।\nहिरण्याश्चि विरूपाक्षि सुधूम्राक्षि नमोऽस्तु ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2043471, "chapter_id": 1974, "verse_number": "६-२३-१०", "content_sanskrit": "वेदश्रुति महापुण्ये ब्रह्मण्ये जातवेदसि ।\nजम्बूकटकचैत्येषु नित्यं सन्निहितालये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2043472, "chapter_id": 1974, "verse_number": "६-२३-११", "content_sanskrit": "त्वं ब्रह्मविद्या विद्यानां महानिद्रा च देहिनाम्।\nस्कन्दमातर्भगवति दुर्गे कान्तारवासिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2043473, "chapter_id": 1974, "verse_number": "६-२३-१२", "content_sanskrit": "स्वाहाकारः स्वधा चैव कला काष्ठा सरस्वती।\nसावित्री वेदमाता च तथा वेदान्त उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2043474, "chapter_id": 1974, "verse_number": "६-२३-१३", "content_sanskrit": "स्तुतासि त्वं महादेवि विशुद्धेनान्तरात्मना ।\nजयो भवतु मे नित्यं त्वत्प्रसादाद्रणाजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2043475, "chapter_id": 1974, "verse_number": "६-२३-१४", "content_sanskrit": "कान्तारभयदुर्गेषु भक्तानां चालयेषु च ।\nनित्यं वससि पाताले युद्धे जयसि दानवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2043476, "chapter_id": 1974, "verse_number": "६-२३-१५", "content_sanskrit": "त्वं जम्भनी मोहिनी च माया ह्रीः श्रीस्तथैव च ।\nसंध्या प्रभावती चैव सावित्री जननी तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2043477, "chapter_id": 1974, "verse_number": "६-२३-१६", "content_sanskrit": "तुष्टिः पुष्टिर्धृतिर्दीप्तिश्चन्द्रादित्यविवर्धिनी ।\nभूतिर्भूतिमतां सङ्ख्ये वीक्ष्यसे सिद्धचारणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2043478, "chapter_id": 1974, "verse_number": "६-२३-१७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2043479, "chapter_id": 1974, "verse_number": "६-२३-१७", "content_sanskrit": "ततः पार्थस्य विज्ञाय भक्तिं मानववत्सला। ६-२३-१७bअन्तरिक्षगतोवाच गोविन्दस्याग्रतः स्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2043480, "chapter_id": 1974, "verse_number": "६-२३-१८x", "content_sanskrit": "देव्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2043481, "chapter_id": 1974, "verse_number": "६-२३-१८", "content_sanskrit": "स्वल्पेनैव तु कालेन शत्रूञ्जेष्यसि पाण्डव ।\nनरस्त्वमसि दुर्धर्ष नारायणसहायवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2043482, "chapter_id": 1974, "verse_number": "६-२३-१९", "content_sanskrit": "अजेयस्त्वं रणेऽरीणामपि वज्रभृतः स्वयम् ।\nइत्येवमुक्त्वा वरदा क्षणेनान्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2043483, "chapter_id": 1974, "verse_number": "६-२३-२०", "content_sanskrit": "लब्ध्वा वरं तु कौन्तेयो मेने विजयमात्मनः ।\nआरुरोह ततः पार्थो रथं परमसंमतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2043484, "chapter_id": 1974, "verse_number": "६-२३-२१", "content_sanskrit": "कृष्णार्जुनावेकरथौ दिव्यौ शङ्खौः प्रदध्मतुः ।\nय इदं पठते स्तोत्रं कल्य उत्थाय मानवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2043485, "chapter_id": 1974, "verse_number": "६-२३-२२", "content_sanskrit": "यक्षरक्षःपिशाचेभ्यो न भयं विद्यते सदा।\nन चापि रिपवस्तेभ्यः सर्पाद्या ये च दंष्ट्रिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2043486, "chapter_id": 1974, "verse_number": "६-२३-२३", "content_sanskrit": "न भयं विद्यते तस्य सदा राजकुलादपि ।\nविवादेक जयमाप्नोति बद्धो मुच्यति बन्धनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2043487, "chapter_id": 1974, "verse_number": "६-२३-२४", "content_sanskrit": "दुर्गं तरति चावश्यं तथा चोरैर्विमुच्यते।\nसंग्रामे विजयेन्नित्यं लक्ष्मीं प्राप्नोति केवलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2043488, "chapter_id": 1974, "verse_number": "६-२३-२५", "content_sanskrit": "आरोग्यबलसंपन्नो जीवेद्वर्षशतं तथा ।\nएतद्दृष्टं प्रसादात्तु मया व्यासस्य धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2043489, "chapter_id": 1974, "verse_number": "६-२३-२६", "content_sanskrit": "मोहादेतौ न जानन्ति नरनारायणावृषी ।\nतव पुत्रा दुरात्मानः सर्वे मन्युवशानुगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2043490, "chapter_id": 1974, "verse_number": "६-२३-२७", "content_sanskrit": "प्राप्तकालमिदं वाक्यं कालपाशेन कुण्ठिताः ।\nद्वैपायनो नारदश्च कण्वो रामस्तथानघः ।\nअवारयंस्तव सुतं न चासौ तद्गृहीतवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2043491, "chapter_id": 1974, "verse_number": "६-२३-२८", "content_sanskrit": "यत्र धर्मो द्युतिः कान्तिर्यत्र ह्रीः श्रीस्तथा मतिः।\nयतो धर्मस्ततः कृष्णो यतः कृष्णस्ततो जयः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2043492, "chapter_id": 1974, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभरते भीष्मपर्वणि भगवद्गीतापर्वणि त्रयोविंशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]