[{"id": 2034217, "chapter_id": 1738, "verse_number": "४-६१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2034218, "chapter_id": 1738, "verse_number": "४-६१-१", "content_sanskrit": "एतस्मिन्नन्तरे तत्र महावीर्यपराक्रमः।\nआजगाम महाबाहुः कृपः शस्त्रभृतांवरः ।\nअर्जुनं प्रतियोद्धुं वै युद्धकामो महारथः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2034219, "chapter_id": 1738, "verse_number": "४-६१-२", "content_sanskrit": "अथं द्रौणे रथं त्यक्त्वा कृपस्य रथमुत्तमम् ।\nआजगामार्जुनस्तूर्णं सूर्यवैश्वानरप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2034220, "chapter_id": 1738, "verse_number": "४-६१-३", "content_sanskrit": "तौ वीर सूर्यसंकाशौ योत्स्यमानौ महारथौ।\nवाषिकाविव जीमूतौ व्यरोचेतां व्यवस्थितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2034221, "chapter_id": 1738, "verse_number": "४-६१-४", "content_sanskrit": "श्रगृह्य गाण्डिवं लोके विश्रुतं पुनरर्जुनः।\nअभ्ययाद्भरतश्रेष्ठो विनिघ्नञ्शरमालया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2034222, "chapter_id": 1738, "verse_number": "४-६१-५", "content_sanskrit": "कृपश्च धनुरादाय तथैवार्जुनमभ्यगाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2034223, "chapter_id": 1738, "verse_number": "४-६१-६", "content_sanskrit": "प्रगृह्य बलवच्चापं नाराचान्रक्तभोजनान्।\nकृपः पार्थाय चिक्षेप शंतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2034224, "chapter_id": 1738, "verse_number": "४-६१-७", "content_sanskrit": "जीमूत इव धर्मान्ते शरवर्पं विमुञ्चति ।\nनन्दयन्सुहृदः सर्वान्प्रत्ययुध्यत फल्गुनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2034225, "chapter_id": 1738, "verse_number": "४-६१-८", "content_sanskrit": "विकृष्य बलवच्चापं पाण्डवोऽमितविक्रमः।\nचचार समरे पार्थश्चित्रमार्गान्विदर्शयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2034226, "chapter_id": 1738, "verse_number": "४-६१-९", "content_sanskrit": "सर्वाश्चैव दिशो बाणैः प्रदिशश्च महाबलः ।\nएकच्छायमिवाकाशं सर्वतः कृतवान्प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2034227, "chapter_id": 1738, "verse_number": "४-६१-१०", "content_sanskrit": "प्राच्छादयदमेयात्मा पार्थः शरशतैः कृपम् ।\nउद्गतः समरे मेघो धाराभिरिव पर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2034228, "chapter_id": 1738, "verse_number": "४-६१-११", "content_sanskrit": "स शरैरर्पितः ऋद्धः शितैरग्निशिखोपमैः ।\nकृपो बभूव समरे विधूमोऽग्निरिव ज्वलंम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2034229, "chapter_id": 1738, "verse_number": "४-६१-१२", "content_sanskrit": "ततः शरसहस्रेण पार्थमप्रतिमौजसम् ।\nअर्दयित्वा महाबाहुर्ननाद समरे कृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2034230, "chapter_id": 1738, "verse_number": "४-६१-१३", "content_sanskrit": "ततः कनकपुङ्खेन शरेण नतपर्वणा।\nबिभेद समरे पार्थः कृपस्य ध्वजमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2034231, "chapter_id": 1738, "verse_number": "४-६१-१४", "content_sanskrit": "ततः पश्चान्महातेजा नाराचान्सूर्यसन्निभान् ।\nजग्राह समरे पार्थो भूयो बहुशिलीमुखान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2034232, "chapter_id": 1738, "verse_number": "४-६१-१५", "content_sanskrit": "तैस्तदातीं महाबाहुः कृपस्य रथरक्षिणः ।\nजघान क्षत्रियश्रेष्ठो युध्यमानान्महारथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2034233, "chapter_id": 1738, "verse_number": "४-६१-१६", "content_sanskrit": "चन्द्रकेतुः सुकेतुश्च चित्राश्वो मणिमांस्तद।\nमुञ्जमौलिश्च विक्रान्तो हेमवर्णो भयावहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2034234, "chapter_id": 1738, "verse_number": "४-६१-१७", "content_sanskrit": "सुरथोऽतिरथश्चैव सुपेणोऽरिष्ट एव च।\nनृकेतुश्च सहानीकास्ते निषेदुर्गतासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2034235, "chapter_id": 1738, "verse_number": "४-६१-१८", "content_sanskrit": "तान्निहत्य ततः पार्थो निमेपादिव भारत ।\nपुनरन्यान्समाधत्त त्रयोदश शिलीमुखान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2034236, "chapter_id": 1738, "verse_number": "४-६१-१९", "content_sanskrit": "अथास्य युगमेकेन चतुर्भिश्चतुरो हयान्।\nषष्ठेन तु शिरः सङ्ख्ये कृपस्य रथसारथेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2034237, "chapter_id": 1738, "verse_number": "४-६१-२०", "content_sanskrit": "त्रिभिस्त्रिवेणुं बलवान्द्वाभ्यामक्षं महाबलः ।\nद्वादशेन तु भल्लेन कृपस्य सशरं धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2034238, "chapter_id": 1738, "verse_number": "४-६१-२१", "content_sanskrit": "छित्त्वा वज्रनिकाशेन फल्गुनः प्रहसन्निव।\nत्रयोदशेनेन्द्रसमः प्रत्यविध्यत्स्तनान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2034239, "chapter_id": 1738, "verse_number": "४-६१-२२", "content_sanskrit": "स छिन्नधन्वा विरथो हताश्वो हतसारथिः ।\nअथ शक्तिं परामृश्य सूर्यवैश्वानरप्रभाम् ।\nचिक्षेप सहसा क्रुद्धः पार्थायाद्भुतकर्मणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2034240, "chapter_id": 1738, "verse_number": "४-६१-२३", "content_sanskrit": "तामर्जुनस्तथारूपां शक्तिं हेमपरिष्कृताम्।\nरुरोध सायकैस्तीक्ष्णैरर्धचन्द्रमुखैश्च ताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2034241, "chapter_id": 1738, "verse_number": "४-६१-२४", "content_sanskrit": "आपतन्तीं महोल्काभां चिच्छेद दशभिः शरैः।\nसापतद्दशधा भूमौ पार्थेन निहता शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2034242, "chapter_id": 1738, "verse_number": "४-६१-२५", "content_sanskrit": "शक्त्यां तु विनिकृत्तायां विरथः शरपीडितः।\nगदापाणिरवप्लुत्य रथात्तूर्णममित्रहा।\nगदां चिक्षेप सहसा पार्थायामिततेजसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2034243, "chapter_id": 1738, "verse_number": "४-६१-२६", "content_sanskrit": "सा च मुक्ता गदा गुर्वी रूपेणास्य परिष्कृता ।\nअर्जुनस्य शरैर्नुन्ना प्रतिमार्गं जगाम सा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2034244, "chapter_id": 1738, "verse_number": "४-६१-२७", "content_sanskrit": "अथ खङ्गं समुद्धृत्य शतचन्द्रं च भानुमत्।\nइयेष पाण्डवं हन्तुं कृपो लघुपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2034245, "chapter_id": 1738, "verse_number": "४-६१-२८", "content_sanskrit": "स शरद्वत्सुतस्तूर्णं महाचार्यः सुशिक्षितः ।\nखेचरेव चचारकैः क्रमाच्चर्मासिधृग्भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2034246, "chapter_id": 1738, "verse_number": "४-६१-२९", "content_sanskrit": "ततः क्षुरप्रैः कौन्तेयो दशभिः खङ्गचर्मणी ।\nनिमेषादिव चिच्छेद तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2034247, "chapter_id": 1738, "verse_number": "४-६१-३०", "content_sanskrit": "विषण्णवदमस्तत्र विनाशात्खङ्गचर्मणोः।\nदन्तैर्दन्तच्छदान्दष्ट्वा चुकोप हृदि दीर्घवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2034248, "chapter_id": 1738, "verse_number": "४-६१-३१", "content_sanskrit": "भवत्विति पुनश्चोक्त्वा युद्धापगमनोद्यतः।\nअश्वत्थाम्नस्तु स रथं कृपः समभिपुप्लुवे।\nस्वस्रीयस्य महातेजा जग्राह च धनुः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2034249, "chapter_id": 1738, "verse_number": "४-६१-३२", "content_sanskrit": "एतस्मिन्नन्तरे क्रुद्धो भीष्मो द्रोणमथाब्रवीत्।\nदृष्ट्वा कृपं फल्गुनेन पीडितं चोर्जितं च तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2034250, "chapter_id": 1738, "verse_number": "४-६१-३३", "content_sanskrit": "एकैकमस्मान्संग्रामे पराजयति फल्गुनः।\nअहं द्रोणश्च कर्णश्च द्रौणिर्गौतम एव च।\nअन्ये च बहवः शूरा वयं जेष्याम वासविम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2034251, "chapter_id": 1738, "verse_number": "४-६१-३४", "content_sanskrit": "समागम्य ततः सर्वे भीष्मद्रोणमुखा रथाः।\nअर्जुनं सहसा युक्ताः प्रत्ययुध्यन्त भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2034252, "chapter_id": 1738, "verse_number": "४-६१-३५", "content_sanskrit": "स सायकमयैर्जालैः सर्वतस्तान्महारथान्।\nप्राच्छादयच्छरौघैस्तान्नीहार इव पर्वतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2034253, "chapter_id": 1738, "verse_number": "४-६१-३६", "content_sanskrit": "नदद्भिश्च महानागैर्हेषमाणैश्च वाजिभिः ।\nभेरीशङ्खनिनादैश्च स शब्दस्तुमुलोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2034254, "chapter_id": 1738, "verse_number": "४-६१-३७", "content_sanskrit": "नागाश्वकायान्निर्भिद्य लौहानि कवचानि च।\nपार्थस्य शरवर्षाणि न्यपतञ्शतशः क्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2034255, "chapter_id": 1738, "verse_number": "४-६१-३८", "content_sanskrit": "त्वरमाणः शरानस्यन्पाण्डवस्तु प्रकाशते।\nमध्यंदिनगतोऽर्चिष्माञ्छरदीव दिवाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2034256, "chapter_id": 1738, "verse_number": "४-६१-३९", "content_sanskrit": "अविषह्य शरान्सर्वे पार्थचापच्युपान्रणे।\nउदक्प्रयान्ति विध्वस्ता रथेभ्यो रथिनस्तदा।\nसादिनश्चाश्वपृष्ठेभ्यो भूमौ चापि पदातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2034257, "chapter_id": 1738, "verse_number": "४-६१-४०", "content_sanskrit": "शरैस्तु ताड्यमानानां कवचानां महात्मनाम्।\nताम्रराजतलौहानां प्रादुरासीन्महास्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2034258, "chapter_id": 1738, "verse_number": "४-६१-४१", "content_sanskrit": "छन्नमायोधनं जज्ञे शरीरैर्गतचेतसाम्।\nश्रान्त्या गलितशस्त्राणां पततामश्वसादिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2034259, "chapter_id": 1738, "verse_number": "४-६१-४२", "content_sanskrit": "शून्यान्कुर्वन्रथोपस्थान्मानवैरास्तृणोन्महीम्।\nप्रनृत्यन्निव संग्रामे चापहस्ते धनंजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2034260, "chapter_id": 1738, "verse_number": "४-६१-४३", "content_sanskrit": "शिरांस्यपातयत्सङ्ख्ये क्षत्रियाणां नरर्षभः।\nश्रुत्वा गाण्डीवनिर्घोषं विष्णूजितमिवाशने।\nत्रस्तानि सर्वसैन्यानि व्यलीयन्त च भागश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2034261, "chapter_id": 1738, "verse_number": "४-६१-४४", "content_sanskrit": "कुण्डलोष्णीषधारीणि जातरूपस्रजानि च।\nपतितानि स्म दृश्यन्ते शिरांसि करणमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2034262, "chapter_id": 1738, "verse_number": "४-६१-४५", "content_sanskrit": "विशिखोन्मथितैर्गात्रैर्बाहुभिश्च सकार्मुकैः।\nसहस्ताभरणैश्चान्यैः प्रच्छन्ना भाति मेदिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2034263, "chapter_id": 1738, "verse_number": "४-६१-४६", "content_sanskrit": "शिरसां पात्यमानानां समरे निशितैः शरैः।\nअश्मवृष्टिरिवाकाशादभवद्भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2034264, "chapter_id": 1738, "verse_number": "४-६१-४७", "content_sanskrit": "दर्शयित्वा तदाऽऽत्मानं रौद्रं रौद्रपराक्रमः।\nजघान समरे शूराञ्छतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2034265, "chapter_id": 1738, "verse_number": "४-६१-४८", "content_sanskrit": "तथावरुद्धश्चारण्ये दशवर्षाणि त्रीणि च।\nक्रोधाग्निमुत्ससर्जाजौ धार्तराष्ट्रेषु पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2034266, "chapter_id": 1738, "verse_number": "४-६१-४९", "content_sanskrit": "तस्य तद्दहतः सैन्यं दृष्ट्वा चास्य पराक्रमम्।\nसर्वे शान्तिपरा योधा धार्तराष्ट्रस्य भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2034267, "chapter_id": 1738, "verse_number": "४-६१-५०", "content_sanskrit": "यथा नलवनं नागः प्रभिन्नः षष्टिहायनः।\nएवं सर्वानपामृद्रादर्जुनः शस्त्रतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2034268, "chapter_id": 1738, "verse_number": "४-६१-५१", "content_sanskrit": "विद्राव्य च ततः सैन्यं त्रासयित्वा महारथान्।\nअर्जुनो जयतांश्रेष्ठः पर्यावर्तत भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2034269, "chapter_id": 1738, "verse_number": "४-६१-५२", "content_sanskrit": "तस्य मार्गान्विचरतो निघ्नतश्च रणाजिरे ।\nप्रावर्तत नदी घोरा शोणितान्त्रतरङ्गिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2034270, "chapter_id": 1738, "verse_number": "४-६१-५३", "content_sanskrit": "अस्थिशैवालसंबाधां संग्रामे पार्थनिर्मिताम् ।\nशरचापप्लवां घोरां मांसशोणितकर्दमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2034271, "chapter_id": 1738, "verse_number": "४-६१-५४", "content_sanskrit": "रथोडुपां चान्त्रसर्पां केशशैवालशाड्वलाम्।\nकरवालासिपाठीनां चामरोष्णीषफेनिलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2034272, "chapter_id": 1738, "verse_number": "४-६१-५५", "content_sanskrit": "अश्वग्रीवामहावर्तां कबन्धजलमानुषाम्।\nकाककङ्करुतां तीव्रां सारसक्रौञ्चनादिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2034273, "chapter_id": 1738, "verse_number": "४-६१-५६", "content_sanskrit": "सिंहनादमहानादां शङ्खस्वनमहास्वनाम् ।\nवीरोत्तमाङ्गपद्माढ्यां शरचापमहानलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2034274, "chapter_id": 1738, "verse_number": "४-६१-५७", "content_sanskrit": "पदातिमत्स्यकलुषां गजशीर्षककच्छपाम्।\nगोमायुगसंघुष्टां मांसमञ्जाभिकर्दमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2034275, "chapter_id": 1738, "verse_number": "४-६१-५८", "content_sanskrit": "प्रावर्तयन्नदीं घोरां पिशाचगणसेविताम् ।\nअपारामनिवासां च रक्तोदां सर्वतो वृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2034276, "chapter_id": 1738, "verse_number": "४-६१-५९", "content_sanskrit": "अभीक्ष्णमकरोत्पार्थो नदीमुत्तमशोणिताम्।\nगजवर्ममहाद्वीपामश्वदेहमहाशिलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2034277, "chapter_id": 1738, "verse_number": "४-६१-६०", "content_sanskrit": "पदातिदेहसंघाटां रथावलिमहातरुम्।\nकेशशाद्वलसंछन्नां सुतरां भीतिदां नृणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2034278, "chapter_id": 1738, "verse_number": "४-६१-६१", "content_sanskrit": "अगाधरक्तोदवहां यमसागरगामिनीम्।\nदुस्तरां भीरुमर्त्यानां शूराणां सुतरां नृप।\nप्रावर्तयन्नदीमेवं भीषणां पाकशासनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2034279, "chapter_id": 1738, "verse_number": "४-६१-६२", "content_sanskrit": "तस्याददानस्य शरान्सन्दधानस्य मुञ्चतः।\nविकर्षतश्च गाण्डीवं न किंचिद्ददृशेऽन्तरम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2034280, "chapter_id": 1738, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि एकषष्टितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]