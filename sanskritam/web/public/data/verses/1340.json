[{"id": 2016198, "chapter_id": 1340, "verse_number": "२-८१-१", "content_sanskrit": "दुर्योधन उवाच॥\nयस्य नास्ति निजा प्रज्ञा केवलं तु बहुश्रुतः।\nन स जानाति शास्त्रार्थं दर्वी सूपरसानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2016199, "chapter_id": 1340, "verse_number": "२-८१-२", "content_sanskrit": "जानन्वै मोहयति मां नावि नौरिव संयता।\nस्वार्थे किं नावधानं ते उताहो द्वेष्टि मां भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2016200, "chapter_id": 1340, "verse_number": "२-८१-३", "content_sanskrit": "न सन्तीमे धार्तराष्ट्रा येषां त्वमनुशासिता।\nभविष्यमर्थमाख्यासि सर्वदा कृत्यमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2016201, "chapter_id": 1340, "verse_number": "२-८१-४", "content_sanskrit": "परनेयोऽग्रणीर्यस्य स मार्गान्प्रतिमुह्यति।\nपन्थानमनुगच्छेयुः कथं तस्य पदानुगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2016202, "chapter_id": 1340, "verse_number": "२-८१-५", "content_sanskrit": "राजन्परिणतप्रज्ञो वृद्धसेवी जितेन्द्रियः।\nप्रतिपन्नान्स्वकार्येषु संमोहयसि नो भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2016203, "chapter_id": 1340, "verse_number": "२-८१-६", "content_sanskrit": "लोकवृत्ताद्राजवृत्तमन्यदाह बृहस्पतिः।\nतस्माद्राज्ञाऽप्रमत्तेन स्वार्थश्चिन्त्यः सदैव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2016204, "chapter_id": 1340, "verse_number": "२-८१-७", "content_sanskrit": "क्षत्रियस्य महाराज जये वृत्तिः समाहिता।\nस वै धर्मस्त्वधर्मो वा स्ववृत्तौ का परीक्षणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2016205, "chapter_id": 1340, "verse_number": "२-८१-८", "content_sanskrit": "प्रकालयेद्दिशः सर्वाः प्रतोदेनेव सारथिः।\nप्रत्यमित्रश्रियं दीप्तां जिघृक्षुर्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2016206, "chapter_id": 1340, "verse_number": "२-८१-९", "content_sanskrit": "प्रच्छन्नो वा प्रकाशो वा योगो योऽरिं प्रबाधते।\nतद्वै शस्त्रं शस्त्रविदां न शस्त्रं छेदनं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2016207, "chapter_id": 1340, "verse_number": "२-८१-१०", "content_sanskrit": "शत्रुश्चैव हि मित्रं च न लेख्यं न च मातृका।\nयो वै सन्तापयति यं स शत्रुः प्रोच्यते नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2016208, "chapter_id": 1340, "verse_number": "२-८१-११", "content_sanskrit": "असन्तोषः श्रियो मूलं तस्मात्तं कामयाम्यहम्।\nसमुच्छ्रये यो यतते स राजन्परमो नयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2016209, "chapter_id": 1340, "verse_number": "२-८१-१२", "content_sanskrit": "ममत्वं हि न कर्तव्यमैश्वर्ये वा धनेऽपि वा।\nपूर्वावाप्तं हरन्त्यन्ये राजध्रमं हि तं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2016210, "chapter_id": 1340, "verse_number": "२-८१-१३", "content_sanskrit": "अद्रोहसमंय कृत्वा चिच्छेद नमुचेः शिरः।\nशक्रः साऽभिमता तस्य रिपौ वृत्तिः सनातनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2016211, "chapter_id": 1340, "verse_number": "२-८१-१४", "content_sanskrit": "द्वावेतौ ग्रसते भूमिः सर्पो बिलशयानिव।\nराजानं चाविरोद्धारं ब्राह्मणं चाप्रवासिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2016212, "chapter_id": 1340, "verse_number": "२-८१-१५", "content_sanskrit": "नास्ति वै जातितः शत्रुः पुरुषस्य विशाम्पते।\nयेन साधारणी वृत्तिः स शत्रुर्नेतरो जनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2016213, "chapter_id": 1340, "verse_number": "२-८१-१६", "content_sanskrit": "शत्रुपक्षं समृध्यन्तं यो मोहात्समुपेक्षते।\nव्याधिराप्यायित इव तस्य मूलं छिनत्ति सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2016214, "chapter_id": 1340, "verse_number": "२-८१-१७", "content_sanskrit": "अल्पोऽपि ह्यरिरत्यर्थं वर्धमानः पराक्रमैः।\nवल्मीको मूलज इव ग्रसते वृक्षमन्तिकात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2016215, "chapter_id": 1340, "verse_number": "२-८१-१८", "content_sanskrit": "आजमीढ रिपोर्लक्ष्मीर्मा ते रोचिष्ट भारत।\nएष भारः सत्ववतां न यः शिरसि धिष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2016216, "chapter_id": 1340, "verse_number": "२-८१-१९", "content_sanskrit": "जन्मवृद्धिमिवार्थानां यो वृद्धिमाभिकाङ्क्षते।\nएधते ज्ञातिषु स वै सद्यो वृद्धिर्हि विक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2016217, "chapter_id": 1340, "verse_number": "२-८१-२०", "content_sanskrit": "नाप्राप्य पाण्डवैश्वर्यं संशयो मे भविष्यति।\nअवाप्स्ये वा श्रियं तां हि शयिष्ये वा हतो युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2016218, "chapter_id": 1340, "verse_number": "२-८१-२१", "content_sanskrit": "एतादृशस्य किं मेऽद्य जीवितेन विशाम्पते।\nवर्धन्ते पाण्डवा नित्यं वयं स्वस्थिरवृद्धयः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2016219, "chapter_id": 1340, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि द्यूतपर्वणि एकाशीतितमोऽध्यायः॥८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]