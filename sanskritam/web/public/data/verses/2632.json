[{"id": 2076789, "chapter_id": 2632, "verse_number": "१२-१३७-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2076790, "chapter_id": 2632, "verse_number": "१२-१३७-१", "content_sanskrit": "अनागतविधाता च प्रत्युत्पन्नमतिश्च यः।\nद्वावेतौ सुखमेधेते दीर्घसूत्री विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2076791, "chapter_id": 2632, "verse_number": "१२-१३७-२", "content_sanskrit": "अत्रैव चेदमव्यग्रं शृण्वाख्यानमनुत्तमम्।\nद्रीर्घसूत्रमुपाश्रित्य कार्याकार्यविनिश्चये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2076792, "chapter_id": 2632, "verse_number": "१२-१३७-३", "content_sanskrit": "नातिगाधे जलस्थाने सुहृदः कुशलास्त्रयः।\nप्रभूतमत्स्ये कौन्तेय बभूवुः सहचारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2076793, "chapter_id": 2632, "verse_number": "१२-१३७-४", "content_sanskrit": "तत्रैकः प्राप्तकालज्ञो दीर्घदर्शी तथाऽपरः।\nदीर्घसूत्रश्च तत्रैकस्त्रयाणां जलचारिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2076794, "chapter_id": 2632, "verse_number": "१२-१३७-५", "content_sanskrit": "क्रदाचित्तज्जलस्थानं मत्स्यबन्धाः समन्ततः।\nस्रावयामासुरथो निम्नेषु विविधैर्मुखैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2076795, "chapter_id": 2632, "verse_number": "१२-१३७-६", "content_sanskrit": "क्षीयमाणं तद्बुद्ध्वा जलस्थानं भयागमे।\nअब्रवीद्दीर्घदर्शी तु तावुभौ सुहृदौ तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2076796, "chapter_id": 2632, "verse_number": "१२-१३७-७", "content_sanskrit": "ज्ञयमापत्समुत्पन्ना सर्वेषां सलिलौकसाम्।\nशीघ्रमन्यत्र गच्छामः पन्था यावन्न शुष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2076797, "chapter_id": 2632, "verse_number": "१२-१३७-८", "content_sanskrit": "अनागतमनर्थं हि सुनयैर्यः प्रबाधते।\nस न संशयमाप्नोति तथाऽन्यत्र व्रजामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2076798, "chapter_id": 2632, "verse_number": "१२-१३७-९", "content_sanskrit": "शीर्घसूत्रस्तु यस्तत्र सोऽब्रवीत्सम्यगुष्यताम्।\nन तु कार्या त्वरा तावदिति मे निश्चिता मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2076799, "chapter_id": 2632, "verse_number": "१२-१३७-१०", "content_sanskrit": "अथ संप्रतिपत्तिज्ञस्त्वब्रवीद्दीर्घदर्शिनम्।\nप्राप्ते काले न मे किंचिन्न्यायतः परिहास्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2076800, "chapter_id": 2632, "verse_number": "१२-१३७-११", "content_sanskrit": "एवप्नुक्तो निराक्रामद्दीर्घदर्शी महामतिः।\nअगाम स्रोतसैकेन गम्भीरं सलिलाशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2076801, "chapter_id": 2632, "verse_number": "१२-१३७-१२", "content_sanskrit": "ततः प्रसृततोयं तं प्रसमीक्ष्य जलाशयम्।\nबबन्धुर्विविधैर्योगैर्मत्स्यान्मत्स्योपजीविनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2076802, "chapter_id": 2632, "verse_number": "१२-१३७-१३", "content_sanskrit": "विलोड्यमाने तस्मिंस्तु स्रुततोये जलाशये।\nअगच्छद्ग्रहणं तत्र दीर्घसूत्रः सहापरै----॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2076803, "chapter_id": 2632, "verse_number": "१२-१३७-१४", "content_sanskrit": "उद्दानं क्रियमाणं तु मत्स्यानां ------।\nप्रविश्यान्तरमन्येषामग्रसत्प्रति-------॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2076804, "chapter_id": 2632, "verse_number": "१२-१३७-१५", "content_sanskrit": "ग्रस्तमेव तदुद्दानं गृहीत्वा----सः।\nसर्वानेव च तांस्तत्र ते वि--- इति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2076805, "chapter_id": 2632, "verse_number": "१२-१३७-१६", "content_sanskrit": "ततः प्रक्षाल्यमानेषु मत्स्येषु विपुले जले।\nत्वक्त्वा रज्जुं प्रमुक्तोसौ शीघ्रं संप्रतिपत्तिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2076806, "chapter_id": 2632, "verse_number": "१२-१३७-१७", "content_sanskrit": "दीर्घसूत्रस्तु मन्दात्मा हीनेयुद्धिरचेतनः।\nमरणं प्राप्तवान्मूढो यथैवोपहतेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2076807, "chapter_id": 2632, "verse_number": "१२-१३७-१८", "content_sanskrit": "एवं प्राप्ततमं कालं यो मोहान्नावबुध्यते।\nस विनश्यति वै क्षिप्रं दीर्घसूत्रो यथा झषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2076808, "chapter_id": 2632, "verse_number": "१२-१३७-१९", "content_sanskrit": "आदौ न कुरुते श्रेयः कुशलोऽस्मीति यः पुमान्।\nस हि संशयमाप्नोति यथा संप्रतिपत्तिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2076809, "chapter_id": 2632, "verse_number": "१२-१३७-२०", "content_sanskrit": "अनागतविधाता च प्रत्युत्पन्नमतिश्च यः।\nद्वावेतौ सुखमेधेते दीर्घसूत्री विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2076810, "chapter_id": 2632, "verse_number": "१२-१३७-२१", "content_sanskrit": "काष्ठा कला मुहूर्ताश्च दिनरात्र्यः क्षणा लवाः।\nमासाः पक्षाः षडृतवः कालः संवत्सराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2076811, "chapter_id": 2632, "verse_number": "१२-१३७-२२", "content_sanskrit": "पृथिवी देश इत्युक्तः स च कालो न दृश्यते।\nअभिप्रेतार्थसिद्ध्यर्थं दूरतो न्यायतस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2076812, "chapter_id": 2632, "verse_number": "१२-१३७-२३", "content_sanskrit": "एतौ धर्मार्थशास्त्रेषु मोक्षशास्त्रेषु चर्षिभिः।\nप्रधानाविति निर्दिष्टौ कामे चाभिमतौ नृणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2076813, "chapter_id": 2632, "verse_number": "१२-१३७-२४", "content_sanskrit": "परीक्ष्यकारी युक्तश्च स सम्यगुपपादयेत्।\nदेशकालावभिप्रेतौ तोभ्यां फलमवाप्नुयात्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2076814, "chapter_id": 2632, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि सप्तत्रिंशदधिकशततमोऽध्यायः॥ १३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]