[{"id": 2064207, "chapter_id": 2363, "verse_number": "८-८४-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2064208, "chapter_id": 2363, "verse_number": "८-८४-१", "content_sanskrit": "xxxxxxxxxxxप्रबरैर्वलैर्भीममभिद्रुतम्।\nxxxxxxxxxx कौन्तेयमुस्थिहीर्षुर्धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2064209, "chapter_id": 2363, "verse_number": "८-८४-२", "content_sanskrit": "xxxxxxxxx सेनां मारत सायकैः।\nxxxxxxxxxx परवीरान्धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2064210, "chapter_id": 2363, "verse_number": "८-८४-३", "content_sanskrit": "xxxxxxxxxxx शरजालानि भागशः।\nअदृश्यन्त तथान्ये च निजघ्नुस्तव वाहिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2064211, "chapter_id": 2363, "verse_number": "८-८४-४", "content_sanskrit": "स पक्षिसङ्घाचरितमाकाशं पूरयञ्शरैः।\nधनञ्जयो महाबाहुः कुरूणामन्तकोऽमयत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2064212, "chapter_id": 2363, "verse_number": "८-८४-५", "content_sanskrit": "ततो भल्लैः क्षुरप्रैश्च नाराचैर्विमलैरपि।\nगात्राणि प्राच्छिनत्पार्थः शिरांसि च चकर्त ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2064213, "chapter_id": 2363, "verse_number": "८-८४-६", "content_sanskrit": "छिन्नगात्रैर्विकवचैर्विशिरस्कैः समन्ततः।\nपातितैश्च पतद्भिश्च योधैरासीत्समावृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2064214, "chapter_id": 2363, "verse_number": "८-८४-७", "content_sanskrit": "धनञ्जयशराभ्यस्तैः स्यन्दनाश्वरथद्विपैः।\nसञ्छिन्नभिन्नविध्वस्तैर्व्यङ्गाङ्गावयवैः स्तृता।\nगतसत्वैः ससत्वैश्च संवृताऽऽसीद्वसुन्धरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2064215, "chapter_id": 2363, "verse_number": "८-८४-८", "content_sanskrit": "सुदुर्गमा सुविषमा घोराऽत्यर्थं सुदुर्दृशा।\nरणभूमिरभूद्राजन्महावैतरणी यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2064216, "chapter_id": 2363, "verse_number": "८-८४-९", "content_sanskrit": "ईषाचक्राक्षभल्लैश्च व्यश्वैः साश्वैश्च युध्यताम्।\nससूतैर्हतसूतैश्च रथैः स्तीर्णाऽभवन्मही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2064217, "chapter_id": 2363, "verse_number": "८-८४-१०", "content_sanskrit": "सुवर्णवर्मसन्नाहैर्योधैः कनकमालिभिः।\nआस्थिताः क्लृप्तवर्माणो भद्रा नित्यमदा द्विपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2064218, "chapter_id": 2363, "verse_number": "८-८४-११", "content_sanskrit": "क्रुद्धाः क्रुरैर्महामात्रैः प्रेषितार्जुनमभ्ययुः।\nचतुः शता रथवरा हताः पेतुः किरीटिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2064219, "chapter_id": 2363, "verse_number": "८-८४-१२", "content_sanskrit": "पर्यस्तानीव शृङ्गाणि ससत्वानि महागिरेः।\nधनञ्जयशराभ्यस्तैः स्तीर्णा भूर्वरवारणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2064220, "chapter_id": 2363, "verse_number": "८-८४-१३", "content_sanskrit": "समन्ताज्जलदप्रख्यान्वारणान्मदवर्षिणः।\nअभिपेदेऽर्जुनरथो घनान्भिन्दन्निवांशुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2064221, "chapter_id": 2363, "verse_number": "८-८४-१४", "content_sanskrit": "हतैर्गजमनुष्याश्वैर्भिन्नैश्च बहुधा रथैः।\nविशस्त्रयन्त्रकवचैर्युद्धशौण्डैर्गतासुभिः।\nउपविद्धायुधैर्मार्गः स्तीर्णोऽभूत्फल्गुनेन वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2064222, "chapter_id": 2363, "verse_number": "८-८४-१५", "content_sanskrit": "विस्फारितं च गाण्डीवमत्यासीद्भैरवस्वनम्\nसुघोषं वज्रनिष्पेषं स्तनयन्निव तोयदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2064223, "chapter_id": 2363, "verse_number": "८-८४-१६", "content_sanskrit": "ततः प्रादीर्यत चमूर्धनञ्जयशराहता।\nमहावातसमाविद्धा महानौरिव सागरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2064224, "chapter_id": 2363, "verse_number": "८-८४-१७", "content_sanskrit": "नानारूपाः प्राणहराः शरा गाण्डीवचोदिताः।\nअलातोल्काशनिप्रख्यास्तव सैन्यं विनिर्दहन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2064225, "chapter_id": 2363, "verse_number": "८-८४-१८", "content_sanskrit": "महागिरौ वेणुवनं निशि प्रज्वलितं यथा।\nतथा तव महासैन्यं प्रास्फुरच्छरपीडितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2064226, "chapter_id": 2363, "verse_number": "८-८४-१९", "content_sanskrit": "तद्विनष्टं सुविध्वस्तं तव सैन्यं किरीटिना।\nहतप्रविहतं बाणैः सर्वतः प्रद्रुतं दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2064227, "chapter_id": 2363, "verse_number": "८-८४-२०", "content_sanskrit": "सश्वापदा मृगगणा दावाग्नित्रासिता यथा।\nकुरवः पर्यवर्तन्त निर्दग्धाः सव्यसाचिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2064228, "chapter_id": 2363, "verse_number": "८-८४-२१", "content_sanskrit": "उत्सृज्य च महाबाहुं भीमसेनं तथा रणे।\nबलं कुरूणामुद्विग्नं सर्वमासीत्पराङ्मुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2064229, "chapter_id": 2363, "verse_number": "८-८४-२२", "content_sanskrit": "ततः कुरुषु भग्नेषु बीभत्सुरपराजितः।\nभीमसेनं समासाद्य मुहूर्तं सोऽभ्यवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2064230, "chapter_id": 2363, "verse_number": "८-८४-२३", "content_sanskrit": "समागम्य च भीमेन मन्त्रयित्वा च फल्गुनः।\nविशल्यमरुजं चास्मै कथयित्वा युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2064231, "chapter_id": 2363, "verse_number": "८-८४-२४", "content_sanskrit": "भीमसेनाभ्यनुज्ञातस्ततः प्रायाद्धनञ्जयः।\nनादन्रथघोषेण पृथिवीं द्यां च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2064232, "chapter_id": 2363, "verse_number": "८-८४-२५", "content_sanskrit": "ततः परिवृतो वीरैर्दशभिः शत्रुतापनः।\nदुःशासनादवरजैस्तव पुत्रैर्धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2064233, "chapter_id": 2363, "verse_number": "८-८४-२६", "content_sanskrit": "ते तमभ्यर्दयन्बाणैरुल्काभिरिव कुञ्जरम्।\nआततेष्वसना वीरा नृत्यन्त इव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2064234, "chapter_id": 2363, "verse_number": "८-८४-२७", "content_sanskrit": "अपसव्यांस्तु तांश्चक्रे रथेन मधुसूदनः।\nनियुक्तान्हि स तान्मेने यमायाशु किरीटिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2064235, "chapter_id": 2363, "verse_number": "८-८४-२८", "content_sanskrit": "तथान्ये प्राणदन्मूढाः पराङ्मुखमिवार्जुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2064236, "chapter_id": 2363, "verse_number": "८-८४-२९", "content_sanskrit": "तेषां नानदतां केतूनश्वांश्चापानि सारथीन्।\nनाराचैरर्धचन्द्रैश्च क्षिप्रं पार्थो न्यकृन्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2064237, "chapter_id": 2363, "verse_number": "८-८४-३०", "content_sanskrit": "*अथान्यैर्दशभिर्भल्लैः शिरांस्येषामपातयत्।\nरोषसंरक्तनेत्राणि सन्दष्टौष्ठानि भूतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2064238, "chapter_id": 2363, "verse_number": "८-८४-३१", "content_sanskrit": "तेषां वक्राणि विबभुर्व्योम्नि तारागणा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2064239, "chapter_id": 2363, "verse_number": "८-८४-३२", "content_sanskrit": "तांस्तु भल्लैर्महावेगैर्दशभिर्दश कौरवान्।\nरुक्माङ्गदाव्रुक्मपुङ्खैर्हत्वा प्रायादमित्रहा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2064240, "chapter_id": 2363, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे चतुरशीतितमोऽध्यायः॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]