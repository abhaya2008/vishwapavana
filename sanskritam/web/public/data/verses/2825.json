[{"id": 2085803, "chapter_id": 2825, "verse_number": "१२-३३०-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2085804, "chapter_id": 2825, "verse_number": "१२-३३०-१", "content_sanskrit": "यद्यस्ति दत्तमिष्टं वा तपस्तप्तं तथैव च।\nगुरूणां वाऽपि शुश्रूषा तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2085805, "chapter_id": 2825, "verse_number": "१२-३३०-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2085806, "chapter_id": 2825, "verse_number": "१२-३३०-२", "content_sanskrit": "आत्मनाऽनर्थयुक्तेन पापे निविशते मनः।\nस कर्म कलुषं कृत्वा क्लेशे महति धीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2085807, "chapter_id": 2825, "verse_number": "१२-३३०-३", "content_sanskrit": "दुर्भिक्षादेव दुर्भिक्षं क्लेशात्क्लेशं भयाद्भयम्।\nमृतेभ्यः प्रमृता यान्ति दरिद्राः पापकर्मिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2085808, "chapter_id": 2825, "verse_number": "१२-३३०-४", "content_sanskrit": "उत्सवादुत्सवं यान्ति स्वर्गात्स्वर्गं सुखात्सुखम्।\nश्रद्दधानाश्च दान्ताश्च धनस्याः शुभकारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2085809, "chapter_id": 2825, "verse_number": "१२-३३०-५", "content_sanskrit": "व्यालकुञ्जरदुर्गेषु सर्पचोरभयेषु च।\nहस्तावापेन गच्छन्ति नास्तिकाः किमतः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2085810, "chapter_id": 2825, "verse_number": "१२-३३०-६", "content_sanskrit": "प्रियदेवातिथेयाश्च वदान्याः प्रियसाधवः।\nक्षेम्यमात्मवता मार्गमास्थिता हस्तदक्षिणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2085811, "chapter_id": 2825, "verse_number": "१२-३३०-७", "content_sanskrit": "पुलाका इव धान्येषु पूत्यण्डा इव पक्षिषु।\nतद्विधास्ते मनुष्येषु येषां धर्मो न कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2085812, "chapter_id": 2825, "verse_number": "१२-३३०-८", "content_sanskrit": "सुशीघ्रमपि धावन्तं विधानमनुधावति।\nशेते सह शयानेन येनयेन यथाकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2085813, "chapter_id": 2825, "verse_number": "१२-३३०-९", "content_sanskrit": "पापं तिष्ठति तिष्ठन्तं धावन्तमनुधावति।\nकरोति कुर्वतः कर्म च्छायेवानुविधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2085814, "chapter_id": 2825, "verse_number": "१२-३३०-१०", "content_sanskrit": "येनयेन यथा यद्यत्पुरा कर्म सुनिश्चितम्।\nतत्तदेव नरो भुङ्क्ते नित्यं विहितमात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2085815, "chapter_id": 2825, "verse_number": "१२-३३०-११", "content_sanskrit": "समानकर्मनिक्षेपं विधानपरिरक्षणम्।\nभूतग्राममिमं कालः समन्तादपकर्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2085816, "chapter_id": 2825, "verse_number": "१२-३३०-१२", "content_sanskrit": "अचोद्यमानानि यथा पुष्पाणि च फलानि च।\nस्वं कालं नातिवर्तन्ते तथा कर्म पुराकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2085817, "chapter_id": 2825, "verse_number": "१२-३३०-१३", "content_sanskrit": "समानश्चावमानश्च लाभालाभौ जयाजयौ।\nप्रवृत्ता न निवर्तन्ते निधनान्ताः पदेपदे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2085818, "chapter_id": 2825, "verse_number": "१२-३३०-१४", "content_sanskrit": "आत्मना विहितं दुःखमात्मना विहितं सुखम्।\nगर्भशय्यामुपादाय भजते पूर्वदेहिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2085819, "chapter_id": 2825, "verse_number": "१२-३३०-१५", "content_sanskrit": "बालो युवा वा वृद्धश्च यत्करोति शुभाशुभम्।\nतस्यांतस्यामवस्थायां भुङ्क्ते जन्मनिजन्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2085820, "chapter_id": 2825, "verse_number": "१२-३३०-१६", "content_sanskrit": "यथा धेनुसहस्रेषु वत्सो विन्दति मातरम्।\nतथा पूर्वकृतं कर्म कर्तारमनुगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2085821, "chapter_id": 2825, "verse_number": "१२-३३०-१७", "content_sanskrit": "मलिनं हि यथा वस्त्रं पश्चाच्छुध्यति वारिणा।\nउपवासैः प्रतप्तानां दीर्घं सुखमनन्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2085822, "chapter_id": 2825, "verse_number": "१२-३३०-१८", "content_sanskrit": "दीर्घकालेन तपसा सेवितेन तपोवने।\nधर्मनिर्धूतपापानां संसिध्यन्ते मनोरथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2085823, "chapter_id": 2825, "verse_number": "१२-३३०-१९", "content_sanskrit": "शकुनानामिवाकाशे मत्स्यानामिव चोदके।\nपदं यथा न दृश्येत तथा पुण्यकृतां गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2085824, "chapter_id": 2825, "verse_number": "१२-३३०-२०", "content_sanskrit": "अलमन्यैरुपालब्धैः कीर्तितैश्च व्यतिक्रमैः।\nपेशलं चानुरूपं च कर्तव्यं हितमात्मनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2085825, "chapter_id": 2825, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि त्रिंशदधिकत्रिशततमोऽध्यायः॥ ३३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]