[{"id": 2088593, "chapter_id": 2891, "verse_number": "१३-२१-१", "content_sanskrit": "`भीष्म उवाच।\nविनता पुत्रशोकार्ता शापाद्भीता च भारत।\nप्रतीक्षते स्म तं कालं यः पुत्रोक्तस्तदाऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088594, "chapter_id": 2891, "verse_number": "१३-२१-२", "content_sanskrit": "ततोऽप्यतीते पञ्चशते वर्षाणां कालसंयुगे।\nगरुडोऽथ महावीर्यो जज्ञे भुजगभुग्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088595, "chapter_id": 2891, "verse_number": "१३-२१-३", "content_sanskrit": "बन्धुरास्यः शिखी पत्रकोशः कूर्मनखो महान्।\nरक्ताक्षः संहतग्रीवो ह्रस्वपादो महाशिराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088596, "chapter_id": 2891, "verse_number": "१३-२१-४", "content_sanskrit": "यस्त्वण्डात्स विनिर्भिन्नो निष्क्रान्तो भरतर्षभ।\nविनतापूर्वजः पुत्रः सोऽरुणो दृश्यते दिवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088597, "chapter_id": 2891, "verse_number": "१३-२१-५", "content_sanskrit": "पूर्वां दिशामभिप्रेत्य सूर्यस्योदयनं प्रति।\nअरुणोऽरुणसंकाशो नाम्ना चैवारुणः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088598, "chapter_id": 2891, "verse_number": "१३-२१-६", "content_sanskrit": "जातमात्रस्तु विहगो गरुडः पन्नगाशनः।\nविहाय मातरं क्षिप्रमगमत्सर्वतो दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088599, "chapter_id": 2891, "verse_number": "१३-२१-७", "content_sanskrit": "स तदा ववृधेऽतीव सर्वकामैः कदाऽर्चितः।\nपितामहविसृष्टेन भोजनेन विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088600, "chapter_id": 2891, "verse_number": "१३-२१-८", "content_sanskrit": "तस्मिंश्च विहगे तत्र यथाकामं विवर्धति।\nकद्रूश्च विनता चैवागच्छतां सागरं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088601, "chapter_id": 2891, "verse_number": "१३-२१-९", "content_sanskrit": "ददृशाते तु ते यान्तमुच्चैश्श्रवसमन्तिकात्।\nस्नात्वोपवृत्तं त्वरितं पीतवन्तं च वाजिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088602, "chapter_id": 2891, "verse_number": "१३-२१-१०", "content_sanskrit": "ततः कद्रूर्हसन्त्येव विनतामिदमब्रवीत्।\nहयस्य वर्णः को न्वत्र ब्रूहि यस्ते मतः शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088603, "chapter_id": 2891, "verse_number": "१३-२१-११x", "content_sanskrit": "विनतोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088604, "chapter_id": 2891, "verse_number": "१३-२१-११", "content_sanskrit": "एकवर्णो हयो राज्ञि सर्वश्वेतो मतो मम।\nवर्णं वा कीदृशं तस्य मन्यते त्वं मनस्विनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088605, "chapter_id": 2891, "verse_number": "१३-२१-१२x", "content_sanskrit": "कद्रूरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088606, "chapter_id": 2891, "verse_number": "१३-२१-१२", "content_sanskrit": "सर्वश्वेतो मतस्तुभ्यं य एष हयसत्तमः।\nब्रूहि कल्याणि दीव्यावो वर्णान्यत्वेन भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088607, "chapter_id": 2891, "verse_number": "१३-२१-१३x", "content_sanskrit": "विनतोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2088608, "chapter_id": 2891, "verse_number": "१३-२१-१३", "content_sanskrit": "यद्यार्ये दीव्यसि त्वं मे कः पणो नो भविष्यति।\nसा तज्ज्ञात्वा पणेयं वै ज्ञात्वा तु विपणे त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2088609, "chapter_id": 2891, "verse_number": "१३-२१-१४x", "content_sanskrit": "कद्रूरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2088610, "chapter_id": 2891, "verse_number": "१३-२१-१४", "content_sanskrit": "जिता दासी भवेर्मे त्वमहं चाप्यसितेक्षणे।\nनैकवर्णैकवर्णत्वे विनते रोचते च ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2088611, "chapter_id": 2891, "verse_number": "१३-२१-१५", "content_sanskrit": "रोचते मे पणे राज्ञि दासीत्वेन न संशयः।\nसत्यमातिष्ठ भद्रं ते सत्ये स्थास्यामि चाप्यहम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2088612, "chapter_id": 2891, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकविंशोऽध्यायः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]