[{"id": 40001148, "chapter_id": 8820, "verse_number": "1", "content_sanskrit": "तां कथां कौशिको रामे निवेद्य कुशिकात्मज:। पुनरेवापरं वाक्यं काकुत्स्थ मिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40001149, "chapter_id": 8820, "verse_number": "2", "content_sanskrit": "अयोध्याधिपति श्शूर: पूर्वमासीन्नराधिप:। सगरो नाम धर्मात्मा प्रजाकामस्स चाप्रज: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40001150, "chapter_id": 8820, "verse_number": "3", "content_sanskrit": "वैदर्भदुहिता राम केशिनी नाम नामत:। ज्येष्ठा सगरपत्नी सा धर्मिष्ठा सत्यवादिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40001151, "chapter_id": 8820, "verse_number": "4", "content_sanskrit": "अरिष्टनेमेर्दुहिता रूपेणाप्रतिमा भुवि। द्वितीया सगरस्यासीत्पत्नी सुमतिसंज्ञिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40001152, "chapter_id": 8820, "verse_number": "5", "content_sanskrit": "ताभ्यां सह महाराज: पत्नीभ्यां तप्तवांस्तप:। हिमवन्तं समासाद्य भृगुप्रस्रवणे गिरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40001153, "chapter_id": 8820, "verse_number": "6", "content_sanskrit": "अथ वर्षशते पूर्णे तपसाऽराधितो मुनि:। सगराय वरं प्रादाद्भृगुस्सत्यवतां वर: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40001154, "chapter_id": 8820, "verse_number": "7", "content_sanskrit": "अपत्यलाभस्सुमहान् भविष्यति तवानघ। कीर्तिं चाप्रतिमां लोके प्राप्स्यसे पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40001155, "chapter_id": 8820, "verse_number": "8", "content_sanskrit": "एका जनयिता तात पुत्रं वंशकरं तव। षष्ठिं पुत्रसहस्राणि अपरा जनयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40001156, "chapter_id": 8820, "verse_number": "9", "content_sanskrit": "भाषमाणं महात्मानं राजपुत्र्यौ प्रसाद्य तम्। ऊचतु: परमप्रीते कृताञ्जलिपुटे तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40001157, "chapter_id": 8820, "verse_number": "10", "content_sanskrit": "एक: कस्यास्सुतो ब्रह्मन् का बहून् जनयिष्यति। श्रोतुमिच्छावहे ब्रह्मन् सत्यमस्तु वचस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40001158, "chapter_id": 8820, "verse_number": "11", "content_sanskrit": "तयोस्तद्वचनं श्रुत्वा भृगु: परमधार्मिक:। उवाच परमां वाणीं स्वच्छन्दोऽत्र विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40001159, "chapter_id": 8820, "verse_number": "12", "content_sanskrit": "एको वंशकरो वाऽस्तु बहवो वा महाबला:। कीर्तिमन्तो महोत्साहा: का वा कं वरमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40001160, "chapter_id": 8820, "verse_number": "13", "content_sanskrit": "मुनेस्तु वचनं श्रुत्वा केशिनी रघुनन्दन। पुत्रं वंशकरं राम जग्राह नृपसन्निधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40001161, "chapter_id": 8820, "verse_number": "14", "content_sanskrit": "षष्ठिं पुत्रसहस्राणि सुपर्णभगिनी तदा। महोत्साहान् कीर्तिमतो जग्राह सुमति: सुतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40001162, "chapter_id": 8820, "verse_number": "15", "content_sanskrit": "प्रदक्षिणमृषिं कृत्वा शिरसाऽभिप्रणम्य च। जगाम स्वपुरं राजा सभार्यो रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40001163, "chapter_id": 8820, "verse_number": "16", "content_sanskrit": "अथ काले गते तस्मिन् ज्येष्ठा पुत्रं व्यजायत। असमञ्ज इति ख्यातं केशिनी सगरात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40001164, "chapter_id": 8820, "verse_number": "17", "content_sanskrit": "सुमतिस्तु नरव्याघ्र गर्भतुम्बं व्यजायत। षष्ठि: पुत्रसहस्राणि तुम्बभेदाद्विनि:सृता: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40001165, "chapter_id": 8820, "verse_number": "18", "content_sanskrit": "घृतपूर्णेषु कुम्भेषु धात्र्यस्तान् समवर्धयन्। कालेन महता सर्वे यौवनं प्रतिपेदिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40001166, "chapter_id": 8820, "verse_number": "19", "content_sanskrit": "अथ दीर्घेण कालेन रूपयौवनशालिन:। षष्टि: पुत्रसहस्राणि सगरस्याभवंस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40001167, "chapter_id": 8820, "verse_number": "20", "content_sanskrit": "स च ज्येष्ठो नरश्रेष्ठ सगरस्यात्मसम्भव:। बालान् गृहीत्वा तु जले सरय्वा रघुनन्दन ॥ प्रक्षिप्य प्रहसन्नित्यं मज्जतस्तान् समीक्ष्य वै।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40001168, "chapter_id": 8820, "verse_number": "21", "content_sanskrit": "एवं पापसमाचारस्सज्जनप्रतिबाधक: ॥ पौराणामहिते युक्त: पुत्रो निर्वासित: पुरात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40001169, "chapter_id": 8820, "verse_number": "22", "content_sanskrit": "तस्य पुत्रोंऽशुमान्नाम असमञ्जस्य वीर्यवान् ॥ सम्मत स्सर्वलोकस्य सर्वस्यापि प्रियंवद:।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40001170, "chapter_id": 8820, "verse_number": "23", "content_sanskrit": "तत: कालेन महता मतिस्समभिजायत ॥ सगरस्य नरश्रेष्ठ यजेयमिति निश्चिता।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40001171, "chapter_id": 8820, "verse_number": "24", "content_sanskrit": "स कृत्वा निश्चयं राम सोपाध्यायगणस्तदा ॥ यज्ञकर्मणि वेदज्ञो यष्टुं समुपचक्रमे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]