[{"id": 7002624000, "chapter_id": 22624, "verse_number": "६-२-१", "content_sanskrit": "सूत उवाच ।\nप्रसन्नमनसं भूपं महासिंहासने स्थितम् ।\nद्विजवर्यः स वैतालो वचः प्राह प्रसन्नधीः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002624001, "chapter_id": 22624, "verse_number": "६-२-२", "content_sanskrit": "एकदा यमुनातीरे धर्मस्थलपुरी शुभा ।\nधनधान्यसमायुक्ता चतुर्वर्णसमन्विता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002624002, "chapter_id": 22624, "verse_number": "६-२-३", "content_sanskrit": "गुणाधिपो महीपालस्तत्र राज्यं चकार वै ।\nहरिशर्मा पुरोधास्तु स्नानपूजनतत्परः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002624003, "chapter_id": 22624, "verse_number": "६-२-४", "content_sanskrit": "तस्य पत्नी सुशीला च पतिव्रतपरायणा ।\nसत्यशीलः सुतो जातो विद्याध्ययनतत्परः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002624004, "chapter_id": 22624, "verse_number": "६-२-५", "content_sanskrit": "तस्यानुजा मधुमती शीलरूपगुणान्विता ।\nद्वादशाब्दवयःप्राप्ते विवाहार्थं पिता यदा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002624005, "chapter_id": 22624, "verse_number": "६-२-६", "content_sanskrit": "भ्राता बभ्राम तौ सर्वं चिनुतश्च सुतावरम् ।\nकदाचिद्राजपुत्रस्य विवाहे समतो द्विजः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002624006, "chapter_id": 22624, "verse_number": "६-२-७", "content_sanskrit": "पठनार्थे तु काश्यां वै सत्त्वशीलः स्वयं गतः ।\nएतस्मिन्नंतरे राजन्द्विजः कश्चित्समागतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002624007, "chapter_id": 22624, "verse_number": "६-२-८", "content_sanskrit": "वामनो नाम विख्यातो रूपशीलवयोवृतः ।\nसुता मधुमती तं च दृष्ट्वा कामातुराऽभवत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002624008, "chapter_id": 22624, "verse_number": "६-२-९", "content_sanskrit": "भोजनं छादनं पानं स्वप्नं त्यक्त्वा च विह्वला ।\nचकोरीव विना चंद्रं कामबाणप्रपीडिता ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002624009, "chapter_id": 22624, "verse_number": "६-२-१०", "content_sanskrit": "दृष्ट्वा सुशीला तं बाला वामनं ब्राह्मणं तथा ।\nवारयामास तांबूलैः स्वर्णद्रव्यसमन्वितैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002624010, "chapter_id": 22624, "verse_number": "६-२-११", "content_sanskrit": "हरिशर्मा प्रयोगे च द्विजं दृष्ट्वा त्रिविक्रमम् ।\nवेदवेदांतत्त्वज्ञं सुतार्थेऽवरयत्तदा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002624011, "chapter_id": 22624, "verse_number": "६-२-१२", "content_sanskrit": "सत्यशीलस्तु काश्यां वै गुरुपुत्रं च केशवम् ।\nवरित्वा तं भगिन्यर्थे ययौ गेहं मुदान्वितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002624012, "chapter_id": 22624, "verse_number": "६-२-१३", "content_sanskrit": "माघकृष्णत्रयोदश्यां भृगौ लग्नं शुभं स्मृतम् ।\nत्रयो विप्रास्तदा प्राप्ताः कन्यार्थे रूपमोहिताः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002624013, "chapter_id": 22624, "verse_number": "६-२-१४", "content_sanskrit": "तस्मिन्काले तु सा कन्या भुजगेनैव दंशिता ।\nमृता प्रेतत्वमापन्ना पूर्वकर्मप्रभावतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002624014, "chapter_id": 22624, "verse_number": "६-२-१५", "content_sanskrit": "तदा ते ब्राह्मणा यत्नं कारयामासुरुत्तमम् ।\nन जीवनवती बाला गरलेन विमोहिता ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002624015, "chapter_id": 22624, "verse_number": "६-२-१६", "content_sanskrit": "हरिशर्मा तु तत्सर्वं कृत्वा वेदविधानतः ।\nआययौ मंदिरं राजन्त्सुतागुणविमोहितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002624016, "chapter_id": 22624, "verse_number": "६-२-१७", "content_sanskrit": "त्रिविक्रमस्तु बहुधा दुःखं कृत्वा स्मरानुगः ।\nकंथाधारी यतिर्भूत्वा देशाद्देशातरं ययौ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002624017, "chapter_id": 22624, "verse_number": "६-२-१८", "content_sanskrit": "केशवस्तु महादुःखी प्रियास्थीनि गृहीतवान् ।\nतीर्थात्तीर्थांतरं प्राप्तः कामबाणेन पीडितः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002624018, "chapter_id": 22624, "verse_number": "६-२-१९", "content_sanskrit": "भस्मग्राही वामनस्तु विरहाग्निप्रपीडितः ।\nतस्थौ चितायां कामार्तः पत्नीध्यानपरायणः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002624019, "chapter_id": 22624, "verse_number": "६-२-२०", "content_sanskrit": "एकदा सरयूतीरे लक्ष्मणाख्यपुरे शुभे ।\nत्रिविक्रमस्तु भिक्षार्थे संप्राप्तो द्विजमंदिरे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002624020, "chapter_id": 22624, "verse_number": "६-२-२१", "content_sanskrit": "तस्मिन्दिने रामशर्मा शिवध्यानपरायणः ।\nयतिनं वरयामास भोजनार्थं स्वमंदिरे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002624021, "chapter_id": 22624, "verse_number": "६-२-२२", "content_sanskrit": "तस्य पत्नी विशालाक्षी रचित्वा बहुभोजनम् ।\nआहूय यतिनं राजन्पात्रमालभमाकरोत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002624022, "chapter_id": 22624, "verse_number": "६-२-२३", "content_sanskrit": "तस्मिन्काले च तद्बालो मृतः पापवशंगतः ।\nअरोदीत्तस्य सैरंध्री विशालाक्ष्यपि भर्त्सिता ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002624023, "chapter_id": 22624, "verse_number": "६-२-२४", "content_sanskrit": "न रोदनं त्यक्तवती पुत्रशोकाग्नितापिता ।\nरामशर्मा तदा प्राप्तो मंत्रं संजीवनं शुभम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002624024, "chapter_id": 22624, "verse_number": "६-२-२५", "content_sanskrit": "जपित्वा मार्जनं कृत्वा जीवयामास बालकम् ।\nविनयावनतो विप्रस्तं च संन्यासिनं तदा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002624025, "chapter_id": 22624, "verse_number": "६-२-२६", "content_sanskrit": "भोजनं कारयित्वा तु मंत्रं संजीवनं ददौ ।\nत्रिविक्रमस्तु तं मंत्रं पठित्वा यमुनातटे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002624026, "chapter_id": 22624, "verse_number": "६-२-२७", "content_sanskrit": "प्राप्तवान्यत्र सा नारी दाहिता हरिशर्मणा ।\nएतस्मिन्नन्तरे तत्र राजपुत्रो मृतिं गतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002624027, "chapter_id": 22624, "verse_number": "६-२-२८", "content_sanskrit": "दाहितस्तनयः पित्रा शोककर्त्रा तदामुना ।\nजीवनं प्राप्तवान्बालस्तस्य मंत्रप्रभावतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002624028, "chapter_id": 22624, "verse_number": "६-२-२९", "content_sanskrit": "गुणाधिपस्य तनयो राज्ञो धर्मस्थलीपतेः ।\nत्रिविक्रमं वचः प्राह वीरबाहुर्महाबलः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002624029, "chapter_id": 22624, "verse_number": "६-२-३०", "content_sanskrit": "जीवनं दत्तवान्मह्यं वरयाद्य वरं मम ।\nस विप्रः प्राह भो राजन्केशवो नाम यो द्विजः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002624030, "chapter_id": 22624, "verse_number": "६-२-३१", "content_sanskrit": "गृहीत्वास्थि गतस्तीर्थे तमन्वेषय मा चिरम् ।\nवीरबाहुस्तथा मत्वा दूतमार्गेण तं प्रति ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002624031, "chapter_id": 22624, "verse_number": "६-२-३२", "content_sanskrit": "प्राप्तस्तं कथयामास यथा प्राप्तं हि जीवनम् ।\nइति श्रुत्वा वचस्तस्य केशवोऽस्थिसमन्वितः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002624032, "chapter_id": 22624, "verse_number": "६-२-३३", "content_sanskrit": "प्रगत्यास्थीनि सर्वाणि ददौ तस्मै द्विजातये ।\nपुनः संजीविता बाला केशवादीन्वचोऽब्रवीत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002624033, "chapter_id": 22624, "verse_number": "६-२-३४", "content_sanskrit": "योग्या धर्मेण यस्याहं तस्मै प्रायामि धर्मिणे ।\nइति श्रुत्वा वचस्तस्या मौनवंतस्त्रयः स्थिताः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002624034, "chapter_id": 22624, "verse_number": "६-२-३५", "content_sanskrit": "अतस्त्वं विक्रमादित्य धर्मज्ञ कथयस्व मे ।\nकस्मै योग्या च सा बाला नाम्ना मधुमती शुभा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002624035, "chapter_id": 22624, "verse_number": "६-२-३६", "content_sanskrit": "सूत उवाच ।\nविहस्य विक्रमादित्यो वैतालं प्राह नम्रधीः ।\nयोग्या मधुमती नारी वामनाय द्विजन्मने ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002624036, "chapter_id": 22624, "verse_number": "६-२-३७", "content_sanskrit": "प्राणदाता तु यो विप्रः पितेव गुणतत्परः ।\nअस्थिदाता तु यो विप्रो भ्रातृतुल्यस्स वेदवित् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]