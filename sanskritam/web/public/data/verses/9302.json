[{"id": 40019001, "chapter_id": 9302, "verse_number": "1", "content_sanskrit": "तासांविलपमानानांतदाराक्षसयोषिताम् । ज्येष्ठापत्नीप्रियाजीनाभर्तारंसमुदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40019002, "chapter_id": 9302, "verse_number": "2", "content_sanskrit": "दशग्रीवंहतंदृष्टवारामेणाचिन्त्यकर्मणा । पतिंमण्डोदरीतत्रकृपणापर्यदेवयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40019003, "chapter_id": 9302, "verse_number": "3", "content_sanskrit": "ननुनाममहाबाहोतववैश्रवणानुज । क्रुद्धस्यप्रमुखेस्थातुंत्रस्यत्यपिपुरन्दरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40019004, "chapter_id": 9302, "verse_number": "4", "content_sanskrit": "ऋषयश्चमहान्तोऽपिगन्धर्वाश्चयशस्विनः । ननुनामतवोद्वेगाच्चारणाश्चदिशोगताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40019005, "chapter_id": 9302, "verse_number": "5", "content_sanskrit": "स त्वंमानुषमात्रेणरामेणयुधिनिर्जितः । न व्यपत्रपसेराजन् किमिदंराक्षसेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40019006, "chapter_id": 9302, "verse_number": "6", "content_sanskrit": "कथंत्रैलोक्यमाक्रम्यश्रियावीर्येणचान्वितम् । अविषह्यंजघानत्वांमानुषोवनगोचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40019007, "chapter_id": 9302, "verse_number": "7", "content_sanskrit": "मानुषाणामविषयेचरतःकामरूपिणः । विनाशस्तवरामेणसम्युगेनोपपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40019008, "chapter_id": 9302, "verse_number": "8", "content_sanskrit": "न चैतत्कर्मरामस्यश्रद्धधामिचमूमुखे । सर्वतस्समुपेतस्यतवतेनाभिमर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40019009, "chapter_id": 9302, "verse_number": "9", "content_sanskrit": "यदैव च जनस्थानेराक्षसैर्भहुनिर्ववृतः । खरस्तवहतोभ्रातातदैवासौ न मानुषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40019010, "chapter_id": 9302, "verse_number": "10", "content_sanskrit": "यदैवनगरींलङ्कांदुष्प्रवेशांसुरैरपि । प्रविष्टोहनुमान्वीर्यात्तदैवव्यथितावयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40019011, "chapter_id": 9302, "verse_number": "11", "content_sanskrit": "यदैववानरैर्घोरैर्बद्धस्सेतुर्महार्णवे । तदैवहृदयेनाहंशङ्केरामममानुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40019012, "chapter_id": 9302, "verse_number": "12", "content_sanskrit": "अथवारामरूपेणकृतान्तस्स्वयमागतः । मायांतवविनाशायविधायाप्रतितर्किताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40019013, "chapter_id": 9302, "verse_number": "13", "content_sanskrit": "अथवावासवेनत्वंधर्षितोऽपिमहाबल । वासवस्यतुकाशक्तिस्त्वांद्रष्टुमपिसंयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40019014, "chapter_id": 9302, "verse_number": "14", "content_sanskrit": "व्यक्तमेषमहायोगीपरमात्मासनातनः । अनादिमध्यनिधनोमहतंपरमोमहान् ॥ तमसःपरमोधाताशङ्खचक्रगदाधरः । श्रीवत्सवक्षानित्यश्रीरजय्यश्शाश्वतोध्रुवः ॥ मानुषंरूपमास्थायविष्णुस्सत्यपराक्रमः । सर्वैःपरिवृतोदेवैर्वानरत्वमुपागतैः ॥ सर्वलोकेश्वर्श्रीमान्लोकानांहितकाम्यया । सराक्षसरपरीवारंहतवांस्त्वांमहाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "m