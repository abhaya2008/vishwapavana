[{"id": 2105370, "chapter_id": 3273, "verse_number": "१६-२-१", "content_sanskrit": "वैशम्पायन उवाच।\nएवं सम्पूजितो राजा पाण्डवैरंबिकासुतः।\nविजहार यथापूर्वमृषिभिः पर्युपस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105371, "chapter_id": 3273, "verse_number": "१६-२-२", "content_sanskrit": "ब्रह्मदेयाग्रहारांश्च प्रददौ स कुरूद्वहः।\nतच्च कुन्तीसुतो राजा सर्वमेवान्वमोदत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105372, "chapter_id": 3273, "verse_number": "१६-२-३", "content_sanskrit": "आनृशंस्यपरो राजा प्रीयमाणो युधिष्ठिरः।\nउवाच स तदा भ्रातॄनमात्यांश्च महीपतिः।\nमया चैव भवद्भिश्च मान्य एष नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105373, "chapter_id": 3273, "verse_number": "१६-२-४", "content_sanskrit": "निदेशे धृतराष्ट्रस्य यस्तिष्ठति स मे सुहृत्।\nविपरीतश्च मे शत्रुर्नियम्यश्च भवेन्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105374, "chapter_id": 3273, "verse_number": "१६-२-५", "content_sanskrit": "परिवृत्तेषु चाहःसु पुत्राणां श्राद्धकर्मणि।\nददौ च राजा वित्तानि यावदस्य चिकीर्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105375, "chapter_id": 3273, "verse_number": "१६-२-६", "content_sanskrit": "ततः स राजा कौरव्यो धृतराष्ट्रो महामनाः।\nब्राह्मणेभ्यो यथार्हेभ्यो ददौ वित्तान्यनेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105376, "chapter_id": 3273, "verse_number": "१६-२-७", "content_sanskrit": "धर्मिराजश्च भीमश्च सव्यसाची यमावपि।\nतत्सर्वमन्ववर्तन्त धृतराष्ट्रव्यपेक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105377, "chapter_id": 3273, "verse_number": "१६-२-८", "content_sanskrit": "कथं नु राजा वृद्धः स पुत्रपौत्रवधार्दितः।\nशोकमस्मत्कृतं प्राप्यि न म्रियेतेति चिन्त्य ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105378, "chapter_id": 3273, "verse_number": "१६-२-९", "content_sanskrit": "यावद्धि कुरुवीरस्य जीवत्पुत्रस्य वै सुखम्।\nतावत्सुखमवाप्नोति भोगांश्चैव व्यवस्थितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105379, "chapter_id": 3273, "verse_number": "१६-२-१०", "content_sanskrit": "ततस्ते सहिताः पञ्च भ्रातरः पाण्डुनन्दनाः।\nतथाशीलाः समातस्थुर्धृतराष्ट्रस्य शासने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105380, "chapter_id": 3273, "verse_number": "१६-२-११", "content_sanskrit": "धृतराष्ट्रश्च तान्सर्वान्विनीतान्नियमे स्थितान्।\nशिष्यवृत्तिं समापन्नान्गुरुवत्प्रत्यपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105381, "chapter_id": 3273, "verse_number": "१६-२-१२", "content_sanskrit": "गान्धारी चैव पुत्राणां विविधैः श्राद्धकर्मभिः।\nआनृण्यमगमत्कामान्विप्रेभ्यः प्रतिपाद्य सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105382, "chapter_id": 3273, "verse_number": "१६-२-१३", "content_sanskrit": "एवं धर्मभृतांश्रेष्ठो धर्मराजो युधिष्ठिरः।\nभ्रातृभिः सहितो धीमान्पूजयामासं तं नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105383, "chapter_id": 3273, "verse_number": "१६-२-१४", "content_sanskrit": "स राजा सुमहातेजा वृद्धः कुरुकुलोद्वहः।\nन ददर्श तदा किञ्चिदप्रियं पाण्डुनन्दने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105384, "chapter_id": 3273, "verse_number": "१६-२-१५", "content_sanskrit": "वर्तमानेषु सद्वृत्तिं पाण्डवेषु महात्मसु।\nप्रीतिमानभवद्राजा धृतराष्ट्रोंऽबिकासुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105385, "chapter_id": 3273, "verse_number": "१६-२-१६", "content_sanskrit": "सौबलेयी च गान्धारी पुत्रशोकमपास्य तम्।\nसदैव प्रीतिमत्यासीत्तनयेषु निजेष्विव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2105386, "chapter_id": 3273, "verse_number": "१६-२-१७", "content_sanskrit": "प्रियाण्येव तु कौरव्यो नाप्रियाणि कुरूद्वहः।\nवैचित्रवीर्य नृपतौ समाचरत सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2105387, "chapter_id": 3273, "verse_number": "१६-२-१८", "content_sanskrit": "यद्यद्ब्रूते च किञ्चित्स धृतराष्ट्रो जनाधिपः।\nगुरु वा लघु वा कार्यं गान्धारी च तपस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2105388, "chapter_id": 3273, "verse_number": "१६-२-१९", "content_sanskrit": "तं स राजा महाराज पाण्डवानां धुरंधरः।\nपूजयित्वा वचस्तत्तदकार्षीत्परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2105389, "chapter_id": 3273, "verse_number": "१६-२-२०", "content_sanskrit": "तेन तस्याभवत्प्रीतो वृत्तेन स नराधिपः।\nअन्वतप्यत संस्मृत्य पुत्रं तं मन्दचेतसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2105390, "chapter_id": 3273, "verse_number": "१६-२-२१", "content_sanskrit": "सदा च प्रातरुत्थाय कृतजप्यः शुचिर्नृपः।\nआशास्ते पाण्डुपुत्राणां समरेष्वपराजयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2105391, "chapter_id": 3273, "verse_number": "१६-२-२२", "content_sanskrit": "ब्राह्मणान्स्वस्तिवाच्याथ हुत्वा चैव हुताशनम्।\nआयूंषि पाण्डुपुत्राणामाशंसत नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2105392, "chapter_id": 3273, "verse_number": "१६-२-२३", "content_sanskrit": "न तां प्रीतिं परामाप पुत्रेभ्यः स तदा पुरा।\nयां प्रीतिं पाण्डुपुत्रेभ्यः सदाऽवाप नराधिपः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2105393, "chapter_id": 3273, "verse_number": "१६-२-२४", "content_sanskrit": "ब्राह्मणानां यथा वृत्तः क्षत्रियाणां यथाविधः।\nतथा विट्शूद्रसङ्घानामभवत्स प्रियस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2105394, "chapter_id": 3273, "verse_number": "१६-२-२५", "content_sanskrit": "यच्च किञ्चित्तदा पापं धृतराष्ट्रसुतैः कृतम्।\nअकृत्वा हृदि तत्पापं तं नृपं सोन्ववर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2105395, "chapter_id": 3273, "verse_number": "१६-२-२६", "content_sanskrit": "यः कश्चिदपि यत्किञ्चित्प्रमादादंबिकासुते।\nकुरुते द्वेष्यतामेति स कौन्तेयस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2105396, "chapter_id": 3273, "verse_number": "१६-२-२७", "content_sanskrit": "न राज्ञो धृतराष्ट्रस्य न च दुर्योधनस्य वै।\nउवाच दुष्कृतं कश्चिद्युधिष्ठिरभयान्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2105397, "chapter_id": 3273, "verse_number": "१६-२-२८", "content_sanskrit": "धृत्या तुष्टो नरेन्द्रः स गान्धारी विदुरस्तथा।\nअजातशत्रोर्वृत्तेन न तु भीमस्य पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2105398, "chapter_id": 3273, "verse_number": "१६-२-२९", "content_sanskrit": "अन्ववर्तत भीमोपि निश्चितो धर्मजं नृपम्।\nधृतराष्ट्रं च सम्प्रेक्ष्य सदा भवति दुर्मनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2105399, "chapter_id": 3273, "verse_number": "१६-२-३०", "content_sanskrit": "राजानमनुवर्तन्त धर्मपुत्रममित्रहा।\nअन्ववर्तत संक्रुद्धो हृदयेन पराङ्मुखः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2105400, "chapter_id": 3273, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि आश्रमवासपर्वणि द्वितीयोऽध्यायः॥। २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]