[{"id": 2034372, "chapter_id": 1741, "verse_number": "४-६४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2034373, "chapter_id": 1741, "verse_number": "४-६४-१", "content_sanskrit": "भीष्मं विजित्य संग्रामे कुरूणां मिषतां रणे।\nततो युद्धमनाः प्रायात्पार्थः पञ्च महारथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2034374, "chapter_id": 1741, "verse_number": "४-६४-२", "content_sanskrit": "आददानश्च नाराचान्विमृशन्निषुधी अपि।\nसंस्पृशानश्च गाण्डीवं भूयः कर्णं समभ्यगाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2034375, "chapter_id": 1741, "verse_number": "४-६४-३x", "content_sanskrit": "द्रौणिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2034376, "chapter_id": 1741, "verse_number": "४-६४-३", "content_sanskrit": "कर्ण यत्तत्सभामध्ये बह्वबद्धं प्रभाषसे।\nन मे युधि समोऽस्तीति तदिदं प्रत्युपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2034377, "chapter_id": 1741, "verse_number": "४-६४-४", "content_sanskrit": "एषोऽन्तक इव क्रुद्धः सर्वभूतावमर्दनः।\nअदूरात्प्रत्युपस्थाय जृम्भते केसरी यथा।\nन पलायस्व शूरश्चेत्स्थित्वा युध्यस्व फल्गुनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2034378, "chapter_id": 1741, "verse_number": "४-६४-५x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2034379, "chapter_id": 1741, "verse_number": "४-६४-५", "content_sanskrit": "नाहं बिभेमि बीभत्सोः कृष्णाद्वा देवकीसुतात् ।\nपाण्डवेभ्योपि सर्वेभ्यः क्षत्रधर्ममनुव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2034380, "chapter_id": 1741, "verse_number": "४-६४-६", "content_sanskrit": "सत्वाधिकानां शूराणां धनुर्वेदोपजीविनाम् ।\nदर्शनाञ्जायते दर्पः स्वरश्च न विषीदति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2034381, "chapter_id": 1741, "verse_number": "४-६४-७", "content_sanskrit": "पश्यत्वाचार्यपुत्रो मामर्जुनेन समं युधि।\nयुध्यमानं सुसंयुक्तं दैवं तु दुरतिक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2034382, "chapter_id": 1741, "verse_number": "४-६४-८x", "content_sanskrit": "अश्वत्थामोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2034383, "chapter_id": 1741, "verse_number": "४-६४-८", "content_sanskrit": "को दोषः कर्ण शूराणां वाचा साकं हि पौरुषम् ।\nविद्यते यदि तल्लोके गुणोत्तरमिहोच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2034384, "chapter_id": 1741, "verse_number": "४-६४-९", "content_sanskrit": "युव्यस्व त्वमभीः पार्थं प्रपलायस्व मा रणात्।\nउक्तं वचः स्मरन्कर्ण नाहमित्यादि संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2034385, "chapter_id": 1741, "verse_number": "४-६४-१०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2034386, "chapter_id": 1741, "verse_number": "४-६४-१०", "content_sanskrit": "तं समन्ताद्रथाः पञ्च परिवार्य धनञ्जयम्।\nत इषून्सम्यगस्यन्तो मुमुक्षन्तोपि जीवितात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2034387, "chapter_id": 1741, "verse_number": "४-६४-११", "content_sanskrit": "ते लाभमिव मन्वानाः क्षिप्रमार्च्छन्धनञ्जयम्।\nशरौघान्सम्यगस्यन्तो जीमूता इव वार्षिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2034388, "chapter_id": 1741, "verse_number": "४-६४-१२", "content_sanskrit": "बहुभिर्निशितैर्बाणैर्विविधैर्लोमवापिभिः ।\nआद्रवन्प्रत्यवस्थाय प्रत्यविध्यन्धनञ्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2034389, "chapter_id": 1741, "verse_number": "४-६४-१३", "content_sanskrit": "ततः प्रहस्य बीभत्सुः सर्वशस्त्रभृतांवरः ।\nदिव्यमस्त्रं विकुर्वाणः प्रत्ययाद्रथसत्तमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2034390, "chapter_id": 1741, "verse_number": "४-६४-१४", "content_sanskrit": "यथा रश्मिभिरादित्यः प्रच्छादयति मेदिनीम्।\nएवं गाण्डीवनिर्मुक्तैः शरैः प्राच्छादयद्दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2034391, "chapter_id": 1741, "verse_number": "४-६४-१५", "content_sanskrit": "न रथानां न नगानां न ध्वजानां न वाजिनाम्।\nअविद्धं निशितैर्बाणैरासीद्द्यूङ्गुलमन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2034392, "chapter_id": 1741, "verse_number": "४-६४-१६", "content_sanskrit": "सर्वे शान्तिपरा योधाः स्वचित्तं नाभिजझिरे ।\nहस्तिनोऽश्वाश्च वित्रस्ता व्यवलीयन्त भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2034393, "chapter_id": 1741, "verse_number": "४-६४-१७", "content_sanskrit": "यथा नलवनं नागः प्रभिन्नः षाष्टिहायनः ।\nएवं सर्वानपामृद्गादर्जुनः शस्त्रतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2034394, "chapter_id": 1741, "verse_number": "४-६४-१८", "content_sanskrit": "गाण्डीवस्य तु घोषेण पृथिवी समकम्पत।\nमनांसि धार्तराष्ट्राणामप्यकृन्तद्धनञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2034395, "chapter_id": 1741, "verse_number": "४-६४-१९", "content_sanskrit": "ततो विगाह्य सैन्यानां मध्यं शस्त्रभृतांवरः ।\nसारथिं समरे शूरस्त्वभ्यभाषत वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2034396, "chapter_id": 1741, "verse_number": "४-६४-२०", "content_sanskrit": "संनियम्य हयानेतान्मन्दं वाहय सारथे ।\nआचार्यपुत्रं समरे योधयिष्येऽपराजितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2034397, "chapter_id": 1741, "verse_number": "४-६४-२१", "content_sanskrit": "पुरा ह्येष मया युक्तः स मे भवति पृष्ठतः ॥\nएवमुक्तेऽर्जुनेनासावश्वत्थामरथं प्रति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2034398, "chapter_id": 1741, "verse_number": "४-६४-२२", "content_sanskrit": "विराटपुत्रो जवनान्भृशमश्वानचोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2034399, "chapter_id": 1741, "verse_number": "४-६४-२३x", "content_sanskrit": "कर्ण उवाच।\nएषोपयाति बीभत्सुर्व्यथितो गाढवेदनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2034400, "chapter_id": 1741, "verse_number": "४-६४-२३", "content_sanskrit": "तं तु तत्रैव यास्यामि नासौ मुच्येत जीवितात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2034401, "chapter_id": 1741, "verse_number": "४-६४-२४x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2034402, "chapter_id": 1741, "verse_number": "४-६४-२४", "content_sanskrit": "नासौ भयेन निर्यातो महात्मा पाकशासनिः।\nनैवं भीता निवर्तन्ते न पुनर्गाढवेदनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2034403, "chapter_id": 1741, "verse_number": "४-६४-२५", "content_sanskrit": "यद्येनमभिसंरब्धं पुनरेवाभियास्यसि।\nबहून्यस्त्राणि जानीते न पुनर्मोक्ष्यते भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2034404, "chapter_id": 1741, "verse_number": "४-६४-२६", "content_sanskrit": "दिष्ट्या दुर्योधनो मुक्तो दिष्ट्या गावः पलायिताः।\nमुक्तो दिष्ट्या च संग्रामे किं रणेन करिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2034405, "chapter_id": 1741, "verse_number": "४-६४-२७", "content_sanskrit": "क्रोशमात्रमपाक्रम्य बलमन्वानयामहे।\nअन्वागतबलाः पार्थं पुनरेवाभियास्यथ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2034406, "chapter_id": 1741, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि चतुःषष्टितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]