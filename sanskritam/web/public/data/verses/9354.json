[{"id": 5000354000, "chapter_id": 9354, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे पञ्चदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000354001, "chapter_id": 9354, "verse_number": "५-१५-१", "content_sanskrit": "स वीक्षमाणस्तत्रस्थो मार्गमाणश्च मैथिलीम्।\nअवेक्षमाणश्च महीं सर्वां तामन्ववैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000354002, "chapter_id": 9354, "verse_number": "५-१५-२", "content_sanskrit": "संतानकलताभिश्च पादपैरुपशोभिताम्।\nदिव्यगन्धरसोपेतां सर्वतः समलंकृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000354003, "chapter_id": 9354, "verse_number": "५-१५-३", "content_sanskrit": "तां स नन्दनसंकाशां मृगपक्षिभिरावृताम्।\nहर्म्यप्रासादसम्बाधां कोकिलाकुलनिःस्वनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000354004, "chapter_id": 9354, "verse_number": "५-१५-४", "content_sanskrit": "काञ्चनोत्पलपद्माभिर्वापीभिरुपशोभिताम्।\nबह्वासनकुथोपेतां बहुभूमिगृहायुताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000354005, "chapter_id": 9354, "verse_number": "५-१५-५", "content_sanskrit": "सर्वर्तुकुसुमै रम्यैः फलवद्भिश्च पादपैः।\nपुष्पितानामशोकानां श्रिया सूर्योदयप्रभाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000354006, "chapter_id": 9354, "verse_number": "५-१५-६", "content_sanskrit": "प्रदीप्तामिव तत्रस्थो मारुतिः समुदैक्षत।\nनिष्पत्रशाखां विहगैः क्रियमाणामिवासकृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000354007, "chapter_id": 9354, "verse_number": "५-१५-७", "content_sanskrit": "विनिष्पतद्भिः शतशश्चित्रैः पुष्पावतंसकैः।\nसमूलपुष्परचितैरशोकैः शोकनाशनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000354008, "chapter_id": 9354, "verse_number": "५-१५-८", "content_sanskrit": "पुष्पभारातिभारैश्च स्पृशद्भिरिव मेदिनीम्।\nकर्णिकारैः कुसुमितैः किंशुकैश्च सुपुष्पितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000354009, "chapter_id": 9354, "verse_number": "५-१५-९", "content_sanskrit": "स देशः प्रभया तेषां प्रदीप्त इव सर्वतः।\nपुंनागाः सप्तपर्णाश्च चम्पकोद्दालकास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000354010, "chapter_id": 9354, "verse_number": "५-१५-१०", "content_sanskrit": "विवृद्धमूला बहवः शोभन्ते स्म सुपुष्पिताः।\nशातकुम्भनिभाः केचित् केचिदग्निशिखप्रभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000354011, "chapter_id": 9354, "verse_number": "५-१५-११", "content_sanskrit": "नीलाञ्जननिभाः केचित् तत्राशोकाः सहस्रशः।\nनन्दनं विबुधोद्यानं चित्रं चैत्ररथं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000354012, "chapter_id": 9354, "verse_number": "५-१५-१२", "content_sanskrit": "अतिवृत्तमिवाचिन्त्यं दिव्यं रम्यश्रियायुतम्।\nद्वितीयमिव चाकाशं पुष्पज्योतिर्गणायुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000354013, "chapter_id": 9354, "verse_number": "५-१५-१३", "content_sanskrit": "पुष्परत्नशतैश्चित्रं पञ्चमं सागरं यथा।\nसर्वर्तुपुष्पैर्निचितं पादपैर्मधुगन्धिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000354014, "chapter_id": 9354, "verse_number": "५-१५-१४", "content_sanskrit": "नानानिनादैरुद्यानं रम्यं मृगगणद्विजैः।\nअनेकगन्धप्रवहं पुण्यगन्धं मनोहरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000354015, "chapter_id": 9354, "verse_number": "५-१५-१५", "content_sanskrit": "शैलेन्द्रमिव गन्धाढ्यं द्वितीयं गन्धमादनम्।\nअशोकवनिकायां तु तस्यां वानरपुंगवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000354016, "chapter_id": 9354, "verse_number": "५-१५-१६", "content_sanskrit": "स ददर्शाविदूरस्थं चैत्यप्रासादमूर्जितम्।\nमध्ये स्तम्भसहस्रेण स्थितं कैलासपाण्डुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000354017, "chapter_id": 9354, "verse_number": "५-१५-१७", "content_sanskrit": "प्रवालकृतसोपानं तप्तकाञ्चनवेदिकम्।\nमुष्णन्तमिव चक्षूंषि द्योतमानमिव श्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000354018, "chapter_id": 9354, "verse_number": "५-१५-१८", "content_sanskrit": "निर्मलं प्रांशुभावत्वादुल्लिखन्तमिवाम्बरम्।\nततो मलिनसंवीतां राक्षसीभिः समावृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000354019, "chapter_id": 9354, "verse_number": "५-१५-१९", "content_sanskrit": "उपवासकृशां दीनां निःश्वसन्तीं पुनः पुनः।\nददर्श शुक्लपक्षादौ चन्द्ररेखामिवामलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000354020, "chapter_id": 9354, "verse_number": "५-१५-२०", "content_sanskrit": "मन्दप्रख्यायमानेन रूपेण रुचिरप्रभाम्।\nपिनद्धां धूमजालेन शिखामिव विभावसोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000354021, "chapter_id": 9354, "verse_number": "५-१५-२१", "content_sanskrit": "पीतेनैकेन संवीतां क्लिष्टेनोत्तमवाससा।\nसपङ्कामनलंकारां विपद्मामिव पद्मिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000354022, "chapter_id": 9354, "verse_number": "५-१५-२२", "content_sanskrit": "पीडितां दुःखसंतप्तां परिक्षीणां तपस्विनीम्।\nग्रहेणांगारकेणेव पीडितामिव रोहिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000354023, "chapter_id": 9354, "verse_number": "५-१५-२३", "content_sanskrit": "अश्रुपूर्णमुखीं दीनां कृशामनशनेन च।\nशोकध्यानपरां दीनां नित्यं दुःखपरायणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000354024, "chapter_id": 9354, "verse_number": "५-१५-२४", "content_sanskrit": "प्रियं जनमपश्यन्तीं पश्यन्तीं राक्षसीगणम्।\nस्वगणेन मृगीं हीनां श्वगणेनावृतामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000354025, "chapter_id": 9354, "verse_number": "५-१५-२५", "content_sanskrit": "नीलनागाभया वेण्या जघनं गतयैकया।\nनीलया नीरदापाये वनराज्या महीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000354026, "chapter_id": 9354, "verse_number": "५-१५-२६", "content_sanskrit": "सुखार्हां दुःखसंतप्तां व्यसनानामकोविदाम्।\nतां विलोक्य विशालाक्षीमधिकं मलिनां कृशाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000354027, "chapter_id": 9354, "verse_number": "५-१५-२७", "content_sanskrit": "तर्कयामास सीतेति कारणैरुपपादिभिः।\nह्रियमाणा तदा तेन रक्षसा कामरूपिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000354028, "chapter_id": 9354, "verse_number": "५-१५-२८", "content_sanskrit": "यथारूपा हि दृष्टा सा तथारूपेयमंगना।\nपूर्णचन्द्राननां सुभ्रूं चारुवृत्तपयोधराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000354029, "chapter_id": 9354, "verse_number": "५-१५-२९", "content_sanskrit": "कुर्वतीं प्रभया देवीं सर्वा वितिमिरा दिशः।\nतां नीलकण्ठीं बिम्बोष्ठीं सुमध्यां सुप्रतिष्ठिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000354030, "chapter_id": 9354, "verse_number": "५-१५-३०", "content_sanskrit": "सीतां पद्मपलाशाक्षीं मन्मथस्य रतिं यथा।\nइष्टां सर्वस्य जगतः पूर्णचन्द्रप्रभामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000354031, "chapter_id": 9354, "verse_number": "५-१५-३१", "content_sanskrit": "भूमौ सुतनुमासीनां नियतामिव तापसीम्।\nनिःश्वासबहुलां भीरुं भुजगेन्द्रवधूमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000354032, "chapter_id": 9354, "verse_number": "५-१५-३२", "content_sanskrit": "शोकजालेन महता विततेन न राजतीम्।\nसंसक्तां धूमजालेन शिखामिव विभावसोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000354033, "chapter_id": 9354, "verse_number": "५-१५-३३", "content_sanskrit": "तां स्मृतीमिव संदिग्धामृद्धिं निपतितामिव।\nविहतामिव च श्रद्धामाशां प्रतिहतामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000354034, "chapter_id": 9354, "verse_number": "५-१५-३४", "content_sanskrit": "सोपसर्गां यथा सिद्धिं बुद्धिं सकलुषामिव।\nअभूतेनापवादेन कीर्तिं निपतितामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000354035, "chapter_id": 9354, "verse_number": "५-१५-३५", "content_sanskrit": "रामोपरोधव्यथितां रक्षोगणनिपीडिताम्।\nअबलां मृगशावाक्षीं वीक्षमाणां ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000354036, "chapter_id": 9354, "verse_number": "५-१५-३६", "content_sanskrit": "बाष्पाम्बुपरिपूर्णेन कृष्णवक्राक्षिपक्ष्मणा।\nवदनेनाप्रसन्नेन निःश्वसन्तीं पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000354037, "chapter_id": 9354, "verse_number": "५-१५-३७", "content_sanskrit": "मलपङ्कधरां दीनां मण्डनार्हाममण्डिताम्।\nप्रभां नक्षत्रराजस्य कालमेघैरिवावृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000354038, "chapter_id": 9354, "verse_number": "५-१५-३८", "content_sanskrit": "तस्य संदिदिहे बुद्धिस्तथा सीतां निरीक्ष्य च।\nआम्नायानामयोगेन विद्यां प्रशिथिलामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000354039, "chapter_id": 9354, "verse_number": "५-१५-३९", "content_sanskrit": "दुःखेन बुबुधे सीतां हनुमाननलंकृताम्।\nसंस्कारेण यथा हीनां वाचमर्थान्तरं गताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000354040, "chapter_id": 9354, "verse_number": "५-१५-४०", "content_sanskrit": "तां समीक्ष्य विशालाक्षीं राजपुत्रीमनिन्दिताम्।\nतर्कयामास सीतेति कारणैरुपपादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000354041, "chapter_id": 9354, "verse_number": "५-१५-४१", "content_sanskrit": "वैदेह्या यानि चांगेषु तदा रामोऽन्वकीर्तयत्।\nतान्याभरणजालानि गात्रशोभीन्यलक्षयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000354042, "chapter_id": 9354, "verse_number": "५-१५-४२", "content_sanskrit": "सुकृतौ कर्णवेष्टौ च श्वदंष्ट्रौ च सुसंस्थितौ।\nमणिविद्रुमचित्राणि हस्तेष्वाभरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000354043, "chapter_id": 9354, "verse_number": "५-१५-४३", "content_sanskrit": "श्यामानि चिरयुक्तत्वात् तथा संस्थानवन्ति च।\nतान्येवैतानि मन्येऽहं यानि रामोऽन्वकीर्तयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000354044, "chapter_id": 9354, "verse_number": "५-१५-४४", "content_sanskrit": "तत्र यान्यवहीनानि तान्यहं नोपलक्षये।\nयान्यस्या नावहीनानि तानीमानि न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000354045, "chapter_id": 9354, "verse_number": "५-१५-४५", "content_sanskrit": "पीतं कनकपट्टाभं स्रस्तं तद्वसनं शुभम्।\nउत्तरीयं नगासक्तं तदा दृष्टं प्लवंगमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000354046, "chapter_id": 9354, "verse_number": "५-१५-४६", "content_sanskrit": "भूषणानि च मुख्यानि दृष्टानि धरणीतले।\nअनयैवापविद्धानि स्वनवन्ति महान्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000354047, "chapter_id": 9354, "verse_number": "५-१५-४७", "content_sanskrit": "इदं चिरगृहीतत्वाद् वसनं क्लिष्टवत्तरम्।\nतथाप्यनूनं तद्वर्णं तथा श्रीमद्यथेतरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000354048, "chapter_id": 9354, "verse_number": "५-१५-४८", "content_sanskrit": "इयं कनकवर्णांगी रामस्य महिषी प्रिया।\nप्रणष्टापि सती यस्य मनसो न प्रणश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000354049, "chapter_id": 9354, "verse_number": "५-१५-४९", "content_sanskrit": "इयं सा यत्कृते रामश्चतुर्भिरिह तप्यते।\nकारुण्येनानृशंस्येन शोकेन मदनेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000354050, "chapter_id": 9354, "verse_number": "५-१५-५०", "content_sanskrit": "स्त्री प्रणष्टेति कारुण्यादाश्रितेत्यानृशंस्यतः।\nपत्नी नष्टेति शोकेन प्रियेति मदनेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000354051, "chapter_id": 9354, "verse_number": "५-१५-५१", "content_sanskrit": "अस्या देव्या यथारूपमंगप्रत्यंगसौष्ठवम्।\nरामस्य च यथारूपं तस्येयमसितेक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000354052, "chapter_id": 9354, "verse_number": "५-१५-५२", "content_sanskrit": "अस्या देव्या मनस्तस्मिंस्तस्य चास्यां प्रतिष्ठितम्।\nतेनेयं स च धर्मात्मा मुहूर्तमपि जीवति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000354053, "chapter_id": 9354, "verse_number": "५-१५-५३", "content_sanskrit": "दुष्करं कृतवान् रामो हीनो यदनया प्रभुः।\nधारयत्यात्मनो देहं न शोकेनावसीदति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000354054, "chapter_id": 9354, "verse_number": "५-१५-५४", "content_sanskrit": "एवं सीतां तथा दृष्ट्वा हृष्टः पवनसम्भवः।\nजगाम मनसा रामं प्रशशंस च तं प्रभुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000354055, "chapter_id": 9354, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे पञ्चदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]