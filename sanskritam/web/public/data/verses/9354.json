[{"id": 40021353, "chapter_id": 9354, "verse_number": "1", "content_sanskrit": "अपृच्छत तदा रामो दक्षिणाशाश्रमं मुनिम् । प्राञ्जलिर्विनयोपेत इदमाह वचो ऽर्थवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40021354, "chapter_id": 9354, "verse_number": "2", "content_sanskrit": "अतुलं बलमेतद्वै वालिनो रावणस्य च । न त्वेताभ्यां हनुमता समं त्विति मतिर्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40021355, "chapter_id": 9354, "verse_number": "3", "content_sanskrit": "शौर्यं दाक्ष्यं बलं धैर्यं प्राज्ञता नयसाधनम् । विक्रमश्च प्रभावश्च हनूमति कृतालयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40021356, "chapter_id": 9354, "verse_number": "4", "content_sanskrit": "दृष्ट्वैव सागरं वीक्ष्य सीदन्तीं कपिवाहिनीम् । समाश्वास्य महाबाहुर्योजनानां शतं प्लुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40021357, "chapter_id": 9354, "verse_number": "5", "content_sanskrit": "धर्षयित्वा पुरीं लङ्कां रावणान्तःपुरं तदा । दृष्ट्वा सम्भाषिता चापि सीता ह्याश्वासिता तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40021358, "chapter_id": 9354, "verse_number": "6", "content_sanskrit": "सेनाग्रगा मन्त्रिसुताः किङ्करा रावणात्मजः । एते हनुमता तत्र ह्येकेन वितिपातिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40021359, "chapter_id": 9354, "verse_number": "7", "content_sanskrit": "भूयो बन्धाद्विमुक्तेन भाषयित्वा दशाननम् । लङ्का भस्मीकृता येन पावकेनेव मेदिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40021360, "chapter_id": 9354, "verse_number": "8", "content_sanskrit": "न कालस्य न शक्रस्य न विष्णोर्वित्तपस्य च । कर्माणि तानि श्रूयन्ते यानि युद्धे हनूमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40021361, "chapter_id": 9354, "verse_number": "9", "content_sanskrit": "एतस्य बाहुवीर्येण लङ्का सीता च लक्ष्मणः । प्राप्ता मया जयश्चैव राज्यं मित्राणि बान्धवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40021362, "chapter_id": 9354, "verse_number": "10", "content_sanskrit": "हनूमान्यदि मे नः स्याद्वानराधिपतेः सखा । प्रवृत्तिमपि को वेत्तुं जानक्याः शक्तिमान्भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40021363, "chapter_id": 9354, "verse_number": "11", "content_sanskrit": "किमर्थं वाल्यनेनैव सुग्रीवप्रियकाम्यया । तदा वैरे समुत्पन्ने न दग्धो वीरुधो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40021364, "chapter_id": 9354, "verse_number": "12", "content_sanskrit": "नहि वेदितवान्मन्ये हनूमानात्मनो बलम् । यद्दृष्टवाञ्जीवितेष्टं क्लिश्यन्तं वानराधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40021365, "chapter_id": 9354, "verse_number": "13", "content_sanskrit": "एतन्मे भगवन्सर्वं हनूमति महामतौ । विस्तरेण यथातत्त्वं कथयामरपूजित ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40021366, "chapter_id": 9354, "verse_number": "14", "content_sanskrit": "राघवस्य वचः श्रुत्वा हेतुयुक्तमृषिस्तदा । हनूमतः समक्षं तमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40021367, "chapter_id": 9354, "verse_number": "15", "content_sanskrit": "सत्यमेतद्रघुश्रेष्ठ यद्ब्रवीषि हनूमतः । न बले विद्यते तुल्यो न गतौ न मतौ परः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40021368, "chapter_id": 9354, "verse_number": "16", "content_sanskrit": "अमोघशापैः शप्तस्तु दत्तो ऽस्य मुनिभिः पुरा । न वेत्ता हि बलं येन बली सन्निरिमर्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40021369, "chapter_id": 9354, "verse_number": "17", "content_sanskrit": "बाल्ये ऽप्येतेन यत्कर्म कृतं राम महाबल । तन्न वर्णयितुं शक्यमिति बालतया ऽ ऽस्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40021370, "chapter_id": 9354, "verse_number": "18", "content_sanskrit": "यदि वा ऽस्ति त्वभिप्रायस्तच्छ्रोतुं तव राघव । समाधाय मतिं राम निशामय वदाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40021371, "chapter_id": 9354, "verse_number": "19", "content_sanskrit": "सूर्यदत्तवरस्वर्णः सुमेरुर्नाम पर्वतः । यत्र राज्यं प्रशास्त्यस्य केसरी नाम वै पिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40021372, "chapter_id": 9354, "verse_number": "20", "content_sanskrit": "तस्य भार्या बभूवैषा ह्यञ्जनेति परिश्रुता । जनयामास तस्यां वै वायुरात्मजमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40021373, "chapter_id": 9354, "verse_number": "21", "content_sanskrit": "शालिशूकनिभाभासं प्रासूतामुं तदा ऽञ्जना । फलान्याहर्तुकामा वै निष्क्रान्ता गहनेचरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40021374, "chapter_id": 9354, "verse_number": "22", "content_sanskrit": "एष मातुर्वियोगाच्च क्षुधया च भृशार्दितः । रुरोद शिशुरत्यर्थं शिशुः शरवणे यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40021375, "chapter_id": 9354, "verse_number": "23", "content_sanskrit": "तदोद्यन्तं विवस्वन्तं जपापुष्पोत्करोपमम् । ददर्श फललोभाच्च ह्युत्पपात रविं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40021376, "chapter_id": 9354, "verse_number": "24", "content_sanskrit": "बालार्काभिमुखो बालो बालार्क इव मूर्तिमान् । ग्रहीतुकामो बालार्कं प्लवते ऽम्बरमध्यगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40021377, "chapter_id": 9354, "verse_number": "25", "content_sanskrit": "एतस्मिन्प्लवमाने तु शिशुभावे हनूमति । देवदानवयक्षाणां विस्मयः सुमहानभूत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40021378, "chapter_id": 9354, "verse_number": "26", "content_sanskrit": "नाप्येवं वेगवान्वायुर्गरुडो वा मनस्तथा । यथा ऽयं वायुपुत्रस्तु क्रमते ऽम्बरमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40021379, "chapter_id": 9354, "verse_number": "27", "content_sanskrit": "यदि तावच्छिशोरस्य त्वीदृशो गतिविक्रमः । यौवनं बलमासाद्य कथं वेगो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40021380, "chapter_id": 9354, "verse_number": "28", "content_sanskrit": "तमनुप्लवते वायुः प्लवन्तं पुत्रमात्मनः । सूर्यदाहभयाद्रक्षंस्तुषारचयशीतलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40021381, "chapter_id": 9354, "verse_number": "29", "content_sanskrit": "बहुयोजनसाहस्रं क्रमत्येष गतोम्बरम् । पितुर्बलाच्च बाल्याच्च भास्कराभ्याशमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40021382, "chapter_id": 9354, "verse_number": "30", "content_sanskrit": "शिशुरेष त्वदोषज्ञ इति मत्वा दिवाकरः । कार्यं चात्र समायत्तमित्येवं न ददाह सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40021383, "chapter_id": 9354, "verse_number": "31", "content_sanskrit": "यमेव दिवसं ह्येष ग्रहीतुं भास्करं प्लुतः । तमेव दिवसं राहुर्जिघृक्षति दिवाकरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40021384, "chapter_id": 9354, "verse_number": "32", "content_sanskrit": "अनेन स परामृष्टो राम सूर्यरथोपरि । अपक्रान्तस्ततस्त्रस्तो राहुश्चन्द्रार्कमर्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40021385, "chapter_id": 9354, "verse_number": "33", "content_sanskrit": "स इन्द्रभवनं गत्वा सरोषः सिंहिकासुतः । अब्रवीद्भ्रुकुटिं कृत्वा देवं देवगणैर्वृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40021386, "chapter_id": 9354, "verse_number": "34", "content_sanskrit": "बुभुक्षापनयं दत्त्वा चन्द्रार्कौ मम वासव । किमिदं तत्त्वया दत्तमन्यस्य बलवृत्रहन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40021387, "chapter_id": 9354, "verse_number": "35", "content_sanskrit": "अद्याहं पर्वकाले तु जिघृक्षुः सूर्यमागतः । अथान्यो राहुरासाद्य जग्राह सहसा रविम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40021388, "chapter_id": 9354, "verse_number": "36", "content_sanskrit": "स राहोर्वचनं श्रुत्वा वासवः सम्भ्रमान्वितः । उत्पपातासनं हित्वा चोद्वहन्काञ्चनीं स्रजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40021389, "chapter_id": 9354, "verse_number": "37", "content_sanskrit": "ततः कैलासकूटाभं चतुर्दन्तं मदस्रवम् । शृङ्गारधारिणं प्रांशुं स्वर्णघण्टाट्टहासिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40021390, "chapter_id": 9354, "verse_number": "38", "content_sanskrit": "इन्द्रः करीन्द्रमारुह्य राहुं कृत्वा पुरःसरम् । प्रायाद्यत्राभवत्सूर्यः सहानेन हनूमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40021391, "chapter_id": 9354, "verse_number": "39", "content_sanskrit": "अथातिरभसेनागाद्राहुरुत्सृज्य वासवम् । अनेन च स वै दृष्टः प्रधावञ्छैलकूटवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40021392, "chapter_id": 9354, "verse_number": "40", "content_sanskrit": "ततः सूर्यं समुत्सृज्य राहुं फलमवेक्ष्य च । उत्पपात पुनर्व्योम ग्रहीतुं सिंहिकासुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40021393, "chapter_id": 9354, "verse_number": "41", "content_sanskrit": "उत्सृज्यार्कमिमं राम प्रधावन्तं प्लवङ्गमम् । अवेक्ष्यैवं परावृत्त्य मुखशेषः पराङ्मुखः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40021394, "chapter_id": 9354, "verse_number": "42", "content_sanskrit": "इन्द्रमाशंसमानस्तु त्रातारं सिंहिकासुतः । इन्द्र इन्द्रेति संत्रासान्मुहुर्महुरभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40021395, "chapter_id": 9354, "verse_number": "43", "content_sanskrit": "राहोर्विक्रोशमानस्य प्रागेवालक्षितं स्वरम् । श्रुत्वेन्द्रोवाच मा भैषीरहमेनं निषूदये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40021396, "chapter_id": 9354, "verse_number": "44", "content_sanskrit": "ऐरावतं ततो दृष्ट्वा महत्तदिदमित्यपि । फलं मत्वा हस्तिराजमभिदुद्राव मारुतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40021397, "chapter_id": 9354, "verse_number": "45", "content_sanskrit": "तथास्य धावतो रूपमैरावतजिघृक्षया । मुहूर्तमभवद्घोरमिन्द्राग्न्योरिव भास्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40021398, "chapter_id": 9354, "verse_number": "46", "content_sanskrit": "एवमाधावमानं तु नातिक्रुद्धः शचीपतिः । हस्तान्तादतिमुक्तेन कुलिशेनाभ्यताडयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40021399, "chapter_id": 9354, "verse_number": "47", "content_sanskrit": "ततो गिरौ पपातैष इन्द्रवज्राभिताडितः । पतमानस्य चैतस्य वामो हनुरभज्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40021400, "chapter_id": 9354, "verse_number": "48", "content_sanskrit": "तस्मिंस्तु पतिते बाले वज्रताडनविह्वले । चुक्रोधेन्द्राय पवनः प्रजानामहिताय सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40021401, "chapter_id": 9354, "verse_number": "49", "content_sanskrit": "प्रचारं स तु सङ्गृह्य प्रजास्वन्तर्गतः प्रभुः । गुहां प्रविष्टः स्वसुतं शिशुमादाय मारुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40021402, "chapter_id": 9354, "verse_number": "50", "content_sanskrit": "विण्मूत्राशयमावृत्य प्रजानां परमार्तिकृत् । रुरोध सर्वभूतानि यथा वर्षाणि वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 40021403, "chapter_id": 9354, "verse_number": "51", "content_sanskrit": "वायुप्रकोपाद्भूतानि निरुच्छ्वासानि सर्वतः । सन्धिभिर्भिद्यमानैश्च काष्ठभूतानि जज्ञिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 40021404, "chapter_id": 9354, "verse_number": "52", "content_sanskrit": "निःस्वाध्यायवषट्कारं निष्क्रियं धर्मवर्जितम् । वायुप्रकोपात्ऺत्रैलोक्यं निरयस्थमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 40021405, "chapter_id": 9354, "verse_number": "53", "content_sanskrit": "ततः प्रजाः सगन्धर्वाः सदेवासुरमानुषाः । प्रजापतिं समाधावन्दुःखिताश्च सुखेच्छया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 40021406, "chapter_id": 9354, "verse_number": "54", "content_sanskrit": "ऊचुः प्राञ्जलयो देवा महोदरनिभोदराः । त्वया नु भगवन्सृष्टाः प्रजानाथ चतुर्विधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 40021407, "chapter_id": 9354, "verse_number": "55", "content_sanskrit": "त्वया दत्तो ऽयमस्माकमायुषः पवनः पतिः । सो ऽस्मान्प्राणेश्वरो भूत्वा कस्मादेषो ऽद्य सत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 40021408, "chapter_id": 9354, "verse_number": "56", "content_sanskrit": "रुरोध दुःखं जनयन्नन्तःपुर इव स्त्रियः । तस्मात्त्वां शरणं प्राप्ता वायुनोहता वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 40021409, "chapter_id": 9354, "verse_number": "57", "content_sanskrit": "एतत्प्रजानां श्रुत्वा तु प्रजानाथः प्रजापतिः । कारणादिति चोक्त्वासौ प्रजाः पुनरभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 40021410, "chapter_id": 9354, "verse_number": "58", "content_sanskrit": "यस्मिंश्च कारणे वायुश्चुक्रोध च रुरोध च । प्रजाः शृणुध्वं तत्सर्वं श्रोतव्यं चात्मनः क्षमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 40021411, "chapter_id": 9354, "verse_number": "59", "content_sanskrit": "पुत्रस्तस्यामरेशेन इन्द्रेणाद्य निपातितः । राहोर्वचनमास्थाय ततः स कुपितो ऽनिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 40021412, "chapter_id": 9354, "verse_number": "60", "content_sanskrit": "अशरीरः शरीरेषु वायुश्चरति पालयन् । शरीरं हि विना वायुं समतां याति दारुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 40021413, "chapter_id": 9354, "verse_number": "61", "content_sanskrit": "वायुः प्राणः सुखं वायुर्वायुः सर्वमिदं जगत् । वायुना सम्परित्यक्तं न सुखं विन्दते जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 40021414, "chapter_id": 9354, "verse_number": "62", "content_sanskrit": "अद्यैव च परित्यक्तं वायुना जगदायुषा । अद्यैव ते निरुच्छ्वासाः काष्ठकुड्योपमाः स्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 40021415, "chapter_id": 9354, "verse_number": "63", "content_sanskrit": "तद्यामस्तत्र यत्रास्ते मारुतो रुक्प्रदो हि नः । मा विनाशं गमिष्याम अप्रसाद्यादितेः सुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 40021416, "chapter_id": 9354, "verse_number": "64", "content_sanskrit": "ततः प्रजाभिः सहितः प्रजापतिः सदेवगन्धर्वभुजङ्गगुह्यकैः । जगाम तत्रास्यति यत्र मारुतः सुतं सुरेन्द्राभिहतं प्रगृह्य सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 40021417, "chapter_id": 9354, "verse_number": "65", "content_sanskrit": "ततो ऽर्कवैश्वानरकाञ्चनप्रभं सुतं तदोत्सङ्गगतं सदागतेः । चतुर्मुखो वीक्ष्य कृपामथाकरोत्सदेवगन्धर्वर्षियक्षराक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]