[{"id": 50024885, "chapter_id": 11934, "verse_number": "1", "content_sanskrit": "॥ उपोद्घातः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024886, "chapter_id": 11934, "verse_number": "2", "content_sanskrit": "॥ मङ्गलाचरणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024887, "chapter_id": 11934, "verse_number": "3", "content_sanskrit": "सदागमैकविज्ञेयं समतीतक्षराक्षरम्। नारायणं सदा वन्दे निर्दोषाशेषसद्गुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024888, "chapter_id": 11934, "verse_number": "4", "content_sanskrit": "॥ आरम्भणीयत्वसमर्थनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024889, "chapter_id": 11934, "verse_number": "5", "content_sanskrit": "विशेषणानि यानीह कथितानि सदुक्तिभिः। साधयिष्यामि तान्येव क्रमात् सज्जनसंविदे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024890, "chapter_id": 11934, "verse_number": "6", "content_sanskrit": "॥ सदागमैकविज्ञेयत्वपरिच्छेदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024891, "chapter_id": 11934, "verse_number": "7", "content_sanskrit": "॥ नारायणस्य सदागमैकवेद्यत्वप्रतिपादकवचनानि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024892, "chapter_id": 11934, "verse_number": "8", "content_sanskrit": "“ऋगाद्या भारतं चैव पञ्चरात्रमथाखिलम्। मूलरामायणं चैव पुराणं चैतदात्मकम्। ये चानुयायिनस्त्वेषां सर्वे ते च सदागमाः। दुरागमास्तदन्ये ये तैर्न ज्ञेयो जनार्दनः। ज्ञेय एतैः सदायुक्तैर्भक्तिमद्भिः सुनिष्ठितैः। नच केवलतर्केण नाक्षजेन न केनचित्। केवलागमविज्ञेयो भक्तैरेव नचान्यथा॥” इति ब्रह्माण्डे। “नावेदविन्मनुते दं 【पाठभेदः: BG—तं】 बृहन्तं सर्वानुभुमात्मानꣳ साम्पराये” (कुत्र: तैत्तिरीयारण्यकम् ३/१२/९/१७) इति तैत्तिरीयश्रुतिः। 【पाठभेदः: BG—इति हि श्रुतिः।】 “नैषा तर्केण मतिरापनेया प्रोक्ताऽन्येनैव सुज्ञानाय प्रेष्ठ” (कुत्र: काठकोपनिषत् १/२/९) इति कठश्रुतिः। 【पाठभेदः: BG—इति च।】 “नेन्द्रियाणि नानुमानं वेदा ह्येवैनं वेदयन्ति तस्मादाहुर्वेदा इति” 【पाठभेदः: TRK—“नेन्द्रियाणि नानुमानं वेदा ह्येवैनं वेदयन्ति तस्मादाहुर्वेदाः”】 इति पिप्पलादश्रुतिः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024893, "chapter_id": 11934, "verse_number": "9", "content_sanskrit": "॥ वेदादीनां प्रामाण्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50024894, "chapter_id": 11934, "verse_number": "10", "content_sanskrit": "नचैतेषां वचनानामेवाप्रामाण्यम्। अपौरुषेयत्वाद् वेदस्य। “इतिहासपुराणः पञ्चमो वेदानां वेदः” (कुत्र: छान्दोग्योपनिषत् ७/१/२) इति तद्गृहीतत्वाच्च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50024895, "chapter_id": 11934, "verse_number": "11", "content_sanskrit": "॥ वेदापौरुषेयत्ववादः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50024896, "chapter_id": 11934, "verse_number": "12", "content_sanskrit": "॥ अपौरुषेयत्वसम्भावना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]