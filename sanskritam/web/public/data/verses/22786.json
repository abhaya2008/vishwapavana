[{"id": 7002786000, "chapter_id": 22786, "verse_number": "९-७१-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nपुरा बभूव राजर्षिरजपाल इति श्रुतः ।\nप्रार्थितः स प्रजाभिस्तु सर्वदुःखापनुत्तये ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002786001, "chapter_id": 22786, "verse_number": "९-७१-२", "content_sanskrit": "दुःखापनोदं कुरु भो व्याधितानां नरेश्वर ।\nएवमुक्तश्चिरं ध्यात्वा कृत्वा व्याधीन्प्रजागणान् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002786002, "chapter_id": 22786, "verse_number": "९-७१-३", "content_sanskrit": "पालयामास हृष्टोऽसावजपालस्ततोऽभवत् ।\nतेनैषा निर्मिता शांतिर्नाम्ना नीराजता जने ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002786003, "chapter_id": 22786, "verse_number": "९-७१-४", "content_sanskrit": "तस्यास्तु पांडवश्रेष्ठ लक्षणं वच्मि ते शृणु ।\nराज्ञा पुरोहितैः सार्द्धमनुष्ठेया विधानतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002786004, "chapter_id": 22786, "verse_number": "९-७१-५", "content_sanskrit": "तस्मिन्काले वभूवाथ रावणो राक्षसेश्वरः ।\nलंकास्थितः सुरगणान्नियुनक्ति स्वकर्मसु ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002786005, "chapter_id": 22786, "verse_number": "९-७१-६", "content_sanskrit": "अखण्डमण्डलं चन्द्रमातपत्रं चकार ह ।\nइन्द्रं सेनापतिं चक्रे वायुं पांसुप्रमार्जकम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002786006, "chapter_id": 22786, "verse_number": "९-७१-७", "content_sanskrit": "वरुणं बद्धकर्मस्थं धनदं धनरक्षकम् ।\nयमं संयमनेऽरीणां युयुजे मंत्रणे मनुम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002786007, "chapter_id": 22786, "verse_number": "९-७१-८", "content_sanskrit": "मेघाश्छादन्ति नृपतिं द्रुमपुष्पादिपंक्तिषु ।\nसप्तर्षयः शांतिपरा ब्रह्मणा सह संस्थिताः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002786008, "chapter_id": 22786, "verse_number": "९-७१-९", "content_sanskrit": "यामिका मध्यकक्षायां गन्धर्वा गीततत्पराः ।\nप्रेक्षणीयेऽप्सरोवृंदं बाह्ये विद्याधरा वृताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002786009, "chapter_id": 22786, "verse_number": "९-७१-१०", "content_sanskrit": "गंगाद्याः सरितः पाने गार्हपत्ये हुताशनः ।\nविश्वकर्मान्नसंस्कारे यमः शिल्पिप्रयोजने ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002786010, "chapter_id": 22786, "verse_number": "९-७१-११", "content_sanskrit": "तिष्ठंति पार्थिवाः सर्वे पुरःसेवाविधायिनः ।\nदृश्यंते भासुरै रत्नैः प्रभावंतो विभूषणैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002786011, "chapter_id": 22786, "verse_number": "९-७१-१२", "content_sanskrit": "संदृश्य रावणः प्राह प्रशस्तं प्रतिहारकम् ।\nसेवां कर्तुं मम स्थाने ब्रूहि कोऽत्र समागतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002786012, "chapter_id": 22786, "verse_number": "९-७१-१३", "content_sanskrit": "स उवाच प्रणम्याग्रे दंडपाणिर्निशाचरः ।\nएष ककुत्स्थो मांधाता धुंधुमारो नलोर्जुनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002786013, "chapter_id": 22786, "verse_number": "९-७१-१४", "content_sanskrit": "ययातिर्नहुषो भीमो राघवोयं विदूरथः ।\nएते चान्ये च बहवो राजान इति आसते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002786014, "chapter_id": 22786, "verse_number": "९-७१-१५", "content_sanskrit": "मेघाकारास्तव स्थाने नाजपाल इहागतः ।\nरावणः कुपितः प्राह शीघ्रं दूतं व्यसर्जयत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002786015, "chapter_id": 22786, "verse_number": "९-७१-१६", "content_sanskrit": "इत्युक्ते प्रहितो दूतो धूम्राक्षो नाम राक्षसः ।\nधूम्राक्ष गच्छ ब्रूहि त्वमजपालं ममाज्ञया ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002786016, "chapter_id": 22786, "verse_number": "९-७१-१७", "content_sanskrit": "सेवां कुरु समागच्छ कबन्धो यस्य पार्थिवः ।\nअन्यथा चन्द्रहासेन त्वां करिष्ये विकंधरम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002786017, "chapter_id": 22786, "verse_number": "९-७१-१८", "content_sanskrit": "रावणेनैवमुक्तस्तु धूम्राक्षो गरुडो यथा ।\nसंप्राप्य तां पुरीं रम्यां तच्च राजकुलं गतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002786018, "chapter_id": 22786, "verse_number": "९-७१-१९", "content_sanskrit": "ददर्श यं तमेकं स अजपालमजावृतम् ।\nमुक्तकेशं मुक्तकक्षं नैकमुक्तक्रमद्वयम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002786019, "chapter_id": 22786, "verse_number": "९-७१-२०", "content_sanskrit": "यष्टिस्कन्धं रेणुभृतं व्याधिभिः परिवारितम् ।\nनिहतामित्रशार्दूलं सर्वोपद्रवनाशनम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002786020, "chapter_id": 22786, "verse_number": "९-७१-२१", "content_sanskrit": "मह्यामालिख्य नामानि विनिघ्नितं द्विषां गणम् ।\nस्नातं भुक्तं शुभे स्थाने कृतकृत्यं मुनिं यथा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002786021, "chapter_id": 22786, "verse_number": "९-७१-२२", "content_sanskrit": "दृष्ट्वा हृष्टमनाः प्राह धूम्राक्षो रावणोदितम् ।\nसाक्षेपमजपालोऽपि प्रत्युक्त्वा कारणांतरम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002786022, "chapter_id": 22786, "verse_number": "९-७१-२३", "content_sanskrit": "प्रेषयामास धूम्राक्षं ततः कृत्यं समादधे ।\nज्वरमाकारयित्वा तु प्रोवाचेदं महीपतिः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002786023, "chapter_id": 22786, "verse_number": "९-७१-२४", "content_sanskrit": "गच्छ लंकाधिपस्थानमाचरस्व यथोचितम् ।\nनियुक्तस्त्वजपालेन ज्वरो राजञ्जगाम ह ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002786024, "chapter_id": 22786, "verse_number": "९-७१-२५", "content_sanskrit": "गत्वा च कंपयामास सगणं राक्षसेश्वरम् ।\nरावणस्तं विदित्वा तु ज्वरं परमदारुणम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002786025, "chapter_id": 22786, "verse_number": "९-७१-२६", "content_sanskrit": "प्रोवाच तिष्ठतु नृपस्तेन मे न प्रयोजनम् ।\nततः सविज्वरो राजा बभूव धनदानुजः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002786026, "chapter_id": 22786, "verse_number": "९-७१-२७", "content_sanskrit": "तेनैषा निर्मिता शांतिरजपालेन धीमता ।\nसर्वरोगप्रशमनी सर्वोपद्रवनाशिनी ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002786027, "chapter_id": 22786, "verse_number": "९-७१-२८", "content_sanskrit": "कार्तिके शुक्लपक्षस्य द्वादश्यां रजनीमुखे ।\nसमुत्थिते विनिद्रे तु देवे दामोदरे तदा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002786028, "chapter_id": 22786, "verse_number": "९-७१-२९", "content_sanskrit": "वेद्यंते रत्नमालाभी रम्ये मालानुरंजिते ।\nजनयित्वा नवं विष्णुं हुत्वा मंत्रैर्द्विजोत्तमैः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002786029, "chapter_id": 22786, "verse_number": "९-७१-३०", "content_sanskrit": "वर्द्धमानतरूत्थाभिर्दीपिकाभिर्हुताशनम् ।\nकृत्वा महाजनः सर्वैर्हरिं नीराजयेच्छनैः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002786030, "chapter_id": 22786, "verse_number": "९-७१-३१", "content_sanskrit": "पुष्पैरभ्यर्चितं देवं समालब्धं च चन्दनैः ।\nबदरैः कर्बुरैश्चैव त्रपुसैरिक्षुभिस्तथा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002786031, "chapter_id": 22786, "verse_number": "९-७१-३२", "content_sanskrit": "गन्धैः पुष्पैरंलकारैर्वस्त्रै रत्नैश्च पूजितैः ।\nतस्यैवानुमता लक्ष्मीं ब्रह्माणं चंडिकां तथा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002786032, "chapter_id": 22786, "verse_number": "९-७१-३३", "content_sanskrit": "आदित्यं शंकरं गौरीं यक्षं गणपतिं ग्रहान् ।\nमातरं पितरं नागान्सर्वान्नीराजयेत्ततः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002786033, "chapter_id": 22786, "verse_number": "९-७१-३४", "content_sanskrit": "गवां नीराजनं कुर्यान्महिष्यादेश्च मंडलम् ।\nभ्रामयेत्त्रासयेच्छर्दिघंटावादनछादनैः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002786034, "chapter_id": 22786, "verse_number": "९-७१-३५", "content_sanskrit": "ता गावः प्रसुता यांति स्वापीडास्तबकांगदाः ।\nसिन्दूरकृतशृंगाग्राः संभारवशवत्सकाः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002786035, "chapter_id": 22786, "verse_number": "९-७१-३६", "content_sanskrit": "अनुयांति सगोपालाः कालयंतो धनानि ते ।\nछेदानुलिप्तरक्ताङ्गा रक्तपीतसितांबराः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002786036, "chapter_id": 22786, "verse_number": "९-७१-३७", "content_sanskrit": "एवं कोलाहले वृत्ते गवां नीराजनोत्सवे ।\nतुरगांल्लक्षणैर्युक्तान्द्विरदांश्च सुपूजितान् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002786037, "chapter_id": 22786, "verse_number": "९-७१-३८", "content_sanskrit": "राजचिह्नानि सर्वाणि उद्धृत्य स्वगृहांगणे ।\nराजा पुरोहितैः सार्द्धं मंत्रिभृत्यपुरःसरः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002786038, "chapter_id": 22786, "verse_number": "९-७१-३९", "content_sanskrit": "सिंहासनोपविष्टश्च शंखतूर्यादिनिस्वनैः ।\nपूजयेद्गन्धकुसुमैर्वस्त्रदीपविलेपनैः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002786039, "chapter_id": 22786, "verse_number": "९-७१-४०", "content_sanskrit": "ततः स्त्रीलक्षणैर्युक्ता वेश्या वाथ कुलाङ्गना ।\nशीर्षोपरि नरेन्द्रस्य भ्राभयेद्दारुपात्रिकाम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002786040, "chapter_id": 22786, "verse_number": "९-७१-४१", "content_sanskrit": "शांतिरस्तु समृद्धिश्च द्विजैश्च स्वजनेन च ।\nततो नीराजयेत्सौम्यं हस्त्यश्वरथसंकुलम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002786041, "chapter_id": 22786, "verse_number": "९-७१-४२", "content_sanskrit": "एवमेषा महाशांतिः ख्याता नीराजने जने ।\nयेषां राष्ट्रे पुरे ग्रामे क्रियते पांडुनन्दन ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002786042, "chapter_id": 22786, "verse_number": "९-७१-४३", "content_sanskrit": "तेषां रोगाः क्षयं यांति सुभिक्षं वर्द्धते तदा ।\nशांतिनीराजनाल्लोके सर्वान्रोगान्व्यपोहति ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002786043, "chapter_id": 22786, "verse_number": "९-७१-४४", "content_sanskrit": "लोकानावर्द्धयित्वा तु अजपालवरो यथा ।\nएषां रोगादिपीडासु जंतूनां हितमिच्छता ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002786044, "chapter_id": 22786, "verse_number": "९-७१-४५", "content_sanskrit": "वर्षेवर्षे प्रयोक्तव्या शांतिर्नीराजना इति ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002786045, "chapter_id": 22786, "verse_number": "९-७१-४६", "content_sanskrit": "नीराजयंति नवमेघनिभं हरिं ये गोब्राह्मणान्रथगजांश्च नरेशचिह्नान् ।\nते सर्वरोगरहिताश्च नुता नरेन्द्रैरिंद्रप्रभा भुवि भवंत्यजपालवाक्यात् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]