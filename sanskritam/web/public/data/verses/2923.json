[{"id": 2090507, "chapter_id": 2923, "verse_number": "१३-५३-१", "content_sanskrit": "`युधिष्ठिर उवाच।\nवैश्ययोन्यां समुत्पन्नाः शूद्रयोन्यां तथैव च।\nब्रह्मर्षय इति प्रोक्ताः पुराणि द्विजसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2090508, "chapter_id": 2923, "verse_number": "१३-५३-२", "content_sanskrit": "कथमेतन्महाराज तत्त्वं शंसितुमर्हसि।\nविरुद्धमिह पश्यामि वियोनौ ब्राह्मणो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2090509, "chapter_id": 2923, "verse_number": "१३-५३-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2090510, "chapter_id": 2923, "verse_number": "१३-५३-३", "content_sanskrit": "अलं कौतूहलेनात्र निबोध त्वं युधिष्ठिर।\nशुभेतरं शुभं वाऽपि न चिन्तयितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2090511, "chapter_id": 2923, "verse_number": "१३-५३-४", "content_sanskrit": "ईशन्त्यात्मन इत्येते गतिश्चैषां न सञ्जते।\nब्रह्मभूयांस इत्येव ऋषयः श्रुतिचोदिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2090512, "chapter_id": 2923, "verse_number": "१३-५३-५", "content_sanskrit": "निन्द्या न चैते राजेन्द्र प्रमाणं हि प्रमाणिनाम्।\nलोकोऽनुमन्यते चैतान्प्रमाणं ह्यत्र वै तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2090513, "chapter_id": 2923, "verse_number": "१३-५३-६", "content_sanskrit": "एवं महात्मभिस्तात तपोज्ञानसमन्वितैः।\nप्रवर्तितानि कार्याणि प्रमाणान्येव सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2090514, "chapter_id": 2923, "verse_number": "१३-५३-७", "content_sanskrit": "भार्याश्चतस्रो राजेन्द्र ब्राह्मणस्य स्वधर्मतः।\nब्राह्मणी क्षत्रिया वैश्या शूद्रा च भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2090515, "chapter_id": 2923, "verse_number": "१३-५३-८", "content_sanskrit": "राज्ञां तु क्षत्रिया वैश्या शूद्रा च भरतर्षभ।\nवैश्यस्य वैश्या विहिता शूद्रा च भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2090516, "chapter_id": 2923, "verse_number": "१३-५३-९", "content_sanskrit": "शूद्रस्यैका स्मृता भार्या प्रतिलोमे तु सङ्करः।\nशूद्रायास्तु नरश्रेष्ठ चत्वारः पतयः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2090517, "chapter_id": 2923, "verse_number": "१३-५३-१०", "content_sanskrit": "वर्णोत्तमायास्तु पतिः सवर्णस्त्वेक एव सः।\nद्वौ क्षत्रियाया विहितौ ब्राह्मणः क्षत्रियस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2090518, "chapter_id": 2923, "verse_number": "१३-५३-११", "content_sanskrit": "वैश्यायास्तु नरश्रेष्ठ विहिताः पतयस्त्रयः।\nसवर्णः क्षत्रियश्चैव ब्राह्मणश्च विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2090519, "chapter_id": 2923, "verse_number": "१३-५३-१२", "content_sanskrit": "एवंविधिमनुस्मृत्य ततस्ते ऋषिभिः पुरा।\nउत्पादिता महात्मानः पुत्रा ब्रह्मर्षयः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2090520, "chapter_id": 2923, "verse_number": "१३-५३-१३", "content_sanskrit": "पुराणाभ्यामृषिभ्यां तु मित्रेण वरुणेन च।\nवसिष्ठोऽथ तथाऽगस्त्यो बर्हिषव्यस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2090521, "chapter_id": 2923, "verse_number": "१३-५३-१४", "content_sanskrit": "कक्षीवानार्ष्टिषेणश्च पुरुषः कष एव च।\nमामतेयस्य वै पुत्रा गौतमश्चात्मजाः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2090522, "chapter_id": 2923, "verse_number": "१३-५३-१५", "content_sanskrit": "वत्सप्रियश्च भगवान्स्थूलरश्मिस्तथाक्षणिः।\nगौतमस्यैव तनया ये दास्यां जनिता ह्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2090523, "chapter_id": 2923, "verse_number": "१३-५३-१६", "content_sanskrit": "कपिञ्जलादो ब्रह्मर्षिश्चाण्डाल्यामुदपद्यत।\nवैनतेयस्तथा पक्षी तुर्यायां च वसिष्ठतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2090524, "chapter_id": 2923, "verse_number": "१३-५३-१७", "content_sanskrit": "प्रसादाच्च वसिष्ठस्य शुक्लाभ्युपगमेन च।\nअदृश्यन्त्याः पिता वैश्यो नाम्ना चित्रमुखः पुरा।\nब्राह्मणत्वमनुप्राप्तो ब्रह्मर्षित्वं च कौरव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2090525, "chapter_id": 2923, "verse_number": "१३-५३-१८", "content_sanskrit": "वैश्यश्चित्रमुखः कन्यां वसिष्ठतनयस्य वै।\nशुभां प्रादाद्यतो जातो ब्रह्मर्षिस्तु पराशरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2090526, "chapter_id": 2923, "verse_number": "१३-५३-१९", "content_sanskrit": "तथैव दाशकन्यायां सत्यवत्यां महानृषिः।\nपराशरात्प्रसूतश्च व्यासो योगमयो मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2090527, "chapter_id": 2923, "verse_number": "१३-५३-२०", "content_sanskrit": "विभण्डकस्य मृग्यां च तपोयोगात्मको मुनिः।\nऋस्यशृङ्गः समुत्पन्नो ब्रह्मचारी महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2090528, "chapter_id": 2923, "verse_number": "१३-५३-२१", "content_sanskrit": "शार्ङ्ग्यां च मन्दपालस्य चत्वारो ब्रह्मवादिनः।\nजाता ब्रह्मर्षयः पुण्या यैः स्तुतो हव्यवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2090529, "chapter_id": 2923, "verse_number": "१३-५३-२२", "content_sanskrit": "द्रोणश्च स्तम्बमित्रश्च सारिसृक्वश्च बुद्धिमान्।\nजरितारिश्च विख्यातश्चत्वारः सूर्यसन्निभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2090530, "chapter_id": 2923, "verse_number": "१३-५३-२३", "content_sanskrit": "महर्षेः कालवृक्षस्य शकुन्त्यामेव जज्ञिवान्।\nहिरण्यहस्तो भगवान्महर्षिः काञ्चनप्रभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2090531, "chapter_id": 2923, "verse_number": "१३-५३-२४", "content_sanskrit": "पावकात्तात सम्भूता मनसा च महर्षयः।\nपितामहस्य राजेन्द्र पुरस्त्यपुलहादयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2090532, "chapter_id": 2923, "verse_number": "१३-५३-२५", "content_sanskrit": "सावर्ण्यश्चापि राजर्षिः सवर्णायामजायत।\nमृण्मय्यां भरतश्रेष्ठ आदित्येन विवस्वता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2090533, "chapter_id": 2923, "verse_number": "१३-५३-२६", "content_sanskrit": "शाण्डिल्यश्चाग्नितो जातः कश्यपस्याग्रजः प्रभुः।\nशरद्वतः शरस्तम्बात्कृपश्व कृपया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2090534, "chapter_id": 2923, "verse_number": "१३-५३-२७", "content_sanskrit": "पद्माश्च जज्ञे राजेन्द्र सोस्यपस्य महात्मनः।\nरेणुश्च रेणुका चैव राममाता यशस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2090535, "chapter_id": 2923, "verse_number": "१३-५३-२८", "content_sanskrit": "समुनायाः समुद्भूतः सोमकेन महात्मना।\nअर्कदन्तो महानृषिः प्रथितः पृथिवीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2090536, "chapter_id": 2923, "verse_number": "१३-५३-२९", "content_sanskrit": "अग्नेराहवनीयाच्च द्रुपदस्येन्द्रवर्चसः।\nधृष्टद्युम्नश्च सम्भूतो वेद्यां कृष्णा च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2090537, "chapter_id": 2923, "verse_number": "१३-५३-३०", "content_sanskrit": "व्याघ्रयोन्यां ततो जाता वसिष्ठस्य महात्मनः।\nएकोनविंशतिः पुत्राः ख्याता व्याघ्रपदादयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2090538, "chapter_id": 2923, "verse_number": "१३-५३-३१", "content_sanskrit": "मन्धश्च बादलोमस्च जावालिश्च महानृषिः।\nमन्युश्चैवोपमन्युश्च सेतुकर्णस्तथैव च।\nएते चान्ये च विख्याताः पृथिव्यां गोत्रतां गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2090539, "chapter_id": 2923, "verse_number": "१३-५३-३२", "content_sanskrit": "विश्वकाशस्य राजर्षेरैक्ष्वाकोस्तु महात्मनः।\nबालाश्वो नाम पुत्रोऽभूच्छिखां भित्त्वा विनिस्सृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2090540, "chapter_id": 2923, "verse_number": "१३-५३-३३", "content_sanskrit": "मान्धाता चैव राजर्षिर्युवनाश्वेन धीमता।\nस्वयं धृतोऽथ गर्भेण दिव्यास्त्रबलसंयुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2090541, "chapter_id": 2923, "verse_number": "१३-५३-३४", "content_sanskrit": "गौरिकश्चापि राजर्षिश्चक्रवर्ती महायशाः।\nबाहुदायां समुत्पन्नो नद्यां राज्ञा सुबाहुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2090542, "chapter_id": 2923, "verse_number": "१३-५३-३५", "content_sanskrit": "भूमेश्च पुत्रो नरकः संवर्तश्चैव पुष्कलः।\nअद्भिश्चैव महातेजा ऋषिर्गार्ग्योऽभ्यजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2090543, "chapter_id": 2923, "verse_number": "१३-५३-३६", "content_sanskrit": "एते चान्ये च बहवो राजन्या ब्राह्मणास्तथा।\nप्रभावेनाभिसम्भूता महर्षीणां महात्मनाम्।\nनासाध्य तपसा तेषां विद्ययाऽऽत्मगुणैः परैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2090544, "chapter_id": 2923, "verse_number": "१३-५३-३७", "content_sanskrit": "अस्मिन्नर्थे च मनुना नीतः श्लोको नराधिप।\nधर्मं प्रणयता राजंस्तं निबोध युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2090545, "chapter_id": 2923, "verse_number": "१३-५३-३८", "content_sanskrit": "ऋषिणां च नदीनां च साधूनां च महात्मनाम्।\nप्रभवो नाधिगन्तव्यः स्त्रीणां दुश्चरितस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2090546, "chapter_id": 2923, "verse_number": "१३-५३-३९", "content_sanskrit": "तन्नात्र चिन्ता कर्तव्या महर्षीणां समुद्भवे।\nयथा सर्वगतो ह्यग्निस्तथा तेजो महात्मसु॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2090547, "chapter_id": 2923, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्रिपञ्चाशोऽध्यायः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]