[{"id": 2103699, "chapter_id": 3245, "verse_number": "१४-१०१-१", "content_sanskrit": "वैशम्पायन उवाच।\nश्रुत्वा यमपुराध्वानं जीवानां गमनं तथा।\nधर्मपुत्रः प्रहृष्टात्मा केशवं पुनरब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2103700, "chapter_id": 3245, "verse_number": "१४-१०१-२", "content_sanskrit": "देवदेवेश दैत्यघ्न ऋषिसङ्घैरभिष्टुत।\nभगवन्भवहञ्श्रीमन्सहस्रादित्यसन्निभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2103701, "chapter_id": 3245, "verse_number": "१४-१०१-३", "content_sanskrit": "सर्वसंभव धर्मज्ञ सर्वधरमप्रवर्तक।\nसर्वदानफलं सौम्य कथयस्व ममाच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2103702, "chapter_id": 3245, "verse_number": "१४-१०१-४", "content_sanskrit": "दानं देयं कथं कृष्ण कीदृशाय द्विजाय वै।\nकीदृशं वा तपः कृत्वा तत्फलं कुत्र भुज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2103703, "chapter_id": 3245, "verse_number": "१४-१०१-५", "content_sanskrit": "एवमुक्तो हृषीकेशो धर्मपुत्रेण धीमता।\nउवाच धर्मपुत्राय पुण्यान्धर्मान्महोदयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2103704, "chapter_id": 3245, "verse_number": "१४-१०१-६", "content_sanskrit": "शृणुष्वावहितो राजन्पूतं पापघ्नमुत्तमम्।\nसर्वदानफलं सौम्य न श्राव्यं पापकर्मणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2103705, "chapter_id": 3245, "verse_number": "१४-१०१-७", "content_sanskrit": "यच्छ्रुत्वा पुरुषः स्त्री वा नष्टपापः समाहितः।\nतत्क्षणात्पूततां याति पापकर्मरतोपि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2103706, "chapter_id": 3245, "verse_number": "१४-१०१-८", "content_sanskrit": "एकाहमपि कौन्तेय भूमावुत्पादितं जलम्।\nसप्त तारयते पूर्वान्वितृष्णा यत्र गौर्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2103707, "chapter_id": 3245, "verse_number": "१४-१०१-९", "content_sanskrit": "पानीयं परमं लोके जीवानां जीवनं स्मृतम्।\nपानीयस्य प्रदानेन तृप्तिर्भवति पाण्डव।\nपानीयस्य गुणा दिव्याः परलोके गुणावहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2103708, "chapter_id": 3245, "verse_number": "१४-१०१-१०", "content_sanskrit": "तत्र पुष्पोदकी नाम नदी परमपावनी।\nकामान्ददाति राजेन्द्र तोयदानां यमालये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2103709, "chapter_id": 3245, "verse_number": "१४-१०१-११", "content_sanskrit": "शीतलं सलिलं ह्यत्र ह्यक्षय्यममृतोपमम्।\nशीततोयप्रदादॄणां भवेन्नित्यं सुखावहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2103710, "chapter_id": 3245, "verse_number": "१४-१०१-१२", "content_sanskrit": "ये चाप्यतोयदातारः पूयस्तेषां विधीयते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2103711, "chapter_id": 3245, "verse_number": "१४-१०१-१३", "content_sanskrit": "प्रणश्यत्यंबुपानेन बुभुक्षा च युधिष्ठिर।\nतृपीषस्य न चान्नेन पिपासाऽपि प्रणश्यति।\nतस्मात्तोयं सदा देयं तृषितेभ्यो विजानता।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2103712, "chapter_id": 3245, "verse_number": "१४-१०१-१४", "content_sanskrit": "अग्नेर्मूर्तिः क्षितेर्योनिरमृतस्य स संभवः।\nअतोंभः सर्वभूतानां मूलमित्युच्यते बुधैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2103713, "chapter_id": 3245, "verse_number": "१४-१०१-१५", "content_sanskrit": "अद्भिः सर्वाणि भूतानि जीवन्ति प्रभवन्ति च।\nतस्मात्सर्वेषु दानेषु तोयदानं विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2103714, "chapter_id": 3245, "verse_number": "१४-१०१-१६", "content_sanskrit": "सर्वदानतपोयज्ञैर्यत्प्राप्यं फलमुत्तमम्।\nतत्सर्वं तोयदानेन प्राप्यते नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2103715, "chapter_id": 3245, "verse_number": "१४-१०१-१७", "content_sanskrit": "ये प्रयच्छन्ति विप्रेभ्यस्त्वन्नदातं सुसंस्कृतम्।\nतैस्तु दत्ताः स्वयं प्राणा भवन्ति भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2103716, "chapter_id": 3245, "verse_number": "१४-१०१-१८", "content_sanskrit": "अन्नाद्रक्तं च शुक्लं च अन्ने जीवः प्रतिष्ठितः।\nइन्द्रियाणि च बुद्धिश्च पुष्णन्त्यन्नेन नित्यशः।\nअन्नहीनानि सीदन्ति सर्वभूतानि पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2103717, "chapter_id": 3245, "verse_number": "१४-१०१-१९", "content_sanskrit": "तेजो बलं च रूपं च सत्वं वीर्यं धृतिर्द्युतिः।\nज्ञानं मेधा तथाऽऽयुश्च सर्वमन्ने प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2103718, "chapter_id": 3245, "verse_number": "१४-१०१-२०", "content_sanskrit": "देवमानवर्तिर्यक्षु सर्वलोकेषु सर्वदा।\nसर्वकालं हि सर्वेषां सर्वमन्ने प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2103719, "chapter_id": 3245, "verse_number": "१४-१०१-२१", "content_sanskrit": "अन्नं प्रजापते रूपमन्नं प्रजननं स्मृतम्।\nसर्वभूतमयं चान्नं जीवश्चान्नमयः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2103720, "chapter_id": 3245, "verse_number": "१४-१०१-२२", "content_sanskrit": "अन्नेनाधिष्ठितः प्राण अपानो व्यान एव च।\nउदानश्च समानश्च धारयन्ति शरीरिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2103721, "chapter_id": 3245, "verse_number": "१४-१०१-२३", "content_sanskrit": "शयनोत्थानगमनग्रहणाकर्षणानि च\nसर्वसत्वकृतं क्रम चान्नादेव प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2103722, "chapter_id": 3245, "verse_number": "१४-१०१-२४", "content_sanskrit": "चतुर्विधानि भूतानि जङ्गमानि स्थिराणि च।\nअन्नाद्भवन्ति राजेन्द्र सृष्टिरेषा प्रजापतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2103723, "chapter_id": 3245, "verse_number": "१४-१०१-२५", "content_sanskrit": "विद्यास्थानानि सर्वाणि सर्वयज्ञाश्च पावनाः।\nअन्नाद्यस्मात्प्रवर्तन्ते तस्मादन्नं परं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2103724, "chapter_id": 3245, "verse_number": "१४-१०१-२६", "content_sanskrit": "देवा रुद्रादयः सर्वे पितरोऽप्यग्नयस्तथा।\nयस्मादन्नेन तुष्यन्ति तस्मादन्नं विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2103725, "chapter_id": 3245, "verse_number": "१४-१०१-२७", "content_sanskrit": "यस्मादन्नात्प्रजाः सर्वाः कल्पेकल्पेऽसृजत्प्रभुः।\nतस्मादन्नात्परं दानं न भूतं न भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2103726, "chapter_id": 3245, "verse_number": "१४-१०१-२८", "content_sanskrit": "यस्मादन्नात्प्रवर्तन्ते धर्मार्थौ काम एव च।\nतस्मादन्नात्परं दानं नामुत्रेह च पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2103727, "chapter_id": 3245, "verse_number": "१४-१०१-२९", "content_sanskrit": "यक्षरक्षोग्रहा नागा भूतान्यन्ते च दानवाः।\nतुष्यन्त्यन्नेन यस्मात्तु तस्मादन्नं परं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2103728, "chapter_id": 3245, "verse_number": "१४-१०१-३०", "content_sanskrit": "परान्नमुपभुञ्जनो यत्कर्म कुरुते शुभम्।\nतच्छुभस्यैकभागस्तु कर्तुर्भवति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2103729, "chapter_id": 3245, "verse_number": "१४-१०१-३१", "content_sanskrit": "अन्नदस्य त्रयो भागा भन्ति पुरुषर्षभ।\nतस्यादन्नं प्रदातव्यं ब्राह्मणेभ्यो विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2103730, "chapter_id": 3245, "verse_number": "१४-१०१-३२", "content_sanskrit": "ब्राह्मणाय दरिद्राय योऽन्नं संवत्सरं नृप।\nश्रोत्रियाय प्रयच्छेद्वै पाकभेदविवर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2103731, "chapter_id": 3245, "verse_number": "१४-१०१-३३", "content_sanskrit": "डंभानृतविमुक्तस्तु परां भक्तिमुपागतः।\nस्वधर्मेणार्जितफलं तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2103732, "chapter_id": 3245, "verse_number": "१४-१०१-३४", "content_sanskrit": "शतवर्षसहस्राणि कामगः कामरूपधृत्।\nमोदतेऽमरलोकस्थः पूज्यमानोप्सरोगणैः।\nततश्चापि च्युतः कालान्नरलोके द्विजो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2103733, "chapter_id": 3245, "verse_number": "१४-१०१-३५", "content_sanskrit": "अग्नभिक्षां च यो दद्याद्दरिद्राय द्विजातये।\nषण्मासान्वार्षिकं श्राद्दं तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2103734, "chapter_id": 3245, "verse_number": "१४-१०१-३६", "content_sanskrit": "गोसहस्रप्रदानेन यत्पुण्यं समुदाहृतम्।\nतत्प्रण्यफलमाप्नोति नरो वै नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2103735, "chapter_id": 3245, "verse_number": "१४-१०१-३७", "content_sanskrit": "अथ संवत्सरं दद्यादग्रभिक्षामयाचते।\nप्रच्छद्यैव स्वयं नीत्वा तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2103736, "chapter_id": 3245, "verse_number": "१४-१०१-३८", "content_sanskrit": "कपिलानां सहस्रैस्तु यद्देयं पुण्यमुच्यते।\nतत्सर्वमखिलं प्राप्य शक्रलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2103737, "chapter_id": 3245, "verse_number": "१४-१०१-३९", "content_sanskrit": "स शक्रभवने रम्ये र्षिकोटिशतं नृप।\nयथाकामं महातेजाः क्रीडत्यप्सरसांगणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2103738, "chapter_id": 3245, "verse_number": "१४-१०१-४०", "content_sanskrit": "अन्नं च यस्तु वै दद्याद्द्विजाय नियतव्रतः।\nदशवर्षामि राजेन्द्र तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2103739, "chapter_id": 3245, "verse_number": "१४-१०१-४१", "content_sanskrit": "कपिला शतसहस्रस्य विधिदत्तस्य यत्फलम्।\nतत्पुण्यफलमासाद्य पुरन्दरपुरं व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2103740, "chapter_id": 3245, "verse_number": "१४-१०१-४२", "content_sanskrit": "स शक्रभवने रम्ये कामरूपी यथासुखम्।\nशतकोटिसमा राजन्क्रीडतेऽमरपूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2103741, "chapter_id": 3245, "verse_number": "१४-१०१-४३", "content_sanskrit": "शक्रलोकावतीर्णश्च इह लोके महाद्युतिः।\nचतुर्वेदी द्विजः श्रीमाञ्जायते राजपूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2103742, "chapter_id": 3245, "verse_number": "१४-१०१-४४", "content_sanskrit": "अध्वश्रान्ताय विप्राय क्षुधितायान्नकाङ्क्षिणे।\nदेशकालाभियाताय दीयते पाण्डुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2103743, "chapter_id": 3245, "verse_number": "१४-१०१-४५", "content_sanskrit": "याचतेऽन्नं न दद्याद्यो विद्यामाने धनागमे।\nस लुब्धो नरकं याति कृमीणां कालसूत्रकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2103744, "chapter_id": 3245, "verse_number": "१४-१०१-४६", "content_sanskrit": "तत्र नरके घोरे लोभमोहविचेतनः।\nदशरव्षसहस्राणि क्लिश्यते वेदनार्दितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2103745, "chapter_id": 3245, "verse_number": "१४-१०१-४७", "content_sanskrit": "तस्माच्च नरकान्मुक्तः कालेन महता हि सः।\nदरिद्रो मानुषे लोके चण्डालेष्वपि जायते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2103746, "chapter_id": 3245, "verse_number": "१४-१०१-४८", "content_sanskrit": "यस्तु पांसुलपादश्च दूराध्वश्रमकर्शितः।\nक्षुत्पिपासाश्रमश्रान्त आर्तः खिन्नगतिर्द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2103747, "chapter_id": 3245, "verse_number": "१४-१०१-४९", "content_sanskrit": "पृच्छन्वै ह्यन्नदातारं गृहमभ्येत्य याचयेत्।\nतं पूजयेत्तु यत्नेन सोऽतिथिः स्वर्गसंक्रमः।\nतस्मिंस्तुष्टे नरश्रेष्ठ तुष्टाः स्युः सर्वदेवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2103748, "chapter_id": 3245, "verse_number": "१४-१०१-५०", "content_sanskrit": "न तथा हविषा होमैर्न पुष्पैर्नानुलेपनैः।\nअग्नयः पार्थ तुष्यन्ति यथा ह्यतिथिपूजनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2103749, "chapter_id": 3245, "verse_number": "१४-१०१-५१", "content_sanskrit": "कपिलायां तु दत्तायां विधिवज्ज्येष्ठपुष्करे।\nन तत्फलमवाप्नोति यत्फलं विप्रबोजनान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2103750, "chapter_id": 3245, "verse_number": "१४-१०१-५२", "content_sanskrit": "द्विजपादोदकक्लिन्ना यावत्तिष्ठति मेदिनी।\nतावत्पुष्करपत्रेण पिबन्ति पितरो जलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2103751, "chapter_id": 3245, "verse_number": "१४-१०१-५३", "content_sanskrit": "देवमाल्यापनयनं द्विजोच्छिष्टापमार्जनम्।\nश्रान्तसंवाहनं चैव तथा पादावसेचनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2103752, "chapter_id": 3245, "verse_number": "१४-१०१-५४", "content_sanskrit": "प्रतिश्रयप्रदानं च तथा शय्यासनस्य च।\nएकैकं पाण्डवश्रेष्ठ गोप्रदानाद्विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2103753, "chapter_id": 3245, "verse_number": "१४-१०१-५५", "content_sanskrit": "पादोदकं पादघृतं दीपमन्नं प्रतिश्रयम्।\nये प्रयच्छन्ति विप्रेभ्यो नोपसर्पन्ति ते यमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2103754, "chapter_id": 3245, "verse_number": "१४-१०१-५६", "content_sanskrit": "विप्रातिथ्ये कृते राजन्भक्त्या शुश्रूषितेऽपि च।\nदेवाः शुश्रूषिताः सर्वे त्रयस्त्रिंशदरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2103755, "chapter_id": 3245, "verse_number": "१४-१०१-५७", "content_sanskrit": "अभ्यागतो ज्ञातपूर्वो ह्यज्ञातोऽतिथिरुच्यते।\nतयोः पूजां द्विजः कुर्यादिति पौराणिकी श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2103756, "chapter_id": 3245, "verse_number": "१४-१०१-५८", "content_sanskrit": "पादाभ्यङ्गन्नपानैस्तु योऽतिर्थिं पूजयेन्नरः।\nपूजितस्तेन राजेन्द्र भवामीह न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2103757, "chapter_id": 3245, "verse_number": "१४-१०१-५९", "content_sanskrit": "शीघ्रं पापाद्विनिर्मुक्तो मया चानुग्रहीकृतः।\nविमानेनेन्दुकल्पेन मम लोकं स गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2103758, "chapter_id": 3245, "verse_number": "१४-१०१-६०", "content_sanskrit": "अभ्यागतं श्रान्तमनुव्रजन्ति\nदेवाश्च सर्वे पितरोऽग्नयश्च।\nतस्मिन्द्विजे पूजिते पूजिताः स्यु-\nर्गते निराशाः पितरो व्रजन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2103759, "chapter_id": 3245, "verse_number": "१४-१०१-६१", "content_sanskrit": "अतिर्थिर्यस्य भग्नाशो गृहात्प्रतिनिवर्तते।\nपितरस्तस्य नाश्नन्ति दशवर्षणि पञ्च च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2103760, "chapter_id": 3245, "verse_number": "१४-१०१-६२", "content_sanskrit": "वर्जितः पितृभिर्लुब्धः स देवैरग्निभिः सह।\nनिरयं रौरवं गत्वा दशवर्षाणि पञ्च च।\nततश्चापि च्युतः कालादिह चोच्छिष्टभुग्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2103761, "chapter_id": 3245, "verse_number": "१४-१०१-६३", "content_sanskrit": "वैश्वदेवान्तिके प्राप्तमतिथिं यो न पूजयेत्।\nचण्डालत्वमवाप्नोति सद्य एव न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2103762, "chapter_id": 3245, "verse_number": "१४-१०१-६४", "content_sanskrit": "निर्वासयति यो विप्रं देशकालगतं गृहात्।\nपतितस्तत्क्षणादेव जायते नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2103763, "chapter_id": 3245, "verse_number": "१४-१०१-६५", "content_sanskrit": "नरके रौरवे घोरे वर्षकोटिं स पच्यते।\nततश्चापि च्युतः कालादिह लोके नराधमः।\nश्वा वै द्वादशजन्मानि जायते क्षुत्पिपासितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2103764, "chapter_id": 3245, "verse_number": "१४-१०१-६६", "content_sanskrit": "चण्डालोप्यतिथिः प्राप्तो देशकालेऽन्नकाङ्क्षयाः।\nअभ्युद्गम्यो गृहस्थेन पूजनीयश्च सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2103765, "chapter_id": 3245, "verse_number": "१४-१०१-६७", "content_sanskrit": "अनर्चयित्वा योऽश्नाति लोभमोहविचेतनः।\nस चण्डालत्वमापन्नो दश जन्मानि पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2103766, "chapter_id": 3245, "verse_number": "१४-१०१-६८", "content_sanskrit": "निराशमतिथिं कृत्वा भुञ्जनो यः प्रहृष्टवान्।\nन जानाति किलात्मानं विष्ठकूपे निपातितं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2103767, "chapter_id": 3245, "verse_number": "१४-१०१-६९", "content_sanskrit": "मोघं ध्रुवं प्रोर्णयति मोघमस्य तु पच्यते।\nमोघमन्नं सदाऽश्नाति योतिथिं न च पूजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2103768, "chapter_id": 3245, "verse_number": "१४-१०१-७०", "content_sanskrit": "साङ्गोपाङ्गांस्तु यो वेदान्पठतीह दिनेदिने।\nन चातिथिं पूजयति वृथा भवति स द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2103769, "chapter_id": 3245, "verse_number": "१४-१०१-७१", "content_sanskrit": "पाकयज्ञमहायज्ञैः सोमसंस्थाभिरेव च।\nये यजन्ति न चार्चन्ति गृहेष्वतिथिमागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2103770, "chapter_id": 3245, "verse_number": "१४-१०१-७२", "content_sanskrit": "तेषां यशोभिकामानां दत्तमिष्टं च यद्भवेत्।\nवृथा भवति तत्सर्वमाशया हि तया हतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2103771, "chapter_id": 3245, "verse_number": "१४-१०१-७३", "content_sanskrit": "देशं कालं च पात्रं च स्वशक्तिं च निरीक्ष्य च।\nअल्पं समं महद्वापि कुर्यादातिथ्यमात्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2103772, "chapter_id": 3245, "verse_number": "१४-१०१-७४", "content_sanskrit": "सुमुखः सुप्रसन्नात्मा धीमानतिथिमागतम्।\nस्वागतेनासनेनाद्भिरन्नाद्येन च पूजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2103773, "chapter_id": 3245, "verse_number": "१४-१०१-७५", "content_sanskrit": "हितः प्रियो वा द्वेष्यो वा मूर्खः पण्डित एव वा।\nप्राप्तो यो वैश्वदेवान्ते सोतिथिः स्वर्गसंक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2103774, "chapter_id": 3245, "verse_number": "१४-१०१-७६", "content_sanskrit": "क्षुत्पिपासाश्रमार्ताय देशकालगताय च।\nसत्कृत्यान्नं प्रदातव्यं यज्ञस्य फलमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2103775, "chapter_id": 3245, "verse_number": "१४-१०१-७७", "content_sanskrit": "भोजयेदात्मनः श्रेष्ठान्विधइवद्धव्यकव्ययोः।\nअन्नं प्राणो मनुष्यणामन्नदः प्राणदो भवेत्।\nतस्मादन्नं विशेषेण दातव्यं भूतिमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2103776, "chapter_id": 3245, "verse_number": "१४-१०१-७८", "content_sanskrit": "अन्नदः सर्वकामैस्तु सुतृप्तः सुष्ट्वलङ्कृतः।\nपूर्णचन्द्रप्रकाशेन विमानेन विराजते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2103777, "chapter_id": 3245, "verse_number": "१४-१०१-७९", "content_sanskrit": "सेव्यमानो वरस्त्रीभिर्मम लोकं स गच्छति।\nक्रीडित्वा तु ततस्तस्मिन्वर्षकोटिं यथाऽमरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2103778, "chapter_id": 3245, "verse_number": "१४-१०१-८०", "content_sanskrit": "ततस्चापि च्युतः कालादिह लोके महायशाः।\nवेदशास्त्रार्थतत्वज्ञो भोगवान्ब्राह्मणो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2103779, "chapter_id": 3245, "verse_number": "१४-१०१-८१", "content_sanskrit": "यथाश्रद्धं तु यः कुर्यान्मनुष्येषु प्रजायते।\nमहाधनपतिः श्रीमान्वेदवेदाङ्गपारगः।\nसर्वशास्त्रार्थतत्वज्ञो भोगवान्ब्राह्मणो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2103780, "chapter_id": 3245, "verse_number": "१४-१०१-८२", "content_sanskrit": "सर्वातिथ्यं तु यः कुर्याद्वर्षमेकमकल्मषः।\nधर्मार्जितधनो भूत्वा पाकभेदविवर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2103781, "chapter_id": 3245, "verse_number": "१४-१०१-८३", "content_sanskrit": "देवानिव स्वयं विप्रानर्चयित्वा पितॄनपि।\nविप्रानग्राशनाशी यस्तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2103782, "chapter_id": 3245, "verse_number": "१४-१०१-८४", "content_sanskrit": "वर्षेणैकेन यावन्ति पिण्डान्यश्नन्ति ये द्विजाः।\nतावद्वर्षाणि राजेन्द्र मम लोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2103783, "chapter_id": 3245, "verse_number": "१४-१०१-८५", "content_sanskrit": "ततश्चापि च्युतः कालादिह लोके महायशाः।\nवेदसास्त्रार्थतत्वज्ञो भोगवान्ब्राह्मणो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2103784, "chapter_id": 3245, "verse_number": "१४-१०१-८६", "content_sanskrit": "सर्वातिथ्यं तु यः कुर्याद्यथाश्रद्धं नरेश्वर।\nअकालनियमेनापि सत्यवादी जितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2103785, "chapter_id": 3245, "verse_number": "१४-१०१-८७", "content_sanskrit": "सत्यसन्धो चितक्रोधः शाखाधर्मविवर्जितः।\nअधर्मभीरुर्धर्मिष्ठो मायामात्सर्यवर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2103786, "chapter_id": 3245, "verse_number": "१४-१०१-८८", "content_sanskrit": "श्रद्दधानः सुचिर्नित्यं पाकबेदविवर्जितः।\nस विमानेन दिव्येन दिव्यरूपी महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2103787, "chapter_id": 3245, "verse_number": "१४-१०१-८९", "content_sanskrit": "पुरन्दरपुरं याति गीयमानोप्सरोगणैः।\nमन्वन्तरं तु तत्रैव क्रीडित्वा देवपूजितः।\nमानुष्यलोकमागम्य भोगवान्ब्राह्मणो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2103788, "chapter_id": 3245, "verse_number": "१४-१०१-९०", "content_sanskrit": "दशजन्मानि विप्रत्वमाप्नुयाद्राजपूजितः।\nजातिस्मरश्च भवति यत्रयत्रोपजायते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2103789, "chapter_id": 3245, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि वैष्णवधर्मपर्वणि एकाधिकशततमोऽध्यायः॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]