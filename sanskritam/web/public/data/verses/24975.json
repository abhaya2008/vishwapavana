[{"id": 7004975000, "chapter_id": 24975, "verse_number": "७-१-१५८-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि अनंगेश्वरमुत्तमम् ।\nरत्नेश्वरादग्रतःस्थं धनुषान्तरमास्थितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004975001, "chapter_id": 24975, "verse_number": "७-१-१५८-२", "content_sanskrit": "स्थापितं कामदेवेन तल्लिंगं विष्णुसूनुना ।\nज्ञात्वा तद्वैष्णवं स्थानं कलौ पातकनाशनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004975002, "chapter_id": 24975, "verse_number": "७-१-१५८-३", "content_sanskrit": "तं दृष्ट्वा पूजयित्वा तु कामदेवसमो भवेत् ।\nस्वर्गविद्याधरीणां च जायते चित्तमोहकः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004975003, "chapter_id": 24975, "verse_number": "७-१-१५८-४", "content_sanskrit": "तस्यान्वयेऽपि न भवेत्कुरूपो दुर्भगोऽपि वा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004975004, "chapter_id": 24975, "verse_number": "७-१-१५८-५", "content_sanskrit": "तत्रानंगत्रयोदश्यां व्रतेन वरवर्णिनि ।\nविशेषाराधनं तत्र जन्मसाफल्यकारणम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004975005, "chapter_id": 24975, "verse_number": "७-१-१५८-६", "content_sanskrit": "शय्यादानं तु दातव्यं तत्र विप्राय शीलिने ।\nविशेषाद्विष्णुभक्ताय सम्यग्यात्राफलं लभेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004975006, "chapter_id": 24975, "verse_number": "७-१-१५८-७", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभास खंडे प्रथमे प्रभासक्षेत्रमाहात्म्ये रत्नेश्वरमाहात्म्येऽनंगेश्वरमाहात्म्यवर्णनंनामाष्टपंचाशदुत्तरशततमोऽध्यायः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]