[{"id": 2126483, "chapter_id": 3711, "verse_number": "", "content_sanskrit": "बृहदश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2126484, "chapter_id": 3711, "verse_number": "१", "content_sanskrit": "ततस्तु याते वार्ष्णेये पुण्यश्लोकस्य दीव्यतः ।\nपुष्करेण हृतं राज्यं यच्चापि वसु किञ्चन\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2126485, "chapter_id": 3711, "verse_number": "२", "content_sanskrit": "हृतराज्यं नळं राजन् प्रहसन् पुष्करोऽब्रवीत् ।\nद्यूतं प्रवर्ततां भूयः प्रतिपाणोऽस्ति कस्तव\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2126486, "chapter_id": 3711, "verse_number": "३", "content_sanskrit": "शिष्टा ते दमयन्त्येका सर्वमन्यद् हृतं मया ।\nदमयन्त्याः पणः साधु वर्ततां यदि मन्यसे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2126487, "chapter_id": 3711, "verse_number": "४", "content_sanskrit": "पुष्करेणैवमुक्तस्य पुण्यश्लोकस्य मन्युना ।\nव्यदीर्यतेव हृदयं न चैनं किञ्चिदब्रवीत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2126488, "chapter_id": 3711, "verse_number": "५", "content_sanskrit": "ततः पुष्करमालोक्य नळः परममन्युमान् ।\nउत्तरीयं तथा वस्त्रं तस्याश्चाभरणानि च\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2126489, "chapter_id": 3711, "verse_number": "६", "content_sanskrit": "उद्धृत्य सर्वगात्रेभ्यो भूषणानि महायशाः ।\nएकवासःपरीधानो सुहृदां शोकवर्धनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2126490, "chapter_id": 3711, "verse_number": "७", "content_sanskrit": "निश्चकाम नलो राजा त्यक्त्वा तु विपुळां श्रियम् ।\nदमयन्त्येकवस्त्रा तं गच्छन्तं पृष्ठतोऽन्वगात्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2126491, "chapter_id": 3711, "verse_number": "८", "content_sanskrit": "स तया नगराभ्याशे त्रिरात्रं नैषधोऽवसत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2126492, "chapter_id": 3711, "verse_number": "९", "content_sanskrit": "पुष्करस्तु महाराज घोषयामास वै पुरे ।\nनळे यः सम्यगातिष्ठेत् स गच्छेद् वध्यतामिति\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2126493, "chapter_id": 3711, "verse_number": "१०", "content_sanskrit": "पुष्करस्य तु वाक्येन तस्य विद्वेषणेन च ।\nपौरा नास्मिन् धर्मकारं कृतवन्तो युधिष्ठिर\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2126494, "chapter_id": 3711, "verse_number": "११", "content_sanskrit": "स तदा नगराभ्याशे सत्कारार्हो न सत्कृतः ।\nत्रिरात्रमुषितो राजा जलमात्रेण वर्तयन्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2126495, "chapter_id": 3711, "verse_number": "१२", "content_sanskrit": "क्षुधया पीड्यमानस्तु नळो बहुतिथेऽहनि ।\nअपश्यच्छकुनान् कांश्चिद्धिरण्यसदृशच्छदान्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2126496, "chapter_id": 3711, "verse_number": "१३", "content_sanskrit": "स चिन्तयामास तदा निषधाधिपतिर्बली ।\nअस्ति भक्षो ममाद्यापि वसु चेदं भविष्यति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2126497, "chapter_id": 3711, "verse_number": "१४", "content_sanskrit": "ततस्तानुत्तरीयेण वाससा समवास्तृणोत् ।\nतस्योत्तरीयमादाय सर्वे जग्मुर्विहायसा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2126498, "chapter_id": 3711, "verse_number": "१५", "content_sanskrit": "उत्पतन्तः खगास्ते तु वाक्यमाहुस्तदा नळम् ।\nदृष्ट्वा दिग्वाससं भूमौ स्थितं दीनमधोमुखम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2126499, "chapter_id": 3711, "verse_number": "१६", "content_sanskrit": "वयमक्षाः सुदुर्बुद्धे तव वासो जिहीर्षवः ।\nआगता न हि नः प्रीतिः सवाससि गते त्वयि\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2126500, "chapter_id": 3711, "verse_number": "", "content_sanskrit": "बृहदश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2126501, "chapter_id": 3711, "verse_number": "१७", "content_sanskrit": "तान् समीक्ष्य गतानक्षानात्मानं च विवाससम् ।\nपुण्यश्लोकस्तदा राजा दमयन्तीमथाब्रवीत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2126502, "chapter_id": 3711, "verse_number": "१८", "content_sanskrit": "येषां प्रकोपादैश्वर्यात् प्रच्युतोऽहमनिन्दिते ।\nप्राणयात्रां न विन्दे च दुःखितः क्षुधितोऽर्दितः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2126503, "chapter_id": 3711, "verse_number": "१९", "content_sanskrit": "येषां कृते न सत्कारमकुर्वन् मम नैषधाः ।\nत इमे शकुना भूत्वा वासश्चापहरन्ति मे\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2126504, "chapter_id": 3711, "verse_number": "२०", "content_sanskrit": "वैषम्यं परमं प्राप्तो दुःखितो गतचेतनः ।\nभर्ता ते सन्निबोधेदं वचनं हितमात्मनः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2126505, "chapter_id": 3711, "verse_number": "२१", "content_sanskrit": "एते गच्छन्ति बहवः पन्थानो दक्षिणापथम् ।\nअवन्तीमृक्षवन्तं च समतिक्रम्य पर्वतम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2126506, "chapter_id": 3711, "verse_number": "२२", "content_sanskrit": "एष विन्ध्यो महाशैलः पयोष्णी च समुद्रगा ।\nआश्रमाश्च महर्षीणां बहुमूलफलान्विताः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2126507, "chapter_id": 3711, "verse_number": "२३", "content_sanskrit": "एष पन्था विदर्भाणामेष गच्छति कोसलान् ।\nततः परमदेशोऽयं दक्षिणो दक्षिणापथः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2126508, "chapter_id": 3711, "verse_number": "२४", "content_sanskrit": "ततः सा बाष्पकलया वाचा दुःखेन कर्शिता ।\nउवाच दमयन्ती तं नैषधं करुणं वचः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2126509, "chapter_id": 3711, "verse_number": "२५", "content_sanskrit": "उद्वेपते मे हृदयं सीदन्त्यङ्गानि सर्वशः ।\nतव पार्थिव सङ्कल्पं चिन्तयन्त्याः पुनःपुनः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2126510, "chapter_id": 3711, "verse_number": "२६", "content_sanskrit": "हृतराज्यं हृतद्रव्यं विवस्त्रं क्षुच्छ्रमान्वितम् ।\nकथमुत्सृज्य गच्छेयमहं त्वां विजने वने\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2126511, "chapter_id": 3711, "verse_number": "२७", "content_sanskrit": "श्रान्तस्य ते क्षुधार्तस्य चिन्तयानस्य तत्सुखम् ।\nवने घोरे महाराज शमयिष्यामि ते क्लमम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2126512, "chapter_id": 3711, "verse_number": "२८", "content_sanskrit": "नच भार्यासमं किञ्चिद् विद्यते भैषजं मतम् ।\nनित्यं हि सर्वदुःखेषु सत्यमेतद् ब्रवीमि ते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2126513, "chapter_id": 3711, "verse_number": "", "content_sanskrit": "नळः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2126514, "chapter_id": 3711, "verse_number": "२९", "content_sanskrit": "एवमेतद्यथाऽऽत्थ त्वं दमयन्ति सुमध्यमे ।\nनास्ति भार्यासमं मित्रं नरस्यार्तस्य भेषजम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2126515, "chapter_id": 3711, "verse_number": "३०", "content_sanskrit": "न चाहं त्यक्तुकामस्त्वां किमेतद् भीरु शङ्कसे ।\nत्यजेयमहमात्मानं न चैव त्वामनिन्दिते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2126516, "chapter_id": 3711, "verse_number": "", "content_sanskrit": "दमयन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2126517, "chapter_id": 3711, "verse_number": "३१", "content_sanskrit": "यदि मां त्वं महाराज न विहातुमिहेच्छसि ।\nतत्किमर्थं विदर्भाणां पन्थाः समुपदिश्यते\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2126518, "chapter_id": 3711, "verse_number": "३२", "content_sanskrit": "अवैमि चाहं नृपते नतु मां त्यक्तुमर्हसि ।\nचेतसा त्वप्रहृष्टेन मां त्यजेथा महीपते \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2126519, "chapter_id": 3711, "verse_number": "३३", "content_sanskrit": "पन्थानं हि ममाभीक्ष्णमाख्यासि नरसत्तम ।\nअतो निमित्तं शोकं मे वर्धयस्यमरप्रभ \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2126520, "chapter_id": 3711, "verse_number": "३४", "content_sanskrit": "यदि चायमभिप्रायस्तव राजन् भविष्यति ।\nसहितावेव गच्छावो विदर्भान् यदि मन्यसे\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2126521, "chapter_id": 3711, "verse_number": "३५", "content_sanskrit": "ततः स राजा त्वां दृष्ट्वा पूजयिष्यति मानद ।\nतेन त्वं पूजितो राजन् सुखं वत्स्यसि नो गृहे\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2126522, "chapter_id": 3711, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि त्रिपञ्चाशोऽध्यायः ॥५३॥\n॥ तीर्थयात्रापर्वणि नवमोऽध्यायः ॥९॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]