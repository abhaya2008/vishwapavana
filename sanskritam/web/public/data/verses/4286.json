[{"id": 2151341, "chapter_id": 4286, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2151342, "chapter_id": 4286, "verse_number": "१", "content_sanskrit": "ततो मुहूर्तात् तुमुलः शब्दो हृदयकम्पनः ।\nअश्रूयत महाराज योधानां प्रयुयुत्सताम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2151343, "chapter_id": 4286, "verse_number": "२", "content_sanskrit": "शङ्खदुन्दुभिनिर्घोषैर्वारणानां च बृंहितैः ।\nरथानां नेमिघोषैश्च दीर्यतीव वसुन्धरा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2151344, "chapter_id": 4286, "verse_number": "३", "content_sanskrit": "हयानां हेषमाणानां योधानां तत्र गर्जताम् ।\nक्षणेन खं दिशश्चैव शब्देनापूरितं तदा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2151345, "chapter_id": 4286, "verse_number": "४", "content_sanskrit": "पुत्राणां तव दुर्धर्ष पाण्डवानां तथैव च ।\nसमकम्पन्त सैन्यानि परस्परसमागमे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2151346, "chapter_id": 4286, "verse_number": "५", "content_sanskrit": "तत्र नागा रथाश्चैव जाम्बूनदविभूषिताः ।\nभ्राजमाना व्यदृश्यन्त मेघा इव सविद्युतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2151347, "chapter_id": 4286, "verse_number": "६", "content_sanskrit": "ध्वजा बहुविधाकारास्तावकानां नराधिप ।\nकाञ्चनाङ्गदिनो रेजुर्ज्वलिता इव पावकाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2151348, "chapter_id": 4286, "verse_number": "७", "content_sanskrit": "स्वेषां चैव परेषां च समदृश्यन्त भारत ।\nमहेन्द्रकेतवः शुभ्रा महेन्द्रसदनेष्विव ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2151349, "chapter_id": 4286, "verse_number": "८", "content_sanskrit": "काञ्चनैः कवचैर्वीरा ज्वलनार्कसमप्रभैः ।\nसन्नद्धाः प्रत्यदृश्यन्त ग्रहाः प्रज्वलिता इव ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2151350, "chapter_id": 4286, "verse_number": "९", "content_sanskrit": "उद्यतैरायुधैश्चित्रैस्तलबद्धाः पताकिनः ।\nऋषभाक्षा महेष्वासाश्चमूमुखगता बभुः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2151351, "chapter_id": 4286, "verse_number": "१०", "content_sanskrit": "पृष्ठगोपास्तु भीष्मस्य पुत्रास्तव नराधिप ।\nदुःशासनो दुर्विषहो दुर्मुखो दुःसहस्तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2151352, "chapter_id": 4286, "verse_number": "११", "content_sanskrit": "विविंशतिश्चित्रसेनो विकर्णश्च महारथः ।\nसत्यव्रतः पुरुमित्रो जयो भूरिश्रवाः शलः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2151353, "chapter_id": 4286, "verse_number": "१२", "content_sanskrit": "रथा विंशतिसाहस्रास्तथैषामनुयायिनः ।\nअभीषाहाः शूरसेनाः शिबयोऽथ वसातयः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2151354, "chapter_id": 4286, "verse_number": "१३", "content_sanskrit": "शाल्वा मत्स्यास्तथाम्बष्ठास्त्रिगर्ताः केकयास्तथा ।\nसौवीराः कितवाः प्राच्याः प्रतीच्योदीच्यमालवाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2151355, "chapter_id": 4286, "verse_number": "१४", "content_sanskrit": "द्वादशैते जनपदाः सर्वे शूरास्तनुत्यजः ।\nमहता रथवंशेन तेऽभ्यरक्षन् पितामहम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2151356, "chapter_id": 4286, "verse_number": "१५", "content_sanskrit": "अनीकं दशसाहस्रं कुञ्जराणां तरस्विनाम् ।\nमागधो येन नृपतिस्तद् रथानीकमन्वयात् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2151357, "chapter_id": 4286, "verse_number": "१६", "content_sanskrit": "रथानां चक्ररक्षाश्च पादरक्षाश्च दन्तिनाम् ।\nअभूवन् वाहिनीमध्ये शतानामयुतानि षट् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2151358, "chapter_id": 4286, "verse_number": "१७", "content_sanskrit": "पादाताश्चाग्रतोऽगच्छन् धनुश्चर्मासिपाणयः ।\nअनेकशतसाहस्रा नखरप्रासयोधिनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2151359, "chapter_id": 4286, "verse_number": "१८", "content_sanskrit": "अक्षोहिण्यो दशैका च तव पुत्रस्य भारत ।\nअदृश्यन्त महाराज गङ्गेव यमुनान्तरे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2151360, "chapter_id": 4286, "verse_number": "१८", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां भीष्मपर्वणि अष्टादशोऽध्यायः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2151361, "chapter_id": 4286, "verse_number": "५", "content_sanskrit": "॥ भगवद्गीतापर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]