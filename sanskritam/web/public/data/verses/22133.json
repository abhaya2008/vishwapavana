[{"id": 7002133000, "chapter_id": 22133, "verse_number": "१७८-१", "content_sanskrit": "तृतीयाव्रतानि ।\nअग्निरुवाच ।\nतृतीयाव्रतान्याख्यास्ये भुक्तिमुक्तिप्रदानि ते ।\nललितायां तृतीयायां मूलगौरीव्रतं शृणु ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002133001, "chapter_id": 22133, "verse_number": "१७८-२", "content_sanskrit": "तृतीयायां चैत्रशुक्ले ऊढा गौरी हरेण हि ।\nतिलस्नातोऽर्चयेच्छम्भुं गौर्या हैमफलादिभिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002133002, "chapter_id": 22133, "verse_number": "१७८-३", "content_sanskrit": "नमोऽस्तु पाटलायैव पादौ देव्याः शिवस्य च ।\nशिवायेति च सङ्कीर्त्य जयायै गुल्फयोर्यजेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002133003, "chapter_id": 22133, "verse_number": "१७८-४", "content_sanskrit": "त्रिपुरघ्नाय रुद्राय भान्यै जङ्घयोर्द्वयोः ।\nशिवं रुद्रायेश्वराय विजयायैव जानुनी ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002133004, "chapter_id": 22133, "verse_number": "१७८-५", "content_sanskrit": "ईशायेति कटिं देव्याः शङ्करायेति शङ्करम् ।\nकुक्षिद्वयञ्च कोटव्यै शूलिनं शूलपाणये ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002133005, "chapter_id": 22133, "verse_number": "१७८-६", "content_sanskrit": "मङ्गलायै नमस्तुभ्यमुदरञ्चाभिपूजयेत् ।\nसर्वात्मने नमो रुद्रमैशान्यै च कुचद्वयं ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002133006, "chapter_id": 22133, "verse_number": "१७८-७", "content_sanskrit": "शिवं देवात्मने तद्वथ्रादिन्यै कण्ठमर्चयेत् ।\nमहादेवाय च शिवमनन्तायै करद्वयं ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002133007, "chapter_id": 22133, "verse_number": "१७८-८", "content_sanskrit": "त्रिलोचनायेति हरं बाहुं कालानलप्रिये ।\nसौभाग्यायै महेशाय भूषणानि प्रपूजयेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002133008, "chapter_id": 22133, "verse_number": "१७८-९", "content_sanskrit": "अशोकमधुवासिन्यै ईश्वरायेति चौष्ठकौ ।\nचतुर्मुखप्रिया चास्यं हराय स्थाणवे नमः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002133009, "chapter_id": 22133, "verse_number": "१७८-१०", "content_sanskrit": "नमोऽर्धनारीशहरममिताङ्ग्यै च नासिकां ।\nनम उग्राय लोकेशं ललितेति पुनर्भ्रुवौ ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002133010, "chapter_id": 22133, "verse_number": "१७८-११", "content_sanskrit": "सर्वाय पुरहन्तारं वासन्त्यै चैव तालुकं ।\nनमः श्रीकण्ठनाथायै शितिकण्ठाय केशकं ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002133011, "chapter_id": 22133, "verse_number": "१७८-१२", "content_sanskrit": "भीमोग्राय सुपूपिण्यै शिरः सर्वात्मने नमः ।\nमल्लिकाशोककमलकुन्दन्तगरमालती ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002133012, "chapter_id": 22133, "verse_number": "१७८-१३", "content_sanskrit": "कदम्बकरवीरञ्च वाणमम्लानकुङ्कुमं ।\nसिन्धुवारञ्च मासेषु सर्वेषु क्रमशः स्मृतं ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002133013, "chapter_id": 22133, "verse_number": "१७८-१४", "content_sanskrit": "उमामहेश्वरौ पूज्य सौभाग्याष्टकमग्रतः ।\nस्थापयेद् घृतनिष्पावकुसुम्भक्षीरजीवकं ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002133014, "chapter_id": 22133, "verse_number": "१७८-१५", "content_sanskrit": "तरुराजेक्षुलवणं कुस्तुम्बुरुमथाष्टमं ।\nचैत्रे शृगोदकं प्राश्य देवदेव्यग्रतः स्वपेत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002133015, "chapter_id": 22133, "verse_number": "१७८-१६", "content_sanskrit": "प्रातः स्नात्वा समभ्यर्च्य विप्रदाम्पत्यमर्चयेत् ।\nतदष्टकं द्विजे दद्याल्ललिता प्रीयतां मम ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002133016, "chapter_id": 22133, "verse_number": "१७८-१७", "content_sanskrit": "शृङ्गोदकं गोमयं च मन्दारं बिल्वपत्रकं ।\nकुशोदकं दधि क्षीरं कार्त्तिके पृषदाज्यकम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002133017, "chapter_id": 22133, "verse_number": "१७८-१८", "content_sanskrit": "गोमूत्राज्यं कृष्णतिलं पञ्चगव्यं क्रमाशनं ।\nललिता विजया भद्रा भवानी कुमुदा शिवा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002133018, "chapter_id": 22133, "verse_number": "१७८-१९", "content_sanskrit": "वासुदेवी तथा गौरी मङ्गला कमला सती ।\nचैत्रादौ दानकाले च प्रीयतामिति वाचयेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002133019, "chapter_id": 22133, "verse_number": "१७८-२०", "content_sanskrit": "फलमेकं पवित्राज्यं व्रतान्ते शयानं ददेत् ।\nउमामहेश्वरं हैमं वृषभञ्च गवा सह ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002133020, "chapter_id": 22133, "verse_number": "१७८-२१", "content_sanskrit": "गुरुञ्च मिथुनान्यर्च्य वस्त्राद्यैर्भुक्तिमुक्तिभाक् ।\nसौभाग्यारोग्यरूपायुः सौभाग्यशयनव्रतान् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002133021, "chapter_id": 22133, "verse_number": "१७८-२२", "content_sanskrit": "नभस्ये वाथ वैशाखे कुर्यान्मार्गशिरस्यथ ।\nशुक्लपक्षे तृतीयायां ललितायै नमो यजेत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002133022, "chapter_id": 22133, "verse_number": "१७८-२३", "content_sanskrit": "प्रतिपक्षं ततः प्रार्च्य व्रतान्ते मित्युनानि च ।\nचतुर्विंशतिमभ्यर्च्य वस्त्राद्यैर्भुक्तिमुक्तिभाक् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002133023, "chapter_id": 22133, "verse_number": "१७८-२४", "content_sanskrit": "उक्तो मार्गो द्वितीयोऽयं सौभाग्यव्रतमावदे ।\nफाल्गुणादितृतीयायां लवणं यस्तु वर्जयेत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002133024, "chapter_id": 22133, "verse_number": "१७८-२५", "content_sanskrit": "समाप्ते शयनन्दद्याद्गृहश्चोपस्करान्वितं ।\nसम्पूज्य विप्रमिथुनं भवानी प्रीयतामिति ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002133025, "chapter_id": 22133, "verse_number": "१७८-२६", "content_sanskrit": "सौभाग्यार्थं तृतीयोक्ता गौरीलोकादिदायिनी ।\nमाघे भाद्रे च वैशाखे तृतीयाव्रतकृत्तथा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002133026, "chapter_id": 22133, "verse_number": "१७८-२७", "content_sanskrit": "दमनकतृतीयाकृत्चैत्रे दमनकैर्यजेत् ।\nआत्मतृतीया मार्गस्य प्रार्च्येच्छाभोजनादिना ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002133027, "chapter_id": 22133, "verse_number": "१७८-२८", "content_sanskrit": "गौरी काली उमा भद्रा दुर्गा कान्तिः सरस्वती ।\nवैष्णवी लक्ष्मीः प्रकृतिः शिवा नारायणी क्रमात् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002133028, "chapter_id": 22133, "verse_number": "१७८-२९", "content_sanskrit": "मार्गतृतीयामारभ्य सौभाग्यं स्वर्गमाप्नुयात् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]