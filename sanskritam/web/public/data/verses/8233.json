[{"id": 900001416, "chapter_id": 8233, "verse_number": "7.1", "content_sanskrit": "पुरुषे ह वा अयमादितो गर्भो भवति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001417, "chapter_id": 8233, "verse_number": "7.2", "content_sanskrit": "सोऽस्यायमात्मा पुण्येभ्यः कर्मभ्यः प्रतिधीयते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001418, "chapter_id": 8233, "verse_number": "7.3", "content_sanskrit": "नात्र जीवोत्पत्तिमात्रमुच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001419, "chapter_id": 8233, "verse_number": "7.4", "content_sanskrit": "आत्मन्येवात्मानं बिभर्ति आत्मानमेव तद्भावयति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001420, "chapter_id": 8233, "verse_number": "7.5", "content_sanskrit": "कृष्णो ह्यत्यक्तदेहोऽपि त्यक्तदेहवदेव च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001421, "chapter_id": 8233, "verse_number": "7.6", "content_sanskrit": "'एषामवेदमह' मित्यत्रापि जीवभेद एवोक्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900001422, "chapter_id": 8233, "verse_number": "7.7", "content_sanskrit": "न च मूढव्यवहार एव वेदनिर्णयाय भवति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900001423, "chapter_id": 8233, "verse_number": "7.8", "content_sanskrit": "भावयति सम्भावयति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900001424, "chapter_id": 8233, "verse_number": "7.9", "content_sanskrit": "ता एव देवताः शतं पुर आयासीर्ज्ञानिन्यो विशेषतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900001425, "chapter_id": 8233, "verse_number": "7.10", "content_sanskrit": "स्वरानन्दो विष्णुरत्रग इति स्वर्गलोको विष्णुलोकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]