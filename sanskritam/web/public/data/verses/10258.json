[{"id": 6000258000, "chapter_id": 10258, "verse_number": null, "content_sanskrit": "अथ द्विषष्टितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000258001, "chapter_id": 10258, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.001.m4a", "display_order": 2}, {"id": 6000258002, "chapter_id": 10258, "verse_number": "१०-६२-१", "content_sanskrit": "एकदा पाण्डवान् द्रष्टुं प्रतीतान् पुरुषोत्तमः।\nइन्द्रप्रस्थं गतः श्रीमान् युयुधानादिभिर्वृतः॥ १०/६२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.002.m4a", "display_order": 3, "topics": [{"text": "कृष्णपाण्डवसंवादः, वर्षाकाले इन्द्रप्रस्थे श्रीकृष्णस्य वासः", "range": "१–१८"}]}, {"id": 6000258003, "chapter_id": 10258, "verse_number": "१०-६२-२", "content_sanskrit": "दृष्ट्वा तमागतं पार्था मुकुन्दमखिलेश्वरम्।\nउत्तस्थुर्युगपद् प्राणाः प्राणं मुख्यमिवागतम्॥ १०/६२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.003.m4a", "display_order": 4}, {"id": 6000258004, "chapter_id": 10258, "verse_number": "१०-६२-३", "content_sanskrit": "परिष्वज्याच्युतं वीरा अङ्गसङ्गहतैनसः।\nसानुरागस्मितं वक्त्रं वीक्ष्य तस्य मुदं ययुः॥ १०/६२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.004.m4a", "display_order": 5}, {"id": 6000258005, "chapter_id": 10258, "verse_number": "१०-६२-४", "content_sanskrit": "युधिष्ठिरस्य भीमस्य कृत्वा पादाभिवन्दनम्।\nफाल्गुनं परिरभ्याथ यमाभ्यामभिवन्दितः॥ १०/६२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.005.m4a", "display_order": 6}, {"id": 6000258006, "chapter_id": 10258, "verse_number": "१०-६२-५", "content_sanskrit": "परमासन आसीनं कृष्णा कृष्णमनिन्दिता।\nनवोढा व्रीडिता किञ्चिच्छनैरेत्याभ्यवन्दत॥ १०/६२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.006.m4a", "display_order": 7}, {"id": 6000258007, "chapter_id": 10258, "verse_number": "१०-६२-६", "content_sanskrit": "तथैव सात्यकिः पार्थैः पूजितश्चाभिवन्दितः।\nनिषसादासनेऽन्ये च पूजिताः पर्युपासते॥ १०/६२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.007.m4a", "display_order": 8}, {"id": 6000258008, "chapter_id": 10258, "verse_number": "१०-६२-७", "content_sanskrit": "पृथां समागम्य कृताभिवन्दनस्तयाऽतिहार्दार्द्रदृशाऽभिरम्भितः।\nआपृष्टवांस्तत्कुशलं सहस्नुषां पितृष्वसारं परिपृष्टबान्धवः॥ १०/६२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.008.m4a", "display_order": 9}, {"id": 6000258009, "chapter_id": 10258, "verse_number": "१०-६२-८", "content_sanskrit": "तमाह प्रेमवैक्लव्यरुद्धकण्ठाश्रुलोचना।\nस्मरन्ती तान् बहून् क्लेशान् क्लेशापायात्मदर्शनम्॥ १०/६२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.009.m4a", "display_order": 10}, {"id": 6000258010, "chapter_id": 10258, "verse_number": "१०-६२-९", "content_sanskrit": "तदैव कुशलं नोऽभूत् यत् सनाथाः कृता वयम्।\nज्ञातुं नः स्मरतां कृष्ण भ्राता मे प्रेषितस्त्वया॥ १०/६२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.010.m4a", "display_order": 11}, {"id": 6000258011, "chapter_id": 10258, "verse_number": "१०-६२-१०", "content_sanskrit": "पाञ्चालेषु स्थितानस्मान् स्वयंवरकृते यदा।\nअनुस्मृत्यागतो यस्त्वं तेन स्मासं सुखोषिता॥ १०/६२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.011.m4a", "display_order": 12}, {"id": 6000258012, "chapter_id": 10258, "verse_number": "१०-६२-११", "content_sanskrit": "इत्युक्तायां तदा कुन्त्यां प्राह योगेश्वरः स्वयम्।\nपाञ्चालेषु स्थितानेत्य सुतांस्ते छद्मरूपिणः॥ १०/६२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.012.m4a", "display_order": 13}, {"id": 6000258013, "chapter_id": 10258, "verse_number": "१०-६२-१२", "content_sanskrit": "कुम्भकारस्य शालायामुषितान् सह भार्यया।\nदृष्ट्वाऽगतोऽहं दिवसे तस्मिन्नेवाविलम्बितः॥ १०/६२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.013.m4a", "display_order": 14}, {"id": 6000258014, "chapter_id": 10258, "verse_number": "१०-६२-१३", "content_sanskrit": "निहन्तंु शतधन्वानं सत्यभामापितुर्द्रुहम्।\nशतधन्वनि दुर्बुद्धौ हते सीरधरोऽग्रजः॥ १०/६२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.014.m4a", "display_order": 15}, {"id": 6000258015, "chapter_id": 10258, "verse_number": "१०-६२-१४", "content_sanskrit": "कुपितो मामनादृत्य विदेहान् विमना ययौ।\nएतावन्तमहं कालं तदागमनकाङ्क्षया॥ १०/६२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.015.m4a", "display_order": 16}, {"id": 6000258016, "chapter_id": 10258, "verse_number": "१०-६२-१५", "content_sanskrit": "पुर एवावसं क्‍वापि नागच्छं कार्ययन्त्रितः।\nइत्येवंवादिनं कुन्ती प्राह स्नेहपरिप्लुता॥ १०/६२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.016.m4a", "display_order": 17}, {"id": 6000258017, "chapter_id": 10258, "verse_number": "१०-६२-१६", "content_sanskrit": "न तेऽस्ति स्वः पर इति विश्वस्य सुहृदात्मनः।\nतथापि स्मरतां सर्वान् क्लेशान् हंसि हृदि स्थितः॥ १०/६२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.017.m4a", "display_order": 18}, {"id": 6000258018, "chapter_id": 10258, "verse_number": "१०-६२-१७", "content_sanskrit": "इति वै वार्षिकान् मासान् राज्ञा सोऽभ्यर्चितः सुखम्।\nजनयन् नयनानन्दमिन्द्रप्रस्थौकसां विभुः॥ १०/६२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.018.m4a", "display_order": 19}, {"id": 6000258019, "chapter_id": 10258, "verse_number": "१०-६२-१८", "content_sanskrit": "एकदा रथमारुह्य विजयो वानरध्वजम्।\nगाण्डीवं धनुरादाय तूणी चाक्षयसायकौ॥ १०/६२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.019.m4a", "display_order": 20}, {"id": 6000258020, "chapter_id": 10258, "verse_number": "१०-६२-१९", "content_sanskrit": "साकं कृष्णेन सन्नद्धो विहर्तुं विपिनं वनम्।\nबहुव्यालमृगाकीर्णं प्राविशत् परवीरहा॥ १०/६२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.020.m4a", "display_order": 21, "topics": [{"text": "कृष्णकालिन्दीविवाहः", "range": "१९–३२"}]}, {"id": 6000258021, "chapter_id": 10258, "verse_number": "१०-६२-२०", "content_sanskrit": "तत्राविध्यच्छरैर्व्याघ्रान् सूकरान् महिषान् रुरून्।\nशरभान् गवयान् खड्गान् हरिणान् शशशल्यकान्॥ १०/६२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.021.m4a", "display_order": 22}, {"id": 6000258022, "chapter_id": 10258, "verse_number": "१०-६२-२१", "content_sanskrit": "तान् निन्युः किङ्करा राज्ञे मेध्यान् पर्वण्युपागते।\nतृट्परीतः परिश्रान्तो बीभत्सुर्यमुनामगात्॥ १०/६२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.022.m4a", "display_order": 23}, {"id": 6000258023, "chapter_id": 10258, "verse_number": "१०-६२-२२", "content_sanskrit": "तत्रोपस्पृश्य विशदं पीत्वा वारि महारथौ।\nकृष्णौ ददृशतुः कन्यां चरन्तीं चारुदर्शनाम्॥ १०/६२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.023.m4a", "display_order": 24}, {"id": 6000258024, "chapter_id": 10258, "verse_number": "१०-६२-२३", "content_sanskrit": "तामासाद्य वरारोहां सुदतीं रुचिराननाम्।\nपप्रच्छ प्रेषितः सख्या फल्गुनः प्रमदोत्तमाम्॥ १०/६२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.024.m4a", "display_order": 25}, {"id": 6000258025, "chapter_id": 10258, "verse_number": "१०-६२-२४", "content_sanskrit": "का त्वं कस्यासि सुश्रोणि कुतो वा किं चिकीर्षसि।\nमन्ये त्वां पतिमिच्छन्तीं कन्यां कथय शोभने॥ १०/६२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.025.m4a", "display_order": 26}, {"id": 6000258026, "chapter_id": 10258, "verse_number": null, "content_sanskrit": "कालिन्द्युवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.026.m4a", "display_order": 27}, {"id": 6000258027, "chapter_id": 10258, "verse_number": "१०-६२-२५", "content_sanskrit": "अहं देवस्य सवितुर्दुहिता पतिमिच्छती।\nविष्णुं वरेण्यं वरदं तपः परममास्थिता॥ १०/६२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.027.m4a", "display_order": 28}, {"id": 6000258028, "chapter_id": 10258, "verse_number": "१०-६२-२६", "content_sanskrit": "नान्यं पतिं वृणे वीर तमृते श्रीनिकेतनम्।\nतुष्यतां मे स भगवान् मुकुन्दोऽनाथवत्सलः॥ १०/६२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.028.m4a", "display_order": 29}, {"id": 6000258029, "chapter_id": 10258, "verse_number": "१०-६२-२७", "content_sanskrit": "कालिन्दीति समाख्याता वसामि यमुनाजले।\nनिर्मिते भवने पित्रा यावदच्युतदर्शनम्॥ १०/६२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.029.m4a", "display_order": 30}, {"id": 6000258030, "chapter_id": 10258, "verse_number": "१०-६२-२८", "content_sanskrit": "तथाऽवदद् गुडाकेशो वासुदेवाय सोऽपि ताम्।\nरथमारोप्य तद्विद्वान् धर्मराजमुपागमत्॥ १०/६२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.030.m4a", "display_order": 31}, {"id": 6000258031, "chapter_id": 10258, "verse_number": "१०-६२-२९", "content_sanskrit": "वसंस्तत्र हृषीकेशः शक्रप्रस्थे यथासुखम्।\nविश्वकर्माणमाहूय शिल्पविद्याविशारदम्॥ १०/६२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.031.m4a", "display_order": 32}, {"id": 6000258032, "chapter_id": 10258, "verse_number": "१०-६२-३०", "content_sanskrit": "अद्भुतं कारयामास नगरं धर्मसूनवे।\nसप्रासादपुरद्वारगोपुराट्टालतोरणम्॥ १०/६२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.032.m4a", "display_order": 33}, {"id": 6000258033, "chapter_id": 10258, "verse_number": "१०-६२-३१", "content_sanskrit": "पुरन्दरपुरप्रख्यं स्वानां प्रियचिकीर्षया।\nअथ पार्थैरनुज्ञातः सुहृद्भिः स्वजनान्वितः॥ १०/६२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.033.m4a", "display_order": 34}, {"id": 6000258034, "chapter_id": 10258, "verse_number": "१०-६२-३२", "content_sanskrit": "आययौ द्वारकां भूयः सात्यकिप्रमुखैर्वृतः।\nअथोपयेमे कालिन्दीं पुण्ये नक्षत्र ऊर्जिते॥ १०/६२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.034.m4a", "display_order": 35}, {"id": 6000258035, "chapter_id": 10258, "verse_number": "१०-६२-३३", "content_sanskrit": "रूपयौवनसम्पन्नां मनोनयननन्दिनीम्।\nवितन्वन् परमानन्दं स्वानां परममङ्गलम्॥ १०/६२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.035.m4a", "display_order": 36}, {"id": 6000258036, "chapter_id": 10258, "verse_number": "१०-६२-३४", "content_sanskrit": "विन्दानुविन्दावावन्त्यौ दुर्योधनवशानुगौ।\nस्वयंवरे स्वभगिनीं कृष्णकामां न्यषेधताम्॥ १०/६२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.036.m4a", "display_order": 37, "topics": [{"text": "मित्रविन्दाविवाहः", "range": "३४–३५"}]}, {"id": 6000258037, "chapter_id": 10258, "verse_number": "१०-६२-३५", "content_sanskrit": "राजाधिदेव्यास्तनयां मित्रविन्दां पितृष्वसुः।\nप्रसह्य हृतवान् कृष्णो राजन् राज्ञां प्रपश्यताम्॥ १०/६२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.037.m4a", "display_order": 38}, {"id": 6000258038, "chapter_id": 10258, "verse_number": "१०-६२-३६", "content_sanskrit": "नग्नजिन्नाम कौसल्य आसीद् राजाऽतिधार्मिकः।\nतस्य सत्याऽभवत् कन्या राजन् नीलेति चाह्वया॥ १०/६२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.038.m4a", "display_order": 39, "topics": [{"text": "नीलास्वयंवरः", "range": "३६–५३"}]}, {"id": 6000258039, "chapter_id": 10258, "verse_number": "१०-६२-३७", "content_sanskrit": "तां न शेकुर्नृपा वोढुमजित्वा सप्तगोवृषान्।\nतीक्ष्णशृृङ्गान् सुदुर्धर्षान् वीरगन्धान् महाघनान्॥ १०/६२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.039.m4a", "display_order": 40}, {"id": 6000258040, "chapter_id": 10258, "verse_number": "१०-६२-३८", "content_sanskrit": "तां श्रुत्वा वृषजिल्लभ्यां भगवान् सात्त्वतां पतिः।\nजगाम कौसल्यपुरं सैन्येन महता वृतः॥ १०/६२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.040.m4a", "display_order": 41}, {"id": 6000258041, "chapter_id": 10258, "verse_number": "१०-६२-३९", "content_sanskrit": "स कौसलपतिः प्रीतः प्रत्युत्थानासनादिभिः।\nअर्हणेनापि गुरुणा पूजयन् प्रत्यनन्दत॥ १०/६२/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.041.m4a", "display_order": 42}, {"id": 6000258042, "chapter_id": 10258, "verse_number": "१०-६२-४०", "content_sanskrit": "वरं विलोक्याभिमतं समागतं नरेन्द्रकन्या चकमे रमापतिम्।\nभूयादयं मे पतिराशिषां पतिः करोतु सत्यो यदि मे धृतव्रतः॥ १०/६२/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.042.m4a", "display_order": 43}, {"id": 6000258043, "chapter_id": 10258, "verse_number": "१०-६२-४१", "content_sanskrit": "अर्चितं पुनरित्याह नारायण जगत्पते।\nआत्मना देव पूर्णस्य करवाणि किमल्पकः॥ १०/६२/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.043.m4a", "display_order": 44}, {"id": 6000258044, "chapter_id": 10258, "verse_number": "१०-६२-४२", "content_sanskrit": "यत्पादपङ्कजरजः शिरसा बिभर्ति श्रीरब्जजश्च गिरिशः सहलोकपालैः।\nलीलातनुः स्वकृतसेतुपरीप्सया यः काले दधत् स भगवान् स्वकृतेन तुष्येत्॥ १०/६२/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.044.m4a", "display_order": 45}, {"id": 6000258045, "chapter_id": 10258, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.045.m4a", "display_order": 46}, {"id": 6000258046, "chapter_id": 10258, "verse_number": "१०-६२-४३", "content_sanskrit": "तमाह भगवान् कृष्णः कृतासनपरिग्रहः।\nमेघगम्भीरया वाचा सस्मितं कुरुनन्दन॥ १०/६२/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.046.m4a", "display_order": 47}, {"id": 6000258047, "chapter_id": 10258, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.047.m4a", "display_order": 48}, {"id": 6000258048, "chapter_id": 10258, "verse_number": "१०-६२-४४", "content_sanskrit": "अन्यत्र काले विदुषः स्वयंवराद्ध्ययाचितारं वरमाहुरुत्तमम्।\nस हि प्रभूणां पुरुषार्थभागिनां वेलां विनाऽह्वाययति क्षितीश्वर॥ १०/६२/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.048.m4a", "display_order": 49}, {"id": 6000258049, "chapter_id": 10258, "verse_number": "१०-६२-४५", "content_sanskrit": "नरेन्द्र याञ्चा कविभिर्विगर्हिता राजन्यबन्धोर्निजधर्मवर्तिनः।\nतथापि याचे तव सौहृदेच्छया कन्यां त्वदीयां न हि शुल्कदा वयम्॥ १०/६२/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.049.m4a", "display_order": 50}, {"id": 6000258050, "chapter_id": 10258, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.050.m4a", "display_order": 51}, {"id": 6000258051, "chapter_id": 10258, "verse_number": "१०-६२-४६", "content_sanskrit": "कोऽन्यस्तेऽभ्यधिको नाथ कन्यावर इहेप्सितः।\nगुणैकधाम्नो यस्याङ्गे श्रीर्वसत्यनपयिनी॥ १०/६२/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.051.m4a", "display_order": 52}, {"id": 6000258052, "chapter_id": 10258, "verse_number": "१०-६२-४७", "content_sanskrit": "किन्त्वस्माभिः कृतः पूर्वं समयः सात्त्वतर्षभ।\nपुंसां वीर्यपरीक्षार्थं कन्यावरपरीप्सया॥ १०/६२/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.052.m4a", "display_order": 53}, {"id": 6000258053, "chapter_id": 10258, "verse_number": "१०-६२-४८", "content_sanskrit": "सप्तैते गोवृषा वीर दुर्दान्ता दुरवग्रहाः।\nएतैर्भग्नाः सुबहुशो भिन्नगात्रा नृपात्मजाः॥ १०/६२/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.053.m4a", "display_order": 54}, {"id": 6000258054, "chapter_id": 10258, "verse_number": "१०-६२-४९", "content_sanskrit": "यदीमे निगृहीताः स्युस्त्वयैव यदुनन्दन।\nवरो भवानभिमतो दुहितुर्मे श्रियः पते॥ १०/६२/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.054.m4a", "display_order": 55}, {"id": 6000258055, "chapter_id": 10258, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.055.m4a", "display_order": 56}, {"id": 6000258056, "chapter_id": 10258, "verse_number": "१०-६२-५०", "content_sanskrit": "एवं समयमाकर्ण्य बद्ध्‍वा परिकरं प्रभुः।\nआत्मानं सप्तधा कृत्वा न्यगृह्णाल्लीलयैव तान्॥ १०/६२/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.056.m4a", "display_order": 57}, {"id": 6000258057, "chapter_id": 10258, "verse_number": "१०-६२-५१", "content_sanskrit": "बद्ध्वा तान् दामभिः शौरिर्भग्नवीर्यान् हतौजसः।\nव्यकर्षल्लीलया बद्धान् बालो दारुमयान् यथा॥ १०/६२/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.057.m4a", "display_order": 58}, {"id": 6000258058, "chapter_id": 10258, "verse_number": "१०-६२-५२", "content_sanskrit": "ततः प्रीतः सुतां राजन् ददौ कृष्णाय विस्मितः।\nतां प्रत्यगृह्णात् भगवान् विधिवत् सदृशीं प्रभुः॥ १०/६२/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.058.m4a", "display_order": 59}, {"id": 6000258059, "chapter_id": 10258, "verse_number": "१०-६२-५३", "content_sanskrit": "राजपत्न्यः स्वदुहितुः कृष्णं लब्ध्वा प्रियं पतिम्।\nलेभिरे परमानन्दं जातश्च परमोत्सवः॥ १०/६२/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.059.m4a", "display_order": 60}, {"id": 6000258060, "chapter_id": 10258, "verse_number": "१०-६२-५४", "content_sanskrit": "शङ्खभेर्यानका नेदुर्गीतवाद्यद्विजाशिषः।\nनरा नार्यः प्रमुदिताः सुवासःस्रगलङ्कृताः॥ १०/६२/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.060.m4a", "display_order": 61}, {"id": 6000258061, "chapter_id": 10258, "verse_number": "१०-६२-५५", "content_sanskrit": "दशधेनुसहस्राणि पारिबर्हमदाद् विभुः।\nयुवतीनां त्रिसाहस्रं निष्कग्रीवसुवाससाम्॥ १०/६२/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.061.m4a", "display_order": 62}, {"id": 6000258062, "chapter_id": 10258, "verse_number": "१०-६२-५६", "content_sanskrit": "नवनागसहस्राणि नागाच्छतगुणान् रथान्।\nरथाच्छतगुणानश्वानश्वाच्छतगुणान् नरान्॥ १०/६२/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.062.m4a", "display_order": 63}, {"id": 6000258063, "chapter_id": 10258, "verse_number": "१०-६२-५७", "content_sanskrit": "दम्पती रथमारोप्य महत्या सेनया वृतौ।\nस्नेहप्रक्लिन्नहृदयो यापयामास कौसलः॥ १०/६२/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.063.m4a", "display_order": 64}, {"id": 6000258064, "chapter_id": 10258, "verse_number": "१०-६२-५८", "content_sanskrit": "पारिबर्हं च सङ्गृह्य द्वारकामेत्य सत्यया।\nरेमे यदूनामृषभो भगवान् देवकीसुतः॥ १०/६२/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.064.m4a", "display_order": 65}, {"id": 6000258065, "chapter_id": 10258, "verse_number": "१०-६२-५९", "content_sanskrit": "श्रुतकीर्तेः सुतां भद्रामुपयेमे पितृष्वसुः।\nकैकेयीं भ्रातृभिर्दत्तां कृष्णः सन्तर्दनादिभिः॥ १०/६२/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.065.m4a", "display_order": 66, "topics": [{"text": "भद्राविवाहः", "range": "५९"}]}, {"id": 6000258066, "chapter_id": 10258, "verse_number": "१०-६२-६०", "content_sanskrit": "सुतां च मद्राधिपतेर्लक्षणां लक्षणैर्युताम्।\nस्वयंवरे जहारैकः ससुपर्णः सुधामिव॥ १०/६२/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.066.m4a", "display_order": 67, "topics": [{"text": "लक्षणास्वयंवरः", "range": "६०"}]}, {"id": 6000258067, "chapter_id": 10258, "verse_number": "१०-६२-६१", "content_sanskrit": "अन्याश्चैवंविधा भार्याः कृष्णस्यासन् सहस्रशः।\nभौमं हत्वा तन्निरोधादाहृताश्चारुदर्शनाः॥ १०/६२/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_062/BhP_10.062.067.m4a", "display_order": 68}, {"id": 6000258068, "chapter_id": 10258, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे द्विषष्टितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]