[{"id": 2075358, "chapter_id": 2594, "verse_number": "१२-९९-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075359, "chapter_id": 2594, "verse_number": "१२-९९-१", "content_sanskrit": "अत्राप्युदाहरन्तीम-तिहासं पुरातनम्।\nप्रतर्दनो मैथिलश्च संग्रामं यत्र चक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075360, "chapter_id": 2594, "verse_number": "१२-९९-२", "content_sanskrit": "यज्ञोपवीती संग्रामे जनको मिथिलाधिपः।\nयोधानुद्धर्षयामास तन्निबोध युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075361, "chapter_id": 2594, "verse_number": "१२-९९-३", "content_sanskrit": "जनको मैथिलो राजा महात्मा सर्वतत्त्ववित्।\nयोधानां दर्शयामास स्वर्गं नरकमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075362, "chapter_id": 2594, "verse_number": "१२-९९-४", "content_sanskrit": "अभीरूणामिमे लोका भास्वन्तो हन्त पश्यत।\nपूर्णा गन्धर्वकन्याभिः सर्वकामदुहोऽक्षयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075363, "chapter_id": 2594, "verse_number": "१२-९९-५", "content_sanskrit": "इमे पलायमानानां नरकाः प्रत्युपस्थिताः।\nअकीर्तिः शाश्वती चैव यतितव्यमनन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075364, "chapter_id": 2594, "verse_number": "१२-९९-६", "content_sanskrit": "तान्दृष्ट्वाऽरीन्विजयत भूत्वा संत्यागबुद्धयः।\nनरकस्याप्रतिष्ठस्य मा भूत वशवर्तिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075365, "chapter_id": 2594, "verse_number": "१२-९९-७", "content_sanskrit": "त्यागमूलं हि शूराणां स्वर्गद्वारमनुत्तमम्।\nइत्युक्तास्ते नृपतिना योधाः परपुरंजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2075366, "chapter_id": 2594, "verse_number": "१२-९९-८", "content_sanskrit": "अजयन्त रणे शत्रून्हर्षयन्तो नरेश्वरम्।\nतस्मात्त्यक्तात्मना नित्यं स्थातव्यं रणमूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2075367, "chapter_id": 2594, "verse_number": "१२-९९-९", "content_sanskrit": "गजानां रथिनो मध्ये रथानामनुसादिनः।\nसादिनामन्तरे स्थाप्यं पादातमपि दंशितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2075368, "chapter_id": 2594, "verse_number": "१२-९९-१०", "content_sanskrit": "य एवं व्यूहते राजा स नित्यं जयते रिपून्।\nतस्मदितद्विधातव्यं नित्यमेव युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2075369, "chapter_id": 2594, "verse_number": "१२-९९-११", "content_sanskrit": "स्वर्गे सुकृतमिच्छन्तः सुयुद्धेनातिमन्यवः।\nक्षोभयेयुरनीकानि सागरं मकरा यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2075370, "chapter_id": 2594, "verse_number": "१२-९९-१२", "content_sanskrit": "हर्षयेयुर्विषण्णांश्च व्यवस्थाप्य परस्परम्।\nतेषां च भूमिं रक्षेयुर्भग्नान्नात्यनुसारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2075371, "chapter_id": 2594, "verse_number": "१२-९९-१३", "content_sanskrit": "पुनरावर्तमानानां निराशानां च जीविते।\nवेगः सुदुःसहो राजंस्तस्मान्नात्यनुसारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2075372, "chapter_id": 2594, "verse_number": "१२-९९-१४", "content_sanskrit": "न हि प्रहर्तुमिच्छन्ति शूराः प्रद्रवतो भयात्।\nतस्मात्पलायमानानां कुर्यान्नात्यनुसारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2075373, "chapter_id": 2594, "verse_number": "१२-९९-१५", "content_sanskrit": "चराणामचरा ह्यन्नमदंष्ट्रा दंष्ट्रिणामपि।\nअपाणयः पाणिमतामन्नं शूरस्य कातराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2075374, "chapter_id": 2594, "verse_number": "१२-९९-१६", "content_sanskrit": "समानपृष्ठोदरपाणिपादाः\nपश्चाच्छरं भीरवोऽनुव्रजन्ति।\nअतो भयार्ताः प्रणिपत्य भूयः\nकृत्वाञ्जलीनुपतिष्ठन्ति शूरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2075375, "chapter_id": 2594, "verse_number": "१२-९९-१७", "content_sanskrit": "शूरबाहुषु लोकोऽयं लम्बते पुत्रवत्सद।\nतस्मात्सर्वेषु लोकेषु शूरः संमानमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2075376, "chapter_id": 2594, "verse_number": "१२-९९-१८", "content_sanskrit": "न हि शौर्यात्परं किंचिन्त्रिषु लोकेषु विद्यते।\nशूरः सर्वं पालयति सर्वं शूरे प्रतिष्ठितम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2075377, "chapter_id": 2594, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि एकोनशततमोऽध्यायः॥ ९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]