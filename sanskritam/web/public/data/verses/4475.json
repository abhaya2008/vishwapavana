[{"id": 2160302, "chapter_id": 4475, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2160303, "chapter_id": 4475, "verse_number": "१", "content_sanskrit": "तस्मिन् प्रभग्ने सैन्याग्रे हन्यमाने किरीटिना ।\nको नु तत्रार्जुनं युद्धे वीरः प्रत्युदियाद् रथी\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2160304, "chapter_id": 4475, "verse_number": "२", "content_sanskrit": "आहोस्विच्छकटव्यूहं प्रविष्टा मोघनिश्चयाः ।\nद्रोणमाश्रित्य तिष्ठन्ति प्राकारमकुतोभयाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2160305, "chapter_id": 4475, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2160306, "chapter_id": 4475, "verse_number": "३", "content_sanskrit": "तथाऽर्जुनेन सम्भग्ने तस्मिंस्तव महाबले ।\nहतवीरे हतोत्साहे पलायनकृतक्षणे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2160307, "chapter_id": 4475, "verse_number": "४", "content_sanskrit": "पाकशासनिनाऽभीक्ष्णं वध्यमाने शरोत्तमैः ।\nन कश्चित् तत्र सङ्ग्रामे शशाकार्जुनमीक्षितुम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2160308, "chapter_id": 4475, "verse_number": "५", "content_sanskrit": "ततस्तव सुतो राजन् दृष्ट्वा सैन्यं तथागतम् ।\nदुःशासनो भृशं क्रुद्धो युद्धायार्जुनमभ्ययात्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2160309, "chapter_id": 4475, "verse_number": "६", "content_sanskrit": "सकाञ्चनविचित्रेण कवचेन समावृतः ।\nजाम्बूनदशिरस्त्राणः शूरस्तीव्रपराक्रमः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2160310, "chapter_id": 4475, "verse_number": "७", "content_sanskrit": "नागानीकेन महता ग्रसन्निव महीमिमाम् ।\nदुःशासनो महाराज सव्यसाचिनमावृणोत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2160311, "chapter_id": 4475, "verse_number": "८", "content_sanskrit": "युवराजो बलश्लाघी पिङ्गलः प्रियदर्शनः ।\nस मुहूर्तं प्रतिभयो दारुणः समपद्यत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2160312, "chapter_id": 4475, "verse_number": "९", "content_sanskrit": "ह्रादेन गजघण्टानां ज्याक्षेपनिनदेन च ।\nशङ्खतूर्यप्रणादेन निनदेन च दन्तिनाम् ।\nद्यावापृथिव्योर्विवरं सान्तर्देशं समावृणोत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2160313, "chapter_id": 4475, "verse_number": "१०", "content_sanskrit": "तान् दृष्ट्वाऽऽपततो नागान् शिक्षितैः साधु चोदितान् ।\nगृहीतहस्तान् संरब्धान् सपक्षानिव पर्वतान्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2160314, "chapter_id": 4475, "verse_number": "११", "content_sanskrit": "सिंहनादेन महता नरसिंहो धनञ्जयः ।\nतस्याचलघनप्रख्यं पताकाशतसङ्कुलम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2160315, "chapter_id": 4475, "verse_number": "१२", "content_sanskrit": "गजानीकममित्राणामभितो व्यधमच्छरैः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2160316, "chapter_id": 4475, "verse_number": "१३", "content_sanskrit": "महोर्मिणमिवोद्धूतं श्वसनेन महार्णवम् ।\nकिरीटी तद् गजानीकं प्राविशन्मकरो यथा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2160317, "chapter_id": 4475, "verse_number": "१४", "content_sanskrit": "स्वमाश्रित इवादित्यः प्रतपन् युगसङ्क्षये ।\nददृशे दिक्षु सर्वासु पार्थः परपुरञ्जयः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2160318, "chapter_id": 4475, "verse_number": "१५", "content_sanskrit": "खुरशब्देन चाश्वानां नेमिशब्देन तेन च ।\nतेन चोत्क्रष्टुशब्देन ज्यानिनादेन तेन च\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2160319, "chapter_id": 4475, "verse_number": "१६", "content_sanskrit": "नानावादित्रशब्देन पाञ्चजन्यस्वनेन च ।\nदेवदत्तस्य घोषेण गाण्डीवनिनदेन च\nमन्दवेगतरा नागा बभूवुः स्त्रस्तचेतसः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2160320, "chapter_id": 4475, "verse_number": "१७", "content_sanskrit": "शरव्रातमये सत्रे वितते सव्यसाचिना ।\nते गजाः समसीदन्त मग्नाः पङ्कार्णवेष्विव\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2160321, "chapter_id": 4475, "verse_number": "१८", "content_sanskrit": "युगपच्च समाविष्टैः शरैर्गाण्डीवधन्वनः ।\nअनेकशतसाहस्रैर्द्रुमा मधुकरैरिव\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2160322, "chapter_id": 4475, "verse_number": "१९", "content_sanskrit": "पुङ्खावशिष्टैर्बहुभिः शोणितोत्पीडवाहिनः ।\nआरावं परमं कृत्वा सपताकायुधध्वजाः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2160323, "chapter_id": 4475, "verse_number": "२०", "content_sanskrit": "सोत्तरायुधिनः पेतुः छिन्नपक्षा इवाद्रयः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2160324, "chapter_id": 4475, "verse_number": "२१", "content_sanskrit": "अपरे दन्तमूलोष्ठकुम्भेषु च करेषु च ।\nशरैः समर्पिता नागाः क्रौञ्चवद् व्यनदन् मुहुः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2160325, "chapter_id": 4475, "verse_number": "२२", "content_sanskrit": "गजस्कन्धगतानां च पुरुषाणां किरीटिना ।\nछिद्यन्ते चोत्तमाङ्गानि भल्लैः सन्नतपर्वभिः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2160326, "chapter_id": 4475, "verse_number": "२३", "content_sanskrit": "सकुण्डलानां पततां शिरसां पृथिवीतळे ।\nपद्मानामिव सङ्घातैः पार्थश्चक्रे निवेदनम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2160327, "chapter_id": 4475, "verse_number": "२४", "content_sanskrit": "यन्त्रबद्धा विकवचा व्यंसाश्च रुधिरोक्षिताः ।\nभ्रममाणेषु नागेषु मनुष्या विललङ्घिरे\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2160328, "chapter_id": 4475, "verse_number": "२५", "content_sanskrit": "केचिदेकेन बाणेन सुमुक्तेन पतत्रिणा ।\nद्वौ त्रयश्च विनिर्भिन्ना निपेतुः पृथिवीतळे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2160329, "chapter_id": 4475, "verse_number": "२६", "content_sanskrit": "अपरे मदसंरब्धा मातङ्गाः पर्वतोपमाः ।\nपेतुः पृथिव्यां निहता वज्ररुग्णा इवाचलाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2160330, "chapter_id": 4475, "verse_number": "२७", "content_sanskrit": "अतिविद्धाश्च नाराचैर्वमन्तो रुधिरं मुखैः ।\nसारोहा न्यपतन्नुर्व्यां द्रुमवन्त इवाचलाः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2160331, "chapter_id": 4475, "verse_number": "२८", "content_sanskrit": "ततोऽर्जुनो भृशं क्रुद्धः प्रदहन्निव तेजसा ।\nववर्ष शरवर्षाणि योधानामनिवर्तिनाम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2160332, "chapter_id": 4475, "verse_number": "२९", "content_sanskrit": "मौर्वीं धनुर्ध्वजं चैव युगमक्षमवस्करम् ।\nरथिनां कुट्टयामास भल्लैः सन्नतपर्वभिः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2160333, "chapter_id": 4475, "verse_number": "३०", "content_sanskrit": "न सन्दधानश्चापस्य न विमुञ्चन् न चोद्धरन् ।\nमण्डलेनैव धनुषा नृत्यन् पार्थः स्म दृश्यते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2160334, "chapter_id": 4475, "verse_number": "३१", "content_sanskrit": "अतिविद्धाश्च नाराचैर्वमन्तो रुधिरं मुखैः ।\nमुहूर्तान्न्यपतन्नन्ये वारणा वसुधातळे\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2160335, "chapter_id": 4475, "verse_number": "३२", "content_sanskrit": "उत्थितान्यगणेयानि कबन्धानि समन्ततः\nअदृश्यन्त महाराज तस्मिन् परमसङ्कुले\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2160336, "chapter_id": 4475, "verse_number": "३३", "content_sanskrit": "सचापाः साङ्गुलित्राणाः सखड्गाः साङ्गदा रणे ।\nअदृश्यन्त भुजाश्छिन्ना हेमाभरणभूषिताः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2160337, "chapter_id": 4475, "verse_number": "३४", "content_sanskrit": "अवस्करैरधिष्ठानैरीषादण्डकबन्धुरैः ।\nचक्रैर्विमथितैरक्षैर्भग्नैश्च बहुधा युगैः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2160338, "chapter_id": 4475, "verse_number": "३५", "content_sanskrit": "चर्मचापधरैश्चैव व्यवकीर्णैस्ततस्ततः ।\nस्रग्भिराभरणैर्वस्त्रैः पतितैश्च महाध्वजैः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2160339, "chapter_id": 4475, "verse_number": "३६", "content_sanskrit": "निहतैर्वारणैरश्वैः क्षत्रियैश्च निपातितैः ।\nअदृश्यत मही तत्र दारुणाप्रियदर्शना\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2160340, "chapter_id": 4475, "verse_number": "३७", "content_sanskrit": "दुःशासनबलं सर्वं वध्यमानं किरीटिना ।\nसम्प्राद्रवन्महाराज व्यथितं हतनायकम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2160341, "chapter_id": 4475, "verse_number": "३८", "content_sanskrit": "एवं बले द्रुते याते राजपुत्रं महारथम् ।\nविव्याध दशभिर्बाणैः तिष्ठ तिष्ठेति चाब्रवीत्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2160342, "chapter_id": 4475, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2160343, "chapter_id": 4475, "verse_number": "३९", "content_sanskrit": "जीवितेन कथं गन्ता दुरुक्तं यत् तवाद्य मे ।\nतद् वाक्यसदृशं कर्म कुरु त्वं यदि मन्यसे\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2160344, "chapter_id": 4475, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2160345, "chapter_id": 4475, "verse_number": "४०", "content_sanskrit": "एवमुक्त्वा ततो राजन् पार्थः पार्थिवमर्दनः ।\nभृशं क्रुद्धो महाराज अविद्ध्यत् तनयं तव\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2160346, "chapter_id": 4475, "verse_number": "४१", "content_sanskrit": "ततो दुःशासनस्त्रस्तः सहानीकः शरार्दितः ।\nद्रोणं त्रातारमाकाङ्क्षन् शकटव्यूहमभ्यगात्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2160347, "chapter_id": 4475, "verse_number": "४२", "content_sanskrit": "दुःशासनबलं हत्वा सव्यसाची परन्तपः ।\nसिन्धुराजं परीप्सन् वै द्रोणानीकमुपाद्रवत्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2160348, "chapter_id": 4475, "verse_number": "४३", "content_sanskrit": "स तु द्रोणं समासाद्य व्यूहस्य प्रमुखे स्थितम् ।\nकृताञ्जलिरिदं वाक्यं कृष्णस्यानुमतेऽब्रवीत्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2160349, "chapter_id": 4475, "verse_number": "४४", "content_sanskrit": "शिवेन ध्याहि मां ब्रह्मन् स्वस्ति चैव वदस्व मे ।\nतव प्रसादादिच्छामि प्रवेष्टुं दुर्भिदां चमूम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2160350, "chapter_id": 4475, "verse_number": "४५", "content_sanskrit": "भवान् पितृसमो मह्यं धर्मराजसमोऽपि च ।\nधौम्यकृष्णसमश्चैव सत्यमेतद् ब्रवीमि ते\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2160351, "chapter_id": 4475, "verse_number": "४६", "content_sanskrit": "अश्वत्थामा यथा तात रक्षणीयस्तवाऽनघ ।\nतथाहमपि ते रक्ष्यः सदैव द्विजसत्तम\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2160352, "chapter_id": 4475, "verse_number": "४७", "content_sanskrit": "भवत्प्रसादादिच्छेयं सिन्धुराजानमाहवे ।\nनिहन्तुं द्विपदां श्रेष्ठ प्रतिज्ञां रक्ष मे प्रभो\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2160353, "chapter_id": 4475, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2160354, "chapter_id": 4475, "verse_number": "४८", "content_sanskrit": "एवमुक्तस्तदाऽऽचार्यः प्रत्युवाचार्जुनं स्मयन् ।\nमामजित्वा न बीभत्सो शक्यं प्राप्तुं जयद्रथम् \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2160355, "chapter_id": 4475, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2160356, "chapter_id": 4475, "verse_number": "४९", "content_sanskrit": "एतावदुक्त्वा तं द्रोणः शरव्रातैरवाकिरत् ।\nसरथाश्वध्वजं बाणैः प्रहसन् सहसारथिम्\t॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2160357, "chapter_id": 4475, "verse_number": "५०", "content_sanskrit": "ततोऽर्जुनः शरव्रातान् द्रोणस्यावार्य सायकैः ।\nद्रोणमभ्यर्दयद् बाणैर्घोररूपैर्महत्तरैः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2160358, "chapter_id": 4475, "verse_number": "५१", "content_sanskrit": "विव्याध च रणे द्रोणमनुमान्य विशां पते ।\nक्षत्रधर्मं समास्थाय नवभिः सायकैः पुनः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2160359, "chapter_id": 4475, "verse_number": "५२", "content_sanskrit": "तस्येषूनिषुभिश्छित्त्वा द्रोणो विव्याध तावुभौ ।\nविषाग्निज्वलनप्रख्यैरिषुभिः कृष्णपाण्डवौ\nइयेष पाण्डवस्तस्य छेत्तुं बाणैः शरासनम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2160360, "chapter_id": 4475, "verse_number": "५३", "content_sanskrit": "तस्य चिन्तयतस्त्वेव फल्गुनस्य महात्मनः ।\nद्रोणः शरैरसम्भ्रान्तो ज्यां चिच्छेदाशु वीर्यवान्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2160361, "chapter_id": 4475, "verse_number": "५४", "content_sanskrit": "विव्याध च हयानस्य ध्वजं सारथिमेव च ।\nअर्जुनं च शरैर्द्रोणः स्मयमानोऽभ्यवाकिरत्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2160362, "chapter_id": 4475, "verse_number": "५५", "content_sanskrit": "एतस्मिन्नन्तरे पार्थः सज्यं कृत्वा महद्धनुः ।\nविशेषयिष्यन्नाचार्यं सर्वास्त्रविदुषां वरम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2160363, "chapter_id": 4475, "verse_number": "५६", "content_sanskrit": "गृहीत्वा षट्शतान् बाणान् मुमोचैकमिव द्रुतम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2160364, "chapter_id": 4475, "verse_number": "५७", "content_sanskrit": "पुनः सप्तशतानन्यान् सहस्रं चानिवर्तिनाम् ।\nचिक्षेपायुतशश्चान्यान् तेऽघ्नन् द्रोणस्य तां चमूम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2160365, "chapter_id": 4475, "verse_number": "५८", "content_sanskrit": "तैः सम्यगस्तैर्बलिना कृतिना चित्रयोधिना ।\nमनुष्यवाजिमातङ्गा विद्धाः पेतुर्गतासवः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2160366, "chapter_id": 4475, "verse_number": "५९", "content_sanskrit": "विसूताश्वध्वजाः पेतुः सञ्छिन्नायुधजीविताः ।\nरथिनो रथमुख्येभ्यः सहसा बाणपीडिताः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2160367, "chapter_id": 4475, "verse_number": "६०", "content_sanskrit": "चूर्णिताः क्षिप्तदग्धाङ्गा वज्रानिलहुताशनैः ।\nतुल्यरूपा द्विपाः पेतुर्गिर्यग्राम्बुदवर्ष्मणः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2160368, "chapter_id": 4475, "verse_number": "६१", "content_sanskrit": "पेतुरश्वसहस्राणि प्रहतान्यर्जुनेषुभिः ।\nहंसा हिमवतः पृष्ठे वारिविप्रहता इव\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2160369, "chapter_id": 4475, "verse_number": "६२", "content_sanskrit": "रथाश्वद्विपपत्त्योघाः सलिलौघा इवाद्भुताः ।\nयुगान्तादित्यरश्म्याभैः पाण्डवास्त्रशरैर्हताः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2160370, "chapter_id": 4475, "verse_number": "६३", "content_sanskrit": "तत् पाण्डवादित्यशरांशुजालं\nकुरुप्रवीरान् युधि निष्टपन्तम् ।\nस द्रोणमेघः शरवर्षवेगैः\nप्राच्छादयन्मेघ इवार्करश्मीन्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2160371, "chapter_id": 4475, "verse_number": "६४", "content_sanskrit": "अथात्यर्थं विसृष्टेन द्विषतामसुभोजिना ।\nआजघ्ने वक्षसि द्रोणो नाराचेन धनञ्जयम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2160372, "chapter_id": 4475, "verse_number": "६५", "content_sanskrit": "स विह्वलितसर्वाङ्गः क्षितिकम्पे यथाऽचलः ।\nधैर्यमास्थाय बीभत्सुर्द्रोणं विव्याध पत्रिभिः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2160373, "chapter_id": 4475, "verse_number": "६६", "content_sanskrit": "द्रोणस्तु पञ्चभिर्बाणैर्वासुदेवमताडयत् ।\nअर्जुनं च त्रिसप्तत्या ध्वजं चास्य त्रिभिः शरैः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2160374, "chapter_id": 4475, "verse_number": "६७", "content_sanskrit": "विशेषयिष्यन् शिष्यं च द्रोणो राजन् पराक्रमी ।\nअदृश्यमर्जुनं चक्रे निमेषाच्छरवृष्टिभिः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2160375, "chapter_id": 4475, "verse_number": "६८", "content_sanskrit": "प्रसक्तान् गच्छतोऽपश्यन् भारद्वाजस्य सायकान् ।\nमण्डलीकृतमेवास्य धनुश्चादृश्यताद्भुतम्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2160376, "chapter_id": 4475, "verse_number": "६९", "content_sanskrit": "तेऽभ्ययुः समरे राजन् वासुदेवधनञ्जयौ ।\nद्रोणसृष्टाः सुबहवः कङ्कपत्रपरिच्छदाः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2160377, "chapter_id": 4475, "verse_number": "७०", "content_sanskrit": "तत्राद्भुतमपश्याम शिलानामिव सर्पणम् ।\nयद् द्रोणं तरसा पार्थो वृद्धं बालोऽपि नातरत्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2160378, "chapter_id": 4475, "verse_number": "", "content_sanskrit": "तं दृष्ट्वा तादृशं युद्धं द्रोणपाण्डवयोस्तदा ।\nवासुदेवो महाबुद्धिः कार्यचिन्तामचिन्तयत्\t॥॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2160379, "chapter_id": 4475, "verse_number": "७१", "content_sanskrit": "चिन्तयामास वार्ष्णेयो दृष्ट्वा द्रोणस्य विक्रमम् ।\nनातिवर्तिष्यते ह्येनं वेलामिव महार्णवः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2160380, "chapter_id": 4475, "verse_number": "७२", "content_sanskrit": "ततः पार्थं समुद्विग्नं लक्ष्य चिन्तयतेऽच्युतः ।\nद्रोणस्य चापि विक्रान्तं दृष्ट्वा मधुनिषूदनः\nइत्यब्रवीद् वासुदेवो धनञ्जयमुदारधीः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2160381, "chapter_id": 4475, "verse_number": "७३", "content_sanskrit": "पार्थ पार्थ महाबाहो न नः कालात्ययो भवेत् ।\nद्रोणमुत्सृज्य गच्छामो कृत्यमेतन्महत्तरम्\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2160382, "chapter_id": 4475, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2160383, "chapter_id": 4475, "verse_number": "७४", "content_sanskrit": "तं पार्थश्चाब्रवीत् कृष्णं यथेष्टमिति केशवम् \t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2160384, "chapter_id": 4475, "verse_number": "७५", "content_sanskrit": "ततः प्रदक्षिणं कृत्वा द्रोणं प्रायान्महाभुजः ।\nपरिवृत्तश्च बीभत्सुर्गच्छन्नस्यन् शितान् शरान्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2160385, "chapter_id": 4475, "verse_number": "७६", "content_sanskrit": "ततोऽब्रवीत् स्मयन् द्रोणः क्वेदं पाण्डव गम्यते ।\nननु नाम रणे शत्रूनजित्वा न निवर्तसे\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2160386, "chapter_id": 4475, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2160387, "chapter_id": 4475, "verse_number": "७७", "content_sanskrit": "गुरुर्भवान्न मे शत्रुः शिष्यः पुत्रसमोऽस्मि ते ।\nन चास्ति स पुमाँल्लोके यस्त्वां क्रुद्धमभिद्रवेत्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2160388, "chapter_id": 4475, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2160389, "chapter_id": 4475, "verse_number": "७८", "content_sanskrit": "एवं ब्रुवाणो बीभत्सुर्जयद्रथवधोत्सुकः ।\nअभ्यद्रवत सङ्क्रुद्धः तव पुत्रस्य वाहिनीम्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2160390, "chapter_id": 4475, "verse_number": "७९", "content_sanskrit": "तं चक्ररक्षौ पाञ्चाल्यौ युधामन्यूत्तमौजसौ ।\nअन्वयातां महात्मानौ विशन्तं तावकीं चमूम्\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2160391, "chapter_id": 4475, "verse_number": "८०", "content_sanskrit": "ततो जयो महाराज कृतवर्मा च सात्त्वतः ।\nकाम्बोजश्च श्रुतायुश्च धनञ्जयमवारयन्\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2160392, "chapter_id": 4475, "verse_number": "८१", "content_sanskrit": "तेषां दशसहस्राणि रथानामनुयायिनाम् ।\nअभीषाहाः शूरसेनाः शिबयोऽथ वसातयः\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2160393, "chapter_id": 4475, "verse_number": "८२", "content_sanskrit": "मच्छिल्लिका लिलिन्ध्राश्च केकया मद्रकास्तथा ।\nनारायणाश्च गोपालाः काम्बोजानां च ये गणाः ।\nपरैर्नच जिता राजन् पुरा ते वीरसत्तमाः\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2160394, "chapter_id": 4475, "verse_number": "८३", "content_sanskrit": "कर्णेन विजिताः पूर्वं सङ्ग्रामे शूरसम्मताः ।\nभारद्वाजं पुरस्कृत्य हृष्टात्मानोऽर्जुनं प्रति\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2160395, "chapter_id": 4475, "verse_number": "८४", "content_sanskrit": "पुत्रशोकाभिसन्तप्तं क्रुद्धं मृत्युमिवान्तकम् ।\nत्यजन्तं तुमुले प्राणान् सन्नद्धं चित्रयोधिनम्\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2160396, "chapter_id": 4475, "verse_number": "८५", "content_sanskrit": "गाहमानमनीकानि मातङ्गमिव यूथपम् ।\nमहेष्वासं पराक्रान्तं नरव्याघ्रमवारयन्\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2160397, "chapter_id": 4475, "verse_number": "८६", "content_sanskrit": "ततः प्रववृते युद्धं तुमुलं रोमहर्षणम् ।\nअन्योन्यं वै प्रार्थयतां योधानां जयगर्द्धिनाम्\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2160398, "chapter_id": 4475, "verse_number": "८७", "content_sanskrit": "जयद्रथवधप्रेप्सुमायान्तं पुरुषर्षभम् ।\nन्यवारयन्त सहिताः क्रिया व्याधिमिवोत्थितम्\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2160399, "chapter_id": 4475, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि अशीतितमोऽध्यायः ॥ ८० ॥\nजयद्रथवधपर्वणि चतुर्थोऽध्यायः ॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}]