[{"id": 7004415000, "chapter_id": 24415, "verse_number": "५-३-१०९-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेन्महीपाल चक्रतीर्थमनुत्तमम् ।\nसेनापुरमितिख्यातं सर्वपापक्षयंकरम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004415001, "chapter_id": 24415, "verse_number": "५-३-१०९-२", "content_sanskrit": "सैनापत्याभिषेकाय देवदेवेन चक्रिणा ।\nआनीतश्च महासेनो देवैः सेन्द्रपुरोगमैः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004415002, "chapter_id": 24415, "verse_number": "५-३-१०९-३", "content_sanskrit": "दानवानां वधार्थाय जयाय च दिवौकसाम् ।\nभूमिदानेन विप्रेन्द्रांस्तर्पयित्वा यथाविधि॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004415003, "chapter_id": 24415, "verse_number": "५-३-१०९-४", "content_sanskrit": "शङ्खभेरीनिनादैश्च पटहानां च निस्वनैः ।\nवीणावेणुमृदङ्गैश्च झल्लरीस्वरमङ्गलैः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004415004, "chapter_id": 24415, "verse_number": "५-३-१०९-५", "content_sanskrit": "ततः कृत्वा स्वनं घोरं दानवो बलदर्पितः ।\nरुरुर्नाम विघातार्थमभिषेकस्य चागतः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004415005, "chapter_id": 24415, "verse_number": "५-३-१०९-६", "content_sanskrit": "हस्त्यश्वरथपत्त्योघैः पूरयन्वै दिशो दश ।\nतत्र तेन महद्युद्धं प्रवृत्तं किल भारत॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004415006, "chapter_id": 24415, "verse_number": "५-३-१०९-७", "content_sanskrit": "शक्त्यृष्टिपाशमुशलैः खड्गैस्तोमरटङ्कनैः ।\nभल्लैः कर्णिकनाराचैः कबन्धपटसंकुलैः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004415007, "chapter_id": 24415, "verse_number": "५-३-१०९-८", "content_sanskrit": "ततस्तु तां शत्रुबलस्य सेनां क्षणेन चापन्च्युतबाणघातैः ।\nविध्वस्तहस्त्यश्वरथान्महात्मा जग्राह चक्रं रिपुसङ्घनाशनः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004415008, "chapter_id": 24415, "verse_number": "५-३-१०९-९", "content_sanskrit": "ज्वलच्च चक्रं निशितं भयंकरं सुरासुराणां च सुदर्शनं रणे ।\nचकर्त दैत्यस्य शिरस्तदानीं करात्प्रमुक्तं मधुघातिनश्च तत्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004415009, "chapter_id": 24415, "verse_number": "५-३-१०९-१०", "content_sanskrit": "तं दृष्ट्वा सहसा विघ्नमभिषेके षडाननः ।\nत्यक्त्वा तु तत्र संस्थानं चचार विपुलं तपः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004415010, "chapter_id": 24415, "verse_number": "५-३-१०९-११", "content_sanskrit": "मुक्तं चक्रं विनाशाय हरिणा लोकधारिणा ।\nद्विदलं दानवं कृत्वा पपात विमले जले॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004415011, "chapter_id": 24415, "verse_number": "५-३-१०९-१२", "content_sanskrit": "तदा प्रभृति तत्तीर्थं चक्रतीर्थमिति श्रुतम् ।\nसर्वपापविनाशाय निर्मितं विश्वमूर्तिना॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004415012, "chapter_id": 24415, "verse_number": "५-३-१०९-१३", "content_sanskrit": "चक्रतीर्थे तु यः स्नात्वा पूजयेद्देवमच्युतम् ।\nपुण्डरीकस्य यज्ञस्य फलमाप्नोति मानवः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004415013, "chapter_id": 24415, "verse_number": "५-३-१०९-१४", "content_sanskrit": "तत्र तीर्थे तु यः स्नात्वा पूजयेद्ब्राह्मणाञ्छुभान् ।\nशान्तदान्तजितक्रोधान्स लभेत्कोटिजं फलम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004415014, "chapter_id": 24415, "verse_number": "५-३-१०९-१५", "content_sanskrit": "तत्र तीर्थे तु यो भक्त्या त्यजते देहमात्मनः ।\nविष्णुलोकं मृतो याति जयशब्दादिमङ्गलैः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004415015, "chapter_id": 24415, "verse_number": "५-३-१०९-१६", "content_sanskrit": "क्रीडयित्वा यथाकामं देवगन्धर्वपूजितः ।\nइहागत्य च भूयोऽपि जायते विपुले कुले॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004415016, "chapter_id": 24415, "verse_number": "५-३-१०९-१७", "content_sanskrit": "एतत्पुण्यं पापहरं धन्यं दुःखप्रणाशनम् ।\nकथितं ते महाभाग भूयश्चान्यच्छृणुष्व मे॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]