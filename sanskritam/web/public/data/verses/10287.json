[{"id": 6000287000, "chapter_id": 10287, "verse_number": null, "content_sanskrit": "अथ एकनवतितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000287001, "chapter_id": 10287, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.001.m4a", "display_order": 2}, {"id": 6000287002, "chapter_id": 10287, "verse_number": "१०-९१-१", "content_sanskrit": "भूयोऽहं श्रोतुमिच्छामि रामस्याद्भुतकर्मणः।\nअनन्तस्याप्रमेयस्य यदन्यत् कृतवान् प्रभुः॥ १०/९१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.002.m4a", "display_order": 3, "topics": [{"text": "बलरामेण सर्वानपकुर्वतो विविदस्य वधः", "range": "१–२८"}]}, {"id": 6000287003, "chapter_id": 10287, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.003.m4a", "display_order": 4}, {"id": 6000287004, "chapter_id": 10287, "verse_number": "१०-९१-२", "content_sanskrit": "नरकस्य सखा कश्चिद् विविदो नाम वानरः।\nसुग्रीवसचिवः सोऽथ भ्राता मैन्दस्य वीर्यवान्॥ १०/९१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.004.m4a", "display_order": 5}, {"id": 6000287005, "chapter_id": 10287, "verse_number": "१०-९१-३", "content_sanskrit": "सख्युः सोऽपचितिं कुर्वन् वानरो राष्ट्रविप्लवम्।\nपुरग्रामाकरान् घोषानदहद् वह्निमुत्सृजन्॥ १०/९१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.005.m4a", "display_order": 6}, {"id": 6000287006, "chapter_id": 10287, "verse_number": "१०-९१-४", "content_sanskrit": "क्‍वचित् स शैलानुत्पाट्य तैर्देशान् समचूर्णयत्।\nआनर्तान् सुतरामेत्य यत्रास्ते शत्रुहा हरिः॥ १०/९१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.006.m4a", "display_order": 7}, {"id": 6000287007, "chapter_id": 10287, "verse_number": "१०-९१-५", "content_sanskrit": "क्‍वचित् समुद्रमध्यस्थो दोर्भ्यामुद्धृत्य तज्जलम्।\nदेशान् नागायुतप्राणो वेलाकूलानमज्जयत्॥ १०/९१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.007.m4a", "display_order": 8}, {"id": 6000287008, "chapter_id": 10287, "verse_number": "१०-९१-६", "content_sanskrit": "आश्रमानृषिमुख्यानां कृत्वा भग्नवनस्पतीन्।\nअदूषयच्छकृन्मूत्रैरग्नीन् वैतानिकान् खलः॥ १०/९१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.008.m4a", "display_order": 9}, {"id": 6000287009, "chapter_id": 10287, "verse_number": "१०-९१-७", "content_sanskrit": "पुरुषान् योषितो दृप्तः क्ष्माभृद्द्रोणीगुहासु सः।\nनिक्षिप्य चाप्यधाच्छृङ्गैः पेशस्कारीव कीटकम्॥ १०/९१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.009.m4a", "display_order": 10}, {"id": 6000287010, "chapter_id": 10287, "verse_number": "१०-९१-८", "content_sanskrit": "तं देशं विप्रकुर्वन् वै धर्षयंश्च कुलस्‍त्रियः।\nश्रुत्वा सुललितं गीतं गिरिं रैवतकं ययौ॥ १०/९१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.010.m4a", "display_order": 11}, {"id": 6000287011, "chapter_id": 10287, "verse_number": "१०-९१-९", "content_sanskrit": "तत्रापश्यद् यदुपतिं रामं पुष्करमालिनम्।\nसुदर्शनीयसर्वाङ्गं ललनायूथमध्यगम्॥ १०/९१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.011.m4a", "display_order": 12}, {"id": 6000287012, "chapter_id": 10287, "verse_number": "१०-९१-१०", "content_sanskrit": "गायन्तं वारुणीं पीत्वा मदविह्वललोचनम्।\nविभ्राजमानं वपुषा प्रभिन्नमिव वारणम्॥ १०/९१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.012.m4a", "display_order": 13}, {"id": 6000287013, "chapter_id": 10287, "verse_number": "१०-९१-११", "content_sanskrit": "दुष्टः शाखामृगः शाखामारूढः कम्पयन् द्रुमान्।\nचक्रे किलकिलाशब्दमात्मानं सम्प्रदर्शयन्॥ १०/९१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.013.m4a", "display_order": 14}, {"id": 6000287014, "chapter_id": 10287, "verse_number": "१०-९१-१२", "content_sanskrit": "तस्य धार्ष्ट्यं कपेर्वीक्ष्य तरुण्यो जातिचापलम्।\nहास्यप्रिया विजहसुर्बलदेवपरिग्रहाः॥ १०/९१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.014.m4a", "display_order": 15}, {"id": 6000287015, "chapter_id": 10287, "verse_number": "१०-९१-१३", "content_sanskrit": "ता हेलयामास कपिर्भ्रूक्षेपैः सम्मुखादिभिः।\nसन्दर्शयन् गुदं तासां रामस्य च निरीक्षतः॥ १०/९१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.015.m4a", "display_order": 16}, {"id": 6000287016, "chapter_id": 10287, "verse_number": "१०-९१-१४", "content_sanskrit": "तं ग्राव्णा प्राहरत् क्रुद्धो बलः प्रहरतां वरः।\nस वञ्चयित्वा ग्रावाणं मदिराकलशं कपिः॥ १०/९१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.016.m4a", "display_order": 17}, {"id": 6000287017, "chapter_id": 10287, "verse_number": "१०-९१-१५", "content_sanskrit": "गृहीत्वा हेलयामास धूर्तस्तं कोपयन् भृशम्।\nभृशं निर्भिद्य कलशं वासांस्यास्फालयद् बलात्॥ १०/९१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.017.m4a", "display_order": 18}, {"id": 6000287018, "chapter_id": 10287, "verse_number": "१०-९१-१६", "content_sanskrit": "कदर्थीकृत्य बलवान् विप्रचक्रे बलोद्धतः।\nतस्याप्यविनयं दृष्ट्वा देशांश्च तदुपद्रुतान्॥ १०/९१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.018.m4a", "display_order": 19}, {"id": 6000287019, "chapter_id": 10287, "verse_number": "१०-९१-१७", "content_sanskrit": "क्रुद्धो मुसलमादत्त हलं चारिजिघांसया।\nविविदोऽपि महावीर्यः शैलमुत्पाट्य पाणिना॥ १०/९१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.019.m4a", "display_order": 20}, {"id": 6000287020, "chapter_id": 10287, "verse_number": "१०-९१-१८", "content_sanskrit": "अभ्येत्य तरसा तेन बलं मूर्धन्यताडयत्।\nतं तु सङ्कर्षणो मूर्ध्नि पतन्तमचलं रुषा॥ १०/९१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.020.m4a", "display_order": 21}, {"id": 6000287021, "chapter_id": 10287, "verse_number": "१०-९१-१९", "content_sanskrit": "प्रतिजग्राह भगवान् मुसलेनाहनच्च तम्।\nमुसलाहतमस्तिष्को विरेजे रक्तधारया॥ १०/९१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.021.m4a", "display_order": 22}, {"id": 6000287022, "chapter_id": 10287, "verse_number": "१०-९१-२०", "content_sanskrit": "गिरिर्यथाऽऽगैरिकया प्रहारं नान्वचिन्तयत्।\nपुनरन्यं समुत्पाट्य कृत्वा निष्पत्रमोजसा॥ १०/९१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.022.m4a", "display_order": 23}, {"id": 6000287023, "chapter_id": 10287, "verse_number": "१०-९१-२१", "content_sanskrit": "तेनाहनत् सुसंक्रुद्धस्तं बलः शतधाऽरुजत्।\nततोऽन्यमुत्पाट्य जघ्ने तं चापि शतधाऽच्छिनत्॥ १०/९१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.023.m4a", "display_order": 24}, {"id": 6000287024, "chapter_id": 10287, "verse_number": "१०-९१-२२", "content_sanskrit": "एवं युद्ध्यन् भगवता भग्ने भग्ने पुनः पुनः।\nआकृष्य सर्वतो वृक्षान् निर्वृक्षमकरोद् वनम्॥ १०/९१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.024.m4a", "display_order": 25}, {"id": 6000287025, "chapter_id": 10287, "verse_number": "१०-९१-२३", "content_sanskrit": "ततोऽमुञ्चच्छिलावर्षं बलस्योपर्यमर्षितः।\nतत्सर्वं चूर्णयामास लीलया मुसलायुधः॥ १०/९१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.025.m4a", "display_order": 26}, {"id": 6000287026, "chapter_id": 10287, "verse_number": "१०-९१-२४", "content_sanskrit": "स बाहू तालसङ्काशौ मुष्टीकृत्य कपीश्वरः।\nआसाद्य रोहिणीपुत्रं दोर्भ्यां वक्षस्यरूरुजत्॥ १०/९१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.026.m4a", "display_order": 27}, {"id": 6000287027, "chapter_id": 10287, "verse_number": "१०-९१-२५", "content_sanskrit": "यादवेन्द्रोऽपि तं दोर्भ्यां त्यक्त्वा मुसललाङ्गलौ।\nजत्रावताडयत् क्रुद्धः सोऽपतद् रुधिरं वमन्॥ १०/९१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.027.m4a", "display_order": 28}, {"id": 6000287028, "chapter_id": 10287, "verse_number": "१०-९१-२६", "content_sanskrit": "चकम्पे तेन पतता सकण्टकवनस्पतिः।\nपर्वतो नृपशार्दूल वायुना नौरिवाम्भसि॥ १०/९१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.028.m4a", "display_order": 29}, {"id": 6000287029, "chapter_id": 10287, "verse_number": "१०-९१-२७", "content_sanskrit": "जयशब्दो नमःशब्दः साधु साध्विति चाम्बरे।\nसुरसिद्धमुनीन्द्राणामासीत् कुसुमवर्षिणाम्॥ १०/९१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.029.m4a", "display_order": 30}, {"id": 6000287030, "chapter_id": 10287, "verse_number": "१०-९१-२८", "content_sanskrit": "एवं निहत्य विविदं जगद्व्यतिकरावहम्।\nसंस्तूयमानो भगवान् जनैः स्वपुरमाविशत्॥ १०/९१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_091/BhP_10.091.030.m4a", "display_order": 31}, {"id": 6000287031, "chapter_id": 10287, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्ध एकनवतितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]