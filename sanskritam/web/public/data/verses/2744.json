[{"id": 2082202, "chapter_id": 2744, "verse_number": "१२-२४९-०x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082203, "chapter_id": 2744, "verse_number": "१२-२४९-१", "content_sanskrit": "--तीयमायुषो भागं गृहमेधी गृहे वसेत्।\nधर्मलब्धैर्युतो दारैरग्नीनाहृत्य सुव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082204, "chapter_id": 2744, "verse_number": "१२-२४९-२", "content_sanskrit": "गृहस्थवृत्तयश्चैव चतस्रः कविभिः स्मृताः।\nकुमूलधान्यः प्रथमः कुम्भधान्यस्त्वनन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082205, "chapter_id": 2744, "verse_number": "१२-२४९-३", "content_sanskrit": "अश्वस्तनोऽथ कापोतीमाश्रितो वृत्तिमाहरेत्।\nतेषां परः परो ज्यायान्धर्मतो लोकजित्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082206, "chapter_id": 2744, "verse_number": "१२-२४९-४", "content_sanskrit": "षट्कर्मावर्तयत्येकस्त्रिभिरन्यः प्रवर्तते।\nद्वाभ्यामेकश्चतुर्थस्तु ब्रह्मसत्रे व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082207, "chapter_id": 2744, "verse_number": "१२-२४९-५", "content_sanskrit": "गृहमेधिव्रतान्यत्र महान्तीह प्रचक्षते।\nनात्मार्थे पाचयेदन्नं न वृथा घातयेत्पशून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082208, "chapter_id": 2744, "verse_number": "१२-२४९-६", "content_sanskrit": "प्राणी वा यदि वाऽप्राणी संस्कारं यजुषाऽर्हति।\nन दिवा प्रस्वपेज्जातु न पूर्वापररात्रयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082209, "chapter_id": 2744, "verse_number": "१२-२४९-७", "content_sanskrit": "न भुञ्जीतान्तराकाले नानृतावाह्वयेत्स्त्रियम्।\nनास्यानश्नन्गृहे विप्रो वसेत्कश्चिदपूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082210, "chapter_id": 2744, "verse_number": "१२-२४९-८", "content_sanskrit": "तथास्यातिथयः पूज्या हव्यकव्यवहाः सदा।\nवेदविद्याव्रतस्नाताः श्रोत्रिया वेदपारगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082211, "chapter_id": 2744, "verse_number": "१२-२४९-९", "content_sanskrit": "स्वकर्मजीविनो दान्ताः क्रियावन्तस्तपस्विनः।\nतेषां हव्यं च कव्यं चाप्यर्हणार्थं विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082212, "chapter_id": 2744, "verse_number": "१२-२४९-१०", "content_sanskrit": "नखरैः संप्रयातस्य स्वकर्मव्यापकस्य च।\nअपविद्धाग्निहोत्रस्य गुरोर्वाऽलीकचारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082213, "chapter_id": 2744, "verse_number": "१२-२४९-११", "content_sanskrit": "संविभागोऽत्र भूतानां सर्वेषामेव शिष्यते।\nतथैवापचमानेभ्यः प्रदेयं गृहमेधिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082214, "chapter_id": 2744, "verse_number": "१२-२४९-१२", "content_sanskrit": "विस्साशी भवेन्नित्यं नित्यं चामृतभोजनः।\nअसुत --शेषं स्याद्भोजनं हविषा समम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082215, "chapter_id": 2744, "verse_number": "१२-२४९-१३", "content_sanskrit": "भृत्यशेष तु योऽश्नाति तमाहुर्विघसा शिनम्।\nविघसं भृत्यशेषं तु यज्ञशेषमथास्मृतय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082216, "chapter_id": 2744, "verse_number": "१२-२४९-१४", "content_sanskrit": "स्वदारनिरतो दान्तो ह्यनसूयुर्जितेन्द्रियः।\nऋत्विक्पुरोहिताचार्यर्मालुलातिथिनंश्रितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082217, "chapter_id": 2744, "verse_number": "१२-२४९-१५", "content_sanskrit": "वृद्धबालातुरैर्वैद्यैर्ज्ञातिसंबन्धिरान्धवैः।\nमातापितृभ्यां जामीभिर्भ्रात्रा पुत्रेण भावया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082218, "chapter_id": 2744, "verse_number": "१२-२४९-१६", "content_sanskrit": "दुहित्रा दासवर्गेण विवादं न समाचरत्।\nएतान्विमुच्य संवादान्सर्वपापैर्विमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2082219, "chapter_id": 2744, "verse_number": "१२-२४९-१७", "content_sanskrit": "एतैर्जितस्तु जयति सर्वाल्लोँकान्न संशयः।\nआचार्यो ब्रह्मलोकेशः प्राजापत्ये पिता प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2082220, "chapter_id": 2744, "verse_number": "१२-२४९-१८", "content_sanskrit": "अतिथिस्त्विन्द्रलोकस्य देवलोकस्य चर्त्विजः।\nजामयोऽप्सरसां लोके वैश्वदेवे तु ज्ञातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2082221, "chapter_id": 2744, "verse_number": "१२-२४९-१९", "content_sanskrit": "संबन्धिबान्धवा दिक्षु पृथिव्यां मातृमातुलौ।\nबृद्धबावातुरकृशास्त्वाकाशे प्रभविष्णवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2082222, "chapter_id": 2744, "verse_number": "१२-२४९-२०", "content_sanskrit": "भ्राता ज्येष्ठः समः पित्रा भार्या पुत्रः स्वका तनुः।\nछाया स्वा दासवर्गश्च दुहिता कृपणं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2082223, "chapter_id": 2744, "verse_number": "१२-२४९-२१", "content_sanskrit": "तस्मादेतैरधिक्षिप्तः सहेन्नित्यमसंज्वरः।\nगृहधर्मरतो विद्वान्धर्मनित्यो जितक्लमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2082224, "chapter_id": 2744, "verse_number": "१२-२४९-२२", "content_sanskrit": "न चार्थबद्धः कर्माणि धर्मं वा किंचिदाचरेत्।\nगृहस्थवृत्तयस्तिस्रस्तासां निःश्रेयसं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2082225, "chapter_id": 2744, "verse_number": "१२-२४९-२३", "content_sanskrit": "परंपरं तथैवाहुश्चातुराश्रम्यमेव तत्।\nये चोक्ता नियमास्तेषां सर्वं कार्यं बुभूषता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2082226, "chapter_id": 2744, "verse_number": "१२-२४९-२४", "content_sanskrit": "कुम्भधान्यैरुच्छशिलैः कापोतीं चास्थितास्तथा।\nयस्मिंश्चैते वसन्त्यर्हास्तद्राष्ट्रमभिवर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2082227, "chapter_id": 2744, "verse_number": "१२-२४९-२५", "content_sanskrit": "दश पूर्वान्दश परान्पुनाति च पितामहान्।\nगृहस्थवृत्तीश्चाप्येता वर्तयेद्यो गतव्यथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2082228, "chapter_id": 2744, "verse_number": "१२-२४९-२६", "content_sanskrit": "स चक्रधरलोकानां सदृशीमाप्नुयाद्गतिम्।\nवितेन्द्रियाणामथवा गतिरेषा विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2082229, "chapter_id": 2744, "verse_number": "१२-२४९-२७", "content_sanskrit": "सर्वलोको गृहस्थानामुदारमनसां हितः।\n-- विमानसंयुक्तो वेददृष्टः -----॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2082230, "chapter_id": 2744, "verse_number": "१२-२४९-२८", "content_sanskrit": "--लोको गृहस्थानां प्रतिष्ठा निवतात्मनान्।\nब्रह्मणा विहिता श्रेणिरेषा पस्पाद्विधीयते।\nद्वितीयं क्रमशः प्राप्य स्वर्गलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2082231, "chapter_id": 2744, "verse_number": "१२-२४९-२९", "content_sanskrit": "अतः परं परममुदारमाश्रम्\nतृतीयमाहुस्त्यजतां कलेवरम्।\nवनौकसां गृहपतिनामनुत्तमं\nशृणुष्व संश्लिष्टशरीरकारिणाम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2082232, "chapter_id": 2744, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकोनपञ्चाशदधिकद्विशततमोऽध्यायः॥ २४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]