[{"id": 2174718, "chapter_id": 4708, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2174719, "chapter_id": 4708, "verse_number": "१", "content_sanskrit": "पूर्वमेव यदा रामो युद्धे तस्मिन्नुपस्थिते ।\nआमन्त्र्य केशवं यातो वृष्णिभिः सहितः प्रभुः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2174720, "chapter_id": 4708, "verse_number": "", "content_sanskrit": "बलरामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2174721, "chapter_id": 4708, "verse_number": "२", "content_sanskrit": "साहाय्यं धार्तराष्ट्रस्य न चेत् कर्तास्मि केशव ।\nतथैव पाण्डुपुत्राणां गमिष्यामि यथातथम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2174722, "chapter_id": 4708, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2174723, "chapter_id": 4708, "verse_number": "३", "content_sanskrit": "एवमुक्त्वा तदा रामो यातः शत्रुनिषूदनः ।\nतस्य चागमनं भूयो ब्रह्मन् ब्रूह्यद्य मे प्रभो\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2174724, "chapter_id": 4708, "verse_number": "४", "content_sanskrit": "आख्याहि मे विस्तरतः कथं राम उपस्थितः ।\nकथं च दृष्टवान् युद्धं कुशलो ह्यसि वै द्विज\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2174725, "chapter_id": 4708, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2174726, "chapter_id": 4708, "verse_number": "५", "content_sanskrit": "उपप्लाव्ये निविष्टेषु पाण्डवेषु महात्मसु ।\nप्रेषितो धार्तराष्ट्रस्य समीपं मधुसूदनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2174727, "chapter_id": 4708, "verse_number": "६", "content_sanskrit": "शमं प्रति महाबाहो हितार्थं सर्वदेहिनाम् ।\nस गत्वा हस्तिनपुरं धृतराष्ट्रं समेत्य च\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2174728, "chapter_id": 4708, "verse_number": "७", "content_sanskrit": "उक्तवान् वचनं पथ्यं हितं चैव विशाम्पते ।\nन च तत् कृतवान् राजा यथाऽऽख्यातं हि ते पुरा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2174729, "chapter_id": 4708, "verse_number": "८", "content_sanskrit": "अनवाप्य शमं तत्र कृष्णः पुरुषसत्तमः ।\nआगच्छच्च महाबाहुरुपप्लाव्यं जनाधिप\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2174730, "chapter_id": 4708, "verse_number": "९", "content_sanskrit": "ततः प्रत्यागतः कृष्णो धृतराष्ट्रविसर्जितः ।\nआजगाम नरव्याघ्रः पाण्डवानामनीकिनीम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2174731, "chapter_id": 4708, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2174732, "chapter_id": 4708, "verse_number": "१०", "content_sanskrit": "न कुर्वन्ति वचो मह्यं कुरवः कालचोदिताः ।\nनिर्गच्छध्वं पाण्डवेयाः पुष्येण सहिता मया\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2174733, "chapter_id": 4708, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2174734, "chapter_id": 4708, "verse_number": "११", "content_sanskrit": "ततो विभज्यमानेषु बलेषु बलिनां वरः ।\nप्रोवाच भ्रातरं कृष्णं रौहिणेयः प्रतापवान्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2174735, "chapter_id": 4708, "verse_number": "१२", "content_sanskrit": "तेषामपि महाबाहो साहाय्यं मधुसूदन ।\nक्रियतामिति तत् कृष्णो नास्य चक्रे वचस्तदा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2174736, "chapter_id": 4708, "verse_number": "१३", "content_sanskrit": "ततो मन्युपरीतात्मा जगाम यदुनन्दनः ।\nतीर्थयात्रां हलधरः सरस्वत्यां महायशाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2174737, "chapter_id": 4708, "verse_number": "१४", "content_sanskrit": "मैत्रे नक्षत्रयोगे वै सहितः सर्वयादवैः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2174738, "chapter_id": 4708, "verse_number": "१५", "content_sanskrit": "आश्रयामास भोजस्तु दुर्योधनमरिन्दमम् ।\nयुयुधानेन सहितो वासुदेवश्च पाण्डवान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2174739, "chapter_id": 4708, "verse_number": "१६", "content_sanskrit": "रौहिणेये गते शूरे पुष्येण मधुसूदनः ।\nपाण्डवेयान् पुरस्कृत्य ययावभिमुखः कुरून्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2174740, "chapter_id": 4708, "verse_number": "१७", "content_sanskrit": "गच्छन्नेव पथिस्थस्तु रामः प्रेष्यानुवाच ह\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2174741, "chapter_id": 4708, "verse_number": "", "content_sanskrit": "बलरामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2174742, "chapter_id": 4708, "verse_number": "१८", "content_sanskrit": "सम्भारांस्तीर्थयात्रायाः सर्वोपकरणानि च ।\nआनयध्वं द्वारकाया अग्नीन् वै याजकांस्तथा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2174743, "chapter_id": 4708, "verse_number": "१९", "content_sanskrit": "सुवर्णं राजतं चैव धेनूर्वासांसि वाजिनः ।\nऋत्विजश्चानयध्वं वै शतशश्च द्विजर्षभान्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2174744, "chapter_id": 4708, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2174745, "chapter_id": 4708, "verse_number": "२०", "content_sanskrit": "एतं सन्दिश्य तु प्रेष्यान् बलदेवो महाबलः ।\nतीर्थयात्रां गतो रामः कुरूणां वैशसे तदा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2174746, "chapter_id": 4708, "verse_number": "२१", "content_sanskrit": "सरस्वत्याः प्रतिस्रोतः समुद्रादभिजग्मिवान् ।\nरामो यदूत्तमः श्रीमान् तीर्थयात्रामनुस्मरन्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2174747, "chapter_id": 4708, "verse_number": "२२", "content_sanskrit": "ऋत्विग्भिश्च सुहृद्भिश्च तथाऽन्यैर्द्विजसत्तमैः ।\nरथैर्नागैस्तथाऽश्वैश्च प्रेष्यैश्च भरतर्षभ\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2174748, "chapter_id": 4708, "verse_number": "२३", "content_sanskrit": "गोखरोष्ट्रप्रयुक्तैश्च यानैश्च बहुभिर्नृप ।\nश्रान्तानां क्लान्तमनसां शिशूनां विपुलायुषाम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2174749, "chapter_id": 4708, "verse_number": "२४", "content_sanskrit": "तानि यानानि देशेषु प्रतीक्षन्ते स्म भारत ।\nबुभुक्षितानामर्थाय क्लृप्तं राजन् समन्ततः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2174750, "chapter_id": 4708, "verse_number": "२५", "content_sanskrit": "यो यो यत्र द्विजो भोक्तुं कामं कामयते तदा ।\nतस्य तस्य तु तत्रैव उपजह्रुस्तथा नृप\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2174751, "chapter_id": 4708, "verse_number": "२६", "content_sanskrit": "यत्र स्थिता नरा राजन् रौहिणेयस्य शासनात् ।\nभक्ष्यपेयस्य कुर्वन्ति राशिं तत्र पृथक् पृथक्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2174752, "chapter_id": 4708, "verse_number": "२७", "content_sanskrit": "वासांसि च महार्हाणि पर्यङ्कास्तरणानि च ।\nपूजार्थं तत्र क्लृप्तानि विप्राणां सुखमिच्छताम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2174753, "chapter_id": 4708, "verse_number": "२८", "content_sanskrit": "यत्रैव सुषुपुर्विप्रा ये वा जाग्रति भारत ।\nतत्र तत्रैव सर्वस्य क्लृप्तं सर्वमदृश्यत\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2174754, "chapter_id": 4708, "verse_number": "२९", "content_sanskrit": "यथासुखं जनः सर्वः तिष्ठते च दिवानिशम् ।\nयातुकामस्य यानानि पानानि तृषितस्य च\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2174755, "chapter_id": 4708, "verse_number": "३०", "content_sanskrit": "बुभुक्षितस्य चान्नानि स्वादूनि भरतर्षभ\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2174756, "chapter_id": 4708, "verse_number": "३१", "content_sanskrit": "उपजह्रुर्नरास्तत्र वस्त्राण्याभरणानि च\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2174757, "chapter_id": 4708, "verse_number": "३२", "content_sanskrit": "स पन्थाः प्रववौ राजन् सर्वस्यैव सुखावहः ।\nस्वर्गोपमस्तदा राजन् नराणां तत्र गच्छताम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2174758, "chapter_id": 4708, "verse_number": "३३", "content_sanskrit": "नित्यप्रमुदितोपेतः स्वादुभक्षजलान्वितः ।\nविपणापणपण्यैश्च नानाजनपदैर्वृतः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2174759, "chapter_id": 4708, "verse_number": "३४", "content_sanskrit": "नानाद्रुमलतोपेतो नानारत्नविभूषितः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2174760, "chapter_id": 4708, "verse_number": "३५", "content_sanskrit": "ततो महात्मा नियमे स्थितात्मा\nपुण्येषु तीर्थेषु वसूनि राजन् ।\nददौ द्विजेभ्यः क्रतुदक्षिणां च\nयदुप्रवीरो हलधृक् प्रतीतः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2174761, "chapter_id": 4708, "verse_number": "३६", "content_sanskrit": "दोग्ध्रीश्च धेनूश्च सहस्रशो वै\nसुवाससः काञ्चनबद्धशृङ्गाः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2174762, "chapter_id": 4708, "verse_number": "३७", "content_sanskrit": "(हयांश्च नानाविधदेशजातान्\nयानानि दासीश्च शुचीर्द्विजेभ्यः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2174763, "chapter_id": 4708, "verse_number": "३८", "content_sanskrit": "रत्नानि मुक्तामणिविद्रुमांश्च\nशङ्गीसुवर्णं रजतं च शुद्धम् ।\nअयोमयं ताम्रमयं च भाण्डं\nददौ द्विजातिप्रवरेषु रामः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2174764, "chapter_id": 4708, "verse_number": "", "content_sanskrit": "एवं स वित्तं प्रददौ महात्मा\nसरस्वतीतीर्थगतेषु भूरि\t॥३९॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2174765, "chapter_id": 4708, "verse_number": "४०", "content_sanskrit": "ययौ क्रमेणाप्रतिमप्रभावः\nततः कुरुक्षेत्रमुदारवृत्तः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2174766, "chapter_id": 4708, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2174767, "chapter_id": 4708, "verse_number": "४१", "content_sanskrit": "सारस्वतीनां तीर्थानां गुणोत्पत्तिं वदस्व मे ।\nफलं च द्विपदां श्रेष्ठ निवृत्तिमपि कर्मणाम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2174768, "chapter_id": 4708, "verse_number": "४२", "content_sanskrit": "यथाक्रमं च भगवन् तीर्थानामनुपूर्वशः ।\nब्रूहि ब्रह्मविदां श्रेष्ठ परं कौतूहलं हि मे\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2174769, "chapter_id": 4708, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2174770, "chapter_id": 4708, "verse_number": "४३", "content_sanskrit": "तीर्थानां विस्तरं राजन् गुणोत्पत्तिं च सर्वशः ।\nमयोच्यमानां शृणु मे पुण्यां राजेन्द्र पावनीम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2174771, "chapter_id": 4708, "verse_number": "४४", "content_sanskrit": "पूर्वं महाराज यदुप्रवीर\nऋत्विक्सुहृद्विप्रगणैश्च सार्धम् ।\nपुण्यं प्रभासं समुपाजगाम\nयत्रोडुराड्यक्ष्मणा क्षीयमाणः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2174772, "chapter_id": 4708, "verse_number": "४५", "content_sanskrit": "विमुक्तशापः पुनरात्ततेजाः\nसर्वं जगद्भासयते नरेन्द्र\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2174773, "chapter_id": 4708, "verse_number": "४६", "content_sanskrit": "एतत्तु तीर्थप्रवरं पृथिव्यां\nप्रभासनात् तस्य ततः प्रभासः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2174774, "chapter_id": 4708, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2174775, "chapter_id": 4708, "verse_number": "४७", "content_sanskrit": "किमर्थं भगवान् सोमो यक्ष्मणा पर्यगृह्यत ।\nकथं च तीर्थप्रवरे तस्मिंश्चन्द्रो न्यमज्जत\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2174776, "chapter_id": 4708, "verse_number": "४८", "content_sanskrit": "कथमाप्लुत्य तस्मिंश्च पुनराप्यायितः शशी ।\nएतन्मे सर्वमाचक्ष्व विस्तरेण महामुने\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2174777, "chapter_id": 4708, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2174778, "chapter_id": 4708, "verse_number": "४९", "content_sanskrit": "दक्षस्य तनया राजन् प्रादुरासन् विशाम्पते ।\nसप्तविंशत्तु ताः कन्याः सोमाय प्रददौ प्रभुः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2174779, "chapter_id": 4708, "verse_number": "५०", "content_sanskrit": "नक्षत्रयोगनिरताः सङ्ख्यानार्थं च ता भवन् ।\nपत्न्यो वै तस्य राजेन्द्र सोमस्य शुभकर्मणः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2174780, "chapter_id": 4708, "verse_number": "५१", "content_sanskrit": "तास्तु सर्वा विशालाक्ष्यो रूपेणाप्रतिमा भवन् ।\nअत्यरिच्यत तासां तु रोहिणी रूपसम्पदा\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2174781, "chapter_id": 4708, "verse_number": "५२", "content_sanskrit": "ततस्तस्यां स भगवान् प्रीतिं चक्रे निशाकरः ।\nसाऽस्य हृद्या बभूवाथ तस्मात् तां भजते सदा\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2174782, "chapter_id": 4708, "verse_number": "५३", "content_sanskrit": "शशी पुरा हि राजेन्द्र रोहिण्यामवसच्चिरम् ।\nततोऽस्मै कुपितान्यासन् नक्षत्राणि महात्मने\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2174783, "chapter_id": 4708, "verse_number": "५४", "content_sanskrit": "ता गत्वा पितरं प्राहुः प्रजापतिमनिन्दिताः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2174784, "chapter_id": 4708, "verse_number": "", "content_sanskrit": "तारकाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2174785, "chapter_id": 4708, "verse_number": "५५", "content_sanskrit": "सोमो वसति नास्मासु रोहिण्यां वसते सदा\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2174786, "chapter_id": 4708, "verse_number": "५६", "content_sanskrit": "ता वयं सहिताः सर्वाः त्वत्सकाशं प्रजेश्वर ।\nवत्स्यामो नियताहाराः तपश्चरणतत्पराः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2174787, "chapter_id": 4708, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2174788, "chapter_id": 4708, "verse_number": "५७", "content_sanskrit": "श्रुत्वा तु वचनं तासां दक्षः सोममथाब्रवीत्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2174789, "chapter_id": 4708, "verse_number": "", "content_sanskrit": "दक्षः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2174790, "chapter_id": 4708, "verse_number": "५८", "content_sanskrit": "सोम वर्तस्व सर्वासु मा त्वाऽधर्मो महान् स्पृशेत्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2174791, "chapter_id": 4708, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2174792, "chapter_id": 4708, "verse_number": "५९", "content_sanskrit": "ताः सर्वाश्चाब्रवीद् दक्षो गच्छध्वं सोममन्तिकम् ।\nसमं वत्स्यति सर्वासु चन्द्रमा मम शासनात्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2174793, "chapter_id": 4708, "verse_number": "६०", "content_sanskrit": "विसृष्टास्तास्तदा जग्मुः शीतांशोर्भवनं प्रति\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2174794, "chapter_id": 4708, "verse_number": "६१", "content_sanskrit": "ततस्तु सोमो भगवान् पुनरेव महीपते ।\nरोहिण्या सार्धमवसत् प्रीयमाणो मुहुर्मुहुः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2174795, "chapter_id": 4708, "verse_number": "६२", "content_sanskrit": "ततस्ताः सहिताः सर्वा भूयः पितरमब्रुवन्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2174796, "chapter_id": 4708, "verse_number": "", "content_sanskrit": "नक्षत्राणि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2174797, "chapter_id": 4708, "verse_number": "६३", "content_sanskrit": "सोमो वसति नास्मासु नाकरोद् वचनं तव ।\nतव शिश्रूषणे युक्ता वत्स्यामो हि तवाग्रतः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2174798, "chapter_id": 4708, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2174799, "chapter_id": 4708, "verse_number": "६४", "content_sanskrit": "तासां तु वचनं श्रुत्वा दक्षः सोममथाब्रवीत्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2174800, "chapter_id": 4708, "verse_number": "", "content_sanskrit": "दक्षः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2174801, "chapter_id": 4708, "verse_number": "६५", "content_sanskrit": "समं वर्तस्व सर्वासु मा स्म शप्स्ये ह चन्द्रमाः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2174802, "chapter_id": 4708, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2174803, "chapter_id": 4708, "verse_number": "६६", "content_sanskrit": "अनादृत्य तु तद्वाक्यं दक्षस्य भगवान् शशी ।\nरोहिण्या सार्धमवसत् ततस्ताः कुपिताः पुनः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2174804, "chapter_id": 4708, "verse_number": "६७", "content_sanskrit": "गत्वा च वचनं प्राहुः शिरोभिः प्रणतास्तदा\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2174805, "chapter_id": 4708, "verse_number": "", "content_sanskrit": "नक्षत्राणि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2174806, "chapter_id": 4708, "verse_number": "६८", "content_sanskrit": "सोमो वसति नास्मासु तस्मान्नः शरणं भव ।\nरोहिण्यामेव भगवान् सदा वसति चन्द्रमाः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2174807, "chapter_id": 4708, "verse_number": "६९", "content_sanskrit": "तस्मान्नस्त्राहि सर्वा वै यथा नः सोम आविशेत्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2174808, "chapter_id": 4708, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2174809, "chapter_id": 4708, "verse_number": "७०", "content_sanskrit": "तच्छ्रुत्वा भगवान् क्रुद्धो यक्ष्माणं पृथिवीपते ।\nससर्ज रोषात् सोमाय स चोडुपतिमाविशत्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2174810, "chapter_id": 4708, "verse_number": "७१", "content_sanskrit": "स यक्ष्माणाऽभिभूतः सन् क्षीयतेऽहरहः शशी\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2174811, "chapter_id": 4708, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि षष्ठोऽध्यायः ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}]