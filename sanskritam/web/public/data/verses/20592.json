[{"id": 7000592000, "chapter_id": 20592, "verse_number": "५-५१-१", "content_sanskrit": "शेष उवाच ।\nतच्छ्रुत्वा भाषितं तस्य सुरथस्यांगदाननात् ।\nसज्जीभूता रणे सर्वे रथस्था रणकोविदाः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000592001, "chapter_id": 20592, "verse_number": "५-५१-२", "content_sanskrit": "पटहानां निनादोऽभूद्भेरीनादस्तथैव च ।\nवीराणां गर्जनानादाः प्रादुर्भूता रणांगणे॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000592002, "chapter_id": 20592, "verse_number": "५-५१-३", "content_sanskrit": "रथचीत्कारशब्देन गजानां बृंहितेन च ।\nव्याप्तं तत्सकलं विश्वं दिवं यातो महारवः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000592003, "chapter_id": 20592, "verse_number": "५-५१-४", "content_sanskrit": "रणोत्साहेन संयुक्ता वीरा रणविशारदाः ।\nकुर्वंति विविधान्नादान्कातरस्य भयंकरान्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000592004, "chapter_id": 20592, "verse_number": "५-५१-५", "content_sanskrit": "एवं कोलाहले वृत्ते सुरथो नाम भूमिपः ।\nस्वसुतैः सैनिकैश्चाथ वृतः प्रायाद्रणांगणे॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000592005, "chapter_id": 20592, "verse_number": "५-५१-६", "content_sanskrit": "गजैरथैर्हयैः पत्तिव्रजैः पूर्णां तु मेदिनीम् ।\nकुर्वन्समुद्रैव तां प्लावयन्ददृशे भटैः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000592006, "chapter_id": 20592, "verse_number": "५-५१-७", "content_sanskrit": "शंखनादेन संघुष्टं जयनादैस्तथैव च ।\nवीक्ष्य तं प्रधनोद्युक्तं सुमतिं प्राह भूमिपः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000592007, "chapter_id": 20592, "verse_number": "५-५१-८", "content_sanskrit": "शत्रुघ्न उवाच ।\nएष राजा समायातो महासैन्यपरीवृतः ।\nअत्र यत्कृत्यमस्माकं तद्वदस्व महामते॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000592008, "chapter_id": 20592, "verse_number": "५-५१-९", "content_sanskrit": "सुमतिरुवाच ।\nयोद्धव्यमत्र बहुभिर्वीरै रणविशारदैः ।\nपुष्कलादिभिरत्युग्रैः सर्वशस्त्रास्त्रकोविदैः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000592009, "chapter_id": 20592, "verse_number": "५-५१-१०", "content_sanskrit": "राज्ञा सह समीरस्य पुत्रः परमशौर्यवान् ।\nयुद्धं करोतु सुबलः परयुद्धविशारदः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000592010, "chapter_id": 20592, "verse_number": "५-५१-११", "content_sanskrit": "शेष उवाच ।\nइति ब्रूते महामात्यो यावत्तावन्नृपात्मजाः ।\nरणांगणे धनूंष्यद्धा स्फारयामासुरुद्धताः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000592011, "chapter_id": 20592, "verse_number": "५-५१-१२", "content_sanskrit": "तान्वीक्ष्य योधाः सुबलाः पुष्कलाद्या रणोत्कटाः ।\nअभिजग्मुः स्यंदनैः स्वैर्धनुर्बाणकरा मताः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000592012, "chapter_id": 20592, "verse_number": "५-५१-१३", "content_sanskrit": "चंपकेन महावीरः पुष्कलः परमास्त्रवित् ।\nद्वैरथेनैव युयुधे महावीरेण शालिना॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000592013, "chapter_id": 20592, "verse_number": "५-५१-१४", "content_sanskrit": "मोहकं योधयामास जानकिः स कुशध्वजः ।\nरिपुंजयेन विमलो दुर्वारेण सुबाहुकः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000592014, "chapter_id": 20592, "verse_number": "५-५१-१५", "content_sanskrit": "प्रतापिना प्रतापाग्र्यो बलमोदेन चांगदः ।\nहर्यक्षेण नीलरत्नः सहदेवेन सत्यवान्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000592015, "chapter_id": 20592, "verse_number": "५-५१-१६", "content_sanskrit": "राजा वीरमणिर्भूरि देवेन युयुधे बली ।\nअसुतापेन चोग्राश्वो युयुधे बलसंयुतः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000592016, "chapter_id": 20592, "verse_number": "५-५१-१७", "content_sanskrit": "द्वैरथं तु महद्युद्धमकुर्वन्युद्धकोविदाः ।\nसर्वे शस्त्रास्त्रकुशलाः सर्वे युद्धविशारदाः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000592017, "chapter_id": 20592, "verse_number": "५-५१-१८", "content_sanskrit": "एवं प्रवृत्ते संग्रामे सुरथस्य सुतैस्तदा ।\nअत्यंतं कदनं तत्र बभूव मुनिसत्तम॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000592018, "chapter_id": 20592, "verse_number": "५-५१-१९", "content_sanskrit": "पुष्कलश्चंपकं प्राह किं नामासि नृपात्मज ।\nधन्योसि यो मया सार्धं रणमध्यमुपेयिवान्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000592019, "chapter_id": 20592, "verse_number": "५-५१-२०", "content_sanskrit": "इदानीं तिष्ठ किं यासि कथं ते जीवितं भवेत् ।\nएहि युद्धं मया सार्धं सर्वशस्त्रास्त्रकोविद॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000592020, "chapter_id": 20592, "verse_number": "५-५१-२१", "content_sanskrit": "इत्यभिव्याहृतं तस्य श्रुत्वा राजात्मजो बली ।\nजगाद पुष्कलं वीरो मेघगंभीरया गिरा॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000592021, "chapter_id": 20592, "verse_number": "५-५१-२२", "content_sanskrit": "चंपक उवाच ।\nन नाम्ना न कुलेनेदं युद्धमत्र भविष्यति ।\nतथापि तव वक्ष्येऽहं स्वनामबलपूर्वकम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000592022, "chapter_id": 20592, "verse_number": "५-५१-२३", "content_sanskrit": "मम माता राघवेशो मत्पिता राघवः स्मृतः ।\nमम बंधू रामचंद्र स्वःजनो मम राघवः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000592023, "chapter_id": 20592, "verse_number": "५-५१-२४", "content_sanskrit": "मन्नाम रामदासश्च सदा रामस्य सेवकः ।\nतारयिष्यति मां युद्धे रामो भक्तकृपाकरः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000592024, "chapter_id": 20592, "verse_number": "५-५१-२५", "content_sanskrit": "लोकानां मतमास्थाय प्रब्रवीमि तवाधुना ।\nसुरथस्य सुतश्चाहं माता वीरवतीमम॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000592025, "chapter_id": 20592, "verse_number": "५-५१-२६", "content_sanskrit": "मन्नामयो मधौ सर्वाञ्छोभनान्विदधाति वै ।\nमधुपायंरसावा संत्यजंति मधुमोहिताः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000592026, "chapter_id": 20592, "verse_number": "५-५१-२७", "content_sanskrit": "वर्णेन स्वर्णसदृशो मध्ये लिंगवपुर्धरः ।\nतदाख्ययाभिधां वीर जानीहि मम मोहिनीम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000592027, "chapter_id": 20592, "verse_number": "५-५१-२८", "content_sanskrit": "युध्यस्व बाणैः प्रधनेन को जेतुं हि मां क्षमः ।\nइदानीं दर्शयिष्यामि स्वपराक्रममद्भुतम्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000592028, "chapter_id": 20592, "verse_number": "५-५१-२९", "content_sanskrit": "शेष उवाच ।\nइति श्रुत्वा महद्वाक्यं पुष्कलो हृदि तोषितः ।\nतं दुर्जयं मन्यमानः शरान्मुंचन्रणेऽभवत्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000592029, "chapter_id": 20592, "verse_number": "५-५१-३०", "content_sanskrit": "शरसंघं प्रमुंचंतं कोटिधा पुष्कलं ययौ ।\nचंपकः कोपसंयुक्तो धनुः सज्यमथाकरोत्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000592030, "chapter_id": 20592, "verse_number": "५-५१-३१", "content_sanskrit": "मुमोच निशितान्बाणान्वैरिवृंदविदारणान् ।\nस्वनामचिह्नितान्स्वर्णपुंखभागसमन्वितान्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000592031, "chapter_id": 20592, "verse_number": "५-५१-३२", "content_sanskrit": "तांश्चिच्छेद महावीरः पुष्कलः प्रधनांगणे ।\nशरांधकारं सर्वत्र मुंचन्बाणाञ्छिलाशितान्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000592032, "chapter_id": 20592, "verse_number": "५-५१-३३", "content_sanskrit": "स्वबाणच्छेदनं दृष्ट्वा कृतं वीरेण चंपकः ।\nआह्वयामास बलिनं पुष्कलं कोपपूरितः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000592033, "chapter_id": 20592, "verse_number": "५-५१-३४", "content_sanskrit": "मा प्रयाहि रणं त्यक्त्वेति ब्रुवन्समरे पुनः ।\nपुष्कलं हृदये बाणैर्विव्याध दशभिस्त्वरन्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000592034, "chapter_id": 20592, "verse_number": "५-५१-३५", "content_sanskrit": "ते बाणाः पुष्कलस्याहो हृदये तीव्रवेगिनः ।\nआगत्य सुभृशं लग्नाः शोणितं पपुरूर्जितम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000592035, "chapter_id": 20592, "verse_number": "५-५१-३६", "content_sanskrit": "तैर्बाणैर्व्यथितो वीरः शरान्पंच समाददे ।\nसुतीक्ष्णाग्रान्महाकोपाद्वारयन्पर्वतानिव॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000592036, "chapter_id": 20592, "verse_number": "५-५१-३७", "content_sanskrit": "ते बाणास्तस्य बाणाश्च परस्परमथोर्जिताः ।\nआकाशे रचिताश्छिन्नाः शतधा राजसूनुना॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000592037, "chapter_id": 20592, "verse_number": "५-५१-३८", "content_sanskrit": "छित्त्वा बाणान्सुतीक्ष्णाग्रान्सुरथांगोद्भवो बली ।\nबाणाञ्छतं समाधत्त पुष्कलं ताडितुं हृदि॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000592038, "chapter_id": 20592, "verse_number": "५-५१-३९", "content_sanskrit": "ते बाणाः शतधाच्छिन्नाः पुष्कलेन महात्मना ।\nअपतन्समरोपांते शरवेगप्रपीडिताः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000592039, "chapter_id": 20592, "verse_number": "५-५१-४०", "content_sanskrit": "तदा तत्सुमहत्कर्म दृष्ट्वा राज्ञः सुतो बली ।\nसहस्रेण शराणां च ताडयन्वक्षसि स्फुटम्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000592040, "chapter_id": 20592, "verse_number": "५-५१-४१", "content_sanskrit": "तानप्याशु प्रचिच्छेद पुष्कलः परमास्त्रवित् ।\nपुनरप्याशु स्वे चापे समाधत्तायुतं शरान्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000592041, "chapter_id": 20592, "verse_number": "५-५१-४२", "content_sanskrit": "तानप्याशु प्रचिच्छेद पुष्कलः परमास्त्रवित् ।\nततोऽत्यतं प्रकुपितः शरवृष्टिमथाकरोत्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000592042, "chapter_id": 20592, "verse_number": "५-५१-४३", "content_sanskrit": "शरवृष्टिं समायांतीं मत्वा चंपक वीरहा ।\nसाधुसाधुप्रशंसंतं पुष्कलं समताडयत्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000592043, "chapter_id": 20592, "verse_number": "५-५१-४४", "content_sanskrit": "पुष्कलश्चंपकं दृष्ट्वा महावीर्यसमन्वितम् ।\nब्रह्मणोऽस्त्रसमाधत्त स्वे चापे सर्वशस्त्रवित्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000592044, "chapter_id": 20592, "verse_number": "५-५१-४५", "content_sanskrit": "तेन मुक्तं महाशस्त्रं प्रजज्वाल दिशो दश ।\nखं रोदसी व्याप्य विश्वं प्रलयं कर्तुमुद्यतम्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000592045, "chapter_id": 20592, "verse_number": "५-५१-४६", "content_sanskrit": "चंपको मुक्तमस्त्रं तद्दृष्ट्वा सर्वास्त्रकोविदः ।\nतत्संहर्तुं तदेवास्त्रं मुमोच रिपुमुद्यतम्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000592046, "chapter_id": 20592, "verse_number": "५-५१-४७", "content_sanskrit": "द्वयोरेकतमं तेजः प्रलयं मेनिरे जनाः ।\nसंजहार तदास्त्रास्त्रमेकीभूतं परास्त्रकम्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000592047, "chapter_id": 20592, "verse_number": "५-५१-४८", "content_sanskrit": "तत्कर्मचाद्भुतं दृष्ट्वा पुष्कलस्तिष्ठतिष्ठ च ।\nब्रुवञ्छरानमोघांस्तु चंपकं स क्रुधाहनत्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000592048, "chapter_id": 20592, "verse_number": "५-५१-४९", "content_sanskrit": "चंपकस्ताञ्छरान्मुक्तानगणय्य महामनाः ।\nरामास्त्रं प्रमुमोचाथ पुष्कलं प्रति दारुणम्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000592049, "chapter_id": 20592, "verse_number": "५-५१-५०", "content_sanskrit": "तन्मुक्तमस्त्रमालोक्य चंपकेन महात्मना ।\nछेत्तुं यावन्मनश्चक्रे तावद्ग्रस्तः शरेण सः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000592050, "chapter_id": 20592, "verse_number": "५-५१-५१", "content_sanskrit": "बद्धश्चंपकवीरेण रथे स्वे स्थापितः पुनः ।\nपुरं प्रेषयितुं तावन्मनश्चक्रे महामनाः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000592051, "chapter_id": 20592, "verse_number": "५-५१-५२", "content_sanskrit": "हाहाकारो महानासीद्बद्धे पुष्कलसंज्ञिके ।\nशत्रुघ्नं प्रययुर्योधाः पलायनपरायणाः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000592052, "chapter_id": 20592, "verse_number": "५-५१-५३", "content_sanskrit": "भग्नांस्तान्वीक्ष्य शत्रुघ्नो हनूमंतमुवाच ह ।\nकेन वीरेण मे भग्नं बलं वीरैरलंकृतम्॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000592053, "chapter_id": 20592, "verse_number": "५-५१-५४", "content_sanskrit": "तदोवाच महीनाथ पुष्कलं परवीरहा ।\nबद्ध्वा नयति वीरोऽसौ चंपकः स्वपदोद्धुरः॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000592054, "chapter_id": 20592, "verse_number": "५-५१-५५", "content_sanskrit": "तस्येदृग्वाक्यमाकर्ण्य शत्रुघ्नः कोपसंयुतः ।\nउवाच पवनोद्भूतं मोचयाशु नृपात्मजात्॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000592055, "chapter_id": 20592, "verse_number": "५-५१-५६", "content_sanskrit": "महाबलः सुतश्चास्य बद्ध्वा यः पुष्कलं भटम् ।\nतस्मान्मोचय वीराग्र्य कथं तिष्ठसि चाहवे॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000592056, "chapter_id": 20592, "verse_number": "५-५१-५७", "content_sanskrit": "एतद्वाक्यं समाकर्ण्य हनूमानोमिति ब्रुवन् ।\nजगाम तं मोचयितुं पुष्कलं चंपकाद्भटात्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000592057, "chapter_id": 20592, "verse_number": "५-५१-५८", "content_sanskrit": "हनूमंतमथालोक्य तं मोचयितुमागतम् ।\nबाणैः शतैश्च साहस्रैर्जघान परकोपनः॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000592058, "chapter_id": 20592, "verse_number": "५-५१-५९", "content_sanskrit": "बाणांस्तान्स बभंजाशु मुक्तांस्तेन महात्मना ।\nपुनरप्येनमेवाशु बाणान्मुंचन्महानभूत्॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000592059, "chapter_id": 20592, "verse_number": "५-५१-६०", "content_sanskrit": "तान्सर्वांश्चूर्णयामास नाराचान्वैरिमोचितान् ।\nशालं करे समाधृत्य जघान नृपनंदनम्॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000592060, "chapter_id": 20592, "verse_number": "५-५१-६१", "content_sanskrit": "शालं तेन विनिर्मुक्तं तिलशः कृतवान्बली ।\nगजो हनूमता मुक्तो नृपनंदन मस्तके॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000592061, "chapter_id": 20592, "verse_number": "५-५१-६२", "content_sanskrit": "सोऽप्याहतश्चंपकेन मृतो भूमौ पपातसः ।\nशिलाः संमोचयामास हनूमान्परमास्त्रवित्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000592062, "chapter_id": 20592, "verse_number": "५-५१-६३", "content_sanskrit": "चंपकस्ताः शिलाः सर्वाः क्षणाच्चूर्णितवान्भृशम् ।\nबाणयंत्रिकया ब्रह्मन्महच्चित्रमभूदिदम्॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000592063, "chapter_id": 20592, "verse_number": "५-५१-६४", "content_sanskrit": "स्वमुक्तास्ताः शिलाः सर्वाश्चूर्णिता वीक्ष्य मारुतिः ।\nचुकोप हृदयेऽत्यतं बहुवीर्यमिति स्मरन्॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000592064, "chapter_id": 20592, "verse_number": "५-५१-६५", "content_sanskrit": "आगत्य च करे धृत्वा नभस्युत्पतितः कपिः ।\nतावद्ययौ नेत्रपथादुपरि क्षिप्रवेगवान्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000592065, "chapter_id": 20592, "verse_number": "५-५१-६६", "content_sanskrit": "चंपकस्तं हनूमंतं युयुधे नभसि स्थितः ।\nबाहुयुद्धेन महता ताडितः कपिपुंगवः॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000592066, "chapter_id": 20592, "verse_number": "५-५१-६७", "content_sanskrit": "चुकोप मानसे वीरो गर्वपर्वतदारुणः ।\nपदा धृत्वा चंपकं तं ताडयामास भूतले॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000592067, "chapter_id": 20592, "verse_number": "५-५१-६८", "content_sanskrit": "ताडितोऽसौ कपींद्रेण क्षणादुत्थाय वेगवान् ।\nहनूमंतं तु लांगूले धृत्वा बभ्राम सर्वतः॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000592068, "chapter_id": 20592, "verse_number": "५-५१-६९", "content_sanskrit": "कपींद्रस्तद्बलं वीक्ष्य हसन्पादेऽग्रहीत्पुनः ।\nभ्रामयित्वा शतगुणं गजोपस्थे ह्यपातयत्॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000592069, "chapter_id": 20592, "verse_number": "५-५१-७०", "content_sanskrit": "पपात भूमौ सुबलो राजसूनुः स चंपकः ।\nमूर्च्छितो वीरभूषाढ्यमलंकुर्वन्रणांगणम्॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000592070, "chapter_id": 20592, "verse_number": "५-५१-७१", "content_sanskrit": "तदा हाहेति वै लोकाश्चुक्रुशुश्चंपकानुगाः ।\nपुष्कलं मोचयामास बद्धं चंपकपाशतः॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]