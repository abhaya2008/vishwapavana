[{"id": 7000641000, "chapter_id": 20641, "verse_number": "५-१००-१", "content_sanskrit": "श्रीराजोवाच ।\nक्षीरोदजलतुल्याभिः शीतलामलदृष्टिभिः ।\nतथ्याभिश्च विचित्राभिस्त्वया गीर्भिः प्रबोधितः ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000641001, "chapter_id": 20641, "verse_number": "५-१००-२", "content_sanskrit": "असागरोत्थं पीयूषमद्रव्यं व्यसनौषधम् ।\nत्वयाहं पायितः सौम्य भवरोगनिवारणम् ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000641002, "chapter_id": 20641, "verse_number": "५-१००-३", "content_sanskrit": "हर्षप्रदो नृणां पापहानिकृज्जीवनौषधम् ।\nजरामृत्युहरो विप्र सद्भिः किल समागमः ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000641003, "chapter_id": 20641, "verse_number": "५-१००-४", "content_sanskrit": "यानि यानि दुरापानि वांछितानि महीतले ।\nप्राप्यंते तानि तान्येव साधूनामेव संगमात् ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000641004, "chapter_id": 20641, "verse_number": "५-१००-५", "content_sanskrit": "यः स्नातः पापहरया साधुसंगम गंगया ।\nकिं तस्य दानैः किं तीर्थैः किं तपोभिः किमध्वरैः ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000641005, "chapter_id": 20641, "verse_number": "५-१००-६", "content_sanskrit": "निमज्ज्योन्मज्जतान्नॄणां भवाब्धौ परमायनम् ।\nसंतो धर्मविदः शांता नौर्दृढे वाप्सुमज्जताम् ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000641006, "chapter_id": 20641, "verse_number": "५-१००-७", "content_sanskrit": "यो मे भावःपुरा ह्यासीत्कामैकसुखलालसः ।\nदर्शनाद्वचनात्तेऽद्य विपरीतोऽभवद्विभो ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000641007, "chapter_id": 20641, "verse_number": "५-१००-८", "content_sanskrit": "एकजन्मसुखस्यार्थे सहस्राणि विलोपयेत् ।\nप्राज्ञो जन्मसहस्राणि संचिनोत्येकजन्मना ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000641008, "chapter_id": 20641, "verse_number": "५-१००-९", "content_sanskrit": "हाहा कामरसास्वाद सुखलालसचेतसा ।\nमया मूढेन न कृतं किंचिदात्महितं द्विज ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000641009, "chapter_id": 20641, "verse_number": "५-१००-१०", "content_sanskrit": "अहो मे मनसो मोहो येनात्मा योषितां कृते ।\nपातितो व्यसने घोरे दुःखोदर्के दुरत्यये ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000641010, "chapter_id": 20641, "verse_number": "५-१००-११", "content_sanskrit": "भगवन्परितुष्टोऽस्मि बोधितो वचनेन ते ।\nउपदेशप्रदानेन मामुद्धर्तुमिहार्हसि ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000641011, "chapter_id": 20641, "verse_number": "५-१००-१२", "content_sanskrit": "पुरा चरितपुण्योऽहं भवता बोधितोऽस्मि यत् ।\nत्वत्पादरजसा वापि विशेषादपि पावितः ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000641012, "chapter_id": 20641, "verse_number": "५-१००-१३", "content_sanskrit": "विधिं माधवमासस्य ब्रूहि मे वदतां वर ।\nसर्वपापक्षयकरो यस्त्वया परिकीर्तितः ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000641013, "chapter_id": 20641, "verse_number": "५-१००-१४", "content_sanskrit": "किं दानं तत्र किं स्नानं को देवो नियमास्तु के ।\nएतदाचक्ष्व विप्रर्षे दुरितोत्तारणाय मे ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000641014, "chapter_id": 20641, "verse_number": "५-१००-१५", "content_sanskrit": "यम उवाच ।\nइत्येवमुक्तो भगवान्कश्यपः स दयानिधिः ।\nप्रोवाच वचनं विप्र धर्म्यं विश्वहितं शुभम् ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000641015, "chapter_id": 20641, "verse_number": "५-१००-१६", "content_sanskrit": "कश्यप उवाच ।\nपूर्वापरसमाधान क्षमबुद्ध्या च ते नृप ।\nपृष्टं प्राज्ञे न वक्तव्यं नाधमे पापमानसे ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000641016, "chapter_id": 20641, "verse_number": "५-१००-१७", "content_sanskrit": "पापप्रवृत्तस्य तथा दत्वा भूप शुभां मतिम् ।\nविद्यादानफलं सम्यक्प्राप्यते नात्र संशयः ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000641017, "chapter_id": 20641, "verse_number": "५-१००-१८", "content_sanskrit": "नापृष्टः कस्यचिद्ब्रूयान्न चान्यायेन पृच्छतः ।\nजानन्नपि हि मेधावी जडवल्लोकमाचरेत् ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000641018, "chapter_id": 20641, "verse_number": "५-१००-१९", "content_sanskrit": "विदुषामपि शिष्याणां पुत्राणां च क्रियावताम् ।\nअपृष्टमपि वक्तव्यं श्रेयः श्रद्धावतां हितम् ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000641019, "chapter_id": 20641, "verse_number": "५-१००-२०", "content_sanskrit": "सांप्रतं शुद्धहृदयो जातस्त्वं वचनान्मम ।\nपुराचरितपुण्येन केनापि च महीपते ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000641020, "chapter_id": 20641, "verse_number": "५-१००-२१", "content_sanskrit": "पापावस्थं शरीरं तद्गतं तव ममाश्रयात् ।\nश्रवणाद्धर्मशास्त्रस्य धर्मावस्थं तु तेऽभवत् ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000641021, "chapter_id": 20641, "verse_number": "५-१००-२२", "content_sanskrit": "पापावस्थमधर्माख्यं धर्मज्ञानविवर्जितम् ।\nअपरं सद्व्रतं यद्धि विज्ञेयं तद्धि धार्मिकम् ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000641022, "chapter_id": 20641, "verse_number": "५-१००-२३", "content_sanskrit": "धर्माधर्मोपभोगाय तत्तृतीयमतींद्रियम् ।\nतत्त्रिभेदं शरीरं हि धर्म्मविद्भिरिहोच्यते ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000641023, "chapter_id": 20641, "verse_number": "५-१००-२४", "content_sanskrit": "यावता धर्मभोगश्च मुक्तिश्चैतत्त्रिभेदकम् ।\nपापावस्थं शरीरं तत्पापसंज्ञं तदुच्यते ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000641024, "chapter_id": 20641, "verse_number": "५-१००-२५", "content_sanskrit": "इदानीं गुरुभक्तिं च कुर्वतश्च वचो मम ।\nशृण्वतो धर्मरूपं तु शरीरं ते व्यवस्थितम् ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000641025, "chapter_id": 20641, "verse_number": "५-१००-२६", "content_sanskrit": "तेनैव शुद्धिरमला जाता धर्मक्रियोचिता ।\nदैवेन देहिनां नाम चेतांसि चरितानि च ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000641026, "chapter_id": 20641, "verse_number": "५-१००-२७", "content_sanskrit": "शरीराणि च पुष्यंति कालेकाले विपर्ययम् ।\nसांप्रतं भवतश्चेतो नूनं धर्मे प्रवर्तते ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000641027, "chapter_id": 20641, "verse_number": "५-१००-२८", "content_sanskrit": "तेन त्वां कारयिष्यामि माधवस्नानमुत्तमम् ।\nयम उवाच ।\nततस्तु कारितस्तेन कश्यपेन पुरोधसा ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000641028, "chapter_id": 20641, "verse_number": "५-१००-२९", "content_sanskrit": "स नृपो माधवे मासि स्नानं दानं च पूजनम् ।\nयथादृष्टं पुरा शास्त्रे वैशाखस्नानजं विधिम् ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000641029, "chapter_id": 20641, "verse_number": "५-१००-३०", "content_sanskrit": "स मुनिः प्रत्युवाचासौ भूपाय च यथोदितम् ।\nश्रावितः स्तोत्रसारं च पाठितो हरिमेधसः ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000641030, "chapter_id": 20641, "verse_number": "५-१००-३१", "content_sanskrit": "श्रुते यस्मिन्नधीते च स सम्यक्फलमाप्नुयात् ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000641031, "chapter_id": 20641, "verse_number": "५-१००-३२", "content_sanskrit": "स कारितस्तेन विशुद्धभावो राजापि चक्रे विधिवत्तदानीम् ।\nश्रीमाधवेमासि विधानमीड्यं ततो यथाकर्णितमादरेण ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000641032, "chapter_id": 20641, "verse_number": "५-१००-३३", "content_sanskrit": "प्रातःस्नानं च पाद्यं च ह्यर्घं च हरिपूजनम् ।\nनैवेद्यं भक्तिभावेन चकार स नृपोत्तमः ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000641033, "chapter_id": 20641, "verse_number": "५-१००-३४", "content_sanskrit": "दानं यथा नियमपालनमादरेण वैशाखमादिविदधाति विधानमेवम् ।\nयो भक्तितोऽन्वहमसौ प्रतिवर्षमेवं कृत्वा प्रयाति हरिधाम महीसुराग्र्यः ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000641034, "chapter_id": 20641, "verse_number": "५-१००-३५", "content_sanskrit": "अथेतरेषु मासेषु कामिनीकुचकेलिवान् ।\nभोगैकलालसो भूयो भवत्येवं यथारुचि ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000641035, "chapter_id": 20641, "verse_number": "५-१००-३६", "content_sanskrit": "न धर्मनियमं राजकार्येषु न विचारणम् ।\nकरोति कामवशगो हित्वा मासं स माधवम् ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000641036, "chapter_id": 20641, "verse_number": "५-१००-३७", "content_sanskrit": "महतामपि विप्राग्र्य दुर्निवार्यो मनोभवः ।\nशरीरसहजो नूनमनादिर्वासनाक्रमः ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000641037, "chapter_id": 20641, "verse_number": "५-१००-३८", "content_sanskrit": "केशकज्जलशालिन्यो दुःस्पर्शा लोचनप्रियाः ।\nयस्मादग्निशिखा नार्यो दहंति तृणवन्नरम् ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000641038, "chapter_id": 20641, "verse_number": "५-१००-३९", "content_sanskrit": "घोरः शत्रुः शरीरस्थः पुंसां कामो यथोचितम् ।\nमोहधूममयः पापो न केषामंधकारितम् ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]