[{"id": 7003945000, "chapter_id": 23945, "verse_number": "३-१-८-१", "content_sanskrit": "ऋषय ऊचुः ।\nभगवन्सूतसर्वज्ञ कृष्णद्वैपायनप्रिय ।\nत्वन्मुखाद्वै कथाः श्रुत्वा श्रोत्रकामृतवर्षिणीः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003945001, "chapter_id": 23945, "verse_number": "३-१-८-२", "content_sanskrit": "तृप्तिर्न जायतेऽस्माकं त्वद्वचोमृतपायिनाम् ।\nअतः शुश्रूषमाणानां भूयो ब्रूहि कथाः शुभाः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003945002, "chapter_id": 23945, "verse_number": "३-१-८-३", "content_sanskrit": "वेतालवरदंनाम चक्रतीर्थस्य दक्षिणे ।\nतीर्थमस्ति महापुण्यमित्यवादीद्भवान्पुरा॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003945003, "chapter_id": 23945, "verse_number": "३-१-८-४", "content_sanskrit": "वेतालवरदाभिख्या तीर्थस्यास्यागता कथम् ।\nकिंप्रभावं च तत्तीर्थमेतन्नो वक्तुमर्हसि॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003945004, "chapter_id": 23945, "verse_number": "३-१-८-५", "content_sanskrit": "श्रीसूत उवाच ।\nसाधुपृष्टं हि युष्माभिरतिगुह्यं मुनीश्वराः ।\nशृणुध्वं मनसा सार्द्धं ब्रवीम्यत्यद्भुतां कथाम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003945005, "chapter_id": 23945, "verse_number": "३-१-८-६", "content_sanskrit": "पामरा अपि मोदन्ते यां वै श्रुत्वा कथां शुभाम् ।\nकथा चेयं महापुण्या पुरा कैलासपर्वते॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003945006, "chapter_id": 23945, "verse_number": "३-१-८-७", "content_sanskrit": "केलिकालेषु पावत्यै शंभुना कथिता द्विजाः ।\nतां ब्रवीमि कथामेनामत्यद्भुततरां हि वः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003945007, "chapter_id": 23945, "verse_number": "३-१-८-८", "content_sanskrit": "पुरा हि गालवोनाम महर्षिः सत्यवाक्छुचिः ।\nचिंतयानः परं ब्रह्म तपस्तेपे निजाश्रमे॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003945008, "chapter_id": 23945, "verse_number": "३-१-८-९", "content_sanskrit": "तस्य कन्या महाभागा रूपयौवनशालिनी ।\nनाम्ना कांतिमती बाला व्यचरत्पितुरंतिके॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003945009, "chapter_id": 23945, "verse_number": "३-१-८-१०", "content_sanskrit": "आहरंती च पुष्पाणि बल्यर्थं तस्य वै मुनेः ।\nवेदिसंमार्जनादीनि समिदाहरणानि च॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003945010, "chapter_id": 23945, "verse_number": "३-१-८-११", "content_sanskrit": "कुर्वती पितरं बाला सम्यक्परिचचार ह ।\nकदाचित्सा तु वल्यर्थं पुष्पाण्याहर्तुमुद्यता॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003945011, "chapter_id": 23945, "verse_number": "३-१-८-१२", "content_sanskrit": "तस्मिन्वने कांतिमती सुदूरमगमत्तदा ।\nतत्र पुष्पाणि रम्याणि समाहृत्य च पेटके॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003945012, "chapter_id": 23945, "verse_number": "३-१-८-१३", "content_sanskrit": "तूर्णं निववृते बाला पितृशुश्रूषणे रता ।\nनिवर्तमानां तां कन्यां विद्याधरकुमारकौ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003945013, "chapter_id": 23945, "verse_number": "३-१-८-१४", "content_sanskrit": "सुदर्शनसुकर्णाख्यौ विमानस्थौ ददर्शतुः ।\nतां दृष्ट्वा गालवसुतां रूपयौवनशालिनीम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003945014, "chapter_id": 23945, "verse_number": "३-१-८-१५", "content_sanskrit": "कामस्य पत्नीं ललितां रतिं मूर्तिमतीमिव ।\nसुदर्शनाभिधो ज्येष्ठो विद्याधरकुमारकः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003945015, "chapter_id": 23945, "verse_number": "३-१-८-१६", "content_sanskrit": "हर्षसंफुल्लनयनश्चकमे काममोहितः ।\nपूर्णचन्द्राननां तां वै वीक्षमाणो मुहुर्मुहुः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003945016, "chapter_id": 23945, "verse_number": "३-१-८-१७", "content_sanskrit": "तया रिरंसुकामोऽसौ विमानाग्रादवातरत् ।\nतामुपेत्य मुनेः कन्यामित्युवाच सुदर्शनः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003945017, "chapter_id": 23945, "verse_number": "३-१-८-१८", "content_sanskrit": "सुदर्शन उवाच ।\nकासि भद्रे सुता कस्य रूपयौवनशालिनी ।\nरूपमप्रतिमं ह्येतदाह्लादयति मे मनः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003945018, "chapter_id": 23945, "verse_number": "३-१-८-१९", "content_sanskrit": "त्वां दृष्ट्वा रतिसंकाशां बाधते मां मनोभवः ।\nसुकण्ठनामधेयस्य विद्याधरपतेरहम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003945019, "chapter_id": 23945, "verse_number": "३-१-८-२०", "content_sanskrit": "आत्मजो रूपसंपन्नो नाम्ना चैव सुदर्शनः ।\nप्रतिगृह्णीष्व मां भद्रे रक्ष मां करुणादृशा॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003945020, "chapter_id": 23945, "verse_number": "३-१-८-२१", "content_sanskrit": "भर्तारं मां समासाद्य सर्वान्भोगानवाप्स्यसि ।\nइत्याकर्ण्य वचस्तस्य विद्याधरसुतस्य सा॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003945021, "chapter_id": 23945, "verse_number": "३-१-८-२२", "content_sanskrit": "तदा कांतिमती वाक्यं धर्मयुक्तमभाषत ।\nसुदर्शन महाभाग विद्याधरपतेः सुत॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003945022, "chapter_id": 23945, "verse_number": "३-१-८-२३", "content_sanskrit": "आत्मजां मां विजानीहि गालवस्य महात्मनः ।\nकन्या चाहमनूढास्मि पितृशु श्रूषणे रता॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003945023, "chapter_id": 23945, "verse_number": "३-१-८-२४", "content_sanskrit": "बल्यर्थं हि पितुश्चाहं पुष्पाण्याहर्तुमागता ।\nआहरंत्याश्च पुष्पाणि याम एको न्यवर्तत॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003945024, "chapter_id": 23945, "verse_number": "३-१-८-२५", "content_sanskrit": "मद्विलंबेन स मुनिर्देव तार्चनतत्परः ।\nकोपं विधास्यते नूनं तपस्वी मुनिपुंगवः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003945025, "chapter_id": 23945, "verse_number": "३-१-८-२६", "content_sanskrit": "तच्छीघ्रमद्य गच्छामि पुष्पाण्यप्याहृतानि मे ।\nकन्याश्च पितुराधीना न स्वतन्त्राः कदाचन॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003945026, "chapter_id": 23945, "verse_number": "३-१-८-२७", "content_sanskrit": "यदि मामिच्छति भवान्पितरं मम याचय ।\nइति विद्याधरसुतमुक्त्वा कांतिमती तदा॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003945027, "chapter_id": 23945, "verse_number": "३-१-८-२८", "content_sanskrit": "पितुराशंकिता तूर्णमा श्रमं गन्तुमुद्यता ।\nगच्छन्तीं तां समालोक्य विद्याधरकुमारकः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003945028, "chapter_id": 23945, "verse_number": "३-१-८-२९", "content_sanskrit": "तूर्णं जग्राह केशेषु धावित्वा मदनार्दितः ।\nअभ्येत्य निजकेशेषु गृह्णन्ते तं विलोक्य सा॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003945029, "chapter_id": 23945, "verse_number": "३-१-८-३०", "content_sanskrit": "उच्चैश्चक्रंद सहसा कुररीव मुनेः सुता ।\nअस्माद्विद्याधरसुताज्जनक त्राहि मां विभो॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003945030, "chapter_id": 23945, "verse_number": "३-१-८-३१", "content_sanskrit": "बलाद्गृह्णाति दुष्टात्मा विद्याधरसुतोऽद्य माम् ।\nइत्थमुच्चैः प्रचुक्रोश स्वाश्रमान्नातिदूरतः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003945031, "chapter_id": 23945, "verse_number": "३-१-८-३२", "content_sanskrit": "तदाक्रंदितमाकर्ण्य गन्धमादनवासिनः ।\nमुनयस्तु पुरस्कृत्य गालवं मुनिपुंगवम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003945032, "chapter_id": 23945, "verse_number": "३-१-८-३३", "content_sanskrit": "किमेतदिति विज्ञातुं तं देशं तूर्णमाययुः ।\nतं देशं तु समागत्य सर्वे ते ऋषिपुंगवाः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003945033, "chapter_id": 23945, "verse_number": "३-१-८-३४", "content_sanskrit": "विद्याधरगृहीतां तां ददृशुर्मु निकन्यकाम् ।\nविद्याधरसुतं चान्यमंतिके समुपस्थितम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003945034, "chapter_id": 23945, "verse_number": "३-१-८-३५", "content_sanskrit": "एतद्दृष्ट्वा महायोगी गालवो मुनिपुंगवः ।\nगतः कोपवशं किंचिद्दुराप्मानं शशाप तम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003945035, "chapter_id": 23945, "verse_number": "३-१-८-३६", "content_sanskrit": "कृतवानीदृशं कार्यं यत्त्वं विद्याधराधम ।\nतद्याहि मानुषीं योनिं स्वस्य दुष्कर्मणः फलम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003945036, "chapter_id": 23945, "verse_number": "३-१-८-३७", "content_sanskrit": "संप्राप्य मानुषं जन्म बहुदुःखसमाकुलम् ।\nअचिरेण तु कालेन तस्मिन्नेव तु जन्मनि॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003945037, "chapter_id": 23945, "verse_number": "३-१-८-३८", "content_sanskrit": "मनुष्यैरपि निंद्यं तद्वेतालत्वं प्रयास्यसि ।\nमांसानि शोणितं चैव सर्वदा भक्षयिष्यसि॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003945038, "chapter_id": 23945, "verse_number": "३-१-८-३९", "content_sanskrit": "वेताला राक्षसप्राया बलाद्गृह्णन्ति योषितः ।\nतस्मात्त्वं मानुषो भूत्वा वेतालत्वमवाप्स्यसि॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003945039, "chapter_id": 23945, "verse_number": "३-१-८-४०", "content_sanskrit": "तव दुष्कर्मणो योऽसावनुमंता कनिष्ठकः ।\nसुकर्ण इति विख्यातो भविता सोपि मानुषः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003945040, "chapter_id": 23945, "verse_number": "३-१-८-४१", "content_sanskrit": "किंतु साक्षान्न कृतवान्यतोऽसावीदृशीं क्रियाम् ।\nतन्मानुषत्व मेवास्य वेतालत्वं तु नो भवेत्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003945041, "chapter_id": 23945, "verse_number": "३-१-८-४२", "content_sanskrit": "विज्ञप्तिकौतुकाभिख्यं यदा विद्याधराधिपम् ।\nद्रक्ष्यतेऽसौ कनिष्ठस्ते तदा शापाद्विमोक्ष्यते॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003945042, "chapter_id": 23945, "verse_number": "३-१-८-४३", "content_sanskrit": "ईदृशस्यतु यः कर्ता महापापस्य कर्मणः ।\nस त्वं संप्राप्य मानुष्यं तस्मिन्नेव तु जन्मनि॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003945043, "chapter_id": 23945, "verse_number": "३-१-८-४४", "content_sanskrit": "वेतालजन्म संप्राप्य चिरं लोके चरिष्यसि ।\nइत्युक्त्वा गालवः कन्यां गृहीत्वा मुनिभिः सह॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003945044, "chapter_id": 23945, "verse_number": "३-१-८-४५", "content_sanskrit": "विद्याधरसुतौ शप्त्वा स्वाश्रमं प्रति निर्ययौ ।\nततस्तस्मिन्महाभागे निर्याते मुनिपुंगवे॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003945045, "chapter_id": 23945, "verse_number": "३-१-८-४६", "content_sanskrit": "सुदर्शनसुकर्णाख्यौ विद्याधरपतेः सुतौ ।\nमुनिशापेन दुःखार्तौ चिंतयामासतुर्भृशम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003945046, "chapter_id": 23945, "verse_number": "३-१-८-४७", "content_sanskrit": "कर्तव्यं तौ विनिश्चित्य सुदर्शनसुकर्णकौ ।\nगोविंदस्वामिनामानं यमुनातटवासिनम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003945047, "chapter_id": 23945, "verse_number": "३-१-८-४८", "content_sanskrit": "ब्राह्मणं शीलसंपन्नं पितृत्वे परिकल्प्य तौ ।\nपरित्यज्य स्वकं रूपमजायेतां तदा त्मजौ॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003945048, "chapter_id": 23945, "verse_number": "३-१-८-४९", "content_sanskrit": "विजयाशोकदत्ताख्यौ तस्य पुत्रौबभूवतुः ।\nसुतो विजयदत्ताख्यो ज्येष्ठो जज्ञे सुदर्शनः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003945049, "chapter_id": 23945, "verse_number": "३-१-८-५०", "content_sanskrit": "अशोकदत्तनामा तु सुकर्णश्च कनिष्ठकः ।\nविजयाशोकदत्तौ तु क्रमाद्यौवनमापतुः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003945050, "chapter_id": 23945, "verse_number": "३-१-८-५१", "content_sanskrit": "एतस्मिन्नेव कालेतु यमुनायास्तटे शुभे ।\nअनावृष्ट्या तु दुर्भिक्षमभूद्द्वादशवार्षि कम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003945051, "chapter_id": 23945, "verse_number": "३-१-८-५२", "content_sanskrit": "गोविंदस्वामिनामा तु ब्राह्मणो वेदपारगः ।\nदुर्भिक्षोपहतां दृष्ट्वा तदानीं स निजां पुरीम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003945052, "chapter_id": 23945, "verse_number": "३-१-८-५३", "content_sanskrit": "प्रययौ काशनिगरं सपुत्रः सह भार्यया ।\nस प्रयागं समासाद्य द्वं दृष्ट्वा महावटम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003945053, "chapter_id": 23945, "verse_number": "३-१-८-५४", "content_sanskrit": "कपालमालाभरणं सोऽपश्यद्यतिनं पुरः ।\nगोविंदस्वामिनामा तु नमश्चक्रे स तं मुनिम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003945054, "chapter_id": 23945, "verse_number": "३-१-८-५५", "content_sanskrit": "सपुत्रस्य सभार्यस्य सोऽवादीदाशिषो मुनिः ।\nइदं च वचनं प्राह गोविंदस्वामिनं प्रति॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003945055, "chapter_id": 23945, "verse_number": "३-१-८-५६", "content_sanskrit": "ज्येष्ठेनानेन पुत्रेण सांप्रतं ब्राह्मणोत्तम ।\nक्षिप्रं विजयदत्तेन वियोगस्ते भविष्यति॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003945056, "chapter_id": 23945, "verse_number": "३-१-८-५७", "content_sanskrit": "इति तस्य वचः श्रुत्वा गोविंदस्वामिनामकः ।\nसूर्ये चास्तं गते तत्र सांध्यं कर्म समाप्य च॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003945057, "chapter_id": 23945, "verse_number": "३-१-८-५८", "content_sanskrit": "सभार्यः ससुतो विप्रः सुदूराध्वसमाकुलः ।\nउवास तस्यां शर्वर्य्यां शून्ये वै देवतालये॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003945058, "chapter_id": 23945, "verse_number": "३-१-८-५९", "content_sanskrit": "तदा त्वशोकदत्तश्च ब्राह्मणी च समाकुलौ ।\nवस्त्रेणास्तीर्य पृथिवीं रात्रौ निद्रां समापतुः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003945059, "chapter_id": 23945, "verse_number": "३-१-८-६०", "content_sanskrit": "ततो विजयदत्तस्तु दूरमार्गविलंघनात् ।\nबभूवात्यंतमलसो भृशं शीतज्वरार्दितः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003945060, "chapter_id": 23945, "verse_number": "३-१-८-६१", "content_sanskrit": "गोविंदस्वामिना पित्रा शीतवबाधानिवृत्तये ।\nगाढमालिंग्यमानोऽपि शीतबाधां न सोऽत्यजत्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003945061, "chapter_id": 23945, "verse_number": "३-१-८-६२", "content_sanskrit": "बाधतेऽत्यर्थमधुना तात मां शीतलो ज्वरः ।\nएतद्बाधानिवृत्त्यर्थं वह्निमानय मा चिरम्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003945062, "chapter_id": 23945, "verse_number": "३-१-८-६३", "content_sanskrit": "इति पुत्रवचः श्रुत्वा सर्वत्राग्निं गवेषयन् ।\nअलब्धवह्निः प्रोवाच पुन रभ्येत्य पुत्रकम्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003945063, "chapter_id": 23945, "verse_number": "३-१-८-६४", "content_sanskrit": "न वह्निं पुत्र विंदामि मार्गमाणोऽपि सर्वशः ।\nरात्रिमध्ये तु संप्राप्ते द्वारेषु पिहितेषु च॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003945064, "chapter_id": 23945, "verse_number": "३-१-८-६५", "content_sanskrit": "निद्रापरवशाः पौरा नैव दास्यंति पावकम् ।\nइत्थं विजयदत्तोऽसावुक्तः पित्रा ज्वरातुरः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003945065, "chapter_id": 23945, "verse_number": "३-१-८-६६", "content_sanskrit": "ययाचे वह्निमेवासौ पितरं दीनया गिरा ।\nशीतज्वरसमुद्भूतशीतबाधाप्रपीडितम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003945066, "chapter_id": 23945, "verse_number": "३-१-८-६७", "content_sanskrit": "हिमशीकरवान्वायुर्द्विगुणं बाधतेऽद्य माम् ।\nवह्निर्न लब्ध इति वै मिथ्यैवोक्तं पितस्त्वया॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003945067, "chapter_id": 23945, "verse_number": "३-१-८-६८", "content_sanskrit": "दूरादेष पुरोभागे ज्वालामालासमाकुलः ।\nशिखाभिर्लेलिहानोभ्रं दृश्यते पश्य पावकः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003945068, "chapter_id": 23945, "verse_number": "३-१-८-६९", "content_sanskrit": "तं वह्निमानय क्षिप्रं तात शीतनिवृत्तये ।\nइत्युक्तवन्तं तं पुत्रं स पिता प्रत्यभाषत॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003945069, "chapter_id": 23945, "verse_number": "३-१-८-७०", "content_sanskrit": "नानृतं वच्मि पुत्राद्य सत्यमेव ब्रवीम्यहम् ।\nवह्निमान्योऽयमुद्देशो दूरादेव विलोक्यते॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003945070, "chapter_id": 23945, "verse_number": "३-१-८-७१", "content_sanskrit": "पितृकाननदेशं तं पुत्र जानीहि सांप्रतम् ।\nयद्येषोभ्रंलिहज्वालः पुरस्ताज्ज्वलतेऽनलः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003945071, "chapter_id": 23945, "verse_number": "३-१-८-७२", "content_sanskrit": "पुत्र वित्रासजनकं तं जानीहि चितानलम् ।\nअमंगलो न सेव्योऽयं चिताग्निः स्पर्शदूषितः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003945072, "chapter_id": 23945, "verse_number": "३-१-८-७३", "content_sanskrit": "तस्य चायुःक्षयं याति सेवते यश्चितानलम् ।\nतस्मात्तवायुर्हानिर्मा भूयादिति मया सुत॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003945073, "chapter_id": 23945, "verse_number": "३-१-८-७४", "content_sanskrit": "अमंगलस्तथा स्पृश्यो नानीतोऽयं चितानलः ।\nइत्युक्तवंतं पितरं स दीनः प्रत्यभाषत॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003945074, "chapter_id": 23945, "verse_number": "३-१-८-७५", "content_sanskrit": "अयं शवानलो वा स्यादध्वरानल एव वा ।\nसर्वथानीयतामेष नोचेन्मे मरणं भवेत्॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003945075, "chapter_id": 23945, "verse_number": "३-१-८-७६", "content_sanskrit": "पुत्रस्नेहाभिभूतोऽथ समाहर्तुं चितानलम् ।\nगोविंदस्वामिनामा तु श्मशानं शीघ्रमभ्यगात्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003945076, "chapter_id": 23945, "verse_number": "३-१-८-७७", "content_sanskrit": "गोविंदस्वामिनि गते समाहर्तुं चितानलम् ।\nतूर्णं विजयदत्तोऽपि तदा गच्छंतमन्वयात्॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003945077, "chapter_id": 23945, "verse_number": "३-१-८-७८", "content_sanskrit": "संप्राप्य तापनिकटं विकीर्णास्थि चितानलम् ।\nआलिंगन्निव सोद्वेगं शनैर्निर्वृतिमाप्तवान्॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003945078, "chapter_id": 23945, "verse_number": "३-१-८-७९", "content_sanskrit": "अथावादीत्स पितरं तदिदं परिवर्तुलम् ।\nअतिदीप्तं विभात्यग्नौ किं रक्तांबुजसन्निभम्॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003945079, "chapter_id": 23945, "verse_number": "३-१-८-८०", "content_sanskrit": "इति तस्य वचः श्रुत्वा पुत्रस्य ब्राह्मणोत्तमः ।\nनिपुणं तं निरूप्यैतद्वचनं पुनरब्रवीत्॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003945080, "chapter_id": 23945, "verse_number": "३-१-८-८१", "content_sanskrit": "गोविंदस्वाम्युवाच ।\nएतत्कपालमनलज्वालावलयवर्तुलम् ।\nवसाकीकसमांसाढ्यमेतद्रक्तांबुजोपमम्॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003945081, "chapter_id": 23945, "verse_number": "३-१-८-८२", "content_sanskrit": "द्विजस्य सूनुः श्रुत्वेति काष्ठाग्रेण जघान तत् ।\nयेन तत्स्फुटनोद्गीर्णवसासिक्तमुखोऽभवत्॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003945082, "chapter_id": 23945, "verse_number": "३-१-८-८३", "content_sanskrit": "कपालघट्टनाद्रक्तं यत्संसक्तं मुखे तदा ।\nजिह्वया लेलिहानोऽसौ मुहुस्तद्रक्तमा स्वदत्॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003945083, "chapter_id": 23945, "verse_number": "३-१-८-८४", "content_sanskrit": "आस्वाद्यैवं समादाय तत्कपालं समाकुलः ।\nपीत्वा वसां महाकायो बभूवातिभयंकरः॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003945084, "chapter_id": 23945, "verse_number": "३-१-८-८५", "content_sanskrit": "सद्यो वेता लतां प्राप तीक्ष्णदंष्ट्रस्तदा निशि ।\nतस्याट्टहासघोषेण दिशश्च प्रदिशस्तदा॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003945085, "chapter_id": 23945, "verse_number": "३-१-८-८६", "content_sanskrit": "द्यौरतरिक्षं भूमिश्च स्फुटिता इव सर्वशः ।\nतस्मिन्वेगात्समाकृष्य पितरं हन्तुमुद्यते॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003945086, "chapter_id": 23945, "verse_number": "३-१-८-८७", "content_sanskrit": "मा कृथाः साहसमिति प्रादुरासीद्वचो दिवि ।\nस दिव्यां गिरमाकर्ण्य वेतालोऽतिभयंकरः॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003945087, "chapter_id": 23945, "verse_number": "३-१-८-८८", "content_sanskrit": "पितरं तं परित्यज्य महावेगसमन्वितः ।\nतूर्णमाकाशमाविश्य प्रययावस्खलद्गतिः॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003945088, "chapter_id": 23945, "verse_number": "३-१-८-८९", "content_sanskrit": "स गत्वा दूरमध्वानं वेतालैः सह संगतः ।\nतमागतं समालोक्य वेतोलास्सर्व एव ते॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003945089, "chapter_id": 23945, "verse_number": "३-१-८-९०", "content_sanskrit": "कपालस्फोटनादेष वेतालत्वं यदाप्तवान् ।\nकपालस्फोटनामानमाह्वयांचक्रिरे ततः॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003945090, "chapter_id": 23945, "verse_number": "३-१-८-९१", "content_sanskrit": "ततः कपालस्फोटो ऽसौ वेतालैः सर्वतो वृतः ।\nनरास्थिभूषणाख्यस्य सद्यो वेतालभूपतेः॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003945091, "chapter_id": 23945, "verse_number": "३-१-८-९२", "content_sanskrit": "अन्तिकं सहसा प्राप महाबलसमन्वितः ।\nनरास्थिभूषणश्चैनं सेनाप तिमकल्पयत्॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003945092, "chapter_id": 23945, "verse_number": "३-१-८-९३", "content_sanskrit": "तं कदाचित्तु गन्धर्वश्चित्रसेनाभिधो बली ।\nनरास्थिभूषणं संख्ये न्यवधीत्सोऽपि संस्थितः॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003945093, "chapter_id": 23945, "verse_number": "३-१-८-९४", "content_sanskrit": "नरास्थिभूषणे तस्मि न्गन्धर्वेण हते युधि ।\nतदा कपालस्फोटोऽसौ तत्पदं समवाप्तवान्॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003945094, "chapter_id": 23945, "verse_number": "३-१-८-९५", "content_sanskrit": "विद्याधरेन्द्रस्य सुतः सुदर्शनो मनुष्यतां वै प्रथमं स गत्वा ।\nवेतालतां प्राप्य महर्षिशापात्क्रमाच्च वेतालपतिर्बभूव॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]