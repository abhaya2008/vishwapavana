[{"id": 2213077, "chapter_id": 5546, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213078, "chapter_id": 5546, "verse_number": "१", "content_sanskrit": "एवमेतन्महाबाहो यथा वदसि पाण्डव ।\nकृतमुद्धर्षणं पूर्वं मया वः सीदतां नृप\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213079, "chapter_id": 5546, "verse_number": "२", "content_sanskrit": "द्यूतापहृतराज्यानां पतितानां सुखादपि ।\nज्ञातिभिः परिभूतानां कृतमुद्धरणं मया\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213080, "chapter_id": 5546, "verse_number": "३", "content_sanskrit": "कथं पाण्डोर्न नश्येद्धि सन्ततिः पुरुषर्षभ ।\nयशश्च वो न नश्येद्धि इति चोद्धरणं कृतम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213081, "chapter_id": 5546, "verse_number": "४", "content_sanskrit": "यूयमिन्द्रसमाः सर्वे देवतुल्यपराक्रमाः ।\nमा परेषां मुखप्रेक्षाः स्युरित्येवं कृतं मया\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213082, "chapter_id": 5546, "verse_number": "५", "content_sanskrit": "कथं धर्मभृतां श्रेष्ठो राजा त्वं वासवोपमः ।\nपुनर्वनं न गच्छेथा इति चोद्धरणं कृतम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213083, "chapter_id": 5546, "verse_number": "६", "content_sanskrit": "नागायुतसमप्राणः ख्यातविक्रमपौरुषः ।\nनायं भीमोऽत्ययं गच्छेद् इति चोद्धरणं कृतम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213084, "chapter_id": 5546, "verse_number": "७", "content_sanskrit": "भीमसेनादवरजस्तथाऽयं वासवोपमः ।\nविजयो नावसीदेत इति चोद्धरणं कृतम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213085, "chapter_id": 5546, "verse_number": "८", "content_sanskrit": "नकुलः सहदेवश्च तथेमौ गुरुवर्तिनौ ।\nक्षुधा कथं न सीदेतामिति चोद्धरणं कृतम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213086, "chapter_id": 5546, "verse_number": "९", "content_sanskrit": "इयं च बृहती श्यामा श्रीमत्यायतलोचना ।\nतथा सभातळे क्लिष्टा मा भूदिति च तत्कृतम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213087, "chapter_id": 5546, "verse_number": "१०", "content_sanskrit": "पश्यन्त्या मे तथा हीमां वेपन्तीं कदळीमिव ।\nस्त्रीधर्मिणीमनिन्द्याङ्गीं तथा द्यूतपराजिताम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213088, "chapter_id": 5546, "verse_number": "११", "content_sanskrit": "दुःशासनस्तां मौर्ख्यात्तु दासीवत् पर्यकर्षत ।\nतदैव विदितं मह्यं परिभूतमिदं कुलम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213089, "chapter_id": 5546, "verse_number": "१२", "content_sanskrit": "विषण्णाः कुरवश्चैव तदा मे श्वशुरादयः ।\nयथैषा नाथमिच्छन्ती प्रालपत् कुररी यथा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213090, "chapter_id": 5546, "verse_number": "१३", "content_sanskrit": "केशपक्षे परामृष्टा पापेन हतबुद्धिना ।\nयदा दुःशासनेनैषा तदा मुह्याम्यहं नृप\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213091, "chapter_id": 5546, "verse_number": "१४", "content_sanskrit": "युष्मत्तेजोविवृद्ध्यर्थं मया ह्युद्धरणं कृतम् ।\nतदानीं विदुलावाक्यैरिति तद्वित्त पुत्रकाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213092, "chapter_id": 5546, "verse_number": "१५", "content_sanskrit": "कथं न राजवंशोऽयं नश्येत् प्राप्य सुतान् मम ।\nपाण्डोरिति मया पुत्रास्तस्मादुद्धरणं कृतम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213093, "chapter_id": 5546, "verse_number": "१६", "content_sanskrit": "न तस्य पुत्राः पौत्रा वा कुत एव स पार्थिवः ।\nलभते सुकृतान् लोकान् यस्माद्वंशः प्रणश्यति\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2213094, "chapter_id": 5546, "verse_number": "१७", "content_sanskrit": "भुक्तं राज्यफलं तात भर्तुर्मे विपुलं पुरा ।\nमहादानानि दत्तानि पीताः सोमा यथाविधि\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2213095, "chapter_id": 5546, "verse_number": "१८", "content_sanskrit": "साऽहं नात्मफलार्थं वै वासुदेवमचूचुदम् ।\nविदुलायाः प्रलापैस्तैः प्लावनार्थं तु तत्कृतम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2213096, "chapter_id": 5546, "verse_number": "१९", "content_sanskrit": "नाहं राज्यफलं पुत्राः कामये भर्तृवर्जितम् ।\nपतिलोकानहं पुण्यान् कामये तपसा विभो\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2213097, "chapter_id": 5546, "verse_number": "२०", "content_sanskrit": "श्वश्रूश्वशुरयोः कृत्वा शुश्रूषां वनवासिनोः ।\nतपसा शोषयिष्यामि युधिष्ठिर कलेबरम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2213098, "chapter_id": 5546, "verse_number": "२१", "content_sanskrit": "निवर्तस्व कुरुश्रेष्ठ भीमसेनादिभिः सह ।\nधर्मे ते धीयतां बुद्धिर्मनसो महदस्तु ते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2213099, "chapter_id": 5546, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्रमवासिकपर्वणि कुन्तीवचनं नाम द्वाविंशोऽध्यायः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2213100, "chapter_id": 5546, "verse_number": "", "content_sanskrit": "आश्रमवासपर्वणि द्वाविंशोऽध्यायः ॥२२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]