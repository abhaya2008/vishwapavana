[{"id": 7003773000, "chapter_id": 23773, "verse_number": "२-२-१७-१", "content_sanskrit": "मुनय ऊचुः ।\nप्रतिष्ठिते नारसिंहे क्षेत्रे तस्मिन्नराधिपः ।\nकिं चकार मुने ब्रूहि परं कौतूहलं तु तत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003773001, "chapter_id": 23773, "verse_number": "२-२-१७-२", "content_sanskrit": "जैमिनिरुवाच ।\nइन्द्रादींस्त्रिदशान्सर्वान्न्यमन्त्रयत पूर्वतः ।\nततः स मन्त्रयामास ऋषीन्विप्रान्सहस्रशः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003773002, "chapter_id": 23773, "verse_number": "२-२-१७-३", "content_sanskrit": "अध्येतॄंश्चतुरो वेदान्सषडंगपदक्रमैः ।\nयज्ञविद्यासु कुशलान्मीमांसापरिनिष्ठितान् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003773003, "chapter_id": 23773, "verse_number": "२-२-१७-४", "content_sanskrit": "सभाष्यकल्पसूत्रैस्तु परिनिष्ठितकर्मिणः ।\nअष्टादशसु विद्यासु कुशलान्धर्मकोविदान् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003773004, "chapter_id": 23773, "verse_number": "२-२-१७-५", "content_sanskrit": "सदाचारावदातांश्च कुलीनान्सत्यवादिनः ।\nवैष्णवांश्च विशेषेण मंत्रयामास सादरम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003773005, "chapter_id": 23773, "verse_number": "२-२-१७-६", "content_sanskrit": "त्रैलोक्ये ये च राजानः सिद्धाः सप्तर्षयो द्विजाः ।\nसच्छूद्रा वणिजो द्वीपपतयश्च निमंत्रिताः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003773006, "chapter_id": 23773, "verse_number": "२-२-१७-७", "content_sanskrit": "क्रोशद्वयमिता विप्राः सभासीत्तस्य भूपतेः ।\nपाषाणघटिता सोच्चा सुधया सानुलेपिता ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003773007, "chapter_id": 23773, "verse_number": "२-२-१७-८", "content_sanskrit": "क्वचिद्रत्नमयी भूमिः क्वचित्कांचननिर्मिता ।\nस्फाटिकी राजती चैव यथायोग्यं कृतस्थली ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003773008, "chapter_id": 23773, "verse_number": "२-२-१७-९", "content_sanskrit": "स्तंभै रत्नमयैः प्रोच्चैर्दुकूलपरिवेष्टितैः ।\nचारुचंद्रातपाढ्या तु गन्धमाल्यैः सचामरैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003773009, "chapter_id": 23773, "verse_number": "२-२-१७-१०", "content_sanskrit": "मुक्तादामांतरस्थैश्च चारुवातायना शुभा ।\nकृष्णागुरुस्नेहसिक्ता श्रीखण्डसलिलोक्षिता ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003773010, "chapter_id": 23773, "verse_number": "२-२-१७-११", "content_sanskrit": "सर्वर्त्तुकुसुमाकीर्णा प्रांतोपवनसंवृता ।\nवाप्यः स्फटिकसोपानाः पद्मकद्वारमंडिताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003773011, "chapter_id": 23773, "verse_number": "२-२-१७-१२", "content_sanskrit": "चक्रवाकैः प्लवैर्हंसैः सारसैर्मधुरस्वनैः ।\nव्याप्तांतराः स्वच्छशीतसुगंधमधुरांभसः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003773012, "chapter_id": 23773, "verse_number": "२-२-१७-१३", "content_sanskrit": "परितः शतशस्तस्याः सुखावतरणा द्विजाः ।\nउपच्छायाविरचनाः शोभमानाः समंततः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003773013, "chapter_id": 23773, "verse_number": "२-२-१७-१४", "content_sanskrit": "यज्ञशाला मरुत्तस्य यथासीद्भो द्विजोत्तमाः ।\nतथेंद्रद्युम्नभूपस्य रचिता विश्वकर्मणा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003773014, "chapter_id": 23773, "verse_number": "२-२-१७-१५", "content_sanskrit": "शुभेऽह्नि शुभनक्षत्रे वासयित्वा सभासदः ।\nराज्ञः सिंहासनासीनान्दृष्ट्वासीनानृषीनपि ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003773015, "chapter_id": 23773, "verse_number": "२-२-१७-१६", "content_sanskrit": "ससिद्धान्ब्रह्मर्षिगणान्बहुमूल्यकुथस्थितान् ।\nदेवान्कांचनपीठस्थान्यथायोग्यमथ द्विजान् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003773016, "chapter_id": 23773, "verse_number": "२-२-१७-१७", "content_sanskrit": "वरासनस्थानन्यांश्च यथादेशं सुखस्थितान् ।\nमध्ये नृपाणां देवानामृषीणां च शचीपतिम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003773017, "chapter_id": 23773, "verse_number": "२-२-१७-१८", "content_sanskrit": "साम्राज्यलक्षणे स्वस्य रत्नसिंहासने स्थितम् ।\nदिव्यैर्माल्यैस्तथा गंधैर्वासोभिर्विष्टरादिभिः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003773018, "chapter_id": 23773, "verse_number": "२-२-१७-१९", "content_sanskrit": "पुरोधसा समं पूर्वमर्चयामास ऋद्धिमत् ।\nविनीतो दीनवत्तस्य चक्रे पूजां तथा नृपः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003773019, "chapter_id": 23773, "verse_number": "२-२-१७-२०", "content_sanskrit": "आश्चर्यं मन्यतेऽस्यासौ त्रैलोक्येशोऽपि तद्यथा ।\nततः सिद्धान्देवमुनीनचर्यन्निंद्रवत्तदा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003773020, "chapter_id": 23773, "verse_number": "२-२-१७-२१", "content_sanskrit": "विस्मयं जनयामास कुवेरस्याप्यधिश्रियः ।\nततो देवान्समानर्च प्रभूतस्वस्वसंपदः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003773021, "chapter_id": 23773, "verse_number": "२-२-१७-२२", "content_sanskrit": "उपचारैर्महीनाथः सम्यगव्यग्रमानसः ।\nराज्ञः संपूजयामास राजयोग्यैः परिच्छदैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003773022, "chapter_id": 23773, "verse_number": "२-२-१७-२३", "content_sanskrit": "यथा ते मेनिरे भूपा भवामः सांप्रतं वयम् ।\nसत्यं राज्यं क्रमात्प्राप्तं नेदृशश्च परिच्छदः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003773023, "chapter_id": 23773, "verse_number": "२-२-१७-२४", "content_sanskrit": "आनर्च वैष्णवान्भूय उपचारैः समानयन् ।\nशांता अपि यथा चित्रं मेनिरे विषयागमम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003773024, "chapter_id": 23773, "verse_number": "२-२-१७-२५", "content_sanskrit": "ततो विप्रान्बाहुजातान्वैश्यान्मुनिपुरःसरम् ।\nसम्यक्प्रपूजयामास सत्त्वोद्रिक्तो महीपतिः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003773025, "chapter_id": 23773, "verse_number": "२-२-१७-२६", "content_sanskrit": "अन्यांश्च सचिवद्वारा पूजयित्वा ससंभ्रमः ।\nदृष्टः स विनयान्नम्रः कृतांजलिपुटस्तथा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003773026, "chapter_id": 23773, "verse_number": "२-२-१७-२७", "content_sanskrit": "महेंद्रमुच्चैराहेदं नारदेन पुरोधसा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003773027, "chapter_id": 23773, "verse_number": "२-२-१७-२८", "content_sanskrit": "इन्द्रद्युम्न उवाच ।\nतव प्रसादाद्देवेश इच्छामीदं प्रसीद मे ।\nक्रतुना हयमेधेन प्रयक्ष्ये यज्ञपूरुषम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003773028, "chapter_id": 23773, "verse_number": "२-२-१७-२९", "content_sanskrit": "अनुजानीहि मां देव क्रतूनामीश्वरो भवान् ।\nत्वदाज्ञापालकाः सर्वे त्रैलोक्ये निवसंति ये ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003773029, "chapter_id": 23773, "verse_number": "२-२-१७-३०", "content_sanskrit": "यावत्क्रतुसहस्रस्य संस्था च भवति प्रभो ।\nतावत्त्वं त्रिदशैः सार्द्धं सदोमध्यगतो वस ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003773030, "chapter_id": 23773, "verse_number": "२-२-१७-३१", "content_sanskrit": "यष्टुमिच्छामि देवेश नाहं त्वत्पदलिप्सया ।\nसर्वेषां वेत्सि देवेश मनोवृत्तिं सदा प्रभो ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003773031, "chapter_id": 23773, "verse_number": "२-२-१७-३२", "content_sanskrit": "युष्माकं पूर्वदृष्टोऽत्र वपुष्मान्माधवः प्रभुः ।\nउपासनायां सोऽयं यो वालुकाभिस्तिरोदधे ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003773032, "chapter_id": 23773, "verse_number": "२-२-१७-३३", "content_sanskrit": "तस्य भूयः प्रकाशार्थं वाजिमेधसहस्रकम् ।\nकरिष्ये वचनादिंद्र चतुरास्यस्य शासनात् ।\nपुनः प्रकाशिते तस्मिञ्छ्रेयो वोऽपि भविष्यति ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003773033, "chapter_id": 23773, "verse_number": "२-२-१७-३४", "content_sanskrit": "इति विज्ञापिते राज्ञा महेंद्रप्रमुखाः सुराः ।\nअन्तर्द्धानोतरं या च श्रुता पूर्वं सरस्वती ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003773034, "chapter_id": 23773, "verse_number": "२-२-१७-३५", "content_sanskrit": "अशरीरां स्मरंतस्तामिदं प्रोचुः प्रहर्षिताः ।\nइन्द्रद्युम्न महात्मासि सत्यं सत्यवतो भुवि ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003773035, "chapter_id": 23773, "verse_number": "२-२-१७-३६", "content_sanskrit": "तच्चेष्टितं पुरास्माभिरन्वभावि भविष्यकम् ।\nसहायास्ते भविष्यामः कार्ये त्रैलोक्यपावने ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003773036, "chapter_id": 23773, "verse_number": "२-२-१७-३७", "content_sanskrit": "स्रष्टा स जगतां यत्र उद्युक्तः स्वयमेव हि ।\nअत्रैवोवाच भगवानस्माकमपि भूतले ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003773037, "chapter_id": 23773, "verse_number": "२-२-१७-३८", "content_sanskrit": "प्रविशंस्तदनुक्रोशवशाद्भूयः प्रकाशनम् ।\nकरिष्ये दारवं देहमित्येतत्परिनिष्ठितम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003773038, "chapter_id": 23773, "verse_number": "२-२-१७-३९", "content_sanskrit": "नात्रास्माकं व्यलीकं तु नेंद्रस्य च महीपते ।\nअस्मद्दिष्टसमुद्योगस्तव नः प्रीतिकारकः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003773039, "chapter_id": 23773, "verse_number": "२-२-१७-४०", "content_sanskrit": "सुखं यजस्व राजेंद्र वैकुंठं भक्तवत्सलम् ।\nक्रतुना हयमेधेन सहस्रपरिवर्तिना ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003773040, "chapter_id": 23773, "verse_number": "२-२-१७-४१", "content_sanskrit": "दुराराध्यो हि भगवानस्माकं भक्तवत्सलः ।\nवयमप्यत्र देवत्वं त्यक्त्वा भक्ति परायणाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003773041, "chapter_id": 23773, "verse_number": "२-२-१७-४२", "content_sanskrit": "आराधयामः क्षेत्रेस्मिन्विनीता नररूपिणः ।\nप्रियं हि मानुषे लोके कर्म सिद्ध्यति वै कृतम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003773042, "chapter_id": 23773, "verse_number": "२-२-१७-४३", "content_sanskrit": "जैमिनिरुवाच ।\nइत्युक्ते त्रिदशैः सेंद्रैः परितुष्टांतरात्मना ।\nआरंभार्थं क्रतो राजा भगवंतमपूजयत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003773043, "chapter_id": 23773, "verse_number": "२-२-१७-४४", "content_sanskrit": "उपचारसहस्रैस्तु यथावत्प्रतिपादितैः ।\nततः पितृगणान्राजा निरूप्य श्रद्धयान्वितः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003773044, "chapter_id": 23773, "verse_number": "२-२-१७-४५", "content_sanskrit": "सदोगृहगतान्विप्रान्याज्ञिकान्समलंकृतान् ।\nकृत्वेष्टदेवं पुरतो वैकुंठं साग्निहोत्रकम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003773045, "chapter_id": 23773, "verse_number": "२-२-१७-४६", "content_sanskrit": "आकांक्षन्कल्पितं लग्नं संवृत्ते स्वस्तिवाचने ।\nउपस्थितः सपत्नीकः शुद्धमांगल्यवेषधृक् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003773046, "chapter_id": 23773, "verse_number": "२-२-१७-४७", "content_sanskrit": "स्वस्ति वाच्य द्विजाञ्छुद्धान्पुण्याहं वृद्धिकर्म च ।\nततः संभृतसंभारो वरयामास ऋत्विजः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003773047, "chapter_id": 23773, "verse_number": "२-२-१७-४८", "content_sanskrit": "वृतास्ते तु सपत्नीकं दीक्षयंतो नृपोत्तमम् ।\nविहृत्य दीक्षणायेष्टान्न्ययजन्सभ्यचोदिताः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003773048, "chapter_id": 23773, "verse_number": "२-२-१७-४९", "content_sanskrit": "प्रणीय तं प्रज्वलंतं वेद्यामाहवनीयकम् ।\nत्रैलोक्यमंगलकरं किं साक्षाद्वैष्णवं महः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003773049, "chapter_id": 23773, "verse_number": "२-२-१७-५०", "content_sanskrit": "सुप्रोक्षितं चाभिमंत्र्य अनुज्ञाप्य दिगीश्वरान् ।\nमुमुचुस्ते हयं मुख्यमंगेषु शुभलक्षणम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003773050, "chapter_id": 23773, "verse_number": "२-२-१७-५१", "content_sanskrit": "ततः स दीक्षितो राजा वाग्यतो रौरवीं त्वचम् ।\nअधिष्ठाय सदोमध्ये मृत्युंजय इव स्थितः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003773051, "chapter_id": 23773, "verse_number": "२-२-१७-५२", "content_sanskrit": "निमंत्रितानां मुक्त्यर्थं चक्षुषा संदिदेश वै ।\nसुराणां रत्नपात्राणि महार्घाणि नृपाज्ञया ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003773052, "chapter_id": 23773, "verse_number": "२-२-१७-५३", "content_sanskrit": "सचिवः कारयामास भोजनाय समृद्धिमत् ।\nशुद्धसौवर्णपात्राणि मुनीनां च महीक्षिताम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003773053, "chapter_id": 23773, "verse_number": "२-२-१७-५४", "content_sanskrit": "द्विजानां भोजनार्थाय नवानि प्रत्यहं द्विजाः ।\nक्षत्रियाणां विशां विप्रा राजतानि शुभानि च ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003773054, "chapter_id": 23773, "verse_number": "२-२-१७-५५", "content_sanskrit": "कांस्यनिर्मलपात्राणि शूद्राणां भोजनाय वै ।\nअहन्यहनि पात्राणि भोजनांते द्विजोत्तमाः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003773055, "chapter_id": 23773, "verse_number": "२-२-१७-५६", "content_sanskrit": "आकरेषु प्रपात्यंते प्रोच्छिष्टदलवज्जनैः ।\nतत्र यज्ञोत्सवे ये वै भोजनाय निमंत्रिताः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003773056, "chapter_id": 23773, "verse_number": "२-२-१७-५७", "content_sanskrit": "तेषां पुत्राश्च पौत्राश्च प्रपौत्राश्चैव संततिः ।\nनित्यं पंचरसान्नानि बहुमानपुरःसरम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003773057, "chapter_id": 23773, "verse_number": "२-२-१७-५८", "content_sanskrit": "आदृतैर्भोजिता राज्ञ इंद्रद्युम्नस्य शासनात् ।\nकुटुंबवत्स्थितास्तत्र संस्था यावन्महाक्रतोः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003773058, "chapter_id": 23773, "verse_number": "२-२-१७-५९", "content_sanskrit": "यद्देशीया जनास्तेषामधिष्ठाता च तान्नृपः ।\nनृपाणामनुसंधाता इंद्रद्युम्नप्रयाचितः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003773059, "chapter_id": 23773, "verse_number": "२-२-१७-६०", "content_sanskrit": "नारदः समदर्शी तु परोपकृतिलोलुपः ।\nइंद्रादीनां सुरेंद्राणां देवर्षीणां नृपोत्तमः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003773060, "chapter_id": 23773, "verse_number": "२-२-१७-६१", "content_sanskrit": "स्वयं नरपतिश्चर्यां चकार क्रतुपूर्त्तये ।\nषड्विधान्यन्नपानानि संस्कृतानि द्विधा नरैः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003773061, "chapter_id": 23773, "verse_number": "२-२-१७-६२", "content_sanskrit": "देवानां भोजने तत्र मंत्रतंत्रविशारदैः ।\nमर्त्यानां नल विद्यायां कुशलैः संस्कृतानि वै ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003773062, "chapter_id": 23773, "verse_number": "२-२-१७-६३", "content_sanskrit": "क्षुत्पिपासानभिज्ञा हि सुधाहारा दिवौकसः ।\nतेषामपि अपूर्वत्वादाश्चर्यं तद्धि भोजनम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003773063, "chapter_id": 23773, "verse_number": "२-२-१७-६४", "content_sanskrit": "नराणां दुर्लभं मर्त्य इंद्रद्युम्नगृहेऽशनम् ।\nइन्द्रद्युम्नस्य चेंद्रस्य विशेषो मर्त्यवासिता ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003773064, "chapter_id": 23773, "verse_number": "२-२-१७-६५", "content_sanskrit": "अत्यद्भुतकरं ह्येतत्प्रत्यहं च नवं नवम् ।\nसंमाननादरावृद्धिर्भोज्यस्य द्विजसत्तमाः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003773065, "chapter_id": 23773, "verse_number": "२-२-१७-६६", "content_sanskrit": "अन्योन्यस्पर्द्धयैवात्र प्रवर्द्धते परस्परम् ।\nसुगंधसुमनोमाल्यकस्तूर्यादिप्रलेपनम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003773066, "chapter_id": 23773, "verse_number": "२-२-१७-६७", "content_sanskrit": "चित्रसूक्ष्मदुकूलानि सोपधानासनानि च ।\nरत्नपल्यंकिका शय्या रत्नदंडप्रकीर्णकम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003773067, "chapter_id": 23773, "verse_number": "२-२-१७-६८", "content_sanskrit": "जातीलवंगकर्पूरैर्नागवल्लीदलानि च ।\nमनोहराणि गीतानि नृत्यानि विविधानि च ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003773068, "chapter_id": 23773, "verse_number": "२-२-१७-६९", "content_sanskrit": "भरतस्य मुनेः शिक्षापंडितै रचितानि च ।\nस्वस्ववंशयशोऽभिज्ञाः शतशः सूतमागधाः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003773069, "chapter_id": 23773, "verse_number": "२-२-१७-७०", "content_sanskrit": "एतान्यन्यानि वस्तूनि दुर्लभान्यपि यानि वै ।\nत्रिदशाश्चापि मर्त्याश्चान्वभुज्यंत सुसादरम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003773070, "chapter_id": 23773, "verse_number": "२-२-१७-७१", "content_sanskrit": "एकतोऽन्यत्र चित्राणि न च हीनानि कुत्रचित् ।\nपातालवासिनां चापि भोजनं वै सुधाधिकम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003773071, "chapter_id": 23773, "verse_number": "२-२-१७-७२", "content_sanskrit": "यद्भुक्त्वा नानुवाञ्छन्ति पातालगमनं हि ते ।\nपुराणि यानि पाताले रत्नौघालोकितानि च ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003773072, "chapter_id": 23773, "verse_number": "२-२-१७-७३", "content_sanskrit": "विना सूर्यप्रकाशेन तादृशान्येव भूपतिः ।\nददौ तेषां निवासाय येषु पातालबुद्धयः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003773073, "chapter_id": 23773, "verse_number": "२-२-१७-७४", "content_sanskrit": "सुखासीनाश्च क्रीडंतो भुंजाना शेरते मुदा ।\nदेवानामपि नान्यत्र भूमिस्पर्शनमस्ति वै ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003773074, "chapter_id": 23773, "verse_number": "२-२-१७-७५", "content_sanskrit": "इन्द्रद्युम्नपुरे तत्र स्वर्गादपि मनोहरे ।\nयदृच्छया सुखक्रीडासक्ता नो तत्यजुर्भुवम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003773075, "chapter_id": 23773, "verse_number": "२-२-१७-७६", "content_sanskrit": "अभिलाषोपजातं तु सुखं स्वर्गे वदंति हि ।\nअनिच्छयापि भो विप्राः सुखं सर्वत्र तत्र वै ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003773076, "chapter_id": 23773, "verse_number": "२-२-१७-७७", "content_sanskrit": "आदृत्य यत्नान्मन्यंते भोज्यं ते सादरं नराः ।\nन याचितः कोपि जनः कुतो वा स्यात्पराङ्मुखः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003773077, "chapter_id": 23773, "verse_number": "२-२-१७-७८", "content_sanskrit": "राजाधिराजवेश्मानि जनानां स्वगृहैः समम् ।\nतदासीत्स्वगृहे तेषां न सदा सर्वसंभवः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003773078, "chapter_id": 23773, "verse_number": "२-२-१७-७९", "content_sanskrit": "तत्र यत्कामनातीतं तद्वस्तु सुलभं बहु ।\nइत्थं प्रवर्तिते यज्ञे यज्ञेशप्रीतये मुदा ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003773079, "chapter_id": 23773, "verse_number": "२-२-१७-८०", "content_sanskrit": "पृथिवी हृतसर्वस्वा वाजिमेधेस्य भूपतेः ।\nया पूर्वं साभवद्भूयः स्वर्णवृष्टिसुभूषिता ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003773080, "chapter_id": 23773, "verse_number": "२-२-१७-८१", "content_sanskrit": "इत्थं प्रवृत्ते लोकानां तत्र त्रैलोक्यवासिनाम् ।\nदानसंमानभोज्यानां विधौ विधिवतोऽन्वहम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003773081, "chapter_id": 23773, "verse_number": "२-२-१७-८२", "content_sanskrit": "अश्वमेधं प्रति जना जगुर्गाथाः परस्परम् ।\nनेदृग्यागस्य संभारो विधेः शास्त्रप्रचोदितः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003773082, "chapter_id": 23773, "verse_number": "२-२-१७-८३", "content_sanskrit": "इंद्रद्युम्नस्य राजर्षेर्न भूतो न भविष्यति ।\nन याचितारोऽदातारो मिथो यत्र निमंत्रिताः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003773083, "chapter_id": 23773, "verse_number": "२-२-१७-८४", "content_sanskrit": "न कामभंगो यत्रासीद्देवानामपि भो द्विजाः ।\nईदृक्समृद्धिः क्रतुराट् प्रवृत्तो भूपतेस्तदा ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003773084, "chapter_id": 23773, "verse_number": "२-२-१७-८५", "content_sanskrit": "अधिश्रद्धः सुसंपन्नः पूर्वस्मादपरोऽभवत् ।\nस्मृतिकाराः कल्पकारास्तथा शास्त्रप्रणेतृकाः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003773085, "chapter_id": 23773, "verse_number": "२-२-१७-८६", "content_sanskrit": "यज्ञानुष्ठानकुशलाः सदाचारावतंसकाः ।\nअग्न्याधानाद्यवभृथप्रचारमनुपूर्वशः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003773086, "chapter_id": 23773, "verse_number": "२-२-१७-८७", "content_sanskrit": "क्रतुः सदस्यानुमते नृपतेः प्रीतये द्विजाः ।\nन मंत्राः स्वरतो हीना वर्णतो वापि कर्हिचित् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003773087, "chapter_id": 23773, "verse_number": "२-२-१७-८८", "content_sanskrit": "ये वै विधिविधातारस्ते वै कर्मप्रचारकाः ।\nप्रायश्चित्तनिमित्तेन प्रायश्चित्तनिबंधनात् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003773088, "chapter_id": 23773, "verse_number": "२-२-१७-८९", "content_sanskrit": "कर्मोपघातो नो तत्र योगिनः कर्मयोगिनः ।\nयत्र सप्तर्षयो दिव्याः सदस्याः क्रतुसाक्षिणः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003773089, "chapter_id": 23773, "verse_number": "२-२-१७-९०", "content_sanskrit": "प्रचारयंति कर्माणि गुणदोषविभागिनः ।\nयाज्ञवल्क्यादयस्तेऽत्र मुनयस्त्वृत्विजो वृताः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003773090, "chapter_id": 23773, "verse_number": "२-२-१७-९१", "content_sanskrit": "सदोगतास्ते मुनयः परस्परकथांतरे ।\nवाकोवाक्यानि सूक्तानि गुह्योपनिषदानि च ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003773091, "chapter_id": 23773, "verse_number": "२-२-१७-९२", "content_sanskrit": "गाथाः पौराणिकीर्विप्रा विष्णुभक्तिपुरःसराः ।\nचरितानि हरेः सर्वकल्मषौघहराणि च ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003773092, "chapter_id": 23773, "verse_number": "२-२-१७-९३", "content_sanskrit": "तत्र संवर्तयामासुस्ते सभायां महीक्षितः ।\nतस्य यज्ञे हविः प्राशुः प्रत्यक्षं वह्निमध्यगाः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003773093, "chapter_id": 23773, "verse_number": "२-२-१७-९४", "content_sanskrit": "मुदितास्त्रिदशा विप्रा महेंद्रप्रमुखामखे ।\nचिरप्रवासिनो देवा नास्मरंतामरावतीम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003773094, "chapter_id": 23773, "verse_number": "२-२-१७-९५", "content_sanskrit": "अमृतं हि हविस्तेषां कल्पितं ब्रह्मणा पुरा ।\nतत्प्राश्य मुदिता देवा वीर्यवन्तश्चिरायुषः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003773095, "chapter_id": 23773, "verse_number": "२-२-१७-९६", "content_sanskrit": "यागानुष्ठानविषयादन्यत्र विषयान्बहून् ।\nइन्द्रद्युम्नेन रचितान्समस्तानुपभुंजते ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003773096, "chapter_id": 23773, "verse_number": "२-२-१७-९७", "content_sanskrit": "तत्र ये नागराजानः पातालतलवासिनः ।\nततोऽधिकान्मर्त्यलोके विषयानुपभुंजते ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003773097, "chapter_id": 23773, "verse_number": "२-२-१७-९८", "content_sanskrit": "पातालगमनं ते वै नेहंते मनसा धुवम् ।\nइत्थं प्रवर्तितो यज्ञस्त्रैलोक्यप्रीतिकारकः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003773098, "chapter_id": 23773, "verse_number": "२-२-१७-९९", "content_sanskrit": "इन्द्रद्युम्नस्य नृपतेः क्षेत्रेऽस्मिन्पुरुषोत्तमे ।\nजगदीशप्रसादाय पितामहनिदेशतः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003773099, "chapter_id": 23773, "verse_number": "२-२-१७-१००", "content_sanskrit": "एकोनं क्रमतः संस्थामवाप पृथिवीपतिः ।\nसहस्रं हयमेधस्य यथावद्विधिचोदितम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003773100, "chapter_id": 23773, "verse_number": "२-२-१७-१०१", "content_sanskrit": "ततः साहस्रिके यज्ञे वाजिमेधे महीपतिः ।\nदिनेदिने दिव्यगतिर्बभूव नृपतिस्तदा ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003773101, "chapter_id": 23773, "verse_number": "२-२-१७-१०२", "content_sanskrit": "सुत्यायाः सप्त दिवसाद्या रात्रिरभवत्पुरा ।\nतस्यास्तुरीयप्रहरे दध्यौ स विष्णुमव्ययम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003773102, "chapter_id": 23773, "verse_number": "२-२-१७-१०३", "content_sanskrit": "ध्याने तस्मिन्ददर्शासौ महाभाग्यवशान्नृपः ।\nप्रत्यक्षमिव स श्वेतद्वीपं स्फटिकनिर्मितम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003773103, "chapter_id": 23773, "verse_number": "२-२-१७-१०४", "content_sanskrit": "समंतात्परिवार्यैनं तिष्ठंतं क्षीरसागरम् ।\nमहाकल्पद्रुमैः पुष्पगंधामोदिदिगंतरैः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003773104, "chapter_id": 23773, "verse_number": "२-२-१७-१०५", "content_sanskrit": "फलपल्लववल्केषु बहिरंतश्च सर्वशः ।\nशंखचक्रांकितैः शुभ्रैः सर्वालंकारभूषितः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003773105, "chapter_id": 23773, "verse_number": "२-२-१७-१०६", "content_sanskrit": "महामंजिष्ठवर्णैश्च मूर्तिभिस्तैर्मुरद्विषः ।\nतन्मध्ये घटितं दिव्यमणिभिर्मंडपोत्तमम् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003773106, "chapter_id": 23773, "verse_number": "२-२-१७-१०७", "content_sanskrit": "मध्यस्थसूर्यवद्भासिरत्नसिंहासनोज्ज्वलम् ।\nक्षीराब्धिशीतकल्लोलमंदवातमनोहरम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003773107, "chapter_id": 23773, "verse_number": "२-२-१७-१०८", "content_sanskrit": "तन्मध्ये ददृशे देवं शंखचक्रगदाधरम् ।\nनीलजीमूतसंकाशं वनमालाविभूषितम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003773108, "chapter_id": 23773, "verse_number": "२-२-१७-१०९", "content_sanskrit": "सर्वलावण्यभवनं सौंदर्यश्रीनिकेतनम् ।\nनिर्भर्त्सयंतं वपुषा पिनद्धं दिव्यभूषणम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003773109, "chapter_id": 23773, "verse_number": "२-२-१७-११०", "content_sanskrit": "दक्षपार्श्वे स्थितं तत्र अनंतं धरणीधरम् ।\nकोटिचन्द्रप्रतीकाशं हिमाद्रिसदृशप्रभम् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003773110, "chapter_id": 23773, "verse_number": "२-२-१७-१११", "content_sanskrit": "फणामुकुटविस्तारच्छत्रीभूतं मनोहरम् ।\nमणिकुंडलयुग्मांकं चारुनीलनिचोलकम् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003773111, "chapter_id": 23773, "verse_number": "२-२-१७-११२", "content_sanskrit": "हललांगलशंखारिस्फुरद्बाहुचतुष्टयम् ।\nहारकेयूरवलय मुद्रिकाभिरलंकृतम् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003773112, "chapter_id": 23773, "verse_number": "२-२-१७-११३", "content_sanskrit": "मेखलाकटिसूत्राढ्यं दिव्यरत्नप्रसाधनम् ।\nदिव्यहालाक्षीबमूर्तिं चारुहासं सुनेत्रकम् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003773113, "chapter_id": 23773, "verse_number": "२-२-१७-११४", "content_sanskrit": "दक्षपार्श्वस्थितां चास्य लक्ष्मीं तां शुभलक्षणाम् ।\nवराभयाब्जहस्तां वै कुंकुमाभां सुलोचनाम् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003773114, "chapter_id": 23773, "verse_number": "२-२-१७-११५", "content_sanskrit": "त्रैलोक्ययुवतीवृन्ददृष्टांताद्भुतविग्रहाम् ।\nददर्श पद्मासनगां लावण्यांबुधिपुत्रिकाम् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003773115, "chapter_id": 23773, "verse_number": "२-२-१७-११६", "content_sanskrit": "पितामहं च ददृशे पुरतोऽस्य कृतांजलिम् ।\nवामपार्श्वस्थितं चक्रं नानामणिमयं विभोः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003773116, "chapter_id": 23773, "verse_number": "२-२-१७-११७", "content_sanskrit": "सनकाद्यैर्मुनींद्रैस्तं स्तूयमानं जगद्गुरुम् ।\nदृष्ट्वा स्वप्ने स राजा वै प्रहृष्टो द्विजसत्तमाः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003773117, "chapter_id": 23773, "verse_number": "२-२-१७-११८", "content_sanskrit": "अदृष्टपूर्वरूपं तं ज्योतिर्मयमनंतकम् ।\nतुष्टाव तत्र ध्यानस्थो हर्षगद्गदया गिरा ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003773118, "chapter_id": 23773, "verse_number": "२-२-१७-११९", "content_sanskrit": "इन्द्रद्युम्न उवाच ।\nनमस्ते जगदाधार जगदात्मन्नमोऽस्तु ते ।\nकैवल्यत्रिगुणातीत गुणांजन नमोऽस्तु ते ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003773119, "chapter_id": 23773, "verse_number": "२-२-१७-१२०", "content_sanskrit": "सुशुद्धनिर्मलज्ञानस्वरूपाय नमोऽस्तु ते ।\nशब्दब्रह्माभिधानाय जगद्रूपाय ते नमः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003773120, "chapter_id": 23773, "verse_number": "२-२-१७-१२१", "content_sanskrit": "संसारपतितश्रांत दुःखध्वंस नमोऽस्तु ते ।\nदुर्भेद्यहृदयग्रंथिभेदकाय नमोऽस्तु ते ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003773121, "chapter_id": 23773, "verse_number": "२-२-१७-१२२", "content_sanskrit": "द्विसप्तभुवनागारमूलस्तंभाय ते नमः ।\nब्रह्मांडकोटिघटनाशिल्पिने चक्रिणे नमः ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003773122, "chapter_id": 23773, "verse_number": "२-२-१७-१२३", "content_sanskrit": "करुणामृतपाथोधिसुधाधाम्ने नमो नमः ।\nदीनोद्धारैकगुह्याय कृपापाथोधये नमः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003773123, "chapter_id": 23773, "verse_number": "२-२-१७-१२४", "content_sanskrit": "प्रकाशकानां सूर्यादिज्योतिषां ज्योतिषे नमः ।\nप्रतिस्वस्वनदीप्ताय अन्तःपापाग्नये नमः ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7003773124, "chapter_id": 23773, "verse_number": "२-२-१७-१२५", "content_sanskrit": "पावकाय पवित्राय पवित्राणां नमो नमः ।\nगरिष्ठाय वरिष्ठाय द्राघिष्ठाय नमो नमः ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7003773125, "chapter_id": 23773, "verse_number": "२-२-१७-१२६", "content_sanskrit": "नेदिष्ठाय दविष्ठाय क्षोदिष्ठाय नमो नमः ।\nवरेण्याय सुपुण्याय नारायण नमोऽस्तु ते ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7003773126, "chapter_id": 23773, "verse_number": "२-२-१७-१२७", "content_sanskrit": "परित्राहि जगन्नाथ दीनबन्धो नमोऽस्तु ते ।\nनिस्तीर्णोऽहं भवांभोधिं प्राप्य त्वां तरणिं सुखाम् ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7003773127, "chapter_id": 23773, "verse_number": "२-२-१७-१२८", "content_sanskrit": "त्वयि दृष्टे रमानाथ क्लेशा व्यपगता मम ।\nचिदानंदस्वरूपं त्वां प्राप्तानां दुःखसंक्षयः ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7003773128, "chapter_id": 23773, "verse_number": "२-२-१७-१२९", "content_sanskrit": "ध्रुवं नाथ समुत्पन्नपरमानंदहेतुकम् ।\nत्राहि त्राहि भवांभोधिमग्नं मां दीनचेतसम् ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7003773129, "chapter_id": 23773, "verse_number": "२-२-१७-१३०", "content_sanskrit": "मध्याह्नार्कोदिते व्योम्नि कुतः संतमसोदयः ।\nध्यानस्थितः स्तुवन्नेवं प्रणम्य जगदीश्वरम् ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7003773130, "chapter_id": 23773, "verse_number": "२-२-१७-१३१", "content_sanskrit": "ध्यानावसाने स पुनः स्वयं जाग्रदबुध्यत ।\nस्वप्नांत इन्द्रद्युम्नोऽपि सस्मारात्मानमात्मना ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7003773131, "chapter_id": 23773, "verse_number": "२-२-१७-१३२", "content_sanskrit": "अत्यद्भुतमिदं स्वप्नं दृष्ट्वा च नृपकुंजरः ।\nमेने कृतार्थमात्मानं हयमेधक्रतोस्तथा ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7003773132, "chapter_id": 23773, "verse_number": "२-२-१७-१३३", "content_sanskrit": "सहस्रं सफलं चैव स्वभाग्यं समुपस्थितम् ।\nन हि देवर्षिवचनं वृथा भवति कर्हिचित् ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7003773133, "chapter_id": 23773, "verse_number": "२-२-१७-१३४", "content_sanskrit": "प्रत्यक्षं मे कथं नाथः स्वयमत्र भविष्यति ।\nइति चिंताकुलो रात्रिशेषं नीत्वा विशांपतिः ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7003773134, "chapter_id": 23773, "verse_number": "२-२-१७-१३५", "content_sanskrit": "शशंस नारदस्याग्रे यथा स्वप्नोऽन्वभूयत ।\nस चापि नारदः प्राह शोकस्ते विगतो नृप ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7003773135, "chapter_id": 23773, "verse_number": "२-२-१७-१३६", "content_sanskrit": "अरुणोदयकाले हि भगवंतं ददर्श यत् ।\nदशाहात्फलदः स्वप्नस्तस्मिन्काले नृपोत्तम ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7003773136, "chapter_id": 23773, "verse_number": "२-२-१७-१३७", "content_sanskrit": "क्रत्वंते भगवानत्र प्रत्यक्षस्ते भविष्यति ।\nयदाह मद्गिरा त्वां हि चराचरगुरुर्विधिः ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7003773137, "chapter_id": 23773, "verse_number": "२-२-१७-१३८", "content_sanskrit": "सोऽपि त्वया जगत्स्रष्टा स्वप्नेऽस्मिन्नवलोकितः ।\nतदनुष्ठीयतां यज्ञः पराग्रे न प्रकाशय ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7003773138, "chapter_id": 23773, "verse_number": "२-२-१७-१३९", "content_sanskrit": "स्वप्नोऽयं नृपशार्दूल दुर्बोधाचरितो हरेः ।\nकिंतु भाग्यवतस्त्वेव स्वप्नस्तादृक्प्रजायते ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7003773139, "chapter_id": 23773, "verse_number": "२-२-१७-१४०", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे पुरुषोत्तमक्षेत्रमाहात्म्ये जैमिनिऋषिसंवादे सप्तदशोऽध्यायः ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}]