[{"id": 2142525, "chapter_id": 4073, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2142526, "chapter_id": 4073, "verse_number": "१", "content_sanskrit": "द्रुपदेनैवमुक्ते तु वाक्ये वाक्यविदां वरः ।\nवसुदेवसुतस्तत्र वृष्णिसिंहोऽब्रवीदिदम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2142527, "chapter_id": 4073, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2142528, "chapter_id": 4073, "verse_number": "२", "content_sanskrit": "उपपन्नमिदं वाक्यं सोमकानां धुरन्धरे ।\nअर्थसिद्धिकरं राज्ञः पाण्डवस्यामितौजसः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2142529, "chapter_id": 4073, "verse_number": "३", "content_sanskrit": "एतच्च पूर्वं कार्यं नः सुनीतिमभिकाङ्क्षताम् ।\nअन्यथा ह्याचरन् कर्म पुरुषः स्यात् सुबालिशः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2142530, "chapter_id": 4073, "verse_number": "४", "content_sanskrit": "किन्तु सम्बन्धकं तुल्यमस्माकं कुरुपाण्डुषु ।\nयथेष्टं वर्तमानेषु पाण्डवेषु च तेषु च\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2142531, "chapter_id": 4073, "verse_number": "५", "content_sanskrit": "ते विवाहार्थमानीता वयं सर्वे यथा भवान् ।\nकृते विवाहे मुदिता गमिष्यामो गृहान् प्रति\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2142532, "chapter_id": 4073, "verse_number": "६", "content_sanskrit": "भवान् वृद्धतरो राज्ञां वयसा च श्रुतेन च ।\nशिष्यवत् ते वयं सर्वे भवामेह न संशयः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2142533, "chapter_id": 4073, "verse_number": "७", "content_sanskrit": "भवन्तं धृतराष्ट्रश्च सततं बहुमन्यते ।\nआचार्ययोः सखा चासि द्रोणस्य च कृपस्य च\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2142534, "chapter_id": 4073, "verse_number": "८", "content_sanskrit": "स भवान् प्रेषयत्वद्य पाण्डवार्थकरं वचः ।\nसर्वेषां निश्चितं तन्नः प्रेषयिष्यति यद् भवान्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2142535, "chapter_id": 4073, "verse_number": "९", "content_sanskrit": "यदि तावच्छमं कुर्यान्न्यायेन कुरुपुङ्गवः ।\nन भवेत् कुरुपाण्डूनां सौभ्रात्रेण महान् क्षयः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2142536, "chapter_id": 4073, "verse_number": "१०", "content_sanskrit": "अथ दर्पान्वितो मोहान्न कुर्याद् धृतराष्ट्रजः ।\nअन्येषां प्रेषयित्वा च पश्चादस्मान् समाह्वयेत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2142537, "chapter_id": 4073, "verse_number": "११", "content_sanskrit": "ततो दुर्योधनो मन्दः सहामात्यः सबान्धवः ।\nनिष्ठामापत्स्यते मूढः क्रुद्धे गाण्डीवधन्वनि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2142538, "chapter_id": 4073, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2142539, "chapter_id": 4073, "verse_number": "१२", "content_sanskrit": "ततः सत्कृत्य वार्ष्णेयं विराटः पृथिवीपतिः ।\nगृहान् प्रस्थापयामास सगणं सहबान्धवम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2142540, "chapter_id": 4073, "verse_number": "१३", "content_sanskrit": "द्वारकां तु गते कृष्णे युधिष्ठिरपुरोगमाः ।\nचक्रुः साङ्ग्रामिकं कर्म विराटश्च महीपतिः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2142541, "chapter_id": 4073, "verse_number": "१४", "content_sanskrit": "ततः सम्प्रेषयामास विराटः सह बान्धवैः ।\nसर्वेषां भूमिपालानां द्रुपदश्च महीपतिः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2142542, "chapter_id": 4073, "verse_number": "१५", "content_sanskrit": "वचनात् कुरुसिंहस्य मत्स्यपाञ्चालयोस्तथा ।\nसमाजग्मुर्महीपालाः सम्प्रहृष्टा महाबलाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2142543, "chapter_id": 4073, "verse_number": "१६", "content_sanskrit": "तच्छ्रुत्वा पाण्डुपुत्राणां समागच्छन्महाबलम् ।\nधृतराष्ट्रसुतश्चापि समानिन्ये महीपतीन्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2142544, "chapter_id": 4073, "verse_number": "१७", "content_sanskrit": "समाकुला मही राजन् कुरुपाण्डवकारणात् ।\nतदा समभवत् कृत्स्ना सम्प्रयाणे महीक्षिताम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2142545, "chapter_id": 4073, "verse_number": "१८", "content_sanskrit": "सङ्कुला च तदा भूमिः चतुरङ्गबलान्विता\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2142546, "chapter_id": 4073, "verse_number": "१९", "content_sanskrit": "बलानि तेषां भीमानि आगच्छन्ति ततस्ततः ।\nचालयन्तीव गां देवीं सपर्वतवनामिमाम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2142547, "chapter_id": 4073, "verse_number": "२०", "content_sanskrit": "ततः प्रज्ञावयोवृद्धं पाञ्चाल्यः स्वपुरोहितम् ।\nकुरुभ्यः प्रेषयामास युधिष्ठिरमते स्थितः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2142548, "chapter_id": 4073, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि पञ्चमोऽध्यायः ॥५॥ सेनोद्योगपर्वणि पञ्चमोऽध्यायः ॥५॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]