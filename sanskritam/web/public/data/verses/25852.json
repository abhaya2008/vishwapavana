[{"id": 7005852000, "chapter_id": 25852, "verse_number": "१-३५-१", "content_sanskrit": "हरिरुवाच ।\nन्यासादिकं प्रवक्ष्यामि गायत्र्याः शृणु ङ्कर।\nविश्वामित्रऋषिश्चैव सविता चाथ देवता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005852001, "chapter_id": 25852, "verse_number": "१-३५-२", "content_sanskrit": "ब्रह्मशीर्षा रुद्रशिखा विष्णोर्हृदसंश्रिता।\nविनियोगैकनयना कात्यायनसगोत्रजा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005852002, "chapter_id": 25852, "verse_number": "१-३५-३", "content_sanskrit": "त्रैलोक्यचरणा ज्ञेया पृथिवीकुक्षिसंस्थिता ।\nएवं ज्ञात्वा तु गायत्त्रीं जपेद्द्वादशलक्षकम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005852003, "chapter_id": 25852, "verse_number": "१-३५-४", "content_sanskrit": "त्रिपदाष्टाक्षरा ज्ञेया चतुष्पादा षडक्षरा ।\nजेप च त्रिपदा प्रोक्ता अर्चने च चतुष्पदा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005852004, "chapter_id": 25852, "verse_number": "१-३५-५", "content_sanskrit": "न्यासे जपे तथा ध्याने अग्निकार्य्ये तथार्चने।\nगायत्त्रीं विन्यसेन्नित्यं सर्वपापप्रणाशिनीम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005852005, "chapter_id": 25852, "verse_number": "१-३५-६", "content_sanskrit": "पादाङ्गुष्ठे गुल्फमध्ये जङ्घयोर्विद्धि जानुनोः।\nऊर्वोर्गुह्ये च वृषणे नाड्यां नाभौ तनूदरे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005852006, "chapter_id": 25852, "verse_number": "१-३५-७", "content_sanskrit": "स्तनयोर्हृदि कण्ठौष्ठमुखे तालुनि चांसयोः ।\nनेत्रे भुवार्ललाटे च पूर्वस्यां दक्षिणोत्तरे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005852007, "chapter_id": 25852, "verse_number": "१-३५-८", "content_sanskrit": "पश्चमे मूर्ध्नि चाकारं न्यसेद्वर्णान्वदाम्यहम् ।\nइन्द्रनीलं च वह्निं च पीतं श्यामं च कापिलम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005852008, "chapter_id": 25852, "verse_number": "१-३५-९", "content_sanskrit": "श्वेतं विद्युत्प्रभं तारं कृष्णं रक्तं क्रमेण त्।\nश्यामं शुक्लं तथा पीतं श्वेतं वै पद्मरागवत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005852009, "chapter_id": 25852, "verse_number": "१-३५-१०", "content_sanskrit": "शङ्खवर्णं पाण्डुरं च रक्तं चासवसन्निभम् ।\nअर्कवर्णसमं सौम्यं शङ्खाभं श्वेतमेव च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005852010, "chapter_id": 25852, "verse_number": "१-३५-११", "content_sanskrit": "यद्यत्स्पृशति हस्तेन यच्च पश्यति चक्षुषा ।\nपूतं भवति तत्सर्वं गायत्त्र्या न परं विदुः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005852011, "chapter_id": 25852, "verse_number": "१-३५-१२", "content_sanskrit": "इति श्रीगारुडे महापुराणे पूर्वखण्डे प्रथमांशाख्ये आचारकाण्डे गायत्त्रीन्यासनिरूपणं नाम पञ्चत्रिंशोऽध्यायः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]