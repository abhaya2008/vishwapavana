[{"id": 6000116000, "chapter_id": 10116, "verse_number": null, "content_sanskrit": "अथ एकविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000116001, "chapter_id": 10116, "verse_number": null, "content_sanskrit": "श्री शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_021/BhP_05.021.001.m4a", "display_order": 2}, {"id": 6000116002, "chapter_id": 10116, "verse_number": "५-२१-१", "content_sanskrit": "एतावानेव भूवलयस्य सन्निवेशः प्रमाणलक्षणतश्च व्याख्यातः।\nएतेनैव हि दिवो मण्डलमानं तद्विद उपदिशन्ति॥ ५/२१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_021/BhP_05.021.002.m4a", "display_order": 3, "topics": [{"text": "दिवोमण्डलमानम्", "range": "१–२"}]}, {"id": 6000116003, "chapter_id": 10116, "verse_number": "५-२१-२", "content_sanskrit": "यथा द्विदलनिष्पावादीनां तदन्तरेणान्तरिक्षमुपसन्धितम्॥ ५/२१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_021/BhP_05.021.003.m4a", "display_order": 4}, {"id": 6000116004, "chapter_id": 10116, "verse_number": "५-२१-३", "content_sanskrit": "यन्मध्यगो भगवांस्तपतां पतिस्तपन आतपेन त्रिलोकान् प्रतपत्यवभासयत्यात्मभासा एष उदगयन-दक्षिणायनवैषुवसंज्ञाभिरारोहणावरोहणादिभिर्दीर्घह्रस्वसमानाभिर्गतिभिरारोहणावरोहण- समस्थानेषु यथासवनमभिपद्यमानो मकरादिराशिष्वहोरात्राणि दीर्घह्रस्वसमानानि विधत्ते॥ ५/२१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_021/BhP_05.021.004.m4a", "display_order": 5, "topics": [{"text": "सूर्यरथवर्णनम्", "range": "३–१८"}]}, {"id": 6000116005, "chapter_id": 10116, "verse_number": "५-२१-४", "content_sanskrit": "यदा मेषतुलयोर्वर्तते तदाऽहोरात्राणि समानानि भवन्ति॥ ५/२१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_021/BhP_05.021.005.m4a", "display_order": 6}, {"id": 6000116006, "chapter_id": 10116, "verse_number": "५-२१-५", "content_sanskrit": "यदा वृषभादिषु पञ्चसु राशिषु चरति तदाऽहान्येव वर्धन्ते, ह्रसन्ति च रात्रयः, मासि मास्येकैका घटिका, तुल्यं दिवसं, वर्धमानान्यहानि, तावतीरनुसंक्षीयमाणा रात्रयः।\nसमुद्धृत्य समान्यहोरात्राणि त्रिंशन्मुहूर्तान्येव भवन्ति।\nयदा वृश्चिकादिषु पञ्चसु वर्तते तदाऽहोरात्राणि विपरीतानि भवन्ति॥ ५/२१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_021/BhP_05.021.006.m4a", "display_order": 7}, {"id": 6000116007, "chapter_id": 10116, "verse_number": "५-२१-६", "content_sanskrit": "यावद्दक्षिणायनमहानि वर्धन्ते, ह्रसन्ति च रात्रयः, यावदुदगयनमहानि ह्रसन्ति, रात्रयो वर्धन्ते॥ ५/२१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_021/BhP_05.021.007.m4a", "display_order": 8}, {"id": 6000116008, "chapter_id": 10116, "verse_number": "५-२१-७", "content_sanskrit": "एवं नवकोट्य एकपञ्चाशल्लक्षाणि च योजनानां मानसोत्तरगिरिपरिवर्तनस्योपदिशन्ति।\nतस्मिन्नैन्द्रीपुरी मेरोः पूर्वस्माद्देवधानी नाम, दक्षिणतो याम्या संयमिनी नाम पश्चाद्वारुणी निम्लोचनी नाम्, उत्तरतः सौम्या विभावरी नाम, तासूदयमध्याह्नास्तमयनिशीथानीति भूतानां प्रवृत्तिनिवृत्तिनिमित्तानि समयविशेषेण मेरोश्चतुर्दिशम्॥ ५/२१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_021/BhP_05.021.008.m4a", "display_order": 9}, {"id": 6000116009, "chapter_id": 10116, "verse_number": "५-२१-८", "content_sanskrit": "तत्रत्यानां दिवसमध्यगत एव सदाऽऽदित्यस्तपति सव्येनाचलं दक्षिणेन करोति॥ ५/२१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_021/BhP_05.021.009.m4a", "display_order": 10}, {"id": 6000116010, "chapter_id": 10116, "verse_number": "५-२१-९", "content_sanskrit": "यत्रोदेति तत्समानसूत्रनिपाते निम्लोचति।\nयत्र क्‍व च न स्यन्दते तत्र हैष समानसूत्रनिपाते प्रस्वापयति तत्र गतं न पश्यन्ति।॥ ५/२१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_021/BhP_05.021.010.m4a", "display_order": 11}, {"id": 6000116011, "chapter_id": 10116, "verse_number": "५-२१-१०", "content_sanskrit": "यदा चैन्द्र्याः पुर्याः प्रतिचलति पञ्चदशभिर्घटिकाभिर्याम्यां सपादकोटिद्वयं योजनानां सार्धद्वादशलक्षाणि साधिकानि चोपयाति॥ ५/२१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_021/BhP_05.021.011.m4a", "display_order": 12}, {"id": 6000116012, "chapter_id": 10116, "verse_number": "५-२१-११", "content_sanskrit": "एवं ततो वारुणीं सौम्यामैद्रीं च पुनः पुनः।\nतथाऽन्ये च ग्रहाः सोमादयो नक्षत्रैः सह ज्योतिश्चक्रेण समभ्युद्यन्ति सह चाभिनिम्लोचन्ति॥ ५/२१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_021/BhP_05.021.012.m4a", "display_order": 13}, {"id": 6000116013, "chapter_id": 10116, "verse_number": "५-२१-१२", "content_sanskrit": "एवं मुहूर्ते चतुस्‍त्रिंशल्लक्षयोजनान्यष्टशताधिकानि सौरो रथस्‍त्रयीमयोऽसौ चतसृषु परिवर्तते पुरीषु॥ ५/२१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_021/BhP_05.021.013.m4a", "display_order": 14}, {"id": 6000116014, "chapter_id": 10116, "verse_number": "५-२१-१३", "content_sanskrit": "यस्यैकं चक्रं द्वादशारं षण्नेमि त्रिनाभि स्वयं संवत्सरात्मकं समामनन्ति, तस्याक्षो मेरोर्मूर्धनि कृतो मानसोत्तरे कृतेतरभागो यत्र प्रोतं रविरथचक्रं तैलयन्त्रवन्मानसोत्तरे गिरौ परिभ्रमति॥ ५/२१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_021/BhP_05.021.014.m4a", "display_order": 15}, {"id": 6000116015, "chapter_id": 10116, "verse_number": "५-२१-१४", "content_sanskrit": "तस्मिन्नक्षे कृतमूलो द्वितीयोऽक्षस्तुरीयमानेन संमितः॥ ५/२१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_021/BhP_05.021.015.m4a", "display_order": 16}, {"id": 6000116016, "chapter_id": 10116, "verse_number": "५-२१-१५", "content_sanskrit": "तैलयन्त्राक्षवद्ध्रुवे कृतोपरिभागो रथनीडस्तु षड्विंशल्लक्षयोजनायतस्तुरीयभागविशालस्तावान् रविरथयुगो यत्र हयाश्छन्दोनामानः सप्तारुणयोजिता वहन्ति देवमादित्यम्॥ ५/२१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_021/BhP_05.021.016.m4a", "display_order": 17}, {"id": 6000116017, "chapter_id": 10116, "verse_number": "५-२१-१६", "content_sanskrit": "पुरस्तात्सवितुररुणः पश्चान्नियुक्तः सौत्ये कर्मणि किलास्ते॥ ५/२१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_021/BhP_05.021.017.m4a", "display_order": 18}, {"id": 6000116018, "chapter_id": 10116, "verse_number": "५-२१-१७", "content_sanskrit": "तथा वालखिल्या ऋषयोऽङ्गुष्ठपर्वमात्राः षष्टिसहस्राणि पुरतः सूर्यं सूक्तवाकाय नियुक्ताः संस्तुवन्ति॥ ५/२१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_021/BhP_05.021.018.m4a", "display_order": 19}, {"id": 6000116019, "chapter_id": 10116, "verse_number": "५-२१-१८", "content_sanskrit": "तथाऽन्ये च ऋषयो गन्धर्वाप्सरसो नागा ग्रामण्यो यातुधाना देवा इत्येकैकशो गणाः सप्त चैकैकशो रथस्था मासि मासि भगवन्तं सूर्यमात्मानं नानानामानं पृथङ्नामानः पृथक्कर्मभिर्द्वादश उपासते॥ ५/२१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_021/BhP_05.021.019.m4a", "display_order": 20}, {"id": 6000116020, "chapter_id": 10116, "verse_number": "५-२१-१९", "content_sanskrit": "लक्षोत्तरसार्धनवकोटियोजनपरिमण्डलभूवलयस्य क्षणेन गव्यूत्युत्तरद्विसहस्रयोजनानि स भुङ्क्ते॥ ५/२१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_021/BhP_05.021.020.m4a", "display_order": 21}, {"id": 6000116021, "chapter_id": 10116, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते चतुर्थस्कन्धे एकविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]