[{"id": 2214447, "chapter_id": 5584, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2214448, "chapter_id": 5584, "verse_number": "१", "content_sanskrit": "ततो युधिष्ठिरो राजा देवैः सर्षिमरुद्गणैः ।\nपूज्यमानो ययौ तत्र यत्र ते कुरुपुङ्गवाः\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2214449, "chapter_id": 5584, "verse_number": "२", "content_sanskrit": "ददर्श तत्र गोविन्दं ब्राह्मेण वपुषाऽन्वितम् ।\nतेनैव दृष्टपूर्वेण सादृश्येनैव सूचितम्\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2214450, "chapter_id": 5584, "verse_number": "३", "content_sanskrit": "दीप्यमानं स्ववपुषा दिव्यैरस्त्रैरुपस्थितम् ।\nचक्रप्रभृतिभिर्घोरैर्दिव्यैः पुरुषविग्रहैः\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2214451, "chapter_id": 5584, "verse_number": "४", "content_sanskrit": "उपास्यमानं वीरेण फल्गुनेन सुवर्चसा ।\nतथा स्वरूपं कौन्तेयो ददर्श मधुसूदनम्\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2214452, "chapter_id": 5584, "verse_number": "५", "content_sanskrit": "तावुभौ पुरुषव्याघ्रौ समुद्वीक्ष्य युधिष्ठिरम् ।\nयथावत् प्रतिपेदाते पूजया देवपूजितौ\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2214453, "chapter_id": 5584, "verse_number": "६", "content_sanskrit": "अपरस्मिन्नथोद्देशे कर्णं शस्त्रभृतां वरम् ।\nद्वादशादित्यसहितं ददर्श कुरुनन्दनः\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2214454, "chapter_id": 5584, "verse_number": "७", "content_sanskrit": "तथापरस्मिन्नुद्देशे मरुद्गणवृतं विभुम् ।\nभीमसेनमथापश्यत्तेनैव वपुषाऽन्वितम्\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2214455, "chapter_id": 5584, "verse_number": "८", "content_sanskrit": "वायोर्मूर्तिमतः पार्श्वे दिव्यमूर्तिसमन्वितम् ।\nश्रिया परमया युक्तं सिद्धिं परमिकां गतम्\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2214456, "chapter_id": 5584, "verse_number": "९", "content_sanskrit": "अश्विनोस्तु तथा स्थाने दीप्यमानौ स्वतेजसा ।\nनकुलं सहदेवं च ददर्श कुरुनन्दनः\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2214457, "chapter_id": 5584, "verse_number": "१०", "content_sanskrit": "तथा ददर्श पाञ्चालीं कमलोत्पलमालिनीम् ।\nवपुषा स्वर्गमाक्रम्य तिष्ठन्तीमर्कवर्चसम्\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2214458, "chapter_id": 5584, "verse_number": "११", "content_sanskrit": "तत्रैनां सहसा राजा स्पष्ट्रुमैच्छद् युधिष्ठिरः ।\nततोऽस्य भगवानिन्द्रः कथयामास देवराट्\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2214459, "chapter_id": 5584, "verse_number": "१२", "content_sanskrit": "श्रीरेषा द्रौपदीरूपा त्वदर्थे मानुषीकृता ।\nअयोनिजा लोककान्ता पुण्यगन्धा युधिष्ठिर\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2214460, "chapter_id": 5584, "verse_number": "१३", "content_sanskrit": "द्रुपदस्य कुले जाता भवद्भिश्चोपजीविता ।\nरत्यर्थं भवतां ह्येषा निर्मिता शूलपाणिना\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2214461, "chapter_id": 5584, "verse_number": "१४", "content_sanskrit": "एते पञ्च महाभागा गन्धर्वाः पावकप्रभाः ।\nद्रौपद्यास्तनया राजन् युष्माकममितौजसः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2214462, "chapter_id": 5584, "verse_number": "१५", "content_sanskrit": "पश्य गन्धर्वराजानं धृतराष्ट्रं मनीषिणम् ।\nएनं च त्वं विजानीहि भ्रातरं पूर्वजं पितुः\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2214463, "chapter_id": 5584, "verse_number": "१६", "content_sanskrit": "अयं ते पूर्वजो भ्राता कौन्तेयः पावकद्युतिः ।\nसूर्यपुत्रो रथिश्रेष्ठो राधेय इति विश्रुतः\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2214464, "chapter_id": 5584, "verse_number": "१७", "content_sanskrit": "आदित्यसहितो भाति पश्यैनं पुरुषर्षभम्\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2214465, "chapter_id": 5584, "verse_number": "१८", "content_sanskrit": "साध्यानामथ देवानां विश्वेषां मरुतामपि ।\nगणेषु पश्य राजेन्द्र वृष्ण्यन्धकमहारथान्\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2214466, "chapter_id": 5584, "verse_number": "१९", "content_sanskrit": "सात्यकिप्रमुखान् वीरान् भोजांश्चैव महाबलान्\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2214467, "chapter_id": 5584, "verse_number": "२०", "content_sanskrit": "सोमेन सहितं पश्य सौभद्रमपराजितम् ।\nअभिमन्युं महेष्वासं निशाकरसमद्युतिम्\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2214468, "chapter_id": 5584, "verse_number": "२१", "content_sanskrit": "एष पाण्डुर्महेष्वासः कुन्त्या माद्र्या च सङ्गतः ।\nविमानेन सदाऽभ्येति पिता तव ममान्तिकम्\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2214469, "chapter_id": 5584, "verse_number": "२२", "content_sanskrit": "वसुभिः सहितं पश्य भीष्मं शान्तनवं नृपम् ।\nद्रोणं बृहस्पतेः पार्श्वे गुरुमेनं निशामय\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2214470, "chapter_id": 5584, "verse_number": "", "content_sanskrit": "एते चान्ये महीपाला योधास्तव च पाण्डव ।\n(गन्धर्वसहिता यान्ति यक्षपुण्यजनैस्तथा\t ॥२३॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2214471, "chapter_id": 5584, "verse_number": "२४", "content_sanskrit": "गुह्यकानां गतिं चापि केचित् प्राप्ता नराधिपाः ।\nत्यक्त्वा देहं जितः स्वर्गः पुण्यवाग्बुद्धिकर्मभिः\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2214472, "chapter_id": 5584, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2214473, "chapter_id": 5584, "verse_number": "२५", "content_sanskrit": "भीष्मद्रौणौ महात्मानौ धृतराष्ट्रश्च पार्थिवः ।\nविराटद्रुपदौ चोभौ शङ्खश्चैवोत्तरस्तथा\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2214474, "chapter_id": 5584, "verse_number": "२६", "content_sanskrit": "धृष्टकेतुर्जयत्सेनो राजा चैव स सत्यजित् ।\nदुर्योधनसुताश्चैव शकुनिश्चैव सौबलः\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2214475, "chapter_id": 5584, "verse_number": "२७", "content_sanskrit": "कर्णपुत्राश्च विक्रान्ता राजा चैव जयद्रथः ।\nघटोत्कचादयश्चैव ये चान्ये नानुकीर्तिताः\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2214476, "chapter_id": 5584, "verse_number": "२८", "content_sanskrit": "ये चान्ये कीर्तिता वीरा राजानो दीप्तमूर्तयः ।\nस्वर्गे कालं कियन्तं ते तस्थुस्तदपि शंस मे\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2214477, "chapter_id": 5584, "verse_number": "२९", "content_sanskrit": "आहोस्विच्छाश्वतं स्थानं तेषां तत्र द्विजोत्तम ।\nअन्ते वा कर्मणां कां ते गतिं प्राप्ता नरर्षभाः\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2214478, "chapter_id": 5584, "verse_number": "३०", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं प्रोच्यमानं द्विजोत्तम ।\nतपसा हि प्रदीप्तेन सर्वं त्वमनुपश्यसि\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2214479, "chapter_id": 5584, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2214480, "chapter_id": 5584, "verse_number": "३१", "content_sanskrit": "इत्युक्तः स तु विप्रर्षिरनुज्ञातो महात्मना ।\nव्यासेन तस्य नृपतेराख्यातुमुपचक्रमे\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2214481, "chapter_id": 5584, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2214482, "chapter_id": 5584, "verse_number": "३२", "content_sanskrit": "गन्तव्यं कर्मणामन्ते सर्वेषां मनुजाधिप\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2214483, "chapter_id": 5584, "verse_number": "३३", "content_sanskrit": "प्रकृतिं किन्तु सम्यक्त्वं पृच्छैषा यत्प्रयोजिका\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2214484, "chapter_id": 5584, "verse_number": "३४", "content_sanskrit": "शृणु गुह्यमिदं राजन् देवानां भरतर्षभ ।\nयदुवाच महातेजा दिव्यचक्षुः प्रतापवान्\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2214485, "chapter_id": 5584, "verse_number": "३५", "content_sanskrit": "मुनिः पुराणः कौरव्य पाराशर्यो महाव्रतः ।\nअगाधबुद्धिः सर्वज्ञो गतिज्ञः सर्वकर्मणाम्\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2214486, "chapter_id": 5584, "verse_number": "", "content_sanskrit": "(तेनोक्तं कर्मणामन्ते प्रविशन्ति स्विकां तनुम्\t ॥३६॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2214487, "chapter_id": 5584, "verse_number": "३७", "content_sanskrit": "वसूनेव महातेजा भीष्मः प्राप महाद्युतिः ।\nअष्टावेव हि दृश्यन्ते वसवो भरतर्षभ\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2214488, "chapter_id": 5584, "verse_number": "३८", "content_sanskrit": "बृहस्पतिं विवेशाथ द्रोणो ह्यङ्गिरसां वरम् ।\nकृतवर्मा तु हार्दिक्यः प्रविवेश मरुद्गणान्\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2214489, "chapter_id": 5584, "verse_number": "३९", "content_sanskrit": "सनत्कुमारं प्रद्युम्नः प्रविवेश यथागतम् ।\nधृतराष्ट्रो धनेशस्य लोकान् प्राप दुरासदान्\t ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2214490, "chapter_id": 5584, "verse_number": "४०", "content_sanskrit": "धृतराष्ट्रेण सहिता गान्धारी च यशस्विनी ।\nपत्नीभ्यां सहितः पाण्डुर्महेन्द्रसदनं ययौ\t ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2214491, "chapter_id": 5584, "verse_number": "४१", "content_sanskrit": "विराटद्रुपदौ चोभौ धृष्टकेतुश्च पार्थिवः ।\nनिशठाक्रूरशङ्काश्च भानुः कण्वो विडूरथः\t ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2214492, "chapter_id": 5584, "verse_number": "४२", "content_sanskrit": "भूरिश्रवाः शलश्चैव भूरिश्च पृथिवीपतिः ।\nकंसश्चैवोग्रसेनश्च वसुदेवस्तथैव च\t ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2214493, "chapter_id": 5584, "verse_number": "४३", "content_sanskrit": "उत्तरश्च सह भ्रात्रा शङ्खेन नरपुङ्गवः ।\nविश्वेषां देवतानां ते विविशुर्नरसत्तमाः\t ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2214494, "chapter_id": 5584, "verse_number": "४४", "content_sanskrit": "यस्तु वर्चा इति ख्यातः सोमपुत्रः बभूव ह ।\nसोभिमन्युर्नृसिंहस्य फलगुनस्य सुतोऽभवत्\t ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2214495, "chapter_id": 5584, "verse_number": "४५", "content_sanskrit": "स युद्ध्वा क्षत्रधर्मेण यथा नान्यः पुमान् क्वचित् ।\nविवेश सोमं धर्मात्मा कर्मणोन्ते महारथः\t ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2214496, "chapter_id": 5584, "verse_number": "४६", "content_sanskrit": "आविवेश रविं कर्णो निहतः पुरुषर्षभ ।\nद्वापरं शकुनिः प्राप धृष्टद्युम्नस्तु पावकम्\t ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2214497, "chapter_id": 5584, "verse_number": "४७", "content_sanskrit": "धृतराष्ट्रात्मजाः सर्वे यातुधानान् प्रपेदिरे ।\nधर्ममेवाविशत् क्षत्ता राजा चैव युधिष्ठिरः\t ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2214498, "chapter_id": 5584, "verse_number": "४८", "content_sanskrit": "अनन्तो भगवान् देवः प्रविवेश रसातलम् ।\nपितामहनियोगाद् वै यो योगाद् गामधारयत्\t ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2214499, "chapter_id": 5584, "verse_number": "४९", "content_sanskrit": "यः स नारायणो नाम देवदेवः सनातनः ।\nतस्यांशो वासुदेवस्तु कर्मणोन्ते विवेश ह\t ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2214500, "chapter_id": 5584, "verse_number": "५०", "content_sanskrit": "षोडशस्त्रीसहस्राणि वासुदेवपरिग्रहाः ।\nअमज्जंस्ताः सरस्वत्यां कालेन जनमेजय\t ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2214501, "chapter_id": 5584, "verse_number": "५१", "content_sanskrit": "तत्र त्यक्त्वा शरीराणि दिवमारुरुहुः पुनः ।\nताश्चैवाप्सरसो भूत्वा वासुदेवमुपाविशन्\t ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2214502, "chapter_id": 5584, "verse_number": "५२", "content_sanskrit": "हतास्तस्मिन् महायुद्धे ये वीरास्तु महारथाः ।\nघटोत्कचादयश्चैव देवान्यक्षांश्च भेजिरे\t ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2214503, "chapter_id": 5584, "verse_number": "५३", "content_sanskrit": "(धृतराष्ट्रात्मजाश्चैव यातुधाना मदोत्कटाः ।)\nदुर्योधनसहायाश्च पार्थिवा येऽनुकीर्तिताः ।\nदानवान् गुह्यकांश्चैव गन्धर्वांश्च तथाऽविशन्\t ॥\nप्राप्तास्ते क्रमशो राजन् सर्वलोकाननुत्तमान्\t ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2214504, "chapter_id": 5584, "verse_number": "५४", "content_sanskrit": "भवनं च महेन्द्रस्य कुबेरस्य च धीमतः ।\nवरुणस्य तथा लोकान् विविशुः पुरुषर्षभाः\t ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2214505, "chapter_id": 5584, "verse_number": "५५", "content_sanskrit": "एतत्ते सर्वमाख्यातं विस्तरेण महाद्युते ।\nकुरूणां चरितं कृत्स्नं पाण्डवानां च भारत\t ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2214506, "chapter_id": 5584, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2214507, "chapter_id": 5584, "verse_number": "५६", "content_sanskrit": "एतच्छ्रुत्वा द्विजश्रेष्ठात् स राजा जनमेजयः ।\nविस्मितोऽभवदत्यर्थं यज्ञकर्मान्तरेष्वथ\t ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2214508, "chapter_id": 5584, "verse_number": "५७", "content_sanskrit": "ततः समापयामासुः कर्म तत्तस्य याजकाः ।\nआस्तिकश्चाभवत्प्रीतः परिमोक्ष्य भुजङ्गमान्\t ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2214509, "chapter_id": 5584, "verse_number": "५८", "content_sanskrit": "ततो द्विजातीन् सर्वान् तान् दक्षिणाभिरतोषयत् ।\nपूजिताश्चापि ते राज्ञा ततो जग्मुर्यथागतम्\t ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2214510, "chapter_id": 5584, "verse_number": "५९", "content_sanskrit": "विसर्जयित्वा विप्रान् तान् राजाऽपि जनमेजयः ।\nहृष्टस्तक्षशिलायाः स पुनरायाद् गजाह्वयम्\t ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2214511, "chapter_id": 5584, "verse_number": "६०", "content_sanskrit": "एतत्ते सर्वमाख्यातं वैशम्पायनकीर्तितम् ।\nव्यासाज्ञया समाज्ञातं सर्पसत्रे नृपस्य हि\t ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2214512, "chapter_id": 5584, "verse_number": "६१", "content_sanskrit": "पुण्योऽयमितिहासाख्यः पवित्रं चेदमुत्तमम् ।\nव्यासेन मुनिना विप्र चरितं स्तव्यदर्शिना\t ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2214513, "chapter_id": 5584, "verse_number": "६२", "content_sanskrit": "सर्वज्ञेन विधिज्ञेन धर्मज्ञानवता सता ।\nअतीन्द्रियेण शुचिना तपसा भावितात्मना\t ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2214514, "chapter_id": 5584, "verse_number": "६३", "content_sanskrit": "ऐश्वर्ये वर्तता चैव साङ्ख्ययोगवता तथा ।\nनैकतन्त्रविबुद्धेन दृष्ट्वा दिव्येन चक्षुषा\t ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2214515, "chapter_id": 5584, "verse_number": "६४", "content_sanskrit": "कीर्तिं प्रथयता लोके पाण्डवानां महात्मनाम् ।\nअन्येषां क्षत्रियाणां च भूरिद्रविणतेजसाम्\t ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2214516, "chapter_id": 5584, "verse_number": "६५", "content_sanskrit": "क्रीडां च वासुदेवस्य देवदेवस्य शार्ङ्गिणः ।\nविश्वेषां देवभागानां जन्मसायुज्यमेव च\t ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2214517, "chapter_id": 5584, "verse_number": "६६", "content_sanskrit": "य इदं शृणुयाद् विद्वान् पर्वसु द्विजसत्तमः ।\nधूतपाप्मा जितस्वर्गो ब्रह्मभूयाय गच्छति\t ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2214518, "chapter_id": 5584, "verse_number": "६७", "content_sanskrit": "कार्ष्णं वेदमिमं सर्वं शृणुयाद् यः समाहितः ।\nब्रह्महत्याकृतं पापं तत्क्षणादेव नश्यति\t ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2214519, "chapter_id": 5584, "verse_number": "६८", "content_sanskrit": "यश्चेदं श्रावयेच्छ्राद्धे ब्राह्मणान् पादमन्ततः ।\nअक्षय्यमन्नपानं वै पितॄंस्तस्योपतिष्ठते\t ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2214520, "chapter_id": 5584, "verse_number": "६९", "content_sanskrit": "धर्मे चार्थे च कामे च मोक्षे च भरतर्षभ ।\nयदिहास्ति तदन्यत्र यन्नेहास्ति न कुत्रचित् \t ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2214521, "chapter_id": 5584, "verse_number": "७०", "content_sanskrit": "(वाच्यते यत्र सततं जयाख्यं भारतं महत् ।\nश्रीश्च कीर्तिश्च विद्या च भवन्ति मुदिताः सदा\t ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2214522, "chapter_id": 5584, "verse_number": "७१", "content_sanskrit": "भारतस्य तु वक्तारं ब्रह्मर्षिं च महागुरुम् ।\nवैशम्पायनमारोप्य स्वर्णभद्रासनं तदा\t ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2214523, "chapter_id": 5584, "verse_number": "७२", "content_sanskrit": "जनमेजयादिराजान आस्तिकाद्या द्विजातयः ।\nधर्मदत्तादिवैश्याश्च सोम्यवंश्यादिशूद्रकाः\t ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2214524, "chapter_id": 5584, "verse_number": "७३", "content_sanskrit": "प्रयुतं चायुतं चेति सहस्रं शतमित्यपि ।\nदशकं चेति निष्काणामानर्चुस्तं महागुरुम्\t ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2214525, "chapter_id": 5584, "verse_number": "७४", "content_sanskrit": "निष्काणां दशकं दत्त्वा मृतपुत्रोऽमृतप्रजः ।\nऊष्मादिव्याधियुक्तश्च शतं दत्त्वा निरामयः\t ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2214526, "chapter_id": 5584, "verse_number": "७५", "content_sanskrit": "सहस्रदानात्सन्तानहीनः सन्तानपुत्रवान् ।\nआयुरारोग्यमैश्वर्यं भेजुस्तेऽन्नं च पुत्रकान्\t ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2214527, "chapter_id": 5584, "verse_number": "७६", "content_sanskrit": "सुवर्णं रजतं रत्नं सर्वाण्याभरणानि च ।\nसर्वोपकरणैर्युक्तं निधिनिक्षेपसंयुतम्\t ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2214528, "chapter_id": 5584, "verse_number": "७७", "content_sanskrit": "इष्टकाभित्तिसंयुक्तमग्निबाधादिवर्जितम् ।\nदेवपूजाग्निहोत्रादिपाठार्थगृहसंयुतम्\t ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2214529, "chapter_id": 5584, "verse_number": "७८", "content_sanskrit": "सान्तर्बहिः संवरणं सप्रासादं सगोगृहम्\t ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2214530, "chapter_id": 5584, "verse_number": "७९", "content_sanskrit": "व्यष्ट्या समष्ट्या वा दद्यात् स्वर्गारोहणपर्वणि ।\nनिवृत्तिकामो दद्याच्चेत् पुनर्जन्म न विद्यते\t ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2214531, "chapter_id": 5584, "verse_number": "८०", "content_sanskrit": "सकामश्चेद् ब्रह्मकल्पं सुखं ब्रह्मगृहे वसेत्\t ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2214532, "chapter_id": 5584, "verse_number": "८१", "content_sanskrit": "पुराणमुखतो यस्माद् वेदान्तज्ञानमाप्यते ।\nस तेन गुरुराख्यातस्तत्पूजा हीशपूजनम्\t ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2214533, "chapter_id": 5584, "verse_number": "८२", "content_sanskrit": "भारतस्य तु वक्तारं श्रोतारं लेखकांस्तदा ।\nप्रपूजयन्ति संहृष्टाः सिद्धाश्च परमर्षयः\t ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2214534, "chapter_id": 5584, "verse_number": "", "content_sanskrit": "महाभारतवक्तारं नार्चयन्तीह ये नराः ।\nतेषां सर्वक्रियाहानिर्भवेद् देवाः शपन्ति च\t ॥८३॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2214535, "chapter_id": 5584, "verse_number": "८४", "content_sanskrit": "जयो नामेतिहासोऽयं श्रोतव्यो जयमिच्छता ।\nइतिहासमिदं श्रुत्वा पुण्यं सफलमश्नुते\t ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2214536, "chapter_id": 5584, "verse_number": "८५", "content_sanskrit": "राज्ञा राजसुतैश्चैव गर्भिण्या चैव योषिता\t ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2214537, "chapter_id": 5584, "verse_number": "८६", "content_sanskrit": "स्वर्गकामो लभेत्स्वर्गं जयकामो लभेज्जयम् ।\nगर्भिणी लभते पुत्रं कन्यां वा बहुभागिनीम्\t ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2214538, "chapter_id": 5584, "verse_number": "८७", "content_sanskrit": "(अनागतश्च मोक्षश्च कृष्णद्वैपायनः प्रभुः ।\nसन्दर्भं भारतस्यास्य कृतवान् धर्मकाम्यया\t ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2214539, "chapter_id": 5584, "verse_number": "८८", "content_sanskrit": "षष्टिं शतसहस्राणि चकारान्यां स संहिताम् ।\nत्रिंशच्छतसहस्राणि देवलोके प्रतिष्ठितम्\t ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2214540, "chapter_id": 5584, "verse_number": "८९", "content_sanskrit": "पित्र्ये पञ्चदशं ज्ञेयं यक्षलोके चतुर्दश ।\nएकं शतसहस्रं तु मानुषेषु प्रभाषितम्\t ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2214541, "chapter_id": 5584, "verse_number": "९०", "content_sanskrit": "नारदोऽश्रावयद्देवान् असितो देवलः पितॄन् ।\nरक्षो यक्षान् शुको मर्त्यान् वैशम्पायन एव तु\t ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2214542, "chapter_id": 5584, "verse_number": "समाप्तिः", "content_sanskrit": "इतिहासमिमं पुण्यं महार्थं वेदसम्मितम् ।\nव्यासोक्तं श्रूयते येन कृत्वा ब्राह्मणमग्रतः\t ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2214543, "chapter_id": 5584, "verse_number": "९२", "content_sanskrit": "स नरः सर्वकामांश्च कीर्तिं प्राप्येह शौनक ।\nगच्छेत् परमिकां सिद्धिमत्र मे नास्ति संशयः\t ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2214544, "chapter_id": 5584, "verse_number": "९३", "content_sanskrit": "भारताध्ययनात् पुण्यादपि पादमधीयतः ।\nश्रद्धया परया भक्त्या श्राव्यते चापि येन तु\t ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2214545, "chapter_id": 5584, "verse_number": "९४", "content_sanskrit": "य इमां संहितां पुण्यां पुत्रमध्यापयच्छुकम्\t ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2214546, "chapter_id": 5584, "verse_number": "९५", "content_sanskrit": "मातापितृसहस्राणि पुत्रदारशतानि च ।\nसंसारेष्वनुभूतानि यान्ति यास्यन्ति चापरे\t ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2214547, "chapter_id": 5584, "verse_number": "९६", "content_sanskrit": "हर्षस्थानसहस्राणि भयस्थानशतानि च ।\nदिवसे दिवसे मूढमाविशन्ति न पण्डितम्\t ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2214548, "chapter_id": 5584, "verse_number": "९७", "content_sanskrit": "ऊर्ध्वबाहुर्विरौम्येष न च कश्चिच्छृणोति मे ।\nधर्मादर्थश्च कामश्च स किमर्थं न सेव्यते\t ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2214549, "chapter_id": 5584, "verse_number": "९८", "content_sanskrit": "न जातु कामान्न भयान्न लोभाद्\nधर्मं त्यजेज्जीवितस्यापि हेतोः ।\nनित्यो धर्मः सुखदुःखे त्वनित्ये\nजीवो नित्यो हेतुरस्य त्वनित्यः\t ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2214550, "chapter_id": 5584, "verse_number": "", "content_sanskrit": "इमां भारतसावित्रीं प्रातरुत्थाय यः पठेत् ।\nस भारतफलं प्राप्य परं ब्रह्माधिगच्छति\t ॥९९॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2214551, "chapter_id": 5584, "verse_number": "१००", "content_sanskrit": "यथा समुद्रो भगवान् यथा हि हिमवान् गिरिः ।\nख्यातावुभौ रत्ननिधी तथा भारतमुच्यते\t ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2214552, "chapter_id": 5584, "verse_number": "", "content_sanskrit": "(कार्ष्णं वेदमिमं विद्वान् श्रावयित्वाऽर्थमश्नुते\t ॥१०१॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2214553, "chapter_id": 5584, "verse_number": "१०२", "content_sanskrit": "इदं भारतमाख्यानं यः पठेत् सुसमाहितः ।\nस गच्छेत् परमां सिद्धिमिति मे नास्ति संशयः\t ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2214554, "chapter_id": 5584, "verse_number": "१०३", "content_sanskrit": "द्वैपायनोष्ठपुटनिस्सृतमप्रमेयं\nपुण्यं पवित्रमथ पापहरं शिवं च ।\nयो भारतं समधिगच्छति वाच्यमानं\nकिं तस्य पुष्करजलैरभिषेचनेन\t ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2214555, "chapter_id": 5584, "verse_number": "१०४", "content_sanskrit": "यो गोशतं कनकशृङ्गमयं ददाति\nविप्राय वेदविदुषे सुबहुश्रुताय ।\nपुण्यां च भारतकथां सततं शृणोति\nतुल्यं फलं भवति तस्य च तस्य चैव\t ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2214556, "chapter_id": 5584, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nस्वर्गारोहणपर्वणि युधिष्ठिरादिपाण्डवानां श्रीकृष्णस्य\nच स्वस्वमूलरूपप्रवेशानुवर्णनं नाम चतुर्थोऽध्यायः ॥४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}]