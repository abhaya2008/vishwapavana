[{"id": 7003987000, "chapter_id": 23987, "verse_number": "३-१-५०-१", "content_sanskrit": "श्रीसूत उवाच ।\nअथातः संप्रवक्ष्यामि सेतुमाधववैभवम् ।\nशृणुध्वं मुनयो भक्त्या पुण्यं पापहरं परम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003987001, "chapter_id": 23987, "verse_number": "३-१-५०-२", "content_sanskrit": "पुरा पुण्यनिधिर्नाम राजा सोमकुलोद्भवः ।\nमधुरां पालयामास हालास्येश्वरभूषिताम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003987002, "chapter_id": 23987, "verse_number": "३-१-५०-३", "content_sanskrit": "कदाचित्स महीपालश्चतुरंगबलान्वितः ।\nसांऽतःपुरपरीवारो मधुरायां निजं सुतम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003987003, "chapter_id": 23987, "verse_number": "३-१-५०-४", "content_sanskrit": "स्थापयित्वा रामसेतुं प्रययौ स्नानकौतुकी ।\nतत्र गत्वा धनुष्कोटौ स्नात्वा संकल्पपूर्वकम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003987004, "chapter_id": 23987, "verse_number": "३-१-५०-५", "content_sanskrit": "अन्येष्वपि च तीर्थेषु तत्रत्येषु नृपोत्तमः ।\nसस्नौ रामेश्वरं देवं सिषेवे च सभक्तिकम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003987005, "chapter_id": 23987, "verse_number": "३-१-५०-६", "content_sanskrit": "एवं स बहुकालं वै तत्रैव न्यवसत्सुखम् ।\nरामसेतौ वसन्पुण्ये गन्धमादनपर्वते॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003987006, "chapter_id": 23987, "verse_number": "३-१-५०-७", "content_sanskrit": "विष्णुप्रीतिकरं यज्ञं कदाचिदकरोन्नृपः ।\nयज्ञावसाने राजासौ मुदावभृथकौतुकी॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003987007, "chapter_id": 23987, "verse_number": "३-१-५०-८", "content_sanskrit": "सस्नौ रामधनुष्कोटौ सदारः सपरिच्छदः ।\nसेवित्वा रामनाथं च स वेश्म प्रययौ द्विजाः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003987008, "chapter_id": 23987, "verse_number": "३-१-५०-९", "content_sanskrit": "एवं निवसमानेऽस्मिन्राज्ञि पुण्यनिधौ तदा ।\nकदाचिद्धरिणा लक्ष्मीर्विनोदकलहाकुला॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003987009, "chapter_id": 23987, "verse_number": "३-१-५०-१०", "content_sanskrit": "हरिणा समयं कृत्वा नृपभक्तिं परीक्षितुम् ।\nविष्णुना प्रेषिता लक्ष्मीर्वैकुंठात्कमलालया॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003987010, "chapter_id": 23987, "verse_number": "३-१-५०-११", "content_sanskrit": "अष्टवर्षवयोरूपा प्रययौ गंधमादने ।\nतत्रागत्य धनुष्कोटौ तस्थौ सा कमलालया॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003987011, "chapter_id": 23987, "verse_number": "३-१-५०-१२", "content_sanskrit": "तस्मिन्नवसरे राजा ययौ गुणनिधिर्द्विजाः ।\nस्नातुं रामधनुष्कोटौ सदारः सहसैनिकः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003987012, "chapter_id": 23987, "verse_number": "३-१-५०-१३", "content_sanskrit": "तत्र गत्वा स राजाऽयं स्नात्वा नियमपूर्वकम् ।\nतुलापुरुषमुख्यानि कृत्वा दानानि कृत्स्नशः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003987013, "chapter_id": 23987, "verse_number": "३-१-५०-१४", "content_sanskrit": "प्रयातुकामो भवनं कन्यां कांचिद्ददर्श सः ।\nअतीवरूपसंपन्नामष्टवर्षां शुचिस्मिताम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003987014, "chapter_id": 23987, "verse_number": "३-१-५०-१५", "content_sanskrit": "दृष्ट्वा नृपस्तां पप्रच्छ कन्यां चारुविलोचनाम् ।\nचारुस्मितां चारुदतीं बिंबोष्ठीं तनुमध्यमाम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003987015, "chapter_id": 23987, "verse_number": "३-१-५०-१६", "content_sanskrit": "पुण्यनिधिरुवाच ।\nका त्वं कन्ये सुता कस्य कुतो वा त्वमिहागता ।\nअत्रागमेन किं कार्यं तव वत्से शुचिस्मिते॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003987016, "chapter_id": 23987, "verse_number": "३-१-५०-१७", "content_sanskrit": "एवं नृपस्तां पप्रच्छ कन्यामुत्पललोच नाम् ।\nएवं पृष्टा तदा कन्या नृपं तमवदद्विजाः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003987017, "chapter_id": 23987, "verse_number": "३-१-५०-१८", "content_sanskrit": "न मे माता पिता नास्ति न च मे बांधवास्तथा ।\nअनाथाहं महाराज भविष्यामि च ते सुता॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003987018, "chapter_id": 23987, "verse_number": "३-१-५०-१९", "content_sanskrit": "त्वद्गृहेऽहं निवत्स्यामि तात त्वां पश्यतीसदा ।\nहठात्कृष्यति यो वा मां ग्रहीष्यति करेण तम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003987019, "chapter_id": 23987, "verse_number": "३-१-५०-२०", "content_sanskrit": "यदि शासिष्यसे भूप तदाहं तव मंदिरे ।\nवत्स्यामि ते सुता भूत्वा पितर्गुणनिधे चिरम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003987020, "chapter_id": 23987, "verse_number": "३-१-५०-२१", "content_sanskrit": "एवमुक्तस्तदा प्राह कन्यां गुणनिधिर्नृपः ।\nअहं सर्वं करिष्यामि त्वदुक्तं कन्यके शुभे॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003987021, "chapter_id": 23987, "verse_number": "३-१-५०-२२", "content_sanskrit": "ममापि दुहिता नास्ति पुत्रोऽस्त्येकः कुलोद्वहः ।\nतव यस्मिन्रुचिर्भद्रे त्वां तस्मै प्रददाम्यहम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003987022, "chapter_id": 23987, "verse_number": "३-१-५०-२३", "content_sanskrit": "आगच्छ मद्गृहं कन्ये मम चांतःपुरे वस ।\nमद्भार्यायाः सुता भूत्वा यथाकाममनिंदिते॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003987023, "chapter_id": 23987, "verse_number": "३-१-५०-२४", "content_sanskrit": "इत्युक्ता सा नृपेणाथ कन्या कमललोचना॥  ।\nतथा स्त्विति नृपं प्रोच्य तेन साकं ययौ गृहम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003987024, "chapter_id": 23987, "verse_number": "३-१-५०-२५", "content_sanskrit": "राजा स्वभार्याहस्ते तां प्रददौ कन्यकां शुभाम् ।\nअब्रवीच्च स्वकां भार्यां राजा विन्ध्यावलिं तदा॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003987025, "chapter_id": 23987, "verse_number": "३-१-५०-२६", "content_sanskrit": "आवयोः कन्यका चेयं राज्ञि विंध्यावले शुभे ।\nरक्षेमां सर्वथा त्वं वै पुरुषांतरतः प्रिये॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003987026, "chapter_id": 23987, "verse_number": "३-१-५०-२७", "content_sanskrit": "इतीरिता नृपेणासौ भार्या विंध्या वलिस्तदा ।\nओमित्युक्त्वाथ तां कन्यां पुत्रीं जग्राह पाणिना॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003987027, "chapter_id": 23987, "verse_number": "३-१-५०-२८", "content_sanskrit": "पोषिता पालिता राज्ञा सुतवत्कन्यका च सा ।\nन्यवात्सीत्सुसुखं राज्ञो भवने लालिता सदा॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003987028, "chapter_id": 23987, "verse_number": "३-१-५०-२९", "content_sanskrit": "अथ विष्णुर्जगन्नाथो लक्ष्मीमन्वेष्टुमादरात् ।\nआरूढविनतानन्दो वैकुंठान्निर्ययौ द्विजाः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003987029, "chapter_id": 23987, "verse_number": "३-१-५०-३०", "content_sanskrit": "विनिर्गत्य स वैकुंठा द्विलंघितवियत्पथः ।\nबभ्राम च बहून्देशाल्लंक्ष्मीं तत्र न दृष्टवान्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003987030, "chapter_id": 23987, "verse_number": "३-१-५०-३१", "content_sanskrit": "रामसेतुमथागच्छद्गंधमादनपर्वते ।\nअन्विष्य सर्वतो रामसेतुं बभ्राम चेंदि राम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003987031, "chapter_id": 23987, "verse_number": "३-१-५०-३२", "content_sanskrit": "एतस्मिन्नेव काले सा पुष्पावचयकौतुकात् ।\nसखीभिः कन्यकायासीद्भवनोद्यानपादपान्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003987032, "chapter_id": 23987, "verse_number": "३-१-५०-३३", "content_sanskrit": "पुष्पाण्यवचिनोति स्म सखीभिः सह कानने ।\nतत्रागत्य ततो विष्णुर्विप्ररूपधरो द्विजाः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003987033, "chapter_id": 23987, "verse_number": "३-१-५०-३४", "content_sanskrit": "गंगांभो विदधत्स्कंधे वहञ्छत्रं करंण च ।\nगंगास्नायिद्विजस्येव रचयन्वेषमात्मनः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003987034, "chapter_id": 23987, "verse_number": "३-१-५०-३५", "content_sanskrit": "धारयन्दक्षिणे पाणौ कुशाग्रंथिपवित्रकम् ।\nभस्मोद्धूलितसर्वांगस्त्रिपुण्ड्रावलिशोभितः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003987035, "chapter_id": 23987, "verse_number": "३-१-५०-३६", "content_sanskrit": "प्रजपञ्छिवनामानि धृतरुद्राक्ष मालिकः ।\nसोत्तरीयः शुचिर्विप्राः समायातो जनार्दनः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003987036, "chapter_id": 23987, "verse_number": "३-१-५०-३७", "content_sanskrit": "तमागतं द्विजं दृष्ट्वा स्तब्धाऽतिष्ठत कन्यका ।\nअपश्यदष्टवर्षां तां वल्लभां पुष्प हारिणीम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003987037, "chapter_id": 23987, "verse_number": "३-१-५०-३८", "content_sanskrit": "दृष्ट्वा स त्वरया विप्रः कन्यां मधुरभाषिणीम् ।\nहठात्कृत्य करेणासौ जग्राह गरुडध्वजः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003987038, "chapter_id": 23987, "verse_number": "३-१-५०-३९", "content_sanskrit": "तदा चुक्रोश सा कन्या सखीभिः सह कानने ।\nतमाक्रोशं समाकर्ण्य राजा स तु समागतः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003987039, "chapter_id": 23987, "verse_number": "३-१-५०-४०", "content_sanskrit": "प्रययौ भवनोद्यानं वृतः कतिपयैर्भटैः ।\nगत्वा पप्रच्छ तां कन्यां तत्सखीरपि भूपतिः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003987040, "chapter_id": 23987, "verse_number": "३-१-५०-४१", "content_sanskrit": "किमर्थमधुना क्रुष्टं सखीभिः सह कन्यके ।\nत्वया तु भवनोद्याने तत्र कारणमुच्यताम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003987041, "chapter_id": 23987, "verse_number": "३-१-५०-४२", "content_sanskrit": "केन त्वं परिभूतासि हठात्कृष्य सुते मम ।\nइति पृष्टा तमाचष्ट कन्या गुणनिधिं नृपम् ।\nबाष्पपूर्णानना खिन्ना रुषिता भृशकातरा॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003987042, "chapter_id": 23987, "verse_number": "३-१-५०-४३", "content_sanskrit": "कन्योवाच ।\nअयं विप्रो हठात्कृत्य जगृहे पांड्यनाथ माम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003987043, "chapter_id": 23987, "verse_number": "३-१-५०-४४", "content_sanskrit": "तातात्र वृक्षमूलेऽसौ स तिष्ठत्यकुतोभयः ।\nतदाकर्ण्य वचस्तस्या राजा गुणनिधिः सुधीः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003987044, "chapter_id": 23987, "verse_number": "३-१-५०-४५", "content_sanskrit": "जग्राह तरसा विप्रमविद्वांस्तद्बलं हठात् ।\nरामनाथालयं नीत्वा निगृह्य च हठात्तदा॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003987045, "chapter_id": 23987, "verse_number": "३-१-५०-४६", "content_sanskrit": "बद्ध्वा निगडपाशाभ्या मानयन्मंडपं च तम् ।\nआत्मपुत्रीं समाश्वास्य शुद्धांतमनयन्नृपः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003987046, "chapter_id": 23987, "verse_number": "३-१-५०-४७", "content_sanskrit": "स्वयं च प्रययौ रम्यं भवनं नृपपुंगवः ।\nततो रात्रौ स्वपन्राजा स्वप्ने विप्रं ददर्श तम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003987047, "chapter_id": 23987, "verse_number": "३-१-५०-४८", "content_sanskrit": "शंखचक्रगदापद्मवनमालाविभूषितम् ।\nकौस्तुभालंकृतोरस्कं पीतांबरधरं हरिम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003987048, "chapter_id": 23987, "verse_number": "३-१-५०-४९", "content_sanskrit": "कालमेघच्छविं कांतं गरुडोपरि संस्थितम् ।\nचारुस्मितं चारुदंतं लसन्मकरकुण्डलम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003987049, "chapter_id": 23987, "verse_number": "३-१-५०-५०", "content_sanskrit": "विष्वक्सेनप्रभृतिभिः किंकरैरुपसेवितम् ।\nशेषपर्यंकशयनं नारदादि मुनिस्तुतम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003987050, "chapter_id": 23987, "verse_number": "३-१-५०-५१", "content_sanskrit": "ददर्श च स्वकां कन्यां विकासिकमलस्थिताम् ।\nधृतपंकजहस्तां तां नीलकुञ्चितमूर्धजाम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003987051, "chapter_id": 23987, "verse_number": "३-१-५०-५२", "content_sanskrit": "विष्णुवक्षस्थल्रावासां समुन्नतपयोधराम् ।\nदिग्गजैरभिषिक्तांगीं श्यामां पीतांबरावृताम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003987052, "chapter_id": 23987, "verse_number": "३-१-५०-५३", "content_sanskrit": "स्वर्णपंकजसंक्लृप्तमालालंकृतमूर्धजाम् ।\nदिव्याभरणशोभाढ्यां चारुहा रविभूषिताम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003987053, "chapter_id": 23987, "verse_number": "३-१-५०-५४", "content_sanskrit": "अनर्घरत्नसंक्लृप्तनासाभरणशोभिताम् ।\nसुवर्णनिष्काभरणां कांचीनूपुरराजिताम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003987054, "chapter_id": 23987, "verse_number": "३-१-५०-५५", "content_sanskrit": "महालक्ष्मीं ददर्शासौ राजा रात्रौ स्वकां सुताम् ।\nएवं दृष्ट्वा नृपः स्वप्ने विप्रं तं स्वसुतामपि॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003987055, "chapter_id": 23987, "verse_number": "३-१-५०-५६", "content_sanskrit": "उत्थितः सहसा तल्पात्कन्यागृहमवाप च ।\nतथैव दृष्टवान्कन्यां यथा स्वप्ने ददर्श ताम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003987056, "chapter_id": 23987, "verse_number": "३-१-५०-५७", "content_sanskrit": "अथोदिते सवितरि कन्यामादाय भूमिपः ।\nरामनाथालयं प्राप ब्राह्मणं न्यस्तवान्यतः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003987057, "chapter_id": 23987, "verse_number": "३-१-५०-५८", "content_sanskrit": "स मंडपवरे विप्रं ददर्श हरिरूपिणम् ।\nयथा ददर्श स्वप्ने तं वनमालादिचिह्नितम् ।\nविष्णुं विज्ञाय तुष्टाव नृपतिर्हरिमीश्वरम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003987058, "chapter_id": 23987, "verse_number": "३-१-५०-५९", "content_sanskrit": "पुण्यनिधिरुवाच ।\nनमस्ते कमलाकांत प्रसीद गरुडध्वज॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003987059, "chapter_id": 23987, "verse_number": "३-१-५०-६०", "content_sanskrit": "शार्ङ्गपाणे नमस्तुभ्यमपराधं क्षमस्व मे ।\nनमस्ते पुण्डरीकाक्ष चक्रपाणे श्रियःपते॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003987060, "chapter_id": 23987, "verse_number": "३-१-५०-६१", "content_sanskrit": "कौस्तुभालंकृतांकाय नमः श्रीवत्सलक्ष्मणे ।\nनमस्ते ब्रह्मपुत्राय दैत्यसंघविदारिणे॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003987061, "chapter_id": 23987, "verse_number": "३-१-५०-६२", "content_sanskrit": "अशेषभुवनावासनाभिपंकजशालिने ।\nमधुकैटभसंहर्त्रे रावणांतकराय ते॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003987062, "chapter_id": 23987, "verse_number": "३-१-५०-६३", "content_sanskrit": "प्रह्रादरक्षिणे तुभ्यं धरित्रीपतये नमः ।\nनिर्गुणायाप्रमेयाय विष्णवे बुद्धिसाक्षिणे॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003987063, "chapter_id": 23987, "verse_number": "३-१-५०-६४", "content_sanskrit": "नमस्ते श्रीनिवासाय जग द्धात्रे परात्मने ।\nनारायणाय देवाय कृष्णाय मधुविद्विषे॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003987064, "chapter_id": 23987, "verse_number": "३-१-५०-६५", "content_sanskrit": "नमः पंकजनाभाय नमः पंकजचक्षुषे ।\nनमः पंकजहस्तायाः पतये पंकजांघ्रये॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003987065, "chapter_id": 23987, "verse_number": "३-१-५०-६६", "content_sanskrit": "भूयोभूयो जगन्नाथ नमः पंकजमालिने ।\nदयामूर्त्ते नमस्तुभ्यमपराधं क्षमस्व मे॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003987066, "chapter_id": 23987, "verse_number": "३-१-५०-६७", "content_sanskrit": "मया निगडपाशाभ्यां यः कृतो मधुसूदन ।\nअनयस्त्वत्स्वरूपमविदित्वा कृतः प्रभो॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003987067, "chapter_id": 23987, "verse_number": "३-१-५०-६८", "content_sanskrit": "अतो मदपराधोऽयं क्षंतव्यो मधुसूदन ।\nएवं स्तुत्वा महाविष्णुं राजा पुण्यनिधिर्द्विजाः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003987068, "chapter_id": 23987, "verse_number": "३-१-५०-६९", "content_sanskrit": "लक्ष्मीं तुष्टाव जननीं सर्वेषां प्राणिनां मुदा ।\nनमो देवि जगद्धात्रि विष्णुवक्षस्थलालये॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003987069, "chapter_id": 23987, "verse_number": "३-१-५०-७०", "content_sanskrit": "नमोब्धिसंभवे तुभ्यं महालक्ष्मि हरिप्रिये ।\nसिद्ध्यै पुष्ट्यै स्वधायै च स्वाहायै सततं नमः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003987070, "chapter_id": 23987, "verse_number": "३-१-५०-७१", "content_sanskrit": "संध्यायै च प्रभायै च धात्र्यै भूत्यै नमोनमः ।\nश्रद्धायै चैव मेधायै सरस्वत्यै नमोनमः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003987071, "chapter_id": 23987, "verse_number": "३-१-५०-७२", "content_sanskrit": "यज्ञविद्ये महाविद्ये गुह्यविद्येतिशोभने ।\nआत्मविद्ये च देवेशि मुक्तिदे सर्वदेहिनाम्॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003987072, "chapter_id": 23987, "verse_number": "३-१-५०-७३", "content_sanskrit": "त्रयीरूपे जगन्मातर्जगद्रक्षाविधायिनि ।\nरक्ष मां त्वं कृपादृष्ट्या सृष्टिस्थित्यंतकारिणि॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003987073, "chapter_id": 23987, "verse_number": "३-१-५०-७४", "content_sanskrit": "भूयोभूयो नमस्तुभ्यं ब्रह्ममात्रे महेश्वरि ।\nइति स्तुत्वा महालक्ष्मीं प्रार्थयामास माधवम्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003987074, "chapter_id": 23987, "verse_number": "३-१-५०-७५", "content_sanskrit": "यदज्ञानान्मया विष्णो त्वयि दोषः कृतोऽधुना ।\nपादे निगडबंधेन स द्रोहः क्षम्यतां त्वया॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003987075, "chapter_id": 23987, "verse_number": "३-१-५०-७६", "content_sanskrit": "लोकास्ते शिशवः सर्वे त्वं पिता जगतां हरे ।\nसुताऽपराधः पितृभिः क्षंतव्यो मधुसूदन॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003987076, "chapter_id": 23987, "verse_number": "३-१-५०-७७", "content_sanskrit": "अपराधिनां च दैत्यानां स्वरूपमपि दत्तवान् ।\nभवान्विष्णो ममापीममपराधं क्षमस्व वै॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003987077, "chapter_id": 23987, "verse_number": "३-१-५०-७८", "content_sanskrit": "जिघांसयापि भगवन्नागतां पूतनां पुरा ।\nअनयस्त्वत्पदांभोजं तन्मां रक्ष कृपानिधे ।\nलक्ष्मीकांत कृपादृष्टिं मयि पातय केशव॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003987078, "chapter_id": 23987, "verse_number": "३-१-५०-७९", "content_sanskrit": "श्रीसूत उवाच ।\nइति संप्रार्थितो विष्णु राज्ञा तेन द्विजोत्तमाः ।\nप्राह गंभीरया वाचा नृपं पुण्यनिधिं ततः॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003987079, "chapter_id": 23987, "verse_number": "३-१-५०-८०", "content_sanskrit": "विष्णुरुवाच ।\nराजन्न भीस्त्वया कार्या मद्बंधननिमित्तजा॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003987080, "chapter_id": 23987, "verse_number": "३-१-५०-८१", "content_sanskrit": "भक्तवश्यत्वमधुना तव प्रतिहितं मया ।\nमम प्रीतिकरं यज्ञमकरोद्यद्भवानिह॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003987081, "chapter_id": 23987, "verse_number": "३-१-५०-८२", "content_sanskrit": "अतस्त्वं मम भक्तोसि राजन्पुण्यनिधेऽधुना ।\nतेनाहं तव वश्योऽस्मि भक्तिपाशेन यंत्रितः॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003987082, "chapter_id": 23987, "verse_number": "३-१-५०-८३", "content_sanskrit": "भक्तापराधं सततं क्षमाम्यहमरिं दम ।\nत्वद्भक्तिं ज्ञातुकामेन मया संप्रेरिता त्वियम्॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003987083, "chapter_id": 23987, "verse_number": "३-१-५०-८४", "content_sanskrit": "लक्ष्मीर्मम प्रिया राजंस्त्वयासंरक्षिताऽधुना ।\nतेनाहं तव तुष्टोऽस्मि मत्स्वरूपा त्वियं सदा॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003987084, "chapter_id": 23987, "verse_number": "३-१-५०-८५", "content_sanskrit": "अस्यां यो भक्तिमांल्लोके स मद्भक्तोऽभिधीयते ।\nअस्यां यो विमुखो राजन्स मद्द्वेषी स्मृतः सदा॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003987085, "chapter_id": 23987, "verse_number": "३-१-५०-८६", "content_sanskrit": "त्वमिमां भक्तिसं युक्तो यस्मात्पूजितवानसि ।\nमत्पूजापि कृता तस्मान्मदभिन्ना त्वियं यतः॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003987086, "chapter_id": 23987, "verse_number": "३-१-५०-८७", "content_sanskrit": "अतस्त्वया नापराधः कृतो मयि नरेश्वर ।\nकिं तु पूजैव विहिता तां त्वयार्चयता मम॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003987087, "chapter_id": 23987, "verse_number": "३-१-५०-८८", "content_sanskrit": "त्वया मद्भार्यया साकं संकेतोऽकारि यत्पुरा ।\nतत्संकेताभिगुत्यर्थं मां यद्बंधितवानसि॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003987088, "chapter_id": 23987, "verse_number": "३-१-५०-८९", "content_sanskrit": "तेन प्रीतोस्मि ते राजंल्लक्ष्मीः संरक्षिताऽधुना ।\nमत्स्वरूपा च सा लक्ष्मीर्जगन्माता त्रयीमयी॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003987089, "chapter_id": 23987, "verse_number": "३-१-५०-९०", "content_sanskrit": "तद्रक्षां कुर्वता भूप त्वया यद्बंधनं मम ।\nतत्प्रियं मम राजेंद्र मा भयं क्रियतां त्वया॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003987090, "chapter_id": 23987, "verse_number": "३-१-५०-९१", "content_sanskrit": "इयं लक्ष्मीस्तव सुता सत्यमेव न संशयः ।\nइतीरितेऽथ हरिणा लक्ष्मीः प्रोवाच भूपतिम्॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003987091, "chapter_id": 23987, "verse_number": "३-१-५०-९२", "content_sanskrit": "लक्ष्मीरुवाच ।\nराजन्प्रीतास्मि ते चाहं रक्षिता यद्गृहे त्वया ।\nत्वद्भक्तिशोधनार्थं वा अहं विष्णुरुभावपि॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003987092, "chapter_id": 23987, "verse_number": "३-१-५०-९३", "content_sanskrit": "विनोद कलहव्याजादागताविह भूपते ।\nतव योगेन भक्त्या च तुष्टावावां परंतप॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003987093, "chapter_id": 23987, "verse_number": "३-१-५०-९४", "content_sanskrit": "आवयोः कृपया राजन्सुखं ते भवतात्सदा ।\nसर्वभूमंडलैश्वर्यं सदा ते भवतु ध्रुवम्॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003987094, "chapter_id": 23987, "verse_number": "३-१-५०-९५", "content_sanskrit": "आवयोः पादयुगले भक्तिर्भवतु ते ध्रुवा ।\nदेहांते मम सायुज्यं पुनरावृत्तिवर्जितम्॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003987095, "chapter_id": 23987, "verse_number": "३-१-५०-९६", "content_sanskrit": "नित्यं भवतु ते राजन्मा भूत्ते पापधीस्तथा ।\nसदा धर्मे भव धीर्विष्णुभक्तियुता तव॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003987096, "chapter_id": 23987, "verse_number": "३-१-५०-९७", "content_sanskrit": "एवमुक्त्वा नृपं लक्ष्मीर्विष्णोर्वक्षस्थलं ययौ ।\nअथ विष्णुरुवाचेदं राजानं द्विज पुंगवाः॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003987097, "chapter_id": 23987, "verse_number": "३-१-५०-९८", "content_sanskrit": "यथा त्वयात्र बद्धोहं निगडेन नृपोतम ।\nतद्रूपेणैव वत्स्यामि सेतुमाधवसंज्ञितः॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003987098, "chapter_id": 23987, "verse_number": "३-१-५०-९९", "content_sanskrit": "मयैव कारितः सेतुस्तद्रक्षार्थमहं नृप ।\nभूतराक्षससंघेभ्यो भयानामुपशांतये॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003987099, "chapter_id": 23987, "verse_number": "३-१-५०-१००", "content_sanskrit": "ब्रह्मापि सेतुरक्षार्थं वसत्यत्रदिवानिशम् ।\nशंकरो रामनाथाख्यो नित्यं सेतौ वसत्यथ॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003987100, "chapter_id": 23987, "verse_number": "३-१-५०-१०१", "content_sanskrit": "इंद्रादिलोकपालाश्च वसंत्यत्रमुदान्विताः ।\nअतोऽहमत्रवत्स्यामि सेतुमाधवसंज्ञया॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003987101, "chapter_id": 23987, "verse_number": "३-१-५०-१०२", "content_sanskrit": "सेतुसंरक्षणार्थं वै सर्वोपद्रवशांतये ।\nसर्वेषामिष्टसिद्ध्यर्थं सर्वपापोपशांतये॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003987102, "chapter_id": 23987, "verse_number": "३-१-५०-१०३", "content_sanskrit": "त्वया निगडबद्धं मां सेवते येऽत्र मानवाः ।\nते यांति मम सायुज्यं सर्वाभीष्टं तथा नृप॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003987103, "chapter_id": 23987, "verse_number": "३-१-५०-१०४", "content_sanskrit": "मम लक्ष्म्यास्तव तथा चरितं ये पठंति वै ।\nन ते यास्यंति दारिद्र्यं किं त्वैश्वर्यं व्रजंति ते॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003987104, "chapter_id": 23987, "verse_number": "३-१-५०-१०५", "content_sanskrit": "त्वत्कृतं यदिदं स्तोत्रं मम लक्ष्म्या विशांपते ।\nये पठंति च शृण्वंति लिखंति च मुदान्विताः॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003987105, "chapter_id": 23987, "verse_number": "३-१-५०-१०६", "content_sanskrit": "न तेषां पुनरावृत्तिर्मम लोकात्कदाचन ।\nइत्युक्त्वा स हरिस्तत्र नृपं पुण्यनिधिं तदा॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003987106, "chapter_id": 23987, "verse_number": "३-१-५०-१०७", "content_sanskrit": "तत्रैव पूर्णरूपेण संनि धत्ते स्म सर्वदा ।\nनृपः पुण्यनिधिर्विप्राः सेतुमाधवरूपिणम्॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003987107, "chapter_id": 23987, "verse_number": "३-१-५०-१०८", "content_sanskrit": "विष्णुं प्रणम्य भक्त्या तु महापूजां विधाय च ।\nसेवित्वा रामनाथं च स्वमेव भवनं ययौ॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003987108, "chapter_id": 23987, "verse_number": "३-१-५०-१०९", "content_sanskrit": "यावज्जीवमसौ तत्र सेतौ न्यवसदुत्तमे ।\nमधुरायां निजं पुत्रं स्थापयामास पालकम्॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003987109, "chapter_id": 23987, "verse_number": "३-१-५०-११०", "content_sanskrit": "तत्रैव निवसन्राजा देहांते मुक्तिमाप्तवान् ।\nविंध्यावलिश्च तत्पत्नी तमेवानुममार सा ।\nपतिव्रता पतिप्राणा प्रययौ सापि सद्गतिम्॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003987110, "chapter_id": 23987, "verse_number": "३-१-५०-१११", "content_sanskrit": "श्रीसूत उवाच ।\nयेत्र भक्तियुता नित्यं सेवंते सेतुमाधवम्॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003987111, "chapter_id": 23987, "verse_number": "३-१-५०-११२", "content_sanskrit": "न तेषां पुनरावृत्तिः कैलासाज्जातु जायते ।\nसेतुमाधवसेवा ये न कुर्वंत्यत्र मानवाः॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003987112, "chapter_id": 23987, "verse_number": "३-१-५०-११३", "content_sanskrit": "न तेषां रामनाथस्य सेवा फलवती भवेत् ।\nगृहीत्वा सैकतं सेतोर्गंगायां निक्षिपेद्यदि॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003987113, "chapter_id": 23987, "verse_number": "३-१-५०-११४", "content_sanskrit": "विभज्य माधवपुरे वैकुंठे स वसेन्नरः ।\nगंगां जिगमिषुर्विप्राः सेतुमाधवसन्निधौ॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003987114, "chapter_id": 23987, "verse_number": "३-१-५०-११५", "content_sanskrit": "संकल्प्य गंगां निर्गच्छेत्सा यात्रा सफला भवेत् ।\nआनीय गंगासलिलं रामेशमभि षिच्य च॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003987115, "chapter_id": 23987, "verse_number": "३-१-५०-११६", "content_sanskrit": "सेतौ निक्षिप्य तद्भारं ब्रह्म प्राप्नोत्यसंशयः ।\nइति वः कथितं विप्राः सेतुमाधववैभवम्॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003987116, "chapter_id": 23987, "verse_number": "३-१-५०-११७", "content_sanskrit": "एतत्पठन्वा शृण्वन्वा वैकुंठे लभते गतिम्॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}]