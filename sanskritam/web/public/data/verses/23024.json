[{"id": 7003024000, "chapter_id": 23024, "verse_number": "३-४-१", "content_sanskrit": "नारायण उवाच ।\nश्रुत्वा व्रतविधानं च दुर्गा संहृष्टमानसा ।\nसर्वं व्रतविधानं च संप्रष्टुमुपचक्रमे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003024001, "chapter_id": 23024, "verse_number": "३-४-२", "content_sanskrit": "पार्वत्युवाच ।\nसर्वं व्रतविधानं मां वद वेदविदां वर ।\nहे नाथ करुणासिन्धो दीनबन्धो परात्पर ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003024002, "chapter_id": 23024, "verse_number": "३-४-३", "content_sanskrit": "कानि व्रतोपयुक्तानि द्रव्याणि च फलानि च ।\nसनियमं सभक्ष्यं च विधानं तत्फलं प्रभो ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003024003, "chapter_id": 23024, "verse_number": "३-४-४", "content_sanskrit": "देहि मह्यं विनीतायै नियुक्तं सत्पुरोहितम ।\nपुष्पोपहारान्विप्रांश्च द्रव्याहरणकिंकरान् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003024004, "chapter_id": 23024, "verse_number": "३-४-५", "content_sanskrit": "अन्यानि चोपयुक्तानि मयाऽज्ञातानि यानि च ।\nसन्नियोजय तत्सर्वं स्त्रीणां स्वामी च सर्वदः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003024005, "chapter_id": 23024, "verse_number": "३-४-६", "content_sanskrit": "पिता कौमारकाले च सदा पालनकारकः ।\nभर्त्ता मध्ये सुतः शेषे त्रिधाऽवस्था सुयोषिताम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003024006, "chapter_id": 23024, "verse_number": "३-४-७", "content_sanskrit": "तातोऽशोकः प्राणतुल्यां दत्त्वा सत्त्वामिने सुताम् ।\nस्वामी निर्वृतिमाप्नोति संन्यस्य स्वसुते प्रियाम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003024007, "chapter_id": 23024, "verse_number": "३-४-८", "content_sanskrit": "बन्धुत्रययुता या स्त्री सा च भाग्यवती परा ।\nकिञ्चिद्विहीना मध्या च सर्वहीनाऽधमा भुवि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003024008, "chapter_id": 23024, "verse_number": "३-४-९", "content_sanskrit": "एतेषां च समीपस्था प्रशंस्या सा जगत्त्रये ।\nनिन्दिताऽन्येषु संन्यस्ता सर्वमेतच्छ्रुतौ श्रुतम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003024009, "chapter_id": 23024, "verse_number": "३-४-१०", "content_sanskrit": "सर्वात्मा भगवांस्त्वं च सर्वसाक्षी च सर्ववित् ।\nदेहि मह्यं पुत्रवरं स्वात्मनिर्वृतिहेतुकम ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003024010, "chapter_id": 23024, "verse_number": "३-४-११", "content_sanskrit": "स्वात्मबोधानुमानेन महात्मनि निवेदितम् ।\nसर्वान्तराभिप्रायज्ञं बोधज्ञं बोधयामि किम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003024011, "chapter_id": 23024, "verse_number": "३-४-१२", "content_sanskrit": "इत्युक्त्वा पार्वती प्रीत्या पपात स्वामिनः पदे ।\nकृपासिन्धुश्च भगवान्प्रवक्तुमुपचक्रमे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003024012, "chapter_id": 23024, "verse_number": "३-४-१३", "content_sanskrit": "श्रीमहादेव उवाच ।\nशृणु देवि प्रवक्ष्यामि विधानं नियमं फलम्  ।\nफलानि चैव द्रव्याणि व्रतयोग्यानि यानि च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003024013, "chapter_id": 23024, "verse_number": "३-४-१४", "content_sanskrit": "विप्राणां शतकं शुद्धं फलपुष्पोपहारकम्  ।\nकिंकराणां च शतकं द्रव्याहरणकारकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003024014, "chapter_id": 23024, "verse_number": "३-४-१५", "content_sanskrit": "दासीनां शतकं लक्षं नियुक्तं च पुरोहितम् ।\nसर्वव्रतविधानज्ञं वेदवेदान्तपारगम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003024015, "chapter_id": 23024, "verse_number": "३-४-१६", "content_sanskrit": "प्रवरं हरिभक्तानां सर्वज्ञं ज्ञानिनां वरम ।\nसनत्कुमारं मत्तुल्यं गृहाण व्रतहेतवे ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003024016, "chapter_id": 23024, "verse_number": "३-४-१७", "content_sanskrit": "देवि शुद्धे च काले च परं नियमपूर्वकम् ।\nमाघशुक्लत्रयोदश्यां व्रतारम्भः शुभः प्रिये ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003024017, "chapter_id": 23024, "verse_number": "३-४-१८", "content_sanskrit": "गात्रं सुनिर्मलं कृत्वा शिरस्संस्कारपूर्वकम् ।\nउपोष्य पूर्वदिवसे वस्त्रं संशोध्य यत्नतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003024018, "chapter_id": 23024, "verse_number": "३-४-१९", "content_sanskrit": "अरुणोदयवेलायां तल्पादुत्थाय सुव्रती ।\nमुखप्रक्षालनं कृत्वा स्नात्वा वै निर्मले जले ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003024019, "chapter_id": 23024, "verse_number": "३-४-२०", "content_sanskrit": "आचम्य यत्नपूतो हि हरिस्मरणपूर्वकम् ।\nदत्त्वाऽर्घ्यं हरये भक्त्या गृहमागत्य सत्वरम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003024020, "chapter_id": 23024, "verse_number": "३-४-२१", "content_sanskrit": "धौते च वाससी धृत्वा ह्युपविश्यासने शुचौ ।\nआचम्य तिलकं धृत्वा समाप्य स्वाह्निकं पुनः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003024021, "chapter_id": 23024, "verse_number": "३-४-२२", "content_sanskrit": "घटं संस्थाप्य विधिवत्स्वस्तिवाचनपूर्वकम् ।\nपुरोहितस्य वरणं पुरः कृत्वा प्रयत्नतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003024022, "chapter_id": 23024, "verse_number": "३-४-२३", "content_sanskrit": "सङ्कल्पं वेदविहितं व्रतमेतत्समाचरेत् ।\nव्रते द्रव्याणि नित्यानि चोपचारास्तु षोडश ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003024023, "chapter_id": 23024, "verse_number": "३-४-२४", "content_sanskrit": "देयानि नित्यं देवेशि कृष्णाय परमात्मने ।\nआसनं स्वागतं पाद्यमर्घ्यमाचमनीयकम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003024024, "chapter_id": 23024, "verse_number": "३-४-२५", "content_sanskrit": "स्नानीयं मधुपर्कं च वस्त्राण्याभरणानि च ।\nसुगन्धि पुष्पधूपं च दीपनैवेद्यचन्दनम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003024025, "chapter_id": 23024, "verse_number": "३-४-२६", "content_sanskrit": "यज्ञसूत्रं च ताम्बूलं कर्पूरादिसुवासितम्  ।\nद्रव्याण्येतानि पूजायाश्चाङ्गरूपाणि सुन्दरि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003024026, "chapter_id": 23024, "verse_number": "३-४-२७", "content_sanskrit": "देवि किञ्चिद्विहीनेन चाङ्गहानिः प्रजायतेअंगहीनं च यत्कर्म्म चाङ्गहीनो  यथा नरः ।\nअंगहीने च कार्य्ये च फलहानिः प्रजायते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003024027, "chapter_id": 23024, "verse_number": "३-४-२८", "content_sanskrit": "अष्टोत्तरशतं पुष्पं पारिजातस्य विष्णवे ।\nदेयं प्रतिदिनं दुर्गे स्वात्मनो रूपहेतवे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003024028, "chapter_id": 23024, "verse_number": "३-४-२९", "content_sanskrit": "श्वेतचम्पकपुष्पाणां लक्षमक्षतमीप्सितम् ।\nप्रदेयं हरये भक्त्या वर्णसौन्दर्य्यहेतवे ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003024029, "chapter_id": 23024, "verse_number": "३-४-३०", "content_sanskrit": "सहस्रपत्रपद्मानामक्षतं लक्षकं तथा ।\nभक्त्या देयं च हरये मुखसौन्दर्य्यहेतवे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003024030, "chapter_id": 23024, "verse_number": "३-४-३१", "content_sanskrit": "अमूल्यरत्नरचितं दर्पणानां सहस्रकम् ।\nदेयं नारायणायैव नेत्रयोर्दीप्तिहेतवे ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003024031, "chapter_id": 23024, "verse_number": "३-४-३२", "content_sanskrit": "नीलोत्पलानां लक्षं च देयं कृष्णाय भक्तितः ।\nव्रताङ्गभूतं देवेशि चक्षुषो रूपहेतवे ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003024032, "chapter_id": 23024, "verse_number": "३-४-३३", "content_sanskrit": "हिमालयोद्भवं लक्षं रुचिरं श्वेतचामरम् ।\nप्रदेयं केशवायैव केशसौन्दर्य्यहेतवे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003024033, "chapter_id": 23024, "verse_number": "३-४-३४", "content_sanskrit": "अमूल्यरत्नरचितं पुटकानां सहस्रकम् ।\nप्रदेयं गोपिकेशाय नासासौन्दर्यहेतवे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003024034, "chapter_id": 23024, "verse_number": "३-४-३५", "content_sanskrit": "बन्धूकपुष्पलक्षं च देयं राधेश्वराय च ।\nसौम्यौष्ठाधरयोश्चैव वर्णसौन्दर्यहेतवे ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003024035, "chapter_id": 23024, "verse_number": "३-४-३६", "content_sanskrit": "मुक्ताफलानां लक्षं च दन्तसौन्दर्यहेतवे ।\nदेयं गोलोकनाथाय शैलजे भक्तिपूर्वकम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003024036, "chapter_id": 23024, "verse_number": "३-४-३७", "content_sanskrit": "रत्नगण्डूषलक्षं च गण्डसौन्दर्य्यहेतवे ।\nमहेश्वराय दातव्यं व्रते शैलेन्द्रकन्यके ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003024037, "chapter_id": 23024, "verse_number": "३-४-३८", "content_sanskrit": "रत्नपाशकलक्षं च देयं ब्रह्मेश्वराय च ।\nओष्ठाधः स्थलरूपाय व्रती प्राणेशि भक्तितः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003024038, "chapter_id": 23024, "verse_number": "३-४-३९", "content_sanskrit": "कर्णभूषणलक्षं च रत्नसारविनिर्म्मितम् ।\nदेयं सर्वेश्वरायैव कर्णसौन्दर्य्यहेतवे ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003024039, "chapter_id": 23024, "verse_number": "३-४-४०", "content_sanskrit": "माध्वीककलशानां च लक्षं रत्नविनिर्म्मितम् ।\nदेयं विश्वेश्वरायैव स्वरसौन्दर्य्यहेतवे ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003024040, "chapter_id": 23024, "verse_number": "३-४-४१", "content_sanskrit": "सुधापूर्णं च कुम्भानां सहस्रं रत्ननिर्म्मितम् ।\nदेयं कृष्णाय देवेशि वाक्यसौन्दर्य्यहेतवे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003024041, "chapter_id": 23024, "verse_number": "३-४-४२", "content_sanskrit": "रत्नप्रदीपलक्षं च गोपवेषविधायिने ।\nदेयं किशोरवेषाय दृष्टिसौन्दर्य्य हेतवे ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003024042, "chapter_id": 23024, "verse_number": "३-४-४३", "content_sanskrit": "धत्तूरकुसुमाकारं रत्नपात्रसहस्रकम् ।\nदेयं गोरक्षकायैव बलसौन्दर्य्यहेतवे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003024043, "chapter_id": 23024, "verse_number": "३-४-४४", "content_sanskrit": "सद्रत्नसाररचितं पद्मनालसहस्रकम् ।\nदेयं चण्डकपालाय बाहुसौन्दर्य्यहेतवे ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003024044, "chapter_id": 23024, "verse_number": "३-४-४५", "content_sanskrit": "लक्षं च रक्तपद्मानां करसौन्दर्यहेतव ।\nदेयं गोपांगनेशाय नारायणि हरिव्रते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003024045, "chapter_id": 23024, "verse_number": "३-४-४६", "content_sanskrit": "अंगुलीयकलक्षं च रत्नसारविनिर्म्मितम् ।\nअंगुलीनां च रूपार्थं देयं देवेश्वराय च ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003024046, "chapter_id": 23024, "verse_number": "३-४-४७", "content_sanskrit": "मणीन्द्रसारलक्षं च श्वेतवर्णं मनोहरम् ।\nदेयं मुनीन्द्रनाथाय नखसौन्दर्य्यहेतवे ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003024047, "chapter_id": 23024, "verse_number": "३-४-४८", "content_sanskrit": "सद्रत्नसारहाराणां लक्षं चातिमनोहरम् ।\nदेयं मदनमोहाय वक्षःसौन्दर्य्यहेतवे ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003024048, "chapter_id": 23024, "verse_number": "३-४-४९", "content_sanskrit": "सुपक्वश्रीफलानां च लक्षं च सुमनोहरम् ।\nदेयं सिद्धेन्द्रनाथाय स्तनसौन्दर्य्यहेतवे ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003024049, "chapter_id": 23024, "verse_number": "३-४-५०", "content_sanskrit": "सद्रत्नवर्तुलाकारपत्रलशं मनोहरम् ।\nदेयं पद्मालयेशाय देहसौन्दर्य्यहेतवे ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003024050, "chapter_id": 23024, "verse_number": "३-४-५१", "content_sanskrit": "सद्रत्नसाररचितं नाभीनां च सहस्रकम् ।\nप्रदेयं पद्मनाभाय नाभिसौन्दर्य्यहेतवे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003024051, "chapter_id": 23024, "verse_number": "३-४-५२", "content_sanskrit": "सद्रत्नसाररचितं रथचक्रसहस्रकम् ।\nनितम्बसौन्दर्य्यार्थं च देयं वै चक्रपाणये ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003024052, "chapter_id": 23024, "verse_number": "३-४-५३", "content_sanskrit": "सुवर्णरम्भास्तम्भानां लक्षं च सुमनोहरम् ।\nप्रदेयं श्रीनिवासाय श्रोणिसौन्दर्य्यहेतवे ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003024053, "chapter_id": 23024, "verse_number": "३-४-५४", "content_sanskrit": "शतपत्रस्थलाब्जानां लक्षमम्लानमक्षतम् ।\nप्रदेयं पद्मनेत्राय पादसौन्दर्य्यहेतवे ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003024054, "chapter_id": 23024, "verse_number": "३-४-५५", "content_sanskrit": "सुवर्णरचितानां च खञ्जनानां सहस्रकम् ।\nगतिसौन्दर्य्यहेत्वर्थं देयं लक्ष्मीश्वराय च ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003024055, "chapter_id": 23024, "verse_number": "३-४-५६", "content_sanskrit": "राजहंससहस्रं च गजेन्द्राणां सहस्रकम् ।\nसुवर्णरचितं देयं हरये गतिहेतवे ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003024056, "chapter_id": 23024, "verse_number": "३-४-५७", "content_sanskrit": "सुवर्णच्छत्रलक्षं च देयं नारायणाय च ।\nविचित्रं रत्नसारेण मूर्द्धसौन्दर्य्यहेतवे ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003024057, "chapter_id": 23024, "verse_number": "३-४-५८", "content_sanskrit": "मालतीनां च कुसुममक्षतं लक्षमीश्वरि ।\nदेयं वृन्दावनेशाय हास्यसौन्दर्य्यहेतवे ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003024058, "chapter_id": 23024, "verse_number": "३-४-५९", "content_sanskrit": "अमूल्यरत्नलक्षं च देयं नारायणाय वै ।\nसुव्रते व्रतपूर्णार्थं शीलसौन्दर्य्यहेतवे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003024059, "chapter_id": 23024, "verse_number": "३-४-६०", "content_sanskrit": "स्वच्छस्फटिकसङ्काशं मणीन्द्रश्रेष्ठलक्षकम् ।\nदेयं मुनीन्द्रनाथाय मनस्सौन्दर्य्यहेतवे ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003024060, "chapter_id": 23024, "verse_number": "३-४-६१", "content_sanskrit": "प्रवालसारसंकाशं मणिसारसहस्रकम् ।\nदेयं कृष्णाय भक्त्या च प्रियारागविवृद्धये ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003024061, "chapter_id": 23024, "verse_number": "३-४-६२", "content_sanskrit": "माणिक्यसारलक्षं च देयं कृष्णाय यत्नतः ।\nजन्मनः कोटिपर्य्यन्तं स्वामिसौभाग्यहेतवे ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003024062, "chapter_id": 23024, "verse_number": "३-४-६३", "content_sanskrit": "कूष्माण्डं नारिकेलं च जम्बीरं श्रीफलं तथा ।\nफलान्येतानि देयानि हरये पुत्रहेतवे ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003024063, "chapter_id": 23024, "verse_number": "३-४-६४", "content_sanskrit": "रत्नेन्द्रसारलक्षं च देयं कृष्णाय यत्नतः ।\nअसंख्यजन्मपर्य्यन्तं स्वामिनो धनवृद्धये ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003024064, "chapter_id": 23024, "verse_number": "३-४-६५", "content_sanskrit": "वाद्यं नानाप्रकारं च कांस्यतालादिकं परम् ।\nव्रते सम्पत्तिवृद्ध्यर्थ श्रीहरिं श्रावयेद्व्रती ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003024065, "chapter_id": 23024, "verse_number": "३-४-६६", "content_sanskrit": "पायसं पिष्टकं सर्पिः शर्कराक्तं मनोहरम् ।\nप्रदेयं हरये भक्त्या स्वामिनो भोगवृद्धये ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003024066, "chapter_id": 23024, "verse_number": "३-४-६७", "content_sanskrit": "सुगन्धिपुष्पमालानां लक्षमक्षतमीप्सितम् ।\nप्रदेयं हरये भक्त्या हरिभक्तिविवृद्धये ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003024067, "chapter_id": 23024, "verse_number": "३-४-६८", "content_sanskrit": "नैवेद्यानि च देयानि स्वादूनि मधुराणि च ।\nश्रीकृष्णप्रीतिप्राप्त्यर्थं दुर्गे नानाविधानि च ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003024068, "chapter_id": 23024, "verse_number": "३-४-६९", "content_sanskrit": "नानाविधानि पुष्पाणि तुलसीसंयुतानि च ।\nश्रीकृष्णप्रीतये भक्त्या व्रते देयानि सुव्रते ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003024069, "chapter_id": 23024, "verse_number": "३-४-७०", "content_sanskrit": "ब्राह्मणानां सहस्रं च प्रत्यहं भोजयेद्व्रती ।\nस्वात्मनः सस्यवृद्ध्यर्थं व्रते जन्मनि जन्मनि ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003024070, "chapter_id": 23024, "verse_number": "३-४-७१", "content_sanskrit": "पुष्पाञ्जलिशतं देयं नित्यं पूर्णं च पूजने ।\nप्रणामशतकं देवि कर्तव्यं भक्तिवृद्धये ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003024071, "chapter_id": 23024, "verse_number": "३-४-७२", "content_sanskrit": "षण्मासांश्च हविष्यान्नं मासान्पञ्च फलादिकम् ।\nहविः पक्षं जलं पक्षं व्रते भक्षेच्च सुव्रते ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003024072, "chapter_id": 23024, "verse_number": "३-४-७३", "content_sanskrit": "रत्नप्रदीपशतकं वह्निं दद्याद्दिवानिशम् ।\nरात्रौ कुशासनं कृत्वा नित्यं जागरणं व्रते ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003024073, "chapter_id": 23024, "verse_number": "३-४-७४", "content_sanskrit": "स्मरणं कीर्त्ततं केलिः प्रेक्षणं गुह्यभाषणम् ।\nसंकल्पोऽध्यवसायश्च क्रियानिर्वृत्तिरित्यपि ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003024074, "chapter_id": 23024, "verse_number": "३-४-७५", "content_sanskrit": "स्वप्नमैथुनकं त्याज्यं व्रतिना व्रतशुद्धये ।\nसम्पूर्णे च व्रते देवि प्रतिष्ठा तदनन्तरम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003024075, "chapter_id": 23024, "verse_number": "३-४-७६", "content_sanskrit": "त्रिशतं वै षष्ट्यधिकं रल्लकं वस्त्रसंयुतम् ।\nसभोज्यं सोपवीतं च सोपहारं ददात्वयम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003024076, "chapter_id": 23024, "verse_number": "३-४-७७", "content_sanskrit": "त्रिशतं वै षष्ट्यधिकसहस्रं विप्रभोजनम् ।\nत्रिशतं वै षष्ट्यधिकं सहस्रं तिलहोमकम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003024077, "chapter_id": 23024, "verse_number": "३-४-७८", "content_sanskrit": "त्रिशतं वै षष्ट्यधिकं सहस्रं स्वर्णमेव च ।\nदेया व्रतसमाप्तौ च दक्षिणा विधिबोधिता ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003024078, "chapter_id": 23024, "verse_number": "३-४-७९", "content_sanskrit": "अन्यां समाप्तिदिवसे कथयिष्यामि दक्षिणाम् ।\nएतद्व्रतफलं देवि दृढा भक्तिर्हरौ भवेत् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003024079, "chapter_id": 23024, "verse_number": "३-४-८०", "content_sanskrit": "हरितुल्यो भवेत्पुत्रो विख्यातो भुवनत्रये ।\nसौन्दर्यं स्वामिसौभाग्यमैश्वर्य्यं विपुलं धनम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003024080, "chapter_id": 23024, "verse_number": "३-४-८१", "content_sanskrit": "सर्ववाञ्छितसिद्धीनां बीजं जन्मनि जन्मनि ।\nइत्येवं कथितं देवि व्रतं कुरु महेश्वरि ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003024081, "chapter_id": 23024, "verse_number": "३-४-८२", "content_sanskrit": "पुत्रस्ते भविता साध्वीत्युक्त्वा स विरराम ह ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]