[{"id": 2172511, "chapter_id": 4676, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2172512, "chapter_id": 4676, "verse_number": "१", "content_sanskrit": "शृणु राजन्नवहितो यथावृत्तो महान् क्षयः ।\nकुरूणां पाण्डवानां च समासाद्य परस्परम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2172513, "chapter_id": 4676, "verse_number": "२", "content_sanskrit": "निहते सूतपुत्रे तु पाण्डवेन महात्मना ।\nविद्रुतेषु च सैन्येषु समानीतेषु चासकृत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2172514, "chapter_id": 4676, "verse_number": "३", "content_sanskrit": "घोरे मनुष्यदेहानामाजौ नरवरक्षये ।\nयत्तत्कर्णे हते पार्थः सिंहनादमथाकरोत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2172515, "chapter_id": 4676, "verse_number": "४", "content_sanskrit": "तदा तव सुतान् राजन् प्राविशत् सुमहद्भयम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2172516, "chapter_id": 4676, "verse_number": "५", "content_sanskrit": "न सन्धातुमनीकानि न चैवाथ पराक्रमे ।\nआसीद् बुद्धिर्हते कर्णे तव योधस्य कस्यचित्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2172517, "chapter_id": 4676, "verse_number": "६", "content_sanskrit": "वणिजो नावि भिन्नायामगाधे विप्लवा इव ।\nअपारे पारमिच्छन्तो हते द्वीपे किरीटिना\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2172518, "chapter_id": 4676, "verse_number": "७", "content_sanskrit": "सूतपुत्रे हते राजन् वित्रस्ताः शरविक्षताः ।\nअनाथा नाथमिच्छन्तो मृगाः सिंहार्दिता इव\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2172519, "chapter_id": 4676, "verse_number": "८", "content_sanskrit": "भग्नशृङ्गा इव वृषा शीर्णदंष्ट्रा इवोरगाः ।\nप्रत्युपायाम सायाह्ने निर्जिता सव्यसाचिना\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2172520, "chapter_id": 4676, "verse_number": "९", "content_sanskrit": "हतप्रवीरा विध्वस्ता निकृत्ता निशितैः शरैः ।\nसूतपुत्रे हते राजन् पुत्रास्ते प्राद्रवंस्ततः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2172521, "chapter_id": 4676, "verse_number": "१०", "content_sanskrit": "विशस्त्रकवचाः सर्वे कान्दिशीका विचेतसः ।\nअन्योन्यमभिनिघ्नन्तो वीक्षमाणा भूयाद् दिशः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2172522, "chapter_id": 4676, "verse_number": "११", "content_sanskrit": "मामेव नूनं बीभत्सुर्मामेव च वृकोदरः ।\nअभियातीति मन्वानाः पेतुर्मम्रुश्च भारत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2172523, "chapter_id": 4676, "verse_number": "१२", "content_sanskrit": "अश्वानन्ये गजानन्ये रथानन्ये महारथाः ।\nआरुह्य जवसम्पन्नाः पादातान् प्रजहुर्भयात्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2172524, "chapter_id": 4676, "verse_number": "१३", "content_sanskrit": "कुञ्जरैः स्यन्दना भग्नाः सादिनश्च महारथैः ।\nपदातिसङ्घाश्चाश्वोघैः पलायद्भिर्भृशं हताः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2172525, "chapter_id": 4676, "verse_number": "१४", "content_sanskrit": "व्यालतस्करसङ्कीर्णे सार्थहीना यथा वने ।\nतथा त्वदीया निहते सूतपुत्रे तदाऽभवन्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2172526, "chapter_id": 4676, "verse_number": "१५", "content_sanskrit": "हतारोहास्तथा नागाश्छिन्नहस्तास्तथाऽपरे ।\nसर्वं पार्थमयं लोकमपश्यन् वै भयार्दिताः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2172527, "chapter_id": 4676, "verse_number": "१६", "content_sanskrit": "तान् प्रेक्ष्य द्रवतः सर्वान् भीमसेनभयार्दितान् ।\nदुर्योधनोऽथ स्वं दूतं हाहाकृत्वैवमब्रवीत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2172528, "chapter_id": 4676, "verse_number": "१७", "content_sanskrit": "नातिक्रमिष्यते पार्थो धनुष्पाणिमवस्थितम् ।\nजघने वर्तमानं मां तूर्णमश्वान् प्रचोदय\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2172529, "chapter_id": 4676, "verse_number": "१८", "content_sanskrit": "समरे युध्यमानं हि कौन्तेयो मां धनञ्जयः ।\nनोत्सहेताप्यतिक्रान्तुं वेलामिव महार्णवः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2172530, "chapter_id": 4676, "verse_number": "१९", "content_sanskrit": "अद्यार्जुनं सगोविन्दं मानिनं च वृकोदरम् ।\nनिहत्य शिष्टान् शत्रूंश्च कर्णस्यानृण्यमाप्नुयाम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2172531, "chapter_id": 4676, "verse_number": "२०", "content_sanskrit": "तच्छ्रुत्वा कुरुराजस्य शूरार्यसदृशं वचः ।\nसूतो हेमपरिच्छन्नान् शनैरश्वानचोदयत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2172532, "chapter_id": 4676, "verse_number": "२१", "content_sanskrit": "गजाश्वरथहीनास्तु पदाताश्चैव मारिष ।\nपञ्चविंशतिसाहस्राः प्राद्रवन् शनकैरिव\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2172533, "chapter_id": 4676, "verse_number": "२२", "content_sanskrit": "तान् भीमसेनः सङ्क्रुद्धो धृष्टद्युम्नश्च पार्षतः ।\nबलेन चतुरङ्गेण परिक्षिप्याहनच्छरैः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2172534, "chapter_id": 4676, "verse_number": "२३", "content_sanskrit": "प्रत्ययुध्यंस्तु ते सर्वे भीमसेनं सपार्षतम् ।\nपार्थपार्षतयोश्चान्ये जगृहुस्तत्र नामनी\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2172535, "chapter_id": 4676, "verse_number": "२४", "content_sanskrit": "अक्रुद्ध्यत रणे भीमस्तैर्मृधे प्रत्यवस्थितैः ।\nसोऽवतीर्य रथात्तूर्णं गदापाणिरयुध्यत\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2172536, "chapter_id": 4676, "verse_number": "२५", "content_sanskrit": "न तान् रथस्थो भूमिष्ठान् धर्मापेक्षी वृकोदरः ।\nयोधयामास कौन्तेयो भुजवीर्यमुपाश्रितः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2172537, "chapter_id": 4676, "verse_number": "२६", "content_sanskrit": "जातरूपपरिच्छन्नां प्रगृह्य महतीं गदाम् ।\nन्यवधीत् तावकान् सर्वान् दण्डपाणिरिवान्तकः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2172538, "chapter_id": 4676, "verse_number": "२७", "content_sanskrit": "पदातयो हि संरब्धास्त्यक्तजीवितबान्धवाः ।\nभीममभ्यद्रवन् सङ्खे पतङ्गा इव पावकम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2172539, "chapter_id": 4676, "verse_number": "२८", "content_sanskrit": "आसाद्य भीमसेनं ते संरब्धा युद्धदुर्मदाः ।\nविनेदुः सहसा दृष्ट्वा भूतग्रामा इवान्तकम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2172540, "chapter_id": 4676, "verse_number": "२९", "content_sanskrit": "श्येनवद् व्यचरद् भीमः खड्गेन गदया तथा ।\nपञ्चविंशतिसाहस्रांस्तावकानां व्यपोथयत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2172541, "chapter_id": 4676, "verse_number": "३०", "content_sanskrit": "हत्वा तत्पुरुषानीकं भीमः सत्यपराक्रमः ।\nधृष्टद्युम्नं पुरस्कृत्य पुनस्तस्थौ महाबलः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2172542, "chapter_id": 4676, "verse_number": "३१", "content_sanskrit": "धनञ्जयो रथानीकमन्वपद्यत वीर्यवान्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2172543, "chapter_id": 4676, "verse_number": "३२", "content_sanskrit": "माद्रीपुत्रौ च शकुनिं सात्यकिश्च महाबलः ।\nजवेनाभ्यपतन् हृष्टा घ्नन्तो दौर्योधनं बलम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2172544, "chapter_id": 4676, "verse_number": "३३", "content_sanskrit": "तस्याश्ववाहान् सुबहूंस्ते निहत्य शितैः शरैः ।\nतमन्वधावंस्त्वरितास्तत्र युद्धमवर्तत ।\nततो धनञ्जयो राजन् रथानीकमगाहत\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2172545, "chapter_id": 4676, "verse_number": "३४", "content_sanskrit": "विश्रुतं त्रिषु लोकेषु गाण्डीवं व्याक्षिपन् धनुः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2172546, "chapter_id": 4676, "verse_number": "३५", "content_sanskrit": "कृष्णसारथिमायान्तं दृष्ट्वा श्वेतहयं रथम् ।\nअर्जुनं चापि योद्धारं त्वदीयाः प्राद्रवन् भयात्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2172547, "chapter_id": 4676, "verse_number": "३६", "content_sanskrit": "विप्रहीनरथाश्वाश्च शरैश्च परिवारिताः ।\nपञ्चविंशतिसाहस्राः पार्थमार्च्छन् पदातयः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2172548, "chapter_id": 4676, "verse_number": "३७", "content_sanskrit": "हत्वा तत्पुरुषानीकं पाञ्चालानां महारथः ।\nभीमसेनं पुरस्कृत्य न चिरात् प्रत्यदृश्यत\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2172549, "chapter_id": 4676, "verse_number": "३८", "content_sanskrit": "महाधनुर्धरः श्रीमानमित्रगणमर्दनः ।\nपुत्रः पाञ्चालराजस्य धृष्टद्युम्नो महायशाः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2172550, "chapter_id": 4676, "verse_number": "३९", "content_sanskrit": "पारावतसवर्णाश्वं कोविदारवरध्वजम् ।\nधृष्टद्युम्नं रणे दृष्ट्वा त्वदीयाः प्राद्रवन् भयात्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2172551, "chapter_id": 4676, "verse_number": "४०", "content_sanskrit": "गान्धारराजं शीघ्रास्त्रमनुसृत्य यशस्विनौ ।\nअचिरात् प्रत्यदृश्येतां माद्रीपुत्रौ ससात्यकी\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2172552, "chapter_id": 4676, "verse_number": "४१", "content_sanskrit": "चेकितानः शिखण्डी च द्रौपदेयाश्च मारिष ।\nहत्वा त्वदीयं सुमहत्सैन्यं शङ्खानथाधमन्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2172553, "chapter_id": 4676, "verse_number": "४२", "content_sanskrit": "ते सर्वे तावकान् प्रेक्ष्य द्रवतो वै पराङ्मुखान् ।\nअभ्यधावन्त निघ्नन्तो वृषान् जित्वा वृषा इव\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2172554, "chapter_id": 4676, "verse_number": "४३", "content_sanskrit": "सेनावशेषं तं दृष्ट्वा तव पुत्रस्य पाण्डवः ।\nअवस्थितं सव्यसाची चुक्रोध बलवन्नृप\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2172555, "chapter_id": 4676, "verse_number": "४४", "content_sanskrit": "तत एनं शरै राजन् सहसा समवाकिरत् ।\nरजसा चोद्गतेनाथ न स्म किञ्चन दृश्यते\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2172556, "chapter_id": 4676, "verse_number": "४५", "content_sanskrit": "अन्धकारीकृते लोके शरीभूते महीतळे ।\nदिशः सर्वा महाराज तावकाः प्राद्रवन् भयात्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2172557, "chapter_id": 4676, "verse_number": "४६", "content_sanskrit": "भज्यमानेषु सर्वेषु कुरुराजो विशाम्पते ।\nपरेषामात्मनश्चैव सैन्ये ते समुपाद्रवत्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2172558, "chapter_id": 4676, "verse_number": "४७", "content_sanskrit": "ततो दुर्योधनः सर्वानाजुहावाथ पाण्डवान् ।\nयुद्धाय भरतश्रेष्ठ देवानिव पुरा बलिः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2172559, "chapter_id": 4676, "verse_number": "४८", "content_sanskrit": "त एनमभिगर्जन्तं सहिताः समुपाद्रवन् ।\nनानाशस्त्रसृजः क्रुद्धा भर्त्सयन्तो मुहुर्मुहुः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2172560, "chapter_id": 4676, "verse_number": "४९", "content_sanskrit": "दुर्योधनोऽप्यसम्भ्रान्तस्तानरीन् व्यधमच्छरैः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2172561, "chapter_id": 4676, "verse_number": "५०", "content_sanskrit": "तत्राद्भुतमपश्याम तव पुत्रस्य पौरुषम् ।\nयदेनं पाण्डवाः सर्वे न शेकुरतिवर्तितुम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2172562, "chapter_id": 4676, "verse_number": "५१", "content_sanskrit": "नातिदूरापयातं च कृतबुद्धिः पलायने ।\nदुर्योधनः स्वकं सैन्यमपश्यद् भृशविक्षतम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2172563, "chapter_id": 4676, "verse_number": "५२", "content_sanskrit": "ततोऽवस्थाप्य राजेन्द्र कृतबुद्धिस्तवात्मजः ।\nहर्षयन्निव तान् योधांस्ततो वचनमब्रवीत्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2172564, "chapter_id": 4676, "verse_number": "५३", "content_sanskrit": "न तं देशं प्रपश्यामि पृथिव्यां पर्वतेषु च ।\nयत्र यातान्न वो हन्युः पाण्डवाः किं सृतेन वः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2172565, "chapter_id": 4676, "verse_number": "५४", "content_sanskrit": "स्वल्पं चैव बलं तेषां कृष्णौ च भृशविक्षतौ ।\nयदि सर्वेऽत्र तिष्ठामो ध्रुवं नो विजयो भवेत्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2172566, "chapter_id": 4676, "verse_number": "५५", "content_sanskrit": "विप्रयातांस्तु वो भिन्नान् पाण्डवाः कृतकिल्बिषान् ।\nअनुसृत्य हनिष्यन्ति श्रेयो नः समरे वधः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2172567, "chapter_id": 4676, "verse_number": "५६", "content_sanskrit": "सुखः साङ्ग्रामिको मृत्युः क्षत्रधर्मेण युद्ध्यताम् ।\nमृतो दुःखं न जानीते प्रेत्य चानन्त्यमश्नुते\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2172568, "chapter_id": 4676, "verse_number": "५७", "content_sanskrit": "शृण्वन्तु क्षत्रियाः सर्वे यावन्तोऽत्र समागताः ।\nद्विषतो भीमसेनस्य वशमेष्यथ विद्रुताः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2172569, "chapter_id": 4676, "verse_number": "५८", "content_sanskrit": "पितामहैराचरितं न धर्मं हातुमर्हथ ।\nनान्यत्कर्मास्ति पापीयः क्षत्रियस्य पलायनात्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2172570, "chapter_id": 4676, "verse_number": "५९", "content_sanskrit": "न युद्धधर्माच्छ्रेयान् हि पन्थाः स्वर्गस्य कौरवाः ।\nअचिरेणार्जिताँल्लोकान् सद्यो युद्धात् समश्नुते\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2172571, "chapter_id": 4676, "verse_number": "६०", "content_sanskrit": "तस्य तद्वचनं राज्ञः पूजयित्वा महारथाः ।\nपुनरेवाभ्यवर्तन्त क्षत्रियाः पाण्डवान् प्रति\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2172572, "chapter_id": 4676, "verse_number": "६१", "content_sanskrit": "पराजयममृष्यन्तः कृतचित्ताश्च विक्रमे\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2172573, "chapter_id": 4676, "verse_number": "६२", "content_sanskrit": "ततः प्रववृते युद्धं पुनरेव सुदारुणम् ।\nतावकानां परेषां च देवासुररणोपमम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2172574, "chapter_id": 4676, "verse_number": "६३", "content_sanskrit": "युधिष्ठिरपुरोगांश्च सर्वसैन्येन पाण्डवान् ।\nअन्वधावन्महाराज पुत्रो दुर्योधनस्तव\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2172575, "chapter_id": 4676, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि तृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2172576, "chapter_id": 4676, "verse_number": "", "content_sanskrit": "शल्यवधपर्वणि तृतीयोऽध्यायः ॥३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]