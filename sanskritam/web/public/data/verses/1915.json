[{"id": 2041152, "chapter_id": 1915, "verse_number": "५-१६०-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2041153, "chapter_id": 1915, "verse_number": "५-१६०-१", "content_sanskrit": "हिरण्वत्यां निविष्टेषु पाण्डवेषु महात्मसु।\nन्यविशन्त महाराज कौरवेया यथाविधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2041154, "chapter_id": 1915, "verse_number": "५-१६०-२", "content_sanskrit": "तत्र दुर्योधनो राजा निवेस्य बलमोजसा ।\nसंमानयित्वा नृपतीन्न्यस्य गुल्मांस्तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2041155, "chapter_id": 1915, "verse_number": "५-१६०-३", "content_sanskrit": "आरक्षस्य विधिं कृत्वा योधानां तत्र भारत ।\nकर्णं दुःशासनं चैव शकुनिं चापि सौबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2041156, "chapter_id": 1915, "verse_number": "५-१६०-४", "content_sanskrit": "आनाय्य नृपतिस्तत्र मन्त्रयामास भारत।\nतत्र दुर्योधनो राजा कर्णेन सह भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2041157, "chapter_id": 1915, "verse_number": "५-१६०-५", "content_sanskrit": "सौबलेन च राजेन्द्र मन्त्रयित्वा नरर्षभ ।\nआहूयोपह्वरे राजन्नुलूकमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2041158, "chapter_id": 1915, "verse_number": "५-१६०-६", "content_sanskrit": "उलूक गच्छ कैतव्य पाण्डवान्सहसोमकान्।\nगत्वा मम वचो ब्रूहि वासुदेवस्य श्रृण्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2041159, "chapter_id": 1915, "verse_number": "५-१६०-७", "content_sanskrit": "इदं तत्समनुप्राप्तं वर्षपूगाभिचिन्तितम् ।\nपाण्डवानां कुरूणां च युद्धं लोकभयङ्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2041160, "chapter_id": 1915, "verse_number": "५-१६०-८", "content_sanskrit": "यदेतत्कत्थनावाक्यं सञ्जयो महदब्रवीत्।\nवासुदेवसहायस्य गर्जतः सानुजस्य ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2041161, "chapter_id": 1915, "verse_number": "५-१६०-९", "content_sanskrit": "मध्ये करूणां कौन्तेय तस्य कालोयमागतः ।\nयथावत्संप्रतिज्ञातं तत्सर्वं क्रियतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2041162, "chapter_id": 1915, "verse_number": "५-१६०-१०", "content_sanskrit": "ज्येष्ठं तथैव कौन्तेयं ब्रूयास्त्यं वचनान्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2041163, "chapter_id": 1915, "verse_number": "५-१६०-११", "content_sanskrit": "भ्रातृभिः सहितः सर्वैः सोमकैश्च सकेकयैः।\nकथं वा धार्मिको भूत्वा त्वमधर्मे मनः कृथाः।\nय इच्छसि जगत्सर्वं नश्यमानं नृशंसवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2041164, "chapter_id": 1915, "verse_number": "५-१६०-१२", "content_sanskrit": "अभयं सर्वभूतेभ्यो पाता त्वमिति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2041165, "chapter_id": 1915, "verse_number": "५-१६०-१३", "content_sanskrit": "श्रूयते हि पुरा गीतः श्लोकोऽयं भरतर्षभ ।\nप्रह्लादेनाथ भद्रं ते हृते राज्ये तु दैवतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2041166, "chapter_id": 1915, "verse_number": "५-१६०-१४", "content_sanskrit": "यस्य धर्मध्वजो नित्यं सुरा ध्वज इवोच्छ्रितः।\nप्रच्छन्नानि च पापानि बैडालं नाम तद्ब्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2041167, "chapter_id": 1915, "verse_number": "५-१६०-१५", "content_sanskrit": "अत्र ते वर्तयिष्यामि आख्यानमिदमुत्तमम् ।\nकथितं नारदेनेह पितुर्मम नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2041168, "chapter_id": 1915, "verse_number": "५-१६०-१६", "content_sanskrit": "मार्जारः किल दुष्टात्मा निश्चेष्टः सर्वकर्मसु।\nऊर्ध्वबाहुः स्थितो राजन् गङ्गातीर कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2041169, "chapter_id": 1915, "verse_number": "५-१६०-१७", "content_sanskrit": "स वै कृत्वा मनःशुद्धिं प्रत्ययार्थं शरीरिणाम् ।\nकरोमि धर्ममित्याह सर्वानेव शरीरिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2041170, "chapter_id": 1915, "verse_number": "५-१६०-१८", "content_sanskrit": "तस्य कालेन महता विस्त्रम्यं जग्मुरण्डजाः।\nसमेत्य च प्रशंसन्ति मार्जारं तं विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2041171, "chapter_id": 1915, "verse_number": "५-१६०-१९", "content_sanskrit": "पूज्यमानस्तु तैः सर्वैः पक्षिभिः पक्षिभोजनः।\nआत्मकार्यं कृतं मेने चार्यायाश्च कृतं फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2041172, "chapter_id": 1915, "verse_number": "५-१६०-२०", "content_sanskrit": "अथ दीर्घस्य कालस्य तं देशं मूषिका ययुः।\nददृशुस्तं च ते तत्र धार्मिकं व्रतचारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2041173, "chapter_id": 1915, "verse_number": "५-१६०-२१", "content_sanskrit": "कार्येण महता युक्तं दम्भयुक्तेन भारत ।\nतेषां मतिरियं राजन्नासीत्तत्र विनिश्चये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2041174, "chapter_id": 1915, "verse_number": "५-१६०-२२", "content_sanskrit": "बहुमित्रा वयं सर्वे तेषां नो मातुलो ह्ययम् ।\nरक्षां करोतु सततं वृद्धबालस्य सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2041175, "chapter_id": 1915, "verse_number": "५-१६०-२३", "content_sanskrit": "उपगम्य तु ते सर्वे बिडालमिदमब्रुवन् ।\nभवत्प्रसादादिच्छामश्चर्तुं चैव यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2041176, "chapter_id": 1915, "verse_number": "५-१६०-२४", "content_sanskrit": "भवान्नो गतिरव्यग्रा भवान्नः परमः सुहृत्।\nते वयं सहिताः सर्वे भवन्तं शरणं गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2041177, "chapter_id": 1915, "verse_number": "५-१६०-२५", "content_sanskrit": "भवान्धर्मपरो नित्यं भवान्धर्मे व्यवस्थितः।\nस नो रक्ष महाप्रज्ञ त्रिदशानिव वज्रभृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2041178, "chapter_id": 1915, "verse_number": "५-१६०-२६", "content_sanskrit": "एवमुक्तस्तु तैः सर्वैर्मूषिकैः स विशांपते।\nप्रत्युवाच ततः सर्वान्मूषिकान्मूषिकान्तकृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2041179, "chapter_id": 1915, "verse_number": "५-१६०-२७", "content_sanskrit": "द्वयोर्योगं न पश्यामि तपसो रक्षणस्य च।\nअवश्यं तु मया कार्यं वचनं भवतां हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2041180, "chapter_id": 1915, "verse_number": "५-१६०-२८", "content_sanskrit": "युष्माभिरपि कर्तव्यं वचनं मम नित्यशः।\nतपसास्मि परिश्रान्तो दृढं नियमामास्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2041181, "chapter_id": 1915, "verse_number": "५-१६०-२९", "content_sanskrit": "न चापि गमने शक्तिं कांचित्पश्यामि चिन्तयन्।\nसोस्मि नेयः सदा ताता नदीकूलमितःपरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2041182, "chapter_id": 1915, "verse_number": "५-१६०-३०", "content_sanskrit": "तथेति तं प्रतिज्ञाय मूषिका भरतर्षभ ।\nवृद्धबालमथो सर्वं मार्जाराय न्यवेदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2041183, "chapter_id": 1915, "verse_number": "५-१६०-३१", "content_sanskrit": "ततः स पापो दुष्टात्मा मूषिकानथ भक्षयन्।\nपीवरश्च सुवर्णश्च दृढबन्धश्च जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2041184, "chapter_id": 1915, "verse_number": "५-१६०-३२", "content_sanskrit": "मूषिकाणां गणश्चात्र भृशं संक्षीयतेऽथ सः।\nमार्जारो वर्धते चापि तेजोबलसमन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2041185, "chapter_id": 1915, "verse_number": "५-१६०-३३", "content_sanskrit": "ततस्ते मूषिकाः सर्वे समेत्यान्योन्यमब्रुवन् ।\nमातुलो वर्धते नित्यं वयं क्षीयामहे भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2041186, "chapter_id": 1915, "verse_number": "५-१६०-३४", "content_sanskrit": "ततः प्राज्ञतमः कश्चिड्डिण्डिको नाम मूषिकः।\nअब्रवीद्वचनं राजन्मूषिकाणां महागणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2041187, "chapter_id": 1915, "verse_number": "५-१६०-३५", "content_sanskrit": "गच्छतां वो नदीतीरं सहितानां विशेषतः।\nपृष्ठतोऽहं गमिष्यामि सहैव मातुलेन तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2041188, "chapter_id": 1915, "verse_number": "५-१६०-३६", "content_sanskrit": "साधु साध्विति ते सर्वे पूजयाञ्चक्रिरे तदा।\nचक्रुश्चैव यथान्यायं डिण्डिकस्य वचोऽर्थवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2041189, "chapter_id": 1915, "verse_number": "५-१६०-३७", "content_sanskrit": "अविज्ञानात्ततः सोऽथ डिण्डिकं ह्युपभुक्तवान्।\nततस्ते सहिताः सर्वे मन्त्रयामासुरञ्जसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2041190, "chapter_id": 1915, "verse_number": "५-१६०-३८", "content_sanskrit": "तत्र वृद्धतमः कश्चित्कोलिको नाम मूषिकः ।\nअब्रवीद्वचनं राजञ्ज्ञातिमध्ये यथातथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2041191, "chapter_id": 1915, "verse_number": "५-१६०-३९", "content_sanskrit": "न मातुलो धर्मकामश्छद्ममात्रं कृता शिखा।\nन मूलफलभक्षस्य विष्ठा भवति लोमशा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2041192, "chapter_id": 1915, "verse_number": "५-१६०-४०", "content_sanskrit": "अस्य गात्राणि वर्धन्ते गणश्च परिहीयते ।\nअद्य सप्ताष्टदिवसान्डिण्डिकोपि न दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2041193, "chapter_id": 1915, "verse_number": "५-१६०-४१", "content_sanskrit": "एतच्छ्रुत्वा वचः सर्वे मूषिका विप्रदुद्रुवुः।\nबिडालोपि स दुष्टात्मा जगामैव यथागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2041194, "chapter_id": 1915, "verse_number": "५-१६०-४२", "content_sanskrit": "तथा त्वमपि दुष्टात्मन्बैडालं व्रतमास्थितः।\nचरसि ज्ञातिषु सदा बिडालोमूषिकेष्विव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2041195, "chapter_id": 1915, "verse_number": "५-१६०-४३", "content_sanskrit": "अन्यथा किल ते वाक्यमन्यथा कर्म दृश्यते।\nदम्भनार्थाय लोकस्य वेदाश्चोपशमश्च ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2041196, "chapter_id": 1915, "verse_number": "५-१६०-४४", "content_sanskrit": "त्यक्त्वा छद्म त्विदं राजन्क्षत्रधर्मं समाश्रितः ।\nकुरु कार्याणि सर्वाणि धर्मिष्ठोऽसि नरर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2041197, "chapter_id": 1915, "verse_number": "५-१६०-४५", "content_sanskrit": "बाहुवीर्येण पृथिवीं लब्ध्वा भरतसत्तम।\nदेहि दानं द्विजातिभ्यः पितृभ्यश्चयथोचितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2041198, "chapter_id": 1915, "verse_number": "५-१६०-४६", "content_sanskrit": "क्लिष्टाया वर्षपूगांश्च मातुर्मातृहिते स्थितः।\nप्रमार्जाश्रु रणे जित्वा संमानं परमावह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2041199, "chapter_id": 1915, "verse_number": "५-१६०-४७", "content_sanskrit": "पञ्चग्रामा वृता यत्नात्रास्माभिरपवर्जिताः।\nयुध्यामहे कथं सङ्ख्ये कोपयेम च पाण्डवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2041200, "chapter_id": 1915, "verse_number": "५-१६०-४८", "content_sanskrit": "त्वत्कृते दुष्टभावस्य संत्यागो विदुरस्य च।\nजातुषे च गृहे दाहं स्मर तं पुरुषो भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2041201, "chapter_id": 1915, "verse_number": "५-१६०-४९", "content_sanskrit": "यच्च कृष्णमवोचस्त्वमायान्तं कुरुसंसदि।\nअयमस्मि स्थितो राजञ्शमायसमराय च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2041202, "chapter_id": 1915, "verse_number": "५-१६०-५०", "content_sanskrit": "तस्यायमागतः कालः समरस्य नराधिप।\nएतदर्थं मया सर्वं कृतमेतद्युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2041203, "chapter_id": 1915, "verse_number": "५-१६०-५१", "content_sanskrit": "किं नु युद्धात्परं लाभं क्षत्रियो बहु मन्यते।\nकिंच त्वं क्षत्रियकुले जातः संप्रथितो भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2041204, "chapter_id": 1915, "verse_number": "५-१६०-५२", "content_sanskrit": "द्रोणादस्त्राणि संप्राप्य कृपाच्च भरतर्षभ ।\nतुल्ययोनौ समबले वासुदेवं समाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2041205, "chapter_id": 1915, "verse_number": "५-१६०-५३", "content_sanskrit": "ब्रूयास्त्वं वासुदेवं च पाण्डवानां समीपतः।\nआत्मार्थं पाण्डवार्थं च यत्तो मां प्रतियोधय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2041206, "chapter_id": 1915, "verse_number": "५-१६०-५४", "content_sanskrit": "सभामध्ये च यद्रूपं मायया कृतवानसि।\nतत्तथैव पुनः कृत्वा सार्जुनो मामभिद्रव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2041207, "chapter_id": 1915, "verse_number": "५-१६०-५५", "content_sanskrit": "इन्द्रजालं च मायां वै कुहका वापि भीषणा ।\nआत्तशस्त्रस्य सङ्ग्रमे वहन्ति प्रतिगर्जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2041208, "chapter_id": 1915, "verse_number": "५-१६०-५६", "content_sanskrit": "वयमप्युत्सहेम द्यां खं च गच्छेम मायया ।\nरसातलं विशामोपि ऐन्द्रं वा पुरमेव तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2041209, "chapter_id": 1915, "verse_number": "५-१६०-५७", "content_sanskrit": "दर्शयेम च रूपाणि स्वशरीरे बहून्यपि।\nन तु पर्यायतः सिद्धिर्बुद्धिमाप्नोति मानुषीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2041210, "chapter_id": 1915, "verse_number": "५-१६०-५८", "content_sanskrit": "मनसैव हि भूतानि धातैव कुरुते वशे।\nयद्ब्रवीषि च वार्ष्णेय धार्तराष्ट्रानहं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2041211, "chapter_id": 1915, "verse_number": "५-१६०-५९", "content_sanskrit": "घातयित्वा प्रदास्यामि पार्थेभ्यो राज्यमुत्तमम् ।\nआचचक्षे च मे सर्वं सञ्जयस्तव भाषितम्।\nमद्द्वितीयेन पार्थेन वैरं वः सव्यसाचिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2041212, "chapter_id": 1915, "verse_number": "५-१६०-६०", "content_sanskrit": "स सत्यसङ्गरो भूत्वा पाण्डवार्थे पराक्रमी ।\nयुद्ध्यस्वाद्य रणे यत्तः पश्यामः पुरुषो भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2041213, "chapter_id": 1915, "verse_number": "५-१६०-६१", "content_sanskrit": "यस्तु शत्रुमभिज्ञाय शुद्धं पौरुषमास्थितः।\nकरोति द्विषतां शोकं स जीवति सुजीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2041214, "chapter_id": 1915, "verse_number": "५-१६०-६२", "content_sanskrit": "अकस्माच्चैव ते कृष्ण ख्यातं लोके महद्यशः।\nअद्येदानीं विजानीमः सन्ति षण्डाः शश्रृङ्गकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2041215, "chapter_id": 1915, "verse_number": "५-१६०-६३", "content_sanskrit": "मद्विधो नापि नृपतिस्त्वयि युक्तः कथंचन ।\nसन्नाहं संयुगे कर्तुं कंसभृत्ये विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2041216, "chapter_id": 1915, "verse_number": "५-१६०-६४", "content_sanskrit": "तं च तूबरकं बालं बह्वाशिनमविद्यकम् ।\nउलूक मद्वचो ब्रूहि असकृद्भीमसेनकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2041217, "chapter_id": 1915, "verse_number": "५-१६०-६५", "content_sanskrit": "विराटनगरे पार्थ यस्त्वं सूदो ह्यभूः पुरा।\nबल्लवो नाम विख्यातस्तन्ममैव हि पौरुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2041218, "chapter_id": 1915, "verse_number": "५-१६०-६६", "content_sanskrit": "प्रतिज्ञातं सभामध्ये न तन्मिथ्या त्वया पुरा।\nदुःशासनस्य रुधिरं पीयतां यदि शक्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2041219, "chapter_id": 1915, "verse_number": "५-१६०-६७", "content_sanskrit": "यद्ब्रवीषि च कौन्तेय धार्तराष्ट्रानहं रणे।\nनिहनिष्यामि तरसा तस्य कालोऽयमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2041220, "chapter_id": 1915, "verse_number": "५-१६०-६८", "content_sanskrit": "त्वं हि भोज्ये पुरस्कार्यो भक्ष्ये पेये च भारत ।\nक्व युद्धं क्व च भोक्तव्यं युध्यस्व पुरुषो भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2041221, "chapter_id": 1915, "verse_number": "५-१६०-६९", "content_sanskrit": "शयिष्यसे हतो भूमौ गदामालिङ्ग्य भारत।\nतद्वृथा च सभामध्ये वल्गितं ते वृकोदर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2041222, "chapter_id": 1915, "verse_number": "५-१६०-७०", "content_sanskrit": "उलूक नकुलं ब्रूहि वचनान्मम भारत।\nयुध्द्यस्वाद्य स्थिरो भूत्वा पश्यामस्तव पौरुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2041223, "chapter_id": 1915, "verse_number": "५-१६०-७१", "content_sanskrit": "युधिष्ठिरानुरागं च द्वेषं च मयि भारत।\nकृष्णायाश्च परिक्लेशं स्मरेदानीं यथातथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2041224, "chapter_id": 1915, "verse_number": "५-१६०-७२", "content_sanskrit": "ब्रूयास्त्वं सहदेवं च राजमध्ये वचो मम।\nयुद्ध्येदानीं रणे यत्तः क्लेशान्स्मर च पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2041225, "chapter_id": 1915, "verse_number": "५-१६०-७३", "content_sanskrit": "विराटद्रुपदौ चोभौ ब्रूयास्त्वं वचनान्मम ।\nन दृष्टपूर्वा भर्तारो भृत्यैरपि महागुणैः ।\nतथार्थपतिभिर्भृत्या यतः सृष्टाः प्रजास्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2041226, "chapter_id": 1915, "verse_number": "५-१६०-७४", "content_sanskrit": "अश्लाघ्योऽयं नरपतिर्युवयोरिति चागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2041227, "chapter_id": 1915, "verse_number": "५-१६०-७५", "content_sanskrit": "ते यूयं संहता भूत्वा तद्वधार्थं ममापि च।\nआत्मार्थं पाण्डवार्थं च प्रयुद्ध्यध्वं मया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2041228, "chapter_id": 1915, "verse_number": "५-१६०-७६", "content_sanskrit": "धृष्टद्युम्नं च पाञ्चाल्यं ब्रूयास्त्वं वचनान्मम।\nएष ते समयः प्राप्तो लब्धव्यश्च त्वयापि सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2041229, "chapter_id": 1915, "verse_number": "५-१६०-७७", "content_sanskrit": "द्रोणमासाद्य समरे ज्ञास्यसे हितमुत्तमम् ।\nयुद्ध्यस्व समुहृत्पापं कुरु कर्म सुदुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2041230, "chapter_id": 1915, "verse_number": "५-१६०-७८", "content_sanskrit": "शिखण्डिनमथो ब्रूहि उलूक वचनान्मम ।\nस्त्रीति मत्वा महाबाहुर्न हनिष्यति कौरवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2041231, "chapter_id": 1915, "verse_number": "५-१६०-७९", "content_sanskrit": "गाङ्गेयो धन्विनां श्रेष्ठो युद्ध्येदानीं सुनिर्भयः ।\nकुरु कर्म रणे यत्तः पश्यामः पौरुषं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2041232, "chapter_id": 1915, "verse_number": "५-१६०-८०", "content_sanskrit": "एवमुक्त्वा ततो राजा प्रहस्योलूकमब्रवीत्।\nधनञ्जयं पुनर्ब्रूहि वासुदेवस्य श्रृण्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2041233, "chapter_id": 1915, "verse_number": "५-१६०-८१", "content_sanskrit": "अस्मान्वा त्वं पराजित्य प्रसाधि पृतिवीमिमाम् ।\nअथवा निर्जितोस्माभी रणे वीर शयिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2041234, "chapter_id": 1915, "verse_number": "५-१६०-८२", "content_sanskrit": "राष्ट्रान्निर्वासनक्लेशं वनवासं च पाण्डव ।\nकृष्णायाश्च परिक्लेशं संस्मरन्पुरुषो भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2041235, "chapter_id": 1915, "verse_number": "५-१६०-८३", "content_sanskrit": "यदर्थं क्षत्रिया सूते सर्वं तदिदमागतम् ।\nबलं वीर्यं च शौर्यं च परं चाप्यस्त्रलाघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2041236, "chapter_id": 1915, "verse_number": "५-१६०-८४", "content_sanskrit": "पौरुषं दर्शयन्युद्धे कोपस्य कुरु निष्कृतिम्।\nपरिक्लिष्टस्य दीनस्य दीर्घकालोषितस्य च।\nहृदयं कस्य न स्फोटेदैश्वर्याद्धंशितस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2041237, "chapter_id": 1915, "verse_number": "५-१६०-८५", "content_sanskrit": "कुले जातस्य शूरस्य परिवित्तेष्वगृध्यतः।\nआस्थितं राज्यमाक्रम्य कोपं कस्य न दीपयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2041238, "chapter_id": 1915, "verse_number": "५-१६०-८६", "content_sanskrit": "यत्तदुक्तं महद्वाक्यं कर्मणा तद्विभाव्यताम्।\nअकर्मणा कत्थितेन सन्तः कुपुरुषं विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2041239, "chapter_id": 1915, "verse_number": "५-१६०-८७", "content_sanskrit": "अमित्राणां वशे स्थानं राज्यं च पुनरुद्धर।\nद्वावर्थौ युद्धकामस्य तस्मात्तत्कुरु पौरुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2041240, "chapter_id": 1915, "verse_number": "५-१६०-८८", "content_sanskrit": "पराजितोऽसि द्यूतेन कृष्णा चानायिता सभाम् ।\nशक्योऽमर्षो मनुष्येण कर्तु पुरुषमानिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2041241, "chapter_id": 1915, "verse_number": "५-१६०-८९", "content_sanskrit": "द्वादशैव तु वर्षाणि वने धिष्ण्याद्विवासितः।\nसंवत्सरं विराटस्य दास्यमास्थाय चोषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2041242, "chapter_id": 1915, "verse_number": "५-१६०-९०", "content_sanskrit": "राष्ट्रान्निर्वासनक्लेशं वनवासं च पाण्डव ।\nकृष्णायाश्च परिक्लेशं संस्मरन्पुरुषो भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2041243, "chapter_id": 1915, "verse_number": "५-१६०-९१", "content_sanskrit": "अप्रियाणां च वचनं प्रब्रुवत्सु पुनः पुनः ।\nअमर्षं दर्शयस्व त्वममर्षो ह्येव पौरुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2041244, "chapter_id": 1915, "verse_number": "५-१६०-९२", "content_sanskrit": "क्रोधो बलं तथा वीर्यं ज्ञानयोगोऽस्त्रलाघवम्।\nइह ते दृश्यतां पार्थ युद्ध्यस्व पुरुषो भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2041245, "chapter_id": 1915, "verse_number": "५-१६०-९३", "content_sanskrit": "लोहाभिसारो निर्वृत्तः कुरुक्षेत्रमकर्दमम्।\nपुष्टास्तेऽश्वा भृता योधाः श्वो युद्ध्यस्व सकेशवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2041246, "chapter_id": 1915, "verse_number": "५-१६०-९४", "content_sanskrit": "असमागम्य भीष्मेण संयुगे किं विकत्थसे।\nआरुरुक्षुर्यथा मन्दः पर्वतं गन्धमादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2041247, "chapter_id": 1915, "verse_number": "५-१६०-९५", "content_sanskrit": "एवं कत्थसि कौन्तेय अकत्थन्पुरुषो भव।\nसूतपुत्रं सुदुर्धर्षं शल्यं च बलिनां वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2041248, "chapter_id": 1915, "verse_number": "५-१६०-९६", "content_sanskrit": "द्रोणं च बलिनां श्रेष्ठं शचीपतिसमं युधि ।\nअजित्वा संयुगे पार्थ राज्यं कथमिहेच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2041249, "chapter_id": 1915, "verse_number": "५-१६०-९७", "content_sanskrit": "ब्राह्मे धनुषि चाचार्यं वेदयोरन्तगं द्वयोः।\nयुधि धुर्यमविक्षोभ्यमनीकचरमच्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2041250, "chapter_id": 1915, "verse_number": "५-१६०-९८", "content_sanskrit": "द्रोणं महाद्युतिं पार्थ जेतुमिच्छसि तन्मृषा ।\nन हि शुश्रुम वातेन मेरुमुन्मथितं गिरिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2041251, "chapter_id": 1915, "verse_number": "५-१६०-९९", "content_sanskrit": "अनिलो वा वहेन्मेरुं द्यौर्वापि निपतेन्महीम्।\nयुगं वा रिवर्तेत यद्येवं स्याद्यथात्थ माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2041252, "chapter_id": 1915, "verse_number": "५-१६०-१००", "content_sanskrit": "को ह्यस्ति जीविताकाङ्क्षी पराप्येममरिमर्दनम् ।\nपार्थो वा इतरो वापि कोन्यः स्वस्ति गृहान्व्रजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2041253, "chapter_id": 1915, "verse_number": "५-१६०-१०१", "content_sanskrit": "कथमाभ्यामभिध्यातः संस्पृष्टो दारुणेन वा।\nरणे जीवन्प्रमुच्येत पदा भूमिपुमस्पृशन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2041254, "chapter_id": 1915, "verse_number": "५-१६०-१०२", "content_sanskrit": "किं दर्दुरः कूपशयो यथेमां\nन बुध्यसे राजचमूं समेताम्।\nदुराधर्षां देवचमूप्रकाशां\nगुप्तां नरेन्द्रैस्त्रिदशैरिव द्याम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2041255, "chapter_id": 1915, "verse_number": "५-१६०-१०३", "content_sanskrit": "प्राच्यैः प्रतीच्यैरथ दाक्षिणात्यै-\nरुदीच्यकाम्भोजशकैः खशैश्च ।\nसाल्वैः समत्स्यैः कुरुमध्यदेश्यै-\nर्म्लेच्छैः पुलिन्दैर्द्रविडान्ध्रकाञ्च्यैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2041256, "chapter_id": 1915, "verse_number": "५-१६०-१०४", "content_sanskrit": "नानाजनौघं युधि संप्रवृद्धं\nगाङ्गं यथा वेगमपारणीयम्।\nमां च स्थितं नानाबलस्य मध्ये\nयुयुत्ससे मन्द किमल्पबुद्धे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2041257, "chapter_id": 1915, "verse_number": "५-१६०-१०५", "content_sanskrit": "अक्षय्याविषुधी चैव अग्निदत्तं च ते रथम्।\nजानीमो हि रणे पार्थ केतुं दिव्यं च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2041258, "chapter_id": 1915, "verse_number": "५-१६०-१०६", "content_sanskrit": "अकत्थमानो युद्ध्यस्व कत्थसेऽर्जुन किं बहु ।\nपर्यायात्सिद्धिरेतस्य नैतत्सिध्याति कत्थनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2041259, "chapter_id": 1915, "verse_number": "५-१६०-१०७", "content_sanskrit": "यदीदं कत्थनाल्लोके सिध्येत्कर्म धनञ्जय।\nसर्वे भवेयुः सिद्धार्थाः कत्थने को हि दुर्गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2041260, "chapter_id": 1915, "verse_number": "५-१६०-१०८", "content_sanskrit": "जनामि ते वासुदेवं सहायं\nजानामि ते गाण्डिवं तालमात्रम् ।\nजानाम्यहं त्वादृशो नास्ति योद्धा\nजानानस्ते राज्यमेतद्धरामि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2041261, "chapter_id": 1915, "verse_number": "५-१६०-१०९", "content_sanskrit": "न तु पर्यायधर्मेम सिद्धिं प्राप्नोति मानवः।\nमनसैवानुकूलानि धातैव कुरुते वशे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2041262, "chapter_id": 1915, "verse_number": "५-१६०-११०", "content_sanskrit": "त्रयोदशसमा भुक्तं राज्यं विलपतस्तव।\nभूयश्चैव प्रशासिष्ये त्वां निहत्य सबान्धवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2041263, "chapter_id": 1915, "verse_number": "५-१६०-१११", "content_sanskrit": "क्व तदा गाण्डिवं तेऽभूद्यत्त्वं दासपणैर्जितः।\nक्व तदा भीमसेनस्य बलमासीच्च फाल्गुन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2041264, "chapter_id": 1915, "verse_number": "५-१६०-११२", "content_sanskrit": "सगदाद्भीमसेनाद्वा फाल्गुनाद्वा सगाण्डिवात्।\nन वै मोक्षस्तदा यो भूद्विना कृष्णमनिन्दितां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2041265, "chapter_id": 1915, "verse_number": "५-१६०-११३", "content_sanskrit": "सा वो दास्ये समापन्नान्मोचयामास पार्षती।\nअमानुष्यं समापन्नान्दासकर्मण्यवस्थितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2041266, "chapter_id": 1915, "verse_number": "५-१६०-११४", "content_sanskrit": "अवोचं यत्षण्डतिलानहं वस्तथयमेव तत्।\nधृता हि वेमी पार्थेन विराटनगरे तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2041267, "chapter_id": 1915, "verse_number": "५-१६०-११५", "content_sanskrit": "सूदकर्मणि च श्रान्तं विराटस्य महानसे ।\nभीमसेनेन कौन्तेय यत्तु तन्मम पौरुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2041268, "chapter_id": 1915, "verse_number": "५-१६०-११६", "content_sanskrit": "एवमेव सदा दण्डं क्षत्रियाः क्षत्रिये दधुः।\nवेणीं कृत्वा षण्डवेषः कन्यां नर्तितवानसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2041269, "chapter_id": 1915, "verse_number": "५-१६०-११७", "content_sanskrit": "न भयाद्वासुदेवस्य न चापि तव फल्गुन ।\nराज्यं प्रतिप्रदास्यामि युध्यस्व सहकेशवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2041270, "chapter_id": 1915, "verse_number": "५-१६०-११८", "content_sanskrit": "न माया हीन्द्रजालं वा कुहका वापि भीषणा ।\nआत्तशस्त्रस्य सङ्ग्रामे वहन्ति प्रतिगर्जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2041271, "chapter_id": 1915, "verse_number": "५-१६०-११९", "content_sanskrit": "वासुदेवसहस्रं वा फाल्गुनानां शतानि वा।\nआसाद्य माममोघेषुं द्रविष्यन्ति दिशो दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2041272, "chapter_id": 1915, "verse_number": "५-१६०-१२०", "content_sanskrit": "संयुगं गच्छ भीष्मेण भिन्धि वा शिरसा गिरिम् ।\nतरस्व वा महागाधं बाहुभ्यां पुरुषोदधिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2041273, "chapter_id": 1915, "verse_number": "५-१६०-१२१", "content_sanskrit": "शारद्वतमहामीनं विविंशतिमहोरगम् ।\nबृहद्बलमहोद्वेलं सौमदत्तितिमिङ्गिलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2041274, "chapter_id": 1915, "verse_number": "५-१६०-१२२", "content_sanskrit": "भीष्मवेगमपर्यन्तं द्रोणग्राहदुरसदम् ।\nकर्णशल्यझषावर्तं काम्भोजबडबामुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2041275, "chapter_id": 1915, "verse_number": "५-१६०-१२३", "content_sanskrit": "दुःशासनौघं शलशल्यमत्स्यं\nसुषेणचित्रायुधनागनक्रम्।\nजयद्रथाद्रिं पुरुमित्रगाधं\nदुर्मर्षणोदं शकुनिप्रपातम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2041276, "chapter_id": 1915, "verse_number": "५-१६०-१२४", "content_sanskrit": "शश्त्रौघमक्षय्यमभिप्रवृद्धं\nयदावगाह्य श्रमनष्टचेताः।\nभविष्यसि त्वं हतसर्वबान्धव-\nस्तदा मनस्ते परितापमेष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2041277, "chapter_id": 1915, "verse_number": "५-१६०-१२५", "content_sanskrit": "तदा मनस्ते त्रिदिवादिवाशुचे-\nर्निवर्तिता पार्थ महीप्रशासनात्।\nप्रशाम्य राज्यं हि सुदुर्लभं त्वया\nबुभूषितः स्वर्ग इवातपस्विना ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2041278, "chapter_id": 1915, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि उलूकदूतागमनपर्वणि षष्ट्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}]