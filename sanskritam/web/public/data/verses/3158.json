[{"id": 2100587, "chapter_id": 3158, "verse_number": "१४-१४-१", "content_sanskrit": "वैशम्पायन उवाच।\nएवं बहुविधैर्वाक्यैर्मुनिभिस्तैस्तपोधनैः।\nसमाश्वस्त राजर्षिर्हितबन्धुर्युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2100588, "chapter_id": 3158, "verse_number": "१४-१४-२", "content_sanskrit": "सोऽनुनीतो भगवता विष्टरश्रवसा स्वयम्।\nद्वैपायनेन कृष्णेनि देवस्थानेन चाभिभूः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2100589, "chapter_id": 3158, "verse_number": "१४-१४-३", "content_sanskrit": "नारदेनाथ भीमेन नकुलेन च पार्थिव।\nकृष्णया सहदेवेन विजयेन च धीमता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2100590, "chapter_id": 3158, "verse_number": "१४-१४-४", "content_sanskrit": "अन्यैश्च पुरुषव्याघ्रैर्ब्राह्मणैः शास्त्रदृष्टिभिः।\nव्यजहाच्छोकजं दुःखं सन्तापं चैव मानसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2100591, "chapter_id": 3158, "verse_number": "१४-१४-५", "content_sanskrit": "अर्चयामास देवांश्च ब्राह्मणांश्च युधिष्ठिरः।\nकृत्वाऽथ प्रेतकार्याणि सर्वेषां कुरुनन्दनः।\nअन्वशासच्च धर्मात्मा पृथिवीं सागराम्बराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2100592, "chapter_id": 3158, "verse_number": "१४-१४-६", "content_sanskrit": "प्रशान्तचेताः कौरव्यः स्वराज्यं प्राप्य केवलम्।\nव्यासं च नारदं चैव तांश्चान्यानब्रवीन्नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2100593, "chapter_id": 3158, "verse_number": "१४-१४-७", "content_sanskrit": "आश्वासितोऽहं प्राग्वृद्धैर्भवद्भिर्मुनिपुङ्गवैः।\nन सूक्ष्ममपि मे किञ्चिद्व्यलीकमिह विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2100594, "chapter_id": 3158, "verse_number": "१४-१४-८", "content_sanskrit": "अर्थश्च सुमहान्प्राप्तो येन यक्ष्यामि देवताः।\nपुरस्कृत्याद्य भवतः समानेष्यामहे मखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2100595, "chapter_id": 3158, "verse_number": "१४-१४-९", "content_sanskrit": "हिमवन्तं त्वया गुप्ता गमिष्यामः पितामह।\nबह्वाश्चर्यो हि देशः स श्रूयते द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2100596, "chapter_id": 3158, "verse_number": "१४-१४-१०", "content_sanskrit": "तथा भगवता चित्रं कल्याणं बहु भाषितम्।\nदेवर्षिणा नारदेन देवस्थानेन चैव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2100597, "chapter_id": 3158, "verse_number": "१४-१४-११", "content_sanskrit": "नाभागधेयः पुरुषः कश्चिदेवंविधान्गुरून्।\nलभते व्यसनं प्राप्य सुहृदः साधुसम्मतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2100598, "chapter_id": 3158, "verse_number": "१४-१४-१२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2100599, "chapter_id": 3158, "verse_number": "१४-१४-१२", "content_sanskrit": "एवमुक्तास्तु ते राज्ञा सर्व एव महर्षयः।\nअभ्यनुज्ञाप्य राजानं तथोभौ कृष्णफल्गुनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2100600, "chapter_id": 3158, "verse_number": "१४-१४-१३", "content_sanskrit": "पश्यतामेव सर्वेषां तत्रैवादर्शनं ययुः।\nततो धर्मसुतो राजा तत्रैवोपाविशत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2100601, "chapter_id": 3158, "verse_number": "१४-१४-१४", "content_sanskrit": "एवं नातिमहान्कालः स तेषां संन्यवर्तत।\nकुर्वतां शौचकार्याणि भीष्मस्य निधने तदा।\nमहादानानि विप्रेभ्यो ददतामौर्ध्वदेहिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2100602, "chapter_id": 3158, "verse_number": "१४-१४-१५", "content_sanskrit": "भीष्मकर्णपुरोगाणां कुरूणां कुरुसत्तम।\nसहितो धृतराष्ट्रेण स ददावौर्ध्वदेहिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2100603, "chapter_id": 3158, "verse_number": "१४-१४-१६", "content_sanskrit": "ततो दत्त्वा बहुधनं विप्रेभ्यः पाण्डवर्षभः।\nधृताराष्ट्रं पुरुस्कृत्य विवेश गजसाह्वयम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2100604, "chapter_id": 3158, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अश्वमेधपर्वणि चतुर्दशोऽध्यायः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]