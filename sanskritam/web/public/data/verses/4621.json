[{"id": 2169039, "chapter_id": 4621, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2169040, "chapter_id": 4621, "verse_number": "१", "content_sanskrit": "मारिषाधिरथेः श्रुत्वा वाचो युद्धाभिनन्दिनः ।\nशल्योऽब्रवीत् पुनः कर्णं निदर्शनमुदाहरन्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2169041, "chapter_id": 4621, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2169042, "chapter_id": 4621, "verse_number": "२", "content_sanskrit": "यथैव मत्तो मद्येन त्वं तथा लक्ष्यसे वृष\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2169043, "chapter_id": 4621, "verse_number": "३", "content_sanskrit": "जातोऽहं यज्वनां वंशे सङ्ग्रामेष्वनिवर्तिनाम् ।\nराज्ञां मूर्धाभिषिक्तानां स्वयं धर्मपरायणः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2169044, "chapter_id": 4621, "verse_number": "४", "content_sanskrit": "तथाऽद्य त्वां प्रमाद्यन्तं चिकित्सेयं सुहृत्तया\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2169045, "chapter_id": 4621, "verse_number": "५", "content_sanskrit": "इमां काकोपमां कर्ण प्रोच्यमानां निबोध मे ।\nश्रुत्वा यथेष्टं कुर्यास्त्वं निहीन कुलपांसन\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2169046, "chapter_id": 4621, "verse_number": "६", "content_sanskrit": "नाहमात्मनि किञ्चिद्वै किल्बिषं कर्म संस्मरे ।\nयेन मां त्वं महाबाहो हन्तुमिच्छस्यनागसम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2169047, "chapter_id": 4621, "verse_number": "७", "content_sanskrit": "अवश्यं तु मया वाच्यं बुद्ध्वा तव हिताहितम् ।\nविशेषतो रथस्थेन राज्ञश्चैव हितैषिणा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2169048, "chapter_id": 4621, "verse_number": "८", "content_sanskrit": "समं च विषमं चैव रथिनश्च बलाबलम् ।\nश्रमः खेदश्च सततं हयानां रथिना सह\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2169049, "chapter_id": 4621, "verse_number": "९", "content_sanskrit": "आयुधस्य परिज्ञानं रुतं च मृगपक्षिणाम् ।\nसारं चैवाप्यसारं च शल्यानां च प्रतिक्रिया\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2169050, "chapter_id": 4621, "verse_number": "१०", "content_sanskrit": "अस्त्रयोगं च युद्धं च निमित्तानि तथैव च ।\nसर्वमेतन्मया ज्ञेयं रथस्यास्य कुटुम्बिना\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2169051, "chapter_id": 4621, "verse_number": "११", "content_sanskrit": "अतस्त्वां कथये कर्ण निदर्शनमिदं पुनः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2169052, "chapter_id": 4621, "verse_number": "१२", "content_sanskrit": "वैश्यः किल समुद्रान्ते प्रभूतधनधान्यवान् ।\nयज्वा दानपतिः क्षान्तः स्वकर्मस्थोऽभवच्छुचिः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2169053, "chapter_id": 4621, "verse_number": "१३", "content_sanskrit": "बहुपुत्रः प्रियापत्यः सर्वभूतानुकम्पकः ।\nराज्ञो धर्मप्रधानस्य राष्ट्रे वसति निर्भयः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2169054, "chapter_id": 4621, "verse_number": "१४", "content_sanskrit": "पुत्राणां तस्य बालानां कुमाराणां च धीमतः ।\nकाको बहूनामभवदुच्छिष्टकृतभोजनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2169055, "chapter_id": 4621, "verse_number": "१५", "content_sanskrit": "तस्मै सदा प्रयच्छन्ति वैश्यपुत्राः कुमारकाः ।\nमांसोदनं दधि क्षीरं पायसं मधुसर्पिषी\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2169056, "chapter_id": 4621, "verse_number": "१६", "content_sanskrit": "स चोच्छिष्टभृतः काको वैश्यपुत्रैः कुमारकैः ।\nसदृशान्पक्षिणो दृप्तः श्रेयसश्चावमन्यते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2169057, "chapter_id": 4621, "verse_number": "१७", "content_sanskrit": "अथ हंसाः समुद्रान्ते प्रजग्मुरतिपातिनः ।\nगरुडस्य गतौ तुल्याश्चक्राङ्गा हृष्टचेतसः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2169058, "chapter_id": 4621, "verse_number": "१८", "content_sanskrit": "कुमारकास्तदा हंसान् दृष्ट्वा काकमथाब्रुवन् ।\nभवानेव विशिष्टो हि पतत्रिभ्यो विहङ्गम\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2169059, "chapter_id": 4621, "verse_number": "", "content_sanskrit": "(एतेऽतिपातिनः पश्य विहङ्गान् वियदाश्रितान् ।\nएहि त्वमपि शक्तो हि कस्मान्न पतितं त्वया\t॥१९॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2169060, "chapter_id": 4621, "verse_number": "२०", "content_sanskrit": "प्रतार्यमाणस्तैः सर्वैरल्पबुद्धिभिरण्डजः ।\nतद्वचः सत्यमित्येव मौर्ख्याद् दर्पाच्च जज्ञिवान्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2169061, "chapter_id": 4621, "verse_number": "२१", "content_sanskrit": "तान् सोऽनुपत्य जिज्ञासुः क एषां श्रेष्ठभागिति ।\nउच्छिष्टदर्पितः काको बहूनामेकपातिनाम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2169062, "chapter_id": 4621, "verse_number": "२२", "content_sanskrit": "तेषां यं प्रवरं मेने हंसानां दूरपातिनाम् ।\nस तमाह्वत दुर्बुद्धिः पताव इति पक्षिणम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2169063, "chapter_id": 4621, "verse_number": "२३", "content_sanskrit": "तच्छ्रुत्वा प्राहसन् हंसा ये तत्रासन् समागताः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2169064, "chapter_id": 4621, "verse_number": "२४", "content_sanskrit": "भाषतो बहु काकस्य बालिश्यात् पततां वराः ।\nइदमूचुः स्म चक्राङ्गा वचः काकं विहङ्गमाः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2169065, "chapter_id": 4621, "verse_number": "", "content_sanskrit": "हंसाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2169066, "chapter_id": 4621, "verse_number": "२५", "content_sanskrit": "कथं हंसं नु बलिनं चक्राङ्गं दूरपातिनम् ।\nकाको भूत्वा निपतने समाह्वयसि दुर्मते\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2169067, "chapter_id": 4621, "verse_number": "२६", "content_sanskrit": "कथं त्वं पतिता काक सहास्माभिर्ब्रवीहि तत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2169068, "chapter_id": 4621, "verse_number": "२७", "content_sanskrit": "अथ हंसवचो मूढः कुत्सयित्वा पुनः पुनः ।\nप्रजगादोत्तरं काकः कत्थनो जातिलाघवात्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2169069, "chapter_id": 4621, "verse_number": "", "content_sanskrit": "काकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2169070, "chapter_id": 4621, "verse_number": "२८", "content_sanskrit": "शतमेकं च पातानां पतिताऽस्मि न संशयः ।\nशतयोजनमेकैकं विचित्रं विविधं तथा\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2169071, "chapter_id": 4621, "verse_number": "२९", "content_sanskrit": "उड्डीनमवडीनं च प्रडीनं डीनमेव च ।\nनिडीनमथ सण्डीनं तिर्यक् डीनगतानि च\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2169072, "chapter_id": 4621, "verse_number": "३०", "content_sanskrit": "विडीनं परिडीनं च पराडीनं सुडीनकम् ।\nअतिडीनं महाडीनं खडीनं वरडीनकम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2169073, "chapter_id": 4621, "verse_number": "३१", "content_sanskrit": "अवडीनं प्रडीनं च सण्डीनं डीनडीनकम् ।\nअवडीनं प्रडीनं च पुनर्डीनविडीनकम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2169074, "chapter_id": 4621, "verse_number": "३२", "content_sanskrit": "सम्पातं समडीनं च ततोऽन्यद् वितिरिश्चकम् ।\nगतागतप्रतिगता बह्वीश्च निकनीनकाः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2169075, "chapter_id": 4621, "verse_number": "३३", "content_sanskrit": "कर्ताऽस्मि मिषतां वोऽद्य ततो द्रक्ष्यथ मे बलम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2169076, "chapter_id": 4621, "verse_number": "३४", "content_sanskrit": "तेषामन्यतमेनाहं पतिष्यामि विहायसम् ।\nप्रदिशध्वं यथान्यायं केन हंसाः पताम्यहम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2169077, "chapter_id": 4621, "verse_number": "३५", "content_sanskrit": "ते वै ध्रुवं विनिश्चित्य सम्पतध्वं मया सह ।\nपातैरेभिः खलु खगाः पतितुं खे निराश्रये\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2169078, "chapter_id": 4621, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2169079, "chapter_id": 4621, "verse_number": "३६", "content_sanskrit": "एवमुक्ते तु काकेन प्रहस्यैको विहङ्गमः ।\nउवाच काकं राधेय वचनं तन्निबोध मे\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2169080, "chapter_id": 4621, "verse_number": "", "content_sanskrit": "हंसः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2169081, "chapter_id": 4621, "verse_number": "३७", "content_sanskrit": "शतमेकं च पातानां त्वं काक पतिता ध्रुवम् ।\nएकमेव तु यं पातं विदुः सर्वे विहङ्गमाः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2169082, "chapter_id": 4621, "verse_number": "३८", "content_sanskrit": "तमहं पतिता काक नान्यं जानामि कञ्चन\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2169083, "chapter_id": 4621, "verse_number": "", "content_sanskrit": "काकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2169084, "chapter_id": 4621, "verse_number": "३९", "content_sanskrit": "पत त्वमपि तत्राशु येन पातेन मन्यसे\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2169085, "chapter_id": 4621, "verse_number": "४०", "content_sanskrit": "अथ काकं प्रजहसुर्ये तत्रासन् समागताः ।\nकथमेकेन पातेन हंसः पातशतं जयेत्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2169086, "chapter_id": 4621, "verse_number": "४१", "content_sanskrit": "एकेनैव सताप्येष पातेनाभिपतिष्यति ।\nहंसस्य पतितं काको बलवानाशुविक्रमः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2169087, "chapter_id": 4621, "verse_number": "४२", "content_sanskrit": "(पूर्वमेव तु वै काकः स तं तूर्णं प्रचक्रमे\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2169088, "chapter_id": 4621, "verse_number": "४३", "content_sanskrit": "नात्यहीयत काकश्च मुहूर्तमिव सूतज\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2169089, "chapter_id": 4621, "verse_number": "४४", "content_sanskrit": "काकोऽपि हंसं चापल्याच्छीघ्रतां प्रतिदर्शयन् ।\nवेगेनातीत्य तरसा पुनरेति मुहुर्मुहुः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2169090, "chapter_id": 4621, "verse_number": "", "content_sanskrit": "तुण्डेनाभ्यहनच्चैनं कुर्वन्नामापसव्यतः ।\nरोरूयन्निति चाप्येनं समाह्वयति वै मुहुः\t॥४५॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2169091, "chapter_id": 4621, "verse_number": "४६", "content_sanskrit": "विशिशिष्मयिषुः पातैर्दर्शयन्नात्मनः क्रियाम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2169092, "chapter_id": 4621, "verse_number": "४७", "content_sanskrit": "अथ तानि विचित्राणि पतितानीतराणि च ।\nदृष्ट्वा प्रमुदिताः काका विनेदुरधिकैः स्वरैः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2169093, "chapter_id": 4621, "verse_number": "४८", "content_sanskrit": "हंसाश्चापहसन्ति स्म प्रवदन्ति प्रियाणि च ।\nकुर्वाणा विविधान् रावानिच्छन्तो जयमात्मनः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2169094, "chapter_id": 4621, "verse_number": "४९", "content_sanskrit": "उत्पत्योत्पत्य च प्राहुर्मुहूर्तमिति चेति च ।\nवृक्षाग्रेभ्यः स्थळेभ्यश्च निपतन्त्युत्पतन्ति च\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2169095, "chapter_id": 4621, "verse_number": "५०", "content_sanskrit": "हंसस्त्वेकेन पातेन काकः पातशतेन च ।\nस्पर्धिनौ सहितौ तूर्णं खमास्थाय तरस्विनौ\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2169096, "chapter_id": 4621, "verse_number": "५१", "content_sanskrit": "मृदुनैकेन हंसस्तु विक्रान्तमुपचक्रमे ।\nप्रत्यहीयत काकाच्च मुहूर्तमिव मारिष\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2169097, "chapter_id": 4621, "verse_number": "५२", "content_sanskrit": "अवमत्य च हंसं तमिदं काकोऽब्रवीद्वचः ।\nयोऽसावुत्पतितो हंसः सोऽसावेव प्रहीयते\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2169098, "chapter_id": 4621, "verse_number": "५३", "content_sanskrit": "अथ हंसस्तु तच्छ्रुत्वा प्रापतत्पश्चिमां दिशम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2169099, "chapter_id": 4621, "verse_number": "५४", "content_sanskrit": "उपर्युपरि वेगेन सागरं मकरालयम् ।\n(बहुसत्वसमाकीर्णं वीचीभिर्भीमदर्शनम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2169100, "chapter_id": 4621, "verse_number": "", "content_sanskrit": "अथाचिरेण राधेय काको वेगादहीयत ।\nततोऽतीव परिश्रान्तः कथञ्चिद्धंसमन्वगात्\t॥५५॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2169101, "chapter_id": 4621, "verse_number": "५६", "content_sanskrit": "भीश्चैनमाविशत् तीव्रं काकं कर्ण विचेतसम् ।\nद्वीपान् द्रुमानपश्यन्तं विश्रमार्थं श्रमातुरम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2169102, "chapter_id": 4621, "verse_number": "५७", "content_sanskrit": "निपतेयं क्वनु श्रान्त इति तस्मिन् महार्णवे\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2169103, "chapter_id": 4621, "verse_number": "५८", "content_sanskrit": "अविषह्यः समुद्रोऽपि बहुसत्वगणालयः ।\nमहान् भूतशतोद्भासी नभसस्तु विशिष्यते\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2169104, "chapter_id": 4621, "verse_number": "५९", "content_sanskrit": "गाम्भीर्याद्धि समुद्रस्य न विशेषं हि सूतज ।\nदिगम्बराम्भसा कर्ण समुद्रस्था विदुर्जनाः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2169105, "chapter_id": 4621, "verse_number": "६०", "content_sanskrit": "विदूरपातात् तोयस्य किं पुनः कर्ण वायसः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2169106, "chapter_id": 4621, "verse_number": "६१", "content_sanskrit": "अथ हंसोप्यतिक्रामन् मुहूर्तमिति चेति च ।\nअवेक्षमाणस्तं काकं नाशक्नोद् व्यपसर्पितुम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2169107, "chapter_id": 4621, "verse_number": "६२", "content_sanskrit": "अतिक्रम्य च चक्राङ्गः काकं तं समुदैक्षत\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2169108, "chapter_id": 4621, "verse_number": "६३", "content_sanskrit": "तं तथा परिहीनं तं परिश्रान्तमचेतसम् ।\nअवेक्षमाणस्तं काकं प्रत्यागत्य हसन्निव\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2169109, "chapter_id": 4621, "verse_number": "६४", "content_sanskrit": "तं प्रहस्य च चक्राङ्गः काकं मन्दगतिं तदा ।\nहीयमानमथो दृष्ट्वा हंसः प्राह यथार्थवत्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2169110, "chapter_id": 4621, "verse_number": "६५", "content_sanskrit": "उज्जिहीर्षुर्निमज्जन्तं स्मरन् सत्पुरुषव्रतम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2169111, "chapter_id": 4621, "verse_number": "", "content_sanskrit": "हंसः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2169112, "chapter_id": 4621, "verse_number": "६६", "content_sanskrit": "बहूनि पतितानि त्वमाचक्षाणो मुहुर्मुहुः ।\nपतस्यव्याहरन् खेदं ततो गर्ह्यं प्रभाषसे\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2169113, "chapter_id": 4621, "verse_number": "६७", "content_sanskrit": "किं नाम पतितं काक यत्त्वं पतसि साम्प्रतम् ।\nजलं स्पृशसि पक्षाभ्यां तुण्डेन च पुनः पुनः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2169114, "chapter_id": 4621, "verse_number": "६८", "content_sanskrit": "प्रब्रूहि कतमोऽयं ते पातो वर्तति वायस ।\nएह्येहि काक शीघ्रं त्वमेष त्वां प्रतिपालये\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2169115, "chapter_id": 4621, "verse_number": "६९", "content_sanskrit": "स पक्षाभ्यां स्पृशन्नार्तस्तुण्डेन च जलं तदा ।\nकाको दृढं परिश्रान्तः सहसा निपपात ह\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2169116, "chapter_id": 4621, "verse_number": "७०", "content_sanskrit": "पातवेगप्रमथितो हंसं काकोऽब्रवीदिदम् ।\nवयं काकाः कुतो नाम चरामः काकवाचकाः ।\nहंस प्राणैः प्रपद्ये त्वामुदकान्तं नयस्व माम्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2169117, "chapter_id": 4621, "verse_number": "७१", "content_sanskrit": "सागराम्भसि तं दृष्ट्वा पतन्तं दीनचेतसम् ।\nम्रियमाणमिदं वाक्यं हंसः काकमुवाच ह\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2169118, "chapter_id": 4621, "verse_number": "७२", "content_sanskrit": "शतमेकं च पातानां पताम्यहमनुस्मर ।\nश्लाघन्नात्मानमद्य त्वं काक भाषितवानसि\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2169119, "chapter_id": 4621, "verse_number": "७३", "content_sanskrit": "स त्वमेकशतं पातं पतन्नभ्यधिको मया ।\nकथमेवं परिश्रान्तः पतितोऽसि महार्णवे\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2169120, "chapter_id": 4621, "verse_number": "७४", "content_sanskrit": "प्रत्युवाच ततः काकः सीदमान इदं वचः ।\nउपरिस्थं तदा हंसं प्रसमीक्ष्य प्रसादयन्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2169121, "chapter_id": 4621, "verse_number": "७५", "content_sanskrit": "उच्छिष्टान्नेन पुष्टोऽहं दर्पोत्सिक्तः कुसत्वतः ।\nसुपर्ण इव चात्मानं ज्ञातवान् पुत्रलाघवात्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2169122, "chapter_id": 4621, "verse_number": "७६", "content_sanskrit": "शरणं त्वां प्रपन्नोऽहमुदकान्तमवाप्नुयाम् ।\nहंसेदानीं परिश्रान्तमापदो मां समुद्धर\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2169123, "chapter_id": 4621, "verse_number": "७७", "content_sanskrit": "यदि नाम पुनर्जीवन् गच्छेयं स्वं निवेशनम् ।\nनैनं पुनर्हीनमपि क्षेप्ताऽहं खे विचारिणम्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2169124, "chapter_id": 4621, "verse_number": "७८", "content_sanskrit": "तमेवं करुणं दीनं विलपन्तमचेतसम् ।\nकाककाकेति वाशन्तं निमज्जन्तं महार्णवे\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2169125, "chapter_id": 4621, "verse_number": "७९", "content_sanskrit": "कृपयाऽभिपरीतो वै कृपां चक्रे दुरात्मनि\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2169126, "chapter_id": 4621, "verse_number": "८०", "content_sanskrit": "अथ तं पततं दीनं जलक्लिन्नमचेतनम् ।\nपद्भ्यामुत्क्षिप्य वेपन्तं पृष्ठमारोपयत् तदा\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2169127, "chapter_id": 4621, "verse_number": "८१", "content_sanskrit": "स हंसः पृष्ठमारोप्य काकं कर्ण विचेतसम् ।\nअविस्मयंस्तदा कर्ण पुनरेव समानयत्\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2169128, "chapter_id": 4621, "verse_number": "८२", "content_sanskrit": "तमेव देशं तरसा स्पर्धया पेततुर्यतः\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2169129, "chapter_id": 4621, "verse_number": "८३", "content_sanskrit": "उत्सृज्य त्वब्रवीन्मैवं पुनः कार्यं त्वयेति ह ।\nस्थाप्य चैनं पुनर्द्वीपे समाश्वस्य च विक्लवम्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2169130, "chapter_id": 4621, "verse_number": "८४", "content_sanskrit": "गतो यथेप्सितं देशं हंसो मन इवाशुगः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2169131, "chapter_id": 4621, "verse_number": "८५", "content_sanskrit": "एवमुच्छिष्टपुष्टः स काको हंसपराजितः ।\nबलवीर्यमदं कर्ण त्यक्त्वा क्षान्तिमुपागतः\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2169132, "chapter_id": 4621, "verse_number": "८६", "content_sanskrit": "उच्छिष्टभोजनः काको यथा वैश्यकुले पुरा ।\nएवं त्वमुच्छिष्टभृतो धार्तरार्ष्ट्रैर्न संशयः\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2169133, "chapter_id": 4621, "verse_number": "८७", "content_sanskrit": "सदृशान् श्रेयसश्चापि सर्वान् कर्णावमन्यसे ।\nद्रोणद्रौणिकृपैर्गुप्तो भीष्मेणान्यैश्च कौरवैः\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2169134, "chapter_id": 4621, "verse_number": "८८", "content_sanskrit": "विराटनगरे पार्थमेकं किं नावधीस्तदा ।\nयत्र व्यस्ताः समस्ताश्च निर्जिताः स्थ किरीटिना\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2169135, "chapter_id": 4621, "verse_number": "८९", "content_sanskrit": "सृगाला इव सिंहेन क्व ते वीर्यं तदा गतम्\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2169136, "chapter_id": 4621, "verse_number": "९०", "content_sanskrit": "भ्रातरं निहतं दृष्ट्वा समरे सव्यसाचिना ।\nपश्यतां कुरुवीराणां प्रथमं त्वं पलायितः\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2169137, "chapter_id": 4621, "verse_number": "९१", "content_sanskrit": "तथा द्वैतवने कर्ण गन्धर्वैः समभिद्रुतान् ।\nकुरून् सदारानुत्सृज्य त्वमेवाग्रे पलायितः\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2169138, "chapter_id": 4621, "verse_number": "९२", "content_sanskrit": "हत्वा जित्वा च गन्धर्वांश्चित्रसेनमुखान् रणे ।\nकर्ण दुर्योधनं पार्थः सभार्यं सममोचयत्\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2169139, "chapter_id": 4621, "verse_number": "९३", "content_sanskrit": "पुनः प्रभावः पार्थस्य पुराणः केशवस्य च ।\nकथितः कर्ण रामेण सभायां कुरुसंसदि\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2169140, "chapter_id": 4621, "verse_number": "९४", "content_sanskrit": "सततं च त्वमश्रौषीर्वचनं द्रोणभीष्मयोः ।\nअवध्यौ वदतोः कृष्णौ सन्निधौ च महीक्षिताम्\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2169141, "chapter_id": 4621, "verse_number": "९५", "content_sanskrit": "कियत् तव प्रवक्ष्यामि येन येन धनञ्जयः ।\nत्वत्तोऽतिरिक्तः सर्वेभ्यो भूतेभ्यो ब्राह्मणो यथा\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2169142, "chapter_id": 4621, "verse_number": "९६", "content_sanskrit": "इदानीमेव द्रष्टासि प्रधाने स्यन्दने स्थितौ ।\nपुत्रं च वसुदेवस्य कुन्तीपुत्रं च पाण्डवम्\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2169143, "chapter_id": 4621, "verse_number": "९७", "content_sanskrit": "यथाऽश्रयत चक्राङ्गं वायसो बुद्धिमास्थितः ।\nतथाश्रयस्व वार्ष्णेयं पाण्डवं च धनञ्जयम्\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2169144, "chapter_id": 4621, "verse_number": "९८", "content_sanskrit": "यदा त्वं युधि विक्रान्तौ वासुदेवधनञ्जयौ ।\nद्रष्टास्येकरथे कर्ण तदा नैवं वदिष्यसि\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2169145, "chapter_id": 4621, "verse_number": "९९", "content_sanskrit": "यदा शरशतैः पार्थो दर्पं तव वधिष्यति ।\nतदा त्वमन्तरं द्रष्टा आत्मनश्चार्जुनस्य च\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2169146, "chapter_id": 4621, "verse_number": "१००", "content_sanskrit": "देवासुरमनुष्येषु प्रख्यातौ यौ नरोत्तमौ ।\nतौ मावमंस्था मौर्ख्यात् त्वं खद्योत इव रोचनौ\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2169147, "chapter_id": 4621, "verse_number": "१०१", "content_sanskrit": "सूर्याचन्द्रमसौ यद्वत् तद्वदर्जुनकेशवौ ।\nप्राकाश्येनाभिविख्यातौ त्वं तु खद्योतवन्नृषु\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2169148, "chapter_id": 4621, "verse_number": "१०२", "content_sanskrit": "एवं विद्वन् मावमंस्थाः सूतपुत्राच्युतार्जुनौ ।\nनरसिंहौ नरश्वा त्वं जोषमास्स्व विकत्थन\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2169149, "chapter_id": 4621, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nकर्णशल्यसंवादे हंसकाकीयोपाख्यानो नाम एकचत्वारिंशोऽध्यायः ॥४१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}]