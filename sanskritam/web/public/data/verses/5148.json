[{"id": 2194968, "chapter_id": 5148, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2194969, "chapter_id": 5148, "verse_number": "१", "content_sanskrit": "आश्चर्यं नात्र संदेहः सुप्रीतोऽस्मि भुजङ्गम ।\nअन्वर्थोपगतैर्वाक्यैः पन्थानं चास्मि दर्शितः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2194970, "chapter_id": 5148, "verse_number": "२", "content_sanskrit": "स्वस्ति तेऽस्तु गमिष्यामि साधो भुजगसत्तम ।\nस्मरणीयोऽस्मि भवता सम्प्रेषणनियोजनैः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2194971, "chapter_id": 5148, "verse_number": "", "content_sanskrit": "नागः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2194972, "chapter_id": 5148, "verse_number": "३", "content_sanskrit": "अनुक्त्वा मद्गतं कार्यं क्वेदानीं प्रस्थितो भवान् ।\nउच्यतां द्विज यत् कार्यं यदर्थं त्वमिहागतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2194973, "chapter_id": 5148, "verse_number": "४", "content_sanskrit": "उक्तानुक्ते कृते कार्ये मामामन्त्र्य द्विजर्षभ ।\nमया प्रत्यभ्यनुज्ञातस्ततो यास्यसि ब्राह्मण\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2194974, "chapter_id": 5148, "verse_number": "५", "content_sanskrit": "न हि मां केवलं दृष्ट्वा त्यक्त्वा प्रणयवानिह ।\nगन्तुमर्हसि विप्रर्षे वृक्षमूलगतो यथा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2194975, "chapter_id": 5148, "verse_number": "६", "content_sanskrit": "त्वयि चाहं द्विजश्रेष्ठ भवान् मयि न संशयः ।\nलोकोऽयं भवतः सर्वः का चिन्ता मयि तेऽनघ\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2194976, "chapter_id": 5148, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2194977, "chapter_id": 5148, "verse_number": "७", "content_sanskrit": "एवमेतन्महाप्राज्ञ विज्ञातार्थ भुजङ्गम ।\nनातिरिक्तास्त्वया देवाः सर्वथैव यथातथम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2194978, "chapter_id": 5148, "verse_number": "८", "content_sanskrit": "य एवाहं स एव त्वमेवमेतद् भुजङ्गम ।\nअहं भवांश्च भूतानि सर्वे सर्वत्रगाः सदा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2194979, "chapter_id": 5148, "verse_number": "९", "content_sanskrit": "आसीत्तु मे भोगपते संशयः पुण्यसञ्चये ।\nसोऽहमुञ्छव्रतं साधो चरिष्याम्यर्थदर्शनम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2194980, "chapter_id": 5148, "verse_number": "१०", "content_sanskrit": "एष मे निश्चयः साधो कृतः कारणवत्तरः ।\nआमन्त्रयामि भद्रं ते कृतार्थोऽस्मि भुजङ्गम\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2194981, "chapter_id": 5148, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे सप्तनवत्युत्तरशततमोऽध्यायः ॥१९७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]