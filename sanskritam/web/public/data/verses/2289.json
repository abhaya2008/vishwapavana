[{"id": 2060246, "chapter_id": 2289, "verse_number": "८-१०-०x", "content_sanskrit": "सञ्चय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2060247, "chapter_id": 2289, "verse_number": "८-१०-१", "content_sanskrit": "ततः कर्णो महेष्वासः पाण्डवानामनीकिनीम्।\nजघान समरे शूरः सन्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2060248, "chapter_id": 2289, "verse_number": "८-१०-२", "content_sanskrit": "तथैव पाण्डवा राजंस्तव पुत्रस्य वाहिनीम्।\nकर्णस्य प्रमुखे क्रुद्धा निजघ्नुस्ते महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2060249, "chapter_id": 2289, "verse_number": "८-१०-३", "content_sanskrit": "कर्णोऽपि राजन्समरे व्यहनत्पाण्डवीं चमूम्।\nनाराचैरर्करश्म्याभैः कर्मारपरिमार्जितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2060250, "chapter_id": 2289, "verse_number": "८-१०-४", "content_sanskrit": "तत्र भारत कर्णेन नाराचैस्ताडिता गजाः।\nनेदुः सेदुश्च मम्लुश्च बभ्रुमुश्च दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2060251, "chapter_id": 2289, "verse_number": "८-१०-५", "content_sanskrit": "वध्यमाने बले तस्मिन्सूतपुत्रेण मारिष।\nनकुलोऽभ्यद्रवत्तूर्णं सूतपुत्रं महारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2060252, "chapter_id": 2289, "verse_number": "८-१०-६", "content_sanskrit": "भीमसेनस्तथा द्रौणिं कुर्वाणं कर्म दुष्करम्।\nविन्दानुविन्दौ कैकेयौ सात्यकिः समवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2060253, "chapter_id": 2289, "verse_number": "८-१०-७", "content_sanskrit": "श्रुतकर्माणमायान्तं चित्रसेनो महीपतिः।\nप्रतिविन्ध्यस्तथा चित्रं चित्रकेतनकार्मुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2060254, "chapter_id": 2289, "verse_number": "८-१०-८", "content_sanskrit": "दुर्योधनस्तु राजानं धर्मपुत्रं युधिष्ठिरम्।\nसंशप्तकगणा हृष्टा ह्यभ्यधावन्धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2060255, "chapter_id": 2289, "verse_number": "८-१०-९", "content_sanskrit": "धृष्टद्युम्नः कृपं चापि तस्मिन्वीरवरक्षये।\nशिखण्डी कृतवर्माणं समासादयदच्युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2060256, "chapter_id": 2289, "verse_number": "८-१०-१०", "content_sanskrit": "श्रुतकीर्तिस्तथा शल्यं माद्रीपुत्रः सुतं तव।\nदुःशासनं महाराज सहदेवः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2060257, "chapter_id": 2289, "verse_number": "८-१०-११", "content_sanskrit": "कैकेयौ सात्यकिं युद्धे शरवर्षेण भास्वता।\nसात्यकिः केकयौ चापि च्छादयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2060258, "chapter_id": 2289, "verse_number": "८-१०-१२", "content_sanskrit": "तावेनं भ्रातरौ वीरौ जघ्नतुर्हृदये भृशम्।\nविषाणाभ्यां यथा नागौ प्रतिनागं महावने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2060259, "chapter_id": 2289, "verse_number": "८-१०-१३", "content_sanskrit": "शरसम्बिन्नवर्माणौ तावुभौ भ्रातरौ रणे।\nसात्यकिं सत्यकर्माणं राजन्विव्यधतुः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2060260, "chapter_id": 2289, "verse_number": "८-१०-१४", "content_sanskrit": "तौ सात्यकिर्महाराज प्रहसन्सर्वतोदिशः।\nछादयञ्छरवर्षेण वारयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2060261, "chapter_id": 2289, "verse_number": "८-१०-१५", "content_sanskrit": "वार्यमाणौ ततस्तौ हि शैनेयशरवृष्टिभिः।\nशैनेयस्य रथं तूर्णं छादयामासतुः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2060262, "chapter_id": 2289, "verse_number": "८-१०-१६", "content_sanskrit": "तयोस्तु धनुषी चित्रे छित्त्वा शौरिर्महायशाः।\nअथ तौ सायकैस्तीक्ष्णैर्वारयामास सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2060263, "chapter_id": 2289, "verse_number": "८-१०-१७", "content_sanskrit": "अथान्ये धनुषी चित्रे प्रगृह्य च महाशरान्।\nसात्यकिं छादयन्तौ तौ चेरतुर्लघु सुष्ठु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2060264, "chapter_id": 2289, "verse_number": "८-१०-१८", "content_sanskrit": "ताभ्यां मुक्ता महाबाणाः कङ्कबर्हिणवाससः।\nद्योतयन्तो दिशः सर्वाः सम्पेतुः स्वर्णभूषणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2060265, "chapter_id": 2289, "verse_number": "८-१०-१९", "content_sanskrit": "बाणान्धकारमभवत्तयो राजन्महामृधे।\nअन्योन्यस्य धनुश्चैव चिच्छिदुस्ते महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2060266, "chapter_id": 2289, "verse_number": "८-१०-२०", "content_sanskrit": "ततः क्रुद्धो महाराज सात्वतो युद्धदुर्मदः।\nधनुरन्यत्समादाय सज्यं कृत्वा च संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2060267, "chapter_id": 2289, "verse_number": "८-१०-२१", "content_sanskrit": "क्षुरप्रेण सुतीक्ष्णेन ह्यनुविन्दशिरोऽहरत्।\nअपतत्तच्छिरो राजन्कुण़्डलोपचितं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2060268, "chapter_id": 2289, "verse_number": "८-१०-२२", "content_sanskrit": "शम्बरस्य शिरो यद्वन्निहतस्य महारणे।\nशोचयन्केकयान्सर्वाञ्जगामाशु वसुन्धराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2060269, "chapter_id": 2289, "verse_number": "८-१०-२३", "content_sanskrit": "तं दृष्ट्वा निहतं शूरं भ्राता तस्य महारथः।\nसज्यमन्यद्धनुः कृत्वा शैनेयं पर्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2060270, "chapter_id": 2289, "verse_number": "८-१०-२४", "content_sanskrit": "स षष्ट्या सात्यकिं विद्व्वा स्वर्णपुङ्खैः शिलाशितैः।\nननाद बलवन्नादं तिष्ठतिष्ठेति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2060271, "chapter_id": 2289, "verse_number": "८-१०-२५", "content_sanskrit": "सात्यकिं च ततस्तूर्णं केकयानां महारथः।\nशरैरनेकसाहस्रैर्बाह्वोरुरसि चार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2060272, "chapter_id": 2289, "verse_number": "८-१०-२६", "content_sanskrit": "स शरैः क्षतसर्वाङ्गः सात्यकिः सत्यविक्रमः।\nरराज समरे राजन्सपुष्प इव किंशुकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2060273, "chapter_id": 2289, "verse_number": "८-१०-२७", "content_sanskrit": "सात्यकिः समरे विद्वः कैकेयेन महात्मना।\nकैकेयं पञ्चविंशत्या विव्याध प्रहसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2060274, "chapter_id": 2289, "verse_number": "८-१०-२८", "content_sanskrit": "तावन्योन्यस्य समरे सञ्छिद्य धनुषी शुभे।\nहत्वा च सारथी तूर्णं हयांश्च रथिनां वरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2060275, "chapter_id": 2289, "verse_number": "८-१०-२९", "content_sanskrit": "विरथावसियुद्धाय समाजग्मतुराहवे।\nशतचन्द्रचिते गृह्य चर्मणी सुभुजौ तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2060276, "chapter_id": 2289, "verse_number": "८-१०-३०", "content_sanskrit": "विरोचेतां महारङ्गे निस्त्रिंशबरधारिणौ।\nयथा देवासुरे युद्धे जम्भशक्रौ महाबलौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2060277, "chapter_id": 2289, "verse_number": "८-१०-३१", "content_sanskrit": "मण्डलानि ततस्तौ तु विचन्तौ महारणे।\nअन्योन्यमभितस्तूर्णं समाजग्मतुराहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2060278, "chapter_id": 2289, "verse_number": "८-१०-३२", "content_sanskrit": "अन्योन्यस्य वधे चैव चक्रतुर्यत्नमुत्तमम्।\nकैकेयस्य द्विधा चर्म ततश्चिच्छेद सात्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2060279, "chapter_id": 2289, "verse_number": "८-१०-३३", "content_sanskrit": "सात्यकेस्तु तथैवासौ चर्म चिच्छेद पार्थिवः।\nचर्म च्छित्त्वा तु कैकेयस्तारागणशतैर्वृतम्।\nचचार मण्डलान्येव गतप्रत्यागतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2060280, "chapter_id": 2289, "verse_number": "८-१०-३४", "content_sanskrit": "तं चरन्तं महारङ्गे निस्त्रिंशवरधारिणम्।\nअपहस्तेन चिच्छेद शैनेयस्त्वरयाऽन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2060281, "chapter_id": 2289, "verse_number": "८-१०-३५", "content_sanskrit": "सवर्मा केकयो राजन्द्विधा च्छिन्नो महारणे।\nनिपपात महेष्वासो वज्राहत इवात्वलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2060282, "chapter_id": 2289, "verse_number": "८-१०-३६", "content_sanskrit": "तं निहत्य रणे शूरः शैनेयो रथसत्तमः।\nयुधामन्युरथं तूर्णमारुरोह परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2060283, "chapter_id": 2289, "verse_number": "८-१०-३७", "content_sanskrit": "ततोऽन्यं रथमास्थाय विधिवत्कल्पितं पुनः।\nकेकयानां महत्सैन्यं व्यधमत्सात्यकिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2060284, "chapter_id": 2289, "verse_number": "८-१०-३८", "content_sanskrit": "सा वध्यमाना समरे केकयानां महाचमूः।\nतमुत्सृज्य रणे शत्रुं प्रदुद्राव दिशो दश॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2060285, "chapter_id": 2289, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि षोडशदिवसयुद्धे दशमोऽध्यायः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]