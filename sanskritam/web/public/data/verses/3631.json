[{"id": 2122590, "chapter_id": 3631, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2122591, "chapter_id": 3631, "verse_number": "१", "content_sanskrit": "कथं समभवद् द्यूतं भ्रातॄणां तन्महात्ययम् ।\nयत्र तद् व्यसनं प्राप्तं पाण्डवैर्मे पितामहैः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2122592, "chapter_id": 3631, "verse_number": "२", "content_sanskrit": "ये च तत्र सभास्तारा राजानो ब्रह्मवित्तम ।\nके चैनमनुमोदन्ते के चैनं प्रत्यषेधयन् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2122593, "chapter_id": 3631, "verse_number": "३", "content_sanskrit": "विस्तरेणैतदिच्छामि कथ्यमानं त्वया द्विज ।\nमूलं ह्येतद् विनाशस्य पृथिव्यां द्विजसत्तम ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2122594, "chapter_id": 3631, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2122595, "chapter_id": 3631, "verse_number": "४", "content_sanskrit": "एवमुक्तस्तु राज्ञा स व्यासशिष्यो महामुनिः ।\nआचचक्षे यथावृत्तं तत् सर्वं सर्ववेदवित् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2122596, "chapter_id": 3631, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2122597, "chapter_id": 3631, "verse_number": "५", "content_sanskrit": "शृणु मे विस्तरेणेमां कथां भरतसत्तम ।\nभूय एव महाराज यदि ते श्रवणे मतिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2122598, "chapter_id": 3631, "verse_number": "६", "content_sanskrit": "विदुरस्य मतं ज्ञात्वा धृतराष्ट्रोऽम्बिकासुतः ।\nदुर्योधनमिदं वाक्यमुवाच विजने पुनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2122599, "chapter_id": 3631, "verse_number": "७", "content_sanskrit": "अलं द्यूतेन गान्धारे विदुरो न प्रशंसति ।\nन ह्यसौ सुमहाबुद्धिरहितं नो वदिष्यति ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2122600, "chapter_id": 3631, "verse_number": "८", "content_sanskrit": "हितं हि विदुरं मन्ये विदुरो यत् प्रभाषते ।\nक्रियतां पुत्र तत् सर्वमेतन्मन्ये हितं तव ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2122601, "chapter_id": 3631, "verse_number": "९", "content_sanskrit": "देवर्षिर्वासवगुरुर्देवराजाय धीमते ।\nयत् प्राह शास्त्रं सुमहद् बृहस्पतिरुदारधीः ।\nतद् वेद विदुरः कृत्स्नं सरहस्यं महाकविः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2122602, "chapter_id": 3631, "verse_number": "१०", "content_sanskrit": "स्थितोऽस्मि वचने तस्य सदाऽहमपि पुत्रक ।\nविदुरश्चापि मेधावी कुरूणां प्रवरो मतः ।\nउद्धवो वा महाबुद्धिर्वृष्णीनामर्चितः कविः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2122603, "chapter_id": 3631, "verse_number": "११", "content_sanskrit": "द्यूतेन तदलं पुत्र द्यूते भेदो हि दृश्यते ।\nभेदे विनाशो राज्यस्य तत् पुत्र परिवर्जय ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2122604, "chapter_id": 3631, "verse_number": "१२", "content_sanskrit": "पित्रा मया च पुत्रस्य यद्वै कार्यं परं स्मृतम् ।\nप्राप्तस्त्वमसि तत् तात पितृपैतामहं पदम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2122605, "chapter_id": 3631, "verse_number": "१३", "content_sanskrit": "अधीतवान् कृती शास्त्रे लाळितः सततं गृहे ।\nभ्रातृज्येष्ठः स्थितो राज्ये विद्यते किन्न्वशोभनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2122606, "chapter_id": 3631, "verse_number": "१४", "content_sanskrit": "पृथग्जनैरतुल्यं हि भोजनाच्छादनं परम् ।\nत्वं प्राप्तोऽसि महाबाहो कस्माच्छोचसि पुत्रक ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2122607, "chapter_id": 3631, "verse_number": "१५", "content_sanskrit": "स्फीतं राष्ट्रं महाबाहो पितृपैतामहं महत् ।\nनित्यमाज्ञापयन् शासि दिवि देवेश्वरो यथा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2122608, "chapter_id": 3631, "verse_number": "१६", "content_sanskrit": "यादृशं च तवैश्वर्यं तदन्येषां सुदुर्लभम् ।\nये चोपभोगास्ते तात मया ते परिकीर्तिताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2122609, "chapter_id": 3631, "verse_number": "१७", "content_sanskrit": "तस्य ते विदितप्रज्ञ शोकमूलमिदं कथम् ।\nसमुत्थितं दुःखतरं तन्मे शंसितुमर्हसि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2122610, "chapter_id": 3631, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2122611, "chapter_id": 3631, "verse_number": "१८", "content_sanskrit": "अश्नाम्याच्छादयामीति प्रपश्यन् हीनपौरुषः ।\nनामर्षं कुरुते यस्तु पुरुषः सोऽधमः स्मृतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2122612, "chapter_id": 3631, "verse_number": "१९", "content_sanskrit": "न मां प्रीणाति पृथिवी राजन् साधारणी विभो ।\nज्वलन्तीमिव कौन्तेये श्रियं दृष्ट्वा महात्मनि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2122613, "chapter_id": 3631, "verse_number": "२०", "content_sanskrit": "सर्वां तु पृथिवीं दृष्ट्वा युधिष्ठिरवशानुगाम् ।\nस्थिरोऽस्मि योऽहं जीवामि दुःखादेतद् ब्रवीमि ते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2122614, "chapter_id": 3631, "verse_number": "२१", "content_sanskrit": "अपजीवा इवाभान्ति निघ्नाः किङ्करकास्तथा ।\nकारस्करा लोहजङ्घा युधिष्ठिरनिवेशने ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2122615, "chapter_id": 3631, "verse_number": "२२", "content_sanskrit": "हिमवत्सागरानूपाः सर्वरत्नाकरास्तथा ।\nअन्त्याः सर्वे पर्युदस्ता युधिष्ठिरनिवेशने ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2122616, "chapter_id": 3631, "verse_number": "२३", "content_sanskrit": "ज्येष्ठोऽहमिति मां मत्वा श्रेष्ठश्चापि विशाम्पते ।\nयुधिष्ठिरेण सत्कृत्य युक्तो रत्नपरिग्रहे ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2122617, "chapter_id": 3631, "verse_number": "२४", "content_sanskrit": "न मे हस्तः समभवद् वसु तत् प्रतिगृह्णतः ।\nप्रातिष्ठन्त मयि श्रान्ते गृह्य दूराहृतं वसु ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2122618, "chapter_id": 3631, "verse_number": "२५", "content_sanskrit": "उपस्थितानां रत्नानां श्रेष्ठानां रत्नहारिणाम् ।\nपारं तत्र न पश्यामि नापरं तत्र भारत ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2122619, "chapter_id": 3631, "verse_number": "२६", "content_sanskrit": "कृतां बिन्दुसरोरत्नैर्मयेन स्फाटिकप्रभाम् ।\nअपश्यं नलिनीं पूर्णामुदकस्येव भारत ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2122620, "chapter_id": 3631, "verse_number": "२७", "content_sanskrit": "उत्कर्षन्तं च वै वासः प्राहसन्मां वृकोदरः ।\nकिङ्कराश्च सभापाला जहसुर्भरतर्षभ ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2122621, "chapter_id": 3631, "verse_number": "२८", "content_sanskrit": "शत्रो रत्नविशेषेण विमूढं रत्नवर्जितम् ।\nममृषे यदि शक्तस्तं घातयेयं वृकोदरम् ।\nसपत्नेनावहासो हि स मां दहति भारत ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2122622, "chapter_id": 3631, "verse_number": "२९", "content_sanskrit": "तत्र स्फाटिकतोयां हि स्फाटिकाम्बुजशोभिताम् ।\nसभां पुष्करिणीं मत्वा पतितोऽस्मि नराधिप ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2122623, "chapter_id": 3631, "verse_number": "३०", "content_sanskrit": "पुनश्च तादृशीमेव वापीं जलजशालिनीम् ।\nमत्वा शिलासभां तोये पतितोऽस्मि नराधिप ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2122624, "chapter_id": 3631, "verse_number": "३१", "content_sanskrit": "तत्र मां प्राहसत् कृष्णः पार्थेन सह सस्वरम् ।\nदौपदी च सह स्त्रीभिः पीडयन्ती मनो मम ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2122625, "chapter_id": 3631, "verse_number": "३२", "content_sanskrit": "क्लिन्नवस्त्रस्य च जले किङ्करा राजचोदिताः ।\nददुर्वासांसि चान्यानि तच्च दुःखतरं मम ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2122626, "chapter_id": 3631, "verse_number": "३३", "content_sanskrit": "प्रलम्भं च शृणुष्वान्यद् गदतो मे नराधिप ।\nअद्वारेण विनिर्गच्छन् द्वारसंस्थानरूपिणा ।\nअभिहत्य शिलां भूयो ललाटे चास्मि ताडितः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2122627, "chapter_id": 3631, "verse_number": "३४", "content_sanskrit": "इदं द्वारमिदं राजन् न द्वारमिति मां प्रति ।\nअग्रतः प्रहसन् वाक्यं बभाषे स वृकोदरः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2122628, "chapter_id": 3631, "verse_number": "३५", "content_sanskrit": "तत्र मां यमजौ दूरादालोक्य ललितौ किल ।\nसहितावनुगन्तारौ बाहुभिः प्रत्यगृह्णताम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2122629, "chapter_id": 3631, "verse_number": "३६", "content_sanskrit": "उवाच सहदेवो मां तत्र विस्मापयन्निव ।\nइदं द्वारमितो राजन् निर्गच्छेति पुनः पुनः ।\nन श्रुतानि न दृष्टानि तेन तप्तोऽस्मि दुःखितः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2122630, "chapter_id": 3631, "verse_number": "५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि त्रिसप्ततितमोऽध्यायः ॥७३॥ ॥ द्यूतपर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2122631, "chapter_id": 3631, "verse_number": "", "content_sanskrit": "––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]