[{"id": 2117072, "chapter_id": 3520, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2117073, "chapter_id": 3520, "verse_number": "१", "content_sanskrit": "एवं विवाहं कृत्वा ते वीरा द्रुपदवेश्मनि ।\nऊषुः सर्वे यथा पुण्यं कृतवन्तोऽन्तरिक्षगाः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2117074, "chapter_id": 3520, "verse_number": "२", "content_sanskrit": "पाण्डवैः सह संयोगं गतस्य द्रुपदस्य तु ।\nन बभूव भयं किञ्चिद् देवेभ्योऽपि कथञ्चन \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2117075, "chapter_id": 3520, "verse_number": "३", "content_sanskrit": "कुन्तीमासाद्य ता नार्यो द्रुपदस्य महात्मनः ।\nपादौ ववन्दिरे हृष्टाः शिरोभिर्नाम कीर्तयन् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2117076, "chapter_id": 3520, "verse_number": "४", "content_sanskrit": "द्रौपदी क्षौमसंवीता कृतकौतुकमङ्गला ।\nअभिवाद्य तदा श्वश्रूं तस्थौ प्रह्वा कृताञ्जलिः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2117077, "chapter_id": 3520, "verse_number": "५", "content_sanskrit": "रूपयौवनसम्पन्नां शीलाचारसमन्विताम् ।\nद्रौपदीमवदत् प्रेम्णा पृथाऽऽशीर्वचनं स्नुषाम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2117078, "chapter_id": 3520, "verse_number": "६", "content_sanskrit": "यथेन्द्राणी हरिहये स्वाहा चैव हुताशने ।\nरोहिणी च यथा सोमे दमयन्ती यथा नळे \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2117079, "chapter_id": 3520, "verse_number": "७", "content_sanskrit": "यथा वैश्रवणे भद्रा वसिष्ठे चाप्यरुन्धती ।\nयथा नारायणे लक्ष्मीस्तथा त्वं भव भर्तृषु \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2117080, "chapter_id": 3520, "verse_number": "८", "content_sanskrit": "जीव त्वं वीरसूर्भद्रे बहुपुत्रसमन्विता ।\nसुभगा भोगसम्पन्ना यज्ञपत्नी भवानघे \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2117081, "chapter_id": 3520, "verse_number": "९", "content_sanskrit": "अतिथीनागतान् साधून् वृद्धान् बालान् गुरूंस्तथा ।\nपूजयन्त्या यथान्यायं शश्वद् गच्छन्तु ते समाः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2117082, "chapter_id": 3520, "verse_number": "१०", "content_sanskrit": "कुरुजाङ्गलमुख्येषु राष्ट्रेषु नगरेषु च ।\nअनु त्वमभिषिञ्चस्व कुरुराजं युधिष्ठिरम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2117083, "chapter_id": 3520, "verse_number": "११", "content_sanskrit": "पतिभिर्निर्जितामुर्वीं विक्रमेण महाबलैः॥\nकुरु ब्राह्मणसात् सर्वामश्वमेधे महाक्रतौ \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2117084, "chapter_id": 3520, "verse_number": "१२", "content_sanskrit": "पृथिव्यां यानि रत्नानि गुणवन्ति गुणान्विते ।\nतान्याप्नुहि त्वं कल्याणि सुखिनी शरदां शतम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2117085, "chapter_id": 3520, "verse_number": "१३", "content_sanskrit": "यथा च त्वाऽभिनन्दामि वध्वद्य क्षौमसंवृताम् ।\nतथा भूयोऽपि नन्दिष्ये सुतान् पुत्रान् गुणान्वितान् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2117086, "chapter_id": 3520, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2117087, "chapter_id": 3520, "verse_number": "१४", "content_sanskrit": "प्राहिणोद् वासुदेवस्तु पाण्डवेभ्यो रिपुञ्जयः ।\nमुक्तावैडूर्यचित्राणि हैमान्याभरणानि च \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2117088, "chapter_id": 3520, "verse_number": "१५", "content_sanskrit": "वासांसि च महार्हाणि नानदेश्यानि माधवः ।\nकम्बलाजिनरत्नानि स्पर्शवन्ति शुभानि च \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2117089, "chapter_id": 3520, "verse_number": "१६", "content_sanskrit": "शयनासनयानानि विविधानि महान्ति च ।\nवैडूर्यरत्नचित्राणि शतशो भाजनानि च \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2117090, "chapter_id": 3520, "verse_number": "१७", "content_sanskrit": "रूपयौवनदाक्षिण्यैरुपेताश्च स्वलङ्कृताः ।\nप्रेष्याः सम्प्रददौ कृष्णो नानादेश्याः सहस्रशः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2117091, "chapter_id": 3520, "verse_number": "१८", "content_sanskrit": "गजान् विनीतान् भद्रांश्च सदश्वांश्च स्वलङ्कृतान् ।\nरथांश्च दान्तान् सौवर्णान् शुभैः पत्रैरलङ्कृतान् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2117092, "chapter_id": 3520, "verse_number": "१९", "content_sanskrit": "कोटिशश्च सुवर्णानां तथैव कृतकं बहु ।\nकृताकृतममेयात्मा प्राहिणोन्मधुसूदनः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2117093, "chapter_id": 3520, "verse_number": "२०", "content_sanskrit": "तत् सर्वं प्रतिजग्राह धर्मराजो युधिष्ठिरः ।\nअर्चयिष्यन् हृषीकेशं गोविन्दप्रियकाम्यया॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2117094, "chapter_id": 3520, "verse_number": "१९९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकोनद्विशतशततमोऽध्यायः ॥१९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2117095, "chapter_id": 3520, "verse_number": "८", "content_sanskrit": "॥ इति वैवाहिकपर्वणि अष्टमोऽध्यायः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2117096, "chapter_id": 3520, "verse_number": "", "content_sanskrit": "॥ वैवाहिकपर्व समाप्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2117097, "chapter_id": 3520, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]