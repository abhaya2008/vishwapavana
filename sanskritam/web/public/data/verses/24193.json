[{"id": 7004193000, "chapter_id": 24193, "verse_number": "५-१-४२-१", "content_sanskrit": "सनत्कुमार उवाच ।\nपुरा चैशानकल्पे तु स्मृतावंती यथा पुरी ।\nतथा शृणु सुरैः पूर्वं दैत्यसैन्यपराजितैः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004193001, "chapter_id": 24193, "verse_number": "५-१-४२-२", "content_sanskrit": "आश्रितं मेरुशिखरं वनकंदगुहावृतम् ।\nतत्र गत्वा द्विजश्रेष्ठ मंत्रं च चक्रुरुद्यताः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004193002, "chapter_id": 24193, "verse_number": "५-१-४२-३", "content_sanskrit": "अन्योन्यं च समासाद्य समभ्यर्च्य परस्परम् ।\nजग्मुः सर्वे सुरगणा यत्र ब्रह्मा प्रजापतिः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004193003, "chapter_id": 24193, "verse_number": "५-१-४२-४", "content_sanskrit": "निवेदयांचक्रिरे सर्वं तत्रागमनकारणम् ।\nतेषां तद्वचनं श्रुत्वा देवानां स प्रजेश्वरः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004193004, "chapter_id": 24193, "verse_number": "५-१-४२-५", "content_sanskrit": "जगाम त्रिदशैः साकं देवदेवं महेश्वरम् ।\nस चापि ह्यगमत्तत्र वैकुठं धाम यत्र वै॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004193005, "chapter_id": 24193, "verse_number": "५-१-४२-६", "content_sanskrit": "ऋद्धिसिद्धिप्रदं नित्यं मुनिचारणसेवितम् ।\nकिन्नरैर्गीयमानं च अप्सरोगणसेवितम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004193006, "chapter_id": 24193, "verse_number": "५-१-४२-७", "content_sanskrit": "ऋषिभिर्भार्गवादिभिर्देवर्षिनारदोत्तमैः ।\nसिद्धगंधर्वमुख्यैश्च कुमारैः सनकादिभिः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004193007, "chapter_id": 24193, "verse_number": "५-१-४२-८", "content_sanskrit": "प्रजापतिगणाकीर्णं मानवैश्च चतुर्दशैः ।\nवसुभिर्विश्वेदेवैश्च पितॄणामुत्तमैर्गणैः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004193008, "chapter_id": 24193, "verse_number": "५-१-४२-९", "content_sanskrit": "संसेव्यं च सदाचारैः पुण्यवद्भिर्जनैस्तथा ।\nदिव्यं दिव्यैश्च प्रासादैर्दिव्यपादपशोभितम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004193009, "chapter_id": 24193, "verse_number": "५-१-४२-१०", "content_sanskrit": "मणिरत्नैश्च सोपानै र्दिव्यं सरसशोभितम् ।\nहंसकारंडवाकीर्णं मणिभाभिः सुभास्वरम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004193010, "chapter_id": 24193, "verse_number": "५-१-४२-११", "content_sanskrit": "षडूर्मिरहितं स्थानं यत्र तिष्ठन्ति पक्षिणः ।\nतत्र गत्वा सुराः सर्वे वासु देवदिदृक्षया ।\nस्तुतिमारेभिरे कर्तुं देवदेवजगत्पतेः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004193011, "chapter_id": 24193, "verse_number": "५-१-४२-१२", "content_sanskrit": "देवा ऊचुः ।\nनमोऽनंताय बृहते कूर्माय वै नमोनमः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004193012, "chapter_id": 24193, "verse_number": "५-१-४२-१३", "content_sanskrit": "नृसिंहरूपायोग्राय नमो वाराहरूपिणे ।\nराघवाय च रामाय ब्रह्मणेऽनंतशक्तये॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004193013, "chapter_id": 24193, "verse_number": "५-१-४२-१४", "content_sanskrit": "वासुदेवाय शांताय यदूनां पतये नमः ।\nनमो बुद्धाय शुद्धाय कल्कये म्लेच्छनाशिने॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004193014, "chapter_id": 24193, "verse_number": "५-१-४२-१५", "content_sanskrit": "इति स्तवाभियुक्तानां वागुवाचाशरीरिणी ।\nशृणुध्वं भोः सुराः सर्वे भूत्वा चैकाग्रमानसाः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004193015, "chapter_id": 24193, "verse_number": "५-१-४२-१६", "content_sanskrit": "महाकालवने रम्ये ब्रह्मर्षिगणसेविते ।\nतत्र पुण्या पुरी ह्येका सर्वकामफलप्रदा॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004193016, "chapter_id": 24193, "verse_number": "५-१-४२-१७", "content_sanskrit": "नाम्ना कुशस्थली रम्या सिद्धगंधर्वसेविता ।\nकल्पादौ कल्पमध्ये वा यत्र संनिहितो हरः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004193017, "chapter_id": 24193, "verse_number": "५-१-४२-१८", "content_sanskrit": "कल्पक्षये क्षयं यांति स्थावराणि चराणि च ।\nतीर्थानि चैव सर्वाणि पुण्यान्यायतनानि च॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004193018, "chapter_id": 24193, "verse_number": "५-१-४२-१९", "content_sanskrit": "सरितः सागराः सर्वे सरांस्युपवनानि च ।\nऔषधीर्वृक्षवल्लीश्च यंत्रं मंत्रं शुभाशुभम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004193019, "chapter_id": 24193, "verse_number": "५-१-४२-२०", "content_sanskrit": "ज्योतींषि चंद्रसूर्यौ च सर्वं विष्णुमयं जगत् ।\nतेषां बीजं च पुण्यं च जीवकर्माशय तथा॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004193020, "chapter_id": 24193, "verse_number": "५-१-४२-२१", "content_sanskrit": "सर्वमादाय भगवाञ्छंकरस्तत्र तिष्ठति ।\nसर्वतीर्थमयी गंगा सर्वदेवमयो हरिः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004193021, "chapter_id": 24193, "verse_number": "५-१-४२-२२", "content_sanskrit": "सर्वयज्ञमयो वेदः सर्वधर्ममयी दया ।\nरेवा च सरितां श्रेष्ठा भुवि पुण्यकृताधिका॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004193022, "chapter_id": 24193, "verse_number": "५-१-४२-२३", "content_sanskrit": "तस्माद्धितकरं क्षेत्रं कुरूणां वै सुरोत्तमाः ।\nतस्माद्दशगुणं मन्ये प्रयागं तीर्थमुत्तमम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004193023, "chapter_id": 24193, "verse_number": "५-१-४२-२४", "content_sanskrit": "तस्माद्दशगुणा काशी काश्या दशगुणा गया ।\nततो दशगुणा प्रोक्ता कुशस्थली च पुण्यदा॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004193024, "chapter_id": 24193, "verse_number": "५-१-४२-२५", "content_sanskrit": "उपरागसहस्राणि व्यतिपातायुतानि च ।\nअमालक्षं तु एतस्याः कलां नार्हंति षोडशीम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004193025, "chapter_id": 24193, "verse_number": "५-१-४२-२६", "content_sanskrit": "लक्षमिंदुक्षये दानं सहस्रं चायनद्वये ।\nव्यतीपाते च कोटिः स्याद्रा कायां च ह्यनंतकम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004193026, "chapter_id": 24193, "verse_number": "५-१-४२-२७", "content_sanskrit": "तस्माद्धितकरा देवा पुरी ह्येषा कुशस्थली ।\nअनंताऽनंतसंख्यातं दानं किंचित्कृतं नरैः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004193027, "chapter_id": 24193, "verse_number": "५-१-४२-२८", "content_sanskrit": "तत्सर्वं भोः सुरश्रेष्ठाः सर्वं तच्चाक्षयं भवेत् ।\nतस्मात्सर्वप्रयत्नेन यूयं यात हि मा चिरम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004193028, "chapter_id": 24193, "verse_number": "५-१-४२-२९", "content_sanskrit": "क्षीणपुण्या भवंतो वै बाधंते तेन वः सुराः ।\nमहाकालवने रम्ये पुरी ह्येषा कुशस्थली॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004193029, "chapter_id": 24193, "verse_number": "५-१-४२-३०", "content_sanskrit": "तत्र गत्वा भवंतो वै स्नानदानादिकं भुवि ।\nआचरध्वं सुविधिना पुण्यात्स्वर्गमवाप्स्यथ॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004193030, "chapter_id": 24193, "verse_number": "५-१-४२-३१", "content_sanskrit": "एतच्छुत्वा वचस्तस्या वाण्याश्चाकाशगं तदा ।\nप्रणम्य शिरसा तस्यै ब्रह्मेशानपुरोगमाः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004193031, "chapter_id": 24193, "verse_number": "५-१-४२-३२", "content_sanskrit": "पुनर्जग्मुः सुराः सर्वे यत्र माहेश्वरं वनम् ।\nपुरीं चैव द्विजश्रेष्ठ सर्वकामफलप्रदाम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004193032, "chapter_id": 24193, "verse_number": "५-१-४२-३३", "content_sanskrit": "चातुर्वर्ण्यसमाकीर्णामृषिगंधर्वसेविताम् ।\nपुण्यवद्भिर्जनैः पूर्णां सिद्धचारणसेविताम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004193033, "chapter_id": 24193, "verse_number": "५-१-४२-३४", "content_sanskrit": "दरिद्रो न जडो मूर्खो न रोगी न च मत्सरी ।\nन व्याधितो नापकारी जनः क्वचित्प्रदृश्यते॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004193034, "chapter_id": 24193, "verse_number": "५-१-४२-३५", "content_sanskrit": "दाता शांताः सुशीलाश्च जरारोगविवर्जिंताः ।\nस्वधर्मनिरता नित्यं सदाचारातिथिप्रियाः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004193035, "chapter_id": 24193, "verse_number": "५-१-४२-३६", "content_sanskrit": "नरा यत्र निवसंति नार्यश्चैव पतिव्रताः ।\nमहोत्सवाः सुगीतानि हव्यं कव्यं गृहेगृहे॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004193036, "chapter_id": 24193, "verse_number": "५-१-४२-३७", "content_sanskrit": "ईदृशीं च पुरीं दृष्ट्वा देवा हर्षं परं गताः ।\nतत्र तीर्थं समाख्यातं नाम्ना पैशाचमोचनम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004193037, "chapter_id": 24193, "verse_number": "५-१-४२-३८", "content_sanskrit": "पुण्यवद्भिः सदा सेव्यं सर्वतीर्थनिषे वितम् ।\nतस्मिन्स्नात्वा च जप्त्वा च हुत्वा दत्त्वा च देवताः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004193038, "chapter_id": 24193, "verse_number": "५-१-४२-३९", "content_sanskrit": "पुण्यं चाथाक्षयं लब्ध्वा पुनर्याताः सुरालयम् ।\nजित्वाऽसुरान्महादुष्टान्स्थानं प्राप्ताः स्वकंस्वकम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004193039, "chapter_id": 24193, "verse_number": "५-१-४२-४०", "content_sanskrit": "येऽस्यां कुर्युर्महाभागाः स्नानं दानं तथार्चनम् ।\nहवनं तर्पणं पितॄंस्तत्सर्वं स्याद्ध्यनंतकम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004193040, "chapter_id": 24193, "verse_number": "५-१-४२-४१", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन एतत्कार्यं सदा बुधैः ।\nदेवतीर्थोषधीबीजभूतानां चैव पालनम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004193041, "chapter_id": 24193, "verse_number": "५-१-४२-४२", "content_sanskrit": "कल्पेकल्पे च यस्यां वै तेनावंती पुरी स्मृता ।\nअद्यप्रभृति पुरी ह्येषा नाम्नावंती कुशस्थली॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004193042, "chapter_id": 24193, "verse_number": "५-१-४२-४३", "content_sanskrit": "इत्युक्त्वा वै तदा देवाः स्वधाम परमं गताः ।\nतदारभ्य द्विजश्रेष्ठ ह्यवंती भुवि विश्रुता॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004193043, "chapter_id": 24193, "verse_number": "५-१-४२-४४", "content_sanskrit": "य एतां सुकथां दिव्यां पुण्यां च पापहारिणीम् ।\nशृणुयाच्छ्रावयेद्यो वै सर्वपापैः स मुच्यते॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004193044, "chapter_id": 24193, "verse_number": "५-१-४२-४५", "content_sanskrit": "अपुत्रो लभते पुत्रमधनो धनमाप्नुयात् ।\nवाजपेयसहस्राणां राजसूयशताधिकम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004193045, "chapter_id": 24193, "verse_number": "५-१-४२-४६", "content_sanskrit": "पुण्यं लब्ध्वा नरो नित्यं शिवलोके महीयते॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]