[{"id": 7004761000, "chapter_id": 24761, "verse_number": "६-२२३-१", "content_sanskrit": "भर्तृयज्ञ उवाच ।\nश्राद्धार्हैर्ब्राह्मणैः कार्यं श्राद्धं दर्शे तु पार्वणम् ।\nविपरीतं न कर्तव्यं श्राद्धमेकं कथंचन ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004761001, "chapter_id": 24761, "verse_number": "६-२२३-२", "content_sanskrit": "जारजातापविद्धाद्यैर्यो नरः श्राद्धमाचरेत् ।\nब्राह्मणैस्तु न संदेहस्तच्छ्राद्धं व्यर्थतां व्रजेत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004761002, "chapter_id": 24761, "verse_number": "६-२२३-३", "content_sanskrit": "आनर्त उवाच ।\nभयं मे सुमहज्जातमत्र यत्परिकीर्तितम् ।\nजारजातापविद्धैस्तु यच्छ्राद्धं व्यर्थतां व्रजेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004761003, "chapter_id": 24761, "verse_number": "६-२२३-४", "content_sanskrit": "मनुना द्वादश प्रोक्ताः किल पुत्रा महामते ।\nअपुत्राणां च पुत्रत्वं ये कुर्वंति सदैव हि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004761004, "chapter_id": 24761, "verse_number": "६-२२३-५", "content_sanskrit": "औरसः क्षेत्रजश्चैव क्रयक्रीतश्च पालितः ।\nप्रतिपन्नः सहोढश्च कानीनश्चापि सत्तम ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004761005, "chapter_id": 24761, "verse_number": "६-२२३-६", "content_sanskrit": "तथान्यौ कुण्डगोलौ च पुत्रावपि प्रकीर्तितौ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004761006, "chapter_id": 24761, "verse_number": "६-२२३-७", "content_sanskrit": "शिष्यश्च रक्षितो मृत्योस्तथाश्वत्थो वनांतिगः ।\nकिमेते नैव कथिता यत्त्वमेवं प्रजल्पसि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004761007, "chapter_id": 24761, "verse_number": "६-२२३-८", "content_sanskrit": "भर्तृयज्ञ उवाच ।\nसत्यमेतन्महाभाग सर्वे ते धर्मतः सुताः ।\nपरं युगत्रये प्रोक्ता न कलौ कलुषापहाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004761008, "chapter_id": 24761, "verse_number": "६-२२३-९", "content_sanskrit": "तदर्थं तेषु सन्तानं तावन्मात्रं युगेयुगे ।\nसत्त्वाढ्यानां च लोकानां न कलौ चाल्पमेधसाम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004761009, "chapter_id": 24761, "verse_number": "६-२२३-१०", "content_sanskrit": "कलावेव समाख्यातो व्यवहारः प्रपा तदः ।\nअल्पसत्त्वा यतो लोकास्तेन चैष विधिः स्मृतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004761010, "chapter_id": 24761, "verse_number": "६-२२३-११", "content_sanskrit": "अत्र यः संकरं कुर्याद्योनेस्तस्य फलं शृणु ।\nब्राह्मण्यां ब्राह्मणात्पुत्रो ब्रह्मघ्नः संप्रजायते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004761011, "chapter_id": 24761, "verse_number": "६-२२३-१२", "content_sanskrit": "सर्वाधमानामधमो यो वारड इति स्मृतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004761012, "chapter_id": 24761, "verse_number": "६-२२३-१३", "content_sanskrit": "क्षत्रियाच्च तथा सूतो वैश्यान्मागध एव च ।\nशूद्रात्तथांत्यजः प्रोक्तस्तेनैते वर्जिताः सुताः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004761013, "chapter_id": 24761, "verse_number": "६-२२३-१४", "content_sanskrit": "एतेषामपि निर्दिष्टाः सप्त राजन्सुपुत्रकाः ।\nपंच वंशविनाशाय पूर्वेषां पातनाय च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004761014, "chapter_id": 24761, "verse_number": "६-२२३-१५", "content_sanskrit": "औरसः प्रतिपन्नश्च क्रीतः पालित एव च ।\nशिष्यश्च दत्तजीवश्च तथाश्वत्थश्च सप्तमः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004761015, "chapter_id": 24761, "verse_number": "६-२२३-१६", "content_sanskrit": "पुंनाम्नो नरकाद्घोराद्रक्षंति च सदा हि ते ।\nपतन्तं पुरुषं तत्र तेन ते शोभनाः स्मृताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004761016, "chapter_id": 24761, "verse_number": "६-२२३-१७", "content_sanskrit": "क्षेत्रजश्च सहोढश्च कानीनः कुण्डगोलकौ ।\nपंचैते पातयंतिस्म पितॄन्स्वर्गगतानपि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004761017, "chapter_id": 24761, "verse_number": "६-२२३-१८", "content_sanskrit": "एतस्मात्कारणाच्छ्राद्धं जारजातस्य तद्वृथा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004761018, "chapter_id": 24761, "verse_number": "६-२२३-१९", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां षष्ठे नागरखण्डे हाटकेश्वरक्षेत्रमाहात्म्ये श्राद्धकल्पे श्राद्धार्हानर्हब्राह्मणादिवर्णनंनाम त्रयोविंशत्युत्तरशततमोऽध्यायः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]