[{"id": 2035669, "chapter_id": 1772, "verse_number": "५-१७-०x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2035670, "chapter_id": 1772, "verse_number": "५-१७-१", "content_sanskrit": "अथ संचिन्तयानस्य देवराजस्य धीमतः।\nनहुषस्य वधोपायं लोकपालैः सदैवतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2035671, "chapter_id": 1772, "verse_number": "५-१७-२", "content_sanskrit": "तपस्वी तत्र भगवानगस्त्यः प्रत्यदृश्यत।\nसोऽब्रवीदर्च्य देवेन्द्रं दिष्ट्या वै वर्धते भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2035672, "chapter_id": 1772, "verse_number": "५-१७-३", "content_sanskrit": "विश्वरूपविनाशेन वृत्रासुरवधेन च।\nदिष्ट्याद्य नहुषो भ्रष्टो देवराज्यात्पुरन्दर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2035673, "chapter_id": 1772, "verse_number": "५-१७-४", "content_sanskrit": "दिष्ट्या हतारिं पश्यामि भवन्तं वलसूदन।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2035674, "chapter_id": 1772, "verse_number": "५-१७-४x", "content_sanskrit": "इन्द्र उवाच।\nस्वागतं ते महर्षेऽस्तु प्रीतोऽहं दर्शनात्तत।\nपाद्यमाचमनीयं च गामर्घ्यं च प्रतीच्छ मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2035675, "chapter_id": 1772, "verse_number": "५-१७-५x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2035676, "chapter_id": 1772, "verse_number": "५-१७-५", "content_sanskrit": "पूजितं चोपविष्टं तमासेन मुनिसत्तमम्।\nपर्यपृच्छत देवेशः प्रहृष्टो ब्राह्मणर्षभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2035677, "chapter_id": 1772, "verse_number": "५-१७-६", "content_sanskrit": "श्रोतुमिच्छामि भगवन्कथ्यमानं द्विजोत्तम।\nपरिभ्रष्टः कथं स्वर्गान्नहुषः पापनिश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2035678, "chapter_id": 1772, "verse_number": "५-१७-७x", "content_sanskrit": "अगस्त्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2035679, "chapter_id": 1772, "verse_number": "५-१७-७", "content_sanskrit": "श्रृणु शक्र प्रियं वाक्यं यथा राजा दुरात्मवान् ।\nस्वर्गाद्भ्रष्टो दुराचारो नहुषो बलदर्पितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2035680, "chapter_id": 1772, "verse_number": "५-१७-८", "content_sanskrit": "श्रमार्ताश्च वहन्तस्तं नहुषं पापकारिणम् ।\nदेवर्षयो महाभागास्तथा ब्रह्मर्षयोऽमलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2035681, "chapter_id": 1772, "verse_number": "५-१७-९", "content_sanskrit": "पप्रच्छुर्नहुषं देवं संशयं जयतां वर।\nय इमे ब्रह्मणा प्रोक्ता मन्त्रा वै प्रोक्षणे गवाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2035682, "chapter_id": 1772, "verse_number": "५-१७-१०", "content_sanskrit": "एते प्रमाणं भवत उताहो नेति वासव।\nनहुषो नेति तानाह तमसा मूढचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2035683, "chapter_id": 1772, "verse_number": "५-१७-११x", "content_sanskrit": "ऋषय ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2035684, "chapter_id": 1772, "verse_number": "५-१७-११", "content_sanskrit": "अधर्मे संप्रवृत्तस्त्वं धर्मं न प्रतिपद्यसे।\nप्रमाणमेतदस्माकं पूर्वं प्रोक्तं महर्षिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2035685, "chapter_id": 1772, "verse_number": "५-१७-१२x", "content_sanskrit": "अगस्त्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2035686, "chapter_id": 1772, "verse_number": "५-१७-१२", "content_sanskrit": "ततो विवदमानः स मुनिभिः सह वासव ।\nअथ मामस्पृशन्मूर्ध्नि पादेनाधर्मपीडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2035687, "chapter_id": 1772, "verse_number": "५-१७-१३", "content_sanskrit": "तेनाभूद्धततेजाश्च निःश्रीकश्च महीपतिः ।\nततस्तं तमसा विग्नमवोचं भृशपीडितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2035688, "chapter_id": 1772, "verse_number": "५-१७-१४", "content_sanskrit": "यस्मात्पूर्वैः कृतं राजन्ब्रह्मर्षिभिरनुष्ठितम् ।\nअदृष्टं दूषयसि मे यच्च मूर्ध्य्रस्पृशः पदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2035689, "chapter_id": 1772, "verse_number": "५-१७-१५", "content_sanskrit": "यच्चापि त्वमृषीन्मूढ ब्रह्मकल्पान्दुरासदान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2035690, "chapter_id": 1772, "verse_number": "५-१७-१६", "content_sanskrit": "वाहान्कृत्व्रा वाहयसि तेन स्वर्गाद्धतप्रभः ।\nध्वंस पाप परिभ्रष्टः क्षीणपुण्यो महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2035691, "chapter_id": 1772, "verse_number": "५-१७-१७", "content_sanskrit": "दशवर्षसहस्राणि सर्परूपधरो महान्।\nविचरिष्यसि पूर्णेषु पुनः स्वर्गमवाप्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2035692, "chapter_id": 1772, "verse_number": "५-१७-१८", "content_sanskrit": "` दृष्ट्वा युधिष्ठिरं नाम तव वंशसमुद्भवम्।\nनिहतो ब्रह्मशापेन प्रपद्यस्व त्रिविष्टपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2035693, "chapter_id": 1772, "verse_number": "५-१७-१९", "content_sanskrit": "एवं भ्रष्टो दुरात्मा स देवराज्यादरिन्दम।\nदिष्ट्या वर्धामहे शक्र हतो ब्रह्मर्षिकण्टकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2035694, "chapter_id": 1772, "verse_number": "५-१७-२०", "content_sanskrit": "त्रिविष्टपं प्रपद्यस्व पाहि लोकाञ्शचीपते।\nजितेन्द्रियो जितामित्रः स्तूयमानो महर्षिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2035695, "chapter_id": 1772, "verse_number": "५-१७-२१x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2035696, "chapter_id": 1772, "verse_number": "५-१७-२१", "content_sanskrit": "ततो देवा भृशं तुष्टा महर्षिगणसंवृताः।\nपितरश्चैव यक्षाश्च भुजगा राक्षसास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2035697, "chapter_id": 1772, "verse_number": "५-१७-२२", "content_sanskrit": "गन्धर्वा देवकन्याश्च सर्वे चाप्सरसां गणाः।\nसरांसि सरितः शैलाः सागराश्च विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2035698, "chapter_id": 1772, "verse_number": "५-१७-२३", "content_sanskrit": "उपागम्याब्रुवन्सर्वे दिष्ट्या वर्धसि शक्रुहन् ।\nहतश्च नहुषः पापो दिष्ट्यागस्त्येन धीमता।\nदिष्ट्या पापसमाचारः कृतः सर्पो महीतले ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2035699, "chapter_id": 1772, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभाते उद्योगपर्वणि सेनोद्योगपर्वणि सप्तदशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]