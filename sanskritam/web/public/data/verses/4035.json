[{"id": 2140722, "chapter_id": 4035, "verse_number": "", "content_sanskrit": "उत्तरेण अर्जुनं प्रति क्षमायाचनम् । उत्तरस्य सारथित्वं च ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2140723, "chapter_id": 4035, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2140724, "chapter_id": 4035, "verse_number": "१", "content_sanskrit": "ततः पार्थं च वैराटिः प्राञ्जलिस्त्वभ्यवादयत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2140725, "chapter_id": 4035, "verse_number": "२", "content_sanskrit": "अहं भूमिञ्जयो नाम्ना प्रणतोऽस्मि धनञ्जय\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2140726, "chapter_id": 4035, "verse_number": "३", "content_sanskrit": "दिष्ट्या त्वां पार्थ पश्यामि स्वागतं ते धनञ्जय ।\nलोहिताक्ष महाबाहो नागराजवरोपम\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2140727, "chapter_id": 4035, "verse_number": "४", "content_sanskrit": "यदज्ञानादवोचं त्वां प्रमादेन नरोत्तम ।\nअकृत्वा हृदये सर्वं क्षन्तुमर्हसि तन्मम\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2140728, "chapter_id": 4035, "verse_number": "५", "content_sanskrit": "यत्तु त्वया कृतं कर्म विचित्रं वै सुदुष्करम् ।\nअतो भयं व्यपेतं मे प्रीतिश्च परमा त्वयि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2140729, "chapter_id": 4035, "verse_number": "६", "content_sanskrit": "दासोऽहं ते भविष्यामि पश्य मामनुकम्पया\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2140730, "chapter_id": 4035, "verse_number": "७", "content_sanskrit": "या प्रतिज्ञा कृता पूर्वं तव सारथ्यकर्मणि ।\nमनःस्वास्थ्यं च मे जातं जातं भाग्यं च मे महत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2140731, "chapter_id": 4035, "verse_number": "८", "content_sanskrit": "आस्थाय विपुलं वीर रथं सारथिना मया ।\nदुर्योधनं च जित्वाऽऽजौ निवर्तय पशून् मम\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2140732, "chapter_id": 4035, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2140733, "chapter_id": 4035, "verse_number": "९", "content_sanskrit": "प्रीतोऽस्मि राजपुत्राद्य न भयं विद्यते तव ।\nसर्वान् नुदामि ते शत्रून् रणे रणकृतां वर\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2140734, "chapter_id": 4035, "verse_number": "१०", "content_sanskrit": "स्वस्थो भव महाबुद्धे पश्य मां शत्रुभिः सह ।\nयुध्यमानं विमर्देऽस्मिन् कुर्वाणं भैरवं स्वनम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2140735, "chapter_id": 4035, "verse_number": "११", "content_sanskrit": "गाण्डीवं देवदत्तं च शरान् कनकभूषितान् ।\nएतान् सर्वानुपासङ्गान् क्षिप्रं नध्नीहि मे रथे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2140736, "chapter_id": 4035, "verse_number": "१२", "content_sanskrit": "एतं चाहर निस्त्रिंशं जातरूपपरिष्कृतम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2140737, "chapter_id": 4035, "verse_number": "१३", "content_sanskrit": "अहं वै कुरुभिर्योत्स्ये मोक्षयिष्यामि ते पशून् ।\nतोषयिष्यामि राजानं प्रवेक्ष्यामि पुरं पुनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2140738, "chapter_id": 4035, "verse_number": "१४", "content_sanskrit": "सङ्कल्पगाढपरिखं बाहुप्राकारतोरणम् ।\nत्रिदण्डतूणसम्बाधं नैकध्वजसमाकुलम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2140739, "chapter_id": 4035, "verse_number": "१५", "content_sanskrit": "ज्याक्षेपनिनदारावं नेमीनिनददुन्दुभि ।\nशरजालवितानाढ्यमाक्ष्वेळितमहास्वनम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2140740, "chapter_id": 4035, "verse_number": "१६", "content_sanskrit": "नगरं ते मया गुप्तं रथोपस्थं भविष्यति\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2140741, "chapter_id": 4035, "verse_number": "१७", "content_sanskrit": "अधिष्ठितो मया सङ्खे रथो गाण्डीवधन्विना ।\nअजय्यः शत्रुसैन्यानां वैराट व्येतु ते भयम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2140742, "chapter_id": 4035, "verse_number": "", "content_sanskrit": "उत्तरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2140743, "chapter_id": 4035, "verse_number": "१८", "content_sanskrit": "बिभेमि नाहमेतेभ्यो जानामि त्वां स्थिरं युधि ।\nकेशवेनापि सङ्ग्रामे साक्षादिन्द्रेण वा समम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2140744, "chapter_id": 4035, "verse_number": "१९", "content_sanskrit": "इदं तु चिन्तयन्नेव परिमुह्यामि केवलम् ।\nनिश्चयं नाधिगच्छामि नावगच्छामि किञ्चन\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2140745, "chapter_id": 4035, "verse_number": "२०", "content_sanskrit": "एवं वीराङ्गरूपस्य लक्षणैरुदितस्य ते ।\nकेन कर्मविपाकेन क्लीबत्वं समुपागतम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2140746, "chapter_id": 4035, "verse_number": "२१", "content_sanskrit": "मन्ये त्वां क्लीबवेषेण चरन्तं शूलपाणिनम् ।\nगन्धर्वराजप्रतिमं देवं वाऽपि शतक्रतुम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2140747, "chapter_id": 4035, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2140748, "chapter_id": 4035, "verse_number": "२२", "content_sanskrit": "भ्रातुर्नियोगाज्ज्येष्ठस्य संवत्सरमिदं व्रतम् ।\nचरामि ब्रह्मचर्यं वै सत्यमेतद् ब्रवीमि ते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2140749, "chapter_id": 4035, "verse_number": "२३", "content_sanskrit": "नास्मि क्लीबो महाबाहो परवान् धर्मसंयुतः ।\nउर्वशीशापवशतः क्लैब्यं मां समुपस्थितम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2140750, "chapter_id": 4035, "verse_number": "२४", "content_sanskrit": "पुराऽहमाज्ञया भ्रातुर्ज्येष्ठस्यापि सुरालयम् ।\nप्राप्तवानुर्वशी दृष्टा सुधर्मायां मया तदा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2140751, "chapter_id": 4035, "verse_number": "२५", "content_sanskrit": "नृत्यन्तीं परमं रूपं बिभ्रतीं वज्रिसन्निधौ ।\nअपश्यं तामनिमिषं कूटस्थामन्वयस्य मे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2140752, "chapter_id": 4035, "verse_number": "२६", "content_sanskrit": "रात्रौ समागता मह्यं शयानं रन्तुमिच्छया ।\nअहं तामभिवाद्यैव मातृसत्कारमाचरम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2140753, "chapter_id": 4035, "verse_number": "२७", "content_sanskrit": "सा च मामशपत् क्रुद्धा शिखण्डी त्वं भवेरिति ।\nश्रुत्वा तमिन्द्रो मामाह मा भैस्त्वं पार्थ षण्डता\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2140754, "chapter_id": 4035, "verse_number": "२८", "content_sanskrit": "उपकारो भवेत् तुभ्यमज्ञातवसतौ पुरा ।\nइतीन्द्रो मामनुग्राह्य ततः प्रेषितवान् वृषा\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2140755, "chapter_id": 4035, "verse_number": "२९", "content_sanskrit": "तदिदं समनुप्राप्तं व्रतं तीर्णं मयाऽनघ ।\nसमाप्तव्रतमुत्तीर्णं विद्धि मां त्वं नृपात्मज\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2140756, "chapter_id": 4035, "verse_number": "", "content_sanskrit": "उत्तरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2140757, "chapter_id": 4035, "verse_number": "३०", "content_sanskrit": "परमोऽनुग्रहो मेऽद्य यत् प्रतर्को न मे वृथा ।\nन हीदृशाः क्लीबरूपा भवन्तीह नरोत्तमाः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2140758, "chapter_id": 4035, "verse_number": "३१", "content_sanskrit": "सहायवानस्मि रणे युद्ध्येयममरैरपि ।\nसाध्वसं तत् प्रणष्टं मे किं करोमि प्रशाधि माम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2140759, "chapter_id": 4035, "verse_number": "३२", "content_sanskrit": "अहं ते सङ्ग्रहीष्यामि हयान् शत्रूनथारुज ।\nशिक्षितो ह्यस्मि सारथ्ये निष्ठितः पुरुषर्षभ\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2140760, "chapter_id": 4035, "verse_number": "३३", "content_sanskrit": "दारुको वासुदेवस्य यथा शक्रस्य मातलिः ।\nतथा मां विद्धि सारथ्ये शिक्षितं नरपुङ्गव\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2140761, "chapter_id": 4035, "verse_number": "३४", "content_sanskrit": "अश्वा ह्येते महाबाहो तवैवाहवदुर्जयाः ।\nयोग्या रथवरे युक्ताः प्राणवन्तो जितश्रमाः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2140762, "chapter_id": 4035, "verse_number": "३५", "content_sanskrit": "यस्य यातो न पश्यन्ति भूमौ प्राप्तं पदं पदम् ।\nदक्षिणां यो धुरं वोढा सुग्रीवेण समो हयः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2140763, "chapter_id": 4035, "verse_number": "३६", "content_sanskrit": "योऽयं धुरं धुर्यवरो वामां वहति शोभनः ।\nतं मन्ये मेघपुष्पस्य जवेन सदृशं हयम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2140764, "chapter_id": 4035, "verse_number": "३७", "content_sanskrit": "योऽयं वहति वै पार्ष्णिं दक्षिणामञ्चितोद्यमः ।\nबलाहकादपि मतस्तेजसा वीर्यवत्तरः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2140765, "chapter_id": 4035, "verse_number": "३८", "content_sanskrit": "योऽयं काञ्चनसन्नाहो वामं वहति शोभनः ।\nधुर्यं सैन्यस्य तं मन्ये जवेन बलवत्तरम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2140766, "chapter_id": 4035, "verse_number": "३९", "content_sanskrit": "त्वामेवायं रथो वोढुं सङ्ग्रामेऽर्हति धन्विनम् ।\nत्वं चेमं रथमास्थाय योद्धुमर्हो मतो मम\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2140767, "chapter_id": 4035, "verse_number": "४०", "content_sanskrit": "सर्वशत्रुभिरायातैर्देवराज इवासुरैः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2140768, "chapter_id": 4035, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2140769, "chapter_id": 4035, "verse_number": "४१", "content_sanskrit": "ततो रथादवस्कन्द्य वीर्यवानरिमर्दनः ।\nप्रणम्य देवान् गाण्डीवमादाय रुरुचे श्रिया\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2140770, "chapter_id": 4035, "verse_number": "४२", "content_sanskrit": "ततो विमुच्य बाहुभ्यां शङ्खचूळानि पाण्डवः ।\nतौ च दुन्दुभिसन्नादौ प्रतिबद्ध्य तळावुभौ\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2140771, "chapter_id": 4035, "verse_number": "४३", "content_sanskrit": "इन्द्रदत्ते च ते दिव्ये उद्धृत्यामुच्य कुण्डले ।\nश्लक्ष्णान् केशान् मृदून् स्निग्धान् श्वेतेनोद्ग्रथ्य वाससा\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2140772, "chapter_id": 4035, "verse_number": "४४", "content_sanskrit": "अधिज्यं तरसा कृत्वा गाण्डीवं व्याक्षिपद् धनुः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2140773, "chapter_id": 4035, "verse_number": "४५", "content_sanskrit": "तस्य विक्षिप्यमाणस्य धनुषोऽभून्महास्वनः ।\nयथा शैलस्य महतः शैलानाप्यभिजघ्नतः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2140774, "chapter_id": 4035, "verse_number": "४६", "content_sanskrit": "सनिर्घाताऽभवद् भूमिर्दिक्षु वायुर्ववौ भृशम् ।\nभ्रान्तद्विजं खमभवत् प्राकम्पितमहाद्रुमम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2140775, "chapter_id": 4035, "verse_number": "४७", "content_sanskrit": "तं शब्दं कुरवो राजन् विस्फोटमशनेरिव ।\nतार्क्ष्यशब्दमिव श्रुत्वा वित्रेसुर्दीनमानसाः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2140776, "chapter_id": 4035, "verse_number": "४८", "content_sanskrit": "यथेन्द्रो व्याक्षिपद् भीमं विस्फोटमशनेः प्रभुः ।\nतथाऽर्जुनो धनुःश्रेष्ठं बाहुभ्यामाक्षिपद् रथे\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2140777, "chapter_id": 4035, "verse_number": "४९", "content_sanskrit": "महाशनिमहाशब्दसदृशो ज्यास्वनो महान् ।\nशत्रून् वीरांश्च सन्तर्ज्य निग्रहस्थो रथे स्थितः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2140778, "chapter_id": 4035, "verse_number": "५०", "content_sanskrit": "अथासौ प्राङ्मुखो भूत्वा शुचिः प्रयतमानसः ।\nअभिदध्यौ महाबाहुः सर्वास्त्राणि रथोत्तमे\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2140779, "chapter_id": 4035, "verse_number": "५१", "content_sanskrit": "ऊचुश्च पार्थं सर्वाणि प्राञ्जलीनि नृपात्मजम् ।\nइमे स्म परमोदार किङ्कराः पाण्डुनन्दन\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2140780, "chapter_id": 4035, "verse_number": "५२", "content_sanskrit": "प्रणिपत्य ततः पार्थः समालभ्य च पाणिना ।\nसर्वाणि मानसानीह भवतेत्यभ्यभाषत\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2140781, "chapter_id": 4035, "verse_number": "५३", "content_sanskrit": "प्रतिगृह्य ततोऽस्त्राणि प्रहृष्टवदनोऽभवत्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2140782, "chapter_id": 4035, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि त्रिचत्वारिंशोऽध्यायः ॥४३॥\nगोग्रहणपर्वणि षोडशोऽध्यायः ॥१६॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]