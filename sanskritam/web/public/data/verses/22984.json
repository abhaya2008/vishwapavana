[{"id": 7002984000, "chapter_id": 22984, "verse_number": "२-३१-१", "content_sanskrit": "यम उवाच ।\nहरिसेवां विना साध्वि न लभेत्कर्मखण्डनम् ।\nशुभकर्म्म स्वर्गबीजं नरकं च कुकर्म्मतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002984001, "chapter_id": 22984, "verse_number": "२-३१-२", "content_sanskrit": "पुंश्चल्यन्नं च यो भुंक्ते वेश्यान्नं च पतिव्रते ।\nतां व्रजेत्तु द्विजो यो हि कालसूत्रं प्रयाति सः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002984002, "chapter_id": 22984, "verse_number": "२-३१-३", "content_sanskrit": "शतवर्षं कालसूत्रे स्थित्वा शूद्रो भवेद्ध्रुवम् ।\nतत्र जन्मनि रोगी च ततः शुद्धो भवेद्द्विजः॥ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002984003, "chapter_id": 22984, "verse_number": "२-३१-४", "content_sanskrit": "पतिव्रता चैकपत्नी द्वितीये कुलटा स्मृता ।\nतृतीये धर्षिणी ज्ञेया चतुर्थे पुंश्चली स्मृता ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002984004, "chapter_id": 22984, "verse_number": "२-३१-५", "content_sanskrit": "वेश्या च पञ्चमे षष्ठे युग्मी च परिकीर्तिता ।\nअत ऊर्ध्वं महावेश्या साऽस्पृश्या सर्वजातिषु ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002984005, "chapter_id": 22984, "verse_number": "२-३१-६", "content_sanskrit": "यो द्विजः कुलटां गच्छेद्धर्षिणीं पुंश्चलीमपि ।\nवेश्य युग्मीं महावेश्यामवटोदं प्रयाति सः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002984006, "chapter_id": 22984, "verse_number": "२-३१-७", "content_sanskrit": "शताब्दं कुलटागामी धृष्टागामी चतुर्गुणम् ।\nषड्गुणं पुंश्चलीगामी वेश्यागामी गुणाष्टकम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002984007, "chapter_id": 22984, "verse_number": "२-३१-८", "content_sanskrit": "युग्मीगामी दशगुणं वसेत्तत्र न संशयः ।\nमहावेश्याकामुकश्च ततः शतगुणं वसेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002984008, "chapter_id": 22984, "verse_number": "२-३१-९", "content_sanskrit": "तदा हि सर्वगामी चेत्येवमाह पितामहः ।\nतत्रैव यातनां भुङ्क्ते यमदूतेन ताडितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002984009, "chapter_id": 22984, "verse_number": "२-३१-१०", "content_sanskrit": "तित्तिरिः कुलटागामी धृष्टागामी च वायसः ।\nकोकिलः पुंश्चलीगामी वेश्यागामी वृकस्तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002984010, "chapter_id": 22984, "verse_number": "२-३१-११", "content_sanskrit": "युग्मीगामी सूकरश्च सप्तजन्मसु भारते ।\nमहावेश्याकामुकश्च श्मशाने शाल्मलिस्तरुः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002984011, "chapter_id": 22984, "verse_number": "२-३१-१२", "content_sanskrit": "यो भुंक्ते ज्ञानहीनश्च ग्रहणे चन्द्रसूय्यर्योः ।\nअरुन्तुदं स यात्येव चन्द्रमानाब्दमेव च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002984012, "chapter_id": 22984, "verse_number": "२-३१-१३", "content_sanskrit": "ततो भवेन्मानवस्स्यादुदरव्याधिसंयुतः ।\nगुल्मयुक्तश्च काणश्च दन्तहीनस्ततः शुचिः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002984013, "chapter_id": 22984, "verse_number": "२-३१-१४", "content_sanskrit": "वाक्प्रदत्तां हि कन्यां च यश्चान्यस्मै ददाति च ।\nस वसेत्पांशुभोगे च तद्भोजी च शताब्दकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002984014, "chapter_id": 22984, "verse_number": "२-३१-१५", "content_sanskrit": "दत्तापहारी यः साध्वि पाशवेष्टं शताब्दकम् ।\nनिवसेच्छरशय्यायां यमदूतेन ताडितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002984015, "chapter_id": 22984, "verse_number": "२-३१-१६", "content_sanskrit": "न पूजयेद्यो हि भक्त्या शिवलिङ्गं च पार्थिवम् ।\nस याति शूलिनः कोपाच्छूलप्रोतं सुदारुणम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002984016, "chapter_id": 22984, "verse_number": "२-३१-१७", "content_sanskrit": "स्थित्वा शताब्दं तत्रैव श्वापदः सप्तजन्मसु ।\nततो भवेद्देवलश्च सप्तजन्मस्वतः शुचिः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002984017, "chapter_id": 22984, "verse_number": "२-३१-१८", "content_sanskrit": "करोति दण्डं यो विप्रे यद्भयात्कम्पते द्विजः ।\nप्रकम्पने वसेत्सोऽपि विप्रलोमाब्दमेव च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002984018, "chapter_id": 22984, "verse_number": "२-३१-१९", "content_sanskrit": "प्रकोपवदना कोपात्स्वामिनं या च पश्यति ।\nकटूक्तिं तं च वदति याति चोल्कामुखं च सा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002984019, "chapter_id": 22984, "verse_number": "२-३१-२०", "content_sanskrit": "उल्कां ददाति वक्त्रे च सततं यमकिङ्करः ।\nदण्डेन ताडयेन्मूर्ध्नि तल्लोमाब्दप्रमाणकम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002984020, "chapter_id": 22984, "verse_number": "२-३१-२१", "content_sanskrit": "ततो भवेन्मानवी च विधवा सप्तजन्मसु ।\nभुक्त्वा दुःखं च वैधव्यं व्याधिं भुक्त्वा ततः शुचिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002984021, "chapter_id": 22984, "verse_number": "२-३१-२२", "content_sanskrit": "या ब्राह्मणी शूद्रभोग्या साऽन्धकूपं प्रयाति च ।\nतप्तशौचोदके ध्वान्ते तदाहारा दिवानिशम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002984022, "chapter_id": 22984, "verse_number": "२-३१-२३", "content_sanskrit": "निवसेदतिसन्तप्ता यमदूतेन ताडिता ।\nशौचोदके निमग्ना च यावदिन्द्राश्चतुर्दश ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002984023, "chapter_id": 22984, "verse_number": "२-३१-२४", "content_sanskrit": "काकी जन्मसहस्राणि शतजन्मानि सूकरी ।\nकुक्कुटी शतजन्मानि शृगाली सप्तजन्मसु ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002984024, "chapter_id": 22984, "verse_number": "२-३१-२५", "content_sanskrit": "पारावती सप्तजनौ वानरी सप्तजन्मसु ।\nततो भवेत्सा चण्डाली सर्वभोग्या च भारते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002984025, "chapter_id": 22984, "verse_number": "२-३१-२६", "content_sanskrit": "ततो भवेच्च रजकी यक्ष्मग्रस्ता च पुंश्चली ।\nततः कुष्ठयुता तैलकारी शुद्धा भवेत्ततः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002984026, "chapter_id": 22984, "verse_number": "२-३१-२७", "content_sanskrit": "वेश्या वसेद्वेधने च युग्मी वै दण्डताडने ।\nजालबन्धे महावेश्या कुलटा देहचूर्णके ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002984027, "chapter_id": 22984, "verse_number": "२-३१-२८", "content_sanskrit": "स्वैरिणी दलने चैव धृष्टा वै शोषणे तथा ।\nनिवसेद्यातनायुक्ता यमदूतेन ताडिता ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002984028, "chapter_id": 22984, "verse_number": "२-३१-२९", "content_sanskrit": "विण्मूत्रभक्षणं तत्र यावन्मन्वन्तरं सति ।\nततो भवेद्विट्कृमिश्च वर्षलक्षं ततः शुचिः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002984029, "chapter_id": 22984, "verse_number": "२-३१-३०", "content_sanskrit": "ब्राह्मणो ब्राह्मणीं गच्छेत्क्षत्त्रियामपि क्षत्रियः ।\nवैश्यो वैश्यां च शूद्रां च शूद्रो वाऽपि व्रजेद्यदि ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002984030, "chapter_id": 22984, "verse_number": "२-३१-३१", "content_sanskrit": "स्ववर्णपरदारी च कषं याति तया सह ।\nभुक्त्वा कषायतप्तोदं निवसेद्द्वादशाब्दकम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002984031, "chapter_id": 22984, "verse_number": "२-३१-३२", "content_sanskrit": "ततो विप्रो भवेच्छुद्धश्चैवं च क्षत्रियादयः ।\nयोषितश्चापि शुध्यन्तीत्येवमाह पितामहः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002984032, "chapter_id": 22984, "verse_number": "२-३१-३३", "content_sanskrit": "क्षत्रियो ब्राह्मणीं गच्छेद्वैश्यो वाऽपि पतिव्रते ।\nमातृगामी भवेत्सोऽपि शूर्पं च नरकं व्रजेत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002984033, "chapter_id": 22984, "verse_number": "२-३१-३४", "content_sanskrit": "शूर्पाकारैश्च कृमिभिर्ब्राह्मण्या सह भक्षितः ।\nप्रतप्तमूत्रभोजी च यमदूतेन ताडितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002984034, "chapter_id": 22984, "verse_number": "२-३१-३५", "content_sanskrit": "तत्रैव यातनां भुंक्ते यावदिन्द्राश्चतुर्दश ।\nसप्तजन्मसु वाराहश्छागलश्च ततः शुचिः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002984035, "chapter_id": 22984, "verse_number": "२-३१-३६", "content_sanskrit": "करे धृत्वा च तुलसीं प्रतिज्ञां यो न पालयेत् ।\nमिथ्या वा शपथं कुर्य्यात्स च ज्वालामुखं व्रजेत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002984036, "chapter_id": 22984, "verse_number": "२-३१-३७", "content_sanskrit": "गङ्गातोयं करे धृत्वा प्रतिज्ञां यो न पालयेत् ।\nशिलां च देवप्रतिमां स च ज्वालामुखं व्रजेत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002984037, "chapter_id": 22984, "verse_number": "२-३१-३८", "content_sanskrit": "दत्त्वा च दक्षिणं हस्तं प्रतिज्ञां यो न पालयेत् ।\nस्थित्वा देवगृहे वाऽपि स च ज्वालामुखं व्रजेत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002984038, "chapter_id": 22984, "verse_number": "२-३१-३९", "content_sanskrit": "स्पृष्ट्वा च ब्राह्मणं गां च वह्निं विष्णुसमं सति ।\nन पालयेत्प्रतिज्ञां च स च ज्वालामुखं व्रजेत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002984039, "chapter_id": 22984, "verse_number": "२-३१-४०", "content_sanskrit": "मित्रद्रोही कृतघ्नश्च यो हि विश्वासघातकः ।\nमिथ्यासाक्ष्यप्रदश्चैव स च ज्वालामुखं व्रजेत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002984040, "chapter_id": 22984, "verse_number": "२-३१-४१", "content_sanskrit": "एते तत्र वसन्त्येव यावदिन्द्राश्चतुर्दश ।\nयथाऽङ्गारप्रदग्धाश्च यमदूतैश्च ताडिताः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002984041, "chapter_id": 22984, "verse_number": "२-३१-४२", "content_sanskrit": "चण्डालस्तुलसीस्पर्शी सप्तजन्मस्वतः शुचिः ।\nम्लेच्छो गंगाजलस्पर्शी पञ्चजन्मस्वतः शुचिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002984042, "chapter_id": 22984, "verse_number": "२-३१-४३", "content_sanskrit": "शिलास्पर्शी विट्कृमिश्च सप्तजन्मसु सुन्दरि ।\nअर्च्चास्पर्शी व्रणकृमिस्सप्तजन्मस्वतः शुचिः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002984043, "chapter_id": 22984, "verse_number": "२-३१-४४", "content_sanskrit": "दक्षहस्तप्रधाता च सर्पस्स्यात्सप्तजन्मसु ।\nततो भवेद्धस्तहीनो मानवश्च ततः शुचिः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002984044, "chapter_id": 22984, "verse_number": "२-३१-४५", "content_sanskrit": "मिथ्यावादी देवगृहे देवलः सप्तजन्मसु ।\nविप्रादिस्पर्शकारी च सोऽग्रदानी भवेद्ध्रुवम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002984045, "chapter_id": 22984, "verse_number": "२-३१-४६", "content_sanskrit": "ततो भवन्ति मूकास्ते बधिराश्च त्रिजन्मसु ।\nभार्य्याहीना वंशहीना बुद्धिहीनास्ततः शुचिः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002984046, "chapter_id": 22984, "verse_number": "२-३१-४७", "content_sanskrit": "मित्रद्रोही च न कुलः कृतघ्नश्चापि गण्डकः ।\nविश्वासघाती व्याघ्रश्च सप्तजन्मसु भारते ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002984047, "chapter_id": 22984, "verse_number": "२-३१-४८", "content_sanskrit": "मिथ्यासाक्ष्यप्रदश्चैव भल्लूकः सप्तजन्मसु ।\nपूर्वान्सप्त परान्सप्त पुरुषान्हन्ति चात्मनः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002984048, "chapter_id": 22984, "verse_number": "२-३१-४९", "content_sanskrit": "नित्यक्रियाविहीनश्च जडत्वेन युतो द्विजः ।\nयस्यानास्था वेदवाक्ये मन्दं हसति संतमम्॥ ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002984049, "chapter_id": 22984, "verse_number": "२-३१-५०", "content_sanskrit": "व्रतोपवासहीनश्च सद्वाक्यपरिनिंदकः ।\nजिह्मे जिह्मो वसेत्सोऽपि शताब्दं च हिमोदके ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002984050, "chapter_id": 22984, "verse_number": "२-३१-५१", "content_sanskrit": "जलजंतुर्भवेत्सोऽपि शतजन्मक्रमेण च ।\nततो नानाप्रकारा च मत्स्यजातिस्ततः शुचिः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002984051, "chapter_id": 22984, "verse_number": "२-३१-५२", "content_sanskrit": "यो वा धनस्यापहारं देवाब्रह्मणयोश्चरेत् ।\nपातयित्वा स्वपुरुषान्दश पूर्वान्दशापरान् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002984052, "chapter_id": 22984, "verse_number": "२-३१-५३", "content_sanskrit": "स्वयं याति च धूमांधं धूमध्वांतसमन्वितम् ।\nधूमक्लिष्टो धूमभोजी वसेत्तत्र चतुर्युगम्॥ ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002984053, "chapter_id": 22984, "verse_number": "२-३१-५४", "content_sanskrit": "ततो मूषकजातिश्च शतजन्मानि भारते ।\nततो नानाविधाः पक्षिजातयः कृमिजातयः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002984054, "chapter_id": 22984, "verse_number": "२-३१-५५", "content_sanskrit": "ततो नानाविधा वृक्षजातयश्च ततो नरः ।\nभार्याहीनो वंशहीनः शबरो व्याधिसंयुतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002984055, "chapter_id": 22984, "verse_number": "२-३१-५६", "content_sanskrit": "ततो भवेत्स्वर्णकारः सुवर्णस्य वणिक्तथा ।\nततो यवनसेवी च ब्राह्मणो गणकस्ततः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002984056, "chapter_id": 22984, "verse_number": "२-३१-५७", "content_sanskrit": "विप्रो दैवज्ञोपजीवी वैद्यजीवी चिकित्सकः ।\nव्यापारी लोहलाक्षादे रसादेर्विक्रयी च यः॥ ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002984057, "chapter_id": 22984, "verse_number": "२-३१-५८", "content_sanskrit": "स याति नागवेष्टं च नागैर्वेष्टित एव च ।\nवसेत्स्वलोममानाब्दं तत्र वै नागदंशितः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002984058, "chapter_id": 22984, "verse_number": "२-३१-५९", "content_sanskrit": "ततो भवेत्स गणको वैद्यो वै सप्तजन्मसु ।\nगोपश्च कर्म्मकारश्च शङ्खकारस्ततः शुचिः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002984059, "chapter_id": 22984, "verse_number": "२-३१-६०", "content_sanskrit": "प्रसिद्धानि च कुण्डानि कथितानि पतिव्रते ।\nअन्यानि चाप्रसिद्धानि तत्र क्षुद्राणि सन्ति वै ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002984060, "chapter_id": 22984, "verse_number": "२-३१-६१", "content_sanskrit": "सन्ति पातकिनस्तेषु स्वकर्मफलभोगिनः ।\nभ्रमंति तावत्संसारे किं भूयः श्रोतुमिच्छसि ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]