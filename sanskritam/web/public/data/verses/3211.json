[{"id": 2102303, "chapter_id": 3211, "verse_number": "१४-६७-१", "content_sanskrit": "वैशम्पायन उवाच।\nउत्थितायां पृथायां तु सुभद्रा भ्रातरं तदा।\nदृष्ट्वा चुक्रोश दुःखार्ता वचनं चेदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102304, "chapter_id": 3211, "verse_number": "१४-६७-२", "content_sanskrit": "पुण्डरीकाक्ष पश्य त्वं पौत्रं पार्थस्य धीमतः।\nपरिक्षीणेषु कुरुषु परिक्षीणां गतायुषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102305, "chapter_id": 3211, "verse_number": "१४-६७-३", "content_sanskrit": "इषीका द्रोणपुत्रेणि भीमसेनार्थमुद्यता।\nसोत्तरायां निपतिता विजये मयि चैव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102306, "chapter_id": 3211, "verse_number": "१४-६७-४", "content_sanskrit": "सेयं ज्वलन्ती हृदये मयि तिष्टति केशव।\nयन्न पश्यामि दुर्धर्ष सहपुत्रं तु तं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102307, "chapter_id": 3211, "verse_number": "१४-६७-५", "content_sanskrit": "किंनु वक्ष्यति धर्मात्मा धर्मराजो युधिष्ठिरः।\nभीमसेनार्जुनौ चापि माद्रवत्याः सुतौ च तौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102308, "chapter_id": 3211, "verse_number": "१४-६७-६", "content_sanskrit": "श्रुत्वाऽभिमन्योस्तनयं जातं च मृतमेव च।\nमुषिता इव वार्ष्णेय द्रोणपुत्रेण पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102309, "chapter_id": 3211, "verse_number": "१४-६७-७", "content_sanskrit": "अभिमन्युः प्रियः कृष्ण पितॄणां नात्र संशयः।\nते श्रुत्वा किंनु वक्ष्यन्ति द्रोणपुत्रास्त्रनिर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102310, "chapter_id": 3211, "verse_number": "१४-६७-८", "content_sanskrit": "भविता नः परं दुःखं किंनु मन्ये जनार्दन।\nअभिमन्योः सुतं कृष्ण मृतं जातमरिंदम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102311, "chapter_id": 3211, "verse_number": "१४-६७-९", "content_sanskrit": "साऽहं प्रसादये कृष्ण त्वामद्य शिरसा नता।\nपृथेयं द्रौपदी चैव ताः पश्य पुरुषोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102312, "chapter_id": 3211, "verse_number": "१४-६७-१०", "content_sanskrit": "यदा द्रोणसुतो गर्भान्पाण्डूनां हन्ति माधव।\nतदा किल त्वया द्रौणिः क्रुद्धेनोक्तोऽरिमर्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102313, "chapter_id": 3211, "verse_number": "१४-६७-११", "content_sanskrit": "अकामं त्वां करिष्यामि ब्रह्मबन्धो नराधम।\nअहं संजीवयिष्यामि किरीटितनयात्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102314, "chapter_id": 3211, "verse_number": "१४-६७-१२", "content_sanskrit": "इत्येद्वचनं श्रुत्वा जानानाऽहं बलं तव।\nप्रसादये त्वां दुर्धर्ष जीवतामभिमन्युजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102315, "chapter_id": 3211, "verse_number": "१४-६७-१३", "content_sanskrit": "यद्येतत्त्वं प्रतिश्रुत्य न करोषि वच शुभम्।\nसकलं वृष्णिशार्दूल मृतां मामवधारय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102316, "chapter_id": 3211, "verse_number": "१४-६७-१४", "content_sanskrit": "अभिमन्योः सुतो वीर न संजीवति यद्ययम्।\nजीवति त्वयि दुर्धर्ष किं करिष्याम्यहं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102317, "chapter_id": 3211, "verse_number": "१४-६७-१५", "content_sanskrit": "संजीवयैनं दुर्धर्ष मृतं त्वमभिमन्युजम्।\nसदृशाक्षसुतं वीर सस्यं वर्षन्निवांम्बुदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102318, "chapter_id": 3211, "verse_number": "१४-६७-१६", "content_sanskrit": "त्वं हि केशव धर्मात्मा सत्यवान्सत्यविक्रमः।\nस तां वाचमृतां कर्तुमर्हसि त्वमरिंदम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102319, "chapter_id": 3211, "verse_number": "१४-६७-१७", "content_sanskrit": "इच्छन्नपि हि लोकांस्त्रीञ्जीवयेथा मृतानिमान्।\nकिं पुनर्दयितं जातं स्वस्रीयस्यात्मजं मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102320, "chapter_id": 3211, "verse_number": "१४-६७-१८", "content_sanskrit": "प्रभावज्ञाऽस्मि ते कृष्ण तस्मात्त्वां याचयाम्यहम्।\nकुरुष्व पाण्डुपुत्राणामिमं परमनुग्रहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102321, "chapter_id": 3211, "verse_number": "१४-६७-१९", "content_sanskrit": "स्वसेति वा महाबाहो हतपुत्रेति वा पुनः।\nप्रपन्ना मामियं चेति दयां कर्तुमिहार्हसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102322, "chapter_id": 3211, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वि सप्तषष्टितमोऽध्यायः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]