[{"id": 2051549, "chapter_id": 2138, "verse_number": "७-६५-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2051550, "chapter_id": 2138, "verse_number": "७-६५-१", "content_sanskrit": "शशिबिन्दुं च राजानं मृतं सृञ्जय शुश्रुम।\nय ईजे विविधैर्यज्ञैः श्रीमान्सत्यपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2051551, "chapter_id": 2138, "verse_number": "७-६५-२", "content_sanskrit": "तस्य भार्यासहस्राणां शतमासीन्महात्मनः।\nएकैकस्यां च भार्यायां सहस्रं तनयाभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2051552, "chapter_id": 2138, "verse_number": "७-६५-३", "content_sanskrit": "ते कुमाराः पराक्रान्ताः सर्वे नियुतयाजिनः।\nराजानः क्रतुभिर्मुख्यैरीजाना वेदपारगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2051553, "chapter_id": 2138, "verse_number": "७-६५-४", "content_sanskrit": "हिरण्यकवचाः सर्वे सर्वे चोत्तमधन्विनः।\nसर्वेऽश्वमेधैरीजानाः कुमाराः शाशिबिन्दवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2051554, "chapter_id": 2138, "verse_number": "७-६५-५", "content_sanskrit": "तानश्वमेधे राजेन्द्रो ब्राह्मणेभ्योददत्पिता।\nशतंशतं रथगजा एकैकं पृष्ठतोऽन्वयुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2051555, "chapter_id": 2138, "verse_number": "७-६५-६", "content_sanskrit": "राजपुत्रं तदा कन्यास्तपनीयस्वलङ्कृताः।\nकन्याङ्कन्यां शतं नागा नागेनागे शतं रथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2051556, "chapter_id": 2138, "verse_number": "७-६५-७", "content_sanskrit": "रथेरथे शतं चाश्वा बलिनो हेममालिनः।\nअश्वेअश्वे गोसहस्रं गवां पञ्चाशदाविकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2051557, "chapter_id": 2138, "verse_number": "७-६५-८", "content_sanskrit": "एतद्धनमपर्याप्तमश्वमेधे महामस्वे।\nशशिबिन्दुर्महाभागो ब्राह्मणेभ्यो ह्यमन्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2051558, "chapter_id": 2138, "verse_number": "७-६५-९", "content_sanskrit": "वार्क्षाश्च यूपा यावन्त अश्वमेधे महामखे।\nते तथैव पुनश्चान्ये तावन्तः काञ्चनाभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2051559, "chapter_id": 2138, "verse_number": "७-६५-१०", "content_sanskrit": "भक्ष्यान्नपाननिचयाः पर्वताः क्रोशमुच्छ्रिताः।\nतस्याश्वमेधे निर्वृत्ते राज्ञः शिष्टास्त्रयोदश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2051560, "chapter_id": 2138, "verse_number": "७-६५-११", "content_sanskrit": "तुष्टपुष्टजनाकीर्णां शान्तविघ्नामनामयाम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2051561, "chapter_id": 2138, "verse_number": "७-६५-११", "content_sanskrit": "शशिबिन्दुरिमां भूमिं चिरं भुक्त्वा दिवं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2051562, "chapter_id": 2138, "verse_number": "७-६५-१२", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया।\nपुत्रात्पुण्यतरस्तुभ्यं मा पुत्रमनुतप्यथाः।\nअयज्वानमदक्षिण्यमभि श्वैत्येत्युदाहरत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2051563, "chapter_id": 2138, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि अभिमन्युवधपर्वणि षोडशराजकीये पञ्चषष्टितमोऽध्यायः॥ ६५ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-६५- त्रयोदशास्त्र निचयाः शिष्टाः॥ ५-६५- पञ्चषष्टितमोऽध्यायः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]