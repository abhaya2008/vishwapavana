[{"id": 6000238000, "chapter_id": 10238, "verse_number": null, "content_sanskrit": "अथ द्विचत्वारिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000238001, "chapter_id": 10238, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.001.m4a", "display_order": 2}, {"id": 6000238002, "chapter_id": 10238, "verse_number": "१०-४२-१", "content_sanskrit": "एवं चिन्तितसङ्कल्पो भगवान् मधुसूदनः।\nआससाद ह चाणूरं मुष्टिकं रोहिणीसुतः॥ १०/४२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.002.m4a", "display_order": 3, "topics": [{"text": "चाणूरमुष्टिकादिवधः", "range": "१–३३"}]}, {"id": 6000238003, "chapter_id": 10238, "verse_number": "१०-४२-२", "content_sanskrit": "आस्फोट्य हस्तौ हस्ताभ्यामूरू चैव परस्परम्।\nविसृज्य भूयः सङ्गम्य परिक्रम्य परस्परम्॥ १०/४२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.003.m4a", "display_order": 4}, {"id": 6000238004, "chapter_id": 10238, "verse_number": "१०-४२-३", "content_sanskrit": "हस्ताभ्यां हस्तयोर्बद्ध्वा पद्भ्यामेव च पादयोः।\nविचकर्षतुरन्योन्यं प्रसह्य विजिगीषया॥ १०/४२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.004.m4a", "display_order": 5}, {"id": 6000238005, "chapter_id": 10238, "verse_number": "१०-४२-४", "content_sanskrit": "अरत्नी द्वे अरत्निभ्यां जानुभ्यां चैव जानुनी।\nशिरः शीर्ष्णोरसोरस्तावन्योन्यमभिजघ्नतुः॥ १०/४२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.005.m4a", "display_order": 6}, {"id": 6000238006, "chapter_id": 10238, "verse_number": "१०-४२-५", "content_sanskrit": "परिभ्रामणविक्षेपपरिरम्भावपातनैः।\nउत्सर्पणापसर्पैश्चाप्यन्योन्यं प्रत्ययुध्यतम्॥ १०/४२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.006.m4a", "display_order": 7}, {"id": 6000238007, "chapter_id": 10238, "verse_number": "१०-४२-६", "content_sanskrit": "उत्थापनैरुन्नयनैश्चालनैः स्थापनैरपि।\nपरस्परं जिगीषन्तावन्योन्यमभिचक्रतुः॥ १०/४२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.007.m4a", "display_order": 8}, {"id": 6000238008, "chapter_id": 10238, "verse_number": "१०-४२-७", "content_sanskrit": "तद् बालबलवद्युद्धं समेताः सर्वयोषितः।\nऊचुः परस्परं प्रेक्ष्य सानुकम्पा वरूथशः॥ १०/४२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.008.m4a", "display_order": 9}, {"id": 6000238009, "chapter_id": 10238, "verse_number": "१०-४२-८", "content_sanskrit": "महानयं बताधर्म एषां राजसभासदाम्।\nये बालबलवद्युद्धं राज्ञोऽन्विच्छन्ति पश्यतः॥ १०/४२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.009.m4a", "display_order": 10}, {"id": 6000238010, "chapter_id": 10238, "verse_number": "१०-४२-९", "content_sanskrit": "क्‍व वज्रसारसर्वाङ्गौ मल्लौ शैलेन्द्रसन्निभौ।\nक्‍व चातिसुकुमाराङ्गौ किशोरौ नाप्तयौवनौ॥ १०/४२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.010.m4a", "display_order": 11}, {"id": 6000238011, "chapter_id": 10238, "verse_number": "१०-४२-१०", "content_sanskrit": "धर्मव्यतिक्रमो ह्यस्य समाजस्य ध्रुवं भवेत्।\nयत्राधर्मः समुत्तिष्ठेन्न स्थेयं तत्र कर्हिचित्॥ १०/४२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.011.m4a", "display_order": 12}, {"id": 6000238012, "chapter_id": 10238, "verse_number": "१०-४२-११", "content_sanskrit": "न सभां प्रविशेत् प्राज्ञः सभ्यदोषाननुस्मरन्।\nअब्रुवन् विब्रुवन्नज्ञो नरः किल्बिषमश्नुते॥ १०/४२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.012.m4a", "display_order": 13}, {"id": 6000238013, "chapter_id": 10238, "verse_number": "१०-४२-१२", "content_sanskrit": "वल्गतः शत्रुमभितः कृष्णस्य वदनाम्बुजम्।\nवीक्ष्यतां श्रमवार्युप्तं पद्मकोशमिवाम्बुभिः॥ १०/४२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.013.m4a", "display_order": 14}, {"id": 6000238014, "chapter_id": 10238, "verse_number": "१०-४२-१३", "content_sanskrit": "किं न पश्यत रामस्य मुखमाताम्रलोचनम्।\nमुष्टिकं प्रति सामर्षहाससंरम्भशोभनम्॥ १०/४२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.014.m4a", "display_order": 15}, {"id": 6000238015, "chapter_id": 10238, "verse_number": "१०-४२-१४", "content_sanskrit": "पुण्या बत व्रजभुवो यदयं नृलिङ्गगूढः पुराणपुरुषो वनचित्रमाल्यः।\nगाश्चारयन् सहबलः क्‍वणयंश्च वेणुं विक्रीडयाऽञ्चति गिरावमरार्चिताङ्घ्रिः॥ १०/४२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.015.m4a", "display_order": 16}, {"id": 6000238016, "chapter_id": 10238, "verse_number": "१०-४२-१५", "content_sanskrit": "गोप्यस्तपः किमचरन् यदमुष्य रूपं लावण्यसारमथनोत्थमनन्यसिद्धम्।\nदृग्भिः पिबन्त्यनुसवाभिनवं दुरापमेकान्तधाम यशसः श्रिय ईश्वरस्य॥ १०/४२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.016.m4a", "display_order": 17}, {"id": 6000238017, "chapter_id": 10238, "verse_number": "१०-४२-१६", "content_sanskrit": "या दोहनेऽवहनने मथनोपजल्पप्रेङ्खेङ्खनार्भरुदितोक्षणमज्जनादौ।\nगायन्ति चैनमनुरक्तधियोऽश्रुकण्ठ्यः पुण्या व्रजस्‍त्रिय उरुक्रमचित्तयामाः॥ १०/४२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.017.m4a", "display_order": 18}, {"id": 6000238018, "chapter_id": 10238, "verse_number": "१०-४२-१७", "content_sanskrit": "प्रातर्व्रजाद् व्रजत आविशतश्च सायं गोभिः समंक्‍वणयतोऽस्य निशम्य वेणुम्।\nनिर्गत्य तूर्णमबलाः पथि भूरिपुण्याः पश्यन्ति सस्मितमुखं सदयावलोकम्॥ १०/४२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.018.m4a", "display_order": 19}, {"id": 6000238019, "chapter_id": 10238, "verse_number": "१०-४२-१८", "content_sanskrit": "एवं प्रभाषमाणासु स्‍त्रीषु योगेश्वरो हरिः।\nशत्रुं हन्तुं मनश्चक्रे भगवान् भरतर्षभ॥ १०/४२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.019.m4a", "display_order": 20}, {"id": 6000238020, "chapter_id": 10238, "verse_number": "१०-४२-१९", "content_sanskrit": "तैस्तैर्नियुद्धविधिभिर्विविधैरच्युतेतरौ।\nयुयुधाते तथाऽऽन्योन्यं तथैव बलमुष्टिकौ॥ १०/४२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.020.m4a", "display_order": 21}, {"id": 6000238021, "chapter_id": 10238, "verse_number": "१०-४२-२०", "content_sanskrit": "भगवद्गात्रनिष्पातैर्वज्रनिष्पेषनिष्ठुरैः।\nचाणूरो भज्यमानाङ्गो मुहुर्ग्लानिमवाप ह॥ १०/४२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.021.m4a", "display_order": 22}, {"id": 6000238022, "chapter_id": 10238, "verse_number": "१०-४२-२१", "content_sanskrit": "स श्येनवेग उत्पत्य मुष्टीकृत्य करावुभौ।\nभगवन्तं वासुदेवं क्रुद्धो वक्षस्यताडयत्॥ १०/४२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.022.m4a", "display_order": 23}, {"id": 6000238023, "chapter_id": 10238, "verse_number": "१०-४२-२२", "content_sanskrit": "नाचलत् तत्प्रहारेण स्रजा हत इव द्विपः।\nबाह्वोर्निगृह्य चाणूरं बहुशो भ्रामयन् हरिः॥ १०/४२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.023.m4a", "display_order": 24}, {"id": 6000238024, "chapter_id": 10238, "verse_number": "१०-४२-२३", "content_sanskrit": "भूपृष्ठे पोथयामास तरसा क्षीणजीवितम्।\nविस्रस्ताकल्पकेशस्रगिन्द्रध्वज इवापतत्॥ १०/४२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.024.m4a", "display_order": 25}, {"id": 6000238025, "chapter_id": 10238, "verse_number": "१०-४२-२४", "content_sanskrit": "तथैव मुष्टिकः पूर्वं स्वमुष्ट्याऽभिहतेन वै।\nबलभद्रेण बलिना तलेनाभिहतो भृशम्॥ १०/४२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.025.m4a", "display_order": 26}, {"id": 6000238026, "chapter_id": 10238, "verse_number": "१०-४२-२५", "content_sanskrit": "प्रवेपितः स रुधिरमुद्वमन् मुखतोऽर्दितः।\nव्यसुः पपातोर्व्युपस्थे वाताहत इवाङ्घ्रिपः॥ १०/४२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.026.m4a", "display_order": 27}, {"id": 6000238027, "chapter_id": 10238, "verse_number": "१०-४२-२६", "content_sanskrit": "ततः कूटमनुप्राप्तं रामः प्रहरतां वरः।\nअवधील्लीलया राजन् सावज्ञं वाममुष्टिना॥ १०/४२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.027.m4a", "display_order": 28}, {"id": 6000238028, "chapter_id": 10238, "verse_number": "१०-४२-२७", "content_sanskrit": "तथैव हि छलः कृष्णपदापहतशीर्षकः।\nद्विधा विदीर्णः कोसलक उभावपि निपेततुः॥ १०/४२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.028.m4a", "display_order": 29}, {"id": 6000238029, "chapter_id": 10238, "verse_number": "१०-४२-२८", "content_sanskrit": "चाणूरे मुष्टिके कूटे छले कोसलके हते।\nशेषाः प्रदुद्रुवुर्मल्लाः सर्वे प्राणपरीप्सवः॥ १०/४२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.029.m4a", "display_order": 30}, {"id": 6000238030, "chapter_id": 10238, "verse_number": "१०-४२-२९", "content_sanskrit": "गोपान् वयस्यानाकृष्य तैः संसृज्य विजह्रतुः।\nवाद्यमानेषु तूर्येषु वल्गन्तौ रुतनूपुरौ॥ १०/४२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.030.m4a", "display_order": 31}, {"id": 6000238031, "chapter_id": 10238, "verse_number": "१०-४२-३०", "content_sanskrit": "जनाः प्रजहृषुः सर्वे कर्मणा रामकृष्णयोः।\nऋते कंसं विप्रमुख्याः साधवः साधु साध्विति॥ १०/४२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.031.m4a", "display_order": 32}, {"id": 6000238032, "chapter_id": 10238, "verse_number": "१०-४२-३१", "content_sanskrit": "हतेषु मल्लवर्येषु विद्रुतेषु च भोजराट्।\nन्यवारयत् स्वतूर्याणि वाक्यं चेदमुवाच ह॥ १०/४२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.032.m4a", "display_order": 33}, {"id": 6000238033, "chapter_id": 10238, "verse_number": "१०-४२-३२", "content_sanskrit": "निस्सारयत दुर्वृत्तौ वसुदेवात्मजौ पुरात्।\nधनं हरत गोपानां नन्दं बध्नीत दुर्मतिम्॥ १०/४२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.033.m4a", "display_order": 34}, {"id": 6000238034, "chapter_id": 10238, "verse_number": "१०-४२-३३", "content_sanskrit": "वसुदेवस्तु दुर्मेधा हन्यतामाश्वसत्तमः।\nउग्रसेनः पिता चापि सानुगः परपक्षगः॥ १०/४२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.034.m4a", "display_order": 35}, {"id": 6000238035, "chapter_id": 10238, "verse_number": "१०-४२-३४", "content_sanskrit": "एवं विकत्थमाने वै कंसे प्रकुपितोऽव्ययः।\nलघिम्नोत्पत्य तरसा मञ्चमुत्तुङ्गमारुहत्॥ १०/४२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.035.m4a", "display_order": 36, "topics": [{"text": "कंसवधः", "range": "३४–३९"}]}, {"id": 6000238036, "chapter_id": 10238, "verse_number": "१०-४२-३५", "content_sanskrit": "तमाविशन्तमालोक्य मृत्युमात्मन आसनात्।\nमनस्वी सहसोत्थाय जगृहे सोऽसिचर्मणी॥ १०/४२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.036.m4a", "display_order": 37}, {"id": 6000238037, "chapter_id": 10238, "verse_number": "१०-४२-३६", "content_sanskrit": "तं खड्गपाणिं विचरन्तमाशु श्येनं यथा दक्षिणसव्यमम्बरे।\nसमग्रहीद् दुर्विषहोग्रतेजा यथोरगं तार्क्ष्यसुतः प्रसह्य॥ १०/४२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.037.m4a", "display_order": 38}, {"id": 6000238038, "chapter_id": 10238, "verse_number": "१०-४२-३७", "content_sanskrit": "प्रगृह्य केशेषु चलत्किरीटं निपात्य रङ्गोपरि तुङ्गमञ्चात्।\nतस्योपरिष्टात् स्वयमब्जनाभः पपात विश्वाश्रय आत्मतन्त्रः॥ १०/४२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.038.m4a", "display_order": 39}, {"id": 6000238039, "chapter_id": 10238, "verse_number": null, "content_sanskrit": "कंसोऽपि कृष्णेन जगत्त्रयैकनिवासभूतेन निपात्य सोऽधः।\nतेनात्मतन्त्रेण च पीडितोऽसुं तत्याज राजन् निमिषान्तरेण॥ १०/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.039.m4a", "display_order": 40}, {"id": 6000238040, "chapter_id": 10238, "verse_number": "१०-४२-३८", "content_sanskrit": "कंसं परेतं विचकर्ष भूमौ हरिर्यथेभं जगतो विपश्यतः।\nहाहेतिशब्दः सुमहांस्तदाऽभूदुदीरितः सर्वजनैर्नरेन्द्र॥ १०/४२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.040.m4a", "display_order": 41}, {"id": 6000238041, "chapter_id": 10238, "verse_number": "१०-४२-३९", "content_sanskrit": "स नित्यदोद्विग्नधिया तमीश्वरं पिबन्नदन् वा विचरन् स्वपन् श्वसन्।\nददर्श चक्रायुधमग्रतो यतस्तदेव रूपं दुरवापमाप॥ १०/४२/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.041.m4a", "display_order": 42}, {"id": 6000238042, "chapter_id": 10238, "verse_number": "१०-४२-४०", "content_sanskrit": "तस्यानुजा भ्रातरोऽष्टौ कङ्कन्यग्रोधकादयः।\nअभ्यधावन्नतिक्रुद्धा भ्रातुर्निर्वेशकारिणः॥ १०/४२/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.042.m4a", "display_order": 43, "topics": [{"text": "कंसानुजानां वधः", "range": "४०–४१"}]}, {"id": 6000238043, "chapter_id": 10238, "verse_number": "१०-४२-४१", "content_sanskrit": "तथाऽतिरभसांस्तांस्तु संयतान् रोहिणीसुतः।\nअहन् परिघमुद्यम्य पशूनिव मृगाधिपः॥ १०/४२/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.043.m4a", "display_order": 44}, {"id": 6000238044, "chapter_id": 10238, "verse_number": "१०-४२-४२", "content_sanskrit": "नेदुर्दुन्दुभयो व्योम्नि ब्रह्मेशाद्या विभूतयः।\nपुष्पैः किरन्तस्तं प्रीताः शशंसुर्ननृतुः स्‍त्रियः॥ १०/४२/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.044.m4a", "display_order": 45, "topics": [{"text": "कंसस्त्रीणां समाश्वासनम्", "range": "४२–४९"}]}, {"id": 6000238045, "chapter_id": 10238, "verse_number": "१०-४२-४३", "content_sanskrit": "तेषां स्‍त्रियो महाराज सुहृन्मरणदुःखिताः।\nतत्राभीयुर्विनिघ्नन्त्यः स्वशीर्षाण्यश्रुलोचनाः॥ १०/४२/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.045.m4a", "display_order": 46}, {"id": 6000238046, "chapter_id": 10238, "verse_number": "१०-४२-४४", "content_sanskrit": "शयानान् वीरशय्यायां पतीनालिङ्ग्य शोचतीः।\nविलेपुः सुस्वरं नार्यो विसृजन्त्यो मुहुः शुचः॥ १०/४२/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.046.m4a", "display_order": 47}, {"id": 6000238047, "chapter_id": 10238, "verse_number": "१०-४२-४५", "content_sanskrit": "हा नाथ प्रिय धर्मज्ञ करुणानाथवत्सल।\nत्वया हतेन निहता वयं ते सगृहप्रजाः॥ १०/४२/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.047.m4a", "display_order": 48}, {"id": 6000238048, "chapter_id": 10238, "verse_number": "१०-४२-४६", "content_sanskrit": "त्वया विरहिता पत्या पुरीयं भरतर्षभ।\nन शोभते वयमिव निवृत्तोत्सवमङ्गला॥ १०/४२/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.048.m4a", "display_order": 49}, {"id": 6000238049, "chapter_id": 10238, "verse_number": "१०-४२-४७", "content_sanskrit": "अनागसां त्वं भूतानां कृतवान् द्रोहमुल्बणम्।\nतेनेमां भो दशां नीतो भूतध्रुक् को लभेत शम्॥ १०/४२/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.049.m4a", "display_order": 50}, {"id": 6000238050, "chapter_id": 10238, "verse_number": "१०-४२-४८", "content_sanskrit": "सर्वेषामिह भूतानामेष हि प्रभवाप्ययः।\nगोप्ता च तदवध्यायी न क्‍वचित् सुखमेधते॥ १०/४२/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.050.m4a", "display_order": 51}, {"id": 6000238051, "chapter_id": 10238, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.051.m4a", "display_order": 52}, {"id": 6000238052, "chapter_id": 10238, "verse_number": "१०-४२-४९", "content_sanskrit": "राजयोषित आश्वास्य भगवान् लोकभावनः।\nयामाहुर्लौकिकीं संस्थां हतानां समकारयत्॥ १०/४२/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.052.m4a", "display_order": 53}, {"id": 6000238053, "chapter_id": 10238, "verse_number": "१०-४२-५०", "content_sanskrit": "मातरं पितरं चैव मोचयित्वाऽथ बन्धनात्।\nरामकृष्णौ ववन्दाते शिरसाऽऽस्पृश्य पादयोः॥ १०/४२/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.053.m4a", "display_order": 54, "topics": [{"text": "पित्रोर्बन्धनान्मोचनम्", "range": "५०–५१"}]}, {"id": 6000238054, "chapter_id": 10238, "verse_number": "१०-४२-५१", "content_sanskrit": "देवकी वसुदेवश्च विज्ञाय जगदीश्वरौ।\nकृतसंवन्दनौ पुत्रौ सस्वजाते न शङ्कितौ॥ १०/४२/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_042/BhP_10.042.054.m4a", "display_order": 55}, {"id": 6000238055, "chapter_id": 10238, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे द्विचत्वारिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]