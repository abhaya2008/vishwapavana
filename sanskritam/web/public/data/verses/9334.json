[{"id": 40020426, "chapter_id": 9334, "verse_number": "1", "content_sanskrit": "ततस्ताँल्लक्ष्य वित्रस्तान्यक्षेन्द्रांश्च सहस्रशः । धनाध्यक्षो महायक्षं माणिचारमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40020427, "chapter_id": 9334, "verse_number": "2", "content_sanskrit": "रावणं जहि यक्षेन्द्र दुर्वृत्तं पापचेतसम् । शरणं भव वीराणां यक्षाणां युद्धशालिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40020428, "chapter_id": 9334, "verse_number": "3", "content_sanskrit": "एवमुक्तो महाबाहुर्माणिभद्रः सुदुर्जयः । वृतो यक्षसहस्रैस्तु चतुर्भिः समयोधयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40020429, "chapter_id": 9334, "verse_number": "4", "content_sanskrit": "ते गदामुसलप्रासैः शक्तितोमरमुद्गरैः । अभिघ्नन्तस्तदा यक्षा राक्षसान्समुपाद्रवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40020430, "chapter_id": 9334, "verse_number": "5", "content_sanskrit": "कुर्वन्तस्तुमुलं युद्धं चरन्तः श्येनवल्लघु । बाढं प्रयच्छन्नेच्छामि दीयतामिति भाषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40020431, "chapter_id": 9334, "verse_number": "6", "content_sanskrit": "ततो देवाः सगन्धर्वा ऋषयो ब्रह्मवादिनः । दृष्ट्वा तत्तुमुलं युद्धं परं विस्मयमागमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40020432, "chapter_id": 9334, "verse_number": "7", "content_sanskrit": "यक्षाणां तु प्रहस्तेन सहस्रं निहतं रणे । महोदरेण चानिन्द्यं सहस्रमपरं हतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40020433, "chapter_id": 9334, "verse_number": "8", "content_sanskrit": "क्रुद्धेन च तदा राजन्मारीचेन युयुत्सुना । निमेषान्तरमात्रेण द्वे सहस्रे निपातिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40020434, "chapter_id": 9334, "verse_number": "9", "content_sanskrit": "क्व च यक्षार्जवं युद्धं क्व च मायाबलाश्रयम् । रक्षसां पुरुषव्याघ्र तेन ते ऽभ्यधिका युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40020435, "chapter_id": 9334, "verse_number": "10", "content_sanskrit": "धूम्राक्षेण समागम्य माणिभद्रो महारणे । मुसलेनोरसि क्रोधात्तडितो न च कम्पितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40020436, "chapter_id": 9334, "verse_number": "11", "content_sanskrit": "ततो गदां समाविध्य माणिभद्रेण राक्षसः । धूम्राक्षस्ताडितो मूर्ध्नि विह्वलः स पपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40020437, "chapter_id": 9334, "verse_number": "12", "content_sanskrit": "धूम्राक्षं ताडितं दृष्ट्वा पतितं शोणितोक्षितम् । अभ्यधावत सङ्ग्रामे माणिभद्रं दशाननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40020438, "chapter_id": 9334, "verse_number": "13", "content_sanskrit": "तं क्रुद्धमभिधावन्तं माणिभद्रो दशाननम् । शक्तिभिस्ताडयामास तिसृभिर्यक्षपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40020439, "chapter_id": 9334, "verse_number": "14", "content_sanskrit": "ताडितो माणिभद्रस्य मुकुटे प्राहरद्रणे । तस्य तेन प्रहारेम मुकुटं पार्श्वमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40020440, "chapter_id": 9334, "verse_number": "15", "content_sanskrit": "ततः संयुध्यमानेन विष्टब्धो न व्यकम्पत । तदाप्रभृति यक्षो ऽसौ पार्श्वमौलिरिति स्मृतः । सन्नादः सुमहान्राजंस्तस्मिन्शैले ऽभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40020441, "chapter_id": 9334, "verse_number": "16", "content_sanskrit": "ततो दूरात्प्रददृशे धनाध्यक्षो गदाधरः । शुक्रप्रौष्ठपदाभ्यां च पद्मशङ्खसमावृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40020442, "chapter_id": 9334, "verse_number": "17", "content_sanskrit": "स दृष्ट्वा भ्रातरं सङ्ख्ये शापाद्विभ्रष्टगौरवम् । उवाच वचनं धीमान्युक्तं पैतामहे कुले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40020443, "chapter_id": 9334, "verse_number": "18", "content_sanskrit": "यन्मया वार्यमाणस्त्वं नावगच्छसि दुर्मते । पश्चादस्य फलं प्राप्य ज्ञास्यसे निरयं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40020444, "chapter_id": 9334, "verse_number": "19", "content_sanskrit": "यो हि मोहाद्विषं पीत्वा नावगच्छति दुर्मतिः । स तस्य परिणामान्ते जानीते कर्मणः फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40020445, "chapter_id": 9334, "verse_number": "20", "content_sanskrit": "देवता नाभिनन्दन्ति धर्मयुक्तेन केनचित् । येन त्वमीदृशं भावं नीतस्सन्नावबुद्ध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40020446, "chapter_id": 9334, "verse_number": "21", "content_sanskrit": "मातरं पितरं यो हि आचार्यं चावमन्यते । स पश्यति फलं तस्य प्रेतराजवशं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40020447, "chapter_id": 9334, "verse_number": "22", "content_sanskrit": "अध्रुवे हि शरीरे यो न करोति तपोर्जनम् । स पश्चात्तप्यते मूढो मृतो दृष्ट्वा ऽ ऽत्मनो गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40020448, "chapter_id": 9334, "verse_number": "23", "content_sanskrit": "धर्माद्राज्यं धनं सौख्यमधर्माद्दुःखमेव च । तस्माद्धर्मं सुखार्थाय कुर्यात्पापं विसर्जयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40020449, "chapter_id": 9334, "verse_number": "24", "content_sanskrit": "पापस्य हि फलं दुःखं तद्भोक्तव्यमिहात्मना । तस्मादात्मापघातार्थं मूढः पापं करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40020450, "chapter_id": 9334, "verse_number": "25", "content_sanskrit": "कस्य चिन्न हि दुर्बुद्धेश्छन्दतो जायते मतिः । देवं चेष्टयते सर्वं हतो दैवेन हन्यते । यादृशं कुरुते कर्म तादृशं फलमश्नुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40020451, "chapter_id": 9334, "verse_number": "26", "content_sanskrit": "बुद्धिरूपं फलं पुत्राञ्छौर्यं धीरत्वमेव च । प्राप्नुवन्ति नरा लोके निर्जितं पुण्यकर्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40020452, "chapter_id": 9334, "verse_number": "27", "content_sanskrit": "एवं निरयगामी त्वं यस्य ते मतिरीदृशी । न त्वां समभिभाषिष्ये ऽसद्वृत्तेष्वेव निर्णयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40020453, "chapter_id": 9334, "verse_number": "28", "content_sanskrit": "एवमुक्तास्ततस्तेन तस्यामात्याः समाहताः । मारीचप्रमुखाः सर्वे विमुखा विप्रदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40020454, "chapter_id": 9334, "verse_number": "29", "content_sanskrit": "ततस्तेन दशग्रीवो यक्षेन्द्रेण महात्मना । गदयाभिहतो मूर्ध्नि न च स्थानात्प्रकम्पितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40020455, "chapter_id": 9334, "verse_number": "30", "content_sanskrit": "ततस्तौ राम निघ्नन्तौ तदान्योन्यं महामृधे । न विह्वलौ न च श्रान्तौ बभूवतुरमर्षणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40020456, "chapter_id": 9334, "verse_number": "31", "content_sanskrit": "आग्नेयमस्त्रं तस्मै स मुमोच धनदस्तदा । राक्षसेन्द्रो वारुणेन तदस्त्रं प्रत्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40020457, "chapter_id": 9334, "verse_number": "32", "content_sanskrit": "ततो मायां प्रविष्टो ऽसौ राक्षसीं राक्षसेश्वरः । रूपाणां शतसाहस्रं विनाशाय चकार च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40020458, "chapter_id": 9334, "verse_number": "33", "content_sanskrit": "व्याघ्रो वराहो जीमूतः पर्वतः सागरो द्रुमः । यक्षो दैत्यस्वरूपी च सो ऽदृश्यत दशाननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40020459, "chapter_id": 9334, "verse_number": "34", "content_sanskrit": "बहूनि च करोति स्म दृश्यन्ते न त्वसौ ततः । प्रतिगृह्य ततो राम महदस्त्रं दशाननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40020460, "chapter_id": 9334, "verse_number": "35", "content_sanskrit": "जघान मूर्ध्नि धनदं व्याविद्ध्य महतीं गदाम् । एवं स तेनाभिहतो विह्वलः शोणितोक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40020461, "chapter_id": 9334, "verse_number": "36", "content_sanskrit": "कृत्तमूल इवाशोको निपपात धनाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40020462, "chapter_id": 9334, "verse_number": "37", "content_sanskrit": "ततः पद्मादिभिस्तत्र निधिभिः स तदा वृतः । धनदोच्छ्वासितस्तैस्तु वनमानीय नन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40020463, "chapter_id": 9334, "verse_number": "38", "content_sanskrit": "निर्जित्य राक्षसेन्द्रस्तं धनदं हृष्टमानसः । पुष्पकं तस्य जग्राह विमानं जयलक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40020464, "chapter_id": 9334, "verse_number": "39", "content_sanskrit": "काञ्चनस्तम्भसंवीतं वैडूर्यमणितोरणम् । मुक्ताजालप्रतिच्छन्नं सर्वकामफलद्रुमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40020465, "chapter_id": 9334, "verse_number": "40", "content_sanskrit": "मनोजवं कामगमं कामरूपं विहङ्गमम् । मणिकाञ्चनसोपानं तप्तकाञ्चनवेदिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40020466, "chapter_id": 9334, "verse_number": "41", "content_sanskrit": "देवोपवाह्यमक्षय्यं सदादृष्टिमनःसुखम् । बह्वाश्चर्यं भक्तिचित्रं ब्रह्मणा परिनिर्मितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40020467, "chapter_id": 9334, "verse_number": "42", "content_sanskrit": "निर्मितं सर्वकामैस्तु मनोहरमनुत्तमम् । न तु शीतं न चोष्णं च सर्वर्तुसुखदं शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40020468, "chapter_id": 9334, "verse_number": "43", "content_sanskrit": "स तं राजा समारुह्य कामगं वीर्यनिर्जितम् । जितं त्रिभुवनं मेने दर्पोत्सेकात्सुदुर्मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40020469, "chapter_id": 9334, "verse_number": "44", "content_sanskrit": "जित्वा वैश्रवणं देवं कैलासात्समवातरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40020470, "chapter_id": 9334, "verse_number": "45", "content_sanskrit": "स्वतेजसा विपुलमवाप्य तं जयं प्रतापवान्विमलकिरीटहारवान् । रराज वै परमविमानमास्थितो निशाचरः सदसि गतो यथानलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]