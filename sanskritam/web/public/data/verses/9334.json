[{"id": 5000334000, "chapter_id": 9334, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे द्विषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000334001, "chapter_id": 9334, "verse_number": "४-६२-१", "content_sanskrit": "एवमुक्त्वा मुनिश्रेष्ठमरुदं भृशदुःखितः।\nअथ ध्यात्वा मुहूर्तं च भगवानिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000334002, "chapter_id": 9334, "verse_number": "४-६२-२", "content_sanskrit": "पक्षौ च ते प्रपक्षौ च पुनरन्यौ भविष्यतः।\nचक्षुषी चैव प्राणाश्च विक्रमश्च बलं च ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000334003, "chapter_id": 9334, "verse_number": "४-६२-३", "content_sanskrit": "पुराणे सुमहत्कार्यं भविष्यं हि मया श्रुतम्।\nदृष्टं मे तपसा चैव श्रुत्वा च विदितं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000334004, "chapter_id": 9334, "verse_number": "४-६२-४", "content_sanskrit": "राजा दशरथो नाम कश्चिदिक्ष्वाकुवर्धनः।\nतस्य पुत्रो महातेजा रामो नाम भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000334005, "chapter_id": 9334, "verse_number": "४-६२-५", "content_sanskrit": "अरण्यं च सह भ्रात्रा लक्ष्मणेन गमिष्यति।\nतस्मिन्नर्थे नियुक्तः सन् पित्रा सत्यपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000334006, "chapter_id": 9334, "verse_number": "४-६२-६", "content_sanskrit": "नैर्ऋतो रावणो नाम तस्य भार्यां हरिष्यति।\nराक्षसेन्द्रो जनस्थाने अवध्यः सुरदानवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000334007, "chapter_id": 9334, "verse_number": "४-६२-७", "content_sanskrit": "सा च कामैः प्रलोभ्यन्ती भक्ष्यैर्भोज्यैश्च मैथिली।\nन भोक्ष्यति महाभागा दुःखमग्ना यशस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000334008, "chapter_id": 9334, "verse_number": "४-६२-८", "content_sanskrit": "परमान्नं च वैदेह्या ज्ञात्वा दास्यति वासवः।\nयदन्नममृतप्रख्यं सुराणामपि दुर्लभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000334009, "chapter_id": 9334, "verse_number": "४-६२-९", "content_sanskrit": "तदन्नं मैथिली प्राप्य विज्ञायेन्द्रादिदं त्विति।\nअग्रमुद‍्धृत्य रामाय भूतले निर्वपिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000334010, "chapter_id": 9334, "verse_number": "४-६२-१०", "content_sanskrit": "यदि जीवति मे भर्ता लक्ष्मणो वापि देवरः।\nदेवत्वं गच्छतोर्वापि तयोरन्नमिदं त्विति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000334011, "chapter_id": 9334, "verse_number": "४-६२-११", "content_sanskrit": "एष्यन्ति प्रेषितास्तत्र रामदूताः प्लवङ्गमाः।\nआख्येया राममहिषी त्वया तेभ्यो विहङ्गम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000334012, "chapter_id": 9334, "verse_number": "४-६२-१२", "content_sanskrit": "सर्वथा तु न गन्तव्यमीदृशः क्व गमिष्यसि।\nदेशकालौ प्रतीक्षस्व पक्षौ त्वं प्रतिपत्स्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000334013, "chapter_id": 9334, "verse_number": "४-६२-१३", "content_sanskrit": "उत्सहेयमहं कर्तुमद्यैव त्वां सपक्षकम्।\nइहस्थस्त्वं हि लोकानां हितं कार्यं करिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000334014, "chapter_id": 9334, "verse_number": "४-६२-१४", "content_sanskrit": "त्वयापि खलु तत् कार्यं तयोश्च नृपपुत्रयोः।\nब्राह्मणानां गुरूणां च मुनीनां वासवस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000334015, "chapter_id": 9334, "verse_number": "४-६२-१५", "content_sanskrit": "इच्छाम्यहमपि द्रष्टुं भ्रातरौ रामलक्ष्मणौ।\nनेच्छे चिरं धारयितुं प्राणांस्त्यक्ष्ये कलेवरम्।\nमहर्षिस्त्वब्रवीदेवं दृष्टतत्त्वार्थदर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000334016, "chapter_id": 9334, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे द्विषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]