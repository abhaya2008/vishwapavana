[{"id": 2008235, "chapter_id": 1160, "verse_number": "१-१६१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2008236, "chapter_id": 1160, "verse_number": "१-१६१-१", "content_sanskrit": "एतस्मिन्नेव काले तु यथासंप्रत्ययं कविः।\nविदुरः प्रेषयामास तद्वनं पुरुषं शुचिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2008237, "chapter_id": 1160, "verse_number": "१-१६१-२", "content_sanskrit": "आत्मनः पाण्डवानां च विश्वास्यं ज्ञातपूर्वकम्।\nगङ्गासंतरणार्थाय ज्ञाताभिज्ञानवाचिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2008238, "chapter_id": 1160, "verse_number": "१-१६१-३", "content_sanskrit": "स गत्वा तु यथोद्देशं पाण्डवान्ददृशे वने।\nजनन्या सह कौरव्याननयज्जाह्नवीतटम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2008239, "chapter_id": 1160, "verse_number": "१-१६१-४", "content_sanskrit": "विदितं तन्महाबुद्धेर्विदुरस्य महात्मनः।\nततस्त्रस्यापि चारेण चेष्टितं पापचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2008240, "chapter_id": 1160, "verse_number": "१-१६१-५", "content_sanskrit": "ततः प्रवासितो विद्वान्विदुरेण नरस्तदा।\nपार्थानां दर्शयामास मनोमारुतगामिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2008241, "chapter_id": 1160, "verse_number": "१-१६१-६", "content_sanskrit": "सर्ववातसहां नावं यन्त्रयुक्तां पताकिनीम्।\nशिवे भागीरथीतीरे नरैर्विस्रम्भिभिः कृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2008242, "chapter_id": 1160, "verse_number": "१-१६१-७", "content_sanskrit": "ततः पुनरथोवाच ज्ञापकं पूर्वचोदितम्।\nयुधिष्ठिर निबोधेयं संज्ञार्थं वचनं कवेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2008243, "chapter_id": 1160, "verse_number": "१-१६१-८", "content_sanskrit": "कक्षघ्नः शिशिरघ्नश्च महाकक्षे बिलौकसः।\nन हन्तीत्येवमात्मानं यो रक्षति स जीवति।\nबोद्धव्यमिति यत्प्राह विदुरस्तदिदं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2008244, "chapter_id": 1160, "verse_number": "१-१६१-९", "content_sanskrit": "तेन मां प्रेषितं विदिधि विश्वस्तं संज्ञयाऽनया।\nभूयश्चैवाह मां क्षत्ता विदुरः सर्वतोऽर्थवित्।\nअधिक्षिपन्धार्तराष्ट्रं सभ्रातृकमुदारधीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2008245, "chapter_id": 1160, "verse_number": "१-१६१-१०", "content_sanskrit": "कर्णं दुर्योधनं चैव भ्रातृभिः सहितं रणे।\nशकुनिं चैव कौन्तेय विजेताऽसि न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2008246, "chapter_id": 1160, "verse_number": "१-१६१-११x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2008247, "chapter_id": 1160, "verse_number": "१-१६१-११", "content_sanskrit": "पाण्डवाश्चापि गत्वाथ गङ्गायास्तीरमुत्तमम्।\nनिषादाधिपतिं वीरं दाशं परमधार्मिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2008248, "chapter_id": 1160, "verse_number": "१-१६१-१२", "content_sanskrit": "दीपिकाभिः कृतालोकं मार्गमाणं च पाण्डवान्।\nददृशुः पाण्डवेयास्ते नाविकं त्वरयाऽन्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2008249, "chapter_id": 1160, "verse_number": "१-१६१-१३", "content_sanskrit": "निषादस्तत्र कौन्तेयानभिज्ञानं न्यवेदयत्।\nविदुरस्य महाबुद्धेर्म्लेच्छभाषादि यत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2008250, "chapter_id": 1160, "verse_number": "१-१६१-१४x", "content_sanskrit": "नाविक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2008251, "chapter_id": 1160, "verse_number": "१-१६१-१४", "content_sanskrit": "विदुरेणास्मि सन्दिष्टो दत्त्वा बहु धनं महत्।\nगङ्गातीरे निविष्टस्त्वं पाण्डवांस्तारयेति ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2008252, "chapter_id": 1160, "verse_number": "१-१६१-१५", "content_sanskrit": "सोऽहं चतुर्दशीमद्य गङ्गाया अविदूरतः।\nचारेरन्वेषयाम्यस्मिन्वने मृगगणान्विते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2008253, "chapter_id": 1160, "verse_number": "१-१६१-१६", "content_sanskrit": "प्रभवन्तोऽथ भद्रं वो नावमारुह्य गम्यताम्।\nयुक्तारित्रपताकां च निश्छिद्रां मन्दिरोपमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2008254, "chapter_id": 1160, "verse_number": "१-१६१-१७", "content_sanskrit": "इयं वारिपथे युक्ता नौरप्सु सुखगामिनी।\nमोचयिष्यति वः सर्वानस्माद्देशान्न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2008255, "chapter_id": 1160, "verse_number": "१-१६१-१८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2008256, "chapter_id": 1160, "verse_number": "१-१६१-१८", "content_sanskrit": "अथ तान्व्यथितान्दृष्ट्वा सह मात्रा नरोत्तमान्।\nनावमारोप्य गङ्गायां प्रस्थितानब्रवीत्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2008257, "chapter_id": 1160, "verse_number": "१-१६१-१९", "content_sanskrit": "विदुरो मूर्ध्न्युपाघ्राय परिष्वज्य वचो मुहुः।\nअरिष्टं गच्छताव्यग्राः पन्थानमिति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2008258, "chapter_id": 1160, "verse_number": "१-१६१-२०", "content_sanskrit": "इत्युक्त्वा स तु तान्वीरान्पुमान्विदुरचोदितः।\nतारयामास राजेन्द्र गङ्गां नावा नरर्षभान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2008259, "chapter_id": 1160, "verse_number": "१-१६१-२१", "content_sanskrit": "तारयित्वा ततो गङ्गां पारं प्राप्तांश्च सर्वशः।\nजयाशिषः प्रयुज्याथ यथागतमगाद्धि सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2008260, "chapter_id": 1160, "verse_number": "१-१६१-२२", "content_sanskrit": "पाण्डवाश्च महात्मानः प्रतिसन्दिश्य वै कवेः।\nगङ्गामुत्तीर्य वेगेन जग्मुर्गूढमलक्षिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2008261, "chapter_id": 1160, "verse_number": "१-१६१-२३", "content_sanskrit": "ततस्ते तत्र तीर्त्वा तु गङ्गामुत्तुङ्गवीचिकाम्।\nजवेन प्रययुर्वीरा दक्षिणां दिशमास्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2008262, "chapter_id": 1160, "verse_number": "१-१६१-२४", "content_sanskrit": "विज्ञाय निशि पन्थानं नक्षत्रैर्दक्षिणामुखाः।\nवनाद्वनान्तरं राजन्गहनं प्रतिपेदिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2008263, "chapter_id": 1160, "verse_number": "१-१६१-२५", "content_sanskrit": "श्रान्तास्ततः पिपासार्ताः क्षुधिता भयकातराः।\nपुनरूचुर्महावीर्यं भीमसेनमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2008264, "chapter_id": 1160, "verse_number": "१-१६१-२६", "content_sanskrit": "इतः कष्टतरं किं नु यद्वयं गहने वने।\nदिशश्च न प्रजानीमो गन्तुं चैतेन शक्नुमः।\nतं च पापं न जानीमो दग्धो वाथ पुरोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2008265, "chapter_id": 1160, "verse_number": "१-१६१-२७", "content_sanskrit": "कथं नु विप्रमुच्येम भयादस्मादलक्षिताः।\nशीघ्रमस्मानुपादाय तथैव व्रज भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2008266, "chapter_id": 1160, "verse_number": "१-१६१-२८", "content_sanskrit": "त्वं हि नो बलवानेको यथा सततगस्तथा।\nइत्युक्तो धर्मराजेन भीमसेनो महाबलः।\nआदाय कुन्तीं भ्रातॄंश्च जगामाशु स पावनिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2008267, "chapter_id": 1160, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि जतुगृहपर्वणि एकषष्ट्यधिकशततमोऽध्यायः॥ १६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]