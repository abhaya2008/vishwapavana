[{"id": 900009252, "chapter_id": 8738, "verse_number": "28.1", "content_sanskrit": "‘‘उपक्रमोपसंहारावभ्यासोपूर्वता फलम् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009253, "chapter_id": 8738, "verse_number": "28.2", "content_sanskrit": "श्रुतिर्लिङ्गं समाख्या च वाक्यं प्रकरणं तथा..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009254, "chapter_id": 8738, "verse_number": "28.3", "content_sanskrit": "यच्चोक्तं वार्तिके– श्रुत्यादिषूत्तरोत्तरस्य पूर्वपूर्वानुमापकत्वेनैव प्रामाण्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009255, "chapter_id": 8738, "verse_number": "28.4", "content_sanskrit": "यच्च श्रुत्यादेर्लिङ्गादिबाधे उदाहरणमुक्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009256, "chapter_id": 8738, "verse_number": "28.5", "content_sanskrit": "प्राभाकरास्तु– श्रुत्यादीनां भाट्टोक्तान्येव लक्षणान्युदाहरणानि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]