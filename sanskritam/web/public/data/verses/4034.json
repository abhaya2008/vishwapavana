[{"id": 2140660, "chapter_id": 4034, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2140661, "chapter_id": 4034, "verse_number": "१", "content_sanskrit": "एतस्मिन्नन्तरे पार्थं न मूढात्मा व्यजानत ।\nविराटपुत्रः प्रमुखे पप्रच्छ पुनरेव तु\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2140662, "chapter_id": 4034, "verse_number": "२", "content_sanskrit": "सुवर्णरुचिराण्येषामायुधानि महात्मनाम् ।\nरुचिराणि प्रकाशन्ते पार्थानामाशुकारिणाम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2140663, "chapter_id": 4034, "verse_number": "३", "content_sanskrit": "क्व नु ते पाण्डवाः शूराः सङ्ग्रामेष्वपराजिताः ।\nयेषामिमानि दिव्यानि श्रिया दीप्यन्ति भान्ति च\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2140664, "chapter_id": 4034, "verse_number": "४", "content_sanskrit": "कस्मिन् वसन्ति ते देशे धर्मज्ञा बन्धुवत्सलाः ।\nक्व धर्मराजः कौरव्यो धर्मपुत्रो युधिष्ठिरः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2140665, "chapter_id": 4034, "verse_number": "५", "content_sanskrit": "भीमसेनार्जुनौ चापि सर्वे ते मम मातुलाः ।\nनकुलः सहदेवो वा सर्वास्त्रकुशलो रणे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2140666, "chapter_id": 4034, "verse_number": "६", "content_sanskrit": "सर्व एव महात्मानः सर्वामित्रविनाशनाः ।\nराज्यमक्षैः पराजित्य नः श्रूयन्ते वनं गताः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2140667, "chapter_id": 4034, "verse_number": "७", "content_sanskrit": "द्रौपदी चापि पाञ्चाली स्त्रीरत्नमिति विश्रुता ।\nजिता चाक्षैस्तदा कृष्णा तानेवान्वगमद् वने\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2140668, "chapter_id": 4034, "verse_number": "८", "content_sanskrit": "उत्सृज्य धर्म्यं राज्यं ते नः श्रूयन्ते वनं गताः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2140669, "chapter_id": 4034, "verse_number": "९", "content_sanskrit": "पाण्डवान् यदि जानीषे क्व नु ते धर्मचारिणः ।\nक्व चाद्य निवसन्तीति सत्यं ब्रूहि बृहन्नळे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2140670, "chapter_id": 4034, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2140671, "chapter_id": 4034, "verse_number": "१०", "content_sanskrit": "ततः प्रहस्य बीभत्सुः कौन्तेयः श्वेतवाहनः ।\nउवाच राजपुत्रं तमुत्तरं शृणु मे वचः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2140672, "chapter_id": 4034, "verse_number": "११", "content_sanskrit": "अहमस्म्यर्जुनो नाम्ना कङ्को नाम युधिष्ठिरः ।\nभीमसेनस्तु वललः पितुस्ते परिचारकः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2140673, "chapter_id": 4034, "verse_number": "१२", "content_sanskrit": "अश्वबन्धस्तु नकुलः सहदेवस्तु गोपतिः ।\nसैरन्ध्रीं द्रौपदीं विद्धि यदर्थे कीचको हतः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2140674, "chapter_id": 4034, "verse_number": "१३", "content_sanskrit": "भीमसेनेन दुर्वृत्तः सह भ्रातृभिराहवे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2140675, "chapter_id": 4034, "verse_number": "", "content_sanskrit": "उत्तरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2140676, "chapter_id": 4034, "verse_number": "१४", "content_sanskrit": "दश पार्थस्य नामानि श्रूयन्ते मे कथासु च ।\nब्रूहि त्वं यदि जानीषे श्रद्दधेयं वचस्तव\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2140677, "chapter_id": 4034, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2140678, "chapter_id": 4034, "verse_number": "१५", "content_sanskrit": "हन्त तर्हि तवाचक्षे दश नामानि यानि मे ।\nईशानो विदधे देवस्त्रिदिवस्येश्वरो दिवः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2140679, "chapter_id": 4034, "verse_number": "१६", "content_sanskrit": "अर्जुनः फल्गुनो जिष्णुः किरीटी श्वेतवाहनः ।\nबीभत्सुर्विजयः पार्थः सव्यसाची धनञ्जयः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2140680, "chapter_id": 4034, "verse_number": "१७", "content_sanskrit": "एतानि मम नामानि स्थापितानि सुरोत्तमैः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2140681, "chapter_id": 4034, "verse_number": "", "content_sanskrit": "उत्तरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2140682, "chapter_id": 4034, "verse_number": "१८", "content_sanskrit": "गुणतो दश नामानि समवेतानि पाण्डवे ।\nचरन्ति लोके ख्यातानि विदितानि ममानघ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2140683, "chapter_id": 4034, "verse_number": "१९", "content_sanskrit": "केनासि विजयो नाम केनासि श्वेतवाहनः ।\nसव्यसाचीति केनासि जिष्णुर्बीभत्सुरेव च\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2140684, "chapter_id": 4034, "verse_number": "२०", "content_sanskrit": "अर्जुनः फल्गुनः पार्थः किरीटी श्वेतवाहनः ।\nधनञ्जयश्च केनासि शीघ्रं वद बृहन्नळे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2140685, "chapter_id": 4034, "verse_number": "२१", "content_sanskrit": "श्रुता मे तस्य वीरस्य केवला नामहेतवः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2140686, "chapter_id": 4034, "verse_number": "२२", "content_sanskrit": "तत्सर्वं यदि मे ब्रूयाः श्रद्दध्यां सर्वमेव ते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2140687, "chapter_id": 4034, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2140688, "chapter_id": 4034, "verse_number": "२३", "content_sanskrit": "सर्वान् जनपदान् जित्वा धनान्याच्छिद्य सर्वशः ।\nमध्ये धनस्य तिष्ठन्तं तेनाहुर्मां धनञ्जयम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2140689, "chapter_id": 4034, "verse_number": "२४", "content_sanskrit": "अभिप्रयामि सङ्ग्रामे यदाऽहं युद्धदुर्मदान् ।\nअजित्वा न निवर्तेयं तेन मां विजयं विदुः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2140690, "chapter_id": 4034, "verse_number": "२५", "content_sanskrit": "श्वेताः काञ्चनसन्नाहा रथे युज्यन्ति मे हयाः ।\nशत्रुभिर्युध्यमानस्य तेनाहं श्वेतवाहनः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2140691, "chapter_id": 4034, "verse_number": "२६", "content_sanskrit": "किरीटं सूर्यसङ्काशं भ्राजते मे शिरोगतम् ।\nरणमध्ये रथस्थस्य सूर्यपावकसन्निभम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2140692, "chapter_id": 4034, "verse_number": "२७", "content_sanskrit": "अच्छेद्यं रुचिरं चित्रं जाम्बूनदपरिष्कृतम् ।\nइन्द्रदत्तमनाहार्यं तेनाहुर्मां किरीटिनम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2140693, "chapter_id": 4034, "verse_number": "२८", "content_sanskrit": "न कुर्यां कर्म बीभत्सं युध्यमानः कथञ्चन ।\nतेन देवमनुष्येषु बीभत्सुरिति मां विदुः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2140694, "chapter_id": 4034, "verse_number": "२९", "content_sanskrit": "उभौ मे तुल्यकर्माणौ गाण्डीवस्य विकर्षणे ।\nभुजौ मे भवतः सङ्खे परसैन्यविनाशनौ\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2140695, "chapter_id": 4034, "verse_number": "३०", "content_sanskrit": "तयोः सव्योऽधिकस्तस्मात् सव्यसाचीति मां विदुः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2140696, "chapter_id": 4034, "verse_number": "३१", "content_sanskrit": "पृथिव्यां सागरान्तायां वर्णो मे दुर्लभः समः ।\nशुद्धत्वाद्रूपवत्त्वाच्च तेन मामर्जुनं विदुः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2140697, "chapter_id": 4034, "verse_number": "३२", "content_sanskrit": "उत्तराभ्यां तु पूर्वाभ्यां फल्गुनीभ्यामहं दिवा ।\nजातो हिमवतः पृष्ठे तेन मां फल्गुनं विदुः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2140698, "chapter_id": 4034, "verse_number": "३३", "content_sanskrit": "यो ममाङ्गे व्रणं कुर्याद् भ्रातुर्ज्येष्ठस्य पश्यतः ।\nयुधिष्ठिरस्य रुधिरं दर्शयेद् वा कदाचन\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2140699, "chapter_id": 4034, "verse_number": "३४", "content_sanskrit": "पराजयमहं तस्य कुले कुर्यां न संशयः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2140700, "chapter_id": 4034, "verse_number": "३५", "content_sanskrit": "यास्यामि तैरहं सर्वैर्न मे तेभ्यः पराभवः ।\nतेन देवमनुष्येषु जिष्णुर्नामाऽस्मि विश्रुतः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2140701, "chapter_id": 4034, "verse_number": "३६", "content_sanskrit": "माता मम पृथा नाम तेन मां पार्थमब्रुवन्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2140702, "chapter_id": 4034, "verse_number": "३७", "content_sanskrit": "देवदानवगन्धर्वपिशाचोरगराक्षसान् ।\nअहं पुरा रणे जित्वा खाण्डवेऽग्निमतर्पयम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2140703, "chapter_id": 4034, "verse_number": "३८", "content_sanskrit": "हुताशनं तर्पयित्वा सहितः शार्ङ्गधन्वना ।\nत्रिविष्टपगतौ दृष्ट्वा पितामहमहेश्वरौ\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2140704, "chapter_id": 4034, "verse_number": "३९", "content_sanskrit": "मूर्च्छया पतितं भूमौ सागरोपमसत्तमौ ।\nदृष्ट्वा तौ वरदौ देवौ सञ्ज्ञां लब्ध्वोत्थितः पुनः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2140705, "chapter_id": 4034, "verse_number": "४०", "content_sanskrit": "मूर्ध्नाऽभिप्रणतं भूमौ तौ तदा वरदौ वरौ ।\nकृष्णेत्येकादशं नाम प्रीत्या मे तत्र चक्रतुः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2140706, "chapter_id": 4034, "verse_number": "४१", "content_sanskrit": "तुष्टौ च मम वीर्येण कर्मणा चाभिराधितौ ।\nसर्वदेवैः परिवृतौ भूयो मां स्वयमूचतुः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2140707, "chapter_id": 4034, "verse_number": "४२", "content_sanskrit": "वरं तात वृणीष्वेति यं प्रार्थयसि पाण्डव\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2140708, "chapter_id": 4034, "verse_number": "४३", "content_sanskrit": "ततोऽहमस्त्राण्यलभं दिव्यानि च दृढानि च ।\nब्राह्मं पाशुपतं चैव स्थूणाकर्ण च दुर्जयम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2140709, "chapter_id": 4034, "verse_number": "४४", "content_sanskrit": "ऐन्द्रं वारुणमाग्नेयं वायव्यमथ वैष्णवम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2140710, "chapter_id": 4034, "verse_number": "४५", "content_sanskrit": "ततोऽहमजयं भूयो रथेनैन्द्रेण दुर्जयान् ।\nमातलिं सारथिं कृत्वा निवातकवचान् रणे\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2140711, "chapter_id": 4034, "verse_number": "४६", "content_sanskrit": "अवध्यकवचान् देवैर्वरदत्तान् महासुरान्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2140712, "chapter_id": 4034, "verse_number": "४७", "content_sanskrit": "तिस्रः कोटीर्दानवानां संयुगेष्वनिवर्तिनाम् ।\nएको निर्जित्य सङ्ग्रामे भूयो देवानतोषयम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2140713, "chapter_id": 4034, "verse_number": "४८", "content_sanskrit": "ततो मे भगवानिन्द्रः किरीटमददात् स्वयम् ।\nदेवाश्च शङ्खमददुः शत्रुसैन्यनिवारणम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2140714, "chapter_id": 4034, "verse_number": "४९", "content_sanskrit": "अहं पारे समुद्रस्य हिरण्यपुरवासिनाम् ।\nहत्वा षष्टिसहस्राणि जयं सम्प्राप्तवानपि\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2140715, "chapter_id": 4034, "verse_number": "५०", "content_sanskrit": "असम्भ्रान्तो रथे तिष्ठन् सहस्रेषु शतेषु च ।\nशत्रुमध्ये दुराधर्षो न च मुह्ये कथञ्चन\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2140716, "chapter_id": 4034, "verse_number": "५१", "content_sanskrit": "अहं गन्धर्वराजेन ह्रियमाणं सुयोधनम् ।\nभ्रातृभिः सहितं तात गन्धर्वैः समरे जितम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2140717, "chapter_id": 4034, "verse_number": "५२", "content_sanskrit": "चतुर्दश सहस्राणि हत्वा चैनममोचयम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2140718, "chapter_id": 4034, "verse_number": "५३", "content_sanskrit": "अद्य पश्य महाबाहो मम वीर्यं सुदुस्सहम् ।\nमा भैषीर्गतसन्त्रासः कुरूनेतान् समागतान्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2140719, "chapter_id": 4034, "verse_number": "५४", "content_sanskrit": "सुयोधनस्य मिषतः कर्णस्य च कृपस्य च ।\nपितामहस्य भीष्मस्य द्रौणेर्द्रोणस्य च स्वयम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2140720, "chapter_id": 4034, "verse_number": "५५", "content_sanskrit": "सर्वानेव कुरून् जित्वा प्रत्यानेष्यामि ते पशून्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2140721, "chapter_id": 4034, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां विराटपर्वणि द्विचत्वारिंशोऽध्यायः ॥४२॥\nगोग्रहणपर्वणि पञ्चदशोऽध्यायः ॥१५॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]