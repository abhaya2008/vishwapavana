[{"id": 2009133, "chapter_id": 1178, "verse_number": "१-१७९-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2009134, "chapter_id": 1178, "verse_number": "१-१७९-१", "content_sanskrit": "ते तथा पुरुषव्याघ्रा निहत्य बकराक्षसम्।\nअत ऊर्ध्वं ततो ब्रह्मन्किमकुर्वत पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2009135, "chapter_id": 1178, "verse_number": "१-१७९-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2009136, "chapter_id": 1178, "verse_number": "१-१७९-२", "content_sanskrit": "तत्रैव न्यवसन्राजन्निहत्य बकराक्षसम्।\nअधीयानाः परं ब्रह्म ब्राह्मणस्य निवेशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2009137, "chapter_id": 1178, "verse_number": "१-१७९-३", "content_sanskrit": "ततः कतिपयाहस्य ब्राह्मणः संशितव्रतः।\nप्रतिश्रयार्थी तद्वेश्म ब्राह्मणस्याजगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2009138, "chapter_id": 1178, "verse_number": "१-१७९-४", "content_sanskrit": "स म्यक् पूजयित्वा तं विप्रं विप्रर्षभस्तदा।\nददौ प्रतिश्रयं तस्मै सदा सर्वातिथिव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2009139, "chapter_id": 1178, "verse_number": "१-१७९-५", "content_sanskrit": "ततस्ते पाण्डवाः सर्वे सह कुन्त्या नरर्षभाः।\nउपासाञ्चक्रिरे विप्रं कथयन्तं कथाः शुभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2009140, "chapter_id": 1178, "verse_number": "१-१७९-६", "content_sanskrit": "कथयामास देशांश्च तीर्थानि सरितस्तथा।\nराज्ञश्च विविधाश्चर्यान्देशांश्चैव पुराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2009141, "chapter_id": 1178, "verse_number": "१-१७९-७", "content_sanskrit": "स तत्राकथयद्विप्रः कथान्ते जनमेजय।\nपञ्चालेष्वद्भुताकारं याज्ञसेन्याः स्वयंवरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2009142, "chapter_id": 1178, "verse_number": "१-१७९-८", "content_sanskrit": "धृष्टद्युम्नस्य चोत्पत्तिमुत्पत्तिं च शिखण्डिनः।\nअयोनिजत्वं कृष्णाया द्रुपदस्य महामखे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2009143, "chapter_id": 1178, "verse_number": "१-१७९-९", "content_sanskrit": "तदद्भुततमं श्रुत्वा लोके तस्य महात्मनः।\nविस्तरेणैव पप्रच्छुः कथां ते पुरुषर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2009144, "chapter_id": 1178, "verse_number": "१-१७९-१०x", "content_sanskrit": "पाण्डवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2009145, "chapter_id": 1178, "verse_number": "१-१७९-१०", "content_sanskrit": "कथं द्रुपदपुत्रस्य धृष्टद्युम्नस्य पावकात्।\nवेदीमध्याच्च कृष्णायाः संभवः कथमद्भुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2009146, "chapter_id": 1178, "verse_number": "१-१७९-११", "content_sanskrit": "कथं द्रोणान्महेष्वासात्सर्वाण्यस्त्राण्यशिक्षत।\nधृष्टद्युम्नो महेष्वासः कथं द्रोणस्य मृत्युदः।\nकथं विप्र सखायौ तौ भिन्नौ कस्य कृतेन वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2009147, "chapter_id": 1178, "verse_number": "१-१७९-१२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2009148, "chapter_id": 1178, "verse_number": "१-१७९-१२", "content_sanskrit": "एवं तैश्चोदितो राजन्स विप्रः पुरुषर्षभैः।\nकथयामास तत्सर्वं द्रौपदीसंभवं तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2009149, "chapter_id": 1178, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि चैत्ररथपर्वणि ऊनाशीत्यधिकशततमोऽध्यायः॥ १७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]