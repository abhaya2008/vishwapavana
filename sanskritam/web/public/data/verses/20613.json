[{"id": 7000613000, "chapter_id": 20613, "verse_number": "५-७२-१", "content_sanskrit": "ईश्वर उवाच ।\nतदेकाग्रमना भूत्वा शृणु देवि वरानने ।\nआसीदुग्रतपा नाम मुनिरेको दृढव्रतः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000613001, "chapter_id": 20613, "verse_number": "५-७२-२", "content_sanskrit": "साग्निको ह्यग्निभक्षश्च चचारात्यद्भुतं तपः ।\nजजाप परमं जाप्यं मंत्रं पंचदशाक्षरम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000613002, "chapter_id": 20613, "verse_number": "५-७२-३", "content_sanskrit": "काममंत्रेण पुटितं कामं कामवरप्रदात् ।\nकृष्णायेति पदं स्वाहा सहितं सिद्धिदं परम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000613003, "chapter_id": 20613, "verse_number": "५-७२-४", "content_sanskrit": "दध्यौ च श्यामलं कृष्णं रासोन्मत्तं वरोत्सुकम् ।\nपीतपट्टधरं वेणुं करेणाधरमर्पितम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000613004, "chapter_id": 20613, "verse_number": "५-७२-५", "content_sanskrit": "नवयौवनसंपन्नं कर्षंतं पाणिना प्रियाम् ।\nएवं ध्यानपरः कल्पशतांते देहमुत्सृजन्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000613005, "chapter_id": 20613, "verse_number": "५-७२-६", "content_sanskrit": "सुनंद नाम गोपस्य कन्याभूत्स महामुनिः ।\nसुनंदेति समाख्याता या वीणां बिभ्रती करे॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000613006, "chapter_id": 20613, "verse_number": "५-७२-७", "content_sanskrit": "मुनिरन्यः सत्यतपा इति ख्यातो महाव्रतः ।\nसशुष्कपत्रं भुंक्ते यः प्रजजाप परं मनुम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000613007, "chapter_id": 20613, "verse_number": "५-७२-८", "content_sanskrit": "रत्यंतं कामबीजेन पुटितं च दशाक्षरम् ।\nस प्रदध्यौ मुनिवरश्चित्रवेषधरं हरिम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000613008, "chapter_id": 20613, "verse_number": "५-७२-९", "content_sanskrit": "धृत्वा रमाया दोर्वल्लीद्वितयं कंकणोज्ज्वलम् ।\nनृत्यंतमुन्मदंतं च संश्लिष्यं तं मुहुर्मुहुः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000613009, "chapter_id": 20613, "verse_number": "५-७२-१०", "content_sanskrit": "हसंतमुच्चैरानंदतरंगं जठरांबरे ।\nदधतं वेणुमाजानु वैजयंत्या विराजितम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000613010, "chapter_id": 20613, "verse_number": "५-७२-११", "content_sanskrit": "स्वेदांभः कणसंसिक्त ललाटवलिताननम् ।\nत्यक्त्वा त्यक्त्वा स वै देहं तपसा च महामुनिः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000613011, "chapter_id": 20613, "verse_number": "५-७२-१२", "content_sanskrit": "दशकल्पांतरे जातो ह्ययं नंदवनादिह ।\nसुभद्र नाम्नो गोपस्य कन्या भद्रेति विश्रुता॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000613012, "chapter_id": 20613, "verse_number": "५-७२-१३", "content_sanskrit": "यस्याः पृष्ठतले दिव्यं व्यजनं परिदृश्यते ।\nहरिधामाभिधानस्तु कश्चिदासीन्महामुनिः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000613013, "chapter_id": 20613, "verse_number": "५-७२-१४", "content_sanskrit": "सोऽप्यतप्यत्तपः कृच्छ्रं नित्यं पत्रैकभोजनम् ।\nआशुसिद्धिकरं मंत्रं विंशत्यर्णं प्रजप्तवान्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000613014, "chapter_id": 20613, "verse_number": "५-७२-१५", "content_sanskrit": "अनंतरं कामबीजादध्यारूढं तदेव तु ।\nमाया तत्पुरतो व्योम हंसासृग्द्युतिचंद्रकम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000613015, "chapter_id": 20613, "verse_number": "५-७२-१६", "content_sanskrit": "ततो दशाक्षरं पश्चान्नमोयुक्तं स्मरादिकम् ।\nदध्यौ वृंदावने रम्ये माधवीमंडपे प्रभुम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000613016, "chapter_id": 20613, "verse_number": "५-७२-१७", "content_sanskrit": "उत्तानशायिनं चारुपल्लवास्तरणोपरि ।\nकयाचिदतिकामार्त्त बल्लव्या रक्तनेत्रया॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000613017, "chapter_id": 20613, "verse_number": "५-७२-१८", "content_sanskrit": "वक्षोजयुगमाच्छाद्य विपुलोरः स्थलं मुहुः ।\nसंचुंब्यमानगंडांतं तृप्यमानरदच्छदम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000613018, "chapter_id": 20613, "verse_number": "५-७२-१९", "content_sanskrit": "कलयंतं प्रियां दोर्भ्यां सहासं समुदाद्भुतम् ।\nस मुनिश्च बहून्देहां स्त्यक्त्वा कल्पत्रयांतरे॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000613019, "chapter_id": 20613, "verse_number": "५-७२-२०", "content_sanskrit": "सारंगनाम्नो गोपस्य कन्याभूच्छुभलक्षणा ।\nरंगवेणीति विख्याता निपुणा चित्रकर्मणि॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000613020, "chapter_id": 20613, "verse_number": "५-७२-२१", "content_sanskrit": "यस्या दंतेषु दृश्यंते चित्रिताः शोणबिंदवः ।\nब्रह्मवादी मुनिः कश्चिज्जाबालिरिति विश्रुतः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000613021, "chapter_id": 20613, "verse_number": "५-७२-२२", "content_sanskrit": "सतपः सुरतो योगी विचरन्पृथिवीमिमाम् ।\nस एकस्मिन्महारण्ये योजनायुतविस्तृते॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000613022, "chapter_id": 20613, "verse_number": "५-७२-२३", "content_sanskrit": "यदृच्छयागतोऽपश्यदेकां वापीं सुशोभनाम् ।\nसर्वतः स्फाटिकाबंधतटां स्वादुजलान्विताम्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000613023, "chapter_id": 20613, "verse_number": "५-७२-२४", "content_sanskrit": "विकासिकमलामोदवायुना परिशीलिताम् ।\nतस्याः पश्चिमदिग्भागे मूले वटमहीरुहः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000613024, "chapter_id": 20613, "verse_number": "५-७२-२५", "content_sanskrit": "अपश्यत्तापसीं कांचित्कुर्वंतीं दारुणं तपः ।\nतारुण्यवयसायुक्तां रूपेणाति मनोहराम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000613025, "chapter_id": 20613, "verse_number": "५-७२-२६", "content_sanskrit": "चंद्रांशुं सदृशाभासां सर्वावयवशोभनाम् ।\nकृत्वा कटितटे वामपाणिं दक्षिणतस्तदा॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000613026, "chapter_id": 20613, "verse_number": "५-७२-२७", "content_sanskrit": "ज्ञानमुद्रां च बिभ्राणामनिमेषविलोचनाम् ।\nत्यक्ताहारविहारां च सुनिश्चलतयास्थिताम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000613027, "chapter_id": 20613, "verse_number": "५-७२-२८", "content_sanskrit": "जिज्ञासुस्तां मुनिवरस्तस्थौ तत्र शतं समाः ।\nतदंते तां समुत्थाप्य चलितां विनयान्मुनिः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000613028, "chapter_id": 20613, "verse_number": "५-७२-२९", "content_sanskrit": "अपृच्छत्का त्वमाश्चर्यरूपे किं वा चरिष्यसि ।\nयदि योग्यं भवेत्तर्हि कृपया वक्तुमर्हसि॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000613029, "chapter_id": 20613, "verse_number": "५-७२-३०", "content_sanskrit": "अथाब्रवीच्छनैर्बाला तपसातीव कर्शिता ।\nब्रह्मविद्याहमतुला योगींद्रैर्या विमृग्यते॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000613030, "chapter_id": 20613, "verse_number": "५-७२-३१", "content_sanskrit": "साहं हरिपदाम्भोजकाम्यया सुचिरं तपः ।\nचराम्यस्मिन्वने घोरे ध्यायंती पुरुषोत्तमम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000613031, "chapter_id": 20613, "verse_number": "५-७२-३२", "content_sanskrit": "ब्रह्मानंदेन पूर्णाहं तेनानंदेन तृप्तधीः ।\nतथापि शून्यमात्मानं मन्ये कृष्णरतिं विना॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000613032, "chapter_id": 20613, "verse_number": "५-७२-३३", "content_sanskrit": "इदानीमतिनिर्विण्णा देहस्यास्य विसर्ज्जनम् ।\nकर्त्तुमिच्छामि पुण्यायां वापिकायामिहैव तु॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000613033, "chapter_id": 20613, "verse_number": "५-७२-३४", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्या मुनिरत्यंतविस्मितः ।\nपतित्वा चरणे तस्याः कृष्णोपासाविधिं शुभम्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000613034, "chapter_id": 20613, "verse_number": "५-७२-३५", "content_sanskrit": "पप्रच्छ परमप्रीतस्त्यक्त्वाध्यात्मविरोचनम् ।\nतयोक्तं मंत्रमाज्ञाय जगाम मानसं सरः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000613035, "chapter_id": 20613, "verse_number": "५-७२-३६", "content_sanskrit": "ततोऽतिदुश्चरं चक्रे तपो विस्मयकारकम् ।\nएकपादस्थितः सूर्यं निर्निमेषं विलोकयन्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000613036, "chapter_id": 20613, "verse_number": "५-७२-३७", "content_sanskrit": "मंत्रं जजाप परमं पंचविंशतिवर्णकम् ।\nदध्यौ परमभावेन कृष्णमानंदरूपिणम्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000613037, "chapter_id": 20613, "verse_number": "५-७२-३८", "content_sanskrit": "चरंतं व्रजवीथीषु विचित्रगतिलीलया ।\nललितैः पादविन्यासैः क्वणयंतं च नूपुरम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000613038, "chapter_id": 20613, "verse_number": "५-७२-३९", "content_sanskrit": "चित्रकंदर्पचेष्टाभिः सस्मितापांगवीक्षितैः ।\nसंमोहनाख्यया वंश्या पंचमारुणचित्रया॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000613039, "chapter_id": 20613, "verse_number": "५-७२-४०", "content_sanskrit": "बिंबौष्ठपुटचुंबिन्या कलालापैर्मनोज्ञया ।\nहरंतं व्रजरामाणां मनांसि च वपूंषि च॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000613040, "chapter_id": 20613, "verse_number": "५-७२-४१", "content_sanskrit": "श्लथन्नीवीभिरागत्य सहसालिंगितांगकम् ।\nदिव्यमाल्यांबरधरं दिव्यगंधानुलेपनम्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000613041, "chapter_id": 20613, "verse_number": "५-७२-४२", "content_sanskrit": "श्यामलांगप्रभापूर्णैर्मोहयंतं जगत्त्रयम् ।\nस एवं बहुदेवेन समुपास्य जगत्पतिम्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000613042, "chapter_id": 20613, "verse_number": "५-७२-४३", "content_sanskrit": "नवकल्पांतरे जाता गोकुले दिव्यरूपिणी ।\nकन्या प्रचंडनाम्नस्तु गोपस्याति यशस्विनः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000613043, "chapter_id": 20613, "verse_number": "५-७२-४४", "content_sanskrit": "चित्रगंधेति विख्याता कुमारी च शुभानना ।\nनिजांगगंधैर्विविधैर्मोदयंती दिशो दश॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000613044, "chapter_id": 20613, "verse_number": "५-७२-४५", "content_sanskrit": "तामेनां पश्य कल्याणीं वृंदशो मधुपायिनीम् ।\nअंगेषु स्वपतिं कृत्वा रसावेशसमाकुलाम्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000613045, "chapter_id": 20613, "verse_number": "५-७२-४६", "content_sanskrit": "अस्याः स्तनपरिष्वंगे हारैः सर्वैर्विहन्यते ।\nवक्षःस्थलात्प्रच्यवद्भिश्चित्रगंधादिसौरभैः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000613046, "chapter_id": 20613, "verse_number": "५-७२-४७", "content_sanskrit": "अपरे मुनिवर्यास्तु सततं पूतमानसाः ।\nवायुभक्षास्तपस्तेपुर्जपंतः परमं मनुम्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000613047, "chapter_id": 20613, "verse_number": "५-७२-४८", "content_sanskrit": "स्मरः कृष्णाय कामार्ति कलादिवृत्तिशालिने ।\nआग्नेयीसहितं कृत्वा मंत्रं पंचदशाक्षरम्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000613048, "chapter_id": 20613, "verse_number": "५-७२-४९", "content_sanskrit": "दध्युर्मुनिवराः कष्णमूर्तिं दिव्यविभूषणाम् ।\nदिव्यचित्रदुकूलेन पूर्णपीनकटिस्थलाम्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000613049, "chapter_id": 20613, "verse_number": "५-७२-५०", "content_sanskrit": "मयूरपिच्छकैः कॢप्तचूडामुज्ज्वलकुंडलाम् ।\nसव्यजंघांत आदाय दक्षिणं चरणांबुजम्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000613050, "chapter_id": 20613, "verse_number": "५-७२-५१", "content_sanskrit": "भ्रमंतीं संपुटीकृत्य चारुहस्तांबुजद्वयम् ।\nकक्षदेशविनिक्षिप्तवेणुं परिचलत्पुटीम्॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000613051, "chapter_id": 20613, "verse_number": "५-७२-५२", "content_sanskrit": "आनंदयंतीं गोपीनां नयनानि मनांसि च ।\nपरमाश्चर्यरूपेण प्रविष्टां रंगमंडपे॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000613052, "chapter_id": 20613, "verse_number": "५-७२-५३", "content_sanskrit": "प्रसूनवर्षर्गोपीभिः पूर्यमाणां च सर्वतः ।\nअथ कल्पांतरे देहं त्यक्त्वा जाता इहाधुना॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000613053, "chapter_id": 20613, "verse_number": "५-७२-५४", "content_sanskrit": "यासां कर्णेषु दृश्यंते ताटंका रश्मिदीपिताः ।\nरत्नमाल्यानि कंठेषु रत्नपुष्पाणि वेणिषु॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000613054, "chapter_id": 20613, "verse_number": "५-७२-५५", "content_sanskrit": "मुनिः शुचिश्रवा नाम सुवर्णो नाम चापरः ।\nकुशध्वजस्य ब्रह्मर्षेः पुत्रौ तौ वेदपारगौ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000613055, "chapter_id": 20613, "verse_number": "५-७२-५६", "content_sanskrit": "ऊर्ध्वपादौ तपो घोरं तेपतुस्त्र्यक्षरं मनुम् ।\nह्रीं हंस इति कृत्वैव जपंतौ यतमानसौ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000613056, "chapter_id": 20613, "verse_number": "५-७२-५७", "content_sanskrit": "ध्यायंतौ गोकुले कृष्णं बालकं दशवार्षिकम् ।\nकंदर्पसमरूपेण तारुण्यललितेन च॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000613057, "chapter_id": 20613, "verse_number": "५-७२-५८", "content_sanskrit": "पश्यंतीर्व्रजबिंबोष्ठीर्मोहयंतमनारतम् ।\nतौ कल्पांते तनूं त्यक्त्वा लब्धवंतौ जनिं व्रजे॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000613058, "chapter_id": 20613, "verse_number": "५-७२-५९", "content_sanskrit": "सुवीरनाम गोपस्य सुते परमशोभने ।\nययोर्हस्ते प्रदृश्येते सारिके शुभराविणी॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000613059, "chapter_id": 20613, "verse_number": "५-७२-६०", "content_sanskrit": "जटिलो जंघपूतश्च घृताशी कर्बुरेव च ।\nचत्वारो मुनयो धन्या इहामुत्र च निःस्पृहाः॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000613060, "chapter_id": 20613, "verse_number": "५-७२-६१", "content_sanskrit": "केवलेनैकभावेन प्रपन्ना बल्लवीपतिम् ।\nतेपुस्ते सलिले मग्ना जपंतो मनुमेव च॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000613061, "chapter_id": 20613, "verse_number": "५-७२-६२", "content_sanskrit": "रमात्रयेण पुटितं स्मराद्यं तदशाक्षरम् ।\nदध्युश्च गाढभावेन बल्लवीभिर्वने वने॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000613062, "chapter_id": 20613, "verse_number": "५-७२-६३", "content_sanskrit": "भ्रमंतं नृत्यगीताद्यैर्मानयंतं मनोहरम् ।\nचंदनालिप्तसर्वांगं जपापुष्पावतंसकम्॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000613063, "chapter_id": 20613, "verse_number": "५-७२-६४", "content_sanskrit": "कल्हारमालयावीतं नीलपीतपटावृतम् ।\nकल्पत्रयांते जातास्ते गोकुले शुभलक्षणाः॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000613064, "chapter_id": 20613, "verse_number": "५-७२-६५", "content_sanskrit": "इमास्ताः पुरतो रम्या उपविष्टा नतभ्रुवः ।\nयासां धर्मकृतान्येव वलयानि प्रकोष्ठके॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000613065, "chapter_id": 20613, "verse_number": "५-७२-६६", "content_sanskrit": "विचित्राणि च रत्नाद्यैर्दिव्यमुक्ताफलादिभिः ।\nमुनिर्दीर्घतपा नाम व्यासोऽभूत्पूर्वकल्पके॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000613066, "chapter_id": 20613, "verse_number": "५-७२-६७", "content_sanskrit": "तत्पुत्रः शुक इत्येव मुनिः ख्यातो वरः सुधीः ।\nसोऽपि बालो महाप्राज्ञः सदैवानुस्मरन्पदम्॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000613067, "chapter_id": 20613, "verse_number": "५-७२-६८", "content_sanskrit": "विहाय पितृमात्रादि कृष्णं ध्यात्वा वनं गतः ।\nस तत्र मानसैर्दिव्यैरुपचारैरहर्निशम्॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000613068, "chapter_id": 20613, "verse_number": "५-७२-६९", "content_sanskrit": "अनाहारोऽर्चयद्विष्णुं गोपरूपिणमीश्वरम् ।\nरमया पुटितं मंत्रं जपन्नष्टादशाक्षरम्॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000613069, "chapter_id": 20613, "verse_number": "५-७२-७०", "content_sanskrit": "दध्यौ परमभावेन हरिं हैमतरोरधः ।\nहैममंडपिकायां च हेमसिंहासनोपरि॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000613070, "chapter_id": 20613, "verse_number": "५-७२-७१", "content_sanskrit": "आसीनं हेमहस्ताग्रैर्दधानं हेमवंशिकाम् ।\nदक्षिणेन भ्रामयंतं पाणिना हेमपंकजम्॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000613071, "chapter_id": 20613, "verse_number": "५-७२-७२", "content_sanskrit": "हेमवर्णेष्टप्रियया परिकॢप्तांगचित्रकम् ।\nहसंतमतिहर्षेण पश्यंतं निजमाश्रमम्॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000613072, "chapter_id": 20613, "verse_number": "५-७२-७३", "content_sanskrit": "हर्षाश्रुपूर्णः पुलकाचितांगः प्रसीदनाथेति वदन्नथोच्चैः ।\nदंडप्रणामाय पपात भूमौ संवेपमानस्त्रिजगद्विधातुः॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000613073, "chapter_id": 20613, "verse_number": "५-७२-७४", "content_sanskrit": "तं भक्तिकामं पतितं धरण्यामायासितोस्मीति वदंतमुच्चैः ।\nदंडप्रणामस्य भुजौ गृहीत्वा पस्पर्श हर्षोपचितेक्षणेन॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000613074, "chapter_id": 20613, "verse_number": "५-७२-७५", "content_sanskrit": "उवाच च प्रियारूपं लब्धवंतं शुकं हरिः ।\nत्वं मे प्रियतमा भद्रे सदा तिष्ठ ममांतिके॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000613075, "chapter_id": 20613, "verse_number": "५-७२-७६", "content_sanskrit": "मद्रूपं चिंतयंती च प्रेमास्पदमुपागता ।\nद्वे च मुख्यतमे गोप्यौ समानवयसी शुभे॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000613076, "chapter_id": 20613, "verse_number": "५-७२-७७", "content_sanskrit": "एकव्रते एकनिष्ठे एकनक्षत्रनामनी ।\nतप्तजांबूनदप्रख्या तत्रैवान्या तडित्प्रभा॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000613077, "chapter_id": 20613, "verse_number": "५-७२-७८", "content_sanskrit": "एकानिद्रा यमाणाक्षी परा सौम्यायतेक्षणा ।\nसोऽर्चयत्परया भक्त्या ते हरेः सव्यदक्षिणे॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000613078, "chapter_id": 20613, "verse_number": "५-७२-७९", "content_sanskrit": "स कल्पांते तनुं त्यक्त्वा गोकुलेऽभून्महात्मनः ।\nउपनंदस्य दुहिता नीलोत्पलदलच्छविः॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000613079, "chapter_id": 20613, "verse_number": "५-७२-८०", "content_sanskrit": "सेयं श्रीकृष्णवनिता पीतशाटीपरिच्छदा ।\nरक्तचोलिकया पूर्णा शातकुंभघटस्तनी॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000613080, "chapter_id": 20613, "verse_number": "५-७२-८१", "content_sanskrit": "दधाना रक्तसिंदूरं सर्वांगस्यावगुंठनम् ।\nस्वर्णकुंडलविभ्राजद्गंडदेशां सुशोभनाम्॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000613081, "chapter_id": 20613, "verse_number": "५-७२-८२", "content_sanskrit": "स्वर्णपंकजमालाढ्या कुंकुमालिप्तसुस्तनी ।\nयस्या हस्ते चर्वणीयं दृश्यते हरिणार्पितम्॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000613082, "chapter_id": 20613, "verse_number": "५-७२-८३", "content_sanskrit": "वेणुवाद्यातिनिपुणा केशवस्य निषेवणी ।\nकृष्णेन परितुष्टेन कदाचिद्गीतकर्मणि॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000613083, "chapter_id": 20613, "verse_number": "५-७२-८४", "content_sanskrit": "विन्यस्ता कंबुकंठेऽस्या भाति गुंजावलि शुभा ।\nपरोक्षेपि च कृष्णस्य कांतिभिश्च स्मरार्दिता॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000613084, "chapter_id": 20613, "verse_number": "५-७२-८५", "content_sanskrit": "सखीभिर्वादयंतीभिर्गायंती सुस्वरं परम् ।\nनर्त्तयेत्प्रियवेषेण वेषयित्वा वधूमिमाम्॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000613085, "chapter_id": 20613, "verse_number": "५-७२-८६", "content_sanskrit": "वारंवारं च गोविंदं भावेनालिंग्य चुंबति ।\nप्रियासौ सर्वगोपीनां कृष्णस्याप्यतिवल्लभा॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000613086, "chapter_id": 20613, "verse_number": "५-७२-८७", "content_sanskrit": "श्वेतकेतोः सुतः कश्चिद्वेदवेदांगपारगः ।\nसर्वमेव परित्यज्य प्रचंडं तप आस्थितः॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000613087, "chapter_id": 20613, "verse_number": "५-७२-८८", "content_sanskrit": "मुरारेः सेवितपदां सुधामधुरनादिनीम् ।\nगोविंदस्य प्रियां शक्तिं ब्रह्मरुद्रादिदुर्गमाम्॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000613088, "chapter_id": 20613, "verse_number": "५-७२-८९", "content_sanskrit": "भजंतीमेकभावेन श्रियमेव मनोहराम् ।\nध्यायञ्जजाप सततं मंत्रमेकादशाक्षरम्॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000613089, "chapter_id": 20613, "verse_number": "५-७२-९०", "content_sanskrit": "हसितं सकलं कृत्वा बतमायेषु योजयन् ।\nकांत्यादिभिर्हसंतीभिर्वासयंत्यभितो जगत्॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000613090, "chapter_id": 20613, "verse_number": "५-७२-९१", "content_sanskrit": "वसंते वसतेत्येवं मंत्रार्थं चिंतयन्सदा ।\nसोऽपि कल्पद्वयेनैव सिद्धोऽत्र जनिमाप्तवान्॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000613091, "chapter_id": 20613, "verse_number": "५-७२-९२", "content_sanskrit": "सेयं बालायते पुत्री कृशांगी कुड्मलस्तनी ।\nमुक्तावलिलसत्कंठी शुद्धकौशेयवासिनी॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000613092, "chapter_id": 20613, "verse_number": "५-७२-९३", "content_sanskrit": "मुक्ताच्छुरितमंजीरकंकणांगदमुद्रिका ।\nबिभ्रती कुंडले दिव्ये अमृतस्राविणी शुभे॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000613093, "chapter_id": 20613, "verse_number": "५-७२-९४", "content_sanskrit": "वृत्तकस्तूरिकावेणी मध्ये सिंदूरबिंदुवत् ।\nदधाना चित्रकं भाले सार्द्धं चंदनचित्रकैः॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000613094, "chapter_id": 20613, "verse_number": "५-७२-९५", "content_sanskrit": "या सैव दृश्यते शांता जपंती परमं पदम् ।\nआसीच्चंद्रप्रभो नाम राजर्षिः प्रियदर्शनः॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000613095, "chapter_id": 20613, "verse_number": "५-७२-९६", "content_sanskrit": "तस्य कृष्णप्रसादेन पुत्रोऽभून्मधुराकृतिः ।\nचित्रध्वज इति ख्यातः कौमारावधि वैष्णवः॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000613096, "chapter_id": 20613, "verse_number": "५-७२-९७", "content_sanskrit": "स राजा सुसुतं सौम्यं सुस्थिरं द्वादशाब्दिकम् ।\nआदेशयद्द्विजान्मंत्रं परमष्टादशाक्षरम्॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000613097, "chapter_id": 20613, "verse_number": "५-७२-९८", "content_sanskrit": "अभिषिच्यमानः स शिशुर्मंत्रामृतमयैर्जलैः ।\nतत्क्षणे भूपतिं प्रेम्णा नत्वोदश्रुप्रकल्पितः॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000613098, "chapter_id": 20613, "verse_number": "५-७२-९९", "content_sanskrit": "तस्मिन्दिने स वै बालः शुचिवस्त्रधरः शुचिः ।\nहारनूपुरसूत्राद्यैर्ग्रैवेयांगदकंकणैः॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000613099, "chapter_id": 20613, "verse_number": "५-७२-१००", "content_sanskrit": "विभूषितो हरेर्भक्तिमुपस्पृश्यामलाशयः ।\nविष्णोरायतनं गत्वा स्थित्वैकाकी व्यचिंतयत्॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000613100, "chapter_id": 20613, "verse_number": "५-७२-१०१", "content_sanskrit": "कथं भजामि तं भक्तं मोहनं गोपयोषिताम् ।\nविक्रीडंतं सदा ताभिः कालिंदीपुलिने वने॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000613101, "chapter_id": 20613, "verse_number": "५-७२-१०२", "content_sanskrit": "इत्थमत्याकुलमतिश्चिंतयन्नेव बालकः ।\nअथापपरमां विद्यां स्वप्नं च समवाप्यत॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000613102, "chapter_id": 20613, "verse_number": "५-७२-१०३", "content_sanskrit": "आसीत्कृष्णप्रतिकृतिः पुरतस्तस्य शोभना ।\nशिलामयी स्वर्णपीठे सर्वलक्षणलक्षिता॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000613103, "chapter_id": 20613, "verse_number": "५-७२-१०४", "content_sanskrit": "साभूदिंदीवरश्यामा स्निग्धलावण्यशालिनी ।\nत्रिभंगललिताकार शिखंडी पिच्छभूषणा॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000613104, "chapter_id": 20613, "verse_number": "५-७२-१०५", "content_sanskrit": "कूजयंती मुदा वेणुं कांचनीमधरेऽर्पिताम् ।\nदक्षसव्यगताभ्यां च सुंदरीभ्यां निषेविताम्॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000613105, "chapter_id": 20613, "verse_number": "५-७२-१०६", "content_sanskrit": "वर्द्धयंतीं तयोः कामं चुंबनाश्लेषणादिभिः ।\nदृष्ट्वा चित्रध्वजः कृष्णं तादृग्वेषविलासिनम्॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000613106, "chapter_id": 20613, "verse_number": "५-७२-१०७", "content_sanskrit": "अवनम्य शिरस्तस्मै पुरो लज्जितमानसः ।\nअथोवाच हरिर्दक्षपार्श्वगां प्रेयसीं हसन्॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000613107, "chapter_id": 20613, "verse_number": "५-७२-१०८", "content_sanskrit": "सलज्जं परमं चैनं स्वशरीरासनागतम् ।\nनिर्मायात्मसमं दिव्यं युवतीरूपमद्भुतम्॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000613108, "chapter_id": 20613, "verse_number": "५-७२-१०९", "content_sanskrit": "चिंतयस्व शरीरेण ह्यभेदं मृगलोचने ।\nअथो त्वदंगतेजोभिः स्पृष्टस्त्वद्रूपमाप्स्यति॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000613109, "chapter_id": 20613, "verse_number": "५-७२-११०", "content_sanskrit": "ततः सा पद्मपत्राक्षी गत्वा चित्रध्वजांतिकम् ।\nनिजांगकैस्तदंगानामभेदं ध्यायती स्थिता॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000613110, "chapter_id": 20613, "verse_number": "५-७२-१११", "content_sanskrit": "अथास्यास्त्वंगतेजांसि तदंगं पर्यपूरयन् ।\nस्तनयोर्ज्योतिषा जातौ पीनौ चारुपयोधरौ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000613111, "chapter_id": 20613, "verse_number": "५-७२-११२", "content_sanskrit": "नितंबज्योतिषा जातं श्रोणिबिंबं मनोहरम् ।\nकुंतलज्योतिषा केशपाशोऽभूत्करयोः करौ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000613112, "chapter_id": 20613, "verse_number": "५-७२-११३", "content_sanskrit": "सर्वमेवं सुसंपन्नं भूषावासः स्रगादिकम् ।\nकलासु कुशला जाता सौरभेनांतरात्मनि॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000613113, "chapter_id": 20613, "verse_number": "५-७२-११४", "content_sanskrit": "दीपाद्दीपमिवालोक्य सुभगां भुवि कन्यकाम् ।\nचित्रध्वजां त्रपाभंगि स्मितशोभां मनोहराम्॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000613114, "chapter_id": 20613, "verse_number": "५-७२-११५", "content_sanskrit": "प्रेम्णा गृहीत्वा करयोः सा तामपहरन्मुदा ।\nगोविंदवामपार्श्वस्थां प्रेयसीं परिरभ्य च॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000613115, "chapter_id": 20613, "verse_number": "५-७२-११६", "content_sanskrit": "उवाच तव दासीयं नाम चास्याश्चकार य ।\nसेवां चास्यै वद प्रीत्या यथाभिरुचितां प्रियाम्॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000613116, "chapter_id": 20613, "verse_number": "५-७२-११७", "content_sanskrit": "अथ चित्रकलेत्येतन्नाम चात्ममतेन सा ।\nचकार चाह सेवार्थं धृत्वा चापि विपंचिकाम्॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7000613117, "chapter_id": 20613, "verse_number": "५-७२-११८", "content_sanskrit": "सदा त्वं निकटे तिष्ठ गायस्व विविधैः स्वरैः ।\nगुणात्मन्प्राणनाथस्य तवायं विहितो विधिः॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7000613118, "chapter_id": 20613, "verse_number": "५-७२-११९", "content_sanskrit": "अथ चित्रकला त्वाज्ञां गृहीत्वानम्य माधवम् ।\nतत्प्रेयस्याश्च चरणं गृहीत्वा पादयो रजः॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7000613119, "chapter_id": 20613, "verse_number": "५-७२-१२०", "content_sanskrit": "जगौ सुमधुरं गीतं तयोरानंदकारणम् ।\nअथ प्रीत्योपगूढा सा कृष्णेनानंदमूर्तिना॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7000613120, "chapter_id": 20613, "verse_number": "५-७२-१२१", "content_sanskrit": "यावत्सुखांबुधौ पूर्णा तावदेवाप्यबुध्यत ।\nचित्रध्वजो महाप्रेमविह्वलः स्मरतत्परः॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7000613121, "chapter_id": 20613, "verse_number": "५-७२-१२२", "content_sanskrit": "तमेव परमानंदं मुक्तकंठो रुरोद ह ।\nतदारभ्य रुदन्नेव मुक्त्वा हरिविचारकम्॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7000613122, "chapter_id": 20613, "verse_number": "५-७२-१२३", "content_sanskrit": "आभाषितोऽपि पित्राद्यैर्नैवावोचद्वचः क्वचित् ।\nमासमात्रं गृहे स्थित्वा निशीथे कृष्णसंश्रयः॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7000613123, "chapter_id": 20613, "verse_number": "५-७२-१२४", "content_sanskrit": "निर्गत्यारण्यमचरत्तपो वै मुनिदुष्करम् ।\nकल्पांते देहमुत्सृज्य तपसैव महामुनिः॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7000613124, "chapter_id": 20613, "verse_number": "५-७२-१२५", "content_sanskrit": "वीरगुप्ताभिधानस्य गोपस्य दुहिता शुभा ।\nजाता चित्रकलेत्येव यस्याः स्कंधे मनोहरा॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7000613125, "chapter_id": 20613, "verse_number": "५-७२-१२६", "content_sanskrit": "विपंची दृश्यते नित्यं सप्तस्वरविभूषिता ।\nउपतिष्ठति वै वामे रत्नभृंगारमद्भुतम्॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7000613126, "chapter_id": 20613, "verse_number": "५-७२-१२७", "content_sanskrit": "दधाना दक्षिणे हस्ते सा वै रत्नपतद्ग्रहम् ।\nअयमासीत्पुरा सर्वं तापसैरभिवंदितः॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7000613127, "chapter_id": 20613, "verse_number": "५-७२-१२८", "content_sanskrit": "मुनिः पुण्यश्रवा नाम काश्यपः सर्वधर्मवित् ।\nपिता तस्याभवच्छैवः शतरुद्रीयमन्वहम्॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7000613128, "chapter_id": 20613, "verse_number": "५-७२-१२९", "content_sanskrit": "प्रस्तुवन्देवदेवेशं विश्वेशं भक्तवत्सलम् ।\nप्रसन्नो भगवांस्तस्य पार्वत्या सह शंकरः॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7000613129, "chapter_id": 20613, "verse_number": "५-७२-१३०", "content_sanskrit": "चतुर्दश्यामर्द्धरात्रेः प्रत्यक्षः प्रददौ वरम् ।\nत्वत्पुत्रो भविता कृष्णे भक्तिमान्बाल एव हि॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7000613130, "chapter_id": 20613, "verse_number": "५-७२-१३१", "content_sanskrit": "उपनीयाष्टमे वर्षे तस्मै सिद्धमनुस्त्वयम् ।\nउपदिशैकविंशत्या यो मया ते निगद्यते॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7000613131, "chapter_id": 20613, "verse_number": "५-७२-१३२", "content_sanskrit": "गोपालविद्यानामायं मंत्रो वाक्सिद्धिदायकः ।\nएतत्साधकजिह्वाग्रे लीलाचरितमद्भुतम्॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7000613132, "chapter_id": 20613, "verse_number": "५-७२-१३३", "content_sanskrit": "अनंतमूर्तिरायाति स्वयमेव वरप्रदः ।\nकाममाया रमाकंठ सेंद्रा दामोदरोज्ज्वलाः॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7000613133, "chapter_id": 20613, "verse_number": "५-७२-१३४", "content_sanskrit": "मध्ये दशाक्षरीं प्रोच्य पुनस्ता एव निर्दिशेत् ।\nदशाक्षरोक्तऋष्यादिध्यानं चास्य ब्रवीम्यहम्॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7000613134, "chapter_id": 20613, "verse_number": "५-७२-१३५", "content_sanskrit": "पूर्णामृतनिधेर्मध्ये द्वीपं ज्योतिर्मयं स्मरेत् ।\nकालिंद्या वेष्टितं तत्र ध्यायेद्वृंदावने वने॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7000613135, "chapter_id": 20613, "verse_number": "५-७२-१३६", "content_sanskrit": "सर्वर्तुकुसुमस्रावि द्रुमवल्लीभिरावृतम् ।\nनटन्मत्तशिखिस्वानं गायत्कोकिलषट्पदम्॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7000613136, "chapter_id": 20613, "verse_number": "५-७२-१३७", "content_sanskrit": "तस्य मध्ये वसत्येकः पारिजाततरुर्महान् ।\nशाखोपशाखाविस्तारैः शतयोजनमुच्छ्रितः॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7000613137, "chapter_id": 20613, "verse_number": "५-७२-१३८", "content_sanskrit": "तले तस्याथ विमले परितो धेनुमंडलम् ।\nतदंतर्मंडलं गोपबालानां वेणुशृंगिणाम्॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7000613138, "chapter_id": 20613, "verse_number": "५-७२-१३९", "content_sanskrit": "तदंतरे तु रुचिरं मंडलं व्रज सुभ्रुवाम् ।\nनानोपायनपाणीनां मदविह्वलचेतसाम्॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7000613139, "chapter_id": 20613, "verse_number": "५-७२-१४०", "content_sanskrit": "कृतांजलिपुटानां च मंडलं शुक्लवाससाम् ।\nशुक्लाभरणभूषाणां प्रेमविह्वलितात्मनाम्॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7000613140, "chapter_id": 20613, "verse_number": "५-७२-१४१", "content_sanskrit": "चिंतयेच्छ्रुतिकन्यानां गृह्णतीनां वचः प्रियम् ।\nरत्नवेद्यां ततो ध्यायेद्दुकूलावरणं हरिम्॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7000613141, "chapter_id": 20613, "verse_number": "५-७२-१४२", "content_sanskrit": "ऊरौ शयानं राधायाः कदलीकांडकोपरि ।\nतद्वक्त्रं चंद्र सुस्मेरं वीक्षमाणं मनोहरम्॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7000613142, "chapter_id": 20613, "verse_number": "५-७२-१४३", "content_sanskrit": "किंचित्कुंचितवामांघ्रिं वेणुयुक्तेन पाणिना ।\nवामेनालिंग्य दयितां दक्षेण चिबुकं स्पृशन्॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7000613143, "chapter_id": 20613, "verse_number": "५-७२-१४४", "content_sanskrit": "महामारकताभासं मौक्तिकच्छायमेव च ।\nपुंडरीकविशालाक्षं पीतनिर्मलवाससम्॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7000613144, "chapter_id": 20613, "verse_number": "५-७२-१४५", "content_sanskrit": "बर्हभारलसच्छीर्षं मुक्ताहारमनोहरम् ।\nगंडप्रांतलसच्चारु मकराकृतिकुंडलम्॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7000613145, "chapter_id": 20613, "verse_number": "५-७२-१४६", "content_sanskrit": "आपादतुलसीमालं कंकणांगदभूषणम् ।\nनूपुरैर्मुद्रिकाभिश्च कांच्या च परिमंडितम्॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7000613146, "chapter_id": 20613, "verse_number": "५-७२-१४७", "content_sanskrit": "सुकुमारतरं ध्यायेत्किशोरवयसान्वितम् ।\nपूजा दशाक्षरोक्तैव वेदलक्षं पुरस्क्रिया॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7000613147, "chapter_id": 20613, "verse_number": "५-७२-१४८", "content_sanskrit": "इत्युक्त्वांतर्दधे देवो देवी च गिरिजा सती ।\nमुनिरागत्य पुत्राय तथैवोपदिदेश ह॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7000613148, "chapter_id": 20613, "verse_number": "५-७२-१४९", "content_sanskrit": "पुण्यश्रवास्तु तन्मंत्र ग्रहणादेव केशवम् ।\nवर्णयामास विविधैर्जित्वा सर्वान्मुनीन्स्वयम्॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7000613149, "chapter_id": 20613, "verse_number": "५-७२-१५०", "content_sanskrit": "रूपलावण्यवैदग्ध्य सौंदर्याश्चर्यलक्षणम् ।\nतदा हृष्टमना बालो निर्गत्य स्वगृहात्ततः॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 7000613150, "chapter_id": 20613, "verse_number": "५-७२-१५१", "content_sanskrit": "वायुभक्षस्तपस्तेपे कल्पानामयुतत्रयम् ।\nतदंते गोकुले जाता नंदभ्रातुर्गृहे स्वयम्॥१५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 7000613151, "chapter_id": 20613, "verse_number": "५-७२-१५२", "content_sanskrit": "लवंगा इति तन्नाम कृष्णेंगित निरीक्षणा ।\nयस्या हस्ते प्रदृश्येत मुखमार्जनयंत्रकम्॥१५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 7000613152, "chapter_id": 20613, "verse_number": "५-७२-१५३", "content_sanskrit": "इति ते कथिताः काश्चित्प्रधानाः कृष्णवल्लभाः॥१५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 7000613153, "chapter_id": 20613, "verse_number": "५-७२-१५४", "content_sanskrit": "हरिविविधरसाद्यैर्युक्तमध्यायमेतद्व्रजवरतनयाभिश्चारुहासेक्षणाभिः ।\nपठति य इह भक्त्या पाठयेद्वा मनुष्यो व्रजति भगवतः श्रीवासुदेवस्य धाम॥१५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}]