[{"id": 2135334, "chapter_id": 3932, "verse_number": "१", "content_sanskrit": "युधिष्ठिर महाबाहो शृणु धर्मभृतां वर ।\nनातप्ततपसो लोके प्राप्नुवन्ति महत्सुखम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2135335, "chapter_id": 3932, "verse_number": "२", "content_sanskrit": "सुखदुःखे हि पुरुषः पर्यायेणोपसेवते ।\nनात्यर्थमसुखं कश्चित् प्राप्नोति पुरुषर्षभ \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2135336, "chapter_id": 3932, "verse_number": "३", "content_sanskrit": "प्रज्ञावांस्त्वेव पुरुषः संयुक्तः परया धिया ।\nउदयास्तमयज्ञो हि न हृष्यति न शोचति \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2135337, "chapter_id": 3932, "verse_number": "४", "content_sanskrit": "सुखमापतितं सेवेत् दुःखमापतितं सहेत् ।\nप्राप्तकालमुपासीत सस्यानामिव कर्षकः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2135338, "chapter_id": 3932, "verse_number": "५", "content_sanskrit": "तपसो हि परं नास्ति तपसा विन्दते महत् ।\nनासाध्यं तपसः किञ्चिदिति बुद्ध्यस्व भारत \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2135339, "chapter_id": 3932, "verse_number": "६", "content_sanskrit": "सत्वमार्जवमक्रोधः संविभागो दमः शमः ।\nअनसूयाऽविहिंसा च शौचमिन्द्रियसंयमः ।\nपावनानि महाराज नराणां पुण्यकर्मणाम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2135340, "chapter_id": 3932, "verse_number": "७", "content_sanskrit": "अधर्मरुचयो मूढास्तिर्यग्गतिपरायणाः ।\nकृच्छ्रयोनिमनुप्राप्ता न सुखं विन्दते जनाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2135341, "chapter_id": 3932, "verse_number": "८", "content_sanskrit": "कर्मभूमिरियं तात फलभूमिरसौ परा ।\nइह यत् क्रियते कर्म तत् परत्रोपयुज्यते \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2135342, "chapter_id": 3932, "verse_number": "९", "content_sanskrit": "मूलसिक्तस्य वृक्षस्य फलं शाखासु दृश्यते ।\nतस्माच्छरीरं युञ्जीत तपसा नियमेन च ।\nयथाशक्ति प्रयच्छेत सम्पूज्याभिप्रणम्य च \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2135343, "chapter_id": 3932, "verse_number": "१०", "content_sanskrit": "काले पात्रे च हृष्टात्मा राजन् विगतमत्सरः ।\nसत्यवादी लभेतायुरनायासमनामयम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2135344, "chapter_id": 3932, "verse_number": "११", "content_sanskrit": "अक्रोधनोऽनसूयश्च निर्वृतिं लभते पराम् ।\nदान्तः शमपरः शश्वत् परिक्लेशं न विन्दति ।\nन च तप्यति शान्तात्मा दृष्ट्वा परगतां श्रियम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2135345, "chapter_id": 3932, "verse_number": "१२", "content_sanskrit": "संविभक्ता च दाता च भोगवान् सुखवान् नरः ।\nभवत्यहिंसकश्चैव परमारोग्यमश्नुते \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2135346, "chapter_id": 3932, "verse_number": "१३", "content_sanskrit": "मान्यमानयिता जन्म कुले महति विन्दति ।\nविन्दते सुखमत्यन्तमिह लोके परत्र च ।\nव्यसनैर्न तु संयोगं प्राप्नोति विजितेन्द्रियः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2135347, "chapter_id": 3932, "verse_number": "१४", "content_sanskrit": "शुभानुशयबुद्धिर्हि संयुक्तः कालधर्मणा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2135348, "chapter_id": 3932, "verse_number": "१५", "content_sanskrit": "प्रादुर्भवति तद्योगात् कल्याणमतिरेव सः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2135349, "chapter_id": 3932, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2135350, "chapter_id": 3932, "verse_number": "१६", "content_sanskrit": "भगवन् दानधर्माणां तपसो वा महामुने ।\nकिंस्विद् बहुगुणं प्रेत्य किं वा दुष्करमुच्यते \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2135351, "chapter_id": 3932, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2135352, "chapter_id": 3932, "verse_number": "१७", "content_sanskrit": "दानान्न दुष्करं तात पृथिव्यामस्ति किञ्चन ।\nअर्थे हि महती तृष्णा स च दुःखेन लभ्यते \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2135353, "chapter_id": 3932, "verse_number": "१८", "content_sanskrit": "राजन् प्रत्यक्षमेवै तद् दृश्यते लोकसाक्षिकम् ।\nपरित्यज्य प्रियान् प्राणान् धनार्थं हि रणाजिरम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2135354, "chapter_id": 3932, "verse_number": "१९", "content_sanskrit": "प्रविशन्ति महावीराः समुद्रमटवीं तथा ।\nतथैव प्रतिपद्यन्ते समुद्रमटवीं तथा \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2135355, "chapter_id": 3932, "verse_number": "२०", "content_sanskrit": "कृषिगोरक्षमित्येके प्रतिपद्यन्ति मानवाः ।\nपुरुषाः प्रेष्यतामेके निर्गच्छन्ति धनार्थिनः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2135356, "chapter_id": 3932, "verse_number": "२१", "content_sanskrit": "तस्माद् दुःखार्जितस्यैव परित्यागः सुदुष्करः ।\nन दुष्करतरं दानात् तस्माद् दानं मतं मम \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2135357, "chapter_id": 3932, "verse_number": "२२", "content_sanskrit": "विशेषस्त्वत्र विज्ञेयो न्यायेनोपार्जितं धनम् ।\nपात्रे काले च देशे च साधुभ्यः प्रतिपादयेत् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2135358, "chapter_id": 3932, "verse_number": "२३", "content_sanskrit": "(श्रद्धया विधिवत् पात्रे दत्तस्यान्तो न विद्यते ।)\nअन्यायात् समुपात्तेन दानधर्मो धनेन यः ।\nक्रियते न स कर्तारं त्रायते महतो भयात् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2135359, "chapter_id": 3932, "verse_number": "२४", "content_sanskrit": "पात्रे दानं स्वल्पमपि काले दत्तं युधिष्ठिर ।\nमनसा हि विशुद्धेन प्रेत्यानन्तफलं स्मृतम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2135360, "chapter_id": 3932, "verse_number": "२५", "content_sanskrit": "देशे काले च पात्रे च मुद्गलः श्रद्धयान्वितः ।\nव्रीहिद्रोणं प्रदायाथ परं पदमवाप्तवान्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2135361, "chapter_id": 3932, "verse_number": "२६", "content_sanskrit": "श्रद्धा धर्मानुगा देवी पावनी विश्वधारिणी ।\nसावित्री प्रसवित्री च संसारार्णवतारिणी \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2135362, "chapter_id": 3932, "verse_number": "२७", "content_sanskrit": "श्रद्धया धार्यते धर्मो महद्भिर्नार्थदर्शिभिः ।\nसधना अपि राजानो विःश्रद्धा नरकं गताः ।\nनिष्किञ्चनाश्च मुनयो श्रद्धावन्तो दिवं गताः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2135363, "chapter_id": 3932, "verse_number": "२८", "content_sanskrit": "अत्राप्युदाहरन्तीमम् इतिहासं पुरातनम् ।\nव्रीहिद्रोणपरित्यागाद् यत्फलं प्राप मुद्गलः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2135364, "chapter_id": 3932, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि व्रीहि- द्रौणिकपर्वणि दानदुष्करत्वकथने एकोनपञ्चाशदधिकद्विशततमोऽध्यायः ॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2135365, "chapter_id": 3932, "verse_number": "२", "content_sanskrit": "॥ व्रीहिद्रोणकपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2135366, "chapter_id": 3932, "verse_number": "", "content_sanskrit": "* * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]