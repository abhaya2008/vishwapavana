[{"id": 2070241, "chapter_id": 2472, "verse_number": "११-६-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070242, "chapter_id": 2472, "verse_number": "११-६-१", "content_sanskrit": "अहो खलु महद्दुःखं कृच्छ्रवासं वसत्यसौ।\nकथं तस्य रतिस्तत्र तुष्टिर्वा वदतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070243, "chapter_id": 2472, "verse_number": "११-६-२", "content_sanskrit": "स देशः क्वनु यत्रासौ वसते धर्मसङ्कटे।\nकथं वा स विमुच्येत नरस्तस्मान्महाभयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070244, "chapter_id": 2472, "verse_number": "११-६-३", "content_sanskrit": "एतन्मे सर्वमाचक्ष्व साधु चेष्टामहे तदा।\nकृपा मे महती जाता तस्याभ्युद्धरणेन हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070245, "chapter_id": 2472, "verse_number": "११-६-४x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070246, "chapter_id": 2472, "verse_number": "११-६-४", "content_sanskrit": "उपाख्यानमिदं राजन्मोक्षविद्भिरुदाहृतम्।\nसुगतिं विन्दते येन परलोकेषु मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070247, "chapter_id": 2472, "verse_number": "११-६-५", "content_sanskrit": "उच्यते यत्तु कान्तारं महासंसार एव सः।\nवनं दुर्गं हि यच्चैतत्संसारगहनं हि तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070248, "chapter_id": 2472, "verse_number": "११-६-६", "content_sanskrit": "ये च ते कथिता व्याला व्याधयस्ते प्रकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070249, "chapter_id": 2472, "verse_number": "११-६-७", "content_sanskrit": "या सा नारी बृहत्काया अध्यतिष्ठत तत्र वै।\nतामाहुस्तु जरां प्राज्ञा रूपवर्णविनाशिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070250, "chapter_id": 2472, "verse_number": "११-६-८", "content_sanskrit": "स यस्तु कूपो नृपते स तु देहः शरीरिणाम्।\nयस्तत्र वसतेऽधस्तान्महाहिः काल एव सः।\nअन्तकः सर्वभूतानां देहिनां प्राणाहार्यसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070251, "chapter_id": 2472, "verse_number": "११-६-९", "content_sanskrit": "कूपमध्ये च या जाता वल्ली यत्र स मानवः।\nप्रोतो ययाऽभवल्लग्नो जीविताशा शरीरिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070252, "chapter_id": 2472, "verse_number": "११-६-१०", "content_sanskrit": "स यस्तु कूपपीनाहे तं वृक्षं परिसर्पति।\nषड्वक्त्रः कुञ्जरो राजन्स तु संवत्सरः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070253, "chapter_id": 2472, "verse_number": "११-६-११", "content_sanskrit": "मुखानि ऋतवो मासाः पादा द्वादशा कीर्तिताः।\nये तु वृंक्षं निकृन्तन्ति मूषिकाः पन्नगास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070254, "chapter_id": 2472, "verse_number": "११-६-१२", "content_sanskrit": "रात्र्यहानि तु तान्याहुर्भूतानां परिचिन्तकाः।\nये ते मधुकरास्तत्र कामास्ते परिकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070255, "chapter_id": 2472, "verse_number": "११-६-१३", "content_sanskrit": "यास्तु ता बहुशो धाराः स्रवन्ति मधुनिस्रवम्।\nतांस्तु कामरसान्विन्द्याद्यत्र सज्जन्ति मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070256, "chapter_id": 2472, "verse_number": "११-६-१४", "content_sanskrit": "एवं संसारचक्रस्य परिवृत्तिं विदुर्बुधाः।\nयेन संसारचक्रस्य पाशांश्छिन्दन्ति सर्वथा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070257, "chapter_id": 2472, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि जलप्रदानिकपर्वणि पञ्चमोऽध्यायः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]