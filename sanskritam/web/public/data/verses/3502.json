[{"id": 2116258, "chapter_id": 3502, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2116259, "chapter_id": 3502, "verse_number": "१", "content_sanskrit": "आश्रमस्था ततः पुत्रमदृश्यन्ती व्यजायत ।\nशक्तेः कुलकरं राजन् द्वितीयमिव शक्तिनम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2116260, "chapter_id": 3502, "verse_number": "२", "content_sanskrit": "जातकर्मादिकास्तस्य क्रियाः स मुनिपुङ्गवः ।\nपौत्रस्य भरतश्रेष्ठ चकार भगवान् स्वयम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2116261, "chapter_id": 3502, "verse_number": "३", "content_sanskrit": "परासुत्वमयन् येन वसिष्ठस्थापितस्तदा ।\nगर्भस्तेन ततो लोके पराशर इति स्मृतः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2116262, "chapter_id": 3502, "verse_number": "४", "content_sanskrit": "अमन्यत स धर्मात्मा वसिष्ठं पितरं तदा ।\nजन्मप्रभृति तस्मिंस्तु पितरीव व्यवर्तत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2116263, "chapter_id": 3502, "verse_number": "५", "content_sanskrit": "स तात इति विप्रर्षिं वसिष्ठं प्रत्यभाषत ।\nमातुः समीपे कौन्तेय अदृश्यन्त्या नराधिप \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2116264, "chapter_id": 3502, "verse_number": "६", "content_sanskrit": "तातेति परिपूर्णार्थं तस्येदं मधुरं वचः ।\nअदृश्यन्त्यश्रुपूर्णाक्षी शृण्वन्ती तमुवाच ह \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2116265, "chapter_id": 3502, "verse_number": "७", "content_sanskrit": "मा तात ताततातेति न ते तातो महामुनिः ।\nरक्षसा भक्षितस्तात तव तातो महामुनिः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2116266, "chapter_id": 3502, "verse_number": "८", "content_sanskrit": "मन्यसे यं तु तातं त्वं नैव तातस्तवानघ ।\nआर्यस्त्वेष पिता तस्य पितुस्तव मनस्विनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2116267, "chapter_id": 3502, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2116268, "chapter_id": 3502, "verse_number": "१०", "content_sanskrit": "स एवमुक्तो दुःखार्तः सत्यवागृषिसत्तमः ।\nसर्वलोकविनाशाय मतिं चक्रे महातपाः ।\nवसिष्ठो वारयामास हेतुना येन तच्छृणु \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2116269, "chapter_id": 3502, "verse_number": "", "content_sanskrit": "वसिष्ठः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2116270, "chapter_id": 3502, "verse_number": "११", "content_sanskrit": "कृतवीर्य इति ख्यातो बभूव नृपतिः क्षितौ ।\nयाज्यो वेदविदां लोके भृगूणां पार्थिवर्षभ \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2116271, "chapter_id": 3502, "verse_number": "१२", "content_sanskrit": "स तानन्वग्रहीत् तात धान्येन च धनेन च ।\nसोमेन तर्पयामास विपुलेन विशाम्पतिः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2116272, "chapter_id": 3502, "verse_number": "१३", "content_sanskrit": "तस्मिंस्तु नृपशार्दूले स्वर्यातेऽथ कदाचन ।\nबभूव तत्कुले राज्ञां द्रव्यकार्यमुपस्थितम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2116273, "chapter_id": 3502, "verse_number": "१४", "content_sanskrit": "ते भृगूणां धनं ज्ञात्वा राजानः सर्व एव हि ।\nयाचिष्णवोऽभिजग्मुस्तान् तात भार्गवनन्दनान् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2116274, "chapter_id": 3502, "verse_number": "१५", "content_sanskrit": "भूमौ तु निदधुः केचिद् भृगवो धनमक्षयम् ।\nददुः केचिद् द्विजातिभ्यो ज्ञात्वा क्षत्रियतो भयम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2116275, "chapter_id": 3502, "verse_number": "१६", "content_sanskrit": "भृगवस्तु ददुः केचित् तेषां वित्तं यथेप्सितम् ।\nक्षत्रियाणां तदा तात कारणान्तरदर्शनात्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2116276, "chapter_id": 3502, "verse_number": "१७", "content_sanskrit": "ततो महीतळं तात क्षत्रियेण यदृच्छया ।\nखनताऽधिगतं वित्तं कस्मिंश्चिद् भृगुवेश्मनि \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2116277, "chapter_id": 3502, "verse_number": "१८", "content_sanskrit": "तद्वित्तं ददृशुः सर्वे समेताः क्षत्रियर्षभ ।\nअवमत्य ततः क्रोधाद् भृगूंस्ते शरणागतान् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2116278, "chapter_id": 3502, "verse_number": "१९", "content_sanskrit": "निजघ्नुस्ते महेष्वास बहून् वै निशितैः शरैः ।\nआगर्भादनुकृन्तन्तश्चेरुश्चैव वसुन्धराम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2116279, "chapter_id": 3502, "verse_number": "२०", "content_sanskrit": "तत उत्साद्यमानेषु भृगुष्वेवं भयात् तदा ।\nभृगुपत्न्यो गिरिं तात हिमवन्तं प्रपेदिरे \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2116280, "chapter_id": 3502, "verse_number": "२१", "content_sanskrit": "तासामन्यतमा गर्भं धारयामास तेजसा ।\nऊरुणेकेन वामोरूः भर्तुः कुलविवृद्धये \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2116281, "chapter_id": 3502, "verse_number": "२२", "content_sanskrit": "तं गर्भमुपलभ्याथ ब्राह्मण्योऽन्या भयार्दिताः ।\nगत्वा वै कथयामासुः क्षत्रियाणामुपान्तिके \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2116282, "chapter_id": 3502, "verse_number": "२३", "content_sanskrit": "ततस्ते क्षत्रिया जग्मुः तं गर्भं हन्तुमुद्यताः ।\nददृशुर्ब्राह्मणीं तां ते दीप्यमानां स्वतेजसा \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2116283, "chapter_id": 3502, "verse_number": "२४", "content_sanskrit": "अथ गर्भः स भित्त्वोरुं ब्राह्मण्या निर्जगाम ह ।\nमुष्णन् दृष्टीः क्षत्रियाणां मध्याह्न इव भास्करः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2116284, "chapter_id": 3502, "verse_number": "२५", "content_sanskrit": "ततश्चक्षुर्विहीनास्ते गिरिदुर्गेषु बभ्रमुः ।\nततस्ते मोघसङ्कल्पा भयार्ताः क्षत्रियाः पुनः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2116285, "chapter_id": 3502, "verse_number": "२६", "content_sanskrit": "ब्राह्मणीं शरणं जग्मुः दृष्ट्यर्थं तामनिन्दिताम् ।\nऊचुश्चैनां महाभागां क्षत्रियास्ते विचेतसः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2116286, "chapter_id": 3502, "verse_number": "२७", "content_sanskrit": "ज्योतिःप्रहीणा दुःखार्ताः शान्तार्चिष इवाग्नयः ।\nतवापत्यप्रसादेन गच्छेत् क्षत्रं निरामयम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2116287, "chapter_id": 3502, "verse_number": "२८", "content_sanskrit": "पापादस्मादुपारम्य पश्येम च तथा पुनः ।\nसपुत्रा त्वं प्रसादं नः सर्वेषां कर्तुमर्हसि ।\nपुनर्दृष्टिप्रसादेन क्षत्रियांस्त्रातुमर्हसि \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2116288, "chapter_id": 3502, "verse_number": "१४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकाशीत्यधिकशततमोऽध्यायः ॥१८१॥ इति चैत्ररथपर्वणि चतुर्दशोऽध्यायः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2116289, "chapter_id": 3502, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]