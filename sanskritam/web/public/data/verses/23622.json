[{"id": 7003622000, "chapter_id": 23622, "verse_number": "१-२-९-१", "content_sanskrit": "उलूक उवाच ।\nइतिदमुक्तमखिलं पूर्वजन्मसमुद्भवम् ।\nस्वरूपमायुषो हेतुः कौशिकत्वस्य चेति मे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003622001, "chapter_id": 23622, "verse_number": "१-२-९-२", "content_sanskrit": "इत्युक्त्वा विरते तस्मिन्पुरूहूतसनामनि ।\nनाडीजंघो बको मित्रमाह तं दुःखितो वचः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003622002, "chapter_id": 23622, "verse_number": "१-२-९-३", "content_sanskrit": "नाडीजंघ उवाच ।\nयदर्थं वयमायातास्तन्न सिद्धं महामते ।\nकार्यं तन्मरणं नूनं त्रयाणामप्युपागतम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003622003, "chapter_id": 23622, "verse_number": "१-२-९-४", "content_sanskrit": "इंद्रद्युम्नापरिज्ञाने भद्रकोऽयं मुमूर्षति ।\nतस्यानु मित्रं मार्कंडस्तं चान्वहमपि स्फुटम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003622004, "chapter_id": 23622, "verse_number": "१-२-९-५", "content_sanskrit": "मित्रकार्ये विनिर्वृत्ते म्रियमाणं निरीक्षते ।\nयो मित्रं जीवितं तस्य धिगस्निग्धं दुरात्मनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003622005, "chapter_id": 23622, "verse_number": "१-२-९-६", "content_sanskrit": "तदेतावनुयास्यामि म्रियमाणावहं द्विज ।\nआपृच्छे त्वां नमस्कार आश्लेषश्चाथपश्चिमः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003622006, "chapter_id": 23622, "verse_number": "१-२-९-७", "content_sanskrit": "प्रतिज्ञातमनिष्पाद्य मित्रस्याभ्यागतस्य च ।\nकथंकारं न लज्जंते हताशा जीवितेप्सवः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003622007, "chapter_id": 23622, "verse_number": "१-२-९-८", "content_sanskrit": "तस्माद्वह्निं प्रवेक्ष्यामि सार्धमाभ्यामसंशयम् ।\nआपृष्टोऽस्यधुना स्नेहान्मम देहि जलांजलिम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003622008, "chapter_id": 23622, "verse_number": "१-२-९-९", "content_sanskrit": "इत्युक्तवत्युलूकोऽसौ नाडीजंघे सगद्गदम् ।\nसाश्रुनेत्रं स्थिरीभूय प्राह वाचं सुधासमुचम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003622009, "chapter_id": 23622, "verse_number": "१-२-९-१०", "content_sanskrit": "उलूक उवाच ।\nमयि जीवति मित्रे मे भवान्मरणमेति च ।\nअद्यप्रभृति कस्तर्हि हृदा मम लभिष्यति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003622010, "chapter_id": 23622, "verse_number": "१-२-९-११", "content_sanskrit": "अस्त्युपायो महानत्र गन्धमादनपर्वते ।\nमत्तश्चिरायुर्मित्रोस्ति गृध्रः प्राणसमः सुहृत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003622011, "chapter_id": 23622, "verse_number": "१-२-९-१२", "content_sanskrit": "स विज्ञास्यति वोऽभीष्टमिंद्रद्युम्नं महीपतिम् ।\nइत्युक्त्वा पुरतस्तस्थावुलूकः स च भूपतिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003622012, "chapter_id": 23622, "verse_number": "१-२-९-१३", "content_sanskrit": "मार्कंडेयो बकश्चैव प्रययुर्गंधमादनम् ।\nतमायांतमथालोक्य वयस्यं पुरतः स्थितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003622013, "chapter_id": 23622, "verse_number": "१-२-९-१४", "content_sanskrit": "स्वकुलायात्प्रहृष्टोऽसौ गृध्रः संमुखमाययौ ।\nकृतसंविदसौ पूर्वं स्वागतासनभोजनैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003622014, "chapter_id": 23622, "verse_number": "१-२-९-१५", "content_sanskrit": "उलूकं गृध्रराजश्च कार्यं पप्रच्छ तं तथा ।\nम चाचख्यावयं मित्रं बको मेऽस्य मुनिः किल ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003622015, "chapter_id": 23622, "verse_number": "१-२-९-१६", "content_sanskrit": "मुनेरपि तृतीयोऽयं मित्रं चार्थोयमुद्यतः ।\nइंद्रद्युम्नपरिज्ञाने स्वयं जीवति नान्यथा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003622016, "chapter_id": 23622, "verse_number": "१-२-९-१७", "content_sanskrit": "वह्निं प्रवेक्ष्यते व्यक्तमयं तदनु वै वयम् ।\nमया निषिद्धोऽयं ज्ञात्वा त्वां चिरंतनमात्मना ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003622017, "chapter_id": 23622, "verse_number": "१-२-९-१८", "content_sanskrit": "तच्चेज्जानासि तं ब्रूहि चतुर्णां देहि जीवितम् ।\nसरं क्ष्याप्नुहि सत्कीर्तिं क्षयं चाखिलपाप्मनः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003622018, "chapter_id": 23622, "verse_number": "१-२-९-१९", "content_sanskrit": "गृध्र उवाच ।\nषट्पंचाशद्व्यतीता मे कल्पा जातस्य कौशिक ।\nन दृष्टो न श्रुतोऽस्माभिरिंद्रद्युम्नो महीपतिः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003622019, "chapter_id": 23622, "verse_number": "१-२-९-२०", "content_sanskrit": "तच्छ्रुत्वा विस्मयाविष्ट इंद्रद्युम्नोऽपि दुःखितः ।\nपप्रचछ जीविते हेतुमतिमात्रे विहंगमम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003622020, "chapter_id": 23622, "verse_number": "१-२-९-२१", "content_sanskrit": "गृध्र उवाच ।\nश्रृणु भद्रै पुरा जातो मर्कटोऽहं च चापलः ।\nआसं कदाचिदभवद्वसंतोऽथ ऋतुः क्रमात् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003622021, "chapter_id": 23622, "verse_number": "१-२-९-२२", "content_sanskrit": "तत्राग्रे देवदेवस्य वनमध्ये शिवालये ।\nभवोद्भवस्य पुरतो जगद्योगेश्वराभिधे ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003622022, "chapter_id": 23622, "verse_number": "१-२-९-२३", "content_sanskrit": "चतुर्दशीदिने हस्तनक्षत्रे हर्षणाभिधे ।\nयोगे चैत्रे सिते पक्ष आसीद्दमनकोत्सवः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003622023, "chapter_id": 23622, "verse_number": "१-२-९-२४", "content_sanskrit": "अत्र सौवर्ण्यदोलायां लिंग आरोपिते जनैः ।\nनिशायामधिरूह्याऽहं दोलां तां च व्यचालयम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003622024, "chapter_id": 23622, "verse_number": "१-२-९-२५", "content_sanskrit": "निसर्गाज्जतिचापल्याच्चिरकालं पुनःपुनः ।\nअथ प्रभात आयाता जनाः पूजाकृते कपिम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003622025, "chapter_id": 23622, "verse_number": "१-२-९-२६", "content_sanskrit": "दोलाधिरूढमालोक्य लकुटैर्मां व्यताडयन् ।\nदोलासंस्थित एवाहं प्रमीतः शिवमंदिरे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003622026, "chapter_id": 23622, "verse_number": "१-२-९-२७", "content_sanskrit": "तेषां प्रहारैः सुदृढैर्बहुभिर्वज्रदुःसहैः ।\nशिवांदोलनमाहात्म्याज्जातोऽहं नृपमंदिरे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003622027, "chapter_id": 23622, "verse_number": "१-२-९-२८", "content_sanskrit": "काशीश्वरस्य तनयः प्रतीतोऽस्मि कुशध्वजः ।\nजाति स्मरस्ततो राज्ये क्रमात्प्राप्याहमैश्वरम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003622028, "chapter_id": 23622, "verse_number": "१-२-९-२९", "content_sanskrit": "कारयामि धरापृष्ठे चैत्रे दमनकोत्सवम् ।\nयता यथा दोलयति शिवं दोलास्थितं नरः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003622029, "chapter_id": 23622, "verse_number": "१-२-९-३०", "content_sanskrit": "तथा तथाऽशुभं याति पुण्यमायाति भद्रक ।\nशिवदीक्षामुपागम्याखिलसंस्कारसंस्कृतः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003622030, "chapter_id": 23622, "verse_number": "१-२-९-३१", "content_sanskrit": "शिवाचार्यैर्विमुक्तोऽहं पशुपाशैस्तदागमात् ।\nनिर्वाहदीक्षापर्यंतान्संस्कारान्प्राप्य सर्वतः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003622031, "chapter_id": 23622, "verse_number": "१-२-९-३२", "content_sanskrit": "आराधयामि देवेशं प्रत्यक्चित्तमुमापतिम् ।\nसमस्तक्लेशविच्छेदकारणं जगतां गुरुम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003622032, "chapter_id": 23622, "verse_number": "१-२-९-३३", "content_sanskrit": "चित्तवृत्तिनिरोधेन वैराग्याभ्यासयोगतः ।\nजपन्नुद्गीतमस्यार्थं भावयन्नष्टमं रसम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003622033, "chapter_id": 23622, "verse_number": "१-२-९-३४", "content_sanskrit": "ततो मां प्रणिधानेनाभ्यासेन दृढभूमिना ।\nअन्तरायानुपहतं ज्ञात्वा तुष्टोऽब्रवीद्धरः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003622034, "chapter_id": 23622, "verse_number": "१-२-९-३५", "content_sanskrit": "ईश्वर उवाच ।\nकुशध्वजाहं तुष्टोद्य वरं वरय वांछितम् ।\nन हीदृशमनुष्ठानं कस्याप्यस्ति महीतले ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003622035, "chapter_id": 23622, "verse_number": "१-२-९-३६", "content_sanskrit": "श्रुत्वेत्युक्तो मया शम्भुर्भूयासं ते गंणो ह्यहम् ।\nअनेनैव शरीरेण तथेत्येवाह गां प्रभुः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003622036, "chapter_id": 23622, "verse_number": "१-२-९-३७", "content_sanskrit": "ततः कैलासमानीय विमानं मम चादिशत् ।\nसर्वरत्नमयं दिव्यं दिव्याश्चर्यसमावृतम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003622037, "chapter_id": 23622, "verse_number": "१-२-९-३८", "content_sanskrit": "विचरामि प्रतीतोऽहं तदारूढो यदृच्छया ।\nअथ काले कियन्मात्रे व्यतीतेऽत्रैवं पर्वते ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003622038, "chapter_id": 23622, "verse_number": "१-२-९-३९", "content_sanskrit": "गवाक्षाधिष्ठितोऽपश्यं वसंते मुनिकन्यकाम् ।\nप्रवाति दक्षिणे वायौ मदनाग्निप्रदीपितः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003622039, "chapter_id": 23622, "verse_number": "१-२-९-४०", "content_sanskrit": "अग्निवेश्यसुतां भद्र विवस्त्रां जलमध्यगाम् ।\nउद्भिन्नयौवनां श्यामां मध्यक्षामां मृगेक्षणाम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003622040, "chapter_id": 23622, "verse_number": "१-२-९-४१", "content_sanskrit": "विस्तीर्णजघनाभोगां रंभोरुं संहतस्तनीम् ।\nतामंकुरितलावण्यां जलसेका दिवाग्रतः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003622041, "chapter_id": 23622, "verse_number": "१-२-९-४२", "content_sanskrit": "प्रोन्निद्रपंकजमुखीं वर्णनीयतमाकृतिम् ।\nयथाप्रज्ञानयाथात्म्याद्विद्विद्भिरपि वर्णिनीम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003622042, "chapter_id": 23622, "verse_number": "१-२-९-४३", "content_sanskrit": "प्रोद्यत्कटाक्षविक्षेपैः शरव्रातैरिव स्मरः ।\nस्वयं तदंगमास्थाय ताडयामास मां दृढम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003622043, "chapter_id": 23622, "verse_number": "१-२-९-४४", "content_sanskrit": "वयस्यासंवृचामेवं खेलमानां यदृच्छया ।\nअवतीर्याहमहरं विमानान्मदनातुरः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003622044, "chapter_id": 23622, "verse_number": "१-२-९-४५", "content_sanskrit": "सा गृहीता मया दीर्घं प्रकुर्वाणा महास्वनम् ।\nतातेति च विमानस्था रुरोदातीव भद्रक ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003622045, "chapter_id": 23622, "verse_number": "१-२-९-४६", "content_sanskrit": "ततो वयस्यास्ता दीना मुनिमाहुः प्रधाविताः ।\nवैमानिकेन केनापि ह्रियते तव पुत्रिका ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003622046, "chapter_id": 23622, "verse_number": "१-२-९-४७", "content_sanskrit": "रुदन्तीं भगवन्नेतां त्राह्युत्तिष्ठेति सर्वतः ।\nतासां तदाकर्ण्य वचो मुनिर्भद्रतपोनिधिः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003622047, "chapter_id": 23622, "verse_number": "१-२-९-४८", "content_sanskrit": "अग्निवेश्योऽभ्यगात्तस्या व्योमन्युपपदं त्वरन् ।\nतिष्ठतिष्ठेति मामुक्त्वा संस्तभ्य तपसा गतिम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003622048, "chapter_id": 23622, "verse_number": "१-२-९-४९", "content_sanskrit": "ततः प्रकुपितः प्राह मुनिमामति दुःसहम् ।\nअग्निवेश्य उवाच ।\nयस्मान्मदीया तनया मांसपेशीव ते हृता ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003622049, "chapter_id": 23622, "verse_number": "१-२-९-५०", "content_sanskrit": "गृध्रेणेवाऽधुना व्योम्नि तस्माद्गध्रो भव द्रुतम् ।\nअनिच्छंती मदीयेयं सुता बाला तपस्विनी ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003622050, "chapter_id": 23622, "verse_number": "१-२-९-५१", "content_sanskrit": "त्वया हृताधुनास्यैतत्फलमाप्नुहि दुर्मते ।\nइत्याकर्ण्य भयाविष्टो लज्जयाधोमुखो मुनेः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003622051, "chapter_id": 23622, "verse_number": "१-२-९-५२", "content_sanskrit": "पादौ प्रगृह्य न्यपतं रुदन्नतितरां तदा ।\nन मयेयं परिज्ञाय हृता नाद्यापि धर्षिता ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003622052, "chapter_id": 23622, "verse_number": "१-२-९-५३", "content_sanskrit": "प्रसादं कुरु ते शापं व्यावर्तय तपोनिधे ।\nप्रणतेषु क्षमावन्तो निसर्गेण तपोधनाः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003622053, "chapter_id": 23622, "verse_number": "१-२-९-५४", "content_sanskrit": "भवंति संतस्तद्गृध्रो मा भवेयं प्रसीद मे ।\nइति प्रपन्नेन मया प्रणतोऽसौ महामुनिः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003622054, "chapter_id": 23622, "verse_number": "१-२-९-५५", "content_sanskrit": "प्रसन्नः प्राह नो मिथ्या मम वाक्यं भवेत्क्वचित् ।\nकिं त्विंद्रद्युम्नभूपालपरिज्ञाने सहायताम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003622055, "chapter_id": 23622, "verse_number": "१-२-९-५६", "content_sanskrit": "यदा यास्यसि शापस्य तदा मुक्तिमवाप्स्यसि ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003622056, "chapter_id": 23622, "verse_number": "१-२-९-५७", "content_sanskrit": "इत्युक्त्वा स मुनिः प्रायाद्गृहीत्वा निजकन्यकाम् ।\nअखण्डशीलां स्वावासमहं गृध्रोऽभवं तदा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003622057, "chapter_id": 23622, "verse_number": "१-२-९-५८", "content_sanskrit": "एवं तदा दमनकोत्सव ईश्वरस्य आंदोलनेन नृपवेश्मनि मेऽवतारः ।\nशम्भोर्गणत्वमभवच्च तथाग्निवेश्यशापेन गृध्र इह भद्र तवेदमुक्तम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]