[{"id": 2177043, "chapter_id": 4742, "verse_number": "", "content_sanskrit": "कृपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2177044, "chapter_id": 4742, "verse_number": "१", "content_sanskrit": "अशिश्रूषुः सुदुर्मेधाः पुरुषोऽनियतेन्द्रियः ।\nनालं वेदयितुं कृत्स्नौ धर्मार्थाविति मे मतिः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2177045, "chapter_id": 4742, "verse_number": "२", "content_sanskrit": "तथैव तावन्मेधावी विनयं यो न शिक्षति ।\nन कथञ्चन जानाति सोऽपि धर्मार्थनिश्चयम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2177046, "chapter_id": 4742, "verse_number": "", "content_sanskrit": "(मुहूर्तमपि तं प्राज्ञः पण्डितं पर्युपास्य हि ।\nक्षिप्रं धर्मं विजानाति जिह्वा सूपरसानिव\t॥३॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2177047, "chapter_id": 4742, "verse_number": "४", "content_sanskrit": "शुश्रूषुस्त्वेव मेधावी पुरुषो नियतेन्द्रियः ।\nजानीयादागमान् सर्वान् ग्राह्यं च न विरोधयेत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2177048, "chapter_id": 4742, "verse_number": "५", "content_sanskrit": "अनेयस्त्वतिमानी च दुरात्मा पापपूरुषः ।\nधृष्टमुत्सृज्य कल्याणं करोति बहुपातकम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2177049, "chapter_id": 4742, "verse_number": "६", "content_sanskrit": "नाथवन्तं तु सुहृदं प्रतिषेधति पातकान् ।\nनिवर्तते च लक्ष्मीवान् नालक्ष्मीवान् निवर्तते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2177050, "chapter_id": 4742, "verse_number": "७", "content_sanskrit": "यथा ह्युच्चावचैर्वाक्यैः क्षिप्तचित्तो नियम्यते ।\nतथैव सुहृदा शक्यस्त्वशक्यस्त्ववसीदति\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2177051, "chapter_id": 4742, "verse_number": "८", "content_sanskrit": "तथैव सुहृदोऽप्राज्ञान् कुर्वाणान् कर्म पापकम् ।\nप्राज्ञाः सम्प्रतिषेधन्ते यथाशक्ति पुनः पुनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2177052, "chapter_id": 4742, "verse_number": "९", "content_sanskrit": "स कल्याणं मनः कृत्वा नियम्यात्मानमात्मना ।\nकुरु मे वचनं तात येन पश्चान्न तप्स्यसे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2177053, "chapter_id": 4742, "verse_number": "१०", "content_sanskrit": "न वधः पूज्यते लोके सुप्तानामिह धर्मतः ।\nतथैव न्यस्तशस्त्राणां विमुक्तरथवाजिनाम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2177054, "chapter_id": 4742, "verse_number": "११", "content_sanskrit": "ये च ब्रूयुस्तवास्मीति ये च स्युः शरणागताः ।\nविमुक्तमूर्धजा ये च ये चापि हतवाहनाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2177055, "chapter_id": 4742, "verse_number": "१२", "content_sanskrit": "अद्य स्वप्स्यन्ति पाञ्चाला विमुक्तकवचाः प्रभो ।\nविश्वस्ता रजनीं सर्वे प्रेता इव विचेतसः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2177056, "chapter_id": 4742, "verse_number": "१३", "content_sanskrit": "यस्तेषां तदवस्थानां द्रुह्यते पुरुषोऽनृजुः ।\nव्यक्तं स नरके मज्जेद् अगाधे विपुलेऽल्पवे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2177057, "chapter_id": 4742, "verse_number": "१४", "content_sanskrit": "सर्वास्त्रविदुषां लोके श्रेष्ठस्त्वमसि विश्रुतः ।\nन च ते जातु लोकेऽस्मिन् सुसूक्ष्ममपि किल्बिषम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2177058, "chapter_id": 4742, "verse_number": "१५", "content_sanskrit": "त्वं पुनः सूर्यसङ्काशः श्वोभूत उदिते रवौ ।\nप्रकाशे सर्वभूतानां विजेता युधि शात्रवान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2177059, "chapter_id": 4742, "verse_number": "१६", "content_sanskrit": "असम्भावितरूपं हि त्वयि कर्म विगर्हितम् ।\nशुक्ले रक्तमिव न्यस्तं भवेदिति मतिर्मम\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2177060, "chapter_id": 4742, "verse_number": "", "content_sanskrit": "अश्वत्थामा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2177061, "chapter_id": 4742, "verse_number": "१७", "content_sanskrit": "एवमेतद् यथाऽऽत्थ त्वमनुशाससि मातुल ।\nतैस्तु धर्मो ह्ययं सेतुः शतधा विदळीकृतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2177062, "chapter_id": 4742, "verse_number": "१८", "content_sanskrit": "प्रत्यक्षं भूमिपालानां भवतां चापि सन्निधौ ।\nन्यस्तशस्त्रो मम पिता धृष्टद्युम्नेन पातितः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2177063, "chapter_id": 4742, "verse_number": "१९", "content_sanskrit": "कर्णश्च पतिते चक्रे उत्थास्यन् रथिनां वरः ।\nउत्तमे व्यसने मग्नो हतो गाण्डीवधन्वना\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2177064, "chapter_id": 4742, "verse_number": "", "content_sanskrit": "(तथा शान्तनवो भीष्मो न्यस्तशस्त्रो निरायुधः ।\nशिखण्डिनं पुरस्कृत्य हतो गाण्डीवधन्वना\t॥२०॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2177065, "chapter_id": 4742, "verse_number": "२१", "content_sanskrit": "भूरिश्रवा महेष्वासः तथा प्रायगतो रणे ।\nक्रोशतां भूमिपालानां युयुधानेन पातितः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2177066, "chapter_id": 4742, "verse_number": "२२", "content_sanskrit": "एकाकी बहुभिस्तत्र परिवार्य महारथैः ।\nअधर्मेण नरव्याघ्रो भीमसेनेन पातितः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2177067, "chapter_id": 4742, "verse_number": "२३", "content_sanskrit": "विलापो भग्नसक्थस्य यो मे राज्ञः परिश्रुतः ।\nवादिकानां कथयतां स मे मर्माणि कृन्तति\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2177068, "chapter_id": 4742, "verse_number": "२४", "content_sanskrit": "एवं चाधार्मिकाः पापाः पाञ्चाला भिन्नसेतवः ।\nतानेवं भिन्नमर्यादान् किं भवान् न विगर्हति\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2177069, "chapter_id": 4742, "verse_number": "२५", "content_sanskrit": "पितृहन्तॄनहं हत्वा पाञ्चालान् निशि सौप्तिके ।\nकामं कीटः पतङ्गो वा जन्म प्राप्य भवामि वै\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2177070, "chapter_id": 4742, "verse_number": "२६", "content_sanskrit": "त्वरे चाहमनेनाद्य यदिदं मे चिकीर्षितम् ।\nतस्य मे त्वरमाणस्य कुतो निद्रा कुतः सुखम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2177071, "chapter_id": 4742, "verse_number": "२७", "content_sanskrit": "न स जातः पुमान् लोके कश्चिन्न च भविष्यति ।\nयो मे व्यावर्तयेदेतां वधे तेषां कृतां मतिम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2177072, "chapter_id": 4742, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2177073, "chapter_id": 4742, "verse_number": "२८", "content_sanskrit": "एवमुक्त्वा महाराज द्रोणपुत्रः प्रतापवान् ।\nएकान्ते योजयित्वाऽश्वान् प्रायादभिमुखः परान्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2177074, "chapter_id": 4742, "verse_number": "२९", "content_sanskrit": "तमब्रूतां महाभागौ भोजशारद्वतावुभौ\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2177075, "chapter_id": 4742, "verse_number": "", "content_sanskrit": "कृपकृतवर्माणौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2177076, "chapter_id": 4742, "verse_number": "३०", "content_sanskrit": "किमयं स्यन्दनो युक्तः किं च कार्यं चिकीर्षितम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2177077, "chapter_id": 4742, "verse_number": "३१", "content_sanskrit": "एकसार्थं प्रयाताः स्म त्वया सह नरर्षभ ।\nसमदुःखसुखाश्चैव तस्माच्छासितुमर्हसि\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2177078, "chapter_id": 4742, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2177079, "chapter_id": 4742, "verse_number": "३२", "content_sanskrit": "अश्वत्थामा तु सङ्क्रुद्धः पितुर्वधमनुस्मरन् ।\nताभ्यां तथ्यं तथाऽऽचख्यौ यदस्यात्मचिकीर्षितम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2177080, "chapter_id": 4742, "verse_number": "", "content_sanskrit": "द्रौणिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2177081, "chapter_id": 4742, "verse_number": "३३", "content_sanskrit": "हत्वा शतसहस्राणि योधानां निशितैः शरैः ।\nन्यस्तशस्त्रो मम पिता धृष्टद्युम्नेन पातितः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2177082, "chapter_id": 4742, "verse_number": "३४", "content_sanskrit": "तं तथैव हनिष्यामि न्यस्तवर्माणमाहवे ।\nपुत्रं पाञ्चालराजस्य पापं पापेन कर्मणा\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2177083, "chapter_id": 4742, "verse_number": "३५", "content_sanskrit": "कथं विनिहतः पापः पाञ्चाल्यः पशुवन्मया ।\nशस्त्राग्निविजितान् लोकान् प्राप्नुयादिति मे मतिः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2177084, "chapter_id": 4742, "verse_number": "३६", "content_sanskrit": "क्षिप्रं सन्नद्धकवचौ सखड्गौ सहकार्मुकौ ।\nमामास्थाय प्रतीक्षेतां रथस्थौ च परन्तपौ\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2177085, "chapter_id": 4742, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2177086, "chapter_id": 4742, "verse_number": "३७", "content_sanskrit": "इत्युक्त्वा रथमास्थाय प्रायादभिमुखः परान् ।\nतमन्वगात् कृपो राजन् कृतवर्मा च सात्वतः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2177087, "chapter_id": 4742, "verse_number": "३८", "content_sanskrit": "ते प्रयाता व्यरोचन्त परानभिमुखास्त्रयः ।\nहूयमाना यथा यज्ञे समिद्धा हव्यवाहनाः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2177088, "chapter_id": 4742, "verse_number": "३९", "content_sanskrit": "ययुश्च शिबिरं तेषां सम्प्रसुप्तजनं विभो ।\nद्वारदेशं समासाद्य द्रौणिस्तस्थौ रथोत्तमे\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2177089, "chapter_id": 4742, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसौप्तिकपर्वणि अश्वत्थाम्नः शिबिरप्रवेशं नाम पञ्चमोऽध्यायः ॥५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]