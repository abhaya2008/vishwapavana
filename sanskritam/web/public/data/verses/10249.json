[{"id": 6000249000, "chapter_id": 10249, "verse_number": null, "content_sanskrit": "अथ त्रिपञ्चाशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "तं जित्वा किरीटमादाय गच्छता गरुडेन मध्येमार्गं गोमन्ते स्थितस्य श्रीकृष्णस्य शिरसि तत्किरीटसमर्पणम्", "range": null}]}, {"id": 6000249001, "chapter_id": 10249, "verse_number": null, "content_sanskrit": "श्री शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.001.m4a", "display_order": 2}, {"id": 6000249002, "chapter_id": 10249, "verse_number": "१०-५३-१", "content_sanskrit": "गोमन्तं पर्वतश्रेष्ठं तुङ्गद्रुमलतान्वितम्।\nसालतालतमालाढ्यं प्रियालाशोकशोभितम्॥ १०/५३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.002.m4a", "display_order": 3, "topics": [{"text": "रामकृष्णयोः गोमन्तकपर्वतारोहणम्", "range": "१–६"}]}, {"id": 6000249003, "chapter_id": 10249, "verse_number": "१०-५३-२", "content_sanskrit": "कदम्बनीपहिन्तालपूगपुन्नागशोभितम्।\nआरुह्य कदलीषण्डमण्डितं मत्तकोकिलम्॥ १०/५३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.003.m4a", "display_order": 4}, {"id": 6000249004, "chapter_id": 10249, "verse_number": "१०-५३-३", "content_sanskrit": "भ्रमद्भ्रमरसङ्घातं प्लवगाकम्पितद्रुमम्।\nफलभारनतस्कन्धैर्नारिकेलैर्विराजितम्॥ १०/५३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.004.m4a", "display_order": 5}, {"id": 6000249005, "chapter_id": 10249, "verse_number": "१०-५३-४", "content_sanskrit": "बहुप्रस्रवणोपेतं सुच्छायं निर्मलोदकम्।\nरम्यं ददृशतुर्वीरौ प्रदेशं रामकेशवौ॥ १०/५३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.005.m4a", "display_order": 6}, {"id": 6000249006, "chapter_id": 10249, "verse_number": "१०-५३-५", "content_sanskrit": "तत्र प्रवर्षणं नाम शृृङ्गं पर्वतमूर्धनि।\nअवापतुर्यत्र मेघा नित्यं वर्षन्त्यविक्लवाः॥ १०/५३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.006.m4a", "display_order": 7}, {"id": 6000249007, "chapter_id": 10249, "verse_number": "१०-५३-६", "content_sanskrit": "तत्रारुह्य यदुश्रेष्ठौ पश्यन्तौ हि दिशो दश।\nरममाणौ यथाकाममूषतुः पर्वतोत्तमे॥ १०/५३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.007.m4a", "display_order": 8}, {"id": 6000249008, "chapter_id": 10249, "verse_number": "१०-५३-७", "content_sanskrit": "एतस्मिन्नेव काले तु क्षीरोदे सागरोत्तमे।\nनिवासे देवदेवस्य शङ्खचक्रगदाभृतः॥ १०/५३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.008.m4a", "display_order": 9}, {"id": 6000249009, "chapter_id": 10249, "verse_number": "१०-५३-८", "content_sanskrit": "उपासीनो महाबाहुः श्रीमान् वैरोचनो बलिः।\nजहार देवदेवस्य किरीटं रत्नचित्रितम्॥ १०/५३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.009.m4a", "display_order": 10, "topics": [{"text": "अत्रान्तरे महाबलिना श्वेतद्वीपं गत्वा भगवतः किरीटापहारः", "range": "८–९"}]}, {"id": 6000249010, "chapter_id": 10249, "verse_number": "१०-५३-९", "content_sanskrit": "इन्द्रनीलसहस्राढ्यं गोमेदकशताचितम्।\nपद्मरागमहानीलमुक्ताफलविराजितम्॥ १०/५३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.010.m4a", "display_order": 11}, {"id": 6000249011, "chapter_id": 10249, "verse_number": "१०-५३-१०", "content_sanskrit": "पुष्यरागप्रवालाढ्यं दिव्यकाञ्चननिर्मितम्। हृतं दानववीरेण विदित्वा पुरपालकः।\nतमन्वधावत् त्वरितं वैनतेयो विहङ्गराट्॥ १०/५३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.011.m4a", "display_order": 12}, {"id": 6000249012, "chapter_id": 10249, "verse_number": "१०-५३-११", "content_sanskrit": "तमन्तरे समासाद्य दानवेन्द्रं दुरासदम्।\nकृत्वा युद्धं महाघोरं जित्वा दानवपुङ्गवम्॥ १०/५३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.012.m4a", "display_order": 13}, {"id": 6000249013, "chapter_id": 10249, "verse_number": "१०-५३-१२", "content_sanskrit": "गृहीत्वा रत्ननिचयं किरीटं भास्करोपमम्।\nआगच्छन् ददृशे देवं देवकीनन्दनं हरिम्॥ १०/५३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.013.m4a", "display_order": 14}, {"id": 6000249014, "chapter_id": 10249, "verse_number": "१०-५३-१३", "content_sanskrit": "वसन्तं साग्रजं रम्ये गोमन्ते पर्वतोत्तमे। तस्य मूर्ध्नि निधायाशु किरीटं दिव्यभूषणम्।\nप्रणम्य पादयोर्मूर्ध्ना स्तोतुं तमुपचक्रमे॥ १०/५३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.014.m4a", "display_order": 15}, {"id": 6000249015, "chapter_id": 10249, "verse_number": "१०-५३-१४", "content_sanskrit": "नमो नमः कारणपूरुषाय नारायणायाखिलवल्लभाय।\nसुरारिसंहारणकारणाय नारायणायाखिलकर्मसाक्षिणे॥ १०/५३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.015.m4a", "display_order": 16}, {"id": 6000249016, "chapter_id": 10249, "verse_number": "१०-५३-१५", "content_sanskrit": "हिरण्यगर्भत्वमुपेत्य मूले सृजस्यशेषं भुवनं स एव।\nनारायणात्मन् परिपासि भूयो जहार चान्ते भगवन् शिवात्मन्॥ १०/५३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.016.m4a", "display_order": 17}, {"id": 6000249017, "chapter_id": 10249, "verse_number": "१०-५३-१६", "content_sanskrit": "तं त्वा यदोर्वंशकरं सुरेशं जानेऽवतीर्णं भुवने वृषाकपिम्।\nअहं हि भृत्यस्तव वैनतेयो ब्रूहि क्रियां किं करवाणि देव॥ १०/५३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.017.m4a", "display_order": 18}, {"id": 6000249018, "chapter_id": 10249, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.018.m4a", "display_order": 19}, {"id": 6000249019, "chapter_id": 10249, "verse_number": "१०-५३-१७", "content_sanskrit": "इत्युक्त्वा देवदेवेशं प्रणिपत्य विहङ्गराट्।\nजानुनी धरणीं कृत्वा तस्थौ प्राञ्जलिरग्रतः॥ १०/५३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.019.m4a", "display_order": 20}, {"id": 6000249020, "chapter_id": 10249, "verse_number": "१०-५३-१८", "content_sanskrit": "तं दृष्ट्वा यादवश्रेष्ठो गरुडं पक्षिपुङ्गवम्।\nप्रीत्युत्फुल्लमुखो दोर्भ्यां पस्पर्शाङ्गं तदुत्तमम्॥ १०/५३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.020.m4a", "display_order": 21}, {"id": 6000249021, "chapter_id": 10249, "verse_number": "१०-५३-१९", "content_sanskrit": "गच्छ भद्र यथाकाममेहि काले मया स्मृतः।\nइत्युक्त्वा तं विसृज्योभावीश्वरौ रामकेशवौ॥ १०/५३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.021.m4a", "display_order": 22}, {"id": 6000249022, "chapter_id": 10249, "verse_number": "१०-५३-२०", "content_sanskrit": "फलमूलकृताहारौ पीतकौशेयवाससौ।\nअवरुह्य गिरेः शृृङ्गात् करवीरपुरं गतौ॥ १०/५३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.022.m4a", "display_order": 23}, {"id": 6000249023, "chapter_id": 10249, "verse_number": "१०-५३-२१", "content_sanskrit": "तत्र तौ चतुरो मासानुषित्वा भरतर्षभ।\nमहत्या सेनया सार्धं जग्मतुर्मधुरां पुरीम्॥ १०/५३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.023.m4a", "display_order": 24}, {"id": 6000249024, "chapter_id": 10249, "verse_number": "१०-५३-२२", "content_sanskrit": "शृृगालं निहतं श्रुत्वा मागधः क्रोधविह्वलः।\nआजगाम कुरुश्रेष्ठ महत्या सेनया वृतः॥ १०/५३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.024.m4a", "display_order": 25, "topics": [{"text": "ततो रामकृष्णयोर्मधुरागमनम्", "range": "२२"}]}, {"id": 6000249025, "chapter_id": 10249, "verse_number": "१०-५३-२३", "content_sanskrit": "तेन सार्धमभूद् युद्धं सप्ताहं रामकृष्णयोः।\nतदा पराजितो युद्धे मागधो बहुसैनिकः॥ १०/५३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.025.m4a", "display_order": 26, "topics": [{"text": "पुनर्युद्धायागतस्य जरासन्धस्य पराजयः", "range": "२२–२३"}]}, {"id": 6000249026, "chapter_id": 10249, "verse_number": "१०-५३-२४", "content_sanskrit": "जगाम मागधानेव बहुभिः क्षत्रियैः सह।\nरामकृष्णौ च धर्मज्ञौ सूतमागधवन्दिभिः॥ १०/५३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.026.m4a", "display_order": 27, "topics": [{"text": "अत्रान्तरे नारदप्रेषितेन कालयवनेन कोटित्रयसङ्ख्याकेन यवनानां सैन्येन सह मथुरानिरोधायागमनम्", "range": "२४–२८"}]}, {"id": 6000249027, "chapter_id": 10249, "verse_number": "१०-५३-२५", "content_sanskrit": "स्तूयमानौ विविशतुः सानुगौ मधुरां पुरीम्।\nएवं सप्तदशकृत्वस्तावदक्षौहिणीबलः॥ १०/५३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.027.m4a", "display_order": 28}, {"id": 6000249028, "chapter_id": 10249, "verse_number": "१०-५३-२६", "content_sanskrit": "युयुधे मागधो राजा यदुभिः कृष्णपालितैः।\nअक्षिण्वत बलं सर्वं वृष्णिभिः कृष्णतेजसा॥ १०/५३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.028.m4a", "display_order": 29}, {"id": 6000249029, "chapter_id": 10249, "verse_number": "१०-५३-२७", "content_sanskrit": "हतेषु तेष्वनीकेषु त्यक्तोऽयादरिभिर्नृप।\nअष्टादशमसङ्ग्रामे आगामिनि तदन्तरा॥ १०/५३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.029.m4a", "display_order": 30}, {"id": 6000249030, "chapter_id": 10249, "verse_number": "१०-५३-२८", "content_sanskrit": "नारदप्रेषितो वीरो यवनः प्रत्यदृश्यत।\nरुरोध मधुरामेत्य तिसृभिर्म्लेच्छकोटिभिः॥ १०/५३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.030.m4a", "display_order": 31}, {"id": 6000249031, "chapter_id": 10249, "verse_number": "१०-५३-२९", "content_sanskrit": "नृलोके चाप्रतिद्वन्द्वो वृष्णीन् श्रुत्वाऽऽत्मसम्मितान्।\nतं दृष्ट्वाऽचिन्तयत् कृष्णः सङ्कर्षणसहायवान्॥ १०/५३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.031.m4a", "display_order": 32, "topics": [{"text": "तद्दृष्ट्वा कालयवनात् जरासन्धाच्चागतां यादवानामापदं विचिन्त्य कृष्णेन समुद्रमध्ये दुर्गकरणं निश्चित्य द्वारकानिर्माणम्", "range": "२९–३७"}]}, {"id": 6000249032, "chapter_id": 10249, "verse_number": "१०-५३-३०", "content_sanskrit": "अहो यदूनां वृजिनं प्राप्तं ह्युभयतो महत्।\nयवनोऽयं रुणद्ध्यस्मानद्य श्वो वा महाबलः॥ १०/५३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.032.m4a", "display_order": 33}, {"id": 6000249033, "chapter_id": 10249, "verse_number": "१०-५३-३१", "content_sanskrit": "मागधोऽभ्येति दुष्टात्मा परश्वो नैव संशयः।\nआवयोर्युद्ध्यतोरस्य यद्यागच्छेज्जरासुतः॥ १०/५३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.033.m4a", "display_order": 34}, {"id": 6000249034, "chapter_id": 10249, "verse_number": "१०-५३-३२", "content_sanskrit": "बन्धून् वधिष्यत्यथवा नेष्यते स्वपुरीं बली।\nतस्मादद्य विधास्यामो दुर्गं द्विपददुर्गमम्॥ १०/५३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.034.m4a", "display_order": 35}, {"id": 6000249035, "chapter_id": 10249, "verse_number": "१०-५३-३३", "content_sanskrit": "तत्र ज्ञातीन्समाधाय यवनं घातयामहे।\nइति सम्मन्त्र्य भगवान् दुर्गं द्वादशयोजनम्॥ १०/५३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.035.m4a", "display_order": 36}, {"id": 6000249036, "chapter_id": 10249, "verse_number": "१०-५३-३४", "content_sanskrit": "अन्तःसमुद्रे नगरं कृष्णोऽद्भुतमचीक्लृपत्।\nदृश्यते यत्र हि त्वाष्ट्रं विज्ञानं शिल्पनैपुणम्॥ १०/५३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.036.m4a", "display_order": 37}, {"id": 6000249037, "chapter_id": 10249, "verse_number": "१०-५३-३५", "content_sanskrit": "रथ्याचत्वरवीथीभिर्यथावास्तु विनिर्मितम्।\nसुरद्रुमलतोद्यानविचित्रोपवनान्वितम्॥ १०/५३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.037.m4a", "display_order": 38}, {"id": 6000249038, "chapter_id": 10249, "verse_number": "१०-५३-३६", "content_sanskrit": "हेमशृृङ्गैर्दिवस्पृग्भिः स्फाटिकाट्टालगोपुरैः।\nराजतारपुटैः कोष्ठैर्जुष्टं हेमस्वलङ्कृतैः॥ १०/५३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.038.m4a", "display_order": 39}, {"id": 6000249039, "chapter_id": 10249, "verse_number": "१०-५३-३७", "content_sanskrit": "रत्नकूटैर्गृहैर्हेमैर्महामरतकस्थलैः।\nवास्तोष्पतीनां च गृहैर्वलभीभिश्च निर्मितम्॥ १०/५३/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.039.m4a", "display_order": 40}, {"id": 6000249040, "chapter_id": 10249, "verse_number": "१०-५३-३८", "content_sanskrit": "चातुर्वर्ण्यजनाकीर्णं यदूनां च गृहैर्लसत्।\nसुधर्मां पारिजातं च महेन्द्रः प्राहिणोद्धरेः॥ १०/५३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.040.m4a", "display_order": 41}, {"id": 6000249041, "chapter_id": 10249, "verse_number": "१०-५३-३९", "content_sanskrit": "यत्र चावस्थितो मर्त्यो मर्त्यधर्मैर्वियुज्यते।\nयत् प्रियं देवदेवस्य विष्णोः क्षीरोदवासिनः॥ १०/५३/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.041.m4a", "display_order": 42}, {"id": 6000249042, "chapter_id": 10249, "verse_number": "१०-५३-४०", "content_sanskrit": "श्यामैककर्णान् वरुणो हयान् शुक्लान् मनोजवान्।\nददौ सहस्रसङ्ख्यातान् देवदेवाय तोयराट्॥ १०/५३/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.042.m4a", "display_order": 43}, {"id": 6000249043, "chapter_id": 10249, "verse_number": "१०-५३-४१", "content_sanskrit": "अष्टौ निधिपतिः कोशान् रत्नपूर्णानविक्षयान्।\nतथाऽन्ये लोकपालाश्च ददुः स्वाधिकृतं धनम्॥ १०/५३/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.043.m4a", "display_order": 44}, {"id": 6000249044, "chapter_id": 10249, "verse_number": "१०-५३-४२", "content_sanskrit": "यद् यद् भगवता दत्तमाधिपत्यं स्वसिद्धये।\nसर्वं प्रत्यर्पयामासुर्हरौ भूमिगते नृप॥ १०/५३/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.044.m4a", "display_order": 45}, {"id": 6000249045, "chapter_id": 10249, "verse_number": "१०-५३-४३", "content_sanskrit": "तत्र योगप्रभावेण नीत्वा स्वान् भगवान् हरिः।\nमधुरायाश्च रामेण कृष्णः समनुमन्त्रितः।\nनिर्जगाम पुरद्वारात् पद्ममाली निरायुधः॥ १०/५३/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_053/BhP_10.053.045.m4a", "display_order": 46, "topics": [{"text": "मथुरातः सर्वेषां स्वीयानां तत्र प्रेषणम्", "range": "४३"}]}, {"id": 6000249046, "chapter_id": 10249, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे त्रिपञ्चाशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]