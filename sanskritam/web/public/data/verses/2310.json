[{"id": 2061276, "chapter_id": 2310, "verse_number": "८-३१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2061277, "chapter_id": 2310, "verse_number": "८-३१-१", "content_sanskrit": "दृष्ट्वा कर्णं महावीर्यं युयुत्सं समवस्थितम्।\nचुक्रुशुः कुरवः सर्वे हृष्टरूपाः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2061278, "chapter_id": 2310, "verse_number": "८-३१-२", "content_sanskrit": "ततो दुन्दुभिनिर्घोषैर्भेरीणां निनदेन च।\nकोणशब्दैश्च विविधैर्गर्जितैश्च तरस्विनाम्।\nनिर्ययुस्तावकाः सर्वे मृत्युं कृत्वा निवर्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2061279, "chapter_id": 2310, "verse_number": "८-३१-३", "content_sanskrit": "प्रयाते तु ततः कर्णे रथेषु मदितेषु च।\nचचाल च मही सर्वा ररास च सुविस्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2061280, "chapter_id": 2310, "verse_number": "८-३१-४", "content_sanskrit": "निःसरन्तो व्यदृश्यन्त सूर्यात्सप्त महाग्रहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2061281, "chapter_id": 2310, "verse_number": "८-३१-५", "content_sanskrit": "उल्कापाताश्च सञ्जज्ञुर्दिग्दाहाश्चैव दारुणाः।\nतथाऽशन्यश्च सम्पेतुर्ववुर्वाताश्च भैरवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2061282, "chapter_id": 2310, "verse_number": "८-३१-६", "content_sanskrit": "मृगपक्षिगणाश्चैव पृतनां बहुशस्तव।\nअपसव्यं तदा चक्रुर्वेदयन्तो महाभयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2061283, "chapter_id": 2310, "verse_number": "८-३१-७", "content_sanskrit": "प्रस्थितस्य च कर्णस्य निपेतुस्तुरगा भुवि।\nअस्थिवर्षं च पतितमन्तरिक्षाद्भयानकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2061284, "chapter_id": 2310, "verse_number": "८-३१-८", "content_sanskrit": "जज्वलुश्चैव शस्त्राणि ध्वजाश्चैव चकम्पिरे।\nअश्रूणि च व्यमुञ्चन्त वाहनानि विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2061285, "chapter_id": 2310, "verse_number": "८-३१-९", "content_sanskrit": "एते चान्ये च बहव उत्पातास्तत्र मारिष।\nसमुत्पेतुर्विनाशाय कौरवाणां सुदारुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2061286, "chapter_id": 2310, "verse_number": "८-३१-१०", "content_sanskrit": "न च तान्गणयामासुः सर्वे दैवेन मोहिताः।\nप्रस्थितं सूतपुत्रं च जयेत्सूचुर्नराधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2061287, "chapter_id": 2310, "verse_number": "८-३१-११", "content_sanskrit": "`शल्येन सहितं दृष्ट्वा कर्णमाहवशोभिनम्।\nनिर्जितान्पाण्डवांश्चैव मेनिरे तत्र कौरवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2061288, "chapter_id": 2310, "verse_number": "८-३१-१२", "content_sanskrit": "ततो रथस्थः परवीरहन्ता\nभीष्मद्रोणवतिवीर्यौ समीक्ष्य।\nसमुज्ज्वलन्भास्करपावकाभो\nवैकर्तनोऽसौ रथकुञ्जरो वृषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2061289, "chapter_id": 2310, "verse_number": "८-३१-२०", "content_sanskrit": "अलं मनुष्यस्य सुखाय वर्तितुं\nतथाहि युद्वे निहतः परैर्गुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2061290, "chapter_id": 2310, "verse_number": "८-३१-२१", "content_sanskrit": "हुताशनादित्यसमानतेजसं\nपराक्रमे विष्णुपुरन्दरोपमम्॥\nनये ब-हस्पत्युशनःसमं सदा\nन चैनमस्त्रं तदुपास्त दुःसहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2061291, "chapter_id": 2310, "verse_number": "८-३१-२२", "content_sanskrit": "सम्प्राक्रुष्टे रुदितस्त्रीकुमारे\nपराभूते पौरुषे धार्तराष्ट्रे।\nकृत्यं मया नाद्य जानामि शल्य\nप्रयाहि तस्माद्द्विषतामनीकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2061292, "chapter_id": 2310, "verse_number": "८-३१-२३", "content_sanskrit": "स यत्र राजा पाण्डवः सत्यसन्धो\nव्यवस्थितो भीमसेनार्जुनौ च।\nस वासुदेवः सात्यकिः सृञ्जयाश्च\nयमौ च कस्तान्विषहेन्मदन्यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2061293, "chapter_id": 2310, "verse_number": "८-३१-२४", "content_sanskrit": "तस्मात्क्षिप्रं मद्रपते प्रयाहि\nरणे पाञ्चालान्पाण्डवान्सृञ्जयांश्च।\nतान्वा हनिष्यामि समेत्य सङ्ख्ये\nयास्यामि वा द्रोणमुखो यमाय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2061294, "chapter_id": 2310, "verse_number": "८-३१-२५", "content_sanskrit": "न त्वेवाहं न गमिष्यामि मध्ये\nतेषां शूराणामिति शल्याद्य विद्वि।\nमित्रद्रोहो मर्षणीयो न मेऽयं\nत्यक्त्वा प्राणाननुयास्यामि द्रोणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2061295, "chapter_id": 2310, "verse_number": "८-३१-२६", "content_sanskrit": "प्राज्ञस्य मूढस्य च जीवितान्ते\nनास्ति प्रमोक्षोऽन्तकसन्निभस्य।\nअतो विद्वन्नभियोत्स्यामि पार्थं\nदिष्टं न शक्यं व्यतिवर्तितुं वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2061296, "chapter_id": 2310, "verse_number": "८-३१-२७", "content_sanskrit": "कल्याणवृत्तः सततं हि राजा\nवैचित्रवीर्यस्य सुतो ममासीत्।\nतस्यार्थसिद्व्यर्थमहं त्यजामि\nप्रियान्भोगान्दुस्त्यजं जीवितं च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2061297, "chapter_id": 2310, "verse_number": "८-३१-२८", "content_sanskrit": "वैयाघ्रचर्माणमकूजनाक्षं\nहैमं त्रिकोशं रजतत्रिवेणुम्।\nरथप्रबर्हं तुरगप्रबार्है--\nर्युक्तं प्रादान्मह्यमिमं हि रामः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2061298, "chapter_id": 2310, "verse_number": "८-३१-२९", "content_sanskrit": "धनूंषि चित्राणि निरीक्ष्य शल्य\nध्वजान्गदाः सायकांश्चोग्ररूपान्।\nअसिं च दीप्तं परमायुधं च\nशङ्खं च शुभ्रं स्वनवन्तमुग्रम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2061299, "chapter_id": 2310, "verse_number": "८-३१-३०", "content_sanskrit": "पताकिनं वज्रनिपातनिः स्वनं\nसिताश्वयुक्तं शुभतूणशोभितम्।\nइमं समास्थाय रथर्षभं रणे\nदृढं हनिष्याम्यहमर्जुनं बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2061300, "chapter_id": 2310, "verse_number": "८-३१-३१", "content_sanskrit": "तं चेन्मृत्युः सर्वहरोऽभिरक्षे--\nत्सदाऽप्रमत्तः समरे पाण्डुपुत्रम्।\nतं वा हनिष्यामि रणे समेत्य\nयास्यामि वा द्रोणमुखो यमाय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2061301, "chapter_id": 2310, "verse_number": "८-३१-३२", "content_sanskrit": "यमवरुणकुबेरवासवा वा\nयदि युगपत्सगणा महाहवे।\nजुगुपुरिह समेत्य फल्गुनं\nकिमु बहुना सह तैर्जयामि तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2061302, "chapter_id": 2310, "verse_number": "८-३१-३३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2061303, "chapter_id": 2310, "verse_number": "८-३१-३३", "content_sanskrit": "इति रणरभसस्य कत्थत--\nस्तदुपनिशम्य वचः स मद्रराट्।\nअवहसदवमन्य वीर्यवान्\nप्रतिषिषिधे च जगाद चोत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2061304, "chapter_id": 2310, "verse_number": "८-३१-३४x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2061305, "chapter_id": 2310, "verse_number": "८-३१-३४", "content_sanskrit": "विरम विरम कर्ण कत्थना--\nदतिरभसोऽप्यतिवाचमुक्तवान्।\nक्व च हि नरवरो धनञ्जयः\nक्व पुनरिह त्वमहो नराधमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2061306, "chapter_id": 2310, "verse_number": "८-३१-३५", "content_sanskrit": "यदुसदनमुपेन्द्रपालितं\nत्रिदिवमिवामरराजरक्षितम्।\nप्रसभमतिविलोड्य को हरे--\nत्पुरुषवरावरजामृतेऽर्जुनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2061307, "chapter_id": 2310, "verse_number": "८-३१-३६", "content_sanskrit": "त्रिभुवनसृजमीश्वरेश्वरं\nक इह पुमान्भवमाह्वयेद्युधि।\nमृगवधकलहे ऋतेऽर्जुनात्\nसुरपतिवीर्यसमप्रभावतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2061308, "chapter_id": 2310, "verse_number": "८-३१-३७", "content_sanskrit": "असुरसुरमहोरगान्नरान्\nगरुडपिशाचसयक्षराक्षसान्।\nइषुभिरजयदग्निगौरवात्\nस्वभिलषितं च हविर्ददौ जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2061309, "chapter_id": 2310, "verse_number": "८-३१-३८", "content_sanskrit": "स्मरसि ननु यदा परैर्हृतः\nसहधृतराष्ट्रसुतो विमोक्षितः।\nअधिरथज नरोत्तमैर्युतान्\nकुरुषु बहून्विनिहत्य तानरीन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2061310, "chapter_id": 2310, "verse_number": "८-३१-३९", "content_sanskrit": "प्रथममपि पलायिते त्वयि\nप्रियकलहा धृतराष्ट्रसूनवः।\nस्मरसि ननु यदा प्रमोचिताः\nखचरगणानवजित्य पाण्डवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2061311, "chapter_id": 2310, "verse_number": "८-३१-४०", "content_sanskrit": "समुदितबलवाहनाः पुनः\nपुरुषवरेण जिताः स्थ गोग्रहे।\nसगुरुगुरुसुताः सभीष्मकाः\nकिमु न जितः स तदा त्वयाऽर्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2061312, "chapter_id": 2310, "verse_number": "८-३१-४१", "content_sanskrit": "इदमपरमुपस्थितं पुन--\nस्तव निधनाय सुयुद्वमद्य वै।\nयदि न रिपुभयात्पलायसे\nसमरगतोऽद्य हतोऽसि सूतज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2061313, "chapter_id": 2310, "verse_number": "८-३१-४२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2061314, "chapter_id": 2310, "verse_number": "८-३१-४२", "content_sanskrit": "इति बहुपरुषं प्रभाषति\nप्रमनसि मद्रपतौ रिपुस्तवम्।\nभृशमभिरुषितः सरन्तपः\nकुरुपृतनापतिराह मद्रपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2061315, "chapter_id": 2310, "verse_number": "८-३१-४३x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2061316, "chapter_id": 2310, "verse_number": "८-३१-४३", "content_sanskrit": "भवतु भवतु किं विकत्थसे\nननु मर्म तस्य हि युद्धमुद्यतम्।\nयदि स जयति मामिहाहवे\nतत इदमस्तु सुकत्थितं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2061317, "chapter_id": 2310, "verse_number": "८-३१-४४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2061318, "chapter_id": 2310, "verse_number": "८-३१-४४", "content_sanskrit": "एवमस्त्विति मद्रेश उक्त्वा नोत्तरमुक्तवान्।\nयाहि शल्येति चाप्येनं कंर्णः प्राह युयुत्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2061319, "chapter_id": 2310, "verse_number": "८-३१-४५", "content_sanskrit": "स रथः प्रययौ शत्रून्निघ्नतः शल्यसारथिः।\nनिघ्नन्नमित्रान्समरे तमोघ्नः सविता यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2061320, "chapter_id": 2310, "verse_number": "८-३१-४६", "content_sanskrit": "ततः प्रायात्प्रीतिमान्वै रथेन\nवैयाघ्रेण श्वेतयुजाऽथ कर्णः।\nस चालोक्य ध्वजिनीं पाण्डवानां\nधनञ्जयं त्वरया पर्यपृच्छत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2061321, "chapter_id": 2310, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि एकत्रिंशोऽध्यायः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]