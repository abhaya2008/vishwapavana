[{"id": 7005538000, "chapter_id": 25538, "verse_number": "११-१", "content_sanskrit": "आदित्याख्यानम् ।\nआदित्यवंशमखिलं वद सूत! यथाक्रमम् ।\nसोमवंशञ्च तत्वज्ञ! यथावद्वक्तुमर्हसि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005538001, "chapter_id": 25538, "verse_number": "११-२", "content_sanskrit": "विवस्वान् कश्यपात् पूर्वमदित्यामभवत्सुतः ।\nतस्य पत्नीत्रयं तद्वत् सञ्ज्ञा राज्ञी प्रभा तथा ।\nरैवतस्य सुता राज्ञी रेवतं सुषुवे तनुम् ।\nप्रभा प्रभातं सुषुवे त्वाष्ट्री सञ्ज्ञा तथा मनुम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005538002, "chapter_id": 25538, "verse_number": "११-३", "content_sanskrit": "यमश्च यमुना चैव यमलौ तु बभूवतुः ।\nततस्तेजोमयं रूपमसहन्ती विवस्वतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005538003, "chapter_id": 25538, "verse_number": "११-४", "content_sanskrit": "नारीमुत्पादयामास स्वशरीरादनिन्दिताम् ।\nत्वाष्ट्री स्वरूपेण नाम्ना छायेतिभामिनी तदा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005538004, "chapter_id": 25538, "verse_number": "११-५", "content_sanskrit": "किङ्करोमीति पुरतः स्थितां तामभ्यभाषत ।\nछाये! त्वं भज भर्तारमस्मदीयं वरानने! ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005538005, "chapter_id": 25538, "verse_number": "११-६", "content_sanskrit": "अपत्यानि मदीयानि मातृस्नेहेन पालय ।\nतथेत्युक्ता तु सा देवमगमत् क्वापि सुव्रता ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005538006, "chapter_id": 25538, "verse_number": "११-७", "content_sanskrit": "कामयामास देवोऽपि सञ्ज्ञेयमिति चादरात् ।\nजनयामास तस्यां तु पुत्रञ्च मनुरूपिणम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005538007, "chapter_id": 25538, "verse_number": "११-८", "content_sanskrit": "सवर्णत्वाच्च सावर्णिम् मनोर्वैवस्वतस्य च ।\nततः शनिञ्च तपतीं विष्टिं चैव क्रमेण तु ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005538008, "chapter_id": 25538, "verse_number": "११-९", "content_sanskrit": "छायायां जनयामास सञ्ज्ञेयमिति भास्करः ।\nछाया स्वपुत्रेऽभ्यधिकं स्नेहं चक्रे मनौ तथा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005538009, "chapter_id": 25538, "verse_number": "११-१०", "content_sanskrit": "पूर्वो मनुस्तु चक्षाम न यमः क्रोधमूर्च्छितः ।\nसन्तर्जयामास तदा पादमुद्यम्य दक्षिणम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005538010, "chapter_id": 25538, "verse_number": "११-११", "content_sanskrit": "शशाप च यमं छाया सक्षतः कृमिसंयुतः ।\nपादोऽयमेको भविता पूय शोणित विस्रवः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005538011, "chapter_id": 25538, "verse_number": "११-१२", "content_sanskrit": "निवेदयामास पितुर्धर्म्मः शापादमर्षितः ।\nनिष्कारणमहं शप्तो मात्रा देव! सकोपया ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005538012, "chapter_id": 25538, "verse_number": "११-१३", "content_sanskrit": "बालभावान् मया किञ्चिदुद्यतश्चरणः सकृत् ।\nमनुना वार्यमाणापि मम शापमदाद्विभो ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005538013, "chapter_id": 25538, "verse_number": "११-१४", "content_sanskrit": "प्रायेण माता सास्माकं शापेनाहं यतो हतः ।\nदेवोऽप्याह यमं भूयः किङ्करोमि महामते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005538014, "chapter_id": 25538, "verse_number": "११-१५", "content_sanskrit": "मौर्ख्यात् कस्य न दुःखं स्यादथवा कर्म्म सन्ततेः ।\nअनिवार्याभवस्यापि का कथान्येषु जन्तुषु ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005538015, "chapter_id": 25538, "verse_number": "११-१६", "content_sanskrit": "कृकवाकुर्म्मया दत्तो यः कृमीन् भक्षयिष्यति ।\nक्लेदञ्च रुधिरञ्चैव वत्सायमपनेष्यति ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005538016, "chapter_id": 25538, "verse_number": "११-१७", "content_sanskrit": "एवमुक्तस्तपस्तेपे यमस्तीव्रं महायशाः ।\nगोकर्णतीर्थे वैराग्यात् फलपत्रानिलाशनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005538017, "chapter_id": 25538, "verse_number": "११-१८", "content_sanskrit": "आराधयन् महादेवं यावद्वर्षायुतायुतम् ।\nवरं प्रादान् महादेवः सन्तुष्टः शूलभृत्तदा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005538018, "chapter_id": 25538, "verse_number": "११-१९", "content_sanskrit": "वव्रे सलोकपालत्वं पितृलोके नृपालयम् ।\nधर्म्माधर्म्मात्मकस्यापि जगतस्तु परीक्षणम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005538019, "chapter_id": 25538, "verse_number": "११-२०", "content_sanskrit": "एवं स लोकपालत्वमगमच्छूलपाणिनः ।\nपितॄणाञ्चाधिपत्यञ्च धर्म्माधर्म्मस्य चानघ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005538020, "chapter_id": 25538, "verse_number": "११-२१", "content_sanskrit": "विवस्वानथ तज्ज्ञात्वा सञ्ज्ञायाः कर्म्मचेष्टितम् ।\nत्वष्टुः समीपमगमदाचचक्षे च रोषवान् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005538021, "chapter_id": 25538, "verse_number": "११-२२", "content_sanskrit": "तमुवाच ततस्त्वष्टा सान्त्वपूर्वं द्विजोत्तामाः ।\nतवासहन्ती भगवन्!महस्तीव्रं तमोनुदम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005538022, "chapter_id": 25538, "verse_number": "११-२३", "content_sanskrit": "वडवारूपमास्थाय मत्सकाशमिहागता ।\nनिवारिता मया सातु त्वया चैव दिवाकर! ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005538023, "chapter_id": 25538, "verse_number": "११-२४", "content_sanskrit": "यस्मादविज्ञाततया मत्सकाशमिहागता ।\nतस्मान्मदीयं भवनं प्रवेष्टुं न त्वमर्हसि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005538024, "chapter_id": 25538, "verse_number": "११-२५", "content_sanskrit": "एवमुक्ता जगामाथ मरुदेशमनिन्दिता ।\nवडवा रूपमास्थाय भूतले सम्प्रतिष्ठिता ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005538025, "chapter_id": 25538, "verse_number": "११-२६", "content_sanskrit": "तस्मात्प्रसादं कुरु मे यद्यनुग्रह भागहम् ।\nअपनेष्यामि ते तेजो यन्त्रे कृत्वा दिवाकर! ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005538026, "chapter_id": 25538, "verse_number": "११-२७", "content_sanskrit": "रूपं तव करिष्यामि लोकानन्दकरं प्रभो! ।\nतथेत्युक्तः स रविणा भ्रमौ कृत्वा दिवाकरम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005538027, "chapter_id": 25538, "verse_number": "११-२८", "content_sanskrit": "पृथक् चकार तत्तेजश्चक्रं विष्णोरकल्पयत् ।\nत्रिशूलञ्चापि रुद्रस्य वज्रमिन्द्रस्य चाधिकम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005538028, "chapter_id": 25538, "verse_number": "११-२९", "content_sanskrit": "दैत्यदानवसंहर्तुः सहस्र किरणात्मकम् ।\nरूपञ्चाप्रतिमञ्चक्रे त्वष्टा पद्भ्यामृते महत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005538029, "chapter_id": 25538, "verse_number": "११-३०", "content_sanskrit": "न शशाकाथ तद् द्रष्टुं पादरूपं रवेः पुनः ।\nअर्चास्वपि ततः पादौ न कश्चित् कारयेत् क्वचित् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005538030, "chapter_id": 25538, "verse_number": "११-३१", "content_sanskrit": "यः करोति स पापिष्ठां गतिमाप्नोति निन्दिताम् ।\nकुष्ठरोगमवाप्नोति लोकेऽस्मिन् दुःखसंयुतः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005538031, "chapter_id": 25538, "verse_number": "११-३२", "content_sanskrit": "तस्माच्च धर्म्मकामार्थी चित्रेष्वायतनेषु च ।\nन क्वचित्कारयेत्पादौ देवदेवस्य धीमतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005538032, "chapter_id": 25538, "verse_number": "११-३३", "content_sanskrit": "ततः स भगवान्! गत्वा भूर्लोकममराधिपः ।\nकामयामास कामार्तो मुख एव दिवाकरः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005538033, "chapter_id": 25538, "verse_number": "११-३४", "content_sanskrit": "अश्वरूपेण महता तेजसा च समावृतः ।\nसञ्ज्ञा च मनसा क्षोभमगमद्भयविह्वला ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005538034, "chapter_id": 25538, "verse_number": "११-३५", "content_sanskrit": "नासा पुटाभ्यामुत्सृष्टं परोऽयमितिशङ्कया ।\nतद्रेतसस्ततो जातावश्विनावितिनिश्चितम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005538035, "chapter_id": 25538, "verse_number": "११-३६", "content_sanskrit": "दस्रौ सुतत्वात् सञ्जातौ नासत्यौ नासिकाग्रतः ।\nज्ञात्वाचिराच्च तं देवं सन्तोषमगमत्परम् ।\nविमानेनागमत् स्वर्गं पत्या सह मुदान्विता ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005538036, "chapter_id": 25538, "verse_number": "११-३७", "content_sanskrit": "सावर्णोऽपि मनुर्मेरावद्याप्यास्ते तपोधनः ।\nशनिस्तपोबलादाप ग्रहसाम्यं ततः पुनः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005538037, "chapter_id": 25538, "verse_number": "११-३८", "content_sanskrit": "यमुना तपती चैवपुनर्नद्यौ बभूवतुः ।\nविष्टिर्घोरात्मिका तद्वत् कालत्वेन व्यवस्थिता ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005538038, "chapter_id": 25538, "verse_number": "११-३९", "content_sanskrit": "मनोर्वैवस्वतस्यासन् दशपुत्रा महाबलाः ।\nइलस्तु प्रथमस्तेषां पुत्रेष्ट्यां समजायत ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005538039, "chapter_id": 25538, "verse_number": "११-४०", "content_sanskrit": "इक्ष्वाकुः कुशनाभश्च अरिष्टो धृष्ण एव च ।\nनरिष्यतः करूपश्च शर्य्यातिश्च महाबलः ।\nपृषध्रश्चाथ नाभागः सर्वे ते दिव्यमानुषाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005538040, "chapter_id": 25538, "verse_number": "११-४१", "content_sanskrit": "अभिषिच्य मनुः पुत्रमिलं ज्येष्ठं स धार्मिकः ।\nजगाम तपसे भूयः स महेन्द्रवनालयम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005538041, "chapter_id": 25538, "verse_number": "११-४२", "content_sanskrit": "अथ दिग्जयसिध्यर्थमिलः प्रायान् महीमिमाम् ।\nभ्रमन् द्वीपानि सर्वाणि क्ष्माभृतः सम्प्रधर्षयन् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005538042, "chapter_id": 25538, "verse_number": "११-४३", "content_sanskrit": "जगामोपवनं शम्भोरश्वाकृष्टः प्रतापवान् ।\nकल्पद्रुमलताकीर्णं नाम्ना शरवणं महत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005538043, "chapter_id": 25538, "verse_number": "११-४४", "content_sanskrit": "रमते यत्र देवेशः शम्भुः सोमार्द्धशेखरः ।\nउमया समयस्तत्र पुरा शरवणे कृतः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005538044, "chapter_id": 25538, "verse_number": "११-४५", "content_sanskrit": "पुन्नामसत्त्वं यत् किञ्चिदागमिष्यति ते वने ।\nस्त्रीत्वमेष्यति तत्सर्वं दश योजन मण्डले ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005538045, "chapter_id": 25538, "verse_number": "११-४६", "content_sanskrit": "अज्ञातसमयो राजा इलः शरवणे पुरा ।\nस्त्रीत्वमाप विशन्नेव वडवात्त्वं हयस्तदा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005538046, "chapter_id": 25538, "verse_number": "११-४७", "content_sanskrit": "पुरुषत्वं हृतं सर्वं स्त्रीरूपे विस्मितो नृप ।\nइलेति साभवन्नारी पीनोन्नत घनस्तनी ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005538047, "chapter_id": 25538, "verse_number": "११-४८", "content_sanskrit": "उन्नतश्रोणिजघना पद्म पत्रायतेक्षणा ।\nपूर्णेन्दुवदना तन्वी विलासोल्लासितेक्षणा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005538048, "chapter_id": 25538, "verse_number": "११-४९", "content_sanskrit": "मूलोन्नतायतभुजा नीलकुञ्चितमूर्धजा ।\nतनुलोमा सुदशना मृदुगम्भीरभाषिणी ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005538049, "chapter_id": 25538, "verse_number": "११-५०", "content_sanskrit": "श्यामगौरेण वर्णेन हंसवारणगामिनी ।\nकार्मुक भ्रू युगोपेता तनु ताम्र नखाङ्करा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005538050, "chapter_id": 25538, "verse_number": "११-५१", "content_sanskrit": "भ्रमन्ती च वने तस्मिन् चिन्तयामास भामिनी ।\nको मे पिताऽथवा भ्राता का मे माता भवेदिह ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005538051, "chapter_id": 25538, "verse_number": "११-५२", "content_sanskrit": "कस्य भर्तुरहं दत्ता कियद्वत्स्यामि भूतले ।\nइति चिन्तयती दृष्टा सोमपुत्रेण साङ्गना ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005538052, "chapter_id": 25538, "verse_number": "११-५३", "content_sanskrit": "इलारूपसमाक्षिप्त मनसा वरवर्णिनीम् ।\nबुधस्तदाप्तये यत्नमकरोत् कामपीडितः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005538053, "chapter_id": 25538, "verse_number": "११-५४", "content_sanskrit": "विशिष्टाकारवान् दण्डी सकमण्डलु पुस्तकः ।\nवेणुदण्डकृतानेक पवित्रक गणित्रकः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005538054, "chapter_id": 25538, "verse_number": "११-५५", "content_sanskrit": "द्विजरूपः शिखी ब्रह्मनिगदन् कर्णकुण्डलः ।\nवटुभिश्चान्वितोयुक्तैः समित्पुष्पकुशोदकैः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005538055, "chapter_id": 25538, "verse_number": "११-५६", "content_sanskrit": "किलान्विषन्वने तस्मिन्नाजुहाव स तामिलाम् ।\nबहिर्वनस्यान्तरितः किल पादप मण्डले ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005538056, "chapter_id": 25538, "verse_number": "११-५७", "content_sanskrit": "ससम्भ्रममकस्मात्तां सोपालम्भमिवावदत् ।\nत्यक्त्वाग्नि होत्रशुश्रूषां क्व गता मन्दिरान्मम ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005538057, "chapter_id": 25538, "verse_number": "११-५८", "content_sanskrit": "इयं विहारवेला ते ह्यतिक्रामति साम्प्रतम् ।\nएह्येहि पृथुसुश्रोणि! सम्भ्रान्ता केन हेतुना ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005538058, "chapter_id": 25538, "verse_number": "११-५९", "content_sanskrit": "इयं सायन्तनीवेला विहारस्येह वर्तते ।\nकृत्वोपलेपनं पुष्पैरलङ्कुरु गृहं मम ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005538059, "chapter_id": 25538, "verse_number": "११-६०", "content_sanskrit": "सात्त्वब्रवीद्विस्मृताहं सर्वमेतत्तपोधन! ।\nआत्मानं त्वाञ्च भर्तारं कुलञ्च वद मेऽनघ ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005538060, "chapter_id": 25538, "verse_number": "११-६१", "content_sanskrit": "बुधः प्रोवाच तां तन्वीमिला त्वं वरवर्णिनि! ।\nअहञ्च कामुको नाम बहुविद्योबुधः स्मृतः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005538061, "chapter_id": 25538, "verse_number": "११-६२", "content_sanskrit": "तेजस्विनः कुले जातः पिता मे ब्राह्मणाधिपः ।\nइति सा तस्य वचनात् प्रविष्टा बुधमन्दिरम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005538062, "chapter_id": 25538, "verse_number": "११-६३", "content_sanskrit": "रत्नस्तम्भसमायुक्तं दिव्यमाया विनिर्मितम् ।\nइला कृतार्थमात्मानं मेने तद्भवनस्थिता ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005538063, "chapter_id": 25538, "verse_number": "११-६४", "content_sanskrit": "अहोवृत्तमहोरूपमहोधनमहोकुलम् ।\nमम चास्य च मे भर्तुरहोलावण्यमुत्तमम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005538064, "chapter_id": 25538, "verse_number": "११-६५", "content_sanskrit": "रेमे च सा तेन सममतिकालमिला ततः ।\nसर्वभोगमये गेहे यथेन्द्रभवने तथा ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]