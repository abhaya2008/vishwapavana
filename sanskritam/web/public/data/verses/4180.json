[{"id": 2147186, "chapter_id": 4180, "verse_number": "", "content_sanskrit": "गालवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2147187, "chapter_id": 4180, "verse_number": "१", "content_sanskrit": "गरुत्मन् भुजगेन्द्रारे सुपर्ण विनतात्मज ।\nनय मां तार्क्ष्य पूर्वेण यत्र धर्मस्य चक्षुषी\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2147188, "chapter_id": 4180, "verse_number": "२", "content_sanskrit": "पूर्वामेव दिशं गच्छ या पूर्वं परिकीर्तिता ।\nदेवतानां हि सान्निध्यमत्र कीर्तितवानसि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2147189, "chapter_id": 4180, "verse_number": "३", "content_sanskrit": "अत्र सत्यं च धर्मश्च त्वया सम्यक् प्रकीर्तितौ\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2147190, "chapter_id": 4180, "verse_number": "४", "content_sanskrit": "इच्छेयं तु समागन्तुं समस्तैर्दैवतैरहम् ।\nभूयश्च तान् सुरान् द्रष्टुमिच्छेयमरुणानुज\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2147191, "chapter_id": 4180, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2147192, "chapter_id": 4180, "verse_number": "५", "content_sanskrit": "तमाह विनतासूनुरारोहस्वेति वै द्विजम् ।\nआरुरोहाथ स मुनिः गरुडं गालवस्तदा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2147193, "chapter_id": 4180, "verse_number": "", "content_sanskrit": "गालवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2147194, "chapter_id": 4180, "verse_number": "६", "content_sanskrit": "क्रममाणस्य ते रूपं दृश्यते पन्नगाशन ।\nभास्करस्येव पूर्वाह्णे सहस्रांशोर्विवस्वतः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2147195, "chapter_id": 4180, "verse_number": "७", "content_sanskrit": "पक्षवातप्रणुन्नानां वृक्षाणामनुगामिनाम् ।\nप्रस्थितानामिव समं पश्यामीह गतिं खग\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2147196, "chapter_id": 4180, "verse_number": "८", "content_sanskrit": "ससागरवनामुर्वीं सशैलवनकाननाम् ।\nआकर्षन्निव चाभासि पक्षवातेन खेचर\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2147197, "chapter_id": 4180, "verse_number": "९", "content_sanskrit": "समीननागनक्रं च खमिवारोप्यते जलम् ।\nवायुना चैव महता पक्षवातेन चानिशम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2147198, "chapter_id": 4180, "verse_number": "१०", "content_sanskrit": "तुल्यरूपाननान् मत्स्यान् तथा तिमितिमिङ्गिलान् ।\nनागाश्वतरवक्त्रांश्च पश्याम्युन्मथितानिव\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2147199, "chapter_id": 4180, "verse_number": "११", "content_sanskrit": "महार्णवस्य च रवैः श्रोत्रे मे बधिरे कृते ।\nन शृणोमि न पश्यामि नात्मनो वेद्मि कारणम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2147200, "chapter_id": 4180, "verse_number": "१२", "content_sanskrit": "शनैः स तु भवान् यातु ब्रह्मवध्यामनुस्मरन्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2147201, "chapter_id": 4180, "verse_number": "१३", "content_sanskrit": "न दृश्यते रविस्तात न दिशो न च खं खग ।\nतम एव तु पश्यामि शरीरं ते न लक्षये\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2147202, "chapter_id": 4180, "verse_number": "१४", "content_sanskrit": "मणी व जात्यौ पश्यामि चक्षुषी तेऽहमण्डज ।\nशरीरं तु न पश्यामि तव चैवात्मनश्च ह\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2147203, "chapter_id": 4180, "verse_number": "१५", "content_sanskrit": "पदे पदे तु पश्यामि सलिलादग्निमुत्थितम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2147204, "chapter_id": 4180, "verse_number": "१६", "content_sanskrit": "स मे निर्वाप्य सहसा चक्षुषी शाम्यते पुनः ।\nतन्निवर्त महान् कालो गच्छतोर्विनतात्मज\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2147205, "chapter_id": 4180, "verse_number": "१७", "content_sanskrit": "न मे प्रयोजनं किञ्चिद् गमने पन्नगाशन ।\nसन्निवर्त महाभाग न वेगं विषहामि ते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2147206, "chapter_id": 4180, "verse_number": "१८", "content_sanskrit": "गुरवे मच्छ्रुतानीह शतान्यष्टौ च वाजिनाम् ।\nएकतः श्यामकर्णानां शुभ्राणां चन्द्रवर्चसाम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2147207, "chapter_id": 4180, "verse_number": "१९", "content_sanskrit": "तेषां चैवापवर्गाय मार्गं पश्यामि नाण्डज ।\nततोऽयं जीवितत्यागे दृष्टो मार्गो मया द्विज\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2147208, "chapter_id": 4180, "verse_number": "२०", "content_sanskrit": "नैव मेऽस्ति धनं किञ्चिन्न धनेनान्वितः सुहृत् ।\nन चार्थेनापि महता शक्यमेतद् व्यपोहितुम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2147209, "chapter_id": 4180, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2147210, "chapter_id": 4180, "verse_number": "२१", "content_sanskrit": "एवं बहु च दीनं च ब्रुवाणं गालवं तदा ।\nप्रत्युवाच व्रजन्नेव प्रहसन् विनतात्मजः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2147211, "chapter_id": 4180, "verse_number": "२२", "content_sanskrit": "नातिप्रज्ञोऽसि विप्रर्षे यो त्मानं त्यक्तुमिच्छसि ।\nन चापि कृत्रिमः कालः कालो हि परमेश्वरः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2147212, "chapter_id": 4180, "verse_number": "२३", "content_sanskrit": "किमहं पूर्वमेवेदं भवता नाभिचोदितः ।\nउपायोऽत्र महानस्ति येनैतदुपपद्यते\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2147213, "chapter_id": 4180, "verse_number": "२४", "content_sanskrit": "तदेष ऋषभो नाम पर्वतः सागरोरसि ।\nअत्र विश्रम्य भुक्त्वा च निवर्तिष्याव गालव\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2147214, "chapter_id": 4180, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकादशोत्तरशततमोऽध्यायः ॥१११॥\nभगवद्यानपर्वणि द्विचत्वारिंशोऽध्यायः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]