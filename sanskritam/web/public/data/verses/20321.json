[{"id": 7000321000, "chapter_id": 20321, "verse_number": "१-७५-१", "content_sanskrit": "व्यास उवाच ।\nश्रुत्वा महेश्वराद्वाक्यं देवाः शक्रपुरोगमाः ।\nदुद्रुवुर्दैत्यसंघांस्तान्सर्वे सर्वान्समंततः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000321001, "chapter_id": 20321, "verse_number": "१-७५-२", "content_sanskrit": "आजगाम महाबाहुः कुंभो नाम महासुरः ।\nनैरृतो यक्षराजानं गदया चाहनद्भृशम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000321002, "chapter_id": 20321, "verse_number": "१-७५-३", "content_sanskrit": "गुह्यकेशो गदापातैर्जघान भृशमुत्तमम् ।\nततोन्योन्यं गदायुद्धमभवद्भीषणं तयोः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000321003, "chapter_id": 20321, "verse_number": "१-७५-४", "content_sanskrit": "चक्रबंधं महाबंधं पुरोवध्यनिबंधनम् ।\nप्राचुरं भीषणं यानं स्फोटतैलाभिवास्तिकम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000321004, "chapter_id": 20321, "verse_number": "१-७५-५", "content_sanskrit": "तेन कृत्वा महायुद्धमवसाने धनेश्वरः ।\nपातयामास तं स्फोटं तस्य कुंभस्य चोरसि॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000321005, "chapter_id": 20321, "verse_number": "१-७५-६", "content_sanskrit": "भग्नदंष्ट्रस्ततः कुंभो निपपात महीतले ।\nस्यंदनस्थो महावीर्यो जंभो हरिहयं तदा॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000321006, "chapter_id": 20321, "verse_number": "१-७५-७", "content_sanskrit": "जघानशरसंघैश्च तथैवैरावणं भृशम् ।\nवासवो भिदुरेणैव संबिभेदासुरोत्तमम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000321007, "chapter_id": 20321, "verse_number": "१-७५-८", "content_sanskrit": "स पपात धरापृष्ठे गतासुर्लोहितोक्षितः ।\nतथारण्यं सुघोरं च अघोरं घोरमेव च॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000321008, "chapter_id": 20321, "verse_number": "१-७५-९", "content_sanskrit": "चतुरो गणमुख्यांश्च शक्त्या बिभेद संयुगे ।\nसेनान्यश्चैव प्रत्येकं पातयामास लाघवात्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000321009, "chapter_id": 20321, "verse_number": "१-७५-१०", "content_sanskrit": "सौरभं शरसंघैश्च जयंतो वशमानयत् ।\nशक्तिहस्तं च संह्रादं यमदंडं नरांतकम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000321010, "chapter_id": 20321, "verse_number": "१-७५-११", "content_sanskrit": "हत्वा च पातयामास स भस्मीकृतविग्रहः ।\nकालश्च खड्गपातेन पातयामास बाभ्रवम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000321011, "chapter_id": 20321, "verse_number": "१-७५-१२", "content_sanskrit": "शक्त्या मृत्युर्बिभेदाश्वं तथा निर्घृणकं रणे ।\nअग्निना दह्यमानाश्च सप्तैते च महाबलाः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000321012, "chapter_id": 20321, "verse_number": "१-७५-१३", "content_sanskrit": "भद्रबाहुर्महाबाहुः सुगंधो गंध एव च ।\nभौरिको वल्लिको भीम एते सेनाग्रगामिनः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000321013, "chapter_id": 20321, "verse_number": "१-७५-१४", "content_sanskrit": "रणे संदग्धदेहाश्च पेतुरुर्व्यां गतासवः ।\nपाशबद्धा महावीर्या वरुणस्य महात्मनः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000321014, "chapter_id": 20321, "verse_number": "१-७५-१५", "content_sanskrit": "पेतुरुर्व्यां महासत्वाः शूराः शूरभयानकाः ।\nशूरस्य रश्मिजालेन निहताः पञ्चदानवाः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000321015, "chapter_id": 20321, "verse_number": "१-७५-१६", "content_sanskrit": "तुरुतुंबुरुदुर्मेधस्साधका साधकाभिधाः ।\nक्रूर क्रौंच रणेशान मोदसंमोद षण्मुखाः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000321016, "chapter_id": 20321, "verse_number": "१-७५-१७", "content_sanskrit": "शरैर्निपातिता दैत्याः संयुगे मातरिश्वना ।\nनैरृतो गदया भीमं पातयामास भूतले॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000321017, "chapter_id": 20321, "verse_number": "१-७५-१८", "content_sanskrit": "शूलपातैश्च रुद्राणां शतशो दैत्यदानवाः ।\nनिपेतुः संयुगे भीताः संमुखा रणपंडिताः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000321018, "chapter_id": 20321, "verse_number": "१-७५-१९", "content_sanskrit": "वसूनां शरपातैश्च शूराणां रश्मिमालिनाम् ।\nमेघानां करकाभिश्च वज्रपातैस्सुदारुणैः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000321019, "chapter_id": 20321, "verse_number": "१-७५-२०", "content_sanskrit": "निपातिता रणे दैत्याः शतशो बलशालिनः ।\nकुबेरस्य गदापातैर्निपतंति सहस्रशः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000321020, "chapter_id": 20321, "verse_number": "१-७५-२१", "content_sanskrit": "शक्रस्य भिदुरेणैव भेदिता दैत्यपुंगवाः ।\nअसंख्याताः पतंत्युर्व्यां स्कंदशक्त्या तथा हताः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000321021, "chapter_id": 20321, "verse_number": "१-७५-२२", "content_sanskrit": "गणेशपर्शुपातेन पतंति मुख्यमुख्यकाः ।\nवैकुंठकरमुक्तेन चक्रेण तीव्रकर्मणा॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000321022, "chapter_id": 20321, "verse_number": "१-७५-२३", "content_sanskrit": "दैत्यानां प्रवराणां च शिरांसि निपतंति कौ ।\nशमनो यमदंडेन कोटिकोटिसहस्रशः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000321023, "chapter_id": 20321, "verse_number": "१-७५-२४", "content_sanskrit": "अपातयत्तदा भूम्यां कालः खड्गेन दानवान् ।\nमृत्युश्शक्त्या तथा दैत्यान्पाशी पाशेन चापरान्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000321024, "chapter_id": 20321, "verse_number": "१-७५-२५", "content_sanskrit": "पातेन तक्षकादीनां सुधांशोः शिशिरेण च ।\nअश्वारोही खरोमन्योहनिपाशस्तथा गजान्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000321025, "chapter_id": 20321, "verse_number": "१-७५-२६", "content_sanskrit": "परिघेण गजं कुंभे दैत्यानां नाशयत्ततः ।\nएवमश्वान्गजांश्चैव लाघवात्स न्यपातयत्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000321026, "chapter_id": 20321, "verse_number": "१-७५-२७", "content_sanskrit": "एवं सिद्धैश्च गंधर्वैरप्सरोभिर्महाबलैः ।\nअन्याभिर्देवताभिश्च समातृगणनायकैः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000321027, "chapter_id": 20321, "verse_number": "१-७५-२८", "content_sanskrit": "निपातिता महोघोरा ये ते प्रलयदानवाः ।\nशरैश्च खड्गपातैश्च शूलशक्तिपरश्वधैः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000321028, "chapter_id": 20321, "verse_number": "१-७५-२९", "content_sanskrit": "यष्टिपरिघकुंतैश्च पातयंत्यसुरान्सुराः ।\nएवं संक्षीयमाणेषु दैत्यराट्समपद्यत॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000321029, "chapter_id": 20321, "verse_number": "१-७५-३०", "content_sanskrit": "आदित्यरथसंकाशं रथरत्नविभूषितम् ।\nशातकुंभमयं दिव्यं घंटाचामरभूषितम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000321030, "chapter_id": 20321, "verse_number": "१-७५-३१", "content_sanskrit": "पताकाध्वजसंपूर्णं रम्यं शक्ररथोपमम् ।\nसमारुह्य महावीरो हिरण्याक्षोऽसुराधिपः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000321031, "chapter_id": 20321, "verse_number": "१-७५-३२", "content_sanskrit": "जघान शरजालैश्च दुर्निवार्यः सुरासुरैः ।\nससैन्यानि गजान्वीरो रथांश्च सह सैंधवान्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000321032, "chapter_id": 20321, "verse_number": "१-७५-३३", "content_sanskrit": "पातयामास भूमौ च शतशोथ सहस्रशः ।\nएवं चरन्स वृंदेषु निखिलेषु दिवौकसाम्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000321033, "chapter_id": 20321, "verse_number": "१-७५-३४", "content_sanskrit": "पातयामास दैत्येंद्रः शरौघान्मृत्युसन्निभान् ।\nक्रमेण समरे चाथ देवसैन्यान्यमंथत॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000321034, "chapter_id": 20321, "verse_number": "१-७५-३५", "content_sanskrit": "यथा पुष्करिणीवृंदे गजः कंजवनं शितैः ।\nशरपातैरथो वेगात्सिंहनादैः पुनः पुनः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000321035, "chapter_id": 20321, "verse_number": "१-७५-३६", "content_sanskrit": "धरण्यां पतिता वेगात्तदा दैत्येश्वरस्य च ।\nदशभिश्च सुतीक्ष्णाग्रैर्जयंतं स जघान ह॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000321036, "chapter_id": 20321, "verse_number": "१-७५-३७", "content_sanskrit": "रेमंतं पंचभिर्बाणैः शक्रं पंचदशेन तु ।\nचित्ररथं विंशतिभिःपंचविंशतिभिर्गुहम्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000321037, "chapter_id": 20321, "verse_number": "१-७५-३८", "content_sanskrit": "हेरंबं त्रिशरेणैव चत्वारिंशच्छरैर्यमम् ।\nतथैव कालं मृत्युं च पाणिना द्विगुणेन च॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000321038, "chapter_id": 20321, "verse_number": "१-७५-३९", "content_sanskrit": "गुह्यकेशं जगत्प्राणं दशभिर्दशभिः शरैः ।\nषडिभश्च सप्तभिश्चैव रुद्रान्सर्वान्पृथक्पृथक्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000321039, "chapter_id": 20321, "verse_number": "१-७५-४०", "content_sanskrit": "वसून्सर्वांश्च सशरैः सिद्धगंधर्वपन्नगान् ।\nदशाष्टदशभिः षडिभर्युद्धे देवान्भिनत्त्यसौ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000321040, "chapter_id": 20321, "verse_number": "१-७५-४१", "content_sanskrit": "ओजौघादतिवीर्यात्तु शीघ्रलाघवर्दशनान् ।\nआपत्प्राप्ताः सुरा भीत्या प्रतिकर्तुं न चेश्वराः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000321041, "chapter_id": 20321, "verse_number": "१-७५-४२", "content_sanskrit": "महेशशूलसंकाशैः शरैर्मर्मविभेदिभिः ।\nताडिता निर्जरा युद्धे मूर्च्छिता धरणीं ययुः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000321042, "chapter_id": 20321, "verse_number": "१-७५-४३", "content_sanskrit": "तस्यैव संमुखे स्थातुं न शेकुः प्रवरास्सुराः ।\nततो देवा विनिर्धूतास्त्रिदिवेशेन संयुताः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000321043, "chapter_id": 20321, "verse_number": "१-७५-४४", "content_sanskrit": "शरण्यं ते हरिं तत्र शरणं ताडिता ययुः ।\nएतस्मिन्नंतरे विष्णुः प्राह जिष्णुं खगेश्वरम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000321044, "chapter_id": 20321, "verse_number": "१-७५-४५", "content_sanskrit": "अधुना गच्छ दैत्यस्य संमुखं रणमूर्धनि ।\nनाशाय सततस्तूर्णं गतस्तस्यांतिकं जवात्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000321045, "chapter_id": 20321, "verse_number": "१-७५-४६", "content_sanskrit": "सरथं मार्गणैर्भित्वा विष्णुमारोधयज्जवम् ।\nरथस्य संमुखे दैत्य उवाच विष्णुमव्ययम्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000321046, "chapter_id": 20321, "verse_number": "१-७५-४७", "content_sanskrit": "अन्य सृष्टिं करोम्यद्य हत्वा त्वां च सनिर्ज्जरम् ।\nततो विष्णुरुवाचेदं गर्जंतं दैत्यपुंगवम्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000321047, "chapter_id": 20321, "verse_number": "१-७५-४८", "content_sanskrit": "शक्तस्त्वं स्पर्द्धने पाप यदि युद्धे स्थिरो भव ।\nततः शरशतैरेव जघान विष्णुमव्ययम्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000321048, "chapter_id": 20321, "verse_number": "१-७५-४९", "content_sanskrit": "असंभ्रांतः स चिच्छेद यमदंडनिभान्शरान् ।\nपुनः शरसहस्राणि प्रेरयामास तं रणे॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000321049, "chapter_id": 20321, "verse_number": "१-७५-५०", "content_sanskrit": "तांश्च छित्वा शरैः शौरिस्तं च विव्याध मार्गणैः ।\nप्रगौरवादहार्याभैः संस्पर्शाद्बाडवानलैः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000321050, "chapter_id": 20321, "verse_number": "१-७५-५१", "content_sanskrit": "शरैश्च भेदकैस्तीक्ष्णैः खगमैश्च मनोजवैः ।\nलाघवात्केशवास्त्रस्य तूलशुष्कतृणोपमैः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000321051, "chapter_id": 20321, "verse_number": "१-७५-५२", "content_sanskrit": "हैमैः शरसहस्रैस्तु ताडितो दैत्यपुंगवः ।\nबाधयाभ्यर्दितः क्रुद्धो धृत्वा शिखरिणं रणे॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000321052, "chapter_id": 20321, "verse_number": "१-७५-५३", "content_sanskrit": "जघान माधवं वेगाद्धिरण्याक्षो महाबलः ।\nतं च संचूर्णयामास गदया लीलया हरिः॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000321053, "chapter_id": 20321, "verse_number": "१-७५-५४", "content_sanskrit": "एवं पर्वतसाहस्रं पातितं तु क्रमेण हि ।\nतथैव लाघवाच्चूर्णं हरिणा दानवारिणा॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000321054, "chapter_id": 20321, "verse_number": "१-७५-५५", "content_sanskrit": "पुनर्बाहुसहस्राणि कृत्वासौ दानवोत्तमः ।\nशरैः शक्तिभिरत्युग्रैः शूलैः परशुकादिभिः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000321055, "chapter_id": 20321, "verse_number": "१-७५-५६", "content_sanskrit": "ववर्ष बहुभिर्विष्णुं क्रोधाविष्टेन चेतसा ।\nतांस्तु तेनैव प्रहितांश्चिच्छेद सुरसत्तमः॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000321056, "chapter_id": 20321, "verse_number": "१-७५-५७", "content_sanskrit": "शरैर्दीप्तैर्महाघोरैरसुराणां भयंकरैः ।\nविव्याध सर्वगात्रेषु शंभुशूलोपमैश्शरैः॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000321057, "chapter_id": 20321, "verse_number": "१-७५-५८", "content_sanskrit": "दानवाधिपतिः संख्ये ह्यव्ययो हरिरीश्वरः ।\nस च कश्मलतां गत्वा सर्वशक्तिमनुत्तमाम्॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000321058, "chapter_id": 20321, "verse_number": "१-७५-५९", "content_sanskrit": "कालजिह्वोपमां घोरामष्टघंटासमन्विताम् ।\nहरेरुरसि पीने च विद्रुत्या पातयद्द्रुतम्॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000321059, "chapter_id": 20321, "verse_number": "१-७५-६०", "content_sanskrit": "शुशुभे स सुरश्रेष्ठस्तडित्त्वत्सान्द्रमेघवत् ।\nततश्च चुक्रुशुर्दैत्या जयेति साधुवादिनः॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000321060, "chapter_id": 20321, "verse_number": "१-७५-६१", "content_sanskrit": "ततश्चक्रं दैत्यसैन्ये दानवारिर्व्यसर्जयत् ।\nतेषां शिरांसि संच्छिद्य माधवं पुनरागमत्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000321061, "chapter_id": 20321, "verse_number": "१-७५-६२", "content_sanskrit": "स दैत्यं शक्तिपातेन पातयामास वै रणे ।\nचिरात्संज्ञां समालंब्य वह्निबाणेन केशवम्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000321062, "chapter_id": 20321, "verse_number": "१-७५-६३", "content_sanskrit": "निजघान रणे क्रुद्धो हरिः कौबेरमाक्षिपत् ।\nततो मुमोच मायास्त्रं चासुरं चातिदारुणम्॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000321063, "chapter_id": 20321, "verse_number": "१-७५-६४", "content_sanskrit": "सिंहव्याघ्रलुलायांश्च तद्वद्द्विप सरीसृपान् ।\nजघान समरे विष्णुं हिरण्याक्षः प्रतापवान्॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000321064, "chapter_id": 20321, "verse_number": "१-७५-६५", "content_sanskrit": "ततो मायास्त्रसंभूतान्शस्त्रास्त्रौघान्रणे हरिः ।\nप्रचिच्छेद शरैरेव शूलेनैवमताडयत्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000321065, "chapter_id": 20321, "verse_number": "१-७५-६६", "content_sanskrit": "स विह्वलित सर्वांगस्तत्क्षणं लोहितोक्षितः ।\nविचकर्ष हरन्विष्णुरसृग्विप्लुतविग्रहः॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000321066, "chapter_id": 20321, "verse_number": "१-७५-६७", "content_sanskrit": "तच्छूलं च त्रिभिर्बाणैः प्रविव्याध सुराधिपः ।\nवरूथं सध्वजं केतुं रथं चैवातपत्रकम्॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000321067, "chapter_id": 20321, "verse_number": "१-७५-६८", "content_sanskrit": "यंतारं च प्रचिच्छेद दशभिश्च हरिः शरैः ।\nपातिते च रथे दैत्यः संप्लुत्याथ रथं परम्॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000321068, "chapter_id": 20321, "verse_number": "१-७५-६९", "content_sanskrit": "आरुरोह स दैत्येंद्रः संमुखं चाकरोद्बली ।\nततो युद्धं महाघोरमभवल्लोमहर्षणम्॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000321069, "chapter_id": 20321, "verse_number": "१-७५-७०", "content_sanskrit": "हिरण्याक्षस्य च हरेर्लोकविस्मापनं महत् ।\nअस्त्रयुद्धं तथान्योन्यं कृतप्रतिकृतं च तत्॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000321070, "chapter_id": 20321, "verse_number": "१-७५-७१", "content_sanskrit": "ततो नियुद्धे सततं दिव्यवर्षशतं गतम् ।\nततो दैत्यो महासत्वो ववृधे वामनो यथा॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000321071, "chapter_id": 20321, "verse_number": "१-७५-७२", "content_sanskrit": "मुखेन जग्राह रुषा त्रैलोक्यं सचराचरम् ।\nभूमंडलं समुद्धृत्य विवेश च रसातलम्॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000321072, "chapter_id": 20321, "verse_number": "१-७५-७३", "content_sanskrit": "शेषाश्च विविशुर्दैत्यास्तमनु प्रीतिसंयुताः ।\nततो विष्णुर्महातेजा ज्ञात्वा दैत्यबलं महत्॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000321073, "chapter_id": 20321, "verse_number": "१-७५-७४", "content_sanskrit": "दधार रूपं वाराहं दैत्यराजजिघांसया ।\nधृत्वा क्रोडतनुं विष्णुर्विवेश तमनुद्रुतम्॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000321074, "chapter_id": 20321, "verse_number": "१-७५-७५", "content_sanskrit": "तत्र गत्वा रसामूले रसातलगतां महीम् ।\nदृष्ट्वा स्वदंष्ट्रयोर्दध्रे लोकाधारां वसुंधराम्॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000321075, "chapter_id": 20321, "verse_number": "१-७५-७६", "content_sanskrit": "तां धृत्वा गच्छतस्तस्य विष्णोरमिततेजसः ।\nसमाजगाम दैत्येंद्रो धृष्टं वाग्भिस्तुदन्ननु॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000321076, "chapter_id": 20321, "verse_number": "१-७५-७७", "content_sanskrit": "मायाक्रोडतनुर्विष्णुर्दुर्वचांसि सहन्रुषा ।\nजलोपरि दधारेमां धरां भूधर एव च॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000321077, "chapter_id": 20321, "verse_number": "१-७५-७८", "content_sanskrit": "तस्यां न्यस्य स्वसत्वं च स चकार तदाचलाम् ।\nततः पश्चात्स संलग्नो दैत्यराट्समुपस्थितः॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000321078, "chapter_id": 20321, "verse_number": "१-७५-७९", "content_sanskrit": "क्रोधेन महताविष्टो जघान गदया हरिम् ।\nमायया सूकरो विष्णुस्तां गदां समवंचयत्॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000321079, "chapter_id": 20321, "verse_number": "१-७५-८०", "content_sanskrit": "योगयुक्तो यथा मृत्युं कौमोदक्याहनच्च तम् ।\nततः पुना रुषाविष्टो हिरण्याक्षो महाबलः॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000321080, "chapter_id": 20321, "verse_number": "१-७५-८१", "content_sanskrit": "मुष्टिना प्राहरद्देवं दक्षिणे तु भुजे प्रभोः ।\nएवं युद्धं महाघोरं सव्यासव्यं गतागतम्॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000321081, "chapter_id": 20321, "verse_number": "१-७५-८२", "content_sanskrit": "परिभ्रमणविक्षेपं कृतानुकरणं तथा ।\nततो ब्रह्मादयो देवा युद्धं पश्यंति खे स्थिताः॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000321082, "chapter_id": 20321, "verse_number": "१-७५-८३", "content_sanskrit": "स्वस्ति प्रजाभ्यो देवेभ्य ऋषिभ्यश्चेति चाब्रुवन् ।\nऊचुश्च देवदेवेशं विष्णुं वाराहरूपिणम्॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000321083, "chapter_id": 20321, "verse_number": "१-७५-८४", "content_sanskrit": "मा क्रीड बालवद्देव जह्यमुं देवकंटकम् ।\nततो विष्णुर्महातेजा मायावाराहरूपधृत्॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000321084, "chapter_id": 20321, "verse_number": "१-७५-८५", "content_sanskrit": "ब्रह्माद्यनुमतिं प्राप्य चक्रं प्राक्षिपदुल्बणम् ।\nसहस्रसूर्यसंकाशं सहस्रारं महाप्रभम्॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000321085, "chapter_id": 20321, "verse_number": "१-७५-८६", "content_sanskrit": "दैत्यांतकरणं रौद्रं प्रलयाग्निसमप्रभम् ।\nतच्चक्रं विष्णुना मुक्तं हिरण्याक्षं महाबलम्॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000321086, "chapter_id": 20321, "verse_number": "१-७५-८७", "content_sanskrit": "चकार भस्मसात्सद्यो ब्रह्मादीनां च पश्यताम् ।\nदैत्यांतकरणं रौद्रं चक्रं चागमदच्युतम्॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000321087, "chapter_id": 20321, "verse_number": "१-७५-८८", "content_sanskrit": "ततो ब्रह्मादयो देवाः शक्रमुख्याश्च लोकपाः ।\nदृष्ट्वा च विजयं विष्णोः स्तुवंति स्म समागताः॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000321088, "chapter_id": 20321, "verse_number": "१-७५-८९", "content_sanskrit": "देवा ऊचुः ।\nनताः स्म विष्णुं जगदादिभूतं सुरासुरेंद्रं जगतां प्रपालकम् ।\nयन्नाभिपद्मात्किल पद्मयोनिर्बभूव तं वै शरणं गताः स्मः॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000321089, "chapter_id": 20321, "verse_number": "१-७५-९०", "content_sanskrit": "नमोनमो मत्स्यवपुर्द्धराय नमोस्तु ते कच्छपरूपधारिणे ।\nनमः प्रकुर्मश्च नृसिंहरूपिणे तथा पुनर्वामनरूपिणे नमः॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000321090, "chapter_id": 20321, "verse_number": "१-७५-९१", "content_sanskrit": "नमोस्तु ते क्षत्रविनाशनाय रामाय रामाय दशास्यनाशिने ।\nप्रलंबहंत्रे शितिवाससे नमो नमोस्तु बुद्धाय च दैत्यमोहिने॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000321091, "chapter_id": 20321, "verse_number": "१-७५-९२", "content_sanskrit": "म्लेच्छांतकायापि च कल्किनाम्ने नमः पुनः क्रोडवपुर्धराय ।\nजगद्धितार्थं च युगेयुगे भवान्बिभर्ति रूपं त्वसुराभवाय॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000321092, "chapter_id": 20321, "verse_number": "१-७५-९३", "content_sanskrit": "निषूदितोऽयं ह्यधुना किल त्वया दैत्यो हिरण्याक्ष इति प्रगल्भः ।\nयश्चेंद्रमुख्यान्किललोकपालान्संहेलया चैव तिरश्चकार॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000321093, "chapter_id": 20321, "verse_number": "१-७५-९४", "content_sanskrit": "स वै त्वया देवहितार्थमेव निपातितो देववर प्रसीद ।\nत्वमस्य विश्वस्य विसर्गकर्ता ब्राह्मेण रूपेण च देवदेव॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000321094, "chapter_id": 20321, "verse_number": "१-७५-९५", "content_sanskrit": "पाता त्वमेवास्य युगेयुगे च रूपाणि धत्से सुमनोहराणि ।\nत्वमेव कालाग्निहरश्च भूत्वा विश्वं क्षयं नेष्यसि चांतकाले॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000321095, "chapter_id": 20321, "verse_number": "१-७५-९६", "content_sanskrit": "अतो भवानेव च विश्वकारणं न ते परं जीवमजीवमीश ।\nयत्किंच भूतं च भविष्यरूपं प्रवर्त्तमानं च तथैव रूपम्॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000321096, "chapter_id": 20321, "verse_number": "१-७५-९७", "content_sanskrit": "सर्वं त्वमेवासि चराचराख्यं न भाति विश्वं त्वदृते च किंचित् ।\nअस्तीति नास्तीति च भेदनिष्ठं त्वय्येव भातं सदसत्स्वरूपम्॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000321097, "chapter_id": 20321, "verse_number": "१-७५-९८", "content_sanskrit": "ततो भवंतं कतमोपि देव न ज्ञातुमर्हत्यविपक्वबुद्धिः ।\nऋते भवत्पादपरायणं जनं तेनागता स्मश्शरणं शरण्यम्॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000321098, "chapter_id": 20321, "verse_number": "१-७५-९९", "content_sanskrit": "व्यास उवाच ।\nततो विष्णुः प्रसन्नात्मा उवाच त्रिदिवौकसः ।\nतुष्टोस्मि देवा भद्रं वो युष्मत्स्तोत्रेण सांप्रतम्॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000321099, "chapter_id": 20321, "verse_number": "१-७५-१००", "content_sanskrit": "य इदं प्रपठेद्भक्त्या विजयस्तोत्रमादरात् ।\nन तस्य दुर्लभं देवास्त्रिषुलोकेषु किंचन॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000321100, "chapter_id": 20321, "verse_number": "१-७५-१०१", "content_sanskrit": "गवां शतसहस्रस्य सम्यग्दत्तस्य यत्फलम् ।\nतत्फलं समवाप्नोति कीर्तनाच्छ्रवणान्नरः॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000321101, "chapter_id": 20321, "verse_number": "१-७५-१०२", "content_sanskrit": "सर्वकामप्रदं नित्यं देवदेवस्य कीर्तनम् ।\nअतः परं महाज्ञानं न भूतं न भविष्यति॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}]