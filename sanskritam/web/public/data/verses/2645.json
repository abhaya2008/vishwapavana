[{"id": 2077589, "chapter_id": 2645, "verse_number": "१२-१५०-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2077590, "chapter_id": 2645, "verse_number": "१२-१५०-१", "content_sanskrit": "एवमुक्तः प्रत्युवाच तं मुनिं जनमेजयः।\nगर्ह्यं भवान्गर्हयते निन्द्यं निन्दति मां पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2077591, "chapter_id": 2645, "verse_number": "१२-१५०-२", "content_sanskrit": "धिक्कार्यं मां धिक्कुरुते तस्मात्त्वाऽहं प्रसादये।\nसर्वं हीदं स्वकृतं मे ज्वलाम्यग्नाविवाहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2077592, "chapter_id": 2645, "verse_number": "१२-१५०-३", "content_sanskrit": "स्वकर्माण्यभिसंधाय नाभिनन्दति मे मनः।\nप्राप्तं घोरं भयं नूनं मया वैवस्वतादपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2077593, "chapter_id": 2645, "verse_number": "१२-१५०-४", "content_sanskrit": "तत्तु शल्यमनिर्हृत्य कथं शक्ष्यामि जीवितुम्।\nसर्वं मन्युं विनीय त्वमभि मां वद शौनक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2077594, "chapter_id": 2645, "verse_number": "१२-१५०-५", "content_sanskrit": "[महानासं ब्राह्मणानां भूयो वक्ष्यामि सांप्रतम्।]\n`गन्ता गतिं ब्राह्मणानां भविष्याम्यर्थवान्पुनः।\nअस्तु शेषं कुलस्यास्य मा पराभूदिदं कुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2077595, "chapter_id": 2645, "verse_number": "१२-१५०-६", "content_sanskrit": "न हि नो ब्रह्मशप्तानां शेषं भवितुमर्हति।\nस्तुतीरलभमानानां संविदं वेद निश्चयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2077596, "chapter_id": 2645, "verse_number": "१२-१५०-७", "content_sanskrit": "निन्दमानः स्वमात्मानं भूयो वक्ष्यामि सांप्रतम्।\nभूयश्चैवाभिमज्जन्ति निर्धर्मा निर्जला इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2077597, "chapter_id": 2645, "verse_number": "१२-१५०-८", "content_sanskrit": "न ह्ययज्ञा अमुं लोकं प्राप्नुवन्ति कथंचन।\nअवाक्च प्रपतिष्यन्ति पुलिन्दशवरा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2077598, "chapter_id": 2645, "verse_number": "१२-१५०-९", "content_sanskrit": "अविज्ञायैव मे प्रज्ञां बालस्येव स पण्डितः।\nब्रह्मन्पितेव पुत्रस्य प्रीतिमान्भव शौनक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2077599, "chapter_id": 2645, "verse_number": "१२-१५०-१०x", "content_sanskrit": "शौनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2077600, "chapter_id": 2645, "verse_number": "१२-१५०-१०", "content_sanskrit": "किमाश्चर्यं यतः प्राज्ञो बहुकुर्यादसांप्रतम्।\nइति वै पण्डितो भूत्वा भूतानां को नु तप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2077601, "chapter_id": 2645, "verse_number": "१२-१५०-११", "content_sanskrit": "प्रज्ञाप्रासादमारुह्य अशोच्यः शोचते जनान्।\nजगतीस्थानिवाद्रिस्थः प्रज्ञया प्रतिपत्स्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2077602, "chapter_id": 2645, "verse_number": "१२-१५०-१२", "content_sanskrit": "न चोपलभते कश्चिन्न चाश्चर्याणि पश्यति।\nनिर्विण्णात्मा परोक्षो वा धिक्कृतः सर्वसाधुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2077603, "chapter_id": 2645, "verse_number": "१२-१५०-१३", "content_sanskrit": "विदित्वा भवतो वीर्यं माहात्म्यं चैव चागमे।\nकुरुष्वेह यथाशान्ति ब्रह्मा शरणमस्तु ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2077604, "chapter_id": 2645, "verse_number": "१२-१५०-१४", "content_sanskrit": "तद्वै वारित्रकं तात ब्राह्मणानामकुप्यताम्।\nअथवा तप्यसे पापे धर्मं चेदनुपश्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2077605, "chapter_id": 2645, "verse_number": "१२-१५०-१५x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2077606, "chapter_id": 2645, "verse_number": "१२-१५०-१५", "content_sanskrit": "अनुतप्ये च पापेन न चाधर्मं चराम्यहम्।\nबुभूषेद्भजमानं च प्रीतिमान्भव शौनक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2077607, "chapter_id": 2645, "verse_number": "१२-१५०-१६x", "content_sanskrit": "शौनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2077608, "chapter_id": 2645, "verse_number": "१२-१५०-१६", "content_sanskrit": "छित्त्वा दम्भं च मानं च प्रीतिमिच्छामि ते नृप।\nसर्वभूतहिते तिष्ठ धर्मं चैव प्रतिस्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2077609, "chapter_id": 2645, "verse_number": "१२-१५०-१७", "content_sanskrit": "न भयान्न च कार्पण्यान्न लोभात्त्वामुपाह्वये।\nतां मे दैवीं गिरं सत्यां शृणु त्वं ब्राह्मणैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2077610, "chapter_id": 2645, "verse_number": "१२-१५०-१८", "content_sanskrit": "सोऽहं न केनचिच्चार्थी त्वां च धर्मादुपाह्वये।\nक्रोशतां सर्वभूतानां हाहाधिगिति जल्पताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2077611, "chapter_id": 2645, "verse_number": "१२-१५०-१९", "content_sanskrit": "वक्ष्यन्ति मामधर्मज्ञं त्यक्ष्यन्ति सुहृदो जनाः।\nता वाचः सुहृदः श्रुत्वा संज्वरिष्यन्ति मे भृशं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2077612, "chapter_id": 2645, "verse_number": "१२-१५०-२०", "content_sanskrit": "केचिदेव महाप्राज्ञाः प्रतिज्ञास्यन्ति कार्यताम्।\nजानीहि मत्कृतं तात ब्राह्मणान्प्रति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2077613, "chapter_id": 2645, "verse_number": "१२-१५०-२१", "content_sanskrit": "यथा ते सत्कृताः क्षेमं लभेरंस्त्वं तथा कुरु।\nप्रतिजानीहि चाद्रोहं ब्राह्मणानां नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2077614, "chapter_id": 2645, "verse_number": "१२-१५०-२२x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2077615, "chapter_id": 2645, "verse_number": "१२-१५०-२२", "content_sanskrit": "नैव वाचा न मनसा पुनर्जातु न कर्मणा।\nद्रोग्धाऽस्मि ब्राह्मणान्विप्र चरणावेव ते स्पृशे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2077616, "chapter_id": 2645, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि पञ्चाशदधिकशततमोऽध्यायः॥ १५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]