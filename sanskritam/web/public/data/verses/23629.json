[{"id": 7003629000, "chapter_id": 23629, "verse_number": "१-२-१६-१", "content_sanskrit": "तारक उवाच ।\nराज्येन बुद्बुदाभेन स्त्रीभिरक्षैश्च पानकैः ।\nमोहितो जन्म लब्ध्वात्र त्यजते पौरुषं नरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003629001, "chapter_id": 23629, "verse_number": "१-२-१६-२", "content_sanskrit": "जन्म तस्य वृथा सर्वमाकल्पांतं न संशयः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003629002, "chapter_id": 23629, "verse_number": "१-२-१६-३", "content_sanskrit": "मातापितृभ्यां न करोति कामान्बन्धूनशोकान्न करोति यो वा ।\nकीर्तिं हि वा नार्जयते न मानं नरः स जातोऽपि मृतोऽत्र लोके ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003629003, "chapter_id": 23629, "verse_number": "१-२-१६-४", "content_sanskrit": "तस्माज्जयायामरपुंगवानां त्रैलोक्यलक्ष्मीहरणाय शीघ्रम् ।\nसंयोज्यतां मे रथमष्टचक्रं बलं च मे दुर्जयदैत्यचक्रम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003629004, "chapter_id": 23629, "verse_number": "१-२-१६-५", "content_sanskrit": "ध्वजं च मे कांचनपट्टबन्धं छत्रं च मे मौक्तिकजालबद्धम् ।\nअद्याहमासां सुरकामिनीनां धम्मील्लकांश्चाग्रथितान्करिष्ये ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003629005, "chapter_id": 23629, "verse_number": "१-२-१६-६", "content_sanskrit": "यथा पुरा मर्कटको जनन्यास्तस्याश्च सत्येन तु तारकः स्याम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003629006, "chapter_id": 23629, "verse_number": "१-२-१६-७", "content_sanskrit": "नारद उवाच ।\nतारकस्य वचः श्रुत्वा ग्रसनोनाम दानवः ।\nसेनानीर्दैत्यराजस्य तथा चक्रेऽविलंबितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003629007, "chapter_id": 23629, "verse_number": "१-२-१६-८", "content_sanskrit": "आहत्य भेरीं गम्भीरां दैत्यानाहूय सत्वरः ।\nसज्जं चक्रे रथं दैत्यो दैत्यराजस्य धीमतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003629008, "chapter_id": 23629, "verse_number": "१-२-१६-९", "content_sanskrit": "गरुडानां सहस्रेण गरुडोपमितत्विषा ।\nते हि पुत्राः सुपर्णस्य संस्थिता मेरुकन्दरे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003629009, "chapter_id": 23629, "verse_number": "१-२-१६-१०", "content_sanskrit": "विजित्य दैत्यराजेन वाहनत्वे प्रकल्पिताः ।\nअष्टाष्टचक्रः सरथश्चतुर्योजनविस्तृतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003629010, "chapter_id": 23629, "verse_number": "१-२-१६-११", "content_sanskrit": "नानाक्रीडागृहयुतो गीतवाद्यमनोहरः ।\nगंधर्वनगराकारः संयुक्तः प्रत्यदृस्यत ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003629011, "chapter_id": 23629, "verse_number": "१-२-१६-१२", "content_sanskrit": "आजग्मुस्तत्र दैत्याश्च दशा चंडपराक्रमाः ।\nकोटिकोटिपरिवारा अन्ये च बहवो रणे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003629012, "chapter_id": 23629, "verse_number": "१-२-१६-१३", "content_sanskrit": "तेषामग्रेसरो जम्भः कुजम्भोनंतरस्तथा ।\nमहिषः कुञ्जरो मेषः कालनेमिर्निमिस्तथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003629013, "chapter_id": 23629, "verse_number": "१-२-१६-१४", "content_sanskrit": "मथनो जंभकः शुम्भो दैत्येंद्रा दश नायकाः ।\nदैत्येंद्रा गिरिवर्ष्माणः संति चंडपराक्रमाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003629014, "chapter_id": 23629, "verse_number": "१-२-१६-१५", "content_sanskrit": "नानाविधप्रहरणा नानाशस्त्रास्त्रपारगाः ।\nतारकस्याभवत्केतुर्बहूरूपो महाभयः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003629015, "chapter_id": 23629, "verse_number": "१-२-१६-१६", "content_sanskrit": "क्वचिच्च राक्षसो घोरः पिशाचध्वांक्षगृध्रकः ।\nएवं बहुविधाकारः स केतुः प्रत्यदृश्यत ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003629016, "chapter_id": 23629, "verse_number": "१-२-१६-१७", "content_sanskrit": "केतुना मकरेणापि सेनानीर्ग्रसनो बभौ ।\nपैशाचं यत्र वदनं जंभस्यासीदयस्मयम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003629017, "chapter_id": 23629, "verse_number": "१-२-१६-१८", "content_sanskrit": "खरो विधुतलांगूलः कुजम्भस्याभवद्ध्वजे ।\nमहिषस्य च गोमायुः कांतो हैमस्तथां बभौ ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003629018, "chapter_id": 23629, "verse_number": "१-२-१६-१९", "content_sanskrit": "गृध्रो वै कुंजरस्यासीन्मेषस्याभूच्च राक्षसः ।\nकालनेमेर्महाकालो निमेरासीन्महातिमिः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003629019, "chapter_id": 23629, "verse_number": "१-२-१६-२०", "content_sanskrit": "राक्षसी मथनस्यापि ध्वांक्षोऽभूज्जंभकस्य च ।\nमहावृकश्च शुम्भस्य ध्वजा एवंविधा बभुः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003629020, "chapter_id": 23629, "verse_number": "१-२-१६-२१", "content_sanskrit": "अनेकाकारविन्यासादन्येषां च ध्वजा भवन् ।\nशतेन शीघ्रवेगानां व्याघ्राणां हेममालिनाम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003629021, "chapter_id": 23629, "verse_number": "१-२-१६-२२", "content_sanskrit": "ग्रसनस्य रथो युक्तो महामेघरवो बभौ ।\nशतेन चापि सिंहानां रथो जंभस्य योजितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003629022, "chapter_id": 23629, "verse_number": "१-२-१६-२३", "content_sanskrit": "कुजंभस्य रथो युक्तः पिशाचवदनैः खरैः ।\nतावद्भिर्महिषस्योष्टैर्गजस्य च हयैर्युतः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003629023, "chapter_id": 23629, "verse_number": "१-२-१६-२४", "content_sanskrit": "मेषस्य द्वीपिभिर्भीमैः कुञ्जरैः कालनेमिनः ।\nपर्वतं वै समारूढो निश्चित्य विधृतं गजैः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003629024, "chapter_id": 23629, "verse_number": "१-२-१६-२५", "content_sanskrit": "चतुर्दंष्ट्रैर्गंधवद्भिश्चर्भिर्मेघसन्निभैः ।\nशतहस्तायते कृष्णे तुरंगे हेमभूषणे ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003629025, "chapter_id": 23629, "verse_number": "१-२-१६-२६", "content_sanskrit": "सितचामरजालेन शोभिते पुष्पदामनि ।\nमथनोनाम दैत्येन्द्रः पाशहस्तो व्यराजत ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003629026, "chapter_id": 23629, "verse_number": "१-२-१६-२७", "content_sanskrit": "किंकिणीमालिनं चोष्ट्रमारूढोऽभूच्च जंभकः ।\nकालमुंचं महामेघमारूढः शुम्भदानवः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003629027, "chapter_id": 23629, "verse_number": "१-२-१६-२८", "content_sanskrit": "अन्ये च दानवा वीरा नानावाहनहेतयः ।\nप्रचण्डचित्रवर्माणः कुण्डलोष्णीषभूषिताः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003629028, "chapter_id": 23629, "verse_number": "१-२-१६-२९", "content_sanskrit": "नानाविधोत्तरासंगा नानामाल्यविभूषणाः ।\nनानासुगंधगंधाढ्या नानाबंधिशतस्तुताः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003629029, "chapter_id": 23629, "verse_number": "१-२-१६-३०", "content_sanskrit": "नानावाद्यपरिस्यंदसाग्रेसरमहारथाः ।\nनानाशौर्यकथासक्तास्तस्मिन्सैन्ये महारथाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003629030, "chapter_id": 23629, "verse_number": "१-२-१६-३१", "content_sanskrit": "तद्बलं दैत्यसिंहस्य भीमरूपं व्यदृश्यत ।\nभूमिरेणुसमालिंगत्तुरंगरथपत्तिकम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003629031, "chapter_id": 23629, "verse_number": "१-२-१६-३२", "content_sanskrit": "स च दैत्येश्वरः क्रुद्धः समारूढो महारथम् ।\nदशभिः शुशुबे दैत्यैर्दशबाहुरिवेश्वरः ।\nजगद्धंतुं प्रवृत्तो वा प्रतस्थेऽसौ सुरान्प्रति ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003629032, "chapter_id": 23629, "verse_number": "१-२-१६-३३", "content_sanskrit": "एतस्मिन्नंतरे वायुर्देवदूतः सुरालयम् ।\nदृष्ट्वा तद्दानव बलं जगामेंद्रस्य शंसितुम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003629033, "chapter_id": 23629, "verse_number": "१-२-१६-३४", "content_sanskrit": "स गत्वा तु सभां दिव्यां महेंद्रस्य महात्मनः ।\nशशंस मध्ये देवानामिदं कार्यमुपस्थितम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003629034, "chapter_id": 23629, "verse_number": "१-२-१६-३५", "content_sanskrit": "तच्छ्रुत्वा देवराजः स निमीलितविलोचनः ।\nबृहस्पतिमुवाचेदं वाक्यं काले महामतिः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003629035, "chapter_id": 23629, "verse_number": "१-२-१६-३६", "content_sanskrit": "इन्द्र उवाच ।\nसंप्राप्तोऽतिविमर्दोऽयं देवानां दानवैः सह ।\nकार्यं किमत्र तद्ब्रुहि नीत्युपायोपबृंहितम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003629036, "chapter_id": 23629, "verse_number": "१-२-१६-३७", "content_sanskrit": "एतच्छ्रुत्वा च वचनं महेंद्रस्य गिरांपतिः ।\nप्रत्युवाच महाभागो बॉहस्पति रुदारधीः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003629037, "chapter_id": 23629, "verse_number": "१-२-१६-३८", "content_sanskrit": "बृहस्पतिरुवाच ।\nसामपूर्वं स्मृता नीतिश्चतुरंगामनीकिनीम् ।\nजिगीषतां सुरश्रेष्ठ स्थितिरेषा सनातनी ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003629038, "chapter_id": 23629, "verse_number": "१-२-१६-३९", "content_sanskrit": "साम दानं च भेदश्च चतुर्थो दंड एव च ।\nनीतौ क्रमात्प्रयोज्याश्च देशकालविशेषतः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003629039, "chapter_id": 23629, "verse_number": "१-२-१६-४०", "content_sanskrit": "तत्र साम प्रयोक्तव्यमार्येषु गुणवत्सु च ।\nदानं लुब्धेषु भेदश्च शंकितोष्वितो निश्चयः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003629040, "chapter_id": 23629, "verse_number": "१-२-१६-४१", "content_sanskrit": "दण्डश्चापि प्रयोक्तव्यो नित्यकालं दुरात्मसु ।\nसाम दैत्येषु नैवास्ति निर्गुणत्वाद्दुरात्मसु ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003629041, "chapter_id": 23629, "verse_number": "१-२-१६-४२", "content_sanskrit": "श्रिया तेषां च किं कार्यं समृद्धानां तथापि यत् ।\nजातिधर्मेण चाभेद्या विधातुरपि ते मताः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003629042, "chapter_id": 23629, "verse_number": "१-२-१६-४३", "content_sanskrit": "एको ह्युपायो दंडोऽत्र भवतां यदि रोचते ।\nदुर्जनः सुजनत्वाय कल्पते न कदाचन ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003629043, "chapter_id": 23629, "verse_number": "१-२-१६-४४", "content_sanskrit": "लालितः पालितो वापि स्वस्वभावं न मुंचति ।\nएवं मे मन्यते बुद्धिर्भवंतो यद्व्यवस्यताम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003629044, "chapter_id": 23629, "verse_number": "१-२-१६-४५", "content_sanskrit": "एवमुक्तः सहस्राक्ष एवमेवेत्युवाच ह ।\nकर्तव्यतां च संचिंत्य प्रोवाचामरसंसदि ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003629045, "chapter_id": 23629, "verse_number": "१-२-१६-४६", "content_sanskrit": "बहुमानेन मे वाचं श्रृणुध्वं नाकवासिनः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003629046, "chapter_id": 23629, "verse_number": "१-२-१६-४७", "content_sanskrit": "भवंतो यज्ञभोक्तारः सतामिष्टाश्च सात्त्विकाः ।\nस्वेस्वे पदे स्थिता नित्यं जगतः पालने रताः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003629047, "chapter_id": 23629, "verse_number": "१-२-१६-४८", "content_sanskrit": "भवतां च निमित्तेन बाधंते दानवेश्वराः ।\nतेषां समादि नैवास्ति दंड एव विधीयताम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003629048, "chapter_id": 23629, "verse_number": "१-२-१६-४९", "content_sanskrit": "क्रियतां समरे बुद्धिः सैन्यं संयोज्यतामिति ।\nआवाद्यंतां च शस्त्राणि पूज्यं तां शस्त्रदेवताः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003629049, "chapter_id": 23629, "verse_number": "१-२-१६-५०", "content_sanskrit": "इत्युक्ताः समनह्यंत देवानां ये प्रधानतः ।\nवाजिनामयुतेनाजौ हेमपट्टपरिष्कृताः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003629050, "chapter_id": 23629, "verse_number": "१-२-१६-५१", "content_sanskrit": "वाहनानि विमानानि योजयंतु ममामराः ।\nयमं सेनापतिं कृत्वा शीघ्रं निर्यात देवताः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003629051, "chapter_id": 23629, "verse_number": "१-२-१६-५२", "content_sanskrit": "नानाश्चर्यगुणोपेता दुर्जया देवदानवैः ।\nरथो मातलिना युक्तो महेंद्रस्याप्यदृश्यत ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003629052, "chapter_id": 23629, "verse_number": "१-२-१६-५३", "content_sanskrit": "यमो महिषमास्थाय सेनाग्रे समवर्तत ।\nचंडकिंकिणिवृंदेन सर्वतः परिवारितः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003629053, "chapter_id": 23629, "verse_number": "१-२-१६-५४", "content_sanskrit": "कल्पकालोज्जवालापूरितांबरगोचरः ।\nहुताश उरणारूढः शक्तिहस्तो व्यवस्थितः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003629054, "chapter_id": 23629, "verse_number": "१-२-१६-५५", "content_sanskrit": "पवनोंऽकुशपाणिस्तु विस्तारितमहाजवः ।\nमहाऋक्षं समारूढं सेनाग्रे समदृश्यत ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003629055, "chapter_id": 23629, "verse_number": "१-२-१६-५६", "content_sanskrit": "भुजगेन्द्रं समारूढो जलेशो भगवान्स्वयम् ।\nमहापाशधरो वीरः सेनायां समवर्तत ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003629056, "chapter_id": 23629, "verse_number": "१-२-१६-५७", "content_sanskrit": "नरयुक्ते रथे दिव्ये धनाध्यक्षो व्यचीचरत् ।\nमहासिंहरवो युद्धे गदाहस्तो व्यवस्थितः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003629057, "chapter_id": 23629, "verse_number": "१-२-१६-५८", "content_sanskrit": "राक्षसेशोऽथ निरृती रथे रक्षोमुखैर्हयैः ।\nधन्वी रक्षोगणवृतो महारावो व्यदृश्यत ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003629058, "chapter_id": 23629, "verse_number": "१-२-१६-५९", "content_sanskrit": "चंद्रादित्यावश्विनौ च वसवः साध्यदेवताः ।\nविश्वेदेवाश्च रुद्राश्च सन्नद्धास्तस्थुराहवे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003629059, "chapter_id": 23629, "verse_number": "१-२-१६-६०", "content_sanskrit": "हेमपीठत्तरासंगाश्चित्रवर्मायुधध्वजाः ।\nगंधर्वाः प्रत्यदृश्यन्त कृत्वा विश्वावसुं मुखे ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003629060, "chapter_id": 23629, "verse_number": "१-२-१६-६१", "content_sanskrit": "तथा रक्तोत्तरासंगा निर्मलायोविभूषणाः ।\nगृध्रध्वजा अदृश्यंत राक्षसा रक्तमूर्धजाः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003629061, "chapter_id": 23629, "verse_number": "१-२-१६-६२", "content_sanskrit": "तथा भीमाशनिकराः कृष्णवस्त्रा महारथाः ।\nयक्षास्तत्र व्यदृश्यंत मणिभद्रादिकोटिशः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003629062, "chapter_id": 23629, "verse_number": "१-२-१६-६३", "content_sanskrit": "ताम्रोलूकध्वजा रौद्रा द्वीपिचर्मांबरास्तथा ।\nपिशाचास्तत्र राजंते महावेगपुरःसराः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003629063, "chapter_id": 23629, "verse_number": "१-२-१६-६४", "content_sanskrit": "तथैव श्वेतवसनाः सितपट्टपताकिनः ।\nमत्तेभवाहनप्रायाः किंनरास्तस्थुराहवे ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003629064, "chapter_id": 23629, "verse_number": "१-२-१६-६५", "content_sanskrit": "मुक्ताजाल पिरष्कारो हंसो हारसमप्रभः ।\nकेतुर्जलधिनाथस्य सौम्यरूपो व्यराजत ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003629065, "chapter_id": 23629, "verse_number": "१-२-१६-६६", "content_sanskrit": "पंचरागमहारत्नविटंको धनदस्य च ।\nध्वजः समुत्थितो भाति यातुकाम इवांबरम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003629066, "chapter_id": 23629, "verse_number": "१-२-१६-६७", "content_sanskrit": "कार्ष्णलोहमयो ध्वांक्षो यमस्याभून्महाध्वजः ।\nराक्षसेशस्य वदनं प्रेतस्य ध्वज आबभौ ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003629067, "chapter_id": 23629, "verse_number": "१-२-१६-६८", "content_sanskrit": "हेमसिंहध्वजौ देवौ चन्द्रार्कवमितद्युति ।\nकुंभेन चित्रवर्णेन केतुराश्विनयोरभूत् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003629068, "chapter_id": 23629, "verse_number": "१-२-१६-६९", "content_sanskrit": "मातंगो हेमरचितश्चित्ररत्नपरिष्कृतः ।\nध्वजः शतक्रतोरासीत्सितचा मरसंस्थितः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003629069, "chapter_id": 23629, "verse_number": "१-२-१६-७०", "content_sanskrit": "अन्येषां च ध्वजास्तत्र नानारूपा बभू रणे ।\nसनागयक्षगंधर्वमहोरगनिशाचरा ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003629070, "chapter_id": 23629, "verse_number": "१-२-१६-७१", "content_sanskrit": "सेना सा देवराजस्य दुर्जया प्रत्यदृश्यत ।\nकोटयस्तास्त्रयस्त्रिंशन्नानादेवकायिनाम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003629071, "chapter_id": 23629, "verse_number": "१-२-१६-७२", "content_sanskrit": "हैमाचलाभे सितकर्णचामरे सुवर्णपद्मामलसुंदरस्रजि ।\nकृताभिरामोज्ज्वलकुंकुमांकुरे कपोललीताविविमुक्तरावे ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003629072, "chapter_id": 23629, "verse_number": "१-२-१६-७३", "content_sanskrit": "श्रितस्तदैरावणनामकुंजरे महाबलश्चित्रविशेषितांबरः ।\nविशालवज्रांगवितानभूषितः प्रकीर्णकेयूरभुजाग्रमंडलः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003629073, "chapter_id": 23629, "verse_number": "१-२-१६-७४", "content_sanskrit": "सहस्रदृग्बंदिसहस्रसंस्तुतस्त्रिविष्टपेऽशोभत पाकशासनः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003629074, "chapter_id": 23629, "verse_number": "१-२-१६-७५", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्डे कौमारीकाखण्डे तारकासुरदेवेन्द्रयुद्धोपक्रमवर्णनंनाम षोडशोऽध्यायः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]