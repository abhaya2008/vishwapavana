[{"id": 2019040, "chapter_id": 1398, "verse_number": "३-३६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2019041, "chapter_id": 1398, "verse_number": "३-३६-१", "content_sanskrit": "भीमसेनवचः श्रुत्वा कुन्तीपुत्रो युधिष्ठिरः।\nनिःश्वस्य पुरुषव्याघ्रः संप्रदध्यौ परंतपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2019042, "chapter_id": 1398, "verse_number": "३-३६-२", "content_sanskrit": "श्रुता मे राजधर्माश्च वर्णानां च पृथक्पृथक्।\nआयत्यां च तदात्वे च यः पश्यति स पश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2019043, "chapter_id": 1398, "verse_number": "३-३६-३", "content_sanskrit": "धर्मस्य जानमानोऽहं गतिमग्र्यां सुदुर्विदाम्।\nकथं बलात्करिष्यामि मेरोरिव विवर्तनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2019044, "chapter_id": 1398, "verse_number": "३-३६-४", "content_sanskrit": "स मुहूर्तमिव ध्यात्वा विनिश्चित्येतिकृत्यताम्।\nभीमसेनमिद वाक्यमपदान्तरमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2019045, "chapter_id": 1398, "verse_number": "३-३६-५", "content_sanskrit": "एवमेतन्महाबाहो यथा वदसि भारत।\nइदमन्यत्समादत्स्व वाक्यं मे वाक्यकोविद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2019046, "chapter_id": 1398, "verse_number": "३-३६-६", "content_sanskrit": "महापापानि कर्माणि यानि केवलसाहसात्।\nआरभ्यन्ते भीमसेन व्यथन्ते तानि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2019047, "chapter_id": 1398, "verse_number": "३-३६-७", "content_sanskrit": "सुमन्त्रिते सुविक्रान्ते सुकृतेसुविचारिते।\nसिद्ध्यन्त्यर्था महाबाहो दैवं चात्र प्रदक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2019048, "chapter_id": 1398, "verse_number": "३-३६-८", "content_sanskrit": "यत्तु केवलचापल्याद्बलदर्पोत्थितः स्वयम्।\nआरब्धव्यमिदं कार्यं मन्यसे शृणु तत्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2019049, "chapter_id": 1398, "verse_number": "३-३६-९", "content_sanskrit": "भूरिश्रवाः शलश्चैव जलसन्धश्च वीर्यवान्।\nभीष्मो द्रोणश्च कर्णशच् द्रोणपुत्रश्च वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2019050, "chapter_id": 1398, "verse_number": "३-३६-१०", "content_sanskrit": "धार्तराष्ट्रा दुराधर्षा दुर्योधनपुरोगमाः।\nसर्व एव कृताशस्त्राश्च सततं चाततायिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2019051, "chapter_id": 1398, "verse_number": "३-३६-११", "content_sanskrit": "राजानः पार्थिवाश्चैव येऽस्माभिरुपतापिताः।\nते श्रिताः कौरवं पक्षं जातस्नेहाश्च सांप्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2019052, "chapter_id": 1398, "verse_number": "३-३६-१२", "content_sanskrit": "दुर्योधनहिते युक्ता न तथाऽस्मासु भारत।\nपूर्णकोशा बलोपेताः प्रयतिष्यन्ति रक्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2019053, "chapter_id": 1398, "verse_number": "३-३६-१३", "content_sanskrit": "सर्वे कौरवसैन्यस् सपुत्रामात्यसैनिकाः।\nसंविभक्ता हि मात्राभिर्भोगैरपि च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2019054, "chapter_id": 1398, "verse_number": "३-३६-१४", "content_sanskrit": "दुर्योधनेन ते वीरा मानिताश्च विशेषतः।\nप्राणांस्त्यक्ष्यन्ति संग्रामे इति मे निश्चिता मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2019055, "chapter_id": 1398, "verse_number": "३-३६-१५", "content_sanskrit": "समा यद्यपि भीष्मस्य वृत्तिरस्मासु तेषु च।\nद्रोणस् च महाबाहो कृषस्य च महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2019056, "chapter_id": 1398, "verse_number": "३-३६-१६", "content_sanskrit": "अवश्यं राजपिण्डस्तैर्निर्वेश्य इति मे मतिः।\nतस्मात्त्यक्ष्यन्ति संग्रामे प्राणानपि सुदुस्त्यजान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2019057, "chapter_id": 1398, "verse_number": "३-३६-१७", "content_sanskrit": "सर्वेदिव्यास्त्रविद्वांसः सर्वे धर्मपरायणाः।\nअजेयाश्चेति मे बुद्धिरपि देवैः सवासवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2019058, "chapter_id": 1398, "verse_number": "३-३६-१८", "content_sanskrit": "अमर्षी नित्यसंरब्धस्तत्र कर्णो महारथः।\nसर्वास्त्रविदनाधृष्यो ह्यभेद्यकवचावृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2019059, "chapter_id": 1398, "verse_number": "३-३६-१९", "content_sanskrit": "अनिर्जित्यरणे सर्वानेतान्पुरुषसत्तमान्।\nअशक्यो ह्यसहायेन हन्तुं दुर्योधनस्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2019060, "chapter_id": 1398, "verse_number": "३-३६-२०", "content_sanskrit": "न निद्रामधिगच्छामि चिन्तयानो वृकोदर।\nअतिसर्वान्धनुर्ग्राहान्सूतपुत्रस्य लाघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2019061, "chapter_id": 1398, "verse_number": "३-३६-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2019062, "chapter_id": 1398, "verse_number": "३-३६-२१", "content_sanskrit": "एतद्वचनमाज्ञाय भीमसेनोऽत्यमर्षणः।\nबभूव शान्तिसंयुक्तो गुरोर्वचनवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2019063, "chapter_id": 1398, "verse_number": "३-३६-२२", "content_sanskrit": "तयोः संवदतोरेवं तदा पाण्डवयोर्द्वयोः।\nआजगाम महायोगी व्यासः सत्यवतीसुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2019064, "chapter_id": 1398, "verse_number": "३-३६-२३", "content_sanskrit": "सोऽभिगम्य यथान्यायं पाण्डवैः प्रतिपूजितः।\nयुधिष्ठिरमिदं वाक्यमुवाच वदतांवरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2019065, "chapter_id": 1398, "verse_number": "३-३६-२४", "content_sanskrit": "युधिष्ठिर महाबाहो वेद्मि ते हृदयस्थितम्।\nमनीषया तत क्षिप्रमागतोस्मि नरर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2019066, "chapter_id": 1398, "verse_number": "३-३६-२५", "content_sanskrit": "भीष्माद्द्रोणात्कृपात्कर्णाद्द्रोणपुत्राच्च भारत।\nदुर्योधनान्नृपसुतात्तथा दुःशासनादपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2019067, "chapter_id": 1398, "verse_number": "३-३६-२६", "content_sanskrit": "त्ते भयममित्रघ्न हृदि संपरिवर्तते।\nतत्तेऽहं नाशयिष्यामि विधिदृष्टेन हेतुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2019068, "chapter_id": 1398, "verse_number": "३-३६-२७", "content_sanskrit": "तच्छ्रुत्वा धृतिमास्थाय कर्मणा प्रतिपादय।\nप्रतिपाद्य तु राजेन्द्र ततः क्षिप्रं ज्वरं जहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2019069, "chapter_id": 1398, "verse_number": "३-३६-२८", "content_sanskrit": "तत एकान्तमानाय्य पाराशर्यो युधिष्ठिरम्।\nअब्रवीदुपपन्नार्थमिदं वाक्यविशारदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2019070, "chapter_id": 1398, "verse_number": "३-३६-२९", "content_sanskrit": "श्रेयसस्तेऽपरः कालः प्राप्तो भरतसत्तम।\nयेनाभिभविता शत्रून्रणे पार्थो धनुर्धरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2019071, "chapter_id": 1398, "verse_number": "३-३६-३०", "content_sanskrit": "गृहाणेमां मया प्रोक्तां सिद्धिं मूर्तिमर्तामिव।\nविद्यां प्रतिस्मृतिं नाम प्रपन्नाय ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2019072, "chapter_id": 1398, "verse_number": "३-३६-३१", "content_sanskrit": "यामवाप्यमहाबाहुरर्जुनः साधयिष्यति।\nअस्त्रहेतोर्महेन्द्रं च रुद्रं चैवाभिगच्छतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2019073, "chapter_id": 1398, "verse_number": "३-३६-३२", "content_sanskrit": "वरुणं च कुबेरं च धर्मराजं च पाण्डव।\nशक्तो ह्येष सुरान्द्रष्टुं तपसा विक्रमेण च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2019074, "chapter_id": 1398, "verse_number": "३-३६-३३", "content_sanskrit": "ऋषिरेष मेहातेजा नारायणसहायवान्।\nपुराणः शास्वतो देवस्त्वजेयो जिष्णुरच्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2019075, "chapter_id": 1398, "verse_number": "३-३६-३४", "content_sanskrit": "अस्त्राणीनद्राच्च रुद्राच्च लोकपालेभ्य एव च।\nसमादाय महाबाहुर्महत्कर्म करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2019076, "chapter_id": 1398, "verse_number": "३-३६-३५", "content_sanskrit": "वनादस्माच्च कौन्तेय वनमन्यद्विचिन्त्यताम्।\nनिवासार्थाय यद्युक्तं भवेद्वः पृथिवीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2019077, "chapter_id": 1398, "verse_number": "३-३६-३६", "content_sanskrit": "एकत्रचिरवासो हि न प्रीतिजननो भवेत्।\nतापसानां च शान्तानां भवेदुद्वेगकारकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2019078, "chapter_id": 1398, "verse_number": "३-३६-३७", "content_sanskrit": "मृगाणामुपरोधश्च वीरुदोषधिसंक्षयः।\nबिभर्षि च बहून्विप्रान्वेदवेदाङ्गपारगान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2019079, "chapter_id": 1398, "verse_number": "३-३६-३८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2019080, "chapter_id": 1398, "verse_number": "३-३६-३८", "content_sanskrit": "एवमुक्त्वा प्रपन्नाय शुचये भगवान्प्रभुः।\nप्रोवाच योगतत्त्वज्ञो योगविद्यामनुत्तमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2019081, "chapter_id": 1398, "verse_number": "३-३६-३९", "content_sanskrit": "धर्मराजाय धीमान्स व्यासः सत्यवतीसुतः।\nअनुज्ञाय च कौन्तेयं तत्रैवान्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2019082, "chapter_id": 1398, "verse_number": "३-३६-४०", "content_sanskrit": "युधिष्ठिरस्तु धर्मात्मा तद्ब्रह्म मनसा यतः।\nधारयामास मेधावी कालेकाले सदाऽभ्यसन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2019083, "chapter_id": 1398, "verse_number": "३-३६-४१", "content_sanskrit": "स व्यासवाक्यमुदितो वनाद्द्वैतवनात्ततः।\nययौ सरस्वतीकूले काम्यकं नाम काननम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2019084, "chapter_id": 1398, "verse_number": "३-३६-४२", "content_sanskrit": "तमन्वयुर्महाराज शिक्षाक्षरविशारदाः।\nब्राह्मणास्तपसा युक्ता देवेन्द्रमृषयो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2019085, "chapter_id": 1398, "verse_number": "३-३६-४३", "content_sanskrit": "ततः काम्यकमासाद्य पुनस्ते भरतर्षभ।\nन्यविशन्त महात्मानः सामान्याः सपदानुगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2019086, "chapter_id": 1398, "verse_number": "३-३६-४४", "content_sanskrit": "तत्रते न्यवसन्राजन्कंचित्कालं मनस्विनः।\nधनुर्वेदपरा वीरा गृणाना वेदमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2019087, "chapter_id": 1398, "verse_number": "३-३६-४५", "content_sanskrit": "चरन्तो मृगयां नित्यं शुद्धैर्बाणैर्मृगार्थिनः।\nपितृदैवतविप्रेभ्यो निर्वपन्तो यथाविधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2019088, "chapter_id": 1398, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि अर्जुनाभिगमनपर्वणि षट्त्रिंशोऽध्यायः ॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]