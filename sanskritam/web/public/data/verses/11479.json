[{"id": 50011793, "chapter_id": 11479, "verse_number": "1", "content_sanskrit": "राजोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50011794, "chapter_id": 11479, "verse_number": "2", "content_sanskrit": "निवृत्तिमार्गः कथित आदौ भगवता यथा। क्रमयोगोपलब्धेन ब्रह्मणा यदसंसृतिः॥ ६/१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50011795, "chapter_id": 11479, "verse_number": "3", "content_sanskrit": "प्रवृत्तिलक्षणश्चैव त्रैगुण्यविषयो मुने। योऽसावलीनप्रकृतेर्गुणसर्गः पुनःपुनः॥ ६/१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50011796, "chapter_id": 11479, "verse_number": "4", "content_sanskrit": "अधर्मलक्षणा नाना नरकाश्चोपवर्णिताः। मन्वन्तरश्च व्याख्यात आद्यः स्वायम्भुवो यतः॥ ६/१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50011797, "chapter_id": 11479, "verse_number": "5", "content_sanskrit": "प्रियव्रतोत्तानपदोर्वंशस्तच्चरितानि च। द्वीपवर्षसमुद्राद्रिनदीनदवनानि च॥ ६/१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50011798, "chapter_id": 11479, "verse_number": "6", "content_sanskrit": "धरामण्डलसंस्थानं भागलक्षणमानतः। ज्योतिषां विवराणां च यथेदमसृजद् विभुः॥ ६/१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50011799, "chapter_id": 11479, "verse_number": "7", "content_sanskrit": "अधुनेह महाभाग यथैव नरकान् नरः। नानोग्रयातनान् नेयात् तन्मे व्याख्यातुमर्हसि॥ ६/१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50011800, "chapter_id": 11479, "verse_number": "8", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50011801, "chapter_id": 11479, "verse_number": "9", "content_sanskrit": "न चेदिहैवापचितिं यथांहसः कृतस्य कुर्यान्मनौक्तिपाणिभिः। ध्रुवं स वै प्रेत्य नरकानुपैति ये कार्तिता मे भवतस्तिग्मयातनाः॥ ६/१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50011802, "chapter_id": 11479, "verse_number": "10", "content_sanskrit": "तस्मात् पुरैवाश्विह पापनिष्कृतौ यतेत मृत्योरविपद् यदात्मनः। दोषस्य दृष्ट्वा गुरुलाघवं यथा भिषक् चिकित्सेत रुजां निदानवित्॥ ६/१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50011803, "chapter_id": 11479, "verse_number": "11", "content_sanskrit": "राजोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50011804, "chapter_id": 11479, "verse_number": "12", "content_sanskrit": "दृष्टश्रुताभ्यां यत् पापं जानन्नप्यात्मनोऽहितम्। करोति भूयो विवशः प्रायश्चित्तमथो कथम्॥ ६/१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50011805, "chapter_id": 11479, "verse_number": "13", "content_sanskrit": "क्वचिन्निवर्ततेऽभद्रात् क्वचिच्चरति तत् पुनः। प्रायश्चित्तमथोऽपार्थं मन्ये कुञ्जरशौचवत्॥ ६/१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50011806, "chapter_id": 11479, "verse_number": "14", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50011807, "chapter_id": 11479, "verse_number": "15", "content_sanskrit": "कर्मणा कर्मनिर्हारो नेहात्यन्तिक इष्यते। अविद्वदधिकारित्वात् प्रायश्चित्तविमर्शनम्॥ ६/१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50011808, "chapter_id": 11479, "verse_number": "16", "content_sanskrit": "नाश्नतः पथ्यमेवान्नं व्याधयोऽभिभवन्ति हि। एवं नियमकृद् राजन् शनैः क्षेमाय कल्पते॥ ६/१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50011809, "chapter_id": 11479, "verse_number": "17", "content_sanskrit": "तपसा ब्रह्मचर्येण शमेन च दमेन च। त्यागेन सत्यशौचाभ्यां नियमेन यमेन च॥ ६/१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50011810, "chapter_id": 11479, "verse_number": "18", "content_sanskrit": "देहवाग्बुद्धिजं धीरा धर्मज्ञाः श्रद्धयाऽन्विताः। क्षपयन्त्यघं महदपि वेणुगुल्ममिवानलः॥ ६/१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50011811, "chapter_id": 11479, "verse_number": "19", "content_sanskrit": "केचित् केवलया भक्त्या वासुदेवपरायणाः। अघं धुन्वन्ति कात्स्र्न्येन नीहारमिव भास्करः॥ ६/१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50011812, "chapter_id": 11479, "verse_number": "20", "content_sanskrit": "न तथा ह्यघवान् राजन् पूयेत तपआदिभिः। यथा कृष्णार्पितप्राणस्तत्पूरुषनिषेवया॥ ६/१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50011813, "chapter_id": 11479, "verse_number": "21", "content_sanskrit": "सध्रीचीनो ह्ययं लोके पन्थाः क्षेमोऽकुतोभयः। सुशीलाः साधवो यत्र नारायणपरायणाः॥ ६/१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50011814, "chapter_id": 11479, "verse_number": "22", "content_sanskrit": "प्रायश्चित्तानि चीर्णानि नारायणपराङ्मुखैः। न वै पुनन्ति१ राजेन्द्र सुराकुम्भमिवापगाः॥ ६/१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50011815, "chapter_id": 11479, "verse_number": "23", "content_sanskrit": "सकृन्मनः कृष्णपदारविन्दयोर्निवेशितं तद्गुणरागि यैरिह। न ते यमं पाशभृतश्च तद्भटान् स्वप्नेऽपि पश्यन्ति हि चीर्णनिष्कृताः॥ ६/१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50011816, "chapter_id": 11479, "verse_number": "24", "content_sanskrit": "अत्रैवोदाहरन्तीममितिहासं पुरातनम्। दूतानां विष्णुयमयोः संवादं तं निबोध मे॥ ६/१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50011817, "chapter_id": 11479, "verse_number": "25", "content_sanskrit": "कान्यकुब्जे द्विजः कश्चिद् दासीपतिरजामिळः। नाम्ना नष्टसदाचारो दास्याः संसर्गदूषितः॥ ६/१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50011818, "chapter_id": 11479, "verse_number": "26", "content_sanskrit": "बन्द्यक्षैः कैतवैश्चौर्यैर्गर्हितां वृत्तिमाश्रितः। बिभ्रत् कुडुम्बमशुचिर्यातयामास देहिनम्॥ ६/१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50011819, "chapter_id": 11479, "verse_number": "27", "content_sanskrit": "एवं निवसतस्तस्य लाळयानस्य तत्सुतान्। कालोऽत्यगान्महान् राजन्नष्टाशीत्यायुषः समाः॥ ६/१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50011820, "chapter_id": 11479, "verse_number": "28", "content_sanskrit": "तस्य प्रवयसः पुत्रा दश तेषां तु योऽवमः। बालो नारायणो नाम्ना पित्रोश्च दयितो भृशम्॥ ६/१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50011821, "chapter_id": 11479, "verse_number": "29", "content_sanskrit": "स बद्धहृदयस्तस्मिन्नर्भके कळभाषिणि। निरीक्षमाणस्तल्लीलां मुमुदे जरठो भृशम्॥ ६/१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50011822, "chapter_id": 11479, "verse_number": "30", "content_sanskrit": "भुञ्जानः प्रपिबन् खादन् बालकस्नेहयन्त्रितः। भोजयन् पाययन् मूढो न वेदागतमन्तकम्॥ ६/१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50011823, "chapter_id": 11479, "verse_number": "31", "content_sanskrit": "स एवं वर्तमानोऽज्ञो मृत्युकाल उपस्थिते। मतिं चकार तनये बाले नारायणाह्वये॥ ६/१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50011824, "chapter_id": 11479, "verse_number": "32", "content_sanskrit": "स पाशहस्तांस्त्रीन् दृष्ट्वा पुरुषान् भृशदारुणान्। वक्रतुण्डानूर्ध्वरोम्ण आत्मानं नेतुमागतान्॥ ६/१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50011825, "chapter_id": 11479, "verse_number": "33", "content_sanskrit": "दूरे क्राडनकासक्तं पुत्रं नारायणाह्वयम्। प्लावितेन स्वरेणोच्चैराजुहावाकुलेन्द्रियः॥ ६/१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50011826, "chapter_id": 11479, "verse_number": "34", "content_sanskrit": "निशम्य म्रियमाणस्य मुखतो हरिकार्तनम्। भर्तुर्नाम महाराज पार्षदाः सहसाऽपतन्॥ ६/१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50011827, "chapter_id": 11479, "verse_number": "35", "content_sanskrit": "विकर्षतोऽन्तर्हृदयाद् दासीपतिमजामिळम्। यमप्रेष्यान् विष्णुदूता वारयामासुरोजसा॥ ६/१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50011828, "chapter_id": 11479, "verse_number": "36", "content_sanskrit": "ऊचुर्निषेधितास्तांस्ते वैवस्वतपुरस्सराः। के यूयं प्रतिषेद्धारो धर्मराजस्य शासनम्॥ ६/१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50011829, "chapter_id": 11479, "verse_number": "37", "content_sanskrit": "कस्य वा कुत आयाताः कस्मादस्य निषेधथ। किं देवा उपदेवा वा यूयं किं सिद्धसत्तमाः॥ ६/१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50011830, "chapter_id": 11479, "verse_number": "38", "content_sanskrit": "सर्वे पदम्पलाशाक्षाः पीतकौशेयवाससः। किरीटिनः कुण्डलिनो लसत्पुष्करमालिनः॥ ६/१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50011831, "chapter_id": 11479, "verse_number": "39", "content_sanskrit": "सर्वे च नूत्नावयसः सर्वे चारुचतुर्भुजाः। धनुर्निषङ्गासिगदाशङ्खचक्राम्बुजश्रियः॥ ६/१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50011832, "chapter_id": 11479, "verse_number": "40", "content_sanskrit": "दिशो वितिमिरालोकाः कुर्वन्तः स्वेन रोचिषा। किमर्थं धर्मराजस्य किङ्करान् नो निषेधथ॥ ६/१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50011833, "chapter_id": 11479, "verse_number": "41", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50011834, "chapter_id": 11479, "verse_number": "42", "content_sanskrit": "इत्युक्ते यमदूतैस्ते वासुदेवोक्तकारिणः। तान् प्रत्यूचुः प्रहस्येदं मेघगम्भीरया गिरा॥ ६/१/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50011835, "chapter_id": 11479, "verse_number": "43", "content_sanskrit": "विष्णुदूता ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50011836, "chapter_id": 11479, "verse_number": "44", "content_sanskrit": "यूयं वै धर्मराजस्य यदि निर्देशकारिणः। ब्रूत धर्मस्य नस्तत्वं यच्चाधर्मस्य लक्षणम्॥ ६/१/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50011837, "chapter_id": 11479, "verse_number": "45", "content_sanskrit": "कथंस्विद् ध्रियते दण्डः किं वाऽस्य स्थानमीप्सितम्। दण्ड्याः किं कारिणः सर्वे आहोस्वित् कतिचिन्नृणाम्॥ ६/१/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50011838, "chapter_id": 11479, "verse_number": "46", "content_sanskrit": "यमदूता ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50011839, "chapter_id": 11479, "verse_number": "47", "content_sanskrit": "वेदप्रणिहितो धर्मो ह्यधर्मस्तद्विपर्ययः। वेदो नारायणः साक्षात् स्वयम्भूरिति शुश्रुमः॥ ६/१/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50011840, "chapter_id": 11479, "verse_number": "48", "content_sanskrit": "येन स्वधाम्न्यमी भावा रजस्सत्वतमोमयाः। गुणनामक्रियारूपैर्विभाव्यन्ते यथातथम्॥ ६/१/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50011841, "chapter_id": 11479, "verse_number": "49", "content_sanskrit": "सूर्योऽग्निः खं मरुद् गावः सोमः सन्ध्याहनी दिशः। कालः स्वयं धर्म इति ह्येते धर्मस्य साक्षिणः॥ ६/१/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50011842, "chapter_id": 11479, "verse_number": "50", "content_sanskrit": "एतैरधर्मो विज्ञातः स्थानं दण्डस्य युज्यते। सर्वे क्रमानुरोधेन दण्डमर्हन्ति कारिणः॥ ६/१/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50011843, "chapter_id": 11479, "verse_number": "51", "content_sanskrit": "सम्भवन्ति ह्यभद्राणि विपरीतानि चानघाः। कारणं गुणसङ्गोऽस्ति देहवान् न ह्यकर्मकृत्॥ ६/१/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50011844, "chapter_id": 11479, "verse_number": "52", "content_sanskrit": "येन यावान् यथा धर्मो ह्यधर्मो वा समीहितः। स एव तत्फलं भुङ्क्ते तथा तावदमुत्र वै॥ ६/१/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 50011845, "chapter_id": 11479, "verse_number": "53", "content_sanskrit": "यथेह देवप्रवरास्त्रैविध्यमुपलभ्यते। भूतेषु गुणवैचित्र्यात् तथाऽन्यत्रानुमीयते॥ ६/१/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 50011846, "chapter_id": 11479, "verse_number": "54", "content_sanskrit": "वर्तमानोऽन्ययोः कालो गुणाभिज्ञापको यथा। एवं जन्मान्ययोरेतद्धर्माधर्मनिदर्शनम्॥ ६/१/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 50011847, "chapter_id": 11479, "verse_number": "55", "content_sanskrit": "मनसैव पुरे देवः पूर्वं रूपं विपश्यति। अनुमीमांसतेऽपूर्वं मनसा भगवानजः॥ ६/१/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 50011848, "chapter_id": 11479, "verse_number": "56", "content_sanskrit": "यथाऽज्ञस्तमसा युक्त उपास्ते व्यक्तमेव हि। न वेद पूर्वमपरं नष्टजन्मस्मृतिस्तथा॥ ६/१/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 50011849, "chapter_id": 11479, "verse_number": "57", "content_sanskrit": "पञ्चभिः कुरुते स्वार्थान् पञ्च वेदाथ पञ्चभिः। एकस्तु षोडशेन त्रीन् स्वयं सप्तदशोऽश्नुते॥ ६/१/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 50011850, "chapter_id": 11479, "verse_number": "58", "content_sanskrit": "तदेतत् षोडशकलं लिङ्गं शक्तित्रयं महत्। धत्तेऽनु संसृतिं पुंसि हर्षशोकभयार्तिदाम्॥ ६/१/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 50011851, "chapter_id": 11479, "verse_number": "59", "content_sanskrit": "देह्यज्ञोऽजितषड्वर्गोऽनिच्छन् कर्माणि कार्यते। कोशकार इवात्मानं कर्मणाऽऽच्छाद्य मुह्यति॥ ६/१/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 50011852, "chapter_id": 11479, "verse_number": "60", "content_sanskrit": "न हि कश्चित् क्षणमपि जातु तिष्ठत्यकर्मकृत्। कार्यते ह्यवशः कर्म सर्वः प्रकृतिजैर्गुणैः॥ ६/१/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 50011853, "chapter_id": 11479, "verse_number": "61", "content_sanskrit": "लब्ध्वा निमित्तमव्यक्तं व्यक्ताव्यक्तं भवत्युत। यथायोनि यथाबीजं स्वभावेन बलीयसा॥ ६/१/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 50011854, "chapter_id": 11479, "verse_number": "62", "content_sanskrit": "एष प्रकृतिसङ्गेन पुरुषस्य विपर्ययः। आसीत् स एव नचिरादीशसङ्गाद् विलीयते॥ ६/१/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 50011855, "chapter_id": 11479, "verse_number": "63", "content_sanskrit": "अयं च श्रुतसम्पन्नः शीलवृत्तगुणालयः। धृतव्रतो मृदुर्दान्तः सत्यवाक् मन्त्रविच्छुचिः॥ ६/१/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 50011856, "chapter_id": 11479, "verse_number": "64", "content_sanskrit": "गुर्वग्न्यतिथिवृद्धानां शुश्रूषुर्निरहङ्कृतिः। सर्वभूतसुहृत् साधुर्मितवागनसूयकः॥ ६/१/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 50011857, "chapter_id": 11479, "verse_number": "65", "content_sanskrit": "एकदाऽसौ वनं यातः पितृसन्देशकृद् द्विजः। आदाय तत आवृत्तः फलमूलसमित्कुशान्॥ ६/१/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 50011858, "chapter_id": 11479, "verse_number": "66", "content_sanskrit": "ददर्श कामिनं कञ्चिच्छूद्रं सह भुजिष्यया। पीत्वा तु मधु मैरेयं मदाघूर्णितनेत्रया॥ ६/१/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 50011859, "chapter_id": 11479, "verse_number": "67", "content_sanskrit": "मत्तया विश्लथन्नीव्या ह्युपेतं निरपत्रपम्। क्राडन्तमनुगायन्तं हसन्तमनयाऽन्तिके॥ ६/१/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 50011860, "chapter_id": 11479, "verse_number": "68", "content_sanskrit": "दृष्ट्वा तां कामलिप्तेन बाहुना परिरम्भिताम्। जगाम हृच्छयवशं सहसैव विमोहितः॥ ६/१/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 50011861, "chapter_id": 11479, "verse_number": "69", "content_sanskrit": "स्तम्भयन्नात्मनाऽऽत्मानं यावत्सत्त्वं यथाश्रुतम्। न शशाक समाधातुं मनो मदनवेपितम्॥ ६/१/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 50011862, "chapter_id": 11479, "verse_number": "70", "content_sanskrit": "तन्निमित्तस्मरव्याजग्रहग्रस्तो विचेतनः। तामेव मनसा ध्यायन् स्वधर्माद् विरराम ह॥ ६/१/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 50011863, "chapter_id": 11479, "verse_number": "71", "content_sanskrit": "तामेव तोषयामास पित्र्येणार्थेन यावता। ग्राम्यैर्मनोरमैः कामैः प्रसीदेत यथा यथा॥ ६/१/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 50011864, "chapter_id": 11479, "verse_number": "72", "content_sanskrit": "विप्रां स्वभार्यामप्रौढां कुले महति लम्भिताम्। विससर्जाचिरात् पापः स्वैरिण्यापाङ्गविद्धधीः॥ ६/१/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 50011865, "chapter_id": 11479, "verse_number": "73", "content_sanskrit": "इतस्ततश्चोपनिन्ये न्यायतोऽन्यायतो धनम्। बभारास्याः कुडुम्बिन्याः कुडुम्बं मन्दधीरयम्॥ ६/१/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 50011866, "chapter_id": 11479, "verse_number": "74", "content_sanskrit": "यदसौ शास्त्रमुल्लङ्घ्य स्वैरचार्यार्यगर्हितः। अवर्तत चिरं कालमघायुरशुचिर्मलात्॥ ६/१/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 50011867, "chapter_id": 11479, "verse_number": "75", "content_sanskrit": "तत एनं दण्डपाणेः सकाशं कृतकिल्बिषम्। नेष्यामोऽकृतनिर्वेशं यत्र दण्डेन शुद्ध्यति॥ ६/१/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 50011868, "chapter_id": 11479, "verse_number": "76", "content_sanskrit": "इति श्रीमद्भागवते षष्ठस्कन्धे प्रथमोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]