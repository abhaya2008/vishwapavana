[{"id": 2212975, "chapter_id": 5542, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212976, "chapter_id": 5542, "verse_number": "१", "content_sanskrit": "एवमुक्तस्तु राज्ञा स विदुरो बुद्धिसत्तमः ।\nधृतराष्ट्रमुपेत्यैवं वाक्यमाह यथार्थवत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212977, "chapter_id": 5542, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212978, "chapter_id": 5542, "verse_number": "२", "content_sanskrit": "उक्तो युधिष्ठिरो राजा भवद्वचनमादितः ।\nस च संश्रुत्य वाक्यं ते प्रशशंस महीपतिः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212979, "chapter_id": 5542, "verse_number": "३", "content_sanskrit": "बीभत्सुश्च महातेजा निवेदयति ते गृहान् ।\nवसु तच्च गृहे यच्च प्राणानपि च केवलान्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212980, "chapter_id": 5542, "verse_number": "४", "content_sanskrit": "धर्मराजस्तु पुत्रस्ते राज्यं प्राणान् धनानि च ।\nअनुजानाति राजर्षे यच्चान्यदपि किञ्चन\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2212981, "chapter_id": 5542, "verse_number": "५", "content_sanskrit": "भीमस्तु सर्वदुःखानि संस्मृत्य बहुलान्युत ।\nकृच्छ्रादिव महाबाहुरनुजज्ञे विनिःश्वसन्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2212982, "chapter_id": 5542, "verse_number": "६", "content_sanskrit": "स राज्ञा धर्मशीलेन भ्रात्रा बीभत्सुना तथा ।\nअनुनीतो महाबाहुः सौहृदे स्थापितोऽपि च\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2212983, "chapter_id": 5542, "verse_number": "७", "content_sanskrit": "न च मन्युस्त्वया कार्य इति त्वां प्राह धर्मराट् ।\nसंस्मृत्य भीमस्तद्वैरं यदन्यायवदाचरेत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2212984, "chapter_id": 5542, "verse_number": "८", "content_sanskrit": "एवम्प्रायो हि धर्मोऽयं क्षत्रियाणां नराधिप ।\nशुद्धेन क्षत्रधर्मेण निरतोऽयं वृकोदरः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2212985, "chapter_id": 5542, "verse_number": "९", "content_sanskrit": "वृकोदरकृते चाहमर्जुनश्च पुनः पुनः ।\nप्रसादयाव नृपते भवान् प्रभुरिहास्ति यः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2212986, "chapter_id": 5542, "verse_number": "१०", "content_sanskrit": "प्रददातु भवान् वित्तं यावदिच्छति पार्थिव ।\nत्वमीश्वरो नो राज्यस्य प्राणानां चैव भारत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2212987, "chapter_id": 5542, "verse_number": "११", "content_sanskrit": "ब्रह्मदेयाग्रहारांश्च पुत्राणां चौर्ध्वदेहिके ।\nइतो रत्नानि गाश्चैव दासीदासमजाविकम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2212988, "chapter_id": 5542, "verse_number": "१२", "content_sanskrit": "अर्चयित्वा कुरुश्रेष्ठो ब्राह्मणेभ्यः प्रयच्छतु ।\nदीनान्धकृपणेभ्यश्च तत्र तत्र नृपाज्ञया\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2212989, "chapter_id": 5542, "verse_number": "१३", "content_sanskrit": "बह्वन्नरसपानाढ्यं सर्वं विदुर कारय ।\nगवां निपानान्यन्यच्च विविधं पुण्यकर्म यत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2212990, "chapter_id": 5542, "verse_number": "समाप्तिः", "content_sanskrit": "इति मामब्रवीद् राजा पार्थश्चैव धनञ्जयः ।\nयदत्रानन्तरं कार्यं तद् भवान् वक्तुमर्हति\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2212991, "chapter_id": 5542, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2212992, "chapter_id": 5542, "verse_number": "१५", "content_sanskrit": "इत्युक्तो विदुरेणाथ धृतराष्ट्रोऽभिनन्द्य तम् ।\nमनश्चक्रे महादाने कार्तिक्यां जनमेजय\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2212993, "chapter_id": 5542, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्रमवासिकपर्वणि विदुरवाक्यं नाम अष्टादशोऽध्यायः ॥१८॥\nआश्रमवासपर्वणि अष्टादशोऽध्यायः ॥१८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]