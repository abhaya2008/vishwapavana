[{"id": 2061237, "chapter_id": 2309, "verse_number": "८-३०-०x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2061238, "chapter_id": 2309, "verse_number": "८-३०-१", "content_sanskrit": "अयं ते कर्ण सारथ्यं मद्रराजः करिष्यति।\nकृष्णादभ्यधिको यन्ता देवेशस्येव मातलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2061239, "chapter_id": 2309, "verse_number": "८-३०-२", "content_sanskrit": "यथा हरिहयैर्युक्तं सङ्गृह्णाति स मातलिः।\nशल्यस्तथा तवाद्यायं संयन्ता रथवाजिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2061240, "chapter_id": 2309, "verse_number": "८-३०-३", "content_sanskrit": "योधे त्वयि रथस्थे च मद्रराजे च सारथौ।\nरथश्रेष्ठो ध्रुवं सङ्ख्ये पार्थानभिभविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2061241, "chapter_id": 2309, "verse_number": "८-३०-४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2061242, "chapter_id": 2309, "verse_number": "८-३०-४", "content_sanskrit": "ततो दुर्योधनो भूयो मद्रराजं तरस्विनम्।\nउवाच राजन्सङ्ग्रामेऽध्युषिते पर्युपस्थिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2061243, "chapter_id": 2309, "verse_number": "८-३०-५", "content_sanskrit": "कर्णस्य यच्छ सङ्ग्रामे मद्रराज हयोत्तमान्।\nत्वयाऽभिगुप्तो राधेयो विजेष्यति धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2061244, "chapter_id": 2309, "verse_number": "८-३०-६", "content_sanskrit": "इत्युक्तो रथमास्थाय तथेति प्राह भारत।\nशल्येऽभ्युपगते कर्णः सारथिं सुमनाऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2061245, "chapter_id": 2309, "verse_number": "८-३०-७", "content_sanskrit": "त्वं सूत स्यन्दनं मह्यं कल्पयेत्यसकृत्त्वरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2061246, "chapter_id": 2309, "verse_number": "८-३०-८", "content_sanskrit": "ततो जैत्रं रथवरं गन्धर्वनगरोपमम्।\nविधिवत्कल्पितं भद्रं जयेत्युक्त्वा न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2061247, "chapter_id": 2309, "verse_number": "८-३०-९", "content_sanskrit": "तं रथं रथिनां श्रेष्ठः कर्णोऽभ्यर्च्य यथाविधि।\nसम्पादितं ब्रह्मविदा पूर्वमेव पुरोधसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2061248, "chapter_id": 2309, "verse_number": "८-३०-१०", "content_sanskrit": "कृत्वा प्रदक्षिणं यत्नादुपस्थाय च भास्करम्।\nसमीपस्थं मद्रराजमारोह त्वमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2061249, "chapter_id": 2309, "verse_number": "८-३०-११", "content_sanskrit": "ततः कर्णस्य दुर्धर्षं स्यन्दनप्रवरं महत्।\nआरुरोह महातेजाः शल्यः सिंह इवाचलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2061250, "chapter_id": 2309, "verse_number": "८-३०-१२", "content_sanskrit": "ततः शल्याश्रितं दृष्ट्वा कर्णः स्वं रथमुत्तमम्।\nअध्यतिष्ठद्यथाऽम्भोदं विद्युत्वन्तं दिवाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2061251, "chapter_id": 2309, "verse_number": "८-३०-१३", "content_sanskrit": "तावेकरथमारूढावादित्याग्निसमत्विषौ।\nअभ्राजेतां यथा मेघं सूर्याग्नी सहितौ दिवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2061252, "chapter_id": 2309, "verse_number": "८-३०-१४", "content_sanskrit": "संस्तूयमानौ तौ वीरौ तदास्तां द्युतिमत्तमौ।\nऋत्विक्सदस्यैरिन्द्राग्नी स्तूयमानाविवाध्यरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2061253, "chapter_id": 2309, "verse_number": "८-३०-१५", "content_sanskrit": "स शल्यसङ्गृहीताश्वे रथे कर्णः स्थितो बभौ।\nधनुर्विष्फारयन्घोरं परिवेषीव भास्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2061254, "chapter_id": 2309, "verse_number": "८-३०-१६", "content_sanskrit": "आस्थितः स रथश्रेष्ठं कर्णः शरगभस्तिमान्।\nप्रबभौ पुरुषव्याघ्रो मन्दरस्थ इवांशुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2061255, "chapter_id": 2309, "verse_number": "८-३०-१७", "content_sanskrit": "तं रथस्थं महाबाहुं युद्वायामिततेजसम्।\nदुर्योधनस्तु राधेयमिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2061256, "chapter_id": 2309, "verse_number": "८-३०-१८", "content_sanskrit": "अकृतं द्रोणभीष्माभ्यां दुष्करं कर्म संयुगे।\nकुरुष्वाधिरथे वीर मिषतां सर्वधन्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2061257, "chapter_id": 2309, "verse_number": "८-३०-१९", "content_sanskrit": "मनोगतं मम ह्यासीद्भीष्मद्रोणौ महारथौ।\nअर्जुनं भीमसेनं च निहन्ताराविति ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2061258, "chapter_id": 2309, "verse_number": "८-३०-२०", "content_sanskrit": "ताभ्यां यदकृतं वीर वीरकर्म महामृधे।\nतत्कर्म कुरु राधेय वज्रपाणिरिवापरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2061259, "chapter_id": 2309, "verse_number": "८-३०-२१", "content_sanskrit": "गृहाण धर्मराजं वा जहि वा त्वं धनञ्जयम्।\nभीमसेनं च राधेय माद्रीपुत्रौ यमावपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2061260, "chapter_id": 2309, "verse_number": "८-३०-२२", "content_sanskrit": "जयश्च तेऽस्तु भद्रं ते प्रयाहि पुरुषर्षभ।\nपाण्डुपुत्रस्य सैन्यानि कुरु सर्वाणि भस्मसात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2061261, "chapter_id": 2309, "verse_number": "८-३०-२३", "content_sanskrit": "ततस्तूर्यसहस्राणि भेरीणामयुतानि च।\nवाद्यमानान्यरोचन्त मेघशब्दो यथा दिवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2061262, "chapter_id": 2309, "verse_number": "८-३०-२४", "content_sanskrit": "प्रतिगृह्य तु तद्वाक्यं रथस्थो रथरुत्तमः।\nअभ्यभाषत राधेयः शल्यं युद्धविशारदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2061263, "chapter_id": 2309, "verse_number": "८-३०-२५", "content_sanskrit": "चोदयाश्वान्महाबाहो यावद्वन्मि धनञ्जयम्।\nभीमसेनं यमौ चोभौ राजानं च युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2061264, "chapter_id": 2309, "verse_number": "८-३०-२६", "content_sanskrit": "अद्य पश्यतु मे शल्य बाहुवीर्यं धनञ्जयः।\nअस्यतः कङ्कपत्राणां सहस्राणि शतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2061265, "chapter_id": 2309, "verse_number": "८-३०-२७", "content_sanskrit": "अद्य क्षेप्स्याम्यहं शल्य शरान्परमतेजनान्।\nपाण्डवानां विनाशाय दुर्योधनजयाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2061266, "chapter_id": 2309, "verse_number": "८-३०-२८x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2061267, "chapter_id": 2309, "verse_number": "८-३०-२८", "content_sanskrit": "एतच्छ्रुत्वा वचस्तस्य शल्यः कर्णं वचोऽब्रवीत्।\nकथं नु तान्महावीर्यान्पाण्डवानवमन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2061268, "chapter_id": 2309, "verse_number": "८-३०-२९", "content_sanskrit": "सर्वास्त्रज्ञान्महेष्वासान्सर्वानेन महाबलान्।\nअनिवर्तिनो महाभागानजय्यान्सत्यविक्रमान्।\nअपि सञ्जनयेयुर्ये भयं साक्षाच्छतक्रतोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2061269, "chapter_id": 2309, "verse_number": "८-३०-३०", "content_sanskrit": "यदा श्रोष्यसि निर्घोषं विस्फूर्जितमिवाशनेः।\nराधेय पार्थधनुषस्तदा नैवं वदिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2061270, "chapter_id": 2309, "verse_number": "८-३०-३१", "content_sanskrit": "यदा द्रक्ष्यसि भीमेन कुञ्जरानीकमाहवे।\nविशीर्णदन्तं निहतं तदा नैवं वदिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2061271, "chapter_id": 2309, "verse_number": "८-३०-३२", "content_sanskrit": "यदा द्रक्ष्यसि सङ्ग्रामे धर्मपुत्रं यमौ तथा।\nशितैः पृषत्कैः कुर्वाणानभ्रच्छायामिवाम्बरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2061272, "chapter_id": 2309, "verse_number": "८-३०-३३", "content_sanskrit": "अस्यतः क्षिण्वतश्चारीँल्लघुहस्तान्दुरासदान्।\nपार्थिवागपि चान्यांस्त्वं तदा नैवं वदिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2061273, "chapter_id": 2309, "verse_number": "८-३०-३४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2061274, "chapter_id": 2309, "verse_number": "८-३०-३४", "content_sanskrit": "अनादृत्य तु तद्वाक्यं मद्रराजे भाषितम्।\nद्रक्ष्यस्यद्येत्यवोचत्तं शल्यं कर्णो जनेश्वर॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2061275, "chapter_id": 2309, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि त्रिंशोऽध्यायः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]