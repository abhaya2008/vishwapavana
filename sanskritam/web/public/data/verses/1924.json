[{"id": 2041614, "chapter_id": 1924, "verse_number": "५-१६९-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2041615, "chapter_id": 1924, "verse_number": "५-१६९-१", "content_sanskrit": "एते रथास्तवाख्यातास्तथैवातिरथा नृप।\nये चाप्यर्धरथा राजन्पाण्डवानामतः श्रृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2041616, "chapter_id": 1924, "verse_number": "५-१६९-२", "content_sanskrit": "यदि कौतूहलं तेऽद्य पाण्डवानां बले नृप ।\nरथसंख्यां शृणुष्व त्वं सहैभिर्वसुधाधिपैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2041617, "chapter_id": 1924, "verse_number": "५-१६९-३", "content_sanskrit": "स्वयं राजा रथोदारः पाण्डवः कुन्तनन्दनः ।\nअग्निवत्समरे तात चरिष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2041618, "chapter_id": 1924, "verse_number": "५-१६९-४", "content_sanskrit": "भीमसेनस्तु राजेन्द्र रथोऽष्टगुणसंमितः ।\nन तस्यास्ति समो युद्धे गदया सायकैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2041619, "chapter_id": 1924, "verse_number": "५-१६९-५", "content_sanskrit": "नागायुतबलो मानी तेजसा न स मानुषः ।\nमाद्रीपुत्रो च रथिनौ द्वावेव पुरुषर्षभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2041620, "chapter_id": 1924, "verse_number": "५-१६९-६", "content_sanskrit": "अश्विनाविव रूपेण तेजसा च समन्वितौ।\nएते चमूमुखगताः स्मरन्तः क्लेशमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2041621, "chapter_id": 1924, "verse_number": "५-१६९-७", "content_sanskrit": "रुद्रवत्प्रचरिष्यन्ति तत्र मे नास्ति संशयः ।\nसर्व एव महात्मानः सालस्तम्भा इवोद्गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2041622, "chapter_id": 1924, "verse_number": "५-१६९-८", "content_sanskrit": "प्रादेशेनाधिकाः पुंभिरन्यैस्ते च प्रमाणतः।\nसिंहसंहननाः सर्वे पाण्डुपुत्रा महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2041623, "chapter_id": 1924, "verse_number": "५-१६९-९", "content_sanskrit": "चरितब्रह्मचर्याश्च सर्वे तात तपस्विनः।\nह्रीमन्तः पुरुषव्याघ्रा व्याघ्रा इव बलोत्कटाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2041624, "chapter_id": 1924, "verse_number": "५-१६९-१०", "content_sanskrit": "जवे प्रहारे संमर्दे सर्व एवातिमानुषाः ।\nसर्वैर्जिता महीपाला दिग्जये भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2041625, "chapter_id": 1924, "verse_number": "५-१६९-११", "content_sanskrit": "न चैषां पुरुषाः केचिदायुधानि गदाः शरान्।\nविषहन्ति सदा कर्तुमधिज्यान्यपि कौरव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2041626, "chapter_id": 1924, "verse_number": "५-१६९-१२", "content_sanskrit": "उद्यन्तुं वा गदा गुर्वीः शरान्वा क्षेप्तुमाहवे ।\nजवे लक्ष्यस्य हरणे भोज्ये पांसुविकर्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2041627, "chapter_id": 1924, "verse_number": "५-१६९-१३", "content_sanskrit": "बालैरपि भवन्तस्तैः सर्व एव विशेषिताः।\nएतत्सैन्यं समासाद्य सर्व एव बलोत्कटाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2041628, "chapter_id": 1924, "verse_number": "५-१६९-१४", "content_sanskrit": "विध्वंसयिष्यन्ति रणे मा स्म तैः सह संगमः ।\nएकैकशस्त संमर्दे हन्युः सर्वान्महीक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2041629, "chapter_id": 1924, "verse_number": "५-१६९-१५", "content_sanskrit": "प्रत्यक्षं तव राजेन्द्र राजसूये यथाभवत् ।\nद्रौपद्याश्च परिक्लेशं द्यूते च परुषा गिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2041630, "chapter_id": 1924, "verse_number": "५-१६९-१६", "content_sanskrit": "ते स्मरन्तश्च सङ्ग्रामे चरिष्यन्ति च रुद्रवत् ।\nलोहिताक्षो गुडाकेशो नारायणसहायवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2041631, "chapter_id": 1924, "verse_number": "५-१६९-१७", "content_sanskrit": "उभोयोः सेनयोर्वीरो रथो नास्तीति तादृशः ।\nन हि देवेषु वा पूर्वं मनुष्येषूरगेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2041632, "chapter_id": 1924, "verse_number": "५-१६९-१८", "content_sanskrit": "राक्षसेष्वथ यक्षेषु नरेषु कुत एव तु ।\nभूतोथ वा भविष्यो वा रथः कश्चिन्मया श्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2041633, "chapter_id": 1924, "verse_number": "५-१६९-१९", "content_sanskrit": "समायुक्तो महाराज रथः पार्थस्य धीमतः।\nवासुदेवश्च संयन्ता योद्धा चैव धनञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2041634, "chapter_id": 1924, "verse_number": "५-१६९-२०", "content_sanskrit": "गाण्डीवं च धनुर्दिव्यं ते चाश्वा वातरंहसः ।\nअभेद्यं कवचं दिव्यमक्षय्यौ च महेषुधी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2041635, "chapter_id": 1924, "verse_number": "५-१६९-२१", "content_sanskrit": "अस्त्रग्रामश्च माहेन्द्रो रौद्रः कौबेर एवच ।\nयाम्यश्च वारुणश्चैव गदाश्चोग्रप्रदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2041636, "chapter_id": 1924, "verse_number": "५-१६९-२२", "content_sanskrit": "वज्रादीनि च मुख्यानि नानाप्रहरणानि च ।\nदानवानां सहस्राणि हिरण्यपुरवासिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2041637, "chapter_id": 1924, "verse_number": "५-१६९-२३", "content_sanskrit": "हतान्येकरथेनाजौ कस्तस्य सदृशो रथः।\nएष हन्याद्धि संरम्भी बलवान्सत्यविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2041638, "chapter_id": 1924, "verse_number": "५-१६९-२४", "content_sanskrit": "तव सेनां महाबाहुः स्वां चैव परिपालयन्।\nअहं चैनं प्रत्युदियामाचार्यो वा धनञ्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2041639, "chapter_id": 1924, "verse_number": "५-१६९-२५", "content_sanskrit": "न तृतीयोऽस्ति राजेन्द्र सेनयोरुभयोरपि ।\nय एनं शरवर्षाणि वर्षन्तमुदियाद्रथी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2041640, "chapter_id": 1924, "verse_number": "५-१६९-२६", "content_sanskrit": "जीमूत इव घर्मान्ते महावातसमीरितः ।\nसमायुक्तस्तु कौन्तेयो वासुदेवसहायवान् ।\nतरुणश्च कृती चैव जीर्णावावामुभावपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2041641, "chapter_id": 1924, "verse_number": "५-१६९-२७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2041642, "chapter_id": 1924, "verse_number": "५-१६९-२७", "content_sanskrit": "एतच्छ्रुत्वा तु भीष्मस्य राज्ञां दध्वंसिरे तदा।\nकाञ्चनाङ्गदिनः पीना भुजाश्चन्दनरूषिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2041643, "chapter_id": 1924, "verse_number": "५-१६९-२८", "content_sanskrit": "मनोभिः सह संवेगैः संस्मृत्य च पुरातनम् ।\nसामर्थ्यं पाण्डवेयानां यथा प्रत्यक्षदर्शनात् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2041644, "chapter_id": 1924, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि रथातिरथसंख्यानपर्वणि एकोनसप्तत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]