[{"id": 2013634, "chapter_id": 1281, "verse_number": "२-२२-१", "content_sanskrit": "जरासन्ध उवाच।\nन स्मरामि कदा वैरं कृतं युष्माभिरित्युत।\nचिन्तयंश्च न पश्यामि भवतां प्रति वैकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2013635, "chapter_id": 1281, "verse_number": "२-२२-२", "content_sanskrit": "वैकृते वा सति कथं मन्यध्वं मामनागसम्।\nअरिं वै ब्रूत हे विप्राः सतां समय एष हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2013636, "chapter_id": 1281, "verse_number": "२-२२-३", "content_sanskrit": "अर्थधर्मोपघाताद्धि मनः समुपतप्यते।\nयोऽनागसि प्रसजति क्षत्रियो हि न संशयटः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2013637, "chapter_id": 1281, "verse_number": "२-२२-४", "content_sanskrit": "अतोऽन्यथा चरँल्लोके धर्मज्ञः सन्महारथः।\nवृजिनां गतिमाप्नोति श्रेयसोऽप्युपहन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2013638, "chapter_id": 1281, "verse_number": "२-२२-५", "content_sanskrit": "त्रैलोक्ये क्षत्रधर्मो हि श्रेयान्वै साधुचारिणाम्।\nनान्यं धर्मं प्रशंसन्ति ये च धर्मविदो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2013639, "chapter_id": 1281, "verse_number": "२-२२-६", "content_sanskrit": "तस्य मेऽद्य स्थितस्येह स्वधर्मे नियतात्मनः।\nअनागसं प्रजानां च प्रमादादिव जल्पथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2013640, "chapter_id": 1281, "verse_number": "२-२२-७x", "content_sanskrit": "कृष्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2013641, "chapter_id": 1281, "verse_number": "२-२२-७", "content_sanskrit": "कुलकार्यं महाबाहो कश्चिदेकः कुलोद्वहः।\nवहते यस्तन्नियोगाद्वयमभ्युद्यतास्त्वयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2013642, "chapter_id": 1281, "verse_number": "२-२२-८", "content_sanskrit": "त्वया चोपहृता राजन्क्षत्रिया लोकवासिनः।\nतदागः क्रूरमुत्पाद्य मन्यसे किमनागसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2013643, "chapter_id": 1281, "verse_number": "२-२२-९", "content_sanskrit": "राजा राज्ञः कथं साधून्हिंस्यान्नृपतिसत्तम।\nतद्राज्ञः सन्निगृह्य त्वं रुद्रायोपजिहीर्षसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2013644, "chapter_id": 1281, "verse_number": "२-२२-१०", "content_sanskrit": "अस्मांस्तदेनोपगच्छेत्कृतं बार्हद्रथ त्वया।\nवयं हिं शक्ता धर्मस्य रक्षणे धर्मचारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2013645, "chapter_id": 1281, "verse_number": "२-२२-११", "content_sanskrit": "तस्मादद्योपगच्छामस्तव बार्हद्रथान्तिकम्।\nमनुष्याणां समालम्भो न च दृष्टः कदाचन।\nस कथं मानुषैर्देवं यष्टुमिच्छसि शङ्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2013646, "chapter_id": 1281, "verse_number": "२-२२-१२", "content_sanskrit": "सवर्णो हि सवर्णानां पशुसञ्ज्ञां करिष्यसि।\nकोऽन्यं एवं यथा हि त्वं जरासन्ध वृथामतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2013647, "chapter_id": 1281, "verse_number": "२-२२-१३", "content_sanskrit": "यस्यां यस्यामवस्थायां यद्यत्कर्म करोति यः।\nतस्यां तस्यामवस्थायां तत्फलं समवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2013648, "chapter_id": 1281, "verse_number": "२-२२-१४", "content_sanskrit": "ते त्वां ज्ञातिक्षयकरं यममार्तानुसारिणः।\nज्ञातिवृद्धिनिमित्तार्थं विनिहन्तुमिहागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2013649, "chapter_id": 1281, "verse_number": "२-२२-१५", "content_sanskrit": "नास्ति लोके पुमानन्यः क्षत्रियोष्विति चैव तत्।\nमन्यसे स च ते राजन्सुमहान्बुद्धिविप्लवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2013650, "chapter_id": 1281, "verse_number": "२-२२-१६", "content_sanskrit": "को हि जानन्नभिजनमात्मवान्क्षत्रियो नृप।\nनाविशेत्स्वर्गमतुलं रणानन्तरमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2013651, "chapter_id": 1281, "verse_number": "२-२२-१७", "content_sanskrit": "स्वर्गं ह्येव समास्थाय रणयज्ञेषु दीक्षिताः।\nजयन्ति क्षत्रिया लोकांस्तद्विद्धि मनुजर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2013652, "chapter_id": 1281, "verse_number": "२-२२-१८", "content_sanskrit": "स्वर्गयोनिर्महद्ब्रह्म स्वर्गयोनिर्महद्यशः।\nस्वर्गं योनिस्तपो युद्धे मृत्युः सोऽव्यभिचारवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2013653, "chapter_id": 1281, "verse_number": "२-२२-१९", "content_sanskrit": "एष ह्यैन्द्रो वैजयन्तो गुणैर्नित्यं समाहितः।\nयेनासुरान्पराजित्य जगत्पाति शतक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2013654, "chapter_id": 1281, "verse_number": "२-२२-२०", "content_sanskrit": "स्वर्गमार्गाय कस्य स्याद्विग्रहो वै यथा तव।\nमागधैर्विपुलैः सैन्यैर्बाहुल्यबलदर्पितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2013655, "chapter_id": 1281, "verse_number": "२-२२-२१", "content_sanskrit": "माऽवमंस्थाः परान्राजन्नास्ति वीर्यं नरे नरे।\nसमं चेजस्त्वया चैव विशिष्टं वा नरेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2013656, "chapter_id": 1281, "verse_number": "२-२२-२२", "content_sanskrit": "यावदेतदसम्बुद्धं तावदेव भवेत्तव।\nविषह्यमेतदस्माकमतो राजन्ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2013657, "chapter_id": 1281, "verse_number": "२-२२-२३", "content_sanskrit": "जहि त्वं सदृशेष्वेव मानं दर्पं च मागध।\nमा गमः ससुतामात्यः सबलश्च यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2013658, "chapter_id": 1281, "verse_number": "२-२२-२४", "content_sanskrit": "दम्भोद्भवः कार्तवीर्य उत्तरश्च बृहद्रथः।\nश्रेयसो ह्यवमत्येह विनेशुः सबला नृपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2013659, "chapter_id": 1281, "verse_number": "२-२२-२५", "content_sanskrit": "युयुक्षमाणास्त्वत्तो हि न वयं ब्राह्मणा ध्रुवम्।\nशौरिरस्मि हृषीकेशो नृवीरौ पाण्डवाविमौ।\nअनयोर्मातुलेयं च कृष्णं मां विद्धि ते रिपुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2013660, "chapter_id": 1281, "verse_number": "२-२२-२६", "content_sanskrit": "त्वामाह्वयामहे राजन्स्थिरो युध्वस्व मागध।\nमुच्छ वा नृपतीन्सर्वान् गच्छ वा त्वं यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2013661, "chapter_id": 1281, "verse_number": "२-२२-२७x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2013662, "chapter_id": 1281, "verse_number": "२-२२-२७", "content_sanskrit": "एतच्छ्रुत्वा जरासन्धः क्रुद्धो वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2013663, "chapter_id": 1281, "verse_number": "२-२२-२८", "content_sanskrit": "नाहं कंसः प्रलम्बो वा न बाणो न च मुष्टिकः।\nनरको नेन्द्रतपनो न केशी न च पूतना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2013664, "chapter_id": 1281, "verse_number": "२-२२-२९", "content_sanskrit": "न कालयवनो वाऽपि ये त्वया निहता युधि।\nत्वं तु गोपकुलोत्पन्नो जातिं वै पौर्विकीं स्मर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2013665, "chapter_id": 1281, "verse_number": "२-२२-३०", "content_sanskrit": "योऽस्मद्भयादतिक्रम्य सागरानूपमाश्रितः।\nजन्मभूमिं परित्यज्य मधुरां प्राकृतो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2013666, "chapter_id": 1281, "verse_number": "२-२२-३१", "content_sanskrit": "सोऽधुना कत्थसे शौरे शरदीव यथा घनः।\nअद्यानृण्यं करिष्यामि भोजराजस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2013667, "chapter_id": 1281, "verse_number": "२-२२-३२", "content_sanskrit": "जामातुरौग्रसेनस्य त्वां निहत्याद्य माधव।\nचिरकाङ्क्षितो मे सङ्ग्रामस्त्वां हन्तुं समुहृद्गुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2013668, "chapter_id": 1281, "verse_number": "२-२२-३३", "content_sanskrit": "दिष्ट्या मे सफलो यत्नः कृतो देवैः सवासवैः।\nक्लीबाविमौ च गोविन्द भीमसेनार्जुनावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2013669, "chapter_id": 1281, "verse_number": "२-२२-३४", "content_sanskrit": "हिंस्यासि युधि विक्रम्य सिंहः क्षुद्रमृगाविव।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2013670, "chapter_id": 1281, "verse_number": "२-२२-३४x", "content_sanskrit": "वैशम्पायन उवाच॥\nतस्य रोषाभिभूतस्य जरासन्धस्य गर्जतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2013671, "chapter_id": 1281, "verse_number": "२-२२-३५", "content_sanskrit": "सर्वभूतानि वित्रेमुषे तत्रासन्समागताः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2013672, "chapter_id": 1281, "verse_number": "२-२२-३५x", "content_sanskrit": "श्रीभगवानुवाच॥\nकिं गर्जसि जरासन्ध कर्मणा तत्समाचर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2013673, "chapter_id": 1281, "verse_number": "२-२२-३६", "content_sanskrit": "मम निर्देशकर्तृभ्यां पाण्डवाभ्यां नृपाधम।\nसमात्यं ससुतं चाद्य घातयिष्याम्यहं रणे।\nन कथञ्चन जीवन्वै प्रवेक्ष्यसि पुरोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2013674, "chapter_id": 1281, "verse_number": "२-२२-३७x", "content_sanskrit": "जरासन्ध उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2013675, "chapter_id": 1281, "verse_number": "२-२२-३७", "content_sanskrit": "नाजितान्वै नरपतीनहमादद्मि काश्चन।\nअजितः पर्यवस्थाता कोऽत्र यो न मया जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2013676, "chapter_id": 1281, "verse_number": "२-२२-३८", "content_sanskrit": "क्षत्रियस्यैतदेवाहुर्धर्म्यं कृष्णोपजीवनम्।\nविक्रम्य वशमानीय कामतो यत्समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2013677, "chapter_id": 1281, "verse_number": "२-२२-३९", "content_sanskrit": "देवातार्थमुपाहृत्य राज्ञः कृष्ण कथं भयात्।\nअहमद्य विमुच्येयं क्षात्रं व्रतमनुस्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2013678, "chapter_id": 1281, "verse_number": "२-२२-४०", "content_sanskrit": "सैन्यं सैन्येन व्यूढेन एक एकेन वा पुनः।\nद्वाभ्यां त्रिभिर्वा योत्स्येऽहं युगत्पृथगेव वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2013679, "chapter_id": 1281, "verse_number": "२-२२-४१x", "content_sanskrit": "वैशम्पाय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2013680, "chapter_id": 1281, "verse_number": "२-२२-४१", "content_sanskrit": "एवमुक्त्वा जरासन्धः सहदेवाभिषेचनम्।\nअज्ञापयत्तदा राजा ययुत्सुर्भीमकर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2013681, "chapter_id": 1281, "verse_number": "२-२२-४२", "content_sanskrit": "स तु सेनापतिं राजा सस्मार भरतर्षभ।\nकौशिकं चित्रसेनं च तस्मिन्युद्ध उपस्थिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2013682, "chapter_id": 1281, "verse_number": "२-२२-४३", "content_sanskrit": "ययोस्ते नामनी राजन्हंसेति डिबिकेति च।\nपूर्वं सङ्कथिते पुम्भिर्नृलोके लोकसत्कृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2013683, "chapter_id": 1281, "verse_number": "२-२२-४४", "content_sanskrit": "तं तु राजन्विभुः शौरी राजानं बलिनां वरम्।\nस्मृत्वा पुरुषशार्दूलः शार्दूलसमविक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2013684, "chapter_id": 1281, "verse_number": "२-२२-४५", "content_sanskrit": "सत्यसन्धो जरासन्धं भुवि भीमपराक्रमम्।\nभागमन्यस्य निर्दिष्टमवध्यं मधुर्भिर्मृधेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2013685, "chapter_id": 1281, "verse_number": "२-२२-४६", "content_sanskrit": "नात्मनाऽऽत्मवतां मुख्य इयेष मधुसूदनः।\nब्राह्मीमाज्ञां पुरस्कृत्य हन्तुं हलधरानुजः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2013686, "chapter_id": 1281, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि जरासन्धवधपर्वणि द्वाविंशोऽध्यायः॥ २॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]