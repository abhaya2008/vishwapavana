[{"id": 2007541, "chapter_id": 1146, "verse_number": "१-१४७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2007542, "chapter_id": 1146, "verse_number": "१-१४७-१", "content_sanskrit": "ततः स्रस्तोत्तरपटः सप्रस्वेदः सवेपथुः।\nविवेशाधिरथो रङ्गं यष्टिप्राणो ह्वयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2007543, "chapter_id": 1146, "verse_number": "१-१४७-२", "content_sanskrit": "तमालोक्य धनुस्त्यक्त्वा पितृगौरवयन्त्रितः।\nकर्णोऽभिषेकार्द्रशिराः शिरसा समवन्दत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2007544, "chapter_id": 1146, "verse_number": "१-१४७-३", "content_sanskrit": "ततः पादाववच्छाद्य पटान्तेन ससंभ्रमः।\nपुत्रेति परिपूर्णार्थमब्रवीद्रथसारथिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2007545, "chapter_id": 1146, "verse_number": "१-१४७-४", "content_sanskrit": "परिष्वज्य च तस्याथ मूर्धानं स्नेहविक्लवः।\nअङ्गराज्याभिषेकार्द्रमश्रुभिः सिषिचे पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2007546, "chapter_id": 1146, "verse_number": "१-१४७-५", "content_sanskrit": "तं दृष्ट्वा सूतपुत्रोऽयमिति संचिन्त्य पाण्डवः।\nभीमसेनस्तदा वाक्यमब्रवीत्प्रहसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2007547, "chapter_id": 1146, "verse_number": "१-१४७-६", "content_sanskrit": "न त्वमर्हसि पार्थेन सूतपुत्र रणे वधम्।\nकुलस्य सदृशस्तूर्णं प्रतोदो गृह्यतां त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2007548, "chapter_id": 1146, "verse_number": "१-१४७-७", "content_sanskrit": "अङ्गराज्यं च नार्हस्त्वमुपभोक्तुं नराधम।\nश्वा हुताशसमीपस्थं पुरोडाशमिवाध्वरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2007549, "chapter_id": 1146, "verse_number": "१-१४७-८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2007550, "chapter_id": 1146, "verse_number": "१-१४७-८", "content_sanskrit": "एवमुक्तस्ततः कर्णः किंचित्प्रस्फुरिताधरः।\nगगनस्थं विनिःश्वस्य दिवाकरमुदैक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2007551, "chapter_id": 1146, "verse_number": "१-१४७-९", "content_sanskrit": "ततो दुर्योधनः कोपादुत्पपात महाबलः।\nभ्रातृपद्मवनात्तस्मान्मदोत्कट इव द्विपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2007552, "chapter_id": 1146, "verse_number": "१-१४७-१०", "content_sanskrit": "सोऽब्रवीद्भीमकर्माणं भीमसेनमवस्थितम्।\nवृकोदर न युक्तं ते वचनं वक्तुमीदृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2007553, "chapter_id": 1146, "verse_number": "१-१४७-११", "content_sanskrit": "क्षत्रियाणां बलं ज्यष्ठं योक्तव्यं क्षत्रबन्धुना।\nशूराणां च नदीनां च प्रभवो दुर्विभावनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2007554, "chapter_id": 1146, "verse_number": "१-१४७-१२", "content_sanskrit": "सलिलादुत्थितो वह्निर्येन व्याप्तं चराचरम्।\nदधीचस्यास्थितो वज्रं कृतं दानवसूदनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2007555, "chapter_id": 1146, "verse_number": "१-१४७-१३", "content_sanskrit": "आग्नेयः कृत्तिकापुत्रो रौद्रो गाङ्गेय इत्यपि।\nश्रूयते भगवान्देवः सर्वगुह्यमयो गुहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2007556, "chapter_id": 1146, "verse_number": "१-१४७-१४", "content_sanskrit": "क्षत्रियेभ्यश्च ये जाता ब्राह्मणास्ते च ते श्रुताः।\nविश्वामित्रप्रभृतयः प्राप्ता ब्रह्मत्वमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2007557, "chapter_id": 1146, "verse_number": "१-१४७-१५", "content_sanskrit": "आचार्यः कलशाज्जातो द्रोणः शस्त्रभृतां वरः।\nगौतमस्यान्ववाये च शरस्तम्बाच्च गौतमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2007558, "chapter_id": 1146, "verse_number": "१-१४७-१६", "content_sanskrit": "भवतां च यथा जन्म तदप्यागमितं मया।\nसकुण्डलं सकवचं सर्वलक्षणलक्षितम्।\nकथमादित्यसदृशं मृगी व्याघ्रं जनिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2007559, "chapter_id": 1146, "verse_number": "१-१४७-१७", "content_sanskrit": "पृथिवीराज्यमर्होऽयं नाङ्गराज्यं नरेश्वरः।\nअनेन बाहुवीर्येण मया चाज्ञानुवर्तिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2007560, "chapter_id": 1146, "verse_number": "१-१४७-१८", "content_sanskrit": "यस्य वा मनुजस्येदं न क्षान्तं मद्विचेष्टितम्।\nरथमारुह्य पद्भ्यां स विनामयतु कार्मुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2007561, "chapter_id": 1146, "verse_number": "१-१४७-१९", "content_sanskrit": "ततः सर्वस्य रङ्गस्य हाहाकारो महानभूत्।\nसाधुवादानुसंबद्धः सूर्यश्चास्तमुपागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2007562, "chapter_id": 1146, "verse_number": "१-१४७-२०", "content_sanskrit": "ततो दुर्योधनः कर्णमालम्ब्याग्रकरे नृपः।\nदीपिकाभिः कृतालोकस्तस्माद्रङ्गाद्विनिर्ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2007563, "chapter_id": 1146, "verse_number": "१-१४७-२१", "content_sanskrit": "पाण्डवाश्च सहद्रोणाः सकृपाश्च विशांपते।\nभीष्मेण सहिताः सर्वे ययुः स्वं स्वं निवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2007564, "chapter_id": 1146, "verse_number": "१-१४७-२२", "content_sanskrit": "अर्जुनेति जनः कश्चित्कश्चित्कर्णेति भारत।\nकश्चिद्दुर्योधनेत्येवं ब्रुवन्तः प्रस्थितास्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2007565, "chapter_id": 1146, "verse_number": "१-१४७-२३", "content_sanskrit": "कुन्त्याश्च प्रत्यभिज्ञाय दिव्यलक्षणसूचितम्।\nपुत्रमङ्गेश्वरं स्नेहाच्छन्ना प्रीतिरजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2007566, "chapter_id": 1146, "verse_number": "१-१४७-२४", "content_sanskrit": "दुर्योधनस्यापि तदा कर्णमासाद्य पार्थिव।\nभयमर्जुनसंजातं क्षिप्रमन्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2007567, "chapter_id": 1146, "verse_number": "१-१४७-२५", "content_sanskrit": "स चापि वीरः कृतशस्त्रनिश्रमः\nपरेण साम्नाऽभ्यवदत्सुयोधनम्।\nयुधिष्ठिरस्याप्यभवत्तदा मति-\nर्न कर्णतुल्योऽस्ति धनुर्धरः क्षितौ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2007568, "chapter_id": 1146, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिप्रवणि संभवपर्वणि सप्तचत्वारिंशदधिकशततमोऽध्यायः॥ १४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]