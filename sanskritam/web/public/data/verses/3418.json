[{"id": 2112042, "chapter_id": 3418, "verse_number": "", "content_sanskrit": "शन्तनुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2112043, "chapter_id": 3418, "verse_number": "१", "content_sanskrit": "आपवो नाम कोन्वेष किमृषेस्तस्य दूषितम् ।\nशशाप यस्मात् कल्याणि स वसूंश्चारुदर्शने \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2112044, "chapter_id": 3418, "verse_number": "२", "content_sanskrit": "यस्याभिशापात् ते सर्वे मानुषीं योनिमागताः ।\nअनेन च विशेषेण गङ्गादत्तेन किं कृतम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2112045, "chapter_id": 3418, "verse_number": "३", "content_sanskrit": "कस्य चैव कृतेनायं मानुषेषु वसिष्यति ।\nईशानाः सर्वलोकानां वसवः केन हेतुना ।\nमानुषेषूदपद्यन्त तत् समाचक्ष्व जाह्रवि\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2112046, "chapter_id": 3418, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2112047, "chapter_id": 3418, "verse_number": "४", "content_sanskrit": "एवमुक्ता वरारोहा राजानमिदमब्रवीत् ।\nभर्तारं जाह्नवी देवी शन्तनुं भरतर्षभ \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2112048, "chapter_id": 3418, "verse_number": "५", "content_sanskrit": "लेभे यं यमुना पुत्रं वरुणाद् राजसत्तम ।\nवसिष्ठनामा स मुनिः ख्यात आपव इत्युत \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2112049, "chapter_id": 3418, "verse_number": "६", "content_sanskrit": "तस्याश्रमपदं पुण्यं मृगपक्षिगणान्वितम् ।\nमेरोः पार्श्वे नगेन्द्रस्य सर्वर्तुकवनान्वितम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2112050, "chapter_id": 3418, "verse_number": "७", "content_sanskrit": "स वारुणिस्तपस्तेपे तस्मिन् भरतसत्तम ।\nवने पुण्यकृतां श्रेष्ठः स्वादुमूलफलोदके \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2112051, "chapter_id": 3418, "verse_number": "८", "content_sanskrit": "दक्षस्य दुहिता या तु सुरभीत्यभिविश्रुता ।\nगां प्रजाता तु सा देवी काश्यपाद् भरतर्षभ\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2112052, "chapter_id": 3418, "verse_number": "९", "content_sanskrit": "अनुग्रहार्थं जगतः सर्वकामदुहां वराम् ।\nलेभे तां गां तु धर्मात्मा होमधेनुं स वारुणिः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2112053, "chapter_id": 3418, "verse_number": "१०", "content_sanskrit": "सा तस्मिंस्तापसाऽरण्ये वसन्ती मुनिसेविते ।\nचचार रम्ये धर्म्ये च गौरपेतभया तदा \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2112054, "chapter_id": 3418, "verse_number": "११", "content_sanskrit": "ततस्तद्वनमाजग्मुः कदाचिद् भरतर्षभ ।\nधराद्याः वसवः सर्वे देवा देवर्षिसेवितम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2112055, "chapter_id": 3418, "verse_number": "१२", "content_sanskrit": "सभार्यास्तद्वनं सर्वं विचरन्तस्ततस्ततः ।\nरेमिरे रमणीयेषु पर्वतेषु वनेषु च \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2112056, "chapter_id": 3418, "verse_number": "१३", "content_sanskrit": "एकस्य भार्या राजेन्द्र वसोर्वासवविक्रम ।\nतां च दोग्ध्रीं वने तस्मिन् गां ददर्श सुशोभनाम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2112057, "chapter_id": 3418, "verse_number": "१४", "content_sanskrit": "या सा वसिष्ठस्य मुनेः सर्वकामधुगुत्तमा ।\nअथ सा विस्मिता देवी रूपद्रविणसम्पदा \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2112058, "chapter_id": 3418, "verse_number": "१५", "content_sanskrit": "दर्शयामास सा पत्युः तां गां गोवृषविक्रम ।\nस्वाधीनां च सुदोग्ध्रीं च सुवालधिमुखोदराम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2112059, "chapter_id": 3418, "verse_number": "१६", "content_sanskrit": "उपपन्नां गुणैः सर्वैः शीलेनानुत्तमेन च ।\nएवंगुणसमायुक्तां वसवे वसुनन्दिनी \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2112060, "chapter_id": 3418, "verse_number": "१७", "content_sanskrit": "दर्शयामास कल्याणीं पुरा पौरवनन्दन ।\nद्यौस्तदा तां तु द्दष्ट्वैव गां गजेन्द्रेन्द्रविक्रम\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2112061, "chapter_id": 3418, "verse_number": "१८", "content_sanskrit": "उवाच राजंस्तां देवीं तस्या रूपगुणान् वदन् ।\nएषा गौरुत्तमा देवी वारुणेरसितेक्षणा \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2112062, "chapter_id": 3418, "verse_number": "१९", "content_sanskrit": "ऋषेस्तस्य वरारोहे यस्येदं वनमुत्तमम् ।\nअस्याः क्षीरं पिबेन्मर्त्यः स्वादु यो वै सुमध्यमे ।\nदशवर्षसहस्राणि स जीवेत् स्थिरयौवनः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2112063, "chapter_id": 3418, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2112064, "chapter_id": 3418, "verse_number": "२०", "content_sanskrit": "एतच्छ्रुत्वा तु सा देवी नृपोत्तम सुमध्यमा ।\nतमुवाचानवद्याङ्गी भर्तारं दीप्ततेजसम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2112065, "chapter_id": 3418, "verse_number": "", "content_sanskrit": "गङ्गा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2112066, "chapter_id": 3418, "verse_number": "२१", "content_sanskrit": "अस्ति मे मानुषी लोके नरदेवात्मजा सखी ।\nनाम्ना जितवती नाम रूपयौवनशालिनी \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2112067, "chapter_id": 3418, "verse_number": "२२", "content_sanskrit": "उशीनरस्य राजर्षेः सत्यसन्धस्य धीमतः ।\nदुहिता विश्रुता लोके मानुषे रूपसम्पदा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2112068, "chapter_id": 3418, "verse_number": "२३", "content_sanskrit": "तस्या हेतोर्महाभाग सवत्सां गां ममेप्सिताम् ।\nआनयस्व सुरश्रेष्ठ त्वरितं पुण्यवर्धिनीम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2112069, "chapter_id": 3418, "verse_number": "२४", "content_sanskrit": "यावदस्याः पयः पीत्वा सा सखी मम मानदा ।\nमानुषेषु भवत्वेका जरारोगविवर्जिता \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2112070, "chapter_id": 3418, "verse_number": "२५", "content_sanskrit": "एतन्मम महाभाग कर्तुमर्हसि कर्म वै ।\nप्रियात् प्रियतरं ह्मस्मान्नास्ति मेऽन्यत् कथञ्चन \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2112071, "chapter_id": 3418, "verse_number": "२६", "content_sanskrit": "एदच्छ्रुत्वा वचस्तस्या देव्याः प्रियचिकीर्पया ।\nधराद्यैर्भ्रातृभिः सार्धं द्यौस्तदा तां जहार गाम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2112072, "chapter_id": 3418, "verse_number": "२७", "content_sanskrit": "तया कमलपत्राक्ष्या नियुक्तो द्यौस्तदा नृप ।\nऋषेस्तस्य तपस्तीव्रं न शशाक परीक्षितुम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2112073, "chapter_id": 3418, "verse_number": "२८", "content_sanskrit": "हृता गौः सा तदा तेन प्रयाता नतु शक्तितः ।\nअथाश्रमपदं प्राप्तः फलान्यादाय वारुणिः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2112074, "chapter_id": 3418, "verse_number": "२९", "content_sanskrit": "नापश्यद् गां सवत्सां तां सा हि तस्मिन् वनोत्तमे ।\nस तस्मिन् मृगयामास वने तामृषिसत्तमः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2112075, "chapter_id": 3418, "verse_number": "३०", "content_sanskrit": "नाभ्यपश्यंश्च मृगयन् तां गां ऋषिरुदारधीः ।\nज्ञात्वा तथाऽपनीतां तां वसुभिर्दिव्यचक्षुषा \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2112076, "chapter_id": 3418, "verse_number": "३१", "content_sanskrit": "स तु कोपवशं प्राप्तः शशाप च वसूंस्तदा ।\nयस्मान्मे वसवो जह्रुर्गां वै दोग्ध्रीं सुवालघिम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2112077, "chapter_id": 3418, "verse_number": "३२", "content_sanskrit": "तस्मात् सर्वे जनिष्यन्ति वसवो मानुषेष्विति ।\nएवं शशाप भगवान् वसूंस्तान् मुनिसत्तमः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2112078, "chapter_id": 3418, "verse_number": "३३", "content_sanskrit": "वशं क्रोधस्य सम्प्राप्त आपवो भरतर्षभ ।\nशप्त्वा च तान् महाभागस्तपस्येव मनो दधे \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2112079, "chapter_id": 3418, "verse_number": "३४", "content_sanskrit": "एवं स शप्तवान् राजन् वसूनष्टौ तपोधनः ।\nमहाप्रभावो ब्रह्मर्षिर्देवान् रोषसमन्वितः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2112080, "chapter_id": 3418, "verse_number": "३५", "content_sanskrit": "एवं शप्तास्ततस्तेन मुनिना यामुनेन वै ।\nअष्टौ समस्ता वसवो निजदोषेण भारत\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2112081, "chapter_id": 3418, "verse_number": "३६", "content_sanskrit": "अथाश्रमपदं प्राप्य पुनस्तस्य महात्मनः ।\nशप्ताः स्म हति जानन्तः पुनस्तमभिचक्रमुः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2112082, "chapter_id": 3418, "verse_number": "३७", "content_sanskrit": "प्रसादयन्तस्तमृषिं वसवः पार्थिवर्षभ ।\nन लेभिरे च ते तस्मात् प्रसादमृषिसत्तमात्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2112083, "chapter_id": 3418, "verse_number": "३८", "content_sanskrit": "आपवः पुरुषव्याघ्र सर्वधर्मविशारदः ।\nउवाच च स धर्मात्मा मुनिः शप्तधरादिकान् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2112084, "chapter_id": 3418, "verse_number": "३९", "content_sanskrit": "अनुसंवत्सराच्छापान्मोक्ष्यध्वमिति भारत ।\nअयं तु यत्कृते शप्ता मया यूयं स वत्स्यति \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2112085, "chapter_id": 3418, "verse_number": "४०", "content_sanskrit": "द्यौस्तु वै मानुषे लोके दीर्घकालं स्वकर्मणा ।\nनानृतं तच्चिकीर्षामि युष्मान् क्रुद्धो यदब्रुवम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2112086, "chapter_id": 3418, "verse_number": "४१", "content_sanskrit": "प्रजा ह्यनृतवाक्येन हिंसन् मैनस्तथाप्नुयात् ।\nन प्रजास्यति चाप्येष मानुषेषु महामनाः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2112087, "chapter_id": 3418, "verse_number": "४२", "content_sanskrit": "भविष्यति च धर्मात्मा सर्वशास्त्रार्थविद् बली ।\nपितुश्चायं प्रियं कुर्वन् स्त्रीभोगान् वर्जयिष्यति \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2112088, "chapter_id": 3418, "verse_number": "४३", "content_sanskrit": "एवमुक्त्वा वसून् सर्वान् जगाम भगवानृषिः ।\nततो मामुपजग्मुस्ते समस्ता वसवो नृप \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2112089, "chapter_id": 3418, "verse_number": "४४", "content_sanskrit": "अयाचन्त च मां राजन् वरं तेम्यो ददाम्यहम् ।\nजातं जातं क्षिपेत्यूचुः स्वयं गङ्गे त्वदम्भसि \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2112090, "chapter_id": 3418, "verse_number": "४५", "content_sanskrit": "एवं तेषां वरं सम्यक् शप्तानां राजसत्तम ।\nमोक्षार्थं मानुषाल्लोकाद् यथावत् कृतवत्यहम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2112091, "chapter_id": 3418, "verse_number": "४६", "content_sanskrit": "अयं शापादृषेस्तस्य एक एव नृपोत्तम ।\nद्यौ राजन् मानुषे लोके चिरं वत्स्यति भारत \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2112092, "chapter_id": 3418, "verse_number": "४७", "content_sanskrit": "अयं देवव्रतश्चैव गङ्गादत्तश्च मे सुतः ।\nद्विनामा शन्तनोः पुत्रः शन्तनोरधिको गुणैः \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2112093, "chapter_id": 3418, "verse_number": "४८", "content_sanskrit": "अयं कुमारः पुत्रस्ते विवृद्धः पुनरेष्यति ।\nअयं च ते गमिष्यामि आह्वानोपगता नृप \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2112094, "chapter_id": 3418, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2112095, "chapter_id": 3418, "verse_number": "४९", "content_sanskrit": "एतदाख्याय सा देवी तत्रैवान्तरधीयत ।\nआदाय च कुमारं तं जगाम च यथेप्सितम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2112096, "chapter_id": 3418, "verse_number": "५०", "content_sanskrit": "तस्माद् देवव्रतश्चैव गङ्गादत्तश्च सोऽभवत् ।\nशन्तनुश्चापि शोकार्तो जगाम स्वपुरं ततः \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2112097, "chapter_id": 3418, "verse_number": "५१", "content_sanskrit": "तस्य कीर्तिं च वृत्तिं च महतो नृप सद्रुणान् ।\nशन्तनोः कीर्तयिष्यामि सर्वानेव गुणानहम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2112098, "chapter_id": 3418, "verse_number": "५२", "content_sanskrit": "महाभाग्यस्य नृपतेर्भारतस्य यशस्विनः ।\nतस्येतिहासः ख्यातोऽयं महाभारत इत्युत \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2112099, "chapter_id": 3418, "verse_number": "९७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nसप्तनवतितमोऽध्यायः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2112100, "chapter_id": 3418, "verse_number": "४५", "content_sanskrit": "॥ इति सम्भवपर्वणि पञ्चचत्वारिंशोऽध्यायः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2112101, "chapter_id": 3418, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]