[{"id": 7001002000, "chapter_id": 21002, "verse_number": "४-८-१", "content_sanskrit": "श्रीपराशर उवाच ।\nपुरूरवसो ज्येष्ठः पुत्रो यस्त्वायुर्नामा स राहोर्दुहितरमुपयेमे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001002001, "chapter_id": 21002, "verse_number": "४-८-२", "content_sanskrit": "तस्यां च पंच पुत्रानुत्पादयामास ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001002002, "chapter_id": 21002, "verse_number": "४-८-३", "content_sanskrit": "नहुषक्षत्रवृद्धरंभरजिसंज्ञास्तथैवानेनाः पंचमः पुत्रोऽभूत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001002003, "chapter_id": 21002, "verse_number": "४-८-४", "content_sanskrit": "क्षत्रवृद्धात्सुहोत्रः पुत्रोऽभवत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001002004, "chapter_id": 21002, "verse_number": "४-८-५", "content_sanskrit": "काश्यपकाशगृत्समदास्त्रयस्तस्य पुत्रा बभूवुः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001002005, "chapter_id": 21002, "verse_number": "४-८-६", "content_sanskrit": "गृत्समदस्य शौनकश्चातुर्वर्ण्यप्रवर्त्तयिताऽभूत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001002006, "chapter_id": 21002, "verse_number": "४-८-७", "content_sanskrit": "काश्यस्य काश्योः काशीराजः तस्माद्राष्ट्रः राष्ट्रस्य दीर्घतपाः पुत्रोऽभवत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001002007, "chapter_id": 21002, "verse_number": "४-८-८", "content_sanskrit": "धन्वंतरिस्तु दीर्घतपसः पुत्रोऽभवत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001002008, "chapter_id": 21002, "verse_number": "४-८-९", "content_sanskrit": "स हि संसिद्धकार्यकरणस्सकलसंभूतिष्वशेषो ज्ञानविदा भगवता नारायणेन चातीत संभूतौ तस्मै वरो दत्तः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001002009, "chapter_id": 21002, "verse_number": "४-८-१०", "content_sanskrit": "काशीराजगोत्रेऽवतीर्य त्वमष्टधा सम्यगायुर्वेदं करिष्यसि यज्ञभागभुग्भविष्यसीति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001002010, "chapter_id": 21002, "verse_number": "४-८-११", "content_sanskrit": "तस्य च धन्वंतरेः पुत्रः केतुमान् केतुमतो भीमरथः तस्यापि दिवोदासः तस्यापि प्रतर्दनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001002011, "chapter_id": 21002, "verse_number": "४-८-१२", "content_sanskrit": "स च भद्रश्रेण्यवंशविनाशनादशेषशत्रवोनेन जिता इति शत्रुजिदभवत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001002012, "chapter_id": 21002, "verse_number": "४-८-१३", "content_sanskrit": "तेन च प्रीतिमतात्मपुत्रो वत्सवत्सेत्यभिहितो वत्सोऽभवत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001002013, "chapter_id": 21002, "verse_number": "४-८-१४", "content_sanskrit": "सत्यपरतया ऋतध्वजसंज्ञामवाप ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001002014, "chapter_id": 21002, "verse_number": "४-८-१५", "content_sanskrit": "ततश्च कुवलयनामानमश्वं लेभे ततः कुवलयाश्व इत्यस्यां पृथिव्यां प्रथितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001002015, "chapter_id": 21002, "verse_number": "४-८-१६", "content_sanskrit": "तस्य च वत्सस्य पुत्रोऽलर्कनामाभवत् यस्यायमद्यापि श्लोको गीयते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001002016, "chapter_id": 21002, "verse_number": "४-८-१७", "content_sanskrit": "षष्टिवर्षसहस्राणि षष्टिवर्षशतानि च ।\nअलर्कादपरो नान्यो बुभुजे मेदिनीं युवा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001002017, "chapter_id": 21002, "verse_number": "४-८-१८", "content_sanskrit": "तस्याप्यलर्कस्य सन्नतिनामाऽभवदात्मजः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001002018, "chapter_id": 21002, "verse_number": "४-८-१९", "content_sanskrit": "सन्नतेः सुनीथः तस्यापि सुकेतुः तस्माच्च धर्मकेतुर्जज्ञे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001002019, "chapter_id": 21002, "verse_number": "४-८-२०", "content_sanskrit": "ततश्च सत्यकेतुः तस्माद्विभुः तत्तयस्सुविभुः ततश्च सुकुमारस्तस्यापि दृष्टकेतुः ततश्च वीतिहोत्रः तस्माद्भार्गः भार्गस्य भार्गभूमिः ततश्चातुर्वर्ण्यप्रवृत्तिरित्येते काश्यपभूभृतः कथिताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001002020, "chapter_id": 21002, "verse_number": "४-८-२१", "content_sanskrit": "रजेस्तु संततिः श्रूयताम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]