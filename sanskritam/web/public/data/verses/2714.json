[{"id": 2080584, "chapter_id": 2714, "verse_number": "१२-२१९-०x", "content_sanskrit": "गुरुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2080585, "chapter_id": 2714, "verse_number": "१२-२१९-१", "content_sanskrit": "न स वेद परं ब्रह्म यो न वेद चतुष्टयम्।\nव्यक्ताव्यक्तं च यत्तत्त्वं संप्रोक्तं परमर्षिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2080586, "chapter_id": 2714, "verse_number": "१२-२१९-२", "content_sanskrit": "व्यक्तं मृत्युमुखं विद्यादव्यक्तममृतं पदम्।\nनिवृत्तिलक्षणं धर्ममृषिर्नारायणोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2080587, "chapter_id": 2714, "verse_number": "१२-२१९-३", "content_sanskrit": "तत्रैवावस्थितं सर्वं त्रैलोक्यं सचराचरम्।\nनिवृत्तिलक्षणं धर्ममव्यक्तं ब्रह्म शाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2080588, "chapter_id": 2714, "verse_number": "१२-२१९-४", "content_sanskrit": "प्रवृत्तिलक्षणं धर्मं प्रजापतिरतथाब्रवीत्।\nप्रवृत्तिः पुनरावृत्तिर्निवृत्तिः परमा गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2080589, "chapter_id": 2714, "verse_number": "१२-२१९-५", "content_sanskrit": "तां गतिं परमामेति निवृत्तिपरमो मुनिः।\nज्ञानतत्त्वपरो नित्यं शुभाशुभनिदर्शकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2080590, "chapter_id": 2714, "verse_number": "१२-२१९-६", "content_sanskrit": "तदेवमेतौ विज्ञेयावव्यक्तपुरुषाबुभौ।\nअव्यक्तपुरुषाभ्यां तु यत्स्यादन्यन्महत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2080591, "chapter_id": 2714, "verse_number": "१२-२१९-७", "content_sanskrit": "तं विशेषमवेक्षेति विशेषेण विचक्षणः।\nअनाद्यन्तावुभावेतावलिङ्गौ चाप्युभावपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2080592, "chapter_id": 2714, "verse_number": "१२-२१९-८", "content_sanskrit": "उभौ नित्यावनुचरौ महद्भ्यश्च महत्तरौ।\nसामान्यमेतदुभयोरेवं ह्यन्यद्विशेषणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2080593, "chapter_id": 2714, "verse_number": "१२-२१९-९", "content_sanskrit": "प्रकृत्या सर्गधर्मिण्या तथा त्रिगुणसत्वया।\nविपरीतमतो विद्यात्क्षेत्रज्ञस्य स्वलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2080594, "chapter_id": 2714, "verse_number": "१२-२१९-१०", "content_sanskrit": "प्रकृतेश्च विकाराणां द्रष्टारमगुणान्वितम्।\n`क्षेत्रज्ञमाहुर्जीवं तु कर्तारं गुणसंवृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2080595, "chapter_id": 2714, "verse_number": "१२-२१९-११", "content_sanskrit": "अग्राह्यं येन जानन्ति तज्ज्ञानं दंशितश्च तत्।\nतेनैव दंशितो नित्यं न गुणः परिभूयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2080596, "chapter_id": 2714, "verse_number": "१२-२१९-१२", "content_sanskrit": "अग्राह्यौ पुरुषावेतावलिङ्गत्वादसङ्गिनौ।\nसंयोगलक्षणोत्पत्तिः कर्मजा गृह्यते यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2080597, "chapter_id": 2714, "verse_number": "१२-२१९-१३", "content_sanskrit": "करणैः कर्मनिर्वृत्तैः कर्ता यद्यद्विचेष्टते।\nकीर्त्यते शब्दसंज्ञाभिः कोऽहमेषोप्यसाविति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2080598, "chapter_id": 2714, "verse_number": "१२-२१९-१४", "content_sanskrit": "`ममापि कायमिति च तदज्ञो नित्यसंवृतः।\nउष्णीषवान्यथा वस्त्रैस्त्रिभिर्भवति संवृतः।\nसंवृतोऽयं तथा देही सत्त्वराजसतामसैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2080599, "chapter_id": 2714, "verse_number": "१२-२१९-१५", "content_sanskrit": "`भेदवस्तु त्वभेदेन जानाति स यदा पुमान्।\nतदा परं परात्माऽसौ भवत्येव निरञ्जनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2080600, "chapter_id": 2714, "verse_number": "१२-२१९-१६", "content_sanskrit": "क्रियायोगे च भेदाख्ये बहु संक्षिप्यते क्वचित्।\nवसुरुद्रगणाद्येषु स्वानुभोगेन भोगतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2080601, "chapter_id": 2714, "verse_number": "१२-२१९-१७", "content_sanskrit": "एवमेष परः सत्त्वो नानारूपेण संस्थितः।\nसंक्षिप्तो दृश्यते पश्चादेकरूपेण विष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2080602, "chapter_id": 2714, "verse_number": "१२-२१९-१८", "content_sanskrit": "तस्माच्चतुष्टयं वेद्यमेतैर्हेतुभिरावृतम्।\nतथासंज्ञो ह्ययं सम्यगन्तकाले न मुह्यति।\n`वायुर्विधो यथा भानुर्विप्रकाशं गमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2080603, "chapter_id": 2714, "verse_number": "१२-२१९-१९", "content_sanskrit": "श्रियं दिव्यामभिप्रेप्सुर्वर्ष्मवान्मनसा शुचिः।\nशारीरैर्नियमैरुग्रैश्चरेन्निष्कल्मषं तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2080604, "chapter_id": 2714, "verse_number": "१२-२१९-२०", "content_sanskrit": "त्रैलोक्यं तपसा व्याप्तमन्तर्भूतेन भास्वता।\nसूर्यश्च चन्द्रमाश्चैव भासतस्तपसा दिवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2080605, "chapter_id": 2714, "verse_number": "१२-२१९-२१", "content_sanskrit": "`अन्यच्च धर्मसाम्यं यत्तपस्तत्कीर्त्यते पुनः।\nप्रकाशस्तपसो ज्ञानं लोके संशब्दितं तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2080606, "chapter_id": 2714, "verse_number": "१२-२१९-२२", "content_sanskrit": "रजस्तमोघ्नं यत्कर्म तपसस्तत्स्वलक्षणम्।\n`त्रितयं ह्येतदाख्यातं यद्यस्माद्भासितुं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2080607, "chapter_id": 2714, "verse_number": "१२-२१९-२३", "content_sanskrit": "स्वभासा भासयंश्चापि चन्द्रमा ह्यत्र वर्तते।\nसूर्ययोगे तु यः सन्धिस्तपः सर्वं प्रदीप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2080608, "chapter_id": 2714, "verse_number": "१२-२१९-२४", "content_sanskrit": "ब्रह्मचर्यमहिंसा च शारीरं तप उच्यते।\nवाङ्भनोनियमः सम्यङ्भानसं तप उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2080609, "chapter_id": 2714, "verse_number": "१२-२१९-२५", "content_sanskrit": "विधिज्ञेभ्यो द्विजातिभ्यो ग्राह्यमन्नं विशिष्यते।\nआहारनियमेनास्य पाप्मा शाम्यति राजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2080610, "chapter_id": 2714, "verse_number": "१२-२१९-२६", "content_sanskrit": "वैमनस्यं च विषये यान्त्यस्य करणानि च।\nतस्मात्तन्मात्रमादद्याद्यावदत्र प्रयोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2080611, "chapter_id": 2714, "verse_number": "१२-२१९-२७", "content_sanskrit": "अन्तकाले बलोत्कर्षाच्छनैः कुर्यादनातुरः।\nएवं युक्तेन मनसा ज्ञानं यदुपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2080612, "chapter_id": 2714, "verse_number": "१२-२१९-२८", "content_sanskrit": "रजोवर्ज्यो ह्ययं देही देहवाञ्छब्दवांश्चरेत्।\nकार्यैरव्याहतमतिर्वैराग्यात्प्रकृतौ स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2080613, "chapter_id": 2714, "verse_number": "१२-२१९-२९", "content_sanskrit": "आ देहादप्रमादाच्च देहान्ताद्विप्रमुच्यते।\nहेतुयुक्तः सदा सार्गो भूतानां प्रलयस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2080614, "chapter_id": 2714, "verse_number": "१२-२१९-३०", "content_sanskrit": "परप्रत्ययसर्गे तु नियमो नातिवर्तते।\nएवं तत्प्रभवां प्रज्ञामासते ये विषर्यये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2080615, "chapter_id": 2714, "verse_number": "१२-२१९-३१", "content_sanskrit": "धृत्या देहान्धारयन्तो बुद्धिसंक्षिप्तचेतसः।\nस्थानेभ्यो ध्वंसमानाश्च सूक्ष्मत्वात्तदुपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2080616, "chapter_id": 2714, "verse_number": "१२-२१९-३२", "content_sanskrit": "यथागमं च तत्सर्वं बुद्ध्या तन्नैव बुद्ध्यते।\nदेहान्तं कश्चिदन्वास्ते भावितात्मा निराश्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2080617, "chapter_id": 2714, "verse_number": "१२-२१९-३३", "content_sanskrit": "युक्तो धारणया कश्चित्सतः केचिदुपासते।\nअभ्यस्यन्ति परं देवं विद्यासंशब्दिताक्षरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2080618, "chapter_id": 2714, "verse_number": "१२-२१९-३४", "content_sanskrit": "अन्तकाले ह्युपासन्ते तपसा दग्धकिल्विषाः।\nसर्व एते महात्मानो गच्छन्ति परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2080619, "chapter_id": 2714, "verse_number": "१२-२१९-३५", "content_sanskrit": "सूक्ष्मं विशेषणं तेषामवेक्षेच्छास्त्रचक्षुषा।\nदेहं तु परमं विद्याद्विमुक्तमपरिग्रहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2080620, "chapter_id": 2714, "verse_number": "१२-२१९-३६", "content_sanskrit": "अन्तरिक्षादन्यतरं धारणासक्तमानसम्।\nमर्त्यलोकाद्विमुच्यन्ते विद्यासंसक्तचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2080621, "chapter_id": 2714, "verse_number": "१२-२१९-३७", "content_sanskrit": "ब्रह्मभूता विरजसस्ततो यान्ति परां गतिम्।\nएवमेकायनं धर्ममाहुर्वेदविदो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2080622, "chapter_id": 2714, "verse_number": "१२-२१९-३८", "content_sanskrit": "यथाज्ञानमुपासन्तः सर्वे यान्ति परां गतिम्।\nकषायवर्जितं----तेषामुत्पद्यतेऽमलम्।\nयान्ति तेऽपि----- कान्विशुध्यन्ति यथाबलं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2080623, "chapter_id": 2714, "verse_number": "१२-२१९-३९", "content_sanskrit": "भगवन्तमजं दिव्य विष्णुमव्यक्तसंज्ञितम्।\nभावेन यान्ति शुद्धा ये ज्ञानतृप्ता निराशिषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2080624, "chapter_id": 2714, "verse_number": "१२-२१९-४०", "content_sanskrit": "ज्ञात्वाऽऽत्मस्थं------- न निवर्तन्ति तेऽव्ययाः।\nप्राप्य तत्परमं स्थानमोदन्तेऽक्षरमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2080625, "chapter_id": 2714, "verse_number": "१२-२१९-४१", "content_sanskrit": "एतावदेतद्विज्ञानमेतदस्ति च नास्ति च।\nतृष्णाबद्धं जगत्सर्वं चक्रवत्परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2080626, "chapter_id": 2714, "verse_number": "१२-२१९-४२", "content_sanskrit": "विसतन्तुर्यथैवायमन्तस्थः सर्वतो बिसे।\nतृष्णातन्तुरनाद्यन्तस्तथा देहगतः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2080627, "chapter_id": 2714, "verse_number": "१२-२१९-४३", "content_sanskrit": "सूच्या सूत्रं यथा वस्त्रे संसारयति वायकः।\nतद्वत्संसारसूत्रं हि तृष्णासूच्या निबद्ध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2080628, "chapter_id": 2714, "verse_number": "१२-२१९-४४", "content_sanskrit": "`इतस्ततः समाहृत्य रूपं निर्वर्तयिष्यति।\nविकारं प्रकृतिं चैव पुरुषं च सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2080629, "chapter_id": 2714, "verse_number": "१२-२१९-४५", "content_sanskrit": "यो यथावद्विजानाति स वितृष्णो विमुच्यते।\nयाति नित्यं स सद्भावमात्मनो वै महद्भुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2080630, "chapter_id": 2714, "verse_number": "१२-२१९-४६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2080631, "chapter_id": 2714, "verse_number": "१२-२१९-४६", "content_sanskrit": "प्रकाशं भगवानेतदृषिर्नारायणोऽमृतम्।\nभूतानामनुकम्पार्थं जगाद जगतो हितम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2080632, "chapter_id": 2714, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकोनविंशत्यधिकद्विशततमोऽध्यायः॥ २१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]