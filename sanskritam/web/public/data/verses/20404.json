[{"id": 7000404000, "chapter_id": 20404, "verse_number": "२-७६-१", "content_sanskrit": "सुकर्मोवाच ।\nसौरिर्दूतैस्तथा सर्वैः सह स्वर्गं जगाम सः ।\nद्रष्टुं तत्र सहस्राक्षं देववृंदैः समावृतम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000404001, "chapter_id": 20404, "verse_number": "२-७६-२", "content_sanskrit": "धर्मराजं समायांतं ददर्श सुरराट्तदा ।\nसमुत्थाय त्वरायुक्तो दत्वा चार्घमनुत्तमम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000404002, "chapter_id": 20404, "verse_number": "२-७६-३", "content_sanskrit": "पप्रच्छागमनं तस्य कथयस्व ममाग्रतः ।\nसमाकर्ण्य महद्वाक्यं देवराजस्य भाषितम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000404003, "chapter_id": 20404, "verse_number": "२-७६-४", "content_sanskrit": "धर्मराजोऽब्रवीत्सर्वं ययातेश्चरितं महत् ।\nधर्मराज उवाच ।\nश्रूयतां देवदेवेश यस्मादागमनं मम॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000404004, "chapter_id": 20404, "verse_number": "२-७६-५", "content_sanskrit": "कथयाम्यहमत्रापि येनाहमागतस्तव ।\nनहुषस्यात्मजेनापि वैष्णवेन महात्मना॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000404005, "chapter_id": 20404, "verse_number": "२-७६-६", "content_sanskrit": "वैष्णवाश्च कृता मर्त्या ये वसंति महीतले ।\nवैकुंठस्य समं रूपं मर्त्यलोकस्य वै कृतम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000404006, "chapter_id": 20404, "verse_number": "२-७६-७", "content_sanskrit": "अमरा मानवा जाता जरारोगविवर्जिताः ।\nपापमेव न कुर्वंति असत्यं न वदंति ते॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000404007, "chapter_id": 20404, "verse_number": "२-७६-८", "content_sanskrit": "कामक्रोधविहीनास्ते लोभमोहविवर्जिताः ।\nदानशीला महात्मानः सर्वे धर्मपरायणाः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000404008, "chapter_id": 20404, "verse_number": "२-७६-९", "content_sanskrit": "सर्वधर्मैः समर्चंति नारायणमनामयम् ।\nतेन वैष्णवधर्मेण मानवा जगतीतले॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000404009, "chapter_id": 20404, "verse_number": "२-७६-१०", "content_sanskrit": "निरामया वीतशोकाः सर्वे च स्थिरयौवनाः ।\nदूर्वा वटा यथा देव विस्तारं यांति भूतले॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000404010, "chapter_id": 20404, "verse_number": "२-७६-११", "content_sanskrit": "तथा ते विस्तरं प्राप्ताः पुत्रपौत्रैः प्रपौत्रकैः ।\nतेषां पुत्रैः प्रपौत्रैश्च वंशाद्वंशांतरं गताः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000404011, "chapter_id": 20404, "verse_number": "२-७६-१२", "content_sanskrit": "एवं हि वैष्णवः सर्वो जरामृत्युविवर्जितः ।\nमर्त्यलोकः कृतस्तेन नहुषस्यात्मजेन वै॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000404012, "chapter_id": 20404, "verse_number": "२-७६-१३", "content_sanskrit": "पदभ्रष्टोस्मि संजातो व्यापारेण विवर्जितः ।\nएतत्सर्वं समाख्यातं मम कर्मविनाशनम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000404013, "chapter_id": 20404, "verse_number": "२-७६-१४", "content_sanskrit": "एवं ज्ञात्वा सहस्राक्ष लोकस्यास्य हितं कुरु ।\nएतत्ते सर्वमाख्यातं यथापृष्टोस्मि वै त्वया॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000404014, "chapter_id": 20404, "verse_number": "२-७६-१५", "content_sanskrit": "एतस्मात्कारणादिंद्र आगतस्तव सन्निधौ ।\nइंद्र उवाच ।\nपूर्वमेव मया दूत आगमाय महात्मनः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000404015, "chapter_id": 20404, "verse_number": "२-७६-१६", "content_sanskrit": "प्रेषितो धर्मराजेंद्र दूतेनास्यापि भाषितम् ।\nनाहं स्वर्गसुखस्यार्थी नागमिष्ये दिवं पुनः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000404016, "chapter_id": 20404, "verse_number": "२-७६-१७", "content_sanskrit": "स्वर्गरूपं करिष्यामि सर्वं तद्भूमिमंडलम् ।\nइत्याचचक्षे भूपालः प्रजापाल्यं करोति सः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000404017, "chapter_id": 20404, "verse_number": "२-७६-१८", "content_sanskrit": "तस्य धर्मप्रभावेण भीतस्तिष्ठामि सर्वदा ।\nधर्म उवाच ।\nयेनकेनाप्युपायेन तमानय सुभूपतिम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000404018, "chapter_id": 20404, "verse_number": "२-७६-१९", "content_sanskrit": "देवराज महाभाग यदीच्छसि मम प्रियम् ।\nइत्याकर्ण्य वचस्तस्य धर्मस्यापि सुराधिपः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000404019, "chapter_id": 20404, "verse_number": "२-७६-२०", "content_sanskrit": "चिंतयामास मेधावी सर्वतत्वेन भूपते ।\nकामदेवं समाहूय गंधर्वांश्च पुरंदरः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000404020, "chapter_id": 20404, "verse_number": "२-७६-२१", "content_sanskrit": "मकरंदं रतिं देव आनिनाय महामनाः ।\nतथा कुरुत वै यूयं यथाऽगच्छति भूपतिः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000404021, "chapter_id": 20404, "verse_number": "२-७६-२२", "content_sanskrit": "यूयं गच्छन्तु भूर्लोकं मयादिष्टा न संशयः ।\nकाम उवाच ।\nयुवयोस्तु प्रियं पुण्यं करिष्यामि न संशयः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000404022, "chapter_id": 20404, "verse_number": "२-७६-२३", "content_sanskrit": "राजानं पश्य मां चैव स्थितं चैव समा युधि ।\nतथेत्युक्त्वा गताः सर्वे यत्र राजा स नाहुषिः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000404023, "chapter_id": 20404, "verse_number": "२-७६-२४", "content_sanskrit": "नटरूपेण ते सर्वे कामाद्याः कर्मणा द्विज ।\nआशीर्भिरभिनंद्यैव ते च ऊचुः सुनाटकम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000404024, "chapter_id": 20404, "verse_number": "२-७६-२५", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा ययातिः पृथिवीपतिः ।\nसभां चकार मेधावी देवरूपां सुपंडितैः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000404025, "chapter_id": 20404, "verse_number": "२-७६-२६", "content_sanskrit": "समायातः स्वयं भूपो ज्ञानविज्ञानकोविदः ।\nतेषां तु नाटकं राजा पश्यमानः स नाहुषिः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000404026, "chapter_id": 20404, "verse_number": "२-७६-२७", "content_sanskrit": "चरितं वामनस्यापि उत्पत्तिं विप्ररूपिणः ।\nरूपेणाप्रतिमा लोके सुस्वरं गीतमुत्तमम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000404027, "chapter_id": 20404, "verse_number": "२-७६-२८", "content_sanskrit": "गायमाना जरा राजन्नार्यारूपेण वै तदा ।\nतस्या गीतविलासेन हास्येन ललितेन च॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000404028, "chapter_id": 20404, "verse_number": "२-७६-२९", "content_sanskrit": "मधुरालापतस्तस्य कंदर्पस्य च मायया ।\nमोहितस्तेन भावेन दिव्येन चरितेन च॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000404029, "chapter_id": 20404, "verse_number": "२-७६-३०", "content_sanskrit": "बलेश्चैव यथारूपं विंध्यावल्या यथा पुरा ।\nवामनस्य यथारूपं चक्रे मारोथ तादृशम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000404030, "chapter_id": 20404, "verse_number": "२-७६-३१", "content_sanskrit": "सूत्रधारः स्वयं कामो वसंतः पारिपार्श्वकः ।\nनटीवेषधरा जाता सा रतिर्हृष्टवल्लभा॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000404031, "chapter_id": 20404, "verse_number": "२-७६-३२", "content_sanskrit": "नेपथ्यांतश्चरी राजन्सा तस्मिन्नृत्यकर्मणि ।\nमकरंदो महाप्राज्ञः क्षोभयामास भूपतिम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000404032, "chapter_id": 20404, "verse_number": "२-७६-३३", "content_sanskrit": "यथायथा पश्यति नृत्यमुत्तमं गीतं समाकर्णति स क्षितीशः ।\nतथातथा मोहितवान्स भूपतिं नटीप्रणीतेन महानुभावः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]