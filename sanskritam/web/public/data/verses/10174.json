[{"id": 6000174000, "chapter_id": 10174, "verse_number": null, "content_sanskrit": "अथ एकविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000174001, "chapter_id": 10174, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.001.m4a", "display_order": 2}, {"id": 6000174002, "chapter_id": 10174, "verse_number": "८-२१-१", "content_sanskrit": "इत्युक्तवन्तं पुरुषं पुरातनं महानुभावोऽखिलसाधुसम्मतः।\nबद्धाञ्जलिर्बाष्पकलाकुलेक्षणो भक्त्युत्कलो गद्गदया गिराऽब्रवीत्॥ ८/२१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.002.m4a", "display_order": 3, "topics": [{"text": "हरिणा बलेर्द्वारपालकत्वेन भवनम्", "range": "१–२"}]}, {"id": 6000174003, "chapter_id": 10174, "verse_number": null, "content_sanskrit": "बलिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.003.m4a", "display_order": 4}, {"id": 6000174004, "chapter_id": 10174, "verse_number": "८-२१-२", "content_sanskrit": "अहो प्रसादोऽस्य कृतः समुद्यतः प्रपन्नभक्तार्थविधौ समाहितः।\nयल्लोकपालैस्तदनुग्रहोऽमरैरलब्धपूर्वोऽपसदेऽसुरेऽर्पितः॥ ८/२१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.004.m4a", "display_order": 5}, {"id": 6000174005, "chapter_id": 10174, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.005.m4a", "display_order": 6}, {"id": 6000174006, "chapter_id": 10174, "verse_number": "८-२१-३", "content_sanskrit": "इत्युक्त्वा हरिमानम्य ब्रह्माणं सभवं ततः।\nविवेश सुतलं प्रीतो बलिर्मुक्तः सहासुरैः॥ ८/२१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.006.m4a", "display_order": 7, "topics": [{"text": "प्रह्लादेन सह महाबलेः सुतलप्रवेशः", "range": "२–१२"}]}, {"id": 6000174007, "chapter_id": 10174, "verse_number": "८-२१-४", "content_sanskrit": "एवमिन्द्राय भगवान् प्रीत्याऽऽनीय त्रिविष्टपम्।\nपूरयित्वाऽदितेः काममशासत् सकलं जगत्॥ ८/२१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.007.m4a", "display_order": 8}, {"id": 6000174008, "chapter_id": 10174, "verse_number": "८-२१-५", "content_sanskrit": "लब्धप्रसादनिर्मुक्तं पौत्रं वंशधरं बलिम्।\nनिशाम्य भक्तिप्रवणः प्रह्लाद इदमब्रवीत्॥ ८/२१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.008.m4a", "display_order": 9}, {"id": 6000174009, "chapter_id": 10174, "verse_number": null, "content_sanskrit": "प्रह्लाद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.009.m4a", "display_order": 10}, {"id": 6000174010, "chapter_id": 10174, "verse_number": "८-२१-६", "content_sanskrit": "नेमं विरिञ्चो लभते प्रसादं न श्रीर्न शर्वः किमुतापरे ते।\nयन्नोऽसुराणामसि दुर्गपालो विश्वाभिवन्द्यैरभिवन्दिताङ्घ्रिः॥ ८/२१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.010.m4a", "display_order": 11}, {"id": 6000174011, "chapter_id": 10174, "verse_number": "८-२१-७", "content_sanskrit": "यत्पादपद्ममकरन्दनिषेवणेन ब्रह्मादयः शरणदाश्नुवते विभूतीः।\nकस्माद् वयं कुसृतयः खलयोनयस्ते दाक्षिण्यदृष्टिपदवीं भवतः प्रणीताः॥ ८/२१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.011.m4a", "display_order": 12}, {"id": 6000174012, "chapter_id": 10174, "verse_number": "८-२१-८", "content_sanskrit": "चित्रं तवेहितमहोऽमितयोगमायालीलाविसृष्टभुवनस्य विशारदस्य।\nसर्वात्मनः समदृशो विषमस्वभावो भक्तप्रियो यदसि कल्पतरुस्वभावः॥ ८/२१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.012.m4a", "display_order": 13}, {"id": 6000174013, "chapter_id": 10174, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.013.m4a", "display_order": 14}, {"id": 6000174014, "chapter_id": 10174, "verse_number": "८-२१-९", "content_sanskrit": "वत्स प्रह्लाद भद्रं ते प्रयाहि सुतलालयम्।\nमोदमानः स्वपौत्रेण ज्ञातीनां सुखमावह॥ ८/२१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.014.m4a", "display_order": 15}, {"id": 6000174015, "chapter_id": 10174, "verse_number": "८-२१-१०", "content_sanskrit": "नित्यं द्रष्टाऽसि मां तत्र गदापाणिमवस्थितम्।\nमद्दर्शनमहाह्लादन्यस्तकर्मनिबन्धनः॥ ८/२१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.015.m4a", "display_order": 16}, {"id": 6000174016, "chapter_id": 10174, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.016.m4a", "display_order": 17}, {"id": 6000174017, "chapter_id": 10174, "verse_number": "८-२१-११", "content_sanskrit": "आज्ञां भगवतो राजन् प्रह्लादो बलिना सह।\nबाढमित्यमलप्रज्ञो मूर्ध्न्याधाय कृताञ्जलिः॥ ८/२१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.017.m4a", "display_order": 18}, {"id": 6000174018, "chapter_id": 10174, "verse_number": "८-२१-१२", "content_sanskrit": "परिक्रम्यादिपुरुषं सर्वासुरचमूपतिः।\nप्रणतस्तदनुज्ञातः प्रविवेश महाबिलम्॥ ८/२१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.018.m4a", "display_order": 19}, {"id": 6000174019, "chapter_id": 10174, "verse_number": "८-२१-१३", "content_sanskrit": "अथाहोशनसं राजन् हरिर्नारायणोऽन्तिके।\nआसीनमृत्विजां मध्ये सदसि ब्रह्मवादिनाम्॥ ८/२१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.019.m4a", "display_order": 20, "topics": [{"text": "भगवदाज्ञया शुक्राचार्येण यज्ञच्छिद्रसन्धानम्", "range": "१३–१८"}]}, {"id": 6000174020, "chapter_id": 10174, "verse_number": null, "content_sanskrit": "श्री भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.020.m4a", "display_order": 21}, {"id": 6000174021, "chapter_id": 10174, "verse_number": "८-२१-१४", "content_sanskrit": "ब्रह्मन् सन्तनु शिष्यस्य कर्मच्छिद्रं वितन्वतः।\nयत्तत्कर्म सुवैषम्यं ब्रह्मदृष्टं समं भवेत्॥ ८/२१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.021.m4a", "display_order": 22}, {"id": 6000174022, "chapter_id": 10174, "verse_number": null, "content_sanskrit": "श्रीशुक्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.022.m4a", "display_order": 23}, {"id": 6000174023, "chapter_id": 10174, "verse_number": "८-२१-१५", "content_sanskrit": "कुतस्तत्कर्मवैषम्यं यस्य कर्मेश्वरो भवान्।\nयज्ञेशो यज्ञपुरुषः सर्वभावेन पूजितः॥ ८/२१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.023.m4a", "display_order": 24}, {"id": 6000174024, "chapter_id": 10174, "verse_number": "८-२१-१६", "content_sanskrit": "मन्त्रतस्तन्त्रतश्छिद्रं देशकालार्हवस्तुतः।\nसर्वं करोति निश्छिद्रमनुसङ्कीर्तनं तव॥ ८/२१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.024.m4a", "display_order": 25}, {"id": 6000174025, "chapter_id": 10174, "verse_number": "८-२१-१७", "content_sanskrit": "तथाऽपि वदतो भूमन् करिष्याम्यनुशासनम्।\nएतच्छ्रेयः परं पुंसां यत् तवाज्ञानुपालनम्॥ ८/२१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.025.m4a", "display_order": 26}, {"id": 6000174026, "chapter_id": 10174, "verse_number": null, "content_sanskrit": "श्रीशुक्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.026.m4a", "display_order": 27}, {"id": 6000174027, "chapter_id": 10174, "verse_number": "८-२१-१८", "content_sanskrit": "अभिनन्द्य हरेराज्ञामुशना भगवानिति।\nयज्ञच्छिद्रं समतनोद् बलेर्विप्रर्षिभिः सह॥ ८/२१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.027.m4a", "display_order": 28}, {"id": 6000174028, "chapter_id": 10174, "verse_number": "८-२१-१९", "content_sanskrit": "एवं बलेर्महीं राजन् भिक्षित्वा वामनो हरिः।\nददौ भ्रात्रे महेन्द्राय त्रिदिवं यत् परैर्हृतम्॥ ८/२१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.028.m4a", "display_order": 29, "topics": [{"text": "इन्द्रस्य वामनं पुरस्कृत्य स्वर्गलोकगमनम्", "range": "१९–३१"}]}, {"id": 6000174029, "chapter_id": 10174, "verse_number": "८-२१-२०", "content_sanskrit": "प्रजापतिपतिर्ब्रह्मा देवर्षिपितृभूमिपैः।\nदक्षभृग्वङ्गिरोमुख्यैः कुमारेण भवेन च॥ ८/२१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.029.m4a", "display_order": 30}, {"id": 6000174030, "chapter_id": 10174, "verse_number": "८-२१-२१", "content_sanskrit": "कश्यपस्यादितेः प्रीत्यै सर्वभूताभयाय च।\nलोकानां लोकपालानामकरोद् वामनं पतिम्॥ ८/२१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.030.m4a", "display_order": 31}, {"id": 6000174031, "chapter_id": 10174, "verse_number": "८-२१-२२", "content_sanskrit": "देवानां सर्ववेदानां धर्मस्य यशसः श्रियः।\nमङ्गलानां व्रतानां च कल्पं स्वर्गापवर्गयोः॥ ८/२१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.031.m4a", "display_order": 32}, {"id": 6000174032, "chapter_id": 10174, "verse_number": "८-२१-२३", "content_sanskrit": "उपेन्द्रं कल्पयाञ्चक्रे पतिं सर्वविभूतये।\nतदा सर्वाणि भूतानि भृशं मुमुदिरे नृप॥ ८/२१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.032.m4a", "display_order": 33}, {"id": 6000174033, "chapter_id": 10174, "verse_number": "८-२१-२४", "content_sanskrit": "ततस्त्विन्द्रः पुरः कृत्वा देवयानेन वामनम्।\nलोकपालैर्दिवं निन्ये ब्रह्मणा चानुमोदितः॥ ८/२१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.033.m4a", "display_order": 34}, {"id": 6000174034, "chapter_id": 10174, "verse_number": "८-२१-२५", "content_sanskrit": "आप्य त्रिभुवनं चेन्द्र उपेन्द्रभुजपालितम्।\nश्रिया परमया जुष्टो मुमुदे गतसाध्वसः॥ ८/२१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.034.m4a", "display_order": 35}, {"id": 6000174035, "chapter_id": 10174, "verse_number": "८-२१-२६", "content_sanskrit": "ब्रह्मा शर्वः कुमारश्च भृग्वाद्या मुनयो नृप।\nपितरः सर्वभूतानि सिद्धा वैमानिकाश्च ये॥ ८/२१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.035.m4a", "display_order": 36}, {"id": 6000174036, "chapter_id": 10174, "verse_number": "८-२१-२७", "content_sanskrit": "सुमहत् कर्म तद् विष्णोर्गायन्तः परमाद्भुतम्।\nधिष्ण्यानि स्वानि ते जग्मुरदितिं च शशंसिरे॥ ८/२१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.036.m4a", "display_order": 37}, {"id": 6000174037, "chapter_id": 10174, "verse_number": "८-२१-२८", "content_sanskrit": "सर्वमेतन्मयाऽऽख्यातं भवतः कुरुनन्दन।\nउरुक्रमस्य चरितं श्रोतॄणामघमोचनम्॥ ८/२१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.037.m4a", "display_order": 38}, {"id": 6000174038, "chapter_id": 10174, "verse_number": "८-२१-२९", "content_sanskrit": "पारं महिम्न उरुविक्रमतो मुरारेः यः पार्थिवान्यपि कविर्विममे रजांसि।\nकिं जायमान उत जात उपैति मर्त्य इत्याह मन्त्रदृगृषिः पुरुषस्य यस्य॥ ८/२१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.038.m4a", "display_order": 39}, {"id": 6000174039, "chapter_id": 10174, "verse_number": "८-२१-३०", "content_sanskrit": "य इदं देवदेवस्य हरेरद्भुतकर्मणः।\nअवतारानुचरितं शृण्वन् याति परां गतिम्॥ ८/२१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.039.m4a", "display_order": 40}, {"id": 6000174040, "chapter_id": 10174, "verse_number": "८-२१-३१", "content_sanskrit": "क्रियमाणे कर्मणीदं दैवे पित्र्येऽथ मानुषे।\nयत्र यत्रानुकीर्त्येत तत्तेषां सुकृतं विदुः॥ ८/२१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_021/BhP_08.021.040.m4a", "display_order": 41}, {"id": 6000174041, "chapter_id": 10174, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायाम् अष्टमस्कन्धे एकविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]