[{"id": 7000311000, "chapter_id": 20311, "verse_number": "१-६५-१", "content_sanskrit": "व्यास उवाच ।\nनांदीमुखेषु सर्वेषु पूजयेद्यो गणाधिपम् ।\nतस्य सर्वो भवेद्वश्यः पुण्यं भवति चाक्षयम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000311001, "chapter_id": 20311, "verse_number": "१-६५-२", "content_sanskrit": "गणानां त्वेति मंत्रेण सर्वयज्ञघटेषु च ।\nसर्वसिद्धिमवाप्नोति स्वर्गं मोक्षं लभेन्नरः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000311002, "chapter_id": 20311, "verse_number": "१-६५-३", "content_sanskrit": "मृण्मये प्रतिमायां च चित्रे चाथ दृषण्मये ।\nद्वारदारुणि पात्रे च हेरंबं लेखयेद्बुधः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000311003, "chapter_id": 20311, "verse_number": "१-६५-४", "content_sanskrit": "अन्यस्मिन्नपि देशे तु सततं दृष्टिगोचरे ।\nस्थापयित्वा तु हेरंबं शक्त्या यः पूजयेद्बुधः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000311004, "chapter_id": 20311, "verse_number": "१-६५-५", "content_sanskrit": "तस्य कार्याणि सिद्ध्यंति दयितानि समंततः ।\nन विघ्नं जायते किंचित्त्रैलोक्यं वशमानयेत्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000311005, "chapter_id": 20311, "verse_number": "१-६५-६", "content_sanskrit": "विद्यार्थी लभते विद्यां वेदशास्त्रसमुद्भवाम् ।\nअन्यां च शिल्पिविद्यां च विजयां स्वर्गदायिनीम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000311006, "chapter_id": 20311, "verse_number": "१-६५-७", "content_sanskrit": "धनार्थी विपुलं वित्तं कन्यां साध्वीं मनोरमाम् ।\nऐश्वर्यं धर्मसाध्यं च तनयं कुलमोक्षदम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000311007, "chapter_id": 20311, "verse_number": "१-६५-८", "content_sanskrit": "न रोगैः पीड्यते कश्चिन्न ग्रहैः प्रेतयोनिभिः ।\nशृंगिभिर्नापि रक्षोभिर्विद्युद्भिर्वनतस्करैः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000311008, "chapter_id": 20311, "verse_number": "१-६५-९", "content_sanskrit": "न राजा कुप्यति गृहे न च मारी प्रवर्तते ।\nन दौर्भिक्ष्यं न दौर्बल्यं पूजयित्वा विनायकम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000311009, "chapter_id": 20311, "verse_number": "१-६५-१०", "content_sanskrit": "अभिप्रेतार्थसिद्ध्यर्थं पूजितो यः सुरैरपि ।\nसर्वविघ्नछिदे तस्मै गणाधिपतये नमः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000311010, "chapter_id": 20311, "verse_number": "१-६५-११", "content_sanskrit": "मंत्रश्चायं ॐ नमो गणपतये ।\nनारायणप्रियैः पुष्पैरन्यैश्चापि सुगंधिभिः ।\nमोदकैः फलमूलैश्च द्रव्यैः कालोद्भवैस्तथा॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000311011, "chapter_id": 20311, "verse_number": "१-६५-१२", "content_sanskrit": "दधिदुग्धैः प्रियैर्वाद्यैरपि धूपसुगंधिभिः ।\nपूजयेद्गणपं यस्तु सर्वसिद्धिमवाप्नुयात्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000311012, "chapter_id": 20311, "verse_number": "१-६५-१३", "content_sanskrit": "विशेषात्तस्य लिंगे तु यो ददाति वसुप्रियम् ।\nपूजोपकरणं वस्त्रं सर्वं लक्षगुणं भवेत्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000311013, "chapter_id": 20311, "verse_number": "१-६५-१४", "content_sanskrit": "देशे च भारते वर्षे वनिता पूर्वसन्निधौ ।\nलौहित्यदक्षिणे तीरे लिंगरूपो विनायकः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000311014, "chapter_id": 20311, "verse_number": "१-६५-१५", "content_sanskrit": "हरगौरीसमादेशाद्देवानां संमतेन च ।\nस्थितो लोकप्रशांत्यर्थं सर्वविघ्नविनाशनात्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000311015, "chapter_id": 20311, "verse_number": "१-६५-१६", "content_sanskrit": "पूजयित्वा तु तं देवं शक्तितो द्रव्यसंचयैः ।\nविनायकत्वमाप्नोति वेदशास्त्रार्थपारगः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000311016, "chapter_id": 20311, "verse_number": "१-६५-१७", "content_sanskrit": "सकृत्प्रदक्षिणं कृत्वा दृष्ट्वा स्पृष्ट्वा तु मानवः ।\nअक्षयं लभते स्वर्गं सदा देवैः प्रपूज्यते॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000311017, "chapter_id": 20311, "verse_number": "१-६५-१८", "content_sanskrit": "संसर्गिणां च म्लेछानां गत्यर्थं सुतपस्विनाम् ।\nपुत्रार्थं सर्वलोकानां तत्र शंभुर्विनायकः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000311018, "chapter_id": 20311, "verse_number": "१-६५-१९", "content_sanskrit": "कृत्वाभिषेकं लौहित्ये स्पृशेद्यस्तु गणाधिपम् ।\nसप्तजन्मकृतात्पापान्मुच्यते नात्र संशयः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000311019, "chapter_id": 20311, "verse_number": "१-६५-२०", "content_sanskrit": "न वैधव्यं न कार्पण्यं न शोकं न तु मत्सरम् ।\nविनायकं समासाद्य जन्मजन्मनि संलभेत्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000311020, "chapter_id": 20311, "verse_number": "१-६५-२१", "content_sanskrit": "पुनः सिद्धिः पुनर्भोग्यं पुनः कीर्तिः पुनर्बलम् ।\nपूजयित्वा तु गणपं नरस्य नात्र संशयः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000311021, "chapter_id": 20311, "verse_number": "१-६५-२२", "content_sanskrit": "अस्य पूजामकृत्वा च सर्वाभीष्टं विनश्यति ।\nतत्र देवाश्च सुप्रीता ब्रह्मविष्णुहरादयः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000311022, "chapter_id": 20311, "verse_number": "१-६५-२३", "content_sanskrit": "मघोनो गणपस्याथ पूजाविरहितस्य च ।\nअथासुरैर्महावीर्यैर्हिरण्याक्षमुखै रणे॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000311023, "chapter_id": 20311, "verse_number": "१-६५-२४", "content_sanskrit": "मघवा तु जितो वीर्याद्धिरण्याक्षेण वै तदा ।\nततस्सुराश्च निर्वीर्या यावद्वर्षशतं पुरा॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000311024, "chapter_id": 20311, "verse_number": "१-६५-२५", "content_sanskrit": "दैवासुरे महायुद्धे सुराणां च पराजयः ।\nततो देवाधिदेवे तु शिवे देवैर्निवेदितम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000311025, "chapter_id": 20311, "verse_number": "१-६५-२६", "content_sanskrit": "भगवन्नसुरैर्नो हि जितं राज्यं गता मखाः ।\nएतस्मिन्नंतरे शंभुर्देवान्वचनमब्रवीत्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000311026, "chapter_id": 20311, "verse_number": "१-६५-२७", "content_sanskrit": "हेरंबाय वरो दत्त उमया प्रीतया मया ।\nपूजया ते परा सिद्धिर्देवादीनां भवत्विति॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000311027, "chapter_id": 20311, "verse_number": "१-६५-२८", "content_sanskrit": "अवजानाति यो मोहात्पुरुषस्तु महोत्सवे ।\nन भवेत्तस्य सिद्धिश्च रणे चापि पराजयः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000311028, "chapter_id": 20311, "verse_number": "१-६५-२९", "content_sanskrit": "महामखेन युष्माभिः पूजा गणपतेः कृता ।\nहेलया न कृता मोहात्तस्मात्प्राप्तः पराजयः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000311029, "chapter_id": 20311, "verse_number": "१-६५-३०", "content_sanskrit": "शीघ्रं गच्छत वै पुण्यां गणपस्य महात्मनः ।\nपूजां कुरुत धर्मज्ञा जयस्तूर्णं भविष्यति॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000311030, "chapter_id": 20311, "verse_number": "१-६५-३१", "content_sanskrit": "ततो हरमुखाच्छ्रुत्वा वचः क्षेमपरं हितम् ।\nप्रहृष्टा विबुधास्सर्वे गणपस्य पुरः स्थिताः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000311031, "chapter_id": 20311, "verse_number": "१-६५-३२", "content_sanskrit": "देवा ऊचुः ।\nगणाधिप नमस्तुभ्यं सर्वदेवैकपालक ।\nस्वर्गभोगप्रद प्रीत्या हेरंब त्वां नताः स्म ह॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000311032, "chapter_id": 20311, "verse_number": "१-६५-३३", "content_sanskrit": "जयदं सर्वयुद्धेषु सिद्धिदं सर्वकर्मसु ।\nमहामायं महाकायं हेरंब त्वां नताः स्म ह॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000311033, "chapter_id": 20311, "verse_number": "१-६५-३४", "content_sanskrit": "एकदंतं महाप्राज्ञं लंबतुंडं विनायकम् ।\nदेवं महर्षिदेवानांमिंद्रस्य च नताः स्म ह॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000311034, "chapter_id": 20311, "verse_number": "१-६५-३५", "content_sanskrit": "यत्ते पुरार्चनं यज्ञे न कृतं तत्क्षमस्व नः ।\nसुराणां च गिरः श्रुत्वा गणपो वाक्यमब्रवीत्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000311035, "chapter_id": 20311, "verse_number": "१-६५-३६", "content_sanskrit": "युष्माभिर्व्रियतां देवा वरो मत्तो हि वांच्छितः ।\nततः शक्रादयः सर्वे बृहस्पतिपुरोगमाः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000311036, "chapter_id": 20311, "verse_number": "१-६५-३७", "content_sanskrit": "ऊचुर्गणपतिं देवा जयोस्माकं भवत्विति ।\nदेवानां वचनं श्रुत्वा गणेशो वाक्यमब्रवीत्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000311037, "chapter_id": 20311, "verse_number": "१-६५-३८", "content_sanskrit": "बाढमेव सुरश्रेष्ठा जयो वो भवतु द्रुतम् ।\nततो देवगणास्सर्वे हर्षनिर्भरमानसाः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000311038, "chapter_id": 20311, "verse_number": "१-६५-३९", "content_sanskrit": "गणेशं पूजयामासुर्गंधसारैस्तु मण्डनैः ।\nदिव्यधूपैः सुवस्त्रैश्च कुसुमैर्नन्दनोद्भवैः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000311039, "chapter_id": 20311, "verse_number": "१-६५-४०", "content_sanskrit": "पारिजातादिभिः पुष्पैरन्यैर्देवमनोहरैः ।\nपूजितो गणपो देवैरुवाच सुरसत्तमान्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000311040, "chapter_id": 20311, "verse_number": "१-६५-४१", "content_sanskrit": "गच्छध्वं विबुधा देवं विष्णुमद्भुतसाहसम् ।\nस विधास्यति वः कामं वांच्छितं च ततः सुराः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000311041, "chapter_id": 20311, "verse_number": "१-६५-४२", "content_sanskrit": "स्वंस्वं रथं समारुह्य गतास्ते हरिमव्ययम् ।\nपीतांबरं नमस्कृत्य ऊचुर्देवगणा मुदा॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000311042, "chapter_id": 20311, "verse_number": "१-६५-४३", "content_sanskrit": "हरात्मजं तु संप्राप्य पूजयित्वा गणाधिपम् ।\nआगतास्त्वत्सकाशं वै महात्मन्नद्य केशव॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000311043, "chapter_id": 20311, "verse_number": "१-६५-४४", "content_sanskrit": "एतच्छ्रुत्वा तु देवानां वचनं हरिरव्ययः ।\nयथातथ्यमुवाचेदं हनिष्ये दैत्यपुंगवान्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000311044, "chapter_id": 20311, "verse_number": "१-६५-४५", "content_sanskrit": "श्रुत्वा वागमृतं देवा नारायणमुखाच्च्युतम् ।\nहृष्टाश्च सुमुदाविष्टा द्रव्यैरिष्टैः समर्चयन्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000311045, "chapter_id": 20311, "verse_number": "१-६५-४६", "content_sanskrit": "पुनर्विष्णुरुवाचेदं देवानिंद्रपुरोगमान् ।\nस्वंस्वं बलं समाहृत्य सज्जी भवत विज्वराः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000311046, "chapter_id": 20311, "verse_number": "१-६५-४७", "content_sanskrit": "हरिष्ये तान्दुराचारान्बलं चैव समंततः ।\nअस्त्रवृंदं तु संगृह्य यूयं तिष्ठत निर्भयाः॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000311047, "chapter_id": 20311, "verse_number": "१-६५-४८", "content_sanskrit": "माधवस्य वचः श्रुत्वा प्रगताः सुरपुंगवाः ।\nविमानानि समारुह्य सर्वे दिव्यास्त्रधारिणः॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000311048, "chapter_id": 20311, "verse_number": "१-६५-४९", "content_sanskrit": "देवानां हर्षवाक्यानि दैत्यचारैः श्रुतानि वै ।\nराजानं कथयामासुर्हिरण्याक्षं महाबलम्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000311049, "chapter_id": 20311, "verse_number": "१-६५-५०", "content_sanskrit": "श्रुत्वा दैत्यपतिस्तत्र चुकोपाति महाबलः ।\nसचिवांस्तु समाहूय क्रुद्धो वचनमब्रवीत्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000311050, "chapter_id": 20311, "verse_number": "१-६५-५१", "content_sanskrit": "अधुनेंद्रादिदेवाश्च निखिलाः क्रूरबुद्धयः ।\nमाधवं च परीप्सन्तः शंभौ सर्वं न्यवेदयन्॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000311051, "chapter_id": 20311, "verse_number": "१-६५-५२", "content_sanskrit": "कथं जयं च लप्स्यामो दैत्यवृंदेतिदारुणे ।\nत्रिपुरारिरुवाचेदं गणेशं यजतामराः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000311052, "chapter_id": 20311, "verse_number": "१-६५-५३", "content_sanskrit": "पूजयित्वा तु तं देवं जेष्यथासुरदानवान् ।\nततो देवगणैर्हृष्टैः पूजितो गणनायकः॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000311053, "chapter_id": 20311, "verse_number": "१-६५-५४", "content_sanskrit": "गणाधिपेन तुष्टेन क्रूरो दत्तो वरो महान् ।\nजेष्यथाद्यासुरान्सर्वांस्ततो देवा मुदान्विताः॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000311054, "chapter_id": 20311, "verse_number": "१-६५-५५", "content_sanskrit": "हरिं निवेदयामासुरस्मद्वधपरीप्सवः ।\nहरेर्बाढमुपश्रुत्य रथिनः शस्त्रपाणयः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000311055, "chapter_id": 20311, "verse_number": "१-६५-५६", "content_sanskrit": "युद्धार्थमधितिष्ठंति निर्जरास्त्वभयामयि ।\nयस्य या शक्तिरस्तीह देवाञ्जेतुं वदत्वलम्॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000311056, "chapter_id": 20311, "verse_number": "१-६५-५७", "content_sanskrit": "ततो राज्ञोवचः श्रुत्वा मधुर्वचनमब्रवीत् ।\nजेष्यामि च हरिं राजन्सहायं मे नियोजय॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000311057, "chapter_id": 20311, "verse_number": "१-६५-५८", "content_sanskrit": "जिते नारायणे देवाः सभयास्त्रिदशा ध्रुवम् ।\nतस्मान्नारायणोऽस्माकं भागः सर्वपुरंजयः॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000311058, "chapter_id": 20311, "verse_number": "१-६५-५९", "content_sanskrit": "ततो धुंधुश्च सुंदश्च कालकेयो महाबलः ।\nसहायश्च मधोस्तस्य जेष्यामो माधवं नृप॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000311059, "chapter_id": 20311, "verse_number": "१-६५-६०", "content_sanskrit": "सर्वदैत्यबले मुख्याश्चत्वारो दृढविक्रमाः ।\nकालमृत्युसमा वीराः सर्वास्त्रविधिपारगाः॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000311060, "chapter_id": 20311, "verse_number": "१-६५-६१", "content_sanskrit": "बलस्तत्राब्रवीद्वाक्यं यस्मिन्जय उपस्थितः ।\nतं च जेष्यामि जिष्णुं च प्रतिज्ञा मे दृढा नृप॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000311061, "chapter_id": 20311, "verse_number": "१-६५-६२", "content_sanskrit": "नमुचिश्च मुचिश्चैव भ्रातरौ बलदर्पितौ ।\nऊचतुस्तौ नृपं ह्यावां जेष्यावो वै बलाद्बलौ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000311062, "chapter_id": 20311, "verse_number": "१-६५-६३", "content_sanskrit": "जम्भश्चैवाब्रवीद्वाक्यमिंद्रमिंद्रपुरोगमान् ।\nजेष्यामि नात्र संदेहो दैत्या भवत विज्वराः॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000311063, "chapter_id": 20311, "verse_number": "१-६५-६४", "content_sanskrit": "त्रिपुरश्चाब्रवीद्वाक्यं जेष्यामि च विनायकम् ।\nतावदूचेऽथ सेनानीर्मयो देवांतको बली॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000311064, "chapter_id": 20311, "verse_number": "१-६५-६५", "content_sanskrit": "कुबेरं प्रतिरक्षोभिः सर्वांश्चैव हिरण्यकान् ।\nएतस्मिन्नंतरे तत्र नारदो मुनिसत्तमः॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000311065, "chapter_id": 20311, "verse_number": "१-६५-६६", "content_sanskrit": "गत्वोवाच हिरण्याक्षं जिष्णुदूतोहमागतः ।\nराज्यं त्यज स्ववाचा नः प्राणेषु यदि ते हितम्॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000311066, "chapter_id": 20311, "verse_number": "१-६५-६७", "content_sanskrit": "न चेद्युध्यस्व मामद्य न वा गच्छ रसातलम् ।\nततः कोपादुवाचेदं नारदं मुनिसत्तमम्॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000311067, "chapter_id": 20311, "verse_number": "१-६५-६८", "content_sanskrit": "अहिंस्यस्त्वं ब्राह्माणाद्य गच्छ तूर्णं ममाग्रतः ।\nदेवानां च विपत्तिं च कदनं निधनं पुरः॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000311068, "chapter_id": 20311, "verse_number": "१-६५-६९", "content_sanskrit": "पश्य विप्र क्षणेनांतं प्राप्तं हरिहरादिकम् ।\nएवमुक्त्वा स दैत्येंद्रो बलाध्यक्षमुवाच ह॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000311069, "chapter_id": 20311, "verse_number": "१-६५-७०", "content_sanskrit": "सज्जीकृत्य बलं सर्वान्रथांश्चानयत द्रुतम् ।\nदैत्यराजवचः श्रुत्वा बलाध्यक्षः समंततः॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000311070, "chapter_id": 20311, "verse_number": "१-६५-७१", "content_sanskrit": "बलान्याहूय सहसा संत्रस्तास्तूर्णमागताः ।\nकोटिकोटिसहस्राणि अक्षौहिण्यो बलानि च॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000311071, "chapter_id": 20311, "verse_number": "१-६५-७२", "content_sanskrit": "एकैकस्य च वीरस्य वाहनानि महांति च ।\nस्यंदनानि विचित्राणि गजोष्ट्राश्वखरानपि॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000311072, "chapter_id": 20311, "verse_number": "१-६५-७३", "content_sanskrit": "सिंहव्याघ्रलुलायांश्च समारुह्य ययुस्तदा ।\nवाद्यैः सर्वैश्च भूयिष्ठैः सिंहनादैर्भयानकैः॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000311073, "chapter_id": 20311, "verse_number": "१-६५-७४", "content_sanskrit": "दिशस्तु पूरयामासुस्सिन्धुवेलाचला धराः ।\nसर्वलोकाश्च वित्रेसुः समुद्राश्च चकंपिरे॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000311074, "chapter_id": 20311, "verse_number": "१-६५-७५", "content_sanskrit": "देवदुंदुभयो नेदुः सर्वदेवैः समीरिताः ।\nवाद्यैश्च विविधैरन्यैर्वायुपूर्णैर्घनस्वनैः॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000311075, "chapter_id": 20311, "verse_number": "१-६५-७६", "content_sanskrit": "सर्वलोकाभयत्रस्ता ये च त्रैलोक्यवासिनः ।\nभ्रष्टकामागताकाशं घोरं तीव्रं महाहवम्॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000311076, "chapter_id": 20311, "verse_number": "१-६५-७७", "content_sanskrit": "परिघैः पाशशूलैश्च खड्गयष्टिपरश्वधैः ।\nशरैश्च निशितैर्घोरैर्जघ्नुरन्योन्यमाहवे॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000311077, "chapter_id": 20311, "verse_number": "१-६५-७८", "content_sanskrit": "शस्त्रास्त्रैर्बहुधामुक्तैर्दिशः सर्वा निरंतरम् ।\nविगृहेषु धरण्यां च पर्वतेषु जलेषु च॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000311078, "chapter_id": 20311, "verse_number": "१-६५-७९", "content_sanskrit": "देवस्थाने तथाकाशे पर्वताग्रेषु सानुषु ।\nगह्वरेषु महारण्ये तयोर्युद्धमवर्तत॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000311079, "chapter_id": 20311, "verse_number": "१-६५-८०", "content_sanskrit": "पुष्कलादि घनानां च वर्षधारा जलं यथा ।\nपतंत्यस्त्राणि सैन्येषु शतशोथ सहस्रशः॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000311080, "chapter_id": 20311, "verse_number": "१-६५-८१", "content_sanskrit": "केचित्पेतुः पृथिव्यां तु शरैः संभिन्नविग्रहाः ।\nशक्तिभिर्मुसलैश्चान्ये छत्रशूलपरश्वधैः॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000311081, "chapter_id": 20311, "verse_number": "१-६५-८२", "content_sanskrit": "पतिताः संमुखे शूरा युद्धेषु न्यायवर्तिनः ।\nगच्छंति सुरसद्मानि स्वाम्यर्थे ये त्वभीरवः॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000311082, "chapter_id": 20311, "verse_number": "१-६५-८३", "content_sanskrit": "ये चान्ये कातराः पापा हंतारो विमुखान्रणे ।\nअन्यायैर्ये च योद्धारस्ते यान्ति यममंदिरं॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000311083, "chapter_id": 20311, "verse_number": "१-६५-८४", "content_sanskrit": "त्रिदिवस्था गजारोहाः सैन्धवस्थास्तथापरान् ।\nरथस्थांश्च रथारोहाः पदगांश्च पदातयः॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000311084, "chapter_id": 20311, "verse_number": "१-६५-८५", "content_sanskrit": "परस्परं विनिघ्नंति शूरा युद्धाभिकांक्षिणः ।\nमुदिताः सत्वसंपन्ना धर्मिष्ठा बलसंवृताः॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000311085, "chapter_id": 20311, "verse_number": "१-६५-८६", "content_sanskrit": "केषांचिद्वाहवश्छिन्ना मुसलैर्भिन्नमस्तकाः ।\nकेशाश्शिरांसि वस्त्राणि निपेतुर्धरणीतले॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000311086, "chapter_id": 20311, "verse_number": "१-६५-८७", "content_sanskrit": "मध्यच्छिन्नास्तथा भिन्नाः पेतुरुर्व्यां महाबलाः ।\nखड्गपातैस्तथा चोग्रैश्छ्रिन्नभिन्नाः परश्वधैः॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000311087, "chapter_id": 20311, "verse_number": "१-६५-८८", "content_sanskrit": "गामेव पतिता धीरा दिव्यालंकारभूषिताः ।\nप्रदीप्तोभूद्धरादेशो वीरैर्नागैर्हयै रथैः॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000311088, "chapter_id": 20311, "verse_number": "१-६५-८९", "content_sanskrit": "विविधाभरणैर्नष्टैः पताकाभिश्च केतुभिः ।\nततो वसुंधरा सर्वा सशैलवनकानना॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000311089, "chapter_id": 20311, "verse_number": "१-६५-९०", "content_sanskrit": "रुधिरौघप्लुता तत्र विबुधासुरयोर्युधि ।\nक्रव्यादैर्बहुभिस्तत्र खादितो द्रव्यसंचयः॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000311090, "chapter_id": 20311, "verse_number": "१-६५-९१", "content_sanskrit": "लोहितं प्रचुरं पीतं रक्षोभिश्च वृकादिभिः ।\nअन्यैर्महागणैरेव क्षतजं पवनान्वितम्॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000311091, "chapter_id": 20311, "verse_number": "१-६५-९२", "content_sanskrit": "खादितं प्रीतिमद्भिश्च फेरुगृध्रगणैर्मुदा ।\nएतस्मिन्नंतरे सूरिः सुरपूज्यो बृहस्पतिः॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000311092, "chapter_id": 20311, "verse_number": "१-६५-९३", "content_sanskrit": "मृतसंजीवनीविद्यां सुराणां संजजाप ह ।\nविशल्यकरणीं दिव्यां ब्रह्मविद्यां महाबलां॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000311093, "chapter_id": 20311, "verse_number": "१-६५-९४", "content_sanskrit": "ततो धन्वंतरिर्विद्वान्सुरवैद्यो मनोजवः ।\nऔषधैस्तत्प्रयोगैश्च रणे पर्यटते मुदा॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000311094, "chapter_id": 20311, "verse_number": "१-६५-९५", "content_sanskrit": "तत्र देवाश्च जीवंति ये मृताश्च महाहवे ।\nअव्रणा बलसंपन्नाः प्रयुध्यंति भृशं पुनः॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000311095, "chapter_id": 20311, "verse_number": "१-६५-९६", "content_sanskrit": "एवं शतसहस्रं तु गणं दैत्यस्य चोद्धतम् ।\nपतितं पुण्ययोगाच्च शरैर्निर्भिन्नकंधरम्॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000311096, "chapter_id": 20311, "verse_number": "१-६५-९७", "content_sanskrit": "ततस्तु जयशब्देन नंदंति सिद्धचारणाः ।\nऋषयः खेचराश्चान्ये ये चैवाप्सरसां गणाः॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000311097, "chapter_id": 20311, "verse_number": "१-६५-९८", "content_sanskrit": "गीतिं गायंति गंधर्वाः शशंसुः परमर्षयः ।\nअथ क्रुद्धो महातेजा दैत्यमुख्यो महाबलः॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000311098, "chapter_id": 20311, "verse_number": "१-६५-९९", "content_sanskrit": "कालकेय इति ख्यातः सेनानीर्दैत्यपस्य च ।\nस्यन्दनस्थो महावीर्यो धनुरादाय तत्र च॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000311099, "chapter_id": 20311, "verse_number": "१-६५-१००", "content_sanskrit": "जघान सुरसंघांस्तान्नर्तयामास भूतले ।\nनिरंतरशरौघेण च्छादितं गगनं तदा॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000311100, "chapter_id": 20311, "verse_number": "१-६५-१०१", "content_sanskrit": "निपतंति शराः सैन्ये कोटिकोटि सहस्रशः ।\nनिपतंति ततो देवाः संयुगेष्वनिवर्तिनः॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000311101, "chapter_id": 20311, "verse_number": "१-६५-१०२", "content_sanskrit": "रुधिरोद्गारिणस्सर्वे सिद्धगंधर्वकिन्नराः ।\nविशिखैः पीडिता देवा निपेतुर्धरणीतले॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000311102, "chapter_id": 20311, "verse_number": "१-६५-१०३", "content_sanskrit": "केचिच्छरशतैर्भिन्नास्सहस्रैरयुतैस्तथा ।\nपेतुरुर्व्यां महावीर्या ये रणे सुरपुंगवाः॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000311103, "chapter_id": 20311, "verse_number": "१-६५-१०४", "content_sanskrit": "व्यथिताश्चाभवन्सर्वे स्यंदनस्था दिवौकसः ।\nशरैः प्रव्यथितास्ते तु स्थातुं शक्ता न संमुखे॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000311104, "chapter_id": 20311, "verse_number": "१-६५-१०५", "content_sanskrit": "तेनावगाहितं सैन्यं गजेनेव सरोवनम् ।\nशरैस्तस्यार्दिता देवा वज्रानलसमप्रभैः॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000311105, "chapter_id": 20311, "verse_number": "१-६५-१०६", "content_sanskrit": "न शेकुः समरे स्थातुं मघवंतं ययुस्तदा ।\nचित्ररथ इति ख्यातो देवश्शस्त्रभृतां वरः॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000311106, "chapter_id": 20311, "verse_number": "१-६५-१०७", "content_sanskrit": "ययौ स्यंदनमारुह्य युद्धं प्रति धनुर्धरः ।\nअब्रवीद्वचनं सोपि सेनान्यं तु महासुरम्॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000311107, "chapter_id": 20311, "verse_number": "१-६५-१०८", "content_sanskrit": "यथा हंसि महाशूर सुरसेनां मुदान्वितः ।\nस त्वं प्रशंसनीयश्च शूरोसि सुरसंमतः॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000311108, "chapter_id": 20311, "verse_number": "१-६५-१०९", "content_sanskrit": "हिरण्याक्षप्रियं कर्म कृतं युद्धे त्वयाधुना ।\nइदानीं मम बाणैश्च गच्छस्व यममंदिरम्॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000311109, "chapter_id": 20311, "verse_number": "१-६५-११०", "content_sanskrit": "ततश्च कालकेयस्तु स्मितो वचनमब्रवीत् ।\nपुरैव विजितो देव गणः सर्वः प्रलीलया॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000311110, "chapter_id": 20311, "verse_number": "१-६५-१११", "content_sanskrit": "इदानीं तु स्थितं युद्धे बलं सर्वं तु हेलया ।\nयदि ते निधने प्रीतिरस्तीह सुरपुंगव॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000311111, "chapter_id": 20311, "verse_number": "१-६५-११२", "content_sanskrit": "एभिस्त्वां निशितैर्बाणैर्नयामि यममंदिरम् ।\nइत्युक्त्वा परमक्रुद्धो बाणमंतकसन्निभम्॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000311112, "chapter_id": 20311, "verse_number": "१-६५-११३", "content_sanskrit": "जघान समरे वीरस्त्रिभिश्चिच्छेद सोंबरे ।\nपुनर्बाणांश्च समरे योजयित्वा द्रुतं रुषा॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000311113, "chapter_id": 20311, "verse_number": "१-६५-११४", "content_sanskrit": "जघान प्रचुरान्दैत्यांस्तांश्चकर्त्त स लाघवात् ।\nततोन्योन्यं शरैस्तीक्ष्णैः कालानलसमप्रभैः॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000311114, "chapter_id": 20311, "verse_number": "१-६५-११५", "content_sanskrit": "युद्धे धनुष्मतां श्रेष्ठश्चिच्छेद भुवि वेगतः ।\nतद्युद्धमभवद्देवदैत्ययोर्धर्मतो भृशम्॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000311115, "chapter_id": 20311, "verse_number": "१-६५-११६", "content_sanskrit": "द्रष्टुकामागताः पार्श्वमृषि देवाः सुरोरगाः ।\nएवं शतसहस्राणि बाणानां विधृतानि च॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000311116, "chapter_id": 20311, "verse_number": "१-६५-११७", "content_sanskrit": "अन्योन्यं समरे वीरौ विजयाय विरेजतुः ।\nअथ क्रुद्धो महातेजा गंधर्वाणां पतिस्तदा॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7000311117, "chapter_id": 20311, "verse_number": "१-६५-११८", "content_sanskrit": "त्रिभिर्बिभेद बाणैश्च ललाटे हृदि पंचभिः ।\nसप्तभिर्जठरे नाभौ बस्तौ तस्य स पंचभिः॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7000311118, "chapter_id": 20311, "verse_number": "१-६५-११९", "content_sanskrit": "शरैः संपातितो दैत्यो मुग्धः कश्मलतां गतः ।\nशिथिलीकृतचापश्च लेभे संज्ञां चिराद्बली॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7000311119, "chapter_id": 20311, "verse_number": "१-६५-१२०", "content_sanskrit": "मधुसंज्ञं त्रिभिर्बाणैस्स बिभेद सुरोत्तमम् ।\nचकर्त्त धनुरस्त्रैश्च दैत्यराजस्य पश्यतः॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7000311120, "chapter_id": 20311, "verse_number": "१-६५-१२१", "content_sanskrit": "ततो बाणसहस्रैस्तु कालांतकसमप्रभैः ।\nबिभेद दैत्यसिंहं तु सुराणामुत्तमो बली॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7000311121, "chapter_id": 20311, "verse_number": "१-६५-१२२", "content_sanskrit": "हतचेताः स दैत्येंद्रो बहुशोणितसंस्रवः ।\nविह्वलो बहुबाणार्तः शूलं जग्राह दानवः॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7000311122, "chapter_id": 20311, "verse_number": "१-६५-१२३", "content_sanskrit": "शूलहस्तस्य तस्यैव चतुर्भिस्तुरगान्शरैः ।\nहत्वा च पातयामास त्रिभिर्यंतारमेव च॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7000311123, "chapter_id": 20311, "verse_number": "१-६५-१२४", "content_sanskrit": "जघान शूलमुर्वीष्ठस्ततो गंधर्वसत्तमम् ।\nविचकर्त्त त्रिभिर्बाणैः शूलं चित्ररथो बली॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7000311124, "chapter_id": 20311, "verse_number": "१-६५-१२५", "content_sanskrit": "शूलं च नष्टकं दृष्ट्वा हतभोगमिवोरगम् ।\nगृहीत्वा मुद्गरं घोरं प्रदुद्राव सुरं बली॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7000311125, "chapter_id": 20311, "verse_number": "१-६५-१२६", "content_sanskrit": "स मुद्गरं समायातं दैत्यसेनाधिपं तदा ।\nविचकर्त्त शिरो देहादर्धचंद्रेण संभ्रमात्॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7000311126, "chapter_id": 20311, "verse_number": "१-६५-१२७", "content_sanskrit": "स पपात महीपृष्ठे संचचाल वसुंधरा ।\nततो दैत्यगणाः सर्वे विमुखा विप्रदुद्रुवुः॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}]