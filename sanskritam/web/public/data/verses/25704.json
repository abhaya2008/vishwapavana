[{"id": 7005704000, "chapter_id": 25704, "verse_number": "१७७-१", "content_sanskrit": "मत्स्य उवाच ।\nदानवानामनीकेषु कालनेमिर्महासुरः ।\nविवर्द्धितमहातेजास्तपान्ते जलदो यथा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005704001, "chapter_id": 25704, "verse_number": "१७७-२", "content_sanskrit": "तं त्रैलोक्यान्तरगतं दृष्ट्वा ते दानवेश्वराः ।\nउत्तस्थुरपरिश्रान्ताः पीत्वामृतमनुत्तमम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005704002, "chapter_id": 25704, "verse_number": "१७७-३", "content_sanskrit": "ते वीतभयसन्त्रासा मयतारपुरोगमाः ।\nतारकामयसंग्रामे सततं जितकाशिनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005704003, "chapter_id": 25704, "verse_number": "१७७-४", "content_sanskrit": "रेजुरायोधनगता दानवाः युद्धकाङ्क्षिणः ।\nमन्त्रमभ्यसतान्तेषां व्यूहञ्च परिधावताम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005704004, "chapter_id": 25704, "verse_number": "१७७-५", "content_sanskrit": "प्रेक्षताञ्चाभवत् प्रीतिर्दानवं कालनेमिनम् ।\nये तु तत्र मयस्यासन् मुख्या युद्धपुरःसराः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005704005, "chapter_id": 25704, "verse_number": "१७७-६", "content_sanskrit": "ते तु सर्वे भयन्त्यक्त्वा हृष्टा योद्धुमुपस्थिताः ।\nमयस्तारो वराहश्च हयग्रीवश्च वीर्यवान् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005704006, "chapter_id": 25704, "verse_number": "१७७-७", "content_sanskrit": "विप्रचित्तिसुतः श्वेनः खरलम्बावुभावपि ।\nअरिष्टो बलिपुत्रश्च किशोराख्यस्तथैव च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005704007, "chapter_id": 25704, "verse_number": "१७७-८", "content_sanskrit": "स्वर्भानुश्चामर प्रख्यो वक्त्रयोधी महासुरः ।\nएतेऽस्त्रवेदिनः सर्वे सर्वे तपसि सुस्थिताः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005704008, "chapter_id": 25704, "verse_number": "१७७-९", "content_sanskrit": "दानवाः कृतिनो जग्मुः कालनेमिं तमुद्धतम् ।\nते गदाभिर्भुशुण्डीभिश्चक्रैरथ परश्वधैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005704009, "chapter_id": 25704, "verse_number": "१७७-१०", "content_sanskrit": "कालकल्पैश्च मुसलैः क्षेपणीयैश्च मुद्गरैः ।\nअश्मभिश्चाद्रिसदृशैः गण्डशैलैश्च दारुणैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005704010, "chapter_id": 25704, "verse_number": "१७७-११", "content_sanskrit": "पट्टिशैर्भिन्दिपालैश्च परिघैश्चोत्तमायसैः ।\nघातनीभिः सुगुर्वीभिः शतघ्नीभिस्तथैव च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005704011, "chapter_id": 25704, "verse_number": "१७७-१२", "content_sanskrit": "युगैर्यन्त्रैश्च निर्मुक्तैर्मार्गणैरुग्रताडितैः ।\nदौर्भिश्चायतदीप्तैश्च प्रासैः पाशैश्च मूर्च्छनैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005704012, "chapter_id": 25704, "verse_number": "१७७-१३", "content_sanskrit": "भुजङ्गवक्त्रैर्लेलिहानैर्विसर्पद्भिश्च सायकैः ।\nवज्रैः प्रहरणीयैश्च दीव्यमानैश्च तोमरैः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005704013, "chapter_id": 25704, "verse_number": "१७७-१४", "content_sanskrit": "विकोशैरसिभिस्तीक्ष्णैः शूलैश्च शितनिर्मलैः ।\nदैत्याः संदीप्तमनसः प्रगृहीतशरासनाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005704014, "chapter_id": 25704, "verse_number": "१७७-१५", "content_sanskrit": "ततः पुरस्कृत्य तदा कालनेमिं महाहवे ।\nसा दीप्तशस्तप्रवरा दैत्यानां रुरुचे चमूः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005704015, "chapter_id": 25704, "verse_number": "१७७-१६", "content_sanskrit": "द्यौर्निमीलितसर्वाङ्ग घना नीलाम्बुदागमे ।\nदेवतानामपि चमूः मुमुदे शक्रपालिता ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005704016, "chapter_id": 25704, "verse_number": "१७७-१७", "content_sanskrit": "उपेता सितकृष्णाभ्यां ताराभ्यां चन्द्रसूर्ययोः ।\nवायुवेगवती सौम्या तारागणपताकिनी ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005704017, "chapter_id": 25704, "verse_number": "१७७-१८", "content_sanskrit": "तोयदाविद्धवसना ग्रहनक्षत्रहासिनी ।\nयमेन्द्रवरुणैर्गुप्ता धनदेव च धीमता ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005704018, "chapter_id": 25704, "verse_number": "१७७-१९", "content_sanskrit": "सम्प्रदीप्ताग्नि नयना नारायण परायणा ।\nसा समुद्रौघसदृशी दिव्या देवमहाचमूः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005704019, "chapter_id": 25704, "verse_number": "१७७-२०", "content_sanskrit": "रराजास्त्रवती भीमा यक्षगन्धर्व शालिनी ।\nतयोश्चम्वोस्तदानीन्तु बभूव स समागमः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005704020, "chapter_id": 25704, "verse_number": "१७७-२१", "content_sanskrit": "द्यावापृथिव्योः संयोगो यथा स्याद्युगपर्यये ।\nतद्युद्धमभवद् घोरं देवदानवसङ्कलम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005704021, "chapter_id": 25704, "verse_number": "१७७-२२", "content_sanskrit": "क्षमा पराक्रमपरं दर्पस्य विनयस्य च ।\nनिश्चक्रमुर्बलाभ्यान्तु भीमास्तत्र सुरासुराः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005704022, "chapter_id": 25704, "verse_number": "१७७-२३", "content_sanskrit": "पूर्वा पराभ्यां संरब्धाः सागराभ्यामिवाम्बुदाः ।\nताभ्यां बलाभ्यां संदृष्टाश्चेरुस्ते देवदानवाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005704023, "chapter_id": 25704, "verse_number": "१७७-२४", "content_sanskrit": "वनाभ्यां पार्वतीयाभ्यां पुष्पिताभ्यां यथा गजाः ।\nसमाजघ्नुस्ततोभेरीः शङ्खान्दध्मुरनेकशः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005704024, "chapter_id": 25704, "verse_number": "१७७-२५", "content_sanskrit": "स शब्दोद्यां भुवं खञ्च दिशश्च समपूरयत् ।\nज्याघात तलनिर्घोषो धनुषां कूजितानि च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005704025, "chapter_id": 25704, "verse_number": "१७७-२६", "content_sanskrit": "दुन्दुभीनाञ्च निनदो दैत्यमन्तर्दधुः स्वनम् ।\nतेऽन्योन्यमभिसम्पेतुः पातयन्तः परस्परम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005704026, "chapter_id": 25704, "verse_number": "१७७-२७", "content_sanskrit": "बभञ्जुर्बाहुभिर्बाहून् द्वन्द्वमन्ये युयुत्सवः ।\nदेवास्तु चाशनिं घोरं परिघांश्चोत्तमायसान् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005704027, "chapter_id": 25704, "verse_number": "१७७-२८", "content_sanskrit": "निस्त्रिंशान् ससृजुः संख्ये गदागुर्वीश्च दानवाः ।\nगदानिपातैर्भग्नाङ्गा बाणैश्च शकलीकृताः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005704028, "chapter_id": 25704, "verse_number": "१७७-२९", "content_sanskrit": "परिपेतुर्भृशं केचित् पुनः केचित्तु जघ्निरे ।\nततो रथैः सतुरगैः र्विमानैश्चाशुगामिभिः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005704029, "chapter_id": 25704, "verse_number": "१७७-३०", "content_sanskrit": "समीयुस्ते सुसंरब्धा रोषादन्योन्यमाहवे ।\nसंवर्तमानाः समरे सन्दष्टौष्ठ पुटाननाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005704030, "chapter_id": 25704, "verse_number": "१७७-३१", "content_sanskrit": "रथारथैर्निरुध्यन्ते पादाताश्च पदातिभिः ।\nतेषां रथानान्तुमुलः स शब्दः शब्दवाहिनाम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005704031, "chapter_id": 25704, "verse_number": "१७७-३२", "content_sanskrit": "नभोनभश्च हि यथा नभस्यैर्जलदस्वनैः ।\nबभञ्जुस्तु रथान् केचित् केचित् सम्पाटितारथैः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005704032, "chapter_id": 25704, "verse_number": "१७७-३३", "content_sanskrit": "सम्बाधमन्ये सम्प्राप्य न शेकुश्चलितुं रथान् ।\nअन्योन्यमन्ये समरे दोर्भ्यामुत्क्षिप्य दंशिताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005704033, "chapter_id": 25704, "verse_number": "१७७-३४", "content_sanskrit": "संह्रादमानाभरणा जघ्नुस्तत्रापि चर्मिणः ।\nअस्त्रैरन्ये विनिर्भिन्ना वेमू रक्तं हतायुधि ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005704034, "chapter_id": 25704, "verse_number": "१७७-३५", "content_sanskrit": "क्षरज्जलानां सदृशाः जलदानां समागमे ।\nतैरस्त्रशस्त्रग्रथितं क्षिप्तोत्क्षिप्तगदाविलम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005704035, "chapter_id": 25704, "verse_number": "१७७-३६", "content_sanskrit": "देवदानव संक्षुब्धं सङ्कुलं युद्धमाबभौ ।\nतद्दानव महामेघं देवायुध विराजितम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005704036, "chapter_id": 25704, "verse_number": "१७७-३७", "content_sanskrit": "अन्योन्यबाणवर्षेण युद्धदुर्दिनमाबभौ ।\nएतस्मिन्नन्तरे क्रुद्धः कालनेमिः स दानवः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005704037, "chapter_id": 25704, "verse_number": "१७७-३८", "content_sanskrit": "व्यवर्धत समुद्रौघैः पूर्यमाण इवाम्बुदः ।\nतस्य विद्युच्चलापीडैः प्रदीप्त शनिवर्षिणः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005704038, "chapter_id": 25704, "verse_number": "१७७-३९", "content_sanskrit": "गात्रैर्नागगिरिप्रख्या विनिपेतुर्बलाहकाः ।\nक्रोधान्निश्वसतस्तस्य भ्रूभेद स्वेदवर्षिणः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005704039, "chapter_id": 25704, "verse_number": "१७७-४०", "content_sanskrit": "साग्निस्फुलिङ्गप्रतता मुखान्निष्पेतुरर्चिषः ।\nतिर्यगूर्ध्वञ्च गगने ववृधुस्तस्य बाहवः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005704040, "chapter_id": 25704, "verse_number": "१७७-४१", "content_sanskrit": "पर्वतादिव निष्क्रान्ताः पञ्चास्या इव पन्नगाः ।\nसोऽस्त्रजालैर्बहुविधैर्धनुभिः परिघैरपि ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005704041, "chapter_id": 25704, "verse_number": "१७७-४२", "content_sanskrit": "दिव्यमाकाशमावव्रे पर्वतैरुच्छ्रितैरिव ।\nसोऽनिलोद्धूतवसनस्तस्थौ संग्रामलालसः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005704042, "chapter_id": 25704, "verse_number": "१७७-४३", "content_sanskrit": "सन्ध्या तपग्रस्तशिलः साक्षान्मेरुरिवाचलः ।\nऊरुवेग प्रमथितैः शैलश्रृङ्गाग्र पादपैः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005704043, "chapter_id": 25704, "verse_number": "१७७-४४", "content_sanskrit": "अपातयद् देवगणान् वज्रेणेव महागिरीन् ।\nबहुभिः शस्त्रनिस्त्रिंश्छिन्नभिन्न शिरोरुहाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005704044, "chapter_id": 25704, "verse_number": "१७७-४५", "content_sanskrit": "न शेकुश्चलितुं देवाः कालनेमिहता युधि ।\nमुष्टिभिर्निहताः केचित् केचित्तु विदलीकृताः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005704045, "chapter_id": 25704, "verse_number": "१७७-४६", "content_sanskrit": "यक्षगन्धर्व पतयः पेतुः सह महोरगैः ।\nतेन वित्रासिता देवाः समरे कालनेमिना ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005704046, "chapter_id": 25704, "verse_number": "१७७-४७", "content_sanskrit": "न शेकुर्यत्नवन्तोऽपि यत्नं कर्तुं विचेतसः ।\nतेन शक्रः सहस्राक्षः स्पन्दितः शरबन्धनैः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005704047, "chapter_id": 25704, "verse_number": "१७७-४८", "content_sanskrit": "ऐरावतगतः संख्ये चलितुं न शशाक ह ।\nनिर्जलाम्भोद सदृशो निर्जलार्णव सप्रभः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005704048, "chapter_id": 25704, "verse_number": "१७७-४९", "content_sanskrit": "निर्व्यापारः कृतस्तेन विपाशो वरुणो मृधे ।\nरणो वैश्रवणस्तेन परिघैः कामरूपिणा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005704049, "chapter_id": 25704, "verse_number": "१७७-५०", "content_sanskrit": "वित्तदोऽपि कृतः संख्ये निर्जितः कालनेमिना ।\nयमः सर्वहरस्तेन मृत्युप्रहरणे रणे ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005704050, "chapter_id": 25704, "verse_number": "१७७-५१", "content_sanskrit": "याम्यामवस्थां सन्त्यज्य भीतः स्वन्दिशमाविशत् ।\nस लोकपालानुत्सार्य कृत्वा तेषाञ्च कर्म्म तत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005704051, "chapter_id": 25704, "verse_number": "१७७-५२", "content_sanskrit": "दिक्षु सर्वासु देहं स्वं चतुर्धा विदधे तदा ।\nस नक्षत्र पथड्गत्वा दिव्यं स्वर्भानुदर्शनम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005704052, "chapter_id": 25704, "verse_number": "१७७-५३", "content_sanskrit": "जहार लक्ष्मीं सोमस्य तं चास्य विषयं महत् ।\nचालयामास दीप्ताशं स्वर्गद्वारात् स भास्करम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005704053, "chapter_id": 25704, "verse_number": "१७७-५४", "content_sanskrit": "सायनञ्चास्य विषयं जहार दिनकर्म्म च ।\nसोऽग्ने देवमुखं दृष्ट्वा चकारात्म मुखाश्रयम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005704054, "chapter_id": 25704, "verse_number": "१७७-५५", "content_sanskrit": "वायुञ्च तरसा जित्वा चकारात्म वशानुगम् ।\nस समुद्रान् समानीय सर्वाश्च सरितो बलात् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005704055, "chapter_id": 25704, "verse_number": "१७७-५६", "content_sanskrit": "चकारात्ममुखे वीर्याद्देहभूताश्च सिन्धवः ।\nअपः स्ववशगाः कृत्वा दिविजा याश्च भूमिजाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005704056, "chapter_id": 25704, "verse_number": "१७७-५७", "content_sanskrit": "स स्वयम्भुवि वा भाति महाभूत पतिर्यथा ।\nसर्वलोकमयो दैत्यः सर्वभूत भयावहः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005704057, "chapter_id": 25704, "verse_number": "१७७-५८", "content_sanskrit": "स लोकपालैकवपुश्चन्द्रादित्य ग्रहात्मवान् ।\nस्तापयामास जगतीं सुगुप्तां धरणीधरैः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005704058, "chapter_id": 25704, "verse_number": "१७७-५९", "content_sanskrit": "पावकानिलसम्पातो रराज युधि दानवः ।\nपारमेष्ठ्ये स्थितः स्थाने लोकानां प्रभवोपमे  ।\nतं तुष्टुवुर्दैत्यगणा देवा इव पितामहम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]