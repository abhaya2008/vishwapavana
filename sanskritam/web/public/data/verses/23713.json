[{"id": 7003713000, "chapter_id": 23713, "verse_number": "१-४-२१-१", "content_sanskrit": "नंदिकेश्वर उवाच ।\nतदा ब्रह्मा सरस्वत्या महाविष्णुश्च पद्मया ।\nशक्रः पुलोमसुतया परे दिक्पालका अपि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003713001, "chapter_id": 23713, "verse_number": "१-४-२१-२", "content_sanskrit": "गंधर्वाप्सरसां संघा वसवोऽपि सुरा अपि ।\nत्रयस्त्रिंशत्कोटिगणाः परे मुनि गणा अपि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003713002, "chapter_id": 23713, "verse_number": "१-४-२१-३", "content_sanskrit": "एकादशमहारुद्रा आदित्या द्वादशापि च ।\nभैरवाश्च पिशाचाश्च वेतालाः कटपूतनाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003713003, "chapter_id": 23713, "verse_number": "१-४-२१-४", "content_sanskrit": "यक्षरक्षोरगा भूता ये चान्ये शिवकिंकराः ।\nसंतोषभाजः सर्वेऽपि विकटाकारवेष्टिताः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003713004, "chapter_id": 23713, "verse_number": "१-४-२१-५", "content_sanskrit": "परिवार्य महेशानं समाजग्मुः सहस्रशः ।\nतद्वीराशंसनं दृष्ट्वा योगिनीदानवैः कृतम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003713005, "chapter_id": 23713, "verse_number": "१-४-२१-६", "content_sanskrit": "अतीव विस्मयं भेजुः सर्वे कल्पांतभीषणम् ।\nकृतसांनिध्यमालोक्य देवमानंदयंत्युमा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003713006, "chapter_id": 23713, "verse_number": "१-४-२१-७", "content_sanskrit": "चिररात्रप्ररूढां च तद्वियोगव्यथां जहौ ।\nरोमांचिता स्विन्नमुखी वेपमाना घनस्तनी ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003713007, "chapter_id": 23713, "verse_number": "१-४-२१-८", "content_sanskrit": "पादांगुलीषु नयने विनिवेशयति स्म सा ।\nवृषभादवरुह्याथ गृहीत्वैनां करे शिवः ।\nस्मितशरीरकंठश्रीप्रणयेनैवमब्रवीत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003713008, "chapter_id": 23713, "verse_number": "१-४-२१-९", "content_sanskrit": "शिव उवाच ।\nव्याकुलीक्रियते देवि किमेवं कारणं विना ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003713009, "chapter_id": 23713, "verse_number": "१-४-२१-१०", "content_sanskrit": "सर्वैराराधनीयेति मयापि घटितोंजलिः ।\nकिं न वेत्स्यावयोरैक्यं ज्योत्स्नाचंद्रमसोरिव ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003713010, "chapter_id": 23713, "verse_number": "१-४-२१-११", "content_sanskrit": "अनादिसिद्धं देवेशि तवेदं मौग्ध्यमीदृशम् ।\nक्वेदं शिरीषमृद्वंगि शरीरं ते गिरीन्द्रजे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003713011, "chapter_id": 23713, "verse_number": "१-४-२१-१२", "content_sanskrit": "तपः समाधयश्चेति क्व कर्कशजनोचिताः ।\nनारायणोहं लक्ष्मीस्त्वं ब्रह्मास्मि त्वं सरस्वती ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003713012, "chapter_id": 23713, "verse_number": "१-४-२१-१३", "content_sanskrit": "वारुणी त्वं फणींद्रोहं रोहिणी त्वमहं शशी ।\nस्वाहा त्वं हव्यवाहोऽहं सूर्योऽहं त्वं सुवर्चला ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003713013, "chapter_id": 23713, "verse_number": "१-४-२१-१४", "content_sanskrit": "जाह्नवी त्वं समुद्रोऽहं मेरुरस्मि त्वमुर्वरा ।\nपुलोमजा त्वं शक्रोहं त्वं रतिश्चित्तभूरहम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003713014, "chapter_id": 23713, "verse_number": "१-४-२१-१५", "content_sanskrit": "बुद्धिस्त्वं राजराजोहं त्वं शमाऽहं समीरण ।\nपाथोधिपोऽहं वीचिस्त्वं प्रकृतिस्त्वं पुमानहम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003713015, "chapter_id": 23713, "verse_number": "१-४-२१-१६", "content_sanskrit": "विद्या त्वं वेदितव्योऽहं वाक्त्वमर्थोपि पार्वती ।\nईश्वरोऽहं मदंशासि त्वयैवाज्ञास्वरूपया ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003713016, "chapter_id": 23713, "verse_number": "१-४-२१-१७", "content_sanskrit": "सृष्टि स्थित्युपसंहारविधानानुग्रहेश्वरे ।\nन भेदोऽतस्त्वया कार्यः पृथग्जनवदावयोः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003713017, "chapter_id": 23713, "verse_number": "१-४-२१-१८", "content_sanskrit": "चित्प्रकाशात्मनोर्देवि स्वेच्छाधृतशरीरया ।\nव्याकुलीकुरुषे शश्वद्वृथैवेर्ष्यायसे हि माम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003713018, "chapter_id": 23713, "verse_number": "१-४-२१-१९", "content_sanskrit": "दृष्टाप्रतिक्रिया तस्य क्रियते याधुना मया ।\nइत्युक्त्वेशो निषण्णस्तां पार्श्वदेशे न्यवेशयत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003713019, "chapter_id": 23713, "verse_number": "१-४-२१-२०", "content_sanskrit": "गौरीं स्वकीय एवांगे गूहमानामिव ह्रिया ।\nअंगद्वयं तयोरैक्यमगात्प्रेम्णा च लीनयोः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003713020, "chapter_id": 23713, "verse_number": "१-४-२१-२१", "content_sanskrit": "अर्थद्वयमिवाह्नाय संनिकर्षोपलंभतः ।\nअर्धे कर्पूरधवलमर्धे सिंधूरपाटलम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003713021, "chapter_id": 23713, "verse_number": "१-४-२१-२२", "content_sanskrit": "तद्विचित्रमभूदंगं शिवयोरेकतां गतम् ।\nअर्धे कुंतलदामार्धहारमध्ये तु कुंचिका ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003713022, "chapter_id": 23713, "verse_number": "१-४-२१-२३", "content_sanskrit": "अंगादर्धेंदुचूडस्य वपुरर्धेन्दुकूलितम् ।\nएकनूपुरताटंकपरिहार्यमनोहरम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003713023, "chapter_id": 23713, "verse_number": "१-४-२१-२४", "content_sanskrit": "एकपिंगलसध्रीचो गात्रमेकस्तनं बभौ ।\nदेव्यै दत्त्वा च धामार्थं वामदेवो जगाद ताम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003713024, "chapter_id": 23713, "verse_number": "१-४-२१-२५", "content_sanskrit": "अवकाशो रुषो देवि मा भूरतः परं तव ।\nस्तन्यार्थिनं गुहं हित्वा यातासि तपसे यतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003713025, "chapter_id": 23713, "verse_number": "१-४-२१-२६", "content_sanskrit": "तदपीतस्तनीनाम्ना निवसात्र ममांतिके ।\nत्वामपीतस्तनीं देवीं शोणाद्रीशं च मामपि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003713026, "chapter_id": 23713, "verse_number": "१-४-२१-२७", "content_sanskrit": "जनाः सर्वे समाराध्य रमंतां भोगमोक्षयोः ।\nइयं त्वदंशजा देवी दुर्गा महिषसूदिनी ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003713027, "chapter_id": 23713, "verse_number": "१-४-२१-२८", "content_sanskrit": "अत्रैव सन्निधत्तां तु मंत्रसिद्धिप्रदा नृणाम् ।\nखड्गतीर्थमिदं पुण्यं सकृदेव निमज्जनात् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003713028, "chapter_id": 23713, "verse_number": "१-४-२१-२९", "content_sanskrit": "सर्वरोगहरं पुंसामस्तु सर्वाघनाशनम् ।\nप्रवालगिरिनाथश्च देवोऽयं पापनाशनः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003713029, "chapter_id": 23713, "verse_number": "१-४-२१-३०", "content_sanskrit": "भक्तिश्रद्धावतां नॄणां भूयास्तां भूतये भृशम् ।\nअयं च गौतमो देवि त्वदनुग्रहभाजनम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003713030, "chapter_id": 23713, "verse_number": "१-४-२१-३१", "content_sanskrit": "तपोनुरूपं भजतां लोकेष्वाचंद्रतारकम् ।\nइमाश्च मातरः सप्त सप्तलोकैकमातरः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003713031, "chapter_id": 23713, "verse_number": "१-४-२१-३२", "content_sanskrit": "अद्यप्रभृति कुर्वंतु सान्निध्यं जगतां श्रियै ।\nशास्तारो भैरवाः क्षेत्रपालका बटुका अपि ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003713032, "chapter_id": 23713, "verse_number": "१-४-२१-३३", "content_sanskrit": "अरुणक्षेत्र एवात्र नित्यं कुर्वंतु संनिधिम् ।\nअत्राहमरुणक्षेत्रे निवसाम्यरुणाह्वयः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003713033, "chapter_id": 23713, "verse_number": "१-४-२१-३४", "content_sanskrit": "त्वयाप्यरुणया देव्या स्थातव्यं करुणार्द्रया ।\nईप्सिनामरुणादेवौ सान्निध्यं कुरुतो यतः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003713034, "chapter_id": 23713, "verse_number": "१-४-२१-३५", "content_sanskrit": "तदस्मिन्नरुणक्षेत्रे सुलभाः सर्वसिद्धयः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003713035, "chapter_id": 23713, "verse_number": "१-४-२१-३६", "content_sanskrit": "इदं कृतं पर्वतराजपुत्र्या प्रसादनं शोणगिरीश्वरस्य ।\nशृणोति यः स द्विषतो विधूय स्वर्गापवर्गौ सुलभावुपेयात् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003713036, "chapter_id": 23713, "verse_number": "१-४-२१-३७", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्डेऽरुणाचलमाहात्म्य उत्तरार्धे शिवकृतपार्वतीप्रशंसावर्णनंनामैकविंशतितमोऽध्यायः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]