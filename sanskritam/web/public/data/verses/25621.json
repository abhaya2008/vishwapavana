[{"id": 7005621000, "chapter_id": 25621, "verse_number": "९४-१", "content_sanskrit": "नवग्रहस्वरूपवर्णनम् ।\nशिव उवाच ।\nपद्मासनः पद्मकरः पद्मगर्भसमद्युति ।\nसप्ताश्वः सप्तरज्जुश्च द्विभुजः स्यात् सदा रविः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005621001, "chapter_id": 25621, "verse_number": "९४-२", "content_sanskrit": "श्वेतः श्वेताम्वरधरः श्वेताश्वः श्वेतवाहनः ।\nगदापाणिर्द्विबाहुश्च कर्तव्यो वरदः शशी ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005621002, "chapter_id": 25621, "verse_number": "९४-३", "content_sanskrit": "रक्तमाल्याम्बरधरः शक्तिशूलगदाधरः ।\nचतुर्भुजः श्वेतरोमा वरदः स्याद्वरासुतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005621003, "chapter_id": 25621, "verse_number": "९४-४", "content_sanskrit": "पीतमाल्याम्बधरःकर्णिकारसमद्युतिः ।\nखङ्गचर्म्मगदापाणिः सिंहस्थो वरदो बुधः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005621004, "chapter_id": 25621, "verse_number": "९४-५", "content_sanskrit": "देवदैत्यगुरू तद्वत्पीतश्वेतो चतुर्भुजौ ।\nदण्डिनौ वरदौ कार्यौ साक्षसूत्रकमण्डलू ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005621005, "chapter_id": 25621, "verse_number": "९४-६", "content_sanskrit": "इन्द्रनीलद्युतिः शूली वरदो गृध्रवाहनः ।\nबाणबाणासनधरः कर्तव्योऽर्कसुतस्तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005621006, "chapter_id": 25621, "verse_number": "९४-७", "content_sanskrit": "नीलसिंहासनस्थश्च राहुरत्र प्रशस्यते ।\nध्रूम्रा द्विबाहवः सर्वे गदिनो विकृताननाः ।\nगृध्रासनगता नित्यं केतवः स्युर्वरप्रदाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005621007, "chapter_id": 25621, "verse_number": "९४-८", "content_sanskrit": "सर्वे किरीटिनः कार्य्या ग्रहलोकहितावहाः ।\nह्यङ्गुलेनोच्छ्रिताः सर्वे शतमष्टोत्तरं सदा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}]