[{"id": 2042944, "chapter_id": 1960, "verse_number": "६-९-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042945, "chapter_id": 1960, "verse_number": "६-९-१", "content_sanskrit": "यदिदं भारतं वर्षं यत्रेदं मूर्च्छितं बलम्।\nयत्रातिमात्रलुब्धोऽयं पुत्रो दुर्योधनो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042946, "chapter_id": 1960, "verse_number": "६-९-२", "content_sanskrit": "यत्र गृद्धा पाण्डुपुत्रा यत्र मे सञ्जते मनः।\nएतन्मे तत्त्वमाचक्ष्व त्वं हि मे बुद्धिमान्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042947, "chapter_id": 1960, "verse_number": "६-९-३x", "content_sanskrit": "संजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042948, "chapter_id": 1960, "verse_number": "६-९-३", "content_sanskrit": "न तत्र पाण्डवा गृद्धाः शृणु राजन्वचो मम।\nगृद्धो दुर्योधनस्तत्र शकुनिश्चापि सौबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042949, "chapter_id": 1960, "verse_number": "६-९-४", "content_sanskrit": "अपरे क्षत्रियाश्चैव नानाजनपदेश्वराः ।\nये गृद्धा भारते वर्षे न मृष्यन्ति परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042950, "chapter_id": 1960, "verse_number": "६-९-५", "content_sanskrit": "अत्र ते कीर्तयिष्यामि वर्षं भारत भारतम् ।\nप्रियमिन्द्रस्य देवस्य मनोर्वैवस्वतस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042951, "chapter_id": 1960, "verse_number": "६-९-६", "content_sanskrit": "पृथोस्तु राजन्वैन्यस्य तथेक्ष्वाकोर्महात्मनः ।\nययातेरम्बरीषस्य मान्धातुर्नहुषस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042952, "chapter_id": 1960, "verse_number": "६-९-७", "content_sanskrit": "तथैव मुचुकुन्दस्य शिबेरौशीनरस्य च।\nऋषभस्य तथैलस्य नृगस्य नृपतेस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042953, "chapter_id": 1960, "verse_number": "६-९-८", "content_sanskrit": "कुशिकस्य च दुर्धर्ष गाधेश्चैव महात्मनः ।\nसोमकस्य च दुर्धर्ष दिलीपस्य तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042954, "chapter_id": 1960, "verse_number": "६-९-९", "content_sanskrit": "अन्येषां च महाराज क्षत्रियाणां बलीयसाम् ।\nसर्वेषामेव राजेन्द्र प्रियं भारत भारतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042955, "chapter_id": 1960, "verse_number": "६-९-१०", "content_sanskrit": "तत्ते वर्षं प्रवक्ष्यामि यथायथमरिन्दम ।\nश्रृणु मे गदतो राजन्यन्मां त्वं परिपृच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042956, "chapter_id": 1960, "verse_number": "६-९-११", "content_sanskrit": "महेन्द्रो मलयः सह्यः शुक्तिमानृक्षवानपि ।\nविन्ध्यश्च पारियात्रश्च सप्तैते कुलपर्वताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042957, "chapter_id": 1960, "verse_number": "६-९-१२", "content_sanskrit": "तेषां सहस्रशो राजन्पर्वतास्ते समीपतः।\nअविज्ञाताः सारवन्तो विपुलाश्चित्रसानवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042958, "chapter_id": 1960, "verse_number": "६-९-१३", "content_sanskrit": "अन्ये ततोऽपरिज्ञाता ह्रस्वा ह्रस्वोपजीविनः।\nआर्या म्लेच्छाश्च कौरव्य तैर्मिश्राः पुरुषा विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042959, "chapter_id": 1960, "verse_number": "६-९-१४", "content_sanskrit": "नदीं पिबन्ति विपुलां गङ्गां सिन्धुं सरस्वतीम् ।\nगोदावरीं नर्मदां च बाहुदां च महानदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042960, "chapter_id": 1960, "verse_number": "६-९-१५", "content_sanskrit": "शतद्रूं चन्द्रभागां च यमुनां च महानदीम् ।\nदृषद्वतीं विपाशां च विपापां स्थूलवालुकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042961, "chapter_id": 1960, "verse_number": "६-९-१६", "content_sanskrit": "नदीं वेत्रवतीं चैव कृष्णवेणीं च निम्नगाम्।\nइरावतीं वितस्तां च पयोष्णीं देविकामपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042962, "chapter_id": 1960, "verse_number": "६-९-१७", "content_sanskrit": "वेदस्मृतां वेदवतीं त्रिदिवामिक्षुलां कृमिम्।\nकरीषिणीं चित्रवाहां चित्रसेनां च निम्नगाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042963, "chapter_id": 1960, "verse_number": "६-९-१८", "content_sanskrit": "गोमतीं धूतपापां च वन्दनां च महानदीम् ।\nकौशिकीं त्रिविदां कृत्यां निचितां लोहितारणीं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042964, "chapter_id": 1960, "verse_number": "६-९-१९", "content_sanskrit": "रहस्यां शतकुम्भां च सरयूं च तथैव च।\nचर्मण्वतीं वेत्रवतीं हस्तिसोमां दिशं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2042965, "chapter_id": 1960, "verse_number": "६-९-२०", "content_sanskrit": "शरावतीं पयोष्णीं च वेणां भीमरथीमपि ।\nकावेरीं चुलुकां चापि वाणीं शतबलामपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2042966, "chapter_id": 1960, "verse_number": "६-९-२१", "content_sanskrit": "नीवारामहितां चापि सुप्रयोगां जनाधिप ।\nपवित्रां कुण्डलीं सिन्धुं राजनीं पुरमालिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2042967, "chapter_id": 1960, "verse_number": "६-९-२२", "content_sanskrit": "पूर्वाभिरामां वीरां च भीमामोघवतीं तथा।\nपाशाशिनीं पापहरां महेन्द्रां पाटलावतीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2042968, "chapter_id": 1960, "verse_number": "६-९-२३", "content_sanskrit": "करीषिणीमसिक्नीं च कुशचीरां महानदीम् ।\nमकरीं प्रवरां मेनां हेमां घृतवतीं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2042969, "chapter_id": 1960, "verse_number": "६-९-२४", "content_sanskrit": "पुरावतीमनुष्णां च शैब्यां कापीं च भारत ।\nसदानीरामधृष्यां च कुशधारां महानदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2042970, "chapter_id": 1960, "verse_number": "६-९-२५", "content_sanskrit": "सदाकान्तां शिवां चैव तथा वीरवतीमपि।\nवस्त्रां सुवस्त्रां गौरीं च कम्पनां सहिरण्वतीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2042971, "chapter_id": 1960, "verse_number": "६-९-२६", "content_sanskrit": "वरां वीरकरां चापि पञ्चमीं च महानदीम् ।\nरथचित्रां ज्योतिरथां विश्वामित्रां कपिञ्जलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2042972, "chapter_id": 1960, "verse_number": "६-९-२७", "content_sanskrit": "उपेन्द्रां बहुलां चैव कुवीरामम्बुवाहिनीम् ।\nविनदीं पिञ्जलां वेणां तुङ्गवेणां महानदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2042973, "chapter_id": 1960, "verse_number": "६-९-२८", "content_sanskrit": "विदिशां कृष्णवेणां च ताम्रां च कपिलामपि।\nखलुं सुवामां वेदाश्वां हरिश्रावां महापगाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2042974, "chapter_id": 1960, "verse_number": "६-९-२९", "content_sanskrit": "शीघ्रां च पिच्छिलां चैव भारद्वाजीं च निम्नगाम्।\nकौशिकीं निम्नगां शोणा बाहुदामथ चन्द्रमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2042975, "chapter_id": 1960, "verse_number": "६-९-३०", "content_sanskrit": "दुर्गां चित्रशिलां चैव ब्रह्मवेध्यां बृहद्वतीम् ।\nयवक्षामथ रोहीं च तथा जाम्बूनदीमपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2042976, "chapter_id": 1960, "verse_number": "६-९-३१", "content_sanskrit": "सुनसां तमसां दासीं वसामन्यां वराणसीम् ।\nनीलां धृतवतीं चैव पर्णाशां च महानदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2042977, "chapter_id": 1960, "verse_number": "६-९-३२", "content_sanskrit": "मानवीं वृषभां चैव ब्रह्ममेध्यां बृहद्ध्वनीम्।\nएताश्चान्याश्च बहुधा महानद्यो जनाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2042978, "chapter_id": 1960, "verse_number": "६-९-३३", "content_sanskrit": "सदानिरामयां कृष्णां मन्दगां मन्दवाहिनीम् ।\nब्राह्मणीं च महागौरीं दुर्गामपि च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2042979, "chapter_id": 1960, "verse_number": "६-९-३४", "content_sanskrit": "चित्रोपलां चित्ररथां मञ्चुलां वाहिनीं तथा ।\nमन्दाकिनीं वैतरणीं कोषां चापि महानदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2042980, "chapter_id": 1960, "verse_number": "६-९-३५", "content_sanskrit": "शुक्तिमतीमनङ्गां च तथैव वृषसाह्वयाम् ।\nलोहित्यां करतोयां च तथैव वृषकाह्वयाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2042981, "chapter_id": 1960, "verse_number": "६-९-३६", "content_sanskrit": "कुमारीमृषिकुल्यां च मारिषां च सरस्वतीम्।\nमन्दाकिनीं सुपुण्यां च सर्वां गङ्गां च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2042982, "chapter_id": 1960, "verse_number": "६-९-३७", "content_sanskrit": "विश्वस्य मातरः सर्वाः सर्वाश्चैव महाफलाः।\nतथा नद्यस्त्वप्रकाशाः शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2042983, "chapter_id": 1960, "verse_number": "६-९-३८", "content_sanskrit": "इत्येताः सरितो राजन्समाख्याता यथास्मृति।\nअत ऊर्ध्वं जनपदान्निबोध गदतो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2042984, "chapter_id": 1960, "verse_number": "६-९-३९", "content_sanskrit": "तत्रेमे कुरुपाञ्चालाः शाल्वा माद्रेयजाङ्गलाः ।\nशूरसेनाः पुलिन्दाश्च बोधा मालास्तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2042985, "chapter_id": 1960, "verse_number": "६-९-४०", "content_sanskrit": "मत्स्याः कुशल्याः सौशल्याः कुंतयः कांतिकोसलाः ।\nचेदिमत्स्यकरूशाश्च भोजाः सिन्धुपुलिन्दकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2042986, "chapter_id": 1960, "verse_number": "६-९-४१", "content_sanskrit": "उत्तमाश्च दशार्णाश्च मेकलाश्चोत्कलैः सह ।\nपञ्चालाः कोसलाश्चैव नैकपृष्ठा धुरन्धराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2042987, "chapter_id": 1960, "verse_number": "६-९-४२", "content_sanskrit": "गोधा मद्रकलिङ्गाश्छ काशयोऽपरकाशयः ।\nजठराः कुकुराश्चैव सदशार्णाश्च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2042988, "chapter_id": 1960, "verse_number": "६-९-४३", "content_sanskrit": "कुन्तयोऽवन्तयश्चैव तथैवापरकुन्तयः ।\nगोमन्ता मन्दकाः सण्डा विदर्भा रूपवाहिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2042989, "chapter_id": 1960, "verse_number": "६-९-४४", "content_sanskrit": "अश्मकाः पाण्डुराष्ट्राश्च गोपराष्ट्राः करीतयः।\nअधिराज्यकुशाद्यश्च मल्लराष्ट्रं च केवलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2042990, "chapter_id": 1960, "verse_number": "६-९-४५", "content_sanskrit": "वारवास्यायवाहाश्च चक्राश्चक्रातयः शकाः।\nविदेहा मगधाः स्वक्षा मलजा विजयास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2042991, "chapter_id": 1960, "verse_number": "६-९-४६", "content_sanskrit": "अङ्गा वङ्गाः कलिङ्गाश्च यकृल्लोमान एव च।\nमल्लाः सुदेष्णाः प्रह्लादा माहिकाः शशिकास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2042992, "chapter_id": 1960, "verse_number": "६-९-४७", "content_sanskrit": "बाह्लीका वाटधानाश्च आभीराः कालतोयकाः।\nअपरान्ताः परान्ताश्च पञ्चालाश्चर्ममण्डलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2042993, "chapter_id": 1960, "verse_number": "६-९-४८", "content_sanskrit": "अटवीशिखराश्चैव मेरुभूताश्च मारिष ।\nउपावृत्तानुपावृत्ताः स्वराष्ट्राः केकयास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2042994, "chapter_id": 1960, "verse_number": "६-९-४९", "content_sanskrit": "कुन्दापरान्ता माहेयाः कक्षाः सामुद्रनिष्कुटाः ।\nअन्ध्राश्च बहवो राजन्नन्तर्गिर्यास्तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2042995, "chapter_id": 1960, "verse_number": "६-९-५०", "content_sanskrit": "बहिर्गिर्याङ्गमलजा मगधा मानवर्जकाः ।\nसमन्तराः प्रावृषेया भार्गवाश्च जनाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2042996, "chapter_id": 1960, "verse_number": "६-९-५१", "content_sanskrit": "पुण्ड्रा भर्गाः किराताश्च सुदृष्टा यामुनास्तथा।\nशका निषादा निषधास्तथैवानर्तनैर्ऋताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2042997, "chapter_id": 1960, "verse_number": "६-९-५२", "content_sanskrit": "दुर्गालाः प्रतिमत्स्याश्च कुन्तलाः कोसलास्तथा।\nतीरग्रहाः शूरसेना ईजिकाः कन्यका गुणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2042998, "chapter_id": 1960, "verse_number": "६-९-५३", "content_sanskrit": "तिलभारा मसीराश्च मधुमन्तः सकुन्दकाः।\nकाश्मीराः सिन्धुसौवीरा गान्धारा दर्शकास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2042999, "chapter_id": 1960, "verse_number": "६-९-५४", "content_sanskrit": "अभीसारा उलूताश्च शैवला बाह्लिकास्तथा ।\nदार्वी च वानवा दर्वा वातजामरथोरगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2043000, "chapter_id": 1960, "verse_number": "६-९-५५", "content_sanskrit": "बहुवाद्याश्च कौरव्य सुदामानः सुमल्लिकाः।\nवध्राः करीषकाश्चापि कुलिन्दोपत्यकास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2043001, "chapter_id": 1960, "verse_number": "६-९-५६", "content_sanskrit": "वनायवो दशापार्श्वरोमाणः कुशबिन्दवः।\nकच्छा गोपालकक्षाश्च जाङ्गलाः कुरुवर्णकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2043002, "chapter_id": 1960, "verse_number": "६-९-५७", "content_sanskrit": "किराता बर्बराः सिद्धा वैदेहास्ताम्रलिप्तकाः।\nओण्ड्रा म्लेच्छाः सैसिरिध्राः पार्वतीयाश्च मारिष ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2043003, "chapter_id": 1960, "verse_number": "६-९-५८", "content_sanskrit": "अथापरे जनपदा दक्षिणा भरतर्षभ ।\nद्रविडाः केरलाः प्राच्या भूषिका वनवासिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2043004, "chapter_id": 1960, "verse_number": "६-९-५९", "content_sanskrit": "कर्णाटका महिषका विकल्पा मूषकास्तथा ।\nझिल्लिकाः कुन्तलाश्चैव सौहृदानभकाननाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2043005, "chapter_id": 1960, "verse_number": "६-९-६०", "content_sanskrit": "कौकुट्टकास्तथा चोलाः कोङ्कणा मालवा नराः ।\nसमङ्गाः करकाश्चैव कुकुराङ्गारमारिषाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2043006, "chapter_id": 1960, "verse_number": "६-९-६१", "content_sanskrit": "ध्वजिन्युत्सवसंकेतास्त्रिगर्ताः साल्वसेनयः।\nव्यूकाः कोकबकाः प्रोष्ठाः सर्मवेगवशास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2043007, "chapter_id": 1960, "verse_number": "६-९-६२", "content_sanskrit": "तथैव विन्ध्यचुलिकाः पुलिन्दा वल्कलैः सह।\nमालवा बल्लवाश्चैव तथैवापरबल्लवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2043008, "chapter_id": 1960, "verse_number": "६-९-६३", "content_sanskrit": "कुलिन्दाः कालदाश्चैव कुण्डलाः करटास्तथा ।\nमूषकास्तनबालाश्च सनीपा घटसृञ्जयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2043009, "chapter_id": 1960, "verse_number": "६-९-६४", "content_sanskrit": "अठिदाः पाशिवाटाश्च तनयाः सुनयास्तथा ।\nऋषिका विदभाः काकास्तङ्गणाः परतङ्गणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2043010, "chapter_id": 1960, "verse_number": "६-९-६५", "content_sanskrit": "उत्तराश्चापरे म्लेच्छाः क्रूरा भरतसत्तम।\nयवनाश्चीनकाभ्योजा दारुणा म्लेच्छजातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2043011, "chapter_id": 1960, "verse_number": "६-९-६६", "content_sanskrit": "सकृद्ग्रहाः कुलत्थाश्च हूणाः पारसिकैः सह।\nतथैव रमणाश्चीनास्तथैव दशमालिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2043012, "chapter_id": 1960, "verse_number": "६-९-६७", "content_sanskrit": "क्षत्रिकयोपनिवेशाश्च वैश्यशूद्रकुलानि च।\nशूद्राभीराश्च दरदाः काश्मीराः पशुभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2043013, "chapter_id": 1960, "verse_number": "६-९-६८", "content_sanskrit": "खाशीराश्चान्तचाराश्च पह्लवा गिरिगह्वराः।\nआत्रेयाः सभरद्वाजास्तथैव स्तनपोषिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2043014, "chapter_id": 1960, "verse_number": "६-९-६९", "content_sanskrit": "प्रोषकाश्च कलिङ्गाश्च किरातानां च जातयः।\nतोमरा हन्यमानाश्च तथैव करभञ्जकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2043015, "chapter_id": 1960, "verse_number": "६-९-७०", "content_sanskrit": "एते चान्ये जनपदाः प्राच्योदीच्यास्तथैव च।\nउद्देशमात्रेण मया देशाः संकीर्तिता विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2043016, "chapter_id": 1960, "verse_number": "६-९-७१", "content_sanskrit": "यथागुणबलं चापि त्रिवर्गस्य महाफलम् ।\nदुह्याद्धेनुः कामधुक्क भूमिः सम्यगनुष्ठिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2043017, "chapter_id": 1960, "verse_number": "६-९-७२", "content_sanskrit": "तस्यां गृद्ध्यन्ति राजानः शूरा धर्मार्थक्रोविदाः ।\nते त्यजन्त्याहवे प्राणान्वसुगृद्धास्तरस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2043018, "chapter_id": 1960, "verse_number": "६-९-७३", "content_sanskrit": "देवमानुषकायानां कामं भूमिः परायणम् ।\nअन्योन्यस्यावलुम्पन्ति सारमेया यथाऽऽमिषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2043019, "chapter_id": 1960, "verse_number": "६-९-७४", "content_sanskrit": "राजानो भरतश्रेष्ठ भोक्तुकामा वसुन्धराम्।\nन चापि तृप्तिः कामानां विद्यतेऽद्यापि कस्यचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2043020, "chapter_id": 1960, "verse_number": "६-९-७५", "content_sanskrit": "तस्मात्परिग्रहे भूमेर्यतन्ते कुरुपाण्डवाः ।\nसाम्ना भेदेन दानेन दण्डेनैव च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2043021, "chapter_id": 1960, "verse_number": "६-९-७६", "content_sanskrit": "पिता भ्राता च पुत्राश्च खं द्यौश्च नरपुङ्गव ।\nभूमिर्भवति भूतानां सम्यगच्छिद्रदर्शना ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2043022, "chapter_id": 1960, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि जम्बूखण्डविनिर्माणपर्वणि नवमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}]