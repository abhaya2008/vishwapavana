[{"id": 900008828, "chapter_id": 8713, "verse_number": "3.1", "content_sanskrit": "ननु कथं वेदस्यापौरुषेयत्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008829, "chapter_id": 8713, "verse_number": "3.2", "content_sanskrit": "अपौरुषेयशब्दप्रमाणकत्वं वा साध्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008830, "chapter_id": 8713, "verse_number": "3.3", "content_sanskrit": "यद्वा वेदत्वमपौरुषेयवृत्ति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008831, "chapter_id": 8713, "verse_number": "3.4", "content_sanskrit": "न च पौरुषेयवाक्येन तत्सिद्धिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008832, "chapter_id": 8713, "verse_number": "3.5", "content_sanskrit": "किञ्चाप्रामाणिकानां सार्वज्ञ्याविप्रलम्भकत्व..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008833, "chapter_id": 8713, "verse_number": "3.6", "content_sanskrit": "यद्वा ईश्वरज्ञानं नप्रमेति मते..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008834, "chapter_id": 8713, "verse_number": "3.7", "content_sanskrit": "यद्वा स्वप्रतिपाद्यगोचरज्ञानत्वावच्छिन्नकारणताप्रतियोगिक-कार्यतानाश्रय..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008835, "chapter_id": 8713, "verse_number": "3.8", "content_sanskrit": "एतेन वेदस्यानादित्वरूपमपौरुषेयत्वं बाधितं सिद्धान्तविरुद्धञ्च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008836, "chapter_id": 8713, "verse_number": "3.9", "content_sanskrit": "यद्वा वेदानुपूर्वींनिष्ठादृष्टादिकारणता ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008837, "chapter_id": 8713, "verse_number": "3.10", "content_sanskrit": "यद्वाप्रत्यक्षन्यायामूलमन्वादिस्मृतिःप्रमाणमूलाप्रमाणभूत-स्मृतित्वात्..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008838, "chapter_id": 8713, "verse_number": "3.11", "content_sanskrit": "नचोक्तहेतूनामप्रयोजकता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900008839, "chapter_id": 8713, "verse_number": "3.12", "content_sanskrit": "न च बौद्धागमाद्वेदे महाजनपरिग्रहो विशेषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900008840, "chapter_id": 8713, "verse_number": "3.13", "content_sanskrit": "किञ्च ‘‘वाचा विरूपनित्यया’’ ‘‘श्रुतिर्वाव नित्या..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900008841, "chapter_id": 8713, "verse_number": "3.14", "content_sanskrit": "न चोक्तानुमानानां सत्प्रतिपक्षत्वं शङ्क्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900008842, "chapter_id": 8713, "verse_number": "3.15", "content_sanskrit": "एतेन वेदत्वं सजातीयोच्चारणानपेक्षोच्चरितवृत्ति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900008843, "chapter_id": 8713, "verse_number": "3.16", "content_sanskrit": "एतेन बुबोधयिषुपठितो वेदः स्वानपेक्षस्वसमानविषयक-ज्ञानपूर्वकः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900008844, "chapter_id": 8713, "verse_number": "3.17", "content_sanskrit": "एतेन वेदस्य यथार्थज्ञानपूर्वकत्वाभावेऽन्धपरम्परा स्यादिति निरस्तम् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900008845, "chapter_id": 8713, "verse_number": "3.18", "content_sanskrit": "ननु ‘‘शरीरं मे’’ इत्यादावीश्वरादेरेव..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900008846, "chapter_id": 8713, "verse_number": "3.19", "content_sanskrit": "एतेनैव काठकं कालापकं इत्यादि समाख्ययेश्वरसिद्धिः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900008847, "chapter_id": 8713, "verse_number": "3.20", "content_sanskrit": "नापि वेदस्तात्पर्यपूर्वकःप्रमाणशब्दत्वात् भारतवत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900008848, "chapter_id": 8713, "verse_number": "3.21", "content_sanskrit": "न च तत्रापीश्वरेच्छा कल्प्या", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900008849, "chapter_id": 8713, "verse_number": "3.22", "content_sanskrit": "एतेन वैदिकानि निन्दावाक्यानि हानाभिप्रायपूर्वकाणि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900008850, "chapter_id": 8713, "verse_number": "3.23", "content_sanskrit": "ननु यथा वेदानादित्वश्रुतिर्न वेदस्वरूपानादित्वपरा ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]