[{"id": 7003461000, "chapter_id": 23461, "verse_number": "१०१-१", "content_sanskrit": "अथ रस धेनुदानमाहात्म्यम् ।\nहोतोवाच ।\nरसधेनुविधानं ते कथयामि समासतः ।\nअनुलिप्ते महीपृष्ठे कृष्णाजिनकुशास्तरे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003461001, "chapter_id": 23461, "verse_number": "१०१-२", "content_sanskrit": "रसस्य तु घटं राजन् सम्पूर्णं त्वैक्षवस्य तु ।\nतद्वत्सङ्कल्पयेत्प्राज्ञश्चतुर्थांशेन वत्सकम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003461002, "chapter_id": 23461, "verse_number": "१०१-३", "content_sanskrit": "तुरीयांशेन वत्सं तु तत्पार्श्वे स्थापयेत्सुधीः ।\nइक्षुदण्डमयाः पादा रजतस्य खुरैर्युताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003461003, "chapter_id": 23461, "verse_number": "१०१-४", "content_sanskrit": "एवं कार्या रसैर्धेनुरिक्षुपादसमन्विता ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003461004, "chapter_id": 23461, "verse_number": "१०१-५", "content_sanskrit": "सुवर्णशृंगाभरणा वस्त्रपुच्छा घृतस्तनी ।\nपुष्पकम्बलसंयुक्ता शर्करामुखजिह्वका ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003461005, "chapter_id": 23461, "verse_number": "१०१-६", "content_sanskrit": "दन्ताः फलमयास्तस्याः पृष्ठं ताम्रमयं शुभम् ।\nपुष्परोमां तु राजेन्द्र मुक्ताफलकृतेक्षणाम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003461006, "chapter_id": 23461, "verse_number": "१०१-७", "content_sanskrit": "सप्तव्रीहिसमायुक्तां चतुर्दिक्षु च दीपिताम् ।\nसर्वोपस्करसंयुक्तां सर्वगन्धादिवासिताम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003461007, "chapter_id": 23461, "verse_number": "१०१-८", "content_sanskrit": "चत्वारि तिलपात्राणि चतुर्दिक्षु निवेशयेत् ।\nसर्वलक्षणयुक्ताय श्रोत्रियाय कुटुम्बिने ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003461008, "chapter_id": 23461, "verse_number": "१०१-९", "content_sanskrit": "रसधेनुः प्रदातव्या स्वर्गकामेन नित्यदा ।\nदाता स्वर्गमवाप्नोति सर्वपापविवर्जितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003461009, "chapter_id": 23461, "verse_number": "१०१-१०", "content_sanskrit": "दाता च ग्राहकश्चैव एककालमभोजनः ।\nसोमपानफलं तस्य सर्वत्र तु फलं भवेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003461010, "chapter_id": 23461, "verse_number": "१०१-११", "content_sanskrit": "दीयमानां तु पश्यन्ति ते च यान्ति परां गतिम् ।\nधेनुं च पूजयित्वाग्रे गन्धधूपस्रगादिभिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003461011, "chapter_id": 23461, "verse_number": "१०१-१२", "content_sanskrit": "पूर्वोक्तैरेव मन्त्रैस्तु ततस्तां प्रार्थयेत्सुधीः ।\nप्रार्थनापूर्वकं भक्त्या द्विजाग्र्याय निवेदयेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003461012, "chapter_id": 23461, "verse_number": "१०१-१३", "content_sanskrit": "दशपूर्वान्परांश्चैव आत्मानं चैकविंशकम् ।\nप्रापयेत्परमं स्थानं स्वर्गान्नावर्त्तते पुनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003461013, "chapter_id": 23461, "verse_number": "१०१-१४", "content_sanskrit": "एषा ते कथिता राजन्रसधेनुरनुत्तमा ।\nददस्व च महाराज परं स्थानमवाप्नुहि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003461014, "chapter_id": 23461, "verse_number": "१०१-१५", "content_sanskrit": "य इदं पठते नित्यं शृणुयादथ भक्तितः ।\nसर्वपापविनिर्मुक्तो विष्णुलोके महीयते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]