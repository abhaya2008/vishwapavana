[{"id": 2126189, "chapter_id": 3703, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2126190, "chapter_id": 3703, "verse_number": "१", "content_sanskrit": "अस्त्रहेतोर्गते पार्थे शक्रलोकं महात्मनि ।\nयुधिष्ठिरप्रभृतयः किमकुर्वत पाण्डवाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2126191, "chapter_id": 3703, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2126192, "chapter_id": 3703, "verse_number": "२", "content_sanskrit": "अस्त्रहेतोर्गते पार्थे शक्रलोकं महात्मनि ।\nन्यवसन् कृष्णया सार्धं काम्यके पुरुषर्षभाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2126193, "chapter_id": 3703, "verse_number": "३", "content_sanskrit": "ततः कदाचिदेकान्ते विविक्ते मृदुशाद्वले ।\nदुःखार्ता भरतश्रेष्ठा निषेदुः सह कृष्णया\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2126194, "chapter_id": 3703, "verse_number": "४", "content_sanskrit": "धनञ्जयं शोचमानाः सास्रनेत्राः सुदुःखिताः ।\nतद्वियोगात् तु सर्वेषां शोकः समभिपुप्लुवे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2126195, "chapter_id": 3703, "verse_number": "५", "content_sanskrit": "धनञ्जयवियोगाच्च राज्यनाशाच्च दुःखिताः ।\nअथ भीमो महाबाहुर्युधिष्ठिरमभाषत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2126196, "chapter_id": 3703, "verse_number": "६", "content_sanskrit": "निदेशात् ते महाराज गतोऽसौ पुरुषर्षभः ।\nअर्जुनः पाण्डुपुत्राणां यस्मिन् प्राणाः प्रतिष्ठिताः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2126197, "chapter_id": 3703, "verse_number": "७", "content_sanskrit": "यस्मिन् विनष्टे पाञ्चालाः सह पुत्रैस्तथा वयम् ।\nसात्यकिर्वासुदेवोऽपि विनश्येयुरसंशयः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2126198, "chapter_id": 3703, "verse_number": "८", "content_sanskrit": "योऽसौ गच्छति तेजस्वी बहून् क्लेशान् विचिन्तयन् ।\nभवन्नियोगाद् बीभत्सुः ततो दुःखतरं नु किम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2126199, "chapter_id": 3703, "verse_number": "९", "content_sanskrit": "यस्य बाहू समाश्रित्य वयं सर्वे महात्मनः ।\nमन्यामहे जितानाजौ परान् प्राप्तं च मेदिनीम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2126200, "chapter_id": 3703, "verse_number": "", "content_sanskrit": "यस्य प्रभावाद्धि वयं सभामध्ये धनुष्मतः ।\nजितान् मन्यामहे सर्वान् धार्तराष्ट्रान् ससौबलान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2126201, "chapter_id": 3703, "verse_number": "११", "content_sanskrit": "यस्य प्रभावान्न मया सभामध्ये महाबलाः ।\nनीता लोकममुं सर्वे धार्तराष्ट्राः ससौबलाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2126202, "chapter_id": 3703, "verse_number": "१२", "content_sanskrit": "ते वयं बाहुबलिनः क्रोधमुत्थितमात्मनः ।\nसहामहे भवन्मूलं वासुदेवेन पालिताः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2126203, "chapter_id": 3703, "verse_number": "१३", "content_sanskrit": "वयं हि सह कृष्णेन हत्वा कर्णमुखान् परान् ।\nस्वबाहुविजितां कृत्स्नां प्रशासेम वसुन्धराम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2126204, "chapter_id": 3703, "verse_number": "१४", "content_sanskrit": "भवतो द्यूतदोषेण सर्वे वयमवप्लुताः ।\nअहीनपौरुषा राजन् बलिभिर्बलवत्तराः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2126205, "chapter_id": 3703, "verse_number": "१५", "content_sanskrit": "क्षात्रं धर्मं महाराज समवेक्षितुमर्हसि ।\nन हि धर्मो महाराज क्षत्रियस्य वनाश्रयः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2126206, "chapter_id": 3703, "verse_number": "१६", "content_sanskrit": "राज्यमेव परं धर्मं क्षत्रियस्य विदुर्बुधाः ।\nस क्षात्रधर्मविद्राजन् माऽस्मान् विनशनः पथः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2126207, "chapter_id": 3703, "verse_number": "१७", "content_sanskrit": "प्राग्द्वादश समा राजन् धार्तराष्ट्रान् निहन्महि ।\nनिवर्त्य च वनात् पार्थमानाय्य च जनार्दनम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2126208, "chapter_id": 3703, "verse_number": "१८", "content_sanskrit": "व्यूढानीका महाराज जवेनैव महाहवे ।\nधार्तराष्ट्रानमुं लोकं गमयाम विशांपते \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2126209, "chapter_id": 3703, "verse_number": "१९", "content_sanskrit": "सर्वानहं हनिष्यामि धार्तराष्ट्रान् ससौबलान् ।\nदुर्योधनं च कर्णं च यो वाऽन्यः प्रतियोत्स्यति\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2126210, "chapter_id": 3703, "verse_number": "२०", "content_sanskrit": "मया प्रशमिते पश्चात् त्वमेष्यसि वनात् ततः ।\nएवं कृते न ते दोषो भविष्यति विशांपते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2126211, "chapter_id": 3703, "verse_number": "२१", "content_sanskrit": "यज्ञैश्च विविधैस्तात कृतं पापमरिन्दम ।\nअवधूय महाभाग गच्छेम स्वर्गमुत्तमम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2126212, "chapter_id": 3703, "verse_number": "२२", "content_sanskrit": "एवमेतद् भवेद्राजन् यदि राजा न बालिशः ।\nअस्माकं दीर्घसूत्रः स्याद् भवान् धर्मपरायणः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2126213, "chapter_id": 3703, "verse_number": "२३", "content_sanskrit": "निकृत्या निकृतिप्रज्ञा हन्तव्या इति निश्चयः ।\nन हि नैकृतिकं हत्वा निकृत्या पापमुच्यते\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2126214, "chapter_id": 3703, "verse_number": "२४", "content_sanskrit": "तथा भारत धर्मेषु सर्वज्ञैरिति दृश्यते ।\nअहोरात्रं महाराज तुल्यं संवत्सरेण ह \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2126215, "chapter_id": 3703, "verse_number": "२५", "content_sanskrit": "तथैव वेदवचनं श्रूयते नित्यदा विभो ।\nसंवत्सरो महाराज पूर्णो भवति कृच्छ्रतः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2126216, "chapter_id": 3703, "verse_number": "२६", "content_sanskrit": "यदि वेदाः प्रमाणं ते दिवसादूर्ध्वमद्य वै ।\nत्रयोदशादितः कालो ज्ञायतां परिनिष्ठितः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2126217, "chapter_id": 3703, "verse_number": "२७", "content_sanskrit": "कालो दुर्योधनं हन्तुं सानुबन्धमरिन्दम ।\nएकाग्रां पृथिवीं कृत्स्नां पुरा राजन् करोति सः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2126218, "chapter_id": 3703, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2126219, "chapter_id": 3703, "verse_number": "२८", "content_sanskrit": "एवं ब्रुवाणं भीमं तु धर्मपुत्रो युधिष्ठिरः ।\nउवाच सान्त्वयन् राजा मूर्ध्न्युपाघ्राय पाण्डवम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2126220, "chapter_id": 3703, "verse_number": "२९", "content_sanskrit": "असंशयं महाबाहो हनिष्यसि सुयोधनम् ।\nवर्षात् त्रयोदशादूर्ध्वं सह गाण्डीवधन्वना\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2126221, "chapter_id": 3703, "verse_number": "३०", "content_sanskrit": "यदि त्वं मन्यसे पार्थ प्राप्तः काल इति प्रभो ।\nअनृतं नोत्सहे वक्तुं न ह्येतन्मयि विद्यते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2126222, "chapter_id": 3703, "verse_number": "३१", "content_sanskrit": "अन्तरेणापि कौन्तेय निकृतं पापनिश्चयम् ।\nहन्ता त्वमसि दुर्धर्ष सानुबन्धं सुयोधनम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2126223, "chapter_id": 3703, "verse_number": "३२", "content_sanskrit": "एवं ब्रुवति भीमं तु धर्मराजे युधिष्ठिरे ।\nआजगाम महायोगी बृहदश्वो महानृषिः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2126224, "chapter_id": 3703, "verse_number": "३३", "content_sanskrit": "तमभिप्रेक्ष्य धर्मात्मा सम्प्राप्तं धर्मचारिणम् ।\nशास्त्रवन्मधुपर्केण पूजयामास धर्मराट् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2126225, "chapter_id": 3703, "verse_number": "३४", "content_sanskrit": "आश्वस्तं चैवमासीनमुपासीनो युधिष्ठिरः ।\nअभिप्रेक्ष्य महाबाहुः कृपणं बह्वभाषत\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2126226, "chapter_id": 3703, "verse_number": "३५", "content_sanskrit": "अक्षद्यूतेन मां जित्वा धनं राज्यं च मे हृतम् ।\nआहूय निकृतिप्रज्ञैः कितवैरक्षकोविदैः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2126227, "chapter_id": 3703, "verse_number": "३६", "content_sanskrit": "अनक्षज्ञस्य हि ततो निकृत्या पापनिश्चयैः ।\nभार्या च मे सभां नीता प्राणेभ्योऽपि गरीयसी\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2126228, "chapter_id": 3703, "verse_number": "३७", "content_sanskrit": "पुनर्द्यूतेन मां जित्वा वनवासं सुदारुणम् ।\nप्राव्राजयन् महारण्यमजिनैः परिवारितम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2126229, "chapter_id": 3703, "verse_number": "३०", "content_sanskrit": "सोऽहं वने दुर्वसतीः शये परमदुःखितः ।\nअक्षद्यूतानुषङ्गेण गिरः शृण्वन् सुदारुणाः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2126230, "chapter_id": 3703, "verse_number": "३९", "content_sanskrit": "सम्प्राप्तानां च सुहृदां शृण्वन् सत्याभिसंहिताम् ।\nद्यूतात् प्रभृति धर्मज्ञ रात्रीः सर्वा विचिन्तयन्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2126231, "chapter_id": 3703, "verse_number": "४०", "content_sanskrit": "यस्मिंश्च वयमायत्ताः सदा गाण्डीवधन्वनि ।\nमहात्मना विना तेन गतसत्त्वा इवास्महे\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2126232, "chapter_id": 3703, "verse_number": "४१", "content_sanskrit": "कदा द्रक्ष्याम बीभत्सुं कृतास्त्रं पुनरागतम् ।\nइति सर्वे महेष्वासं चिन्तयाना धनञ्जयम् ।\nअनेन तु विषण्णोऽहं कारणेन सहानुजः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2126233, "chapter_id": 3703, "verse_number": "४२", "content_sanskrit": "वनवासान्निवृत्तं मां पुनस्ते पापबुद्धयः ।\nजानन्तः प्रीयमाणा वै देवने भ्रातृभिः सह ।\tद्यूतेनैवाह्वयिष्यन्ति बलादक्षेषु तद्विदः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2126234, "chapter_id": 3703, "verse_number": "४३", "content_sanskrit": "आहूतश्च पुनर्द्यूते नास्मि शक्तो निवर्तितुम् ।\nपणे च मम नात्यर्थं विद्यते वसु किञ्चन\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2126235, "chapter_id": 3703, "verse_number": "४४", "content_sanskrit": "एतत् सर्वमनुध्यायन् चिन्तयामि दिवानिशम् ।\nन मत्तो दुःखिततरः पुमानस्तीह कश्चन\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2126236, "chapter_id": 3703, "verse_number": "४५", "content_sanskrit": "नास्ति राजा मया कश्चिद् अल्पभाग्यतरो भुवि ।\nभवता दृष्टपूर्वोऽपि श्रुतपूर्वोऽपि वा भवेत् ।\nन मत्तो दुःखिततरः पुमानस्तीति मे मतिः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2126237, "chapter_id": 3703, "verse_number": "४६", "content_sanskrit": "एवं ब्रुवन्तं राजानमुवाच भगवानृषिः ।\nशोकं व्यपनुदन् राज्ञो धर्मराजस्य धीमतः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2126238, "chapter_id": 3703, "verse_number": "४७", "content_sanskrit": "न विषादे मनः कार्यं त्वया बुद्धिमतां वर ।\nआगमिष्यति बीभत्सुरमित्रांश्च विजेष्यति\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2126239, "chapter_id": 3703, "verse_number": "४८", "content_sanskrit": "यद् ब्रवीषि महाराज न मत्तो विद्यते क्वचित् ।\nअल्पभाग्यतरः कश्चित् पुमानस्तीति पाण्डव\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2126240, "chapter_id": 3703, "verse_number": "४९", "content_sanskrit": "अत्र ते कथयिष्यामि यदि शुश्रूषसे नृप ।\nयस्त्वत्तो दुःखिततरो राजाऽऽसीत् पृथिवीपते\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2126241, "chapter_id": 3703, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2126242, "chapter_id": 3703, "verse_number": "५०", "content_sanskrit": "अथैनमब्रवीद् राजा ब्रवीतु भगवानिति ।\nइमामवस्थां सम्प्राप्तं श्रोतुमिच्छामि पार्थिवम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2126243, "chapter_id": 3703, "verse_number": "", "content_sanskrit": "बृहदश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2126244, "chapter_id": 3703, "verse_number": "५१", "content_sanskrit": "शृणु राजन्नवहितः सह भ्रातृभिरच्युत ।\nयस्त्वत्तो दुःखिततरो राजाऽऽसीत् पृथिवीपते\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2126245, "chapter_id": 3703, "verse_number": "५२", "content_sanskrit": "निषधेषु महीपालो वीरसेन इति स्म ह ।\nतस्य पुत्रोऽभवन्नाम्ना नळो धर्मार्थदर्शिवान्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2126246, "chapter_id": 3703, "verse_number": "५३", "content_sanskrit": "स निकृत्या जितो राजा पुष्करेणेति नः श्रुतम् ।\nवनवासमदुःखार्हो भार्यया न्यवसत् सह\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2126247, "chapter_id": 3703, "verse_number": "५४", "content_sanskrit": "न तस्य दासा न रथो न भ्राता न च बान्धवाः ।\nवने निवसतो राजन्नश्रूयन्त कदाचन\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2126248, "chapter_id": 3703, "verse_number": "५५", "content_sanskrit": "भवान् हि संवृतो वीरैर्भ्रातृभिर्देवसम्मितैः ।\nब्रह्मकल्पैर्द्विजाग्र्यैश्च तस्मान्नार्हसि शोचितुम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2126249, "chapter_id": 3703, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2126250, "chapter_id": 3703, "verse_number": "५६", "content_sanskrit": "विस्तरेणाधिगच्छामि नळस्य सुमहात्मनः ।\nचरितं वदतां श्रेष्ठ त्वं तदाख्यातुमर्हसि\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2126251, "chapter_id": 3703, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि पञ्चचत्वारिंशोऽध्यायः ॥४५॥ ॥ तीर्थयात्रपर्वणि प्रथमोऽध्यायः ॥१॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]