[{"id": 7001016000, "chapter_id": 21016, "verse_number": "४-२२-१", "content_sanskrit": "श्रीपराशर उवाच\nअतश्चेक्ष्वाकवो भविष्याः पार्थिवाः कथ्यन्ते  ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001016001, "chapter_id": 21016, "verse_number": "४-२२-२", "content_sanskrit": "बृहद्बलस्य पुत्रो बृहत्क्षणः  ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001016002, "chapter_id": 21016, "verse_number": "४-२२-३", "content_sanskrit": "तस्मादुरुक्षयस्तस्माच्च वत्सव्यूहस्ततश्च प्रतिव्योमस्तस्मादपि दिवाकरः  ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001016003, "chapter_id": 21016, "verse_number": "४-२२-४", "content_sanskrit": "तस्मात्सहदेवः सहदेवाद्बृहदश्वस्तत्सूनुर्भानुरथस्तस्य च प्रतीताश्वस्तस्यापि सुप्रतीकस्ततश्च मरुदेवस्ततः सुनक्षत्रस्तमात्किन्नरः  ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001016004, "chapter_id": 21016, "verse_number": "४-२२-५", "content_sanskrit": "किन्नरादन्तरिक्षस्तस्मात्सुपर्णस्ततश्चामित्रजित् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001016005, "chapter_id": 21016, "verse_number": "४-२२-६", "content_sanskrit": "ततश्च बृहद्भाजस्तस्यापि धर्मी धर्मीणः कृतञ्जयः  ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001016006, "chapter_id": 21016, "verse_number": "४-२२-७", "content_sanskrit": "कृतञ्जयाद्रणञ्जयः  ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001016007, "chapter_id": 21016, "verse_number": "४-२२-८", "content_sanskrit": "रणञ्जयात्संजयस्तस्माच्