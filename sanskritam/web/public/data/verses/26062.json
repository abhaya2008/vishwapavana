[{"id": 7006062000, "chapter_id": 26062, "verse_number": "२-६-१", "content_sanskrit": "गरुड उवाच ।\nअपि साधनयुक्तस्य तीर्थदानरतस्य च ।\nअकृते तु वृषोत्सर्गे परलोकगतिर्न हि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006062001, "chapter_id": 26062, "verse_number": "२-६-२", "content_sanskrit": "तस्मात्कृष्ण वृषोत्सर्गः कर्तव्य इति मे श्रुतम् ।\nकिं फलं वृषयज्ञस्य पुरा केन कृतो हरे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006062002, "chapter_id": 26062, "verse_number": "२-६-३", "content_sanskrit": "अनड्वान् कीदृशः प्रोक्तः कस्मिन् काले विशेषतः ।\nको विधिस्तस्य निर्दिष्टः सर्वं मे कृपया वद ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006062003, "chapter_id": 26062, "verse_number": "२-६-४", "content_sanskrit": "श्रीकृष्ण उवाच ।\nइतिहासं महापुण्यं प्रवक्ष्यामि खगेश्वर ।\nब्रह्मपुत्रेण यत्प्रोक्तं राजानं वीरवाहनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006062004, "chapter_id": 26062, "verse_number": "२-६-५", "content_sanskrit": "विराधनगरे राजा वीरवाहननामकः ।\nधर्मात्मा सत्यसन्धश्च वदान्यो विप्रतुष्टिकृत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006062005, "chapter_id": 26062, "verse_number": "२-६-६", "content_sanskrit": "स कदाचिद्वनं वीरो महात्माखेटकं गतः ।\nकिञ्चित्प्रष्टुमनास्तार्क्ष्य वसिष्ठस्याश्रमं ययौ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006062006, "chapter_id": 26062, "verse_number": "२-६-७", "content_sanskrit": "नमस्कृत्य मुनिं तत्र कृतासनपरिग्रहः ।\nपश्रयावनतो राजा पप्रच्छ ऋषिसंसदि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006062007, "chapter_id": 26062, "verse_number": "२-६-८", "content_sanskrit": "राजोवाच ।\nमुने मया कृतो धर्मो यथाशक्ति प्रयत्नतः ।\nयमस्य शासनं श्रुत्वा बिभेमि नितरां हृदि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006062008, "chapter_id": 26062, "verse_number": "२-६-९", "content_sanskrit": "यमञ्च यमदूतांश्च निरयान् घोरदर्शनान् ।\nन पश्यामि महाभाग तथा वद दयानिधे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006062009, "chapter_id": 26062, "verse_number": "२-६-१०", "content_sanskrit": "वसिष्ठ उवाच ।\nधर्मा बहुविधा राजन् वर्ण्यन्ते शास्त्रकोविदैः ।\nसूक्ष्मत्वान्न विजानन्ति कर्ममार्गविमोहिताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006062010, "chapter_id": 26062, "verse_number": "२-६-११", "content_sanskrit": "दानं तीर्थं तपो यज्ञाः संन्यासः पैतृको महः ।\nधर्मेषु गृह्यमाणेषु वृषोत्सर्गो विशेषितः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006062011, "chapter_id": 26062, "verse_number": "२-६-१२", "content_sanskrit": "एष्टव्या बहवः पुत्रा यद्येकोऽपि गयां व्रजेत् ।\nयजेत वाश्वमेधेन नीलं वा वृषमुत्सृजेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006062012, "chapter_id": 26062, "verse_number": "२-६-१३", "content_sanskrit": "ब्रह्महत्यादिपापानि ज्ञानाज्ञानकृतानि च ।\nनीलोद्वाहेन शुध्येत्तु समुद्रप्लवनेन वा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006062013, "chapter_id": 26062, "verse_number": "२-६-१४", "content_sanskrit": "एकादशाहे राजेन्द्र यस्य नोत्सूज्यते वृषः ।\nप्रेतत्वं निश्चलं तस्य कृतैः श्राद्धैस्तु किं भवेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006062014, "chapter_id": 26062, "verse_number": "२-६-१५", "content_sanskrit": "यथाकथञ्चित्कर्तव्यस्तीर्थे वा पत्तनेऽथ वा ।\nवृषयज्ञैः प्रमुच्यते नान्यथा साधनैः खग ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006062015, "chapter_id": 26062, "verse_number": "२-६-१६", "content_sanskrit": "वृषभं पञ्चकल्याणं युवानं कृष्णकंबलम् ।\nगोयूथमध्ये नितरां विचरन्तं विधानतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006062016, "chapter_id": 26062, "verse_number": "२-६-१७", "content_sanskrit": "चतसृभिर्वत्सकाभिर्द्वाभ्याञ्चैवैकया खग ।\nविवाह्य मङ्गलद्रव्यैर्मन्त्रवत्तं समुत्सृजेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006062017, "chapter_id": 26062, "verse_number": "२-६-१८", "content_sanskrit": "इह रतीति षडृग्भिर्हेमं कुर्याद्विभावसोः ।\nकार्तिक्यां माघवैशाख्यां संक्रमे पातपर्वसु ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006062018, "chapter_id": 26062, "verse_number": "२-६-१९", "content_sanskrit": "तीर्थे पित्र्येक्षयाहे च विशेषेण प्रशस्यते ।\nलोहितो यस्तु वर्णेन मुखे पुच्छे च पाण्डुरः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006062019, "chapter_id": 26062, "verse_number": "२-६-२०", "content_sanskrit": "पीतः खुरविषाणेषु स नीलो वृष उच्यते ।\nश्वेतवर्णो भवेद्विप्रो लोहितः क्षत्त्र उच्यते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006062020, "chapter_id": 26062, "verse_number": "२-६-२१", "content_sanskrit": "पीतवर्णो भवेद्वैश्यः शूद्रः कृष्णः स्मृतो बुधैः ।\nयथावर्णं समुद्दिष्टो वर्णेषु ब्राह्मणादिषु ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006062021, "chapter_id": 26062, "verse_number": "२-६-२२", "content_sanskrit": "अथ वा रक्तवर्णस्तु सर्वेषामेव शस्यते ।\nपिता पितामहश्चैव तथैव प्रपितामहः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006062022, "chapter_id": 26062, "verse_number": "२-६-२३", "content_sanskrit": "आशासते सुतं जातं वृषोत्सर्गं करिष्यति ।\nधर्मस्त्वं वृषरूपेण जगदानन्ददायकः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006062023, "chapter_id": 26062, "verse_number": "२-६-२४", "content_sanskrit": "अष्टमूर्तेरधिष्ठानमतः शान्तिं प्रयच्छ मे ।\nगङ्गायमुनयोः पेयमन्तर्वेदि तृणं चर ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006062024, "chapter_id": 26062, "verse_number": "२-६-२५", "content_sanskrit": "धर्मराजस्य पुरतो वाच्यं मे सुकृतं वृष ।\nदक्षिणांसे त्रिशूलाङ्कं वामोरौ चक्रचिह्नितम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006062025, "chapter_id": 26062, "verse_number": "२-६-२६", "content_sanskrit": "इति संप्रार्थ्य वृषभं गन्धपुष्पाक्षतादिभिः ।\nवृषं तत्सतरीयुक्तं पूजयित्वा समुत्सृजेत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006062026, "chapter_id": 26062, "verse_number": "२-६-२७", "content_sanskrit": "तस्माद्राजन् विधानेन वृषोत्सर्गं समाचर ।\nबहुसाधनयुक्तस्य नान्यथा सद्गतिस्तव ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006062027, "chapter_id": 26062, "verse_number": "२-६-२८", "content_sanskrit": "आसीत्त्रेतायुगे पूर्वं विदेहनगरे नृप ।\nब्राह्मणो धर्मवत्सेति स्वकर्मनिरतः सुधीः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006062028, "chapter_id": 26062, "verse_number": "२-६-२९", "content_sanskrit": "विष्णुभक्तोऽतितेजस्वी यथालाभेन तुष्टिकृत् ।\nपितृपर्वणि संप्राप्ते कुशार्यो काननं ययौ ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006062029, "chapter_id": 26062, "verse_number": "२-६-३०", "content_sanskrit": "अटन्नितस्ततस्तत्र चिन्वन् कुशपलाशकम् ।\nसहसोपेत्य पुरुषाश्चात्वारश्चारुदर्शनाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006062030, "chapter_id": 26062, "verse_number": "२-६-३१", "content_sanskrit": "विभ्रान्तमनसं गृह्य प्रत्यग्जग्मुर्विहायसा ।\nबहुवृक्षसमाकीर्णं गिरिदुर्गभयानकम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006062031, "chapter_id": 26062, "verse_number": "२-६-३२", "content_sanskrit": "वनाद्वनान्तरं निन्युर्नदीनदसमाकुलम् ।\nस तत्र नगरं राजन् ददर्श बहुविस्तरम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006062032, "chapter_id": 26062, "verse_number": "२-६-३३", "content_sanskrit": "गोपुरद्वाररचितं सौधप्रासादमण्डितम् ।\nचत्वरापणपण्यादिनरनारीसमाकुलम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006062033, "chapter_id": 26062, "verse_number": "२-६-३४", "content_sanskrit": "तूर्यद्वन्द्वाभिनिर्घोषवीणापटहनादितम् ।\nकांश्चित्क्षुधार्दितान्दीनान्मलिनान्विगतौजसः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006062034, "chapter_id": 26062, "verse_number": "२-६-३५", "content_sanskrit": "ततोऽतितुष्टान्मलिनान्वस्त्रखण्डसमावृतान् ।\nअग्रतो हृष्टपुष्टांश्च स्वर्णवस्त्रोपशोभितान् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006062035, "chapter_id": 26062, "verse_number": "२-६-३६", "content_sanskrit": "ततोऽपि सुरसंकाशान्स दृष्ट्वा विस्मितोऽभवत् ।\nकिं स्वप्न उत माया वै मदीयो मानसो भ्रमः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006062036, "chapter_id": 26062, "verse_number": "२-६-३७", "content_sanskrit": "सन्दिहानं द्विजं निन्युः पुरुषा राजसन्निधिम् ।\nसतद्ददर्श विप्रस्तु स्वर्णप्रासादमन्दिरे ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006062037, "chapter_id": 26062, "verse_number": "२-६-३८", "content_sanskrit": "सिंहासनंमहादिव्यं छत्रचामरवीजितम् ।\nतत्रोप विष्टं राजानं किरीटकनकोज्ज्वलम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006062038, "chapter_id": 26062, "verse_number": "२-६-३९", "content_sanskrit": "महत्या च श्रिया युक्तं स्तूयमानं सुवन्दिभिः ।\nराजापि दृष्ट्वा तं विप्रं प्रत्युत्थाय कृताञ्जलिः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006062039, "chapter_id": 26062, "verse_number": "२-६-४०", "content_sanskrit": "पूजयामास विधिवन्मधुपर्कास नादिभिः ।\nसन्तुष्टमनसं देवमस्तौषीत्परया मुदा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006062040, "chapter_id": 26062, "verse_number": "२-६-४१", "content_sanskrit": "अद्य मे सफलं जन्म पावितञ्च कुलं प्रभो ।\nविष्णुभक्तस्य धर्मस्य यत्ते दृग्गोचरं गतः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006062041, "chapter_id": 26062, "verse_number": "२-६-४२", "content_sanskrit": "नत्वा स्तुत्वा बहुविधमुवाचानुवसन्नृपः ।\nयतः समागतो देवः पुनस्तत्रैव नीयताम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006062042, "chapter_id": 26062, "verse_number": "२-६-४३", "content_sanskrit": "इति श्रुत्वा वचो राज्ञः पप्रच्छ द्विजपुङ्गवः ।\nब्राह्मण उवाच ।\nकोऽयं देश कुतो लोका उत्तमा मध्यमाधमाः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006062043, "chapter_id": 26062, "verse_number": "२-६-४४", "content_sanskrit": "केन पुण्येन तु भवान्पारमेष्ट्यविभूषितः ।\nकिमर्थमहमानीतः पुनस्तत्रैव नीयते ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006062044, "chapter_id": 26062, "verse_number": "२-६-४५", "content_sanskrit": "अपूर्वमिव पश्यामि सर्वं स्वप्नगतो यथा ।\nराजोवाच ।\nस्वधर्मनिरतो यस्तु हरिभक्तिरतः सदा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006062045, "chapter_id": 26062, "verse_number": "२-६-४६", "content_sanskrit": "विरक्त इन्द्रियार्थेभ्यः स मे पूज्यो न संशयः ।\nतीर्थयात्रापरो नित्यं वृषोत्सर्गविशेषवित् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006062046, "chapter_id": 26062, "verse_number": "२-६-४७", "content_sanskrit": "सत्यदानपरो यस्तु स नमस्यो दिवौकसाम् ।\nदर्शनार्थमिहानीतः पूजार्हश्च परन्तप ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006062047, "chapter_id": 26062, "verse_number": "२-६-४८", "content_sanskrit": "अनुगृहाण मां देव क्षमस्व मम साहसम् ।\nइत्युक्त्वा दर्शयामास मन्त्रिणां संज्ञया भ्रुवः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006062048, "chapter_id": 26062, "verse_number": "२-६-४९", "content_sanskrit": "वदिष्यति समग्रं ते स्वयं वक्तुं न साम्प्रतम् ।\nसामन्तः सर्ववेदज्ञो ज्ञात्वा हार्दं नृपस्य च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006062049, "chapter_id": 26062, "verse_number": "२-६-५०", "content_sanskrit": "विपश्चिदुवाच ।\nपूर्वजन्मनि वैश्योऽयं विश्वम्भर इति श्रुतः ।\nविराधनगरे विप्र द्विजदेवविभूषिते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006062050, "chapter_id": 26062, "verse_number": "२-६-५१", "content_sanskrit": "वैश्यवृत्त्या सदा जीवन्कुटुम्बपरिपालकः ।\nगवां शुश्रूषको नित्यं ब्राह्मणानाञ्च पूजकः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006062051, "chapter_id": 26062, "verse_number": "२-६-५२", "content_sanskrit": "पात्रदानपरो नित्यमातिथेयाग्निसेवकः ।\nगार्हस्थ्यं विधिवच्चक्रे भार्यया सत्यमेधया ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006062052, "chapter_id": 26062, "verse_number": "२-६-५३", "content_sanskrit": "स्मार्तेन लोकानजयच्छ्रौतेन त हविर्भुजः ।\nकदाचिद्बन्धुभिः साकं कृत्वा तीर्थानि भूरिशः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006062053, "chapter_id": 26062, "verse_number": "२-६-५४", "content_sanskrit": "यावदायाति सदनं दृष्टवाल्लोंमशं पथि ।\nदण्डवत्प्रणिपत्याशु कृताञ्जलिपुटं स्थितम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006062054, "chapter_id": 26062, "verse_number": "२-६-५५", "content_sanskrit": "पप्रच्छ विनयोपेतं करुणावारिवारिधिः ।\nऋषिरुवाच ।\nकुत आगम्यते साधो ब्राह्मणैर्बन्धुभिर्युतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006062055, "chapter_id": 26062, "verse_number": "२-६-५६", "content_sanskrit": "दृष्ट्वा त्वां धर्मनिलयं प्रक्लिन्नं मानसं मम ।\nविश्वम्भर उवाच ।\nशीर्यमाणं शरीरं हि ज्ञात्वा मृत्युं पुरः स्थितम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006062056, "chapter_id": 26062, "verse_number": "२-६-५७", "content_sanskrit": "भर्यया धर्मचारिण्या तीर्थयात्रां विनिर्गतः ।\nकृत्वा तीर्थानि विधिवद्विश्राण्य विपुलं वसु ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006062057, "chapter_id": 26062, "verse_number": "२-६-५८", "content_sanskrit": "यावद्ब्रजाम्यहं वेश्म भवान् दृष्टिपथं गतः ।\nलोमश उवाच ।\nतीर्थानि सन्ति भूरीणि वर्षैऽस्मिन् भारते शुभे ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006062058, "chapter_id": 26062, "verse_number": "२-६-५९", "content_sanskrit": "यत्त्वया ह्युपचीर्णानि तानि सर्वाणि मे वद ।\nवैश्य उवाच ।\nगङ्गा च सूर्य तनया महापुण्या सरस्वती ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006062059, "chapter_id": 26062, "verse_number": "२-६-६०", "content_sanskrit": "दशाश्वमेधैरयजद्यत्र ब्रह्मा सुरेश्वरः ।\nतीर्थराजस्ततः काशी महादेवो दयानिधिः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006062060, "chapter_id": 26062, "verse_number": "२-६-६१", "content_sanskrit": "मृतानां यत्र जन्तूनां कर्णे जपति तारकम् ।\nपुलहस्याश्रमं पुण्यं फल्गुतीर्थञ्च गण्डकी ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006062061, "chapter_id": 26062, "verse_number": "२-६-६२", "content_sanskrit": "चक्रतीर्थं नैमिषञ्च शिवतीर्थमनन्तकम् ।\nगोप्रतारकनागेशमयोध्याबिन्दुसंज्ञितम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006062062, "chapter_id": 26062, "verse_number": "२-६-६३", "content_sanskrit": "यत्रास्त मुक्तिदः साक्षाद्रामो राजीवलोचनः ।\nआग्नेयं वायुकौबेरं कौमारं भूरुहां पुनः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006062063, "chapter_id": 26062, "verse_number": "२-६-६४", "content_sanskrit": "सौकरं मथुरा यत्र नित्यं सन्निहतो हरिः ।\nपुष्करं सत्यतीर्थञ्च ज्वालतीर्थं दिनेश्वरम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006062064, "chapter_id": 26062, "verse_number": "२-६-६५", "content_sanskrit": "इन्द्रतीर्थं कुरुक्षेत्रं यत्र प्राची सरस्वती ।\nतापी पयोष्णी निर्विन्ध्या मलयः कृष्णवेणिका ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006062065, "chapter_id": 26062, "verse_number": "२-६-६६", "content_sanskrit": "गोदावरी दण्डकञ्च ताम्रचूडं सदोदकम् ।\nद्यावाभूमीश्वरं दृष्ट्वा श्रीशैलः पर्वतेश्वरः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006062066, "chapter_id": 26062, "verse_number": "२-६-६७", "content_sanskrit": "असंख्यलिङ्गतीर्थानि यत्र सन्ति सदा मुने ।\nवेङ्कटाद्रौ महातेजाः श्रीरङ्गाख्यः स्वयं हरिः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006062067, "chapter_id": 26062, "verse_number": "२-६-६८", "content_sanskrit": "वेङ्कटी नाम तत्रैव देवी महिषमर्दिनी ।\nचन्द्रतीर्थं भद्रवटः कावेरीकुटिलाचलौ ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006062068, "chapter_id": 26062, "verse_number": "२-६-६९", "content_sanskrit": "अवटोदा ताम्रपर्णो त्रिकृटः कोल्लको गिरिः ।\nवासिष्ठं ब्रह्मतीर्थञ्च ज्ञानतीर्थं महोदधिः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006062069, "chapter_id": 26062, "verse_number": "२-६-७०", "content_sanskrit": "हृषीकेशं विराजञ्च विशालं नीलपर्वतः ।\nभीमकूटः श्वेतगिरी रुद्रतीर्थमुमावनम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006062070, "chapter_id": 26062, "verse_number": "२-६-७१", "content_sanskrit": "अवाप गिरिजा देवी तपसा यत्र शङ्करम् ।\nवारुणं सूर्यतीर्थञ्च हंसतीर्थं महोदयम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006062071, "chapter_id": 26062, "verse_number": "२-६-७२", "content_sanskrit": "निमज्ज्य यत्र काकोला राजहंसत्वमाययुः ।\nअसुरो यत्र देवत्वमवाप स्नानमात्रतः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006062072, "chapter_id": 26062, "verse_number": "२-६-७३", "content_sanskrit": "विश्वरूपं वन्दितीर्थं रत्नेशः कुहकाचलः ।\nनरनारायणं दृष्ट्वा मुच्यते पापकोटिभिः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006062073, "chapter_id": 26062, "verse_number": "२-६-७४", "content_sanskrit": "सरस्वतीदृषद्वत्यौ नर्मदा शर्मदा नृणाम् ।\nनीलकण्ठं महाकालं पुण्यं चामरकण्टकम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006062074, "chapter_id": 26062, "verse_number": "२-६-७५", "content_sanskrit": "चन्द्रभागा वेत्रवती वीरभद्रं गणेश्वरम् ।\nगोकर्णं बिल्वतीर्थञ्च कर्मकुण्डं सतारकम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006062075, "chapter_id": 26062, "verse_number": "२-६-७६", "content_sanskrit": "स्नानमात्रेण यत्राशु मुच्यते कर्मबन्धनात् ।\nअन्यान्यपि च तीर्थानि कृतानि कृपया तव ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006062076, "chapter_id": 26062, "verse_number": "२-६-७७", "content_sanskrit": "उत्पद्यते शुभा बुद्धिः साधूनां यदनुग्रहः ।\nएकतः सर्वतीर्थानि करुणाः साधवोऽन्यतः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006062077, "chapter_id": 26062, "verse_number": "२-६-७८", "content_sanskrit": "अनुग्रहाय भूतानां चरन्ति चरितव्रताः ।\nत्वं गुरुः सर्वर्णानां विद्यया वयसाधिकः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006062078, "chapter_id": 26062, "verse_number": "२-६-७९", "content_sanskrit": "अतः पृच्छाम्यहं किञ्चिदाधिभूतं चिरन्तनम् ।\nकिं कुर्यां कं नु पृच्छेऽहं मनो मेऽतिचलं मुने ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006062079, "chapter_id": 26062, "verse_number": "२-६-८०", "content_sanskrit": "निः स्पृहं ब्रह्मविषये विषयेष्वतिलालसम् ।\nमनागपि न सहते विरहं तिमिरं ब्रुवत् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006062080, "chapter_id": 26062, "verse_number": "२-६-८१", "content_sanskrit": "मोहितं विविधैर्भावैः कर्मणां क्षेत्रमुत्तमम् ।\nशान्तिं यथा समायाति सम्पन्नमिव भूसुर ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006062081, "chapter_id": 26062, "verse_number": "२-६-८२", "content_sanskrit": "विवेकप्रवणं शुद्धं यथा स्यात्कृपया वद ।\nऋषिरुवाच ।\nमनस्तु प्रबलं नित्यं सविकारं स्वभावतः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006062082, "chapter_id": 26062, "verse_number": "२-६-८३", "content_sanskrit": "वशं नयन्ति करिणं प्रमत्तमपि हस्तिपाः ।\nतथापि साधुसङ्गत्या साधनैरप्यतन्द्रितः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006062083, "chapter_id": 26062, "verse_number": "२-६-८४", "content_sanskrit": "तीव्रेण भक्तियोगेन विचारेण वशं नयेत् ।\nइतिहासं प्रवक्ष्यामि तव प्रत्ययकारकम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006062084, "chapter_id": 26062, "verse_number": "२-६-८५", "content_sanskrit": "नारदोऽकथयन्मह्यं स्ववृत्तगतजन्मनः ।\nनारद उवाच ।\nकस्यचिद्द्विजमुख्यस्य दासीपुत्त्रः पुरा मुने ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006062085, "chapter_id": 26062, "verse_number": "२-६-८६", "content_sanskrit": "शिक्षितो बालभावेऽपि पाठितो नितरामहम् ।\nतत्रापि सङ्गतिर्जाता महतां पुण्यकर्मणाम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006062086, "chapter_id": 26062, "verse_number": "२-६-८७", "content_sanskrit": "प्रावृट्काले मम गृहे स्थितानां भाग्ययोगतः ।\nशुश्रूषणानुवृत्त्या च प्रश्रयेण दमेन च ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006062087, "chapter_id": 26062, "verse_number": "२-६-८८", "content_sanskrit": "सन्तोषं परमं प्राप्य कृपया त्विदमब्रुवन् ।\nमनीषा निर्मला येन जाता मम शुभार्थिनी ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006062088, "chapter_id": 26062, "verse_number": "२-६-८९", "content_sanskrit": "यया विष्णुमयं सर्वम्त्मन्येव ददृशिवान् ।\nमुनय ऊचुः ।\nशृणु वत्स प्रवक्ष्या मो हिताय तव बालक ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006062089, "chapter_id": 26062, "verse_number": "२-६-९०", "content_sanskrit": "येन वै ध्रियमाणेन इहामुत्र सुखं भवेत् ।\nदेवतिर्यङ्मनुष्याश्च संसारे विविधा जनाः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006062090, "chapter_id": 26062, "verse_number": "२-६-९१", "content_sanskrit": "निबद्धाः कर्मपशैस्ते भुञ्जन् भोगान् पृथग्विधान् ।\nदेवत्वं याति सत्त्वेन रजसा च मनुष्यताम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006062091, "chapter_id": 26062, "verse_number": "२-६-९२", "content_sanskrit": "तिर्यक्त्वं तमसा जन्तुर्वासनानुगतोऽबुधः ।\nमातुर्लब्ध्वा पुनर्जन्म म्रियते च पुनः पुनः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006062092, "chapter_id": 26062, "verse_number": "२-६-९३", "content_sanskrit": "एवं गत्वा ह्यसंख्याता योनीस्ताः कर्मभूरपि ।\nमानुष्यं दुर्लभं लब्ध्वा कदाचिद्दैवयोगतः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006062093, "chapter_id": 26062, "verse_number": "२-६-९४", "content_sanskrit": "अनुग्रहेण महतां हरिं ज्ञात्वा विमुच्यते ।\nरोगग्राहं मोहजालमपारं भवसागरम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006062094, "chapter_id": 26062, "verse_number": "२-६-९५", "content_sanskrit": "न पश्यामि तितीर्षोरन्यद्रामस्मरणं विना ।\nनवनीयं यथा दध्नो ज्योतिः काष्ठादपि क्वचित् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006062095, "chapter_id": 26062, "verse_number": "२-६-९६", "content_sanskrit": "मन्थनैः साधनैरेवं परं ज्ञात्वा सुखी भवेत् ।\nआत्मा नित्योऽव्ययः सत्यः सर्वगः सर्वभृन्महान् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006062096, "chapter_id": 26062, "verse_number": "२-६-९७", "content_sanskrit": "अप्रमेयः स्वयञ्ज्योतिरग्राह्यो मनसापि यः ।\nसच्चिदानन्दरूपोऽसौ सर्वप्राणिहृदि स्थितः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006062097, "chapter_id": 26062, "verse_number": "२-६-९८", "content_sanskrit": "विनश्यत्स्वपि भावेषु न विनश्यति कर्हिचित् ।\nआकाशः सर्वभूतेषु स्थितस्तेजोजले तथा ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006062098, "chapter_id": 26062, "verse_number": "२-६-९९", "content_sanskrit": "आत्मा सर्वत्र निर्लेपः पार्थिवेषु यथानिलः ।\nभक्तानुकम्पी भगवान् साधूनां रक्षणाय च ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006062099, "chapter_id": 26062, "verse_number": "२-६-१००", "content_sanskrit": "आविर्भवति लोकेषुगुणीवाज्ञैः प्रतीयते ।\nएवंविवेकत्वया यो बुद्ध्या संशीलयेद्धृदि ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006062100, "chapter_id": 26062, "verse_number": "२-६-१०१", "content_sanskrit": "भक्तियोगेन सन्तुष्ट आत्मानं दर्शयेदजः ।\nततः कृतार्थो भवति सदा सर्वत्र निः स्पृहः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006062101, "chapter_id": 26062, "verse_number": "२-६-१०२", "content_sanskrit": "अतोऽहङ्कारमुत्सृज्य सानुबन्धे कलेवरे ।\nचरेदसंगो लोकेषु स्वप्नप्रायेषु निर्ममः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7006062102, "chapter_id": 26062, "verse_number": "२-६-१०३", "content_sanskrit": "क्व स्वप्ने नियतं धैर्यमिन्द्रजाले क्व सत्यता ।\nक्व नित्यता शरन्मेघे क्व वा सत्यं कलेवरे ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7006062103, "chapter_id": 26062, "verse_number": "२-६-१०४", "content_sanskrit": "अविद्याकर्मजनितं दृश्यमानं चरा चरम् ।\nज्ञात्वाचारवशी योगी ततः सिद्धिमवाप्स्यसि ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7006062104, "chapter_id": 26062, "verse_number": "२-६-१०५", "content_sanskrit": "इत्युक्त्वा ते गताः सर्वे साधवो दीनवत्सलाः ।\nसोऽहं तदुक्तमार्गेण तथैवाचरमन्वहम् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7006062105, "chapter_id": 26062, "verse_number": "२-६-१०६", "content_sanskrit": "ततोऽचिरेणात्मनीदं दृष्टवानहमद्भुतम् ।\nज्योतिर्मयं सदानन्दं शरच्छीतांशुनिर्मलम् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7006062106, "chapter_id": 26062, "verse_number": "२-६-१०७", "content_sanskrit": "निषिच्य सुखसन्दोहैर्मां कृत्वाधिकसस्पृहम् ।\nअन्तर्हितं महतेजो यथा सौदामिनी दिवि ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7006062107, "chapter_id": 26062, "verse_number": "२-६-१०८", "content_sanskrit": "भक्त्या तदेव मनसि भावयन्नहमद्भुतम् ।\nकाले कलेवरं त्यक्त्वा गतवान् हरिमव्ययम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7006062108, "chapter_id": 26062, "verse_number": "२-६-१०९", "content_sanskrit": "तस्येच्छया पुनर्ब्रह्मन् ब्रह्मणो मेऽभवज्जनिः ।\nअनुग्रहाद्भगवतस्त्रिषु लोकेषु निः स्पृहः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7006062109, "chapter_id": 26062, "verse_number": "२-६-११०", "content_sanskrit": "आपीडयन्मुहुर्वोणां गायमानश्चराम्यहम् ।\nइत्युक्त्वा मे स्वानुभवं ययौ यादृच्छिको मुनिः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7006062110, "chapter_id": 26062, "verse_number": "२-६-१११", "content_sanskrit": "ममापि परमाश्चर्यं सन्तोषश्च महानभूत् ।\nअतस्ते साधुसङ्गत्या भक्त्या च परमात्मनः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7006062111, "chapter_id": 26062, "verse_number": "२-६-११२", "content_sanskrit": "विशुद्धं निर्मलं शान्तं मनो निर्वृतिमेष्यति ।\nअनेकजन्मजनितं पातकं साधुसंगमे ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7006062112, "chapter_id": 26062, "verse_number": "२-६-११३", "content_sanskrit": "क्षिप्रं नश्यति धर्मज्ञ जलानां शरदो यथा ।\nवैश्य उवाच ।\nपीत्वा ते वाक्यपीयूषं स्वान्तं मे शान्तिमागमत् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7006062113, "chapter_id": 26062, "verse_number": "२-६-११४", "content_sanskrit": "सर्वतीर्थफलं मेऽध्य सञ्जातं तव दर्शनात् ।\nइति श्रुत्वा वचस्तस्य प्रोवाच ऋपिसत्तमः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7006062114, "chapter_id": 26062, "verse_number": "२-६-११५", "content_sanskrit": "लोमश उवाच ।\nहिताय तव राजेन्द्र त्रिवर्गफलमिच्छतः ।\nयत्त्वया सुकृतं भूरिवृषोत्सर्गं विना कृतम् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7006062115, "chapter_id": 26062, "verse_number": "२-६-११६", "content_sanskrit": "मन्येऽकिञ्चत्करं सर्वं नीहारसलिलं यथा ।\nवृषोत्सर्गसमं किञ्चित्साधनं न महीतले ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7006062116, "chapter_id": 26062, "verse_number": "२-६-११७", "content_sanskrit": "अनायासेन गच्छन्ति गतिं ते पुण्यकर्मणाम् ।\nवृषोत्सर्गः कृतो येन अश्वमेधस्य याजकः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7006062117, "chapter_id": 26062, "verse_number": "२-६-११८", "content_sanskrit": "उभौ समौ मया दृष्टौ दिव्यौ तौ शक्रसन्निधौ ।\nअतस्त्वं पुष्करं गत्वा वृषोत्सर्गं विधाय च ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7006062118, "chapter_id": 26062, "verse_number": "२-६-११९", "content_sanskrit": "ततो याहि गृहं साधो येन सर्वं कृतं भवेत् ।\nविपश्चिदुवाच ।\nततः स पुनरागत्य कार्तिक्यां पुष्करे वरे ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7006062119, "chapter_id": 26062, "verse_number": "२-६-१२०", "content_sanskrit": "वराहरूपी भगवान् यत्रास्ते यज्ञपूरकः ।\nचकार विधिवत्सर्वं युद्कमृषिसत्तमैः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7006062120, "chapter_id": 26062, "verse_number": "२-६-१२१", "content_sanskrit": "गतानि बहुतीर्थानि ततो लोमशसंगतिः ।\nततोऽधिकतरं जातं पुण्यं नीलविवाहजम् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7006062121, "chapter_id": 26062, "verse_number": "२-६-१२२", "content_sanskrit": "सभुक्त्वा विषयान् दिव्यान् विमानवरमाश्रितः ।\nतेन राजकुले जन्म वीरसेनस्य धर्मतः ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7006062122, "chapter_id": 26062, "verse_number": "२-६-१२३", "content_sanskrit": "वीरपञ्चाननाख्यातञ्चतुर्वर्गैकसाधकम् ।\nप्रकुर्वतो वृषोत्सर्गं तत्र ये परिचारकाः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7006062123, "chapter_id": 26062, "verse_number": "२-६-१२४", "content_sanskrit": "दिव्यरूपाभवन् स्पृष्टा गोपुच्छोदकशीकरैः ।\nसुरूपाः पुष्टवपुषः पश्यन्तो दूरसंस्थिताः ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7006062124, "chapter_id": 26062, "verse_number": "२-६-१२५", "content_sanskrit": "ततो दूरतरा ये च दृश्यन्ते मलिना जनाः ।\nदुर्भगा मलिना रूक्षाः कृशा विगतवाससः ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7006062125, "chapter_id": 26062, "verse_number": "२-६-१२६", "content_sanskrit": "वृषयज्ञमपश्यन्तो ये चासूयां प्रकुर्वते ।\nसर्वं निवेदितं राज्ञश्चरितं पूर्वजन्मनः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7006062126, "chapter_id": 26062, "verse_number": "२-६-१२७", "content_sanskrit": "धर्म्यं विचित्रमाख्यानं श्रुतं मे यत्पराशरात् ।\nअतस्त्वं स्वगृहं गच्छ कृपां कृत्वा ममोपरि ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7006062127, "chapter_id": 26062, "verse_number": "२-६-१२८", "content_sanskrit": "श्रुत्वा विपश्चिद्वाक्यं स विस्मयं परमं गतः ।\nगृहं जगाम विप्रोऽसौ प्रापितो राजसेवकैः ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7006062128, "chapter_id": 26062, "verse_number": "२-६-१२९", "content_sanskrit": "वसिष्ठ उवाच ।\nतस्माद्राजन् वृषोत्सर्गं वरिष्ठं सर्वकर्मणाम् ।\nसमाचर विधानेन यदि भीतो यमादपि ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7006062129, "chapter_id": 26062, "verse_number": "२-६-१३०", "content_sanskrit": "वृषोत्सर्गसमं किञ्चित्साधनं नदिवः परम् ।\nमया धर्मरहस्यं ते कथितं राजसत्तम ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7006062130, "chapter_id": 26062, "verse_number": "२-६-१३१", "content_sanskrit": "पतिपुत्रवती नारी भर्तुरग्रे मृता यदि ।\nवृषोत्सर्गं न कुर्वीत गां दद्याच्च पयस्विः नीम् ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7006062131, "chapter_id": 26062, "verse_number": "२-६-१३२", "content_sanskrit": "श्रीकृष्ण उवाच ।\nश्रुत्वा वाक्यं वसिष्ठस्य राजा मधुपुरीं गतः ।\nचकार विधिवत्सर्वं वृषोत्सर्गमहं खग ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7006062132, "chapter_id": 26062, "verse_number": "२-६-१३३", "content_sanskrit": "गृहं गत्वा स आत्मानं कृतकृत्यममन्यत ।\nकालेन निधनं प्राप्तो नीतो वैवस्वतानुगैः ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7006062133, "chapter_id": 26062, "verse_number": "२-६-१३४", "content_sanskrit": "स कालनगरं हित्वा गतो दूरतरं पथि ।\nश्राद्धदेवपुरं कुत्रेत्येवं दूतानपृच्छत ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7006062134, "chapter_id": 26062, "verse_number": "२-६-१३५", "content_sanskrit": "पापिनो यत्र पात्यन्ते याम्यै पापविशुद्धये ।\nयत्र देवः स धर्माधर्मविचेतनः ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7006062135, "chapter_id": 26062, "verse_number": "२-६-१३६", "content_sanskrit": "गतं पापपुरं तत्तु न द्रष्टव्यं भवादृशैः ।\nअग्रे दृष्ट्वा धर्मराजमूचुस्ते परमादरात् ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7006062136, "chapter_id": 26062, "verse_number": "२-६-१३७", "content_sanskrit": "दिव्यरूपस्तदा देवो देवगन्धर्वसंयुतः ।\nआत्मानं दर्शया मास तस्य राज्ञो महात्मनः ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7006062137, "chapter_id": 26062, "verse_number": "२-६-१३८", "content_sanskrit": "प्रणम्य दण्डवद्राजा कृताञ्जलिः पुरः स्थितः ।\nतुष्टाव बहुधा देवं हर्षपुरितमानसः ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7006062138, "chapter_id": 26062, "verse_number": "२-६-१३९", "content_sanskrit": "धर्मराजोऽपि राजानं प्रशस्येदमुवाच ह ।\nनीयतां देवलोकाय यत्र भोगाः सुपुष्कलाः ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7006062139, "chapter_id": 26062, "verse_number": "२-६-१४०", "content_sanskrit": "तद्वीरवाहनः श्रुत्वा पप्रच्छसमवर्तिनम् ।\nन जाने केन पुण्येन स्वर्गं नयसि मां विभो ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7006062140, "chapter_id": 26062, "verse_number": "२-६-१४१", "content_sanskrit": "धर्मराज उवाच ।\nत्वया कृतानि पुण्यानि दानं यज्ञाः सविस्तराः ।\nमथुरायां वृषोत्सर्गो वसिष्ठवचनात्किल ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7006062141, "chapter_id": 26062, "verse_number": "२-६-१४२", "content_sanskrit": "धर्मः स्वल्पोऽपि नृपते यदि सम्यगुपासितः ।\nद्विजदेवप्रसादेन स याति बहुविस्तरम् ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7006062142, "chapter_id": 26062, "verse_number": "२-६-१४३", "content_sanskrit": "इत्युक्त्वा यमुनाभ्राता क्षणादन्तर्धिमाययौ ।\nवीरबाहुर्दिवं गत्वा देवैः सह मुमोद ह ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7006062143, "chapter_id": 26062, "verse_number": "२-६-१४४", "content_sanskrit": "श्रीकृष्ण उवाच ।\nमया ते कथितं पक्षिन् वृषयज्ञः सुविस्तरः ।\nप्राणिनां कर्मनिर्हारं श्रुत्वा पापैः प्रमुच्यते ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}]