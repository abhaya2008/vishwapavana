[{"id": 7000610000, "chapter_id": 20610, "verse_number": "५-६९-१", "content_sanskrit": "ऋषय ऊचुः ।\nसम्यक्छ्रुतो महाभाग त्वत्तो रामाश्वमेधकः ।\nइदानीं वद माहात्म्यं श्रीकृष्णस्य महात्मनः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000610001, "chapter_id": 20610, "verse_number": "५-६९-२", "content_sanskrit": "सूत उवाच ।\nशृण्वंतु मुनिशार्दूलाः श्रीकृष्णचरितामृतम् ।\nशिवा पप्रच्छ भूतेशं यत्तद्वः कीर्तयाम्यहम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000610002, "chapter_id": 20610, "verse_number": "५-६९-३", "content_sanskrit": "एकदा पार्वती देवी शिवं संस्निग्धमानसा ।\nप्रणयेन नमस्कृत्य प्रोवाच वचनं त्विदम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000610003, "chapter_id": 20610, "verse_number": "५-६९-४", "content_sanskrit": "पार्वत्युवाच ।\nअनंतकोटिब्रह्मांड तद्बाह्याभ्यंतरस्थितेः ।\nविष्णोः स्थानं परं तेषां प्रधानं वरमुत्तमम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000610004, "chapter_id": 20610, "verse_number": "५-६९-५", "content_sanskrit": "यत्परं नास्ति कृष्णस्य प्रियं स्थानं मनोरमम् ।\nतत्सर्वं श्रोतुमिच्छामि कथयस्व महाप्रभो॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000610005, "chapter_id": 20610, "verse_number": "५-६९-६", "content_sanskrit": "ईश्वर उवाच ।\nगुह्याद्गुह्यतरं गुह्यं परमानंदकारकम् ।\nअत्यद्भुतं रहःस्थानमानंदं परमं परम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000610006, "chapter_id": 20610, "verse_number": "५-६९-७", "content_sanskrit": "दुर्लभानां च परमं दुर्लभं मोहनं परम् ।\nसर्वशक्तिमयं देवि सर्वस्थानेषु गोपितम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000610007, "chapter_id": 20610, "verse_number": "५-६९-८", "content_sanskrit": "सात्वतां स्थानमूर्द्धन्यं विष्णोरत्यंतदुर्लभम् ।\nनित्यं वृंदावनं नाम ब्रह्मांडोपरि संस्थितम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000610008, "chapter_id": 20610, "verse_number": "५-६९-९", "content_sanskrit": "पूर्णब्रह्मसुखैश्वर्यं नित्यमानंदमव्ययम् ।\nवैकुंठादि तदंशांशं स्वयं वृंदावनं भुवि॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000610009, "chapter_id": 20610, "verse_number": "५-६९-१०", "content_sanskrit": "गोलोकैश्वर्यं यत्किंचिद्गोकुले तत्प्रतिष्ठितम् ।\nवैकुंठवैभवं यद्वै द्वारिकायां प्रतिष्ठितम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000610010, "chapter_id": 20610, "verse_number": "५-६९-११", "content_sanskrit": "यद्ब्रह्मपरमैश्वर्यं नित्यं वृंदावनाश्रयम् ।\nकृष्णधामपरं तेषां वनमध्ये विशेषतः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000610011, "chapter_id": 20610, "verse_number": "५-६९-१२", "content_sanskrit": "तस्मात्त्रैलोक्यमध्ये तु पृथ्वी धन्येति विश्रुता ।\nयस्मान्माथुरकं नाम विष्णोरेकांतवल्लभम्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000610012, "chapter_id": 20610, "verse_number": "५-६९-१३", "content_sanskrit": "स्वस्थानमधिकं नामधेयं माथुरमंडलम् ।\nनिगूढं विविधं स्थानं पुर्यभ्यंतरसंस्थितम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000610013, "chapter_id": 20610, "verse_number": "५-६९-१४", "content_sanskrit": "सहस्रपत्रकमलाकारं माथुरमंडलम् ।\nविष्णुचक्रपरिभ्रामाद्धाम वैष्णवमद्भुतम्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000610014, "chapter_id": 20610, "verse_number": "५-६९-१५", "content_sanskrit": "कर्णिकापर्णविस्तारं रहस्यद्रुममीरितम् ।\nप्रधानं द्वादशारण्यं माहात्म्यं कथितं क्रमात्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000610015, "chapter_id": 20610, "verse_number": "५-६९-१६", "content_sanskrit": "भद्र श्री लोह भांडीर महाताल खदीरकाः ।\nबकुलं कुमुदं काम्यं मधु वृंदावनं तथा॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000610016, "chapter_id": 20610, "verse_number": "५-६९-१७", "content_sanskrit": "द्वादशैतावती संख्या कालिंद्याः सप्त पश्चिमे ।\nपूर्वे पंचवनं प्रोक्तं तत्रास्ति गुह्यमुत्तमम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000610017, "chapter_id": 20610, "verse_number": "५-६९-१८", "content_sanskrit": "महारण्यं गोकुलाख्यं मधु वृंदावनं तथा ।\nअन्यच्चोपवनं प्रोक्तं कृष्णक्रीडारसस्थलम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000610018, "chapter_id": 20610, "verse_number": "५-६९-१९", "content_sanskrit": "कदंबखंडनं नंदवनं नंदीश्वरं तथा ।\nनंदनंदनखंडं च पलाशाशोककेतकी॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000610019, "chapter_id": 20610, "verse_number": "५-६९-२०", "content_sanskrit": "सुगंधमानसं कैलममृतं भोजनस्थलम् ।\nसुखप्रसाधनं वत्सहरणं शेषशायिकम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000610020, "chapter_id": 20610, "verse_number": "५-६९-२१", "content_sanskrit": "श्यामपूर्वो दधिग्रामश्चक्रभानुपुरं तथा ।\nसंकेतं द्विपदं चैव बालक्रीडनधूसरम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000610021, "chapter_id": 20610, "verse_number": "५-६९-२२", "content_sanskrit": "कामद्रुमं सुललितमुत्सुकं चापि काननम् ।\nनानाविधरसक्रीडा नानालीलारसस्थलम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000610022, "chapter_id": 20610, "verse_number": "५-६९-२३", "content_sanskrit": "नागविस्तारविष्टंभं रहस्यद्रुममीरितम् ।\nसहस्रपत्रकमलं गोकुलाख्यं महत्पदम्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000610023, "chapter_id": 20610, "verse_number": "५-६९-२४", "content_sanskrit": "कर्णिकातन्महद्धाम गोविंदस्थानमुत्तमम् ।\nतत्रोपरि स्वर्णपीठे मणिमंडपमंडितम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000610024, "chapter_id": 20610, "verse_number": "५-६९-२५", "content_sanskrit": "कर्णिकायां क्रमाद्दिक्षु विदिक्षु दलमीरितम् ।\nयद्दलं दक्षिणे प्रोक्तं परं गुह्योत्तमोत्तमम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000610025, "chapter_id": 20610, "verse_number": "५-६९-२६", "content_sanskrit": "तस्मिन्दले महापीठं निगमागमदुर्गमम् ।\nयोगींद्रैरपि दुष्प्रापं सर्वात्मा यच्च गोकुलम्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000610026, "chapter_id": 20610, "verse_number": "५-६९-२७", "content_sanskrit": "द्वितीयं दलमाग्नेय्यां तद्रहस्यदलं तथा ।\nसंकेतं द्विपदं चैव कुटीद्वौ तत्कुले स्थितौ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000610027, "chapter_id": 20610, "verse_number": "५-६९-२८", "content_sanskrit": "पूर्वं दलं तृतीयं च प्रधानस्थानमुत्तमम् ।\nगंगादिसर्वतीर्थानां स्पर्शाच्छतगुणं स्मृतम्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000610028, "chapter_id": 20610, "verse_number": "५-६९-२९", "content_sanskrit": "चतुर्थं दलमैशान्यां सिद्धपीठेऽपि तत्पदम् ।\nव्यायामनूतनागोपी तत्र कृष्णं पतिं लभेत्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000610029, "chapter_id": 20610, "verse_number": "५-६९-३०", "content_sanskrit": "वस्त्रालंकारहरणं तद्दले समुदाहृतम् ।\nउत्तरे पंचमं प्रोक्तं दलं सर्वदलोत्तमम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000610030, "chapter_id": 20610, "verse_number": "५-६९-३१", "content_sanskrit": "द्वादशादित्यमत्रैव दलं च कर्णिकासमम् ।\nवायव्यां तु दलं षष्ठं तत्र कालीह्रदः स्मृतः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000610031, "chapter_id": 20610, "verse_number": "५-६९-३२", "content_sanskrit": "दलोत्तमोत्तमं चैव प्रधानं स्थानमुच्यते ।\nसर्वोत्तमदलं चैव पश्चिमे सप्तमं स्मृतम्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000610032, "chapter_id": 20610, "verse_number": "५-६९-३३", "content_sanskrit": "यज्ञपत्नीगणानां च तदीप्सितवरप्रदम् ।\nअत्रासुरोऽपि निर्वाणं प्राप त्रिदशदुर्लभम्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000610033, "chapter_id": 20610, "verse_number": "५-६९-३४", "content_sanskrit": "ब्रह्ममोहनमत्रैव दलं ब्रह्मह्रदावहम् ।\nनैरृत्यां तु दलं प्रोक्तमष्टमं व्योमघातनम्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000610034, "chapter_id": 20610, "verse_number": "५-६९-३५", "content_sanskrit": "शंखचूडवधस्तत्र नानाकेलिरसस्थलम् ।\nश्रुतमष्टदलं प्रोक्तं वृंदारण्यांतरस्थितम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000610035, "chapter_id": 20610, "verse_number": "५-६९-३६", "content_sanskrit": "श्रीमद्वृंदावनं रम्यं यमुनायाः प्रदक्षिणम् ।\nशिवलिंगमधिष्ठानं दृष्टं गोपीश्वराभिधम्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000610036, "chapter_id": 20610, "verse_number": "५-६९-३७", "content_sanskrit": "तद्बाह्ये षोडशदलं श्रियापूर्णं तमीश्वरम् ।\nसर्वासु दिक्षु यत्प्रोक्तं प्रादक्षिण्याद्यथाक्रमम्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000610037, "chapter_id": 20610, "verse_number": "५-६९-३८", "content_sanskrit": "महत्पदं महद्धाम स्वधामाधावसंज्ञकम् ।\nप्रथमैकदलं श्रेष्ठं माहात्म्यं कर्णिकासमम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000610038, "chapter_id": 20610, "verse_number": "५-६९-३९", "content_sanskrit": "तत्र गोवर्द्धनगिरौ रम्ये नित्यरसाश्रये ।\nकर्णिकायां महालीला तल्लीला रसगह्वरौ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000610039, "chapter_id": 20610, "verse_number": "५-६९-४०", "content_sanskrit": "यत्र कृष्णो नित्यवृंदाकाननस्य पतिर्भवेत् ।\nकृष्णो गोविंदतां प्राप्तः किमन्यैर्बहुभाषितैः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000610040, "chapter_id": 20610, "verse_number": "५-६९-४१", "content_sanskrit": "दलं तृतीयमाख्यातं सर्वश्रेष्ठोत्तमोत्तमम् ।\nचतुर्थं दलमाख्यातं महाद्भुतरसस्थलम्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000610041, "chapter_id": 20610, "verse_number": "५-६९-४२", "content_sanskrit": "नंदीश्वरवनं रम्यं तत्र नंदालयः स्मृतः ।\nकर्णिकादलमाहात्म्यं पंचमं दलमुच्यते॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000610042, "chapter_id": 20610, "verse_number": "५-६९-४३", "content_sanskrit": "अधिष्ठाताऽत्र गोपालो धेनुपालनतत्परः ।\nषष्ठं दलं यदाख्यातं तत्र नंदवनं स्मृतम्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000610043, "chapter_id": 20610, "verse_number": "५-६९-४४", "content_sanskrit": "सप्तमं बकुलारण्यं दलं रम्यं प्रकीर्तितम् ।\nतत्राष्टमं तालवनं तत्र धेनुवधः स्मृतः॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000610044, "chapter_id": 20610, "verse_number": "५-६९-४५", "content_sanskrit": "नवमं कुमुदारण्यं दलं रम्यं प्रकीर्तितम् ।\nकामारण्यं च दशमं प्रधानं सर्वकारणम्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000610045, "chapter_id": 20610, "verse_number": "५-६९-४६", "content_sanskrit": "ब्रह्मप्रसाधनं तत्र विष्णुच्छद्मप्रदर्शनम् ।\nकृष्णक्रीडारसस्थानं प्रधानं दलमुच्यते॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000610046, "chapter_id": 20610, "verse_number": "५-६९-४७", "content_sanskrit": "दलमेकादशं प्रोक्तं भक्तानुग्रहकारणम् ।\nनिर्माणं सेतुबंधस्य नानावनमयस्थलम्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000610047, "chapter_id": 20610, "verse_number": "५-६९-४८", "content_sanskrit": "भांडीरं द्वादशदलं वनं रम्यं मनोहरम् ।\nकृष्णः क्रीडारतस्तत्र श्रीदामादिभिरावृतः॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000610048, "chapter_id": 20610, "verse_number": "५-६९-४९", "content_sanskrit": "त्रयोदशं दलं श्रेष्ठं तत्र भद्रवनं स्मृतम् ।\nचतुर्दशदलं प्रोक्तं सर्वसिद्धिप्रदस्थलम्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000610049, "chapter_id": 20610, "verse_number": "५-६९-५०", "content_sanskrit": "श्रीवनं तत्र रुचिरं सर्वैश्वर्यस्य कारणम् ।\nकृष्णक्रीडादलमयं श्रीकांतिकीर्तिवर्द्धनम्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000610050, "chapter_id": 20610, "verse_number": "५-६९-५१", "content_sanskrit": "दलं पंचदशं श्रेष्ठं तत्र लोहवनं स्मृतम् ।\nकथितं षोडशदलं माहात्म्यं कर्णिकासमम्॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000610051, "chapter_id": 20610, "verse_number": "५-६९-५२", "content_sanskrit": "महावनं तत्र गीतं तत्रास्ति गुह्यमुत्तमम् ।\nबालक्रीडारतस्तत्र वत्सपालैः समावृतः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000610052, "chapter_id": 20610, "verse_number": "५-६९-५३", "content_sanskrit": "पूतनादिवधस्तत्र यमलार्जुनभंजनम् ।\nअधिष्ठाता तत्र बालगोपालः पंचमाब्दिकः॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000610053, "chapter_id": 20610, "verse_number": "५-६९-५४", "content_sanskrit": "नाम्ना दामोदरः प्रोक्तः प्रेमानंदरसार्णवः ।\nदलं प्रसिद्धमाख्यातं सर्वश्रेष्ठदलोत्तमम्॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000610054, "chapter_id": 20610, "verse_number": "५-६९-५५", "content_sanskrit": "कृष्णक्रीडा च किंजल्की विहारदलमुच्यते ।\nसिद्धप्रधानकिंजल्क दलं च समुदाहृतम्॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000610055, "chapter_id": 20610, "verse_number": "५-६९-५६", "content_sanskrit": "पार्वत्युवाच ।\nवृंदारण्यस्य माहात्म्यं रहस्यं वा किमद्भुतम् ।\nतदहं श्रोतुमिच्छामि कथयस्व महाप्रभो॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000610056, "chapter_id": 20610, "verse_number": "५-६९-५७", "content_sanskrit": "ईश्वर उवाच ।\nकथितं ते प्रियतमे गुह्याद्गुह्योत्तमोत्तमम् ।\nरहस्यानां रहस्यं यद्दुर्लभानां च दुर्लभम्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000610057, "chapter_id": 20610, "verse_number": "५-६९-५८", "content_sanskrit": "त्रैलोक्यगोपितं देवि देवेश्वरसुपूजितम् ।\nब्रह्मादिवांछितं स्थानं सुरसिद्धादिसेवितम्॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000610058, "chapter_id": 20610, "verse_number": "५-६९-५९", "content_sanskrit": "योगींद्रा हि सदा भक्त्या तस्य ध्यानैकतत्पराः ।\nअप्सरोभिश्च गंधर्वैर्नृत्यगीतनिरंतरम्॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000610059, "chapter_id": 20610, "verse_number": "५-६९-६०", "content_sanskrit": "श्रीमद्वृंदावनं रम्यं पूर्णानंदरसाश्रयम् ।\nभूरिचिंतामणिस्तोयममृतं रसपूरितम्॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000610060, "chapter_id": 20610, "verse_number": "५-६९-६१", "content_sanskrit": "वृक्षं गुरुद्रुमं तत्र सुरभीवृंदसेवितम् ।\nस्त्रीं लक्ष्मीं पुरुषं विष्णुं तद्दशांशसमुद्भवम्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000610061, "chapter_id": 20610, "verse_number": "५-६९-६२", "content_sanskrit": "तत्र कैशोरवयसं नित्यमानंदविग्रहम् ।\nगतिनाट्यं कलालापस्मितवक्त्रं निरंतरम्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000610062, "chapter_id": 20610, "verse_number": "५-६९-६३", "content_sanskrit": "शुद्धसत्वैः प्रेमपूर्णैर्वैष्णवैस्तद्वनाश्रितम् ।\nपूर्णब्रह्मसुखेमग्नं स्फुरत्तन्मूर्तितन्मयम्॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000610063, "chapter_id": 20610, "verse_number": "५-६९-६४", "content_sanskrit": "मत्तकोकिलभृंगाद्यैः कूजत्कलमनोहरम् ।\nकपोलशुकसंगीतमुन्मत्तालि सहस्रकम्॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000610064, "chapter_id": 20610, "verse_number": "५-६९-६५", "content_sanskrit": "भुजंगशत्रुनृत्याढ्यं सकलामोदविभ्रमम् ।\nनानावर्णैश्च कुसुमैस्तद्रेणुपरिपूरितम्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000610065, "chapter_id": 20610, "verse_number": "५-६९-६६", "content_sanskrit": "पूर्णेंदुनित्याभ्युदयं सूर्यमंदांशुसेवितम् ।\nअदुःखं दुःखविच्छेदं जरामरणवर्जितम्॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000610066, "chapter_id": 20610, "verse_number": "५-६९-६७", "content_sanskrit": "अक्रोधं गतमात्सर्यमभिन्नमनहंकृतम् ।\nपूर्णानंदामृतरसं पूर्णप्रेमसुखार्णवम्॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000610067, "chapter_id": 20610, "verse_number": "५-६९-६८", "content_sanskrit": "गुणातीतं महद्धाम पूर्णप्रेमस्वरूपकम् ।\nवृक्षादिपुलकैर्यत्र प्रेमानंदाश्रुवर्षितम्॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000610068, "chapter_id": 20610, "verse_number": "५-६९-६९", "content_sanskrit": "किं पुनश्चेतनायुक्तैर्विष्णुभक्तैः किमुच्यते ।\nगोविंदांघ्रिरजः स्पर्शान्नित्यं वृंदावनं भुवि॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000610069, "chapter_id": 20610, "verse_number": "५-६९-७०", "content_sanskrit": "सहस्रदलपद्मस्य वृंदारण्यं वराटकम् ।\nयस्य स्पर्शनमात्रेण पृथ्वी धन्या जगत्त्रये॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000610070, "chapter_id": 20610, "verse_number": "५-६९-७१", "content_sanskrit": "गुह्याद्गुह्यतरं रम्यं मध्ये वृंदावनं भुवि ।\nअक्षरं परमानंदं गोविंदस्थानमव्ययम्॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000610071, "chapter_id": 20610, "verse_number": "५-६९-७२", "content_sanskrit": "गोविंददेहतोऽभिन्नं पूर्णब्रह्मसुखाश्रयम् ।\nमुक्तिस्तत्र रजःस्पर्शात्तन्माहात्म्यं किमुच्यते॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000610072, "chapter_id": 20610, "verse_number": "५-६९-७३", "content_sanskrit": "तस्मात्सर्वात्मना देवि हृदिस्थं तद्वनं कुरु ।\nवृंदावनविहारेषु कृष्णं कैशोरविग्रहम्॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000610073, "chapter_id": 20610, "verse_number": "५-६९-७४", "content_sanskrit": "कालिंदी चाकरोद्यस्य कर्णिकायां प्रदक्षिणाम् ।\nलीलानिर्वाणगंभीरं जलं सौरभमोहनम्॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000610074, "chapter_id": 20610, "verse_number": "५-६९-७५", "content_sanskrit": "आनंदामृत तन्मिश्रमकरंदघनालयम् ।\nपद्मोत्पलाद्यैः कुसुमैर्नानावर्णसमुज्जवलम्॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000610075, "chapter_id": 20610, "verse_number": "५-६९-७६", "content_sanskrit": "चक्रवाकादिविहगैर्मंजुनानाकलस्वनैः ।\nशोभमानं जलं रम्यं तरंगातिमनोरमम्॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000610076, "chapter_id": 20610, "verse_number": "५-६९-७७", "content_sanskrit": "तस्योभयतटी रम्या शुद्धकांचननिर्मिता ।\nगंगाकोटिगुणा प्रोक्ता यत्र स्पर्शवराटकः॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000610077, "chapter_id": 20610, "verse_number": "५-६९-७८", "content_sanskrit": "कर्णिकायां कोटिगुणो यत्र क्रीडारतो हरिः ।\nकालिंदीकर्णिका कृष्णमभिन्नमेकविग्रहम्॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000610078, "chapter_id": 20610, "verse_number": "५-६९-७९", "content_sanskrit": "पार्वत्युवाच ।\nगोविंदस्य किमाश्चर्यं सौंदर्याकृतविग्रह ।\nतदहं श्रोतुमिच्छामि कथयस्व दयानिधे॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000610079, "chapter_id": 20610, "verse_number": "५-६९-८०", "content_sanskrit": "ईश्वर उवाच ।\nमध्ये वृंदावने रम्ये मंजुमंजीरशोभिते ।\nयोजनाश्रितसद्वृक्ष शाखापल्लवमंडिते॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000610080, "chapter_id": 20610, "verse_number": "५-६९-८१", "content_sanskrit": "तन्मध्ये मंजुभवने योगपीठं समुज्जवलम् ।\nतदष्टकोणनिर्माणं नानादीप्तिमनोहरम्॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000610081, "chapter_id": 20610, "verse_number": "५-६९-८२", "content_sanskrit": "तस्योपरि च माणिक्यरत्नसिंहासनं शुभम् ।\nतस्मिन्नष्टदलं पद्मं कर्णिकायां सुखाश्रयम्॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000610082, "chapter_id": 20610, "verse_number": "५-६९-८३", "content_sanskrit": "गोविंदस्य परं स्थानं किमस्य महिमोच्यते ।\nश्रीमद्गोविंदमंत्रस्थ बल्लवीवृंदसेवितम्॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000610083, "chapter_id": 20610, "verse_number": "५-६९-८४", "content_sanskrit": "दिव्यव्रजवयोरूपं कृष्णं वृंदावनेश्वरम् ।\nव्रजेंद्रं संततैश्वर्यं व्रजबालैकवल्लभम्॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000610084, "chapter_id": 20610, "verse_number": "५-६९-८५", "content_sanskrit": "यौवनोद्भिन्नकैशोरं वयसाद्भुतविग्रहम् ।\nअनादिमादिं सर्वेषां नंदगोपप्रियात्मजम्॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000610085, "chapter_id": 20610, "verse_number": "५-६९-८६", "content_sanskrit": "श्रुतिमृग्यमजं नित्यं गोपीजनमनोहरम् ।\nपरंधाम परं रूपं द्विभुजं गोकुलेश्वरम्॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000610086, "chapter_id": 20610, "verse_number": "५-६९-८७", "content_sanskrit": "बल्लवीनंदनं ध्यायेन्निर्गुणस्यैककारणम् ।\nसुश्रीमंतं नवं स्वच्छं श्यामधाममनोहरम्॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000610087, "chapter_id": 20610, "verse_number": "५-६९-८८", "content_sanskrit": "नवीननीरदश्रेणी सुस्निग्धं मंजुकुंडलम् ।\nफुल्लेंदीवरसत्कांति सुखस्पर्शं सुखावहम्॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000610088, "chapter_id": 20610, "verse_number": "५-६९-८९", "content_sanskrit": "दलितांजनपुंजाभ चिक्कणं श्याममोहनम् ।\nसुस्निग्धनीलकुटिलाशेषसौरभकुंतलम्॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000610089, "chapter_id": 20610, "verse_number": "५-६९-९०", "content_sanskrit": "तदूर्ध्वं दक्षिणे काले श्यामचूडामनोहरम् ।\nनानावर्णोज्ज्वलं राजच्छिखंडिदलमंडितम्॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000610090, "chapter_id": 20610, "verse_number": "५-६९-९१", "content_sanskrit": "मंदारमंजुगोपुच्छाचूडं चारुविभूषणम् ।\nक्वचिद्बृहद्दलश्रेणी मुकुटेनाभिमंडितम्॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000610091, "chapter_id": 20610, "verse_number": "५-६९-९२", "content_sanskrit": "अनेकमणिमाणिक्यकिरीटभूषणं क्वचित् ।\nलोलालकवृतं राजत्कोटिचंद्रसमाननम्॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000610092, "chapter_id": 20610, "verse_number": "५-६९-९३", "content_sanskrit": "कस्तूरीतिलकं भ्राजन्मंजुगोरोचनान्वितम् ।\nनीलेंदीवरसुस्निग्ध सुदीर्घदललोचनम्॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000610093, "chapter_id": 20610, "verse_number": "५-६९-९४", "content_sanskrit": "आनृत्यद्भ्रूलताश्लेषस्मितं साचि निरीक्षणम् ।\nसुचारून्नतसौंदर्य नासाग्राति मनोहरम्॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000610094, "chapter_id": 20610, "verse_number": "५-६९-९५", "content_sanskrit": "नासाग्रगजमुक्तांशु मुग्धीकृत जगत्त्रयम् ।\nसिंदूरारुणसुस्निग्धाधरौष्ठसुमनोहरम्॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000610095, "chapter_id": 20610, "verse_number": "५-६९-९६", "content_sanskrit": "नानावर्णोल्लसत्स्वर्णमकराकृतिकुंडलम् ।\nतद्रश्मिपुंजसद्गंड मुकुराभलसद्द्युतिम्॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000610096, "chapter_id": 20610, "verse_number": "५-६९-९७", "content_sanskrit": "कर्णोत्पलसुमंदारमकरोत्तंस भूषितम् ।\nश्रीवत्सकौस्तुभोरस्कं मुक्ताहारस्फुरद्गलम्॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000610097, "chapter_id": 20610, "verse_number": "५-६९-९८", "content_sanskrit": "विलसद्दिव्यमाणिक्यं मंजुकांचन मिश्रितम् ।\nकरे कंकणकेयूरं किंकिणीकटिशोभितम्॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000610098, "chapter_id": 20610, "verse_number": "५-६९-९९", "content_sanskrit": "मंजुमंजीरसौंदर्य्यश्रीमदंघ्रि विराजितम् ।\nकर्पूरागुरुकस्तूरीविलसच्चंदनादिकम्॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000610099, "chapter_id": 20610, "verse_number": "५-६९-१००", "content_sanskrit": "गोरोचनादिसंमिश्र दिव्यांगरागचित्रितम् ।\nस्निग्धपीतपटी राजत्प्रपदांदोलितांजनम्॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000610100, "chapter_id": 20610, "verse_number": "५-६९-१०१", "content_sanskrit": "गंभीरनाभिकमलं रोमराजीनतस्रजम् ।\nसुवृत्तजानुयुगलं पादपद्ममनोहरम्॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000610101, "chapter_id": 20610, "verse_number": "५-६९-१०२", "content_sanskrit": "ध्वजवज्रांकुशांभोज करांघ्रि तलशोभितम् ।\nनखेंदु किरणश्रेणी पूर्णब्रह्मैककारणम्॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000610102, "chapter_id": 20610, "verse_number": "५-६९-१०३", "content_sanskrit": "केचिद्वदंति तस्यांशं ब्रह्मचिद्रूपमद्वयम् ।\nतद्दशांशं महाविष्णुं प्रवदंति मनीषिणः॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000610103, "chapter_id": 20610, "verse_number": "५-६९-१०४", "content_sanskrit": "योगींद्रैः सनकाद्यैश्च तदेव हृदि चिंत्यते ।\nत्रिभंगं ललिताशेष निर्माणसारनिर्मितम्॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000610104, "chapter_id": 20610, "verse_number": "५-६९-१०५", "content_sanskrit": "तिर्यग्ग्रीवजितानंतकोटिकंदर्पसुंदरम् ।\nवामांसार्पित सद्गण्डस्फुरत्कांचनकुंडलम्॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000610105, "chapter_id": 20610, "verse_number": "५-६९-१०६", "content_sanskrit": "सहापांगेक्षणस्मेरं कोटिमन्मथसुंदरम् ।\nकुंचिताधरविन्यस्त वंशीमंजुकलस्वनैः॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000610106, "chapter_id": 20610, "verse_number": "५-६९-१०७", "content_sanskrit": "जगत्त्रयं मोहयंतं मग्नं प्रेमसुधार्णवे ।\nश्रीपार्वत्युवाच ।\nपरमं कारणं कृष्णं गोविंदाख्यं महत्पदम्॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000610107, "chapter_id": 20610, "verse_number": "५-६९-१०८", "content_sanskrit": "वृंदावनेश्वरं नित्यं निर्गुणस्यैककारणम् ।\nतत्तद्रहस्यमाहात्म्यं किमाश्चर्यं च सुंदरम्॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000610108, "chapter_id": 20610, "verse_number": "५-६९-१०९", "content_sanskrit": "तद्ब्रूहि देवदेवेश श्रोतुमिच्छाम्यहं प्रभो ।\nईश्वर उवाच ।\nयदंघ्रिनखचंद्रांशु महिमांतो न गम्यते॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000610109, "chapter_id": 20610, "verse_number": "५-६९-११०", "content_sanskrit": "तन्माहात्म्यं कियद्देवि प्रोच्यते त्वं मुदा शृणु ।\nअनंतकोटिब्रह्मांडे अनंतत्रिगुणोच्छ्रये॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000610110, "chapter_id": 20610, "verse_number": "५-६९-१११", "content_sanskrit": "तत्कलाकोटिकोट्यंशा ब्रह्मविष्णुमहेश्वराः ।\nसृष्टिस्थित्यादिना युक्तास्तिष्ठंति तस्य वैभवाः॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000610111, "chapter_id": 20610, "verse_number": "५-६९-११२", "content_sanskrit": "तद्रूपकोटिकोट्यंशाः कलाः कंदर्पविग्रहाः ।\nजगन्मोहं प्रकुर्वंति तदंडांतरसंस्थिताः॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000610112, "chapter_id": 20610, "verse_number": "५-६९-११३", "content_sanskrit": "तद्देहविलसत्कांतिकोटिकोट्यंशको विभुः ।\nतत्प्रकाशस्य कोट्यंश रश्मयो रविविग्रहाः॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000610113, "chapter_id": 20610, "verse_number": "५-६९-११४", "content_sanskrit": "तस्य स्वदेहकिरणैः परानंद रसामृतैः ।\nपरमामोदचिद्रूपैर्निर्गुणस्यैककारणैः॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000610114, "chapter_id": 20610, "verse_number": "५-६९-११५", "content_sanskrit": "तदंशकोटिकोट्यंशा जीवंति किरणात्मकाः ।\nतदंघ्रिपंकजद्वंद्व नखचंद्र मणिप्रभाः॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000610115, "chapter_id": 20610, "verse_number": "५-६९-११६", "content_sanskrit": "आहुः पूर्णब्रह्मणोऽपि कारणं वेददुर्गमम् ।\nतदंशसौरभानंतकोट्यंशो विश्वमोहनः॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000610116, "chapter_id": 20610, "verse_number": "५-६९-११७", "content_sanskrit": "तत्स्पर्शपुष्पगंधादि नानासौरभसंभवः ।\nतत्प्रिया प्रकृतिस्त्वाद्या राधिका कृष्णवल्लभा॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7000610117, "chapter_id": 20610, "verse_number": "५-६९-११८", "content_sanskrit": "तत्कलाकोटिकोट्यंशा दुर्गाद्यास्त्रिगुणात्मिकाः ।\nतस्या अंघ्रिरजः स्पर्शात्कोटिविष्णुः प्रजायते॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}]