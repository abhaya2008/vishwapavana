[{"id": 2122557, "chapter_id": 3630, "verse_number": "", "content_sanskrit": "दुर्योधनवशीकृतेन धृतराष्ट्रेण युधिष्ठिरानयनार्थं विदुरस्य प्रेषणम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2122558, "chapter_id": 3630, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2122559, "chapter_id": 3630, "verse_number": "१", "content_sanskrit": "यामेतामुत्तमां लक्ष्मीं दृष्टवानसि पाण्डवे ।\nतस्याः प्राप्तावुपायं मे शृणु सत्यपराक्रम ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2122560, "chapter_id": 3630, "verse_number": "२", "content_sanskrit": "अहमक्षेष्वभिज्ञो हि पृथिव्यामपि भारत ।\nहृदयज्ञः पणज्ञश्च विशेषज्ञश्च देवने ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2122561, "chapter_id": 3630, "verse_number": "३", "content_sanskrit": "द्यूतप्रियश्च कौन्तेयो न च जानाति देवितुम् ।\nआहूतश्चैष्यति व्यक्तं दीव्यावेत्याह्वय स्वयम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2122562, "chapter_id": 3630, "verse_number": "४", "content_sanskrit": "एवमुक्तः शकुनिना राजा दुर्योधनस्तदा ।\nधृतराष्ट्रं नरव्याघ्रमपदान्तरमब्रवीत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2122563, "chapter_id": 3630, "verse_number": "५", "content_sanskrit": "अयमुत्सहते राजन् श्रियमाहर्तुमक्षवित् ।\nद्यूतेन पाण्डुपुत्रस्य तदनुज्ञातुमर्हसि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2122564, "chapter_id": 3630, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2122565, "chapter_id": 3630, "verse_number": "६", "content_sanskrit": "क्षत्ता मन्त्री महाप्राज्ञः स्थितो यस्यास्मि शासने ।\nतेन सङ्गम्य वेत्स्यामि कार्याकार्यविनिश्चयम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2122566, "chapter_id": 3630, "verse_number": "७", "content_sanskrit": "स हि धर्मं पुरस्कृत्य दीर्घदर्शी परं हितम् ।\nउभयोः पक्षयोः पथ्यं वक्ष्यत्यर्थविनिश्चयम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2122567, "chapter_id": 3630, "verse_number": "८", "content_sanskrit": "अथवा वासुदेवं वा भीष्मं वा कार्यनिश्चये ।\nआहूय मन्त्रणं कुर्यां कथं व्यवसितं तव ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2122568, "chapter_id": 3630, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2122569, "chapter_id": 3630, "verse_number": "९", "content_sanskrit": "निवर्तयिष्यति त्वाऽसौ यदि क्षत्ता समेष्यति ।\nनिवृत्ते त्वयि राजेन्द्र मरिष्यामि न संशयः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2122570, "chapter_id": 3630, "verse_number": "१०", "content_sanskrit": "स त्वं मयि मृते राजन् विदुरेण सुखी भव ।\nभोक्ष्यसे पृथिवीं कृत्स्नां किं मया त्वं करिष्यसि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2122571, "chapter_id": 3630, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2122572, "chapter_id": 3630, "verse_number": "११", "content_sanskrit": "आर्तवाक्यं तु तत् तस्य प्रणयोक्तं निशम्य सः ।\nदुर्योधनस्य शान्त्यर्थं धृतराष्ट्रोऽन्वशात् तदा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2122573, "chapter_id": 3630, "verse_number": "१२", "content_sanskrit": "स्थूणासहस्रैर्महतीं शतद्वारां सभां मम ।\nमनोहरां दर्शनीयामाशु कुर्वन्तु शिल्पिनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2122574, "chapter_id": 3630, "verse_number": "१३", "content_sanskrit": "ततः संस्तीर्य रत्नैस्तामक्षान् संस्थाप्य सर्वशः ।\nसंस्कृतां सुप्रवेशां च निवेदयत माचिरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2122575, "chapter_id": 3630, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2122576, "chapter_id": 3630, "verse_number": "१४", "content_sanskrit": "दुर्योधनस्य शान्त्यर्थमिति निश्चित्य भूमिपः ।\nधृतराष्ट्रो महाराज प्राहिणोद् विदुराय वै ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2122577, "chapter_id": 3630, "verse_number": "१५", "content_sanskrit": "अपृष्ट्वा विदुरं ह्यस्य नासीत् कश्चिद् विनिर्णयः ।\nद्यूते दोषांश्च जानन् स पुत्रस्नेहादकृष्यत ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2122578, "chapter_id": 3630, "verse_number": "१६", "content_sanskrit": "तच्छ्रुत्वा विदुरो धीमान् कलिद्वारमुपस्थितम् ।\nविनाशमुखमुत्पन्नं धृतराष्ट्रमुपाद्रवत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2122579, "chapter_id": 3630, "verse_number": "१७", "content_sanskrit": "सोऽभिगम्य महात्मानं भ्राता भ्रातरमग्रजम् ।\nमूर्ध्ना प्रणम्य चरणाविदं वचनमब्रवीत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2122580, "chapter_id": 3630, "verse_number": "१८", "content_sanskrit": "नाभिनन्दामि ते राजन् व्यवसायमिमं प्रभो ।\nद्यूतहेतोर्हि ते भेदः सुतानां भवति ध्रुवम् ।\nपुत्रैर्भेदो यथा न स्याद् द्यूतहेतोस्तथा कुरु ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2122581, "chapter_id": 3630, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2122582, "chapter_id": 3630, "verse_number": "१९", "content_sanskrit": "क्षत्तः पुत्रेषु पुत्रैर्मे कलहो न भविष्यति ।\nएवं देवाः प्रसादं नः करिष्यन्ति न संशयः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2122583, "chapter_id": 3630, "verse_number": "२०", "content_sanskrit": "मयि सन्निहिते चैव भीष्मे च पुरुषर्षभे ।\nअनयो वा शुभं वाऽपि हितं वाऽप्यथवाऽहितम् ।\nप्रवर्ततां सुहृद्द्यूतं दिष्टमेतदसंशयम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2122584, "chapter_id": 3630, "verse_number": "२१", "content_sanskrit": "गच्छ त्वं रथमास्थाय हयैर्वातसमैर्जवे ।\nखाण्डवप्रस्थमद्यैव युधिष्ठिरमिहानय ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2122585, "chapter_id": 3630, "verse_number": "२२", "content_sanskrit": "न वार्यो व्यवसायो मे विदुरैतद् ब्रवीमि ते ।\nदैवमत्र परं मन्ये येनैतदुपपद्यते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2122586, "chapter_id": 3630, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2122587, "chapter_id": 3630, "verse_number": "२३", "content_sanskrit": "इत्युक्तो विदुरो धीमान् नैतदस्तीति चिन्तयन् ।\nआपगेये महाप्राज्ञे सर्वमेतन्निवेदयत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2122588, "chapter_id": 3630, "verse_number": "४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि द्विसप्ततितमोऽध्यायः ॥७२॥\n॥ द्यूतपर्वणि चतुर्थोऽध्यायः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2122589, "chapter_id": 3630, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]