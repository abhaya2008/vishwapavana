[{"id": 2124456, "chapter_id": 3668, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2124457, "chapter_id": 3668, "verse_number": "१", "content_sanskrit": "किर्म्मीरस्य वधं क्षत्तः श्रोतुमिच्छामि कथ्यताम् ।\nरक्षसा भीमसेनस्य कथमासीत् समागमः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2124458, "chapter_id": 3668, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2124459, "chapter_id": 3668, "verse_number": "२", "content_sanskrit": "शृणु भीमस्य कर्मेदमतिमानुषकर्मणः ।\nश्रुतपूर्वं मया तेषां कथान्तेषु पुनः पुनः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2124460, "chapter_id": 3668, "verse_number": "३", "content_sanskrit": "इतः प्रयाता राजेन्द्र पाण्डवा द्यूतनिर्जिताः ।\nजग्मुस्त्रिभिरहोरात्रैः काम्यकं नाम तद्वनम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2124461, "chapter_id": 3668, "verse_number": "४", "content_sanskrit": "रात्रौ निशीथे स्वालीढे गतेऽर्धसमये नृप ।\nप्रचारे पुरुषादानां रक्षसां भीमकर्मणाम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2124462, "chapter_id": 3668, "verse_number": "५", "content_sanskrit": "तद्वनं तापसा नित्यं गोपाश्च वनचारिणः ।\nदूरात् परिहरन्ति स्म पुरुषादभयात् किल\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2124463, "chapter_id": 3668, "verse_number": "६", "content_sanskrit": "तेषां प्रविशतां तत्र मार्गमावृत्य भारत ।\nदीप्ताक्षं भीषणं रक्षः सोल्मुकं समदृश्यत\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2124464, "chapter_id": 3668, "verse_number": "७", "content_sanskrit": "बाहू महान्तौ कृत्वा तु तथाऽऽस्यं च भयानकम् ।\nस्थितमावृत्य पन्थानं येन यान्ति कुरूद्वहाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2124465, "chapter_id": 3668, "verse_number": "८", "content_sanskrit": "दष्टोष्ठदंष्ट्रं ताम्राक्षं प्रदीप्तोर्ध्वशिरोरुहम् ।\nसार्करश्मितडिच्चक्रं सबालार्कमिवाम्बुदम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2124466, "chapter_id": 3668, "verse_number": "९", "content_sanskrit": "सृजन्तं राक्षसीं मायां महारावविगर्विणीम् ।\nमुञ्चन्तं विपुलं नादं सतोयमिव तोयदम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2124467, "chapter_id": 3668, "verse_number": "१०", "content_sanskrit": "यस्य नादेन सन्त्रस्ताः पक्षिणः सर्वतोदिशम् ।\nविमुक्तनादाः सम्पेतुः स्थलजा जलजैः सह\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2124468, "chapter_id": 3668, "verse_number": "११", "content_sanskrit": "सम्प्रद्रुतमृगद्वीपिमहिषर्क्षसमाकुलम् ।\nतद्वनं तस्य नादेन वित्रस्तमिव चाभवत् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2124469, "chapter_id": 3668, "verse_number": "१२", "content_sanskrit": "तस्योरुवाताभिहताः ताम्रपल्लवबाहवः ।\nविदूरजाताश्च लताः समाश्लिष्यन्त पादपान्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2124470, "chapter_id": 3668, "verse_number": "१३", "content_sanskrit": "तस्मिन् क्षणेऽथ प्रववौ मारुतो भृशदारुणः ।\nरजसा संवृतं तेन नष्टर्क्षमभवन्नभः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2124471, "chapter_id": 3668, "verse_number": "१४", "content_sanskrit": "पञ्चानां पाण्डवेयानामविज्ञातो महारिपुः ।\nपञ्चानामिन्द्रियाणां तु शोकवेग इवातुरः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2124472, "chapter_id": 3668, "verse_number": "१५", "content_sanskrit": "स दृष्ट्वा पाण्डवान् दूरात् कृष्णाजिनसमावृतान् ।\nआवृणोत् तद्वनद्वारं मैनाक इव पर्वतः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2124473, "chapter_id": 3668, "verse_number": "१६", "content_sanskrit": "तं समासाद्य वित्रस्ता कृष्णा कमललोचना ।\nअदृष्टपूर्वमत्यर्थं विषादमगमत् परम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2124474, "chapter_id": 3668, "verse_number": "१७", "content_sanskrit": "दुश्शासनकरस्पर्शविप्रकीर्णशिरोरुहा ।\nपञ्चपर्वतमध्यस्था नदीवाकुलतां गता\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2124475, "chapter_id": 3668, "verse_number": "१८", "content_sanskrit": "मोमुह्यमानां तां तत्र जगृहुः पञ्च पाण्डवाः ।\nइन्द्रियाणि प्रसक्तानि विषयेषु यथा रतिम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2124476, "chapter_id": 3668, "verse_number": "१९", "content_sanskrit": "अथ तां राक्षसीं मायामुत्थितां घोरदर्शनाम् ।\nरक्षोघ्नैर्विविधैर्मन्त्रैर्धौम्यः सम्यक्प्रयोजितैः ।\nपश्यतां पाण्डुपुत्राणां नाशयामास वीर्यवान् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2124477, "chapter_id": 3668, "verse_number": "२०", "content_sanskrit": "स नष्टमायोऽतिबलः क्रोधविष्फारितेक्षणः ।\nकाममूर्तिधरः क्रुद्धः कालकल्पो ह्यदृश्यत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2124478, "chapter_id": 3668, "verse_number": "२२", "content_sanskrit": "तमुवाच ततो राजा दीर्घप्रज्ञो युधिष्ठिरः ।\nको भवान् कस्य वा किं ते क्रियतां कार्यमुच्यताम् ।\nप्रत्युवाचाथ तद्रक्षो धर्मराजं युधिष्ठिरम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2124479, "chapter_id": 3668, "verse_number": "२३", "content_sanskrit": "अहं बकस्य वै भ्राता किर्म्मीर इति विश्रुतः ।\nवनेऽस्मिन् काम्यके शून्ये निवसामि गतज्वरः ।\nयुधि निर्जित्य पुरुषानाहारं नित्यमाचरन् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2124480, "chapter_id": 3668, "verse_number": "२४", "content_sanskrit": "के यूयमिह सम्प्राप्ता भक्ष्यभूता ममान्तिकम् ।\nयुधि निर्जित्य वः सर्वान् भक्षयिष्ये गतज्वरः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2124481, "chapter_id": 3668, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2124482, "chapter_id": 3668, "verse_number": "२५", "content_sanskrit": "युधिष्ठिरस्तु तच्छ्रुत्वा वचस्तस्य दुरात्मनः ।\nआचचक्षे ततः सर्वं गोत्रनामादि भारत\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2124483, "chapter_id": 3668, "verse_number": "२६", "content_sanskrit": "पाण्डवो धर्मराजोऽहं यदि ते श्रोत्रमागतः ।\nसहितो भ्रातृभिः सर्वैर्भीमसेनार्जुनादिभिः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2124484, "chapter_id": 3668, "verse_number": "२७", "content_sanskrit": "हृतराज्यो वने वासं वस्तुं कृतमतिस्ततः ।\nवनमभ्यागतो घोरमिदं तव परिग्रहम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2124485, "chapter_id": 3668, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2124486, "chapter_id": 3668, "verse_number": "२८", "content_sanskrit": "किम्मीस्त्वब्रवीदेनं दिष्ट्या देवैरिदं मम ।\nउपपादितमद्येह चिरकालान्मनोरथम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2124487, "chapter_id": 3668, "verse_number": "२९", "content_sanskrit": "भीमसेनवधार्थं हि नित्यमभ्युद्यतायुधः ।\nचरामि पृथिवीं कृत्स्नां नैनं चासादयाम्यहम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2124488, "chapter_id": 3668, "verse_number": "३०", "content_sanskrit": "सोऽयमासादितो दिष्ट्या भ्रातृहा काङ्क्षितश्चिरम् ।\nअनेन हि मम भ्राता बको विनिहतः प्रियः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2124489, "chapter_id": 3668, "verse_number": "३१", "content_sanskrit": "वेत्रकीयगृहे राजन् ब्राह्मणच्छद्मरूपिणा ।\nविद्याबलमुपाश्रित्य न ह्यस्त्यस्यौरसं बलम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2124490, "chapter_id": 3668, "verse_number": "३२", "content_sanskrit": "हिडिम्बश्च सखा मह्यं दयितो वनगोचरः ।\nहतो दुरात्मनाऽनेन स्वसा चास्य हृता पुनः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2124491, "chapter_id": 3668, "verse_number": "३३", "content_sanskrit": "सोऽयमभ्यागतो मूढो ममेदं गहनं वनम् ।\nप्रचारसमयेऽस्माकमर्द्धरात्रे समास्थिते\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2124492, "chapter_id": 3668, "verse_number": "३४", "content_sanskrit": "अद्यास्य यातयिष्यामि तद्वैरं चिरसम्भृतम् ।\nतर्पयिष्यामि च बकं रुधिरेणास्य भूरिणा\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2124493, "chapter_id": 3668, "verse_number": "३५", "content_sanskrit": "अद्याहमनृणो भूत्वा भ्रातुः सख्युस्तथैव च ।\nशान्तिं लब्धास्मि परमां हत्वा राक्षसकण्टकम् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2124494, "chapter_id": 3668, "verse_number": "३६", "content_sanskrit": "युधि तेन पुरा मुक्तो भीमसेनो बकेन वै ।\nअद्यैनं भक्षयिष्यामि पश्यतस्ते युधिष्ठिर\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2124495, "chapter_id": 3668, "verse_number": "३७", "content_sanskrit": "एनं हि विपुलप्राणमद्य हत्वा वृकोदरम् ।\nसम्भक्ष्य जरयिष्यामि यथाऽगस्त्यो महासुरम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2124496, "chapter_id": 3668, "verse_number": "३८", "content_sanskrit": "एवमुक्तस्तु धर्मात्मा सत्यसन्धो युधिष्ठिरः ।\nनैतदस्तीति सङ्क्रुद्धो भत्सयामास राक्षसम् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2124497, "chapter_id": 3668, "verse_number": "३९", "content_sanskrit": "ततो भीमो महाबाहुरारुज्य तरसा द्रुमम् ।\nशतव्याममिवोद्विद्धं निष्पत्रमकरोत्तदा\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2124498, "chapter_id": 3668, "verse_number": "४०", "content_sanskrit": "चकार सज्यं गाण्डीवं वज्रनिष्पेषभैरवम् ।\nनिमेषान्तरमात्रेण तथैव विजयोऽर्जुनः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2124499, "chapter_id": 3668, "verse_number": "४१", "content_sanskrit": "निवार्य जिष्णुं भीमोऽथ तद्रक्षो भीमगर्जितम् ।\nअभिद्रुत्याब्रवीद् वाक्यं तिष्ठ तिष्ठेति भारत\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2124500, "chapter_id": 3668, "verse_number": "४२", "content_sanskrit": "इत्युक्त्वा तमभिक्रुद्धं कक्ष्यामुत्पीड्य पाण्डवः ।\nनिष्पिष्य पाणिना पाणिं सन्दष्टौष्ठपुटो बली ।\nअभ्यधावत वेगेन भीमो वृक्षायुधस्तदा \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2124501, "chapter_id": 3668, "verse_number": "४३", "content_sanskrit": "यमदण्डप्रतीकाशं ततस्तं तस्य मूर्धनि ।\nपातयामास वेगेन कुलिशं मघवानिव\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2124502, "chapter_id": 3668, "verse_number": "४४", "content_sanskrit": "असम्भ्रान्तं तु तद्रक्षः समरे प्रत्यदृश्यत ।\nचिक्षेप चोल्कं दीप्तान्तमशनिं ज्वलितामिव\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2124503, "chapter_id": 3668, "verse_number": "४५", "content_sanskrit": "तदुदस्तमलातं तु भीमः प्रहरतां वरः ।\nपदा सव्येन चिक्षेप तद्रक्षः पुनराव्रजत्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2124504, "chapter_id": 3668, "verse_number": "४६", "content_sanskrit": "किर्म्मीरश्चापि सहसा वृक्षमुत्पाट्य पाण्डवम् ।\nदण्डपाणिरिव क्रुद्धः समरे प्रत्यदृश्यत\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2124505, "chapter_id": 3668, "verse_number": "४७", "content_sanskrit": "तद्वृक्षयुद्धमभवन्महीरुहविनाशनम् ।\nवालिसुग्रीवयोः पूर्वं भ्रात्रोः स्त्रीकाङ्क्षिणोरिव\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2124506, "chapter_id": 3668, "verse_number": "४८", "content_sanskrit": "शीर्षयोः पतिता वृक्षा बिभिदुर्नैकधा तयोः ।\nयथैवोत्पलपत्राणि मत्तयोर्द्विपमुख्ययोः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2124507, "chapter_id": 3668, "verse_number": "४९", "content_sanskrit": "मूर्ध्नि झर्झरभूतास्तु बहवस्तत्र पादपाः ।\nचीराणीव व्युदस्तानि विरेजुस्तत्र भारत\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2124508, "chapter_id": 3668, "verse_number": "५०", "content_sanskrit": "तद्वृक्षयुद्धमभवत् मुहूर्तं तु विशाम्पते ।\nराक्षसानां च मुख्यस्य नराणामुत्तमस्य च \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2124509, "chapter_id": 3668, "verse_number": "५१", "content_sanskrit": "ततः शिलां समुत्क्षिप्य भीमस्य युधि तिष्ठतः ।\nप्राहिणोद्राक्षसः क्रुद्धो भीमश्च न चचाल ह \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2124510, "chapter_id": 3668, "verse_number": "५२", "content_sanskrit": "तं शिलाताडनजडं पर्यधावत राक्षसः ।\nबाहुविक्षिप्तकिरणः स्वर्भानुरिव भास्करम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2124511, "chapter_id": 3668, "verse_number": "५३", "content_sanskrit": "तावन्योन्यं समाश्लिश्य प्रकर्षन्तौ परस्परम् ।\nउभावपि चकाशेते प्रयुद्धौ वृषभाविव\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2124512, "chapter_id": 3668, "verse_number": "५४", "content_sanskrit": "तयोरासीत् सुतुमुलः सम्प्रहारः सुदारुणः ।\nनखदंष्ट्रायुधवतोर्व्याघ्रयोरिव द्दप्तयोः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2124513, "chapter_id": 3668, "verse_number": "५५", "content_sanskrit": "दुर्योधननिकाराच्च बाहुवीर्याच्च दर्पितः ।\nकृष्णानयनद्दष्टश्च व्यवर्धत वृकोदरः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2124514, "chapter_id": 3668, "verse_number": "५६", "content_sanskrit": "अभिहत्याथ बाहुभ्यां प्रत्यगृह्णादमर्षितः ।\nमातङ्गमिव मातङ्गः प्रभिन्नकरटामुखम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2124515, "chapter_id": 3668, "verse_number": "५७", "content_sanskrit": "तच्चाप्येनं ततो रक्षः प्रतिजग्राह वीर्यवत् ।\nतदाक्षिपद् भीमसेनो बलेन वलिनां वरः \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2124516, "chapter_id": 3668, "verse_number": "५८", "content_sanskrit": "तयोर्भुजविनिष्पेषादुभयोर्बलिनोस्तथा ।\nशब्दः समभवद् घोरो वेणुस्फोटसमो युधि\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2124517, "chapter_id": 3668, "verse_number": "५९", "content_sanskrit": "अथैनमाक्षिप्य बलाद् गृह्य मध्ये वृकोदरः ।\nधूनयामास वेगेन वायुश्चण्ड इव द्रुमम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2124518, "chapter_id": 3668, "verse_number": "६०", "content_sanskrit": "स भीमेन परामृष्टो दुर्बलो बलिना रणे ।\nप्रास्पन्दत यथाप्राणं विचकर्ष च पाण्डवः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2124519, "chapter_id": 3668, "verse_number": "६१", "content_sanskrit": "तत एनं परिश्रान्तमुपलक्ष्य वृकोदरः ।\nयोक्त्रयामास बाहुभ्यां पशुं रशनया यथा\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2124520, "chapter_id": 3668, "verse_number": "६२", "content_sanskrit": "नदन्तं तं महानादं भिन्नभेरीनिभस्वनम् ।\nभ्रामयामास सुचिरं विस्फुरन्तमचेतनम् \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2124521, "chapter_id": 3668, "verse_number": "६३", "content_sanskrit": "तं विषीदन्तमाज्ञाय राक्षसं पाण्डुनन्दनः ।\nप्रगृह्य तरसा दोर्भ्यां पशुमारममारयत्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2124522, "chapter_id": 3668, "verse_number": "६४", "content_sanskrit": "आक्रम्य च कटीदेशे जानुना राक्षसाधमम् ।\nअपीडयत् स्वबाहुभ्यां तस्य कण्ठं वृकोदरः \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2124523, "chapter_id": 3668, "verse_number": "६५", "content_sanskrit": "अथ तं जडसर्वाङ्गं व्यावृत्तनयनोल्बणम् ।\nभूतळे पातयामास वाक्यं चेदमुवाच ह\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2124524, "chapter_id": 3668, "verse_number": "६६", "content_sanskrit": "हिडिम्बबकयोः पाप न त्वमश्रुप्रमार्जनम् ।\nकरिष्यसि गतश्चासि यमस्य सदनं प्रति\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2124525, "chapter_id": 3668, "verse_number": "६७", "content_sanskrit": "इत्येवमुक्त्वा पुरषप्रवीरः\nतं राक्षसं क्रोधविवृत्तनेत्रः ।\nविस्रस्तवस्त्राभरणं स्फुरन्तम्\nउद्भ्रान्तचित्तं व्यसुमुत्ससर्ज\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2124526, "chapter_id": 3668, "verse_number": "६८", "content_sanskrit": "तस्मिन् हते तोयदतुल्यरूपे\nकृष्णां पुरस्कृत्य नरेन्द्रमुख्याः ।\nभीमं परिष्वज्य गुणैरनेकैः\nस्तुत्वा ततो द्वैतवनाय जग्मुः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2124527, "chapter_id": 3668, "verse_number": "६९", "content_sanskrit": "एवं विनिहतः सङ्खे किर्म्मीरो मनुजाधिप ।\nभीमेन वचनात् तस्य धर्मराजस्य कौरव\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2124528, "chapter_id": 3668, "verse_number": "७०", "content_sanskrit": "ततो निष्कण्टकं कृत्वा वनं तदपराजिताः ।\nद्रौपद्या सह धर्मज्ञा वसतीरवसन् ततः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2124529, "chapter_id": 3668, "verse_number": "७१", "content_sanskrit": "समाश्वास्य च ते सर्वे द्रौपदीं भरतर्षभाः ।\nप्रहृष्टमनसः सर्वे प्रशशंसुर्वृकोदरम्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2124530, "chapter_id": 3668, "verse_number": "७२", "content_sanskrit": "भीमबाहुबलोत्पिष्टे विनष्टे राक्षसे ततः ।\nविविशुस्तद्वनं वीराः क्षेमं निहतकण्टकम् \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2124531, "chapter_id": 3668, "verse_number": "७३", "content_sanskrit": "स मया गच्छता मार्गे विनिकीर्णो भयानकः ।\nवने महति दुष्टात्मा दृष्टो भीमबलाहतः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2124532, "chapter_id": 3668, "verse_number": "७४", "content_sanskrit": "तत्राश्रौषमहं राजन् कर्म भीमस्य संयुगे ।\nब्राह्मणानां कथयतां ये तत्रासन् समागताः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2124533, "chapter_id": 3668, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2124534, "chapter_id": 3668, "verse_number": "७५", "content_sanskrit": "एवं विनिहतं सङ्खे किर्म्मीरं राक्षसाधमम् ।\nश्रुत्वा ध्यानपरो राजा निशश्वासार्तवत् तदा\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2124535, "chapter_id": 3668, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां\nसंहितायां वैयासिक्यां वनपर्वणि दशमोऽध्यायः ॥१०॥\n॥ किर्म्मीरवधपर्वणि प्रथमोऽध्यायः ॥१॥\n॥ समाप्तं किर्म्मीरवधपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2124536, "chapter_id": 3668, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]