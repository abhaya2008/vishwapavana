[{"id": 900000603, "chapter_id": 8176, "verse_number": "3.1", "content_sanskrit": "\"भूतबन्धस्तु संसारो मुक्तिस्तेभ्यो विमोचनम्'", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900000604, "chapter_id": 8176, "verse_number": "3.2", "content_sanskrit": "पश्चाददृष्टेः स्वप्नविषयस्यासत्त्वं न वाच्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900000605, "chapter_id": 8176, "verse_number": "3.3", "content_sanskrit": "न च प्रतिशाखमुच्यमानानामर्थानां पृथकत्वात् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900000606, "chapter_id": 8176, "verse_number": "3.4", "content_sanskrit": "न च ज्ञानिन औदार्यान्मोक्षादन्यफलेच्छाया ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]