[{"id": 7002677000, "chapter_id": 22677, "verse_number": "७-२०-१", "content_sanskrit": "सूत उवाच ।\nमुने पांचालदेशे तु राजासीद्बलवर्द्धनः ।\nतस्य पत्नी विशालाक्षी जलदेवीति विश्रुता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002677001, "chapter_id": 22677, "verse_number": "७-२०-२", "content_sanskrit": "बिसेनवंशभूपालो वेदतत्त्वविशारदः ।\nसस्त्रीकः पूजयामास वरुणं यादसां पतिम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002677002, "chapter_id": 22677, "verse_number": "७-२०-३", "content_sanskrit": "तस्य पुत्रावुभौ जातौ क्षत्रधर्मपरायणौ ।\nलहरो ज्येष्ठतनयो मयूरध्वज एव हि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002677003, "chapter_id": 22677, "verse_number": "७-२०-४", "content_sanskrit": "द्वादशाब्दवया भूत्वा मयूरध्वज एव सः ।\nआज्ञया ज्येष्ठबंधोश्च स्कंददेवमतोषयत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002677004, "chapter_id": 22677, "verse_number": "७-२०-५", "content_sanskrit": "यतेंद्रियस्तथा मौनी वानप्रस्थ परायणः ।\nपंचाब्दं तद्व्रती भूत्वा जपध्यानपरोभवत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002677005, "chapter_id": 22677, "verse_number": "७-२०-६", "content_sanskrit": "तदा प्रसन्नो भगवान्सेनानीरग्निभूः स्वयम् ।\nस्वरूपं दर्शयामास सर्वाश्चर्यसमन्वि तम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002677006, "chapter_id": 22677, "verse_number": "७-२०-७", "content_sanskrit": "मयूरध्वज एवापि दृष्ट्वा सर्वमयं शिशुम् ।\nदेवसेनासहायं च तुष्टाव श्लक्ष्णया गिरा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002677007, "chapter_id": 22677, "verse_number": "७-२०-८", "content_sanskrit": "मयूरध्वज उवाच ।\nजयति ते वपुर्दिव्यविग्रहं नयति सर्वदा देवतागणान् ।\nपिबति मात्रियं दुग्धमुत्तमं वधति सर्वदा दैत्यदानवान् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002677008, "chapter_id": 22677, "verse_number": "७-२०-९", "content_sanskrit": "नमस्ते देवसेनेश महिषासुरमर्दन ।\nषडानन महाबाहो तारकप्राणनाशक ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002677009, "chapter_id": 22677, "verse_number": "७-२०-१०", "content_sanskrit": "प्रसन्नो भव सर्वात्मन्गुहशक्तिधराव्यय ।\nकिंकरं पाहि मां नित्यं शरणागतवत्सल ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002677010, "chapter_id": 22677, "verse_number": "७-२०-११", "content_sanskrit": "इति श्रुत्वा स्तुतिं तस्य सेनानीस्तमुवाच वै ।\nकिं तेऽभीष्टं नृपश्रेष्ठ मत्तः सर्वमवाप्स्यसि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002677011, "chapter_id": 22677, "verse_number": "७-२०-१२", "content_sanskrit": "इत्युक्तस्तेन देवेन भूपतिः प्राह नम्रधीः ।\nबलं मे देहि भगवन्सहायं कुरु सर्वदा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002677012, "chapter_id": 22677, "verse_number": "७-२०-१३", "content_sanskrit": "तथेत्युक्त्वा तु तं स्कंदस्तत्रैवान्तर्दधे पुनः ।\nस नृपस्तु प्रसन्नात्मा कारयामास वै पुरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002677013, "chapter_id": 22677, "verse_number": "७-२०-१४", "content_sanskrit": "नाम्ना मयूरनगरं नरवृंदसमन्वितम् ।\nद्वियोजनायामयुतं स्कंददेवेन रक्षितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002677014, "chapter_id": 22677, "verse_number": "७-२०-१५", "content_sanskrit": "लहरो नामा तद्बंधुर्द्विदशाब्दप्रयत्नतः ।\nवरुणं पूजयामास नदीनदसमन्वितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002677015, "chapter_id": 22677, "verse_number": "७-२०-१६", "content_sanskrit": "तदा प्रसन्नो भगवान्वरुणो यादसां पतिः ।\nवरं ब्रूहीति वचनं प्रेम्णोवाच महीपतिम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002677016, "chapter_id": 22677, "verse_number": "७-२०-१७", "content_sanskrit": "इति श्रुत्वाऽमृतमयं वचनं लहरो नृपः ।\nतुष्टाव श्लक्ष्णया वाचा पाशिनं पयसां पतिम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002677017, "chapter_id": 22677, "verse_number": "७-२०-१८", "content_sanskrit": "लहर उवाच ।\nयस्य चित्तं महज्ज्ञेयं तपो बलसमन्वितम् ।\nअतः प्रचेतास्ते नाम नमस्तुभ्यं प्रचेतसे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002677018, "chapter_id": 22677, "verse_number": "७-२०-१९", "content_sanskrit": "रुणद्धि पयसां वेगं न केनाप्यवरोधितः ।\nअतस्त्वं वरुणो नाम नमस्ते वरुणाय वै ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002677019, "chapter_id": 22677, "verse_number": "७-२०-२०", "content_sanskrit": "दैत्यानां बंधनार्थाय देवानां जयहेतवे ।\nदिव्यः पाशस्त्वयानीतः पाशिने ते नमोनमः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002677020, "chapter_id": 22677, "verse_number": "७-२०-२१", "content_sanskrit": "इति स्तुतस्तदा देवो राज्ञा तेनैव धीमता ।\nनगरीं कारयामास लाहरीमथ चोत्तमाम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002677021, "chapter_id": 22677, "verse_number": "७-२०-२२", "content_sanskrit": "त्रियोजनायामयुतां चतुर्वर्णसमन्विताम् ।\nस्वयं च ग्रामरक्षार्थे तत्रोवास जला धिपः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002677022, "chapter_id": 22677, "verse_number": "७-२०-२३", "content_sanskrit": "भूपस्तु तत्प्रसादेन प्राप राज्ञीं शुभाननाम् ।\nरावी नाम महाश्रेष्ठा ज्ञेया देवांगनोपमा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002677023, "chapter_id": 22677, "verse_number": "७-२०-२४", "content_sanskrit": "तस्यां स जनयामास सुतान्षो डशसंमितान् ।\nधार्तराष्ट्रांशजान्मुख्यान्गजतुल्यबलान्वितान् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002677024, "chapter_id": 22677, "verse_number": "७-२०-२५", "content_sanskrit": "तत्पश्चात्कन्यका जाता नाम्ना मदनमंजरी ।\nद्वादशाब्दवयःप्राप्ते सुतायाः स तु भूपतिः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002677025, "chapter_id": 22677, "verse_number": "७-२०-२६", "content_sanskrit": "देवसिंहं वरं मत्वा चंद्रवंशिनमुत्तमम् ।\nप्राहूय ज्येष्ठतनयं प्रेषयामास भूपतिः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002677026, "chapter_id": 22677, "verse_number": "७-२०-२७", "content_sanskrit": "रणधीरस्तु तनयो लक्षमुद्रान्वितो बली ।\nसहस्रशबरसहितः प्राप्तवान्स महावतीम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002677027, "chapter_id": 22677, "verse_number": "७-२०-२८", "content_sanskrit": "नत्वा परिमलं भूपं तदीयात्कुलशालिनः ।\nस्वहेतुं वर्णयामास विवाहार्थे स्वसुः स्वयम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002677028, "chapter_id": 22677, "verse_number": "७-२०-२९", "content_sanskrit": "श्रुत्वा परिमलो भूपो देवसिंहं महामतिम् ।\nआहूय वचनं प्राह विवाहार्थे मनः कुरु ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002677029, "chapter_id": 22677, "verse_number": "७-२०-३०", "content_sanskrit": "देवसिंहस्तु बलवान्पितृव्यं प्राह नम्रधीः ।\nविवाहं न करिष्यामि ब्रह्मचर्यं व्रतं मम ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002677030, "chapter_id": 22677, "verse_number": "७-२०-३१", "content_sanskrit": "बहुधा प्रार्थितस्सर्वैर्द्विजवृंदसमन्वितैः ।\nन तत्याज व्रतं श्रेष्ठं देवसिंहो महामतिः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002677031, "chapter_id": 22677, "verse_number": "७-२०-३२", "content_sanskrit": "तदा परिमलो भूपो रणधीरं वचोऽब्रवीत् ।\nसुखखानिरयं बालो विवाहार्थे वदाम्यहम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002677032, "chapter_id": 22677, "verse_number": "७-२०-३३", "content_sanskrit": "तथेति मत्वा स नृपो रणधीरो गृहं ययौ ।\nपितरं कथयामास सुखखानिर्महाव्रतः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002677033, "chapter_id": 22677, "verse_number": "७-२०-३४", "content_sanskrit": "एतस्मिन्नन्तरे धूर्तो महीपतिरुवाच तम् ।\nअयोग्योऽयं विवाहोऽत्र पावकीये कुलोत्तमे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002677034, "chapter_id": 22677, "verse_number": "७-२०-३५", "content_sanskrit": "शूद्रीयोऽत्र वरो राजन्वर्णसंकरकारकः ।\nतस्मात्त्वं सैन्यसहितो जेतुं तान्गंतुमर्हसि ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002677035, "chapter_id": 22677, "verse_number": "७-२०-३६", "content_sanskrit": "कारागारे लोहमये बंधनं कुरु भूपतेः ।\nमत्कीर्तिः स्वर्गगा नित्यं जगत्यंते भविष्यति ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002677036, "chapter_id": 22677, "verse_number": "७-२०-३७", "content_sanskrit": "जितस्तैर्जम्बुको राजा नेत्रसिंहस्तु यो नृपः ।\nतथा गजपतिर्भूपः पृथ्वीराजो महाबलः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002677037, "chapter_id": 22677, "verse_number": "७-२०-३८", "content_sanskrit": "आर्यसिंहस्तथान्ये च जितास्ते बलवत्तराः ।\nइति श्रुत्वा वचो रम्यं लहरो नृपसत्तमः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002677038, "chapter_id": 22677, "verse_number": "७-२०-३९", "content_sanskrit": "सेनां संस्थापयामास चतुरंगबलान्विताम् ।\nचतुर्लक्षमितां श्रेष्ठां पालितां षोडशात्मजैः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002677039, "chapter_id": 22677, "verse_number": "७-२०-४०", "content_sanskrit": "माघशुक्लदशम्यां च बलखानिं महाबलः ।\nसंप्राप्तः स्वकुलैस्सार्द्धं चतुर्लक्षबलान्वितम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002677040, "chapter_id": 22677, "verse_number": "७-२०-४१", "content_sanskrit": "देशे पांचालके रम्ये लहरीनगरे स्थितः ।\nद्वादशाब्दे च कृष्णांशे तत्र वासमकारयत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002677041, "chapter_id": 22677, "verse_number": "७-२०-४२", "content_sanskrit": "नृपतेराज्ञया शूरा युद्धाय समुपाययुः ।\nबलखानिस्तु धर्मात्मा दृष्ट्वा शूरांस्तथागतान् ।\nवीरानाज्ञापयामास स्वकीयान्संगरे पुनः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002677042, "chapter_id": 22677, "verse_number": "७-२०-४३", "content_sanskrit": "तयोर्युद्धमभूद्घोरं सेनयोर्लोमहर्षणम् ।\nपंचमेऽह्नि दिवा प्राप्ते बलखानिर्महाबलः ।\nकृष्णांशेनैव सहितो रिपोर्वधमकारयत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002677043, "chapter_id": 22677, "verse_number": "७-२०-४४", "content_sanskrit": "पराजिताश्च ते शूरा हतशेषा भयातुराः ।\nतान्दृष्ट्वा षोडशसुता रथं स्वंस्वं समास्थिताः ।\nयुद्धायाभिमुखं जग्मुर्धनुर्बाणविशारदाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002677044, "chapter_id": 22677, "verse_number": "७-२०-४५", "content_sanskrit": "कृष्णांशस्तांस्तथा दृष्ट्वा शरवर्षसमन्वितान् ।\nएकाकी प्रययौ शीघ्रं खड्गचर्मधरो बली ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002677045, "chapter_id": 22677, "verse_number": "७-२०-४६", "content_sanskrit": "तेषां धनूंषि संछिद्य बद्ध्वा तान्युद्धदुर्मदान् ।\nआह्लादाय ददौ वीरः कृष्णांशो रणकोविदः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002677046, "chapter_id": 22677, "verse_number": "७-२०-४७", "content_sanskrit": "पुत्राणां बन्धनं श्रुत्वा लहरो नृपसत्तमः ।\nप्लावयामास तत्सैन्यं बलखानेर्महात्मनः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002677047, "chapter_id": 22677, "verse_number": "७-२०-४८", "content_sanskrit": "जलीभूते तथा सैन्ये जयन्तो बलवत्तरः ।\nवायव्यास्त्रेण समरे शुशोष सकलं जलम् ।\nलहरस्य ततः सेनामुवाह बहुयोजनम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002677048, "chapter_id": 22677, "verse_number": "७-२०-४९", "content_sanskrit": "तदा तु भगवान्देवो वरुणो यादसां पतिः ।\nसुतामुद्वाहयामास लहरस्य महीपतेः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002677049, "chapter_id": 22677, "verse_number": "७-२०-५०", "content_sanskrit": "लहरोऽपि प्रसन्नात्मा ज्ञात्वांशं जगतीतले ।\nभक्तिं चकार शुद्धानामंशानां परया मुदा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002677050, "chapter_id": 22677, "verse_number": "७-२०-५१", "content_sanskrit": "दत्त्वा च बहुधा द्रव्यं परिक्रम्य पुनःपुनः ।\nस्वान्ते निवेशयामास मासमात्रं प्रसन्नधीः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002677051, "chapter_id": 22677, "verse_number": "७-२०-५२", "content_sanskrit": "अंशास्तेऽपि महापूजां गृहीत्वा लहरप्रदाम् ।\nदोलामारोप्य तां देवीं स्वगेहाय ययुर्मुदा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002677052, "chapter_id": 22677, "verse_number": "७-२०-५३", "content_sanskrit": "इति ते कथितं विप्र कृष्णांशचरितं शुभम् ।\nसुखखानेर्विवाहं च श्रुत्वानंदमवाप्नुयात् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]