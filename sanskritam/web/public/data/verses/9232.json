[{"id": 5000232000, "chapter_id": 9232, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे षट्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000232001, "chapter_id": 9232, "verse_number": "३-३६-१", "content_sanskrit": "मारीच श्रूयतां तात वचनं मम भाषतः।\nआर्तोऽस्मि मम चार्तस्य भवान् हि परमा गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000232002, "chapter_id": 9232, "verse_number": "३-३६-२", "content_sanskrit": "जानीषे त्वं जनस्थानं भ्राता यत्र खरो मम।\nदूषणश्च महाबाहुः स्वसा शूर्पणखा च मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000232003, "chapter_id": 9232, "verse_number": "३-३६-३", "content_sanskrit": "त्रिशिराश्च महाबाहू राक्षसः पिशिताशनः।\nअन्ये च बहवः शूरा लब्धलक्षा निशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000232004, "chapter_id": 9232, "verse_number": "३-३६-४", "content_sanskrit": "वसन्ति मन्नियोगेन अधिवासं च राक्षसाः।\nबाधमाना महारण्ये मुनीन् ये धर्मचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000232005, "chapter_id": 9232, "verse_number": "३-३६-५", "content_sanskrit": "चतुर्दश सहस्राणि रक्षसां भीमकर्मणाम्।\nशूराणां लब्धलक्षाणां खरचित्तानुवर्तिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000232006, "chapter_id": 9232, "verse_number": "३-३६-६", "content_sanskrit": "ते त्विदानीं जनस्थाने वसमाना महाबलाः।\nसङ्गताः परमायत्ता रामेण सह संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000232007, "chapter_id": 9232, "verse_number": "३-३६-७", "content_sanskrit": "नानाशस्त्रप्रहरणाः खरप्रमुखराक्षसाः।\nतेन संजातरोषेण रामेण रणमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000232008, "chapter_id": 9232, "verse_number": "३-३६-८", "content_sanskrit": "अनुक्त्वा परुषं किंचिच्छरैर्व्यापारितं धनुः।\nचतुर्दश सहस्राणि रक्षसामुग्रतेजसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000232009, "chapter_id": 9232, "verse_number": "३-३६-९", "content_sanskrit": "निहतानि शरैर्दीप्तैर्मानुषेण पदातिना।\nखरश्च निहतः संख्ये दूषणश्च निपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000232010, "chapter_id": 9232, "verse_number": "३-३६-१०", "content_sanskrit": "हत्वा त्रिशिरसं चापि निर्भया दण्डकाः कृताः।\nपित्रा निरस्तः क्रुद्धेन सभार्यः क्षीणजीवितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000232011, "chapter_id": 9232, "verse_number": "३-३६-११", "content_sanskrit": "स हन्ता तस्य सैन्यस्य रामः क्षत्रियपांसनः।\nअशीलः कर्कशस्तीक्ष्णो मूर्खो लुब्धोऽजितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000232012, "chapter_id": 9232, "verse_number": "३-३६-१२", "content_sanskrit": "त्यक्तधर्मा त्वधर्मात्मा भूतानामहिते रतः।\nयेन वैरं विनारण्ये सत्त्वमास्थाय केवलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000232013, "chapter_id": 9232, "verse_number": "३-३६-१३", "content_sanskrit": "कर्णनासापहारेण भगिनी मे विरूपिता।\nअस्य भार्यां जनस्थानात् सीतां सुरसुतोपमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000232014, "chapter_id": 9232, "verse_number": "३-३६-१४", "content_sanskrit": "आनयिष्यामि विक्रम्य सहायस्तत्र मे भव।\nत्वया ह्यहं सहायेन पार्श्वस्थेन महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000232015, "chapter_id": 9232, "verse_number": "३-३६-१५", "content_sanskrit": "भ्रातृभिश्च सुरान् सर्वान् नाहमत्राभिचिन्तये।\nतत्सहायो भव त्वं मे समर्थो ह्यसि राक्षस ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000232016, "chapter_id": 9232, "verse_number": "३-३६-१६", "content_sanskrit": "वीर्ये युद्धे च दर्पे च न ह्यस्ति सदृशस्तव।\nउपायतो महान् शूरो महामायाविशारदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000232017, "chapter_id": 9232, "verse_number": "३-३६-१७", "content_sanskrit": "एतदर्थमहं प्राप्तस्त्वत्समीपं निशाचर।\nशृणु तत् कर्म साहाय्ये यत् कार्यं वचनान्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000232018, "chapter_id": 9232, "verse_number": "३-३६-१८", "content_sanskrit": "सौवर्णस्त्वं मृगो भूत्वा चित्रो रजतबिन्दुभिः।\nआश्रमे तस्य रामस्य सीतायाः प्रमुखे चर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000232019, "chapter_id": 9232, "verse_number": "३-३६-१९", "content_sanskrit": "त्वां तु निःसंशयं सीता दृष्ट्वा तु मृगरूपिणम्।\nगृह्यतामिति भर्तारं लक्ष्मणं चाभिधास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000232020, "chapter_id": 9232, "verse_number": "३-३६-२०", "content_sanskrit": "ततस्तयोरपाये तु शून्ये सीतां यथासुखम्।\nनिराबाधो हरिष्यामि राहुश्चन्द्रप्रभामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000232021, "chapter_id": 9232, "verse_number": "३-३६-२१", "content_sanskrit": "ततः पश्चात् सुखं रामे भार्याहरणकर्शिते।\nविश्रब्धं प्रहरिष्यामि कृतार्थेनान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000232022, "chapter_id": 9232, "verse_number": "३-३६-२२", "content_sanskrit": "तस्य रामकथां श्रुत्वा मारीचस्य महात्मनः।\nशुष्कं समभवद् वक्त्रं परित्रस्तो बभूव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000232023, "chapter_id": 9232, "verse_number": "३-३६-२३", "content_sanskrit": "ओष्ठौ परिलिहन् शुष्कौ नेत्रैरनिमिषैरिव।\nमृतभूत इवार्तस्तु रावणं समुदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000232024, "chapter_id": 9232, "verse_number": "३-३६-२४", "content_sanskrit": "स रावणं त्रस्तविषण्णचेता\nमहावने रामपराक्रमज्ञः।\nकृताञ्जलिस्तत्त्वमुवाच वाक्यं\nहितं च तस्मै हितमात्मनश्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000232025, "chapter_id": 9232, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे षट्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]