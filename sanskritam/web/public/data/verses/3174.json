[{"id": 2101130, "chapter_id": 3174, "verse_number": "१४-३०-१", "content_sanskrit": "ब्राह्मण उवाच।\nअत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nकार्तवीर्यस्य संवादं समुद्रस्य च भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101131, "chapter_id": 3174, "verse_number": "१४-३०-२", "content_sanskrit": "कार्तवीर्यार्जुनो नाम राजा बाहुसहस्रवान्।\nयेन सागरपर्यन्ता धनुषा निर्जिता मही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101132, "chapter_id": 3174, "verse_number": "१४-३०-३", "content_sanskrit": "स कदाचित्समुद्रान्ते विचरन्बलदर्पितः।\nअवीकिरच्छरशतैः समुद्रमिति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101133, "chapter_id": 3174, "verse_number": "१४-३०-४", "content_sanskrit": "तं समुद्रो नमस्कृत्य कृताञ्जलिरुवाचह।\nमा मुञ्च वीर नाराचान्ब्रूहि किं करवाणि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101134, "chapter_id": 3174, "verse_number": "१४-३०-५", "content_sanskrit": "मदाश्रयाणि भूतानि त्वद्विसृष्टैर्महेषुभिः।\nवध्यन्ते राजशार्दूल तेभ्यो देह्यभयं विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101135, "chapter_id": 3174, "verse_number": "१४-३०-६x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101136, "chapter_id": 3174, "verse_number": "१४-३०-६", "content_sanskrit": "मत्समो यदि संग्रामे शरासनधरः क्वचित्।\nविद्यते तं समाचक्ष्व यः समो मे महामृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101137, "chapter_id": 3174, "verse_number": "१४-३०-७x", "content_sanskrit": "समुद्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101138, "chapter_id": 3174, "verse_number": "१४-३०-७", "content_sanskrit": "महर्षिर्जमदग्निस्ते यदि राजन्पुरा श्रुतः।\nतस्य पुत्रस्तवातिथ्यं यथावत्कर्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101139, "chapter_id": 3174, "verse_number": "१४-३०-८", "content_sanskrit": "ततः स राजा प्रययौ क्रोधेन महता वृतः।\nस तमाश्रममागम्य राममेवान्वपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101140, "chapter_id": 3174, "verse_number": "१४-३०-९", "content_sanskrit": "स रामप्रतिकूलानि चकार सह बन्धुभिः।\nआयासं जनयामास रामस्य च महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101141, "chapter_id": 3174, "verse_number": "१४-३०-१०", "content_sanskrit": "ततस्तेजः प्रजज्वाल रामस्यामिततेजसः।\nप्रदहन्रिपुसैन्यानि तदा कमललोचने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101142, "chapter_id": 3174, "verse_number": "१४-३०-११", "content_sanskrit": "ततः परशुमादाय स तं बाहुसहस्रिणम्।\nचिन्छेद सहसा रामो बहुशाखमिव द्रुमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101143, "chapter_id": 3174, "verse_number": "१४-३०-१२", "content_sanskrit": "तं हतं पतितं दृष्ट्वा समेताः सर्वबान्धवाः।\nअसीनादाय शक्तीर्श्च भार्गवं पर्यधावयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101144, "chapter_id": 3174, "verse_number": "१४-३०-१३", "content_sanskrit": "रामोऽपि धनुरादाय रथमारुह्य सत्वरः।\nविसृजञ्शरवर्षाणि व्यधमत्पार्थिवं बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101145, "chapter_id": 3174, "verse_number": "१४-३०-१४", "content_sanskrit": "ततस्तु क्षत्रियाः केचिज्जमदग्निं निहत्य च।\nविविशुर्गिरिदुर्गाणि मृगाः सिंहार्दिता इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101146, "chapter_id": 3174, "verse_number": "१४-३०-१५", "content_sanskrit": "तेषां स्वविहितं कर्म तद्भयान्नानुतिष्ठताम्।\nप्रजा वृषलतां प्राप्ता ब्राह्मणानामदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101147, "chapter_id": 3174, "verse_number": "१४-३०-१६", "content_sanskrit": "एवं ते द्रविडाऽभीराः पुण्ड्राश्च शबरैः सह।\nवृषलत्वं परिगता व्युत्थानात्क्षत्रधर्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2101148, "chapter_id": 3174, "verse_number": "१४-३०-१७", "content_sanskrit": "ततश्च हतवीरासु क्षत्रियासु पुनः पुनः।\nद्विजैरुत्पादितं क्षत्रं जामदग्न्यो न्यकृन्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2101149, "chapter_id": 3174, "verse_number": "१४-३०-१८", "content_sanskrit": "एकविंशतिमे याते रामं वागशरीरिणी।\nदिव्या प्रोवाच मधुरा सर्वलोकपरिश्रुता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2101150, "chapter_id": 3174, "verse_number": "१४-३०-१९", "content_sanskrit": "रामराम निवर्तस्व कं गुणं तात पश्यसि।\nक्षत्रबन्धूनिमान्प्राणैर्विप्रयोज्य पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2101151, "chapter_id": 3174, "verse_number": "१४-३०-२०", "content_sanskrit": "तथैव तं महात्मानमृचीकप्रमुखास्तदा।\nपितामहा महाभाग निवर्तस्वेत्यथाब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2101152, "chapter_id": 3174, "verse_number": "१४-३०-२१", "content_sanskrit": "पितुर्वधममृष्यंस्तु रामः प्रोवाच तानृषीन्।\nनार्हन्तीह भवन्तो मां निवारयितुमित्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2101153, "chapter_id": 3174, "verse_number": "१४-३०-२२x", "content_sanskrit": "पितर ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2101154, "chapter_id": 3174, "verse_number": "१४-३०-२२", "content_sanskrit": "नार्हसे क्षत्रबन्धूंस्त्वं निहन्तुं जयतांवर।\nनेह युक्तं त्वया हन्तुं ब्राह्मणेन सता नृपान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2101155, "chapter_id": 3174, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि त्रिंशोऽध्यायः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]