[{"id": 2067650, "chapter_id": 2422, "verse_number": "९-४०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2067651, "chapter_id": 2422, "verse_number": "९-४०-१", "content_sanskrit": "उषित्वा तत्र रामस्तु सम्पूज्याश्रमवासिनः।\nतथा मङ्कणके प्रीतिं शुभां चक्रे हलायुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2067652, "chapter_id": 2422, "verse_number": "९-४०-२", "content_sanskrit": "दत्त्वा दानं द्विजातिभ्यो रजनीं तामुपोष्य च।\nपूजितो मुनिसङ्खैश्च प्रातरुत्थाय लाङ्गली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2067653, "chapter_id": 2422, "verse_number": "९-४०-३", "content_sanskrit": "अनुज्ञाप्य मुनीन्सर्वान्स्पृष्ट्वा तोयं च भारत।\nप्रययौ त्वरितो रामस्तीर्थहेतोर्महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2067654, "chapter_id": 2422, "verse_number": "९-४०-४", "content_sanskrit": "ततस्त्वौशनसं तीर्थमाजगाम हलायुधः।\nकपालमोचनं नाम यत्र मुक्तो महामुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2067655, "chapter_id": 2422, "verse_number": "९-४०-५", "content_sanskrit": "महता शिरसा राजन्ग्रस्तजङ्घो महोदरः।\nराक्षसस्य महाराज रामक्षिप्तस्य वै पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2067656, "chapter_id": 2422, "verse_number": "९-४०-६", "content_sanskrit": "तत्र पूर्वं तपस्तप्तं काव्येन सुमहात्मना।\nयत्रास्य नीतिरखिला प्रादुर्भूता महात्मनः।\nयत्रस्थश्चिन्तयामास दैत्यदानवविग्रहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2067657, "chapter_id": 2422, "verse_number": "९-४०-७", "content_sanskrit": "तत्प्राप्य च बलो राजंस्तीर्थप्रवरमुत्तमम्।\nविधिवद्वै ददौ वित्तं ब्राह्मणानां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2067658, "chapter_id": 2422, "verse_number": "९-४०-८x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2067659, "chapter_id": 2422, "verse_number": "९-४०-८", "content_sanskrit": "कपालमोचनं ब्रह्मन्कथं यत्र महामुनिः।\nमुक्तः कथं चास्य शिरो लग्नं केन च हेतुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2067660, "chapter_id": 2422, "verse_number": "९-४०-९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2067661, "chapter_id": 2422, "verse_number": "९-४०-९", "content_sanskrit": "पुरा वै दण्डकारण्ये राघवेण महात्मना।\nवसता राजशार्दूल राक्षसाञ्शमयिष्यता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2067662, "chapter_id": 2422, "verse_number": "९-४०-१०", "content_sanskrit": "जनस्थाने शिरश्छिन्नं राक्षसस्य दुरात्मनः।\nक्षुरेण शितधारेण तत्पणात महावने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2067663, "chapter_id": 2422, "verse_number": "९-४०-११", "content_sanskrit": "महोदरस्य तल्लग्नं जङ्घायां वै यदृच्छया।\nवने विचरतो राजन्नस्थि भित्त्वाऽस्फुरत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2067664, "chapter_id": 2422, "verse_number": "९-४०-१२", "content_sanskrit": "स तेन लग्नेन तदा द्विजातिर्न शशाक ह।\nअभिगन्तुं महाप्राज्ञस्तीर्थान्यायतनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2067665, "chapter_id": 2422, "verse_number": "९-४०-१३", "content_sanskrit": "स पूतिना विस्रवता वेदनार्तो महामुनिः।\nजगाम् सर्वतीर्थानि पृथिव्यां चेति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2067666, "chapter_id": 2422, "verse_number": "९-४०-१४", "content_sanskrit": "स गत्वा सरितः सर्वाः समुद्रांश्च महातपाः।\nकथयामास तत्सर्वमृषीणां भावितात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2067667, "chapter_id": 2422, "verse_number": "९-४०-१५", "content_sanskrit": "आप्लुत्य सर्वतीर्थेषु न च मोक्षमवाप्तवान्।\nस तु शुश्राव विप्रेन्द्रो मुनीनां वचनं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2067668, "chapter_id": 2422, "verse_number": "९-४०-१६", "content_sanskrit": "सरस्वत्यास्तीर्थवरं ख्यातमौशनसं तदा।\nसर्वपापप्रशमनं सिद्धिक्षेत्रमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2067669, "chapter_id": 2422, "verse_number": "९-४०-१७", "content_sanskrit": "स तु गत्वा ततस्तत्र तीर्थमौशनसं द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2067670, "chapter_id": 2422, "verse_number": "९-४०-१८", "content_sanskrit": "तत औशनसे तीर्थे तस्योपस्पृशतस्तदा।\nxxx च्छरश्चरणं मुक्त्वा पपातान्तर्जले तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2067671, "chapter_id": 2422, "verse_number": "९-४०-१९", "content_sanskrit": "विमुक्तस्तेन शिरसा परं सुखमवाप ह।\nस चाप्यन्तर्जले मूर्धा जगामादर्शनं विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2067672, "chapter_id": 2422, "verse_number": "९-४०-२०", "content_sanskrit": "ततः स विरुजो राजन्पूतात्मा वीतकल्मषः।\nआजगामाश्रमं प्रीतः कृतकृत्यो महोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2067673, "chapter_id": 2422, "verse_number": "९-४०-२१", "content_sanskrit": "सोऽथ गत्वाऽऽश्रमं पुण्यं विप्रमुक्तो महातपाः।\nकथयामास तत्सर्वमृषीणां भावितात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2067674, "chapter_id": 2422, "verse_number": "९-४०-२२", "content_sanskrit": "ते श्रुत्वा वचनं तस्य ततस्तीर्थस्य मानद।\nकपालमोचनमिति नाम चक्रुः समागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2067675, "chapter_id": 2422, "verse_number": "९-४०-२३", "content_sanskrit": "स चापि तीर्थप्रवरं पुनर्गत्वा महानृषिः।\nपीत्वा पयःसुविपुलं सिद्धिमायात्तदा मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2067676, "chapter_id": 2422, "verse_number": "९-४०-२४", "content_sanskrit": "तत्र दत्त्वा बहून्देयान्विप्रान्सम्पूज्य माधवः।\nजगाम तत्र राजेन्द्र उशङ्गोराश्रमं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2067677, "chapter_id": 2422, "verse_number": "९-४०-२५", "content_sanskrit": "यत्र तप्तं तपो घोरमार्ष्टिषेणेन भारत।\nब्राह्मण्यं लब्धवान्यत्र विश्वामित्रो महामुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2067678, "chapter_id": 2422, "verse_number": "९-४०-२६", "content_sanskrit": "सर्वकामसमृद्धं च तदाश्रमपदं महत्।\nमुनिभिर्ब्राह्मणैश्चैव सेवितं सर्वदा विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2067679, "chapter_id": 2422, "verse_number": "९-४०-२७", "content_sanskrit": "ततो हलधरः श्रीमान्ब्राह्मणैः परिवारितः।\nजगाम तत्र राजेन्द्र उशङ्गुस्तनुमत्यजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2067680, "chapter_id": 2422, "verse_number": "९-४०-२८", "content_sanskrit": "उशङ्गुर्ब्राह्मणो वृद्धस्तपोनित्यश्च भारत।\nदेहन्यासे कृतमना विचिन्त्य बहुधा तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2067681, "chapter_id": 2422, "verse_number": "९-४०-२९", "content_sanskrit": "ततः सर्वानुपादाय तनयान्वै महातपाः।\nउशङ्गुरब्रवीत्तत्र नयध्वं मां पृथूदकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2067682, "chapter_id": 2422, "verse_number": "९-४०-३०", "content_sanskrit": "विज्ञायातीतवयसमुशङ्गुं ते तपोधनाः।\nतं च तीर्थमपानिन्युः सरस्वत्यास्तपोधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2067683, "chapter_id": 2422, "verse_number": "९-४०-३१", "content_sanskrit": "स तैः पुत्रैस्तदा धीमानानीतो वै सरस्वतीम्।\nपुण्यां तीर्थशतोपेतां विप्रसङ्घैर्निषेविताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2067684, "chapter_id": 2422, "verse_number": "९-४०-३२", "content_sanskrit": "स तत्र विधिना राजन्नाप्लुत्य सुमहातपाः।\nज्ञात्वा तीर्थगुणांश्चैव प्राहेदमृषिसत्तमः।\nसुप्रीतः पुरुषव्याघ्र सर्वान्पुत्रानुपासतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2067685, "chapter_id": 2422, "verse_number": "९-४०-३३", "content_sanskrit": "सरस्वत्युत्तरे तीरे यस्त्यजेदात्मनस्तनुम्।\nपृथूदके जप्यपरो नैनं श्वो मरणं तपेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2067686, "chapter_id": 2422, "verse_number": "९-४०-३४", "content_sanskrit": "`इत्युक्त्वा स्वां तनुं त्यक्त्वा प्रपेदे वैष्णवं पदम्।\nतत्राप्लुत्य स धर्मात्मा उपस्पृश्य हलायुधः।\nदत्त्वा चैव बूहून्देयान्विप्राणां विप्रवत्सलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2067687, "chapter_id": 2422, "verse_number": "९-४०-३५", "content_sanskrit": "ससर्ज यत्र भगवाँल्लोकाँल्लोकपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2067688, "chapter_id": 2422, "verse_number": "९-४०-३६", "content_sanskrit": "यत्रार्ष्टिषेणः कौरव्य ब्राह्मण्यं संशितव्रतः।\nतपसा महता राजन्प्राप्तवानृषिसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2067689, "chapter_id": 2422, "verse_number": "९-४०-३७", "content_sanskrit": "सिन्धुद्वीपश्च राजर्षिर्देवापिश्च महातपाः।\nब्राह्मण्यं लब्धवान्यत्र विश्वामित्रस्तथा मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2067690, "chapter_id": 2422, "verse_number": "९-४०-३८", "content_sanskrit": "महातपस्वीं भगवानुग्रतेजा महातपाः।\nतत्राजगाम बलवान्बलभद्रः प्रतापवान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2067691, "chapter_id": 2422, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि चत्वारिंशोऽध्यायः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]