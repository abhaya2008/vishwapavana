[{"id": 50005299, "chapter_id": 11010, "verse_number": "1", "content_sanskrit": "॥ [ॐ] शुगस्य तदनादरश्रवणात् तदाद्रवणात् सूच्यते हि [ॐ]॥ १/३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50005300, "chapter_id": 11010, "verse_number": "2", "content_sanskrit": "॥ [ॐ] क्षत्रियत्वावगतेश्चोत्तरत्र चैत्ररथेन लिङ्गात् [ॐ]॥ १/३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50005301, "chapter_id": 11010, "verse_number": "3", "content_sanskrit": "॥ [ॐ] संस्कारपरामर्शात् तदभावाभिलापाच्च [ॐ]॥ १/३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50005302, "chapter_id": 11010, "verse_number": "4", "content_sanskrit": "॥ [ॐ] तदभावनिर्धारणे च प्रवृत्तेः [ॐ]॥ १/३/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50005303, "chapter_id": 11010, "verse_number": "5", "content_sanskrit": "॥ [ॐ] श्रवणाध्ययनार्थप्रतिषेधात् स्मृतेश्च [ॐ]॥ १/३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]