[{"id": 40016653, "chapter_id": 9251, "verse_number": "1", "content_sanskrit": "तस्यराक्षसराजस्यनिशम्यपरिदेवितम् । कुम्भकर्णोबभाषेदंवचनंप्रजहास च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40016654, "chapter_id": 9251, "verse_number": "2", "content_sanskrit": "दृष्टोदोषोहियोऽस्माभिःपुरामन्त्रन्वििर्णये । हितेष्वनभियुक्तेनसोऽयमासादितस्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40016655, "chapter_id": 9251, "verse_number": "3", "content_sanskrit": "शीघ्रंखल्वभ्युपेतंत्वांफलंपापस्यकर्मणः । निरयेष्वेवपतनंयथादुष्कृतकर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40016656, "chapter_id": 9251, "verse_number": "4", "content_sanskrit": "प्रथमंवैमहाराजकृत्यमेतदचिन्तितम् । केवलंवीर्यदर्पेणनानुबन्धोविचिन्तितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40016657, "chapter_id": 9251, "verse_number": "5", "content_sanskrit": "यःपश्चातूर्वकार्याणिकुर्यादैश्वर्यमास्थितः । पूर्वंचोत्तरकार्याणि न स वेदनयानया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40016658, "chapter_id": 9251, "verse_number": "6", "content_sanskrit": "देशकालविहीनानिकर्माणिविपरीतवत् । क्रियमाणानिदुष्यन्तिहवींष्यप्रयतेष्विव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40016659, "chapter_id": 9251, "verse_number": "7", "content_sanskrit": "त्रयाणांपञ्चधायोगंकर्मणांयःप्रपश्यति । सचिवैस्समयंकृत्वा स सभ्येवर्ततेपथि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40016660, "chapter_id": 9251, "verse_number": "8", "content_sanskrit": "यथागमं च योराजासमयंविचिकीर्षति । बुध्यतेसचिवान्बध्यासुहृदश्चानुपश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40016661, "chapter_id": 9251, "verse_number": "9", "content_sanskrit": "धर्ममर्थं च कामं च सर्वान्वारक्षसांपते । भजतेपुरुषःकालेत्रीणिद्वन्द्वानिवापुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40016662, "chapter_id": 9251, "verse_number": "10", "content_sanskrit": "त्रिषुचैतेषुयच्छ्रेष्ठंश्रुत्वातन्नावबुध्यते । राजावाराजमात्रोवाव्यर्थंतस्यबहुश्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40016663, "chapter_id": 9251, "verse_number": "11", "content_sanskrit": "उपप्रदानंसान्त्वं च भेदंकाले च विक्रमम् । योगं च रक्षसांश्रेष्ठतावुभौ च नयानयौ ॥ कालेधर्मार्थकामान्यस्सम्मन्त्ऱ्यसचिवैःसह । निषेवेतात्मवान्लोके न स व्यसनमाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40016664, "chapter_id": 9251, "verse_number": "12", "content_sanskrit": "उपप्रदानंसान्त्वं च भेदंकाले च विक्रमम् । योगं च रक्षसांश्रेष्ठतावुभौ च नयानयौ ॥ कालेधर्मार्थकामान्यस्सम्मन्त्ऱ्यसचिवैःसह । निषेवेतात्मवान्लोके न स व्यसनमाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40016665, "chapter_id": 9251, "verse_number": "13", "content_sanskrit": "हितानुबन्धमालोच्यकार्यात्कार्यमिहात्मनः । राजासहार्थतत्त्वज्ञैस्सचिवैर्बुस्सहिजीवति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40016666, "chapter_id": 9251, "verse_number": "14", "content_sanskrit": "अनभिज्ञायशास्त्रार्थान् पुरुषाःपशुबुद्धयः । प्रागल्भ्याद्वक्तुमिच्छन्तिमन्त्रेष्वभ्यन्तरीकृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40016667, "chapter_id": 9251, "verse_number": "15", "content_sanskrit": "अशास्त्रविदुषांतेषां न कार्यमभिहितंवचः । अर्थशास्त्रानभिज्ञानांविपुलांश्रियमिच्छताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40016668, "chapter_id": 9251, "verse_number": "16", "content_sanskrit": "अहितं च हिताकारंधार्ष्ट्याज्जल्पन्तियेनराः । अवेक्ष्यमन्त्रबाह्यास्तेकर्तव्याःकृत्यदूषणा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40016669, "chapter_id": 9251, "verse_number": "17", "content_sanskrit": "विनाशयन्तोभर्तारंसहिताश्शत्रुभिर्बुधैः । विपरीतानिकृत्यानिकारयन्तीहमन्त्रिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40016670, "chapter_id": 9251, "verse_number": "18", "content_sanskrit": "तान्भर्तामित्रसङ्काशानमित्रान्मन्त्रनिर्णये । व्यवहारेणजानीयात्सचिवानुपसम्हितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40016671, "chapter_id": 9251, "verse_number": "19", "content_sanskrit": "चपलस्येहकृत्यानिसहसानुप्रधावतः । छिद्रमन्येप्रपद्यन्तेक्रौञ्चस्य ख मिवद्विजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40016672, "chapter_id": 9251, "verse_number": "20", "content_sanskrit": "योहिशत्रुमवज्ञायनात्मानमभिरक्षति । अवाप्नोतिहिसोऽनर्थान् स्थानाच्चव्यवरोप्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40016673, "chapter_id": 9251, "verse_number": "21", "content_sanskrit": "यदुक्तमिहतेपूर्वंक्रियतामनुजेन च । तदेवनोहितंवाक्यंयदिच्छसि च तत्कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40016674, "chapter_id": 9251, "verse_number": "22", "content_sanskrit": "तत्तुश्रुत्वादशग्रीवःकुम्भकर्णस्यभाषितम् । भ्रुकुटिंचैवसञ्चक्रेक्रुद्धश्चैनमभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40016675, "chapter_id": 9251, "verse_number": "23", "content_sanskrit": "मान्योगुरुवारिचार्यःकिमांत्वमनुशाससि । किमेवंवाक्छ्रमंकृत्वाकालेयुक्तंविधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40016676, "chapter_id": 9251, "verse_number": "24", "content_sanskrit": "विभ्रमाच्चित्तमोहाद्वाबलवीर्याश्रयेणवा । नाभिपन्नमिदानींयद्व्यर्थातस्यपुनःकथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40016677, "chapter_id": 9251, "verse_number": "25", "content_sanskrit": "अस्मिन्कालेतुयद्युक्तंतदिदानींविधीयताम् । गतंतुनानुशोचन्तिगतंतुगतमेवहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40016678, "chapter_id": 9251, "verse_number": "26", "content_sanskrit": "ममापनयजंदोषंविक्रमेणसमीकुरु । यदिखल्वस्तिमेस्नेहोविक्रमंवाऽवगच्छसि ॥ यदिवकार्यंमेतत्तेहृदिकार्यतमंमतम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40016679, "chapter_id": 9251, "verse_number": "27", "content_sanskrit": "स सुहृद्योविपन्नार्थंदीनमभ्यवपद्यते ॥ स बन्धुर्योऽपनीतेषुसाहाय्यायोपकल्पते ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40016680, "chapter_id": 9251, "verse_number": "28", "content_sanskrit": "तमथैवंब्रुवाणंतुवचनंधीरदारुणम् ॥ रुष्टोऽयमितिविज्ञायशनैश्श्लक्षणमुवाच ह ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40016681, "chapter_id": 9251, "verse_number": "29", "content_sanskrit": "अतीवहिसमालक्ष्यभ्रातरंक्षुभितेन्द्रियम् ॥ कुम्भकर्णश्शनैर्वाक्यंबभाषेपरिसान्त्वयन् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40016682, "chapter_id": 9251, "verse_number": "30", "content_sanskrit": "शृणुराजन्नवहितोममवाक्यमरिन्दम ॥ अलंराक्षसराजेन्द्र सन्तापमुपपद्यते । रोषं च सम्परित्यज्यस्वस्थोभवितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40016683, "chapter_id": 9251, "verse_number": "31", "content_sanskrit": "शृणुराजन्नवहितोममवाक्यमरिन्दम ॥ अलंराक्षसराजेन्द्र सन्तापमुपपद्यते । रोषं च सम्परित्यज्यस्वस्थोभवितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40016684, "chapter_id": 9251, "verse_number": "32", "content_sanskrit": "नैतन्मनसिकर्तव्यंमयिजीवतिपार्थिव । तमहंनाशयिष्यामियत्कृतेपरितप्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40016685, "chapter_id": 9251, "verse_number": "33", "content_sanskrit": "अवश्यंतुहितंवाच्यंसर्वावस्थांतवमया । बन्धुभावादभिहितंभ्रातृस्नेहाच्छपार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40016686, "chapter_id": 9251, "verse_number": "34", "content_sanskrit": "सदृशंयत्तुकालेऽस्मिन् कर्तुंस्निग्धेनबन्धुना । शत्रूणांकदनंपश्यक्रियमाणंमयारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40016687, "chapter_id": 9251, "verse_number": "35", "content_sanskrit": "अद्यपश्यमहाबाहो मयासमरमूर्धनि । हतेरामेसहभ्रात्राद्रवन्तींहरिवाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40016688, "chapter_id": 9251, "verse_number": "36", "content_sanskrit": "अद्यरामस्यतद्दृष्टवामयानीतंरणाच्छिरः । सुखीभवमहाबाहो सीताभवतुदुःखिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40016689, "chapter_id": 9251, "verse_number": "37", "content_sanskrit": "अद्यरामस्यपश्यन्तुनिधनंसुमहत्प्रियम् । लङ्कायांराक्षसाःसर्वेयेतेनिहतबान्धवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40016690, "chapter_id": 9251, "verse_number": "38", "content_sanskrit": "अद्यशोकपरीतानांस्वबन्धुवधकारणात् । शत्रोर्युधिविनाशेनकरोम्यस्रप्रमार्जनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40016691, "chapter_id": 9251, "verse_number": "39", "content_sanskrit": "अद्यपर्वतसङ्काशंससूर्यमिवतोयदम् । विकीर्णंपश्यसमरेसुग्रीवंप्लवगोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40016692, "chapter_id": 9251, "verse_number": "40", "content_sanskrit": "कथं च राक्षसैरेभिर्मया च परिरक्षितः । जिघांसुभिर्दाशरथिं वध्यसे त्वमिहानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40016693, "chapter_id": 9251, "verse_number": "41", "content_sanskrit": "मांनिहत्यकिलत्वांहिनिहनिष्यतिराघवः । नाहमात्मनिसन्तापंगच्छेयंराक्षसाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40016694, "chapter_id": 9251, "verse_number": "42", "content_sanskrit": "कामंवतिदानीमपिमांव्यादिशत्वंपरन्तप । न परःप्रेषणीयस्तेयुद्धायातुलविक्रम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40016695, "chapter_id": 9251, "verse_number": "43", "content_sanskrit": "अहमुत्सादयिष्यामिशत्रूंस्तवमहाबल: । यदिशक्रोयदियमोयदिपावकमारुतौ ॥ तानहंयोधयिष्यामिकुबेरवरुणावपि ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40016696, "chapter_id": 9251, "verse_number": "44", "content_sanskrit": "गिरिमात्रशरीरस्यशितशूलधरस्यमे ॥ नर्दतस्तीक्षणदंष्ट्रस्यबिभीयाच्चपुरन्दरः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40016697, "chapter_id": 9251, "verse_number": "45", "content_sanskrit": "अथवात्यक्तशस्त्रस्यमृद्नतस्तरसारिपून् ॥ न मेप्रतिमुखेस्थातुंकश्चित् शक्तोजिजीविषुः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40016698, "chapter_id": 9251, "verse_number": "46", "content_sanskrit": "नैवशक्त्या न गदयानासिनानिशितैश्शरैः ॥ हस्ताभ्यामेवसम्रब्दोहनिष्याम्यपिवज्रिणम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40016699, "chapter_id": 9251, "verse_number": "47", "content_sanskrit": "यदिमेमुष्टिवेगं स राघवोऽद्यसहिष्यते ॥ ततःपाश्यन्तिबाणौघारुधिरंराघवस्यतु ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40016700, "chapter_id": 9251, "verse_number": "48", "content_sanskrit": "चिन्तयाबाध्यसेराजन्किमर्थंमयितिष्ठति ॥ सोऽहंशत्रुविनाशाय तव निर्यातुमुद्यतः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40016701, "chapter_id": 9251, "verse_number": "49", "content_sanskrit": "मुञ्चरामाद्भयंराज न्हनिष्यामीहसम्युगे ॥ राघवंलक्ष्मणंचैवसुग्रीवं च महाबलम् । हनूमन्तं च रक्षोघ्नंलङ्कायेनप्रदीपिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40016702, "chapter_id": 9251, "verse_number": "50", "content_sanskrit": "मुञ्चरामाद्भयंराज न्हनिष्यामीहसम्युगे ॥ राघवंलक्ष्मणंचैवसुग्रीवं च महाबलम् । हनूमन्तं च रक्षोघ्नंलङ्कायेनप्रदीपिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 40016703, "chapter_id": 9251, "verse_number": "51", "content_sanskrit": "हरींश्चापिहनियिष्यामिसंयुगेसमवास्थिवान् । असाधारणमिच्छामिनदातुंमहद्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 40016704, "chapter_id": 9251, "verse_number": "52", "content_sanskrit": "तदिचेन्द्राद्भयं राजन्यदि चापिस्वयम्भुवः । ततोऽहंनाशयिष्यामिनैशंतमइवांशुमान् ॥ अपिदेवाश्शयिष्यन्तेक्रुद्धेमयिमहीतले ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 40016705, "chapter_id": 9251, "verse_number": "53", "content_sanskrit": "यमं च शमयिष्यामिभक्षयिष्यामिपावकम् ॥ आदित्यंपातयिष्यामिसनक्षत्रंमहीतले ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 40016706, "chapter_id": 9251, "verse_number": "54", "content_sanskrit": "शतक्रतुंवधिष्यामिपास्यामिवरुणालयम् ॥ पर्वतांश्चूर्णयिष्यामिदारयिष्यामिमेदिनीम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 40016707, "chapter_id": 9251, "verse_number": "55", "content_sanskrit": "दीर्घकालंप्रसुप्तस्यकुम्भकर्णस्यविक्रमम् ॥ अद्यपश्यन्तुभूतानिभक्ष्यमाणानिसर्वशः । नन्विदंत्रिदिवंसर्वमाहारस्य न पूर्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 40016708, "chapter_id": 9251, "verse_number": "56", "content_sanskrit": "दीर्घकालंप्रसुप्तस्यकुम्भकर्णस्यविक्रमम् ॥ अद्यपश्यन्तुभूतानिभक्ष्यमाणानिसर्व