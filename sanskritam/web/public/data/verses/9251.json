[{"id": 5000251000, "chapter_id": 9251, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे पञ्चपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000251001, "chapter_id": 9251, "verse_number": "३-५५-१", "content_sanskrit": "संदिश्य राक्षसान् घोरान् रावणोऽष्टौ महाबलान्।\nआत्मानं बुद्धिवैक्लव्यात् कृत्कृत्यममन्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000251002, "chapter_id": 9251, "verse_number": "३-५५-२", "content_sanskrit": "स चिन्तयानो वैदेहीं कामबाणैः प्रपीडितः।\nप्रविवेश गृहं रम्यं सीतां द्रष्टुमभित्वरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000251003, "chapter_id": 9251, "verse_number": "३-५५-३", "content_sanskrit": "स प्रविश्य तु तद्वेश्म रावणो राक्षसाधिपः।\nअपश्यद् राक्षसीमध्ये सीतां दुःखपरायणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000251004, "chapter_id": 9251, "verse_number": "३-५५-४", "content_sanskrit": "अश्रुपूर्णमुखीं दीनां शोकभारावपीडिताम्।\nवायुवेगैरिवाक्रान्तां मज्जन्तीं नावमर्णवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000251005, "chapter_id": 9251, "verse_number": "३-५५-५", "content_sanskrit": "मृगयूथपरिभ्रष्टां मृगीं श्वभिरिवावृताम्।\nअधोगतमुखीं सीतां तामभ्येत्य निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000251006, "chapter_id": 9251, "verse_number": "३-५५-६", "content_sanskrit": "तां तु शोकवशाद् दीनामवशां राक्षसाधिपः।\nसबलाद् दर्शयामास गृहं देवगृहोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000251007, "chapter_id": 9251, "verse_number": "३-५५-७", "content_sanskrit": "हर्म्यप्रासादसम्बाधं स्त्रीसहस्रनिषेवितम्।\nनानापक्षिगणैर्जुष्टं नानारत्नसमन्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000251008, "chapter_id": 9251, "verse_number": "३-५५-८", "content_sanskrit": "दान्तकैस्तापनीयैश्च स्फाटिकै राजतैस्तथा।\nवज्रवैदूर्यचित्रैश्च स्तम्भैर्दृष्टिमनोरमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000251009, "chapter_id": 9251, "verse_number": "३-५५-९", "content_sanskrit": "दिव्यदुन्दुभिनिर्घोषं तप्तकाञ्चनभूषणम्।\nसोपानं काञ्चनं चित्रमारुरोह तया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000251010, "chapter_id": 9251, "verse_number": "३-५५-१०", "content_sanskrit": "दान्तका राजताश्चैव गवाक्षाः प्रियदर्शनाः।\nहेमजालावृताश्चासंस्तत्र प्रासादपङ्‍क्तयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000251011, "chapter_id": 9251, "verse_number": "३-५५-११", "content_sanskrit": "सुधामणिविचित्राणि भूमिभागानि सर्वशः।\nदशग्रीवः स्वभवने प्रादर्शयत मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000251012, "chapter_id": 9251, "verse_number": "३-५५-१२", "content_sanskrit": "दीर्घिकाः पुष्करिण्यश्च नानापुष्पसमावृताः।\nरावणो दर्शयामास सीतां शोकपरायणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000251013, "chapter_id": 9251, "verse_number": "३-५५-१३", "content_sanskrit": "दर्शयित्वा तु वैदेहीं कृत्स्नं तद्भवनोत्तमम्।\nउवाच वाक्यं पापात्मा सीतां लोभितुमिच्छया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000251014, "chapter_id": 9251, "verse_number": "३-५५-१४", "content_sanskrit": "दश राक्षसकोट्यश्च द्वाविंशतिरथापराः।\nवर्जयित्वा जरावृद्धान् बालांश्च रजनीचरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000251015, "chapter_id": 9251, "verse_number": "३-५५-१५", "content_sanskrit": "तेषां प्रभुरहं सीते सर्वेषां भीमकर्मणाम्।\nसहस्रमेकमेकस्य मम कार्यपुरःसरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000251016, "chapter_id": 9251, "verse_number": "३-५५-१६", "content_sanskrit": "यदिदं राज्यतन्त्रं मे त्वयि सर्वं प्रतिष्ठितम्।\nजीवितं च विशालाक्षि त्वं मे प्राणैर्गरीयसी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000251017, "chapter_id": 9251, "verse_number": "३-५५-१७", "content_sanskrit": "बह्वीनामुत्तमस्त्रीणां मम योऽसौ परिग्रहः।\nतासां त्वमीश्वरी सीते मम भार्या भव प्रिये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000251018, "chapter_id": 9251, "verse_number": "३-५५-१८", "content_sanskrit": "साधु किं तेऽन्यथाबुद्‍ध्या रोचयस्व वचो मम।\nभजस्व माभितप्तस्य प्रसादं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000251019, "chapter_id": 9251, "verse_number": "३-५५-१९", "content_sanskrit": "परिक्षिप्ता समुद्रेण लङ्केयं शतयोजना।\nनेयं धर्षयितुं शक्या सेन्द्रैरपि सुरासुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000251020, "chapter_id": 9251, "verse_number": "३-५५-२०", "content_sanskrit": "न देवेषु न यक्षेषु न गन्धर्वेषु नर्षिषु।\nअहं पश्यामि लोकेषु यो मे वीर्यसमो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000251021, "chapter_id": 9251, "verse_number": "३-५५-२१", "content_sanskrit": "राज्यभ्रष्टेन दीनेन तापसेन पदातिना।\nकिं करिष्यसि रामेण मानुषेणाल्पतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000251022, "chapter_id": 9251, "verse_number": "३-५५-२२", "content_sanskrit": "भजस्व सीते मामेव भर्ताहं सदृशस्तव।\nयौवनं त्वध्रुवं भीरु रमस्वेह मया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000251023, "chapter_id": 9251, "verse_number": "३-५५-२३", "content_sanskrit": "दर्शने मा कृथा बुद्धिं राघवस्य वरानने।\nकास्य शक्तिरिहागन्तुमपि सीते मनोरथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000251024, "chapter_id": 9251, "verse_number": "३-५५-२४", "content_sanskrit": "न शक्यो वायुराकाशे पाशैर्बद‍्धुं महाजवः।\nदीप्यमानस्य वाप्यग्नेर्ग्रहीतुं विमलाः शिखाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000251025, "chapter_id": 9251, "verse_number": "३-५५-२५", "content_sanskrit": "त्रयाणामपि लोकानां न तं पश्यामि शोभने।\nविक्रमेण नयेद् यस्त्वां मद‍्बाहुपरिपालिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000251026, "chapter_id": 9251, "verse_number": "३-५५-२६", "content_sanskrit": "लङ्कायाः सुमहद्राज्यमिदं त्वमनुपालय।\nत्वत्प्रेष्या मद्विधाश्चैव देवाश्चापि चराचरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000251027, "chapter_id": 9251, "verse_number": "३-५५-२७", "content_sanskrit": "अभिषेकजलक्लिन्ना तुष्टा च रमयस्व च।\nदुष्कृतं यत्पुरा कर्म वनवासेन तद्‍गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000251028, "chapter_id": 9251, "verse_number": "३-५५-२८", "content_sanskrit": "यच्च ते सुकृतं कर्म तस्येह फलमाप्नुहि।\nइह सर्वाणि माल्यानि दिव्यगन्धानि मैथिलि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000251029, "chapter_id": 9251, "verse_number": "३-५५-२९", "content_sanskrit": "भूषणानि च मुख्यानि तानि सेव मया सह।\nपुष्पकं नाम सुश्रोणि भ्रातुर्वैश्रवणस्य मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000251030, "chapter_id": 9251, "verse_number": "३-५५-३०", "content_sanskrit": "विमानं सूर्यसंकाशं तरसा निर्जितं रणे।\nविशालं रमणीयं च तद्विमानं मनोजवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000251031, "chapter_id": 9251, "verse_number": "३-५५-३१", "content_sanskrit": "तत्र सीते मया सार्धं विहरस्व यथासुखम्।\nवदनं पद्मसंकाशं विमलं चारुदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000251032, "chapter_id": 9251, "verse_number": "३-५५-३२", "content_sanskrit": "शोकार्तं तु वरारोहे न भ्राजति वरानने।\nएवं वदति तस्मिन् सा वस्त्रान्तेन वराङ्गना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000251033, "chapter_id": 9251, "verse_number": "३-५५-३३", "content_sanskrit": "पिधायेन्दुनिभं सीता मन्दमश्रूण्यवर्तयत्।\nध्यायन्तीं तामिवास्वस्थां सीतां चिन्ताहतप्रभाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000251034, "chapter_id": 9251, "verse_number": "३-५५-३४", "content_sanskrit": "उवाच वचनं वीरो रावणो रजनीचरः।\nअलं व्रीडेन वैदेहि धर्मलोपकृतेन ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000251035, "chapter_id": 9251, "verse_number": "३-५५-३५", "content_sanskrit": "आर्षोऽयं देवि निष्पन्दो यस्त्वामभिभविष्यति।\nएतौ पादौ मया स्निग्धौ शिरोभिः परिपीडितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000251036, "chapter_id": 9251, "verse_number": "३-५५-३६", "content_sanskrit": "प्रसादं कुरु मे क्षिप्रं वश्यो दासोऽहमस्मि ते।\nइमाः शून्या मया वाचः शुष्यमाणेन भाषिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000251037, "chapter_id": 9251, "verse_number": "३-५५-३७", "content_sanskrit": "न चापि रावणः कांचिन्मूर्ध्ना स्त्रीं प्रणमेत ह।\nएवमुक्त्वा दशग्रीवो मैथिलीं जनकात्मजाम्।\nकृतान्तवशमापन्नो ममेयमिति मन्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000251038, "chapter_id": 9251, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे पञ्चपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]