[{"id": 2027073, "chapter_id": 1580, "verse_number": "३-२१८-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2027074, "chapter_id": 1580, "verse_number": "३-२१८-१", "content_sanskrit": "गुरू निवेद्य विप्राय तौ मातापितरावुभौ।\nपुनरेव स धर्मात्मा व्याधो ब्राह्मणमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2027075, "chapter_id": 1580, "verse_number": "३-२१८-२", "content_sanskrit": "प्रवृत्तचक्षुर्जातोस्मि संपश्य तपसो बलम्।\nयदर्थमुक्तोसि तया गच्छ त्वं मिथिलामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2027076, "chapter_id": 1580, "verse_number": "३-२१८-३", "content_sanskrit": "पतिशुश्रूषपरया दान्तया सत्यशीलया।\nमिथिलायां वसन्व्याधः स ते धर्मान्प्रवक्ष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2027077, "chapter_id": 1580, "verse_number": "३-२१८-४x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2027078, "chapter_id": 1580, "verse_number": "३-२१८-४", "content_sanskrit": "पतिव्रतायाः सत्यायाः शीलाढ्याया यतव्रत।\nसंस्मृत्य वाक्यं धर्मज्ञ गुणवानसि मे मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2027079, "chapter_id": 1580, "verse_number": "३-२१८-५x", "content_sanskrit": "व्याध उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2027080, "chapter_id": 1580, "verse_number": "३-२१८-५", "content_sanskrit": "यत्तया त्वं द्विजश्रेष्ठ नियुक्तो मां प्रति प्रभो।\nदृष्टमेव तया सम्यगेकपत्न्या न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2027081, "chapter_id": 1580, "verse_number": "३-२१८-६", "content_sanskrit": "त्वदनुग्रहबुद्ध्या तु विप्रैतद्दर्शितं मया।\nवाक्यं च शृणु मे तात यत्ते वक्ष्ये हितं द्विज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2027082, "chapter_id": 1580, "verse_number": "३-२१८-७", "content_sanskrit": "त्वया न पूजिता माता पिता च द्विजसत्तम।\nअनिसृष्टोसि निष्क्रान्तो गृहात्ताभ्यामनिनदित ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2027083, "chapter_id": 1580, "verse_number": "३-२१८-८", "content_sanskrit": "वेदोच्चारणकार्यार्थमयुक्तं तत्त्वया कृतम्।\nतव शोकेन वृद्धौ तावन्धीभूतौ तपस्विनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2027084, "chapter_id": 1580, "verse_number": "३-२१८-९", "content_sanskrit": "तौ प्रसादयितुं गच्छ मा त्वां धर्मोऽत्यगादयम्।\nतपस्वी त्वं महात्मा च धर्मे च निरतः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2027085, "chapter_id": 1580, "verse_number": "३-२१८-१०", "content_sanskrit": "सर्वमेतदपार्थं ते क्षिप्रं तौ संप्रसादय।\n`तौ प्रसाद्य द्विजश्रेष्ठ यच्छ्रेयस्तदवाप्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2027086, "chapter_id": 1580, "verse_number": "३-२१८-११", "content_sanskrit": "श्रद्दधस्व मम ब्रह्मन्नान्यथा कर्तुमर्हसि।\nयम्यतामद्यविप्रर्षे श्रेयस्ते कथयाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2027087, "chapter_id": 1580, "verse_number": "३-२१८-१२x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2027088, "chapter_id": 1580, "verse_number": "३-२१८-१२", "content_sanskrit": "यदेतदुक्तं भवता सर्वं सत्यमसंशयम्।\nप्रीतोस्मि तव भद्रं ते धर्माचारगुणान्वित ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2027089, "chapter_id": 1580, "verse_number": "३-२१८-१३x", "content_sanskrit": "व्याध उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2027090, "chapter_id": 1580, "verse_number": "३-२१८-१३", "content_sanskrit": "दैवतप्रतिमो हि त्वं यस्त्वं धर्ममनुव्रतः।\nपुराणं शाश्वतं दिव्यं दुष्प्रापमकृतात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2027091, "chapter_id": 1580, "verse_number": "३-२१८-१४", "content_sanskrit": "मातापित्रोः सकाशं हि गत्वात्वं द्विजसत्तम।\nअतन्द्रितः कुरु क्षिप्रंमातापित्रोर्हि पूजनम्।\nअतः परमहं धर्मं नान्यं पश्यामि कंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2027092, "chapter_id": 1580, "verse_number": "३-२१८-१५x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2027093, "chapter_id": 1580, "verse_number": "३-२१८-१५", "content_sanskrit": "इहाहमागतो दिष्ट्या दिष्ट्या मे संगतं त्वया।\nईदृशा दुर्लभा लोके नरा धर्मप्रदर्शकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2027094, "chapter_id": 1580, "verse_number": "३-२१८-१६", "content_sanskrit": "एकोनरसहस्रेषु धर्मवानविद्यते न वा।\nप्रीतोस्मि तवसत्येन भद्रं ते पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2027095, "chapter_id": 1580, "verse_number": "३-२१८-१७", "content_sanskrit": "पतमानोऽद्यनरके भवताऽस्मि समुद्धृतः।\nभवितव्यमथैवं च यद्दृष्टोसि मयाऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2027096, "chapter_id": 1580, "verse_number": "३-२१८-१८", "content_sanskrit": "राजा ययातिर्दौहित्रैः पतितस्तारितो यथा।\nसद्भिः पुरुषशार्दूल तथाऽहं भवता त्विह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2027097, "chapter_id": 1580, "verse_number": "३-२१८-१९", "content_sanskrit": "मातापितृभ्यां शुश्रूषां करिष्ये वचनात्तव।\nनाकृतात्मा वेदयति धर्माधर्मविनिश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2027098, "chapter_id": 1580, "verse_number": "३-२१८-२०", "content_sanskrit": "दुर्ज्ञेयः शाश्वतो धर्मः शूद्रयोनौ हि वर्तता।\nन त्वां शूद्रमहं मन्ये भवितव्यं हि कारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2027099, "chapter_id": 1580, "verse_number": "३-२१८-२१", "content_sanskrit": "येन कर्मविशेषेण प्राप्तेयं शूद्रता त्वया।\nएतामिच्छामि विज्ञातुं तत्त्वेन तव शूद्रताम्।\nकामयानस् मे शंस सर्वं त्वं प्रयतात्मवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2027100, "chapter_id": 1580, "verse_number": "३-२१८-२२x", "content_sanskrit": "व्याघ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2027101, "chapter_id": 1580, "verse_number": "३-२१८-२२", "content_sanskrit": "अनतिक्रमणीया वै ब्राह्मणा मे द्विजोत्तम।\nशृणु सर्वमिदं वृत्तं पूर्वदेहे ममानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2027102, "chapter_id": 1580, "verse_number": "३-२१८-२३", "content_sanskrit": "अहं हि ब्राह्मणः पूर्वमासं द्विजवरात्मजः।\nवेदाध्यायी सुकुशलो वेदाङ्गानां च पारगः।\nआत्मदोषकृतैर्ब्रह्मन्नवस्थामाप्तवानिमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2027103, "chapter_id": 1580, "verse_number": "३-२१८-२४", "content_sanskrit": "कश्चिद्राजा मम सखा धनुर्वेदपरायणः।\nसंसर्गाद्धनुषि श्रेष्ठस्ततोऽहमभवं द्विज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2027104, "chapter_id": 1580, "verse_number": "३-२१८-२५", "content_sanskrit": "एतस्मिन्नेव काले तु मृगयां निर्गतो नृपः।\nसहितो योधमुख्यैश् मन्त्रिभिश्च सुसंवृतः।\nततोऽभ्यहन्मृगांस्तत्र सुबहूनाश्रमं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2027105, "chapter_id": 1580, "verse_number": "३-२१८-२६", "content_sanskrit": "अथ क्षिप्तः शरो घोरो मयापि द्विजसत्तम।\nताडितश्च ऋषिस्तन शरेणानतपर्वणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2027106, "chapter_id": 1580, "verse_number": "३-२१८-२७", "content_sanskrit": "भूमौ निपतितो ब्रह्मन्नुवाच प्रतिनादयन्।\nनापराध्याम्यहं किंचित्केन पापमिदं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2027107, "chapter_id": 1580, "verse_number": "३-२१८-२८", "content_sanskrit": "मन्वानस्तं मृगं चाहं संप्राप्तः सहसा मुनिम्।\nअपश्यं तमृषिं विद्धं शरेणानतपर्वणा।\nतमुग्रतपसं विप्रं निष्टनन्तं महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2027108, "chapter_id": 1580, "verse_number": "३-२१८-२९", "content_sanskrit": "अकार्यकरणाच्चापि भृशं मे व्यथितं मनः।\nअजानता कृतमिदं मयेत्यहमथाब्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2027109, "chapter_id": 1580, "verse_number": "३-२१८-३०", "content_sanskrit": "क्षन्तुमर्हसि मे सर्वमिति चोक्तो मया मुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2027110, "chapter_id": 1580, "verse_number": "३-२१८-३१", "content_sanskrit": "ततः प्रत्यब्रवीद्वाक्यमृषिर्मां क्रोधमूर्च्छितः।\nव्याधस्त्वं भविता क्रूर शूद्रयोनाविति द्विज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2027111, "chapter_id": 1580, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि अष्टादशाधिकद्विशततमोऽध्यायः ॥ २१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]