[
  {
    "id": 16766001,
    "chapter_id": 6166,
    "verse_number": "18.1",
    "content_sanskrit": "अर्जुन उवाच —",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "BG_C18_V01"
  },
  {
    "id": 16766002,
    "chapter_id": 6166,
    "verse_number": "18.2",
    "content_sanskrit": "श्रीभगवानुवाच —",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "BG_C18_V02"
  },
  {
    "id": 16766003,
    "chapter_id": 6166,
    "verse_number": "18.3",
    "content_sanskrit": "त्याज्यं दोषवदित्येके कर्म प्राहुर्मनीषिणः ।\nयज्ञदानतपःकर्म न त्याज्यमिति चापरे ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "BG_C18_V03"
  },
  {
    "id": 16766004,
    "chapter_id": 6166,
    "verse_number": "18.4",
    "content_sanskrit": "निश्चयं शृणु मे तत्र\nत्यागे भरतसत्तम ।\nत्यागो हि पुरुषव्याघ्र\nत्रिविधः सम्प्रकीर्तितः ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "BG_C18_V04"
  },
  {
    "id": 16766005,
    "chapter_id": 6166,
    "verse_number": "18.5",
    "content_sanskrit": "यज्ञदानतपःकर्म न त्याज्यं कार्यमेव तत् ।\nयज्ञो दानं तपश्चैव पावनानि मनीषिणाम् ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "BG_C18_V05"
  },
  {
    "id": 16766006,
    "chapter_id": 6166,
    "verse_number": "18.6",
    "content_sanskrit": "एतान्यपि तु कर्माणि\nसङ्गं त्यक्त्वा फलानि च ।\nकर्तव्यानीति मे पार्थ\nनिश्चितं मतमुत्तमम् ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "BG_C18_V06"
  },
  {
    "id": 16766007,
    "chapter_id": 6166,
    "verse_number": "18.7",
    "content_sanskrit": "नियतस्य तु संन्यासः कर्मणो नोपपद्यते ।\nमोहात्तस्य परित्यागस्तामसः परिकीर्तितः ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "BG_C18_V07"
  },
  {
    "id": 16766008,
    "chapter_id": 6166,
    "verse_number": "18.8",
    "content_sanskrit": "दुःखमित्येव यत्कर्म कायक्लेशभयात्त्यजेत् ।\nस कृत्वा राजसं त्यागं नैव त्यागफलं लभेत् ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "BG_C18_V08"
  },
  {
    "id": 16766009,
    "chapter_id": 6166,
    "verse_number": "18.9",
    "content_sanskrit": "कार्यमित्येव यत्कर्म\nनियतं क्रियतेऽर्जुन ।\nसङ्गं त्यक्त्वा फलं चैव\nस त्यागः सात्त्विको मतः ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "base_unit_id": "BG_C18_V09"
  },
  {
    "id": 16766010,
    "chapter_id": 6166,
    "verse_number": "18.10",
    "content_sanskrit": "न द्वेष्ट्यकुशलं कर्म\nकुशले नानुषज्जते ।\nत्यागी सत्त्वसमाविष्टो\nमेधावी च्छिन्नसंशयः ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "base_unit_id": "BG_C18_V10"
  },
  {
    "id": 16766011,
    "chapter_id": 6166,
    "verse_number": "18.11",
    "content_sanskrit": "न हि देहभृता शक्यं त्यक्तुं कर्माण्यशेषतः ।\nयस्तु कर्मफलत्यागी स त्यागीत्यभिधीयते ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "BG_C18_V11"
  },
  {
    "id": 16766012,
    "chapter_id": 6166,
    "verse_number": "18.12",
    "content_sanskrit": "अनिष्टमिष्टं मिश्रं च\nत्रिविधं कर्मणः फलम् ।\nभवत्यत्यागिनां प्रेत्य\nन तु संन्यासिनां क्वचित् ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "BG_C18_V12"
  },
  {
    "id": 16766013,
    "chapter_id": 6166,
    "verse_number": "18.13",
    "content_sanskrit": "पञ्चैतानि महाबाहो\nकारणानि निबोध मे ।\nसाङ्ख्ये कृतान्ते प्रोक्तानि\nसिद्धये सर्वकर्मणाम् ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "base_unit_id": "BG_C18_V13"
  },
  {
    "id": 16766014,
    "chapter_id": 6166,
    "verse_number": "18.14",
    "content_sanskrit": "अधिष्ठानं तथा कर्ता करणं च पृथग्विधम् ।\nविविधाश्च पृथक्चेष्टा दैवं चैवात्र पञ्चमम् ॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "base_unit_id": "BG_C18_V14"
  },
  {
    "id": 16766015,
    "chapter_id": 6166,
    "verse_number": "18.15",
    "content_sanskrit": "शरीरवाङ्मनोभिर्यत्कर्म प्रारभते नरः ।\nन्याय्यं वा विपरीतं वा पञ्चैते तस्य हेतवः ॥ १५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "base_unit_id": "BG_C18_V15"
  },
  {
    "id": 16766016,
    "chapter_id": 6166,
    "verse_number": "18.16",
    "content_sanskrit": "तत्रैवं सति कर्तारमात्मानं केवलं तु यः ।\nपश्यत्यकृतबुद्धित्वान्न स पश्यति दुर्मतिः ॥ १६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "base_unit_id": "BG_C18_V16"
  },
  {
    "id": 16766017,
    "chapter_id": 6166,
    "verse_number": "18.17",
    "content_sanskrit": "यस्य नाहङ्कृतो भावो बुद्धिर्यस्य न लिप्यते ।\nहत्वापि स इमांल्लोकान्न हन्ति न निबध्यते ॥ १७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "base_unit_id": "BG_C18_V17"
  },
  {
    "id": 16766018,
    "chapter_id": 6166,
    "verse_number": "18.18",
    "content_sanskrit": "ज्ञानं ज्ञेयं परिज्ञाता त्रिविधा कर्मचोदना ।\nकरणं कर्म कर्तेति त्रिविधः कर्मसङ्ग्रहः ॥ १८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "base_unit_id": "BG_C18_V18"
  },
  {
    "id": 16766019,
    "chapter_id": 6166,
    "verse_number": "18.19",
    "content_sanskrit": "ज्ञानं कर्म च कर्ता च\nत्रिधैव गुणभेदतः ।\nप्रोच्यते गुणसङ्ख्याने\nयथावच्छृणु तान्यपि ॥ १९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "base_unit_id": "BG_C18_V19"
  },
  {
    "id": 16766020,
    "chapter_id": 6166,
    "verse_number": "18.20",
    "content_sanskrit": "सर्वभूतेषु येनैकं\nभावमव्ययमीक्षते ।\nअविभक्तं विभक्तेषु\nतज्ज्ञानं विद्धि सात्त्विकम् ॥ २० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "base_unit_id": "BG_C18_V20"
  },
  {
    "id": 16766021,
    "chapter_id": 6166,
    "verse_number": "18.21",
    "content_sanskrit": "पृथक्त्वेन तु यज्ज्ञानं\nनानाभावान्पृथग्विधान् ।\nवेत्ति सर्वेषु भूतेषु\nतज्ज्ञानं विद्धि राजसम् ॥ २१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "base_unit_id": "BG_C18_V21"
  },
  {
    "id": 16766022,
    "chapter_id": 6166,
    "verse_number": "18.22",
    "content_sanskrit": "यत्तु कृत्स्नवदेकस्मिन्कार्ये सक्तमहैतुकम् ।\nअतत्त्वार्थवदल्पं च तत्तामसमुदाहृतम् ॥ २२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "base_unit_id": "BG_C18_V22"
  },
  {
    "id": 16766023,
    "chapter_id": 6166,
    "verse_number": "18.23",
    "content_sanskrit": "नियतं सङ्गरहितमरागद्वेषतःकृतम् ।\nअफलप्रेप्सुना कर्म यत्तत्सात्त्विकमुच्यते ॥ २३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "base_unit_id": "BG_C18_V23"
  },
  {
    "id": 16766024,
    "chapter_id": 6166,
    "verse_number": "18.24",
    "content_sanskrit": "यत्तु कामेप्सुना कर्म साहङ्कारेण वा पुनः ।\nक्रियते बहुलायासं तद्राजसमुदाहृतम् ॥ २४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "base_unit_id": "BG_C18_V24"
  },
  {
    "id": 16766025,
    "chapter_id": 6166,
    "verse_number": "18.25",
    "content_sanskrit": "अनुबन्धं क्षयं हिंसामनपेक्ष्य च पौरुषम् ।\nमोहादारभ्यते कर्म यत्तत्तामसमुच्यते ॥ २५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "base_unit_id": "BG_C18_V25"
  },
  {
    "id": 16766026,
    "chapter_id": 6166,
    "verse_number": "18.26",
    "content_sanskrit": "मुक्तसङ्गोऽनहंवादी\nधृत्युत्साहसमन्वितः ।\nसिद्ध्यसिद्ध्योर्निर्विकारः\nकर्ता सात्त्विक उच्यते ॥ २६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "base_unit_id": "BG_C18_V26"
  },
  {
    "id": 16766027,
    "chapter_id": 6166,
    "verse_number": "18.27",
    "content_sanskrit": "रागी कर्मफलप्रेप्सुर्लुब्धो हिंसात्मकोऽशुचिः ।\nहर्षशोकान्वितः कर्ता राजसः परिकीर्तितः ॥ २७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "base_unit_id": "BG_C18_V27"
  },
  {
    "id": 16766028,
    "chapter_id": 6166,
    "verse_number": "18.28",
    "content_sanskrit": "अयुक्तः प्राकृतः स्तब्धः\nशठो नैकृतिकोऽलसः ।\nविषादी दीर्घसूत्री च\nकर्ता तामस उच्यते ॥ २८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "base_unit_id": "BG_C18_V28"
  },
  {
    "id": 16766029,
    "chapter_id": 6166,
    "verse_number": "18.29",
    "content_sanskrit": "बुद्धेर्भेदं धृतेश्चैव गुणतस्त्रिविधं शृणु ।\nप्रोच्यमानमशेषेण पृथक्त्वेन धनञ्जय ॥ २९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "base_unit_id": "BG_C18_V29"
  },
  {
    "id": 16766030,
    "chapter_id": 6166,
    "verse_number": "18.30",
    "content_sanskrit": "प्रवृत्तिं च निवृत्तिं च\nकार्याकार्ये भयाभये ।\nबन्धं मोक्षं च या वेत्ति\nबुद्धिः सा पार्थ सात्त्विकी ॥ ३० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "base_unit_id": "BG_C18_V30"
  },
  {
    "id": 16766031,
    "chapter_id": 6166,
    "verse_number": "18.31",
    "content_sanskrit": "यया धर्ममधर्मं च\nकार्यं चाकार्यमेव च ।\nअयथावत्प्रजानाति\nबुद्धिः सा पार्थ राजसी ॥ ३१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "base_unit_id": "BG_C18_V31"
  },
  {
    "id": 16766032,
    "chapter_id": 6166,
    "verse_number": "18.32",
    "content_sanskrit": "अधर्मं धर्ममिति या\nमन्यते तमसावृता ।\nसर्वार्थान्विपरीतांश्च\nबुद्धिः सा पार्थ तामसी ॥ ३२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "base_unit_id": "BG_C18_V32"
  },
  {
    "id": 16766033,
    "chapter_id": 6166,
    "verse_number": "18.33",
    "content_sanskrit": "धृत्या यया धारयते\nमनःप्राणेन्द्रियक्रियाः ।\nयोगेनाव्यभिचारिण्या\nधृतिः सा पार्थ सात्त्विकी ॥ ३३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "base_unit_id": "BG_C18_V33"
  },
  {
    "id": 16766034,
    "chapter_id": 6166,
    "verse_number": "18.34",
    "content_sanskrit": "यया तु धर्मकामार्थान्धृत्या धारयतेऽर्जुन ।\nप्रसङ्गेन फलाकाङ्क्षी धृतिः सा पार्थ राजसी ॥ ३४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "base_unit_id": "BG_C18_V34"
  },
  {
    "id": 16766035,
    "chapter_id": 6166,
    "verse_number": "18.35",
    "content_sanskrit": "यया स्वप्नं भयं शोकं\nविषादं मदमेव च ।\nन विमुञ्चति दुर्मेधा\nधृतिः सा तामसी मता ॥ ३५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "base_unit_id": "BG_C18_V35"
  },
  {
    "id": 16766036,
    "chapter_id": 6166,
    "verse_number": "18.36",
    "content_sanskrit": "सुखं त्विदानीं त्रिविधं\nशृणु मे भरतर्षभ ।\nअभ्यासाद्रमते यत्र\nदुःखान्तं च निगच्छति ॥ ३६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "base_unit_id": "BG_C18_V36"
  },
  {
    "id": 16766037,
    "chapter_id": 6166,
    "verse_number": "18.37",
    "content_sanskrit": "यत्तदग्रे विषमिव परिणामेऽमृतोपमम् ।\nतत्सुखं सात्त्विकं प्रोक्तमात्मबुद्धिप्रसादजम् ॥ ३७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "base_unit_id": "BG_C18_V37"
  },
  {
    "id": 16766038,
    "chapter_id": 6166,
    "verse_number": "18.38",
    "content_sanskrit": "विषयेन्द्रियसंयोगाद्यत्तदग्रेऽमृतोपमम् ।\nपरिणामे विषमिव तत्सुखं राजसं स्मृतम् ॥ ३८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "base_unit_id": "BG_C18_V38"
  },
  {
    "id": 16766039,
    "chapter_id": 6166,
    "verse_number": "18.39",
    "content_sanskrit": "यदग्रे चानुबन्धे च सुखं मोहनमात्मनः ।\nनिद्रालस्यप्रमादोत्थं तत्तामसमुदाहृतम् ॥ ३९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "base_unit_id": "BG_C18_V39"
  },
  {
    "id": 16766040,
    "chapter_id": 6166,
    "verse_number": "18.40",
    "content_sanskrit": "न तदस्ति पृथिव्यां वा दिवि देवेषु वा पुनः ।\nसत्त्वं प्रकृतिजैर्मुक्तं यदेभिः स्यात्त्रिभिर्गुणैः ॥ ४० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "base_unit_id": "BG_C18_V40"
  },
  {
    "id": 16766041,
    "chapter_id": 6166,
    "verse_number": "18.41",
    "content_sanskrit": "ब्राह्मणक्षत्रियविशां शूद्राणां च परन्तप ।\nकर्माणि प्रविभक्तानि स्वभावप्रभवैर्गुणैः ॥ ४१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "base_unit_id": "BG_C18_V41"
  },
  {
    "id": 16766042,
    "chapter_id": 6166,
    "verse_number": "18.42",
    "content_sanskrit": "शमो दमस्तपः शौचं\nक्षान्तिरार्जवमेव च ।\nज्ञानं विज्ञानमास्तिक्यं\nब्रह्मकर्म स्वभावजम् ॥ ४२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "base_unit_id": "BG_C18_V42"
  },
  {
    "id": 16766043,
    "chapter_id": 6166,
    "verse_number": "18.43",
    "content_sanskrit": "शौर्यं तेजो धृतिर्दाक्ष्यं युद्धे चाप्यपलायनम् ।\nदानमीश्वरभावश्च क्षात्रं कर्म स्वभावजम् ॥ ४३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "base_unit_id": "BG_C18_V43"
  },
  {
    "id": 16766044,
    "chapter_id": 6166,
    "verse_number": "18.44",
    "content_sanskrit": "कृषिगौरक्ष्यवाणिज्यं वैश्यकर्म स्वभावजम् ।\nपरिचर्यात्मकं कर्म शूद्रस्यापि स्वभावजम् ॥ ४४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "base_unit_id": "BG_C18_V44"
  },
  {
    "id": 16766045,
    "chapter_id": 6166,
    "verse_number": "18.45",
    "content_sanskrit": "स्वे स्वे कर्मण्यभिरतः\nसंसिद्धिं लभते नरः ।\nस्वकर्मनिरतः सिद्धिं\nयथा विन्दति तच्छृणु ॥ ४५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "base_unit_id": "BG_C18_V45"
  },
  {
    "id": 16766046,
    "chapter_id": 6166,
    "verse_number": "18.46",
    "content_sanskrit": "यतः प्रवृत्तिर्भूतानां\nयेन सर्वमिदं ततम् ।\nस्वकर्मणा तमभ्यर्च्य\nसिद्धिं विन्दति मानवः ॥ ४६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "base_unit_id": "BG_C18_V46"
  },
  {
    "id": 16766047,
    "chapter_id": 6166,
    "verse_number": "18.47",
    "content_sanskrit": "श्रेयान्स्वधर्मो विगुणः\nपरधर्मात्स्वनुष्ठितात् ।\nस्वभावनियतं कर्म\nकुर्वन्नाप्नोति किल्बिषम् ॥ ४७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "base_unit_id": "BG_C18_V47"
  },
  {
    "id": 16766048,
    "chapter_id": 6166,
    "verse_number": "18.48",
    "content_sanskrit": "सहजं कर्म कौन्तेय\nसदोषमपि न त्यजेत् ।\nसर्वारम्भा हि दोषेण\nधूमेनाग्निरिवावृताः ॥ ४८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "base_unit_id": "BG_C18_V48"
  },
  {
    "id": 16766049,
    "chapter_id": 6166,
    "verse_number": "18.49",
    "content_sanskrit": "असक्तबुद्धिः सर्वत्र\nजितात्मा विगतस्पृहः ।\nनैष्कर्म्यसिद्धिं परमां\nसंन्यासेनाधिगच्छति ॥ ४९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "base_unit_id": "BG_C18_V49"
  },
  {
    "id": 16766050,
    "chapter_id": 6166,
    "verse_number": "18.50",
    "content_sanskrit": "सिद्धिं प्राप्तो यथा ब्रह्म तथाप्नोति निबोध मे ।\nसमासेनैव कौन्तेय निष्ठा ज्ञानस्य या परा ॥ ५० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "base_unit_id": "BG_C18_V50"
  },
  {
    "id": 16766051,
    "chapter_id": 6166,
    "verse_number": "18.51",
    "content_sanskrit": "बुद्ध्या विशुद्धया युक्तो\nधृत्यात्मानं नियम्य च ।\nशब्दादीन्विषयांस्त्यक्त्वा\nरागद्वेषौ व्युदस्य च ॥ ५१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "base_unit_id": "BG_C18_V51"
  },
  {
    "id": 16766052,
    "chapter_id": 6166,
    "verse_number": "18.52",
    "content_sanskrit": "विविक्तसेवी लघ्वाशी\nयतवाक्कायमानसः ।\nध्यानयोगपरो नित्यं\nवैराग्यं समुपाश्रितः ॥ ५२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "base_unit_id": "BG_C18_V52"
  },
  {
    "id": 16766053,
    "chapter_id": 6166,
    "verse_number": "18.53",
    "content_sanskrit": "अहङ्कारं बलं दर्पं\nकामं क्रोधं परिग्रहम् ।\nविमुच्य निर्ममः शान्तो\nब्रह्मभूयाय कल्पते ॥ ५३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "base_unit_id": "BG_C18_V53"
  },
  {
    "id": 16766054,
    "chapter_id": 6166,
    "verse_number": "18.54",
    "content_sanskrit": "ब्रह्मभूतः प्रसन्नात्मा\nन शोचति न काङ्क्षति ।\nसमः सर्वेषु भूतेषु\nमद्भक्तिं लभते पराम् ॥ ५४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "base_unit_id": "BG_C18_V54"
  },
  {
    "id": 16766055,
    "chapter_id": 6166,
    "verse_number": "18.55",
    "content_sanskrit": "भक्त्या मामभिजानाति\nयावान्यश्चास्मि तत्त्वतः ।\nततो मां तत्त्वतो ज्ञात्वा\nविशते तदनन्तरम् ॥ ५५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "base_unit_id": "BG_C18_V55"
  },
  {
    "id": 16766056,
    "chapter_id": 6166,
    "verse_number": "18.56",
    "content_sanskrit": "सर्वकर्माण्यपि सदा कुर्वाणो मद्व्यपाश्रयः ।\nमत्प्रसादादवाप्नोति शाश्वतं पदमव्ययम् ॥ ५६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "base_unit_id": "BG_C18_V56"
  },
  {
    "id": 16766057,
    "chapter_id": 6166,
    "verse_number": "18.57",
    "content_sanskrit": "चेतसा सर्वकर्माणि मयि संन्यस्य मत्परः ।\nबुद्धियोगमपाश्रित्य मच्चित्तः सततं भव ॥ ५७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "base_unit_id": "BG_C18_V57"
  },
  {
    "id": 16766058,
    "chapter_id": 6166,
    "verse_number": "18.58",
    "content_sanskrit": "मच्चित्तः सर्वदुर्गाणि मत्प्रसादात्तरिष्यसि ।\nअथ चेत्त्वमहङ्कारान्न श्रोष्यसि विनङ्क्ष्यसि ॥ ५८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "base_unit_id": "BG_C18_V58"
  },
  {
    "id": 16766059,
    "chapter_id": 6166,
    "verse_number": "18.59",
    "content_sanskrit": "यद्यहङ्कारमाश्रित्य\nन योत्स्य इति मन्यसे ।\nमिथ्यैष व्यवसायस्ते\nप्रकृतिस्त्वां नियोक्ष्यति ॥ ५९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "base_unit_id": "BG_C18_V59"
  },
  {
    "id": 16766060,
    "chapter_id": 6166,
    "verse_number": "18.60",
    "content_sanskrit": "स्वभावजेन कौन्तेय निबद्धः स्वेन कर्मणा ।\nकर्तुं नेच्छसि यन्मोहात्करिष्यस्यवशोऽपि तत् ॥ ६० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "base_unit_id": "BG_C18_V60"
  },
  {
    "id": 16766061,
    "chapter_id": 6166,
    "verse_number": "18.61",
    "content_sanskrit": "ईश्वरः सर्वभूतानां हृद्देशेऽर्जुन तिष्ठति ।\nभ्रामयन्सर्वभूतानि यन्त्रारूढानि मायया ॥ ६१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "base_unit_id": "BG_C18_V61"
  },
  {
    "id": 16766062,
    "chapter_id": 6166,
    "verse_number": "18.62",
    "content_sanskrit": "तमेव शरणं गच्छ\nसर्वभावेन भारत ।\nतत्प्रसादात्परां शान्तिं\nस्थानं प्राप्स्यसि शाश्वतम् ॥ ६२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "base_unit_id": "BG_C18_V62"
  },
  {
    "id": 16766063,
    "chapter_id": 6166,
    "verse_number": "18.63",
    "content_sanskrit": "इति ते ज्ञानमाख्यातं गुह्याद्गुह्यतरं मया ।\nविमृश्यैतदशेषेण यथेच्छसि तथा कुरु ॥ ६३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "base_unit_id": "BG_C18_V63"
  },
  {
    "id": 16766064,
    "chapter_id": 6166,
    "verse_number": "18.64",
    "content_sanskrit": "सर्वगुह्यतमं भूयः\nशृणु मे परमं वचः ।\nइष्टोऽसि मे दृढमिति\nततो वक्ष्यामि ते हितम् ॥ ६४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "base_unit_id": "BG_C18_V64"
  },
  {
    "id": 16766065,
    "chapter_id": 6166,
    "verse_number": "18.65",
    "content_sanskrit": "मन्मना भव मद्भक्तो\nमद्याजी मां नमस्कुरु ।\nमामेवैष्यसि सत्यं ते\nप्रतिजाने प्रियोऽसि मे ॥ ६५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "base_unit_id": "BG_C18_V65"
  },
  {
    "id": 16766066,
    "chapter_id": 6166,
    "verse_number": "18.66",
    "content_sanskrit": "सर्वधर्मान्परित्यज्य\nमामेकं शरणं व्रज ।\nअहं त्वा सर्वपापेभ्यो\nमोक्षयिष्यामि मा शुचः ॥ ६६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "base_unit_id": "BG_C18_V66"
  },
  {
    "id": 16766067,
    "chapter_id": 6166,
    "verse_number": "18.67",
    "content_sanskrit": "इदं ते नातपस्काय\nनाभक्ताय कदाचन ।\nन चाशुश्रूषवे वाच्यं\nन च मां योऽभ्यसूयति ॥ ६७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "base_unit_id": "BG_C18_V67"
  },
  {
    "id": 16766068,
    "chapter_id": 6166,
    "verse_number": "18.68",
    "content_sanskrit": "य इमं परमं गुह्यं\nमद्भक्तेष्वभिधास्यति ।\nभक्तिं मयि परां कृत्वा\nमामेवैष्यत्यसंशयः ॥ ६८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "base_unit_id": "BG_C18_V68"
  },
  {
    "id": 16766069,
    "chapter_id": 6166,
    "verse_number": "18.69",
    "content_sanskrit": "न च तस्मान्मनुष्येषु कश्चिन्मे प्रियकृत्तमः ।\nभविता न च मे तस्मादन्यः प्रियतरो भुवि ॥ ६९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "base_unit_id": "BG_C18_V69"
  },
  {
    "id": 16766070,
    "chapter_id": 6166,
    "verse_number": "18.70",
