[{"id": 2037321, "chapter_id": 1805, "verse_number": "५-५०-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2037322, "chapter_id": 1805, "verse_number": "५-५०-१", "content_sanskrit": "किमसौ पाण्डवो राजा धर्मपुत्रोऽभ्यभाषत।\nश्रुत्वेह बहुलाः सेनाः प्रीत्यर्थं नः समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2037323, "chapter_id": 1805, "verse_number": "५-५०-२", "content_sanskrit": "किमसौ चेष्टते सूत योत्स्यमानो युधिष्ठिरः।\nके वास्य भ्रातृपुत्राणां पश्यन्त्याज्ञेप्सवो सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2037324, "chapter_id": 1805, "verse_number": "५-५०-३", "content_sanskrit": "के स्विदेनं वारयन्ति युद्धाच्छाम्येति वा पुनः।\nनिकृत्या कोपितं मन्दैर्धर्मज्ञं धर्मचारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2037325, "chapter_id": 1805, "verse_number": "५-५०-४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2037326, "chapter_id": 1805, "verse_number": "५-५०-४", "content_sanskrit": "राज्ञो मुखमुदीक्षन्ते पाञ्चालाः पाण्डवैः सह।\nयुधिष्ठिरस्य भद्रं ते स सर्वाननुशास्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2037327, "chapter_id": 1805, "verse_number": "५-५०-५", "content_sanskrit": "पृथग्भूताः पाण्डवानां पाञ्चालानां रथव्रजाः ।\nआयान्तमभिनन्दन्ति कुन्तीपुत्रं युधिष्ठिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2037328, "chapter_id": 1805, "verse_number": "५-५०-६", "content_sanskrit": "नभः सूर्यमिवोद्यन्तं कौन्तेयं दीप्ततेजसम्।\nपाञ्चालाः प्रतिनन्दन्ति तेजोराशिमिवोदितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2037329, "chapter_id": 1805, "verse_number": "५-५०-७", "content_sanskrit": "आगोपालाविपालाश्च नन्दमाना युधिष्ठिरम् ।\nपाञ्चालाः केकया मत्स्याः प्रतिनन्दति पाण्डवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2037330, "chapter_id": 1805, "verse_number": "५-५०-८", "content_sanskrit": "ब्राह्मण्यो राजपुत्र्यश्च विशां दुहितरश्च याः।\nक्रीडन्त्योभिसमायान्ति पार्थं सन्नद्धमीक्षितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2037331, "chapter_id": 1805, "verse_number": "५-५०-९x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2037332, "chapter_id": 1805, "verse_number": "५-५०-९", "content_sanskrit": "सञ्जयाचक्ष्व येनास्मान्पाडवा अभ्ययुञ्जत।\nधृष्टद्युम्नस्य सैन्येन सोमकानां बलेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2037333, "chapter_id": 1805, "verse_number": "५-५०-१०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2037334, "chapter_id": 1805, "verse_number": "५-५०-१०", "content_sanskrit": "गवल्गणिस्तु तत्पुष्टः सभायां कुरुसंसदि।\nनिःश्वस्य सुभृशं दीर्घं मुहुः सञ्चिन्तयन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2037335, "chapter_id": 1805, "verse_number": "५-५०-११", "content_sanskrit": "तत्रानिमित्ततो वैवात्सुतं कश्मलमाविशत्।\nतदाचचक्षे विदुरः सभायां राजसंसदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2037336, "chapter_id": 1805, "verse_number": "५-५०-१२", "content_sanskrit": "सञ्जयोऽयं महाराज मूर्छितः पतितो भुवि।\nवाचं न सृजते कांचिद्धीनप्रज्ञोऽल्पचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2037337, "chapter_id": 1805, "verse_number": "५-५०-१३x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2037338, "chapter_id": 1805, "verse_number": "५-५०-१३", "content_sanskrit": "अपश्यत्सञ्जयो नूनं कुन्तीपुत्रान्महारथान्।\nतैरस्य पुरुषव्याघ्रैर्भृशमुद्वेजितं मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2037339, "chapter_id": 1805, "verse_number": "५-५०-१४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2037340, "chapter_id": 1805, "verse_number": "५-५०-१४", "content_sanskrit": "सञ्जयश्चेतनां लब्ध्वा प्रत्याश्वस्येदभब्रवीत्।\nधृतराष्ट्रं महाराज सभायां कुरुसंसदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2037341, "chapter_id": 1805, "verse_number": "५-५०-१५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2037342, "chapter_id": 1805, "verse_number": "५-५०-१५", "content_sanskrit": "दृष्टवानस्मि राजेन्द्र कुन्तीपुत्रान्महारथान्।\nमत्स्यराजगृहावासनिरोधेनावकर्शितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2037343, "chapter_id": 1805, "verse_number": "५-५०-१६", "content_sanskrit": "श्रृणु र्यैर्हि महाराज पाण्डवा अभ्ययुञ्जत।\nधृष्टद्युम्नेन वीरेण युद्धे वस्तेऽभ्ययुञ्जत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2037344, "chapter_id": 1805, "verse_number": "५-५०-१७", "content_sanskrit": "यो नैव रोपान्न भयान्न लोभान्नार्थकारणात्।\nन हेतुवादाद्धर्मात्मा सत्यं जाह्यात्कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2037345, "chapter_id": 1805, "verse_number": "५-५०-१८", "content_sanskrit": "यः प्रमाणं महाराज धर्मे धर्मभृतां वरः।\nअजातशत्रुणा तेन पाण्डवा अभ्ययुञ्जत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2037346, "chapter_id": 1805, "verse_number": "५-५०-१९", "content_sanskrit": "यस्य बाहुबले तुल्यः पृथिव्यां नास्ति कश्चन।\nयो वै सर्वान्महीपालान्वशे चक्रे धनुर्धरः ।\nयः काशीनङ्गमगधान्कलिङ्गांश्च युधाजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2037347, "chapter_id": 1805, "verse_number": "५-५०-२०", "content_sanskrit": "तेन वो भीमसेनेन पाण्डवा अभ्ययुञ्जत।\nयस्य वीर्येण सहसा चत्वारो भुवि पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2037348, "chapter_id": 1805, "verse_number": "५-५०-२१", "content_sanskrit": "निःसृत्य जतुगेहाद्वै हिडिम्बात्पुरुषादकात्।\nयश्चैपामभवद्द्वीपः कुन्तीपुत्रो वृकोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2037349, "chapter_id": 1805, "verse_number": "५-५०-२२", "content_sanskrit": "याज्ञसेनीमथो यत्र सिन्धुराजोपकृष्टवान्।\nतत्रैषामभवद्द्वीपः कुन्तीपुत्रो वृकोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2037350, "chapter_id": 1805, "verse_number": "५-५०-२३", "content_sanskrit": "यश्च तान्सङ्गतान्सर्वान्पाण्डवान्वारणावते।\nदह्यतो मोचयामास तेन वस्तेऽभ्ययुञ्जत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2037351, "chapter_id": 1805, "verse_number": "५-५०-२४", "content_sanskrit": "कृष्णायां चरता प्रीतिं येन क्रोधवशा हताः ।\nप्रविश्य विषयं घोरं पर्वतं गन्धमादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2037352, "chapter_id": 1805, "verse_number": "५-५०-२५", "content_sanskrit": "यस्य नागायुतैर्वीर्यं भुजयोः सारमर्पितम् ।\nतेन वो भीमसेनेन पाण्डवा अभ्ययुञ्जत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2037353, "chapter_id": 1805, "verse_number": "५-५०-२६", "content_sanskrit": "कृष्णद्वितीयो विक्रम्य तुष्ट्यर्थं जातवेदसः।\nअजयद्यः पुरा वीरो युध्यमानं पुरन्दरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2037354, "chapter_id": 1805, "verse_number": "५-५०-२७", "content_sanskrit": "यः स साक्षान्महादेवं गिरिशं शृलपाणिनम् ।\nतोपयामास युद्धेन देवदेवमुपामपिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2037355, "chapter_id": 1805, "verse_number": "५-५०-२८", "content_sanskrit": "यश्च सर्वान्वशे चक्रे लोकपालान्धनुर्धरः।\nतेन वो विजयेनाजौ पाण्डवा अभ्ययुञ्जत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2037356, "chapter_id": 1805, "verse_number": "५-५०-२९", "content_sanskrit": "यः प्रतीचीं दिशं चक्रे वशे म्लेच्छगणायुताम्।\nस तत्र नकुलो योद्धा चित्रयोधी व्यवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2037357, "chapter_id": 1805, "verse_number": "५-५०-३०", "content_sanskrit": "तेन वो दर्शनीयेन वीरेणातिधनुर्भृता ।\nमाद्रीपुत्रेण कौरव्य पाण्डवा अभ्ययुञ्जत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2037358, "chapter_id": 1805, "verse_number": "५-५०-३१", "content_sanskrit": "यः काशीनङ्गमगधान्कलिङ्गांश्च युधाजयत्।\nतेन वः सहदेवेन पाण्डवा अभ्ययुञ्जत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2037359, "chapter_id": 1805, "verse_number": "५-५०-३२", "content_sanskrit": "यस्य वीर्येण सदृशाश्चत्वारो भुवि मानवाः ।\nअश्वत्थामा धृष्टकेतू रुक्मी प्रद्युम्न एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2037360, "chapter_id": 1805, "verse_number": "५-५०-३३", "content_sanskrit": "तेन वः सहदेवेन युद्धं राजन्महात्ययमअ।\nयवीयसा नृवीरेण माद्रीनन्दिकरेण च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2037361, "chapter_id": 1805, "verse_number": "५-५०-३४", "content_sanskrit": "तपश्चचार या घोरं काशिकन्या पुरा सती।\nभीष्मस्य वधमिच्छन्ती प्रेत्यापि भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2037362, "chapter_id": 1805, "verse_number": "५-५०-३५", "content_sanskrit": "पाञ्चालस्य सुता जज्ञे दैवाच्च स पुनः पुमान् ।\nस्त्रीपुंसीः पुरुषव्याघ्र यः स वेद गुणागुणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2037363, "chapter_id": 1805, "verse_number": "५-५०-३६", "content_sanskrit": ".. कलिङ्गान्समापेदे पाञ्चाल्यो युद्धदुर्मदः ।\nशिखण्डिना वः कुरवः कृतास्त्रेणाभ्ययुञ्जत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2037364, "chapter_id": 1805, "verse_number": "५-५०-३७", "content_sanskrit": "यं यक्षः पुरुषं चक्रे भीष्मस्य निधनेच्छया।\nमहेष्वासेन रौद्रेण पाण्डवा अभ्ययुञ्जत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2037365, "chapter_id": 1805, "verse_number": "५-५०-३८", "content_sanskrit": "महेष्वासा राजपुत्रा भ्रातरः पञ्च केकयाः।\nआमुक्तवचाः शूरास्तैश्च वस्तेऽभ्ययुञ्जत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2037366, "chapter_id": 1805, "verse_number": "५-५०-३९", "content_sanskrit": "यो दीर्घबाहुः क्षिप्रास्त्रो धृतिमान्सत्यविक्रमः ।\nतेन वो वृष्णिवीरेण युयुधानेन सङ्गरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2037367, "chapter_id": 1805, "verse_number": "५-५०-४०", "content_sanskrit": "य आसीच्छरणं काले पाण्डवानां महात्मनाम् ।\nरणे तेन विराटेन भविता वः समागमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2037368, "chapter_id": 1805, "verse_number": "५-५०-४१", "content_sanskrit": "यः स काशिपती राजा वाराणस्यां महारथः ।\nस तेषामभवद्योद्धा तेन वस्तेऽभ्ययुञ्जत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2037369, "chapter_id": 1805, "verse_number": "५-५०-४२", "content_sanskrit": "शिशुभिर्दुर्जयैः सङ्ख्ये द्रौपदेयैर्महात्मभिः ।\nआशीविषसमस्पर्शैः पाण्डवा अभ्ययञ्जत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2037370, "chapter_id": 1805, "verse_number": "५-५०-४३", "content_sanskrit": "यः कृष्णासदृशो वीर्ये युधिष्ठिरसमो दमे।\nतेनाभिमन्युना सङ्ख्ये पाण्डवा अभ्ययुञ्जत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2037371, "chapter_id": 1805, "verse_number": "५-५०-४४", "content_sanskrit": "यश्चैवाप्रतिमो वीर्ये धृष्टकेतुर्महायशाः ।\nदुःसहः समरे क्रुद्धः शैशुपालिर्महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2037372, "chapter_id": 1805, "verse_number": "५-५०-४५", "content_sanskrit": "तेन वश्चेदिराजेन पाण्डवा अभ्ययुञ्जत ।\nअक्षौहिण्या परिवृतः पाण्डवान्योभिसंश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2037373, "chapter_id": 1805, "verse_number": "५-५०-४६", "content_sanskrit": "यः संश्रयः पाण्डवानां देवानामिव वासवः।\nतेन वो वासुदेवेन पाण्डवा अभ्ययुञ्जत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2037374, "chapter_id": 1805, "verse_number": "५-५०-४७", "content_sanskrit": "यथा चेदिपतेर्भ्राता शरभो भरतर्षभ।\nकरकर्षेण सहितस्ताभ्यां वस्तेऽभ्ययुञ्जत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2037375, "chapter_id": 1805, "verse_number": "५-५०-४८", "content_sanskrit": "तारासन्धिः सहदेवो जयत्सेनश्च तावुभौ ।\nयुद्धे प्रतिरथे वीरौ पाण्डवार्थे व्यवस्थितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2037376, "chapter_id": 1805, "verse_number": "५-५०-४९", "content_sanskrit": "द्रुपदश्च महातेजा बलेन महता वृतः।\nत्यक्तात्मा पाण्डवार्थाय सोत्स्यमानो व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2037377, "chapter_id": 1805, "verse_number": "५-५०-५०", "content_sanskrit": "एते चान्ये च बहवः प्राच्योदीच्या महीक्षितः।\nशतशो यानुपाश्रिता धर्मराजो व्यवस्थितः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2037378, "chapter_id": 1805, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि यानसन्धिपर्वणि पञ्चशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]