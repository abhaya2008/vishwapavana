[{"id": 2076660, "chapter_id": 2626, "verse_number": "१२-१३१-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2076661, "chapter_id": 2626, "verse_number": "१२-१३१-१", "content_sanskrit": "क्षीणस्य दीर्घसूत्रस्य सानुक्रोशस्य बन्धुषु।\nपरिशङ्कितमुख्यस्य दुष्टमन्त्रस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2076662, "chapter_id": 2626, "verse_number": "१२-१३१-२", "content_sanskrit": "विरक्तराज्यपौरस्य निर्द्रव्यनिचयस्य च।\nअसंभावितमित्रस्य भिन्नामात्यस्य सर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2076663, "chapter_id": 2626, "verse_number": "१२-१३१-३", "content_sanskrit": "परचक्राभियातस्य दुर्बलस्य बलीयसा।\nआपन्नचेतसो ब्रूहि किं कार्यमवशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2076664, "chapter_id": 2626, "verse_number": "१२-१३१-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2076665, "chapter_id": 2626, "verse_number": "१२-१३१-४", "content_sanskrit": "बाह्यश्चेद्विजिगीषुः स्याद्धर्मार्थकुशलः शुचिः।\nजवेन सन्धिं कुर्वीत पूर्वं पूर्वं विमोक्षयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2076666, "chapter_id": 2626, "verse_number": "१२-१३१-५", "content_sanskrit": "[योऽधर्मविजिगीषुः स्याद्बलवान्पापनिश्चयः।]\nआत्मनः सन्निरोधेन सन्धिं तेनापि रोचयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2076667, "chapter_id": 2626, "verse_number": "१२-१३१-६", "content_sanskrit": "अपास्य राजधानीं वा तरेदन्येन वाऽऽपदम्।\nतद्भावभावो द्रव्याणि जीवन्पुनरुपार्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2076668, "chapter_id": 2626, "verse_number": "१२-१३१-७", "content_sanskrit": "यास्तु कोशबलत्यागाच्छक्यास्तरितुमापदः।\nकस्तत्राधिकमात्मानं संत्यजेदर्थधर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2076669, "chapter_id": 2626, "verse_number": "१२-१३१-८", "content_sanskrit": "अपराधाज्जुगुप्सेत का सपत्नधने दया।\nन त्वेवात्मा प्रदातव्यः शक्ये सति कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2076670, "chapter_id": 2626, "verse_number": "१२-१३१-९x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2076671, "chapter_id": 2626, "verse_number": "१२-१३१-९", "content_sanskrit": "आभ्यन्तरे च कुपिते बाह्ये चोपनिपीडिते।\nक्षीणे कोशे श्रुते मन्त्रे किं कार्यमवशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2076672, "chapter_id": 2626, "verse_number": "१२-१३१-१०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2076673, "chapter_id": 2626, "verse_number": "१२-१३१-१०", "content_sanskrit": "क्षिप्रं वा सन्धिकामः स्यात्क्षिप्रं वा तीक्ष्णविक्रम।\nयदाऽपनयनं क्षिप्रमेतद्वै सांपरायिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2076674, "chapter_id": 2626, "verse_number": "१२-१३१-११", "content_sanskrit": "अनुरक्तेन पुष्टेन हृष्टेन जगतीपतिः।\nअल्पेनापि स्वसैन्येन भूमिं जयति भूमिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2076675, "chapter_id": 2626, "verse_number": "१२-१३१-१२", "content_sanskrit": "हतो वा दिवमारोहेद्धत्वा च सुखमावहेत्।\nयुद्धे हि संत्यजन्प्राणाञ्शक्रस्यैति सलोकताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2076676, "chapter_id": 2626, "verse_number": "१२-१३१-१३", "content_sanskrit": "सर्वलोकागसं कृत्वा मृदुत्वं गन्तुमेव च।\nविश्वासाद्विनयं कुर्यात्संजह्याद्वाऽप्युपानहौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2076677, "chapter_id": 2626, "verse_number": "१२-१३१-१४", "content_sanskrit": "अपचिक्रमिषुः क्षिप्रं सेनां स्वां परिसान्त्वयन्।\nविलङ्घयित्वा सत्रेण ततः स्वयमुपक्रमेत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2076678, "chapter_id": 2626, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि एकत्रिंशदधिकशततमोऽध्यायः॥ १३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]