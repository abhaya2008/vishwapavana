[{"id": 2010851, "chapter_id": 1220, "verse_number": "१-२२१-०x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2010852, "chapter_id": 1220, "verse_number": "१-२२१-१", "content_sanskrit": "दुर्योधन तव प्रज्ञा न सम्यगिति मे मतिः।\nन ह्युपायेन ते शक्याः पाण्डवाः कुरुवर्धन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2010853, "chapter_id": 1220, "verse_number": "१-२२१-२", "content_sanskrit": "पूर्वमेव हि ते सूक्ष्मैरुपायैर्यतितास्त्वया।\nनिग्रहीतुं तदा वीर न चैव शकितास्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2010854, "chapter_id": 1220, "verse_number": "१-२२१-३", "content_sanskrit": "इहैव वर्तमानास्ते समीपे तव पार्थिव।\nअजातपक्षाः शिशवः शकिता नैव बाधितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2010855, "chapter_id": 1220, "verse_number": "१-२२१-४", "content_sanskrit": "जातपक्षा विदेशस्था विवृद्धाः सर्वशोऽद्य ते।\nनोपायसाध्याः कौन्तेया ममैषा मतिरच्युता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2010856, "chapter_id": 1220, "verse_number": "१-२२१-५", "content_sanskrit": "न च ते व्यसनैर्योक्तुं शक्या दिष्टकृतेन च।\nशकिताश्चेप्सवश्चैव पितृपैतामहं पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2010857, "chapter_id": 1220, "verse_number": "१-२२१-६", "content_sanskrit": "परस्परेण भेदश्च नाधातुं तेषु शक्यते।\nएकस्यां ये रताः पत्न्यां न भिद्यन्ते परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2010858, "chapter_id": 1220, "verse_number": "१-२२१-७", "content_sanskrit": "न चापि कृष्णा शक्येत तेभ्यो भेदयितुं परैः।\nपरिद्यूनान्वृतवती किमुताद्य मृजावतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2010859, "chapter_id": 1220, "verse_number": "१-२२१-८", "content_sanskrit": "ईप्सितश्च गुणः स्त्रीणामेकस्या बहुभर्तृता।\nतं च प्राप्तवती कृष्णा न सा भेदयितुं क्षमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2010860, "chapter_id": 1220, "verse_number": "१-२२१-९", "content_sanskrit": "आर्यव्रतश्च पाञ्चाल्यो न स राजा धनप्रियः।\nन संत्यक्ष्यति कौन्तेयान्राज्यदानैरपि ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2010861, "chapter_id": 1220, "verse_number": "१-२२१-१०", "content_sanskrit": "तथाऽस्म पुत्रो गुणवाननुरक्तश्च पाण्डवान्।\nतस्मान्नोपायसाध्यांस्तानहं मन्ये कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2010862, "chapter_id": 1220, "verse_number": "१-२२१-११", "content_sanskrit": "इदं त्वद्य क्षमं कर्तुमस्माकं पुरुषर्षभ।\nयावन्न कृतमूलास्ते पाण्डवेया विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2010863, "chapter_id": 1220, "verse_number": "१-२२१-१२", "content_sanskrit": "तावत्प्रहरणीयास्ते तत्तुभ्यं तात रोचताम्।\nअस्मत्पक्षो महान्यावद्यावत्पाञ्चालको लघुः।\nतावत्प्रहरणं तेषां क्रियतां मा विचारय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2010864, "chapter_id": 1220, "verse_number": "१-२२१-१३", "content_sanskrit": "वाहनानि प्रभूतानि मित्राणि च कुलानि च।\nयावन्न तेषां गान्धारे तावद्विक्रम पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2010865, "chapter_id": 1220, "verse_number": "१-२२१-१४", "content_sanskrit": "यावच्च राजा पाञ्चाल्यो नोद्यमे कुरुते मनः।\nसह पुत्रैर्महावीर्यैस्तावद्विक्रम पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2010866, "chapter_id": 1220, "verse_number": "१-२२१-१५", "content_sanskrit": "यावन्नायाति वार्ष्णेयः कर्षन्यादववाहिनीम्।\nराज्यार्थे पाण्डवेयानां पाञ्चाल्यसदनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2010867, "chapter_id": 1220, "verse_number": "१-२२१-१६", "content_sanskrit": "वसूनि विविधान्भोगान्राज्यमेव च केवलम्।\nनात्याज्यमस्ति कृष्णस्य पाण्डवार्थे कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2010868, "chapter_id": 1220, "verse_number": "१-२२१-१७", "content_sanskrit": "विक्रमेण मही प्राप्ता भरतेन महात्मना।\nविक्रमेण च लोकांस्त्रीञ्जितवान्पाकशासनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2010869, "chapter_id": 1220, "verse_number": "१-२२१-१८", "content_sanskrit": "विक्रमं च प्रशंसन्ति क्षत्रियस्य विशांपते।\nस्वको हि धर्मः शूराणां विक्रमः पार्थिवर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2010870, "chapter_id": 1220, "verse_number": "१-२२१-१९", "content_sanskrit": "ते बलेन वयं राजन्महता चतुरङ्गिणा।\nप्रमथ्य द्रुपदं शीघ्रमानयामेह पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2010871, "chapter_id": 1220, "verse_number": "१-२२१-२०", "content_sanskrit": "न हि साम्ना न दानेन न भदेन च पाण्डवाः।\nशक्याः साधयितुं तस्माद्विक्रमेणैव ताञ्जहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2010872, "chapter_id": 1220, "verse_number": "१-२२१-२१", "content_sanskrit": "तान्विक्रमेण जित्वेमामखिलां भुङ्क्ष्व मेदिनीम्।\nअतो नान्यं प्रपश्यामि कार्योपायं जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2010873, "chapter_id": 1220, "verse_number": "१-२२१-२२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2010874, "chapter_id": 1220, "verse_number": "१-२२१-२२", "content_sanskrit": "श्रुत्वा तु राधेयवचो धृतराष्ट्रः प्रतापवान्।\nअभिपूज्य ततः पश्चादिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2010875, "chapter_id": 1220, "verse_number": "१-२२१-२३", "content_sanskrit": "उपपन्नं महाप्राज्ञे कृतास्त्रे सूतनन्दने।\nत्वयि विक्रमसंपन्नमिदं वचनमीदृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2010876, "chapter_id": 1220, "verse_number": "१-२२१-२४", "content_sanskrit": "भूय एव तु भीष्मश्च द्रोणो विदुर एव च।\nयुवां च कुरुतं बुद्धिं भवेद्या नः सुखोदया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2010877, "chapter_id": 1220, "verse_number": "१-२२१-२५", "content_sanskrit": "तत आनाय्य तान्सर्वान्मन्त्रिणः सुमहायशाः।\nधृतराष्ट्रो महाराज मन्त्रयामास वै तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2010878, "chapter_id": 1220, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि विदुरागमनराज्यलाभपर्वणि एकविंशत्यधिकद्विशततमोऽध्यायः॥ २२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]