[{"id": 2073326, "chapter_id": 2549, "verse_number": "१२-५४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2073327, "chapter_id": 2549, "verse_number": "१२-५४-१", "content_sanskrit": "अथाव्रवीन्महातेजा वाक्यं कौरवनन्दनः।\nहन्त धर्मान्प्रवक्ष्यामि दृढे वाङ्भनसी मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2073328, "chapter_id": 2549, "verse_number": "१२-५४-२", "content_sanskrit": "तव प्रसादाद्गोविन्द भूतात्मा ह्यसि शाश्वतः।\nयुधिष्ठिरस्तु धर्मात्मा मां धर्माननुपृच्छतु।\nएवं प्रीतो भविष्यामि धर्मान्वक्ष्यामि चाखिलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2073329, "chapter_id": 2549, "verse_number": "१२-५४-३", "content_sanskrit": "यस्मिन्राजर्षभे जाते धर्मात्मनि महात्मनि।\nअहृष्यन्नृषयः सर्वे स मां पृच्छतु पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2073330, "chapter_id": 2549, "verse_number": "१२-५४-४", "content_sanskrit": "सर्वेषां दीप्तयशसां कुरूणां धर्मचारिणाम्।\nयस्य नास्ति समः कश्चित्स मां पृच्छतु पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2073331, "chapter_id": 2549, "verse_number": "१२-५४-५", "content_sanskrit": "धृतिर्दमो ब्रह्मचर्यं क्षमा धर्मश्च नित्यदा।\nयस्मिन्नोजश्च तेजश्च स मां पृच्छतु पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2073332, "chapter_id": 2549, "verse_number": "१२-५४-६", "content_sanskrit": "संबन्धिनोऽतिथीन्भृत्यान्संश्रितांश्चैव यो भृशम्।\nसंमानयति सत्कृत्य स मां पृच्छतु पाण़्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2073333, "chapter_id": 2549, "verse_number": "१२-५४-७", "content_sanskrit": "सत्यं दानं तपः शौर्यं शान्तिर्दाक्ष्यमसंभ्रमः।\nयस्मिन्नेतानि सर्वाणि स मां पृच्छतु पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2073334, "chapter_id": 2549, "verse_number": "१२-५४-८", "content_sanskrit": "यो न कामान्न संरम्भान्न भयान्नार्थकारणात्।\nकुर्यादधर्मं धर्मात्मा स मां पृच्छतु पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2073335, "chapter_id": 2549, "verse_number": "१२-५४-९", "content_sanskrit": "सत्यनित्यः क्षमानित्यो ज्ञाननित्योऽतिथिप्रियः।\nयो ददाति सतां नित्यं स मां पृच्छतु पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2073336, "chapter_id": 2549, "verse_number": "१२-५४-१०", "content_sanskrit": "इज्याध्ययननित्यश्च धर्मे च निरतः सदा।\nक्षान्तः श्रुतरहस्यश्च स मां पृच्छतु पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2073337, "chapter_id": 2549, "verse_number": "१२-५४-११x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2073338, "chapter_id": 2549, "verse_number": "१२-५४-११", "content_sanskrit": "लज्जया परयोपेतो धर्मराजो युधिष्ठिरः।\nअभिशापभयाद्भीतो भवन्तं नोपसर्पति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2073339, "chapter_id": 2549, "verse_number": "१२-५४-१२", "content_sanskrit": "लोकस्य कदनं कृत्वा लोकनाथो विशांपते।\nअभिशापभयाद्भीतो भवन्तं नोपसर्पति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2073340, "chapter_id": 2549, "verse_number": "१२-५४-१३", "content_sanskrit": "पूज्यान्मान्यांश्च भक्तांश्च गुरून्संबन्धिबान्धवान्।\nअर्घार्हानिषुभिर्भित्त्वा भवन्तं नोपसर्पति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2073341, "chapter_id": 2549, "verse_number": "१२-५४-१४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2073342, "chapter_id": 2549, "verse_number": "१२-५४-१४", "content_sanskrit": "ब्राह्मणानां यथा धर्मो दानमध्ययनं तपः।\nक्षत्रियाणां तथा कृष्ण समरे देहपातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2073343, "chapter_id": 2549, "verse_number": "१२-५४-१५", "content_sanskrit": "पितॄन्पितामहान्भ्रातॄन्गुरून्संबन्धिबान्धवान्।\nमिथ्याप्रवृत्तान्यः सख्ये निहन्याद्धर्म एव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2073344, "chapter_id": 2549, "verse_number": "१२-५४-१६", "content_sanskrit": "समयत्यागिनो लुब्धान्गुरूनपि च केशव।\nनिहन्ति समरे पापान्क्षत्रियो यः स धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2073345, "chapter_id": 2549, "verse_number": "१२-५४-१७", "content_sanskrit": "यो लोभान्न समीक्षेत धर्मसेतुं सनातनम्।\nनिहन्ति यस्तं समरे क्षत्रियो वै स धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2073346, "chapter_id": 2549, "verse_number": "१२-५४-१८", "content_sanskrit": "लोहितोदां केशतृणां गजशैलां ध्वजद्रुमाम्।\nमहीं करोति युद्धेषु क्षत्रियो यः स धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2073347, "chapter_id": 2549, "verse_number": "१२-५४-१९", "content_sanskrit": "आहूतेन रणे नित्यं योद्धव्यं क्षत्रबन्धुना।\nधर्म्यं स्वर्ग्यं च लोक्यं च युद्धं हि मनुरब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2073348, "chapter_id": 2549, "verse_number": "१२-५४-२०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2073349, "chapter_id": 2549, "verse_number": "१२-५४-२०", "content_sanskrit": "एवमुक्तस्तु भीष्मेण धर्मपुत्रो युधिष्ठिरः।\nविनीतवदुपागम्य तस्थै संदर्शनेऽग्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2073350, "chapter_id": 2549, "verse_number": "१२-५४-२१", "content_sanskrit": "अथास्य पादौ जग्राह भीष्मश्चापि ननन्द तम्।\nमूर्ध्निं चैनमुपाघ्राय निषीदेत्यब्रवीत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2073351, "chapter_id": 2549, "verse_number": "१२-५४-२२", "content_sanskrit": "तमुवाचाथ गाङ्गेयो वृषभः सर्वधन्विनाम्।\nमां पृच्छ तात विस्रब्धं मा भैस्त्वं कुरुसत्तम॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2073352, "chapter_id": 2549, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि चतुःपञ्चाशोऽध्यायः॥ ५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]