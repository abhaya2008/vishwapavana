[{"id": 2138222, "chapter_id": 3994, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2138223, "chapter_id": 3994, "verse_number": "१", "content_sanskrit": "निवृत्तवनवासास्ते सत्यसन्धा यशस्विनः ।\nअकुर्वन्त पुनर्मन्त्रं सह धौम्येन पाण्डवाः\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2138224, "chapter_id": 3994, "verse_number": "२", "content_sanskrit": "अथाब्रवीन्महाराज कुन्तीपुत्रो युधिष्ठिरः ।\nभ्रातॄन् कृष्णां च सम्प्रेक्ष्य धौम्यं च कुरुनन्दन\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2138225, "chapter_id": 3994, "verse_number": "३", "content_sanskrit": "द्वादशेमानि वर्षाणि राष्ट्राद् विप्रोषिता वयम्\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2138226, "chapter_id": 3994, "verse_number": "४", "content_sanskrit": "त्रयोदशमिमं प्राप्तं क्व नु वत्स्यामहेऽर्जुन ।\nअबुद्धा धार्तराष्ट्रैश्च समग्राः सह कृष्णया\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2138227, "chapter_id": 3994, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2138228, "chapter_id": 3994, "verse_number": "५", "content_sanskrit": "तस्यैव वरदानेन धर्मस्य मनुजाधिप ।\nअज्ञाता विचरिष्यामो नराणां भरतर्षभ\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2138229, "chapter_id": 3994, "verse_number": "६", "content_sanskrit": "तानि राष्ट्राणि वासाय कीर्तयिष्यामि कानिचित् ।\nरमणीयानि गुप्तानि तेषां किञ्चित्तु रोचय\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2138230, "chapter_id": 3994, "verse_number": "७", "content_sanskrit": "सन्ति रम्या जनपदा बहवस्त्वभितः कुरून् ।\nपाञ्चालाश्चैव मत्स्याश्च साल्ववैदेहबाह्लिकाः\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2138231, "chapter_id": 3994, "verse_number": "८", "content_sanskrit": "दशार्णाः शूरसेनाश्च कळिङ्गा मगधा अपि\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2138232, "chapter_id": 3994, "verse_number": "९", "content_sanskrit": "विराटनगरं चापि श्रूयते शत्रुकर्शन ।\nरमणीयं जनाकीर्णं सुभिक्षं स्फीतमेव च\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2138233, "chapter_id": 3994, "verse_number": "१०", "content_sanskrit": "नानाराष्ट्राणि चान्यानि श्रूयन्ते सुबहून्यपि\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2138234, "chapter_id": 3994, "verse_number": "११", "content_sanskrit": "यत्र ते रोचते राजंस्तत्र गच्छामहे वयम् ।\nकतमस्मिन् जनपदे महाराज निवत्स्यसि\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2138235, "chapter_id": 3994, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2138236, "chapter_id": 3994, "verse_number": "१२", "content_sanskrit": "एवमेतन्महाबाहो यथा स भगवान् प्रभुः ।\nअब्रवीत् सर्वभूतेशस्तथैतन्न तदन्यथा\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2138237, "chapter_id": 3994, "verse_number": "१३", "content_sanskrit": "अवश्यं त्वेव वासार्थं रमणीयं शिवं सुखम् ।\nसम्मन्त्र्य सहितैः सर्वैर्द्रष्टव्यमकुतोभयम्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2138238, "chapter_id": 3994, "verse_number": "१४", "content_sanskrit": "मात्स्यो विराटो बलवान् सार्वभौमश्च विश्रुतः ।\nदानशीलो वदान्यश्च वृद्धः सत्सु सुसम्मतः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2138239, "chapter_id": 3994, "verse_number": "१५", "content_sanskrit": "गुणवाँल्लोकविख्यातो दृढभक्तिर्विशारदः ।\nतत्र मे रोचते पार्थ मत्स्यराजान्तिकेऽनघ\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2138240, "chapter_id": 3994, "verse_number": "१६", "content_sanskrit": "विराटनगरे तात मासान् द्वादश संश्रिताः ।\nकुर्वन्तस्तस्य कर्माणि वसामेति ह रोचये\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2138241, "chapter_id": 3994, "verse_number": "१७", "content_sanskrit": "यानि यानीह कर्माणि तस्मै चकृमहे वयम् ।\nकर्तुं यो यत् स तत् कर्म ब्रवीतु कुरुनन्दन\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2138242, "chapter_id": 3994, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2138243, "chapter_id": 3994, "verse_number": "१८", "content_sanskrit": "नरदेव कथं कर्म तस्य राष्ट्रे चरिष्यसि ।\nमानुषेन्द्र विराटस्य रंस्यसे केन कर्मणा\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2138244, "chapter_id": 3994, "verse_number": "१९", "content_sanskrit": "अक्लिष्टवेषधारी च धार्मिको ह्यनसूयकः ।\nन तवाभ्युचितं कर्म नृशंसं नापि कैतवम्\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2138245, "chapter_id": 3994, "verse_number": "२०", "content_sanskrit": "सत्यवागसि याज्ञीयो रागक्रोधविवर्जितः ।\nमृदुर्वदान्यो ह्रीमांश्च धार्मिकः सत्यविक्रमः\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2138246, "chapter_id": 3994, "verse_number": "२१", "content_sanskrit": "राजन् त्वं तपसा क्लिष्टः कथं तस्य चरिष्यसि ।\nन दुःखमुचितं किञ्चिद् राजन् पापमतेर्यथा\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2138247, "chapter_id": 3994, "verse_number": "२२", "content_sanskrit": "स इमामापदं प्राप्य कथं घोरां तरिष्यसि\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2138248, "chapter_id": 3994, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2138249, "chapter_id": 3994, "verse_number": "२३", "content_sanskrit": "शृणुध्वं यच्चरिष्यामि अहं वै कुरुनन्दन\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2138250, "chapter_id": 3994, "verse_number": "२४", "content_sanskrit": "विराटं समनुप्राप्य राजानं मत्स्यनन्दनम् ।\nसभास्तारो भविष्यामि विराटस्येति मे मतिः\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2138251, "chapter_id": 3994, "verse_number": "२५", "content_sanskrit": "कङ्को नाम ब्रुवाणोऽहं मताक्षः साधुदेविता\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2138252, "chapter_id": 3994, "verse_number": "२६", "content_sanskrit": "वैडूर्यकाञ्चनान् दान्तान् स्फाटिकान् राजतानपि ।\nकृष्णाक्षाँल्लोहिताक्षांश्च धारयिष्ये सुवेष्टितान्\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2138253, "chapter_id": 3994, "verse_number": "२७", "content_sanskrit": "अरिष्टान् राजगोलिङ्गान् दर्शनीयान् सुवर्चसः\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2138254, "chapter_id": 3994, "verse_number": "२८", "content_sanskrit": "लोहिताश्चाश्मगर्भाश्च सन्ति तात धनानि मे ।\nदर्शनीयान् सभानन्दान् कुशलैः साधु निष्ठितान्\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2138255, "chapter_id": 3994, "verse_number": "२९", "content_sanskrit": "अप्येतान् पाणिना स्पृष्ट्वा सम्प्रहृष्यन्ति मानवाः\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2138256, "chapter_id": 3994, "verse_number": "३०", "content_sanskrit": "तान् विकीर्य समे देशे रमणीयान् विपांसुले ।\nदेविष्यामि यथाकामं स विहारो भविष्यति\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2138257, "chapter_id": 3994, "verse_number": "३१", "content_sanskrit": "कङ्को नाम्ना परिव्राजो विराटस्य सभासदः ।\nज्यौतिषे शकुनज्ञाने निमित्ते चाक्षकौशले\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2138258, "chapter_id": 3994, "verse_number": "३२", "content_sanskrit": "ब्राह्मो वेदो मयाऽधीतो वेदाङ्गानि च सर्वशः\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2138259, "chapter_id": 3994, "verse_number": "३३", "content_sanskrit": "धर्मकामार्थमोक्षेषु नीतिशास्त्रेषु पारगः ।\nपृष्टोऽहं कथयिष्यामि राज्ञः प्रियहितं वचः\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2138260, "chapter_id": 3994, "verse_number": "३४", "content_sanskrit": "आसं युधिष्ठिरस्याहं पुरा प्राणसमः सखा ।\nइति वक्ष्यामि राजानं यदि मामनुयोक्ष्यते\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2138261, "chapter_id": 3994, "verse_number": "३५", "content_sanskrit": "विराटनगरे च्छन्नः कृष्णया च सहानुगैः ।\nइत्येव मत्प्रतिज्ञातं विचरिष्याम्यहं यथा\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2138262, "chapter_id": 3994, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि द्वितीयो- ऽध्यायः ॥२॥ वैराटपर्वणि युधिष्ठिरच्छन्नोपायकथनं नाम द्वितीयोऽध्यायः ॥२॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]