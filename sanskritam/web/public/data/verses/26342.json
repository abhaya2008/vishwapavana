[{"id": 7006342000, "chapter_id": 26342, "verse_number": "१-५२-१", "content_sanskrit": "वैशम्पायन उवाच बाढमित्येव सह तैर्दुर्दिनाम्भोदनिःस्वनः ।\nप्रतस्थे दुर्दिनाकारः सदुर्दिन इवाचलः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006342001, "chapter_id": 26342, "verse_number": "१-५२-२", "content_sanskrit": "समुक्तामणिविद्योतं सचन्द्राम्भोदवर्चसम् ।\nसजटामण्डलं कृत्स्नं स बिभ्रच्छ्रीधरो हरिः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006342002, "chapter_id": 26342, "verse_number": "१-५२-३", "content_sanskrit": "स चास्योरसि विस्तीर्णे रोमाञ्चोद्गतराजिमान् ।\nश्रीवत्सो राजते श्रीमांस्तनद्वयमुखाञ्चितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006342003, "chapter_id": 26342, "verse_number": "१-५२-४", "content_sanskrit": "पीते वसानो वसने लोकानां गुरुरव्ययः ।\nहरिः सोऽभवदालक्ष्यः स संध्याभ्र इवाचलः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006342004, "chapter_id": 26342, "verse_number": "१-५२-५", "content_sanskrit": "तं व्रजन्तं सुपर्णेन पद्मयोनिगतानुगम् ।\nअनुजग्मुः सुराः सर्वे तद्गतासक्तचक्षुषः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006342005, "chapter_id": 26342, "verse_number": "१-५२-६", "content_sanskrit": "नातिदीर्घेण कालेन सम्प्राप्ता रत्नपर्वतम् ।\nदडशुर्देवतास्तत्र तां सभां कामरूपिणीम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006342006, "chapter_id": 26342, "verse_number": "१-५२-७", "content_sanskrit": "मेरोः शिखरविन्यस्तां संयुक्तां सूर्यवर्चसा ।\nकाञ्चनस्तम्भरचितां वज्रसंधानतोरणाम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006342007, "chapter_id": 26342, "verse_number": "१-५२-८", "content_sanskrit": "मनोनिर्माणचित्राढ्यां विमानशतमालिनीम् ।\nरत्नजालान्तरवतीं कामगां रत्नभूषिताम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006342008, "chapter_id": 26342, "verse_number": "१-५२-९", "content_sanskrit": "क्लृप्तरत्नसमाकीर्णां सर्वर्तुकुसुमोत्कटाम् ।\nदेवमायाधरां दिव्यां विहितां विश्वकर्मणा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006342009, "chapter_id": 26342, "verse_number": "१-५२-१०", "content_sanskrit": "तां हृष्टमनसः सर्वे यथास्थानं यथाविधि ।\nयथानिदेशं त्रिदशा विविशुस्ते सभां शुभाम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006342010, "chapter_id": 26342, "verse_number": "१-५२-११", "content_sanskrit": "ते निषेदुर्यथोक्तेषु विमानेष्वासनेषु च ।\nभद्रासनेषु पीठेषु कुथास्वास्तरणेषु च   ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006342011, "chapter_id": 26342, "verse_number": "१-५२-१२", "content_sanskrit": "ततः प्रभञ्जनो वायुर्ब्रह्मणा साधु चोदितः ।\nमा शब्दमिति सर्वत्र प्रचक्रामाथ तां सभाम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006342012, "chapter_id": 26342, "verse_number": "१-५२-१३", "content_sanskrit": "निःशब्दस्तिमिते तस्मिन्समाजे त्रिदिवौकसाम् ।\nबभाषे धरणी वाक्यं खेदात् करुणभाषिणी ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006342013, "chapter_id": 26342, "verse_number": "१-५२-१४", "content_sanskrit": "धरण्युवाच त्वया धार्या त्वहं दैव त्वया वै धार्यते जगत् ।\nत्वं धारयसि भूतानि भुवनानि बिभर्षि च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006342014, "chapter_id": 26342, "verse_number": "१-५२-१५", "content_sanskrit": "यत् त्वया धार्यते किञ्चित्तेजसा च बलेन च ।\nततस्तव प्रसादेन मया यत्नाच्च धार्यते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006342015, "chapter_id": 26342, "verse_number": "१-५२-१६", "content_sanskrit": "त्वया धृतं धारयामि नाधृतं धारयाम्यहम् ।\nन हि तद् विद्यते भूतं यत् त्वया नानुधार्यते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006342016, "chapter_id": 26342, "verse_number": "१-५२-१७", "content_sanskrit": "त्वमेव कुरुषे देव नारायण युगे युगे ।\nमम भारावतरणं जगतो हितकाम्यया ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006342017, "chapter_id": 26342, "verse_number": "१-५२-१८", "content_sanskrit": "तवैव तेजसाऽऽक्रान्तां रसातलतलं गताम् ।\nत्रायस्व मां सुरश्रेष्ठ त्वामेव शरणं गताम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006342018, "chapter_id": 26342, "verse_number": "१-५२-१९", "content_sanskrit": "दानवैः पीड्यमानाहं राक्षसैश्च दुरात्मभिः ।\nत्वामेव शरणं नित्यमुपयास्ये सनातनम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006342019, "chapter_id": 26342, "verse_number": "१-५२-२०", "content_sanskrit": "तावन्मेऽस्ति भयं भूयो यावन्न त्वां ककुद्मिनम् ।\nशरणं यामि मनसा शतशो ह्युपलक्षये ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006342020, "chapter_id": 26342, "verse_number": "१-५२-२१", "content_sanskrit": "अहमादौ पुराणस्य संक्षिप्ता पद्मयोनिना ।\nमां च बद्ध्वा कृतौ पूर्वं मृन्मयौ द्वौ महासुरौ ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006342021, "chapter_id": 26342, "verse_number": "१-५२-२२", "content_sanskrit": "कर्णस्रोतोद्भवौ तौ हि विष्णोरस्य महात्मनः ।\nमहार्णवे प्रस्वपतः काष्ठकुण्ड्यसमौ स्थितौ ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006342022, "chapter_id": 26342, "verse_number": "१-५२-२३", "content_sanskrit": "तौ विवेश स्वयं वायुर्ब्रह्मणा साधु चोदितः ।\nदिवं प्रच्छादयन्तौ तु ववृधाते महासुरौ ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006342023, "chapter_id": 26342, "verse_number": "१-५२-२४", "content_sanskrit": "वायुप्राणौ तु तौ गृह्य ब्रह्मा पर्यमृशच्छनैः ।\nएकं मृदुतरं मेने कठिनं वेद चापरम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006342024, "chapter_id": 26342, "verse_number": "१-५२-२५", "content_sanskrit": "नामनी तु तयोश्चक्रे स विभुः सलिलोद्भवः ।\nमृदुस्त्वयं मधुर्नाम कठिनः कैटभोऽभवत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006342025, "chapter_id": 26342, "verse_number": "१-५२-२६", "content_sanskrit": "तौ दैत्यौ कृतनामानौ चेरतुर्बलदर्पिंतौ ।\nसर्वमेकार्णवं लोकं योद्धुकामौ सुदुर्जयौ ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006342026, "chapter_id": 26342, "verse_number": "१-५२-२७", "content_sanskrit": "तावागतौ समालोक्य ब्रह्मा लोकपितामहः ।\nएकार्णवाम्बुनिचये तत्रैवान्तरधीयत ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006342027, "chapter_id": 26342, "verse_number": "१-५२-२८", "content_sanskrit": "स पद्मे पद्मनाभस्य नाभिमध्यात् समुत्थिते ।\nरोचयामास वसतिं गुह्यां ब्रह्मा चतुर्मुखः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006342028, "chapter_id": 26342, "verse_number": "१-५२-२९", "content_sanskrit": "तावुभौ जलगर्भस्थौ नारायणपितामहौ ।\nबहून् वर्षगणानप्सु शयानौ न चकम्पतुः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006342029, "chapter_id": 26342, "verse_number": "१-५२-३०", "content_sanskrit": "अथ दीर्घस्य कालस्य तावुभौ मधुकैटभौ ।\nआजग्मतुस्तमुद्देशं यत्र ब्रह्मा व्यवस्थितः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006342030, "chapter_id": 26342, "verse_number": "१-५२-३१", "content_sanskrit": "दृष्ट्वा तावसुरौ घोरौ महाकायौ दुरासदौ ।\nब्रह्मणा ताडितो विष्णुः पद्मनालेन वै तदा ।\nउत्पपाताथ शयनात् पद्मनाभो महाद्युतिः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006342031, "chapter_id": 26342, "verse_number": "१-५२-३२", "content_sanskrit": "तद् युद्धमभवद् घोरं तयोस्तस्य च वै तदा ।\nएकार्णवे तदा लोके त्रैलोक्ये जलतां गते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006342032, "chapter_id": 26342, "verse_number": "१-५२-३३", "content_sanskrit": "तदाभूत् तुमुलं युद्धं वर्षसंख्या सहस्रशः ।\nन च तावसुरौ युद्धे तदा श्रममवापतुः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006342033, "chapter_id": 26342, "verse_number": "१-५२-३४", "content_sanskrit": "अथातो दीर्घकालस्य तौ दैत्यौ युद्धदुर्मदौ ।\nऊचतुः प्रीतमनसौ देवं नारायणं हरिम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006342034, "chapter_id": 26342, "verse_number": "१-५२-३५", "content_sanskrit": "प्रीतौ स्वस्तव युद्धेन श्लाघ्यस्त्वं मृत्युरावयोः ।\nआवां जहि न यत्रोर्वी सलिलेन परिप्लुता ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006342035, "chapter_id": 26342, "verse_number": "१-५२-३६", "content_sanskrit": "हतौ च तव पुत्रत्वं प्राप्नुयावः सुरोत्तम ।\nयो ह्यावां युधि निर्जेता तस्यावां विहितौ सुतौ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006342036, "chapter_id": 26342, "verse_number": "१-५२-३७", "content_sanskrit": "स तु गृह्य मृधे दोर्भ्यां दैत्यौ तावभ्यपीडयत् ।\nजग्मतुर्निधनं चापि तावुभौ  मधुकैटभौ  ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006342037, "chapter_id": 26342, "verse_number": "१-५२-३८", "content_sanskrit": "तौ हतौ चाप्लुतौ तोये वपुर्भ्यामेकतां गतौ ।\nमेदो मुमुचतुर्दैत्यौ मथ्यमानौ जलोर्मिभिः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006342038, "chapter_id": 26342, "verse_number": "१-५२-३९", "content_sanskrit": "मेदसा तज्जलं व्याप्तं ताभ्यामन्तर्दधे ततः ।\nनारायणश्च भगवानसृजत् स पुनः प्रजाः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006342039, "chapter_id": 26342, "verse_number": "१-५२-४०", "content_sanskrit": "दैत्ययोर्मेदसाच्छना मेदिनीति ततः स्मृता ।\nप्रभावात्पद्मनाभस्य शाश्वती जगती कृता ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006342040, "chapter_id": 26342, "verse_number": "१-५२-४१", "content_sanskrit": "वराहेण पुरा भूत्वा मार्कण्डेयस्य पश्यतः ।\nविषाणेनाहमेकेन तोयमध्यात् समुद्धृता ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006342041, "chapter_id": 26342, "verse_number": "१-५२-४२", "content_sanskrit": "हृताहं क्रमता भूयस्तदा युष्माकमग्रतः ।\nबलेः सकाशाद्दैत्यस्य विष्णुना प्रभविष्णुना ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006342042, "chapter_id": 26342, "verse_number": "१-५२-४३", "content_sanskrit": "साम्प्रतं खिद्यमानाहमेनमेव गदाधरम् ।\nअनाथा जगतो नाथ शरण्यं शरणं गता ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006342043, "chapter_id": 26342, "verse_number": "१-५२-४४", "content_sanskrit": "अग्निः सुवर्णस्य गुरुर्गवां सूर्यो गुरुः स्मृतः ।\nनक्षत्राणां गुरुः सोमो मम नारायणो गुरुः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006342044, "chapter_id": 26342, "verse_number": "१-५२-४५", "content_sanskrit": "यदहं धारयाम्येका जगत् स्थावरजङ्गमम् ।\nमया धृतं धारयते सर्वमेतद् गदाधरः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006342045, "chapter_id": 26342, "verse_number": "१-५२-४६", "content_sanskrit": "जामदग्न्येन रामेण भारावतरणेप्सया ।\nरोषात् त्रिःसप्तकृत्वोऽहं क्षत्रियैर्विप्रयोजिता ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006342046, "chapter_id": 26342, "verse_number": "१-५२-४७", "content_sanskrit": "सास्मि वेद्यां समारोप्य तर्पिता नृपशोणितैः ।\nभार्गवेण पितुः श्राद्धे कश्यपाय निवेदिता ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006342047, "chapter_id": 26342, "verse_number": "१-५२-४८", "content_sanskrit": "मांसमेदोऽस्थिदुर्गन्धा दिग्धा क्षत्रियशोणितैः ।\nरजस्वलेव युवतिः कश्यपं समुपस्थिता ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006342048, "chapter_id": 26342, "verse_number": "१-५२-४९", "content_sanskrit": "स मां ब्रह्मर्षिरप्याह किमुर्वि त्वमवाङ्मुखी ।\nवीरपत्नीव्रतमिदं धारयन्ती विषीदसि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006342049, "chapter_id": 26342, "verse_number": "१-५२-५०", "content_sanskrit": "साहं विज्ञापितवती कश्यपं लोकभावनम् ।\nपतयो मे हता ब्रह्मन् भार्गवेण महात्मना ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006342050, "chapter_id": 26342, "verse_number": "१-५२-५१", "content_sanskrit": "साहं विहीना विक्रान्तैः क्षत्रियैः शस्त्रवृत्तिभिः ।\nविधवा शून्यनगरा न धारयितुमुत्सहे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006342051, "chapter_id": 26342, "verse_number": "१-५२-५२", "content_sanskrit": "तन्मह्यं दीयतां भर्ता भगवंस्त्वत्समो नृपः ।\nरक्षेत् सग्रामनगरां यो मां सागरमालिनीम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006342052, "chapter_id": 26342, "verse_number": "१-५२-५३", "content_sanskrit": "स श्रुत्वा भगवान्वाक्यं बाढमित्यब्रवीत्प्रभुः ।\nततो मां मानवेन्द्राय मनवे स प्रदत्तवान् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006342053, "chapter_id": 26342, "verse_number": "१-५२-५४", "content_sanskrit": "सा मनुप्रभवं दिव्यं प्राप्येक्ष्वाकुकुलं नृपम् ।\nविपुलेनास्मि कालेन पार्थिवात् पार्थिवं गता ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006342054, "chapter_id": 26342, "verse_number": "१-५२-५५", "content_sanskrit": "एवं दत्तास्मि मनवे मानवेन्द्राय धीमते ।\nभुक्ता राजसहस्रैश्च महर्षिकुलसम्मितैः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006342055, "chapter_id": 26342, "verse_number": "१-५२-५६", "content_sanskrit": "बहवः क्षत्रियाः शूरा मां जित्वा दिवमाश्रिताः ।\nते च कालवशं प्राप्य मय्येव प्रलयं गताः ॥५६ ।ऽ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006342056, "chapter_id": 26342, "verse_number": "१-५२-५७", "content_sanskrit": "मत्कृते विग्रहा लोके वृत्ता वर्तन्त एव च ।\nक्षत्रियाणां बलवतां संग्रामेष्वनिवर्तिनाम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006342057, "chapter_id": 26342, "verse_number": "१-५२-५८", "content_sanskrit": "एतद् युष्मत्प्रवृत्तेन दैवेन परिपाल्यते ।\nजगद्धितार्थं कुरुत राज्ञां हेतुं रणक्षये ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006342058, "chapter_id": 26342, "verse_number": "१-५२-५९", "content_sanskrit": "यद्यस्ति मयि कारुण्यं भारशैथिल्यकारणात् ।\nएकश्चक्रधरः श्रीमानभयं मे प्रयच्छतु ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006342059, "chapter_id": 26342, "verse_number": "१-५२-६०", "content_sanskrit": "यमहं भारसंतप्ता सम्प्राप्ता शरणार्थिनी ।\nभारो यद्यवरोप्तव्यो विष्णुरेष ब्रवीतु माम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]