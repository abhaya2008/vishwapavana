[{"id": 2075239, "chapter_id": 2592, "verse_number": "१२-९७-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075240, "chapter_id": 2592, "verse_number": "१२-९७-१", "content_sanskrit": "क्षत्रधर्माद्धि पापीयान्न धर्मोऽस्ति नराधिप।\nअपयाने च युद्धे च राजा हन्ति महाजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075241, "chapter_id": 2592, "verse_number": "१२-९७-२", "content_sanskrit": "अथ स्म कर्मणा केन लोकाञ्जयति पार्थिवः।\nविद्वञ्जिज्ञासमानाय प्रब्रूहि भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075242, "chapter_id": 2592, "verse_number": "१२-९७-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075243, "chapter_id": 2592, "verse_number": "१२-९७-३", "content_sanskrit": "निग्रहेण च पापानां साधूनां संग्रहेण च।\nयज्ञैर्दानैश्च राजानो भवन्ति शुचयोऽमलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075244, "chapter_id": 2592, "verse_number": "१२-९७-४", "content_sanskrit": "उपरुन्धन्ति राजानो भूतानि विजयार्थिनः।\nत एव विजयं प्राप्य वर्धयन्ति पुनः प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075245, "chapter_id": 2592, "verse_number": "१२-९७-५", "content_sanskrit": "अपविध्यन्ति पापानि दानयज्ञतपोबलैः।\nअनुग्रहेण भूतानां पुण्यमेषां विवर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075246, "chapter_id": 2592, "verse_number": "१२-९७-६", "content_sanskrit": "यथैव क्षेत्रनिर्याता निर्यातं क्षेत्रमेव च।\nहिनस्ति धान्यकक्षं च न च धान्यं विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2075247, "chapter_id": 2592, "verse_number": "१२-९७-७", "content_sanskrit": "एवं शस्त्राणि मुञ्चन्तो घ्नन्ति वध्याननेकधा।\nतस्यैषा निष्कृतिर्दृष्टा भूतानां भावनं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2075248, "chapter_id": 2592, "verse_number": "१२-९७-८", "content_sanskrit": "यो भूतानि सदाऽनर्थाद्वधात्क्लेशाच्च रक्षति।\nदस्युभ्यः प्राणदानात्स धनदः सुखदो विराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2075249, "chapter_id": 2592, "verse_number": "१२-९७-९", "content_sanskrit": "स सर्वयज्ञारीजानो राजाऽथाभयदक्षिणैः।\nअनुभूयेह भद्राणि प्राप्नोतीन्द्रसलोकताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2075250, "chapter_id": 2592, "verse_number": "१२-९७-१०", "content_sanskrit": "ब्राह्मणार्थे समुत्पन्ने योऽभिनिष्पत्य युध्यति।\nआत्मानं यूपमुत्सृज्य स यज्ञोऽनन्तदक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2075251, "chapter_id": 2592, "verse_number": "१२-९७-११", "content_sanskrit": "अभीतो विकिरञ्शत्रून्प्रतिगृह्य शरांस्तथा।\nन तस्मान्त्रिदशाः श्रेयो भुवि पश्यन्ति किंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2075252, "chapter_id": 2592, "verse_number": "१२-९७-१२", "content_sanskrit": "तस्य शस्त्राणि यावन्ति त्वचं भिन्दन्ति संयुगे।\nतावतः सोऽश्नुते लोकान्सर्वकामदुहोऽक्षयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2075253, "chapter_id": 2592, "verse_number": "१२-९७-१३", "content_sanskrit": "यदस्य रुधिरं गात्रादाहवे संप्रवर्तते।\nसह तेनैव स्रावेण सर्वपापैः प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2075254, "chapter_id": 2592, "verse_number": "१२-९७-१४", "content_sanskrit": "यानि दुःखानि सहते प्राणानामतिपातने।\nन तपोऽस्ति ततो भूय इति धर्मविदो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2075255, "chapter_id": 2592, "verse_number": "१२-९७-१५", "content_sanskrit": "पृष्ठतो भीरवः सङ्ख्ये वर्तन्ते धर्मपूरुषाः।\nशूराच्छरणमिच्छन्तः पर्जन्यादिव जीवनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2075256, "chapter_id": 2592, "verse_number": "१२-९७-१६", "content_sanskrit": "यदि शूरं तथा क्षेमे प्रतीक्षेरन्यथा भये।\nप्रतिरूपं जनाः कुर्युर्न च तद्वर्तते तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2075257, "chapter_id": 2592, "verse_number": "१२-९७-१७", "content_sanskrit": "यदि ते कृतमाज्ञाय नमस्कुर्युः सदैव तम्।\nयुक्तं न्याय्यं च कुर्युस्ते न च तद्वर्तते तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2075258, "chapter_id": 2592, "verse_number": "१२-९७-१८", "content_sanskrit": "पुरुषाणां समानानां दृश्यते महदन्तरम्।\nसंग्रामेऽनीकवेलायामुत्कृष्टेषु पतत्सु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2075259, "chapter_id": 2592, "verse_number": "१२-९७-१९", "content_sanskrit": "पतत्यभिमुखं शूरः परान्भीरुः पलायते।\nआस्थाय स्वर्ग्यमध्वानं सहायान्विषमे त्यजन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2075260, "chapter_id": 2592, "verse_number": "१२-९७-२०", "content_sanskrit": "मा स्म तांस्तादृशांस्तात जनिष्टाऽधर्मपूरुषान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2075261, "chapter_id": 2592, "verse_number": "१२-९७-२१", "content_sanskrit": "ये सहायान्रणे हित्वा स्वस्तिमन्तो गृहान्ययुः।\nअस्वस्ति तेभ्यः कुर्वन्ति देवा इन्द्रपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2075262, "chapter_id": 2592, "verse_number": "१२-९७-२२", "content_sanskrit": "त्यागेन यः सहायानां स्वान्प्राणांस्त्रातुमिच्छति।\nतं हन्युः काष्ठलोहैर्वा दहेयुर्वा कटाग्निना।\nपशुवन्मारयेयुर्वा क्षत्रिया ये स्युरीदृशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2075263, "chapter_id": 2592, "verse_number": "१२-९७-२३", "content_sanskrit": "अधर्मः क्षत्रियस्यैष यच्छय्यामरणं भवेत्।\nविसृजञ्श्लेष्मपित्तानि कृपणं परिदेवयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2075264, "chapter_id": 2592, "verse_number": "१२-९७-२४", "content_sanskrit": "अविक्षतेन देहेन प्रलयं योऽधिगच्छति।\nक्षत्रियो नास्य तत्कर्म प्रशंसन्ति पुराविदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2075265, "chapter_id": 2592, "verse_number": "१२-९७-२५", "content_sanskrit": "न गृहे मरणं तात क्षत्रियाणां प्रशस्यते।\nशौण्डीराणामशौण्डीर्यमधर्मं कृपणं च तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2075266, "chapter_id": 2592, "verse_number": "१२-९७-२६", "content_sanskrit": "इदं कृच्छ्रमहो दुःखं पापीय इति निष्टनन्।\nप्रतिध्वस्तमुखः पूतिरमात्याननुशोचयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2075267, "chapter_id": 2592, "verse_number": "१२-९७-२७", "content_sanskrit": "अरोगाणां स्पृहयते मुहुर्मृत्युमपीच्छति।\nवीरो दृप्तो मनस्वी च नेदृशं मृत्युमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2075268, "chapter_id": 2592, "verse_number": "१२-९७-२८", "content_sanskrit": "रणेषु कदनं कृत्वा सुहृद्भिः प्रतिपूजित।\nतीक्ष्णैः शस्त्रैरभिक्लिष्टः क्षत्रियो मुत्युमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2075269, "chapter_id": 2592, "verse_number": "१२-९७-२९", "content_sanskrit": "शूरो हि सत्वमन्युभ्यामाविष्टो युध्यते मशम्।\nकृत्यमानानि गात्राणि परैर्नैवावबुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2075270, "chapter_id": 2592, "verse_number": "१२-९७-३०", "content_sanskrit": "स सङ्ख्ये निधनं प्राप्य प्रशस्तं लोकपूजितम्।\nस्वधर्मं विपुलं प्राप्य शक्रस्यैति सलोकताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2075271, "chapter_id": 2592, "verse_number": "१२-९७-३१", "content_sanskrit": "सर्वोपायै रणमुखमातिष्ठंस्त्यक्तजीवितः।\nप्राप्नोतीन्द्रस्य सालोक्यं शूरः पृष्ठमदर्शयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2075272, "chapter_id": 2592, "verse_number": "१२-९७-३२", "content_sanskrit": "यत्रयत्र हतः शूरः शत्रुभिः परिवारितः।\nअक्षयांल्लभते लोकान्यदि दैन्यं न सेवते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2075273, "chapter_id": 2592, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि सप्तनवतितमोऽध्यायः॥ ९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]