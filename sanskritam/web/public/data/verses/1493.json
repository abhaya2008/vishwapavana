[{"id": 2023101, "chapter_id": 1493, "verse_number": "३-१३१-०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2023102, "chapter_id": 1493, "verse_number": "३-१३१-१", "content_sanskrit": "अस्मिन्किल स्वयं राजन्निष्टवान्वै प्रजापतिः।\nसत्रमिष्टीकृतं नाम पुरा वर्षसहस्रिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2023103, "chapter_id": 1493, "verse_number": "३-१३१-२", "content_sanskrit": "अम्बरीषश्च नाभाग इष्टवान्यमुनामनु।\nयत्रेष्ट्वा दशपद्मानि सदस्येभ्योऽभिसृष्टवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2023104, "chapter_id": 1493, "verse_number": "३-१३१-३", "content_sanskrit": "यज्ञैश्च तपसा चैव परां सिद्धिमवाप सः।\nदेशश्च नाहुषस्यायं य़ज्वनः पुण्यकर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2023105, "chapter_id": 1493, "verse_number": "३-१३१-४", "content_sanskrit": "सार्वभौमस्य कौन्तेय ययातेरमितौजसः।\nस्पर्धमानस्य शक्रेण तस्येदं यज्ञवास्त्विह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2023106, "chapter_id": 1493, "verse_number": "३-१३१-५", "content_sanskrit": "पश्य नानाविधाकारैरग्निभिर्निचितां महीम्।\nमज्जन्तीमिव चाक्रान्तां ययातेर्यज्ञकर्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2023107, "chapter_id": 1493, "verse_number": "३-१३१-६", "content_sanskrit": "एषा शम्येकपत्रा सा शकटं चैतदुत्तमम्।\nपश्य रामह्रदानेतान्पश्य नारायणाश्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2023108, "chapter_id": 1493, "verse_number": "३-१३१-७", "content_sanskrit": "एतच्चर्चीकपुत्रस्य योगैर्विचरतो महीम्।\nप्रसर्पणं महीपाल रौप्यायाममितौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2023109, "chapter_id": 1493, "verse_number": "३-१३१-८", "content_sanskrit": "अत्रानुवंशं पठतः शृणु मे कुरुनन्दन।\nउलूखलैराभरणैः पिशची यदभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2023110, "chapter_id": 1493, "verse_number": "३-१३१-९", "content_sanskrit": "युगन्धरे दधि प्राश्य उषित्वा चाच्युतस्थले।\nतद्वद्भूतलये स्नात्वा सपुत्रा वस्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2023111, "chapter_id": 1493, "verse_number": "३-१३१-१०", "content_sanskrit": "एकरात्रमुवित्वेह द्वितीयं यदि वत्स्यसि।\nएतद्वै ते गदेवावृत्तं रात्रौ वृत्तमितोऽन्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2023112, "chapter_id": 1493, "verse_number": "३-१३१-११", "content_sanskrit": "अद्य चात्र निवत्स्यामः क्षपां भरतसत्तम।\nद्वारमेतत्तु कौन्तेय कुरुक्षेत्रस्य भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2023113, "chapter_id": 1493, "verse_number": "३-१३१-१२", "content_sanskrit": "अत्रैव नाहुषो राजा राजन्क्रतुभिरिष्टवान्।\nययातिर्बहुरत्नौर्घर्यत्रेन्द्रो मुदमभ्यगात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2023114, "chapter_id": 1493, "verse_number": "३-१३१-१३", "content_sanskrit": "एतत्प्लक्षावतरणं यमुनातीर्थमुत्तमम्।\nएतद्वै नाकपृष्ठस्य द्वारमाहुर्मनीषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2023115, "chapter_id": 1493, "verse_number": "३-१३१-१४", "content_sanskrit": "अत्रसारस्वतैर्यज्ञैरीजानाः परमर्षयः।\nयूपोलूखलिकास्तात गच्छन्त्यवभृथप्लवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2023116, "chapter_id": 1493, "verse_number": "३-१३१-१५", "content_sanskrit": "अत्रवै भरतो राजा राजन्क्रतुभिरिष्टवान्।\nहयमेधेन यज्ञेन मेध्यमश्वमवासृजत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2023117, "chapter_id": 1493, "verse_number": "३-१३१-१६", "content_sanskrit": "असकृत्कृष्णसारङ्गं धर्मेणाप्य च मेदिनीम्।\nअत्रैव पुरुषव्याघ्र मरुत्तः सत्रमुत्तमम्।\nप्राप चैवर्षिमुख्येन संवर्तेनाभिपालितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2023118, "chapter_id": 1493, "verse_number": "३-१३१-१७", "content_sanskrit": "अत्रोपस्पृश्य राजेन्द्र सर्वाल्लोँकान्प्रपश्यति।\nपूयते दुष्कृताच्चैव अत्रापि समुपस्पृश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2023119, "chapter_id": 1493, "verse_number": "३-१३१-१८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2023120, "chapter_id": 1493, "verse_number": "३-१३१-१८", "content_sanskrit": "तत्र सभ्रातृकः स्नात्वा स्तूयमानो महर्षिभिः।\nलोमशं पाण्डवश्रेष्ठ इदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2023121, "chapter_id": 1493, "verse_number": "३-१३१-१९", "content_sanskrit": "सर्वाँल्लोकान्प्रपश्यामि तपसा सत्यविक्रम।\nइहस्तः पाण्डवश्रेष्ठं पश्यामि श्वेतवाहनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2023122, "chapter_id": 1493, "verse_number": "३-१३१-२०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2023123, "chapter_id": 1493, "verse_number": "३-१३१-२०", "content_sanskrit": "एवमेतन्महाबाहो पश्यन्ति परमर्षयः।\nइह स्नात्वा तपोयुक्तांस्त्रील्लोँकान्सचराचरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2023124, "chapter_id": 1493, "verse_number": "३-१३१-२१", "content_sanskrit": "सरस्वतीमिमां पुण्यां पुण्यैकशरणावृताम्।\nयत्र स्नात्वा नरश्रेष्ठ धूतपाप्मा भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2023125, "chapter_id": 1493, "verse_number": "३-१३१-२२", "content_sanskrit": "इह सारस्वतैर्यज्ञैरिष्टवन्तः सुरर्षयः।\nऋषयश्चैव कौन्तेय तथा राजर्षयोपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2023126, "chapter_id": 1493, "verse_number": "३-१३१-२३", "content_sanskrit": "वेदी प्रजापतेरेषा समन्तात्पञ्चयोजना।\nकुरोर्वै यज्ञशीलस्य क्षेत्रमेतन्महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2023127, "chapter_id": 1493, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि एकत्रिंशदधिकशततमोऽध्यायः ॥ १३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]