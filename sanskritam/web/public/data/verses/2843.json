[{"id": 2086697, "chapter_id": 2843, "verse_number": "१२-३४८-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2086698, "chapter_id": 2843, "verse_number": "१२-३४८-१", "content_sanskrit": "नारदः परिप्रपच्छ भगवन्तं जनार्दनम्।\nएकार्णवे महाघोरे नष्टे स्थावरजङ्गमे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2086699, "chapter_id": 2843, "verse_number": "१२-३४८-२x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2086700, "chapter_id": 2843, "verse_number": "१२-३४८-२", "content_sanskrit": "शृणु नारद तत्वेन प्रादुर्भावान्महामुने।\nमत्स्यः कूर्मो वराहश्च नरसिंहोऽथ वामनः।\nरामो रामश्च रामश्च बुद्धः कल्कीति ते दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2086701, "chapter_id": 2843, "verse_number": "१२-३४८-३", "content_sanskrit": "पूर्वं मीनो भविष्यामि स्थापयिष्याम्यहं प्रजाः।\nलोकान्वै धारयिष्यामि मज्जमानान्महार्णवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2086702, "chapter_id": 2843, "verse_number": "१२-३४८-४", "content_sanskrit": "द्वितीयः कूर्मरूपो मे हेमकूटनिभः स्मृतः।\nमन्दरं धारयिष्यामि अमृतार्थं द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2086703, "chapter_id": 2843, "verse_number": "१२-३४८-५", "content_sanskrit": "मप्रां महार्णवे घोरे भाराक्रान्तां भुवं पुनः।\nततो बलादहं विद्वन्सर्वभूतहिताय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2086704, "chapter_id": 2843, "verse_number": "१२-३४८-६", "content_sanskrit": "सत्वैराक्रान्तसर्वाङ्गां नष्टां सागरमेखलाम्।\nआनयिष्यामि स्वं स्थानं वाराहं रूपमास्थितः।\nहिरण्याक्षं हनिष्यामि दैतेयं बलगर्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2086705, "chapter_id": 2843, "verse_number": "१२-३४८-७", "content_sanskrit": "नारसिंहं वषुः कृत्वा हिरण्यकशिषुं पुनः।\nसुरकार्ये हनिष्यामि यज्ञघ्नं दितिनन्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2086706, "chapter_id": 2843, "verse_number": "१२-३४८-८", "content_sanskrit": "विरोचनस्य बलवान्बलिः पुत्रो महासुरः।\nअवध्यः सर्वलोकानां सदेवासुररक्षसाम्।\nभविष्यति स शक्रं च स्वराज्याच्च्यावयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2086707, "chapter_id": 2843, "verse_number": "१२-३४८-९", "content_sanskrit": "त्रैलोक्येऽपहृते तेन विमुखे च शचीपतौ।\nअदित्यां द्वादशः पुत्रः संभविष्यामि कश्यपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2086708, "chapter_id": 2843, "verse_number": "१२-३४८-१०", "content_sanskrit": "`वटुर्गत्वा यज्ञसदः स्तूयमानो द्विजोत्तमैः।\nयज्ञस्तुतिं करिष्यामि श्रुत्वा प्रीतो भवेद्वलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2086709, "chapter_id": 2843, "verse_number": "१२-३४८-११", "content_sanskrit": "किमिच्छसि वटो ब्रूहीत्युक्तो याचे महद्वरम्।\nदीयतां त्रिपदीमात्रमिति याचे महाऽऽसुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2086710, "chapter_id": 2843, "verse_number": "१२-३४८-१२", "content_sanskrit": "स दद्यान्मयि संप्रीतः प्रतिषिद्धश्च मन्त्रिभिः।\nयावज्जलं हस्तगतं त्रिभिर्विक्रमणैर्युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2086711, "chapter_id": 2843, "verse_number": "१२-३४८-१३", "content_sanskrit": "ततो राज्यं प्रदास्यामि शक्रायामिततेजसे।\nदेवताः स्थापयिष्यामि स्वस्वस्थानेषु नारद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2086712, "chapter_id": 2843, "verse_number": "१२-३४८-१४", "content_sanskrit": "बलिं चैव करिष्यामि पातालतलवासिनम्।\nदानवं च बलिश्रेष्ठमबध्यं सर्वदैवतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2086713, "chapter_id": 2843, "verse_number": "१२-३४८-१५", "content_sanskrit": "त्रेतायुगे भविष्यामि रामो भृगुकुलोद्वहः।\nक्षत्रं चोत्सादयिष्यामि समृद्धबलवाहनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2086714, "chapter_id": 2843, "verse_number": "१२-३४८-१६", "content_sanskrit": "संधौ तु समनुप्राप्ते त्रेतायां द्वापरस्य च।\nरामो दाशरथिर्भूत्वा भविष्यामि जगत्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2086715, "chapter_id": 2843, "verse_number": "१२-३४८-१७", "content_sanskrit": "त्रितोपघाताद्वैरूप्यमेकतोऽथ द्वितस्तथा।\nप्राप्स्येते वानरत्वं हि प्रजापतिसुतावृषी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2086716, "chapter_id": 2843, "verse_number": "१२-३४८-१८", "content_sanskrit": "तयोर्ये त्वन्वये जाता भविष्यन्ति वनौकसः।\nमहाबला महावीर्याः शक्रतुल्यपराक्रमाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2086717, "chapter_id": 2843, "verse_number": "१२-३४८-१९", "content_sanskrit": "ते सहाया भविष्यन्ति सुरकार्ये मम द्विज॥\nततो रक्षःपतिं घोरं पुलस्त्यकुलपांसनम्।\nहनिष्ये रावणं रौद्रं सगणं लोककण्टकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2086718, "chapter_id": 2843, "verse_number": "१२-३४८-२०", "content_sanskrit": "` विभीषणाय दास्यामि राज्यं तस्य यथाक्रमम्\nअयोध्यावासिनः सर्वान्नेष्येऽहं लोकमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2086719, "chapter_id": 2843, "verse_number": "१२-३४८-२१", "content_sanskrit": "द्वापरस्य कलेश्चैव संधौ पार्यवसानिके।\nप्रादुर्भावः कंसहेतोर्मथुरायां भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2086720, "chapter_id": 2843, "verse_number": "१२-३४८-२२", "content_sanskrit": "तत्राहं दानवान्हत्वा सुबहून्देवकण्टकान्।\nकुशस्थलीं करिष्यासि निवासं द्वारकां पुरीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2086721, "chapter_id": 2843, "verse_number": "१२-३४८-२३", "content_sanskrit": "वसानस्तत्र वै पुर्यामदितेर्विप्रियंकरम्।\nहनिष्ये नरकं भौमं मुरं पीठं च दानवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2086722, "chapter_id": 2843, "verse_number": "१२-३४८-२४", "content_sanskrit": "प्राग्ज्योतिषं पुरं रम्यं नानाधनसमन्वितम्।\nकुशस्थलीं नष्यिष्यामि हत्वा वै दानवोत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2086723, "chapter_id": 2843, "verse_number": "१२-३४८-२५", "content_sanskrit": "`कृकलास भूतं च नृगं मोचयिष्ये च वै पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2086724, "chapter_id": 2843, "verse_number": "१२-३४८-२६", "content_sanskrit": "तत्र पौत्रनिमित्तेन गत्वा वै शोणितं पुरम्।\nवाणस्य च पुरं गत्वा करिष्ये कदनं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2086725, "chapter_id": 2843, "verse_number": "१२-३४८-२७", "content_sanskrit": "शंकरं रमहासेनं बाणप्रियहिते रतम्।\nपराजेष्याम्यथोद्युक्तौ देवौ लोकनमस्कृतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2086726, "chapter_id": 2843, "verse_number": "१२-३४८-२८", "content_sanskrit": "ततः सुतं बलेर्जित्वा बाणं बाहुसहस्त्रिणम्।\nविनाशयिष्यामि ततः सर्वान्सौभनिवासिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2086727, "chapter_id": 2843, "verse_number": "१२-३४८-२९", "content_sanskrit": "यः कालयवनः ख्यातो गर्गतेजोभिसंवृतः।\nभविष्यति वधस्तस्य मत्त एव द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2086728, "chapter_id": 2843, "verse_number": "१२-३४८-३०", "content_sanskrit": "`कंसं केशिं तथाक्रूरमरिष्टं च महासुरम्।\nचाणूरं च महावीर्यं मुष्टिकं च महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2086729, "chapter_id": 2843, "verse_number": "१२-३४८-३१", "content_sanskrit": "प्रलम्बं धेनुकं चैव अरिष्टं वृषरूपिणम्।\nकालीयं च वशे कृत्वा यमुनाया महाह्रदे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2086730, "chapter_id": 2843, "verse_number": "१२-३४८-३२", "content_sanskrit": "गोकुलेषु ततः पश्चाद्भवार्थे तु महागिरिम्।\nसप्तरात्रं धरिष्यामि वर्षमाणे तु वासवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2086731, "chapter_id": 2843, "verse_number": "१२-३४८-३३", "content_sanskrit": "अपक्रान्ते ततो वर्षे गिरिमूर्ध्निं व्यवस्थितः।\nइन्द्रेण सह संवादं करिष्यामि तदा द्विज।\nलघ्वाच्छिद्य धनं सर्वं वासुदेवं च पौण्ड्रकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2086732, "chapter_id": 2843, "verse_number": "१२-३४८-३४", "content_sanskrit": "जरासन्धश्च बलवान्सर्वराजविरोधनः\nभविष्यत्यसुरः स्फीतो भूमिपालो गिरिव्रजे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2086733, "chapter_id": 2843, "verse_number": "१२-३४८-३५", "content_sanskrit": "मम बुद्धिपरिस्पन्दाद्वधस्तस्य भविष्यति।\nशिशुपालं वधिष्यामि यज्ञे धर्मसुतस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2086734, "chapter_id": 2843, "verse_number": "१२-३४८-३६", "content_sanskrit": "`दुर्योधनापराधेन युधिष्ठिरगुणेन च।\nसमागतेषु बलिषु पृथिव्यां सर्वराजसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2086735, "chapter_id": 2843, "verse_number": "१२-३४८-३७", "content_sanskrit": "वासविः सुसहायो वै मम त्वेको भविष्यति।\nयुधिष्ठिरं स्थापयिष्ये स्वराज्ये भ्रातृभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2086736, "chapter_id": 2843, "verse_number": "१२-३४८-३८", "content_sanskrit": "एवं लोका वदिष्यन्ति नरनारायणावृषी।\nउद्युक्तौ दहतः क्षत्रं लोककार्यार्थमीश्वरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2086737, "chapter_id": 2843, "verse_number": "१२-३४८-३९", "content_sanskrit": "`शस्त्रैर्निपतिताः सर्वे नृपा यास्यन्ति वै दिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2086738, "chapter_id": 2843, "verse_number": "१२-३४८-४०", "content_sanskrit": "कृत्वा भारावतरणं वसुधाया यथेप्सितम्।\nसर्वसात्वतमुख्यानां द्वारकायाश्च सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2086739, "chapter_id": 2843, "verse_number": "१२-३४८-४१", "content_sanskrit": "करिष्ये प्रलयं घोरमात्मज्ञानाभिसंश्रयः।\n`द्वारकामात्मसात्कृत्वा समुद्रं गमयाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2086740, "chapter_id": 2843, "verse_number": "१२-३४८-४२", "content_sanskrit": "ततः कलियुगस्यादौ द्विजराजतरुं श्रितः।\nभीषया मागधेनैव धर्मराजगृहे वसन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2086741, "chapter_id": 2843, "verse_number": "१२-३४८-४३", "content_sanskrit": "काषायवस्रसंवीतो मुण्डितः शुक्लदन्तवान्।\nशुद्धोदनसुतो बुद्धो मोहयिष्यामि मानवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2086742, "chapter_id": 2843, "verse_number": "१२-३४८-४४", "content_sanskrit": "शूद्राः सुद्धेषु भुज्यन्ते मयि बुद्धत्वमागते।\nभविष्यन्ति नराः सर्वे बुद्धाः काषायसंवृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2086743, "chapter_id": 2843, "verse_number": "१२-३४८-४५", "content_sanskrit": "अनध्याया भविष्यन्ति विप्रा यागविवर्जिताः।\nअग्निहोत्राणि सीदन्ति गुरुपूजा च नश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2086744, "chapter_id": 2843, "verse_number": "१२-३४८-४६", "content_sanskrit": "न शृण्वन्ति पितुः पुत्रा न स्नुषा नैव भ्रातरः।\nन पौत्रा न कलत्रा वा वर्तन्तेऽप्यधमोत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2086745, "chapter_id": 2843, "verse_number": "१२-३४८-४७", "content_sanskrit": "एवंभूतं जगत्सर्वं श्रुतिस्मृतिविवर्जितम्।\nभविष्यति कलौ पूर्णे ह्यशुद्धो धर्मसंकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2086746, "chapter_id": 2843, "verse_number": "१२-३४८-४८", "content_sanskrit": "तेषां सकाशाद्धर्मज्ञा देवब्रह्मविदो नराः।\nभविष्यन्ति ह्यशुद्धाश्च न्यायच्छलविभाषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2086747, "chapter_id": 2843, "verse_number": "१२-३४८-४९", "content_sanskrit": "ये नष्टधर्मश्रोतारस्ते समाः पापनिश्चये।\nतस्मादेता न संभाष्या न स्पृश्या च हितार्थिभिः।\nउपवासत्रयं कुर्यात्तत्संसर्गविशुद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2086748, "chapter_id": 2843, "verse_number": "१२-३४८-५०", "content_sanskrit": "ततः कलियुगस्यान्ते ब्राह्मणो हरिपिङ्गलः।\nकल्किर्विष्णुयशः पुत्रो याज्ञवल्क्यः पुरोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2086749, "chapter_id": 2843, "verse_number": "१२-३४८-५१", "content_sanskrit": "तस्मिन्नाशे वनग्रामे तिष्ठेत्सोन्नासिमो हयः।\nसहया ब्राह्मणाः सर्वे तैरहं सहितः पुनः।\nम्लेच्छानुत्सादयिष्यामि पाषण़्डांश्चैव सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2086750, "chapter_id": 2843, "verse_number": "१२-३४८-५२", "content_sanskrit": "पाषण्डश्च कलौ तत्र माययैव विनश्यते।\nपाषण़्डकांश्चैव हत्वा तत्रान्तं प्रलये ह्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2086751, "chapter_id": 2843, "verse_number": "१२-३४८-५३", "content_sanskrit": "ततः पश्चाद्भविष्यामि यज्ञेषु निरतः सदा।\nराज्यं प्रशासति पुनः कुन्तीपुत्र युधिष्ठिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2086752, "chapter_id": 2843, "verse_number": "१२-३४८-५४", "content_sanskrit": "कर्माण्यपरिमेयानि चतुर्मूर्तिधरो ह्यहम्।\nकृत्वा लोकान्गमिष्यामि स्वानहं ब्रह्मसत्कृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2086753, "chapter_id": 2843, "verse_number": "१२-३४८-५५", "content_sanskrit": "हंसः कूर्मश्च मत्स्यश्च प्रादुर्भावा द्विजोत्तम।\nवराहो नरसिंहश्च वामनो राम एव च।\nरामो दाशरथिश्चैव सात्वतः कल्किरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2086754, "chapter_id": 2843, "verse_number": "१२-३४८-५६", "content_sanskrit": "यदा वेदश्रुतिर्नष्टा मया प्रत्याहृता पुनः।\nसर्वदाः सश्रुतीकाश्च कृताः पूर्वं कृते युगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2086755, "chapter_id": 2843, "verse_number": "१२-३४८-५७", "content_sanskrit": "अतिक्रान्ताः पुराणेषु श्रुतास्ते यदि वा क्वचित्।\nअतिक्रान्ताश्च बहवः प्रादुर्भावा ममोत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2086756, "chapter_id": 2843, "verse_number": "१२-३४८-५८", "content_sanskrit": "लोककार्याणि कृत्वा च पुनः स्वां प्रकृतिं गताः।\nन ह्येतद्ब्रह्मणा प्राप्तमीदृशं मम दर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2086757, "chapter_id": 2843, "verse_number": "१२-३४८-५९", "content_sanskrit": "यत्त्वया प्राप्तमद्येह एकान्तगतबुद्धिना।\nएतत्ते सर्वमाख्यातं ब्रह्मन्भक्तिमतो मया।\nपुराणं च भविष्यं च सरहस्यं च सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2086758, "chapter_id": 2843, "verse_number": "१२-३४८-६०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2086759, "chapter_id": 2843, "verse_number": "१२-३४८-६०", "content_sanskrit": "एवं स भगवान्देवो विश्वमूर्तिधरोऽव्ययः।\nएतावदुक्त्वा वचनं तत्रैवान्तर्दधे पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2086760, "chapter_id": 2843, "verse_number": "१२-३४८-६१", "content_sanskrit": "नारदोऽपि महातेजाः प्राप्यानुग्रहमीप्सितम्।\nनरनारायणौ द्रष्टुं बदर्याश्रममाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2086761, "chapter_id": 2843, "verse_number": "१२-३४८-६२", "content_sanskrit": "इदं महोपनिषदं चतुर्वेदसमन्वितम्।\nसांख्ययोगकृतं तेन पञ्चरात्रानुशब्दितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2086762, "chapter_id": 2843, "verse_number": "१२-३४८-६३", "content_sanskrit": "नारायंणमुखोदीतं नारदोऽश्रावयत्पुनः।\nब्रह्मणः सदने तात यथादृष्टं यथाश्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2086763, "chapter_id": 2843, "verse_number": "१२-३४८-६४x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2086764, "chapter_id": 2843, "verse_number": "१२-३४८-६४", "content_sanskrit": "एतदाश्चर्यभूतं हि माहात्म्यं तस्य धीमतः।\nकिं वै ब्रह्मा न जानीते यतः शुश्राव नारदात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2086765, "chapter_id": 2843, "verse_number": "१२-३४८-६५", "content_sanskrit": "पितामहोऽपि भगवांस्तस्माद्देवादनन्तरः।\nकथं स न विजानीयात्प्रभावममितौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2086766, "chapter_id": 2843, "verse_number": "१२-३४८-६६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2086767, "chapter_id": 2843, "verse_number": "१२-३४८-६६", "content_sanskrit": "महाकल्पसहस्राणि महाकल्पशतानि च।\nसमतीतानि राजेन्द्र सर्गाश्च प्रलयाश्च ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2086768, "chapter_id": 2843, "verse_number": "१२-३४८-६७", "content_sanskrit": "सर्गस्यादौ स्मृतो ब्रह्मा प्रजासर्गकरः प्रभुः।\nजानाति देवप्रवरं भूयश्चातोधिकं नृप।\nपरमात्मानमीशानमात्मनः प्रभवं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2086769, "chapter_id": 2843, "verse_number": "१२-३४८-६८", "content_sanskrit": "ये त्वन्ये ब्रह्मसदने सिद्धसङ्घाः समागताः।\nतेभ्यस्तच्छ्रावयामास पुराणं वेदसंमितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2086770, "chapter_id": 2843, "verse_number": "१२-३४८-६९", "content_sanskrit": "अष्टाविंशत्सहस्राणि ऋषीणां भावितात्मनाम्।\nआत्मानुगामिनां ब्रह्मा श्रावयामास तत्वतः।\nएवं पुरा प्राप्तमिदं भानुना मुनिभाषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2086771, "chapter_id": 2843, "verse_number": "१२-३४८-७०", "content_sanskrit": "वर्षषष्टिसहस्राणि षष्टिवर्षशतानि च।\nसूर्यस्य तपतो लोकान्निर्मिता ये पुरःसराः।\nतेषामकथयत्सूर्यः सर्वेषां भावितात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2086772, "chapter_id": 2843, "verse_number": "१२-३४८-७१", "content_sanskrit": "सूर्यानुगामिभिस्तात ऋषिभिस्तैर्महात्मभिः।\nमेरौ समागता देवाः श्राविताश्चेदनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2086773, "chapter_id": 2843, "verse_number": "१२-३४८-७२", "content_sanskrit": "देवानां तु सकाशाद्वै ततः श्रुत्वाऽसितो द्विजः।\nश्रावयामास राजेन्द्र पितॄन्वै मुनिसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2086774, "chapter_id": 2843, "verse_number": "१२-३४८-७३", "content_sanskrit": "मम चापि पिता तात कथयामास शंतनुः।\nततो मयापि श्रुत्वा च कीर्तितं तव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2086775, "chapter_id": 2843, "verse_number": "१२-३४८-७४", "content_sanskrit": "सुरैर्वा मुनिभिर्वापि पुराणं यैरिदं श्रुतम्।\nसर्वे ते परमात्मानं पूजयन्ते समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2086776, "chapter_id": 2843, "verse_number": "१२-३४८-७५", "content_sanskrit": "इदमाख्यानमार्षेयं पारम्पर्यागतं नृप।\nनावासुदेवभक्ताय त्वया देयं कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2086777, "chapter_id": 2843, "verse_number": "१२-३४८-७६", "content_sanskrit": "`आख्यानमुत्तमं चेदं श्रावयेद्यः सदा नृप।\nतदैव मनुजो भक्तः शुचिर्भूत्वा समाहितः।\nप्राप्नुयादचिराद्राजन्विष्णुलोकं च शाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2086778, "chapter_id": 2843, "verse_number": "१२-३४८-७७", "content_sanskrit": "मत्तोन्यानि च ते राजन्नुपाख्यानशतानि वै।\nयानि श्रुतानि सर्वाणि तेषां सारोयमुद्धृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2086779, "chapter_id": 2843, "verse_number": "१२-३४८-७८", "content_sanskrit": "सुरासुरैर्यथा राजन्निर्मथ्यामृतमुद्धृतम्।\nएवमेतत्पुरा विप्रैः कथामृतमिहोद्धृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2086780, "chapter_id": 2843, "verse_number": "१२-३४८-७९", "content_sanskrit": "यश्चेदं पठते नित्यं यश्चेदं शृणुयान्नरः।\nएकान्तभावोपगत एकान्ते सुसमाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2086781, "chapter_id": 2843, "verse_number": "१२-३४८-८०", "content_sanskrit": "प्राप्य श्वेतं महाद्वीपं भूत्वा चन्द्रप्रभो नरः।\nस सहस्रार्चिपं देवं प्रविशेन्नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2086782, "chapter_id": 2843, "verse_number": "१२-३४८-८१", "content_sanskrit": "मुच्येदार्तस्तथा रोगाच्छ्रुत्वेमामादितः कथाम्।\nजिज्ञासुर्लभते कामान्भक्तो भक्तगतिं व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2086783, "chapter_id": 2843, "verse_number": "१२-३४८-८२", "content_sanskrit": "त्वयापि सततं राजत्रभ्यर्च्यः पुरुषोत्तमः।\nस हि माता पिता चैव कृत्स्नस्य जगतो गुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2086784, "chapter_id": 2843, "verse_number": "१२-३४८-८३", "content_sanskrit": "ब्रह्मण्यदेवो भगवान्प्रीयतां ते सनातनः।\nयुधिष्ठिर महाबाहो महाबुद्धिर्जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2086785, "chapter_id": 2843, "verse_number": "१२-३४८-८४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2086786, "chapter_id": 2843, "verse_number": "१२-३४८-८४", "content_sanskrit": "श्रुत्वैतदाख्यानवरं धर्मराड्जनमेजय।\nभ्रातरश्चास्य ते सर्वे नारायणपराभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2086787, "chapter_id": 2843, "verse_number": "१२-३४८-८५", "content_sanskrit": "जितं भगवता तेन पुरुषेणेति भारत।\nनित्यं जप्यपरा भूत्वा सारस्वतमुदीरयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2086788, "chapter_id": 2843, "verse_number": "१२-३४८-८६", "content_sanskrit": "यो ह्यस्माकं गुरुः श्रेष्ठः कृष्णद्वैपायनो मुनिः।\nजगौ परमकं जप्यं नारायणमुदीरयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2086789, "chapter_id": 2843, "verse_number": "१२-३४८-८७", "content_sanskrit": "गत्वान्तरिक्षात्सततं क्षीरोदममृताशयम्।\nपूजयित्वा च देवेशं पुनरायात्स्वगाश्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2086790, "chapter_id": 2843, "verse_number": "१२-३४८-८८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2086791, "chapter_id": 2843, "verse_number": "१२-३४८-८८", "content_sanskrit": "एतत्ते सर्वमाख्यातं नारदोक्तं मयेरितम्।\nपारम्पर्यागतं ह्येतत्पित्रा मे कथितं पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2086792, "chapter_id": 2843, "verse_number": "१२-३४८-८९x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2086793, "chapter_id": 2843, "verse_number": "१२-३४८-८९", "content_sanskrit": "एतत्ते सर्वमाख्यातं वैशम्पायनकीर्तितम्।\nजनमेजयेन तच्छ्रुत्वा कृतं सम्यग्यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2086794, "chapter_id": 2843, "verse_number": "१२-३४८-९०", "content_sanskrit": "यूयं हि तप्ततपसः सर्वे च चरितव्रताः।\nशौनकस्य महासत्रं प्राप्ताः सर्वे द्विजोत्तमाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2086795, "chapter_id": 2843, "verse_number": "१२-३४८-९१", "content_sanskrit": "यजध्वं सुहुतैर्यज्ञैः शाश्वतं परमेश्वरम्।\nपारम्पर्यागतं ह्येतत्पित्रा मे कथितं पुरा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2086796, "chapter_id": 2843, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि नारायणीये अष्टचत्वारिंशदधिकत्रिशततमोऽध्यायः॥ ३४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}]