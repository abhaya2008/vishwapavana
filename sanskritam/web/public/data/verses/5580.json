[{"id": 2214256, "chapter_id": 5580, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2214257, "chapter_id": 5580, "verse_number": "१", "content_sanskrit": "ततः सन्नादयन् शक्रो दिवं भूमिं च सर्वशः ।\nरथेनोपययौ पार्थमारोहेत्यब्रवीच्च तम्\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2214258, "chapter_id": 5580, "verse_number": "२", "content_sanskrit": "स्वभ्रातॄन् पतितान् दृष्ट्वा धर्मराजो युधिष्ठिरः ।\nअब्रवीच्छोकसन्तप्तः सहस्राक्षमिदं वचः\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2214259, "chapter_id": 5580, "verse_number": "", "content_sanskrit": "धर्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2214260, "chapter_id": 5580, "verse_number": "३", "content_sanskrit": "भ्रातरः पतिता मेऽत्र गच्छेयुस्ते मया सह ।\nन विना भ्रातृभिः स्वर्गमिच्छे गन्तुं सुरेश्वर\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2214261, "chapter_id": 5580, "verse_number": "४", "content_sanskrit": "सुकुमारी सुखार्हा च राजपुत्री पुरन्दर ।\nसाऽस्माभिः सह गच्छेत तद्भवाननुमन्यताम्\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2214262, "chapter_id": 5580, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2214263, "chapter_id": 5580, "verse_number": "५", "content_sanskrit": "भ्रातॄन् द्रक्ष्यसि स्वर्गे त्वमग्रतस्त्रिदिवं गतान् ।\nकृष्णया सहितान् सर्वान् मा शुचो भरतर्षभ\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2214264, "chapter_id": 5580, "verse_number": "६", "content_sanskrit": "निक्षिप्य मानुषं देहं गतास्ते भरतर्षभ ।\nअनेन त्वं शरीरेण स्वर्गं गन्ता न संशयः\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2214265, "chapter_id": 5580, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2214266, "chapter_id": 5580, "verse_number": "७", "content_sanskrit": "अयं श्वा भूतभव्येश भक्तो मां नित्यमेव ह ।\nस गच्छेत मया सार्धमानृशंस्या हि मे मतिः\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2214267, "chapter_id": 5580, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2214268, "chapter_id": 5580, "verse_number": "८", "content_sanskrit": "अमर्त्यत्वं मत्समत्वं च राजन्\nश्रियं कृत्स्नां महतीं चैव सिद्धिम् ।\nसम्प्राप्तोद्य स्वर्गसुखानि च त्वं\nत्यज श्वानं नात्र नृशंसमस्ति\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2214269, "chapter_id": 5580, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2214270, "chapter_id": 5580, "verse_number": "९", "content_sanskrit": "अनार्यमार्येण सहस्रनेत्र\nशक्यं कर्तुं दुष्करमेतदार्य ।\nमा मे श्रिया सङ्गमनं तयाऽस्तु\nयस्याः कृते भक्तजनं त्यजेयम्\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2214271, "chapter_id": 5580, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2214272, "chapter_id": 5580, "verse_number": "", "content_sanskrit": "स्वर्गे लोके श्ववतां नास्ति धिष्ण्य-\nमिष्टापूर्तं क्रोधवशा हरन्ति ।\nततो विचार्य क्रियतां धर्मराज\nत्यज श्वानं नात्र नृशंसमस्ति\t ॥१०॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2214273, "chapter_id": 5580, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2214274, "chapter_id": 5580, "verse_number": "११", "content_sanskrit": "भक्तत्यागं प्राहुरत्यन्तपापं\nतुल्यं लोके ब्रह्मवध्याकृतेन ।\nतस्मान्नाहं जातु कथञ्चनाद्य\nत्यक्ष्याम्येनं स्वसुखार्थी महेन्द्र\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2214275, "chapter_id": 5580, "verse_number": "१२", "content_sanskrit": "भीतं भक्तं नान्यदस्तीति चार्तं\nप्राप्तं क्षीणं रक्षणे प्राणलिप्सुम् ।\nप्राणत्यागादप्यहं नैव मोक्तुं\nयतेयं वै नित्यमेतद् व्रतं मे\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2214276, "chapter_id": 5580, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2214277, "chapter_id": 5580, "verse_number": "१३", "content_sanskrit": "शुना दृष्टं क्रोधवशा हरन्ति\nयद्दत्तमिष्टं विवृतमथो हुतं च ।\nतस्माच्छुनस्त्यागमिमं कुरुष्व\nशुनस्त्यागात् प्राप्स्यसे देवलोकम्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2214278, "chapter_id": 5580, "verse_number": "१४", "content_sanskrit": "त्यक्त्वा भ्रातॄन् दयितां चापि कृष्णां\nप्राप्तो लोकः कर्मणा स्वेन वीर ।\nश्वानं चैनं न त्यजसे कथं नु\nत्यागं कृत्स्नं चास्थितो मुह्यसेऽद्य\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2214279, "chapter_id": 5580, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2214280, "chapter_id": 5580, "verse_number": "१५", "content_sanskrit": "न विद्यते सन्धिरथापि विग्रहो\nमृतैर्मर्त्यैरिति लोकेषु निष्ठा ।\nन ते मया जीवयितुं हि शक्याः\nततस्त्यागस्तेषु कृतो न जीवताम्\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2214281, "chapter_id": 5580, "verse_number": "१६", "content_sanskrit": "प्रतिप्रदानं शरणागतस्य\nस्त्रिया वधो ब्राह्मणस्वापहारः ।\nमित्रद्रोहस्तानि चत्वारि शक्र\nभक्तत्यागश्चैव समो मतो मे\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2214282, "chapter_id": 5580, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2214283, "chapter_id": 5580, "verse_number": "१७", "content_sanskrit": "तद्धर्मराजस्य वचो निशम्य\nधर्मस्वरूपी भगवानुवाच ।\nयुधिष्ठिरं प्रीतियुक्तो नरेन्द्रं\nश्लक्ष्णैर्वाक्यैः संस्तवसम्प्रयुक्तैः\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2214284, "chapter_id": 5580, "verse_number": "१८", "content_sanskrit": "अभिजातोसि राजेन्द्र पितुर्वृत्तेन मेधया ।\nअनुक्रोशेन चानेन सर्वभूतेषु भारत\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2214285, "chapter_id": 5580, "verse_number": "१९", "content_sanskrit": "पुरा द्वैतवने चासि मया पुत्र परीक्षितः ।\nपानीयार्थे पराक्रान्ता यत्र ते भ्रातरो हताः\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2214286, "chapter_id": 5580, "verse_number": "२०", "content_sanskrit": "भीमार्जुनौ परित्यज्य यत्र त्वं भ्रातरावुभौ ।\nमात्रोः साम्यमभीप्सन् वै नकुलं जीवमिच्छसि\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2214287, "chapter_id": 5580, "verse_number": "२१", "content_sanskrit": "अयं श्वा भक्त इत्येवं त्यक्तो देवरथस्त्वया ।\nतस्मात् स्वर्गे न ते तुल्यः कश्चिदस्ति नराधिपः\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2214288, "chapter_id": 5580, "verse_number": "२२", "content_sanskrit": "अतस्तवाक्षया लोकाः स्वशरीरेण भारत ।\nप्राप्तोसि भरतश्रेष्ठ दिव्यां गतिमनुत्तमाम्\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2214289, "chapter_id": 5580, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2214290, "chapter_id": 5580, "verse_number": "२३", "content_sanskrit": "ततो धर्मश्च शक्रश्च मरुतश्चाश्विनावपि ।\nदेवा देवर्षयश्चैव रथमारोप्य पाण्डवम्\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2214291, "chapter_id": 5580, "verse_number": "२४", "content_sanskrit": "प्रययुः स्वैर्विमानैस्ते सिद्धाः कामविहारिणः ।\nसर्वे विरजसः पुण्याः पुण्यवाग् बुद्धिकर्मिणः\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2214292, "chapter_id": 5580, "verse_number": "२५", "content_sanskrit": "स तं रथं समास्थाय राजा कुरुकुलोद्वहः ।\nऊर्ध्वमाचक्रमे शीघ्रं तेजसाऽऽवृत्य रोदसी\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2214293, "chapter_id": 5580, "verse_number": "२६", "content_sanskrit": "ततो देवनिकाय्यस्थो नारदः सर्वलोकवित् ।\nउवाचोच्चैस्तदा वाक्यं बृहद्वादी बृहत्तपाः\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2214294, "chapter_id": 5580, "verse_number": "२७", "content_sanskrit": "येऽपि राजर्षयः पूर्वे ते चापि समुपस्थिताः ।\nकीर्तिं प्रच्छाद्य तेषां वै कुरुराजोऽधितिष्ठति\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2214295, "chapter_id": 5580, "verse_number": "२८", "content_sanskrit": "लोकानावृत्य यशसा तेजसा वृत्तसम्पदा ।\nस्वशरीरेण सम्प्राप्तं नान्यं शुश्रुम पाण्डवात्\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2214296, "chapter_id": 5580, "verse_number": "", "content_sanskrit": "(तेजांसि यानि दृष्टानि भूमिष्ठेन त्वया विभो ।\nवेश्मानि भुवि देवानां पश्यामूनि सहस्रशः\t ॥२९॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2214297, "chapter_id": 5580, "verse_number": "३०", "content_sanskrit": "नारदस्य वचः श्रुत्वा राजा वचनमब्रवीत् ।\nभ्रातॄनपश्यन् धर्मात्मा स्वपक्षांश्चैव पार्थिवान्\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2214298, "chapter_id": 5580, "verse_number": "३१", "content_sanskrit": "शुभं वा यदि वा पापं भ्रातॄणां स्थानमद्य मे ।\nतदेव प्राप्तुमिच्छामि लोकानन्यान्न कामये\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2214299, "chapter_id": 5580, "verse_number": "३२", "content_sanskrit": "राज्ञस्तु वचनं श्रुत्वा देवराजः पुरन्दरः ।\nआनृशंस्यसमायुक्तं प्रत्युवाच युधिष्ठिरम्\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2214300, "chapter_id": 5580, "verse_number": "३३", "content_sanskrit": "स्थानेऽस्मिन् वस राजेन्द्र कर्मभिर्निर्जिते शुभैः ।\nकिं त्वं मानुष्यकं स्नेहमद्यापि परिकर्षसि\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2214301, "chapter_id": 5580, "verse_number": "३४", "content_sanskrit": "सिद्धिं प्राप्तोसि परमां यथा नान्यः पुमान् क्वचित् ।\nनैव ते भ्रातरः स्थानं सम्प्राप्ताः कुरुनन्दन\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2214302, "chapter_id": 5580, "verse_number": "३५", "content_sanskrit": "अद्यापि मानुषो भावः स्पृशते त्वां नराधिप ।\nस्वर्गोऽयं पश्य देवर्षीन् सिद्धांश्च त्रिदिवालयान्\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2214303, "chapter_id": 5580, "verse_number": "३६", "content_sanskrit": "युधिष्ठिरस्तु देवेन्द्रमेवंवादिनमीश्वरम् ।\nपुनरेवाब्रवीद्धीमानिदं वचनमर्थवत्\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2214304, "chapter_id": 5580, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2214305, "chapter_id": 5580, "verse_number": "३७", "content_sanskrit": "तैर्विना नोत्सहे वस्तुमिह दैत्यनिबर्हण ।\nगन्तुमिच्छामि तत्राहं यत्र मे भ्रातरो गताः\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2214306, "chapter_id": 5580, "verse_number": "३८", "content_sanskrit": "यत्र सा बृहती श्यामा बुद्धिसत्त्वगुणान्विता ।\nद्रौपदी योषितां श्रेष्ठा यत्र चैव सुता मम\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2214307, "chapter_id": 5580, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् महाप्रस्थानिकपर्वणि\nइन्द्रयुधिष्ठिरसंवादो नाम चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2214308, "chapter_id": 5580, "verse_number": "", "content_sanskrit": "॥ समाप्तं महाप्रस्थानिकपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2214309, "chapter_id": 5580, "verse_number": "", "content_sanskrit": "॥ श्रीमद्धनुमद्भीममध्वान्तर्गतनरहरिरामकृष्णवेदव्यासाय नमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]