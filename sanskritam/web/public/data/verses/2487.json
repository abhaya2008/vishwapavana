[{"id": 2070720, "chapter_id": 2487, "verse_number": "११-१९-०x", "content_sanskrit": "गान्धार्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070721, "chapter_id": 2487, "verse_number": "११-१९-१", "content_sanskrit": "एष माधव पुत्रो मे विकर्णः पाज्ञसम्मतः।\nभूमौ विनिहतः शेते भीमेन शतधा कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070722, "chapter_id": 2487, "verse_number": "११-१९-२", "content_sanskrit": "गजमध्ये हतः शेते विकर्णो मधुसूदन।\nनीलमेघपरिक्षिप्तः शरदीव निशाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070723, "chapter_id": 2487, "verse_number": "११-१९-३", "content_sanskrit": "अस्य चापग्रहेणैव पाणिः कृतकिणो महान्।\nकथञ्चिच्छिद्यते गृध्रैरत्तुकामैस्तलत्रवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070724, "chapter_id": 2487, "verse_number": "११-१९-४", "content_sanskrit": "अस्य भार्याऽऽमिषप्रेप्सून्गृध्रकाकांस्तपस्विनी।\nवारयत्यनिशं बाला न च शक्नोति माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070725, "chapter_id": 2487, "verse_number": "११-१९-५", "content_sanskrit": "युवा वृन्दारकसमो विकर्णः पुरुषर्षभ।\nसुखोषितः सुखार्हश्च शेते पांसुषु माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070726, "chapter_id": 2487, "verse_number": "११-१९-६", "content_sanskrit": "कर्णिनालीकनाराचैर्भिन्नमर्माणमाहवे।\nअद्यापि न जहात्येनं लक्ष्मीर्भरतसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070727, "chapter_id": 2487, "verse_number": "११-१९-७", "content_sanskrit": "एष सङ्ग्रामशूरणे प्रतिज्ञां पालयिष्यता।\nदुर्मुखोऽभिमुखः शेते हतोऽरिगणहा रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070728, "chapter_id": 2487, "verse_number": "११-१९-८", "content_sanskrit": "तस्यैतद्वदनं कृष्ण श्वापदैरर्धभक्षितम्।\nविभात्यभ्यधिकं तात सप्तम्यामिव चन्द्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070729, "chapter_id": 2487, "verse_number": "११-१९-९", "content_sanskrit": "शूरस्य हि रणे कृष्ण पश्याननमथेदृशम्।\nस कथं निहतोऽमित्रैः पांसून्ग्रसति मे सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070730, "chapter_id": 2487, "verse_number": "११-१९-१०", "content_sanskrit": "यस्याहवमुखे सौम्य स्थाता नैवोपपद्यते।\nस कथं दुर्मुखोऽमित्रैर्हतो विबुधलोकजित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070731, "chapter_id": 2487, "verse_number": "११-१९-११", "content_sanskrit": "चित्रसेनं हतं भूमौ शयानं मधुसूदन।\nधार्तराष्ट्रमिमं पश्य प्रतिमानं धनुष्मताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070732, "chapter_id": 2487, "verse_number": "११-१९-१२", "content_sanskrit": "तं चित्रमाल्याभरणं युवत्यः शोककर्शिताः।\nक्रव्यादसङ्घैः सहिता रुदन्त्यः पर्युपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070733, "chapter_id": 2487, "verse_number": "११-१९-१३", "content_sanskrit": "स्त्रीणां रुदितनिर्घोषः श्वापदानां च गर्जितम्।\nचित्ररूपमिदं कृष्ण विमृश्य प्रतिभाति मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070734, "chapter_id": 2487, "verse_number": "११-१९-१४", "content_sanskrit": "युवा वृन्दारको नित्यं प्रवरस्त्रीनिषेवितः।\nविविंशतिरसौ शेते ध्वस्तः पांसुषु माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070735, "chapter_id": 2487, "verse_number": "११-१९-१५", "content_sanskrit": "शरसङ्कृत्तवर्माणं वीरं विशसने हतम्।\nपरिवार्यासते गृध्राः परिविंशं विविंशतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070736, "chapter_id": 2487, "verse_number": "११-१९-१६", "content_sanskrit": "प्रविश्य समरे शूरः पाण्डवानामनीकिनीम्।\nस वीरशयने शेते परः सत्पुरुषोचिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070737, "chapter_id": 2487, "verse_number": "११-१९-१७", "content_sanskrit": "स्मितोपपन्नं सुनसं सुभ्रु ताराधिपोपमम्।\nअतीव सौम्यवदनं कृष्ण पश्य विविंशतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070738, "chapter_id": 2487, "verse_number": "११-१९-१८", "content_sanskrit": "यं स्म तं पर्युपासन्ते बहुधा वरयोषितः।\nक्रीडन्तमिव गन्धर्वं देवकन्याः सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070739, "chapter_id": 2487, "verse_number": "११-१९-१९", "content_sanskrit": "हन्तारं परसैन्यानां शूरं समितिशोभनम्।\nनिबर्हणममित्राणां दुःसहं विषहेत कः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2070740, "chapter_id": 2487, "verse_number": "११-१९-२०", "content_sanskrit": "दुःसहस्यैतदाभाति शरीरं संवृतं शरैः।\nगिरिरात्मरुहैः फुल्लैः कर्णिकारैरिवाचितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070741, "chapter_id": 2487, "verse_number": "११-१९-२१", "content_sanskrit": "शातकौम्भ्या स्रजा भाति कवचेन च भास्वता।\nअग्निनेव गिरिः श्वेतो गतासुरपि दुःसहः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070742, "chapter_id": 2487, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि स्त्रीविलापपर्वणि एकोनविंशोऽध्यायः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]