[{"id": 7000437000, "chapter_id": 20437, "verse_number": "२-१०९-१", "content_sanskrit": "कुंजल उवाच ।\nप्रणिपत्य प्रसाद्यैव वशिष्ठं तपतां वरम् ।\nआमंत्र्य निर्जगामाथ बाणपाणिर्धनुर्धरः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000437001, "chapter_id": 20437, "verse_number": "२-१०९-२", "content_sanskrit": "एणस्य मांसं सुविपाच्यभोजितं बालस्तया रक्षित एव बुद्ध्या ।\nआयोः सुपुत्रः सगुणः सुरूपो देवोपमो देवगुणैश्च युक्तः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000437002, "chapter_id": 20437, "verse_number": "२-१०९-३", "content_sanskrit": "तेनैव मांसेन सुसंस्कृतेन मृष्टेन पक्वेन रसानुगेन ।\nतमेव दैत्यं परिभाष्य सूदो दुष्टं सुहर्षेण व्यभोजयत्तदा॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000437003, "chapter_id": 20437, "verse_number": "२-१०९-४", "content_sanskrit": "बुभुजे दानवो मांसं रसस्वादुसमन्वितम् ।\nहर्षेणापि समाविष्टो जगामाशोकसुंदरीम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000437004, "chapter_id": 20437, "verse_number": "२-१०९-५", "content_sanskrit": "तामुवाच ततस्तूर्णं कामोपहतचेतनः ।\nआयुपुत्रो मया भद्रे भक्षितः पतिरेव ते॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000437005, "chapter_id": 20437, "verse_number": "२-१०९-६", "content_sanskrit": "मामेव भज चार्वंगि भुंक्ष्व भोगान्मनोनुगान् ।\nकिं करिष्यसि तेन त्वं मानुषेण गतायुषा॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000437006, "chapter_id": 20437, "verse_number": "२-१०९-७", "content_sanskrit": "प्रत्युवाच समाकर्ण्य शिवकन्या तपस्विनी ।\nभर्ता मे दैवतैर्दत्तो अजरो दोषवर्जितः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000437007, "chapter_id": 20437, "verse_number": "२-१०९-८", "content_sanskrit": "तस्य मृत्युर्न वै दृष्टो देवैरपि महात्मभिः ।\nएवमाकर्ण्य तद्वाक्यं दानवो दुष्टचेष्टितः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000437008, "chapter_id": 20437, "verse_number": "२-१०९-९", "content_sanskrit": "तामुवाच विशालाक्षीं प्रहस्यैव पुनः पुनः ।\nअद्यैव भक्षितं मांसमायुपुत्रस्य सुंदरि॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000437009, "chapter_id": 20437, "verse_number": "२-१०९-१०", "content_sanskrit": "जातमात्रस्य बालस्य नहुषस्य दुरात्मनः ।\nएवमाकर्ण्य सा वाक्यं कोपं चक्रे सुदारुणम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000437010, "chapter_id": 20437, "verse_number": "२-१०९-११", "content_sanskrit": "प्रोवाच सत्यसंस्था सा तपसा भाविता पुनः ।\nतप एव मया तप्तं मनसा नियमेन वै ।\nआयुसुतश्चिरायुश्च सत्येनैव भविष्यति॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000437011, "chapter_id": 20437, "verse_number": "२-१०९-१२", "content_sanskrit": "इतो गच्छ दुराचार यदि जीवितुमिच्छसि ।\nअन्यथा त्वामहं शप्स्ये पुनरेव न संशयः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000437012, "chapter_id": 20437, "verse_number": "२-१०९-१३", "content_sanskrit": "एवमाकर्णितं तस्याः सूदेन नृपतिं प्रति ।\nपरित्यज्य महाराज एतामन्यां समाश्रय॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000437013, "chapter_id": 20437, "verse_number": "२-१०९-१४", "content_sanskrit": "सूदेन प्रेषितो दैत्यः स हुंडः पापचेतनः ।\nनिर्जगाम त्वरायुक्तः स स्वां भार्यां प्रियां प्रति॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000437014, "chapter_id": 20437, "verse_number": "२-१०९-१५", "content_sanskrit": "चेष्टितं नैव जानाति दास्या सूदेन यत्कृतम् ।\nतस्यै निवेदितं सर्वं प्रियायै वृत्तमेव च॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000437015, "chapter_id": 20437, "verse_number": "२-१०९-१६", "content_sanskrit": "सूत उवाच ।\nअशोकसुंदरी सा च महता तपसा किल ।\nदुःखशोकेन संतप्ता कृशीभूता तपस्विनी॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000437016, "chapter_id": 20437, "verse_number": "२-१०९-१७", "content_sanskrit": "चिंतयंती प्रियं कांतं तं ध्यायति पुनः पुनः ।\nकिं न कुर्वंति वै दैत्या उपायैर्विविधैरपि॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000437017, "chapter_id": 20437, "verse_number": "२-१०९-१८", "content_sanskrit": "उपायज्ञाः सदा बुद्ध्या उद्यमेनापि सर्वदा ।\nवर्तंते दनुजश्रेष्ठा नानाभावैश्च सर्वदा॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000437018, "chapter_id": 20437, "verse_number": "२-१०९-१९", "content_sanskrit": "मायोपायेन योगेन हृताहं पापिना पुरा ।\nतथा स घातितः पुत्र आयोश्चैव भविष्यति॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000437019, "chapter_id": 20437, "verse_number": "२-१०९-२०", "content_sanskrit": "यं दृष्ट्वा दैवयोगेन भवितारमनामयम् ।\nउद्यमेनापि पश्येत किं वा नश्यति वा न वा॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000437020, "chapter_id": 20437, "verse_number": "२-१०९-२१", "content_sanskrit": "किं वा स उद्यमः श्रेष्ठः किं वा तत्कर्मजं फलम् ।\nभाविभावः कथं नश्येत्ततो वेदः प्रतिष्ठति॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000437021, "chapter_id": 20437, "verse_number": "२-१०९-२२", "content_sanskrit": "विशेषो भावितो देवैः स कथं चान्यथा भवेत् ।\nएवमेवं महाभागा चिंतयंती पुनः पुनः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000437022, "chapter_id": 20437, "verse_number": "२-१०९-२३", "content_sanskrit": "किन्नरो विद्वरो नाम बृहद्वंशोमहातनुः ।\nसनाभ्योर्धनरः कायः पक्षाभ्यां हि विवर्जितः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000437023, "chapter_id": 20437, "verse_number": "२-१०९-२४", "content_sanskrit": "द्विभुजो वंशहस्तस्तु हारकंकणशोभितः ।\nदिव्यगंधानुलिप्तांगो भार्यया सह चागतः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000437024, "chapter_id": 20437, "verse_number": "२-१०९-२५", "content_sanskrit": "तामुवाच निरानंदां स सुतां शंकरस्यहि ।\nकिमर्थं चिंतसे देवि विद्वरं विद्धि चागतम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000437025, "chapter_id": 20437, "verse_number": "२-१०९-२६", "content_sanskrit": "किन्नरं विष्णुभक्तं मां प्रेषितं देवसत्तमैः ।\nदुःखमेवं न कर्तव्यं भवत्या नहुषं प्रति॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000437026, "chapter_id": 20437, "verse_number": "२-१०९-२७", "content_sanskrit": "हुंडेन पापचारेण वधार्थं तस्य धीमतः ।\nकृतमेवाखिलं कर्म हृतश्चायुसुतः शुभे॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000437027, "chapter_id": 20437, "verse_number": "२-१०९-२८", "content_sanskrit": "स तु वै रक्षितो देवैरुपायैर्विविधैरपि ।\nहुंड एवं विजानाति आयुपुत्रो हृतो मया॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000437028, "chapter_id": 20437, "verse_number": "२-१०९-२९", "content_sanskrit": "भक्षितस्तु विशालाक्षि इति जानाति वै शुभे ।\nभवतां श्रावयित्वा हि गतोसौ दानवोऽधमः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000437029, "chapter_id": 20437, "verse_number": "२-१०९-३०", "content_sanskrit": "स्वेनकर्मविपाकेन पुण्यस्यापि महायशाः ।\nपूर्वजन्मार्जितेनैव तव भर्त्ता स जीवति॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000437030, "chapter_id": 20437, "verse_number": "२-१०९-३१", "content_sanskrit": "पुण्यस्यापि बलेनैव येषामायुर्विनिर्मितम् ।\nस्वर्जितस्य महाभागे नाशमिच्छंति घातकाः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000437031, "chapter_id": 20437, "verse_number": "२-१०९-३२", "content_sanskrit": "दुष्टात्मानो महापापाः परतेजोविदूषकाः ।\nतेषां यशोविनाशार्थं प्रपंचंति दिने दिने॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000437032, "chapter_id": 20437, "verse_number": "२-१०९-३३", "content_sanskrit": "नानाविधैरुपायैस्ते विषशस्त्रादिभिस्ततः ।\nहंतुमिच्छंति तं पुण्यं पुण्यकर्माभिरक्षितम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000437033, "chapter_id": 20437, "verse_number": "२-१०९-३४", "content_sanskrit": "पापिनश्चैव हुंडाद्या मोहनस्तंभनादिभिः ।\nपीडयंति महापापा नानाभेदैर्बलाविलैः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000437034, "chapter_id": 20437, "verse_number": "२-१०९-३५", "content_sanskrit": "सुकृतस्य प्रयोगेण पूर्वजन्मार्जितेन हि ।\nपुण्यस्यापि महाभागे पुण्यवंतं सुरक्षितम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000437035, "chapter_id": 20437, "verse_number": "२-१०९-३६", "content_sanskrit": "वैफल्यं यांति तेषां वै उपायाः पापिनां शुभे ।\nयंत्रतंत्राणि मंत्राश्च शस्त्राग्निविषबंधनाः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000437036, "chapter_id": 20437, "verse_number": "२-१०९-३७", "content_sanskrit": "रक्षयंति महात्मानं देवपुण्यैः सुरक्षितम् ।\nकर्तारो भस्मतां यांति स वै तिष्ठति पुण्यभाक्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000437037, "chapter_id": 20437, "verse_number": "२-१०९-३८", "content_sanskrit": "आयुपुत्रस्य वीरस्य रक्षका देवताः शुभे ।\nपुण्यस्य संचयं सर्वे तपसां निधिमेव तु॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000437038, "chapter_id": 20437, "verse_number": "२-१०९-३९", "content_sanskrit": "तस्माच्च रक्षितो वीरो नहुषो बलिनां वरः ।\nसत्येन तपसा तेन पुण्यैश्च संयमैर्दमैः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000437039, "chapter_id": 20437, "verse_number": "२-१०९-४०", "content_sanskrit": "मा कृथा दारुणं दुःखं मुंच शोकमकारणम् ।\nस हि जीवति धर्मात्मा मात्रा पित्रा विना वने॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000437040, "chapter_id": 20437, "verse_number": "२-१०९-४१", "content_sanskrit": "तपोवनेव सत्येकस्तपस्वि परिपालितः ।\nवेदवेदांगतत्त्वज्ञो धनुर्वेदस्य पारगः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000437041, "chapter_id": 20437, "verse_number": "२-१०९-४२", "content_sanskrit": "यथा शशी विराजेत स्वकलाभिः स्वतेजसा ।\nतथा विराजते सोऽपि स्वकलाभिः सुमध्यमे॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000437042, "chapter_id": 20437, "verse_number": "२-१०९-४३", "content_sanskrit": "विद्याभिस्तु महापुण्यैस्तपोभिर्यशसा तथा ।\nराजते परवीरघ्नो रिपुहा सुरवल्लभः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000437043, "chapter_id": 20437, "verse_number": "२-१०९-४४", "content_sanskrit": "हुंडं निहत्य दैत्येंद्रं त्वामेवं हि प्रलप्स्यते ।\nत्वया सार्द्धं स्त्रिया चैव पृथिव्यामेकभूपतिः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000437044, "chapter_id": 20437, "verse_number": "२-१०९-४५", "content_sanskrit": "भविष्यति महायोगी यथा स्वर्गे तु वासवः ।\nत्वं तस्मात्प्राप्स्यसे भद्रे सुपुत्रं वासवोपमम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000437045, "chapter_id": 20437, "verse_number": "२-१०९-४६", "content_sanskrit": "ययातिं नामधर्मज्ञं प्रजापालनतत्परम् ।\nतथा कन्याशतं चापि रूपौदार्यगुणान्वितम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000437046, "chapter_id": 20437, "verse_number": "२-१०९-४७", "content_sanskrit": "यासां पुण्यैर्महाराज इंद्रलोकं प्रयास्यति ।\nइंद्रत्वं भोक्ष्यते देवि नहुषः पुण्यविक्रमः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000437047, "chapter_id": 20437, "verse_number": "२-१०९-४८", "content_sanskrit": "ययातिर्नाम धर्मात्मा आत्मजस्ते भविष्यति ।\nप्रजापालो महाराजः सर्वजीवदयापरः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000437048, "chapter_id": 20437, "verse_number": "२-१०९-४९", "content_sanskrit": "तस्य पुत्रास्तु चत्वारो भविष्यंति महौजसः ।\nबलवीर्यसमोपेता धनुर्वेदस्य पारगाः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000437049, "chapter_id": 20437, "verse_number": "२-१०९-५०", "content_sanskrit": "प्रथमश्च तुरुर्नाम पुरुर्नाम द्वितीयकः ।\nउरुर्नाम तृतीयश्च चतुर्थो वीर्यवान्यदुः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000437050, "chapter_id": 20437, "verse_number": "२-१०९-५१", "content_sanskrit": "एवं पुत्रा महावीर्यास्तेजस्विनो महाबलाः ।\nभविष्यंति महात्मानः सर्वतेजः समन्विताः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000437051, "chapter_id": 20437, "verse_number": "२-१०९-५२", "content_sanskrit": "यदोश्चैव सुता वीराः सिंहतुल्यपराक्रमाः ।\nतेषां नामानि भद्रं ते गदतः शृणु सांप्रतम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000437052, "chapter_id": 20437, "verse_number": "२-१०९-५३", "content_sanskrit": "भोजश्च भीमकश्चापि अंधकः कुञ्जरस्तथा ।\nवृष्णिर्नाम सुधर्मात्मा सत्याधारो भविष्यति॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000437053, "chapter_id": 20437, "verse_number": "२-१०९-५४", "content_sanskrit": "षष्ठस्तु श्रुतसेनश्च श्रुताधारस्तु सप्तमः ।\nकालदंष्ट्रो महावीर्यः समरे कालजिद्बली॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000437054, "chapter_id": 20437, "verse_number": "२-१०९-५५", "content_sanskrit": "यदोः पुत्रा महावीर्या यादवाख्या वरानने ।\nतेषां तु पुत्राः पौत्रास्ते भविष्यंति सहस्रशः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000437055, "chapter_id": 20437, "verse_number": "२-१०९-५६", "content_sanskrit": "एवं नहुषवंशो वै तव देवि भविष्यति ।\nदुःखमेवं परित्यज्य सुखेनानुप्रवर्तय॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000437056, "chapter_id": 20437, "verse_number": "२-१०९-५७", "content_sanskrit": "समेष्यति महाप्राज्ञस्तव भर्ता शुभानने ।\nनिहत्य दानवं हुंडं त्वामेवं परिणेष्यति॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000437057, "chapter_id": 20437, "verse_number": "२-१०९-५८", "content_sanskrit": "दुःखजातानि सोष्णानि नेत्राभ्यां हि पतंति च ।\nअश्रूणि चेंदुमत्याश्च संमार्जयति मानदः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000437058, "chapter_id": 20437, "verse_number": "२-१०९-५९", "content_sanskrit": "आयोश्च दुःखमुद्धृत्य स्वकुलं तारयिष्यति ।\nसुखिनं पितरं कृत्वा प्रजापालो भविष्यति॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000437059, "chapter_id": 20437, "verse_number": "२-१०९-६०", "content_sanskrit": "एतत्ते सर्वमाख्यातं देवानां कथनं शुभे ।\nदुःखं शोकं परित्यज्य सुखेन परिवर्त्तय॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000437060, "chapter_id": 20437, "verse_number": "२-१०९-६१", "content_sanskrit": "अशोकसुंदर्युवाच ।\nकदा ह्येष्यति मे भर्त्ता विहितो दैवतैर्यदि ।\nसत्यं वद स्वधर्मज्ञ मम सौख्यं विवर्द्धय॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000437061, "chapter_id": 20437, "verse_number": "२-१०९-६२", "content_sanskrit": "विद्वर उवाच ।\nअचिराद्द्रक्ष्यसि भर्तारं त्वमेवं शृणु सुंदरि ।\nएवमुक्त्वा जगामाथ गंधर्वो विबुधालयम्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000437062, "chapter_id": 20437, "verse_number": "२-१०९-६३", "content_sanskrit": "अशोकसुंदरी सा च तपस्तेपे हि तत्र वै ।\nकामं क्रोधं परित्यज्य लोभं चापि शिवात्मजा॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]