[{"id": 7002802000, "chapter_id": 22802, "verse_number": "९-८७-१", "content_sanskrit": "युधिष्ठिर उवाचः ।\nकांतारवनदुर्गेषु सुप्रसन्नाटवीषु च ।\nसमुद्रतरणे दाने संग्रामे तस्करार्दने ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002802001, "chapter_id": 22802, "verse_number": "९-८७-२", "content_sanskrit": "कां देवतां स्मरेत्कृष्ण परित्राणकरीमिह ।\nकथं च देवः पुरुषः परित्राणं स्मृतो जनैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002802002, "chapter_id": 22802, "verse_number": "९-८७-३", "content_sanskrit": "श्रीकृष्ण उवाच ।\nसर्वमंगलमांगल्यां दुर्गां भगवतीमिमाम् ।\nनाप्नोति दुःखं पुरुषः संस्मरन्सर्वमङ्गलाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002802003, "chapter_id": 22802, "verse_number": "९-८७-४", "content_sanskrit": "अलक्ष्यां लक्ष्यभूतानां संस्मरन्सर्वमंगलाम् ।\nभयं समवाप्नोति पुरुषः पार्थ कुत्रचित् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002802004, "chapter_id": 22802, "verse_number": "९-८७-५", "content_sanskrit": "यदा तां प्रतिजिज्ञासुरवंत्यामहमागतः ।\nपुरा संदीपनिः पार्थ बलेन सह भारत ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002802005, "chapter_id": 22802, "verse_number": "९-८७-६", "content_sanskrit": "प्राप्तविद्येन च मया प्रतिज्ञातास्य दक्षिणा ।\nदिव्यं स्तवं विदित्वा मे तेनाहं याचितः प्रभो ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002802006, "chapter_id": 22802, "verse_number": "९-८७-७", "content_sanskrit": "प्रभासतीर्थे पुत्रो मे गतः केनाप्यसौ हतः ।\nतमानय महाबाहो सत्यं कुरु वचो मम ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002802007, "chapter_id": 22802, "verse_number": "९-८७-८", "content_sanskrit": "उपाध्यायस्य वचनाद्वैवस्वतपुरे मया ।\nप्राप्तः संदीपनेः पुत्रः समानीतः क्षणादसौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002802008, "chapter_id": 22802, "verse_number": "९-८७-९", "content_sanskrit": "दक्षिणां तामुदाहृत्य प्रस्थितौ पुनरागतौ ।\nस्थानमेतत्स्वपादांकं कृत्वावां गृहमागतौ ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002802009, "chapter_id": 22802, "verse_number": "९-८७-१०", "content_sanskrit": "ततःप्रभृति पुत्रार्थाः पूजयंति जनाः सदा ।\nमां चैव बलभद्रं च मध्यस्थां सर्वमंगलाम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002802010, "chapter_id": 22802, "verse_number": "९-८७-११", "content_sanskrit": "वामे नारायणो हंस एवमेव च के भवेत् ।\nअबाधकं योर्चयते तृतीयं कुंतिनदन ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002802011, "chapter_id": 22802, "verse_number": "९-८७-१२", "content_sanskrit": "त्रयोदश्यां सिते पक्षे मासिमासि यतव्रतः ।\nनक्तेनैवोपवासेन एकभक्तेन वा पुनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002802012, "chapter_id": 22802, "verse_number": "९-८७-१३", "content_sanskrit": "गन्धपुष्पैश्च मधुभिः सीधुभिश्च सुरासवैः ।\nमृन्मयीं कांचनीं वापि कृत्वा प्रतिकृतिं तु यः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002802013, "chapter_id": 22802, "verse_number": "९-८७-१४", "content_sanskrit": "यक्षगन्धबलिक्षेपैः पललौदनसंसृजैः ।\nयोऽभ्भ्यर्चयति राजेन्द्र सर्वपापैः प्रमुच्यते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002802014, "chapter_id": 22802, "verse_number": "९-८७-१५", "content_sanskrit": "भर्तृसहिता स्वर्गलोके महीयते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002802015, "chapter_id": 22802, "verse_number": "९-८७-१६", "content_sanskrit": "अंबांबिके द्विदशमेऽह्नि सिते सदैव यः पूजयेत्कुसुममांससुरोपहारैः ।\nनश्यंति तस्य भवनेष्वतिभीषणानि चौराग्निराजनितानि भयानि सद्यः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]