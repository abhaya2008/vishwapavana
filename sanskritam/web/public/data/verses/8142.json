[{"id": 35000786, "chapter_id": 8142, "verse_number": "5.787", "content_sanskrit": "एकोऽर्थो बहुभिः शब्दैः कथितः कथ्यतेऽधुना । एकस्यैव तु शब्दस्य बहुष्वर्थेषु वर्तनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "avatarnika": ""}, {"id": 35000787, "chapter_id": 8142, "verse_number": "5.788", "content_sanskrit": "रुद्रेऽपि खण्डपरशुर्वैश्रवणेऽप्येककुण्डलः प्रोक्तः । द्वारेऽपि प्रतिहारः प्राकाराग्रेऽपि कपिशीर्षम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2, "avatarnika": ""}, {"id": 35000788, "chapter_id": 8142, "verse_number": "5.789", "content_sanskrit": "पर्याप्तेऽपि कृतं स्यादाहवनीयादिषु त्रिषु त्रेता । सन्देहेऽपि द्वापरमाहुः कलहेऽपि कलिशब्दम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3, "avatarnika": ""}, {"id": 35000789, "chapter_id": 8142, "verse_number": "5.790", "content_sanskrit": "सेनायामपि कटकं प्राणिद्यूतं वदन्ति युद्धेऽपि । रक्षस्यपि पुण्यजनं मृद्भाण्डेऽप्युष्ट्रिकामार्याः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4, "avatarnika": ""}, {"id": 35000790, "chapter_id": 8142, "verse_number": "5.791", "content_sanskrit": "श्वेतं रजतेऽप्युक्तं रजतं हारे शरेऽपि किंशारुः । दम्भेऽपि गह्वरं स्यादुपह्वरं सन्निधानेऽपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5, "avatarnika": ""}, {"id": 35000791, "chapter_id": 8142, "verse_number": "5.792", "content_sanskrit": "नयनच्छदेऽपि वर्त्म प्रतिग्रहः सैन्यपृष्ठभागेऽपि । श्लेष्मण्यपि खेटः स्याज्जामिः कुलबालिकायां च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6, "avatarnika": ""}, {"id": 35000792, "chapter_id": 8142, "verse_number": "5.793", "content_sanskrit": "गन्धो लेशेऽप्युक्तः करुणाप्रतिपादने तपस्वी च । मणिबन्धकनिष्ठिकयोर्मध्यविभागेऽपि करभः स्यात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7, "avatarnika": ""}, {"id": 35000793, "chapter_id": 8142, "verse_number": "5.794", "content_sanskrit": "चिन्तायामपि चर्चा जगती राजप्रधानलोकेऽपि । ऋतुरङ्गनारजस्यपि विकटं श्रेष्ठेऽपि निर्दिष्टम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8, "avatarnika": ""}, {"id": 35000794, "chapter_id": 8142, "verse_number": "5.795", "content_sanskrit": "कवचेऽपि वारवाणं जीमूतं पर्वतेऽपि कथयन्ति । व्यूहं रचनायामपि दार्वाघाटेऽपि शतपत्रम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9, "avatarnika": ""}, {"id": 35000795, "chapter_id": 8142, "verse_number": "5.796", "content_sanskrit": "करणं कायेऽपि स्यादुष्णीषो मूर्धवेष्टनेऽप्युक्तः । मात्रा परिच्छदेऽपि क्षुद्रः क्रूरे श्रुतौ निगमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10, "avatarnika": ""}, {"id": 35000796, "chapter_id": 8142, "verse_number": "5.797", "content_sanskrit": "वृजिनः केशेऽप्युक्तः स्थाणुः कीलेऽपि कुञ्जरे नागः । गञ्जो भाण्डागारे गोमुखमुपलेपनेऽपि स्यात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11, "avatarnika": ""}, {"id": 35000797, "chapter_id": 8142, "verse_number": "5.798", "content_sanskrit": "तेजस्यपि धाम स्यादाधारेऽप्याशयो घटा गोष्ठयाम् । कुल्या कुलस्त्रियामपि तारो मुक्तागुणेऽप्युक्तः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12, "avatarnika": ""}, {"id": 35000798, "chapter_id": 8142, "verse_number": "5.799", "content_sanskrit": "कर्मविपाकेऽपि दशागतौ स्मृते काननेऽपि दवदावौ । चूडाशिखे शिरस्यपि हस्तिन्यां धेनुकागणिके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13, "avatarnika": ""}, {"id": 35000799, "chapter_id": 8142, "verse_number": "5.800", "content_sanskrit": "प्रतिपत्प्रतिपत्तावपि शादः शष्पे घृणा जुगुप्सायाम् । उत्तालमुन्नतेऽपि श्रेष्ठेऽपि निगद्यते सुरभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14, "avatarnika": ""}, {"id": 35000800, "chapter_id": 8142, "verse_number": "5.801", "content_sanskrit": "संवर्तः परिवर्तश्च हायने कथ्यतेऽम्बरे नाकः । परिमाणेऽपि प्रस्थः सर्वात्मनि सर्वसन्नाहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15, "avatarnika": ""}, {"id": 35000801, "chapter_id": 8142, "verse_number": "5.802", "content_sanskrit": "पत्न्यामपि द्वितीया दर्भेऽपि पवित्रमवधिरवटेऽपि । प्रकृतावपि प्रधानं विवक्षितं शोभनेऽपि स्यात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16, "avatarnika": ""}, {"id": 35000802, "chapter_id": 8142, "verse_number": "5.803", "content_sanskrit": "अतिमात्रेऽप्यतिवेलं कायेऽप्युत्सेध इष्यते सद्भिः । पृष्ठास्थन्यपि वंशः रुदती करिवैजयन्त्यां च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17, "avatarnika": ""}, {"id": 35000803, "chapter_id": 8142, "verse_number": "5.804", "content_sanskrit": "जालं कपटेऽप्युक्तं कपालमुक्तं घटादिशकलेऽपि । रिष्टं पापाशुभयोररिष्टमशुभेऽपि निर्दिष्टम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18, "avatarnika": ""}, {"id": 35000804, "chapter_id": 8142, "verse_number": "5.805", "content_sanskrit": "व्यासेऽपि विग्रहः स्यान्मानविशेषेऽपि पौरुषव्यामौ । हेला प्रस्तावेऽपि प्रग्रह आबन्धनेऽप्युक्तः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19, "avatarnika": ""}, {"id": 35000805, "chapter_id": 8142, "verse_number": "5.806", "content_sanskrit": "कुञ्जरकरेऽपि शुण्डा ग्रावा शैले भवश्च संसारे । बालेऽपि बालिशः स्यात्कलधौतं शातकुम्भेऽपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20, "avatarnika": ""}, {"id": 35000806, "chapter_id": 8142, "verse_number": "5.807", "content_sanskrit": "शाखायामपि परिधिर्वसतिर्जैनाश्रमेऽपि निर्दिष्टा । अन्वेषणेऽपि मार्गो भद्रो वृषभे वके ध्वाङ्क्षः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21, "avatarnika": ""}, {"id": 35000807, "chapter_id": 8142, "verse_number": "5.808", "content_sanskrit": "मणिदोषेऽपि त्रासो वत्सः संवत्सरेऽपि निर्दिष्टः । वामः प्रतिकूलेऽपि प्रोक्तौ शुक्लेऽपि शुचिरामौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22, "avatarnika": ""}, {"id": 35000808, "chapter_id": 8142, "verse_number": "5.809", "content_sanskrit": "ह्यस्तनदिनेऽपि कल्यं नेत्रं मूले रजस्यपि परागः । भ्रूणो गर्भिण्यामपि भूतिर्विभवे बलः काके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23, "avatarnika": ""}, {"id": 35000809, "chapter_id": 8142, "verse_number": "5.810", "content_sanskrit": "गिरिसानुन्यपि वप्रं तल्पं दारेषु चक्षुषि ज्योतिः । चौर्यादावपि हिंसा प्रसरः प्रणयेऽपि निर्दिष्टः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24, "avatarnika": ""}, {"id": 35000810, "chapter_id": 8142, "verse_number": "5.811", "content_sanskrit": "संघातेऽपि ग्रामो भूतेन्द्रियशब्दविषयकरणानाम् । षण्डश्च पादपानां स्कन्धः करिनरतुरङ्गाणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25, "avatarnika": ""}, {"id": 35000811, "chapter_id": 8142, "verse_number": "5.812", "content_sanskrit": "नन्द्यावर्तः सरलः शालः काको धवोऽञ्जनस्तिलकः । पद्मस्पन्दनमोक्षा वृक्षविशेषेऽपि दृश्यन्ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26, "avatarnika": ""}, {"id": 35000812, "chapter_id": 8142, "verse_number": "5.813", "content_sanskrit": "कटुतिक्तकषायास्तु सौरभ्येऽपि प्रकीर्तिताः । शोभार्थेऽपि प्रयुज्यन्ते लक्ष्मीश्रीकान्तिविभ्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27, "avatarnika": ""}, {"id": 35000813, "chapter_id": 8142, "verse_number": "5.814", "content_sanskrit": "आर्यः स्यात्सौविदल्लेऽपि व्रीहावप्यणुरिष्यते । चण्डालेऽपि दिवाकीर्तिविवस्वान् देवतास्वपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28, "avatarnika": ""}, {"id": 35000814, "chapter_id": 8142, "verse_number": "5.815", "content_sanskrit": "स्नेहेऽप्यपह्ववः प्रोक्तो द्वेषेऽप्यनुशयः स्मृतः । सुरतेऽपि व्यवायः स्यान्नैगमश्च ऋतावपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29, "avatarnika": ""}, {"id": 35000815, "chapter_id": 8142, "verse_number": "5.816", "content_sanskrit": "दुर्गमार्गेऽपि कान्तारं गृहवाट्यां च निष्कुटः । रूपं मृगेऽपि विज्ञेयं बभ्रुः स्यान्नकुलेऽपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30, "avatarnika": ""}, {"id": 35000816, "chapter_id": 8142, "verse_number": "5.817", "content_sanskrit": "अन्तर्देहेऽपि कोष्ठः स्याच्चत्वरं प्राङ्गणेऽपि च । दुश्चर्मण्यपि निर्दिष्टः शिपिविष्टो मनीषिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31, "avatarnika": ""}, {"id": 35000817, "chapter_id": 8142, "verse_number": "5.818", "content_sanskrit": "संस्तरः प्रस्तरेऽप्युक्तो हनौ कुब्जो रणे स्पशः । गर्जन्मेघेऽपि पर्जन्यः सन्धा स्यादवधावपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32, "avatarnika": ""}, {"id": 35000818, "chapter_id": 8142, "verse_number": "5.819", "content_sanskrit": "व्यवस्थायां च संस्था स्यात्संवित्तावपि वेदना । यात्रा स्यादनुवृत्तौ च संज्ञायां च समाह्वयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33, "avatarnika": ""}, {"id": 35000819, "chapter_id": 8142, "verse_number": "5.820", "content_sanskrit": "क्लीबो विक्रमहीनऽपि समयेऽपि कटः स्मृतः । कलङ्कं लाञ्छने दोषेऽप्यद्रिः प्रोक्तो रवावपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34, "avatarnika": ""}, {"id": 35000820, "chapter_id": 8142, "verse_number": "5.821", "content_sanskrit": "समितिः सङ्गतिसभयोः ककुदं शृङ्गे विदुः प्रधानेऽपि । टङ्कः स्यादभिमाने प्रस्तरघटनोपकरणे च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35, "avatarnika": ""}, {"id": 35000821, "chapter_id": 8142, "verse_number": "5.822", "content_sanskrit": "सङ्केते चैतन्ये च सूरिभिः कथ्यते तथा संज्ञा । दण्डो दमने सैन्ये कुतपो दर्भेऽपराह्णे च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36, "avatarnika": ""}, {"id": 35000822, "chapter_id": 8142, "verse_number": "5.823", "content_sanskrit": "कारुण्येऽप्यनुषङ्गः स्यात्प्रोक्तो गुह्येऽप्यवस्करः । वेदिकाऽङ्गुलिमुद्रायां लाक्षायां च कृमिस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37, "avatarnika": ""}, {"id": 35000823, "chapter_id": 8142, "verse_number": "5.824", "content_sanskrit": "नीवी परिपणेऽप्युक्ता कटिदेशेऽपि मेखला । प्रत्यवायेऽपि विश्लेषे विधुरं स्मर्यते बुधैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38, "avatarnika": ""}, {"id": 35000824, "chapter_id": 8142, "verse_number": "5.825", "content_sanskrit": "निदानमवसानेऽपि स्वामिन्यपि भवेदिनः । जठरः कठिनेऽप्युक्तः प्राज्ञैः परिणतेऽपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39, "avatarnika": ""}, {"id": 35000825, "chapter_id": 8142, "verse_number": "5.826", "content_sanskrit": "काले कल्पेऽपि विधिर्धनाघनः शक्रवर्षुकाम्बुदयोः । अत्ययशब्दः प्राज्ञैः कृच्छ्रे चातिक्रमे च निर्दिष्टः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40, "avatarnika": ""}, {"id": 35000826, "chapter_id": 8142, "verse_number": "5.827", "content_sanskrit": "उदरे जले कृपीटं सम्बाधः सङ्कटे भगेऽप्युक्तः । पाष्णिः प्रत्यासारे च रणस्य च पश्चिमे भागे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41, "avatarnika": ""}, {"id": 35000827, "chapter_id": 8142, "verse_number": "5.828", "content_sanskrit": "रतिभुक्तयोः सम्भोगः पथिदेये स्त्रीधने च शुल्कं स्यात् । वंशाङ्कुरे करीरं वृक्षविशेषेऽपि कथयन्ति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42, "avatarnika": ""}, {"id": 35000828, "chapter_id": 8142, "verse_number": "5.829", "content_sanskrit": "अनूकमन्वये शीले गोत्रं नाम्नि तथान्वये । पुलाकं भक्तसिक्थे च क्षुद्रधान्ये च कथ्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43, "avatarnika": ""}, {"id": 35000829, "chapter_id": 8142, "verse_number": "5.830", "content_sanskrit": "अकार्ये गुह्ये कौपीनं कीलालं रुधिरे जले । कुकूलं शङ्कुमद्गर्ते तुषाग्नौ च निगद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44, "avatarnika": ""}, {"id": 35000830, "chapter_id": 8142, "verse_number": "5.831", "content_sanskrit": "चैत्यं बुद्धाण्डकेऽप्युक्तं देवतायतने तथा । छत्रके वृक्षजातौ च शिलीन्ध्रं स्मर्यते बुधैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45, "avatarnika": ""}, {"id": 35000831, "chapter_id": 8142, "verse_number": "5.832", "content_sanskrit": "अर्थव्ययसहे व्यालस्तथा हिंस्रपशौ स्मृतः । पोत्रमित्युच्यते प्राज्ञैर्हलशूकरयोर्मुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46, "avatarnika": ""}, {"id": 35000832, "chapter_id": 8142, "verse_number": "5.833", "content_sanskrit": "मन्दस्वच्छन्दयोः स्वैरं कक्षः स्यात्कच्छवीरुधोः । करेणुर्गजहस्तिन्योः पीलुश्च गजवृक्षयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47, "avatarnika": ""}, {"id": 35000833, "chapter_id": 8142, "verse_number": "5.834", "content_sanskrit": "शलाकायुधयोः शल्यं बाधा दुःखनिषेधयोः । स्थूणास्तब्धत्वयोः स्तम्भ इला वागघ्न्ययोरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48, "avatarnika": ""}, {"id": 35000834, "chapter_id": 8142, "verse_number": "5.835", "content_sanskrit": "अर्चनामूल्ययोरर्घो विसर्गो मुक्तिवर्चसोः । मुनिकुक्कुटयोर्दक्षः सन्धिः संश्लेषरन्ध्रयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49, "avatarnika": ""}, {"id": 35000835, "chapter_id": 8142, "verse_number": "5.836", "content_sanskrit": "अवश्यभृशयोर्बाढं दायादस्तुक्सपिण्डयोः । कुलीनश्रेष्ठयोर्जात्यं कोटिरुत्कर्षसंख्ययोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50, "avatarnika": ""}, {"id": 35000836, "chapter_id": 8142, "verse_number": "5.837", "content_sanskrit": "ब्रध्नस्तण्डुगिरिशयोः स्थितिः स्थानव्यवस्थयोः । वीकाशः स्फुटरहसोः काष्ठा कालप्रकर्षयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51, "avatarnika": ""}, {"id": 35000837, "chapter_id": 8142, "verse_number": "5.838", "content_sanskrit": "नदीसमुद्रयोः सिन्धुर्देशपर्वतयोर्मरुः । मैथुनं कथ्यते सद्भिः सम्बन्धग्राम्यधर्मयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52, "avatarnika": ""}, {"id": 35000838, "chapter_id": 8142, "verse_number": "5.839", "content_sanskrit": "प्रह्वबन्धनयोः प्राध्वं मोहः स्यान्मौढ्यमूर्छयोः । व्यवस्थानेऽम्भसो वेला रविः पर्वतसूर्ययोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53, "avatarnika": ""}, {"id": 35000839, "chapter_id": 8142, "verse_number": "5.840", "content_sanskrit": "अग्न्युत्पातौ धूमकेतू श्वशुर्यौ श्यालदेवरौ । दिव्यार्थसंग्रहौ कोशौ नरेन्द्रौ नृपवार्त्तिकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54, "avatarnika": ""}, {"id": 35000840, "chapter_id": 8142, "verse_number": "5.841", "content_sanskrit": "आडम्बरो गजानां पटहरवे गर्जिते प्रपञ्चे च । ग्रहशब्दः सूर्यादिषु भूतादिष्वभिनिवेशे च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55, "avatarnika": ""}, {"id": 35000841, "chapter_id": 8142, "verse_number": "5.842", "content_sanskrit": "अव्यक्तः परमात्मनि मूर्खे स्पष्टेतरे च निर्दिष्टः । कक्षा गुह्यपिधाने काञ्च्यां गेहे प्रकोष्ठे च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56, "avatarnika": ""}, {"id": 35000842, "chapter_id": 8142, "verse_number": "5.843", "content_sanskrit": "प्रतियत्नः संस्कारे लिप्सोपग्रहणयोश्च निर्दिष्टः । अभिहारः सन्नाहे स्यादभियोगे परस्वहरणे च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57, "avatarnika": ""}, {"id": 35000843, "chapter_id": 8142, "verse_number": "5.844", "content_sanskrit": "दानविशेषे लब्धौ दायो भागार्हपित्र्यरिक्थे च । लिपिसंख्यायां शास्त्रे द्रव्ये च ग्रन्थशब्दमिच्छन्ति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58, "avatarnika": ""}, {"id": 35000844, "chapter_id": 8142, "verse_number": "5.845", "content_sanskrit": "द्यूताक्षसारिफलकास्त्रयोऽप्याकर्षसंज्ञकाः । संसर्गाभिभवाक्रोशेष्वभिष्वङ्गः प्रकीर्त्तितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59, "avatarnika": ""}, {"id": 35000845, "chapter_id": 8142, "verse_number": "5.846", "content_sanskrit": "त्वाष्ट्रे तमसि शत्रौ च वृत्रशब्दस्त्रिषु स्मृतः । मन्युर्दैन्ये क्रतौ कोपे नाडीस्वर्गक्षितिष्विडा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60, "avatarnika": ""}, {"id": 35000846, "chapter_id": 8142, "verse_number": "5.847", "content_sanskrit": "उक्तानामप्यनुक्तानां शब्दानामिह संग्रहः । कशब्दः सुखवाय्वम्बुब्रह्मामस्तकवाचकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61, "avatarnika": ""}, {"id": 35000847, "chapter_id": 8142, "verse_number": "5.848", "content_sanskrit": "प्रत्ययाः शपथज्ञानहेतुविश्वासनिश्चयाः । विस्तारे कदके शून्ये वितानं स्यात्क्रतौ क्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62, "avatarnika": ""}, {"id": 35000848, "chapter_id": 8142, "verse_number": "5.849", "content_sanskrit": "देहावयवमासार्धपतत्रगृहभित्तिषु । परिग्रहे समीपे च पक्षः षट्सु निगद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63, "avatarnika": ""}, {"id": 35000849, "chapter_id": 8142, "verse_number": "5.850", "content_sanskrit": "अग्निधनरश्मिरत्नत्रिदशविशेषेषु भवति वसुशब्दः । चेष्टात्मजन्मसत्ताभिप्रायेष्वभिहितो भावः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64, "avatarnika": ""}, {"id": 35000850, "chapter_id": 8142, "verse_number": "5.851", "content_sanskrit": "कालविशेषेऽवसरेऽव्यापारे पारतन्त्र्ये च । मध्ये तथोत्सवे च क्षणशब्दः कथ्यते सद्भिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65, "avatarnika": ""}, {"id": 35000851, "chapter_id": 8142, "verse_number": "5.852", "content_sanskrit": "आचारे नयनादौ द्यूतविशेषे तथा रथावयवे । अक्षं विभीतकेऽपि प्रयुञ्जते पञ्चसु प्राज्ञाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66, "avatarnika": ""}, {"id": 35000852, "chapter_id": 8142, "verse_number": "5.853", "content_sanskrit": "निष्ठा क्लेशेऽवसाने च व्यवस्थोत्कर्षयोर्व्रते । श्रेष्ठे स्थाम्नि धने शुक्रे मज्जि सार उदाहृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67, "avatarnika": ""}, {"id": 35000853, "chapter_id": 8142, "verse_number": "5.854", "content_sanskrit": "दिग्दृष्टिदीधितिस्वर्गवज्रवाग्वाणवारिषु । भूमौ पशौ च गोशब्दो विद्वद्भिर्दशसु स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68, "avatarnika": ""}, {"id": 35000854, "chapter_id": 8142, "verse_number": "5.855", "content_sanskrit": "भूषायां लाङ्गूले प्रधानशृङ्गप्रभावपुण्ड्रेषु । ध्वजलक्षमतुरङ्गेषु च नवसु ललामं प्रचक्षते प्राज्ञाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69, "avatarnika": ""}, {"id": 35000855, "chapter_id": 8142, "verse_number": "5.856", "content_sanskrit": "अर्कमर्कटमण्डूकविष्णुवासववायवः । तुरङ्गसिंहशीतांशुयमाश्च हरयो दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70, "avatarnika": ""}, {"id": 35000856, "chapter_id": 8142, "verse_number": "5.857", "content_sanskrit": "पृथिव्यादिषु भूतेषु शरीरेषु रसादिषु । लोहेषु च स्मृतो धातुः स्वभावे गैरिकादिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71, "avatarnika": ""}, {"id": 35000857, "chapter_id": 8142, "verse_number": "5.858", "content_sanskrit": "द्विरदकराग्रे पद्मे खड्गफले व्योम्नि वाद्यभाण्डमुखे । अगदे जले च तीर्थे पुष्करमष्टासु निर्दिष्टम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72, "avatarnika": ""}, {"id": 35000858, "chapter_id": 8142, "verse_number": "5.859", "content_sanskrit": "चतुर्विधेषु जीवेषु पृथिव्यादिषु पञ्चसु । अतीते देवयोनौ च भूतशब्दं प्रचक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73, "avatarnika": ""}, {"id": 35000859, "chapter_id": 8142, "verse_number": "5.860", "content_sanskrit": "शुक्लादौ ब्राह्मणादौ च शोभायामक्षरे व्रते । गीतक्रमे स्तुतौ वेषे वर्णशब्दं प्रचक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74, "avatarnika": ""}, {"id": 35000860, "chapter_id": 8142, "verse_number": "5.861", "content_sanskrit": "शृङ्गारादिषु नवसु च लवणादिषु षट्सु पारदे रागे । निर्यासवीर्यगुणधातुविषघृतादौ रसः प्रोक्तः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75, "avatarnika": ""}, {"id": 35000861, "chapter_id": 8142, "verse_number": "5.862", "content_sanskrit": "योनौ जलाव तारे च मन्त्र्याद्यष्टादशस्वपि । पुण्यक्षेत्रे तथा पात्रे तीर्थं स्याद्दर्शनेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76, "avatarnika": ""}, {"id": 35000862, "chapter_id": 8142, "verse_number": "5.863", "content_sanskrit": "अकारादिषु वर्णेषु षड्जादिषु च सप्तसु । उदात्तादिषु विज्ञेयः प्राणिनां च स्वने स्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77, "avatarnika": ""}, {"id": 35000863, "chapter_id": 8142, "verse_number": "5.864", "content_sanskrit": "सत्त्वादीनां साम्यावस्थां प्रकृतिं वदन्ति तत्त्वज्ञाः । पौरामात्यादीनि च कारणकारुस्वरूपाणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78, "avatarnika": ""}, {"id": 35000864, "chapter_id": 8142, "verse_number": "5.865", "content_sanskrit": "सत्त्वादौ रूपादो शौर्यादौ तन्तुषु प्रयोगज्ञाः । गुणशब्दं सिञ्जिन्यां प्रयोजयन्त्यप्रधानेऽपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79, "avatarnika": ""}, {"id": 35000865, "chapter_id": 8142, "verse_number": "5.866", "content_sanskrit": "उपकरणे करणे च द्रविणे लिङ्गे च यातनायां च । सेनाङ्गे संसिद्धौ साधनशब्दप्रयोगः स्यात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80, "avatarnika": ""}, {"id": 35000866, "chapter_id": 8142, "verse_number": "5.867", "content_sanskrit": "अभिधेयाभिप्रायप्रयोजनद्रव्यवाचकेष्वर्थः । प्रस्तावे संघाते कुत्सायामायुधे जले काण्डम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81, "avatarnika": ""}, {"id": 35000867, "chapter_id": 8142, "verse_number": "5.868", "content_sanskrit": "वेदाध्यात्मब्राह्मणहिरण्यगर्त्रेषु कथ्यते ब्रह्म । प्रकृतिगुणे सत्तायां स्थामनि भूते च सत्त्वं स्यात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82, "avatarnika": ""}, {"id": 35000868, "chapter_id": 8142, "verse_number": "5.869", "content_sanskrit": "इराशब्दो बुधैर्ज्ञेयो भुवि वाच्यशनेऽम्भसि । निमेषादौ यमे वर्णे कालो मृत्यौ च कीर्त्यते । कालसङ्केतकाचारसिद्धान्ताः समयाः समाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83, "avatarnika": ""}, {"id": 35000869, "chapter_id": 8142, "verse_number": "5.870", "content_sanskrit": "तन्त्रं तन्तुषु मन्त्रेषु सिद्धान्तपरिच्छदप्रधानेषु । उत्साहसूचनयोः प्रकाशने गन्धनं प्रोक्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84, "avatarnika": ""}, {"id": 35000870, "chapter_id": 8142, "verse_number": "5.871", "content_sanskrit": "वस्त्रे मध्ये तथा छिद्रे व्यवधानेऽन्तरात्मनि । अवकाशे बहिर्योगे विशेषेऽवसरेऽन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85, "avatarnika": ""}, {"id": 35000871, "chapter_id": 8142, "verse_number": "5.872", "content_sanskrit": "प्रागेव नामपर्याये निपाताः केऽपि कीर्तिताः । कथ्यन्ते केचिदन्येऽपि दिष्ट्या स्यान्मङ्गलादिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86, "avatarnika": ""}, {"id": 35000872, "chapter_id": 8142, "verse_number": "5.873", "content_sanskrit": "चिराय चिररात्राय दीर्घकाले प्रयुज्यते । चिरं चिराच्चिरेणेति वा विकल्पोपमानयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87, "avatarnika": ""}, {"id": 35000873, "chapter_id": 8142, "verse_number": "5.874", "content_sanskrit": "परितः सर्वतो विष्वक् समन्ताच्च समन्ततः । प्रत्यक्षसदृशोः साक्षाद्वार्त्तासम्भाव्ययोः किल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88, "avatarnika": ""}, {"id": 35000874, "chapter_id": 8142, "verse_number": "5.875", "content_sanskrit": "शोचने सम्प्रहर्षे च हन्तशब्दः प्रयुज्यते । ई दुःखभावने क्रोधे प्रत्यक्षे सन्निधावपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89, "avatarnika": ""}, {"id": 35000875, "chapter_id": 8142, "verse_number": "5.876", "content_sanskrit": "पृथग्विनान्तरेणर्ते व्यतिरेकार्थवाचकाः । प्रत्यारम्भे मुहुः प्रोक्तो हुं सम्प्रश्नवितर्कयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90, "avatarnika": ""}, {"id": 35000876, "chapter_id": 8142, "verse_number": "5.877", "content_sanskrit": "इतिह स्यात्सम्प्रदाये प्रेत्यामुत्र भवान्तरे । साकं सार्धं समं सत्रं सहार्थे सम्प्रकीर्तिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91, "avatarnika": ""}, {"id": 35000877, "chapter_id": 8142, "verse_number": "5.878", "content_sanskrit": "अधरस्तादधरतः स्यादधस्तादधोऽधरे । अत इत्युच्यते हेतौ निन्दायां विस्मये बत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92, "avatarnika": ""}, {"id": 35000878, "chapter_id": 8142, "verse_number": "5.879", "content_sanskrit": "समयानिकषाशब्दौ सामीप्ये कीर्तितौ बुधैः । तर्कनिश्चययोर्नूनं कच्चित्स्यात्प्रश्नकामयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93, "avatarnika": ""}, {"id": 35000879, "chapter_id": 8142, "verse_number": "5.880", "content_sanskrit": "आहो उताहो सन्देहे नु स्वित्प्रश्नवितर्कयोः । वर्तमाने च युक्ते च साम्प्रतं सम्प्रचक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94, "avatarnika": ""}, {"id": 35000880, "chapter_id": 8142, "verse_number": "5.881", "content_sanskrit": "प्रकाशे सम्भवे प्रादुः प्रधानसदृशोः प्रति । हि स्याद्विशेषणे हेतौ तु स्याद्भेदेऽवधारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95, "avatarnika": ""}, {"id": 35000881, "chapter_id": 8142, "verse_number": "5.882", "content_sanskrit": "अथि प्रश्ने सानुनये सत्ये शीघ्रे तथाञ्जसा । ईषत्किञ्चिन्मनाक् प्रोक्ताः किञ्चनस्तोकवाचकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96, "avatarnika": ""}, {"id": 35000882, "chapter_id": 8142, "verse_number": "5.883", "content_sanskrit": "तूष्णीं जोषं भवेन्मौने स्म स्यात्संस्मरणादिषु अङ्गेत्यामन्त्रणे हं हो भो भो इति च कथ्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97, "avatarnika": ""}, {"id": 35000883, "chapter_id": 8142, "verse_number": "5.884", "content_sanskrit": "अनेकार्थे भवेन्नाना ननु प्रश्नेऽवधारणे । आकस्मिकार्थे सहसा तत्काले च निगद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98, "avatarnika": ""}, {"id": 35000884, "chapter_id": 8142, "verse_number": "5.885", "content_sanskrit": "विस्तारेऽङ्गीकृतावूरी कथ्यत उररी तथा । असंशये भवेबद्धा सहार्थान्तिकयोरमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99, "avatarnika": ""}, {"id": 35000885, "chapter_id": 8142, "verse_number": "5.886", "content_sanskrit": "अथानन्तरकल्याणसम्प्रश्नादिषु कथ्यते । अथो इति तथा प्रोक्तो नामाभ्युपगमादिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100, "avatarnika": ""}, {"id": 35000886, "chapter_id": 8142, "verse_number": "5.887", "content_sanskrit": "सदा सना च नित्यत्वे स्वस्ति स्यान्मङ्गलादिषु । इतिशब्दः स्मृतो हेतौ प्रकारादिसमाप्तिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101, "avatarnika": ""}]