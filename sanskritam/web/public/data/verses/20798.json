[{"id": 7000798000, "chapter_id": 20798, "verse_number": "६-१४१-१", "content_sanskrit": "महादेव उवाच ।\nततो देवि प्रवक्ष्यामि हिरण्यासंगमादनु ।\nधर्मावती नदी यत्र संगता सह गंगया॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000798001, "chapter_id": 20798, "verse_number": "६-१४१-२", "content_sanskrit": "तत्र स्नात्वा नरो धन्यस्त्रिदिवं यात्यसंशयम् ।\nयत्र धर्मकृतं तीर्थं यः पश्यति स पुण्यभाक्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000798002, "chapter_id": 20798, "verse_number": "६-१४१-३", "content_sanskrit": "श्राद्धं तत्रैव ये कुर्युर्मुच्यंते पितृजादृणात् ।\nततश्च मधुरातीर्थं सर्वपापप्रणाशनम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000798003, "chapter_id": 20798, "verse_number": "६-१४१-४", "content_sanskrit": "स्नातव्यं मधुरातीर्थे द्रष्टव्यो मधुहा हरिः ।\nयत्र विश्रांतवान्कृष्णो जरासंधभयाकुलः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000798004, "chapter_id": 20798, "verse_number": "६-१४१-५", "content_sanskrit": "कंसासुरवधे वृत्ते गंतुकामः कुशस्थलीम् ।\nउषित्वा सप्तरात्रं तु स देवश्चंदनातटे॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000798005, "chapter_id": 20798, "verse_number": "६-१४१-६", "content_sanskrit": "भोजवृष्ण्यंधकवृतो वीरैर्यादवपुंगवैः ।\nमधुरातीर्थमासाद्य स्नानं कृत्वा विधानतः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000798006, "chapter_id": 20798, "verse_number": "६-१४१-७", "content_sanskrit": "मधुरादित्यनामानं यत्र स्थापितवान्हरिः ।\nअष्टादशसहस्राणि विप्राणां यज्ञशालिनाम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000798007, "chapter_id": 20798, "verse_number": "६-१४१-८", "content_sanskrit": "स्थापयित्वा ययौ दत्त्वा यानानि विविधानि च ।\nतत्र तीर्थसहस्राणि तिष्ठंति च सुरेश्वरि॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000798008, "chapter_id": 20798, "verse_number": "६-१४१-९", "content_sanskrit": "श्राद्धं तत्र प्रकर्तव्यं पितॄणां हितकाम्यया ।\nन भेतव्यं जरासंधान्मत्तीर्थे वसतां सदा॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000798009, "chapter_id": 20798, "verse_number": "६-१४१-१०", "content_sanskrit": "इत्युक्त्वा तान्द्विजान्कृष्णः प्रययौ द्वारकां प्रति ।\nतस्मिंस्तीर्थे नरः स्नात्वा मधुरार्कं प्रपूजयेत्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000798010, "chapter_id": 20798, "verse_number": "६-१४१-११", "content_sanskrit": "माघस्य शुक्लसप्तम्यां कपिला गो प्रदानतः ।\nचिरं सौख्यानि भुंक्त्वेह पदमादित्यमा व्रजेत्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000798011, "chapter_id": 20798, "verse_number": "६-१४१-१२", "content_sanskrit": "शृणु सुन्दरि वक्ष्यामि इतिहासं पुरातनम् ।\nयं श्रुत्वा मुच्यते लोको ब्रह्महत्यादि पातकात्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000798012, "chapter_id": 20798, "verse_number": "६-१४१-१३", "content_sanskrit": "एकस्मिन्समये देवि मांडव्यो ऋषिसत्तमः ।\nगङ्गाद्वारे महापुण्यं तप्तवांस्तु महत्तपः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000798013, "chapter_id": 20798, "verse_number": "६-१४१-१४", "content_sanskrit": "पत्राशी च फलाशी च वायुभक्षकरः सदा ।\nअहोरात्रं सदा देवि विष्णुध्यानपरायणः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000798014, "chapter_id": 20798, "verse_number": "६-१४१-१५", "content_sanskrit": "योगाभ्यासरतो नित्यं नित्यं धर्मपरायणः ।\nतस्मिन्देशे तु वै देवि राजा वै विश्वमोहनः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000798015, "chapter_id": 20798, "verse_number": "६-१४१-१६", "content_sanskrit": "गजाश्वरथपत्तीनां संपदो बहुला भुवि ।\nसोमचंद्रेति विख्यातः पुत्रस्तस्य सुलक्षणः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000798016, "chapter_id": 20798, "verse_number": "६-१४१-१७", "content_sanskrit": "एकदा तु तदा देवि गतो ह्याखेटके वने ।\nतत्र गत्वा तदा तेन कृत्वा ह्याखेटकक्रियाः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000798017, "chapter_id": 20798, "verse_number": "६-१४१-१८", "content_sanskrit": "स्वात्मानं रमयामास स्वलोकैः परिवारितः ।\nक्रीडारते तदा राज्ञि रात्रिर्जाता सुरेश्वरि॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000798018, "chapter_id": 20798, "verse_number": "६-१४१-१९", "content_sanskrit": "तस्यां रात्रौ तदा राजा उवासाखेटके वने ।\nतस्यां रात्र्यां व्यतीतायां मुहूर्ते ब्रह्मसंज्ञके॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000798019, "chapter_id": 20798, "verse_number": "६-१४१-२०", "content_sanskrit": "हृतोऽश्वोऽथ विशेषेण चौरेणात्र दुरात्मना ।\nतदा हाहेति शब्दोऽभूत्क्व गतः क्व गतो हरिः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000798020, "chapter_id": 20798, "verse_number": "६-१४१-२१", "content_sanskrit": "तदा राज्ञो भयात्सर्वे गंतुकामाः समुत्सुकाः ।\nचौरेणापहृतश्चाश्व इत्येवं संवदंति हि॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000798021, "chapter_id": 20798, "verse_number": "६-१४१-२२", "content_sanskrit": "निरीक्ष्यमाणास्ते सर्वे हरिद्वारं समागताः ।\nऋषिस्तत्र तु मांडव्यस्तपस्तपति नित्यशः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000798022, "chapter_id": 20798, "verse_number": "६-१४१-२३", "content_sanskrit": "ध्यानेन च समायुक्तो दृष्टोऽसौ तैर्भटैस्तदा ।\nअयं चौरः सदा पापी ध्यानं कृत्वा प्रतिष्ठति॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000798023, "chapter_id": 20798, "verse_number": "६-१४१-२४", "content_sanskrit": "बद्ध्वाश्वं तु समायातो ज्ञात्वा राजभटैस्तदा ।\nएवं विचार्य ते सर्वे गृहीत्वा तं महामुनिम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000798024, "chapter_id": 20798, "verse_number": "६-१४१-२५", "content_sanskrit": "राज्ञे निवेदयामासुस्तं चौरं मुनिसत्तमम् ।\nअश्वापहारी ह्यानीतश्चौरोऽयं नृप सर्वदा॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000798025, "chapter_id": 20798, "verse_number": "६-१४१-२६", "content_sanskrit": "आज्ञा दत्ता तदा तेन शूलिकारोपणे पुनः ।\nतदा तैस्तुभटैः सर्वैर्मिलित्वा बंधनं कृतम्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000798026, "chapter_id": 20798, "verse_number": "६-१४१-२७", "content_sanskrit": "पश्चाद्वै शूलिकाप्रोतस्तत्क्षणात्तु कृतस्तदा ।\nन ज्ञातं तेन तत्कर्म शूलिकायाः प्रतोदनम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000798027, "chapter_id": 20798, "verse_number": "६-१४१-२८", "content_sanskrit": "यतो योगसमारूढो विष्णुध्यानपरायणः ।\nशूलिकाप्रोतनं ज्ञातं कतिचित्कालयोगतः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000798028, "chapter_id": 20798, "verse_number": "६-१४१-२९", "content_sanskrit": "मांडव्योऽहंमृषिश्रेष्ठः केन कर्म इदं कृतम् ।\nत्रिकालज्ञानी सर्वज्ञो भगवांस्तद्व्यचिंतयत्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000798029, "chapter_id": 20798, "verse_number": "६-१४१-३०", "content_sanskrit": "धर्मस्य च इदं कर्म न चान्यस्य कदाचन ।\nयोगारूढः स धर्मात्मा गतोऽसौ धर्मसंनिधौ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000798030, "chapter_id": 20798, "verse_number": "६-१४१-३१", "content_sanskrit": "तत्र गत्वा उवाचेदं शृणु त्वं धर्म सांप्रतम् ।\nत्वं वै धर्म इति ख्यातो लोके वेदे च सर्वदा॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000798031, "chapter_id": 20798, "verse_number": "६-१४१-३२", "content_sanskrit": "शूलिकाप्रोतनं कर्म कथं चैव त्वया कृतम् ।\nतत्सर्वं श्रोतुमिच्छामि त्वत्तो देव न संशयः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000798032, "chapter_id": 20798, "verse_number": "६-१४१-३३", "content_sanskrit": "धर्म उवाच ।\nशृणुष्व त्वं द्विजश्रेष्ठ पूर्वजन्मनि पातकम् ।\nतदहं कथयिष्यामि कृपां कुरु ममोपरि॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000798033, "chapter_id": 20798, "verse_number": "६-१४१-३४", "content_sanskrit": "बालत्वे तु इदं कर्म पूर्वजन्मजपातकम् ।\nतच्छृणुष्व महाप्राज्ञ भवेऽस्मिन्पातनं कृतम्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000798034, "chapter_id": 20798, "verse_number": "६-१४१-३५", "content_sanskrit": "एकस्मिन्समये विप्र त्वं गतो विजने वने ।\nतत्र गत्वा त्वया विप्र जीवः शलभसंज्ञकः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000798035, "chapter_id": 20798, "verse_number": "६-१४१-३६", "content_sanskrit": "आरोऽपितः स वै शूल्यां कर्मणा तेन दुःखितः ।\nराज्ञा शूलेऽर्पितस्त्वं वै कर्मणानेन सुव्रत॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000798036, "chapter_id": 20798, "verse_number": "६-१४१-३७", "content_sanskrit": "सर्वथैव प्रभोक्तव्यं कृतं कर्म शुभाशुभम् ।\nअल्पमात्रमिदं कर्म त्वया भुक्तं न संशयः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000798037, "chapter_id": 20798, "verse_number": "६-१४१-३८", "content_sanskrit": "सुखी भवतु विप्रेंद्र गच्छ त्वं हि यथेच्छया ।\nएतद्वाक्यं ततः श्रुत्वा मांडव्यो द्विजसत्तमः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000798038, "chapter_id": 20798, "verse_number": "६-१४१-३९", "content_sanskrit": "उवाच वचनं तत्र सकोपादारुणेक्षणः ।\nमांडव्य उवाच ।\nरे पापिष्ठ दुराचार किं कृतं बहुपातकम्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000798039, "chapter_id": 20798, "verse_number": "६-१४१-४०", "content_sanskrit": "येन कृत्वा इदं कर्म शूलिकायाः प्रतोदनम् ।\nममवाक्यप्रकोपेन शूद्रस्त्वं भव सर्वथा॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000798040, "chapter_id": 20798, "verse_number": "६-१४१-४१", "content_sanskrit": "कियता कालयोगेन वंशे वै चंद्रसंज्ञके ।\nजातो विदुरनामाख्यो विष्णुभक्तिपरायणः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000798041, "chapter_id": 20798, "verse_number": "६-१४१-४२", "content_sanskrit": "तीर्थयात्रामिषेणैव गतः साभ्रमतीं नदीम् ।\nयत्र धर्मावती संगो वर्त्तते च सुरेश्वरि॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000798042, "chapter_id": 20798, "verse_number": "६-१४१-४३", "content_sanskrit": "तत्र वै कृतवान्स्नानं विदुरो धर्मरूपवान् ।\nत्यक्तं तत्र हि शूद्रत्वं धर्मावत्यां न संशयः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000798043, "chapter_id": 20798, "verse_number": "६-१४१-४४", "content_sanskrit": "एतस्मात्कारणाद्देवि यत्र स्नानं प्रकुर्वते ।\nते नराः पुण्यकर्माणो गच्छंति परमं पदम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000798044, "chapter_id": 20798, "verse_number": "६-१४१-४५", "content_sanskrit": "अत्र श्राद्धं च दानं च ये कुर्वंति नरा भुवि ।\nइहलोके परामृद्धिं प्राप्य तैर्दिविमुद्यते॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]