[{"id": 5000485000, "chapter_id": 9485, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे अष्टसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000485001, "chapter_id": 9485, "verse_number": "६-७८-१", "content_sanskrit": "निकुम्भं निहतं श्रुत्वा कुम्भं च विनिपातितम्।\nरावणः परमामर्षी प्रजज्वालानलो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000485002, "chapter_id": 9485, "verse_number": "६-७८-२", "content_sanskrit": "नैर्ऋतः क्रोधशोकाभ्यां द्वाभ्यां तु परिमूर्च्छितः।\nखरपुत्रं विशालाक्षं मकराक्षमचोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000485003, "chapter_id": 9485, "verse_number": "६-७८-३", "content_sanskrit": "गच्छ पुत्र मयाऽऽज्ञप्तो बलेनाभिसमन्वितः।\nराघवं लक्ष्मणं चैव जहि तौ सवनौकसौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000485004, "chapter_id": 9485, "verse_number": "६-७८-४", "content_sanskrit": "रावणस्य वचः श्रुत्वा शूरमानी खरात्मजः।\nबाढमित्यब्रवीद‍्धृष्टो मकराक्षो निशाचरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000485005, "chapter_id": 9485, "verse_number": "६-७८-५", "content_sanskrit": "सोऽभिवाद्य दशग्रीवं कृत्वा चापि प्रदक्षिणम्।\nनिर्जगाम गृहाच्छुभ्राद् रावणस्याज्ञया बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000485006, "chapter_id": 9485, "verse_number": "६-७८-६", "content_sanskrit": "समीपस्थं बलाध्यक्षं खरपुत्रोऽब्रवीद् वचः।\nरथमानीयतां तूर्णं सैन्यं त्वानीयतां त्वरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000485007, "chapter_id": 9485, "verse_number": "६-७८-७", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा बलाध्यक्षो निशाचरः।\nस्यन्दनं च बलं चैव समीपं प्रत्यपादयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000485008, "chapter_id": 9485, "verse_number": "६-७८-८", "content_sanskrit": "प्रदक्षिणं रथं कृत्वा समारुह्य निशाचरः।\nसूतं संचोदयामास शीघ्रं वै रथमावह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000485009, "chapter_id": 9485, "verse_number": "६-७८-९", "content_sanskrit": "अथ तान् राक्षसान् सर्वान् मकराक्षोऽब्रवीदिदम्।\nयूयं सर्वे प्रयुध्यध्वं पुरस्तान्मम राक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000485010, "chapter_id": 9485, "verse_number": "६-७८-१०", "content_sanskrit": "अहं राक्षसराजेन रावणेन महात्मना।\nआज्ञप्तः समरे हन्तुं तावुभौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000485011, "chapter_id": 9485, "verse_number": "६-७८-११", "content_sanskrit": "अद्य रामं वधिष्यामि लक्ष्मणं च निशाचराः।\nशाखामृगं च सुग्रीवं वानरांश्च शरोत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000485012, "chapter_id": 9485, "verse_number": "६-७८-१२", "content_sanskrit": "अद्य शूलनिपातैश्च वानराणां महाचमूम्।\nप्रदहिष्यामि सम्प्राप्तां शुष्केन्धनमिवानलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000485013, "chapter_id": 9485, "verse_number": "६-७८-१३", "content_sanskrit": "मकराक्षस्य तच्छ्रुत्वा वचनं ते निशाचराः।\nसर्वे नानायुधोपेता बलवन्तः समाहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000485014, "chapter_id": 9485, "verse_number": "६-७८-१४", "content_sanskrit": "ते कामरूपिणः क्रूरा दंष्ट्रिणः पिङ्गलेक्षणाः।\nमातंगा इव नर्दन्तो ध्वस्तकेशा भयावहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000485015, "chapter_id": 9485, "verse_number": "६-७८-१५", "content_sanskrit": "परिवार्य महाकाया महाकायं खरात्मजम्।\nअभिजग्मुस्ततो हृष्टाश्चालयन्तो वसुन्धराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000485016, "chapter_id": 9485, "verse_number": "६-७८-१६", "content_sanskrit": "शङ्खभेरीसहस्राणामाहतानां समन्ततः।\nक्ष्वेलितास्फोटितानां च तत्र शब्दो महानभूत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000485017, "chapter_id": 9485, "verse_number": "६-७८-१७", "content_sanskrit": "प्रभ्रष्टोऽथ करात् तस्य प्रतोदः सारथेस्तदा।\nपपात सहसा दैवाद् ध्वजस्तस्य तु रक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000485018, "chapter_id": 9485, "verse_number": "६-७८-१८", "content_sanskrit": "तस्य ते रथसंयुक्ता हया विक्रमवर्जिताः।\nचरणैराकुलैर्गत्वा दीनाः सास्रमुखा ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000485019, "chapter_id": 9485, "verse_number": "६-७८-१९", "content_sanskrit": "प्रवाति पवनस्तस्मिन् सपांसुः खरदारुणः।\nनिर्याणे तस्य रौद्रस्य मकराक्षस्य दुर्मतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000485020, "chapter_id": 9485, "verse_number": "६-७८-२०", "content_sanskrit": "तानि दृष्ट्वा निमित्तानि राक्षसा वीर्यवत्तमाः।\nअचिन्त्य निर्गताः सर्वे यत्र तौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000485021, "chapter_id": 9485, "verse_number": "६-७८-२१", "content_sanskrit": "घनगजमहिषाङ्गतुल्यवर्णाः\nसमरमुखेष्वसकृद‍्गदासिभिन्नाः।\nअहमहमिति युद्धकौशलास्ते\nरजनिचराः परिबभ्रमुर्मुहुस्ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000485022, "chapter_id": 9485, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे अष्टसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]