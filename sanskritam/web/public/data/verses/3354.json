[{"id": 2108651, "chapter_id": 3354, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108652, "chapter_id": 3354, "verse_number": "१", "content_sanskrit": "श्रुत्वा तु वचनं तेषां सर्वेषामपि चैव हि ।\nवासुकेश्च वचः श्रुत्वा एलापत्रोऽब्रवीदिदम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108653, "chapter_id": 3354, "verse_number": "२", "content_sanskrit": "न स यज्ञो न भविता स च राजा तथाविधः ।\nजनमेजयः पाण्डवेयो यतोऽस्माकमिदं भयम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108654, "chapter_id": 3354, "verse_number": "३", "content_sanskrit": "दैवेनोपहतं राजन् न कर्तव्यं च पौरुषम् ।\nस दैवमेवाश्रयेत नान्यत् तत्र परायणम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108655, "chapter_id": 3354, "verse_number": "४", "content_sanskrit": "तदिदं दैवमस्माकं भयं पन्नगसत्तमाः ।\nदैवमेवाश्रयामोऽत्र शृणुध्वं च वचो मम \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108656, "chapter_id": 3354, "verse_number": "५", "content_sanskrit": "अहं शापे समुत्सृष्टे समश्रौषं वचस्तदा\nमातुरुत्सङ्गमारूढो भयात्पन्नगसत्तमाः\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108657, "chapter_id": 3354, "verse_number": "६", "content_sanskrit": "देवानां पन्नगश्रेष्ठा तीक्ष्णा इति वचः प्रभो ।\nपितामहमुपागम्य दुःखार्तानां महात्मनाम्\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108658, "chapter_id": 3354, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108659, "chapter_id": 3354, "verse_number": "७", "content_sanskrit": "का हि लब्ध्वा प्रियान् पुत्रान् शपेदेवं पितामह ।\nऋते कद्रूं तीक्ष्णरूपां देवदेव तवाग्रतः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108660, "chapter_id": 3354, "verse_number": "८", "content_sanskrit": "तथेति च वचस्तस्यास्त्वयाप्युक्तं पितामह ।\nएतदिच्छाम विज्ञातुं कारणं यन्न वारिता \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2108661, "chapter_id": 3354, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2108662, "chapter_id": 3354, "verse_number": "९", "content_sanskrit": "बहवः पन्नगास्तीक्ष्णा भीमवीर्या विषोद्बणाः ।\nप्रजानां हितकामोऽहं न च वारितवांस्तदा \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2108663, "chapter_id": 3354, "verse_number": "१०", "content_sanskrit": "ये दन्दशूकाः क्षुद्राश्च पापचारा विषोद्बणाः ।\nतेषां विनाशो भविता न तु ये धर्मचारिणः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2108664, "chapter_id": 3354, "verse_number": "११", "content_sanskrit": "यन्निमित्तश्च भविता मोक्षस्तेषां महाभयात् ।\nपन्नगानां निबोधध्वं यथा वै गदितं मया \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2108665, "chapter_id": 3354, "verse_number": "१२", "content_sanskrit": "यायावरकुले धीमान् भविष्यति महानृषिः ।\nजरत्कारुरिति ख्यातस्तेजस्वी विजितेन्द्रियः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2108666, "chapter_id": 3354, "verse_number": "१३", "content_sanskrit": "तस्य पुत्रो जरत्कारोरुत्पत्स्यति महातपाः ।\nआस्तीको नाम यज्ञं स प्रतिषेत्स्यति तं तदा ।\nतत्र मोक्ष्यन्ति भुजगा ये भविष्यन्ति धार्मिकाः\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2108667, "chapter_id": 3354, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2108668, "chapter_id": 3354, "verse_number": "१४", "content_sanskrit": "स मुनिप्रवरो देव जरत्कारुर्महातपाः ।\nकस्यां पुत्रं महात्मानं जनयिष्यति वीर्यवान् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2108669, "chapter_id": 3354, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2108670, "chapter_id": 3354, "verse_number": "१५", "content_sanskrit": "सनामायां सनामा स कन्यायां द्विजसत्तमः ।\nअपत्यं वीर्यवान् देवा वीर्यवज्जनयिष्यति \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2108671, "chapter_id": 3354, "verse_number": "", "content_sanskrit": "एलापत्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2108672, "chapter_id": 3354, "verse_number": "१६", "content_sanskrit": "एवमस्त्विति तं देवाः पितामहमथाब्रुवन् ।\nउक्त्वा चैवं गता देवाः स च देवः पितामहः\t ॥ १६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2108673, "chapter_id": 3354, "verse_number": "१७", "content_sanskrit": "सोऽहमेवं प्रपश्यामि वासुके भगिनीं तव ।\nजरत्कारुरिति ख्यातां तां तस्मै प्रतिपादय\t ॥ १७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2108674, "chapter_id": 3354, "verse_number": "१८", "content_sanskrit": "भैक्षवद् भिक्षमाणाय नागानां भयशान्तये ।\nऋषये सुव्रताय त्वमेष मोक्षः श्रुतो मया \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2108675, "chapter_id": 3354, "verse_number": "३३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nत्रयस्त्रिंशोऽध्यायः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2108676, "chapter_id": 3354, "verse_number": "२१", "content_sanskrit": "॥ आस्तीकपर्वणि एकविंशोऽध्यायः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]