[{"id": 2052524, "chapter_id": 2162, "verse_number": "७-८९-०x", "content_sanskrit": "अर्जुन उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2052525, "chapter_id": 2162, "verse_number": "७-८९-१", "content_sanskrit": "चोदयाश्वान्हृषीकेश यत्र दुर्मर्षणः स्थितः।\nएतद्भित्त्वा गजानीकं प्रवेक्ष्याम्यरिवाहिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2052526, "chapter_id": 2162, "verse_number": "७-८९-२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2052527, "chapter_id": 2162, "verse_number": "७-८९-२", "content_sanskrit": "एवमुक्तो महाबाहुः केशवः सव्यसाचिना।\nअचोदयद्धयांस्तत्र यत्र दुर्मर्षणः स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2052528, "chapter_id": 2162, "verse_number": "७-८९-३", "content_sanskrit": "स सम्प्रहारस्तुमुलः सम्प्रवृत्तः सुदारुणः।\nएकस्य च बहूनां च रथनागनरक्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2052529, "chapter_id": 2162, "verse_number": "७-८९-४", "content_sanskrit": "ततः सायकवर्षेण पर्जन्य इव वृष्टिमान्।\nपरानवाकिरत्पार्थः पर्वतानिव नीरदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2052530, "chapter_id": 2162, "verse_number": "७-८९-५", "content_sanskrit": "ते चापि रथिनः सर्वे त्वरिताः कृतहस्तवत्।\nअवाकिरन्बाणजालैस्तत्र कृष्णधनञ्जयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2052531, "chapter_id": 2162, "verse_number": "७-८९-६", "content_sanskrit": "ततः क्रुद्धो महाबाहुर्वार्यमाणः परैर्युधि।\nशिरांसि रथिनां पार्थः कायेभ्योऽपाहरच्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2052532, "chapter_id": 2162, "verse_number": "७-८९-७", "content_sanskrit": "उद्धान्तनयनैर्वक्रैः सन्दष्टौष्ठपुटैः शुभैः।\nसकुण्डलशिरस्त्राणैर्वसुधा समकीर्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2052533, "chapter_id": 2162, "verse_number": "७-८९-८", "content_sanskrit": "पुण्डरीकवनानीव विध्वस्तानि समन्ततः।\nविनिकीर्णानि योधानां वदनानि चकाशिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2052534, "chapter_id": 2162, "verse_number": "७-८९-९", "content_sanskrit": "सुवर्णचित्राभरणाः संसिक्ता रुधिरेण च।\nसंसक्ता इव दृश्यन्ते मेघसङ्घाः सविद्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2052535, "chapter_id": 2162, "verse_number": "७-८९-१०", "content_sanskrit": "शिरसां पततां राजञ्शब्दोऽभूद्वसुधातले।\nकालेन परिपक्वानां तालानां पततामिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2052536, "chapter_id": 2162, "verse_number": "७-८९-११", "content_sanskrit": "कबन्ध उत्थितः कश्चिद्विष्फार्य सशरं धनुः।\nकिञ्चित्खङ्गं विनिष्कृष्य भुजेनोद्यम्य तिष्ठति।\n`गृहीत्वाऽन्यस्य केशेषु शिरो नृत्यति चापरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2052537, "chapter_id": 2162, "verse_number": "७-८९-१२", "content_sanskrit": "पतितानि न जानन्ति शिरांसि पुरुषर्षभाः।\nअमृष्यमाणाः सङ्ग्रामे कौन्तेयं जयगृद्धिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2052538, "chapter_id": 2162, "verse_number": "७-८९-१३", "content_sanskrit": "हयानामुत्तमाङ्गैश्च हस्तिहस्तैश्च मेदिनी।\nबाहुभिश्च शिरोभिश्च वीराणां समकीर्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2052539, "chapter_id": 2162, "verse_number": "७-८९-१४", "content_sanskrit": "अयं पार्थः कुतः पार्थः पार्थोऽयमिति सर्वशः।\n`तिष्ठ पार्थेहि मां पार्थ क्व यासीति च जल्पताम्।\nतव सैन्येषु योधानां पार्थभूतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2052540, "chapter_id": 2162, "verse_number": "७-८९-१५", "content_sanskrit": "अन्योन्यमपि चाजघ्नुरात्मानमपि चापरे।\nपार्थभूतममन्यन्त जनाः कालेन मोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2052541, "chapter_id": 2162, "verse_number": "७-८९-१६", "content_sanskrit": "निष्टनन्तः सरुधिरा विसंज्ञा गाढवेदनाः।\nशयाना बहवो वीराः कीर्तयन्तः स्वबान्धवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2052542, "chapter_id": 2162, "verse_number": "७-८९-१७", "content_sanskrit": "सभिण्डिपालाः सप्रासाः सशक्त्यृष्टिपरश्वथाः।\nसनिर्व्यूहाः सनिस्त्रिंशाः सशरासनतोमराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2052543, "chapter_id": 2162, "verse_number": "७-८९-१८", "content_sanskrit": "सबाणवर्माभरणाः सगदाः साङ्गदा रणे।\nमहाभुजगसङ्काशा बाहवः परिघोपमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2052544, "chapter_id": 2162, "verse_number": "७-८९-१९", "content_sanskrit": "उद्वेष्टन्ति विचेष्टन्ति सञ्चेष्टन्ति च सर्वशः।\nवेगं कुर्वन्ति संरब्धा निकृत्ताः परमेषुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2052545, "chapter_id": 2162, "verse_number": "७-८९-२०", "content_sanskrit": "यो यः स्म समरे पार्थं प्रतिसञ्चरते नरः।\nतस्यतस्यान्तको बाणः शरीरमुपसर्पति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2052546, "chapter_id": 2162, "verse_number": "७-८९-२१", "content_sanskrit": "नृत्यतो रथमार्गेषु धनुर्व्यायच्छतस्तथा।\nन कश्चित्तत्र पार्थश्च ददृशेऽन्तरमण्वपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2052547, "chapter_id": 2162, "verse_number": "७-८९-२२", "content_sanskrit": "यत्तस्य घटमानस्य क्षिप्रं विक्षिपतः शरान्।\nलाघवात्पाण्डुपुत्रस्य व्यस्मयन्त परे जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2052548, "chapter_id": 2162, "verse_number": "७-८९-२३", "content_sanskrit": "हस्तिनं हस्तियन्तारमश्वमाश्विकमेव च।\nअभिनत्फल्गुनो बाणै रथिनं च ससारथिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2052549, "chapter_id": 2162, "verse_number": "७-८९-२४", "content_sanskrit": "आवर्तमानमावृत्तं युध्यमानं च पाण्डवः।\nप्रमुखे तिष्ठमानं च न कञ्चिन्न निहन्ति सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2052550, "chapter_id": 2162, "verse_number": "७-८९-२५", "content_sanskrit": "यथोदयन्वै गगने सूर्यो हन्ति महत्तमः।\nतथाऽर्जुनो गजानीकमवधीत्कङ्कपत्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2052551, "chapter_id": 2162, "verse_number": "७-८९-२६", "content_sanskrit": "हस्तिभिः पतितैर्भिन्नैस्तव सैन्यमदृश्यत।\nअन्तकाले यथा भूमिर्व्यवकीर्णा महीधरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2052552, "chapter_id": 2162, "verse_number": "७-८९-२७", "content_sanskrit": "यथा मध्यंदिने सूर्यो दुष्प्रेक्ष्यः प्राणिभिः सदा।\nतथा धनञ्जयः क्रुद्धो दुष्प्रेक्ष्यो युधि शत्रुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2052553, "chapter_id": 2162, "verse_number": "७-८९-२८", "content_sanskrit": "तत्तथा तव पुत्रस्य सैन्यं युधि परन्तप।\nप्रभग्नं द्रुतमाविग्नमतीव शरपीडितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2052554, "chapter_id": 2162, "verse_number": "७-८९-२९", "content_sanskrit": "मारुतेनेव महता मेघानीकं व्यदीर्यत।\nप्रकाल्यमानं तत्सैन्यं नाशकत्प्रतिवीक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2052555, "chapter_id": 2162, "verse_number": "७-८९-३०", "content_sanskrit": "प्रतोदैश्चापकोटीभिर्हुंकारैः साधुवाहितैः।\nकशापार्ष्ण्यभिघातैश्च वाग्भिरुग्राभिरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2052556, "chapter_id": 2162, "verse_number": "७-८९-३१", "content_sanskrit": "चोदयन्तो हयांस्तूर्णं पलायन्ते स्म तावकाः।\nसादिनो रथिनश्चैव पत्तयश्चार्जुनार्दिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2052557, "chapter_id": 2162, "verse_number": "७-८९-३२", "content_sanskrit": "पार्ष्ण्यङ्गुष्ठाङ्कुशैर्नागं चोदयन्तस्तथाऽपरे।\nशरैः सम्मोहिताश्चान्ये तमेवाभिमुखा ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2052558, "chapter_id": 2162, "verse_number": "७-८९-३३", "content_sanskrit": "तव योघ हतोत्साहा विभ्रान्तमनसस्तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2052559, "chapter_id": 2162, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे एकोननवतितमोऽध्यायः॥ ८९ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-८९-१७ निर्व्यूह आयुधविशेषः॥ ५-८९-२० प्रतिसञ्चरते प्रत्युद्रच्छति॥ ५-८९-२२ यत्तस्यावहितस्य॥ ५-८९-२८ द्रुतं विद्रुतम्। आविग्नं भीतम्॥ ५-८९-३० साधुवाहितैः सुष्ठु व्यापारीतैः॥ ५-८९-८९ एकोननवतितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]