[{"id": 7002473000, "chapter_id": 22473, "verse_number": "१-१३५-१", "content_sanskrit": "नारद उवाच ।\nअतः परं प्रवक्ष्यामि स्नानकर्मविधिं तव ।\nस्नापकस्तु महाप्राज्ञो ब्राह्मणो वेदपारगः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002473001, "chapter_id": 22473, "verse_number": "१-१३५-२", "content_sanskrit": "अभिज्ञः सौरशास्त्राणामरुणो यदुसत्तम ।\nभोजको भोजकैश्चान्यैर्ब्राह्मणैश्च तथा वृतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002473002, "chapter_id": 22473, "verse_number": "१-१३५-३", "content_sanskrit": "दिशाभागे मण्डलस्य ईशाने वै यथाक्रमम् ।\nहस्तमात्रप्रमाणं तु भद्रपीठं तु विन्यसेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002473003, "chapter_id": 22473, "verse_number": "१-१३५-४", "content_sanskrit": "हस्तिना शकटेनापि भक्त्या ब्रह्मरथेन च ।\nमंगलैर्ब्रह्मघोषैश्च देवं प्रासादमानयेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002473004, "chapter_id": 22473, "verse_number": "१-१३५-५", "content_sanskrit": "भद्रपीठं समादाय भद्रं कर्णेति मन्त्रतः ।\nसूत्रधारस्तथा प्रोक्तः शुक्लाम्बरधरः शुचिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002473005, "chapter_id": 22473, "verse_number": "१-१३५-६", "content_sanskrit": "स्नापयेत्कलशं गृह्य देवदेवं विभावसुम् ।\nसामुद्रं तोयमाहृत्य जाह्नवं यामुनं तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002473006, "chapter_id": 22473, "verse_number": "१-१३५-७", "content_sanskrit": "सारस्वतं जलं पुण्यं चान्द्रभागं ससैन्धवम् ।\nपुष्करस्य जलं श्रेष्ठं गिरिप्रस्रवणोदकम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002473007, "chapter_id": 22473, "verse_number": "१-१३५-८", "content_sanskrit": "अन्यद्वापि शुचि तोयं नदीनदतडागजम् ।\nयथाशक्त्या उपाहृत्य कलशैः काञ्चनादिभिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002473008, "chapter_id": 22473, "verse_number": "१-१३५-९", "content_sanskrit": "भोजकाश्चाष्टभिः सूर्यं कलशैः स्नापयन्ति वै ।\nततस्तु मणिरत्नानि सर्वबीजौषधीस्तथा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002473009, "chapter_id": 22473, "verse_number": "१-१३५-१०", "content_sanskrit": "सुगन्धीनि च माल्यानि स्थलजान्यम्बुजानि च ।\nचन्दनानि च मुख्यानि गन्धाश्च विविधास्तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002473010, "chapter_id": 22473, "verse_number": "१-१३५-११", "content_sanskrit": "ब्राह्मी सुवर्चला मुस्ता विष्णुक्रान्ता शतावरी ।\nदूर्वा च शिबिपुष्पी च प्रियङ्गू रजनी वचा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002473011, "chapter_id": 22473, "verse_number": "१-१३५-१२", "content_sanskrit": "सम्भृत्यैतांस्तु सम्भारान्स्नानकर्मविभागवित् ।\nबलाश्वत्थशिरीषाणां पल्लवैः कुशसंयुतैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002473012, "chapter_id": 22473, "verse_number": "१-१३५-१३", "content_sanskrit": "कलशोपरि विन्यस्य दद्यादर्घ्यं रवेः सदा ।\nकाञ्चनै राजतैस्ताम्रैर्मृण्मयैः कलशैस्तथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002473013, "chapter_id": 22473, "verse_number": "१-१३५-१४", "content_sanskrit": "साक्षतैः सहिरण्यैश्च सर्वौषधिसमन्वितैः ।\nगायत्र्या परिपूतैस्तु षोडशैः स्नापयेद्रविम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002473014, "chapter_id": 22473, "verse_number": "१-१३५-१५", "content_sanskrit": "कुशोत्तरां१ ततः कृत्वा वेदिं पक्वेष्टकामयीम् ।\nतस्यां वेद्यां समारोप्य परिधाप्य च वाससी ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002473015, "chapter_id": 22473, "verse_number": "१-१३५-१६", "content_sanskrit": "प्रतिमामभिषिञ्चेच्च सोपवासः प्रयत्नतः ।\nमूर्ध्नि सर्वौषधीः कृत्वा तथैवामलकानि च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002473016, "chapter_id": 22473, "verse_number": "१-१३५-१७", "content_sanskrit": "मन्त्रेण मृत्तिकां चापि मन्त्रतश्च जलं तथा ।\nत्वं देवी वन्दिता देवैः सकलैर्दैत्यदानवैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002473017, "chapter_id": 22473, "verse_number": "१-१३५-१८", "content_sanskrit": "तेन संस्थापिता मूर्ध्नि मया देवस्य शुद्धये ।\nआदिस्त्वं सर्वभूतानां देवतानां च सर्वथा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002473018, "chapter_id": 22473, "verse_number": "१-१३५-१९", "content_sanskrit": "रसानां पतये तुभ्यमाह्वानं च कृतं मया ।\nइत्थं पौराणिकैर्मंत्रैवैदिकैश्च विशेषतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002473019, "chapter_id": 22473, "verse_number": "१-१३५-२०", "content_sanskrit": "कार्यं हि वारुणं स्नानं देवस्य यदुनंदन ।\nइत्थमुच्चारयेद्वाचं कुर्यात्स्नानं विचक्षणः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002473020, "chapter_id": 22473, "verse_number": "१-१३५-२१", "content_sanskrit": "देवास्त्वामभिषिञ्चन्तु ब्रह्मविष्णुशिवादयः ।\nव्योमगङ्गा च पूर्णेन द्वितीयकलशेन तु ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002473021, "chapter_id": 22473, "verse_number": "१-१३५-२२", "content_sanskrit": "सारस्वतस्य पूर्णेन कलशेन सुरोत्तम ।\nशक्रादयोभिषिंचन्तु लोकपालाः सुरोत्तमाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002473022, "chapter_id": 22473, "verse_number": "१-१३५-२३", "content_sanskrit": "सागरोदकपूर्णेन चतुर्थकलशेन तु ।\nवारिणा परिपूर्णेन पद्मपत्रसुगन्धिना ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002473023, "chapter_id": 22473, "verse_number": "१-१३५-२४", "content_sanskrit": "पञ्चमेनाभिषिञ्चन्तु नागाश्च कलशेन तु ।\nहिमवद्धेमकूटाद्याश्चाभिषिञ्चन्तु वारिणा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002473024, "chapter_id": 22473, "verse_number": "१-१३५-२५", "content_sanskrit": "नैरृतोदकपूर्णेन षष्ठेन कलशेन तु ।\nसर्वतीर्थाम्बुपूर्णेन पद्मरेणुसुवासिना ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002473025, "chapter_id": 22473, "verse_number": "१-१३५-२६", "content_sanskrit": "सप्तमेनाभिषिञ्चन्तु ऋषयः सप्त ये वराः ।\nवसवश्चाभिषिञ्चन्तु कलशेनाष्टमेन वै ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002473026, "chapter_id": 22473, "verse_number": "१-१३५-२७", "content_sanskrit": "अष्टमङ्गलयुक्तेन देवदेव नमोऽस्तु ते ।\nततो वै कलशैर्दिव्यैः स्नानकर्म समारभेत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002473027, "chapter_id": 22473, "verse_number": "१-१३५-२८", "content_sanskrit": "समुद्रं गच्छ यः प्रोक्तो मन्त्रमेतमुदीरयेत् ।\nहिरण्यगर्भेति च यो मन्त्रस्तं समुदीरयेत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002473028, "chapter_id": 22473, "verse_number": "१-१३५-२९", "content_sanskrit": "समुद्रज्येष्ठेति मन्त्रेण क्षालयेन्मृत्तिकान्वितम् ।\nसिनीवालीति मन्त्रेण दद्याद्वल्मीकमृत्तिकाम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002473029, "chapter_id": 22473, "verse_number": "१-१३५-३०", "content_sanskrit": "शम्युदुम्बरमश्वत्थं न्यग्रोधं च पलाशकम् ।\nयज्ञं यज्ञेति मन्त्रेण दद्यात्पञ्चकषायिकम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002473030, "chapter_id": 22473, "verse_number": "१-१३५-३१", "content_sanskrit": "पञ्चगव्यं पवित्रं च आहरेत्ताम्रभाजने ।\nगायत्र्या चैव गोमूत्रं गन्धद्वारेति गोमयम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002473031, "chapter_id": 22473, "verse_number": "१-१३५-३२", "content_sanskrit": "आप्यायस्वेति च क्षीरं दधिक्राव्णेति वै दधि ।\nतेजोऽसीति घृतं तद्वद्देवस्य त्वा कुशोदकम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002473032, "chapter_id": 22473, "verse_number": "१-१३५-३३", "content_sanskrit": "एवमादिविधियुतं पञ्चगव्यं प्रकीर्तितम् ।\nया१ ओषधीति मंत्रेण स्नानमोषधिभिः क्रमात् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002473033, "chapter_id": 22473, "verse_number": "१-१३५-३४", "content_sanskrit": "द्रुपदाभिः पुनस्तस्य कुर्याच्चोद्वर्तनं बुधः ।\nशिरः स्नानं ततो दद्यान्मानस्तोकाभिमन्त्रितम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002473034, "chapter_id": 22473, "verse_number": "१-१३५-३५", "content_sanskrit": "विष्णोरराटमन्त्रेण दद्याद्गन्धोदकं शुभम् ।\nततो नद्युद्भवेनैव क्षालयेच्छुद्धवारिणा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002473035, "chapter_id": 22473, "verse_number": "१-१३५-३६", "content_sanskrit": "जातवेदसमुच्चार्य वस्त्रपूतेन वारिणा ।\nतत आवाहयेद्देवं रक्तमाल्याम्बरं शुभम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002473036, "chapter_id": 22473, "verse_number": "१-१३५-३७", "content_sanskrit": "एह्येहि भगवन्भानो लोकानुग्रहकारक ।\nयज्ञभागं गृहाणार्घ्यमर्कदेव नमोऽस्तु ते ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002473037, "chapter_id": 22473, "verse_number": "१-१३५-३८", "content_sanskrit": "हिरण्येन तु पात्रेण देवायार्घ्यं प्रदापयेत् ।\nइदं विष्णुर्विचक्रमे मन्त्रेणार्घ्यं समर्पयेत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002473038, "chapter_id": 22473, "verse_number": "१-१३५-३९", "content_sanskrit": "पार्थिवैः प्रथमं कलशैः स्नापयेद्भास्करं बुधः ।\nततस्त्वौदुम्बरैर्वीर राजतैस्तदनन्तरम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002473039, "chapter_id": 22473, "verse_number": "१-१३५-४०", "content_sanskrit": "ततस्तु काञ्चनैर्देवं स्नापयेद्यदुनन्दन ।\nसर्वतीर्थजलैर्युक्तं सर्वौषधिसमन्वितम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002473040, "chapter_id": 22473, "verse_number": "१-१३५-४१", "content_sanskrit": "शङ्खमादाय देवस्य ततो मूर्धनि शङ्कर ।\nदत्त्वा पुष्पाणि देवस्य मूर्ध्नि यत्नाद्विचक्षणः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002473041, "chapter_id": 22473, "verse_number": "१-१३५-४२", "content_sanskrit": "तोयमुत्क्षिप्य यत्नेन ततः स्नपनमाचरेत् ।\nप्रथमं स्नापयेद्देवं वारिणा यदुनन्दन ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002473042, "chapter_id": 22473, "verse_number": "१-१३५-४३", "content_sanskrit": "ततस्तु पयसा राजन्पायसेन ततस्तु वै ।\nघृतेन मधुना वापि तथा इक्षुरसेन च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002473043, "chapter_id": 22473, "verse_number": "१-१३५-४४", "content_sanskrit": "अग्निष्टोमस्य यज्ञस्य गोमेधस्य च सुव्रत ।\nज्योतिष्टोमस्य राजेन्द्र वाजपेयस्य वै विभो ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002473044, "chapter_id": 22473, "verse_number": "१-१३५-४५", "content_sanskrit": "राजसूयाश्वमेधाभ्यां घृताद्यैर्लभते फलम् ।\nयस्तु कारयते स्नानं यस्तु भक्त्या प्रपश्यति ।\nक्रियमाणं तु देवस्य स्नानं यदुकुलोद्वह ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002473045, "chapter_id": 22473, "verse_number": "१-१३५-४६", "content_sanskrit": "य एते कथिता यज्ञा एतेषां क्रमशः फलम् ।\nअर्चां च कुरुशार्दूल दृष्ट्वा वै लभते फलम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002473046, "chapter_id": 22473, "verse_number": "१-१३५-४७", "content_sanskrit": "स्नानं तु यत्नतः कार्यं देवदेवस्य सुव्रत ।\nयथा न लङ्घयेत्कश्चिद्देवस्य स्नपनं विभोः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002473047, "chapter_id": 22473, "verse_number": "१-१३५-४८", "content_sanskrit": "न प्राश्नन्ति यथा काकास्तीर्थं लोकविगर्हिताः ।\nस्नानोदकं तु देवस्य अथवा पय एव हि ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002473048, "chapter_id": 22473, "verse_number": "१-१३५-४९", "content_sanskrit": "भूमौ गतं यथा चैव प्राश्नाति यदुनंदन ।\nरोगं प्राप्नोति कर्ता वै दुःखं कारयिता तथा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002473049, "chapter_id": 22473, "verse_number": "१-१३५-५०", "content_sanskrit": "तस्माद्यत्नेन कर्तव्यं देवस्य स्नपनं विभोः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002473050, "chapter_id": 22473, "verse_number": "१-१३५-५१", "content_sanskrit": "स्नापयित्वा क्रमेणेत्थं स्नानकर्म विधानवित् ।\nततो वर्धनिकां गृह्य वारिधारां समुत्सृजेत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002473051, "chapter_id": 22473, "verse_number": "१-१३५-५२", "content_sanskrit": "त्रिवारान्पुरतोऽर्कस्य आचमस्वेति च ब्रुवन् ।\nवे  ।\nदोसीति च मन्त्रेण उपवीतं प्रवापयेत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002473052, "chapter_id": 22473, "verse_number": "१-१३५-५३", "content_sanskrit": "बृहस्पतेति मन्त्रेण वस्त्रयुग्मं प्रदापयेत् ।\nयत्नक्रमं प्रकुर्वाणः पुष्पमालां प्रदापयेत् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002473053, "chapter_id": 22473, "verse_number": "१-१३५-५४", "content_sanskrit": "धूरसीति च मन्त्रेण धूपं दद्यात्सगुग्गलम् ।\nसमिद्धोञ्जनमन्त्रेण अञ्जनं तु प्रदापयेत् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002473054, "chapter_id": 22473, "verse_number": "१-१३५-५५", "content_sanskrit": "युञ्जानीति च मन्त्रेण रोचनां तस्य दापयेत् ।\nआरार्तिकं च वै कुर्याद्दीर्घायुष्ट्वाय वर्चसे ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002473055, "chapter_id": 22473, "verse_number": "१-१३५-५६", "content_sanskrit": "स्नानकर्म त्विदं प्रोक्तं भास्करस्य महात्मनः ।\nभोजका ब्राह्मणाश्चैव क्रियां कुर्युः प्रयत्नतः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002473056, "chapter_id": 22473, "verse_number": "१-१३५-५७", "content_sanskrit": "बहवृचोऽथर्वणश्चैव छन्दोगोध्वर्युरेव च ।\nस्नापकस्य च चिह्नानि ये च मूर्तिधरास्तथा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002473057, "chapter_id": 22473, "verse_number": "१-१३५-५८", "content_sanskrit": "तेषां प्रवक्ष्यामि विभो शृणु चैकमनाः किल ।\nसम्पूर्णगात्रो मतिमाञ्छास्त्रज्ञः प्रियदर्शनः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002473058, "chapter_id": 22473, "verse_number": "१-१३५-५९", "content_sanskrit": "कुलीनः श्रद्दधानश्च आर्यदेशसमुद्भवः ।\nन स्थूलो न कृशो दीर्घः सौरशास्त्रविशारदः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002473059, "chapter_id": 22473, "verse_number": "१-१३५-६०", "content_sanskrit": "यश्च युक्तो जितात्मा च गुरुभक्तो जितेन्द्रियः ।\nपञ्चविंशतितत्त्वज्ञः स्थापकः समुदाहृतः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002473060, "chapter_id": 22473, "verse_number": "१-१३५-६१", "content_sanskrit": "वर्जनीयांश्च वक्ष्यामि यैस्तु कर्म न कारयेत् ।\nहीनाङ्गश्चाधिकाङ्गश्च वामनो विकटस्तथा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002473061, "chapter_id": 22473, "verse_number": "१-१३५-६२", "content_sanskrit": "नातिगौरो न कृष्णश्च स्नापनाय प्रयोजयेत् ।\nचार्वाको याजकश्चैव नित्यं गोमुखदम्भकः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002473062, "chapter_id": 22473, "verse_number": "१-१३५-६३", "content_sanskrit": "अशुचिव्रतसंयुक्तः श्यामदन्तोऽथ मत्सरी ।\nकोपनो दुष्टशीलश्च युवा वा वृद्ध एव च ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002473063, "chapter_id": 22473, "verse_number": "१-१३५-६४", "content_sanskrit": "श्वित्री कुष्ठी च रोगी च काणो दुर्मतिरेव च ।\nसंकीर्णो जातिहीनश्च तथा न वृषलीपतिः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002473064, "chapter_id": 22473, "verse_number": "१-१३५-६५", "content_sanskrit": "कुब्जश्चाधस्तथा व्यंगः खल्वाटो विकलेन्द्रियः ।\nअविनीतो दुरात्मा च विकलः पङ्गुरेव च ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002473065, "chapter_id": 22473, "verse_number": "१-१३५-६६", "content_sanskrit": "तिथिनक्षत्रयोगानां वाराणां च तथा विभो ।\nसूचको जीविकार्थं३ हि यश्च मूल्येन पाठयेत् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002473066, "chapter_id": 22473, "verse_number": "१-१३५-६७", "content_sanskrit": "ईदृशान्स्नापकान्सर्वान्वर्जयेत प्रयत्नतः ।\nतस्मात्सर्वप्रयत्नेन परीक्ष्याः स्नापका बुधैः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]