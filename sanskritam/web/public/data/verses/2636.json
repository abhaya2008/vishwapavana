[{"id": 2077243, "chapter_id": 2636, "verse_number": "१२-१४१-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2077244, "chapter_id": 2636, "verse_number": "१२-१४१-१", "content_sanskrit": "हीने परमके धर्मे सर्वलोकविलङ्घिते।\nअधर्मे धर्मतां नीते धर्मे चाधर्मतां गते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2077245, "chapter_id": 2636, "verse_number": "१२-१४१-२", "content_sanskrit": "मर्यादासु प्रभिन्नासु क्षुभिते लोकिश्चये।\nराजभिः पीडिते लोके चोरैर्वाऽपि विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2077246, "chapter_id": 2636, "verse_number": "१२-१४१-३", "content_sanskrit": "सर्वाश्रमेषु मूढेषु कर्मसूपहतेषु च।\nकामाल्लोभाच्च मोहाच्च भयं पश्यत्सु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2077247, "chapter_id": 2636, "verse_number": "१२-१४१-४", "content_sanskrit": "अविश्वस्तेषु सर्वेषु नित्यं भीतेषु भारत।\nनित्यं च हन्यमानेषु वञ्चयत्सु परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2077248, "chapter_id": 2636, "verse_number": "१२-१४१-५", "content_sanskrit": "प्रदीप्तेषु च देशेषु ब्राह्मण्ये चातिपीडिते।\nअवर्षति च पर्जन्ये मिथो भेदे समुत्थिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2077249, "chapter_id": 2636, "verse_number": "१२-१४१-६", "content_sanskrit": "सर्वस्मिन्दस्युसाद्भूते पृथिव्यामुपजीवने।\nकेनस्विद्ब्राह्मणो जीवेज्जघन्ये काल आगते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2077250, "chapter_id": 2636, "verse_number": "१२-१४१-७", "content_sanskrit": "अतितिक्षुः पुत्रपौत्राननुक्रोशान्नराधिप।\nकतमापदि वर्तेत तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2077251, "chapter_id": 2636, "verse_number": "१२-१४१-८", "content_sanskrit": "कथं च राजा वर्तेत लोके कलुषतां गते।\nकथमर्थाच्च धर्माच्च न हीयेत परंतप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2077252, "chapter_id": 2636, "verse_number": "१२-१४१-९x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2077253, "chapter_id": 2636, "verse_number": "१२-१४१-९", "content_sanskrit": "राजमूला महाबाहो योगक्षेमसुवृष्टयः।\nप्रजासु व्याधयश्चैव मरणं च भयानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2077254, "chapter_id": 2636, "verse_number": "१२-१४१-१०", "content_sanskrit": "कृतं त्रेता द्वापरं च कलिश्च भरतर्षभ।\nराजमूला इति मतिर्मम नास्त्यत्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2077255, "chapter_id": 2636, "verse_number": "१२-१४१-११", "content_sanskrit": "तस्मिंस्त्वभ्यागते काले प्रजानां दोषकारके।\nविज्ञानबलमास्थाय जीवितव्यं भवेत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2077256, "chapter_id": 2636, "verse_number": "१२-१४१-१२", "content_sanskrit": "अधाप्युदाहरन्तीममितिहासं पुरातनम्।\nविश्वामित्रस्य संवादं चण्डालस्य च पक्कणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2077257, "chapter_id": 2636, "verse_number": "१२-१४१-१३", "content_sanskrit": "त्रेताद्वापरयोः संधौ पुरा दैवव्यतिक्रमात्।\nअनावृष्टिरभूद्धोरा लोके द्वादशवार्षिकी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2077258, "chapter_id": 2636, "verse_number": "१२-१४१-१४", "content_sanskrit": "प्रजानामतिवृद्धानां युगान्ते समुपस्थिते।\nत्रेतायां मोक्षसमये द्वापरप्रतिपादने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2077259, "chapter_id": 2636, "verse_number": "१२-१४१-१५", "content_sanskrit": "न ववर्ष सहस्राक्षः प्रतिलोमोऽभवद्गुरुः।\nजगाम दक्षिणं मार्गं सोमो व्यावृत्तमण्डलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2077260, "chapter_id": 2636, "verse_number": "१२-१४१-१६", "content_sanskrit": "नावश्यायोऽपि रात्र्यन्ते कुत एवाभ्रराजयः।\nनद्यः संक्षिप्ततोयौघाः किंचिदन्तर्गताऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2077261, "chapter_id": 2636, "verse_number": "१२-१४१-१७", "content_sanskrit": "सरांसि सरितश्चैव कूपाः प्रस्रवणानि च।\nहतत्विषो न लक्ष्यन्ते निसर्गात्पूर्वकारितात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2077262, "chapter_id": 2636, "verse_number": "१२-१४१-१८", "content_sanskrit": "भूमिः शुष्कजलस्थाना विनिवृत्तसभाप्रपा।\nनिवृत्तयज्ञस्वाध्याया निर्वषट्कारमङ्गला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2077263, "chapter_id": 2636, "verse_number": "१२-१४१-१९", "content_sanskrit": "उत्सन्नकृषिगोरक्षा निवृत्तविपणापणा।\nनिवृत्तपूर्वसमया संप्रनष्टमहोत्सवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2077264, "chapter_id": 2636, "verse_number": "१२-१४१-२०", "content_sanskrit": "अस्थिकङ्कालसंकीर्णा हाहाभूतनराकुला।\nशून्यभूयिष्ठनगरा दग्धग्रामनिवेशना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2077265, "chapter_id": 2636, "verse_number": "१२-१४१-२१", "content_sanskrit": "क्वचिच्चोरैः क्वचिच्छूरैः क्वचिद्राजभिरातुरैः।\nपरस्परभयाच्चैव शून्यभूयिष्ठनिर्जना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2077266, "chapter_id": 2636, "verse_number": "१२-१४१-२२", "content_sanskrit": "गतदैवतसंस्थाना वृद्धबालविनाकृता।\nगोजाविमहिषीहीना परस्परपराहता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2077267, "chapter_id": 2636, "verse_number": "१२-१४१-२३", "content_sanskrit": "हतविप्रा हतारक्षा प्रनष्टोत्सवसंचया।\nशवभूतनरप्राया बभूव वसुधा तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2077268, "chapter_id": 2636, "verse_number": "१२-१४१-२४", "content_sanskrit": "तस्मिन्प्रतिभये काले क्षीणधर्मे युधिष्ठिर।\nबभूवुः क्षुधिता मर्त्याः खादमानाः परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2077269, "chapter_id": 2636, "verse_number": "१२-१४१-२५", "content_sanskrit": "ऋषयो नियमांस्त्यक्त्वा परित्यक्ताग्निदेवताः।\nआश्रमान्संपरित्यज्य पर्यधावन्नितस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2077270, "chapter_id": 2636, "verse_number": "१२-१४१-२६", "content_sanskrit": "विश्वामित्रोऽथ भगवान्महर्षिरनिकेतनः।\nक्षुधा परिगतो धीमान्समन्तात्पर्यधावत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2077271, "chapter_id": 2636, "verse_number": "१२-१४१-२७", "content_sanskrit": "त्यक्त्वा दारांश्च पुत्रांश्च कस्मिंश्च जनसंसदि।\nभक्ष्याभक्ष्यसमो भ्रूत्वा निरग्निरनिकेतनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2077272, "chapter_id": 2636, "verse_number": "१२-१४१-२८", "content_sanskrit": "स कदाचित्परिपतञ्श्वपचानां निकेतनम्।\nहिंस्राणां प्राणिघातानामाससाद वने क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2077273, "chapter_id": 2636, "verse_number": "१२-१४१-२९", "content_sanskrit": "विभिन्नकलशाकीर्णं श्रमांसेन च भूषितम्।\nवराहखरभग्नास्थिकपालघटसंकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2077274, "chapter_id": 2636, "verse_number": "१२-१४१-३०", "content_sanskrit": "मृतचेलपरिस्तीर्णं निर्माल्यकृतभूषणम्।\nसर्पनिर्मोकमालाभिः कृतचिह्नकुटीमुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2077275, "chapter_id": 2636, "verse_number": "१२-१४१-३१", "content_sanskrit": "कुक्कुटाराबहुलं गर्दभध्वनिनादितम्।\nउद्धोषद्भिः खरैर्वाक्यैः कलहद्भिः परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2077276, "chapter_id": 2636, "verse_number": "१२-१४१-३२", "content_sanskrit": "उलूकपक्षिध्वनिभिर्देवतायतनैर्वृतम्।\nलोहघण्टापरिष्कारं श्वयूथपरिवारितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2077277, "chapter_id": 2636, "verse_number": "१२-१४१-३३", "content_sanskrit": "तत्प्रविश्य क्षुधाविष्टो गाधिपुत्रो महानृपिः।\nआहारान्वेषणे युक्तः परं यत्नं समास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2077278, "chapter_id": 2636, "verse_number": "१२-१४१-३४", "content_sanskrit": "न च क्वचिदविन्दत्स भिक्षमाणोऽपि कौशिकः।\nमांसमन्नं फलं मूलमन्यद्वा तत्र किंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2077279, "chapter_id": 2636, "verse_number": "१२-१४१-३५", "content_sanskrit": "अहो कृच्छ्रं मया प्राप्तमिति निश्चित्य कौशिकः।\nपपात भूमौ दौर्बल्यात्तस्मिंश्चण्डालपक्कणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2077280, "chapter_id": 2636, "verse_number": "१२-१४१-३६", "content_sanskrit": "स चिन्तयामास मुनिः किंनु मे सुकृतं भवेत्।\nकथं वृथा न मृत्युः स्यादिति पार्थिवसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2077281, "chapter_id": 2636, "verse_number": "१२-१४१-३७", "content_sanskrit": "स ददर्श श्वमांसस्य कुतन्त्रीं पतितां मुनिः।\nचण्डालस्य गृहे राजन्सद्यः शस्त्रहतस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2077282, "chapter_id": 2636, "verse_number": "१२-१४१-३८", "content_sanskrit": "स चिन्तयामास तदा स्तेयं कार्यमितो मया।\nन--दानीमुपायो मे विद्यते प्राणधारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2077283, "chapter_id": 2636, "verse_number": "१२-१४१-३९", "content_sanskrit": "---सु विहितं स्तेयं विशिष्टसमहीनतः।\nपरस्परं भवेत्पूर्वमास्थेयमिति निश्चयः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2077284, "chapter_id": 2636, "verse_number": "१२-१४१-४०", "content_sanskrit": "हीनादादेयमादौ स्यात्समानात्तदनन्तरम्।\nअसंभवे त्वाददीत विशिष्टादपि धार्मिकात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2077285, "chapter_id": 2636, "verse_number": "१२-१४१-४१", "content_sanskrit": "सोऽहमन्तावसायीनां हराम्येनां प्रतिग्रहात्।\nन स्तेयदोषं पश्यामि हरिष्याम्येतदामिषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2077286, "chapter_id": 2636, "verse_number": "१२-१४१-४२", "content_sanskrit": "एतां बुद्धिं समास्थाय विश्वामित्रो महामुनिः।\nतस्मिन्देशे सुसुष्वाप पतितो यत्र भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2077287, "chapter_id": 2636, "verse_number": "१२-१४१-४३", "content_sanskrit": "स विगाढां निशां दृष्ट्वा सुप्ते चण्डालपक्कणे।\nशनैरुत्थाय भगवान्प्रविवेश कुटीमुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2077288, "chapter_id": 2636, "verse_number": "१२-१४१-४४", "content_sanskrit": "स सुप्त एव चण्डालः श्लेष्मापिहितलोचनः।\nपरिभिन्नस्वरो रूक्षः प्रोवाचाप्रियदर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2077289, "chapter_id": 2636, "verse_number": "१२-१४१-४५", "content_sanskrit": "कः कुतन्त्रीं घट्टयति सुप्ते चण्डालपक्कणे।\nजागर्मि नैव सुप्तोऽस्मि हतोऽसीति च दारुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2077290, "chapter_id": 2636, "verse_number": "१२-१४१-४६", "content_sanskrit": "विश्वामित्रोऽहमित्येव सहसा तमुवाच ह।\nसहसाऽभ्यागतं भूयः सोद्वेगस्तेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2077291, "chapter_id": 2636, "verse_number": "१२-१४१-४७", "content_sanskrit": "विश्वामित्रोऽहमायुष्मन्नागतोऽहं बुभुक्षितः।\nमा वधीर्मम सद्बुद्धे यदि सम्यक्प्रपश्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2077292, "chapter_id": 2636, "verse_number": "१२-१४१-४८", "content_sanskrit": "चण्डालस्तद्वचः श्रुत्वा महर्षेर्भावितात्मनः।\nशयनादुपसंभ्रान्त उद्ययौ प्रति तं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2077293, "chapter_id": 2636, "verse_number": "१२-१४१-४९", "content_sanskrit": "स विसृज्याश्रु नेत्राभ्यां बहुमानात्कृताञ्जलिः।\nउवाच कौशिकं रात्रौ ब्रह्मन्किं ते चिकीर्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2077294, "chapter_id": 2636, "verse_number": "१२-१४१-५०", "content_sanskrit": "विश्वामित्रस्तु मातङ्गमुवाच परिसान्त्वयन्।\nक्षुधितोऽन्तर्गतप्राणो हरिष्यामि श्वजाघनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2077295, "chapter_id": 2636, "verse_number": "१२-१४१-५१", "content_sanskrit": "क्षुधितः कलुषं यातो नास्ति ह्रीरशनार्थिनः।\nक्षुच्च मां दूषयत्यत्र हरिष्यामि श्वजाघनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2077296, "chapter_id": 2636, "verse_number": "१२-१४१-५२", "content_sanskrit": "अवसीदन्ति मे प्राणाः स्मृतिर्मे नश्यति क्षुधा।\nदुर्बलो नष्टसंज्ञश्च भक्ष्याभक्ष्यविवर्जितः।\nसोधर्मं बुध्यमानोऽपि हरिष्यामि श्वजाघनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2077297, "chapter_id": 2636, "verse_number": "१२-१४१-५३", "content_sanskrit": "यदा भैक्षं न विन्दामि युष्माकमहमालये।\nतदा बुद्धिः कृता पापे हरिष्यामि श्वजाघनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2077298, "chapter_id": 2636, "verse_number": "१२-१४१-५४", "content_sanskrit": "अग्निर्मुखं पुरोधाश्च देवानां शुचिषाङ्विभुः।\nयथा च सर्वभुग्ब्रह्मा तथा मां विद्धि धर्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2077299, "chapter_id": 2636, "verse_number": "१२-१४१-५५", "content_sanskrit": "तमुवाच स चण्डालो महर्षे शृणु मे वचः।\nश्रुत्वा तथा तमातिष्ठ यथा धर्मो न हीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2077300, "chapter_id": 2636, "verse_number": "१२-१४१-५६", "content_sanskrit": "धर्मं तवापि विप्रर्षे शृणु यत्ते ब्रवीम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2077301, "chapter_id": 2636, "verse_number": "१२-१४१-५७", "content_sanskrit": "मृगाणामधमं श्वानं प्रवदन्ति मनीषिणः।\nतस्याप्यधम उद्देशः शरीरस्य तु जाघी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2077302, "chapter_id": 2636, "verse_number": "१२-१४१-५८", "content_sanskrit": "नेदं सम्यग्व्यवसितं महर्षे कर्म गर्हितम्।\nचण्डालस्वस्य हरणमभक्ष्यस्य विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2077303, "chapter_id": 2636, "verse_number": "१२-१४१-५९", "content_sanskrit": "साध्वन्यमनुपश्य त्वमुपायं प्राणधारणे।\nश्वमांसलोभात्तपसो नाशस्ते स्यान्महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2077304, "chapter_id": 2636, "verse_number": "१२-१४१-६०", "content_sanskrit": "जानता विहितो मार्गो न कार्यो धर्मसंकरः।\nमा स्म धर्मं परित्याक्षीस्त्वं हि धर्मविदुत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2077305, "chapter_id": 2636, "verse_number": "१२-१४१-६१", "content_sanskrit": "विश्वामित्रस्ततो राजन्नित्युक्तो भरतर्षभ।\nक्षुधार्तः प्रत्युवाचेदं पुनरेव महामुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2077306, "chapter_id": 2636, "verse_number": "१२-१४१-६२", "content_sanskrit": "निराहारस्य सुमहान्मम कालोऽभिधावतः।\nन विद्यतेऽप्युपायश्च कश्चिन्मे प्राणधारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2077307, "chapter_id": 2636, "verse_number": "१२-१४१-६३", "content_sanskrit": "येनकेन विशेषेण कर्मणा येनकेनचित्।\nउज्जिहीर्षे सीदमानः समर्थो धर्ममाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2077308, "chapter_id": 2636, "verse_number": "१२-१४१-६४", "content_sanskrit": "ऐन्द्रो धर्मः क्षत्रियाणां ब्राह्मणानामथाग्निकः।\nब्रह्मवह्निर्मम बलं भोक्ष्यामि शमयन्क्षुधाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2077309, "chapter_id": 2636, "verse_number": "१२-१४१-६५", "content_sanskrit": "यथायथैव जीवेद्धि तत्कर्तव्यमहेलया।\nजीवितं मरणाच्छ्रेयो जीवन्धर्ममवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2077310, "chapter_id": 2636, "verse_number": "१२-१४१-६६", "content_sanskrit": "सोऽहं जीवितमाकाङ्क्षन्नभक्ष्यस्यापि भक्षणम्।\nव्यवस्ये बुद्धिपूर्वं वै तद्भवाननुमन्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2077311, "chapter_id": 2636, "verse_number": "१२-१४१-६७", "content_sanskrit": "जीवन्धर्मं चरिष्यामि प्रणोत्स्याम्यशुभानि तु।\nतपोभिर्विद्यया चैव ज्योतींषीव महत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2077312, "chapter_id": 2636, "verse_number": "१२-१४१-६८x", "content_sanskrit": "श्वपच उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2077313, "chapter_id": 2636, "verse_number": "१२-१४१-६८", "content_sanskrit": "नैतत्खादन्प्राप्स्यसे प्राणमद्य\nनायुर्दीर्घं नामृतस्येव तृप्तिम्।\nभिक्षामन्यां भिक्ष मा ते मनोस्तु\nश्वभक्षणे श्वा ह्यभक्ष्यो द्विजानाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2077314, "chapter_id": 2636, "verse_number": "१२-१४१-६९x", "content_sanskrit": "विश्वामित्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2077315, "chapter_id": 2636, "verse_number": "१२-१४१-६९", "content_sanskrit": "न दुर्भिक्षे सुलभं मांसमन्य\nच्छ्वपाकमन्ये न च मेऽस्ति वित्तम।\nक्षुघार्तश्चाहमगतिर्निराशः\nश्वजाघनीं ष़ड्सात्साधु मन्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2077316, "chapter_id": 2636, "verse_number": "१२-१४१-७०x", "content_sanskrit": "श्वपच उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2077317, "chapter_id": 2636, "verse_number": "१२-१४१-७०", "content_sanskrit": "पञ्च पञ्चनखा भक्ष्या ब्रह्मक्षत्रस्य वै विशः।\n`शल्यकः श्वाविधो गोधा शशः कूर्मश्च पञ्चमः।\nयदि शास्त्रं प्रमाणं ते माऽभक्ष्ये वै मनः कृथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2077318, "chapter_id": 2636, "verse_number": "१२-१४१-७१x", "content_sanskrit": "विश्वामित्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2077319, "chapter_id": 2636, "verse_number": "१२-१४१-७१", "content_sanskrit": "अगस्त्येनासुरो जग्धो वातापिः क्षुधितेन वै।\nअहमापद्गतः क्षुब्धो भक्षयिष्ये श्वजाघनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2077320, "chapter_id": 2636, "verse_number": "१२-१४१-७२x", "content_sanskrit": "श्वपच उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2077321, "chapter_id": 2636, "verse_number": "१२-१४१-७२", "content_sanskrit": "भिक्षामन्यामाहरेति न च कर्तुमिहार्हसि।\nन नूनं कार्यमेतद्वै हर कामं श्वजाघनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2077322, "chapter_id": 2636, "verse_number": "१२-१४१-७३x", "content_sanskrit": "विश्वामित्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2077323, "chapter_id": 2636, "verse_number": "१२-१४१-७३", "content_sanskrit": "शिष्टा वै कारणं धर्मे तद्वृत्तमनुवर्तये।\nपरां मेध्याशनादेनां भक्ष्यां मन्ये श्वजाघनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2077324, "chapter_id": 2636, "verse_number": "१२-१४१-७४x", "content_sanskrit": "श्वपच उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2077325, "chapter_id": 2636, "verse_number": "१२-१४१-७४", "content_sanskrit": "असद्भिर्यः समाचीर्णो न स धर्मः सनातनः।\nअकार्यमिह कार्यं वा मा छलेनाशुभं कृथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2077326, "chapter_id": 2636, "verse_number": "१२-१४१-७५x", "content_sanskrit": "विश्वामित्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2077327, "chapter_id": 2636, "verse_number": "१२-१४१-७५", "content_sanskrit": "न पातकं नावमतमृषिः सन्कर्तुमर्हति।\nसमौ च श्वमृगौ मन्ये तस्माद्भोक्ष्ये श्वजाघनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2077328, "chapter_id": 2636, "verse_number": "१२-१४१-७६x", "content_sanskrit": "श्वपच उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2077329, "chapter_id": 2636, "verse_number": "१२-१४१-७६", "content_sanskrit": "यद्ब्राह्मणार्थे कृतमर्थिनेन\nतेनर्षिणा तदभक्ष्यं न कामात्।\nस वै धर्मो यत्र न पापमस्ति\nसर्वैरुपायैर्गुरवो हि रक्ष्याः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2077330, "chapter_id": 2636, "verse_number": "१२-१४१-७७x", "content_sanskrit": "विश्वामित्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2077331, "chapter_id": 2636, "verse_number": "१२-१४१-७७", "content_sanskrit": "मित्रं च मे ब्राह्मणस्यायमात्मा\nप्रियश्च मे पूज्यतमश्च लोके।\nतद्भोक्तुकामोऽहमिमां जिहीर्षे\nनृशंसानामीदृशानां न विभ्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2077332, "chapter_id": 2636, "verse_number": "१२-१४१-७८x", "content_sanskrit": "श्वपच उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2077333, "chapter_id": 2636, "verse_number": "१२-१४१-७८", "content_sanskrit": "कामं नरा जीवितं संत्यजन्ति\nन चाभक्ष्ये क्वचित्कुर्वन्ति बुद्धिम्।\nसर्वांश्च कामान्प्राप्नुवन्तीति विद्धि\nस्वर्गे निवासात्सहते क्षुधां वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2077334, "chapter_id": 2636, "verse_number": "१२-१४१-७९x", "content_sanskrit": "विश्वामित्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2077335, "chapter_id": 2636, "verse_number": "१२-१४१-७९", "content_sanskrit": "स्थाने भवेत्स यशः प्रेत्यभावे\nनिःसंशयः कर्मणां वै विनाशः।\nअहं पुनर्व्रतनित्यः शमात्मा\nमूलं रक्ष्यं भक्षयिष्याम्यभक्ष्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2077336, "chapter_id": 2636, "verse_number": "१२-१४१-८०", "content_sanskrit": "बुद्ध्यात्मके व्यक्तमस्तीति सृष्टो\nमोक्षात्मके त्वं यथा शिष्टचक्षुः।\nयद्यप्येतत्संशयाच्च त्रपामि\nनाहं भविष्यामि यथा न माया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2077337, "chapter_id": 2636, "verse_number": "१२-१४१-८१x", "content_sanskrit": "श्वपच उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2077338, "chapter_id": 2636, "verse_number": "१२-१४१-८१", "content_sanskrit": "गोपनीयमिदं दुःखमिति मे निश्चिता मतिः।\nदुष्कृतं ब्राह्मणं सन्तं यस्त्वामहमुपालभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2077339, "chapter_id": 2636, "verse_number": "१२-१४१-८२x", "content_sanskrit": "विश्वामित्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2077340, "chapter_id": 2636, "verse_number": "१२-१४१-८२", "content_sanskrit": "पिबन्त्येवोदकं गावो मण्डूकेषु रुवत्स्वपि।\nन तेऽधिकारो धर्मेऽस्ति वा भूरात्मप्रशंसकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2077341, "chapter_id": 2636, "verse_number": "१२-१४१-८३x", "content_sanskrit": "श्वपच उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2077342, "chapter_id": 2636, "verse_number": "१२-१४१-८३", "content_sanskrit": "सुहृद्भूत्वाऽनुशोचे त्वां कृपा हि त्वयि मे द्विज।\nतदिदं श्रेय आधत्स्व मा लोभे चेत आदधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2077343, "chapter_id": 2636, "verse_number": "१२-१४१-८४x", "content_sanskrit": "विश्वामित्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2077344, "chapter_id": 2636, "verse_number": "१२-१४१-८४", "content_sanskrit": "सृहृन्मे त्वं सुखेप्सुश्चेदापदो मां समुद्धर।\nजामऽहं धर्मतोऽऽत्मानमुत्सृजेमां श्वजाघनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2077345, "chapter_id": 2636, "verse_number": "१२-१४१-८५x", "content_sanskrit": "श्वपच उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2077346, "chapter_id": 2636, "verse_number": "१२-१४१-८५", "content_sanskrit": "नैवोत्सहे भवतो दातुमेतां\nनोपेक्षितुं ह्रियमाणं स्वमन्नम्।\nउभौ स्यावः श्वमलेनानुलिप्तौ\nदाता चाहं ब्राह्मणस्त्वं प्रतीच्छम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2077347, "chapter_id": 2636, "verse_number": "१२-१४१-८६x", "content_sanskrit": "विश्वामित्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2077348, "chapter_id": 2636, "verse_number": "१२-१४१-८६", "content_sanskrit": "अद्याहमेतद्वॄजिनं कर्म कृत्वा\nजीवंश्चरिष्यामि महापवित्रम्।\nसंपूतात्मा धर्ममेवाभिपत्स्ये\nयदेतयोर्गुरु तद्वै ब्रवीहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2077349, "chapter_id": 2636, "verse_number": "१२-१४१-८७x", "content_sanskrit": "श्वपच उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2077350, "chapter_id": 2636, "verse_number": "१२-१४१-८७", "content_sanskrit": "आत्मैव साक्षी किल धर्मकृत्ये\nत्वमेव जानासि यदत्र दुष्कृतम्।\nयो ह्याद्रियाद्भक्ष्यमिति श्वमांसं\nमन्ये न तस्यास्ति विवर्जनीयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2077351, "chapter_id": 2636, "verse_number": "१२-१४१-८८x", "content_sanskrit": "विश्वामित्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2077352, "chapter_id": 2636, "verse_number": "१२-१४१-८८", "content_sanskrit": "उपधानैः साधते नापि दोषः\nकार्ये सिद्धे मित्र नात्रापवादः।\nअस्मिन्नहिंसा नानृते वाक्यलेशो\nभक्ष्यक्रिया यत्र न तद्गरीयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2077353, "chapter_id": 2636, "verse_number": "१२-१४१-८९x", "content_sanskrit": "श्वपच उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2077354, "chapter_id": 2636, "verse_number": "१२-१४१-८९", "content_sanskrit": "यद्येष हेतुस्तव खादने स्या\nन्न ते वेदः कारणं नार्यधर्मः।\nतस्माद्भक्ष्ये भक्षणे वा द्विजेन्द्र\nदोषं न पश्यामि यथेदमत्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2077355, "chapter_id": 2636, "verse_number": "१२-१४१-९०x", "content_sanskrit": "विश्वामित्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2077356, "chapter_id": 2636, "verse_number": "१२-१४१-९०", "content_sanskrit": "न पातकं भक्षमाणस्य दृष्टं\nसुरां तु पीत्वा पततीति शब्दः।\nअन्योन्यकार्याणि यथा तथैव\nन लेपमात्रेण कृतं हिनस्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2077357, "chapter_id": 2636, "verse_number": "१२-१४१-९१x", "content_sanskrit": "श्वपच उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2077358, "chapter_id": 2636, "verse_number": "१२-१४१-९१", "content_sanskrit": "`पादौ मूलं समभवद्वृन्ताकं शिर उच्यते।\nशेफात्तु गृञ्जरं जातं पलाण्डुस्त्वण्डसंभवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2077359, "chapter_id": 2636, "verse_number": "१२-१४१-९२", "content_sanskrit": "श्वरोमजः शैव्यशाको लशुनं द्विजसंभवम्।\nचुक्किनामा पर्णशाकः कर्णादजनि भूसुर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2077360, "chapter_id": 2636, "verse_number": "१२-१४१-९३", "content_sanskrit": "अस्थानतो हीनतः कुत्सिताद्वा\nतद्विद्वांसं बाधते साधु वृत्तम्।\nश्वानं पुनर्यो लभतेऽभिषङ्गा\nत्तेनापि दण्डः सहितव्य एव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2077361, "chapter_id": 2636, "verse_number": "१२-१४१-९४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2077362, "chapter_id": 2636, "verse_number": "१२-१४१-९४", "content_sanskrit": "एवमुक्त्वा निववृते मातङ्गः कौशिकं तदा।\nविश्वामित्रो जहारैव कृतबुद्धिः श्वजाघनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2077363, "chapter_id": 2636, "verse_number": "१२-१४१-९५", "content_sanskrit": "ततो जग्राह स श्वाङ्गं जीवितार्थी महामुनिः।\nसदारस्तामुपाहृत्य वने भोक्तुमियेप सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2077364, "chapter_id": 2636, "verse_number": "१२-१४१-९६", "content_sanskrit": "अथास्य बुद्धिरभवद्विधिनाऽहं श्वजाघनीम्।\nभक्षयामि यथाकालं पूर्वं संतर्प्य देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2077365, "chapter_id": 2636, "verse_number": "१२-१४१-९७", "content_sanskrit": "ततोऽग्निमुपसंहृत्य ब्राह्मेण विधिना मुनिः।\nऐन्द्राग्नेयेन विधिना चरुं श्रपयत स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2077366, "chapter_id": 2636, "verse_number": "१२-१४१-९८", "content_sanskrit": "ततः समारभत्कर्म दैवं पित्र्यं च भारत।\nआहूय देवानिन्द्रादीन्भागंभागं विधिक्रमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2077367, "chapter_id": 2636, "verse_number": "१२-१४१-९९", "content_sanskrit": "एतस्मिन्नेव काले तु प्रववर्ष स वासवः।\nसंजीवयन्प्रजाः सर्वा जनयामास चौषधीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2077368, "chapter_id": 2636, "verse_number": "१२-१४१-१००", "content_sanskrit": "विश्वामित्रोऽपि भगवांस्तपसा दग्धकिल्चिषः।\nकालेन महता सिद्धिमवाप परमाद्भुताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2077369, "chapter_id": 2636, "verse_number": "१२-१४१-१०१", "content_sanskrit": "स संहृत्य च तत्कर्म अनास्वाद्य च तद्धविः।\nतोषयामास देवांश्च पितॄंश्च द्विजसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2077370, "chapter_id": 2636, "verse_number": "१२-१४१-१०२", "content_sanskrit": "एवं विद्वानदीनात्मा व्यसनस्थो जिजीविषुः।\nसर्वोपायैरुपायज्ञो दीनमात्मानमुद्धरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2077371, "chapter_id": 2636, "verse_number": "१२-१४१-१०३", "content_sanskrit": "एतां बुद्धिं समास्थाय जीवितव्यं सदा भवेत्।\nजीवन्पुण्यमवाप्नोति पुरुषो भद्रमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2077372, "chapter_id": 2636, "verse_number": "१२-१४१-१०४", "content_sanskrit": "तस्मात्कौन्तेय विदुषा धर्माधर्मविनिश्चये।\nबुद्धिमास्थाय लोकेऽस्मिन्वर्तितव्यं कृतात्मना॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2077373, "chapter_id": 2636, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि एकचत्वारिंशदधिकशततमोऽध्यायः॥ १४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}]