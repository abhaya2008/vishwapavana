[{"id": 7004438000, "chapter_id": 24438, "verse_number": "५-३-१३२-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेत्तु राजेन्द्र उत्तरे नर्मदातटे ।\nसर्वपापहरं तीर्थं वाराहं नाम नामतः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004438001, "chapter_id": 24438, "verse_number": "५-३-१३२-२", "content_sanskrit": "तत्र देवो जगद्धाता वाराहं रूपमास्थितः ।\nस्थितो लोकहितार्थाय संसारार्णवतारकः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004438002, "chapter_id": 24438, "verse_number": "५-३-१३२-३", "content_sanskrit": "तत्र तीर्थे तु यः स्नात्वा पूजयेद्धरणीधरम् ।\nगन्धमाल्यविशेषैश्च जयशब्दादिमङ्गलैः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004438003, "chapter_id": 24438, "verse_number": "५-३-१३२-४", "content_sanskrit": "उपवासपरो भूत्वा द्वादश्यां नृपसत्तम ।\nवृषलाः पापकर्माणस्तथैवान्धपिशाचिनः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004438004, "chapter_id": 24438, "verse_number": "५-३-१३२-५", "content_sanskrit": "आलापाद्गात्रसंपर्कान्निःश्वासात्सहभोजनात् ।\nपापं संक्रमते यस्मात्तस्मात्तान् परिवर्जयेत्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004438005, "chapter_id": 24438, "verse_number": "५-३-१३२-६", "content_sanskrit": "ब्राह्मणान् पूजयेद्भक्त्या यथाशक्त्या यथाविधि ।\nरात्रौ जागरणं कार्यं कथायां तत्र भारत॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004438006, "chapter_id": 24438, "verse_number": "५-३-१३२-७", "content_sanskrit": "प्रभाते विमले स्नात्वा तत्र तीर्थे जगद्गुरुम् ।\nये पश्यन्ति जितक्रोधास्ते मुक्ताः सर्वपातकैः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004438007, "chapter_id": 24438, "verse_number": "५-३-१३२-८", "content_sanskrit": "यथा तु दृष्ट्वा भुजगाः सुपर्णं नश्यन्ति मुक्त्वा विषमुग्रतेजः ।\nनश्यन्ति पापानि तथैव शीघ्रं दृष्ट्वा मुखं शूकररूपिणस्तु॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004438008, "chapter_id": 24438, "verse_number": "५-३-१३२-९", "content_sanskrit": "नभोगतं नश्यति चान्धकारं दृष्ट्वा रविं देववरं तथैव ।\nनश्यन्ति पापानि सुदुस्तराणि दृष्ट्वा मुखं पार्थ धराधरस्य॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004438009, "chapter_id": 24438, "verse_number": "५-३-१३२-१०", "content_sanskrit": "किं तस्य बहुभिर्मन्त्रैर्भक्तिर्यस्य जनार्दने ।\nनमो नारायणायेति मन्त्रः सर्वार्थसाधकः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004438010, "chapter_id": 24438, "verse_number": "५-३-१३२-११", "content_sanskrit": "एकोऽपि कृष्णस्य कृतः प्रणामो दशाश्वमेधावभृथेन तुल्यः ।\nदशाश्वमेधी पुनरेति जन्म कृष्णप्रणामी न पुनर्भवाय॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004438011, "chapter_id": 24438, "verse_number": "५-३-१३२-१२", "content_sanskrit": "ध्यायमाना महात्मानो रूपं नारायणं हरेः ।\nये त्यजन्ति स्वकं देहं तत्र तीर्थे जितेन्द्रियाः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004438012, "chapter_id": 24438, "verse_number": "५-३-१३२-१३", "content_sanskrit": "ते गच्छन्त्यमलं स्थानं यत्सुरैरपि दुर्लभम् ।\nक्षराक्षरविनिर्मुक्तं तद्विष्णोः परमं पदम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]