[{"id": 900009233, "chapter_id": 8735, "verse_number": "25.1", "content_sanskrit": "अस्य च शब्दस्य वृत्तिस्त्रिधा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009234, "chapter_id": 8735, "verse_number": "25.2", "content_sanskrit": "अत्र केचित्– पङ्कजादिशब्दास्तामरसे पद्मशब्दवद्रूढा एव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009235, "chapter_id": 8735, "verse_number": "25.3", "content_sanskrit": "मणौ तु– पदमेव पदार्थस्मारकम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009236, "chapter_id": 8735, "verse_number": "25.4", "content_sanskrit": "यत्तूक्तं मण्यादौ पङ्कजकुमुदमानयेत्यत्र ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009237, "chapter_id": 8735, "verse_number": "25.5", "content_sanskrit": "मुख्यार्थसम्बन्धो वा तं निमित्तीकृत्य वृत्तिर्वा लक्षणा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900009238, "chapter_id": 8735, "verse_number": "25.6", "content_sanskrit": "अन्ये तु– ‘‘मुख्यार्थबाधे तद्योगे रूढितोथ प्रयोजनात् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900009239, "chapter_id": 8735, "verse_number": "25.7", "content_sanskrit": "ननु गङ्गाशब्दस्य पूर इव तीरेपि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900009240, "chapter_id": 8735, "verse_number": "25.8", "content_sanskrit": "यत्तु मणावुक्तम्– वाचकमेवानुभावकम् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900009241, "chapter_id": 8735, "verse_number": "25.9", "content_sanskrit": "यच्चोक्तं मणौ– गङ्गाशब्देन वस्तुगत्या ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900009242, "chapter_id": 8735, "verse_number": "25.10", "content_sanskrit": "अथ परशब्दस्य परत्र वृत्तित्वाविशेषात्कथं गौणी लक्षणातो भिन्ना", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900009243, "chapter_id": 8735, "verse_number": "25.11", "content_sanskrit": "अन्येतु सिंहनिष्ठशौर्यादिगुणा लक्ष्यमाणाः सिंहशब्दस्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900009244, "chapter_id": 8735, "verse_number": "25.12", "content_sanskrit": "अत्र मुख्यवृत्तित्रये पङ्कजादिशब्देषु रूढेर्योगाच्च योगरूढिः प्रबला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900009245, "chapter_id": 8735, "verse_number": "25.13", "content_sanskrit": "अमुख्यवृत्तौ गौणीतो लक्षणा जघन्या", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]