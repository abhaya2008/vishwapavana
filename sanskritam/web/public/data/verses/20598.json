[{"id": 7000598000, "chapter_id": 20598, "verse_number": "५-५७-१", "content_sanskrit": "वात्स्यायन उवाच ।\nजगत्पवित्रसत्कीर्ति जानक्या वाच्यवाचनम् ।\nकथं समकरोत्स्वामी तन्मे कथय सुव्रत॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000598001, "chapter_id": 20598, "verse_number": "५-५७-२", "content_sanskrit": "यथा मे मनसः सौख्यं भविष्यति सुशोभनम् ।\nतथा कुरुष्व शेषाद्य त्वन्मुखान्निःसृतामृतम् ।\nपिबतस्तृप्तिरेव स्याद्यया संसृतिकृं तनम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000598002, "chapter_id": 20598, "verse_number": "५-५७-३", "content_sanskrit": "शेष उवाच ।\nमिथिलायां महापुर्यां जनको नाम भूपतिः ।\nतस्यां करोति सद्राज्यं धर्मेणाराधयन्प्रजाः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000598003, "chapter_id": 20598, "verse_number": "५-५७-४", "content_sanskrit": "तस्य संकर्षतो भूमिं सीतया दीर्घमुख्यया ।\nसीरध्वजस्य निरगात्कुमारी ह्यतिसुंदरी॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000598004, "chapter_id": 20598, "verse_number": "५-५७-५", "content_sanskrit": "तदात्यंतं मुदं प्राप्तः सीरकेतुर्महीपतिः ।\nसीता नामाकरोत्तस्या मोहिन्या जगतः श्रियः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000598005, "chapter_id": 20598, "verse_number": "५-५७-६", "content_sanskrit": "सैकदोद्यानविपिने खेलंती सुमनोहरा ।\nअपश्यत्स्वमनःकांतं शुकशुक्योर्युगं वदत्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000598006, "chapter_id": 20598, "verse_number": "५-५७-७", "content_sanskrit": "अत्यंतं हर्षमापन्नमत्यंतं कामलोलुपम् ।\nपरस्परं भाषमाणं स्नेहेन शुभया गिरा॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000598007, "chapter_id": 20598, "verse_number": "५-५७-८", "content_sanskrit": "रममाणं तदा युग्मं नभसि क्षिप्रवेगतः ।\nसमुत्पतन्नगोपस्थे स्थितं शब्दं चकार तत्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000598008, "chapter_id": 20598, "verse_number": "५-५७-९", "content_sanskrit": "रामो महीपतिर्भूमौ भविष्यति मनोहरः ।\nतस्य सीतेति नाम्ना तु भविष्यति महेलिका॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000598009, "chapter_id": 20598, "verse_number": "५-५७-१०", "content_sanskrit": "स तया सह वर्षाणां सहस्राण्येकयुग्दश ।\nराज्यं करिष्यते धीमान्कर्षन्भूमिपतीन्बली॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000598010, "chapter_id": 20598, "verse_number": "५-५७-११", "content_sanskrit": "धन्या सा जानकी देवी धन्योऽसौ रामसंज्ञितः ।\nयौ परस्परमापन्नौ पृथिव्यां रंस्यतो मुदा॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000598011, "chapter_id": 20598, "verse_number": "५-५७-१२", "content_sanskrit": "इति संभाष्यमाणं तु शुकयुग्मं तु मैथिली ।\nज्ञात्वेदं देवतायुग्मं वाणीं तस्य विलोक्य च॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000598012, "chapter_id": 20598, "verse_number": "५-५७-१३", "content_sanskrit": "मदीयास्तु कथा रम्याः कुरुते शुकयोर्युगम् ।\nएतद्गृहीत्वा पृच्छामि सर्वं वाक्यं गतार्थकम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000598013, "chapter_id": 20598, "verse_number": "५-५७-१४", "content_sanskrit": "एवं विचार्य सा स्वीयाः सखीः प्रतिजगाद ह ।\nगृह्णंतु शनकैरेतत्पक्षियुग्मं मनोहरम्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000598014, "chapter_id": 20598, "verse_number": "५-५७-१५", "content_sanskrit": "सख्यस्तास्तद्गिरिं गत्वा गृह्णन्पक्षियुगं वरम् ।\nनिवेदयामासुरिदं स्वसख्याः प्रियकाम्यया॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000598015, "chapter_id": 20598, "verse_number": "५-५७-१६", "content_sanskrit": "बहुधा विविधाञ्छब्दान्कुर्वद्वीक्ष्य मनोहरम् ।\nआश्वासयामास तदा पप्रच्छ तदिदं वचः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000598016, "chapter_id": 20598, "verse_number": "५-५७-१७", "content_sanskrit": "सीतोवाच ।\nमा भैषातां युवां रम्यौ कौ वां कुत्र समागतौ ।\nको रामः का च सा सीता तज्ज्ञानं तु कुतः स्मृतम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000598017, "chapter_id": 20598, "verse_number": "५-५७-१८", "content_sanskrit": "तत्सर्वं शंसतं क्षिप्रं मत्तो वां व्येतु यद्भयम् ।\nइति पृष्टं तया पक्षियुगं सर्वमशंसत॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000598018, "chapter_id": 20598, "verse_number": "५-५७-१९", "content_sanskrit": "पक्षियुग्ममुवाच ।\nवाल्मीकिरास्ते सुमहानृषिर्धर्मविदुत्तमः ।\nआवां तदाश्रमस्थाने सर्वदा सुमनोहरे॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000598019, "chapter_id": 20598, "verse_number": "५-५७-२०", "content_sanskrit": "सशिष्यान्गापयामास भावि रामायणं मुनिः ।\nप्रत्यहं तत्पदस्मारी सर्वभूतहिते रतः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000598020, "chapter_id": 20598, "verse_number": "५-५७-२१", "content_sanskrit": "तदावाभ्यां श्रुतं सर्वं भावि रामायणं महत् ।\nमुहुर्मुहुर्गीयमानमायातं परिपाठतः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000598021, "chapter_id": 20598, "verse_number": "५-५७-२२", "content_sanskrit": "शृण्वावां तेऽभिधास्यावो यो रामो या च जानकी ।\nयद्यद्भविष्यते तस्या रामेण क्रीडितात्मना॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000598022, "chapter_id": 20598, "verse_number": "५-५७-२३", "content_sanskrit": "ऋष्यशृंगकृतेष्ट्यां च चतुर्धा त्वंगतो हरिः ।\nप्रादुर्भविष्यति श्रीमान्सुरस्त्रीगीतसत्कथः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000598023, "chapter_id": 20598, "verse_number": "५-५७-२४", "content_sanskrit": "स कौशिकेन मिथिलां प्राप्स्यते भ्रातृसंयुतः ।\nधनुष्पाणिस्तदा दृष्ट्वा दुर्ग्राह्यमन्यभूभुजाम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000598024, "chapter_id": 20598, "verse_number": "५-५७-२५", "content_sanskrit": "धनुर्भंक्त्वा जनकजां प्राप्स्यते सुमनोहराम् ।\nतया सह महद्राज्यं करिष्यति श्रुतं वरे॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000598025, "chapter_id": 20598, "verse_number": "५-५७-२६", "content_sanskrit": "एतदन्यच्च तत्रस्थैः श्रुतमस्माभिरुद्गतैः ।\nकथितं तव चार्वंगि मुंचावां गंतुकामुकौ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000598026, "chapter_id": 20598, "verse_number": "५-५७-२७", "content_sanskrit": "इति वाक्यं तयोर्धृत्वा श्रोत्रयोः सुमनोहरम् ।\nपुनरेवजगादेदं वाक्यं पक्षियुगं प्रति॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000598027, "chapter_id": 20598, "verse_number": "५-५७-२८", "content_sanskrit": "स रामः कुत्र वर्तेत कस्य पुत्रः कथं तु ताम् ।\nपरिग्रहीष्यति वरः कीदृग्रूपधरो नरः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000598028, "chapter_id": 20598, "verse_number": "५-५७-२९", "content_sanskrit": "मया पृष्टमिदं सर्वं कथयंतु यथातथम् ।\nपश्चात्सर्वं करिष्यामि प्रियं युष्मन्मनोहरम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000598029, "chapter_id": 20598, "verse_number": "५-५७-३०", "content_sanskrit": "तच्छ्रुत्वा तां तु कामेन पीडितां वीक्ष्य सा शुकी ।\nजानकीं हृदये ज्ञात्वा पपाठ पुरतस्ततः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000598030, "chapter_id": 20598, "verse_number": "५-५७-३१", "content_sanskrit": "सूर्यवंशध्वजो धीमान्राजा पंक्तिरथो बली ।\nयं देवाः श्रित्य सर्वारीन्विजेष्यंति च सर्वशः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000598031, "chapter_id": 20598, "verse_number": "५-५७-३२", "content_sanskrit": "तस्य भार्यात्रयं भावि शक्रमोहनरूपधृक् ।\nतस्मिन्नपत्य चातुष्कं भविष्यति बलोन्नतम्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000598032, "chapter_id": 20598, "verse_number": "५-५७-३३", "content_sanskrit": "सर्वेषामग्रजो रामो भरतस्तदनुस्मृतः ।\nलक्ष्मणस्तदनु श्रीमाञ्छत्रुघ्नः सर्वतो बली॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000598033, "chapter_id": 20598, "verse_number": "५-५७-३४", "content_sanskrit": "रघुनाथ इति ख्यातिं गमिष्यति महामनाः ।\nतेषामनंतनामानि रामस्य बलिनः सखि॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000598034, "chapter_id": 20598, "verse_number": "५-५७-३५", "content_sanskrit": "पद्मकोश इव शोभनं मुखं ।\nपंकजाभनयने सुदीर्घके ।\nउन्नता पृथुमनोहरा नसा ।\nवल्गुसंगत मनोहरे भ्रुवौ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000598035, "chapter_id": 20598, "verse_number": "५-५७-३६", "content_sanskrit": "जानुलंबित मनोहरौ भुजौ ।\nकंबुशोभिगलकोऽतिह्रस्वकः ।\nसत्कपाटतलविस्तृतश्रिकं ।\nवक्ष एतदमलं सलक्ष्मकम्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000598036, "chapter_id": 20598, "verse_number": "५-५७-३७", "content_sanskrit": "शोभनोरुकटिशोभया युतं ।\nजानुयुग्मममलं स्वसेवितम् ।\nपादपद्ममखिलैर्निजैः सदा ।\nसेवितं रघुपतिं सुशोभनम्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000598037, "chapter_id": 20598, "verse_number": "५-५७-३८", "content_sanskrit": "एतद्रूपधरो रामो मया किं तु स वर्ण्यते ।\nशताननोपि नो याति पक्षिणः किमु मादृशाः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000598038, "chapter_id": 20598, "verse_number": "५-५७-३९", "content_sanskrit": "यद्रूपं वीक्ष्य ललिता मनोहरवपुर्धरा ।\nलक्ष्मीर्मुमोह भुविका वर्तते या न मोहति॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000598039, "chapter_id": 20598, "verse_number": "५-५७-४०", "content_sanskrit": "महाबलो महावीर्यो महामोहनरूपधृक् ।\nकिं वर्णयामि श्रीरामं सर्वैश्वर्यगुणान्वितम्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000598040, "chapter_id": 20598, "verse_number": "५-५७-४१", "content_sanskrit": "धन्या सा जानकीदेवी महामोहनरूपधृक् ।\nरंस्यते येन सहिता वर्षाणामयुतं मुदा॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000598041, "chapter_id": 20598, "verse_number": "५-५७-४२", "content_sanskrit": "त्वं कासि किं तु नामासि बत सुंदरि यत्तु माम् ।\nपरिपृच्छसि वैदग्ध्याद्रामकीर्तनमादरात्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000598042, "chapter_id": 20598, "verse_number": "५-५७-४३", "content_sanskrit": "एतद्वाक्यं समाकर्ण्य जानकी पक्षिणोर्युगम् ।\nउवाच जन्मललितं शंसंती स्वस्य मोहनम्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000598043, "chapter_id": 20598, "verse_number": "५-५७-४४", "content_sanskrit": "या त्वया जानकी प्रोक्ता साहं जनकपुत्रिका ।\nस रामो मां यदाभ्येत्य प्राप्स्यते सुमनोहरः॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000598044, "chapter_id": 20598, "verse_number": "५-५७-४५", "content_sanskrit": "तदा वां मोचयाम्यद्धानान्यथा वाक्यलोभिता ।\nलालयामि सुखेनास्तां मद्गेहे मधुराक्षरौ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000598045, "chapter_id": 20598, "verse_number": "५-५७-४६", "content_sanskrit": "इत्युक्तं तत्समाकर्ण्य वेपतुर्भयतां गतौ ।\nपरस्परं प्रक्षुभितौ जानकीमित्यवोचताम्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000598046, "chapter_id": 20598, "verse_number": "५-५७-४७", "content_sanskrit": "वयं वै पक्षिणः साध्वि वनस्था वृक्षगोचराः ।\nपरिभ्रमाम सर्वत्र नो सुखं नो भवेद्गृहे॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000598047, "chapter_id": 20598, "verse_number": "५-५७-४८", "content_sanskrit": "अंतर्वत्नी स्वके स्थाने गत्वा संसूय पुत्रकान् ।\nत्वत्स्थानमागमिष्यामि सत्यं मे ह्युदितं वचः॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000598048, "chapter_id": 20598, "verse_number": "५-५७-४९", "content_sanskrit": "एवं प्रोक्ता तया सा तु न मुमोच शुकीं स्वयम् ।\nतदापतिस्तां प्रोवाच विनीतवदनुत्सुकः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000598049, "chapter_id": 20598, "verse_number": "५-५७-५०", "content_sanskrit": "सीते मुंच कथं भार्यां रक्षसे मे मनोहरीम् ।\nआवां गच्छाव विपिने विचरावः सुखं वने॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000598050, "chapter_id": 20598, "verse_number": "५-५७-५१", "content_sanskrit": "अंतर्वत्नी तु वर्तेत भार्या मम मनोरमा ।\nतस्याः प्रसूतिं कृत्वा त्वामागमिष्यामि शोभने॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000598051, "chapter_id": 20598, "verse_number": "५-५७-५२", "content_sanskrit": "इत्युक्ता निजगादेमं सुखं गच्छ महामते ।\nएतां रक्षामि सुखिनीं मत्पार्श्वे प्रियकारिणीम्॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000598052, "chapter_id": 20598, "verse_number": "५-५७-५३", "content_sanskrit": "इत्युक्तो दुःखितः पक्षी तामूचे करुणान्वितः ।\nयोगिभिः प्रोच्यते यद्वै तद्वचस्तथ्यमेव हि॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000598053, "chapter_id": 20598, "verse_number": "५-५७-५४", "content_sanskrit": "न वक्तव्यं न वक्तव्यं मौनमाश्रित्य तिष्ठताम् ।\nनोचेत्स वाक्यदोषेण प्राप्नोत्यालानमुन्मदः॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000598054, "chapter_id": 20598, "verse_number": "५-५७-५५", "content_sanskrit": "वयं चेदत्र वाक्यं नाकरिष्याम नगोपरि ।\nबंधनं कथमावां स्यात्तस्मान्मौनं समाचरेत्॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000598055, "chapter_id": 20598, "verse_number": "५-५७-५६", "content_sanskrit": "इत्युक्त्वा तां प्रत्युवाच नाहं जीवामि सुंदरि ।\nएतया भार्यया सीते तस्मान्मुंच मनोहरे॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000598056, "chapter_id": 20598, "verse_number": "५-५७-५७", "content_sanskrit": "अनेकविधवाक्यैः सा बोधिता नामुचत्तदा ।\nकुपिता दुःखिता भार्या शशाप जनकात्मजाम्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000598057, "chapter_id": 20598, "verse_number": "५-५७-५८", "content_sanskrit": "यथा त्वं पतिना सार्धं वियोजयसि मामितः ।\nतथा त्वमपि रामेण वियुक्ता भव गर्भिणी॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000598058, "chapter_id": 20598, "verse_number": "५-५७-५९", "content_sanskrit": "इत्युक्तवत्यां तस्यां तु दुःखितायां पुनः पुनः ।\nप्राणा निरगमन्दुःखात्पतिदुःखेन पूरितात्॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000598059, "chapter_id": 20598, "verse_number": "५-५७-६०", "content_sanskrit": "रामं रामं स्मरंत्याश्च वदंत्यांश्च पुनः पुनः ।\nविमानमागतं सुष्ठु पक्षिणी स्वर्गता बभौ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000598060, "chapter_id": 20598, "verse_number": "५-५७-६१", "content_sanskrit": "तस्यां मृतायां दुःखार्तो भर्ता तस्याः स पक्षिराट् ।\nपरमं क्रोधमापन्नो जाह्नव्यां दुःखितोऽपतत्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000598061, "chapter_id": 20598, "verse_number": "५-५७-६२", "content_sanskrit": "तथा भवामि रामस्य नगरे जनपूरिते ।\nमद्वाक्यादियमुद्विग्ना वियोगेन सुदुःखिता॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000598062, "chapter_id": 20598, "verse_number": "५-५७-६३", "content_sanskrit": "इत्युक्त्वा स पपातोदे जाह्नव्या भ्रमशोभिते ।\nदुःखितः कुपितो भीतस्तद्वियोगेन कंपितः॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000598063, "chapter_id": 20598, "verse_number": "५-५७-६४", "content_sanskrit": "क्रुद्धत्वाद्दुःखितत्वाच्च सीताया अपमाननात् ।\nअंत्यजत्वं परं प्राप्तो रजकः क्रोधनाभिधः॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000598064, "chapter_id": 20598, "verse_number": "५-५७-६५", "content_sanskrit": "यः क्रोधाच्च स्वकान्प्राणान्महतां दुष्टमाचरन् ।\nसंत्यजेत्स मृतो याति अंत्यजत्वं द्विजोत्तमः॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000598065, "chapter_id": 20598, "verse_number": "५-५७-६६", "content_sanskrit": "तज्जातं रजकोक्त्यासौ निंदिता च वियोगिता ।\nरजकस्य च शापेन वियुक्ता सा वनं गता॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000598066, "chapter_id": 20598, "verse_number": "५-५७-६७", "content_sanskrit": "एतत्ते कथितं विप्र यत्ते पृष्टं विदेहजाम् ।\nपुनरत्र परं वृत्तं शृणुष्व निगदामि तत्॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]