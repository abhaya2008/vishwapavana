[{"id": 900001476, "chapter_id": 8237, "verse_number": "11.1", "content_sanskrit": "प्राणो वंश इति स्थविरः शाकल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001477, "chapter_id": 8237, "verse_number": "11.2", "content_sanskrit": "त्रयं त्वेव न एतत्प्रोक्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001478, "chapter_id": 8237, "verse_number": "11.3", "content_sanskrit": "सप्त च वै शतानि विंशतिश्व संवत्सरस्याहोरात्राः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001479, "chapter_id": 8237, "verse_number": "11.4", "content_sanskrit": "अथ कौण्ठरव्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001480, "chapter_id": 8237, "verse_number": "11.5", "content_sanskrit": "तस्यैतस्यात्मनस्तस्य शरीराख्यस्यात्मनो य आत्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001481, "chapter_id": 8237, "verse_number": "11.6", "content_sanskrit": "अहार्यत्वादहर्नामा रात्रिनामा रतिप्रदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900001482, "chapter_id": 8237, "verse_number": "11.7", "content_sanskrit": "मज्जास्वधिकसन्निधानज्ञापनार्थमिदं वचनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900001483, "chapter_id": 8237, "verse_number": "11.8", "content_sanskrit": "चत्वारः पुरुषा इति बाध्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900001484, "chapter_id": 8237, "verse_number": "11.9", "content_sanskrit": "स यश्वायमशरीरः प्रज्ञात्मा यश्चासावादित्य एकमेतदिति विद्यात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900001485, "chapter_id": 8237, "verse_number": "11.10", "content_sanskrit": "एतामनुविधं संहितां सन्धीयमानां मन्य इति ह स्माह बाध्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900001486, "chapter_id": 8237, "verse_number": "11.11", "content_sanskrit": "दुग्धदोहा अस्य वेदा भवन्ति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900001487, "chapter_id": 8237, "verse_number": "11.12", "content_sanskrit": "प्रत्यक्षज्ञानिनोऽप्येतदातनन्दह्रासकृद्भवेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900001488, "chapter_id": 8237, "verse_number": "11.13", "content_sanskrit": "तदप्येतदृषिणोक्तम्-यस्तित्याज सचिविदं सखायं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900001489, "chapter_id": 8237, "verse_number": "11.14", "content_sanskrit": "मुख्यत्यागो हरेरेव यन्नास्तीति वदेदमुम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900001490, "chapter_id": 8237, "verse_number": "11.15", "content_sanskrit": "रमाब्रह्मादिकानां च तारतम्यानभिज्ञता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900001491, "chapter_id": 8237, "verse_number": "11.16", "content_sanskrit": "निषिद्धकर्मकरणं विहितस्य च वर्जनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900001492, "chapter_id": 8237, "verse_number": "11.17", "content_sanskrit": "त्यागद्वयात् तु