ay_order": 41}, {"id": 900001517, "chapter_id": 8237, "verse_number": "11.42", "content_sanskrit": "स यदि विचिकित्सेत् सणकारं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 900001518, "chapter_id": 8237, "verse_number": "11.43", "content_sanskrit": "एतद्ध स्म वैतद्विद्वांस आहुः ऋषयः कावषेयाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 900001519, "chapter_id": 8237, "verse_number": "11.44", "content_sanskrit": "ता एताः संहिता नानन्तेवासिने प्रब्रूयात्..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 900001520, "chapter_id": 8237, "verse_number": "11.45", "content_sanskrit": "य एतेन 'ण' इति शब्देनाक्रियमाणं विष्णोः पूर्णबलं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 900001521, "chapter_id": 8237, "verse_number": "11.46", "content_sanskrit": "यद्वयं संहितायुक्तत्वेन वचोऽधीमहे तेनास्माकं णशब्दषशब्दार्थरूपो विष्णुरुपात्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 900001522, "chapter_id": 8237, "verse_number": "11.47", "content_sanskrit": "सर्वैश्च वैदिकपदैरपि लोकशब्दै-र्मेघाग्निवारिधितलादिरवैश्च सर्वैः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 900001523, "chapter_id": 8237, "verse_number": "11.48", "content_sanskrit": "यस्य त्रीण्युदितानि वेदवचने रूपाणि दिव्यान्यलं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 900001524, "chapter_id": 8237, "verse_number": "11.49", "content_sanskrit": "हनुशब्दो ज्ञानवाची हनुमान् मतिशब्दितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 900001525, "chapter_id": 8237, "verse_number": "11.50", "content_sanskrit": "साधको रामवाक्यानां तत्समीपगतः सदा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 900001526, "chapter_id": 8237, "verse_number": "11.51", "content_sanskrit": "पूर्णानन्दगुणोदारधाम्ने नित्याय वेधसे । अमन्दानन्दसान्द्राय प्रेयसे विष्णवे नमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]