[{"id": 40014179, "chapter_id": 9191, "verse_number": "1", "content_sanskrit": "सुग्रीवस्यवचश्श्रुत्वाहेतुमत्परमार्थवत् । प्रतिजग्राहकाकुत्स्थोहनूमन्तमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40014180, "chapter_id": 9191, "verse_number": "2", "content_sanskrit": "तपसासेतुबन्धेनसागरोच्छोषणेनच । सर्वथासुसमर्थोऽस्मिसागरस्यास्यलङ्घने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40014181, "chapter_id": 9191, "verse_number": "3", "content_sanskrit": "कतिदुर्गाणिदुर्गायालङ्कायाब्रूहितानिमे । ज्ञातुमिच्छामितत्सर्वंदर्शनादिववानर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40014182, "chapter_id": 9191, "verse_number": "4", "content_sanskrit": "बलस्यपरिमाणंचद्वारदुर्गक्रियामपि । गुप्तिकर्मचलङ्कायारक्षसांसदनानिच ॥ यथासुखंयथावच्छलङ्कायामसिदृष्टवान् । सर्वमाचक्ष्वतत्त्वेनसर्वथाकुशलोह्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40014183, "chapter_id": 9191, "verse_number": "5", "content_sanskrit": "बलस्यपरिमाणंचद्वारदुर्गक्रियामपि । गुप्तिकर्मचलङ्कायारक्षसांसदनानिच ॥ यथासुखंयथावच्छलङ्कायामसिदृष्टवान् । सर्वमाचक्ष्वतत्त्वेनसर्वथाकुशलोह्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40014184, "chapter_id": 9191, "verse_number": "6", "content_sanskrit": "श्रुत्वारामस्यवचनंहनुमान्मारुतात्मजः । वाक्यंवाक्यविदांश्रेष्ठोरामंपुनरथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40014185, "chapter_id": 9191, "verse_number": "7", "content_sanskrit": "श्रूयतांसर्वमाख्यास्येदुर्गकर्मविधानतः । गुप्तापुरीयथालङ्कारक्षिताचयथाबलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40014186, "chapter_id": 9191, "verse_number": "8", "content_sanskrit": "राक्षसाश्चयथास्निग्धारावणस्यचतेजसा । परांसमृद्धिंलङ्कायास्सागरस्यचभीमताम् ॥ विभागंचबलौघस्यनिर्देशंवाहनस्यच । एवमुक्त्वाकपिश्रेष्ठःकथयामासतत्त्ववित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40014187, "chapter_id": 9191, "verse_number": "9", "content_sanskrit": "राक्षसाश्चयथास्निग्धारावणस्यचतेजसा । परांसमृद्धिंलङ्कायास्सागरस्यचभीमताम् ॥ विभागंचबलौघस्यनिर्देशंवाहनस्यच । एवमुक्त्वाकपिश्रेष्ठःकथयामासतत्त्ववित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40014188, "chapter_id": 9191, "verse_number": "10", "content_sanskrit": "हृष्टप्रमुदितालङ्कामत्तद्विपसमाकुला । महतीरथसंपूर्णारक्षोगणसमाकुला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40014189, "chapter_id": 9191, "verse_number": "11", "content_sanskrit": "दृढबद्धकवाटानिमहापरिघवन्तिच । द्वाराणिविपुलान्यस्याश्चत्वारिसुमहान्तिच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40014190, "chapter_id": 9191, "verse_number": "12", "content_sanskrit": "तत्रेषूपलयन्त्राणिबलवन्तिमहान्तिच । आगतंपरसैन्यंतैस्तत्रप्रतिनिवार्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40014191, "chapter_id": 9191, "verse_number": "13", "content_sanskrit": "द्वारेषुसंस्कृताभीमाःकालायसमयाश्शिताः । शतशोरचितावीरैश्शतघ्नयोरक्षसांगणै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40014192, "chapter_id": 9191, "verse_number": "14", "content_sanskrit": "सौवर्णस्तुमहांस्तस्याःप्राकारोदुष्प्रधर्षणः । मणीविद्रुमवैदूर्यमुक्ताविरचितान्तरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40014193, "chapter_id": 9191, "verse_number": "15", "content_sanskrit": "सर्वतश्चमहाभीमाश्शीततोयवहाश्शुभाः । अगाधाग्राहवत्यश्चपरिखामीनसेविता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40014194, "chapter_id": 9191, "verse_number": "16", "content_sanskrit": "द्वारेषुतासांचत्वारस्सङ्क्रमाःपरमायताः । यन्त्रैरुपेताबहुभिर्महद्भिर्गृहपङ्क्तिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40014195, "chapter_id": 9191, "verse_number": "17", "content_sanskrit": "त्रायन्तेसङ्क्रमास्तत्रपरसैन्यागतेसति । यन्त्रैस्तैरवकीर्यन्तेपरिखासुसमन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40014196, "chapter_id": 9191, "verse_number": "18", "content_sanskrit": "एकस्त्वकम्प्योबलवान्सङ्क्रमस्सुमहादृढः । काञ्चनै र्बहुभिस्स्तम्भैर्वेदिकाभिश्चशोभितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40014197, "chapter_id": 9191, "verse_number": "19", "content_sanskrit": "स्वयंप्रकृतिमापन्नोयुयुत्सूराम रावण: । उत्थितश्चाप्रमत्तश्चबलानामनुदर्शने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40014198, "chapter_id": 9191, "verse_number": "20", "content_sanskrit": "लङ्कापुनर्निरालम्बादेवदुर्गाभयावहा । नादेयंपार्वतंवान्यंकृत्रिमंचचतुर्विधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40014199, "chapter_id": 9191, "verse_number": "21", "content_sanskrit": "स्थितापारेसमुद्रस्यदूरपारस्यराघव । नौपथोपिश्चनास्त्यत्रनिरादेशश्चसर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40014200, "chapter_id": 9191, "verse_number": "22", "content_sanskrit": "शैलाग्रेरचितादुर्गासापुरैर्देवपुरोपमा । वाजिवारणासम्पूर्णालङ्कापरमदुर्जया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40014201, "chapter_id": 9191, "verse_number": "23", "content_sanskrit": "परिखाश्चशतघ्नयश्चयन्त्राणिविविधानिच । शोभयन्तिपुरींलङ्कांरावणस्यदुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40014202, "chapter_id": 9191, "verse_number": "24", "content_sanskrit": "अयुतंरक्षसामत्रपूर्वद्वारंसमाश्रितम् । शूलहस्तादुराधर्षास्सर्वेखङ्गाग्रयोधिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40014203, "chapter_id": 9191, "verse_number": "25", "content_sanskrit": "नियुतंरक्षसामत्रदक्षिणद्वारमाश्रितम् । चतुरङ्गेणसैन्येनयोधास्तत्राप्यनुत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40014204, "chapter_id": 9191, "verse_number": "26", "content_sanskrit": "प्रयुतंरक्षसामत्रपश्चिमद्वारमाश्रितम् । चर्मखङ्गधरास्सर्वेतथासर्वास्त्रकोविदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40014205, "chapter_id": 9191, "verse_number": "27", "content_sanskrit": "न्यर्बुदंरक्षसामत्राप्युत्तरद्वारमाश्रितम् । रथिनश्चाश्ववाहाश्चकुलपुत्त्रास्सुपूजिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40014206, "chapter_id": 9191, "verse_number": "28", "content_sanskrit": "शतशोऽथसहस्राणिमध्यमंस्कन्धमाश्रिताः । यातुधानादुराधर्षास्साग्रकोटिश्चरक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40014207, "chapter_id": 9191, "verse_number": "29", "content_sanskrit": "तेमयासङ्क्रमाभग्नाःपरिखाश्चावपूरिताः । दग्धाचनगरीलङ्काप्राकाराश्चावसादिताः ॥ बलैकदेशःक्षपितोराक्षसानांमहात्मनाम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40014208, "chapter_id": 9191, "verse_number": "30", "content_sanskrit": "येनकेनतुमार्गेणतरामवरुणालयम् । हतेतिनगरीलङ्कावानरैरवधार्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40014209, "chapter_id": 9191, "verse_number": "31", "content_sanskrit": "अङ्गदोद्विविदोमैन्दोजाम्बवान्पनसोऽनलः । नीलस्सेनापतिश्चेवबलशेषेणकिंतव ॥ प्लवमानाहिगत्वातांरावणस्यमहापुरीम् ॥ सपर्वतवनांभित्त्वासखातांचसप्रतोरणाम् । सप्राकारांसभवनामानयिष्यन्तिराघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40014210, "chapter_id": 9191, "verse_number": "32", "content_sanskrit": "अङ्गदोद्विविदोमैन्दोजाम्बवान्पनसोऽनलः । नीलस्सेनापतिश्चेवबलशेषेणकिंतव ॥ प्लवमानाहिगत्वातांरावणस्यमहापुरीम् ॥ सपर्वतवनांभित्त्वासखातांचसप्रतोरणाम् । सप्राकारांसभवनामानयिष्यन्तिराघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40014211, "chapter_id": 9191, "verse_number": "33", "content_sanskrit": "अङ्गदोद्विविदोमैन्दोजाम्बवान्पनसोऽनलः । नीलस्सेनापतिश्चेवबलशेषेणकिंतव ॥ प्लवमानाहिगत्वातांरावणस्यमहापुरीम् ॥ सपर्वतवनांभित्त्वासखातांचसप्रतोरणाम् । सप्राकारांसभवनामानयिष्यन्तिराघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40014212, "chapter_id": 9191, "verse_number": "34", "content_sanskrit": "एवमाज्ञापयक्षिप्रंबलानांसर्वसङ्ग्रहम् । मुहूर्तेनतुयुक्तेनप्रस्थानमभिरोचय ॥", "p