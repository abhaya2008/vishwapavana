[{"id": 2023944, "chapter_id": 1512, "verse_number": "३-१५०-०x", "content_sanskrit": "हनूमानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2023945, "chapter_id": 1512, "verse_number": "३-१५०-१", "content_sanskrit": "हृतदारः सह भ्रात्रा पत्नीं मार्गन्स राघवः।\nदृष्टवाञ्शैलशिखरे सुग्रीवं वानरर्षभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2023946, "chapter_id": 1512, "verse_number": "३-१५०-२", "content_sanskrit": "तेन तस्याभवत्सख्यं राघवस्य महात्मनः।\nस हत्वा वालिनं राज्ये सुग्रीवं प्रत्यपादयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2023947, "chapter_id": 1512, "verse_number": "३-१५०-३", "content_sanskrit": "स राज्यं प्राप्य सुग्रीवः सीतायाः परिमार्गणे।\nवानरान्प्रेषयामास शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2023948, "chapter_id": 1512, "verse_number": "३-१५०-४", "content_sanskrit": "ततो वानरकोटीभिः सहितोऽहं नरर्षभ।\nसीतां मार्गन्महाबाहो प्रस्थितो दक्षिणां दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2023949, "chapter_id": 1512, "verse_number": "३-१५०-५", "content_sanskrit": "ततः प्रवृत्तिः सीताया गृध्रेण सुमहात्मना।\nसंपातिना समाख्याता रावणस्य निवेशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2023950, "chapter_id": 1512, "verse_number": "३-१५०-६", "content_sanskrit": "ततोऽहं कार्यसिद्ध्यर्थं रामस्याक्लिष्टकर्मणः।\nशतयोजनविस्तारमर्णवं सहसा प्लुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2023951, "chapter_id": 1512, "verse_number": "३-१५०-७", "content_sanskrit": "अहं स्ववीर्यादुत्तीर्य सागरं मकरालयम्।\nसुतां जनकराजस्य सीतां सुररसुतोपमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2023952, "chapter_id": 1512, "verse_number": "३-१५०-८", "content_sanskrit": "दृष्टवान्भरतश्रेष्ठ रावणस्य निवेशने।\nसमेत्य तामहं देवीं वैदेहीं राघवप्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2023953, "chapter_id": 1512, "verse_number": "३-१५०-९", "content_sanskrit": "दग्ध्वा लङ्कामशेषेण सादृप्राकारतोरणाम्।\nप्रत्यागतश्चास्य पुनर्नाम तत्रप्रकाश्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2023954, "chapter_id": 1512, "verse_number": "३-१५०-१०", "content_sanskrit": "मद्वाक्यं चावधार्याशु रामो राजीवलोचनः।\nअबद्धपूर्वमन्यैश्च बद्ध्वा सेतुं महोदधौ।\nवृतो वानरकोटीभिः समुत्तीर्णो महार्णवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2023955, "chapter_id": 1512, "verse_number": "३-१५०-११", "content_sanskrit": "ततो ररामेण वीर्येण हत्वा तान्सर्वराक्षसान्।\nरणे तु राक्षसगणं रावणं लोकरावणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2023956, "chapter_id": 1512, "verse_number": "३-१५०-१२", "content_sanskrit": "निशाचरेनद्रं हत्वा तु सभ्रातृसुतबान्धवम्।\nराज्येऽभिषिच्य लङ्कायां राक्षसेन्द्रं विभीषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2023957, "chapter_id": 1512, "verse_number": "३-१५०-१३", "content_sanskrit": "धार्मिकं भक्तिमन्तं च भक्तानुगतवत्सलः।\nप्रत्याहृत्य ततः सीतां नष्टां वेदश्रुतिं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2023958, "chapter_id": 1512, "verse_number": "३-१५०-१४", "content_sanskrit": "तयैव सहितः साध्व्या पत्न्या रामो महायशाः।\nगत्वा ततोऽतित्वरितः स्वां पुरीं रघुनन्दनः।\nअध्यावसत्ततोऽयोध्यामयोध्यां द्विषतां प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2023959, "chapter_id": 1512, "verse_number": "३-१५०-१५", "content_sanskrit": "ततः प्रतिष्ठितो राज्ये रामो नृपतिसत्तमः।\nवरं मया याचितोऽसौ रामो राजीवलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2023960, "chapter_id": 1512, "verse_number": "३-१५०-१६", "content_sanskrit": "यावद्रामकथेयं ते भवेल्लोकेषु शत्रुहन्।\nतावज्जीवेयमित्येवं तथाऽस्त्विति च सोब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2023961, "chapter_id": 1512, "verse_number": "३-१५०-१७", "content_sanskrit": "सीताप्रसादाच्च सदा मामिहस्थमरिंदम।\nउपतिष्ठन्ति दिव्या हि भोगा भीम यथेप्सिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2023962, "chapter_id": 1512, "verse_number": "३-१५०-१८", "content_sanskrit": "दशवर्षसहस्राणि दशवर्षशतानि च।\nराज्यं कारितवान्रामस्ततः स्वभवनं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2023963, "chapter_id": 1512, "verse_number": "३-१५०-१९", "content_sanskrit": "तदिहाप्सरसस्तात गन्धर्वाश्च सदाऽनघ।\nतस्य वीरस्य चरितं गायन्त्यो रमयन्ति माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2023964, "chapter_id": 1512, "verse_number": "३-१५०-२०", "content_sanskrit": "अयं च मार्गो मर्त्यानामगम्यः कुरुनन्दन।\nततोऽहं रुद्धवान्मार्गं तवेमं देवसेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2023965, "chapter_id": 1512, "verse_number": "३-१५०-२१", "content_sanskrit": "`त्वामनेन पथा यान्तं यक्षो वा राक्षसोपि वा।\nधर्षयेद्वा शपेद्वाऽपि मा कश्चिदिति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2023966, "chapter_id": 1512, "verse_number": "३-१५०-२२", "content_sanskrit": "दिव्यो देवपथो ह्येष नात्र गच्छन्ति मानुषाः।\nयदर्थमागतश्चासि अत एव सरश्च तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2023967, "chapter_id": 1512, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि पञ्चाशदधिकशततमोऽध्यायः ॥ १५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]