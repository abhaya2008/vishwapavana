[{"id": 7001023000, "chapter_id": 21023, "verse_number": "५-५-१", "content_sanskrit": "विमुक्तो वसुदेवोऽस्य नन्दस्य शकटं गतः ।\nप्रह्टष्टं दृष्टवान् नन्दं पूत्रो जातो ममेति वै ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001023001, "chapter_id": 21023, "verse_number": "५-५-२", "content_sanskrit": "वसुदेवोऽपि तं प्राह दिष्ठया दिष्ठयति सादरम् ।\nवार्द्धकेऽपि समुत्पन्नस्तनयोऽयं तवाघुना ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001023002, "chapter_id": 21023, "verse_number": "५-५-३", "content_sanskrit": "दत्तो हि वार्षिकः सर्व्वो भवद्भिर्नृ पतेः करः ।\nयदर्थमागतास्तस्मान्नावस्थेयं महाधनाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001023003, "chapter_id": 21023, "verse_number": "५-५-४", "content_sanskrit": "यदर्थमागताः कार्य्यं तन्निष्पन्नं किमास्यते?।\nभतद्भिर्गम्यतां नन्द! तच्छीघ्रं निजगोकुलम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001023004, "chapter_id": 21023, "verse_number": "५-५-५", "content_sanskrit": "ममापि बालकस्तत्र रोहिणीप्रसवी हि यः ।\nस रक्षणीयो भवता यथायं तनयो निजः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001023005, "chapter_id": 21023, "verse_number": "५-५-६", "content_sanskrit": "इत्युक्ताः प्रययुर्गोपा नन्दगोपपुरोगमाः ।\nशकटारोपितैर्भाण्डैः करं दत्त्वा महाबलाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001023006, "chapter_id": 21023, "verse_number": "५-५-७", "content_sanskrit": "वसतां गोकुले तेषां पूतना बालघातिनी ।\nसुप्तं कृषूणमुपादाय रात्रौ तस्मै ददौ स्तनम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001023007, "chapter_id": 21023, "verse_number": "५-५-८", "content_sanskrit": "यस्मै यस्मै स्तनं पूतना सम्प्रयच्छति ।\nतस्य तस्य क्षणोनाङ्ग बालकस्योपहन्यते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001023008, "chapter_id": 21023, "verse_number": "५-५-९", "content_sanskrit": "कुषूणस्तस्याः स्तनं गाढ़ं कराभ्यामवपीड़ितम् ।\nगृहोत्वा प्राणसहितं पपौ कोपसमन्वितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001023009, "chapter_id": 21023, "verse_number": "५-५-१०", "content_sanskrit": "सा विमुक्तमहारावा विच्छिन्नस्त्रंयुबन्धना ।\nपपात पूतना भूमौ म्रियमाणतिभीषणा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001023010, "chapter_id": 21023, "verse_number": "५-५-११", "content_sanskrit": "तन्नादश्रुतिसन्त्रासात् प्रबुद्धास्ते व्रजौकसः ।\nददृशुः पूतनोत्सङ्गे कृषूणं ताञ्च निपातिताम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001023011, "chapter_id": 21023, "verse_number": "५-५-१२", "content_sanskrit": "आदाय कृषूणं सन्त्रस्ता यशोदापि द्रिजोत्तम!।\nगोपुच्छं भ्राम्य हस्तेन बालदोषमपाकरोत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001023012, "chapter_id": 21023, "verse_number": "५-५-१३", "content_sanskrit": "गोः करीषमुपादाय नन्दगोफोऽपि मस्तके ।\nकृषूणस्य प्रददौ रक्षां कुर्वंश्चैतदुदोरयन् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001023013, "chapter_id": 21023, "verse_number": "५-५-१४", "content_sanskrit": "रक्षतु त्वामशेषाणां भूतानां प्रभवो हरिः ।\nयस्य नाभिसमुदूभूतपङ्कजादभवज्जगत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001023014, "chapter_id": 21023, "verse_number": "५-५-१५", "content_sanskrit": "येन दंष्ट्राग्रविधृता धारयत्यवनी जगत् ।\nवराहरूपधूगू देवः स त्वां रक्षतु केशवः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001023015, "chapter_id": 21023, "verse_number": "५-५-१६", "content_sanskrit": "नखाङूकुरविनिर्भिन्न-वैरिवक्षःस्थलो विभुः ।\nनृसिंहरूपी सर्व्वत्र स त्वां रक्षतु केशवः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001023016, "chapter_id": 21023, "verse_number": "५-५-१७", "content_sanskrit": "वामनो रक्षतु सदा भवन्तं यः क्षणादभूत् ।\nत्रिविक्रमः क्रमाकान्त-त्रैलोक्यः स्फुरदायुधः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001023017, "chapter_id": 21023, "verse_number": "५-५-१८", "content_sanskrit": "शिरस्ते पातु गोविन्दः कणठं रक्षतु केशवः ।\nगुह्यञ्च जठरं विष्णुर्जङ्घा-पादौ जनार्द्दनः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001023018, "chapter_id": 21023, "verse_number": "५-५-१९", "content_sanskrit": "मुखं बाहू प्रबाहू च मनः सर्व्वेन्द्रियाणि च ।\nरक्षत्वव्याहतैश्वर्य्यस्तव नारयणोऽव्ययः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001023019, "chapter_id": 21023, "verse_number": "५-५-२०", "content_sanskrit": "शाङ्ग-चक्र-गदा-खडूग-शङ्खनादहताः क्षयम् ।\nगच्छन्तु प्रते-कुष्माण्ड-राक्षसा ये तवाहिताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001023020, "chapter_id": 21023, "verse_number": "५-५-२१", "content_sanskrit": "त्वां पातु दिक्षु वैकुणठो विदिक्षु मधुसूदनः ।\nह्टषीकेशोऽम्बरे भूमौ रक्षतु त्वां महीधरः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001023021, "chapter_id": 21023, "verse_number": "५-५-२२", "content_sanskrit": "एवं कृतस्वस्त्ययनो नन्दगोपेन बालकः ।\nशायितः शकटस्याधो बालपर्य्यङ्किकातले ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001023022, "chapter_id": 21023, "verse_number": "५-५-२३", "content_sanskrit": "ते च गोपा महदू दृष्ट्वा पूतनायाः कलेवरम् ।\nमृतायाः परमं त्रासं विस्मयं परमं ययुः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]