[{"id": 900005076, "chapter_id": 8416, "verse_number": "3.1", "content_sanskrit": "अस्य पटस्यावयवित्वादि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900005077, "chapter_id": 8416, "verse_number": "3.2", "content_sanskrit": "किञ्च किमत्र पटस्यासत्त्वमापाद्यते संसर्ग-निषेधो वा क्रियते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900005078, "chapter_id": 8416, "verse_number": "3.3", "content_sanskrit": "नन्विह नभसि नीलिमेति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900005079, "chapter_id": 8416, "verse_number": "3.4", "content_sanskrit": "अथ तत्रागमविरोधस्तर्ह्यरूपित्वमपि तस्यागमसिद्धमेव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900005080, "chapter_id": 8416, "verse_number": "3.5", "content_sanskrit": "किञ्च जगतो मिथ्यात्वाभावे न बाधकं पश्यामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900005081, "chapter_id": 8416, "verse_number": "3.6", "content_sanskrit": "न द्वितीयः । करणसामर्थ्येन विषयविषयि-भावोपपत्तेः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900005082, "chapter_id": 8416, "verse_number": "3.7", "content_sanskrit": "न च तदनिरूपणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900005083, "chapter_id": 8416, "verse_number": "3.8", "content_sanskrit": "ननु सत्यत्वे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900005084, "chapter_id": 8416, "verse_number": "3.9", "content_sanskrit": "नेह नानेत्यागमोऽस्तु विश्वमिथ्यात्वे मानमिति चेन्न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900005085, "chapter_id": 8416, "verse_number": "3.10", "content_sanskrit": "नानाशब्दस्य भावप्रत्ययान्तताभावान्नेति चेन्न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900005086, "chapter_id": 8416, "verse_number": "3.11", "content_sanskrit": "तर्ह्येकमेवाद्वितीयमित्यागमोऽस्तु मानमत्रेति चेन्न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900005087, "chapter_id": 8416, "verse_number": "3.12", "content_sanskrit": "अनन्तपदं च देशकालान्तवत्त्वाभावपरम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900005088, "chapter_id": 8416, "verse_number": "3.13", "content_sanskrit": "तस्मात्सत्यभेदचेतनाचेतनात्मनो विश्वस्य हरिः कर्तेति निराबाधमवस्थितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900005089, "chapter_id": 8416, "verse_number": "3.14", "content_sanskrit": "ननु कथं भेदसत्यता युक्तिमती..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900005090, "chapter_id": 8416, "verse_number": "3.15", "content_sanskrit": "यथाऽऽकाशस्य स्वगतो भेदो नास्ति तथा..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]