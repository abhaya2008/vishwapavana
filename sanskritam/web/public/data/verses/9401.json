[{"id": 5000401000, "chapter_id": 9401, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे द्विषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000401001, "chapter_id": 9401, "verse_number": "५-६२-१", "content_sanskrit": "तानुवाच हरिश्रेष्ठो हनूमान् वानरर्षभः।\nअव्यग्रमनसो यूयं मधु सेवत वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000401002, "chapter_id": 9401, "verse_number": "५-६२-२", "content_sanskrit": "अहमावर्जयिष्यामि युष्माकं परिपन्थिनः।\nश्रुत्वा हनूमतो वाक्यं हरीणां प्रवरोऽङ्गदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000401003, "chapter_id": 9401, "verse_number": "५-६२-३", "content_sanskrit": "प्रत्युवाच प्रसन्नात्मा पिबन्तु हरयो मधु।\nअवश्यं कृतकार्यस्य वाक्यं हनुमतो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000401004, "chapter_id": 9401, "verse_number": "५-६२-४", "content_sanskrit": "अकार्यमपि कर्तव्यं किमङ्गं पुनरीदृशम्।\nअङ्गदस्य मुखाच्छ्रुत्वा वचनं वानरर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000401005, "chapter_id": 9401, "verse_number": "५-६२-५", "content_sanskrit": "साधु साध्विति संहृष्टा वानराः प्रत्यपूजयन्।\nपूजयित्वाङ्गदं सर्वे वानरा वानरर्षभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000401006, "chapter_id": 9401, "verse_number": "५-६२-६", "content_sanskrit": "जग्मुर्मधुवनं यत्र नदीवेग इव द्रुमम्।\nते प्रविष्टा मधुवनं पालानाक्रम्य शक्तितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000401007, "chapter_id": 9401, "verse_number": "५-६२-७", "content_sanskrit": "अतिसर्गाच्च पटवो दृष्ट्वा श्रुत्वा च मैथिलीम्।\nपपुः सर्वे मधु तदा रसवत् फलमाददुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000401008, "chapter_id": 9401, "verse_number": "५-६२-८", "content_sanskrit": "उत्पत्य च ततः सर्वे वनपालान् समागतान्।\nते ताडयन्तः शतशः सक्ता मधुवने तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000401009, "chapter_id": 9401, "verse_number": "५-६२-९", "content_sanskrit": "मधूनि द्रोणमात्राणि बाहुभिः परिगृह्य ते।\nपिबन्ति कपयः केचित् सङ्घशस्तत्र हृष्टवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000401010, "chapter_id": 9401, "verse_number": "५-६२-१०", "content_sanskrit": "घ्नन्ति स्म सहिताः सर्वे भक्षयन्ति तथापरे।\nकेचित् पीत्वापविध्यन्ति मधूनि मधुपिङ्गलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000401011, "chapter_id": 9401, "verse_number": "५-६२-११", "content_sanskrit": "मधूच्छिष्टेन केचिच्च जघ्नुरन्योन्यमुत्कटाः।\nअपरे वृक्षमूलेषु शाखा गृह्य व्यवस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000401012, "chapter_id": 9401, "verse_number": "५-६२-१२", "content_sanskrit": "अत्यर्थं च मदग्लानाः पर्णान्यास्तीर्य शेरते।\nउन्मत्तवेगाः प्लवगा मधुमत्ताश्च हृष्टवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000401013, "chapter_id": 9401, "verse_number": "५-६२-१३", "content_sanskrit": "क्षिपन्त्यपि तथान्योन्यं स्खलन्ति च तथापरे।\nकेचित् क्ष्वेडान् प्रकुर्वन्ति केचित् कूजन्ति हृष्टवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000401014, "chapter_id": 9401, "verse_number": "५-६२-१४", "content_sanskrit": "हरयो मधुना मत्ताः केचित् सुप्ता महीतले।\nधृष्टाः केचिद्धसन्त्यन्ये केचित् कुर्वन्ति चेतरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000401015, "chapter_id": 9401, "verse_number": "५-६२-१५", "content_sanskrit": "कृत्वा केचिद् वदन्त्यन्ये केचिद् बुध्यन्ति चेतरत्।\nयेऽप्यत्र मधुपालाः स्युः प्रेष्या दधिमुखस्य तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000401016, "chapter_id": 9401, "verse_number": "५-६२-१६", "content_sanskrit": "तेऽपि तैर्वानरैर्भीमैः प्रतिषिद्धा दिशो गताः।\nजानुभिश्च प्रघृष्टाश्च देवमार्गं च दर्शिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000401017, "chapter_id": 9401, "verse_number": "५-६२-१७", "content_sanskrit": "अब्रुवन् परमोद्विग्ना गत्वा दधिमुखं वचः।\nहनूमता दत्तवरैर्हतं मधुवनं बलात्।\nवयं च जानुभिर्घृष्टा देवमार्गं च दर्शिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000401018, "chapter_id": 9401, "verse_number": "५-६२-१८", "content_sanskrit": "तदा दधिमुखः क्रुद्धो वनपस्तत्र वानरः।\nहतं मधुवनं श्रुत्वा सान्त्वयामास तान् हरीन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000401019, "chapter_id": 9401, "verse_number": "५-६२-१९", "content_sanskrit": "एतागच्छत गच्छामो वानरानतिदर्पितान्।\nबलेनावारयिष्यामि प्रभुञ्जानान् मधूत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000401020, "chapter_id": 9401, "verse_number": "५-६२-२०", "content_sanskrit": "श्रुत्वा दधिमुखस्येदं वचनं वानरर्षभाः।\nपुनर्वीरा मधुवनं तेनैव सहिता ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000401021, "chapter_id": 9401, "verse_number": "५-६२-२१", "content_sanskrit": "मध्ये चैषां दधिमुखः सुप्रगृह्य महातरुम्।\nसमभ्यधावन् वेगेन सर्वे ते च प्लवंगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000401022, "chapter_id": 9401, "verse_number": "५-६२-२२", "content_sanskrit": "ते शिलाः पादपांश्चैव पाषाणानपि वानराः।\nगृहीत्वाभ्यागमन् क्रुद्धा यत्र ते कपिकुञ्जराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000401023, "chapter_id": 9401, "verse_number": "५-६२-२३", "content_sanskrit": "बलान्निवारयन्तश्च आसेदुर्हरयो हरीन्।\nसंदष्टौष्ठपुटाः क्रुद्धा भर्त्सयन्तो मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000401024, "chapter_id": 9401, "verse_number": "५-६२-२४", "content_sanskrit": "अथ दृष्ट्वा दधिमुखं क्रुद्धं वानरपुङ्गवाः।\nअभ्यधावन्त वेगेन हनुमत्प्रमुखास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000401025, "chapter_id": 9401, "verse_number": "५-६२-२५", "content_sanskrit": "सवृक्षं तं महाबाहुमापतन्तं महाबलम्।\nवेगवन्तं विजग्राह बाहुभ्यां कुपितोऽङ्गदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000401026, "chapter_id": 9401, "verse_number": "५-६२-२६", "content_sanskrit": "मदान्धो न कृपां चक्रे आर्यकोऽयं ममेति सः।\nअथैनं निष्पिपेषाशु वेगेन वसुधातले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000401027, "chapter_id": 9401, "verse_number": "५-६२-२७", "content_sanskrit": "स भग्नबाहूरुमुखो विह्वलः शोणितोक्षितः।\nप्रमुमोह महावीरो मुहूर्तं कपिकुञ्जरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000401028, "chapter_id": 9401, "verse_number": "५-६२-२८", "content_sanskrit": "स कथंचिद् विमुक्तस्तैर्वानरैर्वानरर्षभः।\nउवाचैकान्तमागत्य स्वान् भृत्यान् समुपागतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000401029, "chapter_id": 9401, "verse_number": "५-६२-२९", "content_sanskrit": "एतागच्छत गच्छामो भर्ता नो यत्र वानरः।\nसुग्रीवो विपुलग्रीवः सह रामेण तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000401030, "chapter_id": 9401, "verse_number": "५-६२-३०", "content_sanskrit": "सर्वं चैवाङ्गदे दोषं श्रावयिष्याम पार्थिवे।\nअमर्षी वचनं श्रुत्वा घातयिष्यति वानरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000401031, "chapter_id": 9401, "verse_number": "५-६२-३१", "content_sanskrit": "इष्टं मधुवनं ह्येतत् सुग्रीवस्य महात्मनः।\nपितृपैतामहं दिव्यं देवैरपि दुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000401032, "chapter_id": 9401, "verse_number": "५-६२-३२", "content_sanskrit": "स वानरानिमान् सर्वान् मधुलुब्धान् गतायुषः।\nघातयिष्यति दण्डेन सुग्रीवः ससुहृज्जनान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000401033, "chapter_id": 9401, "verse_number": "५-६२-३३", "content_sanskrit": "वध्या ह्येते दुरात्मानो नृपाज्ञापरिपन्थिनः।\nअमर्षप्रभवो रोषः सफलो मे भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000401034, "chapter_id": 9401, "verse_number": "५-६२-३४", "content_sanskrit": "एवमुक्त्वा दधिमुखो वनपालान् महाबलः।\nजगाम सहसोत्पत्य वनपालैः समन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000401035, "chapter_id": 9401, "verse_number": "५-६२-३५", "content_sanskrit": "निमेषान्तरमात्रेण स हि प्राप्तो वनालयः।\nसहस्रांशुसुतो धीमान् सुग्रीवो यत्र वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000401036, "chapter_id": 9401, "verse_number": "५-६२-३६", "content_sanskrit": "रामं च लक्ष्मणं चैव दृष्ट्वा सुग्रीवमेव च।\nसमप्रतिष्ठां जगतीमाकाशान्निपपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000401037, "chapter_id": 9401, "verse_number": "५-६२-३७", "content_sanskrit": "स निपत्य महावीरः सर्वैस्तैः परिवारितः।\nहरिर्दधिमुखः पालैः पालानां परमेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000401038, "chapter_id": 9401, "verse_number": "५-६२-३८", "content_sanskrit": "स दीनवदनो भूत्वा कृत्वा शिरसि चाञ्जलिम्।\nसुग्रीवस्याशु तौ मूर्ध्ना चरणौ प्रत्यपीडयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000401039, "chapter_id": 9401, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे द्विषष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]