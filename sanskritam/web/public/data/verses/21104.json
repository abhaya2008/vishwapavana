[{"id": 7001104000, "chapter_id": 21104, "verse_number": "२-१-१५-१", "content_sanskrit": "नारद उवाच ।\nविधे विधे महाभाग धन्यस्त्वं सुरसत्तम ।\nश्राविताद्याद्भुता शैवकथा परमपावनी॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001104001, "chapter_id": 21104, "verse_number": "२-१-१५-२", "content_sanskrit": "तत्राद्भुता महादिव्या लिंगोत्पत्तिः श्रुता शुभा ।\nश्रुत्वा यस्याः प्रभावं च दुःखनाशो भवेदिह॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001104002, "chapter_id": 21104, "verse_number": "२-१-१५-३", "content_sanskrit": "अनंतरं च यज्जातं माहात्म्यं चरितं तथा ।\nसृष्टेश्चैव प्रकारं च कथय त्वं विशेषतः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001104003, "chapter_id": 21104, "verse_number": "२-१-१५-४", "content_sanskrit": "ब्रह्मोवाच ।\nसम्यक् पृष्टे च भवता यज्जातं तदनंतरम् ।\nकथयिष्यामि संक्षेपाद्यथा पूर्वं श्रुतं मया॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001104004, "chapter_id": 21104, "verse_number": "२-१-१५-५", "content_sanskrit": "अंतर्हिते तदा देवे शिवरूपे सनातने ।\nअहं विष्णुश्च विप्रेन्द्र अधिकं सुखमाप्तवान्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001104005, "chapter_id": 21104, "verse_number": "२-१-१५-६", "content_sanskrit": "मया च विष्णुना रूपं हंसवाराहयोस्तदा ।\nसंवृतं तु ततस्ताभ्यां लोकसर्गावनेच्छया॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001104006, "chapter_id": 21104, "verse_number": "२-१-१५-७", "content_sanskrit": "नारद उवाच ।\nविधे ब्रह्मन् महाप्राज्ञ संशयो हृदि मे महान् ।\nकृपां कृत्वातुलां शीघ्रं तं नाशयितुमर्हसि॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001104007, "chapter_id": 21104, "verse_number": "२-१-१५-८", "content_sanskrit": "हंसवाराहयो रूपं युवाभ्यां च धृतं कथम् ।\nअन्यद्रूपं विहायैव किमत्र वद कारणम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001104008, "chapter_id": 21104, "verse_number": "२-१-१५-९", "content_sanskrit": "सूत उवाच ।\nइत्येतद्वचनं श्रुत्वा नारदस्य महात्मनः ।\nस्मृत्वा शिवपदांभोजं ब्रह्मा सादरमब्रवीत्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001104009, "chapter_id": 21104, "verse_number": "२-१-१५-१०", "content_sanskrit": "ब्रह्मोवाच ।\nहंसस्य चोर्द्ध्वगमने गतिर्भवति निश्चला ।\nतत्त्वातत्त्वविवेकोऽस्ति जलदुग्धविभागवत्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001104010, "chapter_id": 21104, "verse_number": "२-१-१५-११", "content_sanskrit": "अज्ञानज्ञानयोस्तत्त्वं विवेचयति हंसकः ।\nहंसरूपं धृतं तेन ब्रह्मणा सृष्टिकारिणा॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001104011, "chapter_id": 21104, "verse_number": "२-१-१५-१२", "content_sanskrit": "विवेको नैव लब्धश्च यतो हंसो व्यलीयत ।\nशिवस्वरूपतत्त्वस्य ज्योतिरूपस्य नारद॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001104012, "chapter_id": 21104, "verse_number": "२-१-१५-१३", "content_sanskrit": "सृष्टिप्रवृत्तिकामस्य कथं ज्ञानं प्रजायते ।\nयतो लब्धो विवेकोऽपि न मया हंसरूपिणा॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001104013, "chapter_id": 21104, "verse_number": "२-१-१५-१४", "content_sanskrit": "गमनेऽधो वराहस्य गतिर्भवति निश्चला ।\nधृतं वाराहरूपं हि विष्णुना वनचारिणा॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001104014, "chapter_id": 21104, "verse_number": "२-१-१५-१५", "content_sanskrit": "अथवा भवकल्पार्थं तद्रूपं हि प्रकल्पितम् ।\nविष्णुना च वराहस्य भुवनावनकारिणा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001104015, "chapter_id": 21104, "verse_number": "२-१-१५-१६", "content_sanskrit": "यद्दिनं हि समारभ्य तद्रूपं धृतवान्हरिः ।\nतद्दिनं प्रति कल्पोऽसौ कल्पो वाराहसंज्ञकः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001104016, "chapter_id": 21104, "verse_number": "२-१-१५-१७", "content_sanskrit": "तदिच्छा वा यदा जाता ताभ्यां रूपं हि धारणे ।\nतद्दिनं प्रतिकल्पोऽसौ कल्पो वाराहसंज्ञक्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001104017, "chapter_id": 21104, "verse_number": "२-१-१५-१८", "content_sanskrit": "इति प्रश्नोत्तरं दत्तं प्रस्तुतं शृणु नारद ।\nस्मृत्वा शिवपदांभोजं वक्ष्ये सृष्टिविधिं मुने॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001104018, "chapter_id": 21104, "verse_number": "२-१-१५-१९", "content_sanskrit": "अंतर्हिते महादेवे त्वहं लोकपितामहः ।\nतदीयं वचनं कर्तुमध्यायन्ध्यानतत्परः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001104019, "chapter_id": 21104, "verse_number": "२-१-१५-२०", "content_sanskrit": "नमस्कृत्य तदा शंभुं ज्ञानं प्राप्य हरेस्तदा ।\nआनंदं परमं गत्वा सृष्टिं कर्तुं मनो दधे॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001104020, "chapter_id": 21104, "verse_number": "२-१-१५-२१", "content_sanskrit": "विष्णुश्चापि तदा तत्र प्रणिपत्य सदाशिवम् ।\nउपदिश्य च मां तात ह्यंतर्धानमुपागतः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001104021, "chapter_id": 21104, "verse_number": "२-१-१५-२२", "content_sanskrit": "ब्रह्माण्डाच्च बहिर्गत्वा प्राप्य शम्भोरनुग्रहम् ।\nवैकुंठनगरं गत्वा तत्रोवास हरिस्सदा॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001104022, "chapter_id": 21104, "verse_number": "२-१-१५-२३", "content_sanskrit": "अहं स्मृत्वा शिवं तत्र विष्णुं वै सृष्टिकाम्यया ।\nपूर्वं सृष्टं जलं यच्च तत्रांजलिमुदाक्षिपम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001104023, "chapter_id": 21104, "verse_number": "२-१-१५-२४", "content_sanskrit": "अतोऽण्डमभवत्तत्र चतुर्विंशतिसंज्ञ कम् ।\nविराड्रूपमभूद्विप्र जलरूपमपश्यतः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001104024, "chapter_id": 21104, "verse_number": "२-१-१५-२५", "content_sanskrit": "ततस्संशयमापन्नस्तपस्तेपे सुदारुणम् ।\nद्वादशाब्दमहं तत्र विष्णुध्यानपरायणः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001104025, "chapter_id": 21104, "verse_number": "२-१-१५-२६", "content_sanskrit": "तस्मिंश्च समये तात प्रादुर्भूतो हरिस्स्वयम् ।\nमामुवाच महाप्रीत्या मदंगं संस्पृशन्मुदा॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001104026, "chapter_id": 21104, "verse_number": "२-१-१५-२७", "content_sanskrit": "॥ विष्णुरुवाच  ।\nवरं ब्रूहि प्रसन्नोऽस्मि नादेयो विद्यते तव ।\nब्रह्मञ्छंभुप्रसादेन सर्वं दातुं समर्थकः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001104027, "chapter_id": 21104, "verse_number": "२-१-१५-२८", "content_sanskrit": "ब्रह्मोवाच ।\nयुक्तमेतन्महाभाग दत्तोऽहं शंभुना च ते ।\nतदुक्तं याचते मेऽद्य देहि विष्णो नमोऽस्तु ते॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001104028, "chapter_id": 21104, "verse_number": "२-१-१५-२९", "content_sanskrit": "विराड्रूपमिदं ह्यंडं चतुर्विंशतिसंज्ञकम् ।\nन चैतन्यं भवत्यादौ जडीभूतं प्रदृश्यते॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001104029, "chapter_id": 21104, "verse_number": "२-१-१५-३०", "content_sanskrit": "प्रादुर्भूतो भवानद्य शिवानुग्रहतो हरे ।\nप्राप्तं शंकरसंभूत्या ह्यण्डं चैतन्यमावह॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001104030, "chapter_id": 21104, "verse_number": "२-१-१५-३१", "content_sanskrit": "इत्युक्ते च महाविष्णुश्शंभोराज्ञापरायणः ।\nअनंतरूपमास्थाय प्रविवेश तदंडकम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001104031, "chapter_id": 21104, "verse_number": "२-१-१५-३२", "content_sanskrit": "सहस्रशीर्षा पुरुषस्सहस्राक्षः सहस्रपात् ।\nस भूमिं सर्वतस्पृत्वा तदण्डं व्याप्तवानिति॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001104032, "chapter_id": 21104, "verse_number": "२-१-१५-३३", "content_sanskrit": "प्रविष्टे विष्णुना तस्मिन्नण्डे सम्यक्स्तुतेन मे ।\nसचेतनमभूदण्डं चतुर्विंशतिसंज्ञकम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001104033, "chapter_id": 21104, "verse_number": "२-१-१५-३४", "content_sanskrit": "पातालादि समारभ्य सप्तलोकाधिपः स्वयम् ।\nराजते स्म हरिस्तत्र वैराजः पुरुषः प्रभुः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001104034, "chapter_id": 21104, "verse_number": "२-१-१५-३५", "content_sanskrit": "कैलासनगरं रम्यं सर्वोपरि विराजितम् ।\nनिवासार्थं निजस्यैव पंचवक्त्र श्चकार ह॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001104035, "chapter_id": 21104, "verse_number": "२-१-१५-३६", "content_sanskrit": "ब्रह्मांडस्य तथा नाशे वैकुण्ठस्य च तस्य च ।\nकदाचिदेव देवर्षे नाशो नास्ति तयोरिह॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001104036, "chapter_id": 21104, "verse_number": "२-१-१५-३७", "content_sanskrit": "सत्यं पदमुपाश्रित्य स्थितोऽहं मुनिसत्तम ।\nसृष्टिकामोऽभवं तात महादेवाज्ञया ह्यहम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001104037, "chapter_id": 21104, "verse_number": "२-१-१५-३८", "content_sanskrit": "सिसृक्षोरथ मे प्रादुरभवत्पापसर्गकः ।\nअविद्यापंचकस्तात बुद्धिपूर्वस्तमोपमः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001104038, "chapter_id": 21104, "verse_number": "२-१-१५-३९", "content_sanskrit": "ततः प्रसन्नचित्तोऽहमसृजं स्थावराभिधम् ।\nमुख्यसर्गं च निस्संगमध्यायं शंभुशासनात्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001104039, "chapter_id": 21104, "verse_number": "२-१-१५-४०", "content_sanskrit": "तं दृष्ट्वा मे सिसृक्षोश्च ज्ञात्वा साधकमात्मनः ।\nसर्गोऽवर्तत दुःखाढ्यस्तिर्यक्स्रोता न साधकः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001104040, "chapter_id": 21104, "verse_number": "२-१-१५-४१", "content_sanskrit": "तं चासाधकमाज्ञाय पुनश्चिंतयतश्च मे ।\nअभवत्सात्त्विकस्सर्ग ऊर्ध्वस्रोता इति द्रुतम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001104041, "chapter_id": 21104, "verse_number": "२-१-१५-४२", "content_sanskrit": "देवसर्गः प्रतिख्यातस्सत्योऽतीव सुखावहः ।\nतमप्यसाधकं मत्वाऽचिंतयं प्रभुमात्मनः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001104042, "chapter_id": 21104, "verse_number": "२-१-१५-४३", "content_sanskrit": "प्रादुरासीत्ततस्सर्गो राजसः शंकराज्ञया ।\nअवाक्स्रोता इति ख्यातो मानुषः परसाधकः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001104043, "chapter_id": 21104, "verse_number": "२-१-१५-४४", "content_sanskrit": "महादेवाज्ञया सर्गस्ततो भूतादिकोऽभवत् ।\nइति पंचविधा सृष्टिः प्रवृत्ता वै कृता मया॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001104044, "chapter_id": 21104, "verse_number": "२-१-१५-४५", "content_sanskrit": "त्रयस्सर्गाः प्रकृत्याश्च ब्रह्मणः परिकीर्तिताः ।\nतत्राद्यो महतस्सर्गो द्वितीयः सूक्ष्मभौतिकः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001104045, "chapter_id": 21104, "verse_number": "२-१-१५-४६", "content_sanskrit": "वैकारिकस्तृतीयश्च इत्येते प्रकृतास्त्रयः ।\nएवं चाष्टविधास्सर्गाः प्रकृतेर्वेकृतैः सह॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001104046, "chapter_id": 21104, "verse_number": "२-१-१५-४७", "content_sanskrit": "कौमारो नवमः प्रोक्तः प्राकृतो वैकृतश्च सः ।\nएषामवांतरो भेदो मया वक्तुं न शक्यते॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001104047, "chapter_id": 21104, "verse_number": "२-१-१५-४८", "content_sanskrit": "अल्पत्वादुपयोगस्य वच्मि सर्गं द्विजात्मकम् ।\nकौमारः सनकादीनां यत्र सर्गो महानभूत्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001104048, "chapter_id": 21104, "verse_number": "२-१-१५-४९", "content_sanskrit": "सनकाद्याः सुता मे हि मानसा ब्रह्मसंमिताः ।\nमहावैराग्यसंपन्ना अभवन्पंच सुव्रताः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001104049, "chapter_id": 21104, "verse_number": "२-१-१५-५०", "content_sanskrit": "मयाज्ञप्ता अपि च ते संसारविमुखा बुधाः ।\nशिवध्यानैकमनसो न सृष्टौ चक्रिरे मतिम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001104050, "chapter_id": 21104, "verse_number": "२-१-१५-५१", "content_sanskrit": "प्रत्युत्तरं च तदनु श्रुत्वाहं मुनिसत्तम ।\nअकार्षं क्रोधमत्युग्रं मोहमाप्तश्च नारद॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001104051, "chapter_id": 21104, "verse_number": "२-१-१५-५२", "content_sanskrit": "कुद्धस्य मोहितस्याथ विह्वलस्य मुने मम ।\nक्रोधेन खलु नेत्राभ्यां प्रापतन्नश्रुबिंदवः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001104052, "chapter_id": 21104, "verse_number": "२-१-१५-५३", "content_sanskrit": "तस्मिन्नवसरे तत्र स्मृतेन मनसा मया ।\nप्रबोधितोहं त्वरितमागतेना हि विष्णुना॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001104053, "chapter_id": 21104, "verse_number": "२-१-१५-५४", "content_sanskrit": "तपः कुरु शिवस्येति हरिणा शिक्षितोऽप्यहम् ।\nतपोकारी महद्घोरं परमं मुनिसत्तम॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001104054, "chapter_id": 21104, "verse_number": "२-१-१५-५५", "content_sanskrit": "तपस्यतश्च सृष्ट्यर्थं भ्रुवोर्घ्राणस्य मध्यतः ।\nअविमुक्ताभिधाद्देशात्स्वकीयान्मे विशेषतः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001104055, "chapter_id": 21104, "verse_number": "२-१-१५-५६", "content_sanskrit": "त्रिमूर्तीनां महेशस्य प्रादुरासीद्घृणानिधिः ।\nआर्द्धनारीश्वरो भूत्वा पूर्णाशस्सकलेश्वरः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001104056, "chapter_id": 21104, "verse_number": "२-१-१५-५७", "content_sanskrit": "तमजं शंकरं साक्षात्तेजोराशिमुमापतिम् ।\nसर्वज्ञं सर्वकर्तारं नीललोहितसंज्ञकम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001104057, "chapter_id": 21104, "verse_number": "२-१-१५-५८", "content_sanskrit": "दृष्ट्वा नत्वा महाभक्त्या स्तुत्वाहं तु प्रहर्षितः ।\nअवोचं देवदेवेशं सृज त्वं विविधाः प्रजाः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001104058, "chapter_id": 21104, "verse_number": "२-१-१५-५९", "content_sanskrit": "श्रुत्वा मम वचस्सोथ देवदेवो महेश्वरः ।\nससर्ज स्वात्मनस्तुल्यान्रुद्रो रुद्रगणान्बहून॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001104059, "chapter_id": 21104, "verse_number": "२-१-१५-६०", "content_sanskrit": "अवोचं पुनरेवेशं महारुद्रं महेश्वरम् ।\nजन्ममृत्युभयाविष्टास्सृज देव प्रजा इति॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001104060, "chapter_id": 21104, "verse_number": "२-१-१५-६१", "content_sanskrit": "एवं श्रुत्वा महादेवो मद्वचः करुणानिधिः ।\nप्रहस्योवाच मां सद्यः प्रहस्य मुनिसत्तम॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001104061, "chapter_id": 21104, "verse_number": "२-१-१५-६२", "content_sanskrit": "महादेव उवाच ।\nजन्ममृत्युभयाविष्टा नाहं स्रक्ष्ये प्रजा विधे ।\nअशोभनाः कर्मवशा विमग्ना दुःखवारिधौ॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001104062, "chapter_id": 21104, "verse_number": "२-१-१५-६३", "content_sanskrit": "अहं दुःखोदधौ मग्ना उद्धरिष्यामि च प्रजाः ।\nसम्यक्ज्ञानप्रदानेन गुरुमूर्तिपरिग्रहः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001104063, "chapter_id": 21104, "verse_number": "२-१-१५-६४", "content_sanskrit": "त्वमेव सृज दुःखाढ्याः प्रजास्सर्वाः प्रजापते ।\nमदाज्ञया न बद्धस्त्वं मायया संभविष्यसि॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001104064, "chapter_id": 21104, "verse_number": "२-१-१५-६५", "content_sanskrit": "ब्रह्मोवाच ।\nइत्युक्त्वा मां स भगवान्सुश्रीमान्नीललोहितः ।\nसगणः पश्यतो मे हि द्रुतमंतर्दधे हरः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]