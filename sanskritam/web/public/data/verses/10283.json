[{"id": 6000283000, "chapter_id": 10283, "verse_number": null, "content_sanskrit": "अथ सप्ताशीतितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000283001, "chapter_id": 10283, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.001.m4a", "display_order": 2}, {"id": 6000283002, "chapter_id": 10283, "verse_number": "१०-८७-१", "content_sanskrit": "तथा वसति गोविन्दे शक्रप्रस्थे महात्मनि।\nसहानुजे चैव नृपे कृतकृत्ये युधिष्ठिरे॥ १०/८७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.002.m4a", "display_order": 3, "topics": [{"text": "कृष्णस्यानुपस्थिती, साल्वेन द्वारकाया रोधनम्", "range": "१–६"}]}, {"id": 6000283003, "chapter_id": 10283, "verse_number": "१०-८७-२", "content_sanskrit": "आकर्ण्य साल्वः सङ्क्रुद्धो दमघोषसुतं हतम्।\nजरासन्धं च सुहृदं राजसूयं क्रतुं कृतम्॥ १०/८७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.003.m4a", "display_order": 4}, {"id": 6000283004, "chapter_id": 10283, "verse_number": "१०-८७-३", "content_sanskrit": "ययौ द्वारावतीं साल्वो वैरं वृष्णिकृतं स्मरन्।\nतमावसन्नन्तरिक्षे युयुधे भरतर्षभ॥ १०/८७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.004.m4a", "display_order": 5}, {"id": 6000283005, "chapter_id": 10283, "verse_number": "१०-८७-४", "content_sanskrit": "पुरीं बभञ्जोपवनान्युद्यानानि च सर्वशः।\nसगोपुराणि द्वाराणि प्राकाराट्टालतोलिकाः॥ १०/८७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.005.m4a", "display_order": 6}, {"id": 6000283006, "chapter_id": 10283, "verse_number": "१०-८७-५", "content_sanskrit": "विहायसो विमानाग्य्रान्निपेतुः शस्‍त्रवृष्टयः। शैला द्रुमाश्चाशनयः सर्पा आसारशर्कराः।\nप्रचण्डश्चक्रवातोऽभूद् रजसाच्छादिता दिशः॥ १०/८७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.006.m4a", "display_order": 7}, {"id": 6000283007, "chapter_id": 10283, "verse_number": "१०-८७-६", "content_sanskrit": "इत्यर्द्यमाना सौभेन कृष्णस्य नगरी भृशम्।\nनाभ्यपद्यत शं राजन् त्रिपुरेण यथा मही॥ १०/८७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.007.m4a", "display_order": 8}, {"id": 6000283008, "chapter_id": 10283, "verse_number": "१०-८७-७", "content_sanskrit": "प्रद्युम्नो भगवान् वीक्ष्य मथ्यमाना निजाः प्रजाः।\nमा भैष्टेत्यभ्यधाद् धीरो वाचः पित्रोरनुस्मरन्॥ १०/८७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.008.m4a", "display_order": 9, "topics": [{"text": "यादवानां विशेषतः प्रद्युम्नस्य च प्रतिक्रिया", "range": "७–१९"}]}, {"id": 6000283009, "chapter_id": 10283, "verse_number": "१०-८७-८", "content_sanskrit": "सात्यकिश्चारुदेष्णश्च साम्बोऽक्रूरः सहानुजैः।\nहार्दिक्यो भानुविन्दश्च गदश्च शुकसारणौ॥ १०/८७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.009.m4a", "display_order": 10}, {"id": 6000283010, "chapter_id": 10283, "verse_number": "१०-८७-९", "content_sanskrit": "अपरे च महेष्वासा रथयूथपयूथपाः।\nनिर्ययुर्दंशिता गुप्ता रथनागाश्वपत्तिभिः॥ १०/८७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.010.m4a", "display_order": 11}, {"id": 6000283011, "chapter_id": 10283, "verse_number": "१०-८७-१०", "content_sanskrit": "ततः प्रववृते युद्धं साल्वानां यदुभिः सह।\nयथाऽसुराणां विबुधैस्तुमुलं लोमहर्षणम्॥ १०/८७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.011.m4a", "display_order": 12}, {"id": 6000283012, "chapter_id": 10283, "verse_number": "१०-८७-११", "content_sanskrit": "तां च सौभपतेर्मायां दिव्यास्‍त्रै रुग्मिणीसुतः।\nक्षणेन नाशयामास नैशं तम इवोष्णगुः॥ १०/८७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.012.m4a", "display_order": 13}, {"id": 6000283013, "chapter_id": 10283, "verse_number": "१०-८७-१२", "content_sanskrit": "विव्याध पञ्चविंशत्या स्वर्णपुङ्खैरयोमुखैः।\nसाल्वस्य ध्वजिनीपालं शरैः सन्नतपर्वभिः॥ १०/८७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.013.m4a", "display_order": 14}, {"id": 6000283014, "chapter_id": 10283, "verse_number": "१०-८७-१३", "content_sanskrit": "शतेनाताडयत् साल्वमेकैकेनास्य सैनिकान्।\nविव्याध दशभिर्नेतॄन् वाहनानि त्रिभिस्‍त्रिभिः॥ १०/८७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.014.m4a", "display_order": 15}, {"id": 6000283015, "chapter_id": 10283, "verse_number": "१०-८७-१४", "content_sanskrit": "तदद्भुतं महत्कर्म प्रद्युम्नस्य महात्मनः।\nदृष्ट्वा तं पूजयामासुः सर्वेऽस्य पुरवासिनः॥ १०/८७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.015.m4a", "display_order": 16}, {"id": 6000283016, "chapter_id": 10283, "verse_number": "१०-८७-१५", "content_sanskrit": "बहुरूपैकरूपं तद् दृश्यते न च दृश्यते।\nमयमायाकृतं यानं दुर्विभाव्यं जनैरभूत्॥ १०/८७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.016.m4a", "display_order": 17}, {"id": 6000283017, "chapter_id": 10283, "verse_number": "१०-८७-१६", "content_sanskrit": "क्‍वचिद् भूमौ क्‍वचिद् व्योम्नि क्‍वचित् सिन्धौ क्‍वचिद् गिरौ।\nअलातचक्रवद् भ्राम्यत् सौभं तद् दुरवस्थितम्॥ १०/८७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.017.m4a", "display_order": 18}, {"id": 6000283018, "chapter_id": 10283, "verse_number": "१०-८७-१७", "content_sanskrit": "यत्र यत्रोपलक्ष्येत तस्य सौभस्य सैनिकः।\nसाल्वस्ततस्ततोऽमुञ्चन् शरान् सात्वतयूथपाः॥ १०/८७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.018.m4a", "display_order": 19}, {"id": 6000283019, "chapter_id": 10283, "verse_number": "१०-८७-१८", "content_sanskrit": "शरैरग्न्यर्कसङ्काशैराशीविषदुरासदैः।\nपीड्यमानपुरानीकः साल्वोऽमुह्यत् परैरिति॥ १०/८७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.019.m4a", "display_order": 20}, {"id": 6000283020, "chapter_id": 10283, "verse_number": "१०-८७-१९", "content_sanskrit": "साल्वानीकपशस्‍त्रौघैर्वृष्णिवीरा भृशार्दिताः।\nन तत्यजू रणं स्वं स्वं लोकद्वयजिगीषवः॥ १०/८७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.020.m4a", "display_order": 21}, {"id": 6000283021, "chapter_id": 10283, "verse_number": "१०-८७-२०", "content_sanskrit": "साल्वामात्यो द्युमान्नाम प्रद्युम्नात् प्राक् प्रपीडितः।\nआसाद्य गदया गुर्व्या व्याहत्य व्यनदद् बली॥ १०/८७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.021.m4a", "display_order": 22, "topics": [{"text": "साल्वमन्त्रि-प्रहारमूर्च्छितस्य प्रद्युम्नस्य सूतेनापवहनम्", "range": "२०–२७"}]}, {"id": 6000283022, "chapter_id": 10283, "verse_number": "१०-८७-२१", "content_sanskrit": "प्रद्युम्नं गदया शीर्णवक्षःस्थलमरिन्दमम्।\nअपोवाह रणात् सूतो धर्मविद् दारुकात्मजः॥ १०/८७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.022.m4a", "display_order": 23}, {"id": 6000283023, "chapter_id": 10283, "verse_number": "१०-८७-२२", "content_sanskrit": "लब्धसञ्ज्ञो मुहूर्तेन कार्ष्णिः सारथिमब्रवीत्।\nअसाध्विदमहो सूत यद्रणान्मेऽपसर्पणम्॥ १०/८७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.023.m4a", "display_order": 24}, {"id": 6000283024, "chapter_id": 10283, "verse_number": "१०-८७-२३", "content_sanskrit": "न यदूनां कुले जातः दृश्यते रणविच्युतः।\nविना मत् क्लीबचित्तेन सूतेन प्राप्तकिल्बिषात्॥ १०/८७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.024.m4a", "display_order": 25}, {"id": 6000283025, "chapter_id": 10283, "verse_number": "१०-८७-२४", "content_sanskrit": "किं नु वक्ष्येऽभिसङ्गम्य पितरौ रामकेशवौ।\nयुद्धाद् धर्म्यादपक्रान्तः पृष्टस्तत्रात्मनाऽक्षमम्॥ १०/८७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.025.m4a", "display_order": 26}, {"id": 6000283026, "chapter_id": 10283, "verse_number": "१०-८७-२५", "content_sanskrit": "व्यक्तं मे कथयिष्यन्ति हसन्त्यो भ्रातृजामयः।\nक्लैब्यं कथं गतो वीर सहान्यैः कथ्यतां मृधे॥ १०/८७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.026.m4a", "display_order": 27}, {"id": 6000283027, "chapter_id": 10283, "verse_number": "१०-८७-२६", "content_sanskrit": "धर्मं विजानताऽऽयुष्मन् कृतमेतन्मया विभो।\nसूतः कृच्छ्रगतं रक्षेद् रथिनं, सारथिं रथी॥ १०/८७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.027.m4a", "display_order": 28}, {"id": 6000283028, "chapter_id": 10283, "verse_number": "१०-८७-२७", "content_sanskrit": "एतद् विदित्वाऽनुभवान्मयाऽद्यापोहितो रणात्।\nउपसृष्टः परेणेति मूर्च्छितो गदया हतः॥ १०/८७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_087/BhP_10.087.028.m4a", "display_order": 29}, {"id": 6000283029, "chapter_id": 10283, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे सप्ताशीतितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]