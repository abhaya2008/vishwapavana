[{"id": 6000186000, "chapter_id": 10186, "verse_number": null, "content_sanskrit": "अथ एकादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000186001, "chapter_id": 10186, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.001.m4a", "display_order": 2}, {"id": 6000186002, "chapter_id": 10186, "verse_number": "९-११-१", "content_sanskrit": "निमिरिक्ष्वाकुतनयो वसिष्ठमवृतर्त्विजम्।\nआरभ्य सत्रं सोऽप्याह शक्रेण प्राग् वृतोऽस्मि भोः॥ ९/११/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.002.m4a", "display_order": 3, "topics": [{"text": "इक्ष्वाकुतनयस्य निमेः कथाकथनपूर्वकं तद्वंश्यानां ज्ञानिनां जनकादीनां वंशकथनम्", "range": "१"}]}, {"id": 6000186003, "chapter_id": 10186, "verse_number": "९-११-२", "content_sanskrit": "तं निर्वर्त्यागमिष्यामि तावन्मां प्रतिपालय।\nतूष्णीमासीद् गृहपतिः सोऽपीन्द्रस्याकरोन्मखम्॥ ९/११/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.003.m4a", "display_order": 4}, {"id": 6000186004, "chapter_id": 10186, "verse_number": "९-११-३", "content_sanskrit": "निमिश्चलमिदं विद्वान् सत्रमारभतात्मवान्।\nऋत्विग्भिरपरैस्तावद् यावत् तन्नागमद् गुरुः॥ ९/११/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.004.m4a", "display_order": 5}, {"id": 6000186005, "chapter_id": 10186, "verse_number": "९-११-४", "content_sanskrit": "शिष्यव्यतिक्रमं वीक्ष्य निर्वर्त्य गुरुरागतः।\nअशपत् पततां देहो निमेः पण्डितमानिनः॥ ९/११/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.005.m4a", "display_order": 6}, {"id": 6000186006, "chapter_id": 10186, "verse_number": "९-११-५", "content_sanskrit": "निमिः प्रतिददौ शापं गुरवेऽधर्मवर्तिने।\nतवापि पततां देहो लोभाद्धर्ममजानतः॥ ९/११/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.006.m4a", "display_order": 7}, {"id": 6000186007, "chapter_id": 10186, "verse_number": "९-११-६", "content_sanskrit": "इत्युत्ससर्ज तं देहं निमिरध्यात्मकोविदः।\nमित्रावरुणयोर्जज्ञे ऊर्वश्यां प्रपितामहः॥ ९/११/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.007.m4a", "display_order": 8}, {"id": 6000186008, "chapter_id": 10186, "verse_number": "९-११-७", "content_sanskrit": "गन्धवस्तुषु तद्देहं निधाय मुनिसत्तमाः।\nसमाप्ते सत्रयागेऽथ देवानूचुः समागतान्॥ ९/११/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.008.m4a", "display_order": 9}, {"id": 6000186009, "chapter_id": 10186, "verse_number": "९-११-८", "content_sanskrit": "राज्ञो जीवतु देहोऽयं प्रसन्नाः प्रभवो यदि।\nतथेत्युक्ते निमिः प्राह मा भून्मे देहबन्धनम्॥ ९/११/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.009.m4a", "display_order": 10}, {"id": 6000186010, "chapter_id": 10186, "verse_number": "९-११-९", "content_sanskrit": "यस्य योगं न वाञ्छन्ति वियोगभयकातराः।\nभजन्ति चरणाम्भोजं मुनयो हरिमेधसः॥ ९/११/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.010.m4a", "display_order": 11}, {"id": 6000186011, "chapter_id": 10186, "verse_number": "९-११-१०", "content_sanskrit": "देहं नावरुरुत्सेऽहं दुःखशोकभयाश्रयम्।\nसर्वत्रास्य यतो मृत्युर्मत्स्यानामुदके यथा॥ ९/११/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.011.m4a", "display_order": 12}, {"id": 6000186012, "chapter_id": 10186, "verse_number": null, "content_sanskrit": "देवा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.012.m4a", "display_order": 13}, {"id": 6000186013, "chapter_id": 10186, "verse_number": "९-११-११", "content_sanskrit": "विदेह उष्यतां कामं लोचनेषु शरीरिणाम्।\nउन्मेषणनिमेषाभ्यां लक्षितोऽध्यात्मसंस्थितः॥ ९/११/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.013.m4a", "display_order": 14}, {"id": 6000186014, "chapter_id": 10186, "verse_number": "९-११-१२", "content_sanskrit": "अराजकभयं नॄणां मन्यमाना महर्षयः।\nदेहं ममन्थुश्च निमेः कुमारः समजायत॥ ९/११/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.014.m4a", "display_order": 15}, {"id": 6000186015, "chapter_id": 10186, "verse_number": "९-११-१३", "content_sanskrit": "जननाज्जनकः सोऽभूद् वैदेहस्तु विदेहजः।\nमिथिलो मथनाज्जातो मिथिला येन निर्मिता॥ ९/११/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.015.m4a", "display_order": 16}, {"id": 6000186016, "chapter_id": 10186, "verse_number": "९-११-१४", "content_sanskrit": "तस्मादुदावसुस्तस्य पुत्रोऽभून्नन्दिवर्धनः।\nततः सुकेतुस्तस्यापि देवरातो महीपतिः॥ ९/११/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.016.m4a", "display_order": 17}, {"id": 6000186017, "chapter_id": 10186, "verse_number": "९-११-१५", "content_sanskrit": "तस्माद् बृहद्रथस्तस्य महावीर्यः सुधृत्पिता।\nसुधृतेर्धृष्टकेतुर्वै हर्यश्वोऽथ मरुस्ततः॥ ९/११/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.017.m4a", "display_order": 18}, {"id": 6000186018, "chapter_id": 10186, "verse_number": "९-११-१६", "content_sanskrit": "मरोः प्रतीन्धकस्तस्माज्जातः कृतरथो यतः।\nदेवमीढस्तस्य सुतो विधृतोऽथ महाधृतिः॥ ९/११/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.018.m4a", "display_order": 19}, {"id": 6000186019, "chapter_id": 10186, "verse_number": "९-११-१७", "content_sanskrit": "कृतिरातस्ततस्तस्मान्महारोमाऽथ तत्सुतः।\nस्वर्णरोमा सुतस्तस्य ह्रस्वरोमा व्यजायत॥ ९/११/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.019.m4a", "display_order": 20}, {"id": 6000186020, "chapter_id": 10186, "verse_number": "९-११-१८", "content_sanskrit": "ततः सीरध्वजो जज्ञे यज्ञार्थं कर्षतो महीम्।\nसीता सीराग्रतो जाता तस्मात् सीरध्वजः स्मृतः॥ ९/११/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.020.m4a", "display_order": 21}, {"id": 6000186021, "chapter_id": 10186, "verse_number": "९-११-१९", "content_sanskrit": "कुशध्वजस्तस्य पुत्रस्ततो धर्मध्वजो नृप।\nधर्मध्वजस्य द्वौ पुत्रौ कृतध्वजमितध्वजौ॥ ९/११/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.021.m4a", "display_order": 22}, {"id": 6000186022, "chapter_id": 10186, "verse_number": "९-११-२०", "content_sanskrit": "कृतध्वजात् केशिध्वजः खाण्डिक्यस्तु मितध्वजात्।\nकृतध्वजसुतो राजन्नात्मविद्याविशारदः॥ ९/११/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.022.m4a", "display_order": 23}, {"id": 6000186023, "chapter_id": 10186, "verse_number": "९-११-२१", "content_sanskrit": "खाण्डिक्यः कर्मतत्त्वज्ञो भीतः केशिध्वजाद् गतः।\nभानुमांस्तस्य पुत्रोऽभूच्छतद्युम्नस्तु तत्सुतः॥ ९/११/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.023.m4a", "display_order": 24}, {"id": 6000186024, "chapter_id": 10186, "verse_number": "९-११-२२", "content_sanskrit": "शुचिस्तु तनयस्तस्मात् सनद्वाजस्ततोऽभवत्।\nऊर्जकेतुः सनद्वाजादजोऽथ कुरुजित्सुतः॥ ९/११/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.024.m4a", "display_order": 25}, {"id": 6000186025, "chapter_id": 10186, "verse_number": "९-११-२३", "content_sanskrit": "अरिष्टनेमिस्तस्यापि श्रुतायुस्तत्सुपार्श्वकः।\nततश्चित्ररथो यस्य क्षेमापिर्मिथिलाधिपः॥ ९/११/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.025.m4a", "display_order": 26}, {"id": 6000186026, "chapter_id": 10186, "verse_number": "९-११-२४", "content_sanskrit": "तस्माद्धेमरथस्तस्य सुतः सत्यरथस्ततः।\nआसीदुपगुरुस्तस्मादुपगुप्तोऽग्निसम्भवः॥ ९/११/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.026.m4a", "display_order": 27}, {"id": 6000186027, "chapter_id": 10186, "verse_number": "९-११-२५", "content_sanskrit": "वैवस्वतोऽथ तत्पुत्रो युयुधो यत्सुभाषणः।\nश्रुतस्ततो जयस्तस्माद् विजयोऽस्माद् ऋतः सुतः॥ ९/११/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.027.m4a", "display_order": 28}, {"id": 6000186028, "chapter_id": 10186, "verse_number": "९-११-२६", "content_sanskrit": "शुनकस्तत्सुतो जज्ञे वीरहव्यो धृतिस्ततः।\nबहुलाश्वो धृतस्तस्य कृतिरस्य महावशी॥ ९/११/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.028.m4a", "display_order": 29}, {"id": 6000186029, "chapter_id": 10186, "verse_number": "९-११-२७", "content_sanskrit": "एते वै मिथिला राजन्नात्मविद्याविशारदाः।\nयोगेश्वरप्रसादेन द्वन्द्वैर्मुक्ता गृहेष्वपि॥ ९/११/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_011/BhP_09.011.029.m4a", "display_order": 30}, {"id": 6000186030, "chapter_id": 10186, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां नवमस्कन्धे एकादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]