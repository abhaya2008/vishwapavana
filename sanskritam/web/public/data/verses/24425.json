[{"id": 7004425000, "chapter_id": 24425, "verse_number": "५-३-११९-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेत्तु राजेन्द्र कह्लोडीतीर्थमुत्तमम् ।\nरेवायाश्चोत्तरे कूले सर्वपापविनाशनम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004425001, "chapter_id": 24425, "verse_number": "५-३-११९-२", "content_sanskrit": "हितार्थं सर्वभूतानामृषिभिः स्थापितं पुरा ।\nतपसा तु समुद्धृत्य नर्मदायां महाम्भसि॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004425002, "chapter_id": 24425, "verse_number": "५-३-११९-३", "content_sanskrit": "स्नात्वा तु कपिलातीर्थे कपिलां यः प्रयच्छति ।\nश्रुत्वा चाख्यानकं दिव्यं ब्राह्मणाञ्छृणु यत्फलम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004425003, "chapter_id": 24425, "verse_number": "५-३-११९-४", "content_sanskrit": "सर्वेषामेव दानानां कपिलादानमुत्तमम् ।\nब्राह्मणान्वेषितं पूर्वमृषिदेवसमागमे॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004425004, "chapter_id": 24425, "verse_number": "५-३-११९-५", "content_sanskrit": "सद्यः प्रसूतां कपिलां शोभनां यः प्रयच्छति ।\nसोपवासो जितक्रोधस्तस्य पुण्यफलं शृणु॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004425005, "chapter_id": 24425, "verse_number": "५-३-११९-६", "content_sanskrit": "ससमुद्रगुहा तेन सशैलवनकानना ।\nदत्ता चैव महाबाहो पृथिवी नात्र संशयः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004425006, "chapter_id": 24425, "verse_number": "५-३-११९-७", "content_sanskrit": "वाचिकं मानसं पापं कर्मणा यत्पुरा कृतम् ।\nनश्यते कपिलां दत्त्वा सप्तजन्मार्जितं नृप॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004425007, "chapter_id": 24425, "verse_number": "५-३-११९-८", "content_sanskrit": "भूमिदानं धनं धान्यं हस्त्यश्वकनकादिकम् ।\nकपिलादानस्यैकस्य कलां नार्हन्ति षोडशीम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004425008, "chapter_id": 24425, "verse_number": "५-३-११९-९", "content_sanskrit": "तत्र तीर्थे नरः स्नात्वा कपिलां यः प्रयच्छति ।\nमृतो विष्णुपुरं याति गीयमानोऽप्सरोगणैः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004425009, "chapter_id": 24425, "verse_number": "५-३-११९-१०", "content_sanskrit": "यावन्ति तस्या रोमाणि सवत्सायास्तु भारत ।\nतावद्वर्षसहस्राणि स स्वर्गे क्रीडते चिरम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004425010, "chapter_id": 24425, "verse_number": "५-३-११९-११", "content_sanskrit": "ततोऽवकीर्णकालेन त्विह मानुष्यतां गतः ।\nधनधान्यसमोपेतो जायते विपुले कुले॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004425011, "chapter_id": 24425, "verse_number": "५-३-११९-१२", "content_sanskrit": "वेदविद्या व्रतस्नातः सर्वशास्त्रविशारदः ।\nव्याधिशोकविनिर्मुक्तो जीवेच्च शरदां शतम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004425012, "chapter_id": 24425, "verse_number": "५-३-११९-१३", "content_sanskrit": "एतत्ते सर्वमाख्यातं कल्होडीतीर्थमुत्तमम् ।\nयत्कृत्वा सर्वपापेभ्यो मुच्यते नात्र संशयः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]