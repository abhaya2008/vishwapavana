[{"id": 5000585000, "chapter_id": 9585, "verse_number": "७-५०-१", "content_sanskrit": "दृष्ट्वा तु मैथिलीं सीतामाश्रमे सम्प्रवेशिताम् ।\nसन्तापमगमद्घोरं लक्ष्मणो दीनचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000585001, "chapter_id": 9585, "verse_number": "७-५०-२", "content_sanskrit": "अब्रवीच्च महातेजाः सुमन्त्रं मन्त्रसारथिम् ।\nसीतासन्तापजं दुःखं पश्य रामस्य सारथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000585002, "chapter_id": 9585, "verse_number": "७-५०-३", "content_sanskrit": "ततो दुःखतरं किं नु राघवस्य भविष्यति ।\nपत्नीं शुद्धसमाचारां विसृज्य जनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000585003, "chapter_id": 9585, "verse_number": "७-५०-४", "content_sanskrit": "व्यक्तं दैवादहं मन्ये राघवस्य विना भवम् ।\nवैदेह्या सारथे नित्यं दैवं हि दुरतिक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000585004, "chapter_id": 9585, "verse_number": "७-५०-५", "content_sanskrit": "यो हि देवान्सगन्धर्वानसुरान्सह राक्षसैः ।\nनिहन्याद्राघवः क्रुद्धः स दैवमनुवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000585005, "chapter_id": 9585, "verse_number": "७-५०-६", "content_sanskrit": "पुरा रामः पितुर्वाक्याद्दण्डके विजने वने ।\nउषित्वा नव वर्षाणि पञ्च चैव महावने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000585006, "chapter_id": 9585, "verse_number": "७-५०-७", "content_sanskrit": "ततो दुःखतरं भूयः सीताया विप्रवासनम् ।\nपौराणां वचनं श्रुत्वा नृशंसं प्रतिभाति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000585007, "chapter_id": 9585, "verse_number": "७-५०-८", "content_sanskrit": "को नु धर्माश्रयः सूत कर्मण्यस्मिन्यशोहरे ।\nमैथिलीं प्रतिसम्प्राप्तः पौरैर्हीनार्थवादिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000585008, "chapter_id": 9585, "verse_number": "७-५०-९", "content_sanskrit": "एता वाचो बहुविधाः श्रुत्वा लक्ष्मणभाषिताः ।\nसुमन्त्रः श्रद्धया प्राज्ञो वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000585009, "chapter_id": 9585, "verse_number": "७-५०-१०", "content_sanskrit": "न सन्तापस्त्वया कार्यः सौमित्रे मैथिलीं प्रति ।\nदृष्टमेतत्पुरा विप्रैः पितुस्ते लक्ष्मणाग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000585010, "chapter_id": 9585, "verse_number": "७-५०-११", "content_sanskrit": "भविष्यति दृढं रामो दुःखप्रायो ऽपि सौख्यभाक् ।\nप्राप्स्यते च महाबाहुर्विप्रयोगं प्रियैर्ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000585011, "chapter_id": 9585, "verse_number": "७-५०-१२", "content_sanskrit": "त्वां चैव मैथिलीं चैव शत्रुघ्नभरतावुभौ ।\nसन्त्यजिष्यति धर्मात्मा कालेन महता महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000585012, "chapter_id": 9585, "verse_number": "७-५०-१३", "content_sanskrit": "इदं त्वयि न वक्तव्यं सौमित्रे भरते ऽपि वा ।\nराज्ञा वो व्याहृतं वाक्यं दुर्वासा यदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000585013, "chapter_id": 9585, "verse_number": "७-५०-१४", "content_sanskrit": "महाजनसमीपे च मम चैव नरर्षभ ।\nऋषिणा व्याहृतं वाक्यं वसिष्ठस्य च सन्निधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000585014, "chapter_id": 9585, "verse_number": "७-५०-१५", "content_sanskrit": "ऋषेस्तु वचनं श्रुत्वा मामाह पुरुषर्षभः ।\nसूत न क्वचिदेवं ते वक्तव्यं जनसन्निधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000585015, "chapter_id": 9585, "verse_number": "७-५०-१६", "content_sanskrit": "तस्याहं लोकपालस्य वाक्यं तत्सुसमाहितः ।\nनैव जात्वनृतं कार्यमिति मे सौम्य दर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000585016, "chapter_id": 9585, "verse_number": "७-५०-१७", "content_sanskrit": "सर्वथैव न वक्तव्यं मया सौम्य तवाग्रतः ।\nयदि ते श्रवणे श्रद्धा श्रूयतां रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000585017, "chapter_id": 9585, "verse_number": "७-५०-१८", "content_sanskrit": "यद्यप्यहं नरेन्द्रेण रहस्यं श्रावितः पुरा ।\nतथाप्युदाहरिष्यामि दैवं हि दुरतिक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000585018, "chapter_id": 9585, "verse_number": "७-५०-१९", "content_sanskrit": "येनेदमीदृशं प्राप्तं दुःखं शोकसमन्वितम् ।\nन त्वया भरते वाच्यं शत्रुघ्नस्यापि सन्निधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000585019, "chapter_id": 9585, "verse_number": "७-५०-२०", "content_sanskrit": "तच्छ्रुत्वा भाषितं तस्य गम्भीरार्थपदं महत् ।\nतथ्यं ब्रूहीति सौमित्रिः सूतं वाक्यमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000585020, "chapter_id": 9585, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]