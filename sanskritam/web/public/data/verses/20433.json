[{"id": 7000433000, "chapter_id": 20433, "verse_number": "२-१०५-१", "content_sanskrit": "कुंजल उवाच ।\nगता सा नंदनवनं सखीभिः सह क्रीडितुम् ।\nतत्राकर्ण्य महद्वाक्यमप्रियं तु तदा पितुः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000433001, "chapter_id": 20433, "verse_number": "२-१०५-२", "content_sanskrit": "चारणानां सुसिद्धानां भाषतां हर्षणेन तु ।\nआयोर्गेहे महावीर्यो विष्णुतुल्यपराक्रमः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000433002, "chapter_id": 20433, "verse_number": "२-१०५-३", "content_sanskrit": "भविष्यति सुतश्रेष्ठो हुंडस्यांतं करिष्यति ।\nएवंविधं महद्वाक्यमप्रियं दुःखदायकम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000433003, "chapter_id": 20433, "verse_number": "२-१०५-४", "content_sanskrit": "समाकर्ण्य समायाता पितुरग्रे निवेदितम् ।\nसमासेन तया तस्य पुरतो दुःखदायकम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000433004, "chapter_id": 20433, "verse_number": "२-१०५-५", "content_sanskrit": "पितुरग्रे जगादाथ पिता श्रुत्वा स विस्मितः ।\nशापमशोकसुंदर्याः सस्मार च पुराकृतम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000433005, "chapter_id": 20433, "verse_number": "२-१०५-६", "content_sanskrit": "एतस्यार्थे तपस्तेपे सेयं चाशोकसुंदरी ।\nगर्भस्य नाशनायैव इंदुमत्याः स दानवः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000433006, "chapter_id": 20433, "verse_number": "२-१०५-७", "content_sanskrit": "विचक्रे उद्यमं दुष्टः कालाकृष्टो दुरात्मवान् ।\nछिद्रान्वेषी ततो भूत्वा इंदुमत्यास्तु नित्यशः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000433007, "chapter_id": 20433, "verse_number": "२-१०५-८", "content_sanskrit": "यदा पश्यति तां राज्ञीं रूपौदार्यगुणान्विताम् ।\nदिव्यतेजः समायुक्तां रक्षितां विष्णुतेजसा॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000433008, "chapter_id": 20433, "verse_number": "२-१०५-९", "content_sanskrit": "दिव्येन तेजसा युक्तां सूर्यबिंबोपमां तु ताम् ।\nतस्याः पार्श्वे महाभाग रक्षणार्थं स्थितः सदा॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000433009, "chapter_id": 20433, "verse_number": "२-१०५-१०", "content_sanskrit": "दूरात्स दानवो दुष्टस्तस्याश्च बहुदर्शयन् ।\nनानाविद्यां महोग्रां च भीषिकां सुविभीषिकाम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000433010, "chapter_id": 20433, "verse_number": "२-१०५-११", "content_sanskrit": "गर्भस्य तेजसा युक्ता रक्षिता विष्णुतेजसा ।\nभयं न जायते तस्या मनस्येव कदापुनः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000433011, "chapter_id": 20433, "verse_number": "२-१०५-१२", "content_sanskrit": "विफलो दानवो जात उद्यमश्च निरर्थकः ।\nमनीप्सितं नैव जातं हुंडस्यापि दुरात्मनः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000433012, "chapter_id": 20433, "verse_number": "२-१०५-१३", "content_sanskrit": "एवं वर्षशतं पूर्णं पश्यमानस्य तस्य च ।\nप्रसूता सा हि पुत्रं च स्वर्भानोस्तनया तदा॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000433013, "chapter_id": 20433, "verse_number": "२-१०५-१४", "content_sanskrit": "रात्रावेव सुतश्रेष्ठ तस्याः पुत्रो व्यजायत ।\nतेजसातीव भात्येष यथा सूर्यो नभस्तले॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000433014, "chapter_id": 20433, "verse_number": "२-१०५-१५", "content_sanskrit": "सूत उवाच ।\nअथ दासी महादुष्टा काचित्सूतिगृहागता ।\nअशौचाचारसंयुक्ता महामंगलवादिनी॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000433015, "chapter_id": 20433, "verse_number": "२-१०५-१६", "content_sanskrit": "तस्याः सर्वं समाज्ञाय स हुंडो दानवाधमः ।\nदास्या अंगं प्रविश्यैव प्रविष्टश्चायुमन्दिरे॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000433016, "chapter_id": 20433, "verse_number": "२-१०५-१७", "content_sanskrit": "महाजने प्रसुप्ते च निद्रयातीवमोहिते ।\nतं पुत्रं देवगर्भाभमपहृत्य बहिर्गतः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000433017, "chapter_id": 20433, "verse_number": "२-१०५-१८", "content_sanskrit": "कांचनाख्यपुरे प्राप्तः स्वकीये दानवाधमः ।\nसमाहूय प्रियां भार्यां विपुलां वाक्यमब्रवीत्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000433018, "chapter_id": 20433, "verse_number": "२-१०५-१९", "content_sanskrit": "वधस्वैनं महापापं बालरूपं रिपुं मम ।\nपश्चात्सूदस्य वै हस्ते भोजनार्थं प्रदीयताम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000433019, "chapter_id": 20433, "verse_number": "२-१०५-२०", "content_sanskrit": "नानाभेदैर्विभेदैश्च पाचयस्व हि निर्घृणम् ।\nसूदहस्तान्महाभागे पश्चाद्भोक्ष्ये न संशयः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000433020, "chapter_id": 20433, "verse_number": "२-१०५-२१", "content_sanskrit": "वाक्यमाकर्ण्य तद्भर्तुर्विपुला विस्मिताभवत् ।\nकस्मान्निर्घृणतां याति भर्त्ता मम सुनिष्ठुरः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000433021, "chapter_id": 20433, "verse_number": "२-१०५-२२", "content_sanskrit": "सर्वलक्षणसंपन्नं देवगर्भोपमं सुतम् ।\nकस्य कस्मात्प्रभक्ष्येत क्षमाहीनः सुनिर्घृणः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000433022, "chapter_id": 20433, "verse_number": "२-१०५-२३", "content_sanskrit": "इत्येवं चिंतयामास कारुण्येन समन्विता ।\nपुनः पप्रच्छ भर्तारं कस्माद्भक्ष्यसि बालकम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000433023, "chapter_id": 20433, "verse_number": "२-१०५-२४", "content_sanskrit": "कस्माद्भवसि संक्रुद्धो अतीव निरपत्रपः ।\nसर्वं मे कारणं ब्रूहि तत्त्वेन दनुजेश्वर॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000433024, "chapter_id": 20433, "verse_number": "२-१०५-२५", "content_sanskrit": "आत्मदोषं च वृत्तांतं समासेन निवेदितम् ।\nशापमशोकसुंदर्या हुंडेनापि दुरात्मना॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000433025, "chapter_id": 20433, "verse_number": "२-१०५-२६", "content_sanskrit": "तया ज्ञातं तु तत्सर्वं कारणं दानवस्य वै ।\nवध्योऽयं बालकः सत्यं नो वा भर्त्ता मरिष्यति॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000433026, "chapter_id": 20433, "verse_number": "२-१०५-२७", "content_sanskrit": "इत्येवं प्रविचार्यैव विपुला क्रोधमूर्च्छिता ।\nमेकलां तु समाहूय सैरंध्रीं वाक्यमब्रवीत्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000433027, "chapter_id": 20433, "verse_number": "२-१०५-२८", "content_sanskrit": "जह्येनं बालकं दुष्टं मेकलेऽद्य महानसे ।\nसूदहस्ते प्रदेहि त्वं हुण्डभोजनहेतवे॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000433028, "chapter_id": 20433, "verse_number": "२-१०५-२९", "content_sanskrit": "मेकला बालकं गृह्य सूदमाहूय चाब्रवीत् ।\nराजादेशं कुरुष्वाद्य पचस्वैनं हि बालकम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000433029, "chapter_id": 20433, "verse_number": "२-१०५-३०", "content_sanskrit": "एवमाकर्णितं तेन सूदेनापि महात्मना ।\nआदाय बालकं हस्ताच्छस्त्रमुद्यम्य चोद्यतः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000433030, "chapter_id": 20433, "verse_number": "२-१०५-३१", "content_sanskrit": "एष वै देवदेवस्य दत्तात्रेयस्य तेजसा ।\nरक्षितस्त्वायुपुत्रश्च स जहास पुनः पुनः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000433031, "chapter_id": 20433, "verse_number": "२-१०५-३२", "content_sanskrit": "हसंतं तं समालोक्य स सूदः कृपयान्वितः ।\nसैरंध्री च कृपायुक्ता सूदं तं प्रत्यभाषत॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000433032, "chapter_id": 20433, "verse_number": "२-१०५-३३", "content_sanskrit": "नैष वध्यस्त्वया सूद शिशुरेव महामते ।\nदिव्यलक्षणसंपन्नः कस्य जातः सुसत्कुले॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000433033, "chapter_id": 20433, "verse_number": "२-१०५-३४", "content_sanskrit": "सूद उवाच ।\nसत्यमुक्तं त्वया भद्रे वाक्यं वै कृपयान्वितम् ।\nराजलक्षणसंपन्नो रूपवान्कस्य बालकः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000433034, "chapter_id": 20433, "verse_number": "२-१०५-३५", "content_sanskrit": "कस्माद्भोक्ष्यति दुष्टात्मा हुंडोऽयं दानवाधमः ।\nयेन वै रक्षितो वंशः पूर्वमेव सुकर्मणा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000433035, "chapter_id": 20433, "verse_number": "२-१०५-३६", "content_sanskrit": "आपत्स्वपि स जीवेत दुर्गेषु नान्यथा भवेत् ।\nसिंधुवेगेन नीतस्तु वह्निमध्ये गतोऽथवा॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000433036, "chapter_id": 20433, "verse_number": "२-१०५-३७", "content_sanskrit": "जीवतेनात्र संदेहो यश्च कर्मसहायवान् ।\nतस्माद्धि क्रियते कर्म धर्मपुण्यसमन्वितम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000433037, "chapter_id": 20433, "verse_number": "२-१०५-३८", "content_sanskrit": "आयुष्मंतो नरास्तेन प्रवदंति सुखं ततः ।\nतारकं पालकं कर्म रक्षते जाग्रते हि तत्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000433038, "chapter_id": 20433, "verse_number": "२-१०५-३९", "content_sanskrit": "मुक्तिदं जायते नित्यं मैत्रस्थानप्रदायकम् ।\nदानपुण्यान्वितं कर्म प्रियवाक्यसमन्वितम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000433039, "chapter_id": 20433, "verse_number": "२-१०५-४०", "content_sanskrit": "उपकारयुतं यश्च करोति शुभकृत्तदा ।\nतमेव रक्षते कर्म सर्वदैव न संशयः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000433040, "chapter_id": 20433, "verse_number": "२-१०५-४१", "content_sanskrit": "अन्ययोनिं प्रयाति स्म प्रेरितः स्वेन कर्मणा ।\nकिं करोति पिता माता अन्ये स्वजनबान्धवाः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000433041, "chapter_id": 20433, "verse_number": "२-१०५-४२", "content_sanskrit": "कर्मणा निहतो यस्तु न स्युस्तस्य च रक्षणे ।\nसूत उवाच ।\nयेनैव कर्मणा चैव रक्षितश्चायुनंदनः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000433042, "chapter_id": 20433, "verse_number": "२-१०५-४३", "content_sanskrit": "तस्मात्कृपान्वितो जातः सूदः कर्मवशानुगः ।\nसैरंध्री च तथा जाता प्रेरिता तस्य कर्मणा॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000433043, "chapter_id": 20433, "verse_number": "२-१०५-४४", "content_sanskrit": "द्वाभ्यामेव सुतश्चायो रक्षितश्चारुलक्षणः ।\nरात्रावेव प्रणीतोऽसौ तस्माद्गेहान्महाश्रमे॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000433044, "chapter_id": 20433, "verse_number": "२-१०५-४५", "content_sanskrit": "वशिष्ठस्याश्रमे पुण्ये सैरंध्र्या पुण्यकर्मणा ।\nशुभे पर्णकुटीद्वारे तस्मिन्नेव महाश्रमे॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000433045, "chapter_id": 20433, "verse_number": "२-१०५-४६", "content_sanskrit": "गता सा स्वगृहं पश्चान्निक्षिप्य बालकोत्तमम् ।\nएणं निपात्य सूदेन पाचितं मांसमेव हि॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000433046, "chapter_id": 20433, "verse_number": "२-१०५-४७", "content_sanskrit": "भोजयित्वा सुदैत्येंद्रो हुंडो हृष्टोभवत्तदा ।\nशापमशोकसुंदर्या मोघं मेने तदासुरः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000433047, "chapter_id": 20433, "verse_number": "२-१०५-४८", "content_sanskrit": "हर्षेण महताविष्टः स हुंडो दानवेश्वरः ।\nकुंजल उवाच ।\nप्रभाते विमले जाते वशिष्ठो मुनिसत्तमः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000433048, "chapter_id": 20433, "verse_number": "२-१०५-४९", "content_sanskrit": "बहिर्गतो हि धर्मात्मा कुटीद्वारात्प्रपश्यति ।\nसंपूर्णं बालकं दृष्ट्वा दिव्यलक्षणसंयुतम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000433049, "chapter_id": 20433, "verse_number": "२-१०५-५०", "content_sanskrit": "संपूर्णेंदुप्रतीकाशं सुंदरं चारुलोचनम् ।\nवशिष्ठ उवाच ।\nपश्यंतु मुनयः सर्वे यूयमागत्य बालकम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000433050, "chapter_id": 20433, "verse_number": "२-१०५-५१", "content_sanskrit": "कस्य केन समानीतं रात्रौ द्वारांगणे मम ।\nदेवगंधर्वगर्भाभं राजलक्षणसंयुतम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000433051, "chapter_id": 20433, "verse_number": "२-१०५-५२", "content_sanskrit": "कंदर्पकोटिसंकाशं पश्यंतु मुनयोऽमलम् ।\nमहाकौतुकसंयुक्ता हृष्टा द्विजवरास्ततः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000433052, "chapter_id": 20433, "verse_number": "२-१०५-५३", "content_sanskrit": "समपश्यन्सुतं ते तु आयोश्चैव महात्मनः ।\nवशिष्ठः स तु धर्मात्मा ज्ञानेनालोक्य बालकम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000433053, "chapter_id": 20433, "verse_number": "२-१०५-५४", "content_sanskrit": "आयुपुत्रं समाज्ञातं चरित्रेण समन्वितम् ।\nवृत्तांतं तस्य दुष्टस्य हुण्डस्यापि दुरात्मनः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000433054, "chapter_id": 20433, "verse_number": "२-१०५-५५", "content_sanskrit": "कृपया ब्रह्मपुत्रस्तु समुत्थाय सुबालकम् ।\nकराभ्यामथ गृह्णाति यावद्द्विजो वरोत्तमः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000433055, "chapter_id": 20433, "verse_number": "२-१०५-५६", "content_sanskrit": "तावत्पुष्पसुवृष्टिं च चक्रुर्देवाः सुतोपरि ।\nललितं सुस्वरं गीतं जगुर्गंधर्वकिन्नराः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000433056, "chapter_id": 20433, "verse_number": "२-१०५-५७", "content_sanskrit": "ऋषयो वेदमंत्रैस्तु स्तुवंति नृपनंदनम् ।\nवशिष्ठस्तं समालोक्य वरं वै दत्तवांस्तदा॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000433057, "chapter_id": 20433, "verse_number": "२-१०५-५८", "content_sanskrit": "नहुषेत्येव ते नाम ख्यातं लोके भविष्यति ।\nहुषितो नैव तेनापि बालभावैर्नराधिप॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000433058, "chapter_id": 20433, "verse_number": "२-१०५-५९", "content_sanskrit": "तस्मान्नहुष ते नाम देवपूज्यो भविष्यसि ।\nजातकर्मादिकं कर्म तस्य चक्रे द्विजोत्तमः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000433059, "chapter_id": 20433, "verse_number": "२-१०५-६०", "content_sanskrit": "व्रतदानं विसर्गं च गुरुशिष्यादिलक्षणम् ।\nवेदं चाधीत्य संपूर्णं षडंगं सपदक्रमम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000433060, "chapter_id": 20433, "verse_number": "२-१०५-६१", "content_sanskrit": "सर्वाण्येव च शास्त्राणि अधीत्य द्विजसत्तमात् ।\nवशिष्ठाच्च धनुर्वेदं सरहस्यं महामतिः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000433061, "chapter_id": 20433, "verse_number": "२-१०५-६२", "content_sanskrit": "शस्त्राण्यस्त्राणि दिव्यानि ग्राहमोक्षयुतानि च ।\nज्ञानशास्त्रादिकं न्याय राजनीतिगुणादिकान्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000433062, "chapter_id": 20433, "verse_number": "२-१०५-६३", "content_sanskrit": "वशिष्ठादायुपुत्रश्च शिष्यरूपेण भक्तिमान् ।\nएवं स सर्वनिष्पन्नो नाहुषश्चातिसुंदरः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000433063, "chapter_id": 20433, "verse_number": "२-१०५-६४", "content_sanskrit": "वशिष्ठस्य प्रसादाच्च चापबाणधरोभवत्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]