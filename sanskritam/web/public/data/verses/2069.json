[{"id": 2048565, "chapter_id": 2069, "verse_number": "६-११८-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2048566, "chapter_id": 2069, "verse_number": "६-११८-१", "content_sanskrit": "असंव्यूढेष्वनीकेषु भूयिष्ठमनुवर्तिषु ।\nब्रह्मलोकपराः सर्वे समपद्यन्त भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2048567, "chapter_id": 2069, "verse_number": "६-११८-२", "content_sanskrit": "च ह्यनीकमनीकेषु समसञ्जत संकले ।\nरथा न रथिभिः सार्धं पादाता न पदातिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2048568, "chapter_id": 2069, "verse_number": "६-११८-३", "content_sanskrit": "अश्वा नाश्वैरयुध्यन्त गजा न गजयोधिभिः ।\nउन्मत्तवन्महाराज युध्यन्ते तत्र भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2048569, "chapter_id": 2069, "verse_number": "६-११८-४", "content_sanskrit": "महान्व्यतिकरो रौद्रः सेनयोः समपद्यत ।\nनरनागगणेष्वेवं विकीर्णेषु च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2048570, "chapter_id": 2069, "verse_number": "६-११८-५", "content_sanskrit": "क्षये तस्मिन्महारौद्रे निर्विशेषमजायत ।\nततः शल्यः कृपश्चैव चित्रसेनश्च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2048571, "chapter_id": 2069, "verse_number": "६-११८-६", "content_sanskrit": "दुःशासनो विकर्णश्च रथानास्थाय भास्वरान् ।\nपाण्डवानां रणे शूरा ध्वजिनीं समकम्पयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2048572, "chapter_id": 2069, "verse_number": "६-११८-७", "content_sanskrit": "सा वध्यमाना समरे पाण्डुसेना महात्मभिः ।\nत्रातारं नाध्यगच्छद्वै मञ्जमानेव नौर्जंले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2048573, "chapter_id": 2069, "verse_number": "६-११८-८", "content_sanskrit": "यथा हि शैशिरः कालो गवां मर्माणि कृन्तति।\nतथा पाण्डुसुतानां वै भीष्मो मर्माणि कृन्तति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2048574, "chapter_id": 2069, "verse_number": "६-११८-९", "content_sanskrit": "तथैव तव सैन्यस्य पार्थेन च महात्मना।\nनवमेघप्रतीकाशाः पातिता बहुधा गजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2048575, "chapter_id": 2069, "verse_number": "६-११८-१०", "content_sanskrit": "मृद्यमानाश्च दृश्यन्ते पार्थेन नरयूथपाः ।\nइषुभिस्ताड्यमानाश्च नाराचैश्च सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2048576, "chapter_id": 2069, "verse_number": "६-११८-११", "content_sanskrit": "पेतुरार्तस्वरं घोरं कृत्वा तत्र महागजाः ।\nआनद्धाभरणैः कायैर्निहतानां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2048577, "chapter_id": 2069, "verse_number": "६-११८-१२", "content_sanskrit": "छन्नमायोधनं रेजे शिरोभिश्च सकुण्डलैः । ६-११८-१२bतस्मिन्नेव महाराज महावीरवरक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2048578, "chapter_id": 2069, "verse_number": "६-११८-१३", "content_sanskrit": "भीष्मे च युधि विक्रान्ते पाण्डवे च धनञ्जये ।\nते पराक्रान्तमालोक्य राजन्युधि पितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2048579, "chapter_id": 2069, "verse_number": "६-११८-१४", "content_sanskrit": "अभ्यवर्तन्त ते पुत्राः सर्वे सैन्यपुरस्कृताः ।\nइच्छन्तो निधनं युद्धे स्वर्गं कृत्वा परायणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2048580, "chapter_id": 2069, "verse_number": "६-११८-१५", "content_sanskrit": "पाण्डवानभ्यवर्तन्त तस्मिन्वीरवरक्षये ।\nपाण्डवापि महाराज स्मरन्तो विविधान्बहून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2048581, "chapter_id": 2069, "verse_number": "६-११८-१६", "content_sanskrit": "क्लेशान्कृतान्सपुत्रेण त्वया पूर्वं नराधिप ।\nभयं त्यक्त्वा रणे शूरा ब्रह्मलोकाय तत्पराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2048582, "chapter_id": 2069, "verse_number": "६-११८-१७", "content_sanskrit": "तावकांस्तव पुत्रांश्च योधयन्ति प्रहृष्टवत्।\nसेनापतिस्तु समरे प्राह सेनां महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2048583, "chapter_id": 2069, "verse_number": "६-११८-१८", "content_sanskrit": "अभिद्रवत गाङ्गेयं सोमकाः सृञ्जयैः सह ।\nसेनापतिवचः श्रुत्वा सोमकाः सृञ्जयाश्च ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2048584, "chapter_id": 2069, "verse_number": "६-११८-१९", "content_sanskrit": "अभ्यद्रवन्त गाङ्गेयं शरवृष्ट्या समाहताः ।\nवध्यमानस्ततो राजन्पिता शान्तनवस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2048585, "chapter_id": 2069, "verse_number": "६-११८-२०", "content_sanskrit": "अमर्षवशमापन्नो योधयामास सृञ्जयान्।\nतस्य कीर्तिमतस्तात पुरा रामेण धीमता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2048586, "chapter_id": 2069, "verse_number": "६-११८-२१", "content_sanskrit": "संप्रदत्ताऽस्त्रशिक्षा वै परानीकविनाशनी ।\nस तां विद्यामधिष्ठाय कुर्वन्तपरबलक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2048587, "chapter_id": 2069, "verse_number": "६-११८-२२", "content_sanskrit": "अहन्यहनि पार्थानां वृद्धः कुरुपितामहः ।\nभीष्मो दशसहस्राणि जघान परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2048588, "chapter_id": 2069, "verse_number": "६-११८-२३", "content_sanskrit": "तस्मिंस्तु दशमे प्राप्ते दिवसे भरतर्षभ ।\nएको भीष्मो हि मत्स्येषु पाञ्चालेषु च संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2048589, "chapter_id": 2069, "verse_number": "६-११८-२४", "content_sanskrit": "गजाश्वममितं हत्वा हत्वा सप्त महारथान् ।\nहत्वा पञ्चसहस्राणि रथानां प्रतिपामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2048590, "chapter_id": 2069, "verse_number": "६-११८-२५", "content_sanskrit": "नराणां च महायुद्धे सहस्राणि चतुर्दश ।\nदन्तिनां च सहस्राणि हयानामयुतं पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2048591, "chapter_id": 2069, "verse_number": "६-११८-२६", "content_sanskrit": "शिक्षबलेन न्यहनत्पिता तव विशांपते ।\nततः सर्वमहीपानां क्षपयित्वा वरूथिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2048592, "chapter_id": 2069, "verse_number": "६-११८-२७", "content_sanskrit": "विराटस्य प्रियो भ्राता शतानीको निपातितः।\nशतानीकं च समरे हत्वा भीष्मः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2048593, "chapter_id": 2069, "verse_number": "६-११८-२८", "content_sanskrit": "सहस्राणि महाराज राज्ञां भल्लैरपातयत्।\nउद्विग्नाः समरे योधा विक्रोशन्ति धनञ्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2048594, "chapter_id": 2069, "verse_number": "६-११८-२९", "content_sanskrit": "ये च केचन पार्थानामभियाता धनञ्जयम् ।\nराजानो भीष्ममासाद्य गतास्ते यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2048595, "chapter_id": 2069, "verse_number": "६-११८-३०", "content_sanskrit": "किरन्दश दिशो भीष्मः शरजालैः समन्ततः ।\nअतीत्य सेनां पार्थानामवतस्थे चमूमुखे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2048596, "chapter_id": 2069, "verse_number": "६-११८-३१", "content_sanskrit": "स कृत्वा सुमहत्कर्म तस्मिन्वै दशमेऽहनि।\nसेनयोरन्तरे तिष्ठन्प्रगृहीतशरासनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2048597, "chapter_id": 2069, "verse_number": "६-११८-३२", "content_sanskrit": "न चैनं पार्थिवाः केचिच्छक्ता राजन्निरीक्षितुम् ।\nमध्यं प्राप्तं यथा ग्रीष्मे तपन्तं भास्करं दिवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2048598, "chapter_id": 2069, "verse_number": "६-११८-३३", "content_sanskrit": "यथा दैत्यचमूं शक्रस्तापयामास संयुगे ।\nतथा भीष्मः पाण्डवेयांस्तापयामास भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2048599, "chapter_id": 2069, "verse_number": "६-११८-३४", "content_sanskrit": "तथा चैनं पराक्रान्तमालोक्य मधुसूदनः।\nउवाच देवकीपुत्रः प्रीयमाणो धनञ्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2048600, "chapter_id": 2069, "verse_number": "६-११८-३५", "content_sanskrit": "एष शान्तनवो भीष्मः सेनयोरन्तरे स्थितः ।\nसन्निहत्य बलादेनं विजयस्ते भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2048601, "chapter_id": 2069, "verse_number": "६-११८-३६", "content_sanskrit": "बलात्संस्तम्भयस्वैनं यत्रैषा भिद्यते चमूः ।\nन हि भीष्मशरानन्यः सोढुमुत्सहते विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2048602, "chapter_id": 2069, "verse_number": "६-११८-३७", "content_sanskrit": "ततस्तस्मिन्क्षणे राजंश्चोदितो वानरध्वजः ।\nसध्वजं सरथं साश्वं भीष्ममन्तर्दधे शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2048603, "chapter_id": 2069, "verse_number": "६-११८-३८", "content_sanskrit": "स चापि कुरुमुख्यानामृषभः पाण्डवेरितान्।\nसरव्रतैः शरव्रातान्बहुधा विदुधाव तान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2048604, "chapter_id": 2069, "verse_number": "६-११८-३९", "content_sanskrit": "ततः पाञ्चालराजश्च धृष्टकेतुश्च वीर्यवान् ।\nपाण्डवो भीमसेनश्च धृष्टद्युम्नश्च पार्षतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2048605, "chapter_id": 2069, "verse_number": "६-११८-४०", "content_sanskrit": "यमौ च चेकितानश्च केकयाः पञ्च चैव ह ।\nसात्यकिश्च महाबाहुः सौभद्रोऽथ घटोत्कचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2048606, "chapter_id": 2069, "verse_number": "६-११८-४१", "content_sanskrit": "द्रौपदेयाः शिखण्डी च कुन्तिभोजश्च वीर्यवान् ।\nविराटश्च महाराज पाण्डवेया महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2048607, "chapter_id": 2069, "verse_number": "६-११८-४२", "content_sanskrit": "एते चान्ये च बहवः पीडिता भीष्मसायकैः ।\nसमुद्धृताः फल्गुनेन निमग्नाः शोकसागरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2048608, "chapter_id": 2069, "verse_number": "६-११८-४३", "content_sanskrit": "ततः शिखण्डी वेगेन प्रगृह्य परमायुधम्।\nभीष्ममेवाभिदुद्राव रक्ष्यमाणः किरीटिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2048609, "chapter_id": 2069, "verse_number": "६-११८-४४", "content_sanskrit": "ततोऽस्यानुचरान्हत्वा सर्वान्रणविभागवित् ।\nभीष्ममेवाभिदुद्राव बीभत्सुरपराजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2048610, "chapter_id": 2069, "verse_number": "६-११८-४५", "content_sanskrit": "सात्यकिश्चेकितानश्च धृष्टद्युम्नश्च पार्षतः ।\nविराटो द्रुपदश्चैव माद्रीपुत्रौ च पाण्डवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2048611, "chapter_id": 2069, "verse_number": "६-११८-४६", "content_sanskrit": "दुद्रुवुर्भीष्ममेवाजौ रक्षिता दृढधन्वना ।\nअभिमन्युश्च समरे द्रौपद्याः पञ्च चात्मजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2048612, "chapter_id": 2069, "verse_number": "६-११८-४७", "content_sanskrit": "ददृशुः समरे भीष्मं समुद्यतमहायुधम् ।\nते सर्वे दृढधन्वानः संयुगेष्वपलायिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2048613, "chapter_id": 2069, "verse_number": "६-११८-४८", "content_sanskrit": "बहुधा भीष्ममानर्च्छुर्मार्गणैः क्षतमार्गणैः ।\nविधूय तान्बाणगणान्ये मुक्ताः पार्थिवोत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2048614, "chapter_id": 2069, "verse_number": "६-११८-४९", "content_sanskrit": "पाण्डवानामदीनात्मा व्यगाहत वरूथिनीम् ।\nचक्रे शरविघातं च क्रीडन्निव पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2048615, "chapter_id": 2069, "verse_number": "६-११८-५०", "content_sanskrit": "नाभिसंधत्त पाञ्चाल्ये स्मयमानो मुहुर्मुहुः ।\nस्त्रीत्वं तस्यानुसंस्मृत्य भीष्मो बाणाञ्शिखण्डिने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2048616, "chapter_id": 2069, "verse_number": "६-११८-५१", "content_sanskrit": "जघान द्रुपदानीके रथान्सप्त महारथः ।\nततः किलकिलाशब्दः क्षणेन समभूत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2048617, "chapter_id": 2069, "verse_number": "६-११८-५२", "content_sanskrit": "मत्स्यपाञ्चालचेदीनां तमेकमभिधावताम् ।\nते नराश्वरथव्रातैर्मार्गणैश्च परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2048618, "chapter_id": 2069, "verse_number": "६-११८-५३", "content_sanskrit": "तमेकं छादयामासुर्मेघा इव दिवाकरम् ।\nभीष्मं भागीरथीपुत्रं प्रतपन्तं रणे रिपून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2048619, "chapter_id": 2069, "verse_number": "६-११८-५४", "content_sanskrit": "ततस्तस्य च तेषां च युद्धे देवासुरोपमे ।\nकिरीटी भीष्ममानर्च्छ पुरस्कृत्य शिखण्डिनम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2048620, "chapter_id": 2069, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि दशमदिवसयुद्धे अष्टादशाधिकशततमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-११८-१ अनिवर्तिषु इति झo पाठः ॥ ६-११८-४ व्यतिकरः क्षोभः ॥ ६-११८-४९ अदीनात्मा अक्षीणस्वभावः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]