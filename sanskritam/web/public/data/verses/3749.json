[{"id": 2128258, "chapter_id": 3749, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2128259, "chapter_id": 3749, "verse_number": "१", "content_sanskrit": "ततः सम्प्रस्थितो राजा कौन्तेयो भूरिदक्षिणः ।\nअगस्त्याश्रममासाद्य दुर्जयायामुवास ह \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2128260, "chapter_id": 3749, "verse_number": "२", "content_sanskrit": "तत्रैव लोमशं राजा पप्रच्छ वदतां वरः ।\nअगस्त्येनेह वातापिः किमर्थमुपशामितः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2128261, "chapter_id": 3749, "verse_number": "३", "content_sanskrit": "आसीद्वा किम्प्रभावश्च स दैत्यो मनुजान्तकः ।\nकिमर्थं चोद्यतो मन्युरगस्त्यस्य महात्मनः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2128262, "chapter_id": 3749, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2128263, "chapter_id": 3749, "verse_number": "४", "content_sanskrit": "इल्वलो नाम दैत्यो य आसीत् कौरवनन्दन ।\nमणिमत्यां पुरि पुरा वातापिस्तस्य चानुजः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2128264, "chapter_id": 3749, "verse_number": "५", "content_sanskrit": "स ब्राह्मणं तपोयुक्तमुवाच दितिनन्दनः ।\nपुत्रं मे भगवानेकमिन्द्रतुल्यं प्रयच्छतु\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2128265, "chapter_id": 3749, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2128266, "chapter_id": 3749, "verse_number": "६", "content_sanskrit": "तस्मै स ब्राह्मणो नादात् पुत्रं वासवसम्मितम् ।\nचुक्रोध सोऽसुरस्तस्य ब्राह्मणस्य ततो भृशम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2128267, "chapter_id": 3749, "verse_number": "७", "content_sanskrit": "तदा प्रभृति राजेन्द्र ब्रह्महाऽसुरसत्तमः ।\nमन्युमान् भ्रातरं छागं मायया प्रचकार ह\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2128268, "chapter_id": 3749, "verse_number": "८", "content_sanskrit": "समाह्वयति यं वाचा गतं वैवस्वतक्षयम् ।\nस पुनर्देहमास्थाय जीवन् स्म प्रतिदृश्यते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2128269, "chapter_id": 3749, "verse_number": "९", "content_sanskrit": "ततो वातापिमसुरं छागं कृत्वा सुसंस्कृतम् ।\nब्राह्मणान् भोजयित्वाऽसौ पुनरेव समाह्वयत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2128270, "chapter_id": 3749, "verse_number": "१०", "content_sanskrit": "तस्य स्वनेन महता स्वरेण गिरमीरिताम् ।\nश्रुत्वाऽतिमायो बलवान् क्षिप्रं ब्राह्मणकण्टकः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2128271, "chapter_id": 3749, "verse_number": "११", "content_sanskrit": "तस्य पार्श्वं विनिर्भिद्य ब्राह्मणस्य महासुरः ।\nवातापिः प्रहसन् राजन् निश्चक्राम विशाम्पते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2128272, "chapter_id": 3749, "verse_number": "१२", "content_sanskrit": "एवं स ब्राह्मणान् राजन् भोजयित्वा पुनः पुनः ।\nहिंसयामास दैतेय इल्वलो दुष्टचेतनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2128273, "chapter_id": 3749, "verse_number": "१३", "content_sanskrit": "अगस्त्यश्चापि भगवान् एतस्मिन्नन्तरेव तु ।\nपितॄन् ददर्श गर्ते तु लम्बमानानवाङ्मुखान् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2128274, "chapter_id": 3749, "verse_number": "१४", "content_sanskrit": "सोऽपृच्छल्लम्बमानान् तान् भगवन्तश्च किङ्कराः ।\nकिमर्थं वेह लम्बध्वं गर्ते यूयमधोमुखाः ।\nसन्तानहेतोरिति ते तमूचुर्ब्रह्मवादिनः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2128275, "chapter_id": 3749, "verse_number": "१५", "content_sanskrit": "ते तस्मै कथयामासुर्वयं ते पितरः स्वकाः ।\nगर्तमेतमनुप्राप्ता लम्बामः प्रसवार्थिनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2128276, "chapter_id": 3749, "verse_number": "१६", "content_sanskrit": "यदि नो जनयेथास्त्वमगस्त्यापत्यमुत्तमम् ।\nस्यान्नोऽस्मान्निरयान्मोक्षस्त्वं चापि भज नो गतिम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2128277, "chapter_id": 3749, "verse_number": "१७", "content_sanskrit": "स तानुवाच तेजस्वी सत्यधर्मपरायणः ।\nकरिष्ये पितरः कामं व्येतु वो मानसो ज्वरः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2128278, "chapter_id": 3749, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2128279, "chapter_id": 3749, "verse_number": "१८", "content_sanskrit": "ततः प्रसवसन्तानं चिन्तयन् भगवानृषिः ।\nआत्मनः प्रसवस्यार्थे नाविन्दत् सदृशीं स्त्रियम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2128280, "chapter_id": 3749, "verse_number": "१९", "content_sanskrit": "स तस्य तस्य सत्त्वस्य तत्तदङ्गमनुत्तमम् ।\nसङ्गृह्य तन्मयैरंशैर्निर्ममे स्त्रियमुत्तमाम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2128281, "chapter_id": 3749, "verse_number": "२०", "content_sanskrit": "स तां विदर्भराजाय पुत्रकामाय श्राम्यते ।\nनिर्मितामात्मनोऽर्थाय मुनिः प्रादान्महातपाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2128282, "chapter_id": 3749, "verse_number": "२१", "content_sanskrit": "सा तत्र जज्ञे सुभगा विद्युत्सौदामिनी यथा ।\nविभ्राजमाना वपुषा व्यवर्धत शुभानना\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2128283, "chapter_id": 3749, "verse_number": "२२", "content_sanskrit": "जातमात्रं च तां दृष्ट्वा वैदर्भः पृथिवीपतिः ।\nप्रहर्षेण द्विजातिभ्यो न्यवेदयत भारत\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2128284, "chapter_id": 3749, "verse_number": "२३", "content_sanskrit": "अभ्यनन्दत तां सर्वे ब्राह्मणा वसुधाधिप ।\nलोपामुद्रेति तस्याश्च चक्रिरे नाम ते द्विजाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2128285, "chapter_id": 3749, "verse_number": "२४", "content_sanskrit": "ववृधे सा महाराज बिभ्रती रूपमुत्तमम् ।\nअप्स्विवोत्पलिनी शीघ्रमग्नेरिव शिखा शुभा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2128286, "chapter_id": 3749, "verse_number": "२५", "content_sanskrit": "तां यौवनगतां राजन् शतं कन्याः स्वलङ्कृताः ।\nदासीशतं च कल्याणीमुपतस्थुर्वशानुगाः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2128287, "chapter_id": 3749, "verse_number": "२६", "content_sanskrit": "सा स्म दासीशतवृता मध्ये कन्याशतस्य च ।\nआस्ते तेजस्विनी कन्या रोहिणीव दिवि प्रभो\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2128288, "chapter_id": 3749, "verse_number": "२७", "content_sanskrit": "यौवनस्थामपि च तां शीलाचारसमन्विताम् ।\nन वव्रे पुरुषः कश्चिद् भयात् तस्य महात्मनः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2128289, "chapter_id": 3749, "verse_number": "२८", "content_sanskrit": "सा तु सत्यवती कन्या रूपेणाप्सरसोऽप्यति ।\nतोषयामास पितरं शीलेन स्वजनं तथा\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2128290, "chapter_id": 3749, "verse_number": "२९", "content_sanskrit": "वैदर्भीं तु तथायुक्तां युवतीं प्रेक्ष्य वै पिता ।\nमनसा चिन्तयामास कस्मै दद्यामिमां सुताम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2128291, "chapter_id": 3749, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि एकनवतितमोऽध्यायः ॥९१॥\n॥ तीर्थयात्रापर्वणि सप्तचत्वारिंशोऽध्यायः ॥४७॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]