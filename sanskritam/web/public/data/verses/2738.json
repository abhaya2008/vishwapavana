[{"id": 2082015, "chapter_id": 2738, "verse_number": "१२-२४३-०x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082016, "chapter_id": 2738, "verse_number": "१२-२४३-१", "content_sanskrit": "अथ ज्ञानप्लवं धीरो गृहीत्वा शान्तिमात्मनः।\nउन्मज्जंश्च निमज्जंश्च विद्यामेवाभिसंश्रयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082017, "chapter_id": 2738, "verse_number": "१२-२४३-२x", "content_sanskrit": "शुक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082018, "chapter_id": 2738, "verse_number": "१२-२४३-२", "content_sanskrit": "किं तज्ज्ञानमथो विद्या यथा निस्तरते द्वयम्।\nप्रवृत्तिलक्षणो धर्मो निवृत्तिरिति चैव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082019, "chapter_id": 2738, "verse_number": "१२-२४३-३x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082020, "chapter_id": 2738, "verse_number": "१२-२४३-३", "content_sanskrit": "यस्तु पश्यन्स्वभावेन विनाभावमचेतनः।\nपुष्णाति स पुनः सर्वान्प्रज्ञया मुक्तहेतुकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082021, "chapter_id": 2738, "verse_number": "१२-२४३-४", "content_sanskrit": "येषां चैकान्तभावेन स्वभावः कारणं मतम्।\nदूर्वातृणवृसीका ये ते लभन्ते न किंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082022, "chapter_id": 2738, "verse_number": "१२-२४३-५", "content_sanskrit": "येचैनं पक्षमाश्रित्य निवर्तन्त्यल्पमेधसः।\nस्वभावं कारणं ज्ञात्वा न श्रेयः प्राप्नुवन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082023, "chapter_id": 2738, "verse_number": "१२-२४३-६", "content_sanskrit": "स्वभावो हि विनाशाय मोहकर्ममनोभवः।\nनिरुक्तमेतयोरेतत्स्वभावपरिभावयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082024, "chapter_id": 2738, "verse_number": "१२-२४३-७", "content_sanskrit": "कृष्यादीनीह कर्माणि सस्यसंहरणानि च।\nप्रज्ञावद्भिः प्रक्लृप्तानि यानासनगृहाणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082025, "chapter_id": 2738, "verse_number": "१२-२४३-८", "content_sanskrit": "आक्रीडानां गृहाणां च गदानामगदस्य च।\nप्रज्ञावन्तः प्रवक्तारो ज्ञानवद्भिरनुष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082026, "chapter_id": 2738, "verse_number": "१२-२४३-९", "content_sanskrit": "प्रज्ञा संयोजयत्यर्थैः प्रज्ञा श्रेयोऽधिगच्छति।\nराजानो भुञ्जते राज्यं प्रज्ञया तुल्यलक्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082027, "chapter_id": 2738, "verse_number": "१२-२४३-१०", "content_sanskrit": "परावरं तु भूतानां ज्ञानेनैवोपलभ्यते।\nविद्यया तात सृष्टानां विद्यैवेह परा गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082028, "chapter_id": 2738, "verse_number": "१२-२४३-११", "content_sanskrit": "भूतानां जन्म सर्वेषां विविधानां चतुर्विधम्।\nजरायुजाण्डजोद्भिज्जस्वेदजं चोपलक्षयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082029, "chapter_id": 2738, "verse_number": "१२-२४३-१२", "content_sanskrit": "स्थावरेभ्यो विशिष्टानि जङ्गमान्युपधारयेत्।\nउपपन्नं हि यच्चेष्टा विशिष्येत विशेष्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082030, "chapter_id": 2738, "verse_number": "१२-२४३-१३", "content_sanskrit": "आहुर्द्विबहुपादानि जङ्गमानि द्वयानि तु।\nबहुषाद्भ्यो विशिष्टानि द्विपादानि बहून्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082031, "chapter_id": 2738, "verse_number": "१२-२४३-१४", "content_sanskrit": "द्विपदानि द्वयान्याहुः पार्थिवानीतराणि च।\nपार्थिवानि विशिष्टानि तानि ह्यन्नानि भुञ्जते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2082032, "chapter_id": 2738, "verse_number": "१२-२४३-१५", "content_sanskrit": "पार्थिवानि द्वयान्याहुर्मध्यमान्युत्तमानि तु।\nमध्यमानि विशिष्टानि जातिधर्मोपधारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2082033, "chapter_id": 2738, "verse_number": "१२-२४३-१६", "content_sanskrit": "मध्यमानि द्वयान्याहुर्धर्मज्ञानीतराणि च।\nधर्मज्ञानि विशिष्टानि कार्याकार्योपधारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2082034, "chapter_id": 2738, "verse_number": "१२-२४३-१७", "content_sanskrit": "धर्मज्ञानि द्वयान्याहुर्वेदज्ञानीतराणि च।\nवेदज्ञानि विशिष्टानि वेदो ह्येषु प्रतिष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2082035, "chapter_id": 2738, "verse_number": "१२-२४३-१८", "content_sanskrit": "वेदज्ञानि द्वयान्याहुः प्रवक्तृणीतराणि च।\nप्रवक्तॄणि विशिष्टानि सर्वधर्मोपधारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2082036, "chapter_id": 2738, "verse_number": "१२-२४३-१९", "content_sanskrit": "विज्ञायन्ते हि यैर्वेदाः सधर्माः सक्रियाफलाः।\nसधर्मा निखिला वेदाः प्रवक्तृभ्यो विनिःसृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2082037, "chapter_id": 2738, "verse_number": "१२-२४३-२०", "content_sanskrit": "प्रवक्तॄणि द्वयान्याहुरात्मज्ञानीतराणि च।\nआत्मज्ञानि विशिष्टानि जन्माजन्मोपधारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2082038, "chapter_id": 2738, "verse_number": "१२-२४३-२१", "content_sanskrit": "धर्मद्वयं हि यो वेद स सर्वज्ञः स सर्ववित्।\nसत्याशीः सत्यसंकल्पः सत्यः शुचिरथेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2082039, "chapter_id": 2738, "verse_number": "१२-२४३-२२", "content_sanskrit": "धर्मज्ञानप्रतिष्ठं हि तं देवा ब्राह्मणं विदुः।\nशब्दब्रह्मणि निष्णातं परे च कृतनिश्चयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2082040, "chapter_id": 2738, "verse_number": "१२-२४३-२३", "content_sanskrit": "अन्तस्थं च बहिष्ठं च येऽधियज्ञाधिदैवतम्।\nजानन्ति तान्नमस्यामस्ते देवास्तात ते द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2082041, "chapter_id": 2738, "verse_number": "१२-२४३-२४", "content_sanskrit": "तेषु विश्वमिदं भूतं साग्रं च जगदाहितम्।\nतेषां माहात्म्यभावस्य सदृशं नास्ति किंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2082042, "chapter_id": 2738, "verse_number": "१२-२४३-२५", "content_sanskrit": "आद्यन्तनिधनं चैव कर्म चातीत्य सर्वशः।\nचतुर्विधस्य भूतस्य सर्वस्येशाः स्वयंभुवः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2082043, "chapter_id": 2738, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि त्रिचत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]