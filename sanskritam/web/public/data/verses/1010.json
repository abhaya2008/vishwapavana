[{"id": 2001104, "chapter_id": 1010, "verse_number": "१-११-०x", "content_sanskrit": "डुण्डुभ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001105, "chapter_id": 1010, "verse_number": "१-११-१", "content_sanskrit": "सखा बभूव मे पूर्वं खगमो नाम वै द्विजः।\nभृशं संशितवाक्तात तपोबलसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001106, "chapter_id": 1010, "verse_number": "१-११-२", "content_sanskrit": "स मया क्रीडता बाल्ये कृत्वा तार्णं भुजंगमम्।\nअग्निहोत्रे प्रसक्तस्तु भीषितः प्रमुमोह वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001107, "chapter_id": 1010, "verse_number": "१-११-३", "content_sanskrit": "लब्ध्वा स च पुनः संज्ञां मामुवाच तपोधनः।\nनर्दहन्निव कोपेन सत्यवाक्संशितव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001108, "chapter_id": 1010, "verse_number": "१-११-४", "content_sanskrit": "यथावीर्यस्त्वया सर्पः कृतोऽयं मद्बिभीषया।\nतथावीर्यो भुजंगस्त्वं मम शापाद्भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001109, "chapter_id": 1010, "verse_number": "१-११-५", "content_sanskrit": "तस्याहं तपसो वीर्यं जानन्नासं तपोधन।\nभृशमुद्विग्नहृदयस्तमवोचमहं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001110, "chapter_id": 1010, "verse_number": "१-११-६", "content_sanskrit": "प्रणतः संभ्रमाच्चैव प्राञ्जलिः पुरतः स्थितः।\nसखेति हसतेदं ते नर्मार्थं वै कृतं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001111, "chapter_id": 1010, "verse_number": "१-११-७", "content_sanskrit": "क्षन्तुमर्हसि मे ब्रह्मञ्शापोऽयं विनिवर्त्यताम्।\nसोऽथ मामब्रवीद्दृष्ट्वा भृशमुद्विग्नचेतसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001112, "chapter_id": 1010, "verse_number": "१-११-८", "content_sanskrit": "मुहुरुष्णं विनिःश्वस्य सुसंभ्रान्तस्तपोधनः।\nनानृतं वै मया प्रोक्तं भवितेदं कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001113, "chapter_id": 1010, "verse_number": "१-११-९", "content_sanskrit": "यत्तु वक्ष्यामि ते वाक्यं शृणु तन्मे तपोधन।\nश्रुत्वा च हृदि ते वाक्यमिदमस्तु सदाऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001114, "chapter_id": 1010, "verse_number": "१-११-१०", "content_sanskrit": "उत्पत्स्यति रुरुर्नाम प्रमतेरात्मजः शुचिः।\nतं दृष्ट्वा शापमोक्षस्ते भविता नचिरादिव।\nएवमुक्तस्तु तेनाहमुरगत्वमवाप्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001115, "chapter_id": 1010, "verse_number": "१-११-११", "content_sanskrit": "स त्वं रुरुरिति ख्यातः प्रमतेरात्मजोऽपि च।\nस्वरूपं प्रतिपद्याहमद्य वक्ष्यामि ते हितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001116, "chapter_id": 1010, "verse_number": "१-११-१२x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001117, "chapter_id": 1010, "verse_number": "१-११-१२", "content_sanskrit": "स डौण्डुभं परित्यज्य रूपं विप्रर्षभस्तदा।\nस्वरूपं भास्वरं भूयः प्रतिपेदे महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001118, "chapter_id": 1010, "verse_number": "१-११-१३", "content_sanskrit": "इदं चोवाच वचनं रुरुमप्रतिमौजसम्।\nअहिंसा परमो धर्मः सर्वप्राणभृतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001119, "chapter_id": 1010, "verse_number": "१-११-१४", "content_sanskrit": "तस्मात्प्राणभृतः सर्वान्न हिंस्याद्ब्राह्मणः क्वचित्।\nब्राह्मणः सौम्य एवेह भवतीति परा श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001120, "chapter_id": 1010, "verse_number": "१-११-१५", "content_sanskrit": "वेदवेदाङ्गविन्नाम सर्वभूताभयप्रदः।\nअहिंसा सत्यवचनं क्षमा चेति विनिश्चितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001121, "chapter_id": 1010, "verse_number": "१-११-१६", "content_sanskrit": "ब्राह्मणस्य परो धर्मो वेदानां धारणापि च।\nक्षत्रियस्य हि यो धर्मः स नेहेष्येत वै तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001122, "chapter_id": 1010, "verse_number": "१-११-१७", "content_sanskrit": "दण्डधारणमुग्रत्वं प्रजानां परिपालनम्।\nतदिदं क्षत्रियस्यासीत्कर्म वै शृणु मे रुरो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001123, "chapter_id": 1010, "verse_number": "१-११-१८", "content_sanskrit": "जनमेजयस्य यज्ञेऽस्मिन्सर्पाणां हिंसनं पुरा।\nपरित्राणं च भीतानां सर्पाणां ब्राह्मणादपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2001124, "chapter_id": 1010, "verse_number": "१-११-१९", "content_sanskrit": "तपोवीर्यबलोपेताद्वेदवेदाङ्गपारगात्।\nआस्तीकाद्द्विजमुख्याद्वै सर्पसत्रे द्विजोत्तम॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2001125, "chapter_id": 1010, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि पौलोमपर्वणि एकादशोऽध्यायः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]