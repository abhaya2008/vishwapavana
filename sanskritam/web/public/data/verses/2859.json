[{"id": 2087660, "chapter_id": 2859, "verse_number": "१२-३६४-०x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2087661, "chapter_id": 2859, "verse_number": "१२-३६४-१", "content_sanskrit": "समुत्पन्ने विधानेऽस्मिन्वाङ्भाधुर्येण तेऽनघ।\nमित्रत्वमभिसंपन्नः किंचिद्वक्ष्यामि तच्छृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2087662, "chapter_id": 2859, "verse_number": "१२-३६४-२", "content_sanskrit": "गृहस्थधर्मं विप्रेन्द्र श्रुत्वा धर्मगतं त्वहम्।\nधर्मं परमकं कुर्यां को हि मार्गो भवेद्द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2087663, "chapter_id": 2859, "verse_number": "१२-३६४-३", "content_sanskrit": "अहमात्मानमास्थाय एक एवात्मनि स्थितम्।\nद्रष्टुमिच्छन्न पश्यामि बद्धः साधारणैर्गुणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2087664, "chapter_id": 2859, "verse_number": "१२-३६४-४", "content_sanskrit": "यावदेतदतीतं मे वयः पुत्रफलाश्रितम्।\nतावदिच्छामि पाथेयमादातुं पारलौकिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2087665, "chapter_id": 2859, "verse_number": "१२-३६४-५", "content_sanskrit": "अस्मिन्हि लोकसंभारे परं पारमभीप्सतः।\nउत्पन्ना मे मतिरियं कुतो धर्ममयः प्लवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2087666, "chapter_id": 2859, "verse_number": "१२-३६४-६", "content_sanskrit": "संयुज्यमानानि निशाम्य लोके\nनिर्यात्यमानानि च सात्विकानि।\nदृष्ट्वा तु धर्मध्वजकेतुमालां\nप्रकीर्यमाणामुपरि प्रजानाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2087667, "chapter_id": 2859, "verse_number": "१२-३६४-७", "content_sanskrit": "न मे मनो रज्यति भोगरागै\nर्दृष्ट्वा गतिं प्रार्थयतः परत्र।\nतेनातिथे बुद्धिबलाश्रयेण\nधर्मेण धर्मे विनियुङ्क्ष्व मां त्वम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2087668, "chapter_id": 2859, "verse_number": "१२-३६४-८", "content_sanskrit": "सोऽतिथिर्वचनं तस्य श्रुत्वा धर्माभिभाषिणः।\nप्रोवाच वचनं श्लक्षणं प्राज्ञो मधुरया गिरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2087669, "chapter_id": 2859, "verse_number": "१२-३६४-९", "content_sanskrit": "अहमप्यत्र मुह्यामि ममाप्येष मनोरथः।\nन च संनिश्चयं चामि बहुद्वारे त्रिविष्टये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2087670, "chapter_id": 2859, "verse_number": "१२-३६४-१०", "content_sanskrit": "केचिन्मोक्षं प्रशंसन्ति केचिद्यज्ञफलं द्विजाः।\nवानप्रस्थाश्रयाः केचिद्गार्हस्थ्यं केचिदाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2087671, "chapter_id": 2859, "verse_number": "१२-३६४-११", "content_sanskrit": "राजधर्माश्रयाः केचित्केचिदात्मफलाश्रयाः।\nगुरुधर्माश्रयाः केचित्केचिद्वाक्संयमाश्रयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2087672, "chapter_id": 2859, "verse_number": "१२-३६४-१२", "content_sanskrit": "मातरं पितरं केचिच्छुश्रूषन्तो दिवं गताः।\nअहिंसया परे स्वर्गं सत्येन च तथाऽपरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2087673, "chapter_id": 2859, "verse_number": "१२-३६४-१३", "content_sanskrit": "आहवेऽभिमुखः केचिन्निहतास्त्रिदिवं गताः।\nकेचिदुञ्छव्रतैः सिद्धाः स्वर्गमार्गं समाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2087674, "chapter_id": 2859, "verse_number": "१२-३६४-१४", "content_sanskrit": "केचिदध्ययने युक्ता वेदव्रतपराः शुभाः।\nबुद्धिमन्तो गताः स्वर्गं तुष्टात्मानो जितेन्द्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2087675, "chapter_id": 2859, "verse_number": "१२-३६४-१५", "content_sanskrit": "आर्जवेनापरे युक्ता निहतानार्जवैर्जनैः।\nऋजवो नाकपृष्ठे वै शुद्धात्मानः प्रतिष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2087676, "chapter_id": 2859, "verse_number": "१२-३६४-१६", "content_sanskrit": "एवं बहुविधैर्लोकैर्धर्मद्वारैरनावृतैः।\nममापि मतिराविद्धा मेघलेखेव वायुना॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2087677, "chapter_id": 2859, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि चतुःषष्ट्यधिकत्रिशततमोऽध्यायः॥ ३६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]