[{"id": 2020751, "chapter_id": 1435, "verse_number": "३-७३-०x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2020752, "chapter_id": 1435, "verse_number": "३-७३-१", "content_sanskrit": "केशिन्यास्तद्वचः श्रुत्वा दमयन्ती विशांपते।\nशङ्कमाना नलं तं वै केशिनीमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2020753, "chapter_id": 1435, "verse_number": "३-७३-२", "content_sanskrit": "गच्छ केशिनि भूयस्त्वं परीक्षां कुरु बाहुके।\nअब्रुवाणा समीपस्था चरितान्यस्य लक्षय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020754, "chapter_id": 1435, "verse_number": "३-७३-३", "content_sanskrit": "यदा च किंचित्कुर्यात्स कारणं तत्र भामिनि।\nतत्रसंचेष्टमानस्य संलक्षेथा विचेष्टितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020755, "chapter_id": 1435, "verse_number": "३-७३-४", "content_sanskrit": "न चास्य प्रतिबन्धेन देयोऽग्निरपि केशिनि।\nयाचते न जलं देयं सकृच्चात्वरमाणया।\nएतत्सर्वं समीक्ष्यत्वं चरितं मे निवेदय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2020756, "chapter_id": 1435, "verse_number": "३-७३-५", "content_sanskrit": "निमित्तं यत्त्वया दृष्टं बाहुके दैवमानुषम्।\nयच्चान्यदपि पश्येथास्तच्चाख्येयं त्वया मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2020757, "chapter_id": 1435, "verse_number": "३-७३-६", "content_sanskrit": "दमयन्त्यैवमुक्ता सा जगामाथ च केशिनी।\nनिशाम्याथ हयज्ञस्य लिङ्गानि पुनरागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2020758, "chapter_id": 1435, "verse_number": "३-७३-७", "content_sanskrit": "सा तत्सर्वं यथावृत्तं दमयन्त्यै न्यवेदयत्।\nनिमित्तं यत्तया दृष्टं बाहुके दिव्यमानुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2020759, "chapter_id": 1435, "verse_number": "३-७३-८x", "content_sanskrit": "केशिन्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2020760, "chapter_id": 1435, "verse_number": "३-७३-८", "content_sanskrit": "दृढं शुच्यपदानोसौ न मया मानुषः क्वचित्।\nदृष्टपूर्वः श्रुतो वाऽपि दमयन्ति तथाविधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2020761, "chapter_id": 1435, "verse_number": "३-७३-९", "content_sanskrit": "ह्रस्वमासाद्य तु द्वारं नासौ विनमते क्वचित्।\nतं तु दृष्ट्वा यथासङ्गमुत्सर्पति यथासुखम्।\nसंकटेऽप्यस्य सुमहद्विवरं जायतेऽधिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2020762, "chapter_id": 1435, "verse_number": "३-७३-१०", "content_sanskrit": "ऋतुपर्णस्य चार्थाय भोजनीयमनेकशः।\nऋतुपर्णस्य चार्थाय भोजनीयमनेकशः।\nप्रेषितं तत्रराज्ञा तु मांसं बहु च पाशवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2020763, "chapter_id": 1435, "verse_number": "३-७३-११", "content_sanskrit": "तस्य प्रक्षालनार्थाय कुम्भास्तत्रोपकल्पिताः।\nते तेनावेक्षिताः कुम्भाः पूर्णा एवाभवंस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2020764, "chapter_id": 1435, "verse_number": "३-७३-१२", "content_sanskrit": "ततः प्रक्षालनं कृत्वा समधिश्रित्य बाहुकः।\nतृणमुष्टिं समादाय सवितुस्तं समादधत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2020765, "chapter_id": 1435, "verse_number": "३-७३-१३", "content_sanskrit": "अथ प्रज्वलितस्तत्र सहसा हव्यवाहनः।\nतदद्भुततमं दृष्ट्वा विस्मिताऽमिहागता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2020766, "chapter_id": 1435, "verse_number": "३-७३-१४", "content_sanskrit": "अन्यच्च तस्मिन्सुमहदाश्चर्यं लक्षितं मया।\nयदग्निमपि संस्पृश्य नैवासौ दह्यते शुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2020767, "chapter_id": 1435, "verse_number": "३-७३-१५", "content_sanskrit": "छन्देन चोदकं तस्य वहत्यावर्जितं द्रुतम्।\nअतीव चान्यत्सुमहदाश्चर्यं दृष्टवत्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2020768, "chapter_id": 1435, "verse_number": "३-७३-१६", "content_sanskrit": "यत्स पुष्पाण्युपादाय हस्ताभ्यां ममृदे शनैः।\nमृद्यमानानि पाणिभ्यां तेन पुष्पाणि नान्यथा।\nभूय एव सुगन्धीनि हृपितानि भवन्ति हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2020769, "chapter_id": 1435, "verse_number": "३-७३-१७", "content_sanskrit": "एतान्यद्भुतकल्पानि दृष्ट्वाऽहं भृशविस्मिता।\nचेष्टितानि विशालाक्षि बाहुकस्य समीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2020770, "chapter_id": 1435, "verse_number": "३-७३-१८x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2020771, "chapter_id": 1435, "verse_number": "३-७३-१८", "content_sanskrit": "दमयन्ती तु तच्छ्रुत्वा पुण्यश्लोकस्य चेष्टितम्।\nअमन्यत नलं प्राप्तं कर्मचेष्टाभिसूचितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2020772, "chapter_id": 1435, "verse_number": "३-७३-१९", "content_sanskrit": "सा शङ्कमाना भर्तारं नलं बाहुकरूपिणम्।\nकेशिनीं श्लक्ष्णया वाचा रुदन्ती पुनरब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2020773, "chapter_id": 1435, "verse_number": "३-७३-२०", "content_sanskrit": "पुनर्गच्छ प्रमत्तस्य बाहुकस्योपसंस्कृतम्।\nमहानसाच्छ्रितं मांसमानयस्वेह भामिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2020774, "chapter_id": 1435, "verse_number": "३-७३-२१", "content_sanskrit": "सा दृष्ट्वाबाहुके व्यग्रे तन्मांसमपकृष्य च।\nअत्युष्णमेव त्वरिता तत्क्षणात्प्रियकारिणी।\nदमयन्त्यै ततः प्रादात्केशिनी कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2020775, "chapter_id": 1435, "verse_number": "३-७३-२२", "content_sanskrit": "साऽशिता नलसिद्धस् मांसस्य बहुशः पुरा।\nप्राश्य मत्वा नलं सूतं प्राक्रोशद्भृशदुःखिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2020776, "chapter_id": 1435, "verse_number": "३-७३-२३", "content_sanskrit": "वैक्लव्यं परमं गत्वाप्रक्षाल्य च मुखं ततः।\nमिथुनं प्रेषयामास केशिन्या सह भारत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2020777, "chapter_id": 1435, "verse_number": "३-७३-२४", "content_sanskrit": "इन्द्रसेनां सह भ्रात्रा समभिज्ञाय बाहुकः।\nअभिद्रुत्य तदा राजा परिष्वज्याङ्कमानयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2020778, "chapter_id": 1435, "verse_number": "३-७३-२५", "content_sanskrit": "बाहुकस्तु समासाद्य सुतौ सुरसुतोपमौ।\nभृशं दुःखपरीतात्मा सुस्वरं प्ररुरोद ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2020779, "chapter_id": 1435, "verse_number": "३-७३-२६", "content_sanskrit": "नैषधो दर्शयित्वा तु विकारमसकृत्तदा।\nउत्सृज्य सहसा पुत्रौ केशिनीमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2020780, "chapter_id": 1435, "verse_number": "३-७३-२७", "content_sanskrit": "इदं च मदृशं भद्रे मिथुनं मम पुत्रयोः।\nअतो दृष्ट्वैव सहसा बाष्पमुत्सृष्टवानहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2020781, "chapter_id": 1435, "verse_number": "३-७३-२८", "content_sanskrit": "बहुशः संपतन्तीं त्वां जनः शङ्केत दोषतः।\nवयंच देशातिथयो गच्छ भद्रे यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2020782, "chapter_id": 1435, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि त्रिसप्ततितमोऽध्यायः ॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]