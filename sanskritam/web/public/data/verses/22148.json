[{"id": 7002148000, "chapter_id": 22148, "verse_number": "१९३-१", "content_sanskrit": "शिवरात्रिव्रतम् ।\nअग्निरुवाच ।\nशिवरात्रिव्रतं वक्ष्ये भुक्तिमुक्तिप्रदं शृणु ।\nमाघफाल्गुनयोर्मध्ये कृष्णा या तु चतुर्दशी ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002148001, "chapter_id": 22148, "verse_number": "१९३-२", "content_sanskrit": "कामयुक्ता तु सोपोष्या कुर्वन् जागरणं व्रती ।\nशिवरात्रिव्रतं कुर्वे चतुर्दश्यामभोजनं ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002148002, "chapter_id": 22148, "verse_number": "१९३-३", "content_sanskrit": "रात्रिजागरणेनैव पूजयामि शिवं व्रती ।\nआवाहयाम्यहं शम्भुं भुक्तिमुक्तिप्रदायकं ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002148003, "chapter_id": 22148, "verse_number": "१९३-४", "content_sanskrit": "नरकार्णवकोत्तारनावं शिव नमोऽस्तु ते ।\nनमः शिवाय शान्ताय प्रजाराज्यादिदायिने ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002148004, "chapter_id": 22148, "verse_number": "१९३-५", "content_sanskrit": "सौभाग्यारोग्यविद्यार्थस्वर्गमार्गप्रदायिने ।\nधर्मन्देहि धनन्देहि कामभोगादि देहि मे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002148005, "chapter_id": 22148, "verse_number": "१९३-६", "content_sanskrit": "गुणकीर्तिसुखं देहि स्वर्गं मोक्षं च देहि मे ।\nलुब्धकः प्राप्तवान् पुण्यं पापी सुन्दरसेनकः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]