[{"id": 2014499, "chapter_id": 1299, "verse_number": "२-४०-१", "content_sanskrit": "शिशुपाल उवाच।\nनायमर्हति वार्ष्णेयस्तिष्ठत्स्विह महात्मसु।\nमहीपतिषु कौरव्य राजवत्पार्थिवार्हणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2014500, "chapter_id": 1299, "verse_number": "२-४०-२", "content_sanskrit": "नायं युक्तः समाचारः पाण्डवेषु महात्मसु।\nयत्कामाद्देवकीपुत्रं पाण्डवार्चितवानसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2014501, "chapter_id": 1299, "verse_number": "२-४०-३", "content_sanskrit": "बाला यूयं न जानीध्वं धर्मः सूक्ष्मो हि पाण्डवाः।\nअयं तत्राभ्यतिक्रान्तो ह्यापगेयोऽल्पदर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2014502, "chapter_id": 1299, "verse_number": "२-४०-४", "content_sanskrit": "त्वादृशो धर्मयुक्तो हि कुर्वाणः प्रियकाम्यया।\nभवत्यभ्यधिकं भीष्मो लोकेष्ववमतः सताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2014503, "chapter_id": 1299, "verse_number": "२-४०-५", "content_sanskrit": "कथं ह्यराजा दाशार्हो मध्ये सर्वमहीक्षिताम्।\nअर्हणामर्हति तथा यथा युष्माभिरर्चितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2014504, "chapter_id": 1299, "verse_number": "२-४०-६", "content_sanskrit": "अथवा मन्यसे कृष्णं स्थविरं कुरुपुङ्गवः।\nवसुदेवे स्थिते वृद्धे कथमर्हति तत्सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2014505, "chapter_id": 1299, "verse_number": "२-४०-७", "content_sanskrit": "अथवा वासुदेवोऽपि प्रियकामोऽनुवृत्तवान्।\nद्रुपदे तिष्ठति कथं माधवोऽर्हति पूजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2014506, "chapter_id": 1299, "verse_number": "२-४०-८", "content_sanskrit": "आचार्यं मन्यसे कृष्णमथवा कुरुनन्दन।\nद्रोणे तिष्ठति वार्ष्णेयं कस्मादर्चितवानसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2014507, "chapter_id": 1299, "verse_number": "२-४०-९", "content_sanskrit": "ऋत्विजं मन्यसे कृष्णमथवा कुरुनन्दन।\nद्वौपायने स्थिते वृद्धे कथं कृष्णोऽर्चितस्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2014508, "chapter_id": 1299, "verse_number": "२-४०-१०", "content_sanskrit": "भीष्मे शान्तनवे राजन्स्थिते पुरुषसत्तमे।\nस्वच्छन्दमृत्युके राजन्कथं कृष्णोऽर्चितस्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2014509, "chapter_id": 1299, "verse_number": "२-४०-११", "content_sanskrit": "अश्वत्थाम्नि स्थिते वीरे सर्वशास्त्रविशारदे।\nकथं कृष्णस्त्वया राजन्नर्चितः कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2014510, "chapter_id": 1299, "verse_number": "२-४०-१२", "content_sanskrit": "दुर्योधने च राजेन्द्रे स्थिते पुरुषसत्तमे।\nकृपे च भारताचार्ये कथं कृष्णस्त्वयाऽर्चितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2014511, "chapter_id": 1299, "verse_number": "२-४०-१३", "content_sanskrit": "द्रुमं कम्पुरुषाचार्यमतिक्रम्य तथाऽर्चितः।\nभीष्मके चैव दुर्धर्षे पाण्डुवत्कृतलक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2014512, "chapter_id": 1299, "verse_number": "२-४०-१४", "content_sanskrit": "नृपे च रुक्मिणि श्रेष्ठे एकलव्ये तथैव च।\nशल्ये मद्राधिपे चैव कथं कृष्णस्त्वयार्चितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2014513, "chapter_id": 1299, "verse_number": "२-४०-१५", "content_sanskrit": "अयं च सर्वराज्ञां वै बलश्लाघी महाबलः।\nजामदग्न्यस्य दयितः शिष्यो विप्रस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2014514, "chapter_id": 1299, "verse_number": "२-४०-१६", "content_sanskrit": "येनात्मबलमाश्रित्य राजानो युधि निर्जिताः।\nतं च कर्णमतिक्रम्य कथं कृष्णस्त्वयार्चितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2014515, "chapter_id": 1299, "verse_number": "२-४०-१७", "content_sanskrit": "नैवर्त्विङ्नैव चाचार्यो न राजा मधुसूदनः।\nअर्चितश्च कुरुश्रेष्ठ किमन्यत्प्रियकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2014516, "chapter_id": 1299, "verse_number": "२-४०-१८", "content_sanskrit": "अथवाऽभ्यर्चनीयोऽयं युष्माकं मधुसूदनः।\nकिं राजभिरिहानीतैरवमानाय भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2014517, "chapter_id": 1299, "verse_number": "२-४०-१९", "content_sanskrit": "वयं तु न भयादस्य कौन्तेयस्य महात्मनः।\nप्रयच्छामः करान्सर्वे न लोभान्न च सान्त्वनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2014518, "chapter_id": 1299, "verse_number": "२-४०-२०", "content_sanskrit": "अस्य धर्मप्रवृत्तस्य पार्थिवत्वं चिकीर्षतः।\nकरानस्मै प्रयच्छामः सोऽयमस्मान्न मन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2014519, "chapter_id": 1299, "verse_number": "२-४०-२१", "content_sanskrit": "किमन्यदवमनानाद्धे यदेनं राजसंसदि।\nअप्राप्तलक्षणं कृष्णमर्घ्येणार्चितवानसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2014520, "chapter_id": 1299, "verse_number": "२-४०-२२", "content_sanskrit": "अकस्माद्धर्मपुत्रस्य धर्मात्मेति यशो गतम्।\nको हि धर्मच्युते पूजामेवं युक्तां नियोजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2014521, "chapter_id": 1299, "verse_number": "२-४०-२३", "content_sanskrit": "योयं वृष्णिकुले जातो राजानं हतवान्पुरा।\nजरासन्धं महात्मानमन्यायेन दुरात्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2014522, "chapter_id": 1299, "verse_number": "२-४०-२४", "content_sanskrit": "अद्य धर्मात्मता चैव व्यपकृष्टा युधिष्ठिरात्।\nदर्शितं कृपणत्वं च कृष्णेऽर्घ्यस्य निवेदनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2014523, "chapter_id": 1299, "verse_number": "२-४०-२५", "content_sanskrit": "यदि भीताश्च कौन्तेयाः कृपणाश्च तपस्विनः।\nननु त्वयाऽपि बोद्धव्यं यां पूजां माधवार्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2014524, "chapter_id": 1299, "verse_number": "२-४०-२६", "content_sanskrit": "अथवा कृपणैरेतामुपनीतां जनार्दन।\nपूजामनर्हः कस्मात्त्वमभ्यनुज्ञातवानसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2014525, "chapter_id": 1299, "verse_number": "२-४०-२७", "content_sanskrit": "अयुक्तामात्मनः पूजां त्वं पुनर्बहुमन्यसे।\nहविषः प्राप्य निष्यन्दं प्राशिता श्वेव निर्जने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2014526, "chapter_id": 1299, "verse_number": "२-४०-२८", "content_sanskrit": "न त्वं पार्थिवेन्द्राणामपमानः प्रयुज्यते।\nत्वामेव कुरवो व्यक्तं प्रलम्भन्ते जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2014527, "chapter_id": 1299, "verse_number": "२-४०-२९", "content_sanskrit": "क्लीबे दारक्रिया यादृगन्धे वा रूपदर्शनम्।\nअराज्ञो राजवत्पूजा तथा ते मधुसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2014528, "chapter_id": 1299, "verse_number": "२-४०-३०", "content_sanskrit": "दृष्टो युधिष्ठिरो राजा दृष्टो भीष्मश्च यादृशः।\nवासुदेवोऽप्ययं दृष्टः सर्वमेतद्यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2014529, "chapter_id": 1299, "verse_number": "२-४०-३१", "content_sanskrit": "इत्युक्त्वा शिशुपालस्तानुत्थाय परमासनात्।\nनिर्ययौ सदसस्तस्मात्सहितो राजभिस्तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2014530, "chapter_id": 1299, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि दिग्विजयपर्वणि चत्वारिंशोऽध्यायः॥ ४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]