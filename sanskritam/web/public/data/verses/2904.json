[{"id": 2088990, "chapter_id": 2904, "verse_number": "१३-३४-१", "content_sanskrit": "युधिष्ठिर उवाच।\nस्त्रीपुंसयोः सम्प्रयोगे स्पर्शः कस्याधिको भवेत्।\nएतस्मिन्संशये राजन्यथावद्वक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088991, "chapter_id": 2904, "verse_number": "१३-३४-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088992, "chapter_id": 2904, "verse_number": "१३-३४-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nभङ्गास्वनेन शक्रस्य यथा वैरमभूत्पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088993, "chapter_id": 2904, "verse_number": "१३-३४-३", "content_sanskrit": "पुरा भङ्गास्वनो नाम राजर्षिरतिधार्मिकः।\nअपुत्रः पुरुषव्याघ्र पुत्रार्थं यज्ञमाहरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088994, "chapter_id": 2904, "verse_number": "१३-३४-४", "content_sanskrit": "अग्निष्टुतं स राजर्षिरिन्द्रद्विष्टं महाबलः।\nप्रायश्चित्तेषु मर्त्यानां पुत्रकामेषु चेष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088995, "chapter_id": 2904, "verse_number": "१३-३४-५", "content_sanskrit": "इन्द्रो ज्ञात्वा तु तं यज्ञं महाभागः सुरेश्वरः।\nअन्तरं तस्य राजर्षेरन्विच्छन्नियतात्मनः।\nन चैवास्यान्तरं राजन्स ददर्श महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088996, "chapter_id": 2904, "verse_number": "१३-३४-६", "content_sanskrit": "कस्य चित्त्वथ कालस्य मृगयां गतवान्नृपः।\nइदमन्तरमित्येव शक्रो नृपममोहयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088997, "chapter_id": 2904, "verse_number": "१३-३४-७", "content_sanskrit": "एकाश्वेन च राजर्षिर्भ्रान्त इन्द्रेण मोहितः।\nन दिशोऽविन्दत नृपः क्षुत्पिपासार्दितस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088998, "chapter_id": 2904, "verse_number": "१३-३४-८", "content_sanskrit": "इतश्चेतश्च धावन्वै श्रमतृष्णार्दितो नृप।\nसरोऽपश्यत्सुरुचिरं पूर्णं परमवारिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088999, "chapter_id": 2904, "verse_number": "१३-३४-९", "content_sanskrit": "सोऽवगाह्य सरस्तात पाययामास वाजिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2089000, "chapter_id": 2904, "verse_number": "१३-३४-१०", "content_sanskrit": "अथ पीतोदकं सोऽश्वं वृक्षे बद्ध्वा नृपोत्तमः।\nअवगाह्य ततः स्नातस्तत्र स्त्रीत्वमवाप्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2089001, "chapter_id": 2904, "verse_number": "१३-३४-११", "content_sanskrit": "आत्मानं स्त्रीकृतं दृष्ट्वा व्रीडितो नृपसत्तमः।\nचिन्तानुगतसर्वात्मा व्याकुलेन्द्रियचेतनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2089002, "chapter_id": 2904, "verse_number": "१३-३४-१२", "content_sanskrit": "आरोहिष्ये कथं त्वश्वं कथं यास्यामि वै पुरम्।\nइष्टेनाग्निष्टुता चापि पुत्राणां शतमौरसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2089003, "chapter_id": 2904, "verse_number": "१३-३४-१३", "content_sanskrit": "जातं महाबलानां मे तान्प्रवक्ष्यामि किन्नवहम्।\nदारेषु चात्मकीयेषु पौरजानपदेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2089004, "chapter_id": 2904, "verse_number": "१३-३४-१४", "content_sanskrit": "मृदुत्वं च तनुत्वं च पराधीनत्वमेव च।\n`हासभावादि लावण्यं स्त्रीगुणाद्वा कुतूहलम्।\nस्त्रीगुणा ऋषिभिः प्रोक्ता धर्मतत्त्वार्थदर्शिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2089005, "chapter_id": 2904, "verse_number": "१३-३४-१५", "content_sanskrit": "व्यायामः कर्कशत्वं च वीर्यं च पुरुषे गुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2089006, "chapter_id": 2904, "verse_number": "१३-३४-१६", "content_sanskrit": "पौरुषं विप्रनष्टं स्त्रीत्वं केनापि मेऽभवत्।\nस्त्रीभावात्पुनरश्वं तं कथमारोढुमुत्सहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2089007, "chapter_id": 2904, "verse_number": "१३-३४-१७", "content_sanskrit": "महता त्वथ खेदेन आरुह्याश्वं नराधिपः।\nपुनरायात्पुरं तात स्त्रीभूतो नृपसत्तमः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2089008, "chapter_id": 2904, "verse_number": "१३-३४-१८", "content_sanskrit": "पुत्रा दाराश्च भृत्याश्च पौरजानपदाश्च ते।\nकिन्न्विदं त्विति विज्ञाय विस्मयं परमं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2089009, "chapter_id": 2904, "verse_number": "१३-३४-१९", "content_sanskrit": "अथोवाच स राजर्षिः स्त्रीभूतो वदतांवरः।\nमृगयामस्मि निर्यातो बलैः परिवृतो दृढम्।\nउद्भान्तः प्राविशं घोरामटवीं दैवमोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2089010, "chapter_id": 2904, "verse_number": "१३-३४-२०", "content_sanskrit": "अटव्यां च सुघोंरायां तृष्णार्तो नष्टचेतनः।\nसरः सुरुचिरप्रख्यमपश्यं पक्षिभिर्वृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2089011, "chapter_id": 2904, "verse_number": "१३-३४-२१", "content_sanskrit": "तत्रावगाढः स्त्रीभूतो व्यक्तं दैवान्न संशयः।\n`अतृप्त एव पुत्राणां दाराणां च धनस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2089012, "chapter_id": 2904, "verse_number": "१३-३४-२२", "content_sanskrit": "नामगोत्राणि चाभाव्य दाराणां मन्त्रिणां तथा।\nआह पुत्रांस्ततः सोऽथ स्त्रीभूतः पार्तिवोत्तमः।\nसम्प्रीत्या भुज्यतांराज्यं वनं यास्यामि पुत्रकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2089013, "chapter_id": 2904, "verse_number": "१३-३४-२३", "content_sanskrit": "स पुत्राणां शतं राजा अभिषिच्य वनं गतः।\nगत्वा चैवाश्रमं सा तु तापसं प्रत्यपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2089014, "chapter_id": 2904, "verse_number": "१३-३४-२४", "content_sanskrit": "तापसेनास्य पुत्राणामाश्रमेष्वभवच्छतम्।\nअथ साऽऽदाय तान्सर्वान्पूर्वपुत्रानभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2089015, "chapter_id": 2904, "verse_number": "१३-३४-२५", "content_sanskrit": "पुरुषत्वे सुता यूयं स्त्रीत्वे चेमे शतं सुताः।\nएकत्र भुज्यतां राज्यं भ्रातृभावेन पुत्रकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2089016, "chapter_id": 2904, "verse_number": "१३-३४-२६", "content_sanskrit": "सहिता भ्रातरस्तेऽथ राज्यं बुभुजिरे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2089017, "chapter_id": 2904, "verse_number": "१३-३४-२७", "content_sanskrit": "तान्दृष्ट्वा भातृभावेन भुञ्जानान्राज्यमुत्तमम्।\nचिन्तयामास देवेन्द्रो मन्युनाऽथ परिप्लुतः।\nउपकारोऽस्य राजर्षेः कृतो नापकृतं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2089018, "chapter_id": 2904, "verse_number": "१३-३४-२८", "content_sanskrit": "ततो ब्राह्मणरुपेण देवराजः शतक्रतुः।\nभेदयामास तान्गत्वा नगरं वै नृपात्मजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2089019, "chapter_id": 2904, "verse_number": "१३-३४-२९", "content_sanskrit": "भ्रातृणां नास्ति सौभ्रात्रं येऽप्येकस्य पितः सुताः।\nकश्यपस्य सुराश्चैव असुराश्व सुतास्तथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2089020, "chapter_id": 2904, "verse_number": "१३-३४-३०", "content_sanskrit": "राज्यहेतोर्विवदिताः कश्यपस्य सुरासुराः॥\nयूयं भङ्गास्वनापत्यास्तापसस्येतरे सुताः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2089021, "chapter_id": 2904, "verse_number": "१३-३४-३१", "content_sanskrit": "युष्माकं भेदितास्ते तु युद्धेऽन्योन्यमपातयन्।\nतच्छ्रुत्वा तापसी चापि संतप्ता प्ररुरोद ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2089022, "chapter_id": 2904, "verse_number": "१३-३४-३२", "content_sanskrit": "ब्राह्मणच्छद्मनाऽभ्येत्य तामिन्द्रोऽथान्वपृच्छत।\nकेन दुःखेन संतप्ता रोदिषि त्वं वरानने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2089023, "chapter_id": 2904, "verse_number": "१३-३४-३३", "content_sanskrit": "ब्राह्म्णं तं ततो दृष्ट्वा सा स्त्री करणमब्रवीत्।\nपुत्राणां द्वे शते ब्रह्मन्कालेन विनिपातिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2089024, "chapter_id": 2904, "verse_number": "१३-३४-३४", "content_sanskrit": "अहं राजाऽभव विप्र तत्र पूर्वं शतं मम।\nसमुत्पन्नं सुरूपाणां पुत्राणां ब्राह्मणोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2089025, "chapter_id": 2904, "verse_number": "१३-३४-३५", "content_sanskrit": "कदाचिन्मृगयां यात उद्धान्तो गहने वने।\nअवगाढश्च सरसि स्त्रीभूतो ब्राह्मणोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2089026, "chapter_id": 2904, "verse_number": "१३-३४-३६", "content_sanskrit": "पुत्रान्राज्ये प्रतिष्ठाप्य वनमस्मि ततो गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2089027, "chapter_id": 2904, "verse_number": "१३-३४-३७", "content_sanskrit": "स्त्रियाश्च मे पुत्रशतं तापसेन महात्मना।\nआश्रमे जनितं ब्रह्मन्नीतं तन्नगरं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2089028, "chapter_id": 2904, "verse_number": "१३-३४-३८", "content_sanskrit": "तेषां च वैरमुत्पन्नं कालयोगेन वै द्विज।\nएतच्छोचाम्यहं ब्रह्मन्दैवेन समभिप्लुता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2089029, "chapter_id": 2904, "verse_number": "१३-३४-३९", "content_sanskrit": "इन्द्रस्तां दुःशितां दृष्ट्वा अब्रवीत्परुषं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2089030, "chapter_id": 2904, "verse_number": "१३-३४-४०", "content_sanskrit": "पुरा सुदुःसहं भद्रे मम दुःखं त्वया कृतम्।\nइन्द्रद्विष्टेन यजता मामनाहूय धिष्ठितम्।\nइन्द्रोऽहमस्मि दुर्बुद्धे वैरं ते पातितं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2089031, "chapter_id": 2904, "verse_number": "१३-३४-४१", "content_sanskrit": "इन्द्रं दृष्ट्वा तु राजर्षिः पादयोः शिरसा गतः।\nप्रसीद त्रिदशश्रेष्ठ पुत्रकामेन स क्रतुः।\nइष्टस्त्रिदशशार्दूल तत्र मे क्षन्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2089032, "chapter_id": 2904, "verse_number": "१३-३४-४२", "content_sanskrit": "प्रणिपातेन तस्येन्द्रः परितुष्टो वरं ददौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2089033, "chapter_id": 2904, "verse_number": "१३-३४-४३", "content_sanskrit": "पुत्रास्ते कतमे राजञ्जीवन्त्वेतत्प्रचक्ष्व मे।\nस्त्रीभूतस्य हि ये जाताः पुरुषस्याथ येऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2089034, "chapter_id": 2904, "verse_number": "१३-३४-४४", "content_sanskrit": "तापसी तु ततः शक्रमुवाच प्रयताञ्जलिः।\nस्त्रीभूतस्य हि ये पुत्रास्ते मे जीवन्तु वासव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2089035, "chapter_id": 2904, "verse_number": "१३-३४-४५", "content_sanskrit": "इन्द्रस्तु विस्मितो दृष्ट्वा स्त्रियं पप्रच्छ तां पुनः।\nपुरुषोत्पादिता ये ते कथं द्वेष्याः सुतास्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2089036, "chapter_id": 2904, "verse_number": "१३-३४-४६", "content_sanskrit": "स्त्रीभूतस्य हि ये जाताः स्नेहस्तेभ्योऽधिकः कथम्।\nकारणं श्रोतुमिच्छामि तन्मे वक्तुमिहार्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2089037, "chapter_id": 2904, "verse_number": "१३-३४-४७x", "content_sanskrit": "स्त्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2089038, "chapter_id": 2904, "verse_number": "१३-३४-४७", "content_sanskrit": "स्त्रियास्त्वभ्यधिकः स्नेहो न तता पुरुषस्य वै।\nतस्मात्ते शक्र जीवन्तु ये जाताः स्त्रीकृतस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2089039, "chapter_id": 2904, "verse_number": "१३-३४-४८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2089040, "chapter_id": 2904, "verse_number": "१३-३४-४८", "content_sanskrit": "एवमुक्तस्ततस्त्विन्द्रः प्रीतो वाक्यमुवाच ह।\nसर्व एवेह जीवन्तु पुत्रास्ते सत्यवादिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2089041, "chapter_id": 2904, "verse_number": "१३-३४-४९", "content_sanskrit": "वरं च वृणु राजेन्द्र यं त्वमिच्छसि सुव्रत।\nपुरुषत्वमथ स्त्रीत्वं मत्तो यदभिकाङ्क्षसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2089042, "chapter_id": 2904, "verse_number": "१३-३४-५०x", "content_sanskrit": "स्त्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2089043, "chapter_id": 2904, "verse_number": "१३-३४-५०", "content_sanskrit": "स्त्रीत्वमेव वृणे शक्र पुंस्त्वं नेच्छामि वासव।\nएवमुक्तस्तु देवेन्द्रस्तां स्त्रियं प्रत्युवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2089044, "chapter_id": 2904, "verse_number": "१३-३४-५१", "content_sanskrit": "पुरुषत्वं कथं त्यक्त्वा स्त्रीत्वं रोचयसे विभो।\nएवमुक्तः प्रत्युवाच स्त्रीभूतो राजसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2089045, "chapter_id": 2904, "verse_number": "१३-३४-५२", "content_sanskrit": "स्त्रियाः पुरुषसंयोगे प्रीतिरभ्यधिका सदा।\nएतस्मात्कारणाच्छक्र स्त्रीत्वमेव वृणोम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2089046, "chapter_id": 2904, "verse_number": "१३-३४-५३", "content_sanskrit": "रमाभि चाधिकं स्त्रीत्वे सत्यं वै देवसत्तम।\nस्त्रीभावेन हि तुष्यामि गम्यतां त्रिदशाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2089047, "chapter_id": 2904, "verse_number": "१३-३४-५४", "content_sanskrit": "एवमस्त्विति चोक्त्वा तामापृच्छ्य त्रिदिवं गतः।\nएवं स्त्रिया महाराज अधिका प्रीतिरुच्यते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2089048, "chapter_id": 2904, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चतुस्त्रिंशोऽध्यायः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]