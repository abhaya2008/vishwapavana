[{"id": 7002648000, "chapter_id": 22648, "verse_number": "६-२६-१", "content_sanskrit": "सूत उवाच ।\nराजासीद्धार्मिकः कश्चित्केदारमणिपूरके ।\nचन्द्रचूड इति ख्यातः प्रजापालनतत्परः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002648001, "chapter_id": 22648, "verse_number": "६-२६-२", "content_sanskrit": "शांतो मधुरवाग्धीरो नारायणपरायणः ।\nबभूवुः शत्रवस्तस्य म्लेच्छा विंध्यनिवासिनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002648002, "chapter_id": 22648, "verse_number": "६-२६-३", "content_sanskrit": "तस्य तैरवभवद्युद्धमतिप्रबलदारुणैः ।\nभुशुंडीयुद्धनिपुणैः क्षेपणैः परिघायुधैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002648003, "chapter_id": 22648, "verse_number": "६-२६-४", "content_sanskrit": "चन्द्रचूडस्य महती सेना यमपुरे गता ।\nशतं रथास्तथा नागासहस्रं तु हयास्तथा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002648004, "chapter_id": 22648, "verse_number": "६-२६-५", "content_sanskrit": "पत्तयः पंचसाहस्रा मृताः स्वर्गपुरं ययुः ।\nदस्यवः पंचसाहस्रा मृताः कैतवयोधिनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002648005, "chapter_id": 22648, "verse_number": "६-२६-६", "content_sanskrit": "आक्रांतः स महाभागस्तैर्म्लेच्छैर्दंभयोधिभिः ।\nत्यक्त्वा राष्ट्रं च नगरं सैकाकी वनमाययौ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002648006, "chapter_id": 22648, "verse_number": "६-२६-७", "content_sanskrit": "तीर्थव्याजेन स नृपः पुरीं काशीं समागतः ।\nतत्र नारायणं देवं वंद्यं सर्वगृहेगृहे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002648007, "chapter_id": 22648, "verse_number": "६-२६-८", "content_sanskrit": "ददर्श नगरीं चैव धनधान्यसमन्विताम् ।\nयथा द्वारावती ज्ञेया तथा सा च पुरी शुभा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002648008, "chapter_id": 22648, "verse_number": "६-२६-९", "content_sanskrit": "विस्मितश्चंद्रचूडश्च दृष्ट्वाश्चर्यमनुत्तमम् ।\nसत्येन रोधितां लक्ष्मीं शीलधर्मसमन्विताम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002648009, "chapter_id": 22648, "verse_number": "६-२६-१०", "content_sanskrit": "दृष्ट्वा श्रुत्वा सदानंदं सत्यदेवप्रपूजकम् ।\nपतित्वा तच्चरणयोः प्रणनाम मुदा युतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002648010, "chapter_id": 22648, "verse_number": "६-२६-११", "content_sanskrit": "द्विजराज नमस्तुभ्यं सदानंद महामते ।\nभ्रष्टराज्यं च मां ज्ञात्वा कृपया मां समुद्धर ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002648011, "chapter_id": 22648, "verse_number": "६-२६-१२", "content_sanskrit": "यथा प्रसन्नो भगवांल्लक्ष्मीकान्तो जनार्दनः ।\nतथा तद्वद यद्योग्यं व्रतं पापप्रणाशनम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002648012, "chapter_id": 22648, "verse_number": "६-२६-१३", "content_sanskrit": "सदानंद उवाच ।\nदुःखशोकादिशमनं धनधान्यप्रवर्धनम् ।\nसौभाग्यसंततिकरं सर्वत्र विजयप्रदम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002648013, "chapter_id": 22648, "verse_number": "६-२६-१४", "content_sanskrit": "सत्यनारायणव्रतं श्रीपतेस्तुष्टिकारकम् ।\nयस्मिन्कस्मिन्दिने भूप यजेच्चैव निशामुखे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002648014, "chapter_id": 22648, "verse_number": "६-२६-१५", "content_sanskrit": "तोरणादि प्रकर्तव्यं कदलीस्तंभमंडितम् ।\nपंचभिः कलशैर्युक्तं ध्वजपंचसमन्वितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002648015, "chapter_id": 22648, "verse_number": "६-२६-१६", "content_sanskrit": "तन्मध्ये वेदिकां रम्यां कारयेत्स व्रती द्विजैः ।\nतत्र स्थाप्य शिलारूपं कृष्णं स्वर्ण समन्वितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002648016, "chapter_id": 22648, "verse_number": "६-२६-१७", "content_sanskrit": "कुर्याद्गंधादिभिः पूजां प्रेमभक्तिसमन्वितः ।\nभूमिशायी हरिं ध्यायन्सप्तरात्रं व्यतीतयेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002648017, "chapter_id": 22648, "verse_number": "६-२६-१८", "content_sanskrit": "इति श्रुत्वा स नृपतिः काश्यां देवमपूजयत् ।\nरात्रौ प्रसन्नो भगवान्ददौ राज्ञेऽसिमुत्तमम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002648018, "chapter_id": 22648, "verse_number": "६-२६-१९", "content_sanskrit": "शत्रुपक्षक्षयकरं प्राप्य खङ्गं नृपोत्तमः ।\nप्रणम्य च सदानन्दं केदारमणिमा ययौ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002648019, "chapter_id": 22648, "verse_number": "६-२६-२०", "content_sanskrit": "हत्वा दस्यून्षष्टिशतांस्तेषां लब्ध्वा महद्धनम् ।\nहरिं प्रपूजयामास नर्मदायास्तटे शुभे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002648020, "chapter_id": 22648, "verse_number": "६-२६-२१", "content_sanskrit": "पौर्णमास्यां विधानेन मासिमासि नृपोत्तमः ।\nअपूजयत्सत्यदेवं प्रेमभक्तिसमन्वितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002648021, "chapter_id": 22648, "verse_number": "६-२६-२२", "content_sanskrit": "तद्व्रतस्य प्रभावेन लक्षग्रामाधिपोऽभवत् ।\nराज्यं कृत्वा स षष्ट्यब्दमन्ते विष्णुपुरं ययौ ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]