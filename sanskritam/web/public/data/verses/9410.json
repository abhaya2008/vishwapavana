[{"id": 40022814, "chapter_id": 9410, "verse_number": "1", "content_sanskrit": "एतदाख्याय काकुत्स्थो भ्रातृभ्याममितप्रभः । लक्ष्मणं पुनरेवाह धर्मयुक्तमिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40022815, "chapter_id": 9410, "verse_number": "2", "content_sanskrit": "वसिष्ठं वामदेवं च जाबालिमथ कश्यपम् । द्विजांश्च सर्वप्रवरानश्वमेधपुरस्कृतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40022816, "chapter_id": 9410, "verse_number": "3", "content_sanskrit": "एतान्सर्वान्समानीय मन्त्रयित्वा च लक्ष्मण । हयं लक्षणसम्पन्नं विमोक्ष्यामि समाधिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40022817, "chapter_id": 9410, "verse_number": "4", "content_sanskrit": "तद्वाक्यं राघवेणोक्तं श्रुत्वा त्वरितविक्रमः । द्विजान्सर्वान्समाहूय दर्शयामास राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40022818, "chapter_id": 9410, "verse_number": "5", "content_sanskrit": "ते दृष्ट्वा देवसङ्काशं कृतपादाभिवन्दनम् । राघवं सुदुराधर्षमाशीर्भिः समपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40022819, "chapter_id": 9410, "verse_number": "6", "content_sanskrit": "प्राञ्जलिः स तदा भूत्वा राघवो द्विजसत्तमान् । आचचक्षे ऽश्वमेधस्य ह्यभिप्रायं महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40022820, "chapter_id": 9410, "verse_number": "7", "content_sanskrit": "ते तु रामस्य तच्छ्रुत्वा नमस्कृत्वा वृषध्वजम् । अश्वमेधं द्विजाः सर्वे पूजयन्ति स्म सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40022821, "chapter_id": 9410, "verse_number": "8", "content_sanskrit": "स तेषां द्विजमुख्यानां वाक्यमद्भुतदर्शनम् । अश्वमेधाश्रितं श्रुत्वा भृशं प्रीतो ऽभवत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40022822, "chapter_id": 9410, "verse_number": "9", "content_sanskrit": "विज्ञाय कर्म तत्तेषां रामो लक्ष्मणमब्रवीत् । प्रेषयस्व द्रुतं दूतान् सुग्रीवाय महात्मने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40022823, "chapter_id": 9410, "verse_number": "10", "content_sanskrit": "यथा महद्भिर्हरिभिर्बहुभिश्च वनौकसाम् । सार्धमागच्छ भद्रं ते ह्यनुभोक्तुं महोत्सवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40022824, "chapter_id": 9410, "verse_number": "11", "content_sanskrit": "बिभीषणश्च रक्षोभिः कामगैर्बहुभिर्वृतः । अश्वमेधं महायज्ञमायात्वतुलविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40022825, "chapter_id": 9410, "verse_number": "12", "content_sanskrit": "राजानश्च महाभागा ये मे प्रियचिकीर्षवः । सानुगाः क्षिप्रमायान्तु यज्ञं द्रष्टुमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40022826, "chapter_id": 9410, "verse_number": "13", "content_sanskrit": "देशान्तरगता ये च द्विजा धर्मसमाहिताः । आमन्त्रयस्व तान्सर्वानश्वमेधाय लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40022827, "chapter_id": 9410, "verse_number": "14", "content_sanskrit": "ऋषयश्च महाबाहो आहूयन्तां तपोधनाः । देशान्तरगताः सर्वे सदाराश्च द्विजातयः । तथैव तालावचरास्तथैव नटनर्तकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40022828, "chapter_id": 9410, "verse_number": "15", "content_sanskrit": "यज्ञवाटश्च सुमहान्गोमत्या नैमिशे वने । आज्ञाप्यतां महाबाहो तद्धि पुण्यमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40022829, "chapter_id": 9410, "verse_number": "16", "content_sanskrit": "शान्तयश्च महाबाहो प्रवर्त्यन्तां समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40022830, "chapter_id": 9410, "verse_number": "17", "content_sanskrit": "शतशश्चापि धर्मज्ञाः क्रतुमुख्यमनुत्तमम् । अनुभूय महायज्ञं नैमिशे रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40022831, "chapter_id": 9410, "verse_number": "18", "content_sanskrit": "तुष्टः पुष्टश्च सर्वो ऽसौ मानितश्च यथाविधि । प्रीतिं यास्यति धर्मज्ञ शीघ्रमामन्त्र्यतां जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40022832, "chapter_id": 9410, "verse_number": "19", "content_sanskrit": "शतं वाहसहस्राणां तण्डुलानां वपुष्मताम् । अयुतं तिलमुद्गानां प्रयात्वग्रे महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40022833, "chapter_id": 9410, "verse_number": "20", "content_sanskrit": "चणकानां कुलित्थानां माषाणां लवणस्य च । अतो ऽनुरूपं स्नेहं च गन्धं सङ्क्षिप्तमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40022834, "chapter_id": 9410, "verse_number": "21", "content_sanskrit": "सुवर्णकोट्यो बहुला हिरण्यस्य शतोत्तराः । अग्रतो भरतः कृत्वा गच्छत्वग्रे समाधिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40022835, "chapter_id": 9410, "verse_number": "22", "content_sanskrit": "अन्तरा पण्यवीथ्यश्च सर्वे च नटनर्तकाः । सूदा नार्यश्च बहवो नित्यं यौवनशालिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40022836, "chapter_id": 9410, "verse_number": "23", "content_sanskrit": "भरतेन तु सार्धं ते यान्तु सैन्यानि चाग्रतः । नैगमा बलवृद्धाश्च द्विजाश्च सुसमाहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40022837, "chapter_id": 9410, "verse_number": "24", "content_sanskrit": "कर्मान्तिकान्वर्धकिनः कोशाध्यक्षांश्च नैगमान् । मम मातऽस्तथा सर्वाः कुमारान्तःपुराणि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40022838, "chapter_id": 9410, "verse_number": "25", "content_sanskrit": "काञ्चनीं मम पत्नीं च दीक्षायां ज्ञांश्च कर्मणि । अग्रतो भरतः कृत्वा गच्छत्वग्रे महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40022839, "chapter_id": 9410, "verse_number": "26", "content_sanskrit": "उपकार्या महार्हाश्च पार्थिवानां महौजसाम् । सानुगानां नरश्रेष्ठो व्यादिदेश महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]