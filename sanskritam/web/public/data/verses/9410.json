[{"id": 5000410000, "chapter_id": 9410, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे तृतीयः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000410001, "chapter_id": 9410, "verse_number": "६-३-१", "content_sanskrit": "सुग्रीवस्य वचः श्रुत्वा हेतुमत् परमार्थवत्।\nप्रतिजग्राह काकुत्स्थो हनूमन्तमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000410002, "chapter_id": 9410, "verse_number": "६-३-२", "content_sanskrit": "तपसा सेतुबन्धेन सागरोच्छोषणेन च।\nसर्वथापि समर्थोऽस्मि सागरस्यास्य लङ्घने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000410003, "chapter_id": 9410, "verse_number": "६-३-३", "content_sanskrit": "कति दुर्गाणि दुर्गाया लङ्कायास्तद् ब्रवीष्व मे।\nज्ञातुमिच्छामि तत् सर्वं दर्शनादिव वानर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000410004, "chapter_id": 9410, "verse_number": "६-३-४", "content_sanskrit": "बलस्य परिमाणं च द्वारदुर्गक्रियामपि।\nगुप्तिकर्म च लङ्काया रक्षसां सदनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000410005, "chapter_id": 9410, "verse_number": "६-३-५", "content_sanskrit": "यथासुखं यथावच्च लङ्कायामसि दृष्टवान्।\nसर्वमाचक्ष्व तत्त्वेन सर्वथा कुशलो ह्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000410006, "chapter_id": 9410, "verse_number": "६-३-६", "content_sanskrit": "श्रुत्वा रामस्य वचनं हनूमान् मारुतात्मजः।\nवाक्यं वाक्यविदां श्रेष्ठो रामं पुनरथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000410007, "chapter_id": 9410, "verse_number": "६-३-७", "content_sanskrit": "श्रूयतां सर्वमाख्यास्ये दुर्गकर्म विधानतः।\nगुप्ता पुरी यथा लङ्का रक्षिता च यथा बलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000410008, "chapter_id": 9410, "verse_number": "६-३-८", "content_sanskrit": "राक्षसाश्च यथा स्निग्धा रावणस्य च तेजसा।\nपरां समृद्धिं लङ्कायाः सागरस्य च भीमताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000410009, "chapter_id": 9410, "verse_number": "६-३-९", "content_sanskrit": "विभागं च बलौघस्य निर्देशं वाहनस्य च।\nएवमुक्त्वा कपिश्रेष्ठः कथयामास तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000410010, "chapter_id": 9410, "verse_number": "६-३-१०", "content_sanskrit": "हृष्टप्रमुदिता लङ्का मत्तद्विपसमाकुला।\nमहती रथसम्पूर्णा रक्षोगणनिषेविता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000410011, "chapter_id": 9410, "verse_number": "६-३-११", "content_sanskrit": "दृढबद्धकपाटानि महापरिघवन्ति च।\nचत्वारि विपुलान्यस्या द्वाराणि सुमहान्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000410012, "chapter_id": 9410, "verse_number": "६-३-१२", "content_sanskrit": "तत्रेषूपलयन्त्राणि बलवन्ति महान्ति च।\nआगतं प्रतिसैन्यं तैस्तत्र प्रतिनिवार्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000410013, "chapter_id": 9410, "verse_number": "६-३-१३", "content_sanskrit": "द्वारेषु संस्कृता भीमाः कालायसमयाः शिताः।\nशतशो रचिता वीरैः शतघ्न्यो रक्षसां गणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000410014, "chapter_id": 9410, "verse_number": "६-३-१४", "content_sanskrit": "सौवर्णस्तु महांस्तस्याः प्राकारो दुष्प्रधर्षणः।\nमणिविद्रुमवैदूर्यमुक्ताविरचितान्तरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000410015, "chapter_id": 9410, "verse_number": "६-३-१५", "content_sanskrit": "सर्वतश्च महाभीमाः शीततोया महाशुभाः।\nअगाधा ग्राहवत्यश्च परिखा मीनसेविताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000410016, "chapter_id": 9410, "verse_number": "६-३-१६", "content_sanskrit": "द्वारेषु तासां चत्वारः संक्रमाः परमायताः।\nयन्त्रैरुपेता बहुभिर्महद्भिर्गृहपङ्क्तिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000410017, "chapter_id": 9410, "verse_number": "६-३-१७", "content_sanskrit": "त्रायन्ते संक्रमास्तत्र परसैन्यागते सति।\nयन्त्रैस्तैरवकीर्यन्ते परिखासु समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000410018, "chapter_id": 9410, "verse_number": "६-३-१८", "content_sanskrit": "एकस्त्वकम्प्यो बलवान् संक्रमः सुमहादृढः।\nकाञ्चनैर्बहुभिः स्तम्भैर्वेदिकाभिश्च शोभितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000410019, "chapter_id": 9410, "verse_number": "६-३-१९", "content_sanskrit": "स्वयं प्रकृतिमापन्नो युयुत्सू राम रावणः।\nउत्थितश्चाप्रमत्तश्च बलानामनुदर्शने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000410020, "chapter_id": 9410, "verse_number": "६-३-२०", "content_sanskrit": "लङ्का पुनर्निरालम्बा देवदुर्गा भयावहा।\nनादेयं पार्वतं वान्यं कृत्रिमं च चतुर्विधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000410021, "chapter_id": 9410, "verse_number": "६-३-२१", "content_sanskrit": "स्थिता पारे समुद्रस्य दूरपारस्य राघव।\nनौपथश्चापि नास्त्यत्र निरुद्देशश्च सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000410022, "chapter_id": 9410, "verse_number": "६-३-२२", "content_sanskrit": "शैलाग्रे रचिता दुर्गा सा पूर्देवपुरोपमा।\nवाजिवारणसम्पूर्णा लङ्का परमदुर्जया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000410023, "chapter_id": 9410, "verse_number": "६-३-२३", "content_sanskrit": "परिखाश्च शतघ्न्यश्च यन्त्राणि विविधानि च।\nशोभयन्ति पुरीं लङ्कां रावणस्य दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000410024, "chapter_id": 9410, "verse_number": "६-३-२४", "content_sanskrit": "अयुतं रक्षसामत्र पूर्वद्वारं समाश्रितम्।\nशूलहस्ता दुराधर्षाः सर्वे खड्गाग्रयोधिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000410025, "chapter_id": 9410, "verse_number": "६-३-२५", "content_sanskrit": "नियुतं रक्षसामत्र दक्षिणद्वारमाश्रितम्।\nचतुरङ्गेण सैन्येन योधास्तत्राप्यनुत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000410026, "chapter_id": 9410, "verse_number": "६-३-२६", "content_sanskrit": "प्रयुतं रक्षसामत्र पश्चिमद्वारमाश्रितम्।\nचर्मखड्गधराः सर्वे तथा सर्वास्त्रकोविदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000410027, "chapter_id": 9410, "verse_number": "६-३-२७", "content_sanskrit": "न्यर्बुदं रक्षसामत्र उत्तरद्वारमाश्रितम्।\nरथिनश्चाश्ववाहाश्च कुलपुत्राः सुपूजिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000410028, "chapter_id": 9410, "verse_number": "६-३-२८", "content_sanskrit": "शतशोऽथ सहस्राणि मध्यमं स्कन्धमाश्रिताः।\nयातुधाना दुराधर्षाः साग्रकोटिश्च रक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000410029, "chapter_id": 9410, "verse_number": "६-३-२९", "content_sanskrit": "ते मया संक्रमा भग्नाः परिखाश्चावपूरिताः।\nदग्धा च नगरी लङ्का प्राकाराश्चावसादिताः।\nबलैकदेशः क्षपितो राक्षसानां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000410030, "chapter_id": 9410, "verse_number": "६-३-३०", "content_sanskrit": "येन केन तु मार्गेण तराम वरुणालयम्।\nहतेति नगरी लङ्का वानरैरुपधार्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000410031, "chapter_id": 9410, "verse_number": "६-३-३१", "content_sanskrit": "अङ्गदो द्विविदो मैन्दो जाम्बवान् पनसो नलः।\nनीलः सेनापतिश्चैव बलशेषेण किं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000410032, "chapter_id": 9410, "verse_number": "६-३-३२", "content_sanskrit": "प्लवमाना हि गत्वा त्वां रावणस्य महापुरीम्।\nसपर्वतवनां भित्त्वा सखातां च सतोरणाम्।\nसप्राकारां सभवनामानयिष्यन्ति राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000410033, "chapter_id": 9410, "verse_number": "६-३-३३", "content_sanskrit": "एवमाज्ञापय क्षिप्रं बलानां सर्वसंग्रहम्।\nमुहूर्तेन तु युक्तेन प्रस्थानमभिरोचय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000410034, "chapter_id": 9410, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे तृतीयः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]