[{"id": 7005551000, "chapter_id": 25551, "verse_number": "२४-१", "content_sanskrit": "बुधोत्पत्तिवर्णनम् ।\nसूत उवाच ।\nततः संवत्सरस्यान्ते द्वादशादित्यसन्निभः ।\nदिव्यपीताम्बरधरो दिव्याभरणभूषितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005551001, "chapter_id": 25551, "verse_number": "२४-२", "content_sanskrit": "तारोदराद्विनिष्क्रान्तः कुमारश्चन्द्रसन्निभः ।\nसर्वार्थशास्त्रविद् धीमान् हस्तिशास्त्रप्रवर्तकः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005551002, "chapter_id": 25551, "verse_number": "२४-३", "content_sanskrit": "नामयद्राजपुत्रीयं विश्रुतं गजवैद्यकम् ।\nराज्ञः सोमस्य पुत्रत्वाद्राजपुत्रो बुधः स्मृतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005551003, "chapter_id": 25551, "verse_number": "२४-४", "content_sanskrit": "जातमात्रः स तेजांसि सर्वाण्येवाजयद् बली ।\nब्रह्माद्यास्तत्र चाजग्मु र्देवा देवर्षिभिः सह ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005551004, "chapter_id": 25551, "verse_number": "२४-५", "content_sanskrit": "बृहस्पतिगृहे सर्वे जातकर्मोत्सवे तदा ।\nअपृच्छंस्ते सुरास्तारां केन जातः कुमारकः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005551005, "chapter_id": 25551, "verse_number": "२४-६", "content_sanskrit": "ततः सा लज्जिता तेषां न किञ्चिदवदत्तदा ।\nपुनः पुनस्तदा पृष्टा लज्जयन्ती वराङ्गना ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005551006, "chapter_id": 25551, "verse_number": "२४-७", "content_sanskrit": "सोमस्येति चिरादाह ततोऽगृह्णाद्विधुः सुतम् ।\nबुध इत्यकरोन्नाम्ना प्रादाद्राज्यञ्च भूतले ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005551007, "chapter_id": 25551, "verse_number": "२४-८", "content_sanskrit": "अभिषेकं ततः कृत्वा युवानमकरोद् विभुः ।\nग्रहसाम्यं प्रदायाथ ब्रह्मा ब्रह्मर्षि संयुतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005551008, "chapter_id": 25551, "verse_number": "२४-९", "content_sanskrit": "पश्यतां सर्वदेवानां तत्रैवान्तरधीयत ।\nइलोदरे च धर्मिष्ठं बुधः पुत्रमजीजनत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005551009, "chapter_id": 25551, "verse_number": "२४-१०", "content_sanskrit": "अश्वमेधशतं साग्रमकरोद्यः स्वतेजसा ।\nपुरूरवा इति ख्यातः सर्वलोकनमस्कृतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005551010, "chapter_id": 25551, "verse_number": "२४-११", "content_sanskrit": "हिमवच्छिखरे रम्ये समाराध्य जनार्दनम् ।\nलोकैश्वर्यमगाद्राजा सप्तद्वीप पतिस्तदा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005551011, "chapter_id": 25551, "verse_number": "२४-१२", "content_sanskrit": "केशिप्रभृतयो दैत्याः कोटिशो येन दारिताः ।\nउर्वशी यस्य पत्नीत्वमगमद्रूपमोहिता ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005551012, "chapter_id": 25551, "verse_number": "२४-१३", "content_sanskrit": "सप्तद्वीपा वसुमती सशैलवनकानना ।\nधर्मेण पालिता तेन सर्वलौक हितैषिणा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005551013, "chapter_id": 25551, "verse_number": "२४-१४", "content_sanskrit": "चामर ग्राहिणीकीर्तिः सदाचैवाङ्गवाहिका ।\nविष्णोः प्रसादाद्देवेन्द्रो ददावर्धासनन्तदा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005551014, "chapter_id": 25551, "verse_number": "२४-१५", "content_sanskrit": "धर्मार्थकामान्‌ धर्मेण सममेवाभ्यपालयत् ।\nधर्मार्थकामाः सन्द्रष्टुमाजग्मुः कौतुकात्पुरा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005551015, "chapter_id": 25551, "verse_number": "२४-१६", "content_sanskrit": "जिज्ञासवस्तच्चरितं कथं पश्यति नः समम् ।\nभक्त्या चक्रे ततस्तेषामर्घ्यं पाद्यादिकं नृपः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005551016, "chapter_id": 25551, "verse_number": "२४-१७", "content_sanskrit": "आसनत्रयमानीय दिव्यं कनकभूषितम् ।\nनिवेश्याथाकरोत् पूजामीषद्धर्मेऽदिकां पुनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005551017, "chapter_id": 25551, "verse_number": "२४-१८", "content_sanskrit": "जग्मतुस्तेन कामार्थवतिकोपं नृपं प्रति ।\nअर्थ शापमदात्तस्मै लोभात्त्वं नाशमेष्यसि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005551018, "chapter_id": 25551, "verse_number": "२४-१९", "content_sanskrit": "कामोऽप्याह तवोन्मादो भविता गन्दमादने ।\nकुमारवनमाश्रित्य वियोगादुर्वशीभवात् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005551019, "chapter_id": 25551, "verse_number": "२४-२०", "content_sanskrit": "धर्मोऽप्याह चिरायुस्त्वं धार्मिकश्च भविष्यसि ।\nसन्ततिस्तव राजेन्द्र यावच्चन्द्रार्क तारकम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005551020, "chapter_id": 25551, "verse_number": "२४-२१", "content_sanskrit": "शतशो वृद्धिमायातु न नाशम्भुवि यास्यति ।\nइत्युक्त्वान्तर्दधुः सर्वे राजा राज्यं तदन्वभूत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005551021, "chapter_id": 25551, "verse_number": "२४-२२", "content_sanskrit": "अहन्यहनि देवेन्द्रं द्रष्टुं याति सराजराट् ।\nकदाचिदारुह्य रथं दक्षिणाम्बरचारिणम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005551022, "chapter_id": 25551, "verse_number": "२४-२३", "content_sanskrit": "सार्द्धमर्केण सोऽपश्यन्नीयमानामथाम्बरे ।\nकेशिना दानवेन्द्रेण चित्रलेखामथोर्वशीम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005551023, "chapter_id": 25551, "verse_number": "२४-२४", "content_sanskrit": "तं विनिर्जित्य समरे विविधायुधपाणिना ।\nबुधपुत्रेण वायव्यमस्त्रं मुक्त्वा यशोऽर्थिना ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005551024, "chapter_id": 25551, "verse_number": "२४-२५", "content_sanskrit": "तथा शक्रोऽपि समरे येन चैवं विनिर्जितः ।\nमित्रत्वमगमद्देवैर्ददाविन्द्राय चोर्वशीम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005551025, "chapter_id": 25551, "verse_number": "२४-२६", "content_sanskrit": "ततः प्रभृति मित्रत्वमगमत् पाकशासनः ।\nसर्वलोकातिशायित्वं बलमूर्जो यशः श्रियम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005551026, "chapter_id": 25551, "verse_number": "२४-२७", "content_sanskrit": "प्रादाद्वज्रीतु सन्तुष्टो गेयतां भरतेन च ।\nसा पुरूरवसः प्रीत्या गायन्तीं चरितं महत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005551027, "chapter_id": 25551, "verse_number": "२४-२८", "content_sanskrit": "लक्ष्मी स्वयं वरं नाम भरतेन प्रवर्त्तितम् ।\nमेनकामुर्वशीं रम्भां नृत्यतेति तदा दिशत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005551028, "chapter_id": 25551, "verse_number": "२४-२९", "content_sanskrit": "ननर्त्त सलयं तत्र लक्ष्मीरूपेण चोर्वशी ।\nसा पुरूरवसं द्रृष्ट्वा नृत्यन्ती कामपीडिता ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005551029, "chapter_id": 25551, "verse_number": "२४-३०", "content_sanskrit": "विस्मृताभिनयं सर्वं यत्पुरा भरतोदितम् ।\nशशाप भरतः क्रोधाद्वियोगादस्य भूतले ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005551030, "chapter_id": 25551, "verse_number": "२४-३१", "content_sanskrit": "पञ्चपञ्चाशदब्दानि लता सूक्ष्मा भविष्यसि ।\nपुरूरवाः पिशाचत्वं तत्रैवानु भविष्यसि ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005551031, "chapter_id": 25551, "verse_number": "२४-३२", "content_sanskrit": "ततस्तमुर्वीशी गत्वा भर्तारमकरोच्चिरम् ।\nशापान्ते भरतस्याथ उर्वशी बुधसूनुतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005551032, "chapter_id": 25551, "verse_number": "२४-३३", "content_sanskrit": "अजीजनत् सुतानष्टौ नामतस्तान्निबोधत ।\nआयुर्द्रृढायुरश्वायु धनायुर्धृतिमान्वसुः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005551033, "chapter_id": 25551, "verse_number": "२४-३४", "content_sanskrit": "शुचिविद्यः शतायुश्च सर्वे दिव्यबलौजसः ।\nआयुषो नहुषः पुत्रो वृद्धशर्मा तथैव च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005551034, "chapter_id": 25551, "verse_number": "२४-३५", "content_sanskrit": "रजिर्दम्भो विपाप्मा च वीराः पञ्च महारथाः ।\nरजेः पुत्रशतं जज्ञे राजेयमिति विश्रुतम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005551035, "chapter_id": 25551, "verse_number": "२४-३६", "content_sanskrit": "रजिराराधयामास नारायणमकल्मषम् ।\nतपसा तोषितो विष्णुर्वरान् प्रादान्महीपतेः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005551036, "chapter_id": 25551, "verse_number": "२४-३७", "content_sanskrit": "देवासुरमनुष्याणामभूत् स विजयी तदा ।\nअथ देवासुरं युद्धमभूद्वर्षशतत्रयम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005551037, "chapter_id": 25551, "verse_number": "२४-३८", "content_sanskrit": "प्रह्लादशक्रयोर्भीमं न कश्चिद्विजयी तयोः ।\nततो देवासुरैः पृष्टः प्राह देवश्चतुर्मुखः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005551038, "chapter_id": 25551, "verse_number": "२४-३९", "content_sanskrit": "अनयोर्विजयी कः स्यात्‌ रजिर्यत्रेति सोऽब्रवीत् ।\nजयाय प्रार्थितो राजा सहायस्त्वं भवस्व नः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005551039, "chapter_id": 25551, "verse_number": "२४-४०", "content_sanskrit": "दैत्यैः प्राह यदि स्वामी वो भवामि ततस्त्वलम् ।\nनासुरैः प्रतिपन्नं तत्‌ प्रतिपन्नं सुरैस्तथा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005551040, "chapter_id": 25551, "verse_number": "२४-४१", "content_sanskrit": "स्वामी भव त्वमस्माकं सङ्ग्रामे नाशयद्विषः ।\nततो विनाशिताः सर्वे येऽवध्या वज्रपाणिना ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005551041, "chapter_id": 25551, "verse_number": "२४-४२", "content_sanskrit": "पुत्रत्वमगमत् तुष्टस्तस्येन्द्रः कर्मणा विभुः ।\nदत्वेन्द्राय तदा राज्यं जगाम तपसेरजिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005551042, "chapter_id": 25551, "verse_number": "२४-४३", "content_sanskrit": "रजिपुत्रैस्तदाच्छिन्नं बलादिन्द्रस्य वैभवम् ।\nयज्ञभागञ्च राज्यञ्च तपो बल गुणान्वितैः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005551043, "chapter_id": 25551, "verse_number": "२४-४४", "content_sanskrit": "राज्याद्‌भ्रष्टस्तदाशक्रो रजिपुत्रैर्निपीडितः ।\nप्राहवाचस्पतिं दीनः पीडितोऽस्मि रजेः सुतैः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005551044, "chapter_id": 25551, "verse_number": "२४-४५", "content_sanskrit": "न यज्ञभागो राज्यं मे निर्जितश्च बृहस्पते ।\nराज्यलाभाय मे यत्नं विधत्स्व धिषणाधिप ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005551045, "chapter_id": 25551, "verse_number": "२४-४६", "content_sanskrit": "ततो बृहस्पतिः शक्रमकरोद् बलदर्पितम् ।\nग्रहशान्तिविधानेन पौष्टिकेन च कर्मणा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005551046, "chapter_id": 25551, "verse_number": "२४-४७", "content_sanskrit": "गत्वाऽथ मोहयामास रजिपुत्रान्‌ बृहस्पतिः ।\nजिनधर्मं समास्थाय वेदबाह्यं सवेदवित् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005551047, "chapter_id": 25551, "verse_number": "२४-४८", "content_sanskrit": "वेदत्रयी परिभ्रष्टां श्चकार धिषणाधिपः ।\nवेदबाह्यान् परिज्ञाय हेतुवादसमन्वितान् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005551048, "chapter_id": 25551, "verse_number": "२४-४९", "content_sanskrit": "जधान शक्रो वज्रेण सर्वान्‌ धर्मबहिष्कृतान् ।\nनहुषस्य प्रवक्ष्यामि पुत्रान्‌ सप्तैव धार्मिकान् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005551049, "chapter_id": 25551, "verse_number": "२४-५०", "content_sanskrit": "ततः प्रभृति मित्रत्वमगमत्पाकशासनः ।\nसर्वलोकातिशायित्वं बलमूर्जो यशः श्रियम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005551050, "chapter_id": 25551, "verse_number": "२४-५१", "content_sanskrit": "यतिः कुमारभावेऽपि योगी वैखानसोऽभवत् ।\nययातिश्चाकरोद्राज्यं धर्मैक शरणः सदा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005551051, "chapter_id": 25551, "verse_number": "२४-५२", "content_sanskrit": "शर्मिष्ठा तस्य भार्याभूद्‌ दुहिता वृषपर्वणः ।\nभार्गवस्यात्मजा तद्वत् देवयानी च सुव्रता ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005551052, "chapter_id": 25551, "verse_number": "२४-५३", "content_sanskrit": "ययातेः पञ्च दायादास्तान् प्रवक्ष्यामि नामतः ।\nदेवयानी यदुं पुत्रं तुर्वसुञ्चाप्यजीजनत् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005551053, "chapter_id": 25551, "verse_number": "२४-५४", "content_sanskrit": "तथाद्रुह्य मनुं पूरुं शर्मिष्ठाजनयत्‌ सुतान् ।\nयदुः पूरुश्चाभवतां तेषां वंशविवर्धनौ ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005551054, "chapter_id": 25551, "verse_number": "२४-५५", "content_sanskrit": "ययातिर्नाहुषश्चासीत् राजा सत्यपराक्रमः ।\nपालयामास स महीमीजे च विधिवन्मखैः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005551055, "chapter_id": 25551, "verse_number": "२४-५६", "content_sanskrit": "अतिभक्त्या पितॄनर्च्य देवांश्च प्रयतः सदा ।\nअथाजयत्‌ प्रजाः सर्वा ययातिरपराजितः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005551056, "chapter_id": 25551, "verse_number": "२४-५७", "content_sanskrit": "स शाश्वतीः समा राजा प्रजाधर्मेण पालयत् ।\nजरामार्च्छन्महाघोरं नाहुषो रूपनाशिनीम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005551057, "chapter_id": 25551, "verse_number": "२४-५८", "content_sanskrit": "जराभिभूतः पुत्रान् स राजा वचनमब्रवीत् ।\nयदुं पूरुं तुर्वसुञ्च द्रुह्यं चानुञ्च पार्थिवः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005551058, "chapter_id": 25551, "verse_number": "२४-५९", "content_sanskrit": "यौवनेन चलान्‌ कामान् युवायुवतिभिः सह ।\nविहर्तुमहमिच्छामि साहाय्यं कुरुतात्मजाः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005551059, "chapter_id": 25551, "verse_number": "२४-६०", "content_sanskrit": "तं पुत्रो देवयानेयः पूर्वजो यदुरब्रवीत् ।\nसाहाय्यं भवतः कार्यमस्माभि र्यौवनेन किम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005551060, "chapter_id": 25551, "verse_number": "२४-६१", "content_sanskrit": "ययातिरब्रवीत् पुत्रान् जरा मे प्रतिगृह्यताम् ।\nयौवनेनाथ भवतां चरेयं विषयानहम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005551061, "chapter_id": 25551, "verse_number": "२४-६२", "content_sanskrit": "यजतो दीर्घसत्रैर्मे शापाच्चोशनसो मुनेः ।\nकामार्थः परिहीनो मेऽतृप्तोऽहं तेन पुत्रकाः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005551062, "chapter_id": 25551, "verse_number": "२४-६३", "content_sanskrit": "स्वकीयेन शरीरेण जरामेनां प्रशास्तु वः ।\nअहं तन्वाभिनवया युवाकामानवाप्नुयाम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005551063, "chapter_id": 25551, "verse_number": "२४-६४", "content_sanskrit": "न तेऽस्य प्रत्यगृह्णन्त यदु प्रभृतयो जराम् ।\nचतुरस्तान् स राजर्षिरशपच्चेति नः श्रुतम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005551064, "chapter_id": 25551, "verse_number": "२४-६५", "content_sanskrit": "तमब्रवीत्ततः पूरुः कनीयान् सत्यविक्रमः ।\nजरां मा देहि नवया तन्वा मे यौवनात्‌ सुखी ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7005551065, "chapter_id": 25551, "verse_number": "२४-६६", "content_sanskrit": "अहं जरावन्तमादाय राज्ये स्थास्यामि चाज्ञया ।\nएवमुक्तः स राजर्षिस्तपोवीर्य्य समाश्रयात् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7005551066, "chapter_id": 25551, "verse_number": "२४-६७", "content_sanskrit": "संस्थापयामास जरां तदा पुत्रे महात्मनि ।\nपौरवेणाथ वयसा राजा यौवनमास्थितः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7005551067, "chapter_id": 25551, "verse_number": "२४-६८", "content_sanskrit": "ययातेश्चाथ वयसा राज्यं पूरुरकारयत् ।\nततो वर्षसहस्रान्ते ययातिरपराजितः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7005551068, "chapter_id": 25551, "verse_number": "२४-६९", "content_sanskrit": "अतृप्त इव कामानां पूरुं पुत्रमुवाच ह ।\nत्वया दायादवानस्मि त्वं मे वंशकरः सुतः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7005551069, "chapter_id": 25551, "verse_number": "२४-७०", "content_sanskrit": "पौस्वो वंश इत्येष ख्यातिं लोके गमिष्यति ।\nततः स नृपशार्दूलः पूरुं राज्येऽभिषिच्य च ।\nकालेन महता पश्चात्काल धर्म्ममुपेयिवान् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7005551070, "chapter_id": 25551, "verse_number": "२४-७१", "content_sanskrit": "पूरुवंशं प्रवक्ष्यामि श्रृणुध्वमृषिसत्तमाः ।\nयत्र ते भारता जाता भरतान्वय वर्द्धनाः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]