[{"id": 2086616, "chapter_id": 2842, "verse_number": "१२-३४७-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2086617, "chapter_id": 2842, "verse_number": "१२-३४७-१", "content_sanskrit": "एवं स्तुतः स भगवान् गुह्यैस्तथ्यैश्च नामभिः।\n`भगवान्विश्वसृक्सिंहः सर्वमूर्तिमयः प्रभुः।\nदर्शयामास मुनये रूपं तत्परमं हरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2086618, "chapter_id": 2842, "verse_number": "१२-३४७-२", "content_sanskrit": "किंचिच्चन्द्राद्विशुद्धात्मा किंचिच्चन्द्राद्विशेषवान्।\nकृशानुवर्णः किंचिच्च किंचिद्धिष्ण्याकृतिः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2086619, "chapter_id": 2842, "verse_number": "१२-३४७-३", "content_sanskrit": "शुकपत्रनिभः किंचित्किंचित्स्फटिकसन्निभः।\nनीलाञ्जनचयप्रख्यो जातरूपप्रभः क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2086620, "chapter_id": 2842, "verse_number": "१२-३४७-४", "content_sanskrit": "प्रबालाङ्कुरवर्णश्च श्वेतवर्णस्तथा क्वचित्।\nक्वचित्सुवर्णवर्णाभो वैदूर्यसदृशः क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2086621, "chapter_id": 2842, "verse_number": "१२-३४७-५", "content_sanskrit": "नीलवैर्दूर्यसदृश इन्द्रनीलनिभः क्वचित्।\nमयूरग्रीववर्णाभो मुक्ताहारनिभः क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2086622, "chapter_id": 2842, "verse_number": "१२-३४७-६", "content_sanskrit": "एतान्बहुधान्वर्णान्रूपैर्बिभ्रत्सनातनः।\nसहस्रनयनः श्रीमाञ्छतशीर्षः सहस्रपात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2086623, "chapter_id": 2842, "verse_number": "१२-३४७-७", "content_sanskrit": "सहस्रोदरबाहुश्च अव्यक्त इति च क्वचित्।\nओंकारमुद्गिरन्वक्रात्सावित्रीं च तदन्वयाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2086624, "chapter_id": 2842, "verse_number": "१२-३४७-८", "content_sanskrit": "शेषेभ्यश्चैव वक्रेभ्यश्चतुर्वेदान्गिरन्बहून्।\nआरण्यकं जगौ देवो हरिर्नारायणो वशी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2086625, "chapter_id": 2842, "verse_number": "१२-३४७-९", "content_sanskrit": "वेदिं कमण्डलुं दर्भान्मणिरूपांस्तथा कुशान्।\nअजिनं दण्डकाष्ठं च ज्वलितं च हुताशनम्।\nधारयामास देवेशो हस्तैर्यज्ञपतिस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2086626, "chapter_id": 2842, "verse_number": "१२-३४७-१०", "content_sanskrit": "तं प्रसन्नं प्रसन्नात्मा नारदो द्विजसत्तमः।\nवाग्यतः प्रणतो भूत्वा ववन्दे परमेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2086627, "chapter_id": 2842, "verse_number": "१२-३४७-११", "content_sanskrit": "तमुवाच नतं मूर्ध्ना देवानामादिरव्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2086628, "chapter_id": 2842, "verse_number": "१२-३४७-१२x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2086629, "chapter_id": 2842, "verse_number": "१२-३४७-१२", "content_sanskrit": "एकतश्च द्वितश्चैव त्रितश्चैव महर्षयः।\nइमं देशमनुप्राप्ता मम दर्शनलालसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2086630, "chapter_id": 2842, "verse_number": "१२-३४७-१३", "content_sanskrit": "न च मां ते ददृशिरे न च द्रक्ष्यति कश्चन।\nऋते ह्यैकान्तिकश्रेष्ठात्त्वं चैवैकान्तिकोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2086631, "chapter_id": 2842, "verse_number": "१२-३४७-१४", "content_sanskrit": "ममैतास्तनवः श्रेष्ठा जाता धर्मगृहे द्विज।\nतास्त्वं भजस्व सततं साधयस्व यथागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2086632, "chapter_id": 2842, "verse_number": "१२-३४७-१५", "content_sanskrit": "वृणीष्व च वरं प्रिय मत्तस्त्वं यदिहेच्छसि।\nप्रसन्नोऽहं तवाद्येह विश्वमूर्तिरिहाव्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2086633, "chapter_id": 2842, "verse_number": "१२-३४७-१६x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2086634, "chapter_id": 2842, "verse_number": "१२-३४७-१६", "content_sanskrit": "अद्य मे तपसो देव यमस्य नियमस्य च।\nसद्यः फलमवाप्तं वै दृष्टो यद्भगवान्मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2086635, "chapter_id": 2842, "verse_number": "१२-३४७-१७", "content_sanskrit": "वर एष ममात्यन्तं दृष्टस्त्वं यत्सनातनः।\nभगवन्विश्वदृक् सिंहः सर्वमूर्तिर्महान्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2086636, "chapter_id": 2842, "verse_number": "१२-३४७-१८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2086637, "chapter_id": 2842, "verse_number": "१२-३४७-१८", "content_sanskrit": "एवं संदर्शयित्वा तु नारदं परमेष्ठिजम्।\nउवाच वचनं भूयो गच्छ नारद माचिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2086638, "chapter_id": 2842, "verse_number": "१२-३४७-१९", "content_sanskrit": "इमे ह्यनिन्द्रियाहारा मद्भक्ताश्चन्द्रवर्चसः।\nएकाग्राश्चिन्तयेयुर्मां नैषां विघ्नो भवेदिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2086639, "chapter_id": 2842, "verse_number": "१२-३४७-२०", "content_sanskrit": "सिद्धा ह्येते महाभागाः पुरा ह्येकान्तिनोऽभवन्।\nतमोरजोभिर्निर्मुक्ता मां प्रवेक्ष्यन्त्यसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2086640, "chapter_id": 2842, "verse_number": "१२-३४७-२१", "content_sanskrit": "न दृश्यश्चक्षुषा योऽसौ न स्पृश्यः स्पर्शनेन च।\nन घ्रेयश्चैव गन्धेन रसेन च विवर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2086641, "chapter_id": 2842, "verse_number": "१२-३४७-२२", "content_sanskrit": "सत्वं रजस्तमश्चैव न गुणास्तं भजन्ति वै।\nयश्च सर्वगतः साक्षी लोकस्यात्मेति कथ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2086642, "chapter_id": 2842, "verse_number": "१२-३४७-२३", "content_sanskrit": "भूतग्रामशरीरेषु नश्यत्सु न विनश्यति।\nअजो नित्यः शाश्वतश्च निर्गुणो निष्कलस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2086643, "chapter_id": 2842, "verse_number": "१२-३४७-२४", "content_sanskrit": "द्विर्द्वादशेभ्यस्तत्त्वेभ्यः ख्यातो यः पञ्चविंशकः।\nपुरुषो निष्क्रियश्चैव ज्ञानदृश्यश्च कथ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2086644, "chapter_id": 2842, "verse_number": "१२-३४७-२५", "content_sanskrit": "यं प्रविश्य भवन्तीह मुक्ता वै द्विजसत्तमाः।\nस वासुदेवो विज्ञेयः परमात्मा सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2086645, "chapter_id": 2842, "verse_number": "१२-३४७-२६", "content_sanskrit": "पश्य देवस्य माहात्म्यं महिमानं च नारद।\nशुभाशुभैः कर्मभिर्यो न लिप्यति कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2086646, "chapter_id": 2842, "verse_number": "१२-३४७-२७", "content_sanskrit": "सत्वं रजस्तमश्चेति गुणानेतान्प्रचक्षते।\nएते सर्वशरीरेषु तिष्ठन्ति विचरन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2086647, "chapter_id": 2842, "verse_number": "१२-३४७-२८", "content_sanskrit": "एतान्गुणांस्तु क्षेत्रज्ञो भुङ्क्ते नैभिः स भुज्यते।\nनिर्गुणो गुणभुक्चैव गुणस्रष्टा गुणातिगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2086648, "chapter_id": 2842, "verse_number": "१२-३४७-२९", "content_sanskrit": "जगत्प्रतिष्ठा देवर्षे पृथिव्यप्सु प्रलीयते।\nज्योतिष्यापः प्रलीयन्ते ज्योतिर्वायौ प्रलीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2086649, "chapter_id": 2842, "verse_number": "१२-३४७-३०", "content_sanskrit": "खे वायुः प्रलयं याति मनस्याकाशमेव च।\nमनो हि परमं भूतं तदव्यक्ते प्रलीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2086650, "chapter_id": 2842, "verse_number": "१२-३४७-३१", "content_sanskrit": "अव्यक्तं पुरुषे ब्रह्मन्निष्क्रिये संप्रलीयते।\nनास्ति तस्मात्परतरः पुरुषाद्वै सनातनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2086651, "chapter_id": 2842, "verse_number": "१२-३४७-३२", "content_sanskrit": "नित्यं हि नास्ति जगति भूतं स्थावरजङ्गमम्।\nऋते तमेकं पुरुषं वासुदेवं सनातनम्।\nसर्वभूतात्मभूतो हि वासुदेवो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2086652, "chapter_id": 2842, "verse_number": "१२-३४७-३३", "content_sanskrit": "पृथिवी वायुराकाशमापो ज्योतिश्च पञ्चमम्।\nते समेता महात्मानः शरीरमिति संज्ञितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2086653, "chapter_id": 2842, "verse_number": "१२-३४७-३४", "content_sanskrit": "तदाविशति यो ब्रह्मन्न दृश्यो लघुविक्रमः।\nउत्पन्न एव भवति शरीरं चेष्टयन्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2086654, "chapter_id": 2842, "verse_number": "१२-३४७-३५", "content_sanskrit": "न विना धातुसंघातं शरीरं भवति क्वचित्।\nन च जीवं विना ब्रह्मन्वायवश्चेष्टयन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2086655, "chapter_id": 2842, "verse_number": "१२-३४७-३६", "content_sanskrit": "स जीवः परिसंख्यातः शेषः संकर्षणः प्रभुः।\nतस्मात्सनत्कुमारत्वं योऽलभत्स्वेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2086656, "chapter_id": 2842, "verse_number": "१२-३४७-३७", "content_sanskrit": "यस्मिंश्च सर्वभूतानि प्रद्युम्नः परिपठ्यते।\nतस्मात्प्रसूतो यः कर्ता कारणं कार्यमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2086657, "chapter_id": 2842, "verse_number": "१२-३४७-३८", "content_sanskrit": "तस्मत्सर्वं संभवति जगत्स्थावरजङ्गमम्।\nसोऽनिरुद्धः स ईशानो व्यक्तिः सा सर्वकर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2086658, "chapter_id": 2842, "verse_number": "१२-३४७-३९", "content_sanskrit": "यो वासुदेवो भगवान्क्षेत्रज्ञो निर्गुणात्मकः।\nज्ञेयः स एव राजेन्द्र जीवः संकर्षणः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2086659, "chapter_id": 2842, "verse_number": "१२-३४७-४०", "content_sanskrit": "संकर्षणाच्च प्रद्युम्नो मनोभूतः स उच्यते।\nप्रद्युम्नाद्योऽनिरूद्धस्तु सोहंकारः स ईश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2086660, "chapter_id": 2842, "verse_number": "१२-३४७-४१", "content_sanskrit": "मत्तः सर्वं संभवति जगत्स्थावरजङ्गमम्।\nअक्षरं च क्षरं चैव सच्चासच्चैव नारद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2086661, "chapter_id": 2842, "verse_number": "१२-३४७-४२", "content_sanskrit": "मां प्रविश्य भवन्तीह मुक्ता भक्तास्तु ये मम।\nअहं हि पुरुषो ज्ञेयो निष्क्रियः पञ्चविंशकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2086662, "chapter_id": 2842, "verse_number": "१२-३४७-४३", "content_sanskrit": "निर्गुणो निष्कलश्चैव निर्द्वन्द्वो निष्परिग्रहः।\nएतत्त्वया न विज्ञेयं रूपवानिति दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2086663, "chapter_id": 2842, "verse_number": "१२-३४७-४४", "content_sanskrit": "इच्छन्मुहूर्तान्नश्येयमीशोऽहं जगतो गुरुः।\nमाया ह्येषा मया सृष्टा यन्मां पश्यसि नारद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2086664, "chapter_id": 2842, "verse_number": "१२-३४७-४५", "content_sanskrit": "सर्वभूतगुणैर्युक्तं नैवं त्वं ज्ञातुमर्हसि।\nमयैतत्कथितं सम्यक्तव मूर्तिचतुष्टयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2086665, "chapter_id": 2842, "verse_number": "१२-३४७-४६", "content_sanskrit": "अहं हि जीवसंज्ञो वै मयि जीवः समाहितः।\nमैवं ते बुद्धिरत्राभूर्द्दृषो जीवो मयेति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2086666, "chapter_id": 2842, "verse_number": "१२-३४७-४७", "content_sanskrit": "अहं सर्वत्रगो ब्रह्मन्भूतग्रामान्तरात्मकः।\nभूतग्रामशरीरेषु नश्यत्सु न नशाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2086667, "chapter_id": 2842, "verse_number": "१२-३४७-४८", "content_sanskrit": "सिद्धा हि ते महाभागा नरा ह्येकान्तिनोऽभवन्।\nतमोरजोभ्यां निर्मुक्ताः प्रवेक्ष्यन्ति च मां मुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2086668, "chapter_id": 2842, "verse_number": "१२-३४७-४९", "content_sanskrit": "`अहं कर्ता च कार्यं च कारणं चापि नराद।\nन दृश्यश्चक्षुषा देवः स्पृश्यो न स्पर्शनेन च।\nआघ्रेयो नैव गन्धेन रसेन च विसर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2086669, "chapter_id": 2842, "verse_number": "१२-३४७-५०", "content_sanskrit": "सत्वं रजस्तमश्चैव न गुणास्ते भवन्ति हि।\nस हि सर्वगतः साक्षी लोकस्यात्मेति कथ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2086670, "chapter_id": 2842, "verse_number": "१२-३४७-५१", "content_sanskrit": "हिरण्यगर्भो लोकादिश्चतुर्वक्रोऽनिरुक्तगः।\nब्रह्मा सनातनो देवो मम बह्वर्थचिन्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2086671, "chapter_id": 2842, "verse_number": "१२-३४७-५२", "content_sanskrit": "ललाटाच्चैव मे रुद्रो देवः क्रोधाद्विनिःसृतः।\nपश्यैकादश मे रुद्रान्दक्षिणं पार्श्वमास्थितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2086672, "chapter_id": 2842, "verse_number": "१२-३४७-५३", "content_sanskrit": "द्वादशैव तथाऽऽदित्यान्वामपार्श्वे समास्थितान्।\nअग्रतश्चैव मे पश्य वसूनष्टौ सुरोत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2086673, "chapter_id": 2842, "verse_number": "१२-३४७-५४", "content_sanskrit": "नासत्यं चैव दस्रं च भिषजौ पश्य पृष्ठतः।\nसर्वान्प्रजापतीन्पश्य पश्य सप्तऋर्षीस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2086674, "chapter_id": 2842, "verse_number": "१२-३४७-५५", "content_sanskrit": "वेदान्यज्ञांश्च शतशः पश्यामृतमथौषधीः।\nतपांसि नियमांश्चैव यमानपि पृथग्विधान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2086675, "chapter_id": 2842, "verse_number": "१२-३४७-५६", "content_sanskrit": "तथाऽष्टगुणमैश्वर्यमेकस्थं पश्य मूर्तिमत्।\nश्रियं लक्ष्मीं च कीर्तिं च पृथिवीं च ककुद्मिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2086676, "chapter_id": 2842, "verse_number": "१२-३४७-५७", "content_sanskrit": "वेदानां मातरं पश्य मत्स्थां देवीं सरस्वतीम्।\nध्रुवं च ज्योतिषां श्रेष्ठं पश्य नारद खेचरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2086677, "chapter_id": 2842, "verse_number": "१२-३४७-५८", "content_sanskrit": "अम्भोधरान्समुद्रांश्च सरांसि सरितस्तथा।\nमूर्तिमन्तः पितृगणांश्चतुरः पश्य सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2086678, "chapter_id": 2842, "verse_number": "१२-३४७-५९", "content_sanskrit": "त्रींश्चैवेमान्गुणान्पश्य मत्स्थान्मूर्तिविवर्जितान्।\nदेवकार्यादपि मुने पितृकार्यं विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2086679, "chapter_id": 2842, "verse_number": "१२-३४७-६०", "content_sanskrit": "देवानां च पितृणां च पिता ह्येकोऽहमादितः।\nअहं हयशिरा भूत्वा समुद्रे पश्चिमोत्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2086680, "chapter_id": 2842, "verse_number": "१२-३४७-६१", "content_sanskrit": "पिबामि सुहुतं हव्यं कव्यं च श्रद्धयाऽन्वितम्।\nमया सृष्टः पुरा ब्रह्मा मां यज्ञमयजत्स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2086681, "chapter_id": 2842, "verse_number": "१२-३४७-६२", "content_sanskrit": "ततस्तस्मै वरान्प्रीतो दत्तवानस्म्यनुत्तमान्।\nमत्पुत्रत्वं च कल्पादौ लोकाध्यक्षत्वमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2086682, "chapter_id": 2842, "verse_number": "१२-३४७-६३", "content_sanskrit": "अहंकारकृतं चैव नामपर्यायवाचकम्।\nत्वया कृतां च मर्यादां नातिक्रंस्यति कश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2086683, "chapter_id": 2842, "verse_number": "१२-३४७-६४", "content_sanskrit": "त्वं चैव वरदो ब्रह्मन्वरेप्सूनां भविष्यसि।\nसुरासुरगणानां च ऋषीणां च तपोधन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2086684, "chapter_id": 2842, "verse_number": "१२-३४७-६५", "content_sanskrit": "पितृणां च महाभाग सततं संशितव्रत।\nविविधानां च भूतानां त्वमुपास्यो भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2086685, "chapter_id": 2842, "verse_number": "१२-३४७-६६", "content_sanskrit": "प्रादुर्भावगतश्चाहं सुरकार्येषु नित्यदा।\nअनुशास्यस्त्वया ब्रह्मन्नियोज्यश्च सुतो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2086686, "chapter_id": 2842, "verse_number": "१२-३४७-६७", "content_sanskrit": "एतांश्चान्यांश्च रुचिरान्ब्रह्मणेऽमिततेजसे।\n`एवं रुद्राय मनवे इन्द्रायामिततेजसे।\nअहं दत्त्वा वरान्प्रीतो निवृत्तिपरमोऽभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2086687, "chapter_id": 2842, "verse_number": "१२-३४७-६८", "content_sanskrit": "निर्वाणं सर्वधर्माणां निवृत्तिः परमा स्मृता।\nतस्मान्निवृत्तिमापन्नश्चरेत्सर्वाङ्गनिर्वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2086688, "chapter_id": 2842, "verse_number": "१२-३४७-६९", "content_sanskrit": "विद्यासहायवन्तं मामादित्यस्थं सनातनम्।\nकपिलं प्राहुराचार्याः साङ्ख्यनिश्चितनिश्चयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2086689, "chapter_id": 2842, "verse_number": "१२-३४७-७०", "content_sanskrit": "हिरण्यगर्भो भगवानेष च्छन्दसि संस्तुतः।\nसोहं योगगतिर्ब्रह्मन्योगशास्त्रेषु शब्दितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2086690, "chapter_id": 2842, "verse_number": "१२-३४७-७१", "content_sanskrit": "एषोऽहं व्यक्तिमाश्रित्य तिष्ठामि दिवि शाश्वतः।\nततो युगसहस्रान्ते संहरिष्ये जगत्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2086691, "chapter_id": 2842, "verse_number": "१२-३४७-७२", "content_sanskrit": "कृत्वाऽऽत्मस्थानि भूतानि स्थावराणि चराणि च।\nएकाकी विद्यया सार्धं विहरिष्ये जगत्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2086692, "chapter_id": 2842, "verse_number": "१२-३४७-७३", "content_sanskrit": "ततो भूयो जगत्सर्वं करिष्यामीह विद्यया।\nअस्मिन्मूर्तिश्चतुर्थी या साऽसृजच्छेषमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2086693, "chapter_id": 2842, "verse_number": "१२-३४७-७४", "content_sanskrit": "स हि संकर्षणः प्रोक्तः प्रद्युम्नः सोप्यजीजनत्।\nप्रद्युम्नादनिरुद्धोऽहं सर्गो मम पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2086694, "chapter_id": 2842, "verse_number": "१२-३४७-७५", "content_sanskrit": "अनिरुद्धात्तथा ब्रह्मा तन्नाभिकमलोद्भवः।\nब्रह्मणः सर्वभूतानि चराणि स्थावराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2086695, "chapter_id": 2842, "verse_number": "१२-३४७-७६", "content_sanskrit": "एतां सृष्टिं विजानीहि कल्पादिषु पुनः पुनः।\nयथा सूर्यस्य गगनादुदयास्तमने इह।\nनष्टे पुनर्वलात्काल आनयत्यमितद्युते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2086696, "chapter_id": 2842, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि नारायणीये सप्तचत्वारिंशदधिकत्रिशततमोऽध्यायः॥ ३४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]