[{"id": 2188523, "chapter_id": 5006, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2188524, "chapter_id": 5006, "verse_number": "१", "content_sanskrit": "द्विजातयो व्रतोपेता यदिदं भुञ्जते हविः ।\nअन्नं ब्राह्मणकामाय कथमेतत् पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2188525, "chapter_id": 5006, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2188526, "chapter_id": 5006, "verse_number": "२", "content_sanskrit": "अवेदोक्तव्रतोपेता भुञ्जानाः कार्यकारिणः ।\nवेदोक्तेषु च भुञ्जाना व्रतलुप्ता युधिष्ठिर\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2188527, "chapter_id": 5006, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2188528, "chapter_id": 5006, "verse_number": "३", "content_sanskrit": "यदिदं तप इत्याहुरुपवासं पृथग्जनाः ।\nएतत् तपो महाराज उताहो किं तपो भवेत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2188529, "chapter_id": 5006, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2188530, "chapter_id": 5006, "verse_number": "४", "content_sanskrit": "मासपक्षोपवासेन मन्यन्ते यत् तपो जनाः ।\nआत्मतन्त्रोपघातस्य न तपस्तत् सतां मतम् ।\nत्यागश्च सन्नतिश्चैव शिष्यते तप उत्तमम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2188531, "chapter_id": 5006, "verse_number": "५", "content_sanskrit": "सदोपवासी च भवेद् ब्रह्मचारी सदैव च ।\nमुनिश्च स्यात् सदा विप्रो दैवतं च सदा भजेत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2188532, "chapter_id": 5006, "verse_number": "६", "content_sanskrit": "कुटुम्बिको धर्मकामः सदास्वप्नश्च भारत ।\nअमांसाशी सदा च स्यात् पवित्रं च सदा जपेत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2188533, "chapter_id": 5006, "verse_number": "७", "content_sanskrit": "अमृताशी सदा च स्यान्न च स्याद् विषभोजनः ।\nविघसाशी सदा च स्यात् सदा चैवातिथिप्रियः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2188534, "chapter_id": 5006, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2188535, "chapter_id": 5006, "verse_number": "८", "content_sanskrit": "कथं सदोपवासी स्याद् ब्रह्मचारी कथं भवेत् ।\nविघसाशी कथं च स्यात् सदा चैवातिथिप्रियः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2188536, "chapter_id": 5006, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2188537, "chapter_id": 5006, "verse_number": "९", "content_sanskrit": "अन्तरा प्रातराशं च सायमाशं तथैव च ।\nसदोपवासी च भवेद्यो न भुङ्क्ते कथञ्चन\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2188538, "chapter_id": 5006, "verse_number": "१०", "content_sanskrit": "भार्यां गच्छन् ब्रह्मचारी ऋतौ भवति ब्राह्मणः ।\nऋतवादी सदा च स्याज्ज्ञाननित्यश्च यो नरः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2188539, "chapter_id": 5006, "verse_number": "११", "content_sanskrit": "अभक्षयन् वृथामांसममांसाशी भवत्युत ।\nदाननित्यः पवित्रश्च अस्वप्नश्च दिवास्वपन्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2188540, "chapter_id": 5006, "verse_number": "१२", "content_sanskrit": "भृत्यातिथिषु यो भुङ्क्ते भुक्तवत्सु सदा स ह ।\nअमृतं सकलं भुङ्क्त इति विद्धि युधिष्ठिर\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2188541, "chapter_id": 5006, "verse_number": "१३", "content_sanskrit": "अभुक्तवत्सु नाश्नानः सततं यस्तु वै द्विजः ।\nअभोजनेन तेनास्य जितः स्वर्गो भवत्युत\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2188542, "chapter_id": 5006, "verse_number": "१४", "content_sanskrit": "देवताभ्यः पितृभ्यश्च भृत्येभ्योऽतिथिभिः सह ।\nअवशिष्टं तु योऽश्नाति तमाहुर्विघसाशिनम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2188543, "chapter_id": 5006, "verse_number": "१५", "content_sanskrit": "तेषां लोका ह्यपर्यन्ताः सदने ब्रह्मणा सह ।\nउपस्थिताश्चाप्सरोभिः परियान्ति दिवौकसः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2188544, "chapter_id": 5006, "verse_number": "१६", "content_sanskrit": "देवताभिश्च ये सार्धं पितृभिश्चोपभुञ्जते ।\nरमन्ते पुत्रपौत्रैश्च तेषां गतिरनुत्तमा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2188545, "chapter_id": 5006, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे पञ्चपञ्चाशोऽध्यायः ॥५५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]