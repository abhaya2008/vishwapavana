[{"id": 7001941000, "chapter_id": 21941, "verse_number": "१२०-१", "content_sanskrit": "अविक्षिच्चरितवर्णनम् ।\nमार्कण्डेय उवाच ।\nइति संग्रामसज्जास्ते भूपा भूपसुतस्तथा ।\nनिराकृताः सुबहुशस्तत्कालं चाप्यविक्षिता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001941001, "chapter_id": 21941, "verse_number": "१२०-२", "content_sanskrit": "ततो बभूव संग्रामस्तस्य तैः सह दारुणः ।\nएकस्य बहुभिर्भूपैर्भूपपुत्रवरैर्मुने ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001941002, "chapter_id": 21941, "verse_number": "१२०-३", "content_sanskrit": "तेऽसिशक्तिगदाबाणपाणयस्तं सुदुर्मदाः ।\nअभिघ्नन्तो युयुधिरे तैः समस्तैरसावपि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001941003, "chapter_id": 21941, "verse_number": "१२०-४", "content_sanskrit": "स ताञ्छरशतैरुग्रैर्बिभेद नृपनन्दनः ।\nकृतास्त्रो बलवान्बाणैस्ते च तं बिभिदुः शितैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001941004, "chapter_id": 21941, "verse_number": "१२०-५", "content_sanskrit": "कस्यचिच्चिच्छिदे बाहुमन्यस्य च शिरोधराम् ।\nहृदि विव्याध चैवान्यमन्यं वक्षस्यताडयत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001941005, "chapter_id": 21941, "verse_number": "१२०-६", "content_sanskrit": "करं चिच्छेद करिणस्तुरगस्य तथा शिरः ।\nरथस्येषां तथैवाश्वान्रथस्यान्यस्य सारथिम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001941006, "chapter_id": 21941, "verse_number": "१२०-७", "content_sanskrit": "बाणानापततश्चक्रे द्विधा बाणैस्तथा द्विषाम् ।\nचिच्छेदान्यस्य खड्गं च धनुरन्यस्य लाघवात् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001941007, "chapter_id": 21941, "verse_number": "१२०-८", "content_sanskrit": "तनुत्रेऽपहृते तेन ननाशान्यो नृपात्मजः ।\nअविक्षिताहतश्चान्यः पदातिः प्रजहौ रणम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001941008, "chapter_id": 21941, "verse_number": "१२०-९", "content_sanskrit": "इत्याकुलीकृते तस्मिन्समग्रे राजमण्डले ।\nतस्थुः सप्तशतं वीरा मरणे कृतनिश्चयाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001941009, "chapter_id": 21941, "verse_number": "१२०-१०", "content_sanskrit": "आभिजात्यवयःशौर्यलज्जाभारसमन्विताः ।\nनिर्जिते सकले सैन्ये पलायनपरायणे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001941010, "chapter_id": 21941, "verse_number": "१२०-११", "content_sanskrit": "तैः समेत्य महीपालैः स तु पुत्रो महीभृतः ।\nयुयुधे धर्मयुद्धेन तेन तं नातिकोपितः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001941011, "chapter_id": 21941, "verse_number": "१२०-१२", "content_sanskrit": "विच्छिन्नयन्त्रकवचान्स तानपि महाबलः ।\nकर्त्तुं व्यवस्थितस्ते च ततः क्रुद्धा महामुने ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001941012, "chapter_id": 21941, "verse_number": "१२०-१३", "content_sanskrit": "धर्ममुत्सृज्य युयुधुर्युध्यमानेन धर्मतः ।\nनरेन्द्रपुत्राः प्रस्वेदजलक्लिन्नाननाः समम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001941013, "chapter_id": 21941, "verse_number": "१२०-१४", "content_sanskrit": "विव्याध कश्चिद्बाणौघैः कश्चिच्चिच्छेद कार्मुकम् ।\nध्वजमस्यापरो बाणैश्छित्त्वा भूमावपातयत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001941014, "chapter_id": 21941, "verse_number": "१२०-१५", "content_sanskrit": "जघ्नुरन्ये तथैवाश्वान्बभञ्जुश्चापरे रथम् ।\nगदापातेनाथ चान्ये बाणैः पृष्ठमताडयन् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001941015, "chapter_id": 21941, "verse_number": "१२०-१६", "content_sanskrit": "छिन्ने धनुषि सक्रोधः स तदा नृपतेः सुतः ।\nजग्राहासिं तथा चर्म तदप्यन्योन्वपातयत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001941016, "chapter_id": 21941, "verse_number": "१२०-१७", "content_sanskrit": "च्छिन्नासिचर्मा जग्राह स गदां गदिनां वरः ।\nतामप्यन्यः क्षुरप्रेण चिच्छेद कृतहस्तवत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001941017, "chapter_id": 21941, "verse_number": "१२०-१८", "content_sanskrit": "अन्ये शरसहस्रेण शतेनान्ये नराधिपाः ।\nविव्यधुः कोष्ठकीकृत्य धर्मयुद्धपराङ्मुखाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001941018, "chapter_id": 21941, "verse_number": "१२०-१९", "content_sanskrit": "स विह्वलः पपातोर्व्यामेको बहुभिरर्दितः ।\nराजपुत्रा महाभागा बबन्धुस्ते च तं ततः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001941019, "chapter_id": 21941, "verse_number": "१२०-२०", "content_sanskrit": "तमधर्मेण ते सर्वे गृहीत्वा नृपतेः सुतम् ।\nविशालेन समं राज्ञा वैदिशं विविशुः परम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001941020, "chapter_id": 21941, "verse_number": "१२०-२१", "content_sanskrit": "हृष्टाः प्रमुदिता बद्धं समादाय नृपात्मजम् ।\nस्वयंवरा च सा कन्या न्यस्ता तेन ततः पुरः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001941021, "chapter_id": 21941, "verse_number": "१२०-२२", "content_sanskrit": "पुनः पुनश्च पित्रोक्ता तथापि च पुरोधसा ।\nआलम्ब्यतामिति वरो यस्ते राजसु रोचते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001941022, "chapter_id": 21941, "verse_number": "१२०-२३", "content_sanskrit": "यदा सा मानिनी कञ्चिन्न जग्राह वरं मुने ।\nतदा पप्रच्छ दैवज्ञं विवाहार्थं नरेश्वरः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001941023, "chapter_id": 21941, "verse_number": "१२०-२४", "content_sanskrit": "विशिष्टतरमेतस्या विवाहाय दिनं वद ।\nअद्यैतदीदृक्सञ्जातं युद्धं विघ्नोपपादकम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001941024, "chapter_id": 21941, "verse_number": "१२०-२५", "content_sanskrit": "मार्कण्डेय उवाच ।\nइति पृष्टो नरेन्द्रेण स दैवज्ञो विमृश्य तत् ।\nदुर्मनाः प्राह विज्ञातपरमार्थो महीपतिम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001941025, "chapter_id": 21941, "verse_number": "१२०-२६", "content_sanskrit": "भविष्यन्त्यपराणीह दिनानि पृथिवीपते ।\nप्रशस्तलग्नयुक्तानि शोभनान्यचिरेण वै ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001941026, "chapter_id": 21941, "verse_number": "१२०-२७", "content_sanskrit": "करिष्यसि विवाहं त्वं तेषु प्राप्तेषु मानद ।\nअलमेतेन यत्रायं महाविघ्न उपस्थितः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]