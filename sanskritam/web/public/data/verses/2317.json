[{"id": 2061671, "chapter_id": 2317, "verse_number": "८-३८-०x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2061672, "chapter_id": 2317, "verse_number": "८-३८-१", "content_sanskrit": "इति शल्य विजानीहि हन्त भूयो ब्रवीमि ते।\nउन्यमानं मया सम्यक्त्वमेकाग्रमनाः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2061673, "chapter_id": 2317, "verse_number": "८-३८-२", "content_sanskrit": "ब्राह्मणः किल नो गेहमध्यगच्छत्पुराऽतिथिः।\nआचारं तत्र सम्प्रेक्ष्य प्रीतो वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2061674, "chapter_id": 2317, "verse_number": "८-३८-३", "content_sanskrit": "मया हिमवतः शृङ्गमेकेनाध्युषितं चिरम्।\nदृष्टाश्च बहवो देशा नानाधर्मसमावृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2061675, "chapter_id": 2317, "verse_number": "८-३८-४", "content_sanskrit": "न च केन च धर्मेण विरुध्यन्ते प्रजा इमाः।\nसर्वाश्चाप्याचरन्धर्मं यदुक्तं वेदपारगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2061676, "chapter_id": 2317, "verse_number": "८-३८-५", "content_sanskrit": "अटता तु मया देशान्नानाधर्मसमाकुलान्।\nआगच्छता महाराज बाह्लीकेषु निशामितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2061677, "chapter_id": 2317, "verse_number": "८-३८-६", "content_sanskrit": "तत्र वै ब्राह्मणो भूत्वा पुनर्भवति क्षत्रियः।\nवैश्यः शूद्रश्च बाह्लीकस्ततो भवति नापितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2061678, "chapter_id": 2317, "verse_number": "८-३८-७", "content_sanskrit": "नापितश्च ततो भूत्वा पुनर्भवति ब्राह्मणः।\nद्विजो भूत्वा च तत्रैव पुनर्दासोऽभिजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2061679, "chapter_id": 2317, "verse_number": "८-३८-८", "content_sanskrit": "भवन्त्येककुले विप्राः शिष्टा ये कामचारिणः।\nगान्धारा मद्रकाश्चैव बाह्लीकाश्चाप्यतेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2061680, "chapter_id": 2317, "verse_number": "८-३८-९", "content_sanskrit": "एतन्मया श्रुतं तत्र धर्मसङ्करकारकम्।\nकृत्स्नामटित्वा पृथिवीं बाह्लीकेषु विपर्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2061681, "chapter_id": 2317, "verse_number": "८-३८-१०", "content_sanskrit": "इति शल्य विजानीहि हन्त भूयो ब्रवीमि ते।\nयदप्यन्योऽब्रवीद्वाक्यं बाह्लीकानां विकुत्सितं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2061682, "chapter_id": 2317, "verse_number": "८-३८-११", "content_sanskrit": "आनीयेहाक्षता काचिदारट्टात्किल दस्युभिः।\nअधर्मतश्चोपयाता सा तानभ्यशपत्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2061683, "chapter_id": 2317, "verse_number": "८-३८-१२", "content_sanskrit": "बालां बन्धुमतीं यन्मामधर्मेणोपगच्छथ।\nतस्मात्कुमार्यः स्वैरिण्यो भविष्यन्ति कुलेषु वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2061684, "chapter_id": 2317, "verse_number": "८-३८-१३", "content_sanskrit": "न चैवास्मात्प्रमोक्षध्वं घोराच्छापान्नराधमाः।\nतस्मात्तेषां भागहरः कथं धर्मान्वदिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2061685, "chapter_id": 2317, "verse_number": "८-३८-१४", "content_sanskrit": "कुरवः सहपाञ्चालाः साल्वा मात्स्याः सनैमिशाः।\nकोसलाः काशपौण्ड्राश्च कालिङ्गा मागधास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2061686, "chapter_id": 2317, "verse_number": "८-३८-१५", "content_sanskrit": "चेदयश्च महाभागा धर्मं जानन्ति शाश्वतम्।\nनानादेशेष्वसन्तश्च प्रायो बाह्यालयानृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2061687, "chapter_id": 2317, "verse_number": "८-३८-१६", "content_sanskrit": "आमत्स्येभ्यः कुरुपाञ्चालसाल्वा\nआनैमिशाच्चेदयो ये विशिष्टाः।\nधर्मं पुराणमुपजीवन्ति सन्तो\nमद्रानृते पाञ्चनदांश्च जिह्मान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2061688, "chapter_id": 2317, "verse_number": "८-३८-१७", "content_sanskrit": "एवं विद्वान्धर्मकथासु राजं--\nस्तूष्णींभूतः शल्य भवेः सदा त्वम्।\nत्वं तस्य गोप्ता च जनस्य राजा\nषड्भागहर्ता शुभदुष्कृतस्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2061689, "chapter_id": 2317, "verse_number": "८-३८-१८", "content_sanskrit": "अथवा दुष्कृतस्य त्वं हर्ता तेषामरक्षिता।\nरक्षिता पुण्यभाग्राजा प्रजानां त्वं ह्यपुण्यभाक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2061690, "chapter_id": 2317, "verse_number": "८-३८-१९", "content_sanskrit": "पूज्यमाने पुरा धर्मे सर्वदेशेषु शाश्वते।\nधर्मं पाञ्चनदं दृष्ट्वा धिगित्याह पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2061691, "chapter_id": 2317, "verse_number": "८-३८-२०", "content_sanskrit": "व्रात्यानां दाशकीयानां कृतेऽप्यशुभकर्मणाम्।\nब्रह्मणा निन्दितान्धर्मान्कश्चित्सिद्धात्मकोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2061692, "chapter_id": 2317, "verse_number": "८-३८-२१", "content_sanskrit": "इति पाञ्चनदं धर्मवमेने पितामहः।\nस्वधर्मस्थेषु वर्णेषु सोऽप्येतान्नाभ्यपूजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2061693, "chapter_id": 2317, "verse_number": "८-३८-२२", "content_sanskrit": "इति शल्य विजानीहि हन्त भूयो ब्रवीमि ते।\nकल्माषपादः सरसि निम़ज्जन्राक्षसोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2061694, "chapter_id": 2317, "verse_number": "८-३८-२३", "content_sanskrit": "क्षत्रियस्य मलं भैक्ष्यं ब्राह्मणस्याश्रुतं मलम्।\nमलं पृथिव्या बाह्लीकाः स्त्रीणां कौतूहलं मलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2061695, "chapter_id": 2317, "verse_number": "८-३८-२४", "content_sanskrit": "निमज्जमानमुद्धृत्य कश्चिद्राजा निशाचरम्।\nअपृच्छत्तेन चाख्यातं तच्छृणुष्व नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2061696, "chapter_id": 2317, "verse_number": "८-३८-२५", "content_sanskrit": "मानुषाणां मलं म्लेच्छा म्लेच्छानां मुष्टिका मलम्।\nमुष्टिकानां मलं षण्ढाः षण्ढानां राजयाजकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2061697, "chapter_id": 2317, "verse_number": "८-३८-२६", "content_sanskrit": "राजयाजकयाज्यानां मद्रकाणां च यन्मलम्।\nतद्भवेद्वै तव मलं यद्यस्मान्न विमुञ्चसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2061698, "chapter_id": 2317, "verse_number": "८-३८-२७", "content_sanskrit": "इति रक्षोपसृष्टेषु विषवीर्यहतेषु च।\nविद्वद्भिर्भेषजं दृष्टं संसिद्धवचनोत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2061699, "chapter_id": 2317, "verse_number": "८-३८-२८", "content_sanskrit": "ब्राहयाः पञ्चालाः कौरवेयास्तु धर्म्याः\nसत्या मत्स्याः शूरसेनाश्च याज्याः।\nप्राच्या दासा वृषला दाक्षिणात्याः\nस्तेना बाह्लीकाः सङ्कार वै सुराष्ट्राः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2061700, "chapter_id": 2317, "verse_number": "८-३८-२९", "content_sanskrit": "कृतघ्नता परवित्तापहारो\nमद्यपानं गुरुदारावमर्दः।\nवाक्पारुष्यं गोवधो रात्रिचर्या\nबहिर्गेहं परवस्त्रोपभोगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2061701, "chapter_id": 2317, "verse_number": "८-३८-३०", "content_sanskrit": "येषां धर्मस्तान्प्रति नास्त्यधर्मो\nह्यारट्टजान्पाञ्चनदान्धिगस्तु।\nआपाञ्चालाः कुरवो नैमिशाश्च\nमत्स्याश्चैवाप्यनुजानन्ति धर्मम्।\nअथोदीच्याश्चोदयो भागधाश्च\nशिष्टान्धर्मानुपजीवन्ति वृद्धाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2061702, "chapter_id": 2317, "verse_number": "८-३८-३१", "content_sanskrit": "प्राचीं दिशं श्रिता देवा जातवेदःपुरोगमाः।\nदक्षिणा पितृभिर्गुप्ता यमेन शुभकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2061703, "chapter_id": 2317, "verse_number": "८-३८-३२", "content_sanskrit": "प्रतीचीं वरुणः पाति पालयन्नसुरान्बहून्।\nउदीचीं भगवान्सोम ब्रह्मा च ब्राह्मणैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2061704, "chapter_id": 2317, "verse_number": "८-३८-३३", "content_sanskrit": "रक्षःपिशाचान्हिमवान्गुह्यकान्गन्धमादनः।\nध्रुवं सर्वाणि भूतानि विष्णुः पाति सुरोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2061705, "chapter_id": 2317, "verse_number": "८-३८-३४", "content_sanskrit": "इङ्गित५आश्च मगधाः प्रेक्षितज्ञाश्च कोसलाः।\nअर्धोक्ताः कुरुपाञ्चालाः सर्वोक्ता दाक्षिणापथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2061706, "chapter_id": 2317, "verse_number": "८-३८-३५", "content_sanskrit": "पार्वतीयाश्च विषया यथैव गिरयस्तथा।\nसर्वज्ञा यवना राजञ्शूराश्चैव विशेषतः।\nम्लेच्छाः स्वसंज्ञानियता नानुक्तमितरे जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2061707, "chapter_id": 2317, "verse_number": "८-३८-३६", "content_sanskrit": "प्रतिरब्धास्तु बाह्लीका न च केचन मद्रकाः।\nस त्वमेतादृशः शल्य नोत्तरं वक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2061708, "chapter_id": 2317, "verse_number": "८-३८-३७", "content_sanskrit": "एवं ज्ञात्वा जोषमास्स्व प्रतीपं\nमा स्म क्रुद्धः पापभृतां वरिष्ठ।\nपूर्वं हत्वा त्वां सपुत्रं बलैश्च\nपश्चाद्धंस्ये वासुदेवार्जुनौ च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2061709, "chapter_id": 2317, "verse_number": "८-३८-३८x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2061710, "chapter_id": 2317, "verse_number": "८-३८-३८", "content_sanskrit": "आतुराणां परित्यागः स्वदारसुतविक्रयः।\nअङ्गे प्रवर्तते कर्ण येषामधिपतिर्भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2061711, "chapter_id": 2317, "verse_number": "८-३८-३९", "content_sanskrit": "रथातिरथसङ्ख्यायां यत्त्वां भीष्मस्तदाब्रवीत्।\nतान्विदित्वाऽत्मनो दोषान्निर्मन्युर्भव मा क्रुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2061712, "chapter_id": 2317, "verse_number": "८-३८-४०", "content_sanskrit": "सर्वत्र ब्राह्मणाः सन्ति सन्ति सर्वत्र क्षत्रियाः।\nवैश्याः शूद्रास्तथा कर्ण स्त्रियः साध्व्यश्च सुव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2061713, "chapter_id": 2317, "verse_number": "८-३८-४१", "content_sanskrit": "रमन्ते चोपहासेन पुरुषाः पुरुषैः सह।\nअन्योन्येन रताः क्षीबा देशेदेशे च मैथुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2061714, "chapter_id": 2317, "verse_number": "८-३८-४२", "content_sanskrit": "परवाच्येषु निपुणः सर्वो भवति सर्वदा।\nआत्मवाच्यं न जानीते जानन्नपि च मुह्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2061715, "chapter_id": 2317, "verse_number": "८-३८-४३", "content_sanskrit": "सर्वत्र सन्ति राजनः स्वंस्वं धर्ममनुव्रताः।\nदुर्मनुष्यान्निगृह्णन्ति सन्ति सर्वत्र धार्मिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2061716, "chapter_id": 2317, "verse_number": "८-३८-४४", "content_sanskrit": "न कर्ण देशसामान्यात्सर्वः पापं निषेवते।\nयादृशाः स्वस्वभावेन देशांस्तांस्तादृशान्विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2061717, "chapter_id": 2317, "verse_number": "८-३८-४५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2061718, "chapter_id": 2317, "verse_number": "८-३८-४५", "content_sanskrit": "तततो दुर्योधनो राजा कर्णशल्याववारयत्।\nसखिभावेन राधेयं शल्यं सौजन्यकेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2061719, "chapter_id": 2317, "verse_number": "८-३८-४६", "content_sanskrit": "ततो निवारितः कर्णो धार्तराष्ट्रेण मारिष।\nप्हहस्य तत्र राजेन्द्रं यादि शल्येत्यचोदयत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2061720, "chapter_id": 2317, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि अष्टत्रिंशोऽध्यायः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]