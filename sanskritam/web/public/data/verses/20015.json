[{"id": 7000015000, "chapter_id": 20015, "verse_number": "१५-१", "content_sanskrit": "वृष्णिवंश-वर्णनम् लोमहर्षण उवाच क्रोष्टोरथाभवत् पुत्रो वृजिनीवान्महायशाः ।\nवार्जिनीवतमिच्छन्ति स्वाहिं स्वाहाकृतां वरम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000015001, "chapter_id": 20015, "verse_number": "१५-२", "content_sanskrit": "स्वाहिपुत्रोऽभवद्राजा उषद्गुर्वदतां वरः ।\nमहाक्रतुभिरीजे यो विविधैर्भूरिदक्षिणैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000015002, "chapter_id": 20015, "verse_number": "१५-३", "content_sanskrit": "ततः प्रसूतिमिच्छन् वै उषद्गुःसोऽग्य्रमात्मजम् ।\nजज्ञे चित्ररथस्तस्य पुत्रः कर्म्मभिरन्वितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000015003, "chapter_id": 20015, "verse_number": "१५-४", "content_sanskrit": "आसीच्चैत्ररथिर्वोरो यज्वा विपुलदक्षिमः ।\nशशविन्दुः परं वृत्तं राजर्षिणामनुष्ठितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000015004, "chapter_id": 20015, "verse_number": "१५-५", "content_sanskrit": "पृथुश्रवाः पृथुयशाः राजासीच्छाशविन्दवः ।\nशंसन्ति च पुराणज्ञाः पार्थश्रवसमन्तरम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000015005, "chapter_id": 20015, "verse_number": "१५-६", "content_sanskrit": "अन्तरस्य सुथज्ञस्तु सुयज्ञतनयोऽभवत् ।\nउषतो यज्ञमखिलं स्वधर्म्मे च कृतादरः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000015006, "chapter_id": 20015, "verse_number": "१५-७", "content_sanskrit": "शिनेयुरभवत् पुत्र उषतः शत्रुतापनः ।\nमरुतस्तस्य तनयो राजर्षिरभवन्नृपः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000015007, "chapter_id": 20015, "verse_number": "१५-८", "content_sanskrit": "मरुतोऽलभत ज्येष्ठं सुतं कम्बलबर्हिषम् ।\nचचार विपुलं धर्म्मममषति प्रत्यभागपि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000015008, "chapter_id": 20015, "verse_number": "१५-९", "content_sanskrit": "स सत्प्रसूतिमिच्छन् वै सुतं कम्बलबर्हिषः ।\nबभूव रुक्मकवचः शतप्रसवतः सुतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000015009, "chapter_id": 20015, "verse_number": "१५-१०", "content_sanskrit": "निहत्य रुक्मकवचः शतं कवचिनां रणे ।\nधन्विनां निशितैर्बाणैरवाप श्रियमुत्तमाम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000015010, "chapter_id": 20015, "verse_number": "१५-११", "content_sanskrit": "जज्ञे ज रुक्मकवचात् परिजित्परवीरहा ।\nजज्ञिरे पञ्च चपत्रास्तु महावीर्य्याः पराजिताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000015011, "chapter_id": 20015, "verse_number": "१५-१२", "content_sanskrit": "रुक्मेषुः पृथुरुक्मश्च ज्यामघः पालितो हरिः ।\nपातितं च हरिं चैव विदेहेभ्यः पिता ददौ ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000015012, "chapter_id": 20015, "verse_number": "१५-१३", "content_sanskrit": "रुक्मेषुरभवद्राजा पृथुर्क्मस्य संश्रयात् ।\nताभ्यां प्रव्राजितो राजा ज्यामघोऽवसदाश्रमे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000015013, "chapter_id": 20015, "verse_number": "१५-१४", "content_sanskrit": "प्रशान्तश्च तदा राजा ब्राह्मणैश्चावबोधितः ।\nजगाम धनुरादाय देशमन्यं ध्वजी रथी ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000015014, "chapter_id": 20015, "verse_number": "१५-१५", "content_sanskrit": "नर्म्मदाकूलमेकाकीमेकलां मृत्तिकावतीम् ।\nऋक्षवन्तं गिरिं जित्वा शुक्तिमत्यामुवास सः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000015015, "chapter_id": 20015, "verse_number": "१५-१६", "content_sanskrit": "ज्यामघस्याभवद्भार्य्या शैब्या बलवती सती ।\nअपुत्रोऽपि स राजा वै नान्यां भार्य्यामविन्दता ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000015016, "chapter_id": 20015, "verse_number": "१५-१७", "content_sanskrit": "तस्यासीद्विजयो युद्धे तत्र कन्यामवाप सः ।\nभार्य्यामुवाच सन्त्रस्तः स्नुषेति स जनेश्वरः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000015017, "chapter_id": 20015, "verse_number": "१५-१८", "content_sanskrit": "एतच्छ्रुत्वाब्रवीद्देवी कस्य देव स्नुषेति वै ।\nअब्रवीत्तदुपश्रुत्य ज्यामघो राजसतमः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000015018, "chapter_id": 20015, "verse_number": "१५-१९", "content_sanskrit": "राजोवाच यस्ते जनिष्यते पुत्रास्तस्य भार्य्यापपादिता ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000015019, "chapter_id": 20015, "verse_number": "१५-२०", "content_sanskrit": "उग्रेण तपसा तस्याः कन्यायाः सा व्यजायत ।\nपुत्रं विदर्भं सुभगा शैब्या परिणता सती ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000015020, "chapter_id": 20015, "verse_number": "१५-२१", "content_sanskrit": "राजपुत्र्यां तु विद्वांसौ स्नुषायां क्रथकैशिकौ ।\nपश्चाद्विदर्भोऽजनयच्छूरौ रणविशारवौ ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000015021, "chapter_id": 20015, "verse_number": "१५-२२", "content_sanskrit": "भीमो विदर्भस्य सुतः कुन्तिस्तस्यात्मजोऽभवत् ।\nकुन्तेर्धृष्टः सुतो जज्ञे रणधृष्टः प्रतापनवान् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000015022, "chapter_id": 20015, "verse_number": "१५-२३", "content_sanskrit": "घृष्टस्य जज्ञिरे शूरास्त्रयः परमधार्मिकाः ।\nआवन्तस्च दशार्हश्च बली विषहरश्च सः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000015023, "chapter_id": 20015, "verse_number": "१५-२४", "content_sanskrit": "दशार्हस्य सुतो व्योमा व्योम्नो जीमूत उच्यते ।\nजीमूतपुत्रो विकृतिस्तस्य भीमरथः स्मृतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000015024, "chapter_id": 20015, "verse_number": "१५-२५", "content_sanskrit": "अथ भीमरथस्यासीत् पुत्रो नवरथस्तथा ।\nतस्य चासीद्दशरथः शकुनिस्तस्य चात्मजः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000015025, "chapter_id": 20015, "verse_number": "१५-२६", "content_sanskrit": "तस्मात्करम्भः कारम्भिर्दैवरातोऽभवन्नृपः ।\nदेवक्षत्रोऽभवत्तस्य वृद्धक्षत्रो महायशाः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000015026, "chapter_id": 20015, "verse_number": "१५-२७", "content_sanskrit": "देवगर्भसमो जज्ञे देवक्षत्रस्य नन्दनः ।\nमधूनां वंशकृद्राजा मधुर्मधुरवागपि ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000015027, "chapter_id": 20015, "verse_number": "१५-२८", "content_sanskrit": "मधोर्जज्ञेऽथ वेदर्भ्यां पुरुद्वान्पुरुषोत्तमः ।\nऐक्ष्वाकी चाभवद्भार्य्या मधोस्तस्यां व्यजायत ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000015028, "chapter_id": 20015, "verse_number": "१५-२९", "content_sanskrit": "सत्त्वान् सर्व्वगुणोपेतः सात्वतां कीर्त्तिवर्द्धनः ।\nइमां विसृष्टिं विज्ञाय ज्यामघस्य महात्मनः ।\nयुज्यते परमप्रीत्या प्रजावांश्च भवेत् सदा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000015029, "chapter_id": 20015, "verse_number": "१५-३०", "content_sanskrit": "लोमहर्षण उवाच सत्त्वतः सत्त्वसम्पन्नान् कौशल्या सुषुवे सुतान् ।\nभागिनं भजमानं च दिव्यं देवावृधं नृपम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000015030, "chapter_id": 20015, "verse_number": "१५-३१", "content_sanskrit": "अन्धकं च महाबाहुं वृष्णिं च यदुनन्दनम् ।\nतेषां विसर्गाश्चत्वारो विस्तरेणेह कीर्त्तिताः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000015031, "chapter_id": 20015, "verse_number": "१५-३२", "content_sanskrit": "भजमानस्य सृञ्जय्यौ ब३ह्यकाथोपबाह्यका ।\nआस्तां भार्य्ये तयोस्तस्माज्जज्ञिरे बहवः सुताः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000015032, "chapter_id": 20015, "verse_number": "१५-३३", "content_sanskrit": "क्रिमिश्च क्रमणश्चैव धृष्टः शूरः पुरञ्जयः ।\nएते बाह्यकमृञ्जय्यां भजमानाद्विजज्ञिरे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000015033, "chapter_id": 20015, "verse_number": "१५-३४", "content_sanskrit": "अयुताजित् सहस्राजिच्छताजित्त्वथ दासकः ।\nउपबाह्यकसृञ्जय्यां भजमानद्विजज्ञिरे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000015034, "chapter_id": 20015, "verse_number": "१५-३५", "content_sanskrit": "यज्वा देवावृधो राजा चचार विपुलं तपः ।\nपुत्रः सर्व्वगुणोपेतो मम स्यादिति निश्चितः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000015035, "chapter_id": 20015, "verse_number": "१५-३६", "content_sanskrit": "संयुज्यमानस्तपसा पर्णाशाया जलं स्पृशन् ।\nसदोपस्पृशतस्तस्य चकार प्रियमापगा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000015036, "chapter_id": 20015, "verse_number": "१५-३७", "content_sanskrit": "चिन्तयाभिपरीता सा न जगामैव निश्चयम् ।\nकल्याणत्वान्नरपतेस्तस्य सा निम्नगोत्तममा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000015037, "chapter_id": 20015, "verse_number": "१५-३८", "content_sanskrit": "नाध्यगच्छत्तु तां नारीं यस्यामेवंविधः सुतः ।\nभवेत्तस्मात् स्वयं गत्वा भवाम्यस्य सहानुगा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000015038, "chapter_id": 20015, "verse_number": "१५-३९", "content_sanskrit": "अथ भूत्वा कुमारी सा बिभ्रती परमं वपुः ।\nवरयामास नृपतिं तामियेष च स प्रभुः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000015039, "chapter_id": 20015, "verse_number": "१५-४०", "content_sanskrit": "तस्यामाधत्त गर्भं स तेजस्विनमुदारधीः ।\nअथ सा दशमे मासि सुषुवे सरितां वरा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000015040, "chapter_id": 20015, "verse_number": "१५-४१", "content_sanskrit": "पुत्रं सर्व्वगुणोपेतंम बभ्रुं देवावृधं द्विजाः ।\nअत्र वंशे पुराणज्ञा गायन्तीति परिश्रुतम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000015041, "chapter_id": 20015, "verse_number": "१५-४२", "content_sanskrit": "गुणान् देवावृधस्यापि कीर्त्तयन्तो महात्मनः ।\nयथैवाग्रे तथा दूरात्पश्यामस्तावदन्तिकात् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000015042, "chapter_id": 20015, "verse_number": "१५-४३", "content_sanskrit": "बभ्रुः श्रेष्ठो मनुष्याणां देवैर्देवावृधः समः ।\nषष्टिस्च षट् च पुरुषाः सहस्राणि च सप्त च  ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000015043, "chapter_id": 20015, "verse_number": "१५-४४", "content_sanskrit": "एतेऽमृतत्वं प्राप्ता वै बभ्रोर्देवावृधादपि ।\nयज्जा दानपतिर्धीमान् ब्रह्मण्यः सुदृढायुधः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000015044, "chapter_id": 20015, "verse_number": "१५-४५", "content_sanskrit": "तस्यान्ववायः सुमहान्भोजा ये सार्त्तिकावताः ।\nअन्धकात्काश्यदुहिता चतुरोऽलभतात्मजान् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000015045, "chapter_id": 20015, "verse_number": "१५-४६", "content_sanskrit": "कुकुरं भजमानं च ससकं बलबर्हिषम् ।\nकुकुरस्य सुतो वृष्टिर्वृष्टेस्तु तनयस्तथा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000015046, "chapter_id": 20015, "verse_number": "१५-४७", "content_sanskrit": "कपोतरोमा तस्याथ तिलिरिस्तनयोऽभवत् ।\nजज्ञे पुनर्व्वसुस्तस्मादभिजिच्च पुनर्व्वसोः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000015047, "chapter_id": 20015, "verse_number": "१५-४८", "content_sanskrit": "तथा वै पुत्रमिथुनं बभूवाभिजितः किल ।\nआहुकझ श्राहुकश्चैव ख्यातौ ख्यातिमतां वरौ ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000015048, "chapter_id": 20015, "verse_number": "१५-४९", "content_sanskrit": "इमां चोदाहरन्त्यत्र गाथां प्रति तमाहुकम् ।\nश्वेतेन पिरवारेण किशोरप्रतिमो महान् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000015049, "chapter_id": 20015, "verse_number": "१५-५०", "content_sanskrit": "अशीतिवर्म्मणा युक्ता आहुकः प्रथमं व्रजेत् ।\nनापुत्रवान्नाशतदो नासहस्रशतायुषः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000015050, "chapter_id": 20015, "verse_number": "१५-५१", "content_sanskrit": "नाशुद्धकर्म्मा नायज्वा यो भोजमभितो व्रजेत् ।\nपूर्व्वस्यां दिशि नागानां भोजस्य प्रययुः किल ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000015051, "chapter_id": 20015, "verse_number": "१५-५२", "content_sanskrit": "सोमात्सङ्गानुकर्षाणां ध्वजिनां सवरूथिनाम ।\nरथानां मेघघोषाणां सहस्राणि दशैव तु ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000015052, "chapter_id": 20015, "verse_number": "१५-५३", "content_sanskrit": "रौप्यकाञ्चनकक्षाणां सहस्राण्येकविंशतिः ।\nतावत्येव सहस्राणि उत्तरस्यां तथा दिशि ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000015053, "chapter_id": 20015, "verse_number": "१५-५४", "content_sanskrit": "आभूमिपाला भोजास्तु सन्ति ज्याकिङ्किणीकिनः ।\nआहुः किं चाप्यवन्तिभ्यः स्वासारं ददुरन्धकाः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000015054, "chapter_id": 20015, "verse_number": "१५-५५", "content_sanskrit": "आहुकस्य तु काश्यायां द्वौ पुत्रौ सम्बभूवतुः ।\nदेवकश्चोग्रसेनश्च देवगर्भसमावुभौ ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000015055, "chapter_id": 20015, "verse_number": "१५-५६", "content_sanskrit": "देवकस्याभवन् पुत्राश्चत्वारस्त्रिदशोपमाः ।\nदेववानुपदेवश्च संदेवो देवरक्षितः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000015056, "chapter_id": 20015, "verse_number": "१५-५७", "content_sanskrit": "कुमार्य्यः सप्त चास्याथ वसुदेवाय ता ददौ ।\nदेकी शान्तिदेवा च सुदेवा देवरक्षिता ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000015057, "chapter_id": 20015, "verse_number": "१५-५८", "content_sanskrit": "वृकदेव्युपदेवी च सुनाम्नी चैव सप्तमी ।\nनवोग्रसेनस्य सुतास्तेषां कंसस्तु पूर्व्वजः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000015058, "chapter_id": 20015, "verse_number": "१५-५९", "content_sanskrit": "न्यग्रोधश्च सुनामा च तथा कङ्कः सुभूषणः ।\nराष्ट्रपालोऽथ सुतनुरनावृष्टिस्तु पुष्टिमान् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000015059, "chapter_id": 20015, "verse_number": "१५-६०", "content_sanskrit": "तेषां स्वसारः पञ्चासन् कंसा कंसवती तथा ।\nसुतन् राष्टपाली च कङ्ता चैव वराङ्गना ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000015060, "chapter_id": 20015, "verse_number": "१५-६१", "content_sanskrit": "उग्रसेनः सहापत्यो व्याख्यातः कुकुरोद्भवः ।\nकुकुराणामिमं वंशं धारयन्नमितौजसाम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000015061, "chapter_id": 20015, "verse_number": "१५-६२", "content_sanskrit": "आत्मनो विपुलं वंशं प्रजावानाप्नुयान्नरः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]