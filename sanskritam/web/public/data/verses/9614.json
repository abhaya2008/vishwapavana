[{"id": 5000614000, "chapter_id": 9614, "verse_number": "७-७९-१", "content_sanskrit": "तदद्भुततमं वाक्यं श्रुत्वागस्त्यस्य राघवः ।\nगौरवाद्विस्मयाच्चैव पुनः प्रष्टुं प्रचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000614001, "chapter_id": 9614, "verse_number": "७-७९-२", "content_sanskrit": "भगवंस्तद्वनं घोरं तपस्तप्यति यत्र सः ।\nश्वेतो वैदर्भको राजा कथं स्यादमृगद्विजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000614002, "chapter_id": 9614, "verse_number": "७-७९-३", "content_sanskrit": "तद्वनं स कथ राजा शून्यं मनुजवर्जितम् ।\nतपश्चर्तुं प्रविष्टः स श्रोतुमिच्छामि तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000614003, "chapter_id": 9614, "verse_number": "७-७९-४", "content_sanskrit": "रामस्य वचनं श्रुत्वा कौतूहलसमन्वितम् ।\nवाक्यं परमतेजस्वी वक्तुमेवोपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000614004, "chapter_id": 9614, "verse_number": "७-७९-५", "content_sanskrit": "पुरा कृतयुगे राम मनुर्दण्डधरः प्रभुः ।\nतस्य पुत्रो महानासीदिक्ष्वाकुः कुलनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000614005, "chapter_id": 9614, "verse_number": "७-७९-६", "content_sanskrit": "तं पुत्रं पूर्वंकं राज्ये निक्षिप्य भुवि दुर्जयम् ।\nपृथिव्यां राजवंशानां भव कर्तेत्युवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000614006, "chapter_id": 9614, "verse_number": "७-७९-७", "content_sanskrit": "तथैवेति प्रतिज्ञातं पितुः पुत्रेण राघव ।\nततः परमसन्तुष्टो मनुः पुत्रमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000614007, "chapter_id": 9614, "verse_number": "७-७९-८", "content_sanskrit": "प्रीतो ऽस्मि परमोदार त्वं कर्ता ऽसि न संशयः ।\nदण्डेन च प्रजा रक्ष मा च दण्डमकारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000614008, "chapter_id": 9614, "verse_number": "७-७९-९", "content_sanskrit": "अपराधिषु यो दण्डः पात्यते मानवेषु वै ।\nस दण्डो विधिवन्मुक्तः स्वर्गं नयति पार्थिवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000614009, "chapter_id": 9614, "verse_number": "७-७९-१०", "content_sanskrit": "तस्माद्दण्डे महाबाहो यत्नवान्भव पुत्रक ।\nधर्मो हि परमो लोके कुर्वतस्ते भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000614010, "chapter_id": 9614, "verse_number": "७-७९-११", "content_sanskrit": "इति तं बहु सन्दिश्य मनुः पुत्रं समाधिना ।\nजगाम त्रिदिवं हृष्टो ब्रह्मलोकं सनातनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000614011, "chapter_id": 9614, "verse_number": "७-७९-१२", "content_sanskrit": "प्रयाते त्रिदिवं तस्मिन्निक्ष्वाकुरमितप्रभः ।\nजनयिष्ये कथं पुत्रानिति चिन्तापरो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000614012, "chapter_id": 9614, "verse_number": "७-७९-१३", "content_sanskrit": "कर्मभिर्बहुरूपैश्च तैस्तैर्मनुसुतस्सुतान् ।\nजनयामास धर्मात्मा शतं देवसुतोपमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000614013, "chapter_id": 9614, "verse_number": "७-७९-१४", "content_sanskrit": "तेषामवरजस्तात सर्वेषां रघुनन्दन ।\nमूढश्चाकृतविद्यश्च न शुश्रूषति पूर्वजान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000614014, "chapter_id": 9614, "verse_number": "७-७९-१५", "content_sanskrit": "नाम तस्य च दण्डेति पिता चक्रे ऽल्पमेधसः ।\nअवश्यं दण्डपतनं शरीरे ऽस्य भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000614015, "chapter_id": 9614, "verse_number": "७-७९-१६", "content_sanskrit": "अपश्यमानस्तं देशं घोरं पुत्रस्य राघव ।\nविन्ध्यशैवलयोर्मध्ये राज्यं प्रादादरिन्दम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000614016, "chapter_id": 9614, "verse_number": "७-७९-१७", "content_sanskrit": "स दण्डस्तत्र राजाभूद्रम्ये पर्वतरोधसि ।\nपुरं चाप्रतिमं राम न्यवेशयदनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000614017, "chapter_id": 9614, "verse_number": "७-७९-१८", "content_sanskrit": "पुरस्य चाकरोन्नाम मधुमन्तमिति प्रभो ।\nपुरोहितं तूशनसं वरयामास सुव्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000614018, "chapter_id": 9614, "verse_number": "७-७९-१९", "content_sanskrit": "एवं स राजा तद्राज्यमकरोत्सपुरोहितः ।\nप्रहृष्टमनुजाकीर्णं देवराजं यथा वृषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000614019, "chapter_id": 9614, "verse_number": "७-७९-२०", "content_sanskrit": "ततः स राजा मनुजेन्द्रपुत्रः सार्धं च तेनोशनसा तदानीम् ।\nचकार राज्यं सुमहान्महात्मा शक्रो दिवीवोशनसा समेतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000614020, "chapter_id": 9614, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे एकोनशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]