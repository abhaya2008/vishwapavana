[{"id": 40016746, "chapter_id": 9253, "verse_number": "1", "content_sanskrit": "स तथोक्तस्तुनिर्भर्त्स्यकुम्भकर्णोमहोदरम् । अब्रवीद्राक्षसश्रेष्ठंभ्रातरंरावणंततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40016747, "chapter_id": 9253, "verse_number": "2", "content_sanskrit": "सोऽहंतवभयंघोरंवधात्तस्यदुरात्मनः । रामस्याद्यप्रमार्जामिनिर्वैरोहिसुखीभव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40016748, "chapter_id": 9253, "verse_number": "3", "content_sanskrit": "गर्जन्ति न वृथाशूरानिर्जलाइवतोयदाः । पश्यसम्पद्यमानंतुगर्जितंयुधिकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40016749, "chapter_id": 9253, "verse_number": "4", "content_sanskrit": "न मर्षयन्तिचात्मानंसम्भावयतिनात्मना । अदर्शयित्वाशूरास्तुकर्मकुर्वन्तिदुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40016750, "chapter_id": 9253, "verse_number": "5", "content_sanskrit": "विक्लबानामबुद्धीनांराज्ञापण्डितमानिनाम् । श्रृण्वतासदितमिदंत्वाद्विधानांमहोदर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40016751, "chapter_id": 9253, "verse_number": "6", "content_sanskrit": "युद्धेकापुरुषैर्नित्यंभवद्भिःप्रियवादिभि: । राजानमनुगच्छद्भिःसर्वंकृत्यमोद्धिसादितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40016752, "chapter_id": 9253, "verse_number": "7", "content_sanskrit": "राजशेषाकृतालङ्काक्षीणःकोशोबलंहतम् । राजानमिममासाद्यसुहृचचिह्नममित्रकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40016753, "chapter_id": 9253, "verse_number": "8", "content_sanskrit": "एषनिर्याम्यहंयुद्धमुद्यतश्शत्रुनिर्जये । दुर्नयंभवतामद्यसमीकर्तुंमिहाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40016754, "chapter_id": 9253, "verse_number": "9", "content_sanskrit": "एवमुक्तवतोवाक्यंकुम्भकर्णस्यधीमतः । प्रत्युवाचततोवाक्यंप्रहसन्राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40016755, "chapter_id": 9253, "verse_number": "10", "content_sanskrit": "महोदरोऽयंरामात्तुपरित्रस्तो न संशयः । न हिरोचयतेतात युद्धंयुद्धविशारद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40016756, "chapter_id": 9253, "verse_number": "11", "content_sanskrit": "कश्चिन्मेत्वत्समोनास्तिसौहृदेनबलेन च । गच्छशत्रुवधायत्वंकुम्भकर्णजयाय च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40016757, "chapter_id": 9253, "verse_number": "12", "content_sanskrit": "तस्मात्तुशत्रुनाशार्थंभवान्सम्बोधितोमया । अयंहिकालस्सुहृदांराक्षसानामरिन्दम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40016758, "chapter_id": 9253, "verse_number": "13", "content_sanskrit": "तद्गच्छशूलमादायपाशहस्तइवान्तकः । वानरान्राजपुत्रौ च भक्ष्यादित्यतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40016759, "chapter_id": 9253, "verse_number": "14", "content_sanskrit": "समालोक्यतुतेरूपंविद्रविष्यन्तिवानराः । रामलक्ष्मणयोश्चापिहृदयेप्रस्फुटिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40016760, "chapter_id": 9253, "verse_number": "15", "content_sanskrit": "एवमुक्त्वामहातेजाःकुम्भकर्णंमहाबलम् । पुनर्जातमिवात्मानंमेनेराक्षसपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40016761, "chapter_id": 9253, "verse_number": "16", "content_sanskrit": "कुम्भकर्णबलाभिज्ञोजानंस्तस्यपराक्रमम् । बभूवमुदितोराजाशशाङ्कइवनिर्मलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40016762, "chapter_id": 9253, "verse_number": "17", "content_sanskrit": "इत्येवमुक्तःसम्हृष्टोनिर्जगाममहाबलः । राज्ञस्तुवचनंश्रुत्वाकुम्भकर्णस्समुद्यत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40016763, "chapter_id": 9253, "verse_number": "18", "content_sanskrit": "आददेनिशितंशूलंवेगाच्छत्रुनिबर्हणम् । सर्वकालायसंदीप्तंतप्तकाञ्चनभूषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40016764, "chapter_id": 9253, "verse_number": "19", "content_sanskrit": "इन्द्राशनिसमंभीमंवज्रप्रतिमगौरवम् । देवदानवगन्धर्वयक्षपन्नगसूदनम् ॥ रक्तमाल्यंमहाधामंस्वतश्चोद्गतपावकम् । आदायनिशितंशूलंशत्रुशोणितरञ्जितम् ॥ कुम्भकर्णोमहातेजारावणंवाक्यमब्रवीत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40016765, "chapter_id": 9253, "verse_number": "20", "content_sanskrit": "इन्द्राशनिसमंभीमंवज्रप्रतिमगौरवम् । देवदानवगन्धर्वयक्षपन्नगसूदनम् ॥ रक्तमाल्यंमहाधामंस्वतश्चोद्गतपावकम् । आदायनिशितंशूलंशत्रुशोणितरञ्जितम् ॥ कुम्भकर्णोमहातेजारावणंवाक्यमब्रवीत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40016766, "chapter_id": 9253, "verse_number": "21", "content_sanskrit": "गमिष्याम्यहमेकाकीतिष्ठत्विहबलंमम ॥ अद्यतान् क्षुभितान् क्रुद्धोभक्षयिष्यामिवानरान् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40016767, "chapter_id": 9253, "verse_number": "22", "content_sanskrit": "कुम्भकर्णवचश्श्रुत्वारावणोवाक्यमब्रवीत् ॥ सैन्यैःपरिवृतोगच्छशूलमुद्गतपाणिभिः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40016768, "chapter_id": 9253, "verse_number": "23", "content_sanskrit": "वानराहिमहात्मानश्शीघ्रास्सव्यवसायिनः ॥ एकाकिनंप्रमत्तंवानयेयुद्धशनैःक्ष्यम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40016769, "chapter_id": 9253, "verse_number": "24", "content_sanskrit": "तस्मात्परमदुर्धर्षै: सैन्यैःपरिवृतोव्रज ॥ रक्षसामहितंसर्वंशत्रुपक्षंनिषूदय ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40016770, "chapter_id": 9253, "verse_number": "25", "content_sanskrit": "अथासनात्समुत्पत्यस्रजं मणिकृतान्तराम् ॥ आबबन्धमहातेजाःकुम्भकर्णस्यरावणः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40016771, "chapter_id": 9253, "verse_number": "26", "content_sanskrit": "अङ्गदान्यङ्गुलीवेष्टान्वराण्याभरणानि च ॥ हारं च श्शिसङ्काशमाबबन्दमहात्मनः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40016772, "chapter_id": 9253, "verse_number": "27", "content_sanskrit": "दिव्यानि च सुगन्धीनिमाल्यदामानिरावणः ॥ श्रोत्रिचासञ्जयामासश्रीमतीचास्यकुण्डले ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40016773, "chapter_id": 9253, "verse_number": "28", "content_sanskrit": "काञ्चनाङ्गदकेयूरोनिष्काभरणभूषितः ॥ कुम्भकर्णोबृहत्कर्णस्सुहुतोऽग्निरिवाबभौ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40016774, "chapter_id": 9253, "verse_number": "29", "content_sanskrit": "श्रोणीसूत्रेणमहतामेचकेनव्यराजत ॥ अमृतोत्पादनेनद्धोभुजङ्गेनेवमन्दरः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40016775, "chapter_id": 9253, "verse_number": "30", "content_sanskrit": "स काञ्चनंभारसहंनिवातंविद्युत्प्रभंदीप्तमिवात्मभासा । आबध्यमानःकवचंरराजसन्ध्याभ्रसम्वीतराजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40016776, "chapter_id": 9253, "verse_number": "31", "content_sanskrit": "सर्वाभरणसर्वाङ्गश्शूलपाणिस्सराक्षसः । त्रिविक्रमकृतोत्साहोनारायणइवाबभौ ॥ भ्रातरंसम्परिष्वज्यकृत्वाचापिप्रदक्षिणम् । प्रणम्यशिरसातस्मैसम्प्रतस्थेमहाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40016777, "chapter_id": 9253, "verse_number": "32", "content_sanskrit": "सर्वाभरणसर्वाङ्गश्शूलपाणिस्सराक्षसः । त्रिविक्रमकृतोत्साहोनारायणइवाबभौ ॥ भ्रातरंसम्परिष्वज्यकृत्वाचापिप्रदक्षिणम् । प्रणम्यशिरसातस्मैसम्प्रतस्थेमहाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40016778, "chapter_id": 9253, "verse_number": "33", "content_sanskrit": "निष्पतन्तंमहाकायंमहानादंमहाबलम् । तमाशीर्भिःप्रशस्ताभिःप्रेषयामासरावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40016779, "chapter_id": 9253, "verse_number": "34", "content_sanskrit": "शङ्खदुन्दुभिनिर्घोषैस्सैन्यैश्चापिवरायुथैः । तंगजैश्चतुरङ्गैश्चस्यन्दनैश्चाम्बुदस्वनैः ॥ अनुजग्मुर्महात्मानं रथिनो रथिनां वरम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40016780, "chapter_id": 9253, "verse_number": "35", "content_sanskrit": "सर्पैरुष्ट्रैःखरैरश्वैस्सिम्हद्विपमृगद्विजैः । अनुजग्मुश्चतंघोरंकुम्भकर्णंमहाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40016781, "chapter_id": 9253, "verse_number": "36", "content_sanskrit": "स पुष्पवर्षैरवकीर्यमाणोधृतातपत्रःशितशूलपाणिः । मदोत्कटःशोणितगन्धमत्तोविनिर्ययौदावनदेवशत्रुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40016782, "chapter_id": 9253, "verse_number": "37", "content_sanskrit": "पदातयश्चबहवोमहानादामहाबलाः । अन्वयूराक्षसाभीमाभीमाक्षाश्शस्त्रपाणयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40016783, "chapter_id": 9253, "verse_number": "38", "content_sanskrit": "रक्ताक्षास्सुमहाकायानीलाञ्चनचयोपमाः । शूलानुद्यम्यखडगांश्चनिशितांश्चपरश्वधान् ॥ बहुव्यामांश्चपरिघान्गदाश्चमुसलानि च । तालस्कन्धांश्चविपुलान्क्षेपणीयान्दुरासदान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40016784, "chapter_id": 9253, "verse_number": "39", "content_sanskrit": "रक्ताक्षास्सुमहाकायानीलाञ्चनचयोपमाः । शूलानुद्यम्यखडगांश्चनिशितांश्चपरश्वधान् ॥ बहुव्यामांश्चपरिघान्गदाश्चमुसलानि च । तालस्कन्धांश्चविपुलान्क्षेपणीयान्दुरासदान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40016785, "chapter_id": 9253, "verse_number": "40", "content_sanskrit": "अथान्यद्वपुरादायदारुणंरोमहर्षणम् । निष्पपातमहातेजाःकुम्भकर्णोमहाबलः ॥ धनुःशतपरीणाहः स षट्छत्रसमुच्छ्रितः । रौद्रःशकटचक्राक्षोमहापर्वतसन्निभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40016786, "chapter_id": 9253, "verse_number": "41", "content_sanskrit": "अथान्यद्वपुरादायदारुणंरोमहर्षणम् । निष्पपातमहातेजाःकुम्भकर्णोमहाबलः ॥ धनुःशतपरीणाहः स षट्छत्रसमुच्छ्रितः । रौद्रःशकटचक्राक्षोमहापर्वतसन्निभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40016787, "chapter_id": 9253, "verse_number": "42", "content_sanskrit": "सन्निपत्य च रक्षांसिदग्धशैलोपमामहान् । कुम्भकर्णोमहावक्त्रःप्रहसन्निदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40016788, "chapter_id": 9253, "verse_number": "43", "content_sanskrit": "अद्यवानरमुख्यानांतानियूथानिभागश । निर्दहिष्यामिसङ्ख्रुद्धश्शलाभानिवपावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40016789, "chapter_id": 9253, "verse_number": "44", "content_sanskrit": "नापराध्यन्तिमेकामंवानरा: वनचारिणः । जातिरस्मद्विधानांसापुरोद्यानविभूषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40016790, "chapter_id": 9253, "verse_number": "45", "content_sanskrit": "पुररोधस्यमूलंतुराघवस्सहलक्ष्मणः । हतेतस्मिन् हतंसर्वंतंवधिष्यामिसंयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40016791, "chapter_id": 9253, "verse_number": "46", "content_sanskrit": "एवंतस्यब्रुवाणस्यकुम्भकर्णस्यराक्षसाः । नादंचक्रुर्महाघोरंकम्पयन्तइवार्णवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40016792, "chapter_id": 9253, "verse_number": "47", "content_sanskrit": "तस्यनिष्पततस्तूर्णंकुम्भकर्णस्यधीमतः । बभूवुर्घोररूपाणिनिमित्तानिसमन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40016793, "chapter_id": 9253, "verse_number": "48", "content_sanskrit": "उल्काशनियुतामेघाबभूवुर्गर्धभारुणाः । ससागरवनाचैववसुधासमकम्पत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40016794, "chapter_id": 9253, "verse_number": "49", "content_sanskrit": "घोररूपाश्शिवानेदुस्सज्वालकबलैर्मुखैः । मण्डलान्यपसव्यानिबबन्धुश्चविहङ्गमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40016795, "chapter_id": 9253, "verse_number": "50", "content_sanskrit": "निष्पपात च गृध्रोमालेवाऽस्यपथिगच्छतः । प्रास्फुरन्नयनंचास्यसव्योबाहुश्चकम्पत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 40016796, "chapter_id": 9253, "verse_number": "51", "content_sanskrit": "निष्पपाततदाचोल्काज्वलन्तीभीमनिश्श्वना । आदित्योनिष्प्रभश्चासीन्नप्रवाति च ऽनिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 40016797, "chapter_id": 9253, "verse_number": "52", "content_sanskrit": "अचिन्तयन्महोत्पातानुदितान्रोमहर्षणान् । निर्ययौकुम्भकर्णस्तुकृतान्तबलचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 40016798, "chapter_id": 9253, "verse_number": "53", "content_sanskrit": "न लङ्घयित्वाप्राकारंपद्भ्यांपर्वतसन्निभः । ददर्शाभ्रघनप्रख्यंवानरानीकमद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 40016799, "chapter_id": 9253, "verse_number": "54", "content_sanskrit": "तेदृष्टवाराक्षसश्रेष्ठंवानराःपर्वतोपमम् । वायुनुन्नाइवघनाययुस्सर्वादिशस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 40016800, "chapter_id": 9253, "verse_number": "55", "content_sanskrit": "तद्वानरानीकमतिप्रचण्डंदिशोद्रवद्भिन्नमवाभ्रजालम् । स कुम्भकर्णस्समवेक्ष्यहर्षान्ननादभूयोघनवद्घनाभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 40016801, "chapter_id": 9253, "verse_number": "56", "content_sanskrit": "तेतस्यघोरंनिनदंनिशम्ययथानिनादंदिविवारिदस्य । पेतुर्धरण्यांबहवःप्लवङ्गानिकृत्तमूलाइवशालवृक्षाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 40016802, "chapter_id": 9253, "verse_number": "57", "content_sanskrit": "विपुलपरिघवान् स कुम्भकर्णोरिपुनिधनायविनिस्पृतोत्मा । कपिषणभयमाददत्सुभीमंप्रभुरिवदण्डवान्युगान्ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]