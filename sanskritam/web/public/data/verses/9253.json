[{"id": 5000253000, "chapter_id": 9253, "verse_number": "३-५६अ-१", "content_sanskrit": "प्रवेशितायां सीतायां लङ्कां प्रति पितामहः।\nतदा प्रोवाच देवेन्द्रं परितुष्टं शतक्रतुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000253001, "chapter_id": 9253, "verse_number": "३-५६अ-२", "content_sanskrit": "त्रैलोक्यस्य हितार्थाय रक्षसामहिताय च।\nलङ्कां प्रवेशिता सीता रावणेन दुरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000253002, "chapter_id": 9253, "verse_number": "३-५६अ-३", "content_sanskrit": "पतिव्रता महाभागा नित्यं चैव सुखैधिता।\nअपश्यन्ती च भर्तारं पश्यन्ती राक्षसीजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000253003, "chapter_id": 9253, "verse_number": "३-५६अ-४", "content_sanskrit": "राक्षसीभिः परिवृता भर्तृदर्शनलालसा।\nनिविष्टा हि पुरी लङ्का तीरे नदनदीपतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000253004, "chapter_id": 9253, "verse_number": "३-५६अ-५", "content_sanskrit": "कथं ज्ञास्यति तां रामस्तत्रस्थां तामनिन्दिताम्।\nदुःखं संचिन्तयन्ती सा बहुशः परिदुर्लभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000253005, "chapter_id": 9253, "verse_number": "३-५६अ-६", "content_sanskrit": "प्राणयात्रामकुर्वाणा प्राणांस्त्यक्ष्यत्यसंशयम्।\nस भूयः संशयो जातः सीतायाः प्राणसंक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000253006, "chapter_id": 9253, "verse_number": "३-५६अ-७", "content_sanskrit": "स त्वं शीघ्रमितो गत्वा सीतां पश्य शुभाननाम्।\nप्रविश्य नगरीं लङ्कां प्रयच्छ हविरुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000253007, "chapter_id": 9253, "verse_number": "३-५६अ-८", "content_sanskrit": "एवमुक्तोऽथ देवेन्द्रः पुरीं रावणपालिताम्।\nआगच्छन्निद्रया सार्धं भगवान् पाकशासनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000253008, "chapter_id": 9253, "verse_number": "३-५६अ-९", "content_sanskrit": "निद्रां चोवाच गच्छ त्वं राक्षसान् सम्प्रमोहय।\nसा तथोक्ता मघवता देवी परमहर्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000253009, "chapter_id": 9253, "verse_number": "३-५६अ-१०", "content_sanskrit": "देवकार्यार्थसिद्ध्यर्थं प्रामोहयत राक्षसान्।\nएतस्मिन्नन्तरे देवः सहस्राक्षः शचीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000253010, "chapter_id": 9253, "verse_number": "३-५६अ-११", "content_sanskrit": "आससाद वनस्थां तां वचनं चेदमब्रवीत्।\nदेवराजोऽस्मि भद्रं ते इह चास्मि शुचिस्मिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000253011, "chapter_id": 9253, "verse_number": "३-५६अ-१२", "content_sanskrit": "अहं त्वां कार्यसिद्‍ध्यर्थं राघवस्य महात्मनः।\nसाहाय्यं कल्पयिष्यामि मा शुचो जनकात्मजे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000253012, "chapter_id": 9253, "verse_number": "३-५६अ-१३", "content_sanskrit": "मत्प्रसादात् समुद्रं स तरिष्यति बलैः सह।\nमयैवेह च राक्षस्यो मायया मोहिताः शुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000253013, "chapter_id": 9253, "verse_number": "३-५६अ-१४", "content_sanskrit": "तस्मादन्नमिदं सीते हविष्यान्नमहं स्वयम्।\nस त्वां संगृह्य वैदेहि आगतः सह निद्रया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000253014, "chapter_id": 9253, "verse_number": "३-५६अ-१५", "content_sanskrit": "एतदत्स्यसि मद्धस्तान्न त्वां बाधिष्यते शुभे।\nक्षुधा तृषा च रम्भोरु वर्षाणामयुतैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000253015, "chapter_id": 9253, "verse_number": "३-५६अ-१६", "content_sanskrit": "एवमुक्ता तु देवेन्द्रमुवाच परिशङ्किता।\nकथं जानामि देवेन्द्रं त्वामिहस्थं शचीपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000253016, "chapter_id": 9253, "verse_number": "३-५६अ-१७", "content_sanskrit": "देवलिङ्गानि दृष्टानि रामलक्ष्मणसंनिधौ।\nतानि दर्शय देवेन्द्र यदि त्वं देवराट् स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000253017, "chapter_id": 9253, "verse_number": "३-५६अ-१८", "content_sanskrit": "सीताया वचनं श्रुत्वा तथा चक्रे शचीपतिः।\nपृथिवीं नास्पृशत् पद‍्भ्यामनिमेषेक्षणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000253018, "chapter_id": 9253, "verse_number": "३-५६अ-१९", "content_sanskrit": "अरजोऽम्बरधारी च न म्लानकुसुमस्तथा।\nतं ज्ञात्वा लक्षणैः सीता वासवं परिहर्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000253019, "chapter_id": 9253, "verse_number": "३-५६अ-२०", "content_sanskrit": "उवाच वाक्यं रुदती भगवन् राघवं प्रति।\nसह भ्रात्रा महाबाहुर्दिष्ट्या मे श्रुतिमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000253020, "chapter_id": 9253, "verse_number": "३-५६अ-२१", "content_sanskrit": "यथा मे श्वशुरो राजा यथा च मिथिलाधिपः।\nतथा त्वामद्य पश्यामि सनाथो मे पतिस्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000253021, "chapter_id": 9253, "verse_number": "३-५६अ-२२", "content_sanskrit": "तवाज्ञया च देवेन्द्र पयोभूतमिदं हविः।\nअशिष्यामि त्वया दत्तं रघूणां कुलवर्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000253022, "chapter_id": 9253, "verse_number": "३-५६अ-२३", "content_sanskrit": "इन्द्रहस्ताद् गृहीत्वा तत् पायसं सा शुचिस्मिता।\nन्यवेदयत भर्त्रे सा लक्ष्मणाय च मैथिली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000253023, "chapter_id": 9253, "verse_number": "३-५६अ-२४", "content_sanskrit": "यदि जीवति मे भर्ता सह भ्रात्रा महाबलः।\nइदमस्तु तयोर्भक्त्या तदाश्नात् पायसं स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000253024, "chapter_id": 9253, "verse_number": "३-५६अ-२५", "content_sanskrit": "इतीव तत् प्राश्य हविर्वरानना\nजहौ क्षुधादुःखसमुद्भवं च तम्।\nइन्द्रात् प्रवृत्तिम् उपलभ्य जानकी\nकाकुत्स्थयोः प्रीतमना बभूव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000253025, "chapter_id": 9253, "verse_number": "३-५६अ-२६", "content_sanskrit": "स चापि शक्रस्त्रिदिवालयं तदा\nप्रीतो ययौ राघवकार्यसिद्धये।\nआमन्त्र्य सीतां स ततो महात्मा\nजगाम निद्रासहितः स्वमालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]