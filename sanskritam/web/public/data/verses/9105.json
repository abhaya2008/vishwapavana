[{"id": 5000105000, "chapter_id": 9105, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे अष्टाविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000105001, "chapter_id": 9105, "verse_number": "२-२८-१", "content_sanskrit": "स एवं ब्रुवतीं सीतां धर्मज्ञां धर्मवत्सलः।\nन नेतुं कुरुते बुद्धिं वने दुःखानि चिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000105002, "chapter_id": 9105, "verse_number": "२-२८-२", "content_sanskrit": "सान्त्वयित्वा ततस्तां तु बाष्पदूषितलोचनाम्।\nनिवर्तनार्थे धर्मात्मा वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000105003, "chapter_id": 9105, "verse_number": "२-२८-३", "content_sanskrit": "सीते महाकुलीनासि धर्मे च निरता सदा।\nइहाचरस्व धर्मं त्वं यथा मे मनसः सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000105004, "chapter_id": 9105, "verse_number": "२-२८-४", "content_sanskrit": "सीते यथा त्वां वक्ष्यामि तथा कार्यं त्वयाबले।\nवने दोषा हि बहवो वसतस्तान् निबोध मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000105005, "chapter_id": 9105, "verse_number": "२-२८-५", "content_sanskrit": "सीते विमुच्यतामेषा वनवासकृता मतिः।\nबहुदोषं हि कान्तारं वनमित्यभिधीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000105006, "chapter_id": 9105, "verse_number": "२-२८-६", "content_sanskrit": "हितबुद‍्ध्या खलु वचो मयैतदभिधीयते।\nसदा सुखं न जानामि दुःखमेव सदा वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000105007, "chapter_id": 9105, "verse_number": "२-२८-७", "content_sanskrit": "गिरिनिर्झरसम्भूता गिरिनिर्दरिवासिनाम्।\nसिंहानां निनदा दुःखाः श्रोतुं दुःखमतो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000105008, "chapter_id": 9105, "verse_number": "२-२८-८", "content_sanskrit": "क्रीडमानाश्च विस्रब्धा मत्ताः शून्ये तथा मृगाः।\nदृष्ट्वा समभिवर्तन्ते सीते दुःखमतो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000105009, "chapter_id": 9105, "verse_number": "२-२८-९", "content_sanskrit": "सग्राहाः सरितश्चैव पङ्कवत्यस्तु दुस्तराः।\nमत्तैरपि गजैर्नित्यमतो दुःखतरं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000105010, "chapter_id": 9105, "verse_number": "२-२८-१०", "content_sanskrit": "लताकण्टकसंकीर्णाः कृकवाकूपनादिताः।\nनिरपाश्च सुदुःखाश्च मार्गा दुःखमतो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000105011, "chapter_id": 9105, "verse_number": "२-२८-११", "content_sanskrit": "सुप्यते पर्णशय्यासु स्वयंभग्नासु भूतले।\nरात्रिषु श्रमखिन्नेन तस्माद् दुःखमतो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000105012, "chapter_id": 9105, "verse_number": "२-२८-१२", "content_sanskrit": "अहोरात्रं च संतोषः कर्तव्यो नियतात्मना।\nफलैर्वृक्षावपतितैः सीते दुःखमतो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000105013, "chapter_id": 9105, "verse_number": "२-२८-१३", "content_sanskrit": "उपवासश्च कर्तव्यो यथा प्राणेन मैथिलि।\nजटाभारश्च कर्तव्यो वल्कलाम्बरधारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000105014, "chapter_id": 9105, "verse_number": "२-२८-१४", "content_sanskrit": "देवतानां पितॄणां च कर्तव्यं विधिपूर्वकम्।\nप्राप्तानामतिथीनां च नित्यशः प्रतिपूजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000105015, "chapter_id": 9105, "verse_number": "२-२८-१५", "content_sanskrit": "कार्यस्त्रिरभिषेकश्च काले काले च नित्यशः।\nचरतां नियमेनैव तस्माद् दुःखतरं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000105016, "chapter_id": 9105, "verse_number": "२-२८-१६", "content_sanskrit": "उपहारश्च कर्तव्यः कुसुमैः स्वयमाहृतैः।\nआर्षेण विधिना वेद्यां सीते दुःखमतो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000105017, "chapter_id": 9105, "verse_number": "२-२८-१७", "content_sanskrit": "यथालब्धेन कर्तव्यः संतोषस्तेन मैथिलि।\nयताहारैर्वनचरैः सीते दुःखमतो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000105018, "chapter_id": 9105, "verse_number": "२-२८-१८", "content_sanskrit": "अतीव वातस्तिमिरं बुभुक्षा चाति नित्यशः।\nभयानि च महान्त्यत्र ततो दुःखतरं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000105019, "chapter_id": 9105, "verse_number": "२-२८-१९", "content_sanskrit": "सरीसृपाश्च बहवो बहुरूपाश्च भामिनि।\nचरन्ति पथि ते दर्पात् ततो दुःखतरं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000105020, "chapter_id": 9105, "verse_number": "२-२८-२०", "content_sanskrit": "नदीनिलयनाः सर्पा नदीकुटिलगामिनः।\nतिष्ठन्त्यावृत्य पन्थानमतो दुःखतरंवनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000105021, "chapter_id": 9105, "verse_number": "२-२८-२१", "content_sanskrit": "पतङ्गा वृश्चिकाः कीटा दंशाश्च मशकैः सह।\nबाधन्ते नित्यमबले सर्वं दुःखमतो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000105022, "chapter_id": 9105, "verse_number": "२-२८-२२", "content_sanskrit": "द्रुमाः कण्टकिनश्चैव कुशाः काशाश्च भामिनि।\nवने व्याकुलशाखाग्रास्तेन दुःखमतो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000105023, "chapter_id": 9105, "verse_number": "२-२८-२३", "content_sanskrit": "कायक्लेशाश्च बहवो भयानि विविधानि च।\nअरण्यवासे वसतो दुःखमेव सदा वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000105024, "chapter_id": 9105, "verse_number": "२-२८-२४", "content_sanskrit": "क्रोधलोभौ विमोक्तव्यौ कर्तव्या तपसे मतिः।\nन भेतव्यं च भेतव्ये दुःखं नित्यमतो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000105025, "chapter_id": 9105, "verse_number": "२-२८-२५", "content_sanskrit": "तदलं ते वनं गत्वा क्षेमं नहि वनं तव।\nविमृशन्निव पश्यामि बहुदोषकरं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000105026, "chapter_id": 9105, "verse_number": "२-२८-२६", "content_sanskrit": "वनं तु नेतुं न कृता मतिर्यदा\nबभूव रामेण तदा महात्मना।\nन तस्य सीता वचनं चकार तं\nततोऽब्रवीद् राममिदं सुदुःखिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000105027, "chapter_id": 9105, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे अष्टाविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]