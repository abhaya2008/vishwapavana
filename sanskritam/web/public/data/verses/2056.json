[{"id": 2047737, "chapter_id": 2056, "verse_number": "६-१०५-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2047738, "chapter_id": 2056, "verse_number": "६-१०५-१", "content_sanskrit": "दृष्ट्वा भीष्मं रणे युद्धं पाण्डवैरभिसंवृतम्।\nयथा मेघैर्महाराज तपान्ते दिवि भास्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2047739, "chapter_id": 2056, "verse_number": "६-१०५-२", "content_sanskrit": "दुर्योधनो महाराज दुःशासनमभाषत।\nएष शूरो महेष्वासो भीष्मः शूरनिषूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2047740, "chapter_id": 2056, "verse_number": "६-१०५-३", "content_sanskrit": "छादितः पाण्डवैः शूरैः समन्ताद्भरतर्षभ ।\nतस्य कार्यं त्वया वीर रक्षणं सुमहात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2047741, "chapter_id": 2056, "verse_number": "६-१०५-४", "content_sanskrit": "रक्ष्यमाणो हि समरे भीष्मोऽस्माकं पितामहः ।\nनिहन्यात्समरे यत्तान्पाञ्चालान्पाण्डवैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2047742, "chapter_id": 2056, "verse_number": "६-१०५-५", "content_sanskrit": "तत्र कार्यतमं मन्ये भीष्मस्यैवाभिरक्षणम् ।\nगोप्ता ह्येष महेष्वासो भीष्मोऽस्माकं महाव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2047743, "chapter_id": 2056, "verse_number": "६-१०५-६", "content_sanskrit": "स भवान्सर्वसैन्येन परिवार्य पितामहम् ।\nसमरे कर्म कुर्वाणं दुष्करं परिरक्षतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2047744, "chapter_id": 2056, "verse_number": "६-१०५-७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2047745, "chapter_id": 2056, "verse_number": "६-१०५-७", "content_sanskrit": "स एवमुक्तः समरे पुत्रो दुःशासनस्तव।\nपरिवार्य स्थितो भीष्मं सैन्येन महता वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2047746, "chapter_id": 2056, "verse_number": "६-१०५-८", "content_sanskrit": "ततः शतसहस्राणां हयानां सुबलात्मजः ।\nविमलप्रासहस्तानामृष्टितोमरधारिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2047747, "chapter_id": 2056, "verse_number": "६-१०५-९", "content_sanskrit": "दर्पितानां सुवेगानां बलस्थानां पताकिनाम् ।\nशिक्षितैर्युद्धकुशलैरुपेतानां नरोत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2047748, "chapter_id": 2056, "verse_number": "६-१०५-१०", "content_sanskrit": "नकुलं सहदेवं च धर्मराजं च पाण्डवम् ।\nन्यवारयन्नरश्रेष्ठान्परिवार्य समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2047749, "chapter_id": 2056, "verse_number": "६-१०५-११", "content_sanskrit": "ततो दुर्योधनो राजा शूराणां हयसादिनाम् ।\nअयुतं प्रेषयामास पाण्डवानां निवारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2047750, "chapter_id": 2056, "verse_number": "६-१०५-१२", "content_sanskrit": "तैः प्रविष्टैर्महावेगैर्गरुत्मद्भिरिवाहवे।\nखुराहता धरा राजंश्चकम्पे च ननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2047751, "chapter_id": 2056, "verse_number": "६-१०५-१३", "content_sanskrit": "खुरशब्दश्च सुमहान्वाजिनां शुश्रुवे तदा।\nमहावंशवनस्येव दह्यमानस्य पर्वते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2047752, "chapter_id": 2056, "verse_number": "६-१०५-१४", "content_sanskrit": "उत्पतद्भिश्च तैस्तत्र समुद्धूतं महद्रजः।\nदिवाकररथं प्राप्य च्छादयामास भास्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2047753, "chapter_id": 2056, "verse_number": "६-१०५-१५", "content_sanskrit": "वेगवद्भिर्हयैस्तैस्तु क्षोभिता पाण्डवीक चमूः।\nनिपतद्भिर्महावेगैर्हंसैरिव महत्सरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2047754, "chapter_id": 2056, "verse_number": "६-१०५-१६", "content_sanskrit": "हेषतां चैव शब्देन न प्राज्ञायत किंचन ।\n`अन्तर्दधे महाञ्शब्दस्तेन शब्देन मोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2047755, "chapter_id": 2056, "verse_number": "६-१०५-१७", "content_sanskrit": "ततो युधिष्ठिरो राजा माद्रीपुत्रौ च पाण्डवौ।\nप्रत्यघ्नंस्तरसा वेगं समरे हयसादिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2047756, "chapter_id": 2056, "verse_number": "६-१०५-१८", "content_sanskrit": "उद्वृत्तस्य महाराज प्रावृट्कालेऽतिपूर्यतः।\nपौर्णमास्यामम्बुवेगं यथा वेला महोदधेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2047757, "chapter_id": 2056, "verse_number": "६-१०५-१९", "content_sanskrit": "ततस्ते रथिनो राजञ्शरैः सन्नतपर्वभिः।\nन्यकृन्तन्नुत्तमाङ्गानि शरेण हयसादिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2047758, "chapter_id": 2056, "verse_number": "६-१०५-२०", "content_sanskrit": "ते निपेतुर्महाराज निहता दृढधन्विभिः ।\nनागैरिव महानागा यथावद्गिरिगह्वरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2047759, "chapter_id": 2056, "verse_number": "६-१०५-२१", "content_sanskrit": "तेऽपि प्रासैः सुनिशितैः शरैः सन्नतपर्वभिः ।\nन्यकृन्तन्नुत्तमाङ्गानि विचरन्तो दिशो दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2047760, "chapter_id": 2056, "verse_number": "६-१०५-२२", "content_sanskrit": "अभ्याहता हयारोहा ऋष्टिभिर्भरतर्षभ ।\nअत्यजन्नुत्तमाङ्गानि फलानीव महाद्रुमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2047761, "chapter_id": 2056, "verse_number": "६-१०५-२३", "content_sanskrit": "समादिनो हया राजंस्तत्रतत्र निषूदिताः।\nपतिताः पात्यमानाश्च प्रत्यदृश्यन्त सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2047762, "chapter_id": 2056, "verse_number": "६-१०५-२४", "content_sanskrit": "वध्यमाना हयाश्चैव प्राद्रवन्त भयार्दिताः।\nयथा सिंहं समासाद्य मृगाः प्राणपरायणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2047763, "chapter_id": 2056, "verse_number": "६-१०५-२५", "content_sanskrit": "पाण्डवाश्च महाराज जित्वा शत्रून्महामृधे ।\nदध्मुः शङ्खांश्च भेरीश्च ताडयामासुराहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2047764, "chapter_id": 2056, "verse_number": "६-१०५-२६", "content_sanskrit": "ततो दुर्योधनो दीनो दृष्ट्वा सैन्यं पराजितम् ।\nअब्रवीद्रतश्रेष्ठ मद्रराजमिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2047765, "chapter_id": 2056, "verse_number": "६-१०५-२७", "content_sanskrit": "एष पाण्डुसुतो ज्येष्ठो यमाभ्यां सहितो रणे ।\nपश्यतां वो महाबाहो सेनां द्रावयति प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2047766, "chapter_id": 2056, "verse_number": "६-१०५-२८", "content_sanskrit": "तं वारय महाबाहो वेलेव मकरालयम् ।\nत्वं हि संश्रूयसेऽत्यर्थमसह्यबलविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2047767, "chapter_id": 2056, "verse_number": "६-१०५-२९x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2047768, "chapter_id": 2056, "verse_number": "६-१०५-२९", "content_sanskrit": "पुत्रस्य तव तद्वाक्यं श्रुत्वा शल्यः प्रतापवान्।\nस ययौ रथवंशेन यत्र राजा युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2047769, "chapter_id": 2056, "verse_number": "६-१०५-३०", "content_sanskrit": "तदापतद्वै सहसा शल्यस्य सुमहद्बलम् ।\nमहौघवेगं समरे वारयामास पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2047770, "chapter_id": 2056, "verse_number": "६-१०५-३१", "content_sanskrit": "मद्रराजं च समरे धर्मराजो महारथः।\nदशभिः सायकैस्तूर्णमाजघान स्तनान्तरे ।\nनकुलः सहदेवश्च तं सप्तभिरजिह्नगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2047771, "chapter_id": 2056, "verse_number": "६-१०५-३२", "content_sanskrit": "मद्रराजोऽपि तान्सर्वानाजघान त्रिभिस्त्रिभिः ।\nयुधिष्ठिरं पुनः षष्ट्या विव्याध निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2047772, "chapter_id": 2056, "verse_number": "६-१०५-३३", "content_sanskrit": "माद्रीपुत्रौ च संभ्रान्तौ द्वाभ्यां द्वाभ्यामताडयत्।\nततो भीमो महाबहुर्दृष्ट्वा राजनमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2047773, "chapter_id": 2056, "verse_number": "६-१०५-३४", "content_sanskrit": "मद्रराजवशं प्राप्तं मृत्योरास्यगतं यथा।\nअभ्यपद्यत संग्रामे युधिष्ठिरममित्रजित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2047774, "chapter_id": 2056, "verse_number": "६-१०५-३५", "content_sanskrit": "`आपतन्नेव भीमस्तु मद्रराजमताडयत्।\nसर्वपारशवैस्तीक्ष्णैर्नाराचैर्मर्मभेदिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2047775, "chapter_id": 2056, "verse_number": "६-१०५-३६", "content_sanskrit": "ततो भीष्मश्च द्रोणश्च सैन्येन महता वृतौ।\nराजानमभ्यपद्येतामञ्जसा शरवर्षिणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2047776, "chapter_id": 2056, "verse_number": "६-१०५-३७", "content_sanskrit": "ततो युद्धं महाघोरं प्रावर्तत सुदारुणम्।\nअपरां दिशमास्थाय द्योतमाने दिवाकरे ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2047777, "chapter_id": 2056, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि नवमदिवसयुद्धे पञ्चाधिकशततमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-१०५-८ तत इति। सैन्येनेति पूर्वस्मादनुकृष्यते। हयानां सैन्येन परिवार्य न्यवारयदिति तृतीयेनान्वयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]