[{"id": 2106578, "chapter_id": 3314, "verse_number": "१७-२-१", "content_sanskrit": "वैशम्पायन उवाच।\nततस्ते नियतात्मान उदीचीं दिशमास्थिताः।\nददृशुर्योगयुक्ताश्च हिमवन्तं महागिरिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2106579, "chapter_id": 3314, "verse_number": "१७-२-२", "content_sanskrit": "तं चाप्यतिक्रमन्तस्ते ददृशुर्वालुकार्णवम्।\nअवैक्षन्त महाशैलं मेरुं शिखरिणां वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2106580, "chapter_id": 3314, "verse_number": "१७-२-३", "content_sanskrit": "तेषां तु गच्छतां शीघ्रं सर्वेषां योगधार्मिणाम्।\nयाज्ञसेनी भ्रष्टयोगा निपपात महीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2106581, "chapter_id": 3314, "verse_number": "१७-२-४", "content_sanskrit": "तां तु प्रपतितां दृष्ट्वा भीमसेनो महाबलः।\nउवाच धर्मराजानं याज्ञसेनीमवेक्ष्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2106582, "chapter_id": 3314, "verse_number": "१७-२-५", "content_sanskrit": "नाधर्मश्चरितः कश्चिद्राजपुत्र्या परंतप।\nकारणं किंनु तद्ब्रूहि यत्कृष्णा पतिता भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2106583, "chapter_id": 3314, "verse_number": "१७-२-६x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2106584, "chapter_id": 3314, "verse_number": "१७-२-६", "content_sanskrit": "पक्षपातो महानस्या विशेषेण धनंजये।\nतस्यैतत्फलमद्यैषा भुङ्क्ते पुरुषसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2106585, "chapter_id": 3314, "verse_number": "१७-२-७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2106586, "chapter_id": 3314, "verse_number": "१७-२-७", "content_sanskrit": "एवमुक्त्वाऽनवेक्ष्यैनां ययौ भरतसत्तमः।\nसमाधाय मनो धीमान्धर्मात्मा पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2106587, "chapter_id": 3314, "verse_number": "१७-२-८", "content_sanskrit": "सहदेवस्ततो विद्वान्निपपात महीतले।\nतं चापि पतितं दृष्ट्वा भीमो राजानमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2106588, "chapter_id": 3314, "verse_number": "१७-२-९", "content_sanskrit": "योऽयमस्मासु सर्वेषु शुश्रूषुरनहंकृतः।\nसोयं माद्रवतीपुत्रः कस्मान्निपतितो भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2106589, "chapter_id": 3314, "verse_number": "१७-२-१०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2106590, "chapter_id": 3314, "verse_number": "१७-२-१०", "content_sanskrit": "आत्मनः सदृशं प्राज्ञं नैषोऽमन्यत कञ्चन।\nतेन दोषेण पतितो विद्वानेष नृपात्मजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2106591, "chapter_id": 3314, "verse_number": "१७-२-११x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2106592, "chapter_id": 3314, "verse_number": "१७-२-११", "content_sanskrit": "इत्युक्त्वा तं समुत्सृज्य सहदेवं ययौ तदा।\nभ्रातृभिः सह कौन्तेयः शुना चैव युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2106593, "chapter_id": 3314, "verse_number": "१७-२-१२", "content_sanskrit": "कृष्णं निपतितां दृष्ट्वा सहदेवं च पाण्डवम्।\nआर्तो बन्धुप्रियः शूरो नकुलो निपपात ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2106594, "chapter_id": 3314, "verse_number": "१७-२-१३", "content_sanskrit": "तस्मिन्निपतिते वीरे नकुले चारुदर्शने।\nपुनरेव तदा भीमो राजानमिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2106595, "chapter_id": 3314, "verse_number": "१७-२-१४", "content_sanskrit": "योऽयमक्षतधर्मात्मा भ्राता वचनकारकः।\nरूपेणाप्रतिमो लोके नकुलः पतितो भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2106596, "chapter_id": 3314, "verse_number": "१७-२-१५", "content_sanskrit": "इत्युक्तो भीमसेनेन प्रत्युवाच युधिष्ठिरः।\nनकुलं प्रति धर्मात्मा सर्वबुद्धिमतांवरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2106597, "chapter_id": 3314, "verse_number": "१७-२-१६", "content_sanskrit": "रूपेणि मत्समो नास्ति कश्चिदित्यस्य दर्शनम्।\nअधिकश्चाहमेवैक इत्यस्य मनसि स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2106598, "chapter_id": 3314, "verse_number": "१७-२-१७", "content_sanskrit": "नकुलः पतितस्तस्मादागच्छ त्वं वृकोदर।\nयस्य यद्विहितं वीर सोऽवश्यं तदुपाश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2106599, "chapter_id": 3314, "verse_number": "१७-२-१८", "content_sanskrit": "तांस्तु प्रपतितान्दृष्ट्वा पाण्डवः श्वेतवाहनः।\nपपात शोकसंतप्तस्ततोनु परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2106600, "chapter_id": 3314, "verse_number": "१७-२-१९", "content_sanskrit": "तस्मिंस्तु पुरुषव्याघ्रे पतिते शक्रतेजसि।\nम्रियमाणे दुराधर्षे भीमो राजानमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2106601, "chapter_id": 3314, "verse_number": "१७-२-२०", "content_sanskrit": "अनृतं न स्मराम्यस्य स्वैरेष्वपि महात्मनः।\nअथ कस्य विकारोऽयं येनायं पतितो भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2106602, "chapter_id": 3314, "verse_number": "१७-२-२१x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2106603, "chapter_id": 3314, "verse_number": "१७-२-२१", "content_sanskrit": "एकोहं निर्दहेयं वै शत्रूनित्यर्जुनोऽब्रवीत्।\nन च तत्कृतवानेष शूरमानी ततोपतत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2106604, "chapter_id": 3314, "verse_number": "१७-२-२२", "content_sanskrit": "अवमेने धनुर्ग्राहानेष सर्वांश्च फल्गुनः।\nतथा चैतन्न तु तथा कर्तव्यं भूतिमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2106605, "chapter_id": 3314, "verse_number": "१७-२-२३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2106606, "chapter_id": 3314, "verse_number": "१७-२-२३", "content_sanskrit": "इत्युक्त्वा प्रस्थितो राजा भीमोथ निपपात ह।\nपतितश्चाब्रवीद्भीमो धर्मराजं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2106607, "chapter_id": 3314, "verse_number": "१७-२-२४", "content_sanskrit": "भोभो राजन्नवेक्षस्व पतितोहं प्रियस्तव।\nकिंनिमित्तं च पतनं ब्रूहि मे यदि वेत्थ ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2106608, "chapter_id": 3314, "verse_number": "१७-२-२५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2106609, "chapter_id": 3314, "verse_number": "१७-२-२५", "content_sanskrit": "अतिभुक्तं च भवता प्राणेन च विकत्थसे।\nअनवेक्ष्य परं पार्थ तेनासि पतितः क्षितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2106610, "chapter_id": 3314, "verse_number": "१७-२-२६", "content_sanskrit": "इत्युक्त्वा तं महाबाहुर्जगामानवलोकयन्।\nश्वाप्येकोनुययौ यस्ते बहुशः कीर्तितो मया॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2106611, "chapter_id": 3314, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते महाप्रस्थानिकपर्वणि द्वितीयोऽध्यायः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]