[{"id": 6000080000, "chapter_id": 10080, "verse_number": null, "content_sanskrit": "अथ षोडशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000080001, "chapter_id": 10080, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.001.m4a", "display_order": 2}, {"id": 6000080002, "chapter_id": 10080, "verse_number": "४-१६-१", "content_sanskrit": "इति ब्रुवाणं नृपतिं गायका मुनिचोदिताः।\nतुष्टुवुस्तुष्टमनसस्तद्वागमृतसेवया॥ ४/१६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.002.m4a", "display_order": 3, "topics": [{"text": "सूतमागधादिभिः मुन्युपदिष्टमार्गेण पृथोः वृत्तवर्तिष्यमाणमहिमानुवर्णनम्", "range": "१–२८"}]}, {"id": 6000080003, "chapter_id": 10080, "verse_number": null, "content_sanskrit": "सूता ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.003.m4a", "display_order": 4}, {"id": 6000080004, "chapter_id": 10080, "verse_number": "४-१६-२", "content_sanskrit": "नालं वयं ते महिमानुवर्णने यो देवदेवोऽवततार मायया।\nवेनाङ्गजातस्य च पौरुषाणि ते वाचस्पतीनामपि बभ्रमुर्धियः॥ ४/१६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.004.m4a", "display_order": 5}, {"id": 6000080005, "chapter_id": 10080, "verse_number": "४-१६-३", "content_sanskrit": "अथाप्युदारश्रवसः पृथोर्हरेः कलावतारस्य कथामृतादृताः।\nयथोपदेशं मुनिभिः प्रचोदिताः श्लाघ्यानि कर्माणि वयं वितन्महे॥ ४/१६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.005.m4a", "display_order": 6}, {"id": 6000080006, "chapter_id": 10080, "verse_number": "४-१६-४", "content_sanskrit": "एष धर्मभृतां श्रेष्ठो लोकं धर्मेऽनुवर्तयन्।\nगोप्ता च धर्मसेतूनां शास्ता तत्परिपन्थिनाम्॥ ४/१६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.006.m4a", "display_order": 7}, {"id": 6000080007, "chapter_id": 10080, "verse_number": "४-१६-५", "content_sanskrit": "एष वै लोकपालानां बिभर्त्येकस्तनौ तनूः।\nकाले काले यथाभागं लोकयोरुभयोर्हितम्॥ ४/१६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.007.m4a", "display_order": 8}, {"id": 6000080008, "chapter_id": 10080, "verse_number": "४-१६-६", "content_sanskrit": "वसु काल उपादत्ते काले चायं विमुञ्चति।\nसमः सर्वेषु भूतेषु प्रतपन् सूर्यवद् विभुः॥ ४/१६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.008.m4a", "display_order": 9}, {"id": 6000080009, "chapter_id": 10080, "verse_number": "४-१६-७", "content_sanskrit": "तितिक्षत्यक्रमं वैन्य उपर्याक्रमतामपि।\nभूतानां करुणः शश्वदार्तानां क्षितिवृत्तिमान्॥ ४/१६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.009.m4a", "display_order": 10}, {"id": 6000080010, "chapter_id": 10080, "verse_number": "४-१६-८", "content_sanskrit": "देवेऽवर्षत्यसौ देवो नरदेववपुर्हरिः।\nकृच्छ्रप्राणाः प्रजा ह्येष रक्षिष्यत्यञ्जसेन्द्रवत्॥ ४/१६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.010.m4a", "display_order": 11}, {"id": 6000080011, "chapter_id": 10080, "verse_number": "४-१६-९", "content_sanskrit": "आप्याययत्यसौ लोकं वदनामृतमूर्तिना।\nसानुरागावलोकेन विशदस्मितचारुणा॥ ४/१६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.011.m4a", "display_order": 12}, {"id": 6000080012, "chapter_id": 10080, "verse_number": "४-१६-१०", "content_sanskrit": "अव्यक्तवर्त्मैष विशुद्धकार्यो गम्भीरचेता उपगुप्तवित्तः।\nअनन्तमाहात्म्यगुणैकधामा पृथुः प्रचेता इव संवृतात्मा॥ ४/१६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.012.m4a", "display_order": 13}, {"id": 6000080013, "chapter_id": 10080, "verse_number": "४-१६-११", "content_sanskrit": "दुरासदो दुर्विषह आसन्नोऽपि विदूरवत्।\nनैवाभिभवितुं शक्यो वेनारण्युत्थितोऽनलः॥ ४/१६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.013.m4a", "display_order": 14}, {"id": 6000080014, "chapter_id": 10080, "verse_number": "४-१६-१२", "content_sanskrit": "अन्तर्बहिश्च भूतानां पश्यन् कर्माणि चारणैः।\nउदासीन इवाध्यक्षो वायुरात्मेव देहिनाम्॥ ४/१६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.014.m4a", "display_order": 15}, {"id": 6000080015, "chapter_id": 10080, "verse_number": "४-१६-१३", "content_sanskrit": "नादण्ड्यं दण्डयत्येष सुतमात्मद्विषामपि।\nदण्डयत्यात्मजमपि दण्ड्यं धर्मपथे स्थितः॥ ४/१६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.015.m4a", "display_order": 16}, {"id": 6000080016, "chapter_id": 10080, "verse_number": "४-१६-१४", "content_sanskrit": "अस्याप्रतिहतं चक्रं पृथोरामानसाचलात्।\nवर्तते भगवानर्को यावत् तपति गोगणैः॥ ४/१६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.016.m4a", "display_order": 17}, {"id": 6000080017, "chapter_id": 10080, "verse_number": "४-१६-१५", "content_sanskrit": "रञ्जयिष्यति यल्लोकमयमात्मविचेष्टितैः।\nअथामुमाहू राजानं मनोरञ्जनकैः प्रजाः॥ ४/१६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.017.m4a", "display_order": 18}, {"id": 6000080018, "chapter_id": 10080, "verse_number": "४-१६-१६", "content_sanskrit": "दृढव्रतः सत्यसन्धो ब्रह्मण्यो वृद्धसेवकः।\nशरण्यः सर्वभूतानां मानदो दीनवत्सलः॥ ४/१६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.018.m4a", "display_order": 19}, {"id": 6000080019, "chapter_id": 10080, "verse_number": "४-१६-१७", "content_sanskrit": "मातृभक्तिः परस्‍त्रीषु पत्न्यामर्ध इवात्मनः।\nप्रजासु पितृवत् स्‍निग्धः किङ्करो ब्रह्मवादिनाम्॥ ४/१६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.019.m4a", "display_order": 20}, {"id": 6000080020, "chapter_id": 10080, "verse_number": "४-१६-१८", "content_sanskrit": "देहिनामात्मवत् प्रेष्ठः सुहृदानन्दवर्धनः।\nमुक्तसङ्गप्रसङ्गोऽयं दण्डपाणिरसाधुषु॥ ४/१६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.020.m4a", "display_order": 21}, {"id": 6000080021, "chapter_id": 10080, "verse_number": "४-१६-१९", "content_sanskrit": "एष दोग्धा महीं वीरो गां सतीमोजसौषधीः।\nसमां करिष्यते चेमां धनुःकोट्या समन्ततः॥ ४/१६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.021.m4a", "display_order": 22}, {"id": 6000080022, "chapter_id": 10080, "verse_number": "४-१६-२०", "content_sanskrit": "अयं तु साक्षाद्भगवांस्‍त्र्यधीशः कूटस्थ आत्मा कलयाऽवतीर्णः।\nयस्मिन्नविद्यारचितं निरर्थकं पश्यन्ति नानात्वमिव प्रतीतम्॥ ४/१६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.022.m4a", "display_order": 23}, {"id": 6000080023, "chapter_id": 10080, "verse_number": "४-१६-२१", "content_sanskrit": "अयं भुवो मण्डलमोदयाद्रेर्गौप्तैकवीरो नरदेवनाथः।\nआस्थाय जैत्रं रथमात्तचापः पर्यस्यते दक्षिणतो यथाऽर्कः॥ ४/१६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.023.m4a", "display_order": 24}, {"id": 6000080024, "chapter_id": 10080, "verse_number": "४-१६-२२", "content_sanskrit": "तस्मै नृपालाः किल तत्र तत्र बलिं हरिष्यन्ति सलोकपालाः।\nमंस्यन्त्यमीषां स्‍त्रिय आदिराजं चक्रायुधं तद्यश उच्चरन्त्यः॥ ४/१६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.024.m4a", "display_order": 25}, {"id": 6000080025, "chapter_id": 10080, "verse_number": "४-१६-२३", "content_sanskrit": "अयं महीं गां दुदुहेऽधिराजः प्रजापतिर्वृत्तिकरः प्रजानाम्।\nयो लीलयाऽद्रीन् स्वशरासकोट्या भिन्दन् समां गामकरोद् यथेन्द्रः॥ ४/१६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.025.m4a", "display_order": 26}, {"id": 6000080026, "chapter_id": 10080, "verse_number": "४-१६-२४", "content_sanskrit": "विस्फूर्जयन्नाजगवं धनुः स्वं यदाऽचरत् क्ष्मामविषह्य आजौ।\nतदा निलिल्युर्दिशि दिश्यसन्तो लाङ्गूलमुद्यम्य यथा मृगेन्द्रः॥ ४/१६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.026.m4a", "display_order": 27}, {"id": 6000080027, "chapter_id": 10080, "verse_number": "४-१६-२५", "content_sanskrit": "एषोऽश्वमेधाञ्छतमाजहार सरस्वती प्रादुरभूद्धि यत्र।\nअहार्षीद् यस्य हयं पुरन्दरः शतक्रतुश्चरमे वर्तमाने॥ ४/१६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.027.m4a", "display_order": 28}, {"id": 6000080028, "chapter_id": 10080, "verse_number": "४-१६-२६", "content_sanskrit": "एष स्वसद्मोपवने समेत्य सनत्कुमारं भगवन्तमेकम्।\nआराध्य भक्त्याऽलभतामलं तज्‍ज्ञानं यतो ब्रह्म परं वदन्ति॥ ४/१६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.028.m4a", "display_order": 29}, {"id": 6000080029, "chapter_id": 10080, "verse_number": "४-१६-२७", "content_sanskrit": "तत्र तत्र गिरस्तास्ता इति विश्रुतविक्रमः।\nश्रोष्यत्यात्माश्रिता गाथाः पृथुः पृथुपराक्रमः॥ ४/१६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.029.m4a", "display_order": 30}, {"id": 6000080030, "chapter_id": 10080, "verse_number": "४-१६-२८", "content_sanskrit": "दिशो विजित्याप्रतिरुद्धचक्रः स्वतेजसोत्पाटितलोकशल्यः।\nएवं सुरेन्द्रैरुपगीयमानमहानुभावो भविता पतिर्भुवः॥ ४/१६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_016/BhP_04.016.030.m4a", "display_order": 31}, {"id": 6000080031, "chapter_id": 10080, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे षोडशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]