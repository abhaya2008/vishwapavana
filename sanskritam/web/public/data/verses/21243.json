[{"id": 7001243000, "chapter_id": 21243, "verse_number": "२-५-१६-१", "content_sanskrit": "उपमन्युरुवाच ।\nपुण्ये ऽहनि शुचौ देशे बहुदोषविवर्जिते ।\nदेशिकः प्रथमं कुर्यात्संस्कारं समयाह्वयम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001243001, "chapter_id": 21243, "verse_number": "२-५-१६-२", "content_sanskrit": "परीक्ष्य भूमिं विधिवद्गंधवर्णरसादिभिः ।\nशिल्पिशास्त्रोक्तमार्गेण मण्डपं तत्र कल्पयेत्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001243002, "chapter_id": 21243, "verse_number": "२-५-१६-३", "content_sanskrit": "कृत्वा वेदिं च तन्मध्ये कुण्डानि परिकल्पयेत् ।\nअष्टदिक्षु तथा दिक्षु तत्रैशान्यां पुनः क्रमात्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001243003, "chapter_id": 21243, "verse_number": "२-५-१६-४", "content_sanskrit": "प्रधानकुंडं कुर्वीत यद्वा पश्चिमभागतः ।\nप्रधानमेकमेवाथ कृत्वा शोभां प्रकल्पयेत्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001243004, "chapter_id": 21243, "verse_number": "२-५-१६-५", "content_sanskrit": "वितानध्वजमालाभिर्विविधाभिरनेकशः ।\nवेदिमध्ये ततः कुर्यान्मंडलं शुभलक्षणम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001243005, "chapter_id": 21243, "verse_number": "२-५-१६-६", "content_sanskrit": "रक्तहेमादिभिश्चूर्णैरीश्वरावाहनोचितम् ।\nसिंदूरशालिनीवारचूर्णैरेवाथ निर्धनः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001243006, "chapter_id": 21243, "verse_number": "२-५-१६-७", "content_sanskrit": "एकहस्तं द्विहस्तं वा सितं वा रक्तमेव वा ।\nएकहस्तस्य पद्मस्य कर्णिकाष्टांगुला मता॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001243007, "chapter_id": 21243, "verse_number": "२-५-१६-८", "content_sanskrit": "केसराणि तदर्धानि शेषं चाष्टदलादिकम् ।\nद्विहस्तस्य तु पद्मस्य द्विगुणं कर्णिकादिकम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001243008, "chapter_id": 21243, "verse_number": "२-५-१६-९", "content_sanskrit": "कृत्वा शोभोपशोभाढ्यमैशान्यां तस्य कल्पयेत् ।\nएकहस्तं तदर्धं वा पुनर्वेद्यः तु मंडलम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001243009, "chapter_id": 21243, "verse_number": "२-५-१६-१०", "content_sanskrit": "व्रीहितंदुलसिद्धार्थतिलपुष्पकुशास्तृते ।\nतत्र लक्षणसंयुक्तं शिवकुंभं प्रसाधयेत्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001243010, "chapter_id": 21243, "verse_number": "२-५-१६-११", "content_sanskrit": "सौवर्णं राजतं वापि ताम्रजं मृन्मयं तु वा ।\nगन्धपुष्पाक्षताकीर्णं कुशदूर्वांकुराचितम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001243011, "chapter_id": 21243, "verse_number": "२-५-१६-१२", "content_sanskrit": "सितसूत्रावृतं कंठे नववस्त्रयुगावृतम् ।\nशुद्धाम्बुपूर्णमुत्कूर्चं सद्रव्यं सपिधानकम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001243012, "chapter_id": 21243, "verse_number": "२-५-१६-१३", "content_sanskrit": "भृङ्गारं वर्धनीं चापि शंखं च चक्रमेव वा ।\nविना सूत्रादिकं सर्वं पद्मपत्रमथापि वा॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001243013, "chapter_id": 21243, "verse_number": "२-५-१६-१४", "content_sanskrit": "तस्यासनारविंदस्य कल्पयेदुत्तरे दले ।\nअग्रतश्चंदनांभोभिरस्त्रराजस्य वर्धनीम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001243014, "chapter_id": 21243, "verse_number": "२-५-१६-१५", "content_sanskrit": "मण्डलस्य ततः प्राच्यां मंत्रकुंभे च पूर्ववत् ।\nकृत्वा विधिवदीशस्य महापूजां समाचरेत्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001243015, "chapter_id": 21243, "verse_number": "२-५-१६-१६", "content_sanskrit": "अथार्णवस्य तीरे वा नद्यां गोष्ठे ऽपि वा गिरौ ।\nदेवागरे गृहे वापि देशे ऽन्यस्मिन्मनोहरे॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001243016, "chapter_id": 21243, "verse_number": "२-५-१६-१७", "content_sanskrit": "कृत्वा पूर्वोदितं सर्वं विना वा मंडपादिकम् ।\nमंडलं पूर्ववत्कृत्वा स्थंडिलं च विभावसोः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001243017, "chapter_id": 21243, "verse_number": "२-५-१६-१८", "content_sanskrit": "प्रविश्य पूजाभवनं प्रहृष्टवदनो गुरुः ।\nसर्वमंगलसंयुक्तः समाचरितनैत्यकः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001243018, "chapter_id": 21243, "verse_number": "२-५-१६-१९", "content_sanskrit": "महापूजां महेशस्य कृत्वा मण्डलमध्यतः ।\nशिवकुंभे तथा भूयः शिवमावाह्य पूजयेत्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001243019, "chapter_id": 21243, "verse_number": "२-५-१६-२०", "content_sanskrit": "पश्चिमाभिमुखं ध्यात्वा यज्ञरक्षकमीश्वरम् ।\nअर्चयेदस्त्रवर्धन्यामस्त्रमीशस्य दक्षिणे॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001243020, "chapter_id": 21243, "verse_number": "२-५-१६-२१", "content_sanskrit": "मन्त्रकुम्भे च विन्यस्य मन्त्रं मन्त्रविशारदः ।\nकृत्वा मुद्रादिकं सर्वं मन्त्रयागं समाचरेत्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001243021, "chapter_id": 21243, "verse_number": "२-५-१६-२२", "content_sanskrit": "ततश्शिवानले होमं कुर्याद्देशिकसत्तमः ।\nप्रधानकुण्डे परितो जुहुयुश्चापरे द्विजाः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001243022, "chapter_id": 21243, "verse_number": "२-५-१६-२३", "content_sanskrit": "आचार्यात्पादमर्धं वा होमस्तेषां विधीयते ।\nप्रधानकुण्ड एवाथ जुहुयाद्देशिकोत्तमः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001243023, "chapter_id": 21243, "verse_number": "२-५-१६-२४", "content_sanskrit": "स्वाध्यायमपरे कुर्युः स्तोत्रं मंगलवाचनम् ।\nजपं च विधिवच्चान्ये शिवभक्तिपरायणाः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001243024, "chapter_id": 21243, "verse_number": "२-५-१६-२५", "content_sanskrit": "नृत्यं गीतं च वाद्यं च मंगलान्यपराणि च ।\nपूजनं च सदस्यानां कृत्वा सम्यग्विधानतः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001243025, "chapter_id": 21243, "verse_number": "२-५-१६-२६", "content_sanskrit": "पुण्याहं कारयित्वाथ पुनः संपूज्य शंकरम् ।\nप्रार्थयेद्देशिको देवं शिष्यानुग्रहकाम्यया॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001243026, "chapter_id": 21243, "verse_number": "२-५-१६-२७", "content_sanskrit": "प्रसीद देवदेवेश देहमाविश्य मामकम् ।\nविमोचयैनं विश्वेश घृणया च घृणानिधे॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001243027, "chapter_id": 21243, "verse_number": "२-५-१६-२८", "content_sanskrit": "अथ चैवं करोमीति लब्धानुज्ञस्तु देशिकः ।\nआनीयोपोषितं शिष्यं हविष्याशिनमेव वा॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001243028, "chapter_id": 21243, "verse_number": "२-५-१६-२९", "content_sanskrit": "एकाशनं वा विरतं स्नातं प्रातःकृतक्रियम् ।\nजपंतं प्रणवं देवं ध्यायंतं कृतमंगलम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001243029, "chapter_id": 21243, "verse_number": "२-५-१६-३०", "content_sanskrit": "द्वारस्य पश्चिमस्याग्रमण्डले दक्षिणस्य वा ।\nदर्भासने समासीनं विधायोदङ्मुखं शिशुम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001243030, "chapter_id": 21243, "verse_number": "२-५-१६-३१", "content_sanskrit": "स्वयं प्राग्वदनस्तिष्ठन्नूर्ध्वकायं कृतांजलिम् ।\nसंप्रोक्ष्य प्रोक्षणौतोयैर्मूर्धन्यस्त्रेण मुद्रया॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001243031, "chapter_id": 21243, "verse_number": "२-५-१६-३२", "content_sanskrit": "पुष्पक्षेपेण संताड्य बध्नीयाल्लोचनं गुरुः ।\nदुकूलार्धेन वस्त्रेण मंत्रितेन नवेन च॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001243032, "chapter_id": 21243, "verse_number": "२-५-१६-३३", "content_sanskrit": "ततः प्रवेशयेच्छिष्यं गुरुर्द्वारेण मंडलम् ।\nसो ऽपि तेनेरितः शंभोराचरेत्त्रिः प्रदक्षिणम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001243033, "chapter_id": 21243, "verse_number": "२-५-१६-३४", "content_sanskrit": "ततस्सुवर्णसंमिश्रं दत्त्वा पुष्पांजलिं प्रभोः ।\nप्राङ्मुखश्चोदङ्मुखो वा प्रणमेद्दंडवत्क्षितो॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001243034, "chapter_id": 21243, "verse_number": "२-५-१६-३५", "content_sanskrit": "ततस्संप्रोक्ष्य मूलेन शिरस्यस्त्रेण पूर्ववत् ।\nसंताड्य देशिकस्तस्य मोचयेन्नेत्रबंधनम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001243035, "chapter_id": 21243, "verse_number": "२-५-१६-३६", "content_sanskrit": "स दृष्ट्वा मंडलं भूयः प्रणमेत्साञ्जलिः प्रभुम् ।\nअथासीनं शिवाचार्यो मंडलस्य तु दक्षिणे॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001243036, "chapter_id": 21243, "verse_number": "२-५-१६-३७", "content_sanskrit": "उपवेश्यात्मनस्सव्ये शिष्यं दर्भासने गुरुः ।\nआराध्य च महादेवं शिवहस्तं प्रविन्यसेत्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001243037, "chapter_id": 21243, "verse_number": "२-५-१६-३८", "content_sanskrit": "शिवतेजोमयं पाणिं शिवमंत्रमुदीरयेत् ।\nशिवाभिमानसंपन्नो न्यसेच्छिष्यस्य मस्तके॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001243038, "chapter_id": 21243, "verse_number": "२-५-१६-३९", "content_sanskrit": "सर्वांगालंबनं चैव कुर्यात्तेनैव देशिकः ।\nशिष्यो ऽपि प्रणमेद्भूमौ देशिकाकृतमीश्वरम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001243039, "chapter_id": 21243, "verse_number": "२-५-१६-४०", "content_sanskrit": "ततश्शिवानले देवं समभ्यर्च्य यथाविधि ।\nहुताहुतित्रयं शिष्यमुपवेश्य यथा पुरा॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001243040, "chapter_id": 21243, "verse_number": "२-५-१६-४१", "content_sanskrit": "दर्भाग्रैः संस्पृशंस्तं च विद्ययात्मानमाविशेत् ।\nनमस्कृत्य महादेवं नाडीसंधानमाचरेत्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001243041, "chapter_id": 21243, "verse_number": "२-५-१६-४२", "content_sanskrit": "शिवशास्त्रोक्तमार्गेण कृत्वा प्राणस्य निर्गमम् ।\nशिष्यदेहप्रवेशं च स्मृत्वा मंत्रांस्तु तर्पयेत्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001243042, "chapter_id": 21243, "verse_number": "२-५-१६-४३", "content_sanskrit": "संतर्पणाय मूलस्य तेनैवाहुतयो दश ।\nदेयास्तिस्रस्तथांगानामंगैरेव यथाक्रमम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001243043, "chapter_id": 21243, "verse_number": "२-५-१६-४४", "content_sanskrit": "ततः पूर्णाहुतिं दत्त्वा प्रायश्चित्ताय देशिकः ।\nपुनर्दशाहुतीन्कुर्यान्मूलमंत्रेण मंत्रवित्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001243044, "chapter_id": 21243, "verse_number": "२-५-१६-४५", "content_sanskrit": "पुनः संपूज्य देवेशं सम्यगाचम्य देशिकः ।\nहुत्वा चैव यथान्यायं स्वजात्या वैश्यमुद्धरेत्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001243045, "chapter_id": 21243, "verse_number": "२-५-१६-४६", "content_sanskrit": "तस्यैवं जनयेत्क्षात्रमुद्धारं च ततः पुनः ।\nकृत्वा तथैव विप्रत्वं जनयेदस्य देशिकः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001243046, "chapter_id": 21243, "verse_number": "२-५-१६-४७", "content_sanskrit": "राजन्यं चैवमुद्धृत्य कृत्वा विप्रं पुनस्तयोः ।\nरुद्रत्वं जनयेद्विप्रे रुद्रनामैव साधयेत्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001243047, "chapter_id": 21243, "verse_number": "२-५-१६-४८", "content_sanskrit": "प्रोक्षणं ताडनं कृत्वा शिशोस्स्वात्मानमात्मनि ।\nशिवात्मकमनुस्मृत्य स्फुरंतं विस्फुलिंगवत्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001243048, "chapter_id": 21243, "verse_number": "२-५-१६-४९", "content_sanskrit": "नाड्या यथोक्तया वायुं रेचयेन्मंत्रतो गुरुः ।\nनिर्गम्य प्रविशेन्नाड्या शिष्यस्य हृदयं तथा॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001243049, "chapter_id": 21243, "verse_number": "२-५-१६-५०", "content_sanskrit": "प्रविश्य तस्य चैतन्यं नीलबिन्दुनिभं स्मरन् ।\nस्वतेजसापास्तमलं ज्वलंतमनुचिंतयेत्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001243050, "chapter_id": 21243, "verse_number": "२-५-१६-५१", "content_sanskrit": "तमादाय तया नाड्या मंत्री संहारमुद्रया ।\nन पूरकेण निवेश्यैनमेकीभावार्थमात्मनः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001243051, "chapter_id": 21243, "verse_number": "२-५-१६-५२", "content_sanskrit": "कुंभकेन तथा नाड्या रेचकेन यथा पुरा ।\nतस्मादादाय शिष्यस्य हृदये तन्निवेशयेत्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001243052, "chapter_id": 21243, "verse_number": "२-५-१६-५३", "content_sanskrit": "तमालभ्य शिवाल्लब्धं तस्मै दत्त्वोपवीतकम् ।\nहुत्वाहुतित्रयं पश्चाद्दद्यात्पूर्णाहुतिं ततः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001243053, "chapter_id": 21243, "verse_number": "२-५-१६-५४", "content_sanskrit": "देवस्य दक्षिणे शिष्यमुपवेश्यवरासने ।\nकुशपुष्पपरिस्तीर्णे बद्धांजलिरुदङ्मुखम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001243054, "chapter_id": 21243, "verse_number": "२-५-१६-५५", "content_sanskrit": "स्वस्तिकासनमारूढं विधाय प्राङ्मुखः स्वयम् ।\nवरासनस्थितो मंत्रैर्महामंगलनिःस्वनैः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001243055, "chapter_id": 21243, "verse_number": "२-५-१६-५६", "content_sanskrit": "समादाय घटं पूर्णं पूर्णमेव प्रसादितम् ।\nध्यायमानः शिवं शिष्यमाभिषिंचेत देशिकः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001243056, "chapter_id": 21243, "verse_number": "२-५-१६-५७", "content_sanskrit": "अथापनुद्य स्नानांबु परिधाय सितांबरम् ।\nआचान्तोलंकृतश्शिष्यः प्रांजलिर्मंडपं व्रजेत्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001243057, "chapter_id": 21243, "verse_number": "२-५-१६-५८", "content_sanskrit": "उपवेश्य यथापूर्वं तं गुरुर्दर्भविष्टरे ।\nसंपूज्य मंडलं देवं करन्यासं समाचरेत्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001243058, "chapter_id": 21243, "verse_number": "२-५-१६-५९", "content_sanskrit": "ततस्तु भस्मना देवं ध्यायन्मनसि देशिकः ।\nसमालभेत पाणिभ्यां शिशुं शिवमुदीरयेत्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001243059, "chapter_id": 21243, "verse_number": "२-५-१६-६०", "content_sanskrit": "अथ तस्य शिवाचार्यो दहनप्लावनादिकम् ।\nसकलीकरणं कृत्वा मातृकान्यासवर्त्मना॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001243060, "chapter_id": 21243, "verse_number": "२-५-१६-६१", "content_sanskrit": "ततः शिवासनं ध्यात्वा शिष्यमूर्ध्नि देशिकः ।\nतत्रावाह्य यथान्यायमर्चयेन्मनसा शिवम्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001243061, "chapter_id": 21243, "verse_number": "२-५-१६-६२", "content_sanskrit": "प्रार्थयेत्प्रांजलिर्देवं नित्यमत्र स्थितो भव ।\nइति विज्ञाप्य तं शंभोस्तेजसा भासुरं स्मरेत्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001243062, "chapter_id": 21243, "verse_number": "२-५-१६-६३", "content_sanskrit": "संपूज्याथ शिवं शैवीमाज्ञां प्राप्य शिवात्मिकाम् ।\nकर्णे शिष्यस्य शनकैश्शिवमन्त्रमुदीरयेत्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001243063, "chapter_id": 21243, "verse_number": "२-५-१६-६४", "content_sanskrit": "स तु बद्धांजलिः श्रुत्वा मन्त्रं तद्गतमानसः ।\nशनैस्तं व्याहरेच्छिष्यशिवाचार्यस्य शासनात्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001243064, "chapter_id": 21243, "verse_number": "२-५-१६-६५", "content_sanskrit": "ततः शाक्तं च संदिश्य मन्त्रं मन्त्रविचक्षणः ।\nउच्चारयित्वा च सुखं तस्मै मंगलमादिशेत्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001243065, "chapter_id": 21243, "verse_number": "२-५-१६-६६", "content_sanskrit": "ततस्समासान्मन्त्रार्थं वाच्यवाचकयोगतः ।\nसमदिश्येश्वरं रूपं योगमासनमादिशेत्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001243066, "chapter_id": 21243, "verse_number": "२-५-१६-६७", "content_sanskrit": "अथ गुर्वाज्ञया शिष्यः शिवाग्निगुरुसन्निधौ ।\nभक्त्यैवमभिसंधाय दीक्षावाक्यमुदीरयेत्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001243067, "chapter_id": 21243, "verse_number": "२-५-१६-६८", "content_sanskrit": "वरं प्राणपरित्यागश्छेदनं शिरसो ऽपि वा ।\nन त्वनभ्यर्च्य भुंजीय भगवन्तं त्रिलोचनम्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001243068, "chapter_id": 21243, "verse_number": "२-५-१६-६९", "content_sanskrit": "स एव दद्यान्नियतो यावन्मोहविपर्ययः ।\nतावदाराधयेद्देवं तन्निष्ठस्तत्परायणः॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001243069, "chapter_id": 21243, "verse_number": "२-५-१६-७०", "content_sanskrit": "ततः स समयो नाम भविष्यति शिवाश्रमे ।\nलब्धाधिकारो गुर्वाज्ञापालकस्तद्वशो भवेत्॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001243070, "chapter_id": 21243, "verse_number": "२-५-१६-७१", "content_sanskrit": "अतः परं न्यस्तकरो भस्मादाय स्वहस्ततः ।\nदद्याच्छिष्याय मूलेन रुद्राक्षं चाभिमंत्रितम्॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001243071, "chapter_id": 21243, "verse_number": "२-५-१६-७२", "content_sanskrit": "प्रतिमा वापि देवस्य गूढदेहमथापि वा ।\nपूजाहोमजपध्यानसाधनानि च संभवे॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001243072, "chapter_id": 21243, "verse_number": "२-५-१६-७३", "content_sanskrit": "सोपि शिष्यः शिवाचार्याल्लब्धानि बहुमानतः ।\nआददीताज्ञया तस्य देशिकस्य न चान्यथा॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001243073, "chapter_id": 21243, "verse_number": "२-५-१६-७४", "content_sanskrit": "आचार्यादाप्तमखिलं शिरस्याधाय भक्तितः ।\nरक्षयेत्पूजयेच्छंभुं मठे वा गृह एववा॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001243074, "chapter_id": 21243, "verse_number": "२-५-१६-७५", "content_sanskrit": "अतः परं शिवाचारमादिशेदस्य देशिकः ।\nभक्तिश्रद्धानुसारेण प्रज्ञायाश्चानुसारतः॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001243075, "chapter_id": 21243, "verse_number": "२-५-१६-७६", "content_sanskrit": "यदुक्तं यत्समाज्ञातं यच्चैवान्यत्प्रकीर्तितम् ।\nशिवाचार्येण समये तत्सर्वं शिरसा वहेत्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001243076, "chapter_id": 21243, "verse_number": "२-५-१६-७७", "content_sanskrit": "शिवागमस्य ग्रहणं वाचनं श्रवणं तथा ।\nदेशिकदेशतः कुर्यान्न स्वेच्छातो न चान्यतः॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]