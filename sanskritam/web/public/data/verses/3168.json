[{"id": 2100971, "chapter_id": 3168, "verse_number": "१४-२४-१", "content_sanskrit": "ब्राह्मण उवाच।\nअत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nसुभगे पञ्चहोतॄणां विधानमिह यादृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2100972, "chapter_id": 3168, "verse_number": "१४-२४-२", "content_sanskrit": "प्राणापानवुदानश्च समानो व्यान एव च।\nपञ्चहोतॄंस्तथैतान्वै परं भावं विदुर्बुधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2100973, "chapter_id": 3168, "verse_number": "१४-२४-३x", "content_sanskrit": "ब्राह्मण्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2100974, "chapter_id": 3168, "verse_number": "१४-२४-३", "content_sanskrit": "स्वबावात्सप्तहोतार इति मे पूर्विका मतिः।\nयथा वै पञ्च होतारः परो भावस्तदुच्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2100975, "chapter_id": 3168, "verse_number": "१४-२४-४x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2100976, "chapter_id": 3168, "verse_number": "१४-२४-४", "content_sanskrit": "प्राणेन सम्भृतो वायुरपानो जायते ततः।\nअपाने सम्भृतो वायुस्ततो व्यानः प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2100977, "chapter_id": 3168, "verse_number": "१४-२४-५", "content_sanskrit": "व्यानेन सम्भृतो वायुस्ततोदानः प्रवर्तते।\nउदाने सम्भृतो वायुः समानो नाम जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2100978, "chapter_id": 3168, "verse_number": "१४-२४-६", "content_sanskrit": "तेऽपृच्छन्त पुरो गत्वा पूर्वजातं पितामहम्।\nयो नः श्रेष्ठस्तमाचक्ष्व स नः श्रेष्ठो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2100979, "chapter_id": 3168, "verse_number": "१४-२४-७x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2100980, "chapter_id": 3168, "verse_number": "१४-२४-७", "content_sanskrit": "यस्मिन्प्रलीने प्रलयं व्रजन्ति\nसर्वे प्राणाः प्राणभृतां शरीरे।\nयस्मिन्प्रवृत्ते च पुनश्चरन्ति\nस वै श्रेष्ठो गच्छत यत्र कामः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2100981, "chapter_id": 3168, "verse_number": "१४-२४-८x", "content_sanskrit": "प्राण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2100982, "chapter_id": 3168, "verse_number": "१४-२४-८", "content_sanskrit": "मयि प्रलीने प्रलयं व्रजन्ति\nसर्वे प्राणाः प्राणभृतां शरीरे।\nमयि प्रवृत्ते च पुनश्चरन्ति\nश्रेष्ठो ह्यहं पश्यत मां प्रलीनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2100983, "chapter_id": 3168, "verse_number": "१४-२४-९x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2100984, "chapter_id": 3168, "verse_number": "१४-२४-९", "content_sanskrit": "प्रामः प्रालीयत ततः पुनश्च प्रचचार ह।\nसमानश्चाप्युदानश्च वचो ब्रूतां पुनः शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2100985, "chapter_id": 3168, "verse_number": "१४-२४-१०", "content_sanskrit": "न त्वं सर्वमिदं व्याप्य तिष्ठसीह यथा वयम्।\nन त्वं श्रेष्ठो हि नः प्राण अपानो हि वशे तव।\nप्रचचार पुनः प्राणस्ततोऽपानोऽभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2100986, "chapter_id": 3168, "verse_number": "१४-२४-११x", "content_sanskrit": "उपान उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2100987, "chapter_id": 3168, "verse_number": "१४-२४-११", "content_sanskrit": "मयि प्रलीने प्रलयं व्रजन्ति\nसर्वे प्राणाः प्राणभृतां शरीरे\nमयि प्रवृत्ते च पुनश्चरन्ति\nश्रेष्ठो ह्यहं पश्यत मां प्रलीनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2100988, "chapter_id": 3168, "verse_number": "१४-२४-१२x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2100989, "chapter_id": 3168, "verse_number": "१४-२४-१२", "content_sanskrit": "व्यानश्च तमुदानश्चि भाषमाणमथोचतुः।\nअपान न त्वं श्रेष्ठोसि प्राणो हि वशगस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2100990, "chapter_id": 3168, "verse_number": "१४-२४-१३", "content_sanskrit": "अपानः प्रचचाराथ व्यानस्तं पुनरब्रवीत्।\nश्रेष्ठोऽहमस्मि सर्वेषां श्रूयतां येन हेतुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2100991, "chapter_id": 3168, "verse_number": "१४-२४-१४", "content_sanskrit": "मयि प्रलीने प्रलयं व्रजन्ति\nसर्वे प्राणाः प्राणभृतां शरीरे।\nमयि प्रवृत्ते च पुनश्चरन्ति\nश्रेष्ठो ह्यहं पश्यत मां प्रलीनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2100992, "chapter_id": 3168, "verse_number": "१४-२४-१५x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2100993, "chapter_id": 3168, "verse_number": "१४-२४-१५", "content_sanskrit": "प्रालीयत ततो व्यानः पुनश्च प्रचचार ह।\nप्राणापानावुदानस्च समानश्च तमब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2100994, "chapter_id": 3168, "verse_number": "१४-२४-१६", "content_sanskrit": "न त्वं श्रेष्ठोसि नो व्यान समानस्तु वशे तव।\nप्रचचार पुनर्व्यानः समानः पुनरब्रवीत्।\nश्रेष्ठोऽहमस्मि सर्वेषां श्रूयतां येन हेतुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2100995, "chapter_id": 3168, "verse_number": "१४-२४-१७", "content_sanskrit": "मयि प्रलीने प्रलयं व्रजन्ति\nसर्वे प्राणाः प्राणभृतां शरीरे।\nमयि प्रवृत्ते च पुनश्चरन्ति\nश्रेष्ठो ह्यहं पश्यत मां प्रलीनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2100996, "chapter_id": 3168, "verse_number": "१४-२४-१८", "content_sanskrit": "`ततः समानः प्रालिल्ये पुनश्च प्रचचार ह।\nप्राणापानावुदानस्च व्यानश्चैव तमब्रवीत्।\nन त्वं समान श्रेष्ठोसि व्यान एव वशे तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2100997, "chapter_id": 3168, "verse_number": "१४-२४-१९", "content_sanskrit": "समानः प्रचचाराथ उदानस्तमुवाच ह।\nश्रेष्ठोऽहमस्मि सर्वेषां श्रूयतां येन हेतुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2100998, "chapter_id": 3168, "verse_number": "१४-२४-२०", "content_sanskrit": "मयि प्रलीने प्रलयं व्रजन्ति\nसर्वे प्राणाः प्राणभृतां शरीरे।\nमयि प्रवृत्ते च पुनश्चरन्ति\nश्रेष्ठो ह्यहं पश्यत मां प्रलीनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2100999, "chapter_id": 3168, "verse_number": "१४-२४-२१", "content_sanskrit": "ततः प्रालीयतोदानः पुनश्च प्रचचार ह।\nप्राणापानौ समानश्च व्यानश्चैव तमब्रुवन्।\nउदानि न त्वं श्रेष्ठोसि व्यानि एव वशे तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2101000, "chapter_id": 3168, "verse_number": "१४-२४-२२x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2101001, "chapter_id": 3168, "verse_number": "१४-२४-२२", "content_sanskrit": "ततस्तानब्रवीत्सर्वान्स्मयमानः प्रजापतिः।\nसर्वे श्रेष्ठा न च श्रेष्ठाः सर्वे चान्योन्यकाङ्क्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2101002, "chapter_id": 3168, "verse_number": "१४-२४-२३", "content_sanskrit": "सर्वे स्वविषये श्रेष्ठाः सर्वे चान्योन्यधर्मिणः।\nइति तानब्रवीत्सर्वान्समवेतान्प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2101003, "chapter_id": 3168, "verse_number": "१४-२४-२४", "content_sanskrit": "एकः स्थिरश्चराश्चान्ये विशेषात्पञ्च वायवः।\nएक एव च सर्वात्मा बहुधाऽप्युपचीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2101004, "chapter_id": 3168, "verse_number": "१४-२४-२५", "content_sanskrit": "परस्परस्य सुहृदो भावयन्तः परस्परम्।\nस्वस्ति व्रजत भद्रं वो धारयध्वं परस्परम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2101005, "chapter_id": 3168, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि चतुर्विशोऽध्यायः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]