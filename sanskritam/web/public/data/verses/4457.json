[{"id": 2159310, "chapter_id": 4457, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2159311, "chapter_id": 4457, "verse_number": "१", "content_sanskrit": "शशिबिन्दुं च राजेन्द्रं मृतं सृञ्जय शुश्रुम ।\nय ईजे विविधैर्यज्ञैः श्रीमान् सत्यपराक्रमः\nतस्य भार्यासहस्राणां शतमासीन्महात्मनः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2159312, "chapter_id": 4457, "verse_number": "२", "content_sanskrit": "एकैकस्यां च भार्यायां पुत्रजन्म तथाऽभवत् ।\nसहस्रं तु सहस्रं तु तस्यां तस्यां महात्मनः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2159313, "chapter_id": 4457, "verse_number": "३", "content_sanskrit": "शशिबिन्दुकुमारास्ते सर्वे नियुतदक्षिणाः ।\nराजानः क्रतुभिर्मुख्यैरीजाना वेदपारगाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2159314, "chapter_id": 4457, "verse_number": "४", "content_sanskrit": "हिरण्यकवचाः सर्वे सर्वे चोत्तमधन्विनः ।\nसर्वेऽश्वमेधैरीजानाः कुमाराः शशिबिन्दवाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2159315, "chapter_id": 4457, "verse_number": "५", "content_sanskrit": "तानश्वमेधे यज्ञेन्द्रे ब्राह्मणेभ्योऽददात् पिता ।\nशतं शतं रथगता एकैकं पृष्ठतोऽन्वयुः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2159316, "chapter_id": 4457, "verse_number": "६", "content_sanskrit": "राजपुत्रांस्तदा कन्या रमणीयाः स्वलङ्कृताः ।\nकन्यां कन्यां शतं नागा नागे नागे शतं रथाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2159317, "chapter_id": 4457, "verse_number": "७", "content_sanskrit": "रथे रथे शतं चाश्वा जविनो हेममालिनः ।\nअश्वे ह्यश्वे गोसहस्रं गवां पञ्चाप्यजाविकम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2159318, "chapter_id": 4457, "verse_number": "८", "content_sanskrit": "एतद्धनमपर्यन्तमश्वमेधमहामखे ।\nशशिबिन्दुर्महाभागो ब्राह्मणेभ्योऽन्वमंसत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2159319, "chapter_id": 4457, "verse_number": "९", "content_sanskrit": "वृक्षाश्च यूपा यावन्त अश्वमेधे हि शब्दिताः ।\nते तथैव पुनश्चान्ये तावन्तः काञ्चनाऽभवन्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2159320, "chapter_id": 4457, "verse_number": "१०", "content_sanskrit": "भक्ष्यान्नपाननिचयाः पर्वताः क्रोशमुच्छ्रिताः ।\nतस्याश्वमेधे निर्वृत्ते राज्ञः शिष्टास्त्रयोदश\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2159321, "chapter_id": 4457, "verse_number": "११", "content_sanskrit": "तुष्टपुष्टजनाकीर्णां शान्तविघ्नां निरामयाम् ।\nशशिबिन्दुरिमां भूमिं चिरं भुक्त्वा दिवं गतः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2159322, "chapter_id": 4457, "verse_number": "१२", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2159323, "chapter_id": 4457, "verse_number": "१३", "content_sanskrit": "पुत्रात् पुण्यतमस्तुभ्यं मा पुत्रमनुतप्यथाः ।\nअयज्वानमदक्षिण्यमधिचैत्येत्युदाहरत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2159324, "chapter_id": 4457, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि द्विषष्टितमोऽध्यायः ॥ ६२ ॥\nअभिमन्युवधपर्वणि एकत्रिंशोऽध्यायः ॥ ३१ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]