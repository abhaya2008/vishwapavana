[{"id": 7005647000, "chapter_id": 25647, "verse_number": "१२०-१", "content_sanskrit": "मद्रेश्वरस्य क्रीडाविहारवर्णनम् ।\nसूत उवाच ।\nस त्वाश्रमपदे रम्ये त्यक्ताहारपरिच्छदः ।\nक्रीडाविहारं गन्धर्वैः पश्यत्यप्सरसां सह ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005647001, "chapter_id": 25647, "verse_number": "१२०-२", "content_sanskrit": "कृत्वा पुष्पोच्चयं भूरि ग्रथयित्वा तथा स्रजाः ।\nअग्रं निवेद्य देवाय गन्धर्वेभ्यस्तदा ददौ ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005647002, "chapter_id": 25647, "verse_number": "१२०-३", "content_sanskrit": "पुष्पोच्चयप्रसक्तानां क्रीडन्तीनां यथा सुखम् ।\nचेष्टा नानाविधाकाराः पश्यन्नपि न पश्यति ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005647003, "chapter_id": 25647, "verse_number": "१२०-४", "content_sanskrit": "काचित् पुष्पोच्चये सक्ता लताजालेन वेष्टिता ।\nसखीजनेन सन्त्यक्ता कान्तेनाभिसमुज्झिता ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005647004, "chapter_id": 25647, "verse_number": "१२०-५", "content_sanskrit": "काचित्‌ कमलगन्धाभा निश्वासपवनाहृतैः ।\nमधुपैराकुलमुखी कान्तेन परिमोचिता ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005647005, "chapter_id": 25647, "verse_number": "१२०-६", "content_sanskrit": "मकरन्दसमाक्रान्तनयना काचिदङ्गना ।\nकान्तनिश्वासवातेन नीरजंस्ककृतेक्षणा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005647006, "chapter_id": 25647, "verse_number": "१२०-७", "content_sanskrit": "काचिदुच्चीय पुष्पाणि ददौ कान्तस्य भामिनी ।\nकान्तसङ्ग्रथितैः पुष्पै रराज कृतशेखरा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005647007, "chapter_id": 25647, "verse_number": "१२०-८", "content_sanskrit": "उच्चीयस्वयमुद्‌ग्रथ्य कान्तेन कृतशेखरा ।\nकृतकृत्यमिवात्मानं मेने मन्मथवर्धिनी ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005647008, "chapter_id": 25647, "verse_number": "१२०-९", "content_sanskrit": "अस्त्यस्मिनाहने कुञ्जे विशिष्टकुसुमा लता ।\nकाचिदेवं रहो नीता रमणेन रिरंसुना ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005647009, "chapter_id": 25647, "verse_number": "१२०-१०", "content_sanskrit": "कान्तसन्नामितलता कुसुमानि विचन्वती ।\nसर्वाभ्यः काचिदात्मानं मेने सर्वगुणाधिकम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005647010, "chapter_id": 25647, "verse_number": "१२०-११", "content_sanskrit": "काश्चित् पश्यन्ति भूपालं नलिनीषु पृथक्‌ पृथक् ।\nक्रीडमानास्तु गन्धर्वै रममाणामनोरमाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005647011, "chapter_id": 25647, "verse_number": "१२०-१२", "content_sanskrit": "काचिदाताडयत् कान्तमुदकेन शुचिस्मिता ।\nताड्यमानाथ कान्तेन प्रीतिं काचिदुपाययौ ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005647012, "chapter_id": 25647, "verse_number": "१२०-१३", "content_sanskrit": "कान्तञ्च ताडयामास जातखेदा वराङ्ना ।\nअद्रृश्यत वरारोहा श्वासनृत्यत्पयोधरा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005647013, "chapter_id": 25647, "verse_number": "१२०-१४", "content_sanskrit": "कान्ताम्बुताडनोद्‌घृष्टकेशपाशनिबन्धना ।\nकेशाकुलमुखी भाति मधुपैरिव पद्मिनी ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005647014, "chapter_id": 25647, "verse_number": "१२०-१५", "content_sanskrit": "स्वचक्षुः सद्रृशैः पुष्पैः सञ्च्छन्ने नलिनीवने ।\nछन्ना काचिच्चिरात् प्राप्ता कान्तेनान्विष्य यत्नतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005647015, "chapter_id": 25647, "verse_number": "१२०-१६", "content_sanskrit": "स्नाता शीतापदेशेन काचित् प्राहाङ्गना भृशम् ।\nरमणालिङ्गनं चक्रे मनोऽभिलषितञ्चिरम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005647016, "chapter_id": 25647, "verse_number": "१२०-१७", "content_sanskrit": "जलार्द्रवसनं सूक्ष्ममङ्गलीनं शुचिस्मिता ।\nधारयन्ती जनं चक्रे काचित्तत्र समन्मथम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005647017, "chapter_id": 25647, "verse_number": "१२०-१८", "content_sanskrit": "कण्ठमाल्यगुणैः काचित् कान्तेनाकृष्यताम्भसि ।\nत्रुट्यत्स्रग्दामपतितं रमणं प्राह सच्चिरम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005647018, "chapter_id": 25647, "verse_number": "१२०-१९", "content_sanskrit": "काचिद् भग्ना सखीदत्त जानुदेशे नखक्षता ।\nसम्भ्रान्ता कान्तशरणं मग्ना काचिद्गता चिरम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005647019, "chapter_id": 25647, "verse_number": "१२०-२०", "content_sanskrit": "काचित् पृष्ठकृतादित्या केशनिस्तोयकारिणी ।\nशिलातलगता भर्त्रा द्रष्टा कामार्तचक्षुषा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005647020, "chapter_id": 25647, "verse_number": "१२०-२१", "content_sanskrit": "कृत्तमाल्यं विलुलितं सङ्क्रान्तकुचकुङ्कुमम् ।\nतरिक्रीडितकान्तेव रराज तत् सरोदकम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005647021, "chapter_id": 25647, "verse_number": "१२०-२२", "content_sanskrit": "सुस्नातदेवगन्धर्व देवरामागणेन च ।\nपूज्यमानञ्च दद्रृषे देवदेवं जनार्दनम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005647022, "chapter_id": 25647, "verse_number": "१२०-२३", "content_sanskrit": "क्वचिच्च दद्रृशे राजा लतागृहगताः स्त्रियः ।\nमण्डयन्तीः स्वगात्राणि कान्तसन्न्यस्तमानसाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005647023, "chapter_id": 25647, "verse_number": "१२०-२४", "content_sanskrit": "काचिदादर्शनकरा व्यग्रा दूतीमुखोद्रतम् ।\nश्रृण्वन्ती कान्तवचनमधिका तु तथा बभौ ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005647024, "chapter_id": 25647, "verse_number": "१२०-२५", "content_sanskrit": "काचित् सत्वरिता दूत्या भूषणानां विपर्ययम् ।\nकुर्वाणा नैव बुबुधे मन्मथाविष्टचेतना ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005647025, "chapter_id": 25647, "verse_number": "१२०-२६", "content_sanskrit": "वायुनुन्नातिसुरिभि कुसुमोत्करमण्डिते ।\nकाञ्चित् पिबन्तीं दद्रृशे मैरेयं नीलशाद्वले ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005647026, "chapter_id": 25647, "verse_number": "१२०-२७", "content_sanskrit": "पाययामास रमणं स्वयं काचिद्वराङ्गना ।\nकाचित् पपौ वरारोहा कान्तपाणिसमर्पितम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005647027, "chapter_id": 25647, "verse_number": "१२०-२८", "content_sanskrit": "काचित् स्वनेत्रचपल नीलोत्पलयुतम्पयः ।\nपीत्वा पप्रच्छ रमणं क्व गतौ तौ ममोत्पलौ ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005647028, "chapter_id": 25647, "verse_number": "१२०-२९", "content_sanskrit": "त्वयैव पीतौ तौ नूनमित्युक्ता रमणेन सा ।\nतथा विदित्वा मुग्धत्वाद् बभूव व्रीडिता भृशम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005647029, "chapter_id": 25647, "verse_number": "१२०-३०", "content_sanskrit": "काचित् कान्तार्पितं सुभ्रुः कान्तपीतावशेषितम् ।\nसविशेषरसं पानं पपौ मन्मथवर्धनम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005647030, "chapter_id": 25647, "verse_number": "१२०-३१", "content_sanskrit": "अपानगोष्ठीषु तथा तासां स नरपुङ्गवः ।\nशुश्राव विविधङ्गीतं तन्त्रीस्वरविमिश्रितम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005647031, "chapter_id": 25647, "verse_number": "१२०-३२", "content_sanskrit": "प्रदोषसमये ताश्च देवदेवं जनार्दनम् ।\nराजन्! सदोपनृत्यन्ति नानावाद्यपुरः सराः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005647032, "chapter_id": 25647, "verse_number": "१२०-३३", "content_sanskrit": "याममात्रे गते रात्रौ विनिर्गत्य गुहामुखात् ।\nआवसन् संयुताः कान्तैः परर्धिरचिताङ्गुहाम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005647033, "chapter_id": 25647, "verse_number": "१२०-३४", "content_sanskrit": "नानागन्धान्वितलतां नानागन्धसुगन्धिनीम् ।\nनानाविचित्रशयनां कुसुमोत्‌करमण्डिताम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005647034, "chapter_id": 25647, "verse_number": "१२०-३५", "content_sanskrit": "एवमप्सरसां पश्यन् क्रीडितानि स पर्वते ।\nतपस्तेपे महाराजन्! केशवार्पितमानसः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005647035, "chapter_id": 25647, "verse_number": "१२०-३६", "content_sanskrit": "तमूचुर्नृपतिङ्गत्वा गन्धर्वाप्सरसाङ्गणाः ।\nराजन्! स्वर्गोपमन्देशमिमं प्राप्तोऽस्यरिन्दम! ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005647036, "chapter_id": 25647, "verse_number": "१२०-३७", "content_sanskrit": "वयं हि प्रदास्यामो मनसः काङ्क्षितान्वरान् ।\nतानादाय गृहङ्गच्छ तिष्ठेह यदि वा पुनः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005647037, "chapter_id": 25647, "verse_number": "१२०-३८", "content_sanskrit": "राजोवाच ।\nअमोघदर्शनाः सर्वे भवन्तस्त्वमितौजसः ।\nवरं वितरताद्यैव प्रसादं मधुसूदनात् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005647038, "chapter_id": 25647, "verse_number": "१२०-३९", "content_sanskrit": "एवमस्त्वित्यथोक्तस्तैः स तु राजा पुरूरवाः ।\nतत्रोवास सुखीमासं पूजयानो जनार्दनम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005647039, "chapter_id": 25647, "verse_number": "१२०-४०", "content_sanskrit": "प्रिय एव सदैवासीद् गन्धर्वाप्सरसां नृपः ।\nतुतोष स जनो राज्ञस्तस्या लौल्येन कर्म्मणा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005647040, "chapter_id": 25647, "verse_number": "१२०-४१", "content_sanskrit": "मामस्य मध्ये स नृपः प्रविष्टस्तदाश्रमं रत्नसहस्रचित्रम् ।\nतोयाशनस्तत्र उवास मासं यावत् सितान्तो नृप! फाल्गुनस्य ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005647041, "chapter_id": 25647, "verse_number": "१२०-४२", "content_sanskrit": "फाल्गुनामलपक्षान्ते राजा स्वप्ने पुरूरवाः ।\nतस्यैव देवदेवस्य श्रुतवान् गदितं शुभम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005647042, "chapter_id": 25647, "verse_number": "१२०-४३", "content_sanskrit": "रात्र्यामस्यां व्यतीतायामत्रिणा त्वं समेष्यसि ।\nतेन राजन्! समागम्य कृतकृत्यो भविष्यसि ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005647043, "chapter_id": 25647, "verse_number": "१२०-४४", "content_sanskrit": "स्वप्नमेवं स राजर्षिर्द्रृष्ट्वा देवेन्द्रविक्रमः ।\nप्रत्यूषकाले विधिवत् स्नातः स प्रयतेन्द्रियः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005647044, "chapter_id": 25647, "verse_number": "१२०-४५", "content_sanskrit": "कृतकृत्यो यथाकामं पूजयित्वा जनार्दनम् ।\nददर्शात्रिं मुनिं राजा प्रत्यक्षं तपसां निधिम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005647045, "chapter_id": 25647, "verse_number": "१२०-४६", "content_sanskrit": "स्वप्नन्तु देवदेवस्य न्यवेदयत धार्मिकः ।\nततः श्रुश्राव वचनं देवतानां समीरितम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005647046, "chapter_id": 25647, "verse_number": "१२०-४७", "content_sanskrit": "एवमेतन्महीपाल! नात्र कार्य्या विचारणा ।\nएवं प्रसादं सम्प्राप्य देवदेवाज्जनार्दनात् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005647047, "chapter_id": 25647, "verse_number": "१२०-४८", "content_sanskrit": "कृतदेवार्चनो राजा तथा हुतहुताशनः ।\nसर्वान् कामानवाप्तोऽसौ वरदानेन केशवात् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005647048, "chapter_id": 25647, "verse_number": "१२०-४९", "content_sanskrit": "इति श्रीमात्स्ये महापुराणे भुवनकोश ऐलाश्रमवर्णनं नाम विंशत्यधिकशततमोऽध्यायः 120", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]