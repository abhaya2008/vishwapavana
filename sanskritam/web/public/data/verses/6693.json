  },
  {
    "id": 20012625,
    "chapter_id": 6693,
    "verse_number": "1.70",
    "content_sanskrit": "अधः पेतुर्बुधेन्द्रेण क्षताः पक्षेषु तत्क्षणम् । व्यूढकर्कशतर्केण तथागतधराधराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20012626,
    "chapter_id": 6693,
    "verse_number": "1.71",
    "content_sanskrit": "स सर्वज्ञपदं विज्ञोऽसहमान इव द्विषाम् । चकार चित्रविन्यस्तानेतान्मौनविभूषितान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20012627,
    "chapter_id": 6693,
    "verse_number": "1.72",
    "content_sanskrit": "ततः प्रक्षीणदर्पेषु बौद्धेषु वसुधाधिपम् । बोधयन्बहुधा वेदवचांसि शशंस सः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20012628,
    "chapter_id": 6693,
    "verse_number": "1.73",
    "content_sanskrit": "बभाषेऽथ धराधीशो विद्यायत्तौ जयाजयौ । यः पतित्वा गिरेः शृङ्गादव्ययस्तन्मतं ध्रुवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20012629,
    "chapter_id": 6693,
    "verse_number": "1.74",
    "content_sanskrit": "तदाकर्ण्य मुखान्यन्ये परस्परमलोकयन् । द्विजाग्र्यस्तु स्मरन्वेदानारुरोह गिरेः शिरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20012630,
    "chapter_id": 6693,
    "verse_number": "1.75",
    "content_sanskrit": "यदि वेदाः प्रमाणं स्युर्भूयात्काचिन्न मे क्षतिः । इति घोषयता तस्मान्न्यपाति सुमहात्मना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20012631,
    "chapter_id": 6693,
    "verse_number": "1.76",
    "content_sanskrit": "किमु दौहित्रदत्तेऽपि पुण्ये विलयमास्थिते । ययातिश्च्यवते स्वर्गात्पुनरित्यूचिरे जंनाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20012632,
    "chapter_id": 6693,
    "verse_number": "1.77",
    "content_sanskrit": "अपि लोकगुरुः शैलात्तूलपिण्ड इवापतत् । श्रुतिरात्मशरण्यानां व्यसनं नोच्छिनत्ति किम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20012633,
    "chapter_id": 6693,
    "verse_number": "1.78",
    "content_sanskrit": "श्रुत्वा तदद्भुतं कर्म द्विजा दिग्भ्यः समाययुः । घनघोषमिवाऽऽकर्ण्य निकुञ्जेभ्यः शिखावलाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20012634,
    "chapter_id": 6693,
    "verse_number": "1.79",
    "content_sanskrit": "दृष्ट्वा तमेक्षतं राजा श्रद्धां श्रुतिषु संदधे । निनिन्द बहुधाऽऽत्मानं खलसंसर्गदूषितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20012635,
    "chapter_id": 6693,
    "verse_number": "1.80",
    "content_sanskrit": "सौगतास्त्वब्रुवन्वेदं प्रमाणं मतनिर्णये । मणिमन्त्रौषधैरेवं देहरक्षा भवेदिति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20012636,
    "chapter_id": 6693,
    "verse_number": "1.81",
    "content_sanskrit": "दुर्विद्यैरन्यथा नीते प्रत्यक्षेऽर्थेऽपि पार्थिवः । भ्रुकुटीभीकरमुखः संज्ञामुग्रतरां व्यधात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20012637,
    "chapter_id": 6693,
    "verse_number": "1.82",
    "content_sanskrit": "पृच्छामि भवतः किंचिद्वक्तुं न प्रभवन्ति ये । यन्त्रोपलेषु सर्वांस्तान्घातयिष्याम्यसंशयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20012638,
    "chapter_id": 6693,
    "verse_number": "1.83",
    "content_sanskrit": "इति संश्रुत्य गोत्रेशो घटमाशीविषान्वितम् । आनीयात्र किमस्तीति पप्रच्छ द्विजसौगतान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20012639,
    "chapter_id": 6693,
    "verse_number": "1.84",
    "content_sanskrit": "वक्ष्यामहे वयं भूप श्वः प्रभातेऽस्य निर्णयम् । इति प्रसाद्य राजानं जग्मुर्भूसुरसौगताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20012640,
    "chapter_id": 6693,
    "verse_number": "1.85",
    "content_sanskrit": "पद्मा इव तपस्तेपुः कण्ठद्वयसपाथसि । द्युमर्णि प्रति भूदेवाः सोऽपि प्रादुरभूत्ततः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20012641,
    "chapter_id": 6693,
    "verse_number": "1.86",
    "content_sanskrit": "संदिश्य वचनीयांशमाऽदित्येन्तर्हिते द्विजाः । आजग्मुरपि निश्चित्य सौगताः कलशस्थितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20012642,
    "chapter_id": 6693,
    "verse_number": "1.87",
    "content_sanskrit": "ततस्ते सौगताः सर्वे भुजंगोऽस्तीत्यवादिषुः । भोगीशभोगशयनो भगवानिति भूसुराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20012643,
    "chapter_id": 6693,
    "verse_number": "1.88",
    "content_sanskrit": "श्रुतभूसुरवाक्यस्य वदनं पृथिवीपतेः । कासारशोषणम्लानसारसश्रियमाददे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  },
  {
    "id": 20012644,
    "chapter_id": 6693,
    "verse_number": "1.89",
    "content_sanskrit": "अथ प्रोवाच दिव्या वाक्समाजमशरीरिणी । तुदन्ती संशयं तस्य सर्वेषामपि शृण्वताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "avatarnika": ""
  },
  {
    "id": 20012645,
    "chapter_id": 6693,
    "verse_number": "1.90",
    "content_sanskrit": "सत्यमेव महाराज ब्राह्मणा यद्वभाषिरे । मा कृथाः संशयं तत्र भव सत्यप्रतिश्रवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20012646,
    "chapter_id": 6693,
    "verse_number": "1.91",
    "content_sanskrit": "श्रुत्वाऽशरीरिणीं वाणीं ददर्श वसुधाधिपः । मूर्तिं मधुद्विषः कुम्भे सुधामिव सुराधिपः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  },
  {
    "id": 20012647,
    "chapter_id": 6693,
    "verse_number": "1.92",
    "content_sanskrit": "निरस्ताखिलसंदेहो विन्यस्तेतरदर्शनात् । व्यधादाज्ञां ततो राजा वधाय श्रुतिविद्विषाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 92,
    "avatarnika": ""
  },
  {
    "id": 20012648,
    "chapter_id": 6693,
    "verse_number": "1.93",
    "content_sanskrit": "आ सेतोरा तुषाराद्रेर्बौद्धानावृद्धबालकम् । न हन्ति यः स हन्तव्यो भृत्यानित्यन्वशाभृपः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "avatarnika": ""
  },
  {
    "id": 20012649,
    "chapter_id": 6693,
    "verse_number": "1.94",
    "content_sanskrit": "इष्टोऽपि दृष्टदोषश्चेद्वध्य एव महात्मनाम् । जननीमपि किं साक्षान्नावधीद्भृगुनन्दनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 94,
    "avatarnika": ""
  },
  {
    "id": 20012650,
    "chapter_id": 6693,
    "verse_number": "1.95",
    "content_sanskrit": "स्कन्दानुसारिराजेन जैना धर्मद्विषो हताः । योगीन्द्रेणेव योगघ्ना विघ्नास्तत्त्वावलम्बिना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 95,
    "avatarnika": ""
  },
  {
    "id": 20012651,
    "chapter_id": 6693,
    "verse_number": "1.96",
    "content_sanskrit": "हतेषु तेषु दुष्टेषु परितस्तार कोविदः । श्रौतवर्त्म तमिस्रेषु नष्टेष्विव रविर्महः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 96,
    "avatarnika": ""
  },
  {
    "id": 20012652,
    "chapter_id": 6693,
    "verse_number": "1.97",
    "content_sanskrit": "कुमारिलमृगेन्द्रेण हतेषु जिनहस्तिषु । निष्प्रत्यूहमवर्धन्त श्रुतिशाखाः समन्ततः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 97,
    "avatarnika": ""
  },
  {
    "id": 20012653,
    "chapter_id": 6693,
    "verse_number": "1.98",
    "content_sanskrit": "प्रागित्थं ज्वलनभुवा प्रवर्तितेऽस्मिन्कर्मध्वन्यखिलविदा कुमारिलेन । उद्धर्तुं भुवनमिदं भवाब्धिमग्नं कारुण्याम्बुनिधिरियेष चन्द्रचूडः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 98,
    "avatarnika": ""
  }
]