[
  {
    "id": 20012556,
    "chapter_id": 6693,
    "verse_number": "1.1",
    "content_sanskrit": "प्रणम्य परमात्मानं श्रीविद्यातीर्थरूपिणम् । प्राचीनशंकरजये सारः संगृह्यते स्फुटम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20012557,
    "chapter_id": 6693,
    "verse_number": "1.2",
    "content_sanskrit": "यद्वद्धटानां पटलो विशालो विलोक्यतेऽल्पे किल दर्पणेऽपि । तद्वन्मदीये लघुसंग्रहेऽस्मिन्नुद्वीक्ष्यतां शांकरवाक्यसारः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20012558,
    "chapter_id": 6693,
    "verse_number": "1.3",
    "content_sanskrit": "यथाऽतिरुच्ये मधुरेऽपि रुच्युत्पादाय रुच्यन्तरयोजनाऽर्हा । तथेष्यतां प्राक्कविदृब्धपद्येष्वेषाऽपि मत्पद्यनिवेशभङ्गी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20012559,
    "chapter_id": 6693,
    "verse_number": "1.4",
    "content_sanskrit": "स्तुतोऽपि सम्यक्कविभिः पुराणैः कृत्याऽपि नस्तुष्यतु भाष्यकारः । क्षीराब्धिवासी सरसीरुहाक्षः क्षीरं पुनः किं चकमे न गोष्ठे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20012560,
    "chapter_id": 6693,
    "verse_number": "1.5",
    "content_sanskrit": "पयोब्धिविवरीसृतिःसृतसुधाझरी माधुरी- धुरीणभणिताधरीकृतफणाधराधीशितुः । शिवंकरसुशंकराभिधजगद्गुरोः प्रायशो यशो हृदयशोधकं कलयितुं समीहामहे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20012561,
    "chapter_id": 6693,
    "verse_number": "1.6",
    "content_sanskrit": "केमे शंकरसद्गुरोर्गुणगणा दिग्जालकूलंकषाः कालोन्मीलितमालतीपरिमलावष्टम्भमुष्टिंधयाः । काहं हन्त तथाऽपि सद्गुरुकृपापीयुषपारंपरी- मग्नोन्मग्नकटाक्षवीक्षणबलादस्ति प्रशस्ताऽर्हता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20012562,
    "chapter_id": 6693,
    "verse_number": "1.7",
    "content_sanskrit": "धन्यंमन्यविवेकशून्यसुजनंमन्याब्धिकन्यानटी- नृत्योन्मत्तनराधमाधमकथासंमर्ददुष्कर्दमैः । दिग्धां मे गिरमद्य शंकरगुरुकीडासमुद्यद्यशः- पारावारसमुच्चलज्जलझरैः संक्षालयामि स्फुटम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20012563,
    "chapter_id": 6693,
    "verse_number": "1.8",
    "content_sanskrit": "वन्ध्यासूनुखरीविषाणसदृशक्षुद्रक्षितीन्द्रक्षमा- शौर्यौदार्यदयादिवर्णनकलादुर्वासनावासिताम् । मद्वाणीमधिवासयामि यमिनस्त्रैलोक्यरङ्गस्थली- नृत्यत्कीर्तिनटीपटीरपटलीचूर्णैर्विकीर्णैः क्षितौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20012564,
    "chapter_id": 6693,
    "verse_number": "1.9",
    "content_sanskrit": "पीयूषद्युतिखण्डमण्डनकृपारूपान्तरश्रीगुरु- प्रेमस्थेमसमर्हणार्हमधुरव्याहारसूनोत्करः । प्रौढोऽयं नवकालिदासकवितासंतानसंतानको दद्यादद्य समुद्यतः सुमनसामामोदपारंपरीम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20012565,
    "chapter_id": 6693,
    "verse_number": "1.10",
    "content_sanskrit": "सामोदैरनुमोदिता मृगमदैरानन्दिता चन्दनै- र्मन्दारैरभिनन्दिता प्रियगिरा काश्मीरजैः स्मेरिता । वागेषा नवकालिदाखविदुषो दोषोज्झिता दुष्कवि- व्रातैर्निष्करुणैः क्रियेत विकृता धेनुस्तुरुष्कैरिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20012566,
    "chapter_id": 6693,
    "verse_number": "1.11",
    "content_sanskrit": "यद्वा दीनदयालवः सहृदयाः सौजन्यकल्लोलिनी- दोलान्दोलनखेलनैकरसिकस्वान्ताः समन्तादमी । सन्तः सन्ति परोक्तिमौक्तिकजुषः किं चिन्तयाऽनन्तया यद्वा तुष्यति शंकरः परगुरुः कारुण्यरत्नाकरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20012567,
    "chapter_id": 6693,
    "verse_number": "1.12",
    "content_sanskrit": "उपक्रम्य स्तोतुं कतिचन गुणाञ्छंकरगुरोः प्रभग्नाः श्लोकार्धे कतिचन तदर्धार्धरचने । अहं तुष्टुपुरस्तानहह कलये शीताकिरणं कराभ्यामाहर्तुं व्यवसितमतेः साहसिकताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20012568,
    "chapter_id": 6693,
    "verse_number": "1.13",
    "content_sanskrit": "तथाऽप्युज्जृम्भन्ते मयि विपुलदुग्धाब्धिलहरी- लसत्कल्लोलालीलसितपरिहासैकरसिकाः । अमी मूकान्वाचालयितुमपि शक्ता यतिपतेः कटाक्षाः किं चित्रं भृशमघटिताभीष्टघटने ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20012569,
    "chapter_id": 6693,
    "verse_number": "1.14",
    "content_sanskrit": "अस्मज्जिह्वाग्रसिंहासनमुपनयतु स्वोक्तिधारामुदारा- मद्वैताचार्यपादस्तुतिकृतसुकृतोदारता शारदाम्बा । नृत्यन्मृत्युंजयोच्चैर्मुकुटतटकुटीनिःस्रवत्स्वःस्रवन्ती- कल्लोलोद्वेलकोलाहलमदलहरीखण्डिपाण्डित्यहृद्याम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20012570,
    "chapter_id": 6693,
    "verse_number": "1.15",
    "content_sanskrit": "केदं शंकरसद्गुरोः सुचरितं क्वाहं वराकी कथं निर्बध्नासि चिरार्जितं मम यशः किं मज्जयस्यम्बुधौ । इत्युक्त्वा चपलां पलायितवतीं वाचं नियुङ्क्ते बला- त्प्रत्याहृत्य गुणस्तुतौ कविगणश्चित्रं गुरोर्गौरवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20012571,
    "chapter_id": 6693,
    "verse_number": "1.16",
    "content_sanskrit": "रूक्षैकाक्षरवाङ्निघण्टुशरणैरौणादिकप्रत्यय- प्रायैर्हन्त यङन्तदन्तुरतरैर्दुर्बोधदूरान्वयैः । क्रूराणां कवितावतां कतिपयैः कष्टेन कृष्टैः पदै- र्हा हा स्याद्वशगा किरातविततेरेणीव वाणी मम ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20012572,
    "chapter_id": 6693,
    "verse_number": "1.17",
    "content_sanskrit": "नेता यत्रोल्लसति भगवत्पादसंज्ञो महेशः शान्तिर्यत्र प्रकचति रसः शेषवानुज्ज्वलाद्यैः । यत्राविद्याक्षतिरपि फलं तस्य काव्यस्य कर्ता धन्यो व्यासाचलकविवरस्तत्कृतिज्ञाश्च धन्याः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20012573,
    "chapter_id": 6693,
    "verse_number": "1.18",
    "content_sanskrit": "तत्राऽऽदिम उपोद्धातो द्वितीये तु तदुद्भवः । तृतीये तत्तदमृगन्धोवतारनिरूपणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20012574,
    "chapter_id": 6693,
    "verse_number": "1.19",
    "content_sanskrit": "चतुर्थसर्गे तच्छुद्धाष्टमप्राक्वरितं स्थितम् । पञ्चमे तद्योग्यसुखाश्रमप्राप्तिनिरूपणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20012575,
    "chapter_id": 6693,
    "verse_number": "1.20",
    "content_sanskrit": "महताऽनेहसा यैषा संप्रदायागता गता । तस्याः शुद्धात्मविद्यायाः षष्ठे सर्गे प्रतिष्ठितिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20012576,
    "chapter_id": 6693,
    "verse_number": "1.21",
    "content_sanskrit": "तद्व्यासाचार्यसंदर्शविचित्रं सप्तमे स्थितम् । स्थितोऽष्टमे मण्डनार्यसंवादो नवमे मुनेः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20012577,
    "chapter_id": 6693,
    "verse_number": "1.22",
    "content_sanskrit": "वाणीसाक्षिकसार्वज्ञनिर्वाहोपायचिन्तनम् । दशमे योगशक्त्या भूपतिकायप्रवेशनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20012578,
    "chapter_id": 6693,
    "verse_number": "1.23",
    "content_sanskrit": "बुद्ध्वा मीनध्वजकलास्तत्प्रसङ्गप्रपञ्चनम् । सर्ग एकादशे तूग्रभैरवाभिधनिर्जयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20012579,
    "chapter_id": 6693,
    "verse_number": "1.24",
    "content_sanskrit": "द्वादशे हस्ताधात्र्यार्यतोटकोभयसंश्रयः । वार्तिकान्तब्रह्मविद्याचालनं तु त्रयोदशे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20012580,
    "chapter_id": 6693,
    "verse_number": "1.25",
    "content_sanskrit": "चतुर्दशे पद्मपादतीर्थयात्रानिरूपणम् । सर्गे पञ्चदशे तूक्तं तदाशाजयकौतुकम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20012581,
    "chapter_id": 6693,
    "verse_number": "1.26",
    "content_sanskrit": "षोडशे शारदापीठवासस्तस्य महात्मनः । इति षोडशभिः सर्गैर्व्युत्पाद्या शांकरी कथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20012582,
    "chapter_id": 6693,
    "verse_number": "1.27",
    "content_sanskrit": "सैषा कलिमलच्छेत्री सकृच्छ्रुत्याऽपि कामदा । नानाप्रश्नोत्तरै रम्या विदामारभ्यते मुदे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20012583,
    "chapter_id": 6693,
    "verse_number": "1.28",
    "content_sanskrit": "एकदा देवता रूप्याचलस्थमुपतस्थिरे । देवदेवं तुषारांशुमिव पूर्वाचलस्थितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20012584,
    "chapter_id": 6693,
    "verse_number": "1.29",
    "content_sanskrit": "प्रसादानुमितस्वार्थसिद्धयः प्रणिपत्य तम् । मुकुलीकृतहस्ताब्जा विनयेन व्यजिज्ञपन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20012585,
    "chapter_id": 6693,
    "verse_number": "1.30",
    "content_sanskrit": "विज्ञातमेव भगवन्विद्यते यद्धिताय नः । वञ्चयन्सुगतान्बुद्धवपुर्धारी जनार्दनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20012586,
    "chapter_id": 6693,
    "verse_number": "1.31",
    "content_sanskrit": "तत्प्रणीतागमालम्बैर्बौद्धैर्दर्शनदूषकैः । व्याप्तेदानीं प्रभो धात्री रात्रिः संतमसैरिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20012587,
    "chapter_id": 6693,
    "verse_number": "1.32",
    "content_sanskrit": "वर्णाश्रमसमाचारान्द्विषन्ति ब्रह्मविद्विषः । ब्रुवन्त्याम्नायवचसां जीविकामात्रतां प्रभो ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20012588,
    "chapter_id": 6693,
    "verse_number": "1.33",
    "content_sanskrit": "न संध्यादीनि कर्माणि न्यासं वा न कदाचन । करोति मनुजः कश्चित्सर्वे पाखण्डतां गताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20012589,
    "chapter_id": 6693,
    "verse_number": "1.34",
    "content_sanskrit": "श्रुते पिदधति श्रोत्रे ऋतुरित्यक्षरद्वये । क्रियाः कथं प्रवर्तेरन्कथं ऋतुभुजो वयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20012590,
    "chapter_id": 6693,
    "verse_number": "1.35",
    "content_sanskrit": "शिवविष्णुवागमपरैर्लिङ्गचक्रादिचिह्नितैः । पाखण्डैः कर्म संन्यस्तं कारुण्यमिव दुर्जनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20012591,
    "chapter_id": 6693,
    "verse_number": "1.36",
    "content_sanskrit": "अनन्येनैव भावेन गच्छन्त्युत्तमपूरुषम् । श्रुतिः साध्वी मदक्षीबैः का वा शाक्यैर्न दूषिता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20012592,
    "chapter_id": 6693,
    "verse_number": "1.37",
    "content_sanskrit": "सद्यः कृत्तद्विजशिरःपङ्कजार्चितभैरवैः । न ध्वस्ता लोकमर्यादा का वा कापालिकाधमैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20012593,
    "chapter_id": 6693,
    "verse_number": "1.38",
    "content_sanskrit": "अन्येऽपि बहवो मार्गाः सन्ति भूमौ सकण्टकाः । जनैर्यैषु पदं दत्त्वा दुरन्तं दुःखमाप्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20012594,
    "chapter_id": 6693,
    "verse_number": "1.39",
    "content_sanskrit": "तद्भवांल्लोकरक्षार्थमुत्साद्य निखिलान्खलान् । वर्त्म स्थापयतु श्रौतं जगद्येन सुखं व्रजेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20012595,
    "chapter_id": 6693,
    "verse_number": "1.40",
    "content_sanskrit": "इत्युक्त्वोपरतान्देवानुवाच गिरिजाप्रियः । मनोरथं पूरयिष्ये मानुष्यमवलम्ब्य वः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20012596,
    "chapter_id": 6693,
    "verse_number": "1.41",
    "content_sanskrit": "दुष्टाचारविनाशाय धर्मसंस्थापनाय च । भाष्यं कुर्वन्ब्रह्मसूत्रतात्पर्यार्थविनिर्णयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20012597,
    "chapter_id": 6693,
    "verse_number": "1.42",
    "content_sanskrit": "मोहनप्रकृतिद्वैतध्वान्तमध्याह्नभानुभिः । चतुर्भिः सहितः शिष्यैश्चतुरैर्हरिवद्भुजैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20012598,
    "chapter_id": 6693,
    "verse_number": "1.43",
    "content_sanskrit": "यतीन्द्रः शंकरो नाम्ना भविष्यामि महीतले । मद्वत्तथा भवन्तोऽपि मानुषीं तनुमाश्रिताः । ४३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20012599,
    "chapter_id": 6693,
    "verse_number": "1.44",
    "content_sanskrit": "तं मामनुसरिष्यन्ति सर्वे त्रिदिववासिनः । तदा मनोरथः पूर्णो भवतां स्यान्न संशयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20012600,
    "chapter_id": 6693,
    "verse_number": "1.45",
    "content_sanskrit": "ब्रुवन्नेवं दिविषदः कटाक्षानन्यदुर्लभान् । कुमारे निदधे भानुः किरणानिव पङ्कजे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20012601,
    "chapter_id": 6693,
    "verse_number": "1.46",
    "content_sanskrit": "क्षीरनीरनिधेर्वीचिसचिवान्प्राप्य तान्गुहः । कटाक्षान्मुमुदे रश्मीन्नुदन्वानैन्दवानिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20012602,
    "chapter_id": 6693,
    "verse_number": "1.47",
    "content_sanskrit": "अवदन्नन्दनं स्कन्दममन्दं चन्द्रशेखरः । दन्तचन्द्रातपानन्दिवृन्दारकचकोरकः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20012603,
    "chapter_id": 6693,
    "verse_number": "1.48",
    "content_sanskrit": "शृणु सौम्य वचः श्रेयो जगदुद्धारगोचरम् । काण्डत्रयात्मके वेदे प्रोद्धृते स्याद्द्विजोद्धृतिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20012604,
    "chapter_id": 6693,
    "verse_number": "1.49",
    "content_sanskrit": "तद्रक्षणे रक्षितं स्यात्सकलं जगतीतलम् । तदधीनत्वतो वर्णाश्रमधर्मततेस्ततः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20012605,
    "chapter_id": 6693,
    "verse_number": "1.50",
    "content_sanskrit": "इदानीमिदमुद्धार्यमितिवृत्तिमत्तः पुरा । मम गूढाशयविदौ विष्णुशेषौ समीपगौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20012606,
    "chapter_id": 6693,
    "verse_number": "1.51",
    "content_sanskrit": "मध्यमं काण्डमुद्धर्तुमनुज्ञातौ मयैव तौ । अवतीर्यांशतो भूमौ संकर्षणपतञ्जली ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20012607,
    "chapter_id": 6693,
    "verse_number": "1.52",
    "content_sanskrit": "मुनी भूत्वा मुदोपास्तियोगकाण्डकृतौ स्थितौ । अग्रिमं ज्ञानकाण्डं तूद्धरिष्यामीति देवताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20012608,
    "chapter_id": 6693,
    "verse_number": "1.53",
    "content_sanskrit": "संंप्रति प्रतिजाने स्म जानात्येव भवानपि । जैमिनीयमयाम्भोधेः शरत्पर्वशशी भव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20012609,
    "chapter_id": 6693,
    "verse_number": "1.54",
    "content_sanskrit": "विशिष्टं कर्मकाण्डं त्वमुद्धर ब्रह्मणः कृते । सुब्रह्मण्य इति ख्यातिं गमिष्यसि ततोऽधुना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20012610,
    "chapter_id": 6693,
    "verse_number": "1.55",
    "content_sanskrit": "नैगमीं कुरुमर्यादामवतीर्य महीतले । निर्जित्य सौगतान्सर्वानाम्नायार्थविरोधिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20012611,
    "chapter_id": 6693,
    "verse_number": "1.56",
    "content_sanskrit": "ब्रह्माऽपि ते सहायार्थं मण्डनो नाम भूसुरः । भविष्यति महेन्द्रोऽपि सुधन्वा नाम भूमिपः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20012612,
    "chapter_id": 6693,
    "verse_number": "1.57",
    "content_sanskrit": "तथेति प्रतिजग्राह विधेरपि विधायिनीम् । बुधानीकपतिर्वाणीं सुधाधारामिव प्रभोः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20012613,
    "chapter_id": 6693,
    "verse_number": "1.58",
    "content_sanskrit": "अथेन्द्रो नृपतिर्भूत्वा प्रजा धर्मेण पालयन् । दिवं चकार पृथिवीं स्वपुरीममरावतीम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20012614,
    "chapter_id": 6693,
    "verse_number": "1.59",
    "content_sanskrit": "सर्वज्ञोऽप्यसतां शास्त्रे कृत्रिमश्रद्धयाऽन्वितः । प्रतीक्षमाणः क्रौञ्चारिं मेलयामास सौगतान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20012615,
    "chapter_id": 6693,
    "verse_number": "1.60",
    "content_sanskrit": "ततः स तारकारातिरजनिष्ट महीतले । भट्टपादाभिधा यस्य भूषा दिक्सुदृशामभूत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20012616,
    "chapter_id": 6693,
    "verse_number": "1.61",
    "content_sanskrit": "स्फुटयन्वेदतात्पर्यमभाज्जैमिनिसूत्रितम् । सहस्रांशुरिवानूरुव्यञ्जितं भासयञ्जगत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20012617,
    "chapter_id": 6693,
    "verse_number": "1.62",
    "content_sanskrit": "राज्ञः सुधन्वनः प्राप नगरीं स जयन्दिशः । प्रत्युद्गम्य क्षितीन्द्रोऽपि विधिवत्तमपूजयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20012618,
    "chapter_id": 6693,
    "verse_number": "1.63",
    "content_sanskrit": "सोऽभिनन्द्याऽऽशिषा भूपमासीनः काञ्चनासने । तां सभां शोभयामास सुरभिद्युवनीमिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20012619,
    "chapter_id": 6693,
    "verse_number": "1.64",
    "content_sanskrit": "सभासमीपविटपिश्रितकोकिलकूजितम् । श्रुत्वा जगाद तद्व्याजाद्राजानं पण्डिताग्रणीः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20012620,
    "chapter_id": 6693,
    "verse_number": "1.65",
    "content_sanskrit": "मलिनैश्चेन्न सङ्गस्ते नीचैः काककुलैः पिक । श्रुतिदूषकनिर्ह्रादैः श्लाघनीयस्तदा भवेः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20012621,
    "chapter_id": 6693,
    "verse_number": "1.66",
    "content_sanskrit": "षडभिज्ञा निशम्येमां वाचं तात्पर्यगर्भिताम् । नितरां चरणस्पृष्टा भुजंगा इव चुक्रुधुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20012622,
    "chapter_id": 6693,
    "verse_number": "1.67",
    "content_sanskrit": "छित्त्वा युक्तिकुठारेण बुद्धसिद्धान्तशाखिनम् । स तद्ग्रन्थेन्धनैश्चीर्णैः क्रोधज्वालामवर्धयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20012623,
    "chapter_id": 6693,
    "verse_number": "1.68",
    "content_sanskrit": "सा सभा वदनैस्तेषां रोषपाटलकान्तिभिः । बभौ बालातपाताम्रैः सरसीव सरोरुहैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20012624,
    "chapter_id": 6693,
    "verse_number": "1.69",
    "content_sanskrit": "उपन्यस्यत्सु साक्षेपं खण्डयत्सु परस्परम् । तेषूदतिष्ठन्निर्घोषो भिन्दन्निव रसातलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
