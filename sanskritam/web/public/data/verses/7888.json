[{"id": 33000000, "chapter_id": 7888, "verse_number": "1", "content_sanskrit": "सत्तायामस्ति भवति विद्यते चाथ जन्मनि । उत्पद्यते जायते च प्ररोहत्युद्भवत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "avatarnika": ""}, {"id": 33000001, "chapter_id": 7888, "verse_number": "2", "content_sanskrit": "निर्वर्तते सम्भवति सिद्धौ सिध्यति राध्यति । निष्पद्यते च राध्नोति साध्नोति फलतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2, "avatarnika": ""}, {"id": 33000002, "chapter_id": 7888, "verse_number": "3", "content_sanskrit": "वर्तते तु वसत्यास्ते ध्रियते चावतिष्ठते । क्षियति स्थलति स्थित्यां मठत्यपि च तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3, "avatarnika": ""}, {"id": 33000003, "chapter_id": 7888, "verse_number": "4", "content_sanskrit": "जीवे बलत्यूर्जयति श्वसित्यनिति जीवति । अन्यतेऽथ प्राणिति च समनित्युदनित्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4, "avatarnika": ""}, {"id": 33000004, "chapter_id": 7888, "verse_number": "5", "content_sanskrit": "व्यनित्यपानिति प्राणवृत्तिष्वाख्यातपञ्चकम् । कुच्छ्रजीवे क्षञ्जयति कठत्यातङ्कति त्रयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5, "avatarnika": ""}, {"id": 33000005, "chapter_id": 7888, "verse_number": "6", "content_sanskrit": "परिणामे परिणमत्यात्मनेऽपि विवर्तते । सम्पद्यते कल्पतेऽथ वृद्धौ बृंहति वर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6, "avatarnika": ""}, {"id": 33000006, "chapter_id": 7888, "verse_number": "7", "content_sanskrit": "आप्यायते स्फायते च श्वयत्यृध्नोति बर्हति । आपूर्यते पुष्यति च पोषत्यृध्यति पूषति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7, "avatarnika": ""}, {"id": 33000007, "chapter_id": 7888, "verse_number": "8", "content_sanskrit": "वंहते मंहते मेध्यत्येधते च विपोलति । नीवत्यपि स्थूलयते तथा पीवति मीवति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8, "avatarnika": ""}, {"id": 33000008, "chapter_id": 7888, "verse_number": "9", "content_sanskrit": "महीयते च वठति विपोलयति तीवति ।  क्रमते प्यायते स्फीतीभवति प्रथतेऽपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9, "avatarnika": ""}, {"id": 33000009, "chapter_id": 7888, "verse_number": "10", "content_sanskrit": "क्रम्यते प्रसते तौति तवीति च्छान्दसौ क्वचित् । स्फुटति स्फोटते फुल्लत्युन्मीलत्यपि पुष्प्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10, "avatarnika": ""}, {"id": 33000010, "chapter_id": 7888, "verse_number": "11", "content_sanskrit": "विजृम्भते विकचते विकासे विकसत्यपि । मीलति स्मीलति क्ष्मीलत्येते सङ्कुचतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11, "avatarnika": ""}, {"id": 33000011, "chapter_id": 7888, "verse_number": "12", "content_sanskrit": "कूणयत्यपि सङ्कोचे मुकुलीभवतीति षट् । अथो जरायां जरति सप्त जीर्यति झीर्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12, "avatarnika": ""}, {"id": 33000012, "chapter_id": 7888, "verse_number": "13", "content_sanskrit": "जूर्यते जारयति च जिनाति च जृणाति च । दलति स्फोटति विशीर्यते फलति शीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13, "avatarnika": ""}, {"id": 33000013, "chapter_id": 7888, "verse_number": "14", "content_sanskrit": "द्राडतेऽमी विशरणे ध्राडते चाष्ट सीदति । अल्पत्वे लिश्यते कृश्यत्यमी ह्रसति चुण्डते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14, "avatarnika": ""}, {"id": 33000014, "chapter_id": 7888, "verse_number": "15", "content_sanskrit": "चत्वारोऽथ दरिद्राति व्यृध्नोति व्यृध्यतीत्यपि । दरिद्रत्वे त्रयोऽथापक्षीयते चापि दीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15, "avatarnika": ""}, {"id": 33000015, "chapter_id": 7888, "verse_number": "16", "content_sanskrit": "अपक्षये जायति चापक्षयत्यपि दस्यति । तस्यत्यपि क्षायति च सायतीति पदाष्टकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16, "avatarnika": ""}, {"id": 33000016, "chapter_id": 7888, "verse_number": "17", "content_sanskrit": "सप्त प्रध्वंसतेऽत्येति विनश्यति विलीयते । प्रलीयते विनाशेऽमी स्यू रिष्यति विपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17, "avatarnika": ""}, {"id": 33000017, "chapter_id": 7888, "verse_number": "18", "content_sanskrit": "परैति प्रैति मरणे म्रियते च प्रमीयते । सन्तिष्ठते समाप्नोति विरमत्यारमत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18, "avatarnika": ""}, {"id": 33000018, "chapter_id": 7888, "verse_number": "19", "content_sanskrit": "पर्यवस्यत्युपरमत्यात्मनेपदसंस्थितौ । निर्वाति निर्वायति विध्यायत्युद्वायतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19, "avatarnika": ""}, {"id": 33000019, "chapter_id": 7888, "verse_number": "20", "content_sanskrit": "उद्वाति शाम्यतीत्येते तेजसो विरतौ तु षट् । इति भावविकाराः षट् सभेदाः प्राय ईरिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20, "avatarnika": ""}]