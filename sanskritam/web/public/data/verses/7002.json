[
  {
    "id": 20130756,
    "chapter_id": 7002,
    "verse_number": "20.1",
    "content_sanskrit": "अथ विंशो ऽध्यायः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20130757,
    "chapter_id": 7002,
    "verse_number": "20.2",
    "content_sanskrit": "समुत्थानं तु वृत्तीनां व्याख्याम्यनुपूर्वशः । यथा वस्तूद्भवं चैव काव्यानां च विकल्पनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20130758,
    "chapter_id": 7002,
    "verse_number": "20.3",
    "content_sanskrit": "एकार्णवं जगत् कृत्वा भगवानच्युतो यदा । शेते स्म नागपर्यङ्के लोकान् संक्षिप्य मायया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20130759,
    "chapter_id": 7002,
    "verse_number": "20.4",
    "content_sanskrit": "अथ वीर्यबलोन्मतावसुरौ मधुकैटभौ । तर्जयामासतुर्देवं तरसा युद्धकाङ्क्षया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20130760,
    "chapter_id": 7002,
    "verse_number": "20.5",
    "content_sanskrit": "निजबाहू विमृदनन्तौ भूतभावनमक्षयम् । जानुभिर्मुष्टिभिश्चैव योधयामासतुः प्रभुम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20130761,
    "chapter_id": 7002,
    "verse_number": "20.6",
    "content_sanskrit": "बहुभिः परुषैर्वाक्यैरन्योन्यसमभिद्रवम् । नानाधिक्षेपवचनैः कम्पयन्ताविवोदधिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20130762,
    "chapter_id": 7002,
    "verse_number": "20.7",
    "content_sanskrit": "तयोर्नानाप्रकाराणि वचांसि वदतोस्तदा । श्रुत्वा त्वभिहतमना द्रुहिणो वाक्यमब्रवीत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20130763,
    "chapter_id": 7002,
    "verse_number": "20.8",
    "content_sanskrit": "किमिदं भरतीवृत्तिर्वाग्भिरेव प्रवर्तते । उत्तरोत्तरसंबद्धा नन्विमौ निधनं नयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20130764,
    "chapter_id": 7002,
    "verse_number": "20.9",
    "content_sanskrit": "पितामहवचः श्रुत्वा प्रोवाच मधुसूदनः । कार्यहेतोर्मया ब्रह्मन् भारतीयं विनिर्मिता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20130765,
    "chapter_id": 7002,
    "verse_number": "20.10",
    "content_sanskrit": "वदतां वाक्यभूयिष्ठा भारतीयं भविष्यति । तस्मादेतौ निहन्म्यद्येत्युवाच वचनं हरिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20130766,
    "chapter_id": 7002,
    "verse_number": "20.11",
    "content_sanskrit": "शुद्धैरविकृतैरङ्गैः साङ्गहारैस्तथा भृशम् । योधयामासतुर्दैत्यौ युद्धमार्गविशारदौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20130767,
    "chapter_id": 7002,
    "verse_number": "20.12",
    "content_sanskrit": "भूमिसंयोगसंस्थानैः पदन्यासैर्हरेस्तदा । अतिभारो ऽभवद् भूमेर्भारती तत्र निर्मिता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20130768,
    "chapter_id": 7002,
    "verse_number": "20.13",
    "content_sanskrit": "वल्गितैः शार्ङ्गधनुषस्तीव्रैर्दीप्ततथैरथ । सत्वाधिकैरसंभ्रान्तैः सात्त्वती तत्र निर्मिता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20130769,
    "chapter_id": 7002,
    "verse_number": "20.14",
    "content_sanskrit": "विचित्रैरङ्गहारैस्तु देवो लीलासमन्वितैः । बबन्ध यच्छिखापाशं कैशिकी तत्र निर्मिता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20130770,
    "chapter_id": 7002,
    "verse_number": "20.15",
    "content_sanskrit": "संरम्भावेगबहुलैर्नानाचारी समुत्थितैः । नियुद्धकरणैश्चित्रैरुत्पन्नारभटी ततः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20130771,
    "chapter_id": 7002,
    "verse_number": "20.16",
    "content_sanskrit": "यां यां देवः समाचष्टे क्रियां वृत्तिषु संस्थिताम् । तां तदर्थानुगैर्जप्येऐर्द्रुहिणः प्रत्यपूजयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20130772,
    "chapter_id": 7002,
    "verse_number": "20.17",
    "content_sanskrit": "यदा हतौ तावसुरौ हरिणा मधुकैटभौ । ततो ऽब्रवीत् पद्मयोनिर्नारायणमरिन्दमम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20130773,
    "chapter_id": 7002,
    "verse_number": "20.18",
    "content_sanskrit": "अहो विचित्रैर्विषमैः स्फुटैः सललितैरपि । अङ्गहारैः कृतं देव त्वया दानवनाशनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20130774,
    "chapter_id": 7002,
    "verse_number": "20.19",
    "content_sanskrit": "तस्मादयं हि लोकस्य नियुद्धसमयक्रमः । सर्वशस्त्रविमोक्षेषु न्यायसंज्ञो भविष्यति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20130775,
    "chapter_id": 7002,
    "verse_number": "20.20",
    "content_sanskrit": "न्यायाश्रितैरङ्गहारैर्न्यायाच्चैव समुत्थितैः । यस्माद्युद्धानि वर्तन्ते तस्मान्यायाः प्रकीर्तिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20130776,
    "chapter_id": 7002,
    "verse_number": "20.21",
    "content_sanskrit": "[चारीषु च समुत्पन्नो नानाचारीसमाश्रयः । न्यायसंज्ञः कृतो ह्येष द्रुहिणेन महात्मना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20130777,
    "chapter_id": 7002,
    "verse_number": "20.22",
    "content_sanskrit": "ततो वेदेषु निक्षिप्ता द्रुहिणेन महात्मना । पुनरिष्वस्त्रजाते च नानाचारीसमाकुले ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20130778,
    "chapter_id": 7002,
    "verse_number": "20.23",
    "content_sanskrit": "पुनर्नाट्यप्रयोगेषु नानाभावसम्न्विताः । वृत्तिसंज्ञाः कृता ह्येताः काव्यबन्धसमाश्रयाः] ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20130779,
    "chapter_id": 7002,
    "verse_number": "20.24",
    "content_sanskrit": "चरितैर्यस्य देवस्य जप्यं यद्यादृशं कृतम् । ऋषिभिस्तादृशी वृत्तिअः कृता पाठ्यादिसंयुता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20130780,
    "chapter_id": 7002,
    "verse_number": "20.25",
    "content_sanskrit": "नाट्यवेदसमुत्पना वागङ्गाभिनयात्मिका । मया काव्यक्रिअयाहेतोः प्रक्षिप्ता द्रुहिणाज्ञया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20130781,
    "chapter_id": 7002,
    "verse_number": "20.26",
    "content_sanskrit": "ऋग्वेदाद्भारती क्षिप्ता यजुर्वेदाच्च सात्त्वती । कैशिकी सामवेदाच्च शेषा चाथर्वणादपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20130782,
    "chapter_id": 7002,
    "verse_number": "20.27",
    "content_sanskrit": "या वाक्प्रधाना पुरुषप्रयोज्या स्त्रीवर्जिता संकृतपाठ्ययुक्ता । स्वनामधेयैर्भरतैः प्रयुक्ता सा भारती नाम भवेत्तु वृत्तिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20130783,
    "chapter_id": 7002,
    "verse_number": "20.28",
    "content_sanskrit": "भेदास्तस्यास्तु विज्ञेयाश्चत्वारो ऽङ्गत्वमागताः । प्ररोचनामुखं चैव वीथी प्रहसनं तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20130784,
    "chapter_id": 7002,
    "verse_number": "20.29",
    "content_sanskrit": "जयाभ्युदयिनी चैव मङ्गल्या विजयावहा । सर्वपापप्रशमनी पूर्वरङ्गे प्ररोचना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20130785,
    "chapter_id": 7002,
    "verse_number": "20.30",
    "content_sanskrit": "[उपक्षेपेण काव्यस्य हेतुयुक्तिसमाश्रया । सिद्धेनामन्त्रणा या तु विज्ञेया सा प्ररोचना] ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20130786,
    "chapter_id": 7002,
    "verse_number": "20.31",
    "content_sanskrit": "नटी विदूषको वापि पारिपार्श्विक एव वा । सूत्रधारेण सहिताः संलापं यत्तु कुर्वते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20130787,
    "chapter_id": 7002,
    "verse_number": "20.32",
    "content_sanskrit": "चित्रैर्वाक्यैः स्वकार्यारोत्थैर्वीत्थ्यङ्गेरन्यथापि वा । आमुखं तत्तु विज्ञेयं बुधैः प्रस्तावनापि वा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20130788,
    "chapter_id": 7002,
    "verse_number": "20.33",
    "content_sanskrit": "[लक्षणं पूर्वमुक्तं तु वीत्थ्याः प्रहसनस्य च । आमुखाङ्गान्यतो वक्ष्ये यथावदनुपूर्वशः] ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20130789,
    "chapter_id": 7002,
    "verse_number": "20.34",
    "content_sanskrit": "उद्धात्यकः कथोद्धातः प्रयोगातिशयस्तथा । प्रवृत्तकावलगिते पञ्चाङ्गान्यामुखस्य तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20130790,
    "chapter_id": 7002,
    "verse_number": "20.35",
    "content_sanskrit": "उद्धात्यकावलगितलक्षणं कथितं मया । शेषाणां लक्षणं विप्रा व्याख्यास्याम्यानुपूर्वशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20130791,
    "chapter_id": 7002,
    "verse_number": "20.36",
    "content_sanskrit": "सुत्रधारस्य वाक्यं वा यत्र वाक्यार्थमेव वा । गृहीतां प्रविशेत्पात्रं कथोद्धातः स कीर्तितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20130792,
    "chapter_id": 7002,
    "verse_number": "20.37",
    "content_sanskrit": "प्रयोगे तु प्रयोगं तु सूत्रधारः प्रयोजयेत् । ततश्च प्रविशेत्पात्रं प्रयोगातिशयो हि सः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20130793,
    "chapter_id": 7002,
    "verse_number": "20.38",
    "content_sanskrit": "कालप्रवृत्तिमाश्रित्य वर्णना या प्रयुज्यते । तदाश्रयाच्च पात्रस्य प्रवेशस्तत्प्रवृत्तकम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
