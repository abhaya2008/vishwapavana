    "avatarnika": ""
  },
  {
    "id": 20130800,
    "chapter_id": 7002,
    "verse_number": "20.45",
    "content_sanskrit": "उत्थापकश्च परिवर्तकश्च सल्लापकश्च संघात्यः । चत्वारो ऽस्या भेदा विज्ञेया नाट्यकोविदैअः ॥",
