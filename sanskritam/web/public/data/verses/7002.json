    "avatarnika": ""
  },
  {
    "id": 20130798,
    "chapter_id": 7002,
    "verse_number": "20.43",
    "content_sanskrit": "वागङ्गाभिनयवती सत्त्वोत्थानवचनप्रकरणेषु । सत्त्वाधिकारयुक्ता विज्ञेया सात्त्वती वृत्तिः ॥",
