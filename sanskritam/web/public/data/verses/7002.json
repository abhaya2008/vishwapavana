  },
  {
    "id": 20130810,
    "chapter_id": 7002,
    "verse_number": "20.55",
    "content_sanskrit": "[बहुवद्यनृत्तगीता शृङ्गाराभिनयचित्रनैपथ्या । माल्यालङ्कारयुक्ता प्रशस्तवेषा च कान्ता च ॥",
