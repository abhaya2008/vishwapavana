[{"id": 2024071, "chapter_id": 1515, "verse_number": "३-१५३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2024072, "chapter_id": 1515, "verse_number": "३-१५३-१", "content_sanskrit": "ततः संहृत्य विपुलं तद्वपुः कामवर्धितम्।\nभीमसेनं पुनर्दोर्भ्यां पर्यष्वजत वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2024073, "chapter_id": 1515, "verse_number": "३-१५३-२", "content_sanskrit": "परिष्वक्तस्य तस्याशु भ्रात्रा भीमस्य भारत।\nश्रमो नाशमुपागच्छत्सर्वं चासीत्प्रदक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2024074, "chapter_id": 1515, "verse_number": "३-१५३-३", "content_sanskrit": "[बलं चातिबलो मेने न मेऽस्ति सदृशो महान्।]\nततः पुनरथोवाच पर्यश्रुनयनो हरिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2024075, "chapter_id": 1515, "verse_number": "३-१५३-४", "content_sanskrit": "भीममाभाष्य सौहार्दाद्बाष्पगद्गदया गिरा।\nगच्छ वीर स्वमावासं स्मर्तव्योऽस्मि कथान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2024076, "chapter_id": 1515, "verse_number": "३-१५३-५", "content_sanskrit": "इहस्थश्च कुरुश्रेष्ठ न निवेद्योस्मि कस्यचित्।\nधनदस्यालयाच्चापि विसृष्टानां महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2024077, "chapter_id": 1515, "verse_number": "३-१५३-६", "content_sanskrit": "एष काल इहायातुं देवगन्धर्वयोषिताम्।\nममापि सफलं च क्षुः स्मारितश्चास्मि राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2024078, "chapter_id": 1515, "verse_number": "३-१५३-७", "content_sanskrit": "[रामाभिधानं विष्णुं हि जगद्धृदयनन्दनम्।\nसीतावक्रारविन्दार्कं दशास्यध्वान्तभास्करम् ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2024079, "chapter_id": 1515, "verse_number": "३-१५३-८", "content_sanskrit": "मानुषं गात्रसंस्पर्शं गत्वा भीम त्वया सह।\nतदस्मद्दर्शनं वीर कौन्तेयामाघमस्तु ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2024080, "chapter_id": 1515, "verse_number": "३-१५३-९", "content_sanskrit": "भ्रातृत्वं त्वं पुरस्कृत्य वरं वरय भारत।\nयदि तावन्मया क्षुद्रा गत्वा वारणसाह्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2024081, "chapter_id": 1515, "verse_number": "३-१५३-१०", "content_sanskrit": "धार्तराष्ट्रा निहन्तव्या यावदेतत्करोम्यहम्।\nशिलया नगरं वा तन्मर्दितव्यं मया यदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2024082, "chapter_id": 1515, "verse_number": "३-१५३-११", "content_sanskrit": "[बद्ध्वा दुर्योधनं चाद्य आनयामि तवान्तिकम्।]\nयावदेतत्करोम्यद्यकामं तव महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2024083, "chapter_id": 1515, "verse_number": "३-१५३-१२", "content_sanskrit": "भीमसेनस्तु तद्वाक्यं श्रुत्वा तस् महात्मनः।\nप्रत्युवाच हनून्तं प्रहृष्टेनान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2024084, "chapter_id": 1515, "verse_number": "३-१५३-१३", "content_sanskrit": "कृतमेव त्वया सर्वं मम वानरपुङ्गव।\nस्वस्ति तेऽस्तु महाबाहो कामये त्वां प्रसीदमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2024085, "chapter_id": 1515, "verse_number": "३-१५३-१४", "content_sanskrit": "सनाथाः पाण्डवाः सर्वे त्वया नाथेन वीर्यवन्।\nतवैव तेजसा सर्वान्विजेष्यामो वयं परान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2024086, "chapter_id": 1515, "verse_number": "३-१५३-१५", "content_sanskrit": "एवमुक्तस्तु हनुमान्भीमसेनमभाषत।\nभ्रातृत्वात्सौहृदाच्चैव करिष्यामि प्रियं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2024087, "chapter_id": 1515, "verse_number": "३-१५३-१६", "content_sanskrit": "चमूं विगाह्य शत्रूणां परशक्तिसमाकुलाम्।\nयदा सिंहरवं वीर करिष्यसि महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2024088, "chapter_id": 1515, "verse_number": "३-१५३-१७", "content_sanskrit": "तदाहं बृंहयिष्यामि स्वरवेण रवं तव।\n`यं श्रुत्वैव भविष्यन्ति व्यसवस्तेऽरयो रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2024089, "chapter_id": 1515, "verse_number": "३-१५३-१८", "content_sanskrit": "विजयस्य ध्वजस्थश्च नादान्मोक्ष्पामि दारुणान्।\nशत्रूणां ये प्राणहराः सुखं येन हनिष्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2024090, "chapter_id": 1515, "verse_number": "३-१५३-१९", "content_sanskrit": "एवमाभाष्य हनुमांस्तदा पाण्डवनन्दनम्।\nमार्गमाख्याय भीमाय तत्रैवान्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2024091, "chapter_id": 1515, "verse_number": "३-१५३-२०", "content_sanskrit": "गते तस्मिन्हरिवरे भीमोपि बलिनांवरः।\nतेन मार्गेण विपुलं व्यचरद्गन्धमादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2024092, "chapter_id": 1515, "verse_number": "३-१५३-२१", "content_sanskrit": "अनुस्मरन्वपुस्तस्य श्रियं चाप्रतिमां भुवि।\nमाहात्म्यमनुभावं च स्मरन्दाशरथेर्ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2024093, "chapter_id": 1515, "verse_number": "३-१५३-२२", "content_sanskrit": "स तानि रमणीयानि वनान्युपवनानि च।\nविलोलयामास तदा सौगन्धिकवनेप्सया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2024094, "chapter_id": 1515, "verse_number": "३-१५३-२३", "content_sanskrit": "फुल्लपद्मविचित्राणि सरांसि सरितस्तथा।\nनानाकुसुमचित्राणि पुष्पितानि वनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2024095, "chapter_id": 1515, "verse_number": "३-१५३-२४", "content_sanskrit": "मत्तवारणयुथानि पङ्कक्लिन्नानि भारत।\nवर्षतामिव मेघानां वृन्दानि ददृशे तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2024096, "chapter_id": 1515, "verse_number": "३-१५३-२५", "content_sanskrit": "हरिणैश्चपलापाङ्गैर्हरिणीसहितैर्वनम्।\nसशष्पकवलैः श्रीमान्पथि दृष्ट्वा द्रुतं ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2024097, "chapter_id": 1515, "verse_number": "३-१५३-२६", "content_sanskrit": "महिषैश्च वराहैश्च शार्दूलैश्च निषेवितम्।\nव्यपेतभीर्गिरिं शौर्याद्भीमसेनो व्यगाहत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2024098, "chapter_id": 1515, "verse_number": "३-१५३-२७", "content_sanskrit": "कुसुमानतशाखैश्च ताम्रपल्लवकोमलैः।\nयाच्यमान इवारण्ये द्रुमैर्मारुतकम्पितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2024099, "chapter_id": 1515, "verse_number": "३-१५३-२८", "content_sanskrit": "कृतपद्माञ्जलिपुटा मत्तषट्पदसेविताः।\nप्रियतीर्थवना मार्गे पद्मिनीः समतिक्रमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2024100, "chapter_id": 1515, "verse_number": "३-१५३-२९", "content_sanskrit": "सज्जमानमनोदृष्टिः फुल्लेषु गिरिसानुषु।\nद्रौपदीवाक्यपाथेयो भीमो भीमपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2024101, "chapter_id": 1515, "verse_number": "३-१५३-३०", "content_sanskrit": "परिवृत्तेऽहनि ततः प्रकीर्णहरिणे वने।\nकाञ्चनैर्विलैः पद्मैर्ददर्श विपुलां नदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2024102, "chapter_id": 1515, "verse_number": "३-१५३-३१", "content_sanskrit": "हंसकारण्डवयुतां चक्रवाकोपशोभिताम्।\nरचितामिव तस्याद्रेर्भालां विमलपङ्कजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2024103, "chapter_id": 1515, "verse_number": "३-१५३-३२", "content_sanskrit": "तस्यां नद्यां महासत्वः सौगन्धिकवनं महत्।\nअपश्यत्प्रीतिजननं बालार्कसदृशद्युति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2024104, "chapter_id": 1515, "verse_number": "३-१५३-३३", "content_sanskrit": "तद्दृष्ट्वा लब्धकामः स मनसा पाण्डुनन्दनः।\nवनवासपरिक्लिष्टां जगाम मनसा प्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2024105, "chapter_id": 1515, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि त्रिपञ्चाशदधिकशततमोऽध्यायः ॥ १५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]