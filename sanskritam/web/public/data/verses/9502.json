[{"id": 5000502000, "chapter_id": 9502, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे पञ्चनवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000502001, "chapter_id": 9502, "verse_number": "६-९५-१", "content_sanskrit": "आर्तानां राक्षसीनां तु लङ्कायां वै कुले कुले।\nरावणः करुणं शब्दं शुश्राव परिदेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000502002, "chapter_id": 9502, "verse_number": "६-९५-२", "content_sanskrit": "स तु दीर्घं विनिःश्वस्य मुहूर्तं ध्यानमास्थितः।\nबभूव परमक्रुद्धो रावणो भीमदर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000502003, "chapter_id": 9502, "verse_number": "६-९५-३", "content_sanskrit": "संदश्य दशनैरोष्ठं क्रोधसंरक्तलोचनः।\nराक्षसैरपि दुर्दर्शः कालाग्निरिव मूर्तिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000502004, "chapter_id": 9502, "verse_number": "६-९५-४", "content_sanskrit": "उवाच च समीपस्थान् राक्षसान् राक्षसेश्वरः।\nक्रोधाव्यक्तकथस्तत्र निर्दहन्निव चक्षुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000502005, "chapter_id": 9502, "verse_number": "६-९५-५", "content_sanskrit": "महोदरं महापार्श्वं विरूपाक्षं च राक्षसम्।\nशीघ्रं वदत सैन्यानि निर्यातेति ममाज्ञया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000502006, "chapter_id": 9502, "verse_number": "६-९५-६", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा राक्षसास्ते भयार्दिताः।\nचोदयामासुरव्यग्रान् राक्षसांस्तान् नृपाज्ञया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000502007, "chapter_id": 9502, "verse_number": "६-९५-७", "content_sanskrit": "ते तु सर्वे तथेत्युक्त्वा राक्षसा भीमदर्शनाः।\nकृतस्वस्त्ययनाः सर्वे ते रणाभिमुखा ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000502008, "chapter_id": 9502, "verse_number": "६-९५-८", "content_sanskrit": "प्रतिपूज्य यथान्यायं रावणं ते महारथाः।\nतस्थुः प्राञ्जलयः सर्वे भर्तुर्विजयकाङ्क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000502009, "chapter_id": 9502, "verse_number": "६-९५-९", "content_sanskrit": "ततोवाच प्रहस्यैतान् रावणः क्रोधमूर्च्छितः।\nमहोदरमहापार्श्वौ विरूपाक्षं च राक्षसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000502010, "chapter_id": 9502, "verse_number": "६-९५-१०", "content_sanskrit": "अद्य बाणैर्धनुर्मुक्तैर्युगान्तादित्यसंनिभैः।\nराघवं लक्ष्मणं चैव नेष्यामि यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000502011, "chapter_id": 9502, "verse_number": "६-९५-११", "content_sanskrit": "खरस्य कुम्भकर्णस्य प्रहस्तेन्द्रजितोस्तथा।\nकरिष्यामि प्रतीकारमद्य शत्रुवधादहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000502012, "chapter_id": 9502, "verse_number": "६-९५-१२", "content_sanskrit": "नैवान्तरिक्षं न दिशो न च द्यौर्नापि सागराः।\nप्रकाशत्वं गमिष्यन्ति मद‍्बाणजलदावृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000502013, "chapter_id": 9502, "verse_number": "६-९५-१३", "content_sanskrit": "अद्य वानरमुख्यानां तानि यूथानि भागशः।\nधनुषा शरजालेन वधिष्यामि पतत्त्रिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000502014, "chapter_id": 9502, "verse_number": "६-९५-१४", "content_sanskrit": "अद्य वानरसैन्यानि रथेन पवनौजसा।\nधनुःसमुद्रादुद्भूतैर्मथिष्यामि शरोर्मिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000502015, "chapter_id": 9502, "verse_number": "६-९५-१५", "content_sanskrit": "व्याकोशपद्मवक्त्राणि पद्मकेसरवर्चसाम्।\nअद्य यूथतटाकानि गजवत् प्रमथाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000502016, "chapter_id": 9502, "verse_number": "६-९५-१६", "content_sanskrit": "सशरैरद्य वदनैः संख्ये वानरयूथपाः।\nमण्डयिष्यन्ति वसुधां सनालैरिव पङ्कजैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000502017, "chapter_id": 9502, "verse_number": "६-९५-१७", "content_sanskrit": "अद्य यूथप्रचण्डानां हरीणां द्रुमयोधिनाम्।\nमुक्तेनैकेषुणा युद्धे भेत्स्यामि च शतं शतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000502018, "chapter_id": 9502, "verse_number": "६-९५-१८", "content_sanskrit": "हतो भ्राता च येषां वै येषां च तनयो हतः।\nवधेनाद्य रिपोस्तेषां करोम्यश्रुप्रमार्जनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000502019, "chapter_id": 9502, "verse_number": "६-९५-१९", "content_sanskrit": "अद्य मद‍्बाणनिर्भिन्नैः प्रस्तीर्णैर्गतचेतनैः।\nकरोमि वानरैर्युद्धे यत्नावेक्ष्यतलां महीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000502020, "chapter_id": 9502, "verse_number": "६-९५-२०", "content_sanskrit": "अद्य काकाश्च गृध्राश्च ये च मांसाशिनोऽपरे।\nसर्वांस्तांस्तर्पयिष्यामि शत्रुमांसैः शराहतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000502021, "chapter_id": 9502, "verse_number": "६-९५-२१", "content_sanskrit": "कल्प्यतां मे रथः शीघ्रं क्षिप्रमानीयतां धनुः।\nअनुप्रयान्तु मां युद्धे येऽत्र शिष्टा निशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000502022, "chapter_id": 9502, "verse_number": "६-९५-२२", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा महापार्श्वोऽब्रवीद् वचः।\nबलाध्यक्षान् स्थितांस्तत्र बलं संत्वर्यतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000502023, "chapter_id": 9502, "verse_number": "६-९५-२३", "content_sanskrit": "बलाध्यक्षास्तु संयुक्ता राक्षसांस्तान् गृहे गृहे।\nचोदयन्तः परिययुर्लङ्कां लघुपराक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000502024, "chapter_id": 9502, "verse_number": "६-९५-२४", "content_sanskrit": "ततो मुहूर्तान्निष्पेतू राक्षसा भीमदर्शनाः।\nनदन्तो भीमवदना नानाप्रहरणैर्भुजैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000502025, "chapter_id": 9502, "verse_number": "६-९५-२५", "content_sanskrit": "असिभिः पट्टिशैः शूलैर्गदाभिर्मुसलैर्हलैः।\nशक्तिभिस्तीक्ष्णधाराभिर्महद्भिः कूटमुद‍्गरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000502026, "chapter_id": 9502, "verse_number": "६-९५-२६", "content_sanskrit": "यष्टिभिर्विविधैश्चक्रैर्निशितैश्च परश्वधैः।\nभिन्दिपालैः शतघ्नीभिरन्यैश्चापि वरायुधैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000502027, "chapter_id": 9502, "verse_number": "६-९५-२७", "content_sanskrit": "अथानयन् बलाध्यक्षाश्चत्वारो रावणाज्ञया।\nरथानां नियुतं साग्रं नागानां नियुतत्रयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000502028, "chapter_id": 9502, "verse_number": "६-९५-२८", "content_sanskrit": "अश्वानां षष्टिकोट्यस्तु खरोष्ट्राणां तथैव च।\nपदातयस्त्वसंख्याता जग्मुस्ते राजशासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000502029, "chapter_id": 9502, "verse_number": "६-९५-२९", "content_sanskrit": "बलाध्यक्षाश्च संस्थाप्य राज्ञः सेनां पुरःस्थिताम्।\nएतस्मिन्नन्तरे सूतः स्थापयामास तं रथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000502030, "chapter_id": 9502, "verse_number": "६-९५-३०", "content_sanskrit": "दिव्यास्त्रवरसम्पन्नं नानालंकारभूषितम्।\nनानायुधसमाकीर्णं किङ्किणीजालसंयुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000502031, "chapter_id": 9502, "verse_number": "६-९५-३१", "content_sanskrit": "नानारत्नपरिक्षिप्तं रत्नस्तम्भैर्विराजितम्।\nजाम्बूनदमयैश्चैव सहस्रकलशैर्वृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000502032, "chapter_id": 9502, "verse_number": "६-९५-३२", "content_sanskrit": "तं दृष्ट्वा राक्षसाः सर्वे विस्मयं परमं गताः।\nतं दृष्ट्वा सहसोत्थाय रावणो राक्षसेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000502033, "chapter_id": 9502, "verse_number": "६-९५-३३", "content_sanskrit": "कोटिसूर्यप्रतीकाशं ज्वलन्तमिव पावकम्।\nद्रुतं सूतसमायुक्तं युक्ताष्टतुरगं रथम्।\nआरुरोह तदा भीमं दीप्यमानं स्वतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000502034, "chapter_id": 9502, "verse_number": "६-९५-३४", "content_sanskrit": "ततः प्रयातः सहसा राक्षसैर्बहुभिर्वृतः।\nरावणः सत्त्वगाम्भीर्याद् दारयन्निव मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000502035, "chapter_id": 9502, "verse_number": "६-९५-३५", "content_sanskrit": "ततश्चासीन्महानादस्तूर्याणां च ततस्ततः।\nमृदङ्गैः पटहैः शङ्खैः कलहैः सह रक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000502036, "chapter_id": 9502, "verse_number": "६-९५-३६", "content_sanskrit": "आगतो रक्षसां राजा छत्रचामरसंयुतः।\nसीतापहारी दुर्वृत्तो ब्रह्मघ्नो देवकण्टकः।\nयोद‍्धुं रघुवरेणेति शुश्रुवे कलहध्वनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000502037, "chapter_id": 9502, "verse_number": "६-९५-३७", "content_sanskrit": "तेन नादेन महता पृथिवी समकम्पत।\nतं शब्दं सहसा श्रुत्वा वानरा दुद्रुवुर्भयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000502038, "chapter_id": 9502, "verse_number": "६-९५-३८", "content_sanskrit": "रावणस्तु महाबाहुः सचिवैः परिवारितः।\nआजगाम महातेजा जयाय विजयं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000502039, "chapter_id": 9502, "verse_number": "६-९५-३९", "content_sanskrit": "रावणेनाभ्यनुज्ञातौ महापार्श्वमहोदरौ।\nविरूपाक्षश्च दुर्धर्षो रथानारुरुहुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000502040, "chapter_id": 9502, "verse_number": "६-९५-४०", "content_sanskrit": "ते तु हृष्टाभिनर्दन्तो भिन्दन्त इव मेदिनीम्।\nनादं घोरं विमुञ्चन्तो निर्ययुर्जयकाङ्क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000502041, "chapter_id": 9502, "verse_number": "६-९५-४१", "content_sanskrit": "ततो युद्धाय तेजस्वी रक्षोगणबलैर्वृतः।\nनिर्ययावुद्यतधनुः कालान्तकयमोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000502042, "chapter_id": 9502, "verse_number": "६-९५-४२", "content_sanskrit": "ततः प्रजविताश्वेन रथेन स महारथः।\nद्वारेण निर्ययौ तेन यत्र तौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000502043, "chapter_id": 9502, "verse_number": "६-९५-४३", "content_sanskrit": "ततो नष्टप्रभः सूर्यो दिशश्च तिमिरावृताः।\nद्विजाश्च नेदुर्घोराश्च संचचाल च मेदिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000502044, "chapter_id": 9502, "verse_number": "६-९५-४४", "content_sanskrit": "ववर्ष रुधिरं देवश्चस्खलुश्च तुरंगमाः।\nध्वजाग्रे न्यपतद् गृध्रो विनेदुश्चाशिवं शिवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000502045, "chapter_id": 9502, "verse_number": "६-९५-४५", "content_sanskrit": "नयनं चास्फुरद् वामं वामो बाहुरकम्पत।\nविवर्णवदनश्चासीत् किंचिदभ्रश्यत स्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000502046, "chapter_id": 9502, "verse_number": "६-९५-४६", "content_sanskrit": "ततो निष्पततो युद्धे दशग्रीवस्य रक्षसः।\nरणे निधनशंसीनि रूपाण्येतानि जज्ञिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000502047, "chapter_id": 9502, "verse_number": "६-९५-४७", "content_sanskrit": "अन्तरिक्षात् पपातोल्का निर्घातसमनिःस्वना।\nविनेदुरशिवा गृध्रा वायसैरभिमिश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000502048, "chapter_id": 9502, "verse_number": "६-९५-४८", "content_sanskrit": "एतानचिन्तयन् घोरानुत्पातान् समवस्थितान्।\nनिर्ययौ रावणो मोहाद् वधार्थं कालचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000502049, "chapter_id": 9502, "verse_number": "६-९५-४९", "content_sanskrit": "तेषां तु रथघोषेण राक्षसानां महात्मनाम्।\nवानराणामपि चमूर्युद्धायैवाभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000502050, "chapter_id": 9502, "verse_number": "६-९५-५०", "content_sanskrit": "तेषां तु तुमुलं युद्धं बभूव कपिरक्षसाम्।\nअन्योन्यमाह्वयानानां क्रुद्धानां जयमिच्छताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000502051, "chapter_id": 9502, "verse_number": "६-९५-५१", "content_sanskrit": "ततः क्रुद्धो दशग्रीवः शरैः काञ्चनभूषणैः।\nवानराणामनीकेषु चकार कदनं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000502052, "chapter_id": 9502, "verse_number": "६-९५-५२", "content_sanskrit": "निकृत्तशिरसः केचिद् रावणेन वलीमुखाः।\nकेचिद् विच्छिन्नहृदयाः केचिच्छ्रोत्रविवर्जिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000502053, "chapter_id": 9502, "verse_number": "६-९५-५३", "content_sanskrit": "निरुच्छ्वासा हताः केचित् केचित् पार्श्वेषु दारिताः।\nकेचिद् विभिन्नशिरसः केचिच्चक्षुर्विनाकृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000502054, "chapter_id": 9502, "verse_number": "६-९५-५४", "content_sanskrit": "दशाननः क्रोधविवृत्तनेत्रो\nयतो यतोऽभ्येति रथेन संख्ये।\nततस्ततस्तस्य शरप्रवेगं\nसोढुं न शेकुर्हरियूथपास्ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000502055, "chapter_id": 9502, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे पञ्चनवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]