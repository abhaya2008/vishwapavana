[{"id": 2001552, "chapter_id": 1028, "verse_number": "१-२९-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001553, "chapter_id": 1028, "verse_number": "१-२९-१", "content_sanskrit": "तस्य कण्ठमनुप्राप्तो ब्राह्मणः सह भार्यया।\nदहन्दीप्त इवाङ्गारस्तमुवाचान्तरिक्षगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001554, "chapter_id": 1028, "verse_number": "१-२९-२", "content_sanskrit": "द्विजोत्तम विनिर्गच्छ तूर्णमास्यादपावृतात्।\nन हि मे ब्राह्मणो वध्यः पापेष्वपि रतः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001555, "chapter_id": 1028, "verse_number": "१-२९-३x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001556, "chapter_id": 1028, "verse_number": "१-२९-३", "content_sanskrit": "ब्रुवाणमेवं गरुडं ब्राह्मणः प्रत्यभाषत।\nनिषादी मम भार्येयं निर्गच्छतु मया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001557, "chapter_id": 1028, "verse_number": "१-२९-४x", "content_sanskrit": "गरुड उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001558, "chapter_id": 1028, "verse_number": "१-२९-४", "content_sanskrit": "एतामपि निषादीं त्वं परिगृह्याशु निष्पत।\nतूर्णं संभावयात्मानमजीर्णं मम तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001559, "chapter_id": 1028, "verse_number": "१-२९-५x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001560, "chapter_id": 1028, "verse_number": "१-२९-५", "content_sanskrit": "ततः स विप्रो निष्क्रान्तो निषादीसहितस्तदा।\nवर्धयित्वा च गरुडमिष्टं देशं जगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001561, "chapter_id": 1028, "verse_number": "१-२९-६", "content_sanskrit": "सहभार्ये विनिष्क्रान्ते तस्मिन्विप्रे स पक्षिराट्।\nवितत्य पक्षावाकाशमुत्पपात मनोजवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001562, "chapter_id": 1028, "verse_number": "१-२९-७", "content_sanskrit": "ततोऽपश्यत्स्वपितरं पृष्टश्चाख्यातवान्पितुः।\nयथान्यायममेयात्मा तं चोवाच महानृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001563, "chapter_id": 1028, "verse_number": "१-२९-८x", "content_sanskrit": "कश्यप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001564, "chapter_id": 1028, "verse_number": "१-२९-८", "content_sanskrit": "कच्चिद्वः कुशलं नित्यं भोजने बहुलं सुत।\nकच्चिच्च मानुषे लोके तवान्नं विद्यते बहु॥\nक्व गन्तास्यतिवेगेन मम त्वं वक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001565, "chapter_id": 1028, "verse_number": "१-२९-९x", "content_sanskrit": "गरुड उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001566, "chapter_id": 1028, "verse_number": "१-२९-९", "content_sanskrit": "माता मे कुशला शश्वत्तथा भ्राता तथा ह्यहम्।\nन हि मे कुशलं तात भोजने बहुले सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001567, "chapter_id": 1028, "verse_number": "१-२९-१०", "content_sanskrit": "अहं हि सर्पैः प्रहितः सोममाहर्तुमुत्तमम्।\nमहातुर्दास्यविमोक्षार्थमाहरिष्ये तमद्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001568, "chapter_id": 1028, "verse_number": "१-२९-११", "content_sanskrit": "मात्रा चात्र समादिष्टो निषादान्भक्षयेति ह।\nन च मे तृप्तिरभवद्भक्षयित्वा सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001569, "chapter_id": 1028, "verse_number": "१-२९-१२", "content_sanskrit": "तस्माद्भक्ष्यं त्वमपरं भगवन्प्रदिशस्व मे।\nयद्भुक्त्वाऽमृतमाहर्तुं समर्तः स्यामहं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001570, "chapter_id": 1028, "verse_number": "१-२९-१३", "content_sanskrit": "क्षुत्पिपासाविघातार्थं भक्ष्यमाख्यातु मे भवान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001571, "chapter_id": 1028, "verse_number": "१-२९-१३x", "content_sanskrit": "कश्यप उवाच।\nइदं सरो महापुण्यं देवलोकेऽपि विश्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2001572, "chapter_id": 1028, "verse_number": "१-२९-१४", "content_sanskrit": "यत्र कूर्माग्रजं हस्ती सदा कर्षत्यवाङ्मुखः।\nतयोर्जन्मान्तरे वैरं संप्रवक्ष्याम्यसोषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2001573, "chapter_id": 1028, "verse_number": "१-२९-१५", "content_sanskrit": "तन्मे तत्त्वं निबोधस्य यत्प्रमाणौ च तावुभौ।\nशृणु त्वं वत्स भद्रं ते कथां वैराग्यवर्धिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2001574, "chapter_id": 1028, "verse_number": "१-२९-१६", "content_sanskrit": "पित्रोरर्थविभागे वै समुत्पन्नां पुराण्डज।\nआसीद्विभावसुर्नाम महर्षिः कोपनो भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2001575, "chapter_id": 1028, "verse_number": "१-२९-१७", "content_sanskrit": "भ्राता तस्यानुजश्चासीत्सुप्रतीको महातपाः।\nस नेच्छति धनं भ्रात्रा सहैकस्थं महामुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2001576, "chapter_id": 1028, "verse_number": "१-२९-१८", "content_sanskrit": "विभागं कीर्तयत्येव सुप्रतीको हि नित्यशः।\nअथाब्रवीच्च तं भ्राता सुप्रतीकं विभावसुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2001577, "chapter_id": 1028, "verse_number": "१-२९-१९", "content_sanskrit": "विभागे बहवो दोषा भविष्यन्ति महातपः।\nविभागं बहवो मोहात्कर्तुमिच्छन्ति नित्यशः।\nततो विभक्तास्त्वन्योन्यं नाद्रियन्तेऽर्थमोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2001578, "chapter_id": 1028, "verse_number": "१-२९-२०", "content_sanskrit": "ततः स्वार्थपरान्मूढान्पृथग्भूतान्स्वकैर्धनैः।\nविदित्वा भेदयन्त्येतानमित्रा मित्ररूपिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2001579, "chapter_id": 1028, "verse_number": "१-२९-२१", "content_sanskrit": "विदित्वा चापरे भिन्नानन्तरेषु पतन्त्यथ।\nभिन्नानामतुलो नाशः क्षिप्रमेव प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2001580, "chapter_id": 1028, "verse_number": "१-२९-२२", "content_sanskrit": "तस्माद्विभागं भ्रातॄणां न प्रशंसन्ति साधवः।\nएवमुक्तः सुप्रतीको भागं कीर्तयतेऽनिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2001581, "chapter_id": 1028, "verse_number": "१-२९-२३", "content_sanskrit": "एवं निर्बध्यमानस्तु शशापैनं विभावसुः।\nगुरुशास्त्रेऽनिबद्धानामन्योन्येनाभिशङ्किनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2001582, "chapter_id": 1028, "verse_number": "१-२९-२४", "content_sanskrit": "नियन्तु न हि शक्यस्त्वं भेदतो धनमिच्छसि।\nयस्मात्तस्मात्सुप्रतीक हस्तित्वं समवाप्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2001583, "chapter_id": 1028, "verse_number": "१-२९-२५x", "content_sanskrit": "कश्यप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2001584, "chapter_id": 1028, "verse_number": "१-२९-२५", "content_sanskrit": "शप्तस्त्वेवं सुप्रतीको विभावसुमथाब्रवीत्।\nत्वमप्यन्तर्जलचरः कच्छपः संभविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2001585, "chapter_id": 1028, "verse_number": "१-२९-२६", "content_sanskrit": "एवमन्योन्यशापात्तौ सुप्रतीकविभावसू।\nगजकच्छपतां प्राप्तावर्थार्थं मूढचेतसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2001586, "chapter_id": 1028, "verse_number": "१-२९-२७", "content_sanskrit": "रोषदोषानुषङ्गेण तिर्यग्योनिगतावपि।\nपरस्परद्वेषरतौ प्रमाणबलदर्पितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2001587, "chapter_id": 1028, "verse_number": "१-२९-२८", "content_sanskrit": "सरस्यस्मिन्महाकायौ पूर्ववैरानुसारिणौ।\nतयोरन्यतरः श्रीमान्समुपैति महागजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2001588, "chapter_id": 1028, "verse_number": "१-२९-२९", "content_sanskrit": "यस्य बृंहितशब्देन कूर्मोऽप्यन्तर्जलेशयः।\nउत्थितोऽसौ महाकायः कृत्स्नं विक्षोभयन्सरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2001589, "chapter_id": 1028, "verse_number": "१-२९-३०", "content_sanskrit": "तं दृष्ट्वाऽऽवेष्टितकरः पतत्येष गजो जलम्।\nदन्तहस्ताग्रलाङ्गूलपादवेगेन वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2001590, "chapter_id": 1028, "verse_number": "१-२९-३१", "content_sanskrit": "विक्षोभयंस्ततो नागः सरो बहुझषाकुलम्।\nकूर्मोऽप्यभ्युद्यतशिरा युद्धायाभ्येति वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2001591, "chapter_id": 1028, "verse_number": "१-२९-३२", "content_sanskrit": "षडुच्छ्रितो योजनानि गजस्तद्द्विगुणायतः।\nकूर्मस्त्रियोजनोत्सेधो दशयोजनमण्डलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2001592, "chapter_id": 1028, "verse_number": "१-२९-३३", "content_sanskrit": "तावुभौ युद्धसंमत्तौ परस्परवधैषिणौ।\nउपयुज्याशु कर्मेदं साधये हितमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2001593, "chapter_id": 1028, "verse_number": "१-२९-३४", "content_sanskrit": "महाभ्रघनसंकाशं तं भुक्त्वामृतमानय।\nमहागिरिसमप्रख्यं घोररूपं च हस्तिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2001594, "chapter_id": 1028, "verse_number": "१-२९-३५x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2001595, "chapter_id": 1028, "verse_number": "१-२९-३५", "content_sanskrit": "इत्युक्त्वा गरुडं सोऽथ माङ्गल्यमकरोत्तदा।\nयुध्यतः सह देवैस्ते युद्धे भवतु मङ्गलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2001596, "chapter_id": 1028, "verse_number": "१-२९-३६", "content_sanskrit": "पूर्णकुम्भो द्विजा गावो यच्चान्यत्किंचिदुत्तमम्।\nशुभं स्वस्त्ययनं चापि भविष्यति तवाण्डजा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2001597, "chapter_id": 1028, "verse_number": "१-२९-३७", "content_sanskrit": "युध्यमानस्य सङ्ग्रामे देवैः सार्धं महाबल।\nऋचो यजूंषि सामानि पवित्राणि हवींषि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2001598, "chapter_id": 1028, "verse_number": "१-२९-३८", "content_sanskrit": "रहस्यानि च सर्वाणि सर्वे वेदाश्च ते बलम्।\nवर्धयिष्यन्ति समरे भविष्यति खगोत्तम।\nइत्युक्तो गरुडः पित्रा गतस्तं ह्वदमन्तिकात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2001599, "chapter_id": 1028, "verse_number": "१-२९-३९", "content_sanskrit": "अपश्यन्निर्मलजलं नानापक्षिसमाकुलम्।\nस तत्स्मृत्वा पितुर्वाक्यं भीमवेगोऽन्तरिक्षगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2001600, "chapter_id": 1028, "verse_number": "१-२९-४०", "content_sanskrit": "नखेन गजमेकेन कूर्ममेकेन चाक्षिपत्।\nसधुत्पपात चाकाशं तत उच्चैर्विहङ्गमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2001601, "chapter_id": 1028, "verse_number": "१-२९-४१", "content_sanskrit": "सोऽलम्बं तीर्थणासाद्य देववृक्षानुपागमत्।\nते भीताः समकम्पन्त तस्य पक्षानिलाहताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2001602, "chapter_id": 1028, "verse_number": "१-२९-४२", "content_sanskrit": "न नो भञ्ज्यादिति तदा दिव्याः कनकशाखिनः।\nप्रचलाङ्गान्स तान्दृष्ट्वा मनोरथफलद्रुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2001603, "chapter_id": 1028, "verse_number": "१-२९-४३", "content_sanskrit": "अन्यानतुलरूपाङ्गानुपचक्राम खेचरः।\nकाञ्चनै राजतैश्चैव फलैर्वैदूर्यशाखिनः।\nसागराम्बुपरिक्षिप्तान्भ्राजमानान्महाद्रुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2001604, "chapter_id": 1028, "verse_number": "१-२९-४४", "content_sanskrit": "तेषां मध्ये महानासीत्पादपः सुमनोहरः।\nसहस्रयोजनोत्सेधो बहुशाखासमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2001605, "chapter_id": 1028, "verse_number": "१-२९-४५", "content_sanskrit": "खगानामालयो दिव्यो नाम्ना रौहिणपादपः।\nयस्य छायां समाश्रित्य सद्यो भवति निर्वृतः;॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2001606, "chapter_id": 1028, "verse_number": "१-२९-४६", "content_sanskrit": "तमुवाच खगश्रेष्ठं तत्र रौहिणपादपः।\nअतिप्रवृद्धः समुहानापतन्तं मनोजवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2001607, "chapter_id": 1028, "verse_number": "१-२९-४७x", "content_sanskrit": "रौहिण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2001608, "chapter_id": 1028, "verse_number": "१-२९-४७", "content_sanskrit": "यैषा मम महाशाखा शतयोजनमायता।\nएतामास्थाय शाखां त्वं खादेमौ गजकच्छपौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2001609, "chapter_id": 1028, "verse_number": "१-२९-४८x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2001610, "chapter_id": 1028, "verse_number": "१-२९-४८", "content_sanskrit": "ततो द्रुमं पतगसहस्रसेवितं\nमहीधरप्रतिमवपुः प्रकम्पयन्।\nखगोत्तमो द्रुतमभिपत्य वेगवा-\nन्बभञ्ज तामविरलपत्रसंचयाम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2001611, "chapter_id": 1028, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि एकोनत्रिंशोऽध्यायः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]