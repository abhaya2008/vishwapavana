[{"id": 50002217, "chapter_id": 10550, "verse_number": "1", "content_sanskrit": "ब्रह्म ह देवेभ्यो विजिग्ये तस्य ह ब्रह्मणो विजये देवा अमहीयन्त। त ऐक्षन्तास्माकमेवायं विजयोऽस्माकमेवायं महिमेति॥ ३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50002218, "chapter_id": 10550, "verse_number": "2", "content_sanskrit": "तद्धैषां विजज्ञौ। तेभ्यो ह प्रादुर्बभूव। तन्न व्यजानत किमिदं यक्षमिति॥ ३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50002219, "chapter_id": 10550, "verse_number": "3", "content_sanskrit": "तेऽग्निमब्रुवन्। जातवेद एतद् विजानीहि किमेतद् यक्षमिति। तथेति॥ ३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50002220, "chapter_id": 10550, "verse_number": "4", "content_sanskrit": "तदभ्यद्रवत्। तमभ्यवदत् कोऽसीति। अग्निर्वा अहमस्मीत्यब्रवीज्जातवेदा वा अहमस्मीति॥ ३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50002221, "chapter_id": 10550, "verse_number": "5", "content_sanskrit": "तस्मिंस्त्वयि किं वीर्यमिति। अपीदं सर्वं दहेयं यदिदं पृथिव्यामिति॥ ३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50002222, "chapter_id": 10550, "verse_number": "6", "content_sanskrit": "तस्मै तृणं निदधावेतद् दहेति। तदुपप्रेयाय सर्वजवेन। तन्न शशाक दग्धुम्। स तत एव निववृते। नैतदशकं विज्ञातुं यदेतद् यक्षमिति॥ ३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50002223, "chapter_id": 10550, "verse_number": "7", "content_sanskrit": "अथ वायुमब्रुवन्। वायवेतद् विजानीहि किमेतद् यक्षमिति तथेति॥ ३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50002224, "chapter_id": 10550, "verse_number": "8", "content_sanskrit": "तदभ्यद्रवत्। तमभ्यवदत् कोऽसीति। वायुर्वा अहमस्मीत्यब्रवीन्मातरिश्वा वा अहमस्मीति॥ ३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50002225, "chapter_id": 10550, "verse_number": "9", "content_sanskrit": "तस्मिंस्त्वयि किं वीर्यमिति। अपीदं सर्वमाददीय यदिदं पृथिव्यामिति॥ ३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50002226, "chapter_id": 10550, "verse_number": "10", "content_sanskrit": "तस्मै तृणं निदधावेतदादत्स्वेति। तदुपप्रेयाय सर्वजवेन। तन्न शशाकादातुम्। स तत एव निववृते। नैतदशकं विज्ञातुं यदेतद् यक्षमिति॥ ३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50002227, "chapter_id": 10550, "verse_number": "11", "content_sanskrit": "अथेन्द्रमब्रुवन्। मघवन्नेतद् विजानीहि किमेतद् यक्षमिति। तथेति तदभ्यद्रवत्। स तस्मात् तिरोदधे॥ ३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50002228, "chapter_id": 10550, "verse_number": "12", "content_sanskrit": "स तस्मिन्नेवाकाशे स्त्रियमाजगाम बहुशोभमानामुमां हैमवतीम्। तां होवाच किमेतद् यक्षमिति॥ ३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50002229, "chapter_id": 10550, "verse_number": "13", "content_sanskrit": "॥ इति तलवकारोनिषदि तृतीयः खण्डः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]