[{"id": 7001144000, "chapter_id": 21144, "verse_number": "२-२-३५-१", "content_sanskrit": "दक्ष उवाच ।\nदेवदेव हरे विष्णो दीनबंधो कृपानिधे ।\nमम रक्षा विधातव्या भवता साध्वरस्य च॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001144001, "chapter_id": 21144, "verse_number": "२-२-३५-२", "content_sanskrit": "रक्षकस्त्वं मखस्यैव मखकर्मा मखात्मकः ।\nकृपा विधेया यज्ञस्य भंगो भवतु न प्रभो॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001144002, "chapter_id": 21144, "verse_number": "२-२-३५-३", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nइत्थं बहुविधां दक्षः कृत्वा विज्ञप्तिमादरात् ।\nपपात पादयोस्तस्य भयव्याकुलमानसः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001144003, "chapter_id": 21144, "verse_number": "२-२-३५-४", "content_sanskrit": "उत्थाप्य तं ततो विष्णुर्दक्षं विक्लिन्नमानसम् ।\nश्रुत्वा च तस्य तद्वाक्यं कुमतेरस्मरच्छिवम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001144004, "chapter_id": 21144, "verse_number": "२-२-३५-५", "content_sanskrit": "स्मृत्वा शिवं महेशानं स्वप्रभुं परमेश्वरम् ।\nअवदच्छिवतत्त्वज्ञो दक्षं सबोधयन्हरिः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001144005, "chapter_id": 21144, "verse_number": "२-२-३५-६", "content_sanskrit": "हरिरुवाच ।\nशृणु दक्ष प्रवक्ष्यामि तत्त्वतः शृणु मे वचः ।\nसर्वथा ते हितकरं महामंत्रसुखप्रदम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001144006, "chapter_id": 21144, "verse_number": "२-२-३५-७", "content_sanskrit": "अवज्ञा हि कृता दक्ष त्वया तत्त्वमजानता ।\nसकलाधीश्वरस्यैव शंकरस्य परात्मनः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001144007, "chapter_id": 21144, "verse_number": "२-२-३५-८", "content_sanskrit": "ईश्वरावज्ञया सर्वं कार्यं भवति सर्वथा ।\nविफलं केवलं नैव विपत्तिश्च पदेपदे॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001144008, "chapter_id": 21144, "verse_number": "२-२-३५-९", "content_sanskrit": "अपूज्या यत्र पूज्यंते पूजनीयो न पूज्यते ।\nत्रीणि तत्र भविष्यंति दारिद्र्यं मरणं भयम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001144009, "chapter_id": 21144, "verse_number": "२-२-३५-१०", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन माननीयो वृषध्वजः ।\nअमानितान्महेशाच्च महद्भयमुपस्थितम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001144010, "chapter_id": 21144, "verse_number": "२-२-३५-११", "content_sanskrit": "अद्यापि न वयं सर्वे प्रभवः प्रभवामहे ।\nभवतो दुर्नयेनैव मया सत्यमुदीर्य्यते॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001144011, "chapter_id": 21144, "verse_number": "२-२-३५-१२", "content_sanskrit": "ब्रह्मोवाच ।\nविष्णोस्तद्वचनं श्रुत्वा दक्षश्चिंतापरोऽभवत् ।\nविवर्णवदनो भूत्वा तूष्णीमासीद्भुवि स्थितः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001144012, "chapter_id": 21144, "verse_number": "२-२-३५-१३", "content_sanskrit": "एतस्मिन्नंतरे वीरभद्रः सैन्यसमन्वितः ।\nअगच्छदध्वरं रुद्रप्रेरितो गणनायकः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001144013, "chapter_id": 21144, "verse_number": "२-२-३५-१४", "content_sanskrit": "पृष्ठे केचित्समायाता गगने केचिदागताः ।\nदिशश्च विदिशः सर्वे समावृत्य तथापरे॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001144014, "chapter_id": 21144, "verse_number": "२-२-३५-१५", "content_sanskrit": "शर्वाज्ञया गणाः शूरा निर्भया रुद्रविक्रमाः ।\nअसंख्याः सिंहनादान्वै कुर्वंतो वीरसत्तमाः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001144015, "chapter_id": 21144, "verse_number": "२-२-३५-१६", "content_sanskrit": "तेन नादेन महता नादितं भुवनत्रयम् ।\nरजसा चावृतं व्योम तमसा चावृता दिशः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001144016, "chapter_id": 21144, "verse_number": "२-२-३५-१७", "content_sanskrit": "सप्तद्वीपान्विता पृथ्वी चचालाति भयाकुला ।\nसशैलकानना तत्र चुक्षुभुस्सकलाब्धयः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001144017, "chapter_id": 21144, "verse_number": "२-२-३५-१८", "content_sanskrit": "एवंभूतं च तत्सैन्यं लोकक्षयकरं महत् ।\nदृष्ट्वा च विस्मितास्सर्वे बभूवुरमरादयः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001144018, "chapter_id": 21144, "verse_number": "२-२-३५-१९", "content_sanskrit": "सैन्योद्योगमथालोक्य दक्षश्चासृङ्मुखाकुलः ।\nदंडवत्पतितो विष्णुं सकलत्रोऽभ्यभाषत॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001144019, "chapter_id": 21144, "verse_number": "२-२-३५-२०", "content_sanskrit": "॥ दक्ष उवाच  ।\nभवद्बलेनैव मया यज्ञः प्रारंभितो महान् ।\nसत्कर्मसिद्धये विष्णो प्रमाणं त्वं महाप्रभो॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001144020, "chapter_id": 21144, "verse_number": "२-२-३५-२१", "content_sanskrit": "विष्णो त्वं कर्मणां साक्षी यज्ञानां प्रतिपालकः ।\nधर्मस्य वेदगर्भस्य ब्रह्मणस्त्वं महाप्रभो॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001144021, "chapter_id": 21144, "verse_number": "२-२-३५-२२", "content_sanskrit": "तस्माद्रक्षा विधातव्या यज्ञस्यास्य मम प्रभो ।\nत्वदन्यः यस्समर्थोस्ति यतस्त्वं सकलप्रभुः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001144022, "chapter_id": 21144, "verse_number": "२-२-३५-२३", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nदक्षस्य वचनं श्रुत्वा विष्णुर्दीनतरं तदा ।\nअवोचद्बोधयंस्तं वै शिवतत्त्वपराङ्मुखम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001144023, "chapter_id": 21144, "verse_number": "२-२-३५-२४", "content_sanskrit": "विष्णुरुवाच ।\nमया रक्षा विधातव्या तव यज्ञस्य दक्ष वै ।\nख्यातो मम पणः सत्यो धर्मस्य परिपालनम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001144024, "chapter_id": 21144, "verse_number": "२-२-३५-२५", "content_sanskrit": "तत्सत्यं तु त्वयोक्तं हि किं तत्तस्य व्यतिक्रमः ।\nशृणु त्वं वच्म्यहं दक्ष क्रूरबुद्धिं त्यजाऽधुना॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001144025, "chapter_id": 21144, "verse_number": "२-२-३५-२६", "content_sanskrit": "नैमिषे निमिषक्षेत्रे यज्जातं वृत्तमद्भुतम् ।\nतत्किं न स्मर्यते दक्ष विस्मृतं किं कुबुद्धिना॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001144026, "chapter_id": 21144, "verse_number": "२-२-३५-२७", "content_sanskrit": "रुद्रकोपाच्च को ह्यत्र समर्थो रक्षणे तव ।\nन यस्याभिमतं दक्ष यस्त्वां रक्षति दुर्मतिः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001144027, "chapter_id": 21144, "verse_number": "२-२-३५-२८", "content_sanskrit": "किं कर्म किमकर्मेति तत्र पश्यसि दुर्मते ।\nसमर्थं केवलं कर्म न भविष्यति सर्वदा॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001144028, "chapter_id": 21144, "verse_number": "२-२-३५-२९", "content_sanskrit": "स्वकर्मविद्धि तद्येन समर्थत्वेन जायते ।\nन त्वन्यः कर्मणो दाता शं भवेदीश्वरं विना॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001144029, "chapter_id": 21144, "verse_number": "२-२-३५-३०", "content_sanskrit": "ईश्वरस्य च यो भक्त्या शांतस्तद्गतमानसः ।\nकर्मणो हि फलं तस्य प्रयच्छति तदा शिवः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001144030, "chapter_id": 21144, "verse_number": "२-२-३५-३१", "content_sanskrit": "केवलं ज्ञानमाश्रित्य निरीश्वरपरा नराः ।\nनिरयं ते च गच्छंति कल्पकोटिशतानि च॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001144031, "chapter_id": 21144, "verse_number": "२-२-३५-३२", "content_sanskrit": "पुनः कर्ममयैः पाशैर्वद्धा जन्मनि जन्मनि ।\nनिरयेषु प्रपच्यंते केवलं कर्मरूपिणः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001144032, "chapter_id": 21144, "verse_number": "२-२-३५-३३", "content_sanskrit": "अयं रुद्रगणाधीशो वीरभद्रोऽरि मर्दनः ।\nरुद्रकोपाग्निसंभूतः समायातोध्वरांगणे॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001144033, "chapter_id": 21144, "verse_number": "२-२-३५-३४", "content_sanskrit": "अयमस्मद्विनाशार्थमागतोस्ति न संशयः ।\nअशक्यमस्य नास्त्येव किमप्यस्तु तु वस्तुतः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001144034, "chapter_id": 21144, "verse_number": "२-२-३५-३५", "content_sanskrit": "प्रज्वाल्यास्मानयं सर्वान् ध्रुवमेव महाप्रभुः ।\nततः प्रशांतहृदयो भविष्यति न संशयः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001144035, "chapter_id": 21144, "verse_number": "२-२-३५-३६", "content_sanskrit": "श्रीमहादेवशपथं समुल्लंघ्य भ्रमान्मया ।\nयतः स्थितं ततः प्राप्यं मया दुःखं त्वया सह॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001144036, "chapter_id": 21144, "verse_number": "२-२-३५-३७", "content_sanskrit": "शक्तिर्मम तु नास्त्येव दक्षाद्यैतन्निवारणे ।\nशपथोल्लंघनादेव शिवद्रोही यतोस्म्यहम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001144037, "chapter_id": 21144, "verse_number": "२-२-३५-३८", "content_sanskrit": "कालत्रयेपि न यतो महेशद्रोहिणां सुखम् ।\nततोऽवश्यं मया प्राप्तं दुःखमद्य त्वया सह॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001144038, "chapter_id": 21144, "verse_number": "२-२-३५-३९", "content_sanskrit": "सुदर्शनाभिधं चक्रमेतस्मिन्न लगिष्यति ।\nशैवचक्रमिदं यस्मादशैवलयकारणम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001144039, "chapter_id": 21144, "verse_number": "२-२-३५-४०", "content_sanskrit": "विनापि वीरभद्रेण नामैतच्चक्रमैश्वरम् ।\nहत्वा गमिष्यत्यधुना सत्वरं हरसन्निधौ॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001144040, "chapter_id": 21144, "verse_number": "२-२-३५-४१", "content_sanskrit": "शैवं शपथमुल्लंघ्य स्थितं मां चक्रमीदृशम् ।\nअसंहत्यैव सहसा कृपयैव स्थिरं परम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001144041, "chapter_id": 21144, "verse_number": "२-२-३५-४२", "content_sanskrit": "अतः परमिदं चक्रमपि न स्थास्यति ध्रुवम् ।\nगमिष्यत्यधुना शीघ्रं ज्वालामालासमाकुलम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001144042, "chapter_id": 21144, "verse_number": "२-२-३५-४३", "content_sanskrit": "वीरभद्रः पूजितोपि शीघ्रमस्माभिरादरात् ।\nमहाक्रोधसमाक्रांतो नास्मान्संरक्षयिष्यति॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001144043, "chapter_id": 21144, "verse_number": "२-२-३५-४४", "content_sanskrit": "अकांडप्रलयोऽस्माकमागतोद्य हि हा हहा ।\nहा हा बत तवेदानीं नाशोस्माकमुपस्थितः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001144044, "chapter_id": 21144, "verse_number": "२-२-३५-४५", "content_sanskrit": "शरण्योऽस्माकमधुना नास्त्येव हि जगत्त्रये ।\nशंकरद्रोहिणो लोके कश्शरण्यो भविष्यति॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001144045, "chapter_id": 21144, "verse_number": "२-२-३५-४६", "content_sanskrit": "तनुनाशेपि संप्राप्यास्तैश्चापि यमयातनाः ।\nतानैव शक्यते सोढुं बहुदुःखप्रदायिनीः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001144046, "chapter_id": 21144, "verse_number": "२-२-३५-४७", "content_sanskrit": "शिवद्रोहिणमालोक्य दष्टदंतो यमः स्वयम् ।\nतप्ततैलकटाहेषु पातयत्येव नान्यथा॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001144047, "chapter_id": 21144, "verse_number": "२-२-३५-४८", "content_sanskrit": "गन्तुमेवाहमुद्युक्तं सर्वथा शपथोत्तरम् ।\nतथापि न गतश्शीघ्रं दुष्टसंसर्गपापतः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001144048, "chapter_id": 21144, "verse_number": "२-२-३५-४९", "content_sanskrit": "यदद्य क्रियतेस्माभिः पलायनमितस्तदा ।\nशार्वो ना कर्षकश्शस्त्रैरस्मानाकर्षयिष्यति॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001144049, "chapter_id": 21144, "verse_number": "२-२-३५-५०", "content_sanskrit": "स्वर्गे वा भुवि पाताले यत्र कुत्रापि वा यतः ।\nश्रीवीरभद्रशस्त्राणां गमनं न हि दुर्ल भम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001144050, "chapter_id": 21144, "verse_number": "२-२-३५-५१", "content_sanskrit": "यावतश्च गणास्संति श्रीरुद्रस्य त्रिशूलिनः ।\nतावतामपि सर्वेषां शक्तिरेतादृशी धुवम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001144051, "chapter_id": 21144, "verse_number": "२-२-३५-५२", "content_sanskrit": "श्रीकालभैरवः काश्यां नखाग्रेणैव लीलया ।\nपुरा शिरश्च चिच्छेद पंचमं ब्रह्मणो ध्रुवम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001144052, "chapter_id": 21144, "verse_number": "२-२-३५-५३", "content_sanskrit": "एतदुक्त्वा स्थितो विष्णुरतित्रस्तमुखाम्बुजः ।\nवीरभद्रोपि संप्राप तदैवाऽध्वरमंडपम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001144053, "chapter_id": 21144, "verse_number": "२-२-३५-५४", "content_sanskrit": "एवं ब्रुवति गोविन्द आगतं सैन्यसागरम् ।\nवीरभद्रेण सहितं ददृशुश्च सुरादया॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]