[{"id": 7003347000, "chapter_id": 23347, "verse_number": "२-४२-१", "content_sanskrit": "सनत्कुमार उवाच  ।\nगजदानं प्रवक्ष्यामि यथावदनुपूर्वशः ।\nद्विजाय वा शिवायाथ दातव्यः पूज्य पूर्ववत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003347001, "chapter_id": 23347, "verse_number": "२-४२-२", "content_sanskrit": "गजं सुलक्षणोपेतं हैमं वा राजतं तु वा ।\nसहस्रनिष्कमात्रेण तदर्धेनापि कारयेत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003347002, "chapter_id": 23347, "verse_number": "२-४२-३", "content_sanskrit": "तदर्धार्धेन वा कुर्यात्सर्वलक्षणभूषितम् ।\nपूर्वोक्तदेशकाले च देवाय विनिवेदयेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003347003, "chapter_id": 23347, "verse_number": "२-४२-४", "content_sanskrit": "अष्टम्यां वा प्रदातव्यं शिवाय परमेष्ठिने ।\nब्राह्मणाय दरिद्राय श्रोत्रियायाहिताग्नये ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003347004, "chapter_id": 23347, "verse_number": "२-४२-५", "content_sanskrit": "शिवमुद्दिश्य दातव्यं शिवं संपूज्य पूर्ववत् ।\nएतद्यः कुरुते दानं शिवभक्तिसमाहितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003347005, "chapter_id": 23347, "verse_number": "२-४२-६", "content_sanskrit": "स्थित्वा स्वर्गे चिरं कालं राजा गजपतिर्भवेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]