"anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40015544, "chapter_id": 9228, "verse_number": "13", "content_sanskrit": "इत्युक्त्वोत्थायतंक्षिप्रंबाहुभ्यामाक्षिपत्तले । कन्तुवत्तंसमुत्थायबाहुभ्यामाक्षिपद्धरि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40015545, "chapter_id": 9228, "verse_number": "14", "content_sanskrit": "परस्परंस्वेदविदग्धगात्रौपरस्परंशोणितदिग्धदेहौ । परस्परंलशिष्टनिरुद्धचेष्टौपरस्परंशाल्मलिकिंशुकौयधा ॥ मुष्टिप्रहारैश्चतलप्रहारैररत्निघातैश्चकराग्रघातैः । तौचक्रतुर्युद्धमसह्यरूपंमहाबलौराक्षसवानरेन्द्रौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40015546, "chapter_id": 9228, "verse_number": "15", "content_sanskrit": "परस्परंस्वेदविदग्धगात्रौपरस्परंशोणितदिग्धदेहौ । परस्परंलशिष्टनिरुद्धचेष्टौपरस्परंशाल्मलिकिंशुकौयधा ॥ मुष्टिप्रहारैश्चतलप्रहारैररत्निघातैश्चकराग्रघातैः । तौचक्रतुर्युद्धमसह्यरूपंमहाबलौराक्षसवानरेन्द्रौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40015547, "chapter_id": 9228, "verse_number": "16", "content_sanskrit": "कृत्वानियुद्धंभृशमुग्रवेगौकालंचिर, गोपुरवेदिमध्ये । उत्क्षिप्यचोत्क्षिप्यविनम्यदेहौपादक्रमाद्गोपुरवेदिलग्नौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40015548, "chapter_id": 9228, "verse_number": "17", "content_sanskrit": "अन्योन्यमाविध्यवेदिलग्नौतौपेततुस्सालनिखातमध्ये । उत्पेततुर्भूतलमस्पृशन्तौस्थित्वामुहूर्तंत्वभिनिश्श्वसन्तौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40015549, "chapter_id": 9228, "verse_number": "18", "content_sanskrit": "आलिङ् ग्यचालिङ् ग्यचबाहुयोक्स्रैस्संयोजयामासतुराहवेतौ । सम्रम्भशिक्षाबलसम्प्रयुक्तौसंचेरतुस्स