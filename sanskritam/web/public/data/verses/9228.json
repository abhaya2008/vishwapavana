[{"id": 5000228000, "chapter_id": 9228, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे द्वात्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000228001, "chapter_id": 9228, "verse_number": "३-३२-१", "content_sanskrit": "ततः शूर्पणखा दृष्ट्वा सहस्राणि चतुर्दश।\nहतान्येकेन रामेण रक्षसां भीमकर्मणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000228002, "chapter_id": 9228, "verse_number": "३-३२-२", "content_sanskrit": "दूषणं च खरं चैव हतं त्रिशिरसं रणे।\nदृष्ट्वा पुनर्महानादान् ननाद जलदोपमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000228003, "chapter_id": 9228, "verse_number": "३-३२-३", "content_sanskrit": "सा दृष्ट्वा कर्म रामस्य कृतमन्यैः सुदुष्करम्।\nजगाम परमोद्विग्ना लङ्कां रावणपालिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000228004, "chapter_id": 9228, "verse_number": "३-३२-४", "content_sanskrit": "सा ददर्श विमानाग्रे रावणं दीप्ततेजसम्।\nउपोपविष्टं सचिवैर्मरुद्भिरिव वासवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000228005, "chapter_id": 9228, "verse_number": "३-३२-५", "content_sanskrit": "आसीनं सूर्यसंकाशे काञ्चने परमासने।\nरुक्मवेदिगतं प्राज्यं ज्वलन्तमिव पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000228006, "chapter_id": 9228, "verse_number": "३-३२-६", "content_sanskrit": "देवगन्धर्वभूतानामृषीणां च महात्मनाम्।\nअजेयं समरे घोरं व्यात्ताननमिवान्तकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000228007, "chapter_id": 9228, "verse_number": "३-३२-७", "content_sanskrit": "देवासुरविमर्देषु वज्राशनिकृतव्रणम्।\nऐरावतविषाणाग्रैरुत्कृष्टकिणवक्षसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000228008, "chapter_id": 9228, "verse_number": "३-३२-८", "content_sanskrit": "विंशद्भुजं दशग्रीवं दर्शनीयपरिच्छदम्।\nविशालवक्षसं वीरं राजलक्षणलक्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000228009, "chapter_id": 9228, "verse_number": "३-३२-९", "content_sanskrit": "नद्धवैदूर्यसंकाशं तप्तकाञ्चनभूषणम्।\nसुभुजं शुक्लदशनं महास्यं पर्वतोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000228010, "chapter_id": 9228, "verse_number": "३-३२-१०", "content_sanskrit": "विष्णुचक्रनिपातैश्च शतशो देवसंयुगे।\nअन्यैः शस्त्रैः प्रहारैश्च महायुद्धेषु ताडितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000228011, "chapter_id": 9228, "verse_number": "३-३२-११", "content_sanskrit": "अहताङ्गैः समस्तैस्तं देवप्रहरणैस्तदा।\nअक्षोभ्याणां समुद्राणां क्षोभणं क्षिप्रकारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000228012, "chapter_id": 9228, "verse_number": "३-३२-१२", "content_sanskrit": "क्षेप्तारं पर्वताग्राणां सुराणां च प्रमर्दनम्।\nउच्छेत्तारं च धर्माणां परदाराभिमर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000228013, "chapter_id": 9228, "verse_number": "३-३२-१३", "content_sanskrit": "सर्वदिव्यास्त्रयोक्तारं यज्ञविघ्नकरं सदा।\nपुरीं भोगवतीं गत्वा पराजित्य च वासुकिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000228014, "chapter_id": 9228, "verse_number": "३-३२-१४", "content_sanskrit": "तक्षकस्य प्रियां भार्यां पराजित्य जहार यः।\nकैलासं पर्वतं गत्वा विजित्य नरवाहनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000228015, "chapter_id": 9228, "verse_number": "३-३२-१५", "content_sanskrit": "विमानं पुष्पकं तस्य कामगं वै जहार यः।\nवनं चैत्ररथं दिव्यं नलिनीं नन्दनं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000228016, "chapter_id": 9228, "verse_number": "३-३२-१६", "content_sanskrit": "विनाशयति यः क्रोधाद् देवोद्यानानि वीर्यवान्।\nचन्द्रसूर्यौ महाभागावुत्तिष्ठन्तौ परंतपौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000228017, "chapter_id": 9228, "verse_number": "३-३२-१७", "content_sanskrit": "निवारयति बाहुभ्यां यः शैलशिखरोपमः।\nदशवर्षसहस्राणि तपस्तप्त्वा महावने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000228018, "chapter_id": 9228, "verse_number": "३-३२-१८", "content_sanskrit": "पुरा स्वयंभुवे धीरः शिरांस्युपजहार यः।\nदेवदानवगन्धर्वपिशाचपतगोरगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000228019, "chapter_id": 9228, "verse_number": "३-३२-१९", "content_sanskrit": "अभयं यस्य संग्रामे मृत्युतो मानुषादृते।\nमन्त्रैरभिष्टुतं पुण्यमध्वरेषु द्विजातिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000228020, "chapter_id": 9228, "verse_number": "३-३२-२०", "content_sanskrit": "हविर्धानेषु यः सोममुपहन्ति महाबलः।\nप्राप्तयज्ञहरं दुष्टं ब्रह्मघ्नं क्रूरकारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000228021, "chapter_id": 9228, "verse_number": "३-३२-२१", "content_sanskrit": "कर्कशं निरनुक्रोशं प्रजानामहिते रतम्।\nरावणं सर्वभूतानां सर्वलोकभयावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000228022, "chapter_id": 9228, "verse_number": "३-३२-२२", "content_sanskrit": "राक्षसी भ्रातरं क्रूरं सा ददर्श महाबलम्।\nतं दिव्यवस्त्राभरणं दिव्यमाल्योपशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000228023, "chapter_id": 9228, "verse_number": "३-३२-२३", "content_sanskrit": "आसने सूपविष्टं तं काले कालमिवोद्यतम्।\nराक्षसेन्द्रं महाभागं पौलस्त्यकुलनन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000228024, "chapter_id": 9228, "verse_number": "३-३२-२४", "content_sanskrit": "उपगम्याब्रवीद् वाक्यं राक्षसी भयविह्वला।\nरावणं शत्रुहन्तारं मन्त्रिभिः परिवारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000228025, "chapter_id": 9228, "verse_number": "३-३२-२५", "content_sanskrit": "तमब्रवीद् दीप्तविशाललोचनं\nप्रदर्शयित्वा भयलोभमोहिता।\nसुदारुणं वाक्यमभीतचारिणी\nमहात्मना शूर्पणखा विरूपिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000228026, "chapter_id": 9228, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे द्वात्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]