[
  {
    "id": 16763001,
    "chapter_id": 6163,
    "verse_number": "15.1",
    "content_sanskrit": "श्रीभगवानुवाच —",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "BG_C15_V01"
  },
  {
    "id": 16763002,
    "chapter_id": 6163,
    "verse_number": "15.2",
    "content_sanskrit": "अधश्चोर्ध्वं प्रसृतास्तस्य शाखा\nगुणप्रवृद्धा विषयप्रवालाः ।\nअधश्च मूलान्यनुसन्ततानि\nकर्मानुबन्धीनि मनुष्यलोके ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "BG_C15_V02"
  },
  {
    "id": 16763003,
    "chapter_id": 6163,
    "verse_number": "15.3",
    "content_sanskrit": "न रूपमस्येह तथोपलभ्यते नान्तो न चादिर्न च सम्प्रतिष्ठा ।\nअश्वत्थमेनं सुविरूढमूलमसङ्गशस्त्रेण दृढेन छित्त्वा ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "BG_C15_V03"
  },
  {
    "id": 16763004,
    "chapter_id": 6163,
    "verse_number": "15.4",
    "content_sanskrit": "ततः पदं तत्परिमार्गितव्यं\nयस्मिन्गता न निवर्तन्ति भूयः ।\nतमेव चाद्यं पुरुषं प्रपद्ये\nयतः प्रवृत्तिः प्रसृता पुराणी ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "BG_C15_V04"
  },
  {
    "id": 16763005,
    "chapter_id": 6163,
    "verse_number": "15.5",
    "content_sanskrit": "निर्मानमोहा जितसङ्गदोषा अध्यात्मनित्या विनिवृत्तकामाः ।\nद्वन्द्वैर्विमुक्ताः सुखदुःखसंज्ञैर्गच्छन्त्यमूढाः पदमव्ययं तत् ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "BG_C15_V05"
  },
  {
    "id": 16763006,
    "chapter_id": 6163,
    "verse_number": "15.6",
    "content_sanskrit": "न तद्भासयते सूर्यो न शशाङ्को न पावकः ।\nयद्गत्वा न निवर्तन्ते तद्धाम परमं मम ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "BG_C15_V06"
  },
  {
    "id": 16763007,
    "chapter_id": 6163,
    "verse_number": "15.7",
    "content_sanskrit": "ममैवांशो जीवलोके जीवभूतः सनातनः ।\nमनःषष्ठानीन्द्रियाणि प्रकृतिस्थानि कर्षति ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "BG_C15_V07"
  },
  {
    "id": 16763008,
    "chapter_id": 6163,
    "verse_number": "15.8",
    "content_sanskrit": "शरीरं यदवाप्नोति यच्चाप्युत्क्रामतीश्वरः ।\nगृहीत्वैतानि संयाति वायुर्गन्धानिवाशयात् ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "BG_C15_V08"
  },
  {
    "id": 16763009,
    "chapter_id": 6163,
    "verse_number": "15.9",
    "content_sanskrit": "श्रोत्रं चक्षुः स्पर्शनं च रसनं घ्राणमेव च ।\nअधिष्ठाय मनश्चायं विषयानुपसेवते ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "base_unit_id": "BG_C15_V09"
  },
  {
    "id": 16763010,
    "chapter_id": 6163,
    "verse_number": "15.10",
    "content_sanskrit": "उत्क्रामन्तं स्थितं वापि भुञ्जानं वा गुणान्वितम् ।\nविमूढा नानुपश्यन्ति पश्यन्ति ज्ञानचक्षुषः ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "base_unit_id": "BG_C15_V10"
  },
  {
    "id": 16763011,
    "chapter_id": 6163,
    "verse_number": "15.11",
    "content_sanskrit": "यतन्तो योगिनश्चैनं पश्यन्त्यात्मन्यवस्थितम् ।\nयतन्तोऽप्यकृतात्मानो नैनं पश्यन्त्यचेतसः ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "BG_C15_V11"
  },
  {
    "id": 16763012,
    "chapter_id": 6163,
    "verse_number": "15.12",
    "content_sanskrit": "यदादित्यगतं तेजो जगद्भासयतेऽखिलम् ।\nयच्चन्द्रमसि यच्चाग्नौ तत्तेजो विद्धि मामकम् ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "BG_C15_V12"
  },
  {
    "id": 16763013,
    "chapter_id": 6163,
    "verse_number": "15.13",
    "content_sanskrit": "गामाविश्य च भूतानि\nधारयाम्यहमोजसा ।\nपुष्णामि चौषधीः सर्वाः\nसोमो भूत्वा रसात्मकः ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "base_unit_id": "BG_C15_V13"
  },
  {
    "id": 16763014,
    "chapter_id": 6163,
    "verse_number": "15.14",
    "content_sanskrit": "अहं वैश्वानरो भूत्वा प्राणिनां देहमाश्रितः ।\nप्राणापानसमायुक्तः पचाम्यन्नं चतुर्विधम् ॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "base_unit_id": "BG_C15_V14"
  },
  {
    "id": 16763015,
    "chapter_id": 6163,
    "verse_number": "15.15",
    "content_sanskrit": "सर्वस्य चाहं हृदि संनिविष्टो\nमत्तः स्मृतिर्ज्ञानमपोहनं च ।\nवेदैश्च सर्वैरहमेव वेद्यो\nवेदान्तकृद्वेदविदेव चाहम् ॥ १५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "base_unit_id": "BG_C15_V15"
  },
  {
    "id": 16763016,
    "chapter_id": 6163,
    "verse_number": "15.16",
    "content_sanskrit": "द्वाविमौ पुरुषौ लोके क्षरश्चाक्षर एव च ।\nक्षरः सर्वाणि भूतानि कूटस्थोऽक्षर उच्यते ॥ १६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "base_unit_id": "BG_C15_V16"
  },
  {
    "id": 16763017,
    "chapter_id": 6163,
    "verse_number": "15.17",
    "content_sanskrit": "उत्तमः पुरुषस्त्वन्यः परमात्मेत्युदाहृतः ।\nयो लोकत्रयमाविश्य बिभर्त्यव्यय ईश्वरः ॥ १७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "base_unit_id": "BG_C15_V17"
  },
  {
    "id": 16763018,
    "chapter_id": 6163,
    "verse_number": "15.18",
    "content_sanskrit": "यस्मात्क्षरमतीतोऽहमक्षरादपि चोत्तमः ।\nअतोऽस्मि लोके वेदे च प्रथितः पुरुषोत्तमः ॥ १८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "base_unit_id": "BG_C15_V18"
  },
  {
    "id": 16763019,
    "chapter_id": 6163,
    "verse_number": "15.19",
    "content_sanskrit": "यो मामेवमसंमूढो जानाति पुरुषोत्तमम् ।\nस सर्वविद्भजति मां सर्वभावेन भारत ॥ १९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "base_unit_id": "BG_C15_V19"
  },
  {
    "id": 16763020,
    "chapter_id": 6163,
    "verse_number": "15.20",
    "content_sanskrit": "इति गुह्यतमं शास्त्रमिदमुक्तं मयानघ ।\nएतद्बुद्ध्वा बुद्धिमान्स्यात्कृतकृत्यश्च भारत ॥ २० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "base_unit_id": "BG_C15_V20"
  }
]