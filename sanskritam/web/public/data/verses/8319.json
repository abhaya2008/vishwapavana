[{"id": 900004111, "chapter_id": 8319, "verse_number": "15.1", "content_sanskrit": "योऽन्त्यो रिपुञ्जयो नाम भविष्यो बारुहद्रथः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900004112, "chapter_id": 8319, "verse_number": "15.2", "content_sanskrit": "ततश्चानुदिनं धर्मः सत्यं शौचं क्षमा दया", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900004113, "chapter_id": 8319, "verse_number": "15.3", "content_sanskrit": "दृष्ट्वाऽऽत्मनिर्जयव्यग्रान् नृपान् हसति भूरियम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900004114, "chapter_id": 8319, "verse_number": "15.4", "content_sanskrit": "कालस्ते परमाण्वादिर्द्विपरार्धावधिर्नृप", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900004115, "chapter_id": 8319, "verse_number": "15.5", "content_sanskrit": "एतन्निशम्य मुनिनाऽभिहितं परीक्षिद्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900004116, "chapter_id": 8319, "verse_number": "15.6", "content_sanskrit": "पैलादिभिर्व्यासशिष्यैर्वेदाचार्यैर्महात्मभिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900004117, "chapter_id": 8319, "verse_number": "15.7", "content_sanskrit": "सूत जीव चिरं साधो वद नो वदतां वर", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900004118, "chapter_id": 8319, "verse_number": "15.8", "content_sanskrit": "संस्तुतो भगवानित्थं मार्कण्डेयेन धीमता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900004119, "chapter_id": 8319, "verse_number": "15.9", "content_sanskrit": "स एवमनुभूयेदं नारायणविनिर्मितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900004120, "chapter_id": 8319, "verse_number": "15.10", "content_sanskrit": "अथेममर्थं पृच्छामो भवन्तं बहुवित्तमम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900004121, "chapter_id": 8319, "verse_number": "15.11", "content_sanskrit": "शुको यदाह भगवान् विष्णुराताय पृच्छते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900004122, "chapter_id": 8319, "verse_number": "15.12", "content_sanskrit": "नमो धर्माय महते नमः कृष्णाय वेधसे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900004123, "chapter_id": 8319, "verse_number": "15.13", "content_sanskrit": "यं ब्रह्मा वरुणेन्द्ररुद्रमरुतः स्तुन्वन्ति दिव्यैः स्तवै", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]