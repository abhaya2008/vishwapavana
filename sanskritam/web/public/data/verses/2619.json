[{"id": 2076393, "chapter_id": 2619, "verse_number": "१२-१२४-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2076394, "chapter_id": 2619, "verse_number": "१२-१२४-१", "content_sanskrit": "इमे जना मनुष्येन्द्र प्रशंसन्ति सदा भुवि।\nधर्मस्य शीलमेवादौ ततो मे संशयो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2076395, "chapter_id": 2619, "verse_number": "१२-१२४-२", "content_sanskrit": "यदि तच्छक्यमस्माभिर्ज्ञातुं धर्मभूतां वर।\nश्रोतुमिच्छामि तत्सर्वं यथैतदुपलभ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2076396, "chapter_id": 2619, "verse_number": "१२-१२४-३", "content_sanskrit": "कथं तत्प्राप्यते शीलं श्रोतुमिच्छामि भारत।\nकिंलक्षणं च तत्प्रोक्तं ब्रूहि मे वदतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2076397, "chapter_id": 2619, "verse_number": "१२-१२४-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2076398, "chapter_id": 2619, "verse_number": "१२-१२४-४", "content_sanskrit": "पुरा दुर्योधनेनेह धृतराष्ट्राय मानद।\nआख्यातं तप्यमानेन श्रियं दृष्ट्वा तवागताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2076399, "chapter_id": 2619, "verse_number": "१२-१२४-५", "content_sanskrit": "इन्द्रप्रस्थे महाराज तव सभ्रातृकस्य ह।\nसभायां चापहसनं तत्सर्वं शृणु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2076400, "chapter_id": 2619, "verse_number": "१२-१२४-६", "content_sanskrit": "भवतस्तां सभां दृष्ट्वा समृद्धिं चाप्यनुत्तमाम्।\nदुर्योधनस्तदा दीनः सर्वं पित्रे न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2076401, "chapter_id": 2619, "verse_number": "१२-१२४-७", "content_sanskrit": "श्रुत्वा हि धृतराष्ट्रश्च दुर्योधनवचस्तदा।\nअब्रवीत्कर्णसहितं दुर्योधनमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2076402, "chapter_id": 2619, "verse_number": "१२-१२४-८x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2076403, "chapter_id": 2619, "verse_number": "१२-१२४-८", "content_sanskrit": "किमर्थं तप्यसे पुत्र श्रोतुमिच्छामि तत्त्वतः।\nश्रुत्वा त्वामनुनेष्यामि यदि सम्यग्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2076404, "chapter_id": 2619, "verse_number": "१२-१२४-९", "content_sanskrit": "यदा त्वां महदैश्वर्यं प्राप्तं परपुरंजय।\nकिंकरा भ्रातरः सर्वे मित्रसंबन्धिबान्धवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2076405, "chapter_id": 2619, "verse_number": "१२-१२४-१०", "content_sanskrit": "आच्छादयसि प्रावारानश्नासि पिशितौदनम्।\nआजानेया वहन्ति त्वां कस्माच्छेचसि पुत्रक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2076406, "chapter_id": 2619, "verse_number": "१२-१२४-११x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2076407, "chapter_id": 2619, "verse_number": "१२-१२४-११", "content_sanskrit": "दश तात सहस्राणि स्नातकानां महात्मनाम्।\nभुञ्जते रुक्मपात्रीभिर्युधिष्ठिरनिवेशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2076408, "chapter_id": 2619, "verse_number": "१२-१२४-१२", "content_sanskrit": "दृष्ट्वा च तां सभां दिव्यपुष्पफलान्विताम्।\nअश्वांस्तित्तिरकल्माषान्रत्नानि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2076409, "chapter_id": 2619, "verse_number": "१२-१२४-१३", "content_sanskrit": "दृष्ट्वा तां पाण्डवेयानामृद्धिमिन्द्रोपमां शुभाम्।\nअमित्राणां सुमहतीमनुशोचामि मानद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2076410, "chapter_id": 2619, "verse_number": "१२-१२४-१४x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2076411, "chapter_id": 2619, "verse_number": "१२-१२४-१४", "content_sanskrit": "यदीच्छसि श्रियं तात यादृशी सा युधिष्ठिरे।\nविशिष्टां वा नरश्रेष्ठ शीलवान्भव पुत्रक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2076412, "chapter_id": 2619, "verse_number": "१२-१२४-१५", "content_sanskrit": "शीलेन हि त्रयो लोकाः शक्या जेतुं न संशयः।\nन हि किंचिदसाध्यंवै लोके शीलवतां सताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2076413, "chapter_id": 2619, "verse_number": "१२-१२४-१६", "content_sanskrit": "एकरात्रेण मान्धाता त्र्यहेण जनमेजयः।\nसप्तरात्रेण नाभागः पृथिवीं प्रतिपेदिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2076414, "chapter_id": 2619, "verse_number": "१२-१२४-१७", "content_sanskrit": "एते हि पार्थिवाः सर्वे शीलवन्तो यशोन्विताः।\nततस्तेषां गुणक्रीता वसुधा स्वयमागता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2076415, "chapter_id": 2619, "verse_number": "१२-१२४-१८x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2076416, "chapter_id": 2619, "verse_number": "१२-१२४-१८", "content_sanskrit": "कथं तत्प्राप्यते शीलं श्रोतुमिच्छामि भारत।\nयेन शीलेन संप्राप्ताः क्षिप्रमेव वसुंधराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2076417, "chapter_id": 2619, "verse_number": "१२-१२४-१९x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2076418, "chapter_id": 2619, "verse_number": "१२-१२४-१९", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nनारदेन पुरा वृत्तं शीलमाश्रित्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2076419, "chapter_id": 2619, "verse_number": "१२-१२४-२०", "content_sanskrit": "प्रा--देन हृतं राज्यं महेन्द्रस्य महात्मनः।\nश---माश्रित्य दैत्येन त्रैलोक्यं च वशे कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2076420, "chapter_id": 2619, "verse_number": "१२-१२४-२१", "content_sanskrit": "त--बृहस्पतिं शक्रः प्राञ्जलिः समुपस्थितः।\nतमुवाच महाप्राज्ञः श्रेय इच्छामि वेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2076421, "chapter_id": 2619, "verse_number": "१२-१२४-२२", "content_sanskrit": "ततो बृहस्पतिस्तस्मै ज्ञानं नैश्रेयसं परम्।\nकथयामास भगवान्देवेन्द्राय कुरूद्वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2076422, "chapter_id": 2619, "verse_number": "१२-१२४-२३", "content_sanskrit": "एतावच्छ्रेय इत्येव बृहस्पतिरभाषत।\nइन्द्रस्तु भूयः पप्रच्छ को विशेषो भवेदिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2076423, "chapter_id": 2619, "verse_number": "१२-१२४-२४x", "content_sanskrit": "बृहस्पतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2076424, "chapter_id": 2619, "verse_number": "१२-१२४-२४", "content_sanskrit": "विशेषोऽस्ति महांस्तात भार्गवस्य महात्मनः।\nतत्रागमय भद्रं ते भूय एव सुरोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2076425, "chapter_id": 2619, "verse_number": "१२-१२४-२५", "content_sanskrit": "आत्मनस्तु ततः श्रेयो भार्गवः सुमहायशाः।\nज्ञानमागमयत्प्रीत्या पुनः स परमद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2076426, "chapter_id": 2619, "verse_number": "१२-१२४-२६", "content_sanskrit": "तेनापि समनुज्ञातो भार्गवेण महात्मना।\nश्रेयोऽस्तीति परं भूयः शुक्रमाह शतक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2076427, "chapter_id": 2619, "verse_number": "१२-१२४-२७", "content_sanskrit": "भार्गवस्त्वाह सर्वज्ञः प्रह्लादस्य महात्मनः।\nज्ञानमस्ति विशेषेणेत्युक्तो हृष्टश्च सोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2076428, "chapter_id": 2619, "verse_number": "१२-१२४-२८", "content_sanskrit": "स तत्र ब्राह्मणो भूत्वा प्रह्लादं पाकशासनः।\nस्तुत्वा प्रोवाच मेधावी श्रेय इच्छामि वेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2076429, "chapter_id": 2619, "verse_number": "१२-१२४-२९", "content_sanskrit": "प्रह्लादस्त्वब्रवीद्विप्रं क्षणो नास्ति द्विजोत्तम।\nत्रैलोक्यराज्यसक्तस्य ततो नोपदिशामि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2076430, "chapter_id": 2619, "verse_number": "१२-१२४-३०", "content_sanskrit": "ब्राह्मणस्त्वब्रवीद्राजन्यस्मिन्काले क्षणो भवेत्।\nतदोपादेष्टुमिच्छामि यदि कार्यान्तरं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2076431, "chapter_id": 2619, "verse_number": "१२-१२४-३१", "content_sanskrit": "ततः प्रीतोऽभवद्राजा प्रह्वादो ब्रह्मवादिनः।\nतथेत्युक्त्वा ददौ काले ज्ञानतत्त्वं द्विजे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2076432, "chapter_id": 2619, "verse_number": "१२-१२४-३२", "content_sanskrit": "ब्राह्मणोऽपि यथान्यायं गुरुवृत्तिमनुत्तमाम्।\nचकार सर्वभावेन यद्यच्च मनसेच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2076433, "chapter_id": 2619, "verse_number": "१२-१२४-३३", "content_sanskrit": "पृष्टश्च तेन बहुशः प्राप्तं कथमरिंदम्।\nत्रैलोक्यराज्यं धर्मज्ञ कारणं तद्ब्रवीहि मे।\n[प्रह्लादोऽपि महाराज ब्राह्मणं वाक्यमब्रवीत्॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2076434, "chapter_id": 2619, "verse_number": "१२-१२४-३४x", "content_sanskrit": "प्रह्लाद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2076435, "chapter_id": 2619, "verse_number": "१२-१२४-३४", "content_sanskrit": "नासूयामि द्विजान्विप्र राजास्मीति कथंचन।\nकाम्यानि वदतां तेषां संयच्छामि वहामि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2076436, "chapter_id": 2619, "verse_number": "१२-१२४-३५", "content_sanskrit": "ते विस्रब्धाः प्रभाषन्ते संयच्छन्ति च मां सदा।\nतेषां कार्यपथे युक्तं शुश्रूषुमनहंकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2076437, "chapter_id": 2619, "verse_number": "१२-१२४-३६", "content_sanskrit": "धर्मात्मानं जितक्रोधं नियतं संयतेन्द्रियम्।\nसमासिञ्चन्ति शास्त्रज्ञाः क्षौद्रं मध्विव मक्षिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2076438, "chapter_id": 2619, "verse_number": "१२-१२४-३७", "content_sanskrit": "सोऽहं वागग्रविद्यानां रसानामवलेहिता।\nस्वजात्यानधितिष्ठामि नक्षत्राणीव चन्द्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2076439, "chapter_id": 2619, "verse_number": "१२-१२४-३८", "content_sanskrit": "एतत्पृथिव्याममृतमेतच्चक्षुरनुत्तमम्।\nयद्ब्राह्मणमुखे हव्यमेतच्छ्रुत्वा प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2076440, "chapter_id": 2619, "verse_number": "१२-१२४-३९", "content_sanskrit": "एतावच्छेय इत्याह प्रह्लादो ब्रह्मवादिनम्।\nशुश्रूषितस्तेन तदा दैत्येन्द्रो वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2076441, "chapter_id": 2619, "verse_number": "१२-१२४-४०", "content_sanskrit": "यथावद्गुरुवृत्त्या ते प्रीतोऽस्मि द्विजसत्तम।\nवरं वृणीष्व भद्रं ते प्रदाताऽस्मि न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2076442, "chapter_id": 2619, "verse_number": "१२-१२४-४१", "content_sanskrit": "कृतमित्येव दैत्येन्द्रमुवाच द्विजसत्तमः।\nप्रह्लादस्त्वब्रवीत्प्रीतो गृह्यतां वर इत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2076443, "chapter_id": 2619, "verse_number": "१२-१२४-४२x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2076444, "chapter_id": 2619, "verse_number": "१२-१२४-४२", "content_sanskrit": "यदि राजन्प्रसन्नस्त्वं मम चेदिच्छसि प्रियम्।\nभवतः शीलमिच्छामि प्राप्नुमेष वरो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2076445, "chapter_id": 2619, "verse_number": "१२-१२४-४३", "content_sanskrit": "ततः प्रीतस्तु दैत्येन्द्रो भयमस्याभवन्महत्।\nवरे प्रदिष्टे विप्रेण नाल्पचेतायमित्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2076446, "chapter_id": 2619, "verse_number": "१२-१२४-४४", "content_sanskrit": "एवमस्त्विति स प्राह प्रह्लादो विस्मितस्तदा।\nउपाकृत्य तु विप्राय वरं दुःखान्वितोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2076447, "chapter_id": 2619, "verse_number": "१२-१२४-४५", "content_sanskrit": "दत्ते वरे गते विप्रे चिन्ताऽसीन्महती तदा।\nप्रह्लादस्य महाराज निश्चयं न च जग्मिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2076448, "chapter_id": 2619, "verse_number": "१२-१२४-४६", "content_sanskrit": "तस्य चिन्तयतस्तावच्छायाभूतं महाद्युतेः।\nतेजोविग्रहवत्तात शरीरमजहात्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2076449, "chapter_id": 2619, "verse_number": "१२-१२४-४७", "content_sanskrit": "तमपृच्छन्महाराजः प्रह्लादः को भवानिति।\nप्रत्याह तं तु शीलोस्मि त्यक्तो गच्छाम्यहं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2076450, "chapter_id": 2619, "verse_number": "१२-१२४-४८", "content_sanskrit": "तस्मिन्द्विजोत्तमे राजन्वत्स्याम्यहमरिंदम।\nयोऽसौ शिष्यत्वमागम्य त्वयि नित्यं समाहितः।\nइत्युक्त्वाऽन्तर्हितं तद्वै शक्रं चान्वाविशत्प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2076451, "chapter_id": 2619, "verse_number": "१२-१२४-४९", "content_sanskrit": "तस्मिंस्तेजसि याते तु तादृग्रूपस्ततोपरः।\nशरीरान्निः सृतस्तस्य को भवानिति सोब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2076452, "chapter_id": 2619, "verse_number": "१२-१२४-५०", "content_sanskrit": "धर्मं प्रह्लाद मां विद्धि यत्रासौ द्विजसत्तमः।\nतत्र यास्यामि दैत्येन्द्र यतः शीलं ततो ह्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2076453, "chapter_id": 2619, "verse_number": "१२-१२४-५१", "content_sanskrit": "ततोऽपरो महाराज प्रज्वलन्निव तेजसा।\nशरीरान्निः सृतस्तस्य प्रह्लादस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2076454, "chapter_id": 2619, "verse_number": "१२-१२४-५२", "content_sanskrit": "को भवानिति पृष्टश्च तमाह स महाद्युतिः।\nसत्यं विद्ध्यसुरेन्द्राद्य प्रयास्ये धर्ममन्वहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2076455, "chapter_id": 2619, "verse_number": "१२-१२४-५३", "content_sanskrit": "तस्मिन्ननुगते धर्मं पुरुषे पुरुषोऽपरः।\nनिश्चक्राम ततस्तस्मात्पृष्टश्चाह महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2076456, "chapter_id": 2619, "verse_number": "१२-१२४-५४", "content_sanskrit": "वृत्तं प्रह्लाद मां विद्धि यतः सत्यं ततो ह्यहम्।\nतस्मिन्गते महाश्वेता शरीरात्तस्य निर्ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2076457, "chapter_id": 2619, "verse_number": "१२-१२४-५५", "content_sanskrit": "पृष्टश्चाह बलं विद्धि यतो वृत्तमहं ततः।\nइत्युक्त्वा प्रययौ तत्र यतो वृत्तं नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2076458, "chapter_id": 2619, "verse_number": "१२-१२४-५६", "content_sanskrit": "ततः प्रभामयी देवी शरीरात्तस्य निर्ययौ।\nतामपृच्छत्स दैत्येन्द्रः सा श्रीरित्येनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2076459, "chapter_id": 2619, "verse_number": "१२-१२४-५७", "content_sanskrit": "उषिताऽस्मि सुखं नित्यं त्वयि सत्यपराक्रम।\nत्वया युक्ता गमिष्यामि बलं ह्यनुगता ह्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2076460, "chapter_id": 2619, "verse_number": "१२-१२४-५८", "content_sanskrit": "ततो भयं प्रादुरासीत्प्रह्लादस्य महात्मनः।\nअपृच्छत च तां भूयः क्व यासि कमलालये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2076461, "chapter_id": 2619, "verse_number": "१२-१२४-५९", "content_sanskrit": "त्वं हि सत्यव्रता देवी लोकस्य परमेश्वरी।\nकश्चासौ ब्राह्मणश्रेष्ठस्तत्त्वमिच्छामि वेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2076462, "chapter_id": 2619, "verse_number": "१२-१२४-६०x", "content_sanskrit": "श्रीरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2076463, "chapter_id": 2619, "verse_number": "१२-१२४-६०", "content_sanskrit": "स शक्तो ब्रह्मचारी यस्त्वत्तश्चैवोपशिक्षितः।\nत्रैलोक्ये ते यदश्वर्यं तत्तेनापहृतं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2076464, "chapter_id": 2619, "verse_number": "१२-१२४-६१", "content_sanskrit": "शीलेन हि त्रयो लोकास्त्वया धर्मज्ञ निर्जिताः।\nतद्विज्ञाय सुरेन्द्रेण तव शीलं हृतं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2076465, "chapter_id": 2619, "verse_number": "१२-१२४-६२", "content_sanskrit": "धर्मः सत्यं तथा वृत्तं बलं चैव तथाऽप्यहम्।\nशीलमूला महाप्राज्ञ सदा नास्त्यत्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2076466, "chapter_id": 2619, "verse_number": "१२-१२४-६३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2076467, "chapter_id": 2619, "verse_number": "१२-१२४-६३", "content_sanskrit": "एवमुक्त्वा गता श्रीस्तु ते च सर्वे युधिष्ठिर।\nदुर्योधनस्तु पितरं भूय एवाब्रवीत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2076468, "chapter_id": 2619, "verse_number": "१२-१२४-६४", "content_sanskrit": "शीलस्य तत्त्वमिच्छामि वेत्तुं कौरवनन्दन।\nप्राप्यते च यथा शीलं तं चोपायं ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2076469, "chapter_id": 2619, "verse_number": "१२-१२४-६५x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2076470, "chapter_id": 2619, "verse_number": "१२-१२४-६५", "content_sanskrit": "सोपायं पूर्वमुद्दिष्टं प्रह्लादेन महात्मना।\nसंक्षेपतस्तु शीलस्य शृणु प्राप्तिं नरेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2076471, "chapter_id": 2619, "verse_number": "१२-१२४-६६", "content_sanskrit": "अद्रोहः सर्वभूतेषु कर्मणा मनसा गिरा।\nअनुग्रहश्च दानं च शीलमेतत्प्रशस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2076472, "chapter_id": 2619, "verse_number": "१२-१२४-६७", "content_sanskrit": "यदन्येषां हितं न स्यादात्मनः कर्म पौरुषम्।\nअपत्रपेत वा येन न तत्कुर्यात्कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2076473, "chapter_id": 2619, "verse_number": "१२-१२४-६८", "content_sanskrit": "तत्तु कर्म तथा कुर्याद्येन श्लाध्येत संसदि।\nशीलं समासेनैतत्ते कथितं कुरुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2076474, "chapter_id": 2619, "verse_number": "१२-१२४-६९", "content_sanskrit": "यद्यप्यशीला नृपते प्राप्नुवन्ति श्रियं क्वचित्।\nन भुञ्जते चिरं तात समूलाश्च पतन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2076475, "chapter_id": 2619, "verse_number": "१२-१२४-७०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2076476, "chapter_id": 2619, "verse_number": "१२-१२४-७०", "content_sanskrit": "एतद्विदित्वा तत्त्वेन शीलवान्भव पुत्रक।\nयदीच्छसि श्रियं तात सुविशिष्टां युधिष्ठिरात्।\n`अधिकां चापि राजेन्द्र ततस्त्वं शीलवान्भवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2076477, "chapter_id": 2619, "verse_number": "१२-१२४-७१x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2076478, "chapter_id": 2619, "verse_number": "१२-१२४-७१", "content_sanskrit": "एतत्कथितवान्पुत्रे धृतराष्ट्रो महीपतिः।\nएतत्कुरुष्व कौन्तेय ततः प्राप्स्यसि तत्फलम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2076479, "chapter_id": 2619, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि चतुर्विशत्यधिकशततमोऽध्यायः॥ १२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}]