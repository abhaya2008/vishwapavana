[{"id": 2186259, "chapter_id": 4955, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2186260, "chapter_id": 4955, "verse_number": "१", "content_sanskrit": "ईहमानः समारम्भान्यदि नासादयेद्धनम् ।\nधनतृष्णाभिभूतश्च किं कुर्वन् सुखमाप्नुयात्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2186261, "chapter_id": 4955, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2186262, "chapter_id": 4955, "verse_number": "२", "content_sanskrit": "सर्वसाम्यमनायासः सत्यवाक्यं च भारत ।\nनिर्वेदश्चाविवित्सा च यस्य स्यात्स सुखी नरः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2186263, "chapter_id": 4955, "verse_number": "३", "content_sanskrit": "एतान्येव पदान्याहुः पञ्च वृद्धाः प्रशान्तये ।\nएष स्वर्गश्च धर्मश्च सुखं चानुत्तमं सताम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2186264, "chapter_id": 4955, "verse_number": "४", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nनिर्वेदान्मङ्किना गीतं तन्निबोध युधिष्ठिर\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2186265, "chapter_id": 4955, "verse_number": "५", "content_sanskrit": "ईहमानो धनं मङ्किर्भग्नेहश्च पुनः पुनः ।\nकेनचिद्धनशेषेण क्रीतवान् दम्यगोयुगम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2186266, "chapter_id": 4955, "verse_number": "६", "content_sanskrit": "सुसम्बद्धौ तु तौ दम्यौ दमनायाभिनिःसृतौ ।\nआसीनमुष्ट्रं मध्येन सहसैवाभ्यधावताम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2186267, "chapter_id": 4955, "verse_number": "७", "content_sanskrit": "तयोः सम्प्राप्तयोरुष्ट्रः स्कन्धदेशममर्षणः ।\nउत्थायोत्क्षिप्य तौ दम्यौ प्रससार महाजवः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2186268, "chapter_id": 4955, "verse_number": "८", "content_sanskrit": "ह्रियमाणौ तु तौ दम्यौ तेनोष्ट्रेण प्रमाथिना ।\nम्रियमाणौ च सम्प्रेक्ष्य मङ्किस्तत्राब्रवीदिदम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2186269, "chapter_id": 4955, "verse_number": "९", "content_sanskrit": "न चैवाविहितं शक्यं दक्षेणापीहितुं धनम् ।\nयुक्तेन श्रद्धया सम्यगीहां समनुतिष्ठता\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2186270, "chapter_id": 4955, "verse_number": "१०", "content_sanskrit": "कृतस्य पूर्वं चानर्थैर्युक्तस्याप्यनुतिष्ठतः ।\nइमं पश्यत सङ्गत्या मम दैवमुपप्लवम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2186271, "chapter_id": 4955, "verse_number": "११", "content_sanskrit": "उद्यम्योद्यम्य मे दम्यौ विषमेणेव गच्छति ।\nअतिष्ठत् काकतालीयमुन्माथेनेव जम्बुकम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2186272, "chapter_id": 4955, "verse_number": "१२", "content_sanskrit": "मणी वोष्ट्रस्य लम्बेते प्रियौ वत्सतरौ मम ।\nशुद्धं हि दैवमेवेदमतो नैवास्ति पौरुषम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2186273, "chapter_id": 4955, "verse_number": "१३", "content_sanskrit": "यदि वाप्युपपद्येत पौरुषं नाम कर्हिचित् ।\nअन्विष्यमाणं तदपि दैवमेवावतिष्ठते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2186274, "chapter_id": 4955, "verse_number": "१४", "content_sanskrit": "तस्मान्निर्वेद एवेह गन्तव्यः सुखमीप्सता ।\nसुखं स्वपिति निर्विण्णो निराशश्चार्थसाधने\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2186275, "chapter_id": 4955, "verse_number": "१५", "content_sanskrit": "अहो सम्यक् शुकेनोक्तं सर्वतः परिमुच्यता ।\nप्रतिष्ठता महारण्यं जनकस्य निवेशनात्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2186276, "chapter_id": 4955, "verse_number": "१६", "content_sanskrit": "यः कामान् प्राप्नुयात् सर्वान् यश्चैनान् केवलांस्त्यजेत् ।\nप्रापणात् सर्वकामानां परित्यागो विशिष्यते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2186277, "chapter_id": 4955, "verse_number": "१७", "content_sanskrit": "नान्तं सर्वविवित्सानां गतपूर्वोऽस्ति कश्चन ।\nशरीरे जीविते चैव तृष्णा मन्दस्य वर्धते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2186278, "chapter_id": 4955, "verse_number": "१८", "content_sanskrit": "निवर्तस्व विवित्साभ्यः सम्यङ् निर्विद्य मामकः ।\nअसकृच्चासि निकृतो न च निर्विद्यसे तनो\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2186279, "chapter_id": 4955, "verse_number": "१९", "content_sanskrit": "यदि नाहं विनाश्यस्ते यद्येवं रमसे मया ।\nमा मां योजय लोभेन वृथा त्वं वित्तकामुक\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2186280, "chapter_id": 4955, "verse_number": "२०", "content_sanskrit": "सञ्चितं सञ्चितं द्रव्यं नष्टं तव पुनः पुनः ।\nकदा विमोक्ष्यसे मूढ धनेहां धनकामुक\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2186281, "chapter_id": 4955, "verse_number": "२१", "content_sanskrit": "अहो नु मम बालिश्यं योऽहं क्रीडनकस्तव ।\nकिं नैव जातु पुरुषः परेषां प्रेष्यतामियात्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2186282, "chapter_id": 4955, "verse_number": "२२", "content_sanskrit": "न पूर्वे नापरे जातु कामानामन्तमाप्नुवन् ।\nत्यक्त्वा सर्वसमारम्भान् प्रतिबुद्धोऽस्मि जागृमि\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2186283, "chapter_id": 4955, "verse_number": "२३", "content_sanskrit": "नूनं ते हृदयं काम वज्रसारमयं दृधम् ।\nयदनर्थशताविष्टं शतधा न विदीर्यते\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2186284, "chapter_id": 4955, "verse_number": "२४", "content_sanskrit": "त्यजामि काम त्वां चैव यच्च किञ्चित् प्रियं तव ।\nतवाहं सुखमन्विच्छन्नात्मन्युपलभे सुखम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2186285, "chapter_id": 4955, "verse_number": "२५", "content_sanskrit": "काम जानामि ते मूलं सङ्कल्पात् किल जायसे ।\nन त्वां सङ्कल्पयिष्यामि समूलो न भविष्यसि\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2186286, "chapter_id": 4955, "verse_number": "२६", "content_sanskrit": "ईहा धनस्य न सुखा लब्ध्वा चिन्ता च भूयसी ।\nलब्धनाशो यथा मृत्युर्लब्धं भवति वा न वा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2186287, "chapter_id": 4955, "verse_number": "२७", "content_sanskrit": "परेत्य यो न लभते ततो दुःखतरं नु किम् ।\nन च तुष्यति लब्धेन भूय एव च मार्गति\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2186288, "chapter_id": 4955, "verse_number": "२८", "content_sanskrit": "अनुतर्षुल एवार्थः स्वादु गाङ्गमिवोदकम् ।\nमद्विलापनमेतत्तु प्रतिबुद्धोऽस्मि सन्त्यज\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2186289, "chapter_id": 4955, "verse_number": "२९", "content_sanskrit": "य इमं मामकं देहं भूतग्रामः समाश्रितः ।\nमयार्थितो यथाकामं वसतां वा यथासुखम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2186290, "chapter_id": 4955, "verse_number": "३०", "content_sanskrit": "न युष्मास्विह मे प्रीतिः कामलोभानुसारिषु ।\nतस्मादुत्सृज्य सर्वान् वः सत्त्वमेवाश्रयाम्यहम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2186291, "chapter_id": 4955, "verse_number": "३१", "content_sanskrit": "सर्वभूतान्यहं देहे पश्यन्मनसि चात्मनः ।\nयोगे बुद्धिं श्रुते सत्त्वं मनो ब्रह्मणि धारयन्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2186292, "chapter_id": 4955, "verse_number": "३२", "content_sanskrit": "विहरिष्याम्यनासक्तः सुखी लोकान्निरामयः ।\nयथा मा त्वं पुनर्नैवं दुःखेषु प्रणिधास्यसि\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2186293, "chapter_id": 4955, "verse_number": "३३", "content_sanskrit": "त्वया हि मे प्रणुन्नस्य गतिरन्या न विद्यते ।\nतृष्णाशोकश्रमाणां हि त्वं काम प्रभवः सदा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2186294, "chapter_id": 4955, "verse_number": "३४", "content_sanskrit": "धननाशोऽधिकं दुःखं मन्ये सर्वमहत्तरम् ।\nज्ञातयो ह्यवमन्यन्ते मित्राणि च धनच्युतम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2186295, "chapter_id": 4955, "verse_number": "३५", "content_sanskrit": "अवज्ञानसहस्रैस्तु दोषाः कष्टतराधने ।\nधने सुखकला या च सापि दुःखैर्विधीयते\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2186296, "chapter_id": 4955, "verse_number": "३६", "content_sanskrit": "धनमस्येति पुरुषं पुरा निघ्नन्ति दस्यवः ।\nक्लिश्यन्ति विविधैर्दण्डैर्नित्यमुद्वेजयन्ति च\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2186297, "chapter_id": 4955, "verse_number": "३७", "content_sanskrit": "मन्दलोलुपता दुःखमिति बुद्धं चिरान्मया ।\nयद्यदालम्बसे काम तत्तदेवानुरुध्यसे\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2186298, "chapter_id": 4955, "verse_number": "३८", "content_sanskrit": "अतत्त्वज्ञोऽसि बालश्च दुस्तोषोऽपूरणोऽनलः ।\nनैव त्वं वेत्थ सुलभं नैव त्वं वेत्थ दुर्लभम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2186299, "chapter_id": 4955, "verse_number": "३९", "content_sanskrit": "पातालमिव दुष्पूरो मां दुःखैर्योक्तुमिच्छसि ।\nनाहमद्य समावेष्टुं शक्यः काम पुनस्त्वया\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2186300, "chapter_id": 4955, "verse_number": "४०", "content_sanskrit": "निर्वेदमहमासाद्य द्रव्यनाशाद्यदृच्छया ।\nनिर्वृतिं परमां प्राप्य नाद्य कामान् विचिन्तये\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2186301, "chapter_id": 4955, "verse_number": "४१", "content_sanskrit": "अतिक्लेशान् सहामीह नाहं बुध्याम्यबुद्धिमान् ।\nनिकृतो धननाशेन शये सर्वाङ्गविज्वरः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2186302, "chapter_id": 4955, "verse_number": "४२", "content_sanskrit": "परित्यजामि काम त्वां हित्वा सर्वमनोगतीः ।\nन त्वं मया पुनः काम नस्योतेनेव रंस्यसे\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2186303, "chapter_id": 4955, "verse_number": "४३", "content_sanskrit": "क्षमिष्येऽक्षममाणानां न हिंसिष्ये च हिंसितः ।\nद्वेष्यमुक्तः प्रियं वक्ष्याम्यनादृत्य तदप्रियम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2186304, "chapter_id": 4955, "verse_number": "४४", "content_sanskrit": "तृप्तः स्वस्थेन्द्रियो नित्यं यथालब्धेन वर्तयन् ।\nन सकामं करिष्यामि त्वामहं शत्रुमात्मनः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2186305, "chapter_id": 4955, "verse_number": "४५", "content_sanskrit": "निर्वेदं निर्वृतिं तृप्तिं शान्तिं सत्यं दमं क्षमाम् ।\nसर्वभूतदयां चैव विद्धि मां शरणागतम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2186306, "chapter_id": 4955, "verse_number": "", "content_sanskrit": "तस्मात् कामश्च लोभश्च तृष्णा कार्पण्यमेव च ।\nत्यजन्तु मां प्रतिष्ठन्तं सत्त्वस्थो ह्यस्मि साम्प्रतम्\t॥४६", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2186307, "chapter_id": 4955, "verse_number": "४७", "content_sanskrit": "प्रहाय कामं लोभं च क्रोधं पारुष्यमेव च ।\nनाद्य लोभवशं प्राप्तो दुःखं प्राप्स्याम्यनात्मवान्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2186308, "chapter_id": 4955, "verse_number": "४८", "content_sanskrit": "यद्यत्त्यजति कामानां तत् सुखस्याभिपूर्यते ।\nकामस्य वशगो नित्यं दुःखमेव प्रपद्यते\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2186309, "chapter_id": 4955, "verse_number": "४९", "content_sanskrit": "कामान् व्युदस्य धुनुते यत्किञ्चित् पुरुषो रजः ।\nकामक्रोधोद्भवं दुःखमह्रीररतिरेव च\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2186310, "chapter_id": 4955, "verse_number": "५०", "content_sanskrit": "एष ब्रह्मप्रविष्टोऽहं ग्रीष्मे शीतमिव ह्रदम् ।\nशाम्यामि परिनिर्वामि सुखमासे च केवलम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2186311, "chapter_id": 4955, "verse_number": "५१", "content_sanskrit": "यच्च कामसुखं लोके यच्च दिव्यं महत् सुखम् ।\nतृष्णाक्षयसुखस्यैते नार्हतः षोडशीं कलाम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2186312, "chapter_id": 4955, "verse_number": "५२", "content_sanskrit": "आत्मना सप्तमं कामं हत्वा शत्रुमिवोत्तमम् ।\nप्राप्यावध्यं ब्रह्मपुरं राजेव स्यामहं सुखी\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2186313, "chapter_id": 4955, "verse_number": "", "content_sanskrit": "एतां बुद्धिं समास्थाय मङ्किर्निर्वेदमागतः ।\nसर्वान् कामान् परित्यज्य प्राप्य ब्रह्म महत् सुखम्\t॥५३", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2186314, "chapter_id": 4955, "verse_number": "५४", "content_sanskrit": "दम्यनाशकृते मङ्किरमरत्वं किलागमत् ।\nअच्छिनत् काममूलं स तेन प्राप महत् सुखम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2186315, "chapter_id": 4955, "verse_number": "५५", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nगीतं विदेहराजेन जनकेन प्रशाम्यता\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2186316, "chapter_id": 4955, "verse_number": "५६", "content_sanskrit": "अनन्तं बत मे वित्तं यस्य मे नास्ति किञ्चन ।\nमिथिलायां प्रदीप्तायां न मे दह्यति किञ्चन\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2186317, "chapter_id": 4955, "verse_number": "५७", "content_sanskrit": "अत्रैवोदाहरन्तीमं बोध्यस्य पदसञ्चयम् ।\nनिर्वेदं प्रति विन्यस्तं प्रतिबोध युधिष्ठिर\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2186318, "chapter_id": 4955, "verse_number": "५८", "content_sanskrit": "बोध्यं दान्तमृषिं राजा नहुषः पर्यपृच्छत ।\nनिर्वेदाच्छान्तिमापन्नं शान्तं प्रज्ञानतर्पितम्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2186319, "chapter_id": 4955, "verse_number": "५९", "content_sanskrit": "उपदेशं महाप्राज्ञ शमस्योपदिशस्व मे ।\nकां बुद्धिं समनुध्याय शान्तश्चरसि निर्वृतः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2186320, "chapter_id": 4955, "verse_number": "", "content_sanskrit": "बोध्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2186321, "chapter_id": 4955, "verse_number": "६०", "content_sanskrit": "उपदेशेन वर्तामि नानुशास्मीह कञ्चन ।\nलक्षणं तस्य वक्ष्येऽहं तत्स्वयं प्रविमृश्यताम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2186322, "chapter_id": 4955, "verse_number": "६१", "content_sanskrit": "पिङ्गला कुररः सर्पः सारङ्गान्वेषणं वने ।\nइषुकारः कुमारी च षडेते गुरवो मम\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2186323, "chapter_id": 4955, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे चतुर्थोऽध्यायः ॥४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]