[{"id": 2206723, "chapter_id": 5405, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2206724, "chapter_id": 5405, "verse_number": "१", "content_sanskrit": "ततः कुन्तीसुतो राजा पौरजानपदं जनम् ।\nपूजयित्वा यथान्यायं अनुजज्ञे गृहान् प्रति\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2206725, "chapter_id": 5405, "verse_number": "२", "content_sanskrit": "सान्त्वयामास नारीश्च हतवीरा हतेश्वराः ।\nविपुलैरर्थदानैश्च तदा पाण्डुसुतो नृपः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2206726, "chapter_id": 5405, "verse_number": "३", "content_sanskrit": "सोऽभिषिक्तो महाप्राज्ञः प्राप्य राज्यं युधिष्ठिरः ।\nअवस्थाप्य नरश्रेष्ठः सर्वाः स्वप्रकृतीस्तदा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2206727, "chapter_id": 5405, "verse_number": "४", "content_sanskrit": "द्विजेभ्यो बलमुख्येभ्यो नैगमेभ्यश्च सर्वशः ।\nप्रतिगृह्याशिषो मुख्यास्तदा धर्मभृतांवरः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2206728, "chapter_id": 5405, "verse_number": "५", "content_sanskrit": "उषित्वा शर्वरीः श्रीमान् पञ्चाशन्नगरोत्तमे ।\nसमयं कौरवाग्र्यस्य सस्मार पुरुषर्षभः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2206729, "chapter_id": 5405, "verse_number": "६", "content_sanskrit": "स निर्ययौ गजपुराद् याजकैः परिवारितः ।\nदृष्ट्वा निवृत्तमादित्यं प्रवृत्तं चोत्तरायणम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2206730, "chapter_id": 5405, "verse_number": "७", "content_sanskrit": "घृतं माल्यं च गन्धांश्च क्षौमाणि च युधिष्ठिरः ।\nचन्दनागरुमुख्यानि तथा कालागरूणि च\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2206731, "chapter_id": 5405, "verse_number": "८", "content_sanskrit": "प्रस्थाप्य पूर्वं कौन्तेयो भीष्मसंस्करणाय च ।\nमाल्यानि च महार्हाणि रत्नानि विविधानि च\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2206732, "chapter_id": 5405, "verse_number": "९", "content_sanskrit": "धृतराष्ट्रं पुरस्कृत्य गान्धारीं च यशस्विनीम् ।\nमातरं च पृथां धीमान् भ्रातॄंश्च पुरुषर्षभः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2206733, "chapter_id": 5405, "verse_number": "१०", "content_sanskrit": "जनार्दनेनानुगतो विदुरेण च धीमता ।\nयुयुत्सुना च कौरव्यो युयुधानेन चाभिभो\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2206734, "chapter_id": 5405, "verse_number": "११", "content_sanskrit": "महता राजभोग्येन परिबर्हेण संवृतः ।\nस्तूयमानो महाराज भीष्मस्याग्नीननुव्रजन्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2206735, "chapter_id": 5405, "verse_number": "१२", "content_sanskrit": "निश्चक्राम पुरात् तस्माद् यथा देवपतिस्तथा ।\nआससाद कुरुक्षेत्रे ततः शान्तनवं नृपम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2206736, "chapter_id": 5405, "verse_number": "१३", "content_sanskrit": "उपास्यमानं व्यासेन पाराशर्येण धीमता ।\nनारदेन च राजर्षे देवलेनासितेन च\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2206737, "chapter_id": 5405, "verse_number": "१४", "content_sanskrit": "हतशिष्टैर्नृपैश्चान्यैर्नानादेशसमागतैः ।\nरक्षिभिश्च महात्मानं रक्ष्यमाणं समन्ततः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2206738, "chapter_id": 5405, "verse_number": "१५", "content_sanskrit": "शयानं वीरशयने ददर्श नृपतिस्ततः ।\nततो रथादवारोहद् भ्रातृभिः सह धर्मराट्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2206739, "chapter_id": 5405, "verse_number": "१६", "content_sanskrit": "अभिवाद्याथ कौन्तेयः पितामहमरिन्दमम् ।\nद्वैपायनादीन् विप्रांश्च तैश्च प्रत्यभिनन्दितः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2206740, "chapter_id": 5405, "verse_number": "१७", "content_sanskrit": "ऋत्विग्भिर्ब्रह्मकल्पैश्च भ्रातृभिश्च सहाच्युतः ।\nआसाद्य शरतल्पस्थमृषिभिः परिवारितम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2206741, "chapter_id": 5405, "verse_number": "१८", "content_sanskrit": "अब्रवीद् भरतश्रेष्ठं धर्मराजो युधिष्ठिरः ।\nभ्रातृभिः सह कौरव्य शयानं निम्नगासुतम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2206742, "chapter_id": 5405, "verse_number": "१९", "content_sanskrit": "युधिष्ठिरोऽहं नृपते नमस्ते जाह्नवीसुत ।\nशृणोषि चेन्महाबाहो ब्रूहि किं करवाणि ते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2206743, "chapter_id": 5405, "verse_number": "२०", "content_sanskrit": "प्राप्तोऽस्मि समये राजन्नग्नीनादाय ते विभो ।\nआचार्या ब्राह्मणाश्चैव ऋत्विजो भ्रातरश्च मे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2206744, "chapter_id": 5405, "verse_number": "२१", "content_sanskrit": "पुत्रश्च ते महातेजा धृतराष्ट्रो जनेश्वरः ।\nउपस्थितः सहामात्यो वासुदेवश्च वीर्यवान्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2206745, "chapter_id": 5405, "verse_number": "२२", "content_sanskrit": "हतशिष्टाश्च राजानः सर्वे च कुरुजाङ्गलाः ।\nतान् पश्य कुरुशार्दूल समुन्मील्य च लोचने\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2206746, "chapter_id": 5405, "verse_number": "२३", "content_sanskrit": "यच्चेह किञ्चित् कर्तव्यं तत्सर्वं प्रापितं मया ।\nयथोक्तं भवता काले सर्वमेव च तत् कृतम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2206747, "chapter_id": 5405, "verse_number": "२४", "content_sanskrit": "एवमुक्तस्तु गाङ्गेयः कुन्तीपुत्रेण धीमता ।\nददर्श भारतान् सर्वान् स्थितान् सम्परिवार्य तम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2206748, "chapter_id": 5405, "verse_number": "२५", "content_sanskrit": "ततश्चलवलिर्भीष्मः प्रगृह्य विपुलं भुजम् ।\nओघमेघस्वनो वाग्मी काले वचनमब्रवीत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2206749, "chapter_id": 5405, "verse_number": "२६", "content_sanskrit": "दिष्ट्या प्राप्तोऽसि कौन्तेय सहामात्यो युधिष्ठिर ।\nपरिवृत्तो हि भगवान् सहस्रांशुर्दिवाकरः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2206750, "chapter_id": 5405, "verse_number": "२७", "content_sanskrit": "अष्टपञ्चाशतं रात्र्यः शयानस्याद्य मे गताः ।\nशरेषु निशिताग्रेषु यथा वर्षशतं तथा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2206751, "chapter_id": 5405, "verse_number": "२८", "content_sanskrit": "माघोऽयं समनुप्राप्तो मासः पुण्यो युधिष्ठिर ।\nत्रिभागशेषः पक्षोऽयं शुक्लो भवितुमर्हति\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2206752, "chapter_id": 5405, "verse_number": "२९", "content_sanskrit": "एवमुक्त्वा तु गाङ्गेयो धर्मपुत्रं युधिष्ठिरम् ।\nधृतराष्ट्रमथामन्त्र्य काले वचनमब्रवीत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2206753, "chapter_id": 5405, "verse_number": "३०", "content_sanskrit": "राजन् विदितधर्मोऽसि सुनिर्णीतार्थसंशयः ।\nबहुश्रुता हि ते विप्रा बहवः पर्युपासिताः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2206754, "chapter_id": 5405, "verse_number": "३१", "content_sanskrit": "वेदशास्त्राणि सर्वाणि धर्मांश्च मनुजेश्वर ।\nवेदांश्च चतुरः साङ्गान् अखिलेनैवबुद्ध्यथाः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2206755, "chapter_id": 5405, "verse_number": "३२", "content_sanskrit": "न शोचितव्यं कौरव्य भवितव्यं हि तत् तथा ।\nश्रुतं देवरहस्यं ते कृष्णद्वैपायनादपि\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2206756, "chapter_id": 5405, "verse_number": "३३", "content_sanskrit": "यथा पाण्डोः सुता राजंस्तथैव तव धर्मतः ।\nतान् पालय स्थितो धर्मे गुरुशुश्रूषणे रतान्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2206757, "chapter_id": 5405, "verse_number": "३४", "content_sanskrit": "धर्मराजो हि शुद्धात्मा निदेशे स्थास्यते तव ।\nआनृशंस्यपरं ह्येनं जानामि गुरुवत्सलम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2206758, "chapter_id": 5405, "verse_number": "३५", "content_sanskrit": "तव पुत्रा दुरात्मानः क्रोधलोभपरायणाः ।\nईर्ष्याभिभूता दुर्वृत्तास्तान्न शोचितुमर्हसि\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2206759, "chapter_id": 5405, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2206760, "chapter_id": 5405, "verse_number": "३६", "content_sanskrit": "एतावदुक्त्वा वचनं धृतराष्ट्रं मनीषिणम् ।\nवासुदेवं महाबाहुमभ्यभाषत कौरवः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2206761, "chapter_id": 5405, "verse_number": "३७", "content_sanskrit": "भगवन् देवदेवेश सुरासुरनमस्कृत ।\nत्रिविक्रम नमस्तेऽस्तु शङ्खचक्रगदाधर\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2206762, "chapter_id": 5405, "verse_number": "३८", "content_sanskrit": "अनुजानीहि मां कृष्ण वैकुण्ठ पुरुषोत्तम ।\nरक्ष्याश्च ते पाण्डवेया भवान् ह्येषां परायणम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2206763, "chapter_id": 5405, "verse_number": "३९", "content_sanskrit": "उक्तवानस्मि दुर्बुद्धिं मन्दं दुर्योधनं पुरा ।\nयतः कृष्णस्ततो धर्मो यतो धर्मस्ततो जयः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2206764, "chapter_id": 5405, "verse_number": "४०", "content_sanskrit": "वासुदेवेन तीर्थेन पुत्र संशाम्य पाण्डवैः ।\nसन्धानस्य परः कालस्तवेति च पुनः पुनः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2206765, "chapter_id": 5405, "verse_number": "४१", "content_sanskrit": "न च मे तद्वचो मूढः कृतवान् स सुमन्दधीः ।\nघातयित्वेह पृथिवीं ततः स निधनं गतः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2206766, "chapter_id": 5405, "verse_number": "४२", "content_sanskrit": "त्वां च जानाम्यहं वीर पुराणमृषिसत्तमम् ।\nनरेण सहितं देवं बदर्यां सुचिरोषितम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2206767, "chapter_id": 5405, "verse_number": "४३", "content_sanskrit": "तथा मे नारदः प्राह व्यासश्च सुमहातपाः ।\nनरनारायणावेतौ सम्भूतौ मनुजेष्विति\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2206768, "chapter_id": 5405, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2206769, "chapter_id": 5405, "verse_number": "४४", "content_sanskrit": "अनुजानामि भीष्म त्वां वसूनाप्नुहि पार्थिव ।\nन तेऽस्ति वृजिनं किञ्चिन्मया दृष्टं महाद्युते\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2206770, "chapter_id": 5405, "verse_number": "४५", "content_sanskrit": "पितृभक्तोऽसि राजर्षे मार्कण्डेय इवापरः ।\nतेन मृत्युस्तव वशे स्थितो भृत्य इवानतः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2206771, "chapter_id": 5405, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2206772, "chapter_id": 5405, "verse_number": "४६", "content_sanskrit": "एवमुक्तस्तु गाङ्गेयः पाण्डवानिदमब्रवीत् ।\nधृतराष्ट्रमुखांश्चापि सर्वान् ससुहृदस्तथा\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2206773, "chapter_id": 5405, "verse_number": "४७", "content_sanskrit": "प्राणानुत्स्रष्टुमिच्छामि तन्माऽनुज्ञातुमर्हथ ।\nसत्ये तु यतितव्यं वः सत्यं हि परमं बलम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2206774, "chapter_id": 5405, "verse_number": "४८", "content_sanskrit": "आनृशंस्यपरैर्भाव्यं सदैव नियतात्मभिः ।\nब्रह्मण्यैर्धर्मशीलैश्च तपोनित्यैश्च भारत\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2206775, "chapter_id": 5405, "verse_number": "४९", "content_sanskrit": "इत्युक्त्वा सुहृदः सर्वान् सम्परिष्वज्य चैव ह ।\nपुनरेवाब्रवीद् धीमान् युधिष्ठिरमिदं वचः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2206776, "chapter_id": 5405, "verse_number": "५०", "content_sanskrit": "ब्राह्मणाश्चैव ते नित्यं प्राज्ञाश्चैव विशेषतः ।\nआचार्या ऋत्विजश्चैव पूजनीया नराधिप\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2206777, "chapter_id": 5405, "verse_number": "२५६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि षट्पञ्चाशोत्तरद्विशततमोऽध्यायः ॥२५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2206778, "chapter_id": 5405, "verse_number": "", "content_sanskrit": "॥ भीष्मस्वर्गारोहणपर्वणि भीष्मवचनं नाम प्रथमोऽध्यायः ॥१॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]