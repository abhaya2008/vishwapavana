[{"id": 7006198000, "chapter_id": 26198, "verse_number": "२-२६-१", "content_sanskrit": "वशिष्ठ उवाच इति पृष्टस्तदा ताभ्यां रामो राजन्कृताञ्जलिः ।\nतयोरकथयत्सर्वमात्मना यदनुष्ठितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006198001, "chapter_id": 26198, "verse_number": "२-२६-२", "content_sanskrit": "निदेशाद्वै कुलगुरोस्तपश्चरणमात्मनः ।\nशंभोर्निदेशात्तीर्थानामटनं च यथाक्रमम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006198002, "chapter_id": 26198, "verse_number": "२-२६-३", "content_sanskrit": "तदाज्ञयैव दैत्यनां वधं चामरकारणात् ।\nहरप्रसादादत्रापि ह्यकृतव्रणदर्शनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006198003, "chapter_id": 26198, "verse_number": "२-२६-४", "content_sanskrit": "एतत्सर्वमशेषेण यदन्यच्चात्मना कृतम् ।\nकथयामास तद्रामः पित्रोः संप्रीयमाणयोः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006198004, "chapter_id": 26198, "verse_number": "२-२६-५", "content_sanskrit": "तौ च तेनोदितं सर्वं श्रुत्वा तत्कर्म विस्तरम् ।\nहृष्टौ हर्षान्तरं भूयो राजन्नाप्नुवतावुभौ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006198005, "chapter_id": 26198, "verse_number": "२-२६-६", "content_sanskrit": "एवं पित्रोर्महाराज शुश्रूषां भृगुपुङ्गवः ।\nप्रकुर्वंस्तद्विधेयात्मा भ्रातॄणां चाविशेषतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006198006, "chapter_id": 26198, "verse_number": "२-२६-७", "content_sanskrit": "एतस्मिन्नेव काले तु कदाचिद्धैहयेश्वरः ।\nइत्येष मृगयां गान्तुं चतुरङ्गबलान्वितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006198007, "chapter_id": 26198, "verse_number": "२-२६-८", "content_sanskrit": "संरज्यमाने गगने बन्धूककुसुमारुणैः ।\nताराजालद्युतिहरैः समन्तादरुणांशुभिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006198008, "chapter_id": 26198, "verse_number": "२-२६-९", "content_sanskrit": "मन्दं वीजति प्रोद्धूतकेतकीवनराजिभिः ।\nप्राभातिके गन्धवहे कुमुदाकरसंस्पृशि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006198009, "chapter_id": 26198, "verse_number": "२-२६-१०", "content_sanskrit": "वयांसि नर्मदातीरतरुनीडाश्रयेषु च ।\nव्याहरन्स्वाकुला वाचो मनःश्रोत्रसुखावहाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006198010, "chapter_id": 26198, "verse_number": "२-२६-११", "content_sanskrit": "नर्मदातीरतीर्थं तदवतीर्याघहारिणि ।\nतत्तोये मुनिवृन्देषु गृणात्सुब्रह्म शाश्वतम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006198011, "chapter_id": 26198, "verse_number": "२-२६-१२", "content_sanskrit": "विधिवत्कृतमैत्रेषु सन्निवृत्य सरित्तटात् ।\nआशमं प्रति गच्छत्सु मुनिमुख्येषु कर्मिषु ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006198012, "chapter_id": 26198, "verse_number": "२-२६-१३", "content_sanskrit": "प्रत्येकं वीरपत्नीषु व्यग्रासु गृहकर्मसु ।\nहोमार्थं मुनिकल्पाभिर्दुह्यमानासु धेनुषु ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006198013, "chapter_id": 26198, "verse_number": "२-२६-१४", "content_sanskrit": "स्थाने मुनिकुमारेषु तं दोहं हि नयत्सु च ।\nअग्निहोत्राकुले जाते सर्वभूतसुखावहे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006198014, "chapter_id": 26198, "verse_number": "२-२६-१५", "content_sanskrit": "विकसत्सु सरोजेषु गायत्सु भ्रमरेषु च ।\nवाशत्सु नीडान्निष्पत्य पतत्रिषु समन्ततः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006198015, "chapter_id": 26198, "verse_number": "२-२६-१६", "content_sanskrit": "अनति व्यग्रमत्तेभतुरङ्गरथगामिनाम् ।\nगात्राल्हादविवर्द्धन्यां वेलायां मन्दवायुना ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006198016, "chapter_id": 26198, "verse_number": "२-२६-१७", "content_sanskrit": "गच्छत्सु चाश्रमोपान्तं प्रसूनजलहारिषु ।\nस्वाध्या यदक्षैर्बहुभिरजिनांबरधारिभिः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006198017, "chapter_id": 26198, "verse_number": "२-२६-१८", "content_sanskrit": "सम्यक्प्रयोज्यमानेषु मन्त्रेषूच्चावचेषु च ।\nप्रैषेषूच्चार्यमाणेषु हूयमानेषु वह्निषु ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006198018, "chapter_id": 26198, "verse_number": "२-२६-१९", "content_sanskrit": "यथा वन्मन्त्रतन्त्रोक्तक्रियासु विततासु च ।\nज्वलदग्निशिखाकारे तमस्तपनतेजसि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006198019, "chapter_id": 26198, "verse_number": "२-२६-२०", "content_sanskrit": "प्रतिहत्य दिशः सर्वा विवृण्वाने च मेदिनीम् ।\nसवितर्युदयं याति नैशे तमसि नश्यति ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006198020, "chapter_id": 26198, "verse_number": "२-२६-२१", "content_sanskrit": "तारकासु विलीनासु काष्ठासु विमलासु च ।\nकृतमैत्रादिको राजा मृगयां हैहयेश्वरः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006198021, "chapter_id": 26198, "verse_number": "२-२६-२२", "content_sanskrit": "निर्ययौ नगरात्तस्मात्पुरोहितसमन्वितः ।\nबलैः सर्वैः समुदितैः सवाजिरथकुञ्जरैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006198022, "chapter_id": 26198, "verse_number": "२-२६-२३", "content_sanskrit": "सचिवः सहितः श्रीमान् सवयोभिश्च राजभिः ।\nमहता बलभारेण नमयन्वसुधातलम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006198023, "chapter_id": 26198, "verse_number": "२-२६-२४", "content_sanskrit": "नादयन्रथघोषेण ककुभः सर्वतो नृपः ।\nस्वबलौघपदक्षेपप्रक्षुण्णावनिरेणुभिः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006198024, "chapter_id": 26198, "verse_number": "२-२६-२५", "content_sanskrit": "ययौ संच्छादयन्व्योम विमानशतसंकुलम् ।\nसंप्रवश्य वनं घोरं विन्ध्योद्रेर्बलसंचयैः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006198025, "chapter_id": 26198, "verse_number": "२-२६-२६", "content_sanskrit": "भृशं विलोलया मास समन्ताद्राजसत्तमः ।\nपरिवार्य वनं तत्तु स राजा निजसैनिकैः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006198026, "chapter_id": 26198, "verse_number": "२-२६-२७", "content_sanskrit": "मृगान्नानाविधान्हिंस्रान्निजघान शितैः शरैः ।\nआकर्णकृष्टकोदण्डयोधमुक्तैः शितेषुभिः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006198027, "chapter_id": 26198, "verse_number": "२-२६-२८", "content_sanskrit": "निकृत्तगात्राः शार्दूला न्यपतन्भुवि केचन ।\nउदग्रवेगपादातखड्गखण्डितविग्रहाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006198028, "chapter_id": 26198, "verse_number": "२-२६-२९", "content_sanskrit": "वराहयूथपाः केचिद्रुधिरार्द्रा धरामगुः ।\nप्रचण्डशाक्तिकोन्मुक्तशक्तिनिर्भिन्नमस्तकाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006198029, "chapter_id": 26198, "verse_number": "२-२६-३०", "content_sanskrit": "मृगौघाः प्रत्यपद्यन्त पर्वता इव मेदिनीम् ।\nनाराचा विद्धसर्वाङ्गाः सिंहर्क्षशरभादयः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006198030, "chapter_id": 26198, "verse_number": "२-२६-३१", "content_sanskrit": "वसुधामन्वकीर्यन्त शोणितार्द्राः समन्ततः ।\nएवं सवागुरैः कैश्चित्पतद्भिः पतितैरपि ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006198031, "chapter_id": 26198, "verse_number": "२-२६-३२", "content_sanskrit": "श्वभिश्चानुद्रुतैः कैश्चिद्धावमानैस्तथा मृगैः ।\nआत्तैर्विक्रोशमानैश्च भीतैः प्राणभयातुरैः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006198032, "chapter_id": 26198, "verse_number": "२-२६-३३", "content_sanskrit": "युगापाये यथात्यर्थं वनमाकुलमाबभौ ।\nवराहसिंहशार्दूलश्वाविच्छशकुलानि च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006198033, "chapter_id": 26198, "verse_number": "२-२६-३४", "content_sanskrit": "चमरीरुरुगोमायुगवयर्क्षवृकान्बहून् ।\nकृष्णसारान्द्वीपिमृगान्रक्तखड्गमृगानवि ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006198034, "chapter_id": 26198, "verse_number": "२-२६-३५", "content_sanskrit": "विचित्राङ्गान्मृगानन्यान्न्यङ्कूनपि च सर्वशः ।\nबालान्स्तनन्धयान्यूनः स्थविरान्मिथुनान्गणान् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006198035, "chapter_id": 26198, "verse_number": "२-२६-३६", "content_sanskrit": "निजघ्नुर्निशितैः शस्त्रैः शस्त्रवध्यान्हि सैनिकाः ।\nएवं हत्वा मृगान् घोरान्हिंस्रप्रायानशेषतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006198036, "chapter_id": 26198, "verse_number": "२-२६-३७", "content_sanskrit": "श्रमेण महता युक्ता बभूवुर्नृपसैनिकाः ।\nमध्ये दिनकरे प्राप्ते ससैन्यः स तदा नृपः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006198037, "chapter_id": 26198, "verse_number": "२-२६-३८", "content_sanskrit": "नर्मदां धर्मसंतप्तः पिपासुरगमच्छनैः ।\nअवतीय ततस्तस्यास्तोये सबलवाहनः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006198038, "chapter_id": 26198, "verse_number": "२-२६-३९", "content_sanskrit": "विजागाह शुभे राजा क्षुत्तृष्णापरिपीडितः ।\nस्नात्वा पीत्वा च सलिलं स तस्याः सुखशीतलम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006198039, "chapter_id": 26198, "verse_number": "२-२६-४०", "content_sanskrit": "बिसांकुराणि शुभ्राणि स्वादूनि प्रजघास च ।\nविक्रीड्य तोये सुचिरमुत्तीर्य सबलो नृपः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006198040, "chapter_id": 26198, "verse_number": "२-२६-४१", "content_sanskrit": "विशश्राम च तत्तीरे तरुखण्डोपमण्डिते ।\nआलंबपाने तिग्मांशौ ससैन्यः सानुगो नृपः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006198041, "chapter_id": 26198, "verse_number": "२-२६-४२", "content_sanskrit": "निश्चक्राम पुरं गन्तुं विन्ध्याद्रिवनगह्वरात् ।\nस गच्छन्नेव ददृशे नर्मदा तीरमाश्रितम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006198042, "chapter_id": 26198, "verse_number": "२-२६-४३", "content_sanskrit": "आश्रमं पुण्यशीलस्य जमदग्नेर्महात्मनः ।\nततो निवृत्य सैन्यानि दूरेऽवस्थाप्य पार्थिवः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006198043, "chapter_id": 26198, "verse_number": "२-२६-४४", "content_sanskrit": "परिचारैः कतिपथैः सहितोऽयात्तदाशमम् ।\nगत्वा तदाश्रमं रम्यं पुरोहितसमन्वितः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006198044, "chapter_id": 26198, "verse_number": "२-२६-४५", "content_sanskrit": "उपेत्य मुनिशार्दूलं ननाम शिरसा नृपः ।\nअभिनं द्याशषा तं वै जमदग्निर्नृपोत्तमम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006198045, "chapter_id": 26198, "verse_number": "२-२६-४६", "content_sanskrit": "पूजयामास विधिवदर्घपाद्यासनादिभिः ।\nसंभावयित्वा तां पूजां विहितां मुनिना तदा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006198046, "chapter_id": 26198, "verse_number": "२-२६-४७", "content_sanskrit": "निषसादासने शुभ्र पुरस्तस्य महामुनेः ।\nतमासीनं नृपवरं कुशासनगतो मुनिः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006198047, "chapter_id": 26198, "verse_number": "२-२६-४८", "content_sanskrit": "पप्रच्छ कुशलप्रश्नं पुत्रमित्रादिबन्धुषु ।\nसह संकथयंस्तेन राज्ञा मुनिवरोत्तमः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006198048, "chapter_id": 26198, "verse_number": "२-२६-४९", "content_sanskrit": "स्थित्वा नातिचिरं कालमातिथ्यार्थं न्यमन्त्रयत् ।\nततः स राजा सुप्रीतो जमदग्नि मभाषत ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006198049, "chapter_id": 26198, "verse_number": "२-२६-५०", "content_sanskrit": "महर्षे देहि मेऽनुज्ञां गमिष्यामि स्वकं पुरम् ।\nसमग्रवाहनबलो ह्यहं तस्मान्महामुने ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006198050, "chapter_id": 26198, "verse_number": "२-२६-५१", "content_sanskrit": "कर्तु न शक्यमा तिथ्यं त्वया वन्याशिना वने ।\nअथवा त्वं तपःशक्त्या कर्तुमातिथ्यमद्य मे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006198051, "chapter_id": 26198, "verse_number": "२-२६-५२", "content_sanskrit": "शक्नोष्यपि पुरीं गन्तुं मामनुज्ञातुर्हसि ।\nअन्यथा चेत्खलैः सैन्यैरत्यर्थं मुनिसत्तम ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006198052, "chapter_id": 26198, "verse_number": "२-२६-५३", "content_sanskrit": "तपस्विनां भवेत्पीडा नियमक्षयकारिका ।\nवसिष्ठ उवाच इत्येवमुक्तः स मुनिस्तं प्राहस्थीयतां क्षणम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006198053, "chapter_id": 26198, "verse_number": "२-२६-५४", "content_sanskrit": "सर्वं संपादयिथ्येऽहमातिथ्यं सानुगस्य ते ।\nइत्युक्त्वाहूय तां दोग्ध्रीमुवाचायं ममातिथिः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006198054, "chapter_id": 26198, "verse_number": "२-२६-५५", "content_sanskrit": "उपाग तस्त्वया तस्मात्क्रियतामद्य सत्कृतिः ।\nइत्युक्ता मुनिना दोग्ध्री सातिथेयमशेषतः ।\nदुदोह नृपतेराशु यद्योग्यं मुनिगौरवात् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006198055, "chapter_id": 26198, "verse_number": "२-२६-५६", "content_sanskrit": "अथाश्रमं तत्सुरराजसद्मनिकाशमासीद्भृगुपुङ्गवस्य ।\nविभूतिभेदैरविचिन्त्यरुपमनन्यसाध्यं सुरभिप्रभावात् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006198056, "chapter_id": 26198, "verse_number": "२-२६-५७", "content_sanskrit": "अनेकरत्नोज्ज्वलचित्रहेमप्रकाशमालापरिवीतमुच्चैः ।\nपूर्णेन्दुशुभ्राभ्रविषक्तशृङ्गैः प्रासादसंघैः परिवीतमन्तः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006198057, "chapter_id": 26198, "verse_number": "२-२६-५८", "content_sanskrit": "कांस्यारकूटारसताम्रहेमदुर्वर्णसौधो पलदारुमृद्भिः ।\nपृथग्विमिश्रैर्भवनैरनेकैः सद्भासितं नेत्रमनोभिरामैः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006198058, "chapter_id": 26198, "verse_number": "२-२६-५९", "content_sanskrit": "महार्हरत्नोज्ज्वलहेमवेदिकानिष्कूटसोपानकुटीविटङ्ककैः ।\nतुलाकपाटर्गलकुड्यदेहलीनिशान्तशालाजिरशोभितैर्भृशम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006198059, "chapter_id": 26198, "verse_number": "२-२६-६०", "content_sanskrit": "वलभ्यलिन्दाङ्गपाचारुतोरणैरदभ्रपर्यन्तचतुष्किकादिभिः ।\nस्तंभेषु कुड्येषु च दिव्यरत्नविचित्रचित्रैः परिशोभमानैः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006198060, "chapter_id": 26198, "verse_number": "२-२६-६१", "content_sanskrit": "उच्चावचै रत्नवरैर्विचित्रसुवर्णसिंहासनपीठिकाद्यैः ।\nस भक्ष्यभोज्यादिभि रन्नपानैरुपेतभाण्डोपगतैकदेशैः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006198061, "chapter_id": 26198, "verse_number": "२-२६-६२", "content_sanskrit": "गृहैरमर्त्योचितसर्वसंपत्समन्वितैर्नेत्रमनोऽभिरामैः ।\nतस्याश्रमं सन्नगरोपमानं बभौ वधूभिश्चमनोहराभिः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]