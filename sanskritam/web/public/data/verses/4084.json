[{"id": 2143079, "chapter_id": 4084, "verse_number": "", "content_sanskrit": "बृहस्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2143080, "chapter_id": 4084, "verse_number": "१", "content_sanskrit": "त्वमग्ने सर्वदेवानां मुखं त्वमसि हव्यवाट् ।\nत्वमन्तः सर्वभूतानां गूढश्चरसि साक्षिवत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2143081, "chapter_id": 4084, "verse_number": "२", "content_sanskrit": "त्वामाहुरेकं कवयः त्वामाहुस्त्रिविधं पुनः ।\nत्वया त्यक्तं जगच्चेदं सद्यो नश्येद् हुताशन\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2143082, "chapter_id": 4084, "verse_number": "३", "content_sanskrit": "कृत्वा तुभ्यं नमो विप्राः स्वकर्मविजितां गतिम् ।\nगच्छन्ति सह पत्नीभिः सुतैरपि च शाश्वतीम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2143083, "chapter_id": 4084, "verse_number": "४", "content_sanskrit": "त्वमेवाग्ने हव्यवाहः त्वमेव परमं हविः ।\nयजन्ति सत्रैस्त्वामेव यज्ञैश्च परमाध्वरे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2143084, "chapter_id": 4084, "verse_number": "५", "content_sanskrit": "सृष्ट्वा लोकांस्त्रीनिमान् हव्यवाह\nकाले प्राप्ते पचसि पुनः समिद्धः ।\nत्वं सर्वस्य भुवनस्य प्रसूतिः\nत्वमेवाग्ने भवसि पुनः प्रतिष्ठा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2143085, "chapter_id": 4084, "verse_number": "६", "content_sanskrit": "त्वामग्ने जलदानाहुर्विद्युतश्च मनीषिणः ।\nदहन्ति सर्वभूतानि त्वत्तो निष्क्रम्य रश्मयः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2143086, "chapter_id": 4084, "verse_number": "७", "content_sanskrit": "त्वय्यापो निहिताः सर्वाः त्वयि सर्वमिदं जगत् ।\nन तेऽस्त्यविदितं किञ्चित् त्रिषु लोकेषु पावक\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2143087, "chapter_id": 4084, "verse_number": "८", "content_sanskrit": "स्वां योनिं भजते सर्वो विशस्वापोऽविशङ्कितः ।\nअहं त्वां वर्धयिष्यामि ब्राह्मैर्मन्त्रैः सनातनैः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2143088, "chapter_id": 4084, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2143089, "chapter_id": 4084, "verse_number": "९", "content_sanskrit": "एवं स्तुतो हव्यवाट् स भगवान् कविरुत्तमः ।\nबृहस्पतिमथोवाच प्रीतिमान् वाक्यमुत्तमम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2143090, "chapter_id": 4084, "verse_number": "१०", "content_sanskrit": "दर्शयिष्यामि ते शक्रं सत्यमेतद् ब्रवीमि ते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2143091, "chapter_id": 4084, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2143092, "chapter_id": 4084, "verse_number": "११", "content_sanskrit": "प्रविश्यापस्ततो वह्निः ससमुद्राः सपल्वलाः ।\nआजगाम सरस्तच्च गूढो यत्र शतक्रतुः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2143093, "chapter_id": 4084, "verse_number": "१२", "content_sanskrit": "अथ तत्रापि पद्मानि विचिन्वन् भरतर्षभ ।\nअन्वपश्यत् स देवेन्द्रं बिसमध्यगतं तदा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2143094, "chapter_id": 4084, "verse_number": "१३", "content_sanskrit": "आगत्य च ततस्तूर्णं तमाचष्ट बृहस्पतेः ।\nअणुमात्रेण वपुषा पद्मतन्त्वाश्रितं प्रभुम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2143095, "chapter_id": 4084, "verse_number": "१४", "content_sanskrit": "गत्वा देवर्षिगन्धर्वैः सहितोऽथ बृहस्पतिः ।\nपुराणैः कर्मभिर्देवं तुष्टाव बलसूदनम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2143096, "chapter_id": 4084, "verse_number": "१५", "content_sanskrit": "महासुरो हतः शक्र नमुचिर्दारुणस्त्वया ।\nशम्बरश्च बलश्चैव तथोभौ घोरदर्शनौ\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2143097, "chapter_id": 4084, "verse_number": "१६", "content_sanskrit": "शतक्रतो विवर्धस्व सर्वान् शत्रून् निषूदय ।\nउत्तिष्ठ शक्र सम्पश्य देवर्षींश्च समागतान्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2143098, "chapter_id": 4084, "verse_number": "१७", "content_sanskrit": "महेन्द्र दानवान् हत्वा लोकास्त्रातास्त्वया विभो\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2143099, "chapter_id": 4084, "verse_number": "१८", "content_sanskrit": "अपां फेनं समासाद्य विष्णुतेजोपबृंहितम् ।\nत्वया वृत्रो हतः पूर्वं देवराज जगत्पते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2143100, "chapter_id": 4084, "verse_number": "१९", "content_sanskrit": "त्वं सर्वभूतेषु शरण्य ईड्यः\nत्वया समं विद्यते नेह भूतम् ।\nत्वया धार्यन्ते सर्वभूतानि शक्र\nत्वं देवानां महिमानं चकर्थ\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2143101, "chapter_id": 4084, "verse_number": "२०", "content_sanskrit": "पाहि सर्वानिमाँल्लोकान् महेन्द्र बलमाप्नुहि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2143102, "chapter_id": 4084, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2143103, "chapter_id": 4084, "verse_number": "२१", "content_sanskrit": "एवं संस्तूयमानश्च सोऽवर्धत शनैः शनैः ।\nस्वं चैव वपुरास्थाय बभूव स बलान्वितः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2143104, "chapter_id": 4084, "verse_number": "२२", "content_sanskrit": "अब्रवीच्च गुरुं देवो बृहस्पतिमवस्थितम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2143105, "chapter_id": 4084, "verse_number": "२३", "content_sanskrit": "किं कार्यमवशिष्टं वो हतस्त्वाष्ट्रो महासुरः ।\nवृत्रश्च सुमहाकायो ग्रस्तुं लोकानियेष यः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2143106, "chapter_id": 4084, "verse_number": "", "content_sanskrit": "बृहस्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2143107, "chapter_id": 4084, "verse_number": "२४", "content_sanskrit": "मानुषो नहुषो राजा देवर्षिगणतेजसा ।\nदेवराज्यमनुप्राप्तः सर्वान् नो बाधते भृशम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2143108, "chapter_id": 4084, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2143109, "chapter_id": 4084, "verse_number": "२५", "content_sanskrit": "कथं नु नहुषो राज्यं देवानां प्राप दुर्लभम् ।\nतपसा केन वा युक्तः किंवीर्यो वा बृहस्पते\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2143110, "chapter_id": 4084, "verse_number": "२६", "content_sanskrit": "तत्सर्वं कथयध्वं मे यथेन्द्रत्वमुपेयिवान्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2143111, "chapter_id": 4084, "verse_number": "", "content_sanskrit": "बृहस्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2143112, "chapter_id": 4084, "verse_number": "२७", "content_sanskrit": "त्वयि प्रनष्टे देवेशे विश्वं प्रव्यथितं जगत् ।\nपरस्परभयोद्विग्नं बभूवार्तमराजकम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2143113, "chapter_id": 4084, "verse_number": "२८", "content_sanskrit": "ततो देवैः सगन्धर्वैः सर्षिसङ्घैः सपावकैः ।\nमानुषो नहुषो राजा देवराज्येऽभिषेचितः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2143114, "chapter_id": 4084, "verse_number": "२९", "content_sanskrit": "ततो भीताः शक्रमकामयन्त\nत्वया त्यक्तं महदैन्द्रं पदं तत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2143115, "chapter_id": 4084, "verse_number": "३०", "content_sanskrit": "तदा देवाः पितरोऽथर्षयश्च\nगन्धर्वमुख्याश्च समेत्य सर्वे ।\nगत्वाऽब्रुवन् नहुषं शक्र तत्र\nत्वं नो राजा भुवनस्य गोप्ता\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2143116, "chapter_id": 4084, "verse_number": "३१", "content_sanskrit": "तानब्रवीन्नहुषो नास्मि शक्त\nआप्यायध्वं तपसा तेजसा माम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2143117, "chapter_id": 4084, "verse_number": "३२", "content_sanskrit": "एवञ्चोक्तैर्वर्धितश्चापि देवै\nराजाऽभवन्नहुषो घोरवीर्यः ।\nत्रैलोक्ये च प्राप्य राज्यं महर्षीन्\nकृत्वा वाहान् याति लोकान् दुरात्मा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2143118, "chapter_id": 4084, "verse_number": "३३", "content_sanskrit": "तेजोहरं दृष्टिविषं सुघोरं\nमा त्वं पश्येर्नहुषं वै कदाचित् ।\nदेवाश्च सर्वे नहुषं भृशार्ता\nन पश्यन्ते गूढरूपाश्चरन्तः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2143119, "chapter_id": 4084, "verse_number": "३४", "content_sanskrit": "एवं वदत्यङ्गिरसां वरिष्ठे\nबृहस्पतौ लोकपालः कुबेरः ।\nवैवस्वतश्चैव यमः पुराणो\nदेवश्च सोमो वरुणश्चाजगाम\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2143120, "chapter_id": 4084, "verse_number": "३५", "content_sanskrit": "ते वै समागम्य महेन्द्रमूचुः\nदिष्ट्या त्वाष्ट्रो निहतश्चैव वृत्रः ।\nदिष्ट्या त्वां कुशलिनमक्षतं च\nपश्यामो वै निहतारिं च शक्र\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2143121, "chapter_id": 4084, "verse_number": "३६", "content_sanskrit": "स तान् यथावच्च हि लोकपालान्\nसमेत्य वै प्रीतमना महेन्द्रः ।\nउवाच चैतान् प्रतिभाष्य शक्रः\nसञ्चोदयिष्यन् नहुषस्यान्तरेण\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2143122, "chapter_id": 4084, "verse_number": "३७", "content_sanskrit": "राजा देवानां नहुषो घोररूपः\nतत्र साह्यं दीयतां मे भवद्भिः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2143123, "chapter_id": 4084, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2143124, "chapter_id": 4084, "verse_number": "३८", "content_sanskrit": "ते चाब्रुवन् नहुषो घोररूपो\nदृष्टीविषस्तस्य बिभीम शक्र ।\nत्वं चेद् राजा नहुषं पराजयेः\nततो वयं भागमर्हाम शक्र\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2143125, "chapter_id": 4084, "verse_number": "३९", "content_sanskrit": "इन्द्रोऽब्रवीद् भवतु भवानपांपतिः\nयमः कुबेरश्च मयाऽभिषेकम् ।\nसम्प्राप्नुवन्त्वद्य सहैव ते रिपुं\nजयाम तं नहुषं घोरदृष्टिम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2143126, "chapter_id": 4084, "verse_number": "४०", "content_sanskrit": "ततः शक्रं ज्वलनोऽप्याह भागं\nप्रयच्छ मह्यं तव साह्यं करिष्ये\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2143127, "chapter_id": 4084, "verse_number": "४१", "content_sanskrit": "तमाह शक्रो भविताऽग्ने तवापि\nचेन्द्राग्न्योर्वै भाग एको महाक्रतौ\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2143128, "chapter_id": 4084, "verse_number": "४२", "content_sanskrit": "एवं सञ्चिन्त्य भगवान् महेन्द्रः पाकशासनः ।\nकुबेरं सर्वयक्षाणां धनानां च प्रभुं तथा\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2143129, "chapter_id": 4084, "verse_number": "४३", "content_sanskrit": "वैवस्वतं पितॄणां च वरुणं चाप्यपां तथा ।\nअधिपत्यं ददौ शक्रः सत्कृत्य वरदस्तथा\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2143130, "chapter_id": 4084, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि षोडशोऽध्यायः ॥१६॥ सेनोद्योगपर्वणि षोडशोऽध्यायः ॥१६॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]