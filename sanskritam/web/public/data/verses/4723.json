[{"id": 2175798, "chapter_id": 4723, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2175799, "chapter_id": 4723, "verse_number": "१", "content_sanskrit": "तस्मिन्नेव तु धर्मात्मा वसति स्म तपोधनः ।\nगार्हस्थ्यं धर्ममास्थाय ह्यसितो देवलः पुरा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2175800, "chapter_id": 4723, "verse_number": "२", "content_sanskrit": "धर्मनित्यः शुचिर्दान्तो यज्ञशीलो महातपाः ।\nकर्मणा मनसा वाचा समः सर्वेषु साधुषु\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2175801, "chapter_id": 4723, "verse_number": "३", "content_sanskrit": "अक्रोधनो महाराज तुल्यनिन्दाप्रियाप्रियः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2175802, "chapter_id": 4723, "verse_number": "४", "content_sanskrit": "काञ्चने लोष्टके चैव समदर्शी महातपाः ।\nदेवान् वै पूजयन्नित्यमतिथींश्च द्विजैः सह\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2175803, "chapter_id": 4723, "verse_number": "५", "content_sanskrit": "ब्रह्मचर्यरतो नित्यं सदा धर्मपरायणः ।\nतत्राभ्येत्य महाराज योगमास्थाय भिक्षुकः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2175804, "chapter_id": 4723, "verse_number": "६", "content_sanskrit": "जैगीषव्यो मुनिर्धीमान् तस्मिंस्तीर्थे समाहितः ।\nदेवलस्याश्रमे राजन् न्यवसत् स महाद्युतिः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2175805, "chapter_id": 4723, "verse_number": "७", "content_sanskrit": "योगनित्यो महाराज सिद्धिं प्राप्तो महातपाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2175806, "chapter_id": 4723, "verse_number": "८", "content_sanskrit": "तं तत्र वसमानं तु जैगीषव्यं महामुनिम् ।\nन ज्ञातस्तेन मुनिना देवलेन महात्मना\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2175807, "chapter_id": 4723, "verse_number": "९", "content_sanskrit": "एवं तयोर्महाराज दीर्घकालो व्यतिक्रमत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2175808, "chapter_id": 4723, "verse_number": "१०", "content_sanskrit": "जैगीषव्यो मुनिस्तं तु ददर्शाथ स देवलम् ।\nआहारकाले मतिमान् परिव्राड् जनमेजय\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2175809, "chapter_id": 4723, "verse_number": "११", "content_sanskrit": "उपातिष्ठत धर्मात्मा भैक्षकाले स्म देवलम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2175810, "chapter_id": 4723, "verse_number": "१२", "content_sanskrit": "स दृष्ट्वा भिक्षुरूपेण प्राप्तं तं तु महामुनिम् ।\nगौरवं परमं चक्रे प्रीतिं च परमां तदा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2175811, "chapter_id": 4723, "verse_number": "१३", "content_sanskrit": "देवलस्तु यथाशक्ति पूजयामास भारत ।\nऋषिदृष्टेन विधिना समाहूय समाहितः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2175812, "chapter_id": 4723, "verse_number": "१४", "content_sanskrit": "कदाचित् तस्य नृपते देवलस्य महात्मनः ।\nचिन्ता सुमहती जाता मुनिं दृष्ट्वा महाद्युतिम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2175813, "chapter_id": 4723, "verse_number": "१५", "content_sanskrit": "समास्तु समतिक्रान्ता बह्व्यः पूजयतो मम ।\nन चायमलसो भिक्षुरभ्यभाषत किञ्चन\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2175814, "chapter_id": 4723, "verse_number": "१६", "content_sanskrit": "एवं विगणयन्नेव स जगाम महोदधिम् ।\nअन्तरिक्षगतः श्रीमान् कलशं गृह्य देवलः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2175815, "chapter_id": 4723, "verse_number": "१७", "content_sanskrit": "गच्छन्नेव च धर्मात्मा समुद्रं सरितां पतिम् ।\nजैगीषव्यं ततोऽपश्यद् गतं प्रागेव भारत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2175816, "chapter_id": 4723, "verse_number": "१८", "content_sanskrit": "ततः सविस्मितश्चिन्तां जगामाथासितः प्रभुः ।\nकथं भिक्षुरयं प्राप्तः समुद्रं सुमहातपाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2175817, "chapter_id": 4723, "verse_number": "१९", "content_sanskrit": "इत्येवं चिन्तयामास महर्षिरसितस्तदा ।\nस्नात्वा समुद्रे वै तिष्ठन् अथ जप्यं जजाप ह\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2175818, "chapter_id": 4723, "verse_number": "२०", "content_sanskrit": "कृतजप्याह्निकः श्रीमानाश्रमं च जगाम ह ।\nकलशं जलपूर्णं वै गृहीत्वा जनमेजय\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2175819, "chapter_id": 4723, "verse_number": "२१", "content_sanskrit": "ततः स प्रविशन्नेव स्वमाश्रमपदं मुनिः ।\nआसीनमाश्रमे पुण्ये जैगीषव्यमपश्यत\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2175820, "chapter_id": 4723, "verse_number": "२२", "content_sanskrit": "न व्याहरति चैवैनं जैगीषव्यः कथञ्चन ।\nकाष्ठभूतो श्रमपदे वसति स्म महातपाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2175821, "chapter_id": 4723, "verse_number": "२३", "content_sanskrit": "तं दृष्ट्वा चाप्लुतं तोये सागरे सागरोपमम् ।\nप्रविष्टमाश्रमपदं पूर्वमेव ददर्श सः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2175822, "chapter_id": 4723, "verse_number": "२४", "content_sanskrit": "असितो देवलः श्रीमान् चिन्तयामास बुद्धिमान् ।\nदृष्ट्वा प्रभावं तपसो जैगीषव्यस्य योगजम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2175823, "chapter_id": 4723, "verse_number": "२५", "content_sanskrit": "चिन्तयामास राजेन्द्र तं तदा मुनिसत्तमः ।\nमया दृष्टः समुद्रे च आश्रमे च कथं न्वयम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2175824, "chapter_id": 4723, "verse_number": "२६", "content_sanskrit": "एवं विगणयन्नेव स मुनिर्मन्त्रपारगः ।\nउत्पपाताश्रमात् तस्मादन्तरिक्षं विशाम्पते\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2175825, "chapter_id": 4723, "verse_number": "२७", "content_sanskrit": "जिज्ञासार्थं तदा भिक्षोर्जैगीषव्यस्य देवलः ।\nसोऽन्तरिक्षेण तान् सिद्धान् समपश्यत् समागतान्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2175826, "chapter_id": 4723, "verse_number": "२८", "content_sanskrit": "जैगीषव्यं च तैः सिद्धैः पूज्यमानमपश्यत ।\nन व्याहरत चैवैनं जैगीषव्यः कथञ्चन\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2175827, "chapter_id": 4723, "verse_number": "२९", "content_sanskrit": "ततोऽसितः सुसंरब्धो व्यवसायी दृढव्रतः ।\nअपश्यद् वै दिवं यातं जैगीषव्यं स देवलः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2175828, "chapter_id": 4723, "verse_number": "३०", "content_sanskrit": "तस्माच्च पितृलोकं तं व्रजन्तं सोऽन्वपश्यत\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2175829, "chapter_id": 4723, "verse_number": "३१", "content_sanskrit": "तस्मादादित्यलोकं च व्रजन्तं सोऽन्वपश्यत\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2175830, "chapter_id": 4723, "verse_number": "३२", "content_sanskrit": "तस्मादभिसमुत्प्लुत्य सोमलोकमभिष्टुतम् ।\nव्रजन्तमन्वपश्यत् तं जैगीषव्यं स देवलः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2175831, "chapter_id": 4723, "verse_number": "३३", "content_sanskrit": "लोकान् समुत्पतन्तं च शुभानेकाग्नियाजिनाम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2175832, "chapter_id": 4723, "verse_number": "३४", "content_sanskrit": "अग्निष्टोमेन च तथा ये यजन्ति तपोधनाः ।\nतत्स्थानमनुसम्प्राप्तमन्वपश्यत देवलः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2175833, "chapter_id": 4723, "verse_number": "३५", "content_sanskrit": "वाजपेयं क्रतुवरं तथा बहुसुवर्णकम् ।\nआहरन् ये महाप्राज्ञास्तेषां लोकेष्वपश्यत\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2175834, "chapter_id": 4723, "verse_number": "३६", "content_sanskrit": "यजन्ते पौण्डरीकेण राजसूयेन चैव ये ।\nतेषां लोकेष्वपश्यच्च जैगीषव्यं स देवलः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2175835, "chapter_id": 4723, "verse_number": "३७", "content_sanskrit": "द्वादशाहैश्च सत्रैश्च यजन्ते विविधैर्नृप ।\nतेषां लोकेष्वपश्यच्च जैगीषव्यं स देवलः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2175836, "chapter_id": 4723, "verse_number": "३८", "content_sanskrit": "मैत्रावरुणयोर्लोकान् आदित्यानां तथैव च ।\nसलोकतामनुप्राप्तमपश्यत ततोऽसितः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2175837, "chapter_id": 4723, "verse_number": "३९", "content_sanskrit": "रुद्राणां च वसूनां च स्थानं यच्च बृहस्पतेः ।\nतानि सर्वाण्यतीतं च तमपश्यत् ततोऽसितः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2175838, "chapter_id": 4723, "verse_number": "४०", "content_sanskrit": "आरुह्य च गवां लोकं प्रशान्तं ब्रह्मसत्रिणाम् ।\nलोकानपश्यद् गच्छन्तं जैगीषव्यं ततोऽसितः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2175839, "chapter_id": 4723, "verse_number": "४१", "content_sanskrit": "त्रीँल्लोकान् प्रवरान् विप्रमुत्पतन्तं स्वतेजसा ।\nपतिव्रतानां लोकांश्च व्रजन्तं सोऽन्वपश्यत\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2175840, "chapter_id": 4723, "verse_number": "४२", "content_sanskrit": "तदा मुनिवरं भूयो जैगीषव्यं तथाऽसितः ।\nनान्वपश्यत योगस्थं जैगीषव्यमरिन्दम\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2175841, "chapter_id": 4723, "verse_number": "४३", "content_sanskrit": "सोऽचिन्तयन्महाभागो जैगीषव्यस्य देवलः ।\nप्रभावं सुव्रतत्वं च सिद्धिं योगस्य चातुलाम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2175842, "chapter_id": 4723, "verse_number": "४४", "content_sanskrit": "असितोऽपृच्छत तदा सिद्धाँल्लोकेषु सत्तमान् ।\nप्रयतः प्राञ्चलिर्भूत्वा धीरस्तान् ब्रह्मचारिणः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2175843, "chapter_id": 4723, "verse_number": "४५", "content_sanskrit": "जैगीषव्यं न पश्यामि तं शंसन्तु तपोधनाः ।\nएतदिच्छाम्यहं श्रोतुं परं कौतूहलं हि मे\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2175844, "chapter_id": 4723, "verse_number": "", "content_sanskrit": "सिद्धाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2175845, "chapter_id": 4723, "verse_number": "४६", "content_sanskrit": "शृणु देवल भूतार्थं शंसतां नो दृढव्रत ।\nजैगीषव्यो गतो लोकं शाश्वतं ब्रह्मणोऽक्षयम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2175846, "chapter_id": 4723, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2175847, "chapter_id": 4723, "verse_number": "४७", "content_sanskrit": "श्रुत्वा तु वचनं तेषां सिद्धानां ब्रह्मचारिणाम् ।\nअसितो देवलस्तूर्णमुत्पपात द्रुतं तदा\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2175848, "chapter_id": 4723, "verse_number": "४८", "content_sanskrit": "ततः सिद्धास्त ऊचुस्तं देवलं पुनरेव ह\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2175849, "chapter_id": 4723, "verse_number": "", "content_sanskrit": "सिद्धाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2175850, "chapter_id": 4723, "verse_number": "४९", "content_sanskrit": "न देवलगतिस्तत्र तव गन्तुं तपोधन ।\nब्रह्मणः सदनं विप्र जैगीषव्यो यदाप्तवान्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2175851, "chapter_id": 4723, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2175852, "chapter_id": 4723, "verse_number": "५०", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा सिद्धानां देवलस्तदा ।\nआनुपूर्व्येण लोकांस्तान् सर्वानवततार च\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2175853, "chapter_id": 4723, "verse_number": "५१", "content_sanskrit": "स्वं चाश्रमपदं पुण्यमाजगाम पतङ्गवत् ।\nप्रविशन्नेव चापश्यत् जैगीषव्यं स देवलः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2175854, "chapter_id": 4723, "verse_number": "५२", "content_sanskrit": "ततो बुद्ध्या व्यगणयद् देवलो धर्मयुक्तया ।\nदृष्ट्वा प्रभावं तपसो जैगीषव्यस्य योगजम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2175855, "chapter_id": 4723, "verse_number": "५३", "content_sanskrit": "ततोऽब्रवीन्महात्मानं जैगीषव्यं स देवलः ।\nविनयावनतो राजन्नुवाच सुमहातपाः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2175856, "chapter_id": 4723, "verse_number": "", "content_sanskrit": "देवलः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2175857, "chapter_id": 4723, "verse_number": "५४", "content_sanskrit": "मोक्षधर्मं समास्थातुमिच्छेयं भगवन्नहम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2175858, "chapter_id": 4723, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2175859, "chapter_id": 4723, "verse_number": "५५", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा उपदेशं चकार सः ।\nविधिं योगस्य परमं कार्याकार्यं च सर्वशः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2175860, "chapter_id": 4723, "verse_number": "५६", "content_sanskrit": "सन्न्यासे कृतबुद्धिं तं ततो दृष्ट्वा महातपाः ।\nसर्वाश्चास्य क्रियाश्चक्रे विधिदृष्टेन कर्मणा\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2175861, "chapter_id": 4723, "verse_number": "५७", "content_sanskrit": "सन्न्यासे कृतबुद्धिं तं भूतानि पितृभिः सह ।\nततो दृष्ट्वा प्ररुरुदुः कोऽस्मान् संविभजिष्यति\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2175862, "chapter_id": 4723, "verse_number": "५८", "content_sanskrit": "तेषामेव तदा श्रुत्वा दुःखार्तानां स देवलः ।\nदिशो दश व्याहरतां मोक्षं त्यक्तुं मनो दधे\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2175863, "chapter_id": 4723, "verse_number": "५९", "content_sanskrit": "ततस्तु फलमूलानि पतितानि च भारत ।\nपुष्पाण्योषधयश्चैव रोरूयन्ते सहस्रशः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2175864, "chapter_id": 4723, "verse_number": "६०", "content_sanskrit": "पुनर्नो देवलः क्षुद्रो नूनं छेत्स्यति दुर्मतिः ।\nअभयं सर्वभूतेभ्यो यो दत्त्वा नावबुध्यते\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2175865, "chapter_id": 4723, "verse_number": "६१", "content_sanskrit": "ततो भूयो व्यगणयत् स्वबुद्ध्या मुनिसत्तमः ।\nमोक्षे गार्हस्थ्यधर्मे वा किं नु श्रेयस्करं भवेत्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2175866, "chapter_id": 4723, "verse_number": "समाप्तिः", "content_sanskrit": "इति सञ्चिन्त्य बहुधा देवलो राजसत्तम ।\nत्यक्त्वा गार्हस्थ्यधर्मं तु मोक्षधर्ममरोचयत्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2175867, "chapter_id": 4723, "verse_number": "६३", "content_sanskrit": "एवमादीनि सञ्चिन्त्य देवलो निश्चयान्वितः ।\nप्राप्तवान् परमां सिद्धिं परं योगं च भारत\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2175868, "chapter_id": 4723, "verse_number": "६४", "content_sanskrit": "ततो देवाः समागत्य बृहस्पतिपुरोगमाः ।\nजैगीषव्यं तपस्यन्तं प्रशशंसुर्मनीषिणः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2175869, "chapter_id": 4723, "verse_number": "६५", "content_sanskrit": "अथाब्रवीद् ऋषिवरो देवान् वै नारदस्तथा ।\nजैगीषव्ये तपो नास्ति विस्मापयति सोऽसितम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2175870, "chapter_id": 4723, "verse_number": "६६", "content_sanskrit": "तमेवंवादिनं वीरं प्रत्यूचुस्त्रिदिवौकसः ।\nमैवमित्येव शंसन्तो जैगीषव्यं महामुनिम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2175871, "chapter_id": 4723, "verse_number": "६७", "content_sanskrit": "एवम्प्रभावो धर्मात्मा जैगीषव्यस्तथाऽसितः ।\nतयोरिदं स्थानवरं तीर्थं चैव महात्मनोः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2175872, "chapter_id": 4723, "verse_number": "६८", "content_sanskrit": "तत्राप्युपस्पृश्य ततो महात्मा\nदत्त्वा च वित्तं हलभृत् द्विजेभ्यः ।\nअवाप्य धर्मं परमार्यकर्मा\nजगाम सोमस्य महत् स तीर्थम्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2175873, "chapter_id": 4723, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि जैगीषव्यासितचरितं नाम एकविंशोऽध्यायः ॥२१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]