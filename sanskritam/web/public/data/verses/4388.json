[{"id": 2156078, "chapter_id": 4388, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2156079, "chapter_id": 4388, "verse_number": "१", "content_sanskrit": "कथं शान्तनवो भीष्मो दशमेऽहनि सञ्जय ।\nअयुध्यत महावीर्यैः पाण्डवैः सहसृञ्जयैः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2156080, "chapter_id": 4388, "verse_number": "२", "content_sanskrit": "कुरवश्च कथं युद्धे पाण्डवान् प्रत्यवारयन् ।\nआचक्ष्व मे महायुद्धं भीष्मस्याहवशोभिनः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2156081, "chapter_id": 4388, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2156082, "chapter_id": 4388, "verse_number": "३", "content_sanskrit": "कुरवः पाण्डवैः सार्धं यथायुध्यन्त भारत ।\nयथा च तदभूद् युद्धं तत्ते वक्ष्यामि शृण्वतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2156083, "chapter_id": 4388, "verse_number": "४", "content_sanskrit": "प्रेषिताः परलोकाय परमास्त्रैः किरीटिना ।\nअहन्यहनि सम्प्राप्तास्तावकानां रथव्रजाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2156084, "chapter_id": 4388, "verse_number": "५", "content_sanskrit": "यथाप्रतिज्ञं कौरव्यः स चापि समितिञ्जयः ।\nपार्थानामकरोद् भीष्मः सततं समितिक्षयम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2156085, "chapter_id": 4388, "verse_number": "६", "content_sanskrit": "कुरुभिः सहितं भीष्मं युध्यमानं महारथम् ।\nअर्जुनं च सपाञ्चाल्यं दृष्ट्वा संशयिता जनाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2156086, "chapter_id": 4388, "verse_number": "७", "content_sanskrit": "दशमेऽहनि तस्मिंस्तु भीष्मार्जुनसमागमे ।\nअवर्तत महारौद्रः सततं समितिक्षयः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2156087, "chapter_id": 4388, "verse_number": "८", "content_sanskrit": "तस्मिन्नयुतशो राजन् भूयश्च स परन्तपः ।\nभीष्मः शान्तनवो योधान् जघान परमास्त्रवित्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2156088, "chapter_id": 4388, "verse_number": "९", "content_sanskrit": "येषामज्ञातकल्पानि नामगोत्राणि पार्थिव ।\nते हतास्तत्र भीष्मेण शूराः सर्वेऽनिवर्तिनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2156089, "chapter_id": 4388, "verse_number": "१०", "content_sanskrit": "दशाहानि ततस्तप्त्वा भीष्मः पाण्डववाहिनीम् ।\nनिरविद्यत धर्मात्मा जीवितेन परन्तपः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2156090, "chapter_id": 4388, "verse_number": "११", "content_sanskrit": "स क्षिप्रं वधमन्विच्छन्नात्मनोऽभिमुखं रणे ।\nन हन्यां मानवश्रेष्ठान् सङ्ग्रामेऽभिमुखानिति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2156091, "chapter_id": 4388, "verse_number": "१२", "content_sanskrit": "चिन्तयित्वा महाबाहुः पिता देवव्रतस्तव ।\nअभ्याशस्थं महाराज पाण्डवं वाक्यमब्रवीत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2156092, "chapter_id": 4388, "verse_number": "१३", "content_sanskrit": "युधिष्ठिर महाप्राज्ञ सर्वशास्त्रविशारद ।\nशृणु मे वचनं तात धर्म्यं स्वर्ग्यं च जल्पतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2156093, "chapter_id": 4388, "verse_number": "१४", "content_sanskrit": "निर्विण्णोऽस्मि भृशं तात देहेनानेन भारत ।\nघ्नतश्च मे गतः कालः सुबहून् प्राणिनो रणे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2156094, "chapter_id": 4388, "verse_number": "१५", "content_sanskrit": "तस्मात् पार्थं पुरोधाय पाञ्चालान् सृञ्जयांस्तथा ।\nमद्वधे क्रियतां यत्नो मम चेदिच्छसि प्रियम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2156095, "chapter_id": 4388, "verse_number": "१६", "content_sanskrit": "तस्य तन्मतमाज्ञाय पाण्डवः सत्यदर्शनः ।\nभीष्मं प्रतिययौ यत्तः सङ्ग्रामे सह सृञ्जयैः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2156096, "chapter_id": 4388, "verse_number": "१७", "content_sanskrit": "धृष्टद्युम्नस्ततो राजन् पाण्डवश्च युधिष्ठिरः ।\nश्रुत्वा भीष्मस्य तां वाचं चोदयामासतुर्बलम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2156097, "chapter_id": 4388, "verse_number": "१८", "content_sanskrit": "अभिद्रवत युध्यध्वं भीष्मं जयत संयुगे ।\nरक्षिताः सत्यसन्धेन जिष्णुना रिपुजिष्णुना\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2156098, "chapter_id": 4388, "verse_number": "१९", "content_sanskrit": "अयं चापि महेष्वासः पार्षतो वाहिनीपतिः ।\nभीमसेनश्च समरे पालयिष्यति वो ध्रुवम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2156099, "chapter_id": 4388, "verse_number": "२०", "content_sanskrit": "न वै भीष्माद् भयं किञ्चित् कर्तव्यं युधि सृञ्जयाः ।\nध्रुवं भीष्मं विजेष्यामः पुरस्कृत्य शिखण्डिनम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2156100, "chapter_id": 4388, "verse_number": "२१", "content_sanskrit": "तथा तु समयं कृत्वा दशमेऽहनि पाण्डवाः ।\nब्रह्मलोकपरा भूत्वा सञ्जग्मुः क्रोधमूर्च्छिताः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2156101, "chapter_id": 4388, "verse_number": "२२", "content_sanskrit": "शिखण्डिनं पुरस्कृत्य पाण्डवं च धनञ्जयम् ।\nभीष्मस्य पातने यत्नं परमं ते समास्थिताः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2156102, "chapter_id": 4388, "verse_number": "२३", "content_sanskrit": "ततस्तव सुतादिष्टा नानाजनपदेश्वराः ।\nद्रोणेन सहपुत्रेण सहसेना महाबलाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2156103, "chapter_id": 4388, "verse_number": "२४", "content_sanskrit": "दुःशासनश्च बलवान् सह सर्वैः सहोदरैः ।\nभीष्मं समरमध्यस्थं पालयाञ्चक्रिरे तदा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2156104, "chapter_id": 4388, "verse_number": "२५", "content_sanskrit": "ततस्तु तावकाः शूराः पुरस्कृत्य यतव्रतम् ।\nशिखण्डिप्रमुखान् पार्थान् योधयन्ति स्म संयुगे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2156105, "chapter_id": 4388, "verse_number": "२६", "content_sanskrit": "चेदिभिश्च सपाञ्चालैः सहितो वानरध्वजः ।\nययौ शान्तनवं भीष्मं पुरस्कृत्य शिखण्डिनम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2156106, "chapter_id": 4388, "verse_number": "२७", "content_sanskrit": "द्रोणपुत्रं शिनेर्नप्ता धृष्टकेतुस्तु पौरवम् ।\nयुधामन्युः सहामात्यं दुर्योधनमयोधयत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2156107, "chapter_id": 4388, "verse_number": "२८", "content_sanskrit": "विराटस्तु सहानीकः सहसेनं जयद्रथम् ।\nवृद्धक्षत्रस्य दायादमाससाद परन्तपः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2156108, "chapter_id": 4388, "verse_number": "२९", "content_sanskrit": "मद्रराजं महेष्वासं सहसैन्यं युधिष्ठिरः ।\nभीमसेनाभिगुप्तश्च नागानीकमुपाद्रवत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2156109, "chapter_id": 4388, "verse_number": "३०", "content_sanskrit": "अप्रधृष्यमनावार्यं सर्वशस्त्रभृतां वरम् ।\nद्रोणं प्रति ययौ यत्तः पाञ्चाल्यः सह सोमकैः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2156110, "chapter_id": 4388, "verse_number": "३१", "content_sanskrit": "कर्णिकारध्वजं चापि सिंहकेतुररिन्दमः ।\nप्रत्युज्जगाम सौभद्रं राजपुत्रो बृहद्बलः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2156111, "chapter_id": 4388, "verse_number": "३२", "content_sanskrit": "शिखण्डिनं च पुत्रास्ते पाण्डवं च धनञ्जयम् ।\nराजभिः समरे सार्धमभिपेतुर्जिघांसवः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2156112, "chapter_id": 4388, "verse_number": "३३", "content_sanskrit": "तस्मिन्नतिमहाभीमे सेनयोर्वै पराक्रमे ।\nसम्प्रधावत्स्वनीकेषु मेदिनी समकम्पत\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2156113, "chapter_id": 4388, "verse_number": "३४", "content_sanskrit": "तान्यनीकान्यनीकेषु समसज्जन्त भारत ।\nतावकानां परेषां च दृष्ट्वा शान्तनवं रणे\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2156114, "chapter_id": 4388, "verse_number": "३५", "content_sanskrit": "ततस्तेषां प्रयततामन्योन्यमभिधावताम् ।\nप्रादुरासीन्महान् शब्दो दिक्षु सर्वासु भारत\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2156115, "chapter_id": 4388, "verse_number": "३६", "content_sanskrit": "शङ्खदुन्दुभिघोषैश्च वारणानां च बृंहितैः ।\nसिंहनादैश्च सैन्यानां दारुणः समपद्यत\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2156116, "chapter_id": 4388, "verse_number": "३७", "content_sanskrit": "सा च सर्वनरेन्द्राणां चन्द्रार्कसदृशी प्रभा ।\nवीराङ्गदकिरीटेषु निष्प्रभा समपद्यत\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2156117, "chapter_id": 4388, "verse_number": "३८", "content_sanskrit": "रजोमेघाश्च सञ्जज्ञुः शस्त्रविद्युद्भिरावृताः ।\nधनुषां चैव निर्घोषो दारुणः समपद्यत\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2156118, "chapter_id": 4388, "verse_number": "३९", "content_sanskrit": "बाणशङ्खप्रणादाश्च भेरीणां च महास्वनाः ।\nरथघोषाश्च सञ्जग्मुः सेनयोरुभयोरपि\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2156119, "chapter_id": 4388, "verse_number": "४०", "content_sanskrit": "प्रासशक्त्यृष्टिसङ्घैश्च बाणौघैश्च समाकुलम् ।\nनिष्प्रकाशमिवाकाशं सेनयोः समपद्यत\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2156120, "chapter_id": 4388, "verse_number": "४१", "content_sanskrit": "अन्योन्यं रथिनः पेतुर्वाजिनश्च महाहवे ।\nकुञ्जराः कुञ्जरान् जघ्नुः पदातींश्च पदातयः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2156121, "chapter_id": 4388, "verse_number": "४२", "content_sanskrit": "तदासीत्सुमहद् युद्धं कुरूणां पाण्डवैः सह ।\nभीष्महेतोर्नरव्याघ्र श्येनयोरामिषे यथा\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2156122, "chapter_id": 4388, "verse_number": "४३", "content_sanskrit": "तयोः समागमो घोरो बभूव युधि भारत ।\nअन्योन्यस्य वधार्थाय जिगीषूणां रणाजिरे\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2156123, "chapter_id": 4388, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nभीष्मपर्वणि द्वादशाधिकशततमोऽध्यायः ॥११२॥\nभीष्मवधपर्वणि द्वासप्ततितमोऽध्यायः ॥७२॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]