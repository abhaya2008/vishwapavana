[{"id": 2167931, "chapter_id": 4604, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2167932, "chapter_id": 4604, "verse_number": "१", "content_sanskrit": "नकुलं रभसं युद्धे तपन्तं तव वाहिनीम् ।\nकर्णो वैकर्तनो राजन् वारयामास वै रुषा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2167933, "chapter_id": 4604, "verse_number": "२", "content_sanskrit": "नकुलस्तु ततः कर्णं प्रहसन्निदमब्रवीत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2167934, "chapter_id": 4604, "verse_number": "", "content_sanskrit": "नकुलः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2167935, "chapter_id": 4604, "verse_number": "३", "content_sanskrit": "चिरस्य बत दृष्टोऽहं दैवतैः सौम्यचक्षुषा ।\nयस्य मे त्वं रणे पाप चक्षुर्विषयमागतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2167936, "chapter_id": 4604, "verse_number": "४", "content_sanskrit": "त्वं हि मूलमनर्थानां वैरस्य कलहस्य च ।\nत्वद्दोषात् कौरवाः क्षीणाः समासाद्य परस्परम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2167937, "chapter_id": 4604, "verse_number": "५", "content_sanskrit": "त्वामद्य समरे हत्वा कृतकृत्योऽस्मि सत्वरः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2167938, "chapter_id": 4604, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2167939, "chapter_id": 4604, "verse_number": "६", "content_sanskrit": "एवमुक्तः प्रत्युवाच नकुलं सूतनन्दनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2167940, "chapter_id": 4604, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2167941, "chapter_id": 4604, "verse_number": "७", "content_sanskrit": "सदृशं राजपुत्रस्य विशेषेण धनुष्मतः ।\nप्रहरस्व रणे वीर पश्यामः पुरुषो भव\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2167942, "chapter_id": 4604, "verse_number": "८", "content_sanskrit": "कर्म कृत्वा रणे शूर ततः कत्थितुमर्हसि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2167943, "chapter_id": 4604, "verse_number": "९", "content_sanskrit": "अनुक्त्वा समरे तात शूरा युध्यन्ति शक्तितः ।\nयुध्यस्व समरे शक्त्या प्रतियोत्स्यामि ते रणे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2167944, "chapter_id": 4604, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2167945, "chapter_id": 4604, "verse_number": "१०", "content_sanskrit": "इत्युक्त्वा प्राहरत् तूर्णं पाण्डुपुत्राय सूतजः ।\nविव्याध चैनं समरे त्रिसप्तत्या शिलीमुखैः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2167946, "chapter_id": 4604, "verse_number": "११", "content_sanskrit": "नकुलस्तु ततो विद्धः सूतपुत्रेण भारत ।\nअशीत्याऽऽशीविषप्रख्यैः सूतपुत्रमविध्यत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2167947, "chapter_id": 4604, "verse_number": "१२", "content_sanskrit": "तस्य कर्णो धनुश्छित्त्वा स्वर्णपुङ्खैः शिलाशितैः ।\nत्रिंशतं प्रेषयामास शरानाशीविषोपमान्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2167948, "chapter_id": 4604, "verse_number": "१३", "content_sanskrit": "ते तस्य कवचं भित्त्वा पपुः शोणितमाहवे ।\nआशीविषा यथा राजन् भित्त्वा गां सलिलं भृशम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2167949, "chapter_id": 4604, "verse_number": "१४", "content_sanskrit": "अथान्यद्धनुरादाय हेमपृष्ठं दुरानमम् ।\nकर्णं विव्याध सप्तत्या सारथिं च त्रिभिःशरैः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2167950, "chapter_id": 4604, "verse_number": "१५", "content_sanskrit": "ततः क्रुद्धो महाराज नकुलः परवीरहा ।\nक्षुरप्रेण सुतीक्ष्णेन कर्णस्य धनुराच्छिनत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2167951, "chapter_id": 4604, "verse_number": "१६", "content_sanskrit": "अथैनं छिन्नधन्वानं सायकानां त्रिभिः शतैः ।\nआजघ्ने प्रहसन् वीरः सर्वलोकमहारथम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2167952, "chapter_id": 4604, "verse_number": "१७", "content_sanskrit": "कर्णमभ्यर्दितं दृष्ट्वा पाण्डुपुत्रेण मारिष ।\nविस्मयं परमं जग्मुः ऋषयः सह दैवतैः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2167953, "chapter_id": 4604, "verse_number": "१८", "content_sanskrit": "अथान्यद्धनुरादाय कर्णो वैकर्तनस्तदा ।\nनकुलं पञ्चभिर्बाणैर्जत्रुदेशे समार्पयत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2167954, "chapter_id": 4604, "verse_number": "१९", "content_sanskrit": "तत्रस्थैरथ तैर्बाणैर्माद्रीपुत्रो व्यरोचत ।\nस्वरश्मिभिरिवादित्यो भुवने विसृजन् प्रभाम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2167955, "chapter_id": 4604, "verse_number": "२०", "content_sanskrit": "नकुलस्तु ततः कर्णं विद्ध्वा सप्तभिराशुगैः ।\nअथास्य धनुषः कोटिं पुनश्चिच्छेद मारिष\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2167956, "chapter_id": 4604, "verse_number": "२१", "content_sanskrit": "सोऽन्यत् कार्मुकमादाय समरे वेगवत्तरम् ।\nनकुलस्य ततो बाणैः समन्ताद् वारयन् दिशः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2167957, "chapter_id": 4604, "verse_number": "२२", "content_sanskrit": "सञ्छाद्यमानः समरे कर्णचापच्युतैः शरैः ।\nचिच्छेद स शरांस्तूर्णं शरैरेव महायशाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2167958, "chapter_id": 4604, "verse_number": "२३", "content_sanskrit": "ततो बाणमयं जालं विततं व्योम्न्यदृश्यत ।\nखद्योतानामिव व्रातैः सम्पतद्भिर्यथा नभः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2167959, "chapter_id": 4604, "verse_number": "२४", "content_sanskrit": "तैर्विमुक्तैः शरशतैश्छादितं गगनं महत् ।\nशलभानां यथा व्रातैस्तद्वदासीद् विशाम्पते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2167960, "chapter_id": 4604, "verse_number": "२५", "content_sanskrit": "ते शरा हेमविकृताः सम्पतन्तो मुहुर्मुहुः ।\nश्रेणीकृता व्यरोचन्त क्रौञ्चाः श्रेणीकृता इव\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2167961, "chapter_id": 4604, "verse_number": "२६", "content_sanskrit": "बाणजालावृते व्योम्नि च्छादिते च दिवाकरे ।\nन स्म सम्पतते भूतं किञ्चिदप्यन्तरिक्षगम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2167962, "chapter_id": 4604, "verse_number": "२७", "content_sanskrit": "निरुद्धे तत्र मार्गे तु शरसङ्घैः समन्ततः ।\nव्यरोचेतां महात्मानौ कालसूर्याविवोदितौ\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2167963, "chapter_id": 4604, "verse_number": "२८", "content_sanskrit": "कर्णचापच्युतैर्बाणैर्वध्यमानास्तु सोमकाः ।\nअवालीयन्त राजेन्द्र वेदनार्ता भृशार्दिताः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2167964, "chapter_id": 4604, "verse_number": "२९", "content_sanskrit": "नकुलस्य ततो बाणैर्वध्यमाना चमूस्तव ।\nव्यदीर्यत ततो राजन् वातनुन्न इवाम्बुदः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2167965, "chapter_id": 4604, "verse_number": "३०", "content_sanskrit": "ते सेने वध्यमाने तु ताभ्यां दिव्यैर्महाशरैः ।\nशरपातानतिक्रम्य तस्थतुः प्रेक्षके इव\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2167966, "chapter_id": 4604, "verse_number": "३१", "content_sanskrit": "प्रोत्सारिते जने तस्मिन् कर्णपाण्डवयोः शरैः ।\nजघ्नतुस्तौ महात्मानावन्योन्यं शरवृष्टिभिः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2167967, "chapter_id": 4604, "verse_number": "३२", "content_sanskrit": "विदर्शयन्तौ शस्त्राणि दिव्यानि रणमूर्धनि ।\nछादयन्तौ च सहसा परस्परवधैषिणौ\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2167968, "chapter_id": 4604, "verse_number": "३३", "content_sanskrit": "नकुलेन शरा मुक्ताः कङ्कबर्हिणवाससः ।\nसूतपुत्रमवच्छाद्य व्यतिष्ठन्त इवाम्बरे\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2167969, "chapter_id": 4604, "verse_number": "", "content_sanskrit": "(तथैव सूतपुत्रेण प्रेषिताः परमाहवे ।\nपाण्डुपुत्रमवच्छाद्य व्यतिष्ठन्त इवाम्बरे\t॥३४॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2167970, "chapter_id": 4604, "verse_number": "३५", "content_sanskrit": "शरवेश्मप्रविष्टौ तौ ददृशाते न कैश्चन ।\nचन्द्रसूर्यौ यथा राजन् छाद्यमानौ जलागमे\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2167971, "chapter_id": 4604, "verse_number": "३६", "content_sanskrit": "ततः क्रुद्धो रणे कर्णः कृत्वा घोरतरं वपुः ।\nपाण्डवं छादयामास समन्ताच्छरवृष्टिभिः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2167972, "chapter_id": 4604, "verse_number": "३७", "content_sanskrit": "स च्छाद्यमानः समरे सूतपुत्रेण पाण्डवः ।\nन चकार व्यथां राजन् भास्करो जलदैस्तथा\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2167973, "chapter_id": 4604, "verse_number": "३८", "content_sanskrit": "ततः प्रहस्याधिरथिः शरजालानि मारिष ।\nप्रेषयामास समरे शतशोऽथ सहस्रशः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2167974, "chapter_id": 4604, "verse_number": "३९", "content_sanskrit": "एकच्छायमभूत् सर्वं तस्य बाणैर्महात्मनः ।\nअभ्रच्छायेव सञ्जज्ञे सम्पतद्भिः शरोत्तमैः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2167975, "chapter_id": 4604, "verse_number": "४०", "content_sanskrit": "ततः कर्णो महाराज धनुश्छित्त्वा महात्मनः ।\nसारथिं पातयामास रथनीडाद् हसन्निव\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2167976, "chapter_id": 4604, "verse_number": "४१", "content_sanskrit": "ततोऽश्वांश्चतुरस्तस्य चतुर्भिर्निशितैः शरैः ।\nयमस्य सदनं तूर्णं प्रेषयामास भारत\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2167977, "chapter_id": 4604, "verse_number": "४२", "content_sanskrit": "अथास्य तं रथं दिव्यं तिलशो व्यधमच्छरैः ।\nपताकां चक्ररक्षांश्च गदां खड्गं च मारिष\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2167978, "chapter_id": 4604, "verse_number": "", "content_sanskrit": "शतचन्द्रं च तच्चर्म सर्वोपकरणानि च ।\n(सुवर्णविकृतं तच्च धनुः सशरमाहवे\t॥४३॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2167979, "chapter_id": 4604, "verse_number": "४४", "content_sanskrit": "हताश्वो विरथश्चैव विचर्मा च विशाम्पते ।\nअवतीर्य रथात् तूर्णं परिघं गृह्य विष्ठितः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2167980, "chapter_id": 4604, "verse_number": "४५", "content_sanskrit": "समुद्यतं महाघोरं परिघं तस्य सूतजः ।\nव्यथमत् सायकैस्तूर्णं तदद्भुतमिवाभवत्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2167981, "chapter_id": 4604, "verse_number": "४६", "content_sanskrit": "व्यायुधं चैनमालक्ष्य शरैः सन्नतपर्वभिः ।\nअर्दयन् बहुशः कर्णो न चैनं समपीडयत्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2167982, "chapter_id": 4604, "verse_number": "४७", "content_sanskrit": "स वध्यमानः समरे कृतास्त्रेण बलीयसा ।\nप्राद्रवत् सहसा राजन् नकुलो व्याकुलेन्द्रियः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2167983, "chapter_id": 4604, "verse_number": "४८", "content_sanskrit": "तमभिद्रुत्य राधेयः प्रहसन् वै पुनः पुनः ।\nसज्यं च स्वधनुः कण्ठे व्यवासृज्य च भारत\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2167984, "chapter_id": 4604, "verse_number": "४९", "content_sanskrit": "ततः स शुशुभे राजन् कण्ठसक्तमहाधनुः ।\nपरिवेषमनुप्राप्तो नभसीव तमोनुदः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2167985, "chapter_id": 4604, "verse_number": "", "content_sanskrit": "यथा चैवासितो मेघः शक्रचापेन शोभितः ।\n(अशोभत महाराज पाण्डुपुत्रस्तथा रणे\t॥५०॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2167986, "chapter_id": 4604, "verse_number": "५१", "content_sanskrit": "तमब्रवीत् तदा कर्णो व्यर्थं व्याहृतवानसि ।\nवदेदानीं पुनर्हृष्टो वध्यो मे त्वं पुनः पुनः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2167987, "chapter_id": 4604, "verse_number": "५२", "content_sanskrit": "मा योत्सीः कुरुभिः सार्धं बलवद्भिश्च पाण्डव ।\nसदृशैस्तात युध्यस्व व्रीडां मा कुरु पाण्डव\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2167988, "chapter_id": 4604, "verse_number": "५३", "content_sanskrit": "गृहं वा गच्छ माद्रेय यत्र वा केशवार्जुनौ ।\nएवमुक्त्वा महाराज विससर्ज स तं तदा\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2167989, "chapter_id": 4604, "verse_number": "५४", "content_sanskrit": "वधे प्राप्ते तु तं शत्रुं नावधीत् सूतनन्दनः ।\nस्मृत्वा मातुर्वचो राजन् तत एनं व्यसर्जयत्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2167990, "chapter_id": 4604, "verse_number": "५५", "content_sanskrit": "विसृष्टः पाण्डवो राजन् सूतपुत्रेण धन्विना ।\nव्रीडन्निव जगामाथ युधिष्ठिररथं प्रति\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2167991, "chapter_id": 4604, "verse_number": "५६", "content_sanskrit": "आरुरोह रथं चापि धर्मराजस्य पाण्डवः ।\nनिःश्वसन् दुःखसन्तप्तः कुम्भक्षिप्त इवोरगः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2167992, "chapter_id": 4604, "verse_number": "५७", "content_sanskrit": "तं विजित्य रणे कर्णः पाञ्चालांस्त्वरितो ययौ ।\nरथेनातिपताकेन चन्द्रवर्णहयेन च\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2167993, "chapter_id": 4604, "verse_number": "५८", "content_sanskrit": "तत्राक्रन्दो महानासीत् पाण्डवानां विशाम्पते ।\nदृष्ट्वा सेनापतिं यान्तं पाञ्चालानां रथव्रजान्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2167994, "chapter_id": 4604, "verse_number": "५९", "content_sanskrit": "तत्राकरोन्महाराज कदनं सूतनन्दनः ।\nमध्यं प्राप्ते दिनकरे चक्रवद् व्यचरत् प्रभुः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2167995, "chapter_id": 4604, "verse_number": "६०", "content_sanskrit": "भग्नचक्रै रथैः केचिच्छिन्नध्वजपताकिभिः ।\nहताश्वैर्हतसूतैश्च भग्नाक्षैश्चापि मारिष\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2167996, "chapter_id": 4604, "verse_number": "६१", "content_sanskrit": "ह्रियमाणानपश्याम पाञ्चालानां रथव्रजान्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2167997, "chapter_id": 4604, "verse_number": "६२", "content_sanskrit": "तत्र तत्र च सम्भ्रान्ता विचेरुस्तत्र कुञ्जराः ।\nदावाग्न्यभिपरीताङ्गा यथैव स्युर्महावने\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2167998, "chapter_id": 4604, "verse_number": "६३", "content_sanskrit": "भिन्नकुम्भाः सरुधिराश्छिन्नहस्ताश्च वारणाः ।\nछिन्नगात्रावराश्चैव च्छिन्नवालाश्च मारिष\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2167999, "chapter_id": 4604, "verse_number": "६४", "content_sanskrit": "छिन्नाभ्राणीव सम्पेतुर्वध्यमाना महात्मना\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2168000, "chapter_id": 4604, "verse_number": "६५", "content_sanskrit": "अपरे त्रासिता नागा नाराचशरतोमरैः ।\nतमेवाभिमुखं जग्मुः शलभा इव पावकम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2168001, "chapter_id": 4604, "verse_number": "६६", "content_sanskrit": "अपरे निष्टनन्तस्तु व्यदृश्यन्त महाद्विपाः ।\nक्षरन्तः शोणितं गात्रैर्नगा इव जलस्रवाः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2168002, "chapter_id": 4604, "verse_number": "६७", "content_sanskrit": "उरश्छदैर्विमुक्ताश्च वालबन्धैश्च वाजिनः ।\nराजतैश्च तथा कांस्यैः सौवर्णैश्च विभूषणैः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2168003, "chapter_id": 4604, "verse_number": "६८", "content_sanskrit": "हीनांश्चाभरणैश्चैव खलीनैश्च विवर्जितान् ।\nचामरैश्च कुथाभिश्च तूणीरैः पतितैरपि\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2168004, "chapter_id": 4604, "verse_number": "६९", "content_sanskrit": "निहतैः सादिभिश्चैव शूरैराहवशोभिभिः ।\nअपश्याम रणे तत्र भ्राम्यमाणान् हयोत्तमान्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2168005, "chapter_id": 4604, "verse_number": "७०", "content_sanskrit": "प्रासैः खड्गैश्च संस्यूतानृष्टिभिश्चैव भारत\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2168006, "chapter_id": 4604, "verse_number": "७१", "content_sanskrit": "हययोधानपश्याम कञ्चुकोष्णीषवेष्टितान् ।\nनिहतान् धावमानांश्च वेष्टमानांश्च मारिष\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2168007, "chapter_id": 4604, "verse_number": "७२", "content_sanskrit": "नानाङ्गावयवैर्हीनांस्तत्रतत्रैव भारत\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2168008, "chapter_id": 4604, "verse_number": "७३", "content_sanskrit": "रथान् हेमपरिष्कारान् सुयुक्तान् जवनैर्हयैः ।\nभ्राम्यमाणानपश्याम हतेषु रथिषु द्रुतम्\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2168009, "chapter_id": 4604, "verse_number": "७४", "content_sanskrit": "हताक्षकूबरान् कांश्चिद् भग्नचक्रांश्च भारत ।\nविपताकध्वजांश्चैव छिन्नेषादण्डबन्धुरान्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2168010, "chapter_id": 4604, "verse_number": "", "content_sanskrit": "विहीनान् रथिभिस्तत्र धावमानांस्ततस्ततः ।\n(रथांस्तु तत्र विच्छिन्नाः तिलशः कर्णविक्रमैः\t॥७५॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2168011, "chapter_id": 4604, "verse_number": "७६", "content_sanskrit": "सूतपुत्रशरैस्तप्तान् अपश्याम जगत्पते ।\nविशस्त्रांश्च तथैवान्यान् सशस्त्रांश्च बहून् हतान्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2168012, "chapter_id": 4604, "verse_number": "", "content_sanskrit": "नानावर्णविचित्राभिः पताकाभिरलङ्कृतान् ।\n(नागानवयवैर्हीनांस्तत्र तत्र विनिष्ठितान्\t॥७७॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2168013, "chapter_id": 4604, "verse_number": "७८", "content_sanskrit": "तारकाजालसञ्छन्नान् उरुघण्टोपशोभितान् ।\nवारणाननुपश्याम धावमानान् समन्ततः\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2168014, "chapter_id": 4604, "verse_number": "७९", "content_sanskrit": "शिरोभिर्बाहुभिर्हीनान् भिन्नैरूरुभिरेव च ।\nकर्णचापच्युतैर्बाणैरदृश्यन्त विनाकृताः\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2168015, "chapter_id": 4604, "verse_number": "८०", "content_sanskrit": "महान् व्यतिकरो रौद्रो योधानामन्वदृश्यत ।\nकर्णसायकनुन्नानां वध्यतां निशितैः शरैः\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2168016, "chapter_id": 4604, "verse_number": "८१", "content_sanskrit": "ते वध्यमानाः समरे सूतपुत्रेण सृञ्जयाः ।\nतमेवाभिमुखा यान्ति पतङ्गा इव पावकम्\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2168017, "chapter_id": 4604, "verse_number": "८२", "content_sanskrit": "तं दहन्तमनीकानि तत्र तत्र महारथम् ।\nक्षत्रिया वर्जयामासुर्युगान्ताग्निमिवोल्बणम्\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2168018, "chapter_id": 4604, "verse_number": "८३", "content_sanskrit": "हतशेषास्तु ये वीराः पाञ्चालानां रथव्रजाः ।\nतान् भग्नान् द्रुतं कर्णः पृष्ठतो विकिरन् शरैः\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2168019, "chapter_id": 4604, "verse_number": "८४", "content_sanskrit": "अभ्यद्रवत तेजस्वी विशीर्णकवचध्वजान् ।\nतापयन् समरे बाणैः सूतपुत्रो महारथः ।\nमध्यन्दिनमनुप्राप्तो भूतानीव तमोनुदः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2168020, "chapter_id": 4604, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां कर्णपर्वणि चतुर्विंशोऽध्यायः ॥२४॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}]