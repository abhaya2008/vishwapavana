[{"id": 2082442, "chapter_id": 2755, "verse_number": "१२-२६०-०x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082443, "chapter_id": 2755, "verse_number": "१२-२६०-१", "content_sanskrit": "हृदि कामद्रुमश्चित्रो मोहसंचयसंभवः।\nक्रोधमानमहास्कन्धो विवित्सापरिवेषणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082444, "chapter_id": 2755, "verse_number": "१२-२६०-२", "content_sanskrit": "तस्य चाज्ञानमाधारः प्रमादः परिषेचनम्।\nसोऽभ्यसूयापलाशो हि पुरा दुष्कृतसारवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082445, "chapter_id": 2755, "verse_number": "१२-२६०-३", "content_sanskrit": "संमोहचिन्ताविटपः शोकशाखो भयाङ्कुरः।\nमोहनीभिः पिपासाभिर्लताभिरनुवेष्टितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082446, "chapter_id": 2755, "verse_number": "१२-२६०-४", "content_sanskrit": "उपासते महावृक्षं सुलुब्धास्तत्फलेप्सवः।\nआयतैः संयुताः पाशैः फलदं परिवेष्ट्य तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082447, "chapter_id": 2755, "verse_number": "१२-२६०-५", "content_sanskrit": "यस्तान्पाशान्वशे कृत्वा तं वृक्षमपकर्षति।\nगतः स दुःखयोरन्तं जरामरणयोर्द्वयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082448, "chapter_id": 2755, "verse_number": "१२-२६०-६", "content_sanskrit": "संरोहत्यकृतप्रज्ञः ससत्वो हन्ति पादपम्।\nस तमेवाहतो हन्ति विषं ग्रस्तमिवातुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082449, "chapter_id": 2755, "verse_number": "१२-२६०-७", "content_sanskrit": "तस्यानुगतमूलस्य मूलमुद्भियते बलात्।\nयोगप्रसादात्कृतिना साम्येन परमासिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082450, "chapter_id": 2755, "verse_number": "१२-२६०-८", "content_sanskrit": "एवं यो वेद कामस्य केवलं परिसर्पणम्।\nएतच्च कामशास्त्रस्य सुदुःखान्यतिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082451, "chapter_id": 2755, "verse_number": "१२-२६०-९", "content_sanskrit": "शरीरं पुरमित्याहुः स्वामिनी बुद्धिरिष्यते।\nतत्र बुद्धेः शरीरस्थं मनो नामार्थचिन्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082452, "chapter_id": 2755, "verse_number": "१२-२६०-१०", "content_sanskrit": "इन्द्रियाणि जनाः पौरास्तदर्थं तु परा कृतिः।\nतत्र द्वौ दारुणौ दोषौ तमो नाम रजस्तथा।\nतदर्थमुपजीवन्ति पौराः सह पुरेश्वरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082453, "chapter_id": 2755, "verse_number": "१२-२६०-११", "content_sanskrit": "अद्वारेण तमेवार्थं द्वौ दोषावुपजीवतः।\nतत्र बुद्धिर्हि दुर्धर्षा मनः साधर्म्यमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082454, "chapter_id": 2755, "verse_number": "१२-२६०-१२", "content_sanskrit": "पौराश्चापि मनस्तृप्तास्तेषामपि चला स्थितिः।\nयदर्थं बुद्धिरध्यास्ते सोऽनर्थः परिषीदति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082455, "chapter_id": 2755, "verse_number": "१२-२६०-१३", "content_sanskrit": "`पौरमन्त्रवियुक्तायाः सोऽर्थः संसीदति क्रमात्।\nयदर्थं पृथगध्यास्ते मनस्तत्परिषीदति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082456, "chapter_id": 2755, "verse_number": "१२-२६०-१४", "content_sanskrit": "पृथग्भूतं मनो बुद्ध्या मनो भवति केवलम्।\nतत्रैनं विकृतं शून्यं रजः पर्यवतिष्ठते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082457, "chapter_id": 2755, "verse_number": "१२-२६०-१५", "content_sanskrit": "तन्मनः कुरुते सख्यं रजसा सह संगतम्।\nतं चादाय जनं पौरं रजसे संप्रयच्छति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082458, "chapter_id": 2755, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि षष्ट्यधिकद्विशततमोऽध्यायः॥ २६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]