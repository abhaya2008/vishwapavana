[{"id": 2085278, "chapter_id": 2816, "verse_number": "१२-३२१-०x", "content_sanskrit": "याज्ञवल्क्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2085279, "chapter_id": 2816, "verse_number": "१२-३२१-१", "content_sanskrit": "साङ्ख्यज्ञानं मया प्रोक्तं योगज्ञानं निबोध मे।\nयथाश्रुतं यथादृष्टं तत्त्वेन नृपसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2085280, "chapter_id": 2816, "verse_number": "१२-३२१-२", "content_sanskrit": "नास्ति साङ्ख्यसमं ज्ञानं नास्ति योगसमं बलम्।\nतावुभावेकचर्यौ तावुभावनिधनौ स्मृतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2085281, "chapter_id": 2816, "verse_number": "१२-३२१-३", "content_sanskrit": "पृथक्पृथक्प्रपश्यन्ति येऽप्यबुद्धिरता नराः।\nवयं तु राजन्पश्याम एकमेव तु निश्चयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2085282, "chapter_id": 2816, "verse_number": "१२-३२१-४", "content_sanskrit": "यदेव योगाः पश्यन्ति तत्साङ्ख्यैरपि दृश्यते।\nएकं साङ्ख्यं च योगं च यः पश्यति स तत्त्ववित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2085283, "chapter_id": 2816, "verse_number": "१२-३२१-५", "content_sanskrit": "रुद्रप्रधानानपरान्विद्धि योगानरिंदम्।\nतेनैव चाथ देहेन विचरन्ति दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2085284, "chapter_id": 2816, "verse_number": "१२-३२१-६", "content_sanskrit": "यावद्धि प्रलयस्तात सूक्ष्मेणाष्टगुणेन ह।\nयोगेन लोकान्विचरन्सुखं संन्यस्य चानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2085285, "chapter_id": 2816, "verse_number": "१२-३२१-७", "content_sanskrit": "तावदेवाष्टगुणिनं योगप्राहुर्मनीषिणः।\nसूक्ष्ममष्टगुणं प्राहुर्नेतरं नृपसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2085286, "chapter_id": 2816, "verse_number": "१२-३२१-८", "content_sanskrit": "द्विगुणं योगत्यं तु योगानां प्राहुरुत्तमम्।\nसगुणं निर्गुणं चैव यथाशास्त्रनिदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2085287, "chapter_id": 2816, "verse_number": "१२-३२१-९", "content_sanskrit": "धारणं चैव मनसः प्राणायामश्च पार्थिव।\nएकाग्रता च मनसः प्राणायामस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2085288, "chapter_id": 2816, "verse_number": "१२-३२१-१०", "content_sanskrit": "प्राणायामो हि सगुणो निर्गुणं धारयेन्मनः।\nयद्यदृश्यति मुञ्चन्वै प्राणान्मैथिलसत्तम।\nवाताधिक्यं भवत्येव तस्मात्तं न समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2085289, "chapter_id": 2816, "verse_number": "१२-३२१-११", "content_sanskrit": "निशायाः प्रथमे यामे चोदना द्वादश स्मृताः।\nमध्ये स्वप्नात्परे यामे द्वादशैव तु चोदनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2085290, "chapter_id": 2816, "verse_number": "१२-३२१-१२", "content_sanskrit": "तदेवमुपशान्तेन दान्तेनैकान्तशीलिना।\nआत्मारामेण बुद्धेन योक्तव्योऽऽत्मा न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2085291, "chapter_id": 2816, "verse_number": "१२-३२१-१३", "content_sanskrit": "पञ्चानामिन्द्रियाणां तु दोषानाक्षिप्य पञ्चधा।\nशब्दं रूपं तथा स्पर्शं रसं गन्धं तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2085292, "chapter_id": 2816, "verse_number": "१२-३२१-१४", "content_sanskrit": "प्रतिभामपवर्गं च प्रतिसंहृत्य मैथिल।\nइन्द्रियग्राममखिलं मनस्यभिनिवेश्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2085293, "chapter_id": 2816, "verse_number": "१२-३२१-१५", "content_sanskrit": "मनस्तथैवाहंकारे प्रतिष्ठाप्य नराधिप।\nअहंकारं तथा बुद्धौ बुद्धिं च प्रकृतावपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2085294, "chapter_id": 2816, "verse_number": "१२-३२१-१६", "content_sanskrit": "एवं हि परिसंख्याय ततो ध्यायन्ति केवलम्।\nविरजस्कमलं नित्यमनन्तं शुद्धमव्रणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2085295, "chapter_id": 2816, "verse_number": "१२-३२१-१७", "content_sanskrit": "तस्थुषं पुरुषं नित्यमभेद्यमजरामरम्।\nशाश्वतं चाव्ययं चैव ईशानं ब्रह्म चाख्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2085296, "chapter_id": 2816, "verse_number": "१२-३२१-१८", "content_sanskrit": "युक्तस्य तु महाराज लक्षणान्युपधारम्।\nलक्षणं तु प्रसादस्य यथा तृप्तः सुखं स्वयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2085297, "chapter_id": 2816, "verse_number": "१२-३२१-१९", "content_sanskrit": "निर्वाते तु यथा दीपो ज्वलेत्स्नेहस --धतः।\nनिश्चलोर्ध्वशिखस्तद्वद्युक्तमाहुर्मनीषिण॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2085298, "chapter_id": 2816, "verse_number": "१२-३२१-२०", "content_sanskrit": "पाषाण इव मेघोत्थैर्यथा बिन्दुभिराहतः।\nनालं चालयितुं शक्यस्तथा युक्तस्य लक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2085299, "chapter_id": 2816, "verse_number": "१२-३२१-२१", "content_sanskrit": "शक्तदुन्दुभिनिर्घोषैर्विधिधैर्गीतवादितैः।\nक्रियमाणैर्न कम्पेत युक्तस्यैतन्निदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2085300, "chapter_id": 2816, "verse_number": "१२-३२१-२२", "content_sanskrit": "तैलपात्रं यथा पूर्णं कराभ्यां गृह्य पूरुषः।\nसोपानमारुहेद्भीतस्तर्ज्यमानोऽसिषणिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2085301, "chapter_id": 2816, "verse_number": "१२-३२१-२३", "content_sanskrit": "संयतात्मा भयात्तेषां न पात्राद्बिन्दुमुत्सृजेत्।\nतथैवोत्तरमागम्य एकाग्रमनसस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2085302, "chapter_id": 2816, "verse_number": "१२-३२१-२४", "content_sanskrit": "स्थिरत्वादिन्द्रियाणां तु निश्चलस्तथैव च।\nएवं युक्तस्य तु मुनेर्लक्षणान्युपल----॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2085303, "chapter_id": 2816, "verse_number": "१२-३२१-२५", "content_sanskrit": "स्वयुक्तः पश्यते ब्रह्म यत्तत्परम----यम्।\nमहतस्तमसो मध्ये स्थितं ज्व नसा--भम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2085304, "chapter_id": 2816, "verse_number": "१२-३२१-२६", "content_sanskrit": "एतेन केवलं याति त्यक्त्वा देहमसाक्षिकम्।\nकालेन महता राजञ्श्रुतिरेषा सनातनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2085305, "chapter_id": 2816, "verse_number": "१२-३२१-२७", "content_sanskrit": "एतद्धि योगं योगानां किमन्यद्योगलक्षणम्।\nविज्ञाय तद्धि मन्यन्ते कृतकृत्या मनीषिणः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2085306, "chapter_id": 2816, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकविंशत्यधिकत्रिशततमोऽध्यायः॥ ३२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]