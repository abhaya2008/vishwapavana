[{"id": 7001538000, "chapter_id": 21538, "verse_number": "१-३५-१", "content_sanskrit": "॥ सूत उवाच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001538001, "chapter_id": 21538, "verse_number": "१-३५-२", "content_sanskrit": "यत्तद्वै कर्णिकामूलमिति वै सम्प्रकीर्तितम् ।\nतद्योजनसहस्राणां सप्ततीनामधः स्मृतम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001538002, "chapter_id": 21538, "verse_number": "१-३५-३", "content_sanskrit": "चत्वरिंशत्तथाष्टौ च सहस्राण्यत्र मण्डलम् ।\nशैलराजावृतं रम्यं मेरुमूलमिति श्रुतिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001538003, "chapter_id": 21538, "verse_number": "१-३५-४", "content_sanskrit": "तेषां गिरिसहस्राणामनेकेषु महोच्छ्रिताः ।\nदिक्षु सर्वासु पर्य्यन्तैर्मर्य्यादाः पर्वताः स्मृताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001538004, "chapter_id": 21538, "verse_number": "१-३५-५", "content_sanskrit": "निकुञ्जकन्दरनदीगुहानिर्झरशोभिताः ।\nबहुप्रासादकटकै स्तटैश्च कुसुमोज्ज्वलैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001538005, "chapter_id": 21538, "verse_number": "१-३५-६", "content_sanskrit": "नितम्बपुष्पमालौघैः सानुभिर्धातुमण्डितैः  ।\nशिखरैर्हेमकपिलैर्नैकप्रस्रवणावृतैः ।\nशोभिता गिरयः सर्व्वे पुष्टै रत्न समर्पितैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001538006, "chapter_id": 21538, "verse_number": "१-३५-७", "content_sanskrit": "विहङ्गशतसंजुष्टैः कुञ्जैरनुपमैरपि ।\nसिहशार्दूलशरभैर्नैकैश्चामरवारणैः ।\nनानावर्णाकृतिधरैः सेविता विविधैर्नगैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001538007, "chapter_id": 21538, "verse_number": "१-३५-८", "content_sanskrit": "सप्ताश्च हरिकृष्णाङ्गमेकैकं दशपर्वतम् ।\nबाह्यमाभ्यन्तरा ये तु त्रिवाहास्तु समाः स्मृताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001538008, "chapter_id": 21538, "verse_number": "१-३५-९", "content_sanskrit": "जठरो देवकूटश्च पूर्वस्यां दिशि पर्वतौ ।\nतौ दक्षिणोत्तरायामावानीलनिषधायतौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001538009, "chapter_id": 21538, "verse_number": "१-३५-१०", "content_sanskrit": "कैलासो हिमवांश्चैव दक्षिणोत्तरपर्वतौ ।\nपूर्वपश्चायतावेतावर्णवान्तव्यवस्थितौ ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001538010, "chapter_id": 21538, "verse_number": "१-३५-११", "content_sanskrit": "योऽसौ मेरुर्द्विजश्रेष्ठाः प्रांशुः कनकपर्वतः ।\nविष्कम्भं तस्य वक्ष्यामि तन्मे निगदतः श्रृणु ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001538011, "chapter_id": 21538, "verse_number": "१-३५-१२", "content_sanskrit": "महापादास्तु चत्वारो मेरोरथ चतुर्द्दिशम् ।\nयैर्धृतत्वान्न चलति सप्तद्वीपवती मही ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001538012, "chapter_id": 21538, "verse_number": "१-३५-१३", "content_sanskrit": "दशयोजनसाहस्र आयामस्तेषु पठ्यते ।\nदेवगन्धर्वयक्षाणां नानारत्नोपशोभिताः ।\nनैकनिर्झरवप्राढ्या रम्यकन्दरनिर्मिताः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001538013, "chapter_id": 21538, "verse_number": "१-३५-१४", "content_sanskrit": "नितम्बपुष्पकादम्बैः शोभिताश्चित्रसानवः ।\nमनःशिलादरीभिश्च हरितालतलैस्तथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001538014, "chapter_id": 21538, "verse_number": "१-३५-१५", "content_sanskrit": "सुवर्णमणिचित्राभिर्गुहाभिश्च समन्ततः ।\nशुद्धहिङ्गुलकप्रख्यैः काञ्चनैर्धातुमण्डितैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001538015, "chapter_id": 21538, "verse_number": "१-३५-१६", "content_sanskrit": "वरकाञ्चनचित्रैश्च प्रवालैः समलंकृताः ।\nरुचिराः शतपर्वाणः सिद्धावासा मुदान्विताः ।\nमहाविमानैः श्रीमद्भिः समन्तात्परिदीपिताः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001538016, "chapter_id": 21538, "verse_number": "१-३५-१७", "content_sanskrit": "पूर्वेण मन्दरो नाम दक्षिणे गन्धमादनः ।\nविपुलः पश्चिमे पार्श्वे सुपार्श्वश्चोत्तरे स्मृतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001538017, "chapter_id": 21538, "verse_number": "१-३५-१८", "content_sanskrit": "तेषां सहस्रश्रृङ्गेषु वज्रवैढूर्यवेदिकाः ।\nशाखासहस्रकलिताः सुमूलाः सुप्रतिष्ठिताः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001538018, "chapter_id": 21538, "verse_number": "१-३५-१९", "content_sanskrit": "स्रिग्धैर्नीलैर्घनैः पर्णैः सञ्झन्नविविधाश्रयाः  ।\nअनेकप्रजनोत्सेधा महापुष्पफलोपगाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001538019, "chapter_id": 21538, "verse_number": "१-३५-२०", "content_sanskrit": "यक्षगन्धर्वसेव्याश्च सेविताः सिद्धचारणैः ।\nमहावृक्षाः समुत्पन्नाश्चत्वारो द्वीपकेतवः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001538020, "chapter_id": 21538, "verse_number": "१-३५-२१", "content_sanskrit": "मन्दरस्य गिरेःश्रृङ्गे महावृक्षः स केतुराट् ।\nआलम्बशाखाशिखरः कन्दरश्चैव पादपः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001538021, "chapter_id": 21538, "verse_number": "१-३५-२२", "content_sanskrit": "महाकुम्भप्रमाणैस्तु पुष्पैर्विकचकेसरैः ।\nमहागन्धैर्मनोज्ञैश्च शोभितः सर्वकालजैः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001538022, "chapter_id": 21538, "verse_number": "१-३५-२३", "content_sanskrit": "सहस्रमधिकं सोऽथ गन्धेनापूरयद्दिशः ।\nयोजनानां समन्ताद्वै मन्दमारुतवीजितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001538023, "chapter_id": 21538, "verse_number": "१-३५-२४", "content_sanskrit": "वरकेतुरेव प्रथितो भद्राश्वो नाम यो द्विजाः ।\nयत्र साक्षात् हृषीकेशः सिद्धसङ्घैर्महीयते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001538024, "chapter_id": 21538, "verse_number": "१-३५-२५", "content_sanskrit": "तस्य रुद्रकदम्बस्य तदा श्वेतहरो हरिः  ।\nप्राप्तवानपरश्रेष्ठः स तत्र सहितः पुरा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001538025, "chapter_id": 21538, "verse_number": "१-३५-२६", "content_sanskrit": "तेन चालोकितं सर्वं द्वीपं द्विपदनायकाः ।\nयस्य नाम्ना समाख्यातो भद्राश्वो नाम नामतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001538026, "chapter_id": 21538, "verse_number": "१-३५-२७", "content_sanskrit": "दक्षिणस्यापि शैलस्य शिखरे देवसेविता ।\nजम्बूः सदा पुष्पफला सदा माल्योपशोभिता ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001538027, "chapter_id": 21538, "verse_number": "१-३५-२८", "content_sanskrit": "महामूलैर्महास्कन्धैः स्निग्धवर्णैर्विभूषिता ।\nनवैः सदा पुष्पफलैः शाखाभिश्चोपशोभिता ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001538028, "chapter_id": 21538, "verse_number": "१-३५-२९", "content_sanskrit": "तस्या ह्यतिप्रमाणानि स्वादूनि च मृदूनि च ।\nफलान्यमृतकल्पानि पतन्ति गिरिमूर्द्धनि ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001538029, "chapter_id": 21538, "verse_number": "१-३५-३०", "content_sanskrit": "तस्माद्गिरिवरप्रस्थात् पुनः प्रस्यन्दवाहिनी ।\nनदी जम्बूनदी नाम प्रवृत्ता मधुवाहिनी ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001538030, "chapter_id": 21538, "verse_number": "१-३५-३१", "content_sanskrit": "तत्र जाम्बूनदन्नाम सुवर्णं ज्वलनप्रभम् ।\nदेवालङ्कारमतुलं जायते पापनाशनम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001538031, "chapter_id": 21538, "verse_number": "१-३५-३२", "content_sanskrit": "देवदानवगन्धर्वा यक्षराक्षसपन्नगाः ।\nयत् पिबन्त्यमृतप्रख्यं मधु जाम्भूरसस्रवम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001538032, "chapter_id": 21538, "verse_number": "१-३५-३३", "content_sanskrit": "स केतुर्दक्षिणे द्वीपे जम्भूर्लोकेषु विश्रुता ।\nयस्या नाम्ना स विख्यातो जम्भूद्वीपः सनातनः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001538033, "chapter_id": 21538, "verse_number": "१-३५-३४", "content_sanskrit": "विपुलस्यापि शैलस्य पश्चिमस्य महात्मनः ।\nजातः श्रृङ्गेऽतिसुमहानश्वत्थ श्चैव पादपः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001538034, "chapter_id": 21538, "verse_number": "१-३५-३५", "content_sanskrit": "विलम्बिवरमालाद्यः सुवर्णमणिवेदिकः ।\nमहोच्चस्कन्धविटपो नैकसत्त्वगुणालयः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001538035, "chapter_id": 21538, "verse_number": "१-३५-३६", "content_sanskrit": "कुम्भप्रमाणैः सुखदैः फलैः सर्वर्त्तुकैः शुभैः ।\nस केतुः केतुमालानां देवगन्धर्वसेवितः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001538036, "chapter_id": 21538, "verse_number": "१-३५-३७", "content_sanskrit": "केतुमालेति च यथा तस्या नाम प्रकीर्तितम् ।\nतन्निबोधत विप्रेन्द्रा निरुक्तं नाम कर्मतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001538037, "chapter_id": 21538, "verse_number": "१-३५-३८", "content_sanskrit": "क्षीरोदमथने वृत्ते दैत्यपक्षे पराजिते ।\nमहासमरसम्मर्दवृक्षक्षोभविमर्दिता ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001538038, "chapter_id": 21538, "verse_number": "१-३५-३९", "content_sanskrit": "सहस्राक्षेण विहिता माला तस्य सुतानिता ।\nतस्य स्कन्धे समासक्त्या ह्यश्वत्थस्य वनस्पतेः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001538039, "chapter_id": 21538, "verse_number": "१-३५-४०", "content_sanskrit": "सा तथैव महागन्धा ह्यम्लाना सर्वकामिकी ।\nइज्यते सुमहाभागा विविधैः सिद्धचारणैः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001538040, "chapter_id": 21538, "verse_number": "१-३५-४१", "content_sanskrit": "तस्य केतोः सदा माला देवदत्ता विराजते ।\nपवनेनेरिता दिव्यं वाति गन्धं मनोरमम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001538041, "chapter_id": 21538, "verse_number": "१-३५-४२", "content_sanskrit": "ताभ्यां नामाङ्कितो द्वीपः पश्चिमे बहुविस्तरः ।\nकेतुमाल इति ख्यातो दिवि चेह च सर्वशः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001538042, "chapter_id": 21538, "verse_number": "१-३५-४३", "content_sanskrit": "स्वपार्श्वस्योत्तरे चापि श्रृङ्गे जातो महाद्रुमः  ।\nन्यग्रोधो विपुलस्कन्धोऽनेकयोजनमण्डलः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001538043, "chapter_id": 21538, "verse_number": "१-३५-४४", "content_sanskrit": "माल्यदामकलापैश्च विविधैर्गन्धशालिभिः ।\nशाकाविलम्बी शुशुभे सिद्धचारणसेवितः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001538044, "chapter_id": 21538, "verse_number": "१-३५-४५", "content_sanskrit": "प्रवालकुम्भसदृशैर्मधुपूर्णैः फलैः सदा ।\nस ह्युत्तर कुरूणान्तु केतुवृक्षः प्रकाशते ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001538045, "chapter_id": 21538, "verse_number": "१-३५-४६", "content_sanskrit": "सनत्कुमारावरजा मानसा ब्रह्मणः सुताः ।\nसप्त तत्र महाभागाः कुरवो नाम विश्रुताः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001538046, "chapter_id": 21538, "verse_number": "१-३५-४७", "content_sanskrit": "तत्र तैरागतज्ञानैः सत्त्वस्थैः पुण्यकीर्तिभिः ।\nअक्षयं क्षेममपरं लोकं प्राप्तं सनातनम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001538047, "chapter_id": 21538, "verse_number": "१-३५-४८", "content_sanskrit": "तेषां नामाङ्कितो द्वीपः सप्तानां वै महात्मनाम्  ।\nदिवि चेह च विख्याता उत्तराः कुरवः सदा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001538048, "chapter_id": 21538, "verse_number": "१-३५-४९", "content_sanskrit": "इति श्रीमहापुराणे वायुप्रोक्ते जम्बूद्वीपवर्णनं नाम पञ्चत्रिंशोऽध्यायः ॥ ३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]