[{"id": 2149436, "chapter_id": 4234, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2149437, "chapter_id": 4234, "verse_number": "१", "content_sanskrit": "शकुनिर्मातुलस्तेऽसौ रथ एको नराधिपः ।\nप्रसज्य पाण्डवैः सर्वैः योत्स्यते नात्र संशयः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2149438, "chapter_id": 4234, "verse_number": "२", "content_sanskrit": "एतस्य सेना दुर्धर्षाः समरे प्रतियोधिनः ।\nविविधायुधभूयिष्ठा वायुवेगसमा जवे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2149439, "chapter_id": 4234, "verse_number": "३", "content_sanskrit": "द्रोणपुत्रो महेष्वासः सर्वेषामति धन्विनाम् ।\nसमरे चित्रयोधी च दृढास्त्रश्च महारथः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2149440, "chapter_id": 4234, "verse_number": "४", "content_sanskrit": "एतस्य हि महाराज यथा गाण्डीवधन्वनः ।\nशरासनविनिर्मुक्ताः संसक्ता यान्ति सायकाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2149441, "chapter_id": 4234, "verse_number": "५", "content_sanskrit": "नैष शक्यो महावीरः सङ्ख्यातुं रथसत्तमः ।\nनिर्दहेदपि लोकांस्त्रीनिच्छन्नेष महायशाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2149442, "chapter_id": 4234, "verse_number": "६", "content_sanskrit": "क्रोधस्तेजश्च तपसा सम्भृतो वनवासिनाम् ।\nद्रोणेनानुगृहीतश्च दिव्यैरस्त्रैरुदारधीः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2149443, "chapter_id": 4234, "verse_number": "७", "content_sanskrit": "दोषस्तस्य महानेको येनैष भरतर्षभ ।\nन मे रथो नातिरथो मतः पार्थिवसत्तम\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2149444, "chapter_id": 4234, "verse_number": "८", "content_sanskrit": "जीवितं प्रियमत्यर्थमायुष्कामः सदा द्विजः ।\nन ह्यस्य सदृशः कश्चिद् उभयोः सेनयोरपि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2149445, "chapter_id": 4234, "verse_number": "९", "content_sanskrit": "हन्यादेकरथेनैव देवानामपि वाहिनीम् ।\nवपुष्मांस्तळघोषेण स्फोटयेदपि पर्वतान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2149446, "chapter_id": 4234, "verse_number": "१०", "content_sanskrit": "असङ्ख्येयगुणो वीरः प्रहर्ता दारुणद्युतिः ।\nदण्डपाणिरिवासँह्यः कालवत् प्रचरिष्यति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2149447, "chapter_id": 4234, "verse_number": "११", "content_sanskrit": "युगान्ताग्निसमः क्रोधात् सिंहग्रीवो महातपाः ।\nएष भारत युद्धस्य पृष्ठं संशमयिष्यति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2149448, "chapter_id": 4234, "verse_number": "१२", "content_sanskrit": "पिता त्वस्य महातेजा वृद्धोऽपि युवभिर्वरः ।\nरणे कर्म महत् कर्ता अत्र मे नास्ति संशयः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2149449, "chapter_id": 4234, "verse_number": "१३", "content_sanskrit": "अस्त्रवेगानिलोद्धूतः सेनाकक्षेन्धनोत्थितः ।\nपाण्डुपुत्रस्य सैन्यानि प्रधक्ष्यति न संशयः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2149450, "chapter_id": 4234, "verse_number": "१४", "content_sanskrit": "रथयूथपयूथानां यूथपोऽयं नरर्षभः ।\nभरद्वाजात्मजः कर्ता कर्म तीव्रं हिताय वः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2149451, "chapter_id": 4234, "verse_number": "१५", "content_sanskrit": "सर्वमूर्धाभिषिक्तानामाचार्यः स्थविरो गुरुः ।\nगच्छेदन्तं सृञ्जयानां प्रियस्त्वस्य धनञ्जयः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2149452, "chapter_id": 4234, "verse_number": "१६", "content_sanskrit": "नैष जातु महेष्वासः पार्थमक्लिष्टकारिणम् ।\nहन्यादाचार्यकं दीप्तं संस्मृत्य गुणनिर्जितम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2149453, "chapter_id": 4234, "verse_number": "१७", "content_sanskrit": "श्लाघत्येष सदा वीरः पार्थस्य गुणविस्तरैः ।\nपुत्रादभ्यधिकं चैनं भारद्वाजोऽनुपश्यति\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2149454, "chapter_id": 4234, "verse_number": "१८", "content_sanskrit": "हन्यादेकरथेनैव देवगन्धर्वदानवान् ।\nएकीभूतानपि रणे दिव्यैरस्त्रैः प्रतापवान्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2149455, "chapter_id": 4234, "verse_number": "१९", "content_sanskrit": "पौरवो राजशार्दूलः तव राजन् महारथः।\nमतो मम रथोदारः परवीररथारुजः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2149456, "chapter_id": 4234, "verse_number": "२०", "content_sanskrit": "स्वेन सैन्येन महता प्रतपन् शत्रुवाहिनीम् ।\nप्रधक्ष्यति स पाञ्चालान् कक्षं कृष्णगतिर्यथा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2149457, "chapter_id": 4234, "verse_number": "२१", "content_sanskrit": "सत्यश्रवा रथस्त्वेको राजपुत्रो बृहद्बलः ।\nतव राजन् रिपुबले कालवत् प्रचरिष्यति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2149458, "chapter_id": 4234, "verse_number": "२२", "content_sanskrit": "एतस्य योधा राजेन्द्र विचित्रकवचायुधाः ।\nविचरिष्यन्ति सङ्ग्रामे निघ्नन्तः शात्रवान् रणे\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2149459, "chapter_id": 4234, "verse_number": "२३", "content_sanskrit": "वृषसेनो रथश्रेष्ठः कर्णपुत्रो महारथः ।\nप्रधक्ष्यति रिपूणां ते बलं तु बलिनां वरः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2149460, "chapter_id": 4234, "verse_number": "२४", "content_sanskrit": "जलसन्धो महातेजा राजन् रथवरस्तव ।\nत्यक्ष्यते समरे प्राणान् मागधः परवीरहा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2149461, "chapter_id": 4234, "verse_number": "२५", "content_sanskrit": "एष योत्स्यति सङ्ग्रामे गजस्कन्धविशारदः ।\nरथेन वा महाबाहुः क्षपयन् शत्रुवाहिनीम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2149462, "chapter_id": 4234, "verse_number": "२६", "content_sanskrit": "रथ एष महाबाहो मतो मम नरर्षभः ।\nत्वदर्थे त्यक्ष्यति प्राणान् सहसैन्यो महारणे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2149463, "chapter_id": 4234, "verse_number": "२७", "content_sanskrit": "एष विक्रान्तयोधी च चित्रयोधी च सङ्गरे ।\nवीतभीश्चापि ते राजन् शत्रुभिः सह योत्स्यते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2149464, "chapter_id": 4234, "verse_number": "२८", "content_sanskrit": "बाह्लीकोऽतिरथश्चैव समरे चानिवर्तिता ।\nमम राजन् मतो युद्धे शूरो वैवस्वतोपमः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2149465, "chapter_id": 4234, "verse_number": "२९", "content_sanskrit": "न ह्येष समरं प्राप्य निवर्तेत कथञ्चन\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2149466, "chapter_id": 4234, "verse_number": "३०", "content_sanskrit": "यथा सततगो राजन् स हि हन्यात् परान् रणे ।\nसेनापतिर्महाराज सत्यवांस्ते महारथः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2149467, "chapter_id": 4234, "verse_number": "३१", "content_sanskrit": "रणेष्वद्भुतकर्मा च रथी पररथारुजः ।\nएतस्य समरं दृष्ट्वा न व्यथाऽस्ति कदाचन\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2149468, "chapter_id": 4234, "verse_number": "३२", "content_sanskrit": "उत्स्मयन्नुत्पतत्येष परान् रथपथे स्थितान्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2149469, "chapter_id": 4234, "verse_number": "३३", "content_sanskrit": "एष चारिषु विक्रान्तः कर्म सत्पुरुषोचितम् ।\nकर्ता विमर्दे सुमहत् त्वदर्थे पुरुषोत्तमः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2149470, "chapter_id": 4234, "verse_number": "३४", "content_sanskrit": "अलम्बुसो राक्षसेन्द्रः क्रूरकर्मा महारथः ।\nहनिष्यति परान् राजन् पूर्ववैरमनुस्मरन्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2149471, "chapter_id": 4234, "verse_number": "३५", "content_sanskrit": "एष राक्षससैन्यानां सर्वेषां रथसत्तमः ।\nमायावी दृढवैरश्च समरे विचरिष्यति\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2149472, "chapter_id": 4234, "verse_number": "३६", "content_sanskrit": "प्राग्ज्योतिषाधिपो वीरो भगदत्तः प्रतापवान् ।\nगजाङ्कुशधरः श्रेष्ठो रथे चैव विशारदः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2149473, "chapter_id": 4234, "verse_number": "३७", "content_sanskrit": "एतेन युद्धमभवत् पुरा गाण्डीवधन्वनः ।\nदिवसान् सुबहून् राजन्नुभयोर्जयकाङ्क्षिणोः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2149474, "chapter_id": 4234, "verse_number": "३८", "content_sanskrit": "तं चासहायं गान्धारे मानयन् पाकशासनिम् ।\nअकरोत् संविदं तेन पाण्डवेन महात्मना\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2149475, "chapter_id": 4234, "verse_number": "३९", "content_sanskrit": "एष योत्स्यति सङ्ग्रामे गजस्कन्धविशारदः ।\nऐरावतगतो राजा देवानामिव वासवः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2149476, "chapter_id": 4234, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि पञ्चषष्ट्युत्तरशततमोऽध्यायः ॥१६५॥\nरथातिरथसङ्ख्यानपर्वणि तृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]