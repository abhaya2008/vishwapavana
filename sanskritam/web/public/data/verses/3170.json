[{"id": 2101030, "chapter_id": 3170, "verse_number": "१४-२६-१", "content_sanskrit": "ब्राह्मण उवाच।\nअत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nचातुर्होत्रविधानस्य विदानमिह यादृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101031, "chapter_id": 3170, "verse_number": "१४-२६-२", "content_sanskrit": "तस्य सर्वस्य विधिवद्विधानमुपदेक्ष्यते।\nशृणु मे गदतो भद्रे रहस्यमिदमुद्भुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101032, "chapter_id": 3170, "verse_number": "१४-२६-३", "content_sanskrit": "करणं कर्म कर्ता च मोक्ष इत्येव भामिनि।\nचत्वार एते होतारो यैरिदं जगदावृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101033, "chapter_id": 3170, "verse_number": "१४-२६-४", "content_sanskrit": "होतॄणां साधनं चैव शृणु सर्वमशेषतः।\nघ्राणं जिह्वा च चक्षुश्च त्वक्च श्रोत्रं च पञ्चमम्।\nमनो बुद्धिश्च सप्तैते ज्ञेयाः कारणहेतवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101034, "chapter_id": 3170, "verse_number": "१४-२६-५", "content_sanskrit": "गन्धो रसश्च रूपं च शब्दः स्पर्शश्च पञ्चमः।\nमन्तव्यमवबोद्धव्यं सप्तैते कर्महेतवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101035, "chapter_id": 3170, "verse_number": "१४-२६-६", "content_sanskrit": "घ्राता भक्षयिता द्रष्टा स्प्रष्टा श्रोता च पञ्चमः।\nमन्ता बोद्धा च सप्तैते विज्ञेयाः कर्तृहेतवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101036, "chapter_id": 3170, "verse_number": "१४-२६-७", "content_sanskrit": "स्वगुणान्भक्षयन्त्येते गुणवन्तः शुभाशुभान्।\nअसन्तो निर्गुणाश्चैते सप्तैते मोक्षहेतवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101037, "chapter_id": 3170, "verse_number": "१४-२६-८", "content_sanskrit": "विदुषां बुध्यमानानां स्वंस्वं स्थानं यथाविधि।\nगुणास्ते देवता भूत्वा सततं भुञ्जते हविः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101038, "chapter_id": 3170, "verse_number": "१४-२६-९", "content_sanskrit": "`अदन्हवींषि चान्नानि ममत्वेन विहन्यते।\nआत्मार्थे पाचयन्नन्नं ममत्वेनोपहन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101039, "chapter_id": 3170, "verse_number": "१४-२६-१०", "content_sanskrit": "अभक्ष्यभक्षणं चैव मद्यपानं च हन्ति तम्।\nस चान्नं हन्ति तं चान्नं स हत्वा हन्यते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101040, "chapter_id": 3170, "verse_number": "१४-२६-११", "content_sanskrit": "हन्ता ह्यन्नमिदं विद्वान्पुनर्जनयतीश्वरः।\nन चान्नाज्जायते तस्मिन्सूक्ष्मो नाम व्यतिक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101041, "chapter_id": 3170, "verse_number": "१४-२६-१२", "content_sanskrit": "मनसा मन्यते यच्च यच्च वाचा निगद्यते।\nश्रोत्रेण श्रूयते यच्च चक्षुषा यच्च दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101042, "chapter_id": 3170, "verse_number": "१४-२६-१३", "content_sanskrit": "स्पर्शेन स्पृश्यते यच्च घ्राणेन घ्रायते च यत्।\nमनस्येतानि संयम्य हवींष्येतानि सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101043, "chapter_id": 3170, "verse_number": "१४-२६-१४", "content_sanskrit": "गुणवत्पावको मह्यं दीप्यतेऽन्तःशरीरगः।\nयोगयज्ञः प्रवृत्तो मे ज्ञानं ब्रह्ममयो हविः। प्राणस्तोत्रोऽपानशस्त्रः सर्वत्यागसुदक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101044, "chapter_id": 3170, "verse_number": "१४-२६-१५", "content_sanskrit": "कर्ताऽनुमन्ता ब्रह्मात्मा होताऽध्वर्युः कृतस्तुतिः\nऋतं प्रशास्ता तच्छस्त्रमपवर्गोऽस्य दक्षिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101045, "chapter_id": 3170, "verse_number": "१४-२६-१६", "content_sanskrit": "ऋचश्चाप्यत्र शंसन्ति नारायणविदो जनाः।\nनारायणाय देवाययदविन्दन्पशून्पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101046, "chapter_id": 3170, "verse_number": "१४-२६-१७", "content_sanskrit": "तत्र सामानि गायन्ति तत्र चाहुर्निदर्शनम्।\nदेवं नारायणं भीरु सर्वात्मानं निबोध तम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101047, "chapter_id": 3170, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि षडिंशोऽध्यायः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]