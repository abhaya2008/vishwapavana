  {
    "id": 20000191,
    "chapter_id": 6564,
    "verse_number": "2.5",
    "content_sanskrit": "(स्मितं कृत्वा)एवमात्माभिप्रायसंभावितेष्टजनचित्तवृत्तिः प्रार्थिता विडम्ब्यते ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
