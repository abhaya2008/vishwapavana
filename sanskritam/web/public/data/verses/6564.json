  {
    "id": 20000192,
    "chapter_id": 6564,
    "verse_number": "2.6",
    "content_sanskrit": "स्निग्धं वीक्षितमन्यतोऽपि नयने यत्प्रेरयन्त्या तया यातं यच्च नितम्बयोर्गुरुतया मन्दं विलासादिव । मा गा इत्युपरुद्धया यदपि सा सासूयमुक्ता सखी सर्वं तत्किल मत्परायणमहो कामी स्वतां पश्यति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
