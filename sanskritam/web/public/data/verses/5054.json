[{"id": 2190483, "chapter_id": 5054, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2190484, "chapter_id": 5054, "verse_number": "१", "content_sanskrit": "अविरोधेन भूतानां त्यागः षाड्गुण्यकारकः ।\nयः स्यादुभयभाग् धर्मस्तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2190485, "chapter_id": 5054, "verse_number": "२", "content_sanskrit": "गार्हस्थ्यस्य च धर्मस्य त्यागधर्मस्य चोभयोः ।\nअदूरसम्प्रस्थितयोः किं स्विच्छ्रेयः पितामह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2190486, "chapter_id": 5054, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2190487, "chapter_id": 5054, "verse_number": "३", "content_sanskrit": "उभौ धर्मौ महाभागावुभौ परमदुश्चरौ ।\nउभौ महाफलौ तात सद्भिराचरितावुभौ\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2190488, "chapter_id": 5054, "verse_number": "४", "content_sanskrit": "अत्र ते वर्तयिष्यामि प्रामाण्यमुभयोस्तयोः ।\nशृणुष्वैकमनाः पार्थ छिन्नधर्मार्थसंशयम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2190489, "chapter_id": 5054, "verse_number": "५", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nकपिलस्य गोश्च संवादं तन्निबोध युधिष्ठिर\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2190490, "chapter_id": 5054, "verse_number": "६", "content_sanskrit": "आम्नायमनुपश्यन् हि पुराणं शाश्वतं ध्रुवम् ।\nनहुषः पूर्वमालेभे त्वष्टुर्गामिति नः श्रुतम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2190491, "chapter_id": 5054, "verse_number": "७", "content_sanskrit": "तां नियुक्तामदीनात्मा सत्त्वस्थः समये रतः ।\nज्ञानवान्नियताहारो ददर्श कपिलस्तदा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2190492, "chapter_id": 5054, "verse_number": "८", "content_sanskrit": "स बुद्धिमुत्तमां प्राप्तो नैष्ठिकीमकुतोभयाम् ।\nस्वरेण शिथिलोऽसत्या वेदा इत्यब्रवीत् सकृत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2190493, "chapter_id": 5054, "verse_number": "९", "content_sanskrit": "तां गामृषिः स्यूमरश्मिः प्रविश्य यतिमब्रवीत् ।\nअंहो वेदा यदि मता धर्माः केनापरे मताः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2190494, "chapter_id": 5054, "verse_number": "१०", "content_sanskrit": "तपस्विनो धृतिमतः श्रुतिविज्ञानचक्षुषः ।\nसर्वमार्षं हि मन्यन्ते व्याहृतं विदितात्मनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2190495, "chapter_id": 5054, "verse_number": "११", "content_sanskrit": "तस्यैवं गततृष्णस्य विज्वरस्य निराशिषः ।\nका विवक्षास्ति वेदेषु निरारम्भस्य सर्वशः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2190496, "chapter_id": 5054, "verse_number": "", "content_sanskrit": "कपिलः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2190497, "chapter_id": 5054, "verse_number": "१२", "content_sanskrit": "नाहं वेदान् विनिन्दामि न विवक्षामि कर्हिचित् ।\nपृथगाश्रमिणां कर्माण्येकार्थानीति नः श्रुतम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2190498, "chapter_id": 5054, "verse_number": "१३", "content_sanskrit": "गच्छत्येव परित्यागी वानप्रस्थश्च गच्छति ।\nगृहस्थो ब्रह्मचारी च उभौ तावपि गच्छतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2190499, "chapter_id": 5054, "verse_number": "१४", "content_sanskrit": "देवयाना हि पन्थानश्चत्वारः शाश्वता मताः ।\nतेषां ज्यायःकनीयस्त्वं फलेषूक्तं बलाबलम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2190500, "chapter_id": 5054, "verse_number": "१५", "content_sanskrit": "एवं विदित्वा सर्वार्थानारभेदिति वैदिकम् ।\nनारभेदिति चान्यत्र नैष्ठिकी श्रूयते श्रुतिः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2190501, "chapter_id": 5054, "verse_number": "१६", "content_sanskrit": "अनारम्भे ह्यदोषः स्यादारम्भे दोष उत्तमः ।\nएवं स्थितस्य शास्त्रस्य दुर्विज्ञेयं बलाबलम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2190502, "chapter_id": 5054, "verse_number": "१७", "content_sanskrit": "यद्यत्र किञ्चित् प्रत्यक्षमहिंसायाः परं मतम् ।\nऋते त्वागमशास्त्रेभ्यो ब्रूहि तद् यदि पश्यसि\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2190503, "chapter_id": 5054, "verse_number": "", "content_sanskrit": "स्यूमरश्मिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2190504, "chapter_id": 5054, "verse_number": "१८", "content_sanskrit": "स्वर्गकामो यजेतेति सततं श्रूयते श्रुतिः ।\nफलं प्रकल्प्य पूर्वं हि ततो यज्ञः प्रतायते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2190505, "chapter_id": 5054, "verse_number": "१९", "content_sanskrit": "अजश्चाश्वश्च मेषश्च गौश्च पक्षिगणाश्च ये ।\nग्राम्यारण्या ओषधयः प्राणस्यान्नमिति श्रुतिः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2190506, "chapter_id": 5054, "verse_number": "२०", "content_sanskrit": "तथैवान्नं ह्यहरहः सायं प्रातर्निरुप्यते ।\nपशवश्चाथ धान्यं च यज्ञस्याङ्गमिति श्रुतिः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2190507, "chapter_id": 5054, "verse_number": "२१", "content_sanskrit": "एतानि सह यज्ञेन प्रजापतिरकल्पयत् ।\nतेन प्रजापतिर्देवान्यज्ञेनायजत प्रभुः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2190508, "chapter_id": 5054, "verse_number": "२२", "content_sanskrit": "ते स्मान्योन्यञ्चराः सर्वे प्राणिनः सप्त सप्त च ।\nयज्ञेषूपाकृतं विश्वं प्राहुरुत्तमसञ्ज्ञितम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2190509, "chapter_id": 5054, "verse_number": "२३", "content_sanskrit": "एतच्चैवाभ्यनुज्ञातं पूर्वैः पूर्वतरैस्तथा ।\nको जातु न विचिन्वीत विद्वान्स्वां शक्तिमात्मनः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2190510, "chapter_id": 5054, "verse_number": "२४", "content_sanskrit": "पशवश्च मनुष्याश्च द्रुमाश्चौषधिभिः सह ।\nस्वर्गमेवाभिकाङ्क्षन्ते न च स्वर्गस्त्वृते मखम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2190511, "chapter_id": 5054, "verse_number": "२५", "content_sanskrit": "ओषध्यः पशवो वृक्षा वीरुदाज्यं पयो दधि ।\nहविर्भूमिर्दिशः श्रद्धा कालश्चैतानि द्वादश\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2190512, "chapter_id": 5054, "verse_number": "२६", "content_sanskrit": "ऋचो यजूंषि सामानि यजमानश्च षोडशः ।\nअग्निर्ज्ञेयो गृहपतिः स सप्तदश उच्यते॥\nअङ्गान्येतानि यज्ञस्य यज्ञो मूलमिति श्रुतिः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2190513, "chapter_id": 5054, "verse_number": "२७", "content_sanskrit": "आज्येन पयसा दध्ना शकृतामिक्षया त्वचा ।\nवालैः शृङ्गेण पादेन सम्भवत्येव गौर्मखम्॥\nएवं प्रत्येकशः सर्वं यद्यदस्य विधीयते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2190514, "chapter_id": 5054, "verse_number": "२८", "content_sanskrit": "यज्ञं वहन्ति सम्भूय सहर्त्विग्भिः सदक्षिणैः ।\nसंहत्यैतानि सर्वाणि यज्ञं निर्वर्तयन्त्युत\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2190515, "chapter_id": 5054, "verse_number": "२९", "content_sanskrit": "यज्ञार्थानि हि सृष्टानि यथा वै श्रूयते श्रुतिः ।\nएवं पूर्वे पूर्वतराः प्रवृत्ताश्चैव मानवाः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2190516, "chapter_id": 5054, "verse_number": "३०", "content_sanskrit": "न हिनस्ति ह्यारभते नाभिद्रुह्यति किञ्चन ।\nयज्ञो यष्टव्य इत्येव यो यजत्यफलेप्सया\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2190517, "chapter_id": 5054, "verse_number": "३१", "content_sanskrit": "यज्ञाङ्गान्यपि चैतानि यथोक्तानि नसंशयः ।\nविधिना विधियुक्तानि तारयन्ति परस्परम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2190518, "chapter_id": 5054, "verse_number": "३२", "content_sanskrit": "आम्नायमार्षं पश्यामि यस्मिन् वेदाः प्रतिष्ठिताः ।\nतं विद्वांसोऽनुपश्यन्ति ब्राह्मणस्यानुदर्शनात्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2190519, "chapter_id": 5054, "verse_number": "३३", "content_sanskrit": "ब्राह्मणप्रभवो यज्ञो ब्राह्मणार्पण एव च ।\nअनु यज्ञं जगत् सर्वं यज्ञश्चानु जगत् सदा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2190520, "chapter_id": 5054, "verse_number": "३४", "content_sanskrit": "ओमिति ब्रह्मणो योनिर्नमः स्वाहा स्वधा वषट् ।\nयस्यैतानि प्रयुज्यन्ते यथाशक्ति कृतान्यपि\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2190521, "chapter_id": 5054, "verse_number": "३५", "content_sanskrit": "न तस्य त्रिषु लोकेषु परलोकभयं विदुः ।\nइति वेदा वदन्तीह सिद्धाश्च परमर्षयः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2190522, "chapter_id": 5054, "verse_number": "३६", "content_sanskrit": "ऋचो यजूंषि सामानि स्तोभाश्च विधिचोदिताः ।\nयस्मिन्नेतानि सर्वाणि बहिरेव स वै द्विजः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2190523, "chapter_id": 5054, "verse_number": "३७", "content_sanskrit": "अग्न्याधेये यद्भवति यच्च सोमे सुते द्विज ।\nयच्चेतरैर्महायज्ञैर्वेद तद् भगवान् स्वतः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2190524, "chapter_id": 5054, "verse_number": "३८", "content_sanskrit": "तस्माद् ब्रह्मन् यजेतैव याजयेच्चाविचारयन् ।\nयजतः स्वर्गविधिना प्रेत्य स्वर्गफलं महत्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2190525, "chapter_id": 5054, "verse_number": "३९", "content_sanskrit": "नायं लोकोऽस्त्ययज्ञानां परश्चेति विनिश्चयः ।\nवेदवादविदश्चैव प्रमाणमुभयं तदा\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2190526, "chapter_id": 5054, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे गोकपिलसंवादे त्र्यधिकशततमोऽध्यायः ॥१०३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]