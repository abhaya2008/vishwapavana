[{"id": 2005045, "chapter_id": 1099, "verse_number": "१-१००-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2005046, "chapter_id": 1099, "verse_number": "१-१००-१", "content_sanskrit": "अथान्तरिक्षे दुष्यन्तं वागुवाचाशरीरिणी।\nऋत्विक्पुरोहिताचार्यैर्मन्त्रिभिश्चाभिसंवृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2005047, "chapter_id": 1099, "verse_number": "१-१००-२", "content_sanskrit": "माता भस्त्रा पितुः पुत्रो यस्माज्जातः स एव सः।\nभरस्व पुत्रं दौष्यन्तिं सत्यमाह शकुन्तला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2005048, "chapter_id": 1099, "verse_number": "१-१००-३", "content_sanskrit": "सर्वेभ्यो ह्यङ्गमङ्गेभ्यः साक्षादुत्पद्यते सुतः।\nआत्मा चैव सुतो नाम तेनैव तव पौरव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2005049, "chapter_id": 1099, "verse_number": "१-१००-४", "content_sanskrit": "आहितं ह्यात्मनाऽऽत्मानं परिरक्ष इमं सुतम्।\nअनन्यां त्वं प्रतीक्षस्व मावमंस्थाः शकुन्तलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2005050, "chapter_id": 1099, "verse_number": "१-१००-५", "content_sanskrit": "स्त्रियः पवित्रमतुलमेतद्दुष्यन्त धर्मतः।\nमासि मासि रजो ह्यासां दुरितान्यपकर्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2005051, "chapter_id": 1099, "verse_number": "१-१००-६", "content_sanskrit": "ततः सर्वाणि भूतानि व्याजह्रस्तं समन्ततः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2005052, "chapter_id": 1099, "verse_number": "१-१००-६x", "content_sanskrit": "देवा ऊचुः।\nआहितस्त्वत्तनोरेष मावमंस्थाः शकुन्तलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2005053, "chapter_id": 1099, "verse_number": "१-१००-७", "content_sanskrit": "रेतोधाः पुत्र उन्नयति नरदेव यमक्षयात्।\nत्वं चास्य धाता गर्भस्य सत्यमाह शकुन्तला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2005054, "chapter_id": 1099, "verse_number": "१-१००-८", "content_sanskrit": "पतिर्जायां प्रविशति स तस्यां जायते पुनः।\nअन्योन्यप्रकृतिर्ह्येषा मावमंस्थाः शकुन्तलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2005055, "chapter_id": 1099, "verse_number": "१-१००-९", "content_sanskrit": "जाया जनयते पुत्रमात्मनोऽङ्गाद्द्विधा कृतम्।\nतस्माद्भरस्व दुष्यन्त पुत्रं शाकुन्तलं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2005056, "chapter_id": 1099, "verse_number": "१-१००-१०", "content_sanskrit": "सुभूतिरेषा न त्याज्या जीवितं जीवयात्मजम्।\nशाकुन्तलं महात्मानं दुष्यन्त भर पौरवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2005057, "chapter_id": 1099, "verse_number": "१-१००-११", "content_sanskrit": "भर्तव्योऽयं त्वया यस्मादस्माकं वचनादपि।\nतस्माद्भवत्वयं नाम्ना भरतो नाम ते सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2005058, "chapter_id": 1099, "verse_number": "१-१००-१२", "content_sanskrit": "भरताद्भारती कीर्तिर्येनेदं भारतं कुलम्।\nअपरे ये च पूर्वे च भारता इति तेऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2005059, "chapter_id": 1099, "verse_number": "१-१००-१३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2005060, "chapter_id": 1099, "verse_number": "१-१००-१३", "content_sanskrit": "एवमुक्त्वा ततो देवा ऋषयश्च तपोधनाः।\nपतिव्रतेति संहृष्टाः पुष्पवृष्टिं ववर्षिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2005061, "chapter_id": 1099, "verse_number": "१-१००-१४", "content_sanskrit": "तच्छ्रुत्वा पौरवो वाक्यं व्याहृतं वे दिवौकसाम्।\nसिंहासनात्समुत्थाय प्रणम्य च दिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2005062, "chapter_id": 1099, "verse_number": "१-१००-१५", "content_sanskrit": "पुरोहितममात्यांश्च संप्रहृष्टोऽब्रवीदिदम्।\nशृण्वन्त्वेतद्भवन्तोऽपि देवदूतस्य भाषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2005063, "chapter_id": 1099, "verse_number": "१-१००-१६", "content_sanskrit": "शृण्वन्तु देवतानां च महर्षीणां च भाषितम्।\nअहमप्येवमेवैनं जानामि सुतमात्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2005064, "chapter_id": 1099, "verse_number": "१-१००-१७", "content_sanskrit": "यद्यहं वचनादस्या गृह्णीयामिममात्मजम्।\nभवेद्धि शङ्का लोकस्य नैवं शुद्धो भवेदयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2005065, "chapter_id": 1099, "verse_number": "१-१००-१८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2005066, "chapter_id": 1099, "verse_number": "१-१००-१८", "content_sanskrit": "तां विशोध्य तदा राजा देवैः सह महर्षिभिः।\nहृष्टः प्रमुदितश्चापि प्रतिजग्राह तं सुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2005067, "chapter_id": 1099, "verse_number": "१-१००-१९", "content_sanskrit": "ततस्तस्य तदा राजा पितृकर्माणि सर्वशः।\nकारयामास मुदितः प्रीतिमानात्मजस्य ह।\nमूर्ध्नि चैनं समाघ्राय सस्नेहं परिषस्वजे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2005068, "chapter_id": 1099, "verse_number": "१-१००-२०", "content_sanskrit": "सभाज्यमानो विप्रैश्च स्तूयमानश्च बन्दिभिः।\nमुदं स परमां लेभे पुत्रस्पर्शनजां नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2005069, "chapter_id": 1099, "verse_number": "१-१००-२१", "content_sanskrit": "स्वां चैव भार्यां धर्मज्ञः पूजयामास धर्मतः।\nअब्रवीच्चैव तां राजा सान्त्वपूर्वमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2005070, "chapter_id": 1099, "verse_number": "१-१००-२२", "content_sanskrit": "लोकस्यायं परोक्षस्तु संबन्धो नौ पुराऽभवत्।\nकृतो लोकसमक्षोऽद्य संबन्धो वै पुनः कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2005071, "chapter_id": 1099, "verse_number": "१-१००-२३", "content_sanskrit": "तस्मादेतन्मया तस्य तन्निमित्तं प्रभाषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2005072, "chapter_id": 1099, "verse_number": "१-१००-२४", "content_sanskrit": "शङ्केत वाऽयं लोकोऽथ स्त्रीभावान्मयि संगतम्।\nतस्मादेतन्मया चापि तच्छुद्ध्यर्थं विचारितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2005073, "chapter_id": 1099, "verse_number": "१-१००-२५", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः शूद्राश्चैव पृथग्विधाः।\nत्वां देवि वूजयिष्यन्ति निर्विशङ्कां पतिव्रताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2005074, "chapter_id": 1099, "verse_number": "१-१००-२६", "content_sanskrit": "पुत्रश्चायं वृतो राज्ये त्वमग्रमहिषी भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2005075, "chapter_id": 1099, "verse_number": "१-१००-२७", "content_sanskrit": "यच्च कोपनयात्यर्थं त्वयोक्तोऽस्म्यप्रियं प्रिये।\nप्रणयिन्या विशालाक्षितत्क्षान्तं ते मया शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2005076, "chapter_id": 1099, "verse_number": "१-१००-२८", "content_sanskrit": "अनृतं वाप्यनिष्टं वा दुरुक्तं वातिदुष्कृतम्।\nत्वयाप्येवं विशालाक्षि क्षन्तव्यं मम दुर्वचः।\nक्षान्त्या पतिकृते नार्यः पातिव्रत्यं व्रजन्ति ताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2005077, "chapter_id": 1099, "verse_number": "१-१००-२९", "content_sanskrit": "एवमुक्त्वा तु राजर्षिस्तामनिन्दितगामिनीम्।\nअन्तःपुरं प्रवेश्याथ दुष्यन्तो महिषीं प्रियाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2005078, "chapter_id": 1099, "verse_number": "१-१००-३०", "content_sanskrit": "वासोभिरन्नपानैश्च पूजयित्वा तु भारत।\nस मातरमुपस्थाय रथन्तर्यामभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2005079, "chapter_id": 1099, "verse_number": "१-१००-३१", "content_sanskrit": "मम पुत्रो वने जातस्तव शोकप्रणशनः।\nऋणादद्य विमुक्तोऽहं तव पौत्रेण शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2005080, "chapter_id": 1099, "verse_number": "१-१००-३२", "content_sanskrit": "विश्वामित्रसुता चेयं कण्वेन च विवर्धिता।\nस्नुषा तव महाभागे प्रसीदस्व शकुन्तलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2005081, "chapter_id": 1099, "verse_number": "१-१००-३३", "content_sanskrit": "पुत्रस्य वचनं श्रुत्वा पौत्रं सा परिषस्वजे।\nपादयोः पतितां तत्र रथन्तर्या शकुन्तलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2005082, "chapter_id": 1099, "verse_number": "१-१००-३४", "content_sanskrit": "परिष्वज्य च बाहुभ्यां हर्षादश्रुण्यवर्तयत्।\nउवाच वचनं सत्यं लक्षये लक्षणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2005083, "chapter_id": 1099, "verse_number": "१-१००-३५", "content_sanskrit": "तव पुत्रो विशालाक्षि चक्रवर्ती भविष्यति।\nतव भर्ता विशालाक्षि त्रैलोक्यविजयी भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2005084, "chapter_id": 1099, "verse_number": "१-१००-३६", "content_sanskrit": "दिव्यान्भोगाननुप्राप्ता भव त्वं वरवर्णिनि।\nएवमुक्ता रथ्तर्या परं हर्षमवाप सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2005085, "chapter_id": 1099, "verse_number": "१-१००-३७", "content_sanskrit": "शकुन्तलां तदा राजा शास्त्रोक्तेनैव कर्मणा।\nततोऽग्रमहिषीं कृत्वा सर्वाभरणभूषिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2005086, "chapter_id": 1099, "verse_number": "१-१००-३८", "content_sanskrit": "ब्राह्मणेभ्यो धनं दत्त्वा सैनिकानां च भूपतिः।\nदौष्यन्तिं च ततो राजा पुत्रं शाकुन्तलं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2005087, "chapter_id": 1099, "verse_number": "१-१००-३९", "content_sanskrit": "भरतं नामतः कृत्वा यौवराज्येऽभ्यषेचयत्।\nभरते भारमावेश्य कृतकृत्योऽभवन्नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2005088, "chapter_id": 1099, "verse_number": "१-१००-४०", "content_sanskrit": "ततो वर्षशतं पूर्णं राज्यं कृत्वा नराधिपः।\nगत्वा वनानि दुष्यन्तः स्वर्गलोकमुपेयिवान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2005089, "chapter_id": 1099, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि शततमोऽध्यायः॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]