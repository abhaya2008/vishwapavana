[{"id": 7003751000, "chapter_id": 23751, "verse_number": "२-१-३५-१", "content_sanskrit": "अथ सुवर्णमुखर्या कल्यानदीसंगमः ।\nभरद्वाज उवाच ।\nसुवर्णमुखरी तत्र संगता मंगलप्रदा ।\nकल्यानाम नदी पुण्या कालिन्दी जाह्नवीमिव ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003751001, "chapter_id": 23751, "verse_number": "२-१-३५-२", "content_sanskrit": "वृषभाचलसंभूता तीर्थराजविराजिता ।\nनदीनामुत्तमा कल्या कलुषौघविनाशिनी ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003751002, "chapter_id": 23751, "verse_number": "२-१-३५-३", "content_sanskrit": "नानातरुलताव्रातविभूषिततटद्वया ।\nमुनिसंघसुखावासा पुण्याश्रमसमुत्कटा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003751003, "chapter_id": 23751, "verse_number": "२-१-३५-४", "content_sanskrit": "द्विजदत्तार्ध्यविलसत्कुशाक्षतलसत्तटा ।\nअप्सरःकुचकस्तूरीपंकक्षालनपंकिला ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003751004, "chapter_id": 23751, "verse_number": "२-१-३५-५", "content_sanskrit": "दन्तावलकटच्योतन्मदाम्बुसुरभीकृता ।\nविप्रभूपालविततमखयूप शतावृता ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003751005, "chapter_id": 23751, "verse_number": "२-१-३५-६", "content_sanskrit": "अनाविलजलापूरतोषिताशेषमानवा ।\nएकैवालं परा कर्तुं महानद्योस्तु पातकम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003751006, "chapter_id": 23751, "verse_number": "२-१-३५-७", "content_sanskrit": "तयोः संगतयोः स्तोतुं महिमानं क ईशते ।\nयत्र ब्रह्मशिलानाम सरिन्मध्ये च वर्तते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003751007, "chapter_id": 23751, "verse_number": "२-१-३५-८", "content_sanskrit": "अगस्त्यतपसा पश्चाद्गया सांनिध्यमेति च ।\nनदीद्वयजले तत्र स्नाताः पुण्ये कुरूद्वह ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003751008, "chapter_id": 23751, "verse_number": "२-१-३५-९", "content_sanskrit": "मखानां पौण्डरीकाणां शतस्य फलमाप्नुयुः ।\nब्रह्महत्यादिपापानि समायांति परिक्षयम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003751009, "chapter_id": 23751, "verse_number": "२-१-३५-१०", "content_sanskrit": "तत्राभिषेकपूतानां नदीद्वितयसंगमे ।\nसङ्गता भवनाशिन्या कृष्णवेणीव पावनी ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003751010, "chapter_id": 23751, "verse_number": "२-१-३५-११", "content_sanskrit": "अथ सुवर्णमुखरीतीरस्थितश्रीवेंकटाचलवर्णनम् ।\nराजते स्वर्णमुखरी कल्यया संगता तदा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003751011, "chapter_id": 23751, "verse_number": "२-१-३५-१२", "content_sanskrit": "अथोदीच्यां महानद्या योजनार्द्धे विराजते ।\nयोजनोत्सेधसहितो विख्यातो वेंकटाचलः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003751012, "chapter_id": 23751, "verse_number": "२-१-३५-१३", "content_sanskrit": "सर्वेषामेव तीर्थानामाश्रयोऽयं नगोत्तमः ।\nअञ्जनानन्तवृषभनीलकेसरिपोत्रिणः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003751013, "chapter_id": 23751, "verse_number": "२-१-३५-१४", "content_sanskrit": "एतान्युपवनान्यद्रेः स्युर्नारायणवेंकटौ ।\nवराहवपुषा पूर्वं स्वीकृतत्वान्मधुद्विषा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003751014, "chapter_id": 23751, "verse_number": "२-१-३५-१५", "content_sanskrit": "वराहक्षेत्रमित्यार्यैः कीर्तितोऽयं महीधरः ।\nसुवर्णमुखरीतीरे विख्याते वेंकटाचले ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003751015, "chapter_id": 23751, "verse_number": "२-१-३५-१६", "content_sanskrit": "निवसत्यच्युतो नित्यमब्धीन्द्रतनयान्वितः ।\nतस्मिन्गिरौ श्रिया सार्द्धं वसन्ते वेंकटाधिपम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003751016, "chapter_id": 23751, "verse_number": "२-१-३५-१७", "content_sanskrit": "सेवन्ते सिद्धगन्धर्वमुनिमानवदानवाः ।\nतस्मिन्विन्यस्तचित्तानां भक्तानां पुरुषोत्तमे ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003751017, "chapter_id": 23751, "verse_number": "२-१-३५-१८", "content_sanskrit": "वांछितान्याशु सिध्यंति नश्यंति विपदोऽर्जुन ।\nये स्मरंति जगन्नाथं वेंकटाद्रिनिवासिनम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003751018, "chapter_id": 23751, "verse_number": "२-१-३५-१९", "content_sanskrit": "निरस्तदोषास्ते यांति शाश्वतं पदमव्ययम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003751019, "chapter_id": 23751, "verse_number": "२-१-३५-२०", "content_sanskrit": "अर्जुन उवाच ।\nवेंकटाद्रौ महापुण्ये सुरासुरनमस्कृतः ।\nकथं प्रादुरभूद्देवो भगवान्कमलापतिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003751020, "chapter_id": 23751, "verse_number": "२-१-३५-२१", "content_sanskrit": "कस्य वा कृतिनस्तत्र प्रसन्नो निजमद्भुतम् ।\nरूपं प्रकाशयांचक्रे भुक्तिमुक्तिफलप्रदम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003751021, "chapter_id": 23751, "verse_number": "२-१-३५-२२", "content_sanskrit": "विष्णोर्देवादिदेवस्य महिमानं महामुने ।\nश्रोतुमिच्छामि तत्त्वेन तन्मे कथय विस्तरात् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003751022, "chapter_id": 23751, "verse_number": "२-१-३५-२३", "content_sanskrit": "अथ श्रीवेंकटाचलवासिभगवद्वैभववर्णनम् ।\nभरद्वाज उवाच ।\nशृणु वेंकटनाथस्य महिमानं समाहितः ।\nविस्तरेण समाख्यातुं ब्रह्मणापि न शक्यते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003751023, "chapter_id": 23751, "verse_number": "२-१-३५-२४", "content_sanskrit": "धन्योऽसि देवदेवस्य माहात्म्यं मधुविद्विषः ।\nयद्भक्तियुक्ताभूत्तात श्रोतुं मतिररिन्दम ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003751024, "chapter_id": 23751, "verse_number": "२-१-३५-२५", "content_sanskrit": "कृतपुण्योऽस्म्यहं पार्थ सर्वभूतपतेर्हरेः ।\nपवित्राणि चरित्राणि स्तोष्यन्ते यन्मयाऽधुना ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003751025, "chapter_id": 23751, "verse_number": "२-१-३५-२६", "content_sanskrit": "पुरा भागीरथीतीरे जनकाय महात्मने ।\nक्रतुदीक्षाप्रसक्ताय विशुद्धज्ञानशालिने ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003751026, "chapter_id": 23751, "verse_number": "२-१-३५-२७", "content_sanskrit": "वामदेवेन कथितां कथां पापप्रणाशिनीम् ।\nकथयिष्यामि ते पार्थ विष्णुकीर्तनपावनीम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003751027, "chapter_id": 23751, "verse_number": "२-१-३५-२८", "content_sanskrit": "सर्वेषामेव भूतानामाद्यो नारायणः प्रभुः ।\nजगन्मयो जगत्कर्ता चित्स्वरूपो निरंजनः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003751028, "chapter_id": 23751, "verse_number": "२-१-३५-२९", "content_sanskrit": "सहस्रशीर्षा भगवान्सहस्राक्षः सहस्रपात् ।\nयस्य भासा जगदिदं विभाति सचराचरम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003751029, "chapter_id": 23751, "verse_number": "२-१-३५-३०", "content_sanskrit": "तस्मात्परतरं तेजस्तस्मात्परतरं तपः ।\nतस्मात्परतरं ज्ञानं योगस्तस्मात्परो न च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003751030, "chapter_id": 23751, "verse_number": "२-१-३५-३१", "content_sanskrit": "विद्या तस्मादपि परा नास्ति पार्थ नरर्षभ ।\nसर्वेष्वपि च भूतेषु सदा सन्निहितः प्रभुः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003751031, "chapter_id": 23751, "verse_number": "२-१-३५-३२", "content_sanskrit": "सर्वाण्यपि च भूतानि तस्मिन्नेवासते सुखम् ।\nस एव यज्ञो यज्वा च साधनं स्रुक्स्रुवादिकम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003751032, "chapter_id": 23751, "verse_number": "२-१-३५-३३", "content_sanskrit": "फलं फलप्रदाता च तत्संप्राप्या गतिस्तथा ।\nवह्नौ प्रणीते पशुना प्रोक्षितेन प्रजुह्वति ।\nये तं प्रयांति ते यांति गतिं तत्प्रतिपादिताम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003751033, "chapter_id": 23751, "verse_number": "२-१-३५-३४", "content_sanskrit": "कर्मबन्धं पशुं कृत्वा ज्ञानाग्नौ संप्रवर्तिते ।\nये जुह्वते तमुद्दिश्य ते तत्सायुज्यभागिनः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003751034, "chapter_id": 23751, "verse_number": "२-१-३५-३५", "content_sanskrit": "हरिः सदाशिवो ब्रह्मा महेन्द्रः परमः स्वराट् ।\nसर्वेश्वरस्य तस्यैते पर्यायाः परिकीर्तिताः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003751035, "chapter_id": 23751, "verse_number": "२-१-३५-३६", "content_sanskrit": "ममाहितोऽनुसंधत्ते य इदं परमात्मनः ।\nनारायणस्य माहात्म्यं स न याति पुनर्भवम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003751036, "chapter_id": 23751, "verse_number": "२-१-३५-३७", "content_sanskrit": "चिदानन्दमयः साक्षी निर्गुणो निरुपाधिकः ।\nनित्योऽपि भजते तांतामवस्थां स यदृच्छया ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003751037, "chapter_id": 23751, "verse_number": "२-१-३५-३८", "content_sanskrit": "पवित्राणां पवित्रं यो ह्यगतीनां परा गतिः ।\nदैवतं देवतानां च श्रेयसां श्रेय उत्तमम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003751038, "chapter_id": 23751, "verse_number": "२-१-३५-३९", "content_sanskrit": "बोध्यानां बोध्य एकोऽसौ ध्येयानां ध्येय उत्तमः ।\nविनयानां समधिको विनयो नयसंयुतः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003751039, "chapter_id": 23751, "verse_number": "२-१-३५-४०", "content_sanskrit": "तेजसां जनकं तेजः प्रकृष्टं तपसां तपः ।\nआधारः सर्वभूतानामनाद्यन्तो जनार्दनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003751040, "chapter_id": 23751, "verse_number": "२-१-३५-४१", "content_sanskrit": "तस्येदं भावविज्ञाने मूढा ब्रह्मादयोऽपि च ।\nअजो गृह्णाति जननं सर्वात्मा हन्ति विद्विषः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003751041, "chapter_id": 23751, "verse_number": "२-१-३५-४२", "content_sanskrit": "स्वतन्त्रोऽपि स्वभक्तानां परतन्त्रः प्रवर्तते ।\nस साक्षी कर्मणां देवः सर्वज्ञो गरुडध्वजः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003751042, "chapter_id": 23751, "verse_number": "२-१-३५-४३", "content_sanskrit": "तस्य स्वरूपं मुनयो मृगयन्ते समाहिताः ।\nसङ्कर्षणो वासुदेवः प्रद्युम्नश्च तथा पुनः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003751043, "chapter_id": 23751, "verse_number": "२-१-३५-४४", "content_sanskrit": "अनिरुद्ध इति ख्यातं तन्मूर्तीनां चतुष्टयम् ।\nकीर्तितः प्रणवः पश्चाद्धृदयं तस्य भास्वरम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003751044, "chapter_id": 23751, "verse_number": "२-१-३५-४५", "content_sanskrit": "भगवान्वासुदेवश्च मन्त्रोऽयं तत्प्रकाशकः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003751045, "chapter_id": 23751, "verse_number": "२-१-३५-४६", "content_sanskrit": "मन्त्रराजमिमं नित्यं प्रजपेद्यः समाहितः ।\nस विष्णोः करुणायोगात्सिद्धीनां भाजनं भवेत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003751046, "chapter_id": 23751, "verse_number": "२-१-३५-४७", "content_sanskrit": "अथ भगवत्कृतभूतसृष्ट्यादिवर्णनम् ।\nआपन्निवारकः संपत्प्रापको भुक्तिमुक्तिदः ।\nयथा ससर्ज भूतानि कल्पादावेव माधवः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003751047, "chapter_id": 23751, "verse_number": "२-१-३५-४८", "content_sanskrit": "तत्सर्वं कथयिष्यामि समाहितमनाः शृणु ।\nतस्य चिन्तयतः सर्गं तेजोरूपं परं हरेः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003751048, "chapter_id": 23751, "verse_number": "२-१-३५-४९", "content_sanskrit": "विरिंच इति विख्यातं राजसं गुणमाश्रितम् ।\nतस्य देवस्य वदनाच्छक्रो देवः सपावकः ।\nजज्ञे यश्च त्रिलोकेशः पाककर्मणि यः प्रभुः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003751049, "chapter_id": 23751, "verse_number": "२-१-३५-५०", "content_sanskrit": "मनसश्चाभवच्चन्द्रः करुणानित्यशीतलात् ।\nअपां सर्वौषधीनां च विप्राणां रक्षकः सदा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003751050, "chapter_id": 23751, "verse_number": "२-१-३५-५१", "content_sanskrit": "नेत्राभ्यामुदभूत्सूर्यस्तस्य विश्वप्रकाशकः ।\nशीतोष्णवर्षकृत्कालकारणं तेजसां निधिः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003751051, "chapter_id": 23751, "verse_number": "२-१-३५-५२", "content_sanskrit": "प्राणेभ्योऽस्य जगत्प्राणः समीरः समजायत ।\nधर्ता ग्रहर्क्षस्वर्गंगा विमानानां महाबलः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003751052, "chapter_id": 23751, "verse_number": "२-१-३५-५३", "content_sanskrit": "नाभिदेशात्समुत्पन्नमन्तरिक्षं महात्मनः ।\nतस्यासीच्छिरसो व्योम भूतसंभवकारणम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003751053, "chapter_id": 23751, "verse_number": "२-१-३५-५४", "content_sanskrit": "पादाम्बुजाभ्यामुदभूद्भूमिर्भूतगणाश्रया ।\nविनिःसृता दिशः सर्वाः श्रोत्राभ्यां परमात्मनः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003751054, "chapter_id": 23751, "verse_number": "२-१-३५-५५", "content_sanskrit": "भूर्भुवाद्यास्तथा लोकाः स्मरणात्तस्य जज्ञिरे ।\nरसातलादिलोकाश्च यक्षरक्षोगणादयः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003751055, "chapter_id": 23751, "verse_number": "२-१-३५-५६", "content_sanskrit": "मुखबाहूरुपादेभ्यो जनयामास स क्रमात् ।\nब्राह्मणान्क्षत्त्रियान्वैश्याञ्छूद्रादींश्च कुरूद्वह ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003751056, "chapter_id": 23751, "verse_number": "२-१-३५-५७", "content_sanskrit": "छन्दांसि यज्ञस्तुरगा गावो मेषाविकादयः ।\nअतर्क्यप्रभवां तस्मादुत्पत्तिं प्रतिपेदिरे ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003751057, "chapter_id": 23751, "verse_number": "२-१-३५-५८", "content_sanskrit": "संकल्पाद्देवदेवस्य तस्य स्थावरजंगमम् ।\nभूतजातमभूत्कालो भूतो भावी भवंस्तथा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003751058, "chapter_id": 23751, "verse_number": "२-१-३५-५९", "content_sanskrit": "पिबत्यम्बु समुद्राणां बडवानलरूपधृक ।\nकल्पान्तकाले तत्सर्वं विसृजत्यात्मनि स्थितम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003751059, "chapter_id": 23751, "verse_number": "२-१-३५-६०", "content_sanskrit": "सञ्चारयति भूतानां वृत्तिं सूर्येन्दुरूपधृक् ।\nतमोनिरसनाच्चापि कालधर्मप्रवर्तनात् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003751060, "chapter_id": 23751, "verse_number": "२-१-३५-६१", "content_sanskrit": "जगन्ति कल्पविरमे विन्यस्य स्वोदरान्तरे ।\nलीलाबालाकृतिः शेते वटपत्रे महाम्बुधौ ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003751061, "chapter_id": 23751, "verse_number": "२-१-३५-६२", "content_sanskrit": "अथ चोदग्रभोगीन्द्रभोगतल्पे सुखोचिते ।\nयोगनिद्रामवाप्नोति सद्वितीयोऽब्जवासया ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003751062, "chapter_id": 23751, "verse_number": "२-१-३५-६३", "content_sanskrit": "नाभिकासारसंभूताज्जनयामास पंकजात् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003751063, "chapter_id": 23751, "verse_number": "२-१-३५-६४", "content_sanskrit": "सर्वेषां जगतां नाथो विधातारं चतुर्मुखम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003751064, "chapter_id": 23751, "verse_number": "२-१-३५-६५", "content_sanskrit": "लीला ह्येषा मुकुन्दस्य स्वेच्छायोगप्रवर्तिनः ।\nविज्ञायते न केनाऽपि याथार्थ्येन स ईश्वरः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003751065, "chapter_id": 23751, "verse_number": "२-१-३५-६६", "content_sanskrit": "यदा धर्मस्य हानिः स्यादधर्मो वर्धते यदा ।\nयदा वा महतीं पीडां भजन्ते देवतागणाः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003751066, "chapter_id": 23751, "verse_number": "२-१-३५-६७", "content_sanskrit": "यदावलेपदुर्वारा यांति वृद्धिं सुरद्रुहः ।\nभूमेर्भूमिजनानां च यदोदेति महद्भयम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003751067, "chapter_id": 23751, "verse_number": "२-१-३५-६८", "content_sanskrit": "यदा वा निजभक्तानां साधूनामनिवारिता ।\nदुरन्तातंकजननी विपत्समुपजायते ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003751068, "chapter_id": 23751, "verse_number": "२-१-३५-६९", "content_sanskrit": "तदा तदनुरूपाणि रूपाण्यास्थाय कौतुकात् ।\nअधर्ममवधूयाशु कुरुते जगतो हितम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003751069, "chapter_id": 23751, "verse_number": "२-१-३५-७०", "content_sanskrit": "सृजति विधिसमाख्यो राजसेनात्मनाऽसौ वहति हरिसमाख्यः सत्त्वनिष्ठः प्रपञ्चम् ।\nहरति हरसमाख्यस्तामसीमेत्य वृत्तिं मधुमथनमहिम्नामस्ति वेत्ता न कोऽपि ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003751070, "chapter_id": 23751, "verse_number": "२-१-३५-७१", "content_sanskrit": "यज्ञांगैः कृतसकलांगसंधिबंधं वाराहं वपुरधिगम्य लोकनाथः ।\nशैलेऽस्मिन्नभजदसौ यथा निवासं तद्वक्ष्ये शृणु विबुधाधिनाथसूनो ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003751071, "chapter_id": 23751, "verse_number": "२-१-३५-७२", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे श्रीवेंकटाचलमाहात्म्ये सुवर्णमुखरीमाहात्म्ये विष्णुमाहात्म्यप्रस्तावे सृष्ट्यादिवर्णनंनाम पञ्चत्रिंशोऽध्यायः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]