[{"id": 2015245, "chapter_id": 1319, "verse_number": "२-६०-१", "content_sanskrit": "भीष्म उवाच॥\nद्वारकायां ततः कृष्णः स्वदारेषु दिवानिशम्।\nसुखं लब्ध्वा महाराज प्रमुमोद महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2015246, "chapter_id": 1319, "verse_number": "२-६०-२", "content_sanskrit": "पौत्रस्य कारणाच्चक्रे विबुधानां प्रियं तदा।\nसावसवैः सुरैः सर्वैर्दुष्करं भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2015247, "chapter_id": 1319, "verse_number": "२-६०-३", "content_sanskrit": "बाणो नामाऽभवद्राजा बलेर्ज्येष्ठसुतो बली।\nवीर्यवान्भरतश्रेष्ठ स च बाहुसहस्रवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2015248, "chapter_id": 1319, "verse_number": "२-६०-४", "content_sanskrit": "ततस्तेपे तपस्तीव्रं सत्वेन मनसा नृप।\nरुद्रमाराधयामास स च बाणः समा बहु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2015249, "chapter_id": 1319, "verse_number": "२-६०-५", "content_sanskrit": "तस्मै बहुवरा दत्ताः शङ्करेण महात्मना।\nतांश्च लब्ध्वा वरान्बाणो दुर्लभानसुरैर्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2015250, "chapter_id": 1319, "verse_number": "२-६०-६", "content_sanskrit": "स शोणितपुरे राज्यं चकाराप्रतिमो बली।\nत्रासिताश्च सुराः सर्वे तेन बाणेन पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2015251, "chapter_id": 1319, "verse_number": "२-६०-७", "content_sanskrit": "विजित्य विबुधान्सेन्द्रान्बाणः संवत्सरान्बहून्।\nअशासत महद्राज्यं कुबेर इव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2015252, "chapter_id": 1319, "verse_number": "२-६०-८", "content_sanskrit": "ततो राजन्नुषा नाम बाणस्य दुहिता यथा।\nयेनोपायेन कौन्तेय अनिरुद्धो महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2015253, "chapter_id": 1319, "verse_number": "२-६०-९", "content_sanskrit": "प्राद्युम्निस्तामुषां प्राप्य प्रच्छन्नः प्रमुमोद ह।\nअथ बाणो महातेजास्तदा तत्र युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2015254, "chapter_id": 1319, "verse_number": "२-६०-१०", "content_sanskrit": "तं गृह्यनिलयं ज्ञात्वा प्राद्युम्निं सुतया तदा।\nगृहीत्वा कारयामास वस्तुं कारागृहे बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2015255, "chapter_id": 1319, "verse_number": "२-६०-११", "content_sanskrit": "स कुमारः सुखार्होऽथ तदा दुःखसमन्वितः।\nबामेन घातितो राजन्ननिरुद्धो मुमोह च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2015256, "chapter_id": 1319, "verse_number": "२-६०-१२", "content_sanskrit": "एतस्मिन्नेव काले तु नारदो मुनिपुङ्गवः।\nद्वारकां प्राप्य कौन्तेय कृष्णं दृष्ट्वा वचोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2015257, "chapter_id": 1319, "verse_number": "२-६०-१३", "content_sanskrit": "कृष्ण कृष्ण महाबाहो यदूनां कीर्तिवर्धन।\nपौत्रस्ते बाध्यमानोऽत्र बाणेनामिततेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2015258, "chapter_id": 1319, "verse_number": "२-६०-१४", "content_sanskrit": "कृच्छ्रं प्राप्तोऽनिरुद्धो वै शेते कारागृहे सदा।\nएतदुक्त्वा सुरर्षिर्वै बाणस्याथ पुरं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2015259, "chapter_id": 1319, "verse_number": "२-६०-१५", "content_sanskrit": "नारदस्य वचः श्रुत्वा ततो राजञ्जनार्दनः।\nजाहूय बलदेवं हि प्रद्युम्नं च महाद्युतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2015260, "chapter_id": 1319, "verse_number": "२-६०-१६", "content_sanskrit": "आरुरोह गरुत्मन्तं ताभ्यां सह जनार्दनः।\nततः सुपर्णमारुह्य जयाय भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2015261, "chapter_id": 1319, "verse_number": "२-६०-१७", "content_sanskrit": "जग्मुः क्रुधा महावीर्या बाणस्य नगरं प्रति।\nअथासाद्य महाराज तत्पुरं ददृशुश्च ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2015262, "chapter_id": 1319, "verse_number": "२-६०-१८", "content_sanskrit": "ताम्रप्राकारसङ्गुप्तां हेमप्रासादसङ्कुलाम्।\nदृष्ट्वा मुदा युताः सर्वे विस्मयं परमं ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2015263, "chapter_id": 1319, "verse_number": "२-६०-१९", "content_sanskrit": "तथा बाणपुरस्यासन्द्वारस्था देवताः सदा।\nमहेश्वरो गुहश्चैव भद्रकाली विनायकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2015264, "chapter_id": 1319, "verse_number": "२-६०-२०", "content_sanskrit": "अथ कृष्णो बलाज्जित्वा द्वारपालान्युधिष्ठिर।\nसुसङ्क्रुद्धो महातेजाः शङ्खचक्रगदासिभृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2015265, "chapter_id": 1319, "verse_number": "२-६०-२१", "content_sanskrit": "आससादोत्तरद्वारं शङ्करेणाभिरक्षितम्।\nतत्र तस्थौ महातेजाः शूलपाणिर्महेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2015266, "chapter_id": 1319, "verse_number": "२-६०-२२", "content_sanskrit": "पिनाकं सशरं गृह्य बाणस्य हितकाम्यया।\nज्ञात्वा तमागतं कृष्णं व्यादितास्यमिवान्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2015267, "chapter_id": 1319, "verse_number": "२-६०-२३", "content_sanskrit": "ततस्तौ चक्रतुर्युद्धं वासुदेवमहेश्वरौ।\nतद्युद्धमभवद्घोरमचिन्त्यं रोमहर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2015268, "chapter_id": 1319, "verse_number": "२-६०-२४", "content_sanskrit": "अन्योन्यं तौ ततक्षाते अन्योन्यजयकाङ्क्षिणौ।\nदिव्यान्यस्त्राणि तौ देवौ क्रुद्धौ मुमुचतुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2015269, "chapter_id": 1319, "verse_number": "२-६०-२५", "content_sanskrit": "ततः कृष्णो रणं कृत्वा मुहूर्तं शूलपाणिना।\nविजित्य तं महादेवं ततो युद्धे शूलपाणिना।\nअन्यांश्च जित्वा द्वारस्थान्प्रविवेश पुरोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2015270, "chapter_id": 1319, "verse_number": "२-६०-२६", "content_sanskrit": "प्रविश्य बाणमासाद्य स तत्राथ जनार्दनः।\nचक्रे युद्धं महाक्रुद्धस्तेन बाणेन भरतर्षभ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2015271, "chapter_id": 1319, "verse_number": "२-६०-२७", "content_sanskrit": "बाणोऽपि सर्वशस्त्राणि शितानि भरतर्षभ।\nसुसङ्क्रुद्धस्तदा युद्धे पातयामास केशवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2015272, "chapter_id": 1319, "verse_number": "२-६०-२८", "content_sanskrit": "पुनरुद्यम्य शस्त्राणि सहस्रं सर्वबाहुभिः।\nमुमोच बाणः सङ्क्रुद्धः कृष्णं प्रति रणाजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2015273, "chapter_id": 1319, "verse_number": "२-६०-२९", "content_sanskrit": "ततः कृष्णस्तदा कृत्त्वा तानि सर्वाणि भारत।\nकृत्त्वा मुहूर्तं बाणेन युद्धं राजन्नगोक्षजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2015274, "chapter_id": 1319, "verse_number": "२-६०-३०", "content_sanskrit": "चक्रमुद्यम्य रोषाद्वै दिव्यं शस्त्रोत्तमं ततः।\nसहस्रबाहूंश्चिच्छेद बाणस्यामिततेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2015275, "chapter_id": 1319, "verse_number": "२-६०-३१", "content_sanskrit": "ततो बाणो महाराज कृष्णेन भृशपीडितः।\nभिन्नबाहुः पपाताशु विशाख इव पादपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2015276, "chapter_id": 1319, "verse_number": "२-६०-३२", "content_sanskrit": "स पातयित्वा बाणैस्तं बाणं कृष्णस्त्वरान्वितः।\nप्राद्युम्निं मोचयामास क्षिप्रं राजगृहात्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2015277, "chapter_id": 1319, "verse_number": "२-६०-३३", "content_sanskrit": "मोक्षयित्वाऽथ गोविन्दः प्राद्युम्निं सह भार्यया।\nबाणस्य सर्वरत्नानि असङ्ख्यानि जहार सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2015278, "chapter_id": 1319, "verse_number": "२-६०-३४", "content_sanskrit": "गोधनानि च सर्वस्वं स बाणस्यालये बलात्।\nजहार च हृषीकेशो यदूनां कुलवर्धनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2015279, "chapter_id": 1319, "verse_number": "२-६०-३५", "content_sanskrit": "ततः स सर्वरत्नानि चाहृत्य मधुसूदनः।\nक्षिप्रमारोपयाञ्चक्रे सर्वस्वं गरुडोपरि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2015280, "chapter_id": 1319, "verse_number": "२-६०-३६", "content_sanskrit": "त्वरयाऽथ स कौन्तेय बलदेवं महाबलम्।\nप्रादुम्निं च महावीर्यमनिरुद्धं महाद्युतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2015281, "chapter_id": 1319, "verse_number": "२-६०-३७", "content_sanskrit": "उषां च सुन्दरीं राजन्भृत्यदारगणैः सह।\nसर्वानेतान्समारोप्य गरुडोपरि वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2015282, "chapter_id": 1319, "verse_number": "२-६०-३८", "content_sanskrit": "मुदा युक्तो महातेजाः पीताम्बरधरो बली।\nदिव्याभरमचित्राङ्गः शङ्कचक्रगदासिभृत्। २-६०-३८ca आरुरोह गरुत्मन्तमुदयं भास्करो यथा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2015283, "chapter_id": 1319, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अर्घाहरणपर्वणि षष्टितमोऽध्यायः॥ ६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]