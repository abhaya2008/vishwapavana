[{"id": 2090548, "chapter_id": 2924, "verse_number": "१३-५४-१", "content_sanskrit": "`युधिष्ठिर उवाच।\nपुत्रैः कथं महाराज पुरुषस्तारितो भवेत्।\nयावन्न लब्धवान्पुत्रमफलः पुरुषो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2090549, "chapter_id": 2924, "verse_number": "१३-५४-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2090550, "chapter_id": 2924, "verse_number": "१३-५४-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nनारदेन पुरा गीतं मार्कण्डेयाय पृच्छते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2090551, "chapter_id": 2924, "verse_number": "१३-५४-३", "content_sanskrit": "पर्वतं नारदं चैव असितं देवलं च तम्।\nआरुणेयं च रैभ्यं च एतानत्रागतान्पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2090552, "chapter_id": 2924, "verse_number": "१३-५४-४", "content_sanskrit": "गङ्गायमुनयोर्मध्ये भोगवत्याः समागमे।\nदृष्ट्वा पूर्वं समासीनान्मार्कण्डेयोऽभ्यगच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2090553, "chapter_id": 2924, "verse_number": "१३-५४-५", "content_sanskrit": "ऋषयस्तु मुनिं दृष्ट्वा समुत्थायोन्मुखाः स्थिताः।\nअर्चयित्वाऽर्हतो विप्रं किं कुर्म इति चाब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2090554, "chapter_id": 2924, "verse_number": "१३-५४-६x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2090555, "chapter_id": 2924, "verse_number": "१३-५४-६", "content_sanskrit": "अयं समागमः सद्भिर्यत्नेनासादितो मया।\nअत्र प्राप्स्यामि धर्माणामाचारस्य च निश्चयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2090556, "chapter_id": 2924, "verse_number": "१३-५४-७", "content_sanskrit": "ऋजुः कृतयुगे धर्मस्तस्मिन्क्षीणे विमुह्यति।\nयुगेयुगे महर्षिभ्यो धर्ममिच्छामि वेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2090557, "chapter_id": 2924, "verse_number": "१३-५४-८", "content_sanskrit": "ऋषिभिर्नारदः प्रोक्तो ब्रूहि यत्रास्य संशयः।\nधर्माधर्मेषु तत्वज्ञ त्वं हि च्छेत्ता हि संशयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2090558, "chapter_id": 2924, "verse_number": "१३-५४-९", "content_sanskrit": "ऋषिभ्योऽनुमतं वाक्यं नियोगान्नारदस्तदा।\nसर्वधर्मार्थतत्वज्ञं मार्कण़्डेयं ततोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2090559, "chapter_id": 2924, "verse_number": "१३-५४-१०", "content_sanskrit": "दीर्घायो तपसा दीप्त वदेवदाङ्गतत्ववित्।\nयत्र ते संशयो ब्रह्मन्समुत्पन्नः स उच्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2090560, "chapter_id": 2924, "verse_number": "१३-५४-११", "content_sanskrit": "धर्मं लोकोपकारं वा यच्चान्यच्छ्रोतुमिच्छसि।\nतदहं कथयिष्यामि ब्रूहि त्वं सुमहातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2090561, "chapter_id": 2924, "verse_number": "१३-५४-१२x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2090562, "chapter_id": 2924, "verse_number": "१३-५४-१२", "content_sanskrit": "युगेयुगे व्यतीतेऽस्मिन्धर्मसेतुः प्रणश्यति।\nकथं धर्मच्छलेनाहं प्राप्नुयामिति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2090563, "chapter_id": 2924, "verse_number": "१३-५४-१३x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2090564, "chapter_id": 2924, "verse_number": "१३-५४-१३", "content_sanskrit": "आसीद्धर्मः पुरा विप्र चतुष्पादः कृते युगे।\nततो ह्यधर्मः कालेन प्रसूतः किञ्चिदूनतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2090565, "chapter_id": 2924, "verse_number": "१३-५४-१४", "content_sanskrit": "ततस्त्रेतायुगं नाम प्रवृत्तं धर्मदूषणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2090566, "chapter_id": 2924, "verse_number": "१३-५४-१५", "content_sanskrit": "तस्मिन्नतीते सम्प्राप्तं तृतीयं द्वापरं युगम्।\nतदा धर्मस्य द्वौ पादावधर्मो नाशयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2090567, "chapter_id": 2924, "verse_number": "१३-५४-१६", "content_sanskrit": "द्वापरे तु परिक्षीणे नन्दिके समुपस्थिते।\nलोकवृत्तं च धर्मं च उच्यमानं निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2090568, "chapter_id": 2924, "verse_number": "१३-५४-१७", "content_sanskrit": "चतुर्थं नन्दिकं नाम धर्मः पादावशेषितः।\nततः प्रभृति जायन्ते क्षीणप्रज्ञायुपो नराः।\nक्षीणप्राणधना लोके धर्माचारबहिष्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2090569, "chapter_id": 2924, "verse_number": "१३-५४-१८x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2090570, "chapter_id": 2924, "verse_number": "१३-५४-१८", "content_sanskrit": "एवं विलुलिते धर्मे लोके चाधर्मसंयुते।\nचातुर्वर्ण्यस्य नियतं हव्यं कव्यं नियच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2090571, "chapter_id": 2924, "verse_number": "१३-५४-१९x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2090572, "chapter_id": 2924, "verse_number": "१३-५४-१९", "content_sanskrit": "मन्त्रपूतं सदा हव्यं कव्यं चैव न नश्यति।\nप्रतिगृह्णन्ति तद्देवा दातुर्न्यायात्प्रयच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2090573, "chapter_id": 2924, "verse_number": "१३-५४-२०", "content_sanskrit": "सत्वयुक्तं च दाता च सर्वान्कामानवाप्नुयात्।\nअवाप्तकामः स्वर्गे च महीयेत यथेप्सितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2090574, "chapter_id": 2924, "verse_number": "१३-५४-२१x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2090575, "chapter_id": 2924, "verse_number": "१३-५४-२१", "content_sanskrit": "चत्वारो ह्यथ ये वर्णा हव्यं कव्यं प्रदास्यति।\nमन्त्रहीनमपन्यायं तेषां दत्तं क्व गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2090576, "chapter_id": 2924, "verse_number": "१३-५४-२२x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2090577, "chapter_id": 2924, "verse_number": "१३-५४-२२", "content_sanskrit": "असुरान्गच्छते दत्तं विप्रै रक्षांसि क्षत्रियैः।\nवैश्यैः प्रेतानि वै दत्तं शूद्रैर्भूतानि गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2090578, "chapter_id": 2924, "verse_number": "१३-५४-२३x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2090579, "chapter_id": 2924, "verse_number": "१३-५४-२३", "content_sanskrit": "अथ वर्णावरे जाताश्चातुर्वर्ण्योपदेशिनः।\nदास्यन्ति हव्यकव्यानि तेषां दत्तं क्व गच्छति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2090580, "chapter_id": 2924, "verse_number": "१३-५४-२४x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2090581, "chapter_id": 2924, "verse_number": "१३-५४-२४", "content_sanskrit": "वर्णावराणां भूतानां हव्यकव्यप्रदातृणाम्।\nनैव देवा न पितरः प्रतिगृह्णन्ति तत्स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2090582, "chapter_id": 2924, "verse_number": "१३-५४-२५", "content_sanskrit": "यातुधानाः पिशाचाश्च भूता ये चापि नैर्ऋताः।\nतेषां सा विहिता वृत्तिः पितृदैवतनिर्गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2090583, "chapter_id": 2924, "verse_number": "१३-५४-२६", "content_sanskrit": "तेषां सर्वप्रदातॄणां हव्यकव्यं समाहिताः।\nयत्प्रयच्छन्ति विधइवत्तद्वै भुञ्जन्ति देवताः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2090584, "chapter_id": 2924, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चतुःपश्चाशोऽध्यायः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]