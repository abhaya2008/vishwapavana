[{"id": 7005613000, "chapter_id": 25613, "verse_number": "८६-१", "content_sanskrit": "सुवर्णाचलदानवर्णनम् ।\nअथ पापहरं वक्ष्ये सुवर्णाचलमुत्तमम् ।\nयस्य प्रदानाद्भवनं वैरिञ्च्यं याति मानवः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005613001, "chapter_id": 25613, "verse_number": "८६-२", "content_sanskrit": "उत्तमः पलसाहस्रो मध्यमः पञ्चभिः शतैः ।\nतदर्द्धेनाधमस्तद्वदल्पवित्तोऽपि शक्तितः ।\nदद्यादेकपलादूद्‌र्ध्वं यथाशक्या विमत्सरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005613002, "chapter_id": 25613, "verse_number": "८६-३", "content_sanskrit": "धान्यपर्वतवत्सर्वं विदध्यान्मुनिपुङ्गवः ।\nविष्कम्भशैलांस्तद्वच्च ऋत्विग्‌भ्यः प्रतिपादयेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005613003, "chapter_id": 25613, "verse_number": "८६-४", "content_sanskrit": "नमस्ते ब्रह्म बीजाय ब्रह्मगर्भाय ते नमः ।\nयस्मादनन्तफलदस्तस्मात्पाहि नगोत्तम ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005613004, "chapter_id": 25613, "verse_number": "८६-५", "content_sanskrit": "यस्मादग्नेरपत्यं त्वं यस्मात् पुण्यं जगत्पते ।\nहेमपर्वतरूपेण तस्मात्पाहि नगोत्तम ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005613005, "chapter_id": 25613, "verse_number": "८६-६", "content_sanskrit": "अनेन विधिना यस्तु दद्यात् कनकपर्वतम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005613006, "chapter_id": 25613, "verse_number": "८६-७", "content_sanskrit": "स याति परमं ब्रह्म लोकमानन्दकारकम् ।\nतत्र कल्पशतं तिष्ठेत् ततो याति पराङ्गतिम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]