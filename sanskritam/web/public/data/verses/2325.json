[{"id": 2062145, "chapter_id": 2325, "verse_number": "८-४६-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2062146, "chapter_id": 2325, "verse_number": "८-४६-१", "content_sanskrit": "सुदुष्करमिदं कर्म कृतं भीमेन सञ्जय।\nयेन कर्णो महाबाहू रथोपस्थे निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2062147, "chapter_id": 2325, "verse_number": "८-४६-२", "content_sanskrit": "कर्णो ह्येको रणे हन्ता पाण्डवान्सृञ्जयैः सह।\nइति दुर्योधनः सूत प्राब्रवीन्मां मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2062148, "chapter_id": 2325, "verse_number": "८-४६-३", "content_sanskrit": "पराजितं तु राधेयं दृष्ट्वा भीमेन संयुगे।\nततः परं किमकरोत्पुत्रो दुर्योधनो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2062149, "chapter_id": 2325, "verse_number": "८-४६-४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2062150, "chapter_id": 2325, "verse_number": "८-४६-४", "content_sanskrit": "विमुखं प्रेक्ष्य राधेयं सूतपुत्रं महाहवे।\nपुत्रस्तव महाराज सोदर्यानिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2062151, "chapter_id": 2325, "verse_number": "८-४६-५", "content_sanskrit": "शीघ्रं गच्छत भद्रं वो राधेयं परिरक्षत।\nभीमसेनभयेऽगाधे म़ज्जन्तं व्यसनार्णवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2062152, "chapter_id": 2325, "verse_number": "८-४६-६", "content_sanskrit": "ते तु राज्ञा समादिष्टा भीमसेनं जिघांसवः।\nअभ्यवर्तन्त सङ्क्रुद्धाः पतङ्गाः पावकं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2062153, "chapter_id": 2325, "verse_number": "८-४६-७", "content_sanskrit": "श्रुतायुर्दुर्धरः क्राथो विवित्सुर्विकटः समः।\nनिषङ्गी कवची पाशी तथा नन्दोपनन्दकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2062154, "chapter_id": 2325, "verse_number": "८-४६-८", "content_sanskrit": "दुष्प्रधर्षः सुबाहुश्च वातवेगसुवर्चसौ।\nधनुर्ग्राहो दुर्मदश्च जलसन्धः शलः सहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2062155, "chapter_id": 2325, "verse_number": "८-४६-९", "content_sanskrit": "एते रथैः परिवृता वीर्यवन्तो महाबलाः।\nभीमसेनं समासाद्य समन्तात्पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2062156, "chapter_id": 2325, "verse_number": "८-४६-१०", "content_sanskrit": "ते व्यमुञ्चञ्छरव्रातान्नानालिङ्गान्समन्ततः।\nस तैरभ्यर्द्यमानस्तु भीमसेनो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2062157, "chapter_id": 2325, "verse_number": "८-४६-११", "content_sanskrit": "तेषामापततां क्षिप्रं सुतानां ते जनाधिप।\nरथैः पञ्चशतैः सार्धं पञ्चाशदहनद्रथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2062158, "chapter_id": 2325, "verse_number": "८-४६-१२", "content_sanskrit": "विवित्सोस्तु ततः क्रुद्धो भल्लेनापाहरच्छिरः।\nभीमसेनो महाराज तत्पपात हतं भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2062159, "chapter_id": 2325, "verse_number": "८-४६-१३", "content_sanskrit": "सकुण्डलशिरस्त्राणं पूर्णचन्द्रोपमं तथा।\n`अशोभत महाराज पूर्णचन्द्र इवाम्बरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2062160, "chapter_id": 2325, "verse_number": "८-४६-१४", "content_sanskrit": "तं दृष्ट्वा निहतं शूरं भ्रातरः सर्वतस्तदा।\nअभ्यद्रवन्त समरे भीमं भीमपराक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2062161, "chapter_id": 2325, "verse_number": "८-४६-१५", "content_sanskrit": "ततोऽपराभ्यां भल्लाभ्यां पुत्रयोस्ते महाहवे।\nजहार समरे प्राणान्भीमो भीमपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2062162, "chapter_id": 2325, "verse_number": "८-४६-१६", "content_sanskrit": "तौ धरामन्वपद्येतां वातरुग्णाविव द्रुमौ।\nविकटश्च सहश्चोमौ देवपुत्रोपमौ नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2062163, "chapter_id": 2325, "verse_number": "८-४६-१७", "content_sanskrit": "ततस्तु त्वरितो भीमः क्राथं निन्ये यमक्षयम्।\nनाराचेन सुतीक्ष्णेन स हतो न्यपतद्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2062164, "chapter_id": 2325, "verse_number": "८-४६-१८", "content_sanskrit": "हाहाकारस्ततस्तीव्रः सम्बभूव जनेश्वर।\nवध्यमानेषु वीरेषु तव पुत्रेषु धन्विषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2062165, "chapter_id": 2325, "verse_number": "८-४६-१९", "content_sanskrit": "तेषां सुलुलिते सैन्ये पुनर्भीमो महाबलः।\nनन्दोपनन्दौ समरे प्रैषयद्यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2062166, "chapter_id": 2325, "verse_number": "८-४६-२०", "content_sanskrit": "ततस्ते प्राद्रवन्भीताः पुत्रास्ते विह्वलीकृताः।\nभीमसेनं रणे दृष्ट्वा कालान्तकयमोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2062167, "chapter_id": 2325, "verse_number": "८-४६-२१", "content_sanskrit": "पुत्रांस्ते निहतान्दृष्ट्वा सूतपुत्रः सुदुर्मनाः।\nहंसवर्णान्हयान्भूयः प्रैषयद्यत्र पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2062168, "chapter_id": 2325, "verse_number": "८-४६-२२", "content_sanskrit": "ते प्रेषिता महाराज मद्रराजेन वाजिनः।\nभीमसेनरथं प्राप्य समसज्जन्त वेगिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2062169, "chapter_id": 2325, "verse_number": "८-४६-२३", "content_sanskrit": "स सन्निपातस्तुमुलो घोररूपो विशाम्पते।\nआसीद्रौद्रो महाराज कर्णपाण्डवयोर्मृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2062170, "chapter_id": 2325, "verse_number": "८-४६-२४", "content_sanskrit": "दृष्ट्वा मम महाराज तौ समेतौ महारथौ।\nआसीद्बुद्विः कथं युद्वमेतदद्य भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2062171, "chapter_id": 2325, "verse_number": "८-४६-२५", "content_sanskrit": "ततो भीमो रणश्लाघी छादयामास पत्रिभिः।\nकर्णं रणे महाराज पुत्राणां तव पश्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2062172, "chapter_id": 2325, "verse_number": "८-४६-२६", "content_sanskrit": "ततः कर्णो भृशं क्रुद्धो भीमं नवभिरायसैः।\nविव्याध परमास्त्रज्ञो भल्लैः सन्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2062173, "chapter_id": 2325, "verse_number": "८-४६-२७", "content_sanskrit": "तान्निहत्य महाबाहुर्भीमो भीमपराक्रमः।\nआकर्णपूर्णैर्विशिखैः कर्णं विव्याध सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2062174, "chapter_id": 2325, "verse_number": "८-४६-२८", "content_sanskrit": "ततः कर्णो महाराज आशीविष इव श्वसन्।\nशरवर्षेण महता छादयामास पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2062175, "chapter_id": 2325, "verse_number": "८-४६-२९", "content_sanskrit": "भीमोऽपि ततं शरव्रातैश्छादयित्वा महारथम्।\nपश्यतां कौरवेयाणां विननर्द महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2062176, "chapter_id": 2325, "verse_number": "८-४६-३०", "content_sanskrit": "ततः कर्णो भृशं क्रुद्धो दृढमादाय कार्मुकम्।\nभीमं विव्याध दशभिः कङ्कपत्रैः शिलाशितैः।\nकार्मुकं चास्य चिच्छेद भल्लेन निशितेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2062177, "chapter_id": 2325, "verse_number": "८-४६-३१", "content_sanskrit": "ततो भीमो महाबाहुर्हेमपट्टविभूषितम्।\nपरिघं घोरमादाय मृतत्युदण्डमिवापरम्।\nकर्णस्य निधनाकाङ्क्षी चिक्षेपातिबलो नदन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2062178, "chapter_id": 2325, "verse_number": "८-४६-३२", "content_sanskrit": "तमापतन्तं परिघं वज्राशनिसमस्वनम्।\nचिच्छेद बहुधा कर्णः शरैराशीविषोपमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2062179, "chapter_id": 2325, "verse_number": "८-४६-३३", "content_sanskrit": "ततः कार्मुकमादाय भीमो दृढतरं तदा।\nछादयामास विशिखैः कर्णं परबलार्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2062180, "chapter_id": 2325, "verse_number": "८-४६-३४", "content_sanskrit": "ततो युद्धमभूद्धोरं कर्णपाण्डवयोर्मृधे।\nबलीन्द्रयोरिव मुहुः परस्परवधैषिणोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2062181, "chapter_id": 2325, "verse_number": "८-४६-३५", "content_sanskrit": "ततः कर्णो महाराज भीमसेनं त्रिभिः शरैः।\nआकर्णपूर्णैर्विव्याध दृढमानम्य कार्मुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2062182, "chapter_id": 2325, "verse_number": "८-४६-३६", "content_sanskrit": "सोऽतिविद्धो महेष्वासः कर्णेन बलिनां वरः।\nघोरमादत्त विशिखं कर्णकायावदारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2062183, "chapter_id": 2325, "verse_number": "८-४६-३७", "content_sanskrit": "तस्य भित्त्वा तनुत्राणं भित्त्वा कायं च सायकः।\nप्राविशद्वरणीं राजन्वल्मीकमिव पन्नगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2062184, "chapter_id": 2325, "verse_number": "८-४६-३८", "content_sanskrit": "स तेनातिप्रहारेण व्यथितो विह्वलन्निव॥\nसञ्चचाल रथे कर्णः क्षितिकम्पे यथाऽचलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2062185, "chapter_id": 2325, "verse_number": "८-४६-३९", "content_sanskrit": "ततः कर्णो महाराज रोषामर्षसमन्वितः।\nभीमं तं पञ्चविंशत्या नाराचानां समार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2062186, "chapter_id": 2325, "verse_number": "८-४६-४०", "content_sanskrit": "चिच्छेद कार्मुकं तूर्णं पाण्डवस्याशु पत्रिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2062187, "chapter_id": 2325, "verse_number": "८-४६-४१", "content_sanskrit": "तततो मुहूर्ताद्राजेन्द्र नातिकृच्छ्राद्वसन्निव।\nविरथं भीमकर्माणं भीमं कर्णश्चकार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2062188, "chapter_id": 2325, "verse_number": "८-४६-४२", "content_sanskrit": "विरथो भरतश्रेष्ठ प्रहसन्ननिलोपमः।\nगदां गृह्य महाबाहुरपतत्स्यन्दनोत्तमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2062189, "chapter_id": 2325, "verse_number": "८-४६-४३", "content_sanskrit": "गदया च महाराज कर्णस्य रथकूबरम्।\nपोथयामास सङ्क्रुद्धः समरे शत्रुतापनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2062190, "chapter_id": 2325, "verse_number": "८-४६-४४", "content_sanskrit": "स क्रोधवशमापन्नः पाण्डुपुत्रः प्रतापवान्।\nविद्राव्य गदया वीरस्तव पुत्रान्महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2062191, "chapter_id": 2325, "verse_number": "८-४६-४५", "content_sanskrit": "नागान्सप्तशतान्राजन्नीषादन्तान्प्रहारिणः।\nव्यधमत्सहसा भीमः क्रुद्धरूपः परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2062192, "chapter_id": 2325, "verse_number": "८-४६-४६", "content_sanskrit": "दन्तवेष्टेषु नेत्रेषु कुम्भेषु च कटेषु च।\nमर्मस्वपि च मर्मज्ञस्तान्नागानवधीद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2062193, "chapter_id": 2325, "verse_number": "८-४६-४७", "content_sanskrit": "`अर्दिता भीमसेनेन विनदन्तो भृशातुराः।\nततस्ते प्राद्रवन्भीताः प्रहताश्च पुनःपुनः।\nमहामात्रास्तमावव्रुर्मेघा इव दिवाकरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2062194, "chapter_id": 2325, "verse_number": "८-४६-४८", "content_sanskrit": "तान्स सप्तशतान्नागान्सारोहायुधकेतनान्।\nभूमिष्ठो गदया जघ्ने वज्रेणेन्द्र इवाचलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2062195, "chapter_id": 2325, "verse_number": "८-४६-४९", "content_sanskrit": "ततः सुबलपुत्रस्य नागानतिबलान्पुनः।\nपोथयामास कौन्तेयो द्विपञ्चाशदरिन्दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2062196, "chapter_id": 2325, "verse_number": "८-४६-५०", "content_sanskrit": "तथा रथशततं साग्रं पत्तींश्च शतशोऽपरान्।\nन्यहनत्पाण्डवो युद्धे तापयंस्तव वाहिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2062197, "chapter_id": 2325, "verse_number": "८-४६-५१", "content_sanskrit": "प्रताप्यमानं सूर्येण भीमेन च महात्मना।\nतव सैन्यं सञ्चुकोच चर्माग्नावाहितं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2062198, "chapter_id": 2325, "verse_number": "८-४६-५२", "content_sanskrit": "ते भीमभयसन्त्रस्तास्तावका भरतर्षभ।\nविहाय समरे कर्णं दुद्रुवुर्वै दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2062199, "chapter_id": 2325, "verse_number": "८-४६-५३", "content_sanskrit": "रथाः पञ्चशताश्चान्ये हादिनः शरवर्षिणः।\nभीममभ्यद्रवन्घ्नन्तः शरपूगैः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2062200, "chapter_id": 2325, "verse_number": "८-४६-५४", "content_sanskrit": "तान्स पञ्चशतान्वीरान्सपताकध्वजायुधान्।\nपोथयामास गदया भीमो विष्णुरिवासुरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2062201, "chapter_id": 2325, "verse_number": "८-४६-५५", "content_sanskrit": "ततः शकुनिनिर्दिष्टाः सादिनः शूरसम्मताः।\nत्रिसाहस्राण्यभिययुः शरशक्त्यृष्टिपाणयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2062202, "chapter_id": 2325, "verse_number": "८-४६-५६", "content_sanskrit": "तान्प्रत्युद्गम्य यवनान्साश्वारोहांस्तदाऽरिहा।\nविविधान्विचरन्मार्गान्गदया समपोथयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2062203, "chapter_id": 2325, "verse_number": "८-४६-५७", "content_sanskrit": "तेषामासीन्महाञ्छब्दस्ताडितानां च सर्वशः।\nअग्निभिर्दह्यमानानां नलानामिव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2062204, "chapter_id": 2325, "verse_number": "८-४६-५८", "content_sanskrit": "एवं सुबलपुत्रस्य त्रिसाहस्रान्हयोत्तमान्।\nहत्वाऽन्यं रथमास्थाय क्रुद्धो राधेयमभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2062205, "chapter_id": 2325, "verse_number": "८-४६-५९", "content_sanskrit": "कर्णोऽपि समरे राजन्धर्मपुत्रमरिन्दमम्।\nस शरैश्छादयामास सारथिं चाप्यपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2062206, "chapter_id": 2325, "verse_number": "८-४६-६०", "content_sanskrit": "ततः स प्रद्रुतं सैन्यं दृष्ट्वा कर्णो महारथः।\nअन्वधावत्किरन्बाणैः कङ्कपत्रैरजिह्मगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2062207, "chapter_id": 2325, "verse_number": "८-४६-६१", "content_sanskrit": "राजानमभिधावन्तं शरैरावृत्य रोदसी।\nक्रुद्धः प्रच्छादयामास शरजालेन मारुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2062208, "chapter_id": 2325, "verse_number": "८-४६-६२", "content_sanskrit": "सन्निवृत्तस्ततस्तूर्णं राधेयः शत्रुकर्शनः।\nभीमं प्रच्छादयामास समन्तान्निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2062209, "chapter_id": 2325, "verse_number": "८-४६-६३", "content_sanskrit": "भीमसेनरथप्रेप्सुं कर्णं भारत सात्यकिः।\nअभ्यर्दयदमेयात्मा पार्ष्णिग्रहणकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2062210, "chapter_id": 2325, "verse_number": "८-४६-६४", "content_sanskrit": "भीमसेनरथप्रेप्सुं कर्णो भारत सात्यकिम्।\nअभ्यवर्तत शैनेयमर्दयञ्छरवृष्टिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2062211, "chapter_id": 2325, "verse_number": "८-४६-६५", "content_sanskrit": "तावन्योन्यं समासाद्य वृषभौ सर्वधन्विनाम्।\nविसृजन्तौ शरान्दीप्तान्विभ्राजेतां मनस्विनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2062212, "chapter_id": 2325, "verse_number": "८-४६-६६", "content_sanskrit": "ताभ्यां वियति राजेन्द्र विततततं भीमदर्शनम्।\nकौञ्चपृष्ठारुणं रौद्रं बाणजालं व्यदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2062213, "chapter_id": 2325, "verse_number": "८-४६-६७", "content_sanskrit": "नैव सूर्यप्रभा राजन्न दिशः प्रदिशस्तथा।\nप्राज्ञासिष्म वयं ते वा शरैर्मुक्तैः सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2062214, "chapter_id": 2325, "verse_number": "८-४६-६८", "content_sanskrit": "मध्याह्ने तपतो राजन्भास्करस्य महाप्रभाः।\nहृताः सर्वाः शरौघैस्तैः कर्णमाधवयोस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2062215, "chapter_id": 2325, "verse_number": "८-४६-६९", "content_sanskrit": "सौबलं कृतवर्माणं द्रौणिमाधिरथिं कृपम्।\nसंसक्तान्पाण्डवैर्दृष्ट्वा निवृत्ताः कुरवः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2062216, "chapter_id": 2325, "verse_number": "८-४६-७०", "content_sanskrit": "तेषामापततां शब्दस्तीत्र आसीद्विशाम्पते।\nउद्वृत्तानां यथा वृष्ट्या सागराणां भयावहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2062217, "chapter_id": 2325, "verse_number": "८-४६-७१", "content_sanskrit": "ते सेने भृशसंसक्ते दृष्ट्वाऽन्योन्यं महाहवे।\nहर्षेण महता युक्ते परिगृह्य परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2062218, "chapter_id": 2325, "verse_number": "८-४६-७२", "content_sanskrit": "ततः प्रववृते युद्धं मध्यं प्राप्ते दिवाकरे।\nयादृशं नैवमस्माभिर्दृष्टपूर्वं न च श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2062219, "chapter_id": 2325, "verse_number": "८-४६-७३", "content_sanskrit": "बलौघस्तु समासाद्य बलौघं सहसा रणे।\nउपसर्पत वेगेन वार्योघ इव सागरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2062220, "chapter_id": 2325, "verse_number": "८-४६-७४", "content_sanskrit": "आसीन्निनादः सुमहान्बाणौघानां परस्परम्।\nगर्जतां सागरौघाणां यथा स्यान्निःस्वनो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2062221, "chapter_id": 2325, "verse_number": "८-४६-७५", "content_sanskrit": "ते तु सेने समासाद्य वेगवत्यौ परस्परम्।\nएकीभावमनुप्राप्ते नद्याविव समागमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2062222, "chapter_id": 2325, "verse_number": "८-४६-७६", "content_sanskrit": "ततः प्रववृते युद्धं घोररूपं विशाम्पते।\nकुरूणां पाण्डवानां च लिप्सतां सुमहद्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2062223, "chapter_id": 2325, "verse_number": "८-४६-७७", "content_sanskrit": "शूराणां गर्जतां तत्र ह्यविच्छेदकृता गिरः।\nश्रुयन्ते विविधा राजन्नामान्युद्दिश्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2062224, "chapter_id": 2325, "verse_number": "८-४६-७८", "content_sanskrit": "यस्य यद्धि रणे व्यङ्गं पितृतो मातृतोऽपि वा।\nकर्मतः शीलतो वाऽपि स तच्छ्रावयते युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2062225, "chapter_id": 2325, "verse_number": "८-४६-७९", "content_sanskrit": "तान्दृष्ट्वा समरे शूशांस्तर्जमानान्परस्परम्।\nअभवन्मे मती राजन्नैषामस्तीति जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2062226, "chapter_id": 2325, "verse_number": "८-४६-८०", "content_sanskrit": "तेषां दृष्ट्वा तु क्रुद्धानां वपूंष्यमिततेजसाम्।\nअभवन्मे भयं तीव्रं कथमेतद्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2062227, "chapter_id": 2325, "verse_number": "८-४६-८१", "content_sanskrit": "ततस्ते पाण्डवा राजन्कौरवाश्च महारथाः।\nततक्षुः सायकैस्तूर्णमन्योन्यं विजयैषिणः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2062228, "chapter_id": 2325, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे षट्चत्वारिंशोऽध्यायः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}]