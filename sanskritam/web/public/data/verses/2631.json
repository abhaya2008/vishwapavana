[{"id": 2076776, "chapter_id": 2631, "verse_number": "१२-१३६-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2076777, "chapter_id": 2631, "verse_number": "१२-१३६-१", "content_sanskrit": "अत्र गाथा ब्रह्मगीताः कीर्तयन्ति पुराविदः।\nयेन मार्गेण राजानः कोशं संजनयन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2076778, "chapter_id": 2631, "verse_number": "१२-१३६-२", "content_sanskrit": "न धनं यज्ञशीलानां हार्यं देवस्वमेव च।\nदस्यूनां निष्क्रियाणां च क्षत्रियो हर्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2076779, "chapter_id": 2631, "verse_number": "१२-१३६-३", "content_sanskrit": "इमाः प्रजाः क्षत्रियाणां रक्ष्या हन्याश्च भारत।\nथनं हि क्षत्रियस्येह द्वितीयस्य न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2076780, "chapter_id": 2631, "verse_number": "१२-१३६-४", "content_sanskrit": "तदस्य स्याद्बलार्थं वा धनं यज्ञार्थमेव वा।\nअभोज्याश्चौषधीश्छित्त्वा भोज्या एव पचन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2076781, "chapter_id": 2631, "verse_number": "१२-१३६-५", "content_sanskrit": "यो वै न देवान्न पितृन्न मर्त्यान्हविषाऽर्चति।\nअनर्थकं धनं तत्र प्राहुर्धमेविदो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2076782, "chapter_id": 2631, "verse_number": "१२-१३६-६", "content_sanskrit": "हरेत्तद्द्रविणं राजन्धार्मिकः पृथिवीतिः।\nन हि न प्रीणयेल्लोकान्न लोके गर्हते नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2076783, "chapter_id": 2631, "verse_number": "१२-१३६-७", "content_sanskrit": "असाधुभ्योऽर्थमादाय साधुभ्यो यः प्रयच्छति।\nआत्मानं संक्रमं कृत्वा मन्ये धर्मविदेव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2076784, "chapter_id": 2631, "verse_number": "१२-१३६-८", "content_sanskrit": "[तथातथा जयेल्लोकाञ्शक्त्या चैव यथायथा।]\nऔद्भिदा जन्तवो यद्वच्छ्रुत्वा वाजो यथातथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2076785, "chapter_id": 2631, "verse_number": "१२-१३६-९", "content_sanskrit": "अनिमित्तात्संभवन्ति तथा यज्ञः प्रजायते।\nयथैव दंशमशकं यथा कीटपिपीलिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2076786, "chapter_id": 2631, "verse_number": "१२-१३६-१०", "content_sanskrit": "सैव वृत्तिर्हि यज्ञेषु यथा धर्मो विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2076787, "chapter_id": 2631, "verse_number": "१२-१३६-११", "content_sanskrit": "यथा ह्यकस्माद्भवति भूमौ पांसुस्तृणोलपम्।\nतथैवेह भवेद्धर्मः सूक्ष्मः सूक्ष्मतरः स्मृतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2076788, "chapter_id": 2631, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि षट्त्रिंशदधिकशततमोऽध्यायः॥ १३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]