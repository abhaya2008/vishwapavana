[{"id": 2041740, "chapter_id": 1929, "verse_number": "५-१७४-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2041741, "chapter_id": 1929, "verse_number": "५-१७४-१", "content_sanskrit": "ततोऽहं भरतश्रेष्ठ मातरं वीरमातरम् ।\nअभिगम्योपसंगृह्य दाशेयीमिदमब्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2041742, "chapter_id": 1929, "verse_number": "५-१७४-२", "content_sanskrit": "इमाः काशिपतेः कन्या मया निर्जित्य पार्थिवान् ।\nविचित्रवीर्यस्य कृते वीर्यशुल्का हृता इति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2041743, "chapter_id": 1929, "verse_number": "५-१७४-३", "content_sanskrit": "ततो मूर्धन्युपाघ्राय पर्यश्रुनयना नृप।\nआह सत्यवती हृष्टा दिष्ट्या पुत्र जितं त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2041744, "chapter_id": 1929, "verse_number": "५-१७४-४", "content_sanskrit": "सत्यवत्यास्त्वनुमते विवाहे समुपस्थिते।\nउवाच वाक्यं सव्रीडा ज्येष्ठा काशिपतेः सुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2041745, "chapter_id": 1929, "verse_number": "५-१७४-५", "content_sanskrit": "भीष्म त्वमसि धर्मज्ञः सर्वशास्त्रविशारदः ।\nश्रुत्वा च वचनं धर्म्यं मह्यं कर्तुमिहार्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2041746, "chapter_id": 1929, "verse_number": "५-१७४-६", "content_sanskrit": "मया साल्वपत्तिः पूर्वं मनसाऽभिवृतो वरः।\nतेन चास्मि वृता पूर्वं रहस्यविदिते पितुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2041747, "chapter_id": 1929, "verse_number": "५-१७४-७", "content_sanskrit": "कथं मामन्यकामां त्वं राजधर्ममतीत्य वै ।\nवासयेथा गृहे भीष्म कौरवः सन्विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2041748, "chapter_id": 1929, "verse_number": "५-१७४-८", "content_sanskrit": "एतद्बुद्ध्या विनिश्चित्य मनसा भरतर्षभ ।\nयत्क्षमं ते महाबाहो तदिहारब्धुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2041749, "chapter_id": 1929, "verse_number": "५-१७४-९", "content_sanskrit": "स मां प्रतीक्षते व्यक्तं साल्वराजो विशांपते ।\nतस्मान्मां त्वं कुरुश्रेष्ठ समनुज्ञातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2041750, "chapter_id": 1929, "verse_number": "५-१७४-१०", "content_sanskrit": "कृपां कुरु महाबाहो मयि धर्मभृतां वर।\nत्वं हि सत्यव्रतो वीर पृथिव्यामिति नः श्रुतम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2041751, "chapter_id": 1929, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि अम्बोपाख्यनपर्वणि चतुःसप्तत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]