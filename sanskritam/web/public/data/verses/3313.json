[{"id": 2106527, "chapter_id": 3313, "verse_number": "१७-१-१", "content_sanskrit": "श्रीवेदव्यासाय नमः।\nनारायणं नमस्कृत्य नरं चैव नरोत्तमम्।\nदेवीं सरस्वतीं व्यासं ततो जयमुदीरयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2106528, "chapter_id": 3313, "verse_number": "१७-१-१x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2106529, "chapter_id": 3313, "verse_number": "१७-१-१", "content_sanskrit": "एवं वृष्ण्यन्धककुले श्रुत्वा मौसलमाहवम्।\nपाण्डवाः किमकुर्वन्त तथा कृष्णे दिवं गते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2106530, "chapter_id": 3313, "verse_number": "१७-१-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2106531, "chapter_id": 3313, "verse_number": "१७-१-२", "content_sanskrit": "श्रुत्वैवं कौरवो राजा वृष्णीनां कदनं महत्।\nप्रस्थाने मतिमाधाय वाक्यमर्जुनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2106532, "chapter_id": 3313, "verse_number": "१७-१-३", "content_sanskrit": "कालः पचति भतानि सर्वाण्येव महामते।\nकालपाशमहं मन्ये त्वमपि द्रष्टुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2106533, "chapter_id": 3313, "verse_number": "१७-१-४", "content_sanskrit": "इत्युक्तः स तु कौन्तेयः कालः काल इति ब्रुवन्।\nअन्वपद्यत तद्वाक्यं भ्रातुर्ज्येष्ठस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2106534, "chapter_id": 3313, "verse_number": "१७-१-५", "content_sanskrit": "अर्जुनस्य मतं ज्ञात्वा भीमसेनो यमौ तथा।\nअन्वपद्यन्त तद्वाक्यं यदुक्तं सव्यसाचिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2106535, "chapter_id": 3313, "verse_number": "१७-१-६", "content_sanskrit": "ततो युयुत्सुमानाय्य प्रव्रजन्धर्मकाम्यया।\nराज्यं परिददौ सर्वं वैश्यापुत्रे युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2106536, "chapter_id": 3313, "verse_number": "१७-१-७", "content_sanskrit": "अभिंषिच्य स्वराज्ये च राजानं च परिक्षितम्।\nदुःखार्तश्चाब्रवीद्राजा सुभद्रां पाण्डवाग्रजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2106537, "chapter_id": 3313, "verse_number": "१७-१-८", "content_sanskrit": "एष पुत्रस्य पुत्रस्ते कुरुराजो भविष्यति।\nयदूनां परिशेषश्च वज्रो राजा कृतश्च ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2106538, "chapter_id": 3313, "verse_number": "१७-१-९", "content_sanskrit": "परिक्षिद्धास्तिनपुरे शक्रप्रस्थे च यादवः।\nवज्रो राजा त्वया रक्ष्यो मा चाधर्मे मनः कृथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2106539, "chapter_id": 3313, "verse_number": "१७-१-१०", "content_sanskrit": "इत्युक्त्वा धर्मराजाः स वासुदेवस्य धीमतः।\nमातुलस्य च वृद्धस्य रामदीनां तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2106540, "chapter_id": 3313, "verse_number": "१७-१-११", "content_sanskrit": "भ्रातृभिः सह धर्मात्मा कृत्वोदकमतन्द्रितः।\nश्राद्धान्यद्दिश्य सर्वेषां चकार विदिवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2106541, "chapter_id": 3313, "verse_number": "१७-१-१२", "content_sanskrit": "द्वैपायनं नारदं च मार्कण्डेयं तपोधनम्।\nभारद्वाजं याज्ञवल्क्यं हरिमुद्दिश्य यत्नवान्।\nअभोजयत्स्वादु भोज्यं कीर्तयित्वा च शार्ङ्गिणं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2106542, "chapter_id": 3313, "verse_number": "१७-१-१३", "content_sanskrit": "ददौ रत्नानि वासांसि ग्रामानश्वान्रथांस्तथा।\nस्त्रियश्च द्विजमुख्येभ्यस्तदा शतसहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2106543, "chapter_id": 3313, "verse_number": "१७-१-१४", "content_sanskrit": "कृपमभ्यर्च्य च गुरुमथ पौरपुरस्कृतम्।\n`आहूय भरतश्रेष्ठ संनिवेश्यासने तदा।\nशिष्यं परिक्षितं तस्मै तदौ भरतसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2106544, "chapter_id": 3313, "verse_number": "१७-१-१५", "content_sanskrit": "ततस्तु प्रकृतीः सर्वाः समानाय्य युधिष्ठिरः।\nसर्वमाचष्ट राजर्षिकीर्षितमथात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2106545, "chapter_id": 3313, "verse_number": "१७-१-१६", "content_sanskrit": "ते श्रुत्वैव वचस्तस्य पौरजानपदा जनाः।\nभृशमुद्विग्रमनसो नाभ्यनन्दन्त तद्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2106546, "chapter_id": 3313, "verse_number": "१७-१-१७", "content_sanskrit": "नैवं कर्तव्यमिति ते तदोचुस्तं जनाधिपम्।\nन च राजा तथाऽकार्षीत्कालपर्यायधर्मिवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2106547, "chapter_id": 3313, "verse_number": "१७-१-१८", "content_sanskrit": "ततोऽनुमान्य धर्मात्मा पौरजानपदं जनम्।\nगमनाय मतिं चक्रे कृष्णस्य गमनादपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2106548, "chapter_id": 3313, "verse_number": "१७-१-१९", "content_sanskrit": "`वर्तमाने विवादे तु वास्तुविक्रयिणं प्रति।\nधनेच्छा युगपत्प्राप्ता क्षेत्रतस्वामिभूभृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2106549, "chapter_id": 3313, "verse_number": "१७-१-२०", "content_sanskrit": "प्राप्तं कलियुगं ज्ञात्वा सहदेवो हसन्निव।\nराज्ञस्तु कथयामास धर्मो नष्टस्तु सङ्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2106550, "chapter_id": 3313, "verse_number": "१७-१-२१", "content_sanskrit": "श्रुत्वा तु दुर्मना राजा पर्याप्तं जीवनं मम।\nइति स्म राजा कौरव्यो धर्मपुत्रो युधिष्ठिरः।\nउत्सृज्याभरणान्यङ्गाज्जगृहे वल्कलान्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2106551, "chapter_id": 3313, "verse_number": "१७-१-२२", "content_sanskrit": "भीमार्जुनयमाश्चैव द्रौपदी च यशस्विनी।\nतथैव जगृहुः सर्वे वल्कलानि नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2106552, "chapter_id": 3313, "verse_number": "१७-१-२३", "content_sanskrit": "विधिवत्कारयित्वेष्टिं नैष्ठिकीं भरतर्षभ।\nसमुत्सृज्याप्सु सर्वेऽग्नीन्प्रतस्थुर्नरपुङ्गवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2106553, "chapter_id": 3313, "verse_number": "१७-१-२४", "content_sanskrit": "ततः प्ररुरुदुः सर्वाः स्त्रिंयो दृष्ट्वा नरोत्तमान्।\nप्रस्थितान्द्रौपदीषष्ठान्पुरा द्यूतजितान्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2106554, "chapter_id": 3313, "verse_number": "१७-१-२५", "content_sanskrit": "हर्षोऽभवच्च सर्वेषां भ्रातॄणां गमनं प्रति।\nयुधिष्ठिरमतं ज्ञात्वा वृष्णिक्षयमवेक्ष्य च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2106555, "chapter_id": 3313, "verse_number": "१७-१-२६", "content_sanskrit": "भ्रातरः पञ्च कृष्णा च षष्ठी श्वा चैव सप्तमः।\nआत्मना सप्तमो राजा निर्ययौ गजसाह्वयात्।\nपौरैरनुगतो दूरं सर्वैरन्तःपुरैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2106556, "chapter_id": 3313, "verse_number": "१७-१-२७", "content_sanskrit": "न चैनमशकत्कश्चिन्निवर्तस्वेति भाषितुम्।\nन्यवर्तन्त ततः सर्वे नरा नगरवासिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2106557, "chapter_id": 3313, "verse_number": "१७-१-२८", "content_sanskrit": "कृपप्रभृतयश्चैव युयुत्सुं पर्यवारयन्।\nविवेश गङ्गां कौरव्य उलूपी भुजगात्मजा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2106558, "chapter_id": 3313, "verse_number": "१७-१-२९", "content_sanskrit": "चित्राङ्गदा ययौ चापि मणलूरपुरं प्रति।\nशिष्टाः परिक्षितं त्वन्या मातरः पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2106559, "chapter_id": 3313, "verse_number": "१७-१-३०", "content_sanskrit": "पाण्डवाश्च महात्मानो द्रौपदी च यशस्विनी।\nकृतोपवासाः कौरव्य प्रययुः प्राङ्मुखास्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2106560, "chapter_id": 3313, "verse_number": "१७-१-३१", "content_sanskrit": "योगयुक्ता महात्मानस्त्यागधर्ममुपेयुषः।\nअभिजग्मुर्बहून्देसान्सरितः सागरांस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2106561, "chapter_id": 3313, "verse_number": "१७-१-३२", "content_sanskrit": "युधिष्ठिरो ययावग्रे भीमस्तु तदनन्तरम्।\nअर्जुनस्तस्य चान्वेव यमौ चापि यथाक्रमम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2106562, "chapter_id": 3313, "verse_number": "१७-१-३३", "content_sanskrit": "पृष्ठतस्तु वरारोहा श्यामा पद्मदलेक्षणा।\nद्रौपदी योषितांश्रेष्ठा ययौ भरतसत्तम।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2106563, "chapter_id": 3313, "verse_number": "१७-१-३४", "content_sanskrit": "श्वा चैवानुयायावेकः प्रस्थितान्पाण्डवान्वनम्।\nक्रमेणि ते ययुर्वीरा लौहित्यं सलिलार्णवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2106564, "chapter_id": 3313, "verse_number": "१७-१-३५", "content_sanskrit": "गाण्डीवं तु धनुर्दिव्यं न मुमोच धनंजयः।\nरत्नलोभान्महाराज ते चाक्षय्ये महेषुधी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2106565, "chapter_id": 3313, "verse_number": "१७-१-३६", "content_sanskrit": "अग्निं ते ददृशुस्तत्र स्थितं शैलमिवाग्रतः।\nमार्गमावृत्य तिष्ठन्तं साक्षात्पुरुषविग्रहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2106566, "chapter_id": 3313, "verse_number": "१७-१-३७", "content_sanskrit": "ततो देवः स सप्तार्चिः पाण्डवानिदमब्रवीत्।\nभोभो पाण्डुसुता वीराः पावकं मां निबोधत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2106567, "chapter_id": 3313, "verse_number": "१७-१-३८", "content_sanskrit": "युधिष्ठिर महाबाहो भीमसेन परंतप।\nअर्जुनाश्विसुतौ वीरौ निबोधत वचो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2106568, "chapter_id": 3313, "verse_number": "१७-१-३९", "content_sanskrit": "अहमग्निः कुरुश्रेष्ठा मया दग्धं च खाण्डवम्।\nअर्जुनस्य प्रभावेन तथा नारायणस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2106569, "chapter_id": 3313, "verse_number": "१७-१-४०", "content_sanskrit": "अयं वः फल्गुनो भ्राता गाण्डीवं परमायुधम्।\nपरित्यज्य वने यातु नानेनार्थोस्ति कश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2106570, "chapter_id": 3313, "verse_number": "१७-१-४१", "content_sanskrit": "चक्ररत्नं तु यत्कृष्णे स्थितमासीन्महात्मनि।\nगतं तच्च पुनर्हस्ते कालेनैष्यति तस्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2106571, "chapter_id": 3313, "verse_number": "१७-१-४२", "content_sanskrit": "वरुणादाहृतं पूर्वं मयैतत्पार्थकारणात्।\nगाण्डीवं धनुषां श्रेष्ठं वरुणायैव दीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2106572, "chapter_id": 3313, "verse_number": "१७-१-४३", "content_sanskrit": "ततस्ते भ्रातरः सर्वे धनंजयमचोदयन्।\nस जले प्राक्षिपच्चैतत्तथाऽक्षय्ये महेषुधी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2106573, "chapter_id": 3313, "verse_number": "१७-१-४४", "content_sanskrit": "ततोऽग्निर्भरतश्रेष्ठ तत्रैवान्तरधीयत।\nययुस्च पाण्डवा वीरास्ततस्ते दक्षिणामुखाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2106574, "chapter_id": 3313, "verse_number": "१७-१-४५", "content_sanskrit": "ततस्ते तूत्तरेणैव तीरेण लवणांभसः।\nजग्मुर्भरतशार्दूल दिशं दक्षिणपश्चिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2106575, "chapter_id": 3313, "verse_number": "१७-१-४६", "content_sanskrit": "ततः पुनः समावृत्ताः पश्चिमां दिशमेव ते।\nददृशुर्द्वारकां चापि सागरेण परिप्लुताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2106576, "chapter_id": 3313, "verse_number": "१७-१-४७", "content_sanskrit": "उदीचीं पुनरावृत्त्य ययुर्भरतसत्तमाः।\nप्रादक्षिण्यं चिकीर्षन्तः पृथिव्या योगधर्मिणः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2106577, "chapter_id": 3313, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते महाप्रस्थानिकपर्वणि प्रथमोऽध्यायः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]