[{"id": 7005198000, "chapter_id": 25198, "verse_number": "७-२-१५-१", "content_sanskrit": "सारस्वत उवाच ।\nअथासौ वामनो विप्रो लब्धज्ञानो भवार्चने ।\nजगाम तद्वनं रम्यं गिरे रैवतकस्य यत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005198001, "chapter_id": 25198, "verse_number": "७-२-१५-२", "content_sanskrit": "यत्र वृक्षा बहुविधा दीर्घशाखाः फलान्विताः ।\nवटोदुम्बरबिल्वाश्च सर्जार्जुनकदंबकाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005198002, "chapter_id": 25198, "verse_number": "७-२-१५-३", "content_sanskrit": "पलाशाश्वत्थनिंबाश्च धवाटीवारुणीद्रुमाः ।\nशमीकंकोललिंबांश्च बीजपूरी च दाडिमः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005198003, "chapter_id": 25198, "verse_number": "७-२-१५-४", "content_sanskrit": "बदरी निंबकः पूगः कदली शल्लकी शिवा ।\nतालहिंतालशिरसा बीजकावंशखादिराः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005198004, "chapter_id": 25198, "verse_number": "७-२-१५-५", "content_sanskrit": "अजगासनगागुच्छा इंगुदीकोरवेंगुदाः ।\nब्रह्मवृक्षाः कुरुबकाः करंजाः पुत्रजीविनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005198005, "chapter_id": 25198, "verse_number": "७-२-१५-६", "content_sanskrit": "अंकोल्लाः पारिभद्राश्च कलंबाः पनसास्तथा ।\nउज्ज्वलाश्च हरिद्राश्च गंगडीवायवा द्रुमाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005198006, "chapter_id": 25198, "verse_number": "७-२-१५-७", "content_sanskrit": "तेसुण्डकाः शिरीषाश्च खर्जूरीकरवंदिकाः ।\nसेवाली शाल्मली शाला मधूकाश्च विभीतकाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005198007, "chapter_id": 25198, "verse_number": "७-२-१५-८", "content_sanskrit": "हरीतक्यः कटाहाश्च कर्यष्टा आटरूषकाः ।\nविकच्छवः कपित्थाश्च रोहिणीवेत्रकद्रुमाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005198008, "chapter_id": 25198, "verse_number": "७-२-१५-९", "content_sanskrit": "मदनफलानिर्गुण्डीपाटलानंदिपादपाः ।\nलवंगैलालवल्यश्च सन्ताना अगरुद्रुमाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005198009, "chapter_id": 25198, "verse_number": "७-२-१५-१०", "content_sanskrit": "श्रीखण्डकर्पूरनगाः कल्पवृक्षा नगोतमाः ।\nवामनेन तदा दृष्टाश्छायावृक्षाः सुरार्चिताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005198010, "chapter_id": 25198, "verse_number": "७-२-१५-११", "content_sanskrit": "उदयास्तमने येषां छाया न प्रतिहन्यते ।\nतेषां दर्शनमात्रेण सर्वपापक्षयो भवेत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005198011, "chapter_id": 25198, "verse_number": "७-२-१५-१२", "content_sanskrit": "ये जनाः पुण्यकर्माणस्तेषां ते दृष्टिगोचराः ।\nएतान्पश्यन्ययौ वृक्षांस्ततो रैवतकं गिरिम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005198012, "chapter_id": 25198, "verse_number": "७-२-१५-१३", "content_sanskrit": "यावन्निरीक्षते तुंगं शिखरं तस्य मूर्द्धनि ।\nआश्चर्यं ददृशे विप्रो महल्लोकभयंकरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005198013, "chapter_id": 25198, "verse_number": "७-२-१५-१४", "content_sanskrit": "धूमज्वलनमध्यस्थान्पुरुषान्पंच पश्यति ।\nकृष्णांगान्खेचरान्रौद्रान्कृष्णागुरुविभूषितान् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005198014, "chapter_id": 25198, "verse_number": "७-२-१५-१५", "content_sanskrit": "सारमेय समारूढान्करिहस्तान्समेखलान् ।\nखङ्गखेटकहस्तांश्च डमरुड्डामरस्वनान् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005198015, "chapter_id": 25198, "verse_number": "७-२-१५-१६", "content_sanskrit": "सघर्घरीकचरणन्यासनादितपर्वतान् ।\nफेत्कारभासुराकारान्काशकुञ्चितमूर्द्धजान् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005198016, "chapter_id": 25198, "verse_number": "७-२-१५-१७", "content_sanskrit": "नरमांसवसासारकवलव्यग्रतालुकान् ।\nजनगंधसमाज्ञानभवतीव्रविलोचनान् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005198017, "chapter_id": 25198, "verse_number": "७-२-१५-१८", "content_sanskrit": "पञ्चाग्निसाधनाव्याप्तदिव्यचक्षुः प्रभावतः ।\nदेवान्पश्यति विप्रेन्द्रो ज्ञातकार्यपरंपरः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005198018, "chapter_id": 25198, "verse_number": "७-२-१५-१९", "content_sanskrit": "एते क्षेत्राधिपाः पञ्च महादेवेन निर्मिताः ।\nमहाबला रैवतके निवसंति गिरौ सदा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005198019, "chapter_id": 25198, "verse_number": "७-२-१५-२०", "content_sanskrit": "स्वेच्छाचारान्नरान्मर्त्त्यान्वारयति नगे तथा ।\nहरिं हरं नदीं देवीं न पश्यंति गिरिं यथा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005198020, "chapter_id": 25198, "verse_number": "७-२-१५-२१", "content_sanskrit": "दृष्ट्वा ज्ञात्वा स्तुतिं चक्रे ध्यात्वा देवं महेश्वरम् ।\nजयंति दुष्टदैत्येंद्रयुद्धध्यानांकितं वपुः ।\nबिभ्रति भ्रातरो ये ते पंचेंद्रसमविक्रमाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005198021, "chapter_id": 25198, "verse_number": "७-२-१५-२२", "content_sanskrit": "रुद्रवक्त्रोद्भवा दक्षा दक्षाध्वरविनाशकाः ।\nस्वावलीढाहुतीनष्टभीतवाडवनंदिताः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005198022, "chapter_id": 25198, "verse_number": "७-२-१५-२३", "content_sanskrit": "कुङ्कुमागरुकर्पूरलिप्तांगाः सुविभूषिताः ।\nमदिरामोदमत्तांगनृत्यगीतकराः सुराः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005198023, "chapter_id": 25198, "verse_number": "७-२-१५-२४", "content_sanskrit": "ब्रह्मांडभ्रमणश्रांत स्वगंधत्रस्तसंचराः ।\nमनोजवाः कामगमा क्षेत्रपाला जयंति ते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005198024, "chapter_id": 25198, "verse_number": "७-२-१५-२५", "content_sanskrit": "इत्यादिवचनात्तुष्टा द्विजस्याग्रे स्वयं स्थिताः ।\nएकपादोऽस्म्यहं चैको द्वितीयो गिरिदारुणः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005198025, "chapter_id": 25198, "verse_number": "७-२-१५-२६", "content_sanskrit": "तृतीयो मेघनादस्तु सिंहनादश्चतुर्थकः ।\nपंचमः कालमेघोऽहं कुर्मः किं ते वदस्व तत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005198026, "chapter_id": 25198, "verse_number": "७-२-१५-२७", "content_sanskrit": "द्विज उवाच ।\nयदि तुष्टा भवंतो मे यदि देयो वरो धुवम् ।\nअहो आप्रलयं यावत्स्थातव्यं मत्प्रतिष्ठितैः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005198027, "chapter_id": 25198, "verse_number": "७-२-१५-२८", "content_sanskrit": "एकपादो गिरि तटे प्रहर्षात्प्रथमं स्थितः ।\nवसतौ वसता तेन गिरौ च गिरिदारुणः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005198028, "chapter_id": 25198, "verse_number": "७-२-१५-२९", "content_sanskrit": "प्रतिष्ठितः प्रसाद्याथ वरदोऽसौ स्वयं स्थितः ।\nउज्जयंतगिरेर्मूर्ध्नि मेघनादः स्वयं ययौ ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005198029, "chapter_id": 25198, "verse_number": "७-२-१५-३०", "content_sanskrit": "भवानीशंकरं रम्यं सिंहनादस्तथाविशत् ।\nस्वयं वस्त्रापथेनैव भवस्याग्रे निरूपितः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005198030, "chapter_id": 25198, "verse_number": "७-२-१५-३१", "content_sanskrit": "स्वणरेखानदीतीरे कालमेघो महाबलः ।\nसर्वलोकोपकारार्थं तीर्थं संस्थापितं पुरा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005198031, "chapter_id": 25198, "verse_number": "७-२-१५-३२", "content_sanskrit": "वामनेन स्वयं गत्वा क्षेत्रपालास्तु पूजिताः ।\nपुरा युगादौ राजेंद्र सर्वे देवाः समागताः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005198032, "chapter_id": 25198, "verse_number": "७-२-१५-३३", "content_sanskrit": "सुराष्ट्रदेशे संप्राप्ताः पुण्ये रैवतके गिरौ ।\nरक्षार्थं सर्वलोकानां वधार्थं देववैरिणाम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005198033, "chapter_id": 25198, "verse_number": "७-२-१५-३४", "content_sanskrit": "विष्णोः कण्ठे तदा मुक्ता जयमाला सुरोत्तमैः ।\nदामोदरेति विख्यातं दत्तं नामोत्तमं हरेः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005198034, "chapter_id": 25198, "verse_number": "७-२-१५-३५", "content_sanskrit": "तत्रादौ कार्तिके शुक्ले वासरे विष्णुवल्लभे ।\nउपोष्य सहिते देवैस्तत्तीर्थं विष्णुना कृतम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005198035, "chapter_id": 25198, "verse_number": "७-२-१५-३६", "content_sanskrit": "सर्वतीर्थमयी पुण्या स्वर्णरेखा नदी स्थिता ।\nभुक्तिमुक्तिप्रदं पुण्यं विष्णुलोकप्रदायकम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005198036, "chapter_id": 25198, "verse_number": "७-२-१५-३७", "content_sanskrit": "क्षालनं सर्वपापानां रोगदारिद्र्यनाशनम् ।\nदामोदरं रैवतके परमानंददायकम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005198037, "chapter_id": 25198, "verse_number": "७-२-१५-३८", "content_sanskrit": "ये पश्यंति विमानैस्ते नीयंते विष्णुमंदिरे ।\nन गृहे कार्तिकः कार्यो विशेषाद्भीष्मपंचकम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005198038, "chapter_id": 25198, "verse_number": "७-२-१५-३९", "content_sanskrit": "पंचकाद्द्वादशी श्रेष्ठा कार्या दामोदरे जले ।\nप्रातःस्नानं प्रकर्त्तव्यं संप्राप्ते कार्तिके जनैः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005198039, "chapter_id": 25198, "verse_number": "७-२-१५-४०", "content_sanskrit": "मासोपवासः कर्त्तव्यो यतिभिर्ब्रह्मचारिभिः ।\nसतीभिर्विधवाभिश्च मुक्तिस्थानमभीप्सुभिः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005198040, "chapter_id": 25198, "verse_number": "७-२-१५-४१", "content_sanskrit": "एकभक्तेन नक्तेन तथैवायाचितेन च ।\nउपवासेवन कृच्छ्रेण शाकाहारेण वा पुनः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005198041, "chapter_id": 25198, "verse_number": "७-२-१५-४२", "content_sanskrit": "संसेव्यः कार्त्तिके विष्णुर्दीपदानपरैर्नरैः ।\nब्रह्मचर्यपरैर्मासो नीयते यदि मानवैः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005198042, "chapter_id": 25198, "verse_number": "७-२-१५-४३", "content_sanskrit": "तदा विष्णुपुरे वासः क्रियते विष्णुना सह ।\nपञ्चोपवासाः कर्त्तव्याः संप्राप्ते भीष्मपंचके ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005198043, "chapter_id": 25198, "verse_number": "७-२-१५-४४", "content_sanskrit": "एकादशीं समारभ्य पंचमी पूर्णिमादिनम् ।\nतदेतत्पंचकं प्रोक्तं सर्वपापहरं नृणाम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005198044, "chapter_id": 25198, "verse_number": "७-२-१५-४५", "content_sanskrit": "सर्वेषामपि मासानां पञ्चकात्कार्तिकादपि ।\nएकादशी कार्तिकस्य पुण्या दामोदरे कृता ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005198045, "chapter_id": 25198, "verse_number": "७-२-१५-४६", "content_sanskrit": "मिष्टान्नं कार्तिके देयं हविष्यं सघृतप्लुतम् ।\nसुवर्णं रजतं वस्त्रं तोयमन्नं फलानि च ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005198046, "chapter_id": 25198, "verse_number": "७-२-१५-४७", "content_sanskrit": "मासांते विविधं देयं गौस्तिलाः कुसुमानि च ।\nसर्वदानेषु यत्पुण्यं सर्व तीर्थेषु यत्फलम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005198047, "chapter_id": 25198, "verse_number": "७-२-१५-४८", "content_sanskrit": "अश्वमेधादिभिर्यज्ञैर्गयायां पिंडदस्य यत् ।\nतत्फलं जायते नॄणां दृष्टे दामोदरे नृप ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005198048, "chapter_id": 25198, "verse_number": "७-२-१५-४९", "content_sanskrit": "एकादश्यां कृतस्नानो देव पूजापरो भवेत् ।\nस्नाप्य पञ्चामृतेनैव ततस्तीर्थोदकेन च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005198049, "chapter_id": 25198, "verse_number": "७-२-१५-५०", "content_sanskrit": "कुंकुमागरुश्रीखंडकर्पूरोदकमिश्रितैः ।\nपूजयित्वा ततः पुष्पैः शतपत्रैः सुगं धिभिः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005198050, "chapter_id": 25198, "verse_number": "७-२-१५-५१", "content_sanskrit": "मालतीकुसुमैः शुभ्रैर्बहुभिस्तुलसीदलैः ।\nवस्त्रयज्ञोपवीतं च दत्त्वा धूपं प्रधूपयेत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005198051, "chapter_id": 25198, "verse_number": "७-२-१५-५२", "content_sanskrit": "दीपं दद्याद्धृतेनैव तैलेनापि घृतं विना ।\nनैवेद्यं विविधं देयं फलं तांबूलमेव च ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005198052, "chapter_id": 25198, "verse_number": "७-२-१५-५३", "content_sanskrit": "प्रासादपूजा कर्त्तव्या ध्वजदानादिना नृप ।\nगौः सवत्सा ततो देया संसारार्णवतारिणी ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005198053, "chapter_id": 25198, "verse_number": "७-२-१५-५४", "content_sanskrit": "ततः प्रदक्षिणां कृत्वा गीतवादित्रनिस्वनैः ।\nवेदपाठपुराणैश्च व्याख्यादिव्यकथादिभिः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005198054, "chapter_id": 25198, "verse_number": "७-२-१५-५५", "content_sanskrit": "देवाग्रे जागरः कार्यो दीपो देयोंऽतिभूमिषु ।\nसप्तधान्यमयाः सप्त पर्वता दीपसंयुताः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005198055, "chapter_id": 25198, "verse_number": "७-२-१५-५६", "content_sanskrit": "फलतांबूलपक्वान्नपूरिताः परिकल्पिताः ।\nविद्वद्भिः श्रोत्रियैः श्रांतैर्ब्राह्मणैर्गृहमेधिभिः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005198056, "chapter_id": 25198, "verse_number": "७-२-१५-५७", "content_sanskrit": "स्त्रीभिश्च नरशार्दूल श्रोतव्या वैष्णवी कथा ।\nएवं जागरणं कार्यं रागक्रोधविवर्जितैः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005198057, "chapter_id": 25198, "verse_number": "७-२-१५-५८", "content_sanskrit": "कृत्वा जागरणं रात्रावुदिते सूर्यमडले ।\nपूर्वां संध्यां ततः स्नात्वा कृत्वा मध्याह्नमाचरेत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005198058, "chapter_id": 25198, "verse_number": "७-२-१५-५९", "content_sanskrit": "देवान्पितॄन्मनुष्यांश्च संतर्प्य विधिपूर्वकम् ।\nकृत्वा श्राद्धं पितॄणां तु दद्याद्दानं स्वशक्तितः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005198059, "chapter_id": 25198, "verse_number": "७-२-१५-६०", "content_sanskrit": "देवं दामोदरं पूज्य पुष्पधूपादिना पुनः ।\nनरसिंहं सुरं पूज्य वैनतेयं च पूजयेत् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005198060, "chapter_id": 25198, "verse_number": "७-२-१५-६१", "content_sanskrit": "कृत्वा जागरणं रात्रावुत्थाप्य मधुसूदनम् ।\nद्वादशीभुक्तिमासाद्य कार्यं पारणकं नरैः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005198061, "chapter_id": 25198, "verse_number": "७-२-१५-६२", "content_sanskrit": "ब्राह्मणान्भोजयित्वा च सहितः पुत्रबांधवैः ।\nविकलांधकृपणानां देयमन्नं स्वशक्तितः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005198062, "chapter_id": 25198, "verse_number": "७-२-१५-६३", "content_sanskrit": "दामोदरे रैवतके स्वर्णरेखानदीजले ।\nएवं यः कुरुते यात्रां तस्य पुण्यफलं शृणु ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005198063, "chapter_id": 25198, "verse_number": "७-२-१५-६४", "content_sanskrit": "ब्रह्मघ्नश्च सुरापश्च ग्रामसीमाविलोपकः ।\nराजद्रोही गुरुद्रोही मिथ्याव्रतधरश्च यः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005198064, "chapter_id": 25198, "verse_number": "७-२-१५-६५", "content_sanskrit": "कूटसाक्ष्यप्रदो यश्च यश्च न्यासापहारकः ।\nबालस्त्रीघातको विप्रः संध्यास्नानविवर्जितः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7005198065, "chapter_id": 25198, "verse_number": "७-२-१५-६६", "content_sanskrit": "देवब्रह्म स्वहर्त्ता च वेदविक्रयकारकः ।\nकन्याविक्रयकर्त्ता च देवब्राह्मणनिंदकः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7005198066, "chapter_id": 25198, "verse_number": "७-२-१५-६७", "content_sanskrit": "विश्वासघातको विप्रः शूद्रान्नादोऽथ लुब्धकः ।\nनायकः परदाराणां स्वयंदत्तापहारकः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7005198067, "chapter_id": 25198, "verse_number": "७-२-१५-६८", "content_sanskrit": "पर्वमैथुनसेवी च तथा वै सेतुभेदकः ।\nपरिणीतामृतुस्नातां स्वयं यो नाभिगच्छति ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7005198068, "chapter_id": 25198, "verse_number": "७-२-१५-६९", "content_sanskrit": "ब्राह्मणी विधवा बाला न भवेच्छ्रुतधारिणी ।\nमहापातकिनश्चैते तथान्ये बहवो नृप ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7005198069, "chapter_id": 25198, "verse_number": "७-२-१५-७०", "content_sanskrit": "स्वर्णरेखाजले स्नात्वा दृष्ट्वा दामोदरं हरिम् ।\nरात्रौ जागरणं कृत्वा मुच्यते सर्वपातकैः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7005198070, "chapter_id": 25198, "verse_number": "७-२-१५-७१", "content_sanskrit": "न तु ये पापकर्माणः समायाताः प्रजागरे ।\nसंसारसागरे तीर्थे गच्छंति न हरेः पुरम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7005198071, "chapter_id": 25198, "verse_number": "७-२-१५-७२", "content_sanskrit": "यथा यथा याति नरः प्रजागरे तथातथा विष्णुपुरे विचिंत्यते ।\nवासः सुरैर्वैष्णवलोकहेतवे मृदंगगीतध्वनिनादिते गृहे ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7005198072, "chapter_id": 25198, "verse_number": "७-२-१५-७३", "content_sanskrit": "गदासि शंखारिधराश्चतुर्भुजा दैतेयदर्पापहरूपधारिणः ।\nप्रगीयमानाः सुरसुंदरीभिस्ते यांति खं खेचरगात्रसंगाः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7005198073, "chapter_id": 25198, "verse_number": "७-२-१५-७४", "content_sanskrit": "वाराहकल्पे प्रथमं युगादौ दामोदरो रैवतके प्रसिद्धः ।\nसैषा नदी या सरितां वरिष्ठा सोऽयं हरिर्यो भुवनस्य कर्ता ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7005198074, "chapter_id": 25198, "verse_number": "७-२-१५-७५", "content_sanskrit": "इदं पुराणं पठते शृणोति नरो विमानैर्मधुसूद नालये ।\nदेवांगनादत्तभुजश्चतुर्भुजः स नीयते देवगणैरभिष्टुतः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7005198075, "chapter_id": 25198, "verse_number": "७-२-१५-७६", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभास खण्डे द्वितीये वस्त्रापथक्षेत्रमाहात्म्ये सारस्वतप्रोक्ततीर्थयात्राविधाने श्रीदामोदरमाहात्म्यवर्णनंनाम पंचदशोऽध्यायः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]