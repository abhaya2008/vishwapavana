[{"id": 7005002000, "chapter_id": 25002, "verse_number": "७-१-१८५-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि देवमातरमव्ययाम् ।\nमंकीशान्नैरृते भागे गौरीरूपसमाश्रिताम् ।\nदेवमाता सरस्वत्या नाम लोकेषु गीयते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005002001, "chapter_id": 25002, "verse_number": "७-१-१८५-२", "content_sanskrit": "पादुकासनसंस्था च तत्र देवी सरस्वती ।\nगौरीरूपेण सा तत्र वडवाश्रितविग्रहा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005002002, "chapter_id": 25002, "verse_number": "७-१-१८५-३", "content_sanskrit": "मातृवद्रक्षिता देवा वडवानलभीतितः ।\nदेवमातेति लोकेऽस्मिं स्ततः सा विबुधैः कृता ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005002003, "chapter_id": 25002, "verse_number": "७-१-१८५-४", "content_sanskrit": "माघे मासे तृतीयायां यस्तामर्चयते नरः ।\nनारी वा संयता साध्वी सर्वान्कामानवाप्नुयात् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005002004, "chapter_id": 25002, "verse_number": "७-१-१८५-५", "content_sanskrit": "दंपती भोज येद्यस्तु पायसैः शर्करादिभिः ।\nगौरीसहस्रभोज्यस्य दत्तस्य फलमाप्नुयात् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005002005, "chapter_id": 25002, "verse_number": "७-१-१८५-६", "content_sanskrit": "सुवर्णपादुका देया तत्र विप्राय शीलिने ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]