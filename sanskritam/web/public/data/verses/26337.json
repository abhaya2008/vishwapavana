[{"id": 7006337000, "chapter_id": 26337, "verse_number": "१-४७-१", "content_sanskrit": "वैशम्पायन उवाच दानवांश्चापि पिप्रीषुः कालनेमिर्महासुरः ।\nव्यवर्धत महातेजास्तपान्ते जलदो यथा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006337001, "chapter_id": 26337, "verse_number": "१-४७-२", "content_sanskrit": "त्रैलोक्यान्तर्गतं तं तु दृष्ट्वा तै दानवेश्वराः ।\nउत्तस्थुरपरिश्रान्ताः प्राप्येवामृतमुत्तमम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006337002, "chapter_id": 26337, "verse_number": "१-४७-३", "content_sanskrit": "ते वीतभयसंत्रासा मयतारपुरोगमाः ।\nतारकामयसंग्रामे सततं जयकाङ्क्षिणः ।\nरेजुरायोधनगता दानवा युद्धकाङ्क्षिणः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006337003, "chapter_id": 26337, "verse_number": "१-४७-४", "content_sanskrit": "अस्त्रमभ्यस्यतां तेषां व्यूहं च .परिधावताम् ।\nप्रेक्षतां चाभवत् प्रीतिर्दानवं कालनेमिनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006337004, "chapter_id": 26337, "verse_number": "१-४७-५", "content_sanskrit": "ये तु तत्र मयस्यासन् मुख्या युद्धपुरस्सराः ।\nतेऽपि सर्वे भयं त्यक्त्वा हृष्टा योद्धुमुपस्थिताः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006337005, "chapter_id": 26337, "verse_number": "१-४७-६", "content_sanskrit": "मयस्तारो वराहश्च हयग्रीवश्च वीर्यवान् ।\nविप्रचित्तिसुतः श्वेतः खरलम्बावुभावपि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006337006, "chapter_id": 26337, "verse_number": "१-४७-७", "content_sanskrit": "अरिष्टो बलिपुत्रस्तु किशोरोष्ट्रौ तथैव च ।\nस्वर्भानुश्चामरप्रख्यो वक्रयोधी महासुरः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006337007, "chapter_id": 26337, "verse_number": "१-४७-८", "content_sanskrit": "एतेऽस्त्रविदुषः सर्वे सर्वे तपसि सुव्रताः ।\nदानवाः कृतिनो जग्मुः कालनेमिनमुत्तमम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006337008, "chapter_id": 26337, "verse_number": "१-४७-९", "content_sanskrit": "ते गदाभिश्च गुर्वीभिञ्चक्रैश्च सपरश्वधैः ।\nअश्मभिश्चाद्रिसदृशैर्गण्डशैलैश्च दंशितैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006337009, "chapter_id": 26337, "verse_number": "१-४७-१०", "content_sanskrit": "पट्टिशैर्भिन्दिपालैश्च परिघैश्चोत्तमायुधैः ।\nघातनीभिश्च गुर्वीभिः शतघ्नीभिस्तथैव च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006337010, "chapter_id": 26337, "verse_number": "१-४७-११", "content_sanskrit": "कालकल्पैश्च मुसलैः क्षेपणीयैश्च मुद्गरैः ।\nयुगैर्यन्त्रैश्च निर्मुक्तैरर्गलैश्चाग्रताडितैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006337011, "chapter_id": 26337, "verse_number": "१-४७-१२", "content_sanskrit": "दोर्भिश्चायतपीनांसैः पाशैः प्रासैश्च मूर्च्छितैः ।\nसर्पैर्लेलिह्यमानैश्च विसर्पद्भिश्च सायकैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006337012, "chapter_id": 26337, "verse_number": "१-४७-१३", "content_sanskrit": "वज्रैः प्रहरणीयैश्च दीप्यमानैश्च तोमरैः ।\nविकोशैश्चासिभिस्तीक्ष्णैः शूलैश्च शितनिर्मलैः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006337013, "chapter_id": 26337, "verse_number": "१-४७-१४", "content_sanskrit": "ते वै संदीप्तमनसः प्रगृहीतोत्तमायुधाः ।\nकालनेमिं पुरस्कृत्य तस्थुः संग्राममूर्धनि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006337014, "chapter_id": 26337, "verse_number": "१-४७-१५", "content_sanskrit": "सा दीप्तशस्त्रप्रवरा दैत्यानां शुशुभे चमूः ।\nद्यौर्निमीलितनक्षत्रा सघनेवाम्बुदागमे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006337015, "chapter_id": 26337, "verse_number": "१-४७-१६", "content_sanskrit": "देवतानामपि चमू रुरुचे शक्रपालिता ।\nदीप्ता शीतोष्णतेजोभ्यां चन्द्रभास्करवर्चसा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006337016, "chapter_id": 26337, "verse_number": "१-४७-१७", "content_sanskrit": "वायुवेगवती सौम्या तारागणपताकिनी ।\nतोयदाविद्धवसना ग्रहनक्षत्रहासिनी ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006337017, "chapter_id": 26337, "verse_number": "१-४७-१८", "content_sanskrit": "यमेन्द्रधनदैर्गुप्ता वरुणेन च धीमता ।\nसम्प्रदीप्ताग्निपवना नारायणपरायणा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006337018, "chapter_id": 26337, "verse_number": "१-४७-१९", "content_sanskrit": "सा समुद्रौघसदृशी दिव्या देवमहाचमूः ।\nरराजास्त्रवती भीमा यक्षगन्धर्वशालिनी ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006337019, "chapter_id": 26337, "verse_number": "१-४७-२०", "content_sanskrit": "तयोश्चम्वोस्तदा तत्र बभूव स समागमः ।\nद्यावापृथिव्योः संयोगो यथा स्याद् युगपर्यये ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006337020, "chapter_id": 26337, "verse_number": "१-४७-२१", "content_sanskrit": "तद् युद्धमभवद् घोरं देवदानवसंकुलम् ।\nक्षमापराक्रममयं दर्पस्य विनयस्य च ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006337021, "chapter_id": 26337, "verse_number": "१-४७-२२", "content_sanskrit": "निश्चक्रमुर्बलाभ्यां तु ताभ्यां भीमाः सुरासुराः ।\nपूर्वापराभ्यां संरब्धाः सागराभ्यामिवाम्बुदाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006337022, "chapter_id": 26337, "verse_number": "१-४७-२३", "content_sanskrit": "ताभ्यां बलाभ्यां संहृष्टाश्चेरुस्ते देवदानवाः ।\nवनाभ्यां पर्वतीयाभ्यां पुष्पिताभ्यां यथा गजाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006337023, "chapter_id": 26337, "verse_number": "१-४७-२४", "content_sanskrit": "समाजघ्नुस्ततो भेरीः शङ्खान् दध्मुश्च नैकशः ।\nस शब्दो द्यां भुवं चैव दिशश्च समपूरयत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006337024, "chapter_id": 26337, "verse_number": "१-४७-२५", "content_sanskrit": "ज्याघाततलनिर्घोषो धनुषां कूजितानि च ।\nदुन्दुभीनां निनदतां दैत्यानां निर्दधुः स्वनान् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006337025, "chapter_id": 26337, "verse_number": "१-४७-२६", "content_sanskrit": "तौ पाशशुक्लांशुधरौ वरुणेन्दू महारणे।\nबभञ्जुर्बाहुभिर्बाहून् द्वन्द्वमन्ये युयुत्सवः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006337026, "chapter_id": 26337, "verse_number": "१-४७-२७", "content_sanskrit": "देवतास्त्वशनीर्घोराः परिघांश्चोत्तमायसान् ।\nससर्जुराजौ निस्त्रिंशान् गदा गुर्वीश्च दानवाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006337027, "chapter_id": 26337, "verse_number": "१-४७-२८", "content_sanskrit": "गदानिपातैर्भग्नाङ्गा बाणैश्च शकलीकृताः ।\nपरिपेतुर्भृशं केचिन्द्रब्जाः केचित् ससर्जिरे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006337028, "chapter_id": 26337, "verse_number": "१-४७-२९", "content_sanskrit": "ततो रथैः सतुरगैर्विमानैश्चाशुगामिभिः ।\nसमीयुस्ते नु संरब्धा रोषादन्योन्यमाहवे ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006337029, "chapter_id": 26337, "verse_number": "१-४७-३०", "content_sanskrit": "संवर्तमानाः समरे विवर्तन्तस्तथापरे ।\nरथा रथैर्निरुध्यन्ते पदाताश्च पदातिभिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006337030, "chapter_id": 26337, "verse_number": "१-४७-३१", "content_sanskrit": "तेषां रथानां तुमुलः स शब्दः शब्दवाहिनाम् ।\nबभूवाथ प्रसक्तानां नभसीव पयोमुचाम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006337031, "chapter_id": 26337, "verse_number": "१-४७-३२", "content_sanskrit": "बभञ्जिरे रथान् केचित् केचित्   सम्मृदिता रथैः ।\nसम्बाधमेके सम्प्राप्य न शेकुश्चलितुं रथाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006337032, "chapter_id": 26337, "verse_number": "१-४७-३३", "content_sanskrit": "अन्योन्यस्याभिसमरे दोर्भ्यामुत्क्षिप्य दर्पिताः ।\nसंह्रादमानाभरणा जघ्नुस्तत्रासिचर्मिणः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006337033, "chapter_id": 26337, "verse_number": "१-४७-३४", "content_sanskrit": "अस्त्रैरन्ये विनिर्भिन्ना रक्तं वेमुर्हता युधि ।\nक्षरज्जलानां सदृशा जलदानां समागमे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006337034, "chapter_id": 26337, "verse_number": "१-४७-३५", "content_sanskrit": "तदस्त्रशस्त्रग्रथितं क्षिप्तोत्क्षिप्तगदाविलम् ।\nदेवदानवसंक्षुब्ध सकुलं युद्धमाबभौ ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006337035, "chapter_id": 26337, "verse_number": "१-४७-३६", "content_sanskrit": "तद् दानवमहामेघं देवायुधतडित्प्रभम् ।\nअन्योन्यबाणवर्ष तद् युद्धं दुर्दिनमाबभौ ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006337036, "chapter_id": 26337, "verse_number": "१-४७-३७", "content_sanskrit": "एतस्मिन्नन्तरे क्रुद्धः कालनेमिर्महासुरः ।\nव्यवर्द्धत समुद्रौघैः पूर्यमाण इवास्तुदः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006337037, "chapter_id": 26337, "verse_number": "१-४७-३८", "content_sanskrit": "तस्य विद्युच्यला पीडाः प्रदीप्ताशनिवर्षिणः ।\nगात्रे नगशिरः प्रख्या विनिष्पेषुर्बलाहकाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006337038, "chapter_id": 26337, "verse_number": "१-४७-३९", "content_sanskrit": "क्रोधान्निःश्वररतस्तस्य भ्रूभेदस्वेदवर्षिणः ।\nसाग्निनिष्पेषपवना मुखान्निश्चेरुरर्चिषः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006337039, "chapter_id": 26337, "verse_number": "१-४७-४०", "content_sanskrit": "तिर्यगूर्ध्वं च गगने ववृधुस्तस्य बाहवः ।\nपञ्चास्याः कृष्णवपुषो लेलिहाना इवोरगाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006337040, "chapter_id": 26337, "verse_number": "१-४७-४१", "content_sanskrit": "सोऽस्त्रजालैर्बहुविधैर्धनुर्भिः परिघैरपि ।\nदिव्यैराकाशमावव्रे पर्वतैरुच्छ्रितैरिव ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006337041, "chapter_id": 26337, "verse_number": "१-४७-४२", "content_sanskrit": "सोऽनिलोद्धूतवसनस्तस्थौ संग्राममूर्धनि ।\nसंध्यातपग्रस्तशिखः सार्चिर्मेरुरिवापरः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006337042, "chapter_id": 26337, "verse_number": "१-४७-४३", "content_sanskrit": "ऊरुवेगप्रतिक्षिप्तैः शैलशृङ्गाग्रपादपैः ।\nअपातयद् देवगणान् वज्रेणेव महागिरीन् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006337043, "chapter_id": 26337, "verse_number": "१-४७-४४", "content_sanskrit": "बाहुभिः शस्त्रनिस्त्रिंशैश्छिन्नभिन्नशिरोरसः ।\nन शेकुश्चलितुं देवाः कालनेमिहता युधि ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006337044, "chapter_id": 26337, "verse_number": "१-४७-४५", "content_sanskrit": "मुष्टिभिर्निहताः केचित् केचिच्च विदलीकृताः ।\nयक्षगन्धर्वपतयः पेतुः सह महोरगैः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006337045, "chapter_id": 26337, "verse_number": "१-४७-४६", "content_sanskrit": "तेन वित्रासिता देवाः समरे कालनेमिना ।\nन शेकुर्यत्नवन्तोऽपि प्रतिकर्तुं विचेतसः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006337046, "chapter_id": 26337, "verse_number": "१-४७-४७", "content_sanskrit": "तेन शक्रः सहस्राक्षः स्तम्भितः शरबन्धनैः ।\nऐरावतगतः संख्ये चलितुं न शशाक ह ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006337047, "chapter_id": 26337, "verse_number": "१-४७-४८", "content_sanskrit": "निर्जलाम्भोदसदृशो निर्जलार्णवसप्रभः ।\nनिर्व्यापारः कृतस्तेन विपाशो वरुणो मृधे ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006337048, "chapter_id": 26337, "verse_number": "१-४७-४९", "content_sanskrit": "रणे वैश्रवणस्तेन परिघैः कालरूपिभिः ।\nव्यलपल्लोकपालेशस्त्याजितो  धनदक्रियाम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006337049, "chapter_id": 26337, "verse_number": "१-४७-५०", "content_sanskrit": "यमः सर्वहरस्तेन दण्डप्रहरणो रणे ।\nयाम्यामवस्थां समरे नीतः स्वां दिशमाविशत्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006337050, "chapter_id": 26337, "verse_number": "१-४७-५१", "content_sanskrit": "स लोकपालानुत्साद्य कृत्वा तेषां च कर्म तत् ।\nदिक्षु सर्वासु देहं स्वं चतुर्धा विदधे तदा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006337051, "chapter_id": 26337, "verse_number": "१-४७-५२", "content_sanskrit": "स नक्षत्रपथे गत्वा दिव्यं स्वर्भानुदर्शितम् ।\nजहार लक्ष्मीं सोमस्य तं चास्य विषयं महत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006337052, "chapter_id": 26337, "verse_number": "१-४७-५३", "content_sanskrit": "चालयामासदीप्तांशुं स्वर्गद्वारात्स भास्करम् ।\nसायनं चास्य विषयं जहार दिनकर्म च ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006337053, "chapter_id": 26337, "verse_number": "१-४७-५४", "content_sanskrit": "तौ पाशशुक्लांशुधरौ वरुणेन्दू महारणे।\nवायुं च तरसा जित्वा चकारात्मवशानुगम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006337054, "chapter_id": 26337, "verse_number": "१-४७-५५", "content_sanskrit": "ससमुद्राः समानीय सर्वाश्च सरितो बलात् ।\nचकारात्मवशे वीर्याद् देहभूताश्च सिन्धवः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006337055, "chapter_id": 26337, "verse_number": "१-४७-५६", "content_sanskrit": "अपः स्ववशगाः कृत्वा दिविजा याश्च भूमिजाः ।\nस्थापयामास जगतीं सुगुप्तां धरणीधरैः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006337056, "chapter_id": 26337, "verse_number": "१-४७-५७", "content_sanskrit": "स स्वयम्भूरिवाभाति महाभूतपतिर्महान् ।\nसर्वलोकमयो दैत्यः सर्वलोकभयावहः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006337057, "chapter_id": 26337, "verse_number": "१-४७-५८", "content_sanskrit": "स लोकपालैकवपुश्चन्द्रसूर्यग्रहात्मवान् ।\nपावकानिलसंघातो रराज युधि दानवः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006337058, "chapter_id": 26337, "verse_number": "१-४७-५९", "content_sanskrit": "पारमेष्ठ्ये स्थितः स्थाने लोकानां प्रभवाप्यये ।\nतुष्टुवुस्तं दैत्यगणा देवा इव पितामहम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]