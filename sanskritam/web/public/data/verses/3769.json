[{"id": 2128877, "chapter_id": 3769, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2128878, "chapter_id": 3769, "verse_number": "१", "content_sanskrit": "ततः प्रयातः कौशिक्याः पाण्डवो जनमेजय ।\nआनुपूर्व्येण सर्वाणि तीर्थान्यायतनानि च \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2128879, "chapter_id": 3769, "verse_number": "२", "content_sanskrit": "स सागरं समासाद्य गङ्गायाः सङ्गमे नृप ।\nनदीशतानां पञ्चानां मध्ये चक्रे समाप्लवम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2128880, "chapter_id": 3769, "verse_number": "३", "content_sanskrit": "ततः समुद्रतीरेण जगाम वसुधाधिपः\nभ्रातृभिः सहितो वीरः कळिङ्गान् प्रति भारत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2128881, "chapter_id": 3769, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2128882, "chapter_id": 3769, "verse_number": "४", "content_sanskrit": "एते कळिङ्गा कौन्तेय यत्र वैतरणी नदी ।\nयत्रायजत धर्मो वै देवान् शरणमेत्य वै \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2128883, "chapter_id": 3769, "verse_number": "५", "content_sanskrit": "तत्रर्षिभिः समायुक्तं यज्ञियं गिरिशोभितम् ।\nउत्तरं तीरमेतद्धि सततं द्विजसेवितम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2128884, "chapter_id": 3769, "verse_number": "६", "content_sanskrit": "समेन देवयानेन पथा स्वर्गमुपेयुषः ।\nअत्र चैवर्षयो नित्यं पुरा क्रतुभिरीजिरे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2128885, "chapter_id": 3769, "verse_number": "७", "content_sanskrit": "अत्रैव रुद्रो राजेन्द्र पशुमादत्तवान् मखे ।\nरुद्रः पशुं मानवेन्द्र भागोऽयमिति चाब्रवीत् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2128886, "chapter_id": 3769, "verse_number": "८", "content_sanskrit": "हृते पशौ ततो देवाः तमूचुर्भरतर्षभ ।\nमा परस्वमभिद्रोग्धा माऽधर्म्यान्नीनशः पथः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2128887, "chapter_id": 3769, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2128888, "chapter_id": 3769, "verse_number": "९", "content_sanskrit": "ततः कल्याणरूपाभिः वाग्भिस्ते रुद्रमस्तुवन् ।\nइष्ट्या चैनं तर्पयित्वा मानयाञ्चक्रिरे तदा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2128889, "chapter_id": 3769, "verse_number": "१०", "content_sanskrit": "ततः पशुं समुत्सृज्य देवयानेन जग्मिवान् ।\nअत्रानुवंशो रुद्रस्य तं निबोध युधिष्ठिर\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2128890, "chapter_id": 3769, "verse_number": "११", "content_sanskrit": "अयातयामं सर्वेभ्यो भागेभ्यो भागमुत्तमम् ।\nदेवाः सङ्कल्पयामासुर्भयाद् रुद्रस्य शाश्वतम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2128891, "chapter_id": 3769, "verse_number": "१२", "content_sanskrit": "इमां गाथामत्र गायन्नपः स्पृशति यो नरः ।\nदेवयानस्तस्य पन्थाः चक्षुश्चैव प्रकाशते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2128892, "chapter_id": 3769, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2128893, "chapter_id": 3769, "verse_number": "१३", "content_sanskrit": "ततो वैतरणीं गत्वा पाण्डवा द्रौपदी तथा ।\nअवतीर्य महाभागाः तर्पयाञ्चक्रिरे पितॄन्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2128894, "chapter_id": 3769, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2128895, "chapter_id": 3769, "verse_number": "१४", "content_sanskrit": "उपस्पृश्यैव भगवन्नस्यां नद्यां तपोधन ।\nमानुषादस्मि विषयाद् अपेतः पश्य लोमश\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2128896, "chapter_id": 3769, "verse_number": "१५", "content_sanskrit": "दिव्यान् लोकान् प्रपश्यामि प्रसादात् तव सुव्रत ।\nवैखानसानां जपतामेष शब्दो महात्मनाम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2128897, "chapter_id": 3769, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2128898, "chapter_id": 3769, "verse_number": "१६", "content_sanskrit": "त्रिंशद् भूमेः सहस्राणि योजनानां युधिष्ठिर ।\nयत्र ध्वनिं शृणोष्येनं तूष्णीमास्स्व विशाम्पते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2128899, "chapter_id": 3769, "verse_number": "१७", "content_sanskrit": "एतत् स्वायम्भुवं राजन् वनं दिव्यं प्रकाशते ।\nयत्रायजत धर्मात्मा विश्वकर्मा प्रतापवान्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2128900, "chapter_id": 3769, "verse_number": "१८", "content_sanskrit": "यस्मिन् यज्ञे हि भूर्दत्ता काश्यपाय महात्मने ।\nसपर्वतवनोद्देशा दक्षिणा वै स्वयम्भुवा \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2128901, "chapter_id": 3769, "verse_number": "१९", "content_sanskrit": "अवासीदच्च कौन्तेय दत्तमात्रा मही तदा ।\nउवाच चापि कुपिता लोकेश्वरमिदं वचः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2128902, "chapter_id": 3769, "verse_number": "२०", "content_sanskrit": "न मां मर्त्याय भगवन् कस्मैचिद् दातुमर्हसि ।\nप्रदानं मोघमेतत् ते यास्याम्येषा रसातळम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2128903, "chapter_id": 3769, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2128904, "chapter_id": 3769, "verse_number": "२१", "content_sanskrit": "विषीदन्ती तु तां दृष्ट्वा काश्यपो भगवानृषिः ।\nप्रसादयांबभूवाथ ततो भूंमिं विशांपते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2128905, "chapter_id": 3769, "verse_number": "२२", "content_sanskrit": "ततः प्रसन्ना पृथिवी तपसा तस्य पाण्डव ।\nपुनरुत्सृष्टसलिला वेदिर्भूत्वा स्थिता बभौ \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2128906, "chapter_id": 3769, "verse_number": "२३", "content_sanskrit": "सैषा प्रकाशते राजन् वेदीसंस्थानलक्षणा ।\nआरोहात्र महाराज वीर्यवांस्त्वं भविष्यसि\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2128907, "chapter_id": 3769, "verse_number": "२४", "content_sanskrit": "अहं च ते स्वस्त्ययनं प्रयोक्ष्ये\nयथा त्वमेनामधिरोक्ष्यसेऽद्य ।\nस्पृष्टा हि मर्त्येन ततः समुद्रम्\nएषा वेदिः प्रविशत्याजमीढ \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2128908, "chapter_id": 3769, "verse_number": "२५", "content_sanskrit": "अग्निर्मित्रो योनिरापोऽथ देव्यो\nविष्णो रेतश्चास्य भूमिश्च नाभिः ।\nएवं ब्रुवन् पाण्डव सत्यवाक्यं\nवेदीमिमां त्वं तरसाऽधिरोह\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2128909, "chapter_id": 3769, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2128910, "chapter_id": 3769, "verse_number": "२६", "content_sanskrit": "ततः कृतस्वस्त्ययनो महात्मा\nयुधिष्ठिरः सागरगामगच्छत् ।\nकृत्वा च तच्छासनमस्य सर्वं\nमहेन्द्रमासाद्य निशामुवास\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2128911, "chapter_id": 3769, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि एकादशोत्तरशततमोऽध्यायः ॥१११॥\n॥ तीर्थयात्रापर्वणि सप्तषष्टितमोऽध्यायः ॥६७॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]