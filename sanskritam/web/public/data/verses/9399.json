[{"id": 5000399000, "chapter_id": 9399, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे षष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000399001, "chapter_id": 9399, "verse_number": "५-६०-१", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा वालिसूनुरभाषत।\nअश्विपुत्रौ महावेगौ बलवन्तौ प्लवंगमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000399002, "chapter_id": 9399, "verse_number": "५-६०-२", "content_sanskrit": "पितामहवरोत्सेकात् परमं दर्पमास्थितौ।\nअश्विनोर्माननार्थं हि सर्वलोकपितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000399003, "chapter_id": 9399, "verse_number": "५-६०-३", "content_sanskrit": "सर्वावध्यत्वमतुलमनयोर्दत्तवान् पुरा।\nवरोत्सेकेन मत्तौ च प्रमथ्य महतीं चमूम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000399004, "chapter_id": 9399, "verse_number": "५-६०-४", "content_sanskrit": "सुराणाममृतं वीरौ पीतवन्तौ महाबलौ।\nएतावेव हि संक्रुद्धौ सवाजिरथकुञ्जराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000399005, "chapter_id": 9399, "verse_number": "५-६०-५", "content_sanskrit": "लङ्कां नाशयितुं शक्तौ सर्वे तिष्ठन्तु वानराः।\nअहमेकोऽपि पर्याप्तः सराक्षसगणां पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000399006, "chapter_id": 9399, "verse_number": "५-६०-६", "content_sanskrit": "तां लङ्कां तरसा हन्तुं रावणं च महाबलम्।\nकिं पुनः सहितो वीरैर्बलवद्भिः कृतात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000399007, "chapter_id": 9399, "verse_number": "५-६०-७", "content_sanskrit": "कृतास्त्रैः प्लवगैः शक्तैर्भवद्भिर्विजयैषिभिः।\nवायुसूनोर्बलेनैव दग्धा लङ्केति नः श्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000399008, "chapter_id": 9399, "verse_number": "५-६०-८", "content_sanskrit": "दृष्टा देवी न चानीता इति तत्र निवेदितुम्।\nन युक्तमिव पश्यामि भवद्भिः ख्यातपौरुषैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000399009, "chapter_id": 9399, "verse_number": "५-६०-९", "content_sanskrit": "नहि वः प्लवने कश्चिन्नापि कश्चित् पराक्रमे।\nतुल्यः सामरदैत्येषु लोकेषु हरिसत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000399010, "chapter_id": 9399, "verse_number": "५-६०-१०", "content_sanskrit": "जित्वा लङ्कां सरक्षौघां हत्वा तं रावणं रणे।\nसीतामादाय गच्छामः सिद्धार्था हृष्टमानसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000399011, "chapter_id": 9399, "verse_number": "५-६०-११", "content_sanskrit": "तेष्वेवं हतवीरेषु राक्षसेषु हनूमता।\nकिमन्यदत्र कर्तव्यं गृहीत्वा याम जानकीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000399012, "chapter_id": 9399, "verse_number": "५-६०-१२", "content_sanskrit": "रामलक्ष्मणयोर्मध्ये न्यस्याम जनकात्मजाम्।\nकिं व्यलीकैस्तु तान् सर्वान् वानरान् वानरर्षभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000399013, "chapter_id": 9399, "verse_number": "५-६०-१३", "content_sanskrit": "वयमेव हि गत्वा तान् हत्वा राक्षसपुङ्गवान्।\nराघवं द्रष्टुमर्हामः सुग्रीवं सहलक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000399014, "chapter_id": 9399, "verse_number": "५-६०-१४", "content_sanskrit": "तमेवं कृतसंकल्पं जाम्बवान् हरिसत्तमः।\nउवाच परमप्रीतो वाक्यमर्थवदर्थवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000399015, "chapter_id": 9399, "verse_number": "५-६०-१५", "content_sanskrit": "नैषा बुद्धिर्महाबुद्धे यद् ब्रवीषि महाकपे।\nविचेतुं वयमाज्ञप्ता दक्षिणां दिशमुत्तमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000399016, "chapter_id": 9399, "verse_number": "५-६०-१६", "content_sanskrit": "नानेतुं कपिराजेन नैव रामेण धीमता।\nकथंचिन्निर्जितां सीतामस्माभिर्नाभिरोचयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000399017, "chapter_id": 9399, "verse_number": "५-६०-१७", "content_sanskrit": "राघवो नृपशार्दूलः कुलं व्यपदिशन् स्वकम्।\nप्रतिज्ञाय स्वयं राजा सीताविजयमग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000399018, "chapter_id": 9399, "verse_number": "५-६०-१८", "content_sanskrit": "सर्वेषां कपिमुख्यानां कथं मिथ्या करिष्यति।\nविफलं कर्म च कृतं भवेत् तुष्टिर्न तस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000399019, "chapter_id": 9399, "verse_number": "५-६०-१९", "content_sanskrit": "वृथा च दर्शितं वीर्यं भवेद् वानरपुङ्गवाः।\nतस्माद् गच्छाम वै सर्वे यत्र रामः सलक्ष्मणः।\nसुग्रीवश्च महातेजाः कार्यस्यास्य निवेदने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000399020, "chapter_id": 9399, "verse_number": "५-६०-२०", "content_sanskrit": "न तावदेषा मतिरक्षमा नो\nयथा भवान् पश्यति राजपुत्र।\nयथा तु रामस्य मतिर्निविष्टा\nतथा भवान् पश्यतु कार्यसिद्धिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000399021, "chapter_id": 9399, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे षष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]