[{"id": 2201323, "chapter_id": 5288, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2201324, "chapter_id": 5288, "verse_number": "१", "content_sanskrit": "यदिदं श्राद्धधर्मेषु दीयते भरतर्षभ ।\nछत्रं चोपानहौ चैव केनैतत् सम्प्रवर्तितम् ।\nकथं चैतत् समुत्पन्नं किमर्थं च प्रदीयते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2201325, "chapter_id": 5288, "verse_number": "२", "content_sanskrit": "न केवलं श्राद्धधर्मे पुण्यकेष्वपि दीयते ।\nएतद् विस्तरतो राजन् श्रोतुमिच्छामि तत्त्वतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2201326, "chapter_id": 5288, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2201327, "chapter_id": 5288, "verse_number": "३", "content_sanskrit": "शृणु राजन्नवहितश्छत्रोपानहविस्तरम् ।\nयथैतत् प्रथितं लोके येन चैतत् प्रवर्तितम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2201328, "chapter_id": 5288, "verse_number": "४", "content_sanskrit": "यथा चाक्षय्यतां प्राप्तं पुण्यतां च यथा गतम् ।\nसर्वमेतदशेषेण प्रवक्ष्यामि जनाधिप\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2201329, "chapter_id": 5288, "verse_number": "समाप्तिः", "content_sanskrit": "इतिहासं पुरावृत्तमिमं शृणु नराधिप ।\nजमदग्नेश्च संवादं सूर्यस्य च महात्मनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2201330, "chapter_id": 5288, "verse_number": "६", "content_sanskrit": "पुरा स भगवान् साक्षाद् धनुषाऽक्रीडत प्रभो ।\nसन्धाय सन्धाय शरान् चिक्षेप किल भार्गवः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2201331, "chapter_id": 5288, "verse_number": "७", "content_sanskrit": "तान् क्षिप्तान् रेणुका सर्वांस्तस्येषून् दीप्ततेजसः ।\nआनाय्य सा तदा तस्मै प्रादादसकृदच्युत\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2201332, "chapter_id": 5288, "verse_number": "८", "content_sanskrit": "अथ तेन स शब्देन ज्यातळस्य शरस्य च ।\nप्रहृष्टः सम्प्रचिक्षेप सा च प्रत्याजहार तान्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2201333, "chapter_id": 5288, "verse_number": "९", "content_sanskrit": "ततो मध्याह्नमारूढे ज्येष्ठामूले दिवाकरे ।\nस सायकान् द्विजो विद्ध्वा रेणुकामिदमब्रवीत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2201334, "chapter_id": 5288, "verse_number": "१०", "content_sanskrit": "गच्छानय विशालाक्षि शरानेतान् धनुश्च्युतान् ।\nयावदेतान् पुनः सुभ्रु क्षिपामीति जनाधिप\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2201335, "chapter_id": 5288, "verse_number": "११", "content_sanskrit": "सा गच्छत्यन्तरा छायावृक्षमाश्रित्य भामिनी ।\nतस्थौ तस्या हि सन्तप्तं शिरः पादौ तथैव च\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2201336, "chapter_id": 5288, "verse_number": "१२", "content_sanskrit": "स्थिता सा तु मुहूर्तं वै भर्तुः शापभयाच्छुभा ।\nययावानयितुं भूयः सायकानसितेक्षणा ।\nप्रत्याजगाम च शरांस्तानादाय यशस्विनी\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2201337, "chapter_id": 5288, "verse_number": "१३", "content_sanskrit": "सा प्रस्विन्ना सुचार्वङ्गी पद्भ्यां दुःखं नियच्छती ।\nउपाजगाम भर्तारं भयाद् भर्तुः प्रवेपती\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2201338, "chapter_id": 5288, "verse_number": "१४", "content_sanskrit": "स तामृषिस्ततः क्रुद्धो वाक्यमाह शुभाननाम् ।\nरेणुके किं चिरेण त्वमागतेति पुनः पुनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2201339, "chapter_id": 5288, "verse_number": "", "content_sanskrit": "रेणुका", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2201340, "chapter_id": 5288, "verse_number": "१५", "content_sanskrit": "शिरस्तावत् प्रदीप्तं मे पादौ चैव तपोधन ।\nसूर्यतेजोनिरुद्धाऽहं वृक्षच्छायामुपाश्रिता\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2201341, "chapter_id": 5288, "verse_number": "१६", "content_sanskrit": "एतस्मात् कारणाद् ब्रह्मन् चिरमेतत् कृतं मया ।\nएतज्ज्ञात्वा मम विभो मा क्रुधस्त्वं तपोधन\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2201342, "chapter_id": 5288, "verse_number": "", "content_sanskrit": "जमदग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2201343, "chapter_id": 5288, "verse_number": "१७", "content_sanskrit": "अद्यैनं दीप्तकिरणं रेणुके तव दुःखदम् ।\nशरैर्निपातयिष्यामि सूर्यमस्त्राग्नितेजसा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2201344, "chapter_id": 5288, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2201345, "chapter_id": 5288, "verse_number": "१८", "content_sanskrit": "स विस्फार्य धनुर्दिव्यं गृहीत्वा च बहून् शरान् ।\nअतिष्ठत् सूर्यमभितो यतो याति ततोमुखः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2201346, "chapter_id": 5288, "verse_number": "१९", "content_sanskrit": "अथ तं प्रहरिष्यन्तं सूर्योऽभ्येत्य वचोऽब्रवीत् ।\nद्विजरूपेण कौन्तेय किं ते सूर्योऽपराध्यते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2201347, "chapter_id": 5288, "verse_number": "२०", "content_sanskrit": "आदत्ते रश्मिभिः सूर्यो दिवि विद्वन् ततस्ततः ।\nरसं स तं वै वर्षासु प्रवर्षति दिवाकरः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2201348, "chapter_id": 5288, "verse_number": "२१", "content_sanskrit": "ततोऽन्नं जायते विप्र मनुष्याणां सुखावहम् ।\nअन्नं प्राणा इति यथा वेदेषु परिपठ्यते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2201349, "chapter_id": 5288, "verse_number": "२२", "content_sanskrit": "अथाभ्रेषु निगूढश्च रश्मिभिः परिवारितः ।\nसप्त द्वीपानिमान् ब्रह्मन् वर्षेणाभिप्रवर्षति\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2201350, "chapter_id": 5288, "verse_number": "२३", "content_sanskrit": "ततस्तदौषधीनां च वीरुधां पत्रपुष्पजम् ।\nसर्वं वर्षाभिनिर्वृत्तमन्नं सम्भवति प्रभो\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2201351, "chapter_id": 5288, "verse_number": "२४", "content_sanskrit": "जातकर्माणि सर्वाणि व्रतोपनयनानि च ।\nगोदानानि विवाहाश्च तथा यज्ञसमृद्धयः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2201352, "chapter_id": 5288, "verse_number": "२५", "content_sanskrit": "सत्राणि दानानि तथा संयोगा वित्तसञ्चयाः ।\nअन्नतः सम्प्रवर्तन्ते यथा त्वं वेत्थ भार्गव\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2201353, "chapter_id": 5288, "verse_number": "२६", "content_sanskrit": "रमणीयानि यावन्ति यावदारम्भकाणि च ।\nसर्वमन्नात् प्रभवति विदितं कीर्तयामि ते\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2201354, "chapter_id": 5288, "verse_number": "२७", "content_sanskrit": "सर्वं हि वेत्थ विप्र त्वं यदेतत् कीर्तितं मया ।\nप्रसादये त्वा विप्रर्षे किं ते सूर्यो निपात्यते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2201355, "chapter_id": 5288, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे अन्नप्रशंसा नाम एकोनचत्वारिंशोत्तरशततमोऽध्यायः ॥१३९॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]