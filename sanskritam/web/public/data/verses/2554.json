[{"id": 2073655, "chapter_id": 2554, "verse_number": "१२-५९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2073656, "chapter_id": 2554, "verse_number": "१२-५९-१", "content_sanskrit": "ततः पुनः स गाङ्गेयमभिवाद्य पितामहम्।\nप्राञ्जलिर्नियतो भूत्वा पर्यपृच्छद्युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2073657, "chapter_id": 2554, "verse_number": "१२-५९-२", "content_sanskrit": "के धर्माः सर्ववर्णानां चातुर्वर्ण्यस्य के पृथक्।\nचातुर्वर्ण्याश्रमाणां च राजधर्माश्च के मताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2073658, "chapter_id": 2554, "verse_number": "१२-५९-३", "content_sanskrit": "केन वै वर्धते राष्ट्रं राजा केन विवर्धते।\nकेन पौराश्च भृत्याश्च वर्धन्ते भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2073659, "chapter_id": 2554, "verse_number": "१२-५९-४", "content_sanskrit": "कोशं दण्डं च दुर्गं च सहायान्मन्त्रिणस्तथा।\nऋत्विक्पुरोहिताचार्यान्कीदृशान्वर्जयेन्नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2073660, "chapter_id": 2554, "verse_number": "१२-५९-५", "content_sanskrit": "केषु विश्वसितव्यं स्याद्राज्ञा कस्यांचिदापदि।\nकुतो वाऽऽत्मा दृढं रक्ष्यस्तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2073661, "chapter_id": 2554, "verse_number": "१२-५९-६", "content_sanskrit": "`द्वैधीभावे च भृत्यानां शपथः कीदृशो भवेत्।\nअधर्मस्य फलं यच्च शपथस्य विलङ्घने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2073662, "chapter_id": 2554, "verse_number": "१२-५९-७", "content_sanskrit": "सर्वमेतद्यथातत्वं व्यवहारं च तादृशम्।\nसमासव्यासयोगेन कथयस्व पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2073663, "chapter_id": 2554, "verse_number": "१२-५९-८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2073664, "chapter_id": 2554, "verse_number": "१२-५९-८", "content_sanskrit": "नमो धर्माय महते नमः कृष्णाय वेधसे।\nब्राह्मणेभ्यो नमस्कृत्य धर्मान्वक्ष्यामि शाश्वतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2073665, "chapter_id": 2554, "verse_number": "१२-५९-९", "content_sanskrit": "अक्रोधः सत्यवचनं संविभागश्च सर्वशः।\nप्रजनं स्वेषु दारेषु शौचमद्रोह एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2073666, "chapter_id": 2554, "verse_number": "१२-५९-१०", "content_sanskrit": "आर्जवं भृत्यभरणं त एते सार्ववर्णिकाः।\nब्राह्मणस्य तु यो धर्मस्तं ते वक्ष्यामि केवलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2073667, "chapter_id": 2554, "verse_number": "१२-५९-११", "content_sanskrit": "दममेव महाराज धर्ममाहुः पुरातनम्।\nस्वाध्यायोऽध्यापनं चैव तत्र कर्म समाप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2073668, "chapter_id": 2554, "verse_number": "१२-५९-१२", "content_sanskrit": "तं चेद्द्विजमुपागच्छेद्वर्तमानं स्वकर्मणि।\nअकुर्वाणं विकर्माणि शान्तं प्रज्ञानतर्पितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2073669, "chapter_id": 2554, "verse_number": "१२-५९-१३", "content_sanskrit": "कुर्वीतापत्यसंतानमथो दद्याद्यजेत च।\nसंविभज्य च भोक्तव्यं धनं सद्भिरीतीष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2073670, "chapter_id": 2554, "verse_number": "१२-५९-१४", "content_sanskrit": "परिनिष्ठितकार्यस्तु स्वाध्यायेनैव वै द्विजः।\nकुर्यादन्यन्न वा कुर्यान्मैत्रो ब्राह्मण उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2073671, "chapter_id": 2554, "verse_number": "१२-५९-१५", "content_sanskrit": "क्षत्रियस्यापि यो धर्मस्तं ते वक्ष्यामि भारत।\nदद्याद्राजा न याचेत यजेत न च याजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2073672, "chapter_id": 2554, "verse_number": "१२-५९-१६", "content_sanskrit": "नाध्यापयेदधीयीत प्रजाश्च परिपालयेत्।\nनित्योद्युक्तो दस्युवदे रणे कुर्यात्पराक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2073673, "chapter_id": 2554, "verse_number": "१२-५९-१७", "content_sanskrit": "ये तु क्रतुभिरीजानाः श्रुतवन्तश्च भूमिपाः।\nय एवाहवजेतारस्त एषां लोकजित्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2073674, "chapter_id": 2554, "verse_number": "१२-५९-१८", "content_sanskrit": "अविक्षतेन देहेन समराद्यो निवर्तते।\nक्षत्रियो नास्य तत्कर्म प्रशंसन्ति पुराविदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2073675, "chapter_id": 2554, "verse_number": "१२-५९-१९", "content_sanskrit": "एवं हि क्षत्रबन्धूनां धर्ममाहुः प्रधानतः।\nनास्य कृत्यतमं किंचिदन्यद्दस्युनिबर्हणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2073676, "chapter_id": 2554, "verse_number": "१२-५९-२०", "content_sanskrit": "दानमध्ययनं यज्ञो राज्ञां क्षेमो विधीयते।\nतस्माद्राज्ञा विशेषेण योद्धव्यं धर्ममीप्सता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2073677, "chapter_id": 2554, "verse_number": "१२-५९-२१", "content_sanskrit": "स्वेषु धर्मेष्ववस्थाप्यः प्रजाः सर्वा महीपतिः।\nधर्मेण सर्वकृत्यानि शमनिष्ठानि कारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2073678, "chapter_id": 2554, "verse_number": "१२-५९-२२", "content_sanskrit": "परिनिष्ठितकार्यस्तु नृपतिः परिपालनात्।\nकुर्यादन्यन्न वा कुर्यादैन्द्रो राजन्य उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2073679, "chapter_id": 2554, "verse_number": "१२-५९-२३", "content_sanskrit": "वैश्यस्यापि हि यो धर्मस्तं ते वक्ष्यामि शाश्वतम्।\nदानमध्ययनं यज्ञः शौचेन धनसंचयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2073680, "chapter_id": 2554, "verse_number": "१२-५९-२४", "content_sanskrit": "पितृवत्पालयेद्वैश्यो युक्तः सर्वान्पशूनिह।\nविकर्म तद्भवेदन्यत्कर्म यत्स समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2073681, "chapter_id": 2554, "verse_number": "१२-५९-२५", "content_sanskrit": "रक्षया स हि तेषां वै महत्सुखमवाप्नुयात्।\nप्रजापतिर्हि वैश्याय सृष्ट्वा परिददौ पशून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2073682, "chapter_id": 2554, "verse_number": "१२-५९-२६", "content_sanskrit": "ब्राह्मणाय च राज्ञे च सर्वाः परिददे प्रजाः।\nतस्य वृत्तिं प्रवक्ष्यामि यच्च तस्योपजीवनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2073683, "chapter_id": 2554, "verse_number": "१२-५९-२७", "content_sanskrit": "पण्णामेकां पिबेद्धेनुं शताच्च मिथुनं हरेत्।\nलये च सप्तमो भागस्तथा शृङ्गे कला खुरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2073684, "chapter_id": 2554, "verse_number": "१२-५९-२८", "content_sanskrit": "सस्यानां सर्वबीजानामेषा सांवत्सरी भृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2073685, "chapter_id": 2554, "verse_number": "१२-५९-२९", "content_sanskrit": "न च वैश्यस्य कामः स्यान्न रक्षेयं पशूनिति।\nवैश्ये चेच्छति नान्येन रक्षितव्याः कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2073686, "chapter_id": 2554, "verse_number": "१२-५९-३०", "content_sanskrit": "शूद्रस्यापि हि यो धर्मस्तं ते वक्ष्यामि भारत।\nप्रजापतिर्हि वर्णानां दासं शूद्रमकल्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2073687, "chapter_id": 2554, "verse_number": "१२-५९-३१", "content_sanskrit": "तस्माच्छूद्रस्य वर्णानां परिचर्या विधीयते।\nतेषां शुश्रूषणाच्चैव महत्सुखमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2073688, "chapter_id": 2554, "verse_number": "१२-५९-३२", "content_sanskrit": "शूद्र एतान्परिचरेत्रीन्वर्णाननसूयकः।\nसंचयांश्च न कुर्वीत जातु शूद्रः कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2073689, "chapter_id": 2554, "verse_number": "१२-५९-३३", "content_sanskrit": "पापीयान्हि धनं लब्ध्वा वशे कुर्याद्गरीयसः।\nराज्ञा वा समनुज्ञातः कामं कुर्वीत धार्मिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2073690, "chapter_id": 2554, "verse_number": "१२-५९-३४", "content_sanskrit": "तस्य वृत्तिं प्रवक्ष्यामि यच्च तस्योपजीवनम्।\nअवश्यं भरणीयो हि वर्णानां शूद्र उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2073691, "chapter_id": 2554, "verse_number": "१२-५९-३५", "content_sanskrit": "छत्रं वेष्टनमौशीरमुपानद्व्यजनानि च।\nयातयामानि देयानि शूद्राय परिचारिणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2073692, "chapter_id": 2554, "verse_number": "१२-५९-३६", "content_sanskrit": "अधार्याणि विशीर्णानि वसनानि द्विजातिभिः।\nशूद्रायैव प्रदेयानि तस्य धर्मधनं हि तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2073693, "chapter_id": 2554, "verse_number": "१२-५९-३७", "content_sanskrit": "यंच कश्चिद्द्विजातीनां शूद्रः शुश्रूषुराव्रजेत्।\nकल्प्यां तेन तु तस्याहुर्वृत्तिं धर्मविदो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2073694, "chapter_id": 2554, "verse_number": "१२-५९-३८", "content_sanskrit": "देयः पिण्डोऽनपत्याय भर्तव्यौ वृद्धदुर्बलौ।\nशूद्रेण तु न हातव्यो भर्ता कस्यांचिदापदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2073695, "chapter_id": 2554, "verse_number": "१२-५९-३९", "content_sanskrit": "अतिरेकेण भर्तव्यो भर्ता द्रव्यपरिक्षये।\nन हि स्वमस्ति शूद्रस्य भर्तृहार्यधनो हि सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2073696, "chapter_id": 2554, "verse_number": "१२-५९-४०", "content_sanskrit": "उक्तस्त्रयाणां वर्णानां यज्ञस्त्रय्येव भारत।\nस्वाहाकारवषट्कारौ मन्त्रः शूद्रे न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2073697, "chapter_id": 2554, "verse_number": "१२-५९-४१", "content_sanskrit": "तस्माच्छूद्रः पाकयज्ञैयजेताव्रतवान्स्वयम्।\nपूर्णपात्रमयीमाहुः पाकयज्ञस्य दक्षिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2073698, "chapter_id": 2554, "verse_number": "१२-५९-४२", "content_sanskrit": "शूद्रः पैजवनो नाम सहस्राणां शतं ददौ।\nऐन्द्राग्नेन विधानेन दक्षिणामिति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2073699, "chapter_id": 2554, "verse_number": "१२-५९-४३", "content_sanskrit": "यतो हि सर्ववर्णानां यज्ञस्तस्यैव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2073700, "chapter_id": 2554, "verse_number": "१२-५९-४४", "content_sanskrit": "अग्रे सर्वेषु यज्ञेषु श्रद्धायज्ञो विधीयते।\nदैवतं हि महच्छ्रद्धा पवित्रं यजतां च यत्।\nदैवतं हि परं विप्राः स्वेनस्वेन परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2073701, "chapter_id": 2554, "verse_number": "१२-५९-४५", "content_sanskrit": "अयजन्निह सत्रैस्ते तैस्तैः कामैः समाहिताः।\nसंसृष्टा ब्राह्मणैरेव त्रिषु वर्णेषु सृष्टयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2073702, "chapter_id": 2554, "verse_number": "१२-५९-४६", "content_sanskrit": "देवानामपि ये देवा यद्ब्रूयुस्ते परं हितम्।\nतस्माद्वर्णैः सर्वयज्ञाः संसृज्यन्ते न काम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2073703, "chapter_id": 2554, "verse_number": "१२-५९-४७", "content_sanskrit": "ऋग्यजुः सामवित्पूज्यो नित्यं स्याद्देववद्द्विजः।\nअनृग्यजुरसामा च प्राजापत्य उपद्रवः।\nयज्ञो मनीषया तात सर्ववर्णेषु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2073704, "chapter_id": 2554, "verse_number": "१२-५९-४८", "content_sanskrit": "नास्य यज्ञकृतो देवा ईहन्ते नेतरे जनाः।\nततः सर्वेषु वर्णेषु श्रद्धायज्ञो विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2073705, "chapter_id": 2554, "verse_number": "१२-५९-४९", "content_sanskrit": "स्वं दैवतं ब्राह्मणः स्वेन नित्यं\nपरान्वर्णानयजन्नैवमासीत्।\nअधरो वितानस्त्वथ तत्र सृष्टो\nन ब्राह्मणस्त्रिषु वर्णेषु राजन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2073706, "chapter_id": 2554, "verse_number": "१२-५९-५०", "content_sanskrit": "तस्माद्वर्णा ऋजवो ज्ञातिवर्णाः\nसंसृज्यन्ते तस्य विकार एव।\nएकं साम यजुरेकमृगेका\nविप्रश्वैको निश्चये तेषु सृष्टः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2073707, "chapter_id": 2554, "verse_number": "१२-५९-५१", "content_sanskrit": "अत्र गाथा यज्ञगीताः कीर्तयन्ति पुराविदः।\nवैखानसानां राजेन्द्र मुनीनां यष्टुमिच्छताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2073708, "chapter_id": 2554, "verse_number": "१२-५९-५२", "content_sanskrit": "उदितेऽनुदिते वाऽपि श्रद्दधानो जितेन्द्रियः।\nवह्निं जुहोति धर्मेण श्रद्धा वै कारणं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2073709, "chapter_id": 2554, "verse_number": "१२-५९-५३", "content_sanskrit": "यत्स्कन्नमस्य तत्पूर्वं यदस्कन्नं तदुत्तरम्।\nबहूनि यज्ञरूपाणि नानाकर्मफलानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2073710, "chapter_id": 2554, "verse_number": "१२-५९-५४", "content_sanskrit": "तानि यः संप्रजानाति ज्ञाननिश्चयनिश्चितः।\nद्विजातिः श्रद्धयोपेतः स यष्टुं पुरुषोऽर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2073711, "chapter_id": 2554, "verse_number": "१२-५९-५५", "content_sanskrit": "स्तेनो वा यदि वा पापो यदि वा पापकृत्तमः।\nयष्टुमिच्छति यज्ञं यः साधुमेव वदन्ति तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2073712, "chapter_id": 2554, "verse_number": "१२-५९-५६", "content_sanskrit": "ऋषयस्तं प्रशंसन्ति साधु चैतदसंशयम्।\nसर्वथा सर्वदा वर्णैर्यष्टव्यमिति निर्णयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2073713, "chapter_id": 2554, "verse_number": "१२-५९-५७", "content_sanskrit": "न हि यज्ञसमं किंचित्रिषु लोकेषु विद्यते।\nतस्माद्यष्टव्यमित्याहुः पुरुषेणानसूयता।\nश्रद्धापवित्रमाश्रित्य यथाशक्ति यथेच्छया॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2073714, "chapter_id": 2554, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि एकोनषष्टितमोऽध्यायः॥ ५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]