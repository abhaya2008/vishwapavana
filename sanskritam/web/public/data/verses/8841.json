[{"id": 40001703, "chapter_id": 8841, "verse_number": "1", "content_sanskrit": "उक्तवाक्यं तु राजानं कृपया कुशिकात्मज:। अब्रवीन्मधुरं वाक्यं साक्षाच्चण्डालरूपिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40001704, "chapter_id": 8841, "verse_number": "2", "content_sanskrit": "ऐक्ष्वाक स्वागतं वत्स जानामि त्वां सुधार्मिकम् । शरणं ते भविष्यामि मा भैषीर्नृपपुङ्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40001705, "chapter_id": 8841, "verse_number": "3", "content_sanskrit": "अहमामन्त्रये सर्वान्महर्षीन्पुण्यकर्मण:। यज्ञसाह्यकरान् राजन् ततो यक्ष्यसि निर्वृत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40001706, "chapter_id": 8841, "verse_number": "4", "content_sanskrit": "गुरुशापकृतं रूपं यदिदं त्वयि वर्तते । अनेन सह रूपेण सशरीरो गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40001707, "chapter_id": 8841, "verse_number": "5", "content_sanskrit": "हस्तप्राप्तमहं मन्ये स्वर्गं तव नराधिप। यस्त्वं कौशिकमागम्य शरण्यं शरणागत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40001708, "chapter_id": 8841, "verse_number": "6", "content_sanskrit": "एवमुक्त्वा महातेजा: पुत्रान् परमधार्मिकान्। व्यादिदेश महाप्राज्ञान् यज्ञसम्भारकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40001709, "chapter_id": 8841, "verse_number": "7", "content_sanskrit": "सर्वान् शिष्यान् समाहूय वाक्यमेतदुवाच ह। सर्वानृषिगणान्वत्सा आनयध्वं ममाज्ञया। सशिष्यसुहृदश्चैव सर्त्विज स्सबहुश्रुतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40001710, "chapter_id": 8841, "verse_number": "8", "content_sanskrit": "यदन्यो वचनं ब्रूयान्मद्वाक्यबलचोदित:। तत्सर्वमखिलेनोक्तं ममाख्येयमनादृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40001711, "chapter_id": 8841, "verse_number": "9", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा दिशो जग्मुस्तदाज्ञया। आजग्मुरथ देशेभ्य स्सर्वेभ्यो ब्रह्मवादिन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40001712, "chapter_id": 8841, "verse_number": "10", "content_sanskrit": "ते च शिष्या: समागम्य मुनिं ज्वलिततेजसम्। ऊचुश्चवचनं सर्वे सर्वेषां ब्रह्मवादिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40001713, "chapter_id": 8841, "verse_number": "11", "content_sanskrit": "श्रुत्वा ते वचनं सर्वे समायान्ति द्विजातय:। सर्वदेशेषु चागच्छन् वर्जयित्वा महोदयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40001714, "chapter_id": 8841, "verse_number": "12", "content_sanskrit": "वासिष्ठं तच्छतं सर्वं क्रोधपर्याकुलाक्षरम्। यदाह वचनं सर्वं शृणु त्वं मुनिपुङ्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40001715, "chapter_id": 8841, "verse_number": "13", "content_sanskrit": "क्षत्रियो याजको यस्य चण्डालस्य विशेषत:। कथं सदसि भोक्तारो हविस्तस्य सुरर्षय: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40001716, "chapter_id": 8841, "verse_number": "14", "content_sanskrit": "ब्राह्मणा वा महात्मानो भुक्त्वा चण्डालभोजनम्। कथं स्वर्गं गमिष्यन्ति विश्वामित्रेण पालिता: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40001717, "chapter_id": 8841, "verse_number": "15", "content_sanskrit": "एतद्वचननैष्ठुर्यमूचु स्संरक्तलोचना:। वासिष्ठा मुनिशार्दूल सर्वे ते समहोदया: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40001718, "chapter_id": 8841, "verse_number": "16", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा सर्वेषां मुनिपुङ्गव:। क्रोधसंरक्तनयन स्सरोषमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40001719, "chapter_id": 8841, "verse_number": "17", "content_sanskrit": "ये दूषयन्त्यदुष्टं मां तप उग्रं समास्थितम्। भस्मीभूता दुरात्मानो भविष्यन्ति न संशय: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40001720, "chapter_id": 8841, "verse_number": "18", "content_sanskrit": "अद्य ते कालपाशेन नीता वैवस्वतक्षयम्। सप्तजातिशतान्येव मृतपस्सन्तु सर्वश: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40001721, "chapter_id": 8841, "verse_number": "19", "content_sanskrit": "श्वमांसनियताहारा मुष्टिका नाम निर्घृणा:। विकृताश्च विरूपाश्च लोकाननुचरन्त्विमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40001722, "chapter_id": 8841, "verse_number": "20", "content_sanskrit": "महोदयस्तु दुर्बुद्धिर्मामदूष्यं ह्यदूषयत्। दूषित स्सर्वलोकेषु निषादत्वं गमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40001723, "chapter_id": 8841, "verse_number": "21", "content_sanskrit": "प्राणातिपातनिरतो निरनुक्रोशतां गत:। दीर्घकालं मम क्रोधाद्दुर्गतिं वर्तयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40001724, "chapter_id": 8841, "verse_number": "22", "content_sanskrit": "एतावदुक्त्वा वचनं विश्वामित्रो महातपा:। विरराम महातेजा ऋषिमध्ये महामुनि: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]