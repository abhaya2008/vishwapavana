[{"id": 7004060000, "chapter_id": 24060, "verse_number": "४-९-१", "content_sanskrit": "शिवशर्मोवाच ।\nका इमा रूपलावण्य सौभाग्यनिधयः स्त्रियः ।\nदिव्यालंकारधारिण्यो दिव्यभोगसमन्विताः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004060001, "chapter_id": 24060, "verse_number": "४-९-२", "content_sanskrit": "गणावूचतुः ।\nएता वारविलासिन्यो यज्ञभाजां प्रियंकराः ।\nगीतज्ञा नृत्यकुशला वाद्यविद्या विचक्षणाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004060002, "chapter_id": 24060, "verse_number": "४-९-३", "content_sanskrit": "कामकेलिकलाभिज्ञा द्यूतविद्याविशारदाः ।\nरसज्ञा भाववेदिन्यश्चतुराश्चोचितोक्तिषु ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004060003, "chapter_id": 24060, "verse_number": "४-९-४", "content_sanskrit": "नानादेश विशेषज्ञा नानाभाषा सुकोविदाः ।\nसंकेतोदंतनिपुणा नैकास्वैरचरा मुदा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004060004, "chapter_id": 24060, "verse_number": "४-९-५", "content_sanskrit": "लीलानर्मसुसाभिज्ञाः सुप्रलापेषु पंडिताः ।\nयूनां मनांसि सततं स्वैर्हावै रमयंत्यमूः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004060005, "chapter_id": 24060, "verse_number": "४-९-६", "content_sanskrit": "निर्मथ्यमानात्क्षीरोदात्पूर्वमप्सरसस्त्वमूः ।\nनिःसृतास्त्रिजगज्जेतुर्मोहनास्त्रमनोभुवः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004060006, "chapter_id": 24060, "verse_number": "४-९-७", "content_sanskrit": "उर्वशी मेनका रंभा चंद्रलेखा तिलोत्तमा ।\nवपुष्मतीकांतिमती लीलावत्युत्पलावती ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004060007, "chapter_id": 24060, "verse_number": "४-९-८", "content_sanskrit": "अलंबुषा गुणवती स्थूलकेशी कलावती ।\nकलानिधिर्गुणनिधिः कर्पूरतिलकोर्वरा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004060008, "chapter_id": 24060, "verse_number": "४-९-९", "content_sanskrit": "अनंगलतिका चापि तथा मदनमोहिनी ।\nचकोराक्षी चंद्रकला तथा मुनिमनोहरा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004060009, "chapter_id": 24060, "verse_number": "४-९-१०", "content_sanskrit": "ग्रावद्रावा तपोद्वेष्टी चारुनासा सुकर्णिका ।\nदारुसंजीविनी सुश्रीः क्रतुशुल्का शुभानना ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004060010, "chapter_id": 24060, "verse_number": "४-९-११", "content_sanskrit": "तपःशुल्का तीर्थशुल्का दानशुल्का हिमावती ।\nपंचाश्वमेधिका चैव राजसूयार्थिनी तथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004060011, "chapter_id": 24060, "verse_number": "४-९-१२", "content_sanskrit": "अष्टाग्निहोमिका तद्वद्वाजपेयशतोद्भवा ।\nइत्याद्यप्सरसां श्रेष्ठं सहस्रं षष्टिसंमितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004060012, "chapter_id": 24060, "verse_number": "४-९-१३", "content_sanskrit": "एतस्मिन्नप्सरोलोके वसंत्यन्या अपिस्त्रियः ।\nसदा स्खलितलावण्याः सदास्खलितयौवनाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004060013, "chapter_id": 24060, "verse_number": "४-९-१४", "content_sanskrit": "दिव्यांबरा दिव्यमाल्या दिव्यगंधानुलेपनाः ।\nदिव्यभोगैः सुसंपन्नाः स्वेच्छाविधृतविग्रहाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004060014, "chapter_id": 24060, "verse_number": "४-९-१५", "content_sanskrit": "कृत्वा मासोपवासानि स्खलंति ब्रह्मचर्यतः ।\nसकृदेव द्विकृत्वो वा त्रिःकृत्वो दैवयोगतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004060015, "chapter_id": 24060, "verse_number": "४-९-१६", "content_sanskrit": "ता इमा दिव्यभोगिन्यो रूपलावण्यसंपदः ।\nनिवसंत्यप्सरोलोके सर्वकामसमन्विताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004060016, "chapter_id": 24060, "verse_number": "४-९-१७", "content_sanskrit": "कृत्वा व्रतानि सांगानि कामिकानि विधानतः ।\nभवंति स्वैरचारिण्यो देवभोग्या इहागताः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004060017, "chapter_id": 24060, "verse_number": "४-९-१८", "content_sanskrit": "पतिव्रतधृता नार्यो बलेन बलिना धृताः ।\nभर्तबुद्ध्यारमंतेतं कदाचित्ता इमा द्विज ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004060018, "chapter_id": 24060, "verse_number": "४-९-१९", "content_sanskrit": "भर्तरि प्रोषिते याश्च ब्रह्मचर्यव्रताः सदा ।\nविप्लवं ते सकृद्दैवात्ता एता वामलोचनाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004060019, "chapter_id": 24060, "verse_number": "४-९-२०", "content_sanskrit": "कुसुमानि सुगंधीनि सुवासं चंदनं तथा ।\nसुगौरं चापि कर्पूरं सुसूक्ष्माण्यंबराणि च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004060020, "chapter_id": 24060, "verse_number": "४-९-२१", "content_sanskrit": "पर्णानि ऋजुताराणि जीर्णानि कठिनानि च ।\nसाग्राणि स्वर्णवर्णानि स्थूलनीलशिराणि च ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004060021, "chapter_id": 24060, "verse_number": "४-९-२२", "content_sanskrit": "सुवासोपस्कराढ्यानि नागवल्ल्या द्विजोत्तम ।\nशय्याविचित्राभरणा रतिशालोचितानि च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004060022, "chapter_id": 24060, "verse_number": "४-९-२३", "content_sanskrit": "बहुकौतुकवस्तूनि समर्च्यद्विजदंपती ।\nभोगदानमिदं काम्यं प्रतिसंक्रमणं रवेः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004060023, "chapter_id": 24060, "verse_number": "४-९-२४", "content_sanskrit": "किंवा प्रतिव्यतीपातमेकसंवत्सरावधि ।\nकोदादिति च मंत्रेण या दद्याद्वरवर्णिनी ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004060024, "chapter_id": 24060, "verse_number": "४-९-२५", "content_sanskrit": "कामरूपधरो देवः प्रीयतामिति वादिनी ।\nसा श्रेष्ठाऽप्सरसां मध्ये वसेत्कल्पमिहांगना ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004060025, "chapter_id": 24060, "verse_number": "४-९-२६", "content_sanskrit": "कन्यारूपधराकाचिद्याभुक्ता केनचित्क्वचित् ।\nदेवरूपेण तं कालमारभ्य ब्रह्मचारिणी ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004060026, "chapter_id": 24060, "verse_number": "४-९-२७", "content_sanskrit": "तदेव वृत्तं ध्यायंती निधनं याति कालतः ।\nदिव्यरूपधरा सेह जायते दिव्य भोगभाक् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004060027, "chapter_id": 24060, "verse_number": "४-९-२८", "content_sanskrit": "निदानमप्सरोलोकस्येतिशृण्वन्द्विजाग्रणीः ।\nसौरं लोकमथ प्राप्य क्षणेन स विमानगः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004060028, "chapter_id": 24060, "verse_number": "४-९-२९", "content_sanskrit": "यथा कदंबकुसुमं किंजल्कैः सर्वतोवृतम् ।\nदेदीप्यमानं हि तथा समंताद्भानुभानुभिः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004060029, "chapter_id": 24060, "verse_number": "४-९-३०", "content_sanskrit": "दूराद्रविं स विज्ञाय धृततामरसद्वयम् ।\nनवभिर्योजनानां च सहस्रैः संमितेन ह ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004060030, "chapter_id": 24060, "verse_number": "४-९-३१", "content_sanskrit": "विचित्रेणैकचक्रेण सप्तसप्तियुतेन च ।\nअनूरुणाधिष्ठितेन पुरतोधृतरश्मिना ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004060031, "chapter_id": 24060, "verse_number": "४-९-३२", "content_sanskrit": "अप्सरोमुनिगंधर्व सर्पग्रामणि नैरृतैः ।\nस्यंदनेनातिजविना प्रणनाम कृतांजलिः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004060032, "chapter_id": 24060, "verse_number": "४-९-३३", "content_sanskrit": "तस्य प्रणामंदेवोपि भ्रूभंगेनानुमन्य च ।\nअतिदूरं नभोवर्त्म व्यतिचक्राम सक्षणात् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004060033, "chapter_id": 24060, "verse_number": "४-९-३४", "content_sanskrit": "प्रक्रांते द्युमणौ दूरं शिवशर्मातिशर्मवान् ।\nप्रोवाच भगवद्भक्तौ कथं लभ्यं रवेः पदम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004060034, "chapter_id": 24060, "verse_number": "४-९-३५", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुमाचक्षाथां ममाग्रतः ।\nसतां साप्तपदी मैत्री तन्मे मैत्र्या प्रणोदितौ ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004060035, "chapter_id": 24060, "verse_number": "४-९-३६", "content_sanskrit": "गणावूचतुः ।\nशृणु द्विज महाप्राज्ञ त्वय्यकथ्यं न किंचन ।\nसत्संगादेव साधूनां सत्कथा संप्रवर्तते ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004060036, "chapter_id": 24060, "verse_number": "४-९-३७", "content_sanskrit": "नियंता सर्वभूतानां य एकःकारणं परम् ।\nअनामा गोत्ररहितो रूपादि परिवर्जितः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004060037, "chapter_id": 24060, "verse_number": "४-९-३८", "content_sanskrit": "आविर्भाव तिरोभावौ यद्भूनर्तनवर्तिनौ ।\nस एव वक्ति सततं सर्वात्मा वेदपूरुषः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004060038, "chapter_id": 24060, "verse_number": "४-९-३९", "content_sanskrit": "योसावादित्यपुरुषः सोसावहमिति स्फुटम् ।\nअंधतमः प्रविशंति ये चैवान्यमुपासते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004060039, "chapter_id": 24060, "verse_number": "४-९-४०", "content_sanskrit": "निश्चितार्थां श्रुतिमिमां ब्राह्मणासो द्विजोत्तम ।\nतमेकमुपतिष्ठंते निश्चित्येति पुनःपुनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004060040, "chapter_id": 24060, "verse_number": "४-९-४१", "content_sanskrit": "उपलभ्य च सावित्रीं नोपतिष्ठेत यः पराम् ।\nकाले त्रिकालं सप्ताहात्स पतेन्नात्र संशयः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004060041, "chapter_id": 24060, "verse_number": "४-९-४२", "content_sanskrit": "तावत्प्रातर्जपंस्तिष्ठेद्यावदर्धोदयो रवेः ।\nआसनस्थो जपेन्मौनी प्रत्यगातारकोदयात् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004060042, "chapter_id": 24060, "verse_number": "४-९-४३", "content_sanskrit": "सादित्यां मध्यमां संध्यां जपेदादित्यसंमुखः ।\nकाललोपो न कर्तव्यस्ततः कालं प्रतीक्षयेत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004060043, "chapter_id": 24060, "verse_number": "४-९-४४", "content_sanskrit": "काले फलंत्योषधयः काले पुष्पंति पादपाः ।\nवर्षंति तोयदाः काले तस्मात्कालं न लंघयेत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004060044, "chapter_id": 24060, "verse_number": "४-९-४५", "content_sanskrit": "मंदेहदेहनाशार्थमुदयास्तमये रविः ।\nसमीहते द्विजोत्सृष्टं मंत्रतोयांजलित्रयम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004060045, "chapter_id": 24060, "verse_number": "४-९-४६", "content_sanskrit": "गायत्रीमंत्रतोयाढ्यं दत्तं येनांजलित्रयम् ।\nकाले सवित्रे किं न स्यात्तेन दत्तं जगत्त्रयम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004060046, "chapter_id": 24060, "verse_number": "४-९-४७", "content_sanskrit": "किं किं न सविता सूते काले सम्यगुपासितः ।\nआयुरारोग्यमैश्वर्यं वसूनि सपशूनि च ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004060047, "chapter_id": 24060, "verse_number": "४-९-४८", "content_sanskrit": "मित्रपुत्र कलत्राणि क्षेत्राणि विविधानि च ।\nभोगानष्टविधांश्चापि स्वर्गं चाप्यपवर्गकम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004060048, "chapter_id": 24060, "verse_number": "४-९-४९", "content_sanskrit": "अष्टादश सुविद्यासु मीमांसातिगरीयसी ।\nततोपि तर्कशास्त्राणि पुराणं तेभ्य एव च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004060049, "chapter_id": 24060, "verse_number": "४-९-५०", "content_sanskrit": "ततोपि धर्मशास्त्राणि तेभ्यो गुर्वी श्रुतिर्द्विज ।\nततोप्युपनिषच्छ्रेष्ठा गायत्री च ततोधिका ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004060050, "chapter_id": 24060, "verse_number": "४-९-५१", "content_sanskrit": "दुर्लभा सर्वमंत्रेषु गायत्री प्रणवान्विता ।\nन गायत्र्याधिकं किंचित्त्रयीषु परिगीयते ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004060051, "chapter_id": 24060, "verse_number": "४-९-५२", "content_sanskrit": "न गायत्री समो मंत्रो न काशी सदृशी पुरी ।\nन विश्वेश समं लिंगं सत्यंसत्यं पुनःपुनः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004060052, "chapter_id": 24060, "verse_number": "४-९-५३", "content_sanskrit": "गायत्री वेदजननी गायत्री ब्राह्मणप्रसूः ।\nगातारं त्रायते यस्माद्गायत्री तेन गीयते ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004060053, "chapter_id": 24060, "verse_number": "४-९-५४", "content_sanskrit": "वाच्यवाचकसंबंधो गायत्र्याः सवितुर्द्वयोः ।\nवाच्योसौ सविता साक्षाद्गायत्रीवाचिकापरा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004060054, "chapter_id": 24060, "verse_number": "४-९-५५", "content_sanskrit": "प्रभावेणैव गायत्र्याः क्षत्रियः कौशिको वशी ।\nराजर्षित्वं परित्यज्य ब्रह्मर्षिपदमीयिवान् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004060055, "chapter_id": 24060, "verse_number": "४-९-५६", "content_sanskrit": "सामर्थ्यं प्राप चात्युच्चैरन्यद्भुवनसर्जने ।\nकिं किं न दद्याद्गायत्री सम्यगेवमुपासिता ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004060056, "chapter_id": 24060, "verse_number": "४-९-५७", "content_sanskrit": "न ब्राह्मणो वेदपाठान्न शास्त्रपठनादपि ।\nदेव्यास्त्रिकालमभ्यासाद्बाह्मणः स्याद्धि नान्यथा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004060057, "chapter_id": 24060, "verse_number": "४-९-५८", "content_sanskrit": "गायत्र्येव परं विष्णुर्गायत्र्येव परःशिवः ।\nगायत्र्येव परोब्रह्मा गायत्र्येव त्रयी ततः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004060058, "chapter_id": 24060, "verse_number": "४-९-५९", "content_sanskrit": "देवत्रयं स भगवानंशुमाली दिवाकरः ।\nसर्वेषां महसां राशिः कालकालप्रवर्तकः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004060059, "chapter_id": 24060, "verse_number": "४-९-६०", "content_sanskrit": "अर्कमुद्दिश्य सततमस्मल्लोकनिवासिनः ।\nश्रुतिं ह्युदाहरंतीमां सारासारविवेकिनः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004060060, "chapter_id": 24060, "verse_number": "४-९-६१", "content_sanskrit": "एषो ह देवः प्रदिशोनु सर्वाः पूर्वो ह जातः स उ गर्भे अंतः ।\nस एव जातः स जनिष्यमाणः प्रत्यङ्जानास्तिष्ठति सर्वतोमुखः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004060061, "chapter_id": 24060, "verse_number": "४-९-६२", "content_sanskrit": "सदैवमुपतिष्ठेरन्सौरसूक्तैरतंद्रिताः ।\nये नमंत्यत्र ते विप्रा विप्रा भास्करसन्निभाः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004060062, "chapter_id": 24060, "verse_number": "४-९-६३", "content_sanskrit": "पुष्यार्केप्यथ हस्तार्के मूलार्केप्यथवा द्विज ।\nउत्तरार्केऽथ यत्कार्यं तत्फलत्येव नान्यथा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004060063, "chapter_id": 24060, "verse_number": "४-९-६४", "content_sanskrit": "पौषे मास्यर्कदिवसे यः स्नात्वा भास्करोदये ।\nदानहोमंजपंकुर्यादर्चामर्कस्य सुव्रत ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004060064, "chapter_id": 24060, "verse_number": "४-९-६५", "content_sanskrit": "श्रद्धावानेकभक्तश्च कामक्रोधविवर्जितः ।\nसहाप्सरोभिर्द्युतिमान्स वसेदत्र भोगवान् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004060065, "chapter_id": 24060, "verse_number": "४-९-६६", "content_sanskrit": "अयने विषुवे चापि षडशीतिमुखेषु वा ।\nविष्णुपद्यां च ये दद्युर्महादानानि सुव्रताः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004060066, "chapter_id": 24060, "verse_number": "४-९-६७", "content_sanskrit": "तिलाञ्जुह्वति साज्यांश्च ब्राह्मणान्भोजयंति च ।\nपितॄनुद्दिश्य च श्राद्धं ये कुर्वंति विपश्चितः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004060067, "chapter_id": 24060, "verse_number": "४-९-६८", "content_sanskrit": "महापूजां च ये कुर्युर्महामंत्राञ्जपंति च ।\nतेऽत्र वैकर्तने लोके विकर्तनसमप्रभा ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004060068, "chapter_id": 24060, "verse_number": "४-९-६९", "content_sanskrit": "न दरिद्रा न च दुःखार्ता न व्याधि परिपीडिताः ।\nसंक्रमेष्वर्कभक्ता ये न विरूपा न दुर्भगाः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004060069, "chapter_id": 24060, "verse_number": "४-९-७०", "content_sanskrit": "संक्रमेषु न यैर्दत्तं न स्नातं तीर्थवारिषु ।\nविशेषहोमो न कृतः कपिलाज्याप्लुतैस्तिलैः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004060070, "chapter_id": 24060, "verse_number": "४-९-७१", "content_sanskrit": "ते दृश्यंते प्रतिद्वारं विहीन नयनाननाः ।\nदेहिदेहीति जल्पंतो देहिनः सपटच्चराः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004060071, "chapter_id": 24060, "verse_number": "४-९-७२", "content_sanskrit": "समं कृष्णलकेनापि यो दद्यात्कांचनं कृती ।\nसूर्यग्रहे कुरुक्षेत्रे स वसेदत्र पुण्यभाक् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004060072, "chapter_id": 24060, "verse_number": "४-९-७३", "content_sanskrit": "सर्वं गंगासमं तोयं सर्वे ब्रह्मसमा द्विजाः ।\nसर्वं देयं स्वर्णसमं राहुग्रस्ते दिवाकरे ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004060073, "chapter_id": 24060, "verse_number": "४-९-७४", "content_sanskrit": "दत्तं जप्तं हुतं स्नातं यत्किंचित्सदनुष्ठितम् ।\nभानूपरागे श्राद्धादि तद्धेतुर्ब्रध्न संनिधे ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004060074, "chapter_id": 24060, "verse_number": "४-९-७५", "content_sanskrit": "रविवारे संक्रमश्चेदुपरागोऽथवाभवेत् ।\nतदा यदर्जितं पुण्यं तदिहाक्षयमाप्यते ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004060075, "chapter_id": 24060, "verse_number": "४-९-७६", "content_sanskrit": "भानुवारो यदा षष्ठ्यां सप्तम्यामथ जायते ।\nतदा यत्सुकृतं कर्म कृतं तदिह भुज्यते ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004060076, "chapter_id": 24060, "verse_number": "४-९-७७", "content_sanskrit": "हंसो भानुः सहस्रांशुस्तपनस्तापनो रवि ।\nविकर्तनो विवस्वांश्च विश्वकर्मा विभावसुः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004060077, "chapter_id": 24060, "verse_number": "४-९-७८", "content_sanskrit": "विश्वरूपो विश्वकर्ता मार्तंडो मिहिरोंऽशुमान् ।\nआदित्यश्चोष्णगुः सूर्योऽर्यमा ब्रध्नो दिवाकरः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004060078, "chapter_id": 24060, "verse_number": "४-९-७९", "content_sanskrit": "द्वादशात्मा सप्तहयो भास्करो हस्करः खगः ।\nसुरः प्रभाकरः श्रीमांल्लोकचक्षुर्ग्रहेश्वरः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004060079, "chapter_id": 24060, "verse_number": "४-९-८०", "content_sanskrit": "त्रिलोकेशो लोकसाक्षीतमोरिः शाश्वतः शुचिः ।\nगभस्तिहस्तस्तीव्रांशुस्तरणिः सुमहोरणिः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004060080, "chapter_id": 24060, "verse_number": "४-९-८१", "content_sanskrit": "द्युमणिर्हरिदश्वोर्को भानुमान्भयनाशनः ।\nछन्दोश्वो वेदवेद्यश्च भास्वान्पूषा वृषाकपिः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004060081, "chapter_id": 24060, "verse_number": "४-९-८२", "content_sanskrit": "एकचक्ररथो मित्रो मंदेहारिस्तमिस्रहा ।\nदैत्यहा पापहर्ता च धर्मोधर्म प्रकाशकः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004060082, "chapter_id": 24060, "verse_number": "४-९-८३", "content_sanskrit": "हेलिकश्चित्रभानुश्च कलिघ्नस्तार्क्ष्यवाहनः ।\nदिक्पतिः पद्मिनीनाथः कुशेशयकरो हरिः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004060083, "chapter_id": 24060, "verse_number": "४-९-८४", "content_sanskrit": "घर्मरश्मिर्दुर्निरीक्ष्यश्चंडांशुः कश्यपात्मजः ।\nएभिः सप्ततिसंख्याकैः पुण्यैः सूर्यस्य नामभिः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004060084, "chapter_id": 24060, "verse_number": "४-९-८५", "content_sanskrit": "प्रणवादि चतुर्थ्यंतैर्नमस्कार समन्वितैः ।\nप्रत्येकमुच्चरन्नाम दृष्ट्वादृष्ट्वा दिवाकरम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004060085, "chapter_id": 24060, "verse_number": "४-९-८६", "content_sanskrit": "विगृह्य पाणियुग्मेन ताम्रपात्रं सुनिर्मलम् ।\nजानुभ्यामवनिं गत्वा परिपूर्य जलेन च ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004060086, "chapter_id": 24060, "verse_number": "४-९-८७", "content_sanskrit": "करवीरादि कुसुमै रक्तचंदनमिश्रितैः ।\nदूर्वांकुरैरक्षतैश्च निक्षिप्तैः पात्रमध्यतः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004060087, "chapter_id": 24060, "verse_number": "४-९-८८", "content_sanskrit": "दद्यादर्घ्यमनर्घ्याय सवित्रे ध्यानपूर्वकम् ।\nउपमौलि समानीय तत्पात्रं नान्यदृङ्मनाः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004060088, "chapter_id": 24060, "verse_number": "४-९-८९", "content_sanskrit": "प्रतिमंत्रं नमस्कुर्यादुदयास्तमये रविम् ।\nअनया नामसप्तत्या महामंत्ररहस्यया ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004060089, "chapter_id": 24060, "verse_number": "४-९-९०", "content_sanskrit": "एवं कुर्वन्नरो जातु न दरिद्रो न दुःखभाक् ।\nव्याधिभिर्मुच्यते घोरैरपिजन्मांतरार्जितैः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004060090, "chapter_id": 24060, "verse_number": "४-९-९१", "content_sanskrit": "विनौषधैर्विना वैद्यैर्विनापथ्यपरिग्रहैः ।\nकालेन निधनं प्राप्तः सूर्यलोके महीयते ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004060091, "chapter_id": 24060, "verse_number": "४-९-९२", "content_sanskrit": "इत्येकदेशः कथितो भानुलोकस्य सत्तम ।\nमहातेजोनिधेरस्य कोविशेषमवैत्यहो ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004060092, "chapter_id": 24060, "verse_number": "४-९-९३", "content_sanskrit": "स्वकर्णविषयीकुर्वन्नितिपुण्यकथामिमाम् ।\nक्षणादालोकयांचक्रे महेंद्रस्य महापुरीम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004060093, "chapter_id": 24060, "verse_number": "४-९-९४", "content_sanskrit": "अगस्तिरुवाच ।\nश्रुत्वा सौरीं कथमेतामप्सरोलोकसंयुताम् ।\nन दरिद्रो भवेत्क्वापि नाधर्मेषु प्रवर्तते ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004060094, "chapter_id": 24060, "verse_number": "४-९-९५", "content_sanskrit": "ब्राह्मणैः सततं श्राव्यमिदमाख्यानमुत्तमम् ।\nवेदपाठेन यत्पुण्यं तत्पुण्यफलदायकम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004060095, "chapter_id": 24060, "verse_number": "४-९-९६", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः शृण्वंतोऽध्यायमुत्तमम् ।\nपातकानि विसृज्येह गतिं यास्यंत्यनुत्तमाम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}]