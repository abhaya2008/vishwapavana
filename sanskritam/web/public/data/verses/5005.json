[{"id": 2188500, "chapter_id": 5005, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2188501, "chapter_id": 5005, "verse_number": "१", "content_sanskrit": "किं कुर्वन् सुखमाप्नोति किं कुर्वन् दुःखमाप्नुते ।\nकिं कुर्वन्निर्भयो लोके सिद्धश्चरति भारत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2188502, "chapter_id": 5005, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2188503, "chapter_id": 5005, "verse_number": "२", "content_sanskrit": "दममेव प्रशंसन्ति वृद्धाः श्रुतिसमाधयः ।\nसर्वेषामेव वर्णानां ब्राह्मणस्य विशेषतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2188504, "chapter_id": 5005, "verse_number": "३", "content_sanskrit": "नादान्तस्य क्रियासिद्धिर्यथावदुपलभ्यते ।\nक्रिया तपश्च वेदाश्च दमे सर्वं प्रतिष्ठितम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2188505, "chapter_id": 5005, "verse_number": "४", "content_sanskrit": "दमस्तेजो वर्धयति पवित्रं दम उच्यते ।\nविपाप्मा निर्भयो दान्तः पुरुषो विन्दते महत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2188506, "chapter_id": 5005, "verse_number": "५", "content_sanskrit": "सुखं दान्तः प्रस्वपिति सुखं च प्रतिबुध्यते ।\nसुखं लोके विपर्येति मनश्चास्य प्रसीदति\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2188507, "chapter_id": 5005, "verse_number": "६", "content_sanskrit": "तेजो दमेन ध्रियते न तत् तीक्ष्णोऽधिगच्छति ।\nअमित्रांश्च बहून्नित्यं पृथगात्मनि पश्यति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2188508, "chapter_id": 5005, "verse_number": "७", "content_sanskrit": "क्रव्याद्भ्य इव भूतानामदान्तेभ्यः सदा भयम् ।\nतेषां विप्रतिषेधार्थं राजा सृष्टः स्वयम्भुवा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2188509, "chapter_id": 5005, "verse_number": "८", "content_sanskrit": "आश्रमेषु च सर्वेषु दम एव विशिष्यते ।\nयच्च तेषु फलं धर्मे भूयो दान्ते तदुच्यते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2188510, "chapter_id": 5005, "verse_number": "९", "content_sanskrit": "तेषां लिङ्गानि वक्ष्यामि येषां समुदयो दमः ।\nअकार्पण्यमसंरम्भः सन्तोषः श्रद्दधानता\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2188511, "chapter_id": 5005, "verse_number": "१०", "content_sanskrit": "अक्रोध आर्जवं नित्यं नातिवादो न मानिता ।\nगुरुपूजानसूया च दया भूतेष्वपैशुनम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2188512, "chapter_id": 5005, "verse_number": "११", "content_sanskrit": "जनवादमृषावादस्तुतिनिन्दाविवर्जनम् ।\nसाधुकामश्चास्पृहयन्नायाति प्रत्ययं नृषु\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2188513, "chapter_id": 5005, "verse_number": "१२", "content_sanskrit": "अवैरकृत् सूपचारः समो निन्दाप्रशंसयोः ।\nसुवृत्तः शीलसम्पन्नः प्रसन्नात्माऽऽत्मवान् शुचिः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2188514, "chapter_id": 5005, "verse_number": "१३", "content_sanskrit": "प्राप्य लोके च सत्कारं स्वर्गं वै प्रेत्य गच्छति ।\nदुर्गमं सर्वभूतानां प्रापयन् मोदते सुखी\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2188515, "chapter_id": 5005, "verse_number": "१४", "content_sanskrit": "सर्वभूतहिते युक्तो न स्मयाद् द्वेष्टि वै जनम् ।\nमहाह्रद इवाक्षोभ्य प्रज्ञातृप्तः प्रसीदति\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2188516, "chapter_id": 5005, "verse_number": "१५", "content_sanskrit": "अभयं सर्वभूतेभ्यः सर्वेषामभयं यतः ।\nनमस्यः सर्वभूतानां दान्तो भवति ज्ञानवान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2188517, "chapter_id": 5005, "verse_number": "१६", "content_sanskrit": "न हृष्यति महत्यर्थे व्यसने च न शोचति ।\nस वै परिमितप्रज्ञः स दान्तो द्विज उच्यते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2188518, "chapter_id": 5005, "verse_number": "१७", "content_sanskrit": "कर्मभिः श्रुतसम्पन्नः सद्भिराचरितैः शुभैः ।\nसदैव दमसंयुक्तस्तस्य भुङ्क्ते महत्फलम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2188519, "chapter_id": 5005, "verse_number": "१८", "content_sanskrit": "अनसूया क्षमा शान्तिः सन्तोषः प्रियवादिता ।\nसत्यं दानमनायासो नैष मार्गो दुरात्मनाम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2188520, "chapter_id": 5005, "verse_number": "१९", "content_sanskrit": "कामक्रोधौ च लोभश्च परस्येर्ष्या विकत्थना ।\nअतुष्टिरनृतं मोह एष मार्गो दुरात्मनाम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2188521, "chapter_id": 5005, "verse_number": "२०", "content_sanskrit": "कामक्रोधौ वशे कृत्वा ब्रह्मचारी जितेन्द्रियः ।\nविक्रम्य घोरे तपसि ब्राह्मणः संशितव्रतः ।\nकालाकाङ्क्षी चरेल्लोकान्निरपाय इवात्मवान्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2188522, "chapter_id": 5005, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे चतुःपञ्चाशोऽध्यायः ॥५४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]