[{"id": 2029262, "chapter_id": 1639, "verse_number": "३-२७७-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2029263, "chapter_id": 1639, "verse_number": "३-२७७-१", "content_sanskrit": "ततो ब्रह्मर्षयः सर्वे सिद्धा देवर्षयस्तथा।\nहव्यवाहं पुरस्कृत्य ब्रह्माणं शरणं गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2029264, "chapter_id": 1639, "verse_number": "३-२७७-२x", "content_sanskrit": "अग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2029265, "chapter_id": 1639, "verse_number": "३-२७७-२", "content_sanskrit": "योसौ विश्रवसः पुत्रो दशग्रीवो महाबलः।\nअवध्यो वरदानेन कृतो भगवता पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2029266, "chapter_id": 1639, "verse_number": "३-२७७-३", "content_sanskrit": "स बाधते प्रजाः सर्वा विप्रकारैर्महाबलः।\nततो नस्त्रातु भगवान्नान्यस्त्राता हि विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2029267, "chapter_id": 1639, "verse_number": "३-२७७-४x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2029268, "chapter_id": 1639, "verse_number": "३-२७७-४", "content_sanskrit": "न स देवासुरैः शक्यो युद्धे जेतुं विभावसो।\nविहितं तत्रयत्कार्यमभितस्तस्य निग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2029269, "chapter_id": 1639, "verse_number": "३-२७७-५", "content_sanskrit": "तदर्थमवतीर्णोऽसौ मन्नियोगाच्चतुर्भुजः।\nविष्णुः प्रहरतां श्रेष्ठः स तत्कर्म करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2029270, "chapter_id": 1639, "verse_number": "३-२७७-६x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2029271, "chapter_id": 1639, "verse_number": "३-२७७-६", "content_sanskrit": "पितामहस्ततस्तेषां संनिधौ शक्रमब्रवीत्।\nसर्वैर्देवगणैः सार्धं संभव त्वं महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2029272, "chapter_id": 1639, "verse_number": "३-२७७-७", "content_sanskrit": "विष्णोः सहायानृक्षीषु वानरीषु च सर्वशः।\nजनयध्वं सुतान्वीरान्कामरूपबलान्वितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2029273, "chapter_id": 1639, "verse_number": "३-२७७-८", "content_sanskrit": "`ते यथोक्ता भगवता तत्प्रतिश्रुत्य शासनम्।\nससृजुर्देवगन्धर्वाः पुत्रान्वानररूपिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2029274, "chapter_id": 1639, "verse_number": "३-२७७-९", "content_sanskrit": "ततो भागानुभागेन देवगन्धर्वदानवाः।\nअवतर्तुं महीं सर्वे मन्त्रयामासुरञ्जसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2029275, "chapter_id": 1639, "verse_number": "३-२७७-१०", "content_sanskrit": "`अवतेरुर्महीं स्वर्गादंशैश्च सहिताः सुराः।\nऋषयश्च महात्मानः सिद्धाश्च सह किन्नरैः।\nचारणाश्चासृजन्घोरान्वानरान्वनचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2029276, "chapter_id": 1639, "verse_number": "३-२७७-११", "content_sanskrit": "यस्य देवस्य यद्रूपं वेषस्तेजश्च यद्विधम्।\nअजायन्त समास्तेन तस्य तस्य सुतास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2029277, "chapter_id": 1639, "verse_number": "३-२७७-१२", "content_sanskrit": "तेषां समक्षं गन्धर्वी दुन्दुभीं नाम नामतः।\nशशास वरदो देवो गच्छ कार्यार्थसिद्धये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2029278, "chapter_id": 1639, "verse_number": "३-२७७-१३", "content_sanskrit": "पितामहवचः श्रुत्वा गन्धर्वी दुन्दुभी ततः।\nमन्थरा मानुषे लोके कुब्जा समभवत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2029279, "chapter_id": 1639, "verse_number": "३-२७७-१४", "content_sanskrit": "शक्रप्रभृतयश्चैव सर्वे ते सुरसत्तमाः।\nवानरर्क्षवरस्त्रीषु जनयामासुरात्मजान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2029280, "chapter_id": 1639, "verse_number": "३-२७७-१५", "content_sanskrit": "तेऽन्ववर्तन्पितॄन्सर्वे यशसा च बलेन च।\nभेत्तारो गिरिशृङ्गाणां सालतालशिलायुधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2029281, "chapter_id": 1639, "verse_number": "३-२७७-१६", "content_sanskrit": "वज्चसंहननाः सर्वेसर्वेऽमोघवलास्तथा।\nकामवीर्यबलाश्चैवसर्वे बुद्धिविशारदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2029282, "chapter_id": 1639, "verse_number": "३-२७७-१७", "content_sanskrit": "नागायुतसमप्राणा वायुवेगसमा जवे।\nयथेच्छविनिपाताश्च केचिदत्र वनौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2029283, "chapter_id": 1639, "verse_number": "३-२७७-१८", "content_sanskrit": "एवं विधाय तत्सर्वं भगवाँल्लोकभावनः।\nमन्थरां बोधयामास यद्यत्कार्यं त्वया तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2029284, "chapter_id": 1639, "verse_number": "३-२७७-१९", "content_sanskrit": "सा तद्वच समाज्ञाय तथा चक्रे मनोजवा।\nइतश्चेतश्च गच्छन्ती वैरसंधुक्षणे रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2029285, "chapter_id": 1639, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि रामोपाख्यानपर्वाणि सप्तसप्तत्यधिकद्विशततमोऽध्यायः ॥ २७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]