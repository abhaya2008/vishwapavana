[{"id": 6000094000, "chapter_id": 10094, "verse_number": null, "content_sanskrit": "अथ त्रिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000094001, "chapter_id": 10094, "verse_number": null, "content_sanskrit": "विदुर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.001.m4a", "display_order": 2}, {"id": 6000094002, "chapter_id": 10094, "verse_number": "४-३०-१", "content_sanskrit": "ये त्वयाऽभिहिता ब्रह्मन् सुताः प्राचीनबर्हिषः।\nते रुद्रगीतेन हरिं सिद्धिमापुः प्रतोष्य काम्॥ ४/३०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.002.m4a", "display_order": 3, "topics": [{"text": "मध्ये प्राप्तप्राचीनबर्हिःकथासमापनानन्तरं प्रचेतसां कथाकथनम्", "range": "१–३"}]}, {"id": 6000094003, "chapter_id": 10094, "verse_number": "४-३०-२", "content_sanskrit": "किं चेह नार्हन्त्यपरत्र वा सुखं कैवल्यनाथप्रियपार्श्ववर्तिनः।\nआसाद्य देवं गिरिशं यदृच्छया प्रापुः परं नूनमथ प्रचेतसः॥ ४/३०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.003.m4a", "display_order": 4}, {"id": 6000094004, "chapter_id": 10094, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.004.m4a", "display_order": 5}, {"id": 6000094005, "chapter_id": 10094, "verse_number": "४-३०-३", "content_sanskrit": "प्रचेतसोऽन्तरुदधौ पितुरादेशकारिणः।\nजपयज्ञेन तपसा पुरञ्जनमतोषयन्॥ ४/३०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.005.m4a", "display_order": 6}, {"id": 6000094006, "chapter_id": 10094, "verse_number": "४-३०-४", "content_sanskrit": "दिव्यवर्षसहस्रान्ते पुरुषस्तु सनातनः।\nतेषामाविरभूत् कृच्छ्रं शान्तेन शमयन् रुचा॥ ४/३०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.006.m4a", "display_order": 7, "topics": [{"text": "रुद्रोक्तमार्गेण भगवन्तं तोषयतां तेषां भगवतः प्रादुर्भावः", "range": "४–७"}]}, {"id": 6000094007, "chapter_id": 10094, "verse_number": "४-३०-५", "content_sanskrit": "सुपर्णस्कन्धमारूढो मेरुशृङ्गमिवाम्बुदः।\nपीतवासा मणिग्रीवः कुर्वन् वितिमिरा दिशः॥ ४/३०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.007.m4a", "display_order": 8}, {"id": 6000094008, "chapter_id": 10094, "verse_number": "४-३०-६", "content_sanskrit": "कासिष्णुना कनककर्णविभूषणेन भ्राजत्कपोलवदनो विलसत्किरीटः।\nअष्टायुधैः करवरैर्मुनिभिः सुरेन्द्रैरासेवितो गरुडकिन्नरगीतकीर्तिः॥ ४/३०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.008.m4a", "display_order": 9}, {"id": 6000094009, "chapter_id": 10094, "verse_number": "४-३०-७", "content_sanskrit": "पीनायताष्टभुजमण्डलमध्यलक्ष्म्या स्पर्धच्छ्रिया परिवृतो वनमालया यः।\nबर्हिष्मतः पुरुष आह सुतान् प्रपन्नान् पर्जन्यनादरुतया सघृणावलोकः॥ ४/३०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.009.m4a", "display_order": 10}, {"id": 6000094010, "chapter_id": 10094, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.010.m4a", "display_order": 11}, {"id": 6000094011, "chapter_id": 10094, "verse_number": "४-३०-८", "content_sanskrit": "वरं वृणीध्वं भद्रं वो यूयं मे नृपनन्दनाः।\nसौहार्देनापृथग्धर्मास्तुष्टोऽहं सौहृदेन वः॥ ४/३०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.011.m4a", "display_order": 12, "topics": [{"text": "भगवता प्रचेतसां मोक्षमार्गकथनम्", "range": "८–२०"}]}, {"id": 6000094012, "chapter_id": 10094, "verse_number": "४-३०-९", "content_sanskrit": "योऽनुस्मरति सन्ध्यायां युष्माननुदिनं नरः।\nतस्य भ्रातृष्वात्मसाम्यं तथा भूतेषु सौहृदम्॥ ४/३०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.012.m4a", "display_order": 13}, {"id": 6000094013, "chapter_id": 10094, "verse_number": "४-३०-१०", "content_sanskrit": "ये तु मां रुद्रगीतेन सायं प्रातः समाहिताः।\nस्तुवन्त्यहं कामवरान् दास्ये प्रज्ञां च शोभनाम्॥ ४/३०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.013.m4a", "display_order": 14}, {"id": 6000094014, "chapter_id": 10094, "verse_number": "४-३०-११", "content_sanskrit": "यद् यूयं पितुरादेशमग्रहीष्ट मुदाऽन्विताः।\nअतो व उशती कीर्तिर्लोकाननुभविष्यति॥ ४/३०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.014.m4a", "display_order": 15}, {"id": 6000094015, "chapter_id": 10094, "verse_number": "४-३०-१२", "content_sanskrit": "भविता विश्रुतः पुत्रोऽनवमो ब्रह्मणो गुणैः।\nय एतामात्मवीर्येण त्रिलोकीं पूरयिष्यति॥ ४/३०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.015.m4a", "display_order": 16}, {"id": 6000094016, "chapter_id": 10094, "verse_number": "४-३०-१३", "content_sanskrit": "कण्डोः प्रम्लोचया लब्धा कन्या कमललोचना।\nतां चापविद्धां जगृहुर्भूरुहा नृपनन्दनाः॥ ४/३०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.016.m4a", "display_order": 17}, {"id": 6000094017, "chapter_id": 10094, "verse_number": "४-३०-१४", "content_sanskrit": "क्षुत्क्षामाया मुखे राजा सोमः पीयूषवर्षिणीम्।\nदेशिनीं रोदमानाया निदधे स दयान्वितः॥ ४/३०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.017.m4a", "display_order": 18}, {"id": 6000094018, "chapter_id": 10094, "verse_number": "४-३०-१५", "content_sanskrit": "प्रजाविसर्ग आदिष्टाः पित्रा मामनुवर्तिताः।\nतत्र कन्यां वरारोहां तामुद्वहत मा चिरम्॥ ४/३०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.018.m4a", "display_order": 19}, {"id": 6000094019, "chapter_id": 10094, "verse_number": "४-३०-१६", "content_sanskrit": "अपृथग्धर्मशीलानां सर्वेषां वः सुमध्यमा।\nअपृथग्धर्मशीलेयं भूयात् प्रत्यर्पिताशया॥ ४/३०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.019.m4a", "display_order": 20}, {"id": 6000094020, "chapter_id": 10094, "verse_number": "४-३०-१७", "content_sanskrit": "दिव्यवर्षसहस्राणां सहस्रममितौजसः।\nभौमान् भोक्ष्यथ भोगान् वै दिव्यांश्चानुग्रहान्मम॥ ४/३०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.020.m4a", "display_order": 21}, {"id": 6000094021, "chapter_id": 10094, "verse_number": "४-३०-१८", "content_sanskrit": "अथ मय्यनपायिन्या भक्त्या पक्‍वगुणाशयाः।\nउपयास्यथ मद्धाम निर्विद्य निरयादतः॥ ४/३०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.021.m4a", "display_order": 22}, {"id": 6000094022, "chapter_id": 10094, "verse_number": "४-३०-१९", "content_sanskrit": "गृहेष्वाविशतां चापि पुंसां कुशलकर्मणाम्।\nमद्वार्तायातयामानां न बन्धाय गृहा मताः॥ ४/३०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.022.m4a", "display_order": 23}, {"id": 6000094023, "chapter_id": 10094, "verse_number": "४-३०-२०", "content_sanskrit": "न व्यवह्रियते यज्ञो ब्रह्मैतद् ब्रह्मवादिभिः।\nन मुह्यन्ति न शोचन्ति न हृष्यन्ति यतो गताः॥ ४/३०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.023.m4a", "display_order": 24}, {"id": 6000094024, "chapter_id": 10094, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.024.m4a", "display_order": 25}, {"id": 6000094025, "chapter_id": 10094, "verse_number": "४-३०-२१", "content_sanskrit": "एवं ब्रुवाणं पुरुषार्थभाजनं जनार्दनं प्राञ्जलयः प्रचेतसः।\nतद्दर्शनध्वस्ततमोरजोमला गिराऽगृणन् गद्गदया सुहृत्तमम्॥ ४/३०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.025.m4a", "display_order": 26, "topics": [{"text": "प्रचेतोकृतभगवत्स्तोत्रम्", "range": "२१–४३"}]}, {"id": 6000094026, "chapter_id": 10094, "verse_number": null, "content_sanskrit": "प्रचेतस ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.026.m4a", "display_order": 27}, {"id": 6000094027, "chapter_id": 10094, "verse_number": "४-३०-२२", "content_sanskrit": "नमो नमः क्लेशविनाशनाय निरूपितोदारगुणाह्वयाय।\nमनोवचोवेगपुरोजवाय सर्वाक्षमार्गैरगताध्वने नमः॥ ४/३०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.027.m4a", "display_order": 28}, {"id": 6000094028, "chapter_id": 10094, "verse_number": "४-३०-२३", "content_sanskrit": "शुद्धाय शान्ताय नमः स्वनिष्ठमनस्यपार्थे विलसद्द्वयाय।\nनमो जगत्स्थानलयोदयेषु गृहीतमायागुणविग्रहाय॥ ४/३०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.028.m4a", "display_order": 29}, {"id": 6000094029, "chapter_id": 10094, "verse_number": "४-३०-२४", "content_sanskrit": "नमो विशुद्धसत्त्वाय हरये हरिमेधसे।\nवासुदेवाय कृष्णाय प्रभवे सर्वसात्वताम्॥ ४/३०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.029.m4a", "display_order": 30}, {"id": 6000094030, "chapter_id": 10094, "verse_number": "४-३०-२५", "content_sanskrit": "नमः कमलनाभाय नमः कमलमालिने।\nनमः कमलपादाय नमस्ते कमलेक्षण॥ ४/३०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.030.m4a", "display_order": 31}, {"id": 6000094031, "chapter_id": 10094, "verse_number": "४-३०-२६", "content_sanskrit": "नमः कमलकिञ्जल्कपिशङ्गामलवाससे।\nसर्वभूतनिवासाय नमोऽयुङ्‍क्ष्महि साक्षिणे॥ ४/३०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.031.m4a", "display_order": 32}, {"id": 6000094032, "chapter_id": 10094, "verse_number": "४-३०-२७", "content_sanskrit": "रूपं भगवता त्वेतद् अशेषक्लेशसङ्क्षयम्।\nआविष्कृतं नः क्लिष्टानां किमन्यदनुकम्पया॥ ४/३०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.032.m4a", "display_order": 33}, {"id": 6000094033, "chapter_id": 10094, "verse_number": "४-३०-२८", "content_sanskrit": "एतावत्त्वं हि विभुभिर्भाव्यं दीनेषु वत्सलैः।\nयदनुस्मर्यते काले स्वबुद्ध्याऽभद्ररन्धन॥ ४/३०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.033.m4a", "display_order": 34}, {"id": 6000094034, "chapter_id": 10094, "verse_number": "४-३०-२९", "content_sanskrit": "येनोपशान्तिर्भूतानां क्षुल्लकानामपीहितम्।\nअन्तर्हितोऽन्तर्हृदये कस्मान्नो वेद नाशिषः॥ ४/३०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.034.m4a", "display_order": 35}, {"id": 6000094035, "chapter_id": 10094, "verse_number": "४-३०-३०", "content_sanskrit": "असावेव वरोऽस्माकमीप्सितो जगतां पते।\nप्रसन्नो भगवानेषामपवर्गगुरुर्गतिः॥ ४/३०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.035.m4a", "display_order": 36}, {"id": 6000094036, "chapter_id": 10094, "verse_number": "४-३०-३१", "content_sanskrit": "वरं वृणीमहेऽथापि नाथ त्वत् परतः परात्।\nन ह्यन्तस्त्वद्विभूतीनां योऽनन्त इति गीयते॥ ४/३०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.036.m4a", "display_order": 37}, {"id": 6000094037, "chapter_id": 10094, "verse_number": "४-३०-३२", "content_sanskrit": "पारिजातेऽञ्जसा लभ्ये सारङ्गोऽन्यन्न सेवते।\nत्वदङ्घ्रिमूलमासाद्य साक्षात् किं किं वृणीमहे॥ ४/३०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.037.m4a", "display_order": 38}, {"id": 6000094038, "chapter_id": 10094, "verse_number": "४-३०-३३", "content_sanskrit": "यावत् ते मायया स्पृष्टा भ्रमाम इह कर्मभिः।\nतावद् भवत्प्रसङ्गानां सङ्गः स्यान्नो भवे भवे॥ ४/३०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.038.m4a", "display_order": 39}, {"id": 6000094039, "chapter_id": 10094, "verse_number": "४-३०-३४", "content_sanskrit": "तुलयाम लवेनापि न स्वर्गं नापुनर्भवम्।\nभगवत्सङ्गिसङ्गस्य मर्त्यानां किमुताशिषः॥ ४/३०/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.039.m4a", "display_order": 40}, {"id": 6000094040, "chapter_id": 10094, "verse_number": "४-३०-३५", "content_sanskrit": "यत्रेड्यन्ते कथा मृष्टास्तृष्णायाः प्रशमो यतः।\nनिर्वैरं यत्र भूतेषु नोद्वेगो यत्र कश्चन॥ ४/३०/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.040.m4a", "display_order": 41}, {"id": 6000094041, "chapter_id": 10094, "verse_number": "४-३०-३६", "content_sanskrit": "यत्र नारायणः साक्षाद् भगवान् न्यासिनां गतिः।\nप्रस्तूयते सत्कथासु मुक्तसङ्गैः पुनः पुनः॥ ४/३०/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.041.m4a", "display_order": 42}, {"id": 6000094042, "chapter_id": 10094, "verse_number": "४-३०-३७", "content_sanskrit": "तेषां विचरतां पद्भ्यां तीर्थानां पावनेच्छया।\nभीतस्य किं न रोचेत तावकानां समागमः॥ ४/३०/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.042.m4a", "display_order": 43}, {"id": 6000094043, "chapter_id": 10094, "verse_number": "४-३०-३८", "content_sanskrit": "वयं तु साक्षाद्भगवत्प्रियस्य प्रियस्य सख्युः क्षणसङ्गमेन।\nसुदुश्चिकित्सस्य भवस्य मृत्योर्भिषक्तमं त्वाऽद्य गतिं गताः स्मः॥ ४/३०/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.043.m4a", "display_order": 44}, {"id": 6000094044, "chapter_id": 10094, "verse_number": "४-३०-३९", "content_sanskrit": "यन्नः स्वधीतं गुरवः प्रसादिता विप्राश्च वृद्धाश्च सदाऽनुवृत्त्या।\nआर्या ह्यनाथाः सुहृदो भ्रातरश्च सर्वाणि भूतान्यनसूययैव॥ ४/३०/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.044.m4a", "display_order": 45}, {"id": 6000094045, "chapter_id": 10094, "verse_number": "४-३०-४०", "content_sanskrit": "यन्नः सुतप्तं तप एतदीश निरन्धसां कालमदभ्रमप्सु।\nसर्वं तदेतत् पुरुषस्य भूम्नो वृणीमहे ते परितोषणाय॥ ४/३०/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.045.m4a", "display_order": 46}, {"id": 6000094046, "chapter_id": 10094, "verse_number": "४-३०-४१", "content_sanskrit": "मनुः स्वयंभूर्भगवान् भवश्च येऽन्ये तपोज्ञानविशुद्धसत्त्वाः।\nअदृष्टपारा अपि यन्महिम्नः स्तुवन्त्यथो त्वाऽऽत्मसमं गृणीमः॥ ४/३०/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.046.m4a", "display_order": 47}, {"id": 6000094047, "chapter_id": 10094, "verse_number": "४-३०-४२", "content_sanskrit": "नमः समाय शुद्धाय पुरुषाय पराय च।\nवासुदेवाय सत्त्वाय तुभ्यं भगवते नमः॥ ४/३०/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.047.m4a", "display_order": 48}, {"id": 6000094048, "chapter_id": 10094, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.048.m4a", "display_order": 49}, {"id": 6000094049, "chapter_id": 10094, "verse_number": "४-३०-४३", "content_sanskrit": "इति प्रचेतोभिरभिष्टुतो हरिः प्रीतस्तथेत्याह शरण्यवत्सलः।\nअनिच्छतां यानमतृप्तचक्षुषां ययौ स्वधामानपवर्गविक्रमः॥ ४/३०/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.049.m4a", "display_order": 50}, {"id": 6000094050, "chapter_id": 10094, "verse_number": "४-३०-४४", "content_sanskrit": "अथ निर्याय सलिलात् प्रचेतस उदन्वतः।\nवीक्ष्याकुप्यन् द्रुमैश्छन्नां गामारोढुमिवोत्थितैः॥ ४/३०/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.050.m4a", "display_order": 51, "topics": [{"text": "चतुर्मुखाज्ञानुसारेण तेषां मारिषानामककन्याविवाहः, तस्यां दक्षनामकपुत्रोत्पादनं च", "range": "४४–५१"}]}, {"id": 6000094051, "chapter_id": 10094, "verse_number": "४-३०-४५", "content_sanskrit": "ततोऽग्निमारुतौ राजन्नमुञ्चन् मुखतो रुषा।\nमहीं निर्वीरुधं कर्तुं सांवर्तक इवाप्यये॥ ४/३०/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.051.m4a", "display_order": 52}, {"id": 6000094052, "chapter_id": 10094, "verse_number": "४-३०-४६", "content_sanskrit": "भस्मसात् क्रियमाणांस्तान् द्रुमान्वीक्ष्य पितामहः।\nआगतः शमयामास पुत्रान् बर्हिष्मतो नयैः॥ ४/३०/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.052.m4a", "display_order": 53}, {"id": 6000094053, "chapter_id": 10094, "verse_number": "४-३०-४७", "content_sanskrit": "तत्रावशिष्टा ये वृक्षा भीता दुहितरं तदा।\nआजह्रुस्ते प्रचेतोभ्य उपदिष्टाः स्वयंभुवा॥ ४/३०/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.053.m4a", "display_order": 54}, {"id": 6000094054, "chapter_id": 10094, "verse_number": "४-३०-४८", "content_sanskrit": "ते च ब्रह्मण आदेशान्मारिषामुपयेमिरे।\nयस्यां महदवज्ञानाद् अजन्यजनयोनिजः॥ ४/३०/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.054.m4a", "display_order": 55}, {"id": 6000094055, "chapter_id": 10094, "verse_number": "४-३०-४९", "content_sanskrit": "चाक्षुषे त्वन्तरे प्राप्ते प्राक्सर्गे कालविप्लुते।\nयः ससर्ज प्रजा इष्टाः स दक्षो दैवचोदितः॥ ४/३०/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.055.m4a", "display_order": 56}, {"id": 6000094056, "chapter_id": 10094, "verse_number": "४-३०-५०", "content_sanskrit": "यो न्यक्चकार सर्वेषां तेजस्तेजस्विनां रुचा।\nस्वयोग्योपात्तदाक्ष्याच्च कर्मणा दक्षमब्रुवन्॥ ४/३०/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.056.m4a", "display_order": 57}, {"id": 6000094057, "chapter_id": 10094, "verse_number": "४-३०-५१", "content_sanskrit": "तं प्रजासर्गरक्षायामनादिर्भगवानजः।\nयुयोज युयुजुस्तं वै सर्वेऽन्ये च प्रजेश्वराः॥ ४/३०/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_030/BhP_04.030.057.m4a", "display_order": 58}, {"id": 6000094058, "chapter_id": 10094, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे त्रिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]