[{"id": 2181994, "chapter_id": 4857, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2181995, "chapter_id": 4857, "verse_number": "१", "content_sanskrit": "कीदृशो ब्राह्मणो राज्ञा कार्याकार्यविचारणे ।\nक्षमः कर्तंु समर्थो वा तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2181996, "chapter_id": 4857, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2181997, "chapter_id": 4857, "verse_number": "२", "content_sanskrit": "य एव तु सतो रक्षेदसतश्च निबर्हयेत् ।\nस एव राज्ञा कर्तव्यो राजन् राजपुरोहितः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2181998, "chapter_id": 4857, "verse_number": "३", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nपुरूरवस ऐलस्य संवादं मातरिश्वनः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2181999, "chapter_id": 4857, "verse_number": "", "content_sanskrit": "ऐलः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2182000, "chapter_id": 4857, "verse_number": "४", "content_sanskrit": "कुतःस्विद् ब्राह्मणो जातो वर्णाश्चापि कुतस्त्रयः ।\nकस्माच्च भवति श्रेयानेतद् वायो विचक्ष्व मे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2182001, "chapter_id": 4857, "verse_number": "", "content_sanskrit": "वायुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2182002, "chapter_id": 4857, "verse_number": "५", "content_sanskrit": "ब्रह्मणो मुखतः सृष्टो ब्राह्मणो राजसत्तम ।\nबाहुभ्यां क्षत्रियः सृष्ट ऊरुभ्यां वैश्य उच्यते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2182003, "chapter_id": 4857, "verse_number": "६", "content_sanskrit": "वर्णानां परिचर्यार्थं त्रयाणां पुरुषर्षभ ।\nवर्णश्चतुर्थः पश्चात्तु पद्भ्यां शूद्रो विनिर्मितः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2182004, "chapter_id": 4857, "verse_number": "७", "content_sanskrit": "ब्राह्मणो जातमात्रस्तु पृथिवीमध्यजायत ।\nईश्वरः सर्वभूतानां धर्मकोशस्य गुप्तये\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2182005, "chapter_id": 4857, "verse_number": "८", "content_sanskrit": "सर्वस्वं ब्राह्मणस्येदं यत् किञ्चिदिह दृश्यते ।\nधर्मयुक्तं प्रशस्तं च जगत्यस्मिन् नृपात्मज\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2182006, "chapter_id": 4857, "verse_number": "९", "content_sanskrit": "ततः पृथिव्या गोप्तारं क्षत्रियं दण्डधारिणम् ।\nद्वितीयं वर्णमकरोत् प्रजानामनुगुप्तये\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2182007, "chapter_id": 4857, "verse_number": "१०", "content_sanskrit": "वैश्यस्तु धनधान्येन त्रीन् वर्णान् बिभृयादिमान् ।\nशूद्रो ह्येनान् परिचरेदिति ब्रह्मानुशासनम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2182008, "chapter_id": 4857, "verse_number": "", "content_sanskrit": "ऐलः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2182009, "chapter_id": 4857, "verse_number": "११", "content_sanskrit": "द्विजस्य क्षत्रबन्धोर्वा कस्येयं पृथिवी भवेत् ।\nधर्मतः सह वित्तेन सम्यग् वायो प्रचक्ष्व मे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2182010, "chapter_id": 4857, "verse_number": "", "content_sanskrit": "वायुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2182011, "chapter_id": 4857, "verse_number": "१२", "content_sanskrit": "विप्रस्य सर्वमेवैतद् यत्किञ्चिज्जगतीगतम् ।\nज्येष्ठेनाभिजनेनेह तद् धर्मकुशला विदुः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2182012, "chapter_id": 4857, "verse_number": "१३", "content_sanskrit": "स्वमेव ब्राह्मणो भुङ्क्ते स्वं वस्ते स्वं ददाति च ।\nगुरुर्हि सर्ववर्णानां ज्येष्ठः श्रेष्ठश्च वै द्विजः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2182013, "chapter_id": 4857, "verse_number": "१४", "content_sanskrit": "पत्यभावे यथा स्त्री हि देवरं कुरुते पतिम् ।\nआनन्तर्यात् तथा क्षत्रं पृथिवी कुरुते पतिम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2182014, "chapter_id": 4857, "verse_number": "१५", "content_sanskrit": "एष ते प्रथमः कल्प आपद्यन्यो भवेदतः ।\nयदि स्वर्गे परं स्थानं धर्मतः परिमार्गसि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2182015, "chapter_id": 4857, "verse_number": "१६", "content_sanskrit": "यः कश्चिद् विजयेद् भूमिं ब्राह्मणाय निवेदयेत् ।\nश्रुतवृत्तोपपन्नाय धर्मज्ञाय तपस्विने\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2182016, "chapter_id": 4857, "verse_number": "१७", "content_sanskrit": "स्वधर्मपरितृप्ताय यो न वित्तपरो भवेत् ।\nयो राजानं नयेद् बुद्ध्या सर्वतः परिपूर्णया\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2182017, "chapter_id": 4857, "verse_number": "१८", "content_sanskrit": "ब्राह्मणो हि कुले जातः कृतप्रज्ञो विनीतवाक् ।\nश्रेयो नयति राजानं ब्रुवंश्चित्रां सरस्वतीम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2182018, "chapter_id": 4857, "verse_number": "१९", "content_sanskrit": "राजा चरति यं धर्मं ब्राह्मणेन निदर्शितम् ।\nशुश्रूषुरनहंवादी क्षत्रधर्मव्रते स्थितः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2182019, "chapter_id": 4857, "verse_number": "२०", "content_sanskrit": "तावता स कृतप्रज्ञश्चिरं यशसि तिष्ठति ।\nतस्य धर्मस्य सर्वस्य भागी राजपुरोहितः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2182020, "chapter_id": 4857, "verse_number": "२१", "content_sanskrit": "एवमेव प्रजाः सर्वा राजानमभिसंश्रिताः ।\nब्राह्मणं च सुविद्वांसः राजशास्त्रविपश्चितम् ।\nसम्यग्वृत्ताः स्वधर्मस्था न कुतश्चिद् भयान्विताः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2182021, "chapter_id": 4857, "verse_number": "२२", "content_sanskrit": "राष्ट्रे चरन्ति यं धर्मं राज्ञा साध्वभिरक्षिताः ।\nचतुर्थं तस्य धर्मस्य राजा भागं स विन्दति\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2182022, "chapter_id": 4857, "verse_number": "२३", "content_sanskrit": "देवा मनुष्याः पितरो गन्धर्वोरगराक्षसाः ।\nयज्ञमेवोपजीवन्ति नास्ति चेष्टमराजके\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2182023, "chapter_id": 4857, "verse_number": "२४", "content_sanskrit": "इतो दत्तेन जीवन्ति देवताः पितरस्तथा ।\nराजन्येवास्य धर्मस्य योगक्षेमः प्रतिष्ठितः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2182024, "chapter_id": 4857, "verse_number": "२५", "content_sanskrit": "छायायामप्सु वायौ च सुखमुष्णेऽधिगच्छति ।\nअग्नौ वाससि सूर्ये च सुखं शीतेऽधिगच्छति\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2182025, "chapter_id": 4857, "verse_number": "२६", "content_sanskrit": "शब्दे स्पर्शे रसे रूपे गन्धे च रमते मनः ।\nतेषु भोगेषु सर्वेषु न भीतो लभते सुखम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2182026, "chapter_id": 4857, "verse_number": "२७", "content_sanskrit": "अभयस्यैव यो दाता तस्यैव सुमहत् फलम् ।\nनहि प्राणसमं दानं त्रिषु लोकेषु विद्यते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2182027, "chapter_id": 4857, "verse_number": "२८", "content_sanskrit": "इन्द्रो राजा यमो राजा धर्मो राजा तथैव च ।\nराजा बिभर्ति रूपाणि राज्ञा सर्वमिदं धृतम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2182028, "chapter_id": 4857, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे चतुःसप्ततितमोऽध्यायः ॥ ७४ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]