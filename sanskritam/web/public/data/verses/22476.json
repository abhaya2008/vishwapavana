[{"id": 7002476000, "chapter_id": 22476, "verse_number": "१-१३८-१", "content_sanskrit": "नारद उवाच ।\nहन्त ते कथयिष्यामि ध्वजारोपणमुत्तमम् ।\nयदुक्तं ब्रह्मणा पूर्वमृषभाधिपते पुरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002476001, "chapter_id": 22476, "verse_number": "१-१३८-२", "content_sanskrit": "पुरा देवासुरे युद्धे यानि देवैर्जयेप्सुभिः ।\nकृतान्युपरि चिह्नानि वाहनानि ध्वजानि तु ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002476002, "chapter_id": 22476, "verse_number": "१-१३८-३", "content_sanskrit": "लक्ष्मचिह्नध्वजं केतुरिति पर्यायनामभिः ।\nकीर्तितः स च तस्येह प्रमाणं गदतः शृणु ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002476003, "chapter_id": 22476, "verse_number": "१-१३८-४", "content_sanskrit": "ध्वजो वंशस्य कर्तव्यस्त्वविद्ध ऋजुरव्रणः ।\nप्रासादव्यास तुल्यस्य ध्वजवंशप्रमाणतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002476004, "chapter_id": 22476, "verse_number": "१-१३८-५", "content_sanskrit": "देवागारस्य ये प्रोक्ता मञ्जरीकलशादयः ।\nअथ वा तत्प्रमाणस्तु ध्वजदण्डः प्रकीर्तितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002476005, "chapter_id": 22476, "verse_number": "१-१३८-६", "content_sanskrit": "अन्तर्गृहस्य या वेदी सूत्रतः परिकल्पिता ।\nतस्या व्यासो भवेद्वंशः प्रसादस्य यदूत्तम ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002476006, "chapter_id": 22476, "verse_number": "१-१३८-७", "content_sanskrit": "अथ वा मूलसूत्रेण यो व्यासोऽन्तर्गृहस्य तु ।\nप्रासादव्यास इति ते प्रोक्तश्चेह न संशयः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002476007, "chapter_id": 22476, "verse_number": "१-१३८-८", "content_sanskrit": "केतुर्भवेद्वरो वंशो न निम्नो न ऋजुस्तथा ।\nपत्रं ध्वजे युगं चैव नलिकापुरुषस्तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002476008, "chapter_id": 22476, "verse_number": "१-१३८-९", "content_sanskrit": "चतुर्हस्ता भवन्त्येते प्रशस्ताः कृष्णनन्दन ।\nअष्टहस्तप्रमाणस्तु विंशार्धस्य१ प्रमाणतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002476009, "chapter_id": 22476, "verse_number": "१-१३८-१०", "content_sanskrit": "सामान्यो ध्वजदण्डस्तु सर्वसाधारणो मतः ।\nदण्डपाणिध्वजो यस्तु स्मृतः षोडशहस्तवान् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002476010, "chapter_id": 22476, "verse_number": "१-१३८-११", "content_sanskrit": "विंशद्धस्तात्परो दण्डो न कार्यः सर्वथा रवेः ।\nयुग्महस्तस्तु कर्तव्यो ध्वजदण्डो मनीषिभिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002476011, "chapter_id": 22476, "verse_number": "१-१३८-१२", "content_sanskrit": "चतुरङ्गुलविस्तीर्णः सुवृत्तो द्व्यङ्गुलोपरि ।\nनातिसूक्ष्मो न च स्थूलो न कार्यो नतपर्वकः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002476012, "chapter_id": 22476, "verse_number": "१-१३८-१३", "content_sanskrit": "समपर्वातु कर्तव्यः सुदृढः सूक्ष्म एव हि ।\nवक्रः पुत्रविनाशाय सव्रणोऽर्थविनाशनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002476013, "chapter_id": 22476, "verse_number": "१-१३८-१४", "content_sanskrit": "रोगदो युग्महस्तस्तु भिन्नो दुःखमनन्तकम् ।\nकरोति हानि धर्मस्य हीनो यस्तु प्रमाणतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002476014, "chapter_id": 22476, "verse_number": "१-१३८-१५", "content_sanskrit": "वैषम्यमसमपर्वा दद्यात्कृच्छ्रमधोन्नतः ।\nजयो जयन्तो जैत्रेयः४ शत्रुहन्ता जयावहः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002476015, "chapter_id": 22476, "verse_number": "१-१३८-१६", "content_sanskrit": "नन्दोपनन्दनौ चैवेन्द्रोपेन्द्रौ गदितौ तथा ।\nदशैते कीर्तिता भेदा ध्वजस्यानन्दसम्मिताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002476016, "chapter_id": 22476, "verse_number": "१-१३८-१७", "content_sanskrit": "द्विजहस्तस्तु जयो दण्डो जयन्तो द्विगुणो मतः ।\nद्वादशहस्तस्तु जैत्रेयः शत्रुहन्ता कलान्वितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002476017, "chapter_id": 22476, "verse_number": "१-१३८-१८", "content_sanskrit": "जयावहस्तु विंशार्धो नन्द आदित्यसन्निभः ।\nचतुर्दशोपनन्दस्तु इन्द्रः षोडश उच्यते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002476018, "chapter_id": 22476, "verse_number": "१-१३८-१९", "content_sanskrit": "उपेन्द्रोऽष्टादशः५ प्रोक्तस्तथेन्द्रो विंशतिः स्मृतः ।\nभिन्नो वक्रोऽसाधितश्च न कार्यो दण्ड एव हि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002476019, "chapter_id": 22476, "verse_number": "१-१३८-२०", "content_sanskrit": "मूलमन्त्रेण कर्तव्यो व्यासतोऽन्तर्गृहस्य तु ।\nध्वजदण्डो महाबाहो अथ वा वास्तुमानतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002476020, "chapter_id": 22476, "verse_number": "१-१३८-२१", "content_sanskrit": "मञ्जरीमानतो वापि तदर्धेनाथवा विभो ।\nपताका वै शुभा कार्या ध्वजवंशावलम्बिनी ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002476021, "chapter_id": 22476, "verse_number": "१-१३८-२२", "content_sanskrit": "देवागारस्य शिखरात्त्रिभागपरिमार्जनी ।\nसा प्रोक्ता दशधा वीर मानतोमानतस्तथा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002476022, "chapter_id": 22476, "verse_number": "१-१३८-२३", "content_sanskrit": "अङ्कुरः पल्लवश्चैव स्कन्धः शाखा तथैव च ।\nपताका कदली वीर केतुर्लक्ष्म जयस्तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002476023, "chapter_id": 22476, "verse_number": "१-१३८-२४", "content_sanskrit": "ध्वजश्च दशमः प्रोक्तः सर्वदेवमयोव्ययः ।\nअङ्कुरो द्वयंगुलः प्रोक्तः पल्लवश्चतुरङ्गुलः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002476024, "chapter_id": 22476, "verse_number": "१-१३८-२५", "content_sanskrit": "स्कन्धः षडङ्गुलः प्रोक्तः शाखा चाष्टाङ्गुलो मता ।\nएकादशपताका तु कदली च चतुर्दश ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002476025, "chapter_id": 22476, "verse_number": "१-१३८-२६", "content_sanskrit": "केतुस्तु षोडशः प्रोक्तो लक्ष्माष्टादशमुच्यते ।\nजया विंशति वै प्रोक्ता एतावत्त्वङ्गुलानि तु ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002476026, "chapter_id": 22476, "verse_number": "१-१३८-२७", "content_sanskrit": "देवागारस्य कुम्भस्य प्रसन्ना सा प्रमार्जनी ।\nअङ्कुरेति पताका सा विज्ञेया यदुनन्दन ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002476027, "chapter_id": 22476, "verse_number": "१-१३८-२८", "content_sanskrit": "पल्लवेति द्वितीयस्य मार्जनी परिकीर्तिता ।\nत्रिभागमार्जनीस्कन्धः शाखा वै पञ्चमस्य तु ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002476028, "chapter_id": 22476, "verse_number": "१-१३८-२९", "content_sanskrit": "षष्ठस्योक्ता पताका तु कदली सप्तमस्य तु ।\nअष्टमस्य तथा केतुर्लक्ष्म च नवमस्य तु ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002476029, "chapter_id": 22476, "verse_number": "१-१३८-३०", "content_sanskrit": "ततस्तु दशमः प्रोक्तो जयन्तो यदुनन्दन ।\nवृषस्थानावमार्गी तु ध्वजस्तु परिकीर्तितः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002476030, "chapter_id": 22476, "verse_number": "१-१३८-३१", "content_sanskrit": "गजो मेषोऽथ महिषः कबन्धस्तु वृषस्तथा ।\nहरिणोऽथ नरश्चैव नरश्च नरसत्तम ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002476031, "chapter_id": 22476, "verse_number": "१-१३८-३२", "content_sanskrit": "स्थानान्येतानि भूयोऽथ१ प्रयुक्तस्य ध्वजस्य तु ।\nदिशभागे तु पूर्वात्तु क्रमेण परिकल्पयेत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002476032, "chapter_id": 22476, "verse_number": "१-१३८-३३", "content_sanskrit": "एवं दशविधा प्रोक्ता पताका तत्त्वदर्शिभिः ।\nकर्तव्या सा यथापूर्वं तच्छृणु त्वं नराधिप ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002476033, "chapter_id": 22476, "verse_number": "१-१३८-३४", "content_sanskrit": "शुक्लवस्त्रमयी चित्रा सघण्टा सुमनोहरा ।\nनानाचामरसम्पन्ना किङ्किणीजालमण्डिता ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002476034, "chapter_id": 22476, "verse_number": "१-१३८-३५", "content_sanskrit": "ध्वजाग्रे चैव कर्तव्यो देवतालिङ्गसूचकः ।\nकाञ्चनो वाथ रौप्यो वा मणिरत्नमयोऽपि वा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002476035, "chapter_id": 22476, "verse_number": "१-१३८-३६", "content_sanskrit": "रङ्गकैर्लिख्यते वापि तद्वाहनसमाकृतिः ।\nध्वजदण्डोऽत्र विन्यस्तः कर्तव्यो यदुनन्दन ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002476036, "chapter_id": 22476, "verse_number": "१-१३८-३७", "content_sanskrit": "गरुत्मात्मांस्तु ध्वजो विष्णोरीश्वरस्य ध्वजो वृषः ।\nब्रह्मणः पङ्कजं कार्यं रवेर्धर्मः स्मृतो ध्वजः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002476037, "chapter_id": 22476, "verse_number": "१-१३८-३८", "content_sanskrit": "हंसो१ जलाधिपस्योक्तः सोमस्य तु नरो ध्वजः ।\nबलदेवस्य कालस्तु कामस्य मकरध्वजः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002476038, "chapter_id": 22476, "verse_number": "१-१३८-३९", "content_sanskrit": "सिंहो ध्वजस्तु दुर्गायाः कीर्तितो यदुनन्दन ।\nगोधा चापि उमादेव्या रैवतस्य हयः स्मृतः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002476039, "chapter_id": 22476, "verse_number": "१-१३८-४०", "content_sanskrit": "कच्छपो वरुणस्योक्तो वातस्य हरिणो मतः ।\nपावकस्य तथा मेष आखुर्गणपतेर्मतः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002476040, "chapter_id": 22476, "verse_number": "१-१३८-४१", "content_sanskrit": "ब्रह्मर्षीणां कुशः प्रोक्त इत्येषा ध्वज कल्पना ।\nयस्य यद्वाहनं प्रोक्तं तत्तस्य ध्वज उच्यते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002476041, "chapter_id": 22476, "verse_number": "१-१३८-४२", "content_sanskrit": "विष्णोर्ध्वजे तु सौवर्णं दण्डं कुर्याद्विचक्षणः ।\nपताका चापि पीता स्याद्गरुडस्य समीपगा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002476042, "chapter_id": 22476, "verse_number": "१-१३८-४३", "content_sanskrit": "ईश्वरस्य ध्वजे दण्डो राजतो यदुनन्दनः ।\nपताका चापि शुक्ला स्याद्वृषभस्य समीपगा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002476043, "chapter_id": 22476, "verse_number": "१-१३८-४४", "content_sanskrit": "पितामहध्वजे दण्डः स्मृतस्ताम्रमयो बुधैः ।\nपद्मवर्णा पताका स्यात्पङ्कजस्य समीपगा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002476044, "chapter_id": 22476, "verse_number": "१-१३८-४५", "content_sanskrit": "आदित्यस्य च सौवर्णो ध्वजे दण्डः प्रकीर्तितः ।\nपञ्चवर्णा पताका स्याद्धर्मस्याधोगता नृप ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002476045, "chapter_id": 22476, "verse_number": "१-१३८-४६", "content_sanskrit": "किङ्किणीजालसम्पन्ना नानबुद्बुदसन्निभा ।\nपुष्पमालोपसम्पन्ना नानावादिभिरावृता ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002476046, "chapter_id": 22476, "verse_number": "१-१३८-४७", "content_sanskrit": "दण्ड इन्द्रध्वजस्योक्तः काञ्चनो यदुनन्दन ।\nपताका बहुवर्णा स्यात्कुञ्जरस्य समीपगा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002476047, "chapter_id": 22476, "verse_number": "१-१३८-४८", "content_sanskrit": "आयसश्चापि दण्डोक्तो यमचिह्नं विचक्षणैः ।\nपताका वर्णतः कृष्णा महिषस्य समीपगा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002476048, "chapter_id": 22476, "verse_number": "१-१३८-४९", "content_sanskrit": "जलाधिपध्वजो दण्डो राजतः परिकीर्तितः ।\nपताका सर्वतः श्वेता विचित्रा सा च कथ्यते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002476049, "chapter_id": 22476, "verse_number": "१-१३८-५०", "content_sanskrit": "ध्वजे चापि कुबेरस्य दण्डो मणिमयः स्मृतः ।\nपताका चापि रक्ता स्यान्नरपादसमीपगा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002476050, "chapter_id": 22476, "verse_number": "१-१३८-५१", "content_sanskrit": "बलदेवध्वजे दण्डो राजतो यदुनन्दन ।\nपताका वर्णतः शुक्ला तालस्याधोगता स्मृता ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002476051, "chapter_id": 22476, "verse_number": "१-१३८-५२", "content_sanskrit": "कामध्वजे त्रिलोहः स्याद्दण्डो यदुकुलोद्वह ।\nपताका रोहिणी तत्र मकरस्य समीपगा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002476052, "chapter_id": 22476, "verse_number": "१-१३८-५३", "content_sanskrit": "मायूरं कार्त्तिकेयस्य चिह्नं लोकेषु गीयते ।\nत्रिलोहदण्डमारूढं बहुरत्नविभूषितम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002476053, "chapter_id": 22476, "verse_number": "१-१३८-५४", "content_sanskrit": "बहुवर्णकचित्रा तु पताका कथिता बुधैः ।\nहस्तिदन्तभवं दण्डं कुर्याद्गणपतेर्नृप ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002476054, "chapter_id": 22476, "verse_number": "१-१३८-५५", "content_sanskrit": "ताम्रदण्डं समारुढं संशुद्धं सम्प्रतिष्ठितम् ।\nशुक्ला पताका कर्तव्या सुप्रमाणा महीपते ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002476055, "chapter_id": 22476, "verse_number": "१-१३८-५६", "content_sanskrit": "मातॄणां चापि कर्तव्यो नैकरूपो ध्वजो बुधैः ।\nपताकाभिरनेकाभिबर्हुरत्नाभिरन्वितः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002476056, "chapter_id": 22476, "verse_number": "१-१३८-५७", "content_sanskrit": "रेवतस्यापि कर्तव्यो ध्वजो वाजी नराधिप ।\nरक्ता पताका तत्रापि कर्तव्या यदुनन्दन ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002476057, "chapter_id": 22476, "verse_number": "१-१३८-५८", "content_sanskrit": "चामुण्डामन्दिरे कार्यः शिरोमालाकुलो ध्वजः ।\nनीला पताका कर्तव्या दण्डो लोहमयस्तथा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002476058, "chapter_id": 22476, "verse_number": "१-१३८-५९", "content_sanskrit": "रीतीमयश्च मातॄणां रेवतस्य च कारयेत् ।\nगौर्या ध्वजस्ताम्रमयः पताका गोपसन्निभा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002476059, "chapter_id": 22476, "verse_number": "१-१३८-६०", "content_sanskrit": "स्वर्णदण्डस्तु वीरस्य ध्वजो मेषसमन्वितः ।\nपताका बहुरत्नाढ्ये१ कर्तव्या यदुनन्दन ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002476060, "chapter_id": 22476, "verse_number": "१-१३८-६१", "content_sanskrit": "अश्मसारमयो दण्डो ध्वजो वातस्य उच्यते ।\nपताका कृष्णवर्णा तु हरिणस्य समीपगा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002476061, "chapter_id": 22476, "verse_number": "१-१३८-६२", "content_sanskrit": "भगवत्या ध्वजो दण्डः सर्वरत्नमयः स्मृतः ।\nपताका तु त्रिवर्णा स्यात्सिंहस्याधोगता नृप ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002476062, "chapter_id": 22476, "verse_number": "१-१३८-६३", "content_sanskrit": "एवंविधमिमं कृत्वा ध्वजं लक्षणलक्षितम् ।\nअधिवास्य ततो राजंस्तत आरोपयेद्बुधः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002476063, "chapter_id": 22476, "verse_number": "१-१३८-६४", "content_sanskrit": "ततः सर्वौषधीभिश्च स्नापयित्वा प्रयत्नतः ।\nसमालभ्य च बध्नीयान्मध्ये प्रतिसरान्नृप ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002476064, "chapter_id": 22476, "verse_number": "१-१३८-६५", "content_sanskrit": "कल्पयित्वा शुभां वेदिं कलशैरुपशोभिताम् ।\nतस्यां वेद्यां समारोप्य तां रात्रिमधिवासयेत् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002476065, "chapter_id": 22476, "verse_number": "१-१३८-६६", "content_sanskrit": "नानाकुसुमचित्रां च स्रजं तस्यानुलम्बयेत् ।\nसमभ्यर्च्य प्रयत्नेन धूपमस्य निवेदयेत् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002476066, "chapter_id": 22476, "verse_number": "१-१३८-६७", "content_sanskrit": "बलिकर्म ततः कृत्वा कृशरापूपकादिभिः ।\nपलालपूपिकाभिश्च दधिपायससूपकैः२ ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002476067, "chapter_id": 22476, "verse_number": "१-१३८-६८", "content_sanskrit": "उद्दिश्य लोकपालेभ्यो बलिं दद्याच्च वायसैः ।\nब्राह्मणान्स्वस्ति वाच्याथ कृत्वा पुण्याहमङ्गलम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002476068, "chapter_id": 22476, "verse_number": "१-१३८-६९", "content_sanskrit": "वादित्रकृतनिर्घोषं जलं संस्कारसंयुतम् ।\nनानाबुद्बुदसपन्नं वेष्टितं नववाससा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002476069, "chapter_id": 22476, "verse_number": "१-१३८-७०", "content_sanskrit": "शुभे लग्ने दिने ऋक्षे ध्वजं चारोपयेद्बुधः ।\nविन्यस्य स्वर्णकलशं श्वभ्रराजं ध्वजस्य तु ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002476070, "chapter_id": 22476, "verse_number": "१-१३८-७१", "content_sanskrit": "एवमारोपयेद्यस्तु ध्वजं देवालयोपरि ।\nस श्रिया वर्धते नित्यं प्राप्नोति परमां गतिम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002476071, "chapter_id": 22476, "verse_number": "१-१३८-७२", "content_sanskrit": "असुरा वासमिच्छन्ति ध्वजहीने सुरालये ।\nतस्माद्देवालयं प्राज्ञो ध्वजहीनं न कारयेत् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002476072, "chapter_id": 22476, "verse_number": "१-१३८-७३", "content_sanskrit": "मन्त्रश्च स्थापने प्रोक्तो विधानज्ञैर्ध्वजस्य तु ।\nएह्येहि भगवन्देव देववाहन वै खग ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002476073, "chapter_id": 22476, "verse_number": "१-१३८-७४", "content_sanskrit": "श्रीकरः श्रीनिवासश्च जय जैत्रोपशोभित ।\nव्योमरूप महारूप धर्मात्मंस्त्वं च वै गतेः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002476074, "chapter_id": 22476, "verse_number": "१-१३८-७५", "content_sanskrit": "सान्निध्यं कुरु दण्डेऽस्मिन्साक्षी च ध्रुवतां व्रज ।\nकुरु वृद्धिं सदा कर्तुः प्रासादस्यार्कवल्लभ ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002476075, "chapter_id": 22476, "verse_number": "१-१३८-७६", "content_sanskrit": "ॐ एह्येहि भगवन्नीश्वरविनिर्मित उपरिचरवायुमार्गानुसारिञ्छ्रीनिवास रिपुध्वंस ।\nयक्षनिलय सर्वदेवप्रियं कुरु सान्निध्यं शान्ति स्वस्त्ययनं च मेभयं सर्वविघ्ना व्यपसरन्तु ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002476076, "chapter_id": 22476, "verse_number": "१-१३८-७७", "content_sanskrit": "मन्त्रेणानेन राजेन्द्र श्वभ्रे दण्डे निवेशयेत् ।\nपताकां पूर्वमन्त्रेण स्थित्या पूर्वमुखो नृप ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002476077, "chapter_id": 22476, "verse_number": "१-१३८-७८", "content_sanskrit": "क्षिपेदूर्ध्वमथाकाशं प्रासादशिखराद्विभोः ।\nयजमानस्ततः पश्येत्पताकां यदुनन्दन ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002476078, "chapter_id": 22476, "verse_number": "१-१३८-७९", "content_sanskrit": "प्रासादपुरतो वापि पताकां पातयेद्यदि ।\nइन्द्रलोकं तदा कर्ता विशेद्वै यदुनन्दन ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002476079, "chapter_id": 22476, "verse_number": "१-१३८-८०", "content_sanskrit": "आग्नेय्यामग्निलोकं तु याम्यां यमसदो भजेत् ।\nनैऋत्यां नैऋतं लोकं वारुण्यः वारुणं व्रजेत् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002476080, "chapter_id": 22476, "verse_number": "१-१३८-८१", "content_sanskrit": "यस्य देवस्य यद्वेश्म कृतं यदुकुलोद्वह ।\nतस्य लोकमवाप्नोति वृषस्थानगतो यदि ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002476081, "chapter_id": 22476, "verse_number": "१-१३८-८२", "content_sanskrit": "वायव्ये वायुमाप्नोति सौम्यायां सोममाप्नुयात् ।\nऐशान्यामीशमाप्नोति कर्ता वै देववेश्मनः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002476082, "chapter_id": 22476, "verse_number": "१-१३८-८३", "content_sanskrit": "य एवं कारयेद्भक्त्या ध्वजस्यारोपणं रवेः ।\nस हि भुक्त्वा परान्भोगान्सूर्यलोके महीयते ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002476083, "chapter_id": 22476, "verse_number": "१-१३८-८४", "content_sanskrit": "तेजसाम्बुजसंकाशः कान्त्या चाम्बुजसन्निभः ।\nद्विजातितुल्यः प्रभया विक्रमेण च गोपतेः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}]