[{"id": 2100905, "chapter_id": 3166, "verse_number": "१४-२२-१", "content_sanskrit": "ब्राह्मण उवाच।\nअत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nनिबोध दशहोतृणां विधानमिह यादृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2100906, "chapter_id": 3166, "verse_number": "१४-२२-२", "content_sanskrit": "श्रोत्रं त्वक्चक्षुषी जिह्वा नासिका चरणौ करौ।\nउपस्थं पायुरिति वाग्घोतृणि दश भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2100907, "chapter_id": 3166, "verse_number": "१४-२२-३", "content_sanskrit": "शब्दस्पर्शौ रूपरसौ गन्धो वाक्यं क्रिया गतिः।\nरेतोमूत्रपुरीषाणां त्यागो दश हवींषि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2100908, "chapter_id": 3166, "verse_number": "१४-२२-४", "content_sanskrit": "दिशो वायू रविश्चन्द्रः पृथ्व्यग्नी विष्णुरेव च।\nइन्द्रः प्रजापतिर्मित्रमग्नयो दश भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2100909, "chapter_id": 3166, "verse_number": "१४-२२-५", "content_sanskrit": "दशेन्द्रियाणि होतृणि हवींषि दश भामिनि।\nविषया नाम समिधो हूयन्ते तु दशाग्निषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2100910, "chapter_id": 3166, "verse_number": "१४-२२-६", "content_sanskrit": "चित्तं स्रुवश्च वित्तं च पवित्रं ज्ञानमुत्तमम्।\nसुविभक्तमिदं पूर्वं जगदासीदिति श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2100911, "chapter_id": 3166, "verse_number": "१४-२२-७", "content_sanskrit": "`ततो विविक्ता वित्तासीत्सा वित्तं पर्यवेक्षते।\nसर्वमेवात्र विज्ञेयं चित्ते ज्ञानमवेक्षता।\nरेतः शरीरभृत्काये विज्ञाता तु शरीरभृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2100912, "chapter_id": 3166, "verse_number": "१४-२२-८", "content_sanskrit": "शरीरभृद्गार्हपत्यस्तस्मादग्निः प्रणीयते।\nमनश्चाहवनीयस्तु तस्मिन्प्रक्षिप्यते हविः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2100913, "chapter_id": 3166, "verse_number": "१४-२२-९", "content_sanskrit": "ततो वाचस्पतिर्जज्ञे तं मनः पर्यवेक्षते।\nरूपं भवति वै वक्त्रं तदनुद्रवते मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2100914, "chapter_id": 3166, "verse_number": "१४-२२-१०x", "content_sanskrit": "ब्राह्मण्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2100915, "chapter_id": 3166, "verse_number": "१४-२२-१०", "content_sanskrit": "कस्माद्वागभवत्पूर्वं कस्मात्पश्चान्मनोऽभवत्।\nमनसा चिन्तितं पूर्वं वाक्यं समभिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2100916, "chapter_id": 3166, "verse_number": "१४-२२-११", "content_sanskrit": "केन विज्ञानयोगेन मतिश्चित्तं समास्थिता।\nसमुन्नीता नाध्यगच्छत्को वै तां प्रतिबाधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2100917, "chapter_id": 3166, "verse_number": "१४-२२-१२x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2100918, "chapter_id": 3166, "verse_number": "१४-२२-१२", "content_sanskrit": "तन्मनस्थः पतिर्भूत्वा तस्मात्प्रेहन्निवायति।\nतां मतिं मनसः प्राहुर्मनस्तस्मादपेक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2100919, "chapter_id": 3166, "verse_number": "१४-२२-१३", "content_sanskrit": "प्रश्नं तु वाङ्मनसयोर्यस्मात्त्वमनुपृच्छसि।\nतस्मात्ते वर्तयिष्यामि तयोरेव समाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2100920, "chapter_id": 3166, "verse_number": "१४-२२-१४", "content_sanskrit": "उभे वाङ्मनसी गत्वा भूतात्मानमपृच्छताम्।\nआवयोः श्रेष्ठमाचक्ष्व च्छिन्धि नौ संशयं विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2100921, "chapter_id": 3166, "verse_number": "१४-२२-१५", "content_sanskrit": "मन इत्येवि भगवांस्तदा प्राह सरस्वतीम्।\nअहं वै कामधुक्तुभ्यमिति तं प्राह वागथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2100922, "chapter_id": 3166, "verse_number": "१४-२२-१६x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2100923, "chapter_id": 3166, "verse_number": "१४-२२-१६", "content_sanskrit": "स्थावरं जङ्गमं चैव विद्ध्युभे मनसी मम।\nस्थावरं मत्सकाशे वै जङ्गमं विषये तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2100924, "chapter_id": 3166, "verse_number": "१४-२२-१७", "content_sanskrit": "यस्तु ते विषये गच्छन्मन्त्रो वर्णः स्वरोपि वा।\nतन्मनो जङ्गमं नाम तस्मादसि गरीयसी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2100925, "chapter_id": 3166, "verse_number": "१४-२२-१८", "content_sanskrit": "तस्माद्भवितुमर्हामि स्वयमभ्येत्य शोभने।\nतस्मादुच्छ्वासमासाद्य प्रवक्ष्यामि सरस्वति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2100926, "chapter_id": 3166, "verse_number": "१४-२२-१९", "content_sanskrit": "प्राणापानावन्तरे यद्वाग्वै नित्यं स्म तिष्ठति।\nप्रीयमाणा महाभागे विना प्राणांश्च मामपि।\nप्रजापतिमुपाधावत्प्रसीद भगवन्निति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2100927, "chapter_id": 3166, "verse_number": "१४-२२-२०", "content_sanskrit": "ततः प्राणः प्रादुरभूद्वाचमाप्याययन्पुनः।\nतस्मादुच्छ्वासमासाद्य न वाग्वदति कर्हिचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2100928, "chapter_id": 3166, "verse_number": "१४-२२-२१", "content_sanskrit": "घोषिणी जातनिर्घोषा नित्यमेव प्रवर्तते।\nतयोरपि च घोषिण्या निर्घोर्षैव गरीयसी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2100929, "chapter_id": 3166, "verse_number": "१४-२२-२२", "content_sanskrit": "गौरिव प्रस्रवत्यर्थान्रसमुत्तमशालिनी।\nसततं स्यन्दते ह्येषा शाश्वतं ब्रह्मवादिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2100930, "chapter_id": 3166, "verse_number": "१४-२२-२३", "content_sanskrit": "दिव्यादिव्यप्रभावेन भारती गौः शुचिस्मिते।\nएतयोरन्तरं पश्य सूक्ष्मयोर्यतमानयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2100931, "chapter_id": 3166, "verse_number": "१४-२२-२४x", "content_sanskrit": "ब्राह्मण्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2100932, "chapter_id": 3166, "verse_number": "१४-२२-२४", "content_sanskrit": "अनुत्पन्नेषु वाक्येषु चोद्यमाना सिसृक्षया।\nकिंन्नु पूर्वं तदा देवी व्याजहार सरस्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2100933, "chapter_id": 3166, "verse_number": "१४-२२-२५x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2100934, "chapter_id": 3166, "verse_number": "१४-२२-२५", "content_sanskrit": "प्राणेन य सम्भवते शरीरे\nप्राणादपानं प्रतिपद्यते च।\nउदानभूता च विसृज्य देहं\nव्यानेन सर्वं दिवमावृणोति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2100935, "chapter_id": 3166, "verse_number": "१४-२२-२६", "content_sanskrit": "ततः समाने प्रतितिष्ठतीह\nइत्येव पूर्वं प्रजजल्प वागपि।\nतस्मान्मनः स्थावरत्वाद्विशिष्टं\nतथा देवी जङ्गमत्वाद्विशिष्टाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2100936, "chapter_id": 3166, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि द्वाविंशोऽध्यायः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]