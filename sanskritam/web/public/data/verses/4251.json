[{"id": 2150025, "chapter_id": 4251, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2150026, "chapter_id": 4251, "verse_number": "१", "content_sanskrit": "आत्मनस्तु ततः सूतो हयानां च विशाम्पते ।\nमम चापनयामास शल्यान् कुशलसम्मतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2150027, "chapter_id": 4251, "verse_number": "२", "content_sanskrit": "स्नातोपवृत्तैस्तुरगैर्लब्धतोयैरविह्वलैः ।\nप्रभाते चोदिते सूर्ये ततो युद्धमवर्तत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2150028, "chapter_id": 4251, "verse_number": "३", "content_sanskrit": "दृष्ट्वा मां तूर्णमायान्तं दंसितं स्यन्दने स्थितम् ।\nअकरोद् रथमत्यन्तं रामः सज्जं प्रतापवान्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2150029, "chapter_id": 4251, "verse_number": "४", "content_sanskrit": "ततोऽहं राममायान्तं दृष्ट्वा समरकाङ्क्षिणम् ।\nधनुःश्रेष्ठं समुत्सृज्य सहसाऽवतरं रथात्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2150030, "chapter_id": 4251, "verse_number": "५", "content_sanskrit": "अभिवाद्य तथैवाहं रथमारुह्य भारत ।\nयुयुत्सुर्जामदग्न्यस्य प्रमुखे वीतभीः स्थितः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2150031, "chapter_id": 4251, "verse_number": "६", "content_sanskrit": "ततो मां शरवर्षेण महता समवाकिरत् ।\nअहं च शरवर्षेण वर्षन्तं समवाकिरम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2150032, "chapter_id": 4251, "verse_number": "७", "content_sanskrit": "सङ्क्रुद्धो जामदग्न्यस्तु पुनरेव पतत्रिणः ।\nप्रेषयामास मे राजन् दीप्तास्यानुरगानिव\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2150033, "chapter_id": 4251, "verse_number": "८", "content_sanskrit": "तानहं निशितैर्भल्लैः शतशोऽथ सहस्रशः ।\nअच्छिदं सहसा राजन्नन्तरिक्षे पुनः पुनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2150034, "chapter_id": 4251, "verse_number": "९", "content_sanskrit": "ततस्त्वस्त्राणि दिव्यानि जामदग्न्यः प्रतापवान् ।\nमयि प्रयोजयामास तान्यहं प्रत्यषेधयम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2150035, "chapter_id": 4251, "verse_number": "१०", "content_sanskrit": "अस्त्रैरेव महाबाहो चिकीर्षन्नधिकक्रियाम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2150036, "chapter_id": 4251, "verse_number": "११", "content_sanskrit": "ततो दिवि महान् नादः प्रादुरासीत् समन्ततः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2150037, "chapter_id": 4251, "verse_number": "१२", "content_sanskrit": "ततोऽहमस्त्रं वायव्यं जामदग्न्ये प्रयुक्तवान् ।\nप्रत्याजघ्ने च तद् रामो गुह्यकास्त्रेण वीर्यवान्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2150038, "chapter_id": 4251, "verse_number": "१३", "content_sanskrit": "ततोऽहमस्त्रमाग्नेयमनुमन्त्र्य प्रयुक्तवान् ।\nवारुणेनैव तद् रामो वारयामास मे विभुः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2150039, "chapter_id": 4251, "verse_number": "१४", "content_sanskrit": "एवमस्त्राणि दिव्यानि रामस्याहमवारयम् ।\nरामश्च मम तेजस्वी दिव्यान्यस्त्राणि संयुगे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2150040, "chapter_id": 4251, "verse_number": "१५", "content_sanskrit": "ततो मां सव्यतो राजन् रामः कुर्वन् द्विजोत्तमः ।\nउरस्यविध्यत् संरब्धः जामदग्न्यो महाबलः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2150041, "chapter_id": 4251, "verse_number": "१६", "content_sanskrit": "ततोऽहं भरतश्रेष्ठ संन्यषीदं रथोत्तमे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2150042, "chapter_id": 4251, "verse_number": "१७", "content_sanskrit": "ततो मां कश्मलाविष्टं सूतस्तूर्णमुदावहत् ।\nग्लायन्तं भरतश्रेष्ठ रामबाणप्रपीडितम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2150043, "chapter_id": 4251, "verse_number": "१८", "content_sanskrit": "ततो मामपयातं वै भृशं विद्धमचेतसम् ।\nरामस्यानुचरा हृष्टाः सर्वे दृष्ट्वा विचुक्रशुः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2150044, "chapter_id": 4251, "verse_number": "१९", "content_sanskrit": "अकृतव्रणप्रभृतयः काशिकन्या च भारत\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2150045, "chapter_id": 4251, "verse_number": "२०", "content_sanskrit": "ततस्तु लब्धसञ्ज्ञोऽहं ज्ञात्वा सूतमथाब्रवम् ।\nयाहि सूत यतो रामः सज्जोऽहं गतवेदनः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2150046, "chapter_id": 4251, "verse_number": "२१", "content_sanskrit": "ततो मामवहत् सूतो हयैः परमशोभितैः ।\nनृत्यद्भिरिव कौरव्य मारुतप्रतिमैर्गतौ\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2150047, "chapter_id": 4251, "verse_number": "२२", "content_sanskrit": "ततोऽहं राममासाद्य बाणजालेन कौरव ।\nअवाकिरं सुसंरब्धः संरब्धं च जिगीषया\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2150048, "chapter_id": 4251, "verse_number": "२३", "content_sanskrit": "तानापतत एवासौ रामो बाणानजिह्मगान् ।\nबाणैरेवाच्छिनत् तूर्णमेकैकं त्रिभिराहवे\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2150049, "chapter_id": 4251, "verse_number": "२४", "content_sanskrit": "ततस्ते सूदिताः सर्वे मम बाणाः सुसंशिताः ।\nरामबाणैर्द्विधा च्छिन्नाः शतशोऽथ महाहवे\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2150050, "chapter_id": 4251, "verse_number": "२५", "content_sanskrit": "ततः पुनः शरं दीप्तं सुप्रभं कालसम्मितम् ।\nअसृजं जामदग्न्याय रामायाहं जिघांसया\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2150051, "chapter_id": 4251, "verse_number": "२६", "content_sanskrit": "तेन त्वभिहतो गाढं बाणवेगवशं गतः ।\nमुमोह समरे रामो भूमौ च निपपात ह\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2150052, "chapter_id": 4251, "verse_number": "२७", "content_sanskrit": "ततो हाहाकृतं सर्वं रामे भूतळमाश्रिते ।\nजगद् भारत संविग्नं यथाऽर्कपतने तथा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2150053, "chapter_id": 4251, "verse_number": "२८", "content_sanskrit": "तत एनं सुसंविग्नाः सर्व एवाभिदुद्रुवुः ।\nतपोधनास्ते सहसा काश्या च भृगुनन्दनम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2150054, "chapter_id": 4251, "verse_number": "२९", "content_sanskrit": "तत एनं परिष्वज्य शनैराश्वासयंस्तदा ।\nपाणिभिर्जलशीतैश्च जयाशीर्भिश्च कौरव\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2150055, "chapter_id": 4251, "verse_number": "३०", "content_sanskrit": "ततः स विह्वलो वाक्यं राम उत्थाय चाब्रवीत् ।\nतिष्ठ भीष्म हतोऽसीति बाणं सन्धाय कार्मुके\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2150056, "chapter_id": 4251, "verse_number": "३१", "content_sanskrit": "स मुक्तो न्यपतत् तूर्णं सव्ये पार्श्वे महाहवे ।\nतेनाहं भृशमुद्विग्नो व्याघूर्णित इव द्रुमः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2150057, "chapter_id": 4251, "verse_number": "३२", "content_sanskrit": "हत्वा हयांस्ततो रामः शस्त्रास्त्रेण महाहवे ।\nअवाकिरन्मां विस्रब्धं बाणैस्तैर्लोमवाहिभिः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2150058, "chapter_id": 4251, "verse_number": "३३", "content_sanskrit": "ततोऽहमपि शीघ्रास्त्रं समरप्रतिवारणम् ।\nअवासृजं महेष्वासं तेऽन्तरा विष्ठिताः शराः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2150059, "chapter_id": 4251, "verse_number": "३४", "content_sanskrit": "रामस्य च ममैवाशु व्योमावृत्य समन्ततः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2150060, "chapter_id": 4251, "verse_number": "३५", "content_sanskrit": "न स्म सूर्यः प्रतपति शरजालसमावृतः ।\nमातरिश्वाऽन्तरे तस्मिन् मेघरुद्ध इवानदत्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2150061, "chapter_id": 4251, "verse_number": "३६", "content_sanskrit": "ततो वायोः प्रकम्पाच्च सूर्यस्य च गभस्तिभिः ।\nअभिवातप्रभावाच्च पावकः समजायत\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2150062, "chapter_id": 4251, "verse_number": "३७", "content_sanskrit": "ते शराः सुसमिद्धेन प्रदीप्ताश्चित्रभानुना ।\nभूमौ सर्वे ततो राजन् भस्मीभूताः प्रपेदिरे\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2150063, "chapter_id": 4251, "verse_number": "३८", "content_sanskrit": "तदा शतसहस्राणि प्रयुतान्यर्बुदानि च ।\nअयुतान्यथ खर्वाणि निखर्वाणि च कौरव\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2150064, "chapter_id": 4251, "verse_number": "३९", "content_sanskrit": "रामः शराणां सङ्क्रुद्धो मयि तूर्णं न्यपातयत्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2150065, "chapter_id": 4251, "verse_number": "४०", "content_sanskrit": "ततोऽहं तानपि रणे शरैराशीविषोपमैः ।\nसञ्छिद्य भूमौ नृपतेऽपातयं पन्नगानिव\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2150066, "chapter_id": 4251, "verse_number": "४१", "content_sanskrit": "एवं तदभवद् युद्धं तदा भरतसत्तम ।\nसन्ध्याकाले व्यतीते तु व्यपायात् समराद् गुरुः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2150067, "chapter_id": 4251, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि द्व्यशीत्युत्तरशततमोऽध्यायः ॥१८२॥\nअम्बोपाख्यानपर्वणि द्वादशोऽध्यायः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]