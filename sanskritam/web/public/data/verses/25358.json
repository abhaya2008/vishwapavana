[{"id": 7005358000, "chapter_id": 25358, "verse_number": "२४-१", "content_sanskrit": "ऋषय ऊचुः देवानां ब्रूहि नः कर्म यद्वृत्तास्ते पराजिताः कथं देवातिदेवोऽसौ विष्णुर्वामनतां गतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005358001, "chapter_id": 25358, "verse_number": "२४-२", "content_sanskrit": "लोमहर्षण उवाच बलिसंस्थं च त्रैलोक्यं दृष्ट्वा देवः पुरन्दरः मेरुप्रस्थं ययौ शक्रः स्वमातुर्निलयं शुभम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005358002, "chapter_id": 25358, "verse_number": "२४-३", "content_sanskrit": "समीपं प्राप्य मातुश्च कथयामास तां गिरम् आदित्याश्च यथा युद्धे दानवेन पराजिताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005358003, "chapter_id": 25358, "verse_number": "२४-४", "content_sanskrit": "अदितिरुवाच यद्येवं पुत्र युष्माभिर्न शक्यो हन्तुमाहवे बलिर्विरोचनसुतः सर्वैश्चैव मरुद्गणैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005358004, "chapter_id": 25358, "verse_number": "२४-५", "content_sanskrit": "सहस्रशिरसा शक्यः केवलं हन्तुमाहवे तेनैकेन सहस्राक्ष न स ह्यन्येन शक्यते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005358005, "chapter_id": 25358, "verse_number": "२४-६", "content_sanskrit": "तद्वत् पृच्छामि पितरं कश्यपं ब्रह्मवादिनम् पराजयार्थं दैत्यस्य बलेस्तस्य महात्मनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005358006, "chapter_id": 25358, "verse_number": "२४-७", "content_sanskrit": "ततोऽदित्या सह सुराः संप्राप्ताः कश्यपान्तिकम् तत्रापश्यन्त मारीचं मुनिं दीप्ततपोनिधिम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005358007, "chapter_id": 25358, "verse_number": "२४-८", "content_sanskrit": "आद्यं देवगुरुं दिव्यं प्रदीप्तं ब्रह्मवर्चसा तेजसा भास्कराकारं स्थितमग्निशिखोपमम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005358008, "chapter_id": 25358, "verse_number": "२४-९", "content_sanskrit": "न्यस्तदण्डं तपोयुक्तं बद्धकृष्णाजिनाम्बरम् वल्कलाजिनसंवीतं प्रदीप्तमिव तेजसा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005358009, "chapter_id": 25358, "verse_number": "२४-१०", "content_sanskrit": "हुताशमिव दीप्यन्तमाज्यगन्धपुरस्कृतम् स्वाध्यायवन्तं पितरं वपुष्मन्तमिवानलम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005358010, "chapter_id": 25358, "verse_number": "२४-११", "content_sanskrit": "ब्रह्मवादिसत्यवादिसुरासुरगुरुं प्रभुम् ब्राह्मण्याप्रतिमं लक्ष्म्या कश्यपं दीप्ततेजसम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005358011, "chapter_id": 25358, "verse_number": "२४-१२", "content_sanskrit": "यः स्रष्टा सर्वलोकानां प्रजानां पतिरुत्तमः आत्मभावविशेषेण तृतीयो यः प्रजापतिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005358012, "chapter_id": 25358, "verse_number": "२४-१३", "content_sanskrit": "अथ प्रणम्य ते वीराः सहादित्या सुरर्षभाः ऊचुः प्राञ्जलयः सर्वे ब्रह्माणमिव मानसाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005358013, "chapter_id": 25358, "verse_number": "२४-१४", "content_sanskrit": "अजेयो युधि शक्रेण बलिर्दैत्यो बलाधिकः तस्माद् विधत्त नः श्रेयो देवानां पुष्टिवर्धनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005358014, "chapter_id": 25358, "verse_number": "२४-१५", "content_sanskrit": "श्रुत्वा तु वचनं तेषां पुत्राणां कश्यपः प्रभुः अकरोद् गमने बुद्धिं ब्रह्मलोकाय लोककृत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005358015, "chapter_id": 25358, "verse_number": "२४-१६", "content_sanskrit": "कश्यप उवाच शक्र गच्छाम सदनं ब्रह्मणः परमाद्भुतम् तथा पराजयं सर्वे ब्रह्मणः ख्यातुमुद्यताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005358016, "chapter_id": 25358, "verse_number": "२४-१७", "content_sanskrit": "सहादित्या ततो देवायाताः काश्यपमाश्रमम् प्रस्थिता ब्रह्मसदनं महर्षिगणसेवितम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005358017, "chapter_id": 25358, "verse_number": "२४-१८", "content_sanskrit": "ते मुहूर्तेन संप्राप्ता ब्रह्मलोकं सुवर्चसः दिव्यैः कामगमैर्यानैर्यथार्हैस्ते महाबलाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005358018, "chapter_id": 25358, "verse_number": "२४-१९", "content_sanskrit": "ब्रह्माणं द्र ष्टुमिच्छन्तस्तपोराशिनमव्ययम् अध्यगच्छन्त विस्तीर्णां ब्रह्मणः परमां सभाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005358019, "chapter_id": 25358, "verse_number": "२४-२०", "content_sanskrit": "षट्पदोद्गीतमधुरां सामगैः समुदीरिताम् श्रेयस्करीममित्रघ्नीं दृष्ट्वा संजहृषुस्तदा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005358020, "chapter_id": 25358, "verse_number": "२४-२१", "content_sanskrit": "ऋचो बह्वृचमुख्यैश्च प्रोक्ताः क्रमपदाक्षराः शुश्रुवुर्विबुधव्याघ्रा विततेषु च कर्मसु ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005358021, "chapter_id": 25358, "verse_number": "२४-२२", "content_sanskrit": "यज्ञविद्यावेदविदः पदक्रमविदस्तथा स्वरेण परमर्षीणां सा बभूव प्रणादिता ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005358022, "chapter_id": 25358, "verse_number": "२४-२३", "content_sanskrit": "यज्ञसंस्तवविद्भिश्च शिक्षाविद्भिस्तथा द्विजैः छन्दसां चैव चार्थज्ञैः सर्वविद्याविशारदैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005358023, "chapter_id": 25358, "verse_number": "२४-२४", "content_sanskrit": "लोकायतिकमुख्यैश्च शुश्रुवुः स्वरमीरितम् तत्र तत्र च विप्रेन्द्रा नियताः शंसितव्रताः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005358024, "chapter_id": 25358, "verse_number": "२४-२५", "content_sanskrit": "जपहोमपरा मुख्या ददृशुः कश्यपात्मजाः तस्यां सभायामास्ते स ब्रह्मा लोकपितामहः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005358025, "chapter_id": 25358, "verse_number": "२४-२६", "content_sanskrit": "सुरासुरगुरुः श्रीमान् विद्यया वेदमायया उपासन्त च तत्रैव प्रजानां पतयः प्रभुम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005358026, "chapter_id": 25358, "verse_number": "२४-२७", "content_sanskrit": "दक्षः प्रचेताः पुलहो मरीचिश्च द्विजोत्तमाः भृगुरत्रिर्वसिष्ठश्च गौतमो नारदस्तथा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005358027, "chapter_id": 25358, "verse_number": "२४-२८", "content_sanskrit": "विद्यास्तथान्तरिक्षं च वायुस्तेजो जलं महो शब्दः स्पर्शश्च रूपं च रसो गन्धस्तथैव च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005358028, "chapter_id": 25358, "verse_number": "२४-२९", "content_sanskrit": "प्रकृतिश्च विकारश्च यच्चान्यत् कारणं महत् साङ्गोपाङ्गाश्च चत्वारो वेदा लोकपतिस्तथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005358029, "chapter_id": 25358, "verse_number": "२४-३०", "content_sanskrit": "नयाश्च क्रतवश्चैव सङ्कल्पः प्राण एव च एते चान्ये च बहवः स्वयंभुवमुपासते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005358030, "chapter_id": 25358, "verse_number": "२४-३१", "content_sanskrit": "अर्थो धर्मश्च कामश्च क्रोधो हर्षश्च नित्यशः शुक्रो बृहस्पतिश्चैव संवर्त्तोऽथ बुधस्तथा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005358031, "chapter_id": 25358, "verse_number": "२४-३२", "content_sanskrit": "शनैश्चरश्च राहुश्च ग्रहाः सर्वे व्यवस्थिताः मरुतो विश्वकर्मा च वसवश्च द्विजोत्तमाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005358032, "chapter_id": 25358, "verse_number": "२४-३३", "content_sanskrit": "दिवाकरश्च सोमश्च दिवा रात्रिस्तथैव च अर्द्धमासाश्च मासाश्च ऋतवः षट् च संस्थिताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005358033, "chapter_id": 25358, "verse_number": "२४-३४", "content_sanskrit": "तां प्रविश्य सभां दिव्यां ब्रह्मणः सर्वकामिकाम् कश्यपस्त्रिदशैः सार्द्धं पुत्रैर्धर्मभृतां वरः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005358034, "chapter_id": 25358, "verse_number": "२४-३५", "content_sanskrit": "सर्वतेजोमयीं दिव्यां ब्रह्मर्षिगणसेविताम् ब्राह्म्या श्रिया सेव्यमानामचिन्त्यां विगतक्लमाम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005358035, "chapter_id": 25358, "verse_number": "२४-३६", "content_sanskrit": "ब्रह्माणं प्रेक्ष्य ते सर्वे परमासनमास्थितम् शिरोभिः प्रणता देवं देवा ब्रह्मर्षिभिः सह ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005358036, "chapter_id": 25358, "verse_number": "२४-३७", "content_sanskrit": "ततः प्रणम्य चरणौ नियताः परमात्मनः विमुक्ताः सर्वपापेभ्यः शान्ता विगतकल्मषाः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005358037, "chapter_id": 25358, "verse_number": "२४-३८", "content_sanskrit": "दृष्ट्वा तु तान् सुरान् सर्वान् कश्यपेन सहागतान् आह ब्रह्मा महातेजा देवानां प्रभुरीश्वरः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]