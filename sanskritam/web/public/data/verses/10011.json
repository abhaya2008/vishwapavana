[{"id": 6000011000, "chapter_id": 10011, "verse_number": null, "content_sanskrit": "अथ एकादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000011001, "chapter_id": 10011, "verse_number": null, "content_sanskrit": "शौनक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.001.m4a", "display_order": 2}, {"id": 6000011002, "chapter_id": 10011, "verse_number": "१-११-१", "content_sanskrit": "अश्‍वत्थाम्ना विसृष्‍टेन ब्रह्मशीर्ष्णोरुतेजसा।\nउत्तराया हतो गर्भ ईशेनोज्जीवितः पुनः॥ १/११/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.002.m4a", "display_order": 3, "topics": [{"text": "शौनकेन परीक्षित्कथां पृष्‍टेन सुतेन तं प्रति तत्कथनोपक्रमः", "range": "१–६"}]}, {"id": 6000011003, "chapter_id": 10011, "verse_number": "१-११-२", "content_sanskrit": "तस्य जन्म महाबुद्धेः कर्माणि च गृणीहि नः।\nनिधनं ‍च यथैवासीत्स प्रेत्य गतवान् यथा॥ १/११/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.003.m4a", "display_order": 4}, {"id": 6000011004, "chapter_id": 10011, "verse_number": "१-११-३", "content_sanskrit": "तदिदं श्रोतुमिच्छामि वक्‍तुं वा यदि मन्यसे।\nब्रूहि नः श्रद्दधानानां यस्य ज्ञानमदाच्छुकः॥ १/११/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.004.m4a", "display_order": 5}, {"id": 6000011005, "chapter_id": 10011, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.005.m4a", "display_order": 6}, {"id": 6000011006, "chapter_id": 10011, "verse_number": "१-११-४", "content_sanskrit": "अपीपलद्धर्मराजः पितृवद्रञ्जयन् प्रजाः।\nनिस्पृहः सर्वकामेभ्यः कृष्णपादानुसेवया॥ १/११/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.006.m4a", "display_order": 7}, {"id": 6000011007, "chapter_id": 10011, "verse_number": "१-११-५", "content_sanskrit": "सम्पदः क्रतवो विप्रा महिषी भ्रातरो मही।\nजम्बुद्वीपाधिपत्यं ‍च यशश्‍च त्रिदिवं गतम्॥ १/११/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.007.m4a", "display_order": 8}, {"id": 6000011008, "chapter_id": 10011, "verse_number": "१-११-६", "content_sanskrit": "किन्ते कामातुरस्यार्थाः मुकुन्दमनसो द्विजाः।\nनाधिजह्रुर्मुदं राज्ञः क्षुधितस्य यथेतरे॥ १/११/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.008.m4a", "display_order": 9}, {"id": 6000011009, "chapter_id": 10011, "verse_number": "१-११-७", "content_sanskrit": "मातुर्गर्भगतो वीरः स तदा भृगुनन्दन।\nददर्श पुरुषं कञ्चिद्दह्यमानोऽस्‍त्रतेजसा॥ १/११/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.009.m4a", "display_order": 10, "topics": [{"text": "मातुर्गर्भे द्रौण्यस्‍त्रतेजोदह्यमानाय परीक्षिते श्रीकृष्णेन स्वदिव्यरूपं प्रदर्श्य अस्‍त्रतेजश्शमनपूर्वकमन्तर्धानम्", "range": "७–११"}]}, {"id": 6000011010, "chapter_id": 10011, "verse_number": "१-११-८", "content_sanskrit": "अङ्गुष्‍ठमात्रममलं स्फुरत्पुरटमौलिनम्।\nआपीच्यदर्शनं श्यामं तटिद्वाससमच्युतम्॥ १/११/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.010.m4a", "display_order": 11}, {"id": 6000011011, "chapter_id": 10011, "verse_number": "१-११-९", "content_sanskrit": "श्रीमद्दीर्घचतुर्बाहुं तप्‍तकाञ्चनकुण्डलम्।\nक्षतजाक्षं गदापाणिमात्मनः सर्वतोदिशम्॥ १/११/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.011.m4a", "display_order": 12}, {"id": 6000011012, "chapter_id": 10011, "verse_number": "१-११-१०", "content_sanskrit": "परिभ्रमन्तमुल्काभां भ्रामयन्तं गदां मुहुः। अस्‍त्रतेजः स्वगदया नीहारमिव गोपतिः।\nविधमन्तं सन्निकर्षे पर्यैक्षत क इत्यसौ॥ १/११/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.012.m4a", "display_order": 13}, {"id": 6000011013, "chapter_id": 10011, "verse_number": "१-११-११", "content_sanskrit": "विधूय तदमेयात्मा भगवान् धर्मगुब्विभुः।\nमिषतो दशमास्यस्य तत्रैवान्तर्दधे हरिः॥ १/११/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.013.m4a", "display_order": 14}, {"id": 6000011014, "chapter_id": 10011, "verse_number": "१-११-१२", "content_sanskrit": "ततः सर्वगुणोदर्के सानुकूलग्रहोदये।\nजज्ञे वंशधरः पाण्डोर्भूयः पाण्डुरिवौजसा॥ १/११/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.014.m4a", "display_order": 15, "topics": [{"text": "अथ परीक्षिज्जननसमयसमागतैर्बाह्मणैर्युधिष्‍ठिरं प्रति परीक्षितो विष्णुरात इति नामकरणपूर्वकं जननप्रभृति निधनावधि तदीयभविष्यत्सकलवृत्तान्तनिवेदनम्", "range": "१२–२८"}]}, {"id": 6000011015, "chapter_id": 10011, "verse_number": "१-११-१३", "content_sanskrit": "तस्य प्रीतमना राजा विप्रैर्धौम्यकृपादिभिः।\nजातकं कारयामास वाचयित्वा च मङ्गलम्॥ १/११/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.015.m4a", "display_order": 16}, {"id": 6000011016, "chapter_id": 10011, "verse_number": "१-११-१४", "content_sanskrit": "हिरण्यं गां महीं ग्रामान्हस्त्यश्‍वान्नृपतिर्वरान्।\nप्रादात्स्वन्नं ‍च विप्रेभ्यः प्रजातीर्थे स तीर्थवित्॥ १/११/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.016.m4a", "display_order": 17}, {"id": 6000011017, "chapter_id": 10011, "verse_number": "१-११-१५", "content_sanskrit": "तमूचुर्ब्राह्मणास्तुष्‍टा राजानं प्रश्रयानतम्।\nएष ह्यस्मिन्प्रजातन्तौ कुरूणां पौरवर्षभ॥ १/११/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.017.m4a", "display_order": 18}, {"id": 6000011018, "chapter_id": 10011, "verse_number": "१-११-१६", "content_sanskrit": "दैवेनाप्रतिघातेन कुले संस्थामुपेयुषि।\nरातो वोऽनुग्रहार्थाय विष्णुना प्रभविष्णुना॥ १/११/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.018.m4a", "display_order": 19}, {"id": 6000011019, "chapter_id": 10011, "verse_number": "१-११-१७", "content_sanskrit": "तस्मान्नाम्ना विष्णुरात इति लोके बृहच्छ्रवाः।\nभविष्यति न सन्देहो महाभागवतो महान्॥ १/११/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.019.m4a", "display_order": 20}, {"id": 6000011020, "chapter_id": 10011, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.020.m4a", "display_order": 21}, {"id": 6000011021, "chapter_id": 10011, "verse_number": "१-११-१८", "content_sanskrit": "अप्येष वंश्यान्राजर्षीन्पुण्यश्लोकान्महात्मनः।\nअनुवर्तिता स्विद्यशसा साधुवादेन सत्तमाः॥ १/११/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.021.m4a", "display_order": 22}, {"id": 6000011022, "chapter_id": 10011, "verse_number": null, "content_sanskrit": "ब्राह्मणा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.022.m4a", "display_order": 23}, {"id": 6000011023, "chapter_id": 10011, "verse_number": "१-११-१९", "content_sanskrit": "पार्थ प्रजाविता साक्षादिक्ष्वाकुरिव मानवः।\nब्रह्मण्यः सत्यसन्धश्‍च रामो दाशरथिर्यथा॥ १/११/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.023.m4a", "display_order": 24}, {"id": 6000011024, "chapter_id": 10011, "verse_number": "१-११-२०", "content_sanskrit": "एष धाता शरण्यश्च यथा ह्यौशीनरः शिबिः।\nयशो वितनिता स्वानां दौःषन्तिरिव यज्वनाम्॥ १/११/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.024.m4a", "display_order": 25}, {"id": 6000011025, "chapter_id": 10011, "verse_number": "१-११-२१", "content_sanskrit": "धन्विनामग्रणीरेष तुल्यश्‍चार्जुनयोर्द्वयोः।\nहुताश इव दुर्धर्षः समुद्र इव दुस्तरः॥ १/११/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.025.m4a", "display_order": 26}, {"id": 6000011026, "chapter_id": 10011, "verse_number": "१-११-२२", "content_sanskrit": "मृगेन्द्र इव विक्रान्तो निषेव्यो हिमवानिव।\nतितिक्षुर्वसुधेवासौ सहिष्णुः पितराविव॥ १/११/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.026.m4a", "display_order": 27}, {"id": 6000011027, "chapter_id": 10011, "verse_number": "१-११-२३", "content_sanskrit": "पितामहसमः साम्ये प्रसादे गिरिशोपमः।\nआश्रयः सर्वभूतानां यथा देवो रमाश्रयः॥ १/११/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.027.m4a", "display_order": 28}, {"id": 6000011028, "chapter_id": 10011, "verse_number": "१-११-२४", "content_sanskrit": "सर्वसद्गुणमाहात्म्य एष कृष्णमनुव्रतः।\nरन्तिदेव इवोदारो ययातिरिव धार्मिकः॥ १/११/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.028.m4a", "display_order": 29}, {"id": 6000011029, "chapter_id": 10011, "verse_number": "१-११-२५", "content_sanskrit": "धृत्यां बलिसमः कृष्णे प्रह्लाद इव सद्ग्रहः।\nआहर्तैषोऽश्‍वमेधानां वृद्धानां पर्युपासकः॥ १/११/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.029.m4a", "display_order": 30}, {"id": 6000011030, "chapter_id": 10011, "verse_number": "१-११-२६", "content_sanskrit": "राजर्षीणां जनयिता शास्ता चोत्पथगामिनाम्।\nनिग्रहीता कलेरेष भुवो धर्मस्य कारणात्॥ १/११/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.030.m4a", "display_order": 31}, {"id": 6000011031, "chapter_id": 10011, "verse_number": "१-११-२७", "content_sanskrit": "तक्षकादात्मनो मृत्युं द्विजपुत्रोपसर्जितात्।\nप्रपत्स्यत उपश्रुत्य मुक्‍तसङ्गः पदं हरेः॥ १/११/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.031.m4a", "display_order": 32}, {"id": 6000011032, "chapter_id": 10011, "verse_number": "१-११-२८", "content_sanskrit": "जिज्ञासितात्मयाथात्म्यो मुनेर्व्याससुतादसौ।\nहित्वेदं नृप गङ्गायां यास्यत्यद्धाऽकुतोभयम्॥ १/११/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.032.m4a", "display_order": 33}, {"id": 6000011033, "chapter_id": 10011, "verse_number": "१-११-२९", "content_sanskrit": "इति राज्ञ उपादिश्य विप्रा जातककोविदाः।\nलब्धापचितयः सर्वे प्रतिजग्मुः स्वकान्गृहान्॥ १/११/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.033.m4a", "display_order": 34, "topics": [{"text": "अश्‍वमेधयाजनाय युधिष्‍ठिरसमाहूतेन श्रीकृष्णेन हास्तिनपुरमागत्य यागावसाने पुनर्द्वारकागमनम्", "range": "२९–३६"}]}, {"id": 6000011034, "chapter_id": 10011, "verse_number": "१-११-३०", "content_sanskrit": "स एष लोके विख्यातः परीक्षिदिति यः प्रभुः।\nसर्पदष्‍टिमनुध्यायन्परीक्षेत नरेष्विह॥ १/११/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.034.m4a", "display_order": 35}, {"id": 6000011035, "chapter_id": 10011, "verse_number": "१-११-३१", "content_sanskrit": "स राजपुत्रो ववृध आशु शुक्ल इवोडुपः।\nआपूर्यमाणः पितृभिः काष्‍ठाभिरिव सोऽन्वहम्॥ १/११/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.035.m4a", "display_order": 36}, {"id": 6000011036, "chapter_id": 10011, "verse_number": "१-११-३२", "content_sanskrit": "यक्ष्यमाणोऽश्‍वमेधेन ज्ञातिद्रोहजिहासया।\nराजाऽलब्धधनो दध्यावन्यत्र करदण्डयोः॥ १/११/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.036.m4a", "display_order": 37}, {"id": 6000011037, "chapter_id": 10011, "verse_number": "१-११-३३", "content_sanskrit": "तदभिप्रेतमालक्ष्य भ्रातरोऽच्युतनोदिताः।\nधनं प्रहीणमाजह्रुरुदीच्या भूरिशो दिशः॥ १/११/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.037.m4a", "display_order": 38}, {"id": 6000011038, "chapter_id": 10011, "verse_number": "१-११-३४", "content_sanskrit": "तेन सम्भृतसम्भारो लब्धकामो युधिष्‍ठिरः।\nवाजिमेधैस्‍त्रिभी राजा यज्ञेशमयजद्धरिम्॥ १/११/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.038.m4a", "display_order": 39}, {"id": 6000011039, "chapter_id": 10011, "verse_number": "१-११-३५", "content_sanskrit": "आहूतो भगवान् राज्ञा याजयित्वा द्विजैर्नृपम्।\nउवास कतिचिन्मासान्सुहृदः प्रियकाम्यया॥ १/११/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.039.m4a", "display_order": 40}, {"id": 6000011040, "chapter_id": 10011, "verse_number": "१-११-३६", "content_sanskrit": "ततो राज्ञाऽभ्यनुज्ञातः कृष्णया सह बन्धुभिः।\nययौ द्वारवतीं ब्रह्मन्सार्जुनो यदुभिर्वृतः॥ १/११/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_011/BhP_01.011.040.m4a", "display_order": 41}, {"id": 6000011041, "chapter_id": 10011, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां प्रथमस्कन्धे एकादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]