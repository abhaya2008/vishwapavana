[{"id": 900009055, "chapter_id": 8721, "verse_number": "11.1", "content_sanskrit": "सुवर्णं तु न द्रव्यान्तरं, नापि तैजसं, किन्तु पार्थिवमेव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009056, "chapter_id": 8721, "verse_number": "11.2", "content_sanskrit": "ननु पीतरूपगुरुत्वाश्रया३विनिर्भागवर्ति तैजसं भागान्तरमेव सुवर्णम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009057, "chapter_id": 8721, "verse_number": "11.3", "content_sanskrit": "न च पार्थिवं रूपं स्वाश्रया१विनिर्भागवर्तिन एव तेजसो..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009058, "chapter_id": 8721, "verse_number": "11.4", "content_sanskrit": "किं चास्तु सुवर्णरूपमभिभूतं तथाऽपि महत्त्वे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009059, "chapter_id": 8721, "verse_number": "11.5", "content_sanskrit": "अत्र मणावुदयनोक्तं मतमुक्तं– ‘‘अवश्यं भागान्तरं स्वीकार्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900009060, "chapter_id": 8721, "verse_number": "11.6", "content_sanskrit": "तन्न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900009061, "chapter_id": 8721, "verse_number": "11.7", "content_sanskrit": "किं चास्तु द्रवत्वमेव प्रतिबन्धकम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900009062, "chapter_id": 8721, "verse_number": "11.8", "content_sanskrit": "किं चास्तु द्रुतं द्रव्यान्तरमेव प्रतिबन्धकम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900009063, "chapter_id": 8721, "verse_number": "11.9", "content_sanskrit": "किं च सिध्यतु दाहप्रतिबन्धकस्य द्रुतभागस्य तैजसत्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900009064, "chapter_id": 8721, "verse_number": "11.10", "content_sanskrit": "किञ्चास्तूपष्टम्भकाविनिर्भावगवर्त्येव स भागः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900009065, "chapter_id": 8721, "verse_number": "11.11", "content_sanskrit": "यदपि मणौ लीलावत्युक्तं मतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900009066, "chapter_id": 8721, "verse_number": "11.12", "content_sanskrit": "अथ सुवर्णद्रवत्वमाश्रयनाशान्नश्यति न त्वग्निसंयोगात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900009067, "chapter_id": 8721, "verse_number": "11.13", "content_sanskrit": "ननु पार्थिवद्रव१त्वत्वमेवाग्निसंयोगनाश्यत्वे तन्त्रम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900009068, "chapter_id": 8721, "verse_number": "11.14", "content_sanskrit": "किञ्च पीतभागो न द्रुतश्चेत्तत्र काठिन्यधीः स्यात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900009069, "chapter_id": 8721, "verse_number": "11.15", "content_sanskrit": "अन्ये तु..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900009070, "chapter_id": 8721, "verse_number": "11.16", "content_sanskrit": "एतदपि प्रागेव निरस्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900009071, "chapter_id": 8721, "verse_number": "11.17", "content_sanskrit": "एतेन सुवर्णं तैजसं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900009072, "chapter_id": 8721, "verse_number": "11.18", "content_sanskrit": "अन्यस्त्वाह– सुवर्णं द्रव्यान्तरमेव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900009073, "chapter_id": 8721, "verse_number": "11.19", "content_sanskrit": "तस्मादुपष्टम्भकद्रव्यगतपीतरूपपरावृत्तिप्रतिबन्धकत्वेन द्रुत-तेजस्सिद्धिरिति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]