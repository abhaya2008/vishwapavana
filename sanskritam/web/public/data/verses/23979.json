[{"id": 7003979000, "chapter_id": 23979, "verse_number": "३-१-४२-१", "content_sanskrit": "श्रीसूत उवाच ।\nअथातः सर्वतीर्थानां वैभवं प्रवदाम्यहम् ।\nसेतुमध्यनिविष्टानामनुक्तानां मुनीश्वराः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003979001, "chapter_id": 23979, "verse_number": "३-१-४२-२", "content_sanskrit": "अस्ति तीर्थं महापुण्यं नाम्ना तु ऋणमोचनम् ।\nऋणानि त्रीणि नश्यंति नराणामत्र मज्जनात्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003979002, "chapter_id": 23979, "verse_number": "३-१-४२-३", "content_sanskrit": "द्विजस्य जायमानस्य ऋणानि त्रीणि संति हि ।\nऋषीणां देवतानां च पितॄणां च द्विजोत्तमाः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003979003, "chapter_id": 23979, "verse_number": "३-१-४२-४", "content_sanskrit": "ब्रह्मचर्याननुष्ठानादृषीणामृणवान्भवेत् ।\nयज्ञादीनामकरणाद्देवानां च ऋणी भवेत्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003979004, "chapter_id": 23979, "verse_number": "३-१-४२-५", "content_sanskrit": "पुत्रानुत्पादनाच्चैव पितृणामृणवान्भवेत् ।\nविनापि ब्रह्मचर्येण विना यागं विना सुतम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003979005, "chapter_id": 23979, "verse_number": "३-१-४२-६", "content_sanskrit": "ऋणमोक्षाभिधे तीर्थे स्नानमात्रेण मानवाः ।\nऋषिदेवपितॄणां तु ऋणेभ्यो मुक्तिमाप्नुयुः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003979006, "chapter_id": 23979, "verse_number": "३-१-४२-७", "content_sanskrit": "ब्रह्मचर्येण यज्ञेन तथा पुत्रोद्भवेन च ।\nनैव तुष्यन्ति ऋषयो देवाः पितृगणास्तथा॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003979007, "chapter_id": 23979, "verse_number": "३-१-४२-८", "content_sanskrit": "ऋणमोक्षे यथा स्नानादतुलां तुष्टिमाप्नुयुः ।\nकिं चात्र मज्जनात्तीर्थे दरिद्रा अधमर्णिनः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003979008, "chapter_id": 23979, "verse_number": "३-१-४२-९", "content_sanskrit": "मुक्ता ऋणेभ्यः सर्वेभ्यो धनिनः स्युर्न संशयः ।\nयदत्र मज्जनात्पुंसामृणमुक्तिः प्रजायते॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003979009, "chapter_id": 23979, "verse_number": "३-१-४२-१०", "content_sanskrit": "तस्मादुक्तमिदं तीर्थमृणमोचनसंज्ञया ।\nअतोऽत्र ऋणिभिः सर्वैः स्नातव्यं तद्विमुक्तये॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003979010, "chapter_id": 23979, "verse_number": "३-१-४२-११", "content_sanskrit": "एतत्तीर्थसमं तीर्थं न भूतं न भविष्यति ।\nपांडवैः कृतमप्यत्र तीर्थमस्त्यपरं महत्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003979011, "chapter_id": 23979, "verse_number": "३-१-४२-१२", "content_sanskrit": "यत्रेष्टं धर्मपुत्राद्यैः पांडवैः पंचभिः पुरा ।\nतदेतत्तीर्थमुद्दिश्य भुक्तिमुक्ति फलप्रदम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003979012, "chapter_id": 23979, "verse_number": "३-१-४२-१३", "content_sanskrit": "दशकोटिसहस्राणि तीर्थान्यनुत्तमानि हि ।\nपंचपांडवतीर्थेस्मिन्सान्निध्यं कुर्वते सदा॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003979013, "chapter_id": 23979, "verse_number": "३-१-४२-१४", "content_sanskrit": "आदित्पा वसवो रुद्राः साध्याश्च समरुद्गणाः ।\nपांडवानां महातीर्थे नित्यं सन्निहितास्तथा॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003979014, "chapter_id": 23979, "verse_number": "३-१-४२-१५", "content_sanskrit": "अत्राभिषेकं यः कुर्यात्पितृदेवांश्च तर्पयेत् ।\nसर्वपापविनिर्मुक्तो ब्रह्म लोके स पूज्यते॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003979015, "chapter_id": 23979, "verse_number": "३-१-४२-१६", "content_sanskrit": "अप्येकं भोजयेद्विप्रमेतत्तीर्थतटेऽमले ।\nतेनासौ कर्मणा त्वत्र परत्रापि च मोदते॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003979016, "chapter_id": 23979, "verse_number": "३-१-४२-१७", "content_sanskrit": "ब्राह्मणः क्षत्रियो वैश्यः शूद्रो वाप्यन्य एव वा ।\nअस्मिंस्तीर्थवरे स्नात्वा वियोनिं न प्रयाति वै॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003979017, "chapter_id": 23979, "verse_number": "३-१-४२-१८", "content_sanskrit": "पांडवानां महातीर्थे पुण्ययोगेषु यो नरः ।\nस्नायात्स मनुज श्रेष्ठो नरकं नैव पश्यति॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003979018, "chapter_id": 23979, "verse_number": "३-१-४२-१९", "content_sanskrit": "पांडवानां महातीर्थं सायं प्रातश्च यः स्मरेत् ।\nस स्नातः सर्वतीर्थेषु गंगादिषु न संशयः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003979019, "chapter_id": 23979, "verse_number": "३-१-४२-२०", "content_sanskrit": "इंद्रादिदेवता भिश्च यत्रेष्टं दैत्यशांतये ।\nतदन्यद्देवतीर्थाख्यं विद्यते गंधमादने॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003979020, "chapter_id": 23979, "verse_number": "३-१-४२-२१", "content_sanskrit": "देवतीर्थे नरः स्नात्वा सर्वपापविमोचितः ।\nप्राप्नुयादक्षयांल्लोकान्सर्व कामसमन्वितान्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003979021, "chapter_id": 23979, "verse_number": "३-१-४२-२२", "content_sanskrit": "जन्मप्रभृति यत्पापं स्त्रिया वा पुरुषेण वा ।\nकृतं तद्देवकुंडेस्मिन्स्नानात्सद्यो विनश्यति॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003979022, "chapter_id": 23979, "verse_number": "३-१-४२-२३", "content_sanskrit": "यथा सुराणां सर्वेषा मादिर्वै मधुसूदनः ।\nतथादिः सर्वतीर्थानां देवकुंडमनुत्तमम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003979023, "chapter_id": 23979, "verse_number": "३-१-४२-२४", "content_sanskrit": "यस्तु वर्षशतं पूर्णमग्निहोत्रमुपासते ।\nयस्त्वेको देवकुंडेस्मिन्कदाचित्स्नान माचरेत्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003979024, "chapter_id": 23979, "verse_number": "३-१-४२-२५", "content_sanskrit": "सममेव तयोः पुण्यं नात्र संदेहकारणम् ।\nदुर्लभं देवतीर्थेस्मिन्दानं वासश्च दुर्लभः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003979025, "chapter_id": 23979, "verse_number": "३-१-४२-२६", "content_sanskrit": "देवतीर्थाभिगमनं स्नानं चाप्य तिदुर्लभम् ।\nदेवतीर्थं समासाद्य देवर्षिपितृसेवितम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003979026, "chapter_id": 23979, "verse_number": "३-१-४२-२७", "content_sanskrit": "अश्वमेधमवाप्नोति विष्णुलोकं च गच्छति ।\nद्विदिनं त्रिदिनं चापि पंच वाथ षडेव वा॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003979027, "chapter_id": 23979, "verse_number": "३-१-४२-२८", "content_sanskrit": "उषित्वा देवकुंडस्थतीरे नरकनाशने ।\nन मातृयोनिमाप्नोति सिद्धिं चाप्नोत्यनुत्तमाम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003979028, "chapter_id": 23979, "verse_number": "३-१-४२-२९", "content_sanskrit": "त्रिरात्रस्नानतो ह्यत्र वाजपेयफलं भवेत् ।\nदेवतीर्थस्मृतेः सद्यः पापेभ्यो मुच्यते नरः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003979029, "chapter_id": 23979, "verse_number": "३-१-४२-३०", "content_sanskrit": "अर्चयित्वा पितॄन्देवानेतत्तीर्थतटे नरः ।\nसर्वकामसमृद्धिः स्यात्सर्वयज्ञफलं लभेत्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003979030, "chapter_id": 23979, "verse_number": "३-१-४२-३१", "content_sanskrit": "एतत्तीर्थसमं पुण्यं न भूतं न भविष्यति ।\nतस्मादवश्यं स्नातव्यं देवतीर्थे मुमुक्षुभिः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003979031, "chapter_id": 23979, "verse_number": "३-१-४२-३२", "content_sanskrit": "ऐहिकामुष्मिकफलप्राप्तिकामैश्च मानवैः ।\nदेवतीर्थस्य माहात्म्यं संक्षिप्य कथितं द्विजाः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003979032, "chapter_id": 23979, "verse_number": "३-१-४२-३३", "content_sanskrit": "विस्तरेणास्य माहात्म्यं मया वक्तुं न पार्य्यते ।\nसुग्रीवतीर्थं वक्ष्यामि रामसेतौ विमुक्तिदे॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003979033, "chapter_id": 23979, "verse_number": "३-१-४२-३४", "content_sanskrit": "अत्र स्नात्वा नरो भक्त्या सूर्यलोकं समश्नुते ।\nसुग्रीवतीर्थे स्नानेन हयमेधफलं भवेत्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003979034, "chapter_id": 23979, "verse_number": "३-१-४२-३५", "content_sanskrit": "ब्रह्महत्यादि पापानां निष्कृतिश्चापि जायते ।\nसुग्रीवतीर्थगमनाद्गोसहस्रफलं लभेत्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003979035, "chapter_id": 23979, "verse_number": "३-१-४२-३६", "content_sanskrit": "स्मरणात्तस्य वेदानां पारायणफलं लभेत् ।\nदिनोपवासमात्रेण तस्य तीर्थस्य तीरतः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003979036, "chapter_id": 23979, "verse_number": "३-१-४२-३७", "content_sanskrit": "महापात कनाशः स्यात्प्रायश्चित्तं विना द्विजाः ।\nतत्राभिषेकं कुर्वाणः पितृदेवांश्च तर्पयेत्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003979037, "chapter_id": 23979, "verse_number": "३-१-४२-३८", "content_sanskrit": "आप्तोर्यामस्य यज्ञस्य फलमष्टगुणं भवेत् ।\nसुग्रीवतीर्थस्नानेन नरमेधफलं लभेत॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003979038, "chapter_id": 23979, "verse_number": "३-१-४२-३९", "content_sanskrit": "सुग्रीवतीर्थस्नानेन नरो जातिस्मरो भवेत् ।\nसुग्रीवतीर्थं भो विप्राः प्रयाताभीष्टसिद्धये॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003979039, "chapter_id": 23979, "verse_number": "३-१-४२-४०", "content_sanskrit": "सुग्रीवतीर्थमा हात्म्यमेवं वः कथितं द्विजाः॥  ।\nवैभवं नलतीर्थस्य त्विदानीं प्रब्रवीमि वः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003979040, "chapter_id": 23979, "verse_number": "३-१-४२-४१", "content_sanskrit": "नलतीर्थे नरः स्नानात्स्वर्गलोकं समश्नुते ।\nनलतीर्थे सकृत्सनानात्सर्वपापाविमोचितः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003979041, "chapter_id": 23979, "verse_number": "३-१-४२-४२", "content_sanskrit": "अग्निष्टोमातिरात्रादिफलमाप्नोत्यनुत्तमम् ।\nत्रिरात्रमुषितस्तस्मिंस्तर्पयन्पितृदेवताः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003979042, "chapter_id": 23979, "verse_number": "३-१-४२-४३", "content_sanskrit": "सूर्यवद्भासते विप्रा वाजिमेधफलं लभेत् ।\nनीलतीर्थं प्रवक्ष्यामि महापातकनाशनम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003979043, "chapter_id": 23979, "verse_number": "३-१-४२-४४", "content_sanskrit": "अग्निपुत्रेण नीलेन कृतं सेतौ विमुक्तिदम् ।\nनीलतीर्थे नरः स्नानात्सर्वपापविमोचितः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003979044, "chapter_id": 23979, "verse_number": "३-१-४२-४५", "content_sanskrit": "बहुवर्ण्यस्य यागस्य फलं शतगुणं लभेत् ।\nनीलतीर्थे नरः स्नात्वा सर्वा भीष्टप्रदायिनि॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003979045, "chapter_id": 23979, "verse_number": "३-१-४२-४६", "content_sanskrit": "अग्निलोकमवाप्नोति सर्वकामसमृद्धिमान् ।\nगवाक्षेण कृतं तीर्थं गंधमादनपर्वते॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003979046, "chapter_id": 23979, "verse_number": "३-१-४२-४७", "content_sanskrit": "विद्यते स्नानमात्रेण नरकं नैव याति सः ।\nअगदेन कृतं तीर्थमस्ति सेतौ विमुक्तिदे॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003979047, "chapter_id": 23979, "verse_number": "३-१-४२-४८", "content_sanskrit": "अत्र स्नानेन मनुजो देवेंद्रत्वं समश्नुते॥  ।\nगजेन गवयेनात्र शरभेण महौजसा॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003979048, "chapter_id": 23979, "verse_number": "३-१-४२-४९", "content_sanskrit": "कुमुदेन हरेणापि पनसेन बलीयसा ।\nकृतानि यानि तीर्थानि तथाऽन्यैः सर्ववानरैः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003979049, "chapter_id": 23979, "verse_number": "३-१-४२-५०", "content_sanskrit": "रामसेतौ महापुण्ये गन्धमादनपर्वते ।\nतेषु तीर्थेषु यः स्नाति सोऽमृतत्वं समश्नुते॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003979050, "chapter_id": 23979, "verse_number": "३-१-४२-५१", "content_sanskrit": "विभीषणकृतं तीर्थमस्ति पापविमोचनम् ।\nमहादुःखप्रशमनं महारोगनिबर्हणम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003979051, "chapter_id": 23979, "verse_number": "३-१-४२-५२", "content_sanskrit": "महापातकसंघानामनलोपममुत्तमम् ।\nकुंभीपाकादिनरकक्लेशनाशनकारणम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003979052, "chapter_id": 23979, "verse_number": "३-१-४२-५३", "content_sanskrit": "दुःस्वप्र नाशनं धन्यं महादारिद्र्यबाधनम् ।\nतत्र यो मनुजः स्नायात्तस्य नास्तीह पातकम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003979053, "chapter_id": 23979, "verse_number": "३-१-४२-५४", "content_sanskrit": "स वैकुंठमवाप्नोति पुनरावृत्तिवर्जितम् ।\nविभीषणस्य सचिवैः कृतं तीर्थचतुष्टयम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003979054, "chapter_id": 23979, "verse_number": "३-१-४२-५५", "content_sanskrit": "तत्र स्नानेन मनुजः सर्वपापैः प्रमुच्यते ।\nसरयूश्च नदी विप्रा गंधमादनपर्वते॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003979055, "chapter_id": 23979, "verse_number": "३-१-४२-५६", "content_sanskrit": "रामनाथं महादेवं सेवितुं वर्तते सदा ।\nतत्र स्नात्वा नराः सर्वे सर्वपातकवर्जिताः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003979056, "chapter_id": 23979, "verse_number": "३-१-४२-५७", "content_sanskrit": "सर्वयज्ञतपस्तीर्थसेवाफलमवाप्नुयुः ।\nदशकोटिसहस्राणि तीर्थानि द्विजसत्तमाः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003979057, "chapter_id": 23979, "verse_number": "३-१-४२-५८", "content_sanskrit": "वसंत्यस्मिन्महापुण्ये गन्धमादनपर्वते ।\nगंगाद्याः सरितः सर्वास्तथा वै सप्तसागराः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003979058, "chapter_id": 23979, "verse_number": "३-१-४२-५९", "content_sanskrit": "ऋष्याश्रमाणि पुण्यानि तथा पुण्यवनानि च ।\nअनुत्तमानि क्षेत्राणि हीरशंकरयोस्तथा॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003979059, "chapter_id": 23979, "verse_number": "३-१-४२-६०", "content_sanskrit": "सान्निध्यं कुर्वते नित्यं गन्धमादनपर्वते ।\nउपवीतांतरं तीर्थं प्रोक्तवांश्चतुराननः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003979060, "chapter_id": 23979, "verse_number": "३-१-४२-६१", "content_sanskrit": "त्रयस्त्रिंशत्कोट्योऽत्र देवाः पितृगणैः सह ।\nसर्वैश्च मुनिभिः सार्द्धं यक्षैः सिद्धैश्च किन्नरैः ।\nवसंति सेतौ देवस्य रामच न्द्रस्य चाज्ञया॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003979061, "chapter_id": 23979, "verse_number": "३-१-४२-६२", "content_sanskrit": "श्रीसूत उवाच ।\nएवमुक्तं द्विजश्रेष्ठा तीर्थानां वैभवं मया॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003979062, "chapter_id": 23979, "verse_number": "३-१-४२-६३", "content_sanskrit": "इदं पठन्वा शृण्वन्वा दुःखसंघाद्विमुच्यते ।\nकैवल्यं च समाप्नोति पुनरावृत्तिवर्जितम्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]