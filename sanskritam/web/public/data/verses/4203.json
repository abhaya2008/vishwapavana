[{"id": 2148069, "chapter_id": 4203, "verse_number": "", "content_sanskrit": "सृञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2148070, "chapter_id": 4203, "verse_number": "१", "content_sanskrit": "कृष्णायसस्य बत ते संहत्या हृदयं कृतम् ।\nमम मातस्त्वकरुणे वैरप्रज्ञेऽत्यमर्षणे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2148071, "chapter_id": 4203, "verse_number": "२", "content_sanskrit": "अहो क्षत्रसमाचारो यत्र मामितरं यथा ।\nनियोजयसि युद्धाय परमातेव मां तथा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2148072, "chapter_id": 4203, "verse_number": "३", "content_sanskrit": "ईदृशं वचनं ब्रूयाद् भवती पुत्रमेकजम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2148073, "chapter_id": 4203, "verse_number": "४", "content_sanskrit": "किं नु ते मामपश्यन्त्याः पृथिव्याऽपि च सर्वया ।\nकिमाभरणकृत्येन किं भोगैर्जीवितेन वा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2148074, "chapter_id": 4203, "verse_number": "५", "content_sanskrit": "मयि वा सङ्गरहते प्रियपुत्रे विशेषतः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2148075, "chapter_id": 4203, "verse_number": "", "content_sanskrit": "विदुला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2148076, "chapter_id": 4203, "verse_number": "६", "content_sanskrit": "सर्वारम्भा हि विदुषां तात धर्मार्थकारणात् ।\nतानेवाभिसमीक्ष्याहं सृञ्जय त्वामचूचुदम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2148077, "chapter_id": 4203, "verse_number": "७", "content_sanskrit": "सुसंवीक्ष्यः क्रमोपेतो मुख्यः कालोऽयमागतः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2148078, "chapter_id": 4203, "verse_number": "८", "content_sanskrit": "अस्मिंश्चेदागते काले कार्यं न प्रतिपद्यसे ।\nअसम्भावितरूपस्त्वं सुनृशंसं करिष्यसि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2148079, "chapter_id": 4203, "verse_number": "९", "content_sanskrit": "तं त्वामयशसा स्पृष्टं न ब्रूयां यदि सृञ्जय ।\nपरिवाक्शल्यमाहुस्त्वां निस्सामर्थ्यमहेतुकम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2148080, "chapter_id": 4203, "verse_number": "१०", "content_sanskrit": "सद्भिर्विगर्हितं मार्गं त्यज मूर्खनिषेवितम् ।\nअविद्या वै महत्यस्ति यामिमां संश्रिताः प्रजाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2148081, "chapter_id": 4203, "verse_number": "११", "content_sanskrit": "तव स्याद्यदि सद्वृत्तं तेन मे त्वं प्रियो भव\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2148082, "chapter_id": 4203, "verse_number": "१२", "content_sanskrit": "धर्मार्थगुणयुक्तेन नेतरेण कथञ्चन ।\nदैवमानुषयुक्तेन सद्भिराचरितेन च\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2148083, "chapter_id": 4203, "verse_number": "१३", "content_sanskrit": "यो ह्येवमविनीतेन रमते पुत्र नप्तृणा ।\nअनुत्थानवता चापि दुर्विनीतेन दुर्धिया\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2148084, "chapter_id": 4203, "verse_number": "१४", "content_sanskrit": "रमते यस्तु पुत्रेण मोघं तस्य प्रजाफलम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2148085, "chapter_id": 4203, "verse_number": "१५", "content_sanskrit": "अकुर्वन्तो हि कर्माणि कुर्वन्तो निन्दितानि च ।\nसुखं नैवेह नामुत्र लभन्ते पुरुषाधमाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2148086, "chapter_id": 4203, "verse_number": "१६", "content_sanskrit": "युद्धाय क्षत्रियः सृष्टः सृञ्जयेह जयाय च ।\nक्रूराय कर्मणे नित्यं प्रजानां परिपालने\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2148087, "chapter_id": 4203, "verse_number": "१७", "content_sanskrit": "जयन् वा वध्यमानो वा प्राप्नोतीन्द्रसलोकताम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2148088, "chapter_id": 4203, "verse_number": "१८", "content_sanskrit": "न शक्रभवने पुण्ये दिवि तद् विद्यते सुखम् ।\nयदमित्रान् वशे कृत्वा क्षत्रियः सुखमश्नुते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2148089, "chapter_id": 4203, "verse_number": "१९", "content_sanskrit": "मन्युना दह्यमानेन पुरुषेण तपस्विना ।\nनिकृतेनेह बहुशः शत्रून् प्रतिजिगीषता\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2148090, "chapter_id": 4203, "verse_number": "२०", "content_sanskrit": "आत्मानं वा परित्यज्य शत्रुं वा विनिपात्य च ।\nअतोऽन्येन प्रकारेण शान्तिरस्य कुतो भवेत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2148091, "chapter_id": 4203, "verse_number": "२१", "content_sanskrit": "इह प्राज्ञो हि पुरुषः स्वल्पमप्रियमिच्छति ।\nयस्यानल्पं प्रियं लोके ध्रुवं तस्याल्पमप्रियम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2148092, "chapter_id": 4203, "verse_number": "२२", "content_sanskrit": "प्रियाभावाच्च पुरुषो नैव प्राप्नोति शोभनम् ।\nध्रुवं चाभावमभ्येति गत्वा गङ्गेव सागरम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2148093, "chapter_id": 4203, "verse_number": "", "content_sanskrit": "पुत्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2148094, "chapter_id": 4203, "verse_number": "२३", "content_sanskrit": "नेयं मतिस्त्वया वाच्या मातः पुत्रे विशेषतः ।\nकारुण्यमेव सन्दृश्यं भूत्वेह जडमूकवत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2148095, "chapter_id": 4203, "verse_number": "", "content_sanskrit": "माता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2148096, "chapter_id": 4203, "verse_number": "२४", "content_sanskrit": "अतो मे भूयसी नन्दिः यद्येवमनुपश्यसि ।\nचोद्यां मां चोदयस्वैतद् भृशं वै चोदयामि ते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2148097, "chapter_id": 4203, "verse_number": "२५", "content_sanskrit": "अथ त्वां पूजयिष्यामि हत्वा वै सर्वसैन्धवान् ।\nअहं पश्यामि विजयं कृत्स्नं भाविनमेव ते\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2148098, "chapter_id": 4203, "verse_number": "", "content_sanskrit": "पुत्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2148099, "chapter_id": 4203, "verse_number": "२६", "content_sanskrit": "अकोशस्यासहायस्य कुतो वा विजयो मम ।\nइत्यवस्थां विदित्वैनामात्मनाऽऽत्मनि दारुणाम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2148100, "chapter_id": 4203, "verse_number": "२७", "content_sanskrit": "राज्याद् भावो निवृत्तो मे त्रिदिवादिव दुष्कृतेः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2148101, "chapter_id": 4203, "verse_number": "२८", "content_sanskrit": "कीदृशं भवती कञ्चिद् उपायमनुपश्यति ।\nतं मे परिणतप्रज्ञे सम्यक् प्रब्रूहि पृच्छते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2148102, "chapter_id": 4203, "verse_number": "२९", "content_sanskrit": "करिष्यामीह तत् सर्वं यथावदनुशासनम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2148103, "chapter_id": 4203, "verse_number": "", "content_sanskrit": "माता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2148104, "chapter_id": 4203, "verse_number": "३०", "content_sanskrit": "पुत्र नात्माऽवमन्तव्यः पूर्वाभिरसमृद्धिभिः ।\nअभूत्वा हि भवन्त्यर्था भूत्वा नश्यन्ति चापरे\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2148105, "chapter_id": 4203, "verse_number": "३१", "content_sanskrit": "अमर्षेणैव चाप्यर्था आरब्धव्यास्त्वबालिशैः ।\nसर्वेषां कर्मणां तात फले नित्यमनित्यता\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2148106, "chapter_id": 4203, "verse_number": "३२", "content_sanskrit": "अनित्यमिति जानन्तो भवन्ति न भवन्ति च ।\nअथ ये नैव कुर्वन्ति नैव जातु भवन्ति ते\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2148107, "chapter_id": 4203, "verse_number": "३३", "content_sanskrit": "ऐकगुण्यमनीहायामभावः कर्मणां फलम् ।\nअथ द्वैगुण्यमीहायां फलं भवति वा न वा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2148108, "chapter_id": 4203, "verse_number": "३४", "content_sanskrit": "यस्य प्रागेव विदिता सर्वार्थानामनित्यता ।\nवदेदवृद्ध्यसमृद्धी न प्रतिकूले नृपात्मज\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2148109, "chapter_id": 4203, "verse_number": "३५", "content_sanskrit": "उत्थातव्यं जागृतव्यं योक्तव्यं भूतिकर्मसु ।\nभविष्यतीत्येव मनः कृत्वा सततमव्यथः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2148110, "chapter_id": 4203, "verse_number": "३६", "content_sanskrit": "मङ्गलानि पुरस्कृत्य ब्राह्मणांश्चेतरैः सह ।\nप्राज्ञस्य नृपतेराशु वृद्धिर्भवति पुत्रक\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2148111, "chapter_id": 4203, "verse_number": "३७", "content_sanskrit": "अभिवर्तति लक्ष्मीस्तं प्राचीमिव दिवाकरः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2148112, "chapter_id": 4203, "verse_number": "३८", "content_sanskrit": "निदर्शनान्युपायांश्च बहून्युद्धर्षणानि च ।\nअनुदर्शितरूपोऽसि पश्यामि कुलपौरुषम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2148113, "chapter_id": 4203, "verse_number": "३९", "content_sanskrit": "पुरुषार्थमभिप्रेतं ममाहर्तुमिहार्हसि\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2148114, "chapter_id": 4203, "verse_number": "४०", "content_sanskrit": "क्रुद्धाँल्लुब्धान् परिक्षीणानवलिप्तान् विमानितान् ।\nस्पर्धिनश्चैव ये केचित् तान् युक्त उपधारय\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2148115, "chapter_id": 4203, "verse_number": "४१", "content_sanskrit": "एतेन त्वं प्रकारेण महतो भेत्स्यसे गणान् ।\nमहावेग इवोद्धूतो मातरिश्वा बलाहकान्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2148116, "chapter_id": 4203, "verse_number": "४२", "content_sanskrit": "येषामग्रप्रदायी स्याः काल्योत्थायी प्रियंवदः ।\nते त्वा प्रियं करिष्यन्ति पुरो धास्यन्ति च ध्रुवम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2148117, "chapter_id": 4203, "verse_number": "४३", "content_sanskrit": "यदैव शत्रुर्जानीयात् सपत्नं त्यक्तजीवितम् ।\nतदैवास्मादुद्विजते सर्पाद् वेश्मगतादिव\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2148118, "chapter_id": 4203, "verse_number": "४४", "content_sanskrit": "तं विदित्वा पराक्रान्तं वशे न कुरुते यदि ।\nनिर्वादैर्निर्वदेदेनम् अन्ततस्तद् भविष्यति\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2148119, "chapter_id": 4203, "verse_number": "४५", "content_sanskrit": "निर्वादादास्पदं लब्ध्वा धनवृद्धिर्भविष्यति ।\nधनवन्तं हि मित्राणि भजन्ते चाश्रयन्ति च\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2148120, "chapter_id": 4203, "verse_number": "४६", "content_sanskrit": "स्खलितार्थं पुनस्तात सन्त्यजन्ति च बान्धवाः ।\nन ह्यस्मिन्नाश्रयन्ते च जुगुप्सन्ते न तादृशम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2148121, "chapter_id": 4203, "verse_number": "४७", "content_sanskrit": "शत्रुं कृत्वा यः सहायं विश्वासमुपगच्छति ।\nस न सम्भाव्यमेवैतद् यद् राज्यं प्राप्नुयान्महत्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2148122, "chapter_id": 4203, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि चतुस्त्रिंशोत्तरशततमोऽध्यायः ॥१३४॥\nभगवद्यानपर्वणि पञ्चषष्टितमोऽध्यायः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]