[{"id": 2113898, "chapter_id": 3449, "verse_number": "", "content_sanskrit": "द्रोणस्योत्पत्तिः । तस्य परशुरामादस्त्रप्राप्तिश्च । अश्वत्थाम्न उत्पत्तिश्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2113899, "chapter_id": 3449, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2113900, "chapter_id": 3449, "verse_number": "१", "content_sanskrit": "महर्षिस्तु भरद्वाजो हविर्धानेऽभवत् पुरा ।\nगङ्गाद्वारं प्रति महान् बभूवर्षिर्महातपाः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2113901, "chapter_id": 3449, "verse_number": "२", "content_sanskrit": "भरद्वाजो महाप्राज्ञः सततं संशितव्रतः ।\nसोऽभिषेक्तुं ततो गङ्गां पूर्वमेवागतां नदीम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2113902, "chapter_id": 3449, "verse_number": "३", "content_sanskrit": "ददर्शाप्सरसं साक्षाद् घृताचीमाप्लुतामृषिः ।\nरूपयौवनसम्पन्नां मददृप्तां मदालसाम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2113903, "chapter_id": 3449, "verse_number": "४", "content_sanskrit": "तस्या वायुर्नदीतीरे वसनं व्यहरत् तदा ।\nअपकृष्टाम्बरां दृष्ट्वा तामृषिश्चकमे तदा \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2113904, "chapter_id": 3449, "verse_number": "५", "content_sanskrit": "तत्र संरक्तमनसो भरद्वाजस्य धीमतः ।\nहृष्टस्य रेतः चस्कन्द तदृषिर्द्रोण आदधत् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2113905, "chapter_id": 3449, "verse_number": "६", "content_sanskrit": "ततः समभवद् द्रोणः कुमारस्तस्य धीमतः ।\nअध्यगीष्ट स वेदांश्च वेदाङ्गानि च सर्वशः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2113906, "chapter_id": 3449, "verse_number": "७", "content_sanskrit": "अग्नेरस्त्रमुपादाय यद् ऋषिर्वेद काश्यपः ।\nअध्यगच्छद् भरद्वाजस्तदस्त्रं देवकार्यतः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2113907, "chapter_id": 3449, "verse_number": "८", "content_sanskrit": "अग्निवेश्यं महाभागं भरद्वाजः प्रतापवान् ।\nप्रत्यपादयदाग्नेयमस्त्रमस्त्रविदां वरः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2113908, "chapter_id": 3449, "verse_number": "९", "content_sanskrit": "कनिष्ठजातं स मुनिर्भ्राता भ्रातरमन्तिके ।\nअग्निवेश्यस्तथा द्रोणं तदा भरतसत्तम \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2113909, "chapter_id": 3449, "verse_number": "१०", "content_sanskrit": "भारद्वाजे स चाग्नेयं महास्त्रं प्रत्यवेदयत् ।\nस वै युक्तो गुरोर्भावे यदीच्छेत् कृपणः सुखम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2113910, "chapter_id": 3449, "verse_number": "११", "content_sanskrit": "भीष्मोऽप्यलपदेवं स भारद्वाजपरीप्सया ।\nइति सञ्चिन्त्य गाङ्गेयः तदा भरतसत्तमः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]