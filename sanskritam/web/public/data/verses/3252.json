[{"id": 2104373, "chapter_id": 3252, "verse_number": "१४-१०८-१", "content_sanskrit": "युधिष्ठिर उवाच।\nअनेकान्तं बहुद्वारं धर्ममाहुर्मनीपिणः।\nकिंलक्षणोसौ भति तन्मे ब्रूहि जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2104374, "chapter_id": 3252, "verse_number": "१४-१०८-२x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2104375, "chapter_id": 3252, "verse_number": "१४-१०८-२", "content_sanskrit": "शृणु राजन्समासेन धर्मशौचविधिक्रमम्।\nअहिंसा शौचमक्रोधमानृशंस्यं दमः शमः।\nआर्जवं चैव राजेन्द्र निश्चितं धर्मलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2104376, "chapter_id": 3252, "verse_number": "१४-१०८-३", "content_sanskrit": "ब्रह्मचर्यं तपः क्षान्तिर्मधुमांसस्य वर्जनम्।\nमर्यादायां स्थितिश्चैव शमः शौचस्य लक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2104377, "chapter_id": 3252, "verse_number": "१४-१०८-४", "content_sanskrit": "बाल्ये विद्यां निषेवेत यौवने दारसंग्रहम्।\nवार्धके मौनमातिष्ठेत्सर्वदा धर्ममाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2104378, "chapter_id": 3252, "verse_number": "१४-१०८-५", "content_sanskrit": "ब्राह्मणान्नावमन्येत गुरुन्परिवदेन्न च।\nयतीनामनुकूलः स्यादेष धर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2104379, "chapter_id": 3252, "verse_number": "१४-१०८-६", "content_sanskrit": "यतिर्गुरुर्द्विजातीनां वर्णानां ब्राह्मणो गुरुः।\nपतिरेव गुरुः स्त्रीणां सर्वेषां पार्थिवो गुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2104380, "chapter_id": 3252, "verse_number": "१४-१०८-७", "content_sanskrit": "यद्गृहस्तार्जितं पापं ज्ञानतोऽज्ञानतोपि वा।\nनिर्दहिष्यति तत्सर्वमेकरात्रोषितो यतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2104381, "chapter_id": 3252, "verse_number": "१४-१०८-८", "content_sanskrit": "दुर्वृत्ता वा सुवृत्ता वा ज्ञानिनोऽज्ञानिनोपि वा।\nगृहस्थैर्यतयः पूज्याः परत्र हितकाङ्क्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2104382, "chapter_id": 3252, "verse_number": "१४-१०८-९", "content_sanskrit": "एकदण्डी त्रिदण्डी वा शिखी वा मुण्डितोपि वा।\nकाषायदण्डधारोपि यतिः पूज्यो न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2104383, "chapter_id": 3252, "verse_number": "१४-१०८-१०", "content_sanskrit": "अपूजितो गृहस्थैर्वा तथा चाप्यवमानितः।\nयतिर्वाऽप्यतिथिर्वाऽपि नरके पातयिष्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2104384, "chapter_id": 3252, "verse_number": "१४-१०८-११", "content_sanskrit": "तस्मात्तु यत्नतः पूज्या मद्भक्ता मत्परायणाः।\nमयि संन्यस्तकर्माणः परत्र हितकाङ्क्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2104385, "chapter_id": 3252, "verse_number": "१४-१०८-१२", "content_sanskrit": "प्रहरेन्न द्विजान्विप्रो गां न हन्यात्कदाचन।\nभ्रूणहत्यासमं चैव उभयं यो निषेवते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2104386, "chapter_id": 3252, "verse_number": "१४-१०८-१३", "content_sanskrit": "नाग्निं मुखेनोपधमेन्न च पादौ प्रतापयेत्।\nनाधः कुर्यात्कदाचित्तु न पृष्ठं परितापयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2104387, "chapter_id": 3252, "verse_number": "१४-१०८-१४", "content_sanskrit": "नान्तरा गमनं कुर्यान्न चामेध्यं विनिक्षिपेत्।\nउच्छिष्टो न स्पृशेदग्निमाशौचस्थो न जातुचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2104388, "chapter_id": 3252, "verse_number": "१४-१०८-१५", "content_sanskrit": "श्वचण्डालादिभिः स्पृष्टो नाङ्गमग्नौ प्रतापयेत्।\nसर्वदेवमयो वह्निस्तस्माच्छुद्धः सदा स्पृशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2104389, "chapter_id": 3252, "verse_number": "१४-१०८-१६", "content_sanskrit": "प्राप्तमूत्रपुरीषस्तु न स्पृशेद्वह्निमात्मवान्।\nयावत्तु धारयेद्वेगं तावदप्रयतो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2104390, "chapter_id": 3252, "verse_number": "१४-१०८-१७", "content_sanskrit": "पचनाग्निं न गृह्णीयात्परवेश्मनि जातुचित्।\nतस्मिन्पक्वेन चान्नेन यत्कर्म कुरुते शुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2104391, "chapter_id": 3252, "verse_number": "१४-१०८-१८", "content_sanskrit": "तस्यैव तच्छुभस्यार्धमग्निदस्य भवेन्नृप।\nतस्माद्गृहगतं वह्निं प्रकुर्यादविनाशितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2104392, "chapter_id": 3252, "verse_number": "१४-१०८-१९", "content_sanskrit": "प्रमादाद्यदि वाऽज्ञानात्तस्य नाशो भविष्यति।\nगृह्णीयात्तु मथित्वा वा श्रोत्रियागारतोपि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2104393, "chapter_id": 3252, "verse_number": "१४-१०८-२०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2104394, "chapter_id": 3252, "verse_number": "१४-१०८-२०", "content_sanskrit": "कीदृशाः साधवो विप्रास्तेभ्यो दत्तं महाफलम्।\nकीदृशेभ्यो हि दातव्यं तन्मे ब्रूहि जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2104395, "chapter_id": 3252, "verse_number": "१४-१०८-२१x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2104396, "chapter_id": 3252, "verse_number": "१४-१०८-२१", "content_sanskrit": "अक्रोधनाः सत्यपरा धर्मनित्या जितेन्द्रियाः।\nतादृशाः साधवो विप्रास्तेभ्यो दत्तं महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2104397, "chapter_id": 3252, "verse_number": "१४-१०८-२२", "content_sanskrit": "अमानिनः सर्वसहा दृष्टार्था विजितेन्द्रियाः।\nसर्वभूतहिता मैत्रास्तेभ्यो दत्तं महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2104398, "chapter_id": 3252, "verse_number": "१४-१०८-२३", "content_sanskrit": "अलुब्धाः शुचयो वैद्या हीमन्तः सत्यवादिनः।\nस्वधर्मनिरता ये तु तेभ्यो दत्तं महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2104399, "chapter_id": 3252, "verse_number": "१४-१०८-२४", "content_sanskrit": "साङ्गंश्च चतुरो वेदान्योऽधीयेत दिनेदिने।\nशूद्रान्नं यस्य नो देहे तत्पात्रमृषयो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2104400, "chapter_id": 3252, "verse_number": "१४-१०८-२५", "content_sanskrit": "प्रज्ञाश्रुताभ्यां वृत्तेन शीलेन च समन्वितः।\nतारयेत्तत्कुलं सर्वमेकोपीह युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2104401, "chapter_id": 3252, "verse_number": "१४-१०८-२६", "content_sanskrit": "गामश्वमन्नं वित्तं वा तद्विधे प्रतिपादयेत्।\nनिशम्य तु गुणोपेतं ब्राह्मअणं साधुसंमतम्।\nदूरादाहृत्य सत्कृत्य तं प्रयत्नेन पूजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2104402, "chapter_id": 3252, "verse_number": "१४-१०८-२७x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2104403, "chapter_id": 3252, "verse_number": "१४-१०८-२७", "content_sanskrit": "धर्माधर्मविधिस्त्वेवं भीमं भीष्मेण भाषितम्।\nभीष्मवाक्यात्सारभूतं वद धर्मं सुरेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2104404, "chapter_id": 3252, "verse_number": "१४-१०८-२८x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2104405, "chapter_id": 3252, "verse_number": "१४-१०८-२८", "content_sanskrit": "अन्नेन धार्यते सर्वं जगदेतच्चराचरम्।\nअन्नात्प्रभवति प्राणः प्रत्यक्षं नास्ति संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2104406, "chapter_id": 3252, "verse_number": "१४-१०८-२९", "content_sanskrit": "कलत्रं पीडयित्वा तु देशे काले च शक्तितः।\nदातव्यं भिक्षवे चान्नमात्मनो भूतिमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2104407, "chapter_id": 3252, "verse_number": "१४-१०८-३०", "content_sanskrit": "विप्रमध्वपरिश्रान्तं बालं वृद्धमथापि वा।\nअर्चयेद्गुरुवत्प्रीतो गृहस्थो गृहमागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2104408, "chapter_id": 3252, "verse_number": "१४-१०८-३१", "content_sanskrit": "क्रोधमुत्पतितं हित्वा सुशीलो वीतमत्सरः।\nअर्चयेदतिथिं प्रीतः परत्र हितभूतये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2104409, "chapter_id": 3252, "verse_number": "१४-१०८-३२", "content_sanskrit": "अतिथिं नावमन्येत नानृतां गिरमीरयेत्।\nन पृच्छेद्गोत्रचरणं नाधीतं वा कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2104410, "chapter_id": 3252, "verse_number": "१४-१०८-३३", "content_sanskrit": "चण्डालो वा श्वपाको वा काले यः कश्चिदागतः।\nअन्नेन पूजनीयः स्यात्परत्र हितमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2104411, "chapter_id": 3252, "verse_number": "१४-१०८-३४", "content_sanskrit": "पिधाय तु गृहद्वारं भुक्ते योऽन्नं प्रहृष्टवान्।\nस्वर्गद्वारपिधानं वै कृतं तेन युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2104412, "chapter_id": 3252, "verse_number": "१४-१०८-३५", "content_sanskrit": "पितॄन्देवानृषीन्विप्रानतिथींश्च निराश्रयान्।\nयो नरः प्रीणयत्यन्नैस्तस्य पुण्यफलं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2104413, "chapter_id": 3252, "verse_number": "१४-१०८-३६", "content_sanskrit": "कृत्वा तु पापं बहुशो यो दद्यादन्नमर्थिने।\nब्राह्मणाय विशेषेण सर्वपापैः प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2104414, "chapter_id": 3252, "verse_number": "१४-१०८-३७", "content_sanskrit": "अन्नदः प्राणदो लोके प्राणदः सर्वदो भवेत्।\nतस्मादन्नं विशेषेण दातव्यं भूतिमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2104415, "chapter_id": 3252, "verse_number": "१४-१०८-३८", "content_sanskrit": "अन्नं ह्यमृतमित्याहुरन्नं प्रजननं स्मृतम्।\nअन्नप्रणाशो सीदन्ति शरीरे पञ्च धातवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2104416, "chapter_id": 3252, "verse_number": "१४-१०८-३९", "content_sanskrit": "बलं बलवतो नश्येदन्नहीनस्य देहिनः।\nतस्मादन्नं विशेषेण श्रद्धयाऽश्रद्धयापि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2104417, "chapter_id": 3252, "verse_number": "१४-१०८-४०", "content_sanskrit": "आदत्ते हि रसं सर्वमादित्यः स्वगभस्तिभिः।\nवायुस्तस्मात्समादाय रसं मेधेषु धारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2104418, "chapter_id": 3252, "verse_number": "१४-१०८-४१", "content_sanskrit": "तत्तु मेघगतं भूमौ शक्रो वर्षति तादृशम्।\nतेन दिग्धा भवेद्देवी मही प्रीता च ****", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2104419, "chapter_id": 3252, "verse_number": "१४-१०८-४२", "content_sanskrit": "तस्यां सस्यानि रोहन्ति यैर्जीवन्त्यखिलाः प्रजाः।\nमांसमेदोस्थिमज्जानां सम्भवस्तेभ्य एव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2104420, "chapter_id": 3252, "verse_number": "१४-१०८-४३", "content_sanskrit": "एवं सूर्यश्च पवनो मेघः शक्रस्तथैव च।\nएक एव स्थितो राशिर्यतो भूतानि जज्ञिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2104421, "chapter_id": 3252, "verse_number": "१४-१०८-४४", "content_sanskrit": "भवनानि च दिव्यानि दिवि तेषां महात्मनाम्।\nनानासंस्थानि भूतानि नानाभूमिगतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2104422, "chapter_id": 3252, "verse_number": "१४-१०८-४५", "content_sanskrit": "चन्द्रमण्डलशुभ्राणि किङ्किणीजालवन्ति च।\nतरुणादित्यवर्णानि स्थावराणि चराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2104423, "chapter_id": 3252, "verse_number": "१४-१०८-४६", "content_sanskrit": "अनेकशतसङ्ख्यानि सान्तर्जलवनानि च।\nतत्र पुष्पफलोपेताः कामदाः सुरपादपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2104424, "chapter_id": 3252, "verse_number": "१४-१०८-४७", "content_sanskrit": "वाप्यो बद्धसभाः कूपा दीर्घिकाश्च सहस्रशः।\nभक्ष्यभोज्यमयाः शैला वासांस्याभरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2104425, "chapter_id": 3252, "verse_number": "१४-१०८-४८", "content_sanskrit": "क्षीरस्रवन्त्यः सरितस्तथा चैवान्नपर्वताः।\nघोषवन्ति च यानानि युक्तान्यथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2104426, "chapter_id": 3252, "verse_number": "१४-१०८-४९", "content_sanskrit": "प्रासादप्रवराः शुभ्राः शय्याश्च कनकोज्ज्वलाः।\nअन्नदास्तत्र तिष्ठन्ति तस्मादन्नप्रदो भवेत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2104427, "chapter_id": 3252, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि वैष्णवधर्मपर्वणि अष्टोत्तरशततमोऽध्यायः॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]