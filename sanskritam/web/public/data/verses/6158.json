[
  {
    "id": 16758001,
    "chapter_id": 6158,
    "verse_number": "10.1",
    "content_sanskrit": "श्रीभगवानुवाच —",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "BG_C10_V01"
  },
  {
    "id": 16758002,
    "chapter_id": 6158,
    "verse_number": "10.2",
    "content_sanskrit": "न मे विदुः सुरगणाः प्रभवं न महर्षयः ।\nअहमादिर्हि देवानां महर्षीणां च सर्वशः ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "BG_C10_V02"
  },
  {
    "id": 16758003,
    "chapter_id": 6158,
    "verse_number": "10.3",
    "content_sanskrit": "यो मामजमनादिं च वेत्ति लोकमहेश्वरम् ।\nअसंमूढः स मर्त्येषु सर्वपापैः प्रमुच्यते ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "BG_C10_V03"
  },
  {
    "id": 16758004,
    "chapter_id": 6158,
    "verse_number": "10.4",
    "content_sanskrit": "बुद्धिर्ज्ञानमसंमोहः क्षमा सत्यं दमः शमः ।\nसुखं दुःखं भवोऽभावो भयं चाभयमेव च ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "BG_C10_V04"
  },
  {
    "id": 16758005,
    "chapter_id": 6158,
    "verse_number": "10.5",
    "content_sanskrit": "अहिंसा समता तुष्टिस्तपो दानं यशोऽयशः ।\nभवन्ति भावा भूतानां मत्त एव पृथग्विधाः ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "BG_C10_V05"
  },
  {
    "id": 16758006,
    "chapter_id": 6158,
    "verse_number": "10.6",
    "content_sanskrit": "महर्षयः सप्त पूर्वे चत्वारो मनवस्तथा ।\nमद्भावा मानसा जाता येषां लोक इमाः प्रजाः ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "BG_C10_V06"
  },
  {
    "id": 16758007,
    "chapter_id": 6158,
    "verse_number": "10.7",
    "content_sanskrit": "एतां विभूतिं योगं च मम यो वेत्ति तत्त्वतः ।\nसोऽविकम्पेन योगेन युज्यते नात्र संशयः ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "BG_C10_V07"
  },
  {
    "id": 16758008,
    "chapter_id": 6158,
    "verse_number": "10.8",
    "content_sanskrit": "अहं सर्वस्य प्रभवो मत्तः सर्वं प्रवर्तते ।\nइति मत्वा भजन्ते मां बुधा भावसमन्विताः ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "BG_C10_V08"
  },
  {
    "id": 16758009,
    "chapter_id": 6158,
    "verse_number": "10.9",
    "content_sanskrit": "मच्चित्ता मद्गतप्राणा बोधयन्तः परस्परम् ।\nकथयन्तश्च मां नित्यं तुष्यन्ति च रमन्ति च ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "base_unit_id": "BG_C10_V09"
  },
  {
    "id": 16758010,
    "chapter_id": 6158,
    "verse_number": "10.10",
    "content_sanskrit": "तेषां सततयुक्तानां भजतां प्रीतिपूर्वकम् ।\nददामि बुद्धियोगं तं येन मामुपयान्ति ते ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "base_unit_id": "BG_C10_V10"
  },
  {
    "id": 16758011,
    "chapter_id": 6158,
    "verse_number": "10.11",
    "content_sanskrit": "तेषामेवानुकम्पार्थमहमज्ञानजं तमः ।\nनाशयाम्यात्मभावस्थो ज्ञानदीपेन भास्वता ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "BG_C10_V11"
  },
  {
    "id": 16758012,
    "chapter_id": 6158,
    "verse_number": "10.12",
    "content_sanskrit": "अर्जुन उवाच —",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "BG_C10_V12"
  },
  {
    "id": 16758013,
    "chapter_id": 6158,
    "verse_number": "10.13",
    "content_sanskrit": "आहुस्त्वामृषयः सर्वे देवर्षिर्नारदस्तथा ।\nअसितो देवलो व्यासः स्वयं चैव ब्रवीषि मे ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "base_unit_id": "BG_C10_V13"
  },
  {
    "id": 16758014,
    "chapter_id": 6158,
    "verse_number": "10.14",
    "content_sanskrit": "सर्वमेतदृतं मन्ये यन्मां वदसि केशव ।\nन हि ते भगवन्व्यक्तिं विदुर्देवा न दानवाः ॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "base_unit_id": "BG_C10_V14"
  },
  {
    "id": 16758015,
    "chapter_id": 6158,
    "verse_number": "10.15",
    "content_sanskrit": "स्वयमेवात्मनात्मानं वेत्थ त्वं पुरुषोत्तम ।\nभूतभावन भूतेश देवदेव जगत्पते ॥ १५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "base_unit_id": "BG_C10_V15"
  },
  {
    "id": 16758016,
    "chapter_id": 6158,
    "verse_number": "10.16",
    "content_sanskrit": "वक्तुमर्हस्यशेषेण दिव्या ह्यात्मविभूतयः ।\nयाभिर्विभूतिभिर्लोकानिमांस्त्वं व्याप्य तिष्ठसि ॥ १६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "base_unit_id": "BG_C10_V16"
  },
  {
    "id": 16758017,
    "chapter_id": 6158,
    "verse_number": "10.17",
    "content_sanskrit": "कथं विद्यामहं योगिंस्त्वां सदा परिचिन्तयन् ।\nकेषु केषु च भावेषु चिन्त्योऽसि भगवन्मया ॥ १७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "base_unit_id": "BG_C10_V17"
  },
  {
    "id": 16758018,
    "chapter_id": 6158,
    "verse_number": "10.18",
    "content_sanskrit": "विस्तरेणात्मनो योगं विभूतिं च जनार्दन ।\nभूयः कथय तृप्तिर्हि शृण्वतो नास्ति मेऽमृतम् ॥ १८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "base_unit_id": "BG_C10_V18"
  },
  {
    "id": 16758019,
    "chapter_id": 6158,
    "verse_number": "10.19",
    "content_sanskrit": "श्रीभगवानुवाच —",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "base_unit_id": "BG_C10_V19"
  },
  {
    "id": 16758020,
    "chapter_id": 6158,
    "verse_number": "10.20",
    "content_sanskrit": "अहमात्मा गुडाकेश सर्वभूताशयस्थितः ।\nअहमादिश्च मध्यं च भूतानामन्त एव च ॥ २० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "base_unit_id": "BG_C10_V20"
  },
  {
    "id": 16758021,
    "chapter_id": 6158,
    "verse_number": "10.21",
    "content_sanskrit": "आदित्यानामहं विष्णुर्ज्योतिषां रविरंशुमान् ।\nमरीचिर्मरुतामस्मि नक्षत्राणामहं शशी ॥ २१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "base_unit_id": "BG_C10_V21"
  },
  {
    "id": 16758022,
    "chapter_id": 6158,
    "verse_number": "10.22",
    "content_sanskrit": "वेदानां सामवेदोऽस्मि देवानामस्मि वासवः ।\nइन्द्रियाणां मनश्चास्मि भूतानामस्मि चेतना ॥ २२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "base_unit_id": "BG_C10_V22"
  },
  {
    "id": 16758023,
    "chapter_id": 6158,
    "verse_number": "10.23",
    "content_sanskrit": "रुद्राणां शङ्करश्चास्मि वित्तेशो यक्षरक्षसाम् ।\nवसूनां पावकश्चास्मि मेरुः शिखरिणामहम् ॥ २३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "base_unit_id": "BG_C10_V23"
  },
  {
    "id": 16758024,
    "chapter_id": 6158,
    "verse_number": "10.24",
    "content_sanskrit": "पुरोधसां च मुख्यं मां विद्धि पार्थ बृहस्पतिम् ।\nसेनानीनामहं स्कन्दः सरसामस्मि सागरः ॥ २४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "base_unit_id": "BG_C10_V24"
  },
  {
    "id": 16758025,
    "chapter_id": 6158,
    "verse_number": "10.25",
    "content_sanskrit": "महर्षीणां भृगुरहं गिरामस्म्येकमक्षरम् ।\nयज्ञानां जपयज्ञोऽस्मि स्थावराणां हिमालयः ॥ २५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "base_unit_id": "BG_C10_V25"
  },
  {
    "id": 16758026,
    "chapter_id": 6158,
    "verse_number": "10.26",
    "content_sanskrit": "अश्वत्थः सर्ववृक्षाणां देवर्षीणां च नारदः ।\nगन्धर्वाणां चित्ररथः सिद्धानां कपिलो मुनिः ॥ २६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "base_unit_id": "BG_C10_V26"
  },
  {
    "id": 16758027,
    "chapter_id": 6158,
    "verse_number": "10.27",
    "content_sanskrit": "उच्चैःश्रवसमश्वानां विद्धि माममृतोद्भवम् ।\nऐरावतं गजेन्द्राणां नराणां च नराधिपम् ॥ २७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "base_unit_id": "BG_C10_V27"
  },
  {
    "id": 16758028,
    "chapter_id": 6158,
    "verse_number": "10.28",
    "content_sanskrit": "आयुधानामहं वज्रं धेनूनामस्मि कामधुक् ।\nप्रजनश्चास्मि कन्दर्पः सर्पाणामस्मि वासुकिः ॥ २८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "base_unit_id": "BG_C10_V28"
  },
  {
    "id": 16758029,
    "chapter_id": 6158,
    "verse_number": "10.29",
    "content_sanskrit": "अनन्तश्चास्मि नागानां वरुणो यादसामहम् ।\nपितॄणामर्यमा चास्मि यमः संयमतामहम् ॥ २९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "base_unit_id": "BG_C10_V29"
  },
  {
    "id": 16758030,
    "chapter_id": 6158,
    "verse_number": "10.30",
    "content_sanskrit": "प्रह्लादश्चास्मि दैत्यानां कालः कलयतामहम् ।\nमृगाणां च मृगेन्द्रोऽहं वैनतेयश्च पक्षिणाम् ॥ ३० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "base_unit_id": "BG_C10_V30"
  },
  {
    "id": 16758031,
    "chapter_id": 6158,
    "verse_number": "10.31",
    "content_sanskrit": "पवनः पवतामस्मि रामः शस्त्रभृतामहम् ।\nझषाणां मकरश्चास्मि स्रोतसामस्मि जाह्नवी ॥ ३१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "base_unit_id": "BG_C10_V31"
  },
  {
    "id": 16758032,
    "chapter_id": 6158,
    "verse_number": "10.32",
    "content_sanskrit": "सर्गाणामादिरन्तश्च मध्यं चैवाहमर्जुन ।\nअध्यात्मविद्या विद्यानां वादः प्रवदतामहम् ॥ ३२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "base_unit_id": "BG_C10_V32"
  },
  {
    "id": 16758033,
    "chapter_id": 6158,
    "verse_number": "10.33",
    "content_sanskrit": "अक्षराणामकारोऽस्मि\nद्वन्द्वः सामासिकस्य च ।\nअहमेवाक्षयः कालो\nधाताहं विश्वतोमुखः ॥ ३३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "base_unit_id": "BG_C10_V33"
  },
  {
    "id": 16758034,
    "chapter_id": 6158,
    "verse_number": "10.34",
    "content_sanskrit": "मृत्युः सर्वहरश्चाहमुद्भवश्च भविष्यताम् ।\nकीर्तिः श्रीर्वाक्च नारीणां स्मृतिर्मेधा धृतिः क्षमा ॥ ३४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "base_unit_id": "BG_C10_V34"
  },
  {
    "id": 16758035,
    "chapter_id": 6158,
    "verse_number": "10.35",
    "content_sanskrit": "बृहत्साम तथा साम्नां गायत्री च्छन्दसामहम् ।\nमासानां मार्गशीर्षोऽहमृतूनां कुसुमाकरः ॥ ३५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "base_unit_id": "BG_C10_V35"
  },
  {
    "id": 16758036,
    "chapter_id": 6158,
    "verse_number": "10.36",
    "content_sanskrit": "द्यूतं छलयतामस्मि\nतेजस्तेजस्विनामहम् ।\nजयोऽस्मि व्यवसायोऽस्मि\nसत्त्वं सत्त्ववतामहम् ॥ ३६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "base_unit_id": "BG_C10_V36"
  },
  {
    "id": 16758037,
    "chapter_id": 6158,
    "verse_number": "10.37",
    "content_sanskrit": "वृष्णीनां वासुदेवोऽस्मि\nपाण्डवानां धनञ्जयः ।\nमुनीनामप्यहं व्यासः\nकवीनामुशना कविः ॥ ३७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "base_unit_id": "BG_C10_V37"
  },
  {
    "id": 16758038,
    "chapter_id": 6158,
    "verse_number": "10.38",
    "content_sanskrit": "दण्डो दमयतामस्मि\nनीतिरस्मि जिगीषताम् ।\nमौनं चैवास्मि गुह्यानां\nज्ञानं ज्ञानवतामहम् ॥ ३८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "base_unit_id": "BG_C10_V38"
  },
  {
    "id": 16758039,
    "chapter_id": 6158,
    "verse_number": "10.39",
    "content_sanskrit": "यच्चापि सर्वभूतानां बीजं तदहमर्जुन ।\nन तदस्ति विना यत्स्यान्मया भूतं चराचरम् ॥ ३९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "base_unit_id": "BG_C10_V39"
  },
  {
    "id": 16758040,
    "chapter_id": 6158,
    "verse_number": "10.40",
    "content_sanskrit": "नान्तोऽस्ति मम दिव्यानां\nविभूतीनां परन्तप ।\nएष तूद्देशतः प्रोक्तो\nविभूतेर्विस्तरो मया ॥ ४० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "base_unit_id": "BG_C10_V40"
  },
  {
    "id": 16758041,
    "chapter_id": 6158,
    "verse_number": "10.41",
    "content_sanskrit": "यद्यद्विभूतिमत्सत्त्वं श्रीमदूर्जितमेव वा ।\nतत्तदेवावगच्छ त्वं मम तेजोंशसम्भवम् ॥ ४१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
