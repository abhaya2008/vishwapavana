[{"id": 7001033000, "chapter_id": 21033, "verse_number": "५-१५-१", "content_sanskrit": "श्रीपराशर उवाच।\nककुद्मति हतेऽरिष्टे धेनुके विनिपातिते ।\nप्रलंबे निधनं निधनं नीते धृते गोवर्द्धनाचले ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001033001, "chapter_id": 21033, "verse_number": "५-१५-२", "content_sanskrit": "दमिते कालिये नागे भग्ने तुंगद्रु मद्वये ।\nहतायां पूतनायां च शकटे परिवर्त्तिते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001033002, "chapter_id": 21033, "verse_number": "५-१५-३", "content_sanskrit": "कंसाय नारदः प्राह यथावृत्तमनुक्रमात् ।\nयशोदादेवकीगर्भपरिवृत्ताद्यश्षोतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001033003, "chapter_id": 21033, "verse_number": "५-१५-४", "content_sanskrit": "श्रुत्वा तत्सकलं कंसो नारदाद्देवदर्शनात् ।\nवसुदेवं प्रति तदा कोपं चक्रे सुदुर्मतिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001033004, "chapter_id": 21033, "verse_number": "५-१५-५", "content_sanskrit": "सोतिकोपादुपालभ्य सर्वयादवसंसदि ।\nजगर्ह यादवांश्चैव कार्यं चैतदचिंतयत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001033005, "chapter_id": 21033, "verse_number": "५-१५-६", "content_sanskrit": "यावन्न बलमारूढौ रामकृष्णौ सुबालकौ ।\nतावदेव मया वध्यावसाध्यौ रूढयौवनौ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001033006, "chapter_id": 21033, "verse_number": "५-१५-७", "content_sanskrit": "चाणूरोत्र महावीर्यो मुष्टिकश्च महाबलः ।\nएताभ्यां मल्लयुद्धेन मारयिष्याम दुर्मती ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001033007, "chapter_id": 21033, "verse_number": "५-१५-८", "content_sanskrit": "धनुर्महमहायोगव्याजेनानीय तौ व्रजात् ।\nतथा तथा यतिष्यामि यास्येते संक्षयं यथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001033008, "chapter_id": 21033, "verse_number": "५-१५-९", "content_sanskrit": "श्वफल्कतनयं शूरमक्रूरं यदुपुंगवम् ।\nतयोरानयनार्थाय प्रेषयिष्यामि गोकुलम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001033009, "chapter_id": 21033, "verse_number": "५-१५-१०", "content_sanskrit": "वृंदावनचरं घोरमादेक्ष्यामि च केशिनम् ।\nतत्रैवासावतिबलस्तावुभौ घातयिष्यति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001033010, "chapter_id": 21033, "verse_number": "५-१५-११", "content_sanskrit": "गजः कुवलायापीडो मत्सकाशमिहागतौ ।\nघातयिष्यति वा गोपौ वसुदेवसुतावुभौ ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001033011, "chapter_id": 21033, "verse_number": "५-१५-१२", "content_sanskrit": "श्रीपराशर उवाच।\nइत्यालोच्य स दुष्टात्मा कंसो रामजनार्दनौ ।\nहंतुं कृतमर्तिवीरावक्रूरं वाक्यमब्रवीत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001033012, "chapter_id": 21033, "verse_number": "५-१५-१३", "content_sanskrit": "कंस उवाच।\nभो भो दानपते वाक्यं क्रियतां प्रीतये मम ।\nइतः स्यंदनमारुह्य गम्यतां नंदगोकुलम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001033013, "chapter_id": 21033, "verse_number": "५-१५-१४", "content_sanskrit": "वसुदेव सुतौ तत्र विषणोरंशसमुद्भवौ ।\nनाशाय किल संभूतौ मम दुष्टौ प्रवर्द्धतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001033014, "chapter_id": 21033, "verse_number": "५-१५-१५", "content_sanskrit": "धनुर्महो ममाप्यत्र चतुर्दश्यां भविष्यति ।\nआनेयौ भवता गत्वा मल्लयुद्धाय तत्र तौ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001033015, "chapter_id": 21033, "verse_number": "५-१५-१६", "content_sanskrit": "चाणूरमुष्टिकौ मल्लौ नियुद्धकुशलौ मम ।\nताभ्यां सहानयोर्युद्धं सर्वलोकोऽत्र पश्यतु ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001033016, "chapter_id": 21033, "verse_number": "५-१५-१७", "content_sanskrit": "गजः कुवलयापीडो महामात्रप्रचोदितः ।\nस वा हनिष्यते पापौ वसुदेवात्मजौ शिशू ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001033017, "chapter_id": 21033, "verse_number": "५-१५-१८", "content_sanskrit": "तौ हत्वा वसुदेवं च नंदगोपं च दुर्मतिम् ।\nहनिष्ये पितरं चैनमुग्रसेनं सुदुर्मतिम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001033018, "chapter_id": 21033, "verse_number": "५-१५-१९", "content_sanskrit": "ततस्समस्तगोपानां गोधनान्यखिलान्यहम् ।\nवित्तं चापहरिष्यामि दुष्टानां मद्वधैषिणाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001033019, "chapter_id": 21033, "verse_number": "५-१५-२०", "content_sanskrit": "त्वामृते यादवाश्चैते द्विषो दानपते मम ।\nएतेषां च वधायाहं यतिष्येऽनुक्रमात्ततः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001033020, "chapter_id": 21033, "verse_number": "५-१५-२१", "content_sanskrit": "तदा निष्कंटकं सर्वं राज्यमेतदयादवम् ।\nप्रसाधिष्ये त्वया तस्मान्मत्प्रीत्यै वीर गम्यताम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001033021, "chapter_id": 21033, "verse_number": "५-१५-२२", "content_sanskrit": "यथा च माहिषं सर्पिर्दधिचाप्युपहार्य वै ।\nगोपास्समानयंत्वाशु तथा वाच्यास्त्वया च ते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001033022, "chapter_id": 21033, "verse_number": "५-१५-२३", "content_sanskrit": "श्रीपराशर उवाच।\nइत्याज्ञप्तस्तदाऽक्रूरो महाभागवतो द्विज ।\nप्रीतिमानभवत्कृष्णं श्वो द्रक्ष्यामीति सत्वरः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001033023, "chapter_id": 21033, "verse_number": "५-१५-२४", "content_sanskrit": "तथेत्युक्त्वा च राजानं रथमारुह्य शोभनम् ।\nनिश्चक्राम ततः पुर्य्या मथुराया मधुप्रियः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]