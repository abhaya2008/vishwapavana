[{"id": 2033302, "chapter_id": 1717, "verse_number": "४-४०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2033303, "chapter_id": 1717, "verse_number": "४-४०-१", "content_sanskrit": "तं दृष्ट्वा क्लीबरूपेण रथस्थं रथिपुङ्गवम्।\nशमीमभिमुखं यान्तं रथमारोप्य चोत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2033304, "chapter_id": 1717, "verse_number": "४-४०-२", "content_sanskrit": "द्रोणभीष्मादयः शूराः कुरूणां रथिसत्तमाः ।\nवित्रस्तमनसश्चासन्धनञ्जयकृताद्भयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2033305, "chapter_id": 1717, "verse_number": "४-४०-३", "content_sanskrit": "तानवेक्ष्य हतोत्साहानुत्पातानपि चाद्भुतान्।\nगुरुः शस्त्रभृतांश्रेष्ठो भारद्वाजोऽभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2033306, "chapter_id": 1717, "verse_number": "४-४०-४", "content_sanskrit": "स्वराश्च वाताः संयान्ति रूक्षाः परुषनिस्वनाः ।\nभस्मवर्षप्रकाशेन तमसा संवृतं नभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2033307, "chapter_id": 1717, "verse_number": "४-४०-५", "content_sanskrit": "रूक्षवर्णाश्च जलदा दृश्यन्तेऽद्भुतदर्शनाः ।\nनिःसरन्ति च कोशेभ्यः शस्त्राणि विविधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2033308, "chapter_id": 1717, "verse_number": "४-४०-६", "content_sanskrit": "शिवाश्च विनदन्त्येता दीप्तायां दिशि दारुणाः ।\nहयाश्चाश्रूणि मुञ्चन्ति ध्वजाः कम्पन्त्यकम्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2033309, "chapter_id": 1717, "verse_number": "४-४०-७", "content_sanskrit": "यादृशान्यत्र दृश्यन्ते रूपाणि विविधानि च।\nयत्ता भवन्तस्तिष्ठन्तु युद्धं स्यात्समुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2033310, "chapter_id": 1717, "verse_number": "४-४०-८", "content_sanskrit": "रक्षध्वमपि राजानं व्यूहध्वं वाहिनीमपि ।\nवैशसं च प्रतीक्षध्वं रक्षध्वं चापि गोधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2033311, "chapter_id": 1717, "verse_number": "४-४०-९", "content_sanskrit": "एष वीरो महेष्वासः सर्वशस्त्रभृतांवरः।\nआगतः क्लीबवेषेण पार्थो नास्त्यत्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2033312, "chapter_id": 1717, "verse_number": "४-४०-१०", "content_sanskrit": "एतावदुक्त्वा वचनं भीष्ममालोक्य चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2033313, "chapter_id": 1717, "verse_number": "४-४०-११", "content_sanskrit": "नदीज लङ्केशवनारिकेतुर्नगाह्वयो नाम नगारिसूनुः ।\nगत्या सुरेशः क्वचिदङ्गनेव गुरुर्बभाषे वचनं तदानीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2033314, "chapter_id": 1717, "verse_number": "४-४०-१२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2033315, "chapter_id": 1717, "verse_number": "४-४०-१२", "content_sanskrit": "इत्युक्त्वा संज्ञया द्रोणस्तूष्णीमासीद्विशांपते।\nभारद्वाजवचः श्रुत्वा गाङ्गेयः संज्ञयाऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2033316, "chapter_id": 1717, "verse_number": "४-४०-१३", "content_sanskrit": "अतीतं चक्रमस्माकं विषयान्तरमागताः ।\nअतीतः समयश्चोक्त अस्माभिर्यः सभातले।\nन भयं शत्रुतः कार्यं शङ्कां त्यज नरर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2033317, "chapter_id": 1717, "verse_number": "४-४०-१४", "content_sanskrit": "देवव्रतेनैवमुक्ते वचने हितकारिणा ।\nदुर्योधनमथालोक्य संज्ञया द्रोण अब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2033318, "chapter_id": 1717, "verse_number": "४-४०-१५", "content_sanskrit": "एष वीरो महेष्वासः सर्वशस्त्रभृतांवरः ।\nआगतः क्लीबरूपेण पार्थो नास्त्यत्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2033319, "chapter_id": 1717, "verse_number": "४-४०-१६", "content_sanskrit": "एष पार्थो हि विक्रान्तः सव्यसाची परन्तपः।\nये जेतारो महीपानाममुना कुरवो हताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2033320, "chapter_id": 1717, "verse_number": "४-४०-१७", "content_sanskrit": "यस्मिञ्जाते मही कृत्स्ना निर्भरोच्छ्वासिताऽभवत्।\nयेन मे दक्षिणा दत्ता बद्ध्वा द्रुपदमोजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2033321, "chapter_id": 1717, "verse_number": "४-४०-१८", "content_sanskrit": "विद्ध्वा वियद्गतं लक्ष्यं विनिर्जित्य च पार्थिवान् ।\nनिर्जिता येन पाञ्चाली पुरा येन स्वयंवरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2033322, "chapter_id": 1717, "verse_number": "४-४०-१९", "content_sanskrit": "खाण्डवे येन संतृप्तो वह्निर्जित्वा सुरासुरान् ।\nपरिणीता सुभद्रा च येन निर्जित्य यादवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2033323, "chapter_id": 1717, "verse_number": "४-४०-२०", "content_sanskrit": "निर्जितो येन युद्धेन त्रिपुरारिः स्मरार्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2033324, "chapter_id": 1717, "verse_number": "४-४०-२१", "content_sanskrit": "गत्वा त्रिविष्टपं येन जितेन्द्रा दानवा युधि ।\nनिवातकवचा राजन्दानवानां त्रिकोटयः।\nनिर्जिताः कालकेयाश्च हिरण्यपुरवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2033325, "chapter_id": 1717, "verse_number": "४-४०-२२", "content_sanskrit": "येन त्वं मोचितो बद्धश्चित्रसेनेन तद्वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2033326, "chapter_id": 1717, "verse_number": "४-४०-२३", "content_sanskrit": "येन गत्वोत्तरं मेरोरानिनाय महद्धनम् ।\nयाजितो धर्मसूनुश्च नृपान्सर्वान्विजित्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2033327, "chapter_id": 1717, "verse_number": "४-४०-२४", "content_sanskrit": "यस्मिञ्शौर्यं च वीर्यं च तेजो धैर्यं पराक्रमः ।\nऔदार्यं चैव गाम्भीर्यं श्रीर्ह्रीर्धर्मो दयाऽऽर्जवम् ।\nएवमादिगुणोपेतः सोयं पार्थो न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2033328, "chapter_id": 1717, "verse_number": "४-४०-२५", "content_sanskrit": "नाजित्वा विनिवर्तेत सर्वानपि मरुद्गणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2033329, "chapter_id": 1717, "verse_number": "४-४०-२६", "content_sanskrit": "क्लेशितश्च वने शूरो वासवेन च शिक्षितः।\nअमर्षवशमापन्नो योत्स्यते नात्र संशयः ।\nन ह्यस्य प्रतियोद्धारमन्यं पश्यामि कौरव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2033330, "chapter_id": 1717, "verse_number": "४-४०-२७", "content_sanskrit": "महादेवोपि पार्थेन श्रूयते युद्धतोषितः ।\nकिरातवेषप्रच्छन्नो गिरौ हिमवति प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2033331, "chapter_id": 1717, "verse_number": "४-४०-२८", "content_sanskrit": "इत्येवंवादिनं द्रोणं कर्णः क्रुद्धोऽभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2033332, "chapter_id": 1717, "verse_number": "४-४०-२९", "content_sanskrit": "सदा भवान्फल्गुनस्य गुणानस्मासु कत्थसे।\nन चार्जुनः कलापूर्णो मम दुर्योधनस्य वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2033333, "chapter_id": 1717, "verse_number": "४-४०-३०x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2033334, "chapter_id": 1717, "verse_number": "४-४०-३०", "content_sanskrit": "यद्येष पार्थो राधेय कृतं कार्यं भवेन्मम ।\nज्ञाताः पुनश्चरिष्यन्ति द्वादशान्यांश्च वत्सरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2033335, "chapter_id": 1717, "verse_number": "४-४०-३१", "content_sanskrit": "अथवा कश्चिदेवान्यः क्लीबरूपेण देवराट् ।\nशरैरेनं सुनिशितैः पातयिष्यामि भूतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2033336, "chapter_id": 1717, "verse_number": "४-४०-३२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2033337, "chapter_id": 1717, "verse_number": "४-४०-३२", "content_sanskrit": "तस्मिन्वदति तां वाचं धार्तराष्ट्रे परन्तपे।\nभीष्मो द्रोणः कृपो द्रौणिः पौरुषं तदपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2033338, "chapter_id": 1717, "verse_number": "४-४०-३३", "content_sanskrit": "तां शमीमभिसंगम्य पार्थो वैराटिमब्रवीत्।\nसुखसंवर्धितं पित्रा समराणामकोविदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2033339, "chapter_id": 1717, "verse_number": "४-४०-३४", "content_sanskrit": "एहि भूमिंजयारुह्य वैराटे महतीं शमीम्।\nसमादिष्टो मया क्षिप्रं धनुर्गाण्डीवमानय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2033340, "chapter_id": 1717, "verse_number": "४-४०-३५", "content_sanskrit": "नेमानीष्वासनानीह सोढुं शक्ष्यन्ति मे बलम् ।\nनालं भारं गुरुं भेत्तुं कुञ्जरं वा प्रमर्दितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2033341, "chapter_id": 1717, "verse_number": "४-४०-३६", "content_sanskrit": "मम वा बाहुविक्षेपं शत्रूनिह विजेष्यतः।\nनेच्छामि तैरहं कर्तुं कर्म वैजयिकं त्विह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2033342, "chapter_id": 1717, "verse_number": "४-४०-३७", "content_sanskrit": "अतिसूक्ष्माणि ह्रस्वानि सर्वाणि च मृदूनि च।\nआयुधानि महाबाहो तवैतानि महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2033343, "chapter_id": 1717, "verse_number": "४-४०-३८", "content_sanskrit": "तस्माद्भूमिंजयारुह्य शमीमेतां पलाशिनीम् ।\nअस्यां हि पाण्डुपुत्राणां धनूंषि निहितात्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2033344, "chapter_id": 1717, "verse_number": "४-४०-३९", "content_sanskrit": "युधिष्ठिरस्य भीमस्य बीभत्सोर्यमयोस्तथा ।\nध्वजा शराश्च शूराणां दिव्यानि कवचानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2033345, "chapter_id": 1717, "verse_number": "४-४०-४०", "content_sanskrit": "अत्रैव तु महावीर्यं धनुः पार्थस्य गाण्डिवम् ।\nएकं शतसहस्रेण संमितं राष्ट्रवर्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2033346, "chapter_id": 1717, "verse_number": "४-४०-४१", "content_sanskrit": "व्यायामसहमत्यर्थं तृणराजसमं महत् ।\nसर्वायुधमहामात्रं सर्वारिक्षयकारकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2033347, "chapter_id": 1717, "verse_number": "४-४०-४२", "content_sanskrit": "सुवर्णविकृतं दिव्यं श्लक्ष्णमायतमव्रणम्।\nअलं भारं गुरुं सोढुं वारुणं च सुदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2033348, "chapter_id": 1717, "verse_number": "४-४०-४३", "content_sanskrit": "तादृशान्येव सर्वाणि बलवन्ति दृढानि च।\nयुधिष्ठिरस्य भीमस्य बीभत्सोर्यमयोस्तथा ।\nप्रथितानि विशिष्टानि दुर्दशानि भवन्त्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2033349, "chapter_id": 1717, "verse_number": "४-४०-४४x", "content_sanskrit": "उत्तर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2033350, "chapter_id": 1717, "verse_number": "४-४०-४४", "content_sanskrit": "शरीरमिह चासक्तं शम्यां शुष्कं पुरा किल।\nतदहं राजपुत्रः सन्स्पृशेयं पाणिना कथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2033351, "chapter_id": 1717, "verse_number": "४-४०-४५", "content_sanskrit": "न मामेवंविधं कर्म कारयस्व बृहन्नले ।\nकथं वा शक्यते कर्तुं बुद्ध्या त्वं मन्यसे कथं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2033352, "chapter_id": 1717, "verse_number": "४-४०-४६", "content_sanskrit": "नैवंविधं मया युक्तमालब्धुं क्षत्रयोनिना ।\nमहता राजपुत्रेण मन्त्रयज्ञविदा सता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2033353, "chapter_id": 1717, "verse_number": "४-४०-४७", "content_sanskrit": "स्पृष्टवन्तं शरीरं मां शववाहमिवाशुचिम्।\nकथं वा व्यवहार्यं वै कुर्वीथास्त्वं बृहन्नले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2033354, "chapter_id": 1717, "verse_number": "४-४०-४८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2033355, "chapter_id": 1717, "verse_number": "४-४०-४८", "content_sanskrit": "तमुवाच ततः शूरः पार्थं परपुंरजयः।\nदायादं सर्वमत्स्यानां कुले जातं विशारदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2033356, "chapter_id": 1717, "verse_number": "४-४०-४९", "content_sanskrit": "जानामि त्वां महाप्राज्ञ शुभं जात्या कुलेन च ।\nकथं नु पापकं कर्म ब्रूयां त्वाऽहं परन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2033357, "chapter_id": 1717, "verse_number": "४-४०-५०", "content_sanskrit": "व्यवहार्यश्च राजेन्द्र शुद्धश्चैव भविष्यसि ।\nधनूंष्येतानि मा भैस्त्वं शरीरं नात्र विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2033358, "chapter_id": 1717, "verse_number": "४-४०-५१", "content_sanskrit": "दायादं मत्स्यराजस्य कुले जातं मनस्विनम् ।\nकथं वा नन्दितं कर्म कारये त्वां नृपात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2033359, "chapter_id": 1717, "verse_number": "४-४०-५२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2033360, "chapter_id": 1717, "verse_number": "४-४०-५२", "content_sanskrit": "एवमुक्तः स पार्थेन रथात्प्रस्कन्द्य कुण्डली।\nआरुरोह शमीवृक्षं वैराटिरवशस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2033361, "chapter_id": 1717, "verse_number": "४-४०-५३", "content_sanskrit": "तमन्वशासच्छत्रुघ्नो रथे तिष्ठन्धनञ्जयः ।\nअवरोपय वृक्षाग्राद्धनूंष्येतानि माचिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2033362, "chapter_id": 1717, "verse_number": "४-४०-५४", "content_sanskrit": "सोपहृत्य महार्हाणि धनूंषि पृथुवक्षसाम् ।\nपरिवेष्टनपत्राणि विमुच्य समुपानयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2033363, "chapter_id": 1717, "verse_number": "४-४०-५५", "content_sanskrit": "परिवेष्टनमेतेषां सर्वं मुञ्चस्व माचिरम् ।\nतेषां संनहनीयानि परिमुच्य परन्तपः।\nअपश्यत्तत्र गाण्डीवं चतुर्भिरपरैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2033364, "chapter_id": 1717, "verse_number": "४-४०-५६", "content_sanskrit": "तेषां विमुच्यमानानां धनुषामर्कवर्चसाम्।\nविनिश्चेरुः प्रभा दिव्या ग्रहाणामुदयेष्विव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2033365, "chapter_id": 1717, "verse_number": "४-४०-५७", "content_sanskrit": "स तेषां रूपमालेक्य भोगिनामिव दृम्भताम् ।\nहृष्टरोमा भयोद्विग्रः प्रवेपिततनुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2033366, "chapter_id": 1717, "verse_number": "४-४०-५८", "content_sanskrit": "अर्जुनेन समाश्वस्तः किंचिद्धृष्टो नृपात्मजः।\nतेषां संदर्शनाभ्यासं स्पर्शाभ्यासं पुनः पुनः ॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2033367, "chapter_id": 1717, "verse_number": "४-४०-५९", "content_sanskrit": "आमील्य पुनरुन्मील्य स्पृष्ट्वास्पृष्ट्वा चकार सः।\nसम्यग्घुण्टस्तदाऽऽश्वस्तः क्षणेन समपद्यत ॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2033368, "chapter_id": 1717, "verse_number": "४-४०-६०", "content_sanskrit": "संस्पृश्य तानि चापानि भानुमन्ति बृहन्ति च।\nवैराटिरर्जुनं राजन्निदं वचनमब्रवीत् ॥ ६० ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2033369, "chapter_id": 1717, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि चत्वारिंशोऽध्यायः ॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]