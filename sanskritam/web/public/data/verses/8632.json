[{"id": 900008413, "chapter_id": 8632, "verse_number": "13.1", "content_sanskrit": "यैर्लिंगैः साधितः पूर्वं नाम्नां विष्णौ समन्वयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008414, "chapter_id": 8632, "verse_number": "13.2", "content_sanskrit": "अत्र ‘‘सर्वेषु भूतेष्वेत’’मित्युक्तं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008415, "chapter_id": 8632, "verse_number": "13.3", "content_sanskrit": "एतेन ‘‘सूर्यआत्मे’’ति सौरमन्त्रोदाहरणात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008416, "chapter_id": 8632, "verse_number": "13.4", "content_sanskrit": "मैवम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008417, "chapter_id": 8632, "verse_number": "13.5", "content_sanskrit": "अत एवात्र टीकादौ आदित्यशब्दस्य न विष्णुपरता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008418, "chapter_id": 8632, "verse_number": "13.6", "content_sanskrit": "नचैवं यत्सम्बन्धात्सर्वगतत्वस्यान्यत्र प्रसिद्धता..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008419, "chapter_id": 8632, "verse_number": "13.7", "content_sanskrit": "चक्षुश्शब्दस्य विष्णुपरत्वे च मयटो वैयर्थ्यम् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008420, "chapter_id": 8632, "verse_number": "13.8", "content_sanskrit": "सिद्धान्तस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008421, "chapter_id": 8632, "verse_number": "13.9", "content_sanskrit": "श्रुतौ भूतपदस्य च तत्रोपासनार्थत्वात्सर्वपदेन ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008422, "chapter_id": 8632, "verse_number": "13.10", "content_sanskrit": "सूत्रक्रमस्तु आद्ये सूत्रे विषयवाक्यस्थश्रुतिरूपस्वपक्षसाधकोक्तिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008423, "chapter_id": 8632, "verse_number": "13.11", "content_sanskrit": "अन्ये तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900008424, "chapter_id": 8632, "verse_number": "13.12", "content_sanskrit": "यद्यप्यारोप्यस्यासाधारणरूपेण ज्ञानदशायामधिष्ठानमस्ति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900008425, "chapter_id": 8632, "verse_number": "13.13", "content_sanskrit": "सूत्राक्षरार्थोऽप्ययुक्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900008426, "chapter_id": 8632, "verse_number": "13.14", "content_sanskrit": "केचित्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900008427, "chapter_id": 8632, "verse_number": "13.15", "content_sanskrit": "टीकाक्षरार्थस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]