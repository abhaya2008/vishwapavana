[{"id": 40004814, "chapter_id": 8926, "verse_number": "1", "content_sanskrit": "आक्रन्दितनिरानन्दा सास्रकण्ठजनाकुला। अयोध्यायामवतता सा व्यतीयाय शर्वरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40004815, "chapter_id": 8926, "verse_number": "2", "content_sanskrit": "व्यतीतायां तु शर्वर्यामादित्यस्योदये ततः। समेत्य राजकर्तारः सभामीयुर्द्विजातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40004816, "chapter_id": 8926, "verse_number": "3", "content_sanskrit": "मार्कण्डेयोऽथ मौद्गल्यो वामदेवश्च काश्यपः। कात्यायनो गौतमश्च जाबालिश्च महायशाः ॥ एते द्विजा स्सहामात्यैः पृथग्वा च मुदीरयन्। वसिष्ठमेवाभिमुखाः श्रेष्ठं राजपुरोहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40004817, "chapter_id": 8926, "verse_number": "4", "content_sanskrit": "मार्कण्डेयोऽथ मौद्गल्यो वामदेवश्च काश्यपः। कात्यायनो गौतमश्च जाबालिश्च महायशाः ॥ एते द्विजा स्सहामात्यैः पृथग्वा च मुदीरयन्। वसिष्ठमेवाभिमुखाः श्रेष्ठं राजपुरोहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40004818, "chapter_id": 8926, "verse_number": "5", "content_sanskrit": "अतीता शर्वरी दुःखं या नो वर्षशतोपमा। अस्मिन्पञ्चत्वमापन्ने पुत्रशोकेन पार्थिवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40004819, "chapter_id": 8926, "verse_number": "6", "content_sanskrit": "स्वर्गतश्च महाराजो रामश्चारण्यमाश्रितः। लक्ष्मणश्चापि तेजस्वी रामेणैव गतस्सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40004820, "chapter_id": 8926, "verse_number": "7", "content_sanskrit": "उभौ भरतशत्रुघ्नौ केकयेषु परन्तपौ। पुरे राजगृहे रम्ये मातामहनिवेशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40004821, "chapter_id": 8926, "verse_number": "8", "content_sanskrit": "इक्ष्वाकूणामिहाद्यैव कश्चिद्राजा विधीयताम्। अराजकं हि नो राष्ट्रं विनाशं समवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40004822, "chapter_id": 8926, "verse_number": "9", "content_sanskrit": "नाराजके जनपदे विद्युन्माली महास्वनः। अभिवर्षति पर्जन्यो महीं दिव्येन वारिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40004823, "chapter_id": 8926, "verse_number": "10", "content_sanskrit": "नाराजके जनपदे बीजमुष्टिः प्रकीर्यते। नाराजके पितुः पुत्रो भार्या वा वर्तते वशे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40004824, "chapter_id": 8926, "verse_number": "11", "content_sanskrit": "नाराजके धनं चास्ति नास्ति भार्या प्यराजके। इद मत्याहितं चान्यत्कुतस्सत्य मराजके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40004825, "chapter_id": 8926, "verse_number": "12", "content_sanskrit": "नाराजके जनपदे कारयन्ति सभां नराः। उद्यानानि च रम्याणि हृष्टाः पुण्यगृहाणि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40004826, "chapter_id": 8926, "verse_number": "13", "content_sanskrit": "नाराजके जनपदे यज्ञशीला द्विजातयः। सत्राण्यन्वासते दान्ता ब्राह्मणा स्संशितव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40004827, "chapter_id": 8926, "verse_number": "14", "content_sanskrit": "नाराजके जनपदे महायज्ञेषु यज्वनः। ब्राह्मणा वसुसम्पन्ना विसृजन्त्याप्तदक्षिणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40004828, "chapter_id": 8926, "verse_number": "15", "content_sanskrit": "नाराजके जनपदे प्रभूतनटनर्तकाः। उत्सवाश्च समाजाश्च वर्धन्ते राष्ट्रवर्धनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40004829, "chapter_id": 8926, "verse_number": "16", "content_sanskrit": "नाराजके जनपदे सिद्धार्था व्यवहारिणः। कथाभिरनुरज्यन्ते कथाशीलाः कथाप्रियैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40004830, "chapter_id": 8926, "verse_number": "17", "content_sanskrit": "नाराजके जनपदे उद्यानानि समागताः। सायाह्ने क्रीडितुं यान्ति कुमार्यो हेमभूषिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40004831, "chapter_id": 8926, "verse_number": "18", "content_sanskrit": "नाराजके जनपदे वाहनै शशीघ्रगामिभिः। नरा निर्यान्त्यरण्यानि नारीभिस्सह कामिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40004832, "chapter_id": 8926, "verse_number": "19", "content_sanskrit": "नाराजके जनपदे धनवन्तस्सुरक्षिताः। शेरते विवृतद्वाराः कृषिगोरक्षजीविनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40004833, "chapter_id": 8926, "verse_number": "20", "content_sanskrit": "नाराजके जनपदे बद्धघण्टाविषाणिनः। अटन्ति राजमार्गेषु कुञ्जरा षष्टिहायनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40004834, "chapter_id": 8926, "verse_number": "21", "content_sanskrit": "नाराजके जनपदे शरान्सन्ततमस्यताम्। श्रूयते तलनिर्घोष इष्वस्त्राणामुपासने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40004835, "chapter_id": 8926, "verse_number": "22", "content_sanskrit": "नाराजके जनपदे वणिजो दूरगामिनः। गच्छन्ति क्षेममध्वानं बहुपण्यसमाचिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40004836, "chapter_id": 8926, "verse_number": "23", "content_sanskrit": "नाराजके जनपदे चरत्येकचरो वशी। भावयन्नात्मनाऽत्मानं यत्र सायंगृहो मुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40004837, "chapter_id": 8926, "verse_number": "24", "content_sanskrit": "नाराजके जनपदे योगक्षेमं प्रवर्तते। नचाप्यराजके सेना शत्रून्विषहते युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40004838, "chapter_id": 8926, "verse_number": "25", "content_sanskrit": "नाराजके जनपदे हृष्टैः परमवाजिभिः। नरास्संयान्ति सहसा रथैश्च परिमण्डिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40004839, "chapter_id": 8926, "verse_number": "26", "content_sanskrit": "नाराजके जनपदे नराश्शास्त्रविशारदाः। संवदन्तोऽवतिष्ठन्ते वनेषूपवनेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40004840, "chapter_id": 8926, "verse_number": "27", "content_sanskrit": "नाराजके जनपदे माल्यमोदकदक्षिणाः। देवताभ्यर्चनार्थाय कल्प्यन्ते नियतैर्जनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40004841, "chapter_id": 8926, "verse_number": "28", "content_sanskrit": "नाराजके जनपदे चन्दनागरुरूषिताः। राजपुत्रा विराजन्ते वसन्त इव शाखिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40004842, "chapter_id": 8926, "verse_number": "29", "content_sanskrit": "यथा ह्यनुदका नद्यः यथा वाऽप्यतृणं वनम्। अगोपाला यथा गावस्तथा राष्ट्रमराजकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40004843, "chapter_id": 8926, "verse_number": "30", "content_sanskrit": "ध्वजो रथस्य प्रज्ञानं धूमो ज्ञानं विभावसोः। तेषां यो नो ध्वजो राजा स देवत्वमितो गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40004844, "chapter_id": 8926, "verse_number": "31", "content_sanskrit": "नाराजके जनपदे स्वकं भवति कस्यचित्। मत्स्या इव नरा नित्यं भक्षयन्ति परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40004845, "chapter_id": 8926, "verse_number": "32", "content_sanskrit": "ये हि सम्भिन्नमर्यादा नास्तिकाश्छिन्नसंशयाः। तेऽपि भावाय कल्पन्ते राजदण्डनिपीडिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40004846, "chapter_id": 8926, "verse_number": "33", "content_sanskrit": "यथा दृष्टि श्शरीरस्य नित्यमेव प्रवर्तते। तथा नरेन्द्रो राष्ट्रस्य प्रभवस्सत्यधर्मयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40004847, "chapter_id": 8926, "verse_number": "34", "content_sanskrit": "राजा सत्यं च धर्मश्च राजा कुलवतां कुलम्। राजा माता पिता चैव राजा हितकरो नृणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40004848, "chapter_id": 8926, "verse_number": "35", "content_sanskrit": "यमो वैश्रवण श्शक्रः वरुणश्च महाबलः। विशेष्यन्ते नरेन्द्रेण वृत्तेन महता ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40004849, "chapter_id": 8926, "verse_number": "36", "content_sanskrit": "अहो तम इवेदं स्यान्नप्रज्ञायेत किञ्चन। राजा चे न्न भवे ल्लोके विभज साध्वसाधुनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40004850, "chapter_id": 8926, "verse_number": "37", "content_sanskrit": "जीवत्यपि महाराजे तवैव वचनं वयम्। नातिक्रमामहे सर्वे वेलां प्राप्येव सागरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40004851, "chapter_id": 8926, "verse_number": "38", "content_sanskrit": "स न स्समीक्ष्य द्विजवर्य वृत्तं नृपं विना राज्यमरण्यभूतम्। कुमारमिक्ष्वाकुसुतं वदान्यं त्वमेव राजानमिहाभिषिञ्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]