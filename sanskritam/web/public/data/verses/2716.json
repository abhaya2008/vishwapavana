[{"id": 2080687, "chapter_id": 2716, "verse_number": "१२-२२१-०x", "content_sanskrit": "`*भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2080688, "chapter_id": 2716, "verse_number": "१२-२२१-१", "content_sanskrit": "जनको नरदेवस्तु ज्ञापितः परमर्षिणा।\nपुनरेवानुपप्रच्छ सांपराये भवाभवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2080689, "chapter_id": 2716, "verse_number": "१२-२२१-२", "content_sanskrit": "भगवन्यदिदं प्रेत्य संज्ञा भवति कस्यचित्।\nएवं सति किमज्ञानं ज्ञानं वा किं करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2080690, "chapter_id": 2716, "verse_number": "१२-२२१-३", "content_sanskrit": "विवादादेव सिद्धोऽसौ कारणस्येव वेदना।\nचेतनो विद्यते ह्यत्र हैतुकं च मनोगतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2080691, "chapter_id": 2716, "verse_number": "१२-२२१-४", "content_sanskrit": "आगमादेव सिद्धोऽसौ स्वताः सिद्धा इति श्रुतिः।\nवर्तते पृथगन्योन्यं न ह्यपःश्रित्य कर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2080692, "chapter_id": 2716, "verse_number": "१२-२२१-५", "content_sanskrit": "चेतनो ह्यंशवस्तत्र स्वमूर्तं धारयन्त्यतः।\nस्वभावं पौरुषं कर्म ह्यात्मानं तमुपाश्रितम्।\nतमाश्रित्य प्रवर्तन्ते देहिनो देहबन्धनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2080693, "chapter_id": 2716, "verse_number": "१२-२२१-६", "content_sanskrit": "गुणज्ञानमभिज्ञानं तस्य लिङ्गानुशब्दयत्।\nपृथिव्यादिषु भूतेषु तत्तदाहुर्निदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2080694, "chapter_id": 2716, "verse_number": "१२-२२१-७", "content_sanskrit": "आत्माऽसौ वर्तते भिन्नस्तत्रतत्र समन्वितः।\nपरमात्मा तथीवैको देवेऽस्मिन्निति वै श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2080695, "chapter_id": 2716, "verse_number": "१२-२२१-८", "content_sanskrit": "आकाशं वायुरूष्भा च स्नेहो यच्चापि पार्थिवम्।\nयथा त्रिधा प्रवर्तन्ते तथाऽसौ पुरुषः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2080696, "chapter_id": 2716, "verse_number": "१२-२२१-९", "content_sanskrit": "पपस्यन्तर्हितं यद्वत्तद्वद्व्याप्तं महात्मकम्।\nपूर्वं नैश्चर्ययोगेन तस्मादेतन्न शेपवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2080697, "chapter_id": 2716, "verse_number": "१२-२२१-१०", "content_sanskrit": "शब्दाः कालः क्रिया देहो ममैकस्वैव कल्पना।\nस्वभावं तन्मयं त्वेदं मायारूपं तु भेदवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2080698, "chapter_id": 2716, "verse_number": "१२-२२१-११", "content_sanskrit": "नानाख्यं परं शुद्धं निर्विकल्पं परात्मकम्।\nलिङ्गादि देवमध्यास्ते ज्ञानं देवस्य तत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2080699, "chapter_id": 2716, "verse_number": "१२-२२१-१२", "content_sanskrit": "चिन्मयोऽयं हि नादाख्यः शब्दश्चासौ मनो महान्।\nगतिमानुत संधत्ते वर्णमत्तत्पदान्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2080700, "chapter_id": 2716, "verse_number": "१२-२२१-१३", "content_sanskrit": "कायो नास्ति च तेषां वै अवकाशस्तथा परम्।\nएतेनोढा इति चाख्याताः सर्वे ते धर्मदूषकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2080701, "chapter_id": 2716, "verse_number": "१२-२२१-१४", "content_sanskrit": "अवन्धनमविज्ञानाज्ज्ञानं तद्भुवमव्ययम्।\nनानाभेदविकल्पने येषामात्मा स्मृतः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2080702, "chapter_id": 2716, "verse_number": "१२-२२१-१५", "content_sanskrit": "प्रकृतेरपरस्तेषां बहवोऽप्यात्मवादिनः।\nविरोधो ह्यात्मसन्मायां न तेषां सिद्ध एव हि।\nअन्यदा च गृहीतै-----वेदबाह्यास्ततः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2080703, "chapter_id": 2716, "verse_number": "१२-२२१-१६", "content_sanskrit": "एकानेकात्मकं तेषां प्रतिषेधो हि भेदनुत्।\nतस्माद्वेदस्य हृदयमद्वैध्यमिति विद्धि तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2080704, "chapter_id": 2716, "verse_number": "१२-२२१-१७", "content_sanskrit": "वेदादृष्टेरयं लोकः सर्वार्थेषु प्रवर्तते।\nतस्माच्च स्मृतयो जाताः सेतिहासाः पृथग्विधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2080705, "chapter_id": 2716, "verse_number": "१२-२२१-१८", "content_sanskrit": "न यन्न साध्यं तद्ब्रह्म नादिमध्यं न चान्तवत्।\nइन्द्रियाणि च भूरीणि परा च प्रकृतिर्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2080706, "chapter_id": 2716, "verse_number": "१२-२२१-१९", "content_sanskrit": "आत्मा च परमः शुद्धः प्रोक्तोऽसौ परमः पुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2080707, "chapter_id": 2716, "verse_number": "१२-२२१-२०", "content_sanskrit": "उत्पत्तिलक्षणं चेदं विपरीतमथोभयोः।\nयो वेत्ति प्रकृतिं नित्यं तथा चैवात्मनस्तु ताम्।\nप्रदहत्येष कर्माख्यं दावोद्भूत इवानलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2080708, "chapter_id": 2716, "verse_number": "१२-२२१-२१", "content_sanskrit": "चिन्मात्रपरमः शुद्धः सर्वाकृतिषु वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2080709, "chapter_id": 2716, "verse_number": "१२-२२१-२२", "content_sanskrit": "आकाशकल्पं विमलं नानाशक्तिसमन्वितम्।\nतापनं सर्वभूतानां ज्योतिषां मध्यमस्थितिम्।\nदुःखमस्ति न निर्दुःखं तद्विद्वान्न च लिप्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2080710, "chapter_id": 2716, "verse_number": "१२-२२१-२३", "content_sanskrit": "असावश्नाति यद्वत्तद्वमरोऽश्नाति यन्मधु।\nएवमेव महानात्मा नात्मानमवबुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2080711, "chapter_id": 2716, "verse_number": "१२-२२१-२४", "content_sanskrit": "एवंभूतस्त्वमित्यत्र स्वाधितो बुद्ध्यते परम।\nबुधस्य बोधनं तत्र क्रियते सद्भिरित्युत।\nन बुधस्येति वै कश्चिन्न तथावच्छृणुष्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2080712, "chapter_id": 2716, "verse_number": "१२-२२१-२५", "content_sanskrit": "शोकमस्य न गत्वा ते शास्त्राणां शास्त्रदस्यवः।\nलोकं निध्नन्ति संभिन्ना ज्ञातिनोत्र वदन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2080713, "chapter_id": 2716, "verse_number": "१२-२२१-२६", "content_sanskrit": "एवं तस्य विभोः कृत्यं धातुरस्य महात्मनः।\nक्षमन्ति ते महात्मानः सर्वद्वन्द्वविवर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2080714, "chapter_id": 2716, "verse_number": "१२-२२१-२७", "content_sanskrit": "अतोऽन्यथा महात्मानमन्यथा प्रतिपद्यते।\nकिं तेन न कृतं पापं चोरेणात्मापहारिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2080715, "chapter_id": 2716, "verse_number": "१२-२२१-२८", "content_sanskrit": "तस्य संयोगयोगेन शुचिरप्यशुचिर्भवेत्।\nअशुचिश्च शुचिश्चापि ज्ञानाद्देहादयो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2080716, "chapter_id": 2716, "verse_number": "१२-२२१-२९", "content_sanskrit": "दृश्यं न चैव दृष्टं स्याद्दृष्टं दृश्यं तु नैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2080717, "chapter_id": 2716, "verse_number": "१२-२२१-३०", "content_sanskrit": "अतीतत्रितयाः सिद्धा ज्ञानरूपेण सर्वदा।\nएवं न प्रतिपद्यन्ते रागमोहमदान्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2080718, "chapter_id": 2716, "verse_number": "१२-२२१-३१", "content_sanskrit": "वेदबाह्या दुरात्मानः संसारे दुःखभागिनः।\nआगमानुगतज्ञाना बुद्धियुक्ता भवन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2080719, "chapter_id": 2716, "verse_number": "१२-२२१-३२", "content_sanskrit": "बुद्ध्या भवति बुद्ध्या त्वं यद्बुद्धं चात्मरूपवत्।\nतमस्यन्धे न संदेहात्परं यान्ति न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2080720, "chapter_id": 2716, "verse_number": "१२-२२१-३३", "content_sanskrit": "नित्यनैमित्तिकान्कृत्वा पापहानिमवाप्य च।\nशुद्धसत्वा महात्मानो ज्ञाननिर्धूतकल्मषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2080721, "chapter_id": 2716, "verse_number": "१२-२२१-३४", "content_sanskrit": "असक्ताः परिवर्तन्ते संसरन्त्यथ वायुवत्।\nन युज्यन्तेऽथवा क्लेशैरहंभावोद्भवैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2080722, "chapter_id": 2716, "verse_number": "१२-२२१-३५", "content_sanskrit": "इतस्ततः समाहृत्य ज्ञानं निर्वर्णयन्त्युत।\nज्ञानान्वितस्तमो हन्यादर्कवत्स महामतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2080723, "chapter_id": 2716, "verse_number": "१२-२२१-३६", "content_sanskrit": "एवमात्मानमन्वीक्ष्य नानादुःखसमन्वितम्।\nदेहं पङ्कमले मग्नं निर्मलं परमार्थतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2080724, "chapter_id": 2716, "verse_number": "१२-२२१-३७", "content_sanskrit": "तमेवं सर्वदुःखात्तु मोचयेत्परमात्मवान्।\nब्रह्मचर्यव्रतोपेतः सर्वसङ्गबहिष्कृतः।\nलघ्वाहारो विशुद्धात्मा परं निर्वाणमृच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2080725, "chapter_id": 2716, "verse_number": "१२-२२१-३८", "content_sanskrit": "इन्द्रियाणि मनो वायुः शोणितं मांसमस्थि च।\nआनुपूर्व्याद्विनश्यन्ति स्वं धातुमुपयान्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2080726, "chapter_id": 2716, "verse_number": "१२-२२१-३९", "content_sanskrit": "कारणानुगतं कार्यं यदि तच्च विनश्यति।\nअलिङ्गस्य कथं लिङ्गं युज्यते तन्मृषा दृढम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2080727, "chapter_id": 2716, "verse_number": "१२-२२१-४०", "content_sanskrit": "न त्वेव हेतवः सन्ति ये केचिन्मूर्तिसंस्थिताः।\nअमर्त्यस्य च मर्त्येन सामान्यं नोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2080728, "chapter_id": 2716, "verse_number": "१२-२२१-४१", "content_sanskrit": "लोकदृष्टो यथा जातेः स्वेदजः पुरुषः स्त्रियाम्।\nकृतानुस्मरणात्सिद्धो वेदगम्यः परः पुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2080729, "chapter_id": 2716, "verse_number": "१२-२२१-४२", "content_sanskrit": "प्रत्यक्षानुगतो वेदो नामहेतुभिरिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2080730, "chapter_id": 2716, "verse_number": "१२-२२१-४३", "content_sanskrit": "यथा शाखा हि वै शाखा तरोः संबध्यते तदा।\nश्रुत्या तथापरोप्यात्मा दृश्यते सोऽप्यलिङ्गवान्।\nअलिङ्गसाध्यं तद्ब्रह्म बहवः सन्ति हेतवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2080731, "chapter_id": 2716, "verse_number": "१२-२२१-४४", "content_sanskrit": "लोकयात्राविधानं च दानधर्मफलागमः।\nतदर्थं वेदशब्दाश्च व्यवहाराश्च लौकिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2080732, "chapter_id": 2716, "verse_number": "१२-२२१-४५", "content_sanskrit": "इति सम्यङ्भनस्येते बहवः सन्ति हेतवः।\nएतदस्तीदमस्तीति न किंचित्प्रतिदृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2080733, "chapter_id": 2716, "verse_number": "१२-२२१-४६", "content_sanskrit": "तेषां विमृशतामेवं तत्तत्समभिधावताम्।\nक्वचिन्निविशते बुद्धिस्तत्र जीर्यति वृक्षवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2080734, "chapter_id": 2716, "verse_number": "१२-२२१-४७", "content_sanskrit": "एवमर्थैरनर्थैश्च दुःखिताः सर्वजन्तवः।\nआगमैरपकृष्यन्ति हस्तिनो हस्तिपैर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2080735, "chapter_id": 2716, "verse_number": "१२-२२१-४८", "content_sanskrit": "न जातु कामः कामामामुपभोगेन शाम्यति।\nहविषा कृष्णवर्त्मेव भूय एवाभिर्वधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2080736, "chapter_id": 2716, "verse_number": "१२-२२१-४९", "content_sanskrit": "अर्थांस्तथाऽत्यन्तदुःखाबहांश्च\nलिप्सन्त एके बहवो विशुष्काः।\nमहत्तरं दुःखमभिप्रपन्ना\nहित्वा सुखं मृत्युवशं प्रयान्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2080737, "chapter_id": 2716, "verse_number": "१२-२२१-५०", "content_sanskrit": "विनाशिनो ह्यध्रुवजीवितस्य\nकिं बन्धुभिर्मन्त्रपरिग्रहैश्च।\nविहाय यो गच्छति सर्वमेव\nक्षणेन गत्वा न निवर्तते च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2080738, "chapter_id": 2716, "verse_number": "१२-२२१-५१", "content_sanskrit": "स्वं भूमितोयानलवायवो हि\nसदा शरीरं प्रतिपालयन्ति।\nइतीदमालक्ष्य कुतो रतिर्भवे\nद्विनाशिनो ह्यस्य न कर्म विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2080739, "chapter_id": 2716, "verse_number": "१२-२२१-५२", "content_sanskrit": "इदमनुपधिवाक्यमच्छलं\nपरमनिरामयमात्मसाक्षिकम्।\nनरपतिरनुवीक्ष्य विस्मितः\nपुनरनुयोक्तुमिदं प्रचक्रमे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2080740, "chapter_id": 2716, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकविंशत्यधिकद्विशततमोऽध्यायः॥ २२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]