[{"id": 2108036, "chapter_id": 3335, "verse_number": "", "content_sanskrit": "शौनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108037, "chapter_id": 3335, "verse_number": "१", "content_sanskrit": "सौम्य कथय तत्वेन विस्तरेण कथामिमाम् ।\nआस्तीकस्य मुनेः साधोः शुश्रूषा परमा हि नः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108038, "chapter_id": 3335, "verse_number": "२", "content_sanskrit": "मधुरं कथ्यते सूत श्लक्ष्णाक्षरपदस्वरम् ।\nप्रीयामहे भृशं तात पितेव त्वं प्रभाषसे \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108039, "chapter_id": 3335, "verse_number": "३", "content_sanskrit": "अस्मच्छुश्रूषणे नित्यं पिता हि निरतस्तव ।\nआचष्टे तद्यथाऽऽख्यानं पिता तत् त्वं तथा वद\t ॥ ३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108040, "chapter_id": 3335, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108041, "chapter_id": 3335, "verse_number": "४", "content_sanskrit": "आयुष्मन्निदमाख्यानमास्तीकं कथयामि ते ।\nयथाश्रुतं कथयतः सकाशाच्च पितुर्मया \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108042, "chapter_id": 3335, "verse_number": "५", "content_sanskrit": "पुरा देवयुगे ब्रह्मन् प्रजापतिसुते शुभे ।\nआस्तां भगिन्यौ रूपेण समुपेतेऽद्भुते तदा \t॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108043, "chapter_id": 3335, "verse_number": "६", "content_sanskrit": "ते भार्ये काश्यपस्यास्तां कद्रूश्च विनता तथा ।\nप्रादात्ताभ्यां वरं प्रीतः प्रजापतिसमः पतिः\t ॥ ६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108044, "chapter_id": 3335, "verse_number": "७", "content_sanskrit": "काश्यपो धर्मपत्नीभ्यां मुदा परमया युतः ।\nवरातिसर्गं श्रुत्वैव काश्यपादुत्तमं च ते \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108045, "chapter_id": 3335, "verse_number": "८", "content_sanskrit": "हर्षादप्रतिमां प्रीतिं प्रापतुः स्म वरस्त्रियौ ।\nवव्रे कद्रूः सुतान् नागान् सहस्रं तुल्यतेजसः\t ॥ ८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2108046, "chapter_id": 3335, "verse_number": "९", "content_sanskrit": "द्वौ पुत्रौ विनता वव्रे कद्रूपुत्राधिकौ बले ।\nओजसा तेजसा चैव विक्रमेणाधिकौ सुतौ\t ॥ ९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2108047, "chapter_id": 3335, "verse_number": "१०", "content_sanskrit": "तस्यै भर्ता वरं प्रादाद् ईदृशौ ते भविष्यतः ।\nएवमस्त्विति तं चाह काश्यपं विनता तदा\t ॥ १०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2108048, "chapter_id": 3335, "verse_number": "११", "content_sanskrit": "कृतकृत्या तु विनता लब्ध्वा वीर्यातिगौ  सुतौ ।\nकद्रूश्च लब्ध्वा पुत्राणां सहस्रं तुल्यतेजसाम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2108049, "chapter_id": 3335, "verse_number": "१२", "content_sanskrit": "धार्यौ प्रयत्नतो गर्भावित्युक्त्वा स महातपाः ।\nते भार्ये वरसंहृष्टे काश्यपो वनमाविशत्\t ॥ १२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2108050, "chapter_id": 3335, "verse_number": "१३", "content_sanskrit": "कालेन महता कद्रूरण्डानां दशतः शतम् ।\nजनयामास विप्रेन्द्र द्वे त्वण्डे विनता तथा\t ॥ १३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2108051, "chapter_id": 3335, "verse_number": "१४", "content_sanskrit": "ततोऽप्यण्डानि निदधुः प्रहृष्टाः परिचारकाः\nसोपस्वेदेषु कुण्डेषु पञ्चवर्षशतानि च\t ॥ १४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2108052, "chapter_id": 3335, "verse_number": "१५", "content_sanskrit": "ततः पञ्चशते वर्षे कद्रूपुत्रा विनिःसृताः ।\nअण्डेभ्यो विनतायास्तु मिथुनं नाभ्यपद्यत \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2108053, "chapter_id": 3335, "verse_number": "१६", "content_sanskrit": "ततः पुत्रार्थिनी देवी व्रीडिता सा तपस्विनी ।\nअण्डं बिभेद विनता तत्र पुत्रमपश्यत\t ॥ १६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2108054, "chapter_id": 3335, "verse_number": "१७", "content_sanskrit": "पूर्वार्धकायसम्पन्नमितरेणाप्रकाशता ।\nस पुत्रो रोषसंरब्धः शशापैनामिति श्रुतिः\t ॥ १७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2108055, "chapter_id": 3335, "verse_number": "१८", "content_sanskrit": "सोऽहमेवंकृतो मातस्त्वया लोभपरीतया ।\nशरीरेणासमग्रोऽद्य तस्माद् दासी भविष्यसि\t ॥ १८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2108056, "chapter_id": 3335, "verse_number": "१९", "content_sanskrit": "पञ्च वर्षशतान्यद्य यवीयान् वर्धते मम ।\nएष च त्वां सुतो मातर्दासीत्वान्मोक्षयिष्यति \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2108057, "chapter_id": 3335, "verse_number": "२०", "content_sanskrit": "यद्येनमपि मातस्त्वं मामिवाण्डविभेदना ।\nन करिष्यस्यदेहं वा व्यङ्गं वापि तपस्विनम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2108058, "chapter_id": 3335, "verse_number": "२१", "content_sanskrit": "प्रतिपालयितव्यस्ते जन्मकालोऽस्य धीरया ।\nविशिष्टं फलमीक्षन्त्या पञ्चवर्षशतात्परम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2108059, "chapter_id": 3335, "verse_number": "२२", "content_sanskrit": "एवं शप्त्वा ततः पुत्रो विनतामन्तरिक्षगः ।\nअरुणो दृश्यते ब्रह्मन् प्रभातसमये सदा\t ॥ २२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2108060, "chapter_id": 3335, "verse_number": "२३", "content_sanskrit": "आदित्यरथमध्यास्त सारथ्यं समकल्पयन् ।\nगरुडोऽपि यथाकालं जज्ञे पन्नगसूदनः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2108061, "chapter_id": 3335, "verse_number": "२४", "content_sanskrit": "स जातमात्रो विनतां परित्यज्य खमाविशत् ।\nआदास्यन्नात्मनो भोज्यमन्नं विहितमस्य यत् ।\nविधात्रा भृगुशार्दूल क्षुधितस्य बुभुक्षतः\t ॥ २४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2108062, "chapter_id": 3335, "verse_number": "१४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यामादिपर्वणि चतुर्दशोऽध्यायः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2108063, "chapter_id": 3335, "verse_number": "२", "content_sanskrit": "॥ आस्तीकपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]