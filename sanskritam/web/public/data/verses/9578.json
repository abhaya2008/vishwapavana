[{"id": 5000578000, "chapter_id": 9578, "verse_number": "७-४३-१", "content_sanskrit": "तत्रोपविष्टं राजानमुपासन्ते विचक्षणाः ।\nकथानां बहुरूपाणां हास्यकाराः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000578001, "chapter_id": 9578, "verse_number": "७-४३-२", "content_sanskrit": "विजयो मधुमत्तश्च काश्यपो मङ्गलः कुटः ।\nसुराजः कालियो भद्रो दन्तवक्रः सुमागधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000578002, "chapter_id": 9578, "verse_number": "७-४३-३", "content_sanskrit": "एते कथा बहुविधाः परिहाससमन्विताः ।\nकथयन्ति स्म संहृष्टा राघवस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000578003, "chapter_id": 9578, "verse_number": "७-४३-४", "content_sanskrit": "ततः कथायां कस्याञ्चिद्राघवः समभाषत ।\nकाः कथा नगरे भद्र वर्तन्ते विषयेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000578004, "chapter_id": 9578, "verse_number": "७-४३-५", "content_sanskrit": "मामाश्रितानि कान्याहुः पौरजानपदा जनाः ।\nकिं च सीतां समाश्रित्य भरतं किं च लक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000578005, "chapter_id": 9578, "verse_number": "७-४३-६", "content_sanskrit": "किं नु शत्रुघ्नमुद्दिश्य कैकयीं किं नु मातरम् ।\nवक्तव्यतां च राजानो वरे राज्ये व्रजन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000578006, "chapter_id": 9578, "verse_number": "७-४३-७", "content_sanskrit": "एवमुक्ते तु रामेण भद्रः प्राञ्जलिरब्रवीत् ।\nस्थिताः कथा शुभाः राजन्वर्तन्ते पुरवासिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000578007, "chapter_id": 9578, "verse_number": "७-४३-८", "content_sanskrit": "अमुं तु विजयं सौम्य दशग्रीववधार्जितम् ।\nभूयिष्ठं स्वपुरे पौरैः कथ्यन्ते पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000578008, "chapter_id": 9578, "verse_number": "७-४३-९", "content_sanskrit": "एवमुक्तस्तु भद्रेण राघवो वाक्यमब्रवीत् ।\nकथयस्व यथातत्त्वं सर्वं निरवशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000578009, "chapter_id": 9578, "verse_number": "७-४३-१०", "content_sanskrit": "शुभाशुभानि वाक्यानि यान्याहुः पुरवासिनः ।\nश्रुत्वेदानीं शुभं कुर्यां नकुर्यामशुभानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000578010, "chapter_id": 9578, "verse_number": "७-४३-११", "content_sanskrit": "कथयस्व च विस्रब्धो निर्भयं विगतज्वरः ।\nकथयन्ति यथा पौराः पापा जनपदेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000578011, "chapter_id": 9578, "verse_number": "७-४३-१२", "content_sanskrit": "राघवेणैवमुक्तस्तु भद्रः सुरुचिरं वचः ।\nप्रत्युवाच महाबाहुं प्राञ्जलिः सुसमाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000578012, "chapter_id": 9578, "verse_number": "७-४३-१३", "content_sanskrit": "शृणु राजन्यथा पौराः कथयन्ति शुभाशुभम् ।\nचत्वरापणरथ्यासु वनेषूपवनेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000578013, "chapter_id": 9578, "verse_number": "७-४३-१४", "content_sanskrit": "दुष्करं कृतवान्रामः समुद्रे सेतुबन्धनम् ।\nअश्रुतं पूर्वकैः कैश्चिद्देवैरपि सदानवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000578014, "chapter_id": 9578, "verse_number": "७-४३-१५", "content_sanskrit": "रावणश्च दुराधर्षो हतः सबलवाहनः ।\nवानराश्च वशं नीता ऋक्षाश्च सह राक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000578015, "chapter_id": 9578, "verse_number": "७-४३-१६", "content_sanskrit": "हत्वा च रावणं सङ्ख्ये सीतामाहृत्य राघवः ।\nअमर्षं पृष्ठतः कृत्वा स्ववेश्म पुनरानयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000578016, "chapter_id": 9578, "verse_number": "७-४३-१७", "content_sanskrit": "कीदृशं हृदये तस्य सीतासम्भोगजं सुखम् ।\nअङ्कमारोप्य तु पुरा रावणेन बलाद्धृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000578017, "chapter_id": 9578, "verse_number": "७-४३-१८", "content_sanskrit": "लङ्कामपि पुरा नीतामशोकवनिकां गताम् ।\nरक्षसां वशमापन्नां कथं रामो न कुत्सते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000578018, "chapter_id": 9578, "verse_number": "७-४३-१९", "content_sanskrit": "अस्माकमपि दारेषु सहनीयं भविष्यति ।\nयथा हि कुरुते राजा प्रजा तमनुवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000578019, "chapter_id": 9578, "verse_number": "७-४३-२०", "content_sanskrit": "एवं बहुविधा वाचो वदन्ति पुरवासिनः ।\nनगरेषु च सर्वेषु राजञ्जनपदेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000578020, "chapter_id": 9578, "verse_number": "७-४३-२१", "content_sanskrit": "तस्यैवं भाषितं श्रुत्वा राघवः परमार्तवत् ।\nउवाच सुहृदः सर्वान्कथमेतद्ब्रवीथ माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000578021, "chapter_id": 9578, "verse_number": "७-४३-२२", "content_sanskrit": "सर्वे तु शिरसा भूमावभिवाद्य प्रणम्य च ।\nप्रत्यूचू राघवं दीनमेवमेतन्न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000578022, "chapter_id": 9578, "verse_number": "७-४३-२३", "content_sanskrit": "श्रुत्वा तु वाक्यं काकुत्स्थः सर्वेषां समुदीरितम् ।\nविसर्जयामास तदा वयस्याञ्छत्रुसूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000578023, "chapter_id": 9578, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे त्रिचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]