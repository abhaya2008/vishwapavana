[{"id": 2067727, "chapter_id": 2424, "verse_number": "९-४२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2067728, "chapter_id": 2424, "verse_number": "९-४२-१", "content_sanskrit": "ब्रह्मयोनिभिराकीर्णं जगाम यद्वुनन्दनः।\nयत्र दाल्भ्यो बको राजन्पश्वर्थ सुमहातपाः।\nजुहाव धृतराष्ट्रस्य राष्ट्रं कोपसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2067729, "chapter_id": 2424, "verse_number": "९-४२-२", "content_sanskrit": "तपसा घोररूपेण कर्शयन्देहमात्मनः।\nक्रोधेन महताऽऽविष्टो धर्मात्मा वै प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2067730, "chapter_id": 2424, "verse_number": "९-४२-३", "content_sanskrit": "पुरा हि नैमिशीयानां सत्रे द्वादशवार्षिके।\nवृत्ते विश्वजितोऽन्ते वै पाञ्चालानृषयोऽगमन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2067731, "chapter_id": 2424, "verse_number": "९-४२-४", "content_sanskrit": "तत्रेश्वरमयाचन्त दक्षिणार्थं मनस्विनः।\n`तत्र ते लेभिरे राजन्पाञ्चालेभ्यो महर्षयः।\nबलान्वितान्वत्सतरान्निर्व्याधीन्सप्तविंशतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2067732, "chapter_id": 2424, "verse_number": "९-४२-५", "content_sanskrit": "तानब्रवीद्बलो दाल्भ्यो विभजध्वं पशूनिति।\nपशूनेतानहं त्यक्त्वा भिक्षिष्ये राजसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2067733, "chapter_id": 2424, "verse_number": "९-४२-६", "content_sanskrit": "एवमुक्त्वा वको राजन्नृषीन्सर्वांन्प्रतापवान्।\nजगाम धृतराष्ट्रस्य भवनं ब्राह्मणोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2067734, "chapter_id": 2424, "verse_number": "९-४२-७", "content_sanskrit": "स समीपगतो भूत्वा धृतराष्ट्रं जनेश्वरम्।\nअयाचत पशून्दाल्भ्यः स चैनं रुषितोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2067735, "chapter_id": 2424, "verse_number": "९-४२-८", "content_sanskrit": "यदृच्छया मृता दृष्ट्वा गास्तदा नृपसत्तमः।\nएतान्पशून्नय क्षिप्रं ब्रह्मबन्धो यदीच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2067736, "chapter_id": 2424, "verse_number": "९-४२-९", "content_sanskrit": "ऋषिस्त्वथ बकः क्रुद्धश्चिन्तयामास धर्मवित्।\nअहो वत नृशंसं वै वाक्यमुक्तोऽस्मि संसदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2067737, "chapter_id": 2424, "verse_number": "९-४२-१०", "content_sanskrit": "चिन्तयित्वा मुहूर्तेन रोषाविष्टो द्विजोत्तमः।\nमतिं चक्रे विनाशाय धृतराष्ट्रस्य भूपतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2067738, "chapter_id": 2424, "verse_number": "९-४२-११", "content_sanskrit": "स तूत्कृत्य मृतानां वै मांसानि मुनिसत्तमः।\nजुहाव धृतराष्ट्रस्य राष्ट्रं नरपतेः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2067739, "chapter_id": 2424, "verse_number": "९-४२-१२", "content_sanskrit": "अवाकर्णे सरस्वत्यास्तीर्थे प्रज्वाल्य पावकम्।\nxxxx दाल्भ्यो महाराज नियमं परमं स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2067740, "chapter_id": 2424, "verse_number": "९-४२-१३", "content_sanskrit": "स तैरेव जुहावाग्नौ राष्ट्रं मांसैर्महातपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2067741, "chapter_id": 2424, "verse_number": "९-४२-१४", "content_sanskrit": "तस्मिंस्तु विधिवत्सत्रे सम्प्रवृत्ते सुदारुणे।\nअक्षीयत ततो राष्ट्रं धृतराष्ट्रस्य पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2067742, "chapter_id": 2424, "verse_number": "९-४२-१५", "content_sanskrit": "छिxxxमानं xxxxxx परशुना विभो\nxxxxxxxxxxxx व्यवकीर्थमचेतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2067743, "chapter_id": 2424, "verse_number": "९-४२-१६", "content_sanskrit": "दृष्ट्वा तथाऽवकीर्णं तु राष्ट्रं च मनुजाधिपः।\nबभूव दुर्मना राजा चिन्तयामास च प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2067744, "chapter_id": 2424, "verse_number": "९-४२-१७", "content_sanskrit": "xxxxxxxxxरद्यत्रं ब्राह्मणैः सहितः पुरा।\nxxxxxगच्छत्तु क्षीयते राष्ट्रमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2067745, "chapter_id": 2424, "verse_number": "९-४२-१८", "content_sanskrit": "यदा स पार्थिवः खिन्नस्ते च विप्रास्तदाऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2067746, "chapter_id": 2424, "verse_number": "९-४२-१९", "content_sanskrit": "यदा चापि न शक्नोति राष्ट्रं मोक्षयितुं नृपः।\nअथ विप्रादिकांस्तत्र पप्रच्छ जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2067747, "chapter_id": 2424, "verse_number": "९-४२-२०", "content_sanskrit": "ततो विप्रादिकाः प्राहुः पशुविप्रकृतस्त्वया।\nमांसैरभिजुहोतीदं तव राष्ट्रं मुनिर्बकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2067748, "chapter_id": 2424, "verse_number": "९-४२-२१", "content_sanskrit": "तेन ते हूयमानस्य राष्ट्रस्यास्य क्षयो महान्।\nतस्यैतत्तपसः कर्म येन तेऽद्य लयो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2067749, "chapter_id": 2424, "verse_number": "९-४२-२२", "content_sanskrit": "`यदीच्छसि महाबाहो शान्तिं राष्ट्रस्य भूमिप।\nअपां कुञ्जे सरस्वत्यास्तं प्रसादय पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2067750, "chapter_id": 2424, "verse_number": "९-४२-२३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2067751, "chapter_id": 2424, "verse_number": "९-४२-२३", "content_sanskrit": "सरस्वतीं ततो गत्वा स राजा बकमब्रवीत्।\nनिपत्य शिरसा भूमौ प्राञ्जलिर्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2067752, "chapter_id": 2424, "verse_number": "९-४२-२४", "content_sanskrit": "प्रसादये त्वां भगवन्नपराधं क्षमस्व मे।\nमम दीनस्य लुब्धस्य मौर्ख्येण हतचेतसः।\nत्वं गतिस्त्वं च मे नाथः प्रसादं कर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2067753, "chapter_id": 2424, "verse_number": "९-४२-२५", "content_sanskrit": "तं तथा विलपन्तं तु शोकोपहतचेतसम्।\nदृष्ट्वा तस्य कृपा जज्ञे राष्ट्रं तस्य व्यमोचयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2067754, "chapter_id": 2424, "verse_number": "९-४२-२६", "content_sanskrit": "ऋषिः प्रसन्नस्तस्याभूत्संरम्भं च विहाय सः।\nमोक्षार्थं तस्य राज्यस्य जुहाव पुनराहुतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2067755, "chapter_id": 2424, "verse_number": "९-४२-२७", "content_sanskrit": "मोक्षयित्वा ततो र्ष्ट्रं प्रतिगृह्य पशून्बहून्।\nहृष्टात्मा नैमिशारण्यं जगाम पुनरेव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2067756, "chapter_id": 2424, "verse_number": "९-४२-२८", "content_sanskrit": "धृतराष्ट्रोऽपि धर्मात्मा स्वस्थचेता महामनाः।\nस्वमेव नगरं राजन्प्रतिपेदे महर्द्धिमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2067757, "chapter_id": 2424, "verse_number": "९-४२-२९", "content_sanskrit": "तत्र तीर्थे महाराज बृहस्पतिरुदारधीः।\nअसुराणामभावाय भवाय च दिवौकसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2067758, "chapter_id": 2424, "verse_number": "९-४२-३०", "content_sanskrit": "मांसैरभिजुहावेष्टिमक्षीयन्त ततोऽसुराः।\nदैवतैरपि सम्भग्ना जितकाशिभिराहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2067759, "chapter_id": 2424, "verse_number": "९-४२-३१", "content_sanskrit": "तत्रापि विधिवद्दत्त्वा ब्राह्मणेभ्यो महायशाः।\nवाजिनः कुञ्जरांश्चैव रथांश्चश्वतरीयुतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2067760, "chapter_id": 2424, "verse_number": "९-४२-३२", "content_sanskrit": "रत्नानि च महार्हाणि धनं धान्यं च पुष्कलम्।\nययौ तीर्थं महाबाहुर्यायातं पृथिवीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2067761, "chapter_id": 2424, "verse_number": "९-४२-३३", "content_sanskrit": "तत्र यज्ञे ययातेश्च महाराज सरस्वती।\nसर्पिः पयश्च सुस्राव नाहुषस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2067762, "chapter_id": 2424, "verse_number": "९-४२-३४", "content_sanskrit": "तत्रेष्ट्वा पुरुषव्याघ्रो ययातिः पृथिवीपतिः।\nआक्रामदूर्ध्वं पुदितो लेभे लोकांश्च पुष्कलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2067763, "chapter_id": 2424, "verse_number": "९-४२-३५", "content_sanskrit": "पुनस्तत्र च राज्ञस्तु ययातेर्यजतः प्रभोः।\nऔदार्यं परमं कृत्वा भक्तिं चात्मनि शाश्वतीम्।\nददौ कामान्ब्राह्मणेभ्यो वान्यान्यो मनसेच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2067764, "chapter_id": 2424, "verse_number": "९-४२-३६", "content_sanskrit": "यो यत्र स्थित एवेह आहूतो यज्ञसंस्तरे।\nतस्यतस्य सरिच्छ्रेष्ठा गृहादि शयनादिकम्।\nषड्रसं भोजनं चैव दानं नानाविधं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2067765, "chapter_id": 2424, "verse_number": "९-४२-३७", "content_sanskrit": "ते मन्यमाना राज्ञस्तु सम्प्रदानमनुत्तमम्।\nराजानं तुष्टुवुः प्रीता दत्त्वा चैवाशिषः शुभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2067766, "chapter_id": 2424, "verse_number": "९-४२-३८", "content_sanskrit": "तत्र देवाः सगन्धर्वाः प्रीता यज्ञस्य सम्पदा।\nविस्मिता मानुषाश्चासन्दृष्ट्वा तां यज्ञसम्पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2067767, "chapter_id": 2424, "verse_number": "९-४२-३९", "content_sanskrit": "ततस्तालकेतुर्महाधर्मकेतु--\nर्महात्मा कृतात्मा महादाननित्यः।\nवसिष्ठापवाहं महाभीमवेगं\nधृतात्मा जितात्मा समभ्याजगाम॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2067768, "chapter_id": 2424, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि द्विचत्वारिंशोऽध्यायः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]