[{"id": 7000792000, "chapter_id": 20792, "verse_number": "६-१३५-१", "content_sanskrit": "श्रीमहादेव उवाच ।\nसाभ्रमत्यास्तु माहात्म्यं वक्ष्ये देवि यथातथम् ।\nकश्यपो वै मुनिश्रेष्ठस्तपो वै तप्तवान्महत्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000792001, "chapter_id": 20792, "verse_number": "६-१३५-२", "content_sanskrit": "अनेकवर्षपर्यंतं तेन तप्तं महत्तपः ।\nअर्बुदे पर्वते रम्ये नानाद्रुमसमाकुले॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000792002, "chapter_id": 20792, "verse_number": "६-१३५-३", "content_sanskrit": "तत्र गत्वा तपस्तप्तं ऋषिणा कश्यपेन वै ।\nसरस्वती यत्र रम्या पवित्रा पापनाशिनी॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000792003, "chapter_id": 20792, "verse_number": "६-१३५-४", "content_sanskrit": "एकस्मिन्दिवसे देवि गतोऽसौ नैमिषं प्रति ।\nतदा ते ऋषयः सर्वे कथां चक्रुरनेकशः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000792004, "chapter_id": 20792, "verse_number": "६-१३५-५", "content_sanskrit": "तदा तैस्तु द्विजैः सम्यक्पृष्टोऽसौ कश्यपो मुनिः ।\nअहो कश्यप नः प्रीत्यै गंगेहानीयतां प्रभो॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000792005, "chapter_id": 20792, "verse_number": "६-१३५-६", "content_sanskrit": "भवन्नाम्ना तु सा गंगा भविष्यति सरिद्वरा ।\nतेषां वाक्यमुपाकर्ण्य नमस्कृत्य द्विजांश्च तान्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000792006, "chapter_id": 20792, "verse_number": "६-१३५-७", "content_sanskrit": "आगतो ह्यर्बुदारण्ये सरस्वतीतीरसंनिधौ ।\nतत्र तप्तं तदा तेन तपः परमदुष्करम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000792007, "chapter_id": 20792, "verse_number": "६-१३५-८", "content_sanskrit": "आराधितो ह्यहं तेन कश्यपेन द्विजेन वै ।\nप्रत्यक्षोऽहं तदा जातस्तस्य द्विजवरस्य च॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000792008, "chapter_id": 20792, "verse_number": "६-१३५-९", "content_sanskrit": "वरं वरय भद्रं ते यत्ते मनसि वर्त्तते॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000792009, "chapter_id": 20792, "verse_number": "६-१३५-१०", "content_sanskrit": "कश्यप उवाच ।\nवरं दातुं समर्थोऽसि देवदेव जगत्पते ।\nशिरःस्थिता या गंगेयं पवित्रा पापहारिणी॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000792010, "chapter_id": 20792, "verse_number": "६-१३५-११", "content_sanskrit": "मम देया विशेषेण महादेव नमोस्तुते ।\nतदा देवि मयोक्तं च गृह्णीष्व त्वं द्विजोत्तम॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000792011, "chapter_id": 20792, "verse_number": "६-१३५-१२", "content_sanskrit": "जटामेकां परित्यज्य दत्ता गंगा तदा मया ।\nतां गृहीत्वा द्विजश्रेष्ठः स्वस्थानं हर्षतो ययौ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000792012, "chapter_id": 20792, "verse_number": "६-१३५-१३", "content_sanskrit": "केशरन्ध्रं नाम तीर्थं वासो वै कश्यपस्य च ।\nगतस्तत्र तु देवेशि मुनिभिः परिवारितः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000792013, "chapter_id": 20792, "verse_number": "६-१३५-१४", "content_sanskrit": "कश्यपेन समानीता काश्यपी सा सरिद्वरा ।\nयस्या दर्शनमात्रेण ब्रह्महा मुच्यते किल॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000792014, "chapter_id": 20792, "verse_number": "६-१३५-१५", "content_sanskrit": "पार्वत्युवाच ।\nस्नानमात्रेण किं पुण्यं तत्र तीर्थे वदस्व मे ।\nविश्वनाथ कृपालुस्त्वं दयां कुरु ममोपरि॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000792015, "chapter_id": 20792, "verse_number": "६-१३५-१६", "content_sanskrit": "दर्शने किं भवेत्पुण्यं स्नाने किं वद देवराट् ।\nमहिमा कीदृशो ब्रह्मन्सर्वं त्वं वक्तुमर्हसि॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000792016, "chapter_id": 20792, "verse_number": "६-१३५-१७", "content_sanskrit": "महादेव उवाच ।\nमया श्रुतान्यनेकानि तीर्थान्यायतनानि च ।\nश्रीविष्णोश्च प्रसादाच्च नद्यः सागरगाः प्रभोः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000792017, "chapter_id": 20792, "verse_number": "६-१३५-१८", "content_sanskrit": "गंगा च यमुना रेवा तापी चैव महानदी ।\nगोदावरी तुंगभद्रा कौशिकी गल्लिका तथा॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000792018, "chapter_id": 20792, "verse_number": "६-१३५-१९", "content_sanskrit": "कावेरी वेदिका भद्रा सरयूः पापहारिणी ।\nअन्याश्च विविधा नद्यः सर्वपापहरा भुवि॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000792019, "chapter_id": 20792, "verse_number": "६-१३५-२०", "content_sanskrit": "प्रयागस्तीर्थराजश्च काशी पुष्कर एव च ।\nनैमिषारण्यसंज्ञं तु तीर्थं चामरकंटकम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000792020, "chapter_id": 20792, "verse_number": "६-१३५-२१", "content_sanskrit": "उत्तमं द्वारकाक्षेत्रमर्बुदारण्यमुत्तमम् ।\nएवंविधानि दिव्यानि क्षेत्राणि विविधानि च॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000792021, "chapter_id": 20792, "verse_number": "६-१३५-२२", "content_sanskrit": "श्रुतानि तत्र देवेशि माया विष्णोः प्रसादतः ।\nपूर्वं भगीरथेनैव याचितोऽहं तु पार्वति॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000792022, "chapter_id": 20792, "verse_number": "६-१३५-२३", "content_sanskrit": "तदा दत्ता इयं गंगा विष्णोर्लोकमभीप्सुना ।\nकश्यपाय पुनर्दत्ता ऋषीणां वचनान्मया॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000792023, "chapter_id": 20792, "verse_number": "६-१३५-२४", "content_sanskrit": "इयं वै काश्यपी गंगा रोगदोषहरा सदा ।\nइयं या कथ्यते लोके युगे वै नामपूर्वकम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000792024, "chapter_id": 20792, "verse_number": "६-१३५-२५", "content_sanskrit": "तदहं कथयिष्यामि शृणु सुंदरि तत्वतः ।\nकृते कृतवती नाम त्रेतायां गिरिकर्णिका॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000792025, "chapter_id": 20792, "verse_number": "६-१३५-२६", "content_sanskrit": "द्वापरे चंदना नाम कलौ साभ्रमती स्मृता ।\nदिनेदिने विशेषेण स्नानार्थं तु नराश्च ये॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000792026, "chapter_id": 20792, "verse_number": "६-१३५-२७", "content_sanskrit": "सर्वपापविनिर्मुक्ता यांति विष्णोः सनातनम् ।\nप्लक्षावतरणे तीर्थे सरस्वत्यां तथेश्वरि॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000792027, "chapter_id": 20792, "verse_number": "६-१३५-२८", "content_sanskrit": "केदारे च कुरुक्षेत्रे यत्फलं स्नानतो भवेत् ।\nतत्फलं तु नृणां नूनं साभ्रमत्या दिने दिने॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000792028, "chapter_id": 20792, "verse_number": "६-१३५-२९", "content_sanskrit": "भवतीति न संदेहो व्यासस्य वचनं यथा ।\nनभस्येपरपक्षे तु प्रत्यहं वा सुरेश्वरि॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000792029, "chapter_id": 20792, "verse_number": "६-१३५-३०", "content_sanskrit": "अमावास्यादिने सम्यक्श्राद्धदाने च यत्फलम् ।\nनरस्तत्फलमाप्नोति साभ्रमत्यावगाहनात्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000792030, "chapter_id": 20792, "verse_number": "६-१३५-३१", "content_sanskrit": "कार्तिक्यां कृत्तिकायोगे श्रीस्थले माधवाग्रतः ।\nतत्फलं लभते मर्त्यो साभ्रमत्यावगाहनात्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000792031, "chapter_id": 20792, "verse_number": "६-१३५-३२", "content_sanskrit": "एषा श्रेष्ठतमा देवि सर्वलोकेषु पावनी ।\nइयं धन्यतमा देवि पवित्रा ह्यघनाशिनी॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000792032, "chapter_id": 20792, "verse_number": "६-१३५-३३", "content_sanskrit": "यस्यां वै साभ्रमत्यां च एते तिष्ठंति नित्यशः ।\nपूर्वं संबंधिनो ये च उत्तरे ये तथा पुनः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000792033, "chapter_id": 20792, "verse_number": "६-१३५-३४", "content_sanskrit": "पाश्चात्या दाक्षिणात्याश्च सर्वे यांति च नित्यशः ।\nतीर्थयात्रामिषेणैव खेटके ब्रह्मसन्निधौ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000792034, "chapter_id": 20792, "verse_number": "६-१३५-३५", "content_sanskrit": "आयांति सर्वदा देवि कार्तिक्यां च न संशयः ।\nतत्र श्राद्धं प्रकुर्वंति तथा वै विप्रभोजनम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000792035, "chapter_id": 20792, "verse_number": "६-१३५-३६", "content_sanskrit": "नाना धर्मान्प्रकुर्वंति नानायज्ञांश्च नित्यशः ।\nविविधानि च दानानि प्रकुर्वंति जनाः सदा॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000792036, "chapter_id": 20792, "verse_number": "६-१३५-३७", "content_sanskrit": "चतुर्युगेषु सर्वेषु नात्र कार्या विचारणा ।\nयवक्रीतोऽथ रैभ्यश्च काक्षीवानुशिजस्तथा॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000792037, "chapter_id": 20792, "verse_number": "६-१३५-३८", "content_sanskrit": "भृग्वंगिरास्तथा कण्वो मेधावी च पुनर्वसुः ।\nबंदी च गुणसंपन्नः प्राच्यां दिशि उपश्रिताः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000792038, "chapter_id": 20792, "verse_number": "६-१३५-३९", "content_sanskrit": "उदीच्यां ये महाभागा मधुमत्प्रमुखास्तथा ।\nसुबंधुश्च महाभागो दत्तात्रेयश्च वीर्यवान्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000792039, "chapter_id": 20792, "verse_number": "६-१३५-४०", "content_sanskrit": "शिखी दीर्घतमाश्चैव गौतमः कश्यपस्तथा ।\nश्वेतकेतुः कहोडश्च पुलहो देवलस्तथा॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000792040, "chapter_id": 20792, "verse_number": "६-१३५-४१", "content_sanskrit": "विश्वामित्र भरद्वाजौ जमदग्निश्च वीर्यवान् ।\nऋचीकपुत्रो गर्गश्च ऋषिरुद्दालकस्तथा॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000792041, "chapter_id": 20792, "verse_number": "६-१३५-४२", "content_sanskrit": "देवशर्माऽथ धौम्यश्च आस्तीकः कश्यपस्तथा ।\nलोमशो नाभिकेतुश्च लोमहर्षण एव च॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000792042, "chapter_id": 20792, "verse_number": "६-१३५-४३", "content_sanskrit": "ऋषिरुग्रश्रवाश्चैव भार्गवश्च्यवनस्तथा ।\nवालखिल्यादयो ये च सर्वे गच्छंति तत्र वै॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000792043, "chapter_id": 20792, "verse_number": "६-१३५-४४", "content_sanskrit": "कृतस्नाना निराहाराः सदा विष्णुपरायणाः ।\nशंखचक्रगदाधरास्तटे तिष्ठंति नित्यशः॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000792044, "chapter_id": 20792, "verse_number": "६-१३५-४५", "content_sanskrit": "पितृतीर्थं गयानाम सर्वतीर्थवरं शुभम् ।\nयत्रास्ते देवदेवेशः स्वयमेव पितामहः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000792045, "chapter_id": 20792, "verse_number": "६-१३५-४६", "content_sanskrit": "गीतायाः पितृभिर्गाथा श्राद्धभागमपीप्सुभिः ।\nएष्टव्या बहवः पुत्रा यद्येकोऽपि गयां व्रजेत्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000792046, "chapter_id": 20792, "verse_number": "६-१३५-४७", "content_sanskrit": "यजेत वाश्वमेधेन नीलं वा वृषमुत्सृजेत् ।\nतथा वाराणसी पुण्या पितॄणां वल्लभा सदा॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000792047, "chapter_id": 20792, "verse_number": "६-१३५-४८", "content_sanskrit": "या चैव मम सांनिध्याद्भुक्तिमुक्तिफलप्रदा ।\nममाज्ञया तु देवेशो बिंदुमाधवसंज्ञकः॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000792048, "chapter_id": 20792, "verse_number": "६-१३५-४९", "content_sanskrit": "नित्यं तिष्ठति देवेशि वाराणस्यां विशेषतः ।\nअतो धन्यतमा श्रेष्ठा पुरीयं मम सर्वदा॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000792049, "chapter_id": 20792, "verse_number": "६-१३५-५०", "content_sanskrit": "पितॄणां वल्लभं तीर्थं पुण्यं वै विमलेश्वरम् ।\nपितृतीर्थं प्रयागं च सर्वतीर्थसमन्वितम्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000792050, "chapter_id": 20792, "verse_number": "६-१३५-५१", "content_sanskrit": "साभ्रमत्युदके देवि आयांति वचनान्मम ।\nवटेश्वरश्च भगवान्माधवेन समन्वितः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000792051, "chapter_id": 20792, "verse_number": "६-१३५-५२", "content_sanskrit": "दशाश्वमेधकं पुण्यं गंगाद्वारं तथैव च ।\nमन्नियोगाच्च देवेशि साभ्रमत्यां वसंति हि॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000792052, "chapter_id": 20792, "verse_number": "६-१३५-५३", "content_sanskrit": "नदाथ ललितादेवी तीर्थं यत्सप्तधारकम् ।\nतथा मित्रपदं नाम केदारं शंकरालयम्॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000792053, "chapter_id": 20792, "verse_number": "६-१३५-५४", "content_sanskrit": "गंगासागरमित्याहुः सर्वतीर्थमयं शुभम् ।\nतीर्थं ब्रह्मसरस्तद्वच्छतद्रु सलिले ह्रदे॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000792054, "chapter_id": 20792, "verse_number": "६-१३५-५५", "content_sanskrit": "तीर्थं तु नैमिषं नाम आज्ञया मम सर्वदा ।\nसाभ्रमत्युदके देवि निवसंति न संशयः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000792055, "chapter_id": 20792, "verse_number": "६-१३५-५६", "content_sanskrit": "श्वेता वल्कलिनी पुण्या ततः श्वेता हिरण्मयी ।\nहस्तिमत्यथवार्त्तघ्नी नदी सागरगामिनी॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000792056, "chapter_id": 20792, "verse_number": "६-१३५-५७", "content_sanskrit": "पितॄणां वल्लभा ह्येताः श्राद्धकोटिफलप्रदः ।\nतत्र श्राद्धानि देयानि पुत्रैः पितृहिताय वै॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000792057, "chapter_id": 20792, "verse_number": "६-१३५-५८", "content_sanskrit": "पाटलं वाडवाख्यं च नगरं तत्र सुंदरि ।\nसाभ्रमत्यां सदा एताः प्राप्ता नद्यो विशेषतः॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000792058, "chapter_id": 20792, "verse_number": "६-१३५-५९", "content_sanskrit": "तत्र स्नानं च दानं च ये कुर्वंति नरा भुवि ।\nइहलोके सुखं भुक्त्वा यांति विष्णोः सनातनम्॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000792059, "chapter_id": 20792, "verse_number": "६-१३५-६०", "content_sanskrit": "जंबूद्वीपं महापुण्यं यत्र पुण्यं विवर्द्धते ।\nतत्रार्याख्यं महापुण्यं सर्वकामफलप्रदम्॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000792060, "chapter_id": 20792, "verse_number": "६-१३५-६१", "content_sanskrit": "नीलकंठमिति ख्यातं तीर्थं नंदह्रदस्तथा ।\nतथा रुद्रह्रदस्तीर्थं पुण्यं रुद्र महालयम्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000792061, "chapter_id": 20792, "verse_number": "६-१३५-६२", "content_sanskrit": "मंदाकिनी महापुण्या तथाच्छोदा महानदी ।\nसाभ्रमत्यां वहंत्येते स्वात्मना दर्शनीकृते॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000792062, "chapter_id": 20792, "verse_number": "६-१३५-६३", "content_sanskrit": "धूम्रा मित्रपदं तद्वद्वैजनाथं दृषद्वरम् ।\nक्षिप्रा नदी महाकालं तथा कालिंजरो गिरिः॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000792063, "chapter_id": 20792, "verse_number": "६-१३५-६४", "content_sanskrit": "गंगोद्भूतं हरोद्भेदं नर्मदाकारमेव च ।\nगंगापिंडप्रदानेन समान्याहुर्मनीषिणः॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000792064, "chapter_id": 20792, "verse_number": "६-१३५-६५", "content_sanskrit": "एतानि ब्रह्मतीर्थानि साभ्रमत्युत्तरे तटे ।\nगुप्तीकृतानि देवेशि देवैर्ब्रह्मपुरोगमैः॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000792065, "chapter_id": 20792, "verse_number": "६-१३५-६६", "content_sanskrit": "स्मरणादपि लोकानां पापघ्नानि महेश्वरि ।\nकिं पुनः श्राद्धदातॄणां मानवानां सुरेश्वरि॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000792066, "chapter_id": 20792, "verse_number": "६-१३५-६७", "content_sanskrit": "ओंकारं पितृतीर्थं च कावेरी कपिलोदकम् ।\nसंभेदश्चंडवेगायास्तथैवामरकंटकम्॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000792067, "chapter_id": 20792, "verse_number": "६-१३५-६८", "content_sanskrit": "कुरुक्षेत्राच्छतगुणमस्मिन्स्नानादिकं भवेत् ।\nवार्तघ्नीसंगमे देवि गणेश्वरपुरःसरम्॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000792068, "chapter_id": 20792, "verse_number": "६-१३५-६९", "content_sanskrit": "साभ्रमत्यां पुरा नीतं गणैस्तीर्थकदंकबम् ।\nएष तूद्देशतः प्रोक्तस्तीर्थानां संगमो मया॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000792069, "chapter_id": 20792, "verse_number": "६-१३५-७०", "content_sanskrit": "वागीशापि न शक्नोति तीर्थानां तत्वविस्तरम् ।\nसत्यं तीर्थं दयातीर्थं तीर्थमिंद्रियविग्रहः॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000792070, "chapter_id": 20792, "verse_number": "६-१३५-७१", "content_sanskrit": "तस्यास्तीर्थे प्रयत्नेन स्नानं कुर्यान्न संशयः ।\nप्रातःकालो मुहूर्तांस्त्रीन्संगवस्तावदेव तु॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000792071, "chapter_id": 20792, "verse_number": "६-१३५-७२", "content_sanskrit": "तदा स्नानादिकं तीर्थे देवानां प्रीतिदायकम् ।\nमध्याह्नस्त्रिमुहूर्तः स्यादपराह्णस्ततः परम्॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000792072, "chapter_id": 20792, "verse_number": "६-१३५-७३", "content_sanskrit": "पितॄणां प्रीतिजननं स्नानपिंडादि तर्पणम् ।\nसायाह्नस्त्रिमुहूर्तः स्याच्छ्राद्धं तत्र न कारयेत्॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000792073, "chapter_id": 20792, "verse_number": "६-१३५-७४", "content_sanskrit": "राक्षसी नाम सा वेला गर्हिता सर्वकर्मसु ।\nअह्नो मुहूर्ता विख्याता दशपंच च सर्वदा॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000792074, "chapter_id": 20792, "verse_number": "६-१३५-७५", "content_sanskrit": "तत्राष्टमो मुहूर्तो यः स कालः कुतुपः स्मृतः ।\nमध्याह्ने सर्वदा यस्मान्मंदी भवति भास्करः॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000792075, "chapter_id": 20792, "verse_number": "६-१३५-७६", "content_sanskrit": "तस्मादनंतफलदः पितॄणां पिंडदानतः ।\nमध्याह्नः खङ्गपात्रं च तथा नेपालकंबलः॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000792076, "chapter_id": 20792, "verse_number": "६-१३५-७७", "content_sanskrit": "रूप्यं दर्भास्तथा गावो दौहित्रं कुतपास्तिलाः ।\nपापं कुत्सितमित्याहुस्तस्य संतापकारकाः॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000792077, "chapter_id": 20792, "verse_number": "६-१३५-७८", "content_sanskrit": "अष्टावेते यतस्तस्मात्कुतपा इति विश्रुताः ।\nऊर्द्ध्वं मुहूर्तात्कुतुपात्यन्मुहूर्त चतुष्टयम्॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000792078, "chapter_id": 20792, "verse_number": "६-१३५-७९", "content_sanskrit": "महूर्तपंचकं चैतच्छ्राद्धकाले समिष्यते ।\nविष्णोर्देहात्समुद्भूताः कुशाः कृष्णतिलाः स्मृताः॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000792079, "chapter_id": 20792, "verse_number": "६-१३५-८०", "content_sanskrit": "श्राद्धस्य रक्षणार्थाय एवमाहुर्दिवौकसः ।\nतिलोदकांजलिर्देयो जलस्थैस्तीर्थवासिभिः॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000792080, "chapter_id": 20792, "verse_number": "६-१३५-८१", "content_sanskrit": "सदर्भहस्तैरेकेन श्राद्धमेवं न हिंस्यते ।\nसाभ्रमत्यां नामधेयैरिति तीर्थप्रवेशनम्॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000792081, "chapter_id": 20792, "verse_number": "६-१३५-८२", "content_sanskrit": "कारयित्वा मया देवि दत्ता वै कश्यपाय च ।\nमम भक्तः कश्यपोसौ वल्लभो मम सर्वदा॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000792082, "chapter_id": 20792, "verse_number": "६-१३५-८३", "content_sanskrit": "दत्ता तस्मादियं गंगा पवित्रा पापनाशिनी ।\nसाभ्रमत्यां महाभागे तीर्थे वै ब्रह्मचारिके॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000792083, "chapter_id": 20792, "verse_number": "६-१३५-८४", "content_sanskrit": "आत्मानं च प्रतिष्ठाप्य तन्नाम्ना शंकरो ह्यहम् ।\nस्थितो लोकहितार्थाय ब्रह्मचारीश संज्ञकः॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000792084, "chapter_id": 20792, "verse_number": "६-१३५-८५", "content_sanskrit": "साभ्रमत्यामुपकंठे ब्रह्मचारीश संज्ञके ।\nकलौ भक्तो विशेषेण पूजनं कुरुते यदा॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000792085, "chapter_id": 20792, "verse_number": "६-१३५-८६", "content_sanskrit": "इहलोके सुखं भुक्त्वा याति शैवं पदं महत् ।\nमहद्भिर्व्याधिभिश्चैव पीडितो यदि गच्छति॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000792086, "chapter_id": 20792, "verse_number": "६-१३५-८७", "content_sanskrit": "यस्याशु नश्यति व्याधिर्दर्शनाच्च महेश्वरि ।\nगत्वा वै तस्य संस्थाने उपवासी जितेंद्रियः॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000792087, "chapter_id": 20792, "verse_number": "६-१३५-८८", "content_sanskrit": "पूजनं कुरुते भक्त्या रात्रौ तिष्ठन्सुनिश्चलः ।\nतदाहं योगिरूपेण दर्शनं तस्य यामि हि॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000792088, "chapter_id": 20792, "verse_number": "६-१३५-८९", "content_sanskrit": "ददामि वांच्छितान्कामान्सत्यं सत्यं वरानने ।\nममस्थाने विशेषेण समायांति च ये जनाः॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000792089, "chapter_id": 20792, "verse_number": "६-१३५-९०", "content_sanskrit": "तेषां व्याधिप्रशमनं करोमि सुचिरादहम् ।\nचतुरशीतिसंज्ञेयो व्याधिः संकथितो मया॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000792090, "chapter_id": 20792, "verse_number": "६-१३५-९१", "content_sanskrit": "स स व्याधिर्विनश्येत दर्शनादेव सुंदरि ।\nन लिंगं वर्तते तत्र मामकं नगनंदिनि॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000792091, "chapter_id": 20792, "verse_number": "६-१३५-९२", "content_sanskrit": "स्नानमात्रं तु तत्रैव मामकं नात्र संशयः ।\nएकस्मिन्नेव काले तु अस्यां भूमौ महातपाः॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000792092, "chapter_id": 20792, "verse_number": "६-१३५-९३", "content_sanskrit": "राजा वै सूर्यवंशीयो ब्रह्मदत्तस्तु वीर्यवान् ।\nतेन राज्ञा तपस्तप्तं बहुकालं सुरेश्वरि॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000792093, "chapter_id": 20792, "verse_number": "६-१३५-९४", "content_sanskrit": "पंचाग्निसाधनं तेन कृतं च बहुधा ततः ।\nमासोपवासकादीनि तपस्तप्तान्यनेकशः॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000792094, "chapter_id": 20792, "verse_number": "६-१३५-९५", "content_sanskrit": "एवं बहुतरं कालं राज्ञा तप्तं तपो महत् ।\nप्रत्यक्षोऽहं तदा जातो वरार्थं वरवर्णिनि॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000792095, "chapter_id": 20792, "verse_number": "६-१३५-९६", "content_sanskrit": "ब्रह्मदत्त शृणुष्व त्वं महद्वाक्यं नरेश्वर ।\nयं यं वांछयसे नित्यं तं तं दद्मि न संशयः॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000792096, "chapter_id": 20792, "verse_number": "६-१३५-९७", "content_sanskrit": "तेनोक्तं मम देवेश वांच्छितं यदि दीयते ।\nएक एव वरो देव दीयतां मम सर्वदा॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000792097, "chapter_id": 20792, "verse_number": "६-१३५-९८", "content_sanskrit": "मम नाम्ना हि देवेश ईश्वरो भुवि जायताम् ।\nतेन वाक्येन संतुष्टो वरो दत्तो मयाऽनघे॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000792098, "chapter_id": 20792, "verse_number": "६-१३५-९९", "content_sanskrit": "तदाहं तेन वै सार्द्धं निवसामि सुरेश्वरि ।\nअत्र स्थित्वा निराहारो भक्तिं कुर्यादशेषतः॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000792099, "chapter_id": 20792, "verse_number": "६-१३५-१००", "content_sanskrit": "ददामि वांछितान्कामान्यावदिंद्राश्चतुर्दश ।\nअत्रागत्य तु ये विप्रा रुद्रजाप्यादिकं च यत्॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000792100, "chapter_id": 20792, "verse_number": "६-१३५-१०१", "content_sanskrit": "प्रकुर्वंति विशेषेण तेषां दद्मि शृणुष्व तत् ।\nस्त्रीसौख्यं पुत्रसौख्यं च लक्ष्मीवृद्धिकरं पुनः॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}]