[{"id": 2114224, "chapter_id": 3458, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2114225, "chapter_id": 3458, "verse_number": "१", "content_sanskrit": "पाण्डवान् धार्तराष्ट्रांश्च कृतास्त्रान् प्रसमीक्ष्य तु ।\nगुर्वर्थं दक्षिणां काले प्राप्तेऽमन्यत वै गुरुः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2114226, "chapter_id": 3458, "verse_number": "२", "content_sanskrit": "कृतास्त्रांश्च ततः शिष्यान् चोदयामास वै गुरुः ।\nअस्त्रशिक्षामनुज्ञातान् गङ्गाद्वारमुपागतान्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2114227, "chapter_id": 3458, "verse_number": "३", "content_sanskrit": "भारद्वाजस्ततस्तांस्तु सर्वानेवाभ्यभाषत ।\nइच्छामि दत्तां सहितैर्मह्यं परमदक्षिणाम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2114228, "chapter_id": 3458, "verse_number": "४", "content_sanskrit": "एवमुक्तास्ततस्ते वै शिष्या द्रोणमुपागमन् ।\nभगवन् किं प्रयच्छाम आज्ञापयतु नो गुरुः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2114229, "chapter_id": 3458, "verse_number": "५", "content_sanskrit": "ततः शिष्यान् समाहूय आचार्यः समचोदयत् ।\nद्रोणः सर्वानशेषेण दक्षिणार्थं महीपते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2114230, "chapter_id": 3458, "verse_number": "६", "content_sanskrit": "पाञ्चालराजं द्रुपदं गृहीत्वा रणमूर्धनि ।\nपर्यानयत भद्रं वः सा स्यात् परमदक्षिणा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2114231, "chapter_id": 3458, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2114232, "chapter_id": 3458, "verse_number": "७", "content_sanskrit": "तथेत्युक्त्वा तु ते सर्वे रथैस्तूर्णं प्रहारिणः ।\nआचार्यधनदानार्थं द्रोणेन सहिता ययुः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2114233, "chapter_id": 3458, "verse_number": "८", "content_sanskrit": "ततोऽभिजग्मुः पाञ्चालं क्रोशन्तः कौरवर्षभाः ।\nततो रथपदातौघैः कुञ्जरैः सादिभिः सह \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2114234, "chapter_id": 3458, "verse_number": "९", "content_sanskrit": "दुर्योधनश्च कर्णश्च युयुत्सुश्च महाबलः ।\nदुःशासनो विकर्णश्च जलसन्धः सुलोचनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2114235, "chapter_id": 3458, "verse_number": "१०", "content_sanskrit": "एते चान्ये च बहवः कुमारा बहुविक्रमाः ।\nअहंपूर्वमहंपूर्वमित्येवं क्षत्रियर्षभाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2114236, "chapter_id": 3458, "verse_number": "११", "content_sanskrit": "ततो वररथारूढाः कुमाराः सादिभिः सह ।\nप्रविश्य नगरं सर्वे राजमार्गमुपाययुः ।\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2114237, "chapter_id": 3458, "verse_number": "१२", "content_sanskrit": "तस्मिन् काले तु पाञ्चालः श्रुत्वा दृष्ट्वा महद्बलम् ।\nभ्रातृभिः सहितो राजन् त्वरया निर्ययौ गृहात्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2114238, "chapter_id": 3458, "verse_number": "१३", "content_sanskrit": "ततस्तु कृतसन्नाहा यज्ञसेनसहोदराः ।\nशरवर्षाणि मुञ्चन्तः प्रणेदुः सर्वतोदिशम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2114239, "chapter_id": 3458, "verse_number": "१४", "content_sanskrit": "ततो रथेन शुभ्रेण समासाद्य तु कौरवान् ।\nयज्ञसेनः शरान् घोरान् ववर्ष युधि दुर्जयः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2114240, "chapter_id": 3458, "verse_number": "१५", "content_sanskrit": "पूर्वमेव तु सम्मन्त्र्य पार्थो द्रोणमथाऽब्रवीत् ।\nदर्पोत्सेकः कुमाराणामाचार्य द्विजसत्तम \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2114241, "chapter_id": 3458, "verse_number": "१६", "content_sanskrit": "एषां पराक्रमस्यान्ते वयं कुर्याम साहसम् ।\nएतैरशक्यः पाञ्चालो ग्रहीतुं रणमूर्धनि\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2114242, "chapter_id": 3458, "verse_number": "१७", "content_sanskrit": "एवमुक्त्वा तु कौन्तेयो भ्रातृभिः सहितोऽनघः ।\nअर्धक्रोशे तु नगरादतिष्ठद् बहिरेव सः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2114243, "chapter_id": 3458, "verse_number": "१८", "content_sanskrit": "द्रुपदः कौरवान् दृष्ट्वा प्रधावत समन्ततः ।\nशरजालेन महता मोहयन् कौरवीं चमूम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2114244, "chapter_id": 3458, "verse_number": "१९", "content_sanskrit": "तमुद्यन्तं रथेनैकमाशुकारिणमाहवे ।\nअनेकमिति सन्त्रासान्मेनिरे सर्वकौरवाः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2114245, "chapter_id": 3458, "verse_number": "२०", "content_sanskrit": "द्रुपदस्य शरा घोरा विचेरुः सर्वतोदिशम् ।\nततः शङ्खाश्च भेर्यश्च मृदङ्गाश्च सहस्रशः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2114246, "chapter_id": 3458, "verse_number": "२१", "content_sanskrit": "प्रावाद्यन्त महाराज पाञ्चालानां निवेशने ।\nसिंहनादश्च सञ्जज्ञे पाञ्चालानां महात्मनाम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2114247, "chapter_id": 3458, "verse_number": "२२", "content_sanskrit": "धनुर्ज्यातळशब्दश्च संस्पृशद् गगनं महत् ।\nदुःशासनो विकर्णश्च सुबाहुर्दीर्घलोचनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2114248, "chapter_id": 3458, "verse_number": "२३", "content_sanskrit": "दुर्योधनश्च सङ्क्रुद्धः शरवर्वैरवाकिरन् ।\nसोऽतिविद्धो महेष्वासैः पार्षतो युधि दुर्जयः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2114249, "chapter_id": 3458, "verse_number": "२४", "content_sanskrit": "व्यधमत् तान्यनीकानि तत्क्षणादेव भारत ।\nदुर्योधनं विकर्णं च कर्णं चापि महाबलम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2114250, "chapter_id": 3458, "verse_number": "२५", "content_sanskrit": "नानानृपसुतान् वीरान् सैन्यानि विविधानि च ।\nअलातचक्रवत् सर्वांश्चरन् बाणैरतर्पयत् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2114251, "chapter_id": 3458, "verse_number": "२६", "content_sanskrit": "अभिद्रवत कौरव्यान् वर्षमाणा घना इव ।\nदुःशासनं च दशभिर्विकर्णं विंशकैः शरैः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2114252, "chapter_id": 3458, "verse_number": "२७", "content_sanskrit": "शकुनिं विंशकैस्तीक्ष्णैर्दशभिर्मर्मभेदिभिः ।\nकर्णदुर्योधनौ चोभौ शरैः सर्वाङ्गसन्धिषु \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2114253, "chapter_id": 3458, "verse_number": "२८", "content_sanskrit": "अष्टाविंशतिभिः सर्वैः पृथक्पृथगरिन्दमः ।\nसुबाहुं पञ्चभिर्विद्ध्वा तथाऽन्यान् विविधैः शरैः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2114254, "chapter_id": 3458, "verse_number": "२९", "content_sanskrit": "विव्याध सहसा भूयो ननाद बलवत्तरम् ।\nविनद्य कोपात् पाञ्चालः सर्वशस्त्रभृतां वरः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2114255, "chapter_id": 3458, "verse_number": "३०", "content_sanskrit": "धनूंषि रथयन्त्रं च हयाञ्छत्रध्वजानपि ।\nचकर्त सर्वपाञ्चालाः प्रणेदुः सिंहसर्पवत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2114256, "chapter_id": 3458, "verse_number": "३१", "content_sanskrit": "ततस्तु नागराः सर्वे मुसलैर्यष्टिभिस्तदा ।\nअभ्यद्रवन्त कौरव्यान् वर्षमाणा घना इव\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2114257, "chapter_id": 3458, "verse_number": "३२", "content_sanskrit": "सबालवृद्धाः काम्पिल्याः कौरवानभ्ययुस्तदा ।\nदृष्ट्वा तु तुमुलं युद्धं पौरैर्मग्नाश्च भारताः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2114258, "chapter_id": 3458, "verse_number": "३३", "content_sanskrit": "द्रवन्ति स्म न तिष्ठन्ति क्रोशन्तः पाण्डवान् प्रति ।\nपाञ्चालशरभिन्नाङ्गो भयमासाद्य वै नृप \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2114259, "chapter_id": 3458, "verse_number": "३४", "content_sanskrit": "कर्णो रथादवप्लुत्य पलायनपरोऽभवत् ।\nपाण्डवास्तु स्वनं श्रुत्वा आर्तानां रोमहर्षणम् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2114260, "chapter_id": 3458, "verse_number": "३५", "content_sanskrit": "अभिवाद्य ततो द्रोणं रथानारुरुहुस्तदा ।\nयुधिष्ठिरं निवार्याशु मा युद्धमिति पाण्डव \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2114261, "chapter_id": 3458, "verse_number": "३६", "content_sanskrit": "माद्रेयौ चक्ररक्षौ तु फल्गुनश्च तदाऽकरोत् ।\nसेनाग्रतो भीमसेनस्तदाऽभूद् गदया सह \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2114262, "chapter_id": 3458, "verse_number": "३७", "content_sanskrit": "तदा शङ्खध्वनिं कृत्वा भ्रातृभिः सहितोऽनघः ।\nअयाज्जवेन कौन्तेयो रथघोषेण नादयन् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2114263, "chapter_id": 3458, "verse_number": "३८", "content_sanskrit": "पाञ्चालानां ततः सेनामुद्धूतार्णवनिस्स्वनाम् ।\nभीमसेनो महाबाहुर्दण्डपाणिरिवान्तकः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2114264, "chapter_id": 3458, "verse_number": "३९", "content_sanskrit": "प्रविवेश महासेनां मकरः सागरं यथा ।\nस्वयमभ्यद्रवद् भीमो नागानीकं गदाधरः \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2114265, "chapter_id": 3458, "verse_number": "४०", "content_sanskrit": "सुयुद्धकुशलः पार्थो बाहुवीर्येण चातुलः ।\nव्यहनत् कुञ्जरानीकं गदया कालरूपधृक् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2114266, "chapter_id": 3458, "verse_number": "४१", "content_sanskrit": "ते गजा गिरिसङ्काशाः गिरन्तो रुधिरं बहु ।\nभीमसेनस्य गदया भिन्नमस्तकपिण्डकाः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2114267, "chapter_id": 3458, "verse_number": "४२", "content_sanskrit": "पतन्ति द्विरदा भूमौ वज्रघातादिवाचलाः ।\nगजानश्वान् रथांश्चैव पातयामास पाण्डवः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2114268, "chapter_id": 3458, "verse_number": "४३", "content_sanskrit": "पदातीन् नागरांश्चैव नावधीदर्जुनाग्रजः ।\nगोपाल इव दण्डेन यथा पशुगणान् वने\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2114269, "chapter_id": 3458, "verse_number": "४४", "content_sanskrit": "चालयन् रथनागाश्वान् सञ्चचाल वृकोदरः ।\nभारद्वाजप्रियं कर्तुमुद्यतः फल्गुनस्तदा \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2114270, "chapter_id": 3458, "verse_number": "४५", "content_sanskrit": "पार्षतं शरजालेन क्षिप्रं प्रच्छाद्य पाण्डवः ।\nहयौघांश्च गजौघांश्च रथौघांश्च समन्ततः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2114271, "chapter_id": 3458, "verse_number": "४६", "content_sanskrit": "पातयन् समरे राजन् युगान्ताग्निरिव ज्वलन् ।\nततस्ते हन्यमाना वै पाञ्चालाः सृञ्जयास्तथा \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2114272, "chapter_id": 3458, "verse_number": "४७", "content_sanskrit": "शरैर्नानाविधैस्तूर्णं पार्थं प्रच्छाद्य सर्वशः ।\nसिंहनादरवान् कृत्वा समयुध्यन्त पाण्डवम् \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2114273, "chapter_id": 3458, "verse_number": "४८", "content_sanskrit": "तद्युद्धमभवद् घोरं सुमहाद्भुतदर्शनम् ।\nसिंहनादस्वनं श्रुत्वा नामृष्यत धनञ्जयः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2114274, "chapter_id": 3458, "verse_number": "४९", "content_sanskrit": "ततः किरीटी सहसा पाञ्चालं समभिद्रवत् ।\nछादयन्निषुजालेन महता मोहयन्निव \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2114275, "chapter_id": 3458, "verse_number": "५०", "content_sanskrit": "शीघ्रमभ्यस्यतो बाणान् सन्दधानस्य चानिशम् ।\nनान्तरं ददृशे किञ्चित् कौन्तेयस्य तरस्विनः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2114276, "chapter_id": 3458, "verse_number": "५१", "content_sanskrit": "न दिशो नान्तरिक्षं च तदा नैव च मेदिनी ।\nअदृश्यत महाराज तत्र किञ्चन संयुगे \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2114277, "chapter_id": 3458, "verse_number": "५२", "content_sanskrit": "बाणान्धकारे बलिना कृते गाण्डीवधन्वना ।\nपाञ्चालानां कुरूणां च साधुसाध्विति निस्वनः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2114278, "chapter_id": 3458, "verse_number": "५३", "content_sanskrit": "तत्र तूर्यनिनादश्च शङ्खानां च महाखनः ।\nसिंहनादश्च सञ्जज्ञे साट्टहासेन मिश्रितः \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2114279, "chapter_id": 3458, "verse_number": "५४", "content_sanskrit": "ततः पाञ्चालराजस्तु तथा सत्यजिता सह ।\nत्वरमाणोऽभिदुद्राव महेन्द्रं शम्बरो यथा\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2114280, "chapter_id": 3458, "verse_number": "५५", "content_sanskrit": "महता शरजालेन पार्थः पाञ्चालमावृणोत् ।\nततो हलहलाशब्द आसीत् पाञ्चालके बले \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2114281, "chapter_id": 3458, "verse_number": "५६", "content_sanskrit": "जिघृक्षति महासिंहे गजानामिव यूथपम् ।\nदृष्ट्वा पार्थं तदायान्तं सत्यजित् सत्यविक्रमः \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2114282, "chapter_id": 3458, "verse_number": "५७", "content_sanskrit": "पाञ्चालं वै परिप्रेप्सुर्धनञ्जयमभिद्रवत् ।\nततस्त्वर्जुनपाञ्चालौ युद्धाय समुपागतौ \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2114283, "chapter_id": 3458, "verse_number": "५८", "content_sanskrit": "व्यक्षोभयेतां तौ सैन्यमिन्द्रवैरोचनाविव ।\nततः सत्यजितं पार्थो दशभिर्मर्मभेदिभिः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2114284, "chapter_id": 3458, "verse_number": "५९", "content_sanskrit": "विव्याध बलवद् राजन् तदद्भुतमिवाभवत् ।\nततः शरशतैः पार्थं पाञ्चालः शीघ्रमार्दयत्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2114285, "chapter_id": 3458, "verse_number": "६०", "content_sanskrit": "पार्थस्तु शरवर्षेण च्छाद्यमानो महारथः ।\nवेगं चक्रे महावेगो धनुर्ज्यामवमृज्य च\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2114286, "chapter_id": 3458, "verse_number": "६१", "content_sanskrit": "ततः सत्यजितश्चापं छित्वा राजानमभ्ययात् ।\nअथान्यद्धनुरादाय सत्यजिद् वेगवत्तरम् \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2114287, "chapter_id": 3458, "verse_number": "६२", "content_sanskrit": "साश्वं ससूतं सरथं पार्थं विव्याध सत्वरम् ।\nस तं न ममृषे पार्थः पाञ्चालेनार्दितो मृघे\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2114288, "chapter_id": 3458, "verse_number": "६३", "content_sanskrit": "ततस्तस्य विनाशार्थं सत्वरं व्यसृजच्छरान् ।\nहयान् ध्वजं धनुर्मुष्टिमुभौ तौ पार्ष्णिसारथी\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2114289, "chapter_id": 3458, "verse_number": "६४", "content_sanskrit": "स तथा भिद्यमानेषु कार्मुकेषु पुनःपुनः ।\nहयेषु विनिकृत्तेषु विमुखोऽभवदाहवे \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2114290, "chapter_id": 3458, "verse_number": "६५", "content_sanskrit": "स सत्यजितमालेक्य तथा विमुखमाहवे ।\nवेगेन महता राजन्नभ्यधावत पार्षतम् \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2114291, "chapter_id": 3458, "verse_number": "६६", "content_sanskrit": "तदा चक्रे महद्युद्धमर्जुनो जयतां वरः ।\nतस्य पार्थो ध्वजं चित्रं धनुश्चोर्व्यामपातयत्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2114292, "chapter_id": 3458, "verse_number": "६७", "content_sanskrit": "पञ्चभिस्तस्य विव्याथ हयान् सूतं च सायकैः ।\nतत उत्सृज्य तच्चापमाददानः शरावरम् \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2114293, "chapter_id": 3458, "verse_number": "६८", "content_sanskrit": "खङ्गमुद्यम्य कौन्तेयः सिंहनादमथाकरोत् ।\nपाञ्चालरथमास्थाय अवित्रस्तो धनञ्जयः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2114294, "chapter_id": 3458, "verse_number": "६९", "content_sanskrit": "पाञ्चालस्य रथस्येषामाप्लुत्य सहसा बली ।\nविक्षोभ्याम्भोनिधिं तार्क्ष्यस्तं नागमिव सोऽग्रहीत्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2114295, "chapter_id": 3458, "verse_number": "७०", "content_sanskrit": "ततस्तु सर्वपाञ्चाला विद्रवन्ति दिशो दश ।\nदर्शयन् सर्वसैन्यानां बाह्वोर्बलमथात्मनः \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2114296, "chapter_id": 3458, "verse_number": "७१", "content_sanskrit": "सिंहनादस्वनं कृत्वा निर्जगाम धनञ्जयः ।\nआयान्तमर्जुनं दृष्ट्वा कुमाराः सहितास्तदा ।\nममृदुस्तस्य नगरं द्रुपदस्य महात्मनः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2114297, "chapter_id": 3458, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2114298, "chapter_id": 3458, "verse_number": "७२", "content_sanskrit": "सम्बन्धी कुरुवीराणां द्रुपदो राजसत्तमः ।\nमा वधीस्तद्बलं भीम गुरुदानं प्रदीयताम् \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2114299, "chapter_id": 3458, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2114300, "chapter_id": 3458, "verse_number": "७३", "content_sanskrit": "भीमसेनस्तदा राजन्नर्जुनेन निवारितः ।\nअतृप्तो युद्धधर्मेषु न्यवर्तत महारथः \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2114301, "chapter_id": 3458, "verse_number": "७४", "content_sanskrit": "ते यज्ञसेनं द्रुपदं गृहीत्वा रणमूर्धनि ।\nउपजह्रुः सहामात्यं द्रोणाय भरतर्षभाः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2114302, "chapter_id": 3458, "verse_number": "७५", "content_sanskrit": "भग्नदर्पं हृतधनं तथा वशमुपागतम् ।\nस वैरं मनसा ध्यात्वा द्रोणो द्रुपदमब्रवीत् \t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2114303, "chapter_id": 3458, "verse_number": "७६", "content_sanskrit": "प्रमृज्य तरसा राष्ट्रं पुरं ते मृदितं मया ।\nप्राप्य जीवन् रिपुवशं सखिपूर्वं किमिष्यते\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2114304, "chapter_id": 3458, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2114305, "chapter_id": 3458, "verse_number": "७७", "content_sanskrit": "एवमुक्त्वा प्रहस्यैनं निश्चित्य पुनरब्रवीत् ।\nमा भैः प्राणभयाद् राजन् क्षमिणो ब्राह्मणा वयम् \t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2114306, "chapter_id": 3458, "verse_number": "७८", "content_sanskrit": "आश्रमे क्रीडितं यत् तु त्वया बाल्ये मया सह ।\nतेन संवर्धितो हर्षस्त्वया मे क्षत्रियर्षभ \t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2114307, "chapter_id": 3458, "verse_number": "७९", "content_sanskrit": "प्रार्थयेऽहं त्वया सख्यं पुनरेव नरेश्वर ।\nवरं ददामि ते राजन् राज्यस्यार्धमवाप्नुहि\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2114308, "chapter_id": 3458, "verse_number": "८०", "content_sanskrit": "अराजा किल नो राज्ञः सखा भवितुमर्हति ।\nअतः प्रयतितं राज्ये यज्ञसेन मया तव\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2114309, "chapter_id": 3458, "verse_number": "८१", "content_sanskrit": "राजाऽसि दक्षिणे कूले भागीरथ्याऽहमुत्तरे ।\nसखायं मां विजानीहि पाञ्चाल यदि मन्यसे\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2114310, "chapter_id": 3458, "verse_number": "", "content_sanskrit": "द्रुपदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2114311, "chapter_id": 3458, "verse_number": "८२", "content_sanskrit": "अनाश्चर्यमिदं ब्रह्मन् विक्रान्तेषु महात्मसु ।\nप्रीये त्वयाऽहं त्वत्तश्च प्रीतिमिच्छामि शाश्वतीम् \t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2114312, "chapter_id": 3458, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2114313, "chapter_id": 3458, "verse_number": "८३", "content_sanskrit": "एवमुक्तस्तु तं द्रोणो मोक्षयामास भारत ।\nसत्कृत्य चैनं प्रीतात्मा राज्यार्धं प्रत्यपादयत्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2114314, "chapter_id": 3458, "verse_number": "८४", "content_sanskrit": "आसन्दीमथ गङ्गायास्तीरे जनपदायुताम् ।\nसोऽध्यावसद् दीनमनाः काम्पिल्यं च पुरोत्तमम् \t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2114315, "chapter_id": 3458, "verse_number": "८५", "content_sanskrit": "दक्षिणांश्चैव पाञ्चालान् यावच्चर्मण्वतीं नदीम् ।\nअहिच्छत्रं च विषयं भारद्वाजोऽभ्यपद्यत\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2114316, "chapter_id": 3458, "verse_number": "८६", "content_sanskrit": "एवं राज्यमहिच्छत्रं पुरा बहुधनान्वितम् ।\nयुधा निर्जित्य पार्थेन द्रोणाय प्रतिपादितम् \t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2114317, "chapter_id": 3458, "verse_number": "१३७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nसप्तत्रिंशत्यधिकशततमोऽध्यायः ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2114318, "chapter_id": 3458, "verse_number": "८५", "content_sanskrit": "॥ इति सम्भवपर्वणि पञ्चाशीतितमोऽध्यायः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2114319, "chapter_id": 3458, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}]