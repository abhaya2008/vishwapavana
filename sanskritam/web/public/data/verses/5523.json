[{"id": 2212354, "chapter_id": 5523, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212355, "chapter_id": 5523, "verse_number": "१", "content_sanskrit": "कीदृशानां तु शूद्राणां नानुगृह्णासि चार्चनम् ।\nउद्वेगस्तव कस्माद्धि तन्मे ब्रूहि सुरेश्वर ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212356, "chapter_id": 5523, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212357, "chapter_id": 5523, "verse_number": "२", "content_sanskrit": "अव्रतेनाप्यभक्तेन स्पृष्टां शूद्रेण चार्चनाम् ।\nतां वर्जयामि राजेन्द्र श्वपाकविहितामिव ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212358, "chapter_id": 5523, "verse_number": "३", "content_sanskrit": "अहं च शङ्करश्चापि गावो विप्रास्तथैव च ।\nअश्वत्थोऽमररूपं च त्रयमेतद् युधिष्ठिर ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212359, "chapter_id": 5523, "verse_number": "४", "content_sanskrit": "एतत् त्रयं हि मद्भक्तो नावमन्येत कर्हिचित् ।\nअवमानितमेतत्तु दहत्यासप्तमं कुलम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2212360, "chapter_id": 5523, "verse_number": "५", "content_sanskrit": "अश्वत्थो ब्राह्मणा गावो मन्मयास्तारयन्ति हि ।\nतस्मादेतत् प्रयत्नेन त्रयं पूजय पाण्डव ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2212361, "chapter_id": 5523, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2212362, "chapter_id": 5523, "verse_number": "६", "content_sanskrit": "ब्राह्मणेनैव देहेन शूद्रत्वं कथमाप्नुयात् ।\nब्रह्म वा नश्यति कथं वक्तुं देव त्वमर्हसि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2212363, "chapter_id": 5523, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2212364, "chapter_id": 5523, "verse_number": "७", "content_sanskrit": "कूपस्नानं तु यो विप्रः कुर्याद् द्वादशवार्षिकम् ।\nस तेनैव शरीरेण शूद्रत्वं यात्यसंशयः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2212365, "chapter_id": 5523, "verse_number": "८", "content_sanskrit": "यस्तु राजाश्रयेणैव जीवेद् द्वादशवार्षिकम् ।\nस शूद्रत्वं व्रजेद् विप्रो वेदानां पारगतोऽपि सन् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2212366, "chapter_id": 5523, "verse_number": "९", "content_sanskrit": "पत्तने नगरे वाऽपि यो द्वादश समा वसेत् ।\nस शूद्रत्वं व्रजेद् विप्रो नात्र कार्या विचारणा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2212367, "chapter_id": 5523, "verse_number": "१०", "content_sanskrit": "उत्पादयति यः पुत्रं शूद्रायां कामतो द्विजः ।\nतस्य कायगतं ब्रह्म सद्य एव विनश्यति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2212368, "chapter_id": 5523, "verse_number": "११", "content_sanskrit": "मद्यपस्त्रीमुखं मोहाद् आस्वादयति यो द्विजः ।\nतस्य कायगतं ब्रह्म सद्य एव विनश्यति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2212369, "chapter_id": 5523, "verse_number": "१२", "content_sanskrit": "यः सोमलतिकां विप्रः केवलं भक्षयेद् वृथा ।\nतस्य कायगतं ब्रह्म सद्य एव विनश्यति ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2212370, "chapter_id": 5523, "verse_number": "१३", "content_sanskrit": "मैथुनं कुरुते यस्तु जिह्वायां ब्राह्मणो नृप ।\nतस्य कायगतं ब्रह्म सद्य एव विनश्यति ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2212371, "chapter_id": 5523, "verse_number": "१४", "content_sanskrit": "विप्रत्वं दुर्लभं प्राप्य दुर्मार्गैरेवमादिभिः ।\nविनाशयन्ति ये तत्तु तान् शोचामि युधिष्ठिर ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2212372, "chapter_id": 5523, "verse_number": "१५", "content_sanskrit": "तस्मात् सर्वप्रयत्नेन मत्प्रियो यो युधिष्ठिर ।\nजातिभ्रंशकरं कर्म न कुर्यादीदृशं द्विजः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2212373, "chapter_id": 5523, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्वमेधिकपर्वणि वैष्णवधर्मशास्त्रे ब्राह्मणजन्मनि शूद्रत्वप्राप्तिकथनं नाम सप्तदशोत्तरशततमोऽध्यायः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]