[{"id": 2207265, "chapter_id": 5418, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2207266, "chapter_id": 5418, "verse_number": "१", "content_sanskrit": "द्विविधो जायते व्याधिः शारीरो मानसस्तथा ।\nपरस्परं तयोर्जन्म निर्द्वन्द्वं नोपलभ्यते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2207267, "chapter_id": 5418, "verse_number": "२", "content_sanskrit": "शरीराज्जायते व्याधिः शारीरो नात्र संशयः ।\nमानसो जायते व्याधिः मनस्येवेति निश्चयः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2207268, "chapter_id": 5418, "verse_number": "३", "content_sanskrit": "शीतोष्णे चैव वायुश्च गुणा राजन् शरीरजाः ।\nतेषां गुणानां साम्यं चेत् तदाहुः स्वस्थलक्षणम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2207269, "chapter_id": 5418, "verse_number": "४", "content_sanskrit": "उष्णेन बाध्यते शीतं शीतेनोष्णं च बाध्यते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2207270, "chapter_id": 5418, "verse_number": "५", "content_sanskrit": "सत्वं रजस्तमश्चेति त्रयः स्वात्मगुणाः स्मृताः ।\nतेषां गुणानां साम्यं चेत् तदाहुः स्वस्थलक्षणम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2207271, "chapter_id": 5418, "verse_number": "६", "content_sanskrit": "तेषामन्यतमोत्सेके विधानमुपदिश्यते ।\nहर्षेण वध्यते शोको हर्षः शोकेन वध्यते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2207272, "chapter_id": 5418, "verse_number": "७", "content_sanskrit": "कश्चिद् दुःखे वर्तमानः सुखस्य स्मर्तुमर्हति ।\nकश्चित् सुखे वर्तमानो दुःखस्य स्मर्तुमर्हति\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2207273, "chapter_id": 5418, "verse_number": "८", "content_sanskrit": "स त्वं न दुःखी दुःखस्य न सुखी त्वं सुखस्य च ।\nस्मर्तुमिच्छसि कौन्तेय दैवं हि बलवत्तरम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2207274, "chapter_id": 5418, "verse_number": "९", "content_sanskrit": "अथवा ते स्वभावोऽयं येन पार्थावकृष्यसे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2207275, "chapter_id": 5418, "verse_number": "१०", "content_sanskrit": "दृष्ट्वा सभागतां कृष्णामेकवस्त्रां रजस्वलाम् ।\nमिषतां पाण्डवेयानां न तत् संस्मर्तुमर्हसि\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2207276, "chapter_id": 5418, "verse_number": "११", "content_sanskrit": "प्रव्राजनं च नगराद् अजिनैश्च विवासनम् ।\nमहारण्यनिवासं च न तस्य स्मर्तुमर्हसि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2207277, "chapter_id": 5418, "verse_number": "१२", "content_sanskrit": "जटासुरात् परिक्लेशं चित्रसेनेन चाहवम् ।\nसैन्धवाच्च परिक्लेशं न तस्य स्मर्तुमिच्छसि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2207278, "chapter_id": 5418, "verse_number": "१३", "content_sanskrit": "पुनरज्ञातचर्यायां कीचकेन पदा वधम् ।\nयाज्ञसेन्यास्तथा पार्थ न तस्य स्मर्तुमिच्छसि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2207279, "chapter_id": 5418, "verse_number": "१४", "content_sanskrit": "यच्च ते द्रोणभीष्माभ्यां युद्धमासीदरिन्दम ।\nमनसैकेन बोद्धव्यं तत् ते युद्धमुपस्थितम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2207280, "chapter_id": 5418, "verse_number": "१५", "content_sanskrit": "तस्मादभ्युपगन्तव्यं युद्धाय भरतर्षभ ।\nपारमव्यक्तरूपस्य परं मुक्त्या स्वकर्मभिः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2207281, "chapter_id": 5418, "verse_number": "१६", "content_sanskrit": "यत्र नैव शरैः कार्यं न भृत्यैः न च बन्धुभिः ।\nआत्मनैकेन कर्तव्यं तत् ते युद्धमुपस्थितम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2207282, "chapter_id": 5418, "verse_number": "१७", "content_sanskrit": "तस्मिन्ननिर्जिते युद्धे कामवस्थां गमिष्यसि ।\nएतज्ज्ञात्वा तु कौन्तेय कृतकृत्यो भविष्यसि\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2207283, "chapter_id": 5418, "verse_number": "१८", "content_sanskrit": "एतां बुद्धिं विनिश्चित्य भूतानामागतिं गतिम् ।\nपितृपैतामहे वृत्ते शाधि राज्यं यथोचितम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2207284, "chapter_id": 5418, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि कृष्णवचनं नाम द्वादशोऽध्यायः ॥१२॥\nअश्वमेधपर्वणि द्वादशोऽध्यायः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]