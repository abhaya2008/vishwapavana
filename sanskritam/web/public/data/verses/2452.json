[{"id": 2069347, "chapter_id": 2452, "verse_number": "१०-४-०x", "content_sanskrit": "कृप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2069348, "chapter_id": 2452, "verse_number": "१०-४-१", "content_sanskrit": "दिष्ट्या ते प्रतिकर्तव्ये मतिर्जातेयमच्युत।\nन त्वां वारयितुं शक्तो वज्रपाणिरपि स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2069349, "chapter_id": 2452, "verse_number": "१०-४-२", "content_sanskrit": "अनुयास्यावहे त्वां तु प्रभाते सहितावुभौ।\nअद्य रात्रौ विश्रमस्व विमुक्तकवचध्वजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2069350, "chapter_id": 2452, "verse_number": "१०-४-३", "content_sanskrit": "अहं त्वामनुयास्यामि कृतवर्मा च सात्वतः।\nपरानभिमुखं यान्तं रथावास्थाय दंशितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2069351, "chapter_id": 2452, "verse_number": "१०-४-४", "content_sanskrit": "आवाभ्यां सहितः शत्रूञ्श्वो निहन्ता समागमे।\nविक्रम्य रथिनां श्रेष्ठ पाञ्चालान्सपदानुगान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2069352, "chapter_id": 2452, "verse_number": "१०-४-५", "content_sanskrit": "शक्तस्त्वमसि विक्रम्य विश्रमस्व निशामिमाम्।\nचिरं ते जाग्रतस्तात स्वप तावन्निशामिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2069353, "chapter_id": 2452, "verse_number": "१०-४-६", "content_sanskrit": "विश्रान्तश्च विनिद्रश्च स्वस्थचित्तश्च मानद।\nसमेत्य समरे शत्रून्वधिष्यसि न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2069354, "chapter_id": 2452, "verse_number": "१०-४-७", "content_sanskrit": "न हि त्वां रथिनां श्रेष्ठं प्रगृहीतवरायुधम्।\nजेतुमुत्सहते कश्चिदपि देवेषु पावकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2069355, "chapter_id": 2452, "verse_number": "१०-४-८", "content_sanskrit": "कृपेण सहितं यान्तं गुप्तं च कृतवर्मणा।\nको द्रौणिं युधि संरब्धं योधयेदपि देवराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2069356, "chapter_id": 2452, "verse_number": "१०-४-९", "content_sanskrit": "ते वयं निशि विश्रान्ता विनिद्रा विगतज्वराः।\nप्रभातायां रजन्यां वै निहनिष्याम शात्रवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2069357, "chapter_id": 2452, "verse_number": "१०-४-१०", "content_sanskrit": "तव ह्यस्त्राणि दिव्यानि मम चैव न संशयः।\nसात्वतोपि महेष्वासो नित्यं युद्धेषु कोविदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2069358, "chapter_id": 2452, "verse_number": "१०-४-११", "content_sanskrit": "ते वयं सहितास्तात सर्वाञ्शत्रून्समागतान्।\nप्रसह्य समरे हत्वा प्रीतिं प्राप्स्याम पुष्कलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2069359, "chapter_id": 2452, "verse_number": "१०-४-१२", "content_sanskrit": "विश्रमस्व त्वमव्यग्रः स्वप चेमां निशां सुखम्।\nअहं च कृतवर्मा च प्रभाते त्वां नरोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2069360, "chapter_id": 2452, "verse_number": "१०-४-१३", "content_sanskrit": "अनुयास्याव सहितौ धन्विनौ परतापनौ।\nरथिनं त्वरया यान्तं रथमास्थाय दंशितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2069361, "chapter_id": 2452, "verse_number": "१०-४-१४", "content_sanskrit": "स गत्वा शिबिरं तेषां नाम विश्राव्य चाहवे।\nततः कर्ताऽसि शत्रूणां युध्यतां कदनं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2069362, "chapter_id": 2452, "verse_number": "१०-४-१५", "content_sanskrit": "कृत्वा च कदनं तेषां प्रभाते विमलेऽहनि।\nविहरस्व यथा शक्रः सूदयित्वा महासुरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2069363, "chapter_id": 2452, "verse_number": "१०-४-१६", "content_sanskrit": "त्वं हि शक्तो रणे जेतुं पाञ्चालानां वरूथिनीम्।\nदैत्यसेनामिव क्रुद्धः सर्वदानवसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2069364, "chapter_id": 2452, "verse_number": "१०-४-१७", "content_sanskrit": "मया त्वां सहितं सङ्ख्ये गुप्तं च कृतवर्मणा।\nन सहेत विभुः साक्षाद्वज्रपाणिरपि स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2069365, "chapter_id": 2452, "verse_number": "१०-४-१८", "content_sanskrit": "न चाहं समरे तात कृतवर्मा न चैव हि।\nअनिर्जित्य रणे पाण्डूनपयास्यामि कर्हिचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2069366, "chapter_id": 2452, "verse_number": "१०-४-१९", "content_sanskrit": "हत्वा च समरे क्षुद्रान्पाञ्चालान्पाण्डुभिः सह।\nनिवर्तिष्यामहे सर्वे हता वा स्वर्गगा वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2069367, "chapter_id": 2452, "verse_number": "१०-४-२०", "content_sanskrit": "सर्वोपायैः सहायास्ते प्रभाते वयमाहवे।\nसत्यमेतन्महाबाहो प्रब्रवीमि तवानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2069368, "chapter_id": 2452, "verse_number": "१०-४-२१", "content_sanskrit": "एवमुक्तस्ततो द्रौणिक्रमातुलेन हितं वचः।\nअब्रवीन्मातुलं राजन्क्रोधादुद्वृत्य लोचने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2069369, "chapter_id": 2452, "verse_number": "१०-४-२२", "content_sanskrit": "आतुरस्य कुतो निद्रा नरस्यामर्षितस्य च।\nअर्थांश्चिन्तयतश्चापि कामयानस्य वा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2069370, "chapter_id": 2452, "verse_number": "१०-४-२३", "content_sanskrit": "तदिदं समनुप्राप्तं पश्य मेऽद्य चतुष्टयम्।\nयस्य भागश्चतुर्थो मे स्वप्नमह्नाय नाशयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2069371, "chapter_id": 2452, "verse_number": "१०-४-२४", "content_sanskrit": "किं नाम दुःखं लोकेऽस्मिन्पितुर्वधमनुस्मरन्।\nहृदयं निर्दहन्मेऽद्य रात्र्यहानि न शाम्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2069372, "chapter_id": 2452, "verse_number": "१०-४-२५", "content_sanskrit": "यथा च निहतः पापैः पिता मम विशेषतः।\nप्रत्यक्षमपि ते सर्वं तन्मे मर्माणि कृन्तति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2069373, "chapter_id": 2452, "verse_number": "१०-४-२६", "content_sanskrit": "कथं हि मादृशो लोके मुहूर्तमपि जीवति।\nद्रोणहन्तेति यद्वाचः पाञ्चालानां शृणोम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2069374, "chapter_id": 2452, "verse_number": "१०-४-२७", "content_sanskrit": "धृष्टद्युम्नमहत्वा तु नादं जीवितुमुत्सहे।\nस मे पितुर्वधाद्वध्यः पाञ्चाला ये च सङ्गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2069375, "chapter_id": 2452, "verse_number": "१०-४-२८", "content_sanskrit": "विलापो भग्नसक्थस्य यस्तु राज्ञो मया श्रुतः।\nस पुनर्हृदयं कस्य क्रूरस्यापि न निर्दहेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2069376, "chapter_id": 2452, "verse_number": "१०-४-२९", "content_sanskrit": "कस्य ह्यकरुणस्यापि नेत्राभ्यामश्रु नाव्रजेत्।\nनृपतेर्भग्नसक्थस्य श्रुत्वा तादृग्वचः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2069377, "chapter_id": 2452, "verse_number": "१०-४-३०", "content_sanskrit": "यश्चायं मित्रपक्षो मे मयि जीवति निर्जितः।\nशोकं मे वर्धयत्येष वारिवेग इवार्णवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2069378, "chapter_id": 2452, "verse_number": "१०-४-३१", "content_sanskrit": "एकाग्नमनसो मेऽद्य कुतो निद्रा कुतः सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2069379, "chapter_id": 2452, "verse_number": "१०-४-३२", "content_sanskrit": "वासुदेवार्जुनाभ्यां च तानहं परिरक्षितान्।\nअविषह्यतमान्मन्ये महेन्द्रेणापि सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2069380, "chapter_id": 2452, "verse_number": "१०-४-३३", "content_sanskrit": "न चापि शक्तः संयन्तुमस्मात्कार्यात्कथञ्चन।\nतं न पश्यामि लोकेऽस्मिन्यो मां कोपान्निवर्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2069381, "chapter_id": 2452, "verse_number": "१०-४-३४", "content_sanskrit": "इति मे निश्चिता बुद्धिरेषा साधुमता मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2069382, "chapter_id": 2452, "verse_number": "१०-४-३५", "content_sanskrit": "वादिकैः कथ्यमानस्तु मित्राणां मे पराभवः।\nपाण्डवानां च विजयटो हृदयं दहतीव मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2069383, "chapter_id": 2452, "verse_number": "१०-४-३६", "content_sanskrit": "अहं तु कदनं कृत्वा शत्रूणामद्य सौप्तिके।\nततो विश्रमिता चैव स्वप्ता च विगतज्वरः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2069384, "chapter_id": 2452, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सौप्तिकपर्वणि चतुर्थोऽध्यायः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]