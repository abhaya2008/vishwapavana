[{"id": 7006409000, "chapter_id": 26409, "verse_number": "२-६७-१", "content_sanskrit": "वैशम्पायन उवाच\nनारायणः सत्यभामां पुनरेवैष भारत ।\nप्रोवाच प्रणयात् क्रुद्धामभिमानवतीं सतीम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006409001, "chapter_id": 26409, "verse_number": "२-६७-२", "content_sanskrit": "श्रीभगवानुवाच\nदहतीव ममाङ्गानि शोकः कमललोचने ।\nकिमु तत् कारणं येन त्वमेवमतिविक्लवा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006409002, "chapter_id": 26409, "verse_number": "२-६७-३", "content_sanskrit": "शापितासि मम प्राणैराचक्ष्वानत्ययो यदि ।\nश्रोतव्यं यदि भक्तेन भर्त्रा सर्वाङ्गशोभने ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006409003, "chapter_id": 26409, "verse_number": "२-६७-४", "content_sanskrit": "ततः प्रोवाच भर्तारं सत्या सत्यव्रते स्थितम् ।\nबाष्पगद्गदया वाचा तथैनैधोमुखी स्थिता ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006409004, "chapter_id": 26409, "verse_number": "२-६७-५", "content_sanskrit": "त्वयैव स्थापितं पूर्वं सौभाग्यं मम मानद ।\nजगत्यमलपत्राक्ष यत् ख्यातं केशिनाशन ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006409005, "chapter_id": 26409, "verse_number": "२-६७-६", "content_sanskrit": "शिरो वहामि चेष्टत्वात् तवाहं देव गर्विता ।\nसर्वसीमन्तिनीमध्ये स्पृहणीयास्मि सर्वथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006409006, "chapter_id": 26409, "verse_number": "२-६७-७", "content_sanskrit": "साहमद्यावहास्यास्मि सपत्नीनां जनस्य च ।\nइति प्रेष्याभिराख्यातं श्रुत्वा तथ्यं ततस्ततः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006409007, "chapter_id": 26409, "verse_number": "२-६७-८", "content_sanskrit": "यत् पारिजातकुसुमं दत्तवान् नारदस्तव ।\nतत् किलेष्टजने दत्तं त्वयाहं परिवर्जिता ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006409008, "chapter_id": 26409, "verse_number": "२-६७-९", "content_sanskrit": "रत्नातिशयदानेन तस्यामभ्यधिकः किल ।\nस्नेहश्च बहुमानश्च प्रकाशं गमितस्त्वया ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006409009, "chapter_id": 26409, "verse_number": "२-६७-१०", "content_sanskrit": "तामस्तौषीत् समक्षं ते प्रियां स किल नारदः ।\nतमश्रौषीश्च दृष्टस्त्वं प्रियायाः संस्तवं किल ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006409010, "chapter_id": 26409, "verse_number": "२-६७-११", "content_sanskrit": "स्तोतव्यो यदि तावत् स नारदेन तवाग्रतः ।\nदुर्भगोऽयं जनस्तत्र किमर्थमनुशब्दितः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006409011, "chapter_id": 26409, "verse_number": "२-६७-१२", "content_sanskrit": "प्रणयस्य रसं दत्त्वा पश्चात्तापः प्रभो यदि ।\nअनुज्ञां मे प्रयच्छस्व तपः कर्तुं प्रसीद मे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006409012, "chapter_id": 26409, "verse_number": "२-६७-१३", "content_sanskrit": "स्वप्नेनापि न दृष्ट्वाहं श्रद्दध्यां पुष्करेक्षण ।\nयदन्यदेव निर्वृत्तमश्रौषं पश्यतस्तव ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006409013, "chapter_id": 26409, "verse_number": "२-६७-१४", "content_sanskrit": "कामं कामोऽस्तु तस्यैव मुनेरतुलतेजसः ।\nअत्र मन्युस्तु मे देव सांनिध्यं तव तत्र यत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006409014, "chapter_id": 26409, "verse_number": "२-६७-१५", "content_sanskrit": "मानार्थं जीव्यते लोके सद्भिरित्युक्तवानसि ।\nतदेवं सति नेच्छामि जीवितुं मानवर्जिता ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006409015, "chapter_id": 26409, "verse_number": "२-६७-१६", "content_sanskrit": "ममाभवद् यतो रक्षा भयमद्य ततो मम ।\nसर्वतो रक्षते यो मां स मां नाद्याभिरक्षति ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006409016, "chapter_id": 26409, "verse_number": "२-६७-१७", "content_sanskrit": "हा गतिं कां गमिप्यामि त्यक्ता देव त्वया विभो ।\nकुमुद्वतीगतां नूनं गतिं यास्याम्यसंगता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006409017, "chapter_id": 26409, "verse_number": "२-६७-१८", "content_sanskrit": "किमकार्षमहं मोहादीश्वराणां प्रियाप्रियम् ।\nप्रिया भूत्वा प्रिया भूता यद्यहं तव मानद ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006409018, "chapter_id": 26409, "verse_number": "२-६७-१९", "content_sanskrit": "वसन्तकुसुमैश्चित्रं तदा रैवतकं गिरिम् ।\nप्रिया भूत्वाप्रिया भूता कथं द्रक्ष्याम्यहं पुनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006409019, "chapter_id": 26409, "verse_number": "२-६७-२०", "content_sanskrit": "परपुष्टस्वनोन्मिश्रं पुष्पगन्धवहं शुचिम् ।\nकथं नामानिलं द्वेष्या सेस्रेयं दुर्भगा सती ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006409020, "chapter_id": 26409, "verse_number": "२-६७-२१", "content_sanskrit": "जलक्रीडां तवाङ्कस्था देव कृत्वा महोदधौ ।\nकथं दौर्भाग्यमापन्ना पश्येयमपि सागरम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006409021, "chapter_id": 26409, "verse_number": "२-६७-२२", "content_sanskrit": "सात्राजिति प्रिया नान्या त्वत्तो मेऽस्तीति विद्धि माम्।\nयदवोचः क्व तद् यातमथ वा कः स्मरिष्यति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006409022, "chapter_id": 26409, "verse_number": "२-६७-२३", "content_sanskrit": "यदद्राक्षीद्धि मां श्वश्रूर्बहुमानेन नन्दिनी ।\nअवज्ञातां त्वया राज्ञीं नूनं दौर्भाग्यकर्शिताम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006409023, "chapter_id": 26409, "verse_number": "२-६७-२४", "content_sanskrit": "किं नु गूढेन मे प्रेम्णा सुस्निग्धैनापि मानद ।\nयत्समानां जनैर्देवो मां न पश्यति नित्यदा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006409024, "chapter_id": 26409, "verse_number": "२-६७-२५", "content_sanskrit": "नाहं त्वां कितवं धूर्तमज्ञासिषमरिंदम ।\nअद्य ज्ञातोऽसि तत्पक्षचञ्चलो जनवञ्चकः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006409025, "chapter_id": 26409, "verse_number": "२-६७-२६", "content_sanskrit": "स्वरवर्णेङ्गिताकारैर्निगूढो देव यत्नतः ।\nचौर ज्ञातोऽसि तत्पक्षवाङ्मात्रमधुरः शठः ॥ २६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006409026, "chapter_id": 26409, "verse_number": "२-६७-२७", "content_sanskrit": "एवमीर्ष्यावशं प्राप्तां देवीं सात्राजितीं हरिः ।\nअभिमानवतीं देवः सान्त्वपूर्वमथाब्रवीत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006409027, "chapter_id": 26409, "verse_number": "२-६७-२८", "content_sanskrit": "मैवं पद्मपलाशाक्षि प्राणेश्वरि वद प्रिये ।\nकिमत्र बहुनोक्तेन त्वदीयमवगच्छ माम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006409028, "chapter_id": 26409, "verse_number": "२-६७-२९", "content_sanskrit": "तत् पारिजातकुसुमं तस्या देवि ममाग्रतः ।\nनारदो मत्प्रियं कुर्वन् मुनिरक्लिष्टकर्मकृत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006409029, "chapter_id": 26409, "verse_number": "२-६७-३०", "content_sanskrit": "दाक्षिण्यादानुरोधाच्च दत्तवान् नात्र संशयः ।\nप्रसीदैकापराधं मे मर्षयस्य शुचिस्मिते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006409030, "chapter_id": 26409, "verse_number": "२-६७-३१", "content_sanskrit": "पारिजातकपुष्पाणि यदीच्छस्यतिकोपने ।\nतदा दातास्मि सुश्रोणि सत्यमेतद्ब्रवीमि तम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006409031, "chapter_id": 26409, "verse_number": "२-६७-३२", "content_sanskrit": "स्वर्गास्पदादानयित्वा पारिजातं द्रुमेश्वरम् ।\nगृहे ते स्थापयिष्यामि यावत्कालं त्वमिच्छसि ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006409032, "chapter_id": 26409, "verse_number": "२-६७-३३", "content_sanskrit": "एवमुक्ता तु हरिणा प्रोवाच हरिवल्लभा ।\nयद्येवं स द्रुमः शक्यस्त्विहानयितुमच्युत ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006409033, "chapter_id": 26409, "verse_number": "२-६७-३४", "content_sanskrit": "मन्युरेव प्रमृष्टो हि भवेद् बहुगुणं मम ।\nसीमन्तिनीनां सर्वासामधिका स्यामधोक्षज ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006409034, "chapter_id": 26409, "verse_number": "२-६७-३५", "content_sanskrit": "तथास्तु प्रथमः कल्प इति तां मधुसूदनः ।\nप्रोवाचाप्रतिमो देवो जगतः प्रभवाप्ययः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006409035, "chapter_id": 26409, "verse_number": "२-६७-३६", "content_sanskrit": "तथेत्युक्तेति कृष्णेन तुतोष समितिंजय ।\nसत्यभामा सतामिष्टा कंसनाशनवल्लभा ॥ ३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006409036, "chapter_id": 26409, "verse_number": "२-६७-३७", "content_sanskrit": "ततः स्नातो जगन्नाथः सर्वेशः सर्वभावनः ।\nचकारावश्यकं सर्वं सर्वकामप्रदः सताम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006409037, "chapter_id": 26409, "verse_number": "२-६७-३८", "content_sanskrit": "दध्यौ च नारदं देवः स्नातो देवमुनिर्नृप ।\nअभ्याजगाम स्नानान्ते मुनिश्रेष्ठो महोदधौ ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006409038, "chapter_id": 26409, "verse_number": "२-६७-३९", "content_sanskrit": "तमागतं नरपते सतां गतिरधोक्षजः ।\nसत्यया सह धर्मात्मा यथाविधि अपूजयत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006409039, "chapter_id": 26409, "verse_number": "२-६७-४०", "content_sanskrit": "पादौ प्रक्षालयाञ्चक्रे मुनेः सात्राजिती स्वयम् ।\nजलं देवः स्वयं कृष्णो भृङ्गारेण ददौ तदा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006409040, "chapter_id": 26409, "verse_number": "२-६७-४१", "content_sanskrit": "अथोपकल्पयामास सुखासीनाय केशवः ।\nपरमान्नं स मुनये प्रयतात्मा जगद्गुरुः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006409041, "chapter_id": 26409, "verse_number": "२-६७-४२", "content_sanskrit": "तल्लोककर्त्रा सत्कृत्य दत्तं मुनिरुदारधीः ।\nबुभुजे वदतां श्रेष्ठः श्रद्धया परया युतः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006409042, "chapter_id": 26409, "verse_number": "२-६७-४३", "content_sanskrit": "उपस्पृश्य ततस्तृप्तः प्रददौ चाशिषः प्रभो ।\nताश्च प्रीतेन मनसा प्रतिजग्राह केशवः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006409043, "chapter_id": 26409, "verse_number": "२-६७-४४", "content_sanskrit": "ततः सात्राजितीं देवीं प्रणतां नारदोऽब्रवीत् ।\nप्रसार्य दक्षिणं हस्तं सजलं जलजेक्षणाम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006409044, "chapter_id": 26409, "verse_number": "२-६७-४५", "content_sanskrit": "यथेदानीं तथैव त्वं भव देवि पतिव्रता ।\nसविशेषं च सुभगा भव मत्तपसो बलात् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006409045, "chapter_id": 26409, "verse_number": "२-६७-४६", "content_sanskrit": "इत्युक्ता मुनिमुख्येन सत्यभामा हरिप्रिया ।\nउत्तस्थौ महता युक्ता हर्षेण तु नराधिप ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006409046, "chapter_id": 26409, "verse_number": "२-६७-४७", "content_sanskrit": "स कृष्णोऽप्यभ्यनुज्ञां तु लब्ध्वा मुनिवरात्तदा।\nबुभुजे विघसं धीमानप्रमेयपराक्रमः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006409047, "chapter_id": 26409, "verse_number": "२-६७-४८", "content_sanskrit": "ततस्त्वावश्यकं कृत्वा सत्यभामापि भारत ।\nअनुज्ञया तदा भर्तुर्विवेशान्तर्गृहं मुदा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006409048, "chapter_id": 26409, "verse_number": "२-६७-४९", "content_sanskrit": "ततो विनिर्गता देवी कृष्णस्यैवाभ्यनुज्ञया ।\nस्थिता पार्श्वे च कृष्णस्य नमस्कृत्वा महात्मने ॥ ४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006409049, "chapter_id": 26409, "verse_number": "२-६७-५०", "content_sanskrit": "ततो मुहूर्तमासित्वा नारदः कृष्णमब्रवीत् ।\nआपृच्छे त्वां गमिष्यामि शक्रलोकमधोक्षज ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006409050, "chapter_id": 26409, "verse_number": "२-६७-५१", "content_sanskrit": "तत्राद्यं देवमीशानं नमस्कृत्य महेश्वरम् ।\nगास्यन्ति देवगन्धर्वास्तथैवाप्सरसां गणाः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006409051, "chapter_id": 26409, "verse_number": "२-६७-५२", "content_sanskrit": "मासि मास्युचितं ह्येतन्महेन्द्रसदने प्रभो ।\nपूजार्थं देवदेवस्य गान्धर्वं नृत्यमेव च ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006409052, "chapter_id": 26409, "verse_number": "२-६७-५३", "content_sanskrit": "अन्तर्हितो देवदेवः सोमः सप्रवरो विभुः ।\nपश्यत्यमरमुख्येन कृतं भक्त्याद्रिघातिना ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006409053, "chapter_id": 26409, "verse_number": "२-६७-५४", "content_sanskrit": "निमन्त्रितोऽहं पूर्वेद्युः पुष्पं दत्त्वा महाद्युते ।\nपारिजातस्य भद्रं ते तरुराज्ञो महात्मनः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006409054, "chapter_id": 26409, "verse_number": "२-६७-५५", "content_sanskrit": "यदेतदाहृतं स्वर्गात् त्वदर्थं तु मया विभो ।\nदेवोपभोग्यमेतद्धि तरुराजसमुद्भवम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006409055, "chapter_id": 26409, "verse_number": "२-६७-५६", "content_sanskrit": "इष्टः स वृक्षः सततं शच्याः पुष्करलोचन ।\nसौभाग्यमावहत्येव पूज्यमानोऽपि नित्यशः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006409056, "chapter_id": 26409, "verse_number": "२-६७-५७", "content_sanskrit": "पुण्यं कर्तुं तदा सृष्टः पारिजातो महाद्रुमः ।\nअदित्या धर्मनित्येन कश्यपेन महात्मना ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006409057, "chapter_id": 26409, "verse_number": "२-६७-५८", "content_sanskrit": "पुरादित्या महातेजास्तोषितः किल कश्यपः ।\nवरेण च्छन्दयामास मारीचस्तपसो निधिः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006409058, "chapter_id": 26409, "verse_number": "२-६७-५९", "content_sanskrit": "सोवाच सुभगा येन भवेयं मुनिसत्तम ।\nस्वलंकृता कामतश्च सर्वैरेव विभूषणैः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006409059, "chapter_id": 26409, "verse_number": "२-६७-६०", "content_sanskrit": "ईप्सितं गीतनृत्यं च भवेन्मम तपोधन ।\nकुमारी नित्यदा चैव भवेयं तपसो निधे ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006409060, "chapter_id": 26409, "verse_number": "२-६७-६१", "content_sanskrit": "विरजा शोकरहिता भवेयमिति नित्यदा ।\nपतिभक्तिमती चैव धर्मशीला तथैव च ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006409061, "chapter_id": 26409, "verse_number": "२-६७-६२", "content_sanskrit": "पारिजातं ततोऽस्राक्षीददित्याः प्रियकाम्यया ।\nसर्वकामप्रदैः पुष्पैरावृतं नित्यगन्धदैः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006409062, "chapter_id": 26409, "verse_number": "२-६७-६३", "content_sanskrit": "त्रिशाखं सर्वदा दृश्यं सर्वभूतमनोहरम् ।\nसर्वपुष्पाणि दृश्यन्ते तस्मिन्नेव महाद्रुमे ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006409063, "chapter_id": 26409, "verse_number": "२-६७-६४", "content_sanskrit": "ईदृशान्यपि पुष्पाणि बिभर्त्येकापि रूपिणी ।\nबहुरूपाणि चाप्यन्या पद्मानि च ततोऽपरा ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006409064, "chapter_id": 26409, "verse_number": "२-६७-६५", "content_sanskrit": "मन्दारादपि वृक्षाच्च सारमुद्धत्य कश्यपः ।\nतस्मादेष तरुश्रेष्ठः सर्वेषां श्रेष्ठतां गतः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006409065, "chapter_id": 26409, "verse_number": "२-६७-६६", "content_sanskrit": "ततस्तत्र निबध्याथ कश्यपं प्रददौ शुभा ।\nअदितिर्मम पुण्यार्थं सौभाग्यार्थं तथैव च ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006409066, "chapter_id": 26409, "verse_number": "२-६७-६७", "content_sanskrit": "अदित्या कश्यपो दत्तः पुण्यार्थं च तथा मम ।\nपुष्पदाम्ना वेष्टयित्वा कण्ठे पुण्यार्थमात्मवान् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006409067, "chapter_id": 26409, "verse_number": "२-६७-६८", "content_sanskrit": "निष्क्रयेण मया मुक्तः कश्यपस्तु तपोधनः ।\nइन्द्रो दत्तस्तथेन्द्राण्या सौभाग्यार्थं ततो मम ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006409068, "chapter_id": 26409, "verse_number": "२-६७-६९", "content_sanskrit": "सोमश्चाप्यथ रोहिण्या ऋद्ध्या च धनदस्तथा ।\nएवं सौभाग्यदो वृक्षः पारिजातो न संशयः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006409069, "chapter_id": 26409, "verse_number": "२-६७-७०", "content_sanskrit": "परि जातो विष्णुपद्याः पारिजातेतिशब्दितः ।\nमन्दारपुष्पैर्यद्युक्तो मन्दारस्तेन कथ्यते ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006409070, "chapter_id": 26409, "verse_number": "२-६७-७१", "content_sanskrit": "कोऽप्ययं दारुरित्याहुरजानन्तो यतो जनाः ।\nकोविदार इति ख्यातस्ततः स सुमहातरुः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006409071, "chapter_id": 26409, "verse_number": "२-६७-७२", "content_sanskrit": "मन्दारः कोविदारश्च पारिजातश्च नामभिः ।\nस वृक्षो ज्ञायते दिव्यो यस्यैतत्कुसुमोत्तमम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]