[{"id": 2091661, "chapter_id": 2950, "verse_number": "१३-८०-१", "content_sanskrit": "युधिष्ठिर उवाच\nकन्यायां प्राप्तशुल्कायां पतिश्चेन्नास्ति कश्चन।\nतत्र का प्रतिपत्तिः स्यात्तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2091662, "chapter_id": 2950, "verse_number": "१३-८०-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2091663, "chapter_id": 2950, "verse_number": "१३-८०-२", "content_sanskrit": "या पुत्रकस्य ऋद्धस्य प्रतिपाल्या तदा भवेत्।\nअथवा सा हरेच्छुल्कं क्रीता शुल्कप्रदस्य सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2091664, "chapter_id": 2950, "verse_number": "१३-८०-३", "content_sanskrit": "तस्यार्थेऽपत्यमीहेव येन न्यायेन शक्नुयात्।\nन तस्मान्मन्त्रवत्कार्यं कश्चित्कुर्वीत किञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2091665, "chapter_id": 2950, "verse_number": "१३-८०-४", "content_sanskrit": "स्वयंवृतेन साज्ञप्ता पित्रा वै प्रत्यपद्यत।\nतत्तस्यान्ये प्रशंसन्ति धर्मज्ञा नेतरे जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2091666, "chapter_id": 2950, "verse_number": "१३-८०-५", "content_sanskrit": "एतत्तु नापरे चक्रुरपरे जातु साधवः।\nसाधूनां पुनराचारो गरीयान्धर्मलक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2091667, "chapter_id": 2950, "verse_number": "१३-८०-६", "content_sanskrit": "अस्मिन्नेव प्रकारे तुसुक्रतुर्वाक्यमब्रवीत्।\nनप्ता विदेहराजस्य जनकस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2091668, "chapter_id": 2950, "verse_number": "१३-८०-७", "content_sanskrit": "असदाचरिते मार्गे कथं स्यादनुकीर्तनम्।\nअनुप्रश्नः संशयो वा सतामेवमुपालभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2091669, "chapter_id": 2950, "verse_number": "१३-८०-८", "content_sanskrit": "असदेव हि धर्मस्य प्रदानं धर्म आसुरः।\nनानुशुश्रुम जात्वेनामिमां पूर्वेषु कर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2091670, "chapter_id": 2950, "verse_number": "१३-८०-९", "content_sanskrit": "भार्यापत्योर्हि सम्बन्धः स्त्रीपुंसोस्तुल्य एव तु।\nरतिः साधारणो धर्म इति चाह स पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2091671, "chapter_id": 2950, "verse_number": "१३-८०-१०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2091672, "chapter_id": 2950, "verse_number": "१३-८०-१०", "content_sanskrit": "अथ केन प्रमाणेन पुंसामादीयते धनम्।\nपुत्रवद्धि पितुस्तस्य कन्या भवितुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2091673, "chapter_id": 2950, "verse_number": "१३-८०-११x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2091674, "chapter_id": 2950, "verse_number": "१३-८०-११", "content_sanskrit": "यथैवात्मा तथा पुत्रः पुत्रेण दुहिता समा।\nतस्यामात्मनि तिष्ठन्त्यां कथमन्यो धनं हरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2091675, "chapter_id": 2950, "verse_number": "१३-८०-१२", "content_sanskrit": "मातुश्च यौतकं यत्स्यात्कुमारीभाग एव सः।\nदौहित्र एव तद्रिक्थमपुत्रस्य पितुर्हरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2091676, "chapter_id": 2950, "verse_number": "१३-८०-१३", "content_sanskrit": "ददाति हि स पिण्डान्वै पितुर्मातामहस्य च।\nपुत्रदौहित्रयोरेव विशेषो नास्ति धर्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2091677, "chapter_id": 2950, "verse_number": "१३-८०-१४", "content_sanskrit": "अन्यत्र जामया सार्धं प्रजानां पुत्र ईहते।\nदुहिताऽन्यत्र जातेन पुत्रेणापि विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2091678, "chapter_id": 2950, "verse_number": "१३-८०-१५", "content_sanskrit": "दौहित्रकेण धर्मेण तत्र पश्यामि कारणम्।\nविक्रीतासु हि ये पुत्रा भवन्ति पितुरेव ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2091679, "chapter_id": 2950, "verse_number": "१३-८०-१६", "content_sanskrit": "असूयवस्त्वधर्मिष्ठाः परस्वादायिनः शठाः।\nआसुरादधिसम्भूता धर्माद्विषमवृत्तयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2091680, "chapter_id": 2950, "verse_number": "१३-८०-१७", "content_sanskrit": "अत्र गाथा यमोद्गीताः कीर्तयन्ति पुराविदः।\nधर्मज्ञा धर्मशास्त्रेषु निबद्धा धर्मसेतुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2091681, "chapter_id": 2950, "verse_number": "१३-८०-१८", "content_sanskrit": "यो मनुष्यः स्वकं पुत्रं विक्रीय धनमिच्छति।\nकन्यां वा जीवितार्थाय यः शुल्केन प्रयच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2091682, "chapter_id": 2950, "verse_number": "१३-८०-१९", "content_sanskrit": "सप्तावरे महाघोरे निरये कालसाह्वये।\nस्वेदं मूत्रं पुरीषं च तस्मिन्मूढः समश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2091683, "chapter_id": 2950, "verse_number": "१३-८०-२०", "content_sanskrit": "आर्षे गोमिथुनं शुल्कं केचिदाहुर्मृषैव तत्।\nअल्पो वा बहु वा राजन्विक्रयस्तावदेव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2091684, "chapter_id": 2950, "verse_number": "१३-८०-२१", "content_sanskrit": "यद्यप्याचरितः कैश्चिन्नैष धर्मः सनातनः।\nअन्येषामपि दृश्यन्ते लोभतः सम्प्रवृत्तयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2091685, "chapter_id": 2950, "verse_number": "१३-८०-२२", "content_sanskrit": "वश्यां कुमारीं बलतो ये तां समुपभुञ्जते।\nएते पापस्य कर्तारस्तमस्यन्धे च शेरते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2091686, "chapter_id": 2950, "verse_number": "१३-८०-२३", "content_sanskrit": "अन्योप्यथ न विक्रेयो मनुष्यः किं पुनः प्रजाः।\nअधर्ममूलैर्हि धनैस्तैर्न धर्मोऽथ कश्चन॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2091687, "chapter_id": 2950, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अशीतितमोऽध्यायः॥ ८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]