[{"id": 2176780, "chapter_id": 4737, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2176781, "chapter_id": 4737, "verse_number": "१", "content_sanskrit": "वादिकानां समीपात् तु श्रुत्वा दुर्योधनं हतम् ।\nहतशिष्टास्ततो राजन् कौरवाणां महारथाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2176782, "chapter_id": 4737, "verse_number": "२", "content_sanskrit": "विनिर्भिन्नाः शितैर्बाणैः शक्तितोमरकर्षणैः ।\nअश्वत्थामा कृपश्चैव कृतवर्मा च भारत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2176783, "chapter_id": 4737, "verse_number": "३", "content_sanskrit": "त्वरिता जवनैरश्वैरायोधनमुपाद्रवन्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2176784, "chapter_id": 4737, "verse_number": "४", "content_sanskrit": "तत्रापश्यन् महात्मानं धार्तराष्ट्रं निपातितम् ।\nप्रभग्नं वायुवेगेन महासालं यथा वने\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2176785, "chapter_id": 4737, "verse_number": "५", "content_sanskrit": "भूमौ विवेष्टमानं तं रुधिरेण समुक्षितम् ।\nमहागजमिवारण्ये व्याधेन निधनं गतम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2176786, "chapter_id": 4737, "verse_number": "६", "content_sanskrit": "विवर्तमानं बहुशो रुधिरौघपरिप्लुतम् ।\nयदृच्छया निपतितं चन्द्रमादित्यगोचरात्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2176787, "chapter_id": 4737, "verse_number": "७", "content_sanskrit": "महावातसमुत्थेन सङ्क्षुब्धमिव सागरम् ।\nपूर्णचन्द्रनिभं वीरं तुषारावृतमण्डलम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2176788, "chapter_id": 4737, "verse_number": "८", "content_sanskrit": "रेणुध्वस्तं दीर्घभुजं मातङ्गसमविक्रमम् ।\nवृतं भूतगणैर्घोरैः क्रव्यादैश्च समन्ततः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2176789, "chapter_id": 4737, "verse_number": "९", "content_sanskrit": "यथा धनं लिप्समानैर्भृत्यैर्नृपतिसत्तमम् ।\nभ्रुकुटीकृतवक्त्रान्तं क्रोधादुद्वृत्तलोचनम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2176790, "chapter_id": 4737, "verse_number": "१०", "content_sanskrit": "सामर्षं तं नरव्याघ्रं भौमं निपतितं तथा ।\nतं दृष्ट्वाऽथ महेष्वासं भूतले पतितं नृपम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2176791, "chapter_id": 4737, "verse_number": "११", "content_sanskrit": "मोहमभ्यागमन् सर्वे कृपप्रभृतयो नृप\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2176792, "chapter_id": 4737, "verse_number": "१२", "content_sanskrit": "अवतीर्य रथेभ्यस्तु प्राद्रवन् राजसन्निधौ ।\nदुर्योधनं च सम्प्राप्य सर्वे भूमावुपाविशन्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2176793, "chapter_id": 4737, "verse_number": "१३", "content_sanskrit": "ततो द्रौणिर्महाराज बाष्पपूर्णेक्षणः श्वसन् ।\nउवाच भरतश्रेष्ठं सर्वलोकेश्वरेश्वरम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2176794, "chapter_id": 4737, "verse_number": "", "content_sanskrit": "अश्वत्थामा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2176795, "chapter_id": 4737, "verse_number": "१४", "content_sanskrit": "नूनं न विद्यते पुण्यं मनुष्ये किञ्चिदेव तु ।\nयत्र त्वं पुरुषव्याघ्र शेते पांसुषु रूषितः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2176796, "chapter_id": 4737, "verse_number": "१५", "content_sanskrit": "भूत्वा च नृपतिः पूर्वं समाज्ञाप्य च मेदिनीम् ।\nकथमेकोऽद्य राजेन्द्र वने तिष्ठसि निर्जने\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2176797, "chapter_id": 4737, "verse_number": "१६", "content_sanskrit": "दुःशासनं न पश्यामि नापि कर्णं महारथम् ।\nनापि तान् सुहृदः सर्वान् किमिदं भरतर्षभ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2176798, "chapter_id": 4737, "verse_number": "१७", "content_sanskrit": "दुःखं नूनं(शक्या) कृतान्तस्य गतिं ज्ञातुं कथञ्चन ।\nलोकनाथो भवानद्य शेते पांसुषु रूषितः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2176799, "chapter_id": 4737, "verse_number": "१८", "content_sanskrit": "अयं मूर्धाभिषिक्तानामग्रे याति परन्तपः ।\nसतृणं ग्रसते पांसु पश्य कालस्य पर्ययम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2176800, "chapter_id": 4737, "verse_number": "१९", "content_sanskrit": "क्व ते तदमलं छत्रं व्यञ्जनं क्व च पार्थिव ।\nसा च ते महती सेना क्व गता पार्थिवोत्तम\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2176801, "chapter_id": 4737, "verse_number": "२०", "content_sanskrit": "दुर्विज्ञेया गतिर्नूनं कार्याणां कारणान्तरे ।\nयो वै लोकगुरुर्नाथो भवानेतां दशां गतः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2176802, "chapter_id": 4737, "verse_number": "२१", "content_sanskrit": "अध्रुवा सर्वमर्त्येषु ध्रुवैव श्रीर्विचिन्त्यते ।\nभवतो व्यसनं दृष्ट्वा शक्रविस्पर्धिनो भृशम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2176803, "chapter_id": 4737, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2176804, "chapter_id": 4737, "verse_number": "२२", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा दुःखितस्य विशेषतः ।\nउवाच राजन् पुत्रस्ते प्राप्तकालमिदं वचः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2176805, "chapter_id": 4737, "verse_number": "२३", "content_sanskrit": "विमृज्य नेत्रे पाणिभ्यां शोकजं वारि चोत्सृजत् ।\nस कृपप्रभृतीन् वीरान् अब्रवीन्मनुजाधिपः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2176806, "chapter_id": 4737, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2176807, "chapter_id": 4737, "verse_number": "२४", "content_sanskrit": "ईदृशो मर्त्यधर्मोऽयं धात्रा निर्दिष्ट उच्यते ।\nविनाशः सर्वभूतानां कालपर्यायकारितः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2176808, "chapter_id": 4737, "verse_number": "२५", "content_sanskrit": "सोऽयं मामनुसम्प्राप्तः प्रत्यक्षो भवतां हि सः ।\nपृथिवीं पालयित्वाऽहम् एतां निष्ठामुपागतः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2176809, "chapter_id": 4737, "verse_number": "२६", "content_sanskrit": "दिष्ट्याऽहं त्वपरावृत्तो युद्धे कस्याञ्चिदापदि ।\nदिष्ट्याऽहं निहतः पापैश्छलेनैव विशेषतः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2176810, "chapter_id": 4737, "verse_number": "२७", "content_sanskrit": "उत्साहश्च कृतो नित्यं मया दिष्ट्या युयुत्सया ।\nदिष्ट्या चास्मि हतो युद्धे क्षीणस्वजनबान्धवः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2176811, "chapter_id": 4737, "verse_number": "२८", "content_sanskrit": "दिष्ट्या च वोऽहं पश्यामि मुक्तानस्माज्जनक्षयात् ।\nस्वस्तिमन्तश्च कल्याश्च तन्मे प्रियमनुत्तमम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2176812, "chapter_id": 4737, "verse_number": "२९", "content_sanskrit": "मा भवन्तोऽनुतप्यन्तां सौहृदान्निधनेन मे ।\nयदि वेदाः प्रमाणं वो जिता लोका मयाऽक्षयाः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2176813, "chapter_id": 4737, "verse_number": "३०", "content_sanskrit": "जानमानः प्रभावं च कृष्णस्यामिततेजसः ।\nतेन न च्यावितश्चाहं क्षत्रधर्मात् स्वनुष्ठितात्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2176814, "chapter_id": 4737, "verse_number": "३१", "content_sanskrit": "समयोऽयमनुप्राप्तो नास्मि शोच्यः कथञ्चन ।\nकृतं भवद्भिः सदृशमनुकूलमिहात्मनः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2176815, "chapter_id": 4737, "verse_number": "३२", "content_sanskrit": "यदि तं विजये शक्त्या दैवं तु बलवत्तरम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2176816, "chapter_id": 4737, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2176817, "chapter_id": 4737, "verse_number": "३३", "content_sanskrit": "एतावदुक्त्वा वचनं बाष्पव्याकुललोचनः ।\nतूष्णीं बभूव राजेन्द्रो रुजया भृशविह्वलः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2176818, "chapter_id": 4737, "verse_number": "३४", "content_sanskrit": "तथा दृष्ट्वा तु राजानं बाष्पशोकसमन्वितम् ।\nद्रौणिः क्रोधेन जज्वाल यथाऽग्निर्जगतः क्षये\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2176819, "chapter_id": 4737, "verse_number": "३५", "content_sanskrit": "स तु क्रोधसमाविष्टः पाणिं पादौ निपीड्य च ।\nबाष्पविह्वलया वाचा राजानमिदमब्रवीत्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2176820, "chapter_id": 4737, "verse_number": "", "content_sanskrit": "अश्वत्थामा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2176821, "chapter_id": 4737, "verse_number": "३६", "content_sanskrit": "पिता मे निहतः क्षुद्रैः सुनृशंसेन कर्मणा ।\nन तथा तेन तप्यामि यथा राजंस्त्वयाऽद्य वै\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2176822, "chapter_id": 4737, "verse_number": "३७", "content_sanskrit": "शृणु राजन् वचो मेऽद्य सत्येन वदतः प्रभो ।\nइष्टापूर्तेन दानेन धर्मेण सुकृतेन च\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2176823, "chapter_id": 4737, "verse_number": "३८", "content_sanskrit": "अद्याहं सर्वपाञ्चालान् वासुदेवस्य पश्यतः ।\nअद्य रात्रौ महाराज निहनिष्यामि पाण्डवान्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2176824, "chapter_id": 4737, "verse_number": "३९", "content_sanskrit": "अनुज्ञां तु महाराज भवान् मे दातुमर्हसि\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2176825, "chapter_id": 4737, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2176826, "chapter_id": 4737, "verse_number": "४०", "content_sanskrit": "तच्छ्रुत्वा वचनं द्रौणेर्धृतराष्ट्र तवात्मजः ।\nमनसः प्रीतिजननं कृपं वचनमब्रवीत्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2176827, "chapter_id": 4737, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2176828, "chapter_id": 4737, "verse_number": "४१", "content_sanskrit": "आचार्य शीघ्रं कलशं जलपूर्णमिहानय\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2176829, "chapter_id": 4737, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2176830, "chapter_id": 4737, "verse_number": "४२", "content_sanskrit": "स तद्ववचनमाज्ञाय राज्ञो ब्राह्मणसत्तमः ।\nकलशं पूर्णमादाय राजान्तिकमुपागमत्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2176831, "chapter_id": 4737, "verse_number": "४३", "content_sanskrit": "तमब्रवीन्महाराज पुत्रस्तव विशाम्पते\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2176832, "chapter_id": 4737, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2176833, "chapter_id": 4737, "verse_number": "४४", "content_sanskrit": "ममाज्ञया द्विजश्रेष्ठ द्रोणपुत्रोऽभिषिच्यताम् ।\nसैनापत्येन भद्रं ते मम चेदिच्छसि प्रियम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2176834, "chapter_id": 4737, "verse_number": "४५", "content_sanskrit": "राज्ञो नियोगाद् योद्धव्यं ब्राह्मणेन विशेषतः ।\nवर्तता क्षत्रधर्मेण एवं धर्मविदो विदुः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2176835, "chapter_id": 4737, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2176836, "chapter_id": 4737, "verse_number": "४६", "content_sanskrit": "राज्ञस्तु वचनं श्रुत्वा कृपः शारद्वतस्ततः ।\nद्रौणिं राजनियोगेन सैनापत्येऽभ्यषेचयत्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2176837, "chapter_id": 4737, "verse_number": "४७", "content_sanskrit": "सोऽभिषिक्तो महाराज परिष्वज्य नृपोत्तमम् ।\nप्रययौ सिंहनादेन दिशः सर्वा विनादयन्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2176838, "chapter_id": 4737, "verse_number": "४८", "content_sanskrit": "दुर्योधनोऽपि राजेन्द्र शोणितौघपरिप्लुतः ।\nतां निशां प्रतिसम्पेदे सर्वभूतभयावहाम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2176839, "chapter_id": 4737, "verse_number": "४९", "content_sanskrit": "अपक्रम्य तु ते तूर्णं तस्मादायोधनान्नृप ।\nशोकसन्तप्तमनसः चिन्तामापेदिरे भृशम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2176840, "chapter_id": 4737, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि दुर्योधनवधो नाम पञ्चस्त्रिंशोऽध्यायः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2176841, "chapter_id": 4737, "verse_number": "", "content_sanskrit": "॥ समाप्तं गदापर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]