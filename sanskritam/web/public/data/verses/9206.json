[{"id": 40014699, "chapter_id": 9206, "verse_number": "1", "content_sanskrit": "अथरामःप्रसन्नात्माशृत्वावायुसुतस्यह । प्रत्यभाषतदुर्धषश्रुतवानात्मनिस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40014700, "chapter_id": 9206, "verse_number": "2", "content_sanskrit": "ममापितुविवक्षाऽस्तिकाचित्प्रतिविभीषणम् । श्रोतुमिच्छामितत्सर्वंभवद्भिश्श्रेयसिस्थितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40014701, "chapter_id": 9206, "verse_number": "3", "content_sanskrit": "मित्रभावेनसम्प्राप्तंनत्यजेयंकथञ्चन । दोषोयद्यपितस्यस्यात्सतामेतदगर्हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40014702, "chapter_id": 9206, "verse_number": "4", "content_sanskrit": "सुग्रीस्त्वथतद्वाक्यमाभाष्यचविमृश्यच । ततश्शुभतरंवाक्यमुवाचहरिपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40014703, "chapter_id": 9206, "verse_number": "5", "content_sanskrit": "सुदुष्टोवाप्यदुष्टोवाकिमेषरजनीचरः । ईदृशंव्यसनंप्राप्तंभ्रातरंयःपरित्यजेत् ॥ कोनामसभवेत्तस्ययमेषनपरित्यजेत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40014704, "chapter_id": 9206, "verse_number": "6", "content_sanskrit": "वानराधिपतेर्वाक्यंश्रुत्वासर्वानुदीक्ष्यच ॥ ईषदुत्स्मयमानस्तुलक्ष्मणंपुण्यलक्षणम् । इतिहोवाचकाकुत्स्थोवाक्यंसत्यपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40014705, "chapter_id": 9206, "verse_number": "7", "content_sanskrit": "वानराधिपतेर्वाक्यंश्रुत्वासर्वानुदीक्ष्यच ॥ ईषदुत्स्मयमानस्तुलक्ष्मणंपुण्यलक्षणम् । इतिहोवाचकाकुत्स्थोवाक्यंसत्यपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40014706, "chapter_id": 9206, "verse_number": "8", "content_sanskrit": "अनधीत्यचशास्त्राणिवृद्धाननुपसेव्यच । नशक्यमीदृशंवक्तुंयदुवाचहरीश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40014707, "chapter_id": 9206, "verse_number": "9", "content_sanskrit": "अस्तिसूक्ष्मतरंकिंचिद्यदत्रप्रतिभातिमे । प्रत्यक्षंलौकिकंचापिविद्यतेसर्वराजसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40014708, "chapter_id": 9206, "verse_number": "10", "content_sanskrit": "अमित्रास्तत्कुलीनाश्चप्रातिदेश्याश्चकीर्तिताः । व्यसनेषुप्रहर्तारस्तस्मादयमिहागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40014709, "chapter_id": 9206, "verse_number": "11", "content_sanskrit": "अपापास्तत्कुलीनाश्चमानयन्तिस्वकान्हितान् । एषप्रायोनरेन्द्राणांशङ्कनीयस्तुशोभनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40014710, "chapter_id": 9206, "verse_number": "12", "content_sanskrit": "यस्तुदोषस्त्वयाप्रोक्तोह्यादानेऽरिबलस्यच । तत्रतेकीर्तयिष्यामियथाशास्त्रमिदंशृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40014711, "chapter_id": 9206, "verse_number": "13", "content_sanskrit": "नवयंतत्कुलीनाश्चराज्यकाङ् क्षीचराक्षसः । पण्डिताहिभविष्यन्तितस्माद्ग्राह्योविभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40014712, "chapter_id": 9206, "verse_number": "14", "content_sanskrit": "अव्यग्राश्चप्रहृष्टाश्चनभविष्यन्तिसङ्गता । प्रणादश्चमहानेषततोऽस्यभयमागतम् ॥ इतिभेदंगमिष्यन्तितस्माग्राह्योविभीषणः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40014713, "chapter_id": 9206, "verse_number": "15", "content_sanskrit": "नसर्वेभ्रातरस्तातभवन्तिभरतोपमाः । मद्विथावापितुःपुत्रास्सुहृदोनाभवद्विथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40014714, "chapter_id": 9206, "verse_number": "16", "content_sanskrit": "एवमुक्तस्तुरामेणसुग्रीवस्सहलक्ष्मणः । उत्थायेदंमहाप्राज्ञःप्रणतोवाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40014715, "chapter_id": 9206, "verse_number": "17", "content_sanskrit": "रावणेनप्रणिहितंतमवेहिविभीषणम् । तस्याहंनिग्रहंमन्येक्षमंक्षमवतांवर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40014716, "chapter_id": 9206, "verse_number": "18", "content_sanskrit": "राक्षसोजिह्मयाबुध्यासन्दिष्टोऽयमिहागतः । प्रहर्तुंत्वयिविश्वस्तेप्रच्छन्नोमयिवानघ ॥ लक्ष्मणेवामहाबाहो सवध्यस्सचिवैस्सहा । रावणस्यनृशंसस्यभ्राताह्येषविभीषणः ।। एवमुक्त्वारघुश्रेष्ठंसुग्रीवोवाहिनीपतिः । वाक्यज्ञोवाक्यकुशलंततोमौनमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40014717, "chapter_id": 9206, "verse_number": "19", "content_sanskrit": "राक्षसोजिह्मयाबुध्यासन्दिष्टोऽयमिहागतः । प्रहर्तुंत्वयिविश्वस्तेप्रच्छन्नोमयिवानघ ॥ लक्ष्मणेवामहाबाहो सवध्यस्सचिवैस्सहा । रावणस्यनृशंसस्यभ्राताह्येषविभीषणः ।। एवमुक्त्वारघुश्रेष्ठंसुग्रीवोवाहिनीपतिः । वाक्यज्ञोवाक्यकुशलंततोमौनमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40014718, "chapter_id": 9206, "verse_number": "20", "content_sanskrit": "सुग्रीवस्यतुतद्वाक्यंरामश्रुत्वाविमृश्यच । ततश्शुभतरंवाक्यमुवाचहरिपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40014719, "chapter_id": 9206, "verse_number": "21", "content_sanskrit": "सुदुष्टोवाप्यदुष्टोवाकिमेषरजनीचरः । सूक्ष्ममप्यहितंकर्तुंममाशक्तःकथञ्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40014720, "chapter_id": 9206, "verse_number": "22", "content_sanskrit": "पिशाचानदानवान् यक्ष I नपृथिव्यांचैवराक्षसान् । अङ्गुल्यग्रेणतान् हन्यामिच्छन् हरिगणेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40014721, "chapter_id": 9206, "verse_number": "23", "content_sanskrit": "श्रूयतेहिकपोतेनशत्रुश्शरणमागतः । अर्चितश्चयथान्यायंस्वैश्चमांसैर्निमन्त्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40014722, "chapter_id": 9206, "verse_number": "24", "content_sanskrit": "सहितंप्रतिजग्राहभार्याहर्तारमागतः । कपोतोवानरश्रेष्ठ: किंपुनर्मद्विधोजनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40014723, "chapter_id": 9206, "verse_number": "25", "content_sanskrit": "ऋषेःकण्वस्यपुत्रेणकण्डुनापरमर्षिणा । शृणुगाथांपुरागीतांधर्मिष्ठासत्यवादिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40014724, "chapter_id": 9206, "verse_number": "26", "content_sanskrit": "बद्धाञ्जलिपुटंदीनंयाचन्तंशरणागतम् । नहन्यदानृशंस्यार्थमपिशत्रुंपरन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40014725, "chapter_id": 9206, "verse_number": "27", "content_sanskrit": "आर्तोवायदिवादृप्तःपरेषांशरणांगतः । अरिःप्राणान्परित्यज्यरक्षितव्यःकृतात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40014726, "chapter_id": 9206, "verse_number": "28", "content_sanskrit": "सचेद्भयाद्वामोहाद्वाकामाद्वापिनरक्षति । स्वयाशक्त्यायथासत्त्वंतत्पापंलोकगर्हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40014727, "chapter_id": 9206, "verse_number": "29", "content_sanskrit": "विनष्टःपश्यतस्तस्यारक्षिणश्शरणागतः । आदायसुकृतंतस्यसर्वंगच्छेदरक्षित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40014728, "chapter_id": 9206, "verse_number": "30", "content_sanskrit": "एवंदोषोमहानत्रप्रपन्नानामरक्षणे । अस्वर्ग्यंचायशस्यंचबलवीर्यविनाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40014729, "chapter_id": 9206, "verse_number": "31", "content_sanskrit": "करिष्यामियथार्थंतुकण्डोर्वचनमुत्तमम् । धर्मिष्ठंचयशस्यंचस्वर्ग्यंस्यात्तुफलोदये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40014730, "chapter_id": 9206, "verse_number": "32", "content_sanskrit": "सकृदेवप्रपन्नायतवास्मीतिचयाचते । अभयंसर्वभूतेभ्योददाम्येतद्व्रतंमम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40014731, "chapter_id": 9206, "verse_number": "33", "content_sanskrit": "अनयैनंहरिश्रेष्ठ: दत्तमस्याभयंमया । विभीषणोवासुग्रीव: यदिवारावणस्स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40014732, "chapter_id": 9206, "verse_number": "34", "content_sanskrit": "रामस्यतुवच्शुत्वासुग्रीवःप्लवगेश्वरः । प्रत्यभाषतकाकुत्स्थंसौहार्देनप्रचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40014733, "chapter_id": 9206, "verse_number": "35", "content_sanskrit": "किमत्रचित्रंधर्मज्ञ: लोकनाथ: सुखावहा: । यत्त्वमार्यंप्रभाषेथास्सत्त्ववान् सत्पथेस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40014734, "chapter_id": 9206, "verse_number": "36", "content_sanskrit": "ममचाप्यन्तरात्मायंशुद्धंवेत्तिविभीषणम् । अनुमानाच्चभावाच्चसर्वतस्सुपरीक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40014735, "chapter_id": 9206, "verse_number": "37", "content_sanskrit": "तस्मात् क्षिप्रंसहास्माभिस्तुल्योभवतराघव: । विभीषणोमहाप्राज्ञस्सखित्वंचाभ्युपैतुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40014736, "chapter_id": 9206, "verse_number": "38", "content_sanskrit": "ततस्तुसुग्रीववचोनिशम्यतद्दरीश्वरेणाभिहितंनरेश्वरः । विभीषणेनाशुजगामसङ्गमंपतत्त्रिराजेनयथापुरन्दरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]