[{"id": 5000206000, "chapter_id": 9206, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे दशमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000206001, "chapter_id": 9206, "verse_number": "३-१०-१", "content_sanskrit": "वाक्यमेतत् तु वैदेह्या व्याहृतं भर्तृभक्तया।\nश्रुत्वा धर्मे स्थितो रामः प्रत्युवाचाथ जानकीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000206002, "chapter_id": 9206, "verse_number": "३-१०-२", "content_sanskrit": "हितमुक्तं त्वया देवि स्निग्धया सदृशं वचः।\nकुलं व्यपदिशन्त्या च धर्मज्ञे जनकात्मजे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000206003, "chapter_id": 9206, "verse_number": "३-१०-३", "content_sanskrit": "किं नु वक्ष्याम्यहं देवि त्वयैवोक्तमिदं वचः।\nक्षत्रियैर्धार्यते चापो नार्तशब्दो भवेदिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000206004, "chapter_id": 9206, "verse_number": "३-१०-४", "content_sanskrit": "ते चार्ता दण्डकारण्ये मुनयः संशितव्रताः।\nमां सीते स्वयमागम्य शरण्यं शरणं गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000206005, "chapter_id": 9206, "verse_number": "३-१०-५", "content_sanskrit": "वसन्तः कालकालेषु वने मूलफलाशनाः।\nन लभन्ते सुखं भीरु राक्षसैः क्रूरकर्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000206006, "chapter_id": 9206, "verse_number": "३-१०-६", "content_sanskrit": "भक्ष्यन्ते राक्षसैर्भीमैर्नरमांसोपजीविभिः।\nते भक्ष्यमाणा मुनयो दण्डकारण्यवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000206007, "chapter_id": 9206, "verse_number": "३-१०-७", "content_sanskrit": "अस्मानभ्यवपद्येति मामूचुर्द्विजसत्तमाः।\nमया तु वचनं श्रुत्वा तेषामेवं मुखाच्च्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000206008, "chapter_id": 9206, "verse_number": "३-१०-८", "content_sanskrit": "कृत्वा वचनशुश्रूषां वाक्यमेतदुदाहृतम्।\nप्रसीदन्तु भवन्तो मे ह्रीरेषा तु ममातुला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000206009, "chapter_id": 9206, "verse_number": "३-१०-९", "content_sanskrit": "यदीदृशैरहं विप्रैरुपस्थेयैरुपस्थितः।\nकिं करोमीति च मया व्याहृतं द्विजसंनिधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000206010, "chapter_id": 9206, "verse_number": "३-१०-१०", "content_sanskrit": "सर्वैरेव समागम्य वागियं समुदाहृता।\nराक्षसैर्दण्डकारण्ये बहुभिः कामरूपिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000206011, "chapter_id": 9206, "verse_number": "३-१०-११", "content_sanskrit": "अर्दिताः स्म भृशं राम भवान् नस्तत्र रक्षतु।\nहोमकाले तु सम्प्राप्ते पर्वकालेषु चानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000206012, "chapter_id": 9206, "verse_number": "३-१०-१२", "content_sanskrit": "धर्षयन्ति सुदुर्धर्षा राक्षसाः पिशिताशनाः।\nराक्षसैर्धर्षितानां च तापसानां तपस्विनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000206013, "chapter_id": 9206, "verse_number": "३-१०-१३", "content_sanskrit": "गतिं मृगयमाणानां भवान् नः परमा गतिः।\nकामं तपःप्रभावेण शक्ता हन्तुं निशाचरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000206014, "chapter_id": 9206, "verse_number": "३-१०-१४", "content_sanskrit": "चिरार्जितं न चेच्छामस्तपः खण्डयितुं वयम्।\nबहुविघ्नं तपो नित्यं दुश्चरं चैव राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000206015, "chapter_id": 9206, "verse_number": "३-१०-१५", "content_sanskrit": "तेन शापं न मुञ्चामो भक्ष्यमाणाश्च राक्षसैः।\nतदर्द्यमानान् रक्षोभिर्दण्डकारण्यवासिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000206016, "chapter_id": 9206, "verse_number": "३-१०-१६", "content_sanskrit": "रक्ष नस्त्वं सह भ्रात्रा त्वन्नाथा हि वयं वने।\nमया चैतद्वचः श्रुत्वा कात्स्‍न्‍‍र्येन परिपालनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000206017, "chapter_id": 9206, "verse_number": "३-१०-१७", "content_sanskrit": "ऋषीणां दण्डकारण्ये संश्रुतं जनकात्मजे।\nसंश्रुत्य च न शक्ष्यामि जीवमानः प्रतिश्रवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000206018, "chapter_id": 9206, "verse_number": "३-१०-१८", "content_sanskrit": "मुनीनामन्यथा कर्तुं सत्यमिष्टं हि मे सदा।\nअप्यहं जीवितं जह्यां त्वां वा सीते सलक्ष्मणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000206019, "chapter_id": 9206, "verse_number": "३-१०-१९", "content_sanskrit": "न तु प्रतिज्ञा संश्रुत्य ब्राह्मणेभ्यो विशेषतः।\nतदवश्यं मया कार्यमृषीणां परिपालनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000206020, "chapter_id": 9206, "verse_number": "३-१०-२०", "content_sanskrit": "अनुक्तेनापि वैदेहि प्रतिज्ञाय कथं पुनः।\nमम स्नेहाच्च सौहार्दादिदमुक्तं त्वया वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000206021, "chapter_id": 9206, "verse_number": "३-१०-२१", "content_sanskrit": "परितुष्टोऽस्म्यहं सीते न ह्यनिष्टोऽनुशास्यते।\nसदृशं चानुरूपं च कुलस्य तव शोभने।\nसधर्मचारिणी मे त्वं प्राणेभ्योऽपि गरीयसी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000206022, "chapter_id": 9206, "verse_number": "३-१०-२२", "content_sanskrit": "इत्येवमुक्त्वा वचनं महात्मा\nसीतां प्रियां मैथिलराजपुत्रीम्।\nरामो धनुष्मान् सह लक्ष्मणेन\nजगाम रम्याणि तपोवनानि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000206023, "chapter_id": 9206, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे दशमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]