[{"id": 2077374, "chapter_id": 2637, "verse_number": "१२-१४२-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2077375, "chapter_id": 2637, "verse_number": "१२-१४२-१", "content_sanskrit": "यदिदं घोरमुद्दिष्टमश्रद्धेयमिवानृतम्।\nअस्तिस्विद्दस्युमर्यादा यामयं परिवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2077376, "chapter_id": 2637, "verse_number": "१२-१४२-२", "content_sanskrit": "संमुह्यामि विपीदामि धर्मो मे शिथिलीकृतः।\nउद्यमं नाधिगच्छामि कुतश्चित्परिचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2077377, "chapter_id": 2637, "verse_number": "१२-१४२-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2077378, "chapter_id": 2637, "verse_number": "१२-१४२-३", "content_sanskrit": "नैतच्छ्रुत्वागमादेव तव धर्मानुशासनम्।\nप्रज्ञासमभिहारोऽयं कविभिः संभृतं मधु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2077379, "chapter_id": 2637, "verse_number": "१२-१४२-४", "content_sanskrit": "बाह्याः प्रतिविधातव्याः प्रज्ञा राज्ञा ततस्ततः।\nबहुशाखेन धर्मेण यत्रैषा संप्रसिध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2077380, "chapter_id": 2637, "verse_number": "१२-१४२-५", "content_sanskrit": "बुद्धिं संजनयेद्राज्ञां धर्ममाचरतां सदा।\nजयो भवति कौरव्य सदा तद्वृद्धिरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2077381, "chapter_id": 2637, "verse_number": "१२-१४२-६", "content_sanskrit": "बुद्धिश्रेष्ठा हि राजानो जयन्ति विजयैषिणः।\nधर्मः प्रतिविधातव्यो बुद्ध्या राज्ञा ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2077382, "chapter_id": 2637, "verse_number": "१२-१४२-७", "content_sanskrit": "नैकशाखेन धर्मेण राज्ञो धर्मो विधीयते।\nदुर्बलस्य कुतः प्रज्ञा पुरस्तादनुदाहृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2077383, "chapter_id": 2637, "verse_number": "१२-१४२-८", "content_sanskrit": "अद्वैधज्ञः प्रतिद्वैधे संशयं प्राप्नुमर्हति।\nबुद्धिद्वैधं विधातव्यं पुरस्तादेव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2077384, "chapter_id": 2637, "verse_number": "१२-१४२-९", "content_sanskrit": "पार्श्वतः कारणं राज्ञो विषूच्यस्त्वापगा इव।\nजनास्तूच्चरितं धर्मं विजान्त्यन्यथाऽन्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2077385, "chapter_id": 2637, "verse_number": "१२-१४२-१०", "content_sanskrit": "सम्यग्विज्ञानिनः केचिन्मिथ्याविज्ञानिनः परे।\nतद्वै यथायथं बुद्ध्वा ज्ञानमाददते सताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2077386, "chapter_id": 2637, "verse_number": "१२-१४२-११", "content_sanskrit": "परिमुष्णन्ति शास्त्राणि धर्मस्य परिपन्थिनः।\nवैषम्यमर्थविद्यानां निरर्थाः ख्यापयन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2077387, "chapter_id": 2637, "verse_number": "१२-१४२-१२", "content_sanskrit": "आजिजीविषवो विद्यां यशः कामौ समन्तनः।\nते सर्वे नृप पापिष्ठा धर्मस्य परिपन्थिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2077388, "chapter_id": 2637, "verse_number": "१२-१४२-१३", "content_sanskrit": "अपक्वमतयो मन्दा न जानन्ति यथातथम्।\nतथा ह्यशास्त्रकुशलाः सर्वत्रायुक्तिनिष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2077389, "chapter_id": 2637, "verse_number": "१२-१४२-१४", "content_sanskrit": "परिमुष्णन्ति शास्त्राणि शास्त्रदोषानुदर्शिनः।\nविज्ञानमथ विद्यानां न सम्यगिति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2077390, "chapter_id": 2637, "verse_number": "१२-१४२-१५", "content_sanskrit": "निन्दया परविद्यानां स्वविद्यां ख्यापयन्ति च।\nवागास्तिक्यानुनीताश्च दुग्धविद्याफला इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2077391, "chapter_id": 2637, "verse_number": "१२-१४२-१६", "content_sanskrit": "तान्विद्यावणिजो विद्धि राक्षसानिव भारत।\nव्याजेन कृत्स्नो विहितो धर्मस्ते परिहास्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2077392, "chapter_id": 2637, "verse_number": "१२-१४२-१७", "content_sanskrit": "न धर्मवचनं वाचा नैव बुद्ध्येति नः श्रुतम्।\nइति बार्हस्पत्यविज्ञानं प्रोवाच मघवा स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2077393, "chapter_id": 2637, "verse_number": "१२-१४२-१८", "content_sanskrit": "न त्यव वचनं किंचिदनिमित्तादिहोच्यते।\nस्वविनीतेन शास्त्रेण ह्यविद्यः स्यादथापरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2077394, "chapter_id": 2637, "verse_number": "१२-१४२-१९", "content_sanskrit": "लोकयात्रामिहैके तु धर्मं प्राहुर्मनीषिणः।\nसमुद्दिष्टं सतां धर्मं स्वयमूहेत् पण्डितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2077395, "chapter_id": 2637, "verse_number": "१२-१४२-२०", "content_sanskrit": "अमर्षाच्छास्त्रसंमोहादनिमित्तादिहोच्यते।\nशास्त्रं प्राज्ञस्य वदतः समूहे यात्यदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2077396, "chapter_id": 2637, "verse_number": "१२-१४२-२१", "content_sanskrit": "आगमागतया बुद्ध्या वचनेन प्रशस्यते।\nअज्ञानाज्ज्ञानहेतुत्वाद्वचनं साधु मन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2077397, "chapter_id": 2637, "verse_number": "१२-१४२-२२", "content_sanskrit": "अनुपागतमेवेदं शास्त्रमेवमपार्थकम्।\nदैतेयानुशना प्राह संशयच्छेदनं पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2077398, "chapter_id": 2637, "verse_number": "१२-१४२-२३", "content_sanskrit": "ज्ञानमप्यपदिश्यं हि यथा नास्ति तथैव तत्।\nतेन संच्छिन्नमूलेन कस्तोषयितुमिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2077399, "chapter_id": 2637, "verse_number": "१२-१४२-२४", "content_sanskrit": "पुनर्व्यवसितं यो वा नेदं वाक्यमुपाश्नुते।\nउग्रायैव हि सृष्टोऽसि कर्मणे तत्त्वमीक्षसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2077400, "chapter_id": 2637, "verse_number": "१२-१४२-२५", "content_sanskrit": "अग्रे मामन्ववेक्षस्व राजन्योऽयं बुभूषते।\nयथा प्रमुच्यते त्वन्यो यदर्थं न प्रमोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2077401, "chapter_id": 2637, "verse_number": "१२-१४२-२६", "content_sanskrit": "अजोऽश्वः क्षत्रमित्येतत्सदृशं ब्रह्मणा कृतम्।\nतस्मान्नतैक्ष्ण्याद्भूतानां यात्रा काचित्प्रसिद्ध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2077402, "chapter_id": 2637, "verse_number": "१२-१४२-२७", "content_sanskrit": "यस्त्ववध्यवधे दोषः स वध्यस्यावधे स्मृतः।\nएषा ह्येव तु मर्यादा यामयं परिवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2077403, "chapter_id": 2637, "verse_number": "१२-१४२-२८", "content_sanskrit": "तस्मात्तीक्ष्णः प्रजा राजा स्वधर्मे स्थापयत्युत।\nअन्योन्यं भक्षयन्तो हि प्रचरेयुर्वृका इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2077404, "chapter_id": 2637, "verse_number": "१२-१४२-२९", "content_sanskrit": "यस्य दस्युगणा राष्ट्रे ध्वाङ्क्षा मत्स्याञ्जलादिव।\nविहरन्ति परस्वानि स वै क्षत्रियपांसनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2077405, "chapter_id": 2637, "verse_number": "१२-१४२-३०", "content_sanskrit": "कुलीनान्सचिवान्कृत्वा वेदविद्यासमन्वितान्।\nप्रशाधि पृथिवीं राजन्प्रजा धर्मेण पालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2077406, "chapter_id": 2637, "verse_number": "१२-१४२-३१", "content_sanskrit": "विहीनजन्मकर्माणि यः प्रगृह्णाति भूमिपः।\nउभयस्याविशेषज्ञस्तद्वै क्षत्रं नपुंसकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2077407, "chapter_id": 2637, "verse_number": "१२-१४२-३२", "content_sanskrit": "नैवोग्रं नैव चानुग्रं धर्मेणेह प्रशस्यते।\nउभयं न व्यतिक्रामेदुग्रो भूत्वा मृदुर्भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2077408, "chapter_id": 2637, "verse_number": "१२-१४२-३३", "content_sanskrit": "कष्टः क्षत्रियधर्मोऽयं सौहृदं त्वयि मे स्थितम्।\nउग्रकर्मणि सृष्टोऽसि तस्माद्राज्यं प्रशाधि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2077409, "chapter_id": 2637, "verse_number": "१२-१४२-३४", "content_sanskrit": "`अरुष्टः कस्यचिद्राजन्नेवमेव समाचर।\nअशिष्टनिग्रहो नित्यं शिष्टस्य परिपालनम्।\nएवं शुक्रोऽब्रवीद्धीमानापत्सु भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2077410, "chapter_id": 2637, "verse_number": "१२-१४२-३५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2077411, "chapter_id": 2637, "verse_number": "१२-१४२-३५", "content_sanskrit": "अस्ति चेदिह मर्यादा यामन्यो नातिलङ्घयेत्।\nपृच्छामि त्वां सतां श्रेष्ठ तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2077412, "chapter_id": 2637, "verse_number": "१२-१४२-३६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2077413, "chapter_id": 2637, "verse_number": "१२-१४२-३६", "content_sanskrit": "ब्राह्मणानेव सेवेत विद्याबृद्धांस्तपस्विनः।\nश्रुतचारित्रवृत्ताढ्यान्पवित्रं ह्येतदुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2077414, "chapter_id": 2637, "verse_number": "१२-१४२-३७", "content_sanskrit": "शुश्रूषा तु महाराज सान्त्वं विप्रेषु नित्यदा।\nक्रुद्धैर्हि विप्रैः कर्माणि कृतानि बहुधा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2077415, "chapter_id": 2637, "verse_number": "१२-१४२-३८", "content_sanskrit": "तेषां प्रीत्या यशो मुख्यमप्रीत्या परमं भयम्।\nप्रीत्या ह्यमृतवद्विप्राः क्रुद्धाश्चैव यथोरगाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2077416, "chapter_id": 2637, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि द्विचत्वारिंशदधिकशततमोऽध्यायः॥ १४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]