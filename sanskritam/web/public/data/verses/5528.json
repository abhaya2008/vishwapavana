[{"id": 2212534, "chapter_id": 5528, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212535, "chapter_id": 5528, "verse_number": "१", "content_sanskrit": "युधिष्ठिरस्य नृपतेर्दुर्योधनपितुस्तदा ।\nनान्तरं ददृशू राजन् पुरुषाः प्रणयं प्रति\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212536, "chapter_id": 5528, "verse_number": "२", "content_sanskrit": "यदा तु कौरवो राजा पुत्रं सस्मार बालिशम् ।\nतदा भीममपध्याति हृदयेनाम्बिकासुतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212537, "chapter_id": 5528, "verse_number": "३", "content_sanskrit": "कौरवश्चैव भीमश्च हृदाऽन्योन्यमदूष्यताम् ।\nध्यायन्तौ श्लक्ष्णया वाचा अन्योन्यमभितिष्ठताम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212538, "chapter_id": 5528, "verse_number": "४", "content_sanskrit": "अप्रकाशं व्यलीकानि कुरुतेऽस्य वृकोदरः ।\nआज्ञां प्रत्यहनच्चैव कृतकैः पुरुषैः सदा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212539, "chapter_id": 5528, "verse_number": "५", "content_sanskrit": "असकृच्चाप्युवाचेदं हतास्ते मन्दचेतसः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2212540, "chapter_id": 5528, "verse_number": "६", "content_sanskrit": "अथ भीमः सुहृन्मध्ये बाहुशब्दमथाऽकरोत् ।\nसंश्रवे धृतराष्ट्रस्य युद्धं संवर्णयन्निव\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2212541, "chapter_id": 5528, "verse_number": "७", "content_sanskrit": "स्मृत्वा दुर्योधनं शत्रुं कर्णदुःशासनावपि ।\nप्रोवाचेदं सुसंरब्धो भीमः स परुषं वचः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2212542, "chapter_id": 5528, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2212543, "chapter_id": 5528, "verse_number": "८", "content_sanskrit": "अन्धस्य नृपतेः पुत्रा मया परिघबाहुना ।\nनीता लोकममुं सर्वे नानाशस्त्रास्त्रयोधिनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2212544, "chapter_id": 5528, "verse_number": "९", "content_sanskrit": "इमौ तौ परिघप्रख्यौ भुजौ मम दुरासदौ ।\nययोरन्तरमापन्नाः धृतराष्ट्राः क्षयं गताः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2212545, "chapter_id": 5528, "verse_number": "१०", "content_sanskrit": "इमौ पीनौ सुवृत्तौ मे नागराजकरोपमौ ।\nयावासाद्य रणे मूढा धार्तराष्ट्राः क्षयं गताः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2212546, "chapter_id": 5528, "verse_number": "११", "content_sanskrit": "ताविमौ चन्दनेनाक्तौ वन्दनीयौ च मे भुजौ ।\nयाभ्यां दुर्योधनो निन्ये क्षयं ससुतबान्धवः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2212547, "chapter_id": 5528, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2212548, "chapter_id": 5528, "verse_number": "१२", "content_sanskrit": "एताश्चान्याश्च विविधाः शल्यभूता जनाधिपः ।\nश्रुत्वा निर्वेदमापेदे भीमवाग्बाणचोदितः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2212549, "chapter_id": 5528, "verse_number": "१३", "content_sanskrit": "सा च बुद्धिमती देवी कालपर्यायवेदिनी ।\nगान्धारी सर्वधर्मज्ञा तान्यलीकानि शुश्रुवे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2212550, "chapter_id": 5528, "verse_number": "१४", "content_sanskrit": "कुन्त्यां सपर्यां सा वीक्ष्य शापे नास्याकरोन्मतिम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2212551, "chapter_id": 5528, "verse_number": "१५", "content_sanskrit": "ततः पञ्चदशे वर्षे समतीते नराधिपः ।\nराजा निर्वेदमापेदे भीमवाग्बाणपीडितः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2212552, "chapter_id": 5528, "verse_number": "", "content_sanskrit": "(सुखासक्तं कृच्छ्रपरं ज्ञात्वा चैव युधिष्ठिरम् ।\nतपोयोगात् तपस्तप्तुं मनश्चक्रे महामतिः\t॥१६॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2212553, "chapter_id": 5528, "verse_number": "१७", "content_sanskrit": "नान्वबुध्यत तद् राजा कुन्तीपुत्रो युधिष्ठिरः ।\nश्वेताश्वो वाऽथ कुन्ती वा द्रौपदी वा यशस्विनी\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2212554, "chapter_id": 5528, "verse_number": "१८", "content_sanskrit": "माद्रीपुत्रौ च भीमस्य चित्तज्ञावन्वमोदताम् ।\nराज्ञस्तु चित्तं रक्षन्तौ नोचतुः स्वयमप्रियम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2212555, "chapter_id": 5528, "verse_number": "१९", "content_sanskrit": "ततः समानयत् सर्वं धृतराष्ट्रः सुहृज्जनम् ।\nबाष्पसन्दिग्धमत्यर्थम् इदमाह वचो भृशम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2212556, "chapter_id": 5528, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्रमवासिकपर्वणि भीमसेनवचनं नाम चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2212557, "chapter_id": 5528, "verse_number": "", "content_sanskrit": "आश्रमवासपर्वणि चतुर्थोऽध्यायः ॥४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]