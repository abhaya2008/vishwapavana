[{"id": 2065222, "chapter_id": 2382, "verse_number": "९-१-०x", "content_sanskrit": "श्रीवेदव्यासाय नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2065223, "chapter_id": 2382, "verse_number": "९-१-१", "content_sanskrit": "नारायणं नमस्कृत्य नरं चैव नरोत्तमम्।\nदेवीं सरस्वतीं (व्यासं) चैव ततो जयमुदीरयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2065224, "chapter_id": 2382, "verse_number": "९-१-२x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2065225, "chapter_id": 2382, "verse_number": "९-१-२", "content_sanskrit": "एवं निपातिते कर्णे समरे सव्यसाचिना।\nअल्पावशिष्टाः कुरवः किमकुर्वत वै द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2065226, "chapter_id": 2382, "verse_number": "९-१-३", "content_sanskrit": "विदीर्यमाणं च बलं दृष्ट्वा राजा सुयोधनः।\nपाण्डवैः प्राप्तकालं च किं प्रापद्यत कौरवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2065227, "chapter_id": 2382, "verse_number": "९-१-४", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं तदाचक्ष्व द्विजोत्तम।\nन हि तृप्यामि पूर्वेषां शृण्वानश्चरितं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2065228, "chapter_id": 2382, "verse_number": "९-१-५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2065229, "chapter_id": 2382, "verse_number": "९-१-५", "content_sanskrit": "ततः कर्णे हते राजन्धार्तराष्ट्रः सुयोधनः।\nभृशं शोकार्णवे मग्नो निराशः सर्वतोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2065230, "chapter_id": 2382, "verse_number": "९-१-६", "content_sanskrit": "हाकर्ण हाकर्ण इति शोचमानो मुहुर्मुहुः।\nकृच्छ्रात्स्वशिबिरं प्रायाद्वतशिष्टैर्नृपैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2065231, "chapter_id": 2382, "verse_number": "९-१-७", "content_sanskrit": "स समाश्वास्यमानोऽपि हेतुभिः शास्त्रनिश्चितैः।\nराजन्विभूतिमिच्छद्भिः सूतपुत्रमनुस्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2065232, "chapter_id": 2382, "verse_number": "९-१-८", "content_sanskrit": "स दैवं बलवन्मत्वा प्रभाते विमले सति।\nसङ्ग्रामे निश्चयं कृत्वा पुनर्युद्वाय निर्ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2065233, "chapter_id": 2382, "verse_number": "९-१-९", "content_sanskrit": "शल्यं सेनापतिं कृत्वा विधिवद्राजसत्तमम्।\nरणाय निर्ययौ राजा हतशिष्टैर्नृपैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2065234, "chapter_id": 2382, "verse_number": "९-१-१०", "content_sanskrit": "ततः सुतुमुलं युद्धं कुरुपाण्डवसेनयोः।\nबभूव भरतश्रेष्ठ देवासुररणोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2065235, "chapter_id": 2382, "verse_number": "९-१-११", "content_sanskrit": "ततः शल्यो महाराज कृत्वा कदनमाहवे।\nपाण्डुसैन्येऽथ मध्याह्ने धर्मराजेन पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2065236, "chapter_id": 2382, "verse_number": "९-१-१२", "content_sanskrit": "ततो दुर्योधनो राजा हतबन्धू रणाजिरात्।\nअपसृत्य हदं घोरं विवेश रिपुजाद्भुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2065237, "chapter_id": 2382, "verse_number": "९-१-१३", "content_sanskrit": "अथापराह्णे तस्याह्नः परिवार्य महारथैः।\nहदादाहूय युद्वाय भीमसेनेन पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2065238, "chapter_id": 2382, "verse_number": "९-१-१४", "content_sanskrit": "तस्मिंस्तु निहते वीरे महेष्वासास्त्रयो रणे।\nकृतवर्मा कृपो द्रौणिर्जघ्नुः पाण्डवसैनिकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2065239, "chapter_id": 2382, "verse_number": "९-१-१५", "content_sanskrit": "ततः पूर्वाह्णसमये शिबिरादेत्य सञ्जयः।\nप्रविवेश पुरीं दीनो दुःखशोकसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2065240, "chapter_id": 2382, "verse_number": "९-१-१६", "content_sanskrit": "स प्रविश्य पुरीं सूतो भूजावुच्छ्रित्य दुःखितः।\nवेपमानस्ततो राज्ञः प्रविप्रेश निवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2065241, "chapter_id": 2382, "verse_number": "९-१-१७", "content_sanskrit": "धावतश्चाप्यपश्यxxx तत्रत्यान्पुरुषर्षभान्।\nनष्टचित्तानिवोन्मत्ताञ्शोकेन भृशदुःखितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2065242, "chapter_id": 2382, "verse_number": "९-१-१८", "content_sanskrit": "दृष्ट्वैव च नराञ्शीघ्रं व्याजहारातिदुःखितः।\nअहो बत विपन्नोऽस्मि निधनेन महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2065243, "chapter_id": 2382, "verse_number": "९-१-१९", "content_sanskrit": "अहो सुबलवान्कालो गतिश्च परमा तथा।\nशुक्रतुल्यबलाः सर्वे यत्राहन्यन्त पार्थिवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2065244, "chapter_id": 2382, "verse_number": "९-१-२०", "content_sanskrit": "तं दृष्ट्वैव पुरे राजञ्जनः सर्वः स्म सञ्जयम्।\nप्ररुरोद भयोद्विग्नो हा राजन्निति सुस्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2065245, "chapter_id": 2382, "verse_number": "९-१-२१", "content_sanskrit": "आकुमारं नरव्याघ्र तत्पुरं वै समन्ततः।\nआर्तनादं महच्चक्रे श्रुत्वा विनिहतं नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2065246, "chapter_id": 2382, "verse_number": "९-१-२२", "content_sanskrit": "तथा स विह्वलः सूतः प्रविश्य नृपतिक्षयम्।\nददर्श नृपतिश्रेष्ठं प्रज्ञाचक्षुषमीश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2065247, "chapter_id": 2382, "verse_number": "९-१-२३", "content_sanskrit": "दृष्ट्वा चासीनमनघं समन्तात्परिवारितम्।\nस्नुषामिर्भरतश्रेष्ठ गान्धार्या विदुरेण च।\nतथाऽन्यैश्च सुहृद्भिश्च ज्ञातिमिश्च हितैषिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2065248, "chapter_id": 2382, "verse_number": "९-१-२४", "content_sanskrit": "तमेव चार्थं ध्यायन्तं कर्णस्य निधनं प्रति।\nरुदन्नेवाब्रवीद्वाक्यं राजानं जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2065249, "chapter_id": 2382, "verse_number": "९-१-२५", "content_sanskrit": "नातिहृष्टमनाः सूतो बाष्पसन्दिग्धया गिरा।\nसञ्जयोऽहं नरव्याघ्र नमस्ते भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2065250, "chapter_id": 2382, "verse_number": "९-१-२६", "content_sanskrit": "मद्राधिपो हतः शल्यः शकुनिः सौबलस्तथा।\nउलूकः पुरुषव्याघ्र कैतव्यो दृढविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2065251, "chapter_id": 2382, "verse_number": "९-१-२७", "content_sanskrit": "संशप्तका हताः सर्वे काम्भोजाश्च शकैः सह।\nम्लेच्छाश्च पार्वतीयाश्च यवनाश्च निपातिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2065252, "chapter_id": 2382, "verse_number": "९-१-२८", "content_sanskrit": "प्राच्या हता महाराज दाक्षिणात्याश्च सर्वशः।\nउदीच्याश्च हताः सर्वे प्रतीच्याश्च नरोत्तमाः।\nराजानो राजपुत्राश्च सर्वे विनिहता नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2065253, "chapter_id": 2382, "verse_number": "९-१-२९", "content_sanskrit": "कर्णपुत्रो हतः शूरः सत्यसेनो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2065254, "chapter_id": 2382, "verse_number": "९-१-३०", "content_sanskrit": "दुर्योधनो हतो राजा ययोक्तं पाण्डवेन ह।\nxxxxxx महाराज शेते पांसुषु रूषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2065255, "chapter_id": 2382, "verse_number": "९-१-३१", "content_sanskrit": "xxxxxx हतो xxx जञ्शिखण्डी चापराजितः।\nउत्तमौज युधामन्युस्तथा सर्वे प्रभद्रकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2065256, "chapter_id": 2382, "verse_number": "९-१-३२", "content_sanskrit": "पाञ्चालश्च नरव्याघ्र चेदयश्च निषूदिताः।\nतव पुत्रा हताः सर्वे द्रौपदेयाश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2065257, "chapter_id": 2382, "verse_number": "९-१-३३", "content_sanskrit": "नरा विनिहताः सर्वे गजाश्च विनिपातिताः।\nरथिनत्र नरव्याघ्र हयाश्च निहता युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2065258, "chapter_id": 2382, "verse_number": "९-१-३४", "content_sanskrit": "निxxxx शिबिरं रावंजावकानां कृतं प्रभो।\nपाण्डवानां च शूराणां समासाद्य परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2065259, "chapter_id": 2382, "verse_number": "९-१-३५", "content_sanskrit": "xxxx स्रीशेषमभवज्जगत्कालेन मोहितम्।\nसप्त पाण़्डवतः शिष्टा धार्तराष्ट्रास्त्रयोरथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2065260, "chapter_id": 2382, "verse_number": "९-१-३६", "content_sanskrit": "ते चैव भ्रातरः पञ्च वासुदेवोऽथ सात्यकिः।\nकृपश्च कृतवर्मा च द्रौणिश्च जयतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2065261, "chapter_id": 2382, "verse_number": "९-१-३७", "content_sanskrit": "एते शेषा महाराज रथिनो नृपसत्तम।\nअक्षौहिणीनामष्टानां दशानां च न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2065262, "chapter_id": 2382, "verse_number": "९-१-३८", "content_sanskrit": "एते शेषा महाराज सर्वेऽन्ये निधनं गताः।\nकालेन निहतं सर्वं जगद्वै भरतर्षभ।\nदुर्योधनं वै पुरतः कृत्वा सर्वे नरा हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2065263, "chapter_id": 2382, "verse_number": "९-१-३९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2065264, "chapter_id": 2382, "verse_number": "९-१-३९", "content_sanskrit": "एतच्छ्रुत्वा वचः क्रूरं धृतराष्ट्रो जनेश्वरः।\nनिपपात स राजेन्द्रो गतसत्वो महीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2065265, "chapter_id": 2382, "verse_number": "९-१-४०", "content_sanskrit": "तस्मिन्निपतिते वीरे विदुरोऽपि महायशाः।\nनिपपात महाराज शोकव्यसनकर्शितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2065266, "chapter_id": 2382, "verse_number": "९-१-४१", "content_sanskrit": "गान्धारी च महाभागा सर्वाश्च कुरुयोषितः।\nपतिताः सहसा भूमौ श्रुत्वा घोरतरं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2065267, "chapter_id": 2382, "verse_number": "९-१-४२", "content_sanskrit": "निःसंज्ञं पतितं भूमौ तदाऽऽसीद्राजमण्डलम्।\nविलापमुक्तोपहतं चित्रं न्यस्तं पटे यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2065268, "chapter_id": 2382, "verse_number": "९-१-४३", "content_sanskrit": "कृच्छ्रेण तु ततो राजा धृतराष्ट्रो महीपतिः।\nशनैरलभत प्राणान्पुत्रव्यसनकर्शितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2065269, "chapter_id": 2382, "verse_number": "९-१-४४", "content_sanskrit": "लब्ध्वा तु स नृपः प्राणान्वेपमानः सुदुःखितः।\nनिरीक्ष्य च दिशः सर्वाः क्षत्तारं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2065270, "chapter_id": 2382, "verse_number": "९-१-४५", "content_sanskrit": "विद्धि क्षत्तर्महाप्राज्ञ त्वं गतिर्भरतर्षभ।\nममानाथस्य सुभृशं पुत्रैर्हीनस्य सर्वशः।\nएवमुक्त्वा ततो भूयो विसंज्ञो निपपात ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2065271, "chapter_id": 2382, "verse_number": "९-१-४६", "content_sanskrit": "तं तथा पतितं दृष्ट्वा बान्धवा येऽस्य केचन।\nशीतैस्ते सिषिचुस्तोयैर्विव्यजुर्व्यजनैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2065272, "chapter_id": 2382, "verse_number": "९-१-४७", "content_sanskrit": "स तु दीर्घेण कालेन प्रत्याश्वस्तो नराधिपः।\nतूष्णीमासीन्महीपालः पुत्रव्यसनकर्शितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2065273, "chapter_id": 2382, "verse_number": "९-१-४८", "content_sanskrit": "निःश्वसञ्जिह्मग इव कुम्भक्षिप्तोऽभवन्नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2065274, "chapter_id": 2382, "verse_number": "९-१-४९", "content_sanskrit": "सञ्जयोऽप्यरुदत्तत्र दृष्ट्वा राजानमातुरम्।\nतथा सर्वाः स्त्रियश्चैव गान्धारी च यशस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2065275, "chapter_id": 2382, "verse_number": "९-१-५०", "content_sanskrit": "ततो दीर्घेण कालेन विदुरं वाक्यमब्रवीत्।\nधृतराष्ट्रो नरश्रेष्ठ मुह्यमानो मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2065276, "chapter_id": 2382, "verse_number": "९-१-५१", "content_sanskrit": "गच्छन्तु योषितः सर्वा गान्धारी च यशस्विनी।\nतथेमे सुहृदः सर्वे मुह्यते मे मनो भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2065277, "chapter_id": 2382, "verse_number": "९-१-५२", "content_sanskrit": "एवमुक्तस्ततः क्षत्ता ताः स्त्रियो भरतर्षभ।\nविसर्जयामास शनैर्मुह्यमानः पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2065278, "chapter_id": 2382, "verse_number": "९-१-५३", "content_sanskrit": "निश्चक्रमुस्ततः सर्वाः स्त्रियो भरतसत्तम।\nसुहृदश्च तथा सर्वे दृष्ट्वा राजानमातुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2065279, "chapter_id": 2382, "verse_number": "९-१-५४", "content_sanskrit": "ततो नरपतिस्तत्र लब्ध्वा संज्ञां परन्तपः।\nगतिर्मे को भवेदद्य इति चिन्तासमाकुलः।\nअपृच्छत्सञ्जयं तत्र रोदमानं भृशातुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2065280, "chapter_id": 2382, "verse_number": "९-१-५५", "content_sanskrit": "प्राञ्जलिं सञ्जयं दृष्ट्वा रोदमानं मुहुर्मुहुः।\nज्ञातीन्स्त्रियोऽथ निर्याप्य प्रविश्य विदुरःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2065281, "chapter_id": 2382, "verse_number": "९-१-५६", "content_sanskrit": "राजानं शोचमानस्तु तं शोचन्तं मुहुर्मुहुः।\nसमाश्वासयत क्षत्ता वचसा मधुरेण च॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2065282, "chapter_id": 2382, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि शल्यवधपर्वणि प्रथमोऽध्यायः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]