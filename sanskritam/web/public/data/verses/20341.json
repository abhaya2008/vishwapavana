[{"id": 7000341000, "chapter_id": 20341, "verse_number": "२-१३-१", "content_sanskrit": "सोमशर्मोवाच ।\nलक्षणं ब्रह्मचर्यस्य तन्मे विस्तरतो वद ।\nकीदृशं ब्रह्मचर्यं च यदि जानासि भामिनि॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000341001, "chapter_id": 20341, "verse_number": "२-१३-२", "content_sanskrit": "नित्यं सत्ये रतिर्यस्य पुण्यात्मा तुष्टितां व्रजेत् ।\nऋतौ प्राप्ते व्रजेन्नारीं स्वीयां दोषविवर्जितः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000341002, "chapter_id": 20341, "verse_number": "२-१३-३", "content_sanskrit": "स्वकुलस्य सदाचारं कदानैव विमुंचति ।\nएतदेव समाख्यातं गृहस्थस्य द्विजोत्तम॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000341003, "chapter_id": 20341, "verse_number": "२-१३-४", "content_sanskrit": "ब्रह्मचर्यं मया प्रोक्तं गृहिणामुत्तमं किल ।\nयतीनां तु प्रवक्ष्यामि तन्मे निगदतः शृणु॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000341004, "chapter_id": 20341, "verse_number": "२-१३-५", "content_sanskrit": "दमसत्यसमायुक्तः पापाद्भीतस्तु सर्वदा ।\nभार्यासंगं वर्जयित्वा ध्यानज्ञानप्रतिष्ठितः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000341005, "chapter_id": 20341, "verse_number": "२-१३-६", "content_sanskrit": "यतीनां ब्रह्मचर्यं च समाख्यातं तवाग्रतः ।\nतप एव प्रवक्ष्यामि तन्मेनिगदतः शृणु॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000341006, "chapter_id": 20341, "verse_number": "२-१३-७", "content_sanskrit": "आचारेण प्रवर्तेत कामक्रोधविवर्जितः ।\nप्राणिनामुपकाराय संस्थितौद्यमावृतः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000341007, "chapter_id": 20341, "verse_number": "२-१३-८", "content_sanskrit": "तप एवं समाख्यातं सत्यमेवं वदाम्यहम् ।\nपरद्रव्येष्वलोलुप्त्वं परस्त्रीषु तथैव च॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000341008, "chapter_id": 20341, "verse_number": "२-१३-९", "content_sanskrit": "दृष्ट्वा मतिर्न यस्य स्यात्स सत्यः परिकीर्तितः ।\nदानमेव प्रवक्ष्यामि येन जीवंति मानवाः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000341009, "chapter_id": 20341, "verse_number": "२-१३-१०", "content_sanskrit": "आत्मसौख्यं प्रतीच्छेद्यः स इहैव परत्र वा ।\nअन्नस्यापि महादानं सुखस्यैव ध्रुवस्य वा॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000341010, "chapter_id": 20341, "verse_number": "२-१३-११", "content_sanskrit": "ग्रासमात्रं तथा देयं क्षुधार्ताय न संशयः ।\nदत्ते सति महत्पुण्यममृतं सोश्नुते सदा॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000341011, "chapter_id": 20341, "verse_number": "२-१३-१२", "content_sanskrit": "दिनेदिने प्रदातव्यं यथाविभवसंभवम् ।\nतृणं शय्यां च वचनं गृहच्छायां सुशीतलाम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000341012, "chapter_id": 20341, "verse_number": "२-१३-१३", "content_sanskrit": "भूमिमापस्तथा चान्नं प्रियवाक्यमनुत्तमम् ।\nआसनं वचनालापं कौटिल्येन विवर्जितम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000341013, "chapter_id": 20341, "verse_number": "२-१३-१४", "content_sanskrit": "आत्मनो जीवनार्थाय नित्यमेव करोति यः ।\nदेवान्पितॄन्समभ्यर्च्य एवं दानं ददाति यः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000341014, "chapter_id": 20341, "verse_number": "२-१३-१५", "content_sanskrit": "इहैव मोदते सो वै परत्र हि तथैव च ।\nअवंध्यं दिवसं यो वै दानाध्ययनकर्मभिः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000341015, "chapter_id": 20341, "verse_number": "२-१३-१६", "content_sanskrit": "प्रकुर्यान्मानुषो भूत्वा स देवो नात्र संशयः ।\nनियमं च प्रवक्ष्यामि धर्मसाधनमुत्तमम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000341016, "chapter_id": 20341, "verse_number": "२-१३-१७", "content_sanskrit": "देवानां ब्राह्मणानां च पूजास्वभिरतो हि यः ।\nनित्यं नियमसंयुक्तो दानव्रतेषु सुव्रत॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000341017, "chapter_id": 20341, "verse_number": "२-१३-१८", "content_sanskrit": "उपकारेषु पुण्येषु नियमोऽयं प्रकीर्तितः ।\nक्षमारूपं प्रवक्ष्यामि श्रूयतां द्विजसत्तम॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000341018, "chapter_id": 20341, "verse_number": "२-१३-१९", "content_sanskrit": "पराक्रोशं हि संश्रुत्य ताडिते सति केनचित् ।\nक्रोधं न चैव गच्छेत्तु ताडितो न हि ताडयेत्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000341019, "chapter_id": 20341, "verse_number": "२-१३-२०", "content_sanskrit": "सहिष्णुः स्यात्स धर्मात्मा नहि रागं प्रयाति च ।\nसमश्नाति परं सौख्यमिह चामुत्र वापि च॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000341020, "chapter_id": 20341, "verse_number": "२-१३-२१", "content_sanskrit": "एवं क्षमा समाख्याता शौचमेवं वदाम्यहम् ।\nसबाह्याभ्यंतरे यो वै शुद्धो रागविवर्जितः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000341021, "chapter_id": 20341, "verse_number": "२-१३-२२", "content_sanskrit": "स्नानाचमनकैरेव व्यवहारेण वर्तते ।\nशौचमेवं समाख्यातमहिंसां तु वदाम्यहम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000341022, "chapter_id": 20341, "verse_number": "२-१३-२३", "content_sanskrit": "तृणमपि विना कार्यञ्छेत्तव्यं न विजानता ।\nअहिंसानिरतो भूयाद्यथात्मनि तथापरे॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000341023, "chapter_id": 20341, "verse_number": "२-१३-२४", "content_sanskrit": "शांतिमेव प्रक्ष्यामि शांत्या सुखं समश्नुते ।\nशांतिरेव प्रकर्तव्या क्लेशान्नैव परित्यजेत्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000341024, "chapter_id": 20341, "verse_number": "२-१३-२५", "content_sanskrit": "भूतवैरं विसृज्यैव मन एवं प्रकारयेत् ।\nएवं शांतिः समाख्याता अस्तेयं तु वदाम्यहम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000341025, "chapter_id": 20341, "verse_number": "२-१३-२६", "content_sanskrit": "परस्वं नैव हर्तव्यं परजाया तथैव च ।\nमनोभिर्वचनैः कायैर्मन एवं प्रकारयेत्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000341026, "chapter_id": 20341, "verse_number": "२-१३-२७", "content_sanskrit": "दममेव प्रवक्ष्यामि तवाग्रे द्विजसत्तम ।\nदमनादिंद्रियाणां वै मनसोपि विकारिणः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000341027, "chapter_id": 20341, "verse_number": "२-१३-२८", "content_sanskrit": "औद्धत्यं नाशयेत्तेषां स चैतन्यो वशी तदा ।\nशुश्रूषां तु प्रवक्ष्यामि धर्मशास्त्रेषु यादृशी॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000341028, "chapter_id": 20341, "verse_number": "२-१३-२९", "content_sanskrit": "पूर्वाचार्यैर्यथा प्रोक्ता तामेवं प्रवदाम्यहम् ।\nवाचा देहेन मनसा गुरुकार्यं प्रसाधयेत्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000341029, "chapter_id": 20341, "verse_number": "२-१३-३०", "content_sanskrit": "जायतेऽनुग्रहो यत्र शुश्रूषा सा निगद्यते ।\nसांगो धर्मः समाख्यातस्तवाग्रे द्विजसत्तम॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000341030, "chapter_id": 20341, "verse_number": "२-१३-३१", "content_sanskrit": "अन्यच्च ते प्रवक्ष्यामि श्रोतुमिच्छसि यत्पते ।\nईदृशे चापि धर्मे तु वर्तते यो नरः सदा॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000341031, "chapter_id": 20341, "verse_number": "२-१३-३२", "content_sanskrit": "संसारे तस्य संभूतिः पुनरेव न जायते ।\nस्वर्गं गच्छति धर्मेण सत्यंसत्यं वदाम्यहम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000341032, "chapter_id": 20341, "verse_number": "२-१३-३३", "content_sanskrit": "एवं ज्ञात्वा महाप्राज्ञ धर्ममेव व्रजस्व हि ।\nसर्वं हि प्राप्यते कांत यदसाध्यं महीतले॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000341033, "chapter_id": 20341, "verse_number": "२-१३-३४", "content_sanskrit": "धर्मप्रसादतस्तस्मात्कुरु वाक्यं ममैव हि ।\nभार्यायास्तुवचः श्रुत्वा सोमशर्मा सुबुद्धिमान्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000341034, "chapter_id": 20341, "verse_number": "२-१३-३५", "content_sanskrit": "पुनः प्रोवाच तां भार्यां सुमनां धर्मवादिनीम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]