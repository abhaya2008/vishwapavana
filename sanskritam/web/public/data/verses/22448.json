[{"id": 7002448000, "chapter_id": 22448, "verse_number": "१-११०-१", "content_sanskrit": "ब्रह्मोवाच ।\nशुक्लपक्षे तु सप्तम्यां मासि भाद्रपदेऽच्युत ।\nप्रणम्य शिरसादित्यं पूजयेत्सप्तवाहनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002448001, "chapter_id": 22448, "verse_number": "१-११०-२", "content_sanskrit": "पुष्पधूपादिभिर्वीर कुतपानां च तर्पणैः ।\nपाषण्डादिभिरालापमकुर्वन्नियतात्मवान् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002448002, "chapter_id": 22448, "verse_number": "१-११०-३", "content_sanskrit": "विप्राय दक्षिणां दत्त्वा नक्तं भुञ्जीत वाग्यतः ।\nतिष्ठन्व्रजन्प्रस्थितश्च क्षुतप्रस्खलितादिषु ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002448003, "chapter_id": 22448, "verse_number": "१-११०-४", "content_sanskrit": "आदित्यनामस्मरणं कुर्वन्नुच्चारणं तथा ।\nअनेनैव विधानेन मासान्द्वादश वै क्रमात् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002448004, "chapter_id": 22448, "verse_number": "१-११०-५", "content_sanskrit": "उपोष्य पारणे पूर्णे समभ्यर्च्य जगद्गुरुम् ।\nपुण्येन श्रावणेनेह प्रीणयन्पुष्टिमश्नुते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002448005, "chapter_id": 22448, "verse_number": "१-११०-६", "content_sanskrit": "अनन्तं श्रावणेनेह यतः फलमुदाहृतम् ।\nतेनादित्यं समभ्यर्च्य तदेव लभते फलम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002448006, "chapter_id": 22448, "verse_number": "१-११०-७", "content_sanskrit": "एवं यः पुरुषः कुर्यादादित्याराधनं शुचिः ।\nप्राप्येह विपुलं भोगं धर्ममर्थं तथाव्ययम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002448007, "chapter_id": 22448, "verse_number": "१-११०-८", "content_sanskrit": "अमुत्र लोकमायाति दिव्ये खे गीतसंयुते ।\nनारी वा स्वर्गमभ्येत्य ह्यनन्तं फलमश्नुते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}]