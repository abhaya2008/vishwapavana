[{"id": 900000989, "chapter_id": 8200, "verse_number": "8.1", "content_sanskrit": "ऊर्ध्वमूलोऽशाख एषोऽश्वत्थः सनातनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900000990, "chapter_id": 8200, "verse_number": "8.2", "content_sanskrit": "यदिदं किञ्च जगत् सर्वं प्राण एजति निःसृतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900000991, "chapter_id": 8200, "verse_number": "8.3", "content_sanskrit": "भयादस्याग्निस्तपति भयात् तपति सूर्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900000992, "chapter_id": 8200, "verse_number": "8.4", "content_sanskrit": "इह चेदशकद् बोद्धुं प्राक् शरीरस्य विस्रसः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900000993, "chapter_id": 8200, "verse_number": "8.5", "content_sanskrit": "यथादर्शे तथाऽऽत्मनि यथा स्वप्ने तथा पितृलोके", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900000994, "chapter_id": 8200, "verse_number": "8.6", "content_sanskrit": "इन्द्रियाणां पृथग्भावमुदयास्तमयौ च यत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900000995, "chapter_id": 8200, "verse_number": "8.7", "content_sanskrit": "इन्द्रियेभ्यः परं मनो मनसः सत्त्वमुत्तमम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900000996, "chapter_id": 8200, "verse_number": "8.8", "content_sanskrit": "न सन्दृशे तिष्ठति रूपमस्य न चक्षुषा पश्यति कश्चिदेनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900000997, "chapter_id": 8200, "verse_number": "8.9", "content_sanskrit": "यदा पञ्चावतिष्ठन्ते ज्ञानानि मनसा सह", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900000998, "chapter_id": 8200, "verse_number": "8.10", "content_sanskrit": "तां योगमिति मन्यन्ते स्थिरामिन्द्रियधारणाम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900000999, "chapter_id": 8200, "verse_number": "8.11", "content_sanskrit": "नैव वाचा न मनसा प्राप्तुं शक्यो न चक्षुषा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900001000, "chapter_id": 8200, "verse_number": "8.12", "content_sanskrit": "अस्तीत्येवोपलब्धव्यस्तत्त्वभावेन चोभयोः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900001001, "chapter_id": 8200, "verse_number": "8.13", "content_sanskrit": "यदा सर्वे प्रमुच्यन्ते कामा येऽस्य हृदि स्थिताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900001002, "chapter_id": 8200, "verse_number": "8.14", "content_sanskrit": "यदा सर्वे प्रभिद्यन्ते हृदयस्येह ग्रन्थयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900001003, "chapter_id": 8200, "verse_number": "8.15", "content_sanskrit": "शतं चैका च हृदयस्य नाड्यस्तासां मूर्धानमभिनिःसृतैका", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900001004, "chapter_id": 8200, "verse_number": "8.16", "content_sanskrit": "अङ्गुष्ठमात्रः पुरुषोऽन्तरात्मा सदा जनानां हृदये सन्निविष्टः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900001005, "chapter_id": 8200, "verse_number": "8.17", "content_sanskrit": "मृत्युप्रोक्तां नाचिकेतोऽथ लब्ध्वा विद्यामेतां योगविधिं च कृत्स्नम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900001006, "chapter_id": 8200, "verse_number": "8.18", "content_sanskrit": "ओम् शान्तिः शान्तिः शान्तिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]