[{"id": 2006947, "chapter_id": 1136, "verse_number": "१-१३७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2006948, "chapter_id": 1136, "verse_number": "१-१३७-१", "content_sanskrit": "ततः क्षत्ता च भीष्मश्च व्यासो राजा च बन्धुभिः।\nददुः श्राद्धं तदा पाण्डोः स्वधामृतमयं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2006949, "chapter_id": 1136, "verse_number": "१-१३७-२", "content_sanskrit": "पुरोहितसहायास्ते यथान्यायमकुर्वत।\nकुरूंश्च विप्रमुख्यांश्च भोजयित्वा सहस्रशः।\nरत्नौघान्द्विजमुख्येभ्यो दत्त्वा ग्रामवरांस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2006950, "chapter_id": 1136, "verse_number": "१-१३७-३", "content_sanskrit": "कृतशौचांस्ततस्तांस्तु पाण्डवान्भरतर्षभान्।\nआदाय विविशुः सर्वे पुरं वारणसाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2006951, "chapter_id": 1136, "verse_number": "१-१३७-४", "content_sanskrit": "सततं स्मानुशोचन्तस्तमेव भरतर्षभम्।\nपौरजानपदाः सर्वे मृतं स्वमिव बान्धवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2006952, "chapter_id": 1136, "verse_number": "१-१३७-५", "content_sanskrit": "श्राद्धावसाने तु तदा दृष्ट्वा तं दुःखितं जनम्।\nसंमूढां दुःखशोकार्तां व्यासो मातरमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2006953, "chapter_id": 1136, "verse_number": "१-१३७-६", "content_sanskrit": "अतिक्रान्तसुखाः कालाः पर्युपस्थितदारुणाः।\nश्वःश्वः पापिष्ठदिवसाः पृथिवी गतयौवना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2006954, "chapter_id": 1136, "verse_number": "१-१३७-७", "content_sanskrit": "बहुमायासमाकीर्णो नानादोषसमाकुलः।\nलुप्तधर्मक्रियाचारो घोरः कालो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2006955, "chapter_id": 1136, "verse_number": "१-१३७-८", "content_sanskrit": "कुरूणामनयाच्चापि पृथिवी न भविष्यति।\nगच्छ त्वं योगमास्थाय युक्ता वस तपोवने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2006956, "chapter_id": 1136, "verse_number": "१-१३७-९", "content_sanskrit": "माद्राक्षीस्त्वं कुलस्यास्य घोरं संक्षयमात्मनः।\nतथेति समनुज्ञाय सा प्रविश्याब्रवीत्स्नुषाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2006957, "chapter_id": 1136, "verse_number": "१-१३७-१०", "content_sanskrit": "अम्बिक तव पौत्रस्य दुर्नयात्किल भारताः।\nसानुबन्धा विनङ्क्ष्यन्ति पौराश्चैवेति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2006958, "chapter_id": 1136, "verse_number": "१-१३७-११", "content_sanskrit": "तत्कौसल्यामिमामार्तां पुत्रशोकाभिपीडिताम्।\nवनमादाय भद्रं ते गच्छावो यदि मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2006959, "chapter_id": 1136, "verse_number": "१-१३७-१२", "content_sanskrit": "तथेत्युक्ता त्वम्बिकया भीष्ममामन्त्र्य सुव्रता।\nवनं ययौ सत्यवती स्नुषाभ्यां सह भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2006960, "chapter_id": 1136, "verse_number": "१-१३७-१३", "content_sanskrit": "ताः सुघोरं तपस्तप्त्वा देव्यो भरतसत्तम॥\nदेहं त्यक्त्वा महाराज गतिमिष्टां ययुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2006961, "chapter_id": 1136, "verse_number": "१-१३७-१४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2006962, "chapter_id": 1136, "verse_number": "१-१३७-१४", "content_sanskrit": "अथाप्तवन्तो वेदोक्तान्संस्कारान्पाण्डवास्तदा।\nसंव्यवर्धन्त भोगांस्ते भुञ्जानाः पितृवेश्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2006963, "chapter_id": 1136, "verse_number": "१-१३७-१५", "content_sanskrit": "धार्तराष्ट्रैश्च सहिताः क्रीडन्तो मुदिताः सुखम्।\nबालक्रीडासु सर्वासु विशिष्टास्तेजसाऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2006964, "chapter_id": 1136, "verse_number": "१-१३७-१६", "content_sanskrit": "जवे लक्ष्याभिहरणे भोज्ये पांसुविकर्षणे।\nधार्तराष्ट्रान्भीमसेनः सर्वान्स परिमर्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2006965, "chapter_id": 1136, "verse_number": "१-१३७-१७", "content_sanskrit": "हर्षात्प्रक्रीडमानांस्तान् गृह्य राजन्निलीयते।\nशिरःसु विनिगृह्यैतान्योजयामास पाण्डवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2006966, "chapter_id": 1136, "verse_number": "१-१३७-१८", "content_sanskrit": "शतमेकोत्तरं तेषां कुमाराणां महौजसाम्।\nएक एव निगृह्णाति नातिकृच्छ्राद्वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2006967, "chapter_id": 1136, "verse_number": "१-१३७-१९", "content_sanskrit": "कचेषु च निगृह्यैनान्विनिहत्य बलाद्बली।\nचकर्ष क्रोशतो भूमौ घृष्टजानुशिरोंसकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2006968, "chapter_id": 1136, "verse_number": "१-१३७-२०", "content_sanskrit": "दश बालाञ्जले क्रीडन्भुजाभ्यां परिगृह्य सः।\nआस्ते स्म सलिले मग्नो मृतकल्पान्विमुञ्चति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2006969, "chapter_id": 1136, "verse_number": "१-१३७-२१", "content_sanskrit": "फलानि वृक्षमारुह्य विचिन्वन्ति च ये तदा।\nतदा पादप्रहारेण भीमः कम्पयते द्रुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2006970, "chapter_id": 1136, "verse_number": "१-१३७-२२", "content_sanskrit": "प्रहारवेगाभिहता द्रुमा व्याघूर्णितास्ततः।\nसफलाः प्रपतन्ति स्म द्रुमात्स्रस्ताः कुमारकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2006971, "chapter_id": 1136, "verse_number": "१-१३७-२३", "content_sanskrit": "केचिद्भग्नशिरोरस्काः केचिद्भग्नकटीमुखाः।\nनिपेतुर्भ्रातरः सर्वे भीमसेनभुजार्दिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2006972, "chapter_id": 1136, "verse_number": "१-१३७-२४", "content_sanskrit": "न ते नियुद्धे न जवे न योग्यासु कदाचन।\nकुमारा उत्तरं चक्रुः स्पर्धमाना वृकोदरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2006973, "chapter_id": 1136, "verse_number": "१-१३७-२५", "content_sanskrit": "एवं स धार्तराष्ट्रांश्च स्पर्धमानो वृकोदरः।\nअप्रियेऽतिष्ठदत्यन्तं बाल्यान्न द्रोहचेतसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2006974, "chapter_id": 1136, "verse_number": "१-१३७-२६", "content_sanskrit": "ततो बलमतिख्यातं धार्तराष्ट्रः प्रतापवान्।\nभीमसेनस्य तज्ज्ञात्वा दुष्टभावमदर्शयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2006975, "chapter_id": 1136, "verse_number": "१-१३७-२७", "content_sanskrit": "तस्य धर्मादपेतस्य पापानि परिपश्यतः।\nमोहादैश्वर्यलोभाच्च पापा मतिरजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2006976, "chapter_id": 1136, "verse_number": "१-१३७-२८", "content_sanskrit": "अयं बलवतां श्रेष्ठः कुन्तीपुत्रो वृकोदरः।\nमध्यमः कुन्तिपुत्राणां निकृत्या सन्निगृह्यतां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2006977, "chapter_id": 1136, "verse_number": "१-१३७-२९", "content_sanskrit": "प्राणवान्विक्रमी चैव शौर्येण महताऽन्वितः।\nस्पर्धते चापि सहितानस्मानेको वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2006978, "chapter_id": 1136, "verse_number": "१-१३७-३०", "content_sanskrit": "तं तु सुप्तं पुरोद्याने गङ्गायां प्रक्षिपामहे।\nअथ तस्मादवरजं श्रेष्ठं चैव युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2006979, "chapter_id": 1136, "verse_number": "१-१३७-३१", "content_sanskrit": "प्रसह्य बन्धने बद्ध्वा प्रशासिष्ये वसुन्धराम्।\nएवं स निश्चयं पापः कृत्वा दुर्योधनस्तदा।\nनित्यमेवान्तरप्रेक्षी भीमस्यासीन्महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2006980, "chapter_id": 1136, "verse_number": "१-१३७-३२", "content_sanskrit": "ततो जलविहारार्थं कारयामास भारत।\nचैलकम्बलवेश्मानि विचित्राणि महान्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2006981, "chapter_id": 1136, "verse_number": "१-१३७-३३", "content_sanskrit": "सर्वकामैः सुपूर्णानि पताकोच्छ्रायवन्ति च।\nतत्र संजनयामास नानागाराण्यनेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2006982, "chapter_id": 1136, "verse_number": "१-१३७-३४", "content_sanskrit": "उदकक्रीडनं नाम कारयामास भारत।\nप्रमाणकोट्यां तं देशं स्थलं किंचिदुपेत्यह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2006983, "chapter_id": 1136, "verse_number": "१-१३७-३५", "content_sanskrit": "क्रीडावसाने ते सर्वे शुचिवस्त्राः स्वलङ्कृताः।\nसर्वकामसमृद्धं तदन्नं बुभुजिरे शनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2006984, "chapter_id": 1136, "verse_number": "१-१३७-३६", "content_sanskrit": "दिवसान्ते परिश्रान्ता विहृत्य च कुरूद्वहाः।\nविहारावसथेष्वेव वीरा वासमरोचयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2006985, "chapter_id": 1136, "verse_number": "१-१३७-३७", "content_sanskrit": "खिन्नस्तु बलवान्भीमो व्यायामाभ्यधिकस्तदा।\nवाहयित्वा कुमारांस्ताञ्जलक्रीडागतान्विभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2006986, "chapter_id": 1136, "verse_number": "१-१३७-३८", "content_sanskrit": "प्रमाणकोट्यां वासार्थं सुष्वापारुह्य तत्स्थलम्।\nशीतं वासं समासाद्य शान्तो मदविमोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2006987, "chapter_id": 1136, "verse_number": "१-१३७-३९", "content_sanskrit": "निश्चेष्टः पाण्डवो राजन्सुष्वाप मृतवत्क्षितौ।\nततो बद्ध्वा लतापाशैर्भीमं दुर्योधनः शनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2006988, "chapter_id": 1136, "verse_number": "१-१३७-४०", "content_sanskrit": "प्रमाणकोट्यां संसुप्तं गङ्गायां प्राक्षिपज्जले।\nततः प्रबुद्धः कौन्तेयः सर्वान्संछिद्य बन्धनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2006989, "chapter_id": 1136, "verse_number": "१-१३७-४१", "content_sanskrit": "उदतिष्ठद्बलाद्भूयो भीमः प्रहरतां वरः।\nस विमुक्तो महातेजा नाज्ञासीत्तेन तत्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2006990, "chapter_id": 1136, "verse_number": "१-१३७-४२", "content_sanskrit": "पुनर्निद्रावशं प्राप्तस्तत्रैव प्रास्वपद्बली।\nअर्धरात्र्यां व्यतीतायामुत्तस्थुः कुरुपाण्जवाः।\nदुर्योधनस्तु कौन्तेयं दृष्ट्वा निर्वेदमभ्यगात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2006991, "chapter_id": 1136, "verse_number": "१-१३७-४३", "content_sanskrit": "सुप्तं चापि पुनः सर्पैस्तीक्ष्णदंष्ट्रैर्महाविषैः।\nकुपितैर्दंशयामास सर्वेष्वेवाङ्गसन्धिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2006992, "chapter_id": 1136, "verse_number": "१-१३७-४४", "content_sanskrit": "दंष्ट्राश्च दंष्ट्रिणां मर्मस्वपि तेन निपातिताः।\nत्वचं न चास्य बिभिदुः सारत्वात्पृथुपक्षसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2006993, "chapter_id": 1136, "verse_number": "१-१३७-४५", "content_sanskrit": "प्रबुद्धो भीसेनस्तान्सर्वान्सर्पानपोथयत्।\nसारथिं चास्य दयितमपहस्तेन जघ्निवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2006994, "chapter_id": 1136, "verse_number": "१-१३७-४६", "content_sanskrit": "तथान्यदिवसे राजन्हन्तुकामोऽत्यमर्षणः।\nवलनेन सहामन्त्र्य सौबलस्य मते स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2006995, "chapter_id": 1136, "verse_number": "१-१३७-४७", "content_sanskrit": "भोजने भीमसेनस्य ततः प्राक्षेपयद्विषम्।\nकालकूटं विषं तीक्ष्णं संभृतं रोमहर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2006996, "chapter_id": 1136, "verse_number": "१-१३७-४८", "content_sanskrit": "तच्चापि भुक्त्वाऽजरदॉयदविकारो वृकोदरः।\nविकारं नाभ्यजनयत्सुतीक्ष्णमपि तद्विषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2006997, "chapter_id": 1136, "verse_number": "१-१३७-४९", "content_sanskrit": "भीमसंहननो भीमस्त्समादजरयद्विषम्।\nततोऽन्यदिवसे राजन्हन्तुकामो वृकोदरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2006998, "chapter_id": 1136, "verse_number": "१-१३७-५०", "content_sanskrit": "सौबलेन सहायेन धार्तराष्ट्रोऽभ्यचिन्तयत्।\nचिन्तयन्नालभन्निद्रां दिवारात्रमतन्द्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2006999, "chapter_id": 1136, "verse_number": "१-१३७-५१", "content_sanskrit": "एवं दुर्योधनः कर्णः शकुनिश्चापि सौबलः।\nअनेकैरप्युपायैस्ताञ्जिघांसन्ति स्म पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2007000, "chapter_id": 1136, "verse_number": "१-१३७-५२", "content_sanskrit": "वैश्या पुत्रस्तदाचष्ट पार्थानां हितकाम्यया।\nपाण्डवा ह्यपि तत्सर्वं प्रत्यजानन्नरिन्दमाः।\nउद्भावनमकुर्वन्तो विदुरस्य मते स्थिताः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2007001, "chapter_id": 1136, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभाऱते आदिपर्वणि संभवपर्वणि सप्तत्रिंशदधिकशततमोऽध्यायः॥ १३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]