[{"id": 5000074000, "chapter_id": 9074, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे चतुःसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000074001, "chapter_id": 9074, "verse_number": "१-७४-१", "content_sanskrit": "अथ रात्र्यां व्यतीतायां विश्वामित्रो महामुनिः।\nआपृष्ट्वा तौ च राजानौ जगामोत्तरपर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000074002, "chapter_id": 9074, "verse_number": "१-७४-२", "content_sanskrit": "विश्वामित्रे गते राजा वैदेहं मिथिलाधिपम्।\nआपृष्ट्वैव जगामाशु राजा दशरथः पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000074003, "chapter_id": 9074, "verse_number": "१-७४-३", "content_sanskrit": "अथ राजा विदेहानां ददौ कन्याधनं बहु।\nगवां शतसहस्राणि बहूनि मिथिलेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000074004, "chapter_id": 9074, "verse_number": "१-७४-४", "content_sanskrit": "कम्बलानां च मुख्यानां क्षौमान् कोट्यम्बराणि च।\nहस्त्यश्वरथपादातं दिव्यरूपं स्वलंकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000074005, "chapter_id": 9074, "verse_number": "१-७४-५", "content_sanskrit": "ददौ कन्याशतं तासां दासीदासमनुत्तमम्।\nहिरण्यस्य सुवर्णस्य मुक्तानां विद्रुमस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000074006, "chapter_id": 9074, "verse_number": "१-७४-६", "content_sanskrit": "ददौ राजा सुसंहृष्टः कन्याधनमनुत्तमम्।\nदत्त्वा बहुविधं राजा समनुज्ञाप्य पार्थिवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000074007, "chapter_id": 9074, "verse_number": "१-७४-७", "content_sanskrit": "प्रविवेश स्वनिलयं मिथिलां मिथिलेश्वरः।\nराजाप्ययोध्याधिपतिः सह पुत्रैर्महात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000074008, "chapter_id": 9074, "verse_number": "१-७४-८", "content_sanskrit": "ऋषीन् सर्वान् पुरस्कृत्य जगाम सबलानुगः।\nगच्छन्तं तु नरव्याघ्रं सर्षिसङ्घं सराघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000074009, "chapter_id": 9074, "verse_number": "१-७४-९", "content_sanskrit": "घोरास्तु पक्षिणो वाचो व्याहरन्ति समन्ततः।\nभौमाश्चैव मृगाः सर्वे गच्छन्ति स्म प्रदक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000074010, "chapter_id": 9074, "verse_number": "१-७४-१०", "content_sanskrit": "तान् दृष्ट्वा राजशार्दूलो वसिष्ठं पर्यपृच्छत।\nअसौम्याः पक्षिणो घोरा मृगाश्चापि प्रदक्षिणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000074011, "chapter_id": 9074, "verse_number": "१-७४-११", "content_sanskrit": "किमिदं हृदयोत्कम्पि मनो मम विषीदति।\nराज्ञो दशरथस्यैतच्छ्रुत्वा वाक्यं महानृषिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000074012, "chapter_id": 9074, "verse_number": "१-७४-१२", "content_sanskrit": "उवाच मधुरां वाणीं श्रूयतामस्य यत् फलम्।\nउपस्थितं भयं घोरं दिव्यं पक्षिमुखाच्च्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000074013, "chapter_id": 9074, "verse_number": "१-७४-१३", "content_sanskrit": "मृगाः प्रशमयन्त्येते संतापस्त्यज्यतामयम्।\nतेषां संवदतां तत्र वायुः प्रादुर्बभूव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000074014, "chapter_id": 9074, "verse_number": "१-७४-१४", "content_sanskrit": "कम्पयन् मेदिनीं सर्वां पातयंश्च महाद्रुमान्।\nतमसा संवृतः सूर्यः सर्वे नावेदिषुर्दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000074015, "chapter_id": 9074, "verse_number": "१-७४-१५", "content_sanskrit": "भस्मना चावृतं सर्वं सम्मूढमिव तद‍्बलम्।\nवसिष्ठ ऋषयश्चान्ये राजा च ससुतस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000074016, "chapter_id": 9074, "verse_number": "१-७४-१६", "content_sanskrit": "ससंज्ञा इव तत्रासन् सर्वमन्यद्विचेतनम्।\nतस्मिंस्तमसि घोरे तु भस्मच्छन्नेव सा चमूः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000074017, "chapter_id": 9074, "verse_number": "१-७४-१७", "content_sanskrit": "ददर्श भीमसंकाशं जटामण्डलधारिणम्।\nभार्गवं जामदग्न्येयं राजा राजविमर्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000074018, "chapter_id": 9074, "verse_number": "१-७४-१८", "content_sanskrit": "कैलासमिव दुर्धर्षं कालाग्निमिव दुःसहम्।\nज्वलन्तमिव तेजोभिर्दुर्निरीक्ष्यं पृथग्जनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000074019, "chapter_id": 9074, "verse_number": "१-७४-१९", "content_sanskrit": "स्कन्धे चासज्ज्य परशुं धनुर्विद्युद‍्गणोपमम्।\nप्रगृह्य शरमुग्रं च त्रिपुरघ्नं यथा शिवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000074020, "chapter_id": 9074, "verse_number": "१-७४-२०", "content_sanskrit": "तं दृष्ट्वा भीमसंकाशं ज्वलन्तमिव पावकम्।\nवसिष्ठप्रमुखा विप्रा जपहोमपरायणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000074021, "chapter_id": 9074, "verse_number": "१-७४-२१", "content_sanskrit": "संगता मुनयः सर्वे संजजल्पुरथो मिथः।\nकच्चित् पितृवधामर्षी क्षत्रं नोत्सादयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000074022, "chapter_id": 9074, "verse_number": "१-७४-२२", "content_sanskrit": "पूर्वं क्षत्रवधं कृत्वा गतमन्युर्गतज्वरः।\nक्षत्रस्योत्सादनं भूयो न खल्वस्य चिकीर्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000074023, "chapter_id": 9074, "verse_number": "१-७४-२३", "content_sanskrit": "एवमुक्त्वार्घ्यमादाय भार्गवं भीमदर्शनम्।\nऋषयो राम रामेति मधुरं वाक्यमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000074024, "chapter_id": 9074, "verse_number": "१-७४-२४", "content_sanskrit": "प्रतिगृह्य तु तां पूजामृषिदत्तां प्रतापवान्।\nरामं दाशरथिं रामो जामदग्न्योऽभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000074025, "chapter_id": 9074, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे चतुःसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]