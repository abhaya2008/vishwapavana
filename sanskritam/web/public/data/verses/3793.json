[{"id": 2129727, "chapter_id": 3793, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2129728, "chapter_id": 3793, "verse_number": "१", "content_sanskrit": "एतस्मिन्नेव काले तु बृहद्द्युम्नो महीपतिः ।\nसत्रं तेने महाभागो रैभ्ययाज्यः प्रतापवान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2129729, "chapter_id": 3793, "verse_number": "२", "content_sanskrit": "तेन रैभ्यस्य वै पुत्रावर्वावसुपरावसू ।\nवृतौ सहायौ सत्रार्थं बृहद्द्युम्नेन धीमता\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2129730, "chapter_id": 3793, "verse_number": "३", "content_sanskrit": "तत्र तौ समनुज्ञातौ पित्रा कौन्तेय जग्मतुः ।\nआश्रमे त्वभवद् रैभ्यो भार्या चैव परावसोः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2129731, "chapter_id": 3793, "verse_number": "४", "content_sanskrit": "अथावलोककोऽगच्छद् गृहानेकः परावसुः ।\nकृष्णाजिनेन संवीतं ददर्श पितरं वने\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2129732, "chapter_id": 3793, "verse_number": "५", "content_sanskrit": "जघन्यरात्रे निद्रान्धः सावशेषे तमस्यपि ।\nचरन्तं गहनेऽरण्ये मेने स पितरं मृगम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2129733, "chapter_id": 3793, "verse_number": "६", "content_sanskrit": "मृगं तु मन्यमानेन पिता वै तेन हिंसितः ।\nअकामयानेन तदा शरीरत्राणमिच्छता\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2129734, "chapter_id": 3793, "verse_number": "", "content_sanskrit": "ततः समीपमासाद्य पितरं दृष्टवान् हतम् ।\nअज्ञानात् पितरं हत्वा मृगबुद्व्या परावसुः ।\nविलप्य बहुधा राजन् रैभ्यस्य च महात्मनः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2129735, "chapter_id": 3793, "verse_number": "७", "content_sanskrit": "तस्य स प्रेतकार्याणि कृत्वा सर्वाणि भारत ।\nपुनरागत्य तत्सत्रमब्रवीद् भ्रातरं वचः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2129736, "chapter_id": 3793, "verse_number": "८", "content_sanskrit": "इदं कर्म न शक्तस्त्वं वोढुमेकः कथञ्चन ।\nमया तु हिंसितस्तातो मन्यमानेन तं मृगम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2129737, "chapter_id": 3793, "verse_number": "९", "content_sanskrit": "सोऽस्मदर्थं व्रतं तात चर त्वं ब्रह्महिंसनम् ।\nसमर्थोऽप्यहमेकाकी कर्म कर्तुमिदं मुने\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2129738, "chapter_id": 3793, "verse_number": "", "content_sanskrit": "अर्वावसुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2129739, "chapter_id": 3793, "verse_number": "१०", "content_sanskrit": "करोतु वै भवान् सत्रं बृहद्द्युम्नस्य धीमतः ।\nब्रह्मवध्यां चरिष्येऽहं त्वदर्थं नियतेन्द्रियः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2129740, "chapter_id": 3793, "verse_number": "", "content_sanskrit": "सोऽगच्छद् वनमेकाग्रो ब्रह्महत्याव्रतं चरन् ।\nतच्छ्रुत्वार्वावसुः पश्चात्प्रायश्चित्तं विधाय च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2129741, "chapter_id": 3793, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2129742, "chapter_id": 3793, "verse_number": "११", "content_sanskrit": "स तस्य ब्रह्मवध्यायाः पारं गत्वा युधिष्ठिर ।\nअर्वावसुस्तदा सत्रमाजगाम पुनर्मुनिः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2129743, "chapter_id": 3793, "verse_number": "१२", "content_sanskrit": "ततः परावसुर्दृष्ट्वा भ्रातरं समुपस्थितम् ।\nबृहद्द्युम्नमुवाचेदं वचनं हर्षगद्गदम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2129744, "chapter_id": 3793, "verse_number": "", "content_sanskrit": "परावसुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2129745, "chapter_id": 3793, "verse_number": "१३", "content_sanskrit": "एष ते ब्रह्महा यज्ञं मा द्रष्टुं प्रविशेदिति ।\nब्रह्महा प्रेक्षितेनापि पीडयेत् त्वामसंशयम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2129746, "chapter_id": 3793, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2129747, "chapter_id": 3793, "verse_number": "", "content_sanskrit": "तच्छ्रुत्वैव तदा राजा प्रेष्यानाह स विट्पते ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2129748, "chapter_id": 3793, "verse_number": "१४", "content_sanskrit": "प्रेष्यैरुत्सार्यमाणस्तु राजन्नर्वावसुस्तदा ।\nन मया ब्रह्महत्येयं कृतेत्याह पुनः पुनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2129749, "chapter_id": 3793, "verse_number": "१५", "content_sanskrit": "उच्यमानोऽसकृत् प्रेष्यैर्ब्रह्महन्निति भारत ।\nनैव स्म प्रतिजानाति ब्रह्मवध्यां स्वयङ्कृताम् ।\nमम भ्रात्रा कृतमिदं मया स परिमोक्षितः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2129750, "chapter_id": 3793, "verse_number": "१६", "content_sanskrit": "स तथा प्रवदन् क्रोधात् तैश्च प्रेष्यैः प्रभाषितः ।\nतूष्णीं जगाम ब्रह्मर्षिर्वनमेव महातपाः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2129751, "chapter_id": 3793, "verse_number": "१७", "content_sanskrit": "उग्रं तपः समास्थाय दिवाकरमथाश्रितः ।\nरहस्यवेदं कृतवान् सूर्यस्य द्विजसत्तमः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2129752, "chapter_id": 3793, "verse_number": "१८", "content_sanskrit": "मूर्तिमांस्तं ददर्शाथ स्वयमग्रभुगव्ययः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2129753, "chapter_id": 3793, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2129754, "chapter_id": 3793, "verse_number": "१९", "content_sanskrit": "प्रीतास्तस्याभवन् देवाः कर्मणाऽर्वावसोर्नृप ।\nतं ते प्रवरयामासुर्निरासुश्च परावसुम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2129755, "chapter_id": 3793, "verse_number": "२०", "content_sanskrit": "ततो देवा वरं तस्मै ददुरग्निपुरोगमाः ।\nस चापि वरयामास पितुरुत्थानमात्मनः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2129756, "chapter_id": 3793, "verse_number": "२१", "content_sanskrit": "अनागस्त्वं ततो भ्रातुः पितुश्चास्मरणं वधे ।\nभरद्वाजस्य चोत्थानं यवक्रीतस्य चोभयोः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2129757, "chapter_id": 3793, "verse_number": "", "content_sanskrit": "प्रतिष्ठां चापि वेदस्य सौरस्य द्विजसत्तमः ।\nएवमस्त्विति तं देवाः प्रोचुश्चापि वरान् ददुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2129758, "chapter_id": 3793, "verse_number": "", "content_sanskrit": "ततः प्रादुर्बभूवुस्ते सर्व एव युधिष्ठिर ।\nअथाब्रवीद् यवक्रीतो देवानग्निपुरोगमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2129759, "chapter_id": 3793, "verse_number": "", "content_sanskrit": "यवक्रीतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2129760, "chapter_id": 3793, "verse_number": "२२", "content_sanskrit": "समधीतं मया ब्रह्म व्रतानि चरितानि च \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2129761, "chapter_id": 3793, "verse_number": "२३", "content_sanskrit": "कथं च रैभ्यः शक्तो मामधीयानं तपस्विनम् ।\nतथायुक्तेन विधिना निहन्तुममरोत्तमाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2129762, "chapter_id": 3793, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2129763, "chapter_id": 3793, "verse_number": "२४", "content_sanskrit": "मैवं कृथा यवक्रीत यथा वदसि वै मुने ।\nऋते गुरुमधीता हि सुखं वेदास्त्वया पुरा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2129764, "chapter_id": 3793, "verse_number": "२५", "content_sanskrit": "अनेन तु गुरून् दुःखात् तोषयित्वाऽऽत्मकर्मणा ।\nकालेन महता क्लेशाद् ब्रह्माधिगतमुत्तमम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2129765, "chapter_id": 3793, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2129766, "chapter_id": 3793, "verse_number": "२६", "content_sanskrit": "यवक्रीतमथोक्त्वैवं देवाः साग्निपुरोगमाः ।\nसञ्जीवयित्वा तान्सर्वान्पुनर्जग्मुस्त्रिविष्टपम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2129767, "chapter_id": 3793, "verse_number": "२७", "content_sanskrit": "ततो वै स यवक्रीतो ब्रह्मचर्य चचार ह ।\nअष्टादश च वर्षाणि त्रिंशतं च युधिष्ठिर\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2129768, "chapter_id": 3793, "verse_number": "२८", "content_sanskrit": "आश्रमस्तस्य पुण्योऽयं सदापुष्पफलद्रुमः ।\nअत्रोष्य राजशार्दूल सर्वं पापं प्रमोक्ष्यसि\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2129769, "chapter_id": 3793, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि पञ्चत्रिंशदधिकशततमोऽध्यायः ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2129770, "chapter_id": 3793, "verse_number": "९१", "content_sanskrit": "॥ इति तीर्थयात्रापर्वणि एकनवतितमोऽध्यायः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]