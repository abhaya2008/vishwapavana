[{"id": 2213997, "chapter_id": 5574, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213998, "chapter_id": 5574, "verse_number": "१", "content_sanskrit": "तं शयानं महात्मानं वीरमानकदुन्दुभिम् ।\nपुत्रशोकेन सन्तप्तं ददर्श कुरुपुङ्गवः\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213999, "chapter_id": 5574, "verse_number": "२", "content_sanskrit": "तस्याश्रुपरिपूर्णाक्षो व्यूढोरस्को महाभुजः ।\nआर्तस्यार्ततरः पार्थः पादौ जग्राह भारत\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2214000, "chapter_id": 5574, "verse_number": "३", "content_sanskrit": "तस्य मूर्धानमाघ्रातुमियेषानकदुन्दुभिः ।\nस्वस्रीयस्य महाबाहुर्न शशाक वचो हरेः\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2214001, "chapter_id": 5574, "verse_number": "४", "content_sanskrit": "समालिङ्ग्यार्जुनं वृद्धः स भुजाभ्यां महाभुजः ।\nरुरोदाथ स्मरन् शौरिं विललाप सुविह्वलः\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2214002, "chapter_id": 5574, "verse_number": "५", "content_sanskrit": "भ्रातॄन् पुत्रांश्च पौत्रांश्च दौहित्रान् स सखीनपि\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2214003, "chapter_id": 5574, "verse_number": "", "content_sanskrit": "वसुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2214004, "chapter_id": 5574, "verse_number": "६", "content_sanskrit": "यैर्जिता भूमिपालाश्च दैत्याश्च शतशोऽर्जुन ।\nतान् सर्वान्नेह पश्यामि जीवाम्यर्जुन दुर्मरः\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2214005, "chapter_id": 5574, "verse_number": "७", "content_sanskrit": "यौ तावर्जुनशिष्यौ ते प्रियौ बहुमतौ सदा ।\nतयोरपनयात् पार्थ वृष्णयो निधनं गताः\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2214006, "chapter_id": 5574, "verse_number": "८", "content_sanskrit": "यौ तौ वृष्णिप्रवीराणां द्वावेवातिरथौ मतौ ।\nप्रद्युम्नो युयुधानश्च कथयन् कत्थसे च यौ\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2214007, "chapter_id": 5574, "verse_number": "९", "content_sanskrit": "तौ सदा कुरुशार्दूल कृष्णस्य प्रियभाजनौ ।\nतावुभौ वृष्णिनाशस्य मुखमास्तां धनञ्जय\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2214008, "chapter_id": 5574, "verse_number": "१०", "content_sanskrit": "न तु गर्हामि शैनेयं हार्दिक्यं चाहमर्जुन ।\nअक्रूरं रौग्मिणेयं च शापो ह्येवात्र कारणम्\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2214009, "chapter_id": 5574, "verse_number": "११", "content_sanskrit": "केशिनं केशवः कंसं विक्रम्य हतवान् प्रभुः ।\nविदेहमकरोत् पार्थ चैद्यं च बलगर्वितम्\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2214010, "chapter_id": 5574, "verse_number": "१२", "content_sanskrit": "नैषादिमेकलव्यं च चक्रे कालिङ्गमागधान् ।\nगान्धारान् काशिराजं च मरुभूमौ च पार्थिवान्\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2214011, "chapter_id": 5574, "verse_number": "१३", "content_sanskrit": "प्राच्यांश्च दाक्षिणात्यांश्च पार्वतीयांस्तथा नृपान् ।\nसोभ्युपेक्षितवानेवमनयान्मधुसूदनः\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2214012, "chapter_id": 5574, "verse_number": "१४", "content_sanskrit": "त्वं हि तं नादराच्चैव मुनयश्च सनातनम् ।\nगोविन्दमनघं देवमभिजानीध्वमच्युतम्\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2214013, "chapter_id": 5574, "verse_number": "१५", "content_sanskrit": "प्रत्यपश्यच्च स विभुर्ज्ञातिक्षयमधोक्षजः ।\nसमुपेक्षितवान्नित्यं स्वयं स मम पुत्रकः\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2214014, "chapter_id": 5574, "verse_number": "१६", "content_sanskrit": "गान्धार्या वचनं यत्तदृषीणां च परन्तप ।\nतन्नूनमन्यथा कर्तुं नैच्छत्स जगतः प्रभुः\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2214015, "chapter_id": 5574, "verse_number": "१७", "content_sanskrit": "प्रत्यक्षं भवतश्चापि तव पौत्रः परन्तप ।\nअश्वत्थाम्ना हतश्चापि जीवितस्तस्य तेजसा\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2214016, "chapter_id": 5574, "verse_number": "१८", "content_sanskrit": "इमांस्तु नैच्छत् स्वान् ज्ञातीन् रक्षितुं च सखा तव\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2214017, "chapter_id": 5574, "verse_number": "१९", "content_sanskrit": "ततः पुत्रांश्च पौत्रांश्च भ्रातॄनथ सखींस्तथा ।\nशयानान् निहतान् दृष्ट्वा कृष्णो मामब्रवीदिदम्\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2214018, "chapter_id": 5574, "verse_number": "२०", "content_sanskrit": "सम्प्राप्तोऽद्यायमस्यान्तः कुलस्य भरतर्षभ ।\nआगमिष्यति बीभत्सुरिमां द्वारवतीं पुरीम्\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2214019, "chapter_id": 5574, "verse_number": "२१", "content_sanskrit": "आख्येयं तस्य यद् वृत्तं वृष्णीनां वैशसं महत्\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2214020, "chapter_id": 5574, "verse_number": "२२", "content_sanskrit": "स तु श्रुत्वा महातेजा यदूनां निधनं प्रभो ।\nआगन्ता क्षिप्रमेवेह न मेऽत्रास्ति विचारणा\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2214021, "chapter_id": 5574, "verse_number": "२३", "content_sanskrit": "योऽहं तमर्जुनं विद्धि योऽर्जुनः सोहमेव तु ।\nयद् ब्रूयात् तत्तथा कार्यमिति बुद्ध्यस्व भारत\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2214022, "chapter_id": 5574, "verse_number": "२४", "content_sanskrit": "स स्त्रीषु प्राप्तकालासु पाण्डवो बालकेषु च ।\nप्रतिपत्स्यति बीभत्सुर्भवतश्चोर्ध्वदेहिकम्\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2214023, "chapter_id": 5574, "verse_number": "२५", "content_sanskrit": "इमां च नगरीं सद्यः प्रतियाते धनञ्जये ।\nप्राकाराट्टालकोपेतां समुद्रः प्लावयिष्यति\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2214024, "chapter_id": 5574, "verse_number": "२६", "content_sanskrit": "अहं देशे तु कस्मिंश्चित् पुण्ये नियममास्थितः ।\nकालं काङ्क्षे सद्य एव रामेण सहितो वने\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2214025, "chapter_id": 5574, "verse_number": "२७", "content_sanskrit": "एवमुक्त्वा हृषीकेशो मामचिन्त्यपराक्रमः ।\nहित्वा मां बालकैः सार्धं दिशं कामप्यगात् प्रभुः\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2214026, "chapter_id": 5574, "verse_number": "२८", "content_sanskrit": "सोहं तौ च महात्मानौ चिन्तयन् रामकेशवौ ।\nघोरं ज्ञातिवधं चैव न भुञ्जे शोककर्शितः\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2214027, "chapter_id": 5574, "verse_number": "२९", "content_sanskrit": "न मोक्ष्ये न च जीविष्ये दिष्ट्या प्राप्तोसि पाण्डव ।\nयदुक्तं पार्थ कृष्णेन तत्सर्वमखिलं कुरु\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2214028, "chapter_id": 5574, "verse_number": "३०", "content_sanskrit": "एतत्ते पार्थ राज्यं च स्त्रियो रत्नानि चैव हि ।\nइष्टान् प्राणानहं हीमांस्त्यक्ष्यामि रिपुसूदन\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2214029, "chapter_id": 5574, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् मौसलपर्वणि\nअर्जुनं प्रति वसुदेववाक्यं नाम सप्तमोऽध्यायः ॥७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]