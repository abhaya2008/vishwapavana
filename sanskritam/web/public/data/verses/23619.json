[{"id": 7003619000, "chapter_id": 23619, "verse_number": "१-२-६-१", "content_sanskrit": "श्रीनारद उवाच ।\nइति श्रुत्वा फाल्गुनाहं रोमांचपुलकीकृतः ।\nस्वरूपं प्रकटीकृत्य ब्राह्मणानिदमब्रवम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003619001, "chapter_id": 23619, "verse_number": "१-२-६-२", "content_sanskrit": "अहो धन्यः पितास्माकं यस्य सृष्टस्य पालकाः ।\nयुष्मद्विधा ब्राह्मणेंद्राः सत्यमाह पुरा हरिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003619002, "chapter_id": 23619, "verse_number": "१-२-६-३", "content_sanskrit": "मत्तोऽप्यनंतात्परतः परस्मात्समस्तभूताधिपतेर्न किंचित् ।\nतेषां किमुस्यादितरेण येषां द्विजेश्वराणां मम मार्गवादिनाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003619003, "chapter_id": 23619, "verse_number": "१-२-६-४", "content_sanskrit": "तत्सर्वथाद्या धन्योऽस्मि संप्राप्तं जन्मनः फलम् ।\nयद्भवन्तो मया दृष्टाः पापोपद्रववर्जिताः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003619004, "chapter_id": 23619, "verse_number": "१-२-६-५", "content_sanskrit": "ततस्ते सहसोत्थाय शातातपपुरोगमाः ।\nअर्घ्यपाद्यादिसत्कारैः पूजयामासुर्मां द्विजाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003619005, "chapter_id": 23619, "verse_number": "१-२-६-६", "content_sanskrit": "प्रोक्तवन्तश्च मां पार्थ वचः साधुजनो चितम् ।\nधन्या वयं हि देवर्षे त्वमस्मान्यदिहागतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003619006, "chapter_id": 23619, "verse_number": "१-२-६-७", "content_sanskrit": "कुतो वाऽगमनं तुभ्यं गन्तव्यं वा क्व सांप्रतम् ।\nअत्राप्यागमने कार्यमुच्यतां मुनिसत्तम ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003619007, "chapter_id": 23619, "verse_number": "१-२-६-८", "content_sanskrit": "श्रुत्वा प्रीतिकरं वाक्यं द्विजानामिति पांडव ।\nप्रत्यवोचं मुनीन्द्रांस्ताञ्छ्रूयतां द्विजसत्तमाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003619008, "chapter_id": 23619, "verse_number": "१-२-६-९", "content_sanskrit": "अहं हि ब्रह्मणो वाक्याद्विप्राणां स्थानकं शुभम् ।\nदातुकामो महातीर्थे महीसागरसंगमे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003619009, "chapter_id": 23619, "verse_number": "१-२-६-१०", "content_sanskrit": "परीक्षन्ब्राह्मणानत्र प्राप्तो यूयं परीक्षिताः ।\nअहं वः स्थायिष्यामि चानुजानीत तद्द्विजाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003619010, "chapter_id": 23619, "verse_number": "१-२-६-११", "content_sanskrit": "एवमुक्तो विलोक्यैव द्विजाञ्छातातपोऽब्रवीत् ।\nदेवानामपि दुष्प्राप्यं सत्यं नारद भारतम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003619011, "chapter_id": 23619, "verse_number": "१-२-६-१२", "content_sanskrit": "किं पुनश्चापि तत्रैव मही सागरसंगमः ।\nयत्र स्नातो महातीर्थफलं सर्वमुपाश्नुते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003619012, "chapter_id": 23619, "verse_number": "१-२-६-१३", "content_sanskrit": "पुनरेको महान्दोषो बिभीमो नितरां यतः ।\nतत्र चौराः सुबहवो निर्घृणाः प्रियसाहसाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003619013, "chapter_id": 23619, "verse_number": "१-२-६-१४", "content_sanskrit": "स्वर्शेषु षोडशं चैकविंशंगृह्णंति नो धनम् ।\nधनेन तेन हीनानां कीदृशं जन्म नो भवेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003619014, "chapter_id": 23619, "verse_number": "१-२-६-१५", "content_sanskrit": "वरं बुभुक्षया वासो मा चौरकरगा वयम् ।\nअर्जुन उवाच ।\nअद्भुतं वर्ण्यते विप्र के हि चौराः प्रकीर्तिताः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003619015, "chapter_id": 23619, "verse_number": "१-२-६-१६", "content_sanskrit": "किं धनं च हरंत्येते येभ्यो बिभ्यति ब्राह्मणाः ।\nनारद उवाच ।\nकामक्रोधादयश्चौरास्तप एव धनं तथा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003619016, "chapter_id": 23619, "verse_number": "१-२-६-१७", "content_sanskrit": "तस्यापहाभीतास्ते मामूचुरिति ब्राह्मणाः ।\nतानहं प्राब्रवं पश्चाद्वि जानीत द्विजोत्तमाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003619017, "chapter_id": 23619, "verse_number": "१-२-६-१८", "content_sanskrit": "जाग्रतां तु मनुष्याणां चौराः कुर्वंति किं खलाः ।\nभयभीतश्चालसश्च तथा चाशुचिरेव यः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003619018, "chapter_id": 23619, "verse_number": "१-२-६-१९", "content_sanskrit": "तेन किं नाम संसाध्यं भूमिस्तं ग्रसते नरम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003619019, "chapter_id": 23619, "verse_number": "१-२-६-२०", "content_sanskrit": "शातातप उवाच ।\nवयं चौरभयाद्भीतास्ते हरंति धनं महत् ।\nकर्तुं तदा कथं शक्यमंगजागरणं तथा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003619020, "chapter_id": 23619, "verse_number": "१-२-६-२१", "content_sanskrit": "खलाश्चौरा गताः क्वापि ततो नत्वाऽगता वयम् ।\nतस्मासर्वं संत्यजामो भयभीता वयं मुने ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003619021, "chapter_id": 23619, "verse_number": "१-२-६-२२", "content_sanskrit": "प्रतिग्रहश्च वै घोरः षष्ठांऽशफलदस्तथा ।\nएवं ब्रुवति तस्मिंश्च हारीतोनाम चाब्रवीत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003619022, "chapter_id": 23619, "verse_number": "१-२-६-२३", "content_sanskrit": "मूढबुद्ध्या हि को नाम महीसागरसंगमम् ।\nत्यजेच्च यत्र मोक्षश्च स्वर्गश्च करगोऽथ वा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003619023, "chapter_id": 23619, "verse_number": "१-२-६-२४", "content_sanskrit": "कलापादिषु ग्रामेषु को वसेत विचक्षणः ।\nयदि वासः स्तम्भतीर्थे क्षणार्धमपि लभ्यते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003619024, "chapter_id": 23619, "verse_number": "१-२-६-२५", "content_sanskrit": "भयं च चौरजं सर्वं किं करिष्यति तत्र न ।\nकुमारनाथं मनसि पालकं कुर्वतां दृढम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003619025, "chapter_id": 23619, "verse_number": "१-२-६-२६", "content_sanskrit": "साहसं च विना भूतिर्न कथंचन प्राप्यते ।\nतस्मान्नारद तत्राहमा यास्ये तव वाक्यतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003619026, "chapter_id": 23619, "verse_number": "१-२-६-२७", "content_sanskrit": "षड्विंशतिसहस्राणि ब्राह्मणा मे परिग्रहे ।\nषट्कर्मनिरताः शुद्धा लोभदम्भविवर्जिताः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003619027, "chapter_id": 23619, "verse_number": "१-२-६-२८", "content_sanskrit": "तैः सार्धमागमिष्यामि ममेदं मतमुत्तमम् ।\nइत्युक्ते वचने तांश्च कृत्वाहं दंडमूर्धनि ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003619028, "chapter_id": 23619, "verse_number": "१-२-६-२९", "content_sanskrit": "निवृत्तः सहसा पार्थ खेचरोऽतिमुदान्वितः ।\nशतयोजनमात्रं तु हिममार्गमतीत्य च ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003619029, "chapter_id": 23619, "verse_number": "१-२-६-३०", "content_sanskrit": "केदारं समुपायातो युक्तस्तैर्द्विजसत्तमैः ।\nआकाशेन सुशक्यश्च बिलेनाथ स देशकः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003619030, "chapter_id": 23619, "verse_number": "१-२-६-३१", "content_sanskrit": "अतिक्रांतुं नान्यथा च तथा स्कंदप्रसादतः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003619031, "chapter_id": 23619, "verse_number": "१-२-६-३२", "content_sanskrit": "अर्जुन उवाच ।\nक्व कलापं च द्ग्रामं कथं शक्यं बिलेन च ।\nकथं स्कंदप्रसादः स्यादेतन्मे ब्रूहि नारद ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003619032, "chapter_id": 23619, "verse_number": "१-२-६-३३", "content_sanskrit": "नारद उवाच ।\nकेदाराद्धिमसंयुक्तं योजनानां शतं स्मृतम् ।\nतदंते योजनशतं विस्तृतं तत्कलापकम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003619033, "chapter_id": 23619, "verse_number": "१-२-६-३४", "content_sanskrit": "तदंते योजनशतं वासुकार्णव मुच्यते ।\nशतयोजनमात्रः स भूमिस्वर्गस्ततः स्मृतः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003619034, "chapter_id": 23619, "verse_number": "१-२-६-३५", "content_sanskrit": "बिलेन च यथा शक्यं गंतुं तत्र श्रृणुष्व तत् ।\nनिरन्नं वै निरुदकं देवमाराधयेद्गुहम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003619035, "chapter_id": 23619, "verse_number": "१-२-६-३६", "content_sanskrit": "दक्षिणायां दिशि ततो निष्पापं मन्यते यदा ।\nतदा गुहोऽस्य स्वप्ने गच्छेति भारत ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003619036, "chapter_id": 23619, "verse_number": "१-२-६-३७", "content_sanskrit": "ततो गुहात्पश्चिमतो बिलमस्ति बृहत्तरम् ।\nतत्र प्रविश्य गंतव्यं क्रमाणां शतसप्तकम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003619037, "chapter_id": 23619, "verse_number": "१-२-६-३८", "content_sanskrit": "तत्र मारकतं लिंगमस्ति सूर्यसमप्रभम् ।\nतदग्रे मृत्तिका चास्ति स्वर्णवर्णा सुनिर्मला ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003619038, "chapter_id": 23619, "verse_number": "१-२-६-३९", "content_sanskrit": "नमस्कृत्य च तल्लिंगं गृहीत्वा मृत्तिकां च ताम् ।\nआगंतव्यं स्तंभतीर्थे समाराध्य कुमारकम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003619039, "chapter_id": 23619, "verse_number": "१-२-६-४०", "content_sanskrit": "कोलं वा कूपतो ग्राह्यं भूतायां निशि तज्जलम् ।\nतेनोदकेन मृत्तिकया कृत्वा नेत्रद्वयाञ्जनम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003619040, "chapter_id": 23619, "verse_number": "१-२-६-४१", "content_sanskrit": "उद्वर्तनं च देहस्य कदाचित्षष्टिमे पदे ।\nनेत्रांजनप्रभावाच्च बिलं पश्यति शोभनम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003619041, "chapter_id": 23619, "verse_number": "१-२-६-४२", "content_sanskrit": "तन्मध्येन ततो याति गात्रोद्वर्त्तप्रभावतः ।\nकारीषैर्नाम चात्युग्रैर्भक्ष्यते नैव कीटकैः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003619042, "chapter_id": 23619, "verse_number": "१-२-६-४३", "content_sanskrit": "बिलमध्ये च संपश्यन्सिद्धान्भास्करसन्निभान् ।\nयात्येवं यात्यसौ पार्थ कलापं ग्राममुत्तमम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003619043, "chapter_id": 23619, "verse_number": "१-२-६-४४", "content_sanskrit": "तत्र वर्षसहस्राणि चत्वार्यायुःप्रकीर्तितम् ।\nफलानां भोजनं च स्यात्पुनः पुण्यं च नार्ज्जयेत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003619044, "chapter_id": 23619, "verse_number": "१-२-६-४५", "content_sanskrit": "इत्येतत्कथितं तुभ्यमतश्चाभूच्छृणुष्व तत् ।\nतपः सामर्थ्यतः सूक्ष्मान्दण्डस्याग्रे निधाय तान् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003619045, "chapter_id": 23619, "verse_number": "१-२-६-४६", "content_sanskrit": "द्विजानहं समायातो महीसागरसंगमम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003619046, "chapter_id": 23619, "verse_number": "१-२-६-४७", "content_sanskrit": "तदोत्तार्य मया मुक्तास्तीरे पुण्यजलाशये ।\nततो मया कृतं स्नानं सह तैर्द्विजसत्तमैः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003619047, "chapter_id": 23619, "verse_number": "१-२-६-४८", "content_sanskrit": "निःशेषदोषदावाग्नौ महीसागरसंगमे ।\nपितॄणां देवतानां च कृत्वा तर्पणसत्क्रियाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003619048, "chapter_id": 23619, "verse_number": "१-२-६-४९", "content_sanskrit": "जपमानाः परं जप्यं निविष्टाः संगमे वयम् ।\nभास्करं समवेक्षंतश्चिंतयंतो हरिं हृदि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003619049, "chapter_id": 23619, "verse_number": "१-२-६-५०", "content_sanskrit": "तस्मिंश्चैवांतरे पार्थ देवाः शक्रपुरोगमाः ।\nआदित्याद्या ग्रहाः सर्वे लोकपालाश्च संगताः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003619050, "chapter_id": 23619, "verse_number": "१-२-६-५१", "content_sanskrit": "देवानां योनयो ह्यष्टौ गंधर्वाप्सरसां गणाः ।\nमहोत्सवे ततस्तस्मिन्गीतवादित्र उत्तमे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003619051, "chapter_id": 23619, "verse_number": "१-२-६-५२", "content_sanskrit": "पादप्रक्षालनं कर्तुं विप्राणामुद्यतस्त्वहम् ।\nतस्मिन्काले चाश्रृणवमहमातिथ्यवाक्यताम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003619052, "chapter_id": 23619, "verse_number": "१-२-६-५३", "content_sanskrit": "सामध्वनिसमायुक्तां तृतीयस्वरनादिताम् ।\nअतीव मनसो रम्यां शिव भक्तिमिवोत्तमाम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003619053, "chapter_id": 23619, "verse_number": "१-२-६-५४", "content_sanskrit": "विप्रैरुत्थाय संपृष्टः कस्त्वं विप्र क्व चागतः ।\nकिं वा प्रार्थयसे ब्रूहि यत्ते मनसि रोचते ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003619054, "chapter_id": 23619, "verse_number": "१-२-६-५५", "content_sanskrit": "विप्र उवाच ।\nमुनिः कपिलनामाहं नारदाय निवेद्यताम् ।\nआगतः प्रार्थनायैव तच्छ्रुत्वाहमथाब्रवम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003619055, "chapter_id": 23619, "verse_number": "१-२-६-५६", "content_sanskrit": "धन्योहं यदिहायातः कपिल त्वं महामुने ।\nनास्त्यदेयं तवास्माभिः पात्रं नास्ति तवाधिकम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003619056, "chapter_id": 23619, "verse_number": "१-२-६-५७", "content_sanskrit": "कपिला उवाच ।\nब्रह्मपुत्र त्वया देयं यदि मे त्वं श्रृणुष्व तत् ।\nअष्टौ विप्रसहस्रामि मम देहीति नारद ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003619057, "chapter_id": 23619, "verse_number": "१-२-६-५८", "content_sanskrit": "भूमिदानं करिष्यामि कलापग्रामवासिनाम् ।\nब्राह्मणानामहं चैषां तदिदं क्रियतां विभो ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003619058, "chapter_id": 23619, "verse_number": "१-२-६-५९", "content_sanskrit": "ततो मया प्रतिज्ञातमेव मस्तु महामुने ।\nत्वयापि क्रियतां स्थानं कापिलं कपिलोत्तमम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003619059, "chapter_id": 23619, "verse_number": "१-२-६-६०", "content_sanskrit": "श्राद्धे वा प्राप्तकाले वा ह्यतिथिर्विमुखीभवेत् ।\nयस्याश्रममुपायातस्यस्य सर्वं हि निष्फलम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003619060, "chapter_id": 23619, "verse_number": "१-२-६-६१", "content_sanskrit": "स गच्छेद्रौरवांल्लोकान्योऽतिथिं नाभिपूजयेत् ।\nअतिथिः पूजितो येन स देवैरपि पूज्यते ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003619061, "chapter_id": 23619, "verse_number": "१-२-६-६२", "content_sanskrit": "दानैर्यज्ञैस्त तस्तस्मिन्भोजितः कपिलो मुनिः ।\nततो महामुनिः श्रीमान्हारीतो ह्वयितस्तदा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003619062, "chapter_id": 23619, "verse_number": "१-२-६-६३", "content_sanskrit": "पादप्रक्षालनार्थाय सिद्धदेवसमागमे ।\nहारीतश्च पुरस्कृत्य वामपादं तदा स्थितः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003619063, "chapter_id": 23619, "verse_number": "१-२-६-६४", "content_sanskrit": "ततो हासो महाञ्जज्ञे सिद्धाप्सरः सुपर्वणाम् ।\nविचिंत्य बहुधा पृथ्वीं साधु साधुकृता द्विजाः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003619064, "chapter_id": 23619, "verse_number": "१-२-६-६५", "content_sanskrit": "ततो ममापि मनसि शोकवेगो महानभूत् ।\nसत्यां चैव तथा मेने गाथां पूर्वबुधेरिताम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003619065, "chapter_id": 23619, "verse_number": "१-२-६-६६", "content_sanskrit": "सर्वेष्वपि च कार्येषु हेतिशब्दो विगर्हितः ।\nकुर्वतामतिकार्याणि शिलापातो ध्रुवं भवेत् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003619066, "chapter_id": 23619, "verse_number": "१-२-६-६७", "content_sanskrit": "ततोहमब्रंवं विप्रान्यूयं मूर्खा भविष्यथ ।\nधनधान्याल्पसंयुक्ता दारिद्र्यकलिलावृताः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003619067, "chapter_id": 23619, "verse_number": "१-२-६-६८", "content_sanskrit": "एवमुक्ते प्रहस्यैव हारीतः प्राब्रवीदिदम् ।\nतवैवेयं मुने हानिर्यदस्माञ्छपते भवान् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003619068, "chapter_id": 23619, "verse_number": "१-२-६-६९", "content_sanskrit": "कः शापो दीयते तुभ्यं शापोयमयमेव ते ।\nततो विमृश्य भूयोऽहब्रवं किमहंद्विज ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003619069, "chapter_id": 23619, "verse_number": "१-२-६-७०", "content_sanskrit": "तथाविधस्य भवतो वामपादप्रदानतः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003619070, "chapter_id": 23619, "verse_number": "१-२-६-७१", "content_sanskrit": "हारीत उवाच ।\nश्रृणु तत्कारणं धीमञ्छून्यता मे यतो भवेत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003619071, "chapter_id": 23619, "verse_number": "१-२-६-७२", "content_sanskrit": "इति चिंतयतश्चित्ते हा दुःखोऽयं प्रतिग्रहः ।\nप्रतिग्रहेण विप्राणां ब्राहयं तेजो हि शाम्यति ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003619072, "chapter_id": 23619, "verse_number": "१-२-६-७३", "content_sanskrit": "महादानं हि गृह्णानो ब्राह्मणः स्वं शुभं हि यत् ।\nददाति दातुर्दाता च अशुभं यच्छति स्वकम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003619073, "chapter_id": 23619, "verse_number": "१-२-६-७४", "content_sanskrit": "दाता प्रतिग्रहीता च वचनं हि परस्परम् ।\nमन्यतेऽधःकरो यस्य सोऽल्पबुद्धिः प्रहीयते ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003619074, "chapter_id": 23619, "verse_number": "१-२-६-७५", "content_sanskrit": "इति चिंतयतो मह्यं शून्यताभूद्धि नारद ।\nनिद्रार्तश्च भयार्तश्च कामार्तः शोकपीडितः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003619075, "chapter_id": 23619, "verse_number": "१-२-६-७६", "content_sanskrit": "हृतस्वश्चान्यचित्तश्च शून्याह्येते भवंति च ।\nतदेषु मतिमान्कोपं न कुर्वीत यदि त्वया ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003619076, "chapter_id": 23619, "verse_number": "१-२-६-७७", "content_sanskrit": "कृतः कोपस्ततस्तुभ्यमेवं हानिरियं मुने ।\nततस्तापान्वितश्चाहं तान्वि प्रानब्रवं पुनः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003619077, "chapter_id": 23619, "verse_number": "१-२-६-७८", "content_sanskrit": "धिङ्मामस्तु च दुर्बुद्धिमविमृश्यार्थकारिणम् ।\nकुर्वतामविमृश्यैव तत्किमस्ति न यद्भवेत् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003619078, "chapter_id": 23619, "verse_number": "१-२-६-७९", "content_sanskrit": "सहसा न क्रियां कुर्यात्पदमेतन्महापदाम् ।\nविमृश्यकारिणं धीरं वृणते सर्वसंपदः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003619079, "chapter_id": 23619, "verse_number": "१-२-६-८०", "content_sanskrit": "सत्यमाह महाबुद्धिश्चिरकारी पुरा हि सः ।\nपुरा हि ब्राह्मणः कश्चित्प्रख्यातों गिरसां कुले ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003619080, "chapter_id": 23619, "verse_number": "१-२-६-८१", "content_sanskrit": "चिरकारि महाप्राज्ञो गौतमस्याभवत्सुतः ।\nचिरेण सर्वकार्याणि यो विमृश्य प्रपद्यते ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003619081, "chapter_id": 23619, "verse_number": "१-२-६-८२", "content_sanskrit": "चिरकार्याभिसंपतेश्चिरकारी तथोच्यते ।\nअलसग्रहणं प्राप्तो दुर्मेधावी तथोच्यते ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003619082, "chapter_id": 23619, "verse_number": "१-२-६-८३", "content_sanskrit": "बुद्धिलाघवयुक्तेन जनेनादीर्घदर्शिना ।\nव्यभिचारेण कस्मिन्स व्यतिकम्या परान्सुतान् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003619083, "chapter_id": 23619, "verse_number": "१-२-६-८४", "content_sanskrit": "पित्रोक्तः कुपितेनाथ जहीमां जननीमिति ।\nस तथेति चिरेणोक्तः स्वभावाच्चिरकारकः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003619084, "chapter_id": 23619, "verse_number": "१-२-६-८५", "content_sanskrit": "विमृश्य चिरकारित्वाच्चिं तयामास वै चिरम् ।\nपितुराज्ञां कथं कुर्यां न हन्यां मातरं कथम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003619085, "chapter_id": 23619, "verse_number": "१-२-६-८६", "content_sanskrit": "कथं धर्मच्छलेनास्मिन्निमज्जेयमसाधुवत् ।\nपितुराज्ञा परो धर्मो ह्यधर्मो मातृरक्षणम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003619086, "chapter_id": 23619, "verse_number": "१-२-६-८७", "content_sanskrit": "अस्वतंत्रं च पुत्रत्वं किं तु मां नात्र पीडयेत् ।\nस्त्रियं हत्वा मातरं च को हि जातु सुखी भवेत् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003619087, "chapter_id": 23619, "verse_number": "१-२-६-८८", "content_sanskrit": "पितरं चाप्यवज्ञाय कः प्रतिष्ठामवाप्नुयात् ।\nअनवज्ञा पितुर्युक्ता युक्तं मातुश्च रक्षणम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003619088, "chapter_id": 23619, "verse_number": "१-२-६-८९", "content_sanskrit": "क्षमायोग्यावुभावेतौ नातिवर्तेत वै कथम् ।\nपिता ह्यात्मानमाधत्ते जायायां जज्ञिवानिति ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003619089, "chapter_id": 23619, "verse_number": "१-२-६-९०", "content_sanskrit": "शीलचारित्रगोत्रस्य धारणार्थं कुलस्य च ।\nसोऽहमात्मा स्वयं पित्रा पुत्रत्वे परिकल्पितः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003619090, "chapter_id": 23619, "verse_number": "१-२-६-९१", "content_sanskrit": "जातकर्मणि यत्प्राह पिता यच्चोपकर्मणि ।\nपर्याप्तः स दृढीकारः पितुर्गौरवलिप्सया ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003619091, "chapter_id": 23619, "verse_number": "१-२-६-९२", "content_sanskrit": "शरीरादीनि देयानि पिता त्वेकः प्रयच्चति ।\nतस्मात्पितुर्वचः कार्यं न विचार्यं कथंचन ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003619092, "chapter_id": 23619, "verse_number": "१-२-६-९३", "content_sanskrit": "पातकान्यपि चूर्यंते पितुर्वचनकारिणः ।\nपिता स्वर्गः पिता धर्मः पिता परमकं तपः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003619093, "chapter_id": 23619, "verse_number": "१-२-६-९४", "content_sanskrit": "पितरि प्रीतिमापन्ने सर्वाः प्रीणंति देवताः ।\nआशिषस्ता भजंत्येनं पुरुषं प्राह याः पिता ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003619094, "chapter_id": 23619, "verse_number": "१-२-६-९५", "content_sanskrit": "निष्कृतिः सर्वपापानां पिता यदभिनंदति ।\nमुच्यते बंधनात्पुष्पं फलं वृंतात्प्रमुच्यते ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003619095, "chapter_id": 23619, "verse_number": "१-२-६-९६", "content_sanskrit": "क्लिश्यन्नपि सुतः स्नेहं पिता स्नेहं न मुंचति ।\nएतद्विचिंत्यतं तावत्पुत्रस्य पितृगौरवम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003619096, "chapter_id": 23619, "verse_number": "१-२-६-९७", "content_sanskrit": "पिता नाल्पतरं स्थानं चिंतयिष्यामि मातरम् ।\nयो ह्ययं मयि संघातो मर्त्यत्वे पांचभौतिकः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003619097, "chapter_id": 23619, "verse_number": "१-२-६-९८", "content_sanskrit": "अस्य मे जननी हेतुः पावकस्य यथारणिः ।\nमाता देहारणिः पुंसः सर्वस्यार्थस्य निर्वृतिः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003619098, "chapter_id": 23619, "verse_number": "१-२-६-९९", "content_sanskrit": "मातृलाभे सनाथत्वमनाथत्वं विपर्यये ।\nन स शोचति नाप्येनं स्थावर्यमपि कर्षति ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003619099, "chapter_id": 23619, "verse_number": "१-२-६-१००", "content_sanskrit": "श्रिया हीनोऽपि यो गेहे अंबेति प्रतिपद्यते ।\nपुत्रपौत्रसमापन्नो जननीं यः समाश्रितः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003619100, "chapter_id": 23619, "verse_number": "१-२-६-१०१", "content_sanskrit": "अपि वर्षशतस्यांते स द्विहायनवच्चरेत् ।\nसमर्थं वाऽसमर्थं वा कृशं वाप्यकृशं तथा ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003619101, "chapter_id": 23619, "verse_number": "१-२-६-१०२", "content_sanskrit": "रक्षयेच्च सुतं माता नान्यः पोष्यविधानतः ।\nतदा स वृद्धो भवति तदा भवति दुःखितः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003619102, "chapter_id": 23619, "verse_number": "१-२-६-१०३", "content_sanskrit": "तदा शुन्यं जगत्तस्य यदा मात्रा वियुज्यते ।\nनास्ति मातृसमा च्छाया नास्ति मातृसमा गतिः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003619103, "chapter_id": 23619, "verse_number": "१-२-६-१०४", "content_sanskrit": "नास्ति मातृसमं त्राणं नास्ति मातृसमा प्रपा ।\nकुक्षिसंधारणाद्धात्री जननाज्जननी तथा ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003619104, "chapter_id": 23619, "verse_number": "१-२-६-१०५", "content_sanskrit": "अंगानां वर्धनादंबा वीरसूत्वे च वीरसूः ।\nशिशोः शुश्रूषणाच्छ्वश्रूर्माता स्यान्माननात्तथा ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003619105, "chapter_id": 23619, "verse_number": "१-२-६-१०६", "content_sanskrit": "देवतानां समावापमेकत्वं पितरं विदुः ।\nमर्त्यानां देवतानां च पूगो नात्येति मातरम् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003619106, "chapter_id": 23619, "verse_number": "१-२-६-१०७", "content_sanskrit": "पतिता गुरवस्त्याज्या माता च न कथंचन ।\nगर्भधारणपोषाभ्यां तेन माता गरीयसी ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003619107, "chapter_id": 23619, "verse_number": "१-२-६-१०८", "content_sanskrit": "एवं स कौशिकीतीरे बलिं राजानमीक्षतीम् ।\nस्त्रीवृत्तिं चिरकालत्वाद्धन्तुं दिष्टः स्वमातरम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003619108, "chapter_id": 23619, "verse_number": "१-२-६-१०९", "content_sanskrit": "विमृश्य चिरकालं हि चिंतांतं नाभ्यपद्यत ।\nएतस्मिन्नंतरे शक्रो रूपमास्थितः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003619109, "chapter_id": 23619, "verse_number": "१-२-६-११०", "content_sanskrit": "गायन्गाखामुपायातः पितुस्तस्याश्रमांतिके ।\nअनृना हि स्त्रियः सर्वाः सूत्रकारो यदब्रवीत् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003619110, "chapter_id": 23619, "verse_number": "१-२-६-१११", "content_sanskrit": "अतस्ताभ्यः फलं ग्राह्यं न स्याद्दोषेक्षणः सुधीः ।\nइति श्रुत्वा तमानर्च मेधातिथिरुदारधीः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003619111, "chapter_id": 23619, "verse_number": "१-२-६-११२", "content_sanskrit": "दुःखितश्चिंतयन्प्राप्तो भृशमश्रूणि वर्तयन् ।\nअहोऽहमीर्ष्ययाक्षिप्तो मग्नोऽहं दुःखसागरे ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003619112, "chapter_id": 23619, "verse_number": "१-२-६-११३", "content_sanskrit": "हत्वा नारीं च साध्वीं च को नु मां तारयिष्यति ।\nसत्वरेण मयाज्ञप्तश्चिरकारी ह्युदारधीः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003619113, "chapter_id": 23619, "verse_number": "१-२-६-११४", "content_sanskrit": "यद्ययं चिरकारी स्यात्स मां त्रायेत पातकात् ।\nचिरकारिक भद्रं ते भद्रं ते चिरकारिक ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003619114, "chapter_id": 23619, "verse_number": "१-२-६-११५", "content_sanskrit": "यदद्य चिरकारी त्वं ततोऽसि चिरकारिकः ।\nत्राहि मां मातरं चैव तपो यच्चार्जितं मया ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003619115, "chapter_id": 23619, "verse_number": "१-२-६-११६", "content_sanskrit": "आत्मानं पातके विष्टं शुभाह्व चिरकारिक ।\nएवं स दुःखितः प्राप्तो गौतमोऽचिंतयत्तदा ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003619116, "chapter_id": 23619, "verse_number": "१-२-६-११७", "content_sanskrit": "चिरकारिकं ददर्शाथ पुत्रं मातुरुपांतिके ।\nचिरकारी तु पितरं दृष्ट्वा परमदुःखितः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003619117, "chapter_id": 23619, "verse_number": "१-२-६-११८", "content_sanskrit": "शस्त्रं त्यक्त्वा स्थितो मूर्ध्ना प्रसादायोपचक्रमे ।\nमेधातिथिः सुतं दृष्ट्वा शिरसा पतितं भुवि ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003619118, "chapter_id": 23619, "verse_number": "१-२-६-११९", "content_sanskrit": "पत्नीं चैव तु जीवंतीं परामभ्यगमन्मुदम् ।\nहन्यादिति न सा वेद शस्त्रपाणौ स्थिते सुते ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003619119, "chapter_id": 23619, "verse_number": "१-२-६-१२०", "content_sanskrit": "बुद्धिरासीत्सुतं दृष्ट्वा पितुश्चरणयोर्नतम् ।\nशस्त्रग्रहणचापल्यं संवृणोति भयादिति ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003619120, "chapter_id": 23619, "verse_number": "१-२-६-१२१", "content_sanskrit": "ततः पित्रा चिरं स्मृत्वा चिरं चाघ्राय मूर्धनि ।\nचिरं दोर्भ्यां परिष्वज्य चिरंजीवेत्यु दाहृतः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003619121, "chapter_id": 23619, "verse_number": "१-२-६-१२२", "content_sanskrit": "चिरं मुदान्वितः पुत्रं मेधातिथिरथाब्रवीत् ।\nचिरकारिक भद्रं ते चिरकारी भवेच्चिरम् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003619122, "chapter_id": 23619, "verse_number": "१-२-६-१२३", "content_sanskrit": "चिराय यत्कृतं सौम्य चिरमस्मिन् दुःखितः ।\nगाथाश्चाप्यब्रवीद्विद्वान्गौतमो मुनिसत्तमः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003619123, "chapter_id": 23619, "verse_number": "१-२-६-१२४", "content_sanskrit": "चिरेण मंत्रं संधीयाच्चिरेम च कृतं त्यजेत् ।\nचिरेण विहतं मित्रं चिरं धारणमर्हति ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7003619124, "chapter_id": 23619, "verse_number": "१-२-६-१२५", "content_sanskrit": "रोगे दर्पे च माने च द्रोहे पापे च कर्मणि ।\nअप्रिये चैव कर्तव्ये चिरकारी प्रशस्यते ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7003619125, "chapter_id": 23619, "verse_number": "१-२-६-१२६", "content_sanskrit": "बंधूनां सुहृदां चैव भृत्यानां स्त्रीजनस्य च ।\nअव्यक्तेष्वपराधेषु चिरकारी प्रशस्यते ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7003619126, "chapter_id": 23619, "verse_number": "१-२-६-१२७", "content_sanskrit": "चिरं धर्मान्निषेवेत कुर्याच्चान्वेषणं चिरम् ।\nचिरमन्वास्य विदुषश्चिरमिष्टानुपास्य च ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7003619127, "chapter_id": 23619, "verse_number": "१-२-६-१२८", "content_sanskrit": "चिरं विनीय चात्मानं चिरं यात्यनवज्ञताम् ।\nब्रुवतश्च परस्यापि वाक्यं धर्मोपसंहितम् ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7003619128, "chapter_id": 23619, "verse_number": "१-२-६-१२९", "content_sanskrit": "चिरं पृच्छेच्च श्रृणुयाच्चिरं न परिभूयते ।\nधर्मे शत्रौ शस्त्रहस्ते पात्रे च निकटस्थिते ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7003619129, "chapter_id": 23619, "verse_number": "१-२-६-१३०", "content_sanskrit": "भये च साधुपूजायां चिरकारी न शस्यते ।\nएवमुक्त्वा पुत्रभार्यासहितः प्राप्य चाश्रमम् ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7003619130, "chapter_id": 23619, "verse_number": "१-२-६-१३१", "content_sanskrit": "ततश्चिरमुपास्याथ दिवं यातिश्चिरं मुनिः ।\nवयं त्वेवं ब्रुवन्तोऽपि मोहेनैवं प्रतारिताः ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7003619131, "chapter_id": 23619, "verse_number": "१-२-६-१३२", "content_sanskrit": "कलौ च भवतां विप्रा मच्छापो निपतिष्यति ।\nकेचित्सदा भविष्यंति विप्राः सर्वगुणैर्युताः ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7003619132, "chapter_id": 23619, "verse_number": "१-२-६-१३३", "content_sanskrit": "पादप्रक्षालनं कृत्वा ततोऽहं धर्मवर्मणः ।\nसमीपे साक्षिणो देवान्कृत्वा संकल्पमाचरम् ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7003619133, "chapter_id": 23619, "verse_number": "१-२-६-१३४", "content_sanskrit": "कांचनैरर्नोप्रदानैश्च गृहदानैर्धनादिभिः ।\nभार्याभूषणवस्त्रैश्च कृतार्था ब्राह्मणाः कृताः ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7003619134, "chapter_id": 23619, "verse_number": "१-२-६-१३५", "content_sanskrit": "ततः करं समुद्यम्य प्राहेन्द्रो देवसंगमे ।\nहरांगरुद्धवामार्द्ध यावद्देवी गिरेः सुता ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7003619135, "chapter_id": 23619, "verse_number": "१-२-६-१३६", "content_sanskrit": "गणाधीशो वयं यावद्यावत्त्रिभुवनं त्विदम् ।\nतावन्नन्द्यादिदे स्थानं नारदस्थापितं सुराः ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7003619136, "chapter_id": 23619, "verse_number": "१-२-६-१३७", "content_sanskrit": "ब्रह्मशापो रुद्रशापो विष्णुशापस्तथैव च ।\nद्विजशापस्तथा भूयादिदं स्थानं विलुंपतः ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7003619137, "chapter_id": 23619, "verse_number": "१-२-६-१३८", "content_sanskrit": "ततस्तथेति तैः सर्वैर्हृष्टैस्तत्र तथोदितम् ।\nएवं मया स्थापिते स्थानकेऽस्मिन्संस्थापयामास च कापिलं मुनिः ।\nस्थाने उभे देवकृते प्रसन्नास्ततो ययुर्देवता देवसद्म ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}]