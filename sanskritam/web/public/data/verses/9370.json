[{"id": 40021846, "chapter_id": 9370, "verse_number": "1", "content_sanskrit": "तथा सञ्चोदितः सूतो लक्ष्मणेन महात्मना । तद्वाक्यमृषिणा प्रोक्तं व्याहर्तुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40021847, "chapter_id": 9370, "verse_number": "2", "content_sanskrit": "पुरा नाम्ना हि दुर्वासा अत्रेः पुत्रो महामुनिः । वसिष्ठस्याश्रमे पुण्ये वार्षिक्यं समुवास ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40021848, "chapter_id": 9370, "verse_number": "3", "content_sanskrit": "तमाश्रमं महातेजाः पिता ते सुमहायशाः । पुरोहितं महात्मानं दिदृक्षुरगमस्त्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40021849, "chapter_id": 9370, "verse_number": "4", "content_sanskrit": "स दृष्ट्वा सूर्यसङ्काशं ज्वलन्तमिव तेजसा । उपविष्टं वसिष्ठस्य सव्यपार्श्वे महामुनिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40021850, "chapter_id": 9370, "verse_number": "5", "content_sanskrit": "तौ मुनी तापसश्रेष्ठौ विनीतो ह्यभिवादयत् । स ताभ्यां पूजितो राजा स्वागतेनासनेन च ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40021851, "chapter_id": 9370, "verse_number": "6", "content_sanskrit": "पाद्येन फलमूलैश्च उवास मुनिभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40021852, "chapter_id": 9370, "verse_number": "7", "content_sanskrit": "तेषां तत्रोपविष्टानां तास्ताः सुमधुराः कथाः । बभूवुः परमर्षीणां मध्यादित्यगते ऽहनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40021853, "chapter_id": 9370, "verse_number": "8", "content_sanskrit": "ततः कथायां कस्याञ्चित्प्राञ्जलिः प्रग्रहो नृपः । उवाच तं महात्मानमत्रेः पुत्रं तपोधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40021854, "chapter_id": 9370, "verse_number": "9", "content_sanskrit": "भगवन्किं प्रमाणेन मम वंशो भविष्यति । किमायुश्च हि मे रामः पुत्राश्चान्ये किमायुषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40021855, "chapter_id": 9370, "verse_number": "10", "content_sanskrit": "रामस्य च सुता ये स्युस्तेषामायुः कियद्भवेत् । काम्यया भगवन्बूहि वंशस्यास्य गतिं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40021856, "chapter_id": 9370, "verse_number": "11", "content_sanskrit": "तच्छ्रुत्वा व्याहृतं वाक्यं राज्ञो दशरथस्य च । दुर्वासाः सुमहातेजा व्याहर्तुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40021857, "chapter_id": 9370, "verse_number": "12", "content_sanskrit": "शृणु राजन्पुरावृत्तं तदा देवासुरे युधि । दैत्याः सुरैर्भर्त्स्यमाना भृगुपत्नीं समाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40021858, "chapter_id": 9370, "verse_number": "13", "content_sanskrit": "तया परिगृहीतांस्तान्दृष्ट्वा क्रुद्धः सुरेश्वरः । चक्रेण शितधारेण भृगुपत्न्याः शिरो ऽहरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40021859, "chapter_id": 9370, "verse_number": "14", "content_sanskrit": "ततस्तां निहतां दृष्ट्वा पत्नीं भृगुकुलोद्वहः । शशाप सहसा क्रुद्धो विष्णुं रिपुकुलार्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40021860, "chapter_id": 9370, "verse_number": "15", "content_sanskrit": "यस्मादवध्यां मे पत्नीमवधीः क्रोधमूर्च्छितः । तस्मात्त्वं मानुषे लोके जनिष्यसि जनार्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40021861, "chapter_id": 9370, "verse_number": "16", "content_sanskrit": "तत्र पत्नीवियोगं त्वं प्राप्स्यसे बहुवार्षिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40021862, "chapter_id": 9370, "verse_number": "17", "content_sanskrit": "शापाभिहतचेतास्स स्वात्मना भावितो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40021863, "chapter_id": 9370, "verse_number": "18", "content_sanskrit": "अर्चयामास तं देवं भृगुः शापेन पीडितः । तपसाराधितो देवो ह्यब्रवीद्भक्तवत्सलः । लोकानां संहितार्थं तु तं शापं ग्राह्यमुक्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40021864, "chapter_id": 9370, "verse_number": "19", "content_sanskrit": "इति शप्तो महातेजा भृगुणा पूर्वजन्मनि । इहागतो हि पुत्रत्वं तव पार्थिवसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40021865, "chapter_id": 9370, "verse_number": "20", "content_sanskrit": "राम इत्यभिविख्यातस्त्रिषु लोकेषु मानद । तत्फलं प्राप्स्यते चापि भृगुशापकृतं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40021866, "chapter_id": 9370, "verse_number": "21", "content_sanskrit": "अयोध्यायाः पती रामो दीर्घकालं भविष्यति । सुखिनश्च समृद्धाश्च भविष्यन्त्यस्य ये ऽनुगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40021867, "chapter_id": 9370, "verse_number": "22", "content_sanskrit": "दश वर्षसहस्राणि दश वर्षशतानि च । रामो राज्यमुपासित्वा ब्रह्मलोकं गमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40021868, "chapter_id": 9370, "verse_number": "23", "content_sanskrit": "समृद्धैश्चाश्वमेधैश्च इष्ट्वा परमदुर्जयः । राजवंशांश्च बहुशो बहून्संस्थापयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40021869, "chapter_id": 9370, "verse_number": "24", "content_sanskrit": "द्वौ पुत्रौ तु भविष्येते सीतायां राघवस्य तु । अन्यत्र न त्वयोध्यायां सत्यमेतन्नसंशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40021870, "chapter_id": 9370, "verse_number": "25", "content_sanskrit": "सीतायाश्च ततः पुत्रावभिषेक्ष्यति राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40021871, "chapter_id": 9370, "verse_number": "26", "content_sanskrit": "स सर्वमखिलं राज्ञो वंशस्याह गतागतम् । आख्याय सुमहातेजास्तूष्णीमासीन्महामुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40021872, "chapter_id": 9370, "verse_number": "27", "content_sanskrit": "तूष्णीम्भूते तदा तस्मिन्राजा दशरथो मुनौ । अभिवाद्य महात्मानौ पुनरायात्पुरोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40021873, "chapter_id": 9370, "verse_number": "28", "content_sanskrit": "एतद्वचो मया तत्र मुनिना व्याहृतं पुरा । श्रुतं हृदि च निक्षिप्तं नान्यथा तद्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40021874, "chapter_id": 9370, "verse_number": "29", "content_sanskrit": "एवं गते न सन्तापं कर्तुमर्हसि राघव । सीतार्थे राघवार्थे वा दृढो भव नरोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40021875, "chapter_id": 9370, "verse_number": "30", "content_sanskrit": "श्रुत्वा तु व्याहृतं वाक्यं सूतस्य परमाद्भुतम् । प्रहर्षमतुलं लेभे साधु साध्विति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40021876, "chapter_id": 9370, "verse_number": "31", "content_sanskrit": "ततः संवदतोरेवं सूतलक्ष्मणयोः पथि । अस्तमर्के गते वासं केशिन्यां तावथोषतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]