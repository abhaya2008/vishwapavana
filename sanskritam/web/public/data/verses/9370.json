[{"id": 5000370000, "chapter_id": 9370, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे एकत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000370001, "chapter_id": 9370, "verse_number": "५-३१-१", "content_sanskrit": "एवं बहुविधां चिन्तां चिन्तयित्वा महामतिः।\nसंश्रवे मधुरं वाक्यं वैदेह्या व्याजहार ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000370002, "chapter_id": 9370, "verse_number": "५-३१-२", "content_sanskrit": "राजा दशरथो नाम रथकुञ्जरवाजिमान्।\nपुण्यशीलो महाकीर्तिरिक्ष्वाकूणां महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000370003, "chapter_id": 9370, "verse_number": "५-३१-३", "content_sanskrit": "राजर्षीणां गुणश्रेष्ठस्तपसा चर्षिभिः समः।\nचक्रवर्तिकुले जातः पुरंदरसमो बले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000370004, "chapter_id": 9370, "verse_number": "५-३१-४", "content_sanskrit": "अहिंसारतिरक्षुद्रो घृणी सत्यपराक्रमः।\nमुख्यस्येक्ष्वाकुवंशस्य लक्ष्मीवाँल्लक्ष्मिवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000370005, "chapter_id": 9370, "verse_number": "५-३१-५", "content_sanskrit": "पार्थिवव्यञ्जनैर्युक्तः पृथुश्रीः पार्थिवर्षभः।\nपृथिव्यां चतुरन्तायां विश्रुतः सुखदः सुखी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000370006, "chapter_id": 9370, "verse_number": "५-३१-६", "content_sanskrit": "तस्य पुत्रः प्रियो ज्येष्ठस्ताराधिपनिभाननः।\nरामो नाम विशेषज्ञः श्रेष्ठः सर्वधनुष्मताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000370007, "chapter_id": 9370, "verse_number": "५-३१-७", "content_sanskrit": "रक्षिता स्वस्य वृत्तस्य स्वजनस्यापि रक्षिता।\nरक्षिता जीवलोकस्य धर्मस्य च परंतपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000370008, "chapter_id": 9370, "verse_number": "५-३१-८", "content_sanskrit": "तस्य सत्याभिसंधस्य वृद्धस्य वचनात् पितुः।\nसभार्यः सह च भ्रात्रा वीरः प्रव्रजितो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000370009, "chapter_id": 9370, "verse_number": "५-३१-९", "content_sanskrit": "तेन तत्र महारण्ये मृगयां परिधावता।\nराक्षसा निहताः शूरा बहवः कामरूपिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000370010, "chapter_id": 9370, "verse_number": "५-३१-१०", "content_sanskrit": "जनस्थानवधं श्रुत्वा निहतौ खरदूषणौ।\nततस्त्वमर्षापहृता जानकी रावणेन तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000370011, "chapter_id": 9370, "verse_number": "५-३१-११", "content_sanskrit": "वञ्चयित्वा वने रामं मृगरूपेण मायया।\nस मार्गमाणस्तां देवीं रामः सीतामनिन्दिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000370012, "chapter_id": 9370, "verse_number": "५-३१-१२", "content_sanskrit": "आससाद वने मित्रं सुग्रीवं नाम वानरम्।\nततः स वालिनं हत्वा रामः परपुरंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000370013, "chapter_id": 9370, "verse_number": "५-३१-१३", "content_sanskrit": "आयच्छत् कपिराज्यं तु सुग्रीवाय महात्मने।\nसुग्रीवेणाभिसंदिष्टा हरयः कामरूपिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000370014, "chapter_id": 9370, "verse_number": "५-३१-१४", "content_sanskrit": "दिक्षु सर्वासु तां देवीं विचिन्वन्तः सहस्रशः।\nअहं सम्पातिवचनाच्छतयोजनमायतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000370015, "chapter_id": 9370, "verse_number": "५-३१-१५", "content_sanskrit": "तस्या हेतोर्विशालाक्ष्याः समुद्रं वेगवान् प्लुतः।\nयथारूपां यथावर्णां यथालक्ष्मवतीं च ताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000370016, "chapter_id": 9370, "verse_number": "५-३१-१६", "content_sanskrit": "अश्रौषं राघवस्याहं सेयमासादिता मया।\nविररामैवमुक्त्वा स वाचं वानरपुंगवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000370017, "chapter_id": 9370, "verse_number": "५-३१-१७", "content_sanskrit": "जानकी चापि तच्छ्रुत्वा विस्मयं परमं गता।\nततः सा वक्रकेशान्ता सुकेशी केशसंवृतम्।\nउन्नम्य वदनं भीरुः शिंशपामन्ववैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000370018, "chapter_id": 9370, "verse_number": "५-३१-१८", "content_sanskrit": "निशम्य सीता वचनं कपेश्च\nदिशश्च सर्वाः प्रदिशश्च वीक्ष्य।\nस्वयं प्रहर्षं परमं जगाम\nसर्वात्मना राममनुस्मरन्ती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000370019, "chapter_id": 9370, "verse_number": "५-३१-१९", "content_sanskrit": "सा तिर्यगूर्ध्वं च तथा ह्यधस्ता-\nन्निरीक्षमाणा तमचिन्त्यबुद्धिम्।\nददर्श पिंगाधिपतेरमात्यं\nवातात्मजं सूर्यमिवोदयस्थम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000370020, "chapter_id": 9370, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे एकत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]