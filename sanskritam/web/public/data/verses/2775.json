[{"id": 2083270, "chapter_id": 2775, "verse_number": "१२-२८०-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2083271, "chapter_id": 2775, "verse_number": "१२-२८०-१", "content_sanskrit": "मोक्षः पितामहेनोक्त उपायान्नानुपायतः।\nतमुपायं यथान्यायं श्रोतुमिच्छामि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2083272, "chapter_id": 2775, "verse_number": "१२-२८०-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2083273, "chapter_id": 2775, "verse_number": "१२-२८०-२", "content_sanskrit": "त्वय्येवैतन्महाप्राज्ञ युक्तं निपुणदर्शनम्।\nयदुपायेन सर्वार्थं नित्यं मृगयसेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2083274, "chapter_id": 2775, "verse_number": "१२-२८०-३", "content_sanskrit": "करणे घटस्य या बुद्धिर्घटोत्पत्तौ न सा मता।\nएवं धर्माभ्यपायेषु नान्यद्धर्मेषु कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2083275, "chapter_id": 2775, "verse_number": "१२-२८०-४", "content_sanskrit": "पूर्वे समुद्रे यः पन्थाः स न गच्छति पश्चिमम्।\nएकः पन्था हि मोक्षस्य तन्मे विस्तरतः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2083276, "chapter_id": 2775, "verse_number": "१२-२८०-५", "content_sanskrit": "क्षमया क्रोधमुच्छिन्द्यात्कामं संकल्पवर्जनात्।\nसत्वसंसेवानद्धीरो निद्रामुच्छेत्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2083277, "chapter_id": 2775, "verse_number": "१२-२८०-६", "content_sanskrit": "अप्रमादाद्भयं रक्षेच्छ्वासं क्षेत्रज्ञशीलनात्।\nइच्छां द्वेषं च कामं च धैर्येण विनिवर्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2083278, "chapter_id": 2775, "verse_number": "१२-२८०-७", "content_sanskrit": "भ्रमं संमोहमावर्तमभ्यासाद्विनिवर्तयेत्।\nनिद्रां चाप्रतिभां चैव ज्ञानाभ्यासेन तत्त्ववित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2083279, "chapter_id": 2775, "verse_number": "१२-२८०-८", "content_sanskrit": "उपद्रवांस्तथा रोगान्हितजीर्णमिताशनात्।\nलोभं मोहं च संतोषाद्विषयांस्तत्त्वदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2083280, "chapter_id": 2775, "verse_number": "१२-२८०-९", "content_sanskrit": "अनुक्रोशादधर्मं च जयेद्धर्ममवेक्षया।\nआयत्या च जयेदाशामर्थं सङ्गविवर्जनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2083281, "chapter_id": 2775, "verse_number": "१२-२८०-१०", "content_sanskrit": "अनित्यत्वेन च स्नेहं क्षुधं योगेन पण्डितः।\nकारुण्येनात्मनो मानं तृष्णां च परितोषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2083282, "chapter_id": 2775, "verse_number": "१२-२८०-११", "content_sanskrit": "उत्थानेन जयेत्तन्द्रीं वितर्कं निश्चयाज्जयेत्।\nमौनेन बहुभाषां च शौर्येण च भयं जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2083283, "chapter_id": 2775, "verse_number": "१२-२८०-१२", "content_sanskrit": "यच्छेद्वाङ्भनसी बुद्ध्या तां यच्छेज्ज्ञानचक्षुषा।\nज्ञानमात्मा महान्यच्छेत्तं यच्छेज्ज्ञानमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2083284, "chapter_id": 2775, "verse_number": "१२-२८०-१३", "content_sanskrit": "तदेतदुपशान्तेन बोद्धव्यं शुचिकर्मणा।\nयोगदोषान्समुच्छिद्यात्पञ्च यान्कवयो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2083285, "chapter_id": 2775, "verse_number": "१२-२८०-१४", "content_sanskrit": "कामं क्रोधं च लोभं च भयं स्वप्नं च पञ्चमम्।\nपरित्यज्य निषेवेत तथेमान्योगसाधनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2083286, "chapter_id": 2775, "verse_number": "१२-२८०-१५", "content_sanskrit": "ध्यानमध्ययनं दानं सत्यं ह्रीरार्जवं क्षमा।\nशौचमाहारतः शुद्धिरिन्द्रियाणां च संयमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2083287, "chapter_id": 2775, "verse_number": "१२-२८०-१६", "content_sanskrit": "एतैर्विवर्धते तेजः पाप्मानमपहन्ति च।\nसिध्यन्ति चास्य संकल्पा विज्ञानं च प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2083288, "chapter_id": 2775, "verse_number": "१२-२८०-१७", "content_sanskrit": "धूतपापः स तेजस्वी लध्वाहारो जितेन्द्रियः।\nकामक्रोधौ वशे कृत्वा निनीषेद्ब्रह्मणः पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2083289, "chapter_id": 2775, "verse_number": "१२-२८०-१८", "content_sanskrit": "अमूढत्वमसङ्गित्वं कामक्रोधविवर्जनम्।\nअदैन्यमनुदीर्णत्वमनुद्वेगो व्यवस्थितिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2083290, "chapter_id": 2775, "verse_number": "१२-२८०-१९", "content_sanskrit": "एष मार्गो हि मोक्षस्य प्रसन्नो विमलः शुचिः।\nतथा वाक्कायमनसां नियमः कामतोऽन्यथा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2083291, "chapter_id": 2775, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि अशीत्यधिकद्विशततमोऽध्यायः॥ २८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]