[{"id": 7002923000, "chapter_id": 22923, "verse_number": "९-२०८-१", "content_sanskrit": "व्यासानुगमनं पूर्वं ब्रह्मांडस्य समुद्भवः ।\nमाया च वैष्णवी यस्मात्संसारे दोषकीर्तनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002923001, "chapter_id": 22923, "verse_number": "९-२०८-२", "content_sanskrit": "पापभेदस्ततस्तस्माच्छुभाशुभविनिर्णयः ।\nशकटव्रतमाहात्म्यं तिलकव्रतकीर्तनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002923002, "chapter_id": 22923, "verse_number": "९-२०८-३", "content_sanskrit": "अशोककरवीराख्यं व्रतं तस्माच्च कोकिलम् ।\nबृहत्तपोव्रतं नाम रुद्रोपोषणमेव च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002923003, "chapter_id": 22923, "verse_number": "९-२०८-४", "content_sanskrit": "द्वितीयाव्रतमाहात्म्यमशून्य शयनं तथा ।\nकामाख्या तु तृतीया च मेघपालीव्रतं तथा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002923004, "chapter_id": 22923, "verse_number": "९-२०८-५", "content_sanskrit": "पंचाग्निसाधना रम्या तृतीयाव्रतमुत्तमम् ।\nत्रिरात्रं गोष्पदं नाम हरकाली व्रतं तथा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002923005, "chapter_id": 22923, "verse_number": "९-२०८-६", "content_sanskrit": "ललिताख्या तृतीया च योगाख्या च तथापरा ।\nउमामहेश्वरं नाम तथा रंभातृतीयकम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002923006, "chapter_id": 22923, "verse_number": "९-२०८-७", "content_sanskrit": "सौभाग्याख्या तृतीया च आर्द्रानंदकरी था ।\nचैत्रे भाद्रपदे माघे तृतीयाव्रतमुच्यते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002923007, "chapter_id": 22923, "verse_number": "९-२०८-८", "content_sanskrit": "अनंतरी तृतीया च गणशांतिव्रतं तथा ।\nसारस्वतव्रतं नाम पंचमीव्रत मुच्यते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002923008, "chapter_id": 22923, "verse_number": "९-२०८-९", "content_sanskrit": "तथा श्रीपंचमी नाम षष्ठी शोकप्रणाशिनी ।\nफलषष्ठी च मंदारषष्ठीव्रतमथोच्यते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002923009, "chapter_id": 22923, "verse_number": "९-२०८-१०", "content_sanskrit": "ललिताव्रतषष्ठी च षष्ठी कार्तिकसंज्ञिता ।\nमहत्तपः सप्तमी च विभूषा सप्तमी तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002923010, "chapter_id": 22923, "verse_number": "९-२०८-११", "content_sanskrit": "आदित्यमंडपविधिस्त्रयोदशीति सप्तमी ।\nकृकवाकुप्लवङ्गा च तथैवाभयसप्तमी ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002923011, "chapter_id": 22923, "verse_number": "९-२०८-१२", "content_sanskrit": "कल्याणसप्तमी नाम शर्करासप्तमीव्रतम् ।\nसप्तमी कमलाख्या च तथान्या शुभसप्तमी ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002923012, "chapter_id": 22923, "verse_number": "९-२०८-१३", "content_sanskrit": "स्नपनव्रतसप्तम्यौ तथैवाचल सप्तमी ।\nबुधाष्टमीव्रतं नाम तथा जन्माष्टमीव्रतम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002923013, "chapter_id": 22923, "verse_number": "९-२०८-१४", "content_sanskrit": "दूर्वाकृष्णाष्टमी प्रोक्ता अनयाव्रतमष्टमी ।\nअष्टम्यर्काष्टमी चाथ वृक्षनवमीव्रतम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002923014, "chapter_id": 22923, "verse_number": "९-२०८-१५", "content_sanskrit": "ध्वजाख्या नवमी चैव उल्काख्या नवमी तथा ।\nदशावतारव्रतकं तथाशादशमीव्रतम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002923015, "chapter_id": 22923, "verse_number": "९-२०८-१६", "content_sanskrit": "रोहिणींहरिशंभुब्रह्मसूर्यावियोगकम् ।\nगोवत्सद्वादशीनाम व्रतमुक्तं ततः परम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002923016, "chapter_id": 22923, "verse_number": "९-२०८-१७", "content_sanskrit": "नीराजनद्वादशी च भीष्मपंचकमेव च ।\nमल्लिकाख्या द्वादशी च भीमा द्वादशिकोत्तमा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002923017, "chapter_id": 22923, "verse_number": "९-२०८-१८", "content_sanskrit": "श्रवणद्वादशी नाम संप्राप्तिद्वादशीव्रतम् ।\nगोविन्दद्वादशीनाम व्रतमुक्तं ततः परम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002923018, "chapter_id": 22923, "verse_number": "९-२०८-१९", "content_sanskrit": "अखंडद्वादशीनाम तिलद्वादश्यतः परम् ।\nसुकृतद्वादशी नाम धरणीव्रतमेव च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002923019, "chapter_id": 22923, "verse_number": "९-२०८-२०", "content_sanskrit": "विशोकद्वादशी नाम विभूतिद्वादशीव्रतम् ।\nपुष्यर्क्षद्वादशी चैव द्वादशी श्रवणर्क्षगा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002923020, "chapter_id": 22923, "verse_number": "९-२०८-२१", "content_sanskrit": "अनंगद्वादशी चैव अङ्गपादव्रतं तथा ।\nनिम्बार्ककरवीराथ यमा दर्शत्रयोदशी ।\nअनंगद्वादशी चापि पालिरम्भाव्रते तथा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002923021, "chapter_id": 22923, "verse_number": "९-२०८-२२", "content_sanskrit": "चतुर्दशीव्रतं प्रोक्तं ततोऽनन्तचतुर्दशी ।\nश्रावणीव्रतनक्तं च चतुर्दश्यष्टमीदिने ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002923022, "chapter_id": 22923, "verse_number": "९-२०८-२३", "content_sanskrit": "व्रतं शिवचतुर्दश्यां फलत्यागचतुर्दशी ।\nवैशाखी कार्तिकी माघी व्रतमेतदनंतरन् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002923023, "chapter_id": 22923, "verse_number": "९-२०८-२४", "content_sanskrit": "कार्तिक्यां कृत्तिकायोगे कृत्तिकाव्रतमीरितम् ।\nफाल्गुने पूर्णिमायां तु व्रतं पूर्णमनोरथम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002923024, "chapter_id": 22923, "verse_number": "९-२०८-२५", "content_sanskrit": "अशोकपूर्णिमा नाम अनंतव्रतमेव च ।\nव्रतं हि सांभरायिण्यं नक्षत्रपुरुषव्रतम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002923025, "chapter_id": 22923, "verse_number": "९-२०८-२६", "content_sanskrit": "शिवनक्षत्रपुरुषं संपूर्णं येन मुच्यते ।\nकामदानव्रतं नाम वृन्ताकविधिरेव च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002923026, "chapter_id": 22923, "verse_number": "९-२०८-२७", "content_sanskrit": "आदित्यस्य दिने नक्तं संक्रात्युद्यापने फलम् ।\nभद्राव्रतमगस्त्यार्घो नवचन्द्रार्कमेव च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002923027, "chapter_id": 22923, "verse_number": "९-२०८-२८", "content_sanskrit": "अर्घः शुक्रबृहस्पत्योः पंचाशीति व्रतानि च ।\nमाघस्नानं नित्यस्नानं रुद्रस्तानविधिस्तथा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002923028, "chapter_id": 22923, "verse_number": "९-२०८-२९", "content_sanskrit": "चंद्रार्कग्रहणे स्नानं विधिश्चान्नाशने तथा ।\nवापीकूपतडागानामुत्सर्गो वृक्षयाजनम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002923029, "chapter_id": 22923, "verse_number": "९-२०८-३०", "content_sanskrit": "देवपूजादीपदानवृषोत्सर्गविधिस्तथा ।\nफाल्गुन्युत्सवकं नाम तथान्यः सदनोत्सवः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002923030, "chapter_id": 22923, "verse_number": "९-२०८-३१", "content_sanskrit": "भूतमाता च श्रावण्यां रक्षाबंधविधिस्तथा ।\nविधिस्तथा नवम्यास्तु तथा चन्द्रमहोत्सवः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002923031, "chapter_id": 22923, "verse_number": "९-२०८-३२", "content_sanskrit": "दीपालिकायां तु होमो लक्षहोमविधिस्तथा ।\nकोटिहोमो महाशीतिर्गणनाथस्य शातिका ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002923032, "chapter_id": 22923, "verse_number": "९-२०८-३३", "content_sanskrit": "तथा नक्षत्रहोमोथ गोदानविधिरेव च ।\nगुडधेनुघृतधेनुतिलधेनुव्रतं तथा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002923033, "chapter_id": 22923, "verse_number": "९-२०८-३४", "content_sanskrit": "जलधेनुविधिः प्रोक्तो लवणस्य तथा परा ।\nधेनुः कार्यासमंज्ञात्वा नवनीतस्य चापरा ।\nसुवर्णधेनुश्च तथा देवकार्यं चिकीर्षुभिः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]