[{"id": 2121582, "chapter_id": 3606, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2121583, "chapter_id": 3606, "verse_number": "१", "content_sanskrit": "शूरसेनपुरं त्यक्त्वा सर्वयादवनन्दनः ।\nद्वारकां भगवान् कृष्णः समपद्यत केशवः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2121584, "chapter_id": 3606, "verse_number": "२", "content_sanskrit": "प्रत्यपद्यत यानानि रत्नानि च बहूनि च ।\nयथार्हं पुण्डरीकाक्षो नैरृतान् प्रत्यपादयन्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2121585, "chapter_id": 3606, "verse_number": "३", "content_sanskrit": "तत्र विघ्नं चरन्ति स्म दैतेयाः सह दानवैः ।\nतान् जघान महाबाहुर्वरदृप्तान् महासुरान्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2121586, "chapter_id": 3606, "verse_number": "४", "content_sanskrit": "स विघ्नमकरोत् तत्र नरको नाम नैरृतः ।\nत्रासनः सुरसङ्घानां विदितो नः प्रभावतः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2121587, "chapter_id": 3606, "verse_number": "५", "content_sanskrit": "स भूम्यां मूर्ध्निलिङ्गस्थः सर्वदेवासुरान्तकः ।\nमानुषाणामृषीणां च प्रतीपमकरोत् तदा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2121588, "chapter_id": 3606, "verse_number": "६", "content_sanskrit": "त्वष्टुर्दुहितरं भौमः कशेरुमगमत् तदा ।\nगजरूपेण जग्राह रुचिराङ्गीं चतुर्दशीम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2121589, "chapter_id": 3606, "verse_number": "७", "content_sanskrit": "प्रमथ्य च जहारैतां हृत्वा च नरकोऽब्रवीत् ।\nनष्टशोकभयाबाधः प्राग्ज्योतिषगतस्तदा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2121590, "chapter_id": 3606, "verse_number": "८", "content_sanskrit": "यानि देवमनुष्येषु रत्नानि विविधानि च ।\nबिभर्ति च मही कृत्स्ना सागरेषु च यद् वसु\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2121591, "chapter_id": 3606, "verse_number": "९", "content_sanskrit": "अद्यप्रभृति तद् देवि सहिताः सर्वनैरृताः ।\nतवैवोपहरिष्यन्ति दैत्याश्च सह दानवैः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2121592, "chapter_id": 3606, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2121593, "chapter_id": 3606, "verse_number": "१०", "content_sanskrit": "एवमुत्तमरत्नानि बहूनि विविधानि च ।\nस जहार तदा भौमः स्त्रीरत्नानि च भारत ।\nगन्धर्वाणां च याः कन्या जहार नरको बलात्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2121594, "chapter_id": 3606, "verse_number": "११", "content_sanskrit": "याश्च देवमनुष्याणां सप्त चाप्सरसां गणाः ।\nचतुर्दशसहस्राणि चैकविंशच्छतानि च\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2121595, "chapter_id": 3606, "verse_number": "१२", "content_sanskrit": "एकवेणीधराः सर्वाः सतां मार्गमनुव्रताः ।\nतासामन्तःपुरं भौमोऽकारयन्मणिपर्वते ।\nऔदकायामदीनात्मा मुरस्य विषयं प्रति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2121596, "chapter_id": 3606, "verse_number": "१३", "content_sanskrit": "ताश्च प्राग्ज्योतिषो राजा मुरस्य दश चात्मजाः ।\nनैरृताश्च यथा मुख्या बोधयन्त उपासते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2121597, "chapter_id": 3606, "verse_number": "१४", "content_sanskrit": "स एष तपसश्चारे वरदृप्तो महासुरः ।\nअदितिं धर्षयामास कुण्डलार्थं युधिष्ठिर\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2121598, "chapter_id": 3606, "verse_number": "१५", "content_sanskrit": "न चासुरगणैः सर्वैः सहितैः कर्म तत् पुरा ।\nकृतपूर्वं महाघोरं यदकार्षीन्महासुरः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2121599, "chapter_id": 3606, "verse_number": "१६", "content_sanskrit": "यं मही सुषुवे देवी यस्य प्राग्ज्योतिषं पुरम् ।\nविषयान्तपालाश्चत्वारो यस्यासन् युद्धदुर्मदाः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2121600, "chapter_id": 3606, "verse_number": "१७", "content_sanskrit": "आदेवयानमावृत्य पन्थानं पर्यवस्थिताः ।\nत्रासनाः सर्वभूतानां विरूपै राक्षसैः सह\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2121601, "chapter_id": 3606, "verse_number": "१८", "content_sanskrit": "हयग्रीवो निसुम्भश्च घोरः पञ्चजनस्तथा ।\nमुरः पुत्रसहस्रैश्च वरदृप्तो महासुरः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2121602, "chapter_id": 3606, "verse_number": "१९", "content_sanskrit": "तद्वधार्थं महाबाहुरेष चक्रगदासिधृत् ।\nजातो वृष्णिषु देवक्यां वसुदेवात् जनार्दनः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2121603, "chapter_id": 3606, "verse_number": "२०", "content_sanskrit": "तस्यास्य पुरुषेन्द्रस्य लोकप्रथिततेजसः ।\nनिवासो द्वारका तात विदितो वः प्रधानतः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2121604, "chapter_id": 3606, "verse_number": "२१", "content_sanskrit": "अतीव हि पुरी रम्या द्वारका वासवक्षयात् ।\nअति वैराज्यमप्यद्धा प्रत्यक्षं ते युधिष्ठिर \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2121605, "chapter_id": 3606, "verse_number": "२२", "content_sanskrit": "तस्मिन् देवपुरप्रख्ये सा सभा वृष्णिसंश्रया ।\nसुधर्मेत्यभिविख्याता योजनायतविस्तृता\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2121606, "chapter_id": 3606, "verse_number": "२३", "content_sanskrit": "तत्र वृष्ण्यन्धकाः सर्वे रामकृष्णपुरोगमाः ।\nलोकयात्रामिमां कृत्स्नां परिरक्षन्त आसते\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2121607, "chapter_id": 3606, "verse_number": "२४", "content_sanskrit": "तत्रासीनेषु सर्वेषु कदाचिद् भरतर्षभ ।\nदिव्यगन्धा ववुर्वाताः कुसुमानां च वृष्टयः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2121608, "chapter_id": 3606, "verse_number": "२५", "content_sanskrit": "ततः सूर्यसहस्राभस्तेजोराशिर्महाद्भुतः ।\nमुहूर्तमन्तरिक्षेऽभूत् ततो भूमौ प्रतिष्ठितः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2121609, "chapter_id": 3606, "verse_number": "२६", "content_sanskrit": "मध्ये तु तेजसस्तस्य पाण्डरं गजमास्थितः ।\nवृतो देवगणैः सर्वैर्वासवः प्रत्यदृश्यत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2121610, "chapter_id": 3606, "verse_number": "२७", "content_sanskrit": "रामकृष्णौ च राजा च वृष्ण्यन्धकगणैः सह ।\nउत्थाय सहसा तस्मै नमस्कारमकुर्वत\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2121611, "chapter_id": 3606, "verse_number": "२८", "content_sanskrit": "सोऽवतीर्य गजात् तूर्णं परिष्वज्य जनार्दनम् ।\nसस्वजे बलदेवं च राजानं च तथाहुकम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2121612, "chapter_id": 3606, "verse_number": "२९", "content_sanskrit": "वसुदेवोद्धवौ चैव विकद्रुं च महामतिम् ।\nप्रद्युम्नसाम्बनिशठाननिरुद्धं ससात्यकिम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2121613, "chapter_id": 3606, "verse_number": "३०", "content_sanskrit": "गदं सारणमक्रूरं भानूल्कमविडूरथान् ।\nकृतवर्मं चारुदेष्णं दाशार्हाणां पुरोगमान् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2121614, "chapter_id": 3606, "verse_number": "३१", "content_sanskrit": "परिष्यज्य च दृष्ट्वा च भगवान् पाकशासनः ।\nप्रगृह्य पूजां तैर्दत्तामुवाचावनताननः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2121615, "chapter_id": 3606, "verse_number": "१७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां सभापर्वर्णि\nअष्टाचत्वारिंशोऽध्यायः ॥४८॥\n॥ अर्घाभिहरणपर्वणि सप्तदशोऽध्यायः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2121616, "chapter_id": 3606, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]