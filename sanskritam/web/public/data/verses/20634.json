[{"id": 7000634000, "chapter_id": 20634, "verse_number": "५-९३-१", "content_sanskrit": "नारद उवाच ।\nजातूकर्णवचश्चित्रमेवमाकर्ण्य भूपतिः ।\nतमुवाच नमस्कृत्य ज्ञानिनं मुनिमादरात् ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000634001, "chapter_id": 20634, "verse_number": "५-९३-२", "content_sanskrit": "दिवोदास उवाच ।\nकथमेषा विमुच्येत दुःखादस्मान्मुनेधुना ।\nजातूकर्ण उवाच ।\nकथयामि महत्पुण्यं येनेयं सुखिता भवेत् ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000634002, "chapter_id": 20634, "verse_number": "५-९३-३", "content_sanskrit": "अप्रकाशमपि प्रायः प्रवक्ष्यामि तवाग्रतः ।\nस्वल्पमप्यद्भुतं कर्म विकर्मशतनाशनम् ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000634003, "chapter_id": 20634, "verse_number": "५-९३-४", "content_sanskrit": "यथा हरेर्ध्यानबलेन पापं विनाशमायाति महत्समग्रम् ।\nप्रातस्तदा माधवमासदानस्नानेन घोरं विलयं प्रयाति ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000634004, "chapter_id": 20634, "verse_number": "५-९३-५", "content_sanskrit": "यथा हरेर्भीतिभयेन नागा नश्यंति सर्वे निचयास्तथैव ।\nनूनं रवौ मेषगते विभाति स्नानेन तीर्थे च हरिस्तवेन ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000634005, "chapter_id": 20634, "verse_number": "५-९३-६", "content_sanskrit": "तेजसा वैनतेयस्य पन्नगा इव पातकाः ।\nविद्रवंति च वैशाखस्नानेनोषसि निश्चितम् ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000634006, "chapter_id": 20634, "verse_number": "५-९३-७", "content_sanskrit": "तस्माद्देयापि भूपाल दिव्यादेवी पुनः स्वयम् ।\nकृत्वा वैशाखश्रवणं श्रुत्वा पापहरं स्तवम् ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000634007, "chapter_id": 20634, "verse_number": "५-९३-८", "content_sanskrit": "भवित्री भर्तुः संयोगसुखसंभोगभागिनी ।\nसुदेवोऽपि स जातोस्ति पांड्यदेशाधिपो बली ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000634008, "chapter_id": 20634, "verse_number": "५-९३-९", "content_sanskrit": "वैशाखमासि रेवायां स्नानपुण्येन भूपते ।\nतस्मा एव सुतां देहि विशुद्धां स्नानतस्तथा ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000634009, "chapter_id": 20634, "verse_number": "५-९३-१०", "content_sanskrit": "माधवस्य पुनः स्तोत्रं श्रवणान्माधवस्य च ।\nसंदेहो नात्र कर्तव्यो विचित्रं पश्य भूपते ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000634010, "chapter_id": 20634, "verse_number": "५-९३-११", "content_sanskrit": "इहामुत्रफलं तस्य समाख्यं पुण्यकर्मणः ।\nनारद उवाच ।\nइत्याकर्ण्यैव मुदितो राजा तमखिलं ततः ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000634011, "chapter_id": 20634, "verse_number": "५-९३-१२", "content_sanskrit": "कारयामास तां पुत्रीं जातूकर्णोदितं विधिम् ।\nवीरसेनेन तेनैव पांड्यदेशाधिपेन सा ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000634012, "chapter_id": 20634, "verse_number": "५-९३-१३", "content_sanskrit": "पुराजन्मैकसुहृदा दिव्यादेवी विवाहिता ।\nबुभुजे भूरिविषयांश्चिरं सुचरितव्रता ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000634013, "chapter_id": 20634, "verse_number": "५-९३-१४", "content_sanskrit": "वीरेसेनेन सुहृदा पूर्वजन्मकृतेन च ।\nएतत्ते किंचिदाख्यातमंबरीष समासतः ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000634014, "chapter_id": 20634, "verse_number": "५-९३-१५", "content_sanskrit": "वैशाखस्नानमाहात्म्यं किमन्यच्छ्रोतुमर्हसि ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]