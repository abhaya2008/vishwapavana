[{"id": 7005048000, "chapter_id": 25048, "verse_number": "७-१-२३१-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि यत्र जांबवती नदी ।\nपुरा जांबवतीनाम विष्णोर्या महिषीप्रिया ।\nअपृच्छदर्जुनं साध्वी वद वार्तां कुरू द्वह ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005048001, "chapter_id": 25048, "verse_number": "७-१-२३१-२", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा अर्जुनो निश्वसन्मुहुः ।\nवाष्पगद्गदया वाचा इदं वचनमब्रवीत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005048002, "chapter_id": 25048, "verse_number": "७-१-२३१-३", "content_sanskrit": "परित्यक्ता वयं भद्रे यादवैः सुमहात्मभिः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005048003, "chapter_id": 25048, "verse_number": "७-१-२३१-४", "content_sanskrit": "बलदेवस्य वीरस्य सात्यकेश्च महात्मनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005048004, "chapter_id": 25048, "verse_number": "७-१-२३१-५", "content_sanskrit": "अन्येषां यदुवीराणां पापकर्मातिनिर्घृणः ।\nजिजीविषुरिह प्राप्तो वासुदेवनिराकृतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005048005, "chapter_id": 25048, "verse_number": "७-१-२३१-६", "content_sanskrit": "सा श्रुत्वा भर्तृनिधनमर्जुनाच्च महासती ।\nगंगातीरे समुत्पाद्य पावकं पावकप्रभा ।\nसमुत्सृज्य महाकायं नदीभूत्वा विनिर्ययौ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005048006, "chapter_id": 25048, "verse_number": "७-१-२३१-७", "content_sanskrit": "सा गृहीत्वा सती भर्तुर्भस्म सर्वं चितेस्तथा ।\nप्रविष्टा सागरं देवि तदा जांबवती शुभा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005048007, "chapter_id": 25048, "verse_number": "७-१-२३१-८", "content_sanskrit": "या नारी तत्र देवेशि भक्त्या स्नानं समाचरेत् ।\nतदन्वयेपि काचित्स्त्री न वैधव्यमवाप्नुयात् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005048008, "chapter_id": 25048, "verse_number": "७-१-२३१-९", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन तत्र स्नानं समाचरेत् ।\nनरो वा यदि वा नारी प्राप्नोति परमां गतिम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]