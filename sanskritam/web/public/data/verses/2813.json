[{"id": 2085203, "chapter_id": 2813, "verse_number": "१२-३१८-०x", "content_sanskrit": "याज्ञवल्क्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2085204, "chapter_id": 2813, "verse_number": "१२-३१८-१", "content_sanskrit": "पादावध्यात्ममित्याहुर्ब्राह्मणास्तत्त्वदर्शिनः।\nगन्तव्यमधिभूतं च विष्णुस्तत्राधिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2085205, "chapter_id": 2813, "verse_number": "१२-३१८-२", "content_sanskrit": "पायुरध्यात्ममित्याहुर्यथातत्त्वार्थदर्शिनः।\nविसर्गमधिभूतं च मित्रस्तत्राधिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2085206, "chapter_id": 2813, "verse_number": "१२-३१८-३", "content_sanskrit": "उपस्थोऽध्यात्ममित्याहुर्यथायोगप्रदर्शिनः।\nअधिभूतं तथाऽऽनन्दो दैवतं च प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2085207, "chapter_id": 2813, "verse_number": "१२-३१८-४", "content_sanskrit": "हस्तावध्यात्ममित्याहुर्यथासङ्ख्यानदर्शिनः।\nकर्तव्यमधिभूतं तु इन्द्रस्तत्राधिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2085208, "chapter_id": 2813, "verse_number": "१२-३१८-५", "content_sanskrit": "वागध्यात्ममिति प्राहुर्यथाश्रुतिनिदर्शिनः।\nवक्तव्यमधिभूतं तु वह्निस्तत्राधिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2085209, "chapter_id": 2813, "verse_number": "१२-३१८-६", "content_sanskrit": "चक्षुरध्यात्ममित्याहुर्यथाश्रुतिनिदर्शिनः।\nरूपमत्राधिभूतं तु सूर्यश्चाप्यधिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2085210, "chapter_id": 2813, "verse_number": "१२-३१८-७", "content_sanskrit": "श्रोत्रमध्यात्ममित्याहुर्यथाश्रुतिनिदर्शिनः।\nशब्दस्तत्राधिभूतं तु दिशश्चात्राधिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2085211, "chapter_id": 2813, "verse_number": "१२-३१८-८", "content_sanskrit": "जिह्वामध्यात्ममित्याहुर्यथाश्रुतिनिदर्शिनः।\nरस एवाधिभूतं तु आपस्तत्राधिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2085212, "chapter_id": 2813, "verse_number": "१२-३१८-९", "content_sanskrit": "घ्राणमध्यात्ममित्याहुर्थथाश्रुतिनिदर्शिनः।\nगन्ध एवाधिभूतं तु पृथिवी चाधिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2085213, "chapter_id": 2813, "verse_number": "१२-३१८-१०", "content_sanskrit": "त्वगध्यात्ममिति प्राहुस्तत्त्वबुद्धिविशारदाः।\nस्पर्शमेवाधिभूतं तु पवनश्चाधिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2085214, "chapter_id": 2813, "verse_number": "१२-३१८-११", "content_sanskrit": "मनोऽध्यात्ममिति प्राहुर्यथा शास्त्रविशारदाः।\nमन्तव्यमधिभूतं तु चन्द्रमाश्चाधिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2085215, "chapter_id": 2813, "verse_number": "१२-३१८-१२", "content_sanskrit": "आहंकारिकमध्यात्ममाहुस्तत्त्वनिदर्शिनः।\nअभिमानोऽधिभूतं तु बुद्धिश्चात्राधिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2085216, "chapter_id": 2813, "verse_number": "१२-३१८-१३", "content_sanskrit": "बुद्धिरध्यात्ममित्याहुर्यथावदभिदर्शिनः।\nबोद्धव्यमधिभूतं तु क्षेत्रज्ञश्चाधिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2085217, "chapter_id": 2813, "verse_number": "१२-३१८-१४", "content_sanskrit": "एषा ते व्यक्तितो राजन्विभूतिरनुदर्शिता।\nआदौ मध्ये तथाऽन्ते च यथा तत्त्वेन तत्त्ववित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2085218, "chapter_id": 2813, "verse_number": "१२-३१८-१५", "content_sanskrit": "प्रकृतिर्गुणान्विकुरुते स्वच्छन्देनात्मकाम्यया।\nक्रीडार्थे तु महाराज शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2085219, "chapter_id": 2813, "verse_number": "१२-३१८-१६", "content_sanskrit": "यथा दीपसहस्राणि दीपान्मर्त्याः प्रकुर्वते।\nप्रकृतिस्तथा विकुरुते पुरुषस्य गुणान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2085220, "chapter_id": 2813, "verse_number": "१२-३१८-१७", "content_sanskrit": "सत्वमानन्द उद्रेकः प्रीतिः प्राकाम्यमेव च।\nसुखं शुद्धत्वमारोग्यं संतोषः श्रद्दधानता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2085221, "chapter_id": 2813, "verse_number": "१२-३१८-१८", "content_sanskrit": "अकार्पण्यमसंरम्भः क्षमा धृतिरहिंसता।\nसमता सत्यमानृण्यमार्जवं ह्रीरचापलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2085222, "chapter_id": 2813, "verse_number": "१२-३१८-१९", "content_sanskrit": "शौचमार्दवमाचारमलौल्यं हृद्यसंभ्रमः।\nइष्टानिष्टवियोगानां कृतानामविकत्थना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2085223, "chapter_id": 2813, "verse_number": "१२-३१८-२०", "content_sanskrit": "दानेन चात्मग्रहणमस्पृहत्वं परार्थता।\nसर्वभूतदया चैव सत्वस्यैते गुणाः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2085224, "chapter_id": 2813, "verse_number": "१२-३१८-२१", "content_sanskrit": "रजोगुणानां संघातो रूपमैश्वर्यविग्रहौ।\nअत्यागित्वमकारुण्यं सुखदुःखोपसेवनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2085225, "chapter_id": 2813, "verse_number": "१२-३१८-२२", "content_sanskrit": "परापवादेषु रतिर्विवादानां च सेवनम्।\nअहंकारस्त्वसत्कारश्चिन्ता वैरोपसेवनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2085226, "chapter_id": 2813, "verse_number": "१२-३१८-२३", "content_sanskrit": "परितापोऽभिहरणं ह्रीनाशोऽनार्जवं तथा।\nभेदः परुषता चैव कामक्रोधो मदस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2085227, "chapter_id": 2813, "verse_number": "१२-३१८-२४", "content_sanskrit": "दर्पो द्वेषोऽतिमानश्च एते प्रोक्ता रजोगुणाः।\nतामसानां तुं संघातान्प्रवक्ष्याम्युपधार्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2085228, "chapter_id": 2813, "verse_number": "१२-३१८-२५", "content_sanskrit": "मोहोऽप्रकाशस्तामिस्रमन्धतामिस्रसंज्ञितम्।\nमरणं चान्धतामिस्रं तामिस्रं क्रोध उज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2085229, "chapter_id": 2813, "verse_number": "१२-३१८-२६", "content_sanskrit": "तमसो लक्षणानीह भक्षणाद्यभिरोचनम्।\nभोजनानामपर्याप्तिस्तथा पेयेष्वतृप्तता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2085230, "chapter_id": 2813, "verse_number": "१२-३१८-२७", "content_sanskrit": "गन्धवासो विहारेषु शयनेष्वासनेषु च।\nदिवास्वप्ने विवादे च प्रमादेषु च वै रतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2085231, "chapter_id": 2813, "verse_number": "१२-३१८-२८", "content_sanskrit": "नृत्यवादित्रगीतानामज्ञानाच्छ्रद्दधानता।\nद्वेषो धर्मविशेषाणामेते वै तामसा गुणाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2085232, "chapter_id": 2813, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि अष्टादशाधिकत्रिशततमोऽध्यायः॥ ३१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]