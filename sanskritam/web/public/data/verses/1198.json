[{"id": 2009957, "chapter_id": 1198, "verse_number": "१-१९९-०x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2009958, "chapter_id": 1198, "verse_number": "१-१९९-१", "content_sanskrit": "अस्माकमनुरूपो वै यः स्याद्गन्धर्व वेदवित्।\nपुरोहितस्तमाचक्ष्व सर्वं हि विदितं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2009959, "chapter_id": 1198, "verse_number": "१-१९९-२x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2009960, "chapter_id": 1198, "verse_number": "१-१९९-२", "content_sanskrit": "यवीयान्देवलस्यैष वने भ्राता तपस्यति।\nधौम्य उत्कोचके तीर्थे तं वृणुध्वं यीच्छथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2009961, "chapter_id": 1198, "verse_number": "१-१९९-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2009962, "chapter_id": 1198, "verse_number": "१-१९९-३", "content_sanskrit": "ततोऽर्जुनोऽस्त्रमाग्नेयं प्रददौ तद्यथाविधि।\nगन्धर्वाय स च प्रीतो वचनं चेदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2009963, "chapter_id": 1198, "verse_number": "१-१९९-४", "content_sanskrit": "मयि सन्ति हयश्रेष्ठास्तव दास्यामि वै सखे।\nउपकारकृतं मित्रं प्रतिकारेण योजये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2009964, "chapter_id": 1198, "verse_number": "१-१९९-५", "content_sanskrit": "गृह्णीष्व चाक्षुषीं विद्यामिमां भरतसत्तम।\nएवमुक्तोऽर्जुनः प्रीतो वचनं चेदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2009965, "chapter_id": 1198, "verse_number": "१-१९९-६", "content_sanskrit": "त्वय्येव तावत्तिष्ठन्तु हया गन्धर्वसत्तम।\nकार्यकाले ग्रहीष्यामः स्वस्ति तेऽस्त्विति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2009966, "chapter_id": 1198, "verse_number": "१-१९९-७", "content_sanskrit": "तेऽन्योन्यमभिसंपूज्य गन्धर्वः पाण्डवाश्च ह।\nरम्याद्भागीरथीतीराद्यथाकामं प्रतस्थिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2009967, "chapter_id": 1198, "verse_number": "१-१९९-८", "content_sanskrit": "तत उत्कोचकं तीर्थं गत्वा धौम्याश्रमं तु ते।\nतं वव्रुः पाण्डवा धौम्यं पौरोहित्याय भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2009968, "chapter_id": 1198, "verse_number": "१-१९९-९", "content_sanskrit": "तान्धौम्यः प्रतिजग्राह सर्ववेदविदां वरः।\nवन्येन फलमूलेन पौरोहित्येन चैव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2009969, "chapter_id": 1198, "verse_number": "१-१९९-१०", "content_sanskrit": "ते समाशंसिरे लब्धां श्रियं राज्यं च पाण्डवाः।\nब्राह्मणं तं पुरस्कृत्य पाञ्चालीं च स्वयंवरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2009970, "chapter_id": 1198, "verse_number": "१-१९९-११", "content_sanskrit": "पुरोहितेन तेनाथ गुरुणा संगतास्तदा।\nनाथवन्तमिवात्मानं मेनिरे भरतर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2009971, "chapter_id": 1198, "verse_number": "१-१९९-१२", "content_sanskrit": "स हि वेदार्थतत्त्वज्ञस्तेषां गुरुरुदारधीः।\nवेदविच्चैव वाग्मी च धौम्यः श्रीमान्द्विजोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2009972, "chapter_id": 1198, "verse_number": "१-१९९-१३", "content_sanskrit": "तेजसा चैव बुद्ध्या च रूपेण यशसा श्रिया।\nमन्त्रैश्च विविधैर्धौम्यस्तुल्य आसीद्बृहस्पतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2009973, "chapter_id": 1198, "verse_number": "१-१९९-१४", "content_sanskrit": "स चापि विप्रस्तान्मेने स्वभावाभ्यधिकान्भुवि।\nतेन धर्मविदा पार्था योज्या सर्वविदा वृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2009974, "chapter_id": 1198, "verse_number": "१-१९९-१५", "content_sanskrit": "मेनिरे सहिता वीराः प्राप्तं राज्यं च पाण्डवाः।\nबुद्धिवीर्यबलोत्साहैर्युक्ता देवा इवापरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2009975, "chapter_id": 1198, "verse_number": "१-१९९-१६", "content_sanskrit": "कृतस्वस्त्ययनास्तेन ततस्ते मनुजाधिपाः।\nमेनिरे सहिता गन्तुं पाञ्चाल्यास्तं स्वयंवरम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2009976, "chapter_id": 1198, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि चैत्ररथपर्वणि एकोनद्विशततमोऽध्यायः॥ १९९ ॥ ॥ समाप्तं चैत्ररथपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]