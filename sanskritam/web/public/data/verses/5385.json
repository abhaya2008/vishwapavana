[{"id": 2205833, "chapter_id": 5385, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2205834, "chapter_id": 5385, "verse_number": "१", "content_sanskrit": "ब्राह्मणाः क्षत्रियाश्चैव जायन्ते केन कर्मणा ।\nकिं कर्म सुकृतं कृत्वा नारी प्राप्नोति पार्वति\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2205835, "chapter_id": 5385, "verse_number": "२", "content_sanskrit": "राजानं राजमात्रं वा कोशी धनपतिं पतिम् ।\nएतदिच्छामि विज्ञातुं यथा त्वं प्रब्रवीहि मे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2205836, "chapter_id": 5385, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2205837, "chapter_id": 5385, "verse_number": "३", "content_sanskrit": "यदि भर्ता प्रवसति कुटुम्बार्थेन केनचित् ।\nव्यपेतमण्डनस्नाना क्षुधार्ता च विनिर्भया\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2205838, "chapter_id": 5385, "verse_number": "४", "content_sanskrit": "स्वपतिं पतितं दीनं विकलं व्याधिपीडितम् ।\nनिर्गुणं निर्धनं वृद्धमनाथं मद्यपं तथा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2205839, "chapter_id": 5385, "verse_number": "५", "content_sanskrit": "न जहाति रता धर्मे प्रिया प्रियतरा सदा ।\nशुश्रूषमाणा पत्यौ तु करोत्यविमना भृशम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2205840, "chapter_id": 5385, "verse_number": "६", "content_sanskrit": "तैस्तैर्या तु परिक्लेशैर्भर्तारं परितोषयेत् ।\nपतिव्रता पतिमुखी पत्यावेकमना भवेत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2205841, "chapter_id": 5385, "verse_number": "७", "content_sanskrit": "भक्ष्यन्नपानभोज्यानि कन्दमूलफलं तथा ।\nभर्तुरुच्छेषमश्नाति स्वयं पूर्वं न खादति\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2205842, "chapter_id": 5385, "verse_number": "८", "content_sanskrit": "एवं शीलसमाचारा पापेभ्यः परिमुच्यते ।\nप्राप्य लोकान् शुभान् दिव्यान् दैवतैः सह मोदते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2205843, "chapter_id": 5385, "verse_number": "९", "content_sanskrit": "सुकृतेनैव सा नारी जायते चन्द्रनिर्मला ।\nयदि चेन्मानुषे लोके कदाचिदुपजायते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2205844, "chapter_id": 5385, "verse_number": "१०", "content_sanskrit": "ब्राह्मणानां कुले जन्म दिव्यं तस्या विधीयते ।\nश्रेष्ठानां क्षत्रियाणां वा कुलवंशे प्रजायते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2205845, "chapter_id": 5385, "verse_number": "११", "content_sanskrit": "सुवर्णमणिमुक्ताश्च वस्त्राण्याभरणानि च ।\nदासीदासं धनं धान्यं भर्तारं च वशानुगम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2205846, "chapter_id": 5385, "verse_number": "१२", "content_sanskrit": "भक्ष्यभोज्यन्नपानाश्च सोपभुङ्क्ते निजेच्छया ।\nमानुषेष्वेव भोगेषु समस्तासु क्रियासु च\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2205847, "chapter_id": 5385, "verse_number": "१३", "content_sanskrit": "भर्तुर्हि यजमानस्य यज्ञपत्नी भवेद् ध्रुवम् ।\nज्ञातिभ्यो हि धनं लब्ध्वा सर्वं भर्तुः प्रयच्छति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2205848, "chapter_id": 5385, "verse_number": "१४", "content_sanskrit": "पुत्रवक्त्रमिवाभीक्ष्णं भर्तुर्वदनमीक्षते ।\nतद्भावगतसङ्कल्पा पतिशुश्रूषणे रता\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2205849, "chapter_id": 5385, "verse_number": "१५", "content_sanskrit": "भर्तुर्वचोऽनुमन्येत कुर्वन्ती प्रियवादिनी ।\nभर्तुर्न प्रतिकूला च पतिधर्मेण युज्यते ।\nएतत्पतिव्रतासूक्तं व्रतं देव समासतः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2205850, "chapter_id": 5385, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे पातिव्रत्यधर्मकथनं नाम षट्त्रिंशोत्तरद्विशततमोऽध्यायः ॥२३६॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]