[{"id": 7000505000, "chapter_id": 20505, "verse_number": "३-५२-१", "content_sanskrit": "व्यास उवाच ।\nभुक्त्वा पीत्वा च सुप्त्वा च स्नात्वा रथ्योपसर्पणे ।\nओष्ठावलोमकौ स्पृष्ट्वा वासो विपरिधाय च॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000505001, "chapter_id": 20505, "verse_number": "३-५२-२", "content_sanskrit": "रेतोमूत्रपुरीषाणामुत्सर्गेऽनृतभाषणे ।\nष्ठीवित्वाऽध्ययनारंभे कासश्वासागमे तथा॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000505002, "chapter_id": 20505, "verse_number": "३-५२-३", "content_sanskrit": "चत्वरं वा श्मशानं वा समाक्रम्य द्विजोत्तमः ।\nसंध्ययोरुभयोस्तद्वदाचांतोऽप्याचमेत्पुनः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000505003, "chapter_id": 20505, "verse_number": "३-५२-४", "content_sanskrit": "चंडालम्लेच्छसंभाषे स्त्रीशूद्रोच्छिष्टभाषणे ।\nउच्छिष्टं पुरुषं दृष्ट्वा भोज्यं चापि तथाविधम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000505004, "chapter_id": 20505, "verse_number": "३-५२-५", "content_sanskrit": "आचामेदश्रुपाते वा लोहितस्य तथैव च ।\nभोजने संध्ययोः स्नात्वा पीत्वा मूत्रपुरीषयोः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000505005, "chapter_id": 20505, "verse_number": "३-५२-६", "content_sanskrit": "आगतो वाचमेत्सुप्त्वा सकृत्सकृदथान्यतः ।\nअग्नेर्गवामथालंभे स्पृष्ट्वा प्रयतमेव वा॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000505006, "chapter_id": 20505, "verse_number": "३-५२-७", "content_sanskrit": "स्त्रीणामथात्मनः स्पर्शे नीलद्यं वा परिधाय च ।\nउपस्पर्शेज्जलं वार्तं तृणं वा भूमिमेव च॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000505007, "chapter_id": 20505, "verse_number": "३-५२-८", "content_sanskrit": "केशानां चात्मनः स्पर्शे वाससः स्खलितस्य च ।\nअनुष्णाभिरकेशाभिरदुष्टाभिश्च धर्मतः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000505008, "chapter_id": 20505, "verse_number": "३-५२-९", "content_sanskrit": "शौचेऽप्सु सर्वदा चामेदासीनः प्रागुदङ्मुखः ।\nशिरः प्रावृत्य कंठं वा मुक्तकेशशिखोऽपि वा॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000505009, "chapter_id": 20505, "verse_number": "३-५२-१०", "content_sanskrit": "अकृत्वा पादयोः शौचं मार्गतो न शुचिर्भवेत् ।\nसोपानत्कोपानस्थो वा नोष्णीषी चाचमेद्बुधः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000505010, "chapter_id": 20505, "verse_number": "३-५२-११", "content_sanskrit": "न चैव वर्षधाराभिर्न तिष्ठन्नुद्धृतोदकैः ।\nनैकहस्तार्पितजलैर्विना सूत्रेण वा पुनः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000505011, "chapter_id": 20505, "verse_number": "३-५२-१२", "content_sanskrit": "न पादुकासनस्थो वा बहिर्जानुरथापि वा ।\nन जल्पन्न हसन्प्रेक्षन्शयानस्तल्प एव च॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000505012, "chapter_id": 20505, "verse_number": "३-५२-१३", "content_sanskrit": "नाविक्षिताभिः फेनाद्यैरुपेताभिरथापि वा ।\nशूद्राशुचिकरोन्मुक्तैर्नक्षाराभिस्तथैव च॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000505013, "chapter_id": 20505, "verse_number": "३-५२-१४", "content_sanskrit": "न चैवांगुलिभिः शब्दं न कुर्यान्नान्यमानसः ।\nन वर्णरसदुष्टाभिर्न चैव प्रदरोदकैः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000505014, "chapter_id": 20505, "verse_number": "३-५२-१५", "content_sanskrit": "न पाणिक्षुभिताभिर्वा न बहिर्गंध एव वा ।\nहृद्गाभिः पूयते विप्रः कंठ्याभिः क्षत्रियः शुचिः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000505015, "chapter_id": 20505, "verse_number": "३-५२-१६", "content_sanskrit": "प्राशिताभिस्तथा वैश्यः स्त्रीशूद्रौ स्पर्शतोंऽततः ।\nअंगुष्ठमूलांतरतो रेखायां ब्राह्ममुच्यते॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000505016, "chapter_id": 20505, "verse_number": "३-५२-१७", "content_sanskrit": "अंतरांगुष्ठदेशिन्यैः पितॄणां तीर्थमुच्यते ।\nकनिष्ठामूलतः पश्चात्प्राजापत्यं प्रचक्षते॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000505017, "chapter_id": 20505, "verse_number": "३-५२-१८", "content_sanskrit": "अंगुल्यग्रं स्मृतं दैवं तदेवार्षं प्रकीर्तितम् ।\nमूलेन दैवमार्षं स्यादाग्नेयं मध्यतः स्मृतम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000505018, "chapter_id": 20505, "verse_number": "३-५२-१९", "content_sanskrit": "तदेव सौमिकं तीर्थमेतज्ज्ञात्वा न मुह्यति ।\nब्राह्मेणैव तु तीर्थेन द्विजो नित्यमुपस्पृशेत्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000505019, "chapter_id": 20505, "verse_number": "३-५२-२०", "content_sanskrit": "होमयेद्वाथ दैवेन न तु पित्र्येण वै द्विजाः ।\nत्रिःप्राश्नीयादपः पूर्वं ब्राह्मेण प्रयतस्ततः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000505020, "chapter_id": 20505, "verse_number": "३-५२-२१", "content_sanskrit": "संमृज्यांगुष्ठमूलेन मुखं वै समुपस्पृशेत् ।\nअंगुष्ठानामिकाभ्यां तु स्पृशेन्नेत्रद्वयं ततः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000505021, "chapter_id": 20505, "verse_number": "३-५२-२२", "content_sanskrit": "तर्जन्यंगुष्ठयोगेन स्पृशेन्नासापुटद्वयम् ।\nकनिष्ठांगुष्ठयोगेन श्रवणे समुस्पृशेत्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000505022, "chapter_id": 20505, "verse_number": "३-५२-२३", "content_sanskrit": "सर्वासामथयोगेन हृदयं तु तनवा ।\nस्पृशेद्वै शिरसस्तद्वदंगुष्ठेनांसकद्वयम्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000505023, "chapter_id": 20505, "verse_number": "३-५२-२४", "content_sanskrit": "त्रिःप्राश्नीयाद्यदंभस्तु प्रीतास्तेनास्य देवताः ।\nब्रह्माविष्णुर्महेशश्च भवंतीत्यनुशुश्रुम॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000505024, "chapter_id": 20505, "verse_number": "३-५२-२५", "content_sanskrit": "गंगा च यमुना चैव प्रीयेते परिमार्जनात् ।\nसंस्पृष्टयोर्लोचनयोः प्रीयेते शशिभास्करौ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000505025, "chapter_id": 20505, "verse_number": "३-५२-२६", "content_sanskrit": "नासत्यदस्रौ प्रीयेते स्पृशेन्नासापुटद्वयम् ।\nकर्णयोः स्पृष्टयोस्तद्वत्प्रीयेते चानिलानलौ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000505026, "chapter_id": 20505, "verse_number": "३-५२-२७", "content_sanskrit": "संस्पृष्टे हृदये चास्य प्रीयंते सर्वदेवताः ।\nमूर्ध्नि संस्पर्शनादेकः प्रीतः स पुरुषो भवेत्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000505027, "chapter_id": 20505, "verse_number": "३-५२-२८", "content_sanskrit": "नोच्छिष्टं कुर्वते वक्त्रे विप्रुषोंगे लगंति याः ।\nदंतवद्दंतलग्नेषु जिह्वास्पर्शे शुचिर्भवेत्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000505028, "chapter_id": 20505, "verse_number": "३-५२-२९", "content_sanskrit": "स्पृशंति बिंदवः पादौ य आचामयतः परान् ।\nभूमिपांशुसमा ज्ञेया न तैरस्पृश्यता भवेत्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000505029, "chapter_id": 20505, "verse_number": "३-५२-३०", "content_sanskrit": "मधुपर्के च सोमे च तांबूलस्य च भक्षणे ।\nफलमूले चेक्षुदंडेन दोषं प्राह वै मनुः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000505030, "chapter_id": 20505, "verse_number": "३-५२-३१", "content_sanskrit": "प्रचरंश्चान्नपानेषु द्रव्यहस्तो भवेन्नरः ।\nभूमौ निक्षिप्य तद्द्रव्यमाचम्याभ्युक्षयेत्तु तत्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000505031, "chapter_id": 20505, "verse_number": "३-५२-३२", "content_sanskrit": "तैजसं वै समादाय यद्युच्छिष्टो भवेद्द्विजः ।\nभूमौ निक्षिप्य तद्द्रव्यमाचम्याभ्युक्षयेत्तु तत्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000505032, "chapter_id": 20505, "verse_number": "३-५२-३३", "content_sanskrit": "यद्यद्द्रव्यं समादाय भवेदुच्छेषणान्वितः ।\nअनिधायैव तद्द्रव्यं भूमौ त्वशुचितामियात्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000505033, "chapter_id": 20505, "verse_number": "३-५२-३४", "content_sanskrit": "वस्त्रादिषु विकल्पः स्यात्तत्संस्पृश्याचमेदिह ।\nअरण्ये निर्जने रात्रौ चौरव्याघ्राकुले पथि॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000505034, "chapter_id": 20505, "verse_number": "३-५२-३५", "content_sanskrit": "कृत्वा मूत्रं पुरीषं वा द्रव्यहस्तो न दुष्यति ।\nनिधाय दक्षिणे कर्णे ब्रह्मसूत्रमुदङ्मुखः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000505035, "chapter_id": 20505, "verse_number": "३-५२-३६", "content_sanskrit": "अह्नि कुर्याच्छकृन्मूत्रं रात्रौ चेद्दक्षिणामुखः ।\nअंतर्धाय महीं काष्टैः पत्रैर्लोष्टतृणेन वा॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000505036, "chapter_id": 20505, "verse_number": "३-५२-३७", "content_sanskrit": "प्रावृत्य च शिरः कुर्याद्विण्मूत्रस्य विसर्जनम् ।\nछायाकूपनदीगोष्ठचैत्यांभः पथि भस्मसु॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000505037, "chapter_id": 20505, "verse_number": "३-५२-३८", "content_sanskrit": "अग्नौ चैव श्मशाने च विण्मूत्रं न समाचरेत् ।\nन गोमयेन काष्ठे वा महावृक्षेऽथ शाद्वले॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000505038, "chapter_id": 20505, "verse_number": "३-५२-३९", "content_sanskrit": "न तिष्ठन्न च निर्वासा न च पर्वतमंडले ।\nन जीर्णदेवायतने वल्मीके न कदाचन॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000505039, "chapter_id": 20505, "verse_number": "३-५२-४०", "content_sanskrit": "न ससत्वेषु गर्तेषु न गच्छन्न समाचरेत् ।\nतुषांगारकपालेषु राजमार्गे तथैव च॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000505040, "chapter_id": 20505, "verse_number": "३-५२-४१", "content_sanskrit": "न क्षेत्रे न बिले वापि न तीर्थे न चतुष्पथे ।\nनोद्यानेऽपासमीपे वा नोषरे नगराशये॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000505041, "chapter_id": 20505, "verse_number": "३-५२-४२", "content_sanskrit": "न सोपानत्पादुको वा छत्री वा नांतरिक्षके ।\nन चैवाभिमुखः स्त्रीणां गुरुब्राह्मणयोर्गवाम्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000505042, "chapter_id": 20505, "verse_number": "३-५२-४३", "content_sanskrit": "न देवदेवालययोरपामपि कदाचन ।\nन ज्योतींषि निरीक्षन्वानवाप्रतिमुखोथ वा॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000505043, "chapter_id": 20505, "verse_number": "३-५२-४४", "content_sanskrit": "प्रत्यादित्यं प्रत्यनलं प्रतिसोमं तथैव च ।\nआहृत्य मृत्तिकां कूलाल्लेपगंधापकर्षणीम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000505044, "chapter_id": 20505, "verse_number": "३-५२-४५", "content_sanskrit": "कुर्यादतंद्रितः शौचं विशुद्धैरुद्धृतोदकैः ।\nनाहरेन्मृतिकां विप्रः पांशुलां न सकर्दमाम्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000505045, "chapter_id": 20505, "verse_number": "३-५२-४६", "content_sanskrit": "न मार्गान्नोषराद्देशाच्छौचशिष्टां परस्य च ।\nन देवायतनात्कूपाद्धाम्नो न च जलात्तथा॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000505046, "chapter_id": 20505, "verse_number": "३-५२-४७", "content_sanskrit": "उपस्पृशेत्ततो नित्यं पूर्वोक्तेन विधानतः॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]