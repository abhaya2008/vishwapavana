[{"id": 2018293, "chapter_id": 1380, "verse_number": "३-१८-०x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2018294, "chapter_id": 1380, "verse_number": "३-१८-१", "content_sanskrit": "साल्वबाणार्दिते तस्मिन्प्रद्युम्ने बलिनांवरे।\nवृष्णयो भग्नसंकल्पा विव्यथुः पृतनामुखे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2018295, "chapter_id": 1380, "verse_number": "३-१८-२", "content_sanskrit": "हाहाकृतमभूत्सर्वं वृष्ण्यन्धकबलं ततः।\nप्रद्युम्ने मोहिते राजन्साल्वः प्रमुदितोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2018296, "chapter_id": 1380, "verse_number": "३-१८-३", "content_sanskrit": "तं तथा मोहितं दृष्ट्वा सारथिर्जवनैर्हयैः।\nरणादपाहरत्तूर्णं शिक्षितो दारुकिस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2018297, "chapter_id": 1380, "verse_number": "३-१८-४", "content_sanskrit": "नातिदूरापयाते तु रथे रथवरप्रणुत्।\nधनुर्गृहीत्वा यन्तारं लब्धसज्ञोऽब्रवीदिदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2018298, "chapter_id": 1380, "verse_number": "३-१८-५", "content_sanskrit": "सौते किं ते व्यवसितं कस्माद्यासि पराङ्मुखः।\nनैष वृष्णिप्रवीराणामाहवे धर्म उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2018299, "chapter_id": 1380, "verse_number": "३-१८-६", "content_sanskrit": "कच्चित्सौते न ते मोहः साल्वं दृष्ट्वा महाहवे।\nविषादो वा रणँ दृष्ट्वा ब्रूहि मे त्वं यथातथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2018300, "chapter_id": 1380, "verse_number": "३-१८-७x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2018301, "chapter_id": 1380, "verse_number": "३-१८-७", "content_sanskrit": "जानार्दने न मे मोहो नापि मां भयमाविशत्।\nअतिभारं तु ते मन्ये साल्वं केशवनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2018302, "chapter_id": 1380, "verse_number": "३-१८-८", "content_sanskrit": "सोभियाति शनैर्वीर बलवानेष पापकृत्।\nमोहितश्च रणे शूरो रक्ष्यः सारथिना रथी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2018303, "chapter_id": 1380, "verse_number": "३-१८-९", "content_sanskrit": "आयुष्मंस्त्वं मया नित्यं रक्षितव्यस्त्वयाऽप्यहम्।\nरक्षितव्यो रणे नित्यमिति कृत्वाऽपयाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2018304, "chapter_id": 1380, "verse_number": "३-१८-१०", "content_sanskrit": "एकश्चासि महाबाहो बहवश्चापि दानवाः।\nन समं रौक्मिणेयाहं रणए मत्वाऽपयामि वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2018305, "chapter_id": 1380, "verse_number": "३-१८-११x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2018306, "chapter_id": 1380, "verse_number": "३-१८-११", "content_sanskrit": "एवं ब्रुवति सूते तु तदा मकरकेतुमान्।\nउवाच सूतं कौरव्य संनिवर्त्य रथं पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2018307, "chapter_id": 1380, "verse_number": "३-१८-१२", "content_sanskrit": "दारुकात्मज मैवं त्वं पुनः कार्षीः कथंचन।\nन्यपयानं रणात्सौते जीवतो मम कर्हिचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2018308, "chapter_id": 1380, "verse_number": "३-१८-१३", "content_sanskrit": "न स वृष्णिकुले जातो यो वै त्यजति संगरम्।\nयो वा निपतितं हन्ति तवास्मीति च वादिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2018309, "chapter_id": 1380, "verse_number": "३-१८-१४", "content_sanskrit": "तथा स्त्रियं च यो हन्ति बालं वृद्धं तथैव च।\nविरथं मुक्तकेशं च भग्नशस्त्रायुधं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2018310, "chapter_id": 1380, "verse_number": "३-१८-१५", "content_sanskrit": "त्वं च सूतकुले जातो विदितः सूतकर्मणि।\nधर्मज्ञश्चासि वृष्णीनामाहवेष्वपि दारुके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2018311, "chapter_id": 1380, "verse_number": "३-१८-१६", "content_sanskrit": "स जानंश्चरितं कृत्स्नं वृष्णीनां पृतनामुखे।\nअपयानं पुन सौते मैवं कार्षीः कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2018312, "chapter_id": 1380, "verse_number": "३-१८-१७", "content_sanskrit": "अपयातं हतं पृष्ठे भ्रान्तं रणपलायितम्।\nगदाग्रजो दुराधर्षः किं मां वक्ष्यति माधवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2018313, "chapter_id": 1380, "verse_number": "३-१८-१८", "content_sanskrit": "केशवस्याग्रजो वाऽपि नीलवासा मदोत्कटः।\nकिं वक्ष्यति महाबाहुर्बलदेवः समागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2018314, "chapter_id": 1380, "verse_number": "३-१८-१९", "content_sanskrit": "किं वक्ष्यतिशिनेर्नप्ता रणसिंहो महारथः।\nअपयातं रणात्सूत साम्बश्च समितिंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2018315, "chapter_id": 1380, "verse_number": "३-१८-२०", "content_sanskrit": "चारुदेष्णश्च दुर्धर्षस्तथैव गदसारणौ।\nअक्रूरश्च महाबाहुः किं मां वक्ष्यति सारथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2018316, "chapter_id": 1380, "verse_number": "३-१८-२१", "content_sanskrit": "शूरं संभावितं शान्तं नित्यं पुरुषमानिनम्।\nस्त्रियश्च वृष्णिवीराणां किं मांवक्ष्यन्ति संगताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2018317, "chapter_id": 1380, "verse_number": "३-१८-२२", "content_sanskrit": "प्रद्युम्नोऽयमुपायाति भीतस्त्यक्त्वा महाहवम्।\nधिगेनमिति वक्ष्यन्ति न तु वक्ष्यन्ति साध्विति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2018318, "chapter_id": 1380, "verse_number": "३-१८-२३", "content_sanskrit": "धिग्वाचा परिहासोपि मम वा मद्विधस्य वा।\nमृत्युनाऽभ्यधिकः सौते स त्वं माव्यपयाः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2018319, "chapter_id": 1380, "verse_number": "३-१८-२४", "content_sanskrit": "भारं हि मयि संन्यस्य यातो मधुनिहा हरिः।\nयज्ञं बारतसिंहस्य न हि शक्योऽद्यमर्षितुम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2018320, "chapter_id": 1380, "verse_number": "३-१८-२५", "content_sanskrit": "कृतवर्मा मया वीरो निर्यास्यन्नेव वारितः।\nसाल्वं निवारयिष्येऽहं तिष्ठ त्वमिति सूतज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2018321, "chapter_id": 1380, "verse_number": "३-१८-२६", "content_sanskrit": "स च संभावयन्मां वै निवृत्तो हृदिकात्मजः।\nतं समेत्य रणं त्यक्त्वा किं वक्ष्यामि महारथं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2018322, "chapter_id": 1380, "verse_number": "३-१८-२७", "content_sanskrit": "उपयान्तं दुराधर्षं शङ्खचक्रगदाधरम्।\nपुरुषं पुण्डरीकाक्षं किं वक्ष्यामि महाभुजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2018323, "chapter_id": 1380, "verse_number": "३-१८-२८", "content_sanskrit": "सात्यकिं बलदेवं च ये चान्येऽन्धकवृष्णयः।\nमया स्पर्धन्ति सततं किं नु वक्ष्यामि तानहं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2018324, "chapter_id": 1380, "verse_number": "३-१८-२९", "content_sanskrit": "त्यक्त्वा रणमिमं सौते पृष्ठतोऽभ्याहतः शरैः।\nत्वयाऽपनीती विवशो न जीवेयं कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2018325, "chapter_id": 1380, "verse_number": "३-१८-३०", "content_sanskrit": "संनिवर्त रथेनाशु पुनर्दारुकनन्दन।\nन चैतदेवं कर्तव्यमथापत्सु कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2018326, "chapter_id": 1380, "verse_number": "३-१८-३१", "content_sanskrit": "न जीवितमहं सौते बहु मन्ये कथंचन।\nअपयातो रणाद्भीतः पृष्ठतोऽभ्याहतः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2018327, "chapter_id": 1380, "verse_number": "३-१८-३२", "content_sanskrit": "कदाऽपि सूतपुत्र त्वं जानीषे मां भयार्दितम्।\nअपयातं रणं हित्वा यथा कापुरुषं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2018328, "chapter_id": 1380, "verse_number": "३-१८-३३", "content_sanskrit": "अयुक्तं तु मया त्यक्तुं संग्रामं दारुकात्मज।\nमयि युद्धार्थिनि भृशं स त्वं याहि यतो रणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2018329, "chapter_id": 1380, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्णणि अर्जुनाभिगमनपर्वणि अष्टादशोऽध्यायः ॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]