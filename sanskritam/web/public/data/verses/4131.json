[{"id": 2145403, "chapter_id": 4131, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2145404, "chapter_id": 4131, "verse_number": "१", "content_sanskrit": "सञ्जयस्य वचः श्रुत्वा प्रज्ञाचक्षुर्जनेश्वरः ।\nततः सङ्ख्यातुमारेभे तद्वचो गुणदोषतः\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2145405, "chapter_id": 4131, "verse_number": "२", "content_sanskrit": "प्रसङ्ख्याय च सौक्ष्म्येण गुणदोषान् विचक्षणः ।\nयथावन्मति तत्वेन जयकामः सुतान् प्रति\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2145406, "chapter_id": 4131, "verse_number": "३", "content_sanskrit": "बलाबले विनिश्चित्य याथातथ्येन बुद्धिमान् ।\nयदा तु मेने भूयिष्ठं तद्वचो गुणदोषतः\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2145407, "chapter_id": 4131, "verse_number": "४", "content_sanskrit": "देवमानुषयोः शक्त्या तेजसा चैव पाण्डवान् ।\nकुरून् शक्त्याऽल्पतरया दुर्योधनमथाब्रवीत्\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2145408, "chapter_id": 4131, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2145409, "chapter_id": 4131, "verse_number": "५", "content_sanskrit": "दुर्योधनेयं चिन्ता मे शश्वन्न ह्युपशाम्यति\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2145410, "chapter_id": 4131, "verse_number": "६", "content_sanskrit": "ईदृशेऽभिनिविष्टस्य पृथिवीक्षयकारके ।\nअधर्म्ये वाऽयशस्ये वा कार्ये महति दारुणे\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2145411, "chapter_id": 4131, "verse_number": "७", "content_sanskrit": "पाण्डवैर्विग्रहस्तात सर्वथा मे न रोचते\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2145412, "chapter_id": 4131, "verse_number": "८", "content_sanskrit": "सत्यं ह्येतदहं मन्ये प्रत्यक्षं नानुमानतः ।\nआत्मजैस्तु परं स्नेहं सर्वभूतानि कुर्वते\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2145413, "chapter_id": 4131, "verse_number": "९", "content_sanskrit": "प्रियाणि चैषां कुर्वन्ति यथाशक्ति हितानि च ।\nएवमेवोपकर्तॄणां प्रायशो लक्षयामहे\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2145414, "chapter_id": 4131, "verse_number": "१०", "content_sanskrit": "इच्छन्ति बहुलं सन्तः प्रतिकर्तुं महत् प्रियम्\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2145415, "chapter_id": 4131, "verse_number": "११", "content_sanskrit": "अग्निः साचिव्यकर्ता स्यात् खाण्डवे तत्कृतं स्मरन् ।\nअर्जुनस्यापि भीमेऽस्मिन् कुरुपाण्डुसमागमे\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2145416, "chapter_id": 4131, "verse_number": "१२", "content_sanskrit": "जातिगृद्ध्याऽभिपन्नाश्च पाण्डवानामनेकशः ।\nधर्मादयः समेष्यन्ति समाहूता दिवौकसः\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2145417, "chapter_id": 4131, "verse_number": "१३", "content_sanskrit": "भीष्मद्रोणकृपादीनां भयादशनिसन्निभम् ।\nरिरक्षिषन्तः संरम्भं गमिष्यन्तीति मे मतिः\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2145418, "chapter_id": 4131, "verse_number": "१४", "content_sanskrit": "तद् देवसहिताः पार्था न शक्याः प्रतिवीक्षितुम् ।\nमानुषेण नरव्याघ्रा वीर्यवन्तोऽस्त्रपारगाः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2145419, "chapter_id": 4131, "verse_number": "१५", "content_sanskrit": "दुरासदं यस्य दिव्यं गाण्डीवं धनुरुत्तमम् ।\nवारुणौ चाक्षयौ दिव्यौ शरपूर्णौ महेषुधी\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2145420, "chapter_id": 4131, "verse_number": "१६", "content_sanskrit": "वानरश्च ध्वजे दिव्यो निःसङ्गो धूमवद् गतिः ।\nरथस्य चतुरन्तायां यस्य नास्ति समस्त्विषा\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2145421, "chapter_id": 4131, "verse_number": "१७", "content_sanskrit": "महामेघनिभश्चापि निर्घोषः श्रूयते जनैः ।\nमहाशनिसमः शब्दः शात्रवाणां भयङ्करः\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2145422, "chapter_id": 4131, "verse_number": "१८", "content_sanskrit": "यं चातिमानुषं वीर्ये कृत्स्नो लोको व्यवस्यति ।\nदेवानामपि जेतारं यं विदुः पार्थिवा रणे\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2145423, "chapter_id": 4131, "verse_number": "१९", "content_sanskrit": "शतानि पञ्च चैवेषून् यो गृह्णन्नेव दृश्यते ।\nनिमेषान्तरमात्रेण मुञ्चन् दूरं च पातयन्\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2145424, "chapter_id": 4131, "verse_number": "२०", "content_sanskrit": "यमाह भीष्मो द्रोणश्च कृपो द्रौणिस्तथैव च ।\nमद्रराजस्तथा शल्यो मध्यस्था ये च मानवाः\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2145425, "chapter_id": 4131, "verse_number": "२१", "content_sanskrit": "युद्धायावस्थितं पार्थं पार्थिवैरतिमानुषैः ।\nअशक्यं रथशार्दूलं पराजेतुमरिन्दमम्\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2145426, "chapter_id": 4131, "verse_number": "२२", "content_sanskrit": "क्षिपत्येकेन वेगेन पञ्चबाणशतानि यः\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2145427, "chapter_id": 4131, "verse_number": "२३", "content_sanskrit": "सदृशं बाहुवीर्येण कार्तवीर्यस्य पाण्डवम् ।\nतमर्जुनं महेष्वासं महेन्द्रोपेन्द्ररक्षितम्\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2145428, "chapter_id": 4131, "verse_number": "२४", "content_sanskrit": "निघ्नन्तमिव पश्यामि विमर्देऽस्मिन् महामृधे\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2145429, "chapter_id": 4131, "verse_number": "२५", "content_sanskrit": "इत्येवं चिन्तयन् कृत्स्नमहोरात्राणि भारत ।\nअनिद्रो निःसुखश्चास्मि कुरूणां शमचिन्तया\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2145430, "chapter_id": 4131, "verse_number": "२६", "content_sanskrit": "क्षयोदयोऽयं सुमहान् कुरूणां प्रत्युपस्थितः ।\nअस्य चेत् कलहस्यान्तः शमादन्यो न विद्यते\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2145431, "chapter_id": 4131, "verse_number": "२७", "content_sanskrit": "शमो मे रोचतेत्यर्थं पार्थैः सह न विग्रहः ।\nकुरुभ्यो हि सदा मन्ये पाण्डवान् शक्तिमत्तरान्\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2145432, "chapter_id": 4131, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2145433, "chapter_id": 4131, "verse_number": "२८", "content_sanskrit": "पितुरेतद् वचः श्रुत्वा धार्तराष्ट्रोऽत्यमर्षणः ।\nआधाय विपुलं क्रोधं पुनरेवेदमब्रवीत्\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2145434, "chapter_id": 4131, "verse_number": "२९", "content_sanskrit": "अशक्या देवसचिवाः पार्थाः स्युरिति यद् भवान् ।\nमन्यते तद्भयं व्येतु भवतो राजसत्तम\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2145435, "chapter_id": 4131, "verse_number": "३०", "content_sanskrit": "अकामद्वेषसंयोगान्मोहाल्लोभाच्च भारत ।\nउपेक्षया च भावानां देवा देवत्वमाप्नुवन्\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2145436, "chapter_id": 4131, "verse_number": "समाप्तिः", "content_sanskrit": "इति द्वैपायनो व्यासो नारदश्च महातपाः ।\nजामदग्न्यश्च रामो नः कथामकथयन् पुरा\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2145437, "chapter_id": 4131, "verse_number": "३२", "content_sanskrit": "नैव मानुषवद् देवाः प्रवर्तन्ते कदाचन ।\nकामात् क्रोधात् तथा लोभात् द्वेषाच्च भरतर्षभ\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2145438, "chapter_id": 4131, "verse_number": "३३", "content_sanskrit": "यदा ह्यग्निश्च वायुश्च धर्म इन्द्रोऽश्विनावपि ।\nकामयोगात् प्रवर्तेरन् अपार्था दुःखमाप्नुयुः\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2145439, "chapter_id": 4131, "verse_number": "३४", "content_sanskrit": "तस्मान्न भवता चिन्ता कार्यैषा स्यात् कथञ्चन ।\nदेवाश्चोपेक्षका ह्येते शश्वद् भावेषु भारत\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2145440, "chapter_id": 4131, "verse_number": "३५", "content_sanskrit": "अथ चेत् कामसंयोगाद् द्वेषो लोभश्च लक्ष्यते ।\nदेवेषु देवप्रामाण्यं नैव तद् विक्रमिष्यति\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2145441, "chapter_id": 4131, "verse_number": "३६", "content_sanskrit": "मयाऽभिमन्त्रितः शश्वत् जातवेदाः प्रशाम्यति ।\nदिधक्षुः सकलाँल्लोकान् परिक्षिप्य समन्ततः\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2145442, "chapter_id": 4131, "verse_number": "३७", "content_sanskrit": "यद्वा परमकं तेजो येन युक्ता दिवौकसः ।\nममाप्यनुपमं भूयो देवेभ्यो विद्धि भारत\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2145443, "chapter_id": 4131, "verse_number": "३८", "content_sanskrit": "विदीर्यमाणां वसुधां गिरीणां शिखराणि च ।\nलोकस्य पश्यतो राजन् स्थापयाम्यभिमन्त्रणात्\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2145444, "chapter_id": 4131, "verse_number": "३९", "content_sanskrit": "चेतनाचेतनस्यास्य जङ्गमस्थावरस्य च ।\nविनाशाय समुत्पन्नं भयं घोरं महास्वनम्\t ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2145445, "chapter_id": 4131, "verse_number": "४०", "content_sanskrit": "अश्मवर्षं च वायुं च शमयामीह नित्यशः ।\nजगतः पश्यतोऽभीक्ष्णं भूतानामनुकम्पया\t ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2145446, "chapter_id": 4131, "verse_number": "४१", "content_sanskrit": "स्तम्भितास्वप्सु गच्छन्ति मया रथपदातयः\t ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2145447, "chapter_id": 4131, "verse_number": "४२", "content_sanskrit": "देवासुराणां भावानाम् अहमेकः प्रवर्तिता\t ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2145448, "chapter_id": 4131, "verse_number": "४३", "content_sanskrit": "अक्षोहिणीभिर्यान् देशान् यामि कार्येण केनचित् ।\nतत्रापो मे प्रवर्तन्ते यत्र यत्राभिकामये\t ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2145449, "chapter_id": 4131, "verse_number": "४४", "content_sanskrit": "भयानि विषये राजन् व्याघ्रादीनि न सन्ति मे ।\nमन्त्रगुप्तानि भूतानि न हिंसन्ति भयङ्कराः\t ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2145450, "chapter_id": 4131, "verse_number": "४५", "content_sanskrit": "निकामवर्षी पर्जन्यो राजन् विषयवासिनाम् ।\nसस्यानां सर्वजन्तूनामीतयश्च न सन्ति मे\t ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2145451, "chapter_id": 4131, "verse_number": "४६", "content_sanskrit": "अश्विनावथ वाय्वग्निमरुद्भिः सह वृत्रहा ।\nधर्मश्चैव मया द्विष्टान् नोत्सहन्तेऽभिरक्षितुम्\t ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2145452, "chapter_id": 4131, "verse_number": "४७", "content_sanskrit": "यदि ह्येते समर्थाः स्युर्मद्द्विषस्त्रातुमञ्जसा ।\nन स्म त्रयोदश समाः पार्था दुःखमवाप्नुयुः\t ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2145453, "chapter_id": 4131, "verse_number": "४८", "content_sanskrit": "नैव देवा न गन्धर्वा नासुरा न च राक्षसाः ।\nशक्तास्त्रातुं मया रिष्टा सत्यमेतद् ब्रवीमि ते\t ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2145454, "chapter_id": 4131, "verse_number": "४९", "content_sanskrit": "यदभिध्याम्यहं शश्वच्छुभं वा यदि वाऽशुभम् ।\nतद् भवेद् विधिपूर्वं मे मित्रेष्वरिषु चोभयोः\t ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2145455, "chapter_id": 4131, "verse_number": "५०", "content_sanskrit": "भविष्यतीदमिति वा यद् ब्रवीमि परन्तप ।\nनान्यथा भूतपूर्वं च सत्यवागिति मां विदुः\t ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2145456, "chapter_id": 4131, "verse_number": "५१", "content_sanskrit": "लोकसाक्षिकमेतन्मे माहात्म्यं दिक्षु विश्रुतम् ।\nआश्वासनार्थं भवतः प्रोक्तं न श्लाघया नृप\t ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2145457, "chapter_id": 4131, "verse_number": "५२", "content_sanskrit": "न ह्यहं श्लाघनो राजन् भूतपूर्वः कदाचन ।\nअसदाचरितं ह्येतद् यदात्मानं प्रशंसति\t ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2145458, "chapter_id": 4131, "verse_number": "५३", "content_sanskrit": "पाण्डवांश्चैव मत्स्यांश्च पाञ्चालान् कैकयैः सह ।\nसात्यकिं वासुदेवं च श्रोतासि विजितान् मया\t ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2145459, "chapter_id": 4131, "verse_number": "५४", "content_sanskrit": "सरितः सागरं प्राप्य यथा नश्यन्ति सर्वशः ।\nतथैव ते विनङ्क्ष्यन्ति मामासाद्य सहान्वयाः\t ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2145460, "chapter_id": 4131, "verse_number": "५५", "content_sanskrit": "परा बुद्धिः परं तेजो वीर्यं च परमं मम ।\nपरा विद्या परो योगो मम तेभ्यो विशाम्पते\t ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2145461, "chapter_id": 4131, "verse_number": "५६", "content_sanskrit": "पितामहश्च द्रोणश्च कृपः शल्यः शलस्तथा ।\nअस्त्रेषु यत् विजानन्ति सर्वं तन्मयि विद्यते\t ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2145462, "chapter_id": 4131, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2145463, "chapter_id": 4131, "verse_number": "५७", "content_sanskrit": "इत्युक्त्वा सञ्जयं भूयः पर्यपृच्छत भारत ।\nज्ञातुं युयुत्सोः कार्याणि प्राप्तकालमरिन्दमः\t ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2145464, "chapter_id": 4131, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि द्विषष्टितमोऽध्यायः ॥६२॥\nव्यासाभिगमनपर्वणि पञ्चदशोऽध्यायः ॥१५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]