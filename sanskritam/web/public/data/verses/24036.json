[{"id": 7004036000, "chapter_id": 24036, "verse_number": "३-३-७-१", "content_sanskrit": "सूत उवाच ।\nइत्युक्ता मुनिना साध्वी सा विप्रवनिता पुनः ।\nतं प्रणम्याथ पप्रच्छ शिवपूजाविधेः क्रमम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004036001, "chapter_id": 24036, "verse_number": "३-३-७-२", "content_sanskrit": "शांडिल्य उवाच ।\nपक्षद्वये त्रयोदश्यां निराहारो भवेद्यदा ।\nघटीत्रयादस्तमयात्पूर्वं स्नानं समाचरेत्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004036002, "chapter_id": 24036, "verse_number": "३-३-७-३", "content_sanskrit": "शुक्लांबरधरो धीरो वाग्यतो नियमान्वितः ।\nकृतसंध्याजपविधिः शिवपूजां समारभेत्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004036003, "chapter_id": 24036, "verse_number": "३-३-७-४", "content_sanskrit": "देवस्य पुरतः सम्यगुपलिप्य नवांभसा ।\nविधाय मंडलं रम्यं धौतवस्त्रादिभिर्बुधः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004036004, "chapter_id": 24036, "verse_number": "३-३-७-५", "content_sanskrit": "वितानाद्यैरलंकृत्य फलपुष्पनवांकुरैः ।\nविचित्रपद्ममुद्धृत्य वर्णपंचकसंयुतम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004036005, "chapter_id": 24036, "verse_number": "३-३-७-६", "content_sanskrit": "तत्रोपविश्य सुशुभे भक्तियुक्तः स्थिरासने ।\nसम्यक्संपादिताशेष पूजोपकरणः शुचिः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004036006, "chapter_id": 24036, "verse_number": "३-३-७-७", "content_sanskrit": "आगमोक्तेन मंत्रेण पीठमामंत्रयेत्सुधीः ।\nततः कृत्वात्मशुद्धिं च भूतशुद्ध्यादिकं क्रमात्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004036007, "chapter_id": 24036, "verse_number": "३-३-७-८", "content_sanskrit": "प्राणायामत्रयं कृत्वा बीजवर्णैः सबिंदुकैः ।\nमातृका न्यस्य विधिवद्ध्यात्वा तां देवतां पराम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004036008, "chapter_id": 24036, "verse_number": "३-३-७-९", "content_sanskrit": "समाप्य मातृका भूयो ध्यात्वा चैव परं शिवम् ।\nवामभागे गुरुं नत्वा दक्षिणे गणपं नमेत्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004036009, "chapter_id": 24036, "verse_number": "३-३-७-१०", "content_sanskrit": "अंसोरुयुग्मे धर्मादीन्न्यस्य नाभौ च पार्श्वयोः ।\nअधर्मादीननंतादीन्हृदि पीठे मनुं न्यसेत्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004036010, "chapter_id": 24036, "verse_number": "३-३-७-११", "content_sanskrit": "आधारशक्तिमारभ्य ज्ञानात्मानमनुक्रमात् ।\nउक्तक्रमेण विन्यस्य हृत्पद्मे साधुभाविते॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004036011, "chapter_id": 24036, "verse_number": "३-३-७-१२", "content_sanskrit": "नवशक्तिमये रम्ये ध्यायेद्देवमुमापतिम् ।\nचन्द्रकोटिप्रतीकाशं त्रिनेत्रं चन्द्रशेखरम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004036012, "chapter_id": 24036, "verse_number": "३-३-७-१३", "content_sanskrit": "आपिंगलजटाजूटं रत्नमौलिविराजितम् ।\nनीलग्रीवमुदारांगं नागहारोपशोभितम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004036013, "chapter_id": 24036, "verse_number": "३-३-७-१४", "content_sanskrit": "वरदाभयहस्तं च धारिणं च परश्वधम् ।\nदधानं नागवलयकेयूरांगदमुद्रिकम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004036014, "chapter_id": 24036, "verse_number": "३-३-७-१५", "content_sanskrit": "व्याघ्रचर्मपरीधानं रत्नसिंहासने स्थितम् ।\nध्यात्वा तद्वाम भागे च चिंतयेद्गिरिकन्यकाम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004036015, "chapter_id": 24036, "verse_number": "३-३-७-१६", "content_sanskrit": "भास्वज्जपाप्रसूनाभामुदयार्कसमप्रभाम् ।\nविद्युत्पुंजनिभां तन्वीं मनोनयननंदिनीम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004036016, "chapter_id": 24036, "verse_number": "३-३-७-१७", "content_sanskrit": "बालेंदु शेखरां स्निग्धां नीलकुंचितकुन्तलाम् ।\nभृंगसंघातरुचिरां नीलालकविराजिताम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004036017, "chapter_id": 24036, "verse_number": "३-३-७-१८", "content_sanskrit": "मणिकुंडलविद्योतन्मुखमंडलविभ्रमाम् ।\nनवकुम्कुमपंकांक कपोलदलदर्पणाम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004036018, "chapter_id": 24036, "verse_number": "३-३-७-१९", "content_sanskrit": "मधुरस्मितविभ्राजदरुणाधरपल्लवाम् ।\nकंबुकंठीं शिवामुद्यत्कुचपंकजकुड्मलाम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004036019, "chapter_id": 24036, "verse_number": "३-३-७-२०", "content_sanskrit": "पाशांकुशाभयाभीष्टविल सत्सु चतुर्भुजाम् ।\nअनेकरत्नविलसत्कंकणांकितमुद्रिकाम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004036020, "chapter_id": 24036, "verse_number": "३-३-७-२१", "content_sanskrit": "वलित्रयेण विलसद्धेमकांचीगुणान्विताम् ।\nरक्तमाल्यांबरधरां दिव्यचंदनच र्चिताम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004036021, "chapter_id": 24036, "verse_number": "३-३-७-२२", "content_sanskrit": "दिक्पालवनितामौलिसन्नतांघ्रिसरोरुहाम् ।\nरत्नसिंहासनारूढां सर्पराजपरिच्छदाम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004036022, "chapter_id": 24036, "verse_number": "३-३-७-२३", "content_sanskrit": "एवं ध्यात्वा महादेवं देवीं च गिरि कन्यकाम् ।\nन्यासक्रमेण संपूज्य देवं गंधादिभिः क्रमात्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004036023, "chapter_id": 24036, "verse_number": "३-३-७-२४", "content_sanskrit": "पंचभिर्ब्रह्मभिः कुर्यात्प्रोक्तस्थानेषु वा हृदि ।\nपृथक्पुष्पांजलिं देहे मूलेन च हदि त्रिधा॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004036024, "chapter_id": 24036, "verse_number": "३-३-७-२५", "content_sanskrit": "पुनः स्वयं शिवो भूत्वा मूलमंत्रेण साधकः ।\nततः संपूजयेद्देवं बाह्यपीठे पुनः क्रमात्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004036025, "chapter_id": 24036, "verse_number": "३-३-७-२६", "content_sanskrit": "संकल्पं प्रवदेत्तत्र पूजारंभे समाहितः ।\nकृतांजलिपुटो भूत्वा चिंतयेद्धृदि शंकरम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004036026, "chapter_id": 24036, "verse_number": "३-३-७-२७", "content_sanskrit": "ऋणपातकदौर्भाग्यदारिद्र्यविनिवृत्तये ।\nअशेषाघविनाशाय प्रसीद मम शंकर॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004036027, "chapter_id": 24036, "verse_number": "३-३-७-२८", "content_sanskrit": "दुःखशोकाग्निसंतप्तं संसारभयपीडितम् ।\nबहुरोगाकुलं दीनं त्राहि मां वृषवाहन॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004036028, "chapter_id": 24036, "verse_number": "३-३-७-२९", "content_sanskrit": "आगच्छ देवदेवेश महादेवाभयंकर ।\nगृहाण सह पार्वत्या तव पूजां मया कृताम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004036029, "chapter_id": 24036, "verse_number": "३-३-७-३०", "content_sanskrit": "इति संकल्प्य विधिवद्ब्राह्मपूजां समाचरेत् ।\nगुरुं गणपतिं चैव यजेत्सव्यापसव्ययोः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004036030, "chapter_id": 24036, "verse_number": "३-३-७-३१", "content_sanskrit": "क्षेत्रेशमीशकोणे तु यजेद्वास्तोष्पतिं क्रमात् ।\nवाग्देवीं च यजेत्तत्र ततः कात्यायनीं यजेत्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004036031, "chapter_id": 24036, "verse_number": "३-३-७-३२", "content_sanskrit": "धर्मं ज्ञानं च वैराग्यमैश्वर्यं च नमोंऽतकैः ।\nस्वरैरीशादिकोणेषु पीठपादाननुक्रमात् ।\nआभ्यां बिंदुविसर्गाभ्यामधर्मादीन्प्रपूजयेत्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004036032, "chapter_id": 24036, "verse_number": "३-३-७-३३", "content_sanskrit": "सत्त्वरूपैश्चतुर्दिक्षु मध्येऽनंतं सतारकम् ।\nसत्त्वादींस्त्रिगुणांस्तं तु रूपान्पीठेषु विन्यसेत्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004036033, "chapter_id": 24036, "verse_number": "३-३-७-३४", "content_sanskrit": "अत ऊर्ध्वच्छदे मायां सह लक्ष्म्या शिवेन च॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004036034, "chapter_id": 24036, "verse_number": "३-३-७-३५", "content_sanskrit": "तदंते चांबुजं भूयः सकलं मंडलत्रयम् ।\nपत्रकेसरकिंजल्कव्याप्तं ताराक्षरैः क्रमात्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004036035, "chapter_id": 24036, "verse_number": "३-३-७-३६", "content_sanskrit": "पद्मत्रयं तथाभ्यर्च्य मध्ये मंडलमादरात् ।\nवामां ज्येष्ठां च रौद्रीं च भागाद्यैर्दिक्षु पूजयेत्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004036036, "chapter_id": 24036, "verse_number": "३-३-७-३७", "content_sanskrit": "वामाद्या नव शक्तीश्च नवस्वरयुता यजेत् ।\nहृदि बीजत्रयाद्येन पीठमंत्रेण चार्चयेत्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004036037, "chapter_id": 24036, "verse_number": "३-३-७-३८", "content_sanskrit": "आवृत्तैः प्रथमांगैश्च पंचभिर्मूर्त्तिशक्तिभिः ।\nत्रिशक्तिमूर्त्तिभिश्चान्यैर्निधिद्वयसमन्वितैः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004036038, "chapter_id": 24036, "verse_number": "३-३-७-३९", "content_sanskrit": "अनंताद्यैः परीताश्च मातृभिश्च वृषादिभिः ।\nसिद्धिभिश्चाणिमाद्याभिरिंद्राद्यैश्च सहायुधैः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004036039, "chapter_id": 24036, "verse_number": "३-३-७-४०", "content_sanskrit": "वृषभक्षेत्रचंडेशदुर्गाश्च स्कंदनंदिनौ ।\nगणेशः सैन्यपश्चैव स्वस्वलक्षणलक्षिताः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004036040, "chapter_id": 24036, "verse_number": "३-३-७-४१", "content_sanskrit": "अणिमा महिमा चैव गरिमा लघिमा तथा ।\nईशित्वं च वशित्वं च प्राप्तिः प्राकाम्यमेव च॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004036041, "chapter_id": 24036, "verse_number": "३-३-७-४२", "content_sanskrit": "अष्टैश्वर्याणि चोक्तानि तेजोरूपाणि केवलम् ।\nपंचभिर्ब्रह्मभिः पूर्वं हृल्लेखाद्यादिभिः क्रमात॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004036042, "chapter_id": 24036, "verse_number": "३-३-७-४३", "content_sanskrit": "अंगैरुमाद्यैरिंद्राद्यैः पूजोक्ता मुनिभिस्तु तैः ।\nउमाचंडेश्वरादींश्च पूजयेदुत्तरादितः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004036043, "chapter_id": 24036, "verse_number": "३-३-७-४४", "content_sanskrit": "एवमावरणैर्युक्तं तेजोरूपं सदाशिवम् ।\nउमया सहितं देवमुपचारैः प्रपूजयेत्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004036044, "chapter_id": 24036, "verse_number": "३-३-७-४५", "content_sanskrit": "सुप्रतिष्ठितशंखस्य तीर्थैः पंचामृतैरपि ।\nअभिषिच्य महादेवं रुद्रसूक्तैः समाहितः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004036045, "chapter_id": 24036, "verse_number": "३-३-७-४६", "content_sanskrit": "कल्पयेद्विविधैर्मंत्रैरासनाद्युपचारकान् ।\nआसनं कल्पयेद्धैमं दिव्यवस्त्रसमन्वितम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004036046, "chapter_id": 24036, "verse_number": "३-३-७-४७", "content_sanskrit": "अर्घ्यमष्टगुणोपेतं पाद्यशुद्धोदकेन च ।\nतेनैवाचमनं दद्यान्मधुपर्कं मधूत्तरम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004036047, "chapter_id": 24036, "verse_number": "३-३-७-४८", "content_sanskrit": "पुनराचमनं दत्त्वा स्नानं मंत्रै प्रकल्पयेत् ।\nउपवीतं तथा वासो भूषणानि निवेदयेत् ।\nगंधमष्टांगसंयुक्तं सुपूतं विनिवेदयेत्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004036048, "chapter_id": 24036, "verse_number": "३-३-७-४९", "content_sanskrit": "ततश्च बिल्वमंदारकह्लारसरसीरुहम् ।\nधत्तूरकं कर्णिकारं शणपुष्पं च मल्लिकाम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004036049, "chapter_id": 24036, "verse_number": "३-३-७-५०", "content_sanskrit": "कुशापामार्गतुलसीमाधवीचंपकादिकम् ।\nबृहतीकरवीराणि यथालब्धानि साधकः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004036050, "chapter_id": 24036, "verse_number": "३-३-७-५१", "content_sanskrit": "निवेदयेत्सुगंधीनि माल्यानि विविधानि च ।\nधूपं कालागरूत्पन्नं दीपं च विमलं शुभम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004036051, "chapter_id": 24036, "verse_number": "३-३-७-५२", "content_sanskrit": "विशेषकम् ।\nअथ पायसनैवेद्यं सघृतं सोपदंशकम् ।\nमोदकापूपसंयुक्तं शर्करागुडसंयुतम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004036052, "chapter_id": 24036, "verse_number": "३-३-७-५३", "content_sanskrit": "मधुनाक्तं दधियुतं जलपानसमन्वितम् ।\nतेनैव हविषा वह्नौ जुहुयान्मंत्रभाविते॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004036053, "chapter_id": 24036, "verse_number": "३-३-७-५४", "content_sanskrit": "आगमोक्तेन विधिना गुरुवाक्यनियंत्रितः ।\nनैवेद्यं शंभवे भूयो दत्त्वा तांबूलमुत्तमम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004036054, "chapter_id": 24036, "verse_number": "३-३-७-५५", "content_sanskrit": "धूपं नीराजनं रम्यं छत्रं दर्पणमुत्तमम् ।\nसमर्पयित्वा विधिवन्मंत्रैर्वेदिकतांत्रिकैः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004036055, "chapter_id": 24036, "verse_number": "३-३-७-५६", "content_sanskrit": "यद्यशक्तः स्वयं निःस्वो यथाविभवमर्चयेत् ।\nभक्त्त्या दत्तेन गौरीशः पुष्पमात्रेण तुष्यति॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004036056, "chapter_id": 24036, "verse_number": "३-३-७-५७", "content_sanskrit": "अथांगभूतान्सकलान्गणेशादीन्प्रपूजयेत् ।\nस्तवैर्नानाविधैः स्तुत्वा साष्टांगं प्रणमेद्बुधः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004036057, "chapter_id": 24036, "verse_number": "३-३-७-५८", "content_sanskrit": "ततः प्रदक्षिणीकृत्य वृषचंडेश्वरादिकान् ।\nपूजां समर्प्य विधिवत्प्रार्थयेद्गिरिजापतिम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004036058, "chapter_id": 24036, "verse_number": "३-३-७-५९", "content_sanskrit": "जय देव जगन्नाथ जय शंकर शाश्वत ।\nजय सर्व सुराध्यक्ष जय सर्वसुरार्चित॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004036059, "chapter_id": 24036, "verse_number": "३-३-७-६०", "content_sanskrit": "जय सर्वगुणातीत जय सर्ववरप्रद ।\nजय नित्य निराधार जय विश्वंभराव्यय॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004036060, "chapter_id": 24036, "verse_number": "३-३-७-६१", "content_sanskrit": "जय विश्वैकवेद्येश जय नागेंद्रभूषण ।\nजय गौरीपते शंभो जय चंद्रार्धशेखर॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004036061, "chapter_id": 24036, "verse_number": "३-३-७-६२", "content_sanskrit": "जय कोट्यर्कसंकाश जयानंतगुणाश्रय॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004036062, "chapter_id": 24036, "verse_number": "३-३-७-६३", "content_sanskrit": "जय रुद्र विरूपाक्ष जयाचिंत्य निरंजन ।\nजय नाथ कृपासिंधो जय भक्तार्तिभञ्जन ।\nजय दुस्तरसंसारसागरोत्तारण प्रभो॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004036063, "chapter_id": 24036, "verse_number": "३-३-७-६४", "content_sanskrit": "प्रसीद मे महादेव संसारार्त्तस्य खिद्यतः ।\nसर्वपापभयं हृत्वा रक्ष मां परमेश्वर॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004036064, "chapter_id": 24036, "verse_number": "३-३-७-६५", "content_sanskrit": "महादारिद्र्यमग्नस्य महापापहतस्य च ।\nमहाशोकविनष्टस्य महारोगातुरस्य च॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004036065, "chapter_id": 24036, "verse_number": "३-३-७-६६", "content_sanskrit": "ऋणभारपरीतस्य दह्यमानस्य कर्मभिः ।\nग्रहैः प्रपीड्यमानस्य प्रसीद मम शंकर॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004036066, "chapter_id": 24036, "verse_number": "३-३-७-६७", "content_sanskrit": "दरिद्रः प्रार्थयेदेवं पूजांते गिरिजापतिम् ।\nअर्थाढ्यो वापि राजा वा प्रार्थयेद्देवमीश्वरम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004036067, "chapter_id": 24036, "verse_number": "३-३-७-६८", "content_sanskrit": "दीर्घमायुः सदारोग्यं कोशवृद्धिर्बलोन्नतिः ।\nममास्तु नित्यमानन्दः प्रसादात्तव शंकर॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004036068, "chapter_id": 24036, "verse_number": "३-३-७-६९", "content_sanskrit": "शत्रवः संक्षयं यांतु प्रसीदन्तु मम ग्रहाः ।\nनश्यन्तु दस्यवो राष्ट्रे जनाः संतु निरापदः॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004036069, "chapter_id": 24036, "verse_number": "३-३-७-७०", "content_sanskrit": "दुर्भिक्षमारीसंतापाः शमं यांतु महीतले ।\nसर्वसस्यसमृद्धिश्च भूयात्सुखमया दिशः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004036070, "chapter_id": 24036, "verse_number": "३-३-७-७१", "content_sanskrit": "एवमाराधयेद्देवं प्रदोषे गिरिजापतिम् ।\nब्राह्मणान्भोजयेत्पश्चाद्दक्षिणाभिश्च तोषयेत्॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004036071, "chapter_id": 24036, "verse_number": "३-३-७-७२", "content_sanskrit": "सर्वपापक्षयकरी सर्वदारिद्र्यनाशिनी ।\nशिवपूजा मया ख्याता सर्वाभीष्टवरप्रदा॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004036072, "chapter_id": 24036, "verse_number": "३-३-७-७३", "content_sanskrit": "महापातकसंघातमधिकं चोपपातकम् ।\nशिवद्रव्यापहरणादन्यत्सर्वं निवारयेत्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004036073, "chapter_id": 24036, "verse_number": "३-३-७-७४", "content_sanskrit": "ब्रह्महत्यादिपापानां पुराणेषु स्मृतिष्वपि ।\nप्रायश्चित्तानि दृष्टानि न शिवद्रव्यहारिणाम्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004036074, "chapter_id": 24036, "verse_number": "३-३-७-७५", "content_sanskrit": "बहुनात्र किमुक्तेन श्लोकार्धेन ब्रवीम्यहम् ।\nब्रह्महत्याशतं वापि शिवपूजा विनाशयेत्॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004036075, "chapter_id": 24036, "verse_number": "३-३-७-७६", "content_sanskrit": "मया कथितमेतत्ते प्रदोषे शिवपूजनम् ।\nरहस्यं सर्वजंतूनामत्र नास्त्येव संशयः॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004036076, "chapter_id": 24036, "verse_number": "३-३-७-७७", "content_sanskrit": "एताभ्यामपि बालाभ्यामेवं पूजा विधीयताम् ।\nअतः संवत्सरादेव परां सिद्धिमवाप्स्यथ॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004036077, "chapter_id": 24036, "verse_number": "३-३-७-७८", "content_sanskrit": "इति शांडिल्यवचनमाकर्ण्य द्विजभामिनी ।\nताभ्यां तु सह बालाभ्यां प्रणनाम मुनेः पदम्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004036078, "chapter_id": 24036, "verse_number": "३-३-७-७९", "content_sanskrit": "विप्रस्त्र्युवाच ।\nअहमद्य कृतार्थास्मि तव दर्शनमात्रतः ।\nएतौ कुमारौ भगवंस्त्वामेव शरणं गतौ॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004036079, "chapter_id": 24036, "verse_number": "३-३-७-८०", "content_sanskrit": "एष मे तनयो ब्रह्मञ्छुचिव्रत इतीरितः ।\nएष राजसुतो नाम्ना धर्मगुप्तः कृतो मया॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004036080, "chapter_id": 24036, "verse_number": "३-३-७-८१", "content_sanskrit": "एतावहं च भगवन्भवच्चरणकिंकराः ।\nसमुद्धरास्मिन्पतितान्घोरे दारिद्र्यसागरे॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004036081, "chapter_id": 24036, "verse_number": "३-३-७-८२", "content_sanskrit": "इति प्रपन्नां शरणं द्विजांगनामाश्वास्य वाक्यैरमृतोपमानैः ।\nउपादिदेशाथ तयोः कुमारयोर्मुनिः शिवाराधनमंत्र विद्याम्॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004036082, "chapter_id": 24036, "verse_number": "३-३-७-८३", "content_sanskrit": "अथोपदिष्टौ मुनिना कुमारौ ब्राह्मणी च सा ।\nतं प्रणम्य समामंत्र्य जग्मुस्ते शिवमंदिरात्॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004036083, "chapter_id": 24036, "verse_number": "३-३-७-८४", "content_sanskrit": "ततः प्रभृति तौ बालौ मुनिवर्योपदेशतः ।\nप्रदोषे पार्वतीशस्य पूजां चक्रतुरंजसा॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004036084, "chapter_id": 24036, "verse_number": "३-३-७-८५", "content_sanskrit": "एवं पूजयतोर्देवं द्विजराजकुमारयोः ।\nसुखेनैव व्यतीयाय तयोर्मासचतुष्टयम्॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004036085, "chapter_id": 24036, "verse_number": "३-३-७-८६", "content_sanskrit": "कदाचिद्राजपुत्रेण विनासौ द्विजनंदनः ।\nस्नातुं गतो नदीतीरे चचार बहुलीलया॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004036086, "chapter_id": 24036, "verse_number": "३-३-७-८७", "content_sanskrit": "तत्र निर्झरनिर्घातनिर्भिन्ने वप्र कुट्टिमे ।\nनिधानकलशं स्थूलं प्रस्फुरंतं ददर्श ह॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004036087, "chapter_id": 24036, "verse_number": "३-३-७-८८", "content_sanskrit": "तं दृष्ट्वा सहसागत्य हर्षकौतुकविह्वलः ।\nदैवोपपन्नं मन्वानो गृहीत्वा शिरसा ययौ॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004036088, "chapter_id": 24036, "verse_number": "३-३-७-८९", "content_sanskrit": "ससंभ्रमं समानीय निधाय कलशं बलात् ।\nनिधाय भवनस्यांते मातरं समभाषत॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004036089, "chapter_id": 24036, "verse_number": "३-३-७-९०", "content_sanskrit": "मातर्मातरिमं पश्य प्रसादं गिरिजापतेः ।\nनिधानं कुम्भरूपेण दर्शितं करुणात्मना॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004036090, "chapter_id": 24036, "verse_number": "३-३-७-९१", "content_sanskrit": "अथ सा विस्मिता साध्वी समाहूय नृपात्मजम् ।\nस्वपुत्रं प्रतिनंद्याह मानयन्ती शिवार्चनम्॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004036091, "chapter_id": 24036, "verse_number": "३-३-७-९२", "content_sanskrit": "शृणुतां मे वचः पुत्रौ निधानकलशीमिमाम् ।\nसमं विभज्य गृह्णीतं मम शासनगौरवात्॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004036092, "chapter_id": 24036, "verse_number": "३-३-७-९३", "content_sanskrit": "इति मातुर्वचः श्रुत्वा तुतोष द्विज नंदनः ।\nप्रत्याह राजपुत्रस्तां विस्रब्धः शंकरार्चने॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004036093, "chapter_id": 24036, "verse_number": "३-३-७-९४", "content_sanskrit": "मातस्तव सुतस्यैव सुकृतेन समागतम् ।\nनाहं ग्रहीतुमिच्छामि विभक्तं धनसंच यम्॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004036094, "chapter_id": 24036, "verse_number": "३-३-७-९५", "content_sanskrit": "आत्मनः सुकृताल्लब्धं स्वयमेव भुनक्त्वसौ ।\nस एव भगवानीशः करिष्यति कृपां मयि॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004036095, "chapter_id": 24036, "verse_number": "३-३-७-९६", "content_sanskrit": "एवमर्चयतोः शंभुं भूयोपि परया मुदा ।\nसंवत्सरो व्यतीयाय तस्मिन्नेव गृहे तयोः॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004036096, "chapter_id": 24036, "verse_number": "३-३-७-९७", "content_sanskrit": "अथैकदा राजसूनुः सह तेन द्विजन्मना ।\nवसंतसमये प्राप्ते विजहार वनां तरे॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004036097, "chapter_id": 24036, "verse_number": "३-३-७-९८", "content_sanskrit": "अथ दूरं गतौ क्वापि वने द्विजनृपात्मजौ ।\nगन्धर्वकन्याः क्रीडंती शतशस्तावपश्यताम्॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004036098, "chapter_id": 24036, "verse_number": "३-३-७-९९", "content_sanskrit": "ताः सर्वाश्चारुसर्वांग्यो विहरंत्यो मनोहरम् ।\nदृष्ट्वा द्विजात्मजो दूरादुवाच नृपनंदनम्॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004036099, "chapter_id": 24036, "verse_number": "३-३-७-१००", "content_sanskrit": "इतः पुरो न गंतव्यं विहरंत्यग्रतः स्त्रियः ।\nस्त्रीसंन्निधानं विबुधास्त्यजंति विमलाशयाः॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004036100, "chapter_id": 24036, "verse_number": "३-३-७-१०१", "content_sanskrit": "एताः कैतवकारिण्यो धनयौवनदुर्मदाः ।\nमोहयन्त्यो जनं दृष्ट्वा वाचानुनयकोविदाः॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004036101, "chapter_id": 24036, "verse_number": "३-३-७-१०२", "content_sanskrit": "अतः परित्यजेत्त्स्त्रीणां सन्निधिं सहभाषणम् ।\nनिज़धर्मरतो विद्वन्ब्रह्मचारी विशेषतः॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004036102, "chapter_id": 24036, "verse_number": "३-३-७-१०३", "content_sanskrit": "अतोहं नोत्सहे गन्तुं क्रीडास्थानं मृगीदृशाम् ।\nइत्युक्त्वा द्विजपुत्रस्तु निवृत्तो दूरतः स्थितः॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004036103, "chapter_id": 24036, "verse_number": "३-३-७-१०४", "content_sanskrit": "अथासौ राजपुत्रस्तु कौतुकाविष्टमानसः ।\nतासां विहारपदवीमेक एवाभयो ययौ॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004036104, "chapter_id": 24036, "verse_number": "३-३-७-१०५", "content_sanskrit": "तत्र गंधर्वकन्यानां मध्ये त्वेका वरानना ।\nदृष्ट्वाऽयांतं राजपुत्रं चिंतयामास चेतसा॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004036105, "chapter_id": 24036, "verse_number": "३-३-७-१०६", "content_sanskrit": "अहो कोयमुदारांगो युवा सर्वांगसुन्दरः ।\nमत्तमातंग गमनो लावण्यामृतवारिधिः॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004036106, "chapter_id": 24036, "verse_number": "३-३-७-१०७", "content_sanskrit": "लीलालोलविशालाक्षी मधुरस्मितपेशलः ।\nमदनोपमरूपश्रीः सुकुमारांगलक्षणः॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004036107, "chapter_id": 24036, "verse_number": "३-३-७-१०८", "content_sanskrit": "इत्याश्चर्ययुता बाला दूराद्दृष्ट्वा नृपात्मजम् ।\nसर्वाः सखीः समालोक्य वचनं चेदमब्रवीत्॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004036108, "chapter_id": 24036, "verse_number": "३-३-७-१०९", "content_sanskrit": "इतो विदूरे हे सख्यो वनमस्त्येकमुत्तमम् ।\nविचित्रचंपकाशोकपुन्नागबकुलैर्युतम्॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004036109, "chapter_id": 24036, "verse_number": "३-३-७-११०", "content_sanskrit": "तत्र गत्वा वनं सर्वाः संचीय कुसुमोत्करम् ।\nभवत्यः पुनरायांतु तावत्तिष्ठाम्यहं त्विह॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004036110, "chapter_id": 24036, "verse_number": "३-३-७-१११", "content_sanskrit": "इत्यादिष्टः सखीवर्गो जगाम विपिनांतरम् ।\nसापि गंधर्वजा तस्थौ न्यस्तदृष्टिर्नृपात्मजे॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004036111, "chapter_id": 24036, "verse_number": "३-३-७-११२", "content_sanskrit": "तां समालोक्य तन्वंगीं नवयौवनशालिनीम् ।\nबालां स्वरूपसंपत्त्या परैिभूततिलोत्तमाम्॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004036112, "chapter_id": 24036, "verse_number": "३-३-७-११३", "content_sanskrit": "राजपुत्रः समागम्य कौतुकोत्फुल्ललोचनः ।\nअवाप दैवयोगेन मदनस्य शरव्यथाम्॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004036113, "chapter_id": 24036, "verse_number": "३-३-७-११४", "content_sanskrit": "गन्धर्वतनया सापि प्राप्ताय नृपसूनवे ।\nउत्थाय तरसा तस्मै प्रददौ पल्लवासनम्॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004036114, "chapter_id": 24036, "verse_number": "३-३-७-११५", "content_sanskrit": "कृतोपचारमासीनं तमासाद्य सुमध्यमा ।\nपप्रच्छ तद्रूपगुणैर्ध्वस्तधैर्याकुलेंद्रिया॥ ११९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004036115, "chapter_id": 24036, "verse_number": "३-३-७-११६", "content_sanskrit": "कस्त्वं कमलपत्राक्ष कस्माद्देशादिहागतः ।\nकस्य पुत्र इति प्रेम्णा पृष्टः सर्वं न्यवेदयत्॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004036116, "chapter_id": 24036, "verse_number": "३-३-७-११७", "content_sanskrit": "विदर्भ राजतनयं विध्वस्तपितृमातृकम् ।\nशत्रुभिश्च हृतस्थानमात्मानं परराष्ट्रगम्॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004036117, "chapter_id": 24036, "verse_number": "३-३-७-११८", "content_sanskrit": "सर्वमावेद्य भूयस्तां पप्रच्छ नृपनंदनः ।\nका त्वं वामोरु किं चात्र कार्यं ते कस्य चात्मजा॥ ११८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004036118, "chapter_id": 24036, "verse_number": "३-३-७-११९", "content_sanskrit": "किमवध्यायसि हृदा किं वा वक्तुमिहेच्छसि ।\nइत्युक्ता सा पुनः प्राह शृणु राजेंद्रसत्तम॥ ११९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004036119, "chapter_id": 24036, "verse_number": "३-३-७-१२०", "content_sanskrit": "अस्त्येको द्रविकोनाम गंधर्वाणां कुलाग्रणीः ।\nतस्याहमस्मि तनया नाम्ना चांशुमती स्मृता॥ १२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004036120, "chapter_id": 24036, "verse_number": "३-३-७-१२१", "content_sanskrit": "त्वामायांतं विलोक्याहं त्वत्संभाषण लालसा ।\nत्यक्त्वा सखीजनं सर्वमेकैवास्मि महामते॥ १२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7004036121, "chapter_id": 24036, "verse_number": "३-३-७-१२२", "content_sanskrit": "सर्वसंगीतविद्यासु न मत्तोऽन्यास्ति काचन ।\nमम योगेन तुष्यंति सर्वा अपि सुरस्त्रियः॥ १२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7004036122, "chapter_id": 24036, "verse_number": "३-३-७-१२३", "content_sanskrit": "साहं सर्वकलाभिज्ञा ज्ञातसर्वजनेंगिता ।\nतवाहमीप्सितं वेद्मि मयि ते संगतं मनः॥ १२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7004036123, "chapter_id": 24036, "verse_number": "३-३-७-१२४", "content_sanskrit": "तथा ममापि चौत्सुक्यं दैवेन प्रतिपादितम् ।\nआवयोः स्नेहभेदोऽत्र नाभिभूयादितः परम्॥ १२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7004036124, "chapter_id": 24036, "verse_number": "३-३-७-१२५", "content_sanskrit": "इति संभाष्य तेनाशु प्रेम्णा गन्धर्वनंदिनी ।\nमुक्ताहारं ददौ तस्मै स्वकुचांतरभूषणम्॥ १२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7004036125, "chapter_id": 24036, "verse_number": "३-३-७-१२६", "content_sanskrit": "तमादायाद्भुतं हारं स तस्याः प्रणयाकुलः ।\nगाढहर्षभरोत्सिक्तामिदमाह नृपात्मजः॥ १२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7004036126, "chapter_id": 24036, "verse_number": "३-३-७-१२७", "content_sanskrit": "सत्यमुक्तं त्वया भीरु तथाप्येकं वदाम्यहम् ।\nत्यक्तराज्यस्य निःस्वस्य कथं मे भवसि प्रिया॥ १२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7004036127, "chapter_id": 24036, "verse_number": "३-३-७-१२८", "content_sanskrit": "सा त्वं पितृमती बाला विलंघ्य पितृशासनम् ।\nस्वच्छंदा चरणं कर्तुं मूढेव कथमर्हसि॥ १२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7004036128, "chapter_id": 24036, "verse_number": "३-३-७-१२९", "content_sanskrit": "इति तस्य वचः श्रुत्वा तं प्रत्याह शुचिस्मिता ।\nअस्तु नाम तथैवाहं करिष्ये पश्य कौतुकम्॥ १२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7004036129, "chapter_id": 24036, "verse_number": "३-३-७-१३०", "content_sanskrit": "गच्छ स्वभवनं कांत परश्वः प्रातरेव तु ।\nआगच्छ पुनरत्रैव कार्यमस्ति च नो मृषा॥ १३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7004036130, "chapter_id": 24036, "verse_number": "३-३-७-१३१", "content_sanskrit": "इत्युक्त्वा तं नृपसुतं सा संगतसखीजना ।\nअपाक्रामत चार्वंगी स चापि नृपनन्दनः॥ १३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7004036131, "chapter_id": 24036, "verse_number": "३-३-७-१३२", "content_sanskrit": "स समभ्येत्य हर्षेण द्विजपुत्रस्य सन्निधिम् ।\nसर्वमाख्याय तेनैव सार्धं स्वभवनं ययौ॥ १३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7004036132, "chapter_id": 24036, "verse_number": "३-३-७-१३३", "content_sanskrit": "तां च विप्रसतीं भूयो हर्षयित्वा नृपात्मजः ।\nपरश्वो द्विजपुत्रेण सार्धं तेन वनं ययौ॥ १३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7004036133, "chapter_id": 24036, "verse_number": "३-३-७-१३४", "content_sanskrit": "स तया पूर्वनिर्दिष्टं स्थानं प्राप्य नृपात्मजः ।\nगन्धर्वराजमद्राक्षीत्स्वदुहित्रा समन्वितम्॥ १३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7004036134, "chapter_id": 24036, "verse_number": "३-३-७-१३५", "content_sanskrit": "स गंधर्वपतिः प्राप्तावभिनंद्य कुमारकौ ।\nउपवेश्यासने रम्ये राजपुत्रमभाषत॥ १३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7004036135, "chapter_id": 24036, "verse_number": "३-३-७-१३६", "content_sanskrit": "गंधर्व उवाच ।\nराजेंद्रपुत्र पूर्वेद्युः कैलासं गतवानहम् ।\nतत्रापश्यं महादेवं पार्वत्या सहितं प्रभुम्॥ १३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7004036136, "chapter_id": 24036, "verse_number": "३-३-७-१३७", "content_sanskrit": "आहूय मां स देवेशः सर्वेषां त्रिदिवौकसाम् ।\nसन्निधावाह भगवान्करुणामृतवारिधिः॥ १३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7004036137, "chapter_id": 24036, "verse_number": "३-३-७-१३८", "content_sanskrit": "धर्मगुप्ताह्वयः कश्चिद्राजपुत्रोऽस्ति भूतले ।\nअकिञ्चनो भ्रष्टराज्यो हृतदेशश्च शत्रुभिः॥ १३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7004036138, "chapter_id": 24036, "verse_number": "३-३-७-१३९", "content_sanskrit": "स बालो गुरुवाक्येन मदर्च्चायां रतः सदा ।\nअद्य तत्पितरः सर्वे मां प्राप्तास्तत्प्रभावतः॥ १३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7004036139, "chapter_id": 24036, "verse_number": "३-३-७-१४०", "content_sanskrit": "तस्य त्वमपि साहाय्यं कुरु गन्धर्वसत्तम ।\nअथासौ निजराज्यस्थो हतशत्रुर्भविष्यति॥ १४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7004036140, "chapter_id": 24036, "verse_number": "३-३-७-१४१", "content_sanskrit": "इत्याज्ञप्तो महेशेन संप्राप्तो निजमदिरम् ।\nअनया मद्दुहित्रा च बहुशोऽभ्यर्थितस्तथा॥ १४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7004036141, "chapter_id": 24036, "verse_number": "३-३-७-१४२", "content_sanskrit": "ज्ञात्वेमं सकलं शंभोर्नियोगं करुणात्मनः ।\nआदायेमां दुहितरं प्राप्तोऽस्मीदं वनांतरम्॥ १४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7004036142, "chapter_id": 24036, "verse_number": "३-३-७-१४३", "content_sanskrit": "अत एनां प्रयच्छामि कन्यामंशुमतीं तव ।\nहत्वा शत्रून्स्वराष्टे त्वां स्थापयामि शिवाज्ञया॥ १४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7004036143, "chapter_id": 24036, "verse_number": "३-३-७-१४४", "content_sanskrit": "तस्मिन्पुरे त्वमनया भुक्त्वा भोगान्यथेप्सितान् ।\nदशवर्षसहस्रान्ते गन्तासि गिरिशालयम् ।\nतत्रापि मम कन्येयं त्वामेव प्रतिपत्स्यते ।\nअनेनैव स्वदेहेन दिव्येन शिवसन्निधौ॥ १४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7004036144, "chapter_id": 24036, "verse_number": "३-३-७-१४५", "content_sanskrit": "इति गन्धर्वराजस्तमाभाष्य नृपनन्दनम् ।\nतस्मिन्वने स्वदुहितुः पाणिग्रहमकारयत्॥ १४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7004036145, "chapter_id": 24036, "verse_number": "३-३-७-१४६", "content_sanskrit": "पारिबर्हमदात्तस्मै रत्नभारान्महोज्ज्वलान् ।\nचूडामणिं चन्द्रनिभं मुक्ताहारांश्च भासुरान्॥ १४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7004036146, "chapter_id": 24036, "verse_number": "३-३-७-१४७", "content_sanskrit": "दिव्यालंकारवासांसि कार्त्तस्वरपरिच्छदान् ।\nगजानामयुतं भूयो नियुतं नीलवाजिनाम्॥ १४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7004036147, "chapter_id": 24036, "verse_number": "३-३-७-१४८", "content_sanskrit": "स्यन्दनानां सहस्राणि सौवर्णानि महांति च ।\nपुनरेकं रथं दिव्यं धनुश्चेन्द्रायुधोपमम्॥ १४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7004036148, "chapter_id": 24036, "verse_number": "३-३-७-१४९", "content_sanskrit": "अस्त्राणां च सहस्राणि तूणी चाक्षय्यसायकौ ।\nअभेद्यं वर्म सौवर्णं शक्तिं च रिपुमर्दिनीम्॥ १५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7004036149, "chapter_id": 24036, "verse_number": "३-३-७-१५०", "content_sanskrit": "दुहितुः परिचर्यार्थं दासीपञ्चसहस्रकम् ।\nददौ प्रीतमनास्तस्मै धनानि विविधानि च॥ १५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 7004036150, "chapter_id": 24036, "verse_number": "३-३-७-१५१", "content_sanskrit": "गंधर्वसैन्यमत्युग्रं चतुरंगसममन्वितम् ।\nपुनश्च तत्सहायार्थे गन्धर्वाधिपतिर्ददौ॥ १५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 7004036151, "chapter_id": 24036, "verse_number": "३-३-७-१५२", "content_sanskrit": "इत्थं राजेन्द्रतनयः संप्राप्तः श्रियमुत्तमाम् ।\nअभीष्टजायासहितो मुमुदे निजसंपदा॥ १५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 7004036152, "chapter_id": 24036, "verse_number": "३-३-७-१५३", "content_sanskrit": "कारयित्वा स्वदुहितुर्विवाहं समयोचितम् ।\nययौ विमानमारुह्य गंधर्वाधिपतिर्दिवम्॥ १५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 7004036153, "chapter_id": 24036, "verse_number": "३-३-७-१५४", "content_sanskrit": "धर्मगुप्तः कृतोद्वाहः सह गंधर्वसेनया ।\nपुनः स्वनगरं प्राप्य जघान रिपुवाहिनीम्॥ १५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}, {"id": 7004036154, "chapter_id": 24036, "verse_number": "३-३-७-१५५", "content_sanskrit": "दुर्धर्षणं रणे हत्वा शक्त्या गंधर्वसेनया ।\nनिः शेषितारातिबलः प्रविवेश निजं पुरम्॥ १५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 155}, {"id": 7004036155, "chapter_id": 24036, "verse_number": "३-३-७-१५६", "content_sanskrit": "ततोभिषिक्तः सचिवैर्ब्राह्मणैश्च महोत्तमैः ।\nरत्नसिंहासनारूढश्चक्रे राज्यमकण्टकम्॥ १५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 156}, {"id": 7004036156, "chapter_id": 24036, "verse_number": "३-३-७-१५७", "content_sanskrit": "या विप्रवनिता पूर्वं तमपुष्णात्स्वपुत्रवत् ।\nसैव माताभवत्तस्य स भ्राता द्विजनन्दनः॥ १५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 157}, {"id": 7004036157, "chapter_id": 24036, "verse_number": "३-३-७-१५८", "content_sanskrit": "गंधर्वतनया जाया विदर्भनगरेश्वरः ।\nआराध्य देवं गिरिशं धर्मगुप्तो नृपोऽभवत्॥ १५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 158}, {"id": 7004036158, "chapter_id": 24036, "verse_number": "३-३-७-१५९", "content_sanskrit": "एवमन्ये समाराध्य प्रदोषे गिरिजापतिम् ।\nलभंतेभीप्सितान्कामान्देहांते तु परां गतिम्॥ १६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 159}, {"id": 7004036159, "chapter_id": 24036, "verse_number": "३-३-७-१६०", "content_sanskrit": "सूत उवाच ।\nएतन्महाव्रतं पुण्यं प्रदोषे शंकरार्चनम् ।\nधर्मार्थकाममोक्षाणां यदेतत्साधनं परम्॥ १६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 160}, {"id": 7004036160, "chapter_id": 24036, "verse_number": "३-३-७-१६१", "content_sanskrit": "य एतच्छृणुयात्पुण्यं माहात्म्यं परमाद्भुतम् ।\nप्रदोषे शिवपूजांते कथयेद्वा समाहितः॥ १६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 161}, {"id": 7004036161, "chapter_id": 24036, "verse_number": "३-३-७-१६२", "content_sanskrit": "भवेन्न तस्य दारिद्र्यं जन्मान्तरशतेष्वपि ।\nज्ञानैश्वर्यसमायुक्तः सोन्ते शिवपुरं व्रजेत्॥ १६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 162}, {"id": 7004036162, "chapter_id": 24036, "verse_number": "३-३-७-१६३", "content_sanskrit": "ये प्राप्य दुर्लभतरं मनुजाः शरीरं कुर्वंति हंत परमेश्वरपादपूजाम् ।\nधन्यास्त एव निजपुण्यजितत्रिलोकास्तेषां पदांबुजरजो भुवनं पुनाति॥ १६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 163}]