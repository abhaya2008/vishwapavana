[{"id": 7006456000, "chapter_id": 26456, "verse_number": "२-११७-१", "content_sanskrit": "वैशम्पायन उवाच\nक्रीडाविहारोपगतः कदाचिदभवद् भवः ।\nदेव्या सह नदीतीरे रम्ये श्रीमति स प्रभुः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006456001, "chapter_id": 26456, "verse_number": "२-११७-२", "content_sanskrit": "शतानि तत्राप्सरसां चिक्रीडुश्च समन्ततः ।\nसर्वर्तुकवने रम्ये गन्धर्वपतयस्तथा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006456002, "chapter_id": 26456, "verse_number": "२-११७-३", "content_sanskrit": "कुसुमैः पारिजातस्य पुष्पैः संतानकस्य च ।\nगन्धोद्दाममिवाकाशं नदीतीरं तु सर्वशः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006456003, "chapter_id": 26456, "verse_number": "२-११७-४", "content_sanskrit": "वेणुवीणामृदङ्गैश्च पणवैश्च सहस्रशः ।\nवाद्यमानैः स शुश्राव गीतमप्सरसां तदा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006456004, "chapter_id": 26456, "verse_number": "२-११७-५", "content_sanskrit": "सूतमागधकल्पैश्चास्तुवन्नप्सरसां गणाः ।\nदेवदेवं सुवपुषं स्रग्विणं रक्तवाससम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006456005, "chapter_id": 26456, "verse_number": "२-११७-६", "content_sanskrit": "श्रीमहेशं देवदेवमर्चयन्ति मनोरमम् ।\nततस्तु देव्या रूपेण चित्रलेखा वराप्सराः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006456006, "chapter_id": 26456, "verse_number": "२-११७-७", "content_sanskrit": "भवं प्रसादयामास देवी च प्राहसत् तदा ।\nप्रसादयन्तीमीशानं प्रहसन्त्यप्सरोगणाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006456007, "chapter_id": 26456, "verse_number": "२-११७-८", "content_sanskrit": "भवस्य पार्षदा दिव्या नानारूपा महौजसः ।\nदेव्या ह्यनुज्ञया सर्वे क्रीडन्ते तत्र तत्र ह ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006456008, "chapter_id": 26456, "verse_number": "२-११७-९", "content_sanskrit": "अथ ते पार्षदास्तत्र रहस्ये सुविपश्चितः ।\nमहादेवस्य रूपेण तच्चिह्नं रूपमास्थिताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006456009, "chapter_id": 26456, "verse_number": "२-११७-१०", "content_sanskrit": "ततो देव्याः सुरूपेण लीलया वदनेन च ।\nदेवी प्रहासं मुमुचे ताश्चैवाप्सरसस्तदा ।\nततः किलकिलाशब्दः प्रादुर्भूतः समन्ततः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006456010, "chapter_id": 26456, "verse_number": "२-११७-११", "content_sanskrit": "प्रहर्षमतुलं लेभे भवः प्रीतमनास्तदा ।\nबाणस्य दुहिता कन्या तत्रोषा नाम भामिनी ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006456011, "chapter_id": 26456, "verse_number": "२-११७-१२", "content_sanskrit": "देवं संक्रीडितं दृष्ट्वा देव्या सह नदीगतम् ।\nदीप्यमानं महादेवं द्वादशादित्यतेजसम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006456012, "chapter_id": 26456, "verse_number": "२-११७-१३", "content_sanskrit": "नानारूपं वपुः कृत्वा देव्याः प्रियचिकीर्षया ।\nउषा मनोरथं चक्रे पार्वत्याः संनिधौ तथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006456013, "chapter_id": 26456, "verse_number": "२-११७-१४", "content_sanskrit": "धन्या हि भर्तृसहिता रमत्येवं समागता ।\nमनसा त्वथ संकल्पमुषया भाषितं तथा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006456014, "chapter_id": 26456, "verse_number": "२-११७-१५", "content_sanskrit": "विज्ञाय तमभिप्रायमुषायाः पर्वतात्मजा ।\nप्राह देवी ततो वाक्यमुषां हर्षयती शनैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006456015, "chapter_id": 26456, "verse_number": "२-११७-१६", "content_sanskrit": "उषे त्वं शीघ्रमप्येवं भर्त्रा सह रमिष्यसि ।\nयथा देवो मया सार्धं शङ्करः शत्रुनाशनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006456016, "chapter_id": 26456, "verse_number": "२-११७-१७", "content_sanskrit": "एवमुक्ते तदा देव्या वाक्ये चिन्ताविलेक्षणा ।\nउषा भावं तदा चक्रे भर्त्रा रंस्ये कदा सह ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006456017, "chapter_id": 26456, "verse_number": "२-११७-१८", "content_sanskrit": "तदा हैमवती वाक्यं सम्प्रहस्येदमब्रवीत् ।\nउषे शृणुष्व वाक्यं मे यदा संयोगमेष्यसि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006456018, "chapter_id": 26456, "verse_number": "२-११७-१९", "content_sanskrit": "वैशाखे मासि हर्म्यस्थां द्वादश्यां त्वां दिनक्षये ।\nरमयिष्यति यः स्वप्ने स ते भर्ता भविष्यति ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006456019, "chapter_id": 26456, "verse_number": "२-११७-२०", "content_sanskrit": "एवमुक्ता दैत्यसुता कन्यागणसमावृता ।\nअपाक्रामत हर्षेण रममाणा यथासुखम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006456020, "chapter_id": 26456, "verse_number": "२-११७-२१", "content_sanskrit": "ततः सखीभिर्हास्यन्ती हर्षेणोत्फुल्ललोचना ।\nतालिकासंनिपातैश्च ह्यन्योन्यं जघ्नुरूर्जिताः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006456021, "chapter_id": 26456, "verse_number": "२-११७-२२", "content_sanskrit": "किन्नर्यो यक्षकन्याश्च नानादैतेयकन्यकाः ।\nअप्सरोगणकन्याश्च उषायाः सखितां गताः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006456022, "chapter_id": 26456, "verse_number": "२-११७-२३", "content_sanskrit": "उक्ता च तत्र ताभिश्च भर्ता तव वरानने ।\nभविष्यत्यचिरेणेव देव्या वचनकल्पितः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006456023, "chapter_id": 26456, "verse_number": "२-११७-२४", "content_sanskrit": "न हि देव्या वचो मिथ्या भविष्यति कदाचन ।\nरूपाभिजनसम्पन्नः पतिस्ते कल्पितस्तया ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006456024, "chapter_id": 26456, "verse_number": "२-११७-२५", "content_sanskrit": "उषा सखीनां तद् वाक्यं प्रतिपूज्य यथाविधि ।\nदत्तं मनोरथं देव्या भावयन्ती व्यवस्थिता ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006456025, "chapter_id": 26456, "verse_number": "२-११७-२६", "content_sanskrit": "ततः क्रीडाविहारं तमनुभूय सहोमया ।\nगतेऽहनि ततः सर्वा नार्यस्ताः परमाद्भुताः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006456026, "chapter_id": 26456, "verse_number": "२-११७-२७", "content_sanskrit": "ययुः स्वानालयान् सर्वा देवी चादर्शनं गता ।\nकाश्चिदश्वैस्तथा यानैर्गजैरन्यास्तथा रथैः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006456027, "chapter_id": 26456, "verse_number": "२-११७-२८", "content_sanskrit": "पुरं प्रविविशुर्हृष्टाः काश्चिदाकाशमास्थिताः ।\nततः प्रभृति सा देवी काममोहं गता विभो ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006456028, "chapter_id": 26456, "verse_number": "२-११७-२९", "content_sanskrit": "देव्यास्तु वचनं स्मृत्वा संस्मरन्ती पतिं तदा ।\nनिद्रां न भजते रात्रौ न दिवा भोजनं तथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006456029, "chapter_id": 26456, "verse_number": "२-११७-३०", "content_sanskrit": "स्मरन्ती पतिभावं सा विललाप नृपात्मजा ।\nनिन्दन्ती शशिनं नाके सेवती न च चन्दनम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006456030, "chapter_id": 26456, "verse_number": "२-११७-३१", "content_sanskrit": "सा बाला मोहिता राजन् कामेन परिपीडिता ।\nउपचर्यन्ति तां सख्यो विज्वरामपि सज्वराम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006456031, "chapter_id": 26456, "verse_number": "२-११७-३२", "content_sanskrit": "तप्यते हृदयं तस्या लेपितं चन्दनेन च ।\nकपोले पाण्डिमाचिह्नं नेत्रे जलसमन्विते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006456032, "chapter_id": 26456, "verse_number": "२-११७-३३", "content_sanskrit": "जम्भणं च तथा स्वापो देहे तस्या व्यवर्धत ।\nपद्मिनीकन्दचूर्णानि शीतलानि मुहुर्मुहुः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006456033, "chapter_id": 26456, "verse_number": "२-११७-३४", "content_sanskrit": "क्षिपन्ति सख्यो हृदये पीडिते मन्मथाग्निना ।\nव्यजनानि प्रकुर्वन्ति पृच्छन्ति च पुनः पुनः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006456034, "chapter_id": 26456, "verse_number": "२-११७-३५", "content_sanskrit": "का व्यथा किं शरीरं ते किमिदं तव भामिनि ।\nकिं तुभ्यं रोचते देवि तदाख्याहि वरानने ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006456035, "chapter_id": 26456, "verse_number": "२-११७-३६", "content_sanskrit": "कस्मादिदं समुत्पन्नं दुःखसाध्यं मनोरमे ।\nत्वन्मनोऽनुगतं वाक्यं वदन्त्येतास्तु सारिकाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006456036, "chapter_id": 26456, "verse_number": "२-११७-३७", "content_sanskrit": "शुका नीलतमाः सुभ्रु पठन्ति हि पुमानिव ।\nप्रह्लादजननं वाक्यं किमर्थं नाद्य भाषसे ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006456037, "chapter_id": 26456, "verse_number": "२-११७-३८", "content_sanskrit": "तव तातो महावीरो देवानामपि दुर्जयः ।\nतस्याग्रे तिष्ठते कोऽपि न भूमौ वरवर्णिनि ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006456038, "chapter_id": 26456, "verse_number": "२-११७-३९", "content_sanskrit": "बलेः पुत्रो महावीरो बाणो हि दुरतिक्रमः ।\nजितामरावतीकं च नगरं शोणिताह्वयम् ।\nयत्र संतिष्ठते दैवः शूलहस्तो महेश्वरः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006456039, "chapter_id": 26456, "verse_number": "२-११७-४०", "content_sanskrit": "पुत्रोऽयमिति जानीहि गिरिजां योऽब्रवीद्धरः ।\nबाणं प्रति महादेवस्तव तातमुषे शृणु ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006456040, "chapter_id": 26456, "verse_number": "२-११७-४१", "content_sanskrit": "का व्यथा ते मुखे स्वेदो नासाग्रे च विराजते ।\nनीहारबिन्दवः पद्मे राजन्ते शरदागमे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006456041, "chapter_id": 26456, "verse_number": "२-११७-४२", "content_sanskrit": "सम्पूर्णचन्द्रप्रतिमं मुखं चन्द्रो यथा घने ।\nन शोभते तु विच्छायं किमर्थं कारणं वद ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006456042, "chapter_id": 26456, "verse_number": "२-११७-४३", "content_sanskrit": "श्वासान् मुञ्चसि बाले त्वं न रतिं यासि भावतः ।\nगृहाण भोजनं दिव्यं यत् ते मनसि वर्तते ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006456043, "chapter_id": 26456, "verse_number": "२-११७-४४", "content_sanskrit": "ताम्बूलं रोचते पूर्वं तत् किमर्थं न गृह्यते ।\nमिष्टानि यानि वस्तूनि दुर्लभानीतरैर्जनैः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006456044, "chapter_id": 26456, "verse_number": "२-११७-४५", "content_sanskrit": "गृहाण देवि उत्तिष्ठ वद पीडां शरीरजाम् ।\nइति कोलाहलं श्रुत्वा उषावेश्मसमुद्भवम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006456045, "chapter_id": 26456, "verse_number": "२-११७-४६", "content_sanskrit": "दासीभिः कीर्तितं तत्र मातुरग्रे पृथक् पृथक् ।\nराजपुत्री यदा देवि समायाता गृहे सती ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006456046, "chapter_id": 26456, "verse_number": "२-११७-४७", "content_sanskrit": "जलक्रीडाविहाराच्च मूकेव परिलक्ष्यते ।\nअतो दासीजना देवि वदामस्त्वां वयं जनाः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006456047, "chapter_id": 26456, "verse_number": "२-११७-४८", "content_sanskrit": "को मोहः किमिदं मौनं कः स्वापो म्लानता कथम् ।\nविचार्य भिषजो देवि दिश्यन्तां कष्टशान्तये ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006456048, "chapter_id": 26456, "verse_number": "२-११७-४९", "content_sanskrit": "शिरीषपुष्पसदृशं यच्छरीरं सुकोमलम् ।\nतत् कथं सहते देवि व्याधिभारं वरानने ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006456049, "chapter_id": 26456, "verse_number": "२-११७-५०", "content_sanskrit": "इति श्रुत्वा तदा देवी सत्वरा हंसगामिनी ।\nप्राप्य देशमुषा यत्र किमिदं कष्टलक्षणम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006456050, "chapter_id": 26456, "verse_number": "२-११७-५१", "content_sanskrit": "पल्लवाकृतिहस्तेन कोमलं तत्करं तदा ।\nस्पृष्ट्वाङ्गुलीरनायासं स्फोटयामास भाविनी ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006456051, "chapter_id": 26456, "verse_number": "२-११७-५२", "content_sanskrit": "किमस्ति तव कल्याणि का व्यथा तव वर्तते ।\nएते वैद्याः समागत्य पृच्छन्ति भवतीं हि तत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006456052, "chapter_id": 26456, "verse_number": "२-११७-५३", "content_sanskrit": "वैद्या ऊचुः\nजलक्रीडां गता तत्र राजपुत्री सखीगणैः ।\nपार्वत्याः क्रीडितं तत्र जानीमः श्रमसम्भवम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006456053, "chapter_id": 26456, "verse_number": "२-११७-५४", "content_sanskrit": "श्रमाद्ग्लानिः समुत्पन्ना जृम्भणं च पुनः पुनः ।\nस्वापश्च जायते तेन मा भयं कर्तुमर्हसि ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006456054, "chapter_id": 26456, "verse_number": "२-११७-५५", "content_sanskrit": "देव्युवाच\nहदये निहितं वैद्याश्चन्दनं हिमसंयुतम् ।\nअमात्याः किमिदं शीघ्रं किमिदं बुद्बुदायते ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006456055, "chapter_id": 26456, "verse_number": "२-११७-५६", "content_sanskrit": "अतिदाहो महान् स्वेदः पिपासा न बुभुक्षते ।\nप्रलाप एव किं तस्यां शास्त्रतो ब्रूत निश्चितम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006456056, "chapter_id": 26456, "verse_number": "२-११७-५७", "content_sanskrit": "वैद्या ऊचुः\nक्रीडाविहारे मिलिताः स्त्रीजना देवसंनिधौ ।\nरूपेणाप्रतिमा देवी राजपुत्री च भाविनी ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006456057, "chapter_id": 26456, "verse_number": "२-११७-५८", "content_sanskrit": "दृष्टिपातः कृतस्ताभिस्तेन पुत्र्यां व्यथाभवत् ।\nरक्षामन्त्रैस्तथा पीतैः सर्षपैस्तां कुमारिकाम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006456058, "chapter_id": 26456, "verse_number": "२-११७-५९", "content_sanskrit": "पानीयैरभिषेकेण परा शान्तिर्भविष्यति ।\nइत्युक्त्वा भिषजः सर्वे निवृत्ता नृपवेश्मतः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006456059, "chapter_id": 26456, "verse_number": "२-११७-६०", "content_sanskrit": "सूचयन्तः पुनः सर्वे कामाभिप्रायजां व्यथाम् ।\nमातृपृष्टा वरारोहा चिरकालमुवाच सा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006456060, "chapter_id": 26456, "verse_number": "२-११७-६१", "content_sanskrit": "लज्जावती महाभागा मातरं रुदती भृशम् ।\nमातर्न रोचते नित्यं भाषणं न च भोजनम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006456061, "chapter_id": 26456, "verse_number": "२-११७-६२", "content_sanskrit": "न चाप्युत्सवकं मातः सदाहं हृदयं शृणु ।\nइत्युक्त्वा विररामाथ ह्युषा नारी वरानना ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006456062, "chapter_id": 26456, "verse_number": "२-११७-६३", "content_sanskrit": "सर्वाभिः स्त्रीभिरारब्धमन्योन्यं मुखवीक्षणम् ।\nलज्जानुकारि नारीणां यौवनं हि भवेदिति ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006456063, "chapter_id": 26456, "verse_number": "२-११७-६४", "content_sanskrit": "इयं च राजकन्या हि भर्तृयोग्या किमुच्यते ।\nपितुः प्रसादान्मातुश्च प्राप्नुयात् सदृशं वरम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]