[{"id": 2021532, "chapter_id": 1445, "verse_number": "३-८३-०x", "content_sanskrit": "पुलस्त्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2021533, "chapter_id": 1445, "verse_number": "३-८३-१", "content_sanskrit": "अथ सन्ध्यां समासाद्य संवेद्ये तीर्थ उत्तमे।\nउपस्पृश्य नरो विद्यां लभते नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2021534, "chapter_id": 1445, "verse_number": "३-८३-२", "content_sanskrit": "रामस्य च प्रसादेन तीर्थं राजन्कृतं पुरा।\nतल्लौहित्यं समासाद्य विन्द्याद्बहु सुवर्णकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2021535, "chapter_id": 1445, "verse_number": "३-८३-३", "content_sanskrit": "करतोयां समासाद्य त्रिरात्रोपोषितो नरः।\nअश्वमेधमवाप्नोति प्रजापतिकृतो विधिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2021536, "chapter_id": 1445, "verse_number": "३-८३-४", "content_sanskrit": "गङ्गायास्तत्र राजेन्द्र सागरस्य च सङ्गमे।\nअश्वमेधं दशगुणं प्रवदन्ति मनीषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2021537, "chapter_id": 1445, "verse_number": "३-८३-५", "content_sanskrit": "गङ्गायास्त्वपरं पारं प्राप्य यः स्नाति मानवः।\nत्रिरात्रमुषितो राजन्सर्वान्कामानवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2021538, "chapter_id": 1445, "verse_number": "३-८३-६", "content_sanskrit": "ततो वैतरणीं गत्वा सर्वपापप्रमोचनीम्।\nविरजातीर्थमासाद्य विराजति यथा शशी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2021539, "chapter_id": 1445, "verse_number": "३-८३-७", "content_sanskrit": "प्रभवेच्च कुले पुण्ये सर्वपापं व्यपोहति।\nगोसहस्रफंल लब्ध्वा रपुनाति स्वकुलं नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2021540, "chapter_id": 1445, "verse_number": "३-८३-८", "content_sanskrit": "शोणस्य ज्योतिरथ्यायाः संगमे नियतः शुचिः।\nतर्पयित्वा पितॄन्देवानग्निष्टोमफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2021541, "chapter_id": 1445, "verse_number": "३-८३-९", "content_sanskrit": "शोणस्य नर्मदायाश् प्रभेदे कुरुनन्दन।\nवंशगुल्म उपस्पृश्य वाचजिमेधफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2021542, "chapter_id": 1445, "verse_number": "३-८३-१०", "content_sanskrit": "वाजपेयमवाप्नोति त्रिरात्रोपोषितो नरः।\nगोसहस्रफलं विन्द्यात्कुलं चैव समुद्धरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2021543, "chapter_id": 1445, "verse_number": "३-८३-११", "content_sanskrit": "कोसलां तु समासाद्य कालतीर्थमुपस्पृशेत्।\nवृषभैकादशफलं लभते नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2021544, "chapter_id": 1445, "verse_number": "३-८३-१२", "content_sanskrit": "पुष्पवत्यामुपस्पृश्य त्रिरात्रोपोषितो नरः।\nगोसहस्रफलं लब्ध्वा पुनाति स्वकुलं नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2021545, "chapter_id": 1445, "verse_number": "३-८३-१३", "content_sanskrit": "ततो बदरिकातीर्थे स्नात्वा भरतसत्तम।\nदीर्घमायुरवाप्नोति स्वर्गलोकं च गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2021546, "chapter_id": 1445, "verse_number": "३-८३-१४", "content_sanskrit": "तथा चम्पां समासाद्य भागीरथ्यां कृतोदकः।\nदण्डाख्यमभिगम्यैव गोसहस्रफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2021547, "chapter_id": 1445, "verse_number": "३-८३-१५", "content_sanskrit": "लपेटिकां ततो गच्छेत्पुण्यां पुण्योपशोभिताम्।\nवाजपेयमवाप्नोति देवैः सर्वैश्च पूज्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2021548, "chapter_id": 1445, "verse_number": "३-८३-१६", "content_sanskrit": "ततो महेन्द्रमासाद्य जामदग्न्यनिपेवितम्।\nरामतीर्थे नरः स्नात्वा वाजिमेधफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2021549, "chapter_id": 1445, "verse_number": "३-८३-१७", "content_sanskrit": "मतङ्गस्य तु केदारस्तत्रैव कुरुनन्दन।\nतत्र स्नात्वा कुरुश्रेष्ठ गोसहस्रफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2021550, "chapter_id": 1445, "verse_number": "३-८३-१८", "content_sanskrit": "श्रीपर्वतं समासाद्य नदीतीरमुपस्पृशेत्।\nरअश्वमेधमवाप्नोति पूजयित्वा वृषध्वजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2021551, "chapter_id": 1445, "verse_number": "३-८३-१९", "content_sanskrit": "श्रीपर्वते महादेवो देव्या सह महाद्युतिः।\nन्यवसत्परमप्रीतो ब्रह्मा च त्रिदशैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2021552, "chapter_id": 1445, "verse_number": "३-८३-२०", "content_sanskrit": "तत्र देवह्रदे स्नात्वा शुचिः प्रयतमानसः।\nअश्वमेधमवाप्नोति कुलं चैव समुद्धरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2021553, "chapter_id": 1445, "verse_number": "३-८३-२१", "content_sanskrit": "ऋषभं पर्वतं गत्वा पाण्ड्येषु नृपपूजितम्।\nवाजपेयमवाप्नोति नाकपृष्ठे च मोदते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2021554, "chapter_id": 1445, "verse_number": "३-८३-२२", "content_sanskrit": "ततो गच्छेत कावेरीं वृतामप्सरसां गणैः।\nतत्रस्नात्वा नरो राजन्गोसहस्रफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2021555, "chapter_id": 1445, "verse_number": "३-८३-२३", "content_sanskrit": "ततस्तीरे समुद्रस्य कन्यातीर्थमुपस्पृशेत्।\nतत्तोयं स्पृश्य राजेन्द्र सर्वपापैः प्रमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2021556, "chapter_id": 1445, "verse_number": "३-८३-२४", "content_sanskrit": "अथ गोकर्णमासाद्य त्रिषु लोकेषु विश्रुतम्।\nसमुद्रमध्ये राजेन्द्र सर्वलोकनमस्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2021557, "chapter_id": 1445, "verse_number": "३-८३-२५", "content_sanskrit": "रयत्र ब्रह्मादयो देवा ऋषयश्च तपोधनाः।\nभूतयक्षपिशाचाश्च किन्नराः समहोरगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2021558, "chapter_id": 1445, "verse_number": "३-८३-२६", "content_sanskrit": "सिद्धचारणगन्धर्वमानुषाः पन्नगास्तथा।\nसरितः सागराः शैला उपासन्त उमापतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2021559, "chapter_id": 1445, "verse_number": "३-८३-२७", "content_sanskrit": "तत्रेशानं समभ्यर्च्य त्रिरात्रोपोषितो नरः।\nअश्वमेधमवाप्नोति गाणपत्यं च विन्दति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2021560, "chapter_id": 1445, "verse_number": "३-८३-२८", "content_sanskrit": "उष्य द्वादशरात्रं तु पूतात्मा च भवेन्नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2021561, "chapter_id": 1445, "verse_number": "३-८३-२९", "content_sanskrit": "तत एव च गायत्र्याः स्थानं त्रैलोक्यपूजितम्।\nत्रिरात्रमुषितस्तत्र गोसहस्रफलं लभेत्।\nनिदर्शनं च प्रत्यक्षं ब्राह्मणानां नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2021562, "chapter_id": 1445, "verse_number": "३-८३-३०", "content_sanskrit": "गायत्रीं पठते यस्तु योनिसंकरजस्तथा।\nगाथा च गाथिका चापि तस्य संपद्यते नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2021563, "chapter_id": 1445, "verse_number": "३-८३-३१", "content_sanskrit": "अब्राह्मणस्य सावित्रीं पठतस्तु प्रणश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2021564, "chapter_id": 1445, "verse_number": "३-८३-३२", "content_sanskrit": "संवर्तस्य तु विप्रर्षेर्वापीमासाद्य दुर्लभाम्।\nरूपस्य भागी भवति सुभगश्च प्रजायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2021565, "chapter_id": 1445, "verse_number": "३-८३-३३", "content_sanskrit": "ततो वेणां समासाद्य त्रिरात्रोपोषितो नरः।\nमयूरहंससंयुक्तं विमानं लभते नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2021566, "chapter_id": 1445, "verse_number": "३-८३-३४", "content_sanskrit": "ततो गोदावरीं प्राप्य नित्यं सिद्धनिषेविताम्।\nगवां मेधमवाप्नोति वासुकेर्लोकमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2021567, "chapter_id": 1445, "verse_number": "३-८३-३५", "content_sanskrit": "वेणायाः संगमे स्नात्वा वाजिमेधफलं लभेत्।\nवरदासंगमे स्नात्वा गोसहस्रफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2021568, "chapter_id": 1445, "verse_number": "३-८३-३६", "content_sanskrit": "ब्रह्मस्थानं समासाद्य त्रिरात्रोपोषितो नरः।\nगोसहस्रफलं विन्द्यात्स्वर्गलोकं च गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2021569, "chapter_id": 1445, "verse_number": "३-८३-३७", "content_sanskrit": "कुशप्लवनमासाद्य ब्रह्मचारी समाहितः।\nत्रिरात्रमुषितः स्नात्वा अश्वमेधफंल लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2021570, "chapter_id": 1445, "verse_number": "३-८३-३८", "content_sanskrit": "ततो देवह्रदेऽरण्ये कृष्णवेणाजलोद्भवे।\nजातिस्मरह्रदे स्नात्वा भवेज्जातिस्मरो नरः।\nयत्र क्रतुशतैरिष्ट्वा देवराजो दिवं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2021571, "chapter_id": 1445, "verse_number": "३-८३-३९", "content_sanskrit": "अग्निष्टोमफलं विन्द्याद्गमनादेव भारत।\nततः सर्वह्रदे स्नात्वा गोसहस्रफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2021572, "chapter_id": 1445, "verse_number": "३-८३-४०", "content_sanskrit": "ततो वापीं महापुण्यां पयोष्णीं सरितां वराम्।\nपितृदेवार्चनरतो गोसहस्रफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2021573, "chapter_id": 1445, "verse_number": "३-८३-४१", "content_sanskrit": "दण्डकारण्यमासाद्य पुण्यं राजन्नुपस्पृशेत्।\nगोसहस्रफलं तस्य स्नातमात्रस्य भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2021574, "chapter_id": 1445, "verse_number": "३-८३-४२", "content_sanskrit": "शरभङ्गाश्रमं गत्वा शुकस्य च महात्मनः।\nन दुर्गतिमवाप्नोति पुनाति च कुलं नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2021575, "chapter_id": 1445, "verse_number": "३-८३-४३", "content_sanskrit": "ततः शूर्पारकं गच्छेज्जामदग्न्यनिषेवितम्।\nरामतीर्थे नरः स्नात्वा विन्द्याद्बहु सुवर्णकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2021576, "chapter_id": 1445, "verse_number": "३-८३-४४", "content_sanskrit": "सप्तगोदावरे स्नात्वा नियतो नियताशनः।\nमहत्पुण्यमवाप्नोति देवलोकं च गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2021577, "chapter_id": 1445, "verse_number": "३-८३-४५", "content_sanskrit": "ततो देवपथं गत्वा नियतो नियताशनः।\nदेवसत्रस्य यत्पुण्यं तदेवाप्नोति मानवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2021578, "chapter_id": 1445, "verse_number": "३-८३-४६", "content_sanskrit": "तुङ्गकारण्यमासाद्य ब्र्हमचारी जितेन्द्रियः।\nवेदानध्यापयत्तत्र ऋषिः सारस्वतः पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2021579, "chapter_id": 1445, "verse_number": "३-८३-४७", "content_sanskrit": "तत्र वेदेषु नष्टेषु मुनेरङ्गिरसः सुतः।\nऋषीणआमुत्तरीयेषु सूपविष्टो यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2021580, "chapter_id": 1445, "verse_number": "३-८३-४८", "content_sanskrit": "ओंकारेण यथान्यायं सम्यगुच्चारितेन ह।\nयेन यत्पूर्वमभ्यस्तं तत्सर्वं समुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2021581, "chapter_id": 1445, "verse_number": "३-८३-४९", "content_sanskrit": "ऋषयस्तत्र देवाश्च वरुणोऽग्निः प्रजापतिः।\nहरिर्नारायणस्तत्र महादेवस्तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2021582, "chapter_id": 1445, "verse_number": "३-८३-५०", "content_sanskrit": "पितामहश्च भगवान्देवैः सह महाद्युतिः।\nभृगुं नियोजयामास याजनार्थे महाद्युतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2021583, "chapter_id": 1445, "verse_number": "३-८३-५१", "content_sanskrit": "ततः स चक्रे भगवानृषीणां विधिवत्तदा।\nसर्वेषां पुनराधानं विधिदृष्टेन कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2021584, "chapter_id": 1445, "verse_number": "३-८३-५२", "content_sanskrit": "आज्यभागेन तत्राग्नीं तर्पयित्वा यथाविधि।\nदेवाः स्वभवनं याता ऋषयश्च यथाक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2021585, "chapter_id": 1445, "verse_number": "३-८३-५३", "content_sanskrit": "तदरण्यं प्रविष्टस्य तुङ्गकं राजसत्तम।\nपापं प्रणश्यत्यखिलं स्त्रिया वा पुरुषस्य वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2021586, "chapter_id": 1445, "verse_number": "३-८३-५४", "content_sanskrit": "तत्रमासं वसेद्धीरो नियतो नियताशनः।\nब्रह्मलोकं व्रजेद्राजन्कुलं चैव समुद्धरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2021587, "chapter_id": 1445, "verse_number": "३-८३-५५", "content_sanskrit": "मेधाविकं समासाद्य पितॄन्देवांश्च तर्पयेत्।\nअग्निष्टोममवाप्नोति स्मृतिं मेधां च विन्दति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2021588, "chapter_id": 1445, "verse_number": "३-८३-५६", "content_sanskrit": "अत्र कालञ्चरं गत्वा पर्वतं लोकविश्रुतम्।\nतत्र देवह्रदे स्नात्वा गोसहस्रफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2021589, "chapter_id": 1445, "verse_number": "३-८३-५७", "content_sanskrit": "आत्मानं स्नापयेत्तत्रगिरौ कालञ्जरे नृप।\nस्वर्गलोके महीयेत नरो नास्त्यत्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2021590, "chapter_id": 1445, "verse_number": "३-८३-५८", "content_sanskrit": "ततो गिरिवरश्रेष्ठे चित्रकूटे विशांपते।\nमन्दाकिनीं समासाद्य सर्वपापप्रणाशिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2021591, "chapter_id": 1445, "verse_number": "३-८३-५९", "content_sanskrit": "तत्राभिषेकं कुर्वाणः पितृदेवार्चने रतः।\nअश्वमेधमवाप्नोति गतिं च परमां व्रजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2021592, "chapter_id": 1445, "verse_number": "३-८३-६०", "content_sanskrit": "ततो गच्छेत धर्मज्ञ भर्तृस्थानमनुत्तमम्।\nयत्र नित्यं महासेनो गुहः सन्निहितो नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2021593, "chapter_id": 1445, "verse_number": "३-८३-६१", "content_sanskrit": "तत्र गत्वा नृपश्रेष्ठ गमनादेव सिध्यति।\nकोटितीर्थे नरः स्नात्वा गोसहस्रफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2021594, "chapter_id": 1445, "verse_number": "३-८३-६२", "content_sanskrit": "प्रदक्षिणमुपावृत्य ज्येष्ठस्थानं व्रजेन्नरः।\nअभिगम्य महादेवं विराजति यथा शशी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2021595, "chapter_id": 1445, "verse_number": "३-८३-६३", "content_sanskrit": "तत्र कूपे महाराज विश्रुता भरतर्षभ।\nसमुद्रास्तत्र चत्वारो निवसन्ति युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2021596, "chapter_id": 1445, "verse_number": "३-८३-६४", "content_sanskrit": "तत्रोपस्पृश्य राजेन्द्र पितृदेवार्चने रतः।\nनियतात्मा नरः पूतो गच्छेत परमां गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2021597, "chapter_id": 1445, "verse_number": "३-८३-६५", "content_sanskrit": "ततो गच्छेत राजेन्द्र शृङ्गबेरपुरं महत्।\nयत्रतीर्णो महाराज रामो दाशरथिः पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2021598, "chapter_id": 1445, "verse_number": "३-८३-६६", "content_sanskrit": "रकतस्मिंस्तीर्थे महाबाहो स्नात्वा पापैः प्रमुच्यते।\nगङ्गायां तु नरः स्नात्वा ब्रह्मचारी समाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2021599, "chapter_id": 1445, "verse_number": "३-८३-६७", "content_sanskrit": "विधूतपाप्मा भवति वाजपेयं च विन्दति।\nततो मुञ्जवटं गच्छेत्स्थानं देवस्य धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2021600, "chapter_id": 1445, "verse_number": "३-८३-६८", "content_sanskrit": "अभिगम्य महादेवमभिवाद्य च भारत।\nप्रदक्षिणमुपावृत् यगाणपत्यमवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2021601, "chapter_id": 1445, "verse_number": "३-८३-६९", "content_sanskrit": "तस्मिंस्तीर्थे तु जाह्नव्यां स्नात्वा पापैः प्रमुच्यते।\nततो गच्छेत राजेन्द्र प्रयागमृषिसंस्तुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2021602, "chapter_id": 1445, "verse_number": "३-८३-७०", "content_sanskrit": "यत्र ब्रह्मादयो देवा दिशश्च सदिगीश्वराः।\nलोकपालाश्च साध्याश्च पितरो लोकसंमताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2021603, "chapter_id": 1445, "verse_number": "३-८३-७१", "content_sanskrit": "सनत्कुमारप्रमुखास्तथैव परमर्षयः।\nअङ्गिरःप्रमुखाश्चैव तथा ब्रह्मर्षयोऽमलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2021604, "chapter_id": 1445, "verse_number": "३-८३-७२", "content_sanskrit": "तथा नागाः सुपर्णश्च सिद्धाश्चक्रचरास्तथा।\nसरितः सागराश्चैव गन्धर्वाप्सरसोऽपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2021605, "chapter_id": 1445, "verse_number": "३-८३-७३", "content_sanskrit": "हरिश्च भगवानास्ते प्रजापतिपुरस्कृतः।\nतत्र त्रीण्यग्निकुण्डानि येषां मध्येन जाह्नवी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2021606, "chapter_id": 1445, "verse_number": "३-८३-७४", "content_sanskrit": "प्रयागादभिनिष्क्रान्ता सर्वतीर्थपुरस्कृता।\nतपनस्य सुता देवी त्रिषु लोकेषु विश्रुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2021607, "chapter_id": 1445, "verse_number": "३-८३-७५", "content_sanskrit": "यमुना गङ्गया सार्धं संगता लोकपावनी।\nगङ्गायमुनयोर्मध्यं पृथिव्या जघनं स्मृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2021608, "chapter_id": 1445, "verse_number": "३-८३-७६", "content_sanskrit": "प्रयागं जघनस्थानमुपस्थमृषयो विदुः।\nप्रयागं सप्रतिष्ठानं कम्बलाश्वतरौ तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2021609, "chapter_id": 1445, "verse_number": "३-८३-७७", "content_sanskrit": "तीर्थं भोगवती चैव वेदिरेषा प्रजापतेः।\nतत्रवेदाश्च यज्ञाश्च मूर्तिमन्तो युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2021610, "chapter_id": 1445, "verse_number": "३-८३-७८", "content_sanskrit": "प्रजापतिमुपासन्ते ऋषयश्च तपोधनाः।\nयजन्ते क्रतुभिर्देवास्तथा चक्रधरा नृपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2021611, "chapter_id": 1445, "verse_number": "३-८३-७९", "content_sanskrit": "ततः पुण्यतमं नाम त्रिषु लोकेषु भारत।\nप्रयागं सर्वतीर्थेभ्यः प्रवदन्त्यधिकं विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2021612, "chapter_id": 1445, "verse_number": "३-८३-८०", "content_sanskrit": "श्रवणात्तस्य तीर्थस् नामसंकीर्तनादपि।\nमृत्युकालभयाच्चापि नरः पापात्प्रमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2021613, "chapter_id": 1445, "verse_number": "३-८३-८१", "content_sanskrit": "तत्राभिषेकं यः कुर्यात्संगमे लोकविश्रुते।\nपुण्यं स फलमाप्नोति राजसूयाश्वमेधयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2021614, "chapter_id": 1445, "verse_number": "३-८३-८२", "content_sanskrit": "एषा यजनभूमिर्हि देवानामभिसंस्कृता।\nतत्र रदत्तं सूक्ष्ममपि महद्भवति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2021615, "chapter_id": 1445, "verse_number": "३-८३-८३", "content_sanskrit": "न वेदवचनात्तात न लोकवचनादपि।\nमतिरुत्क्रमणीया ते प्रयागमरणं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2021616, "chapter_id": 1445, "verse_number": "३-८३-८४", "content_sanskrit": "दशतीर्तसहस्राणि षष्टिः कोट्यस्तथाऽपराः।\nयेषां सान्निध्यमत्रैव कीर्तितं कुरुन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2021617, "chapter_id": 1445, "verse_number": "३-८३-८५", "content_sanskrit": "चतुर्विद्ये च यत्पुण्यं सत्यवादिषु चैव यत्।\nस्नात एव तदाप्नोति गङ्गायमुनसंगमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2021618, "chapter_id": 1445, "verse_number": "३-८३-८६", "content_sanskrit": "तत्र भोगवती नाम वासुकेस्तीर्थमुत्तमम्।\nतत्राभिषेकं यः कुर्यात्सोऽश्वमेधफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2021619, "chapter_id": 1445, "verse_number": "३-८३-८७", "content_sanskrit": "तत्र हंसप्रपतनं तीर्थं त्रैलोक्यविश्रुतम्।\nदशाश्वमेधिकं चैव गङ्गायां कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2021620, "chapter_id": 1445, "verse_number": "३-८३-८८", "content_sanskrit": "कुरुक्षेत्रसमा गङ्गा यत्रतत्रावगाहिता।\nविशेषो वै कनखले प्रयागे परमं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2021621, "chapter_id": 1445, "verse_number": "३-८३-८९", "content_sanskrit": "यद्यकार्यशतं कृत्वा कृतंगङ्गावसेचनम्।\nसर्वं तत्तस्य गङ्गापो दहत्यग्निरिवेन्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2021622, "chapter_id": 1445, "verse_number": "३-८३-९०", "content_sanskrit": "सर्वं कृतयुगे पुण्यंत्रेतायां पुष्करं स्मृतम्।\nद्वापरेऽपि कुरुक्षेत्रं गङ्गा कलियुगे स्मृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2021623, "chapter_id": 1445, "verse_number": "३-८३-९१", "content_sanskrit": "पुष्करे तु तपस्तप्येद्दानं दद्यान्महालये।\nमलये त्वग्निमारोहेद्भृगुतुन्दे त्वनाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2021624, "chapter_id": 1445, "verse_number": "३-८३-९२", "content_sanskrit": "पुष्करे तु कुरुक्षेत्रे रगङ्गायां मगधेषु च।\nस्नात्वा तारयते जन्तुः सप्तसप्तावरांस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2021625, "chapter_id": 1445, "verse_number": "३-८३-९३", "content_sanskrit": "पुनाति कीर्तिता पापं दृष्टा भद्रं प्रयच्छति।\nअवगाढा च पीता च पुनात्यासप्तमं कुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2021626, "chapter_id": 1445, "verse_number": "३-८३-९४", "content_sanskrit": "यावदस्थि मनुष्यस् गङ्गायाः स्पृशते जलम्।\nतावत्स पुरुषो राजन्स्वर्गलोके महीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2021627, "chapter_id": 1445, "verse_number": "३-८३-९५", "content_sanskrit": "यथा पुण्यानि तीर्थानि पुण्यान्यायतनानि च।\nउपास्य पुण्यं लब्ध्वा च भवत्यमरलोकभाक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2021628, "chapter_id": 1445, "verse_number": "३-८३-९६", "content_sanskrit": "न गङ्गासदृशं तीर्थं न देवः केशवात्परः।\nब्राह्मणेभ्यः परं नास्ति एवमाह पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2021629, "chapter_id": 1445, "verse_number": "३-८३-९७", "content_sanskrit": "यत्र गङ्गा महाराज स देशस्तत्तपोकवनम्।\nसिद्धिक्षेत्रं च तज्ज्ञेयं गङ्गातीरसमाश्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2021630, "chapter_id": 1445, "verse_number": "३-८३-९८", "content_sanskrit": "इदं सत्यंद्विजातीनां साधूनामात्मनोपि च।\nसुहृदां च जपेत्कर्मे शिष्यस्यानुगतस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2021631, "chapter_id": 1445, "verse_number": "३-८३-९९", "content_sanskrit": "इदं धन्यमिदं मेध्यमिदं स्वर्ग्यमिदं सुखम्।\nइदं पुण्यमिदं रम्यं पावनं धर्म्यमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2021632, "chapter_id": 1445, "verse_number": "३-८३-१००", "content_sanskrit": "महर्षीणामिदं गुह्यं सर्वपापप्रमोचनम्।\nअधीत्यद्विजमध्ये च निर्मलः स्वर्गमाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2021633, "chapter_id": 1445, "verse_number": "३-८३-१०१", "content_sanskrit": "श्रीमत्स्वर्ग्यं तथा पुण्यं सपत्नशमनं शिवम्।\nमेधाजननमग्र्यं वै तीर्थवंशानुकीर्तनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2021634, "chapter_id": 1445, "verse_number": "३-८३-१०२", "content_sanskrit": "अपुत्रो लभते पुत्रमधनो धनमाप्नुयात्।\nशूद्रो यथेप्सितान्कामान्ब्राह्मणः पारगः पठन्।\nमहीं विजयते राजा वैश्यो धनमवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2021635, "chapter_id": 1445, "verse_number": "३-८३-१०३", "content_sanskrit": "यश्चेदं शृणुयान्नित्यं तीर्थपुण्यं नरः शुचिः।\nजातीः स स्मरते बह्वीर्नाकपृष्ठे च मोदते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2021636, "chapter_id": 1445, "verse_number": "३-८३-१०४", "content_sanskrit": "गम्यान्यपि च तीर्थानि कीर्तितान्यगमानि च।\nमनसा तानि गच्छेत सर्वतीर्थसमीक्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2021637, "chapter_id": 1445, "verse_number": "३-८३-१०५", "content_sanskrit": "एतानि वसुभिः साध्यैरादित्यैर्मरुदश्विभिः।\nऋषिभिर्देवकल्पैश्च स्नातानि सुकृतैषिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2021638, "chapter_id": 1445, "verse_number": "३-८३-१०६", "content_sanskrit": "एवं त्वमपि कौरव्य विधिनाऽनेन सुव्रत।\nव्रत तीर्थानि नियतः पुण्यं पुण्येन वर्धयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2021639, "chapter_id": 1445, "verse_number": "३-८३-१०७", "content_sanskrit": "भाषितैः करणैः पूर्वमास्तिक्याच्छ्रुतिदर्शनात्।\nप्राप्यन्ते तानि तीर्तानि सद्भिः शास्त्रार्थदर्शिभिः।\nसद्भिः शास्त्रार्थतत्वज्ञैर्ब्राह्मणैः सह गम्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2021640, "chapter_id": 1445, "verse_number": "३-८३-१०८", "content_sanskrit": "नाव्रती नाकृतात्मा च नाशुचिर्न च तस्करः।\nस्नाति तीर्थेषु कौरव्य न च वक्रमतिर्नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2021641, "chapter_id": 1445, "verse_number": "३-८३-१०९", "content_sanskrit": "त्वया तु सम्यग्वृत्तेन नित्यं धर्मार्थदर्शिना।\n`पितरस्तात सर्वे च तारिताः प्रपितामहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2021642, "chapter_id": 1445, "verse_number": "३-८३-११०", "content_sanskrit": "पिता पितामहस्चैव सर्वे च प्रपितामहाः।\nपितामहपुरोगाश्च देवाः सर्षिगणा नृप।\nतव धर्मेण धर्मज्ञ नित्यमेवाभितोषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2021643, "chapter_id": 1445, "verse_number": "३-८३-१११", "content_sanskrit": "अवाप्स्यसि त्वं लोकान्वै वसूनां वासवोपम।\nकीर्तिं च महातीं भीष्म प्राप्स्यसे भुविशाश्वतीं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2021644, "chapter_id": 1445, "verse_number": "३-८३-११२x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2021645, "chapter_id": 1445, "verse_number": "३-८३-११२", "content_sanskrit": "एवमुक्त्वाऽभ्यनुज्ञाय पुलस्त्यो भगवानृषिः।\nप्रीतः प्रीतेन मनसा तत्रैवान्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2021646, "chapter_id": 1445, "verse_number": "३-८३-११३", "content_sanskrit": "भीष्मश्च कुरुशार्दूल शास्त्रतत्त्वार्थदर्शिवान्।\nपुलस्त्यवचनाच्चैव पृथिवीं परिचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2021647, "chapter_id": 1445, "verse_number": "३-८३-११४", "content_sanskrit": "एवमेषा महाभागा प्रतिष्ठाने प्रतिष्ठिता।\nतीर्थयात्रा महापुण्या सर्वपापप्रमोचनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2021648, "chapter_id": 1445, "verse_number": "३-८३-११५", "content_sanskrit": "अनेन विधिना यस्तु पृथिवीं संचरिष्यति।\nअश्वमेधशतं साग्रं फलं प्रेत्य स भोक्ष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2021649, "chapter_id": 1445, "verse_number": "३-८३-११६", "content_sanskrit": "ततश्चाष्टगुणं पार्थ प्राप्स्यसे धर्ममुत्तमम्।\nभीष्मः कुरूणां प्रवरो यथा पूर्वमवाप्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2021650, "chapter_id": 1445, "verse_number": "३-८३-११७", "content_sanskrit": "नेता च त्वमृषीन्यस्मात्तेन तेऽष्टगुणं फलम्।\nरक्षोगणबिकीर्णानि तीर्थान्येतानि भारत।\nअगम्यानि मनुष्येन्द्रैस्त्वामृते कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2021651, "chapter_id": 1445, "verse_number": "३-८३-११८", "content_sanskrit": "इदं देवर्षिचरितं सर्वतीर्ताभिसंवृतम्।\nयः पठेच्छृणुयाद्वाऽपिसर्वपापैः प्रमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2021652, "chapter_id": 1445, "verse_number": "३-८३-११९", "content_sanskrit": "ऋषिमुख्याः सदा यत्रवाल्मीकिस्त्वथ कश्यपः।\nआत्रेयः कुण्डजठरो विश्वामित्रोऽथ गौतमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2021653, "chapter_id": 1445, "verse_number": "३-८३-१२०", "content_sanskrit": "असितो देवलश्चैव मार्कण्डेयोऽथ गालवः।\nभरद्वाजो वसिष्ठश्च मुनिरुद्दालकस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2021654, "chapter_id": 1445, "verse_number": "३-८३-१२१", "content_sanskrit": "शौनकः सह पुत्रेण व्यासश्च तपतांवरः।\nदुर्वासाश्च मुनिश्रेष्ठो जाबालिश्च महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2021655, "chapter_id": 1445, "verse_number": "३-८३-१२२", "content_sanskrit": "एते ऋषिवराः सर्वे त्वत्प्रतीक्षास्तपोधनाः।\nएभिः सह महाराज तीर्थान्येतान्यनुव्रज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2021656, "chapter_id": 1445, "verse_number": "३-८३-१२३", "content_sanskrit": "एष ते लोमशो नाम महर्षिरमितद्युतिः।\nसमेष्यति महाराज तेन सार्धमनुव्रज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2021657, "chapter_id": 1445, "verse_number": "३-८३-१२४", "content_sanskrit": "मयाऽपिसह धर्मज्ञ तीर्थान्येतान्यनुक्रमात्। ३-८३-b१२४ प्राप्स्यसे महतीं कीर्तिं यथा राजा महाभिषक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2021658, "chapter_id": 1445, "verse_number": "३-८३-१२५", "content_sanskrit": "यथा ययातिर्धर्मात्मा यथा राजा पुरूरवाः।\nतथा त्वं कुरुशार्दूल स्वेन धर्मेण शोभसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2021659, "chapter_id": 1445, "verse_number": "३-८३-१२६", "content_sanskrit": "यथा भगीरथो राजा यथा रामश्च विश्रुतः।\nतथा त्वं सर्वराजभ्यो भ्राजसे रश्मिवानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2021660, "chapter_id": 1445, "verse_number": "३-८३-१२७", "content_sanskrit": "यथा मनुर्यथेक्ष्वाकुर्यथा पूरुर्महायशाः।\nयथा वैन्यो महाराज तथा त्वमपि विश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2021661, "chapter_id": 1445, "verse_number": "३-८३-१२८", "content_sanskrit": "यथा च वृत्रहा सर्वान्सपत्नान्निर्दहन्पुरा।\nत्रैलोक्यं पालयामास देवराड्विगतज्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2021662, "chapter_id": 1445, "verse_number": "३-८३-१२९", "content_sanskrit": "तथा शत्रुक्षयं कृत्वा त्वं प्रजाः पालयिष्यसि।\nस्वधर्मविजितामुर्वीं प्राप्य राजीवलोचन।\nख्यातिं यास्यसि धर्मेण कार्तवीर्यार्जुनो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2021663, "chapter_id": 1445, "verse_number": "३-८३-१३०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2021664, "chapter_id": 1445, "verse_number": "३-८३-१३०", "content_sanskrit": "एवमाश्वास्य राजानं नारदो भगवानृषिः।\nअनुज्ञाप्य महाराज तत्रैवान्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2021665, "chapter_id": 1445, "verse_number": "३-८३-१३१", "content_sanskrit": "युधिष्ठिरोषि धर्मात्मा तमेवार्थं विचिन्तयन्।\nतीर्थयात्राश्रितं पुण्यमृषीणां प्रत्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2021666, "chapter_id": 1445, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्तयात्रापर्वणि त्र्यशीतितमोऽध्यायः ॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}]