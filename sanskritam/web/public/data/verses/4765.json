[{"id": 2178153, "chapter_id": 4765, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2178154, "chapter_id": 4765, "verse_number": "१", "content_sanskrit": "गते भगवति व्यासे धृतराष्ट्रो महीपतिः ।\nकिमचेष्टत विप्रर्षे तन्मे व्याख्यातुमर्हसि\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2178155, "chapter_id": 4765, "verse_number": "२", "content_sanskrit": "तथैव कौरवो राजा धर्मपुत्रो महामनाः ।\nकृपप्रभृतयश्चैव किमकुर्वत ते त्रयः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2178156, "chapter_id": 4765, "verse_number": "३", "content_sanskrit": "अश्वत्थाम्नः श्रुतं कर्म शापश्चान्योन्यकारितः ।\nवृत्तान्तमुत्तरं ब्रूहि यदभाषत सञ्जयः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2178157, "chapter_id": 4765, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2178158, "chapter_id": 4765, "verse_number": "४", "content_sanskrit": "हते दुर्योधने चैव हते सैन्ये च सर्वशः ।\nसञ्जयो विगतप्रज्ञो धृतराष्ट्रमुपस्थितः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2178159, "chapter_id": 4765, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2178160, "chapter_id": 4765, "verse_number": "५", "content_sanskrit": "आगम्य नानादेशेभ्यो नानाजनपदेश्वराः ।\nपितृलोकं गता राजन् सर्वे तव सुतैः सह\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2178161, "chapter_id": 4765, "verse_number": "६", "content_sanskrit": "याच्यमानेन सततं तव पुत्रेण भारत ।\nघातिता पृथिवी सर्वा वैरस्यान्तं विधित्सता\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2178162, "chapter_id": 4765, "verse_number": "७", "content_sanskrit": "पुत्राणामथ पौत्राणां पितॄणां च महीपते ।\nआनुपूर्व्येण सर्वेषां प्रेतकार्याणि कारय\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2178163, "chapter_id": 4765, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2178164, "chapter_id": 4765, "verse_number": "८", "content_sanskrit": "तच्छ्रुत्वा वचनं घोरं सञ्जयस्य महीपतिः ।\nगतासुरिव निश्चेष्टो न्यपतत् पृथिवीतळे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2178165, "chapter_id": 4765, "verse_number": "९", "content_sanskrit": "तं शयानमुपागम्य पृथिव्यां पृथिवीपतिम् ।\nविदुरः सर्वधर्मज्ञ इदं वचनमब्रवीत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2178166, "chapter_id": 4765, "verse_number": "१०", "content_sanskrit": "उत्तिष्ठ राजन् किं शेषे मा शुचो भरतर्षभ ।\nएषा वै सर्वसत्वानां लोकेश्वर परा गतिः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2178167, "chapter_id": 4765, "verse_number": "११", "content_sanskrit": "अभावादीनि भूतानि भावमध्यानि भारत ।\nअभावनिधनान्येव तत्र का परिदेवना\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2178168, "chapter_id": 4765, "verse_number": "१२", "content_sanskrit": "न शोचन्मृतमन्वेति न शोचन् म्रियते नरः ।\nएवं सांसिद्धिके लोके किमर्थमनुशोचसि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2178169, "chapter_id": 4765, "verse_number": "१३", "content_sanskrit": "यांश्चापि निहतान् युद्धे राजंस्त्वमनुशोचसि ।\nन शोच्या हि महात्मानः सर्वे ते त्रिदिवं गताः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2178170, "chapter_id": 4765, "verse_number": "१४", "content_sanskrit": "न यज्ञैर्दक्षिणावद्भिर्न तपोभिर्न विद्यया ।\nतथा स्वर्गमुपायान्ति यथा शूरास्तनुत्यजः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2178171, "chapter_id": 4765, "verse_number": "१५", "content_sanskrit": "सर्वे वेदविदः शूराः सर्वे सुचरितव्रताः ।\nसर्वे चाभिमुखाः क्षीणास्तत्र का परिदेवना\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2178172, "chapter_id": 4765, "verse_number": "१६", "content_sanskrit": "शरीराग्निषु शूराणां जुहुवुस्ते शराहुतीः ।\nहूयमानान् शरांश्चैव सेहुरुत्तमपूरुषाः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2178173, "chapter_id": 4765, "verse_number": "१७", "content_sanskrit": "एवं राजंस्तवाचक्षे स्वर्ग्यं पन्थानमुत्तमम् ।\nन युद्धादधिकं किञ्चित्क्षत्रियस्येह विद्यते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2178174, "chapter_id": 4765, "verse_number": "१८", "content_sanskrit": "क्षत्रियास्ते महात्मानः शूराः समितिशोभनाः ।\nआशिषं परमां प्राप्ता न शोच्याः सर्व एव हि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2178175, "chapter_id": 4765, "verse_number": "१९", "content_sanskrit": "आत्मनाऽऽत्मानमाश्वास्य मा शुचः पुरुषर्षभ ।\nनाद्य शोकाभिभूतस्त्वं कार्यमुत्स्रष्टुमर्हसि\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2178176, "chapter_id": 4765, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nधृतराष्ट्रविशोके नवमोऽध्यायः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2178177, "chapter_id": 4765, "verse_number": "", "content_sanskrit": "जलप्रदानपर्वणि नवमोऽध्यायः ॥९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]