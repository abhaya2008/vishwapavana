[{"id": 5000623000, "chapter_id": 9623, "verse_number": "७-८८-१", "content_sanskrit": "तां कथामिलसम्बद्धां रामेण समुदीरिताम् ।\nलक्ष्मणो भरतश्चैव श्रुत्वा परमविस्मितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000623001, "chapter_id": 9623, "verse_number": "७-८८-२", "content_sanskrit": "तौ रामं प्राञ्जली भूत्वा तस्य राज्ञो महात्मनः ।\nविस्तरं तस्य भावस्य तदा पप्रच्छतुः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000623002, "chapter_id": 9623, "verse_number": "७-८८-३", "content_sanskrit": "कथं स राजा स्त्रीभूतो वर्तयामास दुर्गतिः ।\nपुरुषः स यदा भूतः कां वृत्तिं वर्तयत्यसौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000623003, "chapter_id": 9623, "verse_number": "७-८८-४", "content_sanskrit": "तयोस्तद्भाषितं श्रुत्वा कौतूहलसमन्वितम् ।\nकथयामास काकुत्स्थस्तस्य राज्ञो यथागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000623004, "chapter_id": 9623, "verse_number": "७-८८-५", "content_sanskrit": "तमेव प्रथमं मासं स्त्रीभूता लोकसुन्दरी ।\nताभिः परिवृता स्त्रीभिर्ये च पूर्वपदानुगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000623005, "chapter_id": 9623, "verse_number": "७-८८-६", "content_sanskrit": "तत्काननं विगाह्वाशु विजह्रे लोकसुन्दरी ।\nद्रुमगुल्मलताकीर्णं पद्भ्यां पद्मदलेक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000623006, "chapter_id": 9623, "verse_number": "७-८८-७", "content_sanskrit": "वाहनानि च सर्वाणि सा त्यक्त्वा वै समन्ततः ।\nपर्वताभोगविवरे तस्मिन्रेमे इला तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000623007, "chapter_id": 9623, "verse_number": "७-८८-८", "content_sanskrit": "अथ तस्मिन्वनोद्देशे पर्वतस्याविदूरतः ।\nसरः सुरुचिरप्रख्यं नानापक्षिगणैर्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000623008, "chapter_id": 9623, "verse_number": "७-८८-९", "content_sanskrit": "ददर्श सा त्विला तस्मिन्बुधं सोमसुतं तदा ।\nज्वलन्तं स्वेन वपुषा पूर्णसोममिवोदितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000623009, "chapter_id": 9623, "verse_number": "७-८८-१०", "content_sanskrit": "तपन्तं च तपस्तीव्रमम्भोमध्ये दुरासदम् ।\nयशस्करं कामकरं कारुण्ये पर्यवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000623010, "chapter_id": 9623, "verse_number": "७-८८-११", "content_sanskrit": "सा तं जलाशयं सर्वं क्षोभयामास विस्मिता ।\nसहगैः पूर्वपुरुषैः स्त्रीभूतै रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000623011, "chapter_id": 9623, "verse_number": "७-८८-१२", "content_sanskrit": "बुधस्तु तां समीक्ष्यैव कामबाणवशं गतः ।\nनोपलेभे तदा ऽ ऽत्मानं सञ्चचाल तदा ऽ ऽम्भसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000623012, "chapter_id": 9623, "verse_number": "७-८८-१३", "content_sanskrit": "इलां निरीक्षमाणस्तु त्रैलोक्याभ्यधिकां शुभाम् ।\nचिन्तां समभ्यतिक्रामत् का न्वियं देवताधिका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000623013, "chapter_id": 9623, "verse_number": "७-८८-१४", "content_sanskrit": "न देवीषु न नागीषु नासुरीष्वप्सरःसु च ।\nदृष्टपूर्वा मया काचिद्रूपेणानेन शोभिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000623014, "chapter_id": 9623, "verse_number": "७-८८-१५", "content_sanskrit": "सदृशीयं मम भवेद्यदि नान्यपरिग्रहः ।\nइति बुद्धिं समास्थाय जलात्कूलमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000623015, "chapter_id": 9623, "verse_number": "७-८८-१६", "content_sanskrit": "आश्रमं समुपागम्य ततस्ताः प्रमदोत्तमाः ।\nशब्दापयत धर्मात्मा ताश्चैनं च ववन्दिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000623016, "chapter_id": 9623, "verse_number": "७-८८-१७", "content_sanskrit": "स ताः पप्रच्छ धर्मात्मा कस्यैषा लोकसुन्दरी ।\nकिमर्थमागता चैव सर्वमाख्यात मा चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000623017, "chapter_id": 9623, "verse_number": "७-८८-१८", "content_sanskrit": "शुभं तु तस्य तद्वाक्यं मधुरं मधुराक्षरम् ।\nश्रुत्वा स्त्रियश्च ताः सर्वा ऊचुर्मधुरया गिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000623018, "chapter_id": 9623, "verse_number": "७-८८-१९", "content_sanskrit": "अस्माकमेषा सुश्रोणी प्रभुत्वे वर्तते सदा ।\nअपतिः काननान्तेषु सहास्माभिश्चरत्यसौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000623019, "chapter_id": 9623, "verse_number": "७-८८-२०", "content_sanskrit": "तद्वाक्यमव्यक्तपदं तासां स्त्रीणां निशम्य च ।\nविद्यामावर्तनीं पुण्यामावर्तयत स द्विजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000623020, "chapter_id": 9623, "verse_number": "७-८८-२१", "content_sanskrit": "सो ऽर्थं विदित्वा सकलं तस्य राज्ञो यथागतम् ।\nसर्वा एव स्त्रियस्ताश्च बभाषे मुनिपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000623021, "chapter_id": 9623, "verse_number": "७-८८-२२", "content_sanskrit": "अत्र किम्पुरुषीर्भूत्वा शैलरोधसि वत्स्यथ ।\nआवासस्तु गिरावस्मिञ्छीघ्रमेव विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000623022, "chapter_id": 9623, "verse_number": "७-८८-२३", "content_sanskrit": "मूलपत्रफलैः सर्वा वर्तयिष्यथ नित्यदा ।\nस्त्रियः किम्पुरुषान्नाम भर्तऽन्समुपलप्स्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000623023, "chapter_id": 9623, "verse_number": "७-८८-२४", "content_sanskrit": "ताः श्रुत्वा सोमपुत्रस्य वाचं किम्पुरुषीकृताः ।\nउपासाञ्चक्रिरे शैलं वध्वस्ता बहुलास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000623024, "chapter_id": 9623, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे ऽष्टाशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]